class _PregelWrapper(Runnable):
    def __init__(self, pregel: PregelProtocol):
        self.pregel = pregel
        self.name = getattr(pregel, "name", None) or "PregelWrapper"
        self.trace = True

    def invoke(self, input: Any, config: RunnableConfig | None = None, **kwargs:
Any) -> Any:
        if config is None:
            config = ensure_config()
        runtime = config[CONF].get(CONFIG_KEY_RUNTIME)
        context = None
        if runtime is not None:
            context = runtime.context
        return self.pregel.invoke(input, config=config, context=context, 
**kwargs)

    async def ainvoke(self, input: Any, config: RunnableConfig | None = None, 
