        runtime = config[CONF].get(CONFIG_KEY_RUNTIME)
        context = None
        if runtime is not None:
            context = runtime.context
        return await self.pregel.ainvoke(input, config=config, context=context, 
**kwargs)

    def __getattr__(self, item):
        return getattr(self.pregel, item)

