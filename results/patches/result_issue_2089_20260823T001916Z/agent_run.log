import pytest_asyncio
from strands.experimental.bidi.types.events import BidiTextInputEvent

@pytest.mark.asyncio
async def test_send_respects_event_role(loop, agent):
    # Create a BidiTextInputEvent with role 'assistant'
    event = BidiTextInputEvent(text="Hello from assistant", role="assistant")
    
    # Send event
    await loop.send(event)
    
    # Check that the last message appended has the correct role
    last_message = agent.messages[-1]
    assert last_message["role"] == "assistant"
    assert last_message["content"][0]["text"] == "Hello from assistant"
EOF
