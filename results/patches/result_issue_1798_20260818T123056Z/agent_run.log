    def sync_agent(self, agent: "Agent", **kwargs: Any) -> None:
        """Serialize and update the agent into the session repository if state 
or internal state changed."""
        agent_id = agent.agent_id
        current_internal_state = getattr(agent, '_internal_state', None)
        prev_internal_state = self._last_synced_internal_state.get(agent_id)

        state_dirty = hasattr(agent.state, '_is_dirty') and 
agent.state._is_dirty()
        internal_state_changed = current_internal_state != prev_internal_state

        if state_dirty or internal_state_changed:
            try:
                self.session_repository.update_agent(
                    self.session_id,
                    SessionAgent.from_agent(agent),
                )
                if hasattr(agent.state, '_clear_dirty'):
                    agent.state._clear_dirty()
                if current_internal_state is not None:
                    self._last_synced_internal_state[agent_id] = 
current_internal_state
            except Exception as e:
                # Keep the dirty flag set for retry
                raise e
