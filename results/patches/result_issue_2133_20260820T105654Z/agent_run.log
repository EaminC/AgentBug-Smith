        self._set_state_field(agent, "last_injected_xml", skills_block["text"])

        # Update the structured system prompt content
        agent._system_prompt_content = content

        # Flatten structured content to a single string for agent.system_prompt
        agent._system_prompt = "".join(
            block["text"] if isinstance(block, dict) and "text" in block else 
