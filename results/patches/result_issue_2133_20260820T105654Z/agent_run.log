        state_data = agent.state.get(self._state_key)
        last_xml_block = state_data.get("last_injected_xml") if 
isinstance(state_data, dict) else None
        if last_xml_block is not None:
            new_content = []
            for block in content:
                # Remove the block that matches the last injected XML
                if isinstance(block, dict) and isinstance(block.get("text"), 
str):
                    if last_xml_block.strip() == ("\n\n" + 
block["text"]).strip():
                        continue
                new_content.append(block)
            content = new_content

        # Create a new block for the skills XML
