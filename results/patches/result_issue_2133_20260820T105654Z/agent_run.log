    def _on_before_invocation(self, event: BeforeInvocationEvent) -> None:
        """Inject skill metadata into the system prompt before each invocation.

        Removes the previously injected XML block (if any) via exact removal
        from the structured content, then appends a fresh one. Uses agent
        state to track the injected XML per-agent, so a single plugin instance
        can be shared safely across multiple agents.

        Args:
            event: The before-invocation event containing the agent reference.
        """
        agent = event.agent

        # Use the structured _system_prompt_content if available
        content = agent._system_prompt_content or []

        # Remove the previously injected XML block, if present
        state_data = agent.state.get(self._state_key)
        last_xml_block = state_data.get("last_injected_xml") if 
isinstance(state_data, dict) else None
        if last_xml_block is not None:
            new_content = []
            for block in content:
                # Remove the block that matches the last injected XML
                if isinstance(block, dict) and isinstance(block.get("text"), 
str):
                    if last_xml_block.strip() == ("\n\n" + 
block["text"]).strip():
                        continue
                new_content.append(block)
            content = new_content

        # Create a new block for the skills XML
        skills_xml = self._generate_skills_xml()
        skills_block = {"text": f"\n\n{skills_xml}"}
        content.append(skills_block)

        # Update the state with the new XML block text
        self._set_state_field(agent, "last_injected_xml", skills_block["text"])

        # Update the structured system prompt content
        agent._system_prompt_content = content

        # Flatten structured content to a single string for agent.system_prompt
        agent._system_prompt = "".join(
            block["text"] if isinstance(block, dict) and "text" in block else 
str(block)
            for block in content
        )
EOF
```

