 class AdviseAgent:
+    def clarify_dataset(self, dataset_description):
+        import questionary
+        # First query: check if dataset name is clear
+        response = self.model.query([{"role": "user", "content": f"Is the dataset name '{dataset_description}' clear?"}])
+        if response.strip().lower() == 'no':
+            # Second query: get suggested datasets
+            suggestions_json = self.model.query([{"role": "user", "content": f"Suggest possible datasets based on the description '{dataset_description}'."}])
+            suggestions = json.loads(suggestions_json)
+            datasets = suggestions.get('datasets', [])
+            # Ask user to select the dataset
+            selected_dataset = questionary.select("Select the correct dataset:", choices=datasets).ask()
+            return selected_dataset
+        else:
+            return dataset_description
 
