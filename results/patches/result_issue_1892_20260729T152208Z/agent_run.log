        ToolResultBlock(id='call_00', output='result0'),
        ToolResultBlock(id='call_01', output='result1'),
        TextBlock(text='Some text after tool results'),
    ]
)

async def run_test():
    formatted = await formatter._format_messages([msg])
    for message in formatted:
        print(message)

import asyncio
asyncio.run(run_test())
EOF
