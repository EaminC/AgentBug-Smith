+            encoding = tiktoken.get_encoding("cl100k_base")
+
+        tokens = 0
+
+        # If system prompt is provided, count tokens for it
+        if system_prompt:
+            tokens += len(encoding.encode(system_prompt))
+
+        # Count tokens in messages
+        for message in messages:
+            # Count tokens for the role, name, and content keys
+            tokens += len(encoding.encode(message["role"]))
+            if "name" in message:
+                tokens += len(encoding.encode(message["name"]))
+            tokens += len(encoding.encode(message["content"]))
+
+        # Count tokens for tool specs if provided
+        if tool_specs:
+            tool_descriptions = "\n".join(f"{tool['name']}: {tool['description']}" for tool in tool_specs)
+            tokens += len(encoding.encode(tool_descriptions))
+
+        return tokens
+
             The OpenAI model configuration.
         """
         return cast(OpenAIModel.OpenAIConfig, self.config)
