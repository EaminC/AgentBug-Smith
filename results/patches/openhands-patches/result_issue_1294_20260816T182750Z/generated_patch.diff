@@ -88,6 +88,31 @@ class AnthropicModel(Model):
         validate_config_keys(model_config, self.AnthropicConfig)
         self.config.update(model_config)
 
+    @override
+    def estimate_tokens(
+        self,
+        messages: Messages,
+        tool_specs: list[ToolSpec] | None = None,
+        system_prompt: str | None = None,
+    ) -> int:
+        """Estimate token count for the given input before sending to model."""
+        formatted_messages = self._format_request_messages(messages)
+        # Use anthropic.count_tokens native API
+        from anthropic import count_tokens
+        # Include system prompt if provided
+        if system_prompt:
+            formatted_messages.insert(0, {"role": "system", "content": system_prompt})
+        # Include tool specs if provided
+        if tool_specs:
+            # Convert tool_specs to Anthropic compatible format if needed
+            tool_descriptions = "\n".join(f"{tool['name']}: {tool['description']}" for tool in tool_specs)
+            formatted_messages.append({"role": "system", "content": f"Available tools:\n{tool_descriptions}"})
+        # Count tokens in formatted messages
+        token_count = 0
+        for message in formatted_messages:
+            token_count += count_tokens(message["content"])
+        return token_count
+
