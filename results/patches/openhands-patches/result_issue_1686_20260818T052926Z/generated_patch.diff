 def mock_model(request):
+import asyncio
+from strands.hooks.registry import TEvent, HookCallback
+from strands.hooks.events import BeforeModelCallEvent
+
+
+def test_add_hook_registers_callback():
+    agent = Agent()
+    called = False
+
+    def callback(event: BeforeModelCallEvent) -> None:
+        nonlocal called
+        called = True
+
+    agent.add_hook(BeforeModelCallEvent, callback)
+
+    # Directly trigger the hook to test if it was called
+    event = BeforeModelCallEvent(agent=agent)
+    callbacks = agent.hooks._registered_callbacks.get(BeforeModelCallEvent, [])
+    for cb in callbacks:
+        res = cb(event)
+        if asyncio.iscoroutine(res):
+            asyncio.run(res)
+
+    assert called
+
+
+def test_add_hook_accepts_async_callback():
+    agent = Agent()
+    called = False
+
+    async def async_callback(event: BeforeModelCallEvent) -> None:
+        nonlocal called
+        called = True
+
+    agent.add_hook(BeforeModelCallEvent, async_callback)
+
+    # Directly trigger the hook to test if it was called
+    event = BeforeModelCallEvent(agent=agent)
+    callbacks = agent.hooks._registered_callbacks.get(BeforeModelCallEvent, [])
+    for cb in callbacks:
+        res = cb(event)
+        if asyncio.iscoroutine(res):
+            asyncio.run(res)
+
+    assert called
+
