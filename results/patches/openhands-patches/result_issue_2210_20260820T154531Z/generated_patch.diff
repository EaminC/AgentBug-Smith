         try:
             logger.debug("formatting request")
             request = self._format_request(messages, tool_specs, system_prompt_content, tool_choice)
+    def _format_request(self, messages: Messages, tool_specs: list[ToolSpec] | None = None, system_prompt_content: list[SystemContentBlock] | None = None, tool_choice: ToolChoice | None = None) -> dict[str, Any]:
+        """Format the system, messages, toolConfig, and additional fields into a request dict for the Bedrock Converse API.
+
+        Args:
+            messages: The messages to send to the model.
+            tool_specs: The tools to make available to the model.
+            system_prompt_content: The system prompt content blocks.
+            tool_choice: The tool choice selection strategy.
+
+        Returns:
+            Formatted request dictionary.
+        """
+        request = {
+            "messages": messages,
+            "toolConfig": {
+                "tools": [
+                    {
+                        "toolSpec": {
+                            "name": tool_spec["name"],
+                            "description": tool_spec["description"],
+                            "inputSchema": tool_spec["inputSchema"],
+                            **({"strict": True} if self.config.get("strict_tools") else {}),
+                        },
+                    }
+                    for tool_spec in (tool_specs or [])
+                ],
+                "includeResultStatus": self.config.get("include_tool_result_status", "auto")
+                if self.config.get("include_tool_result_status") != "auto"
+                else bool(self.config.get("model_id", "").startswith("amazon")),
+            },
+            "system": system_prompt_content or [],
+            **(self.config.get("additional_request_fields") or {}),
+        }
+
+        if self.config.get("strict_tools") and self.config.get("citations", {}).get("enabled"):
+            logger.warning("Using strict_tools=True with citations enabled may cause incompatibility issues for Anthropic models.")
+
+        return request
+
             logger.debug("request=<%s>", request)
 
