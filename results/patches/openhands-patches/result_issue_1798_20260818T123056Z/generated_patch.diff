diff --git a/tests/strands/session/test_repository_session_manager.py b/tests/strands/session/test_repository_session_manager.py
index 22de9f964..8fa79fef6 100644
--- a/tests/strands/session/test_repository_session_manager.py
+++ b/tests/strands/session/test_repository_session_manager.py
@@ -39,6 +39,61 @@ def mock_multi_agent():
     """Create mock multi-agent for testing."""
 
     mock = Mock()
+def test_sync_agent_conditional_calls(session_manager, mock_repository, agent):
+    """Test that sync_agent calls update_agent only when dirty or state changes."""
+    # Patch the session_repository's update_agent method with a mock
+    mock_repository.update_agent = Mock()
+    
+    # Initially, the internal state dict is empty, and dirty flag is False
+    # So first sync should call update_agent because internal state changes
+    session_manager.sync_agent(agent)
+    assert mock_repository.update_agent.call_count == 1
+    
+    # On second call, without changes, update_agent should not be called
+    mock_repository.update_agent.reset_mock()
+    session_manager.sync_agent(agent)
+    assert mock_repository.update_agent.call_count == 0
+
+    # Set the dirty flag on the agent state
+    agent.state._dirty = True
+
+    # Now sync_agent should trigger update_agent call
+    session_manager.sync_agent(agent)
+    assert mock_repository.update_agent.call_count == 1
+    
+    # Clear dirty flag
+    agent.state._clear_dirty()
+
+    # Change internal state by setting a new key
+    agent.state.set("new_key", "value")
+
+    # Sync again should trigger update
+    mock_repository.update_agent.reset_mock()
+    session_manager.sync_agent(agent)
+    assert mock_repository.update_agent.call_count == 1
+
+    # Clear dirty flag
+    agent.state._clear_dirty()
+
+    # Sync with no changes should not call update_agent
+    mock_repository.update_agent.reset_mock()
+    session_manager.sync_agent(agent)
+    assert mock_repository.update_agent.call_count == 0
+
+    # Simulate update_agent failure raises error but keeps dirty flag
+    def fail_update_agent(*args, **kwargs):
+        raise Exception("Simulated failure")
+
+    mock_repository.update_agent = Mock(side_effect=fail_update_agent)
+
+    # Set dirty flag to True
+    agent.state._dirty = True
+
+    # Call sync_agent, which should catch error and keep dirty flag
+    session_manager.sync_agent(agent)
+    assert agent.state._is_dirty() is True
+
+
     mock.id = "test-multi-agent"
     mock.serialize_state.return_value = {"id": "test-multi-agent", "state": {"key": "value"}}
     mock.deserialize_state = Mock()
