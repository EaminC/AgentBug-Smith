index b8483327e..ba3e7b389 100644
--- a/libs/langgraph/tests/test_deprecation.py
+++ b/libs/langgraph/tests/test_deprecation.py
@@ -39,6 +39,41 @@ def test_task_retry_arg() -> None:
 def test_entrypoint_retry_arg() -> None:
     with pytest.warns(
         LangGraphDeprecatedSinceV05,
+def test_config_parameter_warning() -> None:
+    import warnings
+    from langgraph._internal._runnable import RunnableCallable
+    from langchain_core.runnables.base import RunnableConfig
+
+    def dummy_func_with_dict_config(state: dict, config: dict):
+        return state
+
+    def dummy_func_with_str_config(state: dict, config: str):
+        return state
+
+    def dummy_func_with_correct_config(state: dict, config: RunnableConfig):
+        return state
+
+    def dummy_async_func_with_dict_config(state: dict, config: dict):
+        return state
+
+    # Test warning is raised for dict type sync
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        _ = RunnableCallable(dummy_func_with_dict_config)
+        assert any("should be typed as 'RunnableConfig'" in str(warn.message) for warn in w)
+
+    # Test warning is raised for str type sync
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        _ = RunnableCallable(dummy_func_with_str_config)
+        assert any("should be typed as 'RunnableConfig'" in str(warn.message) for warn in w)
+
+    # Test no warning for correct sync
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        _ = RunnableCallable(dummy_func_with_correct_config)
+        assert not any("should be typed as 'RunnableConfig'" in str(warn.message) for warn in w)
+
         match="`retry` is deprecated and will be removed. Please use `retry_policy` instead.",
     ):
 
