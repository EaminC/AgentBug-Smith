+
+import lancedb
+
+class LanceDBMemory:
+    def __init__(self, project_path: str):
+        self.db_path = project_path
+        self.client = lancedb.connect(project_path)
+        self.collection_name = 'memory'
+        if self.collection_name not in self.client.list_tables():
+            self.client.create_table(self.collection_name)
+        self.table = self.client.open_table(self.collection_name)
+
+    def add(self, records):
+        """Add records to LanceDB."""
+        self.table.insert(records)
+
+    def query(self, query_vector, top_k=5):
+        """Query records from LanceDB with a vector."""
+        return self.table.search(query_vector, top_k=top_k)
+
+    def delete(self, record_id):
+        """Delete record by ID from LanceDB."""
+        # LanceDB: deletion support depends on implementation, placeholder
+        pass
+
+    def drop(self):
+        """Drop the whole table."""
+        self.client.drop_table(self.collection_name)
+
+    def count(self):
+        """Count the number of records."""
+        return self.table.num_rows
+
+    def reset(self):
+        """Reset the LanceDB memory."""
+        self.drop()
+        self.client.create_table(self.collection_name)
+        self.table = self.client.open_table(self.collection_name)
