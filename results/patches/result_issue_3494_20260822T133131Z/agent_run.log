    async def retrieve(self, reference: str) -> tuple[bytes, str]:
        """Retrieve content from a stored file.

        Accepts both full paths (as returned by ``store()``) and bare
        filenames (with or without extensions) for backward compatibility.

        Args:
            reference: The file path or filename returned by store().

        Returns:
            A tuple of (content bytes, content type).

        Raises:
            KeyError: If the file does not exist.
        """
        from pathlib import Path

        filename = Path(reference).name

        if self._sandbox is not None:
            await self._ensure_sandbox_metadata()
            prefix = f"{str(self._artifact_dir).rstrip('/')}/"
            # Accept full path or bare filename
            if reference.startswith(prefix):
                # Full path, must be under artifact_dir and no '..'
                if ".." in reference:
                    raise KeyError(f"Reference not found: {reference}")
                file_ref = reference
            else:
                # Accept bare filename (with or without extension)
                # Try to find exact filename first, then by stem
                if filename in self._content_types:
                    file_ref = self._artifact_path(filename)
                else:
                    stem = Path(filename).stem
                    matches = [f for f in self._content_types if Path(f).stem ==
stem]
                    if not matches:
                        raise KeyError(f"Reference not found: {reference}")
                    file_ref = self._artifact_path(matches[0])

            try:
                content = await self._sandbox.read_file(file_ref)
            except Exception as e:
                raise KeyError(f"Reference not found: {reference}") from e
            # Use the stored filename for content type lookup
            file_basename = Path(file_ref).name
            return content, self._content_types.get(file_basename, 
"application/octet-stream")

        # Non sandbox branch
        resolved_dir = self._artifact_dir.resolve()
        ref_path = Path(reference)

        if len(ref_path.parts) > 1:
            file_path = ref_path.resolve()
            if not file_path.is_relative_to(resolved_dir):
                raise KeyError(f"Reference not found: {reference}")
        else:
            # Bare filename, try exact or stem lookups
            if reference in self._content_types:
                file_path = resolved_dir / reference
            else:
                stem = Path(reference).stem
                matches = [f for f in self._content_types if Path(f).stem == 
stem]
                if not matches:
                    raise KeyError(f"Reference not found: {reference}")
                file_path = resolved_dir / matches[0]

        if not file_path.is_file():
            raise KeyError(f"Reference not found: {reference}")

        filename = file_path.name
        content_type = self._content_types.get(filename, 
"application/octet-stream")
        return file_path.read_bytes(), content_type
