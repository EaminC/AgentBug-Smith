cat <<'EOF' > test_bedrock_context_overflow.py
import asyncio
from unittest.mock import patch
from strands.models.openai import OpenAIModel
from strands.types.exceptions import ContextWindowOverflowException

class MockBadRequestError(Exception):
    code = "context_length_exceeded"
    def __str__(self):
        return "Input is too long for requested model"

class MockBadRequestError2(Exception):
    code = "other_code"
    def __str__(self):
        return "input length and max_tokens exceed context limit"

class MockBadRequestError3(Exception):
    code = "other_code"
    def __str__(self):
        return "too many total text bytes"

class MockClientChat:
    def __init__(self, error_class):
        self.error_class = error_class
        self.completions = self.Completions(self.error_class)

    class Completions:
        def __init__(self, error_class):
            self.error_class = error_class
        async def create(self, **kwargs):
            raise self.error_class()

    @property
    def chat(self):
        return self

    @property
    def completions(self):
        return self._completions

    @completions.setter
    def completions(self, value):
        self._completions = value

async def test_overflow(error_class):
    with patch('openai.BadRequestError', new=error_class):
        mock_client = MockClientChat(error_class)
        model = OpenAIModel(client=mock_client, model_id="fake-model")
        try:
            async for _ in model.stream([{"role": "user", "content": [{"text": 
"hello"}]}]):
                pass
        except ContextWindowOverflowException as e:
            print(f"Caught ContextWindowOverflowException for 
{error_class.__name__}:", e)

async def main():
    await test_overflow(MockBadRequestError)
    await test_overflow(MockBadRequestError2)
    await test_overflow(MockBadRequestError3)

asyncio.run(main())
EOF

```

