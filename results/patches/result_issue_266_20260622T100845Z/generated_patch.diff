+    def list_all_keys(self, table_name: Optional[str] = None) -> List[str]:
+        """
+        List all keys in the specified memory table.
+
+        Args:
+            table_name (Optional[str]): The name of the table to list keys from. Defaults to self.table_name.
+
+        Returns:
+            List[str]: A list of keys (ids) in the table.
+        """
+        table_name = table_name or self.table_name
+        if table_name not in self.client.table_names():
+            return []
+        table = self.client.open_table(table_name)
+        records = table.search("").to_list()  # Fetch all records
+        keys = [record["id"] for record in records if "id" in record]
+        return keys
