cat <<'EOF' > src/agentscope/app/_service/_chat.py
class ChatService:
    def __init__(self, storage=None, workspace_manager=None, 
scheduler_manager=None, background_task_manager=None, message_bus=None):
        self._storage = storage
        self._workspace_manager = workspace_manager
        self._scheduler_manager = scheduler_manager
        self._background_task_manager = background_task_manager
        self._message_bus = message_bus

    async def _run_impl(self, user_id, session_id, agent_id, input_msg):
        original_publish = self._message_bus.session_publish_event

        async def proxied_publish_event(sid, event_dict):
            await original_publish(sid, event_dict)
            leader_session_id = None
            session_record = await self._storage.get_session(user_id, agent_id, 
sid)
            if session_record and session_record.team_id:
                team = await self._storage.get_team(user_id, 
session_record.team_id)
                if team and team.session_id != sid:
                    leader_session_id = team.session_id

            if sid == session_id and leader_session_id is not None:
                evt_type = event_dict.get("type", "")
                if evt_type in ["UserConfirmResultEvent", 
"ExternalExecutionResultEvent"]:
                    await original_publish(leader_session_id, event_dict)
            if sid == leader_session_id and session_id != leader_session_id:
                evt_type = event_dict.get("type", "")
                if evt_type == "UserConfirmResultEvent":
                    await original_publish(session_id, event_dict)

        self._message_bus.session_publish_event = proxied_publish_event
        # Mock actual run logic
        await self._message_bus.session_publish_event(session_id, input_msg)
