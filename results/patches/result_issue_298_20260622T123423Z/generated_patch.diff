+class MemoryClient:
+    def __init__(self, token: str, agent_id: str = "default"):
+        self.agent_id = agent_id
+        self.token = token
+        self.headers = {"Authorization": f"Bearer {self.token}"}
+
+    def add(self, content, metadata=None, prompt=None, infer=False, agent_id=None):
+        agent_id = agent_id or self.agent_id
+        payload = {
+            "agent_id": agent_id,
+            "content": content,
+            "metadata": metadata or {},
+            "prompt": prompt,
+            "infer": infer
+        }
+        return self._post("memory/add", payload)
+
+    def search(self, agent_id, query_text, limit):
+        params = {
+            "agent_id": agent_id,
+            "query_text": query_text,
+            "limit": limit
+        }
+        return self._get("memory/query", params).get("results", [])
+
+    def get_all(self, agent_id, filters=None, limit=100):
+        params = {
+            "agent_id": agent_id,
+            "filters": filters or {},
+            "limit": limit
+        }
+        return self._get("memory/get_all", params).get("results", [])
+
+    def reset(self, agent_id):
+        payload = {"agent_id": agent_id}
+        return self._post("memory/reset", payload)
+
+    def _get(self, path, params=None):
+        response = requests.get(f"https://api.mem0.ai/v1/{path}", headers=self.headers, params=params)
+        response.raise_for_status()
+        return response.json()
+
+    def _post(self, path, data=None):
+        response = requests.post(f"https://api.mem0.ai/v1/{path}", headers=self.headers, json=data)
+        response.raise_for_status()
+        return response.json()
+
+
+class Memory:
+    def __init__(self, project_path: str):
+        self.mem = LanceDBMemory(project_path)
+
+    def add(self, content, metadata=None, prompt=None, infer=False, agent_id=None):
+        if metadata is None:
+            metadata = {}
+        content_list = content if isinstance(content, list) else [content]
+        return self.mem.add(content_list, metadata=[metadata] * len(content_list))
+
+    def search(self, agent_id, query_text, limit):
+        res = self.mem.query([query_text], n_results=limit)
+        return res[0] if res else []
+
+    def get_all(self, agent_id, filters=None, limit=100):
+        return self.mem.get_all(filters=filters, n_results=limit)
+
+    def reset(self, agent_id):
+        self.mem.reset()
+
+
+class Mem0:
+    def __init__(self, token: Optional[str] = None, agent_id: str = "default"):
+        self.agent_id = agent_id
+        self.token = token
+        if self.token:
+            self.client = MemoryClient(token, agent_id)
+        else:
+            self.client = Memory(agent_id)
+
+    def add(self, content: object | str, metadata: Optional[Dict[str, str]] = None, prompt: Optional[str] = None, infer: bool = False):
+        return self.client.add(content, metadata=metadata, prompt=prompt, infer=infer, agent_id=self.agent_id)
+
+    def query(self, content: str, n_results: int = 5, fast_query: bool = False) -> list[str]:
+        return self.client.search(agent_id=self.agent_id, query_text=content, limit=n_results)
+
+    def get_all(self, filters=None, n_results=100):
+        return self.client.get_all(agent_id=self.agent_id, filters=filters, limit=n_results)
+
+    def reset(self):
+        if hasattr(self.client, "reset"):
+            self.client.reset(agent_id=self.agent_id)
+
+    def evict(self, conditions: list):
+        if hasattr(self.client, "delete_by_metadata") and conditions:
+            for condition in conditions:
+                for key, value in condition.items():
+                    self.client.delete_by_metadata(key, value)
+        elif hasattr(self.client, "reset"):
+            self.client.reset(agent_id=self.agent_id)
+
+    def mem_consolidation(self, prompts: list):
+        # placeholder for remote consolidation
+        return True
