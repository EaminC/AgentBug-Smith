+import warnings
+from typing import Dict, Optional
+from langchain_core.runnables import RunnableConfig
+from langgraph._internal._runnable import RunnableCallable
+from langgraph.warnings import LangGraphDeprecatedSinceV10
+import pytest
+
+class DummyState:
+    pass
+
+def test_config_parameter_incorrect_typing():
+    # Config typed incorrectly
+    def sync_fn(state: DummyState, config: dict) -> DummyState:
+        return state
+
+    def async_fn(state: DummyState, config: dict) -> DummyState:
+        return state
+
+    with pytest.warns(LangGraphDeprecatedSinceV10, match="should be typed as 'RunnableConfig' or 'Optional[RunnableConfig]'"):
+        RunnableCallable(func=sync_fn)
+
+    with pytest.warns(LangGraphDeprecatedSinceV10, match="should be typed as 'RunnableConfig' or 'Optional[RunnableConfig]'"):
+        RunnableCallable(afunc=async_fn)
+
+    # Config typed correctly
+    def sync_fn_ok(state: DummyState, config: RunnableConfig):
+        return state
+
+    def async_fn_ok(state: DummyState, config: Optional[RunnableConfig]):
+        return state
+
+    RunnableCallable(func=sync_fn_ok)  # no warning
+    RunnableCallable(afunc=async_fn_ok)  # no warning
+
+import warnings
+from typing import Callable
+from langgraph._internal._runnable import RunnableCallable
+from langgraph.warnings import LangGraphDeprecatedSinceV10
+import pytest
+
+def test_config_param_warning():
+    def dummy_func(state: object, config: dict):
+        return state
+
+    with pytest.warns(LangGraphDeprecatedSinceV10, match="should be typed as 'RunnableConfig' or 'Optional[RunnableConfig]'"):
+        RunnableCallable(func=dummy_func)
+
+    def dummy_func_ok(state: object, config: object):
+        return state
+
+    # no warning expected
+    RunnableCallable(func=dummy_func_ok)
