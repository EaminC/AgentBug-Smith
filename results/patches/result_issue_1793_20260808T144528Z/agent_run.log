async def test_sub_agent_inherits_permissions():
    # Setup fake storage and message bus
    storage = AsyncMock(spec=RedisStorage)
    message_bus = AsyncMock(spec=RedisMessageBus)

    user_id = "user1"
    session_id_leader = "session_leader"
    agent_id_leader = "agent_leader"

    # Fake leader session and state with permission context
    leader_permission_context = PermissionContext(behavior=0, rules=[], 
decision=0)
    leader_tasks_context = TaskContext()
    leader_state = AgentState(permission_context=leader_permission_context, 
tasks_context=leader_tasks_context)

    leader_session = AsyncMock()
    leader_session.state = leader_state
    leader_session.agent_id = agent_id_leader
    leader_session.config = SessionConfig(workspace_id="ws", name="", 
chat_model_config=None, fallback_chat_model_config=None)

    team = AsyncMock()
    team.session_id = session_id_leader
    team.id = "team1"
    team.data = AsyncMock()
    team.data.name = "team_name"
    team.data.description = "desc"
    team.data.member_ids = []

    # Prepare AgentCreate instance
    agent_create = AgentCreate(storage, message_bus, user_id, session_id_leader,
agent_id_leader)

    # Mock functions to return our fake objects
    storage.get_session = AsyncMock(return_value=leader_session)
    storage.get_team = AsyncMock(return_value=team)
    storage.get_agent = AsyncMock(return_value=None)
    storage.upsert_agent = AsyncMock()
    storage.upsert_session = AsyncMock(return_value=AsyncMock())
    storage.set_session_team_id = AsyncMock()
    storage.upsert_team = AsyncMock()

    # Create sub-agent
    name = "sub_agent"
    description = "A sub-agent"
    prompt = "Your first task"

    result = await agent_create(name=name, description=description, 
prompt=prompt)

    # Assert permission context was copied from leader state
    called_state = storage.upsert_session.call_args[1]['state']
    assert called_state.permission_context == leader_permission_context
    print("Test passed: Permission context copied from leader state to 
sub-agent.")

if __name__ == "__main__":
    asyncio.run(test_sub_agent_inherits_permissions())
