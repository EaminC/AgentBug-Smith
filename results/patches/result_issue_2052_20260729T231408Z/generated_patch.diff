diff --git a/tests/skill_loader_test.py b/tests/skill_loader_test.py
index 101be4ad..50c98dcf 100644
--- a/tests/skill_loader_test.py
+++ b/tests/skill_loader_test.py
@@ -210,3 +210,23 @@ This is the modified content.
             loader._cache[self.test_dir].name,
             "modified_root_skill",
         )
+
+    async def test_expanduser_in_path(self) -> None:
+        """Test that LocalSkillLoader expands ~ in paths."""
+        temp_dir = tempfile.mkdtemp()
+        try:
+            skill_md_path = os.path.join(temp_dir, "SKILL.md")
+            with open(skill_md_path, "w", encoding="utf-8") as f:
+                f.write("---\nname: skill_with_tilde\ndescription: Test skill with ~ in path\n---\n")
+
+            # Use ~ in path
+            path_with_tilde = os.path.join("~", os.path.relpath(temp_dir, os.path.expanduser("~")))
+
+            loader = LocalSkillLoader(path_with_tilde)
+
+            skills = await loader.list_skills()
+
+            self.assertEqual(len(skills), 1)
+            self.assertEqual(skills[0].name, "skill_with_tilde")
+        finally:
+            shutil.rmtree(temp_dir)
