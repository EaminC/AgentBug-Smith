human vs. model games in Gomoku. Next, I will write a simple script to start a 
game between `UserAgent` and `board_agent.py` to test the fix in practice.

```
cat <<'EOF' > examples/game_gomoku/play_gomoku_user_vs_model.py
from examples.game_gomoku.code.board_agent import BoardAgent
from examples.game_gomoku.code.test_agents.user_agent import UserAgent

black = UserAgent(name='Alice')  # Human
white = BoardAgent(name='Bob')   # Model

current_player = black
opponent = white

board = [['0']*15 for _ in range(15)]

while True:
    msg = current_player.reply({'board': '\n'.join(''.join(row) for row in 
board)} if current_player == black else None)
    if current_player == black:
        move = msg.content
    else:
        move = (int(msg.content[0]), int(msg.content[1]))

    r, c = move
    if board[r][c] != '0':
        print(f"Invalid move by {current_player.name} at ({r},{c}), try again.")
        continue

    board[r][c] = 'o' if current_player == black else 'x'

    print(f"{current_player.name} moves at ({r},{c})")

    # Check win or draw by invoking the model's methods
    if current_player == white:
        if white.check_win(r, c, 'x'):
            print(f"{white.name} (White) wins!")
            break
    else:
        if black.check_win(r, c, 'o'):
            print(f"{black.name} (Black) wins!")
            break

    # Swap players
    current_player, opponent = opponent, current_player
EOF
