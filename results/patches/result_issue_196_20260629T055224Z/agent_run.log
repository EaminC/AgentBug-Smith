from agentscope.agents import AgentBase
from agentscope.message import Msg

class UserAgent(AgentBase):
    def __init__(self, name: str):
        super().__init__(name, use_memory=False)

    def reply(self, x: dict = None) -> dict:
        if x is None:
            content = "Game start. Please make your move by typing coordinates 
as [row, col]."
        else:
            print(f"Current board:\n{x.get('board', '')}")
            while True:
                try:
                    user_input = input(f"{self.name}, enter your move as 
row,col: ")
                    row, col = map(int, user_input.strip().split(','))
                    if 0 <= row < 15 and 0 <= col < 15:
                        content = [row, col]
                        break
                    else:
                        print("Move out of board range. Try again.")
                except Exception as e:
                    print("Invalid input. Please enter as row,col (e.g. 7,7). 
Try again.")

        msg = Msg(self.name, content, role="assistant")
        return msg
EOF
