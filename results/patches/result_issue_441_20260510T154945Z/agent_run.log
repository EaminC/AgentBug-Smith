present\n        for i, unit in enumerate(input_msgs):\n            if i == 0 
and unit.role == "system":\n                # add system prompt\n               
messages.append({"role": "system", "content": _convert_to_str(unit.content)})\n 
continue\n            # add other messages\n            role = unit.role if 
unit.role in ["user", "assistant"] else "user"\n            
messages.append({"role": role, "content": _convert_to_str(unit.content)})\n\n   
return messages\n\n        \1/' src/agentscope/models/ollama_model.py

