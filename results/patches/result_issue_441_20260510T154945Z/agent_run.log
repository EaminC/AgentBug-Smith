    def format(
        self,
        *args: Union[Msg, Sequence[Msg]],
    ) -> List[dict]:
        """Format the messages for ollama Chat API.

        Following the docstring in the current implementation:
        1. System messages keep role "system".
        2. History messages keep their roles, mostly user or assistant.

        Args:
            args (`Union[Msg, Sequence[Msg]]`):
                The input arguments to be formatted, where each argument
                should be a `Msg` object, or a list of `Msg` objects.
                In distribution, placeholder is also allowed.

        Returns:
            `List[dict]`:
                The formatted messages to send to the Ollama chat API.
        """

        input_msgs = []
        for _ in args:
            if _ is None:
                continue
            if isinstance(_, Msg):
                input_msgs.append(_)
            elif isinstance(_, list) and all(isinstance(__, Msg) for __ in _):
                input_msgs.extend(_)
            else:
                raise TypeError(
                    f"The input should be a Msg object or a list "
                    f"of Msg objects, got {type(_)}.",
                )

        messages = []
        images = []

        for unit in input_msgs:
            # For unit with url, remember the url as image
            if unit.url is not None:
                images.append(unit.url)

            # Add the message in correct role
            # Use the role from the unit, fall back to user if unknown
            role = unit.role if unit.role in ["system", "user", "assistant"] 
else "user"
            messages.append({"role": role, "content": 
_convert_to_str(unit.content)})

        # Add images list to system message if any
        for message in messages:
            if message["role"] == "system" and images:
                message["images"] = images
                break

        return messages
EOF

