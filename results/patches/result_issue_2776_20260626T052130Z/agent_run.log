    def search(self, query: str, limit: int = 3, score_threshold: float = 0.35, 
run_id: str = "", include_agent_memory: bool = True) -> List[Any]:
        params = {"query": query, "limit": limit, "output_format": "v2"}
        if user_id := self._get_user_id():
            params["user_id"] = user_id

        agent_name = self._get_agent_name() if include_agent_memory else None

        if self.memory_type == "short_term":
            if agent_name:
                params["agent_id"] = agent_name
            params["metadata"] = {"type": "short_term"}
            if run_id:
                params["run_id"] = run_id
        elif self.memory_type == "long_term":
            if agent_name:
                params["agent_id"] = agent_name
            params["metadata"] = {"type": "long_term"}
        elif self.memory_type == "entities":
            if agent_name:
                params["agent_id"] = agent_name
            params["metadata"] = {"type": "entity"}
        elif self.memory_type == "external":
            if agent_name:
                params["agent_id"] = agent_name
            params["metadata"] = {"type": "external"}

        if isinstance(self.memory, Memory):
            del params["metadata"], params["output_format"]

        results = self.memory.search(**params)
        return [r for r in results["results"] if r["score"] >= score_threshold]
EOF

