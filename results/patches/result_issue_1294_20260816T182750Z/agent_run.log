import pytest

from strands.models import Model as SAModel


class DummyModel(SAModel):
    async def estimate_tokens(self, messages, tool_specs=None, 
system_prompt=None, system_prompt_content=None) -> int:
        # Simple token estimation: zero for empty or binary content, else sum 
length of text blocks
        if not messages:
            return 0
        count = 0
        for msg in messages:
            if not isinstance(msg, dict):
                continue
            content = msg.get("content", [])
            for block in content:
                if "text" in block:
                    count += len(block["text"])
                elif "image" in block:
                    # Skip binary content
                    continue
        return count

    def update_config(self, **model_config):
        return model_config

    def get_config(self):
        return {}

    async def structured_output(self, output_model, prompt=None, 
system_prompt=None, **kwargs):
        yield {"output": output_model(name="dummy", age=0)}

    async def stream(self, messages, tool_specs=None, system_prompt=None):
        yield {"messageStart": {"role": "assistant"}}
        yield {"contentBlockDelta": {"delta": {"text": "dummy response"}}}
        yield {"messageStop": {"stopReason": "end_turn"}}


