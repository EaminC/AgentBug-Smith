469     def __call__(
470         self, task: MultiAgentInput, invocation_state: dict[str, Any] | None = None, **kwargs: Any
471     ) -> GraphResult:
472         """Invoke the graph synchronously.
473 
474         Args:
475             task: The task to execute
476             invocation_state: Additional state/context passed to underlying agents.
477                 Defaults to None to avoid mutable default argument issues.
478             **kwargs: Keyword arguments allowing backward compatible future changes.
479         """
480         if invocation_state is None:
481             invocation_state = {}
482 
483         return run_async(lambda: self.invoke_async(task, invocation_state))
