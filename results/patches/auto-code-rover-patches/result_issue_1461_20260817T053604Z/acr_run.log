509     async def stream_async(
510         self, task: MultiAgentInput, invocation_state: dict[str, Any] | None = None, **kwargs: Any
511     ) -> AsyncIterator[dict[str, Any]]:
512         """Stream events during graph execution.
513 
514         Args:
515             task: The task to execute
516             invocation_state: Additional state/context passed to underlying agents.
517                 Defaults to None to avoid mutable default argument issues.
518             **kwargs: Keyword arguments allowing backward compatible future changes.
519 
520         Yields:
521             Dictionary events during graph execution, such as:
522             - multi_agent_node_start: When a node begins execution
523             - multi_agent_node_stream: Forwarded agent/multi-agent events with node context
524             - multi_agent_node_stop: When a node stops execution
525             - result: Final graph result
526         """
527         self._interrupt_state.resume(task)
528 
529         if invocation_state is None:
530             invocation_state = {}
531 
532         await self.hooks.invoke_callbacks_async(BeforeMultiAgentInvocationEvent(self, invocation_state))
533 
534         logger.debug("task=<%s> | starting graph execution", task)
535 
536         # Initialize state
537         start_time = time.time()
538         if not self._resume_from_session and not self._interrupt_state.activated:
539             # Initialize state
540             self.state = GraphState(
541                 status=Status.EXECUTING,
542                 task=task,
543                 total_nodes=len(self.nodes),
544                 edges=[(edge.from_node, edge.to_node) for edge in self.edges],
545                 entry_points=list(self.entry_points),
546                 start_time=start_time,
547             )
548         else:
549             self.state.status = Status.EXECUTING
550             self.state.start_time = start_time
551 
552         span = self.tracer.start_multiagent_span(task, "graph", custom_trace_attributes=self.trace_attributes)
553         with trace_api.use_span(span, end_on_exit=True):
554             interrupts = []
555 
556             try:
557                 logger.debug(
558                     "max_node_executions=<%s>, execution_timeout=<%s>s, node_timeout=<%s>s | graph execution config",
559                     self.max_node_executions or "None",
560                     self.execution_timeout or "None",
561                     self.node_timeout or "None",
562                 )
563 
564                 async for event in self._execute_graph(invocation_state):
565                     if isinstance(event, MultiAgentNodeInterruptEvent):
566                         interrupts.extend(event.interrupts)
567 
568                     yield event.as_dict()
569 
570                 # Set final status based on execution results
571                 if self.state.failed_nodes:
572                     self.state.status = Status.FAILED
573                 elif self.state.status == Status.EXECUTING:
574                     self.state.status = Status.COMPLETED
575 
576                 logger.debug("status=<%s> | graph execution completed", self.state.status)
577 
578                 # Yield final result (consistent with Agent's AgentResultEvent format)
579                 result = self._build_result(interrupts)
580 
581                 # Use the same event format as Agent for consistency
582                 yield MultiAgentResultEvent(result=result).as_dict()
583 
584             except Exception:
585                 logger.exception("graph execution failed")
586                 self.state.status = Status.FAILED
587                 raise
588             finally:
589                 self.state.execution_time += round((time.time() - start_time) * 1000)
590                 await self.hooks.invoke_callbacks_async(AfterMultiAgentInvocationEvent(self))
591                 self._resume_from_session = False
592                 self._resume_next_nodes.clear()
593 
594     def _validate_graph(self, nodes: dict[str, GraphNode]) -> None:
595         """Validate graph nodes for duplicate instances."""
596         # Check for duplicate node instances
597         seen_instances = set()
598         for node in nodes.values():
599             if id(node.executor) in seen_instances:
600                 raise ValueError("Duplicate node instance detected. Each node must have a unique object instance.")
601             seen_instances.add(id(node.executor))
602 
603             # Validate Agent-specific constraints for each node
604             _validate_node_executor(node.executor)
605 
606     def _activate_interrupt(self, node: GraphNode, interrupts: list[Interrupt]) -> MultiAgentNodeInterruptEvent:
607         """Activate the interrupt state.
608 
609         Args:
610             node: The interrupted node.
611             interrupts: The interrupts raised by the user.
612 
613         Returns:
614             MultiAgentNodeInterruptEvent
615         """
616         logger.debug("node=<%s> | node interrupted", node.node_id)
617 
618         node.execution_status = Status.INTERRUPTED
619 
620         self.state.status = Status.INTERRUPTED
621         self.state.interrupted_nodes.add(node)
622 
623         self._interrupt_state.interrupts.update({interrupt.id: interrupt for interrupt in interrupts})
624         self._interrupt_state.activate()
625         if isinstance(node.executor, Agent):
626             self._interrupt_state.context[node.node_id] = {
627                 "activated": node.executor._interrupt_state.activated,
628                 "interrupt_state": node.executor._interrupt_state.to_dict(),
629                 "state": node.executor.state.get(),
630                 "messages": node.executor.messages,
631             }
632 
633         return MultiAgentNodeInterruptEvent(node.node_id, interrupts)
634 
635     async def _execute_graph(self, invocation_state: dict[str, Any]) -> AsyncIterator[Any]:
636         """Execute graph and yield TypedEvent objects."""
637         if self._interrupt_state.activated:
638             ready_nodes = [self.nodes[node_id] for node_id in self._interrupt_state.context["completed_nodes"]]
639             ready_nodes.extend(self.state.interrupted_nodes)
640 
641             self.state.interrupted_nodes.clear()
642 
643         elif self._resume_from_session:
644             ready_nodes = self._resume_next_nodes
645 
646         else:
647             ready_nodes = list(self.entry_points)
648 
649         while ready_nodes:
650             # Check execution limits before continuing
651             should_continue, reason = self.state.should_continue(
652                 max_node_executions=self.max_node_executions,
653                 execution_timeout=self.execution_timeout,
654             )
655             if not should_continue:
656                 self.state.status = Status.FAILED
657                 logger.debug("reason=<%s> | stopping execution", reason)
658                 return  # Let the top-level exception handler deal with it
659 
660             current_batch = ready_nodes.copy()
661             ready_nodes.clear()
662 
663             # Execute current batch
664             async for event in self._execute_nodes_parallel(current_batch, invocation_state):
665                 yield event
666 
667             if self.state.status == Status.INTERRUPTED:
668                 self._interrupt_state.context["completed_nodes"] = [
669                     node.node_id for node in current_batch if node.execution_status == Status.COMPLETED
670                 ]
671                 return
672 
673             self._interrupt_state.deactivate()
674 
675             # Find newly ready nodes after batch execution
676             # We add all nodes in current batch as completed batch,
677             # because a failure would throw exception and code would not make it here
678             newly_ready = self._find_newly_ready_nodes(current_batch)
679 
680             # Emit handoff event for batch transition if there are nodes to transition to
681             if newly_ready:
682                 handoff_event = MultiAgentHandoffEvent(
683                     from_node_ids=[node.node_id for node in current_batch],
684                     to_node_ids=[node.node_id for node in newly_ready],
685                 )
686                 yield handoff_event
687                 logger.debug(
688                     "from_node_ids=<%s>, to_node_ids=<%s> | batch transition",
689                     [node.node_id for node in current_batch],
690                     [node.node_id for node in newly_ready],
691                 )
692 
693             ready_nodes.extend(newly_ready)
694 
695     async def _execute_nodes_parallel(
696         self, nodes: list["GraphNode"], invocation_state: dict[str, Any]
697     ) -> AsyncIterator[Any]:
698         """Execute multiple nodes in parallel and merge their event streams in real-time.
699 
700         Uses a shared queue where each node's stream runs independently and pushes events
701         as they occur, enabling true real-time event propagation without round-robin delays.
702         """
703         if self._interrupt_state.activated:
704             nodes = [node for node in nodes if node.execution_status == Status.INTERRUPTED]
705 
706         event_queue: asyncio.Queue[Any | None | Exception] = asyncio.Queue()
707 
708         # Start all node streams as independent tasks
709         tasks = [asyncio.create_task(self._stream_node_to_queue(node, event_queue, invocation_state)) for node in nodes]
710 
711         try:
712             # Consume events from the queue as they arrive
713             # Continue until all tasks are done
714             while any(not task.done() for task in tasks):
715                 try:
716                     # Use timeout to avoid race condition: if all tasks complete between
717                     # checking task.done() and calling queue.get(), we'd hang forever.
718                     # The 0.1s timeout allows us to periodically re-check task completion
719                     # while still being responsive to incoming events.
720                     event = await asyncio.wait_for(event_queue.get(), timeout=0.1)
721                 except asyncio.TimeoutError:
722                     # No event available, continue checking tasks
723                     continue
724 
725                 # Check if it's an exception - fail fast
726                 if isinstance(event, Exception):
727                     # Cancel all other tasks immediately
728                     for task in tasks:
729                         if not task.done():
730                             task.cancel()
731                     raise event
732 
733                 if event is not None:
734                     yield event
735 
736             # Process any remaining events in the queue after all tasks complete
737             while not event_queue.empty():
738                 event = await event_queue.get()
739                 if isinstance(event, Exception):
740                     raise event
741                 if event is not None:
742                     yield event
743         finally:
744             # Cancel any remaining tasks
745             remaining_tasks = [task for task in tasks if not task.done()]
746             if remaining_tasks:
747                 logger.warning(
748                     "remaining_task_count=<%d> | cancelling remaining tasks in finally block",
749                     len(remaining_tasks),
750                 )
751                 for task in remaining_tasks:
752                     task.cancel()
753             await asyncio.gather(*tasks, return_exceptions=True)
754 
755     async def _stream_node_to_queue(
756         self,
757         node: GraphNode,
758         event_queue: asyncio.Queue[Any | None | Exception],
759         invocation_state: dict[str, Any],
760     ) -> None:
761         """Stream events from a node to the shared queue with optional timeout."""
762         try:
763             # Apply timeout to the entire streaming process if configured
764             if self.node_timeout is not None:
765 
766                 async def stream_node() -> None:
767                     async for event in self._execute_node(node, invocation_state):
768                         await event_queue.put(event)
769 
770                 try:
771                     await asyncio.wait_for(stream_node(), timeout=self.node_timeout)
772                 except asyncio.TimeoutError:
773                     # Handle timeout and send exception through queue
774                     timeout_exc = await self._handle_node_timeout(node, event_queue)
775                     await event_queue.put(timeout_exc)
776             else:
777                 # No timeout - stream normally
778                 async for event in self._execute_node(node, invocation_state):
779                     await event_queue.put(event)
780         except Exception as e:
781             # Send exception through queue for fail-fast behavior
782             await event_queue.put(e)
783         finally:
784             await event_queue.put(None)
785 
786     async def _handle_node_timeout(self, node: GraphNode, event_queue: asyncio.Queue[Any | None]) -> Exception:
787         """Handle a node timeout by creating a failed result and emitting events.
788 
789         Returns:
790             The timeout exception to be re-raised for fail-fast behavior
791         """
792         assert self.node_timeout is not None
793         timeout_exception = Exception(f"Node '{node.node_id}' execution timed out after {self.node_timeout}s")
794 
795         node_result = NodeResult(
796             result=timeout_exception,
797             execution_time=round(self.node_timeout * 1000),
798             status=Status.FAILED,
799             accumulated_usage=Usage(inputTokens=0, outputTokens=0, totalTokens=0),
800             accumulated_metrics=Metrics(latencyMs=round(self.node_timeout * 1000)),
801             execution_count=1,
802         )
803 
804         node.execution_status = Status.FAILED
805         node.result = node_result
806         node.execution_time = node_result.execution_time
807         self.state.failed_nodes.add(node)
808         self.state.results[node.node_id] = node_result
809 
810         complete_event = MultiAgentNodeStopEvent(
811             node_id=node.node_id,
812             node_result=node_result,
813         )
814         await event_queue.put(complete_event)
815 
816         return timeout_exception
817 
818     def _find_newly_ready_nodes(self, completed_batch: list["GraphNode"]) -> list["GraphNode"]:
819         """Find nodes that became ready after the last execution."""
820         newly_ready = []
821         for _node_id, node in self.nodes.items():
822             if self._is_node_ready_with_conditions(node, completed_batch):
823                 newly_ready.append(node)
824         return newly_ready
825 
826     def _is_node_ready_with_conditions(self, node: GraphNode, completed_batch: list["GraphNode"]) -> bool:
827         """Check if a node is ready considering conditional edges."""
828         # Get incoming edges to this node
829         incoming_edges = [edge for edge in self.edges if edge.to_node == node]
830 
831         # Check if at least one incoming edge condition is satisfied
832         for edge in incoming_edges:
833             if edge.from_node in completed_batch:
834                 if edge.should_traverse(self.state):
835                     logger.debug(
836                         "from=<%s>, to=<%s> | edge ready via satisfied condition", edge.from_node.node_id, node.node_id
837                     )
838                     return True
839                 else:
840                     logger.debug(
841                         "from=<%s>, to=<%s> | edge condition not satisfied", edge.from_node.node_id, node.node_id
842                     )
843         return False
844 
845     async def _execute_node(self, node: GraphNode, invocation_state: dict[str, Any]) -> AsyncIterator[Any]:
846         """Execute a single node and yield TypedEvent objects."""
847         # Reset the node's state if reset_on_revisit is enabled, and it's being revisited
848         if self.reset_on_revisit and node in self.state.completed_nodes:
849             logger.debug("node_id=<%s> | resetting node state for revisit", node.node_id)
850             node.reset_executor_state()
851             self.state.completed_nodes.remove(node)
852 
853         node.execution_status = Status.EXECUTING
854         logger.debug("node_id=<%s> | executing node", node.node_id)
855 
856         # Emit node start event
857         start_event = MultiAgentNodeStartEvent(
858             node_id=node.node_id, node_type="agent" if isinstance(node.executor, Agent) else "multiagent"
859         )
860         yield start_event
861 
862         before_event, interrupts = await self.hooks.invoke_callbacks_async(
863             BeforeNodeCallEvent(self, node.node_id, invocation_state)
864         )
865 
866         start_time = time.time()
867         try:
868             if interrupts:
869                 yield self._activate_interrupt(node, interrupts)
870                 return
871 
872             if before_event.cancel_node:
873                 cancel_message = (
874                     before_event.cancel_node if isinstance(before_event.cancel_node, str) else "node cancelled by user"
875                 )
876                 logger.debug("reason=<%s> | cancelling execution", cancel_message)
877                 yield MultiAgentNodeCancelEvent(node.node_id, cancel_message)
878                 raise RuntimeError(cancel_message)
879 
880             # Build node input from satisfied dependencies
881             node_input = self._build_node_input(node)
882 
883             # Execute and stream events (timeout handled at task level)
884             if isinstance(node.executor, MultiAgentBase):
885                 # For nested multi-agent systems, stream their events and collect result
886                 multi_agent_result = None
887                 async for event in node.executor.stream_async(node_input, invocation_state):
888                     # Forward nested multi-agent events with node context
889                     wrapped_event = MultiAgentNodeStreamEvent(node.node_id, event)
890                     yield wrapped_event
891                     # Capture the final result event
892                     if "result" in event:
893                         multi_agent_result = event["result"]
894 
895                 # Use the captured result from streaming (no double execution)
896                 if multi_agent_result is None:
897                     raise ValueError(f"Node '{node.node_id}' did not produce a result event")
898 
899                 if multi_agent_result.status == Status.INTERRUPTED:
900                     raise NotImplementedError(
901                         f"node_id=<{node.node_id}>, "
902                         "issue=<https://github.com/strands-agents/sdk-python/issues/204> "
903                         "| user raised interrupt from a multi agent node"
904                     )
905 
906                 node_result = NodeResult(
907                     result=multi_agent_result,
908                     execution_time=multi_agent_result.execution_time,
909                     status=Status.COMPLETED,
910                     accumulated_usage=multi_agent_result.accumulated_usage,
911                     accumulated_metrics=multi_agent_result.accumulated_metrics,
912                     execution_count=multi_agent_result.execution_count,
913                 )
914 
915             elif isinstance(node.executor, Agent):
916                 # For agents, stream their events and collect result
917                 agent_response = None
918                 async for event in node.executor.stream_async(node_input, invocation_state=invocation_state):
919                     # Forward agent events with node context
920                     wrapped_event = MultiAgentNodeStreamEvent(node.node_id, event)
921                     yield wrapped_event
922                     # Capture the final result event
923                     if "result" in event:
924                         agent_response = event["result"]
925 
926                 # Use the captured result from streaming (no double execution)
927                 if agent_response is None:
928                     raise ValueError(f"Node '{node.node_id}' did not produce a result event")
929 
930                 # Extract metrics with defaults
931                 response_metrics = getattr(agent_response, "metrics", None)
932                 usage = getattr(
933                     response_metrics, "accumulated_usage", Usage(inputTokens=0, outputTokens=0, totalTokens=0)
934                 )
935                 metrics = getattr(response_metrics, "accumulated_metrics", Metrics(latencyMs=0))
936 
937                 node_result = NodeResult(
938                     result=agent_response,
939                     execution_time=round((time.time() - start_time) * 1000),
940                     status=Status.INTERRUPTED if agent_response.stop_reason == "interrupt" else Status.COMPLETED,
941                     accumulated_usage=usage,
942                     accumulated_metrics=metrics,
943                     execution_count=1,
944                     interrupts=agent_response.interrupts or [],
945                 )
946             else:
947                 raise ValueError(f"Node '{node.node_id}' of type '{type(node.executor)}' is not supported")
948 
949             node.result = node_result
950             node.execution_time = node_result.execution_time
951 
952             if node_result.status == Status.INTERRUPTED:
953                 yield self._activate_interrupt(node, node_result.interrupts)
954                 return
955 
956             # Mark as completed
957             node.execution_status = Status.COMPLETED
958             self.state.completed_nodes.add(node)
959             self.state.results[node.node_id] = node_result
960             self.state.execution_order.append(node)
961 
962             # Accumulate metrics
963             self._accumulate_metrics(node_result)
964 
965             # Emit node stop event with full NodeResult
966             complete_event = MultiAgentNodeStopEvent(
967                 node_id=node.node_id,
968                 node_result=node_result,
969             )
970             yield complete_event
971 
972             logger.debug(
973                 "node_id=<%s>, execution_time=<%dms> | node completed successfully",
974                 node.node_id,
975                 node.execution_time,
976             )
977 
978         except Exception as e:
979             # All failures (programming errors and execution failures) stop graph execution
980             # This matches the old fail-fast behavior
981             logger.error("node_id=<%s>, error=<%s> | node failed", node.node_id, e)
982             execution_time = round((time.time() - start_time) * 1000)
983 
984             # Create a NodeResult for the failed node
985             node_result = NodeResult(
986                 result=e,
987                 execution_time=execution_time,
988                 status=Status.FAILED,
989                 accumulated_usage=Usage(inputTokens=0, outputTokens=0, totalTokens=0),
990                 accumulated_metrics=Metrics(latencyMs=execution_time),
991                 execution_count=1,
992             )
993 
994             node.execution_status = Status.FAILED
995             node.result = node_result
996             node.execution_time = execution_time
997             self.state.failed_nodes.add(node)
998             self.state.results[node.node_id] = node_result
999 
1000             # Emit stop event even for failures
1001             complete_event = MultiAgentNodeStopEvent(
1002                 node_id=node.node_id,
1003                 node_result=node_result,
1004             )
1005             yield complete_event
1006 
1007             # Re-raise to stop graph execution (fail-fast behavior)
1008             raise
1009 
1010         finally:
1011             if node.execution_status != Status.INTERRUPTED:
1012                 await self.hooks.invoke_callbacks_async(AfterNodeCallEvent(self, node.node_id, invocation_state))
1013 
1014     def _accumulate_metrics(self, node_result: NodeResult) -> None:
1015         """Accumulate metrics from a node result."""
1016         self.state.accumulated_usage["inputTokens"] += node_result.accumulated_usage.get("inputTokens", 0)
1017         self.state.accumulated_usage["outputTokens"] += node_result.accumulated_usage.get("outputTokens", 0)
1018         self.state.accumulated_usage["totalTokens"] += node_result.accumulated_usage.get("totalTokens", 0)
1019         self.state.accumulated_metrics["latencyMs"] += node_result.accumulated_metrics.get("latencyMs", 0)
1020         self.state.execution_count += node_result.execution_count
1021 
1022     def _build_node_input(self, node: GraphNode) -> list[ContentBlock]:
1023         """Build input text for a node based on dependency outputs.
1024 
1025         If resuming from an interrupt, return user responses.
1026 
1027         Example formatted output:
1028         ```
1029         Original Task: Analyze the quarterly sales data and create a summary report
1030 
1031         Inputs from previous nodes:
1032 
1033         From data_processor:
1034           - Agent: Sales data processed successfully. Found 1,247 transactions totaling $89,432.
1035           - Agent: Key trends: 15% increase in Q3, top product category is Electronics.
1036 
1037         From validator:
1038           - Agent: Data validation complete. All records verified, no anomalies detected.
1039         ```
1040         """
1041         if self._interrupt_state.activated:
1042             context = self._interrupt_state.context
1043             if node.node_id in context and context[node.node_id]["activated"]:
1044                 agent_context = context[node.node_id]
1045                 agent = cast(Agent, node.executor)
1046                 agent.messages = agent_context["messages"]
1047                 agent.state = AgentState(agent_context["state"])
1048                 agent._interrupt_state = _InterruptState.from_dict(agent_context["interrupt_state"])
1049 
1050                 responses = context["responses"]
1051                 interrupts = agent._interrupt_state.interrupts
1052                 return [
1053                     response for response in responses if response["interruptResponse"]["interruptId"] in interrupts
1054                 ]
1055 
1056         # Get satisfied dependencies
1057         dependency_results = {}
1058         for edge in self.edges:
1059             if (
1060                 edge.to_node == node
1061                 and edge.from_node in self.state.completed_nodes
1062                 and edge.from_node.node_id in self.state.results
1063             ):
1064                 if edge.should_traverse(self.state):
1065                     dependency_results[edge.from_node.node_id] = self.state.results[edge.from_node.node_id]
1066 
1067         if not dependency_results:
1068             # No dependencies - return task as ContentBlocks
1069             if isinstance(self.state.task, str):
1070                 return [ContentBlock(text=self.state.task)]
1071             else:
1072                 return cast(list[ContentBlock], self.state.task)
1073 
1074         # Combine task with dependency outputs
1075         node_input = []
1076 
1077         # Add original task
1078         if isinstance(self.state.task, str):
1079             node_input.append(ContentBlock(text=f"Original Task: {self.state.task}"))
1080         else:
1081             # Add task content blocks with a prefix
1082             node_input.append(ContentBlock(text="Original Task:"))
1083             node_input.extend(cast(list[ContentBlock], self.state.task))
1084 
1085         # Add dependency outputs
1086         node_input.append(ContentBlock(text="\nInputs from previous nodes:"))
1087 
1088         for dep_id, node_result in dependency_results.items():
1089             node_input.append(ContentBlock(text=f"\nFrom {dep_id}:"))
1090             # Get all agent results from this node (flattened if nested)
1091             agent_results = node_result.get_agent_results()
1092             for result in agent_results:
1093                 agent_name = getattr(result, "agent_name", "Agent")
1094                 result_text = str(result)
1095                 node_input.append(ContentBlock(text=f"  - {agent_name}: {result_text}"))
1096 
1097         return node_input
1098 
1099     def _build_result(self, interrupts: list[Interrupt]) -> GraphResult:
1100         """Build graph result from current state.
1101 
1102         Args:
1103             interrupts: List of interrupts collected during execution.
1104 
1105         Returns:
1106             GraphResult with current state.
1107         """
1108         return GraphResult(
1109             status=self.state.status,
1110             results=self.state.results,
1111             accumulated_usage=self.state.accumulated_usage,
1112             accumulated_metrics=self.state.accumulated_metrics,
1113             execution_count=self.state.execution_count,
1114             execution_time=self.state.execution_time,
1115             total_nodes=self.state.total_nodes,
1116             completed_nodes=len(self.state.completed_nodes),
1117             failed_nodes=len(self.state.failed_nodes),
1118             interrupted_nodes=len(self.state.interrupted_nodes),
1119             execution_order=self.state.execution_order,
1120             edges=self.state.edges,
1121             entry_points=self.state.entry_points,
1122             interrupts=interrupts,
1123         )
1124 
1125     def serialize_state(self) -> dict[str, Any]:
1126         """Serialize the current graph state to a dictionary."""
1127         compute_nodes = self._compute_ready_nodes_for_resume()
1128         next_nodes = [n.node_id for n in compute_nodes] if compute_nodes else []
1129         return {
1130             "type": "graph",
1131             "id": self.id,
1132             "status": self.state.status.value,
1133             "completed_nodes": [n.node_id for n in self.state.completed_nodes],
1134             "failed_nodes": [n.node_id for n in self.state.failed_nodes],
1135             "interrupted_nodes": [n.node_id for n in self.state.interrupted_nodes],
1136             "node_results": {k: v.to_dict() for k, v in (self.state.results or {}).items()},
1137             "next_nodes_to_execute": next_nodes,
1138             "current_task": self.state.task,
1139             "execution_order": [n.node_id for n in self.state.execution_order],
1140             "_internal_state": {
1141                 "interrupt_state": self._interrupt_state.to_dict(),
1142             },
1143         }
1144 
1145     def deserialize_state(self, payload: dict[str, Any]) -> None:
1146         """Restore graph state from a session dict and prepare for execution.
1147 
1148         This method handles two scenarios:
1149         1. If the graph execution ended (no next_nodes_to_execute, eg: Completed, or Failed with dead end nodes),
1150         resets all nodes and graph state to allow re-execution from the beginning.
1151         2. If the graph execution was interrupted mid-execution (has next_nodes_to_execute),
1152            restores the persisted state and prepares to resume execution from the next ready nodes.
1153 
1154         Args:
1155             payload: Dictionary containing persisted state data including status,
1156                     completed nodes, results, and next nodes to execute.
1157         """
1158         if "_internal_state" in payload:
1159             internal_state = payload["_internal_state"]
1160             self._interrupt_state = _InterruptState.from_dict(internal_state["interrupt_state"])
1161 
1162         if not payload.get("next_nodes_to_execute"):
1163             # Reset all nodes
1164             for node in self.nodes.values():
1165                 node.reset_executor_state()
1166             # Reset graph state
1167             self.state = GraphState()
1168             self._resume_from_session = False
1169             return
1170         else:
1171             self._from_dict(payload)
1172             self._resume_from_session = True
1173 
1174     def _compute_ready_nodes_for_resume(self) -> list[GraphNode]:
1175         if self.state.status == Status.PENDING:
1176             return []
1177         ready_nodes: list[GraphNode] = []
1178         completed_nodes = set(self.state.completed_nodes)
1179         for node in self.nodes.values():
1180             if node in completed_nodes:
1181                 continue
1182             incoming = [e for e in self.edges if e.to_node is node]
1183             if not incoming:
1184                 ready_nodes.append(node)
1185             elif all(e.from_node in completed_nodes and e.should_traverse(self.state) for e in incoming):
1186                 ready_nodes.append(node)
1187 
1188         return ready_nodes
1189 
1190     def _from_dict(self, payload: dict[str, Any]) -> None:
1191         self.state.status = Status(payload["status"])
1192         # Hydrate completed nodes & results
1193         raw_results = payload.get("node_results") or {}
1194         results: dict[str, NodeResult] = {}
1195         for node_id, entry in raw_results.items():
1196             if node_id not in self.nodes:
1197                 continue
1198             try:
1199                 results[node_id] = NodeResult.from_dict(entry)
1200             except Exception:
1201                 logger.exception("Failed to hydrate NodeResult for node_id=%s; skipping.", node_id)
1202                 raise
1203         self.state.results = results
1204 
1205         self.state.failed_nodes = set(
1206             self.nodes[node_id] for node_id in (payload.get("failed_nodes") or []) if node_id in self.nodes
1207         )
1208         for node in self.state.failed_nodes:
1209             node.execution_status = Status.FAILED
1210 
1211         self.state.interrupted_nodes = set(
1212             self.nodes[node_id] for node_id in (payload.get("interrupted_nodes") or []) if node_id in self.nodes
1213         )
1214         for node in self.state.interrupted_nodes:
1215             node.execution_status = Status.INTERRUPTED
1216 
1217         self.state.completed_nodes = set(
1218             self.nodes[node_id] for node_id in (payload.get("completed_nodes") or []) if node_id in self.nodes
1219         )
1220         for node in self.state.completed_nodes:
1221             node.execution_status = Status.COMPLETED
1222 
1223         # Execution order (only nodes that still exist)
1224         order_node_ids = payload.get("execution_order") or []
1225         self.state.execution_order = [self.nodes[node_id] for node_id in order_node_ids if node_id in self.nodes]
1226 
1227         # Task
1228         self.state.task = payload.get("current_task", self.state.task)
1229 
1230         # next nodes to execute
1231         next_nodes = [self.nodes[nid] for nid in (payload.get("next_nodes_to_execute") or []) if nid in self.nodes]
1232         self._resume_next_nodes = next_nodes

