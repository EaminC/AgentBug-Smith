125     def __init__(
126         self,
127         *,
128         boto_session: boto3.Session | None = None,
129         boto_client_config: BotocoreConfig | None = None,
130         region_name: str | None = None,
131         endpoint_url: str | None = None,
132         **model_config: Unpack[BedrockConfig],
133     ):
134         """Initialize provider instance.
135 
136         Args:
137             boto_session: Boto Session to use when calling the Bedrock Model.
138             boto_client_config: Configuration to use when creating the Bedrock-Runtime Boto Client.
139             region_name: AWS region to use for the Bedrock service.
140                 Defaults to the AWS_REGION environment variable if set, or "us-west-2" if not set.
141             endpoint_url: Custom endpoint URL for VPC endpoints (PrivateLink)
142             **model_config: Configuration options for the Bedrock model.
143         """
144         if region_name and boto_session:
145             raise ValueError("Cannot specify both `region_name` and `boto_session`.")
146 
147         session = boto_session or boto3.Session()
148         resolved_region = region_name or session.region_name or os.environ.get("AWS_REGION") or DEFAULT_BEDROCK_REGION
149         self.config = BedrockModel.BedrockConfig(
150             model_id=BedrockModel._get_default_model_with_warning(resolved_region, model_config),
151             include_tool_result_status="auto",
152         )
153         self.update_config(**model_config)
154 
155         logger.debug("config=<%s> | initializing", self.config)
156 
157         # Add strands-agents to the request user agent
158         if boto_client_config:
159             existing_user_agent = getattr(boto_client_config, "user_agent_extra", None)
160 
161             # Append 'strands-agents' to existing user_agent_extra or set it if not present
162             if existing_user_agent:
163                 new_user_agent = f"{existing_user_agent} strands-agents"
164             else:
165                 new_user_agent = "strands-agents"
166 
167             client_config = boto_client_config.merge(BotocoreConfig(user_agent_extra=new_user_agent))
168         else:
169             client_config = BotocoreConfig(user_agent_extra="strands-agents", read_timeout=DEFAULT_READ_TIMEOUT)
170 
171         self.client = session.client(
172             service_name="bedrock-runtime",
173             config=client_config,
174             endpoint_url=endpoint_url,
175             region_name=resolved_region,
176         )
177 
178         logger.debug("region=<%s> | bedrock client created", self.client.meta.region_name)
179 
180     @property
181     def _cache_strategy(self) -> str | None:
182         """The cache strategy for this model based on its model ID.
183 
184         Returns the appropriate cache strategy name, or None if automatic caching is not supported for this model.
185         """
186         model_id = self.config.get("model_id", "").lower()
187         if "claude" in model_id or "anthropic" in model_id:
188             return "anthropic"
189         return None
190 
191     @override
192     def update_config(self, **model_config: Unpack[BedrockConfig]) -> None:  # type: ignore
193         """Update the Bedrock Model configuration with the provided arguments.
194 
195         Args:
196             **model_config: Configuration overrides.
197         """
198         validate_config_keys(model_config, self.BedrockConfig)
199         self.config.update(model_config)
200 
201     @override
202     def get_config(self) -> BedrockConfig:
203         """Get the current Bedrock Model configuration.
204 
205         Returns:
206             The Bedrock model configuration.
207         """
208         return self.config
