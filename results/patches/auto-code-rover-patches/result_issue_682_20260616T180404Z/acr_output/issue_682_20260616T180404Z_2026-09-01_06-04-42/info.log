617 class Config(str, Enum):
618     """
619     Enumeration representing different configuration modes for the code processing system.
620 
621     Members:
622     - DEFAULT: Standard procedure for generating, executing, and reviewing code.
623     - BENCHMARK: Used for benchmarking the system's performance without execution.
624     - SIMPLE: A basic procedure involving generation, execution, and review.
625     - LITE: A lightweight procedure for generating code without further processing.
626     - CLARIFY: Process that starts with clarifying ambiguities before code generation.
627     - EXECUTE_ONLY: Only executes the code without generation.
628     - EVALUATE: Execute the code and then undergo a human review.
629     - USE_FEEDBACK: Uses prior feedback for code generation and subsequent steps.
630     - IMPROVE_CODE: Focuses on improving existing code based on a provided prompt.
631     - EVAL_IMPROVE_CODE: Validates files and improves existing code.
632     - EVAL_NEW_CODE: Evaluates newly generated code without further steps.
633 
634     Each configuration mode dictates the sequence and type of operations performed on the code.
635     """
636 
637     DEFAULT = "default"
638     BENCHMARK = "benchmark"
639     SIMPLE = "simple"
640     LITE = "lite"
641     CLARIFY = "clarify"
642     EXECUTE_ONLY = "execute_only"
643     EVALUATE = "evaluate"
644     USE_FEEDBACK = "use_feedback"
645     IMPROVE_CODE = "improve_code"
646     EVAL_IMPROVE_CODE = "eval_improve_code"
647     EVAL_NEW_CODE = "eval_new_code"
648 
649 
650 STEPS = {
651     Config.DEFAULT: [
652         simple_gen,
653         gen_entrypoint,
654         execute_entrypoint,
655         human_review,
656     ],
657     Config.LITE: [
658         lite_gen,
659     ],
660     Config.CLARIFY: [
661         clarify,
662         gen_clarified_code,
663         gen_entrypoint,
664         execute_entrypoint,
665         human_review,
666     ],
667     Config.BENCHMARK: [
668         simple_gen,
669         gen_entrypoint,
670     ],
671     Config.SIMPLE: [
672         simple_gen,
673         gen_entrypoint,
674         execute_entrypoint,
675     ],
676     Config.USE_FEEDBACK: [use_feedback, gen_entrypoint, execute_entrypoint, human_review],
677     Config.EXECUTE_ONLY: [execute_entrypoint],
678     Config.EVALUATE: [execute_entrypoint, human_review],
679     Config.IMPROVE_CODE: [
680         set_improve_filelist,
681         get_improve_prompt,
682         improve_existing_code,
683     ],
684     Config.EVAL_IMPROVE_CODE: [assert_files_ready, improve_existing_code],
685     Config.EVAL_NEW_CODE: [simple_gen],
686 }
687 """
688 A dictionary mapping Config modes to a list of associated processing steps.
689 
690 The STEPS dictionary dictates the sequence of functions or operations to be
691 performed based on the selected configuration mode from the Config enumeration.
692 This enables a flexible system where the user can select the desired mode and
693 the system can execute the corresponding steps in sequence.
694 
695 Examples:
696 - For Config.DEFAULT, the system will first generate the code using `simple_gen`,
697   then generate the entry point with `gen_entrypoint`, execute the generated
698   code using `execute_entrypoint`, and finally collect human review using `human_review`.
699 - For Config.LITE, the system will only use the `lite_gen` function to generate the code.
700 
701 This setup allows for modularity and flexibility in handling different user requirements and scenarios.
702 """
703 
