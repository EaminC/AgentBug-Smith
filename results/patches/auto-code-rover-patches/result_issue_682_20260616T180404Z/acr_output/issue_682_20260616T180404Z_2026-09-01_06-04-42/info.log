279 def execute_entrypoint(ai: AI, dbs: DBs) -> List[dict]:
280     """
281     Executes the specified entry point script (`run.sh`) from a workspace.
282 
283     This function prompts the user to confirm whether they wish to execute a script named
284     'run.sh' located in the specified workspace. If the user confirms, the script is
285     executed using a subprocess. The user is informed that they can interrupt the
286     execution at any time using ctrl+c.
287 
288     Parameters:
289     - ai (AI): An instance of the AI model, not directly used in this function but
290       included for consistency with other functions.
291     - dbs (DBs): An instance containing the database configurations and workspace
292       information.
293 
294     Returns:
295     - List[dict]: An empty list. This function does not produce a list of messages
296       but returns an empty list for consistency with the return type of other related
297       functions.
298 
299     Note:
300     The function assumes the presence of a 'run.sh' script in the specified workspace.
301     Ensure the script is available and that it has the appropriate permissions
302     (e.g., executable) before invoking this function.
303     """
304     command = dbs.workspace["run.sh"]
305 
306     print()
307     print(
308         colored(
309             "Do you want to execute this code? (Y/n)",
310             "red",
311         )
312     )
313     print()
314     print(command)
315     print()
316     if input().lower() not in ["", "y", "yes"]:
317         print("Ok, not executing the code.")
318         return []
319     print("Executing the code...")
320     print()
321     print(
322         colored(
323             "Note: If it does not work as expected, consider running the code"
324             + " in another way than above.",
325             "green",
326         )
327     )
328     print()
329     print("You can press ctrl+c *once* to stop the execution.")
330     print()
331 
332     p = subprocess.Popen("bash run.sh", shell=True, cwd=dbs.workspace.path)
333     try:
334         p.wait()
335     except KeyboardInterrupt:
336         print()
337         print("Stopping execution.")
338         print("Execution stopped.")
339         p.kill()
340         print()
341 
342     return []
343 
344 
345 def gen_entrypoint(ai: AI, dbs: DBs) -> List[dict]:
346     """
347     Generates an entry point script based on a given codebase's information.
348 
349     This function prompts the AI model to generate a series of Unix terminal commands
350     required to a) install dependencies and b) run all necessary components of a codebase
351     provided in the workspace. The generated commands are then saved to 'run.sh' in the
352     workspace.
353 
354     Parameters:
355     - ai (AI): An instance of the AI model.
356     - dbs (DBs): An instance containing the database configurations and workspace
357       information, particularly the 'all_output.txt' which contains details about the
358       codebase on disk.
359 
360     Returns:
361     - List[dict]: A list of messages containing the AI's response.
362 
363     Notes:
364     - The AI is instructed not to install packages globally, use 'sudo', provide
365       explanatory comments, or use placeholders. Instead, it should use example values
366       where necessary.
367     - The function uses regular expressions to extract command blocks from the AI's
368       response to create the 'run.sh' script.
369     - It assumes the presence of an 'all_output.txt' file in the specified workspace
370       that contains information about the codebase.
371     """
372     messages = ai.start(
373         system=(
374             "You will get information about a codebase that is currently on disk in "
375             "the current folder.\n"
376             "From this you will answer with code blocks that includes all the necessary "
377             "unix terminal commands to "
378             "a) install dependencies "
379             "b) run all necessary parts of the codebase (in parallel if necessary).\n"
380             "Do not install globally. Do not use sudo.\n"
381             "Do not explain the code, just give the commands.\n"
382             "Do not use placeholders, use example values (like . for a folder argument) "
383             "if necessary.\n"
384         ),
385         user="Information about the codebase:\n\n" + dbs.memory["all_output.txt"],
386         step_name=curr_fn(),
387     )
388     print()
389 
390     regex = r"```\S*\n(.+?)```"
391     matches = re.finditer(regex, messages[-1].content.strip(), re.DOTALL)
392     dbs.workspace["run.sh"] = "\n".join(match.group(1) for match in matches)
393     return messages
394 
