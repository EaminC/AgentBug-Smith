69 # Type hint for chat messages
70 Message = Union[AIMessage, HumanMessage, SystemMessage]
71 
72 
73 def setup_sys_prompt(dbs: DBs) -> str:
74     """
75     Constructs a system prompt for the AI based on predefined instructions and philosophies.
76 
77     This function is responsible for setting up the system prompts for the AI, instructing
78     it on how to generate code and the coding philosophy to adhere to. The constructed prompt
79     consists of the "roadmap", "generate" (with dynamic format replacements), and the coding
80     "philosophy" taken from the given DBs object.
81 
82     Parameters:
83     - dbs (DBs): The database object containing pre-defined prompts and instructions.
84 
85     Returns:
86     - str: The constructed system prompt for the AI.
87     """
88     return (
89         dbs.preprompts["roadmap"]
90         + dbs.preprompts["generate"].replace("FILE_FORMAT", dbs.preprompts["file_format"])
91         + "\nUseful to know:\n"
92         + dbs.preprompts["philosophy"]
93     )
94 
95 
96 def setup_sys_prompt_existing_code(dbs: DBs) -> str:
97     """
98     Constructs a system prompt for the AI focused on improving an existing codebase.
99 
100     This function sets up the system prompts for the AI, guiding it on how to
101     work with and improve an existing code base. The generated prompt consists
102     of the "improve" instruction (with dynamic format replacements) and the coding
103     "philosophy" taken from the given DBs object.
104 
105     Parameters:
106     - dbs (DBs): The database object containing pre-defined prompts and instructions.
107 
108     Returns:
109     - str: The constructed system prompt focused on existing code improvement for the AI.
110     """
111     return (
112         dbs.preprompts["improve"].replace("FILE_FORMAT", dbs.preprompts["file_format"])
113         + "\nUseful to know:\n"
114         + dbs.preprompts["philosophy"]
115     )
116 
117 
118 def curr_fn() -> str:
119     """
120     Retrieves the name of the calling function.
121 
122     This function uses Python's inspection capabilities to dynamically fetch the
123     name of the function that called `curr_fn()`. This approach ensures that the
124     function's name isn't hardcoded, making it more resilient to refactoring and
125     changes to function names.
126 
127     Returns:
128     - str: The name of the function that called `curr_fn()`.
129     """
130     return inspect.stack()[1].function
131 
132 
133 def lite_gen(ai: AI, dbs: DBs) -> List[Message]:
134     """
135     Executes the AI model using the main prompt and saves the generated results.
136 
137     This function invokes the AI model by feeding it the main prompt. After the
138     AI processes and generates the output, the function saves this output to the
139     specified workspace. The AI's output is also tracked using the current function's
140     name to provide context.
141 
142     Parameters:
143     - ai (AI): An instance of the AI model.
144     - dbs (DBs): An instance containing the database configurations, including input prompts
145       and file formatting preferences.
146 
147     Returns:
148     - List[Message]: A list of message objects encapsulating the AI's output.
149 
150     Note:
151     The function assumes the `ai.start` method and the `to_files` utility to be correctly
152     set up and functional. Ensure these prerequisites before invoking `lite_gen`.
153     """
154     messages = ai.start(
155         dbs.input["prompt"], dbs.preprompts["file_format"], step_name=curr_fn()
156     )
157     to_files_and_memory(messages[-1].content.strip(), dbs)
158     return messages
159 
160 
161 def simple_gen(ai: AI, dbs: DBs) -> List[Message]:
162     """
163     Executes the AI model using the default system prompts and saves the output.
164 
165     This function prepares the system prompt using the provided database configurations
166     and then invokes the AI model with this system prompt and the main input prompt.
167     Once the AI generates the output, this function saves it to the specified workspace.
168     The AI's execution is tracked using the name of the current function for contextual reference.
169 
170     Parameters:
171     - ai (AI): An instance of the AI model.
172     - dbs (DBs): An instance containing the database configurations, including system and
173       input prompts, and file formatting preferences.
174 
175     Returns:
176     - List[Message]: A list of message objects encapsulating the AI's generated output.
177 
178     Note:
179     The function assumes the `ai.start` method and the `to_files` utility are correctly
180     set up and functional. Ensure these prerequisites are in place before invoking `simple_gen`.
181     """
182     messages = ai.start(setup_sys_prompt(dbs), dbs.input["prompt"], step_name=curr_fn())
183     to_files_and_memory(messages[-1].content.strip(), dbs)
184     return messages
185 
186 
187 def clarify(ai: AI, dbs: DBs) -> List[Message]:
188     """
189     Interactively queries the user for clarifications on the prompt and saves the AI's responses.
190 
191     This function presents a series of clarifying questions to the user, based on the AI's
192     initial assessment of the provided prompt. The user can continue to interact and seek
193     clarifications until they indicate that they have "nothing to clarify" or manually
194     opt to move on. If the user doesn't provide any input, the AI is instructed to make its
195     own assumptions and to state them explicitly before proceeding.
196 
197     Parameters:
198     - ai (AI): An instance of the AI model.
199     - dbs (DBs): An instance containing the database configurations, which includes system
200       and input prompts.
201 
202     Returns:
203     - List[Message]: A list of message objects encapsulating the AI's generated output and
204       interactions.
205 
206     """
207     messages: List[Message] = [SystemMessage(content=dbs.preprompts["clarify"])]
208     user_input = dbs.input["prompt"]
209     while True:
210         messages = ai.next(messages, user_input, step_name=curr_fn())
211         msg = messages[-1].content.strip()
212 
213         if "nothing to clarify" in msg.lower():
214             break
215 
216         if msg.lower().startswith("no"):
217             print("Nothing to clarify.")
218             break
219 
220         print()
221         user_input = input('(answer in text, or "c" to move on)\n')
222         print()
223 
224         if not user_input or user_input == "c":
225             print("(letting gpt-engineer make its own assumptions)")
226             print()
227             messages = ai.next(
228                 messages,
229                 "Make your own assumptions and state them explicitly before starting",
230                 step_name=curr_fn(),
231             )
232             print()
233             return messages
234 
235         user_input += """
236             \n\n
237             Is anything else unclear? If yes, ask another question.\n
238             Otherwise state: "Nothing to clarify"
239             """
240 
241     print()
242     return messages
243 
