96 def human_review_input() -> Review:
97     """
98     Ask the user to review the generated code and return their review.
99 
100     Returns
101     -------
102     Review
103         The user's review of the generated code.
104     """
105     print()
106     if not check_collection_consent():
107         return None
108     print()
109     print(
110         colored("To help gpt-engineer learn, please answer 3 questions:", "light_green")
111     )
112     print()
113 
114     ran = input("Did the generated code run at all? " + TERM_CHOICES)
115     while ran not in ("y", "n", "u"):
116         ran = input("Invalid input. Please enter y, n, or u: ")
117 
118     perfect = ""
119     useful = ""
120 
121     if ran == "y":
122         perfect = input(
123             "Did the generated code do everything you wanted? " + TERM_CHOICES
124         )
125         while perfect not in ("y", "n", "u"):
126             perfect = input("Invalid input. Please enter y, n, or u: ")
127 
128         if perfect != "y":
129             useful = input("Did the generated code do anything useful? " + TERM_CHOICES)
130             while useful not in ("y", "n", "u"):
131                 useful = input("Invalid input. Please enter y, n, or u: ")
132 
133     comments = ""
134     if perfect != "y":
135         comments = input(
136             "If you have time, please explain what was not working "
137             + colored("(ok to leave blank)\n", "light_green")
138         )
139 
140     return Review(
141         raw=", ".join([ran, perfect, useful]),
142         ran={"y": True, "n": False, "u": None, "": None}[ran],
143         works={"y": True, "n": False, "u": None, "": None}[useful],
144         perfect={"y": True, "n": False, "u": None, "": None}[perfect],
145         comments=comments,
146     )

