198     async def check_permissions(
199         self,
200         tool_input: dict[str, Any],
201         context: PermissionContext,
202     ) -> PermissionDecision:
203         """Check permissions for bash command execution.
204 
205         This method implements Bash-specific permission checks:
206 
207         0. Injection risk check (bypass-immune safety ASK if command
208            contains dynamic expansion like ``$(...)`` or ``<(...)``)
209         1. Read-only command check — auto-ALLOW in **every mode**
210            (including DEFAULT) for known-safe read-only commands
211            (``ls``, ``pwd``, ``git status``, ``cat``, etc.). This is
212            the static counterpart to :meth:`check_read_only`.
213         2. Dangerous command pattern check (bypass-immune safety ASK)
214         3. Sed in-place constraint check (bypass-immune safety ASK)
215         4. Dangerous path check for config files (bypass-immune safety
216            ASK)
217         5. Dangerous removal path check for system dirs (bypass-immune
218            safety ASK)
219         6. ACCEPT_EDITS auto-allow for ``mkdir``/``touch``/``rm``/
220            ``rmdir``/``mv``/``cp``/``sed`` — only when **every**
221            target path resolves inside a working directory
222         7. PASSTHROUGH (engine continues with rule matching)
223 
224         "Bypass-immune" decisions set
225         :attr:`PermissionDecision.bypass_immune` so they cannot be
226         silenced by allow rules in DEFAULT mode. In BYPASS mode all
227         bypass-immune ASKs are intentionally skipped — see
228         :attr:`PermissionMode.BYPASS`.
229 
230         Args:
231             tool_input (`dict[str, Any]`):
232                 The tool input containing "command" key
233             context (`PermissionContext`):
234                 The permission context with mode and rules
235 
236         Returns:
237             `PermissionDecision`:
238                 ALLOW for safe operations, ASK for dangerous operations,
239                 PASSTHROUGH to let Engine continue with rule matching
240         """
241 
242         command = tool_input.get("command", "")
243         if not command:
244             return PermissionDecision(
245                 behavior=PermissionBehavior.PASSTHROUGH,
246                 message="Empty command",
247             )
248 
249         # 0. Injection check: detect dynamic shell structures that cannot be
250         # statically analyzed (command substitution, process substitution,
251         # control flow, etc.). Must run before read-only check so that
252         # `$(rm -rf /)` inside an otherwise-safe command is caught.
253         injection_reason = self._bash_parser.check_injection_risk(command)
254         if injection_reason:
255             return PermissionDecision(
256                 behavior=PermissionBehavior.ASK,
257                 message=f"Permission required: {injection_reason}",
258                 decision_reason="Safety check: command contains dynamic "
259                 "expansion that cannot be statically analyzed",
260                 bypass_immune=True,
261             )
262 
263         # 1. Check if command is read-only (auto-allow)
264         if self._bash_parser.is_read_only_command(command):
265             return PermissionDecision(
266                 behavior=PermissionBehavior.ALLOW,
267                 message="Permission granted for read-only command",
268                 decision_reason="Read-only command is allowed",
269             )
270 
271         # 2. Check for dangerous commands (safety check, bypass-immune)
272         dangerous_pattern = self._bash_parser.check_dangerous_command(command)
273         if dangerous_pattern:
274             return PermissionDecision(
275                 behavior=PermissionBehavior.ASK,
276                 message=f"Permission required: Command contains dangerous "
277                 f"pattern: {dangerous_pattern}",
278                 decision_reason="Safety check: dangerous command pattern "
279                 "detected",
280                 bypass_immune=True,
281             )
282 
283         # 3. Check for sed constraints (safety check, bypass-immune)
284         sed_error = self._bash_parser.check_sed_constraints(
285             command,
286             self.dangerous_files,
287         )
288         if sed_error:
289             return PermissionDecision(
290                 behavior=PermissionBehavior.ASK,
291                 message=f"Permission required: {sed_error}",
292                 decision_reason="Safety check: sed in-place modification "
293                 "of dangerous file",
294                 bypass_immune=True,
295             )
296 
297         # 4. Check for dangerous paths in sensitive config files/dirs
298         # (safety check, bypass-immune)
299         dangerous_paths = self._extract_dangerous_paths_from_bash(command)
300         if dangerous_paths:
301             paths_str = ", ".join(dangerous_paths)
302             return PermissionDecision(
303                 behavior=PermissionBehavior.ASK,
304                 message=f"Permission required: Bash command operates on "
305                 f"sensitive paths: {paths_str}",
306                 decision_reason="Safety check: dangerous file or "
307                 "directory in bash command",
308                 bypass_immune=True,
309             )
310 
311         # 5. Check for dangerous removal paths: rm/rmdir targeting system
312         # critical directories like /, /usr, /etc, ~ (bypass-immune).
313         # Checked separately from step 4 because these paths are not in the
314         # dangerous_files/directories lists — they are system-level paths
315         # that should never be removed regardless of user configuration.
316         removal_path = self._check_dangerous_removal_path(command)
317         if removal_path:
318             return PermissionDecision(
319                 behavior=PermissionBehavior.ASK,
320                 message=f"Dangerous removal operation detected: "
321                 f"'{removal_path}'\n\nThis command would remove a critical "
322                 f"system directory. This requires explicit approval and "
323                 f"cannot be auto-allowed by permission rules.",
324                 decision_reason="Safety check: dangerous removal of "
325                 "critical system path",
326                 bypass_immune=True,
327             )
328 
329         # 6. ACCEPT_EDITS auto-allow for filesystem commands whose targets
330         # all live inside a working directory. Mirrors Write/Edit's strict
331         # working-directory check — we never auto-allow a bash command that
332         # would touch a path outside the configured working set (e.g.
333         # ``cp /etc/hosts /tmp/x`` must not pass even though ``cp`` is in
334         # the auto-allow list).
335         if context.mode == PermissionMode.ACCEPT_EDITS:
336             filesystem_commands = {
337                 "mkdir",
338                 "touch",
339                 "rm",
340                 "rmdir",
341                 "mv",
342                 "cp",
343                 "sed",
344             }
345             base_command = (
346                 command.strip().split()[0] if command.strip() else ""
347             )
348 
349             if base_command in filesystem_commands:
350                 # Collect every target path: file arguments AND output
351                 # redirections. ``extract_file_paths`` includes both.
352                 target_paths = [
353                     path
354                     for _cmd, path in self._bash_parser.extract_file_paths(
355                         command,
356                     )
357                 ]
358                 # Conservative: only auto-allow when we extracted at least
359                 # one target AND every target resolves inside a working
360                 # directory. An empty list means the parser found nothing
361                 # actionable (or the command has no args) — in that case
362                 # we fall through to PASSTHROUGH rather than blindly
363                 # allowing.
364                 if target_paths and all(
365                     self._path_in_allowed_working_path(path, context)
366                     for path in target_paths
367                 ):
368                     return PermissionDecision(
369                         behavior=PermissionBehavior.ALLOW,
370                         message=f"Permission granted for '{base_command}' "
371                         f"command (accept edits mode - filesystem command, "
372                         f"all targets in working directory)",
373                         decision_reason=(
374                             f"Filesystem command '{base_command}' is "
375                             f"auto-allowed in accept edits mode because "
376                             f"all target paths are within a working "
377                             f"directory"
378                         ),
379                     )
380 
381         # 7. Passthrough to let Engine continue with rule matching
382         return PermissionDecision(
383             behavior=PermissionBehavior.PASSTHROUGH,
384             message=f"Execute bash command: {command}",
385         )
386 
387     def match_rule(
388         self,
389         rule_content: str | None,
390         tool_input: dict[str, Any],
391     ) -> bool:
392         r"""Match Bash command using regex-based wildcard matching.
393 
394         Implements wildcard matching with escape sequences:
395         - Supports \* for literal asterisk and \\ for literal backslash
396         - Special optimization: "git *" matches both "git" and "git add"
397         - Prefix pattern (e.g., "git:*"): matches commands starting with "git "
398         - Wildcard pattern: converts to regex with proper escape handling
399         - Substring pattern: exact substring matching
400         - If rule_content is None, matches all invocations
401          (tool-name-level rule)
402 
403         Args:
404             rule_content: The command pattern to match, or None to match all
405             tool_input: Must contain a "command" key with the command string
406 
407         Returns:
408             True if pattern matches the command
409         """
410         # None = tool-name-level rule, matches everything
411         if rule_content is None:
412             return True
413 
414         command = tool_input.get("command", "")
415 
416         # Check if pattern is a prefix pattern (ends with :*)
417         if rule_content.endswith(":*"):
418             prefix = rule_content[:-2].strip()
419             return command.startswith(prefix + " ") or command == prefix
420 
421         # Check if pattern has unescaped wildcards
422         def has_wildcards(pattern: str) -> bool:
423             """Check if pattern contains unescaped * wildcards."""
424             i = 0
425             while i < len(pattern):
426                 if pattern[i] == "\\":
427                     i += 2  # Skip escaped character
428                 elif pattern[i] == "*":
429                     return True
430                 else:
431                     i += 1
432             return False
433 
434         if not has_wildcards(rule_content):
435             # No wildcards, but may have escape sequences
436             # Convert escape sequences for matching
437             pattern = rule_content
438             pattern = pattern.replace("\\\\", "\x00BACKSLASH\x00")
439             pattern = pattern.replace("\\*", "*")
440             pattern = pattern.replace("\x00BACKSLASH\x00", "\\")
441             # Use substring matching with converted pattern
442             return pattern in command
443 
444         # Convert wildcard pattern to regex with escape handling
445         # Use placeholders for escaped sequences
446         ESCAPED_STAR = "\x00ESCAPED_STAR\x00"
447         ESCAPED_BACKSLASH = "\x00ESCAPED_BACKSLASH\x00"
448 
449         pattern = rule_content
450         # Replace \\ with placeholder
451         pattern = pattern.replace("\\\\", ESCAPED_BACKSLASH)
452         # Replace \* with placeholder
453         pattern = pattern.replace("\\*", ESCAPED_STAR)
454 
455         # Manually escape regex special characters (except *)
456         # Don't use re.escape() as it escapes spaces too
457         special_chars = r".^$+?{}[]|()"
458         for char in special_chars:
459             pattern = pattern.replace(char, "\\" + char)
460 
461         # Convert * to regex .* (match any characters)
462         pattern = pattern.replace("*", ".*")
463 
464         # Restore escaped sequences
465         pattern = pattern.replace(ESCAPED_STAR, r"\*")
466         pattern = pattern.replace(ESCAPED_BACKSLASH, r"\\")
467 
468         # Special optimization: "git *" should match both "git" and "git add"
469         # Pattern: if ends with .*, make it optional
470         if pattern.endswith(".*"):
471             base_pattern = pattern[:-2]  # Remove .*
472             # Try exact match first (handles trailing space)
473             base_pattern = base_pattern.rstrip()
474             if re.fullmatch(base_pattern, command):
475                 return True
476 
477         # Full regex match
478         try:
479             return bool(re.fullmatch(pattern, command))
480         except re.error:
481             # Invalid regex, fall back to substring matching
482             return rule_content.replace("*", "") in command
483 
484     def generate_suggestions(
485         self,
486         tool_input: dict[str, Any],
487     ) -> List["PermissionRule"]:
488         """Generate suggested permission rules for Bash commands.
489 
490         Generates prefix rules based on command + subcommand (two words).
491         For example, "git commit -m 'xxx'" generates "git commit:*".
492 
493         Args:
494             tool_input (`dict[str, Any]`):
495                 The tool input data containing "command" key
496 
497         Returns:
498             `List[PermissionRule]`:
499                 List of suggested permission rules based on command prefixes
500         """
501 
502         command = tool_input.get("command", "")
503         if not command:
504             return []
505 
506         # Use bash parser to extract command prefixes
507         prefixes = self._bash_parser.extract_command_prefixes(
508             command,
509             max_prefixes=5,
510         )
511 
512         if not prefixes:
513             # Cannot extract any prefix, return empty
514             return []
515 
516         # Generate rules for each prefix
517         rules = []
518         for prefix in prefixes:
519             rules.append(
520                 PermissionRule(
521                     tool_name="Bash",
522                     rule_content=f"{prefix}:*",
523                     behavior=PermissionBehavior.ALLOW,
524                     source="suggested",
525                 ),
526             )
527 
528         return rules
529 
530     def _extract_dangerous_paths_from_bash(
531         self,
532         command: str,
533     ) -> list[str]:
534         """Extract dangerous paths from a bash command using tree-sitter.
535 
536         Checks for dangerous paths in:
537         - File-manipulating commands (rm, mv, cp, chmod, chown, sed, touch)
538         - Output redirections (>, >>)
539 
540         Args:
541             command (`str`):
542                 The bash command string
543 
544         Returns:
545             `list[str]`:
546                 List of dangerous paths found in the command
547         """
548         dangerous_paths = []
549 
550         # Use tree-sitter to extract file paths
551         file_paths = self._bash_parser.extract_file_paths(command)
552 
553         for _cmd_name, path in file_paths:
554             if self._is_dangerous_path(path):
555                 dangerous_paths.append(path)
556 
557         return dangerous_paths
558 
559     def _check_dangerous_removal_path(self, command: str) -> str | None:
560         """Check if an rm/rmdir command targets a critical system path.
561 
562         Detects commands like `rm -rf /`, `rm -rf /usr`, `rmdir ~` that
563         would destroy critical system directories. Unlike _is_dangerous_path
564         (which checks against a configurable list of sensitive config files),
565         this checks against a fixed set of system-level paths that must
566         never be removed regardless of user configuration.
567 
568         Dangerous paths are:
569         - Root directory (/)
570         - Home directory (~)
571         - Wildcard alone (*) or as dir/* (removes everything)
572         - Direct children of root (/usr, /etc, /tmp, /var, etc.)
573 
574         Args:
575             command (`str`):
576                 The bash command string
577 
578         Returns:
579             `str | None`:
580                 The dangerous path if found, None otherwise
581         """
582         tokens = command.strip().split()
583         if not tokens:
584             return None
585 
586         # Find rm or rmdir subcommands (handle compound commands)
587         try:
588             tree = self._bash_parser.parser.parse(bytes(command, "utf8"))
589             subcommands = self._bash_parser.split_compound_command(
590                 tree.root_node,
591                 command,
592             )
593         except Exception:
594             subcommands = [command]
595 
596         # Check each subcommand for rm/rmdir
597         for subcmd in subcommands:
598             subcmd_tokens = subcmd.strip().split()
599             if not subcmd_tokens:
600                 continue
601             base = subcmd_tokens[0]
602             if base not in ("rm", "rmdir"):
603                 continue
604 
605             # Collect non-flag arguments as potential paths
606             i = 1
607             while i < len(subcmd_tokens):
608                 tok = subcmd_tokens[i]
609                 # Skip flags
610                 if tok.startswith("-"):
611                     i += 1
612                     continue
613                 path = tok.strip("'\"")
614                 if self._is_dangerous_removal_path(path):
615                     return path
616                 i += 1
617 
618         return None
619 
620     def _is_dangerous_removal_path(self, path: str) -> bool:
621         """Check if a path is a critical system directory that must not be
622         removed.
623 
624         Args:
625             path (`str`):
626                 The path to check (may be relative, absolute, or contain ~)
627 
628         Returns:
629             `bool`:
630                 True if removing this path would be catastrophic
631         """
632 
633         # Bare wildcard
634         if path in ("*", "./*", "/"):
635             return True
636         # Ends with /* — removes everything in a directory
637         if path.endswith("/*") or path.endswith("\\*"):
638             return True
639 
640         # Expand tilde and resolve to absolute path
641         expanded = os.path.expanduser(path)
642         # Don't resolve symlinks — /tmp is a symlink on macOS but is
643         # still a root-child and should be flagged
644         abs_path = os.path.normpath(os.path.abspath(expanded))
645 
646         # Home directory
647         home = os.path.expanduser("~")
648         if abs_path == home:
649             return True
650 
651         # Root itself
652         if abs_path == "/":
653             return True
654 
655         # Direct children of root: /usr, /etc, /tmp, /var, /bin, etc.
656         parent = os.path.dirname(abs_path)
657         if parent == "/":
658             return True
659 
660         return False
661 
662     async def __call__(  # type: ignore[override]
663         self,
664         command: str,
665         description: str = "",
666         timeout: int = 120000,
667     ) -> AsyncGenerator[ToolChunk, None]:
668         """Execute the bash and return the output.
669 
670         Args:
671             command: The bash command to execute.
672             description: Optional description of what the command does.
673             timeout: Timeout in milliseconds (default: 120000, max: 600000).
674 
675         Yields:
676             ToolChunk: The tool execution result with stdout/stderr content.
677         """
678 
679         # Clamp timeout to max 600000ms and convert to seconds
680         timeout_ms = min(timeout, 600000)
681         timeout_sec = timeout_ms / 1000.0
682 
683         try:
684             # Create subprocess
685             process = await asyncio.create_subprocess_shell(
686                 command,
687                 stdout=asyncio.subprocess.PIPE,
688                 stderr=asyncio.subprocess.PIPE,
689                 **_subprocess_creation_kwargs(),
690             )
691 
692             # Wait for completion with timeout
693             stdout_bytes, stderr_bytes = await asyncio.wait_for(
694                 process.communicate(),
695                 timeout=timeout_sec,
696             )
697 
698             # Decode and normalize line endings
699             stdout = stdout_bytes.decode("utf-8", errors="replace").replace(
700                 "\r\n",
701                 "\n",
702             )
703             stderr = stderr_bytes.decode("utf-8", errors="replace").replace(
704                 "\r\n",
705                 "\n",
706             )
707 
708             # Combine output
709             output = stdout
710             if stderr:
711                 if output:
712                     output += "\n"
713                 output += stderr
714 
715             # Truncate if exceeds 30000 characters
716             if len(output) > 30000:
717                 output = output[:30000] + "\n... (output truncated)"
718 
719             # Check exit code
720             if process.returncode != 0:
721                 # Command failed
722                 result = f"Command failed: {command}\n"
723                 if stdout:
724                     result += f"\nStdout:\n{stdout}"
725                 if stderr:
726                     result += f"\nStderr:\n{stderr}"
727 
728                 # Truncate error message if needed
729                 if len(result) > 30000:
730                     result = result[:30000] + "\n... (output truncated)"
731 
732                 yield ToolChunk(
733                     content=[TextBlock(text=result)],
734                     state="error",
735                     is_last=True,
736                 )
737             else:
738                 # Command succeeded - note: ToolChunk uses "running" state
739                 # which will be converted to "finished" in ToolResponse
740                 yield ToolChunk(
741                     content=[TextBlock(text=output)],
742                     state="running",
743                     is_last=True,
744                 )
745 
746         except asyncio.TimeoutError:
747             # Timeout occurred
748             error_msg = f"Command timed out after {timeout_ms}ms: {command}"
749             yield ToolChunk(
750                 content=[TextBlock(text=error_msg)],
751                 state="error",
752                 is_last=True,
753             )
754 
755         except Exception as e:
756             # Other errors
757             error_msg = f"Command failed: {command}\nError: {str(e)}"
758             yield ToolChunk(
759                 content=[TextBlock(text=error_msg)],
760                 state="error",
761                 is_last=True,
762             )

