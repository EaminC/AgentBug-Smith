181     async def check_read_only(
182         self,
183         tool_input: dict[str, Any],
184     ) -> bool:
185         """Decide whether this specific bash invocation is read-only.
186 
187         Inspects the command and returns ``True`` for known-safe read-only
188         commands (e.g. ``ls``, ``cat``, ``grep``, ``git status``). The
189         static :attr:`is_read_only` class attribute is ``False`` because
190         Bash can execute arbitrary commands; this method overrides that
191         with a per-invocation answer.
192         """
193         command = tool_input.get("command", "")
194         if not command:
195             return self.is_read_only
196         return self._bash_parser.is_read_only_command(command)
