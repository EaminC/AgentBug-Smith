153     def __init__(  # pylint: disable=dangerous-default-value
154         self,
155         dangerous_files: list[str] = DEFAULT_DANGEROUS_FILES,
156         dangerous_directories: list[str] = DEFAULT_DANGEROUS_DIRECTORIES,
157     ) -> None:
158         """Initialize the bash tool.
159 
160         Args:
161             dangerous_files (`list[str]`, optional):
162                 Sensitive files that require explicit user confirmation,
163                 even in BYPASS mode. Matched by basename
164                 (case-insensitive). Defaults to `DEFAULT_DANGEROUS_FILES`.
165                 Pass a custom list to fully replace the defaults, or `[]`
166                 to disable the filename check.
167             dangerous_directories (`list[str]`, optional):
168                 Sensitive directories that require explicit user
169                 confirmation. Matched when any path segment equals an
170                 entry (case-insensitive). Defaults to
171                 `DEFAULT_DANGEROUS_DIRECTORIES`. Pass a custom list to
172                 fully replace the defaults, or `[]` to disable the
173                 directory check.
174         """
175 
176         self._bash_parser = BashCommandParser()
177 
178         self.dangerous_files = list(dangerous_files)
179         self.dangerous_directories = list(dangerous_directories)
