559     def _check_dangerous_removal_path(self, command: str) -> str | None:
560         """Check if an rm/rmdir command targets a critical system path.
561 
562         Detects commands like `rm -rf /`, `rm -rf /usr`, `rmdir ~` that
563         would destroy critical system directories. Unlike _is_dangerous_path
564         (which checks against a configurable list of sensitive config files),
565         this checks against a fixed set of system-level paths that must
566         never be removed regardless of user configuration.
567 
568         Dangerous paths are:
569         - Root directory (/)
570         - Home directory (~)
571         - Wildcard alone (*) or as dir/* (removes everything)
572         - Direct children of root (/usr, /etc, /tmp, /var, etc.)
573 
574         Args:
575             command (`str`):
576                 The bash command string
577 
578         Returns:
579             `str | None`:
580                 The dangerous path if found, None otherwise
581         """
582         tokens = command.strip().split()
583         if not tokens:
584             return None
585 
586         # Find rm or rmdir subcommands (handle compound commands)
587         try:
588             tree = self._bash_parser.parser.parse(bytes(command, "utf8"))
589             subcommands = self._bash_parser.split_compound_command(
590                 tree.root_node,
591                 command,
592             )
593         except Exception:
594             subcommands = [command]
595 
596         # Check each subcommand for rm/rmdir
597         for subcmd in subcommands:
598             subcmd_tokens = subcmd.strip().split()
599             if not subcmd_tokens:
600                 continue
601             base = subcmd_tokens[0]
602             if base not in ("rm", "rmdir"):
603                 continue
604 
605             # Collect non-flag arguments as potential paths
606             i = 1
607             while i < len(subcmd_tokens):
608                 tok = subcmd_tokens[i]
609                 # Skip flags
610                 if tok.startswith("-"):
611                     i += 1
612                     continue
613                 path = tok.strip("'\"")
614                 if self._is_dangerous_removal_path(path):
615                     return path
616                 i += 1
617 
618         return None
619 
620     def _is_dangerous_removal_path(self, path: str) -> bool:
621         """Check if a path is a critical system directory that must not be
622         removed.
623 
624         Args:
625             path (`str`):
626                 The path to check (may be relative, absolute, or contain ~)
627 
628         Returns:
629             `bool`:
630                 True if removing this path would be catastrophic
631         """
632 
633         # Bare wildcard
634         if path in ("*", "./*", "/"):
635             return True
636         # Ends with /* — removes everything in a directory
637         if path.endswith("/*") or path.endswith("\\*"):
638             return True
639 
640         # Expand tilde and resolve to absolute path
641         expanded = os.path.expanduser(path)
642         # Don't resolve symlinks — /tmp is a symlink on macOS but is
643         # still a root-child and should be flagged
644         abs_path = os.path.normpath(os.path.abspath(expanded))
645 
646         # Home directory
647         home = os.path.expanduser("~")
648         if abs_path == home:
649             return True
650 
651         # Root itself
652         if abs_path == "/":
653             return True
654 
655         # Direct children of root: /usr, /etc, /tmp, /var, /bin, etc.
656         parent = os.path.dirname(abs_path)
657         if parent == "/":
658             return True
659 
660         return False
661 
662     async def __call__(  # type: ignore[override]
663         self,
664         command: str,
665         description: str = "",
666         timeout: int = 120000,
667     ) -> AsyncGenerator[ToolChunk, None]:
668         """Execute the bash and return the output.
669 
670         Args:
671             command: The bash command to execute.
672             description: Optional description of what the command does.
673             timeout: Timeout in milliseconds (default: 120000, max: 600000).
674 
675         Yields:
676             ToolChunk: The tool execution result with stdout/stderr content.
677         """
678 
679         # Clamp timeout to max 600000ms and convert to seconds
680         timeout_ms = min(timeout, 600000)
681         timeout_sec = timeout_ms / 1000.0
682 
683         try:
684             # Create subprocess
685             process = await asyncio.create_subprocess_shell(
686                 command,
687                 stdout=asyncio.subprocess.PIPE,
688                 stderr=asyncio.subprocess.PIPE,
689                 **_subprocess_creation_kwargs(),
690             )
691 
692             # Wait for completion with timeout
693             stdout_bytes, stderr_bytes = await asyncio.wait_for(
694                 process.communicate(),
695                 timeout=timeout_sec,
696             )
697 
698             # Decode and normalize line endings
699             stdout = stdout_bytes.decode("utf-8", errors="replace").replace(
700                 "\r\n",
701                 "\n",
702             )
703             stderr = stderr_bytes.decode("utf-8", errors="replace").replace(
704                 "\r\n",
705                 "\n",
706             )
707 
708             # Combine output
709             output = stdout
710             if stderr:
711                 if output:
712                     output += "\n"
713                 output += stderr
714 
715             # Truncate if exceeds 30000 characters
716             if len(output) > 30000:
717                 output = output[:30000] + "\n... (output truncated)"
718 
719             # Check exit code
720             if process.returncode != 0:
721                 # Command failed
722                 result = f"Command failed: {command}\n"
723                 if stdout:
724                     result += f"\nStdout:\n{stdout}"
725                 if stderr:
726                     result += f"\nStderr:\n{stderr}"
727 
728                 # Truncate error message if needed
729                 if len(result) > 30000:
730                     result = result[:30000] + "\n... (output truncated)"
731 
732                 yield ToolChunk(
733                     content=[TextBlock(text=result)],
734                     state="error",
735                     is_last=True,
736                 )
737             else:
738                 # Command succeeded - note: ToolChunk uses "running" state
739                 # which will be converted to "finished" in ToolResponse
740                 yield ToolChunk(
741                     content=[TextBlock(text=output)],
742                     state="running",
743                     is_last=True,
744                 )
745 
746         except asyncio.TimeoutError:
747             # Timeout occurred
748             error_msg = f"Command timed out after {timeout_ms}ms: {command}"
749             yield ToolChunk(
750                 content=[TextBlock(text=error_msg)],
751                 state="error",
752                 is_last=True,
753             )
754 
755         except Exception as e:
756             # Other errors
757             error_msg = f"Command failed: {command}\nError: {str(e)}"
758             yield ToolChunk(
759                 content=[TextBlock(text=error_msg)],
760                 state="error",
761                 is_last=True,
762             )

