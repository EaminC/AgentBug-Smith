153     def __init__(  # pylint: disable=dangerous-default-value
154         self,
155         dangerous_files: list[str] = DEFAULT_DANGEROUS_FILES,
156         dangerous_directories: list[str] = DEFAULT_DANGEROUS_DIRECTORIES,
