62     class BedrockConfig(TypedDict, total=False):
63         """Configuration options for Bedrock models.
64 
65         Attributes:
66             additional_args: Any additional arguments to include in the request
67             additional_request_fields: Additional fields to include in the Bedrock request
68             additional_response_field_paths: Additional response field paths to extract
69             cache_prompt: Cache point type for the system prompt
70             cache_tools: Cache point type for tools
