50 class BedrockModel(Model):
51     """AWS Bedrock model provider implementation.
52 
53     The implementation handles Bedrock-specific features such as:
54 
55     - Tool configuration for function calling
56     - Guardrails integration
57     - Caching points for system prompts and tools
58     - Streaming responses
59     - Context window overflow detection
60     """
