560     async def _reply(
561         self,
562         inputs: Msg
563         | list[Msg]
564         | UserConfirmResultEvent
565         | UserInterruptEvent
566         | ExternalExecutionResultEvent
567         | None = None,
568     ) -> AsyncGenerator[AgentEvent | Msg, None]:
569         """Reply entry point (maybe wrapped by middleware)."""
570         if not self._reply_middlewares:
571             async for item in self._reply_impl(inputs=inputs):
572                 yield item
573         else:
574 
575             async def execute_chain(
576                 index: int = 0,
577                 inputs: Msg
578                 | list[Msg]
579                 | UserConfirmResultEvent
580                 | UserInterruptEvent
581                 | ExternalExecutionResultEvent
582                 | None = inputs,
583             ) -> AsyncGenerator[AgentEvent | Msg, None]:
584                 if index >= len(self._reply_middlewares):
585                     async for item in self._reply_impl(inputs=inputs):
586                         yield item
587                 else:
588                     mw = self._reply_middlewares[index]
589                     input_kwargs = {"inputs": inputs}
590 
591                     async def next_handler(
592                         **kwargs: Any,
593                     ) -> AsyncGenerator[AgentEvent | Msg, None]:
594                         async for item in execute_chain(
595                             index + 1,
596                             **{**input_kwargs, **kwargs},
597                         ):
598                             yield item
599 
600                     async for item in mw.on_reply(
601                         agent=self,
602                         input_kwargs=input_kwargs,
603                         next_handler=next_handler,
604                     ):
605                         yield item
606 
607             async for item in execute_chain():
608                 yield item
