307                     await self._compress_context_impl(
308                         context_config=context_config,
309                         instructions=instructions,
310                     )
311                 else:
312                     mw = self._compress_context_middlewares[index]
313                     input_kwargs = {
314                         "context_config": context_config,
315                         "instructions": instructions,
316                     }
317 
318                     async def next_handler(**kwargs: Any) -> None:
319                         await execute_chain(
320                             index + 1,
321                             **{**input_kwargs, **kwargs},
322                         )
323 
324                     await mw.on_compress_context(
325                         agent=self,
326                         input_kwargs=input_kwargs,
327                         next_handler=next_handler,
328                     )
329 
330             await execute_chain()
