230     async def reply(
231         self,
232         inputs: Msg
233         | list[Msg]
234         | UserConfirmResultEvent
235         | UserInterruptEvent
236         | ExternalExecutionResultEvent
237         | None = None,
238     ) -> Msg:
239         """Reply to the given inputs, consuming all streamed events.
240 
241         Args:
242             inputs (`Msg | list[Msg] | UserConfirmResultEvent | \
243             UserInterruptEvent | ExternalExecutionResultEvent | None`, \
244             optional):
245                 The inputs that trigger this reply. It can be:
246 
247                 - a single `Msg` or a list of `Msg` objects to start a new
248                   reply,
249                 - a `UserConfirmResultEvent` or
250                   `ExternalExecutionResultEvent` to continue from the
251                   outside interaction required by the previous reply,
252                 - a `UserInterruptEvent` to abort a parked reply — the
253                   agent closes all pending tool calls with an interrupted
254                   tool result and ends the reply without entering the
255                   reasoning-acting loop,
256                 - `None` if there is nothing new to feed in (e.g. just
257                   continue from the current state).
258 
259         Returns:
260             `Msg`:
261                 A final reply message.
262         """
263         final_msg: Msg | None = None
264         async for evt_or_msg in self._reply(inputs=inputs):
265             if isinstance(evt_or_msg, Msg):
266                 final_msg = evt_or_msg
267         if final_msg is None:
268             raise RuntimeError("Agent did not produce a final message.")
269         return final_msg
