332     async def _compress_context_impl(
333         self,
334         context_config: ContextConfig | None = None,
335         instructions: HintBlock | None = None,
336     ) -> None:
337         """Compress the agent's context if the token count exceeds the
338         threshold.
339 
340         Args:
341             context_config (`ContextConfig | None`, optional):
342                 If provided, compress the context with the given context
343                 config. Otherwise, use the default context config in the
344                 agent.
345             instructions (`HintBlock | None`, optional):
346                 Optional hints or instructions injected into the compression
347                 context to guide the summarization behavior.
348         """
349         cfg: ContextConfig = context_config or self.context_config
350 
351         # Count the current tokens
352         kwargs = await self._prepare_model_input()
353         estimated_tokens = await self.model.count_tokens(**kwargs)
354 
355         # Skip if no compression is needed
356         threshold = cfg.trigger_ratio * self.model.context_size
357         if estimated_tokens < threshold:
358             return
359 
360         logger.info(
361             "[AGENT %s]: Current token count %d exceeds the threshold %d, "
362             "activating compression.",
363             self.name,
364             int(estimated_tokens),
365             int(threshold),
366         )
367 
368         if len(self.state.context) == 0:
369             # The system prompt and the summary (if exists) exceeds the
370             # threshold, which cannot be compressed, raise the error to the
371             # developer!
372             suffix = ""
373             if self.state.summary:
374                 suffix = "and the compression summary "
375             raise RuntimeError(
376                 f"The system prompt {suffix}exceed(s) the compression "
377                 f"threshold ({threshold} tokens), cannot be compressed.",
378             )
379 
380         # Split the context into the ones to be compressed, and the others to
381         # be reserved
382         tools = kwargs.get("tools", [])
383         (
384             msgs_to_compress,
385             msgs_to_reserve,
386         ) = await self._split_context_for_compression(
387             cfg.reserve_ratio * self.model.context_size,
388             tools,
389         )
390 
391         if len(msgs_to_compress) == 0:
392             # The reserve ratio is too large so that although it exceeds the
393             # trigger threshold, the context to be compressed is empty
394             # Fallback by lowering the reserve ratio to compress more context.
395             logger.warning(
396                 "The reserve ratio %.2f is too large to compress any context."
397                 "Lower the reserve ratio to 0 as a fallback.",
398                 cfg.reserve_ratio,
399             )
400             (
401                 msgs_to_compress,
402                 msgs_to_reserve,
403             ) = await self._split_context_for_compression(
404                 0 * self.model.context_size,
405                 tools,
406             )
407 
408             # The msgs to be compressed cannot be empty here, unless the
409             # system prompt and summary (if any) already exceed the context
410             # length, which we have handled before.
411 
412         # Prepare the messages to compress
413         msgs_system = [
414             SystemMsg(
415                 name="system",
416                 content=await self._get_system_prompt(),
417             ),
418         ]
419         if self.state.summary:
420             msgs_system.append(UserMsg("user", self.state.summary))
421 
422         instruction_msgs: list[Msg] = []
423         if instructions is not None:
424             instruction_msgs.append(
425                 AssistantMsg(
426                     name=self.name,
427                     content=[instructions],
428                 ),
429             )
430 
431         messages = (
432             msgs_system
433             + msgs_to_compress
434             + instruction_msgs
435             + [
436                 UserMsg(name="user", content=cfg.compression_prompt),
437             ]
438         )
439 
440         # The compression prompt may exceed the context length, here we mark
441         # the overflow by a bool flag
442         compression_tool_schema = [
443             {
444                 "type": "function",
445                 "function": {
446                     "name": "generate_structured_output",
447                     "description": "Call this function to generate "
448                     "structured output required by "
449                     "the user.",
450                     "parameters": cfg.summary_schema,
451                 },
452             },
453         ]
454         context_overflow = False
455         estimated_compression_tokens = await self.model.count_tokens(
456             messages,
457             compression_tool_schema,
458         )
459         if estimated_compression_tokens > self.model.context_size:
460             logger.warning(
461                 "The current context length exceeds the model's context "
462                 "length (%d tokens), the compression maybe failed due to "
463                 "insufficient reserved context for compression.",
464                 self.model.context_size,
465             )
466             context_overflow = True
467 
468         # Compress the messages
469         try:
470             res = await self.model.generate_structured_output(
471                 messages=messages,
472                 structured_model=cfg.summary_schema,
473             )
474 
475         except Exception as e:
476             if context_overflow:
477                 logger.warning(
478                     "Failed to compress context, which may be caused by "
479                     "insufficient reserved context for compression. "
480                     "Trying to compress by removing the oldest context.",
481                 )
482                 for i in range(1, len(msgs_to_compress) + 1):
483                     messages = (
484                         msgs_system
485                         + msgs_to_compress[i:]
486                         + instruction_msgs
487                         + [
488                             UserMsg(
489                                 name="user",
490                                 content=cfg.compression_prompt,
491                             ),
492                         ]
493                     )
494                     estimated_compression_tokens = (
495                         await self.model.count_tokens(
496                             messages,
497                             compression_tool_schema,
498                         )
499                     )
500                     # Considering trigger_ratio <= 0.9, at least reserve 10%
501                     # tokens for compression response
502                     if (
503                         estimated_compression_tokens
504                         < self.model.context_size * cfg.trigger_ratio
505                     ):
506                         break
507 
508                 res = await self.model.generate_structured_output(
509                     messages=messages,
510                     structured_model=cfg.summary_schema,
511                 )
512 
513             else:
514                 raise e from None
515 
516         if res.finished_reason == FinishedReason.INTERRUPTED:
517             logger.warning(
518                 "The context compression was interrupted and skipped. ",
519             )
520             raise asyncio.CancelledError()
521 
522         # Update the summary
523         async def _apply_change() -> None:
524             """Apply the context change with interruption protection."""
525             new_summary = cfg.summary_template.format(**res.content)
526             if self.offloader:
527                 path = await self.offloader.offload_context(
528                     self.state.session_id,
529                     msgs=msgs_to_compress,
530                 )
531                 new_summary += (
532                     f"\n<system-reminder>The compressed context is offloaded "
533                     f"to '{path}', you can refer to it when needed."
534                     f"</system-reminder>"
535                 )
536 
537             # Protected from interruption
538             await self._clear_unreserved_read_cache(msgs_to_reserve)
539 
540             # Update the context
541             self.state.summary = new_summary
542             self.state.context = msgs_to_reserve
543 
544             logger.info(
545                 "[AGENT %s]: The context compression finished.",
546                 self.name,
547             )
548 
549         apply_task = asyncio.create_task(_apply_change())
550         try:
551             await asyncio.shield(apply_task)
552         except asyncio.CancelledError:
553             await apply_task
554             raise
