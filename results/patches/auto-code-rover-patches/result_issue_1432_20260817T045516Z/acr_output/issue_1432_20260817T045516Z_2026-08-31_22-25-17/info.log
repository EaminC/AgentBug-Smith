449     async def structured_output_async(self, output_model: type[T], prompt: AgentInput = None) -> T:
450         """This method allows you to get structured output from the agent.
451 
452         If you pass in a prompt, it will be used temporarily without adding it to the conversation history.
453         If you don't pass in a prompt, it will use only the existing conversation history to respond.
454 
455         For smaller models, you may want to use the optional prompt to add additional instructions to explicitly
456         instruct the model to output the structured data.
457 
458         Args:
459             output_model: The output model (a JSON schema written as a Pydantic BaseModel)
460                 that the agent will use when responding.
461             prompt: The prompt to use for the agent (will not be added to conversation history).
462 
463         Raises:
464             ValueError: If no conversation history or prompt is provided.
465         -
466         """
467         if self._interrupt_state.activated:
468             raise RuntimeError("cannot call structured output during interrupt")
469 
470         warnings.warn(
471             "Agent.structured_output_async method is deprecated."
472             " You should pass in `structured_output_model` directly into the agent invocation."
473             " see: https://strandsagents.com/latest/documentation/docs/user-guide/concepts/agents/structured-output/",
474             category=DeprecationWarning,
475             stacklevel=2,
476         )
477         await self.hooks.invoke_callbacks_async(BeforeInvocationEvent(agent=self))
478         with self.tracer.tracer.start_as_current_span(
479             "execute_structured_output", kind=trace_api.SpanKind.CLIENT
480         ) as structured_output_span:
481             try:
482                 if not self.messages and not prompt:
483                     raise ValueError("No conversation history or prompt provided")
484 
485                 temp_messages: Messages = self.messages + await self._convert_prompt_to_messages(prompt)
486 
487                 structured_output_span.set_attributes(
488                     {
489                         "gen_ai.system": "strands-agents",
490                         "gen_ai.agent.name": self.name,
491                         "gen_ai.agent.id": self.agent_id,
492                         "gen_ai.operation.name": "execute_structured_output",
493                     }
494                 )
495                 if self.system_prompt:
496                     structured_output_span.add_event(
497                         "gen_ai.system.message",
498                         attributes={"role": "system", "content": serialize([{"text": self.system_prompt}])},
499                     )
500                 for message in temp_messages:
501                     structured_output_span.add_event(
502                         f"gen_ai.{message['role']}.message",
503                         attributes={"role": message["role"], "content": serialize(message["content"])},
504                     )
505                 events = self.model.structured_output(output_model, temp_messages, system_prompt=self.system_prompt)
506                 async for event in events:
507                     if isinstance(event, TypedEvent):
508                         event.prepare(invocation_state={})
509                         if event.is_callback_event:
510                             self.callback_handler(**event.as_dict())
511 
512                 structured_output_span.add_event(
513                     "gen_ai.choice", attributes={"message": serialize(event["output"].model_dump())}
514                 )
515                 return event["output"]
516 
517             finally:
518                 await self.hooks.invoke_callbacks_async(AfterInvocationEvent(agent=self))
