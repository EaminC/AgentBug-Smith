335     def __call__(
336         self,
337         prompt: AgentInput = None,
338         *,
339         invocation_state: dict[str, Any] | None = None,
340         structured_output_model: type[BaseModel] | None = None,
341         **kwargs: Any,
342     ) -> AgentResult:
343         """Process a natural language prompt through the agent's event loop.
344 
345         This method implements the conversational interface with multiple input patterns:
346         - String input: `agent("hello!")`
347         - ContentBlock list: `agent([{"text": "hello"}, {"image": {...}}])`
348         - Message list: `agent([{"role": "user", "content": [{"text": "hello"}]}])`
349         - No input: `agent()` - uses existing conversation history
350 
351         Args:
352             prompt: User input in various formats:
353                 - str: Simple text input
354                 - list[ContentBlock]: Multi-modal content blocks
355                 - list[Message]: Complete messages with roles
356                 - None: Use existing conversation history
357             invocation_state: Additional parameters to pass through the event loop.
358             structured_output_model: Pydantic model type(s) for structured output (overrides agent default).
359             **kwargs: Additional parameters to pass through the event loop.[Deprecating]
360 
361         Returns:
362             Result object containing:
363 
364                 - stop_reason: Why the event loop stopped (e.g., "end_turn", "max_tokens")
365                 - message: The final message from the model
366                 - metrics: Performance metrics from the event loop
367                 - state: The final state of the event loop
368                 - structured_output: Parsed structured output when structured_output_model was specified
369         """
370         return run_async(
371             lambda: self.invoke_async(
372                 prompt, invocation_state=invocation_state, structured_output_model=structured_output_model, **kwargs
373             )
374         )
