335     def __call__(
336         self,
337         prompt: AgentInput = None,
338         *,
339         invocation_state: dict[str, Any] | None = None,
340         structured_output_model: type[BaseModel] | None = None,
341         **kwargs: Any,
342     ) -> AgentResult:
343         """Process a natural language prompt through the agent's event loop.
344 
345         This method implements the conversational interface with multiple input patterns:
346         - String input: `agent("hello!")`
347         - ContentBlock list: `agent([{"text": "hello"}, {"image": {...}}])`
348         - Message list: `agent([{"role": "user", "content": [{"text": "hello"}]}])`
349         - No input: `agent()` - uses existing conversation history
350 
351         Args:
352             prompt: User input in various formats:
353                 - str: Simple text input
354                 - list[ContentBlock]: Multi-modal content blocks
355                 - list[Message]: Complete messages with roles
356                 - None: Use existing conversation history
357             invocation_state: Additional parameters to pass through the event loop.
358             structured_output_model: Pydantic model type(s) for structured output (overrides agent default).
359             **kwargs: Additional parameters to pass through the event loop.[Deprecating]
360 
361         Returns:
362             Result object containing:
363 
364                 - stop_reason: Why the event loop stopped (e.g., "end_turn", "max_tokens")
365                 - message: The final message from the model
366                 - metrics: Performance metrics from the event loop
367                 - state: The final state of the event loop
368                 - structured_output: Parsed structured output when structured_output_model was specified
369         """
370         return run_async(
371             lambda: self.invoke_async(
372                 prompt, invocation_state=invocation_state, structured_output_model=structured_output_model, **kwargs
373             )
374         )
375 
376     async def invoke_async(
377         self,
378         prompt: AgentInput = None,
379         *,
380         invocation_state: dict[str, Any] | None = None,
381         structured_output_model: type[BaseModel] | None = None,
382         **kwargs: Any,
383     ) -> AgentResult:
384         """Process a natural language prompt through the agent's event loop.
385 
386         This method implements the conversational interface with multiple input patterns:
387         - String input: Simple text input
388         - ContentBlock list: Multi-modal content blocks
389         - Message list: Complete messages with roles
390         - No input: Use existing conversation history
391 
392         Args:
393             prompt: User input in various formats:
394                 - str: Simple text input
395                 - list[ContentBlock]: Multi-modal content blocks
396                 - list[Message]: Complete messages with roles
397                 - None: Use existing conversation history
398             invocation_state: Additional parameters to pass through the event loop.
399             structured_output_model: Pydantic model type(s) for structured output (overrides agent default).
400             **kwargs: Additional parameters to pass through the event loop.[Deprecating]
401 
402         Returns:
403             Result: object containing:
404 
405                 - stop_reason: Why the event loop stopped (e.g., "end_turn", "max_tokens")
406                 - message: The final message from the model
407                 - metrics: Performance metrics from the event loop
408                 - state: The final state of the event loop
409         """
410         events = self.stream_async(
411             prompt, invocation_state=invocation_state, structured_output_model=structured_output_model, **kwargs
412         )
413         async for event in events:
414             _ = event
415 
416         return cast(AgentResult, event["result"])
417 
418     def structured_output(self, output_model: type[T], prompt: AgentInput = None) -> T:
419         """This method allows you to get structured output from the agent.
420 
421         If you pass in a prompt, it will be used temporarily without adding it to the conversation history.
422         If you don't pass in a prompt, it will use only the existing conversation history to respond.
423 
424         For smaller models, you may want to use the optional prompt to add additional instructions to explicitly
425         instruct the model to output the structured data.
426 
427         Args:
428             output_model: The output model (a JSON schema written as a Pydantic BaseModel)
429                 that the agent will use when responding.
430             prompt: The prompt to use for the agent in various formats:
431                 - str: Simple text input
432                 - list[ContentBlock]: Multi-modal content blocks
433                 - list[Message]: Complete messages with roles
434                 - None: Use existing conversation history
435 
436         Raises:
437             ValueError: If no conversation history or prompt is provided.
438         """
439         warnings.warn(
440             "Agent.structured_output method is deprecated."
441             " You should pass in `structured_output_model` directly into the agent invocation."
442             " see: https://strandsagents.com/latest/documentation/docs/user-guide/concepts/agents/structured-output/",
443             category=DeprecationWarning,
444             stacklevel=2,
445         )
446 
447         return run_async(lambda: self.structured_output_async(output_model, prompt))
448 
449     async def structured_output_async(self, output_model: type[T], prompt: AgentInput = None) -> T:
450         """This method allows you to get structured output from the agent.
451 
452         If you pass in a prompt, it will be used temporarily without adding it to the conversation history.
453         If you don't pass in a prompt, it will use only the existing conversation history to respond.
454 
455         For smaller models, you may want to use the optional prompt to add additional instructions to explicitly
456         instruct the model to output the structured data.
457 
458         Args:
459             output_model: The output model (a JSON schema written as a Pydantic BaseModel)
460                 that the agent will use when responding.
461             prompt: The prompt to use for the agent (will not be added to conversation history).
462 
463         Raises:
464             ValueError: If no conversation history or prompt is provided.
465         -
466         """
467         if self._interrupt_state.activated:
468             raise RuntimeError("cannot call structured output during interrupt")
469 
470         warnings.warn(
471             "Agent.structured_output_async method is deprecated."
472             " You should pass in `structured_output_model` directly into the agent invocation."
473             " see: https://strandsagents.com/latest/documentation/docs/user-guide/concepts/agents/structured-output/",
474             category=DeprecationWarning,
475             stacklevel=2,
476         )
477         await self.hooks.invoke_callbacks_async(BeforeInvocationEvent(agent=self))
478         with self.tracer.tracer.start_as_current_span(
479             "execute_structured_output", kind=trace_api.SpanKind.CLIENT
480         ) as structured_output_span:
481             try:
482                 if not self.messages and not prompt:
483                     raise ValueError("No conversation history or prompt provided")
484 
485                 temp_messages: Messages = self.messages + await self._convert_prompt_to_messages(prompt)
486 
487                 structured_output_span.set_attributes(
488                     {
489                         "gen_ai.system": "strands-agents",
490                         "gen_ai.agent.name": self.name,
491                         "gen_ai.agent.id": self.agent_id,
492                         "gen_ai.operation.name": "execute_structured_output",
493                     }
494                 )
495                 if self.system_prompt:
496                     structured_output_span.add_event(
497                         "gen_ai.system.message",
498                         attributes={"role": "system", "content": serialize([{"text": self.system_prompt}])},
499                     )
500                 for message in temp_messages:
501                     structured_output_span.add_event(
502                         f"gen_ai.{message['role']}.message",
503                         attributes={"role": message["role"], "content": serialize(message["content"])},
504                     )
505                 events = self.model.structured_output(output_model, temp_messages, system_prompt=self.system_prompt)
506                 async for event in events:
507                     if isinstance(event, TypedEvent):
508                         event.prepare(invocation_state={})
509                         if event.is_callback_event:
510                             self.callback_handler(**event.as_dict())
511 
512                 structured_output_span.add_event(
513                     "gen_ai.choice", attributes={"message": serialize(event["output"].model_dump())}
514                 )
515                 return event["output"]
516 
517             finally:
518                 await self.hooks.invoke_callbacks_async(AfterInvocationEvent(agent=self))
519 
520     def cleanup(self) -> None:
521         """Clean up resources used by the agent.
522 
523         This method cleans up all tool providers that require explicit cleanup,
524         such as MCP clients. It should be called when the agent is no longer needed
525         to ensure proper resource cleanup.
526 
527         Note: This method uses a "belt and braces" approach with automatic cleanup
528         through finalizers as a fallback, but explicit cleanup is recommended.
529         """
530         self.tool_registry.cleanup()
531 
532     def __del__(self) -> None:
533         """Clean up resources when agent is garbage collected."""
534         # __del__ is called even when an exception is thrown in the constructor,
535         # so there is no guarantee tool_registry was set..
536         if hasattr(self, "tool_registry"):
537             self.tool_registry.cleanup()
538 
539     async def stream_async(
540         self,
541         prompt: AgentInput = None,
542         *,
543         invocation_state: dict[str, Any] | None = None,
544         structured_output_model: type[BaseModel] | None = None,
545         **kwargs: Any,
546     ) -> AsyncIterator[Any]:
547         """Process a natural language prompt and yield events as an async iterator.
548 
549         This method provides an asynchronous interface for streaming agent events with multiple input patterns:
550         - String input: Simple text input
551         - ContentBlock list: Multi-modal content blocks
552         - Message list: Complete messages with roles
553         - No input: Use existing conversation history
554 
555         Args:
556             prompt: User input in various formats:
557                 - str: Simple text input
558                 - list[ContentBlock]: Multi-modal content blocks
559                 - list[Message]: Complete messages with roles
560                 - None: Use existing conversation history
561             invocation_state: Additional parameters to pass through the event loop.
562             structured_output_model: Pydantic model type(s) for structured output (overrides agent default).
563             **kwargs: Additional parameters to pass to the event loop.[Deprecating]
564 
565         Yields:
566             An async iterator that yields events. Each event is a dictionary containing
567                 information about the current state of processing, such as:
568 
569                 - data: Text content being generated
570                 - complete: Whether this is the final chunk
571                 - current_tool_use: Information about tools being executed
572                 - And other event data provided by the callback handler
573 
574         Raises:
575             ConcurrencyException: If another invocation is already in progress on this agent instance.
576             Exception: Any exceptions from the agent invocation will be propagated to the caller.
577 
578         Example:
579             ```python
580             async for event in agent.stream_async("Analyze this data"):
581                 if "data" in event:
582                     yield event["data"]
583             ```
584         """
585         # Acquire lock to prevent concurrent invocations
586         # Using threading.Lock instead of asyncio.Lock because run_async() creates
587         # separate event loops in different threads
588         acquired = self._invocation_lock.acquire(blocking=False)
589         if not acquired:
590             raise ConcurrencyException(
591                 "Agent is already processing a request. Concurrent invocations are not supported."
592             )
593 
594         try:
595             self._interrupt_state.resume(prompt)
596 
597             self.event_loop_metrics.reset_usage_metrics()
598 
599             merged_state = {}
600             if kwargs:
601                 warnings.warn("`**kwargs` parameter is deprecating, use `invocation_state` instead.", stacklevel=2)
602                 merged_state.update(kwargs)
603                 if invocation_state is not None:
604                     merged_state["invocation_state"] = invocation_state
605             else:
606                 if invocation_state is not None:
607                     merged_state = invocation_state
608 
609             callback_handler = self.callback_handler
610             if kwargs:
611                 callback_handler = kwargs.get("callback_handler", self.callback_handler)
612 
613             # Process input and get message to add (if any)
614             messages = await self._convert_prompt_to_messages(prompt)
615 
616             self.trace_span = self._start_agent_trace_span(messages)
617 
618             with trace_api.use_span(self.trace_span):
619                 try:
620                     events = self._run_loop(messages, merged_state, structured_output_model)
621 
622                     async for event in events:
623                         event.prepare(invocation_state=merged_state)
624 
625                         if event.is_callback_event:
626                             as_dict = event.as_dict()
627                             callback_handler(**as_dict)
628                             yield as_dict
629 
630                     result = AgentResult(*event["stop"])
631                     callback_handler(result=result)
632                     yield AgentResultEvent(result=result).as_dict()
633 
634                     self._end_agent_trace_span(response=result)
635 
636                 except Exception as e:
637                     self._end_agent_trace_span(error=e)
638                     raise
639 
640         finally:
641             self._invocation_lock.release()
642 
643     async def _run_loop(
644         self,
645         messages: Messages,
646         invocation_state: dict[str, Any],
647         structured_output_model: type[BaseModel] | None = None,
648     ) -> AsyncGenerator[TypedEvent, None]:
649         """Execute the agent's event loop with the given message and parameters.
650 
651         Args:
652             messages: The input messages to add to the conversation.
653             invocation_state: Additional parameters to pass to the event loop.
654             structured_output_model: Optional Pydantic model type for structured output.
655 
656         Yields:
657             Events from the event loop cycle.
658         """
659         before_invocation_event, _interrupts = await self.hooks.invoke_callbacks_async(
660             BeforeInvocationEvent(agent=self, messages=messages)
661         )
662         messages = before_invocation_event.messages if before_invocation_event.messages is not None else messages
663 
664         agent_result: AgentResult | None = None
665         try:
666             yield InitEventLoopEvent()
667 
668             await self._append_messages(*messages)
669 
670             structured_output_context = StructuredOutputContext(
671                 structured_output_model or self._default_structured_output_model
672             )
673 
674             # Execute the event loop cycle with retry logic for context limits
675             events = self._execute_event_loop_cycle(invocation_state, structured_output_context)
676             async for event in events:
677                 # Signal from the model provider that the message sent by the user should be redacted,
678                 # likely due to a guardrail.
679                 if (
680                     isinstance(event, ModelStreamChunkEvent)
681                     and event.chunk
682                     and event.chunk.get("redactContent")
683                     and event.chunk["redactContent"].get("redactUserContentMessage")
684                 ):
685                     self.messages[-1]["content"] = self._redact_user_content(
686                         self.messages[-1]["content"], str(event.chunk["redactContent"]["redactUserContentMessage"])
687                     )
688                     if self._session_manager:
689                         self._session_manager.redact_latest_message(self.messages[-1], self)
690                 yield event
691 
692             # Capture the result from the final event if available
693             if isinstance(event, EventLoopStopEvent):
694                 agent_result = AgentResult(*event["stop"])
695 
696         finally:
697             self.conversation_manager.apply_management(self)
698             await self.hooks.invoke_callbacks_async(AfterInvocationEvent(agent=self, result=agent_result))
699 
700     async def _execute_event_loop_cycle(
701         self, invocation_state: dict[str, Any], structured_output_context: StructuredOutputContext | None = None
702     ) -> AsyncGenerator[TypedEvent, None]:
703         """Execute the event loop cycle with retry logic for context window limits.
704 
705         This internal method handles the execution of the event loop cycle and implements
706         retry logic for handling context window overflow exceptions by reducing the
707         conversation context and retrying.
708 
709         Args:
710             invocation_state: Additional parameters to pass to the event loop.
711             structured_output_context: Optional structured output context for this invocation.
712 
713         Yields:
714             Events of the loop cycle.
715         """
716         # Add `Agent` to invocation_state to keep backwards-compatibility
717         invocation_state["agent"] = self
718 
719         if structured_output_context:
720             structured_output_context.register_tool(self.tool_registry)
721 
722         try:
723             events = event_loop_cycle(
724                 agent=self,
725                 invocation_state=invocation_state,
726                 structured_output_context=structured_output_context,
727             )
728             async for event in events:
729                 yield event
730 
731         except ContextWindowOverflowException as e:
732             # Try reducing the context size and retrying
733             self.conversation_manager.reduce_context(self, e=e)
734 
735             # Sync agent after reduce_context to keep conversation_manager_state up to date in the session
736             if self._session_manager:
737                 self._session_manager.sync_agent(self)
738 
739             events = self._execute_event_loop_cycle(invocation_state, structured_output_context)
740             async for event in events:
741                 yield event
742 
743         finally:
744             if structured_output_context:
745                 structured_output_context.cleanup(self.tool_registry)
746 
747     async def _convert_prompt_to_messages(self, prompt: AgentInput) -> Messages:
748         if self._interrupt_state.activated:
749             return []
750 
751         messages: Messages | None = None
752         if prompt is not None:
753             # Check if the latest message is toolUse
754             if len(self.messages) > 0 and any("toolUse" in content for content in self.messages[-1]["content"]):
755                 # Add toolResult message after to have a valid conversation
756                 logger.info(
757                     "Agents latest message is toolUse, appending a toolResult message to have valid conversation."
758                 )
759                 tool_use_ids = [
760                     content["toolUse"]["toolUseId"] for content in self.messages[-1]["content"] if "toolUse" in content
761                 ]
762                 await self._append_messages(
763                     {
764                         "role": "user",
765                         "content": generate_missing_tool_result_content(tool_use_ids),
766                     }
767                 )
768             if isinstance(prompt, str):
769                 # String input - convert to user message
770                 messages = [{"role": "user", "content": [{"text": prompt}]}]
771             elif isinstance(prompt, list):
772                 if len(prompt) == 0:
773                     # Empty list
774                     messages = []
775                 # Check if all item in input list are dictionaries
776                 elif all(isinstance(item, dict) for item in prompt):
777                     # Check if all items are messages
778                     if all(all(key in item for key in Message.__annotations__.keys()) for item in prompt):
779                         # Messages input - add all messages to conversation
780                         messages = cast(Messages, prompt)
781 
782                     # Check if all items are content blocks
783                     elif all(any(key in ContentBlock.__annotations__.keys() for key in item) for item in prompt):
784                         # Treat as List[ContentBlock] input - convert to user message
785                         # This allows invalid structures to be passed through to the model
786                         messages = [{"role": "user", "content": cast(list[ContentBlock], prompt)}]
787         else:
788             messages = []
789         if messages is None:
790             raise ValueError("Input prompt must be of type: `str | list[Contentblock] | Messages | None`.")
791         return messages
792 
793     def _start_agent_trace_span(self, messages: Messages) -> trace_api.Span:
794         """Starts a trace span for the agent.
795 
796         Args:
797             messages: The input messages.
798         """
799         model_id = self.model.config.get("model_id") if hasattr(self.model, "config") else None
800         return self.tracer.start_agent_span(
801             messages=messages,
802             agent_name=self.name,
803             model_id=model_id,
804             tools=self.tool_names,
805             system_prompt=self.system_prompt,
806             custom_trace_attributes=self.trace_attributes,
807             tools_config=self.tool_registry.get_all_tools_config(),
808         )
809 
810     def _end_agent_trace_span(
811         self,
812         response: AgentResult | None = None,
813         error: Exception | None = None,
814     ) -> None:
815         """Ends a trace span for the agent.
816 
817         Args:
818             span: The span to end.
819             response: Response to record as a trace attribute.
820             error: Error to record as a trace attribute.
821         """
822         if self.trace_span:
823             trace_attributes: dict[str, Any] = {
824                 "span": self.trace_span,
825             }
826 
827             if response:
828                 trace_attributes["response"] = response
829             if error:
830                 trace_attributes["error"] = error
831 
832             self.tracer.end_agent_span(**trace_attributes)
833 
834     def _initialize_system_prompt(
835         self, system_prompt: str | list[SystemContentBlock] | None
836     ) -> tuple[str | None, list[SystemContentBlock] | None]:
837         """Initialize system prompt fields from constructor input.
838 
839         Maintains backwards compatibility by keeping system_prompt as str when string input
840         provided, avoiding breaking existing consumers.
841 
842         Maps system_prompt input to both string and content block representations:
843         - If string: system_prompt=string, _system_prompt_content=[{text: string}]
844         - If list with text elements: system_prompt=concatenated_text, _system_prompt_content=list
845         - If list without text elements: system_prompt=None, _system_prompt_content=list
846         - If None: system_prompt=None, _system_prompt_content=None
847         """
848         if isinstance(system_prompt, str):
849             return system_prompt, [{"text": system_prompt}]
850         elif isinstance(system_prompt, list):
851             # Concatenate all text elements for backwards compatibility, None if no text found
852             text_parts = [block["text"] for block in system_prompt if "text" in block]
853             system_prompt_str = "\n".join(text_parts) if text_parts else None
854             return system_prompt_str, system_prompt
855         else:
856             return None, None
857 
858     async def _append_messages(self, *messages: Message) -> None:
859         """Appends messages to history and invoke the callbacks for the MessageAddedEvent."""
860         for message in messages:
861             self.messages.append(message)
862             await self.hooks.invoke_callbacks_async(MessageAddedEvent(agent=self, message=message))
863 
864     def _redact_user_content(self, content: list[ContentBlock], redact_message: str) -> list[ContentBlock]:
865         """Redact user content preserving toolResult blocks.
866 
867         Args:
868             content: content blocks to be redacted
869             redact_message: redact message to be replaced
870 
871         Returns:
872             Redacted content, as follows:
873             - if the message contains at least a toolResult block,
874                 all toolResult blocks(s) are kept, redacting only the result content;
875             - otherwise, the entire content of the message is replaced
876                 with a single text block with the redact message.
877         """
878         redacted_content = []
879         for block in content:
880             if "toolResult" in block:
881                 block["toolResult"]["content"] = [{"text": redact_message}]
882                 redacted_content.append(block)
883 
884         if not redacted_content:
885             # Text content is added only if no toolResult blocks were found
886             redacted_content = [{"text": redact_message}]
887 
888         return redacted_content

