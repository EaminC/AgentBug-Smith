120     def __init__(
121         self,
122         *,
123         boto_session: boto3.Session | None = None,
124         boto_client_config: BotocoreConfig | None = None,
125         region_name: str | None = None,
126         endpoint_url: str | None = None,
127         **model_config: Unpack[BedrockConfig],
128     ):
129         """Initialize provider instance.
130 
131         Args:
132             boto_session: Boto Session to use when calling the Bedrock Model.
133             boto_client_config: Configuration to use when creating the Bedrock-Runtime Boto Client.
134             region_name: AWS region to use for the Bedrock service.
135                 Defaults to the AWS_REGION environment variable if set, or "us-west-2" if not set.
136             endpoint_url: Custom endpoint URL for VPC endpoints (PrivateLink)
137             **model_config: Configuration options for the Bedrock model.
138         """
139         if region_name and boto_session:
140             raise ValueError("Cannot specify both `region_name` and `boto_session`.")
141 
142         session = boto_session or boto3.Session()
143         resolved_region = region_name or session.region_name or os.environ.get("AWS_REGION") or DEFAULT_BEDROCK_REGION
144         self.config = BedrockModel.BedrockConfig(
145             model_id=BedrockModel._get_default_model_with_warning(resolved_region, model_config),
146             include_tool_result_status="auto",
147         )
148         self.update_config(**model_config)
149 
150         logger.debug("config=<%s> | initializing", self.config)
151 
152         # Add strands-agents to the request user agent
153         if boto_client_config:
154             existing_user_agent = getattr(boto_client_config, "user_agent_extra", None)
155 
156             # Append 'strands-agents' to existing user_agent_extra or set it if not present
157             if existing_user_agent:
158                 new_user_agent = f"{existing_user_agent} strands-agents"
159             else:
160                 new_user_agent = "strands-agents"
161 
162             client_config = boto_client_config.merge(BotocoreConfig(user_agent_extra=new_user_agent))
163         else:
164             client_config = BotocoreConfig(user_agent_extra="strands-agents", read_timeout=DEFAULT_READ_TIMEOUT)
165 
166         self.client = session.client(
167             service_name="bedrock-runtime",
168             config=client_config,
169             endpoint_url=endpoint_url,
170             region_name=resolved_region,
171         )
172 
173         logger.debug("region=<%s> | bedrock client created", self.client.meta.region_name)
