173     @override
174     @classmethod
175     def format_request_messages(
176         cls,
177         messages: Messages,
178         system_prompt: str | None = None,
179         *,
180         system_prompt_content: list[SystemContentBlock] | None = None,
181         **kwargs: Any,
182     ) -> list[dict[str, Any]]:
183         """Format a LiteLLM compatible messages array with cache point support.
184 
185         Args:
186             messages: List of message objects to be processed by the model.
187             system_prompt: System prompt to provide context to the model (for legacy compatibility).
188             system_prompt_content: System prompt content blocks to provide context to the model.
189             **kwargs: Additional keyword arguments for future extensibility.
190 
191         Returns:
192             A LiteLLM compatible messages array.
193         """
194         formatted_messages = cls._format_system_messages(system_prompt, system_prompt_content=system_prompt_content)
195         formatted_messages.extend(cls._format_regular_messages(messages))
196 
197         return [message for message in formatted_messages if message["content"] or "tool_calls" in message]
