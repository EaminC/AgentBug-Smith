431                 - str: Simple text input
432                 - list[ContentBlock]: Multi-modal content blocks
433                 - list[Message]: Complete messages with roles
434                 - None: Use existing conversation history
435 
436         Raises:
437             ValueError: If no conversation history or prompt is provided.
438         """
439         warnings.warn(
440             "Agent.structured_output method is deprecated."
441             " You should pass in `structured_output_model` directly into the agent invocation."
442             " see: https://strandsagents.com/latest/documentation/docs/user-guide/concepts/agents/structured-output/",
443             category=DeprecationWarning,
444             stacklevel=2,
445         )
446 
447         return run_async(lambda: self.structured_output_async(output_model, prompt))
