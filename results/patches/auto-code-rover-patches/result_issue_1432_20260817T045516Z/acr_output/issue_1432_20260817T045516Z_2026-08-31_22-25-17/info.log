84     @override
85     @classmethod
86     def format_request_message_content(cls, content: ContentBlock, **kwargs: Any) -> dict[str, Any]:
87         """Format a LiteLLM content block.
88 
89         Args:
90             content: Message content.
91             **kwargs: Additional keyword arguments for future extensibility.
92 
93         Returns:
94             LiteLLM formatted content block.
95 
96         Raises:
97             TypeError: If the content block type cannot be converted to a LiteLLM-compatible format.
98         """
99         if "reasoningContent" in content:
100             return {
101                 "signature": content["reasoningContent"]["reasoningText"]["signature"],
102                 "thinking": content["reasoningContent"]["reasoningText"]["text"],
103                 "type": "thinking",
104             }
105 
106         if "video" in content:
107             return {
108                 "type": "video_url",
109                 "video_url": {
110                     "detail": "auto",
111                     "url": content["video"]["source"]["bytes"],
112                 },
113             }
114 
115         return super().format_request_message_content(content)
116 
117     def _stream_switch_content(self, data_type: str, prev_data_type: str | None) -> tuple[list[StreamEvent], str]:
118         """Handle switching to a new content stream.
119 
120         Args:
121             data_type: The next content data type.
122             prev_data_type: The previous content data type.
123 
124         Returns:
125             Tuple containing:
126             - Stop block for previous content and the start block for the next content.
127             - Next content data type.
128         """
129         chunks = []
130         if data_type != prev_data_type:
131             if prev_data_type is not None:
132                 chunks.append(self.format_chunk({"chunk_type": "content_stop", "data_type": prev_data_type}))
133             chunks.append(self.format_chunk({"chunk_type": "content_start", "data_type": data_type}))
134 
135         return chunks, data_type
136 
137     @override
138     @classmethod
139     def _format_system_messages(
140         cls,
141         system_prompt: str | None = None,
142         *,
143         system_prompt_content: list[SystemContentBlock] | None = None,
144         **kwargs: Any,
145     ) -> list[dict[str, Any]]:
146         """Format system messages for LiteLLM with cache point support.
147 
148         Args:
149             system_prompt: System prompt to provide context to the model.
150             system_prompt_content: System prompt content blocks to provide context to the model.
151             **kwargs: Additional keyword arguments for future extensibility.
152 
153         Returns:
154             List of formatted system messages.
155         """
156         # Handle backward compatibility: if system_prompt is provided but system_prompt_content is None
157         if system_prompt and system_prompt_content is None:
158             system_prompt_content = [{"text": system_prompt}]
159 
160         system_content: list[dict[str, Any]] = []
161         for block in system_prompt_content or []:
162             if "text" in block:
163                 system_content.append({"type": "text", "text": block["text"]})
164             elif "cachePoint" in block and block["cachePoint"].get("type") == "default":
165                 # Apply cache control to the immediately preceding content block
166                 # for LiteLLM/Anthropic compatibility
167                 if system_content:
168                     system_content[-1]["cache_control"] = {"type": "ephemeral"}
169 
170         # Create single system message with content array rather than mulitple system messages
171         return [{"role": "system", "content": system_content}] if system_content else []
172 
173     @override
174     @classmethod
175     def format_request_messages(
176         cls,
177         messages: Messages,
178         system_prompt: str | None = None,
179         *,
180         system_prompt_content: list[SystemContentBlock] | None = None,
181         **kwargs: Any,
182     ) -> list[dict[str, Any]]:
183         """Format a LiteLLM compatible messages array with cache point support.
184 
185         Args:
186             messages: List of message objects to be processed by the model.
187             system_prompt: System prompt to provide context to the model (for legacy compatibility).
188             system_prompt_content: System prompt content blocks to provide context to the model.
189             **kwargs: Additional keyword arguments for future extensibility.
190 
191         Returns:
192             A LiteLLM compatible messages array.
193         """
194         formatted_messages = cls._format_system_messages(system_prompt, system_prompt_content=system_prompt_content)
195         formatted_messages.extend(cls._format_regular_messages(messages))
196 
197         return [message for message in formatted_messages if message["content"] or "tool_calls" in message]
198 
199     @override
200     def format_chunk(self, event: dict[str, Any], **kwargs: Any) -> StreamEvent:
201         """Format a LiteLLM response event into a standardized message chunk.
202 
203         This method overrides OpenAI's format_chunk to handle the metadata case
204         with prompt caching support. All other chunk types use the parent implementation.
205 
206         Args:
207             event: A response event from the LiteLLM model.
208             **kwargs: Additional keyword arguments for future extensibility.
209 
210         Returns:
211             The formatted chunk.
212 
213         Raises:
214             RuntimeError: If chunk_type is not recognized.
215         """
216         # Handle metadata case with prompt caching support
217         if event["chunk_type"] == "metadata":
218             usage_data: Usage = {
219                 "inputTokens": event["data"].prompt_tokens,
220                 "outputTokens": event["data"].completion_tokens,
221                 "totalTokens": event["data"].total_tokens,
222             }
223 
224             # Only LiteLLM over Anthropic supports cache write tokens
225             # Waiting until a more general approach is available to set cacheWriteInputTokens
226             if tokens_details := getattr(event["data"], "prompt_tokens_details", None):
227                 if cached := getattr(tokens_details, "cached_tokens", None):
228                     usage_data["cacheReadInputTokens"] = cached
229             if creation := getattr(event["data"], "cache_creation_input_tokens", None):
230                 usage_data["cacheWriteInputTokens"] = creation
231 
232             return StreamEvent(
233                 metadata=MetadataEvent(
234                     metrics={
235                         "latencyMs": 0,  # TODO
236                     },
237                     usage=usage_data,
238                 )
239             )
240         # For all other cases, use the parent implementation
241         return super().format_chunk(event)
242 
243     @override
244     async def stream(
245         self,
246         messages: Messages,
247         tool_specs: list[ToolSpec] | None = None,
248         system_prompt: str | None = None,
249         *,
250         tool_choice: ToolChoice | None = None,
251         system_prompt_content: list[SystemContentBlock] | None = None,
252         **kwargs: Any,
253     ) -> AsyncGenerator[StreamEvent, None]:
254         """Stream conversation with the LiteLLM model.
255 
256         Args:
257             messages: List of message objects to be processed by the model.
258             tool_specs: List of tool specifications to make available to the model.
259             system_prompt: System prompt to provide context to the model.
260             tool_choice: Selection strategy for tool invocation.
261             system_prompt_content: System prompt content blocks to provide context to the model.
262             **kwargs: Additional keyword arguments for future extensibility.
263 
264         Yields:
265             Formatted message chunks from the model.
266         """
267         logger.debug("formatting request")
268         request = self.format_request(
269             messages, tool_specs, system_prompt, tool_choice, system_prompt_content=system_prompt_content
270         )
271         logger.debug("request=<%s>", request)
272 
273         # Check if streaming is disabled in the params
274         config = self.get_config()
275         params = config.get("params") or {}
276         is_streaming = params.get("stream", True)
277 
278         litellm_request = {**request}
279 
280         litellm_request["stream"] = is_streaming
281 
282         logger.debug("invoking model with stream=%s", litellm_request.get("stream"))
283 
284         try:
285             if is_streaming:
286                 async for chunk in self._handle_streaming_response(litellm_request):
287                     yield chunk
288             else:
289                 async for chunk in self._handle_non_streaming_response(litellm_request):
290                     yield chunk
291         except ContextWindowExceededError as e:
292             logger.warning("litellm client raised context window overflow")
293             raise ContextWindowOverflowException(e) from e
294 
295         logger.debug("finished processing response from model")
296 
297     @override
298     async def structured_output(
299         self, output_model: type[T], prompt: Messages, system_prompt: str | None = None, **kwargs: Any
300     ) -> AsyncGenerator[dict[str, T | Any], None]:
301         """Get structured output from the model.
302 
303         Some models do not support native structured output via response_format.
304         In cases of proxies, we may not have a way to determine support, so we
305         fallback to using tool calling to achieve structured output.
306 
307         Args:
308             output_model: The output model to use for the agent.
309             prompt: The prompt messages to use for the agent.
310             system_prompt: System prompt to provide context to the model.
311             **kwargs: Additional keyword arguments for future extensibility.
312 
313         Yields:
314             Model events with the last being the structured output.
315         """
316         if supports_response_schema(self.get_config()["model_id"]):
317             logger.debug("structuring output using response schema")
318             result = await self._structured_output_using_response_schema(output_model, prompt, system_prompt)
319         else:
320             logger.debug("model does not support response schema, structuring output using tool approach")
321             result = await self._structured_output_using_tool(output_model, prompt, system_prompt)
322 
323         yield {"output": result}
324 
325     async def _structured_output_using_response_schema(
326         self, output_model: type[T], prompt: Messages, system_prompt: str | None = None
327     ) -> T:
328         """Get structured output using native response_format support."""
329         response = await litellm.acompletion(
330             **self.client_args,
331             model=self.get_config()["model_id"],
332             messages=self.format_request(prompt, system_prompt=system_prompt)["messages"],
333             response_format=output_model,
334         )
335 
336         if len(response.choices) > 1:
337             raise ValueError("Multiple choices found in the response.")
338         if not response.choices:
339             raise ValueError("No choices found in response")
340 
341         choice = response.choices[0]
342         try:
343             # Parse the message content as JSON
344             tool_call_data = json.loads(choice.message.content)
345             # Instantiate the output model with the parsed data
346             return output_model(**tool_call_data)
347         except ContextWindowExceededError as e:
348             logger.warning("litellm client raised context window overflow in structured_output")
349             raise ContextWindowOverflowException(e) from e
350         except (json.JSONDecodeError, TypeError, ValueError) as e:
351             raise ValueError(f"Failed to parse or load content into model: {e}") from e
352 
353     async def _structured_output_using_tool(
354         self, output_model: type[T], prompt: Messages, system_prompt: str | None = None
355     ) -> T:
356         """Get structured output using tool calling fallback."""
357         tool_spec = convert_pydantic_to_tool_spec(output_model)
358         request = self.format_request(prompt, [tool_spec], system_prompt, cast(ToolChoice, {"any": {}}))
359         args = {**self.client_args, **request, "stream": False}
360         response = await litellm.acompletion(**args)
361 
362         if len(response.choices) > 1:
363             raise ValueError("Multiple choices found in the response.")
364         if not response.choices or response.choices[0].finish_reason != "tool_calls":
365             raise ValueError("No tool_calls found in response")
366 
367         choice = response.choices[0]
368         try:
369             # Parse the tool call content as JSON
370             tool_call = choice.message.tool_calls[0]
371             tool_call_data = json.loads(tool_call.function.arguments)
372             # Instantiate the output model with the parsed data
373             return output_model(**tool_call_data)
374         except ContextWindowExceededError as e:
375             logger.warning("litellm client raised context window overflow in structured_output")
376             raise ContextWindowOverflowException(e) from e
377         except (json.JSONDecodeError, TypeError, ValueError) as e:
378             raise ValueError(f"Failed to parse or load content into model: {e}") from e
379 
380     async def _process_choice_content(
381         self, choice: Any, data_type: str | None, tool_calls: dict[int, list[Any]], is_streaming: bool = True
382     ) -> AsyncGenerator[tuple[str | None, StreamEvent], None]:
383         """Process content from a choice object (streaming or non-streaming).
384 
385         Args:
386             choice: The choice object from the response.
387             data_type: Current data type being processed.
388             tool_calls: Dictionary to collect tool calls.
389             is_streaming: Whether this is from a streaming response.
390 
391         Yields:
392             Tuples of (updated_data_type, stream_event).
393         """
394         # Get the content source - this is the only difference between streaming/non-streaming
395         # We use duck typing here: both choice.delta and choice.message have the same interface
396         # (reasoning_content, content, tool_calls attributes) but different object structures
397         content_source = choice.delta if is_streaming else choice.message
398 
399         # Process reasoning content
400         if hasattr(content_source, "reasoning_content") and content_source.reasoning_content:
401             chunks, data_type = self._stream_switch_content("reasoning_content", data_type)
402             for chunk in chunks:
403                 yield data_type, chunk
404             chunk = self.format_chunk(
405                 {
406                     "chunk_type": "content_delta",
407                     "data_type": "reasoning_content",
408                     "data": content_source.reasoning_content,
409                 }
410             )
411             yield data_type, chunk
412 
413         # Process text content
414         if hasattr(content_source, "content") and content_source.content:
415             chunks, data_type = self._stream_switch_content("text", data_type)
416             for chunk in chunks:
417                 yield data_type, chunk
418             chunk = self.format_chunk(
419                 {
420                     "chunk_type": "content_delta",
421                     "data_type": "text",
422                     "data": content_source.content,
423                 }
424             )
425             yield data_type, chunk
426 
427         # Process tool calls
428         if hasattr(content_source, "tool_calls") and content_source.tool_calls:
429             if is_streaming:
430                 # Streaming: tool calls have index attribute for out-of-order delivery
431                 for tool_call in content_source.tool_calls:
432                     tool_calls.setdefault(tool_call.index, []).append(tool_call)
433             else:
434                 # Non-streaming: tool calls arrive in order, use enumerated index
435                 for i, tool_call in enumerate(content_source.tool_calls):
436                     tool_calls.setdefault(i, []).append(tool_call)
437 
438     async def _process_tool_calls(self, tool_calls: dict[int, list[Any]]) -> AsyncGenerator[StreamEvent, None]:
439         """Process and yield tool call events.
440 
441         Args:
442             tool_calls: Dictionary of tool calls indexed by their position.
443 
444         Yields:
445             Formatted tool call chunks.
446         """
447         for tool_deltas in tool_calls.values():
448             yield self.format_chunk({"chunk_type": "content_start", "data_type": "tool", "data": tool_deltas[0]})
449 
450             for tool_delta in tool_deltas:
451                 yield self.format_chunk({"chunk_type": "content_delta", "data_type": "tool", "data": tool_delta})
452 
453             yield self.format_chunk({"chunk_type": "content_stop", "data_type": "tool"})
454 
455     async def _handle_non_streaming_response(
456         self, litellm_request: dict[str, Any]
457     ) -> AsyncGenerator[StreamEvent, None]:
458         """Handle non-streaming response from LiteLLM.
459 
460         Args:
461             litellm_request: The formatted request for LiteLLM.
462 
463         Yields:
464             Formatted message chunks from the model.
465         """
466         response = await litellm.acompletion(**self.client_args, **litellm_request)
467 
468         logger.debug("got non-streaming response from model")
469         yield self.format_chunk({"chunk_type": "message_start"})
470 
471         tool_calls: dict[int, list[Any]] = {}
472         data_type: str | None = None
473         finish_reason: str | None = None
474 
475         if hasattr(response, "choices") and response.choices and len(response.choices) > 0:
476             choice = response.choices[0]
477 
478             if hasattr(choice, "message") and choice.message:
479                 # Process content using shared logic
480                 async for updated_data_type, chunk in self._process_choice_content(
481                     choice, data_type, tool_calls, is_streaming=False
482                 ):
483                     data_type = updated_data_type
484                     yield chunk
485 
486             if hasattr(choice, "finish_reason"):
487                 finish_reason = choice.finish_reason
488 
489         # Stop the current content block if we have one
490         if data_type:
491             yield self.format_chunk({"chunk_type": "content_stop", "data_type": data_type})
492 
493         # Process tool calls
494         async for chunk in self._process_tool_calls(tool_calls):
495             yield chunk
496 
497         yield self.format_chunk({"chunk_type": "message_stop", "data": finish_reason})
498 
499         # Add usage information if available
500         if hasattr(response, "usage"):
501             yield self.format_chunk({"chunk_type": "metadata", "data": response.usage})
502 
503     async def _handle_streaming_response(self, litellm_request: dict[str, Any]) -> AsyncGenerator[StreamEvent, None]:
504         """Handle streaming response from LiteLLM.
505 
506         Args:
507             litellm_request: The formatted request for LiteLLM.
508 
509         Yields:
510             Formatted message chunks from the model.
511         """
512         # For streaming, use the streaming API
513         response = await litellm.acompletion(**self.client_args, **litellm_request)
514 
515         logger.debug("got response from model")
516         yield self.format_chunk({"chunk_type": "message_start"})
517 
518         tool_calls: dict[int, list[Any]] = {}
519         data_type: str | None = None
520         finish_reason: str | None = None
521 
522         async for event in response:
523             # Defensive: skip events with empty or missing choices
524             if not getattr(event, "choices", None):
525                 continue
526             choice = event.choices[0]
527 
528             # Process content using shared logic
529             async for updated_data_type, chunk in self._process_choice_content(
530                 choice, data_type, tool_calls, is_streaming=True
531             ):
532                 data_type = updated_data_type
533                 yield chunk
534 
535             if choice.finish_reason:
536                 finish_reason = choice.finish_reason
537                 if data_type:
538                     yield self.format_chunk({"chunk_type": "content_stop", "data_type": data_type})
539                 break
540 
541         # Process tool calls
542         async for chunk in self._process_tool_calls(tool_calls):
543             yield chunk
544 
545         yield self.format_chunk({"chunk_type": "message_stop", "data": finish_reason})
546 
547         # Skip remaining events as we don't have use for anything except the final usage payload
548         async for event in response:
549             _ = event
550             if usage := getattr(event, "usage", None):
551                 yield self.format_chunk({"chunk_type": "metadata", "data": usage})
552 
553         logger.debug("finished streaming response from model")
554 
555     def _apply_proxy_prefix(self) -> None:
556         """Apply litellm_proxy/ prefix to model_id when use_litellm_proxy is True.
557 
558         This is a workaround for https://github.com/BerriAI/litellm/issues/13454
559         where use_litellm_proxy parameter is not honored.
560         """
561         if self.client_args.get("use_litellm_proxy") and "model_id" in self.config:
562             model_id = self.get_config()["model_id"]
563             if not model_id.startswith("litellm_proxy/"):
564                 self.config["model_id"] = f"litellm_proxy/{model_id}"

