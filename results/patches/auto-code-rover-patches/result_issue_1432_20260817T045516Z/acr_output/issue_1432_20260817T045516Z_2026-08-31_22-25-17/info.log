117     def _stream_switch_content(self, data_type: str, prev_data_type: str | None) -> tuple[list[StreamEvent], str]:
118         """Handle switching to a new content stream.
119 
120         Args:
121             data_type: The next content data type.
122             prev_data_type: The previous content data type.
123 
124         Returns:
125             Tuple containing:
126             - Stop block for previous content and the start block for the next content.
127             - Next content data type.
128         """
129         chunks = []
130         if data_type != prev_data_type:
131             if prev_data_type is not None:
132                 chunks.append(self.format_chunk({"chunk_type": "content_stop", "data_type": prev_data_type}))
133             chunks.append(self.format_chunk({"chunk_type": "content_start", "data_type": data_type}))
134 
135         return chunks, data_type
