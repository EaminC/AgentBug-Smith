100     def _format_request_message_content(self, content: ContentBlock) -> dict[str, Any]:
101         """Format an Anthropic content block.
102 
103         Args:
104             content: Message content.
105 
106         Returns:
107             Anthropic formatted content block.
108 
109         Raises:
110             TypeError: If the content block type cannot be converted to an Anthropic-compatible format.
111         """
112         if "document" in content:
113             mime_type = mimetypes.types_map.get(f".{content['document']['format']}", "application/octet-stream")
114             return {
115                 "source": {
116                     "data": (
117                         content["document"]["source"]["bytes"].decode("utf-8")
118                         if mime_type == "text/plain"
119                         else base64.b64encode(content["document"]["source"]["bytes"]).decode("utf-8")
120                     ),
121                     "media_type": mime_type,
122                     "type": "text" if mime_type == "text/plain" else "base64",
123                 },
124                 "title": content["document"]["name"],
125                 "type": "document",
126             }
127 
128         if "image" in content:
129             return {
130                 "source": {
131                     "data": base64.b64encode(content["image"]["source"]["bytes"]).decode("utf-8"),
132                     "media_type": mimetypes.types_map.get(f".{content['image']['format']}", "application/octet-stream"),
133                     "type": "base64",
134                 },
135                 "type": "image",
136             }
137 
138         if "reasoningContent" in content:
139             return {
140                 "signature": content["reasoningContent"]["reasoningText"]["signature"],
141                 "thinking": content["reasoningContent"]["reasoningText"]["text"],
142                 "type": "thinking",
143             }
144 
145         if "text" in content:
146             return {"text": content["text"], "type": "text"}
147 
148         if "toolUse" in content:
149             return {
150                 "id": content["toolUse"]["toolUseId"],
151                 "input": content["toolUse"]["input"],
152                 "name": content["toolUse"]["name"],
153                 "type": "tool_use",
154             }
155 
156         if "toolResult" in content:
157             return {
158                 "content": [
159                     self._format_request_message_content(
160                         {"text": json.dumps(tool_result_content["json"])}
161                         if "json" in tool_result_content
162                         else cast(ContentBlock, tool_result_content)
163                     )
164                     for tool_result_content in content["toolResult"]["content"]
165                 ],
166                 "is_error": content["toolResult"]["status"] == "error",
167                 "tool_use_id": content["toolResult"]["toolUseId"],
168                 "type": "tool_result",
169             }
170 
171         raise TypeError(f"content_type=<{next(iter(content))}> | unsupported type")
172 
173     def _format_request_messages(self, messages: Messages) -> list[dict[str, Any]]:
174         """Format an Anthropic messages array.
175 
176         Args:
177             messages: List of message objects to be processed by the model.
178 
179         Returns:
180             An Anthropic messages array.
181         """
182         formatted_messages = []
183 
184         for message in messages:
185             formatted_contents: list[dict[str, Any]] = []
186 
187             for content in message["content"]:
188                 if "cachePoint" in content:
189                     formatted_contents[-1]["cache_control"] = {"type": "ephemeral"}
190                     continue
191 
192                 formatted_contents.append(self._format_request_message_content(content))
193 
194             if formatted_contents:
195                 formatted_messages.append({"content": formatted_contents, "role": message["role"]})
196 
197         return formatted_messages
198 
199     def format_request(
200         self,
201         messages: Messages,
202         tool_specs: list[ToolSpec] | None = None,
203         system_prompt: str | None = None,
204         tool_choice: ToolChoice | None = None,
205     ) -> dict[str, Any]:
206         """Format an Anthropic streaming request.
207 
208         Args:
209             messages: List of message objects to be processed by the model.
210             tool_specs: List of tool specifications to make available to the model.
211             system_prompt: System prompt to provide context to the model.
212             tool_choice: Selection strategy for tool invocation.
213 
214         Returns:
215             An Anthropic streaming request.
216 
217         Raises:
218             TypeError: If a message contains a content block type that cannot be converted to an Anthropic-compatible
219                 format.
220         """
221         return {
222             "max_tokens": self.config["max_tokens"],
223             "messages": self._format_request_messages(messages),
224             "model": self.config["model_id"],
225             "tools": [
226                 {
227                     "name": tool_spec["name"],
228                     "description": tool_spec["description"],
229                     "input_schema": tool_spec["inputSchema"]["json"],
230                 }
231                 for tool_spec in tool_specs or []
232             ],
233             **(self._format_tool_choice(tool_choice)),
234             **({"system": system_prompt} if system_prompt else {}),
235             **(self.config.get("params") or {}),
236         }
237 
238     @staticmethod
239     def _format_tool_choice(tool_choice: ToolChoice | None) -> dict:
240         if tool_choice is None:
241             return {}
242 
243         if "any" in tool_choice:
244             return {"tool_choice": {"type": "any"}}
245         elif "auto" in tool_choice:
246             return {"tool_choice": {"type": "auto"}}
247         elif "tool" in tool_choice:
248             return {"tool_choice": {"type": "tool", "name": cast(ToolChoiceToolDict, tool_choice)["tool"]["name"]}}
249         else:
250             return {}
251 
252     def format_chunk(self, event: dict[str, Any]) -> StreamEvent:
253         """Format the Anthropic response events into standardized message chunks.
254 
255         Args:
256             event: A response event from the Anthropic model.
257 
258         Returns:
259             The formatted chunk.
260 
261         Raises:
262             RuntimeError: If chunk_type is not recognized.
263                 This error should never be encountered as we control chunk_type in the stream method.
264         """
265         match event["type"]:
266             case "message_start":
267                 return {"messageStart": {"role": "assistant"}}
268 
269             case "content_block_start":
270                 content = event["content_block"]
271 
272                 if content["type"] == "tool_use":
273                     return {
274                         "contentBlockStart": {
275                             "contentBlockIndex": event["index"],
276                             "start": {
277                                 "toolUse": {
278                                     "name": content["name"],
279                                     "toolUseId": content["id"],
280                                 }
281                             },
282                         }
283                     }
284 
285                 return {"contentBlockStart": {"contentBlockIndex": event["index"], "start": {}}}
286 
287             case "content_block_delta":
288                 delta = event["delta"]
289 
290                 match delta["type"]:
291                     case "signature_delta":
292                         return {
293                             "contentBlockDelta": {
294                                 "contentBlockIndex": event["index"],
295                                 "delta": {
296                                     "reasoningContent": {
297                                         "signature": delta["signature"],
298                                     },
299                                 },
300                             },
301                         }
302 
303                     case "thinking_delta":
304                         return {
305                             "contentBlockDelta": {
306                                 "contentBlockIndex": event["index"],
307                                 "delta": {
308                                     "reasoningContent": {
309                                         "text": delta["thinking"],
310                                     },
311                                 },
312                             },
313                         }
314 
315                     case "input_json_delta":
316                         return {
317                             "contentBlockDelta": {
318                                 "contentBlockIndex": event["index"],
319                                 "delta": {
320                                     "toolUse": {
321                                         "input": delta["partial_json"],
322                                     },
323                                 },
324                             },
325                         }
326 
327                     case "text_delta":
328                         return {
329                             "contentBlockDelta": {
330                                 "contentBlockIndex": event["index"],
331                                 "delta": {
332                                     "text": delta["text"],
333                                 },
334                             },
335                         }
336 
337                     case _:
338                         raise RuntimeError(
339                             f"event_type=<content_block_delta>, delta_type=<{delta['type']}> | unknown type"
340                         )
341 
342             case "content_block_stop":
343                 return {"contentBlockStop": {"contentBlockIndex": event["index"]}}
344 
345             case "message_stop":
346                 message = event["message"]
347 
348                 return {"messageStop": {"stopReason": message["stop_reason"]}}
349 
350             case "metadata":
351                 usage = event["usage"]
352 
353                 return {
354                     "metadata": {
355                         "usage": {
356                             "inputTokens": usage["input_tokens"],
357                             "outputTokens": usage["output_tokens"],
358                             "totalTokens": usage["input_tokens"] + usage["output_tokens"],
359                         },
360                         "metrics": {
361                             "latencyMs": 0,  # TODO
362                         },
363                     }
364                 }
365 
366             case _:
367                 raise RuntimeError(f"event_type=<{event['type']} | unknown type")
368 
369     @override
370     async def stream(
371         self,
372         messages: Messages,
373         tool_specs: list[ToolSpec] | None = None,
374         system_prompt: str | None = None,
375         *,
376         tool_choice: ToolChoice | None = None,
377         **kwargs: Any,
378     ) -> AsyncGenerator[StreamEvent, None]:
379         """Stream conversation with the Anthropic model.
380 
381         Args:
382             messages: List of message objects to be processed by the model.
383             tool_specs: List of tool specifications to make available to the model.
384             system_prompt: System prompt to provide context to the model.
385             tool_choice: Selection strategy for tool invocation.
386             **kwargs: Additional keyword arguments for future extensibility.
387 
388         Yields:
389             Formatted message chunks from the model.
390 
391         Raises:
392             ContextWindowOverflowException: If the input exceeds the model's context window.
393             ModelThrottledException: If the request is throttled by Anthropic.
394         """
395         logger.debug("formatting request")
396         request = self.format_request(messages, tool_specs, system_prompt, tool_choice)
397         logger.debug("request=<%s>", request)
398 
399         logger.debug("invoking model")
400         try:
401             async with self.client.messages.stream(**request) as stream:
402                 logger.debug("got response from model")
403                 async for event in stream:
404                     if event.type in AnthropicModel.EVENT_TYPES:
405                         yield self.format_chunk(event.model_dump())
406 
407                 usage = event.message.usage  # type: ignore
408                 yield self.format_chunk({"type": "metadata", "usage": usage.model_dump()})
409 
410         except anthropic.RateLimitError as error:
411             raise ModelThrottledException(str(error)) from error
412 
413         except anthropic.BadRequestError as error:
414             if any(overflow_message in str(error).lower() for overflow_message in AnthropicModel.OVERFLOW_MESSAGES):
415                 raise ContextWindowOverflowException(str(error)) from error
416 
417             raise error
418 
419         logger.debug("finished streaming response from model")
420 
421     @override
422     async def structured_output(
423         self, output_model: type[T], prompt: Messages, system_prompt: str | None = None, **kwargs: Any
424     ) -> AsyncGenerator[dict[str, T | Any], None]:
425         """Get structured output from the model.
426 
427         Args:
428             output_model: The output model to use for the agent.
