183         self.config.update(model_config)
184 
185     @override
186     def get_config(self) -> BedrockConfig:
187         """Get the current Bedrock Model configuration.
188 
189         Returns:
190             The Bedrock model configuration.
191         """
192         return self.config
193 
194     def _format_request(
195         self,
196         messages: Messages,
197         tool_specs: list[ToolSpec] | None = None,
198         system_prompt_content: list[SystemContentBlock] | None = None,
199         tool_choice: ToolChoice | None = None,
200     ) -> dict[str, Any]:
201         """Format a Bedrock converse stream request.
202 
203         Args:
204             messages: List of message objects to be processed by the model.
205             tool_specs: List of tool specifications to make available to the model.
206             tool_choice: Selection strategy for tool invocation.
207             system_prompt_content: System prompt content blocks to provide context to the model.
208 
209         Returns:
210             A Bedrock converse stream request.
211         """
212         if not tool_specs:
213             has_tool_content = any(
214                 any("toolUse" in block or "toolResult" in block for block in msg.get("content", [])) for msg in messages
215             )
216             if has_tool_content:
217                 tool_specs = [noop_tool.tool_spec]
218 
219         # Use system_prompt_content directly (copy for mutability)
220         system_blocks: list[SystemContentBlock] = system_prompt_content.copy() if system_prompt_content else []
221         # Add cache point if configured (backwards compatibility)
222         if cache_prompt := self.config.get("cache_prompt"):
223             warnings.warn(
224                 "cache_prompt is deprecated. Use SystemContentBlock with cachePoint instead.", UserWarning, stacklevel=3
225             )
226             system_blocks.append({"cachePoint": {"type": cache_prompt}})
227 
228         return {
229             "modelId": self.config["model_id"],
230             "messages": self._format_bedrock_messages(messages),
231             "system": system_blocks,
232             **(
233                 {
234                     "toolConfig": {
235                         "tools": [
236                             *[
237                                 {
238                                     "toolSpec": {
239                                         "name": tool_spec["name"],
240                                         "description": tool_spec["description"],
241                                         "inputSchema": tool_spec["inputSchema"],
242                                     }
243                                 }
244                                 for tool_spec in tool_specs
245                             ],
246                             *(
247                                 [{"cachePoint": {"type": self.config["cache_tools"]}}]
248                                 if self.config.get("cache_tools")
249                                 else []
250                             ),
251                         ],
252                         **({"toolChoice": tool_choice if tool_choice else {"auto": {}}}),
253                     }
254                 }
255                 if tool_specs
256                 else {}
257             ),
258             **(self._get_additional_request_fields(tool_choice)),
259             **(
260                 {"additionalModelResponseFieldPaths": self.config["additional_response_field_paths"]}
261                 if self.config.get("additional_response_field_paths")
262                 else {}
263             ),
264             **(
265                 {
266                     "guardrailConfig": {
267                         "guardrailIdentifier": self.config["guardrail_id"],
268                         "guardrailVersion": self.config["guardrail_version"],
269                         "trace": self.config.get("guardrail_trace", "enabled"),
270                         **(
271                             {"streamProcessingMode": self.config.get("guardrail_stream_processing_mode")}
272                             if self.config.get("guardrail_stream_processing_mode")
273                             else {}
274                         ),
275                     }
276                 }
277                 if self.config.get("guardrail_id") and self.config.get("guardrail_version")
278                 else {}
279             ),
280             "inferenceConfig": {
281                 key: value
282                 for key, value in [
283                     ("maxTokens", self.config.get("max_tokens")),
284                     ("temperature", self.config.get("temperature")),
285                     ("topP", self.config.get("top_p")),
286                     ("stopSequences", self.config.get("stop_sequences")),
287                 ]
288                 if value is not None
289             },
290             **(
291                 self.config["additional_args"]
292                 if "additional_args" in self.config and self.config["additional_args"] is not None
293                 else {}
294             ),
295         }
296 
297     def _get_additional_request_fields(self, tool_choice: ToolChoice | None) -> dict[str, Any]:
298         """Get additional request fields, removing thinking if tool_choice forces tool use.
299 
300         Bedrock's API does not allow thinking mode when tool_choice forces tool use.
301         When forcing a tool (e.g., for structured_output retry), we temporarily disable thinking.
302 
303         Args:
304             tool_choice: The tool choice configuration.
305 
306         Returns:
307             A dict containing additionalModelRequestFields if configured, or empty dict.
308         """
309         additional_fields = self.config.get("additional_request_fields")
310         if not additional_fields:
311             return {}
312 
313         # Check if tool_choice is forcing tool use ("any" or specific "tool")
314         is_forcing_tool = tool_choice is not None and ("any" in tool_choice or "tool" in tool_choice)
315 
316         if is_forcing_tool and "thinking" in additional_fields:
317             # Create a copy without the thinking key
318             fields_without_thinking = {k: v for k, v in additional_fields.items() if k != "thinking"}
319             if fields_without_thinking:
320                 return {"additionalModelRequestFields": fields_without_thinking}
321             return {}
322 
323         return {"additionalModelRequestFields": additional_fields}
324 
325     def _format_bedrock_messages(self, messages: Messages) -> list[dict[str, Any]]:
326         """Format messages for Bedrock API compatibility.
327 
328         This function ensures messages conform to Bedrock's expected format by:
329         - Filtering out SDK_UNKNOWN_MEMBER content blocks
330         - Eagerly filtering content blocks to only include Bedrock-supported fields
331         - Ensuring all message content blocks are properly formatted for the Bedrock API
332         - Optionally wrapping the last user message in guardrailConverseContent blocks
333 
334         Args:
335             messages: List of messages to format
336 
337         Returns:
338             Messages formatted for Bedrock API compatibility
339 
340         Note:
341             Unlike other APIs that ignore unknown fields, Bedrock only accepts a strict
342             subset of fields for each content block type and throws validation exceptions
343             when presented with unexpected fields. Therefore, we must eagerly filter all
344             content blocks to remove any additional fields before sending to Bedrock.
345             https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ContentBlock.html
346         """
347         cleaned_messages: list[dict[str, Any]] = []
348 
349         filtered_unknown_members = False
350         dropped_deepseek_reasoning_content = False
351 
352         guardrail_latest_message = self.config.get("guardrail_latest_message", False)
353 
354         for idx, message in enumerate(messages):
355             cleaned_content: list[dict[str, Any]] = []
356 
357             for content_block in message["content"]:
358                 # Filter out SDK_UNKNOWN_MEMBER content blocks
359                 if "SDK_UNKNOWN_MEMBER" in content_block:
360                     filtered_unknown_members = True
361                     continue
362 
363                 # DeepSeek models have issues with reasoningContent
364                 # TODO: Replace with systematic model configuration registry (https://github.com/strands-agents/sdk-python/issues/780)
365                 if "deepseek" in self.config["model_id"].lower() and "reasoningContent" in content_block:
366                     dropped_deepseek_reasoning_content = True
367                     continue
368 
369                 # Format content blocks for Bedrock API compatibility
370                 formatted_content = self._format_request_message_content(content_block)
371 
372                 # Wrap text or image content in guardrailContent if this is the last user message
373                 if (
374                     guardrail_latest_message
375                     and idx == len(messages) - 1
376                     and message["role"] == "user"
377                     and ("text" in formatted_content or "image" in formatted_content)
378                 ):
379                     if "text" in formatted_content:
380                         formatted_content = {"guardContent": {"text": {"text": formatted_content["text"]}}}
381                     elif "image" in formatted_content:
382                         formatted_content = {"guardContent": {"image": formatted_content["image"]}}
383 
384                 cleaned_content.append(formatted_content)
385 
386             # Create new message with cleaned content (skip if empty)
387             if cleaned_content:
388                 cleaned_messages.append({"content": cleaned_content, "role": message["role"]})
389 
390         if filtered_unknown_members:
391             logger.warning(
392                 "Filtered out SDK_UNKNOWN_MEMBER content blocks from messages, consider upgrading boto3 version"
393             )
394         if dropped_deepseek_reasoning_content:
395             logger.debug(
396                 "Filtered DeepSeek reasoningContent content blocks from messages - https://api-docs.deepseek.com/guides/reasoning_model#multi-round-conversation"
397             )
398 
399         return cleaned_messages
400 
401     def _should_include_tool_result_status(self) -> bool:
402         """Determine whether to include tool result status based on current config."""
403         include_status = self.config.get("include_tool_result_status", "auto")
404 
405         if include_status is True:
406             return True
407         elif include_status is False:
408             return False
409         else:  # "auto"
410             return any(model in self.config["model_id"] for model in _MODELS_INCLUDE_STATUS)
411 
412     def _format_request_message_content(self, content: ContentBlock) -> dict[str, Any]:
413         """Format a Bedrock content block.
414 
415         Bedrock strictly validates content blocks and throws exceptions for unknown fields.
416         This function extracts only the fields that Bedrock supports for each content type.
417 
418         Args:
419             content: Content block to format.
420 
421         Returns:
422             Bedrock formatted content block.
423 
424         Raises:
425             TypeError: If the content block type is not supported by Bedrock.
426         """
427         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_CachePointBlock.html
428         if "cachePoint" in content:
429             return {"cachePoint": {"type": content["cachePoint"]["type"]}}
430 
431         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_DocumentBlock.html
432         if "document" in content:
433             document = content["document"]
434             result: dict[str, Any] = {}
435 
436             # Handle required fields (all optional due to total=False)
437             if "name" in document:
438                 result["name"] = document["name"]
439             if "format" in document:
440                 result["format"] = document["format"]
441 
442             # Handle source
443             if "source" in document:
444                 result["source"] = {"bytes": document["source"]["bytes"]}
445 
446             # Handle optional fields
447             if "citations" in document and document["citations"] is not None:
448                 result["citations"] = {"enabled": document["citations"]["enabled"]}
449             if "context" in document:
450                 result["context"] = document["context"]
451 
452             return {"document": result}
453 
454         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_GuardrailConverseContentBlock.html
455         if "guardContent" in content:
456             guard = content["guardContent"]
457             guard_text = guard["text"]
458             result = {"text": {"text": guard_text["text"], "qualifiers": guard_text["qualifiers"]}}
459             return {"guardContent": result}
460 
461         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ImageBlock.html
462         if "image" in content:
463             image = content["image"]
464             source = image["source"]
465             formatted_source = {}
466             if "bytes" in source:
467                 formatted_source = {"bytes": source["bytes"]}
468             result = {"format": image["format"], "source": formatted_source}
469             return {"image": result}
470 
471         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ReasoningContentBlock.html
472         if "reasoningContent" in content:
473             reasoning = content["reasoningContent"]
474             result = {}
475 
476             if "reasoningText" in reasoning:
477                 reasoning_text = reasoning["reasoningText"]
478                 result["reasoningText"] = {}
479                 if "text" in reasoning_text:
480                     result["reasoningText"]["text"] = reasoning_text["text"]
481                 # Only include signature if truthy (avoid empty strings)
482                 if reasoning_text.get("signature"):
483                     result["reasoningText"]["signature"] = reasoning_text["signature"]
484 
485             if "redactedContent" in reasoning:
486                 result["redactedContent"] = reasoning["redactedContent"]
487 
488             return {"reasoningContent": result}
489 
490         # Pass through text and other simple content types
491         if "text" in content:
492             return {"text": content["text"]}
493 
494         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolResultBlock.html
495         if "toolResult" in content:
496             tool_result = content["toolResult"]
497             formatted_content: list[dict[str, Any]] = []
498             for tool_result_content in tool_result["content"]:
499                 if "json" in tool_result_content:
500                     # Handle json field since not in ContentBlock but valid in ToolResultContent
501                     formatted_content.append({"json": tool_result_content["json"]})
502                 else:
503                     formatted_content.append(
504                         self._format_request_message_content(cast(ContentBlock, tool_result_content))
505                     )
506 
507             result = {
508                 "content": formatted_content,
509                 "toolUseId": tool_result["toolUseId"],
510             }
511             if "status" in tool_result and self._should_include_tool_result_status():
512                 result["status"] = tool_result["status"]
513             return {"toolResult": result}
514 
515         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolUseBlock.html
516         if "toolUse" in content:
517             tool_use = content["toolUse"]
518             return {
519                 "toolUse": {
520                     "input": tool_use["input"],
521                     "name": tool_use["name"],
522                     "toolUseId": tool_use["toolUseId"],
523                 }
524             }
525 
526         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_VideoBlock.html
527         if "video" in content:
528             video = content["video"]
529             source = video["source"]
530             formatted_source = {}
531             if "bytes" in source:
532                 formatted_source = {"bytes": source["bytes"]}
533             result = {"format": video["format"], "source": formatted_source}
534             return {"video": result}
535 
536         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_CitationsContentBlock.html
537         if "citationsContent" in content:
538             citations = content["citationsContent"]
539             result = {}
540 
541             if "citations" in citations:
542                 result["citations"] = []
543                 for citation in citations["citations"]:
544                     filtered_citation: dict[str, Any] = {}
545                     if "location" in citation:
546                         filtered_citation["location"] = citation["location"]
547                     if "sourceContent" in citation:
548                         filtered_source_content: list[dict[str, Any]] = []
549                         for source_content in citation["sourceContent"]:
550                             if "text" in source_content:
551                                 filtered_source_content.append({"text": source_content["text"]})
552                         if filtered_source_content:
553                             filtered_citation["sourceContent"] = filtered_source_content
554                     if "title" in citation:
555                         filtered_citation["title"] = citation["title"]
556                     result["citations"].append(filtered_citation)
557 
558             if "content" in citations:
559                 filtered_content: list[dict[str, Any]] = []
560                 for generated_content in citations["content"]:
561                     if "text" in generated_content:
562                         filtered_content.append({"text": generated_content["text"]})
563                 if filtered_content:
564                     result["content"] = filtered_content
565 
566             return {"citationsContent": result}
567 
568         raise TypeError(f"content_type=<{next(iter(content))}> | unsupported type")
569 
570     def _has_blocked_guardrail(self, guardrail_data: dict[str, Any]) -> bool:
571         """Check if guardrail data contains any blocked policies.
572 
573         Args:
574             guardrail_data: Guardrail data from trace information.
575 
576         Returns:
577             True if any blocked guardrail is detected, False otherwise.
578         """
579         input_assessment = guardrail_data.get("inputAssessment", {})
580         output_assessments = guardrail_data.get("outputAssessments", {})
581 
582         # Check input assessments
583         if any(self._find_detected_and_blocked_policy(assessment) for assessment in input_assessment.values()):
584             return True
585 
586         # Check output assessments
587         if any(self._find_detected_and_blocked_policy(assessment) for assessment in output_assessments.values()):
588             return True
589 
590         return False
591 
592     def _generate_redaction_events(self) -> list[StreamEvent]:
593         """Generate redaction events based on configuration.
594 
595         Returns:
596             List of redaction events to yield.
597         """
598         events: list[StreamEvent] = []
599 
600         if self.config.get("guardrail_redact_input", True):
601             logger.debug("Redacting user input due to guardrail.")
602             events.append(
603                 {
604                     "redactContent": {
605                         "redactUserContentMessage": self.config.get(
606                             "guardrail_redact_input_message", "[User input redacted.]"
607                         )
608                     }
609                 }
610             )
611 
612         if self.config.get("guardrail_redact_output", False):
613             logger.debug("Redacting assistant output due to guardrail.")
614             events.append(
615                 {
616                     "redactContent": {
617                         "redactAssistantContentMessage": self.config.get(
618                             "guardrail_redact_output_message",
619                             "[Assistant output redacted.]",
620                         )
621                     }
622                 }
623             )
624 
625         return events
626 
627     @override
628     async def stream(
629         self,
630         messages: Messages,
631         tool_specs: list[ToolSpec] | None = None,
632         system_prompt: str | None = None,
633         *,
634         tool_choice: ToolChoice | None = None,
635         system_prompt_content: list[SystemContentBlock] | None = None,
636         **kwargs: Any,
637     ) -> AsyncGenerator[StreamEvent, None]:
638         """Stream conversation with the Bedrock model.
639 
640         This method calls either the Bedrock converse_stream API or the converse API
641         based on the streaming parameter in the configuration.
642 
643         Args:
644             messages: List of message objects to be processed by the model.
645             tool_specs: List of tool specifications to make available to the model.
646             system_prompt: System prompt to provide context to the model.
647             tool_choice: Selection strategy for tool invocation.
648             system_prompt_content: System prompt content blocks to provide context to the model.
649             **kwargs: Additional keyword arguments for future extensibility.
650 
651         Yields:
652             Model events.
653 
654         Raises:
655             ContextWindowOverflowException: If the input exceeds the model's context window.
656             ModelThrottledException: If the model service is throttling requests.
657         """
658 
659         def callback(event: StreamEvent | None = None) -> None:
660             loop.call_soon_threadsafe(queue.put_nowait, event)
661             if event is None:
662                 return
663 
664         loop = asyncio.get_event_loop()
665         queue: asyncio.Queue[StreamEvent | None] = asyncio.Queue()
666 
667         # Handle backward compatibility: if system_prompt is provided but system_prompt_content is None
668         if system_prompt and system_prompt_content is None:
669             system_prompt_content = [{"text": system_prompt}]
670 
671         thread = asyncio.to_thread(self._stream, callback, messages, tool_specs, system_prompt_content, tool_choice)
672         task = asyncio.create_task(thread)
673 
674         while True:
675             event = await queue.get()
676             if event is None:
677                 break
678 
679             yield event
680 
681         await task
682 
683     def _stream(
684         self,
685         callback: Callable[..., None],
686         messages: Messages,
687         tool_specs: list[ToolSpec] | None = None,
688         system_prompt_content: list[SystemContentBlock] | None = None,
689         tool_choice: ToolChoice | None = None,
690     ) -> None:
691         """Stream conversation with the Bedrock model.
692 
693         This method operates in a separate thread to avoid blocking the async event loop with the call to
694         Bedrock's converse_stream.
695 
696         Args:
697             callback: Function to send events to the main thread.
698             messages: List of message objects to be processed by the model.
699             tool_specs: List of tool specifications to make available to the model.
700             system_prompt_content: System prompt content blocks to provide context to the model.
701             tool_choice: Selection strategy for tool invocation.
702 
703         Raises:
704             ContextWindowOverflowException: If the input exceeds the model's context window.
705             ModelThrottledException: If the model service is throttling requests.
706         """
707         try:
708             logger.debug("formatting request")
709             request = self._format_request(messages, tool_specs, system_prompt_content, tool_choice)
710             logger.debug("request=<%s>", request)
711 
712             logger.debug("invoking model")
713             streaming = self.config.get("streaming", True)
714 
715             logger.debug("got response from model")
716             if streaming:
717                 response = self.client.converse_stream(**request)
718                 # Track tool use events to fix stopReason for streaming responses
719                 has_tool_use = False
720                 for chunk in response["stream"]:
721                     if (
722                         "metadata" in chunk
723                         and "trace" in chunk["metadata"]
724                         and "guardrail" in chunk["metadata"]["trace"]
725                     ):
726                         guardrail_data = chunk["metadata"]["trace"]["guardrail"]
727                         if self._has_blocked_guardrail(guardrail_data):
728                             for event in self._generate_redaction_events():
729                                 callback(event)
730 
731                     # Track if we see tool use events
732                     if "contentBlockStart" in chunk and chunk["contentBlockStart"].get("start", {}).get("toolUse"):
733                         has_tool_use = True
734 
735                     # Fix stopReason for streaming responses that contain tool use
736                     if (
737                         has_tool_use
738                         and "messageStop" in chunk
739                         and (message_stop := chunk["messageStop"]).get("stopReason") == "end_turn"
740                     ):
741                         # Create corrected chunk with tool_use stopReason
742                         modified_chunk = chunk.copy()
743                         modified_chunk["messageStop"] = message_stop.copy()
744                         modified_chunk["messageStop"]["stopReason"] = "tool_use"
745                         logger.warning("Override stop reason from end_turn to tool_use")
746                         callback(modified_chunk)
747                     else:
748                         callback(chunk)
749 
750             else:
751                 response = self.client.converse(**request)
752                 for event in self._convert_non_streaming_to_streaming(response):
753                     callback(event)
754 
755                 if (
756                     "trace" in response
757                     and "guardrail" in response["trace"]
758                     and self._has_blocked_guardrail(response["trace"]["guardrail"])
759                 ):
760                     for event in self._generate_redaction_events():
761                         callback(event)
762 
763         except ClientError as e:
764             error_message = str(e)
765 
766             if (
767                 e.response["Error"]["Code"] == "ThrottlingException"
768                 or e.response["Error"]["Code"] == "throttlingException"
769             ):
770                 raise ModelThrottledException(error_message) from e
771 
772             if any(overflow_message in error_message for overflow_message in BEDROCK_CONTEXT_WINDOW_OVERFLOW_MESSAGES):
773                 logger.warning("bedrock threw context window overflow error")
774                 raise ContextWindowOverflowException(e) from e
775 
776             region = self.client.meta.region_name
777 
778             # Aid in debugging by adding more information
779             add_exception_note(e, f"└ Bedrock region: {region}")
780             add_exception_note(e, f"└ Model id: {self.config.get('model_id')}")
781 
782             if (
783                 e.response["Error"]["Code"] == "AccessDeniedException"
784                 and "You don't have access to the model" in error_message
785             ):
786                 add_exception_note(
787                     e,
788                     "└ For more information see "
789                     "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#model-access-issue",
790                 )
791 
792             if (
793                 e.response["Error"]["Code"] == "ValidationException"
794                 and "with on-demand throughput isn’t supported" in error_message
795             ):
796                 add_exception_note(
797                     e,
798                     "└ For more information see "
799                     "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#on-demand-throughput-isnt-supported",
800                 )
801 
802             raise e
803 
804         finally:
805             callback()
806             logger.debug("finished streaming response from model")
807 
808     def _convert_non_streaming_to_streaming(self, response: dict[str, Any]) -> Iterable[StreamEvent]:
809         """Convert a non-streaming response to the streaming format.
810 
811         Args:
812             response: The non-streaming response from the Bedrock model.
813 
814         Returns:
815             An iterable of response events in the streaming format.
816         """
817         # Yield messageStart event
818         yield {"messageStart": {"role": response["output"]["message"]["role"]}}
819 
820         # Process content blocks
821         for content in cast(list[ContentBlock], response["output"]["message"]["content"]):
822             # Yield contentBlockStart event if needed
823             if "toolUse" in content:
824                 yield {
825                     "contentBlockStart": {
826                         "start": {
827                             "toolUse": {
828                                 "toolUseId": content["toolUse"]["toolUseId"],
829                                 "name": content["toolUse"]["name"],
830                             }
831                         },
832                     }
833                 }
834 
835                 # For tool use, we need to yield the input as a delta
836                 input_value = json.dumps(content["toolUse"]["input"])
837 
838                 yield {"contentBlockDelta": {"delta": {"toolUse": {"input": input_value}}}}
839             elif "text" in content:
840                 # Then yield the text as a delta
841                 yield {
842                     "contentBlockDelta": {
843                         "delta": {"text": content["text"]},
844                     }
845                 }
846             elif "reasoningContent" in content:
847                 # Then yield the reasoning content as a delta
848                 yield {
849                     "contentBlockDelta": {
850                         "delta": {"reasoningContent": {"text": content["reasoningContent"]["reasoningText"]["text"]}}
851                     }
852                 }
853 
854                 if "signature" in content["reasoningContent"]["reasoningText"]:
855                     yield {
856                         "contentBlockDelta": {
857                             "delta": {
858                                 "reasoningContent": {
859                                     "signature": content["reasoningContent"]["reasoningText"]["signature"]
860                                 }
861                             }
862                         }
863                     }
864             elif "citationsContent" in content:
865                 # For non-streaming citations, emit text and metadata deltas in sequence
866                 # to match streaming behavior where they flow naturally
867                 if "content" in content["citationsContent"]:
868                     text_content = "".join([content["text"] for content in content["citationsContent"]["content"]])
869                     yield {
870                         "contentBlockDelta": {"delta": {"text": text_content}},
871                     }
872 
873                 for citation in content["citationsContent"]["citations"]:
874                     # Then emit citation metadata (for structure)
875 
876                     citation_metadata: CitationsDelta = {
877                         "title": citation["title"],
878                         "location": citation["location"],
879                         "sourceContent": citation["sourceContent"],
880                     }
881                     yield {"contentBlockDelta": {"delta": {"citation": citation_metadata}}}
882 
883             # Yield contentBlockStop event
884             yield {"contentBlockStop": {}}
885 
886         # Yield messageStop event
887         # Fix stopReason for models that return end_turn when they should return tool_use on non-streaming side
888         current_stop_reason = response["stopReason"]
889         if current_stop_reason == "end_turn":
890             message_content = response["output"]["message"]["content"]
891             if any("toolUse" in content for content in message_content):
892                 current_stop_reason = "tool_use"
893                 logger.warning("Override stop reason from end_turn to tool_use")
894 
895         yield {
896             "messageStop": {
897                 "stopReason": current_stop_reason,
898                 "additionalModelResponseFields": response.get("additionalModelResponseFields"),
899             }
900         }
901 
902         # Yield metadata event
903         if "usage" in response or "metrics" in response or "trace" in response:
904             metadata: StreamEvent = {"metadata": {}}
905             if "usage" in response:
906                 metadata["metadata"]["usage"] = response["usage"]
907             if "metrics" in response:
908                 metadata["metadata"]["metrics"] = response["metrics"]
909             if "trace" in response:
910                 metadata["metadata"]["trace"] = response["trace"]
911             yield metadata
912 
913     def _find_detected_and_blocked_policy(self, input: Any) -> bool:
914         """Recursively checks if the assessment contains a detected and blocked guardrail.
915 
916         Args:
917             input: The assessment to check.
918 
919         Returns:
920             True if the input contains a detected and blocked guardrail, False otherwise.
921 
922         """
923         # Check if input is a dictionary
924         if isinstance(input, dict):
925             # Check if current dictionary has action: BLOCKED and detected: true
926             if input.get("action") == "BLOCKED" and input.get("detected") and isinstance(input.get("detected"), bool):
927                 return True
928 
929             # Otherwise, recursively check all values in the dictionary
930             return self._find_detected_and_blocked_policy(input.values())
931 
932         elif isinstance(input, (list, ValuesView)):
933             # Handle case where input is a list or dict_values
934             return any(self._find_detected_and_blocked_policy(item) for item in input)
935         # Otherwise return False
936         return False
937 
938     @override
939     async def structured_output(
940         self,
941         output_model: type[T],
942         prompt: Messages,
943         system_prompt: str | None = None,
944         **kwargs: Any,
945     ) -> AsyncGenerator[dict[str, T | Any], None]:
946         """Get structured output from the model.
947 
948         Args:
949             output_model: The output model to use for the agent.
950             prompt: The prompt messages to use for the agent.
951             system_prompt: System prompt to provide context to the model.
952             **kwargs: Additional keyword arguments for future extensibility.
953 
954         Yields:
955             Model events with the last being the structured output.
956         """
957         tool_spec = convert_pydantic_to_tool_spec(output_model)
958 
959         response = self.stream(
960             messages=prompt,
961             tool_specs=[tool_spec],
962             system_prompt=system_prompt,
963             tool_choice=cast(ToolChoice, {"any": {}}),
964             **kwargs,
965         )
966         async for event in streaming.process_stream(response):
967             yield event
968 
969         stop_reason, messages, _, _ = event["stop"]
970 
971         if stop_reason != "tool_use":
972             raise ValueError(f'Model returned stop_reason: {stop_reason} instead of "tool_use".')
973 
974         content = messages["content"]
975         output_response: dict[str, Any] | None = None
976         for block in content:
977             # if the tool use name doesn't match the tool spec name, skip, and if the block is not a tool use, skip.
978             # if the tool use name never matches, raise an error.
979             if block.get("toolUse") and block["toolUse"]["name"] == tool_spec["name"]:
980                 output_response = block["toolUse"]["input"]
981             else:
982                 continue
983 
984         if output_response is None:
985             raise ValueError("No valid tool use or tool use input was found in the Bedrock response.")
986 
987         yield {"output": output_model(**output_response)}
