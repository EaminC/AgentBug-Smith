864     def _redact_user_content(self, content: list[ContentBlock], redact_message: str) -> list[ContentBlock]:
865         """Redact user content preserving toolResult blocks.
866 
867         Args:
868             content: content blocks to be redacted
869             redact_message: redact message to be replaced
870 
871         Returns:
872             Redacted content, as follows:
873             - if the message contains at least a toolResult block,
874                 all toolResult blocks(s) are kept, redacting only the result content;
875             - otherwise, the entire content of the message is replaced
876                 with a single text block with the redact message.
877         """
878         redacted_content = []
879         for block in content:
880             if "toolResult" in block:
881                 block["toolResult"]["content"] = [{"text": redact_message}]
882                 redacted_content.append(block)
883 
884         if not redacted_content:
885             # Text content is added only if no toolResult blocks were found
886             redacted_content = [{"text": redact_message}]
887 
888         return redacted_content

