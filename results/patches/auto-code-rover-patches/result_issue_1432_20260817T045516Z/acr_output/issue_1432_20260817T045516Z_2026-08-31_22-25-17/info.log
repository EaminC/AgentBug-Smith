86 class Agent:
87     """Core Agent implementation.
88 
89     An agent orchestrates the following workflow:
90 
91     1. Receives user input
92     2. Processes the input using a language model
93     3. Decides whether to use tools to gather information or perform actions
94     4. Executes those tools and receives results
95     5. Continues reasoning with the new information
96     6. Produces a final response
97     """
98 
99     # For backwards compatibility
100     ToolCaller = _ToolCaller
101 
102     def __init__(
103         self,
104         model: Model | str | None = None,
105         messages: Messages | None = None,
