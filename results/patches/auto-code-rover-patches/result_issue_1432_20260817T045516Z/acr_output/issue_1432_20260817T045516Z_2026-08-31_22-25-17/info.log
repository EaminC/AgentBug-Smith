376     async def invoke_async(
377         self,
378         prompt: AgentInput = None,
379         *,
380         invocation_state: dict[str, Any] | None = None,
381         structured_output_model: type[BaseModel] | None = None,
382         **kwargs: Any,
383     ) -> AgentResult:
384         """Process a natural language prompt through the agent's event loop.
385 
386         This method implements the conversational interface with multiple input patterns:
387         - String input: Simple text input
388         - ContentBlock list: Multi-modal content blocks
389         - Message list: Complete messages with roles
390         - No input: Use existing conversation history
391 
392         Args:
393             prompt: User input in various formats:
394                 - str: Simple text input
395                 - list[ContentBlock]: Multi-modal content blocks
396                 - list[Message]: Complete messages with roles
397                 - None: Use existing conversation history
398             invocation_state: Additional parameters to pass through the event loop.
399             structured_output_model: Pydantic model type(s) for structured output (overrides agent default).
400             **kwargs: Additional parameters to pass through the event loop.[Deprecating]
401 
402         Returns:
403             Result: object containing:
404 
405                 - stop_reason: Why the event loop stopped (e.g., "end_turn", "max_tokens")
406                 - message: The final message from the model
407                 - metrics: Performance metrics from the event loop
408                 - state: The final state of the event loop
409         """
410         events = self.stream_async(
411             prompt, invocation_state=invocation_state, structured_output_model=structured_output_model, **kwargs
412         )
413         async for event in events:
414             _ = event
415 
416         return cast(AgentResult, event["result"])
417 
418     def structured_output(self, output_model: type[T], prompt: AgentInput = None) -> T:
419         """This method allows you to get structured output from the agent.
