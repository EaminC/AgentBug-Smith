57 class BedrockModel(Model):
58     """AWS Bedrock model provider implementation.
59 
60     The implementation handles Bedrock-specific features such as:
61 
62     - Tool configuration for function calling
63     - Guardrails integration
64     - Caching points for system prompts and tools
65     - Streaming responses
66     - Context window overflow detection
67     """
