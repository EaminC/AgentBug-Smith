314         Returns:
315             Tool caller through which user can invoke tool as a function.
316 
317         Example:
318             ```
319             agent = Agent(tools=[calculator])
320             agent.tool.calculator(...)
321             ```
322         """
323         return self.tool_caller
324 
325     @property
326     def tool_names(self) -> list[str]:
327         """Get a list of all registered tool names.
328 
329         Returns:
330             Names of all tools available to this agent.
331         """
332         all_tools = self.tool_registry.get_all_tools_config()
