989     @staticmethod
990     def _get_default_model_with_warning(region_name: str, model_config: BedrockConfig | None = None) -> str:
991         """Get the default Bedrock modelId based on region.
992 
993         If the region is not **known** to support inference then we show a helpful warning
994         that compliments the exception that Bedrock will throw.
995         If the customer provided a model_id in their config or they overrode the `DEFAULT_BEDROCK_MODEL_ID`
996         then we should not process further.
997 
998         Args:
999             region_name (str): region for bedrock model
1000             model_config (Optional[dict[str, Any]]): Model Config that caller passes in on init
1001         """
1002         if DEFAULT_BEDROCK_MODEL_ID != _DEFAULT_BEDROCK_MODEL_ID.format("us"):
1003             return DEFAULT_BEDROCK_MODEL_ID
1004 
1005         model_config = model_config or {}
1006         if model_config.get("model_id"):
1007             return model_config["model_id"]
1008 
1009         prefix_inference_map = {"ap": "apac"}  # some inference endpoints can be a bit different than the region prefix
1010 
1011         prefix = "-".join(region_name.split("-")[:-2]).lower()  # handles `us-east-1` or `us-gov-east-1`
1012         if prefix not in {"us", "eu", "ap", "us-gov"}:
1013             warnings.warn(
1014                 f"""
1015             ================== WARNING ==================
1016 
1017                 This region {region_name} does not support
1018                 our default inference endpoint: {_DEFAULT_BEDROCK_MODEL_ID.format(prefix)}.
1019                 Update the agent to pass in a 'model_id' like so:
1020                 ```
1021                 Agent(..., model='valid_model_id', ...)
1022                 ````
1023                 Documentation: https://docs.aws.amazon.com/bedrock/latest/userguide/inference-profiles-support.html
1024 
1025             ==================================================
1026             """,
1027                 stacklevel=2,
1028             )
1029 
1030         return _DEFAULT_BEDROCK_MODEL_ID.format(prefix_inference_map.get(prefix, prefix))

