162 def _build_checkpoint_stop_event(
163     agent: "Agent",
164     position: CheckpointPosition,
165     cycle_index: int,
166     message: Message,
167     request_state: Any,
168 ) -> EventLoopStopEvent:
169     """Build a checkpoint stop event. Used at ``after_model`` and ``after_tools``."""
170     checkpoint = Checkpoint(
171         position=position,
172         cycle_index=cycle_index,
173     )
174     return EventLoopStopEvent(
175         "checkpoint",
176         message,
177         agent.event_loop_metrics,
178         request_state,
179         checkpoint=checkpoint,
180     )
