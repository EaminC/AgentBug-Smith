80             client_config = boto_client_config.merge(BotocoreConfig(user_agent_extra=new_user_agent))
81         else:
82             client_config = BotocoreConfig(user_agent_extra="strands-agents")
83 
84         self.client = session.client(service_name="s3", config=client_config)
85         super().__init__(session_id=session_id, session_repository=self)
86 
87     def _get_session_path(self, session_id: str) -> str:
88         """Get session S3 prefix.
89 
90         Args:
91             session_id: ID for the session.
92 
93         Raises:
94             ValueError: If session id contains a path separator.
95         """
96         session_id = _identifier.validate(session_id, _identifier.Identifier.SESSION)
97         return f"{self.prefix}/{SESSION_PREFIX}{session_id}/"
98 
99     def _get_agent_path(self, session_id: str, agent_id: str) -> str:
100         """Get agent S3 prefix.
101 
102         Args:
103             session_id: ID for the session.
104             agent_id: ID for the agent.
105 
106         Raises:
107             ValueError: If session id or agent id contains a path separator.
108         """
109         session_path = self._get_session_path(session_id)
110         agent_id = _identifier.validate(agent_id, _identifier.Identifier.AGENT)
111         return f"{session_path}agents/{AGENT_PREFIX}{agent_id}/"
112 
113     def _get_message_path(self, session_id: str, agent_id: str, message_id: int) -> str:
114         """Get message S3 key.
115 
116         Args:
117             session_id: ID of the session
118             agent_id: ID of the agent
119             message_id: Index of the message
120 
121         Returns:
122             The key for the message
123 
124         Raises:
125             ValueError: If message_id is not an integer.
126         """
127         if not isinstance(message_id, int):
128             raise ValueError(f"message_id=<{message_id}> | message id must be an integer")
129 
130         agent_path = self._get_agent_path(session_id, agent_id)
131         return f"{agent_path}messages/{MESSAGE_PREFIX}{message_id}.json"
132 
133     def _read_s3_object(self, key: str) -> dict[str, Any] | None:
134         """Read JSON object from S3."""
135         try:
136             response = self.client.get_object(Bucket=self.bucket, Key=key)
137             content = response["Body"].read().decode("utf-8")
138             return cast(dict[str, Any], json.loads(content))
139         except ClientError as e:
140             if e.response["Error"]["Code"] == "NoSuchKey":
141                 return None
142             else:
143                 raise SessionException(f"S3 error reading {key}: {e}") from e
144         except json.JSONDecodeError as e:
145             raise SessionException(f"Invalid JSON in S3 object {key}: {e}") from e
146 
147     def _write_s3_object(self, key: str, data: dict[str, Any]) -> None:
148         """Write JSON object to S3."""
149         try:
150             content = json.dumps(data, indent=2, ensure_ascii=False)
151             self.client.put_object(
152                 Bucket=self.bucket, Key=key, Body=content.encode("utf-8"), ContentType="application/json"
153             )
154         except ClientError as e:
155             raise SessionException(f"Failed to write S3 object {key}: {e}") from e
156 
157     def create_session(self, session: Session, **kwargs: Any) -> Session:
158         """Create a new session in S3."""
159         session_key = f"{self._get_session_path(session.session_id)}session.json"
160 
161         # Check if session already exists
162         try:
163             self.client.head_object(Bucket=self.bucket, Key=session_key)
164             raise SessionException(f"Session {session.session_id} already exists")
165         except ClientError as e:
166             if e.response["Error"]["Code"] != "404":
167                 raise SessionException(f"S3 error checking session existence: {e}") from e
168 
169         # Write session object
170         session_dict = session.to_dict()
171         self._write_s3_object(session_key, session_dict)
172         return session
173 
174     def read_session(self, session_id: str, **kwargs: Any) -> Session | None:
175         """Read session data from S3."""
176         session_key = f"{self._get_session_path(session_id)}session.json"
177         session_data = self._read_s3_object(session_key)
178         if session_data is None:
179             return None
180         return Session.from_dict(session_data)
181 
182     def delete_session(self, session_id: str, **kwargs: Any) -> None:
183         """Delete session and all associated data from S3."""
184         session_prefix = self._get_session_path(session_id)
185         try:
186             paginator = self.client.get_paginator("list_objects_v2")
187             pages = paginator.paginate(Bucket=self.bucket, Prefix=session_prefix)
188 
189             objects_to_delete = []
190             for page in pages:
191                 if "Contents" in page:
192                     objects_to_delete.extend([{"Key": obj["Key"]} for obj in page["Contents"]])
193 
194             if not objects_to_delete:
195                 raise SessionException(f"Session {session_id} does not exist")
196 
197             # Delete objects in batches
198             for i in range(0, len(objects_to_delete), 1000):
199                 batch = objects_to_delete[i : i + 1000]
200                 self.client.delete_objects(Bucket=self.bucket, Delete={"Objects": batch})
201 
202         except ClientError as e:
203             raise SessionException(f"S3 error deleting session {session_id}: {e}") from e
204 
205     def create_agent(self, session_id: str, session_agent: SessionAgent, **kwargs: Any) -> None:
206         """Create a new agent in S3."""
207         agent_id = session_agent.agent_id
208         agent_dict = session_agent.to_dict()
209         agent_key = f"{self._get_agent_path(session_id, agent_id)}agent.json"
210         self._write_s3_object(agent_key, agent_dict)
211 
212     def read_agent(self, session_id: str, agent_id: str, **kwargs: Any) -> SessionAgent | None:
213         """Read agent data from S3."""
214         agent_key = f"{self._get_agent_path(session_id, agent_id)}agent.json"
215         agent_data = self._read_s3_object(agent_key)
216         if agent_data is None:
217             return None
218         return SessionAgent.from_dict(agent_data)
219 
220     def update_agent(self, session_id: str, session_agent: SessionAgent, **kwargs: Any) -> None:
221         """Update agent data in S3."""
222         agent_id = session_agent.agent_id
223         previous_agent = self.read_agent(session_id=session_id, agent_id=agent_id)
224         if previous_agent is None:
225             raise SessionException(f"Agent {agent_id} in session {session_id} does not exist")
226 
227         # Preserve creation timestamp
228         session_agent.created_at = previous_agent.created_at
229         agent_key = f"{self._get_agent_path(session_id, agent_id)}agent.json"
230         self._write_s3_object(agent_key, session_agent.to_dict())
231 
232     def create_message(self, session_id: str, agent_id: str, session_message: SessionMessage, **kwargs: Any) -> None:
233         """Create a new message in S3."""
234         message_id = session_message.message_id
235         message_dict = session_message.to_dict()
236         message_key = self._get_message_path(session_id, agent_id, message_id)
237         self._write_s3_object(message_key, message_dict)
238 
239     def read_message(self, session_id: str, agent_id: str, message_id: int, **kwargs: Any) -> SessionMessage | None:
240         """Read message data from S3."""
241         message_key = self._get_message_path(session_id, agent_id, message_id)
242         message_data = self._read_s3_object(message_key)
243         if message_data is None:
244             return None
245         return SessionMessage.from_dict(message_data)
246 
247     def update_message(self, session_id: str, agent_id: str, session_message: SessionMessage, **kwargs: Any) -> None:
248         """Update message data in S3."""
249         message_id = session_message.message_id
250         previous_message = self.read_message(session_id=session_id, agent_id=agent_id, message_id=message_id)
251         if previous_message is None:
252             raise SessionException(f"Message {message_id} does not exist")
253 
254         # Preserve creation timestamp
255         session_message.created_at = previous_message.created_at
256         message_key = self._get_message_path(session_id, agent_id, message_id)
257         self._write_s3_object(message_key, session_message.to_dict())
258 
259     def list_messages(
260         self, session_id: str, agent_id: str, limit: int | None = None, offset: int = 0, **kwargs: Any
261     ) -> list[SessionMessage]:
262         """List messages for an agent with pagination from S3."""
263         messages_prefix = f"{self._get_agent_path(session_id, agent_id)}messages/"
264         try:
265             paginator = self.client.get_paginator("list_objects_v2")
266             pages = paginator.paginate(Bucket=self.bucket, Prefix=messages_prefix)
267 
268             # Collect all message keys and extract their indices
269             message_index_keys: list[tuple[int, str]] = []
270             for page in pages:
271                 if "Contents" in page:
272                     for obj in page["Contents"]:
273                         key = obj["Key"]
274                         if key.endswith(".json") and MESSAGE_PREFIX in key:
275                             # Extract the filename part from the full S3 key
276                             filename = key.split("/")[-1]
277                             # Extract index from message_<index>.json format
278                             index = int(filename[len(MESSAGE_PREFIX) : -5])  # Remove prefix and .json suffix
279                             message_index_keys.append((index, key))
280 
281             # Sort by index and extract just the keys
282             message_keys = [k for _, k in sorted(message_index_keys)]
283 
284             # Apply pagination to keys before loading content
285             if limit is not None:
286                 message_keys = message_keys[offset : offset + limit]
287             else:
288                 message_keys = message_keys[offset:]
289 
290             # Load only the required message objects
291             messages: list[SessionMessage] = []
292             for key in message_keys:
293                 message_data = self._read_s3_object(key)
294                 if message_data:
295                     messages.append(SessionMessage.from_dict(message_data))
296 
297             return messages
298 
299         except ClientError as e:
300             raise SessionException(f"S3 error reading messages: {e}") from e
301 
302     def _get_multi_agent_path(self, session_id: str, multi_agent_id: str) -> str:
303         """Get multi-agent S3 prefix."""
304         session_path = self._get_session_path(session_id)
305         multi_agent_id = _identifier.validate(multi_agent_id, _identifier.Identifier.AGENT)
306         return f"{session_path}multi_agents/{MULTI_AGENT_PREFIX}{multi_agent_id}/"
307 
308     def create_multi_agent(self, session_id: str, multi_agent: "MultiAgentBase", **kwargs: Any) -> None:
309         """Create a new multiagent state in S3."""
