28 class RepositorySessionManager(SessionManager):
29     """Session manager for persisting agents in a SessionRepository."""
30 
31     def __init__(
32         self,
33         session_id: str,
34         session_repository: SessionRepository,
35         **kwargs: Any,
36     ):
37         """Initialize the RepositorySessionManager.
38 
39         If no session with the specified session_id exists yet, it will be created
40         in the session_repository.
41 
42         Args:
43             session_id: ID to use for the session. A new session with this id will be created if it does
44                 not exist in the repository yet
45             session_repository: Underlying session repository to use to store the sessions state.
46             **kwargs: Additional keyword arguments for future extensibility.
47 
48         """
49         self.session_repository = session_repository
50         self.session_id = session_id
51         session = session_repository.read_session(session_id)
52         # Create a session if it does not exist yet
53         if session is None:
54             logger.debug("session_id=<%s> | session not found, creating new session", self.session_id)
55             self._is_new_session = True
56             session = Session(session_id=session_id, session_type=SessionType.AGENT)
57             session_repository.create_session(session)
58         else:
59             self._is_new_session = False
60 
61         self.session = session
62 
63         # Keep track of the latest message of each agent in case we need to redact it.
64         self._latest_agent_message: dict[str, SessionMessage | None] = {}
65 
66         # Track the previously synced internal state for each agent to detect changes.
67         self._last_synced_internal_state: dict[str, dict[str, Any]] = {}
68 
69     def append_message(self, message: Message, agent: "Agent", **kwargs: Any) -> None:
70         """Append a message to the agent's session.
71 
72         Args:
73             message: Message to add to the agent in the session
74             agent: Agent to append the message to
75             **kwargs: Additional keyword arguments for future extensibility.
76         """
77         # Calculate the next index (0 if this is the first message, otherwise increment the previous index)
78         latest_agent_message = self._latest_agent_message[agent.agent_id]
79         if latest_agent_message:
80             next_index = latest_agent_message.message_id + 1
81         else:
82             next_index = 0
83 
84         session_message = SessionMessage.from_message(message, next_index)
85         self._latest_agent_message[agent.agent_id] = session_message
86         self.session_repository.create_message(self.session_id, agent.agent_id, session_message)
87 
88     def redact_latest_message(self, redact_message: Message, agent: "Agent", **kwargs: Any) -> None:
89         """Redact the latest message appended to the session.
90 
91         Args:
92             redact_message: New message to use that contains the redact content
93             agent: Agent to apply the message redaction to
94             **kwargs: Additional keyword arguments for future extensibility.
95         """
96         latest_agent_message = self._latest_agent_message[agent.agent_id]
97         if latest_agent_message is None:
98             raise SessionException("No message to redact.")
99         latest_agent_message.redact_message = redact_message
100         return self.session_repository.update_message(self.session_id, agent.agent_id, latest_agent_message)
