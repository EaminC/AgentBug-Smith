9 class Mem0Storage(Storage):
10     """
11     Extends Storage to handle embedding and searching across entities using Mem0.
12     """
13 
14     def __init__(self, type, crew=None, config=None):
15         super().__init__()
16         supported_types = ["user", "short_term", "long_term", "entities", "external"]
17         if type not in supported_types:
18             raise ValueError(
19                 f"Invalid type '{type}' for Mem0Storage. Must be one of: "
20                 + ", ".join(supported_types)
21             )
22 
23         self.memory_type = type
24         self.crew = crew
25         self.config = config or {}
26         # TODO: Memory config will be removed in the future the config will be passed as a parameter
27         self.memory_config = self.config or getattr(crew, "memory_config", {}) or {}
28 
29         # User ID is required for user memory type "user" since it's used as a unique identifier for the user.
30         user_id = self._get_user_id()
31         if type == "user" and not user_id:
32             raise ValueError("User ID is required for user memory type")
33 
34         # API key in memory config overrides the environment variable
35         config = self._get_config()
36         mem0_api_key = config.get("api_key") or os.getenv("MEM0_API_KEY")
37         mem0_org_id = config.get("org_id")
38         mem0_project_id = config.get("project_id")
39         mem0_local_config = config.get("local_mem0_config")
40 
41         # Initialize MemoryClient or Memory based on the presence of the mem0_api_key
42         if mem0_api_key:
43             if mem0_org_id and mem0_project_id:
44                 self.memory = MemoryClient(
45                     api_key=mem0_api_key, org_id=mem0_org_id, project_id=mem0_project_id
46                 )
47             else:
48                 self.memory = MemoryClient(api_key=mem0_api_key)
49         else:
50             if mem0_local_config and len(mem0_local_config):
51                 self.memory = Memory.from_config(config)
52             else:
53                 self.memory = Memory()
54 
55     def _sanitize_role(self, role: str) -> str:
56         """
57         Sanitizes agent roles to ensure valid directory names.
58         """
59         return role.replace("\n", "").replace(" ", "_").replace("/", "_")
60 
61     def save(self, value: Any, metadata: Dict[str, Any]) -> None:
62         user_id = self._get_user_id()
63         agent_name = self._get_agent_name()
64         params = None
65         if self.memory_type == "short_term":
66             params = {
67                 "agent_id": agent_name,
68                 "infer": False,
69                 "metadata": {"type": "short_term", **metadata},
70             }
71         elif self.memory_type == "long_term":
72             params = {
73                 "agent_id": agent_name,
74                 "infer": False,
75                 "metadata": {"type": "long_term", **metadata},
76             }
77         elif self.memory_type == "entities":
78             params = {
79                 "agent_id": agent_name,
80                 "infer": False,
81                 "metadata": {"type": "entity", **metadata},
82             }
83         elif self.memory_type == "external":
84             params = {
85                 "user_id": user_id,
86                 "agent_id": agent_name,
87                 "metadata": {"type": "external", **metadata},
88             }
89 
90         if params:
91             self.memory.add(value, **params | {"output_format": "v1.1"})
92 
93     def search(
94         self,
95         query: str,
96         limit: int = 3,
97         score_threshold: float = 0.35,
98     ) -> List[Any]:
99         params = {"query": query, "limit": limit}
100         if user_id := self._get_user_id():
101             params["user_id"] = user_id
102 
103         agent_name = self._get_agent_name()
104         if self.memory_type == "short_term":
105             params["agent_id"] = agent_name
106             params["metadata"] = {"type": "short_term"}
107         elif self.memory_type == "long_term":
108             params["agent_id"] = agent_name
109             params["metadata"] = {"type": "long_term"}
110         elif self.memory_type == "entities":
111             params["agent_id"] = agent_name
112             params["metadata"] = {"type": "entity"}
113         elif self.memory_type == "external":
114             params["agent_id"] = agent_name
115             params["metadata"] = {"type": "external"}
116 
117         # Discard the filters for now since we create the filters
118         # automatically when the crew is created.
119         results = self.memory.search(**params)
120         return [r for r in results if r["score"] >= score_threshold]
121 
122     def _get_user_id(self) -> str:
123         return self._get_config().get("user_id", "")
124 
125     def _get_agent_name(self) -> str:
126         if not self.crew:
127             return ""
128 
129         agents = self.crew.agents
130         agents = [self._sanitize_role(agent.role) for agent in agents]
131         agents = "_".join(agents)
132         return agents
133 
134     def _get_config(self) -> Dict[str, Any]:
135         return self.config or getattr(self, "memory_config", {}).get("config", {}) or {}
136 
137     def reset(self):
138         if self.memory:
139             self.memory.reset()

