228     @model_validator(mode="after")
229     def ensure_guardrail_is_callable(self) -> Self:
230         if callable(self.guardrail):
231             self._guardrail = self.guardrail
232         elif isinstance(self.guardrail, str):
233             from crewai.tasks.llm_guardrail import LLMGuardrail
234 
235             assert isinstance(self.llm, LLM)
236 
237             self._guardrail = LLMGuardrail(description=self.guardrail, llm=self.llm)
