293     def kickoff(self, messages: Union[str, List[Dict[str, str]]]) -> LiteAgentOutput:
294         """
295         Execute the agent with the given messages.
296 
297         Args:
298             messages: Either a string query or a list of message dictionaries.
299                      If a string is provided, it will be converted to a user message.
300                      If a list is provided, each dict should have 'role' and 'content' keys.
301 
302         Returns:
303             LiteAgentOutput: The result of the agent execution.
304         """
305         # Create agent info for event emission
306         agent_info = {
307             "role": self.role,
308             "goal": self.goal,
309             "backstory": self.backstory,
310             "tools": self._parsed_tools,
311             "verbose": self.verbose,
312         }
313 
314         try:
315             # Reset state for this run
316             self._iterations = 0
317             self.tools_results = []
318 
319             # Format messages for the LLM
320             self._messages = self._format_messages(messages)
321 
322             return self._execute_core(agent_info=agent_info)
323 
324         except Exception as e:
325             self._printer.print(
326                 content="Agent failed to reach a final answer. This is likely a bug - please report it.",
327                 color="red",
328             )
329             handle_unknown_error(self._printer, e)
330             # Emit error event
331             crewai_event_bus.emit(
332                 self,
333                 event=LiteAgentExecutionErrorEvent(
334                     agent_info=agent_info,
335                     error=str(e),
336                 ),
337             )
338             raise e
339 
340     def _execute_core(self, agent_info: Dict[str, Any]) -> LiteAgentOutput:
341         # Emit event for agent execution start
342         crewai_event_bus.emit(
343             self,
344             event=LiteAgentExecutionStartedEvent(
345                 agent_info=agent_info,
346                 tools=self._parsed_tools,
347                 messages=self._messages,
348             ),
349         )
350 
351         # Execute the agent using invoke loop
352         agent_finish = self._invoke_loop()
353         formatted_result: Optional[BaseModel] = None
354         if self.response_format:
355             try:
356                 # Cast to BaseModel to ensure type safety
357                 result = self.response_format.model_validate_json(agent_finish.output)
358                 if isinstance(result, BaseModel):
359                     formatted_result = result
360             except Exception as e:
361                 self._printer.print(
362                     content=f"Failed to parse output into response format: {str(e)}",
363                     color="yellow",
364                 )
365 
366         # Calculate token usage metrics
367         usage_metrics = self._token_process.get_summary()
368 
369         # Create output
370         output = LiteAgentOutput(
371             raw=agent_finish.output,
372             pydantic=formatted_result,
373             agent_role=self.role,
374             usage_metrics=usage_metrics.model_dump() if usage_metrics else None,
375         )
376 
377         # Process guardrail if set
378         if self._guardrail is not None:
379             guardrail_result = process_guardrail(
380                 output=output,
381                 guardrail=self._guardrail,
382                 retry_count=self._guardrail_retry_count,
383             )
384 
385             if not guardrail_result.success:
386                 if self._guardrail_retry_count >= self.guardrail_max_retries:
387                     raise Exception(
388                         f"Agent's guardrail failed validation after {self.guardrail_max_retries} retries. "
389                         f"Last error: {guardrail_result.error}"
390                     )
391                 self._guardrail_retry_count += 1
392                 if self.verbose:
393                     self._printer.print(
394                         f"Guardrail failed. Retrying ({self._guardrail_retry_count}/{self.guardrail_max_retries})..."
395                         f"\n{guardrail_result.error}"
396                     )
397 
398                 self._messages.append(
399                     {
400                         "role": "user",
401                         "content": guardrail_result.error
402                         or "Guardrail validation failed",
403                     }
404                 )
405 
406                 return self._execute_core(agent_info=agent_info)
407 
408             # Apply guardrail result if available
409             if guardrail_result.result is not None:
410                 if isinstance(guardrail_result.result, str):
411                     output.raw = guardrail_result.result
412                 elif isinstance(guardrail_result.result, BaseModel):
413                     output.pydantic = guardrail_result.result
414 
415             usage_metrics = self._token_process.get_summary()
416             output.usage_metrics = usage_metrics.model_dump() if usage_metrics else None
417 
418         # Emit completion event
419         crewai_event_bus.emit(
420             self,
421             event=LiteAgentExecutionCompletedEvent(
422                 agent_info=agent_info,
423                 output=agent_finish.output,
424             ),
425         )
426 
427         return output
428 
429     async def kickoff_async(
430         self, messages: Union[str, List[Dict[str, str]]]
431     ) -> LiteAgentOutput:
432         """
433         Execute the agent asynchronously with the given messages.
434 
435         Args:
436             messages: Either a string query or a list of message dictionaries.
437                      If a string is provided, it will be converted to a user message.
438                      If a list is provided, each dict should have 'role' and 'content' keys.
439 
440         Returns:
441             LiteAgentOutput: The result of the agent execution.
442         """
443         return await asyncio.to_thread(self.kickoff, messages)
