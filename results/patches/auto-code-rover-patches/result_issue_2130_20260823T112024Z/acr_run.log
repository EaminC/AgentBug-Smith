215     def _format_request(
216         self,
217         messages: Messages,
218         tool_specs: list[ToolSpec] | None = None,
219         system_prompt_content: list[SystemContentBlock] | None = None,
220         tool_choice: ToolChoice | None = None,
221     ) -> dict[str, Any]:
222         """Format a Bedrock converse stream request.
223 
224         Args:
225             messages: List of message objects to be processed by the model.
226             tool_specs: List of tool specifications to make available to the model.
227             tool_choice: Selection strategy for tool invocation.
228             system_prompt_content: System prompt content blocks to provide context to the model.
229 
230         Returns:
231             A Bedrock converse stream request.
232         """
233         if not tool_specs:
234             has_tool_content = any(
235                 any("toolUse" in block or "toolResult" in block for block in msg.get("content", [])) for msg in messages
236             )
237             if has_tool_content:
238                 tool_specs = [noop_tool.tool_spec]
239 
240         # Use system_prompt_content directly (copy for mutability)
241         system_blocks: list[SystemContentBlock] = system_prompt_content.copy() if system_prompt_content else []
242         # Add cache point if configured (backwards compatibility)
243         if cache_prompt := self.config.get("cache_prompt"):
244             warnings.warn(
245                 "cache_prompt is deprecated. Use SystemContentBlock with cachePoint instead.", UserWarning, stacklevel=3
246             )
247             system_blocks.append({"cachePoint": {"type": cache_prompt}})
248 
249         return {
250             "modelId": self.config["model_id"],
251             "messages": self._format_bedrock_messages(messages),
252             "system": system_blocks,
253             **({"serviceTier": {"type": self.config["service_tier"]}} if self.config.get("service_tier") else {}),
254             **(
255                 {
256                     "toolConfig": {
257                         "tools": [
258                             *[
259                                 {
260                                     "toolSpec": {
261                                         "name": tool_spec["name"],
262                                         "description": tool_spec["description"],
263                                         "inputSchema": tool_spec["inputSchema"],
264                                     }
265                                 }
266                                 for tool_spec in tool_specs
267                             ],
268                             *(
269                                 [{"cachePoint": {"type": self.config["cache_tools"]}}]
270                                 if self.config.get("cache_tools")
271                                 else []
272                             ),
273                         ],
274                         **({"toolChoice": tool_choice if tool_choice else {"auto": {}}}),
275                     }
276                 }
277                 if tool_specs
278                 else {}
279             ),
280             **(self._get_additional_request_fields(tool_choice)),
281             **(
282                 {"additionalModelResponseFieldPaths": self.config["additional_response_field_paths"]}
283                 if self.config.get("additional_response_field_paths")
284                 else {}
285             ),
286             **(
287                 {
288                     "guardrailConfig": {
289                         "guardrailIdentifier": self.config["guardrail_id"],
290                         "guardrailVersion": self.config["guardrail_version"],
291                         "trace": self.config.get("guardrail_trace", "enabled"),
292                         **(
293                             {"streamProcessingMode": self.config.get("guardrail_stream_processing_mode")}
294                             if self.config.get("guardrail_stream_processing_mode")
295                             else {}
296                         ),
297                     }
298                 }
299                 if self.config.get("guardrail_id") and self.config.get("guardrail_version")
300                 else {}
301             ),
302             "inferenceConfig": {
303                 key: value
304                 for key, value in [
305                     ("maxTokens", self.config.get("max_tokens")),
306                     ("temperature", self.config.get("temperature")),
307                     ("topP", self.config.get("top_p")),
308                     ("stopSequences", self.config.get("stop_sequences")),
309                 ]
310                 if value is not None
311             },
312             **(
313                 self.config["additional_args"]
314                 if "additional_args" in self.config and self.config["additional_args"] is not None
315                 else {}
316             ),
317         }
318 
319     def _get_additional_request_fields(self, tool_choice: ToolChoice | None) -> dict[str, Any]:
320         """Get additional request fields, removing thinking if tool_choice forces tool use.
321 
322         Bedrock's API does not allow thinking mode when tool_choice forces tool use.
323         When forcing a tool (e.g., for structured_output retry), we temporarily disable thinking.
324 
325         Args:
326             tool_choice: The tool choice configuration.
327 
328         Returns:
329             A dict containing additionalModelRequestFields if configured, or empty dict.
330         """
331         additional_fields = self.config.get("additional_request_fields")
332         if not additional_fields:
333             return {}
334 
335         # Check if tool_choice is forcing tool use ("any" or specific "tool")
336         is_forcing_tool = tool_choice is not None and ("any" in tool_choice or "tool" in tool_choice)
337 
338         if is_forcing_tool and "thinking" in additional_fields:
339             # Create a copy without the thinking key
340             fields_without_thinking = {k: v for k, v in additional_fields.items() if k != "thinking"}
341             if fields_without_thinking:
342                 return {"additionalModelRequestFields": fields_without_thinking}
343             return {}
344 
345         return {"additionalModelRequestFields": additional_fields}
346 
347     def _inject_cache_point(self, messages: list[dict[str, Any]]) -> None:
348         """Inject a cache point at the end of the last user message.
349 
350         Args:
351             messages: List of messages to inject cache point into (modified in place).
352         """
353         if not messages:
354             return
355 
356         last_user_idx: int | None = None
357         for msg_idx, msg in enumerate(messages):
358             content = msg.get("content", [])
359             for block_idx, block in reversed(list(enumerate(content))):
360                 if "cachePoint" in block:
361                     del content[block_idx]
362                     logger.warning(
363                         "msg_idx=<%s>, block_idx=<%s> | stripped existing cache point (auto mode manages cache points)",
364                         msg_idx,
365                         block_idx,
366                     )
367             if msg.get("role") == "user":
368                 last_user_idx = msg_idx
369 
370         if last_user_idx is not None and messages[last_user_idx].get("content"):
371             messages[last_user_idx]["content"].append({"cachePoint": {"type": "default"}})
372             logger.debug("msg_idx=<%s> | added cache point to last user message", last_user_idx)
373 
374     def _find_last_user_text_message_index(self, messages: Messages) -> int | None:
375         """Find the index of the last user message containing text or image content.
376 
377         This is used for guardrail_latest_message to ensure that guardContent wrapping
378         targets the correct message even when toolResult messages follow.
379 
380         Args:
381             messages: List of messages to search
382 
383         Returns:
384             Index of the last user message with text/image content, or None if not found
385         """
386         for idx, msg in reversed(list(enumerate(messages))):
387             if msg["role"] == "user" and any("text" in cb or "image" in cb for cb in msg.get("content", [])):
388                 return idx
389         return None
390 
391     def _format_bedrock_messages(self, messages: Messages) -> list[dict[str, Any]]:
392         """Format messages for Bedrock API compatibility.
393 
394         This function ensures messages conform to Bedrock's expected format by:
395         - Filtering out SDK_UNKNOWN_MEMBER content blocks
396         - Eagerly filtering content blocks to only include Bedrock-supported fields
397         - Ensuring all message content blocks are properly formatted for the Bedrock API
398         - Optionally wrapping the last user message in guardrailConverseContent blocks
399         - Injecting cache points when cache_config is set with strategy="auto"
400 
401         Args:
402             messages: List of messages to format
403 
404         Returns:
405             Messages formatted for Bedrock API compatibility
406 
407         Note:
408             Unlike other APIs that ignore unknown fields, Bedrock only accepts a strict
409             subset of fields for each content block type and throws validation exceptions
410             when presented with unexpected fields. Therefore, we must eagerly filter all
411             content blocks to remove any additional fields before sending to Bedrock.
412             https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ContentBlock.html
413         """
414         cleaned_messages: list[dict[str, Any]] = []
415 
416         filtered_unknown_members = False
417         dropped_deepseek_reasoning_content = False
418 
419         # Pre-compute the index of the last user message containing text or image content.
420         # This ensures guardContent wrapping is maintained across tool execution cycles, where
421         # the final message in the list is a toolResult (role=user) rather than text/image content.
422         last_user_text_idx = None
423         if self.config.get("guardrail_latest_message", False):
424             last_user_text_idx = self._find_last_user_text_message_index(messages)
425 
426         for idx, message in enumerate(messages):
427             cleaned_content: list[dict[str, Any]] = []
428 
429             for content_block in message["content"]:
430                 # Filter out SDK_UNKNOWN_MEMBER content blocks
431                 if "SDK_UNKNOWN_MEMBER" in content_block:
432                     filtered_unknown_members = True
433                     continue
434 
435                 # DeepSeek models have issues with reasoningContent
436                 # TODO: Replace with systematic model configuration registry (https://github.com/strands-agents/sdk-python/issues/780)
437                 if "deepseek" in self.config["model_id"].lower() and "reasoningContent" in content_block:
438                     dropped_deepseek_reasoning_content = True
439                     continue
440 
441                 # Format content blocks for Bedrock API compatibility
442                 formatted_content = self._format_request_message_content(content_block)
443                 if formatted_content is None:
444                     continue
445 
446                 # Wrap text or image content in guardContent if this is the last user text/image message
447                 if idx == last_user_text_idx and ("text" in formatted_content or "image" in formatted_content):
448                     if "text" in formatted_content:
449                         formatted_content = {"guardContent": {"text": {"text": formatted_content["text"]}}}
450                     elif "image" in formatted_content:
451                         formatted_content = {"guardContent": {"image": formatted_content["image"]}}
452 
453                 cleaned_content.append(formatted_content)
454 
455             # Create new message with cleaned content (skip if empty)
456             if cleaned_content:
457                 cleaned_messages.append({"content": cleaned_content, "role": message["role"]})
458 
459         if filtered_unknown_members:
460             logger.warning(
461                 "Filtered out SDK_UNKNOWN_MEMBER content blocks from messages, consider upgrading boto3 version"
462             )
463         if dropped_deepseek_reasoning_content:
464             logger.debug(
465                 "Filtered DeepSeek reasoningContent content blocks from messages - https://api-docs.deepseek.com/guides/reasoning_model#multi-round-conversation"
466             )
467 
468         # Inject cache point into cleaned_messages (not original messages) if cache_config is set
469         cache_config = self.config.get("cache_config")
470         if cache_config:
471             strategy: str | None = cache_config.strategy
472             if strategy == "auto":
473                 strategy = self._cache_strategy
474                 if not strategy:
475                     logger.warning(
476                         "model_id=<%s> | cache_config is enabled but this model does not support automatic caching",
477                         self.config.get("model_id"),
478                     )
479             if strategy == "anthropic":
480                 self._inject_cache_point(cleaned_messages)
481 
482         return cleaned_messages
483 
484     def _should_include_tool_result_status(self) -> bool:
485         """Determine whether to include tool result status based on current config."""
486         include_status = self.config.get("include_tool_result_status", "auto")
487 
488         if include_status is True:
489             return True
490         elif include_status is False:
491             return False
492         else:  # "auto"
493             return any(model in self.config["model_id"] for model in _MODELS_INCLUDE_STATUS)
494 
495     def _handle_location(self, location: SourceLocation) -> dict[str, Any] | None:
496         """Convert location content block to Bedrock format if its an S3Location."""
497         if location["type"] == "s3":
498             s3_location = cast(S3Location, location)
499             formatted_document_s3: dict[str, Any] = {"uri": s3_location["uri"]}
500             if "bucketOwner" in s3_location:
501                 formatted_document_s3["bucketOwner"] = s3_location["bucketOwner"]
502             return {"s3Location": formatted_document_s3}
503         else:
504             logger.warning("Non s3 location sources are not supported by Bedrock | skipping content block")
505             return None
506 
507     def _format_request_message_content(self, content: ContentBlock) -> dict[str, Any] | None:
508         """Format a Bedrock content block.
509 
510         Bedrock strictly validates content blocks and throws exceptions for unknown fields.
511         This function extracts only the fields that Bedrock supports for each content type.
512 
513         Args:
514             content: Content block to format.
515 
516         Returns:
517             Bedrock formatted content block.
518 
519         Raises:
520             TypeError: If the content block type is not supported by Bedrock.
521         """
522         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_CachePointBlock.html
523         if "cachePoint" in content:
524             return {"cachePoint": {"type": content["cachePoint"]["type"]}}
525 
526         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_DocumentBlock.html
527         if "document" in content:
528             document = content["document"]
529             result: dict[str, Any] = {}
530 
531             # Handle required fields (all optional due to total=False)
532             if "name" in document:
533                 result["name"] = document["name"]
534             if "format" in document:
535                 result["format"] = document["format"]
536 
537             # Handle source - supports bytes or location
538             if "source" in document:
539                 source = document["source"]
540                 formatted_document_source: dict[str, Any] | None
541                 if "location" in source:
542                     formatted_document_source = self._handle_location(source["location"])
543                     if formatted_document_source is None:
544                         return None
545                 elif "bytes" in source:
546                     formatted_document_source = {"bytes": source["bytes"]}
547                 result["source"] = formatted_document_source
548 
549             # Handle optional fields
550             if "citations" in document and document["citations"] is not None:
551                 result["citations"] = {"enabled": document["citations"]["enabled"]}
552             if "context" in document:
553                 result["context"] = document["context"]
554 
555             return {"document": result}
556 
557         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_GuardrailConverseContentBlock.html
558         if "guardContent" in content:
559             guard = content["guardContent"]
560             guard_text = guard["text"]
561             result = {"text": {"text": guard_text["text"], "qualifiers": guard_text["qualifiers"]}}
562             return {"guardContent": result}
563 
564         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ImageBlock.html
565         if "image" in content:
566             image = content["image"]
567             source = image["source"]
568             formatted_image_source: dict[str, Any] | None
569             if "location" in source:
570                 formatted_image_source = self._handle_location(source["location"])
571                 if formatted_image_source is None:
572                     return None
573             elif "bytes" in source:
574                 formatted_image_source = {"bytes": source["bytes"]}
575             result = {"format": image["format"], "source": formatted_image_source}
576             return {"image": result}
577 
578         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ReasoningContentBlock.html
579         if "reasoningContent" in content:
580             reasoning = content["reasoningContent"]
581             result = {}
582 
583             if "reasoningText" in reasoning:
584                 reasoning_text = reasoning["reasoningText"]
585                 result["reasoningText"] = {}
586                 if "text" in reasoning_text:
587                     result["reasoningText"]["text"] = reasoning_text["text"]
588                 # Only include signature if truthy (avoid empty strings)
589                 if reasoning_text.get("signature"):
590                     result["reasoningText"]["signature"] = reasoning_text["signature"]
591 
592             if "redactedContent" in reasoning:
593                 result["redactedContent"] = reasoning["redactedContent"]
594 
595             return {"reasoningContent": result}
596 
597         # Pass through text and other simple content types
598         if "text" in content:
599             return {"text": content["text"]}
600 
601         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolResultBlock.html
602         if "toolResult" in content:
603             tool_result = content["toolResult"]
604             # Normalize empty toolResult content arrays.
605             # Some model providers (e.g., Nemotron) reject toolResult blocks with
606             # content: [] via the Converse API, while others (e.g., Claude) accept
607             # them. Replace empty content with a minimal text block to ensure
608             # cross-model compatibility. This follows the same pattern as the
609             # TypeScript SDK's _formatMessages in bedrock.ts.
610             tool_result_content_list = tool_result.get("content") or [{"text": ""}]
611             formatted_content: list[dict[str, Any]] = []
612             for tool_result_content in tool_result_content_list:
613                 if "json" in tool_result_content:
614                     # Handle json field since not in ContentBlock but valid in ToolResultContent
615                     formatted_content.append({"json": tool_result_content["json"]})
616                 else:
617                     formatted_message_content = self._format_request_message_content(
618                         cast(ContentBlock, tool_result_content)
619                     )
620                     if formatted_message_content is None:
621                         continue
622                     formatted_content.append(formatted_message_content)
623 
624             result = {
625                 "content": formatted_content,
626                 "toolUseId": tool_result["toolUseId"],
627             }
628             if "status" in tool_result and self._should_include_tool_result_status():
629                 result["status"] = tool_result["status"]
630             return {"toolResult": result}
631 
632         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolUseBlock.html
633         if "toolUse" in content:
634             tool_use = content["toolUse"]
635             return {
636                 "toolUse": {
637                     "input": tool_use["input"],
638                     "name": tool_use["name"],
639                     "toolUseId": tool_use["toolUseId"],
640                 }
641             }
642 
643         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_VideoBlock.html
644         if "video" in content:
645             video = content["video"]
646             source = video["source"]
647             formatted_video_source: dict[str, Any] | None
648             if "location" in source:
649                 formatted_video_source = self._handle_location(source["location"])
650                 if formatted_video_source is None:
651                     return None
652             elif "bytes" in source:
653                 formatted_video_source = {"bytes": source["bytes"]}
654             result = {"format": video["format"], "source": formatted_video_source}
655             return {"video": result}
656 
657         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_CitationsContentBlock.html
658         if "citationsContent" in content:
659             citations = content["citationsContent"]
660             result = {}
661 
662             if "citations" in citations:
663                 result["citations"] = []
664                 for citation in citations["citations"]:
665                     filtered_citation: dict[str, Any] = {}
666                     if "location" in citation:
667                         filtered_citation["location"] = citation["location"]
668                     if "sourceContent" in citation:
669                         filtered_source_content: list[dict[str, Any]] = []
670                         for source_content in citation["sourceContent"]:
671                             if "text" in source_content:
672                                 filtered_source_content.append({"text": source_content["text"]})
673                         if filtered_source_content:
674                             filtered_citation["sourceContent"] = filtered_source_content
675                     if "title" in citation:
676                         filtered_citation["title"] = citation["title"]
677                     result["citations"].append(filtered_citation)
678 
679             if "content" in citations:
680                 filtered_content: list[dict[str, Any]] = []
681                 for generated_content in citations["content"]:
682                     if "text" in generated_content:
683                         filtered_content.append({"text": generated_content["text"]})
684                 if filtered_content:
685                     result["content"] = filtered_content
686 
687             return {"citationsContent": result}
688 
689         raise TypeError(f"content_type=<{next(iter(content))}> | unsupported type")
690 
691     def _has_blocked_guardrail(self, guardrail_data: dict[str, Any]) -> bool:
692         """Check if guardrail data contains any blocked policies.
693 
694         Args:
695             guardrail_data: Guardrail data from trace information.
696 
697         Returns:
698             True if any blocked guardrail is detected, False otherwise.
699         """
700         input_assessment = guardrail_data.get("inputAssessment", {})
701         output_assessments = guardrail_data.get("outputAssessments", {})
702 
703         # Check input assessments
704         if any(self._find_detected_and_blocked_policy(assessment) for assessment in input_assessment.values()):
705             return True
706 
707         # Check output assessments
708         if any(self._find_detected_and_blocked_policy(assessment) for assessment in output_assessments.values()):
709             return True
710 
711         return False
712 
713     def _generate_redaction_events(self) -> list[StreamEvent]:
714         """Generate redaction events based on configuration.
715 
716         Returns:
717             List of redaction events to yield.
718         """
719         events: list[StreamEvent] = []
720 
721         if self.config.get("guardrail_redact_input", True):
722             logger.debug("Redacting user input due to guardrail.")
723             events.append(
724                 {
725                     "redactContent": {
726                         "redactUserContentMessage": self.config.get(
727                             "guardrail_redact_input_message", "[User input redacted.]"
728                         )
729                     }
730                 }
731             )
732 
733         if self.config.get("guardrail_redact_output", False):
734             logger.debug("Redacting assistant output due to guardrail.")
735             events.append(
736                 {
737                     "redactContent": {
738                         "redactAssistantContentMessage": self.config.get(
739                             "guardrail_redact_output_message",
740                             "[Assistant output redacted.]",
741                         )
742                     }
743                 }
744             )
745 
746         return events
747 
748     @override
749     async def stream(
750         self,
751         messages: Messages,
752         tool_specs: list[ToolSpec] | None = None,
753         system_prompt: str | None = None,
754         *,
755         tool_choice: ToolChoice | None = None,
756         system_prompt_content: list[SystemContentBlock] | None = None,
757         **kwargs: Any,
758     ) -> AsyncGenerator[StreamEvent, None]:
759         """Stream conversation with the Bedrock model.
760 
761         This method calls either the Bedrock converse_stream API or the converse API
762         based on the streaming parameter in the configuration.
763 
764         Args:
765             messages: List of message objects to be processed by the model.
766             tool_specs: List of tool specifications to make available to the model.
767             system_prompt: System prompt to provide context to the model.
768             tool_choice: Selection strategy for tool invocation.
769             system_prompt_content: System prompt content blocks to provide context to the model.
770             **kwargs: Additional keyword arguments for future extensibility.
771 
772         Yields:
773             Model events.
774 
775         Raises:
776             ContextWindowOverflowException: If the input exceeds the model's context window.
777             ModelThrottledException: If the model service is throttling requests.
778         """
779 
780         def callback(event: StreamEvent | None = None) -> None:
781             loop.call_soon_threadsafe(queue.put_nowait, event)
782             if event is None:
783                 return
784 
785         loop = asyncio.get_event_loop()
786         queue: asyncio.Queue[StreamEvent | None] = asyncio.Queue()
787 
788         # Handle backward compatibility: if system_prompt is provided but system_prompt_content is None
789         if system_prompt and system_prompt_content is None:
790             system_prompt_content = [{"text": system_prompt}]
791 
792         thread = asyncio.to_thread(self._stream, callback, messages, tool_specs, system_prompt_content, tool_choice)
793         task = asyncio.create_task(thread)
794 
795         while True:
796             event = await queue.get()
797             if event is None:
798                 break
799 
800             yield event
801 
802         await task
803 
804     def _stream(
805         self,
806         callback: Callable[..., None],
807         messages: Messages,
808         tool_specs: list[ToolSpec] | None = None,
809         system_prompt_content: list[SystemContentBlock] | None = None,
810         tool_choice: ToolChoice | None = None,
811     ) -> None:
812         """Stream conversation with the Bedrock model.
813 
814         This method operates in a separate thread to avoid blocking the async event loop with the call to
815         Bedrock's converse_stream.
816 
817         Args:
818             callback: Function to send events to the main thread.
819             messages: List of message objects to be processed by the model.
820             tool_specs: List of tool specifications to make available to the model.
821             system_prompt_content: System prompt content blocks to provide context to the model.
822             tool_choice: Selection strategy for tool invocation.
823 
824         Raises:
825             ContextWindowOverflowException: If the input exceeds the model's context window.
826             ModelThrottledException: If the model service is throttling requests.
827         """
828         try:
829             logger.debug("formatting request")
830             request = self._format_request(messages, tool_specs, system_prompt_content, tool_choice)
831             logger.debug("request=<%s>", request)
832 
833             logger.debug("invoking model")
834             streaming = self.config.get("streaming", True)
835 
836             logger.debug("got response from model")
837             if streaming:
838                 response = self.client.converse_stream(**request)
839                 for chunk in response["stream"]:
840                     if (
841                         "metadata" in chunk
842                         and "trace" in chunk["metadata"]
843                         and "guardrail" in chunk["metadata"]["trace"]
844                     ):
845                         guardrail_data = chunk["metadata"]["trace"]["guardrail"]
846                         if self._has_blocked_guardrail(guardrail_data):
847                             for event in self._generate_redaction_events():
848                                 callback(event)
849 
850                     callback(chunk)
851 
852             else:
853                 response = self.client.converse(**request)
854                 for event in self._convert_non_streaming_to_streaming(response):
855                     callback(event)
856 
857                 if (
858                     "trace" in response
859                     and "guardrail" in response["trace"]
860                     and self._has_blocked_guardrail(response["trace"]["guardrail"])
861                 ):
862                     for event in self._generate_redaction_events():
863                         callback(event)
864 
865         except ClientError as e:
866             error_message = str(e)
867 
868             if (
869                 e.response["Error"]["Code"] == "ThrottlingException"
870                 or e.response["Error"]["Code"] == "throttlingException"
871             ):
872                 raise ModelThrottledException(error_message) from e
873 
874             if any(overflow_message in error_message for overflow_message in BEDROCK_CONTEXT_WINDOW_OVERFLOW_MESSAGES):
875                 logger.warning("bedrock threw context window overflow error")
876                 raise ContextWindowOverflowException(e) from e
877 
878             region = self.client.meta.region_name
879 
880             # Aid in debugging by adding more information
881             add_exception_note(e, f"└ Bedrock region: {region}")
882             add_exception_note(e, f"└ Model id: {self.config.get('model_id')}")
883 
884             if (
885                 e.response["Error"]["Code"] == "AccessDeniedException"
886                 and "You don't have access to the model" in error_message
887             ):
888                 add_exception_note(
889                     e,
890                     "└ For more information see "
891                     "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#model-access-issue",
892                 )
893 
894             if (
895                 e.response["Error"]["Code"] == "ValidationException"
896                 and "with on-demand throughput isn’t supported" in error_message
897             ):
898                 add_exception_note(
899                     e,
900                     "└ For more information see "
901                     "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#on-demand-throughput-isnt-supported",
902                 )
903 
904             raise e
905 
906         finally:
907             callback()
908             logger.debug("finished streaming response from model")
909 
910     def _convert_non_streaming_to_streaming(self, response: dict[str, Any]) -> Iterable[StreamEvent]:
911         """Convert a non-streaming response to the streaming format.
912 
913         Args:
914             response: The non-streaming response from the Bedrock model.
915 
916         Returns:
917             An iterable of response events in the streaming format.
918         """
919         # Yield messageStart event
920         yield {"messageStart": {"role": response["output"]["message"]["role"]}}
921 
922         # Process content blocks
923         for content in cast(list[ContentBlock], response["output"]["message"]["content"]):
924             # Yield contentBlockStart event if needed
925             if "toolUse" in content:
926                 yield {
927                     "contentBlockStart": {
928                         "start": {
929                             "toolUse": {
930                                 "toolUseId": content["toolUse"]["toolUseId"],
931                                 "name": content["toolUse"]["name"],
932                             }
933                         },
934                     }
935                 }
936 
937                 # For tool use, we need to yield the input as a delta
938                 input_value = json.dumps(content["toolUse"]["input"])
939 
940                 yield {"contentBlockDelta": {"delta": {"toolUse": {"input": input_value}}}}
941             elif "text" in content:
942                 # Then yield the text as a delta
943                 yield {
944                     "contentBlockDelta": {
945                         "delta": {"text": content["text"]},
946                     }
947                 }
948             elif "reasoningContent" in content:
949                 # Then yield the reasoning content as a delta
950                 yield {
951                     "contentBlockDelta": {
952                         "delta": {"reasoningContent": {"text": content["reasoningContent"]["reasoningText"]["text"]}}
953                     }
954                 }
955 
956                 if "signature" in content["reasoningContent"]["reasoningText"]:
957                     yield {
958                         "contentBlockDelta": {
959                             "delta": {
960                                 "reasoningContent": {
961                                     "signature": content["reasoningContent"]["reasoningText"]["signature"]
962                                 }
963                             }
964                         }
965                     }
966             elif "citationsContent" in content:
967                 # For non-streaming citations, emit text and metadata deltas in sequence
968                 # to match streaming behavior where they flow naturally
969                 if "content" in content["citationsContent"]:
970                     text_content = "".join([content["text"] for content in content["citationsContent"]["content"]])
971                     yield {
972                         "contentBlockDelta": {"delta": {"text": text_content}},
973                     }
974 
975                 for citation in content["citationsContent"]["citations"]:
976                     # Emit citation metadata, only including fields that are present
977                     # Nova grounding may omit title/sourceContent
978                     citation_metadata: CitationsDelta = {}
979                     if "title" in citation:
980                         citation_metadata["title"] = citation["title"]
981                     if "location" in citation:
982                         citation_metadata["location"] = citation["location"]
983                     if "sourceContent" in citation:
984                         citation_metadata["sourceContent"] = citation["sourceContent"]
985                     yield {"contentBlockDelta": {"delta": {"citation": citation_metadata}}}
986 
987             # Yield contentBlockStop event
988             yield {"contentBlockStop": {}}
989 
990         # Yield messageStop event
991         yield {
992             "messageStop": {
993                 "stopReason": response["stopReason"],
994                 "additionalModelResponseFields": response.get("additionalModelResponseFields"),
995             }
996         }
997 
998         # Yield metadata event
999         if "usage" in response or "metrics" in response or "trace" in response:
1000             metadata: StreamEvent = {"metadata": {}}
1001             if "usage" in response:
1002                 metadata["metadata"]["usage"] = response["usage"]
1003             if "metrics" in response:
1004                 metadata["metadata"]["metrics"] = response["metrics"]
1005             if "trace" in response:
1006                 metadata["metadata"]["trace"] = response["trace"]
1007             yield metadata
1008 
1009     def _find_detected_and_blocked_policy(self, input: Any) -> bool:
1010         """Recursively checks if the assessment contains a detected and blocked guardrail.
1011 
1012         Args:
1013             input: The assessment to check.
1014 
1015         Returns:
1016             True if the input contains a detected and blocked guardrail, False otherwise.
1017 
1018         """
1019         # Check if input is a dictionary
1020         if isinstance(input, dict):
1021             # Check if current dictionary has action: BLOCKED and detected: true
1022             if input.get("action") == "BLOCKED" and input.get("detected") and isinstance(input.get("detected"), bool):
1023                 return True
1024 
1025             # Otherwise, recursively check all values in the dictionary
1026             return self._find_detected_and_blocked_policy(input.values())
1027 
1028         elif isinstance(input, (list, ValuesView)):
1029             # Handle case where input is a list or dict_values
1030             return any(self._find_detected_and_blocked_policy(item) for item in input)
1031         # Otherwise return False
1032         return False
1033 
1034     @override
1035     async def structured_output(
1036         self,
1037         output_model: type[T],
1038         prompt: Messages,
1039         system_prompt: str | None = None,
1040         **kwargs: Any,
1041     ) -> AsyncGenerator[dict[str, T | Any], None]:
1042         """Get structured output from the model.
1043 
1044         Args:
1045             output_model: The output model to use for the agent.
1046             prompt: The prompt messages to use for the agent.
1047             system_prompt: System prompt to provide context to the model.
1048             **kwargs: Additional keyword arguments for future extensibility.
1049 
1050         Yields:
1051             Model events with the last being the structured output.
1052         """
1053         tool_spec = convert_pydantic_to_tool_spec(output_model)
1054 
1055         response = self.stream(
1056             messages=prompt,
1057             tool_specs=[tool_spec],
1058             system_prompt=system_prompt,
1059             tool_choice=cast(ToolChoice, {"any": {}}),
1060             **kwargs,
1061         )
1062         async for event in streaming.process_stream(response):
1063             yield event
1064 
1065         stop_reason, messages, _, _ = event["stop"]
1066 
1067         if stop_reason != "tool_use":
1068             raise ValueError(f'Model returned stop_reason: {stop_reason} instead of "tool_use".')
1069 
1070         content = messages["content"]
1071         output_response: dict[str, Any] | None = None
1072         for block in content:
1073             # if the tool use name doesn't match the tool spec name, skip, and if the block is not a tool use, skip.
1074             # if the tool use name never matches, raise an error.
1075             if block.get("toolUse") and block["toolUse"]["name"] == tool_spec["name"]:
1076                 output_response = block["toolUse"]["input"]
1077             else:
1078                 continue
1079 
1080         if output_response is None:
1081             raise ValueError("No valid tool use or tool use input was found in the Bedrock response.")
1082 
1083         yield {"output": output_model(**output_response)}
1084 
1085     @staticmethod
1086     def _get_default_model_with_warning(region_name: str, model_config: BedrockConfig | None = None) -> str:
1087         """Get the default Bedrock modelId based on region.
1088 
1089         If the region is not **known** to support inference then we show a helpful warning
1090         that compliments the exception that Bedrock will throw.
1091         If the customer provided a model_id in their config or they overrode the `DEFAULT_BEDROCK_MODEL_ID`
1092         then we should not process further.
1093 
1094         Args:
1095             region_name (str): region for bedrock model
1096             model_config (Optional[dict[str, Any]]): Model Config that caller passes in on init
1097         """
1098         if DEFAULT_BEDROCK_MODEL_ID != _DEFAULT_BEDROCK_MODEL_ID.format("us"):
1099             return DEFAULT_BEDROCK_MODEL_ID
1100 
1101         model_config = model_config or {}
1102         if model_config.get("model_id"):
1103             return model_config["model_id"]
1104 
1105         prefix_inference_map = {"ap": "apac"}  # some inference endpoints can be a bit different than the region prefix
1106 
1107         prefix = "-".join(region_name.split("-")[:-2]).lower()  # handles `us-east-1` or `us-gov-east-1`
1108         if prefix not in {"us", "eu", "ap", "us-gov"}:
1109             warnings.warn(
1110                 f"""
1111             ================== WARNING ==================
1112 
1113                 This region {region_name} does not support
1114                 our default inference endpoint: {_DEFAULT_BEDROCK_MODEL_ID.format(prefix)}.
1115                 Update the agent to pass in a 'model_id' like so:
1116                 ```
1117                 Agent(..., model='valid_model_id', ...)
1118                 ````
1119                 Documentation: https://docs.aws.amazon.com/bedrock/latest/userguide/inference-profiles-support.html
1120 
1121             ==================================================
1122             """,
1123                 stacklevel=2,
1124             )
1125 
1126         return _DEFAULT_BEDROCK_MODEL_ID.format(prefix_inference_map.get(prefix, prefix))

