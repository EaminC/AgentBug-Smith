748     @override
749     async def stream(
750         self,
751         messages: Messages,
752         tool_specs: list[ToolSpec] | None = None,
753         system_prompt: str | None = None,
754         *,
755         tool_choice: ToolChoice | None = None,
756         system_prompt_content: list[SystemContentBlock] | None = None,
757         **kwargs: Any,
758     ) -> AsyncGenerator[StreamEvent, None]:
759         """Stream conversation with the Bedrock model.
760 
761         This method calls either the Bedrock converse_stream API or the converse API
762         based on the streaming parameter in the configuration.
763 
764         Args:
765             messages: List of message objects to be processed by the model.
766             tool_specs: List of tool specifications to make available to the model.
767             system_prompt: System prompt to provide context to the model.
768             tool_choice: Selection strategy for tool invocation.
769             system_prompt_content: System prompt content blocks to provide context to the model.
770             **kwargs: Additional keyword arguments for future extensibility.
771 
772         Yields:
773             Model events.
774 
775         Raises:
776             ContextWindowOverflowException: If the input exceeds the model's context window.
777             ModelThrottledException: If the model service is throttling requests.
778         """
779 
780         def callback(event: StreamEvent | None = None) -> None:
781             loop.call_soon_threadsafe(queue.put_nowait, event)
782             if event is None:
783                 return
784 
785         loop = asyncio.get_event_loop()
786         queue: asyncio.Queue[StreamEvent | None] = asyncio.Queue()
787 
788         # Handle backward compatibility: if system_prompt is provided but system_prompt_content is None
789         if system_prompt and system_prompt_content is None:
790             system_prompt_content = [{"text": system_prompt}]
791 
792         thread = asyncio.to_thread(self._stream, callback, messages, tool_specs, system_prompt_content, tool_choice)
793         task = asyncio.create_task(thread)
794 
795         while True:
796             event = await queue.get()
797             if event is None:
798                 break
799 
800             yield event
801 
802         await task
803 
804     def _stream(
805         self,
806         callback: Callable[..., None],
807         messages: Messages,
808         tool_specs: list[ToolSpec] | None = None,
809         system_prompt_content: list[SystemContentBlock] | None = None,
810         tool_choice: ToolChoice | None = None,
811     ) -> None:
812         """Stream conversation with the Bedrock model.
813 
814         This method operates in a separate thread to avoid blocking the async event loop with the call to
815         Bedrock's converse_stream.
816 
817         Args:
818             callback: Function to send events to the main thread.
819             messages: List of message objects to be processed by the model.
820             tool_specs: List of tool specifications to make available to the model.
821             system_prompt_content: System prompt content blocks to provide context to the model.
822             tool_choice: Selection strategy for tool invocation.
823 
824         Raises:
825             ContextWindowOverflowException: If the input exceeds the model's context window.
826             ModelThrottledException: If the model service is throttling requests.
827         """
828         try:
829             logger.debug("formatting request")
830             request = self._format_request(messages, tool_specs, system_prompt_content, tool_choice)
831             logger.debug("request=<%s>", request)
832 
833             logger.debug("invoking model")
834             streaming = self.config.get("streaming", True)
835 
836             logger.debug("got response from model")
837             if streaming:
838                 response = self.client.converse_stream(**request)
839                 for chunk in response["stream"]:
840                     if (
841                         "metadata" in chunk
842                         and "trace" in chunk["metadata"]
843                         and "guardrail" in chunk["metadata"]["trace"]
844                     ):
845                         guardrail_data = chunk["metadata"]["trace"]["guardrail"]
846                         if self._has_blocked_guardrail(guardrail_data):
847                             for event in self._generate_redaction_events():
848                                 callback(event)
849 
850                     callback(chunk)
851 
852             else:
853                 response = self.client.converse(**request)
854                 for event in self._convert_non_streaming_to_streaming(response):
855                     callback(event)
856 
857                 if (
858                     "trace" in response
859                     and "guardrail" in response["trace"]
860                     and self._has_blocked_guardrail(response["trace"]["guardrail"])
861                 ):
862                     for event in self._generate_redaction_events():
863                         callback(event)
864 
865         except ClientError as e:
866             error_message = str(e)
867 
868             if (
869                 e.response["Error"]["Code"] == "ThrottlingException"
870                 or e.response["Error"]["Code"] == "throttlingException"
871             ):
872                 raise ModelThrottledException(error_message) from e
873 
874             if any(overflow_message in error_message for overflow_message in BEDROCK_CONTEXT_WINDOW_OVERFLOW_MESSAGES):
875                 logger.warning("bedrock threw context window overflow error")
876                 raise ContextWindowOverflowException(e) from e
877 
878             region = self.client.meta.region_name
879 
880             # Aid in debugging by adding more information
881             add_exception_note(e, f"└ Bedrock region: {region}")
882             add_exception_note(e, f"└ Model id: {self.config.get('model_id')}")
883 
884             if (
885                 e.response["Error"]["Code"] == "AccessDeniedException"
886                 and "You don't have access to the model" in error_message
887             ):
888                 add_exception_note(
889                     e,
890                     "└ For more information see "
891                     "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#model-access-issue",
892                 )
893 
894             if (
895                 e.response["Error"]["Code"] == "ValidationException"
896                 and "with on-demand throughput isn’t supported" in error_message
897             ):
898                 add_exception_note(
899                     e,
900                     "└ For more information see "
901                     "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#on-demand-throughput-isnt-supported",
902                 )
903 
904             raise e
905 
906         finally:
907             callback()
908             logger.debug("finished streaming response from model")
909 
910     def _convert_non_streaming_to_streaming(self, response: dict[str, Any]) -> Iterable[StreamEvent]:
911         """Convert a non-streaming response to the streaming format.
912 
913         Args:
914             response: The non-streaming response from the Bedrock model.
915 
916         Returns:
917             An iterable of response events in the streaming format.
918         """
919         # Yield messageStart event
920         yield {"messageStart": {"role": response["output"]["message"]["role"]}}
921 
922         # Process content blocks
923         for content in cast(list[ContentBlock], response["output"]["message"]["content"]):
924             # Yield contentBlockStart event if needed
925             if "toolUse" in content:
926                 yield {
927                     "contentBlockStart": {
928                         "start": {
929                             "toolUse": {
930                                 "toolUseId": content["toolUse"]["toolUseId"],
931                                 "name": content["toolUse"]["name"],
932                             }
933                         },
934                     }
935                 }
936 
937                 # For tool use, we need to yield the input as a delta
938                 input_value = json.dumps(content["toolUse"]["input"])
939 
940                 yield {"contentBlockDelta": {"delta": {"toolUse": {"input": input_value}}}}
941             elif "text" in content:
942                 # Then yield the text as a delta
943                 yield {
944                     "contentBlockDelta": {
945                         "delta": {"text": content["text"]},
946                     }
947                 }
948             elif "reasoningContent" in content:
949                 # Then yield the reasoning content as a delta
950                 yield {
951                     "contentBlockDelta": {
952                         "delta": {"reasoningContent": {"text": content["reasoningContent"]["reasoningText"]["text"]}}
953                     }
954                 }
955 
956                 if "signature" in content["reasoningContent"]["reasoningText"]:
957                     yield {
958                         "contentBlockDelta": {
959                             "delta": {
960                                 "reasoningContent": {
961                                     "signature": content["reasoningContent"]["reasoningText"]["signature"]
962                                 }
963                             }
964                         }
965                     }
966             elif "citationsContent" in content:
967                 # For non-streaming citations, emit text and metadata deltas in sequence
968                 # to match streaming behavior where they flow naturally
969                 if "content" in content["citationsContent"]:
970                     text_content = "".join([content["text"] for content in content["citationsContent"]["content"]])
971                     yield {
972                         "contentBlockDelta": {"delta": {"text": text_content}},
973                     }
974 
975                 for citation in content["citationsContent"]["citations"]:
976                     # Emit citation metadata, only including fields that are present
977                     # Nova grounding may omit title/sourceContent
978                     citation_metadata: CitationsDelta = {}
979                     if "title" in citation:
980                         citation_metadata["title"] = citation["title"]
981                     if "location" in citation:
982                         citation_metadata["location"] = citation["location"]
983                     if "sourceContent" in citation:
984                         citation_metadata["sourceContent"] = citation["sourceContent"]
985                     yield {"contentBlockDelta": {"delta": {"citation": citation_metadata}}}
986 
987             # Yield contentBlockStop event
988             yield {"contentBlockStop": {}}
989 
990         # Yield messageStop event
991         yield {
992             "messageStop": {
993                 "stopReason": response["stopReason"],
994                 "additionalModelResponseFields": response.get("additionalModelResponseFields"),
995             }
996         }
997 
998         # Yield metadata event
999         if "usage" in response or "metrics" in response or "trace" in response:
1000             metadata: StreamEvent = {"metadata": {}}
1001             if "usage" in response:
1002                 metadata["metadata"]["usage"] = response["usage"]
1003             if "metrics" in response:
1004                 metadata["metadata"]["metrics"] = response["metrics"]
1005             if "trace" in response:
1006                 metadata["metadata"]["trace"] = response["trace"]
1007             yield metadata
1008 
1009     def _find_detected_and_blocked_policy(self, input: Any) -> bool:
1010         """Recursively checks if the assessment contains a detected and blocked guardrail.
1011 
1012         Args:
1013             input: The assessment to check.
1014 
1015         Returns:
1016             True if the input contains a detected and blocked guardrail, False otherwise.
1017 
1018         """
1019         # Check if input is a dictionary
1020         if isinstance(input, dict):
1021             # Check if current dictionary has action: BLOCKED and detected: true
1022             if input.get("action") == "BLOCKED" and input.get("detected") and isinstance(input.get("detected"), bool):
1023                 return True
1024 
1025             # Otherwise, recursively check all values in the dictionary
1026             return self._find_detected_and_blocked_policy(input.values())
1027 
1028         elif isinstance(input, (list, ValuesView)):
1029             # Handle case where input is a list or dict_values
1030             return any(self._find_detected_and_blocked_policy(item) for item in input)
1031         # Otherwise return False
1032         return False
1033 
1034     @override
1035     async def structured_output(
1036         self,
1037         output_model: type[T],
1038         prompt: Messages,
1039         system_prompt: str | None = None,
1040         **kwargs: Any,
1041     ) -> AsyncGenerator[dict[str, T | Any], None]:
1042         """Get structured output from the model.
1043 
1044         Args:
1045             output_model: The output model to use for the agent.
1046             prompt: The prompt messages to use for the agent.
1047             system_prompt: System prompt to provide context to the model.
1048             **kwargs: Additional keyword arguments for future extensibility.
1049 
1050         Yields:
1051             Model events with the last being the structured output.
1052         """
1053         tool_spec = convert_pydantic_to_tool_spec(output_model)
1054 
1055         response = self.stream(
1056             messages=prompt,
1057             tool_specs=[tool_spec],
1058             system_prompt=system_prompt,
1059             tool_choice=cast(ToolChoice, {"any": {}}),
1060             **kwargs,
1061         )
1062         async for event in streaming.process_stream(response):
1063             yield event
1064 
1065         stop_reason, messages, _, _ = event["stop"]
1066 
1067         if stop_reason != "tool_use":
1068             raise ValueError(f'Model returned stop_reason: {stop_reason} instead of "tool_use".')
1069 
1070         content = messages["content"]
1071         output_response: dict[str, Any] | None = None
1072         for block in content:
1073             # if the tool use name doesn't match the tool spec name, skip, and if the block is not a tool use, skip.
1074             # if the tool use name never matches, raise an error.
1075             if block.get("toolUse") and block["toolUse"]["name"] == tool_spec["name"]:
1076                 output_response = block["toolUse"]["input"]
1077             else:
1078                 continue
1079 
1080         if output_response is None:
1081             raise ValueError("No valid tool use or tool use input was found in the Bedrock response.")
1082 
1083         yield {"output": output_model(**output_response)}
1084 
1085     @staticmethod
1086     def _get_default_model_with_warning(region_name: str, model_config: BedrockConfig | None = None) -> str:
1087         """Get the default Bedrock modelId based on region.
1088 
1089         If the region is not **known** to support inference then we show a helpful warning
1090         that compliments the exception that Bedrock will throw.
1091         If the customer provided a model_id in their config or they overrode the `DEFAULT_BEDROCK_MODEL_ID`
1092         then we should not process further.
1093 
1094         Args:
1095             region_name (str): region for bedrock model
1096             model_config (Optional[dict[str, Any]]): Model Config that caller passes in on init
1097         """
1098         if DEFAULT_BEDROCK_MODEL_ID != _DEFAULT_BEDROCK_MODEL_ID.format("us"):
1099             return DEFAULT_BEDROCK_MODEL_ID
1100 
1101         model_config = model_config or {}
1102         if model_config.get("model_id"):
1103             return model_config["model_id"]
1104 
1105         prefix_inference_map = {"ap": "apac"}  # some inference endpoints can be a bit different than the region prefix
1106 
1107         prefix = "-".join(region_name.split("-")[:-2]).lower()  # handles `us-east-1` or `us-gov-east-1`
1108         if prefix not in {"us", "eu", "ap", "us-gov"}:
1109             warnings.warn(
1110                 f"""
1111             ================== WARNING ==================
1112 
1113                 This region {region_name} does not support
1114                 our default inference endpoint: {_DEFAULT_BEDROCK_MODEL_ID.format(prefix)}.
1115                 Update the agent to pass in a 'model_id' like so:
1116                 ```
1117                 Agent(..., model='valid_model_id', ...)
1118                 ````
1119                 Documentation: https://docs.aws.amazon.com/bedrock/latest/userguide/inference-profiles-support.html
1120 
1121             ==================================================
1122             """,
1123                 stacklevel=2,
1124             )
1125 
1126         return _DEFAULT_BEDROCK_MODEL_ID.format(prefix_inference_map.get(prefix, prefix))

