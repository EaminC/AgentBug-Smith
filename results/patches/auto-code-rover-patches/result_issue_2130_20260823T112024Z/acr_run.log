91                 Defaults to False.
92             max_tokens: Maximum number of tokens to generate in the response
93             model_id: The Bedrock model ID (e.g., "us.anthropic.claude-sonnet-4-20250514-v1:0")
94             include_tool_result_status: Flag to include status field in tool results.
95                 True includes status, False removes status, "auto" determines based on model_id. Defaults to "auto".
96             service_tier: Service tier for the request, controlling the trade-off between latency and cost.
97                 Valid values: "default" (standard), "priority" (faster, premium), "flex" (cheaper, slower).
98                 Please check https://docs.aws.amazon.com/bedrock/latest/userguide/service-tiers-inference.html for
99                 supported service tiers, models, and regions
100             stop_sequences: List of sequences that will stop generation when encountered
101             streaming: Flag to enable/disable streaming. Defaults to True.
102             temperature: Controls randomness in generation (higher = more random)
103             top_p: Controls diversity via nucleus sampling (alternative to temperature)
104         """
105 
106         additional_args: dict[str, Any] | None
107         additional_request_fields: dict[str, Any] | None
108         additional_response_field_paths: list[str] | None
109         cache_prompt: str | None
110         cache_config: CacheConfig | None
111         cache_tools: str | None
112         guardrail_id: str | None
113         guardrail_trace: Literal["enabled", "disabled", "enabled_full"] | None
114         guardrail_stream_processing_mode: Literal["sync", "async"] | None
115         guardrail_version: str | None
116         guardrail_redact_input: bool | None
117         guardrail_redact_input_message: str | None
118         guardrail_redact_output: bool | None
119         guardrail_redact_output_message: str | None
120         guardrail_latest_message: bool | None
121         max_tokens: int | None
122         model_id: str
123         include_tool_result_status: Literal["auto"] | bool | None
124         service_tier: str | None
125         stop_sequences: list[str] | None
126         streaming: bool | None
127         temperature: float | None
128         top_p: float | None
129 
130     def __init__(
131         self,
132         *,
133         boto_session: boto3.Session | None = None,
134         boto_client_config: BotocoreConfig | None = None,
135         region_name: str | None = None,
136         endpoint_url: str | None = None,
137         **model_config: Unpack[BedrockConfig],
138     ):
139         """Initialize provider instance.
140 
141         Args:
142             boto_session: Boto Session to use when calling the Bedrock Model.
143             boto_client_config: Configuration to use when creating the Bedrock-Runtime Boto Client.
144             region_name: AWS region to use for the Bedrock service.
145                 Defaults to the AWS_REGION environment variable if set, or "us-west-2" if not set.
146             endpoint_url: Custom endpoint URL for VPC endpoints (PrivateLink)
147             **model_config: Configuration options for the Bedrock model.
148         """
149         if region_name and boto_session:
150             raise ValueError("Cannot specify both `region_name` and `boto_session`.")
151 
152         session = boto_session or boto3.Session()
153         resolved_region = region_name or session.region_name or os.environ.get("AWS_REGION") or DEFAULT_BEDROCK_REGION
154         self.config = BedrockModel.BedrockConfig(
155             model_id=BedrockModel._get_default_model_with_warning(resolved_region, model_config),
156             include_tool_result_status="auto",
157         )
158         self.update_config(**model_config)
159 
160         logger.debug("config=<%s> | initializing", self.config)
161 
162         # Add strands-agents to the request user agent
163         if boto_client_config:
164             existing_user_agent = getattr(boto_client_config, "user_agent_extra", None)
165 
166             # Append 'strands-agents' to existing user_agent_extra or set it if not present
167             if existing_user_agent:
168                 new_user_agent = f"{existing_user_agent} strands-agents"
169             else:
170                 new_user_agent = "strands-agents"
171 
172             client_config = boto_client_config.merge(BotocoreConfig(user_agent_extra=new_user_agent))
173         else:
174             client_config = BotocoreConfig(user_agent_extra="strands-agents", read_timeout=DEFAULT_READ_TIMEOUT)
175 
176         self.client = session.client(
177             service_name="bedrock-runtime",
178             config=client_config,
179             endpoint_url=endpoint_url,
180             region_name=resolved_region,
181         )
182 
183         logger.debug("region=<%s> | bedrock client created", self.client.meta.region_name)
184 
185     @property
186     def _cache_strategy(self) -> str | None:
187         """The cache strategy for this model based on its model ID.
188 
189         Returns the appropriate cache strategy name, or None if automatic caching is not supported for this model.
190         """
191         model_id = self.config.get("model_id", "").lower()
192         if "claude" in model_id or "anthropic" in model_id:
193             return "anthropic"
194         return None
195 
196     @override
197     def update_config(self, **model_config: Unpack[BedrockConfig]) -> None:  # type: ignore
198         """Update the Bedrock Model configuration with the provided arguments.
199 
200         Args:
201             **model_config: Configuration overrides.
202         """
203         validate_config_keys(model_config, self.BedrockConfig)
204         self.config.update(model_config)
205 
206     @override
207     def get_config(self) -> BedrockConfig:
208         """Get the current Bedrock Model configuration.
209 
210         Returns:
211             The Bedrock model configuration.
212         """
213         return self.config
