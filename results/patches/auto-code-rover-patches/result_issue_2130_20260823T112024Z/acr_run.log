60 class BedrockModel(Model):
61     """AWS Bedrock model provider implementation.
62 
63     The implementation handles Bedrock-specific features such as:
64 
65     - Tool configuration for function calling
66     - Guardrails integration
67     - Caching points for system prompts and tools
68     - Streaming responses
69     - Context window overflow detection
70     """
71 
72     class BedrockConfig(TypedDict, total=False):
73         """Configuration options for Bedrock models.
74 
75         Attributes:
76             additional_args: Any additional arguments to include in the request
77             additional_request_fields: Additional fields to include in the Bedrock request
78             additional_response_field_paths: Additional response field paths to extract
79             cache_prompt: Cache point type for the system prompt (deprecated, use cache_config)
80             cache_config: Configuration for prompt caching. Use CacheConfig(strategy="auto") for automatic caching.
81             cache_tools: Cache point type for tools
82             guardrail_id: ID of the guardrail to apply
83             guardrail_trace: Guardrail trace mode. Defaults to enabled.
84             guardrail_version: Version of the guardrail to apply
85             guardrail_stream_processing_mode: The guardrail processing mode
86             guardrail_redact_input: Flag to redact input if a guardrail is triggered. Defaults to True.
87             guardrail_redact_input_message: If a Bedrock Input guardrail triggers, replace the input with this message.
88             guardrail_redact_output: Flag to redact output if guardrail is triggered. Defaults to False.
89             guardrail_redact_output_message: If a Bedrock Output guardrail triggers, replace output with this message.
90             guardrail_latest_message: Flag to send only the lastest user message to guardrails.
91                 Defaults to False.
92             max_tokens: Maximum number of tokens to generate in the response
93             model_id: The Bedrock model ID (e.g., "us.anthropic.claude-sonnet-4-20250514-v1:0")
94             include_tool_result_status: Flag to include status field in tool results.
95                 True includes status, False removes status, "auto" determines based on model_id. Defaults to "auto".
96             service_tier: Service tier for the request, controlling the trade-off between latency and cost.
97                 Valid values: "default" (standard), "priority" (faster, premium), "flex" (cheaper, slower).
98                 Please check https://docs.aws.amazon.com/bedrock/latest/userguide/service-tiers-inference.html for
99                 supported service tiers, models, and regions
100             stop_sequences: List of sequences that will stop generation when encountered
101             streaming: Flag to enable/disable streaming. Defaults to True.
102             temperature: Controls randomness in generation (higher = more random)
103             top_p: Controls diversity via nucleus sampling (alternative to temperature)
104         """
105 
106         additional_args: dict[str, Any] | None
107         additional_request_fields: dict[str, Any] | None
108         additional_response_field_paths: list[str] | None
109         cache_prompt: str | None
110         cache_config: CacheConfig | None
111         cache_tools: str | None
112         guardrail_id: str | None
113         guardrail_trace: Literal["enabled", "disabled", "enabled_full"] | None
114         guardrail_stream_processing_mode: Literal["sync", "async"] | None
115         guardrail_version: str | None
116         guardrail_redact_input: bool | None
117         guardrail_redact_input_message: str | None
118         guardrail_redact_output: bool | None
119         guardrail_redact_output_message: str | None
120         guardrail_latest_message: bool | None
121         max_tokens: int | None
122         model_id: str
123         include_tool_result_status: Literal["auto"] | bool | None
124         service_tier: str | None
125         stop_sequences: list[str] | None
126         streaming: bool | None
127         temperature: float | None
