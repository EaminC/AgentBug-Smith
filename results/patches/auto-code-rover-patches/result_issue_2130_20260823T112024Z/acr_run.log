130     def __init__(
131         self,
132         *,
133         boto_session: boto3.Session | None = None,
134         boto_client_config: BotocoreConfig | None = None,
135         region_name: str | None = None,
136         endpoint_url: str | None = None,
137         **model_config: Unpack[BedrockConfig],
138     ):
139         """Initialize provider instance.
140 
141         Args:
142             boto_session: Boto Session to use when calling the Bedrock Model.
143             boto_client_config: Configuration to use when creating the Bedrock-Runtime Boto Client.
144             region_name: AWS region to use for the Bedrock service.
145                 Defaults to the AWS_REGION environment variable if set, or "us-west-2" if not set.
146             endpoint_url: Custom endpoint URL for VPC endpoints (PrivateLink)
147             **model_config: Configuration options for the Bedrock model.
148         """
149         if region_name and boto_session:
150             raise ValueError("Cannot specify both `region_name` and `boto_session`.")
151 
152         session = boto_session or boto3.Session()
153         resolved_region = region_name or session.region_name or os.environ.get("AWS_REGION") or DEFAULT_BEDROCK_REGION
154         self.config = BedrockModel.BedrockConfig(
155             model_id=BedrockModel._get_default_model_with_warning(resolved_region, model_config),
156             include_tool_result_status="auto",
157         )
158         self.update_config(**model_config)
159 
160         logger.debug("config=<%s> | initializing", self.config)
161 
162         # Add strands-agents to the request user agent
163         if boto_client_config:
164             existing_user_agent = getattr(boto_client_config, "user_agent_extra", None)
165 
166             # Append 'strands-agents' to existing user_agent_extra or set it if not present
167             if existing_user_agent:
168                 new_user_agent = f"{existing_user_agent} strands-agents"
169             else:
170                 new_user_agent = "strands-agents"
171 
172             client_config = boto_client_config.merge(BotocoreConfig(user_agent_extra=new_user_agent))
173         else:
174             client_config = BotocoreConfig(user_agent_extra="strands-agents", read_timeout=DEFAULT_READ_TIMEOUT)
175 
176         self.client = session.client(
177             service_name="bedrock-runtime",
178             config=client_config,
179             endpoint_url=endpoint_url,
180             region_name=resolved_region,
181         )
182 
183         logger.debug("region=<%s> | bedrock client created", self.client.meta.region_name)
184 
