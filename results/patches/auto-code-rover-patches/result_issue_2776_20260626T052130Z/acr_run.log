12 class Mem0Storage(Storage):
13     """
14     Extends Storage to handle embedding and searching across entities using Mem0.
15     """
16 
17     def __init__(self, type, crew=None, config=None):
18         super().__init__()
19         supported_types = ["user", "short_term", "long_term", "entities", "external"]
20         if type not in supported_types:
21             raise ValueError(
22                 f"Invalid type '{type}' for Mem0Storage. Must be one of: "
23                 + ", ".join(supported_types)
24             )
25 
26         self.memory_type = type
27         self.crew = crew
28         self.config = config or {}
29         # TODO: Memory config will be removed in the future the config will be passed as a parameter
30         self.memory_config = self.config or getattr(crew, "memory_config", {}) or {}
31 
32         # User ID is required for user memory type "user" since it's used as a unique identifier for the user.
33         user_id = self._get_user_id()
34         if type == "user" and not user_id:
35             raise ValueError("User ID is required for user memory type")
36 
37         # API key in memory config overrides the environment variable
38         config = self._get_config()
39         mem0_api_key = config.get("api_key") or os.getenv("MEM0_API_KEY")
40         mem0_org_id = config.get("org_id")
41         mem0_project_id = config.get("project_id")
42         mem0_local_config = config.get("local_mem0_config")
43 
44         # Initialize MemoryClient or Memory based on the presence of the mem0_api_key
45         if mem0_api_key:
46             if mem0_org_id and mem0_project_id:
47                 self.memory = MemoryClient(
48                     api_key=mem0_api_key, org_id=mem0_org_id, project_id=mem0_project_id
49                 )
50             else:
51                 self.memory = MemoryClient(api_key=mem0_api_key)
52         else:
53             if mem0_local_config and len(mem0_local_config):
54                 self.memory = Memory.from_config(mem0_local_config)
55             else:
56                 self.memory = Memory()
57 
58     def _sanitize_role(self, role: str) -> str:
59         """
60         Sanitizes agent roles to ensure valid directory names.
61         """
62         return role.replace("\n", "").replace(" ", "_").replace("/", "_")
63 
64     def save(self, value: Any, metadata: Dict[str, Any]) -> None:
65         user_id = self._get_user_id()
66         agent_name = self._get_agent_name()
67         assistant_message = [{"role" : "assistant","content" : value}] 
68         params = None
69         if self.memory_type == "short_term":
70             params = {
71                 "agent_id": agent_name,
72                 "infer": False,
73                 "metadata": {"type": "short_term", **metadata},
74             }
75         elif self.memory_type == "long_term":
76             params = {
77                 "agent_id": agent_name,
78                 "infer": False,
79                 "metadata": {"type": "long_term", **metadata},
80             }
81         elif self.memory_type == "entities":
82             params = {
83                 "agent_id": agent_name,
84                 "infer": False,
85                 "metadata": {"type": "entity", **metadata},
86             }
87         elif self.memory_type == "external":
88             params = {
89                 "user_id": user_id,
90                 "agent_id": agent_name,
91                 "metadata": {"type": "external", **metadata},
92             }
93 
94         if params:
95             if isinstance(self.memory, MemoryClient):
96                 params["output_format"] = "v1.1"
97             
98             self.memory.add(assistant_message, **params)
99 
100     def search(
101         self,
102         query: str,
103         limit: int = 3,
104         score_threshold: float = 0.35,
105     ) -> List[Any]:
106         params = {"query": query, "limit": limit, "output_format": "v1.1"}
107         if user_id := self._get_user_id():
108             params["user_id"] = user_id
109 
110         agent_name = self._get_agent_name()
111         if self.memory_type == "short_term":
112             params["agent_id"] = agent_name
113             params["metadata"] = {"type": "short_term"}
114         elif self.memory_type == "long_term":
115             params["agent_id"] = agent_name
116             params["metadata"] = {"type": "long_term"}
117         elif self.memory_type == "entities":
118             params["agent_id"] = agent_name
119             params["metadata"] = {"type": "entity"}
120         elif self.memory_type == "external":
121             params["agent_id"] = agent_name
122             params["metadata"] = {"type": "external"}
123 
124         # Discard the filters for now since we create the filters
125         # automatically when the crew is created.
126         if isinstance(self.memory, Memory):
127             del params["metadata"], params["output_format"]
128             
129         results = self.memory.search(**params)
130         return [r for r in results["results"] if r["score"] >= score_threshold]
131 
132     def _get_user_id(self) -> str:
133         return self._get_config().get("user_id", "")
134 
135     def _get_agent_name(self) -> str:
136         if not self.crew:
137             return ""
138 
139         agents = self.crew.agents
140         agents = [self._sanitize_role(agent.role) for agent in agents]
141         agents = "_".join(agents)
142         return sanitize_collection_name(name=agents,max_collection_length=MAX_AGENT_ID_LENGTH_MEM0)
143 
144     def _get_config(self) -> Dict[str, Any]:
145         return self.config or getattr(self, "memory_config", {}).get("config", {}) or {}
146 
147     def reset(self):
148         if self.memory:
149             self.memory.reset()

