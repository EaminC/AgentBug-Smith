112     def __init__(
113         self,
114         name: str,
115         system_prompt: str,
116         model: ChatModelBase,
117         toolkit: Toolkit | None = None,
118         middlewares: list[MiddlewareBase] | None = None,
119         state: AgentState | None = None,
120         offloader: Offloader | None = None,
121         # The agent configurations
122         model_config: ModelConfig | None = None,
123         context_config: ContextConfig | None = None,
124         react_config: ReActConfig | None = None,
125         injection_config: InjectionConfig | None = None,
126     ) -> None:
127         """Initialize the agent class in AgentScope.
128 
129         Args:
130             name (`str`):
131                 The agent identifier.
132             system_prompt (`str`):
133                 The agent's system prompt. Additional instructions may be
134                 appended to it dynamically during operation.
135             model (`ChatModelBase`):
136                 The chat model/llm used for this agent.
137             toolkit (`Toolkit | None`, optional):
138                 The toolkit used for registering tools, MCPs and skills as the
139                 sole source.
140             middlewares (`list[MiddlewareBase] | None`, optional):
141                 Middlewares applied to the agent to modify its behavior
142                 without altering its source code. Supported hook points
143                 include: reply, reasoning, acting, model call, and system
144                 prompt retrieval.
145             state (`AgentState | None`, optional):
146                 The agent state. A new state will be created if not provided.
147             offloader (`Offloader | None`, optional):
148                 The context offloader. If provided, the compressed context and
149                 tool result will be offloaded.
150             model_config (`ModelConfig | None`, optional):
151                 The additional chat model configuration including fallback
152                 model and retries.
153             context_config (`ContextConfig | None`, optional):
154                 The context config for context compression and tool result
155                 compression.
156             react_config (`ReActConfig | None`, optional):
157                 The config for the reasoning-acting loop.
158             injection_config (`InjectionConfig | None`, optional):
159                 The runtime state injection config, which controls how the
160                 time, (plan) tasks and context usage are injected into the
161                 context to help the agent better reason and act.
162         """
163         self.name = name
164         self._system_prompt = system_prompt
165         self.model = model
166         self.state = state or AgentState()
167 
168         self.model_config = model_config or ModelConfig()
169         self.context_config = context_config or ContextConfig()
170         self.react_config = react_config or ReActConfig()
171         self.injection_config = injection_config or InjectionConfig()
172         self._validate_configs()
173 
174         # The permission engine
175         self._engine = PermissionEngine(self.state.permission_context)
176 
177         # The offloader/workspace
178         self.offloader = offloader
179 
180         # ====================================================================
181         # The Tool-related logics
182         # ====================================================================
183         self.toolkit = toolkit or Toolkit()
184 
185         # ====================================================================
186         # The Middleware-related attributes
187         # ====================================================================
188         # Filter middlewares by implemented hooks (only once)
189         middlewares = middlewares or []
190         self._reply_middlewares = [
191             _ for _ in middlewares if _.is_implemented("on_reply")
192         ]
193         self._reasoning_middlewares = [
194             _ for _ in middlewares if _.is_implemented("on_reasoning")
195         ]
196         self._acting_middlewares = [
197             _ for _ in middlewares if _.is_implemented("on_acting")
198         ]
199         self._model_call_middlewares = [
200             _ for _ in middlewares if _.is_implemented("on_model_call")
201         ]
202         self._system_prompt_middlewares = [
203             _ for _ in middlewares if _.is_implemented("on_system_prompt")
204         ]
205         self._compress_context_middlewares = [
206             _ for _ in middlewares if _.is_implemented("on_compress_context")
207         ]
