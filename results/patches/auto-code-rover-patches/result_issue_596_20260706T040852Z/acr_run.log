261     if arguments == "" or arguments == "true":
262         print(Markdown("> Entered debug mode"))
263         print(self.messages)
264         self.debug_mode = True
265     elif arguments == "false":
266         print(Markdown("> Exited debug mode"))
267         self.debug_mode = False
268     else:
269         print(Markdown("> Unknown argument to debug command."))
