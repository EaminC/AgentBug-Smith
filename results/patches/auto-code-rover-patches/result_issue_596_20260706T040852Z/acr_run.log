291       json_path = "messages.json"
292     if not json_path.endswith(".json"):
293       json_path += ".json"
294     if os.path.exists(json_path):
295       with open(json_path, 'r') as f:
296         self.load(json.load(f))
297       print(Markdown(f"> messages json loaded from {os.path.abspath(json_path)}"))
