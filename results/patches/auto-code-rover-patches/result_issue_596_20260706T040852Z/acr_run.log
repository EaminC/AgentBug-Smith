439   def verify_api_key(self):
440     """
441     Makes sure we have an AZURE_API_KEY or OPENAI_API_KEY.
442     """
443     if self.use_azure:
444       all_env_available = (
445         ('AZURE_API_KEY' in os.environ or 'OPENAI_API_KEY' in os.environ) and
446         'AZURE_API_BASE' in os.environ and
447         'AZURE_API_VERSION' in os.environ and
