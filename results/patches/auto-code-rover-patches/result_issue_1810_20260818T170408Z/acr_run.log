791     def _stream(
792         self,
793         callback: Callable[..., None],
794         messages: Messages,
795         tool_specs: list[ToolSpec] | None = None,
796         system_prompt_content: list[SystemContentBlock] | None = None,
797         tool_choice: ToolChoice | None = None,
798     ) -> None:
799         """Stream conversation with the Bedrock model.
800 
801         This method operates in a separate thread to avoid blocking the async event loop with the call to
802         Bedrock's converse_stream.
803 
804         Args:
805             callback: Function to send events to the main thread.
806             messages: List of message objects to be processed by the model.
807             tool_specs: List of tool specifications to make available to the model.
808             system_prompt_content: System prompt content blocks to provide context to the model.
809             tool_choice: Selection strategy for tool invocation.
810 
811         Raises:
812             ContextWindowOverflowException: If the input exceeds the model's context window.
813             ModelThrottledException: If the model service is throttling requests.
814         """
815         try:
816             logger.debug("formatting request")
817             request = self._format_request(messages, tool_specs, system_prompt_content, tool_choice)
818             logger.debug("request=<%s>", request)
819 
820             logger.debug("invoking model")
821             streaming = self.config.get("streaming", True)
822 
823             logger.debug("got response from model")
824             if streaming:
825                 response = self.client.converse_stream(**request)
826                 # Track tool use events to fix stopReason for streaming responses
827                 has_tool_use = False
828                 for chunk in response["stream"]:
829                     if (
830                         "metadata" in chunk
831                         and "trace" in chunk["metadata"]
832                         and "guardrail" in chunk["metadata"]["trace"]
833                     ):
834                         guardrail_data = chunk["metadata"]["trace"]["guardrail"]
835                         if self._has_blocked_guardrail(guardrail_data):
836                             for event in self._generate_redaction_events():
837                                 callback(event)
838 
839                     # Track if we see tool use events
840                     if "contentBlockStart" in chunk and chunk["contentBlockStart"].get("start", {}).get("toolUse"):
841                         has_tool_use = True
842 
843                     # Fix stopReason for streaming responses that contain tool use
844                     if (
845                         has_tool_use
846                         and "messageStop" in chunk
847                         and (message_stop := chunk["messageStop"]).get("stopReason") == "end_turn"
848                     ):
849                         # Create corrected chunk with tool_use stopReason
850                         modified_chunk = chunk.copy()
851                         modified_chunk["messageStop"] = message_stop.copy()
852                         modified_chunk["messageStop"]["stopReason"] = "tool_use"
853                         logger.warning("Override stop reason from end_turn to tool_use")
854                         callback(modified_chunk)
855                     else:
856                         callback(chunk)
857 
858             else:
859                 response = self.client.converse(**request)
860                 for event in self._convert_non_streaming_to_streaming(response):
861                     callback(event)
862 
863                 if (
864                     "trace" in response
865                     and "guardrail" in response["trace"]
866                     and self._has_blocked_guardrail(response["trace"]["guardrail"])
867                 ):
868                     for event in self._generate_redaction_events():
869                         callback(event)
870 
871         except ClientError as e:
872             error_message = str(e)
873 
874             if (
875                 e.response["Error"]["Code"] == "ThrottlingException"
876                 or e.response["Error"]["Code"] == "throttlingException"
877             ):
878                 raise ModelThrottledException(error_message) from e
879 
880             if any(overflow_message in error_message for overflow_message in BEDROCK_CONTEXT_WINDOW_OVERFLOW_MESSAGES):
881                 logger.warning("bedrock threw context window overflow error")
882                 raise ContextWindowOverflowException(e) from e
883 
884             region = self.client.meta.region_name
885 
886             # Aid in debugging by adding more information
887             add_exception_note(e, f"└ Bedrock region: {region}")
888             add_exception_note(e, f"└ Model id: {self.config.get('model_id')}")
889 
890             if (
891                 e.response["Error"]["Code"] == "AccessDeniedException"
892                 and "You don't have access to the model" in error_message
893             ):
894                 add_exception_note(
895                     e,
896                     "└ For more information see "
897                     "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#model-access-issue",
898                 )
899 
900             if (
901                 e.response["Error"]["Code"] == "ValidationException"
902                 and "with on-demand throughput isn’t supported" in error_message
903             ):
904                 add_exception_note(
905                     e,
906                     "└ For more information see "
907                     "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#on-demand-throughput-isnt-supported",
908                 )
909 
910             raise e
911 
912         finally:
913             callback()
914             logger.debug("finished streaming response from model")

