210     def _format_request(
211         self,
212         messages: Messages,
213         tool_specs: list[ToolSpec] | None = None,
214         system_prompt_content: list[SystemContentBlock] | None = None,
215         tool_choice: ToolChoice | None = None,
216     ) -> dict[str, Any]:
217         """Format a Bedrock converse stream request.
218 
219         Args:
220             messages: List of message objects to be processed by the model.
221             tool_specs: List of tool specifications to make available to the model.
222             tool_choice: Selection strategy for tool invocation.
223             system_prompt_content: System prompt content blocks to provide context to the model.
224 
225         Returns:
226             A Bedrock converse stream request.
227         """
228         if not tool_specs:
229             has_tool_content = any(
230                 any("toolUse" in block or "toolResult" in block for block in msg.get("content", [])) for msg in messages
231             )
232             if has_tool_content:
233                 tool_specs = [noop_tool.tool_spec]
234 
235         # Use system_prompt_content directly (copy for mutability)
236         system_blocks: list[SystemContentBlock] = system_prompt_content.copy() if system_prompt_content else []
237         # Add cache point if configured (backwards compatibility)
238         if cache_prompt := self.config.get("cache_prompt"):
239             warnings.warn(
240                 "cache_prompt is deprecated. Use SystemContentBlock with cachePoint instead.", UserWarning, stacklevel=3
241             )
242             system_blocks.append({"cachePoint": {"type": cache_prompt}})
243 
244         return {
245             "modelId": self.config["model_id"],
246             "messages": self._format_bedrock_messages(messages),
247             "system": system_blocks,
248             **(
249                 {
250                     "toolConfig": {
251                         "tools": [
252                             *[
253                                 {
254                                     "toolSpec": {
255                                         "name": tool_spec["name"],
256                                         "description": tool_spec["description"],
257                                         "inputSchema": tool_spec["inputSchema"],
258                                     }
259                                 }
260                                 for tool_spec in tool_specs
261                             ],
262                             *(
263                                 [{"cachePoint": {"type": self.config["cache_tools"]}}]
264                                 if self.config.get("cache_tools")
265                                 else []
266                             ),
267                         ],
268                         **({"toolChoice": tool_choice if tool_choice else {"auto": {}}}),
269                     }
270                 }
271                 if tool_specs
272                 else {}
273             ),
274             **(self._get_additional_request_fields(tool_choice)),
275             **(
276                 {"additionalModelResponseFieldPaths": self.config["additional_response_field_paths"]}
277                 if self.config.get("additional_response_field_paths")
278                 else {}
279             ),
280             **(
281                 {
282                     "guardrailConfig": {
283                         "guardrailIdentifier": self.config["guardrail_id"],
284                         "guardrailVersion": self.config["guardrail_version"],
285                         "trace": self.config.get("guardrail_trace", "enabled"),
286                         **(
287                             {"streamProcessingMode": self.config.get("guardrail_stream_processing_mode")}
288                             if self.config.get("guardrail_stream_processing_mode")
289                             else {}
290                         ),
291                     }
292                 }
293                 if self.config.get("guardrail_id") and self.config.get("guardrail_version")
294                 else {}
295             ),
296             "inferenceConfig": {
297                 key: value
298                 for key, value in [
299                     ("maxTokens", self.config.get("max_tokens")),
300                     ("temperature", self.config.get("temperature")),
301                     ("topP", self.config.get("top_p")),
302                     ("stopSequences", self.config.get("stop_sequences")),
303                 ]
304                 if value is not None
305             },
306             **(
307                 self.config["additional_args"]
308                 if "additional_args" in self.config and self.config["additional_args"] is not None
309                 else {}
310             ),
311         }
312 
313     def _get_additional_request_fields(self, tool_choice: ToolChoice | None) -> dict[str, Any]:
314         """Get additional request fields, removing thinking if tool_choice forces tool use.
315 
316         Bedrock's API does not allow thinking mode when tool_choice forces tool use.
317         When forcing a tool (e.g., for structured_output retry), we temporarily disable thinking.
318 
319         Args:
320             tool_choice: The tool choice configuration.
321 
322         Returns:
323             A dict containing additionalModelRequestFields if configured, or empty dict.
324         """
325         additional_fields = self.config.get("additional_request_fields")
326         if not additional_fields:
327             return {}
328 
329         # Check if tool_choice is forcing tool use ("any" or specific "tool")
330         is_forcing_tool = tool_choice is not None and ("any" in tool_choice or "tool" in tool_choice)
331 
332         if is_forcing_tool and "thinking" in additional_fields:
333             # Create a copy without the thinking key
334             fields_without_thinking = {k: v for k, v in additional_fields.items() if k != "thinking"}
335             if fields_without_thinking:
336                 return {"additionalModelRequestFields": fields_without_thinking}
337             return {}
338 
339         return {"additionalModelRequestFields": additional_fields}
340 
341     def _inject_cache_point(self, messages: list[dict[str, Any]]) -> None:
342         """Inject a cache point at the end of the last user message.
343 
344         Args:
345             messages: List of messages to inject cache point into (modified in place).
346         """
347         if not messages:
348             return
349 
350         last_user_idx: int | None = None
351         for msg_idx, msg in enumerate(messages):
352             content = msg.get("content", [])
353             for block_idx, block in reversed(list(enumerate(content))):
354                 if "cachePoint" in block:
355                     del content[block_idx]
356                     logger.warning(
357                         "msg_idx=<%s>, block_idx=<%s> | stripped existing cache point (auto mode manages cache points)",
358                         msg_idx,
359                         block_idx,
360                     )
361             if msg.get("role") == "user":
362                 last_user_idx = msg_idx
363 
364         if last_user_idx is not None and messages[last_user_idx].get("content"):
365             messages[last_user_idx]["content"].append({"cachePoint": {"type": "default"}})
366             logger.debug("msg_idx=<%s> | added cache point to last user message", last_user_idx)
367 
368     def _find_last_user_text_message_index(self, messages: Messages) -> int | None:
369         """Find the index of the last user message containing text or image content.
370 
371         This is used for guardrail_latest_message to ensure that guardContent wrapping
372         targets the correct message even when toolResult messages follow.
373 
374         Args:
375             messages: List of messages to search
376 
377         Returns:
378             Index of the last user message with text/image content, or None if not found
379         """
380         for idx, msg in reversed(list(enumerate(messages))):
381             if msg["role"] == "user" and any("text" in cb or "image" in cb for cb in msg.get("content", [])):
382                 return idx
383         return None
384 
385     def _format_bedrock_messages(self, messages: Messages) -> list[dict[str, Any]]:
386         """Format messages for Bedrock API compatibility.
387 
388         This function ensures messages conform to Bedrock's expected format by:
389         - Filtering out SDK_UNKNOWN_MEMBER content blocks
390         - Eagerly filtering content blocks to only include Bedrock-supported fields
391         - Ensuring all message content blocks are properly formatted for the Bedrock API
392         - Optionally wrapping the last user message in guardrailConverseContent blocks
393         - Injecting cache points when cache_config is set with strategy="auto"
394 
395         Args:
396             messages: List of messages to format
397 
398         Returns:
399             Messages formatted for Bedrock API compatibility
400 
401         Note:
402             Unlike other APIs that ignore unknown fields, Bedrock only accepts a strict
403             subset of fields for each content block type and throws validation exceptions
404             when presented with unexpected fields. Therefore, we must eagerly filter all
405             content blocks to remove any additional fields before sending to Bedrock.
406             https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ContentBlock.html
407         """
408         cleaned_messages: list[dict[str, Any]] = []
409 
410         filtered_unknown_members = False
411         dropped_deepseek_reasoning_content = False
412 
413         # Pre-compute the index of the last user message containing text or image content.
414         # This ensures guardContent wrapping is maintained across tool execution cycles, where
415         # the final message in the list is a toolResult (role=user) rather than text/image content.
416         last_user_text_idx = None
417         if self.config.get("guardrail_latest_message", False):
418             last_user_text_idx = self._find_last_user_text_message_index(messages)
419 
420         for idx, message in enumerate(messages):
421             cleaned_content: list[dict[str, Any]] = []
422 
423             for content_block in message["content"]:
424                 # Filter out SDK_UNKNOWN_MEMBER content blocks
425                 if "SDK_UNKNOWN_MEMBER" in content_block:
426                     filtered_unknown_members = True
427                     continue
428 
429                 # DeepSeek models have issues with reasoningContent
430                 # TODO: Replace with systematic model configuration registry (https://github.com/strands-agents/sdk-python/issues/780)
431                 if "deepseek" in self.config["model_id"].lower() and "reasoningContent" in content_block:
432                     dropped_deepseek_reasoning_content = True
433                     continue
434 
435                 # Format content blocks for Bedrock API compatibility
436                 formatted_content = self._format_request_message_content(content_block)
437                 if formatted_content is None:
438                     continue
439 
440                 # Wrap text or image content in guardContent if this is the last user text/image message
441                 if idx == last_user_text_idx and ("text" in formatted_content or "image" in formatted_content):
442                     if "text" in formatted_content:
443                         formatted_content = {"guardContent": {"text": {"text": formatted_content["text"]}}}
444                     elif "image" in formatted_content:
445                         formatted_content = {"guardContent": {"image": formatted_content["image"]}}
446 
447                 cleaned_content.append(formatted_content)
448 
449             # Create new message with cleaned content (skip if empty)
450             if cleaned_content:
451                 cleaned_messages.append({"content": cleaned_content, "role": message["role"]})
452 
453         if filtered_unknown_members:
454             logger.warning(
455                 "Filtered out SDK_UNKNOWN_MEMBER content blocks from messages, consider upgrading boto3 version"
456             )
457         if dropped_deepseek_reasoning_content:
458             logger.debug(
459                 "Filtered DeepSeek reasoningContent content blocks from messages - https://api-docs.deepseek.com/guides/reasoning_model#multi-round-conversation"
460             )
461 
462         # Inject cache point into cleaned_messages (not original messages) if cache_config is set
463         cache_config = self.config.get("cache_config")
464         if cache_config:
465             strategy: str | None = cache_config.strategy
466             if strategy == "auto":
467                 strategy = self._cache_strategy
468                 if not strategy:
469                     logger.warning(
470                         "model_id=<%s> | cache_config is enabled but this model does not support automatic caching",
471                         self.config.get("model_id"),
472                     )
473             if strategy == "anthropic":
474                 self._inject_cache_point(cleaned_messages)
475 
476         return cleaned_messages
477 
478     def _should_include_tool_result_status(self) -> bool:
479         """Determine whether to include tool result status based on current config."""
480         include_status = self.config.get("include_tool_result_status", "auto")
481 
482         if include_status is True:
483             return True
484         elif include_status is False:
485             return False
486         else:  # "auto"
487             return any(model in self.config["model_id"] for model in _MODELS_INCLUDE_STATUS)
488 
489     def _handle_location(self, location: SourceLocation) -> dict[str, Any] | None:
490         """Convert location content block to Bedrock format if its an S3Location."""
491         if location["type"] == "s3":
492             s3_location = cast(S3Location, location)
493             formatted_document_s3: dict[str, Any] = {"uri": s3_location["uri"]}
494             if "bucketOwner" in s3_location:
495                 formatted_document_s3["bucketOwner"] = s3_location["bucketOwner"]
496             return {"s3Location": formatted_document_s3}
497         else:
498             logger.warning("Non s3 location sources are not supported by Bedrock | skipping content block")
499             return None
500 
501     def _format_request_message_content(self, content: ContentBlock) -> dict[str, Any] | None:
502         """Format a Bedrock content block.
503 
504         Bedrock strictly validates content blocks and throws exceptions for unknown fields.
505         This function extracts only the fields that Bedrock supports for each content type.
506 
507         Args:
508             content: Content block to format.
509 
510         Returns:
511             Bedrock formatted content block.
512 
513         Raises:
514             TypeError: If the content block type is not supported by Bedrock.
515         """
516         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_CachePointBlock.html
517         if "cachePoint" in content:
518             return {"cachePoint": {"type": content["cachePoint"]["type"]}}
519 
520         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_DocumentBlock.html
521         if "document" in content:
522             document = content["document"]
523             result: dict[str, Any] = {}
524 
525             # Handle required fields (all optional due to total=False)
526             if "name" in document:
527                 result["name"] = document["name"]
528             if "format" in document:
529                 result["format"] = document["format"]
530 
531             # Handle source - supports bytes or location
532             if "source" in document:
533                 source = document["source"]
534                 formatted_document_source: dict[str, Any] | None
535                 if "location" in source:
536                     formatted_document_source = self._handle_location(source["location"])
537                     if formatted_document_source is None:
538                         return None
539                 elif "bytes" in source:
540                     formatted_document_source = {"bytes": source["bytes"]}
541                 result["source"] = formatted_document_source
542 
543             # Handle optional fields
544             if "citations" in document and document["citations"] is not None:
545                 result["citations"] = {"enabled": document["citations"]["enabled"]}
546             if "context" in document:
547                 result["context"] = document["context"]
548 
549             return {"document": result}
550 
551         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_GuardrailConverseContentBlock.html
552         if "guardContent" in content:
553             guard = content["guardContent"]
554             guard_text = guard["text"]
555             result = {"text": {"text": guard_text["text"], "qualifiers": guard_text["qualifiers"]}}
556             return {"guardContent": result}
557 
558         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ImageBlock.html
559         if "image" in content:
560             image = content["image"]
561             source = image["source"]
562             formatted_image_source: dict[str, Any] | None
563             if "location" in source:
564                 formatted_image_source = self._handle_location(source["location"])
565                 if formatted_image_source is None:
566                     return None
567             elif "bytes" in source:
568                 formatted_image_source = {"bytes": source["bytes"]}
569             result = {"format": image["format"], "source": formatted_image_source}
570             return {"image": result}
571 
572         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ReasoningContentBlock.html
573         if "reasoningContent" in content:
574             reasoning = content["reasoningContent"]
575             result = {}
576 
577             if "reasoningText" in reasoning:
578                 reasoning_text = reasoning["reasoningText"]
579                 result["reasoningText"] = {}
580                 if "text" in reasoning_text:
581                     result["reasoningText"]["text"] = reasoning_text["text"]
582                 # Only include signature if truthy (avoid empty strings)
583                 if reasoning_text.get("signature"):
584                     result["reasoningText"]["signature"] = reasoning_text["signature"]
585 
586             if "redactedContent" in reasoning:
587                 result["redactedContent"] = reasoning["redactedContent"]
588 
589             return {"reasoningContent": result}
590 
591         # Pass through text and other simple content types
592         if "text" in content:
593             return {"text": content["text"]}
594 
595         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolResultBlock.html
596         if "toolResult" in content:
597             tool_result = content["toolResult"]
598             formatted_content: list[dict[str, Any]] = []
599             for tool_result_content in tool_result["content"]:
600                 if "json" in tool_result_content:
601                     # Handle json field since not in ContentBlock but valid in ToolResultContent
602                     formatted_content.append({"json": tool_result_content["json"]})
603                 else:
604                     formatted_message_content = self._format_request_message_content(
605                         cast(ContentBlock, tool_result_content)
606                     )
607                     if formatted_message_content is None:
608                         continue
609                     formatted_content.append(formatted_message_content)
610 
611             result = {
612                 "content": formatted_content,
613                 "toolUseId": tool_result["toolUseId"],
614             }
615             if "status" in tool_result and self._should_include_tool_result_status():
616                 result["status"] = tool_result["status"]
617             return {"toolResult": result}
618 
619         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolUseBlock.html
620         if "toolUse" in content:
621             tool_use = content["toolUse"]
622             return {
623                 "toolUse": {
624                     "input": tool_use["input"],
625                     "name": tool_use["name"],
626                     "toolUseId": tool_use["toolUseId"],
627                 }
628             }
629 
630         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_VideoBlock.html
631         if "video" in content:
632             video = content["video"]
633             source = video["source"]
634             formatted_video_source: dict[str, Any] | None
635             if "location" in source:
636                 formatted_video_source = self._handle_location(source["location"])
637                 if formatted_video_source is None:
638                     return None
639             elif "bytes" in source:
640                 formatted_video_source = {"bytes": source["bytes"]}
641             result = {"format": video["format"], "source": formatted_video_source}
642             return {"video": result}
643 
644         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_CitationsContentBlock.html
645         if "citationsContent" in content:
646             citations = content["citationsContent"]
647             result = {}
648 
649             if "citations" in citations:
650                 result["citations"] = []
651                 for citation in citations["citations"]:
652                     filtered_citation: dict[str, Any] = {}
653                     if "location" in citation:
654                         filtered_citation["location"] = citation["location"]
655                     if "sourceContent" in citation:
656                         filtered_source_content: list[dict[str, Any]] = []
657                         for source_content in citation["sourceContent"]:
658                             if "text" in source_content:
659                                 filtered_source_content.append({"text": source_content["text"]})
660                         if filtered_source_content:
661                             filtered_citation["sourceContent"] = filtered_source_content
662                     if "title" in citation:
663                         filtered_citation["title"] = citation["title"]
664                     result["citations"].append(filtered_citation)
665 
666             if "content" in citations:
667                 filtered_content: list[dict[str, Any]] = []
668                 for generated_content in citations["content"]:
669                     if "text" in generated_content:
670                         filtered_content.append({"text": generated_content["text"]})
671                 if filtered_content:
672                     result["content"] = filtered_content
673 
674             return {"citationsContent": result}
675 
676         raise TypeError(f"content_type=<{next(iter(content))}> | unsupported type")
677 
678     def _has_blocked_guardrail(self, guardrail_data: dict[str, Any]) -> bool:
679         """Check if guardrail data contains any blocked policies.
680 
681         Args:
682             guardrail_data: Guardrail data from trace information.
683 
684         Returns:
685             True if any blocked guardrail is detected, False otherwise.
686         """
687         input_assessment = guardrail_data.get("inputAssessment", {})
688         output_assessments = guardrail_data.get("outputAssessments", {})
689 
690         # Check input assessments
691         if any(self._find_detected_and_blocked_policy(assessment) for assessment in input_assessment.values()):
692             return True
693 
694         # Check output assessments
695         if any(self._find_detected_and_blocked_policy(assessment) for assessment in output_assessments.values()):
696             return True
697 
698         return False
699 
700     def _generate_redaction_events(self) -> list[StreamEvent]:
701         """Generate redaction events based on configuration.
702 
703         Returns:
704             List of redaction events to yield.
705         """
706         events: list[StreamEvent] = []
707 
708         if self.config.get("guardrail_redact_input", True):
709             logger.debug("Redacting user input due to guardrail.")
710             events.append(
711                 {
712                     "redactContent": {
713                         "redactUserContentMessage": self.config.get(
714                             "guardrail_redact_input_message", "[User input redacted.]"
715                         )
716                     }
717                 }
718             )
719 
720         if self.config.get("guardrail_redact_output", False):
721             logger.debug("Redacting assistant output due to guardrail.")
722             events.append(
723                 {
724                     "redactContent": {
725                         "redactAssistantContentMessage": self.config.get(
726                             "guardrail_redact_output_message",
727                             "[Assistant output redacted.]",
728                         )
729                     }
730                 }
731             )
732 
733         return events
734 
735     @override
736     async def stream(
737         self,
738         messages: Messages,
739         tool_specs: list[ToolSpec] | None = None,
740         system_prompt: str | None = None,
741         *,
742         tool_choice: ToolChoice | None = None,
743         system_prompt_content: list[SystemContentBlock] | None = None,
744         **kwargs: Any,
745     ) -> AsyncGenerator[StreamEvent, None]:
746         """Stream conversation with the Bedrock model.
747 
748         This method calls either the Bedrock converse_stream API or the converse API
749         based on the streaming parameter in the configuration.
750 
751         Args:
752             messages: List of message objects to be processed by the model.
753             tool_specs: List of tool specifications to make available to the model.
754             system_prompt: System prompt to provide context to the model.
755             tool_choice: Selection strategy for tool invocation.
756             system_prompt_content: System prompt content blocks to provide context to the model.
757             **kwargs: Additional keyword arguments for future extensibility.
758 
759         Yields:
760             Model events.
761 
762         Raises:
763             ContextWindowOverflowException: If the input exceeds the model's context window.
764             ModelThrottledException: If the model service is throttling requests.
765         """
766 
767         def callback(event: StreamEvent | None = None) -> None:
768             loop.call_soon_threadsafe(queue.put_nowait, event)
769             if event is None:
770                 return
771 
772         loop = asyncio.get_event_loop()
773         queue: asyncio.Queue[StreamEvent | None] = asyncio.Queue()
774 
775         # Handle backward compatibility: if system_prompt is provided but system_prompt_content is None
776         if system_prompt and system_prompt_content is None:
777             system_prompt_content = [{"text": system_prompt}]
778 
779         thread = asyncio.to_thread(self._stream, callback, messages, tool_specs, system_prompt_content, tool_choice)
780         task = asyncio.create_task(thread)
781 
782         while True:
783             event = await queue.get()
784             if event is None:
785                 break
786 
787             yield event
788 
789         await task
790 
791     def _stream(
792         self,
793         callback: Callable[..., None],
794         messages: Messages,
795         tool_specs: list[ToolSpec] | None = None,
796         system_prompt_content: list[SystemContentBlock] | None = None,
797         tool_choice: ToolChoice | None = None,
798     ) -> None:
799         """Stream conversation with the Bedrock model.
800 
801         This method operates in a separate thread to avoid blocking the async event loop with the call to
802         Bedrock's converse_stream.
803 
804         Args:
805             callback: Function to send events to the main thread.
806             messages: List of message objects to be processed by the model.
807             tool_specs: List of tool specifications to make available to the model.
808             system_prompt_content: System prompt content blocks to provide context to the model.
809             tool_choice: Selection strategy for tool invocation.
810 
811         Raises:
812             ContextWindowOverflowException: If the input exceeds the model's context window.
813             ModelThrottledException: If the model service is throttling requests.
814         """
815         try:
816             logger.debug("formatting request")
817             request = self._format_request(messages, tool_specs, system_prompt_content, tool_choice)
818             logger.debug("request=<%s>", request)
819 
820             logger.debug("invoking model")
821             streaming = self.config.get("streaming", True)
822 
823             logger.debug("got response from model")
824             if streaming:
825                 response = self.client.converse_stream(**request)
826                 # Track tool use events to fix stopReason for streaming responses
827                 has_tool_use = False
828                 for chunk in response["stream"]:
829                     if (
830                         "metadata" in chunk
831                         and "trace" in chunk["metadata"]
832                         and "guardrail" in chunk["metadata"]["trace"]
833                     ):
834                         guardrail_data = chunk["metadata"]["trace"]["guardrail"]
835                         if self._has_blocked_guardrail(guardrail_data):
836                             for event in self._generate_redaction_events():
837                                 callback(event)
838 
839                     # Track if we see tool use events
840                     if "contentBlockStart" in chunk and chunk["contentBlockStart"].get("start", {}).get("toolUse"):
841                         has_tool_use = True
842 
843                     # Fix stopReason for streaming responses that contain tool use
844                     if (
845                         has_tool_use
846                         and "messageStop" in chunk
847                         and (message_stop := chunk["messageStop"]).get("stopReason") == "end_turn"
848                     ):
849                         # Create corrected chunk with tool_use stopReason
850                         modified_chunk = chunk.copy()
851                         modified_chunk["messageStop"] = message_stop.copy()
852                         modified_chunk["messageStop"]["stopReason"] = "tool_use"
853                         logger.warning("Override stop reason from end_turn to tool_use")
854                         callback(modified_chunk)
855                     else:
856                         callback(chunk)
857 
858             else:
859                 response = self.client.converse(**request)
860                 for event in self._convert_non_streaming_to_streaming(response):
861                     callback(event)
862 
863                 if (
864                     "trace" in response
865                     and "guardrail" in response["trace"]
866                     and self._has_blocked_guardrail(response["trace"]["guardrail"])
867                 ):
868                     for event in self._generate_redaction_events():
869                         callback(event)
870 
871         except ClientError as e:
872             error_message = str(e)
873 
874             if (
875                 e.response["Error"]["Code"] == "ThrottlingException"
876                 or e.response["Error"]["Code"] == "throttlingException"
877             ):
878                 raise ModelThrottledException(error_message) from e
879 
880             if any(overflow_message in error_message for overflow_message in BEDROCK_CONTEXT_WINDOW_OVERFLOW_MESSAGES):
881                 logger.warning("bedrock threw context window overflow error")
882                 raise ContextWindowOverflowException(e) from e
883 
884             region = self.client.meta.region_name
885 
886             # Aid in debugging by adding more information
887             add_exception_note(e, f"└ Bedrock region: {region}")
888             add_exception_note(e, f"└ Model id: {self.config.get('model_id')}")
889 
890             if (
891                 e.response["Error"]["Code"] == "AccessDeniedException"
892                 and "You don't have access to the model" in error_message
893             ):
894                 add_exception_note(
895                     e,
896                     "└ For more information see "
897                     "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#model-access-issue",
898                 )
899 
900             if (
901                 e.response["Error"]["Code"] == "ValidationException"
902                 and "with on-demand throughput isn’t supported" in error_message
903             ):
904                 add_exception_note(
905                     e,
906                     "└ For more information see "
907                     "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#on-demand-throughput-isnt-supported",
908                 )
909 
910             raise e
911 
912         finally:
913             callback()
914             logger.debug("finished streaming response from model")
915 
916     def _convert_non_streaming_to_streaming(self, response: dict[str, Any]) -> Iterable[StreamEvent]:
917         """Convert a non-streaming response to the streaming format.
918 
919         Args:
920             response: The non-streaming response from the Bedrock model.
921 
922         Returns:
923             An iterable of response events in the streaming format.
924         """
925         # Yield messageStart event
926         yield {"messageStart": {"role": response["output"]["message"]["role"]}}
927 
928         # Process content blocks
929         for content in cast(list[ContentBlock], response["output"]["message"]["content"]):
930             # Yield contentBlockStart event if needed
931             if "toolUse" in content:
932                 yield {
933                     "contentBlockStart": {
934                         "start": {
935                             "toolUse": {
936                                 "toolUseId": content["toolUse"]["toolUseId"],
937                                 "name": content["toolUse"]["name"],
938                             }
939                         },
940                     }
941                 }
942 
943                 # For tool use, we need to yield the input as a delta
944                 input_value = json.dumps(content["toolUse"]["input"])
945 
946                 yield {"contentBlockDelta": {"delta": {"toolUse": {"input": input_value}}}}
947             elif "text" in content:
948                 # Then yield the text as a delta
949                 yield {
950                     "contentBlockDelta": {
951                         "delta": {"text": content["text"]},
952                     }
953                 }
954             elif "reasoningContent" in content:
955                 # Then yield the reasoning content as a delta
956                 yield {
957                     "contentBlockDelta": {
958                         "delta": {"reasoningContent": {"text": content["reasoningContent"]["reasoningText"]["text"]}}
959                     }
960                 }
961 
962                 if "signature" in content["reasoningContent"]["reasoningText"]:
963                     yield {
964                         "contentBlockDelta": {
965                             "delta": {
966                                 "reasoningContent": {
967                                     "signature": content["reasoningContent"]["reasoningText"]["signature"]
968                                 }
969                             }
970                         }
971                     }
972             elif "citationsContent" in content:
973                 # For non-streaming citations, emit text and metadata deltas in sequence
974                 # to match streaming behavior where they flow naturally
975                 if "content" in content["citationsContent"]:
976                     text_content = "".join([content["text"] for content in content["citationsContent"]["content"]])
977                     yield {
978                         "contentBlockDelta": {"delta": {"text": text_content}},
979                     }
980 
981                 for citation in content["citationsContent"]["citations"]:
982                     # Then emit citation metadata (for structure)
983 
984                     citation_metadata: CitationsDelta = {
985                         "title": citation["title"],
986                         "location": citation["location"],
987                         "sourceContent": citation["sourceContent"],
988                     }
989                     yield {"contentBlockDelta": {"delta": {"citation": citation_metadata}}}
990 
991             # Yield contentBlockStop event
992             yield {"contentBlockStop": {}}
993 
994         # Yield messageStop event
995         # Fix stopReason for models that return end_turn when they should return tool_use on non-streaming side
996         current_stop_reason = response["stopReason"]
997         if current_stop_reason == "end_turn":
998             message_content = response["output"]["message"]["content"]
999             if any("toolUse" in content for content in message_content):
1000                 current_stop_reason = "tool_use"
1001                 logger.warning("Override stop reason from end_turn to tool_use")
1002 
1003         yield {
1004             "messageStop": {
1005                 "stopReason": current_stop_reason,
1006                 "additionalModelResponseFields": response.get("additionalModelResponseFields"),
1007             }
1008         }
1009 
1010         # Yield metadata event
1011         if "usage" in response or "metrics" in response or "trace" in response:
1012             metadata: StreamEvent = {"metadata": {}}
1013             if "usage" in response:
1014                 metadata["metadata"]["usage"] = response["usage"]
1015             if "metrics" in response:
1016                 metadata["metadata"]["metrics"] = response["metrics"]
1017             if "trace" in response:
1018                 metadata["metadata"]["trace"] = response["trace"]
1019             yield metadata
1020 
1021     def _find_detected_and_blocked_policy(self, input: Any) -> bool:
1022         """Recursively checks if the assessment contains a detected and blocked guardrail.
1023 
1024         Args:
1025             input: The assessment to check.
1026 
1027         Returns:
1028             True if the input contains a detected and blocked guardrail, False otherwise.
1029 
1030         """
1031         # Check if input is a dictionary
1032         if isinstance(input, dict):
1033             # Check if current dictionary has action: BLOCKED and detected: true
1034             if input.get("action") == "BLOCKED" and input.get("detected") and isinstance(input.get("detected"), bool):
1035                 return True
1036 
1037             # Otherwise, recursively check all values in the dictionary
1038             return self._find_detected_and_blocked_policy(input.values())
1039 
1040         elif isinstance(input, (list, ValuesView)):
1041             # Handle case where input is a list or dict_values
1042             return any(self._find_detected_and_blocked_policy(item) for item in input)
1043         # Otherwise return False
1044         return False
1045 
1046     @override
1047     async def structured_output(
1048         self,
1049         output_model: type[T],
1050         prompt: Messages,
1051         system_prompt: str | None = None,
1052         **kwargs: Any,
1053     ) -> AsyncGenerator[dict[str, T | Any], None]:
1054         """Get structured output from the model.
1055 
1056         Args:
1057             output_model: The output model to use for the agent.
1058             prompt: The prompt messages to use for the agent.
1059             system_prompt: System prompt to provide context to the model.
1060             **kwargs: Additional keyword arguments for future extensibility.
1061 
1062         Yields:
1063             Model events with the last being the structured output.
1064         """
1065         tool_spec = convert_pydantic_to_tool_spec(output_model)
1066 
1067         response = self.stream(
1068             messages=prompt,
1069             tool_specs=[tool_spec],
1070             system_prompt=system_prompt,
1071             tool_choice=cast(ToolChoice, {"any": {}}),
1072             **kwargs,
1073         )
1074         async for event in streaming.process_stream(response):
1075             yield event
1076 
1077         stop_reason, messages, _, _ = event["stop"]
1078 
1079         if stop_reason != "tool_use":
1080             raise ValueError(f'Model returned stop_reason: {stop_reason} instead of "tool_use".')
1081 
1082         content = messages["content"]
1083         output_response: dict[str, Any] | None = None
1084         for block in content:
1085             # if the tool use name doesn't match the tool spec name, skip, and if the block is not a tool use, skip.
1086             # if the tool use name never matches, raise an error.
1087             if block.get("toolUse") and block["toolUse"]["name"] == tool_spec["name"]:
1088                 output_response = block["toolUse"]["input"]
1089             else:
1090                 continue
1091 
1092         if output_response is None:
1093             raise ValueError("No valid tool use or tool use input was found in the Bedrock response.")
1094 
1095         yield {"output": output_model(**output_response)}
1096 
1097     @staticmethod
1098     def _get_default_model_with_warning(region_name: str, model_config: BedrockConfig | None = None) -> str:
1099         """Get the default Bedrock modelId based on region.
1100 
1101         If the region is not **known** to support inference then we show a helpful warning
1102         that compliments the exception that Bedrock will throw.
1103         If the customer provided a model_id in their config or they overrode the `DEFAULT_BEDROCK_MODEL_ID`
1104         then we should not process further.
1105 
1106         Args:
1107             region_name (str): region for bedrock model
1108             model_config (Optional[dict[str, Any]]): Model Config that caller passes in on init
1109         """
1110         if DEFAULT_BEDROCK_MODEL_ID != _DEFAULT_BEDROCK_MODEL_ID.format("us"):
1111             return DEFAULT_BEDROCK_MODEL_ID
1112 
1113         model_config = model_config or {}
1114         if model_config.get("model_id"):
1115             return model_config["model_id"]
1116 
1117         prefix_inference_map = {"ap": "apac"}  # some inference endpoints can be a bit different than the region prefix
1118 
1119         prefix = "-".join(region_name.split("-")[:-2]).lower()  # handles `us-east-1` or `us-gov-east-1`
1120         if prefix not in {"us", "eu", "ap", "us-gov"}:
1121             warnings.warn(
1122                 f"""
1123             ================== WARNING ==================
1124 
1125                 This region {region_name} does not support
1126                 our default inference endpoint: {_DEFAULT_BEDROCK_MODEL_ID.format(prefix)}.
1127                 Update the agent to pass in a 'model_id' like so:
1128                 ```
1129                 Agent(..., model='valid_model_id', ...)
1130                 ````
1131                 Documentation: https://docs.aws.amazon.com/bedrock/latest/userguide/inference-profiles-support.html
1132 
1133             ==================================================
1134             """,
1135                 stacklevel=2,
1136             )
1137 
1138         return _DEFAULT_BEDROCK_MODEL_ID.format(prefix_inference_map.get(prefix, prefix))

