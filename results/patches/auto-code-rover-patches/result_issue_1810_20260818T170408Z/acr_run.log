167             client_config = boto_client_config.merge(BotocoreConfig(user_agent_extra=new_user_agent))
168         else:
169             client_config = BotocoreConfig(user_agent_extra="strands-agents", read_timeout=DEFAULT_READ_TIMEOUT)
170 
171         self.client = session.client(
172             service_name="bedrock-runtime",
173             config=client_config,
174             endpoint_url=endpoint_url,
175             region_name=resolved_region,
176         )
177 
178         logger.debug("region=<%s> | bedrock client created", self.client.meta.region_name)
