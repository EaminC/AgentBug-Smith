484     def _handle_location(self, location: SourceLocation) -> dict[str, Any] | None:
485         """Convert location content block to Bedrock format if its an S3Location."""
486         if location["type"] == "s3":
487             s3_location = cast(S3Location, location)
488             formatted_document_s3: dict[str, Any] = {"uri": s3_location["uri"]}
489             if "bucketOwner" in s3_location:
490                 formatted_document_s3["bucketOwner"] = s3_location["bucketOwner"]
491             return {"s3Location": formatted_document_s3}
492         else:
493             logger.warning("Non s3 location sources are not supported by Bedrock | skipping content block")
494             return None
495 
496     def _format_request_message_content(self, content: ContentBlock) -> dict[str, Any] | None:
497         """Format a Bedrock content block.
498 
499         Bedrock strictly validates content blocks and throws exceptions for unknown fields.
500         This function extracts only the fields that Bedrock supports for each content type.
501 
502         Args:
503             content: Content block to format.
504 
505         Returns:
506             Bedrock formatted content block.
507 
508         Raises:
509             TypeError: If the content block type is not supported by Bedrock.
510         """
511         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_CachePointBlock.html
512         if "cachePoint" in content:
513             return {"cachePoint": {"type": content["cachePoint"]["type"]}}
514 
515         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_DocumentBlock.html
516         if "document" in content:
517             document = content["document"]
518             result: dict[str, Any] = {}
519 
520             # Handle required fields (all optional due to total=False)
521             if "name" in document:
522                 result["name"] = document["name"]
523             if "format" in document:
524                 result["format"] = document["format"]
525 
526             # Handle source - supports bytes or location
527             if "source" in document:
528                 source = document["source"]
529                 formatted_document_source: dict[str, Any] | None
530                 if "location" in source:
531                     formatted_document_source = self._handle_location(source["location"])
532                     if formatted_document_source is None:
533                         return None
534                 elif "bytes" in source:
535                     formatted_document_source = {"bytes": source["bytes"]}
536                 result["source"] = formatted_document_source
537 
538             # Handle optional fields
539             if "citations" in document and document["citations"] is not None:
540                 result["citations"] = {"enabled": document["citations"]["enabled"]}
541             if "context" in document:
542                 result["context"] = document["context"]
543 
544             return {"document": result}
545 
546         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_GuardrailConverseContentBlock.html
547         if "guardContent" in content:
548             guard = content["guardContent"]
549             guard_text = guard["text"]
550             result = {"text": {"text": guard_text["text"], "qualifiers": guard_text["qualifiers"]}}
551             return {"guardContent": result}
552 
553         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ImageBlock.html
554         if "image" in content:
555             image = content["image"]
556             source = image["source"]
557             formatted_image_source: dict[str, Any] | None
558             if "location" in source:
559                 formatted_image_source = self._handle_location(source["location"])
560                 if formatted_image_source is None:
561                     return None
562             elif "bytes" in source:
563                 formatted_image_source = {"bytes": source["bytes"]}
564             result = {"format": image["format"], "source": formatted_image_source}
565             return {"image": result}
566 
567         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ReasoningContentBlock.html
568         if "reasoningContent" in content:
569             reasoning = content["reasoningContent"]
570             result = {}
571 
572             if "reasoningText" in reasoning:
573                 reasoning_text = reasoning["reasoningText"]
574                 result["reasoningText"] = {}
575                 if "text" in reasoning_text:
576                     result["reasoningText"]["text"] = reasoning_text["text"]
577                 # Only include signature if truthy (avoid empty strings)
578                 if reasoning_text.get("signature"):
579                     result["reasoningText"]["signature"] = reasoning_text["signature"]
580 
581             if "redactedContent" in reasoning:
582                 result["redactedContent"] = reasoning["redactedContent"]
583 
584             return {"reasoningContent": result}
585 
586         # Pass through text and other simple content types
587         if "text" in content:
588             return {"text": content["text"]}
589 
590         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolResultBlock.html
591         if "toolResult" in content:
592             tool_result = content["toolResult"]
593             formatted_content: list[dict[str, Any]] = []
594             for tool_result_content in tool_result["content"]:
595                 if "json" in tool_result_content:
596                     # Handle json field since not in ContentBlock but valid in ToolResultContent
597                     formatted_content.append({"json": tool_result_content["json"]})
598                 else:
599                     formatted_message_content = self._format_request_message_content(
600                         cast(ContentBlock, tool_result_content)
601                     )
602                     if formatted_message_content is None:
603                         continue
604                     formatted_content.append(formatted_message_content)
605 
606             result = {
607                 "content": formatted_content,
608                 "toolUseId": tool_result["toolUseId"],
609             }
610             if "status" in tool_result and self._should_include_tool_result_status():
611                 result["status"] = tool_result["status"]
612             return {"toolResult": result}
613 
614         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolUseBlock.html
615         if "toolUse" in content:
616             tool_use = content["toolUse"]
617             return {
618                 "toolUse": {
619                     "input": tool_use["input"],
620                     "name": tool_use["name"],
621                     "toolUseId": tool_use["toolUseId"],
622                 }
623             }
624 
625         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_VideoBlock.html
626         if "video" in content:
627             video = content["video"]
628             source = video["source"]
629             formatted_video_source: dict[str, Any] | None
630             if "location" in source:
631                 formatted_video_source = self._handle_location(source["location"])
632                 if formatted_video_source is None:
633                     return None
634             elif "bytes" in source:
635                 formatted_video_source = {"bytes": source["bytes"]}
636             result = {"format": video["format"], "source": formatted_video_source}
637             return {"video": result}
638 
639         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_CitationsContentBlock.html
640         if "citationsContent" in content:
641             citations = content["citationsContent"]
642             result = {}
643 
644             if "citations" in citations:
645                 result["citations"] = []
646                 for citation in citations["citations"]:
647                     filtered_citation: dict[str, Any] = {}
648                     if "location" in citation:
649                         filtered_citation["location"] = citation["location"]
650                     if "sourceContent" in citation:
651                         filtered_source_content: list[dict[str, Any]] = []
652                         for source_content in citation["sourceContent"]:
653                             if "text" in source_content:
654                                 filtered_source_content.append({"text": source_content["text"]})
655                         if filtered_source_content:
656                             filtered_citation["sourceContent"] = filtered_source_content
657                     if "title" in citation:
658                         filtered_citation["title"] = citation["title"]
659                     result["citations"].append(filtered_citation)
660 
661             if "content" in citations:
662                 filtered_content: list[dict[str, Any]] = []
663                 for generated_content in citations["content"]:
664                     if "text" in generated_content:
665                         filtered_content.append({"text": generated_content["text"]})
666                 if filtered_content:
667                     result["content"] = filtered_content
668 
669             return {"citationsContent": result}
670 
671         raise TypeError(f"content_type=<{next(iter(content))}> | unsupported type")
672 
673     def _has_blocked_guardrail(self, guardrail_data: dict[str, Any]) -> bool:
674         """Check if guardrail data contains any blocked policies.
675 
676         Args:
677             guardrail_data: Guardrail data from trace information.
678 
679         Returns:
680             True if any blocked guardrail is detected, False otherwise.
681         """
682         input_assessment = guardrail_data.get("inputAssessment", {})
683         output_assessments = guardrail_data.get("outputAssessments", {})
684 
685         # Check input assessments
686         if any(self._find_detected_and_blocked_policy(assessment) for assessment in input_assessment.values()):
687             return True
688 
689         # Check output assessments
690         if any(self._find_detected_and_blocked_policy(assessment) for assessment in output_assessments.values()):
691             return True
692 
693         return False
694 
695     def _generate_redaction_events(self) -> list[StreamEvent]:
696         """Generate redaction events based on configuration.
697 
698         Returns:
699             List of redaction events to yield.
700         """
701         events: list[StreamEvent] = []
702 
703         if self.config.get("guardrail_redact_input", True):
704             logger.debug("Redacting user input due to guardrail.")
705             events.append(
706                 {
707                     "redactContent": {
708                         "redactUserContentMessage": self.config.get(
709                             "guardrail_redact_input_message", "[User input redacted.]"
710                         )
711                     }
712                 }
713             )
714 
715         if self.config.get("guardrail_redact_output", False):
716             logger.debug("Redacting assistant output due to guardrail.")
717             events.append(
718                 {
719                     "redactContent": {
720                         "redactAssistantContentMessage": self.config.get(
721                             "guardrail_redact_output_message",
722                             "[Assistant output redacted.]",
723                         )
724                     }
725                 }
726             )
727 
728         return events
