60 class BedrockModel(Model):
61     """AWS Bedrock model provider implementation.
62 
63     The implementation handles Bedrock-specific features such as:
64 
65     - Tool configuration for function calling
66     - Guardrails integration
67     - Caching points for system prompts and tools
68     - Streaming responses
69     - Context window overflow detection
70     """
71 
72     class BedrockConfig(TypedDict, total=False):
73         """Configuration options for Bedrock models.
74 
75         Attributes:
76             additional_args: Any additional arguments to include in the request
77             additional_request_fields: Additional fields to include in the Bedrock request
78             additional_response_field_paths: Additional response field paths to extract
79             cache_prompt: Cache point type for the system prompt (deprecated, use cache_config)
80             cache_config: Configuration for prompt caching. Use CacheConfig(strategy="auto") for automatic caching.
81             cache_tools: Cache point type for tools
82             guardrail_id: ID of the guardrail to apply
83             guardrail_trace: Guardrail trace mode. Defaults to enabled.
84             guardrail_version: Version of the guardrail to apply
85             guardrail_stream_processing_mode: The guardrail processing mode
86             guardrail_redact_input: Flag to redact input if a guardrail is triggered. Defaults to True.
87             guardrail_redact_input_message: If a Bedrock Input guardrail triggers, replace the input with this message.
88             guardrail_redact_output: Flag to redact output if guardrail is triggered. Defaults to False.
89             guardrail_redact_output_message: If a Bedrock Output guardrail triggers, replace output with this message.
90             guardrail_latest_message: Flag to send only the lastest user message to guardrails.
91                 Defaults to False.
92             max_tokens: Maximum number of tokens to generate in the response
93             model_id: The Bedrock model ID (e.g., "us.anthropic.claude-sonnet-4-20250514-v1:0")
94             include_tool_result_status: Flag to include status field in tool results.
95                 True includes status, False removes status, "auto" determines based on model_id. Defaults to "auto".
96             stop_sequences: List of sequences that will stop generation when encountered
97             streaming: Flag to enable/disable streaming. Defaults to True.
98             temperature: Controls randomness in generation (higher = more random)
99             top_p: Controls diversity via nucleus sampling (alternative to temperature)
100         """
101 
102         additional_args: dict[str, Any] | None
103         additional_request_fields: dict[str, Any] | None
104         additional_response_field_paths: list[str] | None
105         cache_prompt: str | None
106         cache_config: CacheConfig | None
107         cache_tools: str | None
108         guardrail_id: str | None
109         guardrail_trace: Literal["enabled", "disabled", "enabled_full"] | None
110         guardrail_stream_processing_mode: Literal["sync", "async"] | None
111         guardrail_version: str | None
112         guardrail_redact_input: bool | None
113         guardrail_redact_input_message: str | None
114         guardrail_redact_output: bool | None
115         guardrail_redact_output_message: str | None
116         guardrail_latest_message: bool | None
117         max_tokens: int | None
118         model_id: str
119         include_tool_result_status: Literal["auto"] | bool | None
120         stop_sequences: list[str] | None
121         streaming: bool | None
122         temperature: float | None
123         top_p: float | None
124 
125     def __init__(
126         self,
127         *,
128         boto_session: boto3.Session | None = None,
129         boto_client_config: BotocoreConfig | None = None,
130         region_name: str | None = None,
131         endpoint_url: str | None = None,
132         **model_config: Unpack[BedrockConfig],
133     ):
134         """Initialize provider instance.
135 
136         Args:
137             boto_session: Boto Session to use when calling the Bedrock Model.
138             boto_client_config: Configuration to use when creating the Bedrock-Runtime Boto Client.
139             region_name: AWS region to use for the Bedrock service.
140                 Defaults to the AWS_REGION environment variable if set, or "us-west-2" if not set.
141             endpoint_url: Custom endpoint URL for VPC endpoints (PrivateLink)
142             **model_config: Configuration options for the Bedrock model.
143         """
144         if region_name and boto_session:
145             raise ValueError("Cannot specify both `region_name` and `boto_session`.")
146 
147         session = boto_session or boto3.Session()
148         resolved_region = region_name or session.region_name or os.environ.get("AWS_REGION") or DEFAULT_BEDROCK_REGION
149         self.config = BedrockModel.BedrockConfig(
150             model_id=BedrockModel._get_default_model_with_warning(resolved_region, model_config),
151             include_tool_result_status="auto",
152         )
153         self.update_config(**model_config)
154 
155         logger.debug("config=<%s> | initializing", self.config)
156 
157         # Add strands-agents to the request user agent
158         if boto_client_config:
159             existing_user_agent = getattr(boto_client_config, "user_agent_extra", None)
160 
161             # Append 'strands-agents' to existing user_agent_extra or set it if not present
162             if existing_user_agent:
163                 new_user_agent = f"{existing_user_agent} strands-agents"
164             else:
165                 new_user_agent = "strands-agents"
166 
167             client_config = boto_client_config.merge(BotocoreConfig(user_agent_extra=new_user_agent))
168         else:
169             client_config = BotocoreConfig(user_agent_extra="strands-agents", read_timeout=DEFAULT_READ_TIMEOUT)
170 
171         self.client = session.client(
172             service_name="bedrock-runtime",
173             config=client_config,
174             endpoint_url=endpoint_url,
175             region_name=resolved_region,
176         )
177 
178         logger.debug("region=<%s> | bedrock client created", self.client.meta.region_name)
179 
180     @property
181     def _supports_caching(self) -> bool:
182         """Whether this model supports prompt caching.
183 
184         Returns True for Claude models on Bedrock.
185         """
186         model_id = self.config.get("model_id", "").lower()
187         return "claude" in model_id or "anthropic" in model_id
188 
189     @override
190     def update_config(self, **model_config: Unpack[BedrockConfig]) -> None:  # type: ignore
191         """Update the Bedrock Model configuration with the provided arguments.
192 
193         Args:
194             **model_config: Configuration overrides.
195         """
196         validate_config_keys(model_config, self.BedrockConfig)
197         self.config.update(model_config)
198 
199     @override
200     def get_config(self) -> BedrockConfig:
201         """Get the current Bedrock Model configuration.
202 
203         Returns:
204             The Bedrock model configuration.
205         """
206         return self.config
207 
208     def _format_request(
209         self,
210         messages: Messages,
211         tool_specs: list[ToolSpec] | None = None,
212         system_prompt_content: list[SystemContentBlock] | None = None,
213         tool_choice: ToolChoice | None = None,
214     ) -> dict[str, Any]:
215         """Format a Bedrock converse stream request.
216 
217         Args:
218             messages: List of message objects to be processed by the model.
219             tool_specs: List of tool specifications to make available to the model.
220             tool_choice: Selection strategy for tool invocation.
221             system_prompt_content: System prompt content blocks to provide context to the model.
222 
223         Returns:
224             A Bedrock converse stream request.
225         """
226         if not tool_specs:
227             has_tool_content = any(
228                 any("toolUse" in block or "toolResult" in block for block in msg.get("content", [])) for msg in messages
229             )
230             if has_tool_content:
231                 tool_specs = [noop_tool.tool_spec]
232 
233         # Use system_prompt_content directly (copy for mutability)
234         system_blocks: list[SystemContentBlock] = system_prompt_content.copy() if system_prompt_content else []
235         # Add cache point if configured (backwards compatibility)
236         if cache_prompt := self.config.get("cache_prompt"):
237             warnings.warn(
238                 "cache_prompt is deprecated. Use SystemContentBlock with cachePoint instead.", UserWarning, stacklevel=3
239             )
240             system_blocks.append({"cachePoint": {"type": cache_prompt}})
241 
242         return {
243             "modelId": self.config["model_id"],
244             "messages": self._format_bedrock_messages(messages),
245             "system": system_blocks,
246             **(
247                 {
248                     "toolConfig": {
249                         "tools": [
250                             *[
251                                 {
252                                     "toolSpec": {
253                                         "name": tool_spec["name"],
254                                         "description": tool_spec["description"],
255                                         "inputSchema": tool_spec["inputSchema"],
256                                     }
257                                 }
258                                 for tool_spec in tool_specs
259                             ],
260                             *(
261                                 [{"cachePoint": {"type": self.config["cache_tools"]}}]
262                                 if self.config.get("cache_tools")
263                                 else []
264                             ),
265                         ],
266                         **({"toolChoice": tool_choice if tool_choice else {"auto": {}}}),
267                     }
268                 }
269                 if tool_specs
270                 else {}
271             ),
272             **(self._get_additional_request_fields(tool_choice)),
273             **(
274                 {"additionalModelResponseFieldPaths": self.config["additional_response_field_paths"]}
275                 if self.config.get("additional_response_field_paths")
276                 else {}
277             ),
278             **(
279                 {
280                     "guardrailConfig": {
281                         "guardrailIdentifier": self.config["guardrail_id"],
282                         "guardrailVersion": self.config["guardrail_version"],
283                         "trace": self.config.get("guardrail_trace", "enabled"),
284                         **(
285                             {"streamProcessingMode": self.config.get("guardrail_stream_processing_mode")}
286                             if self.config.get("guardrail_stream_processing_mode")
287                             else {}
288                         ),
289                     }
290                 }
291                 if self.config.get("guardrail_id") and self.config.get("guardrail_version")
292                 else {}
293             ),
294             "inferenceConfig": {
295                 key: value
296                 for key, value in [
297                     ("maxTokens", self.config.get("max_tokens")),
298                     ("temperature", self.config.get("temperature")),
299                     ("topP", self.config.get("top_p")),
300                     ("stopSequences", self.config.get("stop_sequences")),
301                 ]
302                 if value is not None
303             },
304             **(
305                 self.config["additional_args"]
306                 if "additional_args" in self.config and self.config["additional_args"] is not None
307                 else {}
308             ),
309         }
310 
311     def _get_additional_request_fields(self, tool_choice: ToolChoice | None) -> dict[str, Any]:
312         """Get additional request fields, removing thinking if tool_choice forces tool use.
313 
314         Bedrock's API does not allow thinking mode when tool_choice forces tool use.
315         When forcing a tool (e.g., for structured_output retry), we temporarily disable thinking.
316 
317         Args:
318             tool_choice: The tool choice configuration.
319 
320         Returns:
321             A dict containing additionalModelRequestFields if configured, or empty dict.
322         """
323         additional_fields = self.config.get("additional_request_fields")
324         if not additional_fields:
325             return {}
326 
327         # Check if tool_choice is forcing tool use ("any" or specific "tool")
328         is_forcing_tool = tool_choice is not None and ("any" in tool_choice or "tool" in tool_choice)
329 
330         if is_forcing_tool and "thinking" in additional_fields:
331             # Create a copy without the thinking key
332             fields_without_thinking = {k: v for k, v in additional_fields.items() if k != "thinking"}
333             if fields_without_thinking:
334                 return {"additionalModelRequestFields": fields_without_thinking}
335             return {}
336 
337         return {"additionalModelRequestFields": additional_fields}
338 
339     def _inject_cache_point(self, messages: list[dict[str, Any]]) -> None:
340         """Inject a cache point at the end of the last assistant message.
341 
342         Args:
343             messages: List of messages to inject cache point into (modified in place).
344         """
345         if not messages:
346             return
347 
348         last_assistant_idx: int | None = None
349         for msg_idx, msg in enumerate(messages):
350             content = msg.get("content", [])
351             for block_idx, block in reversed(list(enumerate(content))):
352                 if "cachePoint" in block:
353                     del content[block_idx]
354                     logger.warning(
355                         "msg_idx=<%s>, block_idx=<%s> | stripped existing cache point (auto mode manages cache points)",
356                         msg_idx,
357                         block_idx,
358                     )
359             if msg.get("role") == "assistant":
360                 last_assistant_idx = msg_idx
361 
362         if last_assistant_idx is not None and messages[last_assistant_idx].get("content"):
363             messages[last_assistant_idx]["content"].append({"cachePoint": {"type": "default"}})
364             logger.debug("msg_idx=<%s> | added cache point to last assistant message", last_assistant_idx)
365 
366     def _find_last_user_text_message_index(self, messages: Messages) -> int | None:
367         """Find the index of the last user message containing text or image content.
368 
369         This is used for guardrail_latest_message to ensure that guardContent wrapping
370         targets the correct message even when toolResult messages follow.
371 
372         Args:
373             messages: List of messages to search
374 
375         Returns:
376             Index of the last user message with text/image content, or None if not found
377         """
378         for idx, msg in reversed(list(enumerate(messages))):
379             if msg["role"] == "user" and any("text" in cb or "image" in cb for cb in msg.get("content", [])):
380                 return idx
381         return None
382 
383     def _format_bedrock_messages(self, messages: Messages) -> list[dict[str, Any]]:
384         """Format messages for Bedrock API compatibility.
385 
386         This function ensures messages conform to Bedrock's expected format by:
387         - Filtering out SDK_UNKNOWN_MEMBER content blocks
388         - Eagerly filtering content blocks to only include Bedrock-supported fields
389         - Ensuring all message content blocks are properly formatted for the Bedrock API
390         - Optionally wrapping the last user message in guardrailConverseContent blocks
391         - Injecting cache points when cache_config is set with strategy="auto"
392 
393         Args:
394             messages: List of messages to format
395 
396         Returns:
397             Messages formatted for Bedrock API compatibility
398 
399         Note:
400             Unlike other APIs that ignore unknown fields, Bedrock only accepts a strict
401             subset of fields for each content block type and throws validation exceptions
402             when presented with unexpected fields. Therefore, we must eagerly filter all
403             content blocks to remove any additional fields before sending to Bedrock.
404             https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ContentBlock.html
405         """
406         cleaned_messages: list[dict[str, Any]] = []
407 
408         filtered_unknown_members = False
409         dropped_deepseek_reasoning_content = False
410 
411         # Pre-compute the index of the last user message containing text or image content.
412         # This ensures guardContent wrapping is maintained across tool execution cycles, where
413         # the final message in the list is a toolResult (role=user) rather than text/image content.
414         last_user_text_idx = None
415         if self.config.get("guardrail_latest_message", False):
416             last_user_text_idx = self._find_last_user_text_message_index(messages)
417 
418         for idx, message in enumerate(messages):
419             cleaned_content: list[dict[str, Any]] = []
420 
421             for content_block in message["content"]:
422                 # Filter out SDK_UNKNOWN_MEMBER content blocks
423                 if "SDK_UNKNOWN_MEMBER" in content_block:
424                     filtered_unknown_members = True
425                     continue
426 
427                 # DeepSeek models have issues with reasoningContent
428                 # TODO: Replace with systematic model configuration registry (https://github.com/strands-agents/sdk-python/issues/780)
429                 if "deepseek" in self.config["model_id"].lower() and "reasoningContent" in content_block:
430                     dropped_deepseek_reasoning_content = True
431                     continue
432 
433                 # Format content blocks for Bedrock API compatibility
434                 formatted_content = self._format_request_message_content(content_block)
435                 if formatted_content is None:
436                     continue
437 
438                 # Wrap text or image content in guardContent if this is the last user text/image message
439                 if idx == last_user_text_idx and ("text" in formatted_content or "image" in formatted_content):
440                     if "text" in formatted_content:
441                         formatted_content = {"guardContent": {"text": {"text": formatted_content["text"]}}}
442                     elif "image" in formatted_content:
443                         formatted_content = {"guardContent": {"image": formatted_content["image"]}}
444 
445                 cleaned_content.append(formatted_content)
446 
447             # Create new message with cleaned content (skip if empty)
448             if cleaned_content:
449                 cleaned_messages.append({"content": cleaned_content, "role": message["role"]})
450 
451         if filtered_unknown_members:
452             logger.warning(
453                 "Filtered out SDK_UNKNOWN_MEMBER content blocks from messages, consider upgrading boto3 version"
454             )
455         if dropped_deepseek_reasoning_content:
456             logger.debug(
457                 "Filtered DeepSeek reasoningContent content blocks from messages - https://api-docs.deepseek.com/guides/reasoning_model#multi-round-conversation"
458             )
459 
460         # Inject cache point into cleaned_messages (not original messages) if cache_config is set
461         cache_config = self.config.get("cache_config")
462         if cache_config and cache_config.strategy == "auto":
463             if self._supports_caching:
464                 self._inject_cache_point(cleaned_messages)
465             else:
466                 logger.warning(
467                     "model_id=<%s> | cache_config is enabled but this model does not support caching",
468                     self.config.get("model_id"),
469                 )
470 
471         return cleaned_messages
472 
473     def _should_include_tool_result_status(self) -> bool:
474         """Determine whether to include tool result status based on current config."""
475         include_status = self.config.get("include_tool_result_status", "auto")
476 
477         if include_status is True:
478             return True
479         elif include_status is False:
480             return False
481         else:  # "auto"
482             return any(model in self.config["model_id"] for model in _MODELS_INCLUDE_STATUS)
483 
484     def _handle_location(self, location: SourceLocation) -> dict[str, Any] | None:
485         """Convert location content block to Bedrock format if its an S3Location."""
486         if location["type"] == "s3":
487             s3_location = cast(S3Location, location)
488             formatted_document_s3: dict[str, Any] = {"uri": s3_location["uri"]}
489             if "bucketOwner" in s3_location:
490                 formatted_document_s3["bucketOwner"] = s3_location["bucketOwner"]
491             return {"s3Location": formatted_document_s3}
492         else:
493             logger.warning("Non s3 location sources are not supported by Bedrock | skipping content block")
494             return None
495 
496     def _format_request_message_content(self, content: ContentBlock) -> dict[str, Any] | None:
497         """Format a Bedrock content block.
498 
499         Bedrock strictly validates content blocks and throws exceptions for unknown fields.
500         This function extracts only the fields that Bedrock supports for each content type.
501 
502         Args:
503             content: Content block to format.
504 
505         Returns:
506             Bedrock formatted content block.
507 
508         Raises:
509             TypeError: If the content block type is not supported by Bedrock.
510         """
511         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_CachePointBlock.html
512         if "cachePoint" in content:
513             return {"cachePoint": {"type": content["cachePoint"]["type"]}}
514 
515         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_DocumentBlock.html
516         if "document" in content:
517             document = content["document"]
518             result: dict[str, Any] = {}
519 
520             # Handle required fields (all optional due to total=False)
521             if "name" in document:
522                 result["name"] = document["name"]
523             if "format" in document:
524                 result["format"] = document["format"]
525 
526             # Handle source - supports bytes or location
527             if "source" in document:
528                 source = document["source"]
529                 formatted_document_source: dict[str, Any] | None
530                 if "location" in source:
531                     formatted_document_source = self._handle_location(source["location"])
532                     if formatted_document_source is None:
533                         return None
534                 elif "bytes" in source:
535                     formatted_document_source = {"bytes": source["bytes"]}
536                 result["source"] = formatted_document_source
537 
538             # Handle optional fields
539             if "citations" in document and document["citations"] is not None:
540                 result["citations"] = {"enabled": document["citations"]["enabled"]}
541             if "context" in document:
542                 result["context"] = document["context"]
543 
544             return {"document": result}
545 
546         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_GuardrailConverseContentBlock.html
547         if "guardContent" in content:
548             guard = content["guardContent"]
549             guard_text = guard["text"]
550             result = {"text": {"text": guard_text["text"], "qualifiers": guard_text["qualifiers"]}}
551             return {"guardContent": result}
552 
553         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ImageBlock.html
554         if "image" in content:
555             image = content["image"]
556             source = image["source"]
557             formatted_image_source: dict[str, Any] | None
558             if "location" in source:
559                 formatted_image_source = self._handle_location(source["location"])
560                 if formatted_image_source is None:
561                     return None
562             elif "bytes" in source:
563                 formatted_image_source = {"bytes": source["bytes"]}
564             result = {"format": image["format"], "source": formatted_image_source}
565             return {"image": result}
566 
567         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ReasoningContentBlock.html
568         if "reasoningContent" in content:
569             reasoning = content["reasoningContent"]
570             result = {}
571 
572             if "reasoningText" in reasoning:
573                 reasoning_text = reasoning["reasoningText"]
574                 result["reasoningText"] = {}
575                 if "text" in reasoning_text:
576                     result["reasoningText"]["text"] = reasoning_text["text"]
577                 # Only include signature if truthy (avoid empty strings)
578                 if reasoning_text.get("signature"):
579                     result["reasoningText"]["signature"] = reasoning_text["signature"]
580 
581             if "redactedContent" in reasoning:
582                 result["redactedContent"] = reasoning["redactedContent"]
583 
584             return {"reasoningContent": result}
585 
586         # Pass through text and other simple content types
587         if "text" in content:
588             return {"text": content["text"]}
589 
590         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolResultBlock.html
591         if "toolResult" in content:
592             tool_result = content["toolResult"]
593             formatted_content: list[dict[str, Any]] = []
594             for tool_result_content in tool_result["content"]:
595                 if "json" in tool_result_content:
596                     # Handle json field since not in ContentBlock but valid in ToolResultContent
597                     formatted_content.append({"json": tool_result_content["json"]})
598                 else:
599                     formatted_message_content = self._format_request_message_content(
600                         cast(ContentBlock, tool_result_content)
601                     )
602                     if formatted_message_content is None:
603                         continue
604                     formatted_content.append(formatted_message_content)
605 
606             result = {
607                 "content": formatted_content,
608                 "toolUseId": tool_result["toolUseId"],
609             }
610             if "status" in tool_result and self._should_include_tool_result_status():
611                 result["status"] = tool_result["status"]
612             return {"toolResult": result}
613 
614         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolUseBlock.html
615         if "toolUse" in content:
616             tool_use = content["toolUse"]
617             return {
618                 "toolUse": {
619                     "input": tool_use["input"],
620                     "name": tool_use["name"],
621                     "toolUseId": tool_use["toolUseId"],
622                 }
623             }
624 
625         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_VideoBlock.html
626         if "video" in content:
627             video = content["video"]
628             source = video["source"]
629             formatted_video_source: dict[str, Any] | None
630             if "location" in source:
631                 formatted_video_source = self._handle_location(source["location"])
632                 if formatted_video_source is None:
633                     return None
634             elif "bytes" in source:
635                 formatted_video_source = {"bytes": source["bytes"]}
636             result = {"format": video["format"], "source": formatted_video_source}
637             return {"video": result}
638 
639         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_CitationsContentBlock.html
640         if "citationsContent" in content:
641             citations = content["citationsContent"]
642             result = {}
643 
644             if "citations" in citations:
645                 result["citations"] = []
646                 for citation in citations["citations"]:
647                     filtered_citation: dict[str, Any] = {}
648                     if "location" in citation:
649                         filtered_citation["location"] = citation["location"]
650                     if "sourceContent" in citation:
651                         filtered_source_content: list[dict[str, Any]] = []
652                         for source_content in citation["sourceContent"]:
653                             if "text" in source_content:
654                                 filtered_source_content.append({"text": source_content["text"]})
655                         if filtered_source_content:
656                             filtered_citation["sourceContent"] = filtered_source_content
657                     if "title" in citation:
658                         filtered_citation["title"] = citation["title"]
659                     result["citations"].append(filtered_citation)
660 
661             if "content" in citations:
662                 filtered_content: list[dict[str, Any]] = []
663                 for generated_content in citations["content"]:
664                     if "text" in generated_content:
665                         filtered_content.append({"text": generated_content["text"]})
666                 if filtered_content:
667                     result["content"] = filtered_content
668 
669             return {"citationsContent": result}
670 
671         raise TypeError(f"content_type=<{next(iter(content))}> | unsupported type")
672 
673     def _has_blocked_guardrail(self, guardrail_data: dict[str, Any]) -> bool:
674         """Check if guardrail data contains any blocked policies.
675 
676         Args:
677             guardrail_data: Guardrail data from trace information.
678 
679         Returns:
680             True if any blocked guardrail is detected, False otherwise.
681         """
682         input_assessment = guardrail_data.get("inputAssessment", {})
683         output_assessments = guardrail_data.get("outputAssessments", {})
684 
685         # Check input assessments
686         if any(self._find_detected_and_blocked_policy(assessment) for assessment in input_assessment.values()):
687             return True
688 
689         # Check output assessments
690         if any(self._find_detected_and_blocked_policy(assessment) for assessment in output_assessments.values()):
691             return True
692 
693         return False
694 
695     def _generate_redaction_events(self) -> list[StreamEvent]:
696         """Generate redaction events based on configuration.
697 
698         Returns:
699             List of redaction events to yield.
700         """
701         events: list[StreamEvent] = []
702 
703         if self.config.get("guardrail_redact_input", True):
704             logger.debug("Redacting user input due to guardrail.")
705             events.append(
706                 {
707                     "redactContent": {
708                         "redactUserContentMessage": self.config.get(
709                             "guardrail_redact_input_message", "[User input redacted.]"
710                         )
711                     }
712                 }
713             )
714 
715         if self.config.get("guardrail_redact_output", False):
716             logger.debug("Redacting assistant output due to guardrail.")
717             events.append(
718                 {
719                     "redactContent": {
720                         "redactAssistantContentMessage": self.config.get(
721                             "guardrail_redact_output_message",
722                             "[Assistant output redacted.]",
723                         )
724                     }
725                 }
726             )
727 
728         return events
729 
730     @override
731     async def stream(
732         self,
733         messages: Messages,
734         tool_specs: list[ToolSpec] | None = None,
735         system_prompt: str | None = None,
736         *,
737         tool_choice: ToolChoice | None = None,
738         system_prompt_content: list[SystemContentBlock] | None = None,
739         **kwargs: Any,
740     ) -> AsyncGenerator[StreamEvent, None]:
741         """Stream conversation with the Bedrock model.
742 
743         This method calls either the Bedrock converse_stream API or the converse API
744         based on the streaming parameter in the configuration.
745 
746         Args:
747             messages: List of message objects to be processed by the model.
748             tool_specs: List of tool specifications to make available to the model.
749             system_prompt: System prompt to provide context to the model.
750             tool_choice: Selection strategy for tool invocation.
751             system_prompt_content: System prompt content blocks to provide context to the model.
752             **kwargs: Additional keyword arguments for future extensibility.
753 
754         Yields:
755             Model events.
756 
757         Raises:
758             ContextWindowOverflowException: If the input exceeds the model's context window.
759             ModelThrottledException: If the model service is throttling requests.
760         """
761 
762         def callback(event: StreamEvent | None = None) -> None:
763             loop.call_soon_threadsafe(queue.put_nowait, event)
764             if event is None:
765                 return
766 
767         loop = asyncio.get_event_loop()
768         queue: asyncio.Queue[StreamEvent | None] = asyncio.Queue()
769 
770         # Handle backward compatibility: if system_prompt is provided but system_prompt_content is None
771         if system_prompt and system_prompt_content is None:
772             system_prompt_content = [{"text": system_prompt}]
773 
774         thread = asyncio.to_thread(self._stream, callback, messages, tool_specs, system_prompt_content, tool_choice)
775         task = asyncio.create_task(thread)
776 
777         while True:
778             event = await queue.get()
779             if event is None:
780                 break
781 
782             yield event
783 
784         await task
785 
786     def _stream(
787         self,
788         callback: Callable[..., None],
789         messages: Messages,
790         tool_specs: list[ToolSpec] | None = None,
791         system_prompt_content: list[SystemContentBlock] | None = None,
792         tool_choice: ToolChoice | None = None,
793     ) -> None:
794         """Stream conversation with the Bedrock model.
795 
796         This method operates in a separate thread to avoid blocking the async event loop with the call to
797         Bedrock's converse_stream.
798 
799         Args:
800             callback: Function to send events to the main thread.
801             messages: List of message objects to be processed by the model.
802             tool_specs: List of tool specifications to make available to the model.
803             system_prompt_content: System prompt content blocks to provide context to the model.
804             tool_choice: Selection strategy for tool invocation.
805 
806         Raises:
807             ContextWindowOverflowException: If the input exceeds the model's context window.
808             ModelThrottledException: If the model service is throttling requests.
809         """
810         try:
811             logger.debug("formatting request")
812             request = self._format_request(messages, tool_specs, system_prompt_content, tool_choice)
813             logger.debug("request=<%s>", request)
814 
815             logger.debug("invoking model")
816             streaming = self.config.get("streaming", True)
817 
818             logger.debug("got response from model")
819             if streaming:
820                 response = self.client.converse_stream(**request)
821                 # Track tool use events to fix stopReason for streaming responses
822                 has_tool_use = False
823                 for chunk in response["stream"]:
824                     if (
825                         "metadata" in chunk
826                         and "trace" in chunk["metadata"]
827                         and "guardrail" in chunk["metadata"]["trace"]
828                     ):
829                         guardrail_data = chunk["metadata"]["trace"]["guardrail"]
830                         if self._has_blocked_guardrail(guardrail_data):
831                             for event in self._generate_redaction_events():
832                                 callback(event)
833 
834                     # Track if we see tool use events
835                     if "contentBlockStart" in chunk and chunk["contentBlockStart"].get("start", {}).get("toolUse"):
836                         has_tool_use = True
837 
838                     # Fix stopReason for streaming responses that contain tool use
839                     if (
840                         has_tool_use
841                         and "messageStop" in chunk
842                         and (message_stop := chunk["messageStop"]).get("stopReason") == "end_turn"
843                     ):
844                         # Create corrected chunk with tool_use stopReason
845                         modified_chunk = chunk.copy()
846                         modified_chunk["messageStop"] = message_stop.copy()
847                         modified_chunk["messageStop"]["stopReason"] = "tool_use"
848                         logger.warning("Override stop reason from end_turn to tool_use")
849                         callback(modified_chunk)
850                     else:
851                         callback(chunk)
852 
853             else:
854                 response = self.client.converse(**request)
855                 for event in self._convert_non_streaming_to_streaming(response):
856                     callback(event)
857 
858                 if (
859                     "trace" in response
860                     and "guardrail" in response["trace"]
861                     and self._has_blocked_guardrail(response["trace"]["guardrail"])
862                 ):
863                     for event in self._generate_redaction_events():
864                         callback(event)
865 
866         except ClientError as e:
867             error_message = str(e)
868 
869             if (
870                 e.response["Error"]["Code"] == "ThrottlingException"
871                 or e.response["Error"]["Code"] == "throttlingException"
872             ):
873                 raise ModelThrottledException(error_message) from e
874 
875             if any(overflow_message in error_message for overflow_message in BEDROCK_CONTEXT_WINDOW_OVERFLOW_MESSAGES):
876                 logger.warning("bedrock threw context window overflow error")
877                 raise ContextWindowOverflowException(e) from e
878 
879             region = self.client.meta.region_name
880 
881             # Aid in debugging by adding more information
882             add_exception_note(e, f"└ Bedrock region: {region}")
883             add_exception_note(e, f"└ Model id: {self.config.get('model_id')}")
884 
885             if (
886                 e.response["Error"]["Code"] == "AccessDeniedException"
887                 and "You don't have access to the model" in error_message
888             ):
889                 add_exception_note(
890                     e,
891                     "└ For more information see "
892                     "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#model-access-issue",
893                 )
894 
895             if (
896                 e.response["Error"]["Code"] == "ValidationException"
897                 and "with on-demand throughput isn’t supported" in error_message
898             ):
899                 add_exception_note(
900                     e,
901                     "└ For more information see "
902                     "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#on-demand-throughput-isnt-supported",
903                 )
904 
905             raise e
906 
907         finally:
908             callback()
909             logger.debug("finished streaming response from model")
910 
911     def _convert_non_streaming_to_streaming(self, response: dict[str, Any]) -> Iterable[StreamEvent]:
912         """Convert a non-streaming response to the streaming format.
913 
914         Args:
915             response: The non-streaming response from the Bedrock model.
916 
917         Returns:
918             An iterable of response events in the streaming format.
919         """
920         # Yield messageStart event
921         yield {"messageStart": {"role": response["output"]["message"]["role"]}}
922 
923         # Process content blocks
924         for content in cast(list[ContentBlock], response["output"]["message"]["content"]):
925             # Yield contentBlockStart event if needed
926             if "toolUse" in content:
927                 yield {
928                     "contentBlockStart": {
929                         "start": {
930                             "toolUse": {
931                                 "toolUseId": content["toolUse"]["toolUseId"],
932                                 "name": content["toolUse"]["name"],
933                             }
934                         },
935                     }
936                 }
937 
938                 # For tool use, we need to yield the input as a delta
939                 input_value = json.dumps(content["toolUse"]["input"])
940 
941                 yield {"contentBlockDelta": {"delta": {"toolUse": {"input": input_value}}}}
942             elif "text" in content:
943                 # Then yield the text as a delta
944                 yield {
945                     "contentBlockDelta": {
946                         "delta": {"text": content["text"]},
947                     }
948                 }
949             elif "reasoningContent" in content:
950                 # Then yield the reasoning content as a delta
951                 yield {
952                     "contentBlockDelta": {
953                         "delta": {"reasoningContent": {"text": content["reasoningContent"]["reasoningText"]["text"]}}
954                     }
955                 }
956 
957                 if "signature" in content["reasoningContent"]["reasoningText"]:
958                     yield {
959                         "contentBlockDelta": {
960                             "delta": {
961                                 "reasoningContent": {
962                                     "signature": content["reasoningContent"]["reasoningText"]["signature"]
963                                 }
964                             }
965                         }
966                     }
967             elif "citationsContent" in content:
968                 # For non-streaming citations, emit text and metadata deltas in sequence
969                 # to match streaming behavior where they flow naturally
970                 if "content" in content["citationsContent"]:
971                     text_content = "".join([content["text"] for content in content["citationsContent"]["content"]])
972                     yield {
973                         "contentBlockDelta": {"delta": {"text": text_content}},
974                     }
975 
976                 for citation in content["citationsContent"]["citations"]:
977                     # Then emit citation metadata (for structure)
978 
979                     citation_metadata: CitationsDelta = {
980                         "title": citation["title"],
981                         "location": citation["location"],
982                         "sourceContent": citation["sourceContent"],
983                     }
984                     yield {"contentBlockDelta": {"delta": {"citation": citation_metadata}}}
985 
986             # Yield contentBlockStop event
987             yield {"contentBlockStop": {}}
988 
989         # Yield messageStop event
990         # Fix stopReason for models that return end_turn when they should return tool_use on non-streaming side
991         current_stop_reason = response["stopReason"]
992         if current_stop_reason == "end_turn":
993             message_content = response["output"]["message"]["content"]
994             if any("toolUse" in content for content in message_content):
995                 current_stop_reason = "tool_use"
996                 logger.warning("Override stop reason from end_turn to tool_use")
997 
998         yield {
999             "messageStop": {
1000                 "stopReason": current_stop_reason,
1001                 "additionalModelResponseFields": response.get("additionalModelResponseFields"),
1002             }
1003         }
1004 
1005         # Yield metadata event
1006         if "usage" in response or "metrics" in response or "trace" in response:
1007             metadata: StreamEvent = {"metadata": {}}
1008             if "usage" in response:
1009                 metadata["metadata"]["usage"] = response["usage"]
1010             if "metrics" in response:
1011                 metadata["metadata"]["metrics"] = response["metrics"]
1012             if "trace" in response:
1013                 metadata["metadata"]["trace"] = response["trace"]
1014             yield metadata
1015 
1016     def _find_detected_and_blocked_policy(self, input: Any) -> bool:
1017         """Recursively checks if the assessment contains a detected and blocked guardrail.
1018 
1019         Args:
1020             input: The assessment to check.
1021 
1022         Returns:
1023             True if the input contains a detected and blocked guardrail, False otherwise.
1024 
1025         """
1026         # Check if input is a dictionary
1027         if isinstance(input, dict):
1028             # Check if current dictionary has action: BLOCKED and detected: true
1029             if input.get("action") == "BLOCKED" and input.get("detected") and isinstance(input.get("detected"), bool):
1030                 return True
1031 
1032             # Otherwise, recursively check all values in the dictionary
1033             return self._find_detected_and_blocked_policy(input.values())
1034 
1035         elif isinstance(input, (list, ValuesView)):
1036             # Handle case where input is a list or dict_values
1037             return any(self._find_detected_and_blocked_policy(item) for item in input)
1038         # Otherwise return False
1039         return False
1040 
1041     @override
1042     async def structured_output(
1043         self,
1044         output_model: type[T],
1045         prompt: Messages,
1046         system_prompt: str | None = None,
1047         **kwargs: Any,
1048     ) -> AsyncGenerator[dict[str, T | Any], None]:
1049         """Get structured output from the model.
1050 
1051         Args:
1052             output_model: The output model to use for the agent.
1053             prompt: The prompt messages to use for the agent.
1054             system_prompt: System prompt to provide context to the model.
1055             **kwargs: Additional keyword arguments for future extensibility.
1056 
1057         Yields:
1058             Model events with the last being the structured output.
1059         """
1060         tool_spec = convert_pydantic_to_tool_spec(output_model)
1061 
1062         response = self.stream(
1063             messages=prompt,
1064             tool_specs=[tool_spec],
1065             system_prompt=system_prompt,
1066             tool_choice=cast(ToolChoice, {"any": {}}),
1067             **kwargs,
1068         )
1069         async for event in streaming.process_stream(response):
1070             yield event
1071 
1072         stop_reason, messages, _, _ = event["stop"]
1073 
1074         if stop_reason != "tool_use":
1075             raise ValueError(f'Model returned stop_reason: {stop_reason} instead of "tool_use".')
1076 
1077         content = messages["content"]
1078         output_response: dict[str, Any] | None = None
1079         for block in content:
1080             # if the tool use name doesn't match the tool spec name, skip, and if the block is not a tool use, skip.
1081             # if the tool use name never matches, raise an error.
1082             if block.get("toolUse") and block["toolUse"]["name"] == tool_spec["name"]:
1083                 output_response = block["toolUse"]["input"]
1084             else:
1085                 continue
1086 
1087         if output_response is None:
1088             raise ValueError("No valid tool use or tool use input was found in the Bedrock response.")
1089 
1090         yield {"output": output_model(**output_response)}
1091 
1092     @staticmethod
1093     def _get_default_model_with_warning(region_name: str, model_config: BedrockConfig | None = None) -> str:
1094         """Get the default Bedrock modelId based on region.
1095 
1096         If the region is not **known** to support inference then we show a helpful warning
1097         that compliments the exception that Bedrock will throw.
1098         If the customer provided a model_id in their config or they overrode the `DEFAULT_BEDROCK_MODEL_ID`
1099         then we should not process further.
1100 
1101         Args:
1102             region_name (str): region for bedrock model
1103             model_config (Optional[dict[str, Any]]): Model Config that caller passes in on init
1104         """
1105         if DEFAULT_BEDROCK_MODEL_ID != _DEFAULT_BEDROCK_MODEL_ID.format("us"):
1106             return DEFAULT_BEDROCK_MODEL_ID
1107 
1108         model_config = model_config or {}
1109         if model_config.get("model_id"):
1110             return model_config["model_id"]
1111 
1112         prefix_inference_map = {"ap": "apac"}  # some inference endpoints can be a bit different than the region prefix
1113 
1114         prefix = "-".join(region_name.split("-")[:-2]).lower()  # handles `us-east-1` or `us-gov-east-1`
1115         if prefix not in {"us", "eu", "ap", "us-gov"}:
1116             warnings.warn(
1117                 f"""
1118             ================== WARNING ==================
1119 
1120                 This region {region_name} does not support
1121                 our default inference endpoint: {_DEFAULT_BEDROCK_MODEL_ID.format(prefix)}.
1122                 Update the agent to pass in a 'model_id' like so:
1123                 ```
1124                 Agent(..., model='valid_model_id', ...)
1125                 ````
1126                 Documentation: https://docs.aws.amazon.com/bedrock/latest/userguide/inference-profiles-support.html
1127 
1128             ==================================================
1129             """,
1130                 stacklevel=2,
1131             )
1132 
