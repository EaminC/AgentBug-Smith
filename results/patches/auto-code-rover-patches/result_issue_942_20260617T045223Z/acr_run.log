33 class Agent:
34     """Agent class for interacting with Auto-GPT.
35 
36     Attributes:
37         ai_name: The name of the agent.
38         memory: The memory object to use.
39         next_action_count: The number of actions to execute.
40         system_prompt: The system prompt is the initial prompt that defines everything
41           the AI needs to know to achieve its task successfully.
42         Currently, the dynamic and customizable information in the system prompt are
43           ai_name, description and goals.
44 
45         triggering_prompt: The last sentence the AI will see before answering.
46             For Auto-GPT, this prompt is:
47             Determine which next command to use, and respond using the format specified
48               above:
49             The triggering prompt is not part of the system prompt because between the
50               system prompt and the triggering
51             prompt we have contextual information that can distract the AI and make it
52               forget that its goal is to find the next task to achieve.
53             SYSTEM PROMPT
54             CONTEXTUAL INFORMATION (memory, previous conversations, anything relevant)
55             TRIGGERING PROMPT
56 
57         The triggering prompt reminds the AI about its short term meta task
58         (defining the next task)
59     """
60 
61     def __init__(
62         self,
63         ai_name: str,
64         memory: VectorMemory,
65         next_action_count: int,
66         command_registry: CommandRegistry,
67         config: AIConfig,
68         system_prompt: str,
69         triggering_prompt: str,
70         workspace_directory: str,
71     ):
72         cfg = Config()
73         self.ai_name = ai_name
74         self.memory = memory
75         self.history = MessageHistory(self)
76         self.next_action_count = next_action_count
77         self.command_registry = command_registry
78         self.config = config
79         self.system_prompt = system_prompt
80         self.triggering_prompt = triggering_prompt
81         self.workspace = Workspace(workspace_directory, cfg.restrict_to_workspace)
82         self.created_at = datetime.now().strftime("%Y%m%d_%H%M%S")
83         self.cycle_count = 0
84         self.log_cycle_handler = LogCycleHandler()
85 
86     def start_interaction_loop(self):
87         # Interaction Loop
88         cfg = Config()
89         self.cycle_count = 0
90         command_name = None
91         arguments = None
92         user_input = ""
93 
94         # Signal handler for interrupting y -N
95         def signal_handler(signum, frame):
96             if self.next_action_count == 0:
97                 sys.exit()
98             else:
99                 print(
100                     Fore.RED
101                     + "Interrupt signal received. Stopping continuous command execution."
102                     + Style.RESET_ALL
103                 )
104                 self.next_action_count = 0
105 
106         signal.signal(signal.SIGINT, signal_handler)
107 
108         while True:
109             # Discontinue if continuous limit is reached
110             self.cycle_count += 1
111             self.log_cycle_handler.log_count_within_cycle = 0
112             self.log_cycle_handler.log_cycle(
113                 self.config.ai_name,
114                 self.created_at,
115                 self.cycle_count,
116                 [m.raw() for m in self.history],
117                 FULL_MESSAGE_HISTORY_FILE_NAME,
118             )
119             if (
120                 cfg.continuous_mode
121                 and cfg.continuous_limit > 0
122                 and self.cycle_count > cfg.continuous_limit
123             ):
124                 logger.typewriter_log(
125                     "Continuous Limit Reached: ", Fore.YELLOW, f"{cfg.continuous_limit}"
126                 )
127                 break
128             # Send message to AI, get response
129             with Spinner("Thinking... ", plain_output=cfg.plain_output):
130                 assistant_reply = chat_with_ai(
131                     self,
132                     self.system_prompt,
133                     self.triggering_prompt,
134                     cfg.fast_token_limit,
135                 )  # TODO: This hardcodes the model to use GPT3.5. Make this an argument
136 
137             assistant_reply_json = fix_json_using_multiple_techniques(assistant_reply)
138             for plugin in cfg.plugins:
139                 if not plugin.can_handle_post_planning():
140                     continue
141                 assistant_reply_json = plugin.post_planning(assistant_reply_json)
142 
143             # Print Assistant thoughts
144             if assistant_reply_json != {}:
145                 validate_json(assistant_reply_json, LLM_DEFAULT_RESPONSE_FORMAT)
146                 # Get command name and arguments
147                 try:
148                     print_assistant_thoughts(
149                         self.ai_name, assistant_reply_json, cfg.speak_mode
150                     )
151                     command_name, arguments = get_command(assistant_reply_json)
152                     if cfg.speak_mode:
153                         say_text(f"I want to execute {command_name}")
154 
155                     arguments = self._resolve_pathlike_command_args(arguments)
156 
157                 except Exception as e:
158                     logger.error("Error: \n", str(e))
159             self.log_cycle_handler.log_cycle(
160                 self.config.ai_name,
161                 self.created_at,
162                 self.cycle_count,
163                 assistant_reply_json,
164                 NEXT_ACTION_FILE_NAME,
165             )
166 
167             logger.typewriter_log(
168                 "NEXT ACTION: ",
169                 Fore.CYAN,
170                 f"COMMAND = {Fore.CYAN}{command_name}{Style.RESET_ALL}  "
171                 f"ARGUMENTS = {Fore.CYAN}{arguments}{Style.RESET_ALL}",
172             )
173 
174             if not cfg.continuous_mode and self.next_action_count == 0:
175                 # ### GET USER AUTHORIZATION TO EXECUTE COMMAND ###
176                 # Get key press: Prompt the user to press enter to continue or escape
177                 # to exit
178                 self.user_input = ""
179                 logger.info(
180                     "Enter 'y' to authorise command, 'y -N' to run N continuous commands, 's' to run self-feedback commands, "
181                     "'n' to exit program, or enter feedback for "
182                     f"{self.ai_name}..."
183                 )
184                 while True:
185                     if cfg.chat_messages_enabled:
186                         console_input = clean_input("Waiting for your response...")
187                     else:
188                         console_input = clean_input(
189                             Fore.MAGENTA + "Input:" + Style.RESET_ALL
190                         )
191                     if console_input.lower().strip() == cfg.authorise_key:
192                         user_input = "GENERATE NEXT COMMAND JSON"
193                         break
194                     elif console_input.lower().strip() == "s":
195                         logger.typewriter_log(
196                             "-=-=-=-=-=-=-= THOUGHTS, REASONING, PLAN AND CRITICISM WILL NOW BE VERIFIED BY AGENT -=-=-=-=-=-=-=",
197                             Fore.GREEN,
198                             "",
199                         )
200                         thoughts = assistant_reply_json.get("thoughts", {})
201                         self_feedback_resp = self.get_self_feedback(
202                             thoughts, cfg.fast_llm_model
203                         )
204                         logger.typewriter_log(
205                             f"SELF FEEDBACK: {self_feedback_resp}",
206                             Fore.YELLOW,
207                             "",
208                         )
209                         user_input = self_feedback_resp
210                         command_name = "self_feedback"
211                         break
212                     elif console_input.lower().strip() == "":
213                         logger.warn("Invalid input format.")
214                         continue
215                     elif console_input.lower().startswith(f"{cfg.authorise_key} -"):
216                         try:
217                             self.next_action_count = abs(
218                                 int(console_input.split(" ")[1])
219                             )
220                             user_input = "GENERATE NEXT COMMAND JSON"
221                         except ValueError:
222                             logger.warn(
223                                 "Invalid input format. Please enter 'y -n' where n is"
224                                 " the number of continuous tasks."
225                             )
226                             continue
227                         break
228                     elif console_input.lower() == cfg.exit_key:
229                         user_input = "EXIT"
230                         break
231                     else:
232                         user_input = console_input
233                         command_name = "human_feedback"
234                         self.log_cycle_handler.log_cycle(
235                             self.config.ai_name,
236                             self.created_at,
237                             self.cycle_count,
238                             user_input,
239                             USER_INPUT_FILE_NAME,
240                         )
241                         break
242 
243                 if user_input == "GENERATE NEXT COMMAND JSON":
244                     logger.typewriter_log(
245                         "-=-=-=-=-=-=-= COMMAND AUTHORISED BY USER -=-=-=-=-=-=-=",
246                         Fore.MAGENTA,
247                         "",
248                     )
249                 elif user_input == "EXIT":
250                     logger.info("Exiting...")
251                     break
252             else:
253                 # Print authorized commands left value
254                 logger.typewriter_log(
255                     f"{Fore.CYAN}AUTHORISED COMMANDS LEFT: {Style.RESET_ALL}{self.next_action_count}"
256                 )
257 
258             # Execute command
259             if command_name is not None and command_name.lower().startswith("error"):
260                 result = f"Could not execute command: {arguments}"
261             elif command_name == "human_feedback":
262                 result = f"Human feedback: {user_input}"
263             elif command_name == "self_feedback":
264                 result = f"Self feedback: {user_input}"
265             else:
266                 for plugin in cfg.plugins:
267                     if not plugin.can_handle_pre_command():
268                         continue
269                     command_name, arguments = plugin.pre_command(
270                         command_name, arguments
271                     )
272                 command_result = execute_command(
273                     self.command_registry,
274                     command_name,
275                     arguments,
276                     self.config.prompt_generator,
277                     config=cfg,
278                 )
279                 result = f"Command {command_name} returned: " f"{command_result}"
280 
281                 result_tlength = count_string_tokens(
282                     str(command_result), cfg.fast_llm_model
283                 )
284                 memory_tlength = count_string_tokens(
285                     str(self.history.summary_message()), cfg.fast_llm_model
286                 )
287                 if result_tlength + memory_tlength + 600 > cfg.fast_token_limit:
288                     result = f"Failure: command {command_name} returned too much output. \
289                         Do not execute this command again with the same arguments."
290 
291                 for plugin in cfg.plugins:
292                     if not plugin.can_handle_post_command():
293                         continue
294                     result = plugin.post_command(command_name, result)
295                 if self.next_action_count > 0:
296                     self.next_action_count -= 1
297 
298             # Check if there's a result from the command append it to the message
299             # history
300             if result is not None:
301                 self.history.add("system", result, "action_result")
302                 logger.typewriter_log("SYSTEM: ", Fore.YELLOW, result)
303             else:
304                 self.history.add("system", "Unable to execute command", "action_result")
305                 logger.typewriter_log(
306                     "SYSTEM: ", Fore.YELLOW, "Unable to execute command"
307                 )
308 
309     def _resolve_pathlike_command_args(self, command_args):
310         if "directory" in command_args and command_args["directory"] in {"", "/"}:
311             command_args["directory"] = str(self.workspace.root)
312         else:
313             for pathlike in ["filename", "directory", "clone_path"]:
314                 if pathlike in command_args:
315                     command_args[pathlike] = str(
316                         self.workspace.get_path(command_args[pathlike])
317                     )
318         return command_args
319 
320     def get_self_feedback(self, thoughts: dict, llm_model: str) -> str:
321         """Generates a feedback response based on the provided thoughts dictionary.
322         This method takes in a dictionary of thoughts containing keys such as 'reasoning',
323         'plan', 'thoughts', and 'criticism'. It combines these elements into a single
324         feedback message and uses the create_chat_completion() function to generate a
325         response based on the input message.
326         Args:
327             thoughts (dict): A dictionary containing thought elements like reasoning,
328             plan, thoughts, and criticism.
329         Returns:
330             str: A feedback response generated using the provided thoughts dictionary.
331         """
332         ai_role = self.config.ai_role
333 
334         feedback_prompt = f"Below is a message from me, an AI Agent, assuming the role of {ai_role}. whilst keeping knowledge of my slight limitations as an AI Agent Please evaluate my thought process, reasoning, and plan, and provide a concise paragraph outlining potential improvements. Consider adding or removing ideas that do not align with my role and explaining why, prioritizing thoughts based on their significance, or simply refining my overall thought process."
335         reasoning = thoughts.get("reasoning", "")
336         plan = thoughts.get("plan", "")
337         thought = thoughts.get("thoughts", "")
338         feedback_thoughts = thought + reasoning + plan
339 
340         prompt = ChatSequence.for_model(llm_model)
341         prompt.add("user", feedback_prompt + feedback_thoughts)
342 
343         self.log_cycle_handler.log_cycle(
344             self.config.ai_name,
345             self.created_at,
346             self.cycle_count,
347             prompt.raw(),
348             PROMPT_SUPERVISOR_FEEDBACK_FILE_NAME,
349         )
350 
351         feedback = create_chat_completion(prompt)
352 
353         self.log_cycle_handler.log_cycle(
354             self.config.ai_name,
355             self.created_at,
356             self.cycle_count,
357             feedback,
358             SUPERVISOR_FEEDBACK_FILE_NAME,
359         )
360         return feedback

