367     def configure_model_settings(self, model):
368         # Look for exact model match
369         exact_match = False
370         for ms in MODEL_SETTINGS:
371             # direct match, or match "provider/<model>"
372             if model == ms.name:
373                 self._copy_fields(ms)
374                 exact_match = True
375                 break  # Continue to apply overrides
376 
377         # Initialize accepts_settings if it's None
378         if self.accepts_settings is None:
379             self.accepts_settings = []
380 
381         model = model.lower()
382 
383         # If no exact match, try generic settings
384         if not exact_match:
385             self.apply_generic_model_settings(model)
386 
387         # Apply override settings last if they exist
388         if (
389             self.extra_model_settings
390             and self.extra_model_settings.extra_params
391             and self.extra_model_settings.name == "aider/extra_params"
392         ):
393             # Initialize extra_params if it doesn't exist
394             if not self.extra_params:
395                 self.extra_params = {}
396 
397             # Deep merge the extra_params dicts
398             for key, value in self.extra_model_settings.extra_params.items():
399                 if isinstance(value, dict) and isinstance(self.extra_params.get(key), dict):
400                     # For nested dicts, merge recursively
401                     self.extra_params[key] = {**self.extra_params[key], **value}
402                 else:
403                     # For non-dict values, simply update
404                     self.extra_params[key] = value
405 
406         # Ensure OpenRouter models accept thinking_tokens and reasoning_effort
407         if self.name.startswith("openrouter/"):
408             if self.accepts_settings is None:
409                 self.accepts_settings = []
410             if "thinking_tokens" not in self.accepts_settings:
411                 self.accepts_settings.append("thinking_tokens")
412             if "reasoning_effort" not in self.accepts_settings:
413                 self.accepts_settings.append("reasoning_effort")
