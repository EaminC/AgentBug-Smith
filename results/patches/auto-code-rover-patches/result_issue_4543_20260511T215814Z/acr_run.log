1100 def validate_variables(vars):
1101     missing = []
1102     for var in vars:
1103         if var not in os.environ:
1104             missing.append(var)
1105     if missing:
1106         return dict(keys_in_environment=False, missing_keys=missing)
1107     return dict(keys_in_environment=True, missing_keys=missing)
