68 class Agent:
69     """Core Agent interface.
70 
71     An agent orchestrates the following workflow:
72 
73     1. Receives user input
74     2. Processes the input using a language model
75     3. Decides whether to use tools to gather information or perform actions
76     4. Executes those tools and receives results
77     5. Continues reasoning with the new information
78     6. Produces a final response
79     """
80 
81     class ToolCaller:
82         """Call tool as a function."""
83 
84         def __init__(self, agent: "Agent") -> None:
85             """Initialize instance.
86 
87             Args:
88                 agent: Agent reference that will accept tool results.
89             """
90             # WARNING: Do not add any other member variables or methods as this could result in a name conflict with
91             #          agent tools and thus break their execution.
92             self._agent = agent
93 
94         def __getattr__(self, name: str) -> Callable[..., Any]:
95             """Call tool as a function.
96 
97             This method enables the method-style interface (e.g., `agent.tool.tool_name(param="value")`).
98             It matches underscore-separated names to hyphenated tool names (e.g., 'some_thing' matches 'some-thing').
99 
100             Args:
101                 name: The name of the attribute (tool) being accessed.
102 
103             Returns:
104                 A function that when called will execute the named tool.
105 
106             Raises:
107                 AttributeError: If no tool with the given name exists or if multiple tools match the given name.
108             """
109 
110             def caller(
111                 user_message_override: Optional[str] = None,
112                 record_direct_tool_call: Optional[bool] = None,
113                 **kwargs: Any,
114             ) -> Any:
115                 """Call a tool directly by name.
116 
117                 Args:
118                     user_message_override: Optional custom message to record instead of default
119                     record_direct_tool_call: Whether to record direct tool calls in message history. Overrides class
120                         attribute if provided.
121                     **kwargs: Keyword arguments to pass to the tool.
122 
123                 Returns:
124                     The result returned by the tool.
125 
126                 Raises:
127                     AttributeError: If the tool doesn't exist.
128                 """
129                 normalized_name = self._find_normalized_tool_name(name)
130 
131                 # Create unique tool ID and set up the tool request
132                 tool_id = f"tooluse_{name}_{random.randint(100000000, 999999999)}"
133                 tool_use: ToolUse = {
134                     "toolUseId": tool_id,
135                     "name": normalized_name,
136                     "input": kwargs.copy(),
137                 }
138 
139                 async def acall() -> ToolResult:
140                     # Pass kwargs as invocation_state
141                     async for event in run_tool(self._agent, tool_use, kwargs):
142                         _ = event
143 
144                     return cast(ToolResult, event)
145 
146                 def tcall() -> ToolResult:
147                     return asyncio.run(acall())
148 
149                 with ThreadPoolExecutor() as executor:
150                     future = executor.submit(tcall)
151                     tool_result = future.result()
152 
153                 if record_direct_tool_call is not None:
154                     should_record_direct_tool_call = record_direct_tool_call
155                 else:
156                     should_record_direct_tool_call = self._agent.record_direct_tool_call
157 
158                 if should_record_direct_tool_call:
159                     # Create a record of this tool execution in the message history
160                     self._agent._record_tool_execution(
161                         tool_use, tool_result, user_message_override, self._agent.messages
162                     )
163 
164                 # Apply window management
165                 self._agent.conversation_manager.apply_management(self._agent)
166 
167                 return tool_result
168 
169             return caller
170 
171         def _find_normalized_tool_name(self, name: str) -> str:
172             """Lookup the tool represented by name, replacing characters with underscores as necessary."""
173             tool_registry = self._agent.tool_registry.registry
174 
175             if tool_registry.get(name, None):
176                 return name
177 
178             # If the desired name contains underscores, it might be a placeholder for characters that can't be
179             # represented as python identifiers but are valid as tool names, such as dashes. In that case, find
180             # all tools that can be represented with the normalized name
181             if "_" in name:
182                 filtered_tools = [
183                     tool_name for (tool_name, tool) in tool_registry.items() if tool_name.replace("-", "_") == name
184                 ]
185 
186                 # The registry itself defends against similar names, so we can just take the first match
187                 if filtered_tools:
188                     return filtered_tools[0]
189 
190             raise AttributeError(f"Tool '{name}' not found")
191 
192     def __init__(
193         self,
194         model: Union[Model, str, None] = None,
195         messages: Optional[Messages] = None,
196         tools: Optional[list[Union[str, dict[str, str], Any]]] = None,
197         system_prompt: Optional[str] = None,
198         callback_handler: Optional[
199             Union[Callable[..., Any], _DefaultCallbackHandlerSentinel]
200         ] = _DEFAULT_CALLBACK_HANDLER,
201         conversation_manager: Optional[ConversationManager] = None,
202         record_direct_tool_call: bool = True,
203         load_tools_from_directory: bool = False,
204         trace_attributes: Optional[Mapping[str, AttributeValue]] = None,
205         *,
206         agent_id: Optional[str] = None,
207         name: Optional[str] = None,
208         description: Optional[str] = None,
209         state: Optional[Union[AgentState, dict]] = None,
210         hooks: Optional[list[HookProvider]] = None,
211         session_manager: Optional[SessionManager] = None,
212     ):
213         """Initialize the Agent with the specified configuration.
214 
215         Args:
216             model: Provider for running inference or a string representing the model-id for Bedrock to use.
217                 Defaults to strands.models.BedrockModel if None.
218             messages: List of initial messages to pre-load into the conversation.
219                 Defaults to an empty list if None.
220             tools: List of tools to make available to the agent.
221                 Can be specified as:
222 
223                 - String tool names (e.g., "retrieve")
224                 - File paths (e.g., "/path/to/tool.py")
225                 - Imported Python modules (e.g., from strands_tools import current_time)
226                 - Dictionaries with name/path keys (e.g., {"name": "tool_name", "path": "/path/to/tool.py"})
227                 - Functions decorated with `@strands.tool` decorator.
228 
229                 If provided, only these tools will be available. If None, all tools will be available.
230             system_prompt: System prompt to guide model behavior.
231                 If None, the model will behave according to its default settings.
232             callback_handler: Callback for processing events as they happen during agent execution.
233                 If not provided (using the default), a new PrintingCallbackHandler instance is created.
234                 If explicitly set to None, null_callback_handler is used.
235             conversation_manager: Manager for conversation history and context window.
236                 Defaults to strands.agent.conversation_manager.SlidingWindowConversationManager if None.
237             record_direct_tool_call: Whether to record direct tool calls in message history.
238                 Defaults to True.
239             load_tools_from_directory: Whether to load and automatically reload tools in the `./tools/` directory.
240                 Defaults to False.
241             trace_attributes: Custom trace attributes to apply to the agent's trace span.
242             agent_id: Optional ID for the agent, useful for session management and multi-agent scenarios.
243                 Defaults to "default".
244             name: name of the Agent
245                 Defaults to "Strands Agents".
246             description: description of what the Agent does
247                 Defaults to None.
248             state: stateful information for the agent. Can be either an AgentState object, or a json serializable dict.
249                 Defaults to an empty AgentState object.
250             hooks: hooks to be added to the agent hook registry
251                 Defaults to None.
252             session_manager: Manager for handling agent sessions including conversation history and state.
253                 If provided, enables session-based persistence and state management.
254         """
255         self.model = BedrockModel() if not model else BedrockModel(model_id=model) if isinstance(model, str) else model
256         self.messages = messages if messages is not None else []
257 
258         self.system_prompt = system_prompt
259         self.agent_id = agent_id or _DEFAULT_AGENT_ID
260         self.name = name or _DEFAULT_AGENT_NAME
261         self.description = description
262 
263         # If not provided, create a new PrintingCallbackHandler instance
264         # If explicitly set to None, use null_callback_handler
265         # Otherwise use the passed callback_handler
266         self.callback_handler: Union[Callable[..., Any], PrintingCallbackHandler]
267         if isinstance(callback_handler, _DefaultCallbackHandlerSentinel):
268             self.callback_handler = PrintingCallbackHandler()
269         elif callback_handler is None:
270             self.callback_handler = null_callback_handler
271         else:
272             self.callback_handler = callback_handler
273 
274         self.conversation_manager = conversation_manager if conversation_manager else SlidingWindowConversationManager()
275 
276         # Process trace attributes to ensure they're of compatible types
277         self.trace_attributes: dict[str, AttributeValue] = {}
278         if trace_attributes:
279             for k, v in trace_attributes.items():
280                 if isinstance(v, (str, int, float, bool)) or (
281                     isinstance(v, list) and all(isinstance(x, (str, int, float, bool)) for x in v)
282                 ):
283                     self.trace_attributes[k] = v
284 
285         self.record_direct_tool_call = record_direct_tool_call
286         self.load_tools_from_directory = load_tools_from_directory
287 
288         self.tool_registry = ToolRegistry()
289 
290         # Process tool list if provided
291         if tools is not None:
292             self.tool_registry.process_tools(tools)
293 
294         # Initialize tools and configuration
295         self.tool_registry.initialize_tools(self.load_tools_from_directory)
296         if load_tools_from_directory:
297             self.tool_watcher = ToolWatcher(tool_registry=self.tool_registry)
298 
299         self.event_loop_metrics = EventLoopMetrics()
300 
301         # Initialize tracer instance (no-op if not configured)
302         self.tracer = get_tracer()
303         self.trace_span: Optional[trace.Span] = None
304 
305         # Initialize agent state management
306         if state is not None:
307             if isinstance(state, dict):
308                 self.state = AgentState(state)
309             elif isinstance(state, AgentState):
310                 self.state = state
311             else:
312                 raise ValueError("state must be an AgentState object or a dict")
313         else:
314             self.state = AgentState()
315 
316         self.tool_caller = Agent.ToolCaller(self)
317 
318         self.hooks = HookRegistry()
319 
320         # Initialize session management functionality
321         self._session_manager = session_manager
322         if self._session_manager:
323             self.hooks.add_hook(self._session_manager)
324 
325         if hooks:
326             for hook in hooks:
327                 self.hooks.add_hook(hook)
328         self.hooks.invoke_callbacks(AgentInitializedEvent(agent=self))
329 
330     @property
331     def tool(self) -> ToolCaller:
332         """Call tool as a function.
333 
334         Returns:
335             Tool caller through which user can invoke tool as a function.
336 
337         Example:
338             ```
339             agent = Agent(tools=[calculator])
340             agent.tool.calculator(...)
341             ```
342         """
343         return self.tool_caller
344 
345     @property
346     def tool_names(self) -> list[str]:
347         """Get a list of all registered tool names.
348 
349         Returns:
350             Names of all tools available to this agent.
351         """
352         all_tools = self.tool_registry.get_all_tools_config()
353         return list(all_tools.keys())
354 
355     def __call__(self, prompt: Union[str, list[ContentBlock]], **kwargs: Any) -> AgentResult:
356         """Process a natural language prompt through the agent's event loop.
357 
358         This method implements the conversational interface (e.g., `agent("hello!")`). It adds the user's prompt to
359         the conversation history, processes it through the model, executes any tool calls, and returns the final result.
360 
361         Args:
362             prompt: User input as text or list of ContentBlock objects for multi-modal content.
363             **kwargs: Additional parameters to pass through the event loop.
364 
365         Returns:
366             Result object containing:
367 
