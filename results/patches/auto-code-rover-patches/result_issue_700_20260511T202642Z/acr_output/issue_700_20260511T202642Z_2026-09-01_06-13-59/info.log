395     def token_count_for_image(self, fname):
396         """
397         Calculate the token cost for an image assuming high detail.
398         The token cost is determined by the size of the image.
399         :param fname: The filename of the image.
400         :return: The token cost for the image.
401         """
402         width, height = self.get_image_size(fname)
403 
404         # If the image is larger than 2048 in any dimension, scale it down to fit within 2048x2048
405         max_dimension = max(width, height)
406         if max_dimension > 2048:
407             scale_factor = 2048 / max_dimension
408             width = int(width * scale_factor)
409             height = int(height * scale_factor)
410 
411         # Scale the image such that the shortest side is 768 pixels long
412         min_dimension = min(width, height)
413         scale_factor = 768 / min_dimension
414         width = int(width * scale_factor)
415         height = int(height * scale_factor)
416 
417         # Calculate the number of 512x512 tiles needed to cover the image
418         tiles_width = math.ceil(width / 512)
419         tiles_height = math.ceil(height / 512)
420         num_tiles = tiles_width * tiles_height
421 
422         # Each tile costs 170 tokens, and there's an additional fixed cost of 85 tokens
423         token_cost = num_tiles * 170 + 85
424         return token_cost
425 
426     def get_image_size(self, fname):
427         """
428         Retrieve the size of an image.
429         :param fname: The filename of the image.
430         :return: A tuple (width, height) representing the image size in pixels.
431         """
432         with Image.open(fname) as img:
433             return img.size
434 
435     def validate_environment(self):
436         # https://github.com/BerriAI/litellm/issues/3190
437 
438         model = self.name
439         res = litellm.validate_environment(model)
440         if res["keys_in_environment"]:
441             return res
442         if res["missing_keys"]:
443             return res
444 
445         provider = self.info.get("litellm_provider", "").lower()
446         if provider == "cohere_chat":
447             return validate_variables(["COHERE_API_KEY"])
448         if provider == "gemini":
449             return validate_variables(["GEMINI_API_KEY"])
450         if provider == "groq":
451             return validate_variables(["GROQ_API_KEY"])
452 
453         return res

