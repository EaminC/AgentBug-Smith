542     @asynccontextmanager
543     async def _cursor(
544         self, *, pipeline: bool = False
545     ) -> AsyncIterator[AsyncCursor[DictRow]]:
546         """Create a database cursor as a context manager.
547 
548         Args:
549             pipeline: whether to use pipeline for the DB operations inside the context manager.
550                 Will be applied regardless of whether the PostgresStore instance was initialized with a pipeline.
551                 If pipeline mode is not supported, will fall back to using transaction context manager.
552         """
553         async with _ainternal.get_connection(self.conn) as conn:
554             if self.pipe:
555                 # a connection in pipeline mode can be used concurrently
556                 # in multiple threads/coroutines, but only one cursor can be
557                 # used at a time
558                 try:
559                     async with conn.cursor(binary=True, row_factory=dict_row) as cur:
560                         yield cur
561                 finally:
562                     if pipeline:
563                         await self.pipe.sync()
564             elif pipeline:
565                 # a connection not in pipeline mode can only be used by one
566                 # thread/coroutine at a time, so we acquire a lock
567                 if self.supports_pipeline:
568                     async with (
569                         self.lock,
570                         conn.pipeline(),
571                         conn.cursor(binary=True, row_factory=dict_row) as cur,
572                     ):
573                         yield cur
574                 else:
575                     async with (
576                         self.lock,
577                         conn.transaction(),
578                         conn.cursor(binary=True, row_factory=dict_row) as cur,
579                     ):
580                         yield cur
581             else:
582                 async with (
583                     self.lock,
584                     conn.cursor(binary=True, row_factory=dict_row) as cur,
585                 ):
586                     yield cur

</code><intended_behavior>Add a get_next_version method to AsyncPostgresStore, similar to the implementation in BasePostgresSaver, which generates the next checkpoint version string based on the current version. This will ensure AsyncPostgresStore properly supports checkpoint versioning and can be used as a checkpointer without raising AttributeError, maintaining all existing asynchronous behavior and store functionalities.</intended_behavior>]
