228     async def setup(self) -> None:
229         """Set up the store database asynchronously.
230 
231         This method creates the necessary tables in the Postgres database if they don't
232         already exist and runs database migrations. It MUST be called directly by the user
233         the first time the store is used.
234         """
235 
236         async def _get_version(cur: AsyncCursor[DictRow], table: str) -> int:
237             await cur.execute(
238                 f"""
239                 CREATE TABLE IF NOT EXISTS {table} (
240                     v INTEGER PRIMARY KEY
241                 )
242             """
243             )
244             await cur.execute(f"SELECT v FROM {table} ORDER BY v DESC LIMIT 1")
245             row = cast(dict, await cur.fetchone())
246             if row is None:
247                 version = -1
248             else:
249                 version = row["v"]
250             return version
251 
252         async with self._cursor() as cur:
253             version = await _get_version(cur, table="store_migrations")
254             for v, sql in enumerate(self.MIGRATIONS[version + 1 :], start=version + 1):
255                 await cur.execute(sql)
256                 await cur.execute("INSERT INTO store_migrations (v) VALUES (%s)", (v,))
257 
258             if self.index_config:
259                 version = await _get_version(cur, table="vector_migrations")
260                 for v, migration in enumerate(
261                     self.VECTOR_MIGRATIONS[version + 1 :], start=version + 1
262                 ):
263                     sql = migration.sql
264                     if migration.params:
265                         params = {
266                             k: v(self) if v is not None and callable(v) else v
267                             for k, v in migration.params.items()
268                         }
269                         if "dims" in params:
270                             try:
271                                 params["dims"] = int(params["dims"])
272                             except Exception as e:
273                                 raise ValueError(
274                                     f"Invalid dims for vector index: {params['dims']}"
275                                 ) from e
276                         if "vector_type" in params:
277                             vt = str(params["vector_type"])
278                             if vt not in ("vector", "halfvec"):
279                                 raise ValueError(
280                                     f"Invalid vector_type for pgvector: {vt}"
281                                 )
282                             params["vector_type"] = vt
283                         if "index_type" in params:
284                             it = str(params["index_type"])
285                             if it not in ("hnsw", "ivfflat"):
286                                 raise ValueError(
287                                     f"Invalid index_type for pgvector: {it}"
288                                 )
289                             params["index_type"] = it
290                         sql = sql % params
291                     await cur.execute(sql)
292                     await cur.execute(
293                         "INSERT INTO vector_migrations (v) VALUES (%s)", (v,)
294                     )
295 
296     async def sweep_ttl(self) -> int:
297         """Delete expired store items based on TTL.
298 
299         Returns:
300             int: The number of deleted items.
301         """
302         async with self._cursor() as cur:
303             await cur.execute(
304                 """
305                 DELETE FROM store
306                 WHERE expires_at IS NOT NULL AND expires_at < NOW()
307                 """
308             )
309             deleted_count = cur.rowcount
310             return deleted_count
311 
312     async def start_ttl_sweeper(
313         self, sweep_interval_minutes: int | None = None
314     ) -> asyncio.Task[None]:
315         """Periodically delete expired store items based on TTL.
316 
317         Returns:
318             Task that can be awaited or cancelled.
319         """
320         if not self.ttl_config:
321             return asyncio.create_task(asyncio.sleep(0))
322 
323         if self._ttl_sweeper_task is not None and not self._ttl_sweeper_task.done():
324             return self._ttl_sweeper_task
325 
326         self._ttl_stop_event.clear()
327 
328         interval = float(
329             sweep_interval_minutes or self.ttl_config.get("sweep_interval_minutes") or 5
330         )
331         logger.info(f"Starting store TTL sweeper with interval {interval} minutes")
332 
333         async def _sweep_loop() -> None:
334             while not self._ttl_stop_event.is_set():
335                 try:
336                     try:
337                         await asyncio.wait_for(
338                             self._ttl_stop_event.wait(),
339                             timeout=interval * 60,
340                         )
341                         break
342                     except asyncio.TimeoutError:
343                         pass
344 
345                     expired_items = await self.sweep_ttl()
346                     if expired_items > 0:
347                         logger.info(f"Store swept {expired_items} expired items")
348                 except asyncio.CancelledError:
349                     break
350                 except Exception as exc:
351                     logger.exception("Store TTL sweep iteration failed", exc_info=exc)
352 
353         task = asyncio.create_task(_sweep_loop())
354         task.set_name("ttl_sweeper")
355         self._ttl_sweeper_task = task
356         return task
357 
358     async def stop_ttl_sweeper(self, timeout: float | None = None) -> bool:
359         """Stop the TTL sweeper task if it's running.
360 
361         Args:
362             timeout: Maximum time to wait for the task to stop, in seconds.
363                 If `None`, wait indefinitely.
364 
365         Returns:
366             bool: True if the task was successfully stopped or wasn't running,
367                 False if the timeout was reached before the task stopped.
368         """
369         if self._ttl_sweeper_task is None or self._ttl_sweeper_task.done():
370             return True
371 
372         logger.info("Stopping TTL sweeper task")
373         self._ttl_stop_event.set()
374 
375         if timeout is not None:
376             try:
377                 await asyncio.wait_for(self._ttl_sweeper_task, timeout=timeout)
378                 success = True
379             except asyncio.TimeoutError:
380                 success = False
381         else:
382             await self._ttl_sweeper_task
383             success = True
384 
385         if success:
386             self._ttl_sweeper_task = None
387             logger.info("TTL sweeper task stopped")
388         else:
389             logger.warning("Timed out waiting for TTL sweeper task to stop")
390 
391         return success
392 
393     async def __aenter__(self) -> AsyncPostgresStore:
394         return self
395 
396     async def __aexit__(
397         self,
398         exc_type: type[BaseException] | None,
399         exc_val: BaseException | None,
400         exc_tb: TracebackType | None,
401     ) -> None:
402         # Ensure the TTL sweeper task is stopped when exiting the context
403         if hasattr(self, "_ttl_sweeper_task") and self._ttl_sweeper_task is not None:
404             # Set the event to signal the task to stop
405             self._ttl_stop_event.set()
406             # We don't wait for the task to complete here to avoid blocking
407             # The task will clean up itself gracefully
408 
409     async def _execute_batch(
410         self,
411         grouped_ops: dict,
412         results: list[Result],
413         conn: AsyncConnection[DictRow],
414     ) -> None:
415         async with self._cursor(pipeline=True) as cur:
416             if GetOp in grouped_ops:
417                 await self._batch_get_ops(
418                     cast(Sequence[tuple[int, GetOp]], grouped_ops[GetOp]),
419                     results,
420                     cur,
421                 )
422 
423             if SearchOp in grouped_ops:
424                 await self._batch_search_ops(
425                     cast(Sequence[tuple[int, SearchOp]], grouped_ops[SearchOp]),
426                     results,
427                     cur,
428                 )
429 
430             if ListNamespacesOp in grouped_ops:
431                 await self._batch_list_namespaces_ops(
432                     cast(
433                         Sequence[tuple[int, ListNamespacesOp]],
434                         grouped_ops[ListNamespacesOp],
435                     ),
436                     results,
437                     cur,
438                 )
439 
440             if PutOp in grouped_ops:
441                 await self._batch_put_ops(
442                     cast(Sequence[tuple[int, PutOp]], grouped_ops[PutOp]),
443                     cur,
444                 )
445 
446     async def _batch_get_ops(
447         self,
448         get_ops: Sequence[tuple[int, GetOp]],
449         results: list[Result],
450         cur: AsyncCursor[DictRow],
451     ) -> None:
452         for query, params, namespace, items in self._get_batch_GET_ops_queries(get_ops):
453             await cur.execute(query, params)
454             rows = cast(list[Row], await cur.fetchall())
455             key_to_row = {row["key"]: row for row in rows}
456             for idx, key in items:
457                 row = key_to_row.get(key)
458                 if row:
459                     results[idx] = _row_to_item(
460                         namespace, row, loader=self._deserializer
461                     )
462                 else:
463                     results[idx] = None
464 
465     async def _batch_put_ops(
466         self,
467         put_ops: Sequence[tuple[int, PutOp]],
468         cur: AsyncCursor[DictRow],
469     ) -> None:
470         queries, embedding_request = self._prepare_batch_PUT_queries(put_ops)
471         if embedding_request:
472             if self.embeddings is None:
473                 # Should not get here since the embedding config is required
474                 # to return an embedding_request above
475                 raise ValueError(
476                     "Embedding configuration is required for vector operations "
477                     f"(for semantic search). "
478                     f"Please provide an EmbeddingConfig when initializing the {self.__class__.__name__}."
479                 )
480             query, txt_params = embedding_request
481             vectors = await self.embeddings.aembed_documents(
482                 [param[-1] for param in txt_params]
483             )
484             queries.append(
485                 (
486                     query,
487                     [
488                         p
489                         for (ns, k, pathname, _), vector in zip(
490                             txt_params, vectors, strict=False
491                         )
492                         for p in (ns, k, pathname, vector)
493                     ],
494                 )
495             )
496 
497         for query, params in queries:
498             await cur.execute(query, params)
499 
500     async def _batch_search_ops(
501         self,
502         search_ops: Sequence[tuple[int, SearchOp]],
503         results: list[Result],
504         cur: AsyncCursor[DictRow],
505     ) -> None:
506         queries, embedding_requests = self._prepare_batch_search_queries(search_ops)
507 
508         if embedding_requests and self.embeddings:
509             vectors = await self.embeddings.aembed_documents(
510                 [query for _, query in embedding_requests]
511             )
512             for (idx, _), vector in zip(embedding_requests, vectors, strict=False):
513                 _paramslist = queries[idx][1]
514                 for i in range(len(_paramslist)):
515                     if _paramslist[i] is PLACEHOLDER:
516                         _paramslist[i] = vector
517 
518         for (idx, _), (query, params) in zip(search_ops, queries, strict=False):
519             await cur.execute(query, params)
520             rows = cast(list[Row], await cur.fetchall())
521             items = [
522                 _row_to_search_item(
523                     _decode_ns_bytes(row["prefix"]), row, loader=self._deserializer
524                 )
525                 for row in rows
526             ]
527             results[idx] = items
528 
529     async def _batch_list_namespaces_ops(
530         self,
531         list_ops: Sequence[tuple[int, ListNamespacesOp]],
532         results: list[Result],
533         cur: AsyncCursor[DictRow],
534     ) -> None:
535         queries = self._get_batch_list_namespaces_queries(list_ops)
536         for (query, params), (idx, _) in zip(queries, list_ops, strict=False):
537             await cur.execute(query, params)
538             rows = cast(list[dict], await cur.fetchall())
539             namespaces = [_decode_ns_bytes(row["truncated_prefix"]) for row in rows]
540             results[idx] = namespaces
