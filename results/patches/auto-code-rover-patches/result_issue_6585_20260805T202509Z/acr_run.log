42 class AsyncPostgresStore(AsyncBatchedBaseStore, BasePostgresStore[_ainternal.Conn]):
43     """Asynchronous Postgres-backed store with optional vector search using pgvector.
44 
45     !!! example "Examples"
46         Basic setup and usage:
47         ```python
48         from langgraph.store.postgres import AsyncPostgresStore
49 
50         conn_string = "postgresql://user:pass@localhost:5432/dbname"
51 
52         async with AsyncPostgresStore.from_conn_string(conn_string) as store:
53             await store.setup()  # Run migrations. Done once
54 
55             # Store and retrieve data
56             await store.aput(("users", "123"), "prefs", {"theme": "dark"})
57             item = await store.aget(("users", "123"), "prefs")
58         ```
59 
60         Vector search using LangChain embeddings:
61         ```python
62         from langchain.embeddings import init_embeddings
63         from langgraph.store.postgres import AsyncPostgresStore
64 
65         conn_string = "postgresql://user:pass@localhost:5432/dbname"
66 
67         async with AsyncPostgresStore.from_conn_string(
68             conn_string,
69             index={
70                 "dims": 1536,
71                 "embed": init_embeddings("openai:text-embedding-3-small"),
72                 "fields": ["text"]  # specify which fields to embed. Default is the whole serialized value
73             }
74         ) as store:
75             await store.setup()  # Run migrations. Done once
76 
77             # Store documents
78             await store.aput(("docs",), "doc1", {"text": "Python tutorial"})
79             await store.aput(("docs",), "doc2", {"text": "TypeScript guide"})
80             await store.aput(("docs",), "doc3", {"text": "Other guide"}, index=False)  # don't index
81 
82             # Search by similarity
83             results = await store.asearch(("docs",), query="programming guides", limit=2)
84         ```
85 
86         Using connection pooling for better performance:
87         ```python
88         from langgraph.store.postgres import AsyncPostgresStore, PoolConfig
89 
90         conn_string = "postgresql://user:pass@localhost:5432/dbname"
91 
92         async with AsyncPostgresStore.from_conn_string(
93             conn_string,
94             pool_config=PoolConfig(
95                 min_size=5,
96                 max_size=20
97             )
98         ) as store:
99             await store.setup()  # Run migrations. Done once
100             # Use store with connection pooling...
101         ```
102 
103     Warning:
104         Make sure to:
105         1. Call `setup()` before first use to create necessary tables and indexes
106         2. Have the pgvector extension available to use vector search
107         3. Use Python 3.10+ for async functionality
108 
109     Note:
110         Semantic search is disabled by default. You can enable it by providing an `index` configuration
111         when creating the store. Without this configuration, all `index` arguments passed to
112         `put` or `aput` will have no effect.
113 
114     Note:
115         If you provide a TTL configuration, you must explicitly call `start_ttl_sweeper()` to begin
116         the background task that removes expired items. Call `stop_ttl_sweeper()` to properly
117         clean up resources when you're done with the store.
118     """
119 
120     __slots__ = (
121         "_deserializer",
122         "pipe",
123         "lock",
124         "supports_pipeline",
125         "index_config",
126         "embeddings",
127         "ttl_config",
128         "_ttl_sweeper_task",
129         "_ttl_stop_event",
