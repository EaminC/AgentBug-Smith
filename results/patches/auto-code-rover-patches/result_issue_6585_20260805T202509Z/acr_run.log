133     def __init__(
134         self,
135         conn: _ainternal.Conn,
136         *,
137         pipe: AsyncPipeline | None = None,
138         deserializer: Callable[[bytes | orjson.Fragment], dict[str, Any]] | None = None,
139         index: PostgresIndexConfig | None = None,
140         ttl: TTLConfig | None = None,
141     ) -> None:
142         if isinstance(conn, AsyncConnectionPool) and pipe is not None:
143             raise ValueError(
144                 "Pipeline should be used only with a single AsyncConnection, not AsyncConnectionPool."
145             )
146         super().__init__()
147         self._deserializer = deserializer
148         self.conn = conn
149         self.pipe = pipe
150         self.lock = asyncio.Lock()
151         self.loop = asyncio.get_running_loop()
152         self.supports_pipeline = Capabilities().has_pipeline()
153         self.index_config = index
154         if self.index_config:
155             self.embeddings, self.index_config = _ensure_index_config(self.index_config)
156         else:
157             self.embeddings = None
158 
159         self.ttl_config = ttl
160         self._ttl_sweeper_task: asyncio.Task[None] | None = None
161         self._ttl_stop_event = asyncio.Event()
162 
163     async def abatch(self, ops: Iterable[Op]) -> list[Result]:
164         grouped_ops, num_ops = _group_ops(ops)
165         results: list[Result] = [None] * num_ops
166 
167         async with _ainternal.get_connection(self.conn) as conn:
168             if self.pipe:
169                 async with self.pipe:
170                     await self._execute_batch(grouped_ops, results, conn)
171             else:
172                 await self._execute_batch(grouped_ops, results, conn)
173 
174         return results
