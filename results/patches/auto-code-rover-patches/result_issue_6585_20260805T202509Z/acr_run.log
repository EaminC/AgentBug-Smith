178     async def from_conn_string(
179         cls,
180         conn_string: str,
181         *,
182         pipeline: bool = False,
183         pool_config: PoolConfig | None = None,
184         index: PostgresIndexConfig | None = None,
185         ttl: TTLConfig | None = None,
186     ) -> AsyncIterator[AsyncPostgresStore]:
187         """Create a new AsyncPostgresStore instance from a connection string.
188 
189         Args:
190             conn_string: The Postgres connection info string.
191             pipeline: Whether to use AsyncPipeline (only for single connections)
192             pool_config: Configuration for the connection pool.
193                 If provided, will create a connection pool and use it instead of a single connection.
194                 This overrides the `pipeline` argument.
195             index: The embedding config.
196 
197         Returns:
198             AsyncPostgresStore: A new AsyncPostgresStore instance.
199         """
200         if pool_config is not None:
201             pc = pool_config.copy()
202             async with cast(
203                 AsyncConnectionPool[AsyncConnection[DictRow]],
204                 AsyncConnectionPool(
205                     conn_string,
206                     min_size=pc.pop("min_size", 1),
207                     max_size=pc.pop("max_size", None),
208                     kwargs={
209                         "autocommit": True,
210                         "prepare_threshold": 0,
211                         "row_factory": dict_row,
212                         **(pc.pop("kwargs", None) or {}),
213                     },
214                     **cast(dict, pc),
215                 ),
216             ) as pool:
217                 yield cls(conn=pool, index=index, ttl=ttl)
218         else:
219             async with await AsyncConnection.connect(
220                 conn_string, autocommit=True, prepare_threshold=0, row_factory=dict_row
221             ) as conn:
222                 if pipeline:
223                     async with conn.pipeline() as pipe:
224                         yield cls(conn=conn, pipe=pipe, index=index, ttl=ttl)
225                 else:
226                     yield cls(conn=conn, index=index, ttl=ttl)
