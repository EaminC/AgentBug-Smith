71 class BoardAgent(AgentBase):
72     """A board agent that can host a Gomoku game."""
73 
74     def __init__(self, name: str) -> None:
75         super().__init__(name=name, use_memory=False)
76 
77         # Init the board
78         self.size = 15
79         self.board = np.full((self.size, self.size), EMPTY_PIECE)
80 
81         # Record the status of the game
82         self.game_end = False
83 
84     def reply(self, x: dict = None) -> dict:
85         if x is None:
86             # Beginning of the game
87             content = (
88                 "Welcome to the Gomoku game! Black player goes "
89                 "first. Please make your move."
90             )
91         else:
92             row, col = x["content"]
93 
94             self.assert_valid_move(row, col)
95 
96             if self.check_win(row, col, NAME_TO_PIECE[x["name"]]):
97                 content = f"The game ends, {x['name']} wins!"
98                 self.game_end = True
99             else:
100                 # change the board
101                 self.board[row, col] = NAME_TO_PIECE[x["name"]]
102 
103                 # check if the game ends
104                 if self.check_draw():
105                     content = "The game ends in a draw!"
106                     self.game_end = True
107                 else:
108                     next_player_name = (
109                         NAME_BLACK if x["name"] == NAME_WHITE else NAME_WHITE
110                     )
111                     content = CURRENT_BOARD_PROMPT_TEMPLATE.format(
112                         board=self.board2text(),
113                         player=next_player_name,
114                     )
115 
116         msg_host = Msg(self.name, content, role="assistant")
117         self.speak(msg_host)
118 
119         # Note: we disable the image display here to avoid too many images
120         # img = plt.imread(board2img(self.board, 'current_board.png'))
121         # plt.imshow(img)
122         # plt.axis('off')
123         # plt.show()
124 
125         return msg_host
126 
127     def assert_valid_move(self, x: int, y: int) -> None:
128         """Check if the move is valid."""
129         if not (0 <= x < self.size and 0 <= y < self.size):
130             raise RuntimeError(f"Invalid move: {[x, y]} out of board range.")
131 
132         if not self.board[x, y] == EMPTY_PIECE:
133             raise RuntimeError(
134                 f"Invalid move: {[x, y]} is already "
135                 f"occupied by {self.board[x, y]}.",
136             )
137 
138     def check_win(self, x: int, y: int, piece: str) -> bool:
139         """Check if the player wins the game."""
140         xline = self._check_line(self.board[x, :], piece)
141         yline = self._check_line(self.board[:, y], piece)
142         diag1 = self._check_line(np.diag(self.board, y - x), piece)
143         diag2 = self._check_line(
144             np.diag(np.fliplr(self.board), self.size - 1 - x - y),
145             piece,
146         )
147         return xline or yline or diag1 or diag2
148 
149     def check_draw(self) -> bool:
150         """Check if the game ends in a draw."""
151         return np.all(self.board != EMPTY_PIECE)
152 
153     def board2text(self) -> str:
154         """Convert the board to a text representation."""
155         return "\n".join(
156             [
157                 str(_)[1:-1].replace("'", "").replace(" ", "")
158                 for _ in self.board
159             ],
160         )
161 
162     def _check_line(self, line: np.ndarray, piece: str) -> bool:
163         """Check if the player wins in a line."""
164         count = 0
165         for i in line:
166             if i == piece:
167                 count += 1
168                 if count == 5:
169                     return True
170             else:
171                 count = 0
172         return False

