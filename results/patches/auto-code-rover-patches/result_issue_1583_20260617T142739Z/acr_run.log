610 
611     def configure_model_settings(self, model):
612         for ms in MODEL_SETTINGS:
613             # direct match, or match "provider/<model>"
614             if model == ms.name:
615                 for field in fields(ModelSettings):
616                     val = getattr(ms, field.name)
617                     setattr(self, field.name, val)
618                 return  # <--
619 
620         model = model.lower()
621 
622         if ("llama3" in model or "llama-3" in model) and "70b" in model:
623             self.edit_format = "diff"
624             self.use_repo_map = True
625             self.send_undo_reply = True
626             self.examples_as_sys_msg = True
627             return  # <--
628 
629         if "gpt-4-turbo" in model or ("gpt-4-" in model and "-preview" in model):
630             self.edit_format = "udiff"
631             self.use_repo_map = True
632             self.send_undo_reply = True
633             return  # <--
634 
635         if "gpt-4" in model or "claude-3-opus" in model:
636             self.edit_format = "diff"
637             self.use_repo_map = True
638             self.send_undo_reply = True
639             return  # <--
640 
641         if "gpt-3.5" in model or "gpt-4" in model:
642             self.reminder = "sys"
643 
644         if "3.5-sonnet" in model or "3-5-sonnet" in model:
645             self.edit_format = "diff"
646             self.use_repo_map = True
647             self.examples_as_sys_msg = True
648             self.reminder = None
649 
650         # use the defaults
651         if self.edit_format == "diff":
652             self.use_repo_map = True
653 
654     def __str__(self):
655         return self.name
