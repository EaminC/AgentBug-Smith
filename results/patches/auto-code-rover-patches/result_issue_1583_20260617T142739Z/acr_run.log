583 class Model(ModelSettings):
584     def __init__(self, model, weak_model=None):
585         self.name = model
586         self.max_chat_history_tokens = 1024
587         self.weak_model = None
588 
589         self.info = self.get_model_info(model)
590 
591         # Are all needed keys/params available?
592         res = self.validate_environment()
593         self.missing_keys = res.get("missing_keys")
594         self.keys_in_environment = res.get("keys_in_environment")
595 
596         max_input_tokens = self.info.get("max_input_tokens") or 0
597         if max_input_tokens < 32 * 1024:
598             self.max_chat_history_tokens = 1024
599         else:
600             self.max_chat_history_tokens = 2 * 1024
601 
602         self.configure_model_settings(model)
603         if weak_model is False:
604             self.weak_model_name = None
605         else:
606             self.get_weak_model(weak_model)
607 
608     def get_model_info(self, model):
