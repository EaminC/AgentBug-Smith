╭─ Issue description ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮
│ Issue Title: [BUG] KeyError in Mem0Storage when using local_mem0_config (OSS Memory) and missing params                                         │
│                                                                                                                                                 │
│ Description:                                                                                                                                    │
│ ### Description                                                                                                                                 │
│                                                                                                                                                 │
│ When using Mem0 with CrewAI via the local_mem0_config (OSS Memory) pathway, a KeyError is thrown in Mem0Storage's search method if the params   │
│ dictionary does not contain certain keys (e.g. metadata, output_format, version). This is caused by the following code block:                   │
│                                                                                                                                                 │
│ ```                                                                                                                                             │
│ if isinstance(self.memory, Memory):                                                                                                             │
│     del params["metadata"], params["version"], params['output_format']                                                                          │
│     if params.get("run_id"):                                                                                                                    │
│         del params["run_id"]                                                                                                                    │
│ If any of those fields are missing from params, Python raises a KeyError. This is a bug because the code should check existence before deletion │
│ to be robust.                                                                                                                                   │
│ ```                                                                                                                                             │
│                                                                                                                                                 │
│ My Crew Code:                                                                                                                                   │
│                                                                                                                                                 │
│ ```                                                                                                                                             │
│ @crew                                                                                                                                           │
│ def crew(self) -> Crew:                                                                                                                         │
│     return Crew(                                                                                                                                │
│         agents=self.agents,                                                                                                                     │
│         tasks=self.tasks,                                                                                                                       │
│         llm=get_llm_model("llama4-scout-17b"),                                                                                                  │
│         process=Process.sequential,  # Purely sequential for now                                                                                │
│         verbose=True,                                                                                                                           │
│         memory=True,                                                                                                                            │
│         memory_config={                                                                                                                         │
│             "provider": "mem0",                                                                                                                 │
│             "config": {                                                                                                                         │
│                 "user_id": "john",                                                                                                              │
│                 "local_mem0_config": {                                                                                                          │
│                     "vector_store": {                                                                                                           │
│                         "provider": "pgvector",                                                                                                 │
│                         "config": {"dbname":"memory","host": "localhost","user":"memory","password":"memory", "port": 5432}                     │
│                     },                                                                                                                          │
│                     "llm": {                                                                                                                    │
│                         "provider": "vllm",                                                                                                     │
│                         "config": {"vllm_base_url": "http://localhost/v1","temperature":0.1,"api_key":"EMPTY", "model": "llama4-scout-17b"}     │
│                     },                                                                                                                          │
│                     "embedder": {                                                                                                               │
│                         "provider": "huggingface",                                                                                              │
