63         ollama_client_args: dict[str, Any] | None = None,
64         **model_config: Unpack[OllamaConfig],
65     ) -> None:
66         """Initialize provider instance.
67 
68         Args:
69             host: The address of the Ollama server hosting the model.
70             ollama_client_args: Additional arguments for the Ollama client.
71             **model_config: Configuration options for the Ollama model.
72         """
73         self.host = host
74         self.client_args = ollama_client_args or {}
75         validate_config_keys(model_config, self.OllamaConfig)
76         self.config = OllamaModel.OllamaConfig(**model_config)
77 
78         logger.debug("config=<%s> | initializing", self.config)
79 
80     @override
81     def update_config(self, **model_config: Unpack[OllamaConfig]) -> None:  # type: ignore
82         """Update the Ollama Model configuration with the provided arguments.
83 
84         Args:
85             **model_config: Configuration overrides.
86         """
87         validate_config_keys(model_config, self.OllamaConfig)
88         self.config.update(model_config)
89 
90     @override
91     def get_config(self) -> OllamaConfig:
92         """Get the Ollama model configuration.
93 
94         Returns:
95             The Ollama model configuration.
96         """
97         return self.config
