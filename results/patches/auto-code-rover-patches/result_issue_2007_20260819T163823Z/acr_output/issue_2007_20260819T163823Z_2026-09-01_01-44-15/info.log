99     def _format_request_message_contents(self, role: str, content: ContentBlock) -> list[dict[str, Any]]:
100         """Format Ollama compatible message contents.
101 
102         Ollama doesn't support an array of contents, so we must flatten everything into separate message blocks.
103 
104         Args:
105             role: E.g., user.
106             content: Content block to format.
107 
108         Returns:
109             Ollama formatted message contents.
110 
111         Raises:
112             TypeError: If the content block type cannot be converted to an Ollama-compatible format.
113         """
114         if "text" in content:
115             return [{"role": role, "content": content["text"]}]
116 
117         if "image" in content:
118             return [{"role": role, "images": [content["image"]["source"]["bytes"]]}]
119 
120         if "toolUse" in content:
121             return [
122                 {
123                     "role": role,
124                     "tool_calls": [
125                         {
126                             "function": {
127                                 "name": content["toolUse"]["toolUseId"],
128                                 "arguments": content["toolUse"]["input"],
129                             }
130                         }
131                     ],
132                 }
133             ]
134 
135         if "toolResult" in content:
136             return [
137                 formatted_tool_result_content
138                 for tool_result_content in content["toolResult"]["content"]
139                 for formatted_tool_result_content in self._format_request_message_contents(
140                     "tool",
141                     (
142                         {"text": json.dumps(tool_result_content["json"])}
143                         if "json" in tool_result_content
144                         else cast(ContentBlock, tool_result_content)
145                     ),
146                 )
147             ]
148 
149         raise TypeError(f"content_type=<{next(iter(content))}> | unsupported type")
150 
151     def _format_request_messages(self, messages: Messages, system_prompt: str | None = None) -> list[dict[str, Any]]:
152         """Format an Ollama compatible messages array.
153 
154         Args:
155             messages: List of message objects to be processed by the model.
156             system_prompt: System prompt to provide context to the model.
157 
158         Returns:
159             An Ollama compatible messages array.
160         """
161         system_message = [{"role": "system", "content": system_prompt}] if system_prompt else []
162 
163         formatted_messages = []
164         for message in messages:
165             for content in message["content"]:
166                 # Check for location sources and skip with warning
167                 if _has_location_source(content):
168                     logger.warning("Location sources are not supported by Ollama | skipping content block")
169                     continue
170                 formatted_messages.extend(self._format_request_message_contents(message["role"], content))
171 
172         return system_message + formatted_messages
173 
174     def format_request(
175         self, messages: Messages, tool_specs: list[ToolSpec] | None = None, system_prompt: str | None = None
176     ) -> dict[str, Any]:
177         """Format an Ollama chat streaming request.
178 
179         Args:
180             messages: List of message objects to be processed by the model.
181             tool_specs: List of tool specifications to make available to the model.
182             system_prompt: System prompt to provide context to the model.
183 
184         Returns:
185             An Ollama chat streaming request.
186 
187         Raises:
188             TypeError: If a message contains a content block type that cannot be converted to an Ollama-compatible
189                 format.
190         """
191         return {
192             "messages": self._format_request_messages(messages, system_prompt),
193             "model": self.config["model_id"],
194             "options": {
195                 **(self.config.get("options") or {}),
196                 **{
197                     key: value
198                     for key, value in [
199                         ("num_predict", self.config.get("max_tokens")),
200                         ("temperature", self.config.get("temperature")),
201                         ("top_p", self.config.get("top_p")),
202                         ("stop", self.config.get("stop_sequences")),
203                     ]
204                     if value is not None
205                 },
206             },
207             "stream": True,
208             "tools": [
209                 {
210                     "type": "function",
211                     "function": {
212                         "name": tool_spec["name"],
213                         "description": tool_spec["description"],
214                         "parameters": tool_spec["inputSchema"]["json"],
215                     },
216                 }
217                 for tool_spec in tool_specs or []
218             ],
219             **({"keep_alive": self.config["keep_alive"]} if self.config.get("keep_alive") else {}),
220             **(
221                 self.config["additional_args"]
222                 if "additional_args" in self.config and self.config["additional_args"] is not None
223                 else {}
224             ),
225         }
226 
227     def format_chunk(self, event: dict[str, Any]) -> StreamEvent:
228         """Format the Ollama response events into standardized message chunks.
229 
230         Args:
231             event: A response event from the Ollama model.
232 
233         Returns:
234             The formatted chunk.
235 
236         Raises:
237             RuntimeError: If chunk_type is not recognized.
238                 This error should never be encountered as we control chunk_type in the stream method.
239         """
240         match event["chunk_type"]:
241             case "message_start":
242                 return {"messageStart": {"role": "assistant"}}
243 
244             case "content_start":
245                 if event["data_type"] == "text":
246                     return {"contentBlockStart": {"start": {}}}
247 
248                 tool_name = event["data"].function.name
249                 return {"contentBlockStart": {"start": {"toolUse": {"name": tool_name, "toolUseId": tool_name}}}}
250 
251             case "content_delta":
252                 if event["data_type"] == "text":
253                     return {"contentBlockDelta": {"delta": {"text": event["data"]}}}
254 
255                 tool_arguments = event["data"].function.arguments
256                 return {"contentBlockDelta": {"delta": {"toolUse": {"input": json.dumps(tool_arguments)}}}}
257 
258             case "content_stop":
259                 return {"contentBlockStop": {}}
260 
261             case "message_stop":
262                 reason: StopReason
263                 if event["data"] == "tool_use":
264                     reason = "tool_use"
265                 elif event["data"] == "length":
266                     reason = "max_tokens"
267                 else:
268                     reason = "end_turn"
269 
270                 return {"messageStop": {"stopReason": reason}}
271 
272             case "metadata":
273                 return {
274                     "metadata": {
275                         "usage": {
276                             "inputTokens": event["data"].eval_count,
277                             "outputTokens": event["data"].prompt_eval_count,
278                             "totalTokens": event["data"].eval_count + event["data"].prompt_eval_count,
279                         },
280                         "metrics": {
281                             "latencyMs": event["data"].total_duration / 1e6,
282                         },
283                     },
284                 }
285 
286             case _:
287                 raise RuntimeError(f"chunk_type=<{event['chunk_type']} | unknown type")
288 
289     @override
290     async def stream(
291         self,
292         messages: Messages,
293         tool_specs: list[ToolSpec] | None = None,
294         system_prompt: str | None = None,
295         *,
296         tool_choice: ToolChoice | None = None,
297         **kwargs: Any,
298     ) -> AsyncGenerator[StreamEvent, None]:
299         """Stream conversation with the Ollama model.
300 
301         Args:
302             messages: List of message objects to be processed by the model.
303             tool_specs: List of tool specifications to make available to the model.
304             system_prompt: System prompt to provide context to the model.
305             tool_choice: Selection strategy for tool invocation. **Note: This parameter is accepted for
306                 interface consistency but is currently ignored for this model provider.**
307             **kwargs: Additional keyword arguments for future extensibility.
308 
309         Yields:
310             Formatted message chunks from the model.
311         """
312         warn_on_tool_choice_not_supported(tool_choice)
313 
314         logger.debug("formatting request")
315         request = self.format_request(messages, tool_specs, system_prompt)
316         logger.debug("request=<%s>", request)
317 
318         logger.debug("invoking model")
319         tool_requested = False
320 
321         client = ollama.AsyncClient(self.host, **self.client_args)
322         response = await client.chat(**request)
323 
324         logger.debug("got response from model")
325         yield self.format_chunk({"chunk_type": "message_start"})
326         yield self.format_chunk({"chunk_type": "content_start", "data_type": "text"})
327 
328         async for event in response:
329             for tool_call in event.message.tool_calls or []:
330                 yield self.format_chunk({"chunk_type": "content_start", "data_type": "tool", "data": tool_call})
331                 yield self.format_chunk({"chunk_type": "content_delta", "data_type": "tool", "data": tool_call})
332                 yield self.format_chunk({"chunk_type": "content_stop", "data_type": "tool", "data": tool_call})
333                 tool_requested = True
334 
335             yield self.format_chunk({"chunk_type": "content_delta", "data_type": "text", "data": event.message.content})
336 
337         yield self.format_chunk({"chunk_type": "content_stop", "data_type": "text"})
338         yield self.format_chunk(
339             {"chunk_type": "message_stop", "data": "tool_use" if tool_requested else event.done_reason}
340         )
341         yield self.format_chunk({"chunk_type": "metadata", "data": event})
342 
343         logger.debug("finished streaming response from model")
344 
345     @override
346     async def structured_output(
347         self, output_model: type[T], prompt: Messages, system_prompt: str | None = None, **kwargs: Any
348     ) -> AsyncGenerator[dict[str, T | Any], None]:
349         """Get structured output from the model.
350 
351         Args:
352             output_model: The output model to use for the agent.
353             prompt: The prompt messages to use for the agent.
354             system_prompt: System prompt to provide context to the model.
355             **kwargs: Additional keyword arguments for future extensibility.
356 
357         Yields:
358             Model events with the last being the structured output.
359         """
360         formatted_request = self.format_request(messages=prompt, system_prompt=system_prompt)
361         formatted_request["format"] = output_model.model_json_schema()
362         formatted_request["stream"] = False
363 
364         client = ollama.AsyncClient(self.host, **self.client_args)
365         response = await client.chat(**formatted_request)
366 
367         try:
368             content = response.message.content.strip()
369             yield {"output": output_model.model_validate_json(content)}
370         except Exception as e:
371             raise ValueError(f"Failed to parse or load content into model: {e}") from e

