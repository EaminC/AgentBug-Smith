192             "messages": self._format_request_messages(messages, system_prompt),
193             "model": self.config["model_id"],
194             "options": {
195                 **(self.config.get("options") or {}),
196                 **{
197                     key: value
198                     for key, value in [
199                         ("num_predict", self.config.get("max_tokens")),
200                         ("temperature", self.config.get("temperature")),
201                         ("top_p", self.config.get("top_p")),
202                         ("stop", self.config.get("stop_sequences")),
203                     ]
204                     if value is not None
