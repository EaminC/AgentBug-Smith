210                     "type": "function",
211                     "function": {
212                         "name": tool_spec["name"],
213                         "description": tool_spec["description"],
214                         "parameters": tool_spec["inputSchema"]["json"],
215                     },
216                 }
217                 for tool_spec in tool_specs or []
218             ],
219             **({"keep_alive": self.config["keep_alive"]} if self.config.get("keep_alive") else {}),
220             **(
221                 self.config["additional_args"]
222                 if "additional_args" in self.config and self.config["additional_args"] is not None
223                 else {}
224             ),
225         }
