529     def _handle_tool_execution_error(self, tool_use_id: str, exception: Exception) -> MCPToolResult:
530         """Create error ToolResult with consistent logging."""
531         return MCPToolResult(
532             status="error",
533             toolUseId=tool_use_id,
534             content=[{"text": f"Tool execution failed: {str(exception)}"}],
535         )
