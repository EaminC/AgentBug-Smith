537     def _handle_tool_result(self, tool_use_id: str, call_tool_result: MCPCallToolResult) -> MCPToolResult:
538         """Maps MCP tool result to the agent's MCPToolResult format.
539 
540         This method processes the content from the MCP tool call result and converts it to the format
541         expected by the framework.
542 
543         Args:
544             tool_use_id: Unique identifier for this tool use
545             call_tool_result: The result from the MCP tool call
546 
547         Returns:
548             MCPToolResult: The converted tool result
549         """
550         self._log_debug_with_thread("received tool result with %d content items", len(call_tool_result.content))
551 
552         # Build a typed list of ToolResultContent.
553         mapped_contents: list[ToolResultContent] = [
554             mc
555             for content in call_tool_result.content
556             if (mc := self._map_mcp_content_to_tool_result_content(content)) is not None
557         ]
558 
559         status: ToolResultStatus = "error" if call_tool_result.isError else "success"
560         self._log_debug_with_thread("tool execution completed with status: %s", status)
561         result = MCPToolResult(
562             status=status,
563             toolUseId=tool_use_id,
564             content=mapped_contents,
565         )
566 
567         if call_tool_result.structuredContent:
568             result["structuredContent"] = call_tool_result.structuredContent
569         if call_tool_result.meta:
570             result["metadata"] = call_tool_result.meta
571 
572         return result
573 
574     async def _async_background_thread(self) -> None:
575         """Asynchronous method that runs in the background thread to manage the MCP connection.
576 
577         This method establishes the transport connection, creates and initializes the MCP session,
578         signals readiness to the main thread, and waits for a close signal.
579         """
580         self._log_debug_with_thread("starting async background thread for MCP connection")
581 
582         # Initialized here so that it has the asyncio loop
583         self._close_future = asyncio.Future()
584 
585         try:
586             async with self._transport_callable() as (read_stream, write_stream, *_):
587                 self._log_debug_with_thread("transport connection established")
588                 async with ClientSession(
589                     read_stream,
590                     write_stream,
591                     message_handler=self._handle_error_message,
592                     elicitation_callback=self._elicitation_callback,
593                 ) as session:
594                     self._log_debug_with_thread("initializing MCP session")
595                     await session.initialize()
596 
597                     self._log_debug_with_thread("session initialized successfully")
598                     # Store the session for use while we await the close event
599                     self._background_thread_session = session
600                     # Signal that the session has been created and is ready for use
601                     self._init_future.set_result(None)
602 
603                     self._log_debug_with_thread("waiting for close signal")
604                     # Keep background thread running until signaled to close.
605                     # Thread is not blocked as this a future
606                     await self._close_future
607 
608                     self._log_debug_with_thread("close signal received")
609         except Exception as e:
610             # If we encounter an exception and the future is still running,
611             # it means it was encountered during the initialization phase.
612             if not self._init_future.done():
613                 self._init_future.set_exception(e)
614             else:
615                 # _close_future is automatically cancelled by the framework which doesn't provide us with the useful
616                 # exception, so instead we store the exception in a different field where stop() can read it
617                 self._close_exception = e
618                 if self._close_future and not self._close_future.done():
619                     self._close_future.set_result(None)
620 
621                 self._log_debug_with_thread(
622                     "encountered exception on background thread after initialization %s", str(e)
623                 )
624 
625     # Raise an exception if the underlying client raises an exception in a message
626     # This happens when the underlying client has an http timeout error
627     async def _handle_error_message(self, message: Exception | Any) -> None:
628         if isinstance(message, Exception):
629             error_msg = str(message).lower()
630             if any(pattern in error_msg for pattern in _NON_FATAL_ERROR_PATTERNS):
631                 self._log_debug_with_thread("ignoring non-fatal MCP session error", message)
632             else:
633                 raise message
634         await anyio.lowlevel.checkpoint()
635 
636     def _background_task(self) -> None:
637         """Sets up and runs the event loop in the background thread.
638 
639         This method creates a new event loop for the background thread,
640         sets it as the current event loop, and runs the async_background_thread
641         coroutine until completion. In this case "until completion" means until the _close_future is resolved.
642         This allows for a long-running event loop.
643         """
644         self._log_debug_with_thread("setting up background task event loop")
645         self._background_thread_event_loop = asyncio.new_event_loop()
646         asyncio.set_event_loop(self._background_thread_event_loop)
647         self._background_thread_event_loop.run_until_complete(self._async_background_thread())
648 
649     def _map_mcp_content_to_tool_result_content(
650         self,
651         content: MCPTextContent | MCPImageContent | MCPEmbeddedResource | Any,
652     ) -> Union[ToolResultContent, None]:
653         """Maps MCP content types to tool result content types.
654 
655         This method converts MCP-specific content types to the generic
656         ToolResultContent format used by the agent framework.
657 
658         Args:
659             content: The MCP content to convert
660 
661         Returns:
662             ToolResultContent or None: The converted content, or None if the content type is not supported
663         """
664         if isinstance(content, MCPTextContent):
665             self._log_debug_with_thread("mapping MCP text content")
666             return {"text": content.text}
667         elif isinstance(content, MCPImageContent):
668             self._log_debug_with_thread("mapping MCP image content with mime type: %s", content.mimeType)
669             return {
670                 "image": {
671                     "format": MIME_TO_FORMAT[content.mimeType],
672                     "source": {"bytes": base64.b64decode(content.data)},
673                 }
674             }
675         elif isinstance(content, MCPEmbeddedResource):
676             """
677             TODO: Include URI information in results.
678                 Models may find it useful to be aware not only of the information,
679                 but the location of the information too.
680 
681                 This may be difficult without taking an opinionated position. For example,
682                 a content block may need to indicate that the following Image content block
683                 is of particular URI.
684             """
685 
686             self._log_debug_with_thread("mapping MCP embedded resource content")
687 
688             resource = content.resource
689             if isinstance(resource, TextResourceContents):
690                 return {"text": resource.text}
691             elif isinstance(resource, BlobResourceContents):
692                 try:
693                     raw_bytes = base64.b64decode(resource.blob)
694                 except Exception:
695                     self._log_debug_with_thread("embedded resource blob could not be decoded - dropping")
696                     return None
697 
698                 if resource.mimeType and (
699                     resource.mimeType.startswith("text/")
700                     or resource.mimeType
701                     in (
702                         "application/json",
703                         "application/xml",
704                         "application/javascript",
705                         "application/yaml",
706                         "application/x-yaml",
707                     )
708                     or resource.mimeType.endswith(("+json", "+xml"))
709                 ):
710                     try:
711                         return {"text": raw_bytes.decode("utf-8", errors="replace")}
712                     except Exception:
713                         pass
714 
715                 if resource.mimeType in MIME_TO_FORMAT:
716                     return {
717                         "image": {
718                             "format": MIME_TO_FORMAT[resource.mimeType],
719                             "source": {"bytes": raw_bytes},
720                         }
721                     }
722 
723                 self._log_debug_with_thread("embedded resource blob with non-textual/unknown mimeType - dropping")
724                 return None
725 
726             return None  # type: ignore[unreachable]  # Defensive: future MCP resource types
727         else:
728             self._log_debug_with_thread("unhandled content type: %s - dropping content", content.__class__.__name__)
729             return None
730 
731     def _log_debug_with_thread(self, msg: str, *args: Any, **kwargs: Any) -> None:
732         """Logger helper to help differentiate logs coming from MCPClient background thread."""
733         formatted_msg = msg % args if args else msg
734         logger.debug(
735             "[Thread: %s, Session: %s] %s", threading.current_thread().name, self._session_id, formatted_msg, **kwargs
736         )
737 
738     def _invoke_on_background_thread(self, coro: Coroutine[Any, Any, T]) -> futures.Future[T]:
739         # save a reference to this so that even if it's reset we have the original
740         close_future = self._close_future
741 
742         if (
743             self._background_thread_session is None
744             or self._background_thread_event_loop is None
745             or close_future is None
746         ):
747             raise MCPClientInitializationError("the client session was not initialized")
748 
749         async def run_async() -> T:
750             # Fix for strands-agents/sdk-python/issues/995 - cancel all pending invocations if/when the session closes
751             invoke_event = asyncio.create_task(coro)
752             tasks: list[asyncio.Task | asyncio.Future] = [
753                 invoke_event,
754                 close_future,
755             ]
756 
757             done, pending = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
758 
759             if done.pop() == close_future:
760                 self._log_debug_with_thread("event loop for the server closed before the invoke completed")
761                 raise RuntimeError("Connection to the MCP server was closed")
762             else:
763                 return await invoke_event
764 
765         invoke_future = asyncio.run_coroutine_threadsafe(coro=run_async(), loop=self._background_thread_event_loop)
766         return invoke_future
767 
768     def _should_include_tool(self, tool: MCPAgentTool) -> bool:
769         """Check if a tool should be included based on constructor filters."""
770         return self._should_include_tool_with_filters(tool, self._tool_filters)
771 
772     def _should_include_tool_with_filters(self, tool: MCPAgentTool, filters: Optional[ToolFilters]) -> bool:
773         """Check if a tool should be included based on provided filters."""
774         if not filters:
775             return True
776 
777         # Apply allowed filter
778         if "allowed" in filters:
779             if not self._matches_patterns(tool, filters["allowed"]):
780                 return False
781 
782         # Apply rejected filter
783         if "rejected" in filters:
784             if self._matches_patterns(tool, filters["rejected"]):
785                 return False
786 
787         return True
788 
789     def _matches_patterns(self, tool: MCPAgentTool, patterns: list[_ToolMatcher]) -> bool:
790         """Check if tool matches any of the given patterns."""
791         for pattern in patterns:
792             if callable(pattern):
793                 if pattern(tool):
794                     return True
795             elif isinstance(pattern, Pattern):
796                 if pattern.match(tool.mcp_tool.name):
797                     return True
798             elif isinstance(pattern, str):
799                 if pattern == tool.mcp_tool.name:
800                     return True
801         return False
802 
803     def _is_session_active(self) -> bool:
804         return self._background_thread is not None and self._background_thread.is_alive()

