87 class MCPClient(ToolProvider):
88     """Represents a connection to a Model Context Protocol (MCP) server.
89 
90     This class implements a context manager pattern for efficient connection management,
91     allowing reuse of the same connection for multiple tool calls to reduce latency.
92     It handles the creation, initialization, and cleanup of MCP connections.
93 
94     The connection runs in a background thread to avoid blocking the main application thread
95     while maintaining communication with the MCP service. When structured content is available
96     from MCP tools, it will be returned as the last item in the content array of the ToolResult.
97 
98     Warning:
99         This class implements the experimental ToolProvider interface and its methods
100         are subject to change.
101     """
102 
103     def __init__(
104         self,
105         transport_callable: Callable[[], MCPTransport],
106         *,
107         startup_timeout: int = 30,
108         tool_filters: ToolFilters | None = None,
109         prefix: str | None = None,
110         elicitation_callback: Optional[ElicitationFnT] = None,
111     ) -> None:
112         """Initialize a new MCP Server connection.
113 
114         Args:
115             transport_callable: A callable that returns an MCPTransport (read_stream, write_stream) tuple.
116             startup_timeout: Timeout after which MCP server initialization should be cancelled.
117                 Defaults to 30.
118             tool_filters: Optional filters to apply to tools.
119             prefix: Optional prefix for tool names.
120             elicitation_callback: Optional callback function to handle elicitation requests from the MCP server.
121         """
122         self._startup_timeout = startup_timeout
123         self._tool_filters = tool_filters
124         self._prefix = prefix
125         self._elicitation_callback = elicitation_callback
126 
127         mcp_instrumentation()
128         self._session_id = uuid.uuid4()
129         self._log_debug_with_thread("initializing MCPClient connection")
130         # Main thread blocks until future completes
131         self._init_future: futures.Future[None] = futures.Future()
132         # Set within the inner loop as it needs the asyncio loop
133         self._close_future: asyncio.futures.Future[None] | None = None
134         self._close_exception: None | Exception = None
135         # Do not want to block other threads while close event is false
136         self._transport_callable = transport_callable
137 
138         self._background_thread: threading.Thread | None = None
139         self._background_thread_session: ClientSession | None = None
140         self._background_thread_event_loop: AbstractEventLoop | None = None
141         self._loaded_tools: list[MCPAgentTool] | None = None
142         self._tool_provider_started = False
143         self._consumers: set[Any] = set()
144 
145     def __enter__(self) -> "MCPClient":
146         """Context manager entry point which initializes the MCP server connection.
147 
148         TODO: Refactor to lazy initialization pattern following idiomatic Python.
149         Heavy work in __enter__ is non-idiomatic - should move connection logic to first method call instead.
150         """
151         return self.start()
152 
153     def __exit__(self, exc_type: BaseException, exc_val: BaseException, exc_tb: TracebackType) -> None:
154         """Context manager exit point that cleans up resources."""
155         self.stop(exc_type, exc_val, exc_tb)
156 
157     def start(self) -> "MCPClient":
158         """Starts the background thread and waits for initialization.
159 
160         This method starts the background thread that manages the MCP connection
161         and blocks until the connection is ready or times out.
162 
163         Returns:
164             self: The MCPClient instance
165 
166         Raises:
167             Exception: If the MCP connection fails to initialize within the timeout period
168         """
169         if self._is_session_active():
170             raise MCPClientInitializationError("the client session is currently running")
171 
172         self._log_debug_with_thread("entering MCPClient context")
173         self._background_thread = threading.Thread(target=self._background_task, args=[], daemon=True)
174         self._background_thread.start()
175         self._log_debug_with_thread("background thread started, waiting for ready event")
176         try:
177             # Blocking main thread until session is initialized in other thread or if the thread stops
178             self._init_future.result(timeout=self._startup_timeout)
179             self._log_debug_with_thread("the client initialization was successful")
180         except futures.TimeoutError as e:
181             logger.exception("client initialization timed out")
182             # Pass None for exc_type, exc_val, exc_tb since this isn't a context manager exit
183             self.stop(None, None, None)
184             raise MCPClientInitializationError(
185                 f"background thread did not start in {self._startup_timeout} seconds"
186             ) from e
187         except Exception as e:
188             logger.exception("client failed to initialize")
189             # Pass None for exc_type, exc_val, exc_tb since this isn't a context manager exit
190             self.stop(None, None, None)
191             raise MCPClientInitializationError("the client initialization failed") from e
192         return self
193 
194     # ToolProvider interface methods (experimental, as ToolProvider is experimental)
195     async def load_tools(self, **kwargs: Any) -> Sequence[AgentTool]:
196         """Load and return tools from the MCP server.
197 
198         This method implements the ToolProvider interface by loading tools
199         from the MCP server and caching them for reuse.
200 
201         Args:
202             **kwargs: Additional arguments for future compatibility.
203 
204         Returns:
205             List of AgentTool instances from the MCP server.
206         """
207         logger.debug(
208             "started=<%s>, cached_tools=<%s> | loading tools",
209             self._tool_provider_started,
210             self._loaded_tools is not None,
211         )
212 
213         if not self._tool_provider_started:
214             try:
215                 logger.debug("starting MCP client")
216                 self.start()
217                 self._tool_provider_started = True
218                 logger.debug("MCP client started successfully")
219             except Exception as e:
220                 logger.error("error=<%s> | failed to start MCP client", e)
221                 raise ToolProviderException(f"Failed to start MCP client: {e}") from e
222 
223         if self._loaded_tools is None:
224             logger.debug("loading tools from MCP server")
225             self._loaded_tools = []
226             pagination_token = None
227             page_count = 0
228 
229             while True:
230                 logger.debug("page=<%d>, token=<%s> | fetching tools page", page_count, pagination_token)
231                 # Use constructor defaults for prefix and filters in load_tools
232                 paginated_tools = self.list_tools_sync(
233                     pagination_token, prefix=self._prefix, tool_filters=self._tool_filters
234                 )
235 
236                 # Tools are already filtered by list_tools_sync, so add them all
237                 for tool in paginated_tools:
238                     self._loaded_tools.append(tool)
239 
240                 logger.debug(
241                     "page=<%d>, page_tools=<%d>, total_filtered=<%d> | processed page",
242                     page_count,
243                     len(paginated_tools),
244                     len(self._loaded_tools),
245                 )
246 
247                 pagination_token = paginated_tools.pagination_token
248                 page_count += 1
249 
250                 if pagination_token is None:
251                     break
252 
253             logger.debug("final_tools=<%d> | loading complete", len(self._loaded_tools))
254 
255         return self._loaded_tools
256 
257     def add_consumer(self, consumer_id: Any, **kwargs: Any) -> None:
258         """Add a consumer to this tool provider.
259 
260         Synchronous to prevent GC deadlocks when called from Agent finalizers.
261         """
262         self._consumers.add(consumer_id)
263         logger.debug("added provider consumer, count=%d", len(self._consumers))
264 
265     def remove_consumer(self, consumer_id: Any, **kwargs: Any) -> None:
266         """Remove a consumer from this tool provider.
267 
268         This method is idempotent - calling it multiple times with the same ID
269         has no additional effect after the first call.
270 
271         Synchronous to prevent GC deadlocks when called from Agent finalizers.
272         Uses existing synchronous stop() method for safe cleanup.
273         """
274         self._consumers.discard(consumer_id)
275         logger.debug("removed provider consumer, count=%d", len(self._consumers))
276 
277         if not self._consumers and self._tool_provider_started:
278             logger.debug("no consumers remaining, cleaning up")
279             try:
280                 self.stop(None, None, None)  # Existing sync method - safe for finalizers
281                 self._tool_provider_started = False
282                 self._loaded_tools = None
283             except Exception as e:
284                 logger.error("error=<%s> | failed to cleanup MCP client", e)
285                 raise ToolProviderException(f"Failed to cleanup MCP client: {e}") from e
286 
287     # MCP-specific methods
288 
289     def stop(
290         self, exc_type: Optional[BaseException], exc_val: Optional[BaseException], exc_tb: Optional[TracebackType]
291     ) -> None:
292         """Signals the background thread to stop and waits for it to complete, ensuring proper cleanup of all resources.
293 
294         This method is defensive and can handle partial initialization states that may occur
295         if start() fails partway through initialization.
296 
297         Resources to cleanup:
298         - _background_thread: Thread running the async event loop
299         - _background_thread_session: MCP ClientSession (auto-closed by context manager)
300         - _background_thread_event_loop: AsyncIO event loop in background thread
301         - _close_future: AsyncIO future to signal thread shutdown
302         - _close_exception: Exception that caused the background thread shutdown; None if a normal shutdown occurred.
303         - _init_future: Future for initialization synchronization
304 
305         Cleanup order:
306         1. Signal close future to background thread (if session initialized)
307         2. Wait for background thread to complete
308         3. Reset all state for reuse
309 
310         Args:
311             exc_type: Exception type if an exception was raised in the context
312             exc_val: Exception value if an exception was raised in the context
313             exc_tb: Exception traceback if an exception was raised in the context
314         """
315         self._log_debug_with_thread("exiting MCPClient context")
316 
317         # Only try to signal close future if we have a background thread
318         if self._background_thread is not None:
319             # Signal close future if event loop exists
320             if self._background_thread_event_loop is not None:
321 
322                 async def _set_close_event() -> None:
323                     if self._close_future and not self._close_future.done():
324                         self._close_future.set_result(None)
325 
326                 # Not calling _invoke_on_background_thread since the session does not need to exist
327                 # we only need the thread and event loop to exist.
328                 asyncio.run_coroutine_threadsafe(coro=_set_close_event(), loop=self._background_thread_event_loop)
329 
330             self._log_debug_with_thread("waiting for background thread to join")
331             self._background_thread.join()
332 
333         if self._background_thread_event_loop is not None:
334             self._background_thread_event_loop.close()
335 
336         self._log_debug_with_thread("background thread is closed, MCPClient context exited")
337 
338         # Reset fields to allow instance reuse
339         self._init_future = futures.Future()
340         self._background_thread = None
341         self._background_thread_session = None
342         self._background_thread_event_loop = None
343         self._session_id = uuid.uuid4()
344         self._loaded_tools = None
345         self._tool_provider_started = False
346         self._consumers = set()
347 
348         if self._close_exception:
349             exception = self._close_exception
350             self._close_exception = None
351             raise RuntimeError("Connection to the MCP server was closed") from exception
352 
353     def list_tools_sync(
354         self,
355         pagination_token: str | None = None,
356         prefix: str | None = None,
357         tool_filters: ToolFilters | None = None,
358     ) -> PaginatedList[MCPAgentTool]:
359         """Synchronously retrieves the list of available tools from the MCP server.
360 
361         This method calls the asynchronous list_tools method on the MCP session
362         and adapts the returned tools to the AgentTool interface.
363 
364         Args:
365             pagination_token: Optional token for pagination
366             prefix: Optional prefix to apply to tool names. If None, uses constructor default.
367                    If explicitly provided (including empty string), overrides constructor default.
368             tool_filters: Optional filters to apply to tools. If None, uses constructor default.
369                          If explicitly provided (including empty dict), overrides constructor default.
370 
371         Returns:
372             List[AgentTool]: A list of available tools adapted to the AgentTool interface
373         """
374         self._log_debug_with_thread("listing MCP tools synchronously")
375         if not self._is_session_active():
376             raise MCPClientInitializationError(CLIENT_SESSION_NOT_RUNNING_ERROR_MESSAGE)
377 
378         effective_prefix = self._prefix if prefix is None else prefix
379         effective_filters = self._tool_filters if tool_filters is None else tool_filters
380 
381         async def _list_tools_async() -> ListToolsResult:
382             return await cast(ClientSession, self._background_thread_session).list_tools(cursor=pagination_token)
383 
384         list_tools_response: ListToolsResult = self._invoke_on_background_thread(_list_tools_async()).result()
385         self._log_debug_with_thread("received %d tools from MCP server", len(list_tools_response.tools))
386 
387         mcp_tools = []
388         for tool in list_tools_response.tools:
389             # Apply prefix if specified
390             if effective_prefix:
391                 prefixed_name = f"{effective_prefix}_{tool.name}"
392                 mcp_tool = MCPAgentTool(tool, self, name_override=prefixed_name)
393                 logger.debug("tool_rename=<%s->%s> | renamed tool", tool.name, prefixed_name)
394             else:
395                 mcp_tool = MCPAgentTool(tool, self)
396 
397             # Apply filters if specified
398             if self._should_include_tool_with_filters(mcp_tool, effective_filters):
399                 mcp_tools.append(mcp_tool)
400 
401         self._log_debug_with_thread("successfully adapted %d MCP tools", len(mcp_tools))
402         return PaginatedList[MCPAgentTool](mcp_tools, token=list_tools_response.nextCursor)
403 
404     def list_prompts_sync(self, pagination_token: Optional[str] = None) -> ListPromptsResult:
405         """Synchronously retrieves the list of available prompts from the MCP server.
406 
407         This method calls the asynchronous list_prompts method on the MCP session
408         and returns the raw ListPromptsResult with pagination support.
409 
410         Args:
411             pagination_token: Optional token for pagination
412 
413         Returns:
414             ListPromptsResult: The raw MCP response containing prompts and pagination info
415         """
416         self._log_debug_with_thread("listing MCP prompts synchronously")
417         if not self._is_session_active():
418             raise MCPClientInitializationError(CLIENT_SESSION_NOT_RUNNING_ERROR_MESSAGE)
419 
420         async def _list_prompts_async() -> ListPromptsResult:
421             return await cast(ClientSession, self._background_thread_session).list_prompts(cursor=pagination_token)
422 
423         list_prompts_result: ListPromptsResult = self._invoke_on_background_thread(_list_prompts_async()).result()
424         self._log_debug_with_thread("received %d prompts from MCP server", len(list_prompts_result.prompts))
425         for prompt in list_prompts_result.prompts:
426             self._log_debug_with_thread(prompt.name)
427 
428         return list_prompts_result
429 
430     def get_prompt_sync(self, prompt_id: str, args: dict[str, Any]) -> GetPromptResult:
431         """Synchronously retrieves a prompt from the MCP server.
432 
433         Args:
434             prompt_id: The ID of the prompt to retrieve
435             args: Optional arguments to pass to the prompt
436 
437         Returns:
438             GetPromptResult: The prompt response from the MCP server
439         """
440         self._log_debug_with_thread("getting MCP prompt synchronously")
441         if not self._is_session_active():
442             raise MCPClientInitializationError(CLIENT_SESSION_NOT_RUNNING_ERROR_MESSAGE)
443 
444         async def _get_prompt_async() -> GetPromptResult:
445             return await cast(ClientSession, self._background_thread_session).get_prompt(prompt_id, arguments=args)
446 
447         get_prompt_result: GetPromptResult = self._invoke_on_background_thread(_get_prompt_async()).result()
448         self._log_debug_with_thread("received prompt from MCP server")
449 
450         return get_prompt_result
451 
452     def call_tool_sync(
453         self,
454         tool_use_id: str,
455         name: str,
456         arguments: dict[str, Any] | None = None,
457         read_timeout_seconds: timedelta | None = None,
458     ) -> MCPToolResult:
459         """Synchronously calls a tool on the MCP server.
460 
461         This method calls the asynchronous call_tool method on the MCP session
462         and converts the result to the ToolResult format. If the MCP tool returns
463         structured content, it will be included as the last item in the content array
464         of the returned ToolResult.
465 
466         Args:
467             tool_use_id: Unique identifier for this tool use
468             name: Name of the tool to call
469             arguments: Optional arguments to pass to the tool
470             read_timeout_seconds: Optional timeout for the tool call
471 
472         Returns:
473             MCPToolResult: The result of the tool call
474         """
475         self._log_debug_with_thread("calling MCP tool '%s' synchronously with tool_use_id=%s", name, tool_use_id)
476         if not self._is_session_active():
477             raise MCPClientInitializationError(CLIENT_SESSION_NOT_RUNNING_ERROR_MESSAGE)
478 
479         async def _call_tool_async() -> MCPCallToolResult:
480             return await cast(ClientSession, self._background_thread_session).call_tool(
481                 name, arguments, read_timeout_seconds
482             )
483 
484         try:
485             call_tool_result: MCPCallToolResult = self._invoke_on_background_thread(_call_tool_async()).result()
486             return self._handle_tool_result(tool_use_id, call_tool_result)
487         except Exception as e:
488             logger.exception("tool execution failed")
489             return self._handle_tool_execution_error(tool_use_id, e)
490 
491     async def call_tool_async(
492         self,
493         tool_use_id: str,
494         name: str,
495         arguments: dict[str, Any] | None = None,
496         read_timeout_seconds: timedelta | None = None,
497     ) -> MCPToolResult:
498         """Asynchronously calls a tool on the MCP server.
499 
500         This method calls the asynchronous call_tool method on the MCP session
501         and converts the result to the MCPToolResult format.
502 
503         Args:
504             tool_use_id: Unique identifier for this tool use
505             name: Name of the tool to call
506             arguments: Optional arguments to pass to the tool
507             read_timeout_seconds: Optional timeout for the tool call
508 
509         Returns:
510             MCPToolResult: The result of the tool call
511         """
512         self._log_debug_with_thread("calling MCP tool '%s' asynchronously with tool_use_id=%s", name, tool_use_id)
513         if not self._is_session_active():
514             raise MCPClientInitializationError(CLIENT_SESSION_NOT_RUNNING_ERROR_MESSAGE)
515 
516         async def _call_tool_async() -> MCPCallToolResult:
517             return await cast(ClientSession, self._background_thread_session).call_tool(
518                 name, arguments, read_timeout_seconds
519             )
520 
521         try:
522             future = self._invoke_on_background_thread(_call_tool_async())
523             call_tool_result: MCPCallToolResult = await asyncio.wrap_future(future)
524             return self._handle_tool_result(tool_use_id, call_tool_result)
525         except Exception as e:
526             logger.exception("tool execution failed")
527             return self._handle_tool_execution_error(tool_use_id, e)
528 
529     def _handle_tool_execution_error(self, tool_use_id: str, exception: Exception) -> MCPToolResult:
530         """Create error ToolResult with consistent logging."""
531         return MCPToolResult(
532             status="error",
533             toolUseId=tool_use_id,
534             content=[{"text": f"Tool execution failed: {str(exception)}"}],
535         )
536 
537     def _handle_tool_result(self, tool_use_id: str, call_tool_result: MCPCallToolResult) -> MCPToolResult:
538         """Maps MCP tool result to the agent's MCPToolResult format.
539 
540         This method processes the content from the MCP tool call result and converts it to the format
541         expected by the framework.
542 
543         Args:
544             tool_use_id: Unique identifier for this tool use
545             call_tool_result: The result from the MCP tool call
546 
547         Returns:
548             MCPToolResult: The converted tool result
549         """
550         self._log_debug_with_thread("received tool result with %d content items", len(call_tool_result.content))
551 
552         # Build a typed list of ToolResultContent.
553         mapped_contents: list[ToolResultContent] = [
554             mc
555             for content in call_tool_result.content
556             if (mc := self._map_mcp_content_to_tool_result_content(content)) is not None
557         ]
558 
559         status: ToolResultStatus = "error" if call_tool_result.isError else "success"
560         self._log_debug_with_thread("tool execution completed with status: %s", status)
561         result = MCPToolResult(
562             status=status,
563             toolUseId=tool_use_id,
564             content=mapped_contents,
565         )
566 
567         if call_tool_result.structuredContent:
568             result["structuredContent"] = call_tool_result.structuredContent
569         if call_tool_result.meta:
570             result["metadata"] = call_tool_result.meta
571 
572         return result
573 
574     async def _async_background_thread(self) -> None:
575         """Asynchronous method that runs in the background thread to manage the MCP connection.
576 
577         This method establishes the transport connection, creates and initializes the MCP session,
578         signals readiness to the main thread, and waits for a close signal.
579         """
580         self._log_debug_with_thread("starting async background thread for MCP connection")
581 
582         # Initialized here so that it has the asyncio loop
583         self._close_future = asyncio.Future()
584 
585         try:
586             async with self._transport_callable() as (read_stream, write_stream, *_):
587                 self._log_debug_with_thread("transport connection established")
588                 async with ClientSession(
589                     read_stream,
590                     write_stream,
591                     message_handler=self._handle_error_message,
592                     elicitation_callback=self._elicitation_callback,
593                 ) as session:
594                     self._log_debug_with_thread("initializing MCP session")
595                     await session.initialize()
596 
597                     self._log_debug_with_thread("session initialized successfully")
598                     # Store the session for use while we await the close event
599                     self._background_thread_session = session
600                     # Signal that the session has been created and is ready for use
601                     self._init_future.set_result(None)
602 
603                     self._log_debug_with_thread("waiting for close signal")
604                     # Keep background thread running until signaled to close.
605                     # Thread is not blocked as this a future
606                     await self._close_future
607 
608                     self._log_debug_with_thread("close signal received")
609         except Exception as e:
610             # If we encounter an exception and the future is still running,
611             # it means it was encountered during the initialization phase.
612             if not self._init_future.done():
613                 self._init_future.set_exception(e)
614             else:
615                 # _close_future is automatically cancelled by the framework which doesn't provide us with the useful
616                 # exception, so instead we store the exception in a different field where stop() can read it
617                 self._close_exception = e
618                 if self._close_future and not self._close_future.done():
619                     self._close_future.set_result(None)
620 
621                 self._log_debug_with_thread(
622                     "encountered exception on background thread after initialization %s", str(e)
623                 )
624 
625     # Raise an exception if the underlying client raises an exception in a message
626     # This happens when the underlying client has an http timeout error
627     async def _handle_error_message(self, message: Exception | Any) -> None:
628         if isinstance(message, Exception):
629             error_msg = str(message).lower()
630             if any(pattern in error_msg for pattern in _NON_FATAL_ERROR_PATTERNS):
631                 self._log_debug_with_thread("ignoring non-fatal MCP session error", message)
632             else:
633                 raise message
634         await anyio.lowlevel.checkpoint()
635 
636     def _background_task(self) -> None:
637         """Sets up and runs the event loop in the background thread.
638 
639         This method creates a new event loop for the background thread,
640         sets it as the current event loop, and runs the async_background_thread
641         coroutine until completion. In this case "until completion" means until the _close_future is resolved.
642         This allows for a long-running event loop.
643         """
644         self._log_debug_with_thread("setting up background task event loop")
645         self._background_thread_event_loop = asyncio.new_event_loop()
646         asyncio.set_event_loop(self._background_thread_event_loop)
647         self._background_thread_event_loop.run_until_complete(self._async_background_thread())
648 
649     def _map_mcp_content_to_tool_result_content(
650         self,
651         content: MCPTextContent | MCPImageContent | MCPEmbeddedResource | Any,
652     ) -> Union[ToolResultContent, None]:
653         """Maps MCP content types to tool result content types.
654 
655         This method converts MCP-specific content types to the generic
656         ToolResultContent format used by the agent framework.
657 
658         Args:
659             content: The MCP content to convert
660 
661         Returns:
662             ToolResultContent or None: The converted content, or None if the content type is not supported
663         """
664         if isinstance(content, MCPTextContent):
665             self._log_debug_with_thread("mapping MCP text content")
666             return {"text": content.text}
667         elif isinstance(content, MCPImageContent):
668             self._log_debug_with_thread("mapping MCP image content with mime type: %s", content.mimeType)
669             return {
670                 "image": {
671                     "format": MIME_TO_FORMAT[content.mimeType],
672                     "source": {"bytes": base64.b64decode(content.data)},
673                 }
674             }
675         elif isinstance(content, MCPEmbeddedResource):
676             """
677             TODO: Include URI information in results.
678                 Models may find it useful to be aware not only of the information,
679                 but the location of the information too.
680 
681                 This may be difficult without taking an opinionated position. For example,
682                 a content block may need to indicate that the following Image content block
683                 is of particular URI.
684             """
685 
686             self._log_debug_with_thread("mapping MCP embedded resource content")
687 
688             resource = content.resource
689             if isinstance(resource, TextResourceContents):
690                 return {"text": resource.text}
691             elif isinstance(resource, BlobResourceContents):
692                 try:
693                     raw_bytes = base64.b64decode(resource.blob)
694                 except Exception:
695                     self._log_debug_with_thread("embedded resource blob could not be decoded - dropping")
696                     return None
697 
698                 if resource.mimeType and (
699                     resource.mimeType.startswith("text/")
700                     or resource.mimeType
701                     in (
702                         "application/json",
703                         "application/xml",
704                         "application/javascript",
705                         "application/yaml",
706                         "application/x-yaml",
707                     )
708                     or resource.mimeType.endswith(("+json", "+xml"))
709                 ):
710                     try:
711                         return {"text": raw_bytes.decode("utf-8", errors="replace")}
712                     except Exception:
713                         pass
714 
715                 if resource.mimeType in MIME_TO_FORMAT:
716                     return {
717                         "image": {
718                             "format": MIME_TO_FORMAT[resource.mimeType],
719                             "source": {"bytes": raw_bytes},
720                         }
721                     }
722 
723                 self._log_debug_with_thread("embedded resource blob with non-textual/unknown mimeType - dropping")
724                 return None
725 
726             return None  # type: ignore[unreachable]  # Defensive: future MCP resource types
727         else:
728             self._log_debug_with_thread("unhandled content type: %s - dropping content", content.__class__.__name__)
729             return None
730 
731     def _log_debug_with_thread(self, msg: str, *args: Any, **kwargs: Any) -> None:
732         """Logger helper to help differentiate logs coming from MCPClient background thread."""
733         formatted_msg = msg % args if args else msg
734         logger.debug(
735             "[Thread: %s, Session: %s] %s", threading.current_thread().name, self._session_id, formatted_msg, **kwargs
736         )
737 
738     def _invoke_on_background_thread(self, coro: Coroutine[Any, Any, T]) -> futures.Future[T]:
739         # save a reference to this so that even if it's reset we have the original
740         close_future = self._close_future
741 
742         if (
743             self._background_thread_session is None
744             or self._background_thread_event_loop is None
745             or close_future is None
746         ):
747             raise MCPClientInitializationError("the client session was not initialized")
748 
749         async def run_async() -> T:
750             # Fix for strands-agents/sdk-python/issues/995 - cancel all pending invocations if/when the session closes
751             invoke_event = asyncio.create_task(coro)
752             tasks: list[asyncio.Task | asyncio.Future] = [
753                 invoke_event,
754                 close_future,
755             ]
756 
757             done, pending = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
758 
759             if done.pop() == close_future:
760                 self._log_debug_with_thread("event loop for the server closed before the invoke completed")
761                 raise RuntimeError("Connection to the MCP server was closed")
762             else:
763                 return await invoke_event
764 
765         invoke_future = asyncio.run_coroutine_threadsafe(coro=run_async(), loop=self._background_thread_event_loop)
766         return invoke_future
767 
768     def _should_include_tool(self, tool: MCPAgentTool) -> bool:
769         """Check if a tool should be included based on constructor filters."""
770         return self._should_include_tool_with_filters(tool, self._tool_filters)
771 
772     def _should_include_tool_with_filters(self, tool: MCPAgentTool, filters: Optional[ToolFilters]) -> bool:
773         """Check if a tool should be included based on provided filters."""
774         if not filters:
775             return True
776 
777         # Apply allowed filter
778         if "allowed" in filters:
779             if not self._matches_patterns(tool, filters["allowed"]):
780                 return False
781 
782         # Apply rejected filter
783         if "rejected" in filters:
784             if self._matches_patterns(tool, filters["rejected"]):
785                 return False
786 
787         return True
788 
789     def _matches_patterns(self, tool: MCPAgentTool, patterns: list[_ToolMatcher]) -> bool:
790         """Check if tool matches any of the given patterns."""
791         for pattern in patterns:
792             if callable(pattern):
793                 if pattern(tool):
794                     return True
795             elif isinstance(pattern, Pattern):
796                 if pattern.match(tool.mcp_tool.name):
797                     return True
798             elif isinstance(pattern, str):
799                 if pattern == tool.mcp_tool.name:
800                     return True
801         return False
802 
803     def _is_session_active(self) -> bool:
804         return self._background_thread is not None and self._background_thread.is_alive()

