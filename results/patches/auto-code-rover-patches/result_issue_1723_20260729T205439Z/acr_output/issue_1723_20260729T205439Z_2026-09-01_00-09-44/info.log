2055     def _update_tool_call_state(
2056         self,
2057         tool_call_id: str,
2058         state: ToolCallState,
2059     ) -> None:
2060         """Update the tool call state. This function is to avoid the update
2061         not reflected in the context due to the shallow copy of the content
2062         blocks somewhere in the code.
2063 
2064         Args:
2065             tool_call_id (`str`):
2066                 The tool call id to be updated.
2067             state (`ToolCallState`):
2068                 The new state of the tool call.
2069         """
2070         if len(self.state.context) == 0:
2071             return
2072         last_msg = self.state.context[-1]
2073         if last_msg.role != "assistant" or last_msg.name != self.name:
2074             return
2075         for block in last_msg.get_content_blocks():
2076             if isinstance(block, ToolCallBlock) and block.id == tool_call_id:
2077                 block.state = state
2078                 break
2079 
2080     def _save_to_context(
2081         self,
2082         blocks: Sequence[
2083             TextBlock
2084             | ThinkingBlock
2085             | ToolCallBlock
2086             | ToolResultBlock
2087             | DataBlock
2088         ],
2089         usage: ChatUsage | None = None,
2090     ) -> None:
2091         """Save content blocks into the context.
2092 
2093         Newly created :class:`AssistantMsg` uses ``self.state.reply_id`` as
2094         its id so that one reply corresponds to one message and the message
2095         id matches the ``reply_id`` carried by streaming events.
2096         """
2097         msg_usage = (
2098             Usage(
2099                 input_tokens=usage.input_tokens,
2100                 output_tokens=usage.output_tokens,
2101             )
2102             if usage is not None
2103             else None
2104         )
2105 
2106         if len(self.state.context) == 0:
2107             self.state.context.append(
2108                 AssistantMsg(
2109                     id=self.state.reply_id,
2110                     name=self.name,
2111                     content=list(blocks),
2112                     usage=msg_usage,
2113                 ),
2114             )
2115         else:
2116             last_msg = self.state.context[-1]
2117             if last_msg.role == "assistant" and last_msg.name == self.name:
2118                 if isinstance(last_msg.content, str):
2119                     last_msg.content = [TextBlock(text=last_msg.content)]
2120                 last_msg.content.extend(blocks)
2121                 if msg_usage is not None:
2122                     if last_msg.usage is None:
2123                         last_msg.usage = msg_usage
2124                     else:
2125                         last_msg.usage.input_tokens += msg_usage.input_tokens
2126                         last_msg.usage.output_tokens += msg_usage.output_tokens
2127             else:
2128                 self.state.context.append(
2129                     AssistantMsg(
2130                         id=self.state.reply_id,
2131                         name=self.name,
2132                         content=list(blocks),
2133                         usage=msg_usage,
2134                     ),
2135                 )
2136 
2137     def _get_last_msg(self) -> Msg | None:
2138         """Get the last message in the context that belongs to this agent."""
2139         if len(self.state.context) == 0:
2140             return None
2141         last_msg = self.state.context[-1]
2142         if last_msg.role == "assistant" and last_msg.name == self.name:
2143             return last_msg
2144         return None
