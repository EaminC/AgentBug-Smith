188     async def reply_stream(
189         self,
190         inputs: Msg
191         | list[Msg]
192         | UserConfirmResultEvent
193         | ExternalExecutionResultEvent
194         | None = None,
195     ) -> AsyncGenerator[AgentEvent, None]:
196         """Reply to the given inputs and stream agent events.
197 
198 
199         **NOTE**:
200 
201         - If requiring outside interaction for multiple tool calls and only
202          receive partial confirmation or execution results, the agent won't
203          re-send the requiring events for the unconfirmed or unexecuted tool
204          calls.
205         """
206         try:
207             async for chunk in self._reply(inputs=inputs):
208                 if not isinstance(chunk, Msg):
209                     yield chunk
