2146     def _check_next_action(
2147         self,
2148     ) -> (
2149         tuple[Literal["exit"], Msg]
2150         | tuple[Literal["reasoning"], None]
2151         | tuple[Literal["acting"], None]
2152     ):
2153         """Check the next action for the agent
2154 
2155         Awaiting tool calls:
2156             The tool calls waiting for the outside events (confirmation or
2157             external execution results, state = "asking" or "submitted")
2158         Executable tool calls:
2159             The tool calls allowed by the incoming confirmation events and
2160             haven't been executed yet (state = "allowed")
2161 
2162         The next action:
2163 
2164         |                          | Awaiting tool calls          | No awaiting tool call        |
2165         | ------------------------ | ---------------------------- | ---------------------------- |
2166         | Executable tool calls    | Acting executable tool calls | Acting executable tool calls |
2167         | No executable tool calls | Exit the _reply              | Reasoning                    |
2168 
2169         Returns:
2170             `tuple[Literal["exit"], Msg]`:
2171                 If there is no executable tool call and there are awaiting tool
2172                 calls, which means the agent is waiting for the outside events
2173                 and should not do anything before that, the next action is to
2174                 exit the _reply and wait for the outside events.
2175             `tuple[Literal["reasoning"], None]`:
2176                 If there is no executable tool call and no awaiting tool call,
2177                 which means the agent has nothing to do in this iteration and
2178                 can continue reasoning for the next step.
2179             `tuple[Literal["acting"], None]`:
2180                 If there are executable tool calls, which means the agent can
2181                 act by executing the tool calls.
2182         """  # noqa: E501
2183         last_msg = self._get_last_msg()
2184         if last_msg is None:
2185             return "reasoning", None
2186 
2187         # In case wrong tool call state, first filter with the results
2188         finished_ids = {
2189             _.id for _ in last_msg.get_content_blocks("tool_result")
2190         }
2191         unfinished_tool_calls = [
2192             _
2193             for _ in last_msg.get_content_blocks("tool_call")
2194             if _.id not in finished_ids
2195         ]
2196 
2197         # Find if there are executable or awaiting tool calls
2198         awaiting_tool_calls: list[ToolCallBlock] = []
2199         executable_tool_calls: list[ToolCallBlock] = []
2200 
2201         confirming_names, asking_names = [], []
2202         for _ in unfinished_tool_calls:
2203             if _.state in [ToolCallState.PENDING, ToolCallState.ALLOWED]:
2204                 executable_tool_calls.append(_)
2205 
2206             elif _.state == ToolCallState.ASKING:
2207                 asking_names.append(_.name)
2208                 awaiting_tool_calls.append(_)
2209 
2210             elif _.state == ToolCallState.SUBMITTED:
2211                 confirming_names.append(_.name)
2212                 awaiting_tool_calls.append(_)
2213 
2214         if executable_tool_calls:
2215             return "acting", None
2216 
2217         if awaiting_tool_calls:
2218             # Prepare the message
2219             evt = ["I'm waiting for "]
2220             if asking_names:
2221                 evt += [
2222                     f"user confirmation for {len(asking_names)} tool calls",
2223                 ]
2224 
2225             if confirming_names:
2226                 if evt:
2227                     evt += [", and "]
2228                 evt += [
2229                     f"external execution results for {len(confirming_names)} "
2230                     f"tool calls",
2231                 ]
2232 
2233             text = "".join(evt) + "."
2234 
2235             return "exit", AssistantMsg(
2236                 name=self.name,
2237                 content=[TextBlock(text=text)],
2238             )
2239 
2240         return "reasoning", None
2241 
2242     def _get_executable_tool_calls(self) -> list[ToolCallBlock]:
2243         """Get tool calls from the last message that to be executed, which
2244         means we should reserve the tool calls that:
2245 
2246         1. doesn't have results yet, **and**
2247         2. haven't been submitted for external execution (state != "submitted")
2248         """
2249         last_msg = self._get_last_msg()
2250         if last_msg is None:
2251             return []
2252 
2253         # The tool results
2254         result_ids = {_.id for _ in last_msg.get_content_blocks("tool_result")}
2255         # The tool calls that doesn't have results yet
2256         tool_calls_wo_results = [
2257             _
2258             for _ in last_msg.get_content_blocks("tool_call")
2259             if _.id not in result_ids
2260         ]
2261 
2262         # Filter the ones that are "submitted", which already report the
2263         # external execution requirement
2264         pending_tool_calls = [
2265             _
2266             for _ in tool_calls_wo_results
2267             if _.state
2268             in [
2269                 ToolCallState.PENDING,
2270                 ToolCallState.ALLOWED,
2271             ]
2272         ]
2273         return pending_tool_calls
2274 
2275     async def _convert_chat_response_to_event(
2276         self,
2277         block_ids: dict,
2278         chunk: ChatResponse,
2279     ) -> AsyncGenerator:
2280         """Convert a ChatResponse chunk into a sequence of agent events. To
2281         keep the identifiers of the content blocks reasonable, the input
2282         blocks_ids is used to track the block ids.
2283 
2284         Args:
2285             block_ids (`dict`):
2286                 The block ids used to track the block generation.
2287             chunk (`ChatResponse`):
2288                 The chat response chunk to be converted.
2289         """
2290 
2291         # Classify the content blocks into different types
2292         text_blocks, thinking_blocks, tool_call_blocks = [], [], []
2293         for block in chunk.content:
2294             if isinstance(block, TextBlock):
2295                 text_blocks.append(block)
2296             elif isinstance(block, ThinkingBlock):
2297                 thinking_blocks.append(block)
2298             elif isinstance(block, ToolCallBlock):
2299                 tool_call_blocks.append(block)
2300 
2301         # Handle the text blocks
2302         if text_blocks:
2303             # If the current chunk has text blocks but no text block id,
2304             # start with a start event
2305             if not block_ids.get("text"):
2306                 block_ids["text"] = uuid.uuid4().hex
2307                 yield TextBlockStartEvent(
2308                     reply_id=self.state.reply_id,
2309                     block_id=block_ids["text"],
2310                 )
2311             # Go on using the existing text block id to generate delta events
2312             yield TextBlockDeltaEvent(
2313                 reply_id=self.state.reply_id,
2314                 block_id=block_ids["text"],
2315                 delta="".join([_.text for _ in text_blocks]),
2316             )
2317 
2318         elif block_ids.get("text"):
2319             yield TextBlockEndEvent(
2320                 reply_id=self.state.reply_id,
2321                 block_id=block_ids["text"],
2322             )
2323             block_ids["text"] = None
2324 
2325         # Handle the thinking blocks
2326         if thinking_blocks:
2327             # Generate a new thinking block id and start event
2328             if not block_ids.get("thinking"):
2329                 block_ids["thinking"] = uuid.uuid4().hex
2330                 yield ThinkingBlockStartEvent(
2331                     reply_id=self.state.reply_id,
2332                     block_id=block_ids["thinking"],
2333                 )
2334             # Generate the thinking delta event with the existing id
2335             yield ThinkingBlockDeltaEvent(
2336                 reply_id=self.state.reply_id,
2337                 block_id=block_ids["thinking"],
2338                 delta="".join([_.thinking for _ in thinking_blocks]),
2339             )
2340 
2341         elif block_ids.get("thinking"):
2342             yield ThinkingBlockEndEvent(
2343                 reply_id=self.state.reply_id,
2344                 block_id=block_ids["thinking"],
2345             )
2346             block_ids["thinking"] = None
2347 
2348         # Handle the tool calls that exist in the current chunk
2349         for tool_call in tool_call_blocks:
2350             # Not in previous chunk, start with a start event
2351             if tool_call.id not in block_ids["tools"]:
2352                 block_ids["tools"].append(tool_call.id)
2353                 yield ToolCallStartEvent(
2354                     reply_id=self.state.reply_id,
2355                     tool_call_id=tool_call.id,
2356                     tool_call_name=tool_call.name,
2357                 )
2358             yield ToolCallDeltaEvent(
2359                 reply_id=self.state.reply_id,
2360                 tool_call_id=tool_call.id,
2361                 delta=tool_call.input,
2362             )
2363 
2364         # Handle the tool calls that exist in the previous chunk but not in the
2365         # current chunk
2366         finished_ids = set(block_ids["tools"]) - set(
2367             _.id for _ in tool_call_blocks
2368         )
2369         for finished_id in finished_ids:
2370             yield ToolCallEndEvent(
2371                 reply_id=self.state.reply_id,
2372                 tool_call_id=finished_id,
2373             )
2374             block_ids["tools"].remove(finished_id)
2375 
2376     async def _convert_tool_chunk_to_event(
2377         self,
2378         tool_call_id: str,
2379         output_blocks: str | List[TextBlock | DataBlock],
2380     ) -> AsyncGenerator:
2381         """Convert a ToolChunk into a sequence of agent events."""
2382         if isinstance(output_blocks, str):
2383             yield ToolResultTextDeltaEvent(
2384                 reply_id=self.state.reply_id,
2385                 tool_call_id=tool_call_id,
2386                 delta=output_blocks,
2387             )
2388             return
2389 
2390         for block in output_blocks:
2391             if isinstance(block, TextBlock):
2392                 yield ToolResultTextDeltaEvent(
2393                     reply_id=self.state.reply_id,
2394                     tool_call_id=tool_call_id,
2395                     delta=block.text,
2396                 )
2397 
2398             elif isinstance(block, DataBlock):
2399                 if isinstance(block.source, Base64Source):
2400                     yield ToolResultDataDeltaEvent(
2401                         reply_id=self.state.reply_id,
2402                         tool_call_id=tool_call_id,
2403                         media_type=block.source.media_type,
2404                         data=block.source.data,
2405                     )
2406                 elif isinstance(block.source, URLSource):
2407                     yield ToolResultDataDeltaEvent(
2408                         reply_id=self.state.reply_id,
2409                         tool_call_id=tool_call_id,
2410                         media_type=block.source.media_type,
2411                         url=str(block.source.url),
2412                     )

