213     async def reply(
214         self,
215         inputs: Msg
216         | list[Msg]
217         | UserConfirmResultEvent
218         | ExternalExecutionResultEvent
219         | None = None,
220     ) -> Msg:
221         """Reply to the given inputs, consuming all streamed events.
222 
223         Args:
224             inputs (`Msg | list[Msg] | UserConfirmResultEvent | \
225             ExternalExecutionResultEvent | None`, optional):
226                 The inputs that trigger this reply. It can be:
227 
228                 - a single `Msg` or a list of `Msg` objects to start a new
229                   reply,
230                 - a `UserConfirmResultEvent` or
231                   `ExternalExecutionResultEvent` to continue from the
232                   outside interaction required by the previous reply,
233                 - `None` if there is nothing new to feed in (e.g. just
234                   continue from the current state).
235 
236         Returns:
237             `Msg`:
238                 A final reply message.
239         """
240         try:
241             final_msg: Msg | None = None
242             async for evt_or_msg in self._reply(inputs=inputs):
243                 if isinstance(evt_or_msg, Msg):
244                     final_msg = evt_or_msg
245             if final_msg is None:
246                 raise RuntimeError("Agent did not produce a final message.")
247             return final_msg
248         finally:
249             pass
