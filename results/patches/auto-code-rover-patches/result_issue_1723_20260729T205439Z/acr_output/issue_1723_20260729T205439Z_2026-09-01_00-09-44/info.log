108         context_config: ContextConfig = ContextConfig(),
109         react_config: ReActConfig = ReActConfig(),
110     ) -> None:
111         """Initialize the agent class in AgentScope.
112 
113         Args:
114             name (`str`):
115                 The agent identifier.
116             system_prompt (`str`):
117                 The agent's system prompt. Additional instructions may be
