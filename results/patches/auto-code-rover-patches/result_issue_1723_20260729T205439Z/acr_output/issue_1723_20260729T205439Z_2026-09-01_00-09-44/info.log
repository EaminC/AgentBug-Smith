97     def __init__(
98         self,
99         name: str,
100         system_prompt: str,
101         model: ChatModelBase,
102         toolkit: Toolkit | None = None,
103         middlewares: list[MiddlewareBase] | None = None,
104         state: AgentState | None = None,
105         offloader: Offloader | None = None,
106         # The agent configurations
107         model_config: ModelConfig = ModelConfig(),
108         context_config: ContextConfig = ContextConfig(),
109         react_config: ReActConfig = ReActConfig(),
110     ) -> None:
111         """Initialize the agent class in AgentScope.
112 
113         Args:
114             name (`str`):
115                 The agent identifier.
116             system_prompt (`str`):
117                 The agent's system prompt. Additional instructions may be
118                 appended to it dynamically during operation.
119             model (`ChatModelBase`):
120                 The chat model/llm used for this agent.
121             toolkit (`Toolkit | None`, optional):
122                 The toolkit used for registering tools, MCPs and skills as the
123                 sole source.
124             middlewares (`list[MiddlewareBase] | None`):
125                 Middlewares applied to the agent to modify its behavior
126                 without altering its source code. Supported hook points
127                 include: reply, reasoning, acting, model call, and system
128                 prompt retrieval.
129             state (`AgentState`):
130                 The agent state. A new state will be created if not provided.
131             offloader (`Offloader | None`, optional):
132                 The context offloader. If provided, the compressed context and
133                 tool result will be offloaded.
134             model_config (`ModelConfig`):
135                 The additional chat model configuration including fallback
136                 model and retries.
137             context_config (`CompressionConfig`):
138                 The context config for context compression and tool result
139                 compression.
140             react_config (`ReActConfig`):
141                 The config for the reasoning-acting loop.
142         """
143         self.name = name
144         self._system_prompt = system_prompt
145         self.model = model
146         self.state = state or AgentState()
147 
148         self.model_config = model_config
149         self.context_config = context_config
150         self.react_config = react_config
151 
152         # The permission engine
153         self._engine = PermissionEngine(self.state.permission_context)
154 
155         # The offloader/workspace
156         self.offloader = offloader
157 
158         # ====================================================================
159         # The Tool-related logics
160         # ====================================================================
161         self.toolkit = toolkit or Toolkit()
162 
163         # ====================================================================
164         # The Middleware-related attributes
165         # ====================================================================
166         # Filter middlewares by implemented hooks (only once)
167         middlewares = middlewares or []
168         self._reply_middlewares = [
169             _ for _ in middlewares if _.is_implemented("on_reply")
170         ]
171         self._reasoning_middlewares = [
172             _ for _ in middlewares if _.is_implemented("on_reasoning")
173         ]
174         self._acting_middlewares = [
175             _ for _ in middlewares if _.is_implemented("on_acting")
176         ]
177         self._model_call_middlewares = [
178             _ for _ in middlewares if _.is_implemented("on_model_call")
179         ]
