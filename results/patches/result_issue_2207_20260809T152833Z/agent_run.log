import asyncio
import pytest
from agentscope.model import ChatModelBase, ChatResponse, FinishedReason

class DummyModel(ChatModelBase):
    def __init__(self):
        self.call_count = 0

    async def _call_api(self, *args, **kwargs):
        self.call_count += 1
        await asyncio.sleep(5)  # simulate long running
        return ChatResponse(content=[], is_last=True, 
finished_reason=FinishedReason.COMPLETED)


@pytest.mark.asyncio
async def test_interruption_no_extra_call():
    model = DummyModel()
    task = asyncio.create_task(model._call_api())
    await asyncio.sleep(0.1)  # ensure _call_api started
    task.cancel()
    with pytest.raises(asyncio.CancelledError):
        await task

    # after cancellation, call count is exactly 1
    assert model.call_count == 1

    # simulate a call returning interrupted response
    response = ChatResponse(content=[], is_last=True, 
finished_reason=FinishedReason.INTERRUPTED)
    assert response.finished_reason == FinishedReason.INTERRUPTED

    # structured schema variant
    # simulate structured schema requiring model call
    # here we just simulate that no extra call is done
    
EOF

