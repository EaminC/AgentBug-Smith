import asyncio
from agentscope.model import DashScopeChatModel

async def test_multimodal_async_call():
    model = DashScopeChatModel(
        model_name="qwen-vl-plus",
        api_key="sk-test",
        stream=True,
        multimodality=True,
    )

    # simulate a typical messages input
    messages = [{"role": "user", "content": "Hello, multimodal model!"}]

    try:
        response = await model(messages=messages)
        print("Async call succeeded.")
    except Exception as e:
        print(f"Async call failed: {e}")

if __name__ == '__main__':
    asyncio.run(test_multimodal_async_call())
EOF
```

