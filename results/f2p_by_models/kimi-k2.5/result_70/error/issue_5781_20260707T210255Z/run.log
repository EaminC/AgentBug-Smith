[32m# LobeHub Chat - TypeScript/Node.js Environment with Forge API
FROM node:20-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install system dependencies for native modules (sharp, canvas, etc.)
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    build-essential \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    libpixman-1-dev \
    pkg-config \
    ca-certificates \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Configure Python as default python (some build scripts need this)
RUN ln -s /usr/bin/python3 /usr/bin/python || true

# Install pnpm globally
RUN npm install -g pnpm@9.15.5

# Copy package files first for better caching
COPY package.json .npmrc ./

# Install dependencies using pnpm
# Note: No lock file exists in this repo, using pnpm install
RUN pnpm install

# Copy the entire repository
COPY . .

# Install test dependencies explicitly (vitest, testing-library)
RUN pnpm add -D vitest @testing-library/react @testing-library/jest-dom happy-dom

# ============================================
# Forge API Environment Variables
# ============================================
# These override the default API endpoints to use Forge API

# OpenAI SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional Forge configuration
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Model configuration
ENV MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-kimi-k2.5/kimi-k2.5

# AI parameters
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

# Other API keys from environment
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key

# ============================================
# Application Environment
# ============================================
ENV NODE_ENV=development
ENV PORT=3210
ENV HOSTNAME=0.0.0.0

# Set PATH for any local bin installs
ENV PATH="/app/node_modules/.bin:${PATH}"

# Verify installation (preflight check)
RUN node -e "console.log('Node.js version:', process.version)" && \
    pnpm -v && \
    echo "Environment configured for TypeScript/Node.js with Forge API"

# Final command must be /bin/bash for the testing environment
CMD ["/bin/bash"]
