RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    libgomp1 \
    libglib2.0-0 \
    libnss3 \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Set Forge API environment variables for OpenAI SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Set Forge API environment variables for Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Copy the entire repository
COPY . .

# Install poetry and configure it
RUN pip install --upgrade pip wheel && \
    pip install poetry

# Configure poetry to not create a virtual environment (we're in a container)
RUN poetry config virtualenvs.create false

# Install onnxruntime first (required for chromadb)
RUN pip install onnxruntime

# Install project dependencies using poetry
# If poetry.lock exists, use it for reproducible builds
RUN if [ -f "poetry.lock" ]; then \
        poetry install --no-interaction --no-ansi; \
    else \
        poetry install --no-interaction --no-ansi --no-lock; \
    fi

# Install additional test dependencies that may not be in pyproject.toml
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Preflight verification to ensure interpreter package and pytest are importable
RUN python -c 'import interpreter; print("interpreter imported successfully")' && \
    python -c 'import pytest; print("pytest imported successfully")' && \
    echo "preflight ok"

CMD ["/bin/bash"]
