[32m# GPT-Engineer Dockerfile with Forge API Configuration
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies for Python packages and compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install wheel first
RUN python -m pip install --upgrade pip wheel setuptools

# Install Poetry for dependency management
RUN pip install poetry

# Configure Poetry to not use virtualenv (install to system Python)
ENV POETRY_VIRTUALENVS_CREATE=false
ENV POETRY_NO_INTERACTION=1

# Copy the entire repository first
COPY . .

# Install project dependencies using Poetry and install the project in editable mode
# Combine installations to ensure proper dependency resolution
RUN poetry install --no-root --with dev && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-timeout anyio "setuptools<=81.0.0" litellm

