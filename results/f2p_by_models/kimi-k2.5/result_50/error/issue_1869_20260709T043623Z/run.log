[32m# CrewAI Project Dockerfile with Forge API Configuration
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Prevent Python from writing pyc files and buffering stdout
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Forge API Configuration - OpenAI Compatible
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Forge API Configuration - Anthropic Compatible
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional AI Configuration
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Install system dependencies required for building Python packages
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install wheel
RUN pip install --upgrade pip wheel setuptools

# Copy the entire repository
COPY . .

# Install the project dependencies
# First, check if requirements.txt exists and install from it
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi

# Install the project in editable mode (handles both setup.py and pyproject.toml)
# Using --no-deps to avoid conflicts since we've already installed dependencies
RUN pip install -e . || true

# Install core test dependencies explicitly
RUN pip install \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    pytest-vcr \
    pytest-subprocess \
    "setuptools<=81.0.0" \
    litellm \
    mem0ai \
    requests \
    anyio

# CrewAI uses src layout, set PYTHONPATH to include src directory
ENV PYTHONPATH=/app/src:/app

# Pre-flight check - ensure key packages are importable
RUN python -c "import crewai; print('crewai import ok')" || echo "Note: crewai import may require full environment"
RUN python -c "import pytest; print('pytest import ok')"

# Default command to bash shell
CMD ["/bin/bash"]
