[32mimport pytest
from crewai.llm import LLM


def test_anthropic_empty_message_formatting():
    """Test that Anthropic models handle empty messages correctly.
    
    This test verifies that _format_messages_for_provider adds a placeholder
    user message when given an empty list for Anthropic models.
    """
    llm = LLM(model="anthropic/claude-3-sonnet")
    
    # This should add a placeholder user message for Anthropic
    formatted = llm._format_messages_for_provider([])
    assert len(formatted) == 1
    assert formatted[0]["role"] == "user"
    assert formatted[0]["content"] == "."


def test_anthropic_model_detection_attribute():
    """Test that is_anthropic attribute exists and detects Anthropic models."""
    anthropic_llm = LLM(model="anthropic/claude-3-sonnet")
    assert anthropic_llm.is_anthropic is True
    
    # Also test with claude- prefix
    claude_llm = LLM(model="claude-3-opus")
    assert claude_llm.is_anthropic is True
    
    # Test non-Anthropic model
    openai_llm = LLM(model="gpt-4")
    assert openai_llm.is_anthropic is False


def test_anthropic_system_message_formatting():
    """Test that Anthropic models handle system-first messages correctly.
    
    When the first message is a system message, a placeholder user message
    should be inserted at the beginning.
    """
    llm = LLM(model="anthropic/claude-3-sonnet")
    system_message = {"role": "system", "content": "You are a helpful assistant"}
    
    formatted = llm._format_messages_for_provider([system_message])
    assert len(formatted) == 2
    assert formatted[0]["role"] == "user"
    assert formatted[0]["content"] == "."
    assert formatted[1] == system_message


def test_non_anthropic_message_formatting_unchanged():
    """Test that non-Anthropic models do not modify messages."""
    llm = LLM(model="gpt-4")
    system_message = {"role": "system", "content": "You are a helpful assistant"}
    
    # Non-Anthropic models should return messages unchanged
    formatted = llm._format_messages_for_provider([system_message])
    assert len(formatted) == 1
    assert formatted[0] == system_message[0m
