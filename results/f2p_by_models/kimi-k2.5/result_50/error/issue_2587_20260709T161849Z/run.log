    python-dotenv>=1.0.0 \
    click>=8.1.7 \
    appdirs>=1.4.4 \
    jsonref>=1.1.0 \
    json-repair>=0.25.2 \
    uv>=0.4.25 \
    tomli-w>=1.1.0 \
    tomli>=2.0.2 \
    blinker>=1.9.0 \
    json5>=0.10.0 \
    pytest>=8.0.0 \
    pytest-mock \
    pytest-asyncio>=0.23.7 \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    pytest-vcr>=1.0.2 \
    pytest-subprocess>=1.5.2 \
    mem0ai>=0.1.29

# Cleanup build dependencies to reduce image size
RUN apt-get purge -y --auto-remove gcc g++ libxml2-dev libxslt1-dev python3-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* ~/.cache

# Preflight check
RUN python -c "import sys; print(f'Python {sys.version}')" && \
    python -c "import pytest; print(f'pytest imported successfully')"

CMD ["/bin/bash"]
