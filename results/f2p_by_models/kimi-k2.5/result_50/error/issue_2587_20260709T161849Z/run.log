[32m# CrewAI Dockerfile - Python 3.12 with Forge API configuration
# Streamlined to minimize disk usage by combining RUN commands

FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Set PYTHONPATH for src layout (tests import via src.crewai)
ENV PYTHONPATH=/app/src

# --- Forge API Environment Configuration ---
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV ANTHROPIC_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key
ENV MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV AI_TEMPERATURE=0.7

# Install system dependencies, Python packages, and cleanup in a single layer
# to minimize disk usage and intermediate layers
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    git \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install build tools and test dependencies
RUN pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" hatchling \
    && pip install --no-cache-dir \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    pytest-vcr \
    pytest-subprocess \
    mem0ai \
    litellm \
    && rm -rf ~/.cache/pip /tmp/* /var/tmp/*

# Copy repository files
COPY . .

# Install crewai package (using regular install instead of editable for src layout)
RUN pip install --no-cache-dir . \
    && rm -rf ~/.cache/pip /tmp/* /var/tmp/*

# Pre-flight check to verify installation
RUN python -c "import sys; sys.path.insert(0, 'src'); import crewai; print('preflight ok')"

CMD ["/bin/bash"]
