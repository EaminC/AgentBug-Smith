[32m# -*- coding: utf-8 -*-
"""Fail2pass test for DashScope multimodal async issue #1277."""
from typing import Any
from unittest.async_case import IsolatedAsyncioTestCase
from unittest.mock import AsyncMock, patch

from agentscope.model import DashScopeChatModel


class MessageMock(dict):
    """Mock class for message objects, supports both dictionary and
    attribute access."""

    def __init__(self, data: dict[str, Any]):
        super().__init__(data)
        for key, value in data.items():
            setattr(self, key, value)


class TestDashScopeMultimodalAsync(IsolatedAsyncioTestCase):
    """Test that multimodal models use async API instead of sync."""

    def _create_mock_response(self, text: str) -> MessageMock:
        """Create a mock response object simulating DashScope response."""
        mock_message = MessageMock({"content": [{"text": text}]})
        mock_output = MessageMock({"choices": [{"message": mock_message}]})
        mock_response = MessageMock({
            "status_code": 200,
            "output": mock_output,
            "usage": {"input_tokens": 10, "output_tokens": 5},
        })
        return mock_response

    async def test_multimodal_uses_aio_api(self) -> None:
        """Test that multimodal model uses AioMultiModalConversation.call.
        
        This test verifies the fix for issue #1277 where multimodal models
        were incorrectly using sync MultiModalConversation.call() instead 
        of async AioMultiModalConversation.call(), blocking the asyncio 
        event loop.
        """
        model = DashScopeChatModel(
            model_name="qwen-vl-plus",
            api_key="test_key",
            stream=False,
            multimodality=True,
        )
        messages = [{"role": "user", "content": "Describe this image."}]
        
        mock_response = self._create_mock_response("This is a test image.")
        
        # Before the fix, the code uses dashscope.MultiModalConversation.call (sync)
        # After the fix, it uses await dashscope.AioMultiModalConversation.call (async)
        with patch(
            "dashscope.AioMultiModalConversation.call",
            new_callable=AsyncMock,
        ) as mock_call:
            mock_call.return_value = mock_response
            result = await model(messages)
            
            # This assertion fails before the fix because the sync API is called
            mock_call.assert_called_once()
            call_kwargs = mock_call.call_args[1]
            self.assertEqual(call_kwargs["messages"], messages)
            self.assertEqual(call_kwargs["model"], "qwen-vl-plus")[0m
