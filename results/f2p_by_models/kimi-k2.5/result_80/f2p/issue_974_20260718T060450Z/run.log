[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

COPY . .

# Detect if src/ directory or imports from src. exist to decide install strategy
RUN set -eux; \
    if [ -d "src" ] || grep -RqE '^\s*(from|import) src\.' tests 2>/dev/null; then \
        # src layout detected: install dependencies only, set PYTHONPATH, no editable install
        python -m pip install --upgrade pip setuptools wheel; \
        python -m pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
        # Install dependencies from pyproject.toml (no lockfile found, fallback to editable install skipped) \
    else \
        # no src layout: install dependencies and editable install of local package
        python -m pip install --upgrade pip setuptools wheel; \
        python -m pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
        python -m pip install -e .; \
    fi

# Assumption: No requirements.txt or poetry.lock detected, fallback to pyproject.toml editable install

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Run the tests as part of the build to ensure validation
RUN pytest --maxfail=1 --disable-warnings -q

