from dapr_agents.tool.mcp.client import MCPClient
from dapr_agents.types.exceptions import ToolError


class MockContent:
    def __init__(self, text):
        self.text = text


class MockResult:
    def __init__(self, is_error=True, content_items=None):
        self.isError = is_error
        if content_items:
            self.content = [MockContent(text) for text in content_items]
        else:
            self.content = []


def test_process_tool_result_returns_content_when_iserror_true():
    """
    Regression test for issue #83.
    
    When MCP server returns an error result (isError=True) but includes content
    with text, the method should return that text content instead of raising
    ToolError. This allows the model to see the error message and iterate.
    
    In the buggy implementation, this would raise ToolError immediately when
    isError=True, preventing the content from being returned.
    """
    client = MCPClient()
    
    # Result indicates error but contains content text that should be returned
    result = MockResult(is_error=True, content_items=["Division by zero error"])
    
    # Should return the content text, not raise ToolError
    output = client._process_tool_result(result)
    
    assert output == "Division by zero error"


def test_process_tool_result_raises_toolerror_when_no_content():
    """
    Test that ToolError is still raised when isError=True and there's no content.
    
    This ensures the fix doesn't break the legitimate error case where
    the MCP server returns an error without any content.
    """
    client = MCPClient()
    
    # Result indicates error but has no content
    result = MockResult(is_error=True, content_items=[])
    
    with pytest.raises(ToolError):
        client._process_tool_result(result)


def test_process_tool_result_returns_multiple_contents():
    """
    Test that multiple content items are returned as a list when isError=True.
    """
    client = MCPClient()
    
    # Result indicates error but contains multiple content items
    result = MockResult(is_error=True, content_items=["Error 1", "Error 2"])
    
    output = client._process_tool_result(result)
    
