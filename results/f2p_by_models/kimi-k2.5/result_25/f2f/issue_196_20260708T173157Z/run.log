import os

# Add the examples/game_gomoku/code directory to the path to import board_agent
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'examples', 'game_gomoku', 'code'))

from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_horizontal_win_detected_after_piece_placement():
    """
    Test that when a player places a piece that completes 5 in a row horizontally,
    the game ends immediately.
    
    Regression test for issue #196: The win check was performed before updating the board,
    causing wins to not be detected until the next move.
    """
    # Initialize the board agent
    agent = BoardAgent(name="Board")
    
    # Set up the board: Black has 4 pieces in a row horizontally at row 7, columns 3-6
    # The next move at (7, 7) should complete 5 in a row and win the game
    row = 7
    winning_cols = [3, 4, 5, 6]
    for col in winning_cols:
        agent.board[row, col] = NAME_TO_PIECE[NAME_BLACK]
    
    # Verify game hasn't ended yet
    assert agent.game_end is False, "Game should not be ended before the winning move"
    
    # Black places the winning piece at (7, 7)
    move_msg = {
        "name": NAME_BLACK,
        "content": [7, 7]
    }
    
    # Process the move
    response = agent.reply(move_msg)
    
    # After placing the 5th piece, the game should end immediately
    assert agent.game_end is True, (
        f"Game should have ended immediately after Black completed 5 in a row, "
        f"but game_end={agent.game_end}. "
        f"The win check must happen after the piece is placed on the board."
    )
    
    # Verify the response content indicates a win
    assert f"{NAME_BLACK} wins" in response["content"], (
        f"Response should indicate Black wins, but got: {response['content']}"
    )


def test_diagonal_win_detected_after_piece_placement():
    """
    Test that when a player places a piece that completes 5 in a row diagonally,
    the game ends immediately.
    """
    agent = BoardAgent(name="Board")
    
    # Set up diagonal for White: pieces at (2,2), (3,3), (4,4), (5,5)
    # Placing at (6,6) completes the diagonal (5 in a row)
    diagonal_positions = [(2, 2), (3, 3), (4, 4), (5, 5)]
    for r, c in diagonal_positions:
        agent.board[r, c] = NAME_TO_PIECE[NAME_WHITE]
    
    # White places the winning piece at (6, 6)
    move_msg = {
        "name": NAME_WHITE,
        "content": [6, 6]
    }
    
    response = agent.reply(move_msg)
    
    # The game should end immediately after completing the diagonal
    assert agent.game_end is True, (
        f"Game should have ended immediately after White completed diagonal 5 in a row, "
        f"but game_end={agent.game_end}"
    )
    
    assert f"{NAME_WHITE} wins" in response["content"][0m
