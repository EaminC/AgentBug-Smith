    def test_win_detection_after_placing_piece():
        """Test that win is detected when placing the 5th piece in a row.
    
        This tests the bug where check_win() was called BEFORE updating the board
        with the current move. In Gomoku, a player wins by placing 5 pieces in a row.
        If check_win is called before the piece is placed, a winning move (the 5th
        piece) will not be detected as a win because the board only shows 4 pieces
        at that moment.
    
        Bug: check_win called before board update -> winning move not detected
        Fix: board updated before check_win -> winning move correctly detected
        """
        agent = BoardAgent(name="Board")
    
        # Initialize a 15x15 board (standard Gomoku board size)
        agent.board = np.zeros((15, 15), dtype=int)
    
        # Set up a horizontal line of 4 black pieces (value 1) at row 7, columns 0-3
        # This creates a situation where placing the 5th piece at (7, 4) wins the game
        for col in range(4):
            agent.board[7, col] = 1
    
        # Ensure game hasn't ended yet
        assert agent.game_end is False, "Game should not be ended initially"
    
        # Simulate black player placing the winning 5th piece at position (7, 4)
        move_msg = {"name": NAME_BLACK, "content": (7, 4)}
