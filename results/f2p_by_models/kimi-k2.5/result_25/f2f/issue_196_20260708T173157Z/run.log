[32mimport sys
import os
import numpy as np

# Add the gomoku example code to the path
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'examples', 'game_gomoku', 'code'))

from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_fifth_stone_triggers_win():
    """
    Test that placing the 5th stone in a row immediately triggers a win.
    
    Setup: Place 4 black stones in a horizontal row, then place the 5th stone
    to complete the line.
    
    Expected: game_end should be True and the response should indicate a win.
    
    This test fails before the fix because check_win() was called BEFORE 
    updating the board with the current move, so the 5th stone wasn't counted.
    """
    # Create board agent with standard 15x15 board
    agent = BoardAgent(name="Board", board_size=15)
    
    # Initialize empty board
    agent.board = np.zeros((15, 15), dtype=int)
    
    # Place 4 black stones in a horizontal row at row 7, columns 0-3
    black_piece = NAME_TO_PIECE[NAME_BLACK]
    row = 7
    for col in range(4):
        agent.board[row, col] = black_piece
    
    # Black places the 5th stone at (7, 4) to complete the 5-in-a-row
    move_msg = {
        "name": NAME_BLACK,
        "content": (row, 4)
    }
    
    # Process the move - this should detect the win
    response = agent.reply(move_msg)
    
    # The game should have ended with Black winning
    assert agent.game_end is True, (
        f"Expected game_end=True when 5th stone completes a line, "
        f"but got game_end={agent.game_end}. "
        f"The win check was likely performed before updating the board."
    )
    
    # Verify the response content indicates a win
    content = response["content"] if isinstance(response, dict) else response.content
    assert "wins" in content, (
        f"Expected win message in response, but got: {content}"
    )[0m
