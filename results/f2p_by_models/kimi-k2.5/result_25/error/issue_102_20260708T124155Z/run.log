[32m# AgentScope Dockerfile with Forge API Configuration
FROM python:3.11-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install system dependencies including build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment to avoid PEP 668 issues
RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"

# Upgrade pip and install wheel
RUN pip install --upgrade pip wheel setuptools

# Copy the entire repository first
COPY . .

# Install minimal dependencies first (from setup.py minimal_requires)
RUN pip install \
    loguru \
    tiktoken \
    Pillow \
    requests \
    chardet \
    inputimeout \
    "openai>=1.3.0" \
    numpy \
    "Flask==3.0.0" \
    "Flask-Cors==4.0.0" \
    "Flask-SocketIO==5.3.6" \
    "dashscope==1.14.1" \
    "ollama>=0.1.7" \
    "google-generativeai>=0.4.0"

# Install RPC dependencies
RUN pip install \
    "grpcio==1.60.0" \
    "grpcio-tools==1.60.0" \
    "protobuf==4.25.0" \
    expiringdict

# Install service dependencies
RUN pip install \
    docstring_parser \
    docker \
    pymongo \
    pymysql

# Install test dependencies
RUN pip install \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    "setuptools<=81.0.0" \
    litellm \
    pre-commit

# For src layout: set PYTHONPATH to include the src directory
# This allows imports like 'import agentscope' to work without editable install
ENV PYTHONPATH=/app/src:$PYTHONPATH

# Also install the package in editable mode for entry points to work
# The PYTHONPATH setting above ensures imports resolve to src/agentscope
RUN pip install -e .

# Preflight check - verify imports work
RUN python -c "import agentscope; print('agentscope imported successfully')" && \
    python -c "import pytest; print('pytest imported successfully')" && \
    python -c "import grpc; print('grpc imported successfully')" && \
    python -c "import openai; print('openai imported successfully')" && \
    echo "preflight ok"

# Default command
CMD ["/bin/bash"]
