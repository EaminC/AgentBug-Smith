from mle.workflow.report import report
from mle.server.app import ReportRequest


def test_report_function_accepts_github_token_parameter():
    """Test that the report workflow function accepts github_token parameter."""
    sig = inspect.signature(report)
    assert "github_token" in sig.parameters, "report function must accept github_token parameter"


def test_report_request_model_has_optional_token_field():
    """Test that ReportRequest model accepts optional token field."""
    # Should instantiate without token (optional field)
    req_no_token = ReportRequest(repo="test/repo", username="testuser")
    assert hasattr(req_no_token, "token"), "ReportRequest must have token attribute"
    assert req_no_token.token is None, "Token should default to None"
    
    # Should instantiate with token
    req_with_token = ReportRequest(repo="test/repo", username="testuser", token="ghp_test123")
    assert req_with_token.token == "ghp_test123", "Token should be set correctly"[0m
