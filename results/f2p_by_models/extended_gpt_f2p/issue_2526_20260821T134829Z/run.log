            file_manager.create_message(sample_session.session_id, sample_agent.agent_id, message)

        offset_messages = file_manager.list_messages(sample_session.session_id, sample_agent.agent_id, offset=5)
        assert len(offset_messages) == 5
        assert offset_messages[0].message_id == 5
        assert offset_messages[-1].message_id == 9

    def test_list_messages_with_limit_and_offset(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        for i in range(10):
            message = SessionMessage.from_message(
                message={
                    "role": "user",
                    "content": [ContentBlock(text=f"Message {i}")],
                },
                index=i,
            )
            file_manager.create_message(sample_session.session_id, sample_agent.agent_id, message)

        messages = file_manager.list_messages(sample_session.session_id, sample_agent.agent_id, limit=3, offset=4)
