    async def dummy_stream_async(*args, **kwargs):
        yield {"choices": [{"delta": {"content": "response"}}], "id": "dummy", "object": "chat.completion.chunk"}

    # Patch the Agent._stream_async method to use dummy_stream_async
    # Use setattr on the class, not the instance, because _stream_async may be a method on the class
    monkeypatch.setattr(type(agent), "_stream_async", dummy_stream_async)

    # Call invoke with invocationState
    invocation_state = {"test_state": "value"}
    # Agent.invoke is async generator, collect outputs
    outputs = []
    async for chunk in agent.invoke(invocationState=invocation_state):
        outputs.append(chunk)

    # Check that outputs contain expected dummy response
    assert any("choices" in chunk for chunk in outputs)
    # Also check that the invocationState was accepted and passed (we cannot directly check internals here,
    # but no exception means plumbing is correct)[0m
