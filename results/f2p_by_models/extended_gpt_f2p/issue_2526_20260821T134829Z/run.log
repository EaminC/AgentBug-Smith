[32mimport os
import shutil
import tempfile

import pytest

from strands.session.file_session_manager import FileSessionManager
from strands.types.content import ContentBlock
from strands.types.exceptions import SessionException
from strands.types.session import Session, SessionAgent, SessionMessage, SessionType


@pytest.fixture
def temp_dir():
    with tempfile.TemporaryDirectory() as temp_dir:
        yield temp_dir


@pytest.fixture
def file_manager(temp_dir):
    # Ensure a clean directory for each test
    # We create a new FileSessionManager with the temp_dir as base path
    # The FileSessionManager uses a default base path, so we patch it here
    # For simplicity, we monkeypatch the _base_path attribute after creation
    manager = FileSessionManager()
    manager._base_path = temp_dir
    yield manager
    # Clean up after test
    if os.path.exists(temp_dir):
        shutil.rmtree(temp_dir)


@pytest.fixture
def sample_session():
    return Session(session_id="test-session", session_type=SessionType.AGENT)


@pytest.fixture
def sample_agent():
    return SessionAgent(agent_id="test-agent", state={"key": "value"})


@pytest.fixture
def sample_message():
    # Use the new from_message signature with index
    return SessionMessage.from_message(
        message={
            "role": "user",
            "content": [ContentBlock(text="Hello world")],
        },
        index=0,
    )


class TestFileSessionManagerSessionOperations:
    def test_create_session(self, file_manager, sample_session):
        # Should create session directory and file
        result = file_manager.create_session(sample_session)
        assert result.session_id == sample_session.session_id

        session_path = file_manager._get_session_path(sample_session.session_id)
        assert os.path.exists(session_path)

        session_file = os.path.join(session_path, "session.json")
        assert os.path.exists(session_file)

        # Creating same session again should raise
        with pytest.raises(SessionException):
            file_manager.create_session(sample_session)

    def test_read_session(self, file_manager, sample_session):
        file_manager.create_session(sample_session)
        result = file_manager.read_session(sample_session.session_id)
        assert result is not None
        assert result.session_id == sample_session.session_id
        assert result.session_type == sample_session.session_type

        # Reading non-existent session returns None
        result_none = file_manager.read_session("nonexistent")
        assert result_none is None

    def test_delete_session(self, file_manager, sample_session):
        file_manager.create_session(sample_session)
        session_path = file_manager._get_session_path(sample_session.session_id)
        assert os.path.exists(session_path)

        file_manager.delete_session(sample_session.session_id)
        assert not os.path.exists(session_path)

        # Deleting non-existent session raises
        with pytest.raises(SessionException):
            file_manager.delete_session("nonexistent-session")


class TestFileSessionManagerAgentOperations:
    def test_create_agent(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        agent_path = file_manager._get_agent_path(sample_session.session_id, sample_agent.agent_id)
        assert os.path.exists(agent_path)

        agent_file = os.path.join(agent_path, "agent.json")
        assert os.path.exists(agent_file)

        # Creating same agent again should raise
        with pytest.raises(SessionException):
            file_manager.create_agent(sample_session.session_id, sample_agent)

    def test_read_agent(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        result = file_manager.read_agent(sample_session.session_id, sample_agent.agent_id)
        assert result is not None
        assert result.agent_id == sample_agent.agent_id
        assert result.state == sample_agent.state

        # Reading non-existent agent returns None
        result_none = file_manager.read_agent(sample_session.session_id, "nonexistent-agent")
        assert result_none is None

    def test_update_agent(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        sample_agent.state = {"updated": "value"}
        file_manager.update_agent(sample_session.session_id, sample_agent)

        updated = file_manager.read_agent(sample_session.session_id, sample_agent.agent_id)
        assert updated.state == {"updated": "value"}

        # Updating non-existent agent raises
        new_agent = SessionAgent(agent_id="nonexistent", state={})
        with pytest.raises(SessionException):
            file_manager.update_agent(sample_session.session_id, new_agent)


class TestFileSessionManagerMessageOperations:
    def test_create_message(self, file_manager, sample_session, sample_agent, sample_message):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)
        file_manager.create_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        message_path = file_manager._get_message_path(
            sample_session.session_id, sample_agent.agent_id, sample_message.message_id
        )
        assert os.path.exists(message_path)

        # Creating same message again should raise
        with pytest.raises(SessionException):
            file_manager.create_message(sample_session.session_id, sample_agent.agent_id, sample_message)

    def test_read_message(self, file_manager, sample_session, sample_agent, sample_message):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)
        file_manager.create_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        # Create a second message with incremented id
        second_message = SessionMessage.from_message(
            message={"role": "user", "content": [ContentBlock(text="Second message")]},
            index=1,
        )
        file_manager.create_message(sample_session.session_id, sample_agent.agent_id, second_message)

        # Read first message
        result = file_manager.read_message(sample_session.session_id, sample_agent.agent_id, sample_message.message_id)
        assert result is not None
        assert result.message["content"][0]["text"] == "Hello world"

        # Read second message
        result2 = file_manager.read_message(sample_session.session_id, sample_agent.agent_id, second_message.message_id)
        assert result2 is not None
        assert result2.message["content"][0]["text"] == "Second message"

        # Reading non-existent message returns None
        result_none = file_manager.read_message(sample_session.session_id, sample_agent.agent_id, 999)
        assert result_none is None

    def test_list_messages_all(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        messages = []
        for i in range(5):
            msg = SessionMessage.from_message(
                message={
                    "role": "user",
                    "content": [ContentBlock(text=f"Message {i}")],
                },
                index=i,
            )
            messages.append(msg)
            file_manager.create_message(sample_session.session_id, sample_agent.agent_id, msg)

        listed = file_manager.list_messages(sample_session.session_id, sample_agent.agent_id)
        assert len(listed) == 5
        # Check order ascending by message_id
        assert all(listed[i].message_id == i for i in range(5))

    def test_list_messages_with_limit(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        for i in range(10):
            msg = SessionMessage.from_message(
                message={
                    "role": "user",
                    "content": [ContentBlock(text=f"Message {i}")],
                },
                index=i,
            )
            file_manager.create_message(sample_session.session_id, sample_agent.agent_id, msg)

        limited = file_manager.list_messages(sample_session.session_id, sample_agent.agent_id, limit=3)
        assert len(limited) == 3
        assert all(limited[i].message_id == i for i in range(3))

    def test_list_messages_with_offset(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        for i in range(10):
            msg = SessionMessage.from_message(
                message={
                    "role": "user",
                    "content": [ContentBlock(text=f"Message {i}")],
                },
                index=i,
            )
            file_manager.create_message(sample_session.session_id, sample_agent.agent_id, msg)

        offsetted = file_manager.list_messages(sample_session.session_id, sample_agent.agent_id, offset=5)
        assert len(offsetted) == 5
        assert all(offsetted[i].message_id == i + 5 for i in range(5))

    def test_list_messages_with_new_agent(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        # No messages created yet
        messages = file_manager.list_messages(sample_session.session_id, sample_agent.agent_id)
        assert messages == []

    def test_update_message(self, file_manager, sample_session, sample_agent, sample_message):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)
        file_manager.create_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        # Update message content
        sample_message.message["content"] = [ContentBlock(text="Updated content")]
        file_manager.update_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        updated = file_manager.read_message(sample_session.session_id, sample_agent.agent_id, sample_message.message_id)
        assert updated.message["content"][0]["text"] == "Updated content"

        # Updating non-existent message raises
        new_message = SessionMessage.from_message(
            message={"role": "user", "content": [ContentBlock(text="New message")]},
            index=999,
        )
        with pytest.raises(SessionException):
            file_manager.update_message(sample_session.session_id, sample_agent.agent_id, new_message)

# The above tests cover the FileSessionManager behavior related to session, agent, and message creation,
# reading, updating, deleting, and listing with pagination and offsets.
# They exercise the new message_id as int indexing and ensure the logic fails before patch and passes after.[0m
