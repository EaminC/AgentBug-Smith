        assert len(limited_messages) == 3
        for i, msg in enumerate(limited_messages):
            assert msg.message_id == i

    def test_list_messages_with_offset(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)
        for i in range(10):
            message = SessionMessage.from_message(
                message={
                    "role": "user",
                    "content": [ContentBlock(text=f"Message {i}")],
                },
                index=i,
            )
            file_manager.create_message(sample_session.session_id, sample_agent.agent_id, message)
        offset_messages = file_manager.list_messages(sample_session.session_id, sample_agent.agent_id, offset=5)
        assert len(offset_messages) == 5
        for i, msg in enumerate(offset_messages, start=5):
            assert msg.message_id == i


class TestRepositorySessionManagerAppendMessage:
    from strands.session.repository_session_manager import RepositorySessionManager

    @pytest.fixture
    def session_manager(self):
        from tests.fixtures.mock_session_repository import MockedSessionRepository

        repo = MockedSessionRepository()
        return self.RepositorySessionManager(session_id="test-session", session_repository=repo)

    def test_append_message_increments_index(self, session_manager):
        agent = Agent(agent_id="agent1", session_manager=session_manager)
        session_manager.initialize(agent)
        msg1 = {"role": "user", "content": [{"type": "text", "text": "Hello"}]}
        session_manager.append_message(msg1, agent)
        msg2 = {"role": "user", "content": [{"type": "text", "text": "World"}]}
        session_manager.append_message(msg2, agent)

        messages = session_manager.session_repository.list_messages("test-session", "agent1")
        assert len(messages) == 2
        assert messages[0].message_id == 0
        assert messages[1].message_id == 1


class TestRepositorySessionManagerRedactLatestMessage:
    from strands.session.repository_session_manager import RepositorySessionManager

    @pytest.fixture
    def session_manager(self):
        from tests.fixtures.mock_session_repository import MockedSessionRepository

        repo = MockedSessionRepository()
        return self.RepositorySessionManager(session_id="test-session", session_repository=repo)

    def test_redact_latest_message(self, session_manager):
        agent = Agent(agent_id="agent1", session_manager=session_manager)
        session_manager.initialize(agent)
        msg1 = {"role": "user", "content": [{"type": "text", "text": "Hello"}]}
        session_manager.append_message(msg1, agent)

        redact_msg = {"role": "user", "content": [{"type": "text", "text": "Redacted"}]}
        session_manager.redact_latest_message(redact_msg, agent)

        messages = session_manager.session_repository.list_messages("test-session", "agent1")
        assert messages[-1].redact_message == redact_msg

    def test_redact_latest_message_no_message_raises(self, session_manager):
        agent = Agent(agent_id="agent1", session_manager=session_manager)
        session_manager.initialize(agent)
        redact_msg = {"role": "user", "content": [{"type": "text", "text": "Redacted"}]}
        with pytest.raises(SessionException):
            session_manager.redact_latest_message(redact_msg, agent)


