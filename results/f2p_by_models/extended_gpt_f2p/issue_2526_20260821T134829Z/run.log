        self.session_manager.session_repository = MockedSessionRepository()
        self.session_manager.session = Session(session_id="test-session", session_type=SessionType.AGENT)

    def test_initialize_unique_agent_id(self):
        agent1 = Agent(agent_id="agent1", session_manager=self.session_manager)
        self.session_manager.initialize(agent1)

        agent2 = Agent(agent_id="agent1", session_manager=self.session_manager)
        with pytest.raises(SessionException):
            self.session_manager.initialize(agent2)

    def test_initialize_restores_state_and_messages(self):
        # Pre-create agent and messages in repository
        session_agent = SessionAgent(agent_id="agent1", state={"key": "value"})
        self.session_manager.session_repository.create_agent("test-session", session_agent)

        message = SessionMessage.from_message(
            message={
                "role": "user",
                "content": [ContentBlock(text="Hello")],
            },
            index=0,
        )
        self.session_manager.session_repository.create_message("test-session", "agent1", message)

        agent = Agent(agent_id="agent1", session_manager=self.session_manager)
        self.session_manager.initialize(agent)

        assert agent.state.get("key") == "value"
        assert len(agent.messages) == 1
        assert agent.messages[0]["role"] == "user"
        assert agent.messages[0]["content"][0]["text"] == "Hello"


