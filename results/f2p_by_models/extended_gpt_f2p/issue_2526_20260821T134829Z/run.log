class TestFileSessionManagerMessageOperations:
    def test_create_message(self, file_manager, sample_session, sample_agent, sample_message):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        file_manager.create_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        message_path = file_manager._get_message_path(
            sample_session.session_id, sample_agent.agent_id, sample_message.message_id
        )
        assert message_path is not None
        assert message_path.endswith(f"{sample_message.message_id}.json")
        assert message_path.startswith(file_manager._get_agent_path(sample_session.session_id, sample_agent.agent_id))

    def test_read_message(self, file_manager, sample_session, sample_agent, sample_message):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)
        file_manager.create_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        # Create a second message with incremented message_id
        second_message = SessionMessage.from_message(
            message={
                "role": "user",
                "content": [ContentBlock(text="Second message")],
            },
            index=sample_message.message_id + 1,
        )
        file_manager.create_message(sample_session.session_id, sample_agent.agent_id, second_message)

        # Read back the first message
        read_msg = file_manager.read_message(sample_session.session_id, sample_agent.agent_id, sample_message.message_id)
        assert read_msg is not None
        assert read_msg.message["role"] == "user"
        assert read_msg.message["content"][0]["text"] == "Hello world"

        # Read back the second message
        read_msg2 = file_manager.read_message(sample_session.session_id, sample_agent.agent_id, second_message.message_id)
        assert read_msg2 is not None
        assert read_msg2.message["content"][0]["text"] == "Second message"

    def test_update_message(self, file_manager, sample_session, sample_agent, sample_message):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)
        file_manager.create_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        # Update content
        sample_message.message["content"] = [ContentBlock(text="Updated content")]
        file_manager.update_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        updated_msg = file_manager.read_message(sample_session.session_id, sample_agent.agent_id, sample_message.message_id)
        assert updated_msg is not None
        assert updated_msg.message["content"][0]["text"] == "Updated content"

    def test_update_nonexistent_message(self, file_manager, sample_session, sample_agent, sample_message):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        with pytest.raises(SessionException):
            file_manager.update_message(sample_session.session_id, sample_agent.agent_id, sample_message)

    def test_list_messages_all(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        messages = []
        for i in range(5):
            msg = SessionMessage.from_message(
                message={
                    "role": "user",
                    "content": [ContentBlock(text=f"Message {i}")],
                },
                index=i,
            )
            messages.append(msg)
            file_manager.create_message(sample_session.session_id, sample_agent.agent_id, msg)

        listed = file_manager.list_messages(sample_session.session_id, sample_agent.agent_id)
        assert len(listed) == 5
        # Check ordering by message_id ascending
        assert all(listed[i].message_id == i for i in range(5))

    def test_list_messages_with_limit(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        for i in range(10):
            msg = SessionMessage.from_message(
                message={
                    "role": "user",
                    "content": [ContentBlock(text=f"Message {i}")],
                },
                index=i,
            )
            file_manager.create_message(sample_session.session_id, sample_agent.agent_id, msg)

        limited = file_manager.list_messages(sample_session.session_id, sample_agent.agent_id, limit=3)
        assert len(limited) == 3
        assert all(limited[i].message_id == i for i in range(3))

    def test_list_messages_with_offset(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        for i in range(10):
            msg = SessionMessage.from_message(
                message={
                    "role": "user",
                    "content": [ContentBlock(text=f"Message {i}")],
                },
                index=i,
            )
            file_manager.create_message(sample_session.session_id, sample_agent.agent_id, msg)

        offset_msgs = file_manager.list_messages(sample_session.session_id, sample_agent.agent_id, offset=5)
        assert len(offset_msgs) == 5
        assert all(offset_msgs[i].message_id == i + 5 for i in range(5))


class TestRepositorySessionManagerAppendMessage:
    def test_append_message_increments_message_id(self, mock_repository):
        session_manager = RepositorySessionManager(session_id="test-session", session_repository=mock_repository)
        agent = Agent(agent_id="agent1", session_manager=session_manager)
        session_manager.initialize(agent)

        # Append first message
        msg1 = {"role": "user", "content": [{"text": "Hello"}]}
        session_manager.append_message(msg1, agent)

        # Append second message
        msg2 = {"role": "user", "content": [{"text": "Second"}]}
        session_manager.append_message(msg2, agent)

        # The messages should have message_id 0 and 1 respectively
        messages = mock_repository.list_messages("test-session", agent.agent_id)
        assert len(messages) == 2
        assert {m.message_id for m in messages} == {0, 1}

    def test_redact_latest_message_raises_without_message(self, mock_repository):
        session_manager = RepositorySessionManager(session_id="test-session", session_repository=mock_repository)
        agent = Agent(agent_id="agent1", session_manager=session_manager)
        session_manager.initialize(agent)

        with pytest.raises(SessionException):
            session_manager.redact_latest_message({"role": "user", "content": [{"text": "redacted"}]}, agent)

