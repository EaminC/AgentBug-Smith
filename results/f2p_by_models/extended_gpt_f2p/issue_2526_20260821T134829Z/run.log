[32mimport tempfile
import pytest

from strands.agent.agent import Agent
from strands.session.repository_session_manager import RepositorySessionManager
from strands.types.exceptions import SessionException
from strands.types.session import SessionAgent, SessionMessage


class TestRepositorySessionManagerAppendMessage:
    def test_append_message_increments_message_id(self, mock_repository):
        session_manager = RepositorySessionManager(session_id="test-session", session_repository=mock_repository)
        agent = Agent(agent_id="test-agent", session_manager=session_manager)

        # Initialize agent in session manager
        session_manager.initialize(agent)

        # Append first message
        message1 = {"role": "user", "content": [{"type": "text", "text": "Hello 1"}]}
        session_manager.append_message(message1, agent)

        # Append second message
        message2 = {"role": "user", "content": [{"type": "text", "text": "Hello 2"}]}
        session_manager.append_message(message2, agent)

        messages = mock_repository.list_messages("test-session", "test-agent")
        assert len(messages) == 2
        assert messages[0].message_id == 0
        assert messages[1].message_id == 1

    def test_redact_latest_message_raises_without_message(self, mock_repository):
        session_manager = RepositorySessionManager(session_id="test-session", session_repository=mock_repository)
        agent = Agent(agent_id="test-agent", session_manager=session_manager)

        session_manager.initialize(agent)

        with pytest.raises(SessionException, match="No message to redact."):
            session_manager.redact_latest_message({"role": "system", "content": [{"text": "redacted"}]}, agent)

    def test_redact_latest_message_updates_message(self, mock_repository):
        session_manager = RepositorySessionManager(session_id="test-session", session_repository=mock_repository)
        agent = Agent(agent_id="test-agent", session_manager=session_manager)

        session_manager.initialize(agent)

        message = {"role": "user", "content": [{"type": "text", "text": "Hello"}]}
        session_manager.append_message(message, agent)

        redact_message = {"role": "system", "content": [{"text": "redacted"}]}
        session_manager.redact_latest_message(redact_message, agent)

        messages = mock_repository.list_messages("test-session", "test-agent")
        assert messages[-1].redact_message == redact_message

    def test_initialize_agent_creates_messages_with_indices(self, mock_repository):
        session_manager = RepositorySessionManager(session_id="test-session", session_repository=mock_repository)
        agent = Agent(agent_id="test-agent", messages=[
            {"role": "user", "content": [{"text": "Msg 1"}]},
            {"role": "user", "content": [{"text": "Msg 2"}]},
        ])

        session_manager.initialize(agent)

        messages = mock_repository.list_messages("test-session", "test-agent")
        assert len(messages) == 2
        assert messages[0].message_id == 0
        assert messages[1].message_id == 1


class TestFileSessionManagerMessageOperations:
    @pytest.fixture
    def file_manager(self):
        from strands.session.file_session_manager import FileSessionManager

        with tempfile.TemporaryDirectory() as temp_dir:
            manager = FileSessionManager(session_id="test")
            manager.storage_dir = temp_dir
            yield manager

    @pytest.fixture
    def sample_session(self):
        from strands.types.session import Session, SessionType

        return Session(session_id="test-session", session_type=SessionType.AGENT)

    @pytest.fixture
    def sample_agent(self):
        from strands.types.session import SessionAgent

        return SessionAgent(agent_id="test-agent", state={"key": "value"})

    @pytest.fixture
    def sample_message(self):
        from strands.types.session import SessionMessage
        from strands.types.content import ContentBlock

        return SessionMessage.from_message(
            message={
                "role": "user",
                "content": [ContentBlock(text="Hello world")],
            },
            index=0,
        )

    def test_create_message(self, file_manager, sample_session, sample_agent, sample_message):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)
        file_manager.create_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        message_path = file_manager._get_message_path(
            sample_session.session_id, sample_agent.agent_id, sample_message.message_id
        )
        assert message_path is not None
        import os

        assert os.path.exists(message_path)

    def test_read_message(self, file_manager, sample_session, sample_agent, sample_message):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)
        file_manager.create_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        # Create multiple messages when reading
        sample_message.message_id = sample_message.message_id + 1
        file_manager.create_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        result = file_manager.read_message(sample_session.session_id, sample_agent.agent_id, sample_message.message_id)
        assert result is not None
        assert result.message["role"] == sample_message.message["role"]
        assert result.message["content"] == sample_message.message["content"]

    def test_update_message(self, file_manager, sample_session, sample_agent, sample_message):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)
        file_manager.create_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        sample_message.message["content"] = [{"text": "Updated content"}]
        file_manager.update_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        result = file_manager.read_message(sample_session.session_id, sample_agent.agent_id, sample_message.message_id)
        assert result.message["content"][0]["text"] == "Updated content"

    def test_update_nonexistent_message(self, file_manager, sample_session, sample_agent, sample_message):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        with pytest.raises(Exception):
            file_manager.update_message(sample_session.session_id, sample_agent.agent_id, sample_message)

