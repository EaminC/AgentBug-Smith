        with pytest.raises(SessionException, match="does not exist"):
            file_manager.delete_session("nonexistent-session")

    def test_read_corrupted_json_raises(self, file_manager, tmp_path):
        session_dir = tmp_path / "session_corrupt"
        session_dir.mkdir()
        session_file = session_dir / "session.json"
        session_file.write_text("not a valid json")
        with pytest.raises(SessionException):
            file_manager._read_file(str(session_file))


class TestRepositorySessionManagerIntegration:
    """
    This test verifies that the repository session manager's append_message
    correctly assigns message_id indexes and that messages are stored and retrieved properly.
    """

    def test_append_message_assigns_sequential_ids(self, tmp_path):
        from strands.session.repository_session_manager import RepositorySessionManager
        from strands.session.file_session_manager import FileSessionManager

        # Use FileSessionManager as repository for simplicity
        repo = FileSessionManager(session_id="test-session", storage_dir=str(tmp_path))
        manager = RepositorySessionManager(session_id="test-session", session_repository=repo)

        # Create session and agent
        session = Session(session_id="test-session", session_type=SessionType.AGENT)
        repo.create_session(session)

        agent = Agent(agent_id="agent1")
        manager.initialize(agent)

        # Append first message
        msg1 = {"role": "user", "content": [{"text": "First message"}]}
        manager.append_message(msg1, agent)

        # Append second message
        msg2 = {"role": "user", "content": [{"text": "Second message"}]}
        manager.append_message(msg2, agent)

        # Read messages back from repository
        messages = repo.list_messages("test-session", "agent1")
        assert len(messages) == 2
        assert messages[0].message_id == 0
        assert messages[1].message_id == 1
        assert messages[0].message["content"][0]["text"] == "First message"
        assert messages[1].message["content"][0]["text"] == "Second message"

        # Redact latest message
        redact_msg = {"role": "system", "content": [{"text": "Redacted"}]}
        manager.redact_latest_message(redact_msg, agent)

        # Read latest message and verify redact_message is set
        latest_msg = repo.read_message("test-session", "agent1", 1)
        assert latest_msg.redact_message == redact_msg

        # Sync agent state
        agent.state["foo"] = "bar"
        manager.sync_agent(agent)
        updated_agent = repo.read_agent("test-session", "agent1")
        assert updated_agent.state["foo"] == "bar"


# Additional test to verify that Agent.invoke with invocationState plumbing works
def test_agent_invoke_invocation_state(monkeypatch):
    """
    Test that Agent.invoke accepts invocationState and that it is passed through hooks and toolContext.
    This requires importing Agent and mocking internal model client to avoid external calls.
    """
    import asyncio
    from strands.agent.agent import Agent

    # Create a dummy agent with a simple message
    agent = Agent(messages=[{"role": "user", "content": [{"text": "Hello"}]}])

    # Patch the internal model client call to return a dummy response
    async def dummy_stream_async(*args, **kwargs):
        yield {"choices": [{"delta": {"content": "response"}}], "id": "dummy", "object": "chat.completion.chunk"}

    # Patch the Agent._stream_async method to use dummy_stream_async
    monkeypatch.setattr(agent, "_stream_async", dummy_stream_async)

    # Prepare a dummy invocationState dictionary
    invocation_state = {"some_state": "value"}

    # Run the stream_async with invocationState and collect output
    async def run_invoke():
        outputs = []
        async for chunk in agent.stream_async(invocationState=invocation_state):
            outputs.append(chunk)
        return outputs

    outputs = asyncio.run(run_invoke())
    assert outputs, "Agent.stream_async should yield output chunks"
    # Check that the dummy response content is present
    assert any("response" in chunk.get("choices", [{}])[0].get("delta", {}) for chunk in outputs)


