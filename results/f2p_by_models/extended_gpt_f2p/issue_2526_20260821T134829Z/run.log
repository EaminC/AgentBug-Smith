class TestRepositorySessionManagerRedactLatestMessage:
    @pytest.fixture(autouse=True)
    def setup(self):
        self.session_manager = RepositorySessionManager(session_id="test-session", session_repository=None)
        # We replace session_repository with a mock that stores data in memory
        from tests.fixtures.mock_session_repository import MockedSessionRepository

        self.session_manager.session_repository = MockedSessionRepository()
        self.session_manager.session = Session(session_id="test-session", session_type=SessionType.AGENT)

    def test_redact_latest_message(self):
        agent = Agent(agent_id="agent1", session_manager=self.session_manager)
        self.session_manager.initialize(agent)

        # Append a message
        message = {"role": "user", "content": [{"text": "Hello"}]}
        self.session_manager.append_message(message, agent)

        # Redact latest message
        redact_message = {"role": "user", "content": [{"text": "Redacted"}]}
        self.session_manager.redact_latest_message(redact_message, agent)

        # Read back the message from repository
        messages = self.session_manager.session_repository.list_messages("test-session", "agent1")
        assert len(messages) == 1
        assert messages[0].redact_message == redact_message

    def test_redact_latest_message_no_message_raises(self):
        agent = Agent(agent_id="agent1", session_manager=self.session_manager)
        self.session_manager.initialize(agent)

        redact_message = {"role": "user", "content": [{"text": "Redacted"}]}
        with pytest.raises(SessionException):
            self.session_manager.redact_latest_message(redact_message, agent)


class TestRepositorySessionManagerInitialize:
    @pytest.fixture(autouse=True)
    def setup(self):
