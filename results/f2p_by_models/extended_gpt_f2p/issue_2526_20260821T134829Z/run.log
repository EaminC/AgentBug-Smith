class TestFileSessionManagerSessionOperations:
    """Tests for session operations."""

    def test_create_and_read_session(self, file_manager, sample_session):
        # Create session
        created = file_manager.create_session(sample_session)
        assert created.session_id == sample_session.session_id

        # Read session
        read_back = file_manager.read_session(sample_session.session_id)
        assert read_back is not None
        assert read_back.session_id == sample_session.session_id
        assert read_back.session_type == sample_session.session_type

    def test_delete_session(self, file_manager, sample_session):
        file_manager.create_session(sample_session)
        session_path = file_manager._get_session_path(sample_session.session_id)
        assert os.path.exists(session_path)

        file_manager.delete_session(sample_session.session_id)
        assert not os.path.exists(session_path)

    def test_create_session_already_exists_raises(self, file_manager, sample_session):
        file_manager.create_session(sample_session)
        with pytest.raises(SessionException):
            file_manager.create_session(sample_session)


class TestFileSessionManagerAgentOperations:
    """Tests for agent operations."""

    def test_create_and_read_agent(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        agent_read = file_manager.read_agent(sample_session.session_id, sample_agent.agent_id)
        assert agent_read is not None
        assert agent_read.agent_id == sample_agent.agent_id
        assert agent_read.state == sample_agent.state

    def test_update_agent(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        sample_agent.state = {"updated": "value"}
        file_manager.update_agent(sample_session.session_id, sample_agent)

        updated_agent = file_manager.read_agent(sample_session.session_id, sample_agent.agent_id)
        assert updated_agent.state == {"updated": "value"}

    def test_update_nonexistent_agent_raises(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        with pytest.raises(SessionException):
            file_manager.update_agent(sample_session.session_id, sample_agent)


class TestFileSessionManagerMessageOperations:
    """Tests for message operations."""

    def test_create_and_read_message(self, file_manager, sample_session, sample_agent, sample_message):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)
        file_manager.create_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        read_message = file_manager.read_message(sample_session.session_id, sample_agent.agent_id, sample_message.message_id)
        assert read_message is not None
        assert read_message.message_id == sample_message.message_id
        assert read_message.message["role"] == sample_message.message["role"]
        assert read_message.message["content"] == sample_message.message["content"]

    def test_read_nonexistent_message_returns_none(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)
        result = file_manager.read_message(sample_session.session_id, sample_agent.agent_id, 9999)
        assert result is None

    def test_update_message(self, file_manager, sample_session, sample_agent, sample_message):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)
        file_manager.create_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        sample_message.message["content"] = [{"text": "Updated content"}]
        file_manager.update_message(sample_session.session_id, sample_agent.agent_id, sample_message)

        updated = file_manager.read_message(sample_session.session_id, sample_agent.agent_id, sample_message.message_id)
        assert updated.message["content"][0]["text"] == "Updated content"

    def test_update_nonexistent_message_raises(self, file_manager, sample_session, sample_agent, sample_message):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)
        with pytest.raises(SessionException):
            file_manager.update_message(sample_session.session_id, sample_agent.agent_id, sample_message)

    def test_list_messages_all(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        messages = []
        for i in range(5):
            message = SessionMessage.from_message(
                message={
                    "role": "user",
                    "content": [{"text": f"Message {i}"}],
                },
                index=i,
            )
            messages.append(message)
            file_manager.create_message(sample_session.session_id, sample_agent.agent_id, message)

        listed = file_manager.list_messages(sample_session.session_id, sample_agent.agent_id)
        assert len(listed) == 5
        assert all(isinstance(m, SessionMessage) for m in listed)

    def test_list_messages_with_limit(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        for i in range(10):
            message = SessionMessage.from_message(
                message={
                    "role": "user",
                    "content": [{"text": f"Message {i}"}],
                },
                index=i,
            )
            file_manager.create_message(sample_session.session_id, sample_agent.agent_id, message)

        limited = file_manager.list_messages(sample_session.session_id, sample_agent.agent_id, limit=3)
        assert len(limited) == 3

    def test_list_messages_with_offset(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        for i in range(10):
            message = SessionMessage.from_message(
                message={
                    "role": "user",
                    "content": [{"text": f"Message {i}"}],
                },
                index=i,
            )
            file_manager.create_message(sample_session.session_id, sample_agent.agent_id, message)

        offsetted = file_manager.list_messages(sample_session.session_id, sample_agent.agent_id, offset=5)
        assert len(offsetted) == 5

    def test_list_messages_with_limit_and_offset(self, file_manager, sample_session, sample_agent):
        file_manager.create_session(sample_session)
        file_manager.create_agent(sample_session.session_id, sample_agent)

        for i in range(10):
            message = SessionMessage.from_message(
                message={
                    "role": "user",
                    "content": [{"text": f"Message {i}"}],
                },
                index=i,
            )
            file_manager.create_message(sample_session.session_id, sample_agent.agent_id, message)

        subset = file_manager.list_messages(sample_session.session_id, sample_agent.agent_id, limit=3, offset=4)
        assert len(subset) == 3
        assert subset[0].message["content"][0]["text"] == "Message 4"


class TestRepositorySessionManagerIntegration:
    """Integration tests for RepositorySessionManager with FileSessionManager."""

    def test_append_message_assigns_sequential_ids(self, tmp_path):
        repo = FileSessionManager(session_id="test-session", storage_dir=str(tmp_path))
        manager = RepositorySessionManager(session_id="test-session", session_repository=repo)

        session = Session(session_id="test-session", session_type=SessionType.AGENT)
        repo.create_session(session)

        agent = SessionAgent(agent_id="test-agent", state={})
        repo.create_agent(session.session_id, agent)

        # Append first message
        message1 = {"role": "user", "content": [{"type": "text", "text": "Hello"}]}
        manager.append_message(message1, Agent(agent_id="test-agent", session_manager=manager))

        # Append second message
        message2 = {"role": "user", "content": [{"type": "text", "text": "World"}]}
        manager.append_message(message2, Agent(agent_id="test-agent", session_manager=manager))

        messages = repo.list_messages(session.session_id, "test-agent")
        assert len(messages) == 2
        assert messages[0].message_id == 0
        assert messages[1].message_id == 1


