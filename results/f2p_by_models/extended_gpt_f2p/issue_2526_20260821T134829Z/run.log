    # Use setattr on the class, not the instance, because _invoke_async may be a method on the class
    setattr(type(agent), "_invoke_async", dummy_invoke_async)

    # Prepare a dummy invocationState
    invocation_state = {"test_key": "test_value"}

    # Call Agent.invoke with invocationState
    responses = []
    async for chunk in agent.invoke(invocationState=invocation_state):
        responses.append(chunk)

    # Verify the dummy response was yielded
