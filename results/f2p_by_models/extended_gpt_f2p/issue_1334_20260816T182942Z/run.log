import threading
import time

import pytest

from strands.tools.mcp.mcp_client import MCPClient


class DummyBackgroundThread(threading.Thread):
    def __init__(self):
        super().__init__()
        self._stop_event = threading.Event()

    def run(self):
        while not self._stop_event.is_set():
            time.sleep(0.01)

    def stop(self):
        self._stop_event.set()


@pytest.mark.asyncio
async def test_mcpclient_does_not_hang_on_close_future_done(monkeypatch):
    """
    This test checks that MCPClient._is_session_active returns False
    when _close_future is done, to prevent hanging on 5xx errors.

    The buggy code returns True if _background_thread is alive,
    ignoring _close_future.done(), causing hangs.

    The fixed code returns False if _close_future.done() is True,
    preventing hangs.

    We simulate the condition by creating an MCPClient instance,
    setting a dummy alive background thread, and a done _close_future,
    then calling _is_session_active and asserting it returns False.

    This test should fail on buggy code (returns True),
    and pass on fixed code (returns False).
    """

    client = MCPClient()

    # Setup a dummy background thread that is alive
    dummy_thread = DummyBackgroundThread()
    dummy_thread.start()
    try:
        client._background_thread = dummy_thread

        # Setup a done _close_future
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        close_future = loop.create_future()
        close_future.set_result(None)  # Mark done
        client._close_future = close_future

        # Call the method under test
        result = client._is_session_active()

        # The fixed code returns False here, buggy returns True
        assert result is False, (
            "Expected _is_session_active to return False when _close_future is done, "
            "but got True (likely buggy code)."
        )
    finally:
        dummy_thread.stop()
        dummy_thread.join()
        loop.close()
        asyncio.set_event_loop(None)[0m
