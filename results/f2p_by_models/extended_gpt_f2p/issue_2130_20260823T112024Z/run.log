@pytest.mark.asyncio
async def test_format_request_with_guardrail_multiple_tool_results_same_message(model):
    """Test guardContent with multiple parallel tool calls (multiple toolResults in one message)."""
    model.update_config(
        guardrail_id="test-guardrail",
