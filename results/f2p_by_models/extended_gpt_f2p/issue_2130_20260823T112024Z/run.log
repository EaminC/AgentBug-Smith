    assert len(captured_warnings) == 0


@pytest.mark.parametrize("region", ["ca-central-1", "eu-west-1"])
def test_init_with_unsupported_region_warns_and_custom_model_no_warning(region, captured_warnings):
    """Test BedrockModel initialization warns for unsupported regions and no warning with custom model."""
    # Clear warnings before test
    captured_warnings.clear()
    BedrockModel(region_name=region)
    region_warnings = [w for w in captured_warnings if "does not support" in str(w.message)]
    if region == "ca-central-1":
        assert len(region_warnings) == 1
        assert "does not support" in str(region_warnings[0].message)
    else:
        assert len(region_warnings) == 0

    captured_warnings.clear()
    BedrockModel(region_name=region, model_id="custom-model")
    region_warnings = [w for w in captured_warnings if "does not support" in str(w.message)]
    assert len(region_warnings) == 0


def test_override_default_model_id_uses_the_overriden_value(captured_warnings):
    import strands.models.bedrock as bedrock_mod

    original_default = bedrock_mod.DEFAULT_BEDROCK_MODEL_ID
    try:
        bedrock_mod.DEFAULT_BEDROCK_MODEL_ID = "custom-overridden-model"
        model_id = BedrockModel._get_default_model_with_warning("us-east-1")
        assert model_id == "custom-overridden-model"
    finally:
        bedrock_mod.DEFAULT_BEDROCK_MODEL_ID = original_default


def test_no_override_uses_formatted_default_model_id(captured_warnings):
    model_id = BedrockModel._get_default_model_with_warning("us-east-1")
    assert model_id == "us.anthropic.claude-sonnet-4-20250514-v1:0"
    # The default model id constant is a format string, so model_id should not equal that raw string
    from strands.models.bedrock import _DEFAULT_BEDROCK_MODEL_ID

    assert model_id != _DEFAULT_BEDROCK_MODEL_ID
    assert all("does not support" not in str(w.message) for w in captured_warnings)


