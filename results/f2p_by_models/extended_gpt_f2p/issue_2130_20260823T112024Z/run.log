@pytest.mark.filterwarnings("ignore::UserWarning")
def test_init_with_unsupported_region_warns():
    # Initializing BedrockModel with unsupported region should warn about no default inference endpoint
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        BedrockModel(region_name="ca-central-1")
        region_warnings = [warn for warn in w if "does not support" in str(warn.message)]
        assert len(region_warnings) == 1
        assert "ca-central-1" in str(region_warnings[0].message)


@pytest.mark.filterwarnings("ignore::UserWarning")
def test_init_with_unsupported_region_and_custom_model_no_warning():
    # Initializing BedrockModel with unsupported region but custom model_id disables warning
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        BedrockModel(region_name="ca-central-1", model_id="custom-model")
        # No warnings about unsupported region
        assert all("does not support" not in str(warning.message) for warning in w)


@pytest.mark.filterwarnings("ignore::UserWarning")
def test_override_default_model_id_uses_overridden_value(monkeypatch):
    # Overriding DEFAULT_BEDROCK_MODEL_ID constant changes the returned default model id
    monkeypatch.setattr("strands.models.bedrock.DEFAULT_BEDROCK_MODEL_ID", "custom-overridden-model")
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        model_id = BedrockModel._get_default_model_with_warning("us-east-1")
        assert model_id == "custom-overridden-model"
        # Warning about default model subject to change should be present
        found = any(
            "default model" in str(warning.message).lower()
            and "subject to change" in str(warning.message).lower()
            for warning in w
        )
        assert found


@pytest.mark.filterwarnings("ignore::UserWarning")
def test_no_override_uses_formatted_default_model_id():
    # Without override, default model id is formatted with region prefix
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        model_id = BedrockModel._get_default_model_with_warning("us-east-1")
        expected = "us.anthropic.claude-sonnet-4-20250514-v1:0"
        assert model_id == expected
        # No unsupported region warnings
        assert all("does not support" not in str(warning.message) for warning in w)[0m
