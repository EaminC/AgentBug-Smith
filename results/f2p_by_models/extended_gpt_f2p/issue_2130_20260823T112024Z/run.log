    assert document["source"] == {"s3Location": {"uri": "s3://my-bucket/report.pdf"}}

    assert document_with_bucket_owner["source"] == {
        "s3Location": {"uri": "s3://my-bucket/report.pdf", "bucketOwner": "123456789012"}
