import pytest
from strands.models.bedrock import BedrockModel


@pytest.mark.filterwarnings("ignore::UserWarning")
def test_get_default_model_with_warning_warns_for_default_model():
    # The default model id should trigger a warning about subject to change
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        model_id = BedrockModel._get_default_model_with_warning("us-east-1")
        assert model_id.startswith("us.anthropic.claude-sonnet-4-20250514-v1")
        # There should be a warning about default model subject to change
        found = any(
            "default model" in str(warning.message).lower()
            and "subject to change" in str(warning.message).lower()
            for warning in w
        )
        assert found, "Expected warning about default model being subject to change"


@pytest.mark.filterwarnings("ignore::UserWarning")
def test_get_default_model_with_warning_warns_for_unsupported_region():
    # Unsupported region should warn about no default inference endpoint
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        BedrockModel._get_default_model_with_warning("ca-central-1")
        region_warnings = [warn for warn in w if "does not support" in str(warn.message)]
        assert len(region_warnings) == 1
        assert "ca-central-1" in str(region_warnings[0].message)
        assert "our default inference endpoint" in str(region_warnings[0].message)


@pytest.mark.filterwarnings("ignore::UserWarning")
def test_get_default_model_with_warning_no_warning_for_custom_model_id():
    # Providing a custom model_id disables warning about default model
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        model_id = BedrockModel._get_default_model_with_warning("ca-central-1", {"model_id": "custom-model"})
        assert model_id == "custom-model"
        # No warnings about default model or unsupported region
        assert all(
            "does not support" not in str(warning.message) and "default model" not in str(warning.message).lower()
            for warning in w
        )


def test_default_bedrock_model_id_constant():
    # The default model id constant should be the expected deprecated Sonnet 4 model string
    expected = "us.anthropic.claude-sonnet-4-20250514-v1:0"
    assert BedrockModel.DEFAULT_BEDROCK_MODEL_ID.format("us") == expected


@pytest.mark.filterwarnings("ignore::UserWarning")
def test_bedrock_model_default_model_id_is_formatted_default():
    # When no model_id is passed, BedrockModel uses the formatted default model id
    model = BedrockModel()
    model_id = model.get_config().get("model_id")
    expected = BedrockModel.DEFAULT_BEDROCK_MODEL_ID.format("us")
    assert model_id == expected


@pytest.mark.filterwarnings("ignore::UserWarning")
def test_bedrock_model_custom_model_id_not_overridden():
    # Custom model_id is respected and not overridden by region formatting
    custom_model_id = "custom.model.id"
    model = BedrockModel(model_id=custom_model_id)
    model_id = model.get_config().get("model_id")
    assert model_id == custom_model_id


@pytest.mark.filterwarnings("ignore::UserWarning")
def test_get_default_model_with_warning_supported_regions_no_unsupported_warning():
    # Supported regions should not emit unsupported region warnings
    supported_regions = ["us-west-2", "eu-west-2", "us-east-1", "eu-west-1", "us-gov-west-1"]
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        for region in supported_regions:
            BedrockModel._get_default_model_with_warning(region)
        # No warnings about unsupported regions
        assert all("does not support" not in str(warning.message) for warning in w)


