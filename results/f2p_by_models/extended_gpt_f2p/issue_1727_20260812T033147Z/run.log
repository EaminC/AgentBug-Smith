[32m# -*- coding: utf-8 -*-
"""Fail2pass tests for the ReplyBudgetControlMiddleware enforcing token budgets."""
from unittest.async_case import IsolatedAsyncioTestCase

from agentscope.agent import Agent
from agentscope.message import UserMsg, HintBlock, TextBlock, ToolCallBlock
from agentscope.middleware import ReplyBudgetControlMiddleware
from agentscope.model import ChatResponse, ChatUsage
from agentscope.tool import ToolBase, Toolkit, ToolChunk
from agentscope.permission import (
    PermissionBehavior,
    PermissionContext,
    PermissionDecision,
)


def _make_response(text: str, input_tokens: int, output_tokens: int) -> ChatResponse:
    """Helper to create a ChatResponse with usage info."""
    return ChatResponse(
        content=[TextBlock(text=text)],
        is_last=True,
        usage=ChatUsage(input_tokens=input_tokens, output_tokens=output_tokens, time=0.0),
    )


class DummyTool(ToolBase):
    """A dummy tool that always allows and returns a fixed result."""

    name = "dummy"
    description = "Dummy tool for testing"
    input_schema = {"type": "object", "properties": {}}
    is_concurrency_safe = True
    is_read_only = True
    is_external_tool = False
    is_mcp = False

    async def check_permissions(self, tool_input: dict, context: PermissionContext) -> PermissionDecision:
        return PermissionDecision(
            behavior=PermissionBehavior.ALLOW,
            decision_reason="Always allow",
            message="Always allow",
        )

    async def __call__(self, **kwargs) -> ToolChunk:
        return ToolChunk(content=[TextBlock(text="ok")])


def _contains_hint_block(msg, hint_message: str) -> bool:
    """Return True if the message content contains a HintBlock with the given hint_message substring."""
    content = getattr(msg, "content", None)
    if not isinstance(content, list):
        return False
    return any(isinstance(block, HintBlock) and hint_message in block.hint for block in content)


class TestReplyBudgetControlMiddleware(IsolatedAsyncioTestCase):
    """Tests for ReplyBudgetControlMiddleware enforcing token budgets."""

    async def asyncSetUp(self):
        self.toolkit = Toolkit(tools=[DummyTool()])

    async def test_hint_not_injected_when_under_budget(self):
        """No hint block is injected when token usage is below budget."""
        class DummyModel:
            async def _call_api(self, *args, **kwargs):
                return _make_response("done", input_tokens=10, output_tokens=5)

            async def count_tokens(self, *args, **kwargs):
                return 0

        model = DummyModel()
        middleware = ReplyBudgetControlMiddleware(token_budget=1000)
        agent = Agent(
            name="test_agent",
            system_prompt="You are helpful.",
            model=model,
            toolkit=self.toolkit,
            middlewares=[middleware],
        )

        context_len_before = len(agent.state.context)
        await agent.reply(UserMsg("user", "hello"))

        # No HintBlock should be injected
        hint_msgs = [
            m
            for m in agent.state.context[context_len_before:]
            if _contains_hint_block(m, middleware.hint_message)
        ]
        self.assertEqual(len(hint_msgs), 0)

    async def test_hint_injected_when_budget_exceeded(self):
        """HintBlock is injected when token budget is exceeded (token_budget=0 triggers immediately)."""
        class DummyModel:
            async def _call_api(self, *args, **kwargs):
                return _make_response("wrap up", input_tokens=10, output_tokens=5)

            async def count_tokens(self, *args, **kwargs):
                return 0

        model = DummyModel()
        middleware = ReplyBudgetControlMiddleware(token_budget=0)
        agent = Agent(
            name="test_agent",
            system_prompt="You are helpful.",
            model=model,
            toolkit=self.toolkit,
            middlewares=[middleware],
        )

        context_len_before = len(agent.state.context)
        await agent.reply(UserMsg("user", "hello"))

        hint_msgs = [
            m
            for m in agent.state.context[context_len_before:]
            if _contains_hint_block(m, middleware.hint_message)
        ]
        self.assertGreater(len(hint_msgs), 0)

    async def test_tool_choice_forced_none_when_budget_exceeded(self):
        """When budget exceeded, tool_choice passed to model call is forced to mode='none'."""

        tool_choice_modes = []

        class TrackingModel:
            def __init__(self):
                self._calls = 0

            async def _call_api(self, *args, **kwargs):
                tool_choice = kwargs.get("tool_choice")
                if tool_choice is not None:
                    tool_choice_modes.append(getattr(tool_choice, "mode", None))
                self._calls += 1
                return _make_response("response", input_tokens=10, output_tokens=5)

            async def count_tokens(self, *args, **kwargs):
                return 0

        model = TrackingModel()
        middleware = ReplyBudgetControlMiddleware(token_budget=0)
        agent = Agent(
            name="test_agent",
            system_prompt="You are helpful.",
            model=model,
            toolkit=self.toolkit,
            middlewares=[middleware],
        )

        await agent.reply(UserMsg("user", "hello"))

        # At least one call must have tool_choice.mode == "none"
        self.assertTrue(any(mode == "none" for mode in tool_choice_modes if mode is not None))

