[32m# -*- coding: utf-8 -*-
"""Fail2pass test for the ReplyBudgetControlMiddleware enforcing token budget."""

import asyncio
from unittest.async_case import IsolatedAsyncioTestCase

from agentscope.agent import Agent
from agentscope.message import UserMsg, HintBlock
from agentscope.middleware import ReplyBudgetControlMiddleware
from agentscope.model import ChatResponse, ChatUsage
from agentscope.tool import ToolBase, Toolkit, ToolChunk
from agentscope.permission import (
    PermissionBehavior,
    PermissionContext,
    PermissionDecision,
)


def _response(text: str, input_tokens: int, output_tokens: int) -> ChatResponse:
    """Build a non-streaming ChatResponse with usage."""
    return ChatResponse(
        content=[text],
        is_last=True,
        usage=ChatUsage(
            input_tokens=input_tokens,
            output_tokens=output_tokens,
            time=0.0,
        ),
    )


class DummyTool(ToolBase):
    """Minimal tool that always allows and returns a fixed result."""

    name: str = "dummy"
    description: str = "A dummy tool for testing"
    input_schema: dict = {"type": "object", "properties": {}}
    is_concurrency_safe: bool = True
    is_read_only: bool = True
    is_external_tool: bool = False
    is_mcp: bool = False

    async def check_permissions(
        self,
        tool_input: dict,
        context: PermissionContext,
    ) -> PermissionDecision:
        """Always allow."""
        return PermissionDecision(
            behavior=PermissionBehavior.ALLOW,
            decision_reason="Dummy tool always allows",
            message="Dummy tool always allows",
        )

    async def __call__(self, **kwargs) -> ToolChunk:
        """Return a fixed result."""
        return ToolChunk(content=["ok"])


class TestReplyBudgetControlMiddleware(IsolatedAsyncioTestCase):
    """Test that ReplyBudgetControlMiddleware enforces token budget correctly."""

    async def asyncSetUp(self):
        self.toolkit = Toolkit(tools=[DummyTool()])

    async def test_hint_injected_when_budget_exceeded(self):
        """Test that when token budget is exceeded, a hint block is injected."""

        class DummyModel:
            def __init__(self):
                self._calls = 0

            async def _call_api(self, *args, **kwargs):
                self._calls += 1
                # On first call, return usage that hits the budget exactly
                if self._calls == 1:
                    return ChatResponse(
                        content=["tool call"],
                        is_last=True,
                        usage=ChatUsage(input_tokens=50, output_tokens=50, time=0.0),
                    )
                # On second call, normal small usage
                return ChatResponse(
                    content=["final response"],
                    is_last=True,
                    usage=ChatUsage(input_tokens=10, output_tokens=10, time=0.0),
                )

        model = DummyModel()
        # Token budget set so that first call uses 100 tokens (50+50), budget=100
        middleware = ReplyBudgetControlMiddleware(token_budget=100)
        agent = Agent(
            name="test_agent",
            system_prompt="You are helpful.",
            model=model,
            toolkit=self.toolkit,
            middlewares=[middleware],
        )

        # Send a user message to trigger reply
        await agent.reply(UserMsg("user", "hello"))

        # After reply, check if a HintBlock with the middleware hint message is present
        hint_message = middleware.hint_message
        found_hint = False
        for msg in agent.state.context:
            content = getattr(msg, "content", None)
            if isinstance(content, list):
                for block in content:
                    if isinstance(block, HintBlock) and hint_message in block.hint:
                        found_hint = True
                        break
            if found_hint:
                break

        self.assertTrue(found_hint, "HintBlock was not injected when budget exceeded.")

    async def test_tool_choice_forced_none_when_budget_exceeded(self):
        """Test that tool_choice is forced to 'none' when budget is exceeded."""

        tool_choice_modes = []

        class TrackingModel:
            def __init__(self):
                self._calls = 0

            async def _call_api(self, *args, **kwargs):
                tool_choice = kwargs.get("tool_choice")
                if tool_choice is not None:
                    tool_choice_modes.append(getattr(tool_choice, "mode", None))
                self._calls += 1
                return ChatResponse(
                    content=["response"],
                    is_last=True,
                    usage=ChatUsage(input_tokens=10, output_tokens=5, time=0.0),
                )

        model = TrackingModel()
        # Set budget to 0 so budget exceeded immediately
        middleware = ReplyBudgetControlMiddleware(token_budget=0)
        agent = Agent(
            name="test_agent",
            system_prompt="You are helpful.",
            model=model,
            toolkit=self.toolkit,
            middlewares=[middleware],
        )

        await agent.reply(UserMsg("user", "hello"))

        # At least one call should have tool_choice.mode == "none"
        self.assertTrue(
            any(mode == "none" for mode in tool_choice_modes),
            "tool_choice.mode was not forced to 'none' when budget exceeded.",
        )

    async def test_state_cleanup_after_reply(self):
        """Test that middleware state is cleaned up after reply ends."""

        class DummyModel:
            async def _call_api(self, *args, **kwargs):
                return ChatResponse(
                    content=["done"],
                    is_last=True,
                    usage=ChatUsage(input_tokens=10, output_tokens=5, time=0.0),
                )

        model = DummyModel()
        middleware = ReplyBudgetControlMiddleware(token_budget=1000)
        agent = Agent(
            name="test_agent",
            system_prompt="You are helpful.",
            model=model,
            toolkit=self.toolkit,
            middlewares=[middleware],
        )

        await agent.reply(UserMsg("user", "hello"))

        middleware_key = await middleware.get_middleware_key()
        middle_context = agent.state.middle_context.get(middleware_key, {})
        self.assertEqual(len(middle_context), 0, "Middleware state not cleaned up after reply.")

    async def test_hint_not_injected_when_under_budget(self):
        """Test that no hint block is injected if token usage stays under budget."""

        class DummyModel:
            async def _call_api(self, *args, **kwargs):
                return ChatResponse(
                    content=["normal response"],
                    is_last=True,
                    usage=ChatUsage(input_tokens=10, output_tokens=5, time=0.0),
                )

        model = DummyModel()
        middleware = ReplyBudgetControlMiddleware(token_budget=1000)
        agent = Agent(
            name="test_agent",
            system_prompt="You are helpful.",
            model=model,
            toolkit=self.toolkit,
            middlewares=[middleware],
        )

        context_len_before = len(agent.state.context)
        await agent.reply(UserMsg("user", "hello"))
        context_len_after = len(agent.state.context)

        # No new HintBlock should be added
        hint_message = middleware.hint_message
        found_hint = False
        for msg in agent.state.context[context_len_before:context_len_after]:
            content = getattr(msg, "content", None)
            if isinstance(content, list):
                for block in content:
                    if isinstance(block, HintBlock) and hint_message in block.hint:
                        found_hint = True
                        break
            if found_hint:
                break

        self.assertFalse(found_hint, "HintBlock was injected even though budget not exceeded.")[0m
