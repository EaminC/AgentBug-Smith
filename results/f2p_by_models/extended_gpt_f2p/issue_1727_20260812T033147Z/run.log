            system_prompt="You are helpful.",
            model=model,
            toolkit=self.toolkit,
            middlewares=[middleware],
        )

        context_len_before = len(agent.state.context)
        await agent.reply(UserMsg("user", "hello"))

        hint_msgs = [
            m
            for m in agent.state.context[context_len_before:]
            if _contains_hint_block(m, middleware.hint_message)
        ]
        self.assertGreater(len(hint_msgs), 0)

