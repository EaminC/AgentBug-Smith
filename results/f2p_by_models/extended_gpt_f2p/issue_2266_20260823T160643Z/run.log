    exp_cache_point = {"cachePoint": {"type": cache_type}}
    assert tru_request["toolConfig"]["tools"][-1] == exp_cache_point


def test_format_request_cache_tools_string_backward_compat(model, messages, model_id, tool_spec, cache_type):
