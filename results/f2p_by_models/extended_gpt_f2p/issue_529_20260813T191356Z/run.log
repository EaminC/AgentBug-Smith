import strands.telemetry.metrics
from strands.types.event_loop import Usage
from strands.telemetry.metrics import EventLoopMetrics, metrics_to_string


@pytest.fixture
def event_loop_metrics():
    # Provide a fresh EventLoopMetrics instance for tests
    return EventLoopMetrics()


def test_event_loop_metrics_update_usage_accumulates_cache_tokens(event_loop_metrics):
    # Provide Usage dicts with cache tokens
    usage1 = Usage(inputTokens=1, outputTokens=2, totalTokens=3, cacheReadInputTokens=4, cacheWriteInputTokens=5)
    usage2 = Usage(inputTokens=2, outputTokens=3, totalTokens=5, cacheReadInputTokens=6, cacheWriteInputTokens=7)

    event_loop_metrics.update_usage(usage1)
    event_loop_metrics.update_usage(usage2)

    expected = Usage(
        inputTokens=3,
        outputTokens=5,
        totalTokens=8,
        cacheReadInputTokens=10,
        cacheWriteInputTokens=12,
    )

    # The accumulated_usage should include the sum of all tokens including cached tokens
    assert event_loop_metrics.accumulated_usage == expected


def test_metrics_summary_includes_cached_token_fields(event_loop_metrics):
    # Setup accumulated_usage with cached token fields
    event_loop_metrics.accumulated_usage = Usage(
        inputTokens=10,
        outputTokens=20,
        totalTokens=30,
        cacheReadInputTokens=40,
        cacheWriteInputTokens=50,
    )
    event_loop_metrics.accumulated_metrics = {"latencyMs": 123}

    # Generate summary lines from metrics_to_string generator
    summary_lines = list(metrics_to_string(event_loop_metrics))

    # The tokens line should include cached token fields
    tokens_line = None
    for line in summary_lines:
        if line.startswith("├─ Tokens:"):
            tokens_line = line
            break

    assert tokens_line is not None
    assert "in=10" in tokens_line
    assert "out=20" in tokens_line
    assert "total=30" in tokens_line
    assert "cache_read_input_tokens=40" in tokens_line
    assert "cache_write_input_tokens=50" in tokens_line


