[32mFROM python:3.12-slim AS test_builder

# Set working directory
WORKDIR /app

# Copy entire repository for build and test including injected tests
COPY . .

# Set Forge environment variables as required
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Determine if src/ directory or imports from src. exist to decide install method
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        # src/ layout detected: only install requirements and test deps, set PYTHONPATH to avoid double installs; no editable install
        python -m pip install --upgrade pip setuptools wheel; \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout pytest-block-network mem0ai vcrpy json_repair chromadb syrupy respx langgraph-checkpoint-sqlite aiosqlite langgraph-checkpoint-postgres "psycopg[binary,pool]" redis apscheduler fastapi fakeredis "ray[default]" boto3 agno pydantic-ai fastmcp agno pydantic-ai fastmcp; \
        export PYTHONPATH=/app; \
    else \
        # No src/ layout detected: install requirements, editable install and test deps
        python -m pip install --upgrade pip setuptools wheel; \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout pytest-block-network mem0ai vcrpy json_repair chromadb syrupy respx langgraph-checkpoint-sqlite aiosqlite langgraph-checkpoint-postgres "psycopg[binary,pool]" redis apscheduler fastapi fakeredis "ray[default]" boto3 agno pydantic-ai fastmcp agno pydantic-ai fastmcp; \
    fi

# Preflight import check to fail early if core packages are missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests using hatch as configured in pyproject.toml; fallback to pytest if hatch not installed
RUN set -eux; \
    if command -v hatch >/dev/null 2>&1; then \
        hatch test tests; \
    else \
        pytest tests; \
    fi

