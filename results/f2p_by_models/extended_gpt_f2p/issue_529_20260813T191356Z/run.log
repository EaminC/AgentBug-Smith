import strands.event_loop.streaming


def test_extract_usage_metrics_with_cache_tokens():
    event = {
        "usage": {
            "inputTokens": 10,
            "outputTokens": 20,
            "totalTokens": 30,
            "cacheReadInputTokens": 5,
            "cacheWriteInputTokens": 3,
        },
        "metrics": {"latencyMs": 100},
    }

    usage, metrics = strands.event_loop.streaming.extract_usage_metrics(event)

    assert usage["inputTokens"] == 10
    assert usage["outputTokens"] == 20
    assert usage["totalTokens"] == 30
    assert usage["cacheReadInputTokens"] == 5
    assert usage["cacheWriteInputTokens"] == 3
    assert metrics["latencyMs"] == 100

    # Also test that missing cached tokens does not cause errors
    event2 = {
        "usage": {"inputTokens": 1, "outputTokens": 2, "totalTokens": 3},
        "metrics": {"latencyMs": 50},
    }
    usage2, metrics2 = strands.event_loop.streaming.extract_usage_metrics(event2)
    assert usage2["inputTokens"] == 1
    assert usage2["outputTokens"] == 2
    assert usage2["totalTokens"] == 3
    assert "cacheReadInputTokens" not in usage2
    assert "cacheWriteInputTokens" not in usage2
    assert metrics2["latencyMs"] == 50


@pytest.mark.asyncio
async def test_stream_messages_with_cache_tokens(agenerator, alist):
    # Mock model that streams messages including usage with cache tokens
    class MockModel:
        def stream(self, messages, tool_specs, system_prompt):
            # Yield a sequence of events including usage with cache tokens
            yield {"contentBlockDelta": {"delta": {"text": "hello"}}}
            yield {"contentBlockStop": {}}
            yield {
                "metadata": {
                    "usage": {
                        "inputTokens": 10,
                        "outputTokens": 20,
                        "totalTokens": 30,
                        "cacheReadInputTokens": 5,
                        "cacheWriteInputTokens": 3,
                    },
                    "metrics": {"latencyMs": 100},
                }
            }

    mock_model = MockModel()

    stream = strands.event_loop.streaming.stream_messages(
        mock_model,
        system_prompt="prompt",
        messages=[{"role": "assistant", "content": [{"text": "hi"}]}],
        tool_specs=None,
    )

    events = await alist(stream)

    # The last event should contain the stop event with usage including cache tokens
    stop_event = None
    for e in events:
        if "stop" in e:
            stop_event = e["stop"]
            break

    assert stop_event is not None
    stop_reason, message, usage, metrics = stop_event
    assert usage["inputTokens"] == 10
    assert usage["outputTokens"] == 20
    assert usage["totalTokens"] == 30
    assert usage["cacheReadInputTokens"] == 5
    assert usage["cacheWriteInputTokens"] == 3
    assert metrics["latencyMs"] == 100


