[32mimport pytest

import strands.event_loop.streaming
from strands.types.event_loop import Usage


def test_usage_type_accepts_cached_tokens():
    # This test ensures that Usage TypedDict accepts the new optional cached token fields
    usage_data = Usage(
        inputTokens=10,
        outputTokens=20,
        totalTokens=30,
        cacheReadInputTokens=5,
        cacheWriteInputTokens=7,
    )
    assert usage_data["inputTokens"] == 10
    assert usage_data["outputTokens"] == 20
    assert usage_data["totalTokens"] == 30
    assert usage_data["cacheReadInputTokens"] == 5
    assert usage_data["cacheWriteInputTokens"] == 7


def test_extract_usage_metrics_with_cache_tokens():
    event = {
        "usage": {
            "inputTokens": 0,
            "outputTokens": 0,
            "totalTokens": 0,
            "cacheReadInputTokens": 3,
            "cacheWriteInputTokens": 4,
        },
        "metrics": {"latencyMs": 0},
    }

    tru_usage, tru_metrics = strands.event_loop.streaming.extract_usage_metrics(event)
    exp_usage, exp_metrics = event["usage"], event["metrics"]

    assert tru_usage == exp_usage and tru_metrics == exp_metrics


def test_accumulated_usage_includes_cache_tokens(event_loop_metrics):
    # Prepare usage with cached tokens
    usage = Usage(
        inputTokens=1,
        outputTokens=2,
        totalTokens=3,
        cacheReadInputTokens=4,
        cacheWriteInputTokens=5,
    )

    # Update usage multiple times
    for _ in range(2):
        event_loop_metrics.update_usage(usage)

    tru_usage = event_loop_metrics.accumulated_usage

    # Expected accumulated values
    exp_usage = Usage(
        inputTokens=2,
        outputTokens=4,
        totalTokens=6,
        cacheReadInputTokens=8,
        cacheWriteInputTokens=10,
    )

    assert tru_usage == exp_usage


def test_metrics_summary_includes_cache_tokens(event_loop_metrics):
    # Prepare usage with cached tokens
    usage = Usage(
        inputTokens=1,
        outputTokens=2,
        totalTokens=3,
        cacheReadInputTokens=7,
        cacheWriteInputTokens=11,
    )
    event_loop_metrics.update_usage(usage)

    # Get summary string lines
    lines = list(strands.telemetry.metrics._metrics_summary_to_lines(event_loop_metrics))

    # Find the tokens line
    tokens_line = None
    for line in lines:
        if line.startswith("├─ Tokens:"):
            tokens_line = line
            break

    assert tokens_line is not None
    # Check that the cached token fields are included in the summary line
    assert "cache_read_input_tokens=7" in tokens_line
    assert "cache_write_input_tokens=11" in tokens_line


@pytest.mark.asyncio
async def test_stream_messages_cache_token_usage(monkeypatch, agenerator, alist):
    # This test mocks a model that returns usage with cached tokens in the metadata
    class MockModel:
        def stream(self, messages, tool_specs, system_prompt):
            return agenerator(
                [
                    {"contentBlockDelta": {"delta": {"text": "hello"}}},
                    {"contentBlockStop": {}},
                    {
                        "metadata": {
                            "usage": {
                                "inputTokens": 1,
                                "outputTokens": 1,
                                "totalTokens": 2,
                                "cacheReadInputTokens": 3,
                                "cacheWriteInputTokens": 4,
                            },
                            "metrics": {"latencyMs": 5},
                        }
                    },
                ]
            )

    mock_model = MockModel()

    stream = strands.event_loop.streaming.stream_messages(
        mock_model,
        system_prompt="prompt",
        messages=[{"role": "user", "content": [{"text": "hi"}]}],
        tool_specs=None,
    )

    events = await alist(stream)

    # The last event should contain the stop with usage including cached tokens
    stop_event = None
    for event in events:
        if "stop" in event:
            stop_event = event
            break

    assert stop_event is not None
    _, _, usage, _ = stop_event["stop"]
    assert usage.get("cacheReadInputTokens") == 3
    assert usage.get("cacheWriteInputTokens") == 4[0m
