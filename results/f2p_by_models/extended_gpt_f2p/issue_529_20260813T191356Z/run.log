def event_loop_metrics():
    return strands.telemetry.metrics.EventLoopMetrics()


def test_accumulated_usage_includes_cache_tokens(event_loop_metrics):
    # Provide Usage dict with cacheReadInputTokens and cacheWriteInputTokens
    usage = Usage(
        inputTokens=5,
        outputTokens=10,
        totalTokens=15,
        cacheReadInputTokens=7,
        cacheWriteInputTokens=3,
    )

    # Update usage multiple times to accumulate
    event_loop_metrics.update_usage(usage)
    event_loop_metrics.update_usage(usage)

    # Expected accumulated values
    expected_usage = Usage(
        inputTokens=10,
        outputTokens=20,
        totalTokens=30,
        cacheReadInputTokens=14,
        cacheWriteInputTokens=6,
    )

    assert event_loop_metrics.accumulated_usage == expected_usage


def test_metrics_summary_includes_cache_tokens(event_loop_metrics):
    # Provide Usage dict with cacheReadInputTokens and cacheWriteInputTokens
    usage = Usage(
        inputTokens=1,
        outputTokens=2,
        totalTokens=3,
        cacheReadInputTokens=4,
        cacheWriteInputTokens=5,
    )
    event_loop_metrics.update_usage(usage)

    # Provide Metrics dict (latencyMs)
    metrics = {"latencyMs": 10}
    event_loop_metrics.update_metrics(metrics)

    # Get summary string lines generator
    lines = list(strands.telemetry.metrics._metrics_summary_to_lines(event_loop_metrics))

    # Find the tokens line
    tokens_line = None
    for line in lines:
        if line.startswith("├─ Tokens:"):
            tokens_line = line
            break

    assert tokens_line is not None
    # Check that cached token fields appear in the summary line
    assert "cache_read_input_tokens=4" in tokens_line
    assert "cache_write_input_tokens=5" in tokens_line


def test_usage_typed_dict_accepts_cache_tokens():
    # This test verifies that Usage TypedDict accepts cache token keys without error
