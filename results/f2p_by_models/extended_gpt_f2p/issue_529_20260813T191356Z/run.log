def test_update_usage_records_cache_tokens(event_loop_metrics, usage_dict, expected_cache_read, expected_cache_write):
    # Reset accumulated_usage to zero tokens before update
    event_loop_metrics.accumulated_usage = Usage(inputTokens=0, outputTokens=0, totalTokens=0)

    # Update usage with given usage_dict
    event_loop_metrics.update_usage(usage_dict)

    # Check if cacheReadInputTokens is recorded and accumulated if present
    has_cache_read = "cacheReadInputTokens" in event_loop_metrics.accumulated_usage
    assert has_cache_read == expected_cache_read

    # Check if cacheWriteInputTokens is recorded and accumulated if present
    has_cache_write = "cacheWriteInputTokens" in event_loop_metrics.accumulated_usage
    assert has_cache_write == expected_cache_write

    # If present, accumulated values should be equal to the input usage for this single update
    if expected_cache_read:
        assert event_loop_metrics.accumulated_usage["cacheReadInputTokens"] == usage_dict["cacheReadInputTokens"]
    if expected_cache_write:
        assert event_loop_metrics.accumulated_usage["cacheWriteInputTokens"] == usage_dict["cacheWriteInputTokens"][0m
