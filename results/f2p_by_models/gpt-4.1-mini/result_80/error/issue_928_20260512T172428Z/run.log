[32mimport pytest

from gpt_engineer.core.chat_to_files import Edit, apply_edits


def test_apply_edit_new_file(log_capture):
    edits = [Edit("new_file.py", "", "print('Hello, World!')")]
    code = {}
    apply_edits(edits, code)
    assert code == {"new_file.py": "print('Hello, World!')"}
    # Before the fix, the log message "file will be overwritten" is not emitted for new files.
    # After the fix, it should be emitted.
    assert any("file will be overwritten" in msg for msg in log_capture.messages)


def test_apply_edit_existing_file(log_capture):
    edits = [Edit("existing_file.py", "", "print('Hello, World!')")]
    code = {"existing_file.py": "old content"}
    apply_edits(edits, code)
    assert code == {"existing_file.py": "print('Hello, World!')"}
    assert any("file will be overwritten" in msg for msg in log_capture.messages)


def test_apply_edit_no_match(log_capture):
    edits = [Edit("file.py", "non-existent content", "new content")]
    code = {"file.py": "some content"}
    apply_edits(edits, code)
    assert code == {"file.py": "some content"}  # No change
    assert any("code block to be replaced was not found" in msg for msg in log_capture.messages)


def test_apply_edit_multiple_matches(log_capture):
    edits = [Edit("file.py", "repeat", "new")]
    code = {"file.py": "repeat repeat repeat"}
    apply_edits(edits, code)
    assert code == {"file.py": "new new new"}
    assert any("code block to be replaced was found multiple times" in msg for msg in log_capture.messages)


if __name__ == "__main__":
    pytest.main()[0m
