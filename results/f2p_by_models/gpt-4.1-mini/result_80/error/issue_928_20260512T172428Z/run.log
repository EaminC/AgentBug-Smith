[32mimport pytest

from gpt_engineer.core.chat_to_files import Edit, apply_edits


def test_apply_edit_new_file(log_capture):
    edits = [Edit("new_file.py", "", "print('Hello, World!')")]
    code = {}
    apply_edits(edits, code)
    assert code == {"new_file.py": "print('Hello, World!')"}
    # The log message for new file creation should mention "file will be overwritten"
    assert any("file will be overwritten" in message for message in log_capture.messages)


def test_apply_edit_existing_file(log_capture):
    edits = [Edit("existing_file.py", "", "print('Hello, World!')")]
    code = {"existing_file.py": "old content"}
    apply_edits(edits, code)
    assert code == {"existing_file.py": "print('Hello, World!')"}
    # The log message for overwriting existing file should mention "file will be overwritten"
    assert any("file will be overwritten" in message for message in log_capture.messages)


def test_apply_edit_keyerror_scenario():
    """
    This test simulates the bug where apply_edits raises KeyError due to missing filename in files_dict.
    We create an edit for a file not present in the files_dict and verify that no KeyError is raised,
    and the file is added to the dict.
    """
    edits = [Edit("some/dir/myExistingUserControl.xaml", "", "new content")]
    files_dict = {
        "some/dir/other_file.xaml": "old content",
    }
    # Should not raise KeyError
    apply_edits(edits, files_dict)
    # The new file should be added with the new content
    assert files_dict["some/dir/myExistingUserControl.xaml"] == "new content"


if __name__ == "__main__":
    pytest.main()[0m
