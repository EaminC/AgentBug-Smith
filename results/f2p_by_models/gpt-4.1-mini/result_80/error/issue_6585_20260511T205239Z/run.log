@pytest.mark.anyio
async def test_asyncpostgresstore_checkpointer_get_next_version_missing():
    """
    This test attempts to use AsyncPostgresStore as a checkpointer in a Pregel instance.
    Before the patch, this should raise AttributeError because AsyncPostgresStore lacks get_next_version.
    After the patch, it should not raise and should run properly.
    """

    DB_URI = "postgresql+asyncpg://user:password@localhost/testdb"

    # Setup minimal StateGraph
    class State(dict):
        pass

    def node(state):
        return {"count": state.get("count", 0) + 1}

    graph_builder = StateGraph(State)
    graph_builder.add_node("node", node)
    graph_builder.set_entry_point("node")
    graph_builder.set_finish_point("node")
    compiled_graph = graph_builder.compile()

    # Create AsyncPostgresStore instances for store and checkpointer
    # We expect these to be async context managers
    # We will mock the DB URI to a dummy string; actual connection won't be made due to test environment
    # The test is to check for AttributeError on get_next_version attribute

    # We will test Pregel with AsyncPostgresStore as checkpointer and store

    async with AsyncPostgresStore.from_conn_string(DB_URI) as store, AsyncPostgresStore.from_conn_string(DB_URI) as checkpointer:
        await checkpointer.setup()
        await store.setup()

        # Create Pregel instance with AsyncPostgresStore as checkpointer
        # The buggy code raises AttributeError on checkpointer.get_next_version
        # The fixed code should not raise

        pregel = Pregel(
            nodes={"node": node},
            channels={"input": None, "output": None},
            input_channels="input",
            output_channels="output",
            checkpointer=checkpointer,
            store=store,
        )

        # We run invoke to trigger the PregelLoop initialization which uses get_next_version
        # We expect no AttributeError after fix

        # Provide minimal input and config
        config = {"configurable": {"thread_id": "test_thread"}}

        # Run invoke and assert no AttributeError
        try:
            result = await pregel.ainvoke({"input": 0}, config)
        except AttributeError as e:
            # Fail the test if AttributeError related to get_next_version occurs
            if "get_next_version" in str(e):
                pytest.fail("AsyncPostgresStore missing get_next_version attribute")
            else:
                raise
        except Exception as e:
            # Other exceptions are allowed (e.g., connection errors)
            pass
        else:
            # If no exception, assert result is as expected or at least callable
            assert result is not None


def test_compile_with_invalid_checkpointer_type():
    """
    Test that compiling a StateGraph with an invalid checkpointer type raises TypeError.
    This test covers the ensure_valid_checkpointer function added in the patch.
    """
    class State(dict):
        pass

    builder = StateGraph(State)
    builder.add_node("start", lambda state: state)
    builder.set_entry_point("start")
    builder.set_finish_point("start")

    class NotACheckpointer:
        pass

    with pytest.raises(TypeError, match="Invalid checkpointer provided"):
        builder.compile(checkpointer=NotACheckpointer())[0m
