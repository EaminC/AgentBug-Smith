[32mimport pytest
from typing import TypedDict
from langgraph.graph import StateGraph, START
from langgraph.checkpoint.base import BaseCheckpointSaver


def test_asyncpostgresstore_missing_get_next_version(sync_checkpointer: BaseCheckpointSaver) -> None:
    """
    This test attempts to reproduce the AttributeError when using AsyncPostgresStore
    as a checkpointer in a Pregel or StateGraph context that expects a get_next_version method.

    The test builds a minimal StateGraph with AsyncPostgresStore as checkpointer,
    then invokes the graph to trigger the error.

    Before the patch, this test should fail with AttributeError.
    After the patch, it should pass.
    """
    from langgraph.checkpoint_postgres.async_store import AsyncPostgresStore
    import asyncio

    class State(TypedDict):
        count: int

    # Create two AsyncPostgresStore instances for store and checkpointer
    # Use the same connection string from environment or a dummy one
    # For test purposes, use a dummy connection string that does not connect
    # but the test will fail before actual connection due to missing method
    conn_str = "postgresql://user:password@localhost:5432/dbname"

    async def run_graph():
        async with (
            AsyncPostgresStore.from_conn_string(conn_str) as store,
            AsyncPostgresStore.from_conn_string(conn_str) as checkpointer,
        ):
            await checkpointer.setup()
            await store.setup()

            builder = StateGraph(State)
            builder.add_node("increment", lambda state: {"count": state["count"] + 1})
            builder.add_edge(START, "increment")
            graph = builder.compile(checkpointer=checkpointer, store=store)

            config = {"configurable": {"thread_id": "test_thread"}}
            # Invoke the graph asynchronously
            # This should trigger the attribute error before patch,
            # and succeed after patch.
            result = graph.invoke({"count": 0}, config)
            return result

    # Run the async test in event loop
    try:
        result = asyncio.run(run_graph())
    except AttributeError as e:
        # If the error matches the missing get_next_version, re-raise to fail test before patch
        if "'AsyncPostgresStore' object has no attribute 'get_next_version'" in str(e):
            raise
        else:
            pytest.fail(f"Unexpected AttributeError: {e}")
    except Exception as e:
        # Other exceptions fail the test
        pytest.fail(f"Unexpected exception: {e}")
    else:
        # After patch, result should be as expected
        assert result["count"] == 1


