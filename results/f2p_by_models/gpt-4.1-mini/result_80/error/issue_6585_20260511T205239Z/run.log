# --- end inject ---

# Set working directory
WORKDIR /app

# Set environment variables for Forge API and Anthropic compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    FORGE_API_KEY="forge-key" \
    MODEL="tensorblock/gpt-4.1-mini" \
    AI_TEMPERATURE="0.7" \
    GITHUB_TOKEN="ghp_key" \
    TAVILY_API_KEY="tvly-key" \
    ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini" \
    ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"

# Copy all files into container
COPY . .

# Install OS dependencies needed for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies from requirements.txt if exists
RUN if [ -f "requirements.txt" ]; then pip install -r requirements.txt; fi

# Install mandatory test and helper packages, including missing ones from previous errors
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout litellm "setuptools<=81.0.0" nbconvert bs4 mkdocs nbformat psycopg dataclasses-json langchain-core numpy

# Install the repository itself to make its modules importable
RUN pip install -e .

# Preflight verification that basic packages and imports are working
RUN python -c 'import setuptools, pytest, nbconvert, numpy; print("preflight ok")'

# Default command to keep container running with bash
CMD ["/bin/bash"]

# branch: python/requirements.txt + Forge API env vars + explicit test deps installation + fix missing nbconvert and numpy
