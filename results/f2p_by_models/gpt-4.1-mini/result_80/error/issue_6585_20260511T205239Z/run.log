[32mFROM python:3.11-slim AS test_builder

WORKDIR /app

# Copy entire repository to retain injected test scripts and full context
COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Upgrade pip and install dependencies, including test dependencies
RUN python -m pip install --upgrade pip setuptools wheel && \
    if [ -f "libs/langgraph/requirements.txt" ]; then \
        pip install -r libs/langgraph/requirements.txt && pip install -e libs/langgraph; \
    elif [ -f "libs/langgraph/pyproject.toml" ] && [ -f "libs/langgraph/poetry.lock" ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi -C libs/langgraph && \
        pip install -e libs/langgraph; \
    elif [ -f "libs/langgraph/pyproject.toml" ]; then \
        pip install -e libs/langgraph; \
    else \
        echo "No recognized Python dependency file found in libs/langgraph"; exit 1; \
    fi && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout

# Preflight to catch import errors early
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run the tests using the Makefile target in libs/langgraph
RUN make -C libs/langgraph test_parallel

