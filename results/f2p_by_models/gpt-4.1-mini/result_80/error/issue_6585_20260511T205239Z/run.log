        result = graph.invoke({})
        assert result == {}

@pytest.mark.asyncio
async def test_asyncpostgresstore_checkpointer_behavior():
    """
    This test verifies that after the fix, AsyncPostgresStore can be used as a checkpointer
    without raising AttributeError, and Pregel and StateGraph work correctly.
    """
    from langgraph.langgraph.checkpoint_postgres.async_store import AsyncPostgresStore

    DB_URI = "postgresql+asyncpg://user:password@localhost/testdb"

    async with AsyncPostgresStore.from_conn_string(DB_URI) as store, AsyncPostgresStore.from_conn_string(DB_URI) as checkpointer:
        await checkpointer.setup()
        await store.setup()

        def simple_node(state):
            return state

        builder = StateGraph(dict)
        builder.add_node("node", simple_node)
        builder.add_edge(START, "node")
        graph = builder.compile(checkpointer=checkpointer)

        pregel = Pregel(
            nodes={"node": simple_node},
            channels={"input": InMemoryStore()},
            input_channels="input",
            output_channels="input",
            checkpointer=checkpointer,
            store=store,
        )

        result = graph.invoke({})
        assert result == {}

        # Also test Pregel invoke
        pregel_result = pregel.invoke({})
        assert pregel_result == {}

def test_compile_with_invalid_checkpointer_type_raises():
    """
    Test that compiling a StateGraph with an invalid checkpointer type raises TypeError.
    This tests the ensure_valid_checkpointer function added in the fix.
    """
    class State(dict):
        pass

    builder = StateGraph(State)
    builder.add_node("start", lambda state: state)
    builder.set_entry_point("start")
    builder.set_finish_point("start")

    class NotACheckpointer:
        pass

    with pytest.raises(TypeError, match="Invalid checkpointer provided"):
        builder.compile(checkpointer=NotACheckpointer())[0m
