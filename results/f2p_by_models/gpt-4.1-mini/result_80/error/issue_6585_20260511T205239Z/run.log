[32mimport asyncio
import pytest
from langgraph.checkpoint.base import BaseCheckpointSaver
from langgraph.store.postgres import AsyncPostgresStore
from langgraph.graph import StateGraph, START
from langgraph.pregel.main import Pregel
from langgraph.types import Command
from langgraph.checkpoint.memory import InMemorySaver


@pytest.mark.anyio
async def test_asyncpostgresstore_missing_get_next_version_method(async_checkpointer: BaseCheckpointSaver):
    """
    This test attempts to use AsyncPostgresStore as a checkpointer in a Pregel agent.
    It should fail on the buggy codebase with AttributeError because AsyncPostgresStore
    lacks the get_next_version method.
    After the fix, the test should pass without error.
    """
    # Setup minimal State and node function
    class State(dict):
        pass

    def node(state):
        return {"foo": "bar"}

    # Create StateGraph with one node
    builder = StateGraph(State)
    builder.add_node("node", node)
    builder.add_edge(START, "node")
    graph = builder.compile(checkpointer=async_checkpointer)

    # Setup AsyncPostgresStore instances for store and checkpointer
    # Use dummy connection string, assuming environment is configured for tests
    conn_str = "postgresql://user:password@localhost:5432/testdb"
    store = AsyncPostgresStore.from_conn_string(conn_str)
    checkpointer = AsyncPostgresStore.from_conn_string(conn_str)

    # Setup Pregel agent with AsyncPostgresStore as checkpointer
    pregel_agent = Pregel(
        nodes={"node": node},
        channels={"input": InMemorySaver(), "output": InMemorySaver()},
        input_channels="input",
        output_channels="output",
        checkpointer=checkpointer,
        store=store,
    )

    # Because AsyncPostgresStore lacks get_next_version, invoking should raise AttributeError on buggy codebase
    with pytest.raises(AttributeError):
        await pregel_agent.ainvoke({"input": "test"})

    # After the fix, the above should not raise and return expected output
    # So test that invoking with InMemorySaver checkpointer works
    pregel_agent_fixed = Pregel(
        nodes={"node": node},
        channels={"input": InMemorySaver(), "output": InMemorySaver()},
        input_channels="input",
        output_channels="output",
        checkpointer=async_checkpointer,
    )
    result = await pregel_agent_fixed.ainvoke({"input": "test"})
    assert result is not None


def test_asyncpostgresstore_compile_with_invalid_checkpointer_type():
    """
    This test verifies that providing an invalid checkpointer type to StateGraph.compile
    raises a TypeError. This is related to the fix that validates checkpointer types.
    """
    class State(dict):
        pass

    builder = StateGraph(State)
    builder.add_node("start", lambda s: s)
    builder.set_entry_point("start")
    builder.set_finish_point("start")

    class NotACheckpointer:
        pass

    with pytest.raises(TypeError, match="Invalid checkpointer provided"):
        builder.compile(checkpointer=NotACheckpointer())[0m
