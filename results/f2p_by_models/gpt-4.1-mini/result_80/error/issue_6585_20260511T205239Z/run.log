    elif [ -f "pyproject.toml" ]; then \
      pip install -e .; \
    fi

# Install the repository itself in editable mode
RUN pip install -e .

# Install mandatory test and helper packages including standard testing tools and litellm
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout litellm "setuptools<=81.0.0" \
    bs4 mkdocs nbformat psycopg dataclasses_json

# Preflight verification that basic packages and imports are working
RUN python -c 'import setuptools, pytest, bs4, mkdocs, nbformat, psycopg, dataclasses_json; print("preflight ok")'

# Default command to keep container running with bash
CMD ["/bin/bash"]

