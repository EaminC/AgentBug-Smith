    DB_URI = os.environ.get("TEST_POSTGRES_URI", "postgresql+asyncpg://user:pass@localhost/testdb")

    # Create two AsyncPostgresStore instances for store and checkpointer
    async with AsyncPostgresStore.from_conn_string(DB_URI) as store, AsyncPostgresStore.from_conn_string(DB_URI) as checkpointer:
        await checkpointer.setup()
        await store.setup()

        # Build a simple StateGraph with one node
        builder = StateGraph(QueryState)

        # Simple node returns input query uppercased
        def node(state: QueryState) -> QueryState:
            return {"query": state["query"].upper()}

        builder.add_node("node", node)
        builder.add_edge(START, "node")

        # Compile Pregel with AsyncPostgresStore as checkpointer and store
        # This should raise AttributeError on buggy codebase
        with pytest.raises(AttributeError, match="get_next_version"):
            graph = builder.compile(checkpointer=checkpointer, store=store)
            # Try to invoke to trigger the error
            asyncio.get_event_loop().run_until_complete(
                graph.ainvoke({"query": "test"}, {"configurable": {"thread_id": "test"}})
            )

        # After fix, the compile and invoke should succeed
        # We test this by monkeypatching AsyncPostgresStore to add get_next_version method
        # Only for test purpose to simulate fixed behavior

        # Patch AsyncPostgresStore to add get_next_version method
        def get_next_version(self, current=None, channel=None):
            return 1

        AsyncPostgresStore.get_next_version = get_next_version

        graph = builder.compile(checkpointer=checkpointer, store=store)
        result = await graph.ainvoke({"query": "test"}, {"configurable": {"thread_id": "test"}})
        assert result == {"query": "TEST"}


