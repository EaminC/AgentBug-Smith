@pytest.mark.asyncio
async def test_asyncpostgresstore_get_next_version_attribute_error():
    """
    This test simulates the bug where AsyncPostgresStore is used as a checkpointer
    but lacks the 'get_next_version' attribute, causing an AttributeError.

    The test attempts to create a Pregel instance with AsyncPostgresStore as the checkpointer,
    and asserts that the AttributeError is raised before the fix.

    After the fix, the test should pass without error.
    """
    from langgraph.langgraph.checkpoint_postgres.async_store import AsyncPostgresStore

    # Setup dummy DB URI for AsyncPostgresStore
    DB_URI = "postgresql+asyncpg://user:password@localhost/testdb"

    # Create AsyncPostgresStore instances for store and checkpointer
    async with AsyncPostgresStore.from_conn_string(DB_URI) as store, AsyncPostgresStore.from_conn_string(DB_URI) as checkpointer:
        await checkpointer.setup()
        await store.setup()

        # Define a simple node function
        def simple_node(state):
            return state

        # Create a StateGraph with one node
        builder = StateGraph(dict)
        builder.add_node("node", simple_node)
        builder.add_edge(START, "node")
        graph = builder.compile(checkpointer=checkpointer)

        # Define a Pregel instance using the AsyncPostgresStore as checkpointer
        # This is the code path that triggers the AttributeError in buggy code
        try:
            pregel = Pregel(
                nodes={"node": simple_node},
                channels={"input": InMemoryStore()},
                input_channels="input",
                output_channels="input",
                checkpointer=checkpointer,
                store=store,
            )
        except AttributeError as e:
