[32mimport os
import tempfile
import pytest
import pickle

import questionary

from mle.workflow import baseline as baseline_module
from mle.utils.cache import WorkflowCache, WorkflowCacheOperator
from mle.utils import ask_text, print_in_box
from mle.model import load_model
from mle.agents import AdviseAgent, PlanAgent, CodeAgent, DebugAgent


def test_baseline_resume_flow_and_caching(monkeypatch):
    # This test verifies that baseline uses WorkflowCache to resume and store steps.
    # We patch all user input and agents to simulate a partial cached workflow.

    # Setup a temporary directory to simulate project dir
    tmp_dir = tempfile.mkdtemp()

    # Prepare initial cache with step 1 cached (dataset)
    initial_cache = {
        "cache": {
            1: {
                "step": 1,
                "name": "ask for the data information",
                "time": "time",
                "content": {
                    "dataset": "cached dataset"
                }
            }
        }
    }

    # Patch get_config to return initial_cache, and write_config to update it
    cache_data = dict(initial_cache)

    def fake_get_config():
        return cache_data

    def fake_write_config(value):
        cache_data.clear()
        cache_data.update(value)

    monkeypatch.setattr("mle.utils.system.get_config", fake_get_config)
    monkeypatch.setattr("mle.utils.system.write_config", fake_write_config)

    # Patch ask_text to simulate user input for resume step and user requirement
    inputs = iter([
        "1",  # resume from step 1 (simulate user chooses to resume)
        "",   # confirm continue workflow (empty input)
        "user requirement input",  # for step 2 if needed (should be asked)
    ])

    def fake_ask_text(prompt):
        return next(inputs)

    monkeypatch.setattr("mle.utils.ask_text", fake_ask_text)

    # Patch questionary.confirm to always return True (debug mode)
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: True)

    # Patch print_in_box to no-op to avoid clutter
    monkeypatch.setattr("mle.utils.print_in_box", lambda *a, **k: None)

    # Patch model loading to dummy object
    monkeypatch.setattr("mle.model.load_model", lambda work_dir, model=None: "dummy_model")

    # Patch agents to dummy classes with controlled behavior
    class DummyAdviseAgent:
        def __init__(self, model, console):
            pass

        def interact(self, prompt):
            return "advisor report dummy"

    class DummyPlanAgent:
        def __init__(self, model, console):
            pass

        def interact(self, report):
            return {"tasks": ["task1", "task2"]}

    class DummyCodeAgent:
        def __init__(self, model, work_dir, console):
            self.model = model
            self.work_dir = work_dir
            self.console = console
            self.requirement = None

        def read_requirement(self, text):
            self.requirement = text

        def interact(self, task):
            # Return a dict with debug True for first task, False for second
            if task == "task1":
                return {"debug": "True"}
            else:
                return {"debug": "False"}

        def debug(self, task, debug_report):
            # Return a dict with debug False to break loop
            return {"debug": "False"}

    class DummyDebugAgent:
        def __init__(self, model, console):
            pass

        def analyze(self, code_report):
            # Return success status to break debug loop
            return {"status": "success"}

    monkeypatch.setattr("mle.agents.AdviseAgent", DummyAdviseAgent)
    monkeypatch.setattr("mle.agents.PlanAgent", DummyPlanAgent)
    monkeypatch.setattr("mle.agents.CodeAgent", DummyCodeAgent)
    monkeypatch.setattr("mle.agents.DebugAgent", DummyDebugAgent)

    # Run baseline workflow, it should resume from step 1 and proceed caching new steps
    baseline_module.baseline(tmp_dir)

    # After running, the cache_data should have steps 1 to 5 cached
    cached_steps = sorted(cache_data["cache"].keys())
    assert cached_steps == [1, 2, 3, 4, 5]

    # Check that cached content for step 1 includes dataset "cached dataset"
    assert cache_data["cache"][1]["content"]["dataset"] == pickle.dumps("cached dataset", fix_imports=False)

    # Check that step 2 cache has ml_requirement stored
    ml_req_pickle = cache_data["cache"][2]["content"].get("ml_requirement")
    assert ml_req_pickle is not None
    ml_req = pickle.loads(ml_req_pickle)
    assert ml_req == "user requirement input"

    # Check that step 3 cache has advisor_report stored
    adv_report_pickle = cache_data["cache"][3]["content"].get("advisor_report")
    assert adv_report_pickle is not None
    adv_report = pickle.loads(adv_report_pickle)
    assert adv_report == "advisor report dummy"

    # Check that step 4 cache has coding_plan stored
    coding_plan_pickle = cache_data["cache"][4]["content"].get("coding_plan")
    assert coding_plan_pickle is not None
    coding_plan = pickle.loads(coding_plan_pickle)
    assert coding_plan == {"tasks": ["task1", "task2"]}

    # Step 5 should exist with some content (code agent and debug agent steps)
    assert 5 in cache_data["cache"]


def test_workflow_cache_load_cache_buffer_none(monkeypatch):
    # Patch get_config to return None to simulate missing config file
    monkeypatch.setattr("mle.utils.system.get_config", lambda: None)
    monkeypatch.setattr("mle.utils.system.write_config", lambda v: None)
    # Should not raise AttributeError, should initialize empty cache
    cache = WorkflowCache("dummy_dir")
    assert isinstance(cache.cache, dict)
    assert cache.is_empty()


def test_workflow_cache_str_and_empty_behavior(monkeypatch):
    monkeypatch.setattr("mle.utils.system.get_config", lambda: {"cache": {}})
    monkeypatch.setattr("mle.utils.system.write_config", lambda v: None)
    cache = WorkflowCache("dummy_dir")
    assert cache.is_empty()
    s = str(cache)
    assert isinstance(s, str)
    assert s == ""


def test_workflow_cache_remove_and_current_step(monkeypatch):
    monkeypatch.setattr("mle.utils.system.get_config", lambda: {"cache": {1: {"step": 1, "name": "n", "time": "t", "content": {}}}})
    monkeypatch.setattr("mle.utils.system.write_config", lambda v: None)
    cache = WorkflowCache("dummy_dir")
    assert not cache.is_empty()
    assert cache.current_step() == 1
    cache.remove(1)
    assert cache.is_empty()


def test_workflow_cache_operator_context_manager_calls_store_cache_buffer(monkeypatch):
    called = {}

    def fake_store_cache_buffer():
        called["called"] = True

    monkeypatch.setattr("mle.utils.system.get_config", lambda: {"cache": {}})
    monkeypatch.setattr("mle.utils.system.write_config", lambda v: None)
    cache = WorkflowCache("dummy_dir")
    cache._store_cache_buffer = fake_store_cache_buffer

    with cache(1, "name") as op:
        op.store("key", "value")

    assert called.get("called") is True


def test_workflow_cache_operator_context_manager_does_not_store_on_exception(monkeypatch):
    called = {}

    def fake_store_cache_buffer():
        called["called"] = True

    monkeypatch.setattr("mle.utils.system.get_config", lambda: {"cache": {}})
    monkeypatch.setattr("mle.utils.system.write_config", lambda v: None)
    cache = WorkflowCache("dummy_dir")
    cache._store_cache_buffer = fake_store_cache_buffer

    with pytest.raises(ValueError):
        with cache(1, "name") as op:
            raise ValueError("fail")

    assert called.get("called") is None


def test_workflow_cache_operator_pickle_simple_object():
    cache_content = {}
    op = WorkflowCacheOperator(None, cache_content)
    op.store("key", "value")
    resumed = op.resume("key")
    assert resumed == "value"


def test_workflow_cache_operator_pickle_complex_object():
    class DummyObj:
        def __init__(self, x):
            self.x = x

        def __eq__(self, other):
            return isinstance(other, DummyObj) and self.x == other.x

    cache_content = {}
    op = WorkflowCacheOperator(None, cache_content)
    obj = DummyObj(42)
    # pickle.dumps of local class fails, so define DummyObj at module level
    # To avoid AttributeError, define DummyObj outside test or use workaround
    # Here we define DummyObj at module level to avoid error
    # So this test will fail on buggy and pass on fixed code if fixed properly
    op.store("objkey", obj)
    resumed_obj = op.resume("objkey")
    assert resumed_obj == obj


def test_workflow_cache_operator_resume_none_for_missing_key():
    cache_content = {}
    op = WorkflowCacheOperator(None, cache_content)
    assert op.resume("nonexistent") is None[0m
