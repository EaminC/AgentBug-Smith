def test_workflow_cache_operator_store_and_resume(tmp_path):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(str(tmp_path))
    with cache(1, "test") as op:
        op.store("key1", "value1")
        op.store("key2", 1234)

    with cache(1, "test") as op:
        val1 = op.resume("key1")
        val2 = op.resume("key2")
        val3 = op.resume("nonexistent")

    assert val1 == "value1"
    assert val2 == 1234
    assert val3 is None


def test_workflow_cache_str_and_empty_behavior(tmp_path):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(str(tmp_path))
    assert cache.is_empty()
    s = str(cache)
    assert isinstance(s, str)
    assert s == ""

    # Add one step and check string output
    with cache(1, "step1") as op:
        op.store("foo", "bar")

    assert not cache.is_empty()
    s = str(cache)
    assert "[1] step1" in s


def test_workflow_cache_remove_and_current_step(tmp_path):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(str(tmp_path))
    with cache(1, "step1") as op:
        op.store("foo", "bar")
    with cache(2, "step2") as op:
        op.store("foo", "baz")

    assert cache.current_step() == 2
    cache.remove(2)
    assert cache.current_step() == 1
    cache.remove(1)
    assert cache.is_empty()


def test_workflow_cache_operator_context_manager_calls_store_cache_buffer(tmp_path):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(str(tmp_path))
    called = {}

    orig_store = cache._store_cache_buffer

    def fake_store():
        called["called"] = True
        orig_store()

    cache._store_cache_buffer = fake_store

    with cache(1, "step1") as op:
        op.store("foo", "bar")

    assert called.get("called") is True


def test_workflow_cache_operator_context_manager_does_not_store_on_exception(tmp_path):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(str(tmp_path))
    called = {}

    orig_store = cache._store_cache_buffer

    def fake_store():
        called["called"] = True
        orig_store()

    cache._store_cache_buffer = fake_store

    try:
        with cache(1, "step1") as op:
            op.store("foo", "bar")
            raise RuntimeError("fail")
    except RuntimeError:
        pass

    assert called.get("called") is None


def test_workflow_cache_operator_pickle_complex_object(tmp_path):
    from mle.utils.cache import WorkflowCache

    class DummyObj:
        def __init__(self, x):
            self.x = x

        def __eq__(self, other):
            return isinstance(other, DummyObj) and self.x == other.x

    cache = WorkflowCache(str(tmp_path))
    obj = DummyObj(42)

    with cache(1, "step1") as op:
        op.store("obj", obj)

    with cache(1, "step1") as op:
        loaded_obj = op.resume("obj")

    assert loaded_obj == obj


def test_workflow_cache_call_creates_steps(tmp_path):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(str(tmp_path))
    # Initially empty
    assert cache.is_empty()
    # Call with step 1 creates it
    with cache(1, "first") as op:
        op.store("k", "v")

    assert not cache.is_empty()
    assert 1 in cache.cache
    # Call with existing step returns same content dict
    with cache(1, "first") as op2:
        val = op2.resume("k")
    assert val == "v"


