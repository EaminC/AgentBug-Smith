[32mimport os
import builtins
import pytest
import tempfile
import shutil
import yaml
from unittest import mock

from mle.utils.cache import WorkflowCache, WorkflowCacheOperator
from mle.workflow import baseline as baseline_module


@pytest.fixture(autouse=True)
def patch_get_write_config():
    """
    Patch get_config and write_config to use an in-memory dict to simulate project.yml content.
    This prevents actual file IO and controls config content for tests.
    """
    config_data = {}

    def fake_get_config():
        # Return a copy to simulate reading fresh each time
        return dict(config_data) if config_data else {"cache": {}}

    def fake_write_config(value):
        config_data.clear()
        config_data.update(value)

    with mock.patch("mle.utils.system.get_config", side_effect=fake_get_config), \
         mock.patch("mle.utils.system.write_config", side_effect=fake_write_config):
        yield


def test_workflow_cache_operator_store_and_resume():
    cache = WorkflowCache("dummy_dir")
    with cache(1, "test") as op:
        op.store("key1", "value1")
        op.store("key2", 12345)

    with cache(1, "test") as op:
        val1 = op.resume("key1")
        val2 = op.resume("key2")
        val3 = op.resume("nonexistent")

    assert val1 == "value1"
    assert val2 == 12345
    assert val3 is None


def test_workflow_cache_str_and_empty_behavior():
    cache = WorkflowCache("dummy_dir")
    assert cache.is_empty() is True
    with cache(1, "step1"):
        pass
    assert cache.is_empty() is False
    s = str(cache)
    assert "[1] step1" in s


def test_workflow_cache_remove_and_current_step():
    cache = WorkflowCache("dummy_dir")
    with cache(1, "step1"):
        pass
    with cache(2, "step2"):
        pass
    assert cache.current_step() == 2
    cache.remove(1)
    assert 1 not in cache.cache
    assert cache.current_step() == 2
    cache.remove(2)
    assert cache.is_empty() is True


def test_workflow_cache_remove_nonexistent_key():
    cache = WorkflowCache("dummy_dir")
    # Removing a step that does not exist should not raise
    cache.remove(999)
    # Cache remains empty
    assert cache.is_empty()


def test_workflow_cache_operator_context_manager_calls_store_cache_buffer():
    cache = WorkflowCache("dummy_dir")
    with mock.patch.object(cache, "_store_cache_buffer") as mock_store:
        with cache(1, "step1") as op:
            op.store("key", "value")
        # _store_cache_buffer should be called on normal exit
        mock_store.assert_called_once()


def test_workflow_cache_operator_context_manager_does_not_store_on_exception():
    cache = WorkflowCache("dummy_dir")
    with mock.patch.object(cache, "_store_cache_buffer") as mock_store:
        try:
            with cache(1, "step1") as op:
                op.store("key", "value")
                raise RuntimeError("fail")
        except RuntimeError:
            pass
        # _store_cache_buffer should NOT be called on exception exit
        mock_store.assert_not_called()


