    # Should not call store_cache_buffer on exception
    assert called.get("called") is None


def test_baseline_resume_flow_and_caching(monkeypatch, patch_system_config):
    """
    Test baseline function resumes from cache and caches steps properly.
    This test mocks agents and user input to simulate a partial cached workflow.
    """

    # Setup a temporary directory to simulate project dir
    tmp_dir = tempfile.mkdtemp()
    try:
