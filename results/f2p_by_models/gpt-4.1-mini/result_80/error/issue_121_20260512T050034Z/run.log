            "name": "plan agent generates the coding plan",
            "time": "2024-01-01 00:00:03",
            "content": {"coding_plan": {"tasks": ["task1", "task2"]}},
        },
        5: {
            "step": 5,
            "name": "code agent codes the tasks and debug with the debug agent",
            "time": "2024-01-01 00:00:04",
            "content": {},
        },
    }

