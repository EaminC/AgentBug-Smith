def test_workflow_cache_operator_store_and_resume(tmp_path):
    """
    Test WorkflowCacheOperator store and resume methods with various data types.
    """

    config_data = {}

    def fake_get_config():
        # Return a dict with 'cache' key to simulate existing cache buffer
        return config_data if config_data else {"cache": {}}

    def fake_write_config(value):
        config_data.clear()
        config_data.update(value)

    with mock.patch("mle.utils.system.get_config", side_effect=fake_get_config), \
         mock.patch("mle.utils.system.write_config", side_effect=fake_write_config):

        cache = WorkflowCache(str(tmp_path))
        # Use step 1 and name "test"
        with cache(step=1, name="test") as operator:
            # Store some data
            operator.store("key1", {"a": 1, "b": 2})
            operator.store("key2", [1, 2, 3])
            operator.store("key3", "string value")

            # Resume and check
            assert operator.resume("key1") == {"a": 1, "b": 2}
            assert operator.resume("key2") == [1, 2, 3]
            assert operator.resume("key3") == "string value"
            # Resume non-existing key returns None
            assert operator.resume("non_exist") is None


def test_workflow_cache_str_and_empty_behavior(tmp_path):
    """
    Test the string representation and is_empty behavior of WorkflowCache.
    """

    config_data = {}

    def fake_get_config():
        return config_data if config_data else {"cache": {}}

    def fake_write_config(value):
        config_data.clear()
        config_data.update(value)

    with mock.patch("mle.utils.system.get_config", side_effect=fake_get_config), \
         mock.patch("mle.utils.system.write_config", side_effect=fake_write_config):

        cache = WorkflowCache(str(tmp_path))
        # Initially empty
        assert cache.is_empty()

        # Add some steps
        with cache(step=1, name="step1") as op1:
            op1.store("data", 123)
        with cache(step=2, name="step2") as op2:
            op2.store("data", 456)

        # Now not empty
        assert not cache.is_empty()

        # String representation includes step names and times
        s = str(cache)
        assert "[1] step1" in s
        assert "[2] step2" in s


def test_workflow_cache_remove_and_current_step(tmp_path):
    """
    Test remove and current_step methods of WorkflowCache.
    """

    config_data = {}

    def fake_get_config():
        return config_data if config_data else {"cache": {}}

    def fake_write_config(value):
        config_data.clear()
        config_data.update(value)

    with mock.patch("mle.utils.system.get_config", side_effect=fake_get_config), \
         mock.patch("mle.utils.system.write_config", side_effect=fake_write_config):

        cache = WorkflowCache(str(tmp_path))

        with cache(step=1, name="step1") as op1:
            op1.store("data", "a")
        with cache(step=3, name="step3") as op3:
            op3.store("data", "b")
        with cache(step=2, name="step2") as op2:
            op2.store("data", "c")

        # current_step returns max key
        assert cache.current_step() == 3

        # Remove step 3
        cache.remove(3)
        assert 3 not in cache.cache
        assert cache.current_step() == 2

        # Remove step 1
        cache.remove(1)
        assert 1 not in cache.cache


