    mock_confirm,
    mock_print_in_box,
    mock_ask_text,
    tmp_path,
):
    """
    Test baseline workflow with caching enabled:
    - Run baseline once with mocked inputs to store cache.
    - Run baseline again to test resuming from cache.
    """

    # Setup mocks for model and agents
    mock_load_model.return_value = "dummy_model"

    # Setup in-memory config storage to simulate project.yml
    config_data = {}

    def fake_get_config():
        return config_data if config_data else {}

    def fake_write_config(value):
        config_data.clear()
        config_data.update(value)

    with mock.patch("mle.utils.system.get_config", side_effect=fake_get_config), \
         mock.patch("mle.utils.system.write_config", side_effect=fake_write_config):

        # First run inputs: no resume step, then dataset, requirement, etc.
        inputs_first_run = iter([
            "",  # no resume step (empty means continue)
            "dummy_dataset",
            "dummy_requirement",
            "dummy_advisor_report",
            "dummy_coding_plan",
            "dummy_code_report",
            True,  # confirm debug mode
        ])

        def ask_text_side_effect(prompt):
            return next(inputs_first_run)

        mock_ask_text.side_effect = ask_text_side_effect

        mock_advise_agent_interact.return_value = "dummy_advisor_report"
        mock_plan_agent_interact.return_value = {"tasks": ["task1"]}
        mock_code_agent_interact.return_value = {"debug": "True"}
