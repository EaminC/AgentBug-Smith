# Dummy class for pickle testing must be at module level
class DummyObj:
    def __init__(self, x):
        self.x = x

    def __eq__(self, other):
        return isinstance(other, DummyObj) and self.x == other.x


def test_workflow_cache_load_cache_buffer_none(monkeypatch):
    # Simulate get_config returning None, which should be handled gracefully
    monkeypatch.setattr("mle.utils.system.get_config", lambda: None)
    monkeypatch.setattr("mle.utils.system.write_config", lambda v: None)
    # WorkflowCache should handle None and create empty cache dict
    cache = WorkflowCache("dummy_dir")
    assert isinstance(cache.cache, dict)
    assert cache.cache == {}


def test_workflow_cache_str_and_empty_behavior(monkeypatch):
    monkeypatch.setattr("mle.utils.system.get_config", lambda: {"cache": {}})
    monkeypatch.setattr("mle.utils.system.write_config", lambda v: None)
    cache = WorkflowCache("dummy_dir")
    assert cache.is_empty()
    # Add a step manually
    cache.cache[1] = {"step": 1, "name": "step1", "time": "time", "content": {}}
    assert not cache.is_empty()
    s = str(cache)
    assert "[1] step1" in s


def test_workflow_cache_remove_and_current_step(monkeypatch):
    monkeypatch.setattr(
        "mle.utils.system.get_config",
        lambda: {
            "cache": {
                1: {"step": 1, "name": "n", "time": "t", "content": {}},
                2: {"step": 2, "name": "n2", "time": "t2", "content": {}},
            }
        },
    )
    monkeypatch.setattr("mle.utils.system.write_config", lambda v: None)
    cache = WorkflowCache("dummy_dir")
    assert cache.current_step() == 2
    cache.remove(2)
    assert 2 not in cache.cache
    # Removing non-existing step does not raise
    cache.remove(99)


def test_workflow_cache_operator_context_manager_calls_store_cache_buffer(monkeypatch):
    called = {}

    def fake_store_cache_buffer():
        called["called"] = True

    monkeypatch.setattr("mle.utils.system.get_config", lambda: {"cache": {}})
    monkeypatch.setattr("mle.utils.system.write_config", lambda v: fake_store_cache_buffer())
    cache = WorkflowCache("dummy_dir")
    with WorkflowCacheOperator(cache, {}) as op:
        op.store("k", "v")
    assert called.get("called") is True


def test_workflow_cache_operator_context_manager_does_not_store_on_exception(monkeypatch):
    called = {}

    def fake_store_cache_buffer():
        called["called"] = True

    monkeypatch.setattr("mle.utils.system.get_config", lambda: {"cache": {}})
    monkeypatch.setattr("mle.utils.system.write_config", lambda v: fake_store_cache_buffer())
    cache = WorkflowCache("dummy_dir")
    with pytest.raises(ValueError):
        with WorkflowCacheOperator(cache, {}) as op:
            op.store("k", "v")
            raise ValueError("fail")
    # Should not call store_cache_buffer on exception
    assert "called" not in called


def test_workflow_cache_operator_pickle_complex_object(monkeypatch):
    monkeypatch.setattr("mle.utils.system.get_config", lambda: {"cache": {}})
    monkeypatch.setattr("mle.utils.system.write_config", lambda v: None)
    cache = WorkflowCache("dummy_dir")
    op = WorkflowCacheOperator(cache, {})
    obj = DummyObj(42)
    op.store("objkey", obj)
    resumed = op.resume("objkey")
    assert resumed == obj
    # resume non-existing key returns None
    assert op.resume("nonexistent") is None


def test_baseline_resume_flow_and_caching(monkeypatch):
    # We will mock inputs and agents to simulate baseline flow and test caching resume logic
    from mle.workflow import baseline
    import mle.utils.system

    # Setup a fake cache with some cached steps
    fake_cache_data = {
        "cache": {
            1: {
                "step": 1,
                "name": "ask for the data information",
                "time": "time1",
                "content": {"dataset": pickle.dumps("cached_dataset", fix_imports=False)},
            },
            2: {
                "step": 2,
                "name": "ask for the user requirement",
                "time": "time2",
                "content": {"ml_requirement": pickle.dumps("cached_requirement", fix_imports=False)},
            },
            3: {
                "step": 3,
                "name": "advisor agent gives suggestions in a report",
                "time": "time3",
                "content": {"advisor_report": pickle.dumps("cached_report", fix_imports=False)},
            },
            4: {
                "step": 4,
                "name": "plan agent generates the coding plan",
                "time": "time4",
                "content": {
                    "coding_plan": pickle.dumps(
                        {"tasks": ["task1", "task2"]}, fix_imports=False
                    )
                },
            },
        }
    }

    # Patch get_config to return our fake cache data
    monkeypatch.setattr(mle.utils.system, "get_config", lambda: fake_cache_data)
    # Patch write_config to do nothing
    monkeypatch.setattr(mle.utils.system, "write_config", lambda v: None)

    # Patch ask_text to simulate user input for resume step and no new input needed
    inputs = iter(["", "", ""])  # empty input means continue workflow or no new input
    monkeypatch.setattr("mle.utils.ask_text", lambda prompt: next(inputs, ""))

    # Patch questionary.confirm to always return False (no debug)
    monkeypatch.setattr("questionary.confirm", lambda *args, **kwargs: mock.Mock(ask=lambda: False)())

    # Patch agents to simulate interact and analyze methods
    class DummyAgent:
        def __init__(self, *args, **kwargs):
            pass

        def interact(self, prompt):
            return "dummy_interact_response"

        def analyze(self, code_report):
            return {"status": "success"}

    monkeypatch.setattr("mle.agents.AdviseAgent", DummyAgent)
    monkeypatch.setattr("mle.agents.PlanAgent", DummyAgent)
    monkeypatch.setattr("mle.agents.CodeAgent", DummyAgent)
    monkeypatch.setattr("mle.agents.DebugAgent", DummyAgent)

    # Patch CodeAgent.read_requirement to no-op
    monkeypatch.setattr("mle.agents.CodeAgent.read_requirement", lambda self, req: None)

    # Patch CodeAgent.interact to return a dict with debug false
    monkeypatch.setattr("mle.agents.CodeAgent.interact", lambda self, task: {"debug": "False"})

    # Patch CodeAgent.debug to return a dummy dict
    monkeypatch.setattr("mle.agents.CodeAgent.debug", lambda self, task, debug_report: {"debug": "False"})

    # Patch print_in_box to no-op
    monkeypatch.setattr("mle.utils.print_in_box", lambda *args, **kwargs: None)

    # Patch load_model to dummy object
    monkeypatch.setattr("mle.model.load_model", lambda work_dir, model=None: object())

    # Run baseline, it should use cache and not ask for new inputs
    # We expect no exceptions and flow to complete
    baseline.baseline("dummy_work_dir", model="dummy_model")


