def test_workflow_cache_resume_and_store(tmp_path):
    """
    Test that WorkflowCache can store and resume cached content properly.
    This indirectly tests the baseline workflow's ability to resume previous steps.
    """
    # Setup in-memory config storage to simulate project.yml
    config_data = {}

    def fake_get_config():
        # Return empty dict if config_data is empty to avoid NoneType errors
        return config_data if config_data else {}

    def fake_write_config(value):
        config_data.clear()
        config_data.update(value)

    with mock.patch("mle.utils.system.get_config", side_effect=fake_get_config), \
         mock.patch("mle.utils.system.write_config", side_effect=fake_write_config):

        cache = WorkflowCache(str(tmp_path))

        # Initially cache should be empty
        assert cache.is_empty()

        # Store some data in step 1
        with cache(step=1, name="step1") as op:
            op.store("key1", {"a": 123})

        # After storing, cache should not be empty
        assert not cache.is_empty()

        # Resume the stored data
        with cache(step=1, name="step1") as op:
            resumed = op.resume("key1")
            assert resumed == {"a": 123}

        # Remove step 1 and check cache is empty again
        cache.remove(1)
        assert cache.is_empty()


