        mock_code_agent_interact.reset_mock()
        mock_debug_agent_analyze.reset_mock()
        mock_code_agent_debug.reset_mock()

        # Run baseline second time to test resume
        baseline_module.baseline(str(tmp_project_dir))

        # AdviseAgent.interact and PlanAgent.interact should NOT be called because resumed
        mock_advise_agent_interact.assert_not_called()
        mock_plan_agent_interact.assert_not_called()

        # CodeAgent.interact should be called for tasks
        mock_code_agent_interact.assert_called()

        # DebugAgent.analyze should be called if debug mode
        mock_debug_agent_analyze.assert_called()

        # CodeAgent.debug should be called at least once
        mock_code_agent_debug.assert_called()


