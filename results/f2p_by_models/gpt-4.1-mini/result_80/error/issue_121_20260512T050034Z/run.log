def test_workflow_cache_load_cache_buffer_none(monkeypatch):
    # Simulate get_config returning None
    monkeypatch.setattr(mle.utils.system, "get_config", lambda: None)
    monkeypatch.setattr(mle.utils.system, "write_config", lambda v: None)

    # WorkflowCache should handle None gracefully and create empty cache dict
    cache = WorkflowCache("dummy_dir")
    assert isinstance(cache.cache, dict)
    assert cache.cache == {}


def test_workflow_cache_str_and_empty_behavior(monkeypatch):
    monkeypatch.setattr(mle.utils.system, "get_config", lambda: {"cache": {}})
    monkeypatch.setattr(mle.utils.system, "write_config", lambda v: None)

    cache = WorkflowCache("dummy_dir")
    assert cache.is_empty() is True
    # Add a step manually
    cache.cache[1] = {"step": 1, "name": "step1", "time": "time1", "content": {}}
    assert cache.is_empty() is False
    s = str(cache)
    assert "[1] step1 (time1)" in s


def test_workflow_cache_remove_and_current_step(monkeypatch):
    monkeypatch.setattr(mle.utils.system, "get_config", lambda: {"cache": {1: {"step": 1, "name": "step1", "time": "time1", "content": {}}}})
    monkeypatch.setattr(mle.utils.system, "write_config", lambda v: None)

    cache = WorkflowCache("dummy_dir")
    assert cache.current_step() == 1
    cache.remove(1)
    assert 1 not in cache.cache


def test_workflow_cache_operator_context_manager_calls_store_cache_buffer(monkeypatch):
    monkeypatch.setattr(mle.utils.system, "get_config", lambda: {"cache": {}})
    called = {}

    def fake_write_config(value):
        called["called"] = True

    monkeypatch.setattr(mle.utils.system, "write_config", fake_write_config)

    cache = WorkflowCache("dummy_dir")
    with WorkflowCacheOperator(cache, {}) as op:
        op.store("key", "value")
    assert called.get("called") is True


def test_workflow_cache_operator_context_manager_does_not_store_on_exception(monkeypatch):
    monkeypatch.setattr(mle.utils.system, "get_config", lambda: {"cache": {}})
    called = {}

    def fake_write_config(value):
        called["called"] = True

    monkeypatch.setattr(mle.utils.system, "write_config", fake_write_config)

    cache = WorkflowCache("dummy_dir")
    with pytest.raises(RuntimeError):
        with WorkflowCacheOperator(cache, {}) as op:
            op.store("key", "value")
            raise RuntimeError("fail")
    assert called.get("called") is None


def test_workflow_cache_operator_pickle_complex_object(monkeypatch):
    monkeypatch.setattr(mle.utils.system, "get_config", lambda: {"cache": {}})
    monkeypatch.setattr(mle.utils.system, "write_config", lambda v: None)

    cache = WorkflowCache("dummy_dir")
    with WorkflowCacheOperator(cache, {}) as op:
        complex_obj = {"a": [1, 2, 3], "b": {"nested": "value"}}
        op.store("complex", complex_obj)
        resumed = op.resume("complex")
        assert resumed == complex_obj


def test_workflow_cache_call_creates_steps(monkeypatch):
    monkeypatch.setattr(mle.utils.system, "get_config", lambda: {"cache": {}})
    monkeypatch.setattr(mle.utils.system, "write_config", lambda v: None)

    cache = WorkflowCache("dummy_dir")
    # Call with step not in cache should create it
    op = cache(1, "step1")
    assert isinstance(op, WorkflowCacheOperator)
    assert 1 in cache.cache
    assert cache.cache[1]["name"] == "step1"

    # Call with existing step should reuse it
    op2 = cache(1, "step1")
    assert op2.cache_content is op.cache[1]["content"]


def test_workflow_cache_operator_store_and_resume(monkeypatch):
    monkeypatch.setattr(mle.utils.system, "get_config", lambda: {"cache": {}})
    monkeypatch.setattr(mle.utils.system, "write_config", lambda v: None)

    cache = WorkflowCache("dummy_dir")
    op = cache(1, "step1")
    op.store("foo", "bar")
    resumed = op.resume("foo")
    assert resumed == "bar"
    # Resume non-existing key returns None
    assert op.resume("nonexistent") is None


