def test_workflow_cache_operator_pickle_complex_object(patch_get_write_config):
    from mle.utils.cache import WorkflowCache

    class ComplexObj:
        def __init__(self, x):
            self.x = x

        def __eq__(self, other):
            return isinstance(other, ComplexObj) and self.x == other.x

    cache = WorkflowCache("dummy_dir")
    obj = ComplexObj(123)
    with cache(1, "step1") as op:
        op.store("obj", obj)
    with cache(1, "step1") as op:
        loaded = op.resume("obj")
    assert loaded == obj


def test_workflow_cache_call_creates_steps(patch_get_write_config):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache("dummy_dir")
    # Initially empty
    assert cache.is_empty()
    with cache(1, "step1") as op:
        op.store("k", "v")
    assert not cache.is_empty()
    # Calling again with same step returns same content dict
    with cache(1, "step1") as op2:
        val = op2.resume("k")
    assert val == "v"
    # Calling with new step creates new entry
    with cache(2, "step2") as op3:
        op3.store("k2", "v2")
    assert cache.current_step() == 2


