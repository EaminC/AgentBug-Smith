def test_baseline_resume_flow_and_caching(tmp_path, monkeypatch):
    # This test exercises the baseline function with caching and resume logic
    # We patch all agents and questionary to avoid real interaction

    baseline_module, WorkflowCache = import_baseline_and_cache()
    if WorkflowCache is None:
        pytest.skip("WorkflowCache not available in buggy codebase")

    # Patch WorkflowCache to use real but isolated cache with tmp_path
    monkeypatch.setattr(baseline_module, "WorkflowCache", lambda _: WorkflowCache(str(tmp_path)))

    # Patch questionary.ask to simulate user input for resume step and debug confirm
    import questionary

    def fake_ask_text(prompt):
        # For resume step prompt, return "2" to simulate resume at step 2
        if "Pick a step for resume" in prompt:
            return "2"
        # For dataset and requirement prompts, return None to simulate no input
        return None

    monkeypatch.setattr(baseline_module, "ask_text", fake_ask_text)

    # Patch questionary.confirm to always return True for debug mode
    monkeypatch.setattr(questionary, "confirm", lambda *a, **kw: types.SimpleNamespace(ask=lambda: True)())

    # Patch agents to dummy classes that record calls and return canned responses
    class DummyAdviseAgent:
        def __init__(self, model, console):
            pass
        def interact(self, prompt):
            return "advisor_report"

    class DummyPlanAgent:
        def __init__(self, model, console):
            pass
        def interact(self, prompt):
            return {"tasks": ["task1", "task2"]}

    class DummyCodeAgent:
        def __init__(self, model, work_dir, console):
            self.calls = []
        def read_requirement(self, report):
            pass
        def interact(self, task):
            self.calls.append(task)
            if task == "task1":
                return {"debug": "True"}
            else:
                return {"debug": "False"}
        def debug(self, task, debug_report):
            return {"debug": "False"}

    class DummyDebugAgent:
        def __init__(self, model, console):
            pass
        def analyze(self, code_report):
            return {"status": "success"}

    monkeypatch.setattr("mle.agents.AdviseAgent", DummyAdviseAgent)
    monkeypatch.setattr("mle.agents.PlanAgent", DummyPlanAgent)
    monkeypatch.setattr("mle.agents.CodeAgent", DummyCodeAgent)
    monkeypatch.setattr("mle.agents.DebugAgent", DummyDebugAgent)

    # Patch load_model to dummy
    monkeypatch.setattr("mle.model.load_model", lambda work_dir, model: object())

    # Patch print_in_box to no-op
    monkeypatch.setattr(baseline_module, "print_in_box", lambda *a, **kw: None)

    # Run baseline function, should resume from step 2 and proceed without asking for dataset or requirement
    baseline_module.baseline(str(tmp_path))  # should not raise

