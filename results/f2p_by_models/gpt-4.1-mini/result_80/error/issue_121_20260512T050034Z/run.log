def test_workflow_cache_operator_store_and_resume(monkeypatch, tmp_path):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(str(tmp_path))
    with cache(1, "test1") as op:
        op.store("key1", "value1")
        val = op.resume("key1")
        assert val == "value1"

    # Resume should return None for unknown key
    with cache(1, "test1") as op:
        assert op.resume("unknown_key") is None


def test_workflow_cache_str_and_empty_behavior(monkeypatch, tmp_path):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(str(tmp_path))
    assert cache.is_empty()

    # Add a step
    with cache(1, "step1") as op:
        op.store("a", 123)

    assert not cache.is_empty()
    s = str(cache)
    assert "[1]" in s and "step1" in s


def test_workflow_cache_remove_and_current_step(monkeypatch, tmp_path):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(str(tmp_path))
    with cache(1, "step1") as op:
        op.store("a", 123)
    with cache(2, "step2") as op:
        op.store("b", 456)

    assert cache.current_step() == 2

    cache.remove(2)
    assert cache.current_step() == 1

    # Removing non-existent step does not raise
    cache.remove(999)


