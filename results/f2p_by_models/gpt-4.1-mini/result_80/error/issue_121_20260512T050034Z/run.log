def test_workflow_cache_operator_store_and_resume(monkeypatch, patch_cache_module, patch_get_write_config):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache("dummy_dir")

    with cache(step=1, name="step1") as op:
        op.store("key1", {"a": 123})
    with cache(step=1, name="step1") as op:
        val = op.resume("key1")
    assert val == {"a": 123}

    # Resume non-existing key returns None
    with cache(step=1, name="step1") as op:
        val2 = op.resume("nonexistent")
    assert val2 is None


def test_workflow_cache_str_and_empty_behavior(patch_cache_module, patch_get_write_config):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache("dummy_dir")
    assert cache.is_empty()

    # Add a step
    with cache(step=5, name="test step") as op:
        op.store("foo", "bar")

    assert not cache.is_empty()
    s = str(cache)
    assert "[5]" in s and "test step" in s


def test_workflow_cache_remove_and_current_step(patch_cache_module, patch_get_write_config):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache("dummy_dir")

    with cache(step=1, name="step1") as op:
        op.store("k", 1)
    with cache(step=2, name="step2") as op:
        op.store("k", 2)

    assert cache.current_step() == 2

    cache.remove(2)
    assert 2 not in cache.cache
    assert cache.current_step() == 1

    # Removing a non-existing step does not raise
    cache.remove(999)


def test_workflow_cache_operator_context_manager_calls_store_cache_buffer(monkeypatch, patch_cache_module, patch_get_write_config):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache("dummy_dir")
    called = {"stored": False}

    def fake_store_cache_buffer():
        called["stored"] = True

    cache._store_cache_buffer = fake_store_cache_buffer

    with cache(step=1, name="step1") as op:
        op.store("k", 123)

    assert called["stored"]


def test_workflow_cache_operator_context_manager_does_not_store_on_exception(monkeypatch, patch_cache_module, patch_get_write_config):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache("dummy_dir")
    called = {"stored": False}

    def fake_store_cache_buffer():
        called["stored"] = True

    cache._store_cache_buffer = fake_store_cache_buffer

    with pytest.raises(ValueError):
        with cache(step=1, name="step1") as op:
            op.store("k", 123)
            raise ValueError("fail")

    assert not called["stored"]


def test_workflow_cache_operator_pickle_complex_object(patch_cache_module, patch_get_write_config):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache("dummy_dir")

    complex_obj = {"list": [1, 2, 3], "dict": {"a": 1}}

    with cache(step=1, name="step1") as op:
        op.store("complex", complex_obj)

    with cache(step=1, name="step1") as op:
        loaded = op.resume("complex")

    assert loaded == complex_obj


def test_workflow_cache_call_creates_steps(patch_cache_module, patch_get_write_config):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache("dummy_dir")

    # Call with new step creates it
    op1 = cache(1, "step1")
    assert 1 in cache.cache
    op2 = cache(2, "step2")
    assert 2 in cache.cache
    # Calling again returns same content dict
    op1b = cache(1, "step1")
    assert op1.cache_content is op1b.cache_content


