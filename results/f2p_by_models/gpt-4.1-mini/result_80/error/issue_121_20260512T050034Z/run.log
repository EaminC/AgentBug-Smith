            "2",  # resume from step 2
            "",   # confirm continue workflow (empty input)
            "user requirement input",  # for step 2 if needed (should not be asked)
            "y"   # confirm debug mode
        ])

        def fake_ask_text(prompt):
            return next(inputs)

        monkeypatch.setattr("mle.utils.ask_text", fake_ask_text)

