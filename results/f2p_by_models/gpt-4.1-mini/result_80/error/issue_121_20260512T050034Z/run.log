            def __init__(self, model, console):
                pass

            def interact(self, prompt):
                return "advisor report dummy"

        class DummyPlanAgent:
            def __init__(self, model, console):
                pass

            def interact(self, report):
                return {"tasks": ["task1", "task2"]}

        class DummyCodeAgent:
            def __init__(self, model, work_dir, console):
                self.model = model
                self.work_dir = work_dir
                self.console = console
                self.requirement = None

            def read_requirement(self, text):
                self.requirement = text

            def interact(self, task):
                # Return a dict with debug True for first task, False for second
                if task == "task1":
                    return {"debug": "True"}
                else:
                    return {"debug": "False"}

            def debug(self, task, debug_report):
                # Return a dict with debug False to break loop
                return {"debug": "False"}

        class DummyDebugAgent:
            def __init__(self, model, console):
                pass

            def analyze(self, code_report):
                # Return success status to break debug loop
                return {"status": "success"}

        monkeypatch.setattr("mle.agents.AdviseAgent", DummyAdviseAgent)
        monkeypatch.setattr("mle.agents.PlanAgent", DummyPlanAgent)
        monkeypatch.setattr("mle.agents.CodeAgent", DummyCodeAgent)
        monkeypatch.setattr("mle.agents.DebugAgent", DummyDebugAgent)

