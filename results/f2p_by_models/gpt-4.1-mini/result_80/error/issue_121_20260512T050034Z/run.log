        called["called"] = True

    monkeypatch.setattr(WorkflowCache, "_store_cache_buffer", fake_store_cache_buffer)

    cache = WorkflowCache("dummy_dir")
    with pytest.raises(RuntimeError):
        with cache(1, "step1") as op:
            op.store("key", "val")
            raise RuntimeError("fail")

    assert called.get("called") is None


def test_workflow_cache_operator_pickle_complex_object(monkeypatch, tmp_path):
    from mle.utils.cache import WorkflowCache

    class ComplexObj:
        def __init__(self, x):
            self.x = x

        def __eq__(self, other):
            return isinstance(other, ComplexObj) and self.x == other.x

    cache = WorkflowCache(str(tmp_path))
    obj = ComplexObj(42)
    with cache(1, "step1") as op:
        op.store("obj", obj)

    with cache(1, "step1") as op:
        loaded = op.resume("obj")
        assert loaded == obj


