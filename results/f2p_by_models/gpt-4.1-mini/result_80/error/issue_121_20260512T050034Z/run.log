def test_workflow_cache_str_and_empty_behavior(tmp_path):
    """
    Test the string representation and is_empty behavior of WorkflowCache.
    """
    config_data = {}

    def fake_get_config():
        return config_data if config_data else {}

    def fake_write_config(value):
        config_data.clear()
        config_data.update(value)

    with mock.patch("mle.utils.system.get_config", side_effect=fake_get_config), \
         mock.patch("mle.utils.system.write_config", side_effect=fake_write_config):

        cache = WorkflowCache(str(tmp_path))

        # Initially empty
        assert cache.is_empty()
        assert str(cache) == ""

        # Add some steps
        with cache(step=1, name="step_one") as ca:
            ca.store("foo", "bar")
        with cache(step=2, name="step_two") as ca:
            ca.store("baz", 123)

        # Now not empty
        assert not cache.is_empty()

        # String representation should contain step info
        s = str(cache)
        assert "[1] step_one" in s
        assert "[2] step_two" in s

        # current_step returns max step
        assert cache.current_step() == 2

        # Remove step 1
        cache.remove(1)
        assert 1 not in cache.cache
        # current_step should still be 2
        assert cache.current_step() == 2

        # Remove step 2
        cache.remove(2)
        assert cache.is_empty()


