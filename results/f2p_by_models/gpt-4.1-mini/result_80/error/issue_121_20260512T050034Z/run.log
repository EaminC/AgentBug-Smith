# We will import the baseline function and WorkflowCache if possible.
# The buggy codebase does not have WorkflowCache, so we expect ImportError.
# After patch, WorkflowCache is present and baseline imports it.
# We test WorkflowCache behavior and baseline resume flow.

# Helper to safely import baseline module and WorkflowCache
def import_baseline_and_cache():
    import importlib
    baseline_module = importlib.import_module("mle.workflow.baseline")
    try:
        from mle.utils.cache import WorkflowCache
    except ImportError:
        WorkflowCache = None
    return baseline_module, WorkflowCache

@pytest.fixture
def tmp_project_dir(tmp_path):
    # Create a dummy project.yml config file for cache to read/write
    config_path = tmp_path / "project.yml"
    config_path.write_text("cache: {}\n")
    return str(tmp_path)

def test_workflow_cache_operator_store_and_resume(tmp_project_dir):
    # Test that WorkflowCacheOperator stores and resumes pickled values correctly
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)
    step = 1
    name = "test_step"

    with cache(step, name) as op:
        op.store("key1", {"a": 1, "b": 2})

    with cache(step, name) as op:
        val = op.resume("key1")
        assert val == {"a": 1, "b": 2}

def test_workflow_cache_str_and_empty_behavior(tmp_project_dir):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)
    assert cache.is_empty() is True
    s = str(cache)
    assert isinstance(s, str)
    # Add a step
    with cache(1, "step1"):
        pass
    assert cache.is_empty() is False
    s2 = str(cache)
    assert "[1]" in s2

def test_workflow_cache_remove_and_current_step(tmp_project_dir):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)
    with cache(1, "step1"):
        pass
    with cache(2, "step2"):
        pass
    assert cache.current_step() == 2
    cache.remove(2)
    assert 2 not in cache.cache
    assert cache.current_step() == 1
    cache.remove(1)
    assert cache.is_empty() is True

def test_workflow_cache_operator_context_manager_calls_store_cache_buffer(tmp_project_dir):
    from mle.utils.cache import WorkflowCache, WorkflowCacheOperator

    cache = WorkflowCache(tmp_project_dir)
    called = {}

    orig_store_cache_buffer = cache._store_cache_buffer
    def fake_store_cache_buffer():
        called["called"] = True
        orig_store_cache_buffer()
    cache._store_cache_buffer = fake_store_cache_buffer

    with cache(1, "step1") as op:
        op.store("k", "v")
    assert called.get("called") is True

def test_workflow_cache_operator_context_manager_does_not_store_on_exception(tmp_project_dir):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)
    called = {}

    orig_store_cache_buffer = cache._store_cache_buffer
    def fake_store_cache_buffer():
        called["called"] = True
        orig_store_cache_buffer()
    cache._store_cache_buffer = fake_store_cache_buffer

    with pytest.raises(ValueError):
        with cache(1, "step1") as op:
            op.store("k", "v")
            raise ValueError("fail")

    assert called.get("called") is None

def test_workflow_cache_operator_pickle_complex_object(tmp_project_dir):
    from mle.utils.cache import WorkflowCache

    class DummyObj:
        def __init__(self, x):
            self.x = x
        def __eq__(self, other):
            return isinstance(other, DummyObj) and self.x == other.x

    cache = WorkflowCache(tmp_project_dir)
    with cache(1, "step1") as op:
        obj = DummyObj(123)
        op.store("obj", obj)

    with cache(1, "step1") as op:
        loaded = op.resume("obj")
        assert loaded == DummyObj(123)

@pytest.mark.parametrize("step,name", [(1, "test1"), (2, "test2")])
def test_workflow_cache_call_creates_steps(tmp_project_dir, step, name):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)
    with cache(step, name) as op:
        op.store("foo", "bar")

    assert step in cache.cache
    assert cache.cache[step]["name"] == name
    assert "content" in cache.cache[step]

def test_workflow_cache_load_cache_buffer_none(tmp_path, monkeypatch):
    # Simulate get_config returning None
    import mle.utils.cache as cache_mod

    def fake_get_config():
        return None

    monkeypatch.setattr(cache_mod, "get_config", fake_get_config)
    monkeypatch.setattr(cache_mod, "write_config", lambda x: None)

    # Construct WorkflowCache should handle None gracefully
    cache = cache_mod.WorkflowCache(str(tmp_path))
    # It should create empty cache dict
    assert isinstance(cache.cache, dict)

