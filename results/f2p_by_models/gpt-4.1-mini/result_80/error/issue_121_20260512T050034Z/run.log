def test_baseline_resume_flow_and_caching(tmp_project_dir):
    """
    This test verifies the baseline workflow caching and resuming behavior.

    It simulates a user running the baseline workflow, providing inputs,
    then simulates a restart where the cache is used to resume from a previous step.

    The test mocks user inputs and model/agent interactions to control flow.
    """

    # Import WorkflowCache here to ensure patch applied before import if needed
    from mle.utils.cache import WorkflowCache

    # Patch WorkflowCache to use tmp_project_dir for storage
    cache = WorkflowCache(tmp_project_dir)

    # We will mock the ask_text function to simulate user inputs
    # and also mock the agents to avoid real model calls

    # Patch ask_text to simulate user inputs for dataset and requirement
    # For the first run, user inputs dataset and requirement
    # For the second run (resume), user inputs step to resume and no new inputs

    # Patch questionary.confirm to always return False (no debugging)
    # Patch model loading to dummy object

    # Patch agents' interact methods to return fixed strings

    # Setup mocks
    import mle.utils
    import mle.agents
    import mle.model
    import questionary

    # Save original functions to restore later
    orig_ask_text = mle.utils.ask_text
    orig_load_model = mle.model.load_model
    orig_confirm = questionary.confirm
    orig_advise_interact = mle.agents.AdviseAgent.interact
    orig_plan_interact = mle.agents.PlanAgent.interact
    orig_code_interact = mle.agents.CodeAgent.interact
    orig_debugger_analyze = mle.agents.DebugAgent.analyze

    # Storage for interact call counts
    interact_calls = {"advise": 0, "plan": 0, "code": 0, "debug": 0}

    def mock_ask_text_first(prompt):
        if "dataset" in prompt.lower():
            return "mock_dataset"
        if "requirement" in prompt.lower():
            return "mock_requirement"
        # For resume step prompt, return empty (no resume)
        return ""

    def mock_ask_text_resume(prompt):
        # When resuming, ask_text returns step number to resume
        if "pick a step" in prompt.lower():
            return "1"
        # Should not be called for dataset or requirement if cache works
        return ""

    def mock_load_model(work_dir, model_name):
        return "mock_model"

    def mock_confirm(prompt):
        return False  # no debugging

    def mock_advise_interact(self, prompt):
        interact_calls["advise"] += 1
        return "advisor_report_mock"

    def mock_plan_interact(self, prompt):
        interact_calls["plan"] += 1
        return {"tasks": ["task1", "task2"]}

    def mock_code_interact(self, task):
        interact_calls["code"] += 1
        # Return dict with debug false string
        return {"debug": "False"}

    def mock_debug_analyze(self, code_report):
        interact_calls["debug"] += 1
        return {"status": "success"}

    # First run: no cache, user inputs dataset and requirement
    with mock.patch("mle.utils.ask_text", side_effect=mock_ask_text_first), \
         mock.patch("mle.model.load_model", side_effect=mock_load_model), \
         mock.patch("questionary.confirm", side_effect=mock_confirm), \
         mock.patch("mle.agents.AdviseAgent.interact", new=mock_advise_interact), \
         mock.patch("mle.agents.PlanAgent.interact", new=mock_plan_interact), \
         mock.patch("mle.agents.CodeAgent.interact", new=mock_code_interact), \
         mock.patch("mle.agents.DebugAgent.analyze", new=mock_debug_analyze):

        # Run baseline workflow first time
        baseline_module.baseline(tmp_project_dir)

    # After first run, cache should have entries for steps 1-5
    assert not cache.is_empty()
    assert cache.current_step() == 5
    # Check cache keys contain steps 1 to 5
    for step in range(1, 6):
        assert step in cache.cache

    # Reset interact_calls for second run
    for k in interact_calls:
        interact_calls[k] = 0

    # Second run: simulate user wants to resume from step 1
    # So ask_text returns "1" for resume prompt
    # Dataset and requirement inputs should NOT be requested again (cached)
    with mock.patch("mle.utils.ask_text", side_effect=mock_ask_text_resume), \
         mock.patch("mle.model.load_model", side_effect=mock_load_model), \
         mock.patch("questionary.confirm", side_effect=mock_confirm), \
         mock.patch("mle.agents.AdviseAgent.interact", new=mock_advise_interact), \
         mock.patch("mle.agents.PlanAgent.interact", new=mock_plan_interact), \
         mock.patch("mle.agents.CodeAgent.interact", new=mock_code_interact), \
         mock.patch("mle.agents.DebugAgent.analyze", new=mock_debug_analyze):

        baseline_module.baseline(tmp_project_dir)

    # After resume run, the interact methods should have been called again for steps after resume
    # Because cache removes stale steps after resume step, so steps 1 to current_step removed and rebuilt
    # So advise, plan, code interact should be called again
    assert interact_calls["advise"] > 0
    assert interact_calls["plan"] > 0
    assert interact_calls["code"] > 0

    # The cache should still contain steps 1 to 5 after second run
    assert not cache.is_empty()
    assert cache.current_step() == 5


def test_workflow_cache_operator_store_and_resume(tmp_project_dir):
    """
    Test that WorkflowCacheOperator can store and resume objects correctly.
    """
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)

    with cache(step=1, name="test1") as op:
        op.store("key1", {"a": 1, "b": 2})

    with cache(step=1, name="test1") as op:
        val = op.resume("key1")
        assert val == {"a": 1, "b": 2}


def test_workflow_cache_str_and_empty_behavior(tmp_project_dir):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)
    # Initially cache is empty
    assert cache.is_empty()
    # String representation should be empty string
    assert str(cache) == ""

    # Add a step
    with cache(step=1, name="test1") as op:
        op.store("foo", "bar")

    assert not cache.is_empty()
    s = str(cache)
    assert "[1]" in s
    assert "test1" in s


def test_workflow_cache_remove_and_current_step(tmp_project_dir):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)

    # Add multiple steps
    with cache(step=1, name="test1") as op:
        op.store("foo", "bar")
    with cache(step=2, name="test2") as op:
        op.store("baz", 123)

    assert cache.current_step() == 2

    # Remove step 2
    cache.remove(2)
    assert 2 not in cache.cache
    assert cache.current_step() == 1

    # Remove step 1
    cache.remove(1)
    assert cache.is_empty()


def test_workflow_cache_operator_context_manager_calls_store_cache_buffer(tmp_project_dir):
    from mle.utils.cache import WorkflowCache, WorkflowCacheOperator

    cache = WorkflowCache(tmp_project_dir)

    called = {"store_cache_buffer": False}

    def fake_store_cache_buffer():
        called["store_cache_buffer"] = True

    cache._store_cache_buffer = fake_store_cache_buffer

    with cache(step=1, name="test1") as op:
        op.store("k", "v")

    assert called["store_cache_buffer"]


def test_workflow_cache_operator_context_manager_does_not_store_on_exception(tmp_project_dir):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)

    called = {"store_cache_buffer": False}

    def fake_store_cache_buffer():
        called["store_cache_buffer"] = True

    cache._store_cache_buffer = fake_store_cache_buffer

    try:
        with cache(step=1, name="test1") as op:
            op.store("k", "v")
            raise RuntimeError("fail")
    except RuntimeError:
        pass

    assert not called["store_cache_buffer"]


def test_workflow_cache_operator_pickle_complex_object(tmp_project_dir):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)

    complex_obj = {"list": [1, 2, 3], "dict": {"a": 1}}

    with cache(step=1, name="test1") as op:
        op.store("complex", complex_obj)

    with cache(step=1, name="test1") as op:
        loaded = op.resume("complex")

    assert loaded == complex_obj


@pytest.mark.parametrize("step,name", [(1, "test1"), (2, "test2")])
def test_workflow_cache_call_creates_steps(tmp_project_dir, step, name):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)
    op = cache(step, name)
    assert step in cache.cache
    assert cache.cache[step]["name"] == name


def test_workflow_cache_load_cache_buffer_none(tmp_path, monkeypatch):
    import mle.utils.cache as cache_mod

    # Patch get_config to return None
    monkeypatch.setattr("mle.utils.system.get_config", lambda: None)
    monkeypatch.setattr("mle.utils.system.write_config", lambda x: None)

    # Should handle None gracefully and create empty cache dict
    cache = cache_mod.WorkflowCache(str(tmp_path))
    assert isinstance(cache.cache, dict)


def test_workflow_cache_remove_nonexistent_key(tmp_project_dir):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)
    # Remove nonexistent step should not error
    cache.remove(999)


@pytest.mark.parametrize("step,name", [(1, "test1"), (2, "test2")])
def test_workflow_cache_operator_store_overwrite(tmp_project_dir, step, name):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)

    with cache(step=step, name=name) as op:
        op.store("key", "value1")

    with cache(step=step, name=name) as op:
        op.store("key", "value2")

    with cache(step=step, name=name) as op:
        val = op.resume("key")

    assert val == "value2"


