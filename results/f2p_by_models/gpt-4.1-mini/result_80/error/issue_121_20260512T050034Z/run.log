def test_workflow_cache_resume_and_store(tmp_path):
    """
    Test that WorkflowCache can store and resume cached content properly.
    This indirectly tests the baseline workflow's ability to resume previous steps.
    """

    # Setup a WorkflowCache instance pointing to tmp_path (simulate project dir)
    cache = WorkflowCache(str(tmp_path))

    # Initially cache should be empty
    assert cache.is_empty()

    # Use the cache to store a value at step 1
    with cache(step=1, name="test step 1") as op:
        op.store("key1", "value1")

    # After storing, cache should not be empty
    assert not cache.is_empty()

    # The current_step should be 1
    assert cache.current_step() == 1

    # Resume the stored value
    with cache(step=1, name="test step 1") as op:
        val = op.resume("key1")
        assert val == "value1"

    # Store another value at step 2
    with cache(step=2, name="test step 2") as op:
        op.store("key2", {"a": 123})

    # current_step should be 2 now
    assert cache.current_step() == 2

    # Resume the stored dict
    with cache(step=2, name="test step 2") as op:
        val = op.resume("key2")
        assert val == {"a": 123}

    # Remove step 1 and check current_step updates
    cache.remove(1)
    assert cache.current_step() == 2
    # Removing step 2 too
    cache.remove(2)
    assert cache.is_empty()


