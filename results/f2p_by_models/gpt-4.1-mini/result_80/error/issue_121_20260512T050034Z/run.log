         mock.patch("mle.utils.system.write_config", side_effect=fake_write_config):

        # First run inputs: no resume step, then dataset, requirement, etc.
        inputs_first_run = iter([
            "",  # no resume step (empty means continue)
            "dummy_dataset",
            "dummy_requirement",
            "dummy_advisor_report",
            "dummy_coding_plan",
            "dummy_code_report",
            True,  # confirm debug mode
        ])

