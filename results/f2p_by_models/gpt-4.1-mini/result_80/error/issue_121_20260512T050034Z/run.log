[32mimport os
import builtins
import pytest
import tempfile
import shutil
from unittest import mock

import mle.workflow.baseline as baseline_module


def test_baseline_resume_flow_and_caching(monkeypatch, tmp_path):
    """
    This test verifies that the baseline workflow supports resuming from a previous session using the cache.

    It simulates user inputs and agent interactions to control the flow and verify that cached data is used
    on a resumed run.

    The test:
    - Runs the baseline workflow once with mocked inputs and agent interactions.
    - Simulates a restart by running the workflow again with the cache present.
    - Verifies that cached values are used and no new inputs are requested for cached steps.
    """

    # Prepare a temporary working directory to simulate project_dir
    work_dir = str(tmp_path)

    # Patch WorkflowCache to use a fresh cache per test run
    from mle.utils import WorkflowCache

    # Patch ask_text to simulate user input
    inputs = iter([
        "my_dataset.csv",  # dataset input for step 1
        "build a model",   # ml_requirement input for step 2
        "3",               # step to resume from (simulate user chooses step 3)
        # No input for step 1 and 2 on resume, should be from cache
    ])

    def fake_ask_text(prompt):
        try:
            return next(inputs)
        except StopIteration:
            return ""

    # Patch questionary.confirm to always return True (debug mode)
    monkeypatch.setattr("questionary.confirm", lambda *a, **kw: mock.Mock(ask=lambda: True)())

    # Patch ask_text in baseline module
    monkeypatch.setattr(baseline_module, "ask_text", fake_ask_text)

    # Patch print_in_box to no-op to avoid clutter
    monkeypatch.setattr(baseline_module, "print_in_box", lambda *a, **kw: None)

    # Patch model loading to a dummy model object
    class DummyModel:
        pass

    monkeypatch.setattr(baseline_module, "load_model", lambda work_dir, model: DummyModel())

    # Patch agents to dummy classes with controlled interact/analyze/debug methods
    class DummyAdviseAgent:
        def __init__(self, model, console):
            self.model = model
            self.console = console

        def interact(self, prompt):
            return "advisor_report_cached"

    class DummyPlanAgent:
        def __init__(self, model, console):
            self.model = model
            self.console = console

        def interact(self, prompt):
            return {"tasks": ["task1", "task2"]}

    class DummyCodeAgent:
        def __init__(self, model, work_dir, console):
            self.model = model
            self.work_dir = work_dir
            self.console = console
            self.requirement = None
            self.debug_calls = 0

        def read_requirement(self, requirement):
            self.requirement = requirement

        def interact(self, task):
            # Return a code report indicating debug needed on first task only
            if task == "task1":
                return {"debug": "True"}
            else:
                return {"debug": "False"}

        def debug(self, task, debug_report):
            self.debug_calls += 1
            # Return a code report indicating debug is done
            return {"debug": "False"}

    class DummyDebugAgent:
        def __init__(self, model, console):
            self.model = model
            self.console = console
            self.analyze_calls = 0

        def analyze(self, code_report):
            self.analyze_calls += 1
            # Return success status on first analyze call
            if self.analyze_calls == 1:
                return {"status": "success"}
            else:
                return {"status": "failure"}

    monkeypatch.setattr(baseline_module, "AdviseAgent", DummyAdviseAgent)
    monkeypatch.setattr(baseline_module, "PlanAgent", DummyPlanAgent)
    monkeypatch.setattr(baseline_module, "CodeAgent", DummyCodeAgent)
    monkeypatch.setattr(baseline_module, "DebugAgent", DummyDebugAgent)

    # Run baseline first time: should ask for dataset and requirement and run full flow
    baseline_module.baseline(work_dir)

    # Now run baseline second time: simulate user picks step 3 to resume from
    # This should reuse cached dataset and ml_requirement, and advisor_report from cache
    # We patch ask_text to return "3" for the resume step prompt and then empty for others
    inputs = iter([
        "3",  # resume from step 3
        "",   # no input for dataset or requirement (should be from cache)
        "",   # no input for requirement
    ])

    monkeypatch.setattr(baseline_module, "ask_text", fake_ask_text)

    baseline_module.baseline(work_dir)

    # Verify cache file exists and contains expected keys
    cache = WorkflowCache(work_dir)
    assert not cache.is_empty()
    # The cache should contain steps 1 through 5
    cached_steps = sorted(cache.cache.keys())
    assert cached_steps == [1, 2, 3, 4, 5]

    # Check that cached content for step 1 includes dataset
    with cache(1, "ask for the data information") as op:
        dataset_cached = op.resume("dataset")
        assert dataset_cached == "my_dataset.csv"

    # Check that cached content for step 2 includes ml_requirement
    with cache(2, "ask for the user requirement") as op:
        ml_req_cached = op.resume("ml_requirement")
        assert ml_req_cached == "build a model"

    # Check that cached content for step 3 includes advisor_report
    with cache(3, "advisor agent gives suggestions in a report") as op:
        advisor_report_cached = op.resume("advisor_report")
        assert advisor_report_cached == "advisor_report_cached"

    # Check that cached content for step 4 includes coding_plan with tasks
    with cache(4, "plan agent generates the coding plan") as op:
        coding_plan_cached = op.resume("coding_plan")
        assert coding_plan_cached is not None
        assert "tasks" in coding_plan_cached
        assert coding_plan_cached["tasks"] == ["task1", "task2"]


@pytest.fixture
def tmp_project_dir(tmp_path):
    # Provide a temporary directory for cache tests
    return str(tmp_path)


def test_workflow_cache_operator_store_and_resume(tmp_project_dir):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)
    with cache(1, "test_step") as op:
        op.store("key1", {"a": 123})
        op.store("key2", [1, 2, 3])

    with cache(1, "test_step") as op:
        val1 = op.resume("key1")
        val2 = op.resume("key2")
        val3 = op.resume("nonexistent")
    assert val1 == {"a": 123}
    assert val2 == [1, 2, 3]
    assert val3 is None


def test_workflow_cache_str_and_empty_behavior(tmp_project_dir):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)
    # Initially empty
    assert cache.is_empty()
    # Add a step
    with cache(1, "step1") as op:
        op.store("foo", "bar")
    assert not cache.is_empty()
    s = str(cache)
    assert "[1] step1" in s


def test_workflow_cache_remove_and_current_step(tmp_project_dir):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)
    with cache(1, "step1") as op:
        op.store("foo", "bar")
    with cache(2, "step2") as op:
        op.store("foo", "baz")
    assert cache.current_step() == 2
    cache.remove(2)
    assert cache.current_step() == 1
    cache.remove(1)
    assert cache.is_empty()


def test_workflow_cache_operator_context_manager_calls_store_cache_buffer(tmp_project_dir, monkeypatch):
    from mle.utils.cache import WorkflowCache, WorkflowCacheOperator

    cache = WorkflowCache(tmp_project_dir)

    called = {}

    def fake_store_cache_buffer():
        called["called"] = True

    monkeypatch.setattr(cache, "_store_cache_buffer", fake_store_cache_buffer)

    with cache(1, "step1") as op:
        op.store("foo", "bar")

    assert called.get("called") is True


def test_workflow_cache_operator_context_manager_does_not_store_on_exception(tmp_project_dir, monkeypatch):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)

    called = {}

    def fake_store_cache_buffer():
        called["called"] = True

    monkeypatch.setattr(cache, "_store_cache_buffer", fake_store_cache_buffer)

    class CustomError(Exception):
        pass

    try:
        with cache(1, "step1") as op:
            op.store("foo", "bar")
            raise CustomError()
    except CustomError:
        pass

    assert called.get("called") is None


def test_workflow_cache_operator_pickle_complex_object(tmp_project_dir):
    from mle.utils.cache import WorkflowCache

    class ComplexObj:
        def __init__(self, x):
            self.x = x

        def __eq__(self, other):
            return isinstance(other, ComplexObj) and self.x == other.x

    cache = WorkflowCache(tmp_project_dir)
    obj = ComplexObj(42)
    with cache(1, "step1") as op:
        op.store("obj", obj)

    with cache(1, "step1") as op:
        obj_loaded = op.resume("obj")

    assert obj_loaded == obj


@pytest.mark.parametrize("step,name", [(1, "test1"), (2, "test2")])
def test_workflow_cache_call_creates_steps(tmp_project_dir, step, name):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)
    with cache(step, name) as op:
        op.store("foo", "bar")

    assert step in cache.cache
    assert cache.cache[step]["name"] == name


def test_workflow_cache_load_cache_buffer_none(tmp_path, monkeypatch):
    import mle.utils.cache as cache_mod

    # Patch get_config to return None simulating missing config file
    monkeypatch.setattr(cache_mod, "get_config", lambda: None)

    # The WorkflowCache should handle None gracefully and create empty cache dict
    cache = cache_mod.WorkflowCache(str(tmp_path))
    assert isinstance(cache.cache, dict)


def test_workflow_cache_remove_nonexistent_key(tmp_project_dir):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)
    with cache(1, "step1") as op:
        op.store("foo", "bar")

    # Removing a non-existent step should not raise error
    cache.remove(999)
    assert 1 in cache.cache


@pytest.mark.parametrize("step,name", [(1, "test1"), (2, "test2")])
def test_workflow_cache_operator_store_overwrite(tmp_project_dir, step, name):
    from mle.utils.cache import WorkflowCache

    cache = WorkflowCache(tmp_project_dir)
    with cache(step, name) as op:
        op.store("foo", "bar")
    with cache(step, name) as op:
        op.store("foo", "baz")

    with cache(step, name) as op:
        val = op.resume("foo")
    assert val == "baz"


