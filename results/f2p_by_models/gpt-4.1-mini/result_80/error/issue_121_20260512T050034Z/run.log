        with open(config_path, "r") as f:
            return yaml.safe_load(f)

    def fake_write_config(value):
        import yaml
        with open(config_path, "w") as f:
            yaml.dump(value, f, default_flow_style=False)

    monkeypatch = mock.patch.multiple(
        system_module,
        get_config=fake_get_config,
        write_config=fake_write_config,
    )
    with monkeypatch:
        cache = WorkflowCache(str(tmp_path))
        with cache(step=1, name="step1") as op:
            op.store("k", "v")
        with cache(step=2, name="step2") as op:
            op.store("k2", "v2")
        assert cache.current_step() == 2
        cache.remove(2)
        assert cache.current_step() == 1
        cache.remove(1)
        assert cache.is_empty()

