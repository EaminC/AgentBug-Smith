            "dummy_requirement",  # This will not be used because resumed
            "dummy_advisor_report",  # Not used, resumed
            "dummy_coding_plan",  # Not used, resumed
            "dummy_code_report",  # Not used, resumed
            True,  # confirm debug mode
        ])

        def ask_text_side_effect_2(prompt):
            # For resume prompt, return '2'
