[32mimport os
import tempfile
import shutil
import pytest
from unittest.mock import MagicMock

from mle.utils.cache import WorkflowCache, WorkflowCacheOperator
from mle.utils.system import get_config, write_config
from mle.workflow.baseline import baseline


class ConfigMock:
    """
    A mock for get_config and write_config to simulate config file behavior in memory.
    """

    def __init__(self):
        self._config = {}

    def get_config(self):
        # Return a dict, never None, to avoid AttributeError
        return self._config

    def write_config(self, value):
        self._config = value


@pytest.fixture(autouse=True)
def patch_system_config(monkeypatch):
    """
    Patch get_config and write_config to use in-memory config instead of file system.
    """
    config_mock = ConfigMock()
    monkeypatch.setattr("mle.utils.system.get_config", config_mock.get_config)
    monkeypatch.setattr("mle.utils.system.write_config", config_mock.write_config)
    yield config_mock


def test_workflow_cache_operator_store_and_resume(patch_system_config):
    cache = WorkflowCache("dummy_dir")
    with cache(1, "test step") as op:
        op.store("key1", {"a": 123})
        op.store("key2", [1, 2, 3])

    with cache(1, "test step") as op:
        val1 = op.resume("key1")
        val2 = op.resume("key2")
        val3 = op.resume("nonexistent")

    assert val1 == {"a": 123}
    assert val2 == [1, 2, 3]
    assert val3 is None


def test_workflow_cache_str_and_empty_behavior(patch_system_config):
    cache = WorkflowCache("dummy_dir")
    # Initially empty
    assert cache.is_empty()

    # Add a step
    with cache(5, "step five") as op:
        op.store("foo", "bar")

    assert not cache.is_empty()
    s = str(cache)
    assert "[5] step five" in s


def test_workflow_cache_remove_and_current_step(patch_system_config):
    cache = WorkflowCache("dummy_dir")
    with cache(1, "step 1") as op:
        op.store("data", 123)
    with cache(3, "step 3") as op:
        op.store("data", 456)
    with cache(2, "step 2") as op:
        op.store("data", 789)

    assert cache.current_step() == 3
    cache.remove(2)
    assert 2 not in cache.cache
    # Removing non-existing step does not raise
    cache.remove(999)
    assert cache.current_step() == 3


def test_workflow_cache_operator_context_manager_calls_store_cache_buffer(monkeypatch, patch_system_config):
    cache = WorkflowCache("dummy_dir")
    called = {"store_cache_buffer": False}

    def fake_store_cache_buffer():
        called["store_cache_buffer"] = True

    monkeypatch.setattr(cache, "_store_cache_buffer", fake_store_cache_buffer)

    with cache(1, "step 1") as op:
        op.store("key", "value")

    assert called["store_cache_buffer"]


def test_workflow_cache_operator_context_manager_does_not_store_on_exception(monkeypatch, patch_system_config):
    cache = WorkflowCache("dummy_dir")
    called = {"store_cache_buffer": False}

    def fake_store_cache_buffer():
        called["store_cache_buffer"] = True

    monkeypatch.setattr(cache, "_store_cache_buffer", fake_store_cache_buffer)

    try:
        with cache(1, "step 1") as op:
            op.store("key", "value")
            raise RuntimeError("fail")
    except RuntimeError:
        pass

    assert not called["store_cache_buffer"]


