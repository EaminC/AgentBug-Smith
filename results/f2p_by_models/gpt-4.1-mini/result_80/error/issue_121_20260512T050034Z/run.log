def test_baseline_resume_flow_and_caching(monkeypatch, tmp_path):
    import pickle
    from mle.utils.cache import WorkflowCache
    from mle.utils import ask_text, print_in_box

    # Prepare fake cache data simulating partial progress
    fake_cache_data = {
        "cache": {
            1: {
                "step": 1,
                "name": "ask for the data information",
                "time": "time1",
                "content": {"dataset": pickle.dumps("cached_dataset", fix_imports=False)},
            },
            2: {
                "step": 2,
                "name": "ask for the user requirement",
                "time": "time2",
                "content": {"ml_requirement": pickle.dumps("cached_requirement", fix_imports=False)},
            },
            3: {
                "step": 3,
                "name": "advisor agent gives suggestions in a report",
                "time": "time3",
                "content": {"advisor_report": pickle.dumps("cached_advisor_report", fix_imports=False)},
            },
            4: {
                "step": 4,
                "name": "plan agent generates the coding plan",
                "time": "time4",
                "content": {
                    "coding_plan": pickle.dumps(
                        {"tasks": ["task1", "task2"]}, fix_imports=False
                    )
                },
            },
        }
    }

    monkeypatch.setattr(system_module, "get_config", lambda: fake_cache_data)
    monkeypatch.setattr(system_module, "write_config", lambda v: None)

    # Patch ask_text to simulate user input for resume step and no new input needed
    inputs = iter(["2", "", "", ""])  # resume from step 2, then empty inputs for prompts

    def fake_ask_text(prompt):
        return next(inputs, "")

    monkeypatch.setattr("mle.utils.ask_text", fake_ask_text)

    # Patch questionary.confirm to always return True (debug mode)
    monkeypatch.setattr("questionary.confirm", lambda *args, **kwargs: True)

    # Patch print_in_box to no-op to avoid clutter
    monkeypatch.setattr("mle.utils.print_in_box", lambda *a, **k: None)

    # Patch model loading to dummy object
    monkeypatch.setattr("mle.model.load_model", lambda work_dir, model=None: "dummy_model")

    # Patch agents to dummy classes with controlled behavior
    class DummyAdviseAgent:
        def __init__(self, model, console):
            pass

        def interact(self, prompt):
            return "advisor report dummy"

    class DummyPlanAgent:
        def __init__(self, model, console):
            pass

        def interact(self, report):
            return {"tasks": ["task1", "task2"]}

    class DummyCodeAgent:
        def __init__(self, model, work_dir, console):
            self.model = model
            self.work_dir = work_dir
            self.console = console
            self.requirement = None

        def read_requirement(self, text):
            self.requirement = text

        def interact(self, task):
            # Return a dict with debug True for first task, False for second
            if task == "task1":
                return {"debug": "True"}
            else:
                return {"debug": "False"}

        def debug(self, task, debug_report):
            # Return a dict with debug False to break loop
            return {"debug": "False"}

    class DummyDebugAgent:
        def __init__(self, model, console):
            pass

        def analyze(self, code_report):
            # Return success status to break debug loop
            return {"status": "success"}

    monkeypatch.setattr("mle.agents.AdviseAgent", DummyAdviseAgent)
    monkeypatch.setattr("mle.agents.PlanAgent", DummyPlanAgent)
    monkeypatch.setattr("mle.agents.CodeAgent", DummyCodeAgent)
    monkeypatch.setattr("mle.agents.DebugAgent", DummyDebugAgent)

    # Run baseline function, should resume from step 2 and proceed without asking for dataset or requirement
    baseline_module.baseline(str(tmp_path))  # should not raise


