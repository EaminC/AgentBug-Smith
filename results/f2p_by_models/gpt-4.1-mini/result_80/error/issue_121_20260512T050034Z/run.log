[32mimport os
import tempfile
import pytest
from unittest import mock

import mle.workflow.baseline as baseline_module
from mle.utils.cache import WorkflowCache, WorkflowCacheOperator
from mle.utils.system import get_config, write_config


class ConfigMock:
    """
    A mock for the system config file operations to isolate tests from real file system.
    It keeps an in-memory dictionary as the config content.
    """

    def __init__(self):
        self._config_data = {"cache": {}}

    def get_config(self):
        return self._config_data

    def write_config(self, value):
        self._config_data = value


@pytest.fixture(autouse=True)
def patch_system_config(monkeypatch):
    """
    Patch get_config and write_config to use in-memory config instead of file system.
    """
    config_mock = ConfigMock()
    monkeypatch.setattr("mle.utils.system.get_config", config_mock.get_config)
    monkeypatch.setattr("mle.utils.system.write_config", config_mock.write_config)
    yield config_mock


def test_workflow_cache_operator_store_and_resume(patch_system_config):
    cache = WorkflowCache("dummy_dir")
    with cache(1, "test_step") as op:
        op.store("key1", "value1")
        op.store("key2", 12345)

    with cache(1, "test_step") as op:
        val1 = op.resume("key1")
        val2 = op.resume("key2")
        val3 = op.resume("nonexistent")

    assert val1 == "value1"
    assert val2 == 12345
    assert val3 is None


def test_workflow_cache_str_and_empty_behavior(patch_system_config):
    cache = WorkflowCache("dummy_dir")
    # Initially empty
    assert cache.is_empty()
    # Add a step
    with cache(1, "step1") as op:
        op.store("foo", "bar")
    assert not cache.is_empty()
    s = str(cache)
    assert "[1] step1" in s


def test_workflow_cache_remove_and_current_step(patch_system_config):
    cache = WorkflowCache("dummy_dir")
    with cache(1, "step1") as op:
        op.store("foo", "bar")
    with cache(2, "step2") as op:
        op.store("foo", "baz")

    assert cache.current_step() == 2
    cache.remove(2)
    assert cache.current_step() == 1
    cache.remove(1)
    assert cache.is_empty()


def test_workflow_cache_operator_context_manager_calls_store_cache_buffer(monkeypatch, patch_system_config):
    cache = WorkflowCache("dummy_dir")
    called = {"stored": False}

    orig_store_cache_buffer = cache._store_cache_buffer

    def fake_store_cache_buffer():
        called["stored"] = True
        orig_store_cache_buffer()

    monkeypatch.setattr(cache, "_store_cache_buffer", fake_store_cache_buffer)

    with cache(1, "step1") as op:
        op.store("foo", "bar")

    assert called["stored"] is True


def test_workflow_cache_operator_context_manager_does_not_store_on_exception(monkeypatch, patch_system_config):
    cache = WorkflowCache("dummy_dir")
    called = {"stored": False}

    orig_store_cache_buffer = cache._store_cache_buffer

    def fake_store_cache_buffer():
        called["stored"] = True
        orig_store_cache_buffer()

    monkeypatch.setattr(cache, "_store_cache_buffer", fake_store_cache_buffer)

    try:
        with cache(1, "step1") as op:
            op.store("foo", "bar")
            raise RuntimeError("fail inside context")
    except RuntimeError:
        pass

    assert called["stored"] is False


