        mock_ask_text.side_effect = ask_text_side_effect

        mock_advise_agent_interact.return_value = "dummy_advisor_report"
        mock_plan_agent_interact.return_value = {"tasks": ["task1"]}
        mock_code_agent_interact.return_value = {"debug": "True"}
        mock_debug_agent_analyze.return_value = {"status": "success"}
        mock_code_agent_debug.return_value = {"debug": "False"}
        mock_confirm.return_value = True

        # Run baseline first time to generate cache
        baseline_module.baseline(str(tmp_project_dir))

        # Now simulate second run with resume step input to resume from step 2
        inputs_second_run = iter([
            "2",  # resume from step 2
