    monkeypatch.setattr(mle.utils.system, "write_config", lambda v: None)

    cache = WorkflowCache("dummy_dir")
    # Should not raise and cache dict should be empty
    assert isinstance(cache.cache, dict)
    assert cache.cache == {}


def test_baseline_resume_flow_and_caching(monkeypatch, patch_cache_module, patch_get_write_config):
    from mle.utils.cache import WorkflowCache

