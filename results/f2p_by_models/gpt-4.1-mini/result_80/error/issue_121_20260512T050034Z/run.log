                    "content": {"dataset": pickle.dumps("cached_dataset", fix_imports=False)},
                },
                2: {
                    "step": 2,
                    "name": "ask for the user requirement",
                    "time": "time2",
                    "content": {"ml_requirement": pickle.dumps("cached_requirement", fix_imports=False)},
                },
                3: {
