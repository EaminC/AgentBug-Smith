def test_plan_agent_dependency_installation_flow(dummy_plan, dummy_llm_agent):
    """
    This test verifies that PlanAgent uses SetupAgent to install all dependencies,
    not just the first one.

    It mocks user confirmation to always True and mocks run_command to capture commands.
    """

    # Patch questionary.confirm to always return True (simulate user confirmation)
    with patch("questionary.confirm") as mock_confirm, \
         patch("agent.utils.system.run_command") as mock_run_command:

        mock_confirm.return_value = True
        mock_run_command.return_value = [("output", 0), ("output", 0)]

        # Create PlanAgent instance with dummy llm_agent and dummy_plan
        agent = PlanAgent(dummy_llm_agent, dummy_plan)

        # Patch PlanAgent.console.log to suppress output during test
        with patch.object(agent.console, "log") as mock_log, \
             patch.object(agent.console, "status") as mock_status:

            # The status context manager should yield normally
            mock_status.return_value.__enter__.return_value = None
            mock_status.return_value.__exit__.return_value = None

            # Set plan attribute explicitly (normally done in PlanAgent)
            agent.plan = dummy_plan

            # Call the method that triggers dependency installation
            # The buggy code installs only the first dependency command,
            # the fixed code installs all commands via SetupAgent.invoke()
            # We simulate the part of PlanAgent that calls SetupAgent.invoke()
            # by calling SetupAgent directly or by calling PlanAgent's method that triggers it.
            # Since the patch changes PlanAgent to call SetupAgent.invoke(),
            # we simulate that by calling invoke() directly here for test clarity.

            # Instead, call the method that triggers installation:
            # The relevant code is inside PlanAgent where it calls SetupAgent.invoke()
            # We simulate this by calling SetupAgent.invoke() directly with dummy llm_agent and plan.

            # Import SetupAgent here to test integration
            from agent.function.setup_agent import SetupAgent

            setup_agent = SetupAgent(dummy_llm_agent, dummy_plan)
            setup_agent.invoke()

            # Check that questionary.confirm was called once
            mock_confirm.assert_called_once()

            # Check that run_command was called once with all commands (list)
            mock_run_command.assert_called_once()
            called_args = mock_run_command.call_args[0][0]
            assert isinstance(called_args, list), "run_command should be called with a list of commands"
            # It should include all commands, not just the first one
            assert "python -m pip install torch" in called_args
            assert "pip install transformers" in called_args
            assert len(called_args) == 2, "Should install all dependencies, not just the first"

            # Check that console.log was called with the dependencies list
            found_log = False
            for call in mock_log.call_args_list:
                args = call[0]
                if args and isinstance(args[0], str) and "Will install the following dependencies" in args[0]:
                    found_log = True
                    # Check that both dependencies are listed
                    assert "torch" in args[0]
                    assert "transformers" in args[0]
            assert found_log, "Console should log the dependencies to be installed"


