            return DummyStatus()

        def log(self, message):
            logs.append(message)

    setup_agent.console = DummyConsole()

    # Patch questionary.confirm to return False (user declines)
    monkeypatch.setattr("questionary.confirm", lambda *args, **kwargs: mock.Mock(ask=lambda: False))

