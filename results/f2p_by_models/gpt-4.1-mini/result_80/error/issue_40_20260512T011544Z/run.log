    def test_install_all_dependencies(self, mock_run_command, mock_confirm):
        """
        This test verifies that PlanAgent installs all dependencies commands,
        not just the first one.
        It mocks the LLM agent to return multiple commands and dependencies,
        mocks user confirmation to True,
        and mocks run_command to record the commands run.

        On buggy code, only the first command would be run (or run_command called with a single string),
        causing the test to fail.
        On fixed code, all commands are run, and run_command is called with a list of commands.
        """

        # Prepare a dummy plan with minimal required attributes
        dummy_tasks = [
            Task(name="Task 1", description="desc", resources=["torch"]),
            Task(name="Task 2", description="desc", resources=["transformers"]),
        ]
        dummy_plan = Plan(
            lang="python",
            tasks=dummy_tasks,
            current_task=0,
            name="dummy plan",
            description="dummy description",
        )

        # Instantiate the dummy LLM agent that returns multiple commands
        dummy_llm_agent = DummyLLMAgent()

        # Patch PlanAgent to use our dummy plan and dummy agent
        plan_agent = PlanAgent()
        plan_agent.plan = dummy_plan
        plan_agent.agent = dummy_llm_agent

        # Patch questionary.confirm to always confirm installation
        mock_confirm.return_value = True

        # Patch run_command to just record calls and return dummy success
        def run_command_side_effect(commands):
            # commands should be a list of strings
            # We assert here that all commands are passed, not just one string
            self.assertIsInstance(commands, list, "run_command should be called with a list of commands")
            self.assertGreater(len(commands), 1, "run_command should be called with multiple commands")
            # Check that commands match expected dummy commands
            expected_commands = [
                "python -m pip install torch",
                "pip install transformers",
                "apt-get install build-essential"
            ]
            self.assertListEqual(commands, expected_commands)
            # Return dummy results list of tuples (output, exit_code)
            return [("output", 0) for _ in commands]

        mock_run_command.side_effect = run_command_side_effect

        # We need to trigger the dependency installation logic in PlanAgent
        # The buggy code calls dependency_generator and runs only the first command
        # The fixed code calls SetupAgent.invoke() which calls run_command with all commands
        # We simulate the call to the method that triggers installation:
        # The method is PlanAgent.run() or the relevant method that installs dependencies.
        # From the patch, the relevant code is inside PlanAgent.run() or similar.
        # We call plan_agent.run() if it exists, else we simulate the invoke call.

        # Because PlanAgent.run() may do more, we patch the plan_agent.run method to only test dependency installation part:
        # Instead, we directly call SetupAgent.invoke() via PlanAgent logic.

        # The PlanAgent.run() method calls SetupAgent.invoke() if plan has dependencies
        # We simulate the call by calling SetupAgent.invoke() directly via PlanAgent logic.

        # But SetupAgent is imported in plan_agent.py after patch, so we can import it here.
        from agent.function.setup_agent import SetupAgent

        setup_agent = SetupAgent(dummy_llm_agent, dummy_plan)

        # Patch questionary.confirm again for SetupAgent.invoke
        with patch("questionary.confirm", return_value=True):
            # Patch run_command again for SetupAgent.invoke
            with patch("agent.utils.system.run_command", side_effect=run_command_side_effect) as patched_run_command:
                setup_agent.invoke()
                # Assert run_command was called once
                self.assertEqual(patched_run_command.call_count, 1)

        # Additional check: the dummy_llm_agent.completions should be called at least once
        self.assertGreaterEqual(dummy_llm_agent.completions_call_count, 1)


