def test_plan_agent_installs_all_dependencies(
    dummy_plan, dummy_llm_agent, patch_questionary_confirm_yes, patch_run_command
):
    # Create PlanAgent with dummy llm_agent and dummy plan
    plan_agent = PlanAgent(dummy_llm_agent, dummy_plan)

    # Patch console.log and console.status to no-op to avoid clutter
    plan_agent.console.log = lambda *args, **kwargs: None
    plan_agent.console.status = lambda *args, **kwargs: DummyContextManager()

    # Set current_task to 0 to trigger installation logic
    dummy_plan.current_task = 0

    # Run the part of PlanAgent that installs dependencies
    # We call the internal method that triggers SetupAgent.invoke()
    # The buggy code only installs first dependency, fixed code installs all
    plan_agent._install_dependencies_for_plan()

    # Check that run_command was called with both dependencies commands
    # The buggy code only runs one command (string), fixed runs list of commands
    assert patch_run_command, "No commands were run"
    # The commands should include both pip install lib1 and pip install lib2
    assert any("pip install lib1" in cmd for cmd in patch_run_command)
    assert any("pip install lib2" in cmd for cmd in patch_run_command)


def test_plan_agent_skips_installation(
    dummy_plan, dummy_llm_agent, patch_questionary_confirm_no, patch_run_command
):
    # Create PlanAgent with dummy llm_agent and dummy plan
    plan_agent = PlanAgent(dummy_llm_agent, dummy_plan)

    # Patch console.log and console.status to no-op to avoid clutter
    plan_agent.console.log = lambda *args, **kwargs: None
    plan_agent.console.status = lambda *args, **kwargs: DummyContextManager()

    # Set current_task to 0 to trigger installation logic
    dummy_plan.current_task = 0

    # Run the part of PlanAgent that installs dependencies
    plan_agent._install_dependencies_for_plan()

    # Since user declined installation, run_command should not be called
    assert not patch_run_command, "Commands were run despite skipping installation"


