def test_plan_agent_installs_all_dependencies(dummy_plan, dummy_llm_agent, patch_confirm_yes, patch_run_command):
    """
    Test that PlanAgent installs all dependencies commands, not just the first one.
    This test exercises the SetupAgent integration invoked by PlanAgent.
    """

    # Patch PlanAgent's agent to our dummy_llm_agent that returns multiple commands
    plan_agent = PlanAgent()
    plan_agent.plan = dummy_plan
    plan_agent.agent = dummy_llm_agent
    plan_agent.console = mock.Mock()  # suppress console output

    # Set current_task to 0 so tasks loop runs
    plan_agent.plan.current_task = 0

    # We patch SetupAgent.invoke indirectly by running PlanAgent's dependency installation code path
    # The bug was that only the first dependency command was installed.
    # After fix, all commands should be passed to run_command.

    # We call the internal method that triggers dependency installation
    # The original code calls SetupAgent.invoke() inside PlanAgent, so we simulate that call here.

    # Because PlanAgent.install_dependencies() is not a public method, we simulate by calling the code path:
    # We replicate the relevant part of PlanAgent that calls SetupAgent.invoke()

    # Instead, we directly instantiate SetupAgent and call invoke to test the fix in isolation:
    from agent.function.setup_agent import SetupAgent

    setup_agent = SetupAgent(dummy_llm_agent, dummy_plan)

    # Call invoke, which should call completions twice and run all commands
    setup_agent.invoke()

    # Check that dummy_llm_agent.completions was called at least once
    assert dummy_llm_agent.completions_call_count >= 1

    # Check that all commands were passed to run_command (patch_run_command)
    executed_commands = patch_run_command
    assert isinstance(executed_commands, list)
    # There should be multiple commands, not just one
    assert len(executed_commands) > 1

    # Check that the commands match the dummy response commands
    expected_commands = [
        "python -m pip install torch",
        "pip install transformers",
        "apt-get install build-essential"
    ]
    for cmd in expected_commands:
        assert cmd in executed_commands

    # Also check that dependencies list is logged (console.log called)
    # We patch console.log to a mock, so check it was called with dependencies info
    # We do this by monkeypatching SetupAgent.console.log temporarily

    # Recreate SetupAgent with patched console.log
    logs = []

    class DummyConsole:
        def status(self, msg):
            # Context manager that yields nothing
            class DummyStatus:
                def __enter__(self_): return None
                def __exit__(self_, exc_type, exc_val, exc_tb): return False
            return DummyStatus()

        def log(self, message):
            logs.append(message)

    setup_agent = SetupAgent(dummy_llm_agent, dummy_plan)
    setup_agent.console = DummyConsole()

    # Patch questionary.confirm again to True
    with mock.patch("questionary.confirm", return_value=mock.Mock(ask=lambda: True)):
        # Patch run_command again to capture commands
        with mock.patch("agent.utils.system.run_command", patch_run_command):
            setup_agent.invoke()

    # Check logs contain dependencies info
    found_dependencies_log = any("dependencies" in log.lower() for log in logs)
    assert found_dependencies_log, "Expected dependencies info in console logs"


def test_plan_agent_skips_installation_on_decline(dummy_plan, dummy_llm_agent, monkeypatch):
    """
    Test that PlanAgent skips installation if user declines confirmation.
    """

    from agent.function.setup_agent import SetupAgent

    setup_agent = SetupAgent(dummy_llm_agent, dummy_plan)

    # Patch console.log to capture logs
    logs = []

