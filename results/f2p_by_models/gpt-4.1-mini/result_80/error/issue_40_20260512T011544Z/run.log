@patch("agent.function.setup_agent.questionary.confirm")
@patch("agent.utils.system.run_command")
def test_plan_agent_installs_all_dependencies(mock_run_command, mock_confirm, plan_agent):
    # Patch questionary.confirm to always return True (confirm installation)
    mock_confirm.return_value = True

    # Patch run_command to simulate successful command execution
    mock_run_command.return_value = [("Success", 0), ("Success", 0)]

    # Call the code path that triggers dependency installation
    # We simulate the plan_agent invoking the SetupAgent which installs all dependencies
    plan_agent.plan.current_task = 0  # Ensure current_task is 0 to process all tasks

    # The buggy code calls dependency_generator and installs only the first command
    # The fixed code calls SetupAgent.invoke() which installs all commands
    # We call the method that triggers installation (simulate the relevant part)
    # The PlanAgent class does installation in the run() method or similar, but here we invoke the method directly

    # Because the PlanAgent.run() method is complex, we simulate the relevant snippet:
    # Instead, we call SetupAgent.invoke() directly via PlanAgent to test the fix effect

    # The PlanAgent code calls SetupAgent(self.agent, self.plan).invoke()
    # We simulate that call here:
    from agent.function.setup_agent import SetupAgent

    setup_agent = SetupAgent(plan_agent.agent, plan_agent.plan)
    setup_agent.invoke()

    # Check that confirm was called once
    mock_confirm.assert_called_once()

    # Check that run_command was called with the full list of commands (both commands)
    called_commands = mock_run_command.call_args[0][0]
    assert isinstance(called_commands, list)
    assert len(called_commands) == 2
    assert "python -m pip install lib1" in called_commands
    assert "python -m pip install lib2" in called_commands

    # Check that dependencies list contains both dependencies
    deps = setup_agent.dependency_generator().get("dependencies")
    assert "lib1" in deps
    assert "lib2" in deps

    # This test will fail on buggy code because only the first dependency/command is installed
    # and pass on fixed code where all dependencies are installed


