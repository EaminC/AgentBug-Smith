RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libffi-dev libssl-dev \
 && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository into container
COPY . .

# Install Python dependencies from requirements.txt if it exists
RUN if [ -f requirements.txt ]; then \
    pip install -r requirements.txt; \
fi

# The project does not have setup.py or pyproject.toml, so skip pip install -e .
# Instead install pytest and test dependencies for Python
RUN pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-snapshot anyio "setuptools<=81.0.0" litellm

# Set PYTHONPATH so standalone scripts can import modules from /app
ENV PYTHONPATH=/app

# Preflight: verify Python and pytest installed
RUN python -c "import pytest; print('preflight ok')"

# Default command to keep container shell open
CMD ["/bin/bash"]
