[32m# The project is Node.js, evidenced by package.json and package-lock.json files.
# Use official Node.js alpine base image for minimal runtime.
FROM node:19-alpine AS test_builder

ARG NODE_ENV
ENV NODE_ENV=${NODE_ENV}

WORKDIR /app

# Copy package manifests to leverage Docker cache
COPY package*.json ./

# Install all dependencies with clean install
RUN npm ci

# Copy entire repository (required for injected test scripts)
COPY . .

# Modify prisma schema and move env for Docker usage as in original Dockerfile snippet
RUN [ -f ".env.docker" ] && mv .env.docker .env || echo ".env.docker not found, skipping" \
    && [ -f "prisma/schema.prisma" ] && sed -ie 's/postgresql/sqlite/g' prisma/schema.prisma && sed -ie 's/mysql/sqlite/g' prisma/schema.prisma && sed -ie 's/@db.Text//' prisma/schema.prisma || echo "prisma/schema.prisma not found, skipping"

# Preflight check to ensure core modules are correctly installed
RUN node -e 'require("jest"); console.log("preflight ok");'

# Generate prisma client, migrate and push DB schema
RUN npx prisma generate \
    && npx prisma migrate dev --name init \
    && npx prisma db push

# Build the Next.js app (inferred from package.json scripts)
RUN npm run build

# Run tests as part of test_builder stage (inferred presence of jest and test scripts)
RUN npm test

# Runtime stage with minimal dependencies
FROM node:19-alpine AS runtime

WORKDIR /app

# Copy only production dependencies
COPY package*.json ./

# Install only production dependencies
RUN npm ci --production

# Copy built app and other necessary files from test_builder stage
COPY --from=test_builder /app ./

# Set required Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Expose default port 3000 as in original Dockerfile
EXPOSE 3000

# Default command inferred from package.json start script (Next.js start)
CMD ["npm", "start"][0m
