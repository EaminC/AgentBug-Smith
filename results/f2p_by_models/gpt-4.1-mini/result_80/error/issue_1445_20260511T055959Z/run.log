[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set working directory
WORKDIR /app

# Copy entire repository to /app
COPY . .

# Set Forge API compatible environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    FORGE_API_KEY=forge-key

# Install system dependencies needed for building python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    libssl-dev \
    python3-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install Poetry if pyproject.toml and poetry.lock exist, else install requirements.txt if it exists
# Fix: Do not run poetry install on a broken lockfile to avoid build failure
# Just install editable package and requirements.txt dependencies if any
RUN if [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
      python -m pip install poetry && \
      poetry config virtualenvs.create false; \
    else \
      if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
      fi; \
    fi

# Always install the package in editable mode
RUN pip install -e .

# Always install test dependencies explicitly
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# Preflight to verify python environment and pytest
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set PYTHONPATH for source imports assuming src/ layout
ENV PYTHONPATH=/app/src

# Default container command
CMD ["/bin/bash"]

# branch: python/poetry-avoid-broken-lockfile fallback to requirements.txt with explicit editable install and test deps
