    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies:
# If poetry.lock and pyproject.toml exist, install poetry and install dependencies
# Else if requirements.txt exists, install from it
# Then install the project itself in editable mode
# Then install test dependencies
RUN if [ -f pyproject.toml ] && [ -f poetry.lock ]; then \
      pip install poetry && \
      poetry config virtualenvs.create false && \
      poetry install --no-interaction --no-ansi; \
    elif [ -f requirements.txt ]; then \
      pip install -r requirements.txt; \
    else \
