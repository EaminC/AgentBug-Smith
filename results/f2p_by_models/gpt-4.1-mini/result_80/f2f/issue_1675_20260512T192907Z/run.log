    files = ["a/x.py", "b/x.py", "c/y.py", "z.py"]
    result = io_instance.compute_minimal_fileids(files)

    # The minimal unique ids for files with same name should be disambiguated
    assert result["a/x.py"] == "a/x.py"
    assert result["b/x.py"] == "b/x.py"
    # Unique names should be just filename
