[32mimport os
import pytest
from pathlib import Path
from collections import defaultdict

import aider.io as io


def test_format_files_for_input_minimal_unique_ids():
    # Setup InputOutput instance
    io_instance = io.InputOutput()

    # Prepare test data with files having same names in different dirs and some read-only
    rel_fnames = [
        "src/module1/file.py",
        "src/module2/file.py",
        "src/module1/utils.py",
        "docs/file.py",
        "README.md",
    ]
    rel_read_only_fnames = [
        "src/module2/file.py",
        "README.md",
    ]

    # Call the method under test
    output = io_instance.format_files_for_input(rel_fnames, rel_read_only_fnames)

    # The output should contain minimal unique file ids with disambiguation in parentheses
    # and read-only files marked with " R " prefix, editable with "   " prefix.
    # The order is read-only files first, then editable files.

    lines = output.strip().split("\n")

    # Check read-only files first
    assert lines[0].startswith(" R ")
    assert lines[1].startswith(" R ")

    # Check editable files start with three spaces
    for line in lines[2:]:
        assert line.startswith("   ")

    # Check that disambiguation is present for files with same name
    # For example, "file.py" appears in multiple dirs, so should have parentheses
    read_only_names = [line[3:].strip() for line in lines[:2]]
    editable_names = [line[3:].strip() for line in lines[2:]]

    # The read-only files should include disambiguation for "file.py" in src/module2
    assert any("file.py" in name and "(" in name for name in read_only_names)
    # The editable files should include disambiguation for "file.py" in src/module1 and docs
    assert any("file.py" in name and "(" in name for name in editable_names)
    # The editable files should include "utils.py" without parentheses (unique)
    assert any(name == "utils.py" for name in editable_names)
    # The editable files should include "README.md" only in read-only (not editable)
    assert "README.md" not in editable_names


def test_compute_minimal_fileids_correctness():
    io_instance = io.InputOutput()

    rel_fnames = [
        "a/b/c/file.txt",
        "a/b/d/file.txt",
        "a/b/c/other.txt",
        "a/b/c/file2.txt",
        "a/b/file.txt",
    ]

    minimal_ids = io_instance.compute_minimal_fileids(rel_fnames)

    # minimal_ids should be a dict mapping each full path to a minimal unique id string
    assert isinstance(minimal_ids, dict)
    assert set(minimal_ids.keys()) == set(rel_fnames)

    # Check that files with same name have disambiguation
    assert minimal_ids["a/b/c/file.txt"] != "file.txt"
    assert minimal_ids["a/b/d/file.txt"] != "file.txt"

    # Files with unique names should not have disambiguation
    assert minimal_ids["a/b/c/other.txt"] == "other.txt"
    assert minimal_ids["a/b/c/file2.txt"] == "file2.txt"

    # The file "a/b/file.txt" is in a different directory level, so minimal id might be just "file.txt"
    # But to be safe, test that it is a string and present
    assert isinstance(minimal_ids["a/b/file.txt"], str)
    assert minimal_ids["a/b/file.txt"].endswith("file.txt")


def test_format_files_for_input_empty_lists():
    io_instance = io.InputOutput()

    # Empty lists should return just a newline
    output = io_instance.format_files_for_input([], [])
    assert output == "\n"

    # Non-empty rel_fnames but empty read-only list
    rel_fnames = ["file1.py", "dir/file2.py"]
    output = io_instance.format_files_for_input(rel_fnames, [])
    lines = output.strip().split("\n")
    # All lines should start with "   "
    assert all(line.startswith("   ") for line in lines)


def test_format_files_for_input_all_read_only():
    io_instance = io.InputOutput()

    rel_fnames = ["dir1/file.py", "dir2/file.py"]
    rel_read_only_fnames = rel_fnames.copy()

    output = io_instance.format_files_for_input(rel_fnames, rel_read_only_fnames)
    lines = output.strip().split("\n")

    # All lines should start with " R "
    assert all(line.startswith(" R ") for line in lines)


def test_format_files_for_input_mixed_and_duplicates():
    io_instance = io.InputOutput()

    rel_fnames = [
        "src/a/file.txt",
        "src/b/file.txt",
        "src/a/file2.txt",
        "src/b/file2.txt",
        "src/a/file3.txt",
    ]
    rel_read_only_fnames = [
        "src/b/file.txt",
        "src/a/file2.txt",
    ]

    output = io_instance.format_files_for_input(rel_fnames, rel_read_only_fnames)
    lines = output.strip().split("\n")

    # Check that read-only files come first and are correctly formatted
    read_only_lines = lines[:2]
    read_only_expected = set([
        " R file.txt (src/b)",
        " R file2.txt (src/a)",
    ])
    # Normalize lines by stripping leading/trailing spaces for comparison
    normalized_read_only = set(line.strip() for line in read_only_lines)
    assert normalized_read_only == read_only_expected

    # Check that editable files come after and are correctly formatted
    editable_lines = lines[2:]
    editable_expected = set([
        "file.txt (src/a)",
        "file3.txt",
    ])
    # Remove leading spaces and prefix for editable lines
    editable_names = set(line.strip() for line in editable_lines)
    # Each editable line should start with three spaces
    assert all(line.startswith("   ") for line in editable_lines)
    # Remove the prefix spaces for comparison
    editable_names = set(line.strip() for line in editable_lines)
    # The editable names should match expected (without prefix)
    assert editable_expected.issubset(editable_names)


