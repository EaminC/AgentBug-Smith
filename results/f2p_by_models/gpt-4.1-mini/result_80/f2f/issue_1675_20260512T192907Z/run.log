[32mimport os
from pathlib import Path
from collections import defaultdict
import pytest

import aider.io as io


def test_format_files_for_input_minimal_unique_ids():
    # Setup InputOutput instance
    io_instance = io.InputOutput()

    # Prepare test data with files having same names in different dirs and some read-only
    rel_fnames = [
        "src/module1/file.py",
        "src/module2/file.py",
        "src/module1/utils.py",
        "docs/file.py",
        "README.md",
    ]
    rel_read_only_fnames = [
        "src/module2/file.py",
        "README.md",
    ]

    # Call the method under test
    output = io_instance.format_files_for_input(rel_fnames, rel_read_only_fnames)

    # The output should contain minimal unique file ids with disambiguation in parentheses
    # and read-only files marked with " R " prefix, editable with "   " prefix.
    # The order is read-only files first, then editable files.

    lines = output.strip().split("\n")

    # Check read-only files first
    # They must start with " R "
    for line in lines[:len(rel_read_only_fnames)]:
        assert line.startswith(" R ")

    # Check editable files next
    for line in lines[len(rel_read_only_fnames):]:
        assert line.startswith("   ")

    # Check that minimal unique file ids are used (disambiguation in parentheses for duplicates)
    # For example, "file.py (src/module2)" should appear for one of the read-only files
    found_disambiguation = any("(" in line and ")" in line for line in lines)
    assert found_disambiguation

    # Check that all files are represented
    all_names = [line.strip()[3:] for line in lines]
    # Extract base names ignoring disambiguation
    base_names = [name.split(" ")[0] for name in all_names]
    expected_basenames = [Path(f).name for f in rel_fnames]
    assert sorted(base_names) == sorted(expected_basenames)


def test_compute_minimal_fileids_correctness():
    io_instance = io.InputOutput()

    rel_fnames = [
        "a/b/c/file.txt",
        "a/b/d/file.txt",
        "a/b/c/other.txt",
        "a/b/c/file2.txt",
        "a/b/file.txt",
    ]

    minimal_ids = io_instance.compute_minimal_fileids(rel_fnames)

    # All keys must be present
    assert set(minimal_ids.keys()) == set(rel_fnames)

    # file.txt appears multiple times, minimal ids should disambiguate
    file_txt_ids = [minimal_ids[f] for f in rel_fnames if f.endswith("file.txt")]
    # They should be unique
    assert len(set(file_txt_ids)) == len(file_txt_ids)
    # They should not be just "file.txt"
    assert all(id_ != "file.txt" for id_ in file_txt_ids)

    # other.txt and file2.txt appear once, minimal id should be just the filename
    assert minimal_ids["a/b/c/other.txt"] == "other.txt"
    assert minimal_ids["a/b/c/file2.txt"] == "file2.txt"


def test_format_files_for_input_empty_lists():
    io_instance = io.InputOutput()

    # Empty lists should return just a newline
    output = io_instance.format_files_for_input([], [])
    assert output == "\n"

    # Non-empty rel_fnames but empty read-only list
    rel_fnames = ["file1.py", "dir/file2.py"]
    output = io_instance.format_files_for_input(rel_fnames, [])
    lines = output.strip().split("\n")
    # All lines should start with "   "
    assert all(line.startswith("   ") for line in lines)


def test_format_files_for_input_all_read_only():
    io_instance = io.InputOutput()

    rel_fnames = ["dir1/file.py", "dir2/file.py"]
    rel_read_only_fnames = rel_fnames.copy()

    output = io_instance.format_files_for_input(rel_fnames, rel_read_only_fnames)
    lines = output.strip().split("\n")

    # All lines should start with " R "
    assert all(line.startswith(" R ") for line in lines)


def test_format_files_for_input_mixed_and_duplicates():
    io_instance = io.InputOutput()

    rel_fnames = [
        "src/a/file.txt",
        "src/b/file.txt",
        "src/a/file2.txt",
        "src/b/file2.txt",
        "src/a/file3.txt",
    ]
    rel_read_only_fnames = [
        "src/b/file.txt",
        "src/a/file2.txt",
    ]

    output = io_instance.format_files_for_input(rel_fnames, rel_read_only_fnames)
    lines = output.strip().split("\n")

    # Check that read-only files come first and are correctly formatted
    read_only_lines = lines[:len(rel_read_only_fnames)]
    editable_lines = lines[len(rel_read_only_fnames):]

    # Read-only lines start with " R "
    assert all(line.startswith(" R ") for line in read_only_lines)
    # Editable lines start with "   "
    assert all(line.startswith("   ") for line in editable_lines)

    # Check that minimal unique file ids are used for duplicates
    # At least one line should have disambiguation in parentheses
    found_disambiguation = any("(" in line and ")" in line for line in lines)
    assert found_disambiguation

    # Check that all files are represented
    all_names = [line.strip()[3:] for line in lines]
    base_names = [name.split(" ")[0] for name in all_names]
    expected_basenames = [Path(f).name for f in rel_fnames]
    assert sorted(base_names) == sorted(expected_basenames)[0m
