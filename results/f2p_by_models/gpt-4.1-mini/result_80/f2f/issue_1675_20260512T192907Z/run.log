from pathlib import Path
from collections import defaultdict
import os

import aider.io as io


def test_compute_minimal_fileids_correctness():
    io_instance = io.InputOutput()

    rel_fnames = [
        "src/a/file.txt",
        "src/b/file.txt",
        "src/a/file2.txt",
        "src/b/file2.txt",
        "src/a/file3.txt",
        "file3.txt",
    ]

    minimal_ids = io_instance.compute_minimal_fileids(rel_fnames)

    # Each minimal id should be a suffix of the original path
    for full_path in rel_fnames:
        pth = Path(full_path)
        minimal_id = minimal_ids[full_path]
        # The minimal id path joined with the shared prefix should reconstruct original
        # Actually minimal_id is relative to some prefix, so minimal_id should be suffix
        assert str(pth).endswith(minimal_id)

    # Files with same basename should have minimal ids that disambiguate them
    # file.txt appears twice, minimal ids should be different
    assert minimal_ids["src/a/file.txt"] != minimal_ids["src/b/file.txt"]
    # file2.txt appears twice, minimal ids should be different
    assert minimal_ids["src/a/file2.txt"] != minimal_ids["src/b/file2.txt"]
    # file3.txt appears once in src/a and once at root, minimal ids should differ
    assert minimal_ids["src/a/file3.txt"] != minimal_ids["file3.txt"]


def test_format_files_for_input_minimal_unique_ids():
    io_instance = io.InputOutput()

    rel_fnames = [
        "src/a/file.txt",
        "src/b/file.txt",
        "src/a/file2.txt",
        "src/b/file2.txt",
        "src/a/file3.txt",
    ]
    rel_read_only_fnames = [
        "src/b/file.txt",
        "src/a/file2.txt",
    ]

    output = io_instance.format_files_for_input(rel_fnames, rel_read_only_fnames)
    lines = output.strip().split("\n")

    # Read-only files should be listed first
    read_only_lines = lines[:len(rel_read_only_fnames)]
    editable_lines = lines[len(rel_read_only_fnames):]

    # Read-only lines start with " R "
    assert all(line.startswith(" R ") for line in read_only_lines)
    # Editable lines start with "   "
    assert all(line.startswith("   ") for line in editable_lines)

    # Each line should mention the filename (basename) and if needed a parent path in parentheses
    for line in lines:
        # Remove prefix " R " or "   "
        name_part = line[3:]
        # Should contain filename
        assert len(name_part) > 0
        # If parentheses present, they should be well-formed
        if "(" in name_part:
            assert name_part.endswith(")")
            # The part inside parentheses should not be empty
            paren_content = name_part[name_part.index("(") + 1 : -1]
            assert len(paren_content) > 0


