[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Copy entire repo including externally injected test scripts
COPY . .

# Detect src/ layout or tests importing from src to decide install strategy
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    else \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# Preflight import check to fail fast if core modules missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Run tests to verify environment (CI will run pytest externally, but good to have here)
RUN pytest

FROM python:3.12-slim AS runtime

WORKDIR /app

COPY . .

# Install only production dependencies (no test packages)
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    pip install -r requirements.txt 2>/dev/null || true; \
    pip install -e .; \
    # Uninstall test-related packages to keep runtime minimal; reinstall only production deps
    pip uninstall -y pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout || true

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

CMD ["/bin/bash"][0m
