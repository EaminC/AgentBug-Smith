import unittest
from unittest.mock import patch, MagicMock

import mle.model as model_module


class TestOpenAIModelBaseUrl(unittest.TestCase):
    def test_openai_model_uses_env_base_url(self):
        # Set environment variable for base URL
        test_url = "https://custom.openai.api/v1"
        os.environ["OPENAI_BASE_URL"] = test_url

        # Create OpenAIModel instance
        openai_model = model_module.OpenAIModel(api_key="dummy_key")

        # Check that the client's base_url is set to the environment variable value
        self.assertEqual(openai_model.client.api_base, test_url)

        # Clean up environment variable
        del os.environ["OPENAI_BASE_URL"]


class TestLoadModelReturnsCorrectInstance(unittest.TestCase):
    def setUp(self):
        # Patch get_config to control platform and api_key
        patcher = patch("mle.model.get_config")
        self.mock_get_config = patcher.start()
        self.addCleanup(patcher.stop)

    @patch("mle.model.importlib.util.find_spec")
    @patch("mle.model.importlib.import_module")
    def test_load_model_openai_returns_openai_model(self, mock_import_module, mock_find_spec):
        self.mock_get_config.return_value = {
            'platform': model_module.MODEL_OPENAI,
            'api_key': 'dummy_api_key'
        }
        # No special dependency check needed for OpenAIModel
        model_instance = model_module.load_model("dummy_dir")
        self.assertIsInstance(model_instance, model_module.OpenAIModel)

    @patch("mle.model.importlib.util.find_spec")
    @patch("mle.model.importlib.import_module")
    def test_load_model_claude_returns_claude_model(self, mock_import_module, mock_find_spec):
        self.mock_get_config.return_value = {
            'platform': model_module.MODEL_CLAUDE,
            'api_key': 'dummy_api_key'
        }
        # Pretend anthropic package is installed
        mock_find_spec.return_value = True
        mock_import_module.return_value.Anthropic = MagicMock()
        model_instance = model_module.load_model("dummy_dir")
        self.assertEqual(type(model_instance).__name__, "ClaudeModel")

    @patch("mle.model.importlib.util.find_spec")
    @patch("mle.model.importlib.import_module")
    def test_load_model_ollama_returns_ollama_model(self, mock_import_module, mock_find_spec):
        self.mock_get_config.return_value = {
            'platform': model_module.MODEL_OLLAMA,
            'api_key': 'dummy_api_key'
        }
        # Pretend ollama package is installed
        mock_find_spec.return_value = True
        mock_import_module.return_value.Client.return_value = MagicMock()
        model_instance = model_module.load_model("dummy_dir")
        self.assertEqual(type(model_instance).__name__, "OllamaModel")

    @patch("mle.model.importlib.util.find_spec")
    @patch("mle.model.importlib.import_module")
    def test_load_model_mistral_returns_mistral_model(self, mock_import_module, mock_find_spec):
