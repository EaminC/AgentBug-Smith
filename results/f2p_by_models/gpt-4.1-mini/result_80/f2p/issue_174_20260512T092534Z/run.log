class TestOpenAIModelBaseUrl(unittest.TestCase):
    @patch("mle.model.openai.chat.completions.create")
    def test_openai_model_uses_env_base_url(self, mock_create):
        # Setup dummy response
        mock_create.return_value = MagicMock(choices=[MagicMock(message={"content": "test response"})])

        # Set environment variable for base url
        os.environ["OPENAI_BASE_URL"] = "https://custom.api.openai.com/v1"

        model = model_module.OpenAIModel(api_key="dummy_key", model="gpt-4o-2024-08-06")
        # The client should have base_url set to the env var
        self.assertEqual(model.client._base_url, "https://custom.api.openai.com/v1")

        # Run query to trigger call
        response = model.query([{"role": "user", "content": "Hello"}])
        self.assertIn("test response", response)

        # Clean up environment variable
        del os.environ["OPENAI_BASE_URL"]


