class TestOpenAIModelBaseUrl(unittest.TestCase):
    @patch.dict(os.environ, {"OPENAI_BASE_URL": "https://custom.openai.api/v1"})
    @patch("mle.model.openai.chat.completions.create")
    @patch("mle.model.get_config")
    def test_openai_model_uses_env_base_url(self, mock_get_config, mock_create):
        test_base_url = "https://custom.openai.api/v1"

        # Setup mock config to use OpenAI platform and dummy api_key
        mock_get_config.return_value = {
            'platform': model_module.MODEL_OPENAI,
            'api_key': 'dummy_api_key'
        }

        # Setup mock response for openai.chat.completions.create
        mock_create.return_value = MagicMock(
            choices=[MagicMock(message={"content": "test response"})]
        )

        # Load model, which should instantiate OpenAIModel with base_url from env
        openai_model = model_module.load_model(project_dir="dummy_dir", model_name="gpt-4o-2024-08-06")

        # The client._base_url is a URL object, so convert to string for comparison
        client_base_url_str = str(openai_model.client._base_url).rstrip('/')
        expected_base_url_str = test_base_url.rstrip('/')

        self.assertEqual(client_base_url_str, expected_base_url_str)


