class TestOpenAIModelBaseUrl(unittest.TestCase):
    @patch("mle.model.openai.chat.completions.create")
    def test_openai_model_uses_env_base_url(self, mock_create):
        # Set environment variable for base URL
        test_url = "https://test-openai.example.com/v1"
        os.environ["OPENAI_BASE_URL"] = test_url

        # Setup mock response
        mock_create.return_value = {
            "choices": [{"message": {"content": "test response"}}]
        }

        # Create OpenAIModel instance, which should read the env var
        model = model_module.OpenAIModel(api_key="dummy_key")

        # The client should have the base_url attribute set to test_url
        self.assertEqual(model.client._base_url, test_url)

        # Clean up environment variable
        del os.environ["OPENAI_BASE_URL"]


