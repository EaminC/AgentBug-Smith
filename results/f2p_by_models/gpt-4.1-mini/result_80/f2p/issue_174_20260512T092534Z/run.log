import unittest
from unittest.mock import patch, MagicMock

import mle.model as model_module


class TestOpenAIModelBaseUrl(unittest.TestCase):
    def test_openai_model_uses_env_base_url(self):
        # Set environment variable for base URL
        test_url = "https://custom.openai.api/v1"
        os.environ["OPENAI_BASE_URL"] = test_url

        # Create OpenAIModel instance
        openai_model = model_module.OpenAIModel(api_key="dummy_key")

        # The client's base_url attribute should match the environment variable
        # Accessing the client's base_url depends on the internal client implementation.
        # The buggy code sets base_url in the openai() call, so we check the attribute.
        # We check that the client was initialized with the correct base_url.
        # The client is stored in openai_model.client
        # Since the client is the result of self.openai(), which is a method in OpenAIModel,
        # we check if the client has an attribute base_url matching test_url.
        # If the buggy code does not set base_url, this test should fail.

        # We expect the client to have a base_url attribute equal to test_url
        self.assertTrue(
            hasattr(openai_model.client, "base_url"),
            "OpenAIModel.client should have attribute 'base_url'",
        )
        self.assertEqual(openai_model.client.base_url, test_url)

        # Clean up environment variable
        del os.environ["OPENAI_BASE_URL"]


class TestLoadModelReturnsCorrectInstance(unittest.TestCase):
    def setUp(self):
        patcher = patch("mle.model.get_config")
