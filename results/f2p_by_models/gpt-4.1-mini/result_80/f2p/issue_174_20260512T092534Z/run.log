import mle.model as model_module


class TestOpenAIModelBaseUrl(unittest.TestCase):
    @patch.dict(os.environ, {"OPENAI_BASE_URL": "https://custom.openai.api/v1"})
    def test_openai_model_uses_env_base_url(self):
        # The OpenAIModel should use the OPENAI_BASE_URL environment variable if set
        openai_model = model_module.OpenAIModel(api_key="dummy_key")
        self.assertEqual(
            openai_model.client.base_url,
            "https://custom.openai.api/v1",
            "OpenAIModel did not use OPENAI_BASE_URL environment variable",
        )


class TestLoadModelReturnsCorrectInstance(unittest.TestCase):
    def setUp(self):
        # Patch get_config to control platform and api_key returned
