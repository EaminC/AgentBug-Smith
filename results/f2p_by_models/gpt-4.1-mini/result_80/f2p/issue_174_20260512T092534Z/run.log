[32mimport os
import unittest
from unittest.mock import patch, MagicMock
import mle.model as model_module


class TestOpenAIModelBaseUrl(unittest.TestCase):
    def setUp(self):
        # Patch get_config to control platform and api_key
        patcher = patch('mle.model.get_config')
        self.addCleanup(patcher.stop)
        self.mock_get_config = patcher.start()

    @patch('openai.chat.completions.create')
    def test_openai_model_uses_env_base_url(self, mock_create):
        # Setup environment variable for base url
        test_base_url = "https://custom.openai.api/v1"
        os.environ["OPENAI_BASE_URL"] = test_base_url

        # Setup mock config to use OpenAI platform and dummy api_key
        self.mock_get_config.return_value = {
            'platform': model_module.MODEL_OPENAI,
            'api_key': 'dummy_api_key'
        }

        # Setup mock response for openai.chat.completions.create
        mock_create.return_value = MagicMock(
            choices=[MagicMock(message={"content": "test response"})]
        )

        # Load model, which should instantiate OpenAIModel with base_url from env
        openai_model = model_module.load_model(project_dir="dummy_dir", model_name="gpt-4o-2024-08-06")

        # Assert the client base_url is set to the env var
        self.assertEqual(openai_model.client._base_url, test_base_url)

        # Call query to trigger openai.chat.completions.create call
        response = openai_model.query(chat_history=[{"role": "user", "content": "Hello"}])

        # Assert the mocked create method was called once
        mock_create.assert_called_once()

        # Assert the response content is as mocked
        self.assertEqual(response, "test response")

        # Clean up environment variable
        del os.environ["OPENAI_BASE_URL"]


class TestLoadModelReturnsCorrectInstance(unittest.TestCase):
    def setUp(self):
        patcher = patch('mle.model.get_config')
        self.addCleanup(patcher.stop)
        self.mock_get_config = patcher.start()

    def test_load_model_openai_returns_openai_model(self):
        self.mock_get_config.return_value = {
            'platform': model_module.MODEL_OPENAI,
            'api_key': 'dummy_api_key'
        }
        model_instance = model_module.load_model("dummy_dir")
        self.assertIsInstance(model_instance, model_module.OpenAIModel)

    def test_load_model_claude_returns_claude_model(self):
        self.mock_get_config.return_value = {
            'platform': model_module.MODEL_CLAUDE,
            'api_key': 'dummy_api_key'
        }
        model_instance = model_module.load_model("dummy_dir")
        self.assertEqual(model_instance.__class__.__name__, "ClaudeModel")

    def test_load_model_ollama_returns_ollama_model(self):
        self.mock_get_config.return_value = {
            'platform': model_module.MODEL_OLLAMA,
            'api_key': 'dummy_api_key'
        }
        model_instance = model_module.load_model("dummy_dir")
        self.assertEqual(model_instance.__class__.__name__, "OllamaModel")

    def test_load_model_mistral_returns_mistral_model(self):
        self.mock_get_config.return_value = {
            'platform': model_module.MODEL_MISTRAL,
            'api_key': 'dummy_api_key'
        }
        model_instance = model_module.load_model("dummy_dir")
        self.assertEqual(model_instance.__class__.__name__, "MistralModel")

    def test_load_model_deepseek_returns_deepseek_model(self):
        self.mock_get_config.return_value = {
            'platform': model_module.MODEL_DEEPSEEK,
            'api_key': 'dummy_api_key'
        }
        model_instance = model_module.load_model("dummy_dir")
        self.assertEqual(model_instance.__class__.__name__, "DeepSeekModel")

    def test_load_model_unknown_platform_returns_none(self):
        self.mock_get_config.return_value = {
            'platform': "unknown_platform",
            'api_key': 'dummy_api_key'
        }
        model_instance = model_module.load_model("dummy_dir")
        self.assertIsNone(model_instance)


if __name__ == "__main__":
    unittest.main()[0m
