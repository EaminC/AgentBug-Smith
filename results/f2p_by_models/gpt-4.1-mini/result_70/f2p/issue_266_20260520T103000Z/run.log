[32mimport os
import tempfile
import unittest
from unittest.mock import patch, MagicMock

from mle.utils.memory import LanceDBMemory


class TestLanceDBMemoryManageAPI(unittest.TestCase):
    def setUp(self):
        # Create a temporary directory to simulate project_path
        self.temp_dir = tempfile.TemporaryDirectory()
        self.project_path = self.temp_dir.name

        # Patch LanceDBMemory.client to a mock to avoid real DB calls
        patcher = patch('mle.utils.memory.lancedb.Client')
        self.addCleanup(patcher.stop)
        self.mock_client_class = patcher.start()
        self.mock_client = MagicMock()
        self.mock_client_class.return_value = self.mock_client

        # Patch get_registry to return a dummy embedding function to avoid errors
        patcher_registry = patch('mle.utils.memory.get_registry')
        self.addCleanup(patcher_registry.stop)
        self.mock_get_registry = patcher_registry.start()
        self.mock_get_registry.return_value = MagicMock()

        # Instantiate LanceDBMemory with the temporary project path
        self.memory = LanceDBMemory(self.project_path)

        # Setup default table_name for tests
        self.table_name = self.memory.table_name

        # Setup mock table object
        self.mock_table = MagicMock()
        self.mock_client.open_table.return_value = self.mock_table

    def tearDown(self):
        self.temp_dir.cleanup()

    def test_add_and_list_all_keys(self):
        # Prepare mock return for search().to_list() to simulate stored records
        stored_records = [
            {"id": "id1", "metadata": {"key": "value1"}},
            {"id": "id2", "metadata": {"key": "value2"}},
            {"id": "id3", "metadata": {"key": "value3"}},
        ]
        self.mock_table.search.return_value.to_list.return_value = stored_records

        # Call list_all_keys and verify it returns the list of ids only
        keys = self.memory.list_all_keys()
        self.mock_client.open_table.assert_called_with(self.table_name)
        self.mock_table.search.assert_called_with(query_type="fts")
        self.assertEqual(keys, [rec["id"] for rec in stored_records])

    def test_get_existing_record(self):
        # Setup a record to be returned by get()
        record_id = "existing_id"
        expected_record = [{"id": record_id, "metadata": {"foo": "bar"}}]

        # Setup chained calls for search().where().limit().to_list()
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = expected_record

        result = self.memory.get(record_id)
        self.mock_client.open_table.assert_called_with(self.table_name)
        self.mock_table.search.assert_called_with(query_type="fts")
        self.mock_table.search.return_value.where.assert_called_with(f"id = '{record_id}'")
        self.assertEqual(result, expected_record)

    def test_get_nonexistent_record(self):
        record_id = "nonexistent_id"
        # Return empty list for no record found
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = []

        result = self.memory.get(record_id)
        self.assertEqual(result, [])

    def test_get_by_metadata(self):
        key = "category"
        value = "test"
        n_results = 3
        expected_records = [
            {"id": "id1", "metadata": {key: value}},
            {"id": "id2", "metadata": {key: value}},
        ]

        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = expected_records

        results = self.memory.get_by_metadata(key, value, n_results=n_results)
        self.mock_client.open_table.assert_called_with(self.table_name)
        self.mock_table.search.assert_called_with(query_type="fts")
        self.mock_table.search.return_value.where.assert_called_with(f"metadata.{key} = '{value}'")
        self.assertEqual(results, expected_records)

    def test_delete_by_metadata(self):
        key = "type"
        value = "obsolete"

        # Setup delete to return True
        self.mock_table.delete.return_value = True

        result = self.memory.delete_by_metadata(key, value)
        self.mock_client.open_table.assert_called_with(self.table_name)
        self.mock_table.delete.assert_called_with(f"metadata.{key} = '{value}'")
        self.assertTrue(result)

    def test_drop_table(self):
        # Setup delete_collection to return True
        self.mock_client.delete_collection.return_value = True

        result = self.memory.drop()
        self.mock_client.delete_collection.assert_called_with(name=self.table_name)
        self.assertTrue(result)


