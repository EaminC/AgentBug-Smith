+    def list_all_keys(self, table_name: Optional[str] = None):
+        """
+        Lists all IDs in the specified memory table.
+
+        Args:
+            table_name (Optional[str]): The name of the table to list IDs from. Defaults to the instance's table name.
+
+        Returns:
