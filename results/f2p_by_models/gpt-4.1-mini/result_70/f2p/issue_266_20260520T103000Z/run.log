from mle.utils.memory import LanceDBMemory
import tempfile
import os


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for LanceDB storage
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir)
        yield mem


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance
    table = mem.table_name

    # Clear any existing data in the table if exists
    if table in mem.client.table_names():
        mem.drop(table)

    # Add some records
    records = [
        {"id": "rec1", "text": "Hello world", "metadata": {"tag": "greeting"}},
        {"id": "rec2", "text": "Goodbye world", "metadata": {"tag": "farewell"}},
        {"id": "rec3", "text": "Hello again", "metadata": {"tag": "greeting"}},
    ]
    mem.add(records)

    # Test list_all_keys returns all IDs
    keys = mem.list_all_keys()
    assert set(keys) == {"rec1", "rec2", "rec3"}, f"Expected keys {'rec1','rec2','rec3'}, got {keys}"

    # Test get returns the correct record for rec2
    rec2 = mem.get("rec2")
    assert isinstance(rec2, list)
    assert len(rec2) == 1
    assert rec2[0]["id"] == "rec2"
    assert rec2[0]["text"] == "Goodbye world"
    assert rec2[0]["metadata"]["tag"] == "farewell"

    # Test get returns empty list for non-existent id
    rec_none = mem.get("nonexistent")
    assert rec_none == []

    # Test get_by_metadata returns correct records
    greetings = mem.get_by_metadata("tag", "greeting")
    greeting_ids = {r["id"] for r in greetings}
    assert greeting_ids == {"rec1", "rec3"}

    # Test delete_by_metadata deletes matching records
    deleted = mem.delete_by_metadata("tag", "farewell")
    assert deleted is True or deleted is False  # just check it returns a bool

    # After deletion, rec2 should no longer be present
    keys_after = mem.list_all_keys()
    assert "rec2" not in keys_after
    assert "rec1" in keys_after and "rec3" in keys_after

    # Clean up
    mem.drop()


def test_delete_and_drop(memory_instance):
    mem = memory_instance
    table = mem.table_name

    # Add a record
    record = [{"id": "to_delete", "text": "Delete me", "metadata": {"tag": "temp"}}]
    mem.add(record)

    # Confirm record exists
    keys = mem.list_all_keys()
    assert "to_delete" in keys

    # Delete by id
    deleted = mem.delete("to_delete")
    assert deleted is True or deleted is False  # deletion returns bool

    # Confirm record no longer exists
    keys_after = mem.list_all_keys()
    assert "to_delete" not in keys_after

    # Drop table
    dropped = mem.drop()
    assert dropped is True or dropped is False  # drop returns bool

    # Table should no longer exist
    assert table not in mem.client.table_names() or mem.client.table_names() == [][0m
