from unittest.mock import patch, MagicMock
from mle.utils.memory import LanceDBMemory


class TestLanceDBMemoryManageAPI(unittest.TestCase):
    def setUp(self):
        # Patch the LanceDBMemory client and table to isolate tests from actual DB
        self.patcher_connect = patch('mle.utils.memory.lancedb.connect')
        self.mock_connect = self.patcher_connect.start()
        self.mock_client = MagicMock()
        self.mock_connect.return_value = self.mock_client

        self.mock_table = MagicMock()
        self.mock_client.open_table.return_value = self.mock_table

        # Instantiate LanceDBMemory with a dummy project_path
        self.mem = LanceDBMemory(project_path="dummy_path")

    def tearDown(self):
        self.patcher_connect.stop()

    def test_add_and_list_all_keys(self):
        # Setup mock return for list_all_keys
        self.mock_table.search.return_value.to_list.return_value = [
            {"id": "id1"}, {"id": "id2"}, {"id": "id3"}
        ]

        keys = self.mem.list_all_keys()
        self.mock_client.open_table.assert_called_once_with(self.mem.table_name)
        self.mock_table.search.assert_called_once_with(query_type="fts")
        self.assertEqual(keys, ["id1", "id2", "id3"])

    def test_get_existing_record(self):
        # Setup mock return for get with existing record
        record = [{"id": "id1", "data": "some data"}]
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = record

        result = self.mem.get("id1")
        self.mock_client.open_table.assert_called_once_with(self.mem.table_name)
        self.mock_table.search.assert_called_once_with(query_type="fts")
        self.mock_table.search.return_value.where.assert_called_once_with("id = 'id1'")
        self.mock_table.search.return_value.where.return_value.limit.assert_called_once_with(1)
        self.assertEqual(result, record)

    def test_get_nonexistent_record(self):
        # Setup mock return for get with no record found
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = []

        result = self.mem.get("nonexistent_id")
        self.assertEqual(result, [])

    def test_get_by_metadata(self):
        # Setup mock return for get_by_metadata
        records = [
            {"id": "id1", "metadata": {"key": "value"}},
            {"id": "id2", "metadata": {"key": "value"}}
        ]
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = records

        result = self.mem.get_by_metadata("key", "value", n_results=2)
        self.mock_client.open_table.assert_called_once_with(self.mem.table_name)
        self.mock_table.search.assert_called_once_with(query_type="fts")
        self.mock_table.search.return_value.where.assert_called_once_with("metadata.key = 'value'")
        self.mock_table.search.return_value.where.return_value.limit.assert_called_once_with(2)
        self.assertEqual(result, records)

    def test_delete_by_metadata(self):
        # Setup mock return for delete_by_metadata
        self.mock_table.delete.return_value = True

        result = self.mem.delete_by_metadata("key", "value")
        self.mock_client.open_table.assert_called_once_with(self.mem.table_name)
        self.mock_table.delete.assert_called_once_with("metadata.key = 'value'")
        self.assertTrue(result)

    def test_drop_table(self):
        # Setup mock return for drop
        self.mock_client.delete_table.return_value = True

        result = self.mem.drop()
        self.mock_client.delete_table.assert_called_once_with(self.mem.table_name)
        self.assertTrue(result)


