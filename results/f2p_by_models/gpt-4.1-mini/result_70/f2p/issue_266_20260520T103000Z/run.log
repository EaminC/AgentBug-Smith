[32mimport unittest
from unittest.mock import MagicMock, patch
from typing import List

from mle.utils.memory import LanceDBMemory


class TestLanceDBMemoryManageAPI(unittest.TestCase):
    def setUp(self):
        # Patch the LanceDBMemory client and table to avoid real DB calls
        # Patch the 'client' attribute on LanceDBMemory instance to a mock
        self.patcher_client_open_table = patch('mle.utils.memory.LanceDBMemory.client')
        self.mock_client = MagicMock()
        self.patcher_client_open_table.start()
        # Instead of patching the entire client class (which does not exist as Client),
        # we patch the instance attribute directly after instantiation.

        # Create LanceDBMemory instance with dummy client attribute
        self.memory = LanceDBMemory()
        self.memory.client = self.mock_client
        self.memory.table_name = "test_table"

        # Setup a mock table object
        self.mock_table = MagicMock()
        self.mock_client.open_table.return_value = self.mock_table

        # Reset mocks before each test
        self.mock_client.reset_mock()
        self.mock_table.reset_mock()

    def tearDown(self):
        patch.stopall()

    def test_add_and_list_all_keys(self):
        # Setup mock return for list_all_keys
        # The .search(query_type="fts").to_list() chain returns list of dicts with "id" keys
        self.mock_table.search.return_value.to_list.return_value = [
            {"id": "id1"}, {"id": "id2"}, {"id": "id3"}
        ]

        keys = self.memory.list_all_keys()
        self.mock_client.open_table.assert_called_once_with("test_table")
        self.mock_table.search.assert_called_once_with(query_type="fts")
        self.mock_table.search.return_value.to_list.assert_called_once()
        self.assertEqual(keys, ["id1", "id2", "id3"])

    def test_get_existing_record(self):
        # Setup mock return for get with existing record
        record_id = "id123"
        expected_record = [{"id": record_id, "data": "some data"}]
        # The chain: search(query_type="fts").where(...).limit(1).to_list()
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = expected_record

        result = self.memory.get(record_id)
        self.mock_client.open_table.assert_called_once_with("test_table")
        self.mock_table.search.assert_called_once_with(query_type="fts")
        self.mock_table.search.return_value.where.assert_called_once_with(f"id = '{record_id}'")
        self.mock_table.search.return_value.where.return_value.limit.assert_called_once_with(1)
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.assert_called_once()
        self.assertEqual(result, expected_record)

    def test_get_nonexistent_record(self):
        # Setup mock return for get with no record found
        record_id = "nonexistent"
        expected_record = []
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = expected_record

        result = self.memory.get(record_id)
        self.assertEqual(result, expected_record)

    def test_get_by_metadata(self):
        # Setup mock return for get_by_metadata
        key = "category"
        value = "test"
        expected_records = [
            {"id": "id1", "metadata": {key: value}},
            {"id": "id2", "metadata": {key: value}},
        ]
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = expected_records

        results = self.memory.get_by_metadata(key, value, n_results=2)
        self.mock_client.open_table.assert_called_once_with("test_table")
        self.mock_table.search.assert_called_once_with(query_type="fts")
        self.mock_table.search.return_value.where.assert_called_once_with(f"metadata.{key} = '{value}'")
        self.mock_table.search.return_value.where.return_value.limit.assert_called_once_with(2)
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.assert_called_once()
        self.assertEqual(results, expected_records)

    def test_delete_by_metadata(self):
        key = "tag"
        value = "delete_me"
        # Setup mock return for delete_by_metadata
        self.mock_table.delete.return_value = True

        result = self.memory.delete_by_metadata(key, value)
        self.mock_client.open_table.assert_called_once_with("test_table")
        self.mock_table.delete.assert_called_once_with(f"metadata.{key} = '{value}'")
        self.assertTrue(result)

    def test_drop_table(self):
        # Setup mock return for drop
        self.mock_client.drop_table.return_value = True

        result = self.memory.drop()
        self.mock_client.drop_table.assert_called_once_with("test_table")
        self.assertTrue(result)


if __name__ == "__main__":
    unittest.main()[0m
