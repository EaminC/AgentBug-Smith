        self.mock_client.open_table.assert_called_with(self.mem.table_name)
        self.mock_table.search.assert_called_with(query_type="fts")
        self.assertEqual(keys, ["id1", "id2", "id3"])

    def test_get_existing_record(self):
        # Setup mock table.search().where().limit().to_list() to return a single record
        record = {"id": "id1", "metadata": {"key": "value"}, "data": "some data"}
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = [record]

        result = self.mem.get("id1")
        self.mock_client.open_table.assert_called_with(self.mem.table_name)
        self.mock_table.search.assert_called_with(query_type="fts")
        self.mock_table.search.return_value.where.assert_called_with("id = 'id1'")
        self.assertEqual(result, [record])

    def test_get_nonexistent_record(self):
        # Setup mock to return empty list for non-existent record
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = []

        result = self.mem.get("nonexistent_id")
        self.assertEqual(result, [])

    def test_get_by_metadata(self):
        # Setup mock table.search().where().limit().to_list() to return multiple records
        records = [
            {"id": "id1", "metadata": {"category": "test"}, "data": "data1"},
            {"id": "id2", "metadata": {"category": "test"}, "data": "data2"},
        ]
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = records

        result = self.mem.get_by_metadata("category", "test", n_results=2)
        self.mock_client.open_table.assert_called_with(self.mem.table_name)
        self.mock_table.search.assert_called_with(query_type="fts")
        self.mock_table.search.return_value.where.assert_called_with("metadata.category = 'test'")
        self.assertEqual(result, records)

    def test_delete_by_metadata(self):
        # Setup mock table.delete to return True
        self.mock_table.delete.return_value = True

        result = self.mem.delete_by_metadata("category", "test")
        self.mock_client.open_table.assert_called_with(self.mem.table_name)
        self.mock_table.delete.assert_called_with("metadata.category = 'test'")
        self.assertTrue(result)

    def test_drop_table(self):
        # Setup mock client.delete_collection to return True
        self.mock_client.delete_collection.return_value = True

        result = self.mem.drop()
        self.mock_client.delete_collection.assert_called_with(name=self.mem.table_name)
        self.assertTrue(result)


