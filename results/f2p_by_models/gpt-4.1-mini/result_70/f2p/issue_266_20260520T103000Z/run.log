from unittest.mock import MagicMock, patch
from typing import List

from mle.utils.memory import LanceDBMemory


class TestLanceDBMemoryManageAPI(unittest.TestCase):
    def setUp(self):
        # Patch the LanceDBMemory client and table to isolate tests from actual DB
        self.patcher_client = patch('mle.utils.memory.lancedb.connect')
        self.mock_connect = self.patcher_client.start()
        self.mock_client = MagicMock()
        self.mock_connect.return_value = self.mock_client

        self.mock_table = MagicMock()
        self.mock_client.open_table.return_value = self.mock_table

        # Instantiate LanceDBMemory with mocked client
        self.mem = LanceDBMemory()
        self.mem.client = self.mock_client
        self.mem.table_name = "memory"

    def tearDown(self):
        self.patcher_client.stop()

    def test_add_and_list_all_keys(self):
        # Setup the table.search().to_list() to return list of dicts with id keys
        self.mock_table.search.return_value.to_list.return_value = [
            {"id": "id1", "metadata": {"key": "value"}},
            {"id": "id2", "metadata": {"key": "value2"}},
        ]

        keys = self.mem.list_all_keys()
        self.mock_client.open_table.assert_called_with(self.mem.table_name)
        self.mock_table.search.assert_called_with(query_type="fts")
        self.assertEqual(keys, ["id1", "id2"])

    def test_get_existing_record(self):
        record_id = "id1"
        expected_record = [{"id": record_id, "metadata": {"key": "value"}}]
        # Setup chained calls for get
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = expected_record

        result = self.mem.get(record_id)
        self.mock_client.open_table.assert_called_with(self.mem.table_name)
        self.mock_table.search.assert_called_with(query_type="fts")
        self.mock_table.search.return_value.where.assert_called_with(f"id = '{record_id}'")
        self.assertEqual(result, expected_record)

    def test_get_nonexistent_record(self):
        record_id = "nonexistent"
        # Setup chained calls for get returning empty list
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = []

        result = self.mem.get(record_id)
        self.assertEqual(result, [])

    def test_get_by_metadata(self):
        key = "category"
        value = "test"
        expected_records = [
            {"id": "id1", "metadata": {key: value}},
            {"id": "id2", "metadata": {key: value}},
        ]
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = expected_records

        results = self.mem.get_by_metadata(key, value, n_results=2)
        self.mock_client.open_table.assert_called_with(self.mem.table_name)
        self.mock_table.search.assert_called_with(query_type="fts")
        self.mock_table.search.return_value.where.assert_called_with(f"metadata.{key} = '{value}'")
        self.assertEqual(results, expected_records)

    def test_delete_by_metadata(self):
        key = "category"
        value = "test"
        self.mock_table.delete.return_value = True

        result = self.mem.delete_by_metadata(key, value)
        self.mock_client.open_table.assert_called_with(self.mem.table_name)
        self.mock_table.delete.assert_called_with(f"metadata.{key} = '{value}'")
        self.assertTrue(result)

    def test_drop_table(self):
        self.mock_client.delete_table.return_value = True

        result = self.mem.drop()
        self.mock_client.delete_table.assert_called_with(self.mem.table_name)
        self.assertTrue(result)


