from unittest.mock import patch, MagicMock
from mle.utils.memory import LanceDBMemory


class TestLanceDBMemoryManageAPI(unittest.TestCase):
    def setUp(self):
        # Patch lancedb.connect to avoid real DB connection
        self.patcher_connect = patch('mle.utils.memory.lancedb.connect')
        self.mock_connect = self.patcher_connect.start()
        self.mock_client = MagicMock()
        self.mock_connect.return_value = self.mock_client

        # Patch get_config to return a dummy config dict to avoid NotImplementedError
        self.patcher_get_config = patch('mle.utils.memory.get_config', return_value={"platform": "OpenAI", "api_key": "dummy"})
        self.mock_get_config = self.patcher_get_config.start()

        # Patch get_registry to avoid real embedding creation
        self.patcher_get_registry = patch('mle.utils.memory.get_registry')
        self.mock_get_registry = self.patcher_get_registry.start()
        mock_registry = MagicMock()
        mock_embedding = MagicMock()
        mock_registry.get.return_value.create.return_value = mock_embedding
        self.mock_get_registry.return_value = mock_registry

        # Setup a mock table object returned by open_table
        self.mock_table = MagicMock()
        self.mock_client.open_table.return_value = self.mock_table

        # Setup a mock table object returned by table_names and create_table
        self.mock_client.table_names.return_value = []
        self.mock_client.create_table.return_value = self.mock_table

        # Instantiate LanceDBMemory with a dummy project_path
        self.mem = LanceDBMemory(project_path="dummy_path")

    def tearDown(self):
        self.patcher_connect.stop()
        self.patcher_get_config.stop()
        self.patcher_get_registry.stop()

    def test_add_and_list_all_keys(self):
        # Prepare mock for add and search
        self.mock_table.search.return_value.to_list.return_value = [
            {"id": "id1"},
            {"id": "id2"},
            {"id": "id3"},
        ]

        # Add data (simulate add calls)
        data = [
            {"id": "id1", "metadata": {"key": "value1"}},
            {"id": "id2", "metadata": {"key": "value2"}},
            {"id": "id3", "metadata": {"key": "value3"}},
        ]
        # Simulate add method on table
        self.mock_table.add = MagicMock()

        # Call add method (should create table and add data)
        self.mem.add(data)

        # Check create_table called because table_names was empty
        self.mock_client.create_table.assert_called_once()

        # Call list_all_keys and verify returned keys
        keys = self.mem.list_all_keys()
        self.mock_client.open_table.assert_called_with(self.mem.table_name)
        self.mock_table.search.assert_called_with(query_type="fts")
        self.assertEqual(keys, ["id1", "id2", "id3"])

    def test_get_existing_record(self):
        # Setup mock return for get with a record found
        record_id = "id1"
        expected_record = [{"id": record_id, "metadata": {"key": "value1"}}]
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = expected_record

        result = self.mem.get(record_id)
        self.mock_client.open_table.assert_called_with(self.mem.table_name)
        self.mock_table.search.assert_called_with(query_type="fts")
        self.mock_table.search.return_value.where.assert_called_with(f"id = '{record_id}'")
        self.assertEqual(result, expected_record)

    def test_get_nonexistent_record(self):
        # Setup mock return for get with no record found
        record_id = "nonexistent"
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = []

        result = self.mem.get(record_id)
        self.assertEqual(result, [])

    def test_get_by_metadata(self):
        # Setup mock return for get_by_metadata
        key = "category"
        value = "test"
        expected_records = [
            {"id": "id1", "metadata": {key: value}},
            {"id": "id2", "metadata": {key: value}},
        ]
        self.mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = expected_records

        results = self.mem.get_by_metadata(key, value, n_results=2)
        self.mock_client.open_table.assert_called_with(self.mem.table_name)
        self.mock_table.search.assert_called_with(query_type="fts")
        self.mock_table.search.return_value.where.assert_called_with(f"metadata.{key} = '{value}'")
