      npm ci; \
    elif [ -f "yarn.lock" ]; then \
      npm install -g yarn && yarn install; \
    elif [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm && pnpm install; \
    else \
      npm install; \
    fi

# Build the project if a build script exists
RUN if npm run | grep -q 'build'; then npm run build || true; fi

# Ensure test tooling is installed
RUN npm install --no-save jest mocha || true

# Preflight test to verify jest
RUN node -e "require('jest'); console.log('preflight ok')" || true

CMD ["/bin/bash"]

