[32mFROM python:3.9-slim

# Set working directory
WORKDIR /app

# Set environment variables required by Forge
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=${FORGE_API_KEY} \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Copy entire repo
COPY . .

# Detect if src layout or tests import src., then install accordingly with test dependencies
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -f "requirements.txt" ]; then \
        # requirements.txt exists, use pip with editable install if no src layout; else only requirements; install test deps always; \
        if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
            pip install -r requirements.txt; \
            pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
        else \
            pip install -r requirements.txt; \
            pip install -e .; \
            pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
        fi; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry; \
        poetry config virtualenvs.create false; \
        poetry install --no-interaction --no-ansi; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    elif [ -f "pyproject.toml" ]; then \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    else \
        # No recognized package manager, install test deps only; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# Set PYTHONPATH if src/ layout or import src. detected to avoid editable install
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        echo "src layout detected, setting PYTHONPATH"; \
        echo "export PYTHONPATH=/app" >> /etc/profile.d/pythonpath.sh; \
    fi

# Preflight check to verify core modules import and pytest import
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests as part of build to ensure test dependencies and setup correct (optional, but recommended)
RUN pytest tests/ --doctest-modules --cov=./metagpt/ --cov-report=xml:cov.xml --cov-report=html:htmlcov --durations=20

# Multi-stage build: second stage for minimal runtime image
FROM python:3.9-slim AS runtime

WORKDIR /app

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=${FORGE_API_KEY} \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

COPY --from=0 /app /app

# Install only production dependencies without test packages
RUN set -eux; \
