# --- end inject ---

# Set working directory
WORKDIR /app

# Copy entire repository into container
COPY . .

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Install Node.js dependencies and build the project
RUN npm install && npm run build

# Install test tooling without saving to package.json
RUN npm install --no-save jest mocha @types/jest @types/node

# Verify test tooling installed
RUN node -e "require('jest'); console.log('preflight ok')"

# Final command to open bash
CMD ["/bin/bash"]

