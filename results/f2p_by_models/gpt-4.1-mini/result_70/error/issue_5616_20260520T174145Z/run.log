    ZEROONE_API_KEY="" ZEROONE_MODEL_LIST="" \
    ZHIPU_API_KEY="" ZHIPU_MODEL_LIST=""

USER nextjs

EXPOSE 3210/tcp

ENTRYPOINT ["/bin/node"]

CMD ["/app/startServer.js"][0m
