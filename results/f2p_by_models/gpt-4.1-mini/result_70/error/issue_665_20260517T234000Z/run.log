# Install system dependencies needed for common Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libsqlite3-dev \
    libbz2-1.0 \
    liblzma5 \
    libtk8.6 \
    libx11-6 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies, project package, and required test tooling, including langchain
RUN if [ -f requirements.txt ]; then pip install -r requirements.txt; fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm langchain

# Verify essential packages load without error
RUN python -c "import pkg_resources, pytest, litellm, langchain; print('preflight ok')"

CMD ["/bin/bash"]

