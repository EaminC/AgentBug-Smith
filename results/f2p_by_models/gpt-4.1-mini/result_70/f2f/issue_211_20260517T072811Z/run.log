    # and then abort after api_key check

    # Patch questionary.select.ask to return DeepSeek
    monkeypatch.setattr(cli.questionary.select, "ask", lambda self: "DeepSeek")

    # Instead of calling cli.new fully, we call the function and catch early return
    # But cli.new is a click command, so we call it with a dummy name and catch SystemExit

    # We just want to verify DeepSeek is in choices
    # So call cli.new and catch SystemExit

    # Actually cli.new is a click command, so call with runner
    from click.testing import CliRunner

    runner = CliRunner()
    result = runner.invoke(cli.new, ["dummy_project_name"], input="dummy_api_key\n")

    assert "DeepSeek" in choices_captured.get("choices", [])


