import json
import types
import pytest
from unittest.mock import patch, MagicMock

import mle.cli as cli
import mle.model as model_module


def test_deepseek_model_init_and_attributes():
    # Patch importlib to simulate openai module presence
    import importlib.util

    class DummyOpenAIClient:
        def __init__(self, api_key, base_url):
            self.api_key = api_key
            self.base_url = base_url
            self.chat = MagicMock()

    dummy_openai_module = types.SimpleNamespace(OpenAI=DummyOpenAIClient)

    original_find_spec = importlib.util.find_spec
    original_import_module = model_module.importlib.import_module if hasattr(model_module.importlib, "import_module") else None

    importlib.util.find_spec = lambda name: True if name == "openai" else None
    model_module.importlib.import_module = lambda name: dummy_openai_module

    try:
        api_key = "dummy_key"
        model_name = "deepseek-coder-v1"
        ds_model = model_module.DeepSeekModel(api_key=api_key, model=model_name, temperature=0.5)

        assert ds_model.api_key == api_key if hasattr(ds_model, "api_key") else True
        assert ds_model.model == model_name
        assert ds_model.temperature == 0.5
        assert ds_model.model_type == model_module.MODEL_DEEPSEEK
        assert hasattr(ds_model, "client")
        assert isinstance(ds_model.client, DummyOpenAIClient)
    finally:
        importlib.util.find_spec = original_find_spec
        if original_import_module:
            model_module.importlib.import_module = original_import_module


