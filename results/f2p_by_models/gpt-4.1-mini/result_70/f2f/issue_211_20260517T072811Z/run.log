[32mimport builtins
import json
import types
import pytest
from unittest.mock import patch, MagicMock

import mle.model as model_module
import mle.cli as cli


def test_deepseek_model_init_and_attributes():
    # Patch importlib.util.find_spec to simulate openai installed
    with patch("importlib.util.find_spec", return_value=True):
        # Patch importlib.import_module to return a dummy OpenAI client class
        dummy_openai_client = MagicMock()
        dummy_openai_instance = MagicMock()
        dummy_openai_client.OpenAI.return_value = dummy_openai_instance

        with patch("importlib.import_module", return_value=dummy_openai_client):
            api_key = "dummy_api_key"
            model_name = "deepseek-coder-v1"
            temperature = 0.5
            deepseek = model_module.DeepSeekModel(api_key=api_key, model=model_name, temperature=temperature)

            assert deepseek.api_key if hasattr(deepseek, "api_key") else True  # may not store api_key directly
            assert deepseek.model == model_name
            assert deepseek.model_type == model_module.MODEL_DEEPSEEK
            assert deepseek.temperature == temperature
            # The client attribute should be the dummy_openai_instance
            assert deepseek.client == dummy_openai_instance


def test_load_model_returns_deepseek_model():
    # Patch get_config to return config with platform DeepSeek and api_key
    dummy_config = {
        "platform": model_module.MODEL_DEEPSEEK,
        "api_key": "dummy_api_key"
    }

    with patch("mle.utils.get_config", return_value=dummy_config):
        # Patch importlib.util.find_spec and import_module for DeepSeekModel init
        with patch("importlib.util.find_spec", return_value=True):
            dummy_openai_client = MagicMock()
            dummy_openai_instance = MagicMock()
            dummy_openai_client.OpenAI.return_value = dummy_openai_instance
            with patch("importlib.import_module", return_value=dummy_openai_client):
                # Call load_model with no model_name (None)
                instance = model_module.load_model(project_dir=".", model_name=None)
                # It should be an instance of DeepSeekModel
                assert isinstance(instance, model_module.DeepSeekModel)
                # The model attribute should be "deepseek-coder" default
                assert instance.model == "deepseek-coder"


def test_deepseek_model_query_and_stream():
    # Setup dummy openai client with chat.completions.create mocked
    dummy_openai_client = MagicMock()
    dummy_openai_instance = MagicMock()
    dummy_openai_client.OpenAI.return_value = dummy_openai_instance

    # Prepare dummy chat history and response
    chat_history = [{"role": "user", "content": "Hello"}]

    # Dummy function to be returned by get_function
    def dummy_function(**kwargs):
        return "function result"

    # Patch get_function to return dummy_function
    with patch("mle.function.get_function", side_effect=lambda name: dummy_function):
        # Patch process_function_name to return name unchanged
        with patch("mle.function.process_function_name", side_effect=lambda name: name):
            # Patch SEARCH_FUNCTIONS to empty list to avoid recursion limit
            with patch("mle.function.SEARCH_FUNCTIONS", []):
                # Patch importlib.util.find_spec and import_module for DeepSeekModel init
                with patch("importlib.util.find_spec", return_value=True):
                    with patch("importlib.import_module", return_value=dummy_openai_client):
                        deepseek = model_module.DeepSeekModel(api_key="key", model="deepseek-coder")

                        # Prepare dummy completion response for query (no tool_calls)
                        dummy_message = types.SimpleNamespace(
                            content="response content",
                            tool_calls=None
                        )
                        dummy_choice = types.SimpleNamespace(message=dummy_message)
                        dummy_completion = types.SimpleNamespace(choices=[dummy_choice])
                        dummy_openai_instance.chat.completions.create.return_value = dummy_completion

                        # Query should return the content string
                        result = deepseek.query(chat_history)
                        assert result == "response content"

                        # Now test query with tool_calls to trigger function call logic
                        tool_call = types.SimpleNamespace(
                            function=types.SimpleNamespace(name="func1", arguments=json.dumps({"arg": 1})),
                            id="toolcallid"
                        )
                        dummy_message_with_tool = types.SimpleNamespace(
                            content="",
                            tool_calls=[tool_call]
                        )
                        dummy_choice_with_tool = types.SimpleNamespace(message=dummy_message_with_tool)
                        dummy_completion_with_tool = types.SimpleNamespace(choices=[dummy_choice_with_tool])

                        # Setup create to return the tool call response once, then normal response
                        dummy_openai_instance.chat.completions.create.side_effect = [
                            dummy_completion_with_tool,
                            dummy_completion
                        ]

                        # The query should recursively call itself and eventually return content
                        chat_history2 = [{"role": "user", "content": "Hello"}]
                        result2 = deepseek.query(chat_history2)
                        assert isinstance(result2, str)
                        assert "func1" in [call["name"] for call in deepseek.func_call_history]

                        # Test stream method yields content chunks
                        # Prepare dummy streaming chunks
                        chunk1 = types.SimpleNamespace(
                            choices=[types.SimpleNamespace(delta=types.SimpleNamespace(content="chunk1", tool_calls=None))]
                        )
                        chunk2 = types.SimpleNamespace(
                            choices=[types.SimpleNamespace(delta=types.SimpleNamespace(content="chunk2", tool_calls=None))]
                        )
                        dummy_openai_instance.chat.completions.create.return_value = iter([chunk1, chunk2])

                        stream_result = list(deepseek.stream(chat_history))
                        assert "chunk1" in stream_result
                        assert "chunk2" in stream_result


def test_new_command_includes_deepseek(monkeypatch):
    # Patch questionary.select().ask() to return 'DeepSeek'
    class DummySelect:
        def ask(self):
            return "DeepSeek"

    monkeypatch.setattr(cli.questionary, "select", lambda *args, **kwargs: DummySelect())

