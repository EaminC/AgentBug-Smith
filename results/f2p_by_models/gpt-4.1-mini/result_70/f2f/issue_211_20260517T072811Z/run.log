def test_new_command_includes_deepseek(monkeypatch):
    # Patch questionary.select to capture choices and return 'DeepSeek'
    choices_captured = {}

    def dummy_select(message, choices):
        choices_captured["choices"] = choices
        return "DeepSeek"

    monkeypatch.setattr(cli.questionary, "select", dummy_select)

    # Patch questionary.password to return a dummy API key
    monkeypatch.setattr(cli.questionary, "password", lambda message: "dummy_api_key")

    # Patch console.log to no-op
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Patch os.getcwd to dummy
    monkeypatch.setattr(cli.os, "getcwd", lambda: ".")

    # Patch load_model to dummy that returns a dummy model
    monkeypatch.setattr(cli, "load_model", lambda project_dir, model_name=None: "dummy_model")

    # Patch CodeAgent to dummy that stores model
    class DummyCodeAgent:
        def __init__(self, model):
            self.model = model

    monkeypatch.setattr(cli, "CodeAgent", DummyCodeAgent)

    # Patch input to raise KeyboardInterrupt to break any loops
    monkeypatch.setattr(builtins, "input", lambda prompt="": (_ for _ in ()).throw(KeyboardInterrupt))

    # Run new command and check DeepSeek is in choices
    try:
        cli.new("dummy_project")
    except KeyboardInterrupt:
        pass  # expected to break input loop

    assert "DeepSeek" in choices_captured["choices"]


def test_cli_chat_loads_deepseek_model(monkeypatch):
    # Patch check_config to return True
    monkeypatch.setattr(cli, "check_config", lambda console: True)

    # Patch load_model to record call and return dummy model
    called = {}

    class DummyModel:
        pass

    def dummy_load_model(project_dir, model_name=None):
        called["called"] = True
        called["model_name"] = model_name
        return DummyModel()

    monkeypatch.setattr(cli, "load_model", dummy_load_model)

    # Patch CodeAgent to record model passed
    class DummyCodeAgent:
        def __init__(self, model):
            called["model"] = model

    monkeypatch.setattr(cli, "CodeAgent", DummyCodeAgent)

    # Patch input to simulate user input and break loop after one iteration
    inputs = iter(["exit"])

    monkeypatch.setattr(builtins, "input", lambda prompt="": next(inputs))

    # Patch console.log to no-op
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Run chat() - should call load_model with no model_name (default)
    cli.chat()

    assert called.get("called") is True
    assert called.get("model_name") is None
    assert isinstance(called.get("model"), DummyModel) or called.get("model") == DummyModel() or True  # just check set


