            self.api_key = api_key
            self.base_url = base_url
            self.chat = MagicMock()
            self.chat.completions = MagicMock()

    monkeypatch.setattr(model.importlib, "import_module", lambda name: MagicMock(OpenAI=DummyOpenAIClient))

    deepseek_model = model.load_model("some_dir", "deepseek-coder")
    assert isinstance(deepseek_model, model.DeepSeekModel)
    assert deepseek_model.model == "deepseek-coder"
    assert deepseek_model.temperature == 0.7
    assert deepseek_model.model_type == model.MODEL_DEEPSEEK
    assert deepseek_model.client.api_key == "dummy_key"
    assert deepseek_model.client.base_url == "https://api.deepseek.com/beta"

@pytest.mark.parametrize("model_name", ["deepseek-coder", None])
def test_deepseek_model_query_and_stream(monkeypatch, model_name):
    # Setup dummy DeepSeekModel with mocked client
    monkeypatch.setattr(model.importlib.util, "find_spec", lambda name: True)
    monkeypatch.setattr(model.importlib, "import_module", lambda name: MagicMock(OpenAI=MagicMock()))

    deepseek = model.DeepSeekModel(api_key="key", model=model_name)

    # Mock get_function to a dummy function that returns a fixed string
    monkeypatch.setattr(model, "get_function", lambda name: lambda **kwargs: "function_result")
    monkeypatch.setattr(model, "process_function_name", lambda name: name)

    # Prepare chat_history and dummy function call data
    chat_history = [{"role": "user", "content": "Hello"}]

    # Prepare dummy completion response with no tool calls
    dummy_response = MagicMock()
    dummy_response.choices = [MagicMock()]
    dummy_response.choices[0].message = MagicMock()
    dummy_response.choices[0].message.tool_calls = None
    dummy_response.choices[0].message.content = "response content"

    # Patch client.chat.completions.create to return dummy_response for query
    deepseek.client.chat.completions.create = MagicMock(return_value=dummy_response)

    # Test query returns content string when no tool calls
    result = deepseek.query(chat_history)
    assert result == "response content"

    # Now test query with tool_calls triggering recursive calls
    # Setup tool call structure
    tool_call = MagicMock()
    tool_call.function.name = "test_func"
    tool_call.function.arguments = json.dumps({"arg1": "val1"})
    tool_call.id = "call_id_123"

    dummy_response.choices[0].message.tool_calls = [tool_call]
    dummy_response.choices[0].message.content = ""

    # Patch client.chat.completions.create to return dummy_response first, then a no tool call response
    def side_effect(*args, **kwargs):
        # On first call return tool call response, on second call no tool calls
        if not hasattr(side_effect, "called"):
            side_effect.called = True
            return dummy_response
        else:
            no_tool_response = MagicMock()
            no_tool_response.choices = [MagicMock()]
            no_tool_response.choices[0].message = MagicMock()
            no_tool_response.choices[0].message.tool_calls = None
            no_tool_response.choices[0].message.content = "final content"
            return no_tool_response

    deepseek.client.chat.completions.create = MagicMock(side_effect=side_effect)

    chat_history2 = [{"role": "user", "content": "Hello"}]
    result2 = deepseek.query(chat_history2)
    assert result2 == "final content"
    # The function call history should contain the function call
    assert any(call["name"] == "test_func" for call in deepseek.func_call_history)

    # Test stream yields content chunks
    # Setup dummy chunks generator
    class DummyChunk:
        def __init__(self, content=None, tool_calls=None):
            self.choices = [MagicMock()]
            self.choices[0].delta = MagicMock()
            self.choices[0].delta.content = content
            self.choices[0].delta.tool_calls = tool_calls

    # No tool calls, yields content
    chunks = [DummyChunk(content="chunk1"), DummyChunk(content="chunk2")]
    deepseek.client.chat.completions.create = MagicMock(return_value=iter(chunks))
    chat_history3 = [{"role": "user", "content": "Hello"}]
    output = list(deepseek.stream(chat_history3))
    assert output == ["chunk1", "chunk2"]

