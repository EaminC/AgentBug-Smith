def test_deepseek_model_init_and_attributes():
    m = DummyDeepSeekModel(api_key="dummykey", model="deepseek-test", temperature=0.5)
    assert m.model == "deepseek-test"
    assert m.model_type == model.MODEL_DEEPSEEK
    assert m.temperature == 0.5
    assert hasattr(m, "client")
    assert hasattr(m, "func_call_history")


def test_load_model_returns_deepseek_model(monkeypatch):
    # Patch get_config to return config with platform DeepSeek
    monkeypatch.setattr(model, "get_config", lambda project_dir: {
        "platform": model.MODEL_DEEPSEEK,
        "api_key": "dummykey"
    })

    # Patch DeepSeekModel to DummyDeepSeekModel to avoid real imports
    monkeypatch.setattr(model, "DeepSeekModel", DummyDeepSeekModel)

    m = model.load_model(project_dir=".", model_name="deepseek-test")
    assert isinstance(m, DummyDeepSeekModel)
    assert m.model == "deepseek-test"


def test_deepseek_model_query_and_stream(monkeypatch):
    m = DummyDeepSeekModel(api_key="dummykey", model="deepseek-coder")

    # Test query returns expected dummy response
    chat_history = [{"role": "user", "content": "Hello"}]
    response = m.query(chat_history)
    assert response == "dummy response"

    # Test stream yields expected dummy chunks
    streamed = list(m.stream(chat_history))
    assert "streamed chunk" in streamed


