class DummyOpenAIChatCompletion:
    def __init__(self, messages, model, temperature, stream, tools=None, **kwargs):
        self.messages = messages
        self.model = model
        self.temperature = temperature
        self.stream = stream
        self.tools = tools
        self.kwargs = kwargs
        self._yielded = False

    def __iter__(self):
        # For streaming: yield one chunk then stop
        if self.stream:
            if not self._yielded:
                self._yielded = True
                # Yield a chunk with no tool_calls and some content
                chunk = types.SimpleNamespace(
                    choices=[types.SimpleNamespace(delta=types.SimpleNamespace(
                        content="streamed response"
                    ))]
                )
                yield chunk
            return
        else:
            # Non-streaming: yield a single completion with no tool_calls
            resp_message = types.SimpleNamespace(
                content="response content",
                tool_calls=None
            )
            completion = types.SimpleNamespace(
                choices=[types.SimpleNamespace(message=resp_message)]
            )
            yield completion


