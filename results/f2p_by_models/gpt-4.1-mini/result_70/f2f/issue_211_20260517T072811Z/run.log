    # Patch console.log to no-op
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Patch return values to test the new() function does not abort
    # We only test that it completes without returning None prematurely
    result = cli.new("testname")
    # new() returns None on abort or after completion, so just check no exceptions raised


