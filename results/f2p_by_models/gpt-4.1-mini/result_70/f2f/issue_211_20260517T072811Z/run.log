[32mimport builtins
import json
import types
import pytest
from unittest.mock import MagicMock, patch

import mle.model as model_module
import mle.cli as cli


class DummyOpenAIChatCompletion:
    def __init__(self, responses):
        self._responses = responses
        self._index = 0

    def create(self, **kwargs):
        # Return the next response in the list or the last one repeatedly
        if self._index < len(self._responses):
            resp = self._responses[self._index]
            self._index += 1
        else:
            resp = self._responses[-1]
        return resp


class DummyOpenAIClient:
    def __init__(self, responses):
        self.chat = types.SimpleNamespace(
            completions=DummyOpenAIChatCompletion(responses)
        )


def make_tool_call(function_name, arguments, call_id="call-1"):
    return types.SimpleNamespace(
        function=types.SimpleNamespace(name=function_name, arguments=json.dumps(arguments)),
        id=call_id,
    )


def make_message_with_tool_call(content, tool_calls):
    return types.SimpleNamespace(
        content=content,
        tool_calls=tool_calls,
    )


def make_choice(message, delta=None):
    # delta can have tool_calls attribute or content attribute for streaming
    return types.SimpleNamespace(message=message, delta=delta)


def make_stream_chunk(content=None, tool_calls=None):
    # For streaming, delta is an object with either content or tool_calls attribute
    delta = types.SimpleNamespace()
    if tool_calls is not None:
        delta.tool_calls = tool_calls
    else:
        delta.content = content
    return types.SimpleNamespace(choices=[make_choice(None, delta=delta)])


def make_sync_chunk(content):
    # For synchronous completions, choices[0].message is the response
    return types.SimpleNamespace(choices=[make_choice(content)])


def test_deepseek_model_init_and_attributes():
    # Patch importlib.util.find_spec to simulate openai installed
    with patch("importlib.util.find_spec", return_value=True):
        with patch("importlib.import_module") as import_mod:
            dummy_openai_class = MagicMock()
            import_mod.return_value = types.SimpleNamespace(OpenAI=lambda **kwargs: "client-instance")
            # Patch openai.OpenAI to return a dummy client string
            ds_model = model_module.DeepSeekModel(api_key="dummykey", model="deepseek-test", temperature=0.5)

            assert ds_model.model == "deepseek-test"
            assert ds_model.model_type == model_module.MODEL_DEEPSEEK
            assert ds_model.temperature == 0.5
            assert ds_model.client == "client-instance"
            assert isinstance(ds_model.func_call_history, list)
            assert ds_model.func_call_history == []


def test_load_model_returns_deepseek_model():
    # Patch get_config to return DeepSeek platform and api_key
    with patch("mle.utils.get_config", return_value={"platform": model_module.MODEL_DEEPSEEK, "api_key": "key"}):
        # Patch DeepSeekModel to a dummy class to detect instantiation
        called = {}

        class DummyDSModel:
            def __init__(self, api_key, model):
                called["api_key"] = api_key
                called["model"] = model

        with patch.object(model_module, "DeepSeekModel", DummyDSModel):
            m = model_module.load_model("some_dir", "modelname")
            assert isinstance(m, DummyDSModel)
            assert called["api_key"] == "key"
            assert called["model"] == "modelname"


def test_deepseek_model_query_and_stream():
    # Prepare dummy responses for query
    # The first response includes a tool call, the second is a normal content response
    tool_call = make_tool_call("search", {"query": "test"})
    resp_with_tool_call = make_message_with_tool_call(
        content="",
        tool_calls=[tool_call]
    )
    resp_without_tool_call = make_message_with_tool_call(
        content="final answer",
        tool_calls=None
    )
    dummy_client = DummyOpenAIClient([resp_with_tool_call, resp_without_tool_call])

    # Patch importlib to simulate openai installed and import_module returns dummy openai class
    with patch("importlib.util.find_spec", return_value=True):
        with patch("importlib.import_module") as import_mod:
            dummy_openai_class = MagicMock()
            dummy_openai_class.return_value = dummy_client
            import_mod.return_value = types.SimpleNamespace(OpenAI=dummy_openai_class)

            # Patch get_function to a dummy that returns a fixed string for "search"
            with patch("mle.function.get_function", return_value=lambda query: "search-result"):
                ds_model = model_module.DeepSeekModel(api_key="key", model="modelname")

                chat_history = [{"role": "user", "content": "hello"}]
                # The query should recursively call itself once and then return final answer
                result = ds_model.query(chat_history, functions=[{"name": "search", "parameters": {}}])
                assert result == "final answer"
                # The chat_history should have assistant and tool messages appended
                roles = [msg["role"] for msg in chat_history]
                assert "assistant" in roles
                assert "tool" in roles
                # func_call_history should have recorded the function call
                assert any(call["name"] == "search" for call in ds_model.func_call_history)

                # Test streaming yields content
                # Prepare streaming chunks: first chunk with tool call, then chunk with content
                stream_tool_call = make_tool_call("search", {"query": "streamtest"})
                stream_chunks = [
                    make_stream_chunk(tool_calls=[stream_tool_call]),
                    make_stream_chunk(content="streamed content part 1"),
                    make_stream_chunk(content="streamed content part 2"),
                ]
                dummy_client_stream = DummyOpenAIClient(stream_chunks)
                dummy_openai_class.return_value = dummy_client_stream

                ds_model_stream = model_module.DeepSeekModel(api_key="key", model="modelname")

                # Patch get_function for streaming as well
                with patch("mle.function.get_function", return_value=lambda query: "stream-search-result"):
                    chat_history_stream = [{"role": "user", "content": "hi"}]
                    stream_output = list(ds_model_stream.stream(chat_history_stream))
                    # The output should contain the streamed content parts
                    assert "streamed content part 1" in "".join(stream_output)
                    assert "streamed content part 2" in "".join(stream_output)
                    # The chat_history_stream should have assistant and tool messages appended
                    roles_stream = [msg["role"] for msg in chat_history_stream]
                    assert "assistant" in roles_stream
                    assert "tool" in roles_stream


def test_new_command_includes_deepseek(monkeypatch):
    # Patch questionary.select to capture choices and simulate selection
    choices_captured = {}

    def fake_select(prompt, choices):
        choices_captured["choices"] = choices
        class DummyAnswer:
            def ask(self):
                return "DeepSeek"
        return DummyAnswer()

    monkeypatch.setattr(cli.questionary, "select", fake_select)

    # Patch questionary.password to simulate API key input
    monkeypatch.setattr(cli.questionary, "password", lambda prompt: "dummy-key")

    # Patch console.log to no-op
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Call new() command with a dummy name
    result = cli.new("dummyproject")
    # The choices should include DeepSeek
    assert "DeepSeek" in choices_captured["choices"]


def test_cli_chat_loads_deepseek_model(monkeypatch):
    # Patch cli.check_config to always return True
    monkeypatch.setattr(cli, "check_config", lambda console: True)

    called = {}

    class DummyModel:
        pass

    def dummy_load_model(project_dir, model_name=None):
        called["called"] = True
        called["model_name"] = model_name
        return DummyModel()

    monkeypatch.setattr(cli, "load_model", dummy_load_model)

    class DummyCodeAgent:
        def __init__(self, model):
            called["model"] = model

    monkeypatch.setattr(cli, "CodeAgent", DummyCodeAgent)

    # Patch input to simulate user input and break loop after one iteration
    inputs = iter(["exit"])

    monkeypatch.setattr(builtins, "input", lambda prompt="": next(inputs))

    # Patch console.log to no-op
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Run chat() - should call load_model with no model_name (default)
    # It should not raise and load_model should be called with None model_name
    cli.chat()
    assert called.get("called") is True
    assert called.get("model_name") is None
    assert isinstance(called.get("model"), DummyModel) or called.get("model") is None

# The tests above cover:
# - DeepSeekModel initialization and attributes
# - load_model returns DeepSeekModel when config platform is DeepSeek
# - DeepSeekModel query and stream methods handle tool calls and content correctly
# - cli.new includes DeepSeek in platform choices and asks for API key
# - cli.chat loads model with default parameters and uses CodeAgent

