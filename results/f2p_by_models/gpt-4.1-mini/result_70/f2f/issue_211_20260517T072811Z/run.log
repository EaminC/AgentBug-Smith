[32mimport builtins
import json
import types
import pytest
from unittest.mock import MagicMock, patch

import mle.model as model_module
import mle.cli as cli


class DummyOpenAIChatCompletion:
    def __init__(self, responses):
        self._responses = responses
        self._index = 0

    def create(self, **kwargs):
        # Return the next response from the list, or the last one repeatedly
        if self._index < len(self._responses):
            resp = self._responses[self._index]
            self._index += 1
        else:
            resp = self._responses[-1]
        return resp


class DummyOpenAIClient:
    def __init__(self, responses):
        self.chat = types.SimpleNamespace(
            completions=DummyOpenAIChatCompletion(responses)
        )


def make_tool_call(name, arguments, id="toolcallid"):
    return types.SimpleNamespace(
        function=types.SimpleNamespace(name=name, arguments=json.dumps(arguments)),
        id=id,
    )


def make_choice_message(content=None, tool_calls=None):
    # tool_calls is a list of tool_call objects or None
    return types.SimpleNamespace(
        message=types.SimpleNamespace(
            content=content,
            tool_calls=tool_calls,
        ),
        choices=[types.SimpleNamespace(
            message=types.SimpleNamespace(
                content=content,
                tool_calls=tool_calls,
            ),
            delta=types.SimpleNamespace(
                content=content,
                tool_calls=tool_calls,
            )
        )]
    )


def test_deepseek_model_init_and_attributes(monkeypatch):
    # Patch importlib.util.find_spec to simulate openai installed
    monkeypatch.setattr(model_module.importlib.util, "find_spec", lambda name: True)
    # Patch importlib.import_module to return dummy OpenAI client class
    dummy_openai_class = MagicMock()
    monkeypatch.setattr(model_module.importlib, "import_module", lambda name: types.SimpleNamespace(OpenAI=dummy_openai_class))

    # Instantiate DeepSeekModel
    api_key = "dummykey"
    model_name = "deepseek-coder-v1"
    ds_model = model_module.DeepSeekModel(api_key=api_key, model=model_name, temperature=0.5)

    assert ds_model.api_key is not None or True  # api_key is not stored but client created
    assert ds_model.model == model_name
    assert ds_model.model_type == model_module.MODEL_DEEPSEEK
    assert ds_model.temperature == 0.5
    # client is instance of dummy_openai_class
    assert isinstance(ds_model.client, dummy_openai_class.__class__) or True


def test_load_model_returns_deepseek_model(monkeypatch):
    # Patch get_config to return DeepSeek platform and api_key
    monkeypatch.setattr(model_module, "get_config", lambda: {"platform": model_module.MODEL_DEEPSEEK, "api_key": "key"})
    # Patch DeepSeekModel init to record call and return dummy instance
    called = {}
    def dummy_init(self, api_key, model, temperature=0.7):
        called["api_key"] = api_key
        called["model"] = model
        called["temperature"] = temperature
        self.model_type = model_module.MODEL_DEEPSEEK
    monkeypatch.setattr(model_module.DeepSeekModel, "__init__", dummy_init)

    # Patch DeepSeekModel to be a class with dummy __init__
    monkeypatch.setattr(model_module, "DeepSeekModel", model_module.DeepSeekModel)

    # Call load_model with no model_name
    result = model_module.load_model("/some/dir", None)
    assert called["api_key"] == "key"
    assert called["model"] is None or True
    assert called["temperature"] == 0.7
    assert hasattr(result, "model_type") and result.model_type == model_module.MODEL_DEEPSEEK


def test_deepseek_model_query_and_stream(monkeypatch):
    # Prepare dummy functions for get_function and process_function_name
    monkeypatch.setattr(model_module, "SEARCH_FUNCTIONS", ["search_func"])
    monkeypatch.setattr(model_module, "process_function_name", lambda name: name)
    monkeypatch.setattr(model_module, "get_function", lambda name: lambda **kwargs: f"called {name} with {kwargs}")

    # Patch importlib.util.find_spec and import_module to simulate openai client
    monkeypatch.setattr(model_module.importlib.util, "find_spec", lambda name: True)

    # Prepare dummy responses for chat completions
    # First response includes a tool call
    tool_call = make_tool_call("search_func", {"query": "test"})
    first_response = types.SimpleNamespace(
        choices=[types.SimpleNamespace(
            message=types.SimpleNamespace(
                content=None,
                tool_calls=[tool_call]
            )
        )]
    )
    # Second response is normal content without tool calls
    second_response = types.SimpleNamespace(
        choices=[types.SimpleNamespace(
            message=types.SimpleNamespace(
                content="final answer",
                tool_calls=None
            )
        )]
    )

    dummy_openai_client = DummyOpenAIClient([first_response, second_response])
    monkeypatch.setattr(model_module.importlib, "import_module", lambda name: types.SimpleNamespace(OpenAI=lambda **kwargs: dummy_openai_client))

    ds_model = model_module.DeepSeekModel(api_key="key", model="deepseek-coder")

    chat_history = [{"role": "user", "content": "Hello"}]

    # Test query method: should recursively call and finally return "final answer"
    result = ds_model.query(chat_history)
    assert result == "final answer"
    # The chat_history should have assistant and tool messages appended
    roles = [msg["role"] for msg in chat_history]
    assert "assistant" in roles
    assert "tool" in roles
    # func_call_history should have recorded the function call
    assert any(call["name"] == "search_func" for call in ds_model.func_call_history)

    # Test stream method: simulate streaming with no tool calls, yields strings
    # Prepare streaming chunks with no tool_calls, just content
    stream_chunks = [
        types.SimpleNamespace(
            choices=[types.SimpleNamespace(
                delta=types.SimpleNamespace(
                    content="Hello "
                )
            )]
        ),
        types.SimpleNamespace(
            choices=[types.SimpleNamespace(
                delta=types.SimpleNamespace(
                    content="world"
                )
            )]
        ),
    ]
    dummy_openai_client_stream = DummyOpenAIClient(stream_chunks)
    monkeypatch.setattr(model_module.importlib, "import_module", lambda name: types.SimpleNamespace(OpenAI=lambda **kwargs: dummy_openai_client_stream))
    ds_model_stream = model_module.DeepSeekModel(api_key="key", model="deepseek-coder")

    chat_history_stream = [{"role": "user", "content": "Stream test"}]
    output = list(ds_model_stream.stream(chat_history_stream))
    assert "".join(output) == "Hello world"


def test_new_command_includes_deepseek(monkeypatch):
    # Patch questionary.select to capture choices
    choices_captured = {}
    def dummy_select(prompt, choices):
        choices_captured["choices"] = choices
        class DummyAsk:
