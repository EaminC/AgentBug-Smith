class DummyOpenAIChatCompletion:
    def __init__(self, response_sequence):
        self.response_sequence = response_sequence
        self.index = 0

    def create(self, **kwargs):
        # Return the next response in the sequence or the last one repeatedly
        if self.index < len(self.response_sequence):
            resp = self.response_sequence[self.index]
            self.index += 1
        else:
            resp = self.response_sequence[-1]
        return resp


class DummyOpenAIClient:
    def __init__(self, response_sequence):
        self.chat = types.SimpleNamespace(
            completions=DummyOpenAIChatCompletion(response_sequence)
        )


class DummyToolCall:
    def __init__(self, id_, function_name, arguments):
        self.id = id_
        self.function = types.SimpleNamespace(
            name=function_name,
            arguments=json.dumps(arguments)
        )


class DummyChoiceMessage:
    def __init__(self, content=None, tool_calls=None):
        self.content = content
        self.tool_calls = tool_calls or []


class DummyChoiceDelta:
    def __init__(self, content=None, tool_calls=None):
        self.content = content
        self.tool_calls = tool_calls or []


class DummyChunk:
    def __init__(self, content=None, tool_calls=None):
        self.choices = [types.SimpleNamespace(delta=DummyChoiceDelta(content, tool_calls))]


@pytest.mark.parametrize("model_name", ["deepseek-coder", None])
def test_deepseek_model_query_and_stream(monkeypatch, model_name):
    # Prepare dummy responses for query:
    # First response includes a tool call, second is final content
    tool_call = DummyToolCall(
        id_="toolcall-1",
        function_name="search",
        arguments={"query": "test query"}
    )
    response_with_tool_call = types.SimpleNamespace(
        choices=[types.SimpleNamespace(
            message=DummyChoiceMessage(
                content=None,
                tool_calls=[tool_call]
            )
        )]
    )
    response_final = types.SimpleNamespace(
        choices=[types.SimpleNamespace(
            message=DummyChoiceMessage(
                content="final answer",
                tool_calls=[]
            )
        )]
    )
    # For streaming, yield chunks with tool_calls and then content
    stream_chunks = [
        DummyChunk(content=None, tool_calls=[tool_call]),
        DummyChunk(content="streamed content")
    ]

    # Patch openai.OpenAI to DummyOpenAIClient with controlled responses
    dummy_client = DummyOpenAIClient([response_with_tool_call, response_final])
    monkeypatch.setattr(model_module.importlib.util, "find_spec", lambda dep: True)
    monkeypatch.setattr(model_module.importlib, "import_module", lambda dep: types.SimpleNamespace(OpenAI=lambda **kwargs: dummy_client))

    # Patch get_function to a dummy function that returns a fixed string
    monkeypatch.setattr(model_module, "get_function", lambda name: lambda **kwargs: "tool result")
    # Patch process_function_name to identity
    monkeypatch.setattr(model_module, "process_function_name", lambda name: name)
    # Patch SEARCH_FUNCTIONS to include "search" to test search attempt logic
    monkeypatch.setattr(model_module, "SEARCH_FUNCTIONS", ["search"])

    # Create DeepSeekModel instance
    ds_model = model_module.DeepSeekModel(api_key="dummykey", model=model_name)

    # Test query method returns final content string
    chat_history = [{"role": "user", "content": "Hello"}]
    result = ds_model.query(chat_history)
    assert isinstance(result, str)
    assert "final answer" in result

    # Patch client to yield stream chunks for stream test
    dummy_client_stream = DummyOpenAIClient([])
    dummy_client_stream.chat.completions.create = lambda **kwargs: iter(stream_chunks)
