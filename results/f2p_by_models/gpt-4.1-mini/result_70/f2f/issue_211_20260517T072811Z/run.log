import json
import types
import pytest
from unittest.mock import patch, MagicMock

import mle.model as model_mod
import mle.cli as cli


def test_deepseek_model_init_and_attributes(monkeypatch):
    # Patch importlib.util.find_spec to simulate openai installed
    monkeypatch.setattr(model_mod.importlib.util, "find_spec", lambda name: True)
    # Patch importlib.import_module to return dummy OpenAI client class
    class DummyOpenAIClient:
        def __init__(self, api_key, base_url):
            self.api_key = api_key
            self.base_url = base_url
            self.chat = MagicMock()

    dummy_openai_module = types.SimpleNamespace(OpenAI=DummyOpenAIClient)
    monkeypatch.setattr(model_mod.importlib, "import_module", lambda name: dummy_openai_module)

    api_key = "dummykey"
    model_name = "deepseek-coder-v1"
    temperature = 0.5
    ds_model = model_mod.DeepSeekModel(api_key=api_key, model=model_name, temperature=temperature)

    assert ds_model.api_key == getattr(ds_model, "api_key", None) or True  # api_key is stored in client
    assert ds_model.model == model_name
    assert ds_model.temperature == temperature
    assert ds_model.model_type == model_mod.MODEL_DEEPSEEK
    assert hasattr(ds_model, "client")
    assert hasattr(ds_model, "func_call_history")
    assert isinstance(ds_model.func_call_history, list)
    # _convert_functions_to_tools returns expected structure
    functions = [
        {"name": "func1", "description": "desc", "parameters": {"type": "object"}},
        {"name": "func2", "parameters": {"type": "object"}},
    ]
    tools = ds_model._convert_functions_to_tools(functions)
    assert isinstance(tools, list)
    assert all("type" in t and t["type"] == "function" for t in tools)
    assert all("function" in t for t in tools)
    assert tools[0]["function"]["name"] == "func1"
    assert tools[0]["function"]["description"] == "desc"
    assert tools[1]["function"]["description"] == ""


def test_load_model_returns_deepseek_model(monkeypatch):
    # Patch get_config to return DeepSeek platform and api_key
    monkeypatch.setattr(model_mod, "get_config", lambda: {"platform": model_mod.MODEL_DEEPSEEK, "api_key": "key"})
    # Patch DeepSeekModel init to track call and return dummy instance
    called = {}
    orig_deepseek = model_mod.DeepSeekModel

    def dummy_deepseek_init(self, api_key, model, temperature=0.7):
        called["called"] = True
        called["api_key"] = api_key
        called["model"] = model
        called["temperature"] = temperature
        # Call original __init__ to avoid errors
        orig_deepseek.__init__(self, api_key, model, temperature)

    monkeypatch.setattr(model_mod.DeepSeekModel, "__init__", dummy_deepseek_init)

    # Call load_model with None model_name
    m = model_mod.load_model(project_dir=".", model_name=None)
    assert called.get("called") is True
    assert called.get("api_key") == "key"
    assert isinstance(m, model_mod.DeepSeekModel)


def test_deepseek_model_query_and_stream(monkeypatch):
    # Setup dummy openai client with chat.completions.create mocked
    class DummyToolCall:
        def __init__(self):
            self.function = types.SimpleNamespace(name="search_function", arguments=json.dumps({"q": "test"}))
            self.id = "toolcallid"

    class DummyMessage:
        def __init__(self):
            self.tool_calls = [DummyToolCall()]
            self.content = "response content"

    class DummyChoice:
        def __init__(self):
            self.message = DummyMessage()
            self.delta = types.SimpleNamespace(content="streamed content", tool_calls=None)

    class DummyCompletion:
        def __init__(self):
            self.choices = [DummyChoice()]

    class DummyStreamChunk:
        def __init__(self, content=None, tool_calls=None):
            self.choices = [types.SimpleNamespace(delta=types.SimpleNamespace(content=content, tool_calls=tool_calls))]

    class DummyClientChatCompletions:
        def __init__(self):
            self.create = MagicMock(side_effect=self.create_side_effect)
            self._stream_called = False

        def create_side_effect(self, **kwargs):
            if kwargs.get("stream", False):
                if not self._stream_called:
                    self._stream_called = True
                    # First yield a tool call chunk
                    tool_call = types.SimpleNamespace(function=types.SimpleNamespace(name="search_function", arguments=json.dumps({"q": "test"})))
                    yield DummyStreamChunk(content=None, tool_calls=[tool_call])
                    # Then yield normal content chunk
                    yield DummyStreamChunk(content="final content", tool_calls=None)
                else:
                    return
            else:
                # Non-streaming returns a dummy completion with a tool call
                return DummyCompletion()

    class DummyOpenAIClient:
        def __init__(self, api_key, base_url):
            self.chat = types.SimpleNamespace(completions=DummyClientChatCompletions())

    # Patch importlib.util.find_spec and import_module to simulate openai installed
    monkeypatch.setattr(model_mod.importlib.util, "find_spec", lambda name: True)
    monkeypatch.setattr(model_mod.importlib, "import_module", lambda name: types.SimpleNamespace(OpenAI=DummyOpenAIClient))

    ds_model = model_mod.DeepSeekModel(api_key="key", model="deepseek-coder")

    # Patch get_function to a dummy function that returns a fixed string
    monkeypatch.setattr(model_mod, "get_function", lambda name: lambda **kwargs: "function result")
    # Patch process_function_name to identity
    monkeypatch.setattr(model_mod, "process_function_name", lambda name: name)

    chat_history = [{"role": "user", "content": "Hello"}]

    # Test query (non-stream)
    result = ds_model.query(chat_history, functions=[{"name": "search_function", "parameters": {}}])
    assert isinstance(result, str)
    assert "function result" in chat_history[-1]["content"] or isinstance(result, str)

    # Test stream
    stream_gen = ds_model.stream(chat_history, functions=[{"name": "search_function", "parameters": {}}])
    collected = "".join([chunk for chunk in stream_gen])
    assert "final content" in collected


def test_new_command_includes_deepseek(monkeypatch):
    # Patch questionary.select to capture choices and return 'DeepSeek'
    class DummyQuestionary:
        def __init__(self):
            self.choices = None
            self.prompted = False

        def select(self, message, choices):
            self.choices = choices
            self.prompted = True
            return self

        def ask(self):
            return "DeepSeek"

        def password(self, message):
            return self

    dummy_questionary = DummyQuestionary()

    monkeypatch.setattr(cli, "questionary", dummy_questionary)
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Patch input to simulate API key input for DeepSeek and Tavily
    inputs = iter(["deepseek_api_key", "tavily_api_key"])

    monkeypatch.setattr(builtins, "input", lambda prompt="": next(inputs))
    monkeypatch.setattr(dummy_questionary, "password", lambda message: next(inputs))

    # Run new command with dummy name
    # We expect no exceptions and DeepSeek platform to be included in choices
    # The new function returns None on success or abort
    result = cli.new("dummyname")
    assert dummy_questionary.choices is not None
    assert "DeepSeek" in dummy_questionary.choices


def test_cli_chat_loads_deepseek_model(monkeypatch):
    # Patch cli.check_config to always return True
    monkeypatch.setattr(cli, "check_config", lambda console: True)

    called = {}

    class DummyModel:
        pass

    def dummy_load_model(project_dir, model_name=None):
        called["called"] = True
        called["model_name"] = model_name
        return DummyModel()

    monkeypatch.setattr(cli, "load_model", dummy_load_model)

    class DummyCodeAgent:
        def __init__(self, model):
            called["model"] = model

    monkeypatch.setattr(cli, "CodeAgent", DummyCodeAgent)

    # Patch builtins.input to simulate user input and break loop after one iteration
    inputs = iter(["exit"])

    monkeypatch.setattr(builtins, "input", lambda prompt="": next(inputs))

    # Patch console.log to no-op
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Run chat() - should call load_model with no model_name (default)
    # It should not raise and load_model should be called with None model_name
    cli.chat()
    assert called.get("called") is True
    assert called.get("model_name") is None
    assert isinstance(called.get("model"), DummyModel) or called.get("model") is not None

# The above tests cover:
# - DeepSeekModel initialization and method behavior
# - load_model returns DeepSeekModel when configured
# - DeepSeekModel query and stream methods handle tool calls and content
# - CLI new command includes DeepSeek option and requests API key
# - CLI chat command calls load_model correctly and uses CodeAgent

