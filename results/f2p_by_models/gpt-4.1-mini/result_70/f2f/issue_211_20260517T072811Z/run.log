    def fake_select(message, choices):
        choices_record["choices"] = choices
        return "DeepSeek"

    monkeypatch.setattr(cli.questionary, "select", fake_select)

    # Patch questionary.password to return dummy keys
    monkeypatch.setattr(cli.questionary, "password", lambda prompt: "dummy_api_key")

    # Patch console.log to no-op
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Patch return from new to just call and check choices
    # We only want to check that 'DeepSeek' is in choices
    # We do not need to test full new() behavior here
    # Call new with dummy name
    cli.new("dummy_project")

    assert "DeepSeek" in choices_record.get("choices", [])


