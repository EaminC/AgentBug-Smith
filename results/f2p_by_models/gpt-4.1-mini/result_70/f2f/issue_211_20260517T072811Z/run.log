def test_deepseek_model_query_and_stream(monkeypatch):
    # Prepare dummy openai client and response structure
    class DummyToolCallFunction:
        def __init__(self, name, arguments):
            self.name = name
            self.arguments = arguments

    class DummyToolCall:
        def __init__(self, id_, function):
            self.id = id_
            self.function = function

    class DummyMessage:
        def __init__(self, content, tool_calls=None):
            self.content = content
            self.tool_calls = tool_calls or []

    class DummyChoice:
        def __init__(self, message=None, delta=None):
            self.message = message
            self.delta = delta

    class DummyChunk:
        def __init__(self, choices):
            self.choices = choices

    # For query test: simulate a response with no tool calls
    def dummy_create_no_tool_calls(**kwargs):
        msg = DummyMessage(content="Hello from DeepSeek", tool_calls=[])
        choice = DummyChoice(message=msg)
        return types.SimpleNamespace(choices=[choice])

    # For query test: simulate a response with a tool call
    def dummy_create_with_tool_calls(**kwargs):
        func = DummyToolCallFunction(name="search", arguments=json.dumps({"query": "test"}))
        tool_call = DummyToolCall(id_="123", function=func)
        msg = DummyMessage(content="", tool_calls=[tool_call])
        choice = DummyChoice(message=msg)
        return types.SimpleNamespace(choices=[choice])

    # For stream test: simulate streaming chunks with and without tool calls
    def dummy_stream_create(**kwargs):
        # First chunk has tool call delta
        func = DummyToolCallFunction(name="search", arguments=json.dumps({"query": "stream"}))
        tool_call = DummyToolCall(id_="stream1", function=func)
        delta_with_tool_call = types.SimpleNamespace(tool_calls=[tool_call], content=None)
        choice1 = DummyChoice(delta=delta_with_tool_call)
        yield DummyChunk(choices=[choice1])

        # Second chunk has content delta
        delta_content = types.SimpleNamespace(tool_calls=None, content="streamed content")
        choice2 = DummyChoice(delta=delta_content)
        yield DummyChunk(choices=[choice2])

    # Patch importlib and openai client
    import importlib.util

    class DummyOpenAIClient:
        def __init__(self, api_key, base_url):
            self.api_key = api_key
            self.base_url = base_url
            self.chat = MagicMock()

    dummy_openai_module = types.SimpleNamespace(OpenAI=DummyOpenAIClient)

    original_find_spec = importlib.util.find_spec
    original_import_module = model_module.importlib.import_module if hasattr(model_module.importlib, "import_module") else None

    importlib.util.find_spec = lambda name: True if name == "openai" else None
    model_module.importlib.import_module = lambda name: dummy_openai_module

    try:
        ds = model_module.DeepSeekModel(api_key="key", model="deepseek-coder")

        # Patch client.chat.completions.create for no tool calls
        ds.client.chat.completions.create = dummy_create_no_tool_calls
        chat_history = [{"role": "user", "content": "Hello"}]
        result = ds.query(chat_history)
        assert result == "Hello from DeepSeek"

        # Patch client.chat.completions.create for tool calls
        ds.client.chat.completions.create = dummy_create_with_tool_calls

        # Patch get_function to a dummy function that returns a fixed string
        monkeypatch.setattr(model_module, "get_function", lambda name: lambda **kwargs: "function result")

        chat_history = [{"role": "user", "content": "Hello"}]
        result_with_tool = ds.query(chat_history, functions=[{"name": "search", "parameters": {}}])
        assert isinstance(result_with_tool, str)
        assert "function result" in chat_history[-1]["content"] or result_with_tool == "function result"

        # Patch client.chat.completions.create for streaming
        ds.client.chat.completions.create = dummy_stream_create

        # Test stream generator yields expected strings
        chat_history = [{"role": "user", "content": "stream test"}]
        stream_output = list(ds.stream(chat_history))
        assert any("streamed content" in chunk for chunk in stream_output)
    finally:
        importlib.util.find_spec = original_find_spec
        if original_import_module:
            model_module.importlib.import_module = original_import_module


def test_new_command_includes_deepseek(monkeypatch):
    # Patch questionary.select to capture choices
    choices_captured = {}

    class DummyQuestionary:
        def select(self, message, choices):
            choices_captured["choices"] = choices
            return "DeepSeek"

        def ask(self):
            return "DeepSeek"

    dummy_questionary = DummyQuestionary()

    monkeypatch.setattr(cli, "questionary", dummy_questionary)

    # Patch console.log to no-op
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Patch questionary.password to return a dummy key
    monkeypatch.setattr(cli.questionary, "password", lambda message: "dummy_api_key")

    # Patch input to simulate user input for new command
    # We call cli.new with a dummy name and check choices
