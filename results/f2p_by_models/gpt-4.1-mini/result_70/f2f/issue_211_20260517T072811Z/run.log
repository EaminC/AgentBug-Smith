@pytest.mark.parametrize("model_name", ["deepseek-coder", None])
def test_deepseek_model_query_and_stream(monkeypatch, model_name):
    # Patch importlib.util.find_spec to pretend openai is installed
    import importlib.util

    def dummy_find_spec(name):
        if name == "openai":
            return True
        return None

    monkeypatch.setattr(importlib.util, "find_spec", dummy_find_spec)

    # Patch importlib.import_module to return dummy OpenAI client
    def dummy_import_module(name):
        if name == "openai":
            # Provide a dummy OpenAI class with chat.completions.create method
            dummy_client = types.SimpleNamespace(
                chat=types.SimpleNamespace(
                    completions=types.SimpleNamespace(
                        create=lambda **kwargs: types.SimpleNamespace(
                            choices=[types.SimpleNamespace(
                                message=types.SimpleNamespace(
                                    content="dummy content",
                                    tool_calls=[]
                                ),
                                delta=types.SimpleNamespace(
                                    content="dummy chunk",
                                    tool_calls=None
                                )
                            )]
                        )
                    )
                )
            )
            return types.SimpleNamespace(OpenAI=lambda api_key=None, base_url=None: dummy_client)
        raise ImportError()

    monkeypatch.setattr(model_module.importlib, "import_module", dummy_import_module)

    # Patch get_function to a dummy function that returns a fixed string
    monkeypatch.setattr(model_module, "get_function", lambda name: lambda **kwargs: "function result")

    # Patch process_function_name to identity
    monkeypatch.setattr(model_module, "process_function_name", lambda name: name)

    # Patch SEARCH_FUNCTIONS to a list with one dummy function name
    monkeypatch.setattr(model_module, "SEARCH_FUNCTIONS", ["search_function"])

    # Create DeepSeekModel instance
    api_key = "dummy_api_key"
    deepseek_model = model_module.DeepSeekModel(api_key=api_key, model=model_name)

    # Prepare dummy chat history
    chat_history = [{"role": "user", "content": "Hello"}]

    # Test query method returns a string (content)
    result = deepseek_model.query(chat_history)
    assert isinstance(result, str)
    assert result == "dummy content"

    # Test stream method yields strings
    stream_output = list(deepseek_model.stream(chat_history))
    assert all(isinstance(chunk, str) for chunk in stream_output)
    assert "dummy chunk" in stream_output


