[32mimport builtins
import json
import types
import pytest

from mle import model, cli


class DummyOpenAIChatCompletion:
    def __init__(self, responses):
        # responses is a list of dicts representing chunked responses for streaming
        self._responses = responses
        self._index = 0

    def create(self, **kwargs):
        # If stream is True, return an iterator over responses
        if kwargs.get("stream", False):
            return iter(self._responses)
        # Otherwise, return a single response object
        return types.SimpleNamespace(choices=[types.SimpleNamespace(message=self._responses[0])])


class DummyOpenAIClient:
    def __init__(self, responses):
        self.chat = types.SimpleNamespace(
            completions=DummyOpenAIChatCompletion(responses)
        )


class DummyOpenAI:
    def __init__(self, responses):
        self._responses = responses

    def __call__(self, api_key=None, base_url=None):
        return DummyOpenAIClient(self._responses)


def test_deepseek_model_init_and_attributes(monkeypatch):
    # Patch importlib.util.find_spec to simulate openai package present
    monkeypatch.setattr(model.importlib.util, "find_spec", lambda name: True)

    # Patch importlib.import_module to return DummyOpenAI class
    dummy_responses = [
        types.SimpleNamespace(
            choices=[types.SimpleNamespace(message=types.SimpleNamespace(content="dummy response", tool_calls=None))]
        )
    ]
    monkeypatch.setattr(model.importlib, "import_module", lambda name: types.SimpleNamespace(OpenAI=DummyOpenAI(dummy_responses)))

    api_key = "dummy_key"
    model_name = "deepseek-coder-v1"
    temperature = 0.5

    deepseek_model = model.DeepSeekModel(api_key=api_key, model=model_name, temperature=temperature)

    assert deepseek_model.api_key if hasattr(deepseek_model, "api_key") else True  # no api_key attr, so True
    assert deepseek_model.model == model_name
    assert deepseek_model.model_type == model.MODEL_DEEPSEEK
    assert deepseek_model.temperature == temperature
    assert hasattr(deepseek_model, "client")


@pytest.mark.parametrize("model_name", ["deepseek-coder", None])
def test_load_model_returns_deepseek_model(monkeypatch, model_name):
    # Patch get_config to return DeepSeek platform and api_key
    monkeypatch.setattr(model, "get_config", lambda project_dir: {"platform": model.MODEL_DEEPSEEK, "api_key": "dummy_key"})

    # Patch importlib.util.find_spec and import_module as above
    dummy_responses = [
        types.SimpleNamespace(
            choices=[types.SimpleNamespace(message=types.SimpleNamespace(content="dummy response", tool_calls=None))]
        )
    ]
    monkeypatch.setattr(model.importlib.util, "find_spec", lambda name: True)
    monkeypatch.setattr(model.importlib, "import_module", lambda name: types.SimpleNamespace(OpenAI=DummyOpenAI(dummy_responses)))

    loaded_model = model.load_model(".", model_name)
    assert isinstance(loaded_model, model.DeepSeekModel)
    expected_model_name = model_name if model_name else "deepseek-coder"
    assert loaded_model.model == expected_model_name


def test_deepseek_model_query_and_stream(monkeypatch):
    # Patch importlib.util.find_spec and import_module to simulate openai client
    monkeypatch.setattr(model.importlib.util, "find_spec", lambda name: True)

    # Prepare dummy chat completions responses for query and stream
    # For query: a single response with no tool_calls, content "hello"
    query_response = types.SimpleNamespace(
        choices=[types.SimpleNamespace(message=types.SimpleNamespace(content="hello", tool_calls=None))]
    )
    # For stream: yield chunks with delta content "h", "i"
    stream_responses = [
        types.SimpleNamespace(choices=[types.SimpleNamespace(delta=types.SimpleNamespace(content="h", tool_calls=None))]),
        types.SimpleNamespace(choices=[types.SimpleNamespace(delta=types.SimpleNamespace(content="i", tool_calls=None))]),
    ]

    dummy_openai_instance = DummyOpenAIClient(stream_responses)
    dummy_openai_instance.chat.completions.create = lambda **kwargs: iter(stream_responses) if kwargs.get("stream", False) else query_response

    monkeypatch.setattr(model.importlib, "import_module", lambda name: types.SimpleNamespace(OpenAI=lambda api_key=None, base_url=None: dummy_openai_instance))

    deepseek_model = model.DeepSeekModel(api_key="dummy", model="deepseek-coder")

    # Test query returns expected content
    chat_history = [{"role": "user", "content": "hi"}]
    result = deepseek_model.query(chat_history)
    assert result == "hello"

    # Test stream yields expected content chunks
    stream_output = list(deepseek_model.stream(chat_history))
    assert "".join(stream_output) == "hi"


