@pytest.mark.parametrize("model_name", ["deepseek-coder", None])
def test_deepseek_model_query_and_stream(monkeypatch, model_name):
    # Patch DeepSeekModel to use a dummy client that simulates chat completions
    class DummyToolCall:
        def __init__(self):
            self.id = "toolcall1"
            self.function = types.SimpleNamespace(
                name="search_function",
                arguments=json.dumps({"query": "test"})
            )

    class DummyResponseMessage:
        def __init__(self, tool_calls=None, content="response content"):
            self.tool_calls = tool_calls or []
            self.content = content

    class DummyChoice:
        def __init__(self, message=None, delta=None):
            self.message = message
            self.delta = delta

    class DummyCompletion:
        def __init__(self, choices):
            self.choices = choices

    class DummyChunk:
        def __init__(self, choices):
            self.choices = choices

    class DummyClientChatCompletions:
        def __init__(self):
            self.create_call_count = 0

        def create(self, **kwargs):
            self.create_call_count += 1
            if kwargs.get("stream", False):
                # Simulate streaming with one chunk with delta content
                yield DummyChunk([DummyChoice(delta=types.SimpleNamespace(content="streamed "))])
                yield DummyChunk([DummyChoice(delta=types.SimpleNamespace(content="content"))])
            else:
                # Simulate a response with no tool calls
                return DummyCompletion([DummyChoice(message=DummyResponseMessage(content="final response"))])

    class DummyClientChat:
        def __init__(self):
            self.completions = DummyClientChatCompletions()

    class DummyOpenAI:
        def __init__(self, api_key=None, base_url=None):
            self.chat = DummyClientChat()

    # Patch importlib.util.find_spec to simulate openai installed
    monkeypatch.setattr(model.importlib.util, "find_spec", lambda name: True)

    # Patch importlib.import_module to return DummyOpenAI class
    monkeypatch.setattr(model.importlib, "import_module", lambda name: types.SimpleNamespace(OpenAI=DummyOpenAI))

    # Patch get_function to return a dummy function that returns a fixed string
    monkeypatch.setattr(model, "get_function", lambda name: lambda **kwargs: "function result")

    # Patch process_function_name to return the name unchanged
    monkeypatch.setattr(model, "process_function_name", lambda name: name)

    # Patch SEARCH_FUNCTIONS to include the test function name
    monkeypatch.setattr(model, "SEARCH_FUNCTIONS", ["search_function"])

    # Create DeepSeekModel instance
    ds_model = model.DeepSeekModel(api_key="dummy", model=model_name)

    # Prepare chat history without tool calls
    chat_history = [{"role": "user", "content": "Hello"}]

    # Test query returns expected string
    result = ds_model.query(chat_history)
    assert isinstance(result, str)
    assert "final response" in result

    # Test stream yields expected strings
    stream_output = list(ds_model.stream(chat_history))
    assert any("streamed" in s or "content" in s for s in stream_output)


def test_new_command_includes_deepseek(monkeypatch):
    # Patch questionary.select to capture choices and return 'DeepSeek'
    choices_captured = {}

    def fake_select(message, choices):
        choices_captured["choices"] = choices
        return "DeepSeek"

    monkeypatch.setattr(cli.questionary, "select", fake_select)

    # Patch questionary.password to return dummy API keys
    monkeypatch.setattr(cli.questionary, "password", lambda prompt: "dummy_api_key")

    # Patch console.log to no-op
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Patch return to capture the new command flow
    # We call new("testname") and expect no abort due to missing API key
    result = cli.new("testname")
    # The function returns None on success or abort, so just check choices included DeepSeek
    assert "DeepSeek" in choices_captured["choices"]


def test_cli_chat_loads_deepseek_model(monkeypatch):
    # Patch check_config to return True
    monkeypatch.setattr(cli, "check_config", lambda console: True)

