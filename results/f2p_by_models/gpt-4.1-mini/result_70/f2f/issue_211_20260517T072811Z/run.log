@pytest.mark.parametrize("model_name", ["deepseek-coder", None])
def test_deepseek_model_query_and_stream(monkeypatch, model_name):
    # Use dummy DeepSeekModel with dummy client
    ds_model = DummyDeepSeekModel(api_key="dummykey", model=model_name)

    # Patch get_function to a dummy function that returns a fixed string
    monkeypatch.setattr(model_module, "get_function", lambda name: lambda **kwargs: "dummy result")

    # Patch process_function_name to identity
    monkeypatch.setattr(model_module, "process_function_name", lambda name: name)

    # Prepare chat_history with one user message
    chat_history = [{"role": "user", "content": "Hello"}]

    # Test query without functions (no tools)
    result = ds_model.query(chat_history)
    assert isinstance(result, str)
    assert "response content" in result

    # Test query with functions triggers recursive calls and tool calls
    functions = [
        {
            "name": "func1",
            "description": "desc",
            "parameters": {"type": "object", "properties": {"param1": {"type": "string"}}},
        }
    ]

    # Patch client.chat.completions.create to simulate tool_calls in response
    class ToolCall:
        def __init__(self):
            self.function = types.SimpleNamespace(name="func1", arguments=json.dumps({"param1": "value"}))
            self.id = "toolcallid"

    class MessageWithToolCalls:
        def __init__(self):
            self.tool_calls = [ToolCall()]
            self.content = ""

    class CompletionWithToolCalls:
        def __init__(self):
            self.choices = [types.SimpleNamespace(message=MessageWithToolCalls())]

    def dummy_create(**kwargs):
        return CompletionWithToolCalls()

    monkeypatch.setattr(ds_model.client.chat.completions, "create", dummy_create)

    # The query should recursively call itself and eventually return a string
    # Because of recursion, limit search attempts to avoid infinite loop
    # The dummy get_function returns "dummy result"
    result2 = ds_model.query(chat_history, functions=functions)
    assert isinstance(result2, str)
    assert result2 == "" or isinstance(result2, str)  # could be empty string or string


    # Test stream yields strings
    # Patch client.chat.completions.create to yield one chunk with content
    def dummy_stream_create(**kwargs):
        chunk = types.SimpleNamespace()
        chunk.choices = [types.SimpleNamespace(delta=types.SimpleNamespace(content="streamed content"))]
        yield chunk

    monkeypatch.setattr(ds_model.client.chat.completions, "create", dummy_stream_create)

    stream_output = list(ds_model.stream(chat_history))
    assert any(isinstance(s, str) and "streamed content" in s for s in stream_output)


