class DummyToolCall:
    def __init__(self, name, arguments, id="toolcall1"):
        self.function = types.SimpleNamespace(name=name, arguments=arguments)
        self.id = id


class DummyChoice:
    def __init__(self, content=None, tool_calls=None, delta=None):
        self.message = types.SimpleNamespace(
            content=content,
            tool_calls=tool_calls,
        )
        self.delta = delta
        self.tool_calls = tool_calls


class DummyDelta:
    def __init__(self, content=None, tool_calls=None):
        self.content = content
        self.tool_calls = tool_calls


class DummyCompletion:
    def __init__(self, choices):
        self.choices = choices


class DummyChatCompletions:
    def __init__(self, responses):
        # responses is a list of DummyCompletion or iterable of chunks for streaming
        self._responses = responses
        self._index = 0

    def create(self, **kwargs):
        # If stream=True, return an iterable of chunks
        if kwargs.get("stream", False):
            return iter(self._responses)
        else:
            # Return the first response (non-stream)
            return self._responses[0]


class DummyOpenAIClient:
    def __init__(self, responses):
        self.chat = types.SimpleNamespace(
            completions=DummyChatCompletions(responses)
        )


def test_deepseek_model_query_and_stream(monkeypatch):
    # Patch importlib.util.find_spec to pretend openai is installed
    monkeypatch.setattr(model.importlib.util, "find_spec", lambda name: True)

    # Patch importlib.import_module to return a dummy OpenAI client class
    def dummy_import_module(name):
        # Provide a dummy OpenAI class that returns a client instance with chat.completions.create
        class DummyOpenAI:
            def __init__(self, api_key=None, base_url=None):
                # We'll set client externally after instantiation
                self._client = None

            def __call__(self, *args, **kwargs):
                return self._client

        dummy_openai_instance = DummyOpenAI()

        # Prepare dummy responses for query (non-stream)
        # Simulate a response with a tool call
        tool_call = DummyToolCall(
            name="search_function",
            arguments=json.dumps({"query": "test"}),
            id="toolcall123",
        )
        choice_with_tool_call = DummyChoice(
            content=None, tool_calls=[tool_call]
        )
        completion_with_tool_call = DummyCompletion([choice_with_tool_call])

        # For the recursive query call, simulate a final response with no tool calls
        final_choice = DummyChoice(content="final answer", tool_calls=None)
        final_completion = DummyCompletion([final_choice])

        # The client.chat.completions.create should return first the tool call response,
        # then the final response on recursive call
        dummy_openai_instance._client = DummyOpenAIClient(
            responses=[completion_with_tool_call, final_completion]
        )
        return dummy_openai_instance

    monkeypatch.setattr(model.importlib, "import_module", dummy_import_module)

    # Patch get_function to a dummy function that returns a fixed string
    monkeypatch.setattr(model, "get_function", lambda name: lambda **kwargs: "tool result")

    # Patch process_function_name to return the input name unchanged
    monkeypatch.setattr(model, "process_function_name", lambda name: name)

    # Patch SEARCH_FUNCTIONS to include the dummy function name to test search attempts limit
    monkeypatch.setattr(model, "SEARCH_FUNCTIONS", ["search_function"])

    # Instantiate DeepSeekModel
    ds_model = DeepSeekModel(api_key="dummy_key", model="deepseek-coder")

    # Prepare chat history
    chat_history = [{"role": "user", "content": "Hello"}]

    # Test query method: should recursively call and finally return "final answer"
    result = ds_model.query(chat_history)
    assert result == "final answer"
    # The function call history should have at least one record with the dummy function name
    assert any(call["name"] == "search_function" for call in ds_model.func_call_history)

    # Prepare dummy streaming chunks for stream method
    # First chunk with a tool call delta
    tool_call_delta = DummyToolCall(
        name="search_function",
        arguments=json.dumps({"query": "stream test"}),
        id="toolcall_stream",
    )
    delta_with_tool_call = DummyDelta(content=None, tool_calls=[tool_call_delta])
    chunk1 = DummyChoice(delta=delta_with_tool_call)

    # Second chunk with normal content delta
    delta_content = DummyDelta(content="streamed content", tool_calls=None)
    chunk2 = DummyChoice(delta=delta_content)

    # Third chunk with no content or tool_calls (end)
    delta_empty = DummyDelta(content=None, tool_calls=None)
    chunk3 = DummyChoice(delta=delta_empty)

    dummy_stream_responses = [chunk1, chunk2, chunk3]

    # Replace the client's chat completions with the streaming dummy
    ds_model.client.chat.completions = DummyChatCompletions(dummy_stream_responses)

    # Run the stream method and collect output
    output = list(ds_model.stream(chat_history))
    # The output should include the streamed content string
    assert "streamed content" in output

    # The chat_history should have been appended with tool call and tool results
    roles = [msg.get("role") for msg in chat_history]
    assert "tool" in roles
    assert "assistant" in roles


