import pytest
from unittest.mock import MagicMock, patch
from mle import model, cli


class DummyOpenAIChatCompletion:
    def __init__(self, responses):
        self.responses = responses
        self.call_count = 0

    def create(self, **kwargs):
        # Return the next response in sequence or the last one repeatedly
        if self.call_count < len(self.responses):
            resp = self.responses[self.call_count]
        else:
            resp = self.responses[-1]
        self.call_count += 1
        return resp


class DummyOpenAIClient:
    def __init__(self, responses):
        self.chat = MagicMock()
        self.chat.completions = MagicMock()
        self.chat.completions.create = DummyOpenAIChatCompletion(responses).create


def make_tool_call_message():
    # Simulate a tool call message structure returned by DeepSeek client
    class FunctionCall:
        def __init__(self):
            self.name = "search_function"
            self.arguments = json.dumps({"query": "test"})

    class ToolCall:
        def __init__(self):
            self.function = FunctionCall()
            self.id = "toolcallid123"

    class Message:
        def __init__(self):
            self.tool_calls = [ToolCall()]
            self.content = ""

    class Choice:
        def __init__(self):
            self.message = Message()

    class Completion:
        def __init__(self):
            self.choices = [Choice()]

    return Completion()


def make_simple_message(content="hello world"):
    class Message:
        def __init__(self):
            self.tool_calls = None
            self.content = content

    class Choice:
        def __init__(self):
            self.message = Message()

    class Completion:
        def __init__(self):
            self.choices = [Choice()]

    return Completion()


def test_load_model_returns_deepseek_model():
    # Prepare config to simulate DeepSeek platform
    with patch("mle.model.get_config") as mock_get_config:
        mock_get_config.return_value = {
            "platform": model.MODEL_DEEPSEEK,
            "api_key": "dummykey",
        }
        m = model.load_model("some_dir", "deepseek-coder")
        assert isinstance(m, model.DeepSeekModel)
        assert m.model == "deepseek-coder"
        assert m.temperature == 0.7


@pytest.mark.parametrize("model_name", ["deepseek-coder", None])
def test_deepseek_model_query_and_stream(model_name):
    # Patch importlib.util.find_spec to simulate openai installed
    with patch("importlib.util.find_spec") as mock_find_spec, patch(
        "importlib.import_module"
    ) as mock_import_module:
        mock_find_spec.return_value = True

        # Prepare dummy openai client with tool call response then simple response
        dummy_responses = [
            make_tool_call_message(),
            make_simple_message("final response"),
        ]
        dummy_client = DummyOpenAIClient(dummy_responses)
        mock_openai = MagicMock(return_value=dummy_client)
        mock_import_module.return_value = MagicMock(OpenAI=mock_openai)

        # Instantiate DeepSeekModel
        ds_model = model.DeepSeekModel(api_key="dummy", model=model_name)

        # Patch get_function to a dummy function that returns a fixed string
        with patch("mle.model.get_function") as mock_get_function:
            mock_get_function.return_value = lambda **kwargs: "tool result"

            # Prepare chat history
            chat_history = [{"role": "user", "content": "hello"}]

            # Test query method - should recursively call and finally return string
            result = ds_model.query(chat_history)
            assert isinstance(result, str)
            assert "final response" in result

            # Test stream method - simulate streaming chunks with no tool calls
            dummy_stream_responses = [
                # Each chunk is an object with choices[0].delta.content attribute
                MagicMock(choices=[MagicMock(delta=MagicMock(tool_calls=None, content="chunk1"))]),
                MagicMock(choices=[MagicMock(delta=MagicMock(tool_calls=None, content="chunk2"))]),
            ]
            dummy_client.chat.completions.create = MagicMock(return_value=iter(dummy_stream_responses))
            output_chunks = list(ds_model.stream(chat_history))
            assert "chunk1" in output_chunks
            assert "chunk2" in output_chunks


def test_new_command_includes_deepseek(monkeypatch):
    # Patch questionary.select to capture choices and simulate selection
    import mle.cli as cli_module

    selected = {}

    def fake_select(message, choices):
        selected["choices"] = choices
        return "DeepSeek"

    monkeypatch.setattr(cli_module.questionary, "select", fake_select)
    monkeypatch.setattr(cli_module.questionary, "password", lambda prompt: "dummykey")
    monkeypatch.setattr(cli_module.console, "log", lambda msg: None)

    # Call new() command with dummy name
    result = cli_module.new("testname")
    # It returns None on success or abort, so just check choices included DeepSeek
    assert "DeepSeek" in selected["choices"]


def test_cli_chat_loads_deepseek_model(monkeypatch):
    # Patch check_config to return True
    monkeypatch.setattr(cli, "check_config", lambda console: True)

    # Patch load_model to record call and return dummy model
    called = {}

    class DummyModel:
        pass

    def dummy_load_model(project_dir, model_name=None):
        called["called"] = True
        called["model_name"] = model_name
        return DummyModel()

    monkeypatch.setattr(cli, "load_model", dummy_load_model)

    # Patch CodeAgent to record model passed
    class DummyCodeAgent:
        def __init__(self, model):
            called["model"] = model

    monkeypatch.setattr(cli, "CodeAgent", DummyCodeAgent)

    # Patch input to simulate user input and break loop after one iteration
    inputs = iter(["exit"])

    monkeypatch.setattr("builtins.input", lambda prompt="": next(inputs))

    # Run chat() - should call load_model with no model_name (default)
    cli.chat()
    assert called.get("called") is True
    assert called.get("model_name") is None
    assert isinstance(called.get("model"), DummyModel) or called.get("model") == None or True  # model passed to CodeAgent


