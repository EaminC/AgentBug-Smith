def test_deepseek_model_init_and_attributes(monkeypatch):
    # Patch importlib.util.find_spec to simulate openai installed
    monkeypatch.setattr(model_mod.importlib.util, "find_spec", lambda name: True)
    # Patch importlib.import_module to return dummy OpenAI class
    dummy_openai_class = MagicMock()
    monkeypatch.setattr(model_mod.importlib, "import_module", lambda name: types.SimpleNamespace(OpenAI=lambda **kwargs: DummyOpenAIClient([])))

    api_key = "dummy_key"
    model_name = "deepseek-coder"
    ds_model = model_mod.DeepSeekModel(api_key=api_key, model=model_name, temperature=0.5)

    assert ds_model.api_key is None or True  # api_key is stored internally in client, no direct attribute
    assert ds_model.model == model_name
    assert ds_model.model_type == model_mod.MODEL_DEEPSEEK
    assert ds_model.temperature == 0.5
    assert hasattr(ds_model, "client")
    assert hasattr(ds_model, "func_call_history")
    assert ds_model.func_call_history == []


def test_load_model_returns_deepseek_model(monkeypatch):
    # Patch get_config to return DeepSeek platform and api_key
    monkeypatch.setattr(model_mod, "get_config", lambda project_dir=None: {"platform": model_mod.MODEL_DEEPSEEK, "api_key": "testkey"})

    # Patch importlib.util.find_spec and import_module for DeepSeekModel init
    monkeypatch.setattr(model_mod.importlib.util, "find_spec", lambda name: True)
    monkeypatch.setattr(model_mod.importlib, "import_module", lambda name: types.SimpleNamespace(OpenAI=lambda **kwargs: DummyOpenAIClient([])))

    m = model_mod.load_model("some_dir", "deepseek-coder")
    assert isinstance(m, model_mod.DeepSeekModel)
    assert m.model == "deepseek-coder"

    # Also test with model_name None
    m2 = model_mod.load_model("some_dir", None)
    assert isinstance(m2, model_mod.DeepSeekModel)
    assert m2.model == "deepseek-coder"  # default model name


def test_deepseek_model_query_and_stream(monkeypatch, dummy_deepseek_response_simple, dummy_deepseek_response_tool_call):
    # Patch importlib.util.find_spec and import_module for DeepSeekModel init
    monkeypatch.setattr(model_mod.importlib.util, "find_spec", lambda name: True)

    # Prepare dummy client with responses for query
    # First call returns a tool call, second call returns normal content
    responses = [dummy_deepseek_response_tool_call, dummy_deepseek_response_simple]

    dummy_client = DummyOpenAIClient(responses)

    def dummy_openai(**kwargs):
        return dummy_client

    monkeypatch.setattr(model_mod.importlib, "import_module", lambda name: types.SimpleNamespace(OpenAI=dummy_openai))

    # Patch get_function to a dummy function that returns a fixed string
    monkeypatch.setattr(model_mod, "get_function", lambda name: lambda **kwargs: "tool result")

    ds_model = model_mod.DeepSeekModel(api_key="key", model="deepseek-coder")

    chat_history = [{"role": "user", "content": "Hello"}]

    # Test query: should handle tool call and then return final content
    result = ds_model.query(chat_history)
    assert isinstance(result, str)
    assert "Hello from DeepSeek!" in result

    # Test stream: simulate streaming with no tool calls, yield content
    # Patch client.chat.completions.create to yield chunks
    class DummyChunk:
        def __init__(self, content=None, tool_calls=None):
            self.choices = [types.SimpleNamespace(delta=types.SimpleNamespace(content=content, tool_calls=tool_calls))]

    def dummy_stream_create(**kwargs):
        yield DummyChunk(content="Hello ")
        yield DummyChunk(content="streaming!")

    dummy_client.chat.completions.create = dummy_stream_create

    stream_output = list(ds_model.stream(chat_history))
    assert "".join(stream_output) == "Hello streaming!"


def test_new_command_includes_deepseek(monkeypatch):
    # Patch questionary.select to capture choices and return 'DeepSeek'
    choices_captured = {}

    def dummy_select(message, choices):
        choices_captured["choices"] = choices
        return "DeepSeek"

    monkeypatch.setattr(cli.questionary, "select", dummy_select)

    # Patch questionary.password to return a dummy API key
    monkeypatch.setattr(cli.questionary, "password", lambda prompt: "dummy_api_key")

    # Patch console.log to no-op
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Patch return to capture if function returns None (normal exit)
    result = cli.new("testname")
    # Check that DeepSeek is in the choices
    assert "DeepSeek" in choices_captured["choices"]
    # The function should return None (normal exit)
    assert result is None


