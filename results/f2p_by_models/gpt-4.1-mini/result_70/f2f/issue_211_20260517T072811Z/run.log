class DummyOpenAIChatCompletion:
    def __init__(self, messages, model, temperature, stream, tools=None, **kwargs):
        self.messages = messages
        self.model = model
        self.temperature = temperature
        self.stream = stream
        self.tools = tools
        self.kwargs = kwargs
        self._yielded = False

    def __iter__(self):
        # Simulate streaming output with one chunk containing content
        if self.stream:
            if not self._yielded:
                self._yielded = True
                # yield a dummy chunk with delta content
                chunk = types.SimpleNamespace()
                chunk.choices = [types.SimpleNamespace(delta=types.SimpleNamespace(content="streamed response"))]
                yield chunk
            else:
                return
        else:
            # Non-streaming, yield nothing
            return

    @property
    def choices(self):
        # For non-streaming, return a list with one choice with message and no tool_calls
        message = types.SimpleNamespace(content="response content", tool_calls=[])
        choice = types.SimpleNamespace(message=message)
        return [choice]


class DummyOpenAIClient:
    def __init__(self, api_key=None, base_url=None):
        self.api_key = api_key
        self.base_url = base_url
        self.chat = self

    def completions(self):
        return self

    def create(self, **kwargs):
        # Return a DummyOpenAIChatCompletion instance
        return DummyOpenAIChatCompletion(
            messages=kwargs.get("messages"),
            model=kwargs.get("model"),
            temperature=kwargs.get("temperature"),
            stream=kwargs.get("stream"),
            tools=kwargs.get("tools"),
        )

    # For compatibility with model code that calls client.chat.completions.create
    def __getattr__(self, item):
        # Return self for 'completions' attribute
        if item == "completions":
            return self
        raise AttributeError(f"DummyOpenAIClient has no attribute {item}")


