@pytest.mark.parametrize("model_name", ["deepseek-coder", None])
def test_deepseek_model_query_and_stream(monkeypatch, model_name):
    # Patch importlib.util.find_spec to pretend openai is installed
    monkeypatch.setattr(model.importlib.util, "find_spec", lambda name: True)

    # Patch importlib.import_module to return a dummy OpenAI client class with .OpenAI attribute
    class DummyOpenAIModule:
        OpenAI = DummyOpenAIClient

    monkeypatch.setattr(model.importlib, "import_module", lambda name: DummyOpenAIModule())

    # Patch get_function to a dummy function that returns a fixed string
    monkeypatch.setattr(model, "get_function", lambda name: lambda **kwargs: "tool result")

    # Patch process_function_name to return the input name unchanged
    monkeypatch.setattr(model, "process_function_name", lambda name: name)

    # Patch SEARCH_FUNCTIONS to include the dummy function name to test search attempts limit
    monkeypatch.setattr(model, "SEARCH_FUNCTIONS", ["search_function"])

    # Instantiate DeepSeekModel
    ds_model = model.DeepSeekModel(api_key="dummy_key", model=model_name)

    # Prepare a dummy chat history
    chat_history = [{"role": "user", "content": "Hello"}]

    # Test query returns expected string
    response = ds_model.query(chat_history)
    assert isinstance(response, str)
    assert "dummy response content" in response

    # Test stream yields strings
    stream_output = list(ds_model.stream(chat_history))
    assert all(isinstance(chunk, str) for chunk in stream_output)
    assert "streamed chunk 1" in stream_output
    assert "streamed chunk 2" in stream_output


def test_load_model_returns_deepseek_model(monkeypatch):
    # Patch get_config to return config with platform DeepSeek and api_key
    monkeypatch.setattr(model, "get_config", lambda project_dir: {
        "platform": model.MODEL_DEEPSEEK,
        "api_key": "dummy_key"
    })

    # Patch importlib.util.find_spec and import_module to simulate openai presence
    monkeypatch.setattr(model.importlib.util, "find_spec", lambda name: True)

    class DummyOpenAIModule:
        OpenAI = DummyOpenAIClient

    monkeypatch.setattr(model.importlib, "import_module", lambda name: DummyOpenAIModule())

    # Call load_model with no model_name (should default)
    loaded_model = model.load_model("dummy_dir", None)
    assert loaded_model is not None
    assert loaded_model.model_type == model.MODEL_DEEPSEEK
    assert hasattr(loaded_model, "query")
    assert hasattr(loaded_model, "stream")

    # Call load_model with explicit model_name
    loaded_model2 = model.load_model("dummy_dir", "deepseek-coder")
    assert loaded_model2 is not None
    assert loaded_model2.model == "deepseek-coder"
    assert loaded_model2.model_type == model.MODEL_DEEPSEEK


