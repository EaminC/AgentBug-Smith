def test_deepseek_model_init_and_attributes():
    # We test that DeepSeekModel initializes correctly and has expected attributes
    api_key = "dummy_api_key"
    model_name = "deepseek-coder-v1"
    temperature = 0.5

    # Patch importlib.util.find_spec to simulate openai package presence
    with mock.patch("importlib.util.find_spec", return_value=types.SimpleNamespace(name="openai")):
        # Patch importlib.import_module to return a dummy OpenAI client class
        dummy_openai_client = mock.MagicMock()
        dummy_openai_client.chat.completions.create.return_value = types.SimpleNamespace(
            choices=[types.SimpleNamespace(message=types.SimpleNamespace(content="response", tool_calls=None))]
        )

        class DummyOpenAI:
            def __init__(self, api_key=None, base_url=None):
                self.api_key = api_key
                self.base_url = base_url
                self.chat = types.SimpleNamespace(
                    completions=types.SimpleNamespace(
                        create=mock.MagicMock(return_value=dummy_openai_client.chat.completions.create.return_value)
                    )
                )

        with mock.patch("importlib.import_module", return_value=DummyOpenAI):
            ds_model = model.DeepSeekModel(api_key=api_key, model=model_name, temperature=temperature)

            assert ds_model.api_key == api_key or hasattr(ds_model, "client")
            assert ds_model.model == model_name
            assert ds_model.temperature == temperature
            assert ds_model.model_type == model.MODEL_DEEPSEEK
            assert hasattr(ds_model, "client")
            assert isinstance(ds_model.func_call_history, list)


def test_load_model_returns_deepseek_model():
    # Patch get_config to return DeepSeek platform and api_key
    dummy_config = {
        "platform": model.MODEL_DEEPSEEK,
        "api_key": "dummy_api_key",
    }

    with mock.patch("mle.utils.get_config", return_value=dummy_config):
        # Patch importlib.util.find_spec and importlib.import_module to simulate openai presence
        with mock.patch("importlib.util.find_spec", return_value=types.SimpleNamespace(name="openai")):
            class DummyOpenAI:
                def __init__(self, api_key=None, base_url=None):
                    self.api_key = api_key
                    self.base_url = base_url
                    self.chat = types.SimpleNamespace(
                        completions=types.SimpleNamespace(
                            create=mock.MagicMock()
                        )
                    )

            with mock.patch("importlib.import_module", return_value=DummyOpenAI):
                ds_model = model.load_model(project_dir=".", model_name="deepseek-coder-v1")
                assert isinstance(ds_model, model.DeepSeekModel)
                assert ds_model.model == "deepseek-coder-v1"
                assert ds_model.temperature == 0.7


def test_deepseek_model_query_and_stream():
    # Setup dummy DeepSeekModel with mocked client.chat.completions.create for query and stream
    api_key = "dummy_api_key"
    model_name = "deepseek-coder-v1"

    with mock.patch("importlib.util.find_spec", return_value=types.SimpleNamespace(name="openai")):
        dummy_openai_client = mock.MagicMock()

        # Setup dummy response for query (non-stream)
        dummy_response = types.SimpleNamespace(
            choices=[types.SimpleNamespace(message=types.SimpleNamespace(content="hello world", tool_calls=None))]
        )
        dummy_openai_client.chat.completions.create.return_value = dummy_response

        class DummyOpenAI:
            def __init__(self, api_key=None, base_url=None):
                self.api_key = api_key
                self.base_url = base_url
                self.chat = types.SimpleNamespace(
                    completions=types.SimpleNamespace(
                        create=mock.MagicMock(return_value=dummy_response)
                    )
                )

        with mock.patch("importlib.import_module", return_value=DummyOpenAI):
            ds_model = model.DeepSeekModel(api_key=api_key, model=model_name)

            chat_history = [{"role": "user", "content": "Hello"}]
            result = ds_model.query(chat_history)
            assert result == "hello world"

            # Now test stream yields content chunks
            # Setup dummy stream generator
            def dummy_stream(*args, **kwargs):
                yield types.SimpleNamespace(
                    choices=[types.SimpleNamespace(delta=types.SimpleNamespace(content="streamed "))]
                )
                yield types.SimpleNamespace(
                    choices=[types.SimpleNamespace(delta=types.SimpleNamespace(content="content"))]
                )

            ds_model.client.chat.completions.create = dummy_stream

            stream_output = list(ds_model.stream(chat_history))
            assert "".join(stream_output) == "streamed content"


