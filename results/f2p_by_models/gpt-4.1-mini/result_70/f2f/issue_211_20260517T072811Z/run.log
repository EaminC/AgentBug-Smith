def test_load_model_returns_deepseek_model(monkeypatch):
    # Setup a dummy config to trigger DeepSeek platform
    dummy_config = {
        "platform": model_module.MODEL_DEEPSEEK,
        "api_key": "dummy_key",
    }

    # Patch get_config to return dummy_config
    monkeypatch.setattr(model_module, "get_config", lambda project_dir=None: dummy_config)

    # Patch importlib.util.find_spec to pretend openai is installed
    monkeypatch.setattr(model_module.importlib.util, "find_spec", lambda name: True)

    # Patch importlib.import_module to return a dummy OpenAI client class
    class DummyOpenAIClient:
        def __init__(self, api_key=None, base_url=None):
            self.api_key = api_key
            self.base_url = base_url
            self.chat = MagicMock()

    dummy_openai_module = types.SimpleNamespace(OpenAI=DummyOpenAIClient)
    monkeypatch.setattr(model_module.importlib, "import_module", lambda name: dummy_openai_module)

    # Call load_model with DeepSeek platform config
    loaded_model = model_module.load_model("dummy_project_dir", model_name="deepseek-coder")

    # Assert that the returned model is an instance of DeepSeekModel
    assert isinstance(loaded_model, model_module.DeepSeekModel)
    # Assert that the model attribute is set correctly
    assert loaded_model.model == "deepseek-coder"
    # Assert that the api_key is passed to the client
    assert loaded_model.client.api_key == "dummy_key"
    # Assert that the base_url is the DeepSeek API URL
    assert loaded_model.client.base_url == "https://api.deepseek.com/beta"


def test_deepseek_model_query_and_stream(monkeypatch):
    # Setup dummy DeepSeekModel with mocked client.chat.completions.create
    dummy_api_key = "dummy_key"
    dummy_model_name = "deepseek-coder"

    # Patch importlib.util.find_spec and import_module to simulate openai installed
    monkeypatch.setattr(model_module.importlib.util, "find_spec", lambda name: True)

    class DummyCompletion:
        def __init__(self, choices):
            self.choices = choices

    class DummyMessage:
        def __init__(self, content="", tool_calls=None):
            self.content = content
            self.tool_calls = tool_calls or []

    class DummyToolCallFunction:
        def __init__(self, name, arguments):
            self.name = name
            self.arguments = arguments

    class DummyToolCall:
        def __init__(self, id_, function):
            self.id = id_
            self.function = function

    class DummyChoice:
        def __init__(self, message=None, delta=None):
            self.message = message
            self.delta = delta

    class DummyDelta:
        def __init__(self, content=None, tool_calls=None):
            self.content = content
            self.tool_calls = tool_calls or []

    class DummyClientChatCompletions:
        def __init__(self):
            self.create = MagicMock()

    class DummyOpenAIClient:
        def __init__(self, api_key=None, base_url=None):
            self.api_key = api_key
            self.base_url = base_url
            self.chat = types.SimpleNamespace(completions=DummyClientChatCompletions())

    dummy_openai_module = types.SimpleNamespace(OpenAI=DummyOpenAIClient)
    monkeypatch.setattr(model_module.importlib, "import_module", lambda name: dummy_openai_module)

    # Patch get_function to a dummy function that returns a fixed string
    monkeypatch.setattr(model_module, "get_function", lambda name: lambda **kwargs: f"Result for {name}")

    # Patch process_function_name to identity function
    monkeypatch.setattr(model_module, "process_function_name", lambda name: name)

    # Prepare DeepSeekModel instance
    ds_model = model_module.DeepSeekModel(api_key=dummy_api_key, model=dummy_model_name)

    # Prepare chat history
    chat_history = [{"role": "user", "content": "Hello"}]

    # Prepare a dummy function call in the response to simulate tool call
    tool_call_func = DummyToolCallFunction(name="search", arguments=json.dumps({"query": "test"}))
    tool_call = DummyToolCall(id_="1", function=tool_call_func)
    dummy_message_with_tool_call = DummyMessage(content="", tool_calls=[tool_call])
    dummy_completion_with_tool_call = DummyCompletion(choices=[DummyChoice(message=dummy_message_with_tool_call)])

    # Setup the client.chat.completions.create to return dummy_completion_with_tool_call on first call,
    # and a normal message on second call to end recursion
    normal_message = DummyMessage(content="Final response", tool_calls=[])
    normal_completion = DummyCompletion(choices=[DummyChoice(message=normal_message)])

    call_count = {"count": 0}

    def create_side_effect(*args, **kwargs):
        if call_count["count"] == 0:
            call_count["count"] += 1
            return dummy_completion_with_tool_call
        else:
            return normal_completion

    ds_model.client.chat.completions.create.side_effect = create_side_effect

    # Test query method: it should recursively handle tool calls and finally return the final content
    result = ds_model.query(chat_history)
    assert result == "Final response"
    # The func_call_history should contain the function call info
    assert any(call["name"] == "search" for call in ds_model.func_call_history)

    # Test stream method: simulate streaming chunks with and without tool calls
    # Prepare chunks for streaming with tool call first, then normal content
    delta_tool_call = DummyDelta(content=None, tool_calls=[tool_call])
    delta_normal = DummyDelta(content="streamed content", tool_calls=[])

    chunk_with_tool_call = types.SimpleNamespace(choices=[DummyChoice(delta=delta_tool_call)])
    chunk_normal = types.SimpleNamespace(choices=[DummyChoice(delta=delta_normal)])

    # Setup create to yield chunks
    def create_stream_side_effect(*args, **kwargs):
        yield chunk_with_tool_call
        yield chunk_normal

    ds_model.client.chat.completions.create = create_stream_side_effect

    # Stream output should yield "streamed content"
    output = list(ds_model.stream(chat_history))
    assert "streamed content" in output
    # The chat_history should be appended with tool and assistant messages
    roles = [msg.get("role") for msg in chat_history]
    assert "tool" in roles
    assert "assistant" in roles


def test_new_command_includes_deepseek(monkeypatch):
    # Patch questionary.select to capture choices
    choices_captured = {}

    def fake_select(message, choices):
        choices_captured["choices"] = choices
        # Return 'DeepSeek' to test the branch
        return "DeepSeek"

    monkeypatch.setattr(cli.questionary, "select", fake_select)

    # Patch questionary.password to return a dummy API key
    monkeypatch.setattr(cli.questionary, "password", lambda prompt: "dummy_deepseek_key")

    # Patch console.log to no-op
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Patch the rest of new to just call the selection and api_key input parts
    # We call new with a dummy name and check that DeepSeek is included in choices and api_key is requested
    # We expect no exceptions and the flow to proceed

    # We call new and it should not return anything (returns None)
    result = cli.new("dummy_project_name")
    assert result is None
    # Check DeepSeek is in the choices
    assert "DeepSeek" in choices_captured["choices"]


def test_cli_chat_loads_deepseek_model(monkeypatch):
    # Patch check_config to return True
    monkeypatch.setattr(cli, "check_config", lambda console: True)

    # Patch load_model to record call and return dummy model
    called = {}

    class DummyModel:
        pass

    def dummy_load_model(project_dir, model_name=None):
        called["called"] = True
        called["model_name"] = model_name
        return DummyModel()

    monkeypatch.setattr(cli, "load_model", dummy_load_model)

    # Patch CodeAgent to record model passed
    class DummyCodeAgent:
        def __init__(self, model):
            called["model"] = model

    monkeypatch.setattr(cli, "CodeAgent", DummyCodeAgent)

    # Patch input to simulate user input and break loop after one iteration
    inputs = iter(["exit"])

    monkeypatch.setattr(builtins, "input", lambda prompt="": next(inputs))

    # Patch console.log to no-op
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Run chat() - should call load_model with no model_name (default)
    # It should not raise and load_model should be called with None model_name
    cli.chat()

    assert called.get("called") is True
    assert called.get("model_name") is None
    assert isinstance(called.get("model"), DummyModel) or called.get("model") is not None


