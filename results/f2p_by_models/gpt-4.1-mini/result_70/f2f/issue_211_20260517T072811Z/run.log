import json
import types
import pytest
from unittest.mock import MagicMock

import mle.model as model_module
import mle.cli as cli


def test_deepseek_model_init_and_attributes(monkeypatch):
    # Patch importlib.util.find_spec to simulate openai package present
    monkeypatch.setattr(model_module.importlib.util, "find_spec", lambda name: True)

    # Patch importlib.import_module to return a dummy OpenAI client class
    class DummyOpenAIClient:
        def __init__(self, api_key=None, base_url=None):
            self.api_key = api_key
            self.base_url = base_url
            self.chat = MagicMock()

    monkeypatch.setattr(model_module.importlib, "import_module", lambda name: types.SimpleNamespace(OpenAI=DummyOpenAIClient))

    api_key = "dummy_api_key"
    model_name = "deepseek-coder-v1"
    temperature = 0.5

    deepseek = model_module.DeepSeekModel(api_key=api_key, model=model_name, temperature=temperature)

    assert deepseek.api_key if hasattr(deepseek, "api_key") else True  # api_key is stored in client, so just check client
    assert deepseek.model == model_name
    assert deepseek.temperature == temperature
    assert deepseek.model_type == model_module.MODEL_DEEPSEEK
    assert hasattr(deepseek, "client")
    assert hasattr(deepseek, "func_call_history")
    assert isinstance(deepseek.func_call_history, list)


def test_load_model_returns_deepseek_model(monkeypatch):
    # Patch get_config to return DeepSeek platform and api_key
    monkeypatch.setattr(model_module, "get_config", lambda: {"platform": model_module.MODEL_DEEPSEEK, "api_key": "key123"})

    # Patch DeepSeekModel __init__ to record call and return dummy instance
    called = {}

    original_deepseek_init = model_module.DeepSeekModel.__init__

    def dummy_init(self, api_key, model, temperature=0.7):
        called["called"] = True
        called["api_key"] = api_key
        called["model"] = model
        called["temperature"] = temperature
        # Call original __init__ to keep attributes
        original_deepseek_init(self, api_key, model, temperature)

    monkeypatch.setattr(model_module.DeepSeekModel, "__init__", dummy_init)

    # Call load_model with no model_name (should default to None)
    m = model_module.load_model("some_dir", None)

    assert called.get("called") is True
    assert called.get("api_key") == "key123"
    assert isinstance(m, model_module.DeepSeekModel)


def test_deepseek_model_query_and_stream(monkeypatch):
    # Setup dummy openai client and chat completions
    class DummyToolCall:
        def __init__(self):
            self.function = types.SimpleNamespace(name="search_function", arguments=json.dumps({"query": "test"}))
            self.id = "toolcallid"

    class DummyMessage:
        def __init__(self):
            self.tool_calls = [DummyToolCall()]
            self.content = "response content"

    class DummyChoice:
        def __init__(self):
            self.message = DummyMessage()
            self.delta = types.SimpleNamespace(content="streamed content", tool_calls=None)

    class DummyCompletion:
        def __init__(self):
            self.choices = [DummyChoice()]

    class DummyStreamChunk:
        def __init__(self, content=None, tool_calls=None):
            self.choices = [types.SimpleNamespace(delta=types.SimpleNamespace(content=content, tool_calls=tool_calls))]

    class DummyChat:
        def __init__(self):
            self.completions = MagicMock()

        def create(self, **kwargs):
            if kwargs.get("stream", False):
                # Return iterable of DummyStreamChunk
                return [
                    DummyStreamChunk(content="Hello ", tool_calls=None),
                    DummyStreamChunk(content="World!", tool_calls=None),
                ]
            else:
                return DummyCompletion()

    class DummyOpenAIClient:
        def __init__(self, api_key=None, base_url=None):
            self.chat = DummyChat()

    # Patch importlib.util.find_spec and import_module to simulate openai presence
    monkeypatch.setattr(model_module.importlib.util, "find_spec", lambda name: True)
    monkeypatch.setattr(model_module.importlib, "import_module", lambda name: types.SimpleNamespace(OpenAI=DummyOpenAIClient))

    # Patch get_function to a dummy function that returns fixed string
    monkeypatch.setattr(model_module, "get_function", lambda name: lambda **kwargs: "function result")

    # Patch process_function_name to identity
    monkeypatch.setattr(model_module, "process_function_name", lambda name: name)

    deepseek = model_module.DeepSeekModel(api_key="key", model="deepseek-coder")

    # Test query without functions (should return content)
    chat_history = [{"role": "user", "content": "Hello"}]
    result = deepseek.query(chat_history)
    assert isinstance(result, str)
    assert "response content" in result

    # Test stream yields expected strings
    chat_history = [{"role": "user", "content": "Hello"}]
    stream_output = list(deepseek.stream(chat_history))
    assert "".join(stream_output).startswith("Hello")
    assert "".join(stream_output).endswith("World!")


def test_new_command_includes_deepseek(monkeypatch):
    # Patch questionary.select to record choices and return 'DeepSeek'
