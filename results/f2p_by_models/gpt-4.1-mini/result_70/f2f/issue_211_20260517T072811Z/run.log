[32mimport json
import types
import pytest
from unittest.mock import MagicMock

import mle.model as model_module
import mle.cli as cli


@pytest.mark.parametrize("model_name", ["deepseek-coder", None])
def test_deepseek_model_init_and_attributes(monkeypatch, model_name):
    # Patch importlib.util.find_spec to simulate openai installed
    monkeypatch.setattr(model_module.importlib.util, "find_spec", lambda name: True)

    # Patch importlib.import_module to return dummy OpenAI client class
    class DummyOpenAIClient:
        def __init__(self, api_key=None, base_url=None):
            self.api_key = api_key
            self.base_url = base_url
            self.chat = MagicMock()

    dummy_openai_module = types.SimpleNamespace(OpenAI=DummyOpenAIClient)
    monkeypatch.setattr(model_module.importlib, "import_module", lambda name: dummy_openai_module)

    # Instantiate DeepSeekModel
    ds_model = model_module.DeepSeekModel(api_key="key", model=model_name)

    # Check attributes
    assert ds_model.api_key == "key" or hasattr(ds_model, "client")
    assert ds_model.model == (model_name if model_name else "deepseek-coder")
    assert ds_model.model_type == model_module.MODEL_DEEPSEEK
    assert ds_model.temperature == 0.7
    assert hasattr(ds_model.client, "chat")


def test_load_model_returns_deepseek_model(monkeypatch):
    # Patch get_config to return DeepSeek platform and api_key
    monkeypatch.setattr(model_module, "get_config", lambda project_dir: {
        "platform": model_module.MODEL_DEEPSEEK,
        "api_key": "dummy_key"
    })

    # Patch DeepSeekModel to a dummy class to detect instantiation
    class DummyDeepSeekModel:
        def __init__(self, api_key, model):
            self.api_key = api_key
            self.model = model

    monkeypatch.setattr(model_module, "DeepSeekModel", DummyDeepSeekModel)

    # Call load_model with a model_name
    model_instance = model_module.load_model("dummy_dir", "deepseek-coder")

    assert isinstance(model_instance, DummyDeepSeekModel)
    assert model_instance.api_key == "dummy_key"
    assert model_instance.model == "deepseek-coder"


def test_deepseek_model_query_and_stream(monkeypatch):
    # Patch importlib.util.find_spec to simulate openai installed
    monkeypatch.setattr(model_module.importlib.util, "find_spec", lambda name: True)

    # Prepare dummy chat completion response for query and stream
    class DummyToolCall:
        def __init__(self):
            self.function = types.SimpleNamespace(name="search_function", arguments=json.dumps({"q": "test"}))
            self.id = "tool_call_id_1"

    class DummyMessage:
        def __init__(self):
            self.tool_calls = [DummyToolCall()]
            self.content = "response content"

    class DummyChoice:
        def __init__(self, message=None, delta=None):
            self.message = message
            self.delta = delta

    class DummyCompletion:
        def __init__(self, choices):
            self.choices = choices

    class DummyDelta:
        def __init__(self):
            self.tool_calls = [DummyToolCall()]
            self.content = "streamed content"

    class DummyClientChatCompletions:
        def __init__(self):
            self.create = MagicMock()

    class DummyClientChat:
        def __init__(self):
            self.completions = DummyClientChatCompletions()

    class DummyOpenAIClient:
        def __init__(self, api_key=None, base_url=None):
            self.api_key = api_key
            self.base_url = base_url
            self.chat = DummyClientChat()

    dummy_openai_module = types.SimpleNamespace(OpenAI=DummyOpenAIClient)
    monkeypatch.setattr(model_module.importlib, "import_module", lambda name: dummy_openai_module)

    # Patch get_function to a dummy function that returns a fixed string
    monkeypatch.setattr(model_module, "get_function", lambda name: lambda **kwargs: "function result")

    # Patch process_function_name to return the function name unchanged
    monkeypatch.setattr(model_module, "process_function_name", lambda name: name)

    # Instantiate DeepSeekModel
    ds_model = model_module.DeepSeekModel(api_key="key", model="deepseek-coder")

    # Setup the dummy client's chat.completions.create for query (stream=False)
    def dummy_create_query(**kwargs):
        msg = DummyMessage()
        return DummyCompletion([DummyChoice(message=msg)])

    ds_model.client.chat.completions.create = dummy_create_query

    chat_history = [{"role": "user", "content": "Hello"}]
    result = ds_model.query(chat_history, functions=[{
        "name": "search_function",
        "parameters": {"type": "object", "properties": {"q": {"type": "string"}}}
    }])
    assert isinstance(result, str)
    assert "response content" in result or "function result" in result

    # Setup the dummy client's chat.completions.create for stream (stream=True)
    def dummy_create_stream(**kwargs):
        # Yield two chunks: one with tool_calls, one with content
        yield types.SimpleNamespace(choices=[DummyChoice(delta=DummyDelta())])
        # Second chunk without tool_calls to yield content
        dummy_delta_no_tool = types.SimpleNamespace(tool_calls=None, content="final content")
        yield types.SimpleNamespace(choices=[DummyChoice(delta=dummy_delta_no_tool)])

    ds_model.client.chat.completions.create = dummy_create_stream

    stream_output = list(ds_model.stream(chat_history))
    assert any(isinstance(chunk, str) for chunk in stream_output)
    assert any("final content" in chunk for chunk in stream_output)


def test_new_command_includes_deepseek(monkeypatch):
    # Patch questionary.select to capture choices and return 'DeepSeek'
    class DummyQuestionary:
        def __init__(self):
            self.choices = None
            self.prompted = False

        def select(self, message, choices):
            self.choices = choices
            self.prompted = True
            return self

        def ask(self):
            return "DeepSeek"

        def password(self, message):
            return "dummy_api_key"

    dummy_questionary = DummyQuestionary()
    monkeypatch.setattr(cli, "questionary", dummy_questionary)

    # Patch console.log to no-op
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Call new() and check that DeepSeek is in choices and api_key is requested
    # We only test that the platform selection includes DeepSeek and api_key is asked
    # We do not test full new() behavior as it may exit early
    # We simulate minimal input to reach DeepSeek branch
    # Patch questionary.password to return dummy key for DeepSeek
    monkeypatch.setattr(cli.questionary, "password", lambda msg: "dummy_api_key")

    # Patch input to simulate user input for new command
    # We call new() with a dummy name
    # It should not raise and should include DeepSeek in platform choices
    # We test by calling new() and catching any early returns
    try:
        cli.new("dummy_project")
    except Exception:
        # Ignore exceptions from incomplete flow
        pass

    assert "DeepSeek" in dummy_questionary.choices


