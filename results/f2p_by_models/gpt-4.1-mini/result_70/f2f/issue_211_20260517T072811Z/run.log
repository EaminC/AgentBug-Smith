def test_deepseek_model_init_and_attributes():
    # Test DeepSeekModel initialization and basic attributes
    api_key = "dummy_key"
    model_name = "deepseek-coder"
    ds_model = model_mod.DeepSeekModel(api_key=api_key, model=model_name, temperature=0.5)
    assert ds_model.api_key == api_key or hasattr(ds_model, "client")
    assert ds_model.model == model_name
    assert ds_model.temperature == 0.5
    assert ds_model.model_type == model_mod.MODEL_DEEPSEEK
    assert hasattr(ds_model, "client")
    assert hasattr(ds_model, "func_call_history")
    assert isinstance(ds_model.func_call_history, list)


@pytest.mark.parametrize("model_name", ["deepseek-coder", None])
def test_load_model_returns_deepseek_model(model_name):
    # Patch get_config to return a config with platform DeepSeek and api_key
    monkeypatch = pytest.MonkeyPatch()
    monkeypatch.setattr(model_mod, "get_config", lambda project_dir=None: {
        "platform": model_mod.MODEL_DEEPSEEK,
        "api_key": "dummy_api_key"
    })
    # Call load_model with DeepSeek platform config
    ds_model = model_mod.load_model(project_dir=".", model_name=model_name)
    monkeypatch.undo()
    assert isinstance(ds_model, model_mod.DeepSeekModel)
    # model attribute should be model_name or default
    expected_model = model_name if model_name else "deepseek-coder"
    assert ds_model.model == expected_model


def test_deepseek_model_query_and_stream(monkeypatch):
    # Create a DeepSeekModel instance
    ds_model = model_mod.DeepSeekModel(api_key="dummy", model="deepseek-coder")

    # Patch get_function to a dummy function that returns a fixed string
    monkeypatch.setattr(model_mod, "get_function", lambda name: lambda **kwargs: "function result")

    # Patch process_function_name to just return the name unchanged
    monkeypatch.setattr(model_mod, "process_function_name", lambda name: name)

    # Prepare a chat history with one user message
    chat_history = [{"role": "user", "content": "Hello"}]

    # Test query with no functions (should return response content)
    response = ds_model.query(chat_history)
    assert isinstance(response, str)
    assert "response content" in response

    # Test query with functions that triggers tool call
    # We simulate a tool call by patching the client's chat.completions.create to return a response with tool_calls
    tool_call = types.SimpleNamespace(
        id="call1",
        function=types.SimpleNamespace(
            name="search",
            arguments=json.dumps({"query": "test"})
        )
    )
    resp_message = types.SimpleNamespace(
        content="",
        tool_calls=[tool_call]
    )
    completion = types.SimpleNamespace(
        choices=[types.SimpleNamespace(message=resp_message)]
    )

    def fake_create(**kwargs):
        return completion

    monkeypatch.setattr(ds_model.client.chat.completions, "create", fake_create)

    # The query should recursively call itself and eventually return a string
    result = ds_model.query(chat_history, functions=[{
        "name": "search",
        "parameters": {}
    }])
    assert isinstance(result, str)

    # Test stream method yields strings
    # Patch the client's chat.completions.create to yield chunks with no tool_calls
    def fake_stream_create(**kwargs):
        chunk = types.SimpleNamespace(
            choices=[types.SimpleNamespace(delta=types.SimpleNamespace(content="streamed chunk"))]
        )
        yield chunk

    monkeypatch.setattr(ds_model.client.chat.completions, "create", fake_stream_create)

    stream_output = list(ds_model.stream(chat_history))
    assert all(isinstance(chunk, str) for chunk in stream_output)
    assert any("streamed" in chunk for chunk in stream_output)


def test_new_command_includes_deepseek(monkeypatch):
    # Patch questionary.select to capture choices and return 'DeepSeek'
    choices_captured = {}

    def fake_select(message, choices):
        choices_captured["choices"] = choices
        return "DeepSeek"

    monkeypatch.setattr(cli.questionary, "select", fake_select)

    # Patch questionary.password to return a dummy key
    monkeypatch.setattr(cli.questionary, "password", lambda message: "dummy_key")

    # Patch console.log to no-op
    monkeypatch.setattr(cli.console, "log", lambda msg: None)

    # Patch return to prevent actual further execution
    monkeypatch.setattr(cli, "new", lambda name=None: None)

    # Call new() function with a dummy name
    # We just want to verify DeepSeek is in the choices
    cli.new("testname")
    assert "DeepSeek" in choices_captured["choices"]


