ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly_key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

WORKDIR /app

# Copy entire repository
COPY . .

# Upgrade pip and setuptools
RUN python3 -m pip install --upgrade pip setuptools wheel

# Conditional install logic for Python
# Using requirements.txt if present
RUN if [ -f requirements.txt ]; then \
        pip install -r requirements.txt && pip install -e . ; \
    elif [ -f pyproject.toml ] && [ -f poetry.lock ]; then \
        pip install poetry && poetry install && pip install -e . ; \
    elif [ -f pyproject.toml ]; then \
        pip install -e . ; \
    else \
        echo "No recognized Python dependency file found." ; \
    fi

# Ensure test tooling is installed regardless of install method
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm || true

# Preflight test to verify pytest
RUN python3 -c "import pkg_resources, pytest; print('preflight ok')"

CMD ["/bin/bash"]

