    ANTHROPIC_AUTH_TOKEN=forge-key

# Install Python 3, pip, and build tools for Python dependencies
RUN apt-get update \
 && apt-get install -y python3 python3-pip python3-venv build-essential \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the entire repository into the container
COPY . .

# Build the Rust workspace in release mode
RUN cargo build --release

# Install Python client dependencies for clients/python-asyncio
WORKDIR /app/clients/python-asyncio

# Upgrade pip and setuptools, install dependencies from pyproject.toml, install package and test tools
RUN pip3 install --upgrade pip setuptools wheel \
 && pip3 install -r pyproject.toml \
 && pip3 install -e . \
 && pip3 install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# Reset working directory back to repo root
WORKDIR /app

# Default command to run bash shell for test harness
CMD ["/bin/bash"]

# branch: rust + python hybrid with Forge API env configuration
