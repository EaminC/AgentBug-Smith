WORKDIR /app

# Copy entire repo to ensure all files and test scripts are included
COPY . .

# Install main project dependencies, detect package manager via lockfiles
RUN if [ -f "yarn.lock" ]; then \
      yarn install; \
    elif [ -f "package-lock.json" ]; then \
      npm ci; \
    elif [ -f "package.json" ]; then \
      npm install; \
    else \
      echo "No recognized package manager lockfile found, skipping dependency installation"; \
    fi

# Ensure test utilities are installed
RUN npm install --no-save jest mocha || true

# Set Forge API environment variables for OpenAI-compatible SDK and Anthropic-compatible SDK
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Final CMD required for testing environment
CMD ["/bin/bash"]

