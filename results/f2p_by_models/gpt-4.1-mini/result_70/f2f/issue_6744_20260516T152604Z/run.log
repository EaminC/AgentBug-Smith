# --- end inject ---

# Set Forge API environment variables for OpenAI and Anthropic SDK compatibility
ENV FORGE_API_KEY="forge-key"
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

# Copy the entire repository into the container
COPY . .

# Install project dependencies with detected package manager
RUN if [ -f "package-lock.json" ]; then \
      npm ci && npm run build || true; \
    elif [ -f "yarn.lock" ]; then \
      npm install -g yarn && yarn install && yarn build || true; \
    elif [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm && pnpm install && pnpm run build || true; \
    elif [ -f "package.json" ]; then \
      npm install && npm run build || true; \
    else \
      echo "No node package manager lockfile found; skipping install"; \
    fi

# Install standard JavaScript test tools
RUN npm install --no-save jest mocha || true

CMD ["/bin/bash"]

# branch: nodejs/runtime
