      npm install; \
    else \
      echo "No recognized package manager lockfile found, skipping dependency installation"; \
    fi

# Install standard test utilities needed for JS testing
RUN npm install --no-save jest mocha || true

# Final CMD for test environment
CMD ["/bin/bash"]

