[32mFROM node:22-alpine AS test_builder

WORKDIR /app

# Install dependencies and test tooling, run tests
RUN apk add --no-cache bash

COPY . .

# Install all dependencies including devDependencies
RUN if [ -f "clients/python/package.json" ]; then \
      cd clients/python && \
      npm install && \
      # Assumption: Use npm test or similar if tests exist, fallback to no test if none found
      if npm run | grep -q " test"; then npm test; fi \
    ; else echo "No clients/python/package.json found, skipping npm install"; fi

# Preflight check for Node.js environment sanity: check node and npm versions
RUN node -v && npm -v

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Minimal runtime image with only production dependencies installed
FROM node:22-alpine AS runtime

WORKDIR /app

