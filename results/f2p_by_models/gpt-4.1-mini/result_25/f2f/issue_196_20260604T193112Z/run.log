import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_gomoku_win_detection_order():
    """
    This test verifies that the BoardAgent correctly detects a win condition immediately after placing
    the winning piece on the board, not before updating the board state.

    Buggy behavior:
        - The code checks for a win before placing the piece on the board.
        - This causes the win detection to fail when the winning move is placed.

    Fixed behavior:
        - The code places the piece on the board first.
        - Then checks for a draw.
        - Then checks for a win.
        - This correctly detects the win immediately.

    The test simulates a sequence of moves leading to a horizontal win for black.
    It asserts that the game ends with black winning right after the winning move.
    """

    # Initialize a fresh game agent
    agent = BoardAgent()
    agent.game_end = False

    # Pre-fill the board to create a horizontal line of 4 black pieces at row 7, columns 3-6
    row = 7
    for col in range(3, 7):
        agent.board[row, col] = NAME_TO_PIECE[NAME_BLACK]

    # The next move at (7,7) by black should complete five in a row horizontally and win the game

    # Compose the move dict as expected by reply()
    move = {
        "name": NAME_BLACK,
        "content": (row, 7),
    }

    # Call reply with the winning move
    agent.reply(move)

    # After the move, the game should be ended
    assert agent.game_end is True, "Game should be ended after winning move"

    # The board at (7,7) should be set to black piece
    assert agent.board[row, 7] == NAME_TO_PIECE[NAME_BLACK], "Winning piece should be placed on board"

    # The content message should indicate black wins
    last_msg = agent._history[-1] if hasattr(agent, "_history") else None
    # fallback: check the last message spoken by agent.speak if accessible
    # Since no direct access, we check reply returns dict with content or rely on internal state
    # Instead, we call reply again with None to get current prompt and check no game_end message
    # But to keep simple, we check that game_end is True which implies winning message was set

    # Also test that no draw is declared
    assert not agent.check_draw(), "Game should not be a draw after winning move"


def test_gomoku_no_premature_win():
    """
    This test verifies that the game does not declare a win before the winning piece is placed on the board.
    It simulates placing four black pieces in a row and then tries to check win before placing the fifth.
    The buggy code would detect win prematurely or fail to detect after placing.
    """

    agent = BoardAgent()
    agent.game_end = False

    row = 5
    # Place 4 black pieces in a row
    for col in range(2, 6):
        agent.board[row, col] = NAME_TO_PIECE[NAME_BLACK]

    # Simulate a move at (row,6) by black but do NOT place it on board yet
    # The buggy code checks win before placing, so it might falsely detect win here
    # We simulate this by calling check_win directly before placing
    win_before_placing = agent.check_win(row, 6, NAME_TO_PIECE[NAME_BLACK])
    assert win_before_placing is False, "Win should not be detected before placing the piece"

    # Now place the piece and check win again
    agent.board[row, 6] = NAME_TO_PIECE[NAME_BLACK]
    win_after_placing = agent.check_win(row, 6, NAME_TO_PIECE[NAME_BLACK])
    assert win_after_placing is True, "Win should be detected after placing the piece"


def test_full_game_simulation_black_wins():
    """
    Simulate a minimal game where black wins by placing five pieces in a row.
    This test ensures the game ends immediately after the winning move.
    """

    agent = BoardAgent()
    agent.game_end = False

    # Moves sequence: black and white alternate, black tries to win horizontally at row 10
    moves = [
        (NAME_BLACK, (10, 0)),
        (NAME_WHITE, (0, 0)),
        (NAME_BLACK, (10, 1)),
        (NAME_WHITE, (0, 1)),
        (NAME_BLACK, (10, 2)),
        (NAME_WHITE, (0, 2)),
        (NAME_BLACK, (10, 3)),
        (NAME_WHITE, (0, 3)),
    ]

    # Play moves before winning move
    for name, pos in moves:
        agent.reply({"name": name, "content": pos})
        assert agent.game_end is False, "Game should not end before winning move"

    # Winning move by black at (10,4)
    agent.reply({"name": NAME_BLACK, "content": (10, 4)})

    # Game should end now
    assert agent.game_end is True, "Game should end after black's winning move"

    # The board at (10,4) should be black piece
    assert agent.board[10, 4] == NAME_TO_PIECE[NAME_BLACK], "Winning piece should be placed on board"


def test_draw_detection_after_last_move():
    """
    Test that the game detects a draw correctly if the board is full without any winner.
    This indirectly tests that the win check is done after placing the piece.
    """

    agent = BoardAgent()
    agent.game_end = False

    # Fill the board except one cell with alternating pieces without any 5 in a row
    size = agent.board.shape[0]
    for r in range(size):
        for c in range(size):
            if (r, c) == (size - 1, size - 1):
                continue
            # Alternate black and white pieces
            piece = NAME_TO_PIECE[NAME_BLACK] if (r + c) % 2 == 0 else NAME_TO_PIECE[NAME_WHITE]
            agent.board[r, c] = piece

    # The last move fills the last cell with black
    last_move = (size - 1, size - 1)
    agent.reply({"name": NAME_BLACK, "content": last_move})

    # The game should end in a draw
    assert agent.game_end is True, "Game should end after last move with a draw"
    assert agent.check_draw() is True, "Draw should be detected on full board with no winner"


