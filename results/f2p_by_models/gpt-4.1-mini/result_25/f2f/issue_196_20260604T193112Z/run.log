import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_gomoku_win_detection_order():
    """
    This test simulates a sequence of moves leading to a win condition for Black.
    It verifies that the game ends immediately after the winning move is placed on the board.
    The buggy code checks for win before placing the piece, so it misses the win.
    The fix places the piece first, then checks for win, so the test passes after fix.
    """
    agent = BoardAgent()

    # Start the game (no move)
    reply = agent.reply()
    assert "Welcome to the Gomoku game" in reply["content"]
    assert not agent.game_end

    # Moves sequence: Black and White alternate, Black will win on 5th black stone horizontally
    moves = [
        (NAME_BLACK, (7, 7)),
        (NAME_WHITE, (6, 7)),
        (NAME_BLACK, (7, 8)),
        (NAME_WHITE, (6, 8)),
        (NAME_BLACK, (7, 9)),
        (NAME_WHITE, (6, 9)),
        (NAME_BLACK, (7, 10)),
        (NAME_WHITE, (6, 10)),
        # The winning move for Black
        (NAME_BLACK, (7, 11)),
    ]

    for i, (player, pos) in enumerate(moves):
        reply = agent.reply({"name": player, "content": pos})
        if i < len(moves) - 1:
            # Before the last move, game should not end
            assert not agent.game_end, f"Game ended prematurely at move {i+1}"
            # The content should prompt next player
            next_player = NAME_BLACK if player == NAME_WHITE else NAME_WHITE
            assert next_player in reply["content"]
        else:
            # After last move, game should end with Black wins
            assert agent.game_end, "Game did not end after winning move"
            assert f"{NAME_BLACK} wins" in reply["content"], "Winning message missing or incorrect"

    # Also verify the board state: positions of black stones are set correctly
    for player, pos in moves:
        r, c = pos
        expected_piece = NAME_TO_PIECE[player]
        assert agent.board[r, c] == expected_piece, f"Board position {pos} not set correctly"


def test_gomoku_no_false_win_before_placing():
    """
    This test tries to simulate the buggy behavior:
    If the code checks for win before placing the piece, it will not detect the win.
    We test that after placing the winning move, the game ends.
    """
    agent = BoardAgent()

    # Pre-fill the board with 4 black stones horizontally at row 7, columns 7 to 10
    for col in range(7, 11):
        agent.board[7, col] = NAME_TO_PIECE[NAME_BLACK]

    # White moves somewhere else
    reply = agent.reply({"name": NAME_WHITE, "content": (6, 7)})
    assert not agent.game_end

    # Now Black places the 5th stone at (7, 11) to win
    reply = agent.reply({"name": NAME_BLACK, "content": (7, 11)})

    # The buggy code would not detect win here (game_end False), fixed code detects win (game_end True)
    assert agent.game_end, "Game did not end after placing winning stone"
    assert f"{NAME_BLACK} wins" in reply["content"], "Winning message missing or incorrect"


def test_gomoku_draw_detection():
    """
    This test fills the board almost completely without any winner,
    then places the last move to trigger draw detection.
    """
    agent = BoardAgent()

    # Fill the board with alternating pieces except last cell
    size = agent.board.shape[0]
    for r in range(size):
        for c in range(size):
            if (r, c) == (size - 1, size - 1):
                continue
            # Alternate black and white pieces
            agent.board[r, c] = NAME_TO_PIECE[NAME_BLACK if (r + c) % 2 == 0 else NAME_WHITE]

    # The game should not be ended yet
    agent.game_end = False

    # Place the last move (white) to fill the board
    reply = agent.reply({"name": NAME_WHITE, "content": (size - 1, size - 1)})

    # The game should end in a draw
    assert agent.game_end, "Game did not end after last move filling the board"
    assert "draw" in reply["content"].lower(), "Draw message missing or incorrect"


