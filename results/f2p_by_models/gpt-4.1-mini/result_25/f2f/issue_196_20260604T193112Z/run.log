[32mimport pytest
import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_gomoku_win_detection_order():
    """
    This test verifies that the BoardAgent correctly detects a win condition
    immediately after placing the winning piece on the board.

    Buggy behavior:
        The code checks for a win before placing the piece on the board,
        causing it to miss the win condition triggered by the current move.

    Fixed behavior:
        The piece is placed on the board first, then the win is checked,
        correctly detecting the win.

    The test simulates a sequence of moves leading to a horizontal win for black.
    It asserts that the game ends with black winning immediately after the winning move.
    """

    agent = BoardAgent()
    # Start the game with no moves
    reply = agent.reply(None)
    assert "Welcome to the Gomoku game" in reply["content"]

    # Define a helper to simulate a move by an agent name and position
    def make_move(agent_obj, name, row, col):
        move = {"name": name, "content": (row, col)}
        reply = agent_obj.reply(move)
        return reply

    # Place four black pieces in a row horizontally at row 7, columns 3 to 6
    for col in range(3, 7):
        reply = make_move(agent, NAME_BLACK, 7, col)
        # After each move, game should not end
        assert not agent.game_end
        assert "wins" not in reply["content"].lower()

        # Alternate with white moves somewhere else (to keep turns)
        reply = make_move(agent, NAME_WHITE, 0, col)
        assert not agent.game_end
        assert "wins" not in reply["content"].lower()

    # Now place the 5th black piece to complete a horizontal line at (7,7)
    reply = make_move(agent, NAME_BLACK, 7, 7)

    # After this move, the game should end and black should be declared winner
    assert agent.game_end
    assert f"{NAME_BLACK} wins" in reply["content"].lower()


def test_gomoku_win_detection_diagonal():
    """
    Test a diagonal win condition detection.

    The test places pieces diagonally from (5,5) to (9,9) for black,
    alternating with white moves elsewhere.

    The game should end immediately after the 5th diagonal black piece is placed.
    """
    agent = BoardAgent()
    agent.reply(None)  # start game

    # Place four black pieces diagonally
    for i in range(4):
        reply = agent.reply({"name": NAME_BLACK, "content": (5 + i, 5 + i)})
        assert not agent.game_end
        assert "wins" not in reply["content"].lower()

        # White moves elsewhere
        reply = agent.reply({"name": NAME_WHITE, "content": (0, i)})
        assert not agent.game_end
        assert "wins" not in reply["content"].lower()

    # Place the 5th black piece diagonally to win
    reply = agent.reply({"name": NAME_BLACK, "content": (9, 9)})
    assert agent.game_end
    assert f"{NAME_BLACK} wins" in reply["content"].lower()


def test_gomoku_no_false_win_before_placing_piece():
    """
    This test ensures that the win is not detected before the piece is placed on the board.

    It tries to simulate the buggy scenario by checking the board state before and after move.
    """

    agent = BoardAgent()
    agent.reply(None)  # start game

    # Place four black pieces horizontally at row 10, columns 1 to 4
    for col in range(1, 5):
        agent.board[10, col] = NAME_TO_PIECE[NAME_BLACK]

    # The next move is at (10,5) to complete five in a row
    # Before placing the piece, check_win should be False because the piece is not on board yet
    # But the buggy code checks win before placing, so it would miss the win

    # We simulate the buggy behavior by calling check_win before placing
    win_before = agent.check_win(10, 5, NAME_TO_PIECE[NAME_BLACK])
    # It should be False because the piece is not placed yet
    assert not win_before

    # Now place the piece
    agent.board[10, 5] = NAME_TO_PIECE[NAME_BLACK]

    # After placing, check_win should be True
    win_after = agent.check_win(10, 5, NAME_TO_PIECE[NAME_BLACK])
    assert win_after


def test_gomoku_draw_detection():
    """
    Test that the draw condition is detected correctly.

    Fill the board with alternating pieces but no five in a row.
    """

    agent = BoardAgent()
    agent.reply(None)  # start game

    size = agent.board.shape[0]
    # Fill the board with alternating pieces, no five in a row
    for row in range(size):
        for col in range(size):
            agent.board[row, col] = NAME_TO_PIECE[NAME_BLACK if (row + col) % 2 == 0 else NAME_WHITE]

    # The board is full, so check_draw should be True
    assert agent.check_draw()

    # The game_end flag should be False initially
    assert not agent.game_end

    # Simulate a move triggering draw check
    reply = agent.reply({"name": NAME_BLACK, "content": (0, 0)})

    # After reply, game_end should be True due to draw
    assert agent.game_end
    assert "draw" in reply["content"].lower() or "draw" in reply["content"].lower()


if __name__ == "__main__":
    pytest.main([__file__])[0m
