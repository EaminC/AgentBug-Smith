from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_gomoku_win_detection_order():
    """
    Test that the BoardAgent correctly detects a win immediately after the move is placed on the board.
    This test simulates a sequence of moves leading to a horizontal win for black.
    The buggy code checks win before placing the piece, so it would fail to detect the win.
    The fixed code places the piece first, then checks for win, so it should detect the win correctly.
    """

    agent = BoardAgent()

    # Start the game, expect welcome message
    reply = agent.reply()
    assert "Welcome to the Gomoku game" in reply["content"]

    # Define a sequence of moves leading to a horizontal win for black (NAME_BLACK)
    # Moves alternate between black and white
    moves = [
        (NAME_BLACK, (7, 7)),
        (NAME_WHITE, (6, 7)),
        (NAME_BLACK, (7, 8)),
        (NAME_WHITE, (6, 8)),
        (NAME_BLACK, (7, 9)),
        (NAME_WHITE, (6, 9)),
        (NAME_BLACK, (7, 10)),
        (NAME_WHITE, (6, 10)),
        # The winning move for black: 5 in a row horizontally at row 7, cols 7-11
        (NAME_BLACK, (7, 11)),
    ]

    game_ended = False
    winner_declared = None

    for player_name, (r, c) in moves:
        reply = agent.reply({"name": player_name, "content": (r, c)})
        content = reply["content"]

        if "wins" in content:
            game_ended = True
            winner_declared = player_name
            break
        if "draw" in content:
            game_ended = True
            winner_declared = None
            break

    # The game should end with black winning after the last move
    assert game_ended, "Game should have ended with a win"
    assert winner_declared == NAME_BLACK, f"Expected winner: {NAME_BLACK}, got: {winner_declared}"

    # Also verify the board state: the last move must be placed on the board
    board = agent.board
    assert board[7, 11] == NAME_TO_PIECE[NAME_BLACK], "Last move should be placed on the board"

    # Verify that the winning condition is detected correctly by check_win
    assert agent.check_win(7, 11, NAME_TO_PIECE[NAME_BLACK]), "Winning condition should be detected"


def test_gomoku_no_false_win_before_placing():
    """
    Test that the BoardAgent does not detect a win before placing the piece on the board.
    This test tries to simulate the buggy behavior by checking win before placing the piece.
    The fixed code places the piece first, so the win detection should only be true after placement.
    """

    agent = BoardAgent()

    # Place four black stones horizontally at row 5, columns 5-8
    for col in range(5, 9):
        agent.board[5, col] = NAME_TO_PIECE[NAME_BLACK]

    # Now simulate a move at (5,9) by black, but do NOT place it on the board yet
    # The buggy code checks win before placing, so check_win would return False incorrectly
    # The fixed code places first, so check_win returns True after placement

    # Check win before placing the piece (simulate buggy scenario)
    win_before_placement = agent.check_win(5, 9, NAME_TO_PIECE[NAME_BLACK])
    # This should be False because the piece is not placed yet
    assert not win_before_placement, "Should not detect win before placing the piece"

    # Now place the piece
    agent.board[5, 9] = NAME_TO_PIECE[NAME_BLACK]

    # Check win after placing the piece
    win_after_placement = agent.check_win(5, 9, NAME_TO_PIECE[NAME_BLACK])
    assert win_after_placement, "Should detect win after placing the piece"


def test_gomoku_draw_detection():
    """
    Test that the BoardAgent detects a draw correctly.
    Fill the board with alternating pieces without any 5 in a row.
    """

    agent = BoardAgent()

    size = agent.board.shape[0]

    # Fill the board with alternating black and white pieces without any 5 in a row
    for r in range(size):
        for c in range(size):
            if (r + c) % 2 == 0:
