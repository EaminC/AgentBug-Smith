from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_gomoku_win_detection_order():
    """
    This test verifies that the BoardAgent correctly detects a win immediately after placing the winning piece.
    The buggy code checks for a win before updating the board, causing it to miss the winning move.
    The fix updates the board first, then checks for a win.

    The test simulates a sequence of moves leading to a black win by placing five black pieces in a row.
    It asserts that after the winning move, the game_end flag is True and the content message indicates the winner.
    """

    agent = BoardAgent()

    # Start the game (no input)
    reply = agent.reply()
    assert "Welcome to the Gomoku game" in reply["content"]
    assert agent.game_end is False

    # Define moves to create a horizontal black win at row 7, cols 3..7
    # Alternate black and white moves but black will win on 5th black move
    moves = [
        (NAME_BLACK, (7, 3)),
        (NAME_WHITE, (6, 3)),
        (NAME_BLACK, (7, 4)),
        (NAME_WHITE, (6, 4)),
        (NAME_BLACK, (7, 5)),
        (NAME_WHITE, (6, 5)),
        (NAME_BLACK, (7, 6)),
        (NAME_WHITE, (6, 6)),
        (NAME_BLACK, (7, 7)),  # This move should win the game for black
    ]

    for i, (player, pos) in enumerate(moves):
        reply = agent.reply({"name": player, "content": pos})
        # After each move, the board should be updated
        r, c = pos
        assert agent.board[r, c] == NAME_TO_PIECE[player]

        if i < len(moves) - 1:
            # Before the last move, game should not be ended
            assert agent.game_end is False
            # The content should prompt the next player
            next_player = NAME_BLACK if player == NAME_WHITE else NAME_WHITE
            assert next_player in reply["content"]
        else:
            # After the last move, game should be ended with black win
            assert agent.game_end is True
            assert f"{player} wins" in reply["content"]


def test_gomoku_no_false_win_before_board_update():
    """
    This test tries to detect the buggy behavior:
    If the code checks for win before updating the board, it will not detect the win on the last move.
    We simulate the winning move and assert that the game_end flag is True and content mentions the winner.
    If the test fails (game_end is False), it indicates the bug is present.
    """

    agent = BoardAgent()

    # Play 4 black stones in a row
    for col in range(4):
        agent.reply({"name": NAME_BLACK, "content": (7, col)})
        agent.reply({"name": NAME_WHITE, "content": (6, col)})

    # Now place the 5th black stone to win
    reply = agent.reply({"name": NAME_BLACK, "content": (7, 4)})

    # The game should be ended and black wins
    assert agent.game_end is True, "Game should be ended after winning move"
    assert "Black wins" in reply["content"] or "black wins" in reply["content"].lower()


def test_gomoku_draw_detection():
    """
    This test verifies that the draw detection still works correctly.
    We fill the board almost completely without any winner, then place the last move to trigger a draw.
    """

    agent = BoardAgent()

    size = agent.board.shape[0]

    # Fill the board with alternating pieces except last cell
    for r in range(size):
        for c in range(size):
            if r == size - 1 and c == size - 1:
                continue
            piece = NAME_TO_PIECE[NAME_BLACK if (r + c) % 2 == 0 else NAME_WHITE]
            agent.board[r, c] = piece

    # The board is almost full, no winner
    agent.game_end = False

    # Place last move to fill the board and cause draw
    last_move = (size - 1, size - 1)
    reply = agent.reply({"name": NAME_BLACK, "content": last_move})

    assert agent.game_end is True
    assert "draw" in reply["content"].lower()


