[32mimport pytest
import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_gomoku_win_detection_order():
    """
    This test tries to detect the buggy behavior:
    If the code checks for win before updating the board, it will not detect the win on the last move.
    We simulate a winning move and assert that the game_end flag is True and content mentions the winner.
    If the test fails (game_end is False), it indicates the bug is present.
    """
    # Create a new BoardAgent instance with a required name argument
    agent = BoardAgent(name="test_agent")

    # Start the game (no move yet)
    start_reply = agent.reply(None)
    assert "Welcome" in start_reply["content"]

    # Prepare a board state with four black pieces in a row horizontally at row 7, cols 3-6
    # We will place the fifth piece at (7,7) to win
    for col in range(3, 7):
        agent.board[7, col] = NAME_TO_PIECE[NAME_BLACK]

    # The game should not be ended yet
    assert not agent.game_end

    # Make the winning move for black at (7,7)
    move = {"name": NAME_BLACK, "content": (7, 7)}
    reply = agent.reply(move)

    # After the move, the game should be ended
    assert agent.game_end, "Game should end after winning move"

    # The content should mention that black wins
    assert f"{NAME_BLACK} wins" in reply["content"]


def test_gomoku_no_false_win_before_board_update():
    """
    This test tries to detect the buggy behavior:
    If the code checks for win before updating the board, it will not detect the win on the last move.
    We simulate the winning move and assert that the game_end flag is True and content mentions the winner.
    If the test fails (game_end is False), it indicates the bug is present.
    """
    agent = BoardAgent(name="test_agent2")

    # Setup four white pieces vertically at col 10, rows 4-7
    for row in range(4, 8):
        agent.board[row, 10] = NAME_TO_PIECE[NAME_WHITE]

    # The game should not be ended yet
    assert not agent.game_end

    # Place the fifth white piece at (8,10) to win vertically
    move = {"name": NAME_WHITE, "content": (8, 10)}
    reply = agent.reply(move)

    # The game should be ended
    assert agent.game_end, "Game should end after winning move"

    # The content should mention that white wins
    assert f"{NAME_WHITE} wins" in reply["content"]


def test_gomoku_draw_detection():
    """
    This test verifies that the draw detection still works correctly.
    We fill the board almost completely without any winner, then place the last move to trigger a draw.
    """
    agent = BoardAgent(name="test_agent3")

    # Fill the board with alternating black and white pieces without any 5 in a row
    for r in range(agent.board.shape[0]):
        for c in range(agent.board.shape[1]):
            # Fill all but last cell
            if (r, c) != (agent.board.shape[0] - 1, agent.board.shape[1] - 1):
                agent.board[r, c] = NAME_TO_PIECE[NAME_BLACK if (r + c) % 2 == 0 else NAME_WHITE]

    # The game should not be ended yet
    assert not agent.game_end

    # Place the last piece to fill the board and cause a draw
    last_move = (agent.board.shape[0] - 1, agent.board.shape[1] - 1)
    move = {"name": NAME_BLACK, "content": last_move}
    reply = agent.reply(move)

    # The game should be ended
    assert agent.game_end, "Game should end after last move causing draw"

    # The content should mention a draw
    assert "draw" in reply["content"].lower()[0m
