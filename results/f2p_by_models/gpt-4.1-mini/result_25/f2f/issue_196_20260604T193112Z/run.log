import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_win_detection_after_move():
    """
    This test simulates a sequence of moves leading to a win condition on the board.
    It verifies that the game correctly detects a win immediately after placing the winning piece.
    The buggy code fails because it checks for a win before updating the board with the current move.
    The fix updates the board first, then checks for win, so this test should fail on buggy and pass on fixed.
    """
    agent = BoardAgent()

    # Start the game (no move)
    reply = agent.reply(None)
    assert "Welcome to the Gomoku game" in reply["content"]

    # Define a sequence of moves that leads to a black win horizontally at row 7
    # Black moves first, then White, alternating
    # Moves: black places stones at (7,0), (7,1), (7,2), (7,3), (7,4)
    # White places stones elsewhere to not interfere
    moves = [
        (NAME_BLACK, (7, 0)),
        (NAME_WHITE, (0, 0)),
        (NAME_BLACK, (7, 1)),
        (NAME_WHITE, (0, 1)),
        (NAME_BLACK, (7, 2)),
        (NAME_WHITE, (0, 2)),
        (NAME_BLACK, (7, 3)),
        (NAME_WHITE, (0, 3)),
        (NAME_BLACK, (7, 4)),  # This move should trigger a win for black
    ]

    for i, (player, pos) in enumerate(moves):
        reply = agent.reply({"name": player, "content": pos})
        # After the last move, the game should end with black winning
        if i == len(moves) - 1:
            assert "wins" in reply["content"]
            assert agent.game_end is True
            # The board at the winning position must be updated correctly
            r, c = pos
            assert agent.board[r, c] == NAME_TO_PIECE[player]
        else:
            # Before the last move, the game should not end
            assert agent.game_end is False
            # The board must contain the last move played
            r, c = pos
            assert agent.board[r, c] == NAME_TO_PIECE[player]


def test_no_win_before_board_update():
    """
    This test ensures that before the fix, the win check is done before updating the board,
    so the last move is not counted and the win is not detected.
    After the fix, the win is detected correctly.
    We test this by placing 4 stones in a row, then placing the 5th and checking the win.
    """
    agent = BoardAgent()

    # Place 4 black stones in a row at (5,0), (5,1), (5,2), (5,3)
    for col in range(4):
        reply = agent.reply({"name": NAME_BLACK, "content": (5, col)})
        assert agent.game_end is False

        # White moves somewhere else
        reply = agent.reply({"name": NAME_WHITE, "content": (0, col)})
        assert agent.game_end is False

    # Now place the 5th stone at (5,4) which should trigger a win
    reply = agent.reply({"name": NAME_BLACK, "content": (5, 4)})

    # The content should indicate black wins
    assert "wins" in reply["content"]
    assert agent.game_end is True
    # The board must have updated the last move
    assert agent.board[5, 4] == NAME_TO_PIECE[NAME_BLACK]


def test_draw_detection():
    """
    This test fills the board without any winning condition to trigger a draw.
    It verifies that the game ends with a draw message.
    This indirectly tests that the board updates correctly and the draw check works.
    """
    agent = BoardAgent()

    size = agent.board.shape[0]

    # Fill the board in a checkerboard pattern without any 5 in a row
    # Alternate black and white pieces
    for r in range(size):
