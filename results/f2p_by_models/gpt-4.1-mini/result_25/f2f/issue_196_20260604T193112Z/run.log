def test_gomoku_win_detection_order():
    """
    Test the win detection logic in BoardAgent.reply for Gomoku.
    The buggy code checks win before updating the board, missing the current move,
    so a winning move is not detected correctly.
    The fixed code updates the board first, then checks win, detecting the win correctly.

    This test simulates a sequence of moves leading to a win for black.
    It asserts that the game ends with black winning immediately after the winning move.
    """

    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent()

    # Start the game (no input)
    reply = agent.reply()
    assert "Welcome to the Gomoku game" in reply["content"]

    # Simulate moves leading to black win horizontally at row 7
    # Black moves at (7,0), (7,1), (7,2), (7,3)
    # White moves at (6,0), (6,1), (6,2), (6,3) to alternate turns
    moves = [
        (NAME_BLACK, (7, 0)),
        (NAME_WHITE, (6, 0)),
        (NAME_BLACK, (7, 1)),
        (NAME_WHITE, (6, 1)),
        (NAME_BLACK, (7, 2)),
        (NAME_WHITE, (6, 2)),
        (NAME_BLACK, (7, 3)),
        (NAME_WHITE, (6, 3)),
    ]

    for name, pos in moves:
        reply = agent.reply({"name": name, "content": pos})
        # After each move except last black move, game should not end
        assert not agent.game_end

    # Now the winning move for black at (7,4)
    reply = agent.reply({"name": NAME_BLACK, "content": (7, 4)})

    # The game should end with black winning
    assert agent.game_end
    assert f"{NAME_BLACK} wins" in reply["content"]


