            else:
                agent.board[r, c] = NAME_TO_PIECE[NAME_WHITE]

    # The board is full, no winner
    assert agent.check_draw(), "The game should be detected as a draw"
    # No win for either side
    for r in range(size):
        for c in range(size):
            assert not agent.check_win(r, c, NAME_TO_PIECE[NAME_BLACK])
