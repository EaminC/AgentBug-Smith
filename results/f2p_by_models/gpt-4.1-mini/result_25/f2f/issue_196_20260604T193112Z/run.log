[32mimport pytest
import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_gomoku_win_detection_order():
    """
    This test verifies the fix for issue #196:
    The board must be updated with the current move before checking for a win.
    The buggy code checks win before updating the board, causing missed wins.

    We simulate a scenario where the last move creates a five-in-a-row horizontally.
    The test expects the game to end with the current player winning immediately after the move.

    On the buggy code, the test should fail because the win is not detected correctly.
    After the fix, the test should pass.
    """

    agent = BoardAgent()
    agent.game_end = False

    # Reset board to empty
    agent.board = np.zeros_like(agent.board)

    # Simulate moves to create a horizontal four in a row for black at row 7, columns 3-6
    row = 7
    for col in range(3, 7):
        agent.board[row, col] = NAME_TO_PIECE[NAME_BLACK]

    # Now the next move at (7,7) by black should complete five in a row horizontally and win

    # Compose the move dict as expected by reply()
    move = {
        "name": NAME_BLACK,
        "content": (row, 7),
    }

    # Call reply with the move
    agent.reply(move)

    # After the move, the game should be ended
    assert agent.game_end is True, "Game should end after a winning move"

    # The board at the move position should be updated to black piece
    assert agent.board[row, 7] == NAME_TO_PIECE[NAME_BLACK], "Board must be updated with the last move"

    # The content message should indicate black wins
    # The last message spoken by the agent is stored in agent._msgs or via speak()
    # We can check the last message content for the winning message
    last_msg = agent._msgs[-1] if hasattr(agent, "_msgs") and agent._msgs else None
    if last_msg is not None:
        assert "wins" in last_msg.content and NAME_BLACK in last_msg.content, "Winning message must be correct"
    else:
        # If no message stored, fallback to just ensure game_end is True
        pass


def test_gomoku_no_false_win_before_move():
    """
    This test checks that before placing the last piece, no false win is detected.
    The buggy code might detect win before placing the piece, causing incorrect behavior.
    """

    agent = BoardAgent()
    agent.game_end = False

    # Reset board to empty
    agent.board = np.zeros_like(agent.board)

    # Place four black pieces horizontally at row 7, columns 3-6
    row = 7
    for col in range(3, 7):
        agent.board[row, col] = NAME_TO_PIECE[NAME_BLACK]

    # Check that no win is detected at (7,6) for black (the last placed piece)
    # This is just a sanity check of the check_win method itself
    assert not agent.check_win(row, 6, NAME_TO_PIECE[NAME_BLACK]), "No win should be detected with only four in a row"


def test_gomoku_draw_detection_after_move():
    """
    This test verifies that after placing a piece, if the board is full and no win,
    the game ends in a draw.
    """

    agent = BoardAgent()
    agent.game_end = False

    # Fill the board with alternating pieces except one last move
    size = agent.board.shape[0]
    for r in range(size):
        for c in range(size):
            # Fill with black and white alternately
            agent.board[r, c] = NAME_TO_PIECE[NAME_BLACK if (r + c) % 2 == 0 else NAME_WHITE]

    # Clear one spot for the last move
    last_row, last_col = size - 1, size - 1
    agent.board[last_row, last_col] = 0

    # The last move by white at last_row, last_col should fill the board and cause draw
    move = {
        "name": NAME_WHITE,
        "content": (last_row, last_col),
    }

    agent.reply(move)

    assert agent.game_end is True, "Game should end after last move filling the board"
    # The last message should indicate a draw
    last_msg = agent._msgs[-1] if hasattr(agent, "_msgs") and agent._msgs else None
    if last_msg is not None:
        assert "draw" in last_msg.content.lower(), "Draw message must be correct"


