[32mimport pytest
import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_win_detection_after_move_update():
    """
    This test verifies that the BoardAgent correctly detects a win immediately after
    placing a piece on the board, ensuring the board state is updated before checking win.

    The buggy code checks for win before updating the board, which misses the current move.
    The fixed code updates the board first, then checks for win.

    We simulate a scenario where black has four in a row and places the fifth to win.
    """

    agent = BoardAgent()

    # Clear board and set up four black pieces in a row horizontally at row 7, columns 3-6
    agent.board = np.zeros_like(agent.board)
    row = 7
    for col in range(3, 7):
        agent.board[row, col] = NAME_TO_PIECE[NAME_BLACK]

    # The next move is black placing at (7,7) to complete five in a row horizontally
    move = {"name": NAME_BLACK, "content": (row, 7)}

    # Before move, no win should be detected at (7,7) because it's empty
    assert not agent.check_win(row, 7, NAME_TO_PIECE[NAME_BLACK])

    # Call reply with the move; buggy code checks win before updating board, so it misses win
    response = agent.reply(move)

    # After reply, game_end should be True and content should announce black wins
    # This will fail on buggy code because it checks win before board update
    assert agent.game_end is True
    assert f"{NAME_BLACK} wins" in response["content"] or f"{NAME_BLACK} wins" in response.get("content", "")


def test_no_false_win_before_fifth_piece():
    """
    Test that placing the fourth piece does not trigger a win.
    This ensures the agent does not prematurely detect a win.
    """

    agent = BoardAgent()

    # Clear board and set up three black pieces in a row horizontally at row 5, columns 2-4
    agent.board = np.zeros_like(agent.board)
    row = 5
    for col in range(2, 5):
        agent.board[row, col] = NAME_TO_PIECE[NAME_BLACK]

    # Next move is black placing at (5,5) - the fourth piece, not winning yet
    move = {"name": NAME_BLACK, "content": (row, 5)}

    # Call reply with the move
    response = agent.reply(move)

    # The game should not end yet
    assert agent.game_end is False
    # The content should not announce a win
    assert f"{NAME_BLACK} wins" not in response["content"]


def test_draw_detection_after_last_move():
    """
    Test that the agent detects a draw correctly after the last move.
    This indirectly tests that the board is updated before draw check.
    """

    agent = BoardAgent()

    # Fill the board except one spot with alternating pieces (simulate a near full board)
    size = agent.board.shape[0]
    for r in range(size):
        for c in range(size):
            agent.board[r, c] = NAME_TO_PIECE[NAME_BLACK if (r + c) % 2 == 0 else NAME_WHITE]

    # Empty one spot at (size-1, size-1)
    agent.board[size - 1, size - 1] = 0

    # Move is white placing at the last empty spot
    move = {"name": NAME_WHITE, "content": (size - 1, size - 1)}

    # Call reply with the move
    response = agent.reply(move)

    # The game should end with a draw
    assert agent.game_end is True
    assert "draw" in response["content"].lower()[0m
