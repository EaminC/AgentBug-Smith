[32mimport pytest
import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_gomoku_win_detection_order():
    """
    This test verifies that the BoardAgent correctly detects a win condition immediately
    after placing the 5th consecutive piece in a row, column, or diagonal.

    The buggy code checks for win before updating the board, so it misses the last piece,
    causing the win not to be detected.

    The fixed code updates the board first, then checks for win, so the win is detected.

    We simulate a scenario where black places 4 pieces in a row, then places the 5th piece.
    The test asserts that the game ends with black winning immediately after the 5th move.
    """

    agent = BoardAgent()

    # Start the game (no move)
    reply = agent.reply(None)
    assert "Welcome to the Gomoku game" in reply["content"]

    # Place four black pieces in a row horizontally at row 7, columns 3 to 6
    row = 7
    for col in range(3, 7):
        move = {"name": NAME_BLACK, "content": (row, col)}
        reply = agent.reply(move)
        # After each move, game should not end
        assert not agent.game_end
        # The board must be updated correctly
        assert agent.board[row, col] == NAME_TO_PIECE[NAME_BLACK]

    # Now place the 5th black piece at (7,7) to complete five in a row horizontally
    move = {"name": NAME_BLACK, "content": (row, 7)}
    reply = agent.reply(move)

    # After this move, the game should end and black should be declared winner
    assert agent.game_end
    assert f"{NAME_BLACK} wins" in reply["content"]

    # The board must have the last piece placed
    assert agent.board[row, 7] == NAME_TO_PIECE[NAME_BLACK]

    # Also test vertical win
    agent = BoardAgent()
    col = 5
    for r in range(2, 6):
        move = {"name": NAME_WHITE, "content": (r, col)}
        reply = agent.reply(move)
        assert not agent.game_end
        assert agent.board[r, col] == NAME_TO_PIECE[NAME_WHITE]

    move = {"name": NAME_WHITE, "content": (6, col)}
    reply = agent.reply(move)
    assert agent.game_end
    assert f"{NAME_WHITE} wins" in reply["content"]
    assert agent.board[6, col] == NAME_TO_PIECE[NAME_WHITE]

    # Also test diagonal win (top-left to bottom-right)
    agent = BoardAgent()
    start_row, start_col = 3, 3
    for i in range(4):
        move = {"name": NAME_BLACK, "content": (start_row + i, start_col + i)}
        reply = agent.reply(move)
        assert not agent.game_end
        assert agent.board[start_row + i, start_col + i] == NAME_TO_PIECE[NAME_BLACK]

    move = {"name": NAME_BLACK, "content": (start_row + 4, start_col + 4)}
    reply = agent.reply(move)
    assert agent.game_end
    assert f"{NAME_BLACK} wins" in reply["content"]
    assert agent.board[start_row + 4, start_col + 4] == NAME_TO_PIECE[NAME_BLACK]

    # Also test anti-diagonal win (top-right to bottom-left)
    agent = BoardAgent()
    start_row, start_col = 4, 10
    for i in range(4):
        move = {"name": NAME_WHITE, "content": (start_row + i, start_col - i)}
        reply = agent.reply(move)
        assert not agent.game_end
        assert agent.board[start_row + i, start_col - i] == NAME_TO_PIECE[NAME_WHITE]

    move = {"name": NAME_WHITE, "content": (start_row + 4, start_col - 4)}
    reply = agent.reply(move)
    assert agent.game_end
    assert f"{NAME_WHITE} wins" in reply["content"]
    assert agent.board[start_row + 4, start_col - 4] == NAME_TO_PIECE[NAME_WHITE][0m
