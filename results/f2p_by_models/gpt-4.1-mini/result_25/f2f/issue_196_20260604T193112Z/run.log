[32mimport pytest
import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_gomoku_win_detection_order():
    """
    This test verifies that the BoardAgent correctly detects a win immediately after
    placing the winning piece on the board.

    Buggy behavior:
        The agent checks for a win before placing the piece on the board,
        causing it to miss the winning condition.

    Fixed behavior:
        The agent places the piece first, then checks for a win, correctly detecting it.
    """

    agent = BoardAgent()
    agent.game_end = False

    # Start the game (no move yet)
    start_reply = agent.reply(None)
    assert "Welcome to the Gomoku game" in start_reply["content"]
    assert agent.game_end is False

    # Define a helper to simulate moves
    def make_move(agent, player_name, row, col):
        move_dict = {"name": player_name, "content": (row, col)}
        reply = agent.reply(move_dict)
        return reply

    # Play moves to create a winning condition for black horizontally at row 7
    # Place four black stones in a row first
    for col in range(4):
        reply = make_move(agent, NAME_BLACK, 7, col)
        # After each black move, white plays somewhere else (to alternate turns)
        if col < 3:
            reply = make_move(agent, NAME_WHITE, 0, col)

    # At this point, no win should be declared
    assert agent.game_end is False

    # Now place the 5th black stone to complete the row and win
    reply = make_move(agent, NAME_BLACK, 7, 4)

    # The game should end with black winning
    assert agent.game_end is True
    assert f"{NAME_BLACK} wins" in reply["content"]

    # The board position of the last move must be set to black piece
    assert agent.board[7, 4] == NAME_TO_PIECE[NAME_BLACK]

    # The winning condition should be detected only after placing the piece,
    # so the content should reflect the win message, not a next player prompt
    assert "wins" in reply["content"]
    assert "Please make your move" not in reply["content"]

    # Additional test: try to place a piece after game ended, should raise or ignore
    with pytest.raises(AssertionError):
        make_move(agent, NAME_WHITE, 8, 0)  # Invalid move after game ended


def test_gomoku_no_false_win_before_placing():
    """
    This test ensures that the agent does not falsely declare a win before placing the piece.
    It simulates a scenario where the winning move is about to be placed but not yet on board.
    """

    agent = BoardAgent()
    agent.game_end = False

    # Manually set board with four black stones in a row at row 5, cols 2-5
    for col in range(2, 6):
        agent.board[5, col] = NAME_TO_PIECE[NAME_BLACK]

    # The next black move at (5,6) should be the winning move
    # Before placing, check_win should be False because the piece is not placed yet
    win_before = agent.check_win(5, 6, NAME_TO_PIECE[NAME_BLACK])
    assert win_before is False

    # Now place the piece and check win again
    agent.board[5, 6] = NAME_TO_PIECE[NAME_BLACK]
    win_after = agent.check_win(5, 6, NAME_TO_PIECE[NAME_BLACK])
    assert win_after is True


def test_gomoku_draw_detection():
    """
    This test verifies that the agent correctly detects a draw when the board is full
    and no player has won.
    """

    agent = BoardAgent()
    agent.game_end = False

    # Fill the board with alternating black and white pieces without any 5 in a row
    size = agent.board.shape[0]
    for r in range(size):
        for c in range(size):
            piece = NAME_TO_PIECE[NAME_BLACK] if (r + c) % 2 == 0 else NAME_TO_PIECE[NAME_WHITE]
            agent.board[r, c] = piece

    # The board is full, so check_draw should be True
    assert agent.check_draw() is True

    # The game should end in a draw if a move is made (simulate last move)
    # We simulate a move at an already occupied place to trigger assertion error
    with pytest.raises(AssertionError):
        agent.reply({"name": NAME_BLACK, "content": (0, 0)})

    # Reset board to empty and simulate moves until draw
    agent = BoardAgent()
    agent.game_end = False

    # Fill the board except one last move
    for r in range(size):
        for c in range(size):
            if (r, c) != (size - 1, size - 1):
                piece = NAME_TO_PIECE[NAME_BLACK] if (r + c) % 2 == 0 else NAME_TO_PIECE[NAME_WHITE]
                agent.board[r, c] = piece

    # Last move by black at bottom-right corner
    reply = agent.reply({"name": NAME_BLACK, "content": (size - 1, size - 1)})

    # The game should end in a draw
    assert agent.game_end is True
    assert "draw" in reply["content"].lower()[0m
