import pytest

def test_gomoku_win_detection_order():
    """
    Test the win detection logic in BoardAgent.reply for Gomoku.
    The buggy code checks win before updating the board, missing the current move,
    so a winning move is not detected correctly.
    The fixed code updates the board first, then checks win, detecting the win correctly.

    This test simulates a sequence of moves leading to a win for black.
    It asserts that the game ends with black winning immediately after the winning move.
    """
    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent()

    # Start the game
    reply = agent.reply()
    assert "Welcome to the Gomoku game" in reply["content"]

    # Moves: black and white alternate, black tries to get 5 in a row horizontally at row 7
    moves = [
        (7, 3),  # Black
        (6, 3),  # White
        (7, 4),  # Black
        (6, 4),  # White
        (7, 5),  # Black
        (6, 5),  # White
        (7, 6),  # Black
        (6, 6),  # White
        (7, 7),  # Black - this should be the winning move
    ]

    # Play moves
    for i, (r, c) in enumerate(moves):
        player_name = NAME_BLACK if i % 2 == 0 else NAME_WHITE
        move_dict = {"name": player_name, "content": (r, c)}
        reply = agent.reply(move_dict)
        if i < len(moves) - 1:
            # Before last move, game should not end
            assert not agent.game_end, f"Game ended prematurely at move {i+1}"
            # The content should prompt next player
            next_player = NAME_BLACK if player_name == NAME_WHITE else NAME_WHITE
            assert next_player in reply["content"], f"Expected next player prompt after move {i+1}"
        else:
            # After last move, game should end with black winning
            assert agent.game_end, "Game did not end after winning move"
            assert f"{NAME_BLACK} wins" in reply["content"], "Winning message not found after winning move"

def test_gomoku_no_false_win_before_board_update():
    """
    Test that before the fix, the check_win call does not detect the win correctly
    because the board is not updated before the check.
    This test is expected to fail on buggy code and pass on fixed code.
    """
    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent()

    # We simulate the buggy logic by manually calling check_win before updating board
    # This is to confirm that the bug exists: check_win returns False even if last move is winning

    # Set up a board with 4 black stones in a row horizontally at row 7, columns 3-6
    for col in range(3, 7):
        agent.board[7, col] = NAME_TO_PIECE[NAME_BLACK]

    # The next move at (7,7) should be winning
    row, col = 7, 7
    piece = NAME_TO_PIECE[NAME_BLACK]

    # Buggy behavior: check_win called before updating board, should return False (bug)
    win_before_update = agent.check_win(row, col, piece)
    # The bug is that win_before_update is False, but it should be True after fix
    # So we assert that it is False here to confirm bug presence
    assert win_before_update is False, "Buggy code should not detect win before board update"

    # Now update the board and check again
    agent.board[row, col] = piece
    win_after_update = agent.check_win(row, col, piece)
    # After update, should detect win
    assert win_after_update is True, "Should detect win after board update"

def test_gomoku_draw_detection():
    """
    Test that the draw detection still works correctly.
    Fill the board with no winner and verify the draw message.
    """
    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent()

    # Fill the board with alternating black and white pieces with no 5 in a row
    size = agent.board.shape[0]
    for r in range(size):
        for c in range(size):
            # Alternate pieces to avoid 5 in a row
            if (r + c) % 2 == 0:
                agent.board[r, c] = NAME_TO_PIECE[NAME_BLACK]
            else:
                agent.board[r, c] = NAME_TO_PIECE[NAME_WHITE]

    # The board is full, so check_draw should return True
    assert agent.check_draw() is True, "Draw should be detected on full board with no winner"

    # The game_end flag should be False initially
    assert agent.game_end is False

    # Now simulate a move that triggers draw detection
    # Since board is full, any move is invalid, but we simulate reply with None to start
    reply = agent.reply(None)
    # The reply content should contain welcome message
    assert "Welcome" in reply["content"]

    # Now forcibly call reply with a move that is invalid (outside board)
    # We expect assertion error for invalid move
    with pytest.raises(AssertionError):
        agent.reply({"name": NAME_BLACK, "content": (size, size)})

    # Clear one cell to allow a move
    agent.board[0, 0] = 0
    # Now make the last move to fill the board
    reply = agent.reply({"name": NAME_BLACK, "content": (0, 0)})
    # After this move, the board is full, check_draw should trigger game end
    assert agent.game_end is True
    assert "draw" in reply["content"].lower()

