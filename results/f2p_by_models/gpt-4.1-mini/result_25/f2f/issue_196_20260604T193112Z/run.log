[32mimport pytest
import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_gomoku_win_detection_order():
    """
    This test simulates a sequence of moves leading to a win condition for black.
    It verifies that the board is updated before checking for a win, so the win is detected correctly.

    On the buggy codebase, the win check happens before the board update, so the win is missed and the test fails.
    After the fix, the board is updated first, and the win is detected correctly, so the test passes.
    """

    agent = BoardAgent()

    # Start the game, get initial prompt
    reply = agent.reply()
    assert "Welcome to the Gomoku game" in reply["content"]

    # Define a winning sequence for black (NAME_BLACK)
    # Place 5 black stones horizontally at row 7, columns 3 to 7
    winning_row = 7
    winning_cols = [3, 4, 5, 6, 7]

    # Alternate moves between black and white to simulate a real game
    # White places stones somewhere else not blocking black's winning line
    white_moves = [(0, 0), (0, 1), (0, 2), (0, 3)]

    # Play moves: black and white alternate, black tries to make a horizontal line at row 7
    for i in range(5):
        # Black move
        black_move = {"name": NAME_BLACK, "content": (winning_row, winning_cols[i])}
        reply = agent.reply(black_move)
        # After last black move, the game should end with black win
        if i < 4:
            # Before last move, game should not be ended
            assert not agent.game_end
            # The content should prompt next player (white)
            assert NAME_WHITE in reply["content"]
        else:
            # On last move, game should end with black win
            assert agent.game_end
            assert f"{NAME_BLACK} wins" in reply["content"]

        if i < 4:
            # White move (only if not last black move)
            white_move = {"name": NAME_WHITE, "content": white_moves[i]}
            reply = agent.reply(white_move)
            # After white move, game should not be ended
            assert not agent.game_end
            # The content should prompt next player (black)
            assert NAME_BLACK in reply["content"]

    # Additionally, verify the board state has black pieces in the winning positions
    board = agent.board
    for col in winning_cols:
        assert board[winning_row, col] == NAME_TO_PIECE[NAME_BLACK]

    # Verify no false draw
    assert not agent.check_draw()

    # Verify that the win check returns True for the last move
    assert agent.check_win(winning_row, winning_cols[-1], NAME_TO_PIECE[NAME_BLACK])


def test_gomoku_no_false_win_before_board_update():
    """
    This test ensures that the win is not detected before the board is updated.
    On the buggy codebase, the win check is done before the board update, so the last move is not counted.
    This test tries to detect that the win is missed if the board is not updated first.
    """

    agent = BoardAgent()

    # Manually set up a board with 4 black stones in a row at row 10, columns 5 to 8
    row = 10
    cols = [5, 6, 7, 8]
    for col in cols:
        agent.board[row, col] = NAME_TO_PIECE[NAME_BLACK]

    # Now black places the 5th stone at (10,9)
    move = {"name": NAME_BLACK, "content": (row, 9)}

    # Call reply and capture the content
    reply = agent.reply(move)

    # On buggy code, the win check is done before placing the stone, so no win detected
    # So game_end should be False and content should not declare black win
    if not agent.game_end:
        # This is buggy behavior: no win detected
        assert f"{NAME_BLACK} wins" not in reply["content"]
    else:
        # On fixed code, game_end is True and black wins declared
        assert f"{NAME_BLACK} wins" in reply["content"]

    # The board should now have the stone placed at (10,9)
    assert agent.board[row, 9] == NAME_TO_PIECE[NAME_BLACK]

    # The win check method should return True for this last move
    assert agent.check_win(row, 9, NAME_TO_PIECE[NAME_BLACK])


def test_gomoku_draw_detection_after_move():
    """
    This test fills the board almost completely without any winner,
    then places the last move to cause a draw.
    It verifies that the draw detection works correctly after the move is placed.
    """

    agent = BoardAgent()

    # Fill the board with alternating stones except one cell
    size = agent.board.shape[0]
    for r in range(size):
        for c in range(size):
            if (r, c) == (size - 1, size - 1):
                continue  # leave last cell empty
            # Alternate black and white pieces
            piece = NAME_TO_PIECE[NAME_BLACK] if (r + c) % 2 == 0 else NAME_TO_PIECE[NAME_WHITE]
            agent.board[r, c] = piece

    # The board is now full except one cell, no winner
    assert not agent.check_win(0, 0, NAME_TO_PIECE[NAME_BLACK])
    assert not agent.check_draw()  # Because one cell empty

    # Place last move by black at the last empty cell
    last_move = {"name": NAME_BLACK, "content": (size - 1, size - 1)}
    reply = agent.reply(last_move)

    # After placing last move, the game should be a draw (no winner, full board)
    assert agent.game_end
    assert "draw" in reply["content"].lower()

    # The last move should be placed on the board
    assert agent.board[size - 1, size - 1] == NAME_TO_PIECE[NAME_BLACK]


if __name__ == "__main__":
    pytest.main([__file__])[0m
