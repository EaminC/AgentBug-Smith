[32mimport pytest
import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_gomoku_win_detection_order():
    """
    This test simulates a sequence of moves leading to a win condition on the board.
    It verifies that the board state is updated before the win check, so the win is detected correctly.
    On the buggy codebase, the win will not be detected at the correct time and test will fail.
    After the fix, the test should pass.
    """

    agent = BoardAgent()

    # Start the game, no move yet
    reply = agent.reply()
    assert "Welcome to the Gomoku game" in reply["content"]

    # Define a winning sequence for black (NAME_BLACK)
    # Place 5 black stones horizontally at row 7, cols 3 to 7
    winning_moves = [(7, 3), (7, 4), (7, 5), (7, 6), (7, 7)]

    # Alternate moves between black and white to simulate a real game
    # White will play elsewhere to avoid interfering with black's winning line
    white_moves = [(0, 0), (0, 1), (0, 2), (0, 3)]

    # Play moves one by one
    for i in range(4):
        # Black move
        black_move = winning_moves[i]
        reply = agent.reply({"name": NAME_BLACK, "content": black_move})
        # After each black move except the last, game should not end
        assert not agent.game_end
        assert "wins" not in reply["content"]

        # White move
        white_move = white_moves[i]
        reply = agent.reply({"name": NAME_WHITE, "content": white_move})
        # Game should still continue
        assert not agent.game_end
        assert "wins" not in reply["content"]

    # Now play the last black move to complete 5 in a row
    last_black_move = winning_moves[-1]
    reply = agent.reply({"name": NAME_BLACK, "content": last_black_move})

    # The game should end with black winning
    assert agent.game_end
    assert f"{NAME_BLACK} wins" in reply["content"]


def test_gomoku_no_false_win_before_board_update():
    """
    This test ensures that the win check does not falsely detect a win before the board is updated.
    On the buggy codebase, the win check is done before updating the board, so the last move is not counted.
    This test tries to detect that by checking the board state after the move and win detection.
    """

    agent = BoardAgent()

    # Play 4 black stones in a row horizontally at row 10, cols 10 to 13
    moves = [(10, 10), (10, 11), (10, 12), (10, 13)]
    for move in moves:
        reply = agent.reply({"name": NAME_BLACK, "content": move})
        assert not agent.game_end

    # Now place the 5th stone to complete the line
    last_move = (10, 14)
    reply = agent.reply({"name": NAME_BLACK, "content": last_move})

    # The board must have the last stone placed
    assert agent.board[last_move[0], last_move[1]] == NAME_TO_PIECE[NAME_BLACK]

    # The game should end with black winning
    assert agent.game_end
    assert f"{NAME_BLACK} wins" in reply["content"]


def test_gomoku_draw_detection():
    """
    This test fills the board almost completely without any player winning,
    then makes the last move to cause a draw.
    It verifies that the draw is detected correctly.
    """

    agent = BoardAgent()

    size = agent.board.shape[0]

    # Fill the board alternately without creating a winning line
    # Use a pattern to avoid 5 in a row
    for r in range(size):
        for c in range(size):
            if r == size - 1 and c == size - 1:
                # Leave last cell empty for the draw move
                continue
            piece = NAME_TO_PIECE[NAME_BLACK] if (r + c) % 2 == 0 else NAME_TO_PIECE[NAME_WHITE]
            agent.board[r, c] = piece

    # The game should not be ended yet
    agent.game_end = False

    # Last move by black to fill the board
    last_move = (size - 1, size - 1)
    reply = agent.reply({"name": NAME_BLACK, "content": last_move})

    # The game should end in a draw
    assert agent.game_end
    assert "draw" in reply["content"].lower()[0m
