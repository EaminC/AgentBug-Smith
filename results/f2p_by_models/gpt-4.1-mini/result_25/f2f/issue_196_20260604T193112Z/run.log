[32mimport pytest
import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_gomoku_win_detection_order():
    """
    This test verifies that the win detection logic properly recognizes a win immediately after
    placing the winning piece on the board.

    Buggy behavior:
    The code checks for a win before placing the piece on the board, causing it to miss the win
    condition when the last piece is placed.

    Fixed behavior:
    The code places the piece first, then checks for a win, correctly detecting the win.
    """

    agent = BoardAgent()
    agent.board = np.zeros_like(agent.board)  # Clear the board
    agent.game_end = False

    # Simulate moves leading up to a horizontal win for black
    # Place four black pieces in a row at row 7, columns 3 to 6
    for col in range(3, 7):
        agent.board[7, col] = NAME_TO_PIECE[NAME_BLACK]

    # Now place the winning piece at (7,7)
    move = {"name": NAME_BLACK, "content": (7, 7)}

    # Call reply with the winning move
    agent.reply(move)

    # After reply, the game should be ended and black should be winner
    assert agent.game_end is True
    # The board at (7,7) must be black piece
    assert agent.board[7, 7] == NAME_TO_PIECE[NAME_BLACK]

    # The content message should indicate black wins
    last_msg = agent.msgs[-1] if hasattr(agent, "msgs") else None
    # If agent.msgs is not available, fallback to checking internal state
    # The reply method calls self.speak(msg_host), which may append to msgs list
    # We check the last message content for win announcement if possible
    if last_msg is not None:
        assert "wins" in last_msg.content.lower()
    else:
        # If no message history, we at least assert game_end True and board updated
        assert agent.game_end is True


def test_gomoku_no_false_win_before_placing():
    """
    This test ensures that before placing the piece on the board, the win check does not falsely
    detect a win.

    Buggy behavior:
    The code checks for a win before placing the piece, which misses the last piece and causes
    incorrect game state.

    Fixed behavior:
    The code places the piece first, then checks for a win.
    """

    agent = BoardAgent()
    agent.board = np.zeros_like(agent.board)
    agent.game_end = False

    # Place four white pieces vertically at column 5, rows 2 to 5
    for row in range(2, 6):
        agent.board[row, 5] = NAME_TO_PIECE[NAME_WHITE]

    # Prepare move for white at (6,5) which should be winning move
    move = {"name": NAME_WHITE, "content": (6, 5)}

    # Manually call check_win before placing piece (simulate buggy logic)
    win_before_placing = agent.check_win(6, 5, NAME_TO_PIECE[NAME_WHITE])
    assert win_before_placing is False, "Buggy code incorrectly detects win before placing piece"

    # Now call reply which places piece then checks win
    agent.reply(move)

    # After reply, game should end with white win
    assert agent.game_end is True
    assert agent.board[6, 5] == NAME_TO_PIECE[NAME_WHITE]

    # Check that the win is detected after placing
    win_after_placing = agent.check_win(6, 5, NAME_TO_PIECE[NAME_WHITE])
    assert win_after_placing is True


def test_gomoku_draw_detection():
    """
    This test verifies that the draw detection works correctly when the board is full and no winner.

    This indirectly tests that the piece is placed before draw check.
    """

    agent = BoardAgent()
    size = agent.board.shape[0]

    # Fill the board with alternating pieces except last cell
    for r in range(size):
        for c in range(size):
            if (r, c) == (size - 1, size - 1):
                agent.board[r, c] = 0  # leave last empty
            else:
                agent.board[r, c] = NAME_TO_PIECE[NAME_BLACK] if (r + c) % 2 == 0 else NAME_TO_PIECE[NAME_WHITE]

    agent.game_end = False

    # Last move to fill the board without creating a win
    move = {"name": NAME_BLACK, "content": (size - 1, size - 1)}

    agent.reply(move)

    # After reply, the game should be ended with a draw
    assert agent.game_end is True
    # The board last cell is black piece
    assert agent.board[size - 1, size - 1] == NAME_TO_PIECE[NAME_BLACK]

    # The content message should indicate a draw if accessible
    last_msg = agent.msgs[-1] if hasattr(agent, "msgs") else None
    if last_msg is not None:
        assert "draw" in last_msg.content.lower()


