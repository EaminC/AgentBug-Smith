import numpy as np

# The tested module requires matplotlib which may not be installed in the test environment.
# To avoid import errors, we import the tested class inside the test function after checking matplotlib availability.
# This is a workaround to let pytest run the test only if matplotlib is installed.

def is_matplotlib_available():
    try:
        import matplotlib  # noqa: F401
        return True
    except ImportError:
        return False


@pytest.mark.skipif(not is_matplotlib_available(), reason="matplotlib not installed")
def test_gomoku_win_detection_order():
    # Import here to avoid import error if matplotlib is missing
    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    # Initialize the board agent
    agent = BoardAgent()

    # The board is 15x15 by default, empty is 0, black is 1, white is 2
    # We simulate a game where black will win by placing five stones horizontally at row 7, columns 3 to 7

    # Moves before winning move (black and white alternate)
    moves = [
        (NAME_BLACK, (7, 3)),
        (NAME_WHITE, (0, 0)),
        (NAME_BLACK, (7, 4)),
        (NAME_WHITE, (0, 1)),
        (NAME_BLACK, (7, 5)),
        (NAME_WHITE, (0, 2)),
        (NAME_BLACK, (7, 6)),
        (NAME_WHITE, (0, 3)),
    ]

    # Play all moves except the last winning move
    for name, (r, c) in moves:
        x = {"name": name, "content": (r, c)}
        reply = agent.reply(x)
        # The game should not be ended yet
        assert agent.game_end is False
        # The board cell should be updated
        assert agent.board[r, c] == NAME_TO_PIECE[name]
        # The reply content should not announce a winner yet
        assert "wins" not in reply["content"]

    # Now play the winning move for black at (7,7)
    winning_move = {"name": NAME_BLACK, "content": (7, 7)}
    reply = agent.reply(winning_move)

    # The board must be updated with the last move
    assert agent.board[7, 7] == NAME_TO_PIECE[NAME_BLACK]

    # The game should be ended
    assert agent.game_end is True

    # The reply content must announce that black wins
    assert "wins" in reply["content"]
    assert NAME_BLACK in reply["content"]

    # The bug was that check_win was called before updating the board,
    # so the winning move was not detected. The fix updates the board first,
    # then checks for win, so this test fails on buggy code and passes on fixed code.


@pytest.mark.skipif(not is_matplotlib_available(), reason="matplotlib not installed")
def test_no_false_win_before_five_in_a_row():
    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent()

    # Place four black stones in a row horizontally at row 5, columns 5 to 8
    for col in range(5, 9):
        x = {"name": NAME_BLACK, "content": (5, col)}
        reply = agent.reply(x)
        assert agent.game_end is False
        assert agent.board[5, col] == NAME_TO_PIECE[NAME_BLACK]
        assert "wins" not in reply["content"]

    # Place some white stones elsewhere to alternate turns
    white_moves = [(0, 0), (0, 1), (0, 2), (0, 3)]
    for pos in white_moves:
        x = {"name": NAME_WHITE, "content": pos}
        reply = agent.reply(x)
        assert agent.game_end is False
        assert agent.board[pos[0], pos[1]] == NAME_TO_PIECE[NAME_WHITE]
        assert "wins" not in reply["content"]

    # The game should not end yet because black has only 4 stones in a row, not 5
    assert agent.game_end is False


@pytest.mark.skipif(not is_matplotlib_available(), reason="matplotlib not installed")
def test_draw_detection_after_board_filled():
    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent()

    # Fill the board with alternating black and white stones without any 5 in a row
    # We fill row by row, alternating colors per cell, ensuring no 5 in a row
    size = agent.board.shape[0]
    for r in range(size):
        for c in range(size):
            # Alternate black and white by sum of coordinates parity
            color = NAME_BLACK if (r + c) % 2 == 0 else NAME_WHITE
            x = {"name": color, "content": (r, c)}
            reply = agent.reply(x)
            # The board cell must be updated
            assert agent.board[r, c] == NAME_TO_PIECE[color]

    # After filling the board, the game should be ended in a draw
    assert agent.game_end is True
    assert "draw" in reply["content"].lower()

# The tests verify the correct order of board update and win checking,
# and that the game ends correctly on win or draw conditions.[0m
