import pytest

# We import here inside the test function to avoid import errors at collection time if matplotlib is missing.
# The test runner should fail on import in buggy code due to missing logic, not missing matplotlib.
# But since the module requires matplotlib, we delay import to runtime.

def test_gomoku_win_detection_order():
    """
    Test the win detection logic in BoardAgent.reply for Gomoku.
    The buggy code checks win before updating the board, missing the current move,
    so a winning move is not detected correctly.
    The fixed code updates the board first, then checks win, detecting the win correctly.

    This test simulates a sequence of moves leading to a win for black.
    It asserts that the game ends with black winning immediately after the winning move.
    """

    # Import here to avoid ImportError at collection time if matplotlib is missing.
    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent()

    # Start the game, no input means start message
    start_response = agent.reply(None)
    assert "Welcome to the Gomoku game" in start_response["content"]
    assert not agent.game_end

    # We simulate moves leading to black win horizontally at row 7, cols 3 to 7 (0-based indexing)
    # Black moves first, then white moves somewhere else (not blocking)
    # We will place black stones at (7,3), (7,4), (7,5), (7,6), and finally (7,7) to win.

    # Helper to make a move
    def make_move(player_name, row, col):
        move = {"name": player_name, "content": (row, col)}
        return agent.reply(move)

    # Black moves (7,3)
    resp = make_move(NAME_BLACK, 7, 3)
    assert not agent.game_end
    assert NAME_WHITE in resp["content"] or "Please make your move" in resp["content"]

    # White moves (0,0) somewhere else
    resp = make_move(NAME_WHITE, 0, 0)
    assert not agent.game_end

    # Black moves (7,4)
    resp = make_move(NAME_BLACK, 7, 4)
    assert not agent.game_end

    # White moves (0,1)
    resp = make_move(NAME_WHITE, 0, 1)
    assert not agent.game_end

    # Black moves (7,5)
    resp = make_move(NAME_BLACK, 7, 5)
    assert not agent.game_end

    # White moves (0,2)
    resp = make_move(NAME_WHITE, 0, 2)
    assert not agent.game_end

    # Black moves (7,6)
    resp = make_move(NAME_BLACK, 7, 6)
    assert not agent.game_end

    # White moves (0,3)
    resp = make_move(NAME_WHITE, 0, 3)
    assert not agent.game_end

    # Now the winning move for black at (7,7)
    resp = make_move(NAME_BLACK, 7, 7)

    # After this move, the game should end with black winning
    assert agent.game_end
    assert f"{NAME_BLACK} wins" in resp["content"]

    # The board at (7,7) should be black piece
    assert agent.board[7, 7] == NAME_TO_PIECE[NAME_BLACK]

    # The board should have black pieces at (7,3) to (7,7)
    for c in range(3, 8):
        assert agent.board[7, c] == NAME_TO_PIECE[NAME_BLACK]

    # The board should have white pieces at (0,0), (0,1), (0,2), (0,3)
    for c in range(0, 4):
        assert agent.board[0, c] == NAME_TO_PIECE[NAME_WHITE]

    # The content message should mention the game ends and black wins
    assert resp["content"].startswith("The game ends")

    # The game_end flag should be True
    assert agent.game_end


def test_gomoku_no_false_win_before_board_update():
    """
    Test that before the fix, the check_win call does not detect the win correctly
    because the board is not updated before the check.
    This test is expected to fail on buggy code and pass on fixed code.
    """

    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent()

    # Make 4 black stones in a row at (7,3) to (7,6)
    for col in range(3, 7):
        move = {"name": NAME_BLACK, "content": (7, col)}
        resp = agent.reply(move)
        assert not agent.game_end

        # White moves somewhere else
        move_white = {"name": NAME_WHITE, "content": (0, col)}
        resp_white = agent.reply(move_white)
        assert not agent.game_end

    # Now make the 5th black stone at (7,7)
    move = {"name": NAME_BLACK, "content": (7, 7)}
    resp = agent.reply(move)

    # On buggy code, game_end is False because win check is before board update
    # On fixed code, game_end is True because board is updated before win check
    # So we assert game_end is True, which fails on buggy code and passes on fixed code
    assert agent.game_end
    assert f"{NAME_BLACK} wins" in resp["content"]


def test_gomoku_draw_detection():
    """
    Test that the draw detection still works correctly.
    Fill the board with no winner and verify the draw message.
    """

    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent()

    size = agent.board.shape[0]

    # Fill the board alternatively without making 5 in a row
    # We fill row by row, alternating black and white, but avoid 5 consecutive same pieces
    for row in range(size):
        for col in range(size):
            player = NAME_BLACK if (row + col) % 2 == 0 else NAME_WHITE
            move = {"name": player, "content": (row, col)}
            resp = agent.reply(move)
            if agent.game_end:
                # If game ends early, break
                break
        if agent.game_end:
            break

    # The game should end in a draw
    assert agent.game_end
    assert "draw" in resp["content"].lower() or "draw" in resp["content"]


