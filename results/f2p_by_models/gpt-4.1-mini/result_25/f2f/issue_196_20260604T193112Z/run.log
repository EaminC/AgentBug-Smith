[32mimport numpy as np
import pytest

def test_gomoku_win_detection_order():
    """
    Test the win detection logic in BoardAgent.reply for Gomoku.
    The buggy code checks win before updating the board, missing the current move,
    so a winning move is not detected correctly.
    The fixed code updates the board first, then checks win, detecting the win correctly.

    This test simulates a sequence of moves leading to a win for black.
    It asserts that the game ends with black winning immediately after the winning move.
    """
    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent()
    # Start the game
    reply = agent.reply()
    assert "Welcome" in reply["content"]

    # Moves leading to black win horizontally at row 7
    moves = [
        (NAME_BLACK, (7, 3)),
        (NAME_WHITE, (6, 3)),
        (NAME_BLACK, (7, 4)),
        (NAME_WHITE, (6, 4)),
        (NAME_BLACK, (7, 5)),
        (NAME_WHITE, (6, 5)),
        (NAME_BLACK, (7, 6)),
        (NAME_WHITE, (6, 6)),
        # Winning move
        (NAME_BLACK, (7, 7)),
    ]

    for i, (player, pos) in enumerate(moves):
        reply = agent.reply({"name": player, "content": pos})
        if i < len(moves) - 1:
            # Before the last move, game should not end
            assert not agent.game_end
            assert "wins" not in reply["content"]
        else:
            # After last move, black should win
            assert agent.game_end
            assert f"{NAME_BLACK} wins" in reply["content"]

def test_gomoku_no_false_win_before_board_update():
    """
    Test that before the fix, the check_win call does not detect the win correctly
    because the board is not updated before the check.
    This test is expected to fail on buggy code and pass on fixed code.
    """
    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent()
    # Manually simulate the buggy logic: check_win before updating board
    # We simulate a horizontal 4 in a row and then the 5th move

    # Place 4 black pieces horizontally at row 7, columns 3 to 6
    for col in range(3, 7):
        agent.board[7, col] = NAME_TO_PIECE[NAME_BLACK]

    # Now test the buggy logic: check_win before placing the 5th piece at (7,7)
    # The buggy code would do:
    # if agent.check_win(7,7,NAME_TO_PIECE[NAME_BLACK]): -> should be False because board not updated yet
    # then update board
    # So simulate this:
    win_before_update = agent.check_win(7, 7, NAME_TO_PIECE[NAME_BLACK])
    agent.board[7, 7] = NAME_TO_PIECE[NAME_BLACK]
    win_after_update = agent.check_win(7, 7, NAME_TO_PIECE[NAME_BLACK])

    # On buggy code, win_before_update is False, win_after_update is True
    # So test that win_before_update is False (buggy behavior)
    assert win_before_update is False
    # And win_after_update is True (correct behavior)
    assert win_after_update is True

def test_gomoku_draw_detection():
    """
    Test that the draw detection still works correctly.
    Fill the board with no winner and verify the draw message.
    """
    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent()
    # Fill the board with alternating pieces but no 5 in a row
    size = agent.board.shape[0]
    for r in range(size):
        for c in range(size):
            if (r + c) % 2 == 0:
                agent.board[r, c] = NAME_TO_PIECE[NAME_BLACK]
            else:
                agent.board[r, c] = NAME_TO_PIECE[NAME_WHITE]

    # The board is full, no winner, so check_draw should be True
    assert agent.check_draw() is True

    # Simulate reply with a move on full board (should not be valid, but test draw message)
    # We simulate the last move triggering draw detection
    # Since board is full, any move is invalid, so we skip move and just test draw detection

    # Manually set game_end False to test reply logic
    agent.game_end = False

    # The reply with None should welcome
    reply = agent.reply()
    assert "Welcome" in reply["content"]

    # Try to reply with a move (should raise because move invalid)
    with pytest.raises(AssertionError):
        agent.reply({"name": NAME_BLACK, "content": (0, 0)})

    # Instead, test draw detection directly
    assert agent.check_draw() is True

