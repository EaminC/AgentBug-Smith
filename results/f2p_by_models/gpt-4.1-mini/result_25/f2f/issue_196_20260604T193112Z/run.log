[32mimport numpy as np
import pytest

# The tested module depends on matplotlib which might not be installed in minimal environments.
# This test assumes matplotlib is installed as it is a dependency of the gomoku example.
from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_gomoku_win_detection_after_move():
    """
    This test simulates a sequence of moves leading to a win condition for black.
    It verifies that the game ends immediately after the winning move is placed on the board.
    The buggy code checks win before placing the piece on the board, so it misses the win.
    The fixed code places the piece first, then checks for win, so it detects the win correctly.
    """
    agent = BoardAgent()

    # Start the game, initial reply should welcome black player
    start_reply = agent.reply()
    assert "Welcome to the Gomoku game" in start_reply["content"]
    assert agent.game_end is False

    # Define a winning sequence for black (NAME_BLACK)
    # Place 4 black stones in a row horizontally at row 7, columns 3 to 6
    base_row = 7
    for col in range(3, 7):
        move = {"name": NAME_BLACK, "content": (base_row, col)}
        reply = agent.reply(move)
        # After each move, game should not end yet
        assert agent.game_end is False
        assert "wins" not in reply["content"]
        # Alternate with white moves somewhere else to simulate turns
        white_move = {"name": NAME_WHITE, "content": (base_row + 1, col)}
        reply_white = agent.reply(white_move)
        assert agent.game_end is False
        assert "wins" not in reply_white["content"]

    # Now place the 5th black stone to complete the row and win
    winning_move = {"name": NAME_BLACK, "content": (base_row, 7)}
    reply_win = agent.reply(winning_move)

    # The game should be marked as ended
    assert agent.game_end is True

    # The reply content should declare black as winner
    assert "wins" in reply_win["content"]
    assert NAME_BLACK in reply_win["content"]

    # The board at the winning position must be set to black piece
    assert agent.board[base_row, 7] == NAME_TO_PIECE[NAME_BLACK]

    # The bug was that the win check was done before placing the piece, so the win would not be detected.
    # After fix, the piece is placed first, then win checked, so this test passes only after fix.


def test_gomoku_no_false_win_before_fifth_stone():
    """
    This test ensures that no false win is declared before the fifth consecutive stone is placed.
    """
    agent = BoardAgent()

    # Place 4 black stones in a row horizontally at row 10, columns 2 to 5
    base_row = 10
    for col in range(2, 6):
        move = {"name": NAME_BLACK, "content": (base_row, col)}
        reply = agent.reply(move)
        # No win should be declared yet
        assert agent.game_end is False
        assert "wins" not in reply["content"]
        # Alternate with white moves somewhere else
        white_move = {"name": NAME_WHITE, "content": (base_row + 1, col)}
        reply_white = agent.reply(white_move)
        assert agent.game_end is False
        assert "wins" not in reply_white["content"]


def test_gomoku_draw_detection():
    """
    This test fills the board without any winner to trigger a draw.
    It verifies that the game ends in a draw.
    """
    agent = BoardAgent()

    size = agent.board.shape[0]

    # Fill the board in a checkerboard pattern without 5 in a row
    # Black on even sum indices, white on odd sum indices
    for row in range(size):
        for col in range(size):
            player_name = NAME_BLACK if (row + col) % 2 == 0 else NAME_WHITE
            move = {"name": player_name, "content": (row, col)}
            reply = agent.reply(move)
            if agent.game_end:
                # Once game ends, it must be a draw (no winner)
                assert "draw" in reply["content"].lower()
                return

    # If board filled without triggering game_end, fail test
    pytest.fail("Game did not end in draw after filling board.")


if __name__ == "__main__":
    pytest.main([__file__])[0m
