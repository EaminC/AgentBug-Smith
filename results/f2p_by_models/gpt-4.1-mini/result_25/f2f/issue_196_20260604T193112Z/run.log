[32mimport pytest
import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_win_detection_order_and_board_update():
    """
    This test verifies that the BoardAgent correctly updates the board before checking for a win.
    The buggy version checks for win before updating the board, which misses the current move.
    The fixed version updates the board first, then checks for draw and win.

    The test simulates a sequence of moves leading to a win condition for black.
    It asserts that after the winning move, the game_end flag is True and the content message
    correctly announces the winner.

    On the buggy codebase, this test should fail because the win is not detected properly.
    After applying the fix, this test should pass.
    """
    agent = BoardAgent()

    # Start the game (no move)
    reply = agent.reply()
    assert "Welcome to the Gomoku game" in reply["content"]
    assert not agent.game_end

    # Define a winning sequence for black on a horizontal line at row 7
    # Black moves first, then white, alternating
    # Black will place pieces at (7,0), (7,1), (7,2), (7,3), (7,4)
    # White places pieces elsewhere to alternate turns
    black_moves = [(7, 0), (7, 1), (7, 2), (7, 3), (7, 4)]
    white_moves = [(0, 0), (0, 1), (0, 2), (0, 3)]

    # Play moves alternately
    for i in range(4):
        # Black move
        move_black = {"name": NAME_BLACK, "content": black_moves[i]}
        reply_black = agent.reply(move_black)
        assert not agent.game_end

        # White move
        move_white = {"name": NAME_WHITE, "content": white_moves[i]}
        reply_white = agent.reply(move_white)
        assert not agent.game_end

    # Final black move that should win the game
    final_move = {"name": NAME_BLACK, "content": black_moves[4]}
    reply_final = agent.reply(final_move)

    # After the final move, the game should end with black winning
    assert agent.game_end
    assert "Black wins" in reply_final["content"] or "black wins" in reply_final["content"] or "Black player wins" in reply_final["content"] or "Black" in reply_final["content"]
    # The board at the winning position must be updated to black's piece
    row, col = black_moves[4]
    assert agent.board[row, col] == NAME_TO_PIECE[NAME_BLACK]

    # The win check must be true for the last move
    assert agent.check_win(row, col, NAME_TO_PIECE[NAME_BLACK])


def test_draw_detection_and_no_false_win():
    """
    This test verifies that the game detects a draw correctly and does not falsely detect a win.
    It fills the board almost completely without any 5 in a row, then makes the last move.
    The game should end in a draw, not a win.

    On the buggy codebase, the win check might be incorrect due to order of board update.
    After the fix, the draw and win detection should be correct.
    """
    agent = BoardAgent()

    # Fill the board with alternating pieces except the last cell
    size = agent.board.shape[0]
    for r in range(size):
        for c in range(size):
            if (r, c) == (size - 1, size - 1):
                continue
            # Alternate black and white pieces
            piece = NAME_TO_PIECE[NAME_BLACK] if (r + c) % 2 == 0 else NAME_TO_PIECE[NAME_WHITE]
            agent.board[r, c] = piece

    # Last move by black at the last cell
    last_move = {"name": NAME_BLACK, "content": (size - 1, size - 1)}
    reply = agent.reply(last_move)

    # The board must be updated
    assert agent.board[size - 1, size - 1] == NAME_TO_PIECE[NAME_BLACK]

    # The game should be ended in a draw (no win)
    assert agent.game_end
    assert "draw" in reply["content"].lower()

    # The win check for last move should be false
    assert not agent.check_win(size - 1, size - 1, NAME_TO_PIECE[NAME_BLACK])


def test_invalid_move_rejected():
    """
    This test verifies that an invalid move (out of bounds or on occupied cell) raises an assertion error.
    """
    agent = BoardAgent()

    # Valid first move
    move = {"name": NAME_BLACK, "content": (0, 0)}
    agent.reply(move)

    # Invalid move: same position again
    invalid_move = {"name": NAME_WHITE, "content": (0, 0)}
    with pytest.raises(AssertionError):
        agent.reply(invalid_move)

    # Invalid move: out of bounds
    out_of_bounds_move = {"name": NAME_BLACK, "content": (-1, 0)}
    with pytest.raises(AssertionError):
        agent.reply(out_of_bounds_move)

    out_of_bounds_move2 = {"name": NAME_WHITE, "content": (agent.board.shape[0], 0)}
    with pytest.raises(AssertionError):
        agent.reply(out_of_bounds_move2)[0m
