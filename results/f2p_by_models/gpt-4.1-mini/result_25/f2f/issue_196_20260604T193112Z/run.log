import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def test_win_detection_after_move():
    """
    This test simulates a sequence of moves leading to a win condition in Gomoku.
    It verifies that the game correctly detects a win immediately after the winning move,
    ensuring the board is updated before the win check.

    The test will fail on the buggy codebase because the win check is done before
    updating the board, thus missing the winning move itself.
    After the fix, the test should pass.
    """

    agent = BoardAgent()
    agent.game_end = False

    # Start the game (no move)
    reply = agent.reply()
    assert "Welcome to the Gomoku game" in reply["content"]
    assert not agent.game_end

    # Define a helper to simulate a move by a player
    def make_move(player_name, row, col):
        move = {"name": player_name, "content": (row, col)}
        reply = agent.reply(move)
        return reply

    # Simulate moves to create a horizontal line of 5 black pieces at row 7, cols 3-7
    # Black moves first
    moves = [
        (NAME_BLACK, 7, 3),
        (NAME_WHITE, 0, 0),
        (NAME_BLACK, 7, 4),
        (NAME_WHITE, 0, 1),
        (NAME_BLACK, 7, 5),
        (NAME_WHITE, 0, 2),
        (NAME_BLACK, 7, 6),
    ]

    for player, r, c in moves:
        reply = make_move(player, r, c)
        assert not agent.game_end, f"Game ended prematurely at move {player} ({r},{c})"

    # The winning move: black places at (7,7) to complete 5 in a row horizontally
    reply = make_move(NAME_BLACK, 7, 7)

    # After this move, the game should be ended with black winning
    assert agent.game_end, "Game should be ended after winning move"
    assert f"{NAME_BLACK} wins" in reply["content"], "Winning message not found in reply"

    # The board at (7,7) must be black's piece
    assert agent.board[7, 7] == NAME_TO_PIECE[NAME_BLACK]

    # The win check must detect the win after the board update, so the test fails on buggy code
    # and passes on fixed code.


def test_no_false_win_before_board_update():
    """
    This test ensures that before the board is updated with the current move,
    the win check does not falsely detect a win.
    This indirectly tests that the board update happens before win check.
    """

    agent = BoardAgent()
    agent.game_end = False

    # Place four black stones in a row at (5,5) to (5,8)
    for col in range(5, 9):
        agent.board[5, col] = NAME_TO_PIECE[NAME_BLACK]

    # Now simulate black placing at (5,9) which should be the winning move
    move = {"name": NAME_BLACK, "content": (5, 9)}

    # The buggy code checks win before placing the piece, so it will not detect win here
    # The fixed code places the piece first, then checks win, so it will detect win

    reply = agent.reply(move)

    # The game should end with black winning
    assert agent.game_end, "Game should be ended after winning move"
    assert f"{NAME_BLACK} wins" in reply["content"], "Winning message not found in reply"
    assert agent.board[5, 9] == NAME_TO_PIECE[NAME_BLACK]


def test_draw_detection_after_move():
    """
    This test fills the board almost completely without a winner,
    then places the last piece to trigger a draw.
    It verifies that the draw is detected correctly after the move.
    """

    agent = BoardAgent()
    agent.game_end = False

    # Fill the board with alternating black and white pieces except one spot
    size = agent.board.shape[0]
    for r in range(size):
        for c in range(size):
            if (r, c) == (size - 1, size - 1):
                continue
            # Alternate pieces
            piece = NAME_TO_PIECE[NAME_BLACK] if (r + c) % 2 == 0 else NAME_TO_PIECE[NAME_WHITE]
            agent.board[r, c] = piece

    # The last move to fill the board, no winner, should trigger draw
    last_move = {"name": NAME_BLACK, "content": (size - 1, size - 1)}

    reply = agent.reply(last_move)

    assert agent.game_end, "Game should be ended after last move"
    assert "draw" in reply["content"].lower(), "Draw message not found in reply"
    assert agent.board[size - 1, size - 1] == NAME_TO_PIECE[NAME_BLACK][0m
