[32mimport pytest
import numpy as np

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE


def simulate_moves(agent, moves):
    """
    Helper to simulate a sequence of moves on the agent.
    Each move is a dict with keys: 'name' (player name) and 'content' (row, col).
    Returns the last content string and game_end flag.
    """
    content = None
    for move in moves:
        reply = agent.reply(move)
        content = reply.content if hasattr(reply, "content") else None
        if agent.game_end:
            break
    return content, agent.game_end


def test_gomoku_win_detection_order():
    """
    Test that the agent detects a win only after placing the piece on the board.
    This test tries to reproduce the buggy behavior where win is checked before placing.
    The fixed code places the piece first, so the win detection should be correct.
    """
    agent = BoardAgent(name="test_agent")
    # Start the game
    start_msg = agent.reply(None)
    assert "Welcome" in start_msg.content

    # Make moves to form a horizontal 5-in-a-row for black (NAME_BLACK)
    moves = []
    # Black moves at (7, 7), (7, 8), (7, 9), (7, 10), (7, 11)
    # White moves interleaved at (6, 7), (6, 8), (6, 9), (6, 10)
    moves.append({"name": NAME_BLACK, "content": (7, 7)})
    moves.append({"name": NAME_WHITE, "content": (6, 7)})
    moves.append({"name": NAME_BLACK, "content": (7, 8)})
    moves.append({"name": NAME_WHITE, "content": (6, 8)})
    moves.append({"name": NAME_BLACK, "content": (7, 9)})
    moves.append({"name": NAME_WHITE, "content": (6, 9)})
    moves.append({"name": NAME_BLACK, "content": (7, 10)})
    moves.append({"name": NAME_WHITE, "content": (6, 10)})
    # The winning move
    moves.append({"name": NAME_BLACK, "content": (7, 11)})

    content, game_end = simulate_moves(agent, moves)

    # The game should end with black winning
    assert game_end is True
    assert f"{NAME_BLACK} wins" in content


def test_gomoku_no_false_win_before_placing():
    """
    Test that the BoardAgent does not detect a win before placing the piece on the board.
    This test tries to simulate the buggy behavior by checking win before placing the piece.
    The fixed code places the piece first, so the win detection should only be true after placement.
    """
    agent = BoardAgent(name="test_agent2")
    # Start the game
    start_msg = agent.reply(None)
    assert "Welcome" in start_msg.content

    # Manually call check_win before placing the piece on the board at (7,7)
    # It should return False because the piece is not placed yet
    win_before = agent.check_win(7, 7, NAME_TO_PIECE[NAME_BLACK])
    assert win_before is False

    # Now place the piece and check win again
    agent.board[7, 7] = NAME_TO_PIECE[NAME_BLACK]
    win_after = agent.check_win(7, 7, NAME_TO_PIECE[NAME_BLACK])
    # Since only one piece, no win yet
    assert win_after is False


def test_gomoku_draw_detection():
    """
    Test that the BoardAgent detects a draw correctly.
    Fill the board with alternating pieces without any 5 in a row.
    """
    agent = BoardAgent(name="test_agent3")
    size = agent.board.shape[0]

    # Fill the board with alternating pieces in a checkerboard pattern
    for r in range(size):
        for c in range(size):
            piece = NAME_TO_PIECE[NAME_BLACK] if (r + c) % 2 == 0 else NAME_TO_PIECE[NAME_WHITE]
            agent.board[r, c] = piece

    # The board is full, so check_draw should be True
    assert agent.check_draw() is True

    # There should be no winner
    for r in range(size):
        for c in range(size):
            assert agent.check_win(r, c, agent.board[r, c]) is False


if __name__ == "__main__":
    pytest.main([__file__])[0m
