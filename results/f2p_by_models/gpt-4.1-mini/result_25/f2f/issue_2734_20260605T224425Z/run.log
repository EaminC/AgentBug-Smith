import asyncio
from src.crewai.llm import LLM


class DummyLlamaAPIClient:
    async def acall(self, prompt):
        # Simulate a dummy async response from Llama API
        if isinstance(prompt, list):
            # Assume list of messages
            return {"choices": [{"message": {"content": "Hello from dummy Llama API with messages"}}]}
        elif isinstance(prompt, str):
            # Simple string prompt
            if "JSON" in prompt:
