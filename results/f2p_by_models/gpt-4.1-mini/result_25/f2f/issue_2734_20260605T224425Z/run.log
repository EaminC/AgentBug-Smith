import asyncio

from src.crewai.llm import LLM


class DummyLlamaAPIClient:
    """
    Dummy client to mock Llama API responses for testing.
    """

    async def acall(self, prompt_or_messages):
        # Return a fixed response mimicking Llama API output
        if isinstance(prompt_or_messages, str):
            return "Hello from Llama API"
        elif isinstance(prompt_or_messages, list):
            # Assume list of messages
            return "Hello from Llama API with messages"
        else:
            return "Hello from Llama API with unknown input"

    async def call(self, prompt_or_messages):
        # Synchronous style call for compatibility
        return await self.acall(prompt_or_messages)


