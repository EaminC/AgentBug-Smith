    assert response.startswith("Dummy LlamaAPI response for prompt:")
    # Call asynchronously
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    response_async = loop.run_until_complete(llama.acall("Test integration async"))
    assert response_async.startswith("Dummy LlamaAPI response for prompt:")


