    """

    async def aclose(self):
        pass

    async def astream(self, *args, **kwargs):
        # Return an async generator that yields a single chunk
        async def gen():
            yield {"choices": [{"delta": {"content": "Hello from Llama API"}}]}
        return gen()

    async def acompletion(self, prompt=None, messages=None, **kwargs):
        # Return a dummy completion response
        if messages:
            content = "Hello from Llama API with messages"
        elif prompt:
            content = "Hello from Llama API with prompt"
        else:
            content = "Hello from Llama API"
        return {
            "choices": [
