[32mimport pytest
import litellm
from litellm import completion
from litellm.types.llms.openai import ChatCompletionMessage
import httpx


def test_llm_call_with_llama_api():
    # The test verifies that the Llama API model is recognized and does not raise BadRequestError
    # We use a known Llama API model string that should be supported after the fix.
    model_name = "llama-2-7b-chat"
    # We expect the call to not raise BadRequestError and to return a valid response with text.
    # We mock the internal network call by patching httpx.Client.send to return a dummy successful response.
    # But per instructions, we do not mock the exact function where the bug lives, so we let litellm.completion call real code.
    # The test will fail on buggy code because it raises BadRequestError for missing provider.
    # After fix, it should pass.
    try:
        result = completion(model=model_name, prompt="Hello, world!", max_tokens=5)
    except litellm.exceptions.BadRequestError as e:
        pytest.fail(f"BadRequestError raised unexpectedly: {e}")
    assert result.text is not None
    assert len(result.text) > 0


def test_llm_call_with_llama_api_message_list():
    # Test using message list input for chat model llama-2-7b-chat
    model_name = "llama-2-7b-chat"
    messages = [
        ChatCompletionMessage(role="system", content="You are a helpful assistant."),
        ChatCompletionMessage(role="user", content="Say hello."),
    ]
    try:
        result = completion(model=model_name, messages=messages, max_tokens=5)
    except litellm.exceptions.BadRequestError as e:
        pytest.fail(f"BadRequestError raised unexpectedly: {e}")
    assert result.text is not None
    assert "hello" in result.text.lower()


def test_llm_call_with_llama_api_structured():
    # Test structured output with llama-2-7b-chat model
    model_name = "llama-2-7b-chat"
    prompt = "Provide a JSON with a greeting message."
    try:
        result = completion(model=model_name, prompt=prompt, max_tokens=20, output_format="json")
    except litellm.exceptions.BadRequestError as e:
        pytest.fail(f"BadRequestError raised unexpectedly: {e}")
    # The result should be a dict or JSON parseable string
    # If result.text is JSON string, parse it
    import json
    try:
        parsed = json.loads(result.text)
    except Exception:
        pytest.fail("Output is not valid JSON")
    assert "greeting" in parsed or "message" in parsed


def test_llm_call_sync_with_llama_api():
    # Test synchronous call with llama-2-7b-chat
    model_name = "llama-2-7b-chat"
    prompt = "Hello from sync call."
    try:
        # Use litellm.completion with sync=True if supported, else just call normally
        result = completion(model=model_name, prompt=prompt, max_tokens=5)
    except litellm.exceptions.BadRequestError as e:
        pytest.fail(f"BadRequestError raised unexpectedly: {e}")
    assert result.text is not None
    assert len(result.text) > 0

# Note: These tests rely on litellm recognizing the llama-2-7b-chat model provider internally.
# On buggy code, these tests should fail with BadRequestError.
# On fixed code, they should pass and produce valid outputs.[0m
