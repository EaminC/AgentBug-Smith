[32mimport pytest
import asyncio
from src.crewai.llm import LLM


class DummyLlamaAPIClient:
    """
    Dummy client to simulate Llama API responses for testing.
    """

    async def aclose(self):
        pass

    async def acall(self, prompt_or_messages, **kwargs):
        # Return a fixed dummy response depending on input type
        if isinstance(prompt_or_messages, str):
            return "Hello from Llama API dummy"
        elif isinstance(prompt_or_messages, list):
            # Assume list of messages
            return "Hello from Llama API dummy with messages"
        else:
            return "Hello from Llama API dummy with unknown input"

    def call(self, prompt_or_messages, **kwargs):
        # Synchronous call fallback
        if isinstance(prompt_or_messages, str):
            return "Hello from Llama API dummy"
        elif isinstance(prompt_or_messages, list):
            return "Hello from Llama API dummy with messages"
        else:
            return "Hello from Llama API dummy with unknown input"


