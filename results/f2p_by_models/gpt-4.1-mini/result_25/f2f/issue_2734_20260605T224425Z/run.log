import asyncio
from src.crewai.llm import LLM


class DummyLlamaAPIClient:
    async def acall(self, prompt):
        # Simulate a dummy async response from Llama API
        if isinstance(prompt, list):
            # Assume prompt is a list of messages
            return {"choices": [{"message": {"content": "Hello from dummy Llama API with messages"}}]}
        elif isinstance(prompt, str):
            if "JSON" in prompt:
                return {"choices": [{"message": {"content": '{"greeting": "hello"}'}}]}
            return {"choices": [{"message": {"content": "Hello from dummy Llama API"}}]}
        else:
            return {"choices": [{"message": {"content": "Hello from dummy Llama API unknown input"}}]}


@pytest.mark.asyncio
