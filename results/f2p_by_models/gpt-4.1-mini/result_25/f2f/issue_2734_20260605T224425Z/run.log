[32mimport pytest
import asyncio
from litellm import LLM
from litellm.llms.llama_api import LlamaAPI
from litellm.schema import ChatCompletionRequest, ChatCompletionResponse, ChatCompletionMessage


class DummyLlamaAPIClient:
    async def chat_completions(self, request: ChatCompletionRequest) -> ChatCompletionResponse:
        # Return a dummy response that echoes the last user message content
        last_message = None
        for msg in reversed(request.messages):
            if msg.role == "user":
                last_message = msg.content
                break
        if last_message is None:
            last_message = "Hello from dummy Llama API"
        response_message = ChatCompletionMessage(role="assistant", content=f"Echo: {last_message}")
        return ChatCompletionResponse(choices=[{"message": response_message}], usage={"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0})


@pytest.mark.asyncio
async def test_llama_api_integration():
    # Instantiate the LlamaAPI LLM with the dummy client injected
    llama_api = LlamaAPI()
    # Patch the internal client method to use our dummy client
    llama_api._client = DummyLlamaAPIClient()

    # Prepare a chat completion request
    messages = [
        ChatCompletionMessage(role="system", content="You are a helpful assistant."),
        ChatCompletionMessage(role="user", content="Hello, Llama API!")
    ]

    request = ChatCompletionRequest(model="llama-2-7b-chat", messages=messages)

    # Call the chat_completions method and get response
    response = await llama_api.chat_completions(request)

    # Assert the response contains the expected echoed message
    assert response.choices, "Response should contain choices"
    choice_message = response.choices[0]["message"]
    assert choice_message.role == "assistant"
    assert "Echo: Hello, Llama API!" == choice_message.content


def test_llama_api_sync_call():
    # Test the synchronous call interface of LlamaAPI
    llama_api = LlamaAPI()
    llama_api._client = DummyLlamaAPIClient()

    messages = [
        ChatCompletionMessage(role="system", content="You are a helpful assistant."),
        ChatCompletionMessage(role="user", content="Sync call test")
    ]

    request = ChatCompletionRequest(model="llama-2-7b-chat", messages=messages)

    # Run the async method in event loop for sync test
    response = asyncio.run(llama_api.chat_completions(request))

    assert response.choices, "Response should contain choices"
    choice_message = response.choices[0]["message"]
    assert choice_message.role == "assistant"
    assert choice_message.content == "Echo: Sync call test"[0m
