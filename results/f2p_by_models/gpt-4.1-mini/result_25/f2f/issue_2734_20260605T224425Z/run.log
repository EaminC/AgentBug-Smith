[32mimport asyncio
import pytest

from crewai.llm import LLM


class DummyLlamaAPIClient:
    async def acreate(self, prompt=None, messages=None, **kwargs):
        # Dummy async create method to simulate Llama API response
        if prompt:
            return {"choices": [{"message": {"content": f"Echo: {prompt}"}}]}
        if messages:
            # Assume messages is a list of dicts with role and content
            last_message = messages[-1]["content"] if messages else ""
            return {"choices": [{"message": {"content": f"Echo: {last_message}"}}]}
        return {"choices": [{"message": {"content": "No input"}}]}

    async def acall(self, prompt_or_messages, **kwargs):
        # Provide a generic async call method for convenience
        if isinstance(prompt_or_messages, str):
            return await self.acreate(prompt=prompt_or_messages, **kwargs)
        elif isinstance(prompt_or_messages, list):
            return await self.acreate(messages=prompt_or_messages, **kwargs)
        else:
            return {"choices": [{"message": {"content": "Unsupported input"}}]}


@pytest.mark.asyncio
async def test_llm_call_with_llama_api():
    """
    Test that the LLM class supports Llama API integration correctly.

    This test will fail on the buggy codebase where Llama API support is missing or broken,
    and pass after the fix that integrates Llama API support in LiteLLM and crewAI.
    """

    # Instantiate LLM with model and provider set to litellm (which should support Llama API)
    llm = LLM(model="llama-2-7b-chat", provider="litellm")

    # Replace the internal client with our dummy client that returns a fixed response
    llm._client = DummyLlamaAPIClient()

    # Compose a simple prompt
    prompt = "Say hello"

    # Call the LLM with the prompt using the async interface
    # The fixed codebase should have 'acall' method; buggy does not.
    response = await llm.acall(prompt)

    # Check that the response contains the echoed prompt
    assert "choices" in response
    assert response["choices"][0]["message"]["content"] == f"Echo: {prompt}"


