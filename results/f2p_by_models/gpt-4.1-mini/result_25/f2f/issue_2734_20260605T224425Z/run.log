class DummyLlamaAPIClient:
    """
    Dummy client to mock Llama API responses for testing.
    """

    async def acall(self, prompt_or_messages):
        # Return a fixed dummy response regardless of input
        if isinstance(prompt_or_messages, list):
            # Message list input
