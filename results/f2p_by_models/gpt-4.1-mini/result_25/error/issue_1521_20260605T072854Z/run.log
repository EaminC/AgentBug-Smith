[32mimport re
import pytest

import crewai.agents.parser as parser


def test_extract_thought_with_none_input():
    # The _extract_thought method should handle None input gracefully
    # and not raise TypeError.
    # It should return an empty string in this case.
    if not hasattr(parser, "_extract_thought"):
        pytest.fail("_extract_thought function not found in crewai.agents.parser")

    result = parser._extract_thought(None)
    assert result == ""


def test_extract_thought_with_valid_text():
    if not hasattr(parser, "_extract_thought"):
        pytest.fail("_extract_thought function not found in crewai.agents.parser")

    text = "This is a thought\n\nFinal Answer"
    result = parser._extract_thought(text)
    assert result == "This is a thought"


def test_extract_thought_with_text_no_match():
    if not hasattr(parser, "_extract_thought"):
        pytest.fail("_extract_thought function not found in crewai.agents.parser")

    text = "No matching pattern here"
    result = parser._extract_thought(text)
    assert result == ""


def test_extract_thought_various_inputs():
    if not hasattr(parser, "_extract_thought"):
        pytest.fail("_extract_thought function not found in crewai.agents.parser")

    # None input returns empty string
    assert parser._extract_thought(None) == ""

    # Empty string returns empty string
    assert parser._extract_thought("") == ""

    # Text with \n\nFinal Answer returns text before that
    assert parser._extract_thought("Thought content\n\nFinal Answer") == "Thought content"

    # Text with \n\nAction returns text before that
    assert parser._extract_thought("Another thought\n\nAction") == "Another thought"

    # Text with no matching pattern returns empty string
    assert parser._extract_thought("No pattern here") == ""


@pytest.mark.parametrize(
    "input_text, expected",
    [
        (None, ""),
        ("", ""),
        ("Some text\n\nFinal Answer", "Some text"),
        ("No match here", ""),
        ("Leading thought\n\nAction", "Leading thought"),
        ("Multiple\nlines\n\nFinal Answer", "Multiple\nlines"),
    ],
)
def test_extract_thought_various_inputs_param(input_text, expected):
    if not hasattr(parser, "_extract_thought"):
        pytest.fail("_extract_thought function not found in crewai.agents.parser")

    result = parser._extract_thought(input_text)
    assert result == expected[0m
