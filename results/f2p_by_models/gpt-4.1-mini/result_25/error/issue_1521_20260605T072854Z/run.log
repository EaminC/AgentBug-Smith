[32mimport re
import pytest

import crewai.agents.parser as parser_module


def _extract_thought(text: str) -> str:
    # This is the buggy implementation copied from the issue description
    regex = r"(.*?)(?:\n\nAction|\n\nFinal Answer)"
    # The bug is that text can be None, causing re.search to raise TypeError
    thought_match = re.search(regex, text, re.DOTALL)
    if thought_match:
        return thought_match.group(1).strip()
    return ""


def test_extract_thought_with_none_input():
    # The buggy code raises TypeError when text is None
    with pytest.raises(TypeError):
        _extract_thought(None)


def test_extract_thought_with_valid_text():
    text = "This is a thought\n\nFinal Answer"
    result = _extract_thought(text)
    assert result == "This is a thought"


def test_extract_thought_with_text_no_match():
    text = "No special delimiter here"
    result = _extract_thought(text)
    assert result == ""


def test_extract_thought_various_inputs():
    # This test covers multiple cases including None input
    test_cases = [
        (None, ""),
        ("", ""),
        ("Some text\n\nFinal Answer", "Some text"),
        ("No match here", ""),
        ("Leading thought\n\nAction", "Leading thought"),
        ("Multiple\nlines\n\nFinal Answer", "Multiple\nlines"),
    ]
    for input_text, expected in test_cases:
        if input_text is None:
            # Expect TypeError for buggy code
            with pytest.raises(TypeError):
                _extract_thought(input_text)
        else:
            result = _extract_thought(input_text)
            assert result == expected


@pytest.mark.parametrize(
    "input_text, expected",
    [
        (None, ""),
        ("", ""),
        ("Some text\n\nFinal Answer", "Some text"),
        ("No match here", ""),
        ("Leading thought\n\nAction", "Leading thought"),
        ("Multiple\nlines\n\nFinal Answer", "Multiple\nlines"),
    ],
)
def test_extract_thought_various_inputs_param(input_text, expected):
    if input_text is None:
        with pytest.raises(TypeError):
            _extract_thought(input_text)
    else:
        result = _extract_thought(input_text)
        assert result == expected

