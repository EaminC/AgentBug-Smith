def test_extract_thought_returns_expected_substring():
    # Test that _extract_thought extracts the correct substring before double newlines and Action or Final Answer
    text = (
        "This is the thought part.\n\nAction: Do something\n\nFinal Answer: Done"
    )
    extract_thought = getattr(parser, "_extract_thought", None)
    if extract_thought is not None and callable(extract_thought):
        result = extract_thought(text)
        assert "This is the thought part." in result
        assert "Action" not in result
        assert "Final Answer" not in result
    else:
        classes = [
