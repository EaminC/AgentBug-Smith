[32mimport os
import re
import tempfile
import pytest

from crewai.agents import Crew
from crewai.task import Task


def test_crew_with_forced_output_file_does_not_raise_type_error():
    """
    This test verifies that creating and running a Crew with a task that has a forced output_file
    does not raise a TypeError from _extract_thought due to NoneType input.
    The buggy code raises TypeError when text is None in _extract_thought.
    The fixed code handles None gracefully.
    """

    # Setup a temporary directory for output
    with tempfile.TemporaryDirectory() as tmpdir:

        # Define a simple task with forced output_file
        def reporting_task() -> Task:
            return Task(
                config={},
                output_file=os.path.join(tmpdir, "report.md"),
            )

        # Create a Crew with one task that uses forced output_file
        crew = Crew(tasks={"reporting_task": reporting_task()})

        # Run the crew kickoff, which triggers the agent execution and parsing
        # The buggy code will raise TypeError inside parser._extract_thought
        # The fixed code will not raise and will produce output file

        # We expect no exception to be raised after fix, so if TypeError occurs,
        # the test will fail.
        try:
            crew.kickoff()
        except TypeError as e:
            pytest.fail(f"TypeError raised during crew kickoff: {e}")

        # Verify the output file was created and is not empty
        output_path = os.path.join(tmpdir, "report.md")
        assert os.path.exists(output_path), "Output file was not created"
        with open(output_path, "r", encoding="utf-8") as f:
            content = f.read()
        # The content should be a non-empty string (even if empty string is returned, file should exist)
        assert isinstance(content, str)
        # We allow empty content but file must exist and be readable


if __name__ == "__main__":
    pytest.main([__file__])[0m
