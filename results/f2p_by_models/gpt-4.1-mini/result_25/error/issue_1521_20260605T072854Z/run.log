[32mimport pytest
import re
from src.crewai.agents import parser


def test_extract_thought_with_none_input():
    # The buggy code does not handle None input and raises TypeError.
    # After the fix, it should return an empty string instead.
    # We directly call the _extract_thought method with None.
    # This test fails on buggy code (raises TypeError),
    # and passes on fixed code (returns "").

    # Access the _extract_thought method from the parser module
    extract_thought = parser.Parser._extract_thought

    # Call with None should not raise, but return empty string after fix
    result = extract_thought(None)
    assert isinstance(result, str)
    assert result == ""


def test_extract_thought_with_valid_text():
    # Test that the method extracts the thought correctly from valid text input
    extract_thought = parser.Parser._extract_thought

    text = "This is a thought.\n\nAction: something\n\nFinal Answer: done"
    thought = extract_thought(text)
    assert thought == "This is a thought."

    # Test with text that does not contain the delimiters
    text2 = "Just some random text without delimiters"
    thought2 = extract_thought(text2)
    assert thought2 == text2.strip()


def test_extract_thought_with_empty_string():
    # Test that empty string input returns empty string without error
    extract_thought = parser.Parser._extract_thought

    thought = extract_thought("")
    assert thought == ""


@pytest.mark.parametrize("input_text,expected", [
    ("Thought only\n\nAction: do something", "Thought only"),
    ("Thought only\n\nFinal Answer: done", "Thought only"),
    ("Thought only\n\nAction", "Thought only"),
    ("Thought only\n\nFinal Answer", "Thought only"),
])
def test_extract_thought_various_delimiters(input_text, expected):
    extract_thought = parser.Parser._extract_thought
    thought = extract_thought(input_text)
    assert thought == expected


# Additional test to simulate the scenario described in the issue:
# Create a dummy Crew with a forced output file and run a task that triggers the bug.
# We simulate the scenario by calling the method with None internally.
def test_simulate_crew_task_with_forced_output_file():
    from src.crewai.task import Task
    from src.crewai.crews import Crew
    import os
    import tempfile

    # Create a temporary directory for output
    with tempfile.TemporaryDirectory() as tmpdir:
        # Define a task with forced output file
        task = Task(
            config={"name": "reporting_task"},
            output_file=os.path.join(tmpdir, "report.md"),
        )

        # Create a crew with this single task
        crew = Crew(tasks=[task])

        # Run the crew kickoff, which internally calls the parser and _extract_thought
        # The buggy code will raise TypeError if None is passed to _extract_thought
        # The fixed code will handle it gracefully.

        # We expect no exceptions raised after the fix
        try:
            crew.kickoff()
        except TypeError as e:
            pytest.fail(f"TypeError raised during crew kickoff: {e}")
        except Exception as e:
            # Other exceptions are not expected
            pytest.fail(f"Unexpected exception raised during crew kickoff: {e}")

        # Check that the output file was created (or at least the directory exists)
        assert os.path.isdir(tmpdir)
        # The output file may or may not be created depending on crew logic,
        # but no crash should happen.

# Note: This test file assumes the repo is installed as a package with src/crewai
# and that parser.Parser._extract_thought is accessible as shown.
# It also assumes Crew and Task classes exist and behave as described in the issue.[0m
