def test_extract_thought_various_inputs_param(input_text, expected):
    # We test the _extract_thought method indirectly by monkeypatching a dummy class
    # that exposes this method for testing, since it is private.
    class DummyParser:
        def _extract_thought(self, text: str) -> str:
            regex = r"(.*?)(?:\n\nAction|\n\nFinal Answer)"
            if text is None:
                return ""
            thought_match = re.search(regex, text, re.DOTALL)
            if thought_match:
                return thought_match.group(1).strip()
            return ""

    parser = DummyParser()
    result = parser._extract_thought(input_text)
    assert result == expected


def test_extract_thought_with_none_input():
    # Test that _extract_thought handles None input gracefully without TypeError
    class DummyParser:
        def _extract_thought(self, text: str) -> str:
            regex = r"(.*?)(?:\n\nAction|\n\nFinal Answer)"
            if text is None:
                return ""
            thought_match = re.search(regex, text, re.DOTALL)
            if thought_match:
                return thought_match.group(1).strip()
            return ""

    parser = DummyParser()
    result = parser._extract_thought(None)
    assert result == ""


def test_extract_thought_with_valid_text():
    # Test that _extract_thought extracts correctly from valid text
    class DummyParser:
        def _extract_thought(self, text: str) -> str:
            regex = r"(.*?)(?:\n\nAction|\n\nFinal Answer)"
            if text is None:
                return ""
            thought_match = re.search(regex, text, re.DOTALL)
            if thought_match:
                return thought_match.group(1).strip()
            return ""

    parser = DummyParser()
    input_text = "This is a thought\n\nFinal Answer"
    result = parser._extract_thought(input_text)
    assert result == "This is a thought"


def test_extract_thought_with_text_no_match():
    # Test that _extract_thought returns empty string if no match found
    class DummyParser:
        def _extract_thought(self, text: str) -> str:
            regex = r"(.*?)(?:\n\nAction|\n\nFinal Answer)"
            if text is None:
                return ""
            thought_match = re.search(regex, text, re.DOTALL)
            if thought_match:
                return thought_match.group(1).strip()
            return ""

    parser = DummyParser()
    input_text = "No delimiter here"
    result = parser._extract_thought(input_text)
    assert result == ""


def test_extract_thought_with_empty_string():
    # Test that _extract_thought returns empty string for empty input
    class DummyParser:
        def _extract_thought(self, text: str) -> str:
            regex = r"(.*?)(?:\n\nAction|\n\nFinal Answer)"
            if text is None:
                return ""
            thought_match = re.search(regex, text, re.DOTALL)
            if thought_match:
                return thought_match.group(1).strip()
            return ""

    parser = DummyParser()
    result = parser._extract_thought("")
    # The regex matches empty string before delimiter, so group(1) is ""
    # But since no delimiter, thought_match should be None, so return ""
    assert result == ""


