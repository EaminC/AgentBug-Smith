from crewai.agents import parser


def test_extract_thought_with_none_input():
    # The _extract_thought method should handle None input gracefully
    # and not raise TypeError.
    # It should return an empty string in this case.
    result = parser._extract_thought(None)
    assert isinstance(result, str)
    assert result == ""


def test_extract_thought_with_valid_text():
    # Provide a valid text that matches the regex pattern
    text = "Thought content here\n\nAction: something"
    result = parser._extract_thought(text)
    # The result should be the part before the double newlines and keywords
    assert result == "Thought content here"


def test_extract_thought_with_text_no_match():
    # Provide text that does not match the regex pattern
    text = "No special keywords here"
    result = parser._extract_thought(text)
    # The result should be empty string if no match found
    assert result == ""


def test_reporting_task_output_file_creates_no_typeerror(tmp_path):
    # This test simulates creating a crew with a forced output file as in the issue.
    # We simulate a minimal Task and Crew usage to trigger the code path that
    # leads to _extract_thought being called with None.
    # We expect no TypeError and the output file to be created or handled gracefully.

    from crewai.task import Task
    from crewai.crews import Crew

    output_dir = tmp_path
    output_file = output_dir / "report.md"

    # Define a minimal task config dictionary for the test
    tasks_config = {
        "reporting_task": {
            "name": "reporting_task",
            "description": "A reporting task",
            "output_file": str(output_file),
        }
    }

    # Create a reporting task with forced output file
    def reporting_task():
        return Task(
            config=tasks_config["reporting_task"],
            output_file=str(output_file),
        )

    # Create a minimal crew with the reporting task
    crew = Crew(
        name="test_crew",
        tasks=[reporting_task()],
        output_dir=str(output_dir),
    )

    # Run the crew kickoff which internally triggers agent execution and parsing
    # This should not raise TypeError due to None text in _extract_thought
    try:
        crew.kickoff()
    except TypeError as e:
        pytest.fail(f"TypeError raised during crew kickoff: {e}")

    # Check that the output file is created or at least the path is valid string
    assert os.path.isdir(str(output_dir))
    # The output file may or may not be created depending on implementation,
    # but no exception should occur and output_file path should be a string.
    assert isinstance(str(output_file), str)


