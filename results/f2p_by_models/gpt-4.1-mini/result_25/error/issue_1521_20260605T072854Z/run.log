import pytest

import src.crewai.agents.parser as parser


def test_extract_thought_with_none_input():
    # The buggy code does not handle None input and raises TypeError.
    # After the fix, it should return an empty string instead.
    # We directly call the _extract_thought function with None.
    # This test fails on buggy code (raises TypeError),
    # and passes on fixed code (returns "").

    # _extract_thought is a standalone function in parser module
    extract_thought = parser._extract_thought

    result = extract_thought(None)
    assert result == ""


def test_extract_thought_with_valid_text():
    # Test that the function extracts the thought correctly from valid text input
    extract_thought = parser._extract_thought

    text = "This is a thought.\n\nAction: do something"
    expected = "This is a thought."
    result = extract_thought(text)
    assert result == expected


def test_extract_thought_with_empty_string():
    # Test that empty string input returns empty string without error
    extract_thought = parser._extract_thought

    result = extract_thought("")
    assert result == ""


@pytest.mark.parametrize("input_text,expected", [
    ("Thought only\n\nAction: do something", "Thought only"),
    ("Thought only\n\nFinal Answer: done", "Thought only"),
    ("Thought only\n\nAction", "Thought only"),
    ("Thought only\n\nFinal Answer", "Thought only"),
])
def test_extract_thought_various_delimiters(input_text, expected):
    extract_thought = parser._extract_thought

    result = extract_thought(input_text)
    assert result == expected


def test_simulate_crew_task_with_forced_output_file(tmp_path):
    # This test simulates the creation of a crew with a forced output file task
    # It verifies that no TypeError occurs during crew execution due to None text input
    # and that output file is created with expected content.

    from src.crewai.task import Task
    from src.crewai.crews import Crew

    # Define a simple task with forced output file path in tmp_path
    output_file = tmp_path / "report.md"

    def reporting_task():
        return Task(
            config={},
            output_file=str(output_file),
        )

    # Create a crew with the reporting task
    crew = Crew(tasks={"reporting_task": reporting_task()})

    # Run the crew kickoff, which internally calls the parser and _extract_thought
    # The buggy code raises TypeError due to None text input in _extract_thought
    # The fixed code handles None gracefully and produces output file.

    crew.kickoff()

    # After kickoff, output file should exist and not be empty
    assert output_file.exists()
    content = output_file.read_text()
    assert isinstance(content, str)
    assert len(content) > 0

    # The content should not contain Python error tracebacks or TypeError messages
    assert "TypeError" not in content
    assert "Traceback" not in content[0m
