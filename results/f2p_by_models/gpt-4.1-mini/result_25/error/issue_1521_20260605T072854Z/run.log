def test_extract_thought_handles_none_input():
    """
    Test that _extract_thought method handles None input without raising TypeError.
    Buggy code raises TypeError because re.search() is called with None.
    Fixed code returns empty string safely.
    """

    # Try to get _extract_thought as a standalone function
    extract_thought = getattr(parser, "_extract_thought", None)
    if extract_thought is not None and callable(extract_thought):
        # Call with None and expect no exception, returns empty string
        result = extract_thought(None)
