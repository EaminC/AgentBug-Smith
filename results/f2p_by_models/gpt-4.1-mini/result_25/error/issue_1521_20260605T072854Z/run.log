def test_crew_with_forced_output_file_does_not_raise_typeerror(tmp_path):
    """
    This test verifies that creating and running a Crew with a task that has a forced output_file
    does not raise a TypeError in the _extract_thought method due to None input.

    It reproduces the bug by forcing the output_file parameter and running the crew.
    The test expects no exceptions and that the output file is created with non-empty content.
    """

    # Setup output directory
    output_dir = tmp_path / "output"
    output_dir.mkdir()

    # Define a reporting task with forced output_file
    def reporting_task():
        return Task(
            config={"name": "reporting_task"},
            output_file=str(output_dir / "report.md"),
        )

    # Create Crew with the reporting task
    crew = Crew(
        tasks_config={"reporting_task": {"name": "reporting_task"}},
        tasks=[reporting_task],
        output_dir=str(output_dir),
    )

    # Run the crew and assert no TypeError occurs
    # The bug causes a TypeError in _extract_thought when text is None
    # The fix ensures text is never None or handled gracefully
    try:
        crew.run()
    except TypeError as e:
        # Fail the test if TypeError is raised due to NoneType input to re.search
        if "expected string or bytes-like object, got 'NoneType'" in str(e):
            pytest.fail("TypeError due to NoneType input to _extract_thought")
        else:
            raise

    # Check that the output file was created and is not empty
    output_file_path = output_dir / "report.md"
    assert output_file_path.exists(), "Output file was not created"
    content = output_file_path.read_text(encoding="utf-8")
    assert content.strip() != "", "Output file is empty"


