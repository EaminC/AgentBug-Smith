[32mimport os
import pytest
import re

from crewai.agents.parser import Parser
from crewai.task import Task
from crewai.crews import Crew


def test_extract_thought_handles_none_text():
    """
    This test verifies that the _extract_thought method in Parser
    does not raise a TypeError when passed None as text.
    Instead, it should return an empty string.
    """
    parser = Parser()
    # Directly call the internal method with None
    result = parser._extract_thought(None)
    assert isinstance(result, str)
    assert result == ""


def test_crew_with_forced_output_file_does_not_raise_typeerror(tmp_path):
    """
    This test creates a Crew with a task that has a forced output file.
    It runs the crew and asserts that no TypeError is raised due to None text
    in _extract_thought, which was the root cause of the bug.
    """
    # Setup output directory
    output_dir = tmp_path / "output"
    output_dir.mkdir()

    # Define a reporting task with forced output file path
    reporting_task = Task(
        config={},
        output_file=str(output_dir / "report.md"),
    )

    # Create a crew with the reporting task
    crew = Crew(tasks=[reporting_task])

    # Run the crew; if bug is present, this will raise TypeError
    # We expect no exception here after the fix
    try:
        crew.run()
    except TypeError as e:
        pytest.fail(f"TypeError was raised during crew run: {e}")

    # Check that the output file was created (or at least the directory is writable)
    # We do not enforce content here, just that no crash occurred and output file path is valid
    assert output_dir.exists()
    # The output file may or may not exist depending on implementation, so no assert on file presence


def test_extract_thought_regex_behavior():
    """
    Additional sanity test for _extract_thought with valid string input.
    Ensures that the regex extracts the expected thought portion.
    """
    parser = Parser()
    text = "This is the thought part.\n\nAction: do something\n\nFinal Answer: done"
    extracted = parser._extract_thought(text)
    assert extracted == "This is the thought part."


def test_extract_thought_empty_string():
    """
    Test that passing empty string returns empty string and does not error.
    """
    parser = Parser()
    result = parser._extract_thought("")
    assert result == ""


def test_extract_thought_no_match():
    """
    Test that if regex does not match, _extract_thought returns empty string.
    """
    parser = Parser()
    text = "No matching pattern here"
    result = parser._extract_thought(text)
    assert result == ""[0m
