[32mimport re
import pytest

from crewai.agents import parser


def test_extract_thought_with_none_input():
    # The _extract_thought method should handle None input gracefully
    # and not raise TypeError.
    # It should return an empty string in this case.
    if not hasattr(parser, "_extract_thought"):
        pytest.fail("_extract_thought function not found in crewai.agents.parser")

    result = parser._extract_thought(None)
    assert result == "", "Expected empty string when input is None"


def test_extract_thought_with_valid_text():
    if not hasattr(parser, "_extract_thought"):
        pytest.fail("_extract_thought function not found in crewai.agents.parser")

    text = "This is a thought.\n\nAction: do something"
    result = parser._extract_thought(text)
    assert result == "This is a thought.", "Thought extraction failed for valid text"


def test_extract_thought_with_text_no_match():
    if not hasattr(parser, "_extract_thought"):
        pytest.fail("_extract_thought function not found in crewai.agents.parser")

    text = "No delimiters here"
    result = parser._extract_thought(text)
    # Since no match, should return empty string
    assert result == "", "Expected empty string when no regex match"


def test_extract_thought_various_inputs():
    if not hasattr(parser, "_extract_thought"):
        pytest.fail("_extract_thought function not found in crewai.agents.parser")

    # None input
    assert parser._extract_thought(None) == ""

    # Empty string input
    assert parser._extract_thought("") == ""

    # Text with Final Answer delimiter
    text = "Some thought\n\nFinal Answer"
    assert parser._extract_thought(text) == "Some thought"

    # Text with Action delimiter
    text = "Another thought\n\nAction"
    assert parser._extract_thought(text) == "Another thought"

    # Text with no delimiter
    text = "Just some random text"
    assert parser._extract_thought(text) == ""


@pytest.mark.parametrize(
    "input_text,expected",
    [
        (None, ""),
        ("", ""),
        ("Some text\n\nFinal Answer", "Some text"),
        ("No match here", ""),
        ("Thought\n\nAction", "Thought"),
        ("Thought\n\nFinal Answer", "Thought"),
        ("Thought\n\nSomething else", ""),
    ],
)
def test_extract_thought_various_inputs_param(input_text, expected):
    if not hasattr(parser, "_extract_thought"):
        pytest.fail("_extract_thought function not found in crewai.agents.parser")

    result = parser._extract_thought(input_text)
    assert result == expected


def test_extract_thought_empty_string_behavior():
    # This test verifies the regex behavior on empty string input directly
    regex = r"(.*?)(?:\n\nAction|\n\nFinal Answer)"
    thought_match = re.search(regex, "", re.DOTALL)
    # The regex should not match empty string because the delimiters are not present
    assert thought_match is None, "Regex should not match empty string without delimiters"[0m
