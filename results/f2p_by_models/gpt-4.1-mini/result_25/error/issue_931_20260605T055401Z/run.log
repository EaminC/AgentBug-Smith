class MultiplyArgs(BaseModel):
    x: int
    y: int


def multiply_func(x: int, y: int) -> int:
    return x * y


def test_result_as_answer_prevents_llm_interaction(monkeypatch):
    # Create a structured tool with result_as_answer=True
    multiply_tool = StructuredTool.from_function(
        name="multiply",
        description="Multiply two numbers",
        func=multiply_func,
        args_schema=MultiplyArgs,
        return_direct=True,
    )

    # Create a dummy LLM that raises if called (to detect unwanted calls)
    class DummyLLM(LLM):
        def __init__(self):
            super().__init__()
            self.called = False

        def call(self, *args, **kwargs):
            self.called = True
            raise RuntimeError("LLM should not be called when result_as_answer=True")

    dummy_llm = DummyLLM()

    # Create a dummy task
    task = Task(name="multiply_task", input={"x": 3, "y": 4})

    # Prepare the agent executor with the multiply tool and dummy LLM
    agent = None  # We do not need a full agent for this test, pass None
    prompt = {"input": "multiply 3 and 4"}
