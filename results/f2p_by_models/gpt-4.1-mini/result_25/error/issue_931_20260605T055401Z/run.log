    max_tool_call_tokens = None
    max_tool_call_tokens_per_prompt = None
    max_tool_call_tokens_per_completion = None
    max_tool_call_tokens_per_message = None
    max_tool_call_rpm = None
    max_tool_call_rpm_per_tool = None
    max_tool_call_rpm_per_agent = None
    max_tool_call_rpm_per_crew = None
    max_tool_call_rpm_per_crew_agent = None
    max_tool_call_rpm_per_crew_tool = None
    max_tool_call_rpm_per_crew_tool_agent = None
    max_tool_call_rpm_per_crew_tool_agent_tool = None
    max_tool_call_rpm_per_crew_tool_agent_tool_call = None
    max_tool_call_rpm_per_crew_tool_agent_tool_call_tool = None

    # Instantiate CrewAgentExecutor with dummy LLM and our dummy agent and tool
    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=max_iter,
        tools=tools,
        tools_names=tools_names,
        stop_words=stop_words,
        tools_description=tools_description,
        verbose=verbose,
        step_callback=step_callback,
        crew=crew,
        training_handler=training_handler,
        task=task,
        contextual_memory=contextual_memory,
        knowledge_sources=knowledge_sources,
        knowledge=knowledge,
        agent_id=agent_id,
        max_rpm=max_rpm,
        max_tokens=max_tokens,
        max_tokens_per_prompt=max_tokens_per_prompt,
        max_tokens_per_completion=max_tokens_per_completion,
        max_tokens_per_message=max_tokens_per_message,
        max_iterations=max_iterations,
        max_tool_calls=max_tool_calls,
        max_tool_call_tokens=max_tool_call_tokens,
        max_tool_call_tokens_per_prompt=max_tool_call_tokens_per_prompt,
        max_tool_call_tokens_per_completion=max_tool_call_tokens_per_completion,
        max_tool_call_tokens_per_message=max_tool_call_tokens_per_message,
        max_tool_call_rpm=max_tool_call_rpm,
        max_tool_call_rpm_per_tool=max_tool_call_rpm_per_tool,
        max_tool_call_rpm_per_agent=max_tool_call_rpm_per_agent,
        max_tool_call_rpm_per_crew=max_tool_call_rpm_per_crew,
        max_tool_call_rpm_per_crew_agent=max_tool_call_rpm_per_crew_agent,
        max_tool_call_rpm_per_crew_tool=max_tool_call_rpm_per_crew_tool,
        max_tool_call_rpm_per_crew_tool_agent=max_tool_call_rpm_per_crew_tool_agent,
