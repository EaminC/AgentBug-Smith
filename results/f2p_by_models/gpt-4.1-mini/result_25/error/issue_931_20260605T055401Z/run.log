from crewai.agents.crew_agent_executor import CrewAgentExecutor, ToolResult
from crewai.agents.agent_builder.base_agent import BaseAgent
from crewai.tools.structured_tool import StructuredTool
from crewai.tools.base_tool import BaseTool
from crewai.agents.crew_agent_executor import AgentAction, AgentFinish
from pydantic import BaseModel

# We will mock the LLM client inside CrewAgentExecutor to avoid real API calls.
# But we cannot use unittest.mock, so we patch the llm attribute manually.

class DummyLLM:
    def __init__(self):
        self.stop = None
        self.call_count = 0

    def __call__(self, *args, **kwargs):
        self.call_count += 1
        # Return a dummy response that simulates an agent action calling a tool
        # We simulate that the agent calls the multiply tool once and then finishes.
        if self.call_count == 1:
            return AgentAction(tool="multiply", tool_input={"a": 3, "b": 4}, text="Call multiply tool")
        else:
            return AgentFinish(thought="Done", output="12", text="Final answer: 12")

# Define a simple tool with result_as_answer True to test the bug/fix
class MultiplyArgs(BaseModel):
    a: int
    b: int

class MultiplyTool(StructuredTool):
    def __init__(self):
        super().__init__(
            name="multiply",
            description="Multiply two integers",
            args_schema=MultiplyArgs,
            func=self.multiply,
            result_as_answer=True,
        )

    def multiply(self, a: int, b: int) -> int:
        return a * b

@pytest.fixture
def agent():
    # Minimal BaseAgent stub
    class DummyAgent(BaseAgent):
        name = "dummy_agent"
        description = "A dummy agent for testing"
        def __init__(self):
            super().__init__()

    return DummyAgent()

@pytest.fixture
def multiply_tool():
    return MultiplyTool()

def test_result_as_answer_short_circuit(monkeypatch, agent, multiply_tool):
    # Setup CrewAgentExecutor with the dummy LLM and the multiply tool
    tools = [multiply_tool]
    prompt = {"input": "Multiply 3 and 4"}
    tools_names = "multiply"
    stop_words = []
    tools_description = "Multiply tool"
    max_iter = 5

    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=max_iter,
        tools=tools,
        tools_names=tools_names,
        stop=stop_words,
        tools_description=tools_description,
        verbose=False,
        llm=DummyLLM(),
    )

    # Run the internal _invoke_loop method which drives the agent execution
    # It should return early with the tool result as answer without calling the LLM twice
    result = executor._invoke_loop()

    # The result should be an AgentFinish with output equal to 12 (3*4)
    assert isinstance(result, AgentFinish)
    assert result.output == 12 or result.output == "12"
    # The text should contain the observation with the tool result
    assert "Observation: 12" in result.text

    # The dummy LLM call count should be 1 if the fix is applied (no extra LLM call after tool)
    # If buggy, it would be 2 or more because the agent calls LLM again after tool
    assert executor.llm.call_count == 1

    # Also test that if we call _execute_tool_and_check_finality directly, it returns ToolResult with result_as_answer True
    agent_action = AgentAction(tool="multiply", tool_input={"a": 2, "b": 5}, text="Multiply 2 and 5")
    tool_result = executor._execute_tool_and_check_finality(agent_action)
    assert isinstance(tool_result, ToolResult)
    assert tool_result.result == 10
    assert tool_result.result_as_answer is True

# This test will fail on the buggy codebase because the agent will call the LLM twice
# and the final output will not be returned immediately after tool execution.
