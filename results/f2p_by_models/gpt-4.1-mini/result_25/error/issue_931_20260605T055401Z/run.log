from crewai.agents.crew_agent_executor import CrewAgentExecutor
from crewai.agents.agent_builder.base_agent import BaseAgent
from crewai.tools.structured_tool import StructuredTool
from crewai.tools.base_tool import BaseTool
from crewai.agents.agent import AgentAction, AgentFinish
from typing import Any


class DummyLLM:
    def __init__(self):
        self.stop = None
        self.call_count = 0

    def __call__(self, prompt: str, stop=None):
        self.call_count += 1
        # Return a dummy response that simulates an agent action calling the tool
        # The tool name is "multiply"
        # The agent action text is the prompt itself for simplicity
        # The agent action is serialized as JSON string in the output text
        # But since CrewAgentExecutor expects AgentAction object, we will simulate the _invoke_loop method directly
        return "dummy response"


class DummyAgent(BaseAgent):
    def __init__(self):
        super().__init__()
        self.name = "dummy_agent"


class MultiplyTool(StructuredTool):
    def __init__(self):
        # The tool returns the product of two numbers and sets result_as_answer=True
        def multiply(args):
            return args["x"] * args["y"]

        from pydantic import BaseModel

        class Args(BaseModel):
            x: int
            y: int

        super().__init__(
            name="multiply",
            description="Multiply two integers",
            args_schema=Args,
            func=multiply,
            result_as_answer=True,
        )


def test_result_as_answer_prevents_llm_call(monkeypatch):
    """
    This test verifies that when a tool has result_as_answer=True,
    the CrewAgentExecutor returns the tool result directly without calling the LLM again.

    The buggy code calls the LLM again even if result_as_answer=True.
    The fixed code returns immediately with the tool result, skipping further LLM calls.

    We test this by:
    - Creating a CrewAgentExecutor with a tool that has result_as_answer=True.
    - Forcing the agent to call that tool once.
    - Checking that the LLM call count is exactly 1 (initial call), not more.
    - Checking that the final result is the tool output.
    """

    # Setup dummy LLM that counts calls
    llm = DummyLLM()

    # Setup dummy agent
    agent = DummyAgent()

    # Setup multiply tool with result_as_answer=True
    multiply_tool = MultiplyTool()

    # Setup tools list
    tools = [multiply_tool]

    # Setup prompt dict (not used deeply)
    prompt = {"input": "multiply 3 and 4"}

    # We need to simulate the agent action that calls the multiply tool with arguments x=3, y=4
    # AgentAction expects a name and text, text can be the raw input or JSON args

    # We will patch the _invoke_loop method of CrewAgentExecutor to simulate the agent action directly,
    # bypassing the actual LLM parsing and generation for simplicity.

    # Create the CrewAgentExecutor instance
    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=5,
        tools=tools,
        tools_names="multiply",
        stop_words=[],
        tools_description="Multiply tool",
        llm=llm,
    )

    # Patch the _invoke_loop to simulate the agent action calling the multiply tool with args x=3, y=4
    def fake_invoke_loop(self, formatted_answer=None):
        # Create an AgentAction that calls multiply with args
        action = AgentAction(
            tool="multiply",
            text='{"x": 3, "y": 4}',
            log="",
            name="multiply",
            result=None,
        )
        # Call the internal method that executes the tool and checks finality
        tool_result = self._execute_tool_and_check_finality(action)
        # If result_as_answer is True, _invoke_loop returns AgentFinish immediately
        if tool_result.result_as_answer:
            return AgentFinish(
                thought="",
                output=tool_result.result,
                text=f"Observation: {tool_result.result}",
            )
        # Otherwise, return a dummy AgentFinish with tool result as output
        return AgentFinish(
            thought="",
            output=tool_result.result,
            text=f"Observation: {tool_result.result}",
        )

    # Patch the method on the executor instance
    executor._invoke_loop = types.MethodType(fake_invoke_loop, executor)

    # Run the executor's run method which calls _invoke_loop internally
    result = executor.run()

    # The multiply tool returns 3*4=12, and result_as_answer=True means no further LLM calls
    assert result.output == 12, "The output should be the multiply tool result 12"

    # The dummy LLM should have been called only once (initial call)
    # If buggy, it would be called multiple times due to not skipping after tool result
    assert llm.call_count == 1, "LLM should be called exactly once when result_as_answer=True"


