[32mimport pytest
import re

from crewai.agents.crew_agent_executor import CrewAgentExecutor
from crewai.tools.structured_tool import StructuredTool
from crewai.agents.agent_builder.base_agent import BaseAgent
from crewai.agents.agent import AgentAction, AgentFinish
from crewai.llm import LLM


class DummyLLM(LLM):
    def __init__(self):
        super().__init__()
        self.call_count = 0

    def _call(self, prompt: str, stop=None):
        self.call_count += 1
        # Return a dummy response that simulates the agent finishing immediately
        if "multiply" in prompt.lower():
            # Simulate agent action calling multiply tool
            return (
                '{"action": "multiply", "action_input": {"x": 3, "y": 4}}'
            )
        # Simulate agent finish response
        return '{"finish": "12"}'


class MultiplyTool(StructuredTool):
    def __init__(self, result_as_answer=False):
        super().__init__(
            name="multiply",
            description="Multiply two numbers",
            args_schema=None,
            func=self.multiply,
            result_as_answer=result_as_answer,
        )

    def multiply(self, x: int, y: int) -> int:
        return x * y

    def _run(self, **kwargs):
        # kwargs will have keys x and y
        x = kwargs.get("x")
        y = kwargs.get("y")
        return self.multiply(x, y)


class DummyAgent(BaseAgent):
    def __init__(self):
        super().__init__()
        self.name = "dummy_agent"
        self.description = "Dummy agent for testing"
        self.llm = DummyLLM()


def test_result_as_answer_prevents_llm_calls():
    """
    Test that when a tool has result_as_answer=True, the agent returns the tool output
    directly without further LLM calls.
    """

    # Create the multiply tool with result_as_answer=True
    multiply_tool = MultiplyTool(result_as_answer=True)

    # Create a dummy agent
    agent = DummyAgent()

    # Compose a prompt that triggers the multiply tool
    prompt = {"input": "Multiply 3 and 4"}

    # Create the CrewAgentExecutor with the multiply tool and dummy LLM
    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=5,
        tools=[multiply_tool],
        tools_names="multiply",
        stop_words=[],
        tools_description=multiply_tool.description,
        llm=agent.llm,
        verbose=False,
    )

    # Run the agent executor's _invoke_loop to simulate the agent run
    result = executor._invoke_loop()

    # The result should be an AgentFinish instance with output equal to 12 (3*4)
    assert isinstance(result, AgentFinish), "Expected AgentFinish as final result"
    assert result.output == 12, f"Expected output 12 but got {result.output}"

    # The dummy LLM call count should be 1 (only initial call) because result_as_answer=True
    # means no further LLM calls after tool execution
    assert agent.llm.call_count == 1, (
        f"Expected 1 LLM call but got {agent.llm.call_count} "
        "when result_as_answer=True disables further LLM calls"
    )


def test_result_as_answer_false_allows_llm_calls():
    """
    Test that when a tool has result_as_answer=False, the agent continues to interact with LLM.
    """

    # Create the multiply tool with result_as_answer=False (default)
    multiply_tool = MultiplyTool(result_as_answer=False)

    # Create a dummy agent
    agent = DummyAgent()

    # Compose a prompt that triggers the multiply tool
    prompt = {"input": "Multiply 3 and 4"}

    # Create the CrewAgentExecutor with the multiply tool and dummy LLM
    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=5,
        tools=[multiply_tool],
        tools_names="multiply",
        stop_words=[],
        tools_description=multiply_tool.description,
        llm=agent.llm,
        verbose=False,
    )

    # Run the agent executor's _invoke_loop to simulate the agent run
    result = executor._invoke_loop()

    # The result should be an AgentFinish instance with output containing the final answer
    assert isinstance(result, AgentFinish), "Expected AgentFinish as final result"

    # The output should contain the multiplication result (12)
    # It may be a string or int depending on implementation, so convert to string for check
    assert re.search(r"12", str(result.output)), f"Expected output to contain '12' but got {result.output}"

    # The dummy LLM call count should be > 1 because result_as_answer=False allows further LLM calls
    assert agent.llm.call_count > 1, (
        f"Expected more than 1 LLM call but got {agent.llm.call_count} "
        "when result_as_answer=False allows continued LLM interaction"
    )[0m
