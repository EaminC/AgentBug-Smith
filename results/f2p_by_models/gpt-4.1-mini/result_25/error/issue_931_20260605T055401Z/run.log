[32mimport pytest
from crewai.agents.crew_agent_executor import CrewAgentExecutor
from crewai.tools.structured_tool import StructuredTool
from crewai.agents.agent_builder.base_agent import BaseAgent
from crewai.task import Task
from crewai.llm import LLM
from crewai.agents.agent import AgentAction, AgentFinish
from typing import Any


class DummyLLM(LLM):
    def __init__(self):
        super().__init__()
        self.call_count = 0

    def call(self, prompt: str, **kwargs) -> str:
        self.call_count += 1
        # Return a fixed response that triggers the tool call
        # For simplicity, return an AgentAction formatted string
        # that CrewAgentExecutor will parse to AgentAction
        # We simulate the agent requesting the tool "multiply"
        return '{"tool": "multiply", "arguments": {"a": 3, "b": 4}}'


class MultiplyTool(StructuredTool):
    def __init__(self, result_as_answer: bool):
        # Define a simple args schema with two integers a and b
        from pydantic import BaseModel

        class ArgsSchema(BaseModel):
            a: int
            b: int

        def multiply_func(a: int, b: int) -> int:
            return a * b

        super().__init__(
            name="multiply",
            description="Multiply two numbers",
            args_schema=ArgsSchema,
            func=multiply_func,
            result_as_answer=result_as_answer,
        )


class DummyAgent(BaseAgent):
    def __init__(self):
        super().__init__(name="dummy_agent")


def test_result_as_answer_behavior():
    """
    This test verifies that when a tool has result_as_answer=True,
    the CrewAgentExecutor returns the tool's output directly as the final answer
    without making additional LLM calls.

    The test fails on the buggy codebase because the agent still makes LLM calls
    after tool execution even if result_as_answer=True.

    After the fix, the agent should return immediately after the tool result
    and no extra LLM calls should be made.
    """
    # Prepare the dummy LLM and tool with result_as_answer=True
    llm = DummyLLM()
    tool = MultiplyTool(result_as_answer=True)
    tools = [tool]
    tools_names = tool.name
    stop_words = []
    tools_description = tool.description

    # Prepare dummy prompt dict (not used by DummyLLM)
    prompt = {"input": "Calculate 3 times 4"}

    # Create a dummy agent
    agent = DummyAgent()

    # Create the CrewAgentExecutor with max_iter=5 (arbitrary)
    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=5,
        tools=tools,
        tools_names=tools_names,
        stop=stop_words,
        tools_description=tools_description,
        llm=llm,
        verbose=False,
    )

    # Run the agent executor _invoke_loop directly to test the interaction
    # We expect the result to be AgentFinish with output 12 (3*4)
    result = executor._invoke_loop()

    # Assert that the result is AgentFinish
    assert isinstance(result, AgentFinish), "Expected AgentFinish as final result"

    # Assert that the output is the multiplication result 12
    assert result.output == 12, f"Expected output 12 but got {result.output}"

    # Assert that the DummyLLM was called exactly once (the initial prompt)
    # and no further calls after tool execution
    assert llm.call_count == 1, f"Expected 1 LLM call but got {llm.call_count}"


def test_result_as_answer_false_behavior():
    """
    This test verifies that when a tool has result_as_answer=False,
    the CrewAgentExecutor continues to interact with the LLM after tool execution.

    The test fails on the buggy codebase because it does not distinguish this case.

    After the fix, the agent should continue LLM calls if result_as_answer=False.
    """
    # Prepare the dummy LLM and tool with result_as_answer=False
    llm = DummyLLM()
    tool = MultiplyTool(result_as_answer=False)
    tools = [tool]
    tools_names = tool.name
    stop_words = []
    tools_description = tool.description

    # Prepare dummy prompt dict (not used by DummyLLM)
    prompt = {"input": "Calculate 3 times 4"}

    # Create a dummy agent
    agent = DummyAgent()

    # Create the CrewAgentExecutor with max_iter=5 (arbitrary)
    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=5,
        tools=tools,
        tools_names=tools_names,
        stop=stop_words,
        tools_description=tools_description,
        llm=llm,
        verbose=False,
    )

    # Run the agent executor _invoke_loop directly to test the interaction
    # We expect the result NOT to be AgentFinish immediately after tool call,
    # so the DummyLLM should be called more than once.
    result = executor._invoke_loop()

    # The result can be AgentFinish or AgentAction depending on max_iter,
    # but the key is that llm.call_count > 1 (more than one call)
    assert llm.call_count > 1, (
        f"Expected more than 1 LLM call when result_as_answer=False, "
        f"got {llm.call_count}"
    )[0m
