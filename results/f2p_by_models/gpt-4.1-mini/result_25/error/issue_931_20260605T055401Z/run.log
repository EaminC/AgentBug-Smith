        finish = AgentFinish(
            thought="",
            output=tool_result.result,
            text=formatted_answer.text + f"\nObservation: {tool_result.result}",
        )
    else:
        finish = None

    assert finish is not None
    assert finish.output == 12
    assert "Observation: 12" in finish.text


