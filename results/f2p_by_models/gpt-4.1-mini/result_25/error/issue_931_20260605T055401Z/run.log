from crewai.agents.crew_agent_executor import CrewAgentExecutor
from crewai.tools.structured_tool import StructuredTool
from crewai.agents.agent_builder.base_agent import BaseAgent
from crewai.task import Task
from crewai.llm import LLM


class DummyLLM(LLM):
    async def _acall(self, messages, **kwargs):
        # Should not be called when result_as_answer=True
        raise RuntimeError("LLM should not be called when result_as_answer=True")

    def _call(self, messages, **kwargs):
        # Should not be called when result_as_answer=True
        raise RuntimeError("LLM should not be called when result_as_answer=True")


class MultiplyTool(StructuredTool):
    def __init__(self):
        def multiply(a: int, b: int) -> int:
            return a * b

        super().__init__(
            name="multiply",
            description="Multiply two integers",
            args_schema=type(
                "MultiplyArgs",
                (object,),
                {"a": int, "b": int},
            ),
            func=multiply,
            result_as_answer=True,
        )


class DummyAgent(BaseAgent):
    def __init__(self):
        super().__init__(
            name="dummy_agent",
            description="Dummy agent for testing",
            llm=DummyLLM(),
            tools=[MultiplyTool()],
        )


@pytest.mark.asyncio
async def test_result_as_answer_skips_llm_and_returns_tool_output_directly():
    agent = DummyAgent()
    task = Task(
        id="test_task",
        input={"a": 3, "b": 4},
        output=None,
        description="Multiply test",
    )

    # Prepare the CrewAgentExecutor with the agent and the multiply tool
    executor = CrewAgentExecutor(
        agent=agent,
        prompt={"input": "Multiply 3 and 4"},
        max_iter=3,
        tools=agent.tools,
        tools_names="multiply",
        stop_words=[],
        tools_description="Multiply two numbers",
        llm=agent.llm,
        task=task,
        verbose=False,
    )

    # We simulate the agent action to call the multiply tool with args a=3, b=4
    from crewai.agents.agent_builder.base_agent import AgentAction

    action = AgentAction(tool="multiply", tool_input='{"a": 3, "b": 4}', text="Calling multiply tool")

    # Run the internal method that executes the tool and checks if result_as_answer triggers immediate finish
    tool_result = executor._execute_tool_and_check_finality(action)

    # The tool_result.result should be 12 (3*4)
    assert tool_result.result == 12

    # Because result_as_answer=True, the executor should treat this as final answer
    assert tool_result.result_as_answer is True

    # Now simulate the _invoke_loop to see if it returns AgentFinish immediately when result_as_answer=True
    result = await executor._invoke_loop(formatted_answer=action)

    # The result should be an AgentFinish instance with output equal to 12
    from crewai.agents.agent_builder.base_agent import AgentFinish

    assert isinstance(result, AgentFinish)
    assert result.output == 12

    # Also verify that no LLM calls were made (DummyLLM raises if called)
    # If LLM was called, test would have failed by raising RuntimeError

    # This confirms that when result_as_answer=True, the tool output is returned directly without LLM interaction


