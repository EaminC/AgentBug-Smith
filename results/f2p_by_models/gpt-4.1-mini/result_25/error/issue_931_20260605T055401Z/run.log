        tool_result = self._execute_tool_and_check_finality(action)
        if tool_result.result_as_answer:
            # The agent should return AgentFinish immediately with tool result as output
            return AgentFinish(thought="", output=tool_result.result, text=f"Observation: {tool_result.result}")
        else:
            # If result_as_answer is False, simulate that agent calls LLM after tool
            # For test, just simulate one LLM call and then finish
            self.llm.call("dummy prompt")
            return AgentFinish(thought="", output=f"Processed {tool_result.result}", text=f"Processed observation")

    executor._invoke_loop = types.MethodType(patched_invoke_loop, executor)

    # Run the executor
    result = executor._invoke_loop()

    # Check the output and LLM call count depending on result_as_answer
    if result_as_answer:
        # The output should be the direct tool result (3*4=12)
        assert result.output == 12
        # The LLM should not have been called (call_count == 0)
        assert agent.llm.call_count == 0
    else:
        # The output should be processed string
        assert result.output == "Processed 12"
        # The LLM should have been called once
        assert agent.llm.call_count == 1[0m
