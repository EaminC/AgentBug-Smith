class MultiplyArgs(BaseModel):
    x: int
    y: int


def multiply_func(x: int, y: int) -> int:
    return x * y


class DummyAgent(BaseAgent):
    name = "dummy_agent"
    description = "A dummy agent for testing"
    tools = []

    def __init__(self):
        super().__init__(name=self.name, description=self.description, tools=self.tools)


class DummyLLM:
    def __init__(self):
        self.stop = None

    def __call__(self, prompt: str) -> str:
        # This dummy LLM just returns a fixed response
        return "Final answer"


def test_result_as_answer_tool_direct_return():
    # Create a tool with result_as_answer=True
    multiply_tool = StructuredTool.from_function(
        name="multiply",
        description="Multiply two numbers",
        func=multiply_func,
        return_direct=True,
        args_schema=MultiplyArgs,
    )

    # Create a dummy agent with this tool
    agent = DummyAgent()
    agent.tools = [multiply_tool]

    # Setup the CrewAgentExecutor with the tool and dummy LLM
    llm = DummyLLM()
    tools = [multiply_tool]

    # The prompt simulates an agent action to multiply 3 and 4
    prompt = {"input": "multiply 3 and 4"}

    # Create an AgentAction that calls the multiply tool with arguments
    agent_action = AgentAction(tool="multiply", tool_input='{"x":3,"y":4}', text="Multiply 3 and 4")

    # Instantiate CrewAgentExecutor
    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=1,
        tools=tools,
        tools_names="multiply",
        stop_words=[],
        tools_description="Multiply two numbers",
        llm=llm,
        verbose=False,
        step_callback=None,
        i18n=None,
        training_handler=None,
        crew=None,
