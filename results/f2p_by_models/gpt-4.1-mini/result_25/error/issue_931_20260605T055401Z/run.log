                    "message": {
                        "content": "Final answer: 42",
                        "role": "assistant",
                    }
                }
            ],
            "usage": {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15},
        }


class DummyAgent(BaseAgent):
    def __init__(self, tools):
        super().__init__(
            name="dummy_agent",
            description="Dummy agent for testing",
            tools=tools,
            llm=DummyLLM(),
        )


def test_result_as_answer_short_circuits_llm_calls():
    """
    Test that when a tool has result_as_answer=True, the agent returns the tool output
    directly without making extra LLM calls.

    Buggy behavior:
    - The agent calls the LLM even after the tool returns a direct answer.
    - So DummyLLM.call_count > 0 after tool usage.

