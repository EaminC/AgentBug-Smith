[32mimport pytest
from typing import Any
from pydantic import BaseModel
from crewai.agents.crew_agent_executor import CrewAgentExecutor
from crewai.agents.agent_builder.base_agent import BaseAgent
from crewai.tools.structured_tool import StructuredTool
from crewai.agents.agent_builder.base_agent import AgentAction, AgentFinish


class MultiplyArgs(BaseModel):
    x: int
    y: int


def multiply_func(x: int, y: int) -> int:
    return x * y


class DummyAgent(BaseAgent):
    def __init__(self):
        super().__init__(name="dummy_agent")

    def _parse_output(self, output: str) -> Any:
        # For test, parse output to AgentAction with tool call "multiply"
        # The output string will be ignored; we simulate a tool call action
        return AgentAction(tool="multiply", tool_input={"x": 3, "y": 4}, text="Calling multiply tool")

    def _format_answer(self, answer: Any) -> Any:
        # Return answer as is for test
        return answer


class DummyLLM:
    def __init__(self):
        self.stop = None

    def __call__(self, *args, **kwargs):
        # Simulate LLM call returning a fixed response
        return "dummy response"


def test_result_as_answer_prevents_llm_interaction():
    """
    Test that when a tool has result_as_answer=True, the CrewAgentExecutor returns the tool output
    immediately without further LLM calls or iterations.
    """

    # Create a StructuredTool with result_as_answer=True
    multiply_tool = StructuredTool.from_function(
        name="multiply",
        description="Multiply two integers",
        schema=MultiplyArgs,
        func=multiply_func,
        return_direct=True,
    )

    # Create dummy agent and dummy LLM
    agent = DummyAgent()
    llm = DummyLLM()

    # Prepare prompt dict (not used in this test)
    prompt = {"input": "Multiply 3 by 4"}

    # Initialize CrewAgentExecutor with the multiply tool
    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=5,
        tools=[multiply_tool],
        tools_names="multiply",
        stop_words=[],
        tools_description="Multiply tool",
        llm=llm,
        verbose=False,
        step_callback=None,
        crew=None,
    )

    # Patch the _invoke_loop method to simulate the agent producing an AgentAction for the multiply tool
    # We want to test that the tool result is returned immediately as final answer due to result_as_answer=True

    # Run the internal _invoke_loop method
    result = executor._invoke_loop()

    # The result should be an AgentFinish instance with output equal to 12 (3*4)
    assert isinstance(result, AgentFinish), "Expected AgentFinish as final result"
    assert result.output == 12, f"Expected output 12, got {result.output}"

    # Also check that the text contains the observation with the result
    assert "Observation: 12" in result.text

    # Check that no further iterations or LLM calls happened by verifying iterations count is 0 or 1
    # (Since we do not have direct LLM call count, we rely on that the loop ended immediately)
    assert executor.iterations <= 1, "Expected at most one iteration due to result_as_answer=True"


if __name__ == "__main__":
    pytest.main([__file__])[0m
