def test_result_as_answer_false_calls_llm_more_than_once():
    """
    Test that when a tool has result_as_answer=False, the agent calls the LLM multiple times.
    """

    # Create a multiply tool with result_as_answer=False (default)
    multiply_tool = StructuredTool.from_function(
        name="multiply",
        description="Multiply two integers",
        schema=MultiplyArgs,
        func=multiply_func,
        return_direct=False,
    )

    agent = DummyAgent()
    llm = DummyLLM()

    prompt = {"input": "Multiply 3 and 4"}

    executor = CrewAgentExecutor(
