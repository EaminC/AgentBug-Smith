    # and not return immediately on result_as_answer=True, causing iteration count > 1 or no AgentFinish returned.


@pytest.mark.timeout(10)
def test_tool_without_result_as_answer_does_not_shortcircuit():
    """
    Test that when a tool has result_as_answer=False, the CrewAgentExecutor does not short-circuit
    and continues the agent loop (simulated).
    """

    class EchoTool(StructuredTool):
        def __init__(self):
            super().__init__(
                name="echo",
                description="Echo input",
                args_schema=type("Args", (), {"text": str}),
                func=self.echo,
                result_as_answer=False,
            )
        def echo(self, text):
            return text

    echo_tool = EchoTool()

    dummy_agent = DummyAgent()
    dummy_agent.tools = [echo_tool]

    prompt = {"input": "Echo hello"}

    executor = CrewAgentExecutor(
        agent=dummy_agent,
        prompt=prompt,
        max_iter=5,
        tools=[echo_tool],
        tools_names="echo",
        stop_words=[],
        tools_description="Echo input",
        llm=DummyLLM(),
        verbose=False,
        step_callback=None,
        crew=None,
    )

    action = AgentAction(
        tool="echo",
        tool_input='{"text":"hello"}',
        log="Calling echo tool",
        text="",
        result=None,
        output=None,
    )

    def fake_invoke_loop(self, formatted_answer=None):
        tool_result = self._execute_tool_and_check_finality(action)
        # Since result_as_answer is False, should not return AgentFinish here
        assert tool_result.result_as_answer is False
        # Simulate continuing the loop by returning None or similar
        return None

    executor._invoke_loop = types.MethodType(fake_invoke_loop, executor)

    result = executor._invoke_loop()
    assert result is None


