from crewai.agents.crew_agent_executor import CrewAgentExecutor, AgentAction, AgentFinish
from crewai.tools.structured_tool import StructuredTool
from crewai.tools.base_tool import BaseTool
from crewai.agents.agent import BaseAgent
from crewai.llm import LLM
from crewai.task import Task


class DummyLLM(LLM):
    def __init__(self):
        super().__init__()
        self.call_count = 0

    def call(self, prompt, **kwargs):
        self.call_count += 1
        # Return a dummy response that simulates an agent action to call the tool
        if self.call_count == 1:
            # First call returns an action to invoke the tool
            return AgentAction(tool_name="multiply", text="Multiply 2 and 3")
        else:
            # Second call returns a finish (should not be called if result_as_answer works)
            return AgentFinish(thought="done", output="Should not be called")


class MultiplyTool(StructuredTool):
    def __init__(self, result_as_answer=False):
        def multiply(args):
            return args["a"] * args["b"]

        super().__init__(
            name="multiply",
            description="Multiply two numbers",
            args_schema=type(
                "Args",
                (object,),
                {"a": int, "b": int},
            ),
            func=multiply,
            result_as_answer=result_as_answer,
        )


class DummyAgent(BaseAgent):
    def __init__(self):
        super().__init__(
            name="dummy",
            description="A dummy agent",
            llm=DummyLLM(),
            tools=[],
        )


def test_result_as_answer_prevents_llm_calls():
    """
    This test verifies that when a tool has result_as_answer=True,
    the agent returns the tool result directly without calling the LLM again.
    Before the fix, the LLM would be called multiple times even with result_as_answer=True.
    After the fix, the LLM should only be called once.
    """

    # Setup a tool with result_as_answer=True
    tool = MultiplyTool(result_as_answer=True)
    tools = [tool]

    # Setup a dummy agent with the dummy LLM and the tool
    agent = DummyAgent()
    agent.tools = tools

    # Setup CrewAgentExecutor with the dummy agent and tool
    executor = CrewAgentExecutor(
        agent=agent,
        prompt={"input": "Multiply 2 and 3"},
        max_iter=5,
        tools=tools,
        tools_names="multiply",
        stop_words=[],
        tools_description="Multiply two numbers",
        llm=agent.llm,
        verbose=False,
        step_callback=None,
        training_handler=None,
    )

    # Run the agent executor loop
    result = executor._invoke_loop()

    # The result should be an AgentFinish with output equal to 6 (2*3)
    assert isinstance(result, AgentFinish), "Expected AgentFinish as final result"
    assert result.output == 6, "Expected output to be the multiplication result 6"

    # The dummy LLM call count should be exactly 1, meaning no extra LLM calls after tool
    assert agent.llm.call_count == 1, "Expected only one LLM call when result_as_answer=True"


def test_result_as_answer_false_calls_llm_multiple_times():
    """
    This test verifies that when a tool has result_as_answer=False,
    the agent calls the LLM multiple times (tool output is appended and LLM continues).
    Before and after the fix, this behavior should remain.
    """

    # Setup a tool with result_as_answer=False
    tool = MultiplyTool(result_as_answer=False)
    tools = [tool]

    # Setup a dummy agent with the dummy LLM and the tool
    agent = DummyAgent()
    agent.tools = tools

    # Setup CrewAgentExecutor with the dummy agent and tool
    executor = CrewAgentExecutor(
        agent=agent,
        prompt={"input": "Multiply 2 and 3"},
        max_iter=5,
        tools=tools,
        tools_names="multiply",
        stop_words=[],
        tools_description="Multiply two numbers",
        llm=agent.llm,
        verbose=False,
        step_callback=None,
        training_handler=None,
    )

    # Run the agent executor loop
    result = executor._invoke_loop()

    # The result should be an AgentFinish (final output)
    assert isinstance(result, AgentFinish), "Expected AgentFinish as final result"

    # The dummy LLM call count should be more than 1, meaning LLM was called again after tool
    assert agent.llm.call_count > 1, "Expected multiple LLM calls when result_as_answer=False"

    # The output should contain the multiplication result 6 somewhere
    assert "6" in str(result.output), "Expected output to contain the multiplication result 6"[0m
