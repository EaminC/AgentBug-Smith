[32mimport sys
import os
import pytest

# Adjust sys.path to import from src directory
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "../src")))

from crewai.agents.crew_agent_executor import CrewAgentExecutor
from crewai.agents.agent_builder.base_agent import BaseAgent
from crewai.tools.structured_tool import StructuredTool
from crewai.agents.agent_builder.base_agent import AgentAction, AgentFinish
from crewai.llm import LLM
from pydantic import BaseModel
from typing import Any, Dict


class MultiplyArgs(BaseModel):
    x: int
    y: int


def multiply_func(x: int, y: int) -> int:
    return x * y


class DummyLLM(LLM):
    def __init__(self):
        super().__init__(model="dummy-model")

    def _call(self, prompt: str, stop=None) -> str:
        # Return a fixed response that simulates the agent deciding to call the multiply tool
        # The response should be an AgentAction JSON string to invoke the multiply tool
        # For simplicity, we simulate the agent calling the multiply tool with x=3, y=4
        # The format is expected to be something like:
        # {"tool": "multiply", "args": {"x": 3, "y": 4}}
        # But since CrewAgentExecutor expects AgentAction object, it will parse it internally.
        # We return a string that will be parsed into an AgentAction with name "multiply" and args.
        # We simulate the agent's output as a JSON string with tool name and args.
        return (
            '{"tool": "multiply", "args": {"x": 3, "y": 4}}'
        )


class DummyAgent(BaseAgent):
    def __init__(self):
        super().__init__(name="dummy_agent", description="A dummy agent for testing.")


@pytest.mark.timeout(30)
def test_result_as_answer_short_circuit():
    """
    Test that when a tool has result_as_answer=True, the agent returns the tool output
    directly without making additional LLM calls.

    This test will fail on the buggy codebase because the agent still makes LLM calls
    after tool execution even if result_as_answer=True.

    After applying the fix, the test should pass.
    """
    # Create the multiply tool with result_as_answer=True
    multiply_tool = StructuredTool.from_function(
        name="multiply",
        description="Multiply two integers",
        func=multiply_func,
        schema=MultiplyArgs,
        return_direct=True,  # This sets result_as_answer=True internally
    )

    # Setup dummy agent and dummy LLM
    agent = DummyAgent()
    llm = DummyLLM()

    # Prepare prompt dict (not used deeply in dummy LLM)
    prompt = {"input": "Multiply 3 and 4"}

    # Create CrewAgentExecutor with the multiply tool
    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=3,
        tools=[multiply_tool],
        tools_names="multiply",
        stop_words=[],
        tools_description="Multiply tool",
        llm=llm,
        verbose=False,
    )

    # Run the agent executor _invoke_loop directly to simulate agent execution
    # It should return an AgentFinish immediately after tool execution due to result_as_answer=True
    result = executor._invoke_loop()

    # Assert the result is an AgentFinish instance
    assert isinstance(result, AgentFinish), "Expected AgentFinish as final output"

    # Assert the output is the multiplication result (3*4=12)
    assert result.output == 12, f"Expected output 12, got {result.output}"

    # Assert the text contains the observation with the result
    assert "Observation: 12" in result.text

    # Assert that no additional LLM calls were made after the tool execution
    # We can check usage metrics from the executor.llm if available
    # On buggy codebase, successful_requests > 1; on fixed codebase, should be 1
    usage = getattr(executor.llm, "usage_metrics", None)
    if usage:
        assert usage.get("successful_requests", 1) == 1, (
            "Expected only one LLM call due to result_as_answer=True, "
            "but multiple calls were made."
        )
    else:
        # If usage_metrics is not implemented, we skip this check
        pass

    # Cleanup sys.path
    sys.path.pop(0)[0m
