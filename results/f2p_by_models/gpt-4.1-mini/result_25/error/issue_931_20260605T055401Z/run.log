    agent = DummyAgent()

    # Setup a dummy prompt dict (not used by DummyLLM)
    prompt = {"input": "Calculate 3 times 4"}

    # Create CrewAgentExecutor with the tool and dummy LLM
    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=5,
        tools=[multiply_tool],
        tools_names="multiply",
        stop_words=[],
        tools_description="Multiply two numbers",
        llm=dummy_llm,
        verbose=False,
        step_callback=None,
    )

    # Run the agent executor _invoke_loop (internal method that runs the agent loop)
    # It should return an AgentFinish immediately after tool usage because result_as_answer=True
    result = executor._invoke_loop()

    # Assert that the result is an AgentFinish instance
    assert isinstance(result, AgentFinish)

    # Assert that the output is the multiplication result as string (12)
    assert "12" in result.output or result.output == 12

    # Assert that the dummy LLM was called only once (no extra LLM calls after tool usage)
    assert dummy_llm.call_count == 1, "LLM was called more than once despite result_as_answer=True"


def test_result_as_answer_false_calls_llm_twice(monkeypatch):
    """
    Test that when a tool has result_as_answer=False, the agent makes LLM calls before and after tool usage.
    """

    # Create a StructuredTool with result_as_answer=False (default)
    multiply_tool = StructuredTool.from_function(
        name="multiply",
        description="Multiply two integers",
        func=multiply_func,
        return_direct=False,
    )

    # Setup dummy LLM instance
    dummy_llm = DummyLLM()

    # Setup dummy agent
    agent = DummyAgent()

    # Setup a dummy prompt dict (not used by DummyLLM)
    prompt = {"input": "Calculate 3 times 4"}

    # Create CrewAgentExecutor with the tool and dummy LLM
    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=5,
        tools=[multiply_tool],
        tools_names="multiply",
        stop_words=[],
        tools_description="Multiply two numbers",
        llm=dummy_llm,
        verbose=False,
        step_callback=None,
    )

    # Run the agent executor _invoke_loop (internal method that runs the agent loop)
    # It should call LLM twice: once before tool usage and once after
    result = executor._invoke_loop()

    # Assert that the result is an AgentFinish instance
    assert isinstance(result, AgentFinish)

    # Assert that the output is the multiplication result as string (12)
    assert "12" in result.output or result.output == 12

    # Assert that the dummy LLM was called twice (before and after tool usage)
    assert dummy_llm.call_count == 2, "LLM was not called twice despite result_as_answer=False"[0m
