@pytest.mark.parametrize("result_as_answer", [True, False])
def test_tool_result_as_answer_behavior(result_as_answer):
    """
    Test that when a tool has result_as_answer=True, the agent returns the tool output directly
    without calling the LLM again (successful_requests should be 0 or 1).
    When result_as_answer=False, the agent should call the LLM to process the tool output.
    """

    # Create a tool with the given result_as_answer flag
    def tool_func(x: int, y: int) -> int:
        return x * y

    tool = StructuredTool(
        name="multiply",
        description="Multiply two integers",
        args_schema=type(
            "ArgsSchema",
            (object,),
            {"x": int, "y": int},
        ),
        func=tool_func,
        result_as_answer=result_as_answer,
    )

    # Create a dummy agent with this tool
    class TestAgent(BaseAgent):
        def __init__(self):
            super().__init__(name="test_agent", tools=[tool])
            self.llm = DummyLLM()

    agent = TestAgent()

    # Prepare a prompt that instructs the agent to call the multiply tool with x=3, y=4
    # We simulate an AgentAction that calls the tool directly
    action = AgentAction(tool_name="multiply", tool_input={"x": 3, "y": 4}, text="Multiply 3 and 4")

    # Use CrewAgentExecutor to simulate the agent execution
    executor = CrewAgentExecutor(
        agent=agent,
        prompt={"input": "Calculate 3 * 4"},
        max_iter=5,
        tools=[tool],
        tools_names="multiply",
        stop_words=[],
        tools_description="Multiply two integers",
        verbose=False,
        llm=agent.llm,
        task=Task(name="test_task"),
        crew=None,
        training_handler=None,
    )

    # Patch the _invoke_loop method to simulate the agent immediately returning the action
    # We want to test the behavior of _execute_tool_and_check_finality and final answer return
    def patched_invoke_loop(self, formatted_answer=None):
