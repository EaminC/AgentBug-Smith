        prompt=prompt,
        max_iter=max_iter,
        tools=tools,
        tools_names=tools_names,
        stop=stop_words,
        tools_description=tools_description,
        verbose=verbose,
        step_callback=step_callback,
        crew=crew,
        training_handler=training_handler,
        training_data=training_data,
        i18n=i18n,
        printer=printer,
        llm=llm,
    )

    # Run the agent executor _invoke_loop to simulate the agent's main loop
    result = executor._invoke_loop()

