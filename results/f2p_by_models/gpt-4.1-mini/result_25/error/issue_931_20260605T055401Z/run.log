[32mimport pytest
from typing import Any
from pydantic import BaseModel
from crewai.agents.crew_agent_executor import CrewAgentExecutor
from crewai.agents.agent_builder.base_agent import BaseAgent
from crewai.tools.structured_tool import StructuredTool
from crewai.agents.agent import AgentAction, AgentFinish


class MultiplyArgs(BaseModel):
    x: int
    y: int


def multiply_func(x: int, y: int) -> int:
    return x * y


class DummyAgent(BaseAgent):
    def __init__(self):
        super().__init__(name="dummy_agent", description="A dummy agent for testing.")


def test_result_as_answer_short_circuit():
    """
    This test verifies that when a tool has result_as_answer=True,
    the CrewAgentExecutor returns the tool's output directly as the final answer
    without making any LLM calls.

    Buggy behavior: The agent still calls the LLM after the tool execution.
    Fixed behavior: The agent returns immediately after the tool returns result_as_answer=True.
    """

    # Create a structured tool with result_as_answer=True
    multiply_tool = StructuredTool.from_function(
        name="multiply",
        description="Multiply two integers",
        func=multiply_func,
        schema=MultiplyArgs,
        return_direct=True,  # sets result_as_answer=True
    )

    # Create a dummy agent
    agent = DummyAgent()

    # Prepare a prompt that instructs the agent to use the multiply tool
    prompt = {
        "input": "Multiply 3 and 4",
    }

    # Instantiate CrewAgentExecutor with the multiply tool
    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=3,
        tools=[multiply_tool],
        tools_names="multiply",
        stop_words=[],
        tools_description="Multiply tool",
        llm=None,  # We will patch llm to detect calls
        verbose=False,
        step_callback=None,
        training_handler=None,
        crew=None,
        memory=None,
    )

    # Patch the executor's llm to detect if it is called
    class DummyLLM:
        def __init__(self):
            self.called = False

        def __call__(self, *args, **kwargs):
            self.called = True
            # Return a dummy response that would normally come from the LLM
            return {"choices": [{"message": {"content": "LLM response"}}]}

    dummy_llm = DummyLLM()
    executor.llm = dummy_llm

    # We simulate an AgentAction that calls the multiply tool with arguments
    action = AgentAction(tool="multiply", tool_input='{"x": 3, "y": 4}', text="")

    # Run the internal method that executes the tool and checks for finality
    tool_result = executor._execute_tool_and_check_finality(action)

    # The tool_result.result should be 12 (3*4)
    assert tool_result.result == 12

    # The tool_result.result_as_answer should be True because of return_direct=True
    assert tool_result.result_as_answer is True

    # Now simulate the _invoke_loop behavior with this action and result_as_answer
    # It should return AgentFinish immediately without calling the LLM
    finish = executor._invoke_loop(formatted_answer=action)

    # The finish should be an AgentFinish instance
    assert isinstance(finish, AgentFinish)

    # The output of finish should be the tool result 12
    assert finish.output == 12

    # The text should contain the observation with the result
    assert "Observation: 12" in finish.text

    # The dummy_llm should not have been called because result_as_answer short-circuits LLM calls
    assert dummy_llm.called is False

    # This test will fail on buggy code because dummy_llm.called will be True (LLM called)
    # and finish will not be returned early, causing the test to fail.


if __name__ == "__main__":
    pytest.main([__file__])[0m
