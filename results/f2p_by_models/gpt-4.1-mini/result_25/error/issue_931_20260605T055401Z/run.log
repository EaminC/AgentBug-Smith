from crewai.agents.agent_builder.agent_action import AgentAction, AgentFinish


class DummyLLM:
    def __init__(self):
        self.stop = None
        self.call_count = 0

    def __call__(self, prompt, **kwargs):
        self.call_count += 1
        # Return a dummy response that triggers the agent to use the tool once
        if self.call_count == 1:
            # Return an AgentAction to invoke the tool
            return AgentAction(tool="multiply", tool_input={"x": 3, "y": 4}, text="Calculating 3*4")
        else:
            # Return an AgentFinish to end the agent loop
            return AgentFinish(thought="Done", output="Final answer", text="Done")


class MultiplyTool(StructuredTool):
    def __init__(self, result_as_answer: bool):
        # Define a simple args schema with two integers x and y
        from pydantic import BaseModel

        class ArgsSchema(BaseModel):
            x: int
            y: int

        def multiply_func(x: int, y: int) -> int:
            return x * y

        super().__init__(
            name="multiply",
            description="Multiply two numbers",
            args_schema=ArgsSchema,
            func=multiply_func,
            result_as_answer=result_as_answer,
        )


class DummyAgent(BaseAgent):
    def __init__(self):
        super().__init__(name="dummy_agent")


