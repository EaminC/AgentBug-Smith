[32mimport pytest
import types
import sys

import crewai
from crewai.agents.crew_agent_executor import CrewAgentExecutor, AgentAction, AgentFinish
from crewai.tools.structured_tool import StructuredTool
from crewai.tools.base_tool import BaseTool
from crewai.agents.agent import BaseAgent
from crewai.llm import LLM


class DummyLLM(LLM):
    def __init__(self):
        super().__init__()
        self.call_count = 0

    def _call(self, prompt, stop=None):
        self.call_count += 1
        # Return a dummy response that triggers a tool usage action
        if self.call_count == 1:
            # First call returns an action to invoke tool "multiply"
            return {
                "text": "Action: multiply\nAction Input: {\"x\": 2, \"y\": 3}"
            }
        else:
            # Second call returns final answer normally
            return {"text": "Final answer: 6"}


class MultiplyTool(StructuredTool):
    def __init__(self, result_as_answer=False):
        def multiply(x: int, y: int) -> int:
            return x * y

        super().__init__(
            name="multiply",
            description="Multiply two numbers",
            args_schema=types.SimpleNamespace,  # dummy, not used here
            func=multiply,
            result_as_answer=result_as_answer,
        )


class DummyAgent(BaseAgent):
    def __init__(self, tools):
        super().__init__(
            name="dummy_agent",
            description="A dummy agent for testing",
            tools=tools,
            llm=DummyLLM(),
        )


def test_result_as_answer_prevents_llm_calls():
    """
    Test that when a tool has result_as_answer=True, the agent returns the tool output
    directly without making additional LLM calls.
    """

    # Tool with result_as_answer=True should cause immediate return of tool output
    tool = MultiplyTool(result_as_answer=True)
    agent = DummyAgent(tools=[tool])

    # Prepare prompt dict (keys arbitrary, values arbitrary)
    prompt = {"input": "Multiply 2 and 3"}

    # Create CrewAgentExecutor with the dummy agent and tool
    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=5,
        tools=[tool],
        tools_names="multiply",
        stop_words=[],
        tools_description=tool.description,
        llm=agent.llm,
        verbose=False,
        step_callback=None,
    )

    # Run the agent executor _invoke_loop to simulate execution
    result = executor._invoke_loop()

    # The result should be an AgentFinish instance with output equal to 6 (2*3)
    assert isinstance(result, AgentFinish)
    assert result.output == 6 or result.output == "6"

    # The DummyLLM call count should be exactly 1, meaning no extra LLM call after tool
    assert agent.llm.call_count == 1


def test_result_as_answer_false_allows_llm_calls():
    """
    Test that when a tool has result_as_answer=False, the agent continues to call the LLM
    after tool usage.
    """

    # Tool with result_as_answer=False should cause agent to continue LLM calls
    tool = MultiplyTool(result_as_answer=False)
    agent = DummyAgent(tools=[tool])

    prompt = {"input": "Multiply 2 and 3"}

    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=5,
        tools=[tool],
        tools_names="multiply",
        stop_words=[],
        tools_description=tool.description,
        llm=agent.llm,
        verbose=False,
        step_callback=None,
    )

    result = executor._invoke_loop()

    # The result should be an AgentFinish instance with output containing "Final answer"
    assert isinstance(result, AgentFinish)
    assert "Final answer" in str(result.output)

    # The DummyLLM call count should be more than 1, meaning LLM was called again after tool
    assert agent.llm.call_count > 1[0m
