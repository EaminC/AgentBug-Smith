from crewai.agents.crew_agent_executor import CrewAgentExecutor, AgentAction, AgentFinish
from crewai.tools.structured_tool import StructuredTool
from crewai.tools.base_tool import BaseTool
from crewai.agents.agent import BaseAgent
from crewai.llm import LLM
from crewai.task import Task


class DummyLLM(LLM):
    def __init__(self):
        super().__init__()
        self.call_count = 0

    def _call(self, prompt, stop=None):
        self.call_count += 1
        # Return a dummy response that simulates the agent finishing immediately
        # We simulate that the agent does not call the LLM if result_as_answer=True
        return {
            "choices": [
                {
                    "message": {
                        "content": "Final answer from tool",
                        "role": "assistant",
                    }
                }
            ],
            "usage": {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0},
        }


class DummyAgent(BaseAgent):
    def __init__(self, tools):
        super().__init__(
            name="dummy_agent",
            description="A dummy agent for testing",
            tools=tools,
            llm=DummyLLM(),
        )


class MultiplyTool(StructuredTool):
    def __init__(self, result_as_answer=False):
        super().__init__(
            name="multiply",
            description="Multiply two numbers",
            args_schema=types.SimpleNamespace,  # bypass schema validation for test
            func=self.multiply,
            result_as_answer=result_as_answer,
        )

    def multiply(self, a: int, b: int) -> int:
        return a * b


def test_tool_result_as_answer_short_circuits_llm_call():
    """
    Test that when a tool has result_as_answer=True, the agent returns the tool output
    directly without making additional LLM calls.
    """

    # Create a multiply tool with result_as_answer=True
    tool = MultiplyTool(result_as_answer=True)

    # Create a dummy agent with this tool
    agent = DummyAgent(tools=[tool])

    # Prepare an AgentAction that calls the multiply tool
    action = AgentAction(tool="multiply", tool_input={"a": 3, "b": 5})

    # Create a CrewAgentExecutor with the dummy agent and tool
    executor = CrewAgentExecutor(
        agent=agent,
        prompt={"input": "Multiply 3 and 5"},
        max_iter=5,
        tools=[tool],
        tools_names="multiply",
        stop_words=[],
        tools_description="Multiply two numbers",
        llm=agent.llm,
        verbose=False,
        step_callback=None,
    )

    # Patch _invoke_loop to simulate the agent immediately using the tool action
    # We simulate that the agent returns the AgentAction directly
    # We want to test that _invoke_loop returns AgentFinish immediately when result_as_answer=True

    # We call the internal method _execute_tool_and_check_finality directly to verify behavior
    tool_result = executor._execute_tool_and_check_finality(action)

    # The tool result should have result_as_answer True
    assert tool_result.result_as_answer is True

    # Now simulate the _invoke_loop behavior with the AgentAction
    # The buggy version would continue calling the LLM, the fixed version returns immediately
    # We expect an AgentFinish returned immediately with the tool result output

    # We simulate the _invoke_loop logic for this test:
    if tool_result.result_as_answer:
        finish = AgentFinish(
            thought="",
            output=tool_result.result,
            text=f"Observation: {tool_result.result}",
        )
    else:
        finish = None

    assert finish is not None
    assert finish.output == 15  # 3*5=15

    # Also check that the dummy LLM call count is zero, meaning no LLM calls were made after tool
    # Because the tool result short-circuits the LLM call
    # We simulate this by calling _invoke_loop and verifying no additional LLM calls

    # To test this end-to-end, call _invoke_loop with a formatted_answer that is AgentAction
    # We monkeypatch _format_answer to return the AgentAction directly

    def fake_format_answer(answer):
        return action

    executor._format_answer = fake_format_answer

    # Reset LLM call count
    executor.llm.call_count = 0

    # Run _invoke_loop, which should return AgentFinish immediately
    result = executor._invoke_loop()

    assert isinstance(result, AgentFinish)
    assert result.output == 15
    # The LLM call count should be zero because no LLM call after tool
    assert executor.llm.call_count == 0


def test_tool_result_as_answer_false_calls_llm():
    """
    Test that when a tool has result_as_answer=False, the agent continues to call the LLM.
    """

    # Create a multiply tool with result_as_answer=False (default)
    tool = MultiplyTool(result_as_answer=False)

    # Create a dummy agent with this tool
    agent = DummyAgent(tools=[tool])

    # Prepare an AgentAction that calls the multiply tool
    action = AgentAction(tool="multiply", tool_input={"a": 4, "b": 6})

    # Create a CrewAgentExecutor with the dummy agent and tool
    executor = CrewAgentExecutor(
        agent=agent,
        prompt={"input": "Multiply 4 and 6"},
        max_iter=5,
        tools=[tool],
        tools_names="multiply",
        stop_words=[],
        tools_description="Multiply two numbers",
        llm=agent.llm,
        verbose=False,
        step_callback=None,
    )

    # Patch _format_answer to return the AgentAction
    executor._format_answer = lambda answer=None: action

    # Reset LLM call count
    executor.llm.call_count = 0

    # Run _invoke_loop, which should call the tool, then call the LLM again
    # Because result_as_answer=False means no short circuit

    # We expect _invoke_loop to not return AgentFinish immediately, but continue
    # The dummy LLM _call increments call_count each time

    # We run _invoke_loop and catch the returned value
    result = executor._invoke_loop()

    # Because dummy LLM returns a final answer, _invoke_loop should return AgentFinish eventually
    assert isinstance(result, AgentFinish)

    # The output should not be the direct tool result but the LLM's dummy response content
    assert result.output == "Final answer from tool"

    # The LLM call count should be at least 1 (called after tool)
    assert executor.llm.call_count > 0

    # The tool result_as_answer should be False
    tool_result = executor._execute_tool_and_check_finality(action)
    assert tool_result.result_as_answer is False

