from pydantic import BaseModel


class MultiplyArgs(BaseModel):
    x: int
    y: int


def multiply_func(x: int, y: int) -> int:
    return x * y


class DummyLLM(LLM):
    def __init__(self):
        super().__init__(model="dummy-model")
        self.call_count = 0

    def _call(self, prompt, stop=None):
        self.call_count += 1
        # Return a dummy response that simulates the agent finishing immediately
        # with the tool result embedded in the output.
        # The buggy code will still call LLM internally even if result_as_answer=True
        return {
            "choices": [
