        max_tool_call_rpm_per_crew_tool_agent_tool_call_tool=max_tool_call_rpm_per_crew_tool_agent_tool_call_tool,
    )

    # Override the executor's llm attribute with our dummy llm callable
    executor.llm = dummy_llm

    # Run the private _invoke_loop method which drives the agent execution
    # It should short-circuit and return the tool result directly without a second llm call
    result = executor._invoke_loop()

    # The result should be an AgentFinish with output equal to the multiply tool result (6)
    assert isinstance(result, AgentFinish)
    assert result.output == 6
    # The dummy LLM should have been called only once (the initial call returning AgentAction)
    assert dummy_llm.call_count == 1

    # The text should include the observation with the tool result
    assert "Observation: 6" in result.text

    # This test will fail on buggy code where the agent calls the LLM again after tool call
    # causing dummy_llm.call_count to be > 1 and result.output != 6


