    # and check if it returns AgentFinish immediately

    # We call _invoke_loop with the AgentAction having the tool_result and result_as_answer=True
    action.result = tool_result.result
    action.text = f"Using multiply tool\nObservation: {tool_result.result}"

    result = executor._invoke_loop(formatted_answer=action)

    # The result should be an instance of AgentFinish with output == tool_result.result
    assert isinstance(result, AgentFinish)
    assert result.output == 42

