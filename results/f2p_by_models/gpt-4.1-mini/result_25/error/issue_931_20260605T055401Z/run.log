        cache_max_stale_seconds_per_attosecond=None,
        cache_max_stale_seconds_per_zeptosecond=None,
        cache_max_stale_seconds_per_yoctosecond=None,
    )

    result = executor._invoke_loop()

    # The result should be an AgentFinish instance with output "Final output"
