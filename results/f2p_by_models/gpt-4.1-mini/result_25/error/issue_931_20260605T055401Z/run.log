[32mimport pytest
from pydantic import BaseModel
from typing import Any

from crewai.agents.crew_agent_executor import CrewAgentExecutor, AgentAction, AgentFinish
from crewai.tools.structured_tool import StructuredTool
from crewai.llm import LLM
from crewai.agents.agent_builder.base_agent import BaseAgent


class MultiplyArgs(BaseModel):
    x: int
    y: int


class MultiplyTool(StructuredTool):
    def __init__(self, result_as_answer: bool = False):
        super().__init__(
            name="multiply",
            description="Multiply two integers",
            args_schema=MultiplyArgs,
            func=self.multiply,
            result_as_answer=result_as_answer,
        )

    def multiply(self, x: int, y: int) -> int:
        return x * y


class DummyLLM(LLM):
    def __init__(self):
        super().__init__()
        self.call_count = 0

    def _call(self, prompt: str) -> str:
        self.call_count += 1
        # Return a dummy response that triggers the multiply tool action
        # The agent should parse this and call the tool multiply with x=3, y=4
        # We simulate the agent action output format
        return (
            '{"action": "multiply", "action_input": {"x": 3, "y": 4}}'
        )


class DummyAgent(BaseAgent):
    def __init__(self, tools: list[StructuredTool]):
        super().__init__(
            name="dummy_agent",
            description="Agent for testing result_as_answer",
            tools=tools,
            llm=DummyLLM(),
        )


def test_result_as_answer_behavior():
    """
    Test that when a tool has result_as_answer=True, the agent returns the tool output
    directly without making an LLM call after the tool invocation.

    Steps:
    - Create a multiply tool with result_as_answer=True
    - Create an agent with this tool and a dummy LLM that counts calls
    - Create a CrewAgentExecutor with the agent and the tool
    - Run the agent executor _invoke_loop to simulate an agent run
    - Assert that the final output is the multiplication result (3*4=12)
    - Assert that the dummy LLM call count is 1 (only initial call, no extra calls after tool)
    """

    multiply_tool = MultiplyTool(result_as_answer=True)
    agent = DummyAgent(tools=[multiply_tool])

    # Prepare minimal prompt and parameters for CrewAgentExecutor
    prompt = {"input": "Multiply 3 and 4"}
    tools = [multiply_tool]
    tools_names = "multiply"
    stop_words = []
    tools_description = "Multiply two integers"
    max_iter = 5

    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=max_iter,
        tools=tools,
        tools_names=tools_names,
        stop=stop_words,
        tools_description=tools_description,
        verbose=False,
    )

    # Run the agent executor loop
    result = executor._invoke_loop()

    # The result should be an AgentFinish with output equal to 12 (3*4)
    assert isinstance(result, AgentFinish)
    assert result.output == 12 or result.output == "12"

    # The dummy LLM should have been called only once (initial prompt)
    # No extra LLM calls after tool execution if result_as_answer=True
    assert agent.llm.call_count == 1

    # The text should contain the observation with the multiplication result
    assert "Observation: 12" in result.text or "Observation: 12" in result.text


def test_result_as_answer_false_behavior():
    """
    Test that when a tool has result_as_answer=False, the agent continues to interact
    with the LLM after tool invocation.

    Steps:
    - Create a multiply tool with result_as_answer=False
    - Create an agent with this tool and a dummy LLM that counts calls
    - Create a CrewAgentExecutor with the agent and the tool
    - Run the agent executor _invoke_loop to simulate an agent run
    - Assert that the final output is not directly the tool output (because it continues)
    - Assert that the dummy LLM call count is more than 1 (LLM called again after tool)
    """

    multiply_tool = MultiplyTool(result_as_answer=False)
    agent = DummyAgent(tools=[multiply_tool])

    prompt = {"input": "Multiply 3 and 4"}
    tools = [multiply_tool]
    tools_names = "multiply"
    stop_words = []
    tools_description = "Multiply two integers"
    max_iter = 5

    executor = CrewAgentExecutor(
        agent=agent,
        prompt=prompt,
        max_iter=max_iter,
        tools=tools,
        tools_names=tools_names,
        stop=stop_words,
        tools_description=tools_description,
        verbose=False,
    )

    result = executor._invoke_loop()

    # The result should NOT be AgentFinish with output equal to 12 directly
    # Because result_as_answer=False means agent continues to call LLM
    # So result is likely an AgentFinish but output != 12 or a different type
    if isinstance(result, AgentFinish):
        assert result.output != 12 and result.output != "12"
    else:
        # If not AgentFinish, then agent continued
        assert True

    # The dummy LLM should have been called more than once (initial + after tool)
    assert agent.llm.call_count > 1[0m
