[32mimport contextvars
import threading
import time
import pytest

from crewai.task import Task, TaskOutput


def test_async_execution_preserves_contextvar():
    """
    This test verifies that when a ContextVar is set in the main thread,
    it is preserved inside the worker thread spawned by Task.execute_async()
    when async_execution=True.

    Before the fix:
      - The ContextVar value inside the worker thread is the default (None).
      - The test should fail because the expected value is not preserved.

    After the fix:
      - The ContextVar value inside the worker thread matches the main thread's value.
      - The test passes.
    """

    # Define a ContextVar with default None
    my_var = contextvars.ContextVar("my_var", default=None)

    # Set the ContextVar in the main thread
    expected_value = "hello_context"
    my_var.set(expected_value)

    # Define a minimal dummy agent and tools for the Task call
    class DummyAgent:
        def run(self):
            # Inside the agent's run method, check the ContextVar value
            # This simulates the code running inside the worker thread
            return my_var.get()

    dummy_agent = DummyAgent()

    # Create a dummy context and tools (can be None or empty dicts)
    dummy_context = {}
    dummy_tools = {}

    # Create a Task instance with async_execution=True
    # We use a minimal Task instance; if Task requires parameters, pass minimal valid ones
    # The bug is in Task.execute_async, so we must call that method
    task = Task(async_execution=True)

    # We will store the result from the worker thread here
    results = {}

    # Patch the _execute_task_async method to capture the ContextVar value inside the thread
    # We do NOT mock execute_async itself, only _execute_task_async to capture the value
    original_execute_task_async = task._execute_task_async

    def capture_contextvar(agent, context, tools, future):
        # Capture the ContextVar value inside the worker thread
        results["contextvar_value"] = my_var.get()
        # Call the original method to keep normal behavior
        return original_execute_task_async(agent, context, tools, future)

    task._execute_task_async = capture_contextvar

    # Call execute_async to run the task asynchronously
    future = task.execute_async(dummy_agent, dummy_context, dummy_tools)

    # Wait for the future to complete with timeout
    # If the future does not complete, the test should fail
    try:
        output = future.result(timeout=5)
    except Exception as e:
        pytest.fail(f"Task execution failed or timed out: {e}")

    # Assert that the ContextVar value inside the worker thread matches the main thread's value
    # Before fix: results["contextvar_value"] would be None (default)
    # After fix: results["contextvar_value"] should be "hello_context"
    assert "contextvar_value" in results, "ContextVar value was not captured in worker thread"
    assert results["contextvar_value"] == expected_value, (
        f"ContextVar value inside worker thread is '{results['contextvar_value']}', "
        f"expected '{expected_value}'"
    )[0m
