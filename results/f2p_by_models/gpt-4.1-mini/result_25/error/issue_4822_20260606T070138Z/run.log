[32mimport contextvars
import threading
import time
import pytest
from crewai.task import Task  # Assuming Task is the class with execute_async method


def test_contextvar_propagation_in_async_execution():
    """
    This test verifies that ContextVar values set on the calling thread are accessible
    inside the worker thread spawned by Task.execute_async with async_execution=True.

    Before the fix, the ContextVar value would be lost (reset to default) inside the worker thread,
    causing the test to fail. After the fix, the ContextVar value should be preserved.
    """

    # Define a ContextVar with a default value
    test_var = contextvars.ContextVar("test_var", default="default")

    # Set the ContextVar to a known value in the main thread
    test_var.set("expected_value")

    # Define a minimal dummy agent and context and tools for the Task call
    class DummyAgent:
        pass

    dummy_agent = DummyAgent()
    dummy_context = {}
    dummy_tools = {}

    # Create a subclass of Task to override _execute_task_async to capture the ContextVar inside the thread
    class TestTask(Task):
        def _execute_task_async(self, agent, context, tools, future):
            # Inside the worker thread, get the ContextVar value
            try:
                value = test_var.get()
                future.set_result(value)
            except Exception as e:
                future.set_exception(e)

    task = TestTask()

    # Call execute_async with async_execution=True (the bug is in this path)
    future = task.execute_async(dummy_agent, dummy_context, dummy_tools)

    # Wait for the future to complete with a timeout
    result = future.result(timeout=5)

    # Assert that the ContextVar value inside the worker thread matches the value set in the main thread
    assert result == "expected_value", (
        "ContextVar value was lost inside the worker thread spawned by execute_async. "
        "This indicates the bug is present."
    )[0m
