[32mimport contextvars
import threading
import time
import pytest

from crewai.task import Task  # Assuming Task is the class with execute_async method


def test_async_execution_preserves_contextvar_state():
    """
    This test verifies that when a ContextVar is set in the main thread,
    it is preserved inside the worker thread spawned by Task.execute_async
    when async_execution=True.

    Before the fix, the ContextVar would reset to its default value inside
    the worker thread, causing the test to fail.

    After the fix, the ContextVar value is preserved, and the test passes.
    """

    # Define a ContextVar with a default value
    test_var = contextvars.ContextVar("test_var", default="default")

    # Set the ContextVar in the main thread
    test_var.set("expected_value")

    # Prepare a minimal Task instance and parameters
    # We assume Task has a constructor that can be called without arguments
    # or with minimal dummy arguments; adjust if necessary.
    task = Task()

    # We need to patch or provide a dummy agent, context, and tools
    # For this test, we can pass None or minimal dummy objects
    agent = None
    context = None
    tools = None

    # We will capture the ContextVar value inside the worker thread
    # by patching the _execute_task_async method to record the value

    # Store the ContextVar value seen inside the worker thread
    result_container = {}

    original_execute = task._execute_task_async

    def patched_execute(agent_arg, context_arg, tools_arg, future):
        # Capture the ContextVar value inside the worker thread
        result_container["value"] = test_var.get()
        # Call the original method to keep behavior consistent
        return original_execute(agent_arg, context_arg, tools_arg, future)

    task._execute_task_async = patched_execute

    # Call execute_async with async_execution=True (implied by test context)
    future = task.execute_async(agent, context, tools)

    # Wait for the thread to complete
    # The Future should be done when the thread finishes
    # Wait up to 5 seconds for safety
    timeout = 5
    waited = 0
    while not future.done() and waited < timeout:
        time.sleep(0.1)
        waited += 0.1

    # Assert the future completed successfully
    assert future.done(), "The async task did not complete in time"

    # Assert the ContextVar value inside the worker thread matches the main thread
    # Before the fix, this would be "default"
    # After the fix, this should be "expected_value"
    assert "value" in result_container, "ContextVar value was not captured in worker thread"
    assert result_container["value"] == "expected_value", (
        f"ContextVar value inside worker thread is '{result_container['value']}', "
        "expected 'expected_value'"
    )[0m
