[32mimport contextvars
import threading
import time
import pytest

from crewai.task import Task, TaskOutput


def test_async_execution_preserves_contextvar():
    """
    This test verifies that when a Task is executed with async_execution=True,
    the ContextVar set in the calling thread is preserved inside the worker thread.

    Expected behavior:
    - Before the fix: ContextVar value is lost inside the thread, causing test failure.
    - After the fix: ContextVar value is preserved, test passes.
    """

    # Define a ContextVar with a default value
    test_var = contextvars.ContextVar("test_var", default=None)
    test_value = "context_value"

    # Set the ContextVar in the main thread
    test_var.set(test_value)

    # Create a dummy Task subclass to override _execute_task_async to capture the ContextVar value
    class DummyTask(Task):
        def _execute_task_async(self, agent, context, tools, future):
            # Inside the worker thread, get the ContextVar value
            val = test_var.get()
            # Set the result on the future
            future.set_result(val)

    # Instantiate the dummy task
    task = DummyTask()

    # Execute the task asynchronously with async_execution=True
    future = task.execute_async(agent=None, context=None, tools=None)

    # Wait for the future to complete with timeout
    result = future.result(timeout=5)

    # Assert that the ContextVar value inside the thread matches the value set in main thread
    assert result == test_value, (
        "ContextVar value was lost inside the async_execution thread. "
        "This indicates the bug is present."
    )[0m
