[32mimport contextvars
import threading
import time
import pytest

from crewai.task import Task


def test_async_execution_preserves_contextvar():
    # Setup a ContextVar and set a value in the main thread
    test_var = contextvars.ContextVar("test_var", default=None)
    test_value = "context_value"
    test_var.set(test_value)

    # Prepare a dummy Task instance and parameters
    # We need to create a minimal Task object that has execute_async and _execute_task_async
    # The _execute_task_async method should read test_var inside the thread and store it somewhere accessible
    class DummyTask(Task):
        def __init__(self):
            # Store the contextvar value read inside the thread
            self.thread_context_value = None

        def _execute_task_async(self, agent, context, tools, future):
            # Read the contextvar inside the worker thread
            self.thread_context_value = test_var.get()
            # Mark the future as done to avoid hanging
            future.set_result("done")

    dummy_task = DummyTask()

    # Call execute_async with async_execution=True (simulate the bug/fix scenario)
    # The signature is execute_async(self, agent, context, tools) -> Future[TaskOutput]
    # We can pass None for agent, context, tools as they are unused here
    future = dummy_task.execute_async(agent=None, context=None, tools=None)

    # Wait for the thread to complete
    # The future should be done quickly, but wait with timeout to avoid hangs
    timeout = 5
    start = time.time()
    while not future.done():
        if time.time() - start > timeout:
            pytest.fail("Async task did not complete in time")
        time.sleep(0.01)

    # Assert that the contextvar value inside the thread matches the main thread's value
    # On buggy code, dummy_task.thread_context_value will be None (default)
    # On fixed code, it will be "context_value"
    assert dummy_task.thread_context_value == test_value, (
        "ContextVar value was not preserved inside async_execution thread. "
        "Expected '{}', got '{}'.".format(test_value, dummy_task.thread_context_value)
    )[0m
