[32mimport contextvars
import threading
import time
import pytest

from crewai.task import Task  # Assuming Task is the class with execute_async method


@pytest.mark.timeout(10)
def test_async_execution_preserves_contextvar():
    """
    Test that async_execution=True path preserves ContextVar values inside the worker thread.

    This test creates a ContextVar, sets a value in the main thread, then calls execute_async
    with async_execution=True. The worker thread should see the same ContextVar value.

    Before the fix, the ContextVar value is lost (defaults to None).
    After the fix, the ContextVar value is preserved.
    """

    # Create a ContextVar and set a value in the main thread
    test_var = contextvars.ContextVar("test_var", default=None)
    test_var.set("expected_value")

    # Prepare a minimal Task instance with async_execution=True
    # We assume Task constructor and _execute_task_async exist.
    # We will monkeypatch _execute_task_async to check ContextVar inside the thread.

    class DummyAgent:
        pass

    class DummyContext:
        pass

    class DummyTools:
        pass

    # We will subclass Task to override _execute_task_async to check ContextVar inside thread
    class TestTask(Task):
        def _execute_task_async(self, agent, context, tools, future):
            # Inside worker thread, get the ContextVar value
            try:
                val = test_var.get()
            except LookupError:
                val = None
            # Set result to future
            future.set_result(val)

    task = TestTask(async_execution=True)

    # Call execute_async which spawns a thread and returns a Future
    future = task.execute_async(DummyAgent(), DummyContext(), DummyTools())

    # Wait for the future to complete (with timeout)
    result = future.result(timeout=5)

    # Assert that the ContextVar value inside the worker thread is the same as set in main thread
    assert result == "expected_value", (
        "ContextVar value was lost inside worker thread. "
        "This indicates async_execution=True does not preserve contextvars.Context."
    )[0m
