    agent = None
    context = None
    tools = None

    # Instantiate the dummy task
    task = DummyTask()

    # Call execute_async which spawns a thread and returns a Future
    future = task.execute_async(agent, context, tools)

    # Wait for the future to complete with a timeout to avoid hanging tests
    timeout = 5
    start_time = time.time()
    while not future.done():
        if time.time() - start_time > timeout:
            pytest.fail("execute_async future did not complete in time")
        time.sleep(0.01)

    # Get the result from the future
    result = future.result()

    # Assert that the ContextVar value inside the thread matches the value set before calling execute_async
    assert result == expected_value, (
