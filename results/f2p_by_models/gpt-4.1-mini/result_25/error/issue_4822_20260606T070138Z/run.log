def test_async_execution_preserves_contextvar_state():
    """
    This test verifies that when execute_async is called with async_execution=True,
    the ContextVar state set in the calling thread is preserved inside the worker thread.

    Before the fix, the ContextVar value would be lost (reset to default) in the worker thread,
    causing the test to fail. After the fix, the ContextVar value is preserved, and the test passes.
    """

    # Create a ContextVar with a default value
    my_var = contextvars.ContextVar("my_var", default=None)

    # Set the ContextVar to a known value in the main thread
    expected_value = "hello_context"
    my_var.set(expected_value)

    # We will use the execute_async method of a Task instance.
    # Since the Task class is not directly imported, we import it from crewai.task.
    # We create a minimal Task instance with async_execution=True.

    # Prepare dummy context and tools (can be None or empty)
    dummy_context = {}
    dummy_tools = {}

    # Create a dummy Task instance with async_execution=True
    # We must find a way to create a Task instance.
    # The Task class is likely in crewai.task.Task, so import it.
    from lib.crewai.task import Task

    # Create a Task instance with async_execution=True
    # The constructor signature is unknown, so we use minimal args.
