    # We cannot mock _execute_task_async itself, but we can subclass Task to override it.

    class TestTask(Task):
        def _execute_task_async(self, agent, context, tools, future):
            # Inside this method, check the ContextVar value
            try:
                val = my_var.get()
            except LookupError:
                val = None
            # Set the result in the future
            future.set_result(val)

    test_task = TestTask(async_execution=True)

    # Call execute_async with dummy agent, context, tools
    future = test_task.execute_async(DummyAgent(), dummy_context, dummy_tools)

    # Wait for the future to complete with timeout
    timeout = 5.0
