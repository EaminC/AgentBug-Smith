[32mimport contextvars
import threading
import time
import pytest

import crewai.task as task_module


def test_execute_async_preserves_contextvar():
    """
    This test verifies that the ContextVar set in the main thread is preserved
    inside the worker thread spawned by execute_async() when async_execution=True.

    Before the fix:
        The ContextVar value is lost inside the worker thread, so the task sees the default value.
        This causes the test to fail.

    After the fix:
        The ContextVar value is correctly propagated to the worker thread via contextvars.copy_context().
        The test passes.
    """

    # Define a ContextVar with a default value
    test_var = contextvars.ContextVar("test_var", default="default")

    # Set the ContextVar to a known value in the main thread
    test_var.set("expected_value")

    # We need a dummy agent and tools to call execute_async.
    # Since this is a fail2pass test, we keep it minimal and focus on context propagation.

    class DummyAgent:
        pass

    class DummyTools:
        pass

    # We will patch the _execute_task_async method of a Task instance to check the ContextVar inside the thread.
    # The patched method will set a result on the Future indicating the value of the ContextVar inside the thread.

    class DummyTask(task_module.Task):
        def _execute_task_async(self, agent, context, tools, future):
            # Inside the worker thread, get the ContextVar value
            val = test_var.get()
            # Set the result on the future so the test can assert it
            future.set_result(val)

    # Instantiate the dummy task
    dummy_task = DummyTask()

    # Call execute_async with async_execution=True (simulate the bug scenario)
    # The method signature is: execute_async(self, agent, context, tools) -> Future[TaskOutput]
    # We pass dummy agent, context, and tools.

    future = dummy_task.execute_async(DummyAgent(), context=None, tools=DummyTools())

    # Wait for the future to complete with a timeout to avoid hanging tests
    result = future.result(timeout=5)

    # Assert that the ContextVar value inside the worker thread is the same as set in main thread
    # Before fix: result would be "default" (the default value)
    # After fix: result should be "expected_value"
    assert result == "expected_value", (
        "ContextVar value was lost inside the worker thread spawned by execute_async(). "
        "This indicates the bug is present."
    )[0m
