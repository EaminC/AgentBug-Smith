from crewai.task import Task


def test_async_execution_preserves_contextvar_state():
    # Create a ContextVar and set a value in the main thread
    test_var = contextvars.ContextVar("test_var", default=None)
    test_var.set("expected_value")

    # Prepare a dummy agent, context, and tools for the Task execution
    # We only need to test the context propagation, so these can be minimal or None
    agent = None
    context = None
    tools = None

    # Create a Task instance with async_execution=True
    task = Task(async_execution=True)

    # We will capture the value of test_var inside the worker thread
    result_container = {}

    # Patch the _execute_task_async method to capture the ContextVar value
    original_execute_task_async = task._execute_task_async

    def patched_execute_task_async(agent_arg, context_arg, tools_arg, future):
        # Capture the ContextVar value inside the worker thread
        result_container["value"] = test_var.get()
        # Call the original method to keep normal flow (optional)
        return original_execute_task_async(agent_arg, context_arg, tools_arg, future)

    task._execute_task_async = patched_execute_task_async

    # Call execute_async to run the task in a thread
    future = task.execute_async(agent, context, tools)

    # Wait for the thread to complete (future to be done)
    # The original code uses concurrent.futures.Future, so we can wait on it
    # But to avoid hanging, we use a timeout
    timeout_seconds = 5
    start_time = time.time()
    while not future.done():
        if time.time() - start_time > timeout_seconds:
            pytest.fail("Task execution timed out")
        time.sleep(0.05)

    # Assert that the ContextVar value inside the worker thread matches the main thread's value
    # This should fail on the buggy codebase (value will be None)
    # and pass after the fix (value will be "expected_value")
    assert result_container.get("value") == "expected_value"[0m
