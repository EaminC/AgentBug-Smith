    while not future.done():
        if time.time() - start > timeout:
            pytest.fail("execute_async future did not complete in time")
        time.sleep(0.01)

    # Get the result from the future
    result = future.result()

    # Assert that the ContextVar value inside the thread is the same as set in main thread
    assert result == expected_value, (
        "ContextVar value was lost in async_execution thread; "
        "expected {!r}, got {!r}".format(expected_value, result)
