[32mimport contextvars
import threading
import time
import pytest

import crewai.task as task_module


class DummyAgent:
    """Minimal dummy agent to pass to execute_async."""
    pass


class DummyContext:
    """Minimal dummy context to pass to execute_async."""
    pass


class DummyTools:
    """Minimal dummy tools to pass to execute_async."""
    pass


def test_async_execution_preserves_contextvar_state():
    """
    Test that async_execution=True preserves ContextVar state inside the worker thread.

    This test exercises the execute_async method of a Task instance (or equivalent)
    that uses threading.Thread to run a target function asynchronously.

    The bug is that the ContextVar state is lost inside the thread because
    threading.Thread does not copy the context by default.

    The fix is to use contextvars.copy_context() and run the target inside that context.

    We simulate this by:
    - Setting a ContextVar in the main thread
    - Running execute_async which spawns a thread to run a function that reads the ContextVar
    - The function sets the result in a Future
    - We assert that the ContextVar value inside the thread matches the main thread's value

    On the buggy codebase, the ContextVar inside the thread will be the default (None).
    After the fix, it will be the value set in the main thread.
    """

    # ContextVar to test propagation
    test_var = contextvars.ContextVar("test_var", default=None)
    expected_value = "context-propagated"
    test_var.set(expected_value)

    # We need to create an instance of the Task class or equivalent that has execute_async.
    # The issue patch shows execute_async is a method, presumably on a Task class.
    # We try to import Task from crewai.task or create a minimal dummy class with execute_async.
    # Since the patch is in crewai.task, we assume Task is available there.

    # Find Task class in crewai.task
    Task = getattr(task_module, "Task", None)
    if Task is None:
        pytest.skip("Task class not found in crewai.task module")

    # Create a subclass of Task to override _execute_task_async to read the ContextVar and set the Future result
    class TestTask(Task):
        def _execute_task_async(self, agent, context, tools, future):
            # Read the ContextVar inside the thread
            value_inside_thread = test_var.get()
            # Set the Future result to the value read
            future.set_result(value_inside_thread)

    # Instantiate TestTask
    test_task = TestTask()

    # Dummy parameters for execute_async
    dummy_agent = DummyAgent()
    dummy_context = DummyContext()
    dummy_tools = DummyTools()

    # Call execute_async which spawns the thread and returns a Future
    future = test_task.execute_async(dummy_agent, dummy_context, dummy_tools)

    # Wait for the Future to complete with a timeout
    timeout_seconds = 5
    start_time = time.time()
    while not future.done():
        if time.time() - start_time > timeout_seconds:
            pytest.fail("execute_async future did not complete in time")
        time.sleep(0.01)

    # Get the result from the Future
    result = future.result()

    # Assert that the ContextVar value inside the thread matches the expected value
    # On buggy code, result will be None (default)
    # On fixed code, result will be "context-propagated"
    assert result == expected_value, (
        f"ContextVar value inside async thread was {result!r}, expected {expected_value!r}. "
        "This indicates contextvars.Context was not propagated correctly in execute_async."
    )[0m
