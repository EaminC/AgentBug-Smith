[32mimport contextvars
import threading
import time
import pytest

from crewai.task import Task


def test_async_execution_preserves_contextvar():
    """
    This test verifies that when a ContextVar is set in the main thread,
    it remains accessible with the same value inside the worker thread
    spawned by Task.execute_async with async_execution=True.

    Before the fix, the ContextVar value is lost (returns default None).
    After the fix, the ContextVar value is preserved.
    """

    # Define a ContextVar with default None
    test_var = contextvars.ContextVar("test_var", default=None)
    expected_value = "context_value"

    # Set the ContextVar in the main thread
    test_var.set(expected_value)

    # Create a dummy Task instance with minimal required attributes/methods
    # We only need to call execute_async and observe ContextVar inside _execute_task_async
    # So we patch _execute_task_async to check ContextVar value inside the thread

    class DummyTask(Task):
        def _execute_task_async(self, agent, context, tools, future):
            # Inside the worker thread, get the ContextVar value
            value_inside_thread = test_var.get()
            # Set result on future for test to check
            future.set_result(value_inside_thread)

    dummy_task = DummyTask()

    # Prepare dummy arguments for execute_async
    dummy_agent = None
    dummy_context = None
    dummy_tools = None

    # Call execute_async with async_execution=True to spawn thread
    # We expect the returned future to eventually contain the ContextVar value
    future = dummy_task.execute_async(dummy_agent, dummy_context, dummy_tools)

    # Wait for the thread to complete and get result
    # Timeout after 5 seconds to avoid hanging tests
    timeout = 5
    poll_interval = 0.05
    waited = 0
    while not future.done() and waited < timeout:
        time.sleep(poll_interval)
        waited += poll_interval

    assert future.done(), "Async task did not complete in time"

    result = future.result()

    # Assert that the ContextVar value inside the thread matches the value set in main thread
    # Before fix: result == None (default)
    # After fix: result == expected_value
    assert result == expected_value, (
        "ContextVar value was lost inside async_execution thread; "
        "expected to preserve contextvars.Context but did not."
    )[0m
