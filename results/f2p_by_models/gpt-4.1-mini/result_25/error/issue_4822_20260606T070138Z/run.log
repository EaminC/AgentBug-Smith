[32mimport contextvars
import threading
import time
import pytest
from lib.crewai.task import Task

# We will create a dummy Task subclass to test execute_async with async_execution=True
# The dummy task will read a ContextVar inside _execute_task_async and set the result on the Future.

my_var = contextvars.ContextVar("my_var", default=None)


class DummyTask(Task):
    def __init__(self, async_execution=True):
        super().__init__()
        self.async_execution = async_execution

    def _execute_task_async(self, agent, context, tools, future):
        # Inside the worker thread, get the ContextVar value
        val = my_var.get()
        # Set the result on the future
        future.set_result(val)


def test_contextvar_propagation_in_execute_async():
    """
    This test verifies that when execute_async is called with async_execution=True,
    the ContextVar set on the calling thread is visible inside the worker thread.

    Before the fix, the ContextVar value inside the thread is None (default).
    After the fix, the ContextVar value is preserved ("test_value").
    """
    # Set the ContextVar before calling execute_async
    my_var.set("test_value")

    # Create dummy agent, context, tools (can be None or dummy)
    agent = None
    context = None
    tools = None

    task = DummyTask(async_execution=True)

    future = task.execute_async(agent, context, tools)

    # Wait for the thread to complete and future to be set
    # Timeout after 2 seconds to avoid hanging tests
    timeout = 2.0
    start = time.time()
    while not future.done():
        if time.time() - start > timeout:
            pytest.fail("Timeout waiting for async task to complete")
        time.sleep(0.01)

    result = future.result()

    # Assert that the ContextVar value inside the thread is the same as set outside
    # This will fail on buggy code (result will be None) and pass on fixed code (result == "test_value")
    assert result == "test_value", (
        "ContextVar value was lost inside thread spawned by execute_async. "
        "Expected 'test_value', got {!r}".format(result)
    )[0m
