[32mimport contextvars
import threading
import time
import pytest

from crewai.task import Task, TaskOutput


def test_async_execution_preserves_contextvar():
    # Create a ContextVar and set a value in the main thread
    test_var = contextvars.ContextVar("test_var", default=None)
    test_value = "context_value"
    test_var.set(test_value)

    # Prepare a dummy Task instance with minimal required attributes/methods
    # We assume Task has a method execute_async(agent, context, tools) -> Future[TaskOutput]
    # and that _execute_task_async runs the task logic.
    # We will monkeypatch _execute_task_async to check the contextvar inside the thread.

    class DummyAgent:
        pass

    class DummyContext:
        pass

    class DummyTools:
        pass

    task = Task.__new__(Task)  # create instance without calling __init__

    # Define a container to capture the contextvar value inside the thread
    result_container = {}

    # Patch _execute_task_async to capture the ContextVar value inside the thread
    def patched_execute_task_async(agent, context, tools, future):
        # Inside the thread, get the contextvar value
        val = test_var.get()
        result_container["value"] = val
        # Set a dummy result to future to avoid hanging
        future.set_result(TaskOutput(result="dummy"))
        return None

    task._execute_task_async = patched_execute_task_async

    # Call execute_async with async_execution=True path (simulate)
    # The real execute_async uses threading.Thread without context copy in buggy,
    # and with context copy in fixed. We test that the contextvar value is preserved.

    # We do not have the async_execution flag here, but execute_async is the buggy method.
    # So calling execute_async should spawn a thread that runs patched_execute_task_async.

    future = task.execute_async(DummyAgent(), DummyContext(), DummyTools())

    # Wait for thread to finish (future to complete)
    # Timeout to avoid hanging test
    timeout = 5
    start = time.time()
    while not future.done():
        if time.time() - start > timeout:
            pytest.fail("Timeout waiting for async task to complete")
        time.sleep(0.01)

    # Check that the contextvar value inside the thread matches the main thread's value
    # On buggy code, this will be None (default), on fixed code it should be test_value
    assert "value" in result_container, "Thread did not run or did not set result"
    assert result_container["value"] == test_value, (
        "ContextVar value lost in async_execution thread; expected '{}', got '{}'".format(
            test_value, result_container["value"]
        )
    )[0m
