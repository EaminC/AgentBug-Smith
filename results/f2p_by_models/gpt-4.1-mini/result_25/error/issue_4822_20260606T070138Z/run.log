[32mimport contextvars
import threading
import time
import pytest

from crewai.task import Task


def test_async_execution_preserves_contextvar():
    # Create a ContextVar and set a value in the main thread
    test_var = contextvars.ContextVar("test_var", default=None)
    test_value = "context_value"
    test_var.set(test_value)

    # Prepare a dummy agent, context, and tools for the Task
    # Since we only want to test context propagation, these can be minimal or None
    agent = None
    context = None
    tools = None

    # Create a Task instance with async_execution=True
    # We assume Task has a constructor that accepts async_execution flag
    # If not, adapt accordingly to set async_execution=True on the task instance
    task = Task(async_execution=True)

    # We need to patch or override _execute_task_async to capture the ContextVar value inside the thread
    # But per instructions, do not mock _execute_task_async itself, so we will use a subclass to capture the value
    class TestTask(Task):
        def _execute_task_async(self, agent, context_, tools_, future):
            # Capture the contextvar value inside the worker thread
            try:
                value_inside_thread = test_var.get()
            except LookupError:
                value_inside_thread = None
            # Set the result on the future for test assertion
            future.set_result(value_inside_thread)

    test_task = TestTask(async_execution=True)

    # Call execute_async, which should spawn a thread and run _execute_task_async
    future = test_task.execute_async(agent, context, tools)

    # Wait for the future to complete (with timeout)
    result = future.result(timeout=5)

    # Assert that the contextvar value inside the thread matches the value set in the main thread
    # This should fail on buggy code (value will be None), and pass after fix (value == test_value)
    assert result == test_value, (
        f"ContextVar value lost in async_execution thread: expected {test_value!r}, got {result!r}"
    )[0m
