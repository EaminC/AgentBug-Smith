[32mimport contextvars
import threading
import time
import pytest

from crewai.task import Task, TaskOutput

# Dummy agent and tools for testing
class DummyAgent:
    def run(self, context, tools):
        return "done"

class DummyTools:
    pass

def test_async_execution_contextvar_propagation():
    """
    This test verifies that when a ContextVar is set in the main thread,
    it is visible inside the task executed asynchronously with async_execution=True.

    Before the fix, the ContextVar value is lost in the worker thread (returns default).
    After the fix, the ContextVar value is preserved inside the worker thread.
    """
    my_var = contextvars.ContextVar("my_var", default=None)
    expected_value = "hello_context"
    my_var.set(expected_value)

    # Create a dummy task instance
    task = Task()

    # Patch _execute_task_async to check ContextVar inside the worker thread
    # We do not mock _execute_task_async itself, but we subclass Task to override it
    class TestTask(Task):
        def _execute_task_async(self, agent, context, tools, future):
            # Inside the worker thread, check the ContextVar value
            value_inside_thread = my_var.get()
            # Set the result to the ContextVar value found inside thread
            future.set_result(value_inside_thread)

    test_task = TestTask()

    # Call execute_async with async_execution=True to spawn thread
    future = test_task.execute_async(DummyAgent(), None, DummyTools())

    # Wait for the future to complete (timeout after 5 seconds)
    timeout = 5
    start = time.time()
    while not future.done():
        if time.time() - start > timeout:
            pytest.fail("Timeout waiting for async task to complete")
        time.sleep(0.01)

    result = future.result()

    # Assert that the ContextVar value is preserved inside the worker thread
    assert result == expected_value, (
        "ContextVar value was lost in async_execution thread. "
        "This indicates the bug is present. After fix, this should pass."
    )[0m
