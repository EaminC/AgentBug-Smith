[32mimport contextvars
import threading
import time
import pytest

from crewai.task import Task  # Assuming Task class is in crewai.task


def test_async_execution_preserves_contextvar_state():
    """
    This test verifies that when a Task is executed asynchronously with async_execution=True,
    the ContextVar state set in the calling thread is preserved inside the worker thread.

    Expected behavior:
    - The ContextVar value set before execute_async() is called should be accessible inside
      the worker thread that runs the task.
    """

    # Create a ContextVar with a default value
    test_var = contextvars.ContextVar("test_var", default=None)

    # Set a unique value in the main thread context
    expected_value = "context_preserved"
    test_var.set(expected_value)

    # Prepare a dummy Task instance with minimal required attributes/methods
    # We assume Task has an execute_async method that takes (agent, context, tools)
    # and returns a Future that completes with a TaskOutput.
    # We will mock _execute_task_async to check the ContextVar value inside the worker thread.

    class DummyTask(Task):
        def _execute_task_async(self, agent, context, tools, future):
            # Inside the worker thread, get the ContextVar value
            actual_value = test_var.get()
            # Set the result of the future to the actual value for assertion
            future.set_result(actual_value)

    dummy_task = DummyTask()

    # Call execute_async with dummy arguments and async_execution=True
    # The bug is in execute_async, so we call it directly.
    future = dummy_task.execute_async(agent=None, context=None, tools=None)

    # Wait for the future to complete with a timeout
    result = future.result(timeout=5)

    # Assert that the ContextVar value inside the worker thread matches the expected value
    # On buggy code, this will be None (default), causing test failure.
    # On fixed code, this will be "context_preserved", causing test pass.
    assert result == expected_value, (
        f"ContextVar value inside worker thread was {result!r}, "
        f"expected {expected_value!r}. Context was not propagated correctly."
    )[0m
