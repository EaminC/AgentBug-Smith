[32mimport contextvars
import threading
import time
import pytest

from crewai.task import Task, TaskOutput


def test_async_execution_preserves_contextvar():
    """
    This test verifies that when a ContextVar is set in the main thread,
    it is preserved inside the worker thread spawned by Task.execute_async()
    with async_execution=True.

    Before the fix, the ContextVar would reset to its default value inside the thread,
    causing the test to fail. After the fix, the ContextVar value is preserved,
    and the test passes.
    """

    # Define a ContextVar with a default value
    test_var = contextvars.ContextVar("test_var", default="default")

    # Set a unique value in the main thread
    expected_value = "context_value"
    test_var.set(expected_value)

    # Prepare a dummy Task instance with minimal required attributes/methods
    # We only need to test execute_async and _execute_task_async behavior
    # We'll monkeypatch _execute_task_async to check the ContextVar inside the thread

    class DummyTask(Task):
        def _execute_task_async(self, agent, context, tools, future):
            # Inside the worker thread, get the ContextVar value
            actual_value = test_var.get()
            # Set the result to the future for assertion
            future.set_result(actual_value)

    dummy_task = DummyTask()

    # Call execute_async with dummy parameters
    future = dummy_task.execute_async(agent=None, context=None, tools=None)

    # Wait for the thread to complete and get the result
    result = future.result(timeout=5)

    # Assert that the ContextVar value inside the thread matches the main thread's value
    assert result == expected_value, (
        "ContextVar value was not preserved inside the async worker thread. "
        "This indicates the bug is still present."
    )[0m
