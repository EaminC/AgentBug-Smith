[32mimport contextvars
import threading
import time
import pytest

from crewai.task import Task


def test_async_execution_preserves_contextvar():
    # Create a ContextVar and set a value in the main thread
    test_var = contextvars.ContextVar("test_var", default=None)
    test_value = "context_value"
    test_var.set(test_value)

    # Prepare a dummy agent, context, and tools for the Task execution
    # We only need to test context propagation, so these can be minimal or None
    dummy_agent = None
    dummy_context = None
    dummy_tools = None

    # Create a Task instance
    task = Task()

    # We will capture the value of test_var inside the async execution
    result_container = {}

    # Patch the _execute_task_async method to capture the ContextVar value inside the thread
    original_execute = task._execute_task_async

    def patched_execute(agent, context, tools, future):
        # Capture the ContextVar value inside the worker thread
        result_container["value"] = test_var.get()
        # Call the original method to keep normal behavior (or just set future result)
        # We set the future result to avoid hanging
        future.set_result(None)

    task._execute_task_async = patched_execute

    # Execute the task asynchronously with async_execution=True
    # This uses threading.Thread internally and should propagate contextvars correctly after fix
    future = task.execute_async(dummy_agent, dummy_context, dummy_tools)

    # Wait for the thread to complete
    # The future should be done quickly since we set the result immediately
    timeout = 5
    start = time.time()
    while not future.done() and (time.time() - start) < timeout:
        time.sleep(0.01)

    # Restore original method
    task._execute_task_async = original_execute

    # Assert that the ContextVar value inside the thread matches the value set in main thread
    # On buggy code, this will be None (default), causing test failure
    # On fixed code, this will be "context_value", causing test pass
    assert "value" in result_container, "Async task did not run or capture ContextVar"
    assert result_container["value"] == test_value, (
        f"ContextVar value lost in async_execution thread: expected '{test_value}', "
        f"got '{result_container['value']}'"
    )[0m
