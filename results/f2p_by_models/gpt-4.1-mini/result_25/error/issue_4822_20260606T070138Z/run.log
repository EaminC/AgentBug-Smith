[32mimport contextvars
import threading
import time
import pytest

import crewai.task as task_module


class DummyAgent:
    def __init__(self):
        self.executed = False

    def run(self):
        self.executed = True


class DummyContext:
    pass


class DummyTools:
    pass


def test_async_execution_preserves_contextvar():
    """
    This test verifies that when execute_async is called with async_execution=True,
    the ContextVar set in the calling thread is visible inside the worker thread.

    Before the fix, the ContextVar would be reset to its default inside the thread,
    causing the test to fail.

    After the fix, the ContextVar is preserved via contextvars.copy_context(),
    and the test should pass.
    """

    # Define a ContextVar with a default value
    test_var = contextvars.ContextVar("test_var", default="default")

    # Set the ContextVar to a known value in the main thread
    test_var.set("preserved_value")

    # We will capture the value read inside the worker thread here
    results = {}

    # Patch or monkeypatch the _execute_task_async method to capture the ContextVar value
    # We do not mock execute_async itself, only observe inside the real worker thread

    original_execute_task_async = task_module.Task.execute_async if hasattr(task_module.Task, "execute_async") else None

    # We need to find a Task class with execute_async method
    # If Task class is not directly importable, try to import it from crewai.task
    # If not found, skip test (fail early)
    TaskClass = getattr(task_module, "Task", None)
    if TaskClass is None:
        pytest.skip("Task class not found in crewai.task module")

    # Define a subclass to override _execute_task_async to capture ContextVar value
    class TestTask(TaskClass):
        def _execute_task_async(self, agent, context, tools, future):
            # Capture the ContextVar value inside the worker thread
            results["value"] = test_var.get()
            # Mark agent as executed to simulate normal behavior
            if hasattr(agent, "run"):
                agent.run()
            # Set future result to simulate completion
            future.set_result("done")

    # Instantiate the test task
    test_task = TestTask()

    # Prepare dummy agent, context, and tools
    agent = DummyAgent()
    context = DummyContext()
    tools = DummyTools()

    # Call execute_async (the real method) which spawns the thread
    future = test_task.execute_async(agent, context, tools)

    # Wait for the future to complete with timeout
    timeout_seconds = 5
    start_time = time.time()
    while not future.done():
        if time.time() - start_time > timeout_seconds:
            pytest.fail("execute_async future did not complete in time")
        time.sleep(0.01)

    # Assert the ContextVar value inside the worker thread matches the main thread's set value
    # Before fix: results["value"] == "default" (test fails)
    # After fix: results["value"] == "preserved_value" (test passes)
    assert results.get("value") == "preserved_value", (
        f"ContextVar value inside worker thread was '{results.get('value')}', "
        "expected 'preserved_value'. This indicates context was not preserved."
    )

    # Also assert that the agent's run method was called
    assert agent.executed is True, "Agent's run method was not called inside async execution"


# Run the test if executed as main (optional)
if __name__ == "__main__":
    pytest.main([__file__])[0m
