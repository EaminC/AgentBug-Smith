from crewai.task import Task, TaskOutput


def test_async_execution_preserves_contextvar():
    # Create a ContextVar and set a value in the main thread
    test_var = contextvars.ContextVar("test_var", default=None)
    test_value = "context_value"
    test_var.set(test_value)

    # Prepare a dummy Task instance with minimal required attributes/methods
    # We only need to test execute_async, so we mock _execute_task_async to capture the contextvar value
    class DummyTask(Task):
        def _execute_task_async(self, agent, context, tools, future):
            # Inside the worker thread, get the ContextVar value
            try:
                val = test_var.get()
                future.set_result(val)
            except Exception as e:
                future.set_exception(e)

    dummy_task = DummyTask()

    # Call execute_async with async_execution=True behavior (simulate)
    # The actual execute_async method uses threading.Thread internally
    future = dummy_task.execute_async(agent=None, context=None, tools=None)

    # Wait for the thread to complete and get the result
    # Timeout to avoid hanging tests
    timeout = 5
    start_time = time.time()
    while not future.done():
        if time.time() - start_time > timeout:
            pytest.fail("Async task did not complete in time")
        time.sleep(0.01)

    result = future.result()

    # Assert that the ContextVar value inside the thread is the same as in the main thread
    # This will fail on buggy code (value is None), and pass on fixed code (value is "context_value")
    assert result == test_value, (
        f"ContextVar value inside async thread was {result!r}, expected {test_value!r}. "
        "This indicates context was not propagated correctly."
    )[0m
