[32mimport contextvars
import threading
import time
import pytest

from crewai import task


class DummyAgent:
    def run(self):
        return "done"


class DummyContext:
    pass


class DummyTools:
    pass


def test_contextvar_propagation_in_execute_async():
    """
    This test verifies that when execute_async is called with async_execution=True,
    the ContextVar set in the calling thread is visible inside the worker thread.

    Before the fix, the ContextVar would be reset to its default inside the worker thread,
    causing the test to fail.

    After the fix, the ContextVar is preserved and the test passes.
    """

    # Setup a ContextVar with a default value
    var = contextvars.ContextVar("test_var", default="default_value")

    # Set the ContextVar to a known value in the main thread
    var.set("expected_value")

    # Prepare dummy inputs for execute_async
    dummy_agent = DummyAgent()
    dummy_context = DummyContext()
    dummy_tools = DummyTools()

    # Patch the _execute_task_async method of task.Task to check ContextVar inside the thread
    # We cannot mock _execute_task_async itself, but we can subclass Task to override it
    class TestTask(task.Task):
        def _execute_task_async(self, agent, context, tools, future):
            # Inside this method, the ContextVar should have the value set above
            try:
                value = var.get()
            except LookupError:
                value = None
            # Complete the future with the ContextVar value
            future.set_result(value)

    t = TestTask()

    # Call execute_async which spawns a thread that runs _execute_task_async
    future = t.execute_async(dummy_agent, dummy_context, dummy_tools)

    # Wait for the thread to complete and get the result
    # Timeout after 5 seconds to avoid hanging tests
    timeout = 5
    poll_interval = 0.05
    waited = 0
    while not future.done() and waited < timeout:
        time.sleep(poll_interval)
        waited += poll_interval

    assert future.done(), "execute_async thread did not complete in time"

    # The result should be the ContextVar value set in the main thread
    result = future.result()
    assert result == "expected_value", (
        f"ContextVar value lost in async_execution thread: expected 'expected_value', got {result}"
    )[0m
