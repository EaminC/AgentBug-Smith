    ANTHROPIC_AUTH_TOKEN=forge-key \
    FORGE_API_KEY=forge-key

# Set working directory to repo root
WORKDIR /app

# Copy entire repo into container
COPY . .

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install python dependencies and install repo, plus test deps
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm; \
    elif [ -f "pyproject.toml" ]; then \
        pip install -e . && \
        pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm; \
    else \
        pip install -e . && \
        pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm; \
    fi

# Preflight check to verify installation
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

# Set PYTHONPATH for import resolution (src/ detected)
ENV PYTHONPATH=/app

# Default command to start bash
CMD ["/bin/bash"]

