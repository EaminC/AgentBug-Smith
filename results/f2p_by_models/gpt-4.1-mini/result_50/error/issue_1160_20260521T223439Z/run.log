def test_validate_identifiers_raises():
    # Should raise if all None
    with pytest.raises(ValueError):
        mem0_ltm.Mem0LongTermMemory._validate_identifiers(None, None, None)

    # Should not raise if any is provided
    mem0_ltm.Mem0LongTermMemory._validate_identifiers("a", None, None)
    mem0_ltm.Mem0LongTermMemory._validate_identifiers(None, "u", None)
    mem0_ltm.Mem0LongTermMemory._validate_identifiers(None, None, "r")


def test_setup_mem0_logging(monkeypatch):
    import logging

    # Patch logging.getLogger to track calls
    calls = []

    class DummyLogger:
        def setLevel(self, level):
            calls.append(level)

    def dummy_getLogger(name):
        return DummyLogger()

    monkeypatch.setattr(logging, "getLogger", dummy_getLogger)

    # Call with suppress_mem0_logging True
    mem0_ltm.Mem0LongTermMemory._setup_mem0_logging(True)
    assert calls == [logging.CRITICAL, logging.CRITICAL, logging.CRITICAL]

    # Reset calls and call with False
    calls.clear()
    mem0_ltm.Mem0LongTermMemory._setup_mem0_logging(False)
    assert calls == []  # no calls when False


