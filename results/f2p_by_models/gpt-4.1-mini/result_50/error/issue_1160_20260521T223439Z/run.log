                                "EmbedderFactory": DummyEmbedderFactory,
                            },
                        )
                    },
                ),
                "__version__": "0.1.116",
            },
        ),
    )

    # Should not raise ImportError or other exceptions
    Mem0LongTermMemory._register_agentscope_providers()
    # The DummyEmbedderFactory.provider_to_class should have 'agentscope' key now
    assert "agentscope" in DummyEmbedderFactory.provider_to_class


