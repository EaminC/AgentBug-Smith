    monkeypatch.setitem(sys.modules, "mem0.utils.factory", MagicMock(LlmFactory=dummy_LlmFactory, EmbedderFactory=dummy_EmbedderFactory))
    monkeypatch.setitem(sys.modules, "packaging.version", dummy_version)
    monkeypatch.setitem(sys.modules, "mem0.metadata", dummy_metadata)

    # Patch the _create_agentscope_config_classes function to return dummy config classes
