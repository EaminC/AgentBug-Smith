import pytest

from agentscope.memory._long_term_memory._mem0._mem0_long_term_memory import Mem0LongTermMemory


@pytest.mark.asyncio
async def test_mem0_long_term_memory_init_and_record():
    # Test that Mem0LongTermMemory raises ValueError if no identifiers provided
    with pytest.raises(ValueError):
        Mem0LongTermMemory()

    # Create instance with at least one identifier
    mem = Mem0LongTermMemory(agent_name="agent1")

    # Prepare dummy message input for record
    messages = [
        {
            "role": "user",
            "content": "Hello, this is a test message.",
        }
    ]

    # Call record method and check it returns a dict (the new signature)
    result = await mem.record(messages)
    assert isinstance(result, dict)

    # Check that the stored identifiers are correct
    assert mem.agent_id == "agent1"
    assert mem.user_id is None
    assert mem.run_id is None


@pytest.mark.asyncio
async def test_mem0_long_term_memory_record_returns_expected_keys():
    mem = Mem0LongTermMemory(agent_name="agent1")

    messages = [
        {
            "role": "user",
            "content": "Another test message for recording.",
        }
    ]

    result = await mem.record(messages)
    # The result should be a dict containing at least a 'memory' or 'results' key or similar
    # We do not know exact keys but at least it should be a dict and non-empty
    assert isinstance(result, dict)
    assert len(result) > 0


@pytest.mark.asyncio
async def test_mem0_long_term_memory_record_with_memory_type_and_infer():
    mem = Mem0LongTermMemory(agent_name="agent1")

    messages = [
        {
            "role": "user",
            "content": "Test message with memory_type and infer flags.",
        }
    ]

    # Call record with explicit memory_type and infer flags
    result = await mem.record(messages, memory_type="semantic", infer=False)
    assert isinstance(result, dict)


@pytest.mark.asyncio
async def test_mem0_long_term_memory_validate_identifiers_staticmethod():
    # The static method _validate_identifiers should raise if all None
    with pytest.raises(ValueError):
        Mem0LongTermMemory._validate_identifiers(None, None, None)

    # Should not raise if any one is provided
    Mem0LongTermMemory._validate_identifiers("agent", None, None)
    Mem0LongTermMemory._validate_identifiers(None, "user", None)
    Mem0LongTermMemory._validate_identifiers(None, None, "run")


