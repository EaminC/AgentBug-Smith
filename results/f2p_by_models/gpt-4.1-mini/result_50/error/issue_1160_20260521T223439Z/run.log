[32mimport asyncio
import pytest

from agentscope.memory._long_term_memory._mem0._mem0_long_term_memory import Mem0LongTermMemory


@pytest.mark.asyncio
async def test_mem0_long_term_memory_record_and_init():
    # Test that Mem0LongTermMemory raises ValueError if no identifiers provided
    with pytest.raises(ValueError):
        Mem0LongTermMemory()

    # Test that Mem0LongTermMemory can be initialized with at least one identifier
    mem = Mem0LongTermMemory(agent_name="test_agent", model=None, embedding_model=None)

    # Since model and embedding_model are None and mem0_config is None, this should raise ValueError
    # but the constructor might raise it only if mem0_config is None and model or embedding_model is None
    # So we expect ValueError here as well
    with pytest.raises(ValueError):
        Mem0LongTermMemory(agent_name="test_agent")

    # To test successful init, we need to provide dummy model and embedding_model mocks
    class DummyModel:
        def __init__(self):
            pass

    dummy_model = DummyModel()
    dummy_embedding = DummyModel()

    mem = Mem0LongTermMemory(
        agent_name="test_agent",
        model=dummy_model,
        embedding_model=dummy_embedding,
        suppress_mem0_logging=True,
    )

    # Test that record returns a dict (async method)
    # We will mock _mem0_record to avoid actual mem0 calls
    # But per instructions, do not mock the method under test, only internal network calls
    # So we run record with dummy messages and expect a dict result or exception if mem0 not installed
    # We catch ImportError and skip test if mem0 is not installed

    try:
        result = await mem.record(
            messages=[{"role": "user", "content": "Hello"}],
            memory_type=None,
            infer=True,
        )
        # The result should be a dict (per the fixed code)
        assert isinstance(result, dict)
    except ImportError:
        pytest.skip("mem0 library not installed, skipping test")
    except Exception as e:
        # If other exceptions occur, fail the test
        pytest.fail(f"Unexpected exception during record: {e}")


def test_mem0_long_term_memory_setup_mem0_logging_suppresses(monkeypatch):
    # Test that _setup_mem0_logging suppresses mem0 logging when suppress_mem0_logging=True
    # and does not raise errors when False

    # We patch logging.getLogger to track calls
    calls = []

    class FakeLogger:
        def setLevel(self, level):
            calls.append(level)

    def fake_getLogger(name):
        calls.append(name)
        return FakeLogger()

    import agentscope.memory._long_term_memory._mem0._mem0_long_term_memory as mem0mod

    monkeypatch.setattr(mem0mod, "logging", None)
    # patch logging.getLogger in mem0mod
    import sys

    sys.modules["logging"] = type("logging", (), {"getLogger": fake_getLogger})

    # Call with suppress_mem0_logging=True
    mem0mod.Mem0LongTermMemory._setup_mem0_logging(True)
    # We expect calls to getLogger with "mem0", "mem0.memory", "mem0.memory.main"
    assert "mem0" in calls
    assert "mem0.memory" in calls
    assert "mem0.memory.main" in calls

    # Clear calls
    calls.clear()

    # Call with suppress_mem0_logging=False should do nothing (no calls)
    mem0mod.Mem0LongTermMemory._setup_mem0_logging(False)
    assert calls == []


@pytest.mark.asyncio
async def test_mem0_long_term_memory_validate_identifiers():
    # Validate that _validate_identifiers raises ValueError if all None
    mem0 = Mem0LongTermMemory

    with pytest.raises(ValueError):
        mem0._validate_identifiers(None, None, None)

    # Should not raise if any one is provided
    mem0._validate_identifiers("agent", None, None)
    mem0._validate_identifiers(None, "user", None)
    mem0._validate_identifiers(None, None, "run")


