[32mimport asyncio
import pytest

from agentscope.memory._long_term_memory._mem0._mem0_long_term_memory import Mem0LongTermMemory


@pytest.mark.asyncio
async def test_mem0_long_term_memory_init_and_record():
    # Test that Mem0LongTermMemory raises ValueError if no identifiers provided
    with pytest.raises(ValueError):
        Mem0LongTermMemory()

    # Test that Mem0LongTermMemory can be instantiated with at least one identifier
    mem = Mem0LongTermMemory(agent_name="test_agent")

    # Prepare a dummy message list for record method
    # We use a minimal message dict that should be accepted by mem0 record method
    messages = [
        {
            "role": "user",
            "content": "Hello, this is a test message.",
        }
    ]

    # Call record method and check it returns a dict (results)
    results = await mem.record(messages)
    assert isinstance(results, dict)

    # Test that record returns expected keys (at least 'memories' or 'relations' keys)
    # This depends on mem0 implementation but we check for dict type and non-empty keys
    assert results, "Record results should not be empty"
    assert any(isinstance(v, list) for v in results.values()), "Expected list values in results"


@pytest.mark.asyncio
async def test_mem0_long_term_memory_record_with_memory_type():
    mem = Mem0LongTermMemory(user_name="user123")

    messages = [
        {
            "role": "user",
            "content": "Another test message for memory_type.",
        }
    ]

    # Call record with explicit memory_type and infer flag
    results = await mem.record(messages, memory_type="semantic", infer=False)
    assert isinstance(results, dict)
    assert results, "Record results should not be empty"


@pytest.mark.asyncio
async def test_mem0_long_term_memory_invalid_identifiers():
    # Directly test the static method _validate_identifiers raises on all None
    with pytest.raises(ValueError):
        Mem0LongTermMemory._validate_identifiers(None, None, None)

    # Should not raise if at least one is provided
    Mem0LongTermMemory._validate_identifiers("agent", None, None)
    Mem0LongTermMemory._validate_identifiers(None, "user", None)
    Mem0LongTermMemory._validate_identifiers(None, None, "run")


def test_mem0_long_term_memory_setup_mem0_logging(monkeypatch):
    # Test that _setup_mem0_logging sets logging levels without error
    # We patch logging.getLogger to a dummy that records calls
    calls = []

    class DummyLogger:
        def setLevel(self, level):
            calls.append(level)

    class DummyLogging:
        def getLogger(self, name):
            calls.append(name)
            return DummyLogger()

    monkeypatch.setattr("agentscope.memory._long_term_memory._mem0._mem0_long_term_memory.logging", DummyLogging())

    # Call with suppress_mem0_logging True
    Mem0LongTermMemory._setup_mem0_logging(True)
    assert calls, "Logging setup should call getLogger and setLevel"

    # Clear calls and call with False (should do nothing)
    calls.clear()
    Mem0LongTermMemory._setup_mem0_logging(False)
    assert not calls, "Logging setup with False should not call getLogger"


def test_mem0_long_term_memory_register_agentscope_providers():
    # Just call the method to ensure no ImportError or exceptions
    # It should register providers in mem0
    Mem0LongTermMemory._register_agentscope_providers()


@pytest.mark.asyncio
async def test_mem0_long_term_memory_record_returns_dict(monkeypatch):
    # Patch mem0.AsyncMemory.record to return a dummy dict
    class DummyAsyncMemory:
        async def record(self, *args, **kwargs):
            return {"memories": ["dummy_memory"], "relations": []}

    # Patch the AsyncMemory instance in Mem0LongTermMemory
    mem = Mem0LongTermMemory(agent_name="agent")
    mem.long_term_working_memory = DummyAsyncMemory()

    messages = [{"role": "user", "content": "Test message"}]

    results = await mem.record(messages)
    assert isinstance(results, dict)
    assert "memories" in results


@pytest.mark.asyncio
