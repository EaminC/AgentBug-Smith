[32mimport asyncio
import pytest

from agentscope.memory._long_term_memory._mem0._mem0_long_term_memory import Mem0LongTermMemory


@pytest.mark.asyncio
async def test_mem0_long_term_memory_init_and_record(monkeypatch):
    # Patch mem0.AsyncMemory to avoid real network or disk operations
    class DummyAsyncMemory:
        def __init__(self, config):
            self.config = config
            self.recorded = []

        async def record(self, messages, memory_type=None, infer=True, **kwargs):
            self.recorded.append((messages, memory_type, infer, kwargs))
            # Return dummy result dict to simulate successful record
            return {"status": "success", "messages_count": len(messages)}

    # Patch _create_agentscope_config_classes to return dummy classes
    def dummy_create_agentscope_config_classes():
        class DummyLlmConfig:
            pass

        class DummyEmbedderConfig:
            pass

        return DummyLlmConfig, DummyEmbedderConfig

    # Patch mem0.AsyncMemory inside Mem0LongTermMemory
    monkeypatch.setattr("agentscope.memory._long_term_memory._mem0._mem0_long_term_memory.mem0.AsyncMemory", DummyAsyncMemory)
    # Patch _create_agentscope_config_classes function used in __init__
    monkeypatch.setattr("agentscope.memory._long_term_memory._mem0._mem0_long_term_memory._create_agentscope_config_classes", dummy_create_agentscope_config_classes)

    # Create instance with at least one identifier (required)
    mem = Mem0LongTermMemory(agent_name="agent1", model="dummy_model", embedding_model="dummy_embedder")

    # Check that identifiers are stored correctly
    assert mem.agent_id == "agent1"
    assert mem.user_id is None
    assert mem.run_id is None

    # Prepare dummy messages to record
    messages = [
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there!"},
    ]

    # Call record and check returned result
    result = await mem.record(messages)
    assert isinstance(result, dict)
    assert result.get("status") == "success"
    assert result.get("messages_count") == len(messages)

    # Check that the internal AsyncMemory recorded the messages
    assert len(mem.long_term_working_memory.recorded) == 1
    recorded_messages, memory_type, infer, kwargs = mem.long_term_working_memory.recorded[0]
    assert recorded_messages == messages
    assert memory_type is None
    assert infer is True


def test_mem0_long_term_memory_validate_identifiers():
    # Should raise ValueError if all identifiers are None
    with pytest.raises(ValueError):
        Mem0LongTermMemory._validate_identifiers(None, None, None)

    # Should not raise if at least one identifier is provided
    try:
        Mem0LongTermMemory._validate_identifiers("agent", None, None)
        Mem0LongTermMemory._validate_identifiers(None, "user", None)
        Mem0LongTermMemory._validate_identifiers(None, None, "run")
    except ValueError:
        pytest.fail("Unexpected ValueError raised when identifiers provided")


def test_mem0_long_term_memory_setup_mem0_logging(monkeypatch):
    # Test that logging suppression sets loggers to CRITICAL level
    import logging

    called = {}

    def dummy_setLevel(level):
        called["level"] = level

    class DummyLogger:
        def setLevel(self, level):
            dummy_setLevel(level)

    # Patch logging.getLogger to return DummyLogger
    def dummy_getLogger(name=None):
        return DummyLogger()

    monkeypatch.setattr("agentscope.memory._long_term_memory._mem0._mem0_long_term_memory.logging.getLogger", dummy_getLogger)

    # Call _setup_mem0_logging with suppress_mem0_logging=True
    Mem0LongTermMemory._setup_mem0_logging(True)
    # The last callLevel should be CRITICAL (50)
    assert called["level"] == logging.CRITICAL

    # Call _setup_mem0_logging with suppress_mem0_logging=False should not call setLevel
    called.clear()
    Mem0LongTermMemory._setup_mem0_logging(False)
    assert called == {}[0m
