def test_mem0_long_term_memory_setup_mem0_logging_suppresses(monkeypatch):
    calls = []

    class FakeLogger:
        def setLevel(self, level):
            calls.append(level)

    def fake_getLogger(name):
        calls.append(name)
        return FakeLogger()

    # Patch logging.getLogger inside the module
    import types
    fake_logging = types.SimpleNamespace(getLogger=fake_getLogger)
    monkeypatch.setitem(mem0mod.__dict__, "logging", fake_logging)

    # Call the static method with suppress=True
    mem0mod.Mem0LongTermMemory._setup_mem0_logging(True)

    # Check that logging levels were set to CRITICAL
    assert "mem0" in calls
    assert "mem0.memory" in calls
    assert "mem0.memory.main" in calls
    # The last three calls should be integer levels (CRITICAL)
    assert all(isinstance(c, int) for c in calls if isinstance(c, int))


