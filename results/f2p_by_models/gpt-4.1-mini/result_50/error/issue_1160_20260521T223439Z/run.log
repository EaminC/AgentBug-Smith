[32mimport asyncio
import pytest

from agentscope.memory._long_term_memory._mem0._mem0_long_term_memory import Mem0LongTermMemory


@pytest.mark.asyncio
async def test_mem0_long_term_memory_init_and_record():
    # Test that Mem0LongTermMemory requires at least one identifier
    with pytest.raises(ValueError):
        Mem0LongTermMemory()

    # Provide at least one identifier to initialize
    mem = Mem0LongTermMemory(agent_name="agent_test")

    # The record method should be async and return a dict (not None)
    # We test record with a minimal message list
    messages = [
        {
            "role": "user",
            "content": "Hello, this is a test message for memory recording.",
        }
    ]

    # The record method returns a dict result, test that
    result = await mem.record(messages)
    assert isinstance(result, dict)

    # Test that providing user_name instead of agent_name also works
    mem2 = Mem0LongTermMemory(user_name="user_test")
    result2 = await mem2.record(messages)
    assert isinstance(result2, dict)

    # Test that providing run_name instead of agent_name also works
    mem3 = Mem0LongTermMemory(run_name="run_test")
    result3 = await mem3.record(messages)
    assert isinstance(result3, dict)

    # Test that suppress_mem0_logging disables logging without error
    mem4 = Mem0LongTermMemory(agent_name="agent_test", suppress_mem0_logging=True)
    result4 = await mem4.record(messages)
    assert isinstance(result4, dict)

    # Test that suppress_mem0_logging=False also works
    mem5 = Mem0LongTermMemory(agent_name="agent_test", suppress_mem0_logging=False)
    result5 = await mem5.record(messages)
    assert isinstance(result5, dict)


@pytest.mark.asyncio
async def test_mem0_long_term_memory_record_returns_expected_keys():
    mem = Mem0LongTermMemory(agent_name="agent_test")
    messages = [
        {
            "role": "user",
            "content": "Test message for checking record output keys.",
        }
    ]
    result = await mem.record(messages)
    # The result dict should contain keys like 'memories' or 'relations' (depending on implementation)
    assert isinstance(result, dict)
    # We expect at least one key in the result dict
    assert len(result) > 0


def test_mem0_long_term_memory_validate_identifiers():
    # The _validate_identifiers static method should raise if all None
    with pytest.raises(ValueError):
        Mem0LongTermMemory._validate_identifiers(None, None, None)

    # Should not raise if any identifier is provided
    Mem0LongTermMemory._validate_identifiers("agent", None, None)
    Mem0LongTermMemory._validate_identifiers(None, "user", None)
    Mem0LongTermMemory._validate_identifiers(None, None, "run")


def test_mem0_long_term_memory_setup_mem0_logging(monkeypatch):
    # We patch logging.getLogger to a dummy function to test _setup_mem0_logging
    import logging

    called = {}

    def dummy_getLogger(name):
        called[name] = True
        class DummyLogger:
            def setLevel(self, level):
                called[f"{name}_level"] = level
        return DummyLogger()

    monkeypatch.setattr(logging, "getLogger", dummy_getLogger)

    # Call with suppress_mem0_logging=True should call getLogger and setLevel
    Mem0LongTermMemory._setup_mem0_logging(True)
    assert "mem0" in called
    assert "mem0.memory" in called
    assert "mem0.memory.main" in called
    assert called["mem0_level"] == logging.CRITICAL
    assert called["mem0.memory_level"] == logging.CRITICAL
    assert called["mem0.memory.main_level"] == logging.CRITICAL

    # Call with suppress_mem0_logging=False should not call getLogger
    called.clear()
    Mem0LongTermMemory._setup_mem0_logging(False)
    assert called == {}[0m
