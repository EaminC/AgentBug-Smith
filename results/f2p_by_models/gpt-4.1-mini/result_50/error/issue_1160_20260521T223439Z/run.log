import pytest

from agentscope.memory._long_term_memory._mem0._mem0_long_term_memory import Mem0LongTermMemory


@pytest.mark.asyncio
async def test_mem0_long_term_memory_requires_identifier():
    # It should raise ValueError if no agent_name, user_name, or run_name is provided
    with pytest.raises(ValueError):
        Mem0LongTermMemory()


@pytest.mark.asyncio
async def test_mem0_long_term_memory_record_returns_dict(monkeypatch):
    # Provide at least one identifier to avoid ValueError
    mem = Mem0LongTermMemory(agent_name="agent1", model=object(), embedding_model=object())

    # Patch the internal _mem0_record method to simulate async return
    async def fake_mem0_record(messages, **kwargs):
        return {"result": "ok"}

    monkeypatch.setattr(mem, "_mem0_record", fake_mem0_record)

    result = await mem.record(
        memory_type=None,
        infer=True,
        messages=[{"role": "user", "content": "hello"}],
    )
    assert isinstance(result, dict)
    assert result.get("result") == "ok"


@pytest.mark.asyncio
async def test_mem0_long_term_memory_suppress_logging_flag(monkeypatch):
    # This test verifies that the suppress_mem0_logging flag disables mem0 logging
    # We patch logging.getLogger to track calls and ensure setLevel is called with CRITICAL

    import logging

    called_loggers = {}

    original_getLogger = logging.getLogger

    def fake_getLogger(name=None):
        class DummyLogger:
            def setLevel(self, level):
                called_loggers[name or "root"] = level

        return DummyLogger()

    monkeypatch.setattr(logging, "getLogger", fake_getLogger)

    # Create instance with suppress_mem0_logging=True (default)
    mem = Mem0LongTermMemory(agent_name="agent1", model=object(), embedding_model=object(), suppress_mem0_logging=True)
    # Check that mem0 loggers were set to CRITICAL
    assert called_loggers.get("mem0") == logging.CRITICAL
    assert called_loggers.get("mem0.memory") == logging.CRITICAL
    assert called_loggers.get("mem0.memory.main") == logging.CRITICAL

    # Clear and test with suppress_mem0_logging=False
    called_loggers.clear()
    mem = Mem0LongTermMemory(agent_name="agent1", model=object(), embedding_model=object(), suppress_mem0_logging=False)
    # When suppress_mem0_logging is False, no calls to setLevel expected (empty dict)
    assert called_loggers == {}


@pytest.mark.asyncio
async def test_mem0_long_term_memory_record_integration(monkeypatch):
    # Integration style test: create instance and call record with minimal valid inputs
    mem = Mem0LongTermMemory(agent_name="agent1", model=object(), embedding_model=object())

    # Patch _mem0_record to verify it is called with correct messages and returns a dict
    called = {}

    async def fake_mem0_record(messages, **kwargs):
        called["called"] = True
        called["messages"] = messages
        return {"status": "recorded"}

    monkeypatch.setattr(mem, "_mem0_record", fake_mem0_record)

    messages = [
        {"role": "user", "content": "Test message"},
        {"role": "assistant", "content": "Response"},
    ]

    result = await mem.record(messages=messages)
    assert called.get("called") is True
    assert called.get("messages") == messages
    assert isinstance(result, dict)
    assert result.get("status") == "recorded"[0m
