def test_mem0_long_term_memory_setup_mem0_logging(monkeypatch):
    import logging

    called = {}

    class DummyLogger:
        def setLevel(self, level):
            called["called"] = True

    # Patch logging.getLogger to return DummyLogger for mem0 loggers
    original_getLogger = logging.getLogger

    def dummy_getLogger(name):
        if name.startswith("mem0"):
            return DummyLogger()
        return original_getLogger(name)

    monkeypatch.setattr(logging, "getLogger", dummy_getLogger)

    # Call _setup_mem0_logging with True to suppress logging
    Mem0LongTermMemory._setup_mem0_logging(True)
    assert called.get("called") is True

    # Call with False should not call setLevel
    called.clear()
    Mem0LongTermMemory._setup_mem0_logging(False)
    assert called.get("called") is None


