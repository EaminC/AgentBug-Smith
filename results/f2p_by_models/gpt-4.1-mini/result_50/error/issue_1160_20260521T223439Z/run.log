    monkeypatch.setattr(mem0mod.Mem0LongTermMemory, "_register_agentscope_providers", staticmethod(lambda: None))
    monkeypatch.setattr(mem0mod.Mem0LongTermMemory, "_configure_mem0_config", staticmethod(lambda *args, **kwargs: "dummy_config"))
    monkeypatch.setattr(mem0mod.Mem0LongTermMemory, "_validate_identifiers", staticmethod(lambda a, u, r: None))

    # Instantiate Mem0LongTermMemory with minimal required parameters
    mem = mem0mod.Mem0LongTermMemory(
        agent_name="agent",
        model=object(),
        embedding_model=object(),
        suppress_mem0_logging=True,
    )

    # Prepare dummy messages to record as Msg objects
    messages = [Msg(role="user", content="Hello")]

    # Patch the internal long_term_working_memory to use DummyAsyncMemory
    mem.long_term_working_memory = DummyAsyncMemory("dummy_config")

    # Call record and check the returned dict contains expected keys
    result = await mem.record(messages)
    assert isinstance(result, dict)
    assert result.get("recorded") is True
    assert isinstance(result.get("messages"), list)
    assert all(isinstance(m, Msg) for m in messages)


def test_mem0_long_term_memory_validate_identifiers():
