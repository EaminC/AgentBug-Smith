    monkeypatch.setattr(
        "agentscope.memory._long_term_memory._mem0._mem0_long_term_memory._create_agentscope_config_classes",
        lambda: (type("DummyLlmConfig", (), {}), type("DummyEmbedderConfig", (), {})),
    )
    # Patch _configure_mem0_config to return dummy config
    monkeypatch.setattr(
        Mem0LongTermMemory,
        "_configure_mem0_config",
        staticmethod(lambda *args, **kwargs: "dummy_config"),
    )
    # Patch mem0.AsyncMemory to DummyAsyncMemory
    monkeypatch.setattr("agentscope.memory._long_term_memory._mem0._mem0_long_term_memory.mem0", type("mem0", (), {"AsyncMemory": DummyAsyncMemory}))

    mem = Mem0LongTermMemory(agent_name="agent", model="dummy_model", embedding_model="dummy_embedder")
    result = await mem.record("test message")
    assert isinstance(result, dict)
    assert "memories" in result
    assert result["memories"] == ["mem1"]


