[32mimport asyncio
import pytest

from agentscope.memory._long_term_memory._mem0._mem0_long_term_memory import Mem0LongTermMemory
from agentscope.memory._long_term_memory._mem0._mem0_utils import _create_agentscope_config_classes


@pytest.mark.asyncio
async def test_mem0_long_term_memory_init_and_record(monkeypatch):
    # Patch mem0.AsyncMemory to a dummy class that records calls
    class DummyAsyncMemory:
        def __init__(self, config):
            self.config = config
            self.recorded_messages = []

        async def record(self, messages, memory_type=None, infer=True, **kwargs):
            self.recorded_messages.append((messages, memory_type, infer, kwargs))
            # Return dummy dict result
            return {"status": "ok", "messages_count": len(messages)}

    # Patch mem0 module and AsyncMemory class inside Mem0LongTermMemory
    import sys

    class DummyMem0Config:
        pass

    dummy_mem0_module = type(sys)("mem0")
    dummy_mem0_module.AsyncMemory = DummyAsyncMemory
    dummy_mem0_module.MemoryConfig = DummyMem0Config

    # Patch _create_agentscope_config_classes to return dummy classes
    monkeypatch.setattr(
        "agentscope.memory._long_term_memory._mem0._mem0_long_term_memory._create_agentscope_config_classes",
        lambda: (type("DummyLlmConfig", (), {}), type("DummyEmbedderConfig", (), {})),
    )

    # Patch import of mem0 inside Mem0LongTermMemory to use dummy_mem0_module
    monkeypatch.setattr(
        "agentscope.memory._long_term_memory._mem0._mem0_long_term_memory.mem0",
        dummy_mem0_module,
    )

    # Create instance with minimal required identifiers and dummy models
    mem = Mem0LongTermMemory(
        agent_name="agent1",
        model=object(),
        embedding_model=object(),
        suppress_mem0_logging=True,
    )

    # The dummy AsyncMemory instance should be assigned
    assert isinstance(mem.long_term_working_memory, DummyAsyncMemory)

    # Prepare dummy messages to record
    messages = [{"role": "user", "content": "Hello world"}]

    # Call record and check return type and content
    result = await mem.record(messages)
    assert isinstance(result, dict)
    assert result.get("status") == "ok"
    assert result.get("messages_count") == len(messages)

    # Check that DummyAsyncMemory recorded the messages
    recorded = mem.long_term_working_memory.recorded_messages
    assert len(recorded) == 1
    recorded_messages, memory_type, infer, kwargs = recorded[0]
    assert recorded_messages == messages
    assert memory_type is None
    assert infer is True


def test_mem0_long_term_memory_validate_identifiers():
    # Should raise ValueError if all None
    with pytest.raises(ValueError):
        Mem0LongTermMemory._validate_identifiers(None, None, None)

    # Should not raise if at least one provided
    Mem0LongTermMemory._validate_identifiers("agent", None, None)
    Mem0LongTermMemory._validate_identifiers(None, "user", None)
    Mem0LongTermMemory._validate_identifiers(None, None, "run")


def test_mem0_long_term_memory_setup_mem0_logging(monkeypatch):
    # Patch logging.getLogger to a dummy that records setLevel calls
    calls = []

    class DummyLogger:
        def setLevel(self, level):
            calls.append(level)

    def dummy_getLogger(name=None):
        return DummyLogger()

    import logging

    monkeypatch.setattr(logging, "getLogger", dummy_getLogger)

    # Call _setup_mem0_logging with suppress True and False
    Mem0LongTermMemory._setup_mem0_logging(True)
    assert calls  # Should have setLevel calls

    calls.clear()
    Mem0LongTermMemory._setup_mem0_logging(False)
    assert not calls  # No calls when suppress is False


@pytest.mark.asyncio
