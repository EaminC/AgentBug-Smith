def test_mem0_long_term_memory_setup_mem0_logging(monkeypatch):
    # We test that calling _setup_mem0_logging with True sets logging levels
    import logging

    called = {}

    def fake_setLevel(level):
        called["called"] = True

    monkeypatch.setattr(logging.getLogger("mem0"), lambda: type("Logger", (), {"setLevel": fake_setLevel})())
    monkeypatch.setattr(logging.getLogger("mem0.memory"), lambda: type("Logger", (), {"setLevel": fake_setLevel})())
    monkeypatch.setattr(logging.getLogger("mem0.memory.main"), lambda: type("Logger", (), {"setLevel": fake_setLevel})())

    Mem0LongTermMemory._setup_mem0_logging(True)
    assert called.get("called", False) is True


