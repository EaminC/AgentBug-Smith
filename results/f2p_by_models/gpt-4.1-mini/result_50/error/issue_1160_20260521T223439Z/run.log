    # Patch _mem0_record to return dummy_result
    async def fake_mem0_record(*args, **kwargs):
        return dummy_result

    monkeypatch.setattr(mem, "_mem0_record", fake_mem0_record)

    result = await mem.record(messages=[{"role": "user", "content": "test"}])
    assert result == dummy_result[0m
