    # The actual message structure depends on the library, but we test record method logic
    # We use a dict mimicking expected input for record method
    # Since the record method calls _mem0_record internally, which is async, we test that it returns a dict

    # We patch _mem0_record to simulate async behavior and return a dummy dict
    # But per instructions, do not mock the method itself, so we provide minimal valid input to avoid errors

    # Compose a minimal message list with role and content keys as expected by mem0
    # The real Msg class is not imported due to ImportError in environment, so use dicts
    messages = [{"role": "user", "content": "Hello"}]

    # Call record and assert it returns a dict (the patched/fixed code returns dict)
    result = await mem.record(messages)
    assert isinstance(result, dict)

    # Also test that suppress_mem0_logging disables mem0 logging without error
    mem2 = Mem0LongTermMemory(agent_name="agent", suppress_mem0_logging=True)
    result2 = await mem2.record(messages)
    assert isinstance(result2, dict)

    # Test that providing user_name instead of agent_name also works
    mem3 = Mem0LongTermMemory(user_name="user")
    result3 = await mem3.record(messages)
    assert isinstance(result3, dict)

    # Test that providing run_name instead of agent_name also works
    mem4 = Mem0LongTermMemory(run_name="run")
    result4 = await mem4.record(messages)
    assert isinstance(result4, dict)


