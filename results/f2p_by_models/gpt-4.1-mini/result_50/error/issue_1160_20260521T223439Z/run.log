def test_mem0_long_term_memory_setup_mem0_logging_suppresses(monkeypatch):
    # We patch logging.getLogger to track calls
    calls = []

    class FakeLogger:
        def setLevel(self, level):
            calls.append(level)

    def fake_getLogger(name):
        calls.append(name)
        return FakeLogger()

    # Patch import logging inside _setup_mem0_logging
    monkeypatch.setattr(mem0mod, "logging", MagicMock())
    mem0mod.logging.getLogger.side_effect = fake_getLogger

    # Call with suppress_mem0_logging=True should call setLevel with CRITICAL
    mem0mod.Mem0LongTermMemory._setup_mem0_logging(True)
    assert "mem0" in calls
    assert "mem0.memory" in calls
    assert "mem0.memory.main" in calls
    assert mem0mod.logging.CRITICAL in calls

    # Clear calls
    calls.clear()

    # Call with suppress_mem0_logging=False should do nothing
    mem0mod.Mem0LongTermMemory._setup_mem0_logging(False)
    assert calls == []


def test_mem0_long_term_memory_validate_identifiers():
    # Should raise ValueError if all None
    with pytest.raises(ValueError):
        mem0mod.Mem0LongTermMemory._validate_identifiers(None, None, None)

    # Should not raise if at least one is not None
    mem0mod.Mem0LongTermMemory._validate_identifiers("agent", None, None)
    mem0mod.Mem0LongTermMemory._validate_identifiers(None, "user", None)
    mem0mod.Mem0LongTermMemory._validate_identifiers(None, None, "run")


