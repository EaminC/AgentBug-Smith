@pytest.mark.asyncio
async def test_mem0_long_term_memory_record_and_init(monkeypatch):
    # Patch import of mem0 and related to avoid ImportError and simulate mem0 internals
    class DummyAsyncMemory:
        def __init__(self, config):
            self.config = config

        async def record(self, messages, memory_type=None, infer=True, **kwargs):
            return {"recorded": True, "messages": messages}

    dummy_mem0 = MagicMock()
    dummy_mem0.AsyncMemory = DummyAsyncMemory

    dummy_llm_config = type("DummyLlmConfig", (), {})
    dummy_embedder_config = type("DummyEmbedderConfig", (), {})

    dummy_LlmFactory = MagicMock()
    dummy_EmbedderFactory = MagicMock()
    dummy_version = MagicMock()
    dummy_version.parse = lambda v: tuple(int(x) for x in v.split(".") if x.isdigit())
    # Provide __lt__ method on the tuple returned by parse
    def version_lt(self, other):
        return self < other
    dummy_version.parse.__lt__ = version_lt

    dummy_metadata = MagicMock()
    dummy_metadata.version.return_value = "1.0.0"

    # Patch the imports inside the module namespace
    monkeypatch.setitem(mem0mod.__dict__, "mem0", dummy_mem0)
    monkeypatch.setitem(mem0mod.__dict__, "metadata", dummy_metadata)
    monkeypatch.setitem(mem0mod.__dict__, "version", dummy_version)
    monkeypatch.setitem(mem0mod.__dict__, "LlmFactory", dummy_LlmFactory)
    monkeypatch.setitem(mem0mod.__dict__, "EmbedderFactory", dummy_EmbedderFactory)
    monkeypatch.setitem(mem0mod.__dict__, "BaseLlmConfig", dummy_llm_config)

    # Patch the _create_agentscope_config_classes function to return dummy config classes
    monkeypatch.setattr(mem0mod, "_create_agentscope_config_classes", lambda: (dummy_llm_config, dummy_embedder_config))

    # Patch the _setup_mem0_logging to do nothing (to avoid import errors)
    monkeypatch.setattr(mem0mod.Mem0LongTermMemory, "_setup_mem0_logging", staticmethod(lambda suppress: None))
    # Patch the _register_agentscope_providers to do nothing (to avoid import errors)
    monkeypatch.setattr(mem0mod.Mem0LongTermMemory, "_register_agentscope_providers", staticmethod(lambda: None))
    # Patch the _configure_mem0_config to return a dummy config string
    monkeypatch.setattr(mem0mod.Mem0LongTermMemory, "_configure_mem0_config", staticmethod(lambda *args, **kwargs: "dummy_config"))

    # Construct Mem0LongTermMemory with at least one identifier and dummy models
    mem = mem0mod.Mem0LongTermMemory(
        agent_name="agent",
        model=object(),
        embedding_model=object(),
        suppress_mem0_logging=True,
    )

    # Test that the async memory instance is set and config is dummy_config
    assert mem.long_term_working_memory.config == "dummy_config"
    assert mem.agent_id == "agent"
    assert mem.user_id is None
    assert mem.run_id is None

    # Test record method returns a dict and calls underlying AsyncMemory.record
    result = await mem.record(
        content="test content",
        memory_type="semantic",
        infer=True,
    )
    assert isinstance(result, dict)
    assert result.get("recorded") is True
    assert isinstance(result.get("messages"), list)
    # The messages should contain the content we passed
    found = False
    for msg in result.get("messages", []):
        if msg and isinstance(msg, dict):
            if "content" in msg and msg["content"] == "test content":
                found = True
    assert found


def test_mem0_long_term_memory_validate_identifiers():
    # Should raise ValueError if all None
    with pytest.raises(ValueError):
        mem0mod.Mem0LongTermMemory._validate_identifiers(None, None, None)

    # Should not raise if at least one is provided
    mem0mod.Mem0LongTermMemory._validate_identifiers("agent", None, None)
    mem0mod.Mem0LongTermMemory._validate_identifiers(None, "user", None)
    mem0mod.Mem0LongTermMemory._validate_identifiers(None, None, "run")


def test_mem0_long_term_memory_setup_mem0_logging_suppresses(monkeypatch):
    calls = []

    class FakeLogger:
        def setLevel(self, level):
            calls.append(level)

    def fake_getLogger(name):
        calls.append(name)
        return FakeLogger()

    # Patch logging.getLogger inside the module
    import sys
    import types

    fake_logging = types.SimpleNamespace(getLogger=fake_getLogger)
    monkeypatch.setitem(mem0mod.__dict__, "logging", fake_logging)

    # Call the static method with suppress=True
    mem0mod.Mem0LongTermMemory._setup_mem0_logging(True)
    # We expect calls to getLogger with names and setLevel with CRITICAL (50)
    assert "mem0" in calls
    assert "mem0.memory" in calls
    assert "mem0.memory.main" in calls
    assert 50 in calls  # logging.CRITICAL is 50

    # Clear calls and call with suppress=False, expect no calls to setLevel
    calls.clear()
    mem0mod.Mem0LongTermMemory._setup_mem0_logging(False)
    # Only getLogger calls, no setLevel calls
    assert "mem0" not in calls  # Because no setLevel called, no names appended
    # Actually, with suppress=False, method returns early and does nothing
    # So calls should remain empty
    assert calls == []


