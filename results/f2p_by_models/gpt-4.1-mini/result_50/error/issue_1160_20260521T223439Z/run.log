import pytest

from agentscope.memory._long_term_memory._mem0._mem0_long_term_memory import Mem0LongTermMemory
from agentscope.memory._long_term_memory._mem0._mem0_utils import _create_agentscope_config_classes


@pytest.mark.asyncio
async def test_mem0_long_term_memory_init_and_record():
    # Prepare minimal valid parameters
    agent_name = "test_agent"
    user_name = None
    run_name = None

    # Create dummy model and embedding model classes compatible with mem0 config
    _ASLlmConfig, _ASEmbedderConfig = _create_agentscope_config_classes()

    class DummyModel:
        def dict(self):
            return {"model_name": "dummy-model"}

    class DummyEmbeddingModel:
        def dict(self):
            return {"embedder_name": "dummy-embedder"}

    model = DummyModel()
    embedding_model = DummyEmbeddingModel()

    # Instantiate Mem0LongTermMemory with minimal required parameters
    mem = Mem0LongTermMemory(
        agent_name=agent_name,
        user_name=user_name,
        run_name=run_name,
        model=model,
        embedding_model=embedding_model,
        suppress_mem0_logging=True,
    )

    # Prepare a dummy message list for recording
    messages = [
        {
            "role": "user",
            "content": "Hello, this is a test message for Mem0LongTermMemory.",
        }
    ]

    # Call the record method and check that it returns a dict (results)
    results = await mem.record(messages)

    assert isinstance(results, dict), "record() should return a dict of results"

    # Check that internal identifiers are set correctly
    assert mem.agent_id == agent_name
    assert mem.user_id == user_name
    assert mem.run_id == run_name


def test_mem0_long_term_memory_validate_identifiers():
    # Should raise ValueError if all identifiers are None
    with pytest.raises(ValueError):
        Mem0LongTermMemory._validate_identifiers(None, None, None)

    # Should not raise if at least one identifier is provided
    try:
        Mem0LongTermMemory._validate_identifiers("agent", None, None)
        Mem0LongTermMemory._validate_identifiers(None, "user", None)
        Mem0LongTermMemory._validate_identifiers(None, None, "run")
    except ValueError:
        pytest.fail("Validation failed when it should pass")


def test_mem0_long_term_memory_configure_mem0_config_overrides():
    # Import mem0 for config classes
    import mem0
    from mem0.configs.memory import MemoryConfig

    _ASLlmConfig, _ASEmbedderConfig = _create_agentscope_config_classes()

    # Create dummy model and embedding model with dict method
    class DummyModel:
        def dict(self):
            return {"model_name": "dummy-model"}

    class DummyEmbeddingModel:
        def dict(self):
            return {"embedder_name": "dummy-embedder"}

    model = DummyModel()
    embedding_model = DummyEmbeddingModel()

    # Case 1: mem0_config is None, model and embedding_model provided
    mem0_config = Mem0LongTermMemory._configure_mem0_config(
        mem0_config=None,
        model=model,
        embedding_model=embedding_model,
        vector_store_config=None,
        _ASLlmConfig=_ASLlmConfig,
        _ASEmbedderConfig=_ASEmbedderConfig,
        on_disk=True,
    )
    assert isinstance(mem0_config, MemoryConfig)

    # Case 2: mem0_config provided, overrides applied
    base_config = MemoryConfig()
    mem0_config2 = Mem0LongTermMemory._configure_mem0_config(
        mem0_config=base_config,
        model=model,
        embedding_model=embedding_model,
        vector_store_config=None,
        _ASLlmConfig=_ASLlmConfig,
        _ASEmbedderConfig=_ASEmbedderConfig,
    )
    assert mem0_config2 is base_config


@pytest.mark.asyncio
async def test_mem0_long_term_memory_record_returns_results_dict():
    agent_name = "agent"
    model = type("Model", (), {"dict": lambda self: {"model_name": "m"}})()
    embedding_model = type("Embedder", (), {"dict": lambda self: {"embedder_name": "e"}})()

    mem = Mem0LongTermMemory(
        agent_name=agent_name,
        model=model,
        embedding_model=embedding_model,
        suppress_mem0_logging=True,
    )

    messages = [
        {"role": "user", "content": "test message"},
    ]

    results = await mem.record(messages)
    assert isinstance(results, dict)
    # The results dict should contain keys like 'results' or similar depending on mem0 implementation
    assert "results" in results or len(results) >= 0  # Accept either dict with 'results' or any dict


