    monkeypatch.setattr(mem0_ltm, "mem0", DummyMem0Module())

    # Test that ValueError is raised if no identifiers provided
    with pytest.raises(ValueError):
        mem0_ltm.Mem0LongTermMemory()

    # Now create an instance with at least one identifier and dummy models
    mem_instance = mem0_ltm.Mem0LongTermMemory(
        agent_name="agent1",
        user_name=None,
        run_name=None,
        model=DummyModel(),
        embedding_model=DummyEmbeddingModel(),
        vector_store_config=DummyVectorStoreConfig(),
        mem0_config=None,
        suppress_mem0_logging=True,
    )

    # Prepare dummy messages for record
    messages = [
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there!"},
    ]

    # Call record and check returned dictionary
    result = await mem_instance.record(messages)
    assert isinstance(result, dict)
    assert result.get("success") is True
    assert result.get("messages_count") == len(messages)

    # Check that internal AsyncMemory recorded the messages
    recorded = mem_instance.long_term_working_memory.recorded
    assert len(recorded) == 1
    recorded_messages, memory_type, infer, kwargs = recorded[0]
    assert recorded_messages == messages
    assert memory_type is None
    assert infer is True


