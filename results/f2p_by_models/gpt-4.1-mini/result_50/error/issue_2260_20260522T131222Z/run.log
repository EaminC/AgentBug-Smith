# Set working directory to the repo root
WORKDIR /app

# Copy entire repository to container
COPY . .

# Install system dependencies needed for Python builds and packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libssl-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies and package itself, adding test tooling
RUN set -eux; \
    if [ -f requirements.txt ]; then \
      pip install -r requirements.txt && pip install -e .; \
    elif [ -f pyproject.toml ] && [ -f poetry.lock ]; then \
      pip install poetry && poetry install && pip install -e .; \
    elif [ -f pyproject.toml ]; then \
      pip install -e .; \
    else \
      echo "No requirements.txt or pyproject.toml found, skipping deps install."; \
    fi; \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm

# Preflight check to validate imports
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV FORGE_API_KEY="forge-key"

# Final command to start bash shell
CMD ["/bin/bash"]

