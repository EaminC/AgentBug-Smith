WORKDIR /app

# Copy entire repository; test harness depends on full context
COPY . .

# Install system dependencies needed for some Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libssl-dev \
    python3-dev \
  && rm -rf /var/lib/apt/lists/*

# Upgrade pip and related packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies from requirements.txt if present, then install package and test deps
RUN set -eux; \
    if [ -f requirements.txt ]; then \
      pip install -r requirements.txt && pip install -e .; \
    elif [ -f pyproject.toml ] && [ -f poetry.lock ]; then \
      pip install poetry && poetry install && pip install -e .; \
    elif [ -f pyproject.toml ]; then \
      pip install -e .; \
    else \
      echo "No requirements.txt or pyproject.toml found, skipping deps install."; \
    fi; \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm

# Preflight check to verify install
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command must be bash for test environment
CMD ["/bin/bash"]

