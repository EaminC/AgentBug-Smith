{
  "number": 8009,
  "title": "Fix encoding of `data` column on `AgentNodeExecutionInputOutput`",
  "url": "https://github.com/Significant-Gravitas/AutoGPT/issues/8009",
  "state": "closed",
  "created_at": "2024-09-06T12:13:46Z",
  "closed_at": "2024-09-06T14:58:05Z",
  "body": "Currently the encoding is inconsistently applied: error messages are stored raw, while other outputs are JSON-encoded.\n\nThis causes `get_execution_results(..)` and `get_graph_execution(..)` to fail if the results contain `error` outputs, which can't be JSON-decoded.\n\n### TODO\n\n* Handle encoding in `upsert_execution_output(..)`; always JSON-encode data",
  "labels": [
    "bug"
  ],
  "linked_prs": [
    {
      "number": 8010,
      "state": "closed",
      "title": "fix(server): Always JSON-encode `AgentNodeExecutionInputOutput` data",
      "url": "https://github.com/Significant-Gravitas/AutoGPT/pull/8010",
      "merged": true,
      "base_branch": "master",
      "base_sha": "e645cc4b3338e19dd060b443ab0a3d734add124c",
      "head_sha": "fe03cf4fb7269dee9bec87640e0b694725d56178",
      "patch": "diff --git a/rnd/autogpt_server/autogpt_server/data/execution.py b/rnd/autogpt_server/autogpt_server/data/execution.py\nindex 510770fc8402..2ba23a7d3a0f 100644\n--- a/rnd/autogpt_server/autogpt_server/data/execution.py\n+++ b/rnd/autogpt_server/autogpt_server/data/execution.py\n@@ -245,7 +245,7 @@ async def upsert_execution_input(\n async def upsert_execution_output(\n     node_exec_id: str,\n     output_name: str,\n-    output_data: str,  # JSON serialized data.\n+    output_data: Any,\n ) -> None:\n     \"\"\"\n     Insert AgentNodeExecutionInputOutput record for as one of AgentNodeExecution.Output.\n@@ -253,7 +253,7 @@ async def upsert_execution_output(\n     await AgentNodeExecutionInputOutput.prisma().create(\n         data={\n             \"name\": output_name,\n-            \"data\": output_data,\n+            \"data\": json.dumps(output_data),\n             \"referencedByOutputExecId\": node_exec_id,\n         }\n     )\ndiff --git a/rnd/autogpt_server/autogpt_server/executor/manager.py b/rnd/autogpt_server/autogpt_server/executor/manager.py\nindex ff4521160a48..528a3a714013 100644\n--- a/rnd/autogpt_server/autogpt_server/executor/manager.py\n+++ b/rnd/autogpt_server/autogpt_server/executor/manager.py\n@@ -132,13 +132,12 @@ def update_execution(status: ExecutionStatus):\n     output_size = 0\n     try:\n         for output_name, output_data in node_block.execute(input_data):\n-            output_data_str = json.dumps(output_data)\n-            output_size += len(output_data_str)\n+            output_size += len(json.dumps(output_data))\n             logger.info(\n                 \"Node produced output\",\n-                extra={\"json_fields\": {**log_metadata, output_name: output_data_str}},\n+                extra={\"json_fields\": {**log_metadata, output_name: output_data}},\n             )\n-            wait(upsert_execution_output(node_exec_id, output_name, output_data_str))\n+            wait(upsert_execution_output(node_exec_id, output_name, output_data))\n \n             for execution in _enqueue_next_nodes(\n                 api_client=api_client,\n",
