        pip install -r requirements.txt; \
    fi; \
    if [ -f pyproject.toml ] && [ ! -f requirements.txt ]; then \
        pip install -e .; \
    fi; \
    # Always install editable package plus test dependencies
    pip install -e .; \
    pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm; \
    python -c 'import pkg_resources, pytest; print("preflight ok")'

# Shell as container entrypoint for test harness compatibility
CMD ["/bin/bash"]

