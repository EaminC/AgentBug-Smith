[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Detect src/ layout or imports of src.* in tests or source files to decide on editable install
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." . 2>/dev/null; then \
        echo "src/ layout or src imports detected; setting PYTHONPATH and installing dependencies without editable install"; \
        python -m pip install --upgrade pip setuptools wheel; \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout ; \
        export PYTHONPATH=/app; \
    else \
        echo "No src/ layout detected; installing dependencies and editable package"; \
        python -m pip install --upgrade pip setuptools wheel; \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout ; \
    fi

# Confirm core modules are importable
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests to verify build correctness; fallback to pytest on ./ if tests/ not found
RUN if [ -d "tests" ]; then pytest tests -vv; else pytest . -vv; fi

FROM python:3.12-slim AS runtime

WORKDIR /app

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt 2>/dev/null || true && \
    pip install -e . && \
    # Remove test dependencies to keep runtime minimal
    pip uninstall -y pytest pytest-mock pytest-asyncio pytest-cov anyio litellm pytest-xdist pytest-timeout

