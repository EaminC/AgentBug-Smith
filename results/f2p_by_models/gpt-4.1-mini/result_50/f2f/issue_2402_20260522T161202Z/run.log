# Set environment variables for Forge API compatibility with OpenAI and Anthropic SDKs
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY="forge-key" \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN="forge-key"

# Set working directory to the repository root inside the container
WORKDIR /app

# Copy entire repository to /app
COPY . .

# Upgrade pip, setuptools, wheel first
# Then install dependencies and the editable package
# Also ensure test dependencies are installed
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi; \
    # Always install the repo as an editable package
    pip install -e .; \
    # Install mandatory test dependencies
    pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm; \
    # Simple preflight check
    python -c 'import pkg_resources, pytest; print("preflight ok")'

# Expose bash for test harness compatibility
CMD ["/bin/bash"]

