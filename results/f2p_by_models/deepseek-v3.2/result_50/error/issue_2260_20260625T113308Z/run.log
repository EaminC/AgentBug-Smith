ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Copy the entire repository to ensure test scripts are included
COPY . .

# Install system dependencies required for some Python packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        git \
        curl \
        && rm -rf /var/lib/apt/lists/*

# Determine the best installation method based on existing files
# The repository uses uv for dependency management (see pyproject.toml and README)
# The project has pyproject.toml with uv dev-dependencies and optional extras.
# We will install using uv (preferred) if uv is available; otherwise fallback to pip.
# Also install the project in editable mode and mandatory test dependencies.
RUN if command -v uv > /dev/null 2>&1; then \
        uv sync --dev --all-extras; \
    else \
        python -m pip install --upgrade pip wheel uv; \
        uv sync --dev --all-extras; \
    fi && \
    # Install the project in editable mode (no src/ layout detected)
    pip install -e . && \
    # Install mandatory test dependencies (some may already be installed via dev dependencies)
    pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai anyio

# Preflight check to verify core modules can be imported
RUN python -c "import crewai, pytest; print('preflight ok')"

