def test_azure_deployment_name_with_explicit_api_version():
    """
    Test that explicit OPENAI_API_VERSION env var is respected.
    """
    with patch.dict(
        os.environ,
        {
            "OPENAI_API_KEY": "dummy-key",
            "OPENAI_API_VERSION": "2023-05-15",
        },
        clear=True,
    ):
        with patch("gpt_engineer.core.ai.AzureChatOpenAI") as MockAzureChatOpenAI:
            mock_instance = MagicMock()
            MockAzureChatOpenAI.return_value = mock_instance

            ai = AI(
                model_name="my-deployment",
                temperature=0.0,
                azure_endpoint="https://my-resource.openai.azure.com/",
            )

            call_kwargs = MockAzureChatOpenAI.call_args[1]
            # Should use the env var value, not the default
            assert call_kwargs["openai_api_version"] == "2023-05-15"
            assert ai.model_name == "my-deployment"


