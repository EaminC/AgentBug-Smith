[32mimport os
import sys
from unittest.mock import patch, MagicMock
import pytest
from gpt_engineer.core.ai import AI


def test_azure_deployment_name_not_mistaken_for_model_name():
    """
    Test that when using Azure OpenAI, the deployment name is passed correctly
    and not incorrectly used as a model name in a validation step.
    The bug: AI.__init__ with azure_endpoint set passes deployment_name as model_name
    to AzureChatOpenAI, but later validation may treat it as a model name and fail.
    The fix: ensure the model validation step does not treat Azure deployment names
    as model names requiring a specific pattern.
    """
    # Simulate environment variables for Azure
    with patch.dict(
        os.environ,
        {
            "OPENAI_API_KEY": "dummy-key",
            "OPENAI_API_VERSION": "2024-05-01-preview",
        },
        clear=True,
    ):
        # Mock the AzureChatOpenAI class to capture its instantiation
        with patch("gpt_engineer.core.ai.AzureChatOpenAI") as MockAzureChatOpenAI:
            mock_instance = MagicMock()
            MockAzureChatOpenAI.return_value = mock_instance

            # Create AI instance with azure_endpoint and deployment name
            ai = AI(
                model_name="my-deployment",  # This is the deployment name
                temperature=0.0,
                azure_endpoint="https://my-resource.openai.azure.com/",
            )

            # Verify AzureChatOpenAI was called with correct deployment_name
            MockAzureChatOpenAI.assert_called_once()
            call_kwargs = MockAzureChatOpenAI.call_args[1]
            assert call_kwargs["azure_endpoint"] == "https://my-resource.openai.azure.com/"
            assert call_kwargs["deployment_name"] == "my-deployment"
            assert call_kwargs["openai_api_type"] == "azure"
            assert call_kwargs["openai_api_version"] == "2024-05-01-preview"

            # Ensure the model_name attribute is set to the deployment name
            assert ai.model_name == "my-deployment"

            # The bug would manifest when trying to use the AI instance,
