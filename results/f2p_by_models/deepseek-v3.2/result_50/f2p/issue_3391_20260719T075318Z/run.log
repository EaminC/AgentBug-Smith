ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Install system build dependencies required for onnxruntime, chromadb, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    libffi-dev \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Upgrade core packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

WORKDIR /app

# Copy the entire repository (including externally injected tests)
COPY . .

# Install the project in editable mode (as done in CI with uv sync)
# This ensures the 'crewai' package is importable directly.
# We skip the conditional src/ layout handling because the CI workflow
# installs the project via 'uv sync', which behaves equivalently to
# 'pip install -e .'. Setting PYTHONPATH alone would break imports.
RUN pip install --no-build-isolation -e . && \
    pip install \
        pytest \
        pytest-mock \
        pytest-asyncio \
        pytest-cov \
        anyio \
        "setuptools<=81.0.0" \
        litellm \
        pytest-xdist \
        pytest-timeout \
        mem0ai

# Forge environment variables (required by test harness)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Preflight check: verify core packaging and test tooling are available
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

