[32mFROM python:3.12-slim

WORKDIR /app

COPY . .

# Check for src/ layout and decide on editable install
RUN if [ -d src ] && find . -name "*.py" -exec grep -l "^\s*import src\." {} \; > /dev/null 2>&1; then \
        echo "src/ layout detected: skipping editable install to avoid duplicate module loading"; \
        SRC_LAYOUT=1; \
    else \
        SRC_LAYOUT=0; \
    fi

# Install dependencies based on available package manager files
RUN python -m pip install --upgrade pip wheel && \
    if [ -f requirements.txt ]; then \
        pip install -r requirements.txt; \
        if [ "$SRC_LAYOUT" -eq 0 ]; then \
            pip install -e .; \
        fi; \
    elif [ -f pyproject.toml ] && [ -f poetry.lock ]; then \
        pip install poetry; \
        poetry config virtualenvs.create false; \
        poetry install --no-interaction --no-ansi; \
        if [ "$SRC_LAYOUT" -eq 0 ]; then \
