[32mimport json
import os
import tempfile
from unittest.mock import MagicMock, patch

import pytest

from mle.model import load_model, MODEL_DEEPSEEK, DeepSeekModel


def test_deepseek_model_support():
    """Test that DeepSeekModel can be instantiated and used."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = os.path.join(tmpdir, ".mle.json")
        config = {
            "platform": MODEL_DEEPSEEK,
            "api_key": "test_key",
            "model": "deepseek-coder"
        }
        with open(config_path, "w") as f:
            json.dump(config, f)

        with patch("mle.model.importlib.util.find_spec") as mock_find_spec:
            mock_find_spec.return_value = True
            mock_openai = MagicMock()
            mock_client = MagicMock()
            mock_chat = MagicMock()
            mock_completions = MagicMock()
            mock_create = MagicMock()

            mock_openai.OpenAI.return_value = mock_client
            mock_client.chat = mock_chat
            mock_chat.completions = mock_completions

            mock_response = MagicMock()
            mock_choice = MagicMock()
            mock_message = MagicMock()
            mock_message.content = "Hello, world!"
            mock_message.tool_calls = None
            mock_choice.message = mock_message
            mock_response.choices = [mock_choice]
            mock_create.return_value = mock_response
            mock_completions.create = mock_create

            with patch.dict("sys.modules", {"openai": mock_openai}):
                model = load_model(tmpdir)
                assert isinstance(model, DeepSeekModel)
                assert model.model == "deepseek-coder"
                assert model.model_type == MODEL_DEEPSEEK

                result = model.query([{"role": "user", "content": "Hello"}])
                assert result == "Hello, world!"


def test_deepseek_model_query_with_function_calls():
    """Test DeepSeekModel query with function calls."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = os.path.join(tmpdir, ".mle.json")
        config = {
            "platform": MODEL_DEEPSEEK,
            "api_key": "test_key",
            "model": "deepseek-coder"
        }
        with open(config_path, "w") as f:
            json.dump(config, f)

        with patch("mle.model.importlib.util.find_spec") as mock_find_spec:
            mock_find_spec.return_value = True
            mock_openai = MagicMock()
            mock_client = MagicMock()
            mock_chat = MagicMock()
            mock_completions = MagicMock()
            mock_create = MagicMock()

            mock_openai.OpenAI.return_value = mock_client
            mock_client.chat = mock_chat
            mock_chat.completions = mock_completions

            mock_tool_call = MagicMock()
            mock_tool_call.function = MagicMock()
            mock_tool_call.function.name = "search_web"
            mock_tool_call.function.arguments = '{"query": "test"}'
            mock_tool_call.id = "call_123"

            mock_message = MagicMock()
            mock_message.content = None
            mock_message.tool_calls = [mock_tool_call]

            mock_response = MagicMock()
            mock_choice = MagicMock()
            mock_choice.message = mock_message
            mock_response.choices = [mock_choice]
            mock_create.return_value = mock_response
            mock_completions.create = mock_create

            with patch.dict("sys.modules", {"openai": mock_openai}):
                with patch("mle.function.get_function") as mock_get_func:
                    mock_get_func.return_value = lambda **kwargs: "search result"
                    model = load_model(tmpdir)
                    result = model.query(
                        [{"role": "user", "content": "Search for test"}],
                        functions=[{
                            "name": "search_web",
                            "description": "Search the web",
                            "parameters": {"type": "object", "properties": {"query": {"type": "string"}}}
                        }]
                    )
                    assert result == "search result"


