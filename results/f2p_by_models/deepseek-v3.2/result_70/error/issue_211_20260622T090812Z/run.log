[32mimport json
import os
import tempfile
from unittest.mock import MagicMock, patch

import pytest

from mle.model import load_model, MODEL_DEEPSEEK, DeepSeekModel


def test_deepseek_model_support():
    """Test that DeepSeekModel can be instantiated and used."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = os.path.join(tmpdir, ".mle.json")
        config = {
            "platform": MODEL_DEEPSEEK,
            "api_key": "test_key",
            "model": "deepseek-coder"
        }
        with open(config_path, "w") as f:
            json.dump(config, f)

        with patch("mle.model.importlib.util.find_spec") as mock_find_spec:
            mock_find_spec.return_value = True
            mock_openai = MagicMock()
            mock_client = MagicMock()
            mock_chat = MagicMock()
            mock_completions = MagicMock()
            mock_create = MagicMock()

            mock_openai.OpenAI.return_value = mock_client
            mock_client.chat = mock_chat
            mock_chat.completions = mock_completions

            mock_response = MagicMock()
            mock_choice = MagicMock()
            mock_message = MagicMock()
            mock_message.content = "Hello, world!"
            mock_message.tool_calls = None
            mock_choice.message = mock_message
            mock_response.choices = [mock_choice]
            mock_create.return_value = mock_response
            mock_completions.create = mock_create

            with patch.dict("sys.modules", {"openai": mock_openai}):
                model = load_model(tmpdir)
                assert isinstance(model, DeepSeekModel)
                assert model.model == "deepseek-coder"
                assert model.model_type == MODEL_DEEPSEEK
                assert model.temperature == 0.7

                chat_history = [{"role": "user", "content": "Hello"}]
                result = model.query(chat_history)
                assert result == "Hello, world!"


def test_deepseek_model_query_with_function_calls():
    """Test DeepSeekModel query with function calls."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = os.path.join(tmpdir, ".mle.json")
        config = {
            "platform": MODEL_DEEPSEEK,
            "api_key": "test_key",
            "model": "deepseek-coder"
        }
        with open(config_path, "w") as f:
            json.dump(config, f)

        with patch("mle.model.importlib.util.find_spec") as mock_find_spec:
            mock_find_spec.return_value = True
            mock_openai = MagicMock()
            mock_client = MagicMock()
            mock_chat = MagicMock()
            mock_completions = MagicMock()
            mock_create = MagicMock()

            mock_openai.OpenAI.return_value = mock_client
            mock_client.chat = mock_chat
            mock_chat.completions = mock_completions

            mock_tool_call = MagicMock()
            mock_tool_call.id = "call_123"
            mock_function = MagicMock()
            mock_function.name = "test_function"
            mock_function.arguments = '{"arg1": "value1"}'
            mock_tool_call.function = mock_function

            mock_message = MagicMock()
            mock_message.content = None
            mock_message.tool_calls = [mock_tool_call]

            mock_choice = MagicMock()
            mock_choice.message = mock_message
            mock_response = MagicMock()
            mock_response.choices = [mock_choice]
            mock_create.return_value = mock_response
            mock_completions.create = mock_create

            with patch.dict("sys.modules", {"openai": mock_openai}):
                model = load_model(tmpdir)
                chat_history = [{"role": "user", "content": "Call a function"}]
                with patch("mle.model.get_function") as mock_get_function:
                    mock_func = MagicMock()
                    mock_func.return_value = "function result"
                    mock_get_function.return_value = mock_func
                    with patch("mle.model.process_function_name") as mock_process:
                        mock_process.return_value = "test_function"
                        result = model.query(chat_history, functions=[{
                            "name": "test_function",
                            "description": "Test function",
                            "parameters": {"type": "object", "properties": {}}
                        }])
                        assert result == "function result"


def test_deepseek_model_stream():
    """Test DeepSeekModel streaming."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = os.path.join(tmpdir, ".mle.json")
        config = {
            "platform": MODEL_DEEPSEEK,
            "api_key": "test_key",
            "model": "deepseek-coder"
        }
        with open(config_path, "w") as f:
            json.dump(config, f)

        with patch("mle.model.importlib.util.find_spec") as mock_find_spec:
            mock_find_spec.return_value = True
            mock_openai = MagicMock()
            mock_client = MagicMock()
            mock_chat = MagicMock()
            mock_completions = MagicMock()
            mock_create = MagicMock()

            mock_openai.OpenAI.return_value = mock_client
            mock_client.chat = mock_chat
            mock_chat.completions = mock_completions

            mock_chunk1 = MagicMock()
            mock_chunk1_choice = MagicMock()
            mock_chunk1_delta = MagicMock()
            mock_chunk1_delta.content = "Hello "
            mock_chunk1_delta.tool_calls = None
            mock_chunk1_choice.delta = mock_chunk1_delta
            mock_chunk1.choices = [mock_chunk1_choice]

            mock_chunk2 = MagicMock()
            mock_chunk2_choice = MagicMock()
            mock_chunk2_delta = MagicMock()
            mock_chunk2_delta.content = "World"
            mock_chunk2_delta.tool_calls = None
            mock_chunk2_choice.delta = mock_chunk2_delta
            mock_chunk2.choices = [mock_chunk2_choice]

            mock_create.return_value = [mock_chunk1, mock_chunk2]
            mock_completions.create = mock_create

            with patch.dict("sys.modules", {"openai": mock_openai}):
                model = load_model(tmpdir)
                chat_history = [{"role": "user", "content": "Say hello"}]
                chunks = list(model.stream(chat_history))
                assert chunks == ["Hello ", "World"]


def test_deepseek_model_missing_openai_dependency():
    """Test that DeepSeekModel raises ImportError when openai is not installed."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = os.path.join(tmpdir, ".mle.json")
        config = {
            "platform": MODEL_DEEPSEEK,
            "api_key": "test_key",
            "model": "deepseek-coder"
        }
        with open(config_path, "w") as f:
            json.dump(config, f)

        with patch("mle.model.importlib.util.find_spec") as mock_find_spec:
            mock_find_spec.return_value = None

            with pytest.raises(ImportError, match="It seems you didn't install openai"):
                load_model(tmpdir)


