def test_deepseek_model_stream():
    """Test DeepSeekModel streaming."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = os.path.join(tmpdir, ".mle.json")
        config = {
            "platform": MODEL_DEEPSEEK,
            "api_key": "test_key",
            "model": "deepseek-coder"
        }
        with open(config_path, "w") as f:
            json.dump(config, f)

        with patch("mle.model.importlib.util.find_spec") as mock_find_spec:
            mock_find_spec.return_value = True
            mock_openai = MagicMock()
            mock_client = MagicMock()
            mock_chat = MagicMock()
            mock_completions = MagicMock()
            mock_create = MagicMock()

            mock_openai.OpenAI.return_value = mock_client
            mock_client.chat = mock_chat
            mock_chat.completions = mock_completions

            mock_chunk1 = MagicMock()
            mock_chunk1_choice = MagicMock()
            mock_chunk1_delta = MagicMock()
            mock_chunk1_delta.content = "Hello "
            mock_chunk1_delta.tool_calls = None
            mock_chunk1_choice.delta = mock_chunk1_delta
            mock_chunk1.choices = [mock_chunk1_choice]

            mock_chunk2 = MagicMock()
            mock_chunk2_choice = MagicMock()
            mock_chunk2_delta = MagicMock()
            mock_chunk2_delta.content = "World"
            mock_chunk2_delta.tool_calls = None
            mock_chunk2_choice.delta = mock_chunk2_delta
            mock_chunk2.choices = [mock_chunk2_choice]

            mock_create.return_value = [mock_chunk1, mock_chunk2]
            mock_completions.create = mock_create

            with patch.dict("sys.modules", {"openai": mock_openai}):
                model = load_model(tmpdir)
                chunks = list(model.stream([{"role": "user", "content": "Hello"}]))
                assert chunks == ["Hello ", "World"]


def test_deepseek_model_missing_openai_dependency():
    """Test that DeepSeekModel raises ImportError when openai is not installed."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = os.path.join(tmpdir, ".mle.json")
        config = {
            "platform": MODEL_DEEPSEEK,
            "api_key": "test_key",
            "model": "deepseek-coder"
        }
        with open(config_path, "w") as f:
            json.dump(config, f)

        with patch("mle.model.importlib.util.find_spec") as mock_find_spec:
            mock_find_spec.return_value = None

            with pytest.raises(ImportError, match="It seems you didn't install openai"):
                load_model(tmpdir)


