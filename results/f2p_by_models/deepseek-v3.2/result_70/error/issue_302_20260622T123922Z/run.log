def test_gemini_import_error_without_new_sdk():
    """
    Test that GeminiModel raises ImportError when google-genai is not installed.
    In buggy code, it raises ImportError for google-generativeai.
    In fixed code, it raises ImportError for google-genai.
    """
    # Temporarily hide google.genai module
    with patch.dict('sys.modules', {'google.genai': None, 'google.genai.client': None, 'google.genai.types': None}):
        # Also hide google.generativeai to ensure we test the right import
        with patch.dict('sys.modules', {'google.generativeai': None}):
            # Clear any cached import
            if 'mle.model.gemini' in sys.modules:
                del sys.modules['mle.model.gemini']
            try:
                from mle.model.gemini import GeminiModel
                # If we reach here, import succeeded unexpectedly
                # This should not happen in either buggy or fixed code without the SDK
                # but we need to check the error message content
                pass
            except ImportError as e:
                error_msg = str(e)
                # In buggy code, error mentions google-generativeai
                # In fixed code, error mentions google-genai
                # We'll assert that the error message changes between buggy/fixed
                # This test will pass in both but the assertion differs
                if 'google-generativeai' in error_msg:
                    # This is buggy code behavior
                    # The test should pass (no assertion failure) in buggy state
                    # but after fix, this condition will be False, causing assertion error
                    # However we need the test to fail on buggy, pass on fixed.
                    # Actually we want the opposite: test should fail on buggy because
                    # the import error message should NOT contain google-generativeai after fix.
                    # Let's design the test to check that the error message is NOT the old one.
                    # In fixed code, error_msg should contain 'google-genai', not 'google-generativeai'
                    # So we assert that error_msg does NOT contain 'google-generativeai' after fix.
                    # But we can't know which state we're in. We'll make the test fail on buggy
                    # by expecting 'google-genai' in error_msg.
                    # Since buggy code doesn't have that, assertion fails -> test fails.
                    assert 'google-genai' in error_msg, f"Expected error about 'google-genai' but got: {error_msg}"
                else:
                    # Fixed code: error mentions google-genai
                    assert 'google-genai' in error_msg, f"Expected error about 'google-genai' but got: {error_msg}"


