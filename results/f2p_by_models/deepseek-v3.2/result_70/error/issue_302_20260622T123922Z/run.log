def test_gemini_adapt_history_for_gemini():
    """
    Test _adapt_history_for_gemini helper method (new in fixed code).
    Buggy code has _map_chat_history_from_openai instead.
    """
    mock_client = Mock()
    mock_types = Mock()
    
    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        from mle.model.gemini import GeminiModel
        
        model = GeminiModel(api_key='fake-key', model='gemini-2.0-fake')
        
        # Test that the method exists (only in fixed code)
        assert hasattr(model, '_adapt_history_for_gemini')
        
        # Test with mixed chat history
        chat_history = [
            {"role": "system", "content": "You are a helpful assistant."},
            {"role": "user", "content": "Hello"},
            {"role": "assistant", "content": "Hi there!"},
            {"role": "user", "content": "How are you?"}
        ]
        
        system_instruction, prompt = model._adapt_history_for_gemini(chat_history)
        
        # System instruction should be extracted
        assert "helpful assistant" in system_instruction
        
        # Prompt should contain user and model messages
        assert len(prompt) == 3  # user, model, user
        
        # Check structure
        for msg in prompt:
            assert 'role' in msg
            assert 'parts' in msg
            assert isinstance(msg['parts'], list)

