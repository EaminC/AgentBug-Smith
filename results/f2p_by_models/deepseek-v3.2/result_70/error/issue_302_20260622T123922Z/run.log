def test_gemini_model_initialization_with_new_sdk():
    """
    Test that GeminiModel initializes correctly with the new google-genai SDK.
    This test should fail on buggy code (which uses google.generativeai) and pass on fixed code.
    """
    # Mock the google.genai module to simulate the new SDK
    mock_client = MagicMock()
    mock_types = MagicMock()
    mock_genai_module = MagicMock()
    mock_genai_module.client = mock_client
    mock_genai_module.types = mock_types
    
    # Also mock google.generativeai to ensure it's not used
    mock_old_genai = MagicMock()
    
    with patch.dict('sys.modules', {
        'google.genai': mock_genai_module,
        'google.generativeai': mock_old_genai
    }):
        # Clear any cached imports
        sys.modules.pop('mle.model.gemini', None)
        import importlib
        import mle.model.gemini
        
        # Create an instance - should use google.genai.client.Client
        model = mle.model.gemini.GeminiModel(api_key='test-key', model='gemini-2.5-flash')
        
        # In buggy code, this would try to use google.generativeai
        # In fixed code, it should use google.genai.client.Client
        assert model.model == 'gemini-2.5-flash'
        assert model.model_type == 'Gemini'
        assert model.temperature == 0.7
        
        # Check that client was created with the API key
        # In fixed code: self.client = client.Client(api_key=api_key)
        mock_client.Client.assert_called_once_with(api_key='test-key')
        
        # Ensure old SDK wasn't used
        assert not mock_old_genai.configure.called


def test_gemini_query_with_function_calling():
    """
    Test query method with function calling using the new SDK.
    Buggy code will fail because it uses old SDK methods like gemini.protos.
    """
    # Mock the new SDK
    mock_client = MagicMock()
    mock_types = MagicMock()
    mock_genai_module = MagicMock()
    mock_genai_module.client = mock_client
    mock_genai_module.types = mock_types
    
    # Mock function module
    mock_function = MagicMock()
    mock_function.SEARCH_FUNCTIONS = ['search_web', 'search_arxiv']
    mock_function.get_function = MagicMock(return_value=lambda **kwargs: 'search_result')
    mock_function.process_function_name = MagicMock(side_effect=lambda x: x)
    
    with patch.dict('sys.modules', {
        'google.genai': mock_genai_module,
        'mle.function': mock_function
    }):
        sys.modules.pop('mle.model.gemini', None)
        import importlib
        import mle.model.gemini
        
        model = mle.model.gemini.GeminiModel(api_key='test-key')
        
        # Mock the generate_content response
        mock_response = MagicMock()
        mock_candidate = MagicMock()
        mock_content = MagicMock()
        mock_part = MagicMock()
        mock_function_call = MagicMock()
        
        mock_function_call.name = 'search_web'
        mock_function_call.args = {'query': 'test'}
        mock_part.function_call = mock_function_call
        mock_content.parts = [mock_part]
        mock_candidate.content = mock_content
        mock_response.candidates = [mock_candidate]
        mock_response.text = 'Final answer'
        
        mock_client.Client.return_value.models.generate_content.return_value = mock_response
        
        # Test query with function calling
        chat_history = [
            {'role': 'user', 'content': 'Search for something'}
        ]
        
        functions = [{
            'name': 'search_web',
            'description': 'Search the web',
            'parameters': {
                'type': 'object',
                'properties': {
                    'query': {'type': 'string', 'description': 'Search query'}
                },
                'required': ['query']
            }
        }]
        
        result = model.query(chat_history, functions=functions)
        
        # In fixed code, this should work and return the final text
        # In buggy code, it will fail because _map_functions_from_openai uses old protos
        assert result == 'Final answer'
        
        # Verify generate_content was called
        mock_client.Client.return_value.models.generate_content.assert_called()


def test_gemini_query_function_call_loop():
    """
    Test query method with multiple function calls (tool turns).
    Buggy code has different logic for handling function call loops.
    """
    mock_client = MagicMock()
    mock_types = MagicMock()
    mock_genai_module = MagicMock()
    mock_genai_module.client = mock_client
    mock_genai_module.types = mock_types
    
    mock_function = MagicMock()
    mock_function.SEARCH_FUNCTIONS = ['search_web']
    mock_function.get_function = MagicMock(return_value=lambda **kwargs: 'result')
    mock_function.process_function_name = MagicMock(side_effect=lambda x: x)
    
    with patch.dict('sys.modules', {
        'google.genai': mock_genai_module,
        'mle.function': mock_function
    }):
        sys.modules.pop('mle.model.gemini', None)
        import importlib
        import mle.model.gemini
        
        model = mle.model.gemini.GeminiModel(api_key='test-key')
        
        # Setup mock responses for tool calling loop
        mock_response1 = MagicMock()
        mock_candidate1 = MagicMock()
        mock_content1 = MagicMock()
        mock_part1 = MagicMock()
        mock_function_call1 = MagicMock()
        
        mock_function_call1.name = 'search_web'
        mock_function_call1.args = {'query': 'test'}
        mock_part1.function_call = mock_function_call1
        mock_content1.parts = [mock_part1]
        mock_candidate1.content = mock_content1
        mock_response1.candidates = [mock_candidate1]
        
        mock_response2 = MagicMock()
        mock_candidate2 = MagicMock()
        mock_content2 = MagicMock()
        mock_part2 = MagicMock()
        mock_part2.text = 'Final response after tool call'
        mock_content2.parts = [mock_part2]
        mock_candidate2.content = mock_content2
        mock_response2.candidates = [mock_candidate2]
        mock_response2.text = 'Final response after tool call'
        
        # Mock generate_content to return first response with function call,
        # then second response with text
        mock_client.Client.return_value.models.generate_content.side_effect = [
            mock_response1, mock_response2
        ]
        
        chat_history = [{'role': 'user', 'content': 'Test query'}]
        
        result = model.query(chat_history, functions=[{
            'name': 'search_web',
            'description': 'Search',
            'parameters': {
                'type': 'object',
                'properties': {'query': {'type': 'string'}},
                'required': ['query']
            }
        }])
        
        # In fixed code, should handle the tool call loop
        assert result == 'Final response after tool call'
        assert len(model.func_call_history) == 1
        assert model.func_call_history[0] == 'search_web'


