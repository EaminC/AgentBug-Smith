def test_gemini_search_function_limit():
    """
    Test that search function limit logic works with new SDK.
    """
    # Mock the google-genai modules
    mock_client = Mock()
    mock_types = Mock()
    
    # Create mock function call response
    mock_function_call = Mock()
    mock_function_call.name = "search_web"
    mock_function_call.args = {"query": "test"}
    
    mock_part = Mock()
    mock_part.function_call = mock_function_call
    
    mock_candidate = Mock()
    mock_candidate.content = Mock()
    mock_candidate.content.parts = [mock_part]
    
    mock_response = Mock()
    mock_response.candidates = [mock_candidate]
    mock_response.text = None
    
    mock_client_instance = Mock()
    mock_client_instance.models.generate_content.return_value = mock_response
    
    mock_client.Client.return_value = mock_client_instance
    
    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        # Clear any cached imports
        if 'mle.model.gemini' in sys.modules:
            del sys.modules['mle.model.gemini']
        if 'mle.function' in sys.modules:
            del sys.modules['mle.function']
        
        # Mock search functions
        mock_function_module = Mock()
        mock_function_module.SEARCH_FUNCTIONS = ["search_web", "search_arxiv"]
        mock_function_module.get_function = Mock(return_value=lambda **kwargs: "search_result")
        mock_function_module.process_function_name = Mock(return_value="search_web")
        
        sys.modules['mle.function'] = mock_function_module
        
        from mle.model.gemini import GeminiModel
        
        model = GeminiModel(api_key="fake_key", model="gemini-2.5-flash")
        
        # Manually set func_call_history to simulate multiple searches
        model.func_call_history = ["search_web", "search_web", "search_web", "search_web"]
        
        chat_history = [
            {"role": "user", "content": "Search for something"}
        ]
        
        response = model.query(chat_history, functions=[{
            "name": "search_web",
            "description": "Search the web",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"}
                },
                "required": ["query"]
            }
        }])
        
        # Should hit search limit and return warning
        assert "[GEMINI WARNING]: Search function limit of" in response


