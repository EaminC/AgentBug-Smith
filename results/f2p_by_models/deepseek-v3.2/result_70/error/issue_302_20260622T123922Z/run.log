def test_gemini_query_with_function_calling():
    """
    Test query method with function calling.
    Buggy code uses different API calls and response structures.
    """
    mock_client = MagicMock()
    mock_types = MagicMock()
    mock_genai_module = MagicMock()
    mock_genai_module.client = mock_client
    mock_genai_module.types = mock_types

    mock_function = MagicMock()
    mock_function.SEARCH_FUNCTIONS = []
    mock_function.get_function = MagicMock(return_value=lambda **kwargs: 'function_result')
    mock_function.process_function_name = MagicMock(side_effect=lambda x: x)

    # Mock response with function call
    mock_response = MagicMock()
    mock_candidate = MagicMock()
    mock_content = MagicMock()
    mock_part = MagicMock()
    mock_part.function_call = MagicMock()
    mock_part.function_call.name = 'test_function'
    mock_part.function_call.args = {'arg1': 'value1'}
    mock_content.parts = [mock_part]
    mock_candidate.content = mock_content
    mock_response.candidates = [mock_candidate]
    mock_response.text = 'final response'

    # Mock second response without function call
    mock_response2 = MagicMock()
    mock_response2.candidates = [MagicMock(content=MagicMock(parts=[]))]
    mock_response2.text = 'final response'

    # Set up side effect to return function call first, then final response
    mock_client.models.generate_content.side_effect = [mock_response, mock_response2]

    with patch.dict('sys.modules', {
        'google.genai': mock_genai_module,
        'mle.function': mock_function
    }):
        sys.modules.pop('mle.model.gemini', None)
        import importlib
        import mle.model.gemini

        model = mle.model.gemini.GeminiModel(api_key='dummy_key')
        chat_history = [
            {'role': 'user', 'content': 'Hello'}
        ]
        functions = [{
            'name': 'test_function',
            'description': 'Test function',
            'parameters': {
                'type': 'object',
                'properties': {
                    'arg1': {'type': 'string', 'description': 'Argument 1'}
                },
                'required': ['arg1']
            }
        }]

        result = model.query(chat_history, functions=functions)

        # Verify the result
        assert result == 'final response'
        # Verify function was called
        mock_function.get_function.assert_called_once_with('test_function')
        # Verify generate_content was called
        assert mock_client.models.generate_content.call_count == 2
        # In buggy code, the API calls are different (gemini.GenerativeModel.start_chat.send_message)
        # So this test will fail on buggy code, pass on fixed code


