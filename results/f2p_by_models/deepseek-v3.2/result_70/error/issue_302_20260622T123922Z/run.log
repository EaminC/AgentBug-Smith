import pytest
from unittest.mock import Mock, patch

# Test for GeminiModel migration from google-generativeai to google-genai SDK
# The buggy code uses google.generativeai, fixed code uses google.genai

def test_gemini_model_initialization_with_new_sdk():
    """
    Test that GeminiModel initializes with google-genai SDK after fix.
    Buggy code will try to import google.generativeai and fail with ImportError
    when google.genai is mocked (since google.generativeai won't be found).
    """
    # Mock the new SDK modules
    mock_client = Mock()
    mock_types = Mock()
    
    # Simulate google.genai being available (new SDK)
    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        # Mock the client.Client constructor
        mock_client_instance = Mock()
        mock_client.Client.return_value = mock_client_instance
        
        # Import and instantiate GeminiModel
        # In buggy code, this will try to import google.generativeai which isn't mocked
        # and will raise ImportError
        from mle.model.gemini import GeminiModel
        
        # This line will fail in buggy code with ImportError
        model = GeminiModel(api_key="fake_key", model="gemini-2.5-flash")
        
        # In fixed code, model should be initialized with new SDK
        assert model.model == "gemini-2.5-flash"
        assert model.model_type == "Gemini"
        assert model.temperature == 0.7
        assert model.client is mock_client_instance

def test_gemini_query_with_function_calling():
    """
    Test query method with function calling.
    Fixed code uses new SDK's generate_content with different response structure.
    """
    mock_client = Mock()
    mock_types = Mock()
    
    # Setup mock response structure for new SDK
    mock_function_call = Mock()
    mock_function_call.name = "test_function"
    mock_function_call.args = {"arg1": "value1"}
    
    mock_part = Mock()
    mock_part.function_call = mock_function_call
    
    mock_content = Mock()
    mock_content.parts = [mock_part]
    
    mock_candidate = Mock()
    mock_candidate.content = mock_content
    
    mock_response = Mock()
    mock_response.candidates = [mock_candidate]
    mock_response.text = "Final response"
    
    mock_client_instance = Mock()
