from mle.model.gemini import GeminiModel


def test_gemini_model_initialization_with_new_sdk():
    """Test that GeminiModel initializes with google-genai SDK after the fix."""
    # Mock the google.genai.client and types to avoid needing real API key
    with patch('mle.model.gemini.client') as mock_client:
        with patch('mle.model.gemini.types') as mock_types:
            # Simulate a valid client instance
            mock_client_instance = Mock()
            mock_client.Client.return_value = mock_client_instance
            model = GeminiModel(api_key='fake_key', model='gemini-2.5-flash', temperature=0.7)
            # After fix, should use google-genai's Client
            mock_client.Client.assert_called_once_with(api_key='fake_key')
            assert model.client is mock_client_instance
            assert model.model == 'gemini-2.5-flash'
            assert model.temperature == 0.7
            assert model.func_call_history == []


def test_gemini_model_initialization_falls_back_to_old_sdk_in_buggy_version():
    """On buggy version, initialization uses google.generativeai and fails due to missing import.
       This test will fail on buggy version because google.generativeai is not mocked.
       After fix, it passes because the import is from google.genai.
    """
    # Remove any existing mocks to let the real import happen
    # In buggy version, it will try to import google.generativeai, which is not installed.
    # We'll let it raise ImportError, which should happen only in buggy version.
    # In fixed version, it imports google.genai, which we mock.
    with patch.dict('sys.modules', {'google.generativeai': None}):
        with patch('importlib.util.find_spec', return_value=None):
            # In buggy version, find_spec returns None, leading to ImportError
            # In fixed version, the import path is different, so this won't trigger.
            try:
                model = GeminiModel(api_key='fake_key', model='gemini-1.5-flash')
                # If we reach here, it's the fixed version (or mock succeeded).
                # Ensure it's using google-genai
                assert hasattr(model, 'client')
            except ImportError as e:
                # In buggy version, we expect ImportError about google-generativeai
                assert 'google-generativeai' in str(e)
                # Let the test fail on buggy version (as required)
                raise


