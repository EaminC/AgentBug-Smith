    mock_part.function_call.args = {"query": "test"}
    mock_candidate.content.parts = [mock_part]
    
    mock_response = Mock()
    mock_response.candidates = [mock_candidate]
    mock_response.text = "Final answer"
    
    mock_client_instance = Mock()
