def test_gemini_model_initialization_with_new_sdk():
    """
    Test that GeminiModel initializes correctly with the new google-genai SDK.
    In buggy code, it uses google.generativeai and raises ImportError if missing.
    In fixed code, it uses google.genai.client.Client.
    """
    # Mock the google.genai module and its submodules
    mock_client = Mock()
    mock_types = Mock()
    mock_types.GenerateContentConfig = Mock
    mock_types.Tool = Mock
    mock_types.FunctionDeclaration = Mock
    mock_types.Schema = Mock
    mock_types.ToolConfig = Mock
    mock_types.FunctionCallingConfig = Mock
    mock_types.Part = Mock
    mock_types.Content = Mock

    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        # In buggy code, this import will fail because google.generativeai is not mocked.
        # In fixed code, it will succeed because google.genai is mocked.
        try:
            from mle.model.gemini import GeminiModel
        except ImportError as e:
            # In buggy code, we expect an ImportError about google-generativeai
            if "google-generativeai" in str(e):
                # This is the buggy behavior: test should fail because we are mocking google.genai,
                # but the buggy code doesn't use google.genai.
                # Actually, the buggy code will raise ImportError because google.generativeai is not installed.
                # Since we are not mocking google.generativeai, the import will fail.
                # That's fine: the test will fail on buggy code (as desired).
                raise
            else:
                raise

        # If we reach here in buggy code, the import succeeded (unlikely).
        # In fixed code, we can proceed.
        model = GeminiModel(api_key="fake_key", model="gemini-2.5-flash")
        assert model.model == "gemini-2.5-flash"
        assert model.temperature == 0.7
        assert model.model_type == "Gemini"
        # In fixed code, model.client should be a mock client.
        # In buggy code, model.gemini would be something else.
        # We can check that model.client exists (fixed) or model.gemini exists (buggy).
        # Let's assert that model.client is the mock client (fixed).
        # In buggy code, model.client won't exist -> AttributeError -> test fails.
        assert model.client is not None
        # Ensure the old attribute doesn't exist (or if it does, it's not the same).
        assert not hasattr(model, 'gemini') or model.gemini is not model.client

