    def test_gemini_import_error_without_sdk():
        """
        Test that ImportError is raised when google-genai is not installed.
        Fixed code checks for google.genai, buggy code checks for google.generativeai.
        """
        # Temporarily remove google.genai from sys.modules to simulate missing package
        original_genai = sys.modules.pop('google.genai', None)
        original_generativeai = sys.modules.pop('google.generativeai', None)
    
        try:
            # Clear cached import
            sys.modules.pop('mle.model.gemini', None)
    
            # Reload the module to trigger the import error
