        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        from mle.model.gemini import GeminiModel
        
        # Test with explicit model
        model1 = GeminiModel(api_key='fake-key', model='custom-model')
        assert model1.model == 'custom-model'
        
        # Test with None model (should use default)
        model2 = GeminiModel(api_key='fake-key', model=None)
        # Buggy code: 'gemini-1.5-flash'
        # Fixed code: 'gemini-2.5-flash'
        assert model2.model == 'gemini-2.5-flash'

def test_gemini_search_function_limit():
    """
    Test that search function limit logic works with new SDK.
    """
    mock_client = Mock()
    mock_types = Mock()
    
    # Mock a function call response
    mock_function_call = Mock()
    mock_function_call.name = "search_web"
    mock_function_call.args = {"query": "test"}
    
    mock_part = Mock()
    mock_part.function_call = mock_function_call
    
    mock_candidate = Mock()
    mock_candidate.content = Mock()
    mock_candidate.content.parts = [mock_part]
    
    mock_response = Mock()
    mock_response.candidates = [mock_candidate]
    mock_response.text = None
    
    # First call returns function call, subsequent calls return text
    mock_client.models.generate_content.side_effect = [
        mock_response,  # First call: function call
        Mock(candidates=[Mock(content=Mock(parts=[]))], text="Final after limit")
    ]
    
    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        from mle.model.gemini import GeminiModel
        
        model = GeminiModel(api_key='fake-key', model='gemini-2.0-fake')
        
        # Mock helpers
        model._adapt_history_for_gemini = Mock(return_value=("", []))
        model._create_gemini_tools = Mock(return_value=[Mock()])
        
        # Mock get_function to return a search function
        with patch('mle.model.gemini.get_function') as mock_get_function:
            mock_func = Mock(return_value="search result")
            mock_get_function.return_value = mock_func
            
            with patch('mle.model.gemini.process_function_name') as mock_process:
                mock_process.return_value = "search_web"
                
                # Add search attempts to history to trigger limit
                model.func_call_history = ['search_web', 'search_web', 'search_web', 'search_web']
                
                result = model.query(
                    chat_history=[{"role": "user", "content": "test"}],
                    functions=[{"name": "search_web", "description": "test"}]
                )
                
                # Should hit search limit and return warning
                assert "[GEMINI WARNING]: Search function limit" in result

