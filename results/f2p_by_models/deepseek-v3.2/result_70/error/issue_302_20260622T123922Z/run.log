def test_gemini_import_error_without_new_sdk():
    """
    Test that ImportError is raised when google.genai is not installed.
    In buggy code, the error message mentions google-generativeai.
    In fixed code, the error message mentions google-genai.
    """
    # Simulate missing google.genai by removing it from sys.modules temporarily
    original = sys.modules.get('google.genai')
    original_client = sys.modules.get('google.genai.client')
    original_types = sys.modules.get('google.genai.types')
    try:
        sys.modules.pop('google.genai', None)
        sys.modules.pop('google.genai.client', None)
        sys.modules.pop('google.genai.types', None)
        with pytest.raises(ImportError) as excinfo:
            from mle.model.gemini import GeminiModel
        # In fixed code, the error message should mention google-genai
        # In buggy code, it mentions google-generativeai
        error_msg = str(excinfo.value)
        # The test passes on fixed code, fails on buggy code.
        # We'll assert that the error message contains 'google-genai' (fixed).
        # On buggy code, this assertion will fail because the message is about google-generativeai.
        assert 'google-genai' in error_msg
    finally:
        if original:
            sys.modules['google.genai'] = original
        if original_client:
            sys.modules['google.genai.client'] = original_client
        if original_types:
            sys.modules['google.genai.types'] = original_types

