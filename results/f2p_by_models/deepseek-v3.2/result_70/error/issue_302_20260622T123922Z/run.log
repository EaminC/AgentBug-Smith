def test_gemini_query_function_call_loop():
    """Test query method with function call loop (tool calling)."""
    with patch('mle.model.gemini.client') as mock_client:
        with patch('mle.model.gemini.types') as mock_types:
            mock_client_instance = Mock()
            mock_client.Client.return_value = mock_client_instance
            model = GeminiModel(api_key='fake_key', model='gemini-2.5-flash')
            # First call returns a function call, second returns text
            mock_response1 = Mock()
            mock_part = Mock()
            mock_part.function_call = Mock()
            mock_part.function_call.name = 'web_search'
            mock_part.function_call.args = {'query': 'Python'}
            mock_response1.candidates = [Mock()]
            mock_response1.candidates[0].content = Mock()
            mock_response1.candidates[0].content.parts = [mock_part]
            mock_response1.text = None
            mock_response2 = Mock()
            mock_response2.text = "Answer after search"
            mock_response2.candidates = [Mock()]
            mock_response2.candidates[0].content = Mock()
            mock_response2.candidates[0].content.parts = []
            mock_client_instance.models.generate_content.side_effect = [mock_response1, mock_response2]
            with patch('mle.model.gemini.get_function') as mock_get_function:
                mock_func = Mock(return_value="search result")
                mock_get_function.return_value = mock_func
                with patch('mle.model.gemini.process_function_name', return_value='web_search'):
                    chat_history = [{"role": "user", "content": "Search for Python."}]
                    functions = [{"name": "web_search", "description": "Search", "parameters": {}}]
                    result = model.query(chat_history, functions=functions)
                    # Should return final text after tool call
                    assert result == "Answer after search"
                    # Should have called generate_content twice
                    assert mock_client_instance.models.generate_content.call_count == 2


