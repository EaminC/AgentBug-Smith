import pytest
from unittest.mock import Mock, patch, MagicMock


def test_gemini_model_initialization_with_new_sdk():
    """
    Test that GeminiModel initializes with google-genai SDK after fix.
    Buggy code tries to import google.generativeai and raises ImportError.
    """
    # Mock the new SDK modules
    mock_client = Mock()
    mock_types = Mock()

    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        # In buggy code, this will try to import google.generativeai and fail
        # because we haven't mocked it. The ImportError will be raised.
        # In fixed code, it will import google.genai successfully.
        try:
            from mle.model.gemini import GeminiModel
        except ImportError as e:
            # In buggy code, we expect ImportError about google-generativeai
            assert "google-generativeai" in str(e)
            pytest.fail(f"Buggy code raised ImportError: {e}")
        
        # If we reach here in buggy code, the test should fail because
        # the buggy code should have raised ImportError.
        # But we need to make the test fail on buggy, pass on fixed.
        # Let's check if the class uses new SDK by examining __init__.
        model = GeminiModel(api_key="fake_key", model="gemini-2.5-flash")
        
        # Fixed code should have client attribute
        assert hasattr(model, 'client')
        # Fixed code should not have gemini attribute (old SDK)
        assert not hasattr(model, 'gemini')


def test_gemini_query_with_function_calling():
    """
