import pytest
from unittest.mock import Mock, patch


def test_gemini_model_initialization_with_new_sdk():
    """
    Test that GeminiModel initializes correctly with the new google-genai SDK.
    """
    mock_client = Mock()
    mock_types = Mock()

    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        # Clear any cached imports
        if 'mle.model.gemini' in sys.modules:
            del sys.modules['mle.model.gemini']

        from mle.model.gemini import GeminiModel

        api_key = "fake-api-key"
        model_name = "gemini-2.5-flash"
        temperature = 0.5

        gemini = GeminiModel(api_key=api_key, model=model_name, temperature=temperature)

        assert gemini.model == model_name
        assert gemini.model_type == 'Gemini'
        assert gemini.temperature == temperature
        assert gemini.client is not None


def test_gemini_query_with_function_calling():
    """
    Test query method with function calling using the new SDK.
    """
    mock_client = Mock()
    mock_types = Mock()
    mock_types.FunctionDeclaration = Mock
    mock_types.Schema = Mock
    mock_types.Tool = Mock
    mock_types.GenerateContentConfig = Mock
    mock_types.ToolConfig = Mock
    mock_types.FunctionCallingConfig = Mock
    mock_types.Part = Mock
    mock_types.Content = Mock

    mock_candidate = Mock()
    mock_candidate.content.parts = []
    mock_response = Mock()
    mock_response.candidates = [mock_candidate]
    mock_response.text = "Final answer"

    mock_client.models.generate_content.return_value = mock_response

    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        if 'mle.model.gemini' in sys.modules:
            del sys.modules['mle.model.gemini']

        # Mock the function module
        mock_function_module = Mock()
        mock_function_module.SEARCH_FUNCTIONS = ["search_web", "search_arxiv"]
        mock_function_module.get_function = Mock(return_value=lambda **kwargs: "search_result")
        mock_function_module.process_function_name = Mock(return_value="search_web")

        sys.modules['mle.function'] = mock_function_module

        from mle.model.gemini import GeminiModel

        api_key = "fake-api-key"
        gemini = GeminiModel(api_key=api_key)

        chat_history = [
            {"role": "user", "content": "What is the weather?"}
        ]

        functions = [
            {
                "name": "search_web",
                "description": "Search the web",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "query": {"type": "string", "description": "Search query"}
                    },
                    "required": ["query"]
                }
            }
        ]

        result = gemini.query(chat_history, functions=functions)

        assert result == "Final answer"
        assert mock_client.models.generate_content.called


def test_gemini_stream_method():
    """
    Test stream method using the new SDK.
    """
    mock_client = Mock()
    mock_types = Mock()
    mock_types.GenerateContentConfig = Mock

    mock_chunk1 = Mock()
    mock_chunk1.text = "Hello"
    mock_chunk2 = Mock()
    mock_chunk2.text = " World"
    mock_stream = [mock_chunk1, mock_chunk2]

    mock_client.models.generate_content_stream.return_value = mock_stream

    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        if 'mle.model.gemini' in sys.modules:
            del sys.modules['mle.model.gemini']

        from mle.model.gemini import GeminiModel

        api_key = "fake-api-key"
        gemini = GeminiModel(api_key=api_key)

        chat_history = [
            {"role": "user", "content": "Say hello"}
        ]

        stream_result = list(gemini.stream(chat_history))

        assert stream_result == ["Hello", " World"]
        mock_client.models.generate_content_stream.assert_called_once()


def test_gemini_import_error_without_new_sdk():
    """
    Test that ImportError is raised when google-genai is not installed.
    """
    with patch.dict('sys.modules', {
        'google.genai': None,
        'google.genai.client': None,
        'google.genai.types': None,
    }):
        if 'mle.model.gemini' in sys.modules:
            del sys.modules['mle.model.gemini']

        with pytest.raises(ImportError) as exc_info:
            from mle.model.gemini import GeminiModel
            GeminiModel(api_key="fake")

        assert "google-genai" in str(exc_info.value)


def test_gemini_default_model_change():
    """
    Test that default model changed from gemini-1.5-flash to gemini-2.5-flash.
    """
    mock_client = Mock()
    mock_types = Mock()

    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        if 'mle.model.gemini' in sys.modules:
            del sys.modules['mle.model.gemini']

        from mle.model.gemini import GeminiModel

        gemini = GeminiModel(api_key="fake")
        assert gemini.model == "gemini-2.5-flash"

        gemini_custom = GeminiModel(api_key="fake", model="custom-model")
        assert gemini_custom.model == "custom-model"


def test_gemini_search_function_limit():
    """
    Test that search function limit is enforced.
    """
    mock_client = Mock()
    mock_types = Mock()
    mock_types.FunctionDeclaration = Mock
    mock_types.Schema = Mock
    mock_types.Tool = Mock
    mock_types.GenerateContentConfig = Mock
    mock_types.ToolConfig = Mock
    mock_types.FunctionCallingConfig = Mock
    mock_types.Part = Mock
    mock_types.Content = Mock

    mock_candidate = Mock()
    mock_part = Mock()
    mock_part.function_call = Mock()
    mock_part.function_call.name = "search_web"
    mock_part.function_call.args = {"query": "test"}
    mock_candidate.content.parts = [mock_part]
    mock_response = Mock()
    mock_response.candidates = [mock_candidate]
    mock_response.text = None

    mock_client.models.generate_content.return_value = mock_response

    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        if 'mle.model.gemini' in sys.modules:
            del sys.modules['mle.model.gemini']

        mock_function_module = Mock()
        mock_function_module.SEARCH_FUNCTIONS = ["search_web", "search_arxiv"]
        mock_function_module.get_function = Mock(return_value=lambda **kwargs: "search_result")
        mock_function_module.process_function_name = Mock(return_value="search_web")

        sys.modules['mle.function'] = mock_function_module

        from mle.model.gemini import GeminiModel

        api_key = "fake-api-key"
        gemini = GeminiModel(api_key=api_key)

        chat_history = [{"role": "user", "content": "Search something"}]
        functions = [{
            "name": "search_web",
            "description": "Search web",
            "parameters": {
                "type": "object",
                "properties": {"query": {"type": "string"}},
                "required": ["query"]
            }
        }]

        gemini.func_call_history = ["search_web", "search_web", "search_web", "search_web"]

        result = gemini.query(chat_history, functions=functions)

        assert "[GEMINI WARNING]: Search function limit of" in result
        assert mock_client.models.generate_content.called


