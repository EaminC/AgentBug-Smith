def test_gemini_query_function_call_loop():
    """
    Test query method when function calling occurs and loops through tool turns.
    """
    # Mock the google.genai modules
    mock_client = MagicMock()
    mock_types = MagicMock()
    
    with patch.dict('sys.modules', {'google.genai': MagicMock()}):
        with patch('mle.model.gemini.client', mock_client):
            with patch('mle.model.gemini.types', mock_types):
                # Setup mock client
                mock_client_instance = MagicMock()
                mock_client.Client.return_value = mock_client_instance
                
                # Create a mock function call part
                mock_function_call = MagicMock()
                mock_function_call.name = "test_function"
                mock_function_call.args = {"arg1": "value1"}
                
                # First response has function call
                mock_response1 = MagicMock()
                mock_response1.text = None
                mock_response1.candidates = [MagicMock()]
                mock_response1.candidates[0].content = MagicMock()
                mock_response1.candidates[0].content.parts = [mock_function_call]
                
                # Second response has text
                mock_response2 = MagicMock()
                mock_response2.text = "Final after function"
                mock_response2.candidates = [MagicMock()]
                mock_response2.candidates[0].content = MagicMock()
                mock_response2.candidates[0].content.parts = []
                
                # Mock generate_content to return first then second response
                mock_client_instance.models.generate_content.side_effect = [mock_response1, mock_response2]
                
                # Mock process_function_name and get_function
                with patch('mle.model.gemini.process_function_name') as mock_process:
                    mock_process.return_value = "test_function"
                    with patch('mle.model.gemini.get_function') as mock_get_function:
                        mock_get_function.return_value = lambda **kwargs: "function result"
                        
                        model = GeminiModel(api_key='fake_key', model='gemini-2.5-flash')
                        
                        chat_history = [
                            {"role": "user", "content": "Call a function"}
                        ]
                        
                        result = model.query(chat_history, functions=[
                            {
                                "name": "test_function",
                                "description": "Test function",
                                "parameters": {
                                    "type": "object",
                                    "properties": {
                                        "arg1": {"type": "string", "description": "Argument 1"}
                                    },
                                    "required": ["arg1"]
                                }
                            }
                        ])
                        
                        # Should get final text
                        assert result == "Final after function"
                        # Should have called generate_content twice
                        assert mock_client_instance.models.generate_content.call_count == 2


