        del sys.modules['google.genai']
    
    # In buggy version, the code will try to import google.generativeai
    # We'll mock importlib.util.find_spec to return None to simulate missing package
    with patch('importlib.util.find_spec') as mock_find_spec:
        mock_find_spec.return_value = None
        try:
            GeminiModel(api_key='fake_key', model='gemini-1.5-flash')
            # If we reach here in buggy version, it means the import didn't raise
            # This would be a failure for buggy version
            raise AssertionError("Expected ImportError not raised")
        except ImportError as e:
            # In buggy version, error message mentions google-generativeai
            assert 'google-generativeai' in str(e)
            # In fixed version, error message mentions google-genai
            # So this assertion will fail in fixed version
            assert 'google-generativeai' in str(e)


