import os
import pytest
from unittest.mock import Mock, patch, MagicMock


def test_gemini_model_initialization_with_new_sdk():
    """
    Test that GeminiModel initializes correctly with the new google-genai SDK.
    This test should pass after the fix, but fail before because the buggy code
    tries to import google.generativeai.
    """
    # Mock the new SDK modules
    mock_client = Mock()
    mock_types = Mock()
    
    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        # Clear any cached imports
        if 'mle.model.gemini' in sys.modules:
            del sys.modules['mle.model.gemini']
        
        from mle.model.gemini import GeminiModel
        
        # Create an instance - should not raise ImportError for google.generativeai
        model = GeminiModel(api_key='fake-key', model='gemini-2.0-flash')
        
        # Verify the client is set up with the new SDK
        assert model.client is not None
        # The default model should be gemini-2.5-flash after the fix
        # but we passed a custom model, so check that
        assert model.model == 'gemini-2.0-flash'


def test_gemini_query_with_function_calling():
    """
    Test the query method with function calling using the new SDK.
    The buggy code uses old google.generativeai protos and methods.
    """
    # Mock the new SDK
    mock_client = Mock()
    mock_types = Mock()
    
    # Create mock response structure
    mock_candidate = Mock()
    mock_candidate.content = Mock()
    mock_candidate.content.parts = []
    
    mock_response = Mock()
    mock_response.candidates = [mock_candidate]
    mock_response.text = "Final response"
    
    mock_client.models.generate_content.return_value = mock_response
    
    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        # Clear any cached imports
        if 'mle.model.gemini' in sys.modules:
            del sys.modules['mle.model.gemini']
        
        from mle.model.gemini import GeminiModel
        
        model = GeminiModel(api_key='fake-key', model='gemini-2.0-flash')
        model.client = mock_client
        
        # Mock the helper methods to avoid complex setup
        model._adapt_history_for_gemini = Mock(return_value=("system", []))
        model._create_gemini_tools = Mock(return_value=[])
        
        # Test query without functions
        chat_history = [{"role": "user", "content": "Hello"}]
        result = model.query(chat_history)
        
        # Should call generate_content with the new SDK
        mock_client.models.generate_content.assert_called_once()
        assert result == "Final response"


def test_gemini_stream_method():
    """
    Test the stream method uses the new SDK's generate_content_stream.
    """
    mock_client = Mock()
    mock_types = Mock()
    
    # Mock a stream response
    mock_chunk1 = Mock()
    mock_chunk1.text = "Hello "
    mock_chunk2 = Mock()
    mock_chunk2.text = "World"
    mock_stream = [mock_chunk1, mock_chunk2]
    
    mock_client.models.generate_content_stream.return_value = mock_stream
    
    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        if 'mle.model.gemini' in sys.modules:
            del sys.modules['mle.model.gemini']
        
        from mle.model.gemini import GeminiModel
        
        model = GeminiModel(api_key='fake-key')
        model.client = mock_client
        
        # Mock the adapt history method
        model._adapt_history_for_gemini = Mock(return_value=([],))
        
        chat_history = [{"role": "user", "content": "Say hello"}]
        stream_result = list(model.stream(chat_history))
        
        # Should use generate_content_stream from new SDK
        mock_client.models.generate_content_stream.assert_called_once()
        assert stream_result == ["Hello ", "World"]


def test_gemini_import_error_without_new_sdk():
    """
    Test that ImportError is raised when google-genai is not installed.
    The buggy code checks for google.generativeai, not google.genai.
    """
    # Simulate missing google.genai module
    import google
    original_genai = getattr(google, 'genai', None)
    
    # Temporarily remove google.genai if it exists
    if hasattr(google, 'genai'):
        del google.genai
    
    try:
        # Clear the module cache
        if 'mle.model.gemini' in sys.modules:
            del sys.modules['mle.model.gemini']
        
        # This should raise ImportError about google-genai, not google-generativeai
        with pytest.raises(ImportError) as exc_info:
            from mle.model.gemini import GeminiModel
        
        # Check the error message mentions the correct package
        error_msg = str(exc_info.value)
        assert "google-genai" in error_msg or "google.genai" in error_msg
        
    finally:
        # Restore google.genai if it existed
        if original_genai is not None:
            google.genai = original_genai


def test_gemini_default_model_change():
    """
    Test that default model changed from gemini-1.5-flash to gemini-2.5-flash.
    """
    mock_client = Mock()
    mock_types = Mock()
    
    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
