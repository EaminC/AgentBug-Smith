                result = model.query(chat_history, functions=functions)
                
                # Should eventually get the final response
                assert result == "Final response"

def test_gemini_stream_method():
    """Test that stream method uses new SDK correctly."""
    mock_client = Mock()
    mock_types = Mock()
    
    with patch.dict('sys.modules', {
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        mock_client_instance = Mock()
        mock_client.Client.return_value = mock_client_instance
        
        model = GeminiModel(api_key="fake_key", model="gemini-2.5-flash")
        
        # Mock the stream response
        mock_chunk1 = Mock()
        mock_chunk1.text = "Chunk 1"
        mock_chunk2 = Mock()
        mock_chunk2.text = "Chunk 2"
        
        mock_stream = [mock_chunk1, mock_chunk2]
        mock_client_instance.models.generate_content_stream.return_value = mock_stream
        
        chat_history = [{"role": "user", "content": "Stream test"}]
        
        # Call stream method
        stream_result = list(model.stream(chat_history))
        
        # Verify streaming works
        assert stream_result == ["Chunk 1", "Chunk 2"]
        
        # The buggy version would call gemini.GenerativeModel and start_chat
        # The fixed version calls client.models.generate_content_stream
        mock_client_instance.models.generate_content_stream.assert_called_once()

def test_gemini_import_error_without_new_sdk():
    """Test that ImportError is raised when google-genai is not installed."""
    # Temporarily remove the google.genai module from sys.modules if present
    saved_modules = {}
    for mod in ['google.genai', 'google.genai.client', 'google.genai.types']:
        if mod in sys.modules:
            saved_modules[mod] = sys.modules[mod]
            del sys.modules[mod]
    
    try:
        # Try to import GeminiModel - should raise ImportError
        with pytest.raises(ImportError) as exc_info:
            from mle.model.gemini import GeminiModel
            
        # Check error message mentions google-genai (new SDK)
        assert "google-genai" in str(exc_info.value)
        
        # The buggy version would mention "google-generativeai" instead
        # This test will fail on buggy code, pass on fixed code
        assert "google-generativeai" not in str(exc_info.value)
    finally:
        # Restore modules
        sys.modules.update(saved_modules)

def test_gemini_default_model_change():
    """Test that default model changed from gemini-1.5-flash to gemini-2.5-flash."""
    mock_client = Mock()
    mock_types = Mock()
    
    with patch.dict('sys.modules', {
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        mock_client_instance = Mock()
        mock_client.Client.return_value = mock_client_instance
        
        # Test with no model specified - should use new default
        model = GeminiModel(api_key="fake_key")
        assert model.model == "gemini-2.5-flash"
        
        # Test with explicit model
        model2 = GeminiModel(api_key="fake_key", model="custom-model")
        assert model2.model == "custom-model"
        
        # The buggy version would default to 'gemini-1.5-flash'
        # This assertion will fail on buggy code, pass on fixed code
        assert model.model != "gemini-1.5-flash"

