from unittest.mock import MagicMock, patch, call


def test_gemini_import_error_without_sdk():
    """
    Test that ImportError is raised when google-genai is not installed.
    Buggy code imports google.generativeai, fixed code imports google.genai.
    """
    # Remove google.genai from sys.modules to simulate missing package
    with patch.dict('sys.modules', {'google.genai': None, 'google.generativeai': None}):
        sys.modules.pop('mle.model.gemini', None)
        with pytest.raises(ImportError) as exc_info:
            import mle.model.gemini
        # Check error message mentions google-genai (new SDK) not google-generativeai (old SDK)
        error_msg = str(exc_info.value)
        assert "google-genai" in error_msg
        # In buggy code, the error mentions google-generativeai, not google-genai
        # So this test will fail on buggy code, pass on fixed code


