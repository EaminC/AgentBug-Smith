def test_gemini_import_error_without_sdk():
    """
    Test that ImportError is raised when google-genai is not installed.
    This test should pass in both buggy and fixed versions because both have import checks.
    """
    # Temporarily remove google.genai from sys.modules to simulate missing package
    original_genai = sys.modules.pop('google.genai', None)
    original_generativeai = sys.modules.pop('google.generativeai', None)
    try:
        # Clear cached import
        sys.modules.pop('mle.model.gemini', None)

        # Reload the module to trigger the import error
        import importlib
        with pytest.raises(ImportError) as exc_info:
            import mle.model.gemini

        # Both versions should raise ImportError with helpful message
        error_msg = str(exc_info.value).lower()
        # Fixed version mentions 'google-genai', buggy version mentions 'google-generativeai'
        assert 'google' in error_msg or 'genai' in error_msg or 'gemini' in error_msg
    finally:
        # Restore original modules
        if original_genai is not None:
            sys.modules['google.genai'] = original_genai
        if original_generativeai is not None:
            sys.modules['google.generativeai'] = original_generativeai

