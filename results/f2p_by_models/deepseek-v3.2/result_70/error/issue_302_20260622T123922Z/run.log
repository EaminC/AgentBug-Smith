def test_gemini_import_error_without_sdk():
    """
    Test that ImportError is raised when the required SDK is not installed.
    In buggy code, the import checks for 'google.generativeai'.
    In fixed code, the import checks for 'google.genai'.
    This test should pass in both cases because the error messages differ,
    but we can make it fail on buggy code by checking the error message.
    """
    # Remove the modules from sys.modules to simulate missing packages
    original_genai = sys.modules.pop('google.genai', None)
    original_generativeai = sys.modules.pop('google.generativeai', None)
    original_mle_gemini = sys.modules.pop('mle.model.gemini', None)

    try:
        # Reload the module to trigger the import error
        with pytest.raises(ImportError) as exc_info:
            import mle.model.gemini
        error_msg = str(exc_info.value).lower()
        # The fixed code error message mentions 'google-genai' (with dash)
        # Buggy code error message mentions 'google-generativeai' (with dash)
        # We'll assert that the error message contains 'google-genai' (fixed version)
        # This will fail on buggy code because it says 'google-generativeai'
        assert 'google-genai' in error_msg or 'google-genai' in error_msg.replace('_', '-')
    finally:
        # Restore original modules
        if original_genai is not None:
            sys.modules['google.genai'] = original_genai
        if original_generativeai is not None:
            sys.modules['google.generativeai'] = original_generativeai
        if original_mle_gemini is not None:
            sys.modules['mle.model.gemini'] = original_mle_gemini

