    with patch('mle.model.gemini.types') as mock_types:
        model = GeminiModel(api_key='fake_key', model='gemini-2.5-flash')
        functions = [
            {
                "name": "func1",
                "description": "Test function",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "arg1": {"type": "string", "description": "Argument 1"}
                    },
                    "required": ["arg1"]
                }
            }
        ]
        # Mock the types.Schema and FunctionDeclaration
        mock_schema = Mock()
        mock_types.Schema.return_value = mock_schema
        mock_declaration = Mock()
        mock_types.FunctionDeclaration.return_value = mock_declaration
        tools = model._create_gemini_tools(functions)
        # Should return a list of Tool objects
        assert tools is not None
        # In fixed version, it returns a list of Tool
        mock_types.FunctionDeclaration.assert_called_once()
        mock_types.Schema.assert_called_once_with(
            type='OBJECT',
            properties={'arg1': mock_schema},
            required=['arg1']
        )


def test_gemini_adapt_history_for_gemini():
    """Test _adapt_history_for_gemini helper method."""
    model = GeminiModel(api_key='fake_key', model='gemini-2.5-flash')
    chat_history = [
        {"role": "system", "content": "Be helpful."},
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there"},
        {"role": "user", "content": "How are you?"}
    ]
    system, prompt = model._adapt_history_for_gemini(chat_history)
    assert system == "Be helpful."
    assert len(prompt) == 3
    assert prompt[0]['role'] == 'user'
    assert prompt[0]['parts'][0]['text'] == "Hello"
    assert prompt[1]['role'] == 'model'
    assert prompt[1]['parts'][0]['text'] == "Hi there"
    assert prompt[2]['role'] == 'user'
    assert prompt[2]['parts'][0]['text'] == "How are you?"


def test_gemini_query_exceeds_search_limit():
    """Test query method when search limit is exceeded."""
    with patch('mle.model.gemini.client') as mock_client:
        with patch('mle.model.gemini.types') as mock_types:
            mock_client_instance = Mock()
            mock_client.Client.return_value = mock_client_instance
            model = GeminiModel(api_key='fake_key', model='gemini-2.5-flash')
            # Mock response that always returns a function call
            mock_part = Mock()
            mock_part.function_call = Mock()
            mock_part.function_call.name = 'web_search'
            mock_part.function_call.args = {'query': 'test'}
            mock_response = Mock()
            mock_response.candidates = [Mock()]
            mock_response.candidates[0].content = Mock()
            mock_response.candidates[0].content.parts = [mock_part]
            mock_response.text = None
            mock_client_instance.models.generate_content.return_value = mock_response
            with patch('mle.model.gemini.get_function') as mock_get_function:
                mock_func = Mock(return_value="search result")
                mock_get_function.return_value = mock_func
                with patch('mle.model.gemini.process_function_name', return_value='web_search'):
                    with patch('mle.model.gemini.SEARCH_FUNCTIONS', {'web_search'}):
                        chat_history = [{"role": "user", "content": "Search."}]
                        functions = [{"name": "web_search", "description": "Search", "parameters": {}}]
                        # Force func_call_history to have 4 search attempts
                        model.func_call_history = ['web_search', 'web_search', 'web_search', 'web_search']
                        result = model.query(chat_history, functions=functions)
                        # Should return warning about search limit
                        assert "[GEMINI WARNING]: Search function limit" in result
                        # generate_content should not be called because limit exceeded before call
                        assert not mock_client_instance.models.generate_content.called


