def test_gemini_model_initialization_with_new_sdk():
    """
    Test that GeminiModel initializes with google-genai SDK after fix,
    and fails with google-generativeai before fix.
    """
    # Mock the google-genai modules that the fixed code imports
    mock_genai = Mock()
    mock_client = Mock()
    mock_types = Mock()
    
    # Simulate the buggy code's import of google.generativeai
    # In buggy code, the import is inside __init__, not at top level.
    # We need to simulate the import error that occurs when google-genai is missing.
    with patch.dict('sys.modules', {
        'google.genai': mock_genai,
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
        'google.generativeai': None,  # Simulate not installed
    }):
        # In buggy code, the import of google.generativeai happens inside __init__
        # via importlib.import_module. We need to mock that.
        import importlib
        original_import_module = importlib.import_module
        
        def mock_import_module(name):
            if name == 'google.generativeai':
                raise ImportError("No module named 'google.generativeai'")
            return original_import_module(name)
        
        with patch('importlib.import_module', side_effect=mock_import_module):
            # Now import the module under test
            from mle.model.gemini import GeminiModel
            
            # Create instance - should succeed with google-genai mocked
            model = GeminiModel(api_key='fake-key', model='gemini-2.0-fake')
            
            # Verify the model uses the new SDK's client
            # In buggy code, self.gemini would be the google.generativeai module
            # In fixed code, self.client is a google.genai.client.Client instance
            # We can check that self.client exists (new) and self.gemini does not (old)
            assert hasattr(model, 'client')
            assert not hasattr(model, 'gemini')  # old attribute should not exist
            
            # Verify default model changed from gemini-1.5-flash to gemini-2.5-flash
            assert model.model == 'gemini-2.5-flash'  # fixed default

def test_gemini_query_with_function_calling():
    """
    Test the query method with function calling.
    Buggy code uses old SDK's protos and different method names.
    """
    # Mock the google-genai SDK
    mock_client = Mock()
    mock_types = Mock()
    
    # Create mock response structure for new SDK
    mock_candidate = Mock()
    mock_candidate.content = Mock()
    mock_candidate.content.parts = []
    
    mock_response = Mock()
    mock_response.candidates = [mock_candidate]
    mock_response.text = "Final answer"
    
    mock_client.models.generate_content.return_value = mock_response
    
    with patch.dict('sys.modules', {
        'google.genai': Mock(),
        'google.genai.client': mock_client,
        'google.genai.types': mock_types,
    }):
        from mle.model.gemini import GeminiModel
        
        model = GeminiModel(api_key='fake-key', model='gemini-2.0-fake')
        
        # Mock the internal helper methods that would be called
        model._adapt_history_for_gemini = Mock(return_value=("system", []))
        model._create_gemini_tools = Mock(return_value=[Mock()])
        
        # Mock get_function to avoid external dependencies
        with patch('mle.model.gemini.get_function') as mock_get_function:
            mock_func = Mock(return_value="search result")
            mock_get_function.return_value = mock_func
            
            # Mock process_function_name
            with patch('mle.model.gemini.process_function_name') as mock_process:
                mock_process.return_value = "search_web"
                
                # Test query without function calling
