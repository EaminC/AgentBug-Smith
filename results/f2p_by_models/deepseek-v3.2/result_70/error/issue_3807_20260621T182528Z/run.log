# Let's re-evaluate: The instruction says "CRITICAL: The JavaScript project metadata was found in: ./."
# But the files show pyproject.toml and poetry.lock, not package.json.
# However, there is a src/frontend/package.json for the frontend.
# The main project is Python, but there is a frontend JavaScript part.
# The Dockerfile must be for the JavaScript project? The orchestrator expects a JavaScript test environment.
# Since the prompt says "JavaScript project", we must assume the frontend is the target.
# We'll set WORKDIR to /app/src/frontend where the package.json is.

WORKDIR /app/src/frontend

# Install frontend dependencies (including dev dependencies for testing)
RUN if [ -f package-lock.json ]; then \
        npm ci; \
    else \
        npm install; \
    fi

# The frontend uses Playwright for tests (as seen in workflows). Install playwright browsers.
RUN npx playwright install --with-deps chromium

# Install the project (if it's a workspace or has a build step)
# The frontend likely doesn't need to be "installed" as a module; tests are run via playwright.
# However, to satisfy the instruction "install the local repository itself", we do npm install (already done).

# Set up environment for running tests (if any)
# The frontend tests are run via `npm run test` or `npx playwright test`.
# We'll set the command to run the tests (but the final CMD should be bash for the test harness).
# The orchestrator will inject test scripts; we just need to ensure the environment is ready.

# Preflight check: verify node and playwright are available
RUN node --version && npx playwright --version

# Switch back to root for the final CMD
WORKDIR /app

# Final command (as required by test harness)
