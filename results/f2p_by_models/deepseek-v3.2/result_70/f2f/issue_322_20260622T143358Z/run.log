class TestTokenUsageTracking(unittest.TestCase):
    def test_token_usage_dataclass_not_in_buggy(self):
        """TokenUsage dataclass is only added by the fix."""
        # In buggy code, TokenUsage does not exist.
        # This test will fail on buggy code because TokenUsage is not defined.
        # After fix, TokenUsage exists and import succeeds.
        try:
            from gpt_engineer.ai import TokenUsage
        except ImportError:
            # Buggy code: TokenUsage not defined -> raise AssertionError to fail test
            self.fail("TokenUsage dataclass missing (buggy code)")

    def test_ai_initializes_tokenizer(self):
        """AI should have a tokenizer attribute after initialization."""
        ai = AI(model="gpt-4")
        # In buggy code, tokenizer is not initialized.
        # After fix, tokenizer is set.
        if not hasattr(ai, "tokenizer"):
            self.fail("tokenizer attribute missing (buggy code)")
        # Ensure tokenizer is callable (has encode method)
        self.assertTrue(callable(ai.tokenizer.encode))

    def test_start_method_accepts_step_name(self):
        """AI.start should accept step_name parameter."""
        import inspect
        sig = inspect.signature(AI.start)
        # In buggy code, start signature is (self, system, user).
        # After fix, it's (self, system, user, step_name).
        params = list(sig.parameters.keys())
        if "step_name" not in params:
            self.fail("start method missing step_name parameter (buggy code)")

    def test_next_method_accepts_step_name(self):
        """AI.next should accept step_name keyword-only parameter."""
        import inspect
        sig = inspect.signature(AI.next)
        params = list(sig.parameters.keys())
        # In buggy code, next signature is (self, messages, prompt=None).
        # After fix, it's (self, messages, prompt=None, *, step_name=None).
        if "step_name" not in params:
            self.fail("next method missing step_name parameter (buggy code)")
        # Check it's keyword-only
        param = sig.parameters["step_name"]
        if param.kind != inspect.Parameter.KEYWORD_ONLY:
            self.fail("step_name should be keyword-only (buggy code)")

    def test_update_token_usage_log_called(self):
        """update_token_usage_log should be called after each completion."""
        ai = AI(model="gpt-4")
        # In buggy code, update_token_usage_log does not exist.
        # After fix, it exists and is called.
        if not hasattr(ai, "update_token_usage_log"):
            self.fail("update_token_usage_log method missing (buggy code)")
        # Mock the OpenAI call to avoid network.
        with patch("openai.chat.completions.create") as mock_create:
            mock_create.return_value = MagicMock(
                choices=[MagicMock(message=MagicMock(content="Response"))]
            )
