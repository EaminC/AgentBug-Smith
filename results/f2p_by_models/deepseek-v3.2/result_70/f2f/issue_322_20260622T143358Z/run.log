        assert lines[0] == "step_name,prompt_tokens_in_step,completion_tokens_in_step,total_tokens_in_step,total_prompt_tokens,total_completion_tokens,total_tokens"
        assert lines[1].startswith("step1,")
        assert lines[2].startswith("step2,")


