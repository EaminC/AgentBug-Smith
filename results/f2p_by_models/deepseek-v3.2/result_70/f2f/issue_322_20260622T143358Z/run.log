    input_data = {"prompt": "Test prompt", "feedback": "Test feedback"}
    return DBs(memory, logs, workspace, preprompts, input_data)


def test_token_usage_log_initialization(ai_instance):
    # In buggy code, cumulative_prompt_tokens attribute does not exist
    # In fixed code, it is initialized to 0
    # This test will fail on buggy code because attribute is missing
    assert hasattr(ai_instance, "cumulative_prompt_tokens")
    assert ai_instance.cumulative_prompt_tokens == 0
    assert hasattr(ai_instance, "cumulative_completion_tokens")
    assert ai_instance.cumulative_completion_tokens == 0
    assert hasattr(ai_instance, "cumulative_total_tokens")
    assert ai_instance.cumulative_total_tokens == 0
    assert hasattr(ai_instance, "token_usage_log")
    assert ai_instance.token_usage_log == []


def test_start_method_signature(ai_instance):
    # In buggy code, start() takes 2 arguments (system, user)
    # In fixed code, start() takes 3 arguments (system, user, step_name)
    # This test will fail on buggy code because step_name is missing
    with patch.object(ai_instance, "next", return_value=[]) as mock_next:
        result = ai_instance.start("system", "user", step_name="test_step")
        mock_next.assert_called_once()
        # Check that step_name was passed to next
        call_args = mock_next.call_args
        assert "step_name" in call_args.kwargs
        assert call_args.kwargs["step_name"] == "test_step"


def test_next_method_signature(ai_instance, mock_openai):
    # In buggy code, next() does not accept step_name keyword argument
    # In fixed code, next() accepts step_name keyword argument
    # This test will fail on buggy code because step_name is unexpected
    messages = [{"role": "user", "content": "Hello"}]
    result = ai_instance.next(messages, step_name="test_step")
