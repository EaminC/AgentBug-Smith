        assert isinstance(log_entry, TokenUsage)


def test_token_usage_log_updated_after_next(ai_instance, mock_openai):
    # In buggy code, token_usage_log is not updated after next()
    # In fixed code, token_usage_log is updated
    messages = [{"role": "user", "content": "Test message"}]
    ai_instance.next(messages, step_name="test_step")
    # This assertion will fail on buggy code because token_usage_log doesn't exist
    # or is not updated
    assert len(ai_instance.token_usage_log) == 1
    log_entry = ai_instance.token_usage_log[0]
    assert log_entry.step_name == "test_step"
    assert log_entry.in_step_prompt_tokens > 0
    assert log_entry.in_step_completion_tokens > 0
    assert log_entry.in_step_total_tokens > 0
    assert log_entry.total_prompt_tokens > 0
    assert log_entry.total_completion_tokens > 0
    assert log_entry.total_tokens > 0


def test_format_token_usage_log(ai_instance, mock_openai):
    # In buggy code, format_token_usage_log() method does not exist
    # In fixed code, it exists and returns a CSV string
    # This test will fail on buggy code because method is missing
    messages = [{"role": "user", "content": "Test"}]
    ai_instance.next(messages, step_name="step1")
    ai_instance.next(messages, step_name="step2")
    formatted = ai_instance.format_token_usage_log()
    assert isinstance(formatted, str)
    assert "step_name" in formatted
    assert "step1" in formatted
    assert "step2" in formatted
    # Check CSV structure
    lines = formatted.strip().split("\n")
    assert len(lines) == 3  # header + 2 steps
    assert lines[0].startswith("step_name,")


