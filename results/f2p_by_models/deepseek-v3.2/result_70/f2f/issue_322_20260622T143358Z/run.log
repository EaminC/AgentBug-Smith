from gpt_engineer.db import DBs


class TestTokenUsageTracking(unittest.TestCase):
    def test_token_usage_dataclass_exists(self):
        """TokenUsage dataclass should be defined."""
        # This import will fail on buggy code because TokenUsage is not defined.
        # In fixed code, it exists.
        self.assertTrue(hasattr(AI, "__annotations__"))  # just to ensure AI is loaded
        # The dataclass is defined inside ai module.
        # We'll instantiate it to verify.
        usage = TokenUsage(
            step_name="test",
            in_step_prompt_tokens=10,
            in_step_completion_tokens=20,
            in_step_total_tokens=30,
            total_prompt_tokens=10,
            total_completion_tokens=20,
            total_tokens=30,
        )
        self.assertEqual(usage.step_name, "test")
        self.assertEqual(usage.in_step_prompt_tokens, 10)

    def test_ai_initializes_token_counts(self):
        """AI should initialize cumulative token counts and tokenizer."""
        ai = AI(model="gpt-4")
        # In buggy code, these attributes don't exist.
        # In fixed code, they do.
        self.assertTrue(hasattr(ai, "cumulative_prompt_tokens"))
        self.assertTrue(hasattr(ai, "cumulative_completion_tokens"))
        self.assertTrue(hasattr(ai, "cumulative_total_tokens"))
        self.assertTrue(hasattr(ai, "token_usage_log"))
        self.assertTrue(hasattr(ai, "tokenizer"))
        self.assertEqual(ai.cumulative_prompt_tokens, 0)
        self.assertEqual(ai.cumulative_completion_tokens, 0)
        self.assertEqual(ai.cumulative_total_tokens, 0)
        self.assertEqual(len(ai.token_usage_log), 0)

    def test_start_method_accepts_step_name(self):
        """AI.start should accept step_name parameter."""
        ai = AI(model="gpt-4")
        # Mock the internal openai client to avoid real API calls.
        with patch.object(ai, "next") as mock_next:
            mock_next.return_value = []
            # In buggy code, start signature is start(system, user).
            # In fixed code, start(system, user, step_name).
            # We'll call with step_name and see if it's accepted.
            try:
                ai.start("system", "user", step_name="test_step")
                # If we reach here, step_name was accepted.
                mock_next.assert_called_once()
                # Check that step_name was passed to next.
                call_kwargs = mock_next.call_args[1]
                self.assertIn("step_name", call_kwargs)
                self.assertEqual(call_kwargs["step_name"], "test_step")
            except TypeError as e:
                if "step_name" in str(e):
                    # Buggy code: step_name not accepted.
                    self.fail("AI.start does not accept step_name parameter.")
                else:
                    raise

    def test_next_method_accepts_step_name(self):
        """AI.next should accept step_name keyword-only argument."""
        ai = AI(model="gpt-4")
        # In buggy code, next signature is next(messages, prompt=None).
        # In fixed code, next(messages, prompt=None, *, step_name=None).
        # We'll call next with step_name and see if it's accepted.
        # Mock the OpenAI API call using the new openai>=1.0.0 interface.
        with patch("openai.chat.completions.create") as mock_create:
            mock_create.return_value = MagicMock(
                choices=[MagicMock(message=MagicMock(content="Response"))]
            )
            messages = [{"role": "user", "content": "Hello"}]
            # In buggy code, passing step_name will raise TypeError.
            # In fixed code, it will be accepted.
            try:
                result = ai.next(messages, step_name="test_step")
                # If we reach here, step_name was accepted.
                # Ensure the token usage log was updated.
                self.assertEqual(len(ai.token_usage_log), 1)
                self.assertEqual(ai.token_usage_log[0].step_name, "test_step")
            except TypeError as e:
                if "step_name" in str(e):
                    # Buggy code: step_name not accepted.
                    self.fail("AI.next does not accept step_name parameter.")
                else:
                    raise

    def test_update_token_usage_log_called(self):
        """update_token_usage_log should be called after each completion."""
        ai = AI(model="gpt-4")
        original_update = ai.update_token_usage_log
        call_count = 0

        def counting_update(*args, **kwargs):
            nonlocal call_count
            call_count += 1
            return original_update(*args, **kwargs)

        ai.update_token_usage_log = counting_update
        messages = [
            {"role": "system", "content": "Test"},
            {"role": "user", "content": "Test user"},
        ]
        # Mock the OpenAI API call using new openai>=1.0.0 interface.
        with patch("openai.chat.completions.create") as mock_create:
            mock_create.return_value = MagicMock(
                choices=[MagicMock(message=MagicMock(content="Response"))]
            )
            # Mock tokenizer to avoid real tokenization.
            ai.tokenizer.encode = MagicMock(return_value=[])
            ai.next(messages, step_name="test_step")
        # In buggy code, update_token_usage_log doesn't exist, so we'd have AttributeError earlier.
        # In fixed code, it should be called once.
        self.assertEqual(call_count, 1)

    def test_token_counts_accumulate(self):
        """Cumulative token counts should increase across multiple calls."""
        ai = AI(model="gpt-4")
        messages = [
            {"role": "system", "content": "Sys"},
            {"role": "user", "content": "User 1"},
        ]
        # Mock OpenAI API using new interface.
        with patch("openai.chat.completions.create") as mock_create:
            mock_create.return_value = MagicMock(
                choices=[MagicMock(message=MagicMock(content="Response 1"))]
            )
            # Mock tokenizer to return deterministic token counts.
            ai.tokenizer.encode = MagicMock(side_effect=lambda x: list(range(len(x))))
            ai.next(messages, step_name="step1")
            # After first call, cumulative counts should be positive.
            self.assertGreater(ai.cumulative_total_tokens, 0)
            first_total = ai.cumulative_total_tokens
            # Second call.
            ai.next(messages, step_name="step2")
            self.assertGreater(ai.cumulative_total_tokens, first_total)

    def test_format_token_usage_log(self):
        """format_token_usage_log should produce CSV-like output."""
        ai = AI(model="gpt-4")
        # Add a dummy token usage entry.
        ai.token_usage_log.append(
            TokenUsage(
                step_name="test_step",
                in_step_prompt_tokens=5,
                in_step_completion_tokens=7,
                in_step_total_tokens=12,
                total_prompt_tokens=5,
                total_completion_tokens=7,
                total_tokens=12,
            )
        )
        output = ai.format_token_usage_log()
        # In buggy code, format_token_usage_log doesn't exist.
        # In fixed code, it returns a string with headers.
        self.assertIn("step_name", output)
        self.assertIn("test_step", output)
        self.assertIn("5", output)
        self.assertIn("7", output)
        self.assertIn("12", output)

    def test_num_tokens_from_messages(self):
        """num_tokens_from_messages should compute token count."""
        ai = AI(model="gpt-4")
        ai.tokenizer.encode = MagicMock(side_effect=lambda x: list(range(len(x))))
        messages = [
            {"role": "system", "content": "Hello"},
            {"role": "user", "content": "Hi there"},
        ]
        # Each message adds 4 tokens overhead, each content adds len(content) tokens.
        # Total = 4*2 + len("Hello") + len("Hi there") + 2 (for final assistant priming)
        # Mock encode returns len(content) each call.
        tokens = ai.num_tokens_from_messages(messages)
        # Expected: 4*2 + 5 + 8 + 2 = 8 + 5 + 8 + 2 = 23
        self.assertEqual(tokens, 23)

    def test_steps_pass_step_name(self):
        """All step functions should pass step_name to AI methods."""
        # This test will fail on buggy code because step_name parameter missing.
        # We'll import steps and check that curr_fn is defined and used.
        self.assertTrue(hasattr(curr_fn, "__call__"))
