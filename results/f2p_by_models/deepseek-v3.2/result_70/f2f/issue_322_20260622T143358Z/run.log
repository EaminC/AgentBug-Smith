            )
            # Mock tokenizer to avoid real tokenization.
            ai.tokenizer.encode = MagicMock(return_value=[])
            ai.next(messages, step_name="test_step")
        self.assertEqual(call_count, 1)

    def test_token_counts_accumulate(self):
        """Cumulative token counts should increase across multiple calls."""
        ai = AI(model="gpt-4")
        messages = [
            {"role": "system", "content": "Sys"},
            {"role": "user", "content": "User 1"},
        ]
        # Mock OpenAI API using new interface.
        with patch("openai.chat.completions.create") as mock_create:
            mock_create.return_value = MagicMock(
                choices=[MagicMock(message=MagicMock(content="Response 1"))]
            )
            # Mock tokenizer to return deterministic token counts.
            ai.tokenizer.encode = MagicMock(side_effect=lambda x: list(range(len(x))))
            ai.next(messages, step_name="step1")
        self.assertEqual(ai.cumulative_prompt_tokens, 23)  # computed by mocked tokenizer
        self.assertEqual(len(ai.token_usage_log), 1)
        self.assertEqual(ai.token_usage_log[0].step_name, "step1")
        self.assertEqual(ai.token_usage_log[0].total_tokens, ai.cumulative_total_tokens)

        # Second call
        messages2 = [
            {"role": "system", "content": "Sys2"},
            {"role": "user", "content": "User 2"},
        ]
        with patch("openai.chat.completions.create") as mock_create:
            mock_create.return_value = MagicMock(
                choices=[MagicMock(message=MagicMock(content="Response 2"))]
            )
            ai.next(messages2, step_name="step2")
        self.assertEqual(len(ai.token_usage_log), 2)
        self.assertEqual(ai.token_usage_log[1].step_name, "step2")
        # Cumulative counts should be greater than after first call.
        self.assertGreater(ai.cumulative_total_tokens, ai.token_usage_log[0].total_tokens)

