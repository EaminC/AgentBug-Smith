class TestTokenUsageTracking(unittest.TestCase):
    def test_token_usage_dataclass_not_in_buggy(self):
        """TokenUsage dataclass is only added by the fix."""
        # In buggy code, TokenUsage does not exist.
        # This test will fail on buggy code because TokenUsage is not defined.
        # After fix, TokenUsage exists and import succeeds.
        try:
            from gpt_engineer.ai import TokenUsage
        except ImportError:
            # Buggy code: TokenUsage not defined -> raise AssertionError to fail test
            self.fail("TokenUsage dataclass missing (buggy code)")

    def test_start_method_accepts_step_name(self):
        """AI.start should accept step_name parameter after fix."""
        ai = AI(model="gpt-4")
        # In buggy code, start signature is start(self, system, user)
        # In fixed code, signature is start(self, system, user, step_name)
        # We'll inspect the signature.
        import inspect
        sig = inspect.signature(ai.start)
        params = list(sig.parameters.keys())
        # After fix, parameters are ['self', 'system', 'user', 'step_name']
        # In buggy code, only ['self', 'system', 'user']
        if "step_name" not in params:
            self.fail("AI.start missing step_name parameter (buggy code)")

    def test_next_method_accepts_step_name(self):
        """AI.next should accept step_name keyword-only parameter after fix."""
        ai = AI(model="gpt-4")
        import inspect
        sig = inspect.signature(ai.next)
        params = list(sig.parameters.keys())
        # After fix, parameters include 'step_name' as keyword-only.
        # In buggy code, step_name is not present.
        if "step_name" not in params:
            self.fail("AI.next missing step_name parameter (buggy code)")

    def test_update_token_usage_log_called(self):
        """update_token_usage_log should be called after each completion."""
        ai = AI(model="gpt-4")
        # In buggy code, update_token_usage_log does not exist.
        # After fix, it exists and is called.
        if not hasattr(ai, "update_token_usage_log"):
            self.fail("update_token_usage_log method missing (buggy code)")
        # Mock the OpenAI call to avoid network.
        with patch("openai.chat.completions.create") as mock_create:
            mock_create.return_value = MagicMock(
                choices=[MagicMock(message=MagicMock(content="Response"))]
            )
            # Also mock tokenizer to avoid real encoding.
            ai.tokenizer.encode = MagicMock(return_value=[])
            messages = [
                {"role": "system", "content": "Test"},
                {"role": "user", "content": "Test user"},
            ]
            # Count calls to update_token_usage_log
            original_update = ai.update_token_usage_log
            call_count = 0
            def counting_update(*args, **kwargs):
                nonlocal call_count
                call_count += 1
                return original_update(*args, **kwargs)
            ai.update_token_usage_log = counting_update
            ai.next(messages, step_name="test_step")
            self.assertEqual(call_count, 1, "update_token_usage_log not called")

    def test_token_counts_accumulate(self):
        """Cumulative token counts should increase across multiple calls."""
        ai = AI(model="gpt-4")
        # Mock tokenizer to return deterministic token counts
        ai.tokenizer.encode = MagicMock(side_effect=lambda x: list(range(len(x))))
        # Mock OpenAI call
        with patch("openai.chat.completions.create") as mock_create:
            mock_create.return_value = MagicMock(
                choices=[MagicMock(message=MagicMock(content="Response 1"))]
            )
            messages = [
                {"role": "system", "content": "Sys"},
                {"role": "user", "content": "User 1"},
            ]
            ai.next(messages, step_name="step1")
            # After first call, cumulative totals should be >0
            self.assertGreater(ai.cumulative_total_tokens, 0)
            first_total = ai.cumulative_total_tokens
            # Second call
            messages2 = [
                {"role": "system", "content": "Sys2"},
                {"role": "user", "content": "User 2"},
            ]
            ai.next(messages2, step_name="step2")
            self.assertGreater(ai.cumulative_total_tokens, first_total)

    def test_num_tokens_from_messages(self):
        """num_tokens_from_messages should compute token count."""
        ai = AI(model="gpt-4")
        # Mock tokenizer to return len(content) as token count
        ai.tokenizer.encode = MagicMock(side_effect=lambda x: list(range(len(x))))
        messages = [
            {"role": "system", "content": "Hello"},
            {"role": "user", "content": "Hi there"},
        ]
        tokens = ai.num_tokens_from_messages(messages)
        # Expected: each message adds 4 overhead, each content adds len(content) tokens.
        # Plus 2 for final assistant priming.
        # Mock encode returns list of length len(content), so num_tokens returns len(content).
        # Overhead: 4 * 2 = 8
        # Content tokens: len("Hello") + len("Hi there") = 5 + 8 = 13
        # Final assistant priming: 2
        # Total = 8 + 13 + 2 = 23
        self.assertEqual(tokens, 23)

