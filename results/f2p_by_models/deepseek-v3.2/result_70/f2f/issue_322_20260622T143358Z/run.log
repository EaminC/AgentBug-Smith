        # Since we cannot import each step individually without running them,
        # we'll just ensure that the curr_fn helper works.
        # In buggy code, curr_fn is not defined in steps.py.
        # In fixed code, it is.
        self.assertEqual(curr_fn(), "test_steps_pass_step_name")

    def test_main_writes_token_usage_to_logs(self):
        """main should write token usage CSV to dbs.logs['token_usage']."""
        # Create a temporary project directory.
        with tempfile.TemporaryDirectory() as tmpdir:
            input_dir = os.path.join(tmpdir, "input")
            workspace_dir = os.path.join(tmpdir, "workspace")
            memory_dir = os.path.join(tmpdir, "memory")
            logs_dir = os.path.join(tmpdir, "logs")
            preprompts_dir = os.path.join(tmpdir, "preprompts")
            for d in [input_dir, workspace_dir, memory_dir, logs_dir, preprompts_dir]:
                os.makedirs(d)
            # Write a minimal prompt.
            with open(os.path.join(input_dir, "prompt"), "w") as f:
                f.write("Create a hello world program.")
            # Write a minimal preprompt for generate step.
            with open(os.path.join(preprompts_dir, "generate"), "w") as f:
                f.write("You are a helpful assistant.")
            # Create DBs.
            dbs = DBs(
                input=input_dir,
                workspace=workspace_dir,
                memory=memory_dir,
                logs=logs_dir,
                preprompts=preprompts_dir,
            )
            # Mock the AI to avoid real API calls.
            with patch("gpt_engineer.main.AI") as MockAI:
                mock_ai_instance = MagicMock()
                mock_ai_instance.format_token_usage_log.return_value = "step_name,...\ntest,1,2,3,4,5,6"
                MockAI.return_value = mock_ai_instance
                # Mock steps to avoid actual generation.
                with patch("gpt_engineer.main.steps") as mock_steps:
                    mock_steps.simple_gen.return_value = []
                    # Run main with minimal args.
                    try:
                        main(
                            project_path=tmpdir,
                            model="gpt-4",
                            temperature=0.1,
                            steps_config="simple",
                        )
                    except SystemExit:
                        pass  # main calls typer.exit()
                # Check that format_token_usage_log was called.
                mock_ai_instance.format_token_usage_log.assert_called_once()
                # In buggy code, dbs.logs["token_usage"] is not set.
                # In fixed code, it is set.
                self.assertIn("token_usage", dbs.logs)
                self.assertEqual(dbs.logs["token_usage"], "step_name,...\ntest,1,2,3,4,5,6")

    def test_tokenizer_fallback(self):
        """AI should fall back to cl100k_base if model encoding not found."""
        with patch("tiktoken.encoding_for_model") as mock_encoding:
            mock_encoding.side_effect = KeyError
            with patch("tiktoken.get_encoding") as mock_get:
                mock_get.return_value = MagicMock()
                ai = AI(model="unknown-model")
                # In buggy code, tokenizer attribute doesn't exist.
                # In fixed code, it does.
                self.assertTrue(hasattr(ai, "tokenizer"))
                mock_get.assert_called_once_with("cl100k_base")


