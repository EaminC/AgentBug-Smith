from unittest.mock import MagicMock, patch
from gpt_engineer.ai import AI
from gpt_engineer.db import DBs
from gpt_engineer.steps import simple_gen, clarify, gen_spec, respec, gen_unit_tests, gen_clarified_code, gen_code, gen_entrypoint, use_feedback, fix_code
import inspect


def test_token_usage_dataclass_exists():
    """TokenUsage dataclass must exist after the fix."""
    from gpt_engineer.ai import TokenUsage
    # If import succeeds, the test passes (buggy code will raise ImportError)
    assert TokenUsage.__name__ == "TokenUsage"


def test_ai_has_token_usage_attributes():
    """AI should have cumulative token counters and token_usage_log after fix."""
    ai = AI(model="gpt-4")
    # In buggy code these attributes do not exist
    assert hasattr(ai, "cumulative_prompt_tokens")
    assert hasattr(ai, "cumulative_completion_tokens")
    assert hasattr(ai, "cumulative_total_tokens")
    assert hasattr(ai, "token_usage_log")
    assert hasattr(ai, "tokenizer")


def test_start_method_accepts_step_name():
    """AI.start should accept step_name parameter after fix."""
    import inspect
    sig = inspect.signature(AI.start)
    # In buggy code, start signature is (self, system, user)
    # In fixed code, it's (self, system, user, step_name)
    params = list(sig.parameters.keys())
    # self, system, user, step_name
    assert len(params) == 4
    assert params[-1] == "step_name"


def test_next_method_accepts_step_name():
    """AI.next should accept step_name keyword-only parameter after fix."""
    sig = inspect.signature(AI.next)
    params = list(sig.parameters.keys())
    # self, messages, prompt, *, step_name
    assert "step_name" in sig.parameters
    assert sig.parameters["step_name"].kind == inspect.Parameter.KEYWORD_ONLY


def test_update_token_usage_log_called():
    """update_token_usage_log should be called after each completion."""
    ai = AI(model="gpt-4")
    original_update = ai.update_token_usage_log
    call_count = 0

    def counting_update(*args, **kwargs):
        nonlocal call_count
        call_count += 1
        return original_update(*args, **kwargs)

    ai.update_token_usage_log = counting_update
    messages = [
        {"role": "system", "content": "Test"},
        {"role": "user", "content": "Test user"},
    ]
    # Mock the OpenAI API call to avoid network
    with patch("openai.chat.completions.create") as mock_create:
        mock_create.return_value = MagicMock(
            choices=[MagicMock(message=MagicMock(content="Response"))]
        )
        # Mock tokenizer to avoid actual tokenization
        ai.tokenizer.encode = MagicMock(return_value=[])
        ai.next(messages, step_name="test_step")
    # In buggy code, update_token_usage_log is not called (call_count stays 0)
    # In fixed code, it is called once
    assert call_count == 1


def test_token_counts_accumulate():
    """Cumulative token counts should increase across multiple calls."""
    ai = AI(model="gpt-4")
    messages = [
        {"role": "system", "content": "Sys"},
        {"role": "user", "content": "User 1"},
    ]
    with patch("openai.chat.completions.create") as mock_create:
        mock_create.return_value = MagicMock(
            choices=[MagicMock(message=MagicMock(content="Response 1"))]
        )
        ai.tokenizer.encode = MagicMock(side_effect=lambda x: list(range(len(x))))
        ai.next(messages, step_name="step1")
    # After first call, cumulative totals should be >0
    assert ai.cumulative_total_tokens > 0
    initial_total = ai.cumulative_total_tokens
    # Second call
    with patch("openai.chat.completions.create") as mock_create:
        mock_create.return_value = MagicMock(
            choices=[MagicMock(message=MagicMock(content="Response 2"))]
        )
        ai.next(messages, step_name="step2")
    # Cumulative should have increased
    assert ai.cumulative_total_tokens > initial_total
    # token_usage_log should have two entries
    assert len(ai.token_usage_log) == 2


def test_format_token_usage_log():
    """format_token_usage_log should return a CSV string."""
    ai = AI(model="gpt-4")
    # In buggy code, this method does not exist
    # In fixed code, it exists and returns a string
    result = ai.format_token_usage_log()
    assert isinstance(result, str)
    # Header line
    assert "step_name" in result
    assert "prompt_tokens_in_step" in result
    # After a call, there should be data lines
    with patch("openai.chat.completions.create") as mock_create:
        mock_create.return_value = MagicMock(
            choices=[MagicMock(message=MagicMock(content="Response"))]
        )
        ai.tokenizer.encode = MagicMock(return_value=[])
        ai.next([{"role": "user", "content": "test"}], step_name="test_step")
    result = ai.format_token_usage_log()
    lines = result.strip().split("\n")
    assert len(lines) >= 2  # header + at least one data row
    assert "test_step" in lines[1]


def test_steps_pass_step_name():
    """Each step function should pass step_name to AI methods."""
    # We'll test that the step functions call AI methods with step_name.
    # Since the step functions use curr_fn() to get the step name,
    # we need to mock inspect.stack to return a known function name.
    with patch("gpt_engineer.steps.inspect.stack") as mock_stack:
        mock_frame = MagicMock()
        mock_frame.function = "test_step"
        mock_stack.return_value = [mock_frame, None, None, None]
        ai = AI(model="gpt-4")
        # Mock DBs with proper structure
        dbs = DBs(
            memory={},
            logs={},
            preprompts={
                "generate": "generate prompt",
                "philosophy": "philosophy",
                "qa": "qa prompt",
                "spec": "spec prompt",
                "respec": "respec prompt",
                "unit_tests": "unit tests prompt",
                "use_qa": "use qa prompt",
                "use_feedback": "use feedback prompt",
                "fix_code": "fix code prompt",
            },
            input={"prompt": "test prompt"},
            workspace={},
            archive={},
        )
        # Mock the AI methods to capture step_name.
        with patch.object(ai, "start") as mock_start:
            mock_start.return_value = []
            with patch("gpt_engineer.steps.to_files"):
                simple_gen(ai, dbs)
                # In buggy code, start is called with 2 positional arguments.
                # In fixed code, it's called with 3 arguments (system, user, step_name).
                mock_start.assert_called_once()
                args, kwargs = mock_start.call_args
                # step_name should be passed as keyword argument
                assert "step_name" in kwargs
                assert kwargs["step_name"] == "test_step"


def test_main_writes_token_usage_to_logs():
    """main should write token usage to dbs.logs['token_usage'] after fix."""
    # We need to mock the entire main flow to avoid side effects.
    # The key assertion is that after main runs, dbs.logs["token_usage"] is set.
    from gpt_engineer.main import main
    import typer
    from unittest.mock import patch, MagicMock

    # Mock the DBs that will be passed to main
    dbs = DBs(
        memory={},
        logs={},
        preprompts={},
        input={},
        workspace={},
        archive={},
    )
    # Mock the steps.run function that main calls
    with patch("gpt_engineer.main.run") as mock_run:
        # Mock collect_consent to return False to skip learning
        with patch("gpt_engineer.main.collect_consent", return_value=False):
            # Mock the AI instantiation inside main
            with patch("gpt_engineer.main.AI") as MockAI:
                mock_ai_instance = MagicMock()
                mock_ai_instance.format_token_usage_log.return_value = "step_name,0,0,0,0,0,0"
                MockAI.return_value = mock_ai_instance
                # Call main with mocked arguments
                # We need to mock typer's context to avoid actual CLI parsing
                with patch("typer.Context"):
                    # main expects a typer.Context as first argument
                    # We'll mock the context and its params
                    mock_ctx = MagicMock()
                    mock_ctx.params = {
                        "model": "gpt-4",
                        "temperature": 0.1,
                        "steps_config": "default",
                        "project_path": ".",
                        "delete_existing": False,
                        "run_prefix": "",
                    }
                    main(mock_ctx, dbs)
    # After main, token_usage should be written to logs
    # In buggy code, this line does not exist, so logs["token_usage"] is not set.
    # In fixed code, it is set.
    assert "token_usage" in dbs.logs
    assert dbs.logs["token_usage"] == "step_name,0,0,0,0,0,0"


def test_num_tokens_from_messages():
    """num_tokens_from_messages should compute token count."""
    ai = AI(model="gpt-4")
    ai.tokenizer.encode = MagicMock(side_effect=lambda x: list(range(len(x))))
    messages = [
        {"role": "system", "content": "Hello"},
        {"role": "user", "content": "Hi there"},
    ]
    # Each message adds 4 tokens overhead, each content adds len(content) tokens.
    # Total = 4*2 + len("Hello") + len("Hi there") + 2 (for final assistant priming)
    # Mock encode returns len(content) each call.
    tokens = ai.num_tokens_from_messages(messages)
    # Expected: 4*2 + 5 + 8 + 2 = 8 + 5 + 8 + 2 = 23
    assert tokens == 23


