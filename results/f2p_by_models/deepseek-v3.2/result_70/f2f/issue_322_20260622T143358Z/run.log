def test_token_usage_tracking_integration():
    """Integration test that fails when token usage is not tracked."""
    ai = AI(model="gpt-4")

    # Create a mock response for the AI
    mock_response = "Mocked AI response"

    # Mock the internal OpenAI API call
    with patch.object(openai.chat.completions, "create") as mock_create:
        mock_create.return_value = MagicMock(
            choices=[MagicMock(message=MagicMock(content=mock_response))]
        )

        # Call start with step_name - should work in fixed code
        messages = ai.start("system", "user", step_name="integration_test")

        # Verify token usage was tracked
        assert len(ai.token_usage_log) == 1
        log_entry = ai.token_usage_log[0]
        assert log_entry.step_name == "integration_test"
        assert log_entry.total_tokens > 0


def test_token_usage_stored_in_logs():
    """Test that token usage CSV is stored in dbs.logs after execution."""
    from gpt_engineer.main import main as gpt_engineer_main

    ai = AI()

    # Track token usage
    ai.update_token_usage_log(
        messages=[{"role": "user", "content": "Test"}],
        answer="Response",
        step_name="test_step"
    )

    with tempfile.TemporaryDirectory() as tmpdir:
        dbs = DBs(
            memory=tempfile.mkdtemp(dir=tmpdir),
            logs=tempfile.mkdtemp(dir=tmpdir),
            preprompts=tempfile.mkdtemp(dir=tmpdir),
            input=tempfile.mkdtemp(dir=tmpdir),
            workspace=tempfile.mkdtemp(dir=tmpdir),
            archive=tempfile.mkdtemp(dir=tmpdir)
        )

        # Store token usage log
        dbs.logs["token_usage"] = ai.format_token_usage_log()

        # Verify it's there
        assert "token_usage" in dbs.logs
        token_usage_csv = dbs.logs["token_usage"]
        assert "test_step" in token_usage_csv
        assert "prompt_tokens_in_step" in token_usage_csv


def test_fallback_tokenizer():
    """Test that tokenizer falls back to cl100k_base for unknown models."""
    ai = AI(model="unknown-model-xyz")
    # Should fall back to cl100k_base
    assert ai.tokenizer is not None


def test_tokenizer_initialization():
    """Test tokenizer is initialized for known models."""
    ai = AI(model="gpt-4")
    assert ai.tokenizer is not None
    ai2 = AI(model="gpt-3.5-turbo")
    assert ai2.tokenizer is not None


