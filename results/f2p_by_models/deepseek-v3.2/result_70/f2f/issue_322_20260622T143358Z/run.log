    def test_num_tokens(self):
        """num_tokens should delegate to tokenizer.encode."""
        ai = AI(model="gpt-4")
        ai.tokenizer.encode = MagicMock(return_value=[1, 2, 3])
        result = ai.num_tokens("hello")
        self.assertEqual(result, 3)
        ai.tokenizer.encode.assert_called_once_with("hello")

    def test_num_tokens_from_messages(self):
        """num_tokens_from_messages should compute token count."""
        ai = AI(model="gpt-4")
        ai.tokenizer.encode = MagicMock(side_effect=lambda x: list(range(len(x))))
        messages = [
            {"role": "system", "content": "Hello"},
            {"role": "user", "content": "Hi there"},
        ]
        # Each message adds 4 tokens overhead, each content adds len(content) tokens.
        # Total = 4*2 + len("Hello") + len("Hi there") + 2 (for final assistant priming)
        # Mock encode returns len(content) each call.
        tokens = ai.num_tokens_from_messages(messages)
        # Expected: 4*2 + 5 + 8 + 2 = 8 + 5 + 8 + 2 = \\
        # Actually, the method also counts the keys? Let's compute from the method:
        # For each message: 4 tokens overhead, then for each key/value: num_tokens(value)
        # If key == "name": adjust -1. Our messages have only "role" and "content".
        # So each message: 4 + num_tokens(role) + num_tokens(content)
        # role is "system" or "user", length 6 and 4 respectively.
        # But the mock returns len(value) tokens.
        # So total = 4*2 + len("system") + len("Hello") + len("user") + len("Hi there") + 2
        # = 8 + 6 + 5 + 4 + 8 + 2 = 33
        self.assertEqual(tokens, 33)

