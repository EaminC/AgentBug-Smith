                    # Simulate main being called with arguments
                    gpt_engineer.main.main(
                        project_path=".",
                        model="gpt-4",
                        temperature=0.1,
                        steps_config="default",
                        dbs=dbs,
                    )
                    # After fix, main should set dbs.logs["token_usage"]
                    assert "token_usage" in dbs.logs
                    assert dbs.logs["token_usage"] == "token,usage,csv"
                    # In buggy code, this assignment is missing, so the key won't exist.


def test_num_tokens_from_messages():
    """num_tokens_from_messages should compute token count."""
    ai = AI(model="gpt-4")
    ai.tokenizer.encode = MagicMock(side_effect=lambda x: list(range(len(x))))
    messages = [
        {"role": "system", "content": "Hello"},
        {"role": "user", "content": "Hi there"},
    ]
    # Each message adds 4 tokens overhead, each content adds len(content) tokens.
    # Total = 4*2 + len("Hello") + len("Hi there") + 2 (for final assistant priming)
    # Mock encode returns list of length len(content).
    tokens = ai.num_tokens_from_messages(messages)
    # Expected: 4*2 + 5 + 8 + 2 = 8 + 5 + 8 + 2 = 23
    assert tokens == 23


def test_token_usage_log_entry():
    """TokenUsage log entry should have correct values."""
    ai = AI(model="gpt-4")
    with patch.object(openai.chat.completions, "create") as mock_create:
        mock_create.return_value = MagicMock(
            choices=[MagicMock(message=MagicMock(content="Response"))]
        )
        ai.tokenizer.encode = MagicMock(return_value=[1, 2])  # 2 tokens per encode
        ai.next([{"role": "user", "content": "test"}], step_name="step1")
        assert len(ai.token_usage_log) == 1
        log = ai.token_usage_log[0]
        assert log.step_name == "step1"
        assert log.in_step_prompt_tokens == 2  # "test" -> 2 tokens
        assert log.in_step_completion_tokens == 2  # "Response" -> 2 tokens
        assert log.in_step_total_tokens == 4
        assert log.total_prompt_tokens == 2
        assert log.total_completion_tokens == 2
        assert log.total_tokens == 4


def test_format_token_usage_log():
    """format_token_usage_log should produce CSV string."""
    ai = AI(model="gpt-4")
    # Simulate some token usage entries
    ai.token_usage_log = [
        MagicMock(
            step_name="step1",
            in_step_prompt_tokens=10,
            in_step_completion_tokens=20,
            in_step_total_tokens=30,
            total_prompt_tokens=10,
            total_completion_tokens=20,
            total_tokens=30,
        ),
        MagicMock(
            step_name="step2",
            in_step_prompt_tokens=5,
            in_step_completion_tokens=15,
            in_step_total_tokens=20,
            total_prompt_tokens=15,
            total_completion_tokens=35,
            total_tokens=50,
        ),
    ]
    csv = ai.format_token_usage_log()
    lines = csv.strip().split("\n")
    assert lines[0] == "step_name,prompt_tokens_in_step,completion_tokens_in_step,total_tokens_in_step,total_prompt_tokens,total_completion_tokens,total_tokens"
    assert lines[1] == "step1,10,20,30,10,20,30"
    assert lines[2] == "step2,5,15,20,15,35,50"


def test_curr_fn_returns_function_name():
    """curr_fn should return the calling function's name."""
    def dummy_function():
        return curr_fn()
    name = dummy_function()
    assert name == "dummy_function"


def test_ai_init_tokenizer():
    """AI.__init__ should set up tokenizer."""
    ai = AI(model="gpt-4")
    assert hasattr(ai, "tokenizer")
    # Should have cumulative counters
    assert ai.cumulative_prompt_tokens == 0
    assert ai.cumulative_completion_tokens == 0
    assert ai.cumulative_total_tokens == 0
    assert ai.token_usage_log == []


