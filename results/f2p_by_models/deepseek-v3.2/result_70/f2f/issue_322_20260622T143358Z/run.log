from gpt_engineer.main import main as gpt_engineer_main


class TestTokenUsageTracking(unittest.TestCase):
    """Test that token usage is tracked and logged after the fix."""

    def test_token_usage_log_exists_after_fix(self):
        """In buggy code, token_usage_log attribute does not exist. In fixed code, it does."""
        ai = AI(model="gpt-4")
        # In buggy code, ai.token_usage_log is not defined.
        # In fixed code, it is initialized as an empty list.
        # This test will fail on buggy code because attribute is missing.
        self.assertTrue(hasattr(ai, 'token_usage_log'))
        self.assertEqual(ai.token_usage_log, [])

    def test_start_method_accepts_step_name(self):
        """AI.start() should accept step_name parameter after fix."""
        ai = AI(model="gpt-4")
        # In buggy code, start() takes only system and user arguments.
        # In fixed code, it also accepts step_name.
        # This test will fail on buggy code because step_name is unexpected.
        with patch.object(ai, 'next', return_value=[]) as mock_next:
            ai.start("system", "user", step_name="test_step")
            # Verify that next was called with step_name
            mock_next.assert_called_once()
            call_kwargs = mock_next.call_args.kwargs
            self.assertIn('step_name', call_kwargs)
            self.assertEqual(call_kwargs['step_name'], "test_step")

    def test_next_method_accepts_step_name(self):
        """AI.next() should accept step_name parameter after fix."""
        ai = AI(model="gpt-4")
        # In buggy code, next() does not accept step_name.
        # In fixed code, it does (as keyword-only).
        # Mock the OpenAI API call to avoid network.
        with patch('openai.ChatCompletion.create') as mock_create:
            # Simulate streaming response
            mock_chunk = MagicMock()
            mock_chunk.__getitem__.return_value = {"choices": [{"delta": {"content": "response"}}]}
            mock_create.return_value = [mock_chunk]
            # In buggy code, this call will raise TypeError because step_name is unexpected.
            # In fixed code, it should succeed.
            messages = [{"role": "user", "content": "test"}]
            ai.next(messages, step_name="test_step")
            # If we reach here, the call succeeded (fixed code).
            # Verify that update_token_usage_log was called (if it exists).
            # We'll check that token_usage_log has been updated.
            self.assertEqual(len(ai.token_usage_log), 1)
            self.assertEqual(ai.token_usage_log[0].step_name, "test_step")

    def test_update_token_usage_log_called(self):
        """update_token_usage_log should be called after each completion."""
        ai = AI(model="gpt-4")
        # In buggy code, update_token_usage_log method does not exist.
        # In fixed code, it does.
        # This test will fail on buggy code because method is missing.
        self.assertTrue(hasattr(ai, 'update_token_usage_log'))
        # Mock the OpenAI call and tokenizer
        with patch('openai.ChatCompletion.create') as mock_create:
            mock_chunk = MagicMock()
            mock_chunk.__getitem__.return_value = {"choices": [{"delta": {"content": "response"}}]}
            mock_create.return_value = [mock_chunk]
            ai.tokenizer.encode = MagicMock(return_value=[1, 2])
            messages = [{"role": "user", "content": "test"}]
            ai.next(messages, step_name="test_step")
            # Verify token_usage_log updated
            self.assertEqual(len(ai.token_usage_log), 1)
            log_entry = ai.token_usage_log[0]
            self.assertEqual(log_entry.step_name, "test_step")
            self.assertEqual(log_entry.in_step_prompt_tokens, 2)  # because encode returned [1,2]
            self.assertEqual(log_entry.in_step_completion_tokens, 2)

    def test_token_counts_accumulate(self):
        """Cumulative token counts should increase across multiple calls."""
        ai = AI(model="gpt-4")
        with patch('openai.ChatCompletion.create') as mock_create:
            mock_chunk = MagicMock()
            mock_chunk.__getitem__.return_value = {"choices": [{"delta": {"content": "response"}}]}
            mock_create.return_value = [mock_chunk]
            ai.tokenizer.encode = MagicMock(return_value=[1])
            messages = [{"role": "user", "content": "test"}]
            ai.next(messages, step_name="step1")
            self.assertEqual(ai.cumulative_total_tokens, 2)  # prompt 1 + completion 1
            ai.next(messages, step_name="step2")
            self.assertEqual(ai.cumulative_total_tokens, 4)  # cumulative adds another 2

    def test_format_token_usage_log_exists(self):
        """format_token_usage_log method should exist after fix."""
        ai = AI(model="gpt-4")
        # In buggy code, this method does not exist.
        # In fixed code, it returns a CSV string.
        self.assertTrue(hasattr(ai, 'format_token_usage_log'))
        # Call it and verify it returns a string
        log_str = ai.format_token_usage_log()
        self.assertIsInstance(log_str, str)
        # Header should be present
        self.assertIn("step_name", log_str)
        self.assertIn("prompt_tokens_in_step", log_str)

    def test_steps_pass_step_name(self):
        """All step functions should pass step_name to AI methods."""
        # We'll test simple_gen as an example.
        ai = AI(model="gpt-4")
        dbs = DBs(
            memory={},
            logs={},
            preprompts={
                "generate": "generate prompt",
                "philosophy": "philosophy",
            },
            input={"prompt": "test prompt"},
            workspace={},
            archive={},
