                        mock_start.assert_called_once()
                        call_args = mock_start.call_args
                        # Check that step_name is passed (as keyword argument).
                        self.assertIn('step_name', call_args.kwargs)
                        self.assertEqual(call_args.kwargs['step_name'], 'simple_gen')

