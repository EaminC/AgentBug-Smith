        messages = [
            {"role": "system", "content": "Test"},
            {"role": "user", "content": "Test user"},
        ]
        with patch("openai.chat.completions.create") as mock_create:
            mock_create.return_value = MagicMock(
                choices=[MagicMock(message=MagicMock(content="Response"))]
            )
            ai.tokenizer.encode = MagicMock(return_value=[])
            ai.next(messages, step_name="test_step")
        self.assertEqual(call_count, 1)

    def test_token_counts_accumulate(self):
        """Cumulative token counts should increase across multiple calls."""
        ai = AI(model="gpt-4")
        messages = [
            {"role": "system", "content": "Sys"},
            {"role": "user", "content": "User 1"},
        ]
        with patch("openai.chat.completions.create") as mock_create:
            mock_create.return_value = MagicMock(
                choices=[MagicMock(message=MagicMock(content="Response 1"))]
            )
            ai.tokenizer.encode = MagicMock(side_effect=lambda x: list(range(len(x))))
            ai.next(messages, step_name="step1")
            self.assertEqual(ai.cumulative_total_tokens, 0)
            # Second call
            ai.next(messages, step_name="step2")
            # Cumulative total should be greater than after first call.
            self.assertGreater(ai.cumulative_total_tokens, 0)

    def test_num_tokens(self):
        """AI.num_tokens should return token count using tokenizer."""
        ai = AI(model="gpt-4")
        ai.tokenizer.encode = MagicMock(return_value=[1, 2, 3])
        result = ai.num_tokens("hello")
        self.assertEqual(result, 3)
        ai.tokenizer.encode.assert_called_once_with("hello")

    def test_num_tokens_from_messages(self):
        """AI.num_tokens_from_messages should compute token count for messages."""
        ai = AI(model="gpt-4")
        ai.num_tokens = MagicMock(return_value=5)
        messages = [
            {"role": "system", "content": "Hello"},
            {"role": "user", "content": "Hi"},
        ]
        result = ai.num_tokens_from_messages(messages)
        # The formula adds 4 per message + 2 at the end.
        # 2 messages * 4 = 8, plus 2 = 10, plus 5 per message content (2*5=10) = 20.
        # However, the buggy code does not have this method, so test will fail.
        self.assertEqual(result, 20)

    def test_format_token_usage_log(self):
        """AI.format_token_usage_log should return CSV string."""
        ai = AI(model="gpt-4")
        # Simulate one log entry.
        ai.token_usage_log.append(
            TokenUsage(
                step_name="test",
                in_step_prompt_tokens=10,
                in_step_completion_tokens=20,
                in_step_total_tokens=30,
                total_prompt_tokens=10,
                total_completion_tokens=20,
                total_tokens=30,
            )
        )
        result = ai.format_token_usage_log()
        self.assertIn("test", result)
        self.assertIn("10,20,30", result)

    def test_steps_pass_step_name(self):
        """Each step function should pass step_name to AI methods."""
        # We'll test that the step functions call AI methods with step_name.
        # Since the step functions use curr_fn() to get the step name,
        # we need to mock inspect.stack to return a known function name.
        import inspect
        with patch("gpt_engineer.steps.inspect.stack") as mock_stack:
            mock_frame = MagicMock()
            mock_frame.function = "test_step"
            mock_stack.return_value = [mock_frame, None, None, None]
            ai = AI(model="gpt-4")
            dbs = DBs(
                memory="",
                logs="",
                preprompts="",
                input="",
                workspace="",
                archive="",
            )
            # Mock the AI methods to capture step_name.
            with patch.object(ai, "start") as mock_start:
                mock_start.return_value = []
                simple_gen(ai, dbs)
                mock_start.assert_called_once()
                call_args = mock_start.call_args
                # step_name should be the function name from curr_fn.
                self.assertEqual(call_args.kwargs.get("step_name"), "test_step")

    def test_main_writes_token_usage_to_logs(self):
        """main should write token usage log to dbs.logs['token_usage']."""
        ai = AI(model="gpt-4")
        ai.format_token_usage_log = MagicMock(return_value="token,usage,csv")
        dbs = DBs(
            memory="",
            logs="",
            preprompts="",
            input="",
            workspace="",
            archive="",
        )
        # Mock collect_consent to return False to skip learning.
        with patch("gpt_engineer.main.collect_consent", return_value=False):
            # Mock steps to avoid real execution.
            with patch("gpt_engineer.main.steps", return_value=[]):
                main(None, None, None, dbs, ai)
        self.assertEqual(dbs.logs["token_usage"], "token,usage,csv")

    def test_tokenizer_fallback(self):
        """AI should fall back to cl100k_base if model encoding not found."""
        with patch("tiktoken.encoding_for_model") as mock_encoding_for_model:
            mock_encoding_for_model.side_effect = KeyError
            with patch("tiktoken.get_encoding") as mock_get_encoding:
                mock_get_encoding.return_value = "cl100k_base"
                ai = AI(model="unknown-model")
                self.assertEqual(ai.tokenizer, "cl100k_base")

    def test_token_usage_log_entry_fields(self):
        """TokenUsage dataclass should have expected fields."""
        # This test will fail on buggy code because TokenUsage is not defined.
        usage = TokenUsage(
            step_name="step",
            in_step_prompt_tokens=1,
            in_step_completion_tokens=2,
            in_step_total_tokens=3,
            total_prompt_tokens=4,
            total_completion_tokens=5,
            total_tokens=6,
        )
        self.assertEqual(usage.step_name, "step")
        self.assertEqual(usage.in_step_prompt_tokens, 1)
        self.assertEqual(usage.in_step_completion_tokens, 2)
        self.assertEqual(usage.in_step_total_tokens, 3)
        self.assertEqual(usage.total_prompt_tokens, 4)
        self.assertEqual(usage.total_completion_tokens, 5)
        self.assertEqual(usage.total_tokens, 6)


