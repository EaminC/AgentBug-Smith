        with patch("openai.chat.completions.create") as mock_create:
            mock_create.return_value = MagicMock(
                choices=[MagicMock(message=MagicMock(content="Response 1"))]
            )
            ai.tokenizer.encode = MagicMock(side_effect=lambda x: list(range(len(x))))
            ai.next(messages, step_name="step1")
        self.assertGreater(ai.cumulative_total_tokens, 0)
        first_total = ai.cumulative_total_tokens
        with patch("openai.chat.completions.create") as mock_create:
            mock_create.return_value = MagicMock(
                choices=[MagicMock(message=MagicMock(content="Response 2"))]
            )
            ai.next(messages, step_name="step2")
        self.assertGreater(ai.cumulative_total_tokens, first_total)

    def test_start_method_accepts_step_name(self):
        """AI.start should accept step_name parameter."""
        ai = AI(model="gpt-4")
        with patch("openai.chat.completions.create") as mock_create:
            mock_create.return_value = MagicMock(
                choices=[MagicMock(message=MagicMock(content="Response"))]
            )
            ai.tokenizer.encode = MagicMock(return_value=[])
            ai.start("system", "user", step_name="test_start")
        self.assertEqual(len(ai.token_usage_log), 1)
        self.assertEqual(ai.token_usage_log[0].step_name, "test_start")

    def test_next_method_accepts_step_name(self):
        """AI.next should accept step_name parameter."""
        ai = AI(model="gpt-4")
        messages = [{"role": "system", "content": "Test"}]
        with patch("openai.chat.completions.create") as mock_create:
            mock_create.return_value = MagicMock(
                choices=[MagicMock(message=MagicMock(content="Response"))]
            )
            ai.tokenizer.encode = MagicMock(return_value=[])
            ai.next(messages, step_name="test_next")
        self.assertEqual(len(ai.token_usage_log), 1)
        self.assertEqual(ai.token_usage_log[0].step_name, "test_next")

    def test_num_tokens_from_messages(self):
        """num_tokens_from_messages should compute token count."""
        ai = AI(model="gpt-4")
        ai.tokenizer.encode = MagicMock(return_value=[1, 2, 3])
        messages = [
            {"role": "system", "content": "Hello"},
            {"role": "user", "content": "World"},
        ]
        tokens = ai.num_tokens_from_messages(messages)
        # Expected: 4 per message + tokens for content + 2 for assistant priming
        # Each content has 3 tokens, two messages => 2*4 + 2*3 + 2 = 8+6+2=16
        self.assertEqual(tokens, 16)

    def test_format_token_usage_log(self):
        """format_token_usage_log should return CSV string."""
        ai = AI(model="gpt-4")
        ai.token_usage_log = [
            TokenUsage(
                step_name="step1",
                in_step_prompt_tokens=10,
                in_step_completion_tokens=20,
                in_step_total_tokens=30,
                total_prompt_tokens=10,
                total_completion_tokens=20,
                total_tokens=30,
            )
        ]
        csv = ai.format_token_usage_log()
        self.assertIn("step1", csv)
        self.assertIn("10,20,30,10,20,30", csv)

    def test_main_writes_token_usage_to_logs(self):
        """main should write token usage log to dbs.logs['token_usage']."""
        from gpt_engineer.main import main
        from unittest.mock import patch, MagicMock
        import typer

        with patch("gpt_engineer.main.collect_consent", return_value=False):
            with patch("gpt_engineer.main.collect_learnings"):
                with patch("gpt_engineer.main.ClonedRepo") as mock_cloned_repo:
                    mock_cloned_repo.return_value = MagicMock()
                    with patch("gpt_engineer.main.DB") as mock_db:
                        mock_db.return_value = MagicMock()
                        with patch("gpt_engineer.main.AI") as mock_ai:
                            mock_instance = MagicMock()
                            mock_instance.format_token_usage_log.return_value = "token,usage"
                            mock_ai.return_value = mock_instance
                            with patch("gpt_engineer.main.run") as mock_run:
                                mock_run.return_value = MagicMock()
                                # We need to mock the dbs that will be passed to run
                                mock_dbs = MagicMock()
                                mock_dbs.logs = {}
                                mock_run.return_value = mock_dbs
                                # Call main with minimal args
                                try:
                                    main(
                                        project_path=".",
                                        model="gpt-4",
                                        temperature=0.1,
                                        steps_config="default",
                                    )
                                except SystemExit:
                                    pass
                                # Check that format_token_usage_log was called and result stored
                                mock_instance.format_token_usage_log.assert_called_once()
                                self.assertEqual(mock_dbs.logs.get("token_usage"), "token,usage")

    def test_steps_pass_step_name(self):
        """Each step function should pass step_name to AI methods."""
        # We'll test that the step functions call AI methods with step_name.
        # Since the step functions use curr_fn() to get the step name,
        # we need to mock inspect.stack to return a known function name.
        with patch("gpt_engineer.steps.inspect.stack") as mock_stack:
            mock_frame = MagicMock()
            mock_frame.function = "test_step"
            mock_stack.return_value = [mock_frame, None, None, None]
            ai = AI(model="gpt-4")
            # Mock DBs with proper structure
            dbs = DBs(
                memory={},
                logs={},
                preprompts={
                    "generate": "generate prompt",
                    "philosophy": "philosophy",
                    "qa": "qa prompt",
                    "spec": "spec prompt",
                    "respec": "respec prompt",
                    "unit_tests": "unit tests prompt",
                    "use_qa": "use qa prompt",
                    "use_feedback": "use feedback prompt",
                    "fix_code": "fix code prompt",
                },
                input={"prompt": "test prompt"},
                workspace={},
                archive={},
            )
            # Mock the AI methods to capture step_name.
            with patch.object(ai, "start") as mock_start:
                mock_start.return_value = []
                simple_gen(ai, dbs)
                mock_start.assert_called_once()
                # Check that step_name argument is passed and equals the mocked function name
                call_kwargs = mock_start.call_args[1]
                self.assertEqual(call_kwargs.get("step_name"), "test_step")

    def test_tokenizer_fallback(self):
        """AI should fallback to cl100k_base if model encoding not found."""
        with patch("tiktoken.encoding_for_model") as mock_encoding:
            mock_encoding.side_effect = KeyError
            with patch("tiktoken.get_encoding") as mock_get:
                mock_get.return_value = MagicMock()
                ai = AI(model="unknown-model")
                self.assertEqual(ai.tokenizer, mock_get.return_value)

    def test_token_usage_dataclass(self):
        """TokenUsage dataclass should have expected fields."""
        usage = TokenUsage(
            step_name="step",
            in_step_prompt_tokens=1,
            in_step_completion_tokens=2,
            in_step_total_tokens=3,
            total_prompt_tokens=4,
            total_completion_tokens=5,
            total_tokens=6,
        )
        self.assertEqual(usage.step_name, "step")
        self.assertEqual(usage.in_step_prompt_tokens, 1)
        self.assertEqual(usage.total_tokens, 6)

    def test_num_tokens_method(self):
        """num_tokens should delegate to tokenizer.encode."""
        ai = AI(model="gpt-4")
        ai.tokenizer.encode = MagicMock(return_value=[1, 2, 3])
        result = ai.num_tokens("hello")
        self.assertEqual(result, 3)
        ai.tokenizer.encode.assert_called_once_with("hello")


