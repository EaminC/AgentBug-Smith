    def test_update_token_usage_log_called(self):
        """update_token_usage_log should be called after each completion."""
        ai = AI(model="gpt-4")
        original_update = ai.update_token_usage_log
        call_count = 0

        def counting_update(*args, **kwargs):
            nonlocal call_count
            call_count += 1
            return original_update(*args, **kwargs)

        ai.update_token_usage_log = counting_update
        messages = [
            {"role": "system", "content": "Test"},
            {"role": "user", "content": "Test user"},
        ]
        # Mock the OpenAI API call using new openai>=1.0.0 interface.
