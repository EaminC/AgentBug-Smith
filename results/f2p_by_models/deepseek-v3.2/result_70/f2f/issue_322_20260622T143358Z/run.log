def test_token_usage_log_initialization():
    """Test that AI initializes token usage tracking correctly."""
    ai = AI(model="gpt-4", temperature=0.1)
    assert ai.cumulative_prompt_tokens == 0
    assert ai.cumulative_completion_tokens == 0
    assert ai.cumulative_total_tokens == 0
    assert ai.token_usage_log == []
    assert hasattr(ai, 'tokenizer')


def test_token_usage_log_updated_on_start():
    """Test that token usage log is updated when start() is called."""
    ai = AI(model="gpt-4", temperature=0.1)
    with mock.patch.object(ai, 'next') as mock_next:
        mock_next.return_value = [
            {"role": "system", "content": "sys"},
            {"role": "user", "content": "usr"},
            {"role": "assistant", "content": "assistant response"}
        ]
        messages = ai.start("sys", "usr", step_name="test_step")
        mock_next.assert_called_once()
        # Check that step_name is passed to next
        call_kwargs = mock_next.call_args[1]
        assert call_kwargs.get('step_name') == "test_step"
        # Token usage log should have been updated via next -> update_token_usage_log
        # Since we mocked next, the actual update won't happen, but we can verify
        # that start calls next with step_name.


def test_token_usage_log_updated_on_next():
    """Test that token usage log is updated when next() is called."""
    ai = AI(model="gpt-4", temperature=0.1)
    # Mock the OpenAI API call
    with mock.patch('openai.chat.completions.create') as mock_create:
        mock_create.return_value = mock.Mock(
            choices=[mock.Mock(message=mock.Mock(content="assistant response"))]
        )
        messages = [
            {"role": "system", "content": "sys"},
            {"role": "user", "content": "usr"}
        ]
        result = ai.next(messages, step_name="test_step")
        # Verify token usage log was updated
        assert len(ai.token_usage_log) == 1
        log_entry = ai.token_usage_log[0]
        assert log_entry.step_name == "test_step"
        assert log_entry.in_step_prompt_tokens > 0
        assert log_entry.in_step_completion_tokens > 0
        assert log_entry.in_step_total_tokens == log_entry.in_step_prompt_tokens + log_entry.in_step_completion_tokens
        assert log_entry.total_prompt_tokens == log_entry.in_step_prompt_tokens
        assert log_entry.total_completion_tokens == log_entry.in_step_completion_tokens
        assert log_entry.total_tokens == log_entry.in_step_total_tokens


def test_token_usage_log_cumulative():
    """Test that cumulative token counts accumulate across multiple steps."""
    ai = AI(model="gpt-4", temperature=0.1)
    # Mock the OpenAI API call
    with mock.patch('openai.chat.completions.create') as mock_create:
        mock_create.return_value = mock.Mock(
            choices=[mock.Mock(message=mock.Mock(content="response"))]
        )
        messages = [{"role": "system", "content": "sys"}]
        ai.next(messages, step_name="step1")
        ai.next(messages, step_name="step2")
        assert len(ai.token_usage_log) == 2
        log1 = ai.token_usage_log[0]
        log2 = ai.token_usage_log[1]
        assert log2.total_prompt_tokens == log1.total_prompt_tokens + log2.in_step_prompt_tokens
        assert log2.total_completion_tokens == log1.total_completion_tokens + log2.in_step_completion_tokens
        assert log2.total_tokens == log1.total_tokens + log2.in_step_total_tokens


def test_format_token_usage_log():
    """Test that format_token_usage_log returns a CSV string."""
    ai = AI(model="gpt-4", temperature=0.1)
    # Mock the OpenAI API call
    with mock.patch('openai.chat.completions.create') as mock_create:
        mock_create.return_value = mock.Mock(
            choices=[mock.Mock(message=mock.Mock(content="response"))]
        )
        messages = [{"role": "system", "content": "sys"}]
        ai.next(messages, step_name="step1")
        ai.next(messages, step_name="step2")
        csv_output = ai.format_token_usage_log()
        assert isinstance(csv_output, str)
        lines = csv_output.strip().split('\n')
