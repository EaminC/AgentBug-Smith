    def test_tokenizer_initialized(self):
        """AI should have a tokenizer after fix."""
        ai = AI(model="gpt-4")
        # In buggy code, tokenizer attribute does not exist.
        # In fixed code, it is initialized.
        self.assertTrue(hasattr(ai, 'tokenizer'))
        # It should have an encode method.
        self.assertTrue(callable(ai.tokenizer.encode))

    def test_num_tokens_method_exists(self):
        """num_tokens method should exist after fix."""
        ai = AI(model="gpt-4")
        self.assertTrue(hasattr(ai, 'num_tokens'))
        # It should return an integer.
        ai.tokenizer.encode = MagicMock(return_value=[1,2,3])
        result = ai.num_tokens("hello")
        self.assertEqual(result, 3)

    def test_num_tokens_from_messages_exists(self):
        """num_tokens_from_messages method should exist after fix."""
        ai = AI(model="gpt-4")
        self.assertTrue(hasattr(ai, 'num_tokens_from_messages'))
        # Test with mock tokenizer
        ai.tokenizer.encode = MagicMock(side_effect=lambda x: list(range(len(x))))
        messages = [
            {"role": "system", "content": "Hello"},
            {"role": "user", "content": "Hi there"},
        ]
        tokens = ai.num_tokens_from_messages(messages)
        # Expected: each message adds 4 overhead, each content adds len(content), plus 2 for assistant priming.
        # Overhead: 4*2 = 8
        # Content: len("Hello")=5, len("Hi there")=8 -> total 13
        # Assistant priming: 2
        # Total: 8 + 13 + 2 = 23
        self.assertEqual(tokens, 23)


