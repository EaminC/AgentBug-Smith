def test_next_method_signature(ai_instance, mock_openai):
    # In buggy code, next() does not accept step_name keyword argument
    # In fixed code, next() accepts step_name keyword argument
    # This test will fail on buggy code because step_name is unexpected
    messages = [{"role": "user", "content": "Hello"}]
    result = ai_instance.next(messages, step_name="test_step")
    # If we reach here, the call succeeded (fixed code). Assert something about result.
    assert isinstance(result, list)
    # In buggy code, the call will raise a TypeError because step_name is unexpected

def test_start_method_signature(ai_instance, mock_openai):
    # In buggy code, start() takes two arguments (system, user)
    # In fixed code, start() takes three arguments (system, user, step_name)
    # This test will fail on buggy code because step_name is missing
    result = ai_instance.start("system", "user", step_name="test_step")
    assert isinstance(result, list)
    # In buggy code, the call will raise a TypeError because step_name is unexpected

def test_token_usage_log_updated_after_next(ai_instance, mock_openai):
    # In buggy code, token_usage_log is not updated after next()
    # In fixed code, token_usage_log is updated
