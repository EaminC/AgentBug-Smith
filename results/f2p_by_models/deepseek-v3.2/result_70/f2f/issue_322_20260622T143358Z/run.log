def test_tokenizer_fallback():
    """Test that tokenizer falls back to cl100k_base for unknown models."""
    # Mock tiktoken.encoding_for_model to raise KeyError
    with mock.patch('tiktoken.encoding_for_model', side_effect=KeyError):
        with mock.patch('tiktoken.get_encoding') as mock_get_encoding:
            mock_get_encoding.return_value = mock.Mock(encode=lambda x: [1,2,3])
            ai = AI(model="unknown-model", temperature=0.1)
            # Verify fallback was used
            mock_get_encoding.assert_called_once_with("cl100k_base")
            # Test token counting
            assert ai.num_tokens("hello") == 3  # mock returns list of length 3


def test_token_usage_dataclass():
    """Test TokenUsage dataclass fields."""
    usage = TokenUsage(
        step_name="test",
        in_step_prompt_tokens=10,
        in_step_completion_tokens=20,
        in_step_total_tokens=30,
        total_prompt_tokens=40,
        total_completion_tokens=50,
        total_tokens=90
    )
    assert usage.step_name == "test"
    assert usage.in_step_prompt_tokens == 10
    assert usage.in_step_completion_tokens == 20
    assert usage.in_step_total_tokens == 30
    assert usage.total_prompt_tokens == 40
    assert usage.total_completion_tokens == 50
    assert usage.total_tokens == 90


def test_ai_without_step_name_backward_compat():
    """Test that AI.next works without step_name (backward compatibility).
       In buggy code, step_name is not required; after fix, it's required.
       This test should fail on buggy code because step_name is missing.
    """
    ai = AI(model="gpt-4", temperature=0.1)
    # Mock OpenAI call
    with mock.patch('openai.chat.completions.create') as mock_create:
        mock_create.return_value = mock.Mock(
            choices=[mock.Mock(message=mock.Mock(content="response"))]
        )
        messages = [{"role": "system", "content": "sys"}]
        # In buggy code, next() doesn't accept step_name keyword.
        # After fix, step_name is a keyword-only argument.
        # We call without step_name; buggy code will accept it, fixed code will raise TypeError.
        # However, the fix changed signature to have step_name as keyword-only, but default None.
        # Actually, step_name is keyword-only but optional (default None).
        # So both buggy and fixed code should accept this call.
        # But buggy code doesn't have step_name parameter at all, so it will raise TypeError.
        # Let's test that.
        try:
            result = ai.next(messages)
            # If we reach here, buggy code may have accepted (if step_name not required).
            # But buggy code's next signature is next(self, messages, prompt=None).
            # It does NOT have step_name. So calling ai.next(messages) works.
            # However, the buggy code's next does not call update_token_usage_log.
            # So token_usage_log remains empty.
            # We'll assert that token_usage_log is updated (which fails on buggy).
            assert len(ai.token_usage_log) == 1
            log_entry = ai.token_usage_log[0]
            # step_name should be None because we didn't pass it.
            assert log_entry.step_name is None
        except TypeError as e:
            # Buggy code might raise TypeError if step_name is passed as keyword?
            # Actually, buggy code doesn't have step_name, so if we call ai.next(messages, step_name=None)
            # it would raise TypeError because step_name is unexpected keyword argument.
            # But we called without step_name, so buggy code should not raise.
            # If we get TypeError, it's because fixed code requires step_name as keyword-only?
            # Let's examine the patch: `def next(self, messages: List[Dict[str, str]], prompt=None, *, step_name=None):`
            # The `*, step_name=None` makes step_name keyword-only. So calling ai.next(messages) works.
            # So buggy code should also work.
            # This test is tricky; we need a clear failure on buggy code.
            # The buggy code does NOT have token usage tracking at all.
            # So we can assert that token_usage_log exists and is updated.
            # That will fail on buggy code because token_usage_log attribute doesn't exist.
            pass


def test_token_usage_log_attribute_exists():
    """Test that AI has token_usage_log attribute after initialization.
       This will fail on buggy code because the attribute is not defined.
    """
    ai = AI(model="gpt-4", temperature=0.1)
    # Buggy code does not define token_usage_log, cumulative_* attributes.
    # So accessing them should raise AttributeError.
    # We'll assert they exist.
    assert hasattr(ai, 'token_usage_log')
    assert hasattr(ai, 'cumulative_prompt_tokens')
    assert hasattr(ai, 'cumulative_completion_tokens')
    assert hasattr(ai, 'cumulative_total_tokens')
    assert hasattr(ai, 'tokenizer')


