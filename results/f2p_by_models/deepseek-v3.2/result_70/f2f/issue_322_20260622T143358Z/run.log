def test_token_usage_tracking_integration():
    """Integration test that fails when token usage is not tracked."""
    ai = AI(model="gpt-4")
    
    # Create a mock response for the AI
    mock_response = "Mocked AI response"
    
    with patch.object(ai, '_get_response', return_value=mock_response):
        # Call start with step_name (buggy code doesn't have this parameter)
        try:
            messages = ai.start("System prompt", "User message", step_name="test_step")
        except TypeError as e:
            if "unexpected keyword argument 'step_name'" in str(e):
                # This is the buggy behavior - start() doesn't accept step_name
                pytest.fail("AI.start() does not accept step_name parameter in buggy code")
            else:
                raise
        
        # If we get here, start() accepted step_name (fixed code)
        assert len(messages) > 0
        
        # Check that token usage was logged
        assert len(ai.token_usage_log) == 1
        log_entry = ai.token_usage_log[0]
        assert log_entry.step_name == "test_step"
        assert log_entry.in_step_total_tokens > 0


# Additional test to specifically catch the missing step_name parameter bug
def test_ai_next_missing_step_name():
    """Test that reveals missing step_name parameter in buggy code."""
    ai = AI()
    
    # In buggy code, next() doesn't have step_name parameter
    # In fixed code, it does (as keyword-only)
    
    # Check the signature
    import inspect
    sig = inspect.signature(ai.next)
    
    # In fixed code, signature should include step_name parameter
    parameters = list(sig.parameters.keys())
    
    # This assertion fails in buggy code, passes in fixed code
    assert 'step_name' in parameters, "AI.next() missing step_name parameter"
    
    # Also check it's keyword-only in fixed code
    param = sig.parameters['step_name']
    assert param.kind == inspect.Parameter.KEYWORD_ONLY, "step_name should be keyword-only"


