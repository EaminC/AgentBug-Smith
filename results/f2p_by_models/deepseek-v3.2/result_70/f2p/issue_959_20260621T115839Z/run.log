# mypy: disable-error-code="index"
"""Test reset_equipped_tools behavior regarding persistent tool group activation."""
from unittest import IsolatedAsyncioTestCase

from agentscope.message import ToolUseBlock, TextBlock
from agentscope.tool import ToolResponse, Toolkit


def dummy_tool() -> ToolResponse:
    """A dummy tool function for testing."""
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text="dummy",
            ),
        ],
    )


class TestResetEquippedToolsPersistentActivation(IsolatedAsyncioTestCase):
    """Test that reset_equipped_tools properly handles tool group activation state."""

    async def asyncSetUp(self) -> None:
        """Set up the test environment before each test."""
        self.toolkit = Toolkit()

    async def test_reset_equipped_tools_resets_all_groups(self) -> None:
        """
        Test that reset_equipped_tools deactivates all groups not explicitly
        activated in the current call, addressing the issue that previously
        activated groups would remain active across multiple calls.
        """
        # Create two tool groups
        self.toolkit.create_tool_group(
            "group1",
            "First tool group.",
        )
        self.toolkit.create_tool_group(
            "group2",
            "Second tool group.",
        )

        # Register a tool in each group
        self.toolkit.register_tool_function(
            dummy_tool,
            group_name="group1",
        )
        self.toolkit.register_tool_function(
            dummy_tool,
            group_name="group2",
        )

        # Register the meta tool
        self.toolkit.register_tool_function(
            self.toolkit.reset_equipped_tools,
        )

        # First call: activate only group1
        res = await self.toolkit.call_tool_function(
            ToolUseBlock(
                type="tool_use",
                id="call1",
                name="reset_equipped_tools",
                input={"group1": True},
            ),
        )

        # Verify activation
        async for chunk in res:
            self.assertIn("group1", chunk.content[0]["text"])
            self.assertNotIn("group2", chunk.content[0]["text"])

        # Check that only group1's tool is available
        schemas = self.toolkit.get_json_schemas()
        # Should have meta tool + dummy_tool (from group1)
        self.assertEqual(len(schemas), 2)
        tool_names = {s["function"]["name"] for s in schemas}
        self.assertIn("reset_equipped_tools", tool_names)
        self.assertIn("dummy_tool", tool_names)

        # Second call: activate only group2
        res = await self.toolkit.call_tool_function(
            ToolUseBlock(
                type="tool_use",
                id="call2",
                name="reset_equipped_tools",
                input={"group2": True},
            ),
        )

        # Verify activation
        async for chunk in res:
            self.assertIn("group2", chunk.content[0]["text"])
            # In buggy version, group1 might still be mentioned if not deactivated
            # In fixed version, group1 should not be mentioned
            self.assertNotIn("group1", chunk.content[0]["text"])

        # Check that only group2's tool is available now
        schemas = self.toolkit.get_json_schemas()
        # Should have meta tool + dummy_tool (from group2)
        self.assertEqual(len(schemas), 2)
        tool_names = {s["function"]["name"] for s in schemas}
        self.assertIn("reset_equipped_tools", tool_names)
        self.assertIn("dummy_tool", tool_names)

        # Verify that group1's tool is NOT accessible (should be inactive)
        res = await self.toolkit.call_tool_function(
            ToolUseBlock(
                type="tool_use",
                id="call3",
                name="dummy_tool",
                input={},
            ),
        )
        async for chunk in res:
            # In buggy version, the tool might still work
            # In fixed version, should get FunctionInactiveError
            self.assertIn("FunctionInactiveError", chunk.content[0]["text"])
            self.assertIn("inactive group", chunk.content[0]["text"])

    async def test_reset_equipped_tools_with_no_args_deactivates_all(self) -> None:
        """
        Test that reset_equipped_tools with empty input deactivates all groups.
        """
        # Create a tool group and activate it
        self.toolkit.create_tool_group(
            "test_group",
            "Test tool group.",
        )
        self.toolkit.register_tool_function(
            dummy_tool,
            group_name="test_group",
        )
        self.toolkit.register_tool_function(
            self.toolkit.reset_equipped_tools,
        )

        # Activate the group
        res = await self.toolkit.call_tool_function(
            ToolUseBlock(
                type="tool_use",
                id="call1",
                name="reset_equipped_tools",
                input={"test_group": True},
            ),
        )
        async for chunk in res:
            self.assertIn("test_group", chunk.content[0]["text"])

        # Verify tool is accessible
        schemas = self.toolkit.get_json_schemas()
        self.assertEqual(len(schemas), 2)  # meta + dummy_tool

        # Now deactivate all groups
        res = await self.toolkit.call_tool_function(
            ToolUseBlock(
                type="tool_use",
                id="call2",
                name="reset_equipped_tools",
                input={},
            ),
        )
        async for chunk in res:
            self.assertIn("deactivated", chunk.content[0]["text"])

        # Verify only meta tool remains
        schemas = self.toolkit.get_json_schemas()
        self.assertEqual(len(schemas), 1)
        self.assertEqual(schemas[0]["function"]["name"], "reset_equipped_tools")

        # Verify tool is not accessible
        res = await self.toolkit.call_tool_function(
            ToolUseBlock(
                type="tool_use",
                id="call3",
                name="dummy_tool",
                input={},
            ),
        )
        async for chunk in res:
            self.assertIn("FunctionInactiveError", chunk.content[0]["text"])

    async def test_reset_equipped_tools_activates_multiple_groups(self) -> None:
        """
        Test that reset_equipped_tools can activate multiple groups at once.
        """
        # Create two tool groups
        self.toolkit.create_tool_group(
            "group_a",
            "Group A tools.",
        )
        self.toolkit.create_tool_group(
            "group_b",
            "Group B tools.",
        )

        # Register tools
        self.toolkit.register_tool_function(
            dummy_tool,
            group_name="group_a",
        )
        self.toolkit.register_tool_function(
            dummy_tool,
            group_name="group_b",
        )
        self.toolkit.register_tool_function(
            self.toolkit.reset_equipped_tools,
        )

        # Activate both groups
        res = await self.toolkit.call_tool_function(
            ToolUseBlock(
                type="tool_use",
                id="call1",
                name="reset_equipped_tools",
                input={"group_a": True, "group_b": True},
            ),
        )
        async for chunk in res:
            self.assertIn("group_a", chunk.content[0]["text"])
            self.assertIn("group_b", chunk.content[0]["text"])

        # Both tools should be accessible
        schemas = self.toolkit.get_json_schemas()
        self.assertEqual(len(schemas), 3)  # meta + 2*dummy_tool

    async def asyncTearDown(self) -> None:
        """Clean up after each test."""
        self.toolkit = None[0m
