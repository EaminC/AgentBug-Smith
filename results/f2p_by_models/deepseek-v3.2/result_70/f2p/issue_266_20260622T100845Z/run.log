@patch('mle.utils.memory.get_config')
def test_integration(mock_get_config):
    mock_get_config.return_value = {"platform": "Local"}

    with patch('lancedb.connect') as mock_connect:
        mock_client = MagicMock()
        mock_connect.return_value = mock_client
        mock_client.table_names.return_value = []
        mock_table = MagicMock()
        mock_client.open_table.return_value = mock_table
        mock_client.create_table.return_value = mock_table
        # Mock add method (which is already present in buggy version)
        mock_table.add.return_value = None
        # Mock search for list_all_keys
        mock_table.search.return_value.to_list.return_value = [{"id": "id1"}, {"id": "id2"}]
        # Mock search chain for get
        mock_table.search.return_value.where.return_value.limit.return_value.to_list.return_value = [{"id": "id1", "data": "test"}]
        # Mock delete
        mock_table.delete.return_value = True

        tmpdir = tempfile.mkdtemp()
        try:
            memory = LanceDBMemory(project_path=tmpdir)
            # Add a record
            memory.add([{"id": "id1", "text": "test", "metadata": {"key": "value"}}])
            # List keys
            keys = memory.list_all_keys()
            assert keys == ["id1", "id2"]
            # Get by id
            record = memory.get("id1")
            assert record == [{"id": "id1", "data": "test"}]
            # Get by metadata
            records = memory.get_by_metadata("key", "value")
            assert records == [{"id": "1", "metadata": {"key": "value"}}]
            # Delete by metadata
            success = memory.delete_by_metadata("key", "value")
            assert success is True
        finally:
            import shutil
            shutil.rmtree(tmpdir, ignore_errors=True)[0m
