import os
from unittest.mock import MagicMock, patch
import pytest

from mle.utils.memory import LanceDBMemory


def test_list_all_keys():
    with patch('mle.utils.memory.get_config') as mock_get_config:
        mock_get_config.return_value = {"platform": "OpenAI", "api_key": "test-key"}
        with patch('lancedb.connect') as mock_connect:
            mock_client = MagicMock()
            mock_connect.return_value = mock_client
            mock_client.table_names.return_value = ["memory"]
            mock_table = MagicMock()
            mock_client.open_table.return_value = mock_table
            mock_fts = MagicMock()
            mock_table.search.return_value = mock_fts
            mock_fts.to_list.return_value = [{"id": "id1"}, {"id": "id2"}]

            tmpdir = tempfile.mkdtemp()
            try:
                memory = LanceDBMemory(project_path=tmpdir)
                keys = memory.list_all_keys()
                assert keys == ["id1", "id2"]
                mock_client.open_table.assert_called_with("memory")
                mock_table.search.assert_called_with(query_type="fts")
            finally:
                os.rmdir(tmpdir)


