        memory = LanceDBMemory(project_path=tmpdir)
        memory.add(
            [
                {"id": "key1", "text": "text1", "metadata": {"source": "file1", "type": "txt"}},
                {"id": "key2", "text": "text2", "metadata": {"source": "file2", "type": "txt"}},
                {"id": "key3", "text": "text3", "metadata": {"source": "file3", "type": "md"}},
            ]
        )

        # Delete by metadata
        success = memory.delete_by_metadata("type", "txt")
        assert success is True

        # Verify deletion
        remaining = memory.list_all_keys()
        assert remaining == ["key3"]
    finally:
        import shutil
        shutil.rmtree(tmpdir, ignore_errors=True)


