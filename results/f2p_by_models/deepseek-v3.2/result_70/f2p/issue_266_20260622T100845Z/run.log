        ids = {item["id"] for item in results}
        assert "id1" in ids
        assert "id2" in ids
        assert "id3" not in ids
    finally:
        import shutil
        shutil.rmtree(tmpdir, ignore_errors=True)


def test_delete_by_metadata():
    tmpdir = tempfile.mkdtemp()
    try:
        config_path = os.path.join(tmpdir, ".mle", "config.json")
        os.makedirs(os.path.dirname(config_path), exist_ok=True)
        with open(config_path, "w") as f:
            f.write('{"platform": "Local"}')

        memory = LanceDBMemory(project_path=tmpdir)
        memory.add(
            [
                {"id": "del1", "text": "t1", "metadata": {"flag": "remove"}},
                {"id": "del2", "text": "t2", "metadata": {"flag": "remove"}},
                {"id": "keep", "text": "t3", "metadata": {"flag": "keep"}},
            ]
        )
        # Delete by metadata
        success = memory.delete_by_metadata("flag", "remove")
        assert success is True
