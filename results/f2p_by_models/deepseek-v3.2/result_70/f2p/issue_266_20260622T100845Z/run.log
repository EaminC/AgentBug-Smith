import os
import pytest
from mle.utils.memory import LanceDBMemory


def test_list_all_keys():
    # Create a temporary directory for the project
    tmpdir = tempfile.mkdtemp()
    try:
        # Ensure a config exists
        config_path = os.path.join(tmpdir, ".mle", "config.json")
        os.makedirs(os.path.dirname(config_path), exist_ok=True)
        with open(config_path, "w") as f:
            f.write('{"platform": "Local"}')

        # Initialize memory with a temporary path
        memory = LanceDBMemory(project_path=tmpdir)

        # Add some data
        memory.add(
            [
                {"id": "key1", "text": "text1", "metadata": {"source": "file1"}},
                {"id": "key2", "text": "text2", "metadata": {"source": "file2"}},
            ]
        )

        # List keys
        keys = memory.list_all_keys()
        assert isinstance(keys, list)
        assert set(keys) == {"key1", "key2"}
    finally:
        import shutil
        shutil.rmtree(tmpdir, ignore_errors=True)


def test_get():
    tmpdir = tempfile.mkdtemp()
    try:
        config_path = os.path.join(tmpdir, ".mle", "config.json")
        os.makedirs(os.path.dirname(config_path), exist_ok=True)
        with open(config_path, "w") as f:
            f.write('{"platform": "Local"}')

        memory = LanceDBMemory(project_path=tmpdir)
        memory.add(
            [
                {"id": "key1", "text": "text1", "metadata": {"source": "file1"}},
                {"id": "key2", "text": "text2", "metadata": {"source": "file2"}},
            ]
        )

        # Get existing key
        result = memory.get("key1")
        assert isinstance(result, list)
        assert len(result) == 1
        assert result[0]["id"] == "key1"
        assert result[0]["text"] == "text1"

        # Get non‑existent key
        result = memory.get("nonexistent")
        assert isinstance(result, list)
        assert len(result) == 0
    finally:
        import shutil
        shutil.rmtree(tmpdir, ignore_errors=True)


def test_get_by_metadata():
    tmpdir = tempfile.mkdtemp()
    try:
        config_path = os.path.join(tmpdir, ".mle", "config.json")
        os.makedirs(os.path.dirname(config_path), exist_ok=True)
        with open(config_path, "w") as f:
            f.write('{"platform": "Local"}')

        memory = LanceDBMemory(project_path=tmpdir)
        memory.add(
            [
                {"id": "key1", "text": "text1", "metadata": {"source": "file1", "type": "txt"}},
                {"id": "key2", "text": "text2", "metadata": {"source": "file2", "type": "txt"}},
                {"id": "key3", "text": "text3", "metadata": {"source": "file3", "type": "md"}},
            ]
        )

        # Get by metadata
        results = memory.get_by_metadata("type", "txt")
        assert isinstance(results, list)
        assert len(results) == 2
        ids = {r["id"] for r in results}
        assert ids == {"key1", "key2"}

        # Limit results
        results = memory.get_by_metadata("type", "txt", n_results=1)
        assert isinstance(results, list)
        assert len(results) == 1
        assert results[0]["metadata"]["type"] == "txt"
    finally:
        import shutil
        shutil.rmtree(tmpdir, ignore_errors=True)


def test_delete_by_metadata():
    tmpdir = tempfile.mkdtemp()
    try:
        config_path = os.path.join(tmpdir, ".mle", "config.json")
        os.makedirs(os.path.dirname(config_path), exist_ok=True)
        with open(config_path, "w") as f:
