[32mimport os
import tempfile
import pytest
from mle.utils.memory import LanceDBMemory


def test_list_all_keys():
    # Create a temporary directory for the project
    tmpdir = tempfile.mkdtemp()
    try:
        # Ensure a config exists
        config_path = os.path.join(tmpdir, ".mle", "config.json")
        os.makedirs(os.path.dirname(config_path), exist_ok=True)
        with open(config_path, "w") as f:
            f.write('{"platform": "Local"}')

        # Initialize memory with a temporary path
        memory = LanceDBMemory(project_path=tmpdir)
        # Add some data
        memory.add(
            [
                {"id": "key1", "text": "text1", "metadata": {"tag": "a"}},
                {"id": "key2", "text": "text2", "metadata": {"tag": "b"}},
            ]
        )
        # List keys
        keys = memory.list_all_keys()
        assert isinstance(keys, list)
        assert "key1" in keys
        assert "key2" in keys
    finally:
        import shutil
        shutil.rmtree(tmpdir, ignore_errors=True)


def test_get():
    tmpdir = tempfile.mkdtemp()
    try:
        config_path = os.path.join(tmpdir, ".mle", "config.json")
        os.makedirs(os.path.dirname(config_path), exist_ok=True)
        with open(config_path, "w") as f:
            f.write('{"platform": "Local"}')

        memory = LanceDBMemory(project_path=tmpdir)
        memory.add([{"id": "test_id", "text": "test text", "metadata": {"foo": "bar"}}])
        result = memory.get("test_id")
        assert isinstance(result, list)
        assert len(result) == 1
        assert result[0]["id"] == "test_id"
        assert result[0]["text"] == "test text"
    finally:
        import shutil
        shutil.rmtree(tmpdir, ignore_errors=True)


def test_get_by_metadata():
    tmpdir = tempfile.mkdtemp()
    try:
        config_path = os.path.join(tmpdir, ".mle", "config.json")
        os.makedirs(os.path.dirname(config_path), exist_ok=True)
        with open(config_path, "w") as f:
            f.write('{"platform": "Local"}')

        memory = LanceDBMemory(project_path=tmpdir)
        memory.add(
            [
                {"id": "id1", "text": "text1", "metadata": {"category": "news"}},
                {"id": "id2", "text": "text2", "metadata": {"category": "news"}},
                {"id": "id3", "text": "text3", "metadata": {"category": "blog"}},
            ]
        )
        results = memory.get_by_metadata("category", "news")
