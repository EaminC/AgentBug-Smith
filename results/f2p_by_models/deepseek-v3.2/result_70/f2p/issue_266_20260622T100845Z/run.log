[32mimport os
import tempfile
import shutil
import pytest
from mle.utils.memory import LanceDBMemory


def test_list_all_keys():
    # Create a temporary directory for the project
    tmpdir = tempfile.mkdtemp()
    try:
        # Initialize memory with a temporary path
        memory = LanceDBMemory(project_path=tmpdir, embedding_model="sentence-transformers/all-MiniLM-L6-v2")
        
        # Add some data
        data = [
            {
                "id": "test_id_1",
                "text": "This is a test query 1",
                "metadata": {"source": "test", "type": "example"}
            },
            {
                "id": "test_id_2",
                "text": "This is a test query 2",
                "metadata": {"source": "test", "type": "example"}
            }
        ]
        memory.add(data, table_name="test_table")
        
        # Test list_all_keys
        keys = memory.list_all_keys(table_name="test_table")
        assert isinstance(keys, list)
        assert len(keys) == 2
        assert "test_id_1" in keys
        assert "test_id_2" in keys
        
        # Test with default table name
        memory2 = LanceDBMemory(project_path=tmpdir, embedding_model="sentence-transformers/all-MiniLM-L6-v2")
        memory2.add(data)
        keys2 = memory2.list_all_keys()
        assert len(keys2) == 2
        
    finally:
        # Clean up
        shutil.rmtree(tmpdir, ignore_errors=True)


def test_get():
    tmpdir = tempfile.mkdtemp()
    try:
        memory = LanceDBMemory(project_path=tmpdir, embedding_model="sentence-transformers/all-MiniLM-L6-v2")
        
        data = [
            {
                "id": "get_test_id",
                "text": "Query for get test",
                "metadata": {"source": "test", "type": "get"}
            }
        ]
        memory.add(data, table_name="test_table")
        
        # Test get with existing ID
        result = memory.get("get_test_id", table_name="test_table")
        assert isinstance(result, list)
        assert len(result) == 1
        assert result[0]["id"] == "get_test_id"
        assert result[0]["text"] == "Query for get test"
        
        # Test get with non-existent ID
        result2 = memory.get("non_existent_id", table_name="test_table")
        assert isinstance(result2, list)
        assert len(result2) == 0
        
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def test_get_by_metadata():
    tmpdir = tempfile.mkdtemp()
    try:
        memory = LanceDBMemory(project_path=tmpdir, embedding_model="sentence-transformers/all-MiniLM-L6-v2")
        
        data = [
            {
                "id": "meta_test_1",
                "text": "First metadata test",
                "metadata": {"category": "A", "status": "active"}
            },
            {
                "id": "meta_test_2",
                "text": "Second metadata test",
                "metadata": {"category": "B", "status": "active"}
            },
            {
                "id": "meta_test_3",
                "text": "Third metadata test",
                "metadata": {"category": "A", "status": "inactive"}
            }
        ]
        memory.add(data, table_name="test_table")
        
        # Test get_by_metadata with category A
        results = memory.get_by_metadata("category", "A", table_name="test_table")
        assert isinstance(results, list)
        assert len(results) == 2
        ids = [r["id"] for r in results]
        assert "meta_test_1" in ids
        assert "meta_test_3" in ids
        
        # Test get_by_metadata with status active
        results2 = memory.get_by_metadata("status", "active", table_name="test_table", n_results=10)
        assert len(results2) == 2
        ids2 = [r["id"] for r in results2]
        assert "meta_test_1" in ids2
        assert "meta_test_2" in ids2
        
        # Test with n_results limit
        results3 = memory.get_by_metadata("category", "A", table_name="test_table", n_results=1)
        assert len(results3) == 1
        
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def test_delete_by_metadata():
    tmpdir = tempfile.mkdtemp()
    try:
        memory = LanceDBMemory(project_path=tmpdir, embedding_model="sentence-transformers/all-MiniLM-L6-v2")
        
        data = [
            {
                "id": "delete_meta_1",
                "text": "To be deleted",
                "metadata": {"group": "temp", "flag": "delete"}
            },
            {
                "id": "delete_meta_2",
                "text": "Also to be deleted",
                "metadata": {"group": "temp", "flag": "delete"}
            },
            {
                "id": "keep_meta_1",
                "text": "Should be kept",
                "metadata": {"group": "perm", "flag": "keep"}
            }
        ]
        memory.add(data, table_name="test_table")
        
        # Verify initial state
        initial_keys = memory.list_all_keys(table_name="test_table")
        assert len(initial_keys) == 3
        
        # Delete by metadata
        result = memory.delete_by_metadata("flag", "delete", table_name="test_table")
        assert result is True
        
        # Verify deletion
        remaining_keys = memory.list_all_keys(table_name="test_table")
        assert len(remaining_keys) == 1
        assert "keep_meta_1" in remaining_keys
        
        # Verify the remaining record
        remaining = memory.get("keep_meta_1", table_name="test_table")
        assert len(remaining) == 1
        assert remaining[0]["metadata"]["flag"] == "keep"
        
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


