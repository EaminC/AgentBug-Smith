[32mimport tempfile
import pytest
from mle.utils.memory import LanceDBMemory


def test_list_all_keys():
    # Create a temporary directory for the project
    tmpdir = tempfile.mkdtemp()
    try:
        # Initialize memory with a temporary path
        memory = LanceDBMemory(project_path=tmpdir)
        # Add some records
        memory.add(
            [
                {"id": "id1", "text": "text1", "metadata": {"key": "value1"}},
                {"id": "id2", "text": "text2", "metadata": {"key": "value2"}},
            ]
        )
        # List all keys
        keys = memory.list_all_keys()
        assert isinstance(keys, list)
        assert len(keys) == 2
        assert "id1" in keys
        assert "id2" in keys
    finally:
        import shutil
        shutil.rmtree(tmpdir, ignore_errors=True)


def test_get():
    tmpdir = tempfile.mkdtemp()
    try:
        memory = LanceDBMemory(project_path=tmpdir)
        memory.add(
            [
                {"id": "id1", "text": "text1", "metadata": {"key": "value1"}},
                {"id": "id2", "text": "text2", "metadata": {"key": "value2"}},
            ]
        )
        # Get existing record
        result = memory.get("id1")
        assert isinstance(result, list)
        assert len(result) == 1
        assert result[0]["id"] == "id1"
        # Get non-existing record
        result = memory.get("nonexistent")
        assert isinstance(result, list)
        assert len(result) == 0
    finally:
        import shutil
        shutil.rmtree(tmpdir, ignore_errors=True)


def test_get_by_metadata():
    tmpdir = tempfile.mkdtemp()
    try:
        memory = LanceDBMemory(project_path=tmpdir)
        memory.add(
            [
                {"id": "id1", "text": "text1", "metadata": {"key": "value1", "type": "A"}},
                {"id": "id2", "text": "text2", "metadata": {"key": "value2", "type": "B"}},
                {"id": "id3", "text": "text3", "metadata": {"key": "value1", "type": "A"}},
            ]
        )
        # Get by metadata
        results = memory.get_by_metadata("type", "A")
        assert isinstance(results, list)
        assert len(results) == 2
        ids = {r["id"] for r in results}
        assert ids == {"id1", "id3"}
        # Limit results
        results = memory.get_by_metadata("key", "value1", n_results=1)
        assert isinstance(results, list)
        assert len(results) == 1
        assert results[0]["id"] in ("id1", "id3")
    finally:
        import shutil
        shutil.rmtree(tmpdir, ignore_errors=True)


def test_delete_by_metadata():
    tmpdir = tempfile.mkdtemp()
    try:
        memory = LanceDBMemory(project_path=tmpdir)
        memory.add(
            [
                {"id": "id1", "text": "text1", "metadata": {"key": "value1", "type": "A"}},
                {"id": "id2", "text": "text2", "metadata": {"key": "value2", "type": "B"}},
                {"id": "id3", "text": "text3", "metadata": {"key": "value1", "type": "A"}},
            ]
        )
        # Delete by metadata
        result = memory.delete_by_metadata("type", "A")
        assert result is True
        # Verify deletion
        remaining = memory.list_all_keys()
        assert len(remaining) == 1
        assert remaining[0] == "id2"
        # Delete non-existing metadata
        result = memory.delete_by_metadata("type", "C")
        assert result is True  # LanceDB delete returns True even if no rows match
    finally:
        import shutil
        shutil.rmtree(tmpdir, ignore_errors=True)


