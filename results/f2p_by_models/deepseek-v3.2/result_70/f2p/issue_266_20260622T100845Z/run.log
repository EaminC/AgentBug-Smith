        config_path = os.path.join(tmpdir, ".mle", "config.json")
        os.makedirs(os.path.dirname(config_path), exist_ok=True)
        with open(config_path, "w") as f:
            f.write('{"platform": "Local"}')

        memory = LanceDBMemory(project_path=tmpdir)

        memory.add(
            [
                {"id": "key1", "text": "text1", "metadata": {"source": "file1", "type": "txt"}},
                {"id": "key2", "text": "text2", "metadata": {"source": "file2", "type": "txt"}},
                {"id": "key3", "text": "text3", "metadata": {"source": "file3", "type": "md"}},
            ]
        )

        # Get by metadata
        records = memory.get_by_metadata("type", "txt")
        assert isinstance(records, list)
