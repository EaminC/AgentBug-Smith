def test_serve_command_log_level():
    """
    Test that `mle serve` sets log_level="critical" in uvicorn.run.
    In the buggy version, log_level is not set (defaults to "info").
    After the fix, log_level="critical" is passed.
    """
    runner = CliRunner()
    try:
        import mle.cli
        import uvicorn
    except ImportError:
        raise

    # Mock uvicorn.run to capture its arguments
    original_run = uvicorn.run
    call_args = []
    def mock_run(app, host='0.0.0.0', port=8000, **kwargs):
        call_args.append((app, host, port, kwargs))
    uvicorn.run = mock_run

    try:
        result = runner.invoke(mle.cli.cli, ['serve', '--host=0.0.0.0', '--port=8000'])
        # Command should succeed
        assert result.exit_code == 0
        # Check that log_level is passed
        assert len(call_args) == 1
        _, _, _, kwargs = call_args[0]
        # In buggy version, log_level is not in kwargs.
        # After fix, log_level="critical" is present.
        assert 'log_level' in kwargs
        assert kwargs['log_level'] == 'critical'
    finally:
        uvicorn.run = original_run

