from click.testing import CliRunner
import sys
import os

def test_report_command_without_visualize_does_not_start_web():
    """
    Test that `mle report --visualize=False` does not start web servers.
    In the buggy version, the `--visualize` option does not exist, so the command fails.
    After the fix, the option exists and the command should succeed (with mocked dependencies).
    """
    runner = CliRunner()
    try:
        import mle.cli
        import mle.utils.system
        import mle.workflow
        import questionary
    except ImportError:
        raise

    # Mock questionary.text to avoid interactive prompts
    original_text = questionary.text
    questionary.text = lambda prompt: lambda: "MLSysOps/MLE-agent" if "repository" in prompt else "testuser"
    # Mock check_config to return True to skip project creation
    original_check_config = mle.utils.system.check_config
    mle.utils.system.check_config = lambda console: True
    # Mock workflow.report to avoid actual report generation
    original_report = mle.workflow.report
    mle.workflow.report = lambda work_dir, repo, user, model: True

    try:
        result = runner.invoke(mle.cli.cli, ['report', '--visualize=False', '--model=test', '--user=testuser', 'MLSysOps/MLE-agent'])
        # In buggy version, --visualize is unknown, so exit_code != 0.
        # After fix, exit_code == 0.
        assert result.exit_code == 0
    finally:
        questionary.text = original_text
        mle.utils.system.check_config = original_check_config
        mle.workflow.report = original_report

