    questionary.text = lambda prompt: lambda: "MLSysOps/MLE-agent" if "repository" in prompt else "testuser"
    # Mock check_config to return True to skip project creation
    original_check_config = mle.utils.system.check_config
    mle.utils.system.check_config = lambda console: True
    # Mock workflow.report to avoid actual report generation
    original_report = mle.workflow.report
    mle.workflow.report = lambda work_dir, repo, user, model: True
    # Mock ThreadPoolExecutor to avoid actually starting threads
    original_ThreadPoolExecutor = ThreadPoolExecutor
    class MockThreadPoolExecutor:
        def __enter__(self):
            return self
        def __exit__(self, *args):
            pass
        def submit(self, fn, *args, **kwargs):
            # Immediately call the function and return a mock future
            class MockFuture:
                def result(self):
                    return fn(*args, **kwargs)
            return MockFuture()
    ThreadPoolExecutor = MockThreadPoolExecutor
    # Mock serve and web commands to avoid starting servers
    original_serve = mle.cli.serve
    # In buggy version, mle.cli.web does not exist
    try:
        original_web = mle.cli.web
    except AttributeError:
        original_web = None
    mle.cli.serve = lambda host='0.0.0.0', port=8000: None
    mle.cli.web = lambda host='0.0.0.0', port=3000: None

    try:
        result = runner.invoke(mle.cli.cli, ['report', '--model=test', '--user=testuser', 'MLSysOps/MLE-agent'])
        # In buggy version, --visualize is unknown, so exit_code != 0.
        # After fix, exit_code == 0.
        assert result.exit_code == 0
    finally:
        questionary.text = original_text
        mle.utils.system.check_config = original_check_config
        mle.workflow.report = original_report
        ThreadPoolExecutor = original_ThreadPoolExecutor
        mle.cli.serve = original_serve
        if original_web is not None:
            mle.cli.web = original_web

def test_serve_command_log_level():
    """
    Test that `mle serve` sets log_level="critical" in uvicorn.run.
    In the buggy version, log_level is not set (defaults to "info").
    After the fix, log_level="critical" is passed.
    """
    runner = click.testing.CliRunner()
    try:
        import mle.cli
        import uvicorn
    except ImportError:
        raise

    # Mock uvicorn.run to capture its arguments
    original_run = uvicorn.run
    call_args = []
    def mock_run(app, host='0.0.0.0', port=8000, **kwargs):
        call_args.append((app, host, port, kwargs))
    uvicorn.run = mock_run

    try:
        result = runner.invoke(mle.cli.cli, ['serve', '--host=0.0.0.0', '--port=8000'])
        # Command should succeed
        assert result.exit_code == 0
        # Check that log_level is passed
        assert len(call_args) == 1
        _, _, _, kwargs = call_args[0]
        # In buggy version, log_level is not in kwargs.
        # After fix, log_level="critical" is present.
        assert 'log_level' in kwargs
        assert kwargs['log_level'] == 'critical'
    finally:
        uvicorn.run = original_run

