def test_report_command_without_visualize_does_not_start_web():
    """
    Test that `mle report --visualize=False` does not start web servers.
    In the buggy version, the `--visualize` option does not exist, so the command fails.
    After the fix, the option exists and the command should succeed (with mocked dependencies).
    """
    runner = CliRunner()
    # In buggy version, --visualize is unknown, so exit_code != 0.
    # After fix, exit_code == 0.
    # We'll mock dependencies to avoid interactive prompts and external calls.
    try:
        import mle.cli
        import mle.utils.system
        import mle.workflow
    except ImportError:
        # If dependencies missing, let test crash (as per rule).
        raise

    # Mock questionary.text to avoid interactive prompts
    original_text = mle.cli.questionary.text
    try:
        mle.cli.questionary.text = lambda prompt: lambda: "MLSysOps/MLE-agent" if "repository" in prompt else "testuser"
        # Mock check_config to return True to skip project creation
        original_check_config = mle.utils.system.check_config
        mle.utils.system.check_config = lambda console: True
        # Mock workflow.report to avoid actual report generation
        original_report = mle.workflow.report
        mle.workflow.report = lambda work_dir, repo, user, model: True

        result = runner.invoke(mle.cli.cli, ['report', '--visualize=False', '--model=test', '--user=testuser', 'MLSysOps/MLE-agent'])
        # In buggy version, --visualize is unknown, so exit_code != 0.
        # After fix, exit_code == 0.
        assert result.exit_code == 0
    finally:
        mle.cli.questionary.text = original_text
        mle.utils.system.check_config = original_check_config
        mle.workflow.report = original_report


def test_report_command_with_visualize_starts_web():
    """
    Test that `mle report` with visualize=True (default) tries to start web servers.
    In the buggy version, there is no `visualize` option and no web server startup.
    After the fix, it should attempt to start the web server via `startup_web`.
    We mock subprocess to avoid actually running pnpm/npm.
    """
    runner = CliRunner()
    # In buggy version, there is no `visualize` option, so command fails.
    # After fix, command should try to start web servers.
    # We'll mock subprocess.run and check_installed to avoid actual execution.
    try:
        import mle.cli
        import mle.utils.system
        import mle.workflow
    except ImportError:
        raise

    # Check if check_installed exists (only in fixed version)
    if not hasattr(mle.utils.system, 'check_installed'):
        # In buggy version, check_installed does not exist, so the command will fail.
        # We'll run the command and expect a failure.
        result = runner.invoke(mle.cli.cli, ['report', '--visualize=True', 'MLSysOps/MLE-agent', '--user=testuser', '--model=test'])
        # The command should fail because --visualize is unknown.
        assert result.exit_code != 0
        return

    # Fixed version: mock dependencies
    original_run = subprocess.run
    original_check_installed = mle.utils.system.check_installed
    original_startup_web = mle.utils.system.startup_web
    try:
        # Mock subprocess.run to do nothing
        subprocess.run = lambda *args, **kwargs: type('obj', (object,), {'returncode': 0})()
        # Mock check_installed to return True
        mle.utils.system.check_installed = lambda name: True
        # Mock startup_web to avoid actually starting web server
        mle.utils.system.startup_web = lambda host, port: None
        # Mock ThreadPoolExecutor to avoid actual threading
        import concurrent.futures
        original_ThreadPoolExecutor = concurrent.futures.ThreadPoolExecutor
        class MockThreadPoolExecutor:
            def __enter__(self):
                return self
            def __exit__(self, *args):
                pass
            def submit(self, func, *args):
                # Call the function immediately to simulate execution
                func(*args)
                return type('obj', (object,), {'result': lambda: None})()
        concurrent.futures.ThreadPoolExecutor = MockThreadPoolExecutor
        # Mock questionary.text to avoid interactive prompts
        original_text = mle.cli.questionary.text
        mle.cli.questionary.text = lambda prompt: lambda: "MLSysOps/MLE-agent" if "repository" in prompt else "testuser"
        # Mock check_config to return True
        original_check_config = mle.utils.system.check_config
        mle.utils.system.check_config = lambda console: True
        # Mock workflow.report to avoid actual report generation
        original_report = mle.workflow.report
        mle.workflow.report = lambda work_dir, repo, user, model: True

        result = runner.invoke(mle.cli.cli, ['report', '--visualize=True', 'MLSysOps/MLE-agent', '--user=testuser', '--model=test'])
        # Command should succeed
        assert result.exit_code == 0
    finally:
        subprocess.run = original_run
        mle.utils.system.check_installed = original_check_installed
        mle.utils.system.startup_web = original_startup_web
        if 'original_ThreadPoolExecutor' in locals():
            concurrent.futures.ThreadPoolExecutor = original_ThreadPoolExecutor
        if 'original_text' in locals():
            mle.cli.questionary.text = original_text
        if 'original_check_config' in locals():
            mle.utils.system.check_config = original_check_config
        if 'original_report' in locals():
            mle.workflow.report = original_report


def test_serve_command_log_level():
    """
    Test that `mle serve` sets log_level="critical" in uvicorn.run.
    In the buggy version, log_level is not set (defaults to "info").
    After the fix, log_level="critical" is passed.
    """
    runner = CliRunner()
    try:
        import mle.cli
        import uvicorn
    except ImportError:
        raise

    # Mock uvicorn.run to capture its arguments
    original_run = uvicorn.run
    call_args = []
    def mock_run(app, host='0.0.0.0', port=8000, **kwargs):
        call_args.append((app, host, port, kwargs))
    uvicorn.run = mock_run

    try:
        result = runner.invoke(mle.cli.cli, ['serve', '--host=0.0.0.0', '--port=8000'])
        # Command should succeed
        assert result.exit_code == 0
        # Check that log_level is passed
        assert len(call_args) == 1
        _, _, _, kwargs = call_args[0]
        # In buggy version, log_level is not in kwargs.
        # After fix, log_level="critical" is present.
        assert 'log_level' in kwargs
        assert kwargs['log_level'] == 'critical'
    finally:
        uvicorn.run = original_run


