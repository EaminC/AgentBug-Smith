def test_web_command_exists():
    """
    After fix, the 'web' command should exist in the CLI.
    Buggy code does not have this command.
    """
    runner = CliRunner()
    # Try to invoke 'web' command
    result = runner.invoke(cli, ['web', '--help'])
    # In buggy code, this will fail because 'web' command not defined.
    # After fix, it should succeed (exit_code 0) or at least not raise unknown command.
    if result.exit_code == 2 and 'No such command' in result.output:
        # Buggy code: command not found
        # We'll let the test fail by asserting that command exists.
        assert False, "Command 'web' not found in buggy code"
    # After fix, the command should exist and --help should succeed.
    assert result.exit_code == 0


