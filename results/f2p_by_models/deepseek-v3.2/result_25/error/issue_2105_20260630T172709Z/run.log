    apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        git \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy entire repository (required for external test scripts)
COPY . .

# Upgrade pip and setuptools
RUN python -m pip install --upgrade pip wheel

