    def test_gen_report_endpoint_missing_token_calls_ask_github_token(self):
        """Test that when token is omitted, ask_github_token is called."""
        from mle.workflow.report import ask_github_token
        with patch('mle.workflow.report.ask_github_token') as mock_ask:
            mock_ask.return_value = "dummy_token"
            with patch('mle.workflow.report.report') as mock_report:
                mock_report.return_value = "Report generated"
                client = TestClient(app)
                response = client.post(
                    "/gen_report",
                    json={
                        "repo": "MLSysOps/MLE-agent",
                        "username": "testuser",
                        "okr": "Improve system efficiency by 20% this quarter"
                    }
                )
                # In buggy code, token is not a parameter, so ask_github_token is called with no default.
                # In fixed code, token is optional and defaults to None, so ask_github_token is called.
                # However, the buggy code does not have token parameter, so the call to report will fail.
                # We need to check if the endpoint succeeds or fails.
                if response.status_code == 200:
                    # Fixed code: token is optional, ask_github_token is called.
                    mock_report.assert_called_once()
                    # The call args should include token=None.
                    args, kwargs = mock_report.call_args
                    # In fixed code, token is passed as None.
