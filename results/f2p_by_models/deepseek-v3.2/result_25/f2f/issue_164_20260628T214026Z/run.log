from unittest.mock import patch, MagicMock

# Import the module under test
from mle import cli
import mle.workflow.report as report_module
from mle.utils.system import get_config, write_config


def test_report_command_without_repo_argument_prompts_user():
    """Test that `mle report` without repo argument prompts for GitHub repo."""
    runner = CliRunner()
    with patch('mle.cli.questionary.text') as mock_text:
        mock_text.return_value.ask.return_value = "MLSysOps/MLE-agent"
        with patch('mle.cli.check_config', return_value=True):
            with patch('mle.cli.workflow.report') as mock_report:
                mock_report.return_value = None
                result = runner.invoke(cli.cli, ['report'])
                assert result.exit_code == 0
                mock_text.assert_called_once_with(
                    "What is your GitHub repository? (e.g., MLSysOps/MLE-agent)"
                )
                mock_report.assert_called_once_with(
                    os.getcwd(), "MLSysOps/MLE-agent", None
                )


def test_report_command_with_invalid_repo_format():
    """Test that `mle report` with invalid repo format prints error and returns False."""
    runner = CliRunner()
    with patch('mle.cli.console.log') as mock_log:
        result = runner.invoke(cli.cli, ['report', 'invalidrepo'])
        assert result.exit_code == 0
        mock_log.assert_called_once_with(
            "Invalid github repository, Usage: 'mle report <organization/name>'"
        )


def test_report_command_with_valid_repo_and_existing_config():
    """Test `mle report owner/repo` when config exists."""
    runner = CliRunner()
    with patch('mle.cli.check_config', return_value=True):
        with patch('mle.cli.workflow.report') as mock_report:
            mock_report.return_value = None
            result = runner.invoke(cli.cli, ['report', 'owner/repo'])
            assert result.exit_code == 0
            mock_report.assert_called_once_with(
                os.getcwd(), 'owner/repo', None
            )


def test_report_command_with_valid_repo_and_no_config_creates_project():
    """Test `mle report owner/repo` when no config exists: should create new project."""
    runner = CliRunner()
    with patch('mle.cli.check_config', return_value=False):
        with patch('mle.cli.new') as mock_new:
            with patch('mle.cli.workflow.report') as mock_report:
                mock_report.return_value = None
                with patch('os.chdir'):
                    with patch('os.path.join', return_value='/tmp/mle-report-owner_repo'):
                        result = runner.invoke(cli.cli, ['report', 'owner/repo'])
                        assert result.exit_code == 0
                        mock_new.assert_called_once_with(
                            name='mle-report-owner_repo'
                        )
                        mock_report.assert_called_once_with(
                            '/tmp/mle-report-owner_repo', 'owner/repo', None
                        )


def test_report_workflow_calls_summary_agent_with_token():
    """Test that report workflow uses ask_github_token and passes token to SummaryAgent."""
    with tempfile.TemporaryDirectory() as tmpdir:
        work_dir = Path(tmpdir)
        github_repo = "owner/repo"
        mock_token = "fake_token_123"
        mock_model = MagicMock()
        mock_summary = {"summary": "test"}

        with patch('mle.workflow.report.load_model', return_value=mock_model):
            with patch('mle.workflow.report.ask_github_token', return_value=mock_token):
