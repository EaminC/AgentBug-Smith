    project_name = "mle-report-owner_repo"
    with patch('mle.cli.check_config', return_value=False):
        with patch('mle.cli.new') as mock_new:
            with patch('mle.cli.workflow.report') as mock_report:
                with patch('os.chdir'):
                    result = runner.invoke(cli.cli, ['report', valid_repo])
                    # Should invoke new command with project name
                    mock_new.assert_called_once_with(name=project_name)
                    # Should call report workflow with the new work_dir
                    expected_work_dir = os.path.join(os.getcwd(), project_name)
                    mock_report.assert_called_once_with(
                        expected_work_dir, valid_repo, None
                    )
                    assert result.exit_code == 0


