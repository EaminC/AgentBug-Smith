    """
    runner = CliRunner()
    from unittest.mock import patch
    with patch('mle.cli.check_config', return_value=True):
        with patch('mle.workflow.baseline') as mock_baseline:
            mock_baseline.return_value = True
            result = runner.invoke(cli_module.cli, ['start', 'general'])
            if result.exit_code == 0 and mock_baseline.called:
                # Fixed
                assert True
            else:
                # Buggy: baseline not called for 'general' mode
                assert False, "Buggy: baseline not called for 'general' mode"

