                                        # If ask_text was called, it's buggy.
                                        if mock_ask_text.called:
                                            assert False, "Buggy: report asked for github repo"
                                        else:
                                            # Fixed.
                                            assert True
                                    except TypeError:
                                        # Buggy: wrong signature.
                                        assert False, "Buggy: report function has wrong signature"
    else:
        # Buggy: report function not in module? (should be)
        assert False, "Buggy: report function missing"

