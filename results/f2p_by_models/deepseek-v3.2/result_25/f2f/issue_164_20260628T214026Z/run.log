                    mock_agent.summarize.return_value = mock_summary
                    MockSummaryAgent.return_value = mock_agent
                    with patch('mle.workflow.report.print_in_box'):
                        with patch('mle.workflow.report.Console') as MockConsole:
                            mock_console = MagicMock()
                            MockConsole.return_value = mock_console
                            # Call the report function
                            result = report_module.report(str(work_dir), github_repo, mock_model)
                            # Verify SummaryAgent was called with token
                            MockSummaryAgent.assert_called_once_with(
                                mock_model, github_repo=github_repo, github_token=mock_token
                            )
                            assert result is None  # report returns None


def test_report_workflow_asks_for_token_if_not_in_config():
    """Test that ask_github_token prompts for token if not in config."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = Path(tmpdir) / '.mle' / 'config.yaml'
        config_path.parent.mkdir(parents=True, exist_ok=True)
        config = {}
        with open(config_path, 'w') as f:
            yaml.dump(config, f)

        with patch.dict('os.environ', {'HOME': str(tmpdir)}):
            with patch('mle.workflow.report.questionary.password') as mock_password:
                mock_password.return_value.ask.return_value = "new_token"
                with patch('mle.workflow.report.write_config') as mock_write:
                    token = report_module.ask_github_token()
                    # Should prompt for token
                    mock_password.assert_called_once_with(
                        "What is your GitHub token? (https://github.com/settings/tokens)"
                    )
                    # Should write config
                    assert mock_write.called
                    assert token == "new_token"


def test_report_workflow_uses_existing_token_from_config():
    """Test that ask_github_token returns existing token from config."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = Path(tmpdir) / '.mle' / 'config.yaml'
        config_path.parent.mkdir(parents=True, exist_ok=True)
        config = {
            "integration": {
                "github": {
                    "token": "existing_token"
                }
            }
        }
        with open(config_path, 'w') as f:
            yaml.dump(config, f)

        with patch.dict('os.environ', {'HOME': str(tmpdir)}):
            with patch('mle.workflow.report.questionary.password') as mock_password:
                token = report_module.ask_github_token()
                # Should not prompt for token
                mock_password.assert_not_called()
                assert token == "existing_token"


def test_start_command_with_general_mode_calls_baseline():
    """Test that `mle start general` calls baseline workflow."""
    runner = CliRunner()
    with patch('mle.cli.check_config', return_value=True):
        with patch('mle.workflow.baseline') as mock_baseline:
            result = runner.invoke(cli, ['start', 'general'])
            mock_baseline.assert_called_once_with(os.getcwd(), None)
            assert result.exit_code == 0


def test_start_command_with_report_mode_no_longer_exists():
    """Test that `mle start report` is no longer a valid command after patch."""
    runner = CliRunner()
    # In buggy code, 'mle start report' would call report workflow.
    # After patch, 'report' is not a valid mode for start command.
    # The click command will treat 'report' as invalid value for 'mode'.
    result = runner.invoke(cli, ['start', 'report'])
    # Expect failure because 'report' is not a valid choice for 'mode'
    # In buggy code, exit_code == 0 (it works). In fixed code, exit_code != 0.
    # So we assert exit_code != 0 for fixed, but test will fail on buggy.
    if hasattr(cli_module, 'report'):
        # Fixed code: 'report' is not a valid mode, so click raises BadParameter
        assert result.exit_code != 0
    else:
        # Buggy code: 'report' is a valid mode, exit_code == 0
        assert result.exit_code == 0


def test_integrate_command_no_longer_asks_for_repositories():
    """Test that `mle integrate` does not ask for repositories after patch."""
    runner = CliRunner()
    with patch('mle.cli.questionary.password') as mock_password:
        mock_password.return_value.ask.return_value = "token123"
        with patch('mle.cli.write_config') as mock_write:
            result = runner.invoke(cli, ['integrate'], input='\n')
            assert result.exit_code == 0
            # Should ask for token only, not for repositories
            mock_password.assert_called_once_with(
                "What is your GitHub token? (https://github.com/settings/tokens)"
            )
            # Verify config written does not contain repositories
            call_args = mock_write.call_args[0][0]
            assert "integration" in call_args
            assert "github" in call_args["integration"]
            assert "token" in call_args["integration"]["github"]
            assert "repositories" not in call_args["integration"]["github"][0m
