    In fixed code, report(work_dir, github_repo, model) takes github_repo as argument.
    """
    import inspect
    sig = inspect.signature(report_module.report)
    params = list(sig.parameters.keys())
    # In buggy code, parameters: work_dir, model (so 'github_repo' not in params)
    # In fixed code, parameters: work_dir, github_repo, model
    # So we assert 'github_repo' in params for fixed (pass), but buggy will fail.
    assert 'github_repo' in params


