                )
                # Should call report workflow with the repo
                mock_report.assert_called_once_with(
                    os.getcwd(), "MLSysOps/MLE-agent", None
                )
                assert result.exit_code == 0


def test_report_command_with_invalid_repo_format():
    """Test that `mle report` with invalid repo format prints error."""
