def test_report_workflow_does_not_ask_for_github_repo():
    """
    Test that report workflow does not ask for github repo (it's passed as argument).
    In buggy code, report workflow asks for github_repo via ask_text.
    In fixed code, github_repo is passed as argument.
    """
    from unittest.mock import patch, MagicMock
    if hasattr(report_module, 'report'):
        with tempfile.TemporaryDirectory() as tmpdir:
            work_dir = Path(tmpdir)
            github_repo = "owner/repo"
            mock_model = MagicMock()
            with patch('mle.workflow.report.load_model', return_value=mock_model):
                with patch('mle.workflow.report.ask_github_token', return_value="token"):
                    with patch('mle.workflow.report.SummaryAgent') as MockSummaryAgent:
                        mock_agent = MagicMock()
                        mock_agent.summarize.return_value = {}
                        MockSummaryAgent.return_value = mock_agent
                        with patch('mle.workflow.report.print_in_box'):
                            with patch('mle.workflow.report.Console'):
                                with patch('mle.workflow.report.ask_text') as mock_ask_text:
                                    try:
