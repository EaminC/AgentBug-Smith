                with patch('mle.workflow.report.ask_github_token', return_value="token"):
                    with patch('mle.workflow.report.SummaryAgent') as MockSummaryAgent:
                        mock_agent = MagicMock()
                        mock_agent.summarize.return_value = {}
                        MockSummaryAgent.return_value = mock_agent
                        with patch('mle.workflow.report.print_in_box'):
                            with patch('mle.workflow.report.Console'):
                                with patch('mle.workflow.report.ask_text') as mock_ask_text:
                                    try:
                                        report_module.report(str(work_dir), github_repo, mock_model)
                                        # If ask_text was called, it's buggy.
                                        if mock_ask_text.called:
                                            assert False, "Buggy: report asked for github repo"
                                        else:
