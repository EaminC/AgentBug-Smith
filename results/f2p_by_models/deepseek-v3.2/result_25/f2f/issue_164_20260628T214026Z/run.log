        # In buggy code, 'general' is not a valid mode -> exit_code != 0.
        # In fixed code, exit_code == 0 and baseline is called.
        # So we assert exit_code == 0 and baseline_called for fixed, but test will fail on buggy.
        assert result.exit_code == 0
        assert baseline_called
    finally:
        mle.cli.check_config = original_check
        baseline_module.baseline = original_baseline[0m
