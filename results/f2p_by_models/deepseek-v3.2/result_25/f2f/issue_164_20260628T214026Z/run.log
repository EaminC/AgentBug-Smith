def test_report_command_with_valid_repo_and_no_config_creates_project():
    """Test `mle report <repo>` when no config, creates new project."""
    runner = CliRunner()
    with patch('mle.cli.check_config', return_value=False):
        with patch('mle.cli.new') as mock_new:
            with patch('mle.cli.workflow.report') as mock_report:
                mock_report.return_value = True
                with patch('os.chdir'):
                    result = runner.invoke(cli_module.cli, ['report', 'owner/repo'])
