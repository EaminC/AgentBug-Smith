        # Mock workflow.baseline to track call
        baseline_called = False
        def mock_baseline(work_dir, model):
            nonlocal baseline_called
            baseline_called = True
            return None
        original_baseline = baseline_module.baseline
        baseline_module.baseline = mock_baseline
        result = runner.invoke(cli_module.cli, ['start', 'general'])
        # In buggy code, 'general' is not a valid mode -> exit_code != 0.
        # In fixed code, exit_code == 0 and baseline is called.
        assert result.exit_code == 0
        assert baseline_called
    finally:
        cli_module.check_config = original_check
        baseline_module.baseline = original_baseline


