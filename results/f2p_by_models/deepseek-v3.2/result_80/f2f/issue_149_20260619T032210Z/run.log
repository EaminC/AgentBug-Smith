RUN python -c "import openai; import pkg_resources; version = pkg_resources.get_distribution('openai').version; assert version.startswith('1.'), f'Expected openai<2.0.0, got {version}'; print(f'OpenAI version check passed: {version}')"

# Preflight import check
RUN python -c 'import dapr_agents, pytest, google.protobuf, dapr, openai; print("preflight ok")'

