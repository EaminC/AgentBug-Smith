# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# branch: python/pyproject.toml with Forge API configuration

WORKDIR /app

# Upgrade pip and setuptools
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    build-essential \
    libssl-dev \
    libffi-dev \
    python3-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set SETUPTOOLS_SCM_PRETEND_VERSION to avoid git dependency issues during build
ENV SETUPTOOLS_SCM_PRETEND_VERSION=1.0.0

# Copy the entire repository (required for injected tests)
COPY . .

# CRITICAL: For Dapr projects, explicitly install Dapr SDKs as instructed
# Install core Dapr SDKs first to ensure compatibility
RUN pip install "dapr>=1.13.0" "dapr-ext-grpc>=1.13.0" "dapr-ext-fastapi>=1.13.0" "dapr-ext-workflow>=1.13.0"

# Install project dependencies from pyproject.toml FIRST with correct versions
# Use pip install -e .[test] to install with test dependencies
# This will respect version constraints in pyproject.toml
RUN pip install -e .[test]

# Install additional packages needed for standalone scripts and testing
# Install specific versions that are compatible with project requirements
RUN pip install httpx litellm mem0ai python-dotenv

# Install OpenAI SDK version compatible with project requirements (openai<2.0.0,>=1.75.0)
RUN pip install "openai>=1.75.0,<2.0.0"

# Install posthog version compatible with project requirements (posthog<6.0.0)
RUN pip install "posthog<6.0.0"

# Set Forge API environment variables (overriding any previous values)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV DAPR_LLM_COMPONENT_DEFAULT=openai
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV ANTHROPIC_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Set PYTHONPATH for module resolution
ENV PYTHONPATH=/app

# Basic import checks (use single-line commands to avoid syntax errors)
RUN python -c 'import google.protobuf; print("protobuf import successful")'
RUN python -c 'import dapr; print("dapr import successful")'
RUN python -c 'import pytest; print("pytest import successful")'
RUN python -c 'import openai; print("openai import successful")'
RUN python -c 'import posthog; print("posthog import successful")'
RUN python -c 'import dotenv; print("python-dotenv import successful")'

# Try to import dapr_agents but don't fail if it doesn't work - use single line with proper escaping
RUN python -c "try: import dapr_agents; print('dapr_agents import successful'); except Exception as e: print('dapr_agents import issue (may be OK for testing):', str(e))"

# Test that basic Python imports work for standalone scripts
RUN python -c 'import sys; import os; import json; import requests; print("Basic imports successful")'

# Test import of OpenAIChatClient used in standalone scripts
RUN python -c "try: from dapr_agents import OpenAIChatClient; print('OpenAIChatClient import successful'); except Exception as e: print('OpenAIChatClient import issue:', str(e))"

# Verify the environment is configured for Forge API
RUN python -c 'import os; print("OPENAI_BASE_URL:", os.getenv("OPENAI_BASE_URL")); print("ANTHROPIC_BASE_URL:", os.getenv("ANTHROPIC_BASE_URL"))'

# Verify package versions are correct
RUN python -c "import openai; print(f'OpenAI version: {openai.__version__}')"
RUN python -c "import posthog; print(f'Posthog version: {posthog.__version__}')"

# Required for test harness
CMD ["/bin/bash"][0m
