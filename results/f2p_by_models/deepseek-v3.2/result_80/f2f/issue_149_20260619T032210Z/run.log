# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# branch: python/pyproject.toml with Forge API configuration

WORKDIR /app

# Upgrade packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies for building Python packages including git
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    build-essential \
    libssl-dev \
    libffi-dev \
    python3-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set SETUPTOOLS_SCM_PRETEND_VERSION to avoid git dependency issues during build
ENV SETUPTOOLS_SCM_PRETEND_VERSION=1.0.0

# Copy the entire repository (required for injected tests)
COPY . .

# First upgrade protobuf to compatible version (>=6.31.1) to match dapr's gencode
# The error showed: gencode 6.31.1 runtime 5.29.6, so we need protobuf >= 6.31.1
RUN pip install "protobuf>=6.31.1" --force-reinstall

# Install project dependencies from pyproject.toml
# Install dapr and its extensions first with proper protobuf constraint
RUN pip install "dapr>=1.15.0" "dapr-ext-fastapi>=1.15.0" "dapr-ext-workflow>=1.15.0" "durabletask-dapr>=0.2.0a7" \
    && pip install -e .[test]

# Install litellm (without openai extra which causes warnings)
RUN pip install litellm

# Install additional test utilities
RUN pip install pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" mem0ai

# Set Forge environment variables for OpenAI SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Set Forge environment variables for Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set other required environment variables
ENV DAPR_LLM_COMPONENT_DEFAULT=openai
ENV TAVILY_API_KEY=tvly-dev-ho3DUlHbkFZL6oJ0b0BbcZwuX72K
ENV GITHUB_TOKEN=ghp_key
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV ANTHROPIC_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Set PYTHONPATH to include current directory for module resolution
ENV PYTHONPATH=/app

# Verify imports work with upgraded protobuf
RUN python -c "import google.protobuf; import pkg_resources; version = pkg_resources.get_distribution('protobuf').version; print(f'Protobuf import successful, version: {version}')"
RUN python -c "import dapr; print('Dapr import successful')"
RUN python -c 'import dapr_agents; print("dapr_agents import successful")'
RUN python -c 'import pytest; print("pytest import successful")'
RUN python -c 'import openai; print(f"OpenAI import successful, version: {openai.__version__}")'
RUN python -c 'import litellm; print("litellm import successful")'

# Verify openai version is compatible (should be <2.0.0)
RUN python -c "import openai; import pkg_resources; version = pkg_resources.get_distribution('openai').version; assert version.startswith('1.'), f'Expected openai<2.0.0, got {version}'; print(f'OpenAI version check passed: {version}')"

# Preflight import check
RUN python -c 'import dapr_agents, pytest, google.protobuf, dapr, openai, litellm; print("preflight ok")'

# Required for test harness
