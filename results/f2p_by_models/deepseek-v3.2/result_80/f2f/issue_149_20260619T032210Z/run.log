[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# branch: python/pyproject.toml with Forge API configuration

WORKDIR /app

# Upgrade packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies for building Python packages including git
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    build-essential \
    libssl-dev \
    libffi-dev \
    python3-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set SETUPTOOLS_SCM_PRETEND_VERSION to avoid git dependency issues during build
ENV SETUPTOOLS_SCM_PRETEND_VERSION=1.0.0

# Copy the entire repository (required for injected tests)
COPY . .

# First upgrade protobuf to compatible version (>=6.31.1) to match dapr's gencode
# The error showed: gencode 6.31.1 runtime 5.29.6, so we need protobuf >= 6.31.1
RUN pip install "protobuf>=6.31.1" --force-reinstall

# Install ALL dependencies from pyproject.toml FIRST with exact version constraints
# This ensures we have the right versions before installing the project
RUN pip install \
    "dapr>=1.15.0" \
    "dapr-ext-fastapi>=1.15.0" \
    "dapr-ext-workflow>=1.15.0" \
    "durabletask-dapr>=0.2.0a7" \
    "pydantic>=2.11.3,<3.0.0" \
    "jinja2>=3.1.0,<4.0.0" \
    "pyyaml>=6.0,<7.0.0" \
    "requests>=2.31.0,<3.0.0" \
    "openapi-pydantic>=0.3.0,<0.4.0" \
    "openapi-schema-pydantic>=1.2.4,<2.0.0" \
    "rich>=13.9.4,<14.0.0" \
    "openai>=1.75.0,<2.0.0" \
    "azure-identity>=1.21.0,<2.0.0" \
    "huggingface_hub>=0.30.2,<1.0.0" \
    "colorama>=0.4.6,<1.0.0" \
    "regex>=2023.0.0,<2025.0.0" \
    "fastapi>=0.110.0,<1.0.0" \
    "uvicorn>=0.27.0,<1.0.0" \
    "aiohttp>=3.9.0,<4.0.0" \
    "cloudevents>=1.11.0,<2.0.0" \
    "numpy>=2.2.2,<3.0.0" \
    "mcp>=1.7.1,<2.0.0" \
    "opentelemetry-api>=1.12.0,<1.35.0" \
    "opentelemetry-distro>=0.53b1,<0.56b0" \
    "opentelemetry-exporter-otlp>=1.32.1,<1.35.0" \
    "opentelemetry-instrumentation-requests>=0.53b1,<0.56b0" \
    "pip-tools>=7.4.1,<8.0.0" \
    "sentence-transformers>=4.1.0,<5.0.0" \
    "chromadb>=1.0.13,<2.0.0" \
    "posthog<6.0.0"

# Now install the project WITHOUT dependencies (since we already installed them)
RUN pip install -e . --no-deps

# Install test dependencies with constraints
RUN pip install \
    "pytest>=7.0.0,<8.0.0" \
    "pytest-mock>=3.12.0,<4.0.0" \
    "pytest-asyncio>=0.23.0,<1.0.0" \
    "pytest-cov>=4.1.0,<5.0.0" \
    "httpx>=0.27.0,<1.0.0" \
    "anyio>=4.0.0"

# Install litellm without its openai dependency to avoid version conflicts
RUN pip install litellm --no-deps

# Install mem0ai with constraint to avoid posthog conflict
RUN pip install "mem0ai<3.0.0" --no-deps

# Set Forge environment variables for OpenAI SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Set Forge environment variables for Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set other required environment variables
ENV DAPR_LLM_COMPONENT_DEFAULT=openai
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV ANTHROPIC_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Set PYTHONPATH to include current directory for module resolution
ENV PYTHONPATH=/app

# Verify imports work with upgraded protobuf
RUN python -c "import google.protobuf; import pkg_resources; version = pkg_resources.get_distribution('protobuf').version; print(f'Protobuf import successful, version: {version}'); assert version >= '6.31.1', f'Protobuf version {version} is too old, need >=6.31.1'"

# Verify dapr import works
RUN python -c "import dapr; print('Dapr import successful')"

# Verify dapr_agents import works (this was failing before)
RUN python -c 'import dapr_agents; print("dapr_agents import successful")'

# Verify pytest import
RUN python -c 'import pytest; print("pytest import successful")'

# Verify openai version is compatible (should be <2.0.0)
RUN python -c "import openai; import pkg_resources; version = pkg_resources.get_distribution('openai').version; assert version.startswith('1.'), f'Expected openai<2.0.0, got {version}'; print(f'OpenAI version check passed: {version}')"

# Verify litellm import
RUN python -c 'import litellm; print("litellm import successful")'

# Verify posthog version is compatible (should be <6.0.0)
RUN python -c "import posthog; import pkg_resources; version = pkg_resources.get_distribution('posthog').version; major_version = int(version.split('.')[0]); assert major_version < 6, f'Expected posthog<6.0.0, got {version}'; print(f'Posthog version check passed: {version}')"

# Preflight import check
RUN python -c 'import dapr_agents, pytest, google.protobuf, dapr, openai, litellm, posthog; print("preflight ok")'

# Required for test harness
CMD ["/bin/bash"][0m
