def test_fastapi_server_signal_handler_registration_on_windows():
    """Test that FastAPIServerBase can start without NotImplementedError on Windows/WSL2."""
    # Simulate Windows environment
    with patch("platform.system", return_value="Windows"):
        # Create a minimal FastAPIServerBase instance
        server = FastAPIServerBase(host="127.0.0.1", port=0)
        
        # Mock the uvicorn server to avoid actually starting it
        mock_server = Mock()
        mock_server.serve = Mock(return_value=asyncio.sleep(0))
        server.server = mock_server
        
        # Try to start the server - this should not raise NotImplementedError
        # due to loop.add_signal_handler on Windows
        try:
            # This will call add_signal_handlers_cross_platform internally
            # In buggy code, this would call loop.add_signal_handler directly
            # which raises NotImplementedError on Windows
            asyncio.run(server.start())
        except NotImplementedError as e:
            if "add_signal_handler" in str(e):
                # This is the bug - signal handler registration fails on Windows
                pytest.fail(f"Signal handler registration failed on Windows: {e}")
            else:
                raise
        except Exception as e:
            # Other exceptions are OK for this test
            pass


