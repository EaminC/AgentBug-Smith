def test_import_token_usage_with_langchain_community_only():
    """
    Test that token_usage can be imported when langchain.callbacks.openai_info is missing
    entirely (simulating newer langchain versions).
    """
    # Simulate missing langchain.callbacks.openai_info module.
    # We'll temporarily replace it with a dummy module that lacks the function.
    import sys
    import types
    # Create a dummy module that does not have get_openai_token_cost_for_model
    dummy_openai_info = types.ModuleType('langchain.callbacks.openai_info')
    # Insert it into sys.modules
    sys.modules['langchain.callbacks.openai_info'] = dummy_openai_info
    # Also ensure langchain_community.callbacks.openai_info exists (it does in the environment)
    # but we need to make sure it has the function.
    # We'll import it and if missing, we'll add a dummy.
    try:
        from langchain_community.callbacks.openai_info import get_openai_token_cost_for_model as community_func
    except ImportError:
        # If langchain_community is not installed, we cannot test this scenario.
        # But the fix expects it to be installed (since it's a fallback).
        # In the buggy code, this would cause ImportError.
        # We'll skip this test if langchain_community is not present.
        # However, the test should still run because the environment has langchain_community.
        # If not, we'll just pass (since the bug is about missing import, not missing langchain_community).
        # Remove the dummy module
        del sys.modules['langchain.callbacks.openai_info']
        # Re-import the real module to avoid side effects
        importlib.reload(importlib.import_module('langchain.callbacks.openai_info'))
        return

    # Now attempt to import token_usage. Should succeed with the fallback.
    # Force reload
    if 'gpt_engineer.core.token_usage' in sys.modules:
        del sys.modules['gpt_engineer.core.token_usage']
    try:
        from gpt_engineer.core.token_usage import get_openai_token_cost_for_model
        # Call it to ensure it works
        cost = get_openai_token_cost_for_model("gpt-4", 50)
        assert isinstance(cost, (int, float))
    finally:
        # Restore original module
        del sys.modules['langchain.callbacks.openai_info']
        importlib.reload(importlib.import_module('langchain.callbacks.openai_info'))

def test_token_usage_aggregation():
    """
    Test that aggregate_openai_token_usage works with the imported function.
    This ensures the fix doesn't break the actual functionality.
    """
    from gpt_engineer.core.token_usage import aggregate_openai_token_usage
    from langchain.schema import AIMessage, HumanMessage, SystemMessage

    # Create dummy messages
    messages = [
        SystemMessage(content="You are a helpful assistant."),
        HumanMessage(content="Hello"),
        AIMessage(content="Hi there!"),
    ]
    # This function uses get_openai_token_cost_for_model internally.
    # It should not raise ImportError.
    usage = aggregate_openai_token_usage(messages, "gpt-3.5-turbo")
    # The function returns a dict with keys like 'cost', 'tokens', etc.
    assert isinstance(usage, dict)
    assert 'cost' in usage
    assert 'tokens' in usage
    # Cost should be a number (float)
    assert isinstance(usage['cost'], (int, float))

