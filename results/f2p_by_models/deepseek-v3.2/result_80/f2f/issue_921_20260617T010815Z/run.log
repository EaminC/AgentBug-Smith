[32mFROM python:3.10-slim AS test_builder

WORKDIR /app

# Copy entire repository
COPY . .

# Install system dependencies for build (if needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install poetry
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install poetry

# Configure poetry to not create virtualenvs inside container
RUN poetry config virtualenvs.create false

# Install project dependencies including dev extras (test, doc)
RUN poetry install --no-interaction --no-ansi --with test,doc

# Install additional required test packages (some may already be installed via poetry extras)
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

