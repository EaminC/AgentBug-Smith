    def test_run_command_multiple_commands_fixed(self):
        """After fix, run_command iterates over list of commands.
        This test should pass only after the patch.
        """
        # We'll mock subprocess.Popen to count calls.
        with patch('subprocess.Popen') as mock_popen:
            mock_process = Mock()
            mock_process.stdout.readline.side_effect = ['output line\n', '']
            mock_process.poll.side_effect = [None, 0]
            mock_process.wait.return_value = -1  # any non-zero to avoid early exit
            mock_popen.return_value = mock_process

            commands = ['echo hello', 'echo world']
            # Call the actual run_command from the module.
