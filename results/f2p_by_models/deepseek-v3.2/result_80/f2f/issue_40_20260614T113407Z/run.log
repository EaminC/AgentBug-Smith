def test_buggy_run_command_only_runs_first_command():
    """Test that buggy run_command only executes the first command in the list."""
    from agent.utils.system import run_command

    # Mock subprocess.Popen to capture the command it receives
    with patch('subprocess.Popen') as mock_popen:
        mock_process = MagicMock()
        mock_process.stdout.readline.side_effect = ['']
        mock_process.poll.return_value = 0
        mock_process.wait.return_value = 0
        mock_popen.return_value = mock_process

        # Call run_command with a list of commands (as buggy code does)
        commands = ['pip install torch', 'pip install transformers', 'apt-get install build-essential']
        output, exit_code = run_command(commands)

        # In buggy code, run_command expects a single string, but receives a list.
        # subprocess.Popen will be called with the first element as command and the rest as arguments.
        # Actually, subprocess.Popen with shell=True will join the list into a string? Let's check.
        # The buggy code: process = subprocess.Popen(command, shell=True, ...)
        # If command is a list, subprocess.Popen will treat it as arguments.
        # With shell=True, the first item is the command string, the rest are arguments to the shell.
        # So only the first command is executed.
        # Therefore, we assert that Popen was called with the first command only.
        mock_popen.assert_called_once_with('pip install torch', shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)


