def test_setup_agent_installs_all_dependencies():
    # Create a mock LLM agent
    mock_agent = Mock()
    # Simulate the LLM response with multiple dependencies
    mock_response = Mock()
    mock_response.choices = [Mock()]
    mock_response.choices[0].message.content = json.dumps({
        'commands': [
            'pip install torch',
            'pip install transformers',
            'apt-get install build-essential'
        ],
        'dependencies': ['torch', 'transformers', 'build-essential']
    })
    mock_agent.completions.return_value = mock_response

    # Create a mock plan
    mock_plan = Mock(spec=Plan)
    mock_plan.dict.return_value = {
        'lang': 'python',
        'tasks': []
    }

    # Create SetupAgent instance
    setup_agent = SetupAgent(mock_agent, mock_plan)

    # Mock questionary.confirm to return True (user confirms installation)
    with patch('questionary.confirm') as mock_confirm:
        mock_confirm.return_value.ask.return_value = True

        # Mock run_command to capture the commands it receives
