[32mimport json
import subprocess
from unittest.mock import patch, MagicMock

from agent.function.plan_agent import PlanAgent
from agent.model.openai import OpenAIAgent
from agent.types import Plan, Task


def test_setup_agent_installs_all_dependencies():
    """
    Test that SetupAgent installs all dependencies (multiple commands) instead of only the first.
    In buggy code, run_command only executed the first command.
    In fixed code, run_command iterates over all commands.
    """
    # Mock the LLM agent completions to return a JSON with multiple commands.
    mock_agent = MagicMock(spec=OpenAIAgent)
    mock_response = MagicMock()
    mock_response.choices = [MagicMock()]
    mock_response.choices[0].message.content = json.dumps({
        "commands": [
            "pip install torch",
            "pip install transformers",
            "apt-get install -y build-essential"
        ],
        "dependencies": ["torch", "transformers", "build-essential"]
    })
    mock_agent.completions.return_value = mock_response

    # Create a minimal Plan object.
    plan = Plan(
        name="test_plan",
        lang="python",
        tasks=[Task(name="task1", description="desc", resources=[])],
        current_task=0,
        dependencies=[]
    )

    # Create PlanAgent instance (we need it to call its _run_plan method indirectly).
    # Instead, we'll directly test the SetupAgent because that's where the bug fix is.
    # But SetupAgent is imported inside plan_agent.py; we'll import it directly.
    from agent.function.setup_agent import SetupAgent

    setup_agent = SetupAgent(mock_agent, plan)

    # Mock questionary.confirm to return True (simulate user confirmation).
    with patch('questionary.confirm') as mock_confirm:
        mock_confirm.ask.return_value = True

        # Mock run_command to capture the commands it receives.
        # In buggy code, run_command receives a single string (the first command).
        # In fixed code, run_command receives a list of strings.
        captured_commands = []
        def mock_run_command(commands):
            captured_commands.extend(commands)
            return [("", 0) for _ in commands]

        with patch('agent.function.setup_agent.run_command', side_effect=mock_run_command):
            setup_agent.invoke()

    # Verify that the LLM was called with the correct prompt.
    assert mock_agent.completions.called
    call_args = mock_agent.completions.call_args
    chat_history = call_args[0][0]
    assert chat_history[0]["role"] == "system"
    assert "detect which dependencies" in chat_history[0]["content"]
    user_content = json.loads(chat_history[1]["content"])
    assert user_content["name"] == "test_plan"

    # Verify that run_command was called with the list of commands.
    # In buggy code, run_command would be called with only the first command.
    # In fixed code, run_command is called with the full list.
    assert len(captured_commands) == 3
    assert captured_commands[0] == "pip install torch"
    assert captured_commands[1] == "pip install transformers"
    assert captured_commands[2] == "apt-get install -y build-essential"

    # Additionally, we can test that the buggy run_command (single command) would fail.
    # But we are mocking run_command, so we rely on the captured commands length.
    # If the bug is present, captured_commands would have only one element.
    # This assertion will fail in buggy code, pass in fixed code.
    assert captured_commands == [
        "pip install torch",
        "pip install transformers",
        "apt-get install -y build-essential"
    ]


def test_run_command_multiple_commands():
    """
    Direct test of the fixed run_command function.
    In buggy code, run_command takes a single string command.
    In fixed code, run_command takes a list of commands.
    """
    from agent.utils.system import run_command

    # Mock subprocess.Popen to avoid actual shell execution.
    mock_process = MagicMock()
    mock_process.poll.return_value = 0
    mock_process.stdout.readline.side_effect = ["output line 1\n", "output line 2\n", ""]
    mock_process.wait.return_value = III

    with patch('subprocess.Popen', return_value=mock_process) as mock_popen:
        commands = ["echo hello", "echo world"]
        results = run_command(commands)

        # Verify Popen called twice.
        assert mock_popen.call_count == 2
        # Verify each command was passed correctly.
        mock_popen.assert_any_call("echo hello", shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        mock_popen.assert_any_call("echo world", shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)

        # Verify results list contains two tuples.
        assert len(results) == 2
        for result in results:
            output, exit_code = result
            assert exit_code == 0
            assert "output line" in output

    # Test with buggy run_command (if it were still single command).
    # This is just to illustrate the difference; we don't actually call the buggy version.
    # In buggy code, run_command expects a single string, not a list.
    # So if we passed a list, it would treat the first element as the whole command.
    # That would cause the test to fail because the mock would be called only once.
    # We rely on the above test to pass only after the fix.[0m
