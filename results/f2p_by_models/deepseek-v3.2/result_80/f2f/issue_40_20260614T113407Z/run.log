def test_run_command_executes_all_commands():
    """
    Test that run_command executes all commands in the list,
    not just the first one as in the buggy code.
    """
    commands = ["echo hello", "echo world"]
    with patch('subprocess.Popen') as mock_popen:
        mock_process = MagicMock()
        mock_process.poll.side_effect = [None, None, 0]
        mock_process.stdout.readline.side_effect = ["hello\n", "world\n", ""]
        mock_popen.return_value = mock_process

        results = run_command(commands)

    # Ensure subprocess.Popen was called twice (once per command)
    assert mock_popen.call_count == 2
    # Ensure results contain two tuples
    assert len(results) == 2
    # Check that each command's output is captured
    assert results[0][0] == "hello\n"
    assert results[1][0] == "world\n"


def test_run_command_handles_exceptions():
    """
    Test that run_command handles exceptions for each command individually.
    """
    commands = ["invalid_command_xyz", "echo valid"]
    with patch('subprocess.Popen') as mock_popen:
        mock_popen.side_effect = [Exception("Command not found"), MagicMock()]
        mock_process = MagicMock()
        mock_process.poll.side_effect = [0]
        mock_process.stdout.readline.side_effect = ["valid\n", ""]
        mock_popen.return_value = mock_process

        results = run_command(commands)

    # Ensure results contain two tuples
    assert len(results) == 2
    # First command should have error
    assert "Command not found" in results[0][0]
    # Second command should have output
    assert results[1][0] == "valid\n"


