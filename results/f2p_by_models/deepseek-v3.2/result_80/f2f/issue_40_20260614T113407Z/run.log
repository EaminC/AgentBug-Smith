            # So we assert that mock_popen.call_count == len(commands) to catch the bug.
            assert mock_popen.call_count == len(commands), f"Expected {len(commands)} calls, got {mock_popen.call_count}. Bug: only first dependency installed."
        else:
            # Fixed behavior: multiple calls.
            assert mock_popen.call_count == len(commands), f"Expected {len(commands)} calls, got {mock_popen.call_count}."

def test_run_command_iterates_all_commands():
    """
    Direct test of run_command to ensure it iterates over all commands.
    """
    commands = ['echo first', 'echo second', 'echo third']
    with patch('subprocess.Popen') as mock_popen:
        mock_process = MagicMock()
        mock_process.stdout.readline.side_effect = [b'output\n', b'']
        mock_process.poll.side_effect = [None, 0]
        mock_process.wait.return_value = 0
        mock_popen.return_value = mock_process

        results = run_command(commands)
        # In buggy code, results is a tuple (output, exit_code) from a single command.
        # In fixed code, results is a list of tuples.
        # Check the type.
        if isinstance(results, list):
            # Fixed behavior
            assert len(results) == len(commands), f"Expected {len(commands)} results, got {len(results)}"
            assert mock_popen.call_count == len(commands), f"Expected {len(commands)} Popen calls, got {mock_popen.call_count}"
        else:
            # Buggy behavior: results is a tuple, not a list.
            # This assertion will fail in buggy tree, causing test failure.
            assert isinstance(results, list), f"run_command should return a list of tuples, got {type(results)}. Bug: only first command executed."[0m
