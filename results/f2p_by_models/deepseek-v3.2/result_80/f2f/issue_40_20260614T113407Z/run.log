    def test_dependency_generator_calls_llm_once_per_property(self):
        """Bug: dependency_generator is called twice in invoke(), causing only first dependency to install.
        Fixed: dependency_generator is called once and its result reused.
        """
        mock_agent = Mock()
        mock_response = Mock()
        mock_response.choices = [Mock()]
        mock_response.choices[0].message.content = json.dumps({
            'commands': ['pip install torch', 'pip install transformers'],
            'dependencies': ['torch', 'transformers']
        })
        mock_agent.completions.return_value = mock_response

        plan = Plan(
            name="test",
            lang="python",
            tasks=[],
            current_task=0,
            resources=[],
            dataset=None,
            model=None,
            evaluation=None
        )

        agent = SetupAgent(mock_agent, plan)

        # Mock preprocess_json_string to avoid any string processing issues
        with patch('agent.function.setup_agent.preprocess_json_string', side_effect=lambda x: x):
            result = agent.dependency_generator()

        assert result == {
            'commands': ['pip install torch', 'pip install transformers'],
            'dependencies': ['torch', 'transformers']
        }
        # Ensure LLM was called exactly once
        assert mock_agent.completions.call_count == 1

    def test_invoke_calls_dependency_generator_once(self):
