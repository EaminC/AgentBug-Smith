class TestSetupAgentBug:
    """Test for bug: only install the first dependency.

    The bug is in the old `run_command` function which only ran a single command string.
    After the fix, `run_command` accepts a list of commands and runs each.
    """

    def test_run_command_single_command_buggy(self):
        """In buggy code, run_command expects a single string command.
        If we pass a list, it will treat the list as a string and fail.
        This test should fail on buggy code because the function doesn't iterate.
        """
        # Mock subprocess.Popen to avoid actual shell execution
        with patch('subprocess.Popen') as mock_popen:
            mock_process = Mock()
            mock_process.stdout.readline.side_effect = ['output line\n', '']
            mock_process.poll.side_effect = [None, 0]
            mock_process.wait.return_value = 0
            mock_popen.return_value = mock_process

            # In buggy code, run_command expects a single string.
            # But the bug is that it only runs the first command if a list is passed?
            # Actually the bug is that `run_command` is called with `install_commands`
            # which is a list, but the function expects a string.
