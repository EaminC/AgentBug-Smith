def test_setup_agent_dependency_generator_returns_multiple_commands():
    """
    Test that SetupAgent.dependency_generator returns a dict with a 'commands' list
    containing multiple commands.
    """
    # We need to import SetupAgent from the correct location.
    # Since the patch moves SetupAgent to a new file, we try to import from the new location.
    # If it fails, we import from the old location (which doesn't have SetupAgent).
    # That will cause an ImportError, which is fine for fail2pass.
    try:
        from agent.function.setup_agent import SetupAgent
    except ImportError:
        # In buggy version, SetupAgent doesn't exist. That's okay; the test will fail.
        # We'll skip the rest of the test by raising an assertion that will fail.
        raise AssertionError("SetupAgent not found in buggy version")

    mock_agent = MagicMock()
    mock_response = MagicMock()
    mock_response.choices = [MagicMock()]
    mock_response.choices[0].message.content = json.dumps({
        "commands": ["pip install numpy", "pip install pandas", "apt-get update"],
        "dependencies": ["numpy", "pandas", "system-update"]
    })
    mock_agent.completions.return_value = mock_response

    plan = Plan(
        name="test",
        lang="python",
        tasks=[],
        current_task=0
    )

    setup_agent = SetupAgent(mock_agent, plan)
    result = setup_agent.dependency_generator()
    assert isinstance(result, dict)
    assert "commands" in result
    assert isinstance(result["commands"], list)
    assert len(result["commands"]) == 3
    assert "dependencies" in result
    assert len(result["dependencies"]) == 3


def test_setup_agent_invoke_runs_all_commands():
    """
    Test that SetupAgent.invoke() runs all commands returned by dependency_generator.
    """
    try:
        from agent.function.setup_agent import SetupAgent
    except ImportError:
        raise AssertionError("SetupAgent not found in buggy version")

    mock_agent = MagicMock()
    mock_response = MagicMock()
    mock_response.choices = [MagicMock()]
    mock_response.choices[0].message.content = json.dumps({
        "commands": ["pip install numpy", "pip install pandas"],
        "dependencies": ["numpy", "pandas"]
    })
    mock_agent.completions.return_value = mock_response

    plan = Plan(
        name="test",
        lang="python",
        tasks=[],
        current_task=0
    )

    setup_agent = SetupAgent(mock_agent, plan)
    # Mock console and questionary to avoid interactive prompts
    setup_agent.console = MagicMock()
    with patch('questionary.confirm') as mock_confirm:
        mock_confirm.return_value.ask.return_value = True
        with patch('agent.utils.system.run_command') as mock_run_command:
            setup_agent.invoke()
            # Check that run_command was called with the list of commands
            mock_run_command.assert_called_once_with(["pip install numpy", "pip install pandas"])


def test_run_command_iterates_over_list():
    """
    Direct test of run_command: ensure it iterates over a list of commands.
    """
    with patch('subprocess.Popen') as mock_popen:
        mock_process = MagicMock()
        mock_process.stdout.readline.side_effect = ['']
        mock_process.poll.return_value = 0
        mock_process.wait.return_value = 0
        mock_popen.return_value = mock_process

        commands = ["echo 'hello'", "echo 'world'", "echo 'foo'"]
        results = run_command(commands)

        # In fixed version, Popen should be called three times.
        # In buggy version, Popen is called once (or crashes).
        if mock_popen.call_count == len(commands):
            # Fixed behavior
            assert len(results) == 3
            for res in results:
                assert isinstance(res, tuple)
                assert res[1] == 0
        else:
            # Buggy behavior
            assert False, f"run_command did not iterate over commands. Popen called {mock_popen.call_count} times."[0m
