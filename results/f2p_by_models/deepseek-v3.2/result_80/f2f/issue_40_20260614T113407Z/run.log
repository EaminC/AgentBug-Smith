        agent = SetupAgent(mock_agent, plan)

        # Mock preprocess_json_string and questionary.confirm
        with patch('agent.function.setup_agent.preprocess_json_string', side_effect=lambda x: x), \
             patch('agent.function.setup_agent.questionary.confirm') as mock_confirm, \
             patch('agent.function.setup_agent.run_command') as mock_run_command:
            mock_confirm.ask.return_value = True

            agent.invoke()

            # dependency_generator should be called exactly once in the fixed code.
            # In buggy code, it's called twice (for commands and dependencies separately).
