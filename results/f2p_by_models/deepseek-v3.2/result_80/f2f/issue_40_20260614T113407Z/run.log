def test_run_command_executes_all_commands():
    # This test is for the run_command function, which is changed in the patch.
    # We'll test that run_command executes all commands in the list.
    # We'll mock subprocess.Popen to record calls.
    with patch('subprocess.Popen') as mock_popen:
        mock_process = MagicMock()
        mock_process.stdout.readline.side_effect = [b'output line\n', b'']
        mock_process.poll.side_effect = [None, 0]
        mock_process.wait.return_value = 0
        mock_popen.return_value = mock_process

        commands = ["echo hello", "echo world"]
        # In the buggy code, run_command expects a single string command, but we pass a list.
        # This would cause an error because the buggy run_command uses `command` as a string.
        # However, the buggy run_command uses `command` as the shell command, so if we pass a list,
        # it would be converted to a string and cause a shell error.
        # We'll test the fixed run_command which iterates over the list.
        # We'll import the fixed run_command from the module after the patch is applied.
        # But we are writing a test that runs on both buggy and fixed code.
        # The test will fail on buggy code because run_command will not iterate.
        # We'll call run_command and check that subprocess.Popen is called for each command.
        results = run_command(commands)
        # In the fixed code, results should be a list of tuples.
        # In the buggy code, run_command would return a single tuple (output, exit_code) for the first command?
        # Actually, the buggy run_command would treat the list as a string and run it as a single command.
        # So subprocess.Popen would be called once with the list as a string.
        # We'll assert that subprocess.Popen is called twice (for two commands).
        assert mock_popen.call_count == 2
        # Check that each call has the correct command string
        mock_popen.assert_any_call("echo hello", shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        mock_popen.assert_any_call("echo world", shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        # Check that results is a list of two tuples
        assert len(results) == 2
        for result in results:
            assert isinstance(result, tuple)
            assert len(result) == 2
            assert result[1] == 0  # exit code


