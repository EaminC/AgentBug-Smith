    def test_run_command_handles_multiple_commands(self):
        """Test that run_command executes all commands in the list.
        
        In the buggy code, run_command took a single command string and would only
        execute the first command if a list was passed.
        In the fixed code, run_command takes a list of commands and executes all.
        """
        # Mock subprocess.Popen to avoid actual execution
        with patch('subprocess.Popen') as mock_popen:
            mock_process = Mock()
            mock_process.stdout.readline.side_effect = ["output1\n", "output2\n", ""]
            mock_process.poll.side_effect = [None, None, 0]
            mock_process.wait.return_value = 0
            mock_popen.return_value = mock_process

            commands = ["pip install torch", "pip install transformers"]
            results = run_command(commands)

            # Verify Popen was called twice (once for each command)
            assert mock_popen.call_count == 2
            assert len(results) == 2
            for result in results:
                output, exit_code = result
                assert exit_code == 0

