# --- end inject ---

# Set Forge API environment variables for OpenAI and Anthropic SDK compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"

# Additional environment variables from project .env
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y sudo tk tcl gcc git curl && rm -rf /var/lib/apt/lists/*

# Copy entire repository for external test injection
COPY . .

# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Install Poetry
RUN pip install poetry

# Configure Poetry to install into system environment
RUN poetry config virtualenvs.create false

# Install core dependencies including exact openai version required
RUN pip install "openai==0.28" termcolor typer rudder-sdk-python dataclasses-json tiktoken tabulate python-dotenv langchain

# Install test and development dependencies
RUN pip install pytest pytest-cov pytest-mock pytest-asyncio pytest-xdist pytest-timeout

# Install additional dependencies as per guardrails
RUN pip install anyio "setuptools<=81.0.0" litellm mem0ai

# Install development tools
RUN pip install black mypy ruff pre-commit tox

# Install the project in development mode (editable install)
RUN pip install -e .

# Try poetry install as a fallback for any remaining dependencies
RUN poetry install --no-interaction --no-ansi --extras test --with dev || echo "Poetry install completed or skipped"

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command (required by test harness)
CMD ["/bin/bash"][0m
