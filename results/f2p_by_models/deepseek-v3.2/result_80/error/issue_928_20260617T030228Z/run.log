# --- end inject ---

# Set Forge API environment variables (from project root .env)
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"

# For OpenAI SDK compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"

# For Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y sudo tk tcl gcc && rm -rf /var/lib/apt/lists/*

# Copy entire repository for external test injection
COPY . .

# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Install Poetry
RUN pip install poetry

# Configure Poetry to install into system environment
RUN poetry config virtualenvs.create false

# Fix poetry lock issue: regenerate lock file to sync with pyproject.toml
RUN poetry lock --no-interaction --no-ansi

# Install dependencies including dev (with test extras)
RUN poetry install --no-interaction --no-ansi --extras "test"

# Install additional test dependencies unconditionally
RUN pip install pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Install the project in development mode (editable install)
RUN pip install -e .

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command (required by test harness)
CMD ["/bin/bash"][0m
