[32mFROM python:3.11-slim AS test_builder

WORKDIR /app

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Copy entire repository for external test injection
COPY . .

# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Install Poetry (repo uses poetry per pyproject.toml and Makefile)
RUN pip install poetry

# Configure Poetry to install into system environment
RUN poetry config virtualenvs.create false

# Install dependencies including dev (poetry.lock not present, use install with dev extras)
# The project uses extras: test, doc, experimental. Install test extras for pytest.
RUN poetry install --no-interaction --no-ansi --extras "test"

# Install additional test dependencies unconditionally (as per guardrails)
RUN pip install pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Detect src/ layout to avoid duplicate module loading
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." tests 2>/dev/null; then \
    echo "src layout detected, setting PYTHONPATH and skipping editable install"; \
    ENV PYTHONPATH=/app; \
    else \
    echo "no src layout, performing editable install"; \
    pip install -e .; \
    fi

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command (required by test harness)
CMD ["/bin/bash"]

# Multi‑stage build for minimal runtime image
FROM python:3.11-slim AS runtime

WORKDIR /app

# Copy only necessary artifacts from test_builder
COPY --from=test_builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=test_builder /usr/local/bin /usr/local/bin
COPY . .

# Install production dependencies only (no dev extras)
RUN pip install poetry && \
    poetry config virtualenvs.create false && \
    poetry install --no-interaction --no-ansi --without dev,doc,experimental

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Infer entrypoint from pyproject.toml scripts (gpt-engineer, ge, gpte)
# Use gpte as recommended in README
ENTRYPOINT ["gpte"]

# Default command (if no arguments provided) – show help
CMD ["--help"][0m
