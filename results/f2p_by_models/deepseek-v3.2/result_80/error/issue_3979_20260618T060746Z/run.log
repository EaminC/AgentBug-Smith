# Copy entire repository
COPY . .

# Combined installation in fewer RUN commands to reduce build time
RUN pip install --upgrade pip wheel && \
    pip install "setuptools<=81.0.0" hatchling

# Install main dependencies from requirements.txt (before ##Dev marker)
# Simplified approach - install everything at once with error tolerance
RUN if [ -f "requirements.txt" ]; then \
        # Install dependencies before ##Dev marker
        # awk logic: before ##Dev, skip=0; after ##Dev, skip=1
        awk '/^##Dev/{skip=1} !skip && /^[^#]/ {print}' requirements.txt > /tmp/install_reqs.txt && \
        pip install -r /tmp/install_reqs.txt; \
    fi

# Install the package in editable mode
RUN pip install -e .

# Install test dependencies in one go
RUN pip install \
    pytest \
    pytest-xdist \
    pytest-timeout \
    pytest-asyncio \
    pytest-cov \
    pytest-mock \
    pytest-benchmark \
    pytest-integration \
    pytest-recording \
    flaky \
    asynctest \
    litellm \
    anyio

# Install special packages that might need special handling
RUN pip install "vcrpy @ git+https://github.com/Significant-Gravitas/vcrpy.git@master" || \
    echo "Note: vcrpy installation failed but continuing"

RUN pip install "https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.5.0/en_core_web_sm-3.5.0-py3-none-any.whl" || \
    echo "Note: spacy model installation failed but continuing"

# Install dev dependencies (after ##Dev marker) - skip problematic packages
RUN if [ -f "requirements.txt" ]; then \
        # Install dependencies after ##Dev marker, skipping problematic packages
        # awk logic: skip=0 initially, set skip=1 when we see ##Dev, then print lines
        awk '/^##Dev/{skip=1} skip && /^[^#]/ && !/auto-gpt-plugin-template/ {print}' requirements.txt > /tmp/dev_reqs.txt && \
        if [ -s /tmp/dev_reqs.txt ]; then \
            pip install -r /tmp/dev_reqs.txt; \
        fi; \
    fi

# Preflight import check with better error reporting
RUN python -c "
import sys
print('Python version:', sys.version)
try:
    import autogpt
    print('✓ autogpt imported')
except ImportError as e:
    print(f'✗ autogpt import failed: {e}')
    sys.exit(1)

try:
    import pytest
    print('✓ pytest imported')
except ImportError as e:
    print(f'✗ pytest import failed: {e}')

try:
    import openai
    print('✓ openai imported')
except ImportError as e:
    print(f'✗ openai import failed: {e}')

try:
    import yaml
    print('✓ yaml imported')
except ImportError as e:
    print(f'✗ yaml import failed: {e}')

try:
    import requests
    print('✓ requests imported')
except ImportError as e:
    print(f'✗ requests import failed: {e}')

import json
import os
print('Environment check:')
print(f'  OpenAI base URL: {os.environ.get(\"OPENAI_BASE_URL\")}')
print(f'  Anthropic base URL: {os.environ.get(\"ANTHROPIC_BASE_URL\")}')
print(f'  Forge API key set: {bool(os.environ.get(\"FORGE_API_KEY\"))}')
print('Preflight check complete')
"

