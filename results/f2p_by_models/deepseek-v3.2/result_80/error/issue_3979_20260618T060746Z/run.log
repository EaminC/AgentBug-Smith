FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Set Python environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl git gcc g++ \
    libxml2-dev libxslt1-dev \
    libjpeg-dev libtiff5-dev libwebp-dev zlib1g-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Create virtual environment to avoid system package conflicts
RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"

# Upgrade pip and install build tools
RUN pip install --upgrade pip wheel

# Install setuptools with a compatible version first to avoid PyYAML issues
RUN pip install "setuptools<=81.0.0"

# Install hatchling for build system
RUN pip install hatchling

# Install PyYAML with a workaround for the cython_sources issue
# Use --no-binary :all: to force source installation
RUN pip install "pyyaml==6.0" --no-binary :all: || pip install "pyyaml>=5.4.1" --no-binary :all: || true

# Install all dependencies from requirements.txt in one go
RUN if [ -f "requirements.txt" ]; then \
        # Create a temporary file with requirements, excluding dev dependencies
        sed -n '/^##Dev/q;p' requirements.txt > /tmp/requirements.txt && \
        # Install all dependencies at once with fallback for source installation
        pip install -r /tmp/requirements.txt || pip install --no-binary :all: -r /tmp/requirements.txt || true; \
    fi

# Install the package in editable mode using hatchling build system
RUN pip install -e .

# Install test dependencies that might not be in requirements.txt
RUN pip install pytest-xdist pytest-timeout pytest-asyncio pytest-cov pytest-mock

# Install Forge API compatibility packages
RUN pip install litellm anyio

# Install additional test packages mentioned in requirements.txt after ##Dev marker
RUN if [ -f "requirements.txt" ]; then \
        # Check if there are dependencies after ##Dev marker
        if tail -n +$(grep -n "^##Dev" requirements.txt | cut -d: -f1) requirements.txt | grep -q "^[^#]"; then \
            # Create file with everything after ##Dev
            sed -n '/^##Dev/,$p' requirements.txt | tail -n +2 > /tmp/dev_requirements.txt && \
            # Install dev dependencies if file has content
            if [ -s /tmp/dev_requirements.txt ]; then \
                pip install -r /tmp/dev_requirements.txt || pip install --no-binary :all: -r /tmp/dev_requirements.txt || true; \
            fi; \
        fi; \
    fi

# Install test dependencies explicitly (some may be in dev section)
RUN pip install pytest asynctest pytest-benchmark pytest-integration pytest-recording flaky || true

# Install vcrpy from git as specified
RUN pip install "vcrpy @ git+https://github.com/Significant-Gravitas/vcrpy.git@master" || true

# Install spacy model
RUN pip install "https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.5.0/en_core_web_sm-3.5.0-py3-none-any.whl" || true

# Preflight import check
RUN python -c "import autogpt, pytest, openai, yaml, requests, json, os, sys; print('Preflight import check passed'); print(f'OpenAI base URL: {os.environ.get(\"OPENAI_BASE_URL\")}'); print(f'Anthropic base URL: {os.environ.get(\"ANTHROPIC_BASE_URL\")}'); print(f'Forge API key set: {bool(os.environ.get(\"FORGE_API_KEY\"))}')" || echo "Preflight check had issues"

