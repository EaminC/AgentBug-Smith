[32m# branch: python/requirements.txt
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Set Python environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies including git for gitpython and vcrpy
RUN apt-get update && apt-get install -y \
    curl git \
    build-essential libxml2-dev libxslt1-dev python3-dev \
    libssl-dev libffi-dev g++ \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Create and activate virtual environment
RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"

# Upgrade pip and install build tools with setuptools<=81.0.0
RUN pip install --upgrade pip "setuptools<=81.0.0" wheel

# First install pyyaml with available version (6.0.3 is latest)
RUN pip install "pyyaml==6.0.3"

# Install requirements from requirements.txt, but first fix the pyyaml version in a temporary copy
RUN sed 's/pyyaml==6.0/pyyaml==6.0.3/' requirements.txt > /tmp/requirements_fixed.txt && \
    pip install -r /tmp/requirements_fixed.txt

# Install Auto-GPT in development mode
RUN pip install -e .

# Install additional testing dependencies (including those from requirements.txt testing section)
RUN pip install pytest pytest-asyncio pytest-mock pytest-xdist pytest-timeout pytest-cov pytest-benchmark pytest-integration pytest-recording flaky asynctest vcrpy

# Install additional required packages for standalone script execution and AI framework
RUN pip install litellm mem0ai anyio

# Preflight import check
RUN python -c "import autogpt, pytest, openai, yaml, requests, json, os, sys; print('Preflight import check passed'); print(f'OpenAI base URL: {os.environ.get(\"OPENAI_BASE_URL\")}')"

