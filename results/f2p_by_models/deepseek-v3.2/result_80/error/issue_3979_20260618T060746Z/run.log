[32m# branch: python/requirements.txt
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Set Python environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl git gcc g++ \
    libxml2-dev libxslt1-dev \
    libjpeg-dev libtiff5-dev libwebp-dev zlib1g-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Create virtual environment to avoid system package conflicts
RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"

# First install Cython and build tools for PyYAML
RUN pip install cython "setuptools<=70.0.0" wheel

# Install PyYAML 5.4.1 instead of 6.0 to avoid build issues with newer setuptools
RUN pip install "pyyaml==5.4.1"

# Upgrade pip and install other build tools
RUN pip install --upgrade pip hatchling

# Install dependencies from requirements.txt
# Handle main dependencies (before "##Dev" marker), excluding pyyaml since we installed it
RUN if [ -f "requirements.txt" ]; then \
        # Extract lines before "##Dev" marker, exclude pyyaml line
        sed -n '/^##Dev/q;p' requirements.txt | grep -v "^pyyaml==" > /tmp/main_requirements.txt && \
        pip install -r /tmp/main_requirements.txt; \
    fi

# Install development dependencies (after "##Dev" marker)
RUN if [ -f "requirements.txt" ]; then \
        # Extract lines after "##Dev" marker for dev dependencies
        sed -n '/^##Dev/,$p' requirements.txt | tail -n +2 > /tmp/dev_requirements.txt && \
        # Check if file has content before installing
        if [ -s /tmp/dev_requirements.txt ]; then \
            pip install -r /tmp/dev_requirements.txt; \
        fi; \
    fi

# Install the package in editable mode
RUN pip install -e .

# Install additional test dependencies that might not be in requirements.txt
RUN pip install pytest-xdist pytest-timeout pytest-asyncio pytest-cov pytest-mock

# Install Forge API compatibility packages
RUN pip install litellm anyio

# Install vcrpy from git
RUN pip install git+https://github.com/Significant-Gravitas/vcrpy.git@master

# Install auto-gpt-plugin-template
RUN pip install git+https://github.com/Significant-Gravitas/Auto-GPT-Plugin-Template@0.1.0

# Preflight import check - fixed single-line syntax
RUN python -c "import autogpt, pytest, openai, yaml, requests, json, os, sys; print('Preflight import check passed'); print(f'OpenAI base URL: {os.environ.get(\"OPENAI_BASE_URL\")}'); print(f'Anthropic base URL: {os.environ.get(\"ANTHROPIC_BASE_URL\")}'); print(f'Forge API key set: {bool(os.environ.get(\"FORGE_API_KEY\"))}')"

