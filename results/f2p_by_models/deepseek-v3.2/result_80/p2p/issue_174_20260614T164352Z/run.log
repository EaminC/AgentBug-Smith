            "platform": "openai",
            "api_key": "test_key",
        }
        with open(config_path, "w") as f:
            import yaml
            yaml.dump(config, f)

        # Temporarily replace get_config to return our config
        original_get_config = get_config
        try:
            import mle.model
            mle.model.get_config = lambda project_dir: config

            with patch("openai.OpenAI") as mock_openai_class:
                mock_client = MagicMock()
                mock_openai_class.return_value = mock_client
                model = load_model(tmpdir, model_name="gpt-4")
                # In buggy code, model is an ObservableModel wrapping OpenAIModel.
                # In fixed code, model is directly an OpenAIModel.
                assert isinstance(model, OpenAIModel)
        finally:
            mle.model.get_config = original_get_config


