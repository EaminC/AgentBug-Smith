import tempfile
from unittest.mock import patch, MagicMock
from mle.model import OpenAIModel, load_model, get_config

def test_openai_model_base_url():
    """
    Test that OpenAIModel uses OPENAI_BASE_URL environment variable.
    In buggy code, base_url is not passed to OpenAI client.
    In fixed code, base_url is passed via os.getenv("OPENAI_BASE_URL", "https://api.openai.com/v1").
    """
    # Clear environment variable to ensure default
    if "OPENAI_BASE_URL" in os.environ:
        del os.environ["OPENAI_BASE_URL"]
    with patch("openai.OpenAI") as mock_openai_class:
        mock_client = MagicMock()
        mock_openai_class.return_value = mock_client
        model = OpenAIModel(api_key="test_key", model="gpt-4")
        mock_openai_class.assert_called_once()
        call_kwargs = mock_openai_class.call_args[1]
        # Buggy code: no base_url key
        # Fixed code: base_url present with default
        if "base_url" not in call_kwargs:
            raise AssertionError("base_url not passed to OpenAI client")
        assert call_kwargs["base_url"] == "https://api.openai.com/v1"

def test_openai_model_custom_base_url():
    """
    Test that OpenAIModel respects OPENAI_BASE_URL environment variable.
    """
    os.environ["OPENAI_BASE_URL"] = "https://custom.example.com/v1"
    with patch("openai.OpenAI") as mock_openai_class:
        mock_client = MagicMock()
        mock_openai_class.return_value = mock_client
        model = OpenAIModel(api_key="test_key", model="gpt-4")
        mock_openai_class.assert_called_once()
        call_kwargs = mock_openai_class.call_args[1]
        if "base_url" not in call_kwargs:
            raise AssertionError("base_url not passed to OpenAI client")
        assert call_kwargs["base_url"] == "https://custom.example.com/v1"

def test_load_model_openai():
    """
    Test load_model returns OpenAIModel directly (no ObservableModel wrapper).
    In buggy code, load_model returns ObservableModel(model) when observable=True.
    In fixed code, load_model returns model directly (ObservableModel removed).
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = os.path.join(tmpdir, "config.yaml")
        config = {
            "platform": "openai",
            "api_key": "test_key",
        }
        with open(config_path, "w") as f:
            yaml = __import__("yaml")
            yaml.dump(config, f)

        # Temporarily replace get_config
        original_get_config = get_config
        try:
            import mle.model
            mle.model.get_config = lambda project_dir: config

            with patch("openai.OpenAI") as mock_openai_class:
                mock_client = MagicMock()
                mock_openai_class.return_value = mock_client
                model = load_model(tmpdir, model_name="gpt-4")
                # Buggy: model is ObservableModel
                # Fixed: model is OpenAIModel
                if hasattr(model, '__class__') and model.__class__.__name__ == "ObservableModel":
                    raise AssertionError("load_model returned ObservableModel, expected OpenAIModel")
                else:
                    assert isinstance(model, OpenAIModel)
        finally:
            mle.model.get_config = original_get_config

