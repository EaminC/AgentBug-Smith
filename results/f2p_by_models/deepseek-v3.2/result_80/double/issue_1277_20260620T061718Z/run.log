ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Set environment variables for Forge API
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Detect src/ layout to decide editable install
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." tests 2>/dev/null; then \
        # src layout detected: set PYTHONPATH, skip editable install
        export PYTHONPATH=/app && \
        if [ -f "requirements.txt" ]; then \
            pip install -r requirements.txt 2>/dev/null || true; \
        fi && \
        # Install core dependencies from pyproject.toml (optional dependencies not installed)
        pip install aioitertools anthropic dashscope docstring_parser json5 json_repair mcp>=1.13 numpy openai python-datauri opentelemetry-api>=1.39.0 opentelemetry-sdk>=1.39.0 opentelemetry-exporter-otlp>=1.39.0 opentelemetry-semantic-conventions>=0.60b0 python-socketio shortuuid tiktoken sounddevice sqlalchemy python-frontmatter 2>/dev/null || true && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
        # No src layout: editable install
        if [ -f "requirements.txt" ]; then \
            pip install -r requirements.txt 2>/dev/null || true; \
        fi && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

