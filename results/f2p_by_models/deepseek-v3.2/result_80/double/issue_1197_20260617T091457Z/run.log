def test_multiple_diffs_same_file():
    """
    Test that when multiple diffs for the same file are parsed,
    only the first one is kept (as per the fix in parse_diffs).
    """
    temp_dir = tempfile.mkdtemp()
    try:
        memory = DiskMemory(memory_path(temp_dir))

        chat_content = """
