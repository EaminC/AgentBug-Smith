import sys
import pytest
from gpt_engineer.core.chat_to_files import parse_diffs
from gpt_engineer.core.files_dict import FilesDict
from gpt_engineer.core.default.steps import salvage_correct_hunks
from langchain_core.messages import AIMessage

def test_multiple_diffs_same_file_bug():
    """
    Test that reproduces the bug: multiple diffs for the same file cause KeyError.
    Before the fix, parse_diffs would overwrite earlier diffs, leading to missing
    'filename_pre' keys in salvage_correct_hunks.
    After the fix, parse_diffs keeps only the first diff per file and prints a warning.
    """
    # Simulate a chat with two diffs for the same file, similar to the issue's scenario.
    chat_content = """
Here are the changes:

```diff
--- src/main/resources/application-stage.yml
+++ src/main/resources/application-stage.yml
@@ -1,3 +1,3 @@
 spring:
   datasource:
-    url: jdbc:postgresql://old:5432/db
+    url: jdbc:postgresql://new:5432/db
```

Also, we need to update another part:

```diff
--- src/main/resources/application-stage.yml
+++ src/main/resources/application-stage.yml
@@ -4,3 +4,3 @@
     username: user
-    password: oldpass
+    password: newpass
```
"""
    # Parse diffs: before fix, the second diff overwrites the first, causing missing lines.
    diffs = parse_diffs(chat_content)
    # The buggy code would have only one diff, but the second hunk would be missing.
    # The fix ensures only the first diff is kept, and a warning is printed.
    assert len(diffs) == 1
    assert "src/main/resources/application-stage.yml" in diffs
    # The diff should contain the first hunk only.
    diff_str = diffs["src/main/resources/application-stage.yml"].diff_to_string()
    assert "url: jdbc:postgresql://new:5432/db" in diff_str
    # The second hunk should NOT be present because it was discarded.
    assert "password: newpass" not in diff_str

def test_salvage_correct_hunks_with_missing_file():
    """
    Test that salvage_correct_hunks handles missing 'filename_pre' gracefully.
    This mimics the exact error from the issue: KeyError on 'src/main/resources/application-stage.yml'.
    """
    # Create a chat that references a file not in files_dict (like the issue's scenario).
    chat_content = """
```diff
--- src/main/resources/application-stage.yml
+++ src/main/resources/application-stage.yml
@@ -1,3 +1,3 @@
 spring:
   datasource:
-    url: jdbc:postgresql://stage:5432/db
+    url: jdbc:postgresql://local:5432/db
```
"""
    # Build an AIMessage similar to the test suite's message_builder.
    json = {
        "lc": 1,
        "type": "constructor",
        "id": ["langchain", "schema", "messages", "AIMessage"],
        "kwargs": {
            "content": chat_content,
            "additional_kwargs": {},
            "response_metadata": {"finish_reason": "stop"},
            "name": None,
            "id": None,
            "example": False,
        },
    }
    messages = [AIMessage(**json["kwargs"])]
    # FilesDict with only application.yml, not application-stage.yml.
    files = FilesDict({
        "src/main/resources/application.yml": "spring:\n  datasource:\n    url: jdbc:postgresql://stage:5432/db\n"
    })
    # This should not raise KeyError after the fix.
    # In the buggy code, salvage_correct_hunks would try to access files['src/main/resources/application-stage.yml']
    # and fail. The fix ensures parse_diffs doesn't produce a diff with missing pre-file.
    updated_files, errors = salvage_correct_hunks(messages, files, None)
    # The file should remain unchanged because the diff references a missing file.
    assert "src/main/resources/application.yml" in updated_files
    assert updated_files["src/main/resources/application.yml"] == files["src/main/resources/application.yml"]

def test_parse_diffs_multiple_diffs_same_file():
    """
    Test that parse_diffs correctly handles multiple diffs for the same file.
    Before fix: later diffs overwrite earlier ones, causing loss of context.
    After fix: only the first diff is kept, and a warning is printed.
    """
    multi_diff = """
```diff
--- a/file.txt
+++ a/file.txt
@@ -1,3 +1,3 @@
-first line
-second line
+updated first line
+updated second line
```
```diff
--- a/file.txt
+++ a/file.txt
@@ -4,3 +4,3 @@
-third line
-fourth line
+updated third line
+updated fourth line
```
"""
    # Capture stdout to check for warning message.
    import io
    import sys
    old_stdout = sys.stdout
    sys.stdout = io.StringIO()
    diffs = parse_diffs(multi_diff)
    output = sys.stdout.getvalue()
    sys.stdout = old_stdout
    assert "Multiple diffs found for a/file.txt. Only the first one is kept." in output
    assert len(diffs) == 1
    diff = diffs["a/file.txt"]
    diff_str = diff.diff_to_string()
    assert "updated first line" in diff_str
    assert "updated third line" not in diff_str  # Second diff discarded.

if __name__ == "__main__":
    pytest.main([__file__, "-v"])[0m
