def test_zbf_yml_missing_keyerror():
    """
    Test that salvage_correct_hunks does not raise KeyError when a diff
    references a filename_pre that does not exist in files_dict.
    This reproduces the bug in issue #1197 where a diff referenced
    'src/main/resources/application-stage.yml' but the file was not present.
    """
    # Create a temporary directory for memory
    temp_dir = tempfile.mkdtemp()
    try:
        memory = DiskMemory(memory_path(temp_dir))
        
        # Simulate the chat content that caused the error
        # This is a simplified version of the problematic diff from the issue
        chat_content = """
Here are the changes:

```diff
--- src/main/resources/application-stage.yml
+++ src/main/resources/application-stage.yml
@@ -1,13 +1,13 @@
 spring:
   datasource:
-    url: jdbc:postgresql://<RDS_ENDPOINT>:5432/<DB_NAME>
-    username: <DB_USERNAME>
-    password: <DB_PASSWORD>
+    url: jdbc:postgresql://stage-rds-endpoint:5432/stage_db
+    username: stage_user
+    password: stage_password
     driver-class-name: org.postgresql.Driver
   jpa:
     hibernate:
       ddl-auto: update
     show-sql: true
     properties:
       hibernate:
         format_sql: true
```

```diff
--- src/main/resources/application.yml
+++ src/main/resources/application.yml
@@ -1,13 +1,13 @@
 spring:
   datasource:
-    url: jdbc:postgresql://<RDS_ENDPOINT>:5432/<DB_NAME>
-    username: <DB_USERNAME>
-    password: <DB_PASSWORD>
+    url: jdbc:postgresql://stage-rds-endpoint:5432/stage_db
+    username: stage_user
+    password: stage_password
     driver-class-name: org.postgresql.Driver
   jpa:
     hibernate:
       ddl-auto: update
     show-sql: true
     properties:
       hibernate:
         format_sql: true
```
"""
        
        # Create AIMessage
        message = AIMessage(
            content=chat_content,
            additional_kwargs={},
            response_metadata={"finish_reason": "stop"},
            name=None,
            id=None,
            example=False,
        )
        
        # FilesDict with only application.yml (application-stage.yml is missing)
        files = FilesDict({
            "src/main/resources/application.yml": """spring:
  datasource:
    url: jdbc:postgresql://<RDS_ENDPOINT>:5432/<DB_NAME>
    username: <DB_USERNAME>
    password: <DB_PASSWORD>
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
"""
        })
        
        # This should not raise KeyError after the fix
        # Before the fix, it would raise KeyError: 'src/main/resources/application-stage.yml'
        updated_files, errors = salvage_correct_hunks([message], files, memory)
        
        # Verify that we got updated files back
        assert isinstance(updated_files, FilesDict)
        assert isinstance(errors, list)
        
        # The application.yml should be updated
        assert "src/main/resources/application.yml" in updated_files
        updated_content = updated_files["src/main/resources/application.yml"]
        assert "stage-rds-endpoint" in updated_content
        assert "stage_user" in updated_content
        assert "stage_password" in updated_content
        
        # The application-stage.yml might be created if the diff creates it,
        # or it might be ignored/skipped depending on the implementation
        # The important thing is that no KeyError is raised
        
    finally:
        # Clean up
        shutil.rmtree(temp_dir, ignore_errors=True)


def test_multiple_diffs_same_file():
    """
    Test that when multiple diffs for the same file are parsed,
    only the first one is kept (as per the fix in parse_diffs).
    """
    temp_dir = tempfile.mkdtemp()
    try:
        memory = DiskMemory(memory_path(temp_dir))
        
        # Chat with multiple diffs for the same file
        chat_content = """
First diff:

```diff
--- example.txt
+++ example.txt
@@ -1,3 +1,3 @@
-first line
+first line updated
 second line
 third line
```

Second diff (should be ignored):

```diff
--- example.txt
+++ example.txt
@@ -2,3 +2,3 @@
 second line
+second line updated
 third line
```
"""
        
        message = AIMessage(
            content=chat_content,
            additional_kwargs={},
            response_metadata={"finish_reason": "stop"},
            name=None,
            id=None,
            example=False,
        )
        
        files = FilesDict({
            "example.txt": "first line\nsecond line\nthird line"
        })
        
        # This should not raise any exception
        updated_files, errors = salvage_correct_hunks([message], files, memory)
        
        # Verify the update
        assert "example.txt" in updated_files
        updated_content = updated_files["example.txt"]
        # Should have first update but not second
        assert "first line updated" in updated_content
        assert "second line updated" not in updated_content  # Second diff was ignored
        
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)


