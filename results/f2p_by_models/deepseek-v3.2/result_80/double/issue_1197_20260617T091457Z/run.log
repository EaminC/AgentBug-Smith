def test_multiple_diffs_same_file():
    """
    Test that when multiple diffs for the same file are parsed,
    only the first one is kept (as per the fix in parse_diffs).
    """
    temp_dir = tempfile.mkdtemp()
    try:
        memory = DiskMemory(memory_path(temp_dir))

        # Chat with multiple diffs for the same file
        chat_content = """
First diff:

```diff
--- example.txt
+++ example.txt
@@ -1,3 +1,3 @@
-first line
+first line updated
 second line
 third line
```

Second diff (should be ignored):

```diff
--- example.txt
+++ example.txt
@@ -2,3 +2,3 @@
 second line
+second line updated
 third line
```
"""

        message = AIMessage(
            content=chat_content,
            additional_kwargs={},
            response_metadata={"finish_reason": "stop"},
            name=None,
            id=None,
            example=False,
        )

        files = FilesDict({
            "example.txt": "first line\nsecond line\nthird line"
        })

        # This should not raise any exception
        updated_files, errors = salvage_correct_hunks([message], files, memory)

        # Verify the update
        assert "example.txt" in updated_files
        updated_content = updated_files["example.txt"]
        # Should have first update but not second
        assert "first line updated" in updated_content
        # The second diff should be ignored, so "second line updated" should NOT appear
        # (because the second diff is discarded, not applied)
        # Actually, after the fix, parse_diffs will keep only the first diff,
        # so the second diff is never processed.
        # The content should be: "first line updated\nsecond line\nthird line"
        lines = updated_content.splitlines()
        assert len(lines) == 3
        assert lines[0] == "first line updated"
        assert lines[1] == "second line"
        assert lines[2] == "third line"
    finally:
        import shutil
        shutil.rmtree(temp_dir, ignore_errors=True)[0m
