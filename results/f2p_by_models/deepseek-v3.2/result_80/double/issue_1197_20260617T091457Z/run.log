       ddl-auto: update
     show-sql: true
     properties:
       hibernate:
         format_sql: true
```
"""
    
    # Create AIMessage
    message = AIMessage(content=chat_content)
    
    # In buggy code, this would raise KeyError because:
    # 1. First diff creates entry for "src/main/resources/application.yml"
    # 2. Third diff tries to create entry for "src/main/resources/application-stage.yml"
    # 3. Later code tries to access files_dict["src/main/resources/application-stage.yml"]
    #    which doesn't exist in original files
    
    # In fixed code, duplicate diffs are ignored, so the third diff (which is actually
    # a second diff for application.yml but with wrong filename) would be ignored
    # with a warning, preventing the KeyError.
    
    # Mock the print function to capture warnings
    import io
    import sys
    captured_output = io.StringIO()
    sys.stdout = captured_output
    
    try:
        # This is the critical test: salvage_correct_hunks should not raise KeyError
