    updated_files, errors = salvage_correct_hunks([message], files, memory)
    # Assert that after the fix, we have both files updated/created
    assert "src/main/resources/application.yml" in updated_files
    assert "src/main/resources/application-local.yml" in updated_files
    # Check that the content of application.yml has been updated (stage config)
    assert "stage-rds-endpoint" in updated_files["src/main/resources/application.yml"]
    # Check that application-local.yml contains H2 config
    assert "jdbc:h2:mem:testdb" in updated_files["src/main/resources/application-local.yml"]
    # Ensure no errors (or errors list is empty)
    assert len(errors) == 0[0m
