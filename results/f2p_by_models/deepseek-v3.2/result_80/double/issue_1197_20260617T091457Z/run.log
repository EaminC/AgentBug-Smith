def test_multiple_diffs_same_file():
    """
    Test that when multiple diffs for the same file are parsed,
    only the first one is kept (as per the fix in parse_diffs).
    """
    temp_dir = tempfile.mkdtemp()
    try:
        memory = DiskMemory(memory_path(temp_dir))

        chat_content = """
First diff:

```diff
--- example.txt
+++ example.txt
@@ -1,3 +1,3 @@
-first line
+first line updated
 second line
 third line
```

Second diff (should be ignored):

```diff
--- example.txt
+++ example.txt
@@ -2,3 +2,3 @@
 second line
+second line updated
 third line
```
"""

        message = AIMessage(
            content=chat_content,
            additional_kwargs={},
            response_metadata={"finish_reason": "stop"},
            name=None,
            id=None,
            example=False,
        )

        files = FilesDict({
            "example.txt": "first line\nsecond line\nthird line"
        })

        updated_files, errors = salvage_correct_hunks([message], files, memory)
        assert "example.txt" in updated_files
        updated_content = updated_files["example.txt"]
        # Only the first diff should be applied, so the first line is updated
        assert "first line updated" in updated_content
        # The second diff should be ignored, so the second line should NOT have "second line updated"
        # (it would be "second line\nsecond line updated" if both diffs were applied)
        # Actually, with the fix, only the first diff is kept, so second line remains unchanged.
        # The expected content is "first line updated\nsecond line\nthird line"
        assert updated_content == "first line updated\nsecond line\nthird line"
    finally:
        import shutil
        shutil.rmtree(temp_dir, ignore_errors=True)[0m
