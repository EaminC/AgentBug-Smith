WORKDIR /app

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and setuptools early
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Install Poetry
RUN pip install poetry

# Configure Poetry to not create virtualenvs (use system Python)
RUN poetry config virtualenvs.create false

# Install main dependencies with dev group (includes pytest and test dependencies)
RUN poetry install --no-interaction --no-ansi --with dev

# Install additional test dependencies not covered by poetry dev group
RUN pip install pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout

# Note: litellm and mem0ai are not required by the project and cause version conflicts
# They were removed to avoid dependency issues with openai and python-dotenv versions

# Install the project in editable mode (compatible with pyproject.toml)
RUN pip install -e .

# Preflight import check - verify critical packages are importable
RUN python -c 'import pytest; import gpt_engineer; import openai; import langchain; print("preflight ok: all critical packages importable")'

