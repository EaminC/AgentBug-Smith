def test_multiple_diffs_same_file_keyerror():
    """
    Test that when a chat contains multiple diff hunks for the same file,
    the first diff is kept and subsequent diffs are ignored,
    preventing a KeyError when the missing file is referenced.
    """
    # This chat simulates the bug: multiple diffs for the same file,
    # where the second diff references a filename that doesn't exist in files_dict.
    chat_content = """
I'll update the configuration files.

```diff
--- src/main/resources/application.yml
+++ src/main/resources/application.yml
@@ -1,13 +1,13 @@
 spring:
   datasource:
-    url: jdbc:postgresql://<RDS_ENDPOINT>:5432/<DB_NAME>
-    username: <DB_USERNAME>
-    password: <DB_PASSWORD>
+    url: jdbc:postgresql://stage-rds-endpoint:5432/stage_db
+    username: stage_user
+    password: stage_password
     driver-class-name: org.postgresql.Driver
   jpa:
     hibernate:
       ddl-auto: update
     show-sql: true
```

Now, create a new file for local environment:

```diff
--- /dev/null
+++ src/main/resources/application-local.yml
@@ -0,0 +1,13 @@
+spring:
+  datasource:
+    url: jdbc:h2:mem:testdb
+    driver-class-name: org.h2.Driver
+    username: sa
+    password: password
+  h2:
+    console:
+      enabled: true
+  jpa:
+    hibernate:
+      ddl-auto: update
+    show-sql: true
```

Now, another diff for the same file (application.yml) but referencing a non-existent file name:

```diff
--- src/main/resources/application-stage.yml
+++ src/main/resources/application-stage.yml
@@ -1,13 +1,15 @@
 spring:
   profiles:
-    active: stage
+    active: stage
   datasource:
-    url: jdbc:postgresql://<RDS_ENDPOINT>:5432/<DB_NAME>
-    username: <DB_USERNAME>
-    password: <DB_PASSWORD>
+    url: jdbc:postgresql://stage-rds-endpoint:5432/stage_db
+    username: stage_user
+    password: stage_password
     driver-class-name: org.postgresql.Driver
   jpa:
     hibernate:
       ddl-auto: update
     show-sql: true
```
"""
    # Build an AIMessage as salvage_correct_hunks expects
    json = {
        "lc": 1,
        "type": "constructor",
        "id": ["langchain", "schema", "messages", "AIMessage"],
        "kwargs": {
            "content": chat_content,
            "additional_kwargs": {},
            "response_metadata": {"finish_reason": "stop"},
            "name": None,
            "id": None,
            "example": False,
        },
    }
    messages = [AIMessage(**json["kwargs"])]

    # Initial files dict contains only application.yml
    files = FilesDict({
        "src/main/resources/application.yml": """spring:
  datasource:
    url: jdbc:postgresql://<RDS_ENDPOINT>:5432/<DB_NAME>
    username: <DB_USERNAME>
    password: <DB_PASSWORD>
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
"""
    })

    memory = DiskMemory(memory_path("."))

    # In buggy code, this would raise KeyError because the second diff references
    # 'src/main/resources/application-stage.yml' which is not in files_dict.
    # After fix, the second diff is ignored (multiple diffs for same file),
    # and the function should succeed.
    updated_files, errors = salvage_correct_hunks(messages, files, memory)

    # Assert that no KeyError occurred and we have the expected files.
    assert "src/main/resources/application.yml" in updated_files
    assert "src/main/resources/application-local.yml" in updated_files
    # The second diff for application-stage.yml should be ignored, so that file should not appear.
    assert "src/main/resources/application-stage.yml" not in updated_files

    # Check that the content of application.yml is updated (first diff applied)
    content = updated_files["src/main/resources/application.yml"]
    assert "stage-rds-endpoint" in content
    assert "<RDS_ENDPOINT>" not in content

    # Check that application-local.yml was created
    local_content = updated_files["src/main/resources/application-local.yml"]
    assert "jdbc:h2:mem:testdb" in local_content


def test_parse_diffs_multiple_same_file():
    """
    Test that parse_diffs handles multiple diffs for the same file by keeping the first.
    """
    multi_diff = """
```
--- a/file1.txt
+++ a/file1.txt
@@ -1,3 +1,3 @@
-old line
+new line
```
```
--- a/file1.txt
+++ a/file1.txt
@@ -2,3 +2,3 @@
-another old line
+another new line
```
"""
    # Capture stdout to check for warning message
    old_stdout = sys.stdout
    sys.stdout = io.StringIO()
    diffs = parse_diffs(multi_diff)
    output = sys.stdout.getvalue()
    sys.stdout = old_stdout

    # After fix, a warning should be printed
    assert "Multiple diffs found for a/file1.txt. Only the first one is kept." in output

    # Only one diff object for file1.txt
    assert len(diffs) == 1
    assert "a/file1.txt" in diffs

    # The diff should be the first hunk
    diff_str = diffs["a/file1.txt"].diff_to_string()
    assert "old line" in diff_str
    assert "new line" in diff_str
    # The second hunk should not be present
    assert "another old line" not in diff_str
    assert "another new line" not in diff_str[0m
