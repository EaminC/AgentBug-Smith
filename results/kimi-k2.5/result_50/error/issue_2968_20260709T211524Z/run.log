RUN pip install --no-cache-dir -e ".[tools,embeddings,mem0,docling,pandas]"

# Install test dependencies
RUN pip install --no-cache-dir \
    pytest>=8.0.0 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
    pytest-recording>=0.13.2 \
    pytest-randomly>=3.16.0 \
    pytest-timeout>=2.3.1 \
    pytest-mock \
    pytest-xdist \
    pytest-cov \
    anyio \
    vcrpy \
    pyyaml

# Copy the rest of the repository
COPY . .

# Install CrewAI SDK explicitly for this framework
RUN pip install --no-cache-dir "crewai>=0.100.0"

# Clean up build dependencies to save space
RUN apt-get purge -y --auto-remove gcc g++ python3-dev \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /root/.cache/*

# Verify installation
RUN python -c "import crewai; print('preflight ok')"

CMD ["/bin/bash"]
