# All environment variables in a single ENV directive to minimize layers
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    FORGE_API_KEY="forge-key" \
    FORGE_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY="forge-key" \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1" \
    ANTHROPIC_AUTH_TOKEN="forge-key" \
    MODEL="tuzi-kimi-k2.5/kimi-k2.5" \
    ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5" \
    ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5" \
    AI_TEMPERATURE="0.7" \
    AI_MAX_TOKENS="1000" \
    AI_TOP_P="1" \
    AI_FREQUENCY_PENALTY="0" \
    AI_PRESENCE_PENALTY="0" \
    TAVILY_API_KEY="tvly-dev-key" \
    GITHUB_TOKEN="ghp_key"

# Single combined RUN: Install system deps, upgrade pip, cleanup
# Using --no-install-recommends and aggressive cleanup to save space
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libxml2-dev libxslt1-dev python3-dev build-essential git \
    && pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/* /var/tmp/* ~/.cache/pip /var/log/dpkg.log /var/log/apt/*

# Copy repository
COPY . .

# Single RUN for Python deps: Install test deps, install project, verify, cleanup
RUN pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout pytest-vcr pytest-subprocess anyio litellm mem0ai \
    && pip install --no-cache-dir -e . \
    && python -c "import crewai; print('crewai import OK')" \
    && python -c "import pytest; print('pytest import OK')" \
    && rm -rf ~/.cache/pip /tmp/* /var/tmp/* /root/.cache /app/.cache /root/.local/share /root/.config

CMD ["/bin/bash"]
