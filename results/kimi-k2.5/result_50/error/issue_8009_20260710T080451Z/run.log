    pip install --no-cache-dir -e . && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Install forge package
RUN cd /app/forge && \
    pip install --no-cache-dir -e . && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Install autogpt package
RUN cd /app/autogpt && \
    pip install --no-cache-dir -e . && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Install autogpt_libs
RUN if [ -d "/app/rnd/autogpt_libs" ]; then \
    cd /app/rnd/autogpt_libs && \
    pip install --no-cache-dir -e . && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*; \
    fi

# Install autogpt_server (optional, may fail if dependencies not fully resolved)
RUN if [ -d "/app/rnd/autogpt_server" ]; then \
    cd /app/rnd/autogpt_server && \
    pip install --no-cache-dir -e . || true && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*; \
    fi

