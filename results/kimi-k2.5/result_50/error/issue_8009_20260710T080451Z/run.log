    find /app -type f -name "*.pyc" -delete 2>/dev/null || true && \
    find /app -type d -name ".git" -exec rm -rf {} + 2>/dev/null || true && \
    find /app -type d -name "node_modules" -exec rm -rf {} + 2>/dev/null || true && \
    rm -rf /root/.cache/* /tmp/* /var/tmp/*

# Pre-flight check
RUN python -c "import pytest; import forge; print('preflight ok')"

