[32m# AutoGPT Environment Dockerfile with Forge API Configuration
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install wheel
RUN pip install --upgrade pip wheel

# Install poetry
RUN pip install poetry

# Copy the entire repository
COPY . .

# Configure poetry to not create virtual environment (use system Python)
RUN poetry config virtualenvs.create false

# Install forge package first (base dependency)
RUN if [ -f "forge/pyproject.toml" ]; then \
        cd forge && poetry install --no-interaction --no-ansi && cd ..; \
    fi

# Install benchmark package (used by others)
RUN if [ -f "benchmark/pyproject.toml" ]; then \
        cd benchmark && poetry install --no-interaction --no-ansi && cd ..; \
    fi

# Install autogpt package
RUN if [ -f "autogpt/pyproject.toml" ]; then \
        cd autogpt && poetry install --no-interaction --no-ansi && cd ..; \
    fi

# Install autogpt_libs
RUN if [ -f "rnd/autogpt_libs/pyproject.toml" ]; then \
        cd rnd/autogpt_libs && poetry install --no-interaction --no-ansi && cd ../..; \
    fi

# Install autogpt_server
RUN if [ -f "rnd/autogpt_server/pyproject.toml" ]; then \
        cd rnd/autogpt_server && poetry install --no-interaction --no-ansi && cd ../..; \
    fi

# Ensure pytest and testing tools are available
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout \
    setuptools litellm

# Pre-flight check
RUN python -c "import pytest; print('pytest ok')" && \
    python -c "import openai; print('openai ok')" && \
    python -c "import anthropic; print('anthropic ok')"

# --- Forge API Environment Variables ---
# OpenAI SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional environment variables
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

# Tavily and GitHub tokens
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key

# Set Python path for imports
ENV PYTHONPATH=/app:/app/forge:/app/autogpt:/app/rnd/autogpt_server:/app/rnd/autogpt_libs:/app/benchmark

# Default command
CMD ["/bin/bash"]
