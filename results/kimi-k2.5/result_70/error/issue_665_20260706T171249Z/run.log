ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python -m pip install --upgrade pip wheel setuptools

# Install langchain with a compatible version that doesn't have langchain_community split issues
# langchain 0.0.240-0.0.300 range has the old structure without community split
RUN pip install "langchain==0.0.300"

# Install other project dependencies with compatible versions
# Note: dataclasses-json must be <0.6 to avoid breaking changes
RUN pip install \
    "black==23.3.0" \
    "click>=8.0.0" \
    "mypy==1.3.0" \
    "openai==0.27.8" \
    "pre-commit==3.3.3" \
