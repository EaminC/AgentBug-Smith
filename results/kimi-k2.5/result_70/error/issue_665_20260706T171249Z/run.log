# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Install system dependencies including tk for matplotlib/PIL support
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    git \
    tk \
    libtk8.6 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python -m pip install --upgrade pip wheel setuptools

# Install test dependencies with compatible versions
# Pin pytest to 7.x to avoid FixtureDef import issues with pytest-asyncio
RUN pip install \
    "pytest>=7.3.1,<8.0.0" \
    "pytest-mock>=3.10.0" \
    "pytest-asyncio>=0.21.0,<0.22.0" \
    "pytest-cov>=4.1.0" \
    "pytest-xdist>=3.3.1" \
    "pytest-timeout>=2.1.0" \
    "anyio>=3.7.0" \
    "setuptools<=81.0.0" \
    "anthropic>=0.8.0" \
    "requests>=2.31.0"

# Copy the entire repository first (needed for pip install -e .)
COPY . .

# Install the project and all its dependencies from pyproject.toml
# This installs all dependencies declared in the project
RUN pip install -e .

# Fix: Install compatible langchain version (<0.1.0) for old import paths
# The code uses langchain.callbacks, langchain.chat_models, langchain.schema
# which were reorganized in langchain 0.1.0
RUN pip install "langchain>=0.0.240,<0.1.0" "langchain-community<0.1.0"

# Environment variables for Forge API compatibility
# For OpenAI SDK (old SDK v0.27.8 uses OPENAI_API_BASE)
ENV OPENAI_API_BASE=https://api.forge.tensorblock.co/v1
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# For Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional AI configuration
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

# Set Python path for imports
ENV PYTHONPATH=/app

# Basic preflight checks - only check imports that should work
RUN python -c "import openai; print('openai import ok')" && \
    python -c "import tiktoken; print('tiktoken import ok')" && \
    python -c "import pytest; print('pytest ok')" && \
    python -c "import requests; print('requests ok')" && \
    python -c "import langchain; print('langchain import ok')" && \
    python -c "from langchain.callbacks.openai_info import MODEL_COST_PER_1K_TOKENS; print('langchain.callbacks import ok')" && \
    python -c "from langchain.schema import AIMessage; print('langchain.schema import ok')" && \
    python -c "from gpt_engineer.db import DB, DBs; print('gpt_engineer.db import ok')"

CMD ["/bin/bash"]
