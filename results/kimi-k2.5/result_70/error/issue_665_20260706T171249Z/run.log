    gcc \
    python3-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python -m pip install --upgrade pip wheel setuptools

# Install dependencies with exact versions to match codebase expectations
# Using old langchain version (pre-community split) with openai 0.27.8
