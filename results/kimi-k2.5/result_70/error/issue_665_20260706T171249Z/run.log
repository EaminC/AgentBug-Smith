    python -c 'import gpt_engineer.db; print("gpt_engineer.db import ok")' && \
    python -c 'import gpt_engineer.chat_to_files; print("gpt_engineer.chat_to_files import ok")' && \
    python -c 'import gpt_engineer.collect; print("gpt_engineer.collect import ok")'

CMD ["/bin/bash"]
