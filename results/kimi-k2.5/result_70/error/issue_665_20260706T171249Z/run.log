ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python -m pip install --upgrade pip wheel

# Install langchain first (old version with all-in-one package)
# langchain 0.0.350 is the last version before the community split
RUN pip install "langchain==0.0.350"

# Install all other dependencies WITHOUT allowing langchain-community
# Using specific versions known to work with this codebase
RUN pip install "black==23.3.0" "click>=8.0.0" "mypy==1.3.0" "openai==0.27.8" \
    "pre-commit==3.3.3" "pytest==7.3.1" "ruff==0.0.272" "termcolor==2.3.0" \
    "typer>=0.3.2" "rudder-sdk-python==2.0.2" "dataclasses-json==0.5.7" \
    "tiktoken>=0.0.4" "tabulate==0.9.0" "python-dotenv>=0.21.0"

# Install test dependencies (without any packages that might pull langchain-community)
RUN pip install "pytest-mock>=3.10.0" "pytest-asyncio>=0.21.0" "pytest-cov>=4.1.0" \
    "anyio>=3.7.0" "setuptools<=81.0.0" "pytest-xdist>=3.3.1" "pytest-timeout>=2.1.0"

# Copy the entire repository
COPY . .

# Install the project itself without dependencies (already installed)
RUN pip install --no-deps -e .

# Explicitly uninstall langchain-community if it was pulled in
RUN pip uninstall -y langchain-community || true

# Environment variables for Forge API compatibility
# For OpenAI SDK (old SDK v0.27.8 uses OPENAI_API_BASE)
ENV OPENAI_API_BASE=https://api.forge.tensorblock.co/v1
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# For Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional AI configuration
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

# Preflight check - verify key imports work
RUN python -c 'from langchain.callbacks.openai_info import MODEL_COST_PER_1K_TOKENS; print("langchain MODEL_COST_PER_1K_TOKENS import ok")' && \
    python -c 'from langchain.chat_models import ChatOpenAI; print("langchain ChatOpenAI import ok")' && \
    python -c 'import pytest; print("pytest ok")' && \
    python -c 'import gpt_engineer; print("gpt_engineer import ok")'

