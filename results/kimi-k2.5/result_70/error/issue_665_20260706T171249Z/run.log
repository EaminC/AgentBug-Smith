# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Install system dependencies including tkinter libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    git \
    python3-tk \
    tk-dev \
    libtk8.6 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python -m pip install --upgrade pip wheel setuptools

# Install core dependencies first (specific versions for compatibility)
# Old langchain (pre-community split) with openai 0.27.8
RUN pip install \
    "openai==0.27.8" \
    "langchain==0.0.240" \
    "tiktoken>=0.0.4" \
    "requests>=2.28.0" \
    "dataclasses-json==0.5.7" \
    "python-dotenv>=0.21.0" \
    "termcolor==2.3.0" \
    "tabulate==0.9.0" \
    "typer>=0.3.2" \
    "click>=8.0.0" \
    "pydantic<2.0.0" \
    "PyYAML>=6.0"

# Install test dependencies
RUN pip install \
    "pytest==7.3.1" \
    "pytest-mock>=3.10.0" \
    "pytest-asyncio>=0.21.0" \
    "pytest-cov>=4.1.0" \
    "pytest-xdist>=3.3.1" \
    "pytest-timeout>=2.1.0" \
    "anyio>=3.7.0" \
    "setuptools<=81.0.0"

# Copy the entire repository
COPY . .

# Install the project in editable mode (with dependencies already satisfied)
RUN pip install -e . --no-deps

# Environment variables for Forge API compatibility
# For OpenAI SDK v0.27.8 (old SDK uses OPENAI_API_BASE)
ENV OPENAI_API_BASE=https://api.forge.tensorblock.co/v1
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# For Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional AI configuration
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

# Set Python path for imports
ENV PYTHONPATH=/app

# Preflight checks - verify key imports work (excluding tkinter-dependent imports in headless mode)
RUN python -c "import openai; print('openai import ok')" && \
    python -c "import langchain; print('langchain import ok')" && \
    python -c "from langchain.callbacks.openai_info import MODEL_COST_PER_1K_TOKENS; print('MODEL_COST_PER_1K_TOKENS import ok')" && \
