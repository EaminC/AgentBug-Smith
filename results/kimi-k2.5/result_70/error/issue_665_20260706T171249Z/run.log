    "openai==0.27.8" \
    "langchain==0.0.240" \
    "tiktoken>=0.0.4" \
    "requests>=2.28.0" \
    "dataclasses-json==0.5.7" \
    "python-dotenv>=0.21.0" \
    "termcolor==2.3.0" \
    "tabulate==0.9.0" \
    "typer>=0.3.2" \
    "click>=8.0.0" \
    "pydantic<2.0.0" \
    "PyYAML>=6.0" \
    "black==23.3.0" \
    "mypy==1.3.0" \
    "pre-commit==3.3.3" \
    "ruff==0.0.272" \
    "rudder-sdk-python==2.0.2"

# Install test dependencies
RUN pip install \
    "pytest==7.3.1" \
    "pytest-mock>=3.10.0" \
    "pytest-asyncio>=0.21.0" \
    "pytest-cov>=4.1.0" \
