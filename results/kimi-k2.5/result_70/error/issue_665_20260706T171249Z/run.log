[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Install system dependencies including tk for matplotlib and compilation tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    libtk8.6 \
    libtcl8.6 \
    tk-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy the entire repository
COPY . .

# Upgrade pip and install wheel
RUN python -m pip install --upgrade pip wheel

# Install a specific compatible version of langchain that has MODEL_COST_PER_1K_TOKENS
# langchain 0.0.350 is the last 0.0.x version with the old import structure
# Do NOT install langchain-community as it conflicts with the old structure
RUN pip install "langchain==0.0.350"

# Install project dependencies and the project itself
# First install dependencies excluding langchain to avoid version conflicts
RUN pip install "black==23.3.0" "click>=8.0.0" "mypy==1.3.0" "openai==0.27.8" \
    "pre-commit==3.3.3" "pytest==7.3.1" "ruff==0.0.272" "termcolor==2.3.0" \
    "typer>=0.3.2" "rudder-sdk-python==2.0.2" "dataclasses-json==0.5.7" \
    "tiktoken>=0.0.4" "tabulate==0.9.0" "python-dotenv>=0.21.0"

# Install the project in editable mode (skipping dependencies since we installed them manually)
RUN pip install --no-deps -e .

# Install additional test dependencies - DO NOT install litellm or mem0ai
# as they pull in langchain-community which conflicts with old langchain 0.0.350
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio \
    "setuptools<=81.0.0" pytest-xdist pytest-timeout

# Environment variables for Forge API compatibility
# For OpenAI SDK (old SDK v0.27.8 uses OPENAI_API_BASE)
ENV OPENAI_API_BASE=https://api.forge.tensorblock.co/v1
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# For LangChain OpenAI compatibility
ENV OPENAI_API_KEY=forge-key

# For Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional AI configuration
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

# Preflight check - verify langchain import works
RUN python -c 'from langchain.callbacks.openai_info import MODEL_COST_PER_1K_TOKENS; print("langchain import ok")' && \
    python -c 'import pytest; print("pytest ok")' && \
    python -c 'import gpt_engineer; print("gpt_engineer import ok")'

CMD ["/bin/bash"]
