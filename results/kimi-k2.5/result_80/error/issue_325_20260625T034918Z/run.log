[32mimport os
import pytest
from gpt_engineer.ai import AI
from langchain.chat_models import AzureChatOpenAI, ChatOpenAI


def test_ai_accepts_azure_endpoint_parameter(monkeypatch):
    """
    Test that AI.__init__ accepts azure_endpoint argument and creates AzureChatOpenAI.
    Fails before fix: TypeError: __init__() got an unexpected keyword argument 'azure_endpoint'
    Passes after fix: AI instance created with AzureChatOpenAI llm.
    """
    monkeypatch.setenv("OPENAI_API_KEY", "fake-key-for-testing")
    
    ai = AI(model_name="test-deployment", azure_endpoint="https://test.openai.azure.com")
    
    assert hasattr(ai, "azure_endpoint")
    assert ai.azure_endpoint == "https://test.openai.azure.com"
    assert isinstance(ai.llm, AzureChatOpenAI)


def test_ai_without_azure_endpoint_uses_chat_openai(monkeypatch):
    """
    Test backward compatibility: AI without azure_endpoint still uses ChatOpenAI.
    """
    monkeypatch.setenv("OPENAI_API_KEY", "fake-key-for-testing")
    
    ai = AI(model_name="gpt-4")
    
    assert ai.azure_endpoint == ""
    assert isinstance(ai.llm, ChatOpenAI)[0m
