[32mfrom agent.utils.system import run_command


def test_run_command_executes_all_commands_in_list():
    """
    Regression test for issue #40: only the first dependency was being installed.
    
    The bug was in run_command() which expected a single command string but was
    called with a list of commands. When shell=True and a list is passed to 
    subprocess.Popen, only the first command executes.
    
    After the fix, run_command() iterates over the list and executes all commands.
    """
    # Use echo commands to verify all commands in the list are executed
    commands = ['echo "dependency_1"', 'echo "dependency_2"', 'echo "dependency_3"']
    
    result = run_command(commands)
    
    # Fixed version returns a list of (output, exit_code) tuples
    assert isinstance(result, list), (
        f"Expected list return type, got {type(result).__name__}. "
        f"Bug: run_command does not handle multiple commands."
    )
    
    assert len(result) == 3, (
        f"Expected 3 command results, got {len(result)}. "
        f"Bug: only {len(result)} command(s) executed instead of 3."
    )
    
    # Verify all three commands actually ran and produced output
    outputs = [r[0] for r in result]
    exit_codes = [r[1] for r in result]
    
    assert "dependency_1" in outputs[0], f"First command output missing: {outputs[0]}"
    assert "dependency_2" in outputs[1], f"Second command output missing: {outputs[1]}"
    assert "dependency_3" in outputs[2], f"Third command output missing: {outputs[2]}"
    
    # Verify all commands succeeded
    for i, code in enumerate(exit_codes):
        assert code == 0, f"Command {i+1} failed with exit code {code}"[0m
