from dapr_agents.agents.orchestrators.random import RandomOrchestrator


def test_final_summary_callback_invoked_on_workflow_completion():
    """
    Test that the final_summary_callback is invoked when workflow completes.
    
    Verifies the fix for issue #209 - workflow completion callback capabilities.
    On buggy code: TypeError on __init__ or AttributeError on _invoke_final_summary_callback.
    On fixed code: Callback is invoked with the summary string.
    """
    received_summaries = []
    
    def capture_callback(summary: str) -> None:
        received_summaries.append(summary)
    
    # Verify constructor accepts final_summary_callback parameter
    orchestrator = RandomOrchestrator(
        name="test_callback_orchestrator",
        final_summary_callback=capture_callback
    )
    
    # Verify _invoke_final_summary_callback method exists and invokes the callback
    test_summary = "Workflow completed successfully with final output"
    orchestrator._invoke_final_summary_callback(test_summary)
    
    # Assert callback received the summary
    assert len(received_summaries) == 1
    assert received_summaries[0] == test_summary[0m
