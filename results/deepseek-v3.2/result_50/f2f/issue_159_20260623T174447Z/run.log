WORKDIR /app

# Install system dependencies if needed (none evidenced)
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

# Copy entire repo
COPY . .

# Preflight check for required files
RUN [ -f requirements.txt ] && echo "requirements.txt exists" || echo "requirements.txt not found"
RUN [ -f setup.py ] && echo "setup.py exists" || echo "setup.py not found"

# Detect src/ layout to decide editable install
RUN if [ -d src ] && find . -name "*.py" -exec grep -l "^import src\." {} \; > /dev/null 2>&1; then \
        echo "src layout detected, skipping editable install"; \
        export SKIP_EDITABLE=1; \
    else \
        echo "no src layout detected, will install editable"; \
        export SKIP_EDITABLE=0; \
    fi

# Install dependencies and project
RUN python -m pip install --upgrade pip wheel && \
    if [ -f requirements.txt ]; then \
        pip install -r requirements.txt; \
    fi && \
    if [ "$SKIP_EDITABLE" = "0" ]; then \
        pip install -e .; \
    else \
        echo "Skipping editable install, setting PYTHONPATH"; \
        export PYTHONPATH=/app; \
    fi && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Ensure mle module can be imported
RUN python -c "import mle; print('mle import OK')"

# Set PYTHONPATH if src layout was detected
ENV PYTHONPATH=${PYTHONPATH:-/app}

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command (from setup.py entry_points: mle-agent=mle.cli:cli, mle=mle.cli:cli)
