def test_clarify_dataset_blur_name():
    """
    Test that clarify_dataset suggests datasets when dataset name is blur.
    On buggy code: AdviseAgent does NOT have clarify_dataset method -> AttributeError.
    On fixed code: method exists and works with mocked model.
    """
    mock_model = Mock(spec=Model)
    # Simulate "No" (blur dataset) for the first verification call
    mock_model.query.side_effect = [
        "No",
        json.dumps({
            "datasets": ["MNIST", "CIFAR-10", "ImageNet"],
            "reason": "Based on the user's dataset description..."
        })
    ]

    console = Console()
    with patch('mle.agents.advisor.get_config', return_value={'search_key': 'dummy'}):
        agent = AdviseAgent(mock_model, console)

    # If the method does not exist, AttributeError will be raised (buggy).
    # That's what we want for fail2pass.
    # If it exists, we need to mock questionary.select to avoid interactive prompt.
    with patch('mle.agents.advisor.questionary.select') as mock_select:
        mock_select.return_value.ask.return_value = "MNIST"
        result = agent.clarify_dataset("some blur dataset")

    # Verify the model was called twice (once for verification, once for suggestion)
    assert mock_model.query.call_count == 2
    # First call should be the verification
    first_call_args = mock_model.query.call_args_list[0]
    # The verification prompt contains "verifing dataset" (note the typo in the original code)
    # The chat_history is a list of dicts; the last element is the user prompt.
    # The first_call_args[0] is the tuple of positional arguments; first element is chat_history.
    chat_history = first_call_args[0][0]
    last_message = chat_history[-1]
    # The verification prompt contains "verifing dataset" (typo in buggy/fixed code)
    assert "verifing dataset" in last_message["content"].lower()


def test_clarify_dataset_clear_name():
    """
    Test that clarify_dataset returns early when dataset is clear.
    On buggy code: AdviseAgent does NOT have clarify_dataset method -> AttributeError.
    On fixed code: method exists and returns None (early exit).
    """
    mock_model = Mock(spec=Model)
    # Simulate "Yes" (clear dataset) for the verification call
    mock_model.query.return_value = "Yes"

    console = Console()
    with patch('mle.agents.advisor.get_config', return_value={'search_key': 'dummy'}):
        agent = AdviseAgent(mock_model, console)

    # If the method does not exist, AttributeError will be raised (buggy).
    # That's what we want for fail2pass.
    result = agent.clarify_dataset("MNIST")

    # Verify the model was called only once (the verification)
    mock_model.query.assert_called_once()
    # The call should be the verification (no second call for suggestions)
    call_args = mock_model.query.call_args[0]
    chat_history = call_args[0]
    last_message = chat_history[-1]
    # The verification prompt contains "verifing dataset" (typo in buggy/fixed code)
    assert "verifing dataset" in last_message["content"].lower()
    # The method should return None (early exit)
    assert result is None


