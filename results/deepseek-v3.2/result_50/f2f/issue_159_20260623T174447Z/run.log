[32mimport json
import sys
import os
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from mle.agents.advisor import AdviseAgent
from mle.model import Model
from unittest.mock import Mock, patch
from rich.console import Console


def test_clarify_dataset_blur_name():
    """
    Test that clarify_dataset correctly handles a blur dataset name.
    In buggy code, the method does not exist; after fix, it should exist and return a mock choice.
    """
    # Create a mock model that returns deterministic responses
    mock_model = Mock(spec=Model)
    # First call: simulate "No" (blur dataset)
    mock_model.query.side_effect = [
        "No",  # First verification response
        json.dumps({"datasets": ["MNIST", "CIFAR-10", "ImageNet"], "reason": "test"})  # Suggestions
    ]

    console = Console()
    agent = AdviseAgent(mock_model, console)

    # Mock questionary.select to return a fixed choice
    with patch('mle.agents.advisor.questionary.select') as mock_select:
        mock_select.return_value.ask.return_value = "MNIST"
        result = agent.clarify_dataset("some blur dataset")

    # Assertions
    assert result == "MNIST"
    # Verify the model was called twice
    assert mock_model.query.call_count == 2
    # First call: verification
    first_call_args = mock_model.query.call_args_list[0]
    first_history = first_call_args[0][0]
    assert "verify whether the user's dataset is unclear or blur" in first_history[-1]["content"]
    # Second call: suggestions with JSON format
    second_call_args = mock_model.query.call_args_list[1]
    second_history = second_call_args[0][0]
    assert "suggest up to five publicly available datasets" in second_history[-1]["content"]
    assert second_call_args[1]["response_format"] == {"type": "json_object"}


def test_clarify_dataset_clear_name():
    """
    Test that clarify_dataset returns early when dataset is clear.
    """
    mock_model = Mock(spec=Model)
    # First call: simulate "Yes" (clear dataset)
    mock_model.query.return_value = "Yes"

    console = Console()
    agent = AdviseAgent(mock_model, console)

    result = agent.clarify_dataset("mnist.csv")
    # Should return None because verification passed
    assert result is None
    mock_model.query.assert_called_once()
    # Ensure second call (suggestions) never happened
    assert mock_model.query.call_count == 1


def test_clarify_dataset_integration_with_baseline():
    """
    Test that baseline workflow integrates clarify_dataset correctly.
    """
    from mle.workflow.baseline import baseline
    from mle.utils.system import print_in_box
    from mle.function.interaction import ask_text

    # Mock dependencies
    with patch('mle.workflow.baseline.ask_text') as mock_ask_text, \
         patch('mle.workflow.baseline.AdviseAgent') as MockAdvisor, \
         patch('mle.workflow.baseline.print_in_box') as mock_print, \
         patch('mle.workflow.baseline.cache') as mock_cache:

        # Simulate cache miss
        mock_context = Mock()
        mock_context.__enter__ = Mock()
        mock_context.__exit__ = Mock()
        mock_context.resume.return_value = None
        mock_context.store = Mock()
        mock_cache.return_value = mock_context

        # Mock ask_text to return a blur dataset name
        mock_ask_text.return_value = "some blur dataset"

        # Mock advisor and its clarify_dataset method
        mock_advisor_instance = Mock()
        mock_advisor_instance.clarify_dataset.return_value = "MNIST"
        MockAdvisor.return_value = mock_advisor_instance

        # Mock model (not used directly but required)
        mock_model = Mock()

        # Run baseline
        baseline("/tmp/test_workdir", model=mock_model)

        # Verify advisor was instantiated with correct args
        MockAdvisor.assert_called_once_with(mock_model, mock_print.call_args[0][1] if mock_print.called else Mock())
        # Verify clarify_dataset was called with the blur dataset
        mock_advisor_instance.clarify_dataset.assert_called_once_with("some blur dataset")
        # Verify cache store was called with the clarified dataset
        mock_context.store.assert_called_once_with("dataset", "MNIST")


