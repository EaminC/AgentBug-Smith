                with patch('mle.workflow.baseline.AdviseAgent') as MockAdviseAgent:
                    mock_advisor = Mock()
                    mock_advisor.clarify_dataset.return_value = "clarified dataset"
                    MockAdviseAgent.return_value = mock_advisor
                    # Call baseline with a dummy work_dir and model
                    baseline("dummy_work_dir", model=None)
