from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent
from agentscope.message import Msg
from agentscope.models import OpenAIChatWrapper
from agentscope.tool import ToolUseBlock


def test_deep_research_agent_acting_with_none_metadata():
    """Test that DeepResearchAgent._acting handles chunk.metadata being None."""
    # Mock the agent's dependencies to avoid needing real API keys
    with patch.object(DeepResearchAgent, '__init__', lambda self, **kwargs: None):
        agent = DeepResearchAgent.__new__(DeepResearchAgent)
        agent.finish_function_name = "finish"
        agent.summarize_function = "summarize"
        agent.current_subtask = []
        agent.draft_report = ""
        agent.intermediate_report = ""
        agent.memory = None
        agent._print = AsyncMock()

        # Create a mock tool call
        tool_call = ToolUseBlock(
            id="test_id",
            name="test_tool",
            input={}
        )

        # Create a mock chunk with metadata = None
        mock_chunk = MagicMock()
        mock_chunk.metadata = None
        mock_chunk.is_last = True

        # Mock the tool_res async generator
        async def mock_tool_res():
            yield mock_chunk

        tool_res = mock_tool_res()

        # Mock the agent's _call_tool method to return our mock generator
        agent._call_tool = AsyncMock(return_value=tool_res)

        # Run _acting and ensure it doesn't raise AttributeError
        import asyncio
        result = asyncio.run(agent._acting(tool_call))

        # The method should return None because metadata is None and no success
        assert result is None
        # Ensure _print was called (since chunk.is_last is True)
        agent._print.assert_called_once()[0m
