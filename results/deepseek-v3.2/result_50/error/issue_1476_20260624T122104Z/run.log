class MockChunk:
    def __init__(self, metadata=None, is_last=False, content=None):
        self.metadata = metadata
        self.is_last = is_last
        self.content = content


@pytest.mark.asyncio
async def test_deep_research_agent_acting_with_none_metadata():
    """Test that _acting handles chunk.metadata being None without AttributeError."""
    # Create a minimal agent instance with required attributes
    agent = DeepResearchAgent(
        name="test_agent",
        model=MagicMock(),
        tools=[],
        finish_function_name="finish",
        summarize_function="summarize",
        generate_response_function="generate_response",
        search_function="search",
        max_subtasks=5,
        max_search_results=3,
        max_tokens_per_subtask=1000,
        max_total_tokens=5000,
    )
