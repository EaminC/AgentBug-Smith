from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


class TestDeepResearchAgentBug1476:
    """Test for bug #1476: AttributeError when chunk.metadata is None."""

    @pytest.mark.asyncio
    async def test_acting_with_none_metadata(self) -> None:
        """Test that _acting handles chunk.metadata being None without AttributeError."""
        # Create a minimal agent instance with required attributes
        agent = DeepResearchAgent(
            name="test_agent",
            model_config_name="dummy_model",
            system_prompt="Test",
        )

        # Mock the required methods and attributes
        agent.finish_function_name = "finish"
        agent.summarize_function = "summarize"
        agent.current_subtask = []
        agent.print = AsyncMock()

        # Create a tool call that will trigger the problematic code path
        tool_call = {
            "name": "some_tool",
            "input": {},
        }

        # Create a mock chunk with metadata = None
        mock_chunk = MagicMock()
        mock_chunk.metadata = None
        mock_chunk.is_last = True

        # Create an async generator that yields our mock chunk
        async def mock_tool_res():
            yield mock_chunk

        # Mock the tool execution to return our async generator
        with patch.object(agent, "_execute_tool", return_value=mock_tool_res()):
            # This should not raise AttributeError: 'NoneType' object has no attribute 'get'
            result = await agent._acting(tool_call)

            # Verify the method completed without exception
            assert result is None

    @pytest.mark.asyncio
    async def test_acting_with_dict_metadata(self) -> None:
        """Test that _acting works correctly when chunk.metadata is a dict."""
        agent = DeepResearchAgent(
            name="test_agent",
            model_config_name="dummy_model",
            system_prompt="Test",
        )

        agent.finish_function_name = "finish"
        agent.summarize_function = "summarize"
        agent.current_subtask = []
        agent.print = AsyncMock()

        tool_call = {
            "name": "finish",
            "input": {},
        }

        mock_chunk = MagicMock()
        mock_chunk.metadata = {"success": True, "response_msg": Msg("assistant", "Done")}
        mock_chunk.is_last = True

        async def mock_tool_res():
            yield mock_chunk

