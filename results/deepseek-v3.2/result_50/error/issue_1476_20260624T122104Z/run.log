from agentscope.message import Msg
from examples.agent.deep_research_agent.deep_research_agent import (
    DeepResearchAgent,
)


def test_deep_research_agent_acting_with_none_metadata():
    """Test that _acting handles chunk.metadata being None without AttributeError."""
    # Mock the agent's dependencies
    agent = DeepResearchAgent(
        name="test_agent",
        model_config_name="test_model",
        system_prompt="test",
    )

    # Mock necessary attributes
    agent.finish_function_name = "finish"
    agent.summarize_function = "summarize"
    agent.current_subtask = []
    agent.print = AsyncMock()
    agent._generate_response = AsyncMock()
    agent._summarize = AsyncMock()
    agent._update_memory = AsyncMock()

    # Create a mock tool call
    tool_call = {
        "name": "some_tool",
        "input": {},
    }

    # Create a mock async generator that yields a chunk with metadata=None
    mock_chunk = MagicMock()
    mock_chunk.metadata = None
    mock_chunk.is_last = True
    mock_chunk.content = "test content"

    # Mock tool_res as an async generator
    async def mock_tool_res():
        yield mock_chunk

    # Mock the tool call execution to return our async generator
    with patch.object(agent, "_execute_tool_call", return_value=mock_tool_res()):
        # Run _acting and expect no AttributeError
        # In buggy code, this will raise AttributeError: 'NoneType' object has no attribute 'get'
        # In fixed code, it should handle None metadata gracefully.
        result = asyncio.run(agent._acting(tool_call))

        # Assert that the method completed without raising AttributeError
        # If we reach here without exception, the test passes for fixed code.
        # For buggy code, the AttributeError will cause test failure.
        assert result is None or isinstance(result, Msg)[0m
