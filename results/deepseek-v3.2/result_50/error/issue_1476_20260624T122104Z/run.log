    agent.current_subtask = []
    agent.draft_report = ""
    agent.print = AsyncMock()

    tool_call = ToolUseBlock(
        id="test_call",
        name="generate_response",
        input={"query": "test"},
    )

    # Create chunk with metadata dict
    chunk = MagicMock()
    chunk.metadata = {"success": True, "response_msg": Msg("assistant", "response")}
    chunk.is_last = True

    async def mock_tool_res():
        yield chunk

    tool_res = mock_tool_res()

    with patch.object(agent, "_call_tool", return_value=tool_res):
        result = asyncio.run(agent._acting(tool_call))
        # Should return the response_msg from metadata
        assert isinstance(result, Msg)
        assert result.content == "response"


