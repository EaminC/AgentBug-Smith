    agent.draft_report = ""
    agent.current_report = ""
    agent.memory = MagicMock()
    agent.print = AsyncMock()

    # Mock a tool call that will trigger the problematic code path
    tool_call = ToolUseBlock(
        id="call_123",
        name="generate_response",
        arguments={},
    )

    # Create a mock async generator that yields a chunk with metadata=None
    async def mock_tool_res():
        chunk = MockChunk(metadata=None, is_last=True)
        yield chunk

    # Mock the internal tool execution to return our generator
    with patch.object(agent, '_execute_tool', return_value=mock_tool_res()):
        # This should not raise AttributeError in the buggy version
        # In buggy version, chunk.metadata.get("success") will fail
        # In fixed version, chunk_metadata.get("success") will handle None
        result = await agent._acting(tool_call)

        # Verify the method completed without exception
        assert result is None  # Since metadata had no success=True


