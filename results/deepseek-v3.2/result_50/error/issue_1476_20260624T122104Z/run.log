from agentscope.agent import DeepResearchAgent
from agentscope.message import Msg
from agentscope.models import ModelResponse
from agentscope.tool import ToolUseBlock


def test_deep_research_agent_acting_with_none_metadata():
    """Test that DeepResearchAgent._acting handles chunk.metadata being None."""
    # Create a mock agent instance
    agent = DeepResearchAgent(
        name="test_agent",
        model_config={"config_name": "test_config", "model_type": "openai"},
        memory=None,
        sys_prompt="Test system prompt",
        max_subtasks=5,
        max_retries=3,
        verbose=True,
    )

    # Mock the necessary internal methods and attributes
    agent.print = AsyncMock()
    agent.current_subtask = []
    agent.finish_function_name = "finish"
    agent.summarize_function = "summarize"
    agent.draft_report = ""
    agent.memory = MagicMock()
    agent.memory.add = MagicMock()

    # Create a mock tool call
    tool_call = ToolUseBlock(
        id="test_id",
        name="test_tool",
        input={},
    )

    # Create a mock tool response that yields a chunk with metadata=None
    mock_chunk = MagicMock()
    mock_chunk.metadata = None  # This triggers the bug
    mock_chunk.is_last = True
    mock_chunk.content = "test output"

    # Mock the tool call execution to return an async generator
    async def mock_tool_call_gen():
        yield mock_chunk

    # Patch the agent's _execute_tool_call to return our generator
    with patch.object(agent, "_execute_tool_call", return_value=mock_tool_call_gen()):
        # Run _acting and ensure no AttributeError is raised
        # In buggy code, this will raise AttributeError: 'NoneType' object has no attribute 'get'
        # In fixed code, this should run without error
        try:
            result = asyncio.run(agent._acting(tool_call))
            # If we get here without exception, the fix works (or bug not triggered)
            # But we need to ensure the bug is triggered in buggy code.
            # The bug occurs when chunk.metadata is None and code tries chunk.metadata.get.
            # Our mock has metadata=None, so buggy code will raise AttributeError.
            # Therefore, if we reach this point after fix, test passes.
            # If buggy code, the exception will be raised and test fails.
            assert result is None or isinstance(result, Msg)
        except AttributeError as e:
            if "'NoneType' object has no attribute 'get'" in str(e):
                # This is the bug we expect in buggy code
                # In buggy code, test should fail (raise AssertionError)
                # In fixed code, this block should not be reached.
                raise AssertionError("Bug triggered: AttributeError on None metadata") from e
            else:
                raise


def test_deep_research_agent_acting_with_dict_metadata():
    """Test that DeepResearchAgent._acting works correctly when metadata is a dict."""
    agent = DeepResearchAgent(
        name="test_agent",
        model_config={"config_name": "test_config", "model_type": "openai"},
        memory=None,
        sys_prompt="Test system prompt",
        max_subtasks=5,
        max_retries=3,
        verbose=True,
    )

    agent.print = AsyncMock()
    agent.current_subtask = []
    agent.finish_function_name = "finish"
    agent.summarize_function = "summarize"
    agent.draft_report = ""
    agent.memory = MagicMock()
    agent.memory.add = MagicMock()

    tool_call = ToolUseBlock(
        id="test_id",
        name="finish",  # Use finish function to test success path
        input={},
    )

    mock_chunk = MagicMock()
    mock_chunk.metadata = {"success": True, "response_msg": Msg("assistant", "response")}
    mock_chunk.is_last = True
    mock_chunk.content = "test output"

    async def mock_tool_call_gen():
        yield mock_chunk

    with patch.object(agent, "_execute_tool_call", return_value=mock_tool_call_gen()):
        result = asyncio.run(agent._acting(tool_call))
        # Should return the response_msg from metadata
        assert result == Msg("assistant", "response")


