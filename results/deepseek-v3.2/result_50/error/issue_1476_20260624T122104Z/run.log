    agent._generate_response = AsyncMock()
    agent._summarize_subtask = AsyncMock()
    agent._update_memory = AsyncMock()

    # Create a tool call that will trigger the problematic code path
    tool_call = {
        "name": "finish",
        "input": {},
    }

    # Create a mock chunk with metadata = None
    chunk = MagicMock()
    chunk.metadata = None
    chunk.is_last = True

    # Mock the tool_res to be an async generator yielding the chunk
    async def mock_tool_res():
        yield chunk

    tool_res = mock_tool_res()

    # Mock the internal model client call that returns tool_res
    # We need to mock the actual method that returns tool_res.
    # In the real code, tool_res comes from model.do_chat_request.
    # We'll patch the model's do_chat_request to return our async generator.
    with patch.object(agent.model, "do_chat_request", return_value=tool_res):
        # Also need to mock the message construction inside _acting
        # The method uses self._create_msg which we can mock.
        agent._create_msg = MagicMock(return_value=Msg("user", "test"))

        # Run _acting
        result = await agent._acting(tool_call)

        # In the buggy version, accessing chunk.metadata.get would raise AttributeError.
        # The test will fail with AttributeError before reaching assertions.
        # After fix, it should complete without error.
        # We can assert that the method ran without raising AttributeError.
        # Since chunk.metadata is None, the condition using chunk_metadata.get("success")
        # will evaluate to False, so we expect result to be None.
        assert result is None


