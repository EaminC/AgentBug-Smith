        async def mock_tool_res():
            chunk = MagicMock()
            chunk.metadata = {"success": True, "response_msg": Msg("assistant", "done")}
            chunk.is_last = True
            yield chunk

        agent._execute_tool = AsyncMock(return_value=mock_tool_res())

        async def run():
            result = await agent._acting(tool_call)
            # Should return the response_msg from metadata
            assert isinstance(result, Msg)
            assert result.content == "done"

        asyncio.run(run())


