        verbose=True,
    )

    # Mock tool call
    tool_call = MockToolUseBlock(name="search")

    # Mock tool_res as async generator yielding a chunk with metadata=None
    async def mock_tool_res():
        chunk = MagicMock(spec=ModelResponseChunk)
        chunk.metadata = None  # This triggers the bug in buggy code
        chunk.is_last = True
        yield chunk

    # Mock the internal tool execution to return our async generator
    mock_tool_execute = AsyncMock(return_value=mock_tool_res())
    agent._execute_tool = mock_tool_execute

    # Mock the print method to avoid side effects
    agent.print = AsyncMock()

    # Run _acting and ensure no AttributeError occurs
    # In buggy code, this would raise AttributeError: 'NoneType' object has no attribute 'get'
    # In fixed code, it should handle None metadata gracefully and not crash.
    async def run_test():
        try:
            result = await agent._acting(tool_call)
            # If we reach here without exception, the fix works (or buggy code might still pass if condition not met)
            # We'll assert that the method completed without raising AttributeError.
            # Since chunk.metadata is None, the condition `tool_call["name"] != self.finish_function_name`
            # is True (tool_call name is "search", finish_function_name is "finish"),
            # so it should call self.print.
            agent.print.assert_awaited_once()
        except AttributeError as e:
            if "'NoneType' object has no attribute 'get'" in str(e):
                pytest.fail(f"Bug reproduced: AttributeError due to None metadata: {e}")
            else:
                raise

    # Execute the async test
    asyncio.run(run_test())


def test_deep_research_agent_acting_with_dict_metadata():
    """Test that DeepResearchAgent._acting works correctly when metadata is a dict."""
    agent = DeepResearchAgent(
        name="test_agent",
        model_config={"config_name": "test", "model_type": "openai"},
        memory=None,
        tools=[],
        finish_function_name="finish",
        summarize_function="summarize",
        generate_response_function="generate_response",
        search_function="search",
        max_subtasks=5,
        max_search_results_per_query=3,
        enable_plan=True,
        enable_search=True,
        enable_summarize=True,
        enable_generate_response=True,
        enable_finish=True,
        verbose=True,
    )

    tool_call = MockToolUseBlock(name="finish")

    async def mock_tool_res():
        chunk = MagicMock(spec=ModelResponseChunk)
        chunk.metadata = {"success": True, "response_msg": Msg("assistant", "response")}
        chunk.is_last = True
        yield chunk

    mock_tool_execute = AsyncMock(return_value=mock_tool_res())
    agent._execute_tool = mock_tool_execute
    agent.print = AsyncMock()
    agent.current_subtask = []  # Empty list to trigger return

    async def run_test():
        result = await agent._acting(tool_call)
        # Should return the response_msg from metadata
        assert isinstance(result, Msg)
        assert result.content == "response"
        agent.print.assert_not_awaited()  # Because success=True and finish function

    asyncio.run(run_test())


