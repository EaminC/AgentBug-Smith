def test_deep_research_agent_acting_with_none_metadata():
    """Test that _acting handles chunk.metadata being None without AttributeError."""
    # Create a minimal DeepResearchAgent instance with required attributes
    agent = DeepResearchAgent(
        name="test_agent",
        model=MagicMock(),
        memory=None,
        finish_function_name="finish",
        summarize_function="summarize",
        generate_response_function="generate_response",
        search_function="search",
        max_subtasks=5,
        max_search_results=3,
        max_search_queries=2,
        max_tokens=1000,
        temperature=0.7,
    )
    agent.current_subtask = []
    agent.draft_report = ""
    agent.print = AsyncMock()

    # Mock a tool call that will trigger the problematic code path
    tool_call = ToolUseBlock(
        id="test_call",
        name="generate_response",
        input={"query": "test"},
    )

    # Create a chunk with metadata=None to reproduce the bug
    chunk = MagicMock()
    chunk.metadata = None
    chunk.is_last = False

    # Mock the tool result as an async generator yielding the chunk
    async def mock_tool_res():
        yield chunk

    tool_res = mock_tool_res()

    # Patch the internal method that returns the tool result
    with patch.object(agent, "_call_tool", return_value=tool_res):
        # Run _acting - in buggy code this raises AttributeError
        # In fixed code it should handle None metadata gracefully
        try:
            result = asyncio.run(agent._acting(tool_call))
            # If we get here without exception, the bug is fixed
            # Assert something about the result to make test meaningful
            assert result is None or isinstance(result, Msg)
        except AttributeError as e:
            if "'NoneType' object has no attribute 'get'" in str(e):
                # This is the bug we expect in buggy code
                raise AssertionError(
                    "AttributeError occurred: chunk.metadata.get called on None"
                ) from e
            else:
                raise


def test_deep_research_agent_acting_with_dict_metadata():
    """Test that _acting works correctly when chunk.metadata is a dict."""
    agent = DeepResearchAgent(
        name="test_agent",
        model=MagicMock(),
        memory=None,
        finish_function_name="finish",
        summarize_function="summarize",
        generate_response_function="generate_response",
        search_function="search",
        max_subtasks=5,
        max_search_results=3,
        max_search_queries=2,
        max_tokens=1000,
        temperature=0.7,
