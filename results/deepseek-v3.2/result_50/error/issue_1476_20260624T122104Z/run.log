[32mimport asyncio
import pytest
from unittest.mock import AsyncMock, MagicMock, patch
from agentscope.message import Msg
from agentscope.models import ModelResponse
from agentscope.tool import ToolUseBlock

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


class MockChunk:
    def __init__(self, metadata=None, is_last=False, output=None):
        self.metadata = metadata
        self.is_last = is_last
        self.output = output


@pytest.mark.asyncio
async def test_deep_research_agent_acting_with_none_metadata():
    """Test that _acting handles chunk.metadata being None without AttributeError."""
    # Mock the agent's internal dependencies
    with patch.object(DeepResearchAgent, "__init__", lambda self, **kwargs: None):
        agent = DeepResearchAgent(name="test_agent", model=None)
        agent.model = None
        agent.finish_function_name = "finish"
        agent.summarize_function = "summarize"
        agent.current_subtask = []
        agent.print = AsyncMock()
        agent._update_memory = AsyncMock()
        agent._generate_response = AsyncMock()
        agent._summarize = AsyncMock()

        # Create a mock tool call
        tool_call = ToolUseBlock(
            id="test_id",
            name="test_tool",
            input={"query": "test"},
        )

        # Simulate an async generator that yields a chunk with metadata=None
        mock_chunk = MockChunk(metadata=None, is_last=True)
        mock_tool_res = AsyncMock()
        mock_tool_res.__aiter__.return_value = [mock_chunk].__iter__()

        # Mock the internal tool call execution to return our generator
        with patch.object(agent, "_call_tool", return_value=mock_tool_res):
            # This should not raise AttributeError: 'NoneType' object has no attribute 'get'
            result = await agent._acting(tool_call)

            # In buggy code, the above would crash. After fix, it should run without error.
            # We don't need to assert a specific result, just that no exception is raised.
            # However, to make the test fail on buggy code, we can assert that the
            # execution reaches the end (result is None because metadata didn't have success).
            assert result is None


@pytest.mark.asyncio
async def test_deep_research_agent_acting_with_dict_metadata():
    """Test that _acting works correctly when chunk.metadata is a dict."""
    with patch.object(DeepResearchAgent, "__init__", lambda self, **kwargs: None):
        agent = DeepResearchAgent(name="test_agent", model=None)
        agent.model = None
        agent.finish_function_name = "finish"
        agent.summarize_function = "summarize"
        agent.current_subtask = []
        agent.print = AsyncMock()
        agent._update_memory = AsyncMock()
        agent._generate_response = AsyncMock()
        agent._summarize = AsyncMock()

        tool_call = ToolUseBlock(
            id="test_id",
            name="finish",
            input={"query": "test"},
        )

        # Chunk with metadata dict containing success=True
        mock_chunk = MockChunk(metadata={"success": True, "response_msg": Msg("user", "done")}, is_last=True)
        mock_tool_res = AsyncMock()
        mock_tool_res.__aiter__.return_value = [mock_chunk].__iter__()

        with patch.object(agent, "_call_tool", return_value=mock_tool_res):
            result = await agent._acting(tool_call)
            # Should return the response_msg from metadata
            assert isinstance(result, Msg)
            assert result.content == "done"


