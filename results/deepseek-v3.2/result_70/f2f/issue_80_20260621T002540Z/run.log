ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---
WORKDIR /app

# Copy entire repository
COPY . .

# Install dependencies (including dev dependencies) from package.json
# The repository shows a package.json with devDependencies only, but we also need to install any production dependencies.
# However, there is no package-lock.json or yarn.lock visible, so we assume npm install.
# The CI workflow uses pnpm, but the root package.json does not have scripts or dependencies; the UI directory likely has its own package.json.
# We need to locate the main project directory. The repository includes a 'ui' directory with its own package.json.
# According to the CI workflow, the UI tests run from the 'ui' directory.
# Therefore, we should install dependencies in the 'ui' directory.
# We'll check if the ui/package.json exists and install there.
RUN if [ -f "ui/package.json" ]; then \
        cd ui && \
        npm install --include=dev; \
    else \
        npm install --include=dev; \
    fi

# Install the project itself (for JavaScript, this is done via npm install above)
# No additional step needed because npm install already installs local dependencies.

# Install testing framework (pytest is for Python, not JavaScript). JavaScript tests likely use Jest or similar.
# The CI workflow shows 'pnpm test' in the ui directory, but we don't see a test script in the root package.json.
# We assume the testing framework is already included as devDependencies in the ui/package.json.
# We'll run a preflight check to ensure Node environment works.
RUN node -e "console.log('preflight ok')"

# Set the command to bash for test harness
