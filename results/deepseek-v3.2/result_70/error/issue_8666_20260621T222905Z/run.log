RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Install uv if uv.lock exists, else fallback to pip
RUN if [ -f uv.lock ]; then \
