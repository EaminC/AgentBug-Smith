[32mFROM node:20-slim AS test_builder

WORKDIR /app

# Install system dependencies for building native modules
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    make \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository (as required)
COPY . .

# Install frontend dependencies and build
RUN if [ -f "src/frontend/package.json" ]; then \
        cd src/frontend && npm ci; \
    else \
        echo "Frontend package.json not found, skipping frontend build."; \
    fi

# Build frontend (if Makefile target exists)
RUN if [ -f "Makefile" ] && grep -q "build_frontend" Makefile; then \
        make build_frontend; \
    elif [ -f "src/frontend/package.json" ] && grep -q '"build"' src/frontend/package.json; then \
        cd src/frontend && npm run build; \
    else \
        echo "No frontend build script found."; \
    fi

# Install backend dependencies using uv (as per pyproject.toml and Makefile)
RUN if [ -f "uv.lock" ]; then \
        pip3 install uv && \
        uv sync --frozen; \
    elif [ -f "requirements.txt" ]; then \
        pip3 install -r requirements.txt; \
    else \
        echo "No dependency lock file found."; \
    fi

# Install the project in development mode (editable) and test dependencies
# Since the project uses a src/ layout (src/backend/base/langflow), we should avoid editable install
# to prevent duplicate module loading. Instead, set PYTHONPATH.
ENV PYTHONPATH=/app/src/backend/base:$PYTHONPATH

# Install test dependencies explicitly (pytest, etc.)
RUN pip3 install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Verify imports work
RUN python3 -c "import pytest; import langflow; print('Preflight import check passed')"

