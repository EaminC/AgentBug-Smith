import sys
import tempfile
import shutil
from pathlib import Path

# Add the agent directory to the path so we can import modules
sys.path.insert(0, str(Path(__file__).parent.parent))

from agent.utils.config import Config
from agent.function.search_agent import SearchAgent


def test_search_agent_without_search_engine_config():
    """
    Test that SearchAgent.__init__ does not raise KeyError when
    config['general'] does not contain 'search_engine'.
    In buggy code, it raises KeyError.
    In fixed code, it uses .get() and logs a message.
    """
    # Create a temporary directory for config file
    tmpdir = tempfile.mkdtemp()
    config_path = Path(tmpdir) / "config.yaml"
    try:
        # Write a config that lacks 'search_engine' under 'general'
        config_content = """
general:
  some_other_key: value
another_section:
  foo: bar
"""
        config_path.write_text(config_content)
        
        # Temporarily set the config path environment variable
        original_env = os.environ.get("MLE_CONFIG_PATH")
        os.environ["MLE_CONFIG_PATH"] = str(config_path)
        
        # Reload config module to pick up new path
        import importlib
        import agent.utils.config
        importlib.reload(agent.utils.config)
        from agent.utils.config import config
        importlib.reload(sys.modules['agent.function.search_agent'])
        
        # In buggy code, SearchAgent.__init__ with enable_web_search=False
        # will try to read config and access config_dict['general']['search_engine']
        # which raises KeyError.
        # In fixed code, it uses .get() and returns early.
        # We test that no KeyError is raised.
        agent = SearchAgent(enable_web_search=False)
        
        # If we reach here without KeyError, the test passes for fixed code.
        # For buggy code, the KeyError will be raised and caught by pytest.
        # Additionally, we can assert that engine_name is None or not set.
        # The fixed code sets self.engine_name = config_dict['general'].get('search_engine')
        # and if not self.engine_name, it logs and returns.
        # So after initialization, engine_name should be None.
        assert agent.engine_name is None
        
    finally:
        # Restore environment
        if original_env is not None:
            os.environ["MLE_CONFIG_PATH"] = original_env
        else:
            os.environ.pop("MLE_CONFIG_PATH", None)
        # Clean up temporary directory
        shutil.rmtree(tmpdir, ignore_errors=True)


def test_search_agent_with_search_engine_config():
    """
    Test that SearchAgent.__init__ works when config has search_engine.
    """
    tmpdir = tempfile.mkdtemp()
    config_path = Path(tmpdir) / "config.yaml"
    try:
        config_content = """
general:
  search_engine: google
google:
  api_key: dummy_key
  cse_id: dummy_id
"""
        config_path.write_text(config_content)
        
        original_env = os.environ.get("MLE_CONFIG_PATH")
        os.environ["MLE_CONFIG_PATH"] = str(config_path)
        
        import importlib
        import agent.utils.config
        importlib.reload(agent.utils.config)
        from agent.utils.config import config
        importlib.reload(sys.modules['agent.function.search_agent'])
        
        # Should not raise any exception
        agent = SearchAgent(enable_web_search=False)
        # engine_name should be 'google'
        assert agent.engine_name == 'google'
        
    finally:
        if original_env is not None:
            os.environ["MLE_CONFIG_PATH"] = original_env
        else:
            os.environ.pop("MLE_CONFIG_PATH", None)
        shutil.rmtree(tmpdir, ignore_errors=True)[0m
