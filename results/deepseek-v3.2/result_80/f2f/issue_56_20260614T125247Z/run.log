class TestSearchAgentConfigBug:
    """Test for bug where config missing 'search_engine' raises KeyError."""

    def setup_method(self):
        # Create a temporary directory for config file
        self.temp_dir = tempfile.mkdtemp()
        self.original_home = os.environ.get('HOME')
        os.environ['HOME'] = self.temp_dir

    def teardown_method(self):
        # Restore original HOME and clean up temp directory
        if self.original_home:
            os.environ['HOME'] = self.original_home
        else:
            del os.environ['HOME']
        shutil.rmtree(self.temp_dir)

    def test_search_agent_without_search_engine_key_buggy(self):
        """In buggy code, this should raise KeyError when 'search_engine' missing."""
        # Create a config file without 'search_engine' in 'general' section
        config_content = """
general:
  some_other_key: value

another_section:
  key: value
"""
        config_path = os.path.join(self.temp_dir, '.mle', 'config.yml')
        os.makedirs(os.path.dirname(config_path), exist_ok=True)
        with open(config_path, 'w') as f:
            f.write(config_content)

        # Clear config cache to force reload
        if hasattr(Config, '_instance'):
            delattr(Config, '_instance')

        # Mock the console to avoid print issues
        with patch('agent.function.search_agent.Console') as mock_console:
            mock_console.return_value = MagicMock()

            # In buggy code, this should raise KeyError
            # because config_dict['general']['search_engine'] is accessed directly
            with pytest.raises(KeyError) as exc_info:
                SearchAgent(enable_web_search=False)
            
            # Verify the error is about 'search_engine'
            assert 'search_engine' in str(exc_info.value)

    def test_search_agent_without_search_engine_key_fixed(self):
        """In fixed code, this should not raise KeyError."""
        # Create a config file without 'search_engine' in 'general' section
        config_content = """
general:
  some_other_key: value

another_section:
  key: value
"""
        config_path = os.path.join(self.temp_dir, '.mle', 'config.yml')
        os.makedirs(os.path.dirname(config_path), exist_ok=True)
        with open(config_path, 'w') as f:
            f.write(config_content)

        # Clear config cache to force reload
        if hasattr(Config, '_instance'):
            delattr(Config, '_instance')

        # Mock the console to avoid print issues
        with patch('agent.function.search_agent.Console') as mock_console:
            mock_console_instance = MagicMock()
            mock_console.return_value = mock_console_instance

            # In fixed code, this should not raise KeyError
            # because .get('search_engine') is used
            agent = SearchAgent(enable_web_search=False)
            
            # Verify engine_name is None (not set in config)
            assert agent.engine_name is None
            
            # Verify console.log was called with appropriate message
