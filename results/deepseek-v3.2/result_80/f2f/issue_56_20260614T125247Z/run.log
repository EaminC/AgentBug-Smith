from agent.utils.config import Config


def test_search_agent_keyerror_buggy():
    """
    Test that reproduces the KeyError: 'search_engine' not in config.
    In the buggy version, config_dict['general']['search_engine'] raises KeyError.
    In the fixed version, config_dict['general'].get('search_engine') returns None.
    """
    # Create a temporary config file without 'search_engine' key
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        config_data = {
            "general": {
                "some_other_key": "value"
            }
        }
        json.dump(config_data, f)
        config_path = f.name

    try:
        # Mock the config.read() method to return our test config
        with patch('agent.utils.config.Config.read') as mock_read:
            mock_read.return_value = config_data

            # Import SearchAgent after mocking to ensure it uses the mocked config
            from agent.function.search_agent import SearchAgent

            # In buggy version, this will raise KeyError because config_dict['general']['search_engine'] doesn't exist
            # In fixed version, this will not raise KeyError and will set self.engine_name = None
            agent = SearchAgent(enable_web_search=False)

            # If we reach here in buggy version, the test should still fail because we need to verify
            # that the buggy code would have raised KeyError.
            # We can check that the agent's engine_name is None (fixed) or that no exception was raised.
            # But we need the test to fail on buggy version, so we assert something that will fail on buggy.
            # Actually, the buggy version will raise KeyError during __init__, so the test will fail.
            # The fixed version will not raise KeyError, so the test will pass.
            # However, we need to ensure the test doesn't pass on buggy version for other reasons.
            # Let's check that engine_name is None (fixed) or that the agent was created without error.
            assert agent.engine_name is None or agent.engine_name == config_data['general'].get('search_engine')
    finally:
        os.unlink(config_path)


def test_search_agent_with_search_engine():
    """
    Test that SearchAgent works when search_engine is present in config.
    """
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        config_data = {
            "general": {
                "search_engine": "google"
            },
            "google": {
                "api_key": "test_key"
            }
        }
        json.dump(config_data, f)
        config_path = f.name

    try:
        with patch('agent.utils.config.Config.read') as mock_read:
            mock_read.return_value = config_data

            from agent.function.search_agent import SearchAgent

            agent = SearchAgent(enable_web_search=False)
            # In both buggy and fixed, engine_name should be 'google'
            # But buggy version will raise KeyError if 'search_engine' is missing, not if present.
            # So this test should pass in both buggy and fixed if config has search_engine.
            assert agent.engine_name == 'google'
    finally:
        os.unlink(config_path)


def test_search_agent_enable_web_search_true():
    """
    Test SearchAgent when enable_web_search is True.
    In this case, the agent should not try to read config.
    """
    # Mock the console.log to avoid side effects
    with patch('agent.function.search_agent.Console') as mock_console:
        mock_console.return_value.log = MagicMock()

        from agent.function.search_agent import SearchAgent

        agent = SearchAgent(enable_web_search=True)
        # When enable_web_search is True, the agent should not have engine_name set
        # because it returns early.
        # In the buggy version, if enable_web_search is True, it returns early before
        # accessing config, so no KeyError.
        # So this test should pass in both buggy and fixed.
        assert not hasattr(agent, 'engine_name') or agent.engine_name is None


