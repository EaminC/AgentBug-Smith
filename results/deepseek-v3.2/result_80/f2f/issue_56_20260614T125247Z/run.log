""")
        
        # Temporarily set the config path
        original_home = os.environ.get("MLE_CONFIG_HOME")
        os.environ["MLE_CONFIG_HOME"] = config_dir
        
        try:
            # Mock console to avoid output during test
            mock_console = MagicMock()
