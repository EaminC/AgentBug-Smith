sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from agent.function.search_agent import SearchAgent
from agent.utils.config import Config


def test_search_agent_init_without_search_engine_key():
    """Test that SearchAgent.__init__ does not raise KeyError when 'search_engine' missing."""
    # Simulate a config that lacks 'search_engine' under 'general'
    config_data = {
        "general": {
            # No 'search_engine' key
            "some_other_key": "value"
        }
    }
    with patch.object(Config, 'read', return_value=config_data):
        # This should not raise KeyError after the fix
        # Before fix: KeyError: 'search_engine'
        # After fix: should log and return early
        agent = SearchAgent(enable_web_search=False)
        # If the fix is applied, engine_name will be None and __init__ returns early
        # We can assert that engine_name is None (or that no exception occurred)
        assert agent.engine_name is None


def test_search_agent_init_with_search_engine_key():
    """Test that SearchAgent.__init__ works when 'search_engine' is present."""
    config_data = {
        "general": {
            "search_engine": "google"
        },
        "google": {
            "api_key": "fake_key",
            "cse_id": "fake_id"
        }
    }
    with patch.object(Config, 'read', return_value=config_data):
        agent = SearchAgent(enable_web_search=False)
        # After fix, engine_name should be 'google'
        assert agent.engine_name == "google"
        # The search_engine attribute should be set
        assert hasattr(agent, 'search_engine')
        # The search_engine dict should have the 'name' key added
        assert agent.search_engine['name'] == 'google'


def test_search_agent_init_enable_web_search_true():
    """Test that SearchAgent.__init__ sets up web search when enable_web_search=True."""
    # When enable_web_search is True, the config is not read; instead, a web search client is created.
    # We need to mock the web search client creation to avoid actual API calls.
    with patch('agent.function.search_agent.WebSearchClient') as mock_client_class:
        mock_client = MagicMock()
        mock_client_class.return_value = mock_client
        agent = SearchAgent(enable_web_search=True)
        assert agent.enable_web_search is True
        assert agent.search_engine is None
        assert agent.engine_name is None
        mock_client_class.assert_called_once()


def test_search_agent_init_with_empty_search_engine_value():
    """Test that SearchAgent.__init__ handles empty string for search_engine."""
    config_data = {
        "general": {
            "search_engine": ""
        }
    }
    with patch.object(Config, 'read', return_value=config_data):
        # After fix, engine_name will be empty string, then if not engine_name -> log and return
        agent = SearchAgent(enable_web_search=False)
        assert agent.engine_name == ""
        # Since engine_name is empty, the __init__ should return early and not set search_engine
        assert not hasattr(agent, 'search_engine')


def test_search_agent_init_with_none_search_engine_value():
    """Test that SearchAgent.__init__ handles None for search_engine."""
    config_data = {
        "general": {
            "search_engine": None
        }
    }
    with patch.object(Config, 'read', return_value=config_data):
        agent = SearchAgent(enable_web_search=False)
        assert agent.engine_name is None
        assert not hasattr(agent, 'search_engine')[0m
