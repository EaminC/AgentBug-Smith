                                # This should not raise KeyError when creating ReflectAgent
                                # which internally creates SearchAgent
                                leader = LeaderAgent(mock_agent, mock_project)
                                
                                # Try to invoke the reflection step
                                # This would trigger SearchAgent initialization in buggy code
                                try:
                                    # Mock the reflect agent creation
                                    mock_reflect_agent = MagicMock()
                                    with patch('agent.function.tech_leader.ReflectAgent', 
                                             return_value=mock_reflect_agent):
                                        leader.requirement = "Test requirement"
                                        # This line would fail in buggy code
                                        leader._run_reflection_step()
                                except KeyError as e:
                                    if "'search_engine'" in str(e):
                                        # This is the buggy behavior
                                        pytest.fail(f"KeyError occurred for 'search_engine': {e}")
                                    else:
                                        raise
        finally:
            # Clean up
            if original_home:
                os.environ["MLE_CONFIG_HOME"] = original_home
            else:
                os.environ.pop("MLE_CONFIG_HOME", None)
            shutil.rmtree(config_dir)


def test_search_agent_get_method_used():
    """Verify that the fixed code uses .get() method for accessing search_engine."""
    # Read the actual source file to check the fix
    search_agent_path = os.path.join(os.path.dirname(__file__), 
                                    "..", "agent", "function", "search_agent.py")
    search_agent_path = os.path.abspath(search_agent_path)
    
    with open(search_agent_path, "r") as f:
        content = f.read()
    
    # Check that the fixed code uses .get() method
    # The buggy code has: self.engine_name = config_dict['general']['search_engine']
    # The fixed code has: self.engine_name = config_dict['general'].get('search_engine')
    
    # Find the relevant line
    lines = content.split('\n')
    found_get_method = False
    found_bracket_access = False
    
    for line in lines:
        if "config_dict['general']" in line and "search_engine" in line:
            if ".get('search_engine')" in line:
                found_get_method = True
            elif "['search_engine']" in line:
                found_bracket_access = True
    
    # After the fix, we should find .get() method
    # If we find bracket access, that's the buggy code (unless it's in a comment)
    if found_bracket_access and not found_get_method:
        # Check if it's in a comment
        bracket_lines = [i for i, line in enumerate(lines) 
                        if "config_dict['general']" in line and "['search_engine']" in line]
        for line_num in bracket_lines:
            line = lines[line_num].strip()
            if not line.startswith('#') and not line.startswith('"""'):
                pytest.fail(f"Found direct bracket access to 'search_engine' at line {line_num+1}: {line}")
    
    # Also check for the early return logic
    if "if not self.engine_name:" not in content:
        pytest.fail("Missing early return check for missing search_engine")
    
    if "No search engine is set." not in content:
        pytest.fail("Missing log message for missing search_engine")


if __name__ == "__main__":
    # Run tests directly if needed
    pytest.main([__file__, "-v"])[0m
