            "general": {
                # Intentionally omit 'search_engine'
                "some_other_key": "value"
            },
            "some_engine": {
                "api_key": "dummy"
            }
        }
        json.dump(config_data, f)
        config_path = f.name

    # Mock Config.read to return our test config
