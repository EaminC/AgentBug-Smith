from agent.utils.config import Config
from agent.function.search_agent import SearchAgent


def test_search_agent_missing_search_engine_key():
    """
    Test that SearchAgent.__init__ does not raise KeyError when 'search_engine'
    key is missing from config['general'].
    In buggy version, it raises KeyError.
    In fixed version, it uses .get() and logs a message.
    """
    # Create a temporary config directory
    tmpdir = tempfile.mkdtemp()
    config_path = os.path.join(tmpdir, 'config.yaml')
    try:
        # Write a config that lacks 'search_engine' under 'general'
        with open(config_path, 'w') as f:
            f.write("""
general:
  some_other_key: value
another_section:
  key: value
""")
        # Mock Config.read to return our config dict
        with patch.object(Config, 'read') as mock_read:
            mock_read.return_value = {
                'general': {'some_other_key': 'value'},
                'another_section': {'key': 'value'}
            }
            # Also mock the console.log to capture if it's called
            with patch('agent.function.search_agent.Console') as MockConsole:
                mock_console = MagicMock()
                MockConsole.return_value = mock_console
                # Instantiate SearchAgent with enable_web_search=False
                # This should trigger the else branch where config is read.
                agent = SearchAgent(enable_web_search=False)
                # In buggy version, KeyError is raised before we get here.
                # In fixed version, agent is created and engine_name is None.
                assert agent.engine_name is None
                # Verify console.log was called with the expected message
                mock_console.log.assert_called_with("No search engine is set.")
    finally:
        shutil.rmtree(tmpdir)


def test_search_agent_with_search_engine_key():
    """
    Test that SearchAgent.__init__ works when 'search_engine' key is present.
    """
    # Create a temporary config directory
    tmpdir = tempfile.mkdtemp()
    config_path = os.path.join(tmpdir, 'config.yaml')
    try:
        # Write a config that has 'search_engine' under 'general'
        with open(config_path, 'w') as f:
            f.write("""
general:
  search_engine: google
google:
  api_key: dummy_key
  cse_id: dummy_id
""")
        with patch.object(Config, 'read') as mock_read:
            mock_read.return_value = {
                'general': {'search_engine': 'google'},
                'google': {'api_key': 'dummy_key', 'cse_id': 'dummy_id'}
            }
            with patch('agent.function.search_agent.Console') as MockConsole:
                mock_console = MagicMock()
                MockConsole.return_value = mock_console
                agent = SearchAgent(enable_web_search=False)
                assert agent.engine_name == 'google'
                # console.log should not be called because search_engine exists.
                mock_console.log.assert_not_called()
    finally:
        shutil.rmtree(tmpdir)


if __name__ == '__main__':
