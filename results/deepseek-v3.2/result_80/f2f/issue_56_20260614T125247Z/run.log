from agent.utils.config import Config
from agent.function.search_agent import SearchAgent


def test_search_agent_init_without_search_engine_key():
    """Test that SearchAgent.__init__ does not raise KeyError when 'search_engine' is missing from config."""
    # Create a temporary config file without 'search_engine' in 'general'
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        config_data = {
            "general": {
                "some_other_key": "value"
            },
            "openai": {
                "api_key": "dummy"
            }
        }
        json.dump(config_data, f)
        config_path = f.name

    try:
        # Mock Config.read to return our config
        with patch.object(Config, 'read', return_value=config_data):
            # Also mock console.log to avoid side effects
            with patch('agent.function.search_agent.Console') as mock_console_class:
                mock_console = MagicMock()
                mock_console.log = MagicMock()
                mock_console_class.return_value = mock_console
                # This should not raise KeyError
                agent = SearchAgent(enable_web_search=False)
                # If search_engine is missing, agent should log and return early
                # Verify console.log was called with appropriate message
                mock_console.log.assert_called_with("No search engine is set.")
                # engine_name should be None
                assert agent.engine_name is None
    finally:
        os.unlink(config_path)


def test_search_agent_init_with_search_engine_key():
    """Test that SearchAgent.__init__ works when 'search_engine' is present."""
    config_data = {
        "general": {
