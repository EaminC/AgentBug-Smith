    Buggy version: config_dict['general']['search_engine'] -> KeyError.
    Fixed version: config_dict['general'].get('search_engine') -> None, then early return.
    """
    # Create a temporary config file without 'search_engine' in 'general'
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        config_data = {
            "general": {
                "some_other_key": "value"
            },
            "openai": {
                "api_key": "dummy"
            }
        }
        json.dump(config_data, f)
        config_path = f.name

    try:
        # Mock Config.read to return our config dict
        original_read = Config.read
        Config.read = MagicMock(return_value=config_data)

        # Also mock the console.log call to avoid side effects
        with patch.object(SearchAgent, 'console') as mock_console:
            # This should not raise KeyError in the fixed version.
            # In buggy version, it will raise KeyError: 'search_engine'.
            agent = SearchAgent(enable_web_search=False)

            # In fixed version, if search_engine is missing, __init__ returns early.
            # So agent.engine_name should be None (or not set).
            # Let's verify that no exception was raised and that the agent is created.
            assert agent is not None
            # The fixed code sets self.engine_name = None and returns early.
            # We can check that engine_name is None (or attribute may not exist).
            if hasattr(agent, 'engine_name'):
                assert agent.engine_name is None
            # Ensure console.log was called with the expected message
            mock_console.log.assert_called_with("No search engine is set.")

    finally:
        os.unlink(config_path)
        Config.read = original_read


def test_search_agent_init_with_search_engine_key():
    """
    Test that SearchAgent.__init__ works when 'search_engine' key is present.
    """
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        config_data = {
            "general": {
                "search_engine": "openai"
            },
            "openai": {
                "api_key": "dummy",
                "model": "gpt-3.5-turbo"
            }
        }
        json.dump(config_data, f)
        config_path = f.name

    try:
        original_read = Config.read
        Config.read = MagicMock(return_value=config_data)

        with patch.object(SearchAgent, 'console') as mock_console:
            agent = SearchAgent(enable_web_search=False)
            assert agent is not None
            # In fixed version, engine_name should be 'openai'
            assert agent.engine_name == 'openai'
            # console.log should not be called because search_engine is set
            mock_console.log.assert_not_called()

    finally:
        os.unlink(config_path)
        Config.read = original_read


def test_search_agent_init_with_empty_search_engine():
    """
    Test when search_engine key exists but value is empty string.
    """
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        config_data = {
            "general": {
                "search_engine": ""
            },
            "openai": {
                "api_key": "dummy"
            }
        }
        json.dump(config_data, f)
        config_path = f.name

    try:
        original_read = Config.read
        Config.read = MagicMock(return_value=config_data)

        with patch.object(SearchAgent, 'console') as mock_console:
            agent = SearchAgent(enable_web_search=False)
            assert agent is not None
            # engine_name should be empty string, but fixed code treats empty as falsy and returns early.
            # So engine_name may be empty string, but the early return will happen because not self.engine_name.
            if hasattr(agent, 'engine_name'):
                assert agent.engine_name == ""
            mock_console.log.assert_called_with("No search engine is set.")

    finally:
        os.unlink(config_path)
        Config.read = original_read


if __name__ == "__main__":
    # Allow running with python directly (though pytest is preferred)
    pytest.main([__file__, "-v"])[0m
