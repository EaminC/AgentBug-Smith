class TestSearchAgentConfigHandling:
    def test_search_agent_without_search_engine_key(self):
        """Test that SearchAgent handles missing 'search_engine' key gracefully."""
        # Create a temporary config file without 'search_engine'
        config_dir = tempfile.mkdtemp()
        config_file = os.path.join(config_dir, "config.yaml")
        with open(config_file, "w") as f:
            f.write("""
general:
  some_other_key: value
another_section:
  key: value
""")
        
        # Temporarily set the config path
        original_home = os.environ.get("MLE_CONFIG_HOME")
        os.environ["MLE_CONFIG_HOME"] = config_dir
        
        try:
            # Mock the console.log to capture output
            with patch.object(SearchAgent, '__init__', lambda self, enable_web_search=False: None):
                # Actually create the SearchAgent instance
                # The buggy code would raise KeyError here
                # The fixed code should handle it gracefully
                agent = SearchAgent(enable_web_search=False)
                
                # If we get here without KeyError, the test passes
                # But we need to verify the behavior matches the fix
                # The fix uses .get() and returns early if not set
                assert agent.engine_name is None or agent.engine_name == ""
        except KeyError as e:
            if "'search_engine'" in str(e):
                # This is the buggy behavior - should only happen before fix
                pytest.fail(f"KeyError occurred for 'search_engine': {e}")
            else:
                raise
        finally:
            # Clean up
            if original_home:
                os.environ["MLE_CONFIG_HOME"] = original_home
            else:
                os.environ.pop("MLE_CONFIG_HOME", None)
            shutil.rmtree(config_dir)
    
    def test_search_agent_with_search_engine_key(self):
        """Test that SearchAgent works correctly when 'search_engine' key exists."""
        # Create a temporary config file with 'search_engine'
        config_dir = tempfile.mkdtemp()
        config_file = os.path.join(config_dir, "config.yaml")
        with open(config_file, "w") as f:
            f.write("""
general:
