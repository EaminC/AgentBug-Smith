[32mimport os
import sys
import tempfile
import shutil
from unittest.mock import patch, MagicMock

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from agent.utils.config import Config
from agent.function.search_agent import SearchAgent


def test_search_agent_missing_search_engine_key():
    """Test that SearchAgent handles missing 'search_engine' key gracefully."""
    # Create a temporary config file without 'search_engine' in 'general'
    tmpdir = tempfile.mkdtemp()
    config_path = os.path.join(tmpdir, "config.yaml")
    with open(config_path, "w") as f:
        f.write("""
general:
  some_other_key: value
another_section:
  key: value
""")
    
    # Temporarily replace the config path
    original_read = Config.read
    Config.read = lambda: {
        "general": {"some_other_key": "value"},
        "another_section": {"key": "value"}
    }
    
    try:
        # This should not raise KeyError after the fix
        agent = SearchAgent(enable_web_search=False)
        # If search_engine is missing, the __init__ should return early
        # and not set engine_name. We can check that engine_name is None
        # or that the agent is in a safe state.
        assert agent.engine_name is None
    finally:
        Config.read = original_read
        shutil.rmtree(tmpdir)


def test_search_engine_present():
    """Test that SearchAgent works when search_engine is present."""
    original_read = Config.read
    Config.read = lambda: {
        "general": {"search_engine": "test_engine"},
        "test_engine": {"api_key": "dummy_key"}
    }
    
    try:
        agent = SearchAgent(enable_web_search=False)
        # With the fix, engine_name should be 'test_engine'
        assert agent.engine_name == "test_engine"
    finally:
        Config.read = original_read


def test_search_engine_empty_string():
    """Test that SearchAgent handles empty string for search_engine."""
    original_read = Config.read
    Config.read = lambda: {
        "general": {"search_engine": ""},
        "": {"api_key": "dummy_key"}
    }
    
    try:
        agent = SearchAgent(enable_web_search=False)
        # Empty string should be treated as missing
        assert agent.engine_name == ""
        # The __init__ should return early due to not self.engine_name
        # We can't directly check that, but we can verify no exception
    finally:
        Config.read = original_read


def test_search_engine_none():
    """Test that SearchAgent handles None for search_engine."""
    original_read = Config.read
    Config.read = lambda: {
        "general": {"search_engine": None},
    }
    
    try:
        agent = SearchAgent(enable_web_search=False)
        # None should be treated as missing
        assert agent.engine_name is None
    finally:
        Config.read = original_read


def test_search_agent_with_web_search_enabled():
    """Test SearchAgent when enable_web_search is True."""
    # Mock the console.log to capture output
    with patch.object(SearchAgent, '__init__', return_value=None) as mock_init:
        agent = SearchAgent(enable_web_search=True)
        # When enable_web_search is True, the __init__ should not
        # try to read config at all (based on the code).
        # We'll just ensure no exception occurs.
        pass


if __name__ == "__main__":
