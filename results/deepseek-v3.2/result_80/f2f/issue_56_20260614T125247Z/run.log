[32mimport os
import sys
import tempfile
import json
from unittest.mock import patch, MagicMock
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))

from agent.utils.config import Config
from agent.function.search_agent import SearchAgent


def test_search_agent_without_search_engine_key():
    """
    Test that SearchAgent handles missing 'search_engine' key gracefully.
    In buggy version, config_dict['general']['search_engine'] raises KeyError.
    In fixed version, config_dict['general'].get('search_engine') returns None.
    """
    # Create a temporary config file without 'search_engine' in 'general'
    config_content = {
        "general": {
            "some_other_key": "value"
        },
        "some_engine": {
            "api_key": "dummy"
        }
    }
    
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        json.dump(config_content, f)
        config_path = f.name
    
    try:
        # Mock the config module's read method to return our test config
        with patch('agent.function.search_agent.config') as mock_config:
            mock_config.read.return_value = config_content
            
            # Also mock the console.log to capture messages
            with patch('agent.function.search_agent.Console') as mock_console_class:
                mock_console = MagicMock()
                mock_console_class.return_value = mock_console
                
                # In buggy version, this will raise KeyError: 'search_engine'
                # In fixed version, this will set engine_name to None and log message
                search_agent = SearchAgent(enable_web_search=False)
                
                # Verify engine_name is None (fixed behavior)
                assert search_agent.engine_name is None
                
                # Verify console.log was called with appropriate message
                mock_console.log.assert_called_with("No search engine is set.")
                
    finally:
        os.unlink(config_path)


def test_search_agent_with_search_engine_key():
    """
    Test that SearchAgent works correctly when 'search_engine' key exists.
    """
    config_content = {
        "general": {
            "search_engine": "some_engine"
        },
        "some_engine": {
            "api_key": "dummy_key",
            "other_setting": "value"
        }
    }
    
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        json.dump(config_content, f)
        config_path = f.name
    
    try:
        with patch('agent.function.search_agent.config') as mock_config:
            mock_config.read.return_value = config_content
            
            with patch('agent.function.search_agent.Console') as mock_console_class:
                mock_console = MagicMock()
                mock_console_class.return_value = mock_console
                
                # Mock the search engine initialization to avoid actual API calls
                with patch('agent.function.search_agent.SearchEngine') as mock_search_engine_class:
                    mock_search_engine = MagicMock()
                    mock_search_engine_class.return_value = mock_search_engine
                    
                    search_agent = SearchAgent(enable_web_search=False)
                    
                    # Verify engine_name is set correctly
                    assert search_agent.engine_name == "some_engine"
                    
                    # Verify search engine was initialized
                    mock_search_engine_class.assert_called_once()
                    
    finally:
        os.unlink(config_path)


def test_search_agent_enable_web_search_true():
    """
    Test that SearchAgent works when enable_web_search is True.
    """
    with patch('agent.function.search_agent.Console') as mock_console_class:
        mock_console = MagicMock()
        mock_console_class.return_value = mock_console
        
        with patch('agent.function.search_agent.SearchEngine') as mock_search_engine_class:
            mock_search_engine = MagicMock()
            mock_search_engine_class.return_value = mock_search_engine
            
            search_agent = SearchAgent(enable_web_search=True)
            
            # When enable_web_search is True, engine_name should be 'web_search'
            assert search_agent.engine_name == 'web_search'
            
            # Verify search engine was initialized
            mock_search_engine_class.assert_called_once()


