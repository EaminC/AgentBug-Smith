import os
import tempfile
import json
from unittest.mock import patch, MagicMock

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from agent.utils.config import Config
from agent.function.search_agent import SearchAgent


def test_search_agent_without_search_engine_key():
    """
    Test that SearchAgent.__init__ does not raise KeyError when 'search_engine'
    key is missing from config['general'].
    In buggy code, config_dict['general']['search_engine'] raises KeyError.
    In fixed code, config_dict['general'].get('search_engine') returns None,
    and the agent logs a message and returns early.
    """
    # Create a temporary config file without 'search_engine' in 'general'
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        config_data = {
            "general": {
                "some_other_key": "value"
            },
            "openai": {
                "api_key": "dummy_key"
            }
        }
        json.dump(config_data, f)
        config_path = f.name

    # Mock Config.read to return our config dict
    original_read = Config.read
    Config.read = MagicMock(return_value=config_data)

    # Mock console.log to capture its call
    with patch('agent.function.search_agent.Console') as MockConsole:
        mock_console_instance = MagicMock()
        MockConsole.return_value = mock_console_instance

        # In buggy code, this line raises KeyError:
        # self.engine_name = config_dict['general']['search_engine']
        # In fixed code, it should not raise KeyError.
        try:
            agent = SearchAgent(enable_web_search=False)
            # If we reach here, no KeyError was raised.
            # In fixed code, engine_name should be None and agent should return early.
            # We can verify that console.log was called with "No search engine is set."
            # But we must be careful: the agent may have other side effects.
            # The main assertion is that KeyError is not raised.
            # Additionally, we can check that engine_name is None.
            assert agent.engine_name is None
            # Verify that console.log was called with the expected message
            mock_console_instance.log.assert_called_with("No search engine is set.")
        except KeyError as e:
            # In buggy code, a KeyError is raised with key 'search_engine'
            if "'search_engine'" in str(e):
                raise AssertionError(f"KeyError raised for 'search_engine' in buggy code: {e}")
            else:
                raise
        finally:
            # Restore original method
            Config.read = original_read
            os.unlink(config_path)


def test_search_agent_with_search_engine_key():
    """
    Test that SearchAgent.__init__ works when 'search_engine' key is present.
    """
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        config_data = {
            "general": {
                "search_engine": "openai"
            },
            "openai": {
                "api_key": "dummy_key",
                "name": "openai"
            }
        }
        json.dump(config_data, f)
        config_path = f.name

    original_read = Config.read
    Config.read = MagicMock(return_value=config_data)

    with patch('agent.function.search_agent.Console') as MockConsole:
        mock_console_instance = MagicMock()
        MockConsole.return_value = mock_console_instance

        try:
            agent = SearchAgent(enable_web_search=False)
            # engine_name should be 'openai'
            assert agent.engine_name == 'openai'
            # console.log should not be called with "No search engine is set."
            mock_console_instance.log.assert_not_called()
        finally:
            Config.read = original_read
            os.unlink(config_path)


if __name__ == "__main__":
