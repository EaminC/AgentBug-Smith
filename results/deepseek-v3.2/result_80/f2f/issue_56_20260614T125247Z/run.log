import os
import tempfile
import json
from unittest.mock import patch, MagicMock

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from agent.utils.config import Config
from agent.function.search_agent import SearchAgent


def test_search_agent_init_without_search_engine_key():
    """
    Test that SearchAgent.__init__ does not raise KeyError when 'search_engine' is missing.
    In buggy code, config_dict['general']['search_engine'] raises KeyError.
    In fixed code, config_dict['general'].get('search_engine') returns None and logs.
    """
    # Create a temporary config file without 'search_engine' in 'general'
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        config_data = {
            "general": {
                "some_other_key": "value"
            }
        }
        json.dump(config_data, f)
        config_path = f.name

    try:
        # Mock Config.read to return our config data
        original_read = Config.read
        Config.read = MagicMock(return_value=config_data)

        # Also mock the console.log to capture if it's called
        with patch.object(SearchAgent, 'console') as mock_console:
            mock_console.log = MagicMock()
            # This should not raise KeyError in fixed code; in buggy code it will.
            agent = SearchAgent(enable_web_search=False)
            # In fixed code, engine_name should be None and console.log should be called
            assert agent.engine_name is None
            mock_console.log.assert_called_with("No search engine is set.")
    finally:
        os.unlink(config_path)
        Config.read = original_read


def test_search_agent_init_with_search_engine_key():
    """
    Test that SearchAgent.__init__ works when 'search_engine' is present.
    """
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        config_data = {
            "general": {
                "search_engine": "google"
            },
            "google": {
                "api_key": "dummy_key"
            }
        }
        json.dump(config_data, f)
        config_path = f.name

    try:
        original_read = Config.read
        Config.read = MagicMock(return_value=config_data)
        with patch.object(SearchAgent, 'console') as mock_console:
            mock_console.log = MagicMock()
            agent = SearchAgent(enable_web_search=False)
            assert agent.engine_name == "google"
            mock_console.log.assert_not_called()
    finally:
        os.unlink(config_path)
        Config.read = original_read[0m
