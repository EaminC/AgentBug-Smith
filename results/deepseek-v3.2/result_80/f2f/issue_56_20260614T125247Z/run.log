        with patch('agent.function.search_agent.Console') as MockConsole:
            mock_console_instance = MagicMock()
            MockConsole.return_value = mock_console_instance
            # The constructor may also read config again via config.read()
            # We'll mock that call as well
            with patch('agent.function.search_agent.config.read', side_effect=mock_read):
                # If buggy, this will raise KeyError
                # If fixed, it will create the instance and log "No search engine is set."
                agent = SearchAgent(enable_web_search=False)
                # In fixed code, engine_name should be None and we should have logged
                if agent.engine_name is not None:
                    raise AssertionError(f"Expected engine_name to be None, got {agent.engine_name}")
                # Verify the log was called (optional)
                mock_console_instance.log.assert_called_with("No search engine is set.")
    finally:
        Config.read = original_read
        os.unlink(config_path)


def test_search_agent_with_search_engine():
    """
    Test that SearchAgent works when 'search_engine' is present.
    """
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        config_data = {
            "general": {
                "search_engine": "some_engine"
            },
            "some_engine": {
                "api_key": "dummy_key",
                "other": "value"
            }
        }
        json.dump(config_data, f)
        config_path = f.name

    original_read = Config.read
    def mock_read():
        with open(config_path, 'r') as fp:
            return json.load(fp)
    
    try:
        Config.read = mock_read
        from agent.function.search_agent import SearchAgent

        with patch('agent.function.search_agent.Console') as MockConsole:
            mock_console_instance = MagicMock()
            MockConsole.return_value = mock_console_instance
            with patch('agent.function.search_agent.config.read', side_effect=mock_read):
                agent = SearchAgent(enable_web_search=False)
                # engine_name should be 'some_engine'
                assert agent.engine_name == 'some_engine'
                # No log about missing search engine
                mock_console_instance.log.assert_not_called()
    finally:
        Config.read = original_read
        os.unlink(config_path)


def test_search_agent_enable_web_search_true():
    """
    Test that SearchAgent with enable_web_search=True does not read config.
    """
    from agent.function.search_agent import SearchAgent

    with patch('agent.function.search_agent.Console') as MockConsole:
        mock_console_instance = MagicMock()
        MockConsole.return_value = mock_console_instance
        # Mock config.read to ensure it's not called
        with patch('agent.function.search_agent.config.read') as mock_config_read:
            agent = SearchAgent(enable_web_search=True)
            # engine_name should be 'web_search'
            assert agent.engine_name == 'web_search'
            # config.read should not be called
            mock_config_read.assert_not_called()
            # No log about missing search engine
            mock_console_instance.log.assert_not_called()


