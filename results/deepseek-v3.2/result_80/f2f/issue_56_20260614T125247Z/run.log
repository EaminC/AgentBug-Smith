        },
        "openai": {
            "api_key": "dummy",
            "name": "openai"
        }
    }
    with patch.object(Config, 'read', return_value=config_data):
        with patch('agent.function.search_agent.Console') as mock_console_class:
            mock_console = MagicMock()
            mock_console.log = MagicMock()
            mock_console_class.return_value = mock_console
            agent = SearchAgent(enable_web_search=False)
            assert agent.engine_name == "openai"
            # Should not log "No search engine is set."
            mock_console.log.assert_not_called()


