# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository (required for external test injection)
COPY . .

# Set required Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Check for src/ layout to avoid duplicate module loading
# If src/ exists or tests import via src., set PYTHONPATH and skip editable install
RUN if [ -d "src" ] || (find . -name "*.py" -type f -exec grep -l "^[[:space:]]*from src\.\|^[[:space:]]*import src\." {} \; 2>/dev/null | grep -q .); then \
    echo "Detected src/ layout or src imports; setting PYTHONPATH and skipping editable install" && \
    export PYTHONPATH=/app && \
    python -m pip install --upgrade pip setuptools wheel && \
    ( [ -f requirements.txt ] && pip install -r requirements.txt || true ) && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
    echo "No src/ layout detected; performing editable install" && \
    python -m pip install --upgrade pip setuptools wheel && \
