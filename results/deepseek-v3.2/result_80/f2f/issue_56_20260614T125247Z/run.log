from agent.utils.config import Config


def test_search_agent_missing_search_engine_key():
    """Test that SearchAgent handles missing 'search_engine' key gracefully."""
    # Simulate a config without 'search_engine' in the 'general' section
    config_content = """
general:
  some_other_key: value
another_section:
  key: value
"""
    with tempfile.NamedTemporaryFile(mode='w', suffix='.yml', delete=False) as f:
        f.write(config_content)
        config_path = f.name

    # Temporarily replace the config path
    original_read = Config.read
    Config.read = lambda: Config._load_yaml(config_path)

    try:
        from agent.function.search_agent import SearchAgent

        # Mock console.log to capture output
        mock_console = MagicMock()
        with patch('agent.function.search_agent.Console', return_value=mock_console):
            # Enable web search is False, so the agent should not crash
            agent = SearchAgent(enable_web_search=False)
            # Should not raise KeyError
            assert agent.engine_name is None

            # Now test with enable_web_search=True (the buggy path)
            # The config lacks 'search_engine', so after fix it should log and return
            agent2 = SearchAgent(enable_web_search=True)
            # After fix, engine_name should be None and console.log should be called
            assert agent2.engine_name is None
            # Verify the log message was printed
            mock_console.log.assert_called_with("No search engine is set.")
    finally:
        Config.read = original_read
        os.unlink(config_path)


def test_search_agent_with_search_engine_key():
    """Test that SearchAgent works when 'search_engine' is present."""
    config_content = """
general:
  search_engine: duckduckgo
duckduckgo:
  api_key: dummy_key
  other_setting: value
"""
    with tempfile.NamedTemporaryFile(mode='w', suffix='.yml', delete=False) as f:
        f.write(config_content)
        config_path = f.name

    original_read = Config.read
    Config.read = lambda: Config._load_yaml(config_path)

    try:
        from agent.function.search_agent import SearchAgent

        # Mock console.log to capture output
        mock_console = MagicMock()
        with patch('agent.function.search_agent.Console', return_value=mock_console):
            agent = SearchAgent(enable_web_search=True)
            # Should have engine_name set
            assert agent.engine_name == 'duckduckgo'
            # No log message should be printed
            mock_console.log.assert_not_called()
    finally:
        Config.read = original_read
        os.unlink(config_path)


