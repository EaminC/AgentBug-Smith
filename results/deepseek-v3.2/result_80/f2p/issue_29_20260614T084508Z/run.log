                training_entry_file=os.path.join(tmpdir, "output.py"),
                requirement="Test",
                dataset="data.csv",
                tasks=None,
                description="Test"
            )

            mock_agent = MagicMock()
            chain = Chain(plan, mock_agent)

            # Simulate streaming completion
            mock_completion = MagicMock()
            mock_completion.choices = [MagicMock()]
