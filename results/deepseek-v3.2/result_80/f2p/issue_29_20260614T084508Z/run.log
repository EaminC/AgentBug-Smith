def test_chain_debug_command_uses_training_entry_file():
    """
    Test that debug command uses training_entry_file to build command.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        config_content = f"""
project:
  path: {tmpdir}
"""
        config_path = os.path.join(tmpdir, CONFIG_PROJECT_FILE)
        with open(config_path, "w") as f:
            f.write(config_content)

        with patch.object(Config, 'read', return_value={'project': {'path': tmpdir}}):
            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=os.path.join(tmpdir, "train.py"),
                requirement="Test requirement",
                dataset="data.csv",
                tasks=None,
                description="Test"
            )

            mock_agent = MagicMock()
            chain = Chain(plan, mock_agent)

            # Mock a task with debug=True
            task = Task(name="debug", description="Debug", kind="train", debug=True)

            # Mock run_command to avoid actual execution
            with patch('agent.function.chain.run_command') as mock_run:
                mock_run.return_value = ("log", 0)
                # The debug logic uses chain.training_entry_file to build command
                chain.gen_task_content(task)
                # Check that run_command was called with command using training_entry_file
                mock_run.assert_called_once_with([f"python {chain.training_entry_file}"])


