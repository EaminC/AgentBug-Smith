        with patch.object(Config, 'read', return_value={'project': {'path': tmpdir}}):
            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=None,
                requirement="Test",
                dataset="data.csv",
                tasks=None,
                description="Test"
            )

            mock_agent = MagicMock()
            mock_completion = MagicMock()
            mock_completion.choices = [MagicMock()]
            mock_completion.choices[0].message.content = "File Name: my_model.py"
            mock_agent.completions.return_value = mock_completion

            chain = Chain(plan, mock_agent)

            with patch('agent.function.chain.extract_file_name', return_value="my_model.py"):
                with patch('questionary.confirm') as mock_confirm:
                    mock_confirm.return_value.ask.return_value = True
                    generated = chain.gen_file_name("Train model")

            # After fix, plan.training_entry_file should be updated.
            assert plan.training_entry_file == os.path.join(tmpdir, "my_model.py")


