from agent.types.step import Plan
from agent.utils.config import Config, CONFIG_PROJECT_FILE


def test_chain_fails_when_generated_file_has_wrong_extension():
    """
    Test that the bug is present: generated file name may be .csv.
    This test fails on buggy code, passes after fix.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        config_content = f"""
project:
  path: {tmpdir}
"""
        config_path = os.path.join(tmpdir, CONFIG_PROJECT_FILE)
        with open(config_path, "w") as f:
            f.write(config_content)

        with patch.object(Config, 'read', return_value={'project': {'path': tmpdir}}):
            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=None,
                requirement="Train a model",
                dataset="data.csv",
                tasks=None,
                description="Test"
            )

            mock_agent = MagicMock()
            mock_completion = MagicMock()
            mock_completion.choices = [MagicMock()]
            # Simulate buggy behavior: LLM returns .csv
            mock_completion.choices[0].message.content = "File Name: training.csv"
            mock_agent.completions.return_value = mock_completion

            chain = Chain(plan, mock_agent)

            with patch('agent.function.chain.extract_file_name', return_value="training.csv"):
                with patch('questionary.confirm') as mock_confirm:
                    mock_confirm.return_value.ask.return_value = True
                    generated_file = chain.gen_file_name("Train a model")

            # This assertion will fail on buggy code because generated_file ends with .csv.
            # After fix, the prompt ensures .py, so generated_file will be .py and assertion passes.
            assert generated_file.endswith('.py'), f"Generated file {generated_file} must have .py extension for Python project"[0m
