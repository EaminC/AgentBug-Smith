    Buggy code writes to target_source, fixed code writes to training_entry_file.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        config_content = f"""
project:
  path: {tmpdir}
"""
        config_path = os.path.join(tmpdir, CONFIG_PROJECT_FILE)
        with open(config_path, "w") as f:
            f.write(config_content)

        with patch.object(Config, 'read', return_value={'project': {'path': tmpdir}}):
            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=os.path.join(tmpdir, "generated.py"),
                requirement="Test",
                dataset="test.csv",
                tasks=None,
                description="Test"
            )

            mock_agent = MagicMock()
            chain = Chain(plan, mock_agent)

            # Mock streaming completion
            mock_chunk = MagicMock()
            mock_chunk.choices = [MagicMock()]
            mock_chunk.choices[0].delta.content = "```python\nprint('hello')\n```"
            mock_chunk.choices[0].finish_reason = "stop"

            mock_stream = [mock_chunk]
            mock_agent.completions.return_value = mock_stream

            # Mock extract_code to return the code
            with patch('agent.function.chain.extract_code', return_value="print('hello')"):
                # Mock the console and live display to avoid UI issues
                with patch.object(chain.console, 'print'):
                    with patch('rich.live.Live'):
                        # Simulate the streaming completion logic
                        text = ""
                        for chunk in mock_stream:
                            if chunk.choices[0].delta.content:
                                text += chunk.choices[0].delta.content
                            if chunk.choices[0].finish_reason == "stop":
                                code = "print('hello')"
