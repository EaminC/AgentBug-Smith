def test_chain_streaming_writes_to_training_entry_file():
    """
    Test that streaming writes code to training_entry_file, not target_source.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        config_content = f"""
project:
  path: {tmpdir}
"""
        config_path = os.path.join(tmpdir, CONFIG_PROJECT_FILE)
        with open(config_path, "w") as f:
            f.write(config_content)

        with patch.object(Config, 'read', return_value={'project': {'path': tmpdir}}):
            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=os.path.join(tmpdir, "train.py"),
                requirement="Test requirement",
                dataset="data.csv",
                tasks=None,
                description="Test"
            )

            mock_agent = MagicMock()
            chain = Chain(plan, mock_agent)

            # Simulate streaming completion
            mock_completion = MagicMock()
            mock_completion.choices = [MagicMock()]
            mock_completion.choices[0].delta = MagicMock()
            mock_completion.choices[0].delta.content = "```python\nprint('hello')\n```"
            mock_completion.choices[0].finish_reason = "stop"

            def stream_generator():
                yield mock_completion

            mock_agent.completions.return_value = stream_generator()

            # Mock extract_code to return code
            with patch('agent.function.chain.extract_code', return_value="print('hello')"):
                # Mock open to capture file write
                with patch('builtins.open', mock_open()) as mock_file:
                    # Mock Live and Panel to avoid UI issues
                    with patch('agent.function.chain.Live'):
                        with patch('agent.function.chain.Panel'):
                            with patch('agent.function.chain.Markdown'):
                                # Call gen_task_content with a task that uses streaming
                                task = Task(name="test", description="test", kind="train", stream=True)
                                chain.gen_task_content(task)
                                # Ensure file was written to training_entry_file
                                # Note: open is called twice (once for reading, once for writing). We check the write call.
                                write_calls = [call for call in mock_file.call_args_list if call[0] == (chain.training_entry_file, 'w')]
                                assert len(write_calls) == 1


