def test_chain_generates_training_entry_file_with_correct_extension():
    """
    Test that Chain.gen_file_name generates a file with correct extension (.py for Python).
    This test should fail on buggy code because the prompt doesn't enforce correct suffix,
    causing the generated file to sometimes be .csv.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        config_content = f"""
