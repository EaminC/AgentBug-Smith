def test_chain_generates_training_entry_file_with_correct_extension():
    """
    Test that Chain.gen_file_name generates a file name with .py extension,
    not .csv, when language is Python.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        config_content = f"""
project:
  path: {tmpdir}
"""
        config_path = os.path.join(tmpdir, CONFIG_PROJECT_FILE)
        with open(config_path, "w") as f:
            f.write(config_content)

        with patch.object(Config, 'read', return_value={'project': {'path': tmpdir}}):
            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=None,
                requirement="Train a model",
                dataset="data.csv",
                tasks=None,
                description="Test"
            )

            mock_agent = MagicMock()
            mock_completion = MagicMock()
            mock_completion.choices = [MagicMock()]
            # Simulate the LLM returning a file name with .py extension
            mock_completion.choices[0].message.content = "File Name: train_model.py"
            mock_agent.completions.return_value = mock_completion

            chain = Chain(plan, mock_agent)
            # Mock questionary.confirm to auto-accept the generated name
            with patch('questionary.confirm') as mock_confirm:
                mock_confirm.return_value.ask.return_value = True
                result = chain.gen_file_name("Train a model")

            # The result should be a .py file, not .csv
            assert result.endswith('.py')
            # Ensure the plan's training_entry_file is updated
            assert plan.training_entry_file == result


def test_chain_fails_when_generated_file_has_wrong_extension():
    """
    Test that if the LLM returns a file name with .csv extension (incorrect for Python),
    the test will fail on buggy code (because target_source would accept .csv),
    but pass after fix (because training_entry_file should be .py).
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        config_content = f"""
project:
  path: {tmpdir}
"""
        config_path = os.path.join(tmpdir, CONFIG_PROJECT_FILE)
        with open(config_path, "w") as f:
            f.write(config_content)

        with patch.object(Config, 'read', return_value={'project': {'path': tmpdir}}):
            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=None,
                requirement="Train a model",
                dataset="data.csv",
                tasks=None,
                description="Test"
            )

            mock_agent = MagicMock()
            mock_completion = MagicMock()
            mock_completion.choices = [MagicMock()]
            # Simulate the LLM returning a file name with .csv extension (bug scenario)
            mock_completion.choices[0].message.content = "File Name: train_model.csv"
            mock_agent.completions.return_value = mock_completion

            chain = Chain(plan, mock_agent)
            with patch('questionary.confirm') as mock_confirm:
                mock_confirm.return_value.ask.return_value = True
                result = chain.gen_file_name("Train a model")

            # After fix, the file name should still be .csv because we don't modify LLM output,
            # but the test expects that the chain uses training_entry_file, not target_source.
            # The buggy code would have stored this .csv in target_source, which is wrong.
            # We assert that the generated file name is what the LLM gave us.
            assert result.endswith('.csv')
            # The plan's training_entry_file should be set to that .csv file.
            assert plan.training_entry_file == result
            # Additional check: the file path should be inside the project directory
            assert result.startswith(tmpdir)


