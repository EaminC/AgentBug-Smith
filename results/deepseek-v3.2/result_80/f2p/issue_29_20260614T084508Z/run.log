def test_chain_prompt_ensures_python_extension():
    """
    Test that the prompt used for generating file name explicitly mentions correct suffix.
    Buggy prompt is vague, fixed prompt emphasizes correct suffix.
    """
    prompt = pmpt_chain_filename("python")
    # The fixed prompt should contain words like "suffix", ".py", "correct"
    # The buggy prompt is vague and doesn't emphasize suffix.
    # We'll check that the prompt strongly indicates the need for correct suffix.
    # The buggy prompt: "note the file suffix (e.g., .py) should be correct."
    # The fixed prompt: "Ensure that the file suffix (e.g., .py for Python) is correct for the specified language."
    # We'll assert that the prompt contains "suffix" and ".py" in a strong manner.
    # Actually, both prompts contain "suffix" and ".py". The difference is emphasis.
    # Let's check that the prompt includes "Ensure" (fixed) vs "note" (buggy).
    # But the buggy prompt uses "note", fixed uses "Ensure".
    # However, the buggy code still has "note the file suffix (e.g., .py) should be correct."
    # That is already present. The real bug is that the prompt is not enforced by the LLM.
    # The fix changes the prompt text to be more explicit.
    # From the patch, the prompt changed from:
    #   "note the file suffix (e.g., .py) should be correct."
    # to:
    #   "Ensure that the file suffix (e.g., .py for Python) is correct for the specified language."
    # We'll check that the new prompt includes "Ensure" and "for the specified language".
    assert "ensure" in prompt.lower()
    assert ".py" in prompt.lower()
    assert "for the specified language" in prompt.lower()


