            f.write(config_content)

        with patch.object(Config, 'read', return_value={'project': {'path': tmpdir}}):
            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=None,
                requirement="Test",
                dataset="data.csv",
                tasks=None,
                description="Test"
            )

            mock_agent = MagicMock()
            mock_completion = MagicMock()
            mock_completion.choices = [MagicMock()]
            mock_completion.choices[0].message.content = "File Name: my_model.py"
            mock_agent.completions.return_value = mock_completion

            chain = Chain(plan, mock_agent)

            with patch('agent.function.chain.extract_file_name', return_value="my_model.py"):
                with patch('questionary.confirm') as mock_confirm:
                    mock_confirm.return_value.ask.return_value = True
                    generated = chain.gen_file_name("Train model")

            # Check that plan.training_entry_file is updated
            assert plan.training_entry_file == os.path.join(tmpdir, "my_model.py")


def test_chain_debug_command_uses_training_entry_file():
    """
    Test that debug command uses training_entry_file, not target_source.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        config_content = f"""
project:
  path: {tmpdir}
"""
        config_path = os.path.join(tmpdir, CONFIG_PROJECT_FILE)
        with open(config_path, "w") as f:
            f.write(config_content)

        with patch.object(Config, 'read', return_value={'project': {'path': tmpdir}}):
            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=os.path.join(tmpdir, "debug.py"),
                requirement="Test",
                dataset="data.csv",
                tasks=None,
                description="Test"
            )

            mock_agent = MagicMock()
            chain = Chain(plan, mock_agent)

            # Mock a task with debug=True
            task = Task(name="debug", description="Debug", kind="train", debug=True)

            # Mock run_command to avoid actual execution
            with patch('agent.function.chain.run_command') as mock_run:
                mock_run.return_value = ("log", 0)
                # The debug logic uses chain.training_entry_file to build command
                command = f"python {chain.training_entry_file}"
                assert command == f"python {os.path.join(tmpdir, 'debug.py')}"
                chain.gen_task_content(task, params=None)


def test_chain_prompt_for_filename_includes_suffix_instruction():
    """
    Ensure the prompt instructs the LLM to use correct suffix.
    """
    from agent.prompt.base import pmpt_chain_filename
    prompt = pmpt_chain_filename("python")
    assert "suffix" in prompt.lower()
    assert ".py" in prompt


