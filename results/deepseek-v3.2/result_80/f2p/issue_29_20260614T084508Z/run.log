[32mimport os
import tempfile
import pytest
from unittest.mock import patch, MagicMock
from agent.function.chain import Chain
from agent.types.step import Plan, Task
from agent.utils.config import Config
from agent.utils.system import run_command

def test_chain_generates_training_entry_file_with_correct_extension():
    """
    Test that the generated training entry file has a .py extension,
    not .csv or other incorrect extensions.
    """
    # Create a temporary directory for the project
    with tempfile.TemporaryDirectory() as tmpdir:
        # Set up a minimal project configuration
        config_content = f"""
project:
  path: {tmpdir}
"""
        config_path = os.path.join(tmpdir, "project.yml")
        with open(config_path, "w") as f:
            f.write(config_content)
        
        # Mock the config reading to return our temporary path
        with patch.object(Config, 'read', return_value={'project': {'path': tmpdir}}):
            # Create a Plan instance with required fields
            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=None,
                requirement="Train a model on iris dataset",
                dataset="iris.csv",
                tasks=None,
                description="Test project"
            )
            
            # Mock the agent to avoid real API calls
            mock_agent = MagicMock()
            mock_completion = MagicMock()
            mock_completion.choices = [MagicMock()]
            mock_completion.choices[0].message.content = "File Name: train_model.py"
            mock_agent.completions.return_value = mock_completion
            
            # Create Chain instance with mocked agent
            chain = Chain(plan, mock_agent)
            
            # Mock questionary.confirm to return True (accept generated name)
            with patch('questionary.confirm', return_value=True):
                # Call gen_file_name which should set training_entry_file
                generated_file = chain.gen_file_name("Train a model on iris dataset")
                
                # Assert that the generated file has .py extension
                assert generated_file.endswith('.py'), f"Expected .py extension but got {generated_file}"
                
                # Assert that training_entry_file is set correctly
                assert chain.training_entry_file.endswith('.py'), \
                    f"training_entry_file should end with .py, got {chain.training_entry_file}"
                
                # Verify the file path is within the project directory
                assert chain.training_entry_file.startswith(tmpdir), \
                    f"training_entry_file should be in project directory, got {chain.training_entry_file}"
                
                # Verify the agent was called with appropriate prompt
                mock_agent.completions.assert_called_once()
                call_args = mock_agent.completions.call_args
                chat_history = call_args[0][0]
                assert len(chat_history) > 0
                assert any("python" in str(msg).lower() for msg in chat_history)

def test_chain_fails_when_generated_file_has_wrong_extension():
    """
    Test that when the agent generates a file with .csv extension,
    the test should fail on buggy code but pass after fix.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        config_content = f"""
project:
  path: {tmpdir}
"""
        config_path = os.path.join(tmpdir, "project.yml")
        with open(config_path, "w") as f:
            f.write(config_content)
        
        with patch.object(Config, 'read', return_value={'project': {'path': tmpdir}}):
            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=None,
                requirement="Train a model on iris dataset",
                dataset="iris.csv",
                tasks=None,
                description="Test project"
            )
            
            mock_agent = MagicMock()
            mock_completion = MagicMock()
            # Simulate buggy behavior: agent returns .csv file
            mock_completion.choices = [MagicMock()]
            mock_completion.choices[0].message.content = "File Name: train_model.csv"
            mock_agent.completions.return_value = mock_completion
            
            chain = Chain(plan, mock_agent)
            
            with patch('questionary.confirm', return_value=True):
                generated_file = chain.gen_file_name("Train a model on iris dataset")
                
                # This assertion will fail on buggy code (where .csv is accepted)
                # but pass after fix (where prompt ensures .py extension)
                assert not generated_file.endswith('.csv'), \
                    f"File should not have .csv extension for Python project, got {generated_file}"
                
                # Additional check: training_entry_file should not be .csv
                assert not chain.training_entry_file.endswith('.csv'), \
                    f"training_entry_file should not be .csv, got {chain.training_entry_file}"

def test_chain_prompt_ensures_python_extension():
    """
    Test that the prompt template specifically asks for correct file suffix.
    """
    from agent.prompt.base import pmpt_chain_filename
    
    prompt = pmpt_chain_filename("python")
    
    # The prompt should emphasize correct file suffix
    assert "file suffix" in prompt.lower()
    assert ".py" in prompt
    assert "python" in prompt.lower()
    
    # Check that the prompt instructs to generate appropriate extension
    assert "ensure that the file suffix" in prompt.lower() or \
           "correct for the specified language" in prompt.lower()

