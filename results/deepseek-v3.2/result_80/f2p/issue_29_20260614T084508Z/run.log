    def test_chain_gen_file_name_updates_plan_training_entry_file():
        """
        Test that gen_file_name updates plan.training_entry_file, not plan.target.
        """
        with tempfile.TemporaryDirectory() as tmpdir:
            config_content = f"""
    project:
      path: {tmpdir}
    """
            config_path = os.path.join(tmpdir, CONFIG_PROJECT_FILE)
