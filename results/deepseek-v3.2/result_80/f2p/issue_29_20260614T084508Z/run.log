def test_chain_prompt_ensures_python_extension():
    """
    Test that the prompt used for file generation includes language-specific suffix instruction.
    """
    from agent.prompt.base import pmpt_chain_filename
    prompt = pmpt_chain_filename("python")
    assert "file suffix (e.g., .py for Python)" in prompt
    assert ".py" in prompt


def test_chain_uses_training_entry_file_not_target():
    """
    Test that Chain uses training_entry_file attribute, not target_source.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        config_content = f"""
project:
  path: {tmpdir}
"""
        config_path = os.path.join(tmpdir, CONFIG_PROJECT_FILE)
        with open(config_path, "w") as f:
            f.write(config_content)

        with patch.object(Config, 'read', return_value={'project': {'path': tmpdir}}):
            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=os.path.join(tmpdir, "train.py"),
                requirement="Train model",
                dataset="data.csv",
                tasks=None,
                description="Test"
            )

            mock_agent = MagicMock()
            chain = Chain(plan, mock_agent)

            # In buggy code, chain.target_source is used; in fixed code, chain.training_entry_file is used.
            # Check that chain.training_entry_file is set correctly.
            assert chain.training_entry_file == os.path.join(tmpdir, "train.py")
            # Ensure target_source is not present (should raise AttributeError)
            try:
                _ = chain.target_source
                assert False, "chain.target_source should not exist in fixed code"
            except AttributeError:
                pass


def test_chain_streaming_writes_to_training_entry_file():
    """
