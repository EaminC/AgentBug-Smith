            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=None,
                requirement="Train a model on iris dataset",
                dataset="iris.csv",
                tasks=None,
                description="Test"
            )

            mock_agent = MagicMock()
            # Simulate the agent returning a file name with .csv extension (buggy behavior)
            mock_completion = MagicMock()
            mock_completion.choices = [MagicMock()]
            mock_completion.choices[0].message.content = "File Name: train_model.csv"
            mock_agent.completions.return_value = mock_completion

            chain = Chain(plan, mock_agent)

            # Mock extract_file_name to return the extracted name
            with patch('agent.function.chain.extract_file_name', return_value="train_model.csv"):
                # Mock questionary.confirm to return True (accept generated name)
                with patch('questionary.confirm') as mock_confirm:
                    mock_confirm.return_value.ask.return_value = True
                    generated_file = chain.gen_file_name("Train a model on iris dataset")

            # On buggy code, the generated file will have .csv extension, which is wrong for Python.
            # The test should fail because the extension is not .py.
            # After fix, the prompt should enforce .py extension, so the test passes.
            assert generated_file.endswith('.py'), f"Generated file {generated_file} should have .py extension"


