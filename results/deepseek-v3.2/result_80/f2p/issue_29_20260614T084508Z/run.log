        with patch.object(Config, 'read', return_value={'project': {'path': tmpdir}}):
            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=None,
                requirement="Test requirement",
                dataset=None,
                tasks=None,
                description="Test"
            )

            mock_agent = MagicMock()
            chain = Chain(plan, mock_agent)

            # Mock questionary.text to return None (user does not provide dataset)
            with patch('questionary.text') as mock_text:
                mock_text.return_value.ask.return_value = None
                # The chain should raise SystemExit when dataset is not provided
                with pytest.raises(SystemExit):
                    # The run method is not defined in Chain? Actually, the run method exists in chain.py.
                    # We'll call the run method.
                    chain.run()


