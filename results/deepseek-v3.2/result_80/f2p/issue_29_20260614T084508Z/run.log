ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Detect src/ layout or imports of src.* to decide editable install
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." . 2>/dev/null; then \
        echo "src layout detected, skipping editable install, setting PYTHONPATH" && \
        export PYTHONPATH=/app:$PYTHONPATH; \
    else \
        echo "No src layout, performing editable install"; \
    fi

# Install dependencies based on existing files
# We have requirements.txt and setup.py, so follow the project's own install method
