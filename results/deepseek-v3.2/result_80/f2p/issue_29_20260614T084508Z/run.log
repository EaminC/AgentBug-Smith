                    with patch('agent.function.chain.Live'):
                        with patch('agent.function.chain.Panel'):
                            with patch('agent.function.chain.Markdown'):
                                # Call gen_task_content with a task that uses streaming
                                task = Task(name="test", description="test", kind="train", stream=True)
                                chain.gen_task_content(task)
                                # Ensure file was written to training_entry_file
                                mock_file.assert_called_once_with(chain.training_entry_file, 'w')
                                mock_file().write.assert_called_once_with("print('hello')")


