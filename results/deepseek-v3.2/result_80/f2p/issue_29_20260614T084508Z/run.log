def test_chain_generates_training_entry_file_with_correct_extension():
    """
    Test that gen_file_name generates a file name with correct extension (.py) 
    and updates plan.training_entry_file (not plan.target).
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        config_content = f"""
project:
  path: {tmpdir}
"""
        config_path = os.path.join(tmpdir, CONFIG_PROJECT_FILE)
        with open(config_path, "w") as f:
            f.write(config_content)

        with patch.object(Config, 'read', return_value={'project': {'path': tmpdir}}):
            plan = Plan(
                project_name="test_project",
                project=tmpdir,
                launch_env="local",
                current_task=1,
                lang="python",
                llm="openai",
                training_entry_file=None,
                requirement="Train a model",
                dataset="data.csv",
                tasks=None,
                description="Test"
            )

            mock_agent = MagicMock()
            chain = Chain(plan, mock_agent)

            # Mock the agent completions to return a file name with .py extension
            mock_completion = MagicMock()
            mock_completion.choices = [MagicMock()]
            mock_completion.choices[0].message.content = "File Name: train.py"
            mock_agent.completions.return_value = mock_completion

            # Mock extract_file_name to return the file name
            with patch('agent.function.chain.extract_file_name', return_value="train.py"):
                # Mock questionary confirm and text to accept the generated name
                with patch('questionary.confirm') as mock_confirm:
                    mock_confirm.return_value.ask.return_value = True
                    result = chain.gen_file_name("Train a model")

            # Assert the generated file name ends with .py
            assert result.endswith(".py")
            # Assert plan.training_entry_file is updated
            assert plan.training_entry_file == result
            # Assert plan.target does not exist (should be removed in fixed version)
            assert not hasattr(plan, 'target')


