def message_builder_from_string(chat_content: str) -> List[AIMessage]:
    json = {
        "lc": 1,
        "type": "constructor",
        "id": ["langchain", "schema", "messages", "AIMessage"],
        "kwargs": {
            "content": chat_content,
            "additional_kwargs": {},
            "response_metadata": {"finish_reason": "stop"},
            "name": None,
            "id": None,
            "example": False,
        },
    }
    return [AIMessage(**json["kwargs"])]


def test_zbf_yml_missing_fail2pass():
    """
    This test reproduces the bug reported in issue #1197.
    The bug is a KeyError when salvage_correct_hunks receives diffs with
    multiple changes for the same file. The fix ensures only the first diff
    per file is kept during parsing.

    On the buggy version, this test will raise a KeyError.
    After the fix, it should complete without exception.
    """
    files = FilesDict({"src/main/resources/application.yml": CODE_CONTENT})
    messages = message_builder_from_string(CHAT_CONTENT)

