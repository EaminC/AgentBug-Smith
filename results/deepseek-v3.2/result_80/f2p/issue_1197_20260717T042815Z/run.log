    updated_files, _ = salvage_correct_hunks(messages, files, memory)

    # Verify expected files exist after successful improvement
    assert "src/main/resources/application.yml" in updated_files
    assert "src/main/resources/application-local.yml" in updated_files

    # Print for debugging (consistent with existing test style)
    print(updated_files["src/main/resources/application.yml"])
    print(updated_files["src/main/resources/application-local.yml"])


