[32mimport os
import sys
import tempfile
import shutil
from unittest.mock import patch, MagicMock
import pytest

# Ensure we can import mle.cli
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import mle.cli
from mle.utils.memory import LanceDBMemory


def test_lancedb_memory_initialization_not_at_module_level():
    """
    Test that LanceDBMemory is not instantiated at module level in cli.py.
    In buggy version, `memory = LanceDBMemory(os.getcwd())` at module level
    causes TypeError because config may not be loaded.
    In fixed version, that line is removed and instantiation happens inside chat().
    """
    # First, verify that the module-level variable 'memory' does NOT exist
    # or is not an instance of LanceDBMemory.
    # In buggy version, mle.cli.memory would be a LanceDBMemory instance.
    # In fixed version, mle.cli.memory should not exist (AttributeError) or be something else.
    has_memory = hasattr(mle.cli, 'memory')
    if has_memory:
        # If it exists, it must NOT be a LanceDBMemory instance in fixed version.
        # But in buggy version it will be, and will have already raised TypeError
        # during import if config is missing. We'll simulate that by checking
        # whether importing cli raises TypeError.
        pass

    # Now test the actual bug: importing cli with missing config should NOT raise TypeError
    # due to LanceDBMemory at module level.
    # We'll create a temporary directory to simulate a fresh project without config.
    tmpdir = tempfile.mkdtemp()
    original_cwd = os.getcwd()
    os.chdir(tmpdir)
    try:
        # Remove any existing config file
        config_path = os.path.join(tmpdir, '.mle', 'config.yaml')
        if os.path.exists(config_path):
            os.remove(config_path)
        # Also remove parent .mle dir if empty
        config_dir = os.path.dirname(config_path)
        if os.path.exists(config_dir) and not os.listdir(config_dir):
            os.rmdir(config_dir)

        # In buggy version, importing cli will trigger LanceDBMemory.__init__
        # which accesses config["platform"] before config is loaded, leading to TypeError.
        # We'll attempt to import cli again in this environment.
        # First, remove the module from sys.modules to force re-import.
        if 'mle.cli' in sys.modules:
            del sys.modules['mle.cli']
        if 'mle' in sys.modules:
            del sys.modules['mle']

        # Mock the LanceDBMemory.__init__ to capture calls.
        # We'll patch the actual LanceDBMemory.__init__ to see if it's called at module level.
        with patch.object(LanceDBMemory, '__init__', side_effect=LanceDBMemory.__init__) as mock_init:
            # Also patch the config loading inside LanceDBMemory.__init__ to raise TypeError
            # if accessed incorrectly.
            # The bug is that config is None when accessed.
            # We'll simulate that by patching the config loading in memory.py.
            # But we must not mock the exact buggy code; we mock the internal client.
            # However, the bug is in memory.py line 23: if config["platform"] == "OpenAI":
            # config is loaded via load_config() from utils.system.
            # We'll mock load_config to return None to simulate missing config.
            from mle.utils.system import load_config
            with patch('mle.utils.system.load_config', return_value=None):
                try:
                    # Re-import cli - this will execute module-level code.
                    import importlib
                    import mle.cli
                    # If we reach here without TypeError, the bug is fixed (or config is loaded elsewhere).
                    # In buggy version, the TypeError would have been raised.
                    # So we assert that mock_init was NOT called at module level.
                    # However, mock_init might be called later inside chat().
                    # We just need to ensure no TypeError occurred during import.
                    # So the test passes if import succeeds.
                    # That's the pass condition for fixed version.
                    # For buggy version, the import will raise TypeError.
                    # We'll catch it and fail the test (but the test runner will catch it as error).
                    pass
                except TypeError as e:
                    if "'NoneType' object is not subscriptable" in str(e):
                        # This is the buggy behavior.
                        # Raise an assertion error so test fails.
                        raise AssertionError("LanceDBMemory instantiation at module level caused TypeError with missing config")
                    else:
                        raise
    finally:
        os.chdir(original_cwd)
        shutil.rmtree(tmpdir, ignore_errors=True)

    # Additional check: ensure chat() command creates memory locally.
    # This is not necessary for fail2pass but ensures the fix works.
    # We'll test that chat() creates a new LanceDBMemory instance when called.
    # Mock the click command context.
    from click.testing import CliRunner
    runner = CliRunner()
    with patch('mle.cli.LanceDBMemory') as mock_memory:
        with patch('mle.cli.check_config', return_value=True):
            with patch('mle.cli.chat_workflow') as mock_chat_workflow:
                # Run the chat command with --build-mem flag.
                result = runner.invoke(mle.cli.chat, ['--build-mem'])
                # In fixed version, LanceDBMemory should be instantiated inside chat().
                # In buggy version, it would have been instantiated at module level already.
                # We can assert that mock_memory was called.
                # However, in buggy version, the module-level instantiation already happened
                # during import, so mock_memory would have been called then as well.
                # But we patched after import, so only the call inside chat() counts.
                # We'll just verify that mock_memory.call_count >= 1.
                assert mock_memory.call_count >= 1
                # The call should have been with os.getcwd() as argument.
                mock_memory.assert_called_with(os.getcwd())


if __name__ == '__main__':
    # Allow running with python directly.
    pytest.main([__file__, '-v'])[0m
