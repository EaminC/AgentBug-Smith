import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from mle.utils.memory import ChromaDBMemory, LanceDBMemory
from mle.utils.system import get_config


def test_chromadb_memory_initialization():
    """Test that ChromaDBMemory can be initialized without error."""
    with tempfile.TemporaryDirectory() as tmpdir:
        # In buggy version, Memory class exists but not ChromaDBMemory.
        # After fix, ChromaDBMemory is defined.
        # This test will fail on buggy because import fails.
        memory = ChromaDBMemory(tmpdir)
        assert memory is not None
        assert memory.project_path == tmpdir


def test_chromadb_memory_add_and_query():
    """Test adding and querying in ChromaDBMemory."""
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = ChromaDBMemory(tmpdir)
        # Mock the embedding function to avoid real API calls
        mock_embedding = MagicMock()
        mock_embedding.return_value = [[0.1, 0.2, 0.3]]
        memory.embedding_function = mock_embedding
        ids = memory.add(["test text"], metadata=[{"source": "test"}])
        assert len(ids) == 1
        results = memory.query(["test query"], n_results=1)
        assert len(results) == 1
        # results is list of list of dicts
        assert isinstance(results[0], list)
        if len(results[0]) > 0:
            assert "text" in results[0][0]


