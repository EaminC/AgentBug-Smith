    Test counting records in LanceDBMemory.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        with patch("mle.utils.memory.get_config") as mock_get_config:
            mock_get_config.return_value = {"platform": "OpenAI", "api_key": "sk-test123"}
            with patch("lancedb.connect") as mock_connect:
                mock_client = MagicMock()
                mock_client.table_names.return_value = ["memory"]
                mock_table = MagicMock()
                mock_table.count_rows.return_value = 5
                mock_client.open_table.return_value = mock_table
                mock_connect.return_value = mock_client
                with patch("lancedb.embeddings.get_registry") as mock_registry:
                    mock_embedding = MagicMock()
                    mock_registry.return_value.get.return_value.create.return_value = mock_embedding
                    memory = LanceDBMemory(tmpdir)
                    count = memory.count()
                    assert count == 5
                    mock_client.open_table.assert_called_once_with('memory')

def test_lancedb_memory_reset():
    """
    Test resetting LanceDBMemory.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        with patch("mle.utils.memory.get_config") as mock_get_config:
            mock_get_config.return_value = {"platform": "OpenAI", "api_key": "sk-test123"}
            with patch("lancedb.connect") as mock_connect:
                mock_client = MagicMock()
                mock_client.drop_table.return_value = True
                mock_connect.return_value = mock_client
                with patch("lancedb.embeddings.get_registry") as mock_registry:
                    mock_embedding = MagicMock()
                    mock_registry.return_value.get.return_value.create.return_value = mock_embedding
                    memory = LanceDBMemory(tmpdir)
                    memory.reset()
                    mock_client.drop_table.assert_called_once_with('memory')

