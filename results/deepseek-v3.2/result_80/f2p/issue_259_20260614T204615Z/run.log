    """Test deleting a record in ChromaDBMemory."""
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = ChromaDBMemory(tmpdir)
        mock_embedding = MagicMock()
        mock_embedding.return_value = [[0.1, 0.2, 0.3]]
        memory.embedding_function = mock_embedding
        ids = memory.add(["to delete"])
        # delete should not raise
        memory.delete(ids[0])


def test_chromadb_memory_reset():
    """Test resetting ChromaDBMemory."""
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = ChromaDBMemory(tmpdir)
        # reset may require environment variable; we just call it
