def test_chromadb_memory_initialization():
    """Test that ChromaDBMemory can be initialized without errors."""
    with tempfile.TemporaryDirectory() as tmpdir:
        # Create a minimal config file
        config_path = os.path.join(tmpdir, "config.yaml")
        with open(config_path, "w") as f:
            f.write("platform: OpenAI\napi_key: dummy_key\n")
        # Initialize memory
        memory = ChromaDBMemory(tmpdir)
        assert memory.project_path == tmpdir
        assert memory.collection_name == "memory"
        assert memory.client is not None


def test_chromadb_memory_add_and_query():
    """Test adding and querying items in ChromaDBMemory."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = os.path.join(tmpdir, "config.yaml")
        with open(config_path, "w") as f:
            f.write("platform: OpenAI\napi_key: dummy_key\n")
        memory = ChromaDBMemory(tmpdir)
        # Mock the embedding function to avoid API calls
        mock_embedding = MagicMock()
        mock_embedding.return_value = [[0.1, 0.2, 0.3]]
        memory.embedding_function = mock_embedding
        # Add a text
        ids = memory.add(["sample text"], metadata=[{"source": "test"}])
        assert len(ids) == 1
        # Query
        results = memory.query(["sample query"], n_results=1)
        assert len(results) == 1
        assert len(results[0]) == 1
        # Check that the result contains the added text
        assert results[0][0]["document"] == "sample text"


