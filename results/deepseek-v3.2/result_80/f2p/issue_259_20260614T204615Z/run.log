[32mimport os
import tempfile
import pytest
from unittest.mock import patch, MagicMock
from mle.utils.memory import ChromaDBMemory, LanceDBMemory
from mle.utils.system import get_config


def test_chromadb_memory_initialization():
    """Test that ChromaDBMemory can be initialized."""
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = ChromaDBMemory(tmpdir)
        assert memory.project_path == tmpdir
        assert memory.db_name == ".mle"
        assert memory.table_name == "memory"


def test_chromadb_memory_add_and_query():
    """Test adding and querying in ChromaDBMemory."""
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = ChromaDBMemory(tmpdir)
        texts = ["Hello world", "Goodbye world"]
        ids = memory.add(texts)
        assert len(ids) == 2
        results = memory.query(["Hello"], n_results=1)
        assert isinstance(results, list)
        assert len(results) == 1


def test_chromadb_memory_delete():
    """Test deleting a record in ChromaDBMemory."""
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = ChromaDBMemory(tmpdir)
        ids = memory.add(["Test text"])
        success = memory.delete(ids[0])
        assert success is True


def test_chromadb_memory_reset():
    """Test resetting ChromaDBMemory."""
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = ChromaDBMemory(tmpdir)
        # Should not raise an error
        memory.reset()


def test_lancedb_memory_initialization():
    """Test that LanceDBMemory can be initialized."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = os.path.join(tmpdir, "config.yaml")
        with open(config_path, "w") as f:
            f.write("platform: OpenAI\napi_key: dummy_key\n")
        with patch("lancedb.connect") as mock_connect, \
             patch("lancedb.embeddings.get_registry") as mock_registry:
            mock_client = MagicMock()
            mock_client.table_names.return_value = []
            mock_connect.return_value = mock_client
            mock_openai_embedding = MagicMock()
            mock_openai_embedding.compute_source_embeddings.return_value = [[0.1, 0.2, 0.3]]
            mock_registry.return_value.get.return_value.create.return_value = mock_openai_embedding
            memory = LanceDBMemory(tmpdir)
            assert memory.db_name == '.mle'
            assert memory.table_name == 'memory'
            mock_connect.assert_called_once_with(uri='.mle')


