[32mimport os
import tempfile
import pytest
from unittest.mock import patch, MagicMock
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from mle.utils.memory import ChromaDBMemory, LanceDBMemory
from mle.utils.system import get_config


def test_chromadb_memory_initialization():
    """Test that ChromaDBMemory can be initialized with a project path."""
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = ChromaDBMemory(tmpdir)
        assert memory.project_path == tmpdir
        assert memory.db_name == ".mle"
        assert memory.table_name == "memory"
        assert memory.client is not None


def test_chromadb_memory_add_and_query():
    """Test adding and querying text in ChromaDBMemory."""
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = ChromaDBMemory(tmpdir)
        texts = ["Hello world", "Test document"]
        ids = memory.add(texts)
        assert len(ids) == 2
        results = memory.query(["world"], n_results=1)
        assert len(results) == 1
        assert len(results[0]) == 1


def test_chromadb_memory_delete():
    """Test deleting a record from ChromaDBMemory."""
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = ChromaDBMemory(tmpdir)
        ids = memory.add(["Delete me"])
        success = memory.delete(ids[0])
        assert success is True


def test_chromadb_memory_reset():
    """Test resetting ChromaDBMemory."""
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = ChromaDBMemory(tmpdir)
        # Mock the reset to avoid actual reset
        with patch.object(memory.client, 'reset') as mock_reset:
            memory.reset()
            mock_reset.assert_called_once()


def test_lancedb_memory_initialization():
    """Test that LanceDBMemory can be initialized with a project path."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = os.path.join(tmpdir, "config.yaml")
        with open(config_path, "w") as f:
            f.write("platform: OpenAI\napi_key: dummy_key\n")
        with patch("lancedb.connect") as mock_connect, \
             patch("lancedb.embeddings.get_registry") as mock_registry:
            mock_client = MagicMock()
            mock_client.table_names.return_value = []
            mock_connect.return_value = mock_client
            mock_openai_embedding = MagicMock()
            mock_openai_embedding.compute_source_embeddings.return_value = [[0.1, 0.2, 0.3]]
            mock_registry.return_value.get.return_value.create.return_value = mock_openai_embedding
            memory = LanceDBMemory(tmpdir)
            assert memory.db_name == '.mle'
            assert memory.table_name == 'memory'
            assert memory.client is mock_client
            assert memory.text_embedding is mock_openai_embedding


def test_lancedb_memory_add():
    """Test adding text to LanceDBMemory."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = os.path.join(tmpdir, "config.yaml")
        with open(config_path, "w") as f:
            f.write("platform: OpenAI\napi_key: dummy_key\n")
        with patch("lancedb.connect") as mock_connect, \
             patch("lancedb.embeddings.get_registry") as mock_registry:
            mock_client = MagicMock()
            mock_client.table_names.return_value = []
            mock_table = MagicMock()
            mock_client.create_table.return_value = mock_table
            mock_connect.return_value = mock_client
            mock_openai_embedding = MagicMock()
            mock_openai_embedding.compute_source_embeddings.return_value = [[0.1, 0.2, 0.3]]
            mock_registry.return_value.get.return_value.create.return_value = mock_openai_embedding
            memory = LanceDBMemory(tmpdir)
            ids = memory.add(["Test text"])
            assert len(ids) == 1
            mock_openai_embedding.compute_source_embeddings.assert_called_once_with(["Test text"])
            mock_client.create_table.assert_called_once()


def test_lancedb_memory_query():
    """Test querying LanceDBMemory."""
    with tempfile.TemporaryDirectory() as tmpdir:
        config_path = os.path.join(tmpdir, "config.yaml")
        with open(config_path, "w") as f:
            f.write("platform: OpenAI\napi_key: dummy_key\n")
        with patch("lancedb.connect") as mock_connect, \
             patch("lancedb.embeddings.get_registry") as mock_registry:
            mock_client = MagicMock()
            mock_client.table_names.return_value = ["memory"]
            mock_table = MagicMock()
            mock_search = MagicMock()
            mock_search.limit.return_value = mock_search
            mock_search.to_list.return_value = [{"vector": [0.1, 0.2, 0.3], "text": "Test", "id": "1"}]
            mock_table.search.return_value = mock_search
            mock_client.open_table.return_value = mock_table
            mock_connect.return_value = mock_client
            mock_openai_embedding = MagicMock()
            mock_openai_embedding.compute_source_embeddings.return_value = [[0.1, 0.2, 0.3]]
            mock_registry.return_value.get.return_value.create.return_value = mock_openai_embedding
            memory = LanceDBMemory(tmpdir)
            results = memory.query(["query"], n_results=1)
            assert len(results) == 1
            assert len(results[0]) == 1
            mock_openai_embedding.compute_source_embeddings.assert_called_once_with(["query"])
            mock_table.search.assert_called_once()


