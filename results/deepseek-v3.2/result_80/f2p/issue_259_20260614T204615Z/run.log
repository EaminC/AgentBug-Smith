        # We'll mock the client reset.
        memory.client.reset = MagicMock()
        memory.reset()
        memory.client.reset.assert_called_once()


def test_lancedb_memory_initialization():
    """Test that LanceDBMemory can be initialized without error."""
    with tempfile.TemporaryDirectory() as tmpdir:
