def test_chromadb_memory_initialization():
    """Test that ChromaDBMemory can be initialized without errors."""
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = ChromaDBMemory(tmpdir)
        assert memory.project_path == tmpdir
        assert memory.collection_name == "memory"
        assert memory.client is not None


def test_chromadb_memory_add_and_query():
    """Test adding and querying text in ChromaDBMemory."""
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = ChromaDBMemory(tmpdir)
        ids = memory.add(["Hello world", "Goodbye world"])
        assert len(ids) == 2
        results = memory.query(["Hello"], n_results=1)
        assert len(results) == 1
        assert len(results[0]) == 1


def test_chromadb_memory_delete():
    """Test deleting a record from ChromaDBMemory."""
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = ChromaDBMemory(tmpdir)
        ids = memory.add(["Test text"])
        success = memory.delete(ids[0])
        assert success is True


