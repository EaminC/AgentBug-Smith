def test_lancedb_memory_methods():
    """
    Test the methods of LanceDBMemory with mocked dependencies.
    This test should only run in the fixed codebase.
    """
    # Skip if the class doesn't exist (buggy codebase)
    try:
        from mle.utils.memory import LanceDBMemory
    except ImportError:
        pytest.skip("LanceDBMemory not available (buggy codebase)")

    tmpdir = tempfile.mkdtemp()
    try:
        config_dir = os.path.join(tmpdir, '.mle')
        os.makedirs(config_dir, exist_ok=True)
        config_path = os.path.join(config_dir, 'config.yaml')
        with open(config_path, 'w') as f:
            f.write('''platform: OpenAI
api_key: dummy_key
''')

        # Mock lancedb and embeddings
        with patch('lancedb.connect') as mock_connect, \
             patch('lancedb.embeddings.get_registry') as mock_registry:
            mock_db = MagicMock()
            mock_connect.return_value = mock_db
            mock_db.table_names.return_value = []
            mock_embedding = MagicMock()
            mock_embedding.compute_source_embeddings.return_value = [[0.1, 0.2, 0.3]]
            mock_registry.return_value.get.return_value.create.return_value = mock_embedding

            # Mock table operations
            mock_table = MagicMock()
            mock_db.open_table.return_value = mock_table
            mock_db.create_table.return_value = mock_table
            mock_table.search.return_value.limit.return_value.to_list.return_value = [
                {'vector': [0.1, 0.2, 0.3], 'text': 'sample', 'id': '1', 'metadata': None}
            ]
            mock_table.count_rows.return_value = 5
            mock_table.delete.return_value = True

            memory = LanceDBMemory(tmpdir)

            # Test add
            ids = memory.add(['text1', 'text2'])
            assert len(ids) == 2
            # Test query
            results = memory.query(['query1'])
            assert len(results) == 1
            # Test count
            count = memory.count()
            assert count == 5
            # Test delete
            deleted = memory.delete('1')
            assert deleted is True
            # Test drop
            mock_db.drop_table.return_value = True
            dropped = memory.drop()
            assert dropped is True
            # Test reset
            memory.reset()
            mock_db.drop_table.assert_called()
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)

