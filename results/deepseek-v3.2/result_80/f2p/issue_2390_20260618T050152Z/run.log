[32mFROM python:3.10-slim AS test_builder

WORKDIR /app

# Install system dependencies for headless browser testing and git
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    gnupg2 \
    libgtk-3-0 \
    libdbus-glib-1-2 \
    dbus-x11 \
    xvfb \
    ca-certificates \
    chromium \
    firefox-esr \
    && rm -rf /var/lib/apt/lists/*

# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Detect src layout to avoid duplicate module loading
# Check for src directory or imports from src. in test files
COPY . .
RUN if [ -d "src" ] || (find tests -name "*.py" -exec grep -l "^[[:space:]]*from src\." {} \; 2>/dev/null | grep -q .) || (find tests -name "*.py" -exec grep -l "^[[:space:]]*import src\." {} \; 2>/dev/null | grep -q .); then \
    echo "src layout detected, setting PYTHONPATH and skipping editable install"; \
    ENV PYTHONPATH=/app; \
    fi

# Install project dependencies and test tooling
# Use requirements.txt if present (trimming dev section as in original Dockerfile)
RUN if [ -f "requirements.txt" ]; then \
    sed -i '/Items below this point will not be included in the Docker Image/,$d' requirements.txt && \
    pip install --no-cache-dir -r requirements.txt; \
    fi

# Install the project itself (conditional based on src layout)
RUN if [ -d "src" ] || (find tests -name "*.py" -exec grep -l "^[[:space:]]*from src\." {} \; 2>/dev/null | grep -q .) || (find tests -name "*.py" -exec grep -l "^[[:space:]]*import src\." {} \; 2>/dev/null | grep -q .); then \
    echo "Skipping editable install due to src layout"; \
    else \
    pip install --no-cache-dir -e .; \
    fi

# Install mandatory test dependencies (unconditionally)
RUN pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set Forge environment variables (required by test harness)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Final command (required by test harness)
CMD ["/bin/bash"]

# Multi-stage build for minimal runtime image (optional)
FROM python:3.10-slim

WORKDIR /app

# Install runtime system dependencies (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy only production dependencies from test_builder
COPY --from=test_builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=test_builder /usr/local/bin /usr/local/bin

# Copy application code
COPY autogpt ./autogpt

# Set Forge environment variables for runtime as well
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Set entrypoint as per original Dockerfile
ENTRYPOINT ["python", "-m", "autogpt"][0m
