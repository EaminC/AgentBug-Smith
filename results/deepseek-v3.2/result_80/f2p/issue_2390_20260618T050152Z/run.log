    chromium \
    firefox-esr \
    build-essential \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    libssl-dev \
    libffi-dev \
    curl \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install Rust compiler for building tiktoken from source
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Upgrade packaging tools
RUN python -m pip install --upgrade pip wheel setuptools

# Copy entire repository (required for test injection)
COPY . .

# Install project dependencies from requirements.txt
# tiktoken needs Rust compiler (installed above) to build from source
RUN if [ -f "requirements.txt" ]; then \
    pip install --break-system-packages "PyYAML>=5.3.1,<6.1" && \
    grep -v "en-core-web-sm @" requirements.txt | grep -v "^pyyaml==" > /tmp/requirements_temp.txt && \
    sed -i '/Items below this point will not be included in the Docker Image/,$d' /tmp/requirements_temp.txt && \
    pip install --break-system-packages -r /tmp/requirements_temp.txt; \
    fi

# Install spacy model from URL separately with retry logic
RUN if [ -f "requirements.txt" ]; then \
    SPACY_MODEL_URL=$(grep "en-core-web-sm @" requirements.txt | sed 's/.*@ //') && \
    if [ -n "$SPACY_MODEL_URL" ]; then \
        echo "Installing spacy model from: $SPACY_MODEL_URL" && \
        pip install --break-system-packages "$SPACY_MODEL_URL" || \
        echo "Warning: Could not install spacy model from URL, trying alternative..." && \
        pip install --break-system-packages "spacy>=3.0.0,<4.0.0" && python -m spacy download en_core_web_sm || \
        echo "Warning: Could not install spacy model, continuing without it"; \
    fi; \
    fi

# Install the project itself - temporarily rename plugins directory to avoid package discovery
RUN mv plugins plugins_backup && \
    pip install --break-system-packages . && \
    mv plugins_backup plugins || true

# Install mandatory test dependencies (unconditionally)
RUN pip install --break-system-packages pytest pytest-mock pytest-asyncio pytest-cov anyio litellm pytest-xdist pytest-timeout mem0ai

# Install additional test dependencies from requirements.txt dev section
RUN if [ -f "requirements.txt" ]; then \
    LINE_NUM=$(grep -n "Items below this point will not be included in the Docker Image" requirements.txt | cut -d: -f1) && \
    if [ -n "$LINE_NUM" ]; then \
        tail -n +$LINE_NUM requirements.txt | \
        pip install --break-system-packages -r /dev/stdin || true; \
    fi; \
    fi

# Set Forge environment variables (required by test harness)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0
ENV ANTHROPIC_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")' && \
    python -c 'import autogpt; print("autogpt import ok")' && \
    python -c 'import tiktoken; print("tiktoken import ok")'

# Final command (required by test harness)
