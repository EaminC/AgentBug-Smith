def test_logger_chinese_support() -> None:
    """Test that logging Chinese characters does not escape them as Unicode."""
    # Setup logging capture
    captured_logs = []
    logger = logging.getLogger("agentscope")
    original_handlers = logger.handlers[:]
    logger.handlers.clear()
    handler = logging.StreamHandler()
    handler.setLevel(logging.DEBUG)
    formatter = logging.Formatter("%(message)s")
    handler.setFormatter(formatter)
    logger.addHandler(handler)

    class CaptureHandler(logging.Handler):
        def emit(self, record):
            captured_logs.append(record.getMessage())

    capture_handler = CaptureHandler()
    capture_handler.setLevel(logging.DEBUG)
    logger.addHandler(capture_handler)
    logger.setLevel(logging.DEBUG)

    # Mock model loading to avoid config requirement
    with patch("agentscope.models.load_model_by_config_name") as mock_load:
        mock_model = MagicMock(spec=ModelWrapperBase)
        mock_model.config_name = "test_config"
        mock_model.return_value = ModelResponse(
            text='{"speak": "这是一个中文测试"}',
            raw={"choices": [{"message": {"content": "这是一个中文测试"}}]},
        )
        mock_load.return_value = mock_model

        # Test DictDialogAgent reply logging
        agent = DictDialogAgent(
            name="test_agent",
            sys_prompt="You are a test agent.",
            model_config_name="test_config",
        )
        # Trigger reply to generate log
        agent.reply()

        # Check that the log contains Chinese characters directly, not escaped
        assert any("这是一个中文测试" in log for log in captured_logs), (
            f"Expected Chinese characters '这是一个中文测试' in logs, got {captured_logs}"
        )
        # Ensure no Unicode escape sequences like \u8fd9\u662f
        assert not any("\\u" in log for log in captured_logs), (
            f"Found Unicode escape sequences in logs: {captured_logs}"
        )

    # Test ModelWrapperBase.__str__ with Chinese
    model_response = ModelResponse(
        text="中文文本",
        raw={"raw": "中文"},
    )
    str_repr = str(model_response)
    assert "中文" in str_repr
    assert "\\u" not in str_repr

    # Test _chat logging with Chinese
    _chat({"content": "聊天内容"})
    assert any("聊天内容" in log for log in captured_logs), (
        f"Expected '聊天内容' in logs, got {captured_logs}"
    )
    assert not any("\\u" in log for log in captured_logs), (
        f"Found Unicode escape sequences in logs: {captured_logs}"
    )

