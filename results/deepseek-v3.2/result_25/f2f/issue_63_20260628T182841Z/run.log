[32mimport json
import logging
from unittest.mock import patch, MagicMock
import pytest

from agentscope.agents import DictDialogAgent
from agentscope.models import ModelWrapperBase, ModelResponse
from agentscope.utils.logging_utils import logger as agentscope_logger


def test_logger_chinese_support() -> None:
    """Test that logging Chinese characters does not escape them as Unicode."""
    # Capture logs from the agentscope logger
    captured_logs = []
    original_level = agentscope_logger.level
    original_handlers = agentscope_logger.handlers[:]
    agentscope_logger.handlers.clear()

    class CaptureHandler(logging.Handler):
        def emit(self, record: logging.LogRecord) -> None:
            captured_logs.append(record.getMessage())

    capture_handler = CaptureHandler()
    capture_handler.setLevel(logging.DEBUG)
    agentscope_logger.addHandler(capture_handler)
    agentscope_logger.setLevel(logging.DEBUG)

    # Mock the model loading to avoid actual model configs
    with patch("agentscope.models._MODEL_CONFIGS", {"test_config": MagicMock(model_type="dummy")}):
        with patch("agentscope.models.load_model_by_config_name") as mock_load:
            mock_model = MagicMock(spec=ModelWrapperBase)
            mock_model.config_name = "test_config"
            mock_model.return_value = ModelResponse(
                text='{"speak": "这是一个中文测试"}',
                raw={"choices": [{"message": {"content": "这是一个中文测试"}}]},
            )
            mock_load.return_value = mock_model

            # Test DictDialogAgent reply logging
            agent = DictDialogAgent(
                name="test_agent",
                sys_prompt="You are a test agent.",
                model_config_name="test_config",
            )

            # Trigger reply which logs the response
            response = agent.reply()
            # Ensure the mock was called
            mock_model.assert_called_once()

    # Restore logger
    agentscope_logger.handlers = original_handlers
    agentscope_logger.setLevel(original_level)

    # Check that at least one log contains Chinese characters without Unicode escape
    # The buggy code would log with ensure_ascii=True (default), causing escaped Unicode.
    # The fixed code logs with ensure_ascii=False, preserving the original characters.
    chinese_phrase = "这是一个中文测试"
    found = False
    for log in captured_logs:
        # If the log is a JSON string, parse it to see if it contains the Chinese phrase
        try:
            parsed = json.loads(log)
            # Look for the Chinese phrase in the parsed object (could be nested)
            def contains_chinese(obj):
                if isinstance(obj, str):
                    return chinese_phrase in obj
                elif isinstance(obj, dict):
                    return any(contains_chinese(v) for v in obj.values())
                elif isinstance(obj, list):
                    return any(contains_chinese(v) for v in obj)
                return False
            if contains_chinese(parsed):
                found = True
                # The key assertion: the raw log string should contain the actual Chinese characters,
                # not their Unicode escape sequences.
                # In buggy code, the log would contain something like "\u8fd9\u662f\u4e00\u4e2a\u4e2d\u6587\u6d4b\u8bd5"
                # In fixed code, the log contains "这是一个中文测试"
                assert chinese_phrase in log, f"Chinese phrase not found in raw log: {log}"
                break
        except json.JSONDecodeError:
            # Not a JSON log, check directly
            if chinese_phrase in log:
                found = True
                assert chinese_phrase in log, f"Chinese phrase not found in raw log: {log}"
                break

    # If no log contains Chinese, the test should fail (since we expect logging).
    assert found, f"No log containing Chinese phrase '{chinese_phrase}' found in captured logs: {captured_logs}"[0m
