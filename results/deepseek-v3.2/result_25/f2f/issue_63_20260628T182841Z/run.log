[32mimport json
import logging
from unittest.mock import patch
from agentscope.agents import DictDialogAgent
from agentscope.message import Msg
from agentscope.models import ModelWrapperBase, ModelResponse
from agentscope.utils.logging_utils import _chat


def test_logger_chinese_support() -> None:
    """Test that logging Chinese characters does not escape them as Unicode."""
    # Capture log output
    captured_logs = []
    logger = logging.getLogger("agentscope")
    original_debug = logger.debug
    original_log = logger.log

    def capture_debug(msg, *args, **kwargs):
        captured_logs.append(("debug", msg))
        # Call original to ensure behavior matches
        original_debug(msg, *args, **kwargs)

    def capture_log(level, msg, *args, **kwargs):
        captured_logs.append(("log", msg))
        original_log(level, msg, *args, **kwargs)

    logger.debug = capture_debug
    logger.log = capture_log

    try:
        # Test 1: DictDialogAgent reply logging
        # Mock the model call to avoid real API calls
        with patch(
            "agentscope.models.model.ModelWrapperBase.__call__",
            return_value=ModelResponse(
                text='{"speak": "这是一个中文测试"}',
                raw={"choices": [{"message": {"content": "这是一个中文测试"}}]},
            ),
        ):
            agent = DictDialogAgent(
                name="test_agent",
                sys_prompt="You are a test agent.",
                model_config_name="test_config",
            )
            # Trigger reply which logs debug
            agent.reply(x=Msg("user", "Hello"))
            # Check that the logged message contains Chinese characters directly
            assert any(
                "这是一个中文测试" in log_msg
                for _, log_msg in captured_logs
                if isinstance(log_msg, str)
            ), "Chinese characters should appear directly in logs"

        # Test 2: ModelWrapperBase __str__ method
        model_response = ModelResponse(
            text="中文响应",
            raw={"key": "值"},
        )
        response_str = str(model_response)
        # The __str__ uses json.dumps with ensure_ascii=False after fix
        # In buggy version, Chinese will be escaped as Unicode
        assert "值" in response_str, "Chinese characters should appear directly in __str__ output"

        # Test 3: ModelWrapperBase __init__ logging
        # Clear captured logs
        captured_logs.clear()
        with patch.object(ModelWrapperBase, "__init__", lambda self, config_name, **kwargs: None):
            # The __init__ will log debug with kwargs
            # We need to actually call the real __init__ to see the logging
            # So we create a dummy config and let it log
            class DummyModel(ModelWrapperBase):
                def __call__(self, *args, **kwargs):
                    return ModelResponse(text="", raw={})

            dummy = DummyModel(config_name="dummy", param="中文参数")
            # The __init__ logs debug with kwargs
            assert any(
                "中文参数" in log_msg
                for _, log_msg in captured_logs
                if isinstance(log_msg, str)
            ), "Chinese characters should appear directly in model init debug log"

        # Test 4: _chat logging utility
        captured_logs.clear()
        chat_msg = {"role": "user", "content": "中文聊天内容"}
        _chat(chat_msg)
        # _chat logs at LEVEL_CHAT_SAVE with json.dumps
        assert any(
            "中文聊天内容" in log_msg
            for _, log_msg in captured_logs
            if isinstance(log_msg, str)
        ), "Chinese characters should appear directly in _chat log"

        # Additional assertion: ensure no Unicode escape sequences like \u4e2d\u6587
        for _, log_msg in captured_logs:
            if isinstance(log_msg, str):
                # If ensure_ascii=False is missing, Chinese characters become \uXXXX
                # So we check that there's no such pattern for common Chinese char
                assert "\\u4e2d" not in log_msg, "Log should not contain Unicode escape for Chinese"
                assert "\\u6587" not in log_msg, "Log should not contain Unicode escape for Chinese"

    finally:
        # Restore original methods
        logger.debug = original_debug
        logger.log = original_log[0m
