[32mimport json
import logging
import sys
import os
from unittest.mock import patch, MagicMock

# Add the src directory to the path so we can import agentscope
sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))

from agentscope.agents.dict_dialog_agent import DictDialogAgent
from agentscope.models.model import ModelResponse, ModelWrapperBase
from agentscope.utils.logging_utils import _chat


def test_logger_chinese_support() -> None:
    """Test that logging Chinese characters does not escape them as Unicode."""
    # Capture log output
    captured_logs = []
    original_debug = logging.getLogger("agentscope").debug
    original_log = logging.getLogger("agentscope").log

    def capture_debug(msg, *args, **kwargs):
        captured_logs.append(("debug", msg))
        # Call original to ensure behavior matches
        original_debug(msg, *args, **kwargs)

    def capture_log(level, msg, *args, **kwargs):
        captured_logs.append(("log", msg))
        original_log(level, msg, *args, **kwargs)

    logging.getLogger("agentscope").debug = capture_debug
    logging.getLogger("agentscope").log = capture_log

    try:
        # Test 1: DictDialogAgent reply logging
        # Mock the model call to avoid real API calls
        agent = DictDialogAgent(
            name="test_agent",
            sys_prompt="你是一个助手",
            model_config_name="dummy",
        )
        # Patch the internal model call
        with patch.object(agent.model, "_call") as mock_call:
            mock_response = ModelResponse(
                text="你好，世界！",
                raw={"choices": [{"message": {"content": "你好，世界！"}}]},
            )
            mock_call.return_value = mock_response
            # Trigger reply which logs the response
            agent.reply({})
            # Check that the logged JSON contains Chinese characters directly
            assert any("debug" in log and "你好，世界！" in log[1] for log in captured_logs), \
                "Chinese text should appear directly in debug log, not escaped Unicode"

        # Test 2: ModelWrapperBase __init__ logging
        # Reset captured logs
        captured_logs.clear()
        with patch.object(ModelWrapperBase, "__init__", lambda self, config_name, **kwargs: None):
            # We'll directly test the logging line by patching the logger call
            # Instead, we can create a dummy class that inherits and calls super
            class DummyModel(ModelWrapperBase):
                def __init__(self, config_name, **kwargs):
                    super().__init__(config_name, **kwargs)
                def __call__(self, *args, **kwargs):
                    return ModelResponse(text="", raw={})

            dummy = DummyModel("test_model", param="参数值")
            # The __init__ should have logged with ensure_ascii=False
            assert any("debug" in log and "参数值" in log[1] for log in captured_logs), \
                "Chinese parameter value should appear directly in debug log"

        # Test 3: ModelResponse __str__ method
        response = ModelResponse(
            text="测试响应",
            raw={"key": "值"},
        )
        str_repr = str(response)
        parsed = json.loads(str_repr)
        # The JSON string should contain Chinese characters directly
        assert "测试响应" in str_repr, \
            "Chinese text should appear directly in __str__ output"
        # Ensure it's valid JSON
        assert parsed["text"] == "测试响应"

        # Test 4: _chat logging utility
        captured_logs.clear()
        _chat({"content": "聊天内容"})
        # The chat log should contain Chinese directly
        assert any("log" in log and "聊天内容" in log[1] for log in captured_logs), \
            "Chinese chat content should appear directly in chat log"

        # Additional check: ensure no escaped Unicode sequences like \u4f60\u597d
        for log_type, msg in captured_logs:
            if isinstance(msg, str):
                # If the message contains Chinese characters, they should not be escaped
                # We check that the characters appear directly, not as \u escapes
                # This is a bit heuristic: if there's a backslash followed by 'u' and 4 hex digits, it's escaped
                import re
                escaped_unicode = re.search(r'\\u[0-9a-fA-F]{4}', msg)
                if escaped_unicode:
                    # If there's Chinese in the message, escaping is wrong
                    # But we need to be careful: the message might contain other escaped characters
                    # We'll just assert that the Chinese characters we expect are present directly
                    if "你好" in msg or "世界" in msg or "参数" in msg or "聊天" in msg:
                        # If these Chinese substrings are in the message, they should not be preceded by backslash-u
                        # Actually, if they are in the message as characters, they won't be escaped.
                        # The escaped version would be like "\u4f60\u597d"
                        # So we can check that the message does NOT contain the escaped version of a known Chinese char
                        # Example: "你" is \u4f60
                        assert "\\u4f60" not in msg, f"Chinese character '你' is escaped in log: {msg}"
                        assert "\\u597d" not in msg, f"Chinese character '好' is escaped in log: {msg}"
    finally:
        # Restore original logger methods
        logging.getLogger("agentscope").debug = original_debug
        logging.getLogger("agentscope").log = original_log


if __name__ == "__main__":
    # Allow running directly with python
    test_logger_chinese_support()
    print("All tests passed!")[0m
