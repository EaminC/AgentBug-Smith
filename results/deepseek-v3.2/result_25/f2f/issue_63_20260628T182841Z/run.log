            # Trigger reply which logs debug
            agent.reply({})

        # Test 2: ModelWrapperBase __str__ method
        from agentscope.models.model import ModelResponse
        response = ModelResponse(
            text="中文文本",
            raw={"key": "值"},
        )
        str_output = str(response)

        # Test 3: ModelWrapperBase __init__ logging
        # This is already triggered by agent creation, but we can also directly
        # test by creating a mock model wrapper. However, the agent creation
        # already logs via __init__, so we rely on captured logs.

        # Test 4: _chat function in logging_utils
        _chat({"content": "聊天内容"}, extra="extra")

        # Now verify captured logs
        # We expect at least one debug log from DictDialogAgent.reply
        # and one log from _chat
        debug_messages = [msg for typ, msg in captured_logs if typ == "debug"]
        log_messages = [msg for typ, msg in captured_logs if typ == "log"]

        # Check that Chinese characters are not escaped as Unicode
        # i.e., the string should contain actual Chinese characters, not \u escapes
        for msg in debug_messages + log_messages:
            # If ensure_ascii=False is used, Chinese characters appear directly.
            # If ensure_ascii=True (default), they appear as \uXXXX sequences.
            # We assert that no \u escape sequence for common Chinese characters
            # is present. However, we need to be careful because the log message
            # might contain other \u escapes. Instead, we check that the message
            # contains the actual Chinese characters we expect.
            # Since we don't know the exact format, we'll check that the
            # captured messages contain the Chinese text we injected.
            if "这是一个中文测试" in msg:
                # The buggy version will have \u8fd9\u662f\u4e00\u4e2a\u4e2d\u6587\u6d4b\u8bd5
                # The fixed version will have "这是一个中文测试"
                # So we assert that the Chinese characters appear directly.
                assert "这是一个中文测试" in msg, f"Chinese text escaped in: {msg}"
            if "聊天内容" in msg:
                assert "聊天内容" in msg, f"Chinese text escaped in: {msg}"

        # Additionally, check ModelResponse __str__ output
        # The buggy version will escape Chinese characters in the raw field.
        # The fixed version will not.
        assert "值" in str_output, f"Chinese character escaped in __str__: {str_output}"
        # Also ensure no \u escapes for that character
        assert "\\u503c" not in str_output, f"Unicode escape found in __str__: {str_output}"

    finally:
        # Restore original logging methods
        logging.getLogger("agentscope").debug = original_debug
        logging.getLogger("agentscope").log = original_log[0m
