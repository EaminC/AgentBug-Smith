                    text='{"speak": "这是一个中文测试"}',
                    raw={"choices": [{"message": {"content": "这是一个中文测试"}}]},
                )
                mock_load.return_value = mock_model

                # Create a DictDialogAgent. This will trigger logging in __init__
                # (model.py line 226-227) and later in reply (dict_dialog_agent.py line 145).
                agent = DictDialogAgent(
                    name="test_agent",
