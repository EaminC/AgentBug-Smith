ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Install system dependencies for building packages and any runtime libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy the entire repository
COPY . .

# Upgrade pip and install wheel
RUN python -m pip install --upgrade pip wheel

# Install dependencies based on evidence from setup.py and pyproject.toml
# The project uses setup.py for installation, with extras defined.
# We install the minimal required dependencies plus test dependencies.
# Since there is a src/ layout (src/agentscope), we must NOT do editable install.
# Instead, set PYTHONPATH to /app and install dependencies.
# The project's minimal_requires are defined in setup.py.
# We also install test dependencies (pytest, etc.) and any extras needed for tests.
ENV PYTHONPATH=/app

# Install dependencies from setup.py's minimal_requires and test_requires
# We'll parse the setup.py to get the list? Not feasible; instead install via pip with the package and extras.
# Since we cannot do editable install, we install the package in regular mode.
# But we need to install dependencies first, then the package.
# Use pip install .[distribute]? The test workflow uses .[full].
# According to .github/workflows/unittest.yml, they install with `pip install -q -e .[full]`
# However, due to src/ layout, we avoid -e. We'll install with `pip install .[full]` which includes all extras.
# This will install the package and all dependencies.
RUN pip install .[full]

# Additionally install pytest and related testing packages (some may already be in full)
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Preflight import check to ensure core modules are accessible
RUN python -c "import agentscope, pytest; print('preflight ok')"

# The final CMD is inferred from the project's configuration: there's a console script "as_studio"
# but for testing we default to bash.
CMD ["/bin/bash"][0m
