import logging
from unittest.mock import patch, MagicMock
from agentscope.utils.logging_utils import logger as agentscope_logger
from agentscope.agents.dict_dialog_agent import DictDialogAgent
from agentscope.models import ModelWrapperBase


def test_logger_chinese_support() -> None:
    """Test that logging Chinese characters does not escape them as Unicode."""
    # Capture logs from the agentscope logger
    captured_logs = []
    original_level = agentscope_logger.level
    original_handlers = list(agentscope_logger.handlers)

    # Create a custom handler that captures log records
    class CaptureHandler(logging.Handler):
        def emit(self, record):
            captured_logs.append(record.getMessage())

    capture_handler = CaptureHandler()
    agentscope_logger.setLevel(logging.DEBUG)
    agentscope_logger.addHandler(capture_handler)

    try:
        # Test 1: DictDialogAgent's reply method logs with ensure_ascii=False
        # Mock the model call to avoid actual API calls
        mock_model = MagicMock(spec=ModelWrapperBase)
        mock_response = {
            "speak": "你好，世界！",
            "thought": "这是一个测试",
            "raw": {"choices": [{"message": {"content": "你好，世界！"}}]},
        }
        mock_model.return_value = MagicMock()
        mock_model.return_value.raw = mock_response["raw"]
        mock_model.return_value.text = mock_response["speak"]

        agent = DictDialogAgent(
            name="test_agent",
            sys_prompt="You are a helpful assistant.",
            model=mock_model,
        )

        # Trigger reply which should log the response
        with patch.object(mock_model, "__call__", return_value=mock_model.return_value):
            agent.reply({})

        # Check that the logged JSON contains Chinese characters directly
        assert any("你好，世界！" in log for log in captured_logs), (
            f"Expected Chinese characters in logs, got: {captured_logs}"
        )
        assert not any("\\u" in log for log in captured_logs if "你好" in log), (
            f"Chinese characters should not be Unicode escaped, got: {captured_logs}"
        )

        # Test 2: ModelWrapperBase.__str__ uses ensure_ascii=False
        model_response = ModelWrapperBase.__new__(ModelWrapperBase)
        model_response.text = "测试文本"
        model_response.image_urls = []
        model_response.raw = {}
        str_repr = str(model_response)
        parsed = json.loads(str_repr)
        assert parsed["text"] == "测试文本"
        assert "\\u" not in str_repr, (
            f"Chinese characters in __str__ should not be escaped: {str_repr}"
        )

        # Test 3: ModelWrapperBase.__init__ logging uses ensure_ascii=False
        captured_logs.clear()
        with patch.object(ModelWrapperBase, "__init__", lambda self, config_name, **kwargs: None):
            # The __init__ will still call logger.debug with kwargs
            # We need to intercept the json.dumps call inside that logger.debug
            with patch("json.dumps") as mock_dumps:
                mock_dumps.side_effect = json.dumps
                # Re-instantiate to trigger __init__
                wrapper = ModelWrapperBase("test_config", param="值")
                # Check that json.dumps was called with ensure_ascii=False
                call_kwargs = mock_dumps.call_args[1]
                assert call_kwargs.get("ensure_ascii") is False, (
                    f"ensure_ascii should be False in ModelWrapperBase.__init__ logging, got {call_kwargs}"
                )

        # Test 4: logging_utils._chat uses ensure_ascii=False
        from agentscope.utils.logging_utils import _chat
        captured_logs.clear()
        _chat({"content": "聊天内容"}, level=logging.INFO)
        assert any("聊天内容" in log for log in captured_logs), (
            f"Chinese chat content not found in logs: {captured_logs}"
        )
        assert not any("\\u" in log for log in captured_logs if "聊天内容" in log), (
            f"Chinese chat content should not be escaped: {captured_logs}"
        )

    finally:
        # Restore original logger state
        agentscope_logger.setLevel(original_level)
        for hdlr in agentscope_logger.handlers[:]:
            agentscope_logger.removeHandler(hdlr)
        for hdlr in original_handlers:
            agentscope_logger.addHandler(hdlr)[0m
