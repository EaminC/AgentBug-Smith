    )
    # Ensure no escaped Unicode sequences like \\u8fd9\\u662f
    for log in captured_logs:
        if "\\u" in log:
            # If the bug is present, the log will contain escaped Unicode
            # The test should fail on buggy code, pass on fixed code
            raise AssertionError(
                f"Log contains escaped Unicode: {log}"
            )

    # Test ModelWrapperBase.__str__ with Chinese
    response = ModelResponse(
        text="中文",
        raw={"text": "中文"},
    )
    str_repr = str(response)
    # The __str__ uses json.dumps, ensure ensure_ascii=False is applied
    if "\\u" in str_repr:
        raise AssertionError(
            f"ModelResponse.__str__ contains escaped Unicode: {str_repr}"
        )

    # Test _chat logging with Chinese
    _chat({"content": "中文消息"})
    # The _chat function logs at LEVEL_CHAT_SAVE, which we capture via our handler
    # Check that the captured log does not contain escaped Unicode
    for log in captured_logs:
        if "\\u" in log and "中文消息" not in log:
