[32mFROM python:3.10-slim AS test_builder

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

WORKDIR /app

COPY . .

# Upgrade pip, setuptools and wheel first
RUN python -m pip install --upgrade pip setuptools wheel

# Check for src layout or imports in tests
RUN set -e; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." autogpt/tests 2>/dev/null; then \
        # src layout detected: install dependencies without editable install to avoid import conflicts, set PYTHONPATH; also install test dependencies unconditionally \
        pip install -r autogpt/requirements.txt 2>/dev/null || true && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai && \
        echo "src layout detected, skipping editable install and setting PYTHONPATH"; \
    else \
        # no src layout: do editable install alongside dependencies and test deps \
        pip install -r autogpt/requirements.txt 2>/dev/null || true && \
        pip install -e autogpt && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

ENV PYTHONPATH=/app

RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests to validate setup (optional in build, but requested)
RUN pytest -v autogpt/tests

