FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set working directory
WORKDIR /app

# Copy entire repository into container
COPY . .

# Upgrade pip, setuptools and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install system build dependencies needed for Python packages
RUN apt-get update \
    && apt-get install -y gcc libxml2-dev libxslt1-dev python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies if requirements.txt exists plus the project itself
# Also install testing dependencies and langchain explicitly (fixing missing 'langchain.callbacks' and 'langchain.schema')
RUN if [ -f "requirements.txt" ]; then pip install -r requirements.txt; fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm langchain

# Set PYTHONPATH environment variable to /app for import convenience
ENV PYTHONPATH=/app

# Set Forge API environment variables to override OpenAI and Anthropic SDK endpoints
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Export Forge API key as environment variable
ENV FORGE_API_KEY=forge-key

# Verify environment sanity
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command must be bash shell for test harness
CMD ["/bin/bash"]
