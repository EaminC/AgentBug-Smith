[32mFROM python:3.11-slim AS test_builder

WORKDIR /app

COPY . .

# Detect src/ layout or src imports in tests for PYTHONPATH usage
RUN set -e; \
    if [ -d "src" ] || grep -RqE '^\s*(from|import) src\.' tests 2>/dev/null; then \
        echo "Using src/ layout or src imports detected"; \
        export USE_SRC_LAYOUT=1; \
    else \
        export USE_SRC_LAYOUT=0; \
    fi; \
    if [ "$USE_SRC_LAYOUT" -eq 1 ]; then \
        python -m pip install --upgrade pip setuptools wheel && \
        pip install -r requirements.txt 2>/dev/null || true && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    else \
        python -m pip install --upgrade pip setuptools wheel && \
        pip install -r requirements.txt 2>/dev/null || true && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# If src layout detected, set PYTHONPATH to /app to avoid import errors in tests
ENV PYTHONPATH=/app

RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests with pytest to verify installation and code correctness
RUN pytest

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Minimal runtime image
FROM python:3.11-slim AS runtime

WORKDIR /app

COPY --from=test_builder /app /app

# Install only production dependencies (no test dependencies)
RUN set -e; \
    python -m pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt 2>/dev/null || true && \
    pip install -e . 

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

CMD ["/bin/bash"][0m
