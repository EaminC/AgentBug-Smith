# --- end inject ---

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set build-time environment variables for the Forge API key
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV MODEL=tensorblock/gpt-4.1-mini
ENV AI_TEMPERATURE=0.7
ENV GITHUB_TOKEN=ghp_key
ENV TAVILY_API_KEY=tvly-key
ENV ANTHROPIC_MODEL=tensorblock/gpt-4.1-mini
ENV ANTHROPIC_SMALL_FAST_MODEL=tensorblock/gpt-4.1-mini

WORKDIR /app

COPY . .

# Install system dependencies required for Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies from requirements.txt and the project itself in one step
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt; \
    else \
      echo "No requirements.txt found, skipping requirements installation."; \
    fi && \
    pip install -e . pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm langchain

# Set PYTHONPATH for imports
ENV PYTHONPATH=/app

# Verify installations
RUN python -c 'import pkg_resources, pytest, langchain; print("preflight ok")'

CMD ["/bin/bash"]
