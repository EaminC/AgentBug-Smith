[32m# Use official Python 3.12 slim base image
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

WORKDIR /app

# Copy entire repository into container
COPY . .

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel

# Install necessary system build dependencies for some Python packages
RUN apt-get update && apt-get install -y gcc libxml2-dev libxslt1-dev python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Detect src/ layout or src imports in tests to decide on PYTHONPATH usage
RUN set -e; \
    if [ -d "src" ] || grep -RqE '^\s*(from|import) src\.' tests 2>/dev/null; then \
        echo "Using src/ layout or src imports detected"; \
        export USE_SRC_LAYOUT=1; \
    else \
        export USE_SRC_LAYOUT=0; \
    fi; \
    if [ "$USE_SRC_LAYOUT" -eq 1 ]; then \
        pip install -r requirements.txt 2>/dev/null || true && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm; \
    else \
        pip install -r requirements.txt 2>/dev/null || true && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm; \
    fi

# If src layout detected, set PYTHONPATH=/app to avoid import errors in tests
ENV PYTHONPATH=/app

# Verify environment sanity
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests to verify installation
RUN pytest

# Set Forge API environment variables for OpenAI and Anthropic SDKs
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Default command must be bash shell for test harness
CMD ["/bin/bash"]
