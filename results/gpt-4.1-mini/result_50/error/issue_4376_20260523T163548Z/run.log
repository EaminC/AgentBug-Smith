ARG PYTHON_VERSION=3.10-slim

# Base image for build and test stage
FROM python:${PYTHON_VERSION} AS test_builder

WORKDIR /app

# Copy entire repo for test build stage
COPY . .

# Detect src layout to decide install method
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
        export PYTHONPATH=/app; \
    else \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests to verify build/test image works
RUN pytest -n auto --cov=autogpt --cov-report term-missing --cov-branch --cov-report xml --cov-report term

# Minimal runtime image with production dependencies only
FROM python:${PYTHON_VERSION} AS runtime

WORKDIR /app

COPY . .

# Install only production dependencies from requirements.txt
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    pip install -r requirements.txt

# Set environment variables for Forge
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=${FORGE_API_KEY} \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY} \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Default command per project config (entry point in README and Dockerfile snippet: python -m autogpt --install-plugin-deps)
CMD ["/bin/bash"][0m
