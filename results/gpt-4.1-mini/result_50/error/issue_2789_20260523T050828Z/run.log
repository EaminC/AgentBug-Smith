# Set working directory
WORKDIR /app

# Copy entire repository
COPY . .

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies needed for Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies if requirements.txt exists, and install the package and test dependencies
RUN set -eux; \
    if [ -f requirements.txt ]; then \
        pip install -r requirements.txt; \
    fi; \
    pip install -e .; \
    pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm mem0ai

# Preflight test to ensure package and pytest are installed correctly
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set environment variables for Forge API compatibility (OpenAI and Anthropic)
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"

# Ensure FORGE_API_KEY is available
ENV FORGE_API_KEY="forge-key"

# Default CMD must be bash shell for test harness
CMD ["/bin/bash"]

