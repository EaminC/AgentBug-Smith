FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set Forge API environment variables for OpenAI and Anthropic compatibility
ENV FORGE_API_KEY="forge-key" \
    OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    MODEL="tensorblock/gpt-4.1-mini" \
    AI_TEMPERATURE="0.7" \
    GITHUB_TOKEN="ghp_key" \
    TAVILY_API_KEY="tvly-key" \
    ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini" \
    ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"

WORKDIR /app

COPY . .

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3-dev gcc libxml2-dev libxslt1-dev libffi-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip
RUN pip install --break-system-packages --no-cache-dir setuptools==81.0.0 wheel==0.47.0

# To avoid PyYAML build failure on Python 3.12, install it separately
RUN if [ -f requirements.txt ]; then \
      grep -vE '^pyyaml==' requirements.txt > requirements-no-pyyaml.txt && \
      pip install --break-system-packages --no-cache-dir -r requirements-no-pyyaml.txt; \
    fi

RUN pip install --break-system-packages --no-cache-dir pyyaml

RUN pip install --break-system-packages --no-cache-dir -e . pytest pytest-mock pytest-xdist pytest-timeout litellm mem0ai

RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

