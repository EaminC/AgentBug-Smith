[32mimport builtins
import io
import pytest
from unittest.mock import patch, MagicMock

import ai


def test_ai_init_sets_model_to_gpt_35_turbo_when_gpt4_unavailable(capsys):
    # Patch openai.Model.retrieve to raise an exception simulating gpt-4 unavailability
    # The patched exception must be a subclass of Exception, since openai.error.InvalidRequestError is missing
    class DummyInvalidRequestError(Exception):
        pass

    def dummy_retrieve(model_name):
        if model_name == "gpt-4":
            raise DummyInvalidRequestError("Model not found")
        return MagicMock()

    with patch.object(ai.openai.Model, "retrieve", side_effect=dummy_retrieve):
        # We patch the AI.__init__ to catch the print output and check if fallback to gpt-3.5-turbo occurs
        instance = ai.AI()
        out, _ = capsys.readouterr()
        assert "reverting to gpt-3.5.turbo" in out or "reverting to gpt-3.5-turbo" in out
        # The kwargs should have model set to gpt-3.5-turbo
        assert instance.kwargs.get("model") == "gpt-3.5-turbo"


def test_ai_start_and_next_methods_work_normally():
    # Patch openai.ChatCompletion.create to simulate streaming response
    def dummy_create(*args, **kwargs):
        class DummyStream:
            def __iter__(self_inner):
                # Simulate streaming chunks of response
                yield {"choices": [{"delta": {"content": "Hello"}}]}
                yield {"choices": [{"delta": {"content": " World"}}]}
                yield {"choices": [{"delta": {}}]}  # End of stream

        return DummyStream()

    with patch.object(ai.openai.ChatCompletion, "create", side_effect=dummy_create):
        instance = ai.AI()
        system_msg = "You are a helpful assistant."
        user_msg = "Hello"

        messages = instance.start(system_msg, user_msg)
        # The returned messages should include the assistant's reply concatenated from stream
        assert isinstance(messages, list)
        assert messages[-1]["role"] == "assistant"
        assert "Hello World" in messages[-1]["content"]


def test_ai_next_appends_assistant_message_correctly():
    # Patch openai.ChatCompletion.create to simulate streaming response
    def dummy_create(*args, **kwargs):
        class DummyStream:
            def __iter__(self_inner):
                yield {"choices": [{"delta": {"content": "Test"}}]}
                yield {"choices": [{"delta": {"content": " message"}}]}
                yield {"choices": [{"delta": {}}]}

        return DummyStream()

    with patch.object(ai.openai.ChatCompletion, "create", side_effect=dummy_create):
        instance = ai.AI()
        messages = [
            {"role": "system", "content": "System message"},
            {"role": "user", "content": "User message"},
        ]
        new_messages = instance.next(messages)
        assert isinstance(new_messages, list)
        assert new_messages[-1]["role"] == "assistant"
        assert new_messages[-1]["content"] == "Test message"
        # Original messages should be preserved in the returned list except the new appended one
        assert new_messages[:-1] == messages


def test_ai_init_does_not_override_model_if_gpt4_available():
    # Patch openai.Model.retrieve to not raise error (simulate gpt-4 available)
    with patch.object(ai.openai.Model, "retrieve", return_value=MagicMock()):
        instance = ai.AI()
        # If gpt-4 is available, model should not be forcibly set to gpt-3.5-turbo
        # It may be unset or something else, but not forced to gpt-3.5-turbo
        assert instance.kwargs.get("model") != "gpt-3.5-turbo"


