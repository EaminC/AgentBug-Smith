[32mimport builtins
import pytest
from unittest.mock import patch, MagicMock
import ai


class DummyInvalidRequestError(Exception):
    pass


class DummyModel:
    @staticmethod
    def retrieve(name):
        if name == "gpt-4":
            raise DummyInvalidRequestError("Model not available")
        return {"id": name}


@pytest.fixture(autouse=True)
def patch_openai(monkeypatch):
    # Patch openai.Model.retrieve to simulate model availability check
    dummy_openai = MagicMock()
    dummy_openai.Model.retrieve = DummyModel.retrieve
    dummy_openai.error.InvalidRequestError = DummyInvalidRequestError

    monkeypatch.setattr(ai, "openai", dummy_openai)
    yield


def test_ai_init_sets_model_to_gpt_35_turbo_when_gpt4_unavailable(capsys):
    # When gpt-4 is not available, AI.__init__ should fallback to gpt-3.5-turbo
    instance = ai.AI()
    # The fallback message should be printed
    captured = capsys.readouterr()
    assert "reverting to gpt-3.5.turbo" in captured.out or "reverting to gpt-3.5-turbo" in captured.out
    # The model in kwargs should be set to gpt-3.5-turbo
    assert instance.kwargs.get("model") == "gpt-3.5-turbo"


def test_ai_init_does_not_override_model_if_gpt4_available(monkeypatch):
    # Patch retrieve to not raise error for gpt-4
    def retrieve_no_error(name):
        return {"id": name}

    monkeypatch.setattr(ai.openai.Model, "retrieve", retrieve_no_error)
    instance = ai.AI()
    # No fallback message printed
    # The model should not be forced to gpt-3.5-turbo by default
    assert instance.kwargs.get("model") != "gpt-3.5-turbo"


def test_ai_start_and_next_methods_work_normally():
    # Basic sanity test for start and next methods
    instance = ai.AI()
    system_msg = "You are a helpful assistant."
    user_msg = "Hello"

    messages = instance.start(system_msg, user_msg)
    # start returns a list of messages with system and user roles
    assert isinstance(messages, list)
    assert messages[0]["role"] == "system"
    assert messages[1]["role"] == "user"
    assert messages[0]["content"] == system_msg
    assert messages[1]["content"] == user_msg

    # Patch openai.chat.completions.create to simulate streaming response
    dummy_response = [
        {"choices": [{"delta": {"content": "Hello"}}]},
        {"choices": [{"delta": {"content": " world"}}]},
        {"choices": [{"delta": {}}]},  # end of stream
    ]

    class DummyStream:
        def __init__(self, responses):
            self._responses = responses
            self._index = 0

        def __iter__(self):
            return self

        def __next__(self):
            if self._index >= len(self._responses):
                raise StopIteration
            resp = self._responses[self._index]
            self._index += 1
            return resp

    def dummy_create(*args, **kwargs):
        return DummyStream(dummy_response)

    with patch.object(ai.openai.chat.completions, "create", dummy_create):
        new_messages = instance.next(messages)
        # The returned messages list should be longer by one with assistant role
        assert len(new_messages) == len(messages) + 1
        assert new_messages[-1]["role"] == "assistant"
        # The content should be concatenated from the dummy response
        assert new_messages[-1]["content"] == "Hello world"[0m
