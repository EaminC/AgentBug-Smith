[32mimport builtins
import pytest
import ai
from unittest import mock
from openai.error import InvalidRequestError


def test_ai_model_fallback_to_gpt35(monkeypatch):
    """
    This test verifies that when openai.Model.retrieve("gpt-4") raises an
    InvalidRequestError, the AI class falls back to using "gpt-3.5-turbo" as
    the model in self.kwargs.
    """

    # Patch openai.Model.retrieve to raise InvalidRequestError when called with "gpt-4"
    def fake_retrieve(model_name):
        if model_name == "gpt-4":
            raise InvalidRequestError("Model not available")
        return None

    # Patch print to capture output
    printed = []
    def fake_print(*args, **kwargs):
        printed.append(args[0] if args else "")

    monkeypatch.setattr(ai.openai.Model, "retrieve", fake_retrieve)
    monkeypatch.setattr(builtins, "print", fake_print)

    # Instantiate AI, which triggers the __init__ logic
    instance = ai.AI()

    # Check that the fallback message was printed
    assert any("reverting to gpt-3.5.turbo" in line for line in printed)

    # Check that the model was set to "gpt-3.5-turbo"
    assert instance.kwargs.get("model") == "gpt-3.5-turbo"


def test_ai_model_no_fallback_if_gpt4_available(monkeypatch):
    """
    This test verifies that if openai.Model.retrieve("gpt-4") does not raise,
    the AI class does not override the model in self.kwargs.
    """

    # Patch openai.Model.retrieve to succeed (return dummy)
    def fake_retrieve(model_name):
        return {"id": model_name}

    monkeypatch.setattr(ai.openai.Model, "retrieve", fake_retrieve)

    # Provide an explicit model to AI constructor to check it remains unchanged
    instance = ai.AI(model="gpt-4")

    # The model should remain as provided, no fallback
    assert instance.kwargs.get("model") == "gpt-4"


def test_ai_start_and_next_basic(monkeypatch):
    """
    Basic sanity test of AI.start and AI.next methods with mocked completions.
    Ensures that the methods run and produce expected message structure.
    """

    # Mock openai.chat.completions.create to yield a dummy delta stream
    class DummyDelta:
        def __init__(self, content):
            self.choices = [{"delta": {"content": content}}]

    def dummy_create(*args, **kwargs):
        # Return an iterable of dummy deltas
        yield DummyDelta("Hello, ")
        yield DummyDelta("world!")

    monkeypatch.setattr(ai.openai.chat.completions, "create", dummy_create)

    instance = ai.AI(model="gpt-3.5-turbo")

    system_msg = "You are a helpful assistant."
    user_msg = "Say hello."

    messages = instance.start(system_msg, user_msg)
    assert isinstance(messages, list)
    assert messages[0]["role"] == "system"
    assert messages[1]["role"] == "user"
    assert messages[0]["content"] == system_msg
    assert messages[1]["content"] == user_msg

    # Call next with the messages from start
    new_messages = instance.next(messages)
    assert isinstance(new_messages, list)
    # The last message should be from assistant with concatenated content
    assert new_messages[-1]["role"] == "assistant"
    assert new_messages[-1]["content"] == "Hello, world!"

    # The new_messages list should be longer than the input messages
    assert len(new_messages) == len(messages) + 1


if __name__ == "__main__":
    pytest.main([__file__])[0m
