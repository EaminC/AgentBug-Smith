RUN pip install -e ./lib/crewai && pip install -e ./lib/crewai-tools

# Install test dependencies
RUN pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm

# Set PYTHONPATH to include src folders for proper imports
ENV PYTHONPATH=/app/lib/crewai/src:/app/lib/crewai-tools/src

# Verify install
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]
