[32mFROM python:3.11-slim AS test_builder

WORKDIR /app

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Copy entire repo to preserve injected tests and scripts
COPY . .

# Detect src/ layout or tests importing src. to decide install strategy
RUN set -eux; \
    # Upgrade core packaging tools early to avoid import-time failures
    python -m pip install --upgrade pip setuptools wheel; \
    # Check for src/ directory or imports in tests matching src.
    if [ -d "src" ] || grep -Rq '^\s*from src\.|^\s*import src\.' tests 2>/dev/null; then \
        # src/ layout detected - do not editable install to avoid duplicate imports
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-vcr anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai embedchain langchain-community "langchain<0.3.0"; \
        export PYTHONPATH=/app; \
    else \
        # No src/ layout - safe to editable install local package
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-vcr anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai embedchain langchain-community "langchain<0.3.0"; \
    fi

# Preflight import check for core modules to fail fast if broken
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests to verify installation and code integrity
RUN pytest

# Build minimal runtime image
FROM python:3.11-slim AS runtime

WORKDIR /app

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

COPY . .

# Install only production dependencies and local package (no test dependencies)
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt 2>/dev/null || true && \
    pip install -e .

