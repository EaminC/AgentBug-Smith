[32mFROM python:3.10-slim AS test_builder

WORKDIR /app

# Copy entire repository
COPY . .

# Detect src/ layout or tests importing src.*
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        echo "Detected src/ layout or tests import src.*; setting PYTHONPATH and skipping editable install"; \
        export PYTHONPATH=/app; \
    fi

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Install dependencies and test tooling conditionally based on files
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt && pip install -e .; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry; \
        poetry config virtualenvs.create false; \
        poetry install --no-interaction --no-ansi; \
        pip install -e .; \
    elif [ -f "pyproject.toml" ]; then \
        pip install -e .; \
    else \
        echo "No recognized Python dependency files found, skipping project install"; \
    fi; \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout

# Preflight to fail fast if core modules missing
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

# Run tests to verify (optional, but per instructions we must run the standard test runner)
# Assumption: tests exist and can be run by pytest
RUN pytest tests || (echo "Tests failed" && exit 1)


FROM python:3.10-slim AS runtime

WORKDIR /app

COPY --from=test_builder /app /app

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Install production dependencies only
