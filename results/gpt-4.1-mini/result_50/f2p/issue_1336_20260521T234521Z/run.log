FROM python:3.12-slim AS builder

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

WORKDIR /app

# Copy entire repository
COPY . .

# Set environment variables for Forge API (OpenAI and Anthropic compatible)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Install system dependencies for Python packages that may need build tools
RUN set -eux; \
    apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and tools first
RUN python -m pip install --upgrade pip setuptools wheel

# Determine project layout for install method
RUN set -eux; \
    # If src/ directory exists OR tests import src.*, set PYTHONPATH and skip editable install
    if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." tests 2>/dev/null; then \
        echo "Detected src/ layout or tests import src.*; setting PYTHONPATH=/app and skipping pip editable install"; \
        echo "export PYTHONPATH=/app" >> /etc/profile; \
        export PYTHONPATH=/app; \
        if [ -f "requirements.txt" ]; then \
            pip install -r requirements.txt; \
        elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
            pip install poetry; \
            poetry config virtualenvs.create false; \
            poetry install --no-interaction --no-ansi; \
        elif [ -f "pyproject.toml" ]; then \
            pip install .; \
        else \
            echo "No recognized Python dependency files found, skipping install"; \
        fi; \
    else \
        # No src/ layout detected, do pip install -e . to enable editable install
        if [ -f "requirements.txt" ]; then \
            pip install -r requirements.txt && pip install -e .; \
        elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
            pip install poetry; \
            poetry config virtualenvs.create false; \
            poetry install --no-interaction --no-ansi; \
            pip install -e .; \
        elif [ -f "pyproject.toml" ]; then \
            pip install -e .; \
        else \
            echo "No recognized Python dependency files found, skipping editable install"; \
        fi; \
    fi; \
    # Install test dependencies unconditionally
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout

# Preflight script to verify installation
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

# Run tests to verify setup
RUN pytest tests || (echo "Tests failed" && exit 1)


FROM python:3.12-slim AS runtime

WORKDIR /app

# Copy full app from builder
COPY --from=builder /app /app

# Set environment variables again in runtime
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Install production dependencies only
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
