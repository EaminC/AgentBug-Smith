WORKDIR /app

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Detect src/ layout or src imports to decide editable install or PYTHONPATH usage
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        echo "Detected src/ layout or src imports, setting PYTHONPATH"; \
        echo "ENV PYTHONPATH=/app" >> Dockerfile.tmp; \
    else \
        echo "No src/ layout detected"; \
    fi

RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies and test tools based on pyproject.toml presence (requirements.txt not found)
RUN set -eux; \
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt && pip install -e .; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry && poetry config virtualenvs.create false && poetry install --no-interaction --no-ansi && pip install -e .; \
    elif [ -f "pyproject.toml" ]; then \
        pip install -e .; \
    else \
        echo "No recognized Python dependency file found, skipping pip install -e ."; \
    fi && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Apply PYTHONPATH env if detected earlier
RUN if grep -q "ENV PYTHONPATH=/app" Dockerfile.tmp 2>/dev/null; then \
        echo "Setting PYTHONPATH environment variable"; \
        echo "ENV PYTHONPATH=/app" >> Dockerfile.tmp; \
    fi

# Append PYTHONPATH env if applicable
RUN if [ -f Dockerfile.tmp ]; then cat Dockerfile.tmp >> Dockerfile && rm Dockerfile.tmp; fi

# Preflight import check to fail fast on missing modules
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Assumption: main.py is at src/my_project/main.py as per project layout and is the entrypoint
CMD ["/bin/bash"][0m
