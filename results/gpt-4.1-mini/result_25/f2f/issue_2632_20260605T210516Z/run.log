[32mimport asyncio
from concurrent.futures import ThreadPoolExecutor, as_completed
import pytest

from src.crewai.crews import Crew
from src.crewai.agents import Agent


class DummyAgent(Agent):
    def __init__(self):
        super().__init__(name="dummy-agent")

    def crew(self):
        # Return a crew with a single dummy agent that echoes inputs
        crew = Crew(agents=[self])
        return crew

    def kickoff(self, inputs):
        # Synchronous kickoff returns a simple response dict
        return {"response": f"echo: {inputs}"}

    async def kickoff_async(self, inputs):
        # Async kickoff returns a simple response dict
        return {"response": f"echo: {inputs}"}


def generate_response(payload):
    try:
        agent = DummyAgent()
        output = agent.crew().kickoff(inputs=payload["inputs"])
    except Exception:
        output = None
    return output


async def generate_response_async(payload, sem):
    async with sem:
        try:
            agent = DummyAgent()
            output = await agent.crew().kickoff_async(inputs=payload["inputs"])
        except Exception:
            output = None
        return output


@pytest.mark.timeout(30)
def test_concurrent_threaded_requests_do_not_crash():
    # Prepare multiple payloads
    payloads = [{"inputs": f"test input {i}"} for i in range(10)]
    results = []

    with ThreadPoolExecutor(max_workers=5) as executor:
        futures = [executor.submit(generate_response, payload) for payload in payloads]

        for future in as_completed(futures):
            result = future.result()
            results.append(result)

    # Assert all results are not None and contain expected keys
    assert len(results) == len(payloads)
    for i, res in enumerate(results):
        assert res is not None
        assert "response" in res
        assert res["response"] == f"echo: test input {i}"


@pytest.mark.asyncio
@pytest.mark.timeout(30)
async def test_concurrent_asyncio_requests_do_not_crash():
    payloads = [{"inputs": f"async test input {i}"} for i in range(10)]
    sem = asyncio.Semaphore(5)

    tasks = [generate_response_async(payload, sem) for payload in payloads]
    results = await asyncio.gather(*tasks)

    assert len(results) == len(payloads)
    for i, res in enumerate(results):
        assert res is not None
        assert "response" in res
        assert res["response"] == f"echo: async test input {i}"[0m
