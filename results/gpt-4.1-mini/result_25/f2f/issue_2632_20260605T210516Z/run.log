[32mimport asyncio
from concurrent.futures import ThreadPoolExecutor, as_completed

import pytest

from src.crewai.agent import MyAgent


def test_concurrent_threaded_crew_kickoff():
    """
    Test that running multiple crew kickoff calls concurrently using ThreadPoolExecutor
    does not cause segmentation faults or crashes and returns valid outputs.
    This test is expected to fail (crash) on the buggy codebase and pass after the fix.
    """
    payloads = [
        {"inputs": {"query": f"Hello from thread {i}"}}
        for i in range(10)
    ]

    def generate_response(payload: dict):
        try:
            output = MyAgent().crew().kickoff(inputs=payload["inputs"])
        except Exception:
            output = None
        return output

    results = []
    with ThreadPoolExecutor(max_workers=5) as executor:
        futures = [executor.submit(generate_response, payload) for payload in payloads]
        for future in as_completed(futures):
            result = future.result()
            results.append(result)

    # Assert all results are not None and are strings (or dicts) indicating valid output
    assert len(results) == len(payloads)
    for res in results:
        assert res is not None
        # The output type depends on crew().kickoff implementation, check for str or dict
        assert isinstance(res, (str, dict))


@pytest.mark.asyncio
async def test_concurrent_asyncio_crew_kickoff_async():
    """
    Test that running multiple crew kickoff_async calls concurrently using asyncio
    does not cause segmentation faults or crashes and returns valid outputs.
    This test is expected to fail (crash) on the buggy codebase and pass after the fix.
    """
    sem = asyncio.Semaphore(5)
    payloads = [
        {"inputs": {"query": f"Hello from async {i}"}}
        for i in range(10)
    ]

    async def generate_response(payload: dict):
        async with sem:
            try:
                output = await MyAgent().crew().kickoff_async(inputs=payload["inputs"])
            except Exception:
                output = None
            return output

    tasks = [generate_response(payload) for payload in payloads]
    results = await asyncio.gather(*tasks)

    assert len(results) == len(payloads)
    for res in results:
        assert res is not None
        assert isinstance(res, (str, dict))[0m
