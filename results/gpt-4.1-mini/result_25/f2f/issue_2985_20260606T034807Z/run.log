from crewai.memory.storage.mem0_storage import Mem0Storage
from crewai.memory.external_memory import ExternalMemory


@pytest.mark.asyncio
async def test_mem0_external_memory_addition():
    # Setup external memory with mem0 provider and user_id "deck"
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    # Define a simple agent function
    from crewai.agent import agent

    @agent
    async def simple_agent(input_text: str) -> str:
        return "response to " + input_text

    # Create a crew with the external memory and memory enabled
    crew = Crew(
        agents=[simple_agent],
        tasks=[],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Check that the storage used is Mem0Storage
    storage = crew.memory.storage
    assert isinstance(storage, Mem0Storage)

    # The agent name should be sanitized and not exceed max length
    agent_name = storage._get_agent_name()
    assert isinstance(agent_name, str)
    assert len(agent_name) <= MAX_AGENT_ID_LENGTH_MEM0

    # Add a memory item asynchronously
    # The add method expects a list of items, so test with a list
    memory_item = {"key": "value"}
    try:
        await crew.memory.add([memory_item])
    except Exception as e:
        pytest.fail(f"Adding memory raised an exception: {e}")

    # Retrieve memories to verify addition works (should not raise)
    try:
        results = await crew.memory.search(query="key", limit=1)
    except Exception as e:
        pytest.fail(f"Searching memory raised an exception: {e}")

    # The results should be a list (even if empty)
    assert isinstance(results, list)


def test_sanitize_collection_name_length():
    # Test that sanitize_collection_name truncates correctly with max_collection_length
    long_name = "a" * (MAX_AGENT_ID_LENGTH_MEM0 + 10)
    sanitized = sanitize_collection_name(long_name, max_collection_length=MAX_AGENT_ID_LENGTH_MEM0)
    assert len(sanitized) <= MAX_AGENT_ID_LENGTH_MEM0
    assert sanitized.isalnum() or sanitized[-1].isalnum()  # last char should be alnum after sanitization[0m
