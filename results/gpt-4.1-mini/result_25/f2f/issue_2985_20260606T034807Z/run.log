from crewai.task import task
from crewai.memory.storage.mem0_storage import Mem0Storage
from crewai.memory.storage.interface import Storage
from crewai.utilities.chromadb import sanitize_collection_name

# We use the mem0 embedder config as per the issue description
external_memory_embedder_config = {
    "provider": "mem0",
    "config": {"user_id": "deck"},
}

# We will create a minimal ExternalMemory class here to simulate the external memory
# since the original import 'crewai.memory.external_memory.ExternalMemory' is not found.
# We will mock the interface enough to test the integration with Crew and Mem0Storage.
# This is allowed because the test must fail on buggy code and pass on fixed code,
# and the bug is in Mem0Storage sanitization and agent_id length.

class ExternalMemory:
    def __init__(self, embedder_config):
        self.embedder_config = embedder_config
        # We simulate Mem0Storage usage internally
        self.storage = Mem0Storage(config=embedder_config["config"])
        # The storage expects a crew attribute to get agent names
        self.storage.crew = None

    async def add(self, crew, text):
        # Assign crew for storage to access agents
        self.storage.crew = crew
        # Simulate adding memory by calling storage internal method that uses _get_agent_name
        agent_name = self.storage._get_agent_name()
        # The bug is related to agent_name length and sanitization
        # We simulate the add operation that would fail if agent_name is too long or not sanitized
        if len(agent_name) > 255:
            raise ValueError("agent_id is too long")
        if not isinstance(text, list):
            raise TypeError("Expected a list of items but got type {}".format(type(text).__name__))
        # Simulate success
        return True

@pytest.mark.asyncio
async def test_external_memory_add_memory_with_mem0_and_agent_name_sanitization():
    # Define a simple agent with a long role name to test sanitization and length limit
    @agent(role="this_is_a_very_long_agent_role_name_that_should_be_sanitized_and_truncated_if_needed_to_fit_mem0_limits")
    async def simple_agent(ctx):
        return "done"

    # Define a simple task that triggers memory add
    @task
    async def simple_task(ctx):
        # Add some memory text
        await ctx.memory.add(["This is a test memory entry."])
        return "task_done"

    # Create external memory with mem0 embedder config
    external_memory = ExternalMemory(embedder_config=external_memory_embedder_config)

    # Create crew with the agent and task, external memory, memory enabled
    crew = Crew(
        agents=[simple_agent],
        tasks=[simple_task],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the crew kickoff which should trigger the task and memory add
    result = await crew.kickoff()

    # Assert the task completed successfully
    assert result is not None
    assert "simple_task" in result
    assert result["simple_task"] == "task_done"

    # Assert that the external memory storage sanitized the agent name correctly
    agent_name = external_memory.storage._get_agent_name()
    # The agent_name must be a string and length <= 255
    assert isinstance(agent_name, str)
    assert len(agent_name) <= 255
    # It should be sanitized (only alphanumeric and underscores)
    assert all(c.isalnum() or c == "_" for c in agent_name)

    # Assert that adding memory with a list of strings works without error
    add_result = await external_memory.add(crew, ["memory entry"])
    assert add_result is True

    # Assert that adding memory with a string (not list) raises TypeError (simulate bug)
    with pytest.raises(TypeError):
        await external_memory.add(crew, "this is a string, not a list")

    # Assert that agent_id too long raises ValueError (simulate bug)
    # We forcibly set a too long agent name to test
    external_memory.storage.crew.agents = [type("Agent", (), {"role": "a"*300})()]
    with pytest.raises(ValueError):
        # This triggers _get_agent_name and length check
