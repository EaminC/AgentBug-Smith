[32mimport pytest
import time

from crewai.memory import ExternalMemory
from crewai.crew import Crew
from crewai.process import Process


def test_mem0_external_memory_adds_memories_correctly():
    """
    This test verifies that when using Mem0 as external memory in a Crew,
    adding memories works without errors and the memories are actually stored.

    Buggy behavior:
        Adding a memory to mem0 external memory fails with:
        {"messages":["Expected a list of items but got type \"str\"."],"agent_id":["agent_id is too long. Maximum length allowed is 255 characters."]}

    Fixed behavior:
        Memories are added successfully without errors.
    """

    # Setup external memory with mem0 provider and a short user_id to avoid agent_id length issues
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"},
        }
    )

    # Define a simple agent for the crew
    from crewai.agent import agent

    @agent
    def simple_agent():
        return "Hello from simple agent"

    # Create a crew with the external memory enabled
    crew = Crew(
        agents=[simple_agent],
        tasks=[],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Add a memory entry via the crew's memory interface
    # The memory interface should delegate to the external memory (mem0)
    test_memory_text = "This is a test memory entry for mem0 external memory."

    # Add memory via crew.memory.add (should internally call external memory add)
    # We expect no exceptions and the memory to be stored
    try:
        crew.memory.add(test_memory_text)
    except Exception as e:
        pytest.fail(f"Adding memory to mem0 external memory raised an exception: {e}")

    # Wait briefly to allow async or eventual consistency if any (mem0 client may be async)
    time.sleep(1)

    # Retrieve memories from external memory to verify the added memory is present
    # Use a query that should match the added memory text
    results = crew.memory.search(test_memory_text, limit=5)

    # Assert that at least one result contains the test memory text
    found = any(test_memory_text in item.document for item in results)
    assert found, "Added memory not found in mem0 external memory search results"


# Run this test with `pytest tests/agentsmith_fail2pass_2985.py` inside the repo environment.
# On buggy codebase, this test should fail due to the error described in the issue.
# After applying the fix, this test should pass successfully.[0m
