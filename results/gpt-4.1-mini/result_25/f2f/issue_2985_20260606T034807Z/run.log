[32mimport pytest
import asyncio
from crewai.crew import Crew
from crewai.agent import agent
from crewai.process import Process
from crewai.memory.storage.mem0_storage import Mem0Storage
from crewai.memory import ExternalMemory


@pytest.mark.asyncio
async def test_mem0_external_memory_addition():
    """
    This test verifies that when using Mem0 as external memory in a Crew,
    adding a memory item does not raise errors related to agent_id length
    or message format. This reproduces the bug where adding memories failed
    due to invalid agent_id length and message type errors.

    The test creates a Crew with an ExternalMemory configured for mem0,
    runs a simple agent that adds a memory entry, and asserts that the
    memory contains the added item.

    On the buggy codebase, this test should fail with an error about
    "Expected a list of items but got type 'str'" or "agent_id is too long".
    After the fix, the test should pass.
    """

    # Define a simple agent that adds a memory entry
    @agent
    async def simple_agent(ctx):
        # Add a memory entry to external memory
        # The bug was triggered during add, so we test that add works
        await ctx.memory.add("test memory entry")
        return "done"

    # Setup external memory with mem0 provider and user_id "deck"
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    # Create a Crew with the agent and external memory enabled
    crew = Crew(
        agents=[simple_agent],
        tasks=[],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the crew kickoff to trigger the agent and memory add
    results = await crew.kickoff()

    # Assert the agent ran and returned expected output
    assert results is not None
    assert simple_agent.__name__ in results
    assert results[simple_agent.__name__] == "done"

    # Assert that the external memory has at least one item added
    # We access the mem0 storage directly to verify the memory content
    mem_storage = None
    for mem in crew.memory.storages:
        if isinstance(mem, Mem0Storage):
            mem_storage = mem
            break
    assert mem_storage is not None, "Mem0Storage not found in crew memory storages"

    # Retrieve stored memories for the agent collection
    agent_collection_name = mem_storage._get_agent_name()
    stored_items = await mem_storage.retrieve(query="test", limit=10)

    # The stored_items should include the added memory entry text
    # Since the bug was about adding, we expect at least one item
    assert stored_items is not None
    assert len(stored_items) > 0
    # Check that the text "test memory entry" is in one of the retrieved items
    found = any("test memory entry" in item.get("text", "") for item in stored_items)
    assert found, "Added memory entry not found in Mem0 storage retrieval"[0m
