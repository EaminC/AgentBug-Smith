[32mimport pytest
import time

from crewai.agent import Agent
from crewai.crew import Crew
from crewai.memory.external_memory import ExternalMemory
from crewai.process import Process


def test_mem0_external_memory_add_and_retrieve():
    """
    This test verifies that when using Mem0 as external memory in a Crew,
    adding a memory item works without error and the item can be retrieved.

    On the buggy codebase, this test should fail with an error related to
    "Expected a list of items but got type 'str'" or agent_id length issues.

    After applying the fix, the test should pass successfully.
    """

    # Setup external memory with mem0 provider and user_id "deck"
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    # Define a simple agent that adds a memory item during its execution
    class SimpleAgent(Agent):
        def run(self, **kwargs):
            # Add a memory item to external memory
            memory_text = "Test memory item for mem0 external memory"
            # Add memory using the crew's memory interface
            self.crew.memory.add(memory_text)
            # Return the memory text as output for verification
            return memory_text

    # Create a crew with the SimpleAgent, enable memory and external memory
    crew = Crew(
        agents=[SimpleAgent],
        tasks=[],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the crew kickoff to trigger the agent and memory addition
    result = crew.kickoff()

    # The result should contain the memory text added by the agent
    assert result is not None
    assert isinstance(result, dict)
    # The SimpleAgent's run output should match the memory text
    agent_outputs = list(result.values())
    assert any("Test memory item for mem0 external memory" in str(output) for output in agent_outputs)

    # Wait briefly to allow memory indexing if asynchronous
    time.sleep(1)

    # Now test retrieval from external memory to verify the memory was added
    retrieved = crew.memory.search("Test memory item for mem0 external memory", limit=1)
    assert retrieved is not None
    assert isinstance(retrieved, list)
    assert len(retrieved) > 0
    # The retrieved memory text should contain the original text
    assert any("Test memory item for mem0 external memory" in item for item in retrieved)[0m
