[32mimport pytest
import time

from crewai.agent import Agent
from crewai.crew import Crew
from crewai.memory.external_memory import ExternalMemory
from crewai.process import Process


@pytest.mark.integration
def test_mem0_external_memory_addition():
    """
    This test verifies that adding memories to a Crew with external memory configured
    using mem0 provider succeeds without errors and that memories are actually stored.

    Buggy behavior: Adding memory fails with API request errors about expected list and agent_id length.
    Fixed behavior: Adding memory succeeds without errors.
    """

    # Define a simple agent that adds a memory when run
    class TestAgent(Agent):
        def run(self):
            # Add a memory entry
            self.memory.add("test_key", "test_value")
            # Retrieve it back to verify
            retrieved = self.memory.get("test_key")
            return retrieved

    # Setup external memory with mem0 provider and user_id "deck"
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"},
        }
    )

    # Create a Crew with the TestAgent and external memory enabled
    crew = Crew(
        agents=[TestAgent],
        tasks=[],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the crew to trigger agent execution and memory addition
    results = crew.run()

    # The TestAgent returns the retrieved memory value, it should be "test_value"
    # Check that the memory was added and retrieved correctly
    assert results, "Crew run returned no results"
    agent_result = results[0]
    assert agent_result == "test_value", f"Expected memory value 'test_value', got {agent_result}"

    # Additional check: the external memory should not raise errors on add
    # This is implicitly tested by the above run not raising exceptions


if __name__ == "__main__":
    # Run the test standalone if executed directly
    pytest.main([__file__])[0m
