[32mimport pytest
import time

from crewai.crew import Crew
from crewai.agent import Agent
from crewai.task import Task
from crewai.process import Process
from crewai.memory.external import ExternalMemory


@pytest.mark.timeout(30)
def test_mem0_external_memory_add():
    """
    Test that adding memories to an external Mem0 memory works correctly without errors.
    This test reproduces the bug where adding a memory to Mem0 external memory fails due to
    incorrect agent_id length and message format.

    Steps:
    - Create an ExternalMemory with mem0 provider and short user_id.
    - Create a Crew with that external memory and memory enabled.
    - Define a simple agent that adds a memory entry.
    - Run the crew kickoff and verify no exceptions occur.
    """

    # Setup external memory with Mem0 provider and a short user_id
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    # Define a simple agent that adds a memory entry
    class EchoAgent(Agent):
        def __init__(self):
            super().__init__(name="echo")

        @Task
        def echo(self, message: str) -> str:
            # Add the message to memory explicitly
            self.memory.add_memory(text=message)
            return message

    # Create crew with the agent and external memory
    crew = Crew(
        agents=[EchoAgent()],
        tasks=[],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the crew kickoff with a simple input to trigger memory add
    result = crew.kickoff(inputs={"message": "hello world"})

    # The result should contain the echoed message
    assert "echo" in result
    assert "hello world" in result["echo"]

    # Wait a moment to allow memory add to propagate if async
    time.sleep(1)

    # Check that memory contains the added message (if accessible)
    # This is a best effort check; the main test is no exception on add
    mem_texts = []
    if crew.memory and hasattr(crew.memory, "search"):
        search_results = crew.memory.search(query="hello", limit=5)
        mem_texts = [item.text for item in search_results]
    assert any("hello world" in text for text in mem_texts) or mem_texts == []  # mem_texts may be empty if not retrievable


