[32mimport pytest
import asyncio

from crewai.crew import Crew
from crewai.agent import agent, task
from crewai.memory.external_memory import ExternalMemory
from crewai.memory.storage.mem0_storage import Mem0Storage


@pytest.mark.asyncio
async def test_mem0_external_memory_add():
    """
    Test that adding memories to an external Mem0 memory works correctly without errors.
    This test reproduces the bug where adding a memory to Mem0 external memory fails due to
    incorrect agent_id length and message format.

    The test defines a simple Crew with an external Mem0 memory and an agent that adds a memory entry.
    It asserts that no exceptions occur during the crew kickoff and that the memory contains the added entry.
    """

    # Setup external memory with Mem0 provider and a short user_id
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    # Define a simple echo agent that adds a memory entry
    @agent
    class EchoAgent:
        def __init__(self):
            self.name = "echo"

        @task
        async def echo_task(self, inputs):
            # Add a memory entry with a short text
            await self.memory.add("Hello from EchoAgent")
            return "done"

    # Create the crew with the external memory and the echo agent
    crew = Crew(
        agents=[EchoAgent()],
        tasks=[],
        process="sequential",
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the crew kickoff and ensure no exceptions
    result = await crew.kickoff()

    # The result should be a dict with the task output "done"
    assert isinstance(result, dict)
    # The echo_task output should be "done"
    assert any(value == "done" for value in result.values())

    # Check that the external memory has stored the added memory
    # We access the Mem0Storage instance from the external_memory
    mem_storage = external_memory._storage
    assert isinstance(mem_storage, Mem0Storage)

    # Retrieve stored memories (should contain the added text)
    stored_memories = await mem_storage.retrieve()
    # The stored memories should include the string we added
    found = any("Hello from EchoAgent" in str(item) for item in stored_memories)
    assert found, "Memory entry was not added to external Mem0 memory"[0m
