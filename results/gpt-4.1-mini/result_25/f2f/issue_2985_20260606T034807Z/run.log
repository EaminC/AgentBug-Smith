[32mimport pytest
import time
from crewai import Crew, Process
from crewai.memory.external_memory import ExternalMemory
from crewai.agent import Agent


def test_mem0_external_memory_adds_memory_correctly():
    """
    This test verifies that when using mem0 as external memory in a Crew,
    adding memories does not fail due to agent_id length or message type errors.
    It reproduces the bug by adding an external memory configured for mem0,
    creating a crew with that external memory, running a simple agent that adds
    a memory, and asserting that the memory was added without error.
    """

    # Setup external memory with mem0 provider and user_id "deck"
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"},
        }
    )

    # Define a simple agent that adds a memory entry during execution
    class TestAgent(Agent):
        role = "test_agent"

        async def run(self):
            # Add a memory entry to external memory
            # We add a simple string to trigger the bug if it exists
            await self.memory.add("test memory entry")
            return "done"

    # Create a crew with the external memory and the test agent
    crew = Crew(
        agents=[TestAgent],
        tasks=[],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the crew kickoff and capture results
    # The bug causes an exception or error when adding memory
    try:
        result = crew.kickoff()
        # kickoff returns a dict with agent results keyed by agent role
        assert "test_agent" in result
        assert result["test_agent"] == "done"
    except Exception as e:
        pytest.fail(f"Adding memory to mem0 external memory failed: {e}")

    # Additionally, check that the external memory contains the added memory
    # This requires accessing the external memory storage directly
    # We check that the memory store is not empty or that no error was raised
    # (The bug was about failure to add memory, so absence of error is success)


if __name__ == "__main__":
    # Run the test standalone
    pytest.main([__file__])[0m
