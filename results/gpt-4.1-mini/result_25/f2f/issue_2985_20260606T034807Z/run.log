[32mimport pytest
import time

from crewai.crew import Crew, Process
from crewai.memory.storage.mem0_storage import Mem0Storage
from crewai.memory.external_memory import ExternalMemory


def test_mem0_external_memory_adds_memories_correctly():
    """
    This test verifies that when using Mem0 as an external memory provider,
    adding a memory entry to the Crew's memory does not cause errors related
    to agent_id length or message type.

    It fails on the buggy codebase due to:
    - agent_id length exceeding 255 characters
    - messages expected as a list but got a string

    After applying the fix, the test should pass.
    """

    # Setup external memory with mem0 provider and user_id "deck"
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    # Define a simple agent that just echoes input
    from crewai.agent import agent

    @agent(role="echo")
    def echo_agent(input_text: str) -> str:
        return input_text

    # Create a Crew with the external memory and memory enabled
    crew = Crew(
        agents=[echo_agent],
        tasks=[],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Add a memory entry via the crew's memory interface
    # We add a simple text string as memory content
    test_memory_content = "This is a test memory entry."

    # The add method is async, so we run it in an event loop
    import asyncio

    async def add_memory():
        # Add memory to the crew's memory
        await crew.memory.add(test_memory_content)

        # Retrieve memories to verify it was added
        results = await crew.memory.search(test_memory_content, limit=1)
        return results

    results = asyncio.run(add_memory())

    # Assert that the memory was added and retrieved correctly
    assert results is not None, "Memory search returned None"
    assert len(results) > 0, "No memories found after adding"
    # The retrieved memory content should contain the test string
    found = any(test_memory_content in r.get("text", "") for r in results)
    assert found, "Added memory content not found in search results"


if __name__ == "__main__":
    pytest.main([__file__])[0m
