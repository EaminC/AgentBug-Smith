[32mimport pytest
import asyncio
from crewai.crew import Crew
from crewai.process import Process
from crewai.agent import agent
from crewai.task import task
from crewai.memory.storage.mem0_storage import Mem0Storage
from crewai.memory.storage.interface import Storage
from crewai.utilities.chromadb import sanitize_collection_name

# We cannot import ExternalMemory because it does not exist as a separate module,
# but we can simulate the external memory config with the mem0 config as per the issue description.

# This test aims to reproduce the bug where adding memories to mem0 external memory fails due to
# incorrect agent_id length or message format, and after the fix, it should pass.

@pytest.mark.asyncio
async def test_mem0_external_memory_add_memory(monkeypatch):
    """
    Test that adding a memory to mem0 external memory works correctly.
    This test fails on buggy code due to agent_id length and message format issues,
    and passes after the fix that sanitizes the agent_id and message format.
    """

    # Define a simple agent that will add a memory
    @agent
    class EchoAgent:
        async def run(self, inputs):
            # The agent just returns the input text as output
            return inputs["text"]

    # Define a simple task that calls the agent
    @task
    async def echo_task(text: str) -> str:
        return await EchoAgent.run({"text": text})

    # Setup external memory config as mem0 with user_id "deck"
    external_memory_config = {
        "provider": "mem0",
        "config": {"user_id": "deck"}
    }

    # Create the Crew with external_memory enabled and memory=True to enable memory usage
    crew = Crew(
        agents=[EchoAgent],
        tasks=[echo_task],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory_config,
    )

    # We patch the _get_agent_name method of Mem0Storage to test the sanitization effect
    # We want to verify that the agent_id is sanitized and does not exceed 255 characters
    # This indirectly tests the fix in mem0_storage.py

    # Create a Mem0Storage instance with a dummy crew having long agent roles
    class DummyAgent:
        def __init__(self, role):
            self.role = role

    long_role = "a" * 300
    dummy_crew = type("DummyCrew", (), {})()
    dummy_crew.agents = [DummyAgent(long_role), DummyAgent(long_role)]
    mem0_storage = Mem0Storage.__new__(Mem0Storage)
    mem0_storage.crew = dummy_crew

    # Call _get_agent_name and verify length and sanitization
    agent_name = mem0_storage._get_agent_name()
    assert isinstance(agent_name, str)
    assert len(agent_name) <= 255  # The fix truncates to max length 255
    # The sanitized name should not contain invalid characters (only alphanumeric and underscores)
    assert all(c.isalnum() or c == "_" for c in agent_name)

    # Now test adding a memory via the crew interface
    # We run the echo_task which should add memory to external memory without error

    # Run the task with some text input
    result = await crew.run(echo_task, text="Hello world")

    # The result should be the echoed text
    assert result == "Hello world"

    # If the bug is present, adding memory to external memory fails and raises an error or returns None
    # So we assert that the result is correct and no exceptions are raised

    # Additionally, test that the crew's memory interface can add and retrieve memories
    # We add a memory explicitly and then retrieve it

    # Add a memory item (simulate)
    mem_storage = None
    for mem in crew.memory._storages:
        if isinstance(mem, Storage) and mem.__class__.__name__ == "Mem0Storage":
            mem_storage = mem
            break

    if mem_storage is not None:
        # Add a memory item
        await mem_storage.add_memory("test memory item")

        # Retrieve memories and check the added item is present
        memories = await mem_storage.retrieve_memory("test")
        assert any("test memory item" in mem for mem in memories)

# This test requires the real Mem0Storage and Crew implementation to run and fail/pass accordingly.
# It does not mock the internal client calls, so it will fail on buggy code due to API errors,
# and pass on fixed code after sanitization and length truncation fixes.[0m
