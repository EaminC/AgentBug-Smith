[32mimport pytest
import time

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew
from crewai.process import Process
from crewai.memory import ExternalMemory


@pytest.mark.asyncio
async def test_mem0_external_memory_add():
    """
    Test that adding memories to an external Mem0 memory works correctly without errors.
    This test reproduces the bug where adding a memory to Mem0 external memory fails due to
    incorrect agent_id length and message format.

    Steps:
    - Create an ExternalMemory with mem0 provider and a short user_id.
    - Create a Crew with one Agent that adds a memory entry.
    - Run the Crew kickoff to trigger memory addition.
    - Assert no exceptions and that memory add was attempted.
    """

    # Setup external memory with Mem0 provider and a short user_id
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    # Define a simple echo agent that adds a memory entry
    class EchoAgent(Agent):
        def __init__(self):
            super().__init__()
            self.name = "echo"

        @Task
        async def echo(self, input_text: str) -> str:
            # Add a memory entry to external memory
            if self.crew.memory:
                await self.crew.memory.add(
                    agent_id=self.name,
                    items=[{"text": input_text, "metadata": {"source": "test"}}]
                )
            return input_text

    # Create Crew with the EchoAgent and external memory enabled
    crew = Crew(
        agents=[EchoAgent()],
        tasks=[],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run kickoff with input to trigger memory add
    result = await crew.kickoff(inputs={"input_text": "hello world"})

    # Check result is as expected
    assert "echo" in result
    assert result["echo"] == "hello world"

    # Sleep briefly to allow async memory add to complete if needed
    time.sleep(0.5)

    # If no exceptions raised, test passes (bug was an exception on add)
    assert True[0m
