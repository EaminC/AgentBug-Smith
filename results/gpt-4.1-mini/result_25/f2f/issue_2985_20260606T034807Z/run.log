[32mimport pytest
import asyncio

from crewai import Crew, Process, agent, task
from crewai.memory import ExternalMemory


@pytest.mark.asyncio
async def test_mem0_external_memory_addition():
    """
    Test that memories can be added to mem0 external memory without error.
    This reproduces the bug where adding memories failed due to wrong data types and agent_id length.
    The test will fail on the buggy codebase and pass after the fix.
    """

    # Setup external memory with mem0 provider and short user_id
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    # Define a simple agent that adds a memory
    @agent
    class TestAgent:
        async def run(self):
            # Add a memory entry
            await self.memory.add("This is a test memory entry.")

    # Define a simple task that triggers the agent
    @task
    async def trigger_agent():
        return "triggered"

    # Create crew with external memory enabled
    crew = Crew(
        agents=[TestAgent()],
        tasks=[trigger_agent],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the crew kickoff to trigger the agent and add memory
    result = await crew.kickoff()

    # Assert the crew ran successfully and memory was added without error
    # We expect the result to contain the output from the agent run
    assert result is not None
    assert "triggered" in result

    # Additionally, check that the external memory has at least one item
    # We do this by searching the memory for the test memory text
    search_results = await external_memory.search("test memory entry", limit=1)
    assert isinstance(search_results, list)
    assert len(search_results) > 0
    assert any("test memory entry" in item.get("text", "") for item in search_results)[0m
