def test_mem0_external_memory_adds_memory():
    # Setup external memory with mem0 provider and short user_id
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    # Define a simple agent that adds a memory
    class TestAgent(Agent):
