[32mimport pytest
import time

from crewai.crew import Crew
from crewai.process import Process
from crewai.memory.storage.mem0_storage import Mem0Storage
from crewai.memory.external_memory import ExternalMemory


def test_mem0_external_memory_addition():
    """
    Test that adding memories to an external Mem0 memory works without error.
    This test reproduces the bug where adding memories to mem0 external memory fails
    with an API error about expected list but got string and agent_id too long.
    After the fix, the addition should succeed without exceptions.

    The test creates a Crew with external_memory configured for mem0,
    runs a simple agent task that adds a memory, and asserts no errors occur.
    """

    # Setup external memory with mem0 embedder config
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    # Define a simple agent function to add a memory
    from crewai.agent import agent

    @agent(role="test_agent")
    def simple_agent(ctx):
        # Add a memory entry to external memory
        ctx.memory.add("test memory content")
        return "done"

    # Create a crew with the agent and external memory enabled
    crew = Crew(
        agents=[simple_agent],
        tasks=[],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the crew kickoff and check no exceptions occur during memory add
    # The buggy code raises an exception on add; fixed code does not.
    try:
        result = crew.kickoff()
    except Exception as e:
        pytest.fail(f"Adding memory to external mem0 raised exception: {e}")

    # Verify the agent ran and returned expected output
    assert result is not None
    assert "done" in result.values()


@pytest.mark.timeout(30)
def test_mem0_storage_agent_name_sanitization_length():
    """
    Test that Mem0Storage _get_agent_name returns a sanitized agent name
    that does not exceed the max length (255) and contains no invalid chars.

    This indirectly tests the fix that truncates and sanitizes the agent name
    to avoid the 'agent_id too long' error in mem0 API.
    """

    # Create a dummy crew with very long agent roles to test sanitization
    from crewai.memory.storage.mem0_storage import Mem0Storage
    from types import SimpleNamespace

    class DummyCrew:
        agents = [SimpleNamespace(role="a" * 300), SimpleNamespace(role="b" * 300)]

    mem0_storage = Mem0Storage.__new__(Mem0Storage)
    mem0_storage.crew = DummyCrew()

    agent_name = mem0_storage._get_agent_name()

    # Assert the agent_name is a string and length <= 255
    assert isinstance(agent_name, str)
    assert len(agent_name) <= 255

    # Assert agent_name contains only allowed characters (alphanumeric and _)
    import re

    assert re.match(r"^[a-z0-9_]+$", agent_name)


