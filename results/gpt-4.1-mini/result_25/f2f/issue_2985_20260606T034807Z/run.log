[32mimport pytest
import asyncio

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew
from crewai.memory.external_memory import ExternalMemory
from crewai.process import Process


@pytest.mark.asyncio
async def test_mem0_external_memory_addition():
    """
    Test that adding memories to mem0 external memory does not fail with invalid agent_id or message type errors.

    This test reproduces the bug where adding memories to mem0 external memory fails with:
    {"messages":["Expected a list of items but got type \"str\"."],"agent_id":["agent_id is too long. Maximum length allowed is 255 characters."]}

    After the fix, adding a memory should succeed without exceptions.
    """

    # Define a simple agent that adds a memory entry
    class SimpleAgent(Agent):
        async def run(self, inputs):
            # Add a memory entry
            await self.memory.add("Test memory entry")
            return "done"

    # Define a simple task that calls the agent
    @Task
    async def simple_task(inputs):
        agent = SimpleAgent(role="simple_agent")
        result = await agent.run(inputs)
        return result

    # Setup external memory with mem0 provider and user_id "deck"
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"},
        }
    )

    # Create a crew with the agent and task, using external memory
    crew = Crew(
        agents=[SimpleAgent(role="simple_agent")],
        tasks=[simple_task],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the simple task via the crew and ensure no exceptions occur
    result = await crew.run_task(simple_task, inputs={})

    # Assert the task completed successfully and memory was added
    assert result == "done"

    # Additionally, verify that the external memory contains the added memory
    # We can try to search or retrieve from memory to confirm
    memories = await external_memory.search("Test memory entry", limit=1)
    assert isinstance(memories, list)
    assert any("Test memory entry" in str(mem) for mem in memories)


def test_sync_wrapper():
    # Run the async test in a sync context for pytest compatibility
    asyncio.run(test_mem0_external_memory_addition())[0m
