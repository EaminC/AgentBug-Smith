[32mimport pytest
import time

from crewai.memory.external_memory import ExternalMemory
from crewai.crew import Crew
from crewai.agent import Agent
from crewai.task import Task
from crewai.process import Process


def test_mem0_external_memory_adds_memories_correctly():
    """
    This test verifies that when using Mem0 as external memory in a Crew,
    adding memories works without errors and the memories are actually stored.

    Buggy behavior:
        Adding a memory to mem0 external memory fails with:
        {"messages":["Expected a list of items but got type \"str\"."],"agent_id":["agent_id is too long. Maximum length allowed is 255 characters."]}

    Fixed behavior:
        Memories are added successfully without errors.
    """

    # Setup external memory with mem0 provider and a short user_id to avoid agent_id length issues
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"},
        }
    )

    # Define a simple agent for the crew
    class SimpleAgent(Agent):
        role = "simple_agent"

        async def run(self, inputs):
            # Just echo the input text as output
            return {"output": inputs.get("text", "")}

    # Define a simple task that sends a message to the agent and expects a response
    class EchoTask(Task):
        async def run(self, inputs):
            agent = self.crew.agents[0]
            response = await agent.run({"text": "Hello"})
            # Add a memory entry to the crew's memory
            await self.crew.memory.add_memory(
                {
                    "role": "user",
                    "content": "Hello",
                }
            )
            return response

    # Create the crew with the external memory and the simple agent and task
    crew = Crew(
        agents=[SimpleAgent],
        tasks=[EchoTask],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the crew kickoff (which runs the tasks)
    result = crew.kickoff()

    # Wait a short moment to allow async memory add to complete if needed
    time.sleep(1)

    # Check that the memory contains the added entry
    memories = crew.memory.search("Hello", limit=5)
    assert len(memories) > 0, "Expected at least one memory entry after adding"

    # Check that the memory content matches what was added
    found = any("Hello" in mem.get("content", "") for mem in memories)
    assert found, "Expected to find the added memory content in search results"

    # Also check the task result output is as expected
    assert "output" in result
    assert result["output"] == "Hello"[0m
