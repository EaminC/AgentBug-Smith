def test_external_memory_add_and_retrieve_consistency():
    """
    Test that after adding a memory item to external mem0 memory,
    retrieving memories returns the added item.

    This tests the end-to-end add and search functionality with mem0 external memory.
    """

    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    # Add a memory item
    test_text = "unique test memory content for retrieval"
    external_memory.add(test_text)

    # Small delay to allow indexing if needed
    time.sleep(1)

    # Retrieve memories with a query that matches the added text
    results = external_memory.search(test_text, limit=5)

    # Assert that the added text appears in the retrieved results
    found = any(test_text in item for item in results)
    assert found, "Added memory not found in external memory search results"[0m
