[32mimport pytest
import asyncio
from crewai.crew import Crew
from crewai.process import Process
from crewai.memory.storage.mem0_storage import Mem0Storage
from crewai.memory.storage.interface import Storage
from crewai.utilities.chromadb import sanitize_collection_name

# We import ExternalMemory from the correct module path in crewai
from crewai.memory.external import ExternalMemory


@pytest.mark.asyncio
async def test_mem0_external_memory_adds_memory_correctly():
    """
    This test verifies that when using Mem0Storage as external memory in a Crew,
    adding a memory does not raise errors related to agent_id length or message type.
    It specifically tests the fix for issue #2985 where agent_id length was too long
    and messages were not passed as a list.

    The test will fail on the buggy codebase due to the error:
    Failed to add to external memory: API request failed: {"messages":["Expected a list of items but got type \"str\"."],"agent_id":["agent_id is too long. Maximum length allowed is 255 characters."]}

    After applying the fix, the test should pass.
    """

    # Define a simple agent for the crew
    class SimpleAgent:
        role = "simple_agent"

        async def run(self, crew, inputs):
            # Add a memory entry to external memory
            await crew.memory.add("Test memory entry")
            return "done"

    # Create external memory configured to use mem0 with a short user_id
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"},
        }
    )

    # Create the crew with the SimpleAgent and external memory enabled
    crew = Crew(
        agents=[SimpleAgent()],
        tasks=[],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the agent's run method which attempts to add memory
    # We expect no exceptions and memory to be added correctly
    result = await crew.agents[0].run(crew, {})

    # Assert the run method returns the expected result
    assert result == "done"

    # Additionally, check that the agent name used in Mem0Storage is sanitized and within length
    mem_storage = None
    for mem in crew.memory._storages:
        if isinstance(mem, Mem0Storage):
            mem_storage = mem
            break

    assert mem_storage is not None, "Mem0Storage instance not found in crew memory storages"

    agent_name = mem_storage._get_agent_name()
    assert isinstance(agent_name, str)
    assert len(agent_name) <= 255
    # The agent name should be sanitized (only alphanumeric and underscores, length constraints)
    sanitized_name = sanitize_collection_name(agent_name, max_collection_length=255)
    assert agent_name == sanitized_name

    # Try to add another memory entry to ensure no error on repeated add
    await crew.memory.add("Another test memory entry")

    # If no exceptions were raised, the test passes


def test_sanitize_collection_name_limits_length():
    # Test that sanitize_collection_name respects max_collection_length parameter
    long_name = "a" * 300 + "!!!"
    sanitized = sanitize_collection_name(long_name, max_collection_length=255)
    assert len(sanitized) <= 255
    assert sanitized[-1].isalnum()
    # The sanitized name should be a prefix of the original long name (after cleaning)
    assert sanitized.startswith("a" * 63) or sanitized.startswith("a" * 255) or sanitized.startswith("a")

