[32mimport asyncio
import pytest

from crewai import Crew, Agent, Task, Process
from crewai.memory.external_memory import ExternalMemory


@pytest.mark.asyncio
async def test_mem0_external_memory_add():
    """
    Test that adding memories to an external Mem0 memory works correctly without errors.
    This test reproduces the bug where adding a memory to Mem0 external memory fails due to
    incorrect agent_id length and message format.

    Steps:
    - Create an ExternalMemory with mem0 provider and a short user_id.
    - Create a Crew with one Agent that adds a memory entry.
    - Run the Crew kickoff to trigger memory addition.
    - Assert no exceptions and that memory add was attempted.
    """

    # Setup external memory with Mem0 provider and a short user_id
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    # Define a simple echo agent that adds a memory entry
    class EchoAgent(Agent):
        def __init__(self):
            super().__init__()
            self.name = "echo"

        @Task
        async def echo(self, message: str) -> str:
            # Add memory entry to the crew's memory (which is external_memory)
            await self.crew.memory.add(f"Echoed: {message}")
            return message

    # Create the crew with the external memory and one agent
    crew = Crew(
        agents=[EchoAgent()],
        tasks=[],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the crew kickoff with input to trigger the agent task
    # We use kickoff with inputs to call the echo task with a test message
    result = await crew.kickoff(inputs={"message": "hello"})

    # The result should contain the echoed message
    assert "hello" in result.values() or "Echoed: hello" in result.values()

    # Additionally, check that the external memory has at least one entry
    # We try to retrieve memories from the external memory to confirm addition
    memories = await crew.memory.search("hello", limit=1)
    assert len(memories) > 0
    # The memory content should include the echoed message
    assert any("Echoed: hello" in m for m in memories)[0m
