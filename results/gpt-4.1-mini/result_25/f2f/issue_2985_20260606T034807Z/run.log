import time

from crewai import Crew, agent, task, Process
from crewai.memory import ExternalMemory
from crewai.memory.storage.mem0_storage import Mem0Storage


@pytest.fixture
def dummy_mem0_storage():
    # Return the Mem0Storage class for use in tests
    return Mem0Storage


def test_mem0_external_memory_add(dummy_mem0_storage):
    """
    Test that adding memories to an external Mem0 memory works correctly without errors.
    This test reproduces the bug where adding a memory to Mem0 external memory fails due to
    incorrect agent_id length and message format.
    """

    # Setup external memory with Mem0 provider and a short user_id
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    # Define a simple echo agent that adds a memory entry
    @agent
    class EchoAgent:
        def __init__(self):
            self.name = "echo"

        @task
        def echo_task(self, crew, memory):
            # Add a memory entry to the external memory
            memory.add("Test memory entry")
            return "done"

    # Create a crew with the external memory enabled
    crew = Crew(
        agents=[EchoAgent()],
        tasks=[],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the echo_task of the EchoAgent to trigger memory addition
    results = crew.run(agent_name="echo", task_name="echo_task")

    # Assert the task completed successfully
    assert results == "done"

    # Assert that the external memory storage is of type Mem0Storage
    assert isinstance(crew.memory.storage, dummy_mem0_storage)

    # Assert that the agent name used for Mem0 storage is sanitized and not too long
    agent_name = crew.memory.storage._get_agent_name()
    assert isinstance(agent_name, str)
    assert len(agent_name) <= 255

    # Assert that the memory contains the added entry by retrieving it
    retrieved = crew.memory.search("Test memory entry", limit=1)
    assert len(retrieved) > 0
    assert any("Test memory entry" in item for item in retrieved)

    # Sleep briefly to allow any async operations to complete (if any)
    time.sleep(0.1)[0m
