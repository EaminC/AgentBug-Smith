from crewai.utilities.chromadb import sanitize_collection_name

# The issue was about adding memories to Mem0 external memory failing due to
# agent_id too long and wrong type for items.
# The fix truncates and sanitizes the agent_id used as collection name.
# We test that adding memory works without error and that the agent_id length is respected.

# We cannot import ExternalMemory directly because it does not exist as a separate module.
# Instead, we will simulate external memory using Mem0Storage directly,
# which is the core class interacting with mem0 and uses the sanitize_collection_name fix.

# We will create a Crew with an external memory configured to use Mem0Storage,
# add a memory, and verify no exceptions occur and the agent_id length is <= 255.

# We mock minimal agent and task to run the crew and add memory.

@agent(role="agent1")
class TestAgent:
    def run(self, inputs):
        # Just return a fixed string
        return "response"

@task
def simple_task(inputs):
    return "task done"

def test_mem0_external_memory_addition(monkeypatch):
    # Patch Mem0Storage to use a dummy in-memory client to avoid real network calls
    # We patch the MemoryClient inside Mem0Storage to simulate successful add calls.
    from mem0 import MemoryClient

    class DummyMemoryClient:
        def __init__(self, *args, **kwargs):
            self.items_added = []
        def add(self, items, *args, **kwargs):
            # Expect items to be a list, record them
            assert isinstance(items, list), "Items added must be a list"
            self.items_added.extend(items)
            return {"success": True}
        def search(self, *args, **kwargs):
            return {"results": []}

    # Patch MemoryClient in mem0_storage.Mem0Storage
    import crewai.memory.storage.mem0_storage as mem0_storage
    original_client = mem0_storage.MemoryClient
    mem0_storage.MemoryClient = DummyMemoryClient

    try:
        # Create Mem0Storage instance with dummy config
        mem0 = Mem0Storage()
        # Set a crew with multiple agents to generate a long agent_id string
        class DummyAgent:
            def __init__(self, role):
                self.role = role
        # Create many agents with long roles to test truncation
        mem0.crew = type("DummyCrew", (), {})()
        mem0.crew.agents = [DummyAgent("agent_role_longname_{}".format(i)) for i in range(10)]

        # Get agent name (collection name) used internally
        agent_name = mem0._get_agent_name()
        # Check length is <= 255 (the fix truncates to max length)
        assert len(agent_name) <= 255, f"Agent name length {len(agent_name)} exceeds 255"

        # Add memory with a list of items (correct type)
        items_to_add = [{"id": "1", "text": "memory item 1"}]
        result = mem0.add(items=items_to_add)
        # Should succeed and return dict with success True
        assert isinstance(result, dict)
        assert result.get("success") is True

        # Add memory with a string instead of list to check failure (should raise AssertionError)
        with pytest.raises(AssertionError):
            mem0.add(items="not a list")

    finally:
        # Restore original MemoryClient
        mem0_storage.MemoryClient = original_client

# The test fails on buggy code because agent_name is not truncated and mem0 client rejects the add call
# The test passes on fixed code because agent_name is truncated and add call succeeds with dummy client.[0m
