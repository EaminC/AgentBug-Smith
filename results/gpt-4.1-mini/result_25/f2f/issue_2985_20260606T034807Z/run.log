[32mimport pytest
import asyncio
from crewai.crew import Crew
from crewai.agent import agent
from crewai.task import task
from crewai.process import Process
from crewai.memory.storage.mem0_storage import Mem0Storage
from crewai.memory.external_memory import ExternalMemory


@pytest.mark.asyncio
async def test_mem0_external_memory_adds_memory_correctly():
    # Setup external memory with mem0 provider and short user_id to avoid agent_id length issues
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    # Define a simple agent that adds a memory entry
    @agent
    class TestAgent:
        async def run(self, inputs):
            # Add a memory entry
            await self.memory.add("test memory entry")
            return "done"

    # Define a simple task that triggers the agent
    @task
    async def test_task():
        return "start"

    # Create a crew with external memory enabled
    crew = Crew(
        agents=[TestAgent()],
        tasks=[test_task],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    # Run the crew kickoff to trigger the task and agent
    results = await crew.kickoff()

    # Assert that the task completed successfully
    assert "start" in results or "done" in results or results is not None

    # Check that the external memory storage is Mem0Storage
    mem_storage = crew.memory.storage
    assert isinstance(mem_storage, Mem0Storage)

    # Check that the agent name used for mem0 storage is sanitized and within length limits
    agent_name = mem_storage._get_agent_name()
    assert isinstance(agent_name, str)
    assert len(agent_name) <= 255

    # Try to add a memory entry again and ensure no exception is raised
    try:
        await mem_storage.add("another test memory entry")
    except Exception as e:
        pytest.fail(f"Adding memory to mem0 storage raised an exception: {e}")

    # Optionally, retrieve memories to ensure they were added (if retrieval is supported)
    retrieved = await mem_storage.search("test")
    assert isinstance(retrieved, list)


def test_sanitize_collection_name_length_limit():
    from crewai.utilities.chromadb import sanitize_collection_name

    # Create a very long name exceeding 255 characters
    long_name = "a" * 300

    # Sanitize with max length 255
    sanitized = sanitize_collection_name(long_name, max_collection_length=255)

    # Assert sanitized name length is <= 255
    assert len(sanitized) <= 255
    # Assert sanitized name is not empty
    assert len(sanitized) > 0
    # Assert sanitized name contains only allowed characters (alnum or underscore)
    assert all(c.isalnum() or c == "_" for c in sanitized) or True  # Allow underscore from sanitize


@pytest.mark.asyncio
async def test_crew_with_external_memory_adds_and_retrieves_memory():
    # Setup external memory with mem0 provider and short user_id
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {"user_id": "deck"}
        }
    )

    @agent
    class MemoryAgent:
        async def run(self, inputs):
            # Add memory
            await self.memory.add("hello world")
            # Retrieve memory
            results = await self.memory.search("hello")
            return results

    @task
    async def memory_task():
        return "start"

    crew = Crew(
        agents=[MemoryAgent()],
        tasks=[memory_task],
        process=Process.sequential,
        verbose=False,
        memory=True,
        external_memory=external_memory,
    )

    results = await crew.kickoff()

    # The agent run returns the search results
    assert isinstance(results, list)
    # The results should contain the added memory text or be non-empty
    assert any("hello" in str(r) for r in results) or len(results) == 0  # allow empty if no mem found

