[32mFROM node:21-alpine AS test_builder

WORKDIR /app

# Copy entire repository to include externally injected tests
COPY . .

# Install all dependencies including devDependencies for testing
RUN if [ -f "src/frontend/package-lock.json" ]; then \
        cd src/frontend && npm ci; \
    elif [ -f "src/frontend/package.json" ]; then \
        cd src/frontend && npm install; \
    else \
        echo "No frontend package.json found, skipping npm install"; \
    fi

# Preflight check: verify node_modules exist to ensure dependencies installed
RUN [ -d "src/frontend/node_modules" ] && echo "Dependencies installed" || (echo "Dependencies missing" && exit 1)

# Run frontend tests (Playwright implied by workflows)
RUN cd src/frontend && npx playwright install --with-deps && npx playwright test --project=chromium

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}


# Build frontend for production
RUN cd src/frontend && npm run build


# Production stage: minimal runtime image
FROM node:21-alpine AS runtime

WORKDIR /app

COPY --from=test_builder /app/src/frontend/build ./build

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Expose port 3000 based on npm start default for React or Next.js apps (assumption)
EXPOSE 3000

CMD ["/bin/bash"][0m
