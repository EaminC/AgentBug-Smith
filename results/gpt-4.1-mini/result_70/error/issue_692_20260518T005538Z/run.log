# --- end inject ---

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

COPY . .

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libc6-dev libffi-dev && \
    rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies and the repo itself, plus test dependencies
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt; \
    else \
      echo "No requirements.txt found, skipping."; \
    fi && \
    pip install -e . pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm

RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]
