    ANTHROPIC_SMALL_FAST_MODEL=tensorblock/gpt-4.1-mini

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential gcc g++ libc6-dev libffi-dev python3-dev curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN python -m pip install --upgrade pip setuptools==81.0.0 wheel

RUN if [ -f "requirements.txt" ]; then \
      pip install --no-cache-dir -r requirements.txt; \
    fi && \
    pip install -e . && \
    pip install --no-cache-dir pytest pytest-mock pytest-xdist pytest-timeout litellm

RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]
