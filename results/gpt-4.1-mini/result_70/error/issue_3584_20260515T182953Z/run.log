[32mFROM node:21-alpine AS test_builder

WORKDIR /app

# Copy entire repository for test scripts injection and build context
COPY . .

# Install all dependencies including dev dependencies
RUN if [ -f "src/frontend/package-lock.json" ]; then \
      cd src/frontend && npm ci; \
    elif [ -f "src/frontend/package.json" ]; then \
      cd src/frontend && npm install; \
    else \
      echo "No package.json found in src/frontend, skipping npm install"; \
    fi

# Preflight check: ensure node_modules installed
RUN [ -d "src/frontend/node_modules" ] || (echo "node_modules folder missing - install failed?"; exit 1)

# Run frontend tests if test files exist; fallback to just build if no tests
RUN if ls src/frontend/tests/* > /dev/null 2>&1; then \
      cd src/frontend && npx playwright test --project=chromium; \
    else \
      echo "No frontend tests found, skipping tests"; \
    fi

# Assumption: Backend is Python-based and tested separately, frontend tests cover JS code.

FROM node:21-alpine AS runtime

WORKDIR /app

COPY --from=test_builder /app/src/frontend ./src/frontend

WORKDIR /app/src/frontend

# Install only production dependencies
RUN if [ -f "package-lock.json" ]; then \
      npm ci --omit=dev; \
    elif [ -f "package.json" ]; then \
      npm install --omit=dev; \
    else \
      echo "No package.json found, skipping npm install"; \
    fi

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Assumption: No explicit port exposed in JS context, backend listens on 7860 as per Makefile for Python backend.

CMD ["/bin/bash"][0m
