[32mFROM node:21-alpine AS test_builder

WORKDIR /app

# Install all dependencies including devDependencies for testing
RUN if [ -f "package-lock.json" ]; then \
      npm ci; \
    elif [ -f "package.json" ]; then \
      npm install; \
    fi

COPY . .

# Run preflight check to verify installation (try to run a simple node command)
RUN node -e "console.log('preflight ok');"

# Run tests with npm test or fallback to mocha if exists, else no-op
RUN if npm run | grep -q ' test'; then \
      npm test; \
    elif command -v mocha >/dev/null 2>&1; then \
      mocha || true; \
    else \
      echo "No test script or mocha found, skipping tests"; \
    fi

FROM node:21-alpine AS runtime

WORKDIR /app

# Copy only production dependencies and app source for runtime
COPY package.json package-lock.json* ./
RUN if [ -f "package-lock.json" ]; then \
      npm ci --only=production; \
    elif [ -f "package.json" ]; then \
      npm install --production; \
    fi

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

