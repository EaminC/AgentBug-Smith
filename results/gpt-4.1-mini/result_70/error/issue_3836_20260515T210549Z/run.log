ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly_key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set working directory to /app
WORKDIR /app

# Copy entire repository contents
COPY . .

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"

# Install dependencies in src/frontend if package.json exists
RUN if [ -f "src/frontend/package.json" ]; then \
      cd src/frontend && \
      if [ -f "package-lock.json" ]; then \
        npm ci; \
      elif [ -f "yarn.lock" ]; then \
        yarn install; \
      else \
        npm install; \
      fi; \
    fi

# Install dependencies in scripts/aws if package.json exists
RUN if [ -f "scripts/aws/package.json" ]; then \
      cd scripts/aws && \
      if [ -f "package-lock.json" ]; then \
        npm ci; \
      elif [ -f "yarn.lock" ]; then \
        yarn install; \
      else \
        npm install; \
      fi; \
    fi

# Set working directory back to /app root
WORKDIR /app

# Final command to keep container open in bash shell
CMD ["/bin/bash"]

# branch: JavaScript project with Forge API environment variables, install dependencies in src/frontend and scripts/aws
