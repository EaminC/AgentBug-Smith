ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"

WORKDIR /app

# Copy entire repository contents into /app
COPY . .

# Robust dependency installation checking root and frontend package files
RUN if [ -f "package-lock.json" ]; then \
      npm ci; \
    elif [ -f "package.json" ]; then \
      npm install; \
    elif [ -f "src/frontend/package-lock.json" ]; then \
      cd src/frontend && npm ci; \
    elif [ -f "src/frontend/package.json" ]; then \
      cd src/frontend && npm install; \
    else \
      echo "No package.json or lockfile found, skipping npm install"; \
    fi

# Install JS test frameworks commonly used (jest, mocha) if not present
RUN npm install --no-save jest mocha || true

CMD ["/bin/bash"]

