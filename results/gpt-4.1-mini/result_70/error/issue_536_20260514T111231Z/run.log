[32mFROM node:20-alpine AS test_builder

WORKDIR /app

# Copy entire repo including clients/python which contains JavaScript metadata
COPY . .

# Install dependencies with dev dependencies for testing
RUN if [ -f "clients/python/package-lock.json" ]; then \
      cd clients/python && npm ci; \
    elif [ -f "clients/python/yarn.lock" ]; then \
      cd clients/python && yarn install; \
    else \
      cd clients/python && npm install; \
    fi

# Run tests using the standard test script or fallback to npm test
RUN cd clients/python && npm run test || npm test

# Minimal runtime image
FROM node:20-alpine AS runtime

WORKDIR /app

COPY --from=test_builder /app/clients/python/ ./

# Install production dependencies only
RUN if [ -f "package-lock.json" ]; then \
      npm ci --omit=dev; \
    elif [ -f "yarn.lock" ]; then \
      yarn install --production; \
    else \
      npm install --production; \
    fi

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

