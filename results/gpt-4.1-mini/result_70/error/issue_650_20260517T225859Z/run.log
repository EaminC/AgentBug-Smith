# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly_key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

WORKDIR /app

# Set environment variables for Forge API compatibility (OpenAI SDK + Anthropic SDK)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Also set FORGE_API_KEY and FORGE_BASE_URL explicitly
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

COPY . .

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies robustly with focus on langchain version compatibility
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt && \
      pip install -e . && \
      # Force langchain to a compatible version to avoid MODEL_COST_PER_1K_TOKENS import error
      pip install "langchain<0.0.232" && \
      pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    elif [ -f "pyproject.toml" ]; then \
      pip install -e . && \
      pip install "langchain<0.0.232" && \
      pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    else \
      echo "No requirements.txt or pyproject.toml found, installing test deps only" && \
      pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm "langchain<0.0.232"; \
    fi

# Preflight check to ensure critical packages import without errors
RUN python -c 'import pkg_resources, pytest, langchain; print("preflight ok")'

CMD ["/bin/bash"]

