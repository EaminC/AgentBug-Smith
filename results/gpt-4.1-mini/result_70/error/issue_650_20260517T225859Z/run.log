      pip install -r requirements.txt && \
      pip install -e . && \
      pip install --upgrade langchain && \  # Fix import error by getting latest langchain
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
      pip install poetry && \
      poetry config virtualenvs.create false && \
      poetry install --no-interaction --no-ansi && \
      pip install --upgrade langchain && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    elif [ -f "pyproject.toml" ]; then \
      pip install -e . && \
      pip install --upgrade langchain && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    else \
      pip install -e . && \
      pip install --upgrade langchain && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# Preflight check to verify installs
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Detect src layout and set PYTHONPATH if needed to avoid import errors
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
      echo "Detected src layout or src imports, setting PYTHONPATH"; \
      echo "export PYTHONPATH=/app" >> ~/.bashrc; \
    fi

# Set default shell
CMD ["/bin/bash"]

