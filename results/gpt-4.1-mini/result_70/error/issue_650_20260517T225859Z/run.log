# Detect src layout and set PYTHONPATH if needed to avoid import errors
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
  echo "Detected src layout or src imports, setting PYTHONPATH"; \
  echo "export PYTHONPATH=/app" >> ~/.bashrc; \
fi

# Workaround for langchain import error: install a specific version
RUN pip install --upgrade "langchain==0.0.238"

CMD ["/bin/bash"]

