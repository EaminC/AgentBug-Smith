      pip install -r requirements.txt && pip install -e . && pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm langchain==0.0.300; \
    elif [ -f "pyproject.toml" ]; then \
      pip install -e . && pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm langchain==0.0.300; \
    else \
      echo "No requirements.txt or pyproject.toml found, installing test dependencies and langchain" && \
      pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm langchain==0.0.300; \
    fi

# Verify basic imports and test framework availability
RUN python -c "import pytest; import litellm; import langchain; print('preflight ok')"

CMD ["/bin/bash"]

