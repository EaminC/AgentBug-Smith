WORKDIR /app

# Copy entire repository
COPY . .

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libffi-dev libssl-dev python3-dev \
  && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies if requirements.txt exists then install package and testing dependencies
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt; \
    fi

RUN pip install -e . && pip install pytest pytest-mock pytest-xdist pytest-timeout litellm "setuptools<=81.0.0"

# Preflight check to confirm environment setup
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY="forge-key" \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN="forge-key"

# Default command to keep container running with bash prompt
CMD ["/bin/bash"]

