[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Install system dependencies needed for poetry and build
RUN apt-get update && apt-get install -y --no-install-recommends curl build-essential && rm -rf /var/lib/apt/lists/*

COPY . .

# Upgrade pip, setuptools, wheel and install dependencies and test tooling with poetry if lockfile exists, else fallback to editable install
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -f "poetry.lock" ]; then \
        pip install poetry; \
        poetry config virtualenvs.create false; \
        poetry install --no-interaction --no-ansi; \
        pip install -e .; \
    else \
        pip install -e .; \
    fi; \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout

# Preflight import test to fail fast if core modules are missing
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

# Run tests (assumption: tests are discoverable by pytest in the repo root or subdirs)
RUN pytest --maxfail=1 --disable-warnings -v

# Minimal runtime image
FROM python:3.12-slim AS runtime

WORKDIR /app

# Install system dependencies if needed (assumption: none beyond python std libs)

COPY . .

# Upgrade pip and install only production dependencies with poetry if lockfile exists, else fallback to editable install
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -f "poetry.lock" ]; then \
        pip install poetry; \
        poetry config virtualenvs.create false; \
        poetry install --no-dev --no-interaction --no-ansi; \
    else \
        pip install -e .; \
    fi

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

