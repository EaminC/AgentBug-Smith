[32mARG NODEJS_VERSION="22"

FROM node:${NODEJS_VERSION}-slim AS base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json .
COPY package-lock.json .  # Assumption: package-lock.json may or may not exist for lockfile check
COPY pnpm-lock.yaml .    # Assumption: pnpm-lock.yaml may or may not exist for lockfile check

# Install dependencies and test tooling, prefer pnpm if pnpm-lock.yaml exists, else npm
RUN if [ -f pnpm-lock.yaml ]; then \
      npm install -g pnpm && \
      pnpm install; \
    elif [ -f package-lock.json ]; then \
      npm ci; \
    else \
      npm install; \
    fi && \
    npm install -D vitest @vitest/coverage-v8 tsx typescript # install test dependencies explicitly

# Copy entire repo to preserve injected tests and project files
COPY . .

# Build the project
RUN npm run build

# Preflight check: ensure main entrypoint script exists and vitest is runnable
RUN test -f ./node_modules/.bin/vitest && test -f ./package.json && echo "preflight ok"

# Run tests to verify
RUN npx vitest run

# Final minimal production image with only production dependencies
FROM node:${NODEJS_VERSION}-alpine AS production

WORKDIR /app

COPY --from=base /app/package.json ./
COPY --from=base /app/package-lock.json ./  # Assumption: copy if exists
COPY --from=base /app/pnpm-lock.yaml ./     # Assumption: copy if exists

RUN if [ -f pnpm-lock.yaml ]; then \
      npm install -g pnpm && \
      pnpm install --prod; \
    elif [ -f package-lock.json ]; then \
      npm ci --only=production; \
    else \
      npm install --production; \
    fi

COPY --from=base /app/.next/standalone ./
COPY --from=base /app/.next/static ./.next/static
COPY --from=base /app/public ./public

# Set Forge environment variables as required
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY="${FORGE_API_KEY}" \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN="${FORGE_API_KEY}"

# Expose default port inferred from next.config.ts start script
EXPOSE 3210

