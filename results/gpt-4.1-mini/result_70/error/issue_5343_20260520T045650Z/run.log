[32mFROM node:20-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly_key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set working directory
WORKDIR /app

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Copy package.json and tsconfig.json for dependency installs
COPY package.json tsconfig.json ./

# Copy lockfiles conditionally for package managers
RUN if [ -f package-lock.json ]; then cp package-lock.json ./; fi && \
    if [ -f yarn.lock ]; then cp yarn.lock ./; fi && \
    if [ -f pnpm-lock.yaml ]; then cp pnpm-lock.yaml ./; fi

# Install dependencies using the appropriate package manager, with legacy-peer-deps for npm to resolve conflicts
RUN if [ -f package-lock.json ]; then \
        npm install --legacy-peer-deps; \
    elif [ -f yarn.lock ]; then \
        npm install -g yarn && yarn install; \
    elif [ -f pnpm-lock.yaml ]; then \
        npm install -g pnpm && pnpm install; \
    else \
        npm install --legacy-peer-deps; \
    fi

# Copy full project sources
COPY . .

# Install necessary dev dependencies for testing and building, forcing legacy-peer-deps to avoid dependency conflicts
RUN npm install --legacy-peer-deps --save-dev vitest @vitest/coverage-v8 tsx typescript

# Build project if build script is defined
RUN if npm run | grep -q "build"; then npm run build || true; fi

# Preflight check to verify vitest is installed
RUN test -f ./node_modules/.bin/vitest && test -f ./package.json && echo "preflight ok"

# Run tests to verify setup
RUN npx vitest run

CMD ["/bin/bash"]

