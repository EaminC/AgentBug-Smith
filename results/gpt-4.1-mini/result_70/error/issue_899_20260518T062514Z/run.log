    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

# Copy entire repository into container
COPY . .

# Install system dependencies needed for Python packages and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc python3-dev libffi-dev libssl-dev build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and setuptools, pin setuptools to <= 81.0.0
RUN python -m pip install --upgrade pip setuptools==81.0.0 wheel packaging

# Install project dependencies and project itself in editable mode + test dependencies
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout litellm

# Preflight check - verify pytest and pkg_resources imports
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command to keep the container running for manual use
CMD ["/bin/bash"]

