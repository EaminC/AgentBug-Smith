ENV ANTHROPIC_AUTH_TOKEN="forge-key"

WORKDIR /app

COPY . .

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc g++ libffi-dev libssl-dev python3-dev build-essential ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel

# Use native pip installs with conditional logic based on repo files
RUN if [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt && pip install -e . && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
    pip install poetry && \
    poetry config virtualenvs.create false && \
    poetry install --no-interaction --no-ansi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
elif [ -f "pyproject.toml" ]; then \
    pip install -e . && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
else \
    echo "No Python dependency files found, installing project editable and test deps only" && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
fi

RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

