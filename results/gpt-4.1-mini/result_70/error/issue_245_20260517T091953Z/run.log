[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly_key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

WORKDIR /app

COPY . .

# Install system dependencies needed for building Python packages
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    gcc \
    build-essential \
    libffi-dev \
    libssl-dev \
    python3-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and restrict setuptools to a compatible version to fix build issues
RUN python -m pip install --upgrade pip
RUN pip install "setuptools<=81.0.0" wheel

# Install Python dependencies
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y rustc cargo && rm -rf /var/lib/apt/lists/*
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi

# Always install the repo itself (supports modern pyproject.toml) and test dependencies explicitly
RUN pip install -e . pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# Install standard testing tools
RUN pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio litellm

# Sanity check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

CMD ["/bin/bash"]

# branch: python with pyproject.toml and Forge API environment set
