[32m# Use official Node.js 24 Alpine image for build stage (latest LTS with pnpm support)
FROM node:24-alpine AS test_builder

# Set working directory to /app
WORKDIR /app

# Copy entire repository to /app
COPY . .

# Install pnpm if pnpm-lock.yaml exists in the root or in clients/python
RUN if [ -f "pnpm-lock.yaml" ] || [ -f "clients/python/pnpm-lock.yaml" ]; then \
      npm install -g pnpm@latest; \
    fi

# Install dependencies and build the project in clients/python
RUN if [ -f "clients/python/pnpm-lock.yaml" ]; then \
      cd clients/python && pnpm install --frozen-lockfile && pnpm run build; \
    fi

# Preflight check to verify pnpm installation and built files in clients/python
RUN if [ -f "clients/python/pnpm-lock.yaml" ]; then \
      cd clients/python && pnpm run test; \
    fi

# Final minimal runtime image, use node:24-alpine for minimal size
FROM node:24-alpine AS runtime

# Set working directory to /app
WORKDIR /app

# Copy only production dependencies and built artifacts from test_builder
COPY --from=test_builder /app/clients/python /app/clients/python
COPY --from=test_builder /app/clients/python/node_modules /app/clients/python/node_modules

# Set Forge environment variables as required
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Set default command to bash
CMD ["/bin/bash"][0m
