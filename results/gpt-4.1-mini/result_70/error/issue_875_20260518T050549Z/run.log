# Poetry lockfile is not present; install using poetry if pyproject.toml exists
RUN if [ -f "pyproject.toml" ]; then \
        python -m pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi || true; \
    fi

# Install dev dependencies and test tooling
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout

# Install the local project in editable mode unless src/ layout or src imports detected
