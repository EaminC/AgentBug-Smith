    FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Set working directory
WORKDIR /app

# Copy entire repository
COPY . .

# Install pnpm globally if pnpm-lock.yaml is present, then install with pnpm
# Else use npm ci if package-lock.json exists
# Else npm install if package.json exists
