ENV ANTHROPIC_AUTH_TOKEN="forge-key"

# Set working directory
WORKDIR /app

# Copy the entire repository
COPY . .

# Install dependencies using native JS package manager with robust detection
RUN if [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm && \
      pnpm install --frozen-lockfile; \
    elif [ -f "package-lock.json" ]; then \
      npm ci; \
    elif [ -f "package.json" ]; then \
      npm install; \
    else \
      echo "No known JS package manager lockfile found, skipping install"; \
    fi

# Ensure standard JS test tools are installed to prevent missing deps
RUN if [ -f "package.json" ]; then \
      npm install --no-save jest mocha || true; \
    fi

# Preflight test to verify jest availability
RUN node -e "require('jest'); console.log('preflight ok')" || true

# Final command must be bash shell for test harness
CMD ["/bin/bash"]

