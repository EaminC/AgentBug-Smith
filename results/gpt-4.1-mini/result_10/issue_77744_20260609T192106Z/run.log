[32mFROM node:20-slim

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

WORKDIR /app

COPY . .

RUN if [ -f "skills/package-lock.json" ]; then \
      npm ci --prefix skills && \
      npm run build --prefix skills; \
    elif [ -f "skills/package.json" ]; then \
      npm install --prefix skills && \
      npm run build --prefix skills; \
    else \
      echo "Warning: no package.json found in skills/ directory"; \
    fi && \
    # Install standard testing framework and TypeScript compiler for skills
    if [ -f "skills/tsconfig.json" ]; then \
      npm install --prefix skills --no-save jest ts-jest @types/jest typescript; \
    else \
      npm install --prefix skills --no-save jest; \
    fi && \
    # Preflight: test that core modules can be imported
    node -e "import('jest'); import('typescript'); console.log('preflight ok')"

