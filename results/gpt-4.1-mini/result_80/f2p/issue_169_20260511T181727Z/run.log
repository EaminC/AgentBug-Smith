def test_to_files_square_brackets_and_backticks():
    """
    Test that filenames surrounded by square brackets are normalized by removing brackets,
    and filenames surrounded by backticks remain unchanged (buggy behavior).

    Before the fix, filenames with square brackets were kept with brackets,
    resulting in filenames like '[filename]'.
    After the fix, square brackets are removed from filenames.

    Backticks are not handled by the fix and remain as-is (this test expects that behavior).

    This test verifies that the fix correctly removes square brackets but does not remove backticks.
    """

    # Input with square brackets around filename (should be stripped after fix)
    chat_with_square_brackets = textwrap.dedent(
        """
        This is a sample program.

        [file1.py]
        ```python
        print("Hello, from square brackets!")
        ```

        [file2.py]
        ```python
        def add(a, b):
            return a + b
        ```
        """
    )

    workspace_sq = {}
    to_files(chat_with_square_brackets, workspace_sq)

    # After fix: filenames should NOT include square brackets
    assert "file1.py" in workspace_sq, "file1.py missing in workspace (square brackets case)"
    assert "file2.py" in workspace_sq, "file2.py missing in workspace (square brackets case)"
    assert workspace_sq["file1.py"] == 'print("Hello, from square brackets!")\n'
    assert workspace_sq["file2.py"] == "def add(a, b):\n    return a + b\n"

    # Input with backticks around filename (buggy behavior triggers here)
    chat_with_backticks = textwrap.dedent(
        """
        This is a sample program.

        `file1.py`
        ```python
        print("Hello, from backticks!")
        ```

        `file2.py`
        ```python
        def add(a, b):
            return a + b
        ```
        """
    )

    workspace_bt = {}
    to_files(chat_with_backticks, workspace_bt)

    # Expected: filenames should NOT include backticks
    # Before fix: filenames would be '`file1.py`', '`file2.py`' (wrong)
    # After fix: filenames should be 'file1.py', 'file2.py'
    # The fix does not handle backticks, so this test expects failure on buggy code,
    # and success after fix if the fix is extended.
    assert "file1.py" in workspace_bt, "file1.py missing in workspace (backticks case)"
    assert "file2.py" in workspace_bt, "file2.py missing in workspace (backticks case)"
    assert workspace_bt["file1.py"] == 'print("Hello, from backticks!")\n'
    assert workspace_bt["file2.py"] == "def add(a, b):\n    return a + b\n"[0m
