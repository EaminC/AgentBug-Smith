ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"

WORKDIR /app

# Copy the entire repository into the container
COPY . .

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies from requirements.txt if it exists, then install the package in editable mode
# Install pytest and related test dependencies unconditionally to ensure tests can run
RUN if [ -f requirements.txt ]; then pip install -r requirements.txt; fi \
    && pip install -e . \
    && pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout

# Preflight to verify packages and pytest are installed
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

