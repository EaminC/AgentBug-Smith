from gpt_engineer.chat_to_files import to_files


def test_filename_brackets_handling():
    """
    Test that filenames surrounded by backticks or square brackets are handled correctly.

    Before the fix, filenames with backticks were not stripped properly,
    resulting in filenames like '`filename`' instead of 'filename'.
    After the fix, filenames with square brackets are normalized by removing brackets.

    This test covers both cases to ensure the fix works as expected.
    """

    # Input with backticks around filename (buggy behavior triggers here)
    chat_with_backticks = textwrap.dedent(
        """
        This is a sample program.

        `file1.py`
        ```python
        print("Hello, from backticks!")
        ```

        `file2.py`
        ```python
        def add(a, b):
            return a + b
        ```
        """
    )

    workspace_backticks = {}
    to_files(chat_with_backticks, workspace_backticks)

    # Expected: filenames should NOT include backticks
    # Before fix: filenames would be '`file1.py`', '`file2.py`' (wrong)
    # After fix: filenames should be 'file1.py', 'file2.py'
    assert "file1.py" in workspace_backticks, "file1.py missing in workspace (backticks case)"
    assert "file2.py" in workspace_backticks, "file2.py missing in workspace (backticks case)"
    assert '`file1.py`' not in workspace_backticks, "Backticks not stripped from filename file1.py"
    assert '`file2.py`' not in workspace_backticks, "Backticks not stripped from filename file2.py"
    assert workspace_backticks["file1.py"] == 'print("Hello, from backticks!")\n'
    assert workspace_backticks["file2.py"] == "def add(a, b):\n    return a + b\n"

    # Input with square brackets around filename (fixed behavior)
    chat_with_brackets = textwrap.dedent(
        """
        This is a sample program.

        [file3.py]
        ```python
        print("Hello, from brackets!")
        ```

        [file4.py]
        ```python
        def multiply(a, b):
            return a * b
        ```
        """
    )

    workspace_brackets = {}
    to_files(chat_with_brackets, workspace_brackets)

    # Expected: filenames should NOT include square brackets
    # Before fix: filenames would be '[file3.py]', '[file4.py]' (wrong)
    # After fix: filenames should be 'file3.py', 'file4.py'
    assert "file3.py" in workspace_brackets, "file3.py missing in workspace (brackets case)"
    assert "file4.py" in workspace_brackets, "file4.py missing in workspace (brackets case)"
    assert '[file3.py]' not in workspace_brackets, "Square brackets not stripped from filename file3.py"
    assert '[file4.py]' not in workspace_brackets, "Square brackets not stripped from filename file4.py"
    assert workspace_brackets["file3.py"] == 'print("Hello, from brackets!")\n'
    assert workspace_brackets["file4.py"] == "def multiply(a, b):\n    return a * b\n"

    # Also check README.md contains the original chat content including the bracketed or backticked filenames
    assert workspace_backticks["all_output.txt"] == chat_with_backticks
    assert workspace_brackets["all_output.txt"] == chat_with_brackets

    # README.md should contain the original filename lines as in the chat, including brackets or backticks
    # This ensures that the README.md reflects the original chat content lines for filenames
    assert "`file1.py`" in workspace_backticks["README.md"]
    assert "`file2.py`" in workspace_backticks["README.md"]
    assert "[file3.py]" in workspace_brackets["README.md"]
    assert "[file4.py]" in workspace_brackets["README.md"][0m
