+def test_to_files():
+    chat = textwrap.dedent(
+        """
+    This is a sample program.
+
+    file1.py
+    ```python
+    print("Hello, World!")
+    ```
+
+    file2.py
+    ```python
+    def add(a, b):
+        return a + b
+    ```
+    """
