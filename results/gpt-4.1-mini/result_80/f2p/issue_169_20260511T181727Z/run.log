    def test_to_files_square_brackets_and_backticks():
        """
        Test that filenames surrounded by square brackets are normalized by removing brackets,
        and filenames surrounded by backticks remain unchanged (buggy behavior).
    
        Before the fix, filenames with square brackets were kept with brackets,
        resulting in filenames like '[filename]'.
        After the fix, square brackets are removed from filenames.
    
        Backticks are not handled by the fix and remain as-is (this test expects that behavior).
    
        This test verifies that the fix correctly removes square brackets but does not remove backticks.
        """
    
        # Input with square brackets around filename (should be stripped after fix)
        chat_with_square_brackets = textwrap.dedent(
            """
            This is a sample program.
    
            [file1.py]
            ```python
            print("Hello, from square brackets!")
            ```
    
            [file2.py]
            ```python
            def add(a, b):
                return a + b
            ```
