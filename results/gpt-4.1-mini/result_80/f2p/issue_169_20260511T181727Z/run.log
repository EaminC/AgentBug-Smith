from gpt_engineer.chat_to_files import to_files


def test_filename_brackets_handling():
    """
    Test that filenames surrounded by backticks or square brackets are handled correctly.

    Before the fix, filenames with backticks were not stripped properly,
    resulting in filenames like '`filename`' instead of 'filename'.
    After the fix, filenames with square brackets are normalized by removing brackets.

    This test covers both cases to ensure the fix works as expected.
    """

    # Input with backticks around filename (buggy behavior triggers here)
    chat_with_backticks = textwrap.dedent(
        """
        This is a sample program.

        `file1.py`
        ```python
        print("Hello, from backticks!")
        ```

        `file2.py`
        ```python
        def add(a, b):
            return a + b
        ```
        """
    )

    workspace_backticks = {}
    to_files(chat_with_backticks, workspace_backticks)

    # Expected: filenames should NOT include backticks
    # Before fix: filenames would be '`file1.py`', '`file2.py`' (wrong)
    # After fix: filenames should be 'file1.py', 'file2.py'
    assert "file1.py" in workspace_backticks, "file1.py missing in workspace (backticks case)"
    assert "file2.py" in workspace_backticks, "file2.py missing in workspace (backticks case)"
    assert workspace_backticks["file1.py"] == 'print("Hello, from backticks!")\n'
    assert (
        workspace_backticks["file2.py"] == "def add(a, b):\n    return a + b\n"
    )

    # Input with square brackets around filename (should be normalized by fix)
    chat_with_brackets = textwrap.dedent(
        """
        This is a sample program.

        [file1.py]
        ```python
        print("Hello, from brackets!")
        ```

        [file2.py]
        ```python
        def add(a, b):
            return a + b
        ```
        """
    )

    workspace_brackets = {}
    to_files(chat_with_brackets, workspace_brackets)

    # Expected: filenames should have brackets removed
    assert "file1.py" in workspace_brackets, "file1.py missing in workspace (brackets case)"
    assert "file2.py" in workspace_brackets, "file2.py missing in workspace (brackets case)"
    assert workspace_brackets["file1.py"] == 'print("Hello, from brackets!")\n'
    assert workspace_brackets["file2.py"] == "def add(a, b):\n    return a + b\n"

    # Also test that filenames with brackets inside the name are preserved
    chat_with_inner_brackets = textwrap.dedent(
        """
        This is a sample program.

        [id].jsx
        ```javascript
        console.log("Hello, World!")
        ```
        """
    )

    workspace_inner_brackets = {}
    to_files(chat_with_inner_brackets, workspace_inner_brackets)

    assert "[id].jsx" in workspace_inner_brackets, "[id].jsx missing in workspace"
    assert (
        workspace_inner_brackets["[id].jsx"] == 'console.log("Hello, World!")\n'
    )[0m
