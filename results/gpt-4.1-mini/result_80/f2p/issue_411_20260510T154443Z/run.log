[32mFROM python:3.9-slim AS test_builder

WORKDIR /app

# Install build dependencies and testing tools
COPY . .

RUN python -m pip install --upgrade pip setuptools wheel && \
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt && pip install -e .; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi && \
        pip install -e .; \
    elif [ -f "pyproject.toml" ]; then \
        pip install -e .; \
    else \
        echo "No recognized Python package manager files found."; \
        exit 1; \
    fi && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# Preflight import check to fail fast if core modules missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests with coverage (tests/run.py exists in the repo)
RUN python -m coverage run tests/run.py

FROM python:3.9-slim AS runtime

WORKDIR /app

COPY . .

# Install only production dependencies
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt 2>/dev/null || true && \
    pip install --no-cache-dir agentscope

