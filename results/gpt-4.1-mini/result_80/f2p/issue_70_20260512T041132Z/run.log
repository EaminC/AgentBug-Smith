    # Patch the internal method that produces the task dicts to a fixed sample
    sample_task_dicts = {
        "tasks": [
            {
                "step": 0,
                "name": "Data Collection",
                "resources": ["dataset1", "dataset2"],
                "description": "Collect raw data from sources."
            },
            {
                "step": 1,
                "name": "Data Processing",
                "resources": ["processing script"],
                "description": "Clean and preprocess data."
            },
            {
                "step": 2,
                "name": "Model Training",
                "resources": ["training code", "GPU"],
                "description": "Train the ML model."
            },
        ]
    }

    # Patch the internal method that generates the plan to return sample_task_dicts
