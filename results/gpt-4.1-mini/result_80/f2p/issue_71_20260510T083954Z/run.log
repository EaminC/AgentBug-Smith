from unittest.mock import patch, MagicMock
from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


class DummyOpenAIClient:
    class Chat:
        class Completions:
            def create(self, **kwargs):
                # Return a dummy response object with .choices[0].message.content
                class DummyResponse:
                    def __init__(self):
                        self.choices = [MagicMock()]
                        self.choices[0].message = MagicMock()
                        self.choices[0].message.content = "dummy response"

                return DummyResponse()

        completions = Completions()

    chat = Chat()


@pytest.fixture
def openai_model():
    # Instantiate the OpenAIChatWrapper with a dummy client to avoid real API calls
    model = OpenAIChatWrapper(model_name="gpt-3.5-turbo")
    model.client = DummyOpenAIClient()
    return model


def test_openai_model_accepts_list_of_messages(openai_model):
    # Provide a list of dict messages with role and content keys
    messages = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "What is the time?"}
    ]
    # Should NOT raise exception
    response = openai_model(messages)
    assert hasattr(response, "choices")
    assert response.choices[0].message.content == "dummy response"


def test_openai_model_accepts_single_message_dict_raises(openai_model):
    # Provide a single dict (not list) with role and content keys
    single_message = {"role": "user", "content": "Hello"}
    with pytest.raises(ValueError) as excinfo:
        openai_model(single_message)
    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_accepts_list_of_Msg_objects(openai_model):
    # Provide a list of Msg objects
    msgs = [
        Msg(name="system", role="system", content="You are a helpful assistant."),
        Msg(name="user", role="user", content="What is the time?")
    ]
    # Should NOT raise exception
    response = openai_model(msgs)
    assert hasattr(response, "choices")
    assert response.choices[0].message.content == "dummy response"


def test_openai_model_accepts_list_of_dicts_with_role_and_content(openai_model):
    # Provide a list of dicts with role and content keys, but with extra keys
    messages = [
        {"role": "system", "content": "You are a helpful assistant.", "extra": "ignore"},
        {"role": "user", "content": "What is the time?", "foo": "bar"}
    ]
    # Should NOT raise exception
    response = openai_model(messages)
    assert hasattr(response, "choices")
    assert response.choices[0].message.content == "dummy response"


def test_openai_model_rejects_list_missing_role_or_content(openai_model):
    # Provide a list with one dict missing 'role'
    messages_missing_role = [
        {"content": "Hello"}
    ]
    with pytest.raises(ValueError) as excinfo:
        openai_model(messages_missing_role)
    assert "must contain a 'role' and 'content'" in str(excinfo.value)

    # Provide a list with one dict missing 'content'
    messages_missing_content = [
        {"role": "user"}
    ]
    with pytest.raises(ValueError) as excinfo:
        openai_model(messages_missing_content)
    assert "must contain a 'role' and 'content'" in str(excinfo.value)[0m
