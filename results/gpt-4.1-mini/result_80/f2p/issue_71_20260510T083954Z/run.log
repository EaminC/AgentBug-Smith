[32mimport pytest
from unittest.mock import patch
from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


@pytest.fixture
def openai_model():
    # Provide config_name as required by OpenAIWrapper __init__
    model = OpenAIChatWrapper(config_name="gpt-3.5-turbo")
    return model


def test_openai_model_rejects_single_dict(openai_model):
    # Passing a single dict instead of list should raise ValueError before any API call
    single_message = {"role": "user", "content": "Hello"}
    with pytest.raises(ValueError) as excinfo:
        openai_model(single_message)
    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_accepts_list_of_dicts_with_role_and_content(openai_model):
    # Passing a list of dicts with role and content keys should not raise ValueError
    messages = [
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there!"},
    ]
    # Mock the internal openai client call to avoid real API call
    with patch("openai.chat.completions.create") as mock_create:
        mock_create.return_value = {
            "choices": [{"message": {"role": "assistant", "content": "Hi there!"}}]
        }
        response = openai_model(messages)
        assert hasattr(response, "text")


def test_openai_model_accepts_list_of_Msg_objects(openai_model):
    # Passing a list of Msg objects with role and content should be accepted
    msgs = [
        Msg(name="user", role="user", content="Hello"),
        Msg(name="assistant", role="assistant", content="Hi there!"),
    ]
    # Convert Msg objects to dicts for the model call since model expects dicts
    dict_msgs = [msg.to_dict() for msg in msgs]
    with patch("openai.chat.completions.create") as mock_create:
        mock_create.return_value = {
            "choices": [{"message": {"role": "assistant", "content": "Hi there!"}}]
        }
        response = openai_model(dict_msgs)
        assert hasattr(response, "text")


def test_openai_model_accepts_list_of_messages(openai_model):
    # Passing a list of messages as dicts with role and content keys should succeed
    msgs = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "What is the time?"},
    ]
    with patch("openai.chat.completions.create") as mock_create:
        mock_create.return_value = {
            "choices": [{"message": {"role": "assistant", "content": "It is noon."}}]
        }
        response = openai_model(msgs)
        assert hasattr(response, "text")


def test_openai_model_rejects_list_missing_role_or_content(openai_model):
    # Passing a list with a dict missing role or content should raise ValueError
    msgs_missing_role = [{"content": "Hello"}]
    msgs_missing_content = [{"role": "user"}]
    with pytest.raises(ValueError):
        openai_model(msgs_missing_role)
    with pytest.raises(ValueError):
        openai_model(msgs_missing_content)[0m
