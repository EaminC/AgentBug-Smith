[32mimport pytest
from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


class DummyOpenAIChatWrapper(OpenAIChatWrapper):
    def __init__(self):
        # Do not call super().__init__ to avoid real client setup
        self.generate_args = {}

    def __call__(self, messages, **kwargs):
        # Use the original __call__ logic but patch out the actual API call
        # We only want to test the message validation logic here
        # Copy from OpenAIChatWrapper.__call__ but skip client call
        # step1: merge kwargs
        kwargs = {**self.generate_args, **kwargs}

        # step2: checking messages
        if not isinstance(messages, list):
            raise ValueError(
                "OpenAI `messages` field expected type `list`, "
                f"got `{type(messages)}` instead.",
            )
        if not all("role" in msg and "content" in msg for msg in messages):
            raise ValueError(
                "Each message in the 'messages' list must contain a 'role' "
                "and 'content' key for OpenAI API.",
            )
        # Instead of calling the API, return a dummy response object with .text
        class DummyResponse:
            text = "dummy response"
        return DummyResponse()


@pytest.fixture
def openai_model():
    return DummyOpenAIChatWrapper()


def test_openai_model_rejects_single_dict(openai_model):
    # Passing a single dict (not in a list) should raise ValueError about type
    single_message = {"role": "user", "content": "Hello"}
    with pytest.raises(ValueError) as excinfo:
        openai_model(single_message)
    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_accepts_list_of_dicts_with_role_and_content(openai_model):
    # Passing a list of dicts with role and content keys should succeed
    messages = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Hello, how are you?"},
    ]
    response = openai_model(messages)
    assert hasattr(response, "text")
    assert response.text == "dummy response"


def test_openai_model_accepts_list_of_Msg_objects(openai_model):
    # Passing a list of Msg objects with role and content should succeed
    messages = [
        Msg(name="system", role="system", content="You are a helpful assistant."),
        Msg(name="user", role="user", content="Hello, how are you?"),
    ]
    # Convert Msg objects to dicts for the model call
    dict_messages = [{"role": m.role, "content": m.content} for m in messages]
    response = openai_model(dict_messages)
    assert hasattr(response, "text")
    assert response.text == "dummy response"


def test_openai_model_accepts_list_of_messages(openai_model):
    # Passing a list of dict-like messages with role and content keys should succeed
    messages = [
        {"role": "assistant", "content": "I am fine, thank you."},
    ]
    response = openai_model(messages)
    assert hasattr(response, "text")
    assert response.text == "dummy response"[0m
