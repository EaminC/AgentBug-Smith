from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


@pytest.fixture
def openai_model():
    # The OpenAIChatWrapper requires a config_name argument.
    # We provide a dummy config_name and patch the internal openai client call to avoid real API calls.
    with patch("openai.chat.completions.create") as mock_create:
        mock_create.return_value = {
            "choices": [{"message": {"role": "assistant", "content": "dummy response"}}]
        }
        model = OpenAIChatWrapper(config_name="gpt-3.5-turbo")
        yield model


def test_openai_model_accepts_single_message_dict(openai_model):
    # Test that passing a single dict with 'role' and 'content' keys works without exception.
    single_message = {"role": "user", "content": "Hello, world!"}

    # The buggy code expects a list, so this should raise ValueError before the fix.
    # After the fix, it should raise a ValueError about expecting a list.
    # So we test that it raises a ValueError with the expected message about type.
    with pytest.raises(ValueError) as excinfo:
        openai_model(single_message)
    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_with_Msg_object(openai_model):
    # Test that passing a single Msg object (not a list) also raises the expected ValueError about type.
    msg = Msg(name="user", role="user", content="Hello from Msg object")

    # The __call__ method expects a list of dicts, not a single Msg.
    # So passing a single Msg should raise a ValueError about expecting a list.
    with pytest.raises(ValueError) as excinfo:
        openai_model(msg)
    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_accepts_list_of_messages(openai_model):
