def test_openai_model_rejects_single_dict(openai_model):
    # Passing a single dict instead of a list should raise ValueError
    single_message = {"role": "user", "content": "Hello"}
    with pytest.raises(ValueError) as e:
        openai_model(single_message)
    assert "expected type `list`" in str(e.value)


def test_openai_model_accepts_list_of_dicts_with_role_and_content(openai_model):
    # Passing a list of dicts with role and content keys should pass validation and return ModelResponse
    messages = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "What is the weather today?"},
    ]
    result = openai_model(messages)
    assert isinstance(result, ModelResponse)
    assert result.text == "mocked response"
    assert "mocked" in result.raw


def test_openai_model_rejects_list_missing_role_or_content(openai_model):
    # Passing a list where one dict misses role or content should raise ValueError
    messages_missing_role = [
        {"content": "Hello"},
    ]
    with pytest.raises(ValueError):
        openai_model(messages_missing_role)

    messages_missing_content = [
        {"role": "user"},
    ]
    with pytest.raises(ValueError):
        openai_model(messages_missing_content)


def test_openai_model_accepts_list_of_Msg_objects(openai_model):
    # Passing a list of Msg objects with role and content attributes should be accepted after converting to dicts
    # But the model expects list of dicts, so we convert Msg to dict before calling
    msgs = [
        Msg(name="system", role="system", content="You are a helpful assistant."),
        Msg(name="user", role="user", content="Hello"),
    ]
    # Convert Msg objects to dicts for the call as the model expects dicts
    dict_msgs = [msg.to_dict() for msg in msgs]
    result = openai_model(dict_msgs)
    assert isinstance(result, ModelResponse)
    assert result.text == "mocked response"


