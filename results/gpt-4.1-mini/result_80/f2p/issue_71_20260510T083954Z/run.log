[32mimport pytest
from unittest.mock import patch, MagicMock

from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


@pytest.fixture
def openai_model():
    # OpenAIChatWrapper requires config_name argument, provide a dummy one.
    model = OpenAIChatWrapper(config_name="gpt-3.5-turbo")
    # Patch the internal client call to avoid real API calls.
    model.client = MagicMock()
    model.client.chat.completions.create = MagicMock(return_value={"choices": [{"message": {"content": "dummy response"}}]})
    return model


def test_openai_model_rejects_single_dict(openai_model):
    # Passing a single dict instead of a list should raise ValueError about type.
    single_message = {"role": "user", "content": "Hello"}
    with pytest.raises(ValueError) as excinfo:
        openai_model(single_message)
    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_accepts_list_of_dicts_with_role_and_content(openai_model):
    # Passing a list of dicts with role and content keys should succeed.
    messages = [{"role": "user", "content": "Hello"}]
    result = openai_model(messages)
    # The mocked client returns a dict with choices list containing message content.
    assert hasattr(result, "text")
    assert "dummy response" in result.text


def test_openai_model_accepts_list_of_Msg_objects(openai_model):
    # Passing a list of Msg objects should succeed.
    messages = [Msg(name="user", role="user", content="Hello")]
    result = openai_model(messages)
    assert hasattr(result, "text")
    assert "dummy response" in result.text


def test_openai_model_accepts_list_of_messages(openai_model):
    # Passing a list of mixed dict and Msg objects with role and content keys should succeed.
    messages = [
        {"role": "system", "content": "System message"},
        Msg(name="user", role="user", content="User message"),
    ]
    result = openai_model(messages)
    assert hasattr(result, "text")
    assert "dummy response" in result.text[0m
