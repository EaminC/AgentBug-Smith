[32mimport pytest
from unittest.mock import patch

from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


@pytest.fixture
def openai_model():
    # Instantiate the OpenAIChatWrapper with minimal required args
    # Use config_name to avoid TypeError for missing positional argument
    model = OpenAIChatWrapper(config_name="gpt-3.5-turbo")
    # Patch the client.chat.completions.create method to avoid real API calls
    with patch.object(model.client.chat.completions, "create") as mock_create:
        mock_create.return_value = {
            "choices": [{"message": {"role": "assistant", "content": "dummy response"}}]
        }
        yield model


def test_openai_model_rejects_single_dict(openai_model):
    # Passing a single dict instead of a list should raise ValueError
    single_message = {"role": "user", "content": "Hello"}
    with pytest.raises(ValueError) as e:
        openai_model(single_message)
    assert "expected type `list`" in str(e.value)


def test_openai_model_accepts_list_of_dicts_with_role_and_content(openai_model):
    # Passing a list of dicts with role and content keys should succeed
    messages = [
        {"role": "system", "content": "System message"},
        {"role": "user", "content": "User message"},
    ]
    response = openai_model(messages)
    # The dummy response text is "dummy response"
    assert hasattr(response, "text")
    assert "dummy response" in response.text


def test_openai_model_accepts_list_of_Msg_objects(openai_model):
    # Passing a list of Msg objects with role and content keys should succeed
    messages = [
        Msg(name="system", role="system", content="System message"),
        Msg(name="user", role="user", content="User message"),
    ]
    # Convert Msg objects to dicts for the model call (simulate internal behavior)
    dict_messages = [msg.to_dict() for msg in messages]
    response = openai_model(dict_messages)
    assert hasattr(response, "text")
    assert "dummy response" in response.text


def test_openai_model_accepts_list_of_messages(openai_model):
    # Passing a mixed list of dict and Msg objects with role and content keys should succeed
    msgs = [
        {"role": "system", "content": "System message"},
        Msg(name="user", role="user", content="User message"),
    ]
    # Convert Msg objects to dicts for the model call (simulate internal behavior)
    dict_msgs = [msg if isinstance(msg, dict) else msg.to_dict() for msg in msgs]
    response = openai_model(dict_msgs)
    assert hasattr(response, "text")
    assert "dummy response" in response.text


def test_openai_model_rejects_list_missing_role_or_content(openai_model):
    # Passing a list with a dict missing 'role' or 'content' should raise ValueError
    invalid_messages = [
        {"role": "system", "content": "System message"},
        {"content": "Missing role"},
    ]
    with pytest.raises(ValueError) as e:
        openai_model(invalid_messages)
    assert "must contain a 'role' and 'content' key" in str(e.value)[0m
