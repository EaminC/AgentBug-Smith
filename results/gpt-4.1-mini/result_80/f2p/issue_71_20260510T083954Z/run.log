from unittest.mock import patch, MagicMock
from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


class DummyResponse:
    def __init__(self, text):
        self.text = text


class DummyClient:
    def __init__(self):
        self.chat = MagicMock()
        self.chat.completions = MagicMock()
        self.chat.completions.create = MagicMock(return_value=DummyResponse("dummy response"))


@pytest.fixture
def openai_model():
    # Instantiate the OpenAIChatWrapper with a dummy client to avoid real API calls
    model = OpenAIChatWrapper(model_name="gpt-3.5-turbo")
    model.client = DummyClient()
    return model


def test_openai_model_accepts_list_of_dicts_with_role_and_content(openai_model):
    # Pass a list of dicts with role and content keys - should pass
    messages = [
        {"role": "system", "content": "System message"},
        {"role": "user", "content": "User message"},
    ]
    result = openai_model(messages)
    assert result.text == "dummy response"


def test_openai_model_accepts_list_of_Msg_objects(openai_model):
    # Pass a list of Msg objects - should pass
    messages = [
        Msg(name="system", role="system", content="System message"),
        Msg(name="user", role="user", content="User message"),
    ]
    result = openai_model(messages)
    assert result.text == "dummy response"


def test_openai_model_accepts_list_of_messages(openai_model):
    # Pass a mixed list of dict and Msg objects - should pass
    messages = [
        {"role": "system", "content": "System message"},
        Msg(name="user", role="user", content="User message"),
    ]
    result = openai_model(messages)
    assert result.text == "dummy response"


def test_openai_model_rejects_single_dict_not_in_list(openai_model):
    # Pass a single dict (not in a list) - should raise ValueError due to type check
    single_message = {"role": "user", "content": "Single message"}
    with pytest.raises(ValueError) as excinfo:
        openai_model(single_message)
    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_rejects_list_missing_role_or_content(openai_model):
    # Pass a list with one dict missing 'role' key - should raise ValueError
    messages = [
        {"role": "system", "content": "System message"},
        {"content": "Missing role"},
    ]
    with pytest.raises(ValueError) as excinfo:
        openai_model(messages)
    assert "must contain a 'role' and 'content' key" in str(excinfo.value)


def test_openai_model_accepts_single_Msg_object_wrapped_in_list(openai_model):
    # Pass a single Msg object wrapped in a list - should pass
    messages = [Msg(name="user", role="user", content="Single Msg in list")]
    result = openai_model(messages)
    assert result.text == "dummy response"[0m
