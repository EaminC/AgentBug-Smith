[32mimport pytest
from unittest.mock import patch, MagicMock
from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


@pytest.fixture
def openai_model():
    # Initialize the OpenAIChatWrapper with a dummy model name.
    # We patch the internal client to avoid real API calls.
    model = OpenAIChatWrapper(model_name="gpt-3.5-turbo")

    # Patch the client's chat.completions.create method to return a dummy response
    dummy_response = MagicMock()
    dummy_response.text = "dummy response"

    patcher = patch.object(model.client.chat.completions, "create", return_value=dummy_response)
    patcher.start()
    yield model
    patcher.stop()


def test_openai_model_rejects_single_dict(openai_model):
    # Passing a single dict instead of a list should raise a ValueError about type
    single_message = {"role": "user", "content": "Hello"}
    with pytest.raises(ValueError) as excinfo:
        openai_model(single_message)
    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_accepts_list_of_dicts_with_role_and_content(openai_model):
    # Passing a list of dicts with role and content keys should NOT raise
    messages = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Hello"},
    ]
    response = openai_model(messages)
    assert hasattr(response, "text")
    assert response.text == "dummy response"


def test_openai_model_accepts_list_of_Msg_objects(openai_model):
    # Passing a list of Msg objects with role and content keys should NOT raise
    messages = [
        Msg(name="system", role="system", content="You are a helpful assistant."),
        Msg(name="user", role="user", content="Hello"),
    ]
    response = openai_model(messages)
    assert hasattr(response, "text")
    assert response.text == "dummy response"


def test_openai_model_accepts_list_of_messages(openai_model):
    # Passing a mixed list of dict and Msg objects with role and content keys should NOT raise
    messages = [
        {"role": "system", "content": "You are a helpful assistant."},
        Msg(name="user", role="user", content="Hello"),
    ]
    response = openai_model(messages)
    assert hasattr(response, "text")
    assert response.text == "dummy response"[0m
