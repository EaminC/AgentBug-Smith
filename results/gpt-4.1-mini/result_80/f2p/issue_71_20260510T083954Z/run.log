[32mimport pytest
from unittest import mock

from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


@pytest.fixture
def openai_model():
    # Instantiate the OpenAIChatWrapper with minimal config for testing
    # Use a dummy model config name
    return OpenAIChatWrapper(model_name="gpt-3.5-turbo")


def test_openai_model_rejects_single_dict(openai_model):
    # Passing a single dict (not a list) should raise a ValueError
    single_message = {"role": "user", "content": "Hello"}

    with pytest.raises(ValueError) as e:
        openai_model(single_message)
    assert "expected type `list`" in str(e.value)


def test_openai_model_accepts_list_of_dicts_with_role_and_content(openai_model):
    # Passing a list of dicts with role and content should NOT raise ValueError
    messages = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "What is the time?"},
    ]

    # Mock the internal openai client call to avoid real API call
    with mock.patch.object(
        openai_model.client.chat.completions,
        "create",
        return_value={"choices": [{"message": {"role": "assistant", "content": "It is noon."}}]},
    ) as mock_create:
        response = openai_model(messages)
        # The response should have attribute text (from the wrapper)
        assert hasattr(response, "text")
        # The mock was called once
        mock_create.assert_called_once()


def test_openai_model_accepts_list_of_Msg_objects(openai_model):
    # Passing a list of Msg objects with role and content should NOT raise ValueError
    msgs = [
        Msg(name="system", role="system", content="You are a helpful assistant."),
        Msg(name="user", role="user", content="What is the time?"),
    ]

    # Convert Msg objects to dicts for the model call (the wrapper should handle this)
    # But we call with the Msg list directly to simulate usage
    with mock.patch.object(
        openai_model.client.chat.completions,
        "create",
        return_value={"choices": [{"message": {"role": "assistant", "content": "It is noon."}}]},
    ) as mock_create:
        response = openai_model(msgs)
        assert hasattr(response, "text")
        mock_create.assert_called_once()


def test_openai_model_accepts_list_of_messages(openai_model):
    # Passing a list of messages as dict-like objects with role and content keys
    # but not necessarily dicts (e.g., Msg or similar) should work
    class DummyMsg:
        def __init__(self, role, content):
            self.role = role
            self.content = content

        def __getitem__(self, key):
            if key == "role":
                return self.role
            elif key == "content":
                return self.content
            raise KeyError(key)

        def __contains__(self, key):
            return key in ("role", "content")

    msgs = [DummyMsg("system", "You are a helpful assistant."), DummyMsg("user", "What is the time?")]

    with mock.patch.object(
