from src.agentscope.message import Msg


@pytest.fixture
def openai_model():
    # Patch the internal client.chat.completions.create to avoid real API calls
    with patch("src.agentscope.models.openai_model.OpenAIChatWrapper.client", create=True) as mock_client:
        # Setup a dummy response for the mocked client
        mock_response = MagicMock()
        mock_response.choices = [MagicMock(message={"content": "dummy response"})]
        mock_client.chat.completions.create.return_value = mock_response

        # OpenAIChatWrapper requires config_name argument
        instance = OpenAIChatWrapper(config_name="gpt-3.5-turbo")
        yield instance


def test_openai_model_rejects_single_dict(openai_model):
    # Passing a single dict instead of a list should raise ValueError about type
    single_message = {"role": "user", "content": "Hello"}
    with pytest.raises(ValueError) as excinfo:
        openai_model(single_message)
    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_accepts_list_of_dicts_with_role_and_content(openai_model):
    # Passing a list of dicts with role and content keys should succeed
    messages = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Hello, who won the world cup in 2022?"},
    ]
    result = openai_model(messages)
    # The .text property should return the dummy response content
    assert hasattr(result, "text")
    assert result.text == "dummy response"


def test_openai_model_rejects_list_missing_role_or_content(openai_model):
    # List with one dict missing "role" key should raise ValueError
    messages_missing_role = [
        {"content": "Hello"},
    ]
    with pytest.raises(ValueError) as excinfo:
        openai_model(messages_missing_role)
    assert "must contain a 'role'" in str(excinfo.value)

    # List with one dict missing "content" key should raise ValueError
    messages_missing_content = [
        {"role": "user"},
    ]
    with pytest.raises(ValueError) as excinfo:
        openai_model(messages_missing_content)
    assert "must contain a 'role'" in str(excinfo.value)


def test_openai_model_accepts_list_of_Msg_objects(openai_model):
    # Passing a list of Msg objects should work, as Msg supports dict-like access
    messages = [
        Msg(name="system", role="system", content="System prompt"),
        Msg(name="user", role="user", content="Hello!"),
    ]
    result = openai_model(messages)
    assert hasattr(result, "text")
    assert result.text == "dummy response"


def test_openai_model_raises_if_list_contains_non_dict(openai_model):
    # List containing non-dict (e.g. string) should raise ValueError
    messages = [
        {"role": "user", "content": "Hello"},
        "this is a string, not a dict",
    ]
    with pytest.raises(ValueError) as excinfo:
        openai_model(messages)
    assert "must contain a 'role'" in str(excinfo.value) or "Each message" in str(excinfo.value)[0m
