[32mimport pytest
from unittest.mock import patch, MagicMock

from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


@pytest.fixture
def openai_model():
    # The OpenAIChatWrapper requires a config_name argument for initialization.
    # We provide a dummy config_name and patch the internal client call to avoid real API calls.
    model = OpenAIChatWrapper(config_name="gpt-3.5-turbo")
    # Patch the internal client call to avoid real API calls
    patcher = patch.object(model.client.chat.completions, "create", return_value=MagicMock(choices=[MagicMock(message={"content": "dummy response"})]))
    patcher.start()
    yield model
    patcher.stop()


def test_openai_model_accepts_list_of_messages(openai_model):
    # Should accept a list of dict messages with role and content keys
    messages = [
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi, how can I help you?"},
    ]
    result = openai_model(messages)
    assert hasattr(result, "text")
    assert "dummy response" in result.text


def test_openai_model_accepts_single_message_dict_raises(openai_model):
    # Passing a single dict instead of a list should raise ValueError about type
    single_message = {"role": "user", "content": "Hello"}
    with pytest.raises(ValueError) as excinfo:
        openai_model(single_message)
    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_accepts_list_of_Msg_objects(openai_model):
    # Passing a list of Msg objects should work if they convert properly to dicts
    msgs = [Msg(name="user", role="user", content="Hello"), Msg(name="assistant", role="assistant", content="Hi")]
    # Convert Msg objects to dicts for the call as the model expects dicts
    dict_msgs = [msg.to_dict() for msg in msgs]
    result = openai_model(dict_msgs)
    assert hasattr(result, "text")
    assert "dummy response" in result.text


def test_openai_model_accepts_list_of_dicts_with_role_and_content(openai_model):
    # Passing a list of dicts with role and content keys should pass validation
    messages = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "What is the weather today?"},
    ]
    result = openai_model(messages)
    assert hasattr(result, "text")
    assert "dummy response" in result.text


def test_openai_model_rejects_list_missing_role_or_content(openai_model):
    # Passing a list with dicts missing role or content keys should raise ValueError
    bad_messages = [
        {"role": "user", "content": "Hello"},
        {"content": "Missing role key"},
    ]
    with pytest.raises(ValueError) as excinfo:
        openai_model(bad_messages)
    assert "must contain a 'role' and 'content' key" in str(excinfo.value)[0m
