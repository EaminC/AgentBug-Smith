def test_openai_model_rejects_single_dict(openai_model):
    # Passing a single dict instead of list should raise ValueError about type
    single_message = {"role": "user", "content": "Hello"}
    with pytest.raises(ValueError) as excinfo:
        openai_model(single_message)
    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_accepts_list_of_dicts_with_role_and_content(openai_model):
    # Passing a list of dicts with role and content keys should succeed
    messages = [
        {"role": "system", "content": "System message"},
        {"role": "user", "content": "User message"},
    ]
    # This should not raise and should return a response with .text attribute
    response = openai_model(messages)
    assert hasattr(response, "text")
    assert "dummy response" in response.text


def test_openai_model_accepts_list_of_Msg_objects(openai_model):
    # Passing a list of Msg objects with role and content keys should succeed
    messages = [
        Msg(name="system", role="system", content="System message"),
        Msg(name="user", role="user", content="User message"),
    ]
    # Convert Msg objects to dicts for the model call (simulate internal behavior)
    dict_messages = [msg.to_dict() for msg in messages]
    response = openai_model(dict_messages)
    assert hasattr(response, "text")
    assert "dummy response" in response.text


def test_openai_model_accepts_list_of_messages(openai_model):
    # Passing a mixed list of dict and Msg objects with role and content keys should succeed
    msgs = [
        {"role": "system", "content": "System message"},
        Msg(name="user", role="user", content="User message"),
    ]
    # Convert Msg objects to dicts for the model call (simulate internal behavior)
    dict_msgs = [msg if isinstance(msg, dict) else msg.to_dict() for msg in msgs]
