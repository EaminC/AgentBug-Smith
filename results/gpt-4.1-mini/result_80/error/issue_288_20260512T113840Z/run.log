[32m# This is a Node.js project, not Python, based on package.json and package-lock.json presence.
# Use official Node.js 18 image as base (aligns with engines field).
FROM node:18-alpine AS test_builder

ARG NODE_ENV=development
ENV NODE_ENV=${NODE_ENV}

WORKDIR /app

# Copy package.json and lockfile for dependency installation
COPY package.json package-lock.json ./

# Install dependencies (including dev) with npm ci for reproducibility
RUN npm ci

# Copy all source code to preserve injected tests or scripts
COPY . .

# Run Prisma schema modifications and generate client, migrate and push DB
RUN if [ -f ".env.docker" ]; then mv .env.docker .env; fi && \
    if [ -f "prisma/schema.prisma" ]; then \
      sed -ie 's/postgresql/sqlite/g' prisma/schema.prisma && \
      sed -ie 's/mysql/sqlite/g' prisma/schema.prisma && \
      sed -ie 's/@db.Text//' prisma/schema.prisma && \
      npx prisma generate && \
      npx prisma migrate dev --name init && \
      npx prisma db push; \
    fi

# Build the Next.js app
RUN npm run build

# Preflight to ensure basic dependencies are correctly installed and runnable
RUN node -e "console.log('preflight ok')"

# Set Forge environment variables as required
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Final minimal runtime image
FROM node:18-alpine AS runtime

WORKDIR /app

# Copy production dependencies and build output from test_builder stage
COPY --from=test_builder /app/package.json /app/package-lock.json ./
COPY --from=test_builder /app/node_modules ./node_modules
COPY --from=test_builder /app/.next ./.next
COPY --from=test_builder /app/public ./public
COPY --from=test_builder /app/prisma ./prisma
COPY --from=test_builder /app/next.config.mjs ./next.config.mjs
COPY --from=test_builder /app/tailwind.config.cjs ./tailwind.config.cjs
COPY --from=test_builder /app/postcss.config.cjs ./postcss.config.cjs
COPY --from=test_builder /app/prettier.config.cjs ./prettier.config.cjs
COPY --from=test_builder /app/tsconfig.json ./tsconfig.json
COPY --from=test_builder /app/jest.config.cjs ./jest.config.cjs
COPY --from=test_builder /app/README.md ./README.md
COPY --from=test_builder /app/.gitignore ./.gitignore

# Copy all source code to runtime image (for completeness, though not strictly necessary for production)
COPY --from=test_builder /app/src ./src

# Set Forge environment variables in runtime image
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Expose port 3000 as per Next.js default start port
EXPOSE 3000

# Default command to start the app as per package.json start script
CMD ["npm", "start"][0m
