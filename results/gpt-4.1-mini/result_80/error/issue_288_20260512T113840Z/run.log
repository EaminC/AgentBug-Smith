# Install dependencies and test tools for Python with robust checks
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt && pip install -e . && pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
      pip install poetry && poetry install && pip install -e . && pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    elif [ -f "pyproject.toml" ]; then \
      pip install -e . && pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    else \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    fi

# Run preflight test to verify installations
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command to keep container open in bash
CMD ["/bin/bash"]

