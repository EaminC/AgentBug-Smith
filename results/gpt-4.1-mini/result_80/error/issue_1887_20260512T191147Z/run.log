[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set environment variables for Forge API compatibility and Python environment
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY="forge-key" \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN="forge-key" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system dependencies needed for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libffi-dev libssl-dev libxml2-dev libxslt1-dev python3-dev libyaml-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel and Cython versions (restrict setuptools to 81.0.0 for compatibility)
RUN python -m pip install --upgrade pip setuptools==81.0.0 wheel Cython

# Copy entire repository to container
COPY . .

# Remove playsound==1.2.2 from requirements.txt if present to avoid build issues
RUN if [ -f "requirements.txt" ]; then sed -i '/playsound==1.2.2/d' requirements.txt; fi

# Install dependencies from requirements.txt with PYYAML_FORCE_CYTHON=0 workaround
RUN if [ -f "requirements.txt" ]; then \
    PYYAML_FORCE_CYTHON=0 pip install --no-cache-dir -r requirements.txt; \
    fi

# Install required testing dependencies explicitly with compatible setuptools version
RUN pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio litellm pytest-xdist pytest-timeout setuptools==81.0.0

# Install the project in editable mode to allow standalone script imports
RUN pip install --no-cache-dir -e .

# Ensure PYTHONPATH is set for flat repository layout
ENV PYTHONPATH=/app

# Preflight test to verify installations
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command to launch bash shell
CMD ["/bin/bash"]

# branch: python/requirements.txt
