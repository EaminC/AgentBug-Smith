[32mFROM python:3.10-slim AS test_builder

WORKDIR /app

COPY . .

ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Upgrade pip and packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Detect if src/ directory or import src. exists in tests to adjust install strategy
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        pip install -r requirements.txt 2>/dev/null || true && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    else \
        pip install -r requirements.txt 2>/dev/null || true && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# Set PYTHONPATH if src/ layout detected to avoid editable install
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        echo "src layout detected, setting PYTHONPATH"; \
    fi

ENV PYTHONPATH=/app

# Preflight import check to fail fast if missing core packages
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests to verify the build
RUN pytest

# Minimal runtime image
FROM python:3.10-slim

WORKDIR /app

COPY . .

ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=${FORGE_API_KEY} \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Upgrade pip and install only production dependencies from requirements.txt if present
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt 2>/dev/null || true

# Install the package itself
RUN pip install -e .

# Final preflight import check
RUN python -c 'import pkg_resources; print("runtime preflight ok")'

CMD ["/bin/bash"][0m
