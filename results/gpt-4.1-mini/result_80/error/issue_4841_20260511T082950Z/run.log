@pytest.mark.parametrize(
    "state_schema",
    [
        dict,
    ],
)
def test_fail2pass_create_react_agent_post_model_hook_inject_state(state_schema) -> None:
    """
    This test verifies that when using create_react_agent with a post_model_hook,
    the state and store are correctly injected into tool calls.

    Before the fix, this test should fail with a ValidationError due to missing 'state' in tool call args.
    After the fix, it should pass and produce the expected tool output.
    """

    the_news = "News are boring."

    @tool("read_the_news", description="Read the news")
    def read_the_news(state: Annotated[dict, InjectedState]):
        return the_news

    class FakeMessagesListChatModelWithToolCalls(FakeMessagesListChatModel):
        def bind_tools(self, tools, *, tool_choice=None, **kwargs):
            return self

    tool_call = ToolCall(name="read_the_news", args={}, id="1")
    model = FakeMessagesListChatModelWithToolCalls(
        responses=[
            AIMessage(
                content="I will check the news.",
                tool_calls=[tool_call],
            )
        ]
    )

    checkpointer = MemorySaver()
    store = InMemoryStore()

    # Agent without post_model_hook (should work)
    agent_ok = create_react_agent(
        model=model,
        tools=[read_the_news],
        checkpointer=checkpointer,
        store=store,
        state_schema=state_schema,
    )
    config_ok = {"configurable": {"thread_id": "ok"}, "recursion_limit": 4}
    response_ok = agent_ok.invoke({"messages": ["What's on the news?"]}, config_ok)
    assert response_ok["messages"][-1].content == the_news

    # Agent with post_model_hook (should fail before fix, pass after fix)
