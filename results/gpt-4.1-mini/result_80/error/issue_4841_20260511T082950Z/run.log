import pytest
from typing import Annotated

from langgraph.prebuilt import create_react_agent, InjectedState
from langchain_core.tools import tool
from langchain_core.language_models import FakeMessagesListChatModel
from langchain_core.messages import AIMessage, ToolCall
from langgraph.errors import GraphRecursionError
from langgraph.checkpoint.memory import MemorySaver
from langchain_core.messages import ToolMessage
from langgraph.store.memory import InMemoryStore
from langgraph.prebuilt.tool_node import InjectedStore
from langgraph.prebuilt import AgentState, AgentStatePydantic
from langchain_core.messages import HumanMessage
from langgraph.prebuilt.tests.test_react_agent import AgentStateExtraKey, AgentStateExtraKeyPydantic, _AnyIdToolMessage


@pytest.mark.parametrize(
    "state_schema", [AgentStateExtraKey, AgentStateExtraKeyPydantic]
)
def test_create_react_agent_inject_vars_with_post_model_hook(
    state_schema,
) -> None:
    """
    This test verifies that when using create_react_agent with a post_model_hook,
    the state and store are correctly injected into tool calls.

    Before the fix, this test fails due to missing state injection causing validation errors.
    After the fix, this test passes.
    """
    store = InMemoryStore()
    namespace = ("test",)
    store.put(namespace, "test_key", {"bar": 3})

    if issubclass(state_schema, AgentStatePydantic):

        @tool
        def tool1(
            some_val: int,
            state: Annotated[AgentStateExtraKeyPydantic, InjectedState],
            store: Annotated[InMemoryStore, InjectedStore()],
        ) -> str:
            store_val = store.get(namespace, "test_key").value["bar"]
            return some_val + state.foo + store_val

    else:

        @tool
        def tool1(
            some_val: int,
            state: Annotated[dict, InjectedState],
            store: Annotated[InMemoryStore, InjectedStore()],
        ) -> str:
            store_val = store.get(namespace, "test_key").value["bar"]
            return some_val + state["foo"] + store_val

    tool_call = {
        "name": "tool1",
        "args": {"some_val": 1},
        "id": "some 0",
        "type": "tool_call",
    }

    def post_model_hook(state: dict) -> None:
        # This hook does nothing but triggers the buggy path before fix
        return

    model = FakeMessagesListChatModel(
        responses=[
            AIMessage(
                content="hi",
                tool_calls=[ToolCall(**tool_call)],
            )
        ]
    )

    agent = create_react_agent(
        model,
        [tool1],
        state_schema=state_schema,
        store=store,
        post_model_hook=post_model_hook,
    )

    input_message = HumanMessage("hi")
    result = agent.invoke({"messages": [input_message], "foo": 2})

    # The expected result is that the tool call runs successfully and returns 6 (1 + 2 + 3)
    # and the final AIMessage content is "hi-hi-6"
    assert result["messages"] == [
        input_message,
        AIMessage(content="hi", tool_calls=[ToolCall(**tool_call)], id="0"),
        _AnyIdToolMessage(content="6", name="tool1", tool_call_id="some 0"),
        AIMessage("hi-hi-6", id="1"),
    ]
    assert result["foo"] == 2


def test_create_react_agent_post_model_hook_state_injection_failure():
    """
    This test reproduces the original bug scenario where a tool requiring state injection
    fails when used with a post_model_hook that does not inject state properly.

    Before the fix, this test raises a GraphRecursionError or validation error.
    After the fix, it should run without error and produce the expected tool output.
    """
    from langgraph.prebuilt import create_react_agent, InjectedState
    from langchain_core.tools import tool
    from langchain_core.language_models import FakeMessagesListChatModel
    from langchain_core.messages import AIMessage, ToolCall
    from langgraph.errors import GraphRecursionError
    from langgraph.checkpoint.memory import MemorySaver

    the_news = "News are boring."

    @tool("read_the_news", description="Read the news")
    def read_the_news(
        state: Annotated[dict, InjectedState],
    ):
        return the_news

    class FakeMessagesListChatModelWithToolCalls(FakeMessagesListChatModel):
        def bind_tools(
            self,
            tools,
            *,
            tool_choice=None,
            **kwargs,
        ):
            return self

    model = FakeMessagesListChatModelWithToolCalls(
        responses=[
            AIMessage(
                content="I will check the news.",
                tool_calls=[ToolCall(name="read_the_news", args={}, id="1")],
            )
        ]
    )

    checkpointer = MemorySaver()

    # Agent without post_model_hook works fine
    agent_ok = create_react_agent(
        model=model,
        tools=[read_the_news],
        checkpointer=checkpointer,
    )

    config_ok = {"configurable": {"thread_id": "ok"}, "recursion_limit": 4}
    response_ok = agent_ok.invoke({"messages": ["What's on the news?"]}, config_ok)
    assert response_ok["messages"][-1].content == the_news

    # Agent with post_model_hook that does nothing triggers the bug before fix
    def post_model_hook(state):
        return

    agent_buggy = create_react_agent(
        model=model,
        tools=[read_the_news],
        post_model_hook=post_model_hook,  # <-- This triggers the buggy path
        checkpointer=checkpointer,
    )

    config_buggy = {"configurable": {"thread_id": "not_ok"}, "recursion_limit": 4}

    # Before fix, invoking this raises GraphRecursionError or validation error
    # After fix, it should return the news content without error
    try:
        response_buggy = agent_buggy.invoke({"messages": ["What's on the news?"]}, config_buggy)
    except GraphRecursionError:
        # This is expected before fix, fail test if no error after fix
        pytest.fail("GraphRecursionError raised: state injection missing in tool calls with post_model_hook")
    except Exception as e:
        # Other exceptions are also failures
