WORKDIR /app

COPY . .

# Upgrade pip and core Python packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies needed for building Python packages (e.g. psycopg, aiosqlite, lxml)
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    libsqlite3-dev \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
 && rm -rf /var/lib/apt/lists/*

# Install Python dependencies, including missing packages required for tests
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt && pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm nbformat mkdocs dataclasses-json langchain_core aiosqlite psycopg; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm nbformat mkdocs dataclasses-json langchain_core aiosqlite psycopg; \
    elif [ -f "pyproject.toml" ]; then \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm nbformat mkdocs dataclasses-json langchain_core aiosqlite psycopg; \
    else \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm nbformat mkdocs dataclasses-json langchain_core aiosqlite psycopg; \
    fi

# Preflight check to verify the environment
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]
# branch: python/requirements.txt or python/pyproject.toml
