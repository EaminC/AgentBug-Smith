[32mfrom typing import Annotated

import pytest
from langchain_core.messages import AIMessage, HumanMessage, ToolMessage
from langchain_core.tools import tool
from langgraph.prebuilt import InjectedState, InjectedStore, create_react_agent
from langgraph.store.memory import InMemoryStore
from tests.messages import _AnyIdToolMessage

from langchain_core.language_models import FakeMessagesListChatModel


@pytest.mark.parametrize(
    "state_schema",
    [
        # Importing these from the existing test file context
        # We use the same state schemas as in the repo tests for consistency
        pytest.lazy_fixture("AgentStateExtraKey"),
        pytest.lazy_fixture("AgentStateExtraKeyPydantic"),
    ],
)
def test_create_react_agent_inject_vars_with_post_model_hook(state_schema) -> None:
    store = InMemoryStore()
    namespace = ("test",)
    store.put(namespace, "test_key", {"bar": 3})

    if hasattr(state_schema, "__fields__"):  # Pydantic model detection
        # Pydantic state schema
        def tool1(
            some_val: int,
            state: Annotated[state_schema, InjectedState],
            store: Annotated[InMemoryStore, InjectedStore()],
        ) -> str:
            store_val = store.get(namespace, "test_key").value["bar"]
            # state.foo for pydantic model
            return some_val + state.foo + store_val
    else:
        # Dict-like state schema
        def tool1(
            some_val: int,
            state: Annotated[dict, InjectedState],
            store: Annotated[InMemoryStore, InjectedStore()],
        ) -> str:
            store_val = store.get(namespace, "test_key").value["bar"]
            return some_val + state["foo"] + store_val

    tool_call = {
        "name": "tool1",
        "args": {"some_val": 1},
        "id": "some 0",
        "type": "tool_call",
    }

    def post_model_hook(state: dict) -> None:
        # This hook does nothing but triggers the buggy code path before fix
        return

    model = FakeMessagesListChatModel(
        responses=[
            AIMessage(
                content="hi",
                tool_calls=[tool_call],
                id="0",
            )
        ]
    )

    agent = create_react_agent(
        model,
        [tool1],
        state_schema=state_schema,
        store=store,
        post_model_hook=post_model_hook,
    )

    input_message = HumanMessage("hi")
    result = agent.invoke({"messages": [input_message], "foo": 2})

    # The expected content is the sum: some_val=1 + foo=2 + bar=3 = 6
    assert result["messages"] == [
        input_message,
        AIMessage(content="hi", tool_calls=[tool_call], id="0"),
        _AnyIdToolMessage(content="6", name="tool1", tool_call_id="some 0"),
        AIMessage("hi-hi-6", id="1"),
    ]
    assert result["foo"] == 2

# Note: This test is designed to fail on the buggy codebase and pass on the fixed codebase.
# It exercises the create_react_agent with a post_model_hook and verifies that the tool call
# receives the injected state and store correctly, avoiding validation errors.[0m
