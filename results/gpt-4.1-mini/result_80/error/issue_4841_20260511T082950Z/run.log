ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set Forge API environment variables for OpenAI and Anthropic SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV FORGE_API_KEY=forge-key

WORKDIR /app

# Copy the entire repository into the image
COPY . .

# Upgrade pip and core packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies needed for building common Python packages and drivers
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libsqlite3-dev \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies, the project itself, and testing requirements
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt && pip install -e . ; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
      pip install poetry && \
      poetry config virtualenvs.create false && \
      poetry install --no-interaction --no-ansi && \
      pip install -e . ; \
    elif [ -f "pyproject.toml" ]; then \
      pip install -e . ; \
    else \
      echo "No requirements.txt or pyproject.toml found, only installing the project in editable mode." && pip install -e . ; \
    fi && \
    pip install \
      pytest \
      pytest-mock \
      pytest-asyncio \
      pytest-cov \
      anyio \
      "setuptools<=81.0.0" \
      litellm \
      nbconvert \
      psycopg[binary] \
      psycopg_pool \
      sqlite_vec \
      mkdocs \
      nbformat \
      aiosqlite \
      dataclasses_json \
      langchain_core \
      langgraph

# Preflight check: verify Python packaging and pytest imports
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]
# branch: python with robust dependency and test package installs, Forge API env vars
