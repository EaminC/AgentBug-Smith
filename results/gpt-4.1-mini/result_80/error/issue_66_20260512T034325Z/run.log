# we will replicate the regex logic here for testing purposes.
# The test will simulate the filtering behavior that the patch fixes.

def real_tasks_filter(input_str: str) -> bool:
    no_task_regex = re.compile(
        r"^No( (new|further|additional|extra|other))? tasks? (is )?(required|needed|added|created|inputted).*$",
        re.IGNORECASE,
    )
    task_complete_regex = re.compile(
        r"^Task (complete|completed|finished|done|over|success).*", re.IGNORECASE
    )
    do_nothing_regex = re.compile(r"^(\s*|Do nothing(\s.*)?)$", re.IGNORECASE)

    return not (
        no_task_regex.match(input_str)
        or task_complete_regex.match(input_str)
        or do_nothing_regex.match(input_str)
    )

