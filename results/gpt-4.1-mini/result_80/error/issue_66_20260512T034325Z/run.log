def realTasksFilter(input: str) -> bool:
    noTaskRegex = re.compile(
        r"^No( (new|further|additional|extra|other))? tasks? (is )?(required|needed|added|created|inputted).*$",
        re.IGNORECASE,
    )
    taskCompleteRegex = re.compile(
        r"^Task (complete|completed|finished|done|over|success).*", re.IGNORECASE
    )
    doNothingRegex = re.compile(r"^(\s*|Do nothing(\s.*)?)$", re.IGNORECASE)

    return not (
        noTaskRegex.match(input)
        or taskCompleteRegex.match(input)
        or doNothingRegex.match(input)
    )


def extractArray(inputStr: str):
    # Simplified extraction: split lines, strip, and keep non-empty lines starting with '-'
    lines = inputStr.strip().splitlines()
    tasks = [line.strip() for line in lines if line.strip().startswith("-")]
    return tasks


