# --- end inject ---

# Set environment variables for Forge API compatibility (OpenAI and Anthropic compatible)
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY="forge-key" \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN="forge-key"

WORKDIR /app

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Install dependencies and test dependencies in a single RUN command
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt; \
    fi && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# Validate test framework is working
RUN python -c 'import pytest; print("preflight ok")'

CMD ["/bin/bash"]
