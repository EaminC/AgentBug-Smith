        "No further tasks needed",
        "No additional tasks created",
        "No extra tasks inputted",
        "Task complete",
        "Task completed successfully",
        "Task finished",
        "Task done",
        "Task over",
        "Task success",
        "Do nothing",
        "   ",
        "",
        "Do nothing for now",
    ]
    for s in non_tasks:
        assert not chain.realTasksFilter(s), f"Should filter out: {s}"


def test_realTasksFilter_accepts_real_tasks():
    # These strings represent valid tasks that should pass the filter
    real_tasks = [
        "Write a summary of the meeting",
        "Create a new feature branch",
        "Fix the bug in the login flow",
        "Add unit tests for the API",
        "Refactor the database schema",
        "Deploy the latest build to staging",
        "Research new authentication methods",
        "Prepare presentation slides for Monday",
        "Update the README file",
        "Schedule a team meeting",
    ]
    for s in real_tasks:
        assert chain.realTasksFilter(s), f"Should accept as real task: {s}"


def test_extractArray_filters_tasks_using_realTasksFilter():
    # Compose a string that includes both real tasks and non-tasks
    input_str = """
    1. Write unit tests for the new feature
    2. No new tasks required
    3. Fix the bug in the payment gateway
    4. Task complete
    5. Update documentation
    6. Do nothing
    """

    extracted = chain.extractArray(input_str)
    filtered = list(filter(chain.realTasksFilter, extracted))

    # The filtered list should only contain the real tasks (1, 3, 5)
    expected = [
        "Write unit tests for the new feature",
        "Fix the bug in the payment gateway",
        "Update documentation",
    ]

    assert filtered == expected, f"Filtered tasks mismatch: {filtered}"[0m
