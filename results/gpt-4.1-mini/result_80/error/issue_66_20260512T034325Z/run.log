    def test_real_tasks_filter(self):
        # This test verifies the realTasksFilter function behavior
        # We implement the filter logic here as in src/utils/chain.ts

        def realTasksFilter(input_str: str) -> bool:
            noTaskRegex = re.compile(
                r"^No( (new|further|additional|extra|other))? tasks? (is )?(required|needed|added|created|inputted).*$",
                re.IGNORECASE,
            )
            taskCompleteRegex = re.compile(
                r"^Task (complete|completed|finished|done|over|success).*", re.IGNORECASE
            )
            doNothingRegex = re.compile(r"^(\s*|Do nothing(\s.*)?)$", re.IGNORECASE)

            return (
                not noTaskRegex.match(input_str)
                and not taskCompleteRegex.match(input_str)
                and not doNothingRegex.match(input_str)
            )

