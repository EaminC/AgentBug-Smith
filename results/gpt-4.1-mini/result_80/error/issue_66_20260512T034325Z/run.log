from src.utils.chain import extractArray, realTasksFilter


class TestAgentTaskFiltering(unittest.TestCase):
    def test_agent_loop_stops_after_max_loops(self):
        # This test simulates the loop count logic in AutonomousAgent.ts
        # The patch changes maxLoops from 3 to 4 when customApiKey is empty.
        # We test that after 4 loops it stops, not after 3.

        class DummyAgent:
            def __init__(self, customApiKey=""):
                self.customApiKey = customApiKey
                self.numLoops = 0
                self.stopped = False

            def sendLoopMessage(self):
                pass

            def shutdown(self):
                self.stopped = True

            def loop(self):
                self.numLoops += 1
                # This logic mimics the buggy code before patch:
                maxLoops = 3 if self.customApiKey == "" else 25
                if self.numLoops > maxLoops:
                    self.sendLoopMessage()
                    self.shutdown()

        # On buggy code, maxLoops=3, so after 3 loops it stops
        # On fixed code, maxLoops=4, so after 4 loops it stops

        # We simulate the buggy behavior:
        agent = DummyAgent(customApiKey="")
        for i in range(3):
            agent.loop()
            self.assertFalse(agent.stopped, f"Agent should not stop before maxLoops, failed at loop {i+1}")
        agent.loop()
        # On buggy code, agent.stopped should be True after 4th loop (numLoops=4 > 3)
        # On fixed code, agent.stopped should be False after 4th loop (numLoops=4 == maxLoops)
        # So this test will fail on buggy code because agent.stopped is True too early
        self.assertFalse(agent.stopped, "Agent should not stop at loop 4 on fixed code")


