import re

from src.utils.chain import realTasksFilter


@pytest.mark.parametrize(
    "input_str,expected",
    [
        # These inputs should be filtered out (return False)
        ("No tasks added", False),
        ("No new tasks required", False),
        ("No further tasks needed", False),
        ("No additional tasks created", False),
        ("No extra tasks inputted", False),
        ("Task complete", False),
        ("Task completed successfully", False),
        ("Task finished", False),
        ("Task done", False),
        ("Task over", False),
        ("Task success", False),
        ("", False),
        ("   ", False),
        ("Do nothing", False),
        ("Do nothing for now", False),

        # These inputs should pass the filter (return True)
        ("Add a new task to clean the database", True),
        ("Create a backup task", True),
        ("Analyze the logs for errors", True),
        ("Update the user interface", True),
        ("Fix the bug in the agent loop", True),
        ("Schedule a meeting with the team", True),
        ("Refactor the codebase", True),
        ("Write unit tests", True),
        ("Deploy the new version", True),
        ("Investigate the failure reason", True),
    ],
)
def test_realTasksFilter_behavior(input_str, expected):
    assert realTasksFilter(input_str) == expected


def test_realTasksFilter_rejects_no_task_variants():
    no_task_variants = [
        "No tasks added",
        "No new tasks required",
        "No further tasks needed",
        "No additional tasks created",
        "No extra tasks inputted",
    ]
    for variant in no_task_variants:
        assert not realTasksFilter(variant)


def test_realTasksFilter_rejects_task_complete_variants():
    complete_variants = [
        "Task complete",
        "Task completed",
        "Task finished",
        "Task done",
        "Task over",
        "Task success",
    ]
    for variant in complete_variants:
        assert not realTasksFilter(variant)


def test_realTasksFilter_rejects_do_nothing_variants():
    do_nothing_variants = [
        "",
        "   ",
        "Do nothing",
        "Do nothing for now",
        "Do nothing at this time",
    ]
    for variant in do_nothing_variants:
        assert not realTasksFilter(variant)


