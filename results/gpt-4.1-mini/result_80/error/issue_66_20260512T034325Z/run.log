[32mimport pytest
from src.utils import chain


def test_real_tasks_filter_rejects_no_tasks_phrases():
    # These phrases should be filtered out (return False)
    no_tasks_examples = [
        "No tasks added",
        "No new tasks required",
        "No further tasks needed",
        "No additional tasks created",
        "No extra tasks inputted",
        "No other tasks required",
        "Task complete",
        "Task completed successfully",
        "Task finished",
        "Task done",
        "Task over",
        "Task success",
        "Do nothing",
        "   ",
        "",
        "Do nothing for now",
    ]
    for phrase in no_tasks_examples:
        assert not chain.realTasksFilter(phrase), f"Phrase should be filtered out: {phrase}"


def test_real_tasks_filter_accepts_real_tasks():
    # These phrases should be accepted (return True)
    real_tasks_examples = [
        "Add a new feature to the app",
        "Fix the bug in the login flow",
        "Write unit tests for the API",
        "Refactor the database schema",
        "Deploy the latest version to production",
        "Investigate the performance issue",
        "Create a design document",
        "Update the README file",
        "Implement user authentication",
        "Optimize image loading",
    ]
    for phrase in real_tasks_examples:
        assert chain.realTasksFilter(phrase), f"Phrase should NOT be filtered out: {phrase}"


def test_extract_array_and_filter_combined():
    # Input string simulating model output with mixed valid and invalid tasks
    input_str = """
    1. No new tasks required.
    2. Fix the bug in the login flow.
    3. Task complete.
    4. Write unit tests for the API.
    5. Do nothing.
    6. Deploy the latest version to production.
    """

    extracted = chain.extractArray(input_str)
    filtered = list(filter(chain.realTasksFilter, extracted))

    # Expected tasks after filtering out no-task phrases
    expected = [
        "Fix the bug in the login flow.",
        "Write unit tests for the API.",
        "Deploy the latest version to production.",
    ]

    assert filtered == expected, f"Filtered tasks do not match expected. Got {filtered}"[0m
