FROM python:3.12-slim

# Set Forge API environment variables for OpenAI and Anthropic compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"

# Set general environment flags
ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Install system dependencies needed for Python package builds
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    python3-dev \
    libffi-dev \
    libssl-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and setuptools to compatible versions
# to avoid build issues such as with pyyaml
RUN python -m pip install --upgrade pip setuptools==81.0.0 wheel

# Copy the entire repository into the container
COPY . .

# Install dependencies and the package itself with combined command to avoid layering issues
# Separate installation of pyyaml build dependencies is already done via system packages
RUN if [ -f requirements.txt ]; then pip install -r requirements.txt; fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout litellm

# Preflight check to ensure installations succeeded
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command to launch bash shell after container start
CMD ["/bin/bash"]

# branch: python/requirements.txt

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"

# Set general environment flags
ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Install system dependencies needed for Python package compilation and Git
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    python3-dev \
    libffi-dev \
    libssl-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and setuptools to compatible versions to avoid build issues (e.g., PyYAML)
RUN python -m pip install --upgrade pip setuptools==81.0.0 wheel

# Copy entire repository source
COPY . .

# Install Python dependencies from requirements.txt if present, then install the package itself,
# Finally, install test dependencies explicitly
RUN if [ -f requirements.txt ]; then pip install -r requirements.txt; fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout litellm

# Preflight check to ensure installations succeeded
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

