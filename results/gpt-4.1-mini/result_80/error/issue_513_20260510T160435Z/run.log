import pytest
import tempfile
import os
import sys
import subprocess
from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_script_contains_utf8_encoding():
    # Prepare a dummy header and main_body with Chinese characters
    header = "# This is a header with Chinese characters: 中文测试"
    main_body = "print('Hello, 世界')"

    # Create an instance of ASDiGraph (subclass of nx.DiGraph)
    graph = workflow_dag.ASDiGraph()

    # Call the _make_script method with the header and main_body
    script = graph._make_script(header, main_body)

    # Check that the UTF-8 coding declaration is present in the script
    assert script.startswith("# -*- coding: utf-8 -*-\n"), "Script is missing UTF-8 coding declaration"

    # Check that the Chinese characters are present in the script
    assert "中文测试" in script
    assert "世界" in script

    # Write the script to a temporary file and try to compile it to ensure no SyntaxError
    with tempfile.TemporaryDirectory() as tmpdir:
        script_path = os.path.join(tmpdir, "test_script.py")
        with open(script_path, "w", encoding="utf-8") as f:
            f.write(script)

        # Compile the script to check for syntax errors
        try:
            compile(open(script_path, encoding="utf-8").read(), script_path, 'exec')
        except SyntaxError as e:
            pytest.fail(f"Script compilation failed with SyntaxError: {e}")

        # Additionally, run the script with python subprocess to ensure no encoding error
        result = subprocess.run([sys.executable, script_path], capture_output=True, text=True)
        # It should run without encoding errors; output should contain Hello, 世界
        assert result.returncode == 0, f"Script execution failed: {result.stderr}"
        assert "Hello, 世界" in result.stdout


# This test will fail on the buggy codebase (missing UTF-8 coding line causes SyntaxError on Chinese chars)
# and pass on the fixed codebase (UTF-8 coding line added).[0m
