from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_utf8_encoding_declaration():
    """
    This test verifies that the generated script from ASDiGraph includes the UTF-8
    encoding declaration line. This is critical to support non-ASCII characters such as
    Chinese characters in the system prompt or message content without causing a
    SyntaxError.

    The test will fail on the buggy codebase (missing encoding declaration) and pass
    after the fix (which adds '# -*- coding: utf-8 -*-' at the top).
    """
    # Create an instance of ASDiGraph
    graph = workflow_dag.ASDiGraph()

    # Prepare dummy header and main_body with Chinese characters to simulate the bug scenario
    header = "# This is a header with Chinese characters: 中文测试"
    main_body = "print('测试中文字符')"

    # Use the internal method _make_script to generate the script text
    # This method is expected to be called internally by ASDiGraph, but we call it directly here
    script_text = graph._make_script(header, main_body)

    # Check that the encoding declaration is present at the beginning of the script
    # The fix adds: "# -*- coding: utf-8 -*-\n"
    assert script_text.startswith("# -*- coding: utf-8 -*-"), (
        "The generated script does not start with UTF-8 encoding declaration. "
        "This causes SyntaxError on non-ASCII characters."
    )

    # Additionally, check that the Chinese characters appear in the script
    assert "中文测试" in script_text
    assert "测试中文字符" in script_text

    # To further verify the script is valid Python source, try compiling it
    # This will raise SyntaxError if encoding is missing and non-ASCII chars are present
    try:
        compile(script_text, "<string>", "exec")
    except SyntaxError as e:
        pytest.fail(f"Generated script is not valid Python source: {e}")


def test_workflow_dag_script_execution_with_chinese_characters():
    """
    This test writes the generated script with Chinese characters to a temporary file
    and attempts to execute it with the Python interpreter. On the buggy codebase,
    this should raise a SyntaxError due to missing encoding declaration.
    After the fix, the script should run without errors.
    """
    graph = workflow_dag.ASDiGraph()
    header = "# Header with Chinese: 测试"
    main_body = "print('输出中文内容')"

    script_text = graph._make_script(header, main_body)

    with tempfile.TemporaryDirectory() as tmpdir:
        script_path = os.path.join(tmpdir, "test_script.py")
        with open(script_path, "w", encoding="utf-8") as f:
            f.write(script_text)

        # Run the script with the current Python interpreter
        # Capture output and errors
        proc = subprocess.run(
            [sys.executable, script_path],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            encoding="utf-8",
        )

        # On buggy codebase, this will fail with SyntaxError about non-UTF-8 code
        # On fixed codebase, it should succeed and output the Chinese print statement
        if proc.returncode != 0:
            # Fail the test with stderr output
            pytest.fail(
                f"Execution of generated script failed with error:\n{proc.stderr}"
            )

        # Check output contains the Chinese string printed
        assert "输出中文内容" in proc.stdout[0m
