from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_script_contains_utf8_encoding_declaration():
    # Create dummy header and main_body with Chinese characters
    header = "# This is a header with Chinese characters: 中文测试"
    main_body = "print('执行测试')"  # Chinese for "execute test"

    # Create an instance of ASDiGraph (subclass of nx.DiGraph)
    graph = workflow_dag.ASDiGraph()

    # Call the _make_script method with dummy header and main_body
    # This method is expected to prepend the UTF-8 encoding declaration line
    script = graph._make_script(header, main_body)

    # The returned script should start with the UTF-8 encoding declaration line
    assert script.startswith("# -*- coding: utf-8 -*-\n")

    # The script should contain the Chinese characters from header and main_body
    assert "中文测试" in script
    assert "执行测试" in script

    # The script should be valid Python code when executed
    # Write the script to a temporary file and try to compile it
    with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False, encoding="utf-8") as f:
        f.write(script)
        temp_path = f.name

    try:
        # Compile the script to check for syntax errors
        compiled_code = compile(open(temp_path, encoding="utf-8").read(), temp_path, "exec")
    finally:
        os.unlink(temp_path)

    # If compilation succeeds, the test passes
    assert compiled_code is not None[0m
