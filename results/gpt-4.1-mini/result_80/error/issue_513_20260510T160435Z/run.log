def test_workflow_dag_utf8_encoding_in_script():
    """
    Test that the generated script from ASDiGraph includes the UTF-8 encoding declaration
    so that Chinese characters in the system prompt or message content do not cause SyntaxError.
    """

    # Create a graph instance
    graph = workflow_dag.ASDiGraph()

    # Add a node with Chinese characters in the system prompt/message content
    # We simulate the node data that would be used to generate the script
    # The actual method _generate_script uses self.nodes data to build the script
    # We add a dummy node with Chinese characters in the 'system_prompt' or 'content' field

    chinese_text = "这是中文字符"  # "These are Chinese characters" in Chinese

    # Add a node with required attributes to trigger script generation
    graph.add_node(
        "node1",
        system_prompt=f"系统提示：{chinese_text}",
        message_content=f"消息内容：{chinese_text}",
    )

    # Call the internal method _generate_script to get the script string
    # This method is responsible for generating the Python script string
    script = graph._generate_script()

    # Assert that the UTF-8 encoding declaration is present at the top of the script
    assert script.startswith("# -*- coding: utf-8 -*-"), "UTF-8 encoding declaration missing"

    # Assert that the Chinese characters appear verbatim in the script
    assert chinese_text in script, "Chinese characters missing in generated script"

    # Additionally, try to compile the generated script to ensure no SyntaxError
    try:
        compile(script, "<string>", "exec")
    except SyntaxError as e:
        pytest.fail(f"Generated script has SyntaxError: {e}")

    # If all assertions pass, the test succeeds


