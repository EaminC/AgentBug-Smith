[32mimport pytest
import tempfile
import os
import sys
import subprocess
from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_utf8_encoding_declaration():
    """
    This test verifies that the generated script from ASDiGraph includes the UTF-8
    encoding declaration line. This is to prevent SyntaxError when the script contains
    non-ASCII characters such as Chinese characters.
    """

    # Create an instance of ASDiGraph
    graph = workflow_dag.ASDiGraph()

    # Prepare a system prompt containing Chinese characters
    chinese_prompt = "系统提示：请处理以下内容。"

    # Add a node with Chinese characters in the 'system_prompt' attribute
    graph.add_node(
        "test_node",
        system_prompt=chinese_prompt,
        message_content="这是消息内容，包含中文字符。",
    )

    # Generate the script from the graph
    script = graph.to_script()

    # Check that the UTF-8 encoding declaration is present as the first line
    lines = script.splitlines()
    assert lines[0].startswith("# -*- coding: utf-8 -*-"), "UTF-8 encoding declaration missing"

    # Check that the Chinese characters are present in the script
    assert chinese_prompt in script, "Chinese characters missing in generated script"

    # Additionally, try to compile the script to ensure no SyntaxError due to encoding
    try:
        compile(script, "<string>", "exec")
    except SyntaxError as e:
        pytest.fail(f"Script compilation failed with SyntaxError: {e}")

    # Optionally, write the script to a temporary file and run it to ensure no runtime errors
    with tempfile.TemporaryDirectory() as tmpdir:
        script_path = os.path.join(tmpdir, "test_script.py")
        with open(script_path, "w", encoding="utf-8") as f:
            f.write(script)

        # Run the script with python and check exit code
        result = subprocess.run([sys.executable, script_path], capture_output=True, text=True)
        assert result.returncode == 0, f"Script execution failed: {result.stderr}"[0m
