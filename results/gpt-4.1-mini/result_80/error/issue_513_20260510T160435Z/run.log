[32mimport pytest
import tempfile
import os
import sys
import subprocess
from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_script_contains_utf8_encoding_declaration():
    """
    This test verifies that the generated script from ASDiGraph includes
    the UTF-8 encoding declaration line. This prevents SyntaxError when
    the script contains non-ASCII characters such as Chinese characters.
    """

    # Create an instance of ASDiGraph
    graph = workflow_dag.ASDiGraph()

    # Prepare dummy header and main_body containing Chinese characters
    header = "# Header line\n# 测试中文字符"
    main_body = "print('你好，世界')"

    # Use the internal method _build_script (or the public method that generates the script)
    # The method is private, but we test the output of _build_script to check the encoding line.
    script = graph._build_script(header, main_body)

    # Assert that the UTF-8 encoding declaration is present at the beginning
    assert script.startswith("# -*- coding: utf-8 -*-"), "UTF-8 encoding declaration missing"

    # Assert that the Chinese characters appear in the script (not escaped or removed)
    assert "测试中文字符" in script
    assert "你好，世界" in script

    # Additionally, try to compile the script to ensure no SyntaxError due to encoding
    try:
        compile(script, "<string>", "exec")
    except SyntaxError as e:
        pytest.fail(f"Script compilation failed due to SyntaxError: {e}")


def test_workflow_dag_script_runs_with_chinese_characters():
    """
    This test verifies that the generated script with Chinese characters
    can be executed as a Python script without encoding errors.
    """

    graph = workflow_dag.ASDiGraph()

    header = "# Header line\n# 系统提示：这是中文"
    main_body = (
        "def main():\n"
        "    print('执行主函数，内容包含中文')\n"
    )

    script = graph._build_script(header, main_body)

    # Write the script to a temporary file
    with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False, encoding="utf-8") as f:
        f.write(script)
        tmp_path = f.name

    try:
        # Run the script as a subprocess to check for encoding errors
        result = subprocess.run(
            [sys.executable, tmp_path],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            encoding="utf-8",
            timeout=5,
        )
    finally:
        os.unlink(tmp_path)

    # The script should exit with code 0 (success)
    assert result.returncode == 0, f"Script exited with error: {result.stderr}"

    # The output should contain the Chinese print statement
    assert "执行主函数，内容包含中文" in result.stdout


# We do not mock internal methods of workflow_dag.ASDiGraph to ensure real code is tested.
# The test fails on buggy code (no encoding declaration) due to SyntaxError on Chinese chars,
# and passes after the fix (adding "# -*- coding: utf-8 -*-" line).[0m
