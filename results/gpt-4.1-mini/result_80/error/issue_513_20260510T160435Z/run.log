[32mimport pytest
import tempfile
import os
import sys
import subprocess
from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_utf8_encoding_in_script():
    """
    This test verifies that the generated script from ASDiGraph includes the UTF-8 encoding declaration
    to support Chinese characters without syntax errors.
    """

    # Create an instance of ASDiGraph
    graph = workflow_dag.ASDiGraph()

    # Prepare dummy header and main_body that includes Chinese characters
    header = "# This is a header\n# 包含中文字符"
    main_body = "print('你好，世界')  # Chinese greeting"

    # Generate the script using the private method _generate_script
    # We call the private method directly to inspect the generated script string.
    script = graph._generate_script(header, main_body)

    # Check that the encoding declaration is present at the top of the script
    assert script.startswith("# -*- coding: utf-8 -*-"), "UTF-8 encoding declaration missing in script"

    # Check that the Chinese characters are present in the script
    assert "包含中文字符" in script
    assert "你好，世界" in script

    # Additionally, try to compile the script to ensure no SyntaxError due to encoding
    try:
        compile(script, "<string>", "exec")
    except SyntaxError as e:
        pytest.fail(f"Script compilation failed due to syntax error: {e}")


def test_workflow_dag_script_executes_chinese_print(capsys):
    """
    This test verifies that the generated script can be executed safely and prints Chinese characters.
    """

    graph = workflow_dag.ASDiGraph()

    header = "# Header with Chinese: 测试"
    main_body = "print('测试中文输出')"

    script = graph._generate_script(header, main_body)

    # Write the script to a temporary file
    with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False, encoding="utf-8") as f:
        f.write(script)
        temp_script_path = f.name

    # Execute the script using subprocess and capture output
    try:
        result = subprocess.run(
            [sys.executable, temp_script_path],
            capture_output=True,
            text=True,
            check=True,
        )
    except subprocess.CalledProcessError as e:
        os.unlink(temp_script_path)
        pytest.fail(f"Execution of generated script failed: {e.stderr}")

    os.unlink(temp_script_path)

    # Check that the output contains the Chinese string printed by the script
    assert "测试中文输出" in result.stdout


# The tests above will fail on the buggy codebase because the generated script lacks the UTF-8 encoding declaration,
# causing a SyntaxError when Chinese characters are included.
# After applying the fix (adding the UTF-8 encoding declaration), these tests should pass.[0m
