[32mimport pytest
import tempfile
import os
import sys
import subprocess
import re

import src.agentscope.web.workstation.workflow_dag as workflow_dag


def test_workflow_dag_utf8_encoding_line():
    """
    Test that the generated script from ASDiGraph includes the UTF-8 encoding declaration line.
    This prevents SyntaxError when the script contains non-ASCII characters such as Chinese.
    """

    # Create an instance of ASDiGraph
    graph = workflow_dag.ASDiGraph()

    # Prepare header and main_body with Chinese characters to simulate the bug scenario
    header = "# Header with Chinese: 测试"
    main_body = "print('内容包含中文')"

    # Generate the script using the internal method _generate_script
    script = graph._generate_script(header, main_body)

    # Check that the first line is the UTF-8 encoding declaration
    first_line = script.splitlines()[0]
    assert first_line == "# -*- coding: utf-8 -*-", "UTF-8 encoding declaration missing in generated script"

    # Check that the Chinese characters appear in the script
    assert "测试" in script
    assert "内容包含中文" in script

    # Additionally, try to compile the script to ensure no SyntaxError due to encoding
    # We compile the script string to a code object
    try:
        compile(script, "<string>", "exec")
    except SyntaxError as e:
        pytest.fail(f"Generated script has SyntaxError: {e}")


def test_workflow_dag_script_execution_with_chinese(tmp_path):
    """
    Test that the generated script with Chinese characters can be written to a file and executed
    without encoding errors.
    """

    graph = workflow_dag.ASDiGraph()
    header = "# Header with Chinese: 测试"
    main_body = "print('内容包含中文')"

    script = graph._generate_script(header, main_body)

    # Write the script to a temporary file
    script_path = tmp_path / "test_script.py"
    script_path.write_text(script, encoding="utf-8")

    # Run the script with python subprocess and capture output
    result = subprocess.run(
        [sys.executable, str(script_path)],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        encoding="utf-8",
    )

    # The script should run successfully (exit code 0)
    assert result.returncode == 0, f"Script execution failed: {result.stderr}"

    # The output should contain the Chinese string printed
    assert "内容包含中文" in result.stdout


def test_generate_script_includes_main_guard():
    """
    Test that the generated script includes the if __name__ == '__main__' guard.
    """

    graph = workflow_dag.ASDiGraph()
    header = "# Header"
    main_body = "print('Hello World')"

    script = graph._generate_script(header, main_body)

    # The script should contain the main guard line
    assert re.search(r"if __name__ *== *['\"]__main__['\"] *:", script), "Missing main guard in script"


def test_generate_script_structure():
    """
    Test that the generated script structure matches expected format.
    """

    graph = workflow_dag.ASDiGraph()
    header = "# Header line"
    main_body = "def main():\n    print('Hello')"

    script = graph._generate_script(header, main_body)

    # The script should start with UTF-8 encoding declaration
    assert script.startswith("# -*- coding: utf-8 -*-")

    # The header should appear after the encoding line
    assert "# Header line" in script

    # The main body should appear after header
    assert "def main():" in script

    # The main guard should call main()
    assert "if __name__ == '__main__':" in script
    assert "main()" in script


# The tests above will fail on the buggy codebase (missing UTF-8 encoding line causes SyntaxError on Chinese)
# and pass on the fixed codebase (UTF-8 encoding line added).[0m
