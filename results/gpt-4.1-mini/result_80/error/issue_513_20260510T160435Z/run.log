import tempfile
import os
import sys
from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_utf8_encoding_declaration():
    """
    Test that the generated script from ASDiGraph includes the UTF-8 encoding declaration
    to support Chinese characters without SyntaxError.
    """

    # Create an instance of ASDiGraph
    graph = workflow_dag.ASDiGraph()

    # Prepare dummy header and main_body containing Chinese characters
    header = "# This is a header with Chinese characters: 中文测试"
    main_body = "print('这是主函数体，包含中文')"

    # Generate the script
    script = graph._make_script(header, main_body)

    # Check that the UTF-8 encoding declaration is present at the top of the script
    assert script.startswith("# -*- coding: utf-8 -*-"), "UTF-8 encoding declaration missing"

    # Check that the Chinese characters are included in the script
    assert "中文测试" in script
    assert "这是主函数体，包含中文" in script

    # Additionally, try compiling the script to ensure no SyntaxError occurs
    # This simulates the real scenario where the script is saved and executed
    try:
        compiled_code = compile(script, "<string>", "exec")
    except SyntaxError as e:
        pytest.fail(f"Compilation failed due to SyntaxError: {e}")

    # Execute the compiled code in a controlled namespace to verify runtime behavior
    namespace = {}
    exec(compiled_code, namespace)

    # Check that main function is defined and callable
    assert "main" in namespace and callable(namespace["main"]), "main function missing or not callable"

    # Call main function to verify it runs without error
    # It should print the Chinese message; capture stdout if needed
    import io
    import contextlib

    f = io.StringIO()
    with contextlib.redirect_stdout(f):
        namespace["main"]()
    output = f.getvalue()

    # The output should contain the Chinese string from main_body
    assert "这是主函数体，包含中文" in output[0m
