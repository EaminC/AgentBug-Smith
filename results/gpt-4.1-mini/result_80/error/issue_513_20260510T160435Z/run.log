import pytest
import tempfile
import os
import sys
import runpy
from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_script_contains_utf8_encoding():
    """
    This test verifies that the generated script in ASDiGraph includes the UTF-8 encoding declaration.
    Before the fix, the script does not include the encoding declaration and may cause SyntaxError
    when the script contains non-ASCII characters (e.g., Chinese characters).
    After the fix, the script should start with the line '# -*- coding: utf-8 -*-'.
    """
    graph = workflow_dag.ASDiGraph()

    # Prepare dummy header and main_body with Chinese characters to simulate the problematic case
    header = "# Header line\n# 这是中文注释"
    main_body = "print('测试中文字符')"

    # Call the private method _make_script (or public method if available) to get the script text
    # The method _make_script is not public, but we can test the public method that calls it:
    # The method is _make_script(self, header: str, main_body: str) -> str
    # Since it's private, we call it directly here for testing purposes.
    script = graph._make_script(header, main_body)

    # The script must start with the UTF-8 encoding declaration line after the fix
    # Before the fix, this line is missing, causing SyntaxError on non-ASCII characters
    first_line = script.splitlines()[0]
    assert first_line == "# -*- coding: utf-8 -*-", (
        "The generated script must start with UTF-8 encoding declaration line."
    )

    # Additionally, check that the Chinese characters are present in the script
    assert "这是中文注释" in script
    assert "测试中文字符" in script


def test_workflow_dag_script_executes_without_syntax_error():
    """
    This test attempts to execute the generated script containing Chinese characters.
    Before the fix, executing the script raises SyntaxError due to missing encoding declaration.
    After the fix, the script executes without SyntaxError.
    """
    graph = workflow_dag.ASDiGraph()

    header = "# Header line\n# 这是中文注释"
    main_body = "print('测试中文字符')"

    script = graph._make_script(header, main_body)

    # Write the script to a temporary file and try to execute it as a Python module
    with tempfile.TemporaryDirectory() as tmpdir:
        script_path = os.path.join(tmpdir, "test_script.py")
        with open(script_path, "w", encoding="utf-8") as f:
            f.write(script)

        # Attempt to run the script file as a module
        # Before the fix, this should raise SyntaxError
        # After the fix, it should run successfully and print the Chinese string
        # We capture stdout to verify the print output
        import subprocess

        result = subprocess.run(
            [sys.executable, script_path],
            capture_output=True,
            text=True,
        )

        # The process should exit with code 0 after the fix
        assert result.returncode == 0, (
            f"Script execution failed with return code {result.returncode}.\n"
            f"stderr: {result.stderr}"
        )

        # The output should contain the Chinese string printed by the script
        assert "测试中文字符" in result.stdout


if __name__ == "__main__":
    pytest.main([__file__])[0m
