[32mimport io
import sys
import pytest
from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_utf8_encoding_in_script():
    # Prepare a dummy header and main_body containing Chinese characters
    header = "# This is a header"
    main_body = "print('你好，世界')"  # "Hello, World" in Chinese

    # Create an instance of ASDiGraph
    graph = workflow_dag.ASDiGraph()

    # Use the internal method _make_script to generate the script
    script = graph._make_script(header, main_body)

    # The script should start with the UTF-8 encoding declaration
    assert script.startswith("# -*- coding: utf-8 -*-\n")

    # The script should contain the Chinese characters in the main body
    assert "你好，世界" in script

    # The script should contain the header and main body properly formatted
    assert header in script
    assert main_body in script

    # The script should end with the main guard calling main()
    assert "if __name__ == '__main__':" in script
    assert "main()" in script


def test_workflow_dag_script_executes_without_encoding_error():
    # Prepare a dummy header and main_body containing Chinese characters and a main function
    header = "# Dummy header"
    main_body = (
        "def main():\n"
        "    print('测试中文字符')\n"  # "Test Chinese characters"
    )

    graph = workflow_dag.ASDiGraph()
    script = graph._make_script(header, main_body)

    # Execute the generated script in a separate namespace to check for encoding errors
    namespace = {}
    # Use compile with 'exec' mode and encoding declared in the script
    code = compile(script, "<string>", "exec")

    # Redirect stdout to capture print output
    captured_output = io.StringIO()
    sys_stdout = sys.stdout
    sys.stdout = captured_output
    try:
        exec(code, namespace)
    finally:
        sys.stdout = sys_stdout

    # The print output should contain the Chinese test string
    output = captured_output.getvalue()
    assert "测试中文字符" in output


if __name__ == "__main__":
    pytest.main([__file__])[0m
