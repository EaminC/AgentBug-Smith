def test_workflow_dag_script_contains_utf8_encoding_declaration():
    # Create dummy header and main_body with Chinese characters
    header = "# This is a header with Chinese characters: 测试"
    main_body = "print('你好，世界')"

    # Create an instance of ASDiGraph (subclass of nx.DiGraph)
    graph = workflow_dag.ASDiGraph()

    # Call _build_script (private method) with header and main_body
    # It should prepend the utf-8 coding declaration after the patch is applied
    script = graph._build_script(header, main_body)

    # The script should start with the UTF-8 coding declaration line
    assert script.startswith("# -*- coding: utf-8 -*-\n")

    # The script should contain the header and main_body content
    assert header in script
    assert main_body in script

    # The script should be valid Python source code with utf-8 encoding
    # Write to a temporary file and try to compile it
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".py", delete=False) as f:
        f.write(script)
        temp_path = f.name

    try:
        # Compile the script file to check for syntax errors
        with open(temp_path, "r", encoding="utf-8") as f:
            source = f.read()
        compile(source, temp_path, "exec")
    finally:
        os.remove(temp_path)[0m
