[32mimport pytest
from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_script_contains_utf8_encoding_declaration():
    """
    This test ensures that the generated script from ASDiGraph includes the UTF-8
    encoding declaration line. This is necessary to support Chinese characters
    and other non-ASCII characters in the generated Python script, preventing
    SyntaxError related to non-UTF-8 code.
    """

    # Create an instance of ASDiGraph
    graph = workflow_dag.ASDiGraph()

    # Prepare dummy header and main_body with Chinese characters
    header = "# This is a header with Chinese characters: 中文测试"
    main_body = "print('测试中文')"

    # Generate the script using the private method _generate_script
    # This method is responsible for composing the final Python script string
    script = graph._generate_script(header, main_body)

    # Assert that the UTF-8 encoding declaration is present at the start of the script
    assert script.startswith("# -*- coding: utf-8 -*-"), (
        "The generated script must start with UTF-8 encoding declaration to support Chinese characters."
    )

    # Assert that the Chinese characters from header and main_body are included in the script
    assert "中文测试" in script, "Chinese characters in header should be present in the script."
    assert "测试中文" in script, "Chinese characters in main_body should be present in the script."

    # Assert that the script ends with the main guard calling main()
    assert script.strip().endswith("if __name__ == '__main__':\n    main()"), (
        "The script should end with the main guard calling main()"
    )[0m
