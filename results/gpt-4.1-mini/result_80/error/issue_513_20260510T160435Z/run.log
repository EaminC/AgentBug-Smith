[32mimport pytest
import tempfile
import os
import sys
from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_utf8_encoding_in_script():
    """
    This test verifies that the generated script from ASDiGraph includes the UTF-8 encoding
    declaration line. This is to prevent SyntaxError when the script contains non-ASCII
    characters such as Chinese characters.

    The test will fail on the buggy codebase because the UTF-8 encoding declaration line
    is missing, which causes a SyntaxError when the script contains Chinese characters.

    After applying the fix, the test should pass as the encoding declaration line is added.
    """
    # Create an instance of ASDiGraph
    graph = workflow_dag.ASDiGraph()

    # Prepare header and main_body with Chinese characters to simulate the issue
    header = "# This is a header with Chinese characters: 中文测试"
    main_body = "print('这是主体内容，包含中文')"

    # Use the private method _make_script to generate the script
    # (We use the private method because the public interface might not expose this directly)
    script = graph._make_script(header, main_body)

    # Check that the first line of the script is the UTF-8 encoding declaration
    first_line = script.splitlines()[0]
    assert first_line == "# -*- coding: utf-8 -*-", (
        "The script must start with UTF-8 encoding declaration to support Chinese characters."
    )

    # Additionally, check that the Chinese characters are present in the script
    assert "中文测试" in script
    assert "这是主体内容，包含中文" in script


def test_workflow_dag_script_executes_without_syntax_error():
    """
    This test attempts to execute the generated script containing Chinese characters.
    It should not raise a SyntaxError if the UTF-8 encoding declaration is present.

    On the buggy codebase, this will raise a SyntaxError.
    After the fix, it should run without error.
    """
    graph = workflow_dag.ASDiGraph()

    header = "# 测试头部含中文"
    main_body = "print('测试主体含中文')"

    script = graph._make_script(header, main_body)

    # Write the script to a temporary file and try to compile it
    with tempfile.NamedTemporaryFile("w", suffix=".py", encoding="utf-8", delete=False) as f:
        f.write(script)
        temp_path = f.name

    try:
        # Compile the script to check for syntax errors
        with open(temp_path, "r", encoding="utf-8") as f:
            source = f.read()
        compile(source, temp_path, "exec")
    finally:
        os.remove(temp_path)


if __name__ == "__main__":
    pytest.main([__file__])[0m
