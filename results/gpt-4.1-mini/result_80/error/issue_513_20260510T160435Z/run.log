    # Add a node with Chinese characters in the system prompt or message content
    # We simulate this by adding a node with a label containing Chinese characters
    chinese_text = "测试中文字符"  # "Test Chinese characters"
    graph.add_node("node1", system_prompt=chinese_text, message_content=chinese_text)

    # Access the script property which triggers the generation of the python script string
    script = graph.script

    # The script should start with the UTF-8 encoding declaration line
    # This is the fix introduced by the patch
    assert script.startswith("# -*- coding: utf-8 -*-"), "Script missing UTF-8 encoding declaration"

    # The script should contain the Chinese characters somewhere (not escaped or removed)
    assert chinese_text in script, "Chinese characters missing in generated script"

    # The script should be valid Python code that can be compiled without syntax errors
    # We test this by compiling the script string
    try:
        compile(script, "<string>", "exec")
    except SyntaxError as e:
        pytest.fail(f"Generated script has syntax error: {e}")

    # Also check that the main function and __main__ guard exist as expected
    assert "def main()" in script, "Script missing main function definition"
    assert "if __name__ == '__main__':" in script, "Script missing __main__ guard"


# The test above will fail on the buggy codebase because the generated script
# lacks the UTF-8 encoding declaration line, causing Python to raise a SyntaxError
# when non-ASCII characters (Chinese) are present in the source code string.
# After applying the patch, the test should pass successfully.[0m
