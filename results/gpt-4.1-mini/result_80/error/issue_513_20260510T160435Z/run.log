from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_script_contains_utf8_encoding_declaration():
    """
    This test verifies that the generated script from ASDiGraph includes the UTF-8 encoding declaration line.
    Before the fix, the script does not contain the encoding declaration, which causes SyntaxError when
    Chinese characters are present in the script.
    After the fix, the script should start with '# -*- coding: utf-8 -*-' to support Chinese characters.
    """
    graph = workflow_dag.ASDiGraph()

    # Add a dummy node with Chinese characters in the content to simulate the real use case
    node_id = "node1"
    chinese_content = "这是一些中文内容"
    graph.add_node(node_id, content=chinese_content)

    # Generate the script
    script = graph.generate_script(node_id)

    # The script should contain the UTF-8 encoding declaration line at the very beginning
    # This line was added in the fix to prevent SyntaxError for non-UTF-8 characters
    assert script.startswith("# -*- coding: utf-8 -*-"), "Script missing UTF-8 encoding declaration"

    # Additionally, the Chinese characters should be present in the script
    assert chinese_content in script, "Chinese characters missing in generated script"


def test_workflow_dag_script_executes_without_syntax_error():
    """
    This test attempts to execute the generated script containing Chinese characters.
    Before the fix, executing the script would raise a SyntaxError due to missing encoding declaration.
    After the fix, the script should run without syntax errors.
    """
    graph = workflow_dag.ASDiGraph()
    node_id = "node2"
    chinese_content = "print('测试中文字符')  # 测试中文字符"
    graph.add_node(node_id, content=chinese_content)

    script = graph.generate_script(node_id)

    # Write the script to a temporary file
    with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False, encoding="utf-8") as tmp_file:
        tmp_file.write(script)
        tmp_file_path = tmp_file.name

    try:
        # Run the script using subprocess to check for syntax errors
        result = subprocess.run(
            [sys.executable, tmp_file_path],
            capture_output=True,
            text=True,
            timeout=5,
        )
        # The script should run successfully (exit code 0)
        assert result.returncode == 0, f"Script execution failed with stderr: {result.stderr}"
    finally:
        os.remove(tmp_file_path)[0m
