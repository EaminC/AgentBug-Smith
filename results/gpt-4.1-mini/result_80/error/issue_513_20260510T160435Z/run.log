[32mimport pytest
import tempfile
import os
import sys
import subprocess
from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_utf8_encoding_in_script():
    """
    Test that the generated script from ASDiGraph includes UTF-8 encoding declaration
    and can handle Chinese characters in the system prompt or message content without
    raising SyntaxError due to encoding issues.

    This test triggers the code path that was buggy before the fix:
    The generated Python script lacked the UTF-8 coding declaration line,
    causing SyntaxError when Chinese characters were present.
    """

    # Create an instance of ASDiGraph
    graph = workflow_dag.ASDiGraph()

    # Prepare a system prompt and main body containing Chinese characters
    chinese_text = "这是一个测试"  # "This is a test" in Chinese
    header = f"# System prompt with Chinese: {chinese_text}"
    main_body = f"print('消息内容: {chinese_text}')"

    # Use the protected method _make_script to generate the script text
    # We patch the method to use our header and main_body to simulate the scenario
    # The original _make_script method signature is (header: str, main_body: str) -> str
    script = graph._make_script(header, main_body)

    # Assert that the UTF-8 encoding declaration is present in the script (added by the fix)
    assert script.startswith("# -*- coding: utf-8 -*-"), "UTF-8 encoding declaration missing in script"

    # Write the generated script to a temporary file
    with tempfile.TemporaryDirectory() as tmpdir:
        script_path = os.path.join(tmpdir, "test_script.py")
        with open(script_path, "w", encoding="utf-8") as f:
            f.write(script)

        # Run the script with python and capture output and errors
        # It should run without SyntaxError related to encoding
        result = subprocess.run(
            [sys.executable, script_path],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            encoding="utf-8",
        )

        # The script should run successfully (exit code 0)
        assert result.returncode == 0, f"Script failed with error: {result.stderr}"

        # The output should contain the Chinese message content
        expected_output = f"消息内容: {chinese_text}"
        assert expected_output in result.stdout, "Chinese characters not printed correctly"


# This test will fail on the buggy codebase because the generated script lacks the UTF-8
# encoding declaration and Python will raise a SyntaxError when encountering Chinese characters.
# After applying the fix (adding "# -*- coding: utf-8 -*-\n" at the top), the test will pass.[0m
