def test_workflow_dag_script_contains_utf8_encoding_declaration():
    """
    This test verifies that the generated script from ASDiGraph includes the UTF-8 encoding declaration
    at the top of the script string. This is to prevent SyntaxError when the script contains non-ASCII
    characters such as Chinese characters.

    The bug was that the generated script did not include the encoding declaration line:
    # -*- coding: utf-8 -*-
    which caused SyntaxError on non-UTF-8 default environments.

    The fix adds this line at the top of the generated script.
    """
    # Prepare dummy header and main_body with Chinese characters to trigger the encoding issue if missing
    header = "# This is a header with Chinese characters: 中文测试"
    main_body = "print('测试中文字符')"

    graph = workflow_dag.ASDiGraph()

    # Call the internal method _make_script to generate the script string
    script = graph._make_script(header, main_body)

    # The script should start with the UTF-8 encoding declaration line
    assert script.startswith("# -*- coding: utf-8 -*-"), "Script missing UTF-8 encoding declaration"

    # The script should contain the header and main body content as is
    assert "中文测试" in script
    assert "测试中文字符" in script

    # The script should end with the main guard and main() call
    assert re.search(r"if __name__ == ['\"]__main__['\"]:\s+main\(\)", script, re.MULTILINE), \
        "Script missing main guard and main() call"


def test_workflow_dag_script_executes_without_encoding_error():
    """
    This test attempts to execute the generated script with Chinese characters content in a subprocess
    to ensure no SyntaxError related to encoding occurs.

    It writes the generated script to a temporary file and runs it with python.
    The test fails if a SyntaxError occurs due to missing encoding declaration.
    """
    header = "# Header with Chinese characters: 测试"
    main_body = "print('打印中文字符')"

    graph = workflow_dag.ASDiGraph()
    script = graph._make_script(header, main_body)

    with tempfile.TemporaryDirectory() as tmpdir:
        script_path = os.path.join(tmpdir, "test_script.py")
        with open(script_path, "w", encoding="utf-8") as f:
            f.write(script)

        # Run the script with python in a subprocess
        # Capture stderr to detect SyntaxError
        result = subprocess.run(
            [sys.executable, script_path],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            encoding="utf-8",
        )

        # The process should exit with code 0 (success)
        assert result.returncode == 0, f"Script execution failed with error: {result.stderr}"

        # The stdout should contain the printed Chinese characters
        assert "打印中文字符" in result.stdout


# Additional test to check that the _make_script method returns a string containing the encoding line
def test_make_script_returns_string_with_encoding_line():
    graph = workflow_dag.ASDiGraph()
    header = "header"
    main_body = "body"
    script = graph._make_script(header, main_body)
