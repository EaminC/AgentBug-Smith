[32mFROM python:3.9-slim AS test_builder

WORKDIR /app

COPY . .

# Detect src/ layout or tests importing src to avoid editable install in that case
RUN set -eux; \
    if [ -d "src" ] || grep -RqE '^\s*(from|import) src\.' tests 2>/dev/null; then \
        export PYTHONPATH=/app; \
        python -m pip install --upgrade pip setuptools wheel; \
        if [ -f requirements.txt ]; then pip install -r requirements.txt; fi; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    else \
        python -m pip install --upgrade pip setuptools wheel; \
        if [ -f requirements.txt ]; then pip install -r requirements.txt; fi; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    fi

RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests using coverage as per .github/workflows/unittest.yml example
RUN coverage run tests/run.py

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Minimal runtime image
FROM python:3.9-slim AS runtime

WORKDIR /app

COPY . .

# Install only minimal dependencies from setup.py minimal_requires plus litellm to enable runtime
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install networkx black docstring_parser pydantic loguru==0.6.0 tiktoken Pillow requests inputimeout numpy Flask==3.0.0 Flask-Cors==4.0.0 Flask-SocketIO==5.3.6 flask_sqlalchemy flake8 psutil scipy openai>=1.3.0 dashscope>=1.19.0 litellm

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

