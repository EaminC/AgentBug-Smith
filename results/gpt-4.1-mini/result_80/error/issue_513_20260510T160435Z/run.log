[32mimport pytest
import tempfile
import os
import subprocess
import sys
from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_utf8_encoding_in_script():
    """
    Test that the generated script from ASDiGraph includes the UTF-8 encoding declaration
    and can handle Chinese characters in the system prompt or message content without
    raising a SyntaxError due to encoding issues.
    """

    # Create an instance of ASDiGraph
    graph = workflow_dag.ASDiGraph()

    # Prepare a node with Chinese characters in its content to simulate the bug scenario
    node_id = "node1"
    chinese_text = "这是一个测试"  # "This is a test" in Chinese

    # Add a node with a system prompt or message containing Chinese characters
    graph.add_node(node_id, system_prompt=chinese_text, message_content=chinese_text)

    # Generate the script from the graph (this triggers the code that had the bug)
    script = graph.generate_script()

    # Check that the UTF-8 encoding declaration is present in the generated script
    assert script.startswith("# -*- coding: utf-8 -*-"), "UTF-8 encoding declaration missing in script header"

    # Write the script to a temporary file and try to compile it to check for encoding errors
    with tempfile.TemporaryDirectory() as tmpdir:
        script_path = os.path.join(tmpdir, "test_script.py")
        with open(script_path, "w", encoding="utf-8") as f:
            f.write(script)

        # Try to compile the script file to bytecode to detect syntax errors including encoding issues
        try:
            subprocess.check_output([sys.executable, "-m", "py_compile", script_path], stderr=subprocess.STDOUT)
        except subprocess.CalledProcessError as e:
            pytest.fail(f"Script compilation failed with error:\n{e.output.decode('utf-8')}")


# Additional test to ensure that the script runs without encoding errors when executed
def test_workflow_dag_script_execution_with_chinese():
    graph = workflow_dag.ASDiGraph()
    node_id = "node2"
    chinese_text = "测试中文字符"  # "Test Chinese characters"

    graph.add_node(node_id, system_prompt=chinese_text, message_content=chinese_text)
    script = graph.generate_script()

    with tempfile.TemporaryDirectory() as tmpdir:
        script_path = os.path.join(tmpdir, "exec_test_script.py")
        with open(script_path, "w", encoding="utf-8") as f:
            f.write(script)

        # Run the script with python interpreter, it should not raise SyntaxError
        result = subprocess.run([sys.executable, script_path], capture_output=True, text=True)
        # The script may not do anything visible, but should not error out
        assert result.returncode == 0, f"Script execution failed: {result.stderr}"[0m
