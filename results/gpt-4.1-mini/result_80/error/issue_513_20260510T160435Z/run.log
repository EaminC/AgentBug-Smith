[32mimport pytest
import tempfile
import os
import sys
import subprocess

from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_utf8_encoding_in_script():
    """
    This test verifies that the generated script from ASDiGraph includes the UTF-8 encoding
    declaration line to support Chinese characters without SyntaxError.
    """

    # Create an instance of ASDiGraph
    graph = workflow_dag.ASDiGraph()

    # Prepare dummy header and main_body containing Chinese characters
    header = "# This is a header\n# 包含中文字符"
    main_body = "print('你好，世界')  # Print Hello World in Chinese"

    # Generate the script using the internal method _make_script
    # It is assumed _make_script is accessible and used for script generation
    script = graph._make_script(header, main_body)

    # Assert the UTF-8 encoding declaration is present at the very beginning of the script
    assert script.startswith("# -*- coding: utf-8 -*-"), "UTF-8 encoding declaration missing"

    # Assert that the Chinese characters are present in the script
    assert "包" in script and "你" in script, "Chinese characters missing in the script"

    # Additionally, try to compile the script to ensure no SyntaxError related to encoding
    try:
        compile(script, "<string>", "exec")
    except SyntaxError as e:
        pytest.fail(f"Script compilation failed with SyntaxError: {e}")

    # Optionally, write the script to a temp file and run it with python to ensure no runtime encoding error
    with tempfile.TemporaryDirectory() as tmpdir:
        script_path = os.path.join(tmpdir, "test_script.py")
        with open(script_path, "w", encoding="utf-8") as f:
            f.write(script)

        # Run the script with subprocess to check for runtime errors
        result = subprocess.run([sys.executable, script_path], capture_output=True, text=True)
        assert result.returncode == 0, f"Script exited with error: {result.stderr}"

        # Check output contains the expected Chinese output
        assert "你好，世界" in result.stdout, "Script output missing expected Chinese characters"[0m
