[32mimport pytest
import tempfile
import os
import sys
import runpy

from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_script_utf8_encoding_injection():
    """
    Test that the generated script from ASDiGraph includes UTF-8 encoding declaration
    and can handle Chinese characters in the system prompt or message content without
    raising a SyntaxError about non-UTF-8 code.
    """

    # Create an instance of ASDiGraph
    graph = workflow_dag.ASDiGraph()

    # Prepare a node with Chinese characters in the system prompt and message content
    # We simulate the node data that would be used to generate the script
    chinese_text = "这是中文字符"  # "These are Chinese characters"

    # Add a node with attributes that would be used in the script generation
    graph.add_node(
        "test_node",
        system_prompt=chinese_text,
        message_content=chinese_text,
    )

    # Generate the script using the method that was patched
    script = graph._generate_script_for_node("test_node")

    # Assert the UTF-8 encoding declaration is present at the top of the script
    assert script.startswith("# -*- coding: utf-8 -*-"), "UTF-8 encoding declaration missing"

    # Write the script to a temporary file with UTF-8 encoding
    with tempfile.TemporaryDirectory() as tmpdir:
        script_path = os.path.join(tmpdir, "test_script.py")
        with open(script_path, "w", encoding="utf-8") as f:
            f.write(script)

        # Run the script as a subprocess to check for SyntaxError
        # We use runpy to run the script in the current process to catch syntax errors
        # but runpy does not accept file path, so we use exec after reading the file.
        with open(script_path, "r", encoding="utf-8") as f:
            code = f.read()

        # The execution should not raise a SyntaxError related to encoding
        # We catch SyntaxError and fail the test if it occurs
        try:
            # Compile first to catch syntax errors early
            compiled_code = compile(code, script_path, "exec")
            exec(compiled_code, {})
        except SyntaxError as e:
            # Check if the error is about non-UTF-8 code without encoding declared
            if "Non-UTF-8 code" in str(e):
                pytest.fail(f"Script raised SyntaxError due to missing UTF-8 encoding: {e}")
            else:
                # Re-raise other syntax errors
                raise

    # If no exception, test passes


# Additional test to ensure the _generate_script_for_node method actually includes the Chinese text
def test_script_contains_chinese_text():
    graph = workflow_dag.ASDiGraph()
    chinese_text = "这是中文字符"
    graph.add_node(
        "node2",
        system_prompt=chinese_text,
        message_content=chinese_text,
    )
    script = graph._generate_script_for_node("node2")
    assert chinese_text in script, "Chinese characters missing from generated script"[0m
