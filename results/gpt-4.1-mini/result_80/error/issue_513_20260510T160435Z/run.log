[32mimport pytest
import tempfile
import os
import sys
from src.agentscope.web.workstation import workflow_dag


def test_workflow_dag_script_includes_utf8_encoding():
    """
    Test that the generated script from ASDiGraph includes the UTF-8 encoding declaration
    to support Chinese characters without SyntaxError.
    """

    # Create an instance of ASDiGraph
    graph = workflow_dag.ASDiGraph()

    # Prepare dummy header and main_body containing Chinese characters
    header = "# This is a header with Chinese characters: 中文测试"
    main_body = "print('这是主体内容，包含中文')"

    # Generate the script using the private method _generate_script
    # The method is expected to prepend the UTF-8 encoding declaration after the fix
    script = graph._generate_script(header, main_body)

    # Assert that the UTF-8 encoding declaration is present in the script
    assert script.startswith("# -*- coding: utf-8 -*-"), "UTF-8 encoding declaration missing"

    # Assert that the Chinese characters are present in the script
    assert "中文测试" in script
    assert "这是主体内容，包含中文" in script

    # Additionally, try to compile the script to ensure no SyntaxError due to encoding
    try:
        compile(script, "<string>", "exec")
    except SyntaxError as e:
        pytest.fail(f"Generated script has SyntaxError: {e}")

    # The script should also contain the main guard and main call
    assert "if __name__ == '__main__':" in script
    assert "main()" in script[0m
