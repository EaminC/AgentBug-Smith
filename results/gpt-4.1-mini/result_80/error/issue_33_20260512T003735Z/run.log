from unittest.mock import patch, AsyncMock
import importlib

class TestGPT4Option(unittest.TestCase):
    def test_create_model_uses_custom_model_name(self):
        """
        Test that createModel uses the customModelName option if provided,
        otherwise defaults to "gpt-3.5-turbo".
        """
        try:
            # Import after patch applied, to reflect changes
            chain = importlib.import_module("src.utils.chain")
        except ImportError as e:
            self.fail(f"Failed to import src.utils.chain: {e}")

        # The createModel function returns an OpenAI instance with modelName set accordingly
        # We will patch OpenAI to capture the initialization parameters
        with patch("src.utils.chain.OpenAI") as MockOpenAI:
            # Setup mock to just record init params
            MockOpenAI.return_value = "mocked_model_instance"

            # Call with empty customModelName, should default to gpt-3.5-turbo
            model1 = chain.createModel({"customApiKey": "", "customModelName": ""})
            MockOpenAI.assert_called_with(
                openAIApiKey=unittest.mock.ANY,
                temperature=0.9,
                modelName="gpt-3.5-turbo",
                maxTokens=300,
            )
            self.assertEqual(model1, "mocked_model_instance")

            MockOpenAI.reset_mock()

            # Call with customModelName set to "gpt-4"
            model2 = chain.createModel({"customApiKey": "", "customModelName": "gpt-4"})
            MockOpenAI.assert_called_with(
                openAIApiKey=unittest.mock.ANY,
                temperature=0.9,
                modelName="gpt-4",
                maxTokens=300,
            )
            self.assertEqual(model2, "mocked_model_instance")

    def test_api_chain_handler_passes_custom_model_name(self):
