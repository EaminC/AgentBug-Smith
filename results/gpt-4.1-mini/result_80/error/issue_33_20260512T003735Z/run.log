                        "customModelName": "gpt-4",
                        "goal": "Test goal"
                    }

            import asyncio

            async def run_handler():
                response = await api_chain.default(DummyRequest())
                return response

            # Run the async handler
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)
            response = loop.run_until_complete(run_handler())

            # Assert createModel called with correct dict including customModelName
