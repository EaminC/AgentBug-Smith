    def test_api_execute_handler_passes_custom_model_name(self):
        """
        Test that the /api/execute handler passes the customModelName parameter correctly
        and returns the expected result string.
        """
        try:
            handler_module = importlib.import_module("src.pages.api.execute")
        except ImportError as e:
            self.fail(f"Failed to import src.pages.api.execute: {e}")

        async def dummy_executeTaskAgent(model, goal, task):
            return "Executed task result"

        handler_module.executeTaskAgent = dummy_executeTaskAgent
        handler_module.createModel = lambda opts: "dummy_model"

        class DummyRequest:
            async def json(self):
                return {
                    "customApiKey": "dummy_key",
                    "customModelName": "gpt-4",
                    "goal": "Test goal",
                    "task": "Test task"
                }

        import asyncio
        # Patch NextResponse.json to return dict directly
        with patch("src.pages.api.execute.NextResponse.json", side_effect=lambda x: x):
            response = asyncio.run(handler_module.default(DummyRequest()))
            self.assertIn("result", response)
            self.assertEqual(response["result"], "Executed task result")

