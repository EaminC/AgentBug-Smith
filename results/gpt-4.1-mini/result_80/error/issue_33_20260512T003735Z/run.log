[32mimport unittest
from unittest.mock import patch, AsyncMock

class TestGPT4Option(unittest.TestCase):
    def test_create_model_uses_custom_model_name(self):
        """
        Test that createModel uses the customModelName option if provided,
        otherwise defaults to "gpt-3.5-turbo".
        """
        try:
            from src.utils import chain
        except ImportError as e:
            self.fail(f"Failed to import src.utils.chain: {e}")

        # Test default modelName
        model_default = chain.createModel({"customApiKey": "", "customModelName": ""})
        self.assertEqual(model_default.modelName, "gpt-3.5-turbo")

        # Test custom modelName
        custom_name = "gpt-4"
        model_custom = chain.createModel({"customApiKey": "", "customModelName": custom_name})
        self.assertEqual(model_custom.modelName, custom_name)

    def test_api_chain_handler_passes_custom_model_name(self):
        """
        Test that the API handler in src.pages.api.chain passes the customModelName
        to createModel and startGoalAgent.
        """
        try:
            from src.pages.api import chain as api_chain
            from src.utils import chain as utils_chain
        except ImportError as e:
            self.fail(f"Failed to import required modules: {e}")

        # Patch createModel and startGoalAgent to track calls
        with patch("src.pages.api.chain.createModel") as mock_createModel, \
             patch("src.pages.api.chain.startGoalAgent", new_callable=AsyncMock) as mock_startGoalAgent, \
             patch("src.pages.api.chain.extractArray") as mock_extractArray, \
             patch("src.pages.api.chain.realTasksFilter", lambda x: True):

            mock_createModel.side_effect = lambda opts: opts
            mock_extractArray.return_value = ["task1", "task2"]

            # Prepare a dummy request with json method
            class DummyRequest:
                async def json(self):
                    return {
                        "customApiKey": "testkey",
                        "customModelName": "gpt-4",
                        "goal": "test goal"
                    }

            request = DummyRequest()

            # Run the handler
            import asyncio
            response = asyncio.run(api_chain.default(request))

            # Assert createModel called with correct customModelName
            mock_createModel.assert_called_once()
            called_opts = mock_createModel.call_args[0][0]
            self.assertEqual(called_opts["customModelName"], "gpt-4")

            # Assert startGoalAgent called with model opts and goal
            mock_startGoalAgent.assert_awaited_once()
            args = mock_startGoalAgent.call_args[0]
            self.assertEqual(args[0], called_opts)
            self.assertEqual(args[1], "test goal")

            # Assert response contains newTasks
            self.assertIn("newTasks", response.body.decode())

    def test_api_create_handler_passes_custom_model_name(self):
        """
        Test that the API handler in src.pages.api.create passes the customModelName
        to createModel and executeCreateTaskAgent.
        """
        try:
            from src.pages.api import create as api_create
            from src.utils import chain as utils_chain
        except ImportError as e:
            self.fail(f"Failed to import src.pages.api.create: {e}")

        with patch("src.pages.api.create.createModel") as mock_createModel, \
             patch("src.pages.api.create.executeCreateTaskAgent", new_callable=AsyncMock) as mock_executeCreateTaskAgent, \
             patch("src.pages.api.create.extractArray") as mock_extractArray, \
             patch("src.pages.api.create.realTasksFilter", lambda x: True):

            mock_createModel.side_effect = lambda opts: opts
            mock_extractArray.return_value = ["taskA", "taskB"]

            class DummyRequest:
                async def json(self):
                    return {
                        "customApiKey": "key",
                        "customModelName": "gpt-4",
                        "goal": "goal",
                        "tasks": ["task1"],
                        "lastTask": "last",
                        "result": "result"
                    }

            request = DummyRequest()

            import asyncio
            response = asyncio.run(api_create.default(request))

            mock_createModel.assert_called_once()
            opts = mock_createModel.call_args[0][0]
