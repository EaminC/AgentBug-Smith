        # Patch createModel and startGoalAgent to track calls and avoid real network calls
        with patch("src.pages.api.chain.createModel") as mock_create_model, \
             patch("src.pages.api.chain.startGoalAgent", new_callable=AsyncMock) as mock_start_goal_agent, \
             patch("src.pages.api.chain.extractArray") as mock_extract_array:

            # Setup mocks
            mock_create_model.side_effect = lambda opts: opts  # just return opts dict for inspection
            mock_start_goal_agent.return_value = AsyncMock()
            mock_start_goal_agent.return_value.text = "[\"task1\", \"task2\"]"
            mock_extract_array.side_effect = lambda text: ["task1", "task2"]

            # Prepare a fake request with customModelName
            class DummyRequest:
                async def json(self):
                    return {
                        "customApiKey": "dummykey",
                        "customModelName": "gpt-4",
                        "goal": "test goal"
                    }

            dummy_request = DummyRequest()

            # Run the handler
            import asyncio
            result = asyncio.run(api_chain.default(dummy_request))

            # Assert createModel was called with customModelName included
            called_args = mock_create_model.call_args[0][0]
            self.assertIn("customModelName", called_args)
            self.assertEqual(called_args["customModelName"], "gpt-4")

            # Assert startGoalAgent was called with the model returned by createModel and goal string
            mock_start_goal_agent.assert_called()
            args = mock_start_goal_agent.call_args[0]
            self.assertEqual(args[1], "test goal")  # goal param
            self.assertEqual(args[0], called_args)  # model param is what createModel returned

            # Assert the response contains newTasks key with expected tasks
            self.assertTrue(hasattr(result, "json"))
            response_json = result.json()
            self.assertIn("newTasks", response_json)
            self.assertEqual(response_json["newTasks"], ["task1", "task2"])


