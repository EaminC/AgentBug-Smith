                async def json(self):
                    return {
                        "customApiKey": "testkey",
                        "customModelName": "gpt-4",
                        "goal": "test goal"
                    }

            import asyncio
            response = asyncio.run(api_chain.default(DummyRequest()))

            # Assert createModel called with correct customModelName
            mock_createModel.assert_called_once_with({
                "customApiKey": "testkey",
                "customModelName": "gpt-4"
            })

            # Assert startGoalAgent called with model instance and goal
            mock_startGoalAgent.assert_awaited_once()
            args, kwargs = mock_startGoalAgent.call_args
