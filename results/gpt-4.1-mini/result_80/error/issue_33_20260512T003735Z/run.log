             patch("src.pages.api.chain.startGoalAgent", new_callable=AsyncMock) as mock_startGoalAgent:

            # Setup mock_createModel to return a dummy model object
            dummy_model = object()
            mock_createModel.return_value = dummy_model

            # Setup mock_startGoalAgent to return a dummy completion object with text
            class DummyCompletion:
                text = "[\"task1\", \"task2\"]"
            mock_startGoalAgent.return_value = DummyCompletion()

            # Prepare a dummy request object with json method
            class DummyRequest:
                async def json(self):
                    return {
                        "customApiKey": "testkey",
                        "customModelName": "gpt-4",
                        "goal": "test goal"
                    }

            # Run the handler
            import asyncio
            response = asyncio.run(api_chain.default(DummyRequest()))

            # Assert createModel called with correct customModelName
            mock_createModel.assert_called_once_with({
                "customApiKey": "testkey",
                "customModelName": "gpt-4"
            })

            # Assert startGoalAgent called with dummy model and goal
            mock_startGoalAgent.assert_awaited_once_with(dummy_model, "test goal")

            # Assert response is JSON with newTasks key containing list of tasks
            self.assertTrue(hasattr(response, "json"))
            json_data = response.json()
            self.assertIn("newTasks", json_data)
            self.assertEqual(json_data["newTasks"], ["task1", "task2"])

