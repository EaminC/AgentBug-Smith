import importlib

class TestGPT4Option(unittest.TestCase):
    def test_create_model_uses_custom_model_name(self):
        """
        Test that createModel uses the customModelName option if provided,
        otherwise defaults to "gpt-3.5-turbo".
        """
        try:
            chain = importlib.import_module("src.utils.chain")
        except ImportError as e:
            self.fail(f"Failed to import src.utils.chain: {e}")

        # The createModel function returns an OpenAI instance with the correct modelName
        opts_with_model = {"customApiKey": "", "customModelName": "gpt-4"}
        model_instance = chain.createModel(opts_with_model)
        self.assertEqual(model_instance.modelName, "gpt-4")

        opts_without_model = {"customApiKey": "", "customModelName": ""}
        model_instance_default = chain.createModel(opts_without_model)
        self.assertEqual(model_instance_default.modelName, "gpt-3.5-turbo")

