[32m# Assumption: This is a Node.js project (Next.js app) based on package.json and package-lock.json presence and content.
# Using official Node 19 Alpine image as base.

FROM node:19-alpine AS test_builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

# Apply docker environment and schema changes as per Dockerfile snippet in repo.
RUN if [ -f ".env.docker" ]; then mv .env.docker .env; fi && \
    if [ -f "prisma/schema.prisma" ]; then \
      sed -ie 's/postgresql/sqlite/g' prisma/schema.prisma && \
      sed -ie 's/@db.Text//' prisma/schema.prisma; \
    fi

RUN npm run postinstall

# Run prisma migrations and db push if prisma files exist
RUN if [ -f "prisma/schema.prisma" ]; then \
      npx prisma migrate dev --name init && npx prisma db push; \
    fi

RUN npm run build

# Preflight check for Node.js environment: check node and npm versions
RUN node --version && npm --version

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Run tests if any test script or test framework is present
# Assumption: No explicit test command found; skipping test run in this Dockerfile.

FROM node:19-alpine AS runtime

WORKDIR /app

COPY package*.json ./

RUN npm ci --production

COPY . .

RUN if [ -f "prisma/schema.prisma" ]; then \
      npx prisma generate; \
    fi

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

EXPOSE 3000

