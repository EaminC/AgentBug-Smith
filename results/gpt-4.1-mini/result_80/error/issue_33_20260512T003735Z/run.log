from unittest.mock import patch, AsyncMock

class TestGPT4Option(unittest.TestCase):
    def test_create_model_uses_custom_model_name(self):
        """
        Test that createModel uses the customModelName option if provided,
        otherwise defaults to "gpt-3.5-turbo".
        """
        try:
            from src.utils import chain
        except ImportError as e:
            self.fail(f"Failed to import src.utils.chain: {e}")

        # Default modelName if customModelName is empty
        model_default = chain.createModel({"customApiKey": "", "customModelName": ""})
        self.assertEqual(model_default.modelName, "gpt-3.5-turbo")

        # Custom modelName used if provided
        custom_name = "gpt-4"
        model_custom = chain.createModel({"customApiKey": "", "customModelName": custom_name})
        self.assertEqual(model_custom.modelName, custom_name)

