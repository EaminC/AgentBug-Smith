[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Copy entire repo to /app
COPY . .

# Upgrade pip, setuptools, wheel early to avoid import-time failures
RUN python -m pip install --upgrade pip setuptools wheel

# Assumption: project uses 'python' folder as root for python code and pyproject.toml
# Detect 'src/' layout or imports of 'src.' in tests to decide on editable install
RUN if [ -d "python/src" ] || grep -Rq "^\s*from src\.|^\s*import src\." python/tests 2>/dev/null; then \
        pip install -r python/requirements.txt 2>/dev/null || true && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout pytest-snapshot; \
    else \
        pip install -r python/requirements.txt 2>/dev/null || true && \
        pip install -e python && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout pytest-snapshot; \
    fi

# Preflight import check to fail fast if core modules missing
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

# Run tests using uv if available, else fallback to pytest directly
RUN if command -v uv >/dev/null 2>&1; then \
        uv run pytest python; \
    else \
        pytest python; \
    fi

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Final minimal runtime stage
FROM python:3.12-slim AS runtime

WORKDIR /app

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r python/requirements.txt 2>/dev/null || true && \
    pip install -e python

