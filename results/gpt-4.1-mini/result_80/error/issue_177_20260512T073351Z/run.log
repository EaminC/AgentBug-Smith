# Set working directory to repo root
WORKDIR /app

# Copy entire repository into the container
COPY . .

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies needed to build and run Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libxml2-dev libxslt1-dev python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install the package and dependencies using pyproject.toml and hatchling
# Also install test-specific dependencies including pandas to fix import errors
RUN pip install . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-snapshot anyio pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm pandas

# Preflight import to check essential packages are installed
RUN python -c 'import pkg_resources, pytest, pandas; print("preflight ok")'

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Export other environment variables from .env
