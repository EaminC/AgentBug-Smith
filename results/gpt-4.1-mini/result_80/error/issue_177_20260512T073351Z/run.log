[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set workdir to /app, repo root
WORKDIR /app

# Copy entire repo
COPY . .

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies and the package
# Check for requirements.txt first, then pyproject.toml, else default install
RUN if [ -f "python/requirements.txt" ]; then \
        pip install -r python/requirements.txt && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-snapshot anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    elif [ -f "python/pyproject.toml" ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-snapshot anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    else \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-snapshot anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# Preflight import checks
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Forge API environment variables for OpenAI and Anthropic SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Expose environment Forge API key for builds
ENV FORGE_API_KEY=forge-key

# Default command to bash
CMD ["/bin/bash"]
# branch: python/requirements.txt or pyproject.toml
