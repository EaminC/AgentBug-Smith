import pytest
from unittest.mock import patch, AsyncMock

from src.agentscope.memory._mem0_utils import AgentScopeLLM


class DummyChatResponse:
    def __init__(self, content):
        self.content = content


@pytest.mark.asyncio
async def test_agentscope_llm_generate_response_tool_and_text(monkeypatch):
    """
    Test that AgentScopeLLM.generate_response returns the correct dict format
    when tools are provided and the model response contains text, thinking, and tool_use blocks.
    This tests the fix that adapts tool_results format to mem0's required format.
    """

    # Prepare dummy blocks simulating a model response with text, thinking, and tool_use blocks
    dummy_content = [
        {"type": "thinking", "thinking": "Analyzing data"},
        {"type": "text", "text": "Here is the answer."},
        {"type": "tool_use", "name": "Calculator", "input": {"expression": "2+2"}},
    ]

    # Create a dummy async function to replace the internal _async_call
    async def dummy_async_call():
        return DummyChatResponse(dummy_content)

    llm = AgentScopeLLM(config=type("Config", (), {"model": "dummy_model"}))

    # Patch the internal _async_call used in generate_response to return our dummy response
    with patch("src.agentscope.memory._mem0_utils.AgentScopeLLM.generate_response.__globals__['_async_call']", new=dummy_async_call):
        # Call generate_response with tools to trigger tool_calls output
        result = llm.generate_response(messages=[{"role": "user", "content": "Calculate 2+2"}], tools=[{"name": "Calculator"}])

    # The expected output is a dict with content combining thinking and text parts,
    # and tool_calls containing the tool use info
    expected_content = "[Thinking: Analyzing data]\nHere is the answer."
    expected_tool_calls = [{"name": "Calculator", "arguments": {"expression": "2+2"}}]

    assert isinstance(result, dict), "Result should be a dict when tools are provided"
    assert "content" in result and "tool_calls" in result, "Result dict must have 'content' and 'tool_calls' keys"
    assert result["content"] == expected_content
    assert result["tool_calls"] == expected_tool_calls


