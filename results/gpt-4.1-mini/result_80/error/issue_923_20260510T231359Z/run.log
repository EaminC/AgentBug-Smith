import pytest

from src.agentscope.memory._mem0_utils import AgentScopeLLM


class DummyChatResponse:
    def __init__(self, content):
        self.content = content


@pytest.mark.asyncio
async def test_agent_scope_llm_parse_response_tool_and_text():
    llm = AgentScopeLLM(config=type("Config", (), {"model": "dummy"})())

    # Compose a dummy ChatResponse with mixed blocks: thinking, text, tool_use
    dummy_response = DummyChatResponse(
        content=[
            {"type": "thinking", "thinking": "Analyzing data"},
            {"type": "text", "text": "Here is the result."},
            {"type": "tool_use", "name": "calculator", "input": {"expression": "2+2"}},
        ]
    )

    # Call the internal _parse_response method with has_tool=True
    parsed = llm._parse_response(dummy_response, has_tool=True)

    # The parsed output should be a dict with keys 'content' and 'tool_calls'
    assert isinstance(parsed, dict)
    assert "content" in parsed
    assert "tool_calls" in parsed

    # The content should include the thinking and text parts joined by newline
    assert "[Thinking: Analyzing data]" in parsed["content"]
    assert "Here is the result." in parsed["content"]

    # The tool_calls list should contain one dict with the tool name and arguments
    assert isinstance(parsed["tool_calls"], list)
    assert len(parsed["tool_calls"]) == 1
    tool_call = parsed["tool_calls"][0]
    assert tool_call["name"] == "calculator"
    assert tool_call["arguments"] == {"expression": "2+2"}


@pytest.mark.asyncio
async def test_agent_scope_llm_parse_response_text_only():
    llm = AgentScopeLLM(config=type("Config", (), {"model": "dummy"})())

    dummy_response = DummyChatResponse(
        content=[
            {"type": "thinking", "thinking": "Processing"},
            {"type": "text", "text": "Simple text response."},
        ]
    )

    # Call the internal _parse_response with has_tool=False
    parsed = llm._parse_response(dummy_response, has_tool=False)

    # Should return a string combining thinking and text parts
    assert isinstance(parsed, str)
    assert "[Thinking: Processing]" in parsed
    assert "Simple text response." in parsed


@pytest.mark.asyncio
async def test_agent_scope_llm_generate_response_empty_content(monkeypatch):
    llm = AgentScopeLLM(config=type("Config", (), {"model": "dummy"})())

    # Patch the internal async call to return a DummyChatResponse with empty content
    async def dummy_async_call():
        return DummyChatResponse(content=[])

    # Replace the _async_call method inside generate_response's scope
    monkeypatch.setattr(llm, "generate_response", lambda *args, **kwargs: asyncio.run(dummy_async_call()))

    # But we want to test the real generate_response method, so instead patch the internal call
    # We'll patch the _async_call inside generate_response by monkeypatching asyncio.run temporarily

    # Instead, we test generate_response by monkeypatching the internal _async_call function used inside it
    # The generate_response method defines _async_call inside itself, so we cannot patch it directly.
    # Instead, we patch the AgentScopeLLM._parse_response to detect if generate_response calls it correctly.

    # We will monkeypatch asyncio.run to return DummyChatResponse with empty content
    def fake_async_run(coro):
        return DummyChatResponse(content=[])

    monkeypatch.setattr(asyncio, "run", fake_async_run)

    # When tools is provided, generate_response should return dict with empty content and empty tool_calls
    result_with_tools = llm.generate_response(messages=[], tools=[{"name": "tool1"}])
    assert isinstance(result_with_tools, dict)
    assert result_with_tools["content"] == ""
    assert result_with_tools["tool_calls"] == []

    # When tools is None, generate_response should return empty string
    result_no_tools = llm.generate_response(messages=[], tools=None)
    assert result_no_tools == ""


@pytest.mark.asyncio
async def test_agent_scope_llm_generate_response_calls_parse_response(monkeypatch):
    llm = AgentScopeLLM(config=type("Config", (), {"model": "dummy"})())

    # Prepare a dummy response with content blocks
    dummy_response = DummyChatResponse(
        content=[
            {"type": "text", "text": "Hello"},
            {"type": "tool_use", "name": "toolA", "input": {"param": 123}},
        ]
    )

    # Patch asyncio.run to return dummy_response
    monkeypatch.setattr(asyncio, "run", lambda coro: dummy_response)

    # Patch _parse_response to track call and call original implementation
    called = {}

    original_parse_response = llm._parse_response

    def tracking_parse_response(response, has_tool):
        called["called"] = True
        return original_parse_response(response, has_tool)

    monkeypatch.setattr(llm, "_parse_response", tracking_parse_response)

    # Call generate_response with tools to trigger has_tool=True
    result = llm.generate_response(messages=[], tools=[{"name": "toolA"}])

    # The _parse_response should be called
    assert called.get("called", False)

    # Result should be dict with content and tool_calls keys
    assert isinstance(result, dict)
    assert "content" in result
    assert "tool_calls" in result
    assert "Hello" in result["content"]
    assert any(tc["name"] == "toolA" for tc in result["tool_calls"])


