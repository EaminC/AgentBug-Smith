@pytest.mark.asyncio
async def test_agentscope_llm_generate_response_format_tool_calls(monkeypatch):
    """
    Test that AgentScopeLLM.generate_response returns the correct dict format
    with 'content' and 'tool_calls' keys when tools are provided, and returns
    a string when no tools are provided.

    This test covers the bug where the output format of tool_results was not
    aligned with mem0's required format.
    """

    # Prepare dummy content simulating model response with tool_use blocks
    dummy_content = [
        {"type": "thinking", "thinking": "Processing..."},
        {"type": "text", "text": "Here is some text."},
        {"type": "tool_use", "name": "search_tool", "input": {"query": "test"}},
    ]

    dummy_response = DummyChatResponse(dummy_content)

    async def dummy_async_call():
        return dummy_response

    # Patch the internal _async_call method to return dummy_response
    # We patch the asyncio.run to call dummy_async_call instead of real call
    with patch("src.agentscope.memory._mem0_utils.AgentScopeLLM.generate_response.__globals__['asyncio'].run", new=lambda coro: asyncio.get_event_loop().run_until_complete(dummy_async_call())):

        llm = AgentScopeLLM(config={"model": "dummy_model"})

        # Case 1: tools argument is provided (simulate tool calls)
        tools = [{"name": "search_tool"}]
        result = llm.generate_response(messages=[{"role": "user", "content": "Hello"}], tools=tools)

        # The result should be a dict with keys 'content' and 'tool_calls'
        assert isinstance(result, dict)
        assert "content" in result
        assert "tool_calls" in result
        # Content should contain thinking and text parts joined by newline
        assert "[Thinking: Processing...]" in result["content"]
        assert "Here is some text." in result["content"]
        # tool_calls should be a list with one dict describing the tool use
        assert isinstance(result["tool_calls"], list)
        assert any(tc.get("name") == "search_tool" for tc in result["tool_calls"])
        assert any(tc.get("arguments") == {"query": "test"} for tc in result["tool_calls"])

        # Case 2: tools argument is None (no tool calls)
        result_no_tools = llm.generate_response(messages=[{"role": "user", "content": "Hello"}], tools=None)

        # The result should be a string containing thinking and text parts joined by newline
        assert isinstance(result_no_tools, str)
        assert "[Thinking: Processing...]" in result_no_tools
        assert "Here is some text." in result_no_tools
        # It should not contain "tool_calls" key or be a dict
        assert not isinstance(result_no_tools, dict)


def test_parse_response_empty_content():
    """
    Test that _parse_response returns empty string or dict with empty tool_calls
    when the model response content is empty, depending on has_tool flag.
    """

    llm = AgentScopeLLM(config={"model": "dummy_model"})

    # Empty content with no tools
    empty_response = DummyChatResponse(content=[])
    result = llm._parse_response(empty_response, has_tool=False)
    assert result == ""

    # Empty content with tools
    result_with_tools = llm._parse_response(empty_response, has_tool=True)
    assert isinstance(result_with_tools, dict)
    assert result_with_tools.get("content") == ""
    assert result_with_tools.get("tool_calls") == []


def test_parse_response_various_blocks():
    """
    Test that _parse_response correctly parses different block types
    and returns the expected string or dict format.
    """

    llm = AgentScopeLLM(config={"model": "dummy_model"})

    content_blocks = [
        {"type": "thinking", "thinking": "Thinking step"},
        {"type": "text", "text": "Some text here"},
        {"type": "tool_use", "name": "tool1", "input": {"param": 1}},
        {"type": "unknown", "text": "Should be ignored"},
    ]

    response = DummyChatResponse(content=content_blocks)

    # When has_tool=True, expect dict with content and tool_calls
    result = llm._parse_response(response, has_tool=True)
    assert isinstance(result, dict)
    assert "content" in result
    assert "tool_calls" in result
    # Content should include thinking and text parts joined by newline
    assert "[Thinking: Thinking step]" in result["content"]
    assert "Some text here" in result["content"]
    # tool_calls should contain the tool_use block info
    assert any(tc.get("name") == "tool1" for tc in result["tool_calls"])
    assert any(tc.get("arguments") == {"param": 1} for tc in result["tool_calls"])

    # When has_tool=False, expect a string with thinking and text parts only
    result_str = llm._parse_response(response, has_tool=False)
    assert isinstance(result_str, str)
    assert "[Thinking: Thinking step]" in result_str
    assert "Some text here" in result_str
    # Should not include tool_use info in string output
    assert "tool1" not in result_str


def test_generate_response_returns_empty_when_no_content(monkeypatch):
