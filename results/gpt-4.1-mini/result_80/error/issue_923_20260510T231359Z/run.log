def test_parse_response_direct_call():
    """
    Test the internal _parse_response method directly with various block types.
    """

    llm = AgentScopeLLM(config=type("Config", (), {"model": "dummy_model"}))

    # Compose a dummy ChatResponse with mixed blocks
    dummy_response = DummyChatResponse(
        content=[
            {"type": "thinking", "thinking": "Thinking..."},
            {"type": "text", "text": "Hello world."},
            {"type": "tool_use", "name": "Search", "input": {"query": "Python"}},
        ]
    )

    # Call _parse_response with has_tool=True
    result_with_tool = llm._parse_response(dummy_response, has_tool=True)
    assert isinstance(result_with_tool, dict)
    assert "content" in result_with_tool and "tool_calls" in result_with_tool
    assert "[Thinking: Thinking...]" in result_with_tool["content"]
    assert "Hello world." in result_with_tool["content"]
    assert result_with_tool["tool_calls"] == [{"name": "Search", "arguments": {"query": "Python"}}]

    # Call _parse_response with has_tool=False
    result_no_tool = llm._parse_response(dummy_response, has_tool=False)
    assert isinstance(result_no_tool, str)
    assert "[Thinking: Thinking...]" in result_no_tool
    assert "Hello world." in result_no_tool
    assert "[Tool:" not in result_no_tool  # tool_use blocks should not appear as string when has_tool=False


