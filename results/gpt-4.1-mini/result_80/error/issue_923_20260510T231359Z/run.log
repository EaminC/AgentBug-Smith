    # Prepare a dummy response content simulating tool use blocks and text/thinking blocks
    dummy_content = [
        {"type": "thinking", "thinking": "Analyzing the data"},
        {"type": "text", "text": "Here is the answer."},
        {"type": "tool_use", "name": "calculator", "input": {"expression": "2+2"}},
        {"type": "tool_use", "name": "search", "input": {"query": "Python testing"}},
    ]

    dummy_response = DummyChatResponse(content=dummy_content)

    async def dummy_async_call():
        return dummy_response

