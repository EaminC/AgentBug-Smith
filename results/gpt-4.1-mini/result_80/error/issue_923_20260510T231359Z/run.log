@pytest.mark.asyncio
async def test_generate_response_with_tools(monkeypatch):
    # Prepare a dummy response with text, thinking, and tool_use blocks
    dummy_content = [
        {"type": "thinking", "thinking": "Processing"},
        {"type": "text", "text": "Result is ready."},
        {"type": "tool_use", "name": "search", "input": {"query": "Python"}},
    ]

    # Create an instance of AgentScopeLLM with dummy config
    llm = AgentScopeLLM(config=type("Config", (), {"model": None})())

    # Patch asyncio.run to return dummy response
    with patch("asyncio.run", return_value=DummyChatResponse(dummy_content)):
        # Call generate_response with tools (has_tool=True)
        result = llm.generate_response(messages=[{"role": "user", "content": "Search something"}], tools=[{"name": "search"}])

        # The expected output is a dict with content and tool_calls keys
        assert isinstance(result, dict)
        assert "content" in result
        assert "tool_calls" in result

        # Content should be thinking + text joined by newline
        expected_content = "[Thinking: Processing]\nResult is ready."
        assert result["content"] == expected_content

        # tool_calls should be a list with one dict describing the tool use
        assert isinstance(result["tool_calls"], list)
        assert len(result["tool_calls"]) == 1
        tool_call = result["tool_calls"][0]
        assert tool_call["name"] == "search"
        assert tool_call["arguments"] == {"query": "Python"}


@pytest.mark.asyncio
async def test_generate_response_empty_content(monkeypatch):
    # Prepare a dummy response with empty content
    dummy_content = []

    # Create an instance of AgentScopeLLM with dummy config
    llm = AgentScopeLLM(config=type("Config", (), {"model": None})())

    # Patch asyncio.run to return dummy response
    with patch("asyncio.run", return_value=DummyChatResponse(dummy_content)):
        # Call generate_response with tools (has_tool=True)
        result_with_tools = llm.generate_response(messages=[{"role": "user", "content": "Empty"}], tools=[{"name": "tool"}])
        assert isinstance(result_with_tools, dict)
        assert result_with_tools["content"] == ""
        assert result_with_tools["tool_calls"] == []

        # Call generate_response without tools (has_tool=False)
        result_without_tools = llm.generate_response(messages=[{"role": "user", "content": "Empty"}], tools=None)
        assert result_without_tools == ""


@pytest.mark.asyncio
async def test_parse_response_various_blocks():
    llm = AgentScopeLLM(config=type("Config", (), {"model": None})())

    # Compose a model_response with mixed blocks
    model_response = DummyChatResponse(
        content=[
            {"type": "text", "text": "Hello"},
            {"type": "thinking", "thinking": "Wait"},
            {"type": "tool_use", "name": "calc", "input": {"expr": "2+2"}},
            {"type": "unknown", "data": "ignored"},
        ]
    )

    # Test parse_response with has_tool=True
    parsed = llm._parse_response(model_response, has_tool=True)
    assert isinstance(parsed, dict)
    assert "content" in parsed
    assert "tool_calls" in parsed
    # Content should include thinking and text parts joined by newline
    assert parsed["content"] == "[Thinking: Wait]\nHello"
    # tool_calls should include the tool_use block
    assert parsed["tool_calls"] == [{"name": "calc", "arguments": {"expr": "2+2"}}]

    # Test parse_response with has_tool=False
    parsed_no_tool = llm._parse_response(model_response, has_tool=False)
    assert isinstance(parsed_no_tool, str)
    assert parsed_no_tool == "[Thinking: Wait]\nHello"


