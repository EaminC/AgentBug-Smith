    assert "tool_calls" in result_with_tools
    # The content should include thinking and text parts joined by newline
    assert "[Thinking: Processing...]" in result_with_tools["content"]
    assert "Hello, this is a response." in result_with_tools["content"]
    # The tool_calls should include the tool use block info
    assert any(
        call.get("name") == "search_tool" and call.get("arguments") == {"query": "Python"}
        for call in result_with_tools["tool_calls"]
    )

    # Test without tools (has_tool=False)
    result_without_tools = llm.generate_response(
        messages=[{"role": "user", "content": "Query"}],
        tools=None,
    )
    # The result should be a string
    assert isinstance(result_without_tools, str)
    # It should contain the thinking and text parts joined by newline
    assert "[Thinking: Processing...]" in result_without_tools
    assert "Hello, this is a response." in result_without_tools
    # It should NOT contain tool calls info
    assert "[Tool:" not in result_without_tools


@patch("src.agentscope.memory._mem0_utils.AgentScopeLLM._async_call", new_callable=AsyncMock)
def test_generate_response_empty_content(mock_async_call):
    # Simulate empty content response
    dummy_response = DummyChatResponse(content=[])
    mock_async_call.return_value = dummy_response

    llm = AgentScopeLLM(config=None)

    # With tools
    result_with_tools = llm.generate_response(
        messages=[{"role": "user", "content": "Empty test"}],
        tools=[{"name": "dummy_tool"}],
    )
    assert isinstance(result_with_tools, dict)
    assert result_with_tools == {"content": "", "tool_calls": []}

    # Without tools
