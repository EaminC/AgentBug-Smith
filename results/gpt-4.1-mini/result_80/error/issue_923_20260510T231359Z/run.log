@pytest.mark.asyncio
async def test_generate_response_format_tool_calls(monkeypatch):
    """
    This test verifies that AgentScopeLLM.generate_response returns the correct
    format for responses with and without tool calls, matching mem0's expected format.

    The buggy version returns a joined string with tool calls appended as strings,
    while the fixed version returns a dict with 'content' and 'tool_calls' keys.
    """

    # Prepare dummy response content with text, thinking, and tool_use blocks
    dummy_content_with_tools = [
        {"type": "thinking", "thinking": "Processing"},
        {"type": "text", "text": "Hello"},
        {"type": "tool_use", "name": "search", "input": {"query": "test"}},
    ]

    dummy_content_without_tools = [
        {"type": "thinking", "thinking": "Waiting"},
        {"type": "text", "text": "No tools here"},
    ]

    # Create an instance of AgentScopeLLM with a dummy config
    class DummyConfig:
        model = "dummy-model"

    llm = AgentScopeLLM(DummyConfig())

    # Patch the internal async call to return our dummy response with tools
    async def dummy_async_call_tools():
        return DummyChatResponse(dummy_content_with_tools)

    # Patch the internal async call to return our dummy response without tools
    async def dummy_async_call_no_tools():
        return DummyChatResponse(dummy_content_without_tools)

    # Patch asyncio.run to use dummy async call with tools
    with patch("asyncio.run", side_effect=lambda coro: asyncio.get_event_loop().run_until_complete(coro)):

        # Patch the _async_call method inside generate_response to return dummy with tools
        with patch.object(llm, "generate_response", wraps=llm.generate_response) as mock_generate:
            # Patch _async_call inside generate_response to dummy_async_call_tools
            # We do this by patching the inner _async_call function via monkeypatching the method
            async def _async_call_tools():
                return DummyChatResponse(dummy_content_with_tools)

            # Monkeypatch the _async_call function inside generate_response
            # Since _async_call is a local function, we patch generate_response to call dummy_async_call_tools instead
            original_generate = llm.generate_response

            async def patched_generate_response_with_tools(*args, **kwargs):
                # Simulate the inner _async_call returning dummy with tools
                response = await _async_call_tools()
                has_tool = kwargs.get("tools") is not None
                return llm._parse_response(response, has_tool)

            llm.generate_response = patched_generate_response_with_tools

            # Test with tools argument (has_tool=True)
            result = await llm.generate_response(
                messages=[{"role": "user", "content": "Hi"}],
                tools=[{"name": "search"}],
            )

            # The result should be a dict with keys 'content' and 'tool_calls'
            assert isinstance(result, dict)
            assert "content" in result
            assert "tool_calls" in result
            assert result["content"].startswith("[Thinking: Processing]")
            assert any(call.get("name") == "search" for call in result["tool_calls"])

            # Restore original generate_response
            llm.generate_response = original_generate

        # Patch the _async_call method inside generate_response to return dummy without tools
        async def _async_call_no_tools():
            return DummyChatResponse(dummy_content_without_tools)

        async def patched_generate_response_no_tools(*args, **kwargs):
            response = await _async_call_no_tools()
            has_tool = kwargs.get("tools") is not None
            return llm._parse_response(response, has_tool)

        llm.generate_response = patched_generate_response_no_tools

        # Test without tools argument (has_tool=False)
        result_no_tools = await llm.generate_response(
            messages=[{"role": "user", "content": "Hello"}],
            tools=None,
        )

        # The result should be a string containing the thinking and text parts
        assert isinstance(result_no_tools, str)
        assert "[Thinking: Waiting]" in result_no_tools
        assert "No tools here" in result_no_tools


def test_parse_response_tool_calls_formatting():
    """
    Test the _parse_response method directly for correct formatting of tool calls,
    thinking blocks, and text blocks.
    """
    llm = AgentScopeLLM(config=type("Config", (), {"model": "dummy"}))

    # Construct a dummy ChatResponse with mixed blocks
    response = type("ChatResponse", (), {})()
    response.content = [
        {"type": "thinking", "thinking": "Loading"},
        {"type": "text", "text": "Result text"},
        {"type": "tool_use", "name": "calculator", "input": {"expr": "2+2"}},
    ]

    # Call _parse_response with has_tool=True
    parsed = llm._parse_response(response, has_tool=True)

    # Should be a dict with content and tool_calls keys
    assert isinstance(parsed, dict)
    assert "content" in parsed
    assert "tool_calls" in parsed
    # Content should include the thinking and text parts joined by newline
    assert parsed["content"].startswith("[Thinking: Loading]")
    assert "Result text" in parsed["content"]
    # tool_calls should contain the tool_use block info
    assert any(tc.get("name") == "calculator" for tc in parsed["tool_calls"])

    # Call _parse_response with has_tool=False
    parsed_str = llm._parse_response(response, has_tool=False)

    # Should be a string containing thinking and text parts joined
    assert isinstance(parsed_str, str)
    assert "[Thinking: Loading]" in parsed_str
    assert "Result text" in parsed_str
    # Should NOT include tool calls as dict, but ignore them
    assert "calculator" not in parsed_str


