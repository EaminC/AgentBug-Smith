import pytest
from unittest.mock import patch, AsyncMock

from src.agentscope.memory._mem0_utils import AgentScopeLLM


class DummyChatResponse:
    def __init__(self, content):
        self.content = content


@pytest.mark.asyncio
async def test_agentscope_llm_generate_response_format_tool_calls(monkeypatch):
    """
    This test verifies that AgentScopeLLM.generate_response returns the correct
    output format when the model response contains tool calls.

    Buggy behavior:
      - The method returns a plain string combining all parts including tool calls.
    Fixed behavior:
      - The method returns a dict with keys "content" and "tool_calls" when tools are present.
    """

    # Prepare dummy response content with text, thinking, and tool_use blocks
    dummy_content = [
        {"type": "thinking", "thinking": "Processing"},
        {"type": "text", "text": "Hello, this is a response."},
        {"type": "tool_use", "name": "search", "input": {"query": "Python"}},
    ]

    # Create an instance of AgentScopeLLM with dummy config
    class DummyConfig:
        model = "dummy_model"

    llm = AgentScopeLLM(DummyConfig())

    # Patch the internal async call to return our dummy response
    async def dummy_async_call():
        return DummyChatResponse(dummy_content)

    # Patch the _async_call method inside generate_response to our dummy_async_call
    # We patch the _async_call function by patching the asyncio.run to call our dummy_async_call
    # but since asyncio.run is called on _async_call inside generate_response, we patch the method to return dummy response
    # Instead, patch the _async_call function inside generate_response's scope by patching the AgentScopeLLM._async_call attribute
    # However, _async_call is a local function inside generate_response, so we patch asyncio.run to call dummy_async_call

    with patch("asyncio.run", side_effect=lambda coro: asyncio.get_event_loop().run_until_complete(dummy_async_call())):
        # Call generate_response with tools argument to indicate tool usage
        result = llm.generate_response(
            messages=[{"role": "user", "content": "Test message"}],
            tools=[{"name": "search"}],
        )

    # The result should be a dict with keys "content" and "tool_calls"
    assert isinstance(result, dict), "Expected dict output when tools are provided"
    assert "content" in result, "Result dict should have 'content' key"
    assert "tool_calls" in result, "Result dict should have 'tool_calls' key"
    # The content should include the thinking and text parts joined by newline
    expected_content = "[Thinking: Processing]\nHello, this is a response."
    assert result["content"] == expected_content
    # The tool_calls should be a list with one dict describing the tool use
    assert isinstance(result["tool_calls"], list)
    assert len(result["tool_calls"]) == 1
    tool_call = result["tool_calls"][0]
    assert tool_call["name"] == "search"
    assert tool_call["arguments"] == {"query": "Python"}


@pytest.mark.asyncio
async def test_agentscope_llm_generate_response_format_no_tools(monkeypatch):
    """
    This test verifies that AgentScopeLLM.generate_response returns a string output
    when no tools are provided.

    Buggy behavior:
      - The method returns a dict even when no tools are present.
    Fixed behavior:
      - The method returns a string when no tools are provided.
    """

    dummy_content = [
        {"type": "thinking", "thinking": "Waiting"},
        {"type": "text", "text": "Simple response without tools."},
    ]

    class DummyConfig:
        model = "dummy_model"

    llm = AgentScopeLLM(DummyConfig())

    async def dummy_async_call():
        return DummyChatResponse(dummy_content)

    with patch("asyncio.run", side_effect=lambda coro: asyncio.get_event_loop().run_until_complete(dummy_async_call())):
        result = llm.generate_response(
            messages=[{"role": "user", "content": "Hello"}],
            tools=None,
        )

    # The result should be a string
    assert isinstance(result, str), "Expected string output when no tools are provided"
    expected_content = "[Thinking: Waiting]\nSimple response without tools."
    assert result == expected_content


