        messages=[{"role": "user", "content": "Empty test"}],
        tools=None,
    )
    assert result_without_tools == ""


@patch("src.agentscope.memory._mem0_utils.AgentScopeLLM._async_call", new_callable=AsyncMock)
def test_generate_response_unrecognized_blocks(mock_async_call):
    # Provide content with unrecognized block types to test fallback to str conversion
    dummy_response = DummyChatResponse(content=[{"foo": "bar"}])
    mock_async_call.return_value = dummy_response

    llm = AgentScopeLLM(config=None)

    # With tools
    result_with_tools = llm.generate_response(
        messages=[{"role": "user", "content": "Unrecognized test"}],
        tools=[{"name": "dummy_tool"}],
    )
    # Should be dict with content as string representation of content list
    assert isinstance(result_with_tools, dict)
    assert "content" in result_with_tools
    assert "tool_calls" in result_with_tools
    assert str(dummy_response.content) in result_with_tools["content"]

    # Without tools
    result_without_tools = llm.generate_response(
        messages=[{"role": "user", "content": "Unrecognized test"}],
        tools=None,
    )
    # Should be string representation of content list
    assert isinstance(result_without_tools, str)
    assert str(dummy_response.content) == result_without_tools


def test_parse_response_directly():
    # Test the internal _parse_response method directly for coverage

    llm = AgentScopeLLM(config=None)

    # Compose a model_response with mixed blocks
    model_response = DummyChatResponse(
        content=[
            {"type": "thinking", "thinking": "Wait a moment"},
            {"type": "text", "text": "Here is the answer."},
            {"type": "tool_use", "name": "calculator", "input": {"expr": "2+2"}},
        ]
    )

    # When has_tool=True, expect dict with content and tool_calls
    parsed = llm._parse_response(model_response, has_tool=True)
    assert isinstance(parsed, dict)
    assert "content" in parsed
    assert "tool_calls" in parsed
    assert "[Thinking: Wait a moment]" in parsed["content"]
    assert "Here is the answer." in parsed["content"]
    assert any(
        call.get("name") == "calculator" and call.get("arguments") == {"expr": "2+2"}
        for call in parsed["tool_calls"]
    )

    # When has_tool=False, expect a string with thinking and text parts joined
    parsed_str = llm._parse_response(model_response, has_tool=False)
    assert isinstance(parsed_str, str)
    assert "[Thinking: Wait a moment]" in parsed_str
    assert "Here is the answer." in parsed_str
    # Should NOT include tool calls in string output
    assert "calculator" not in parsed_str


def test_generate_response_raises_runtime_error():
