[32mimport asyncio
import pytest

from src.agentscope.memory._mem0_utils import AgentScopeLLM


class DummyChatResponse:
    def __init__(self, content):
        self.content = content


@pytest.mark.asyncio
async def test_agentscope_llm_parse_response_tool_and_text():
    llm = AgentScopeLLM(config=None)

    # Compose a dummy model_response with mixed blocks: thinking, text, tool_use
    model_response = DummyChatResponse(
        content=[
            {"type": "thinking", "thinking": "Processing"},
            {"type": "text", "text": "Hello world"},
            {"type": "tool_use", "name": "search", "input": {"query": "Python"}},
        ]
    )

    # has_tool True means tool_calls expected in output dict
    result = llm._parse_response(model_response, has_tool=True)
    assert isinstance(result, dict)
    assert "content" in result
    assert "tool_calls" in result
    # Content should include thinking and text parts joined by newline
    assert "[Thinking: Processing]" in result["content"]
    assert "Hello world" in result["content"]
    # tool_calls should have one entry with correct name and arguments
    assert isinstance(result["tool_calls"], list)
    assert len(result["tool_calls"]) == 1
    assert result["tool_calls"][0]["name"] == "search"
    assert result["tool_calls"][0]["arguments"] == {"query": "Python"}

    # has_tool False means output is a string with thinking and text only
    result_str = llm._parse_response(model_response, has_tool=False)
    assert isinstance(result_str, str)
    assert "[Thinking: Processing]" in result_str
    assert "Hello world" in result_str
    # tool_use blocks should not appear in string output
    assert "search" not in result_str


@pytest.mark.asyncio
async def test_agentscope_llm_generate_response_returns_dict_with_tools(monkeypatch):
    llm = AgentScopeLLM(config=None)

    # Patch asyncio.run to simulate async call returning a DummyChatResponse with tool_use block
    dummy_response = DummyChatResponse(
        content=[
            {"type": "text", "text": "Hi"},
            {"type": "tool_use", "name": "calculator", "input": {"expr": "2+2"}},
        ]
    )

    async def dummy_async_call():
        return dummy_response

    monkeypatch.setattr(llm, "generate_response", None)  # Disable original generate_response temporarily

    # Patch internal _async_call used in generate_response
    def fake_asyncio_run(coro):
        # coro is _async_call coroutine, we return dummy_response
        return dummy_response

    monkeypatch.setattr(asyncio, "run", fake_asyncio_run)

    # Call generate_response with tools argument to trigger has_tool True
    result = llm.generate_response(
        messages=[{"role": "user", "content": "Calculate 2+2"}],
        tools=[{"name": "calculator"}],
    )
    # Result should be a dict with content and tool_calls keys
    assert isinstance(result, dict)
    assert "content" in result
    assert "tool_calls" in result
    assert "Hi" in result["content"]
    assert any(tc["name"] == "calculator" for tc in result["tool_calls"])


@pytest.mark.asyncio
