def test_agentscope_llm_parse_response_tool_and_text_blocks():
    """
    Test the internal _parse_response method of AgentScopeLLM to ensure it correctly
    parses mixed content blocks into the expected dict or string format.
    """

    model = AgentScopeLLM(config={"model": "dummy_model"})

    # Compose a dummy ChatResponse object with mixed blocks
    class DummyChatResponse:
        def __init__(self, content):
            self.content = content

    content_blocks = [
        {"type": "thinking", "thinking": "Calculating..."},
        {"type": "text", "text": "Result is ready."},
        {"type": "tool_use", "name": "calculator", "input": {"expression": "2+2"}},
    ]

    response = DummyChatResponse(content_blocks)

    # When has_tool=True, expect a dict with content and tool_calls keys
    parsed = model._parse_response(response, has_tool=True)
    assert isinstance(parsed, dict)
    assert "content" in parsed
    assert "tool_calls" in parsed
    # Content should contain thinking and text parts joined by newline
    assert "[Thinking: Calculating...]" in parsed["content"]
    assert "Result is ready." in parsed["content"]
    # tool_calls should contain the tool use block info
    assert isinstance(parsed["tool_calls"], list)
    assert len(parsed["tool_calls"]) == 1
    tool_call = parsed["tool_calls"][0]
    assert tool_call["name"] == "calculator"
    assert tool_call["arguments"] == {"expression": "2+2"}

    # When has_tool=False, expect a string with thinking and text parts joined by newline
    parsed_no_tool = model._parse_response(response, has_tool=False)
    assert isinstance(parsed_no_tool, str)
    assert "[Thinking: Calculating...]" in parsed_no_tool
    assert "Result is ready." in parsed_no_tool
    # The tool_use block should be ignored in string output (based on the code logic)
    assert "calculator" not in parsed_no_tool


