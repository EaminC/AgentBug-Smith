import pytest
from unittest.mock import patch, AsyncMock

from src.agentscope.memory._mem0_utils import AgentScopeLLM


class DummyChatResponse:
    def __init__(self, content):
        self.content = content


@pytest.mark.asyncio
async def test_agentscope_llm_generate_response_format_tool_calls(monkeypatch):
    """
    This test verifies that AgentScopeLLM.generate_response returns the correct
    output format when tool calls are present and when they are absent.

    On the buggy codebase, the tool_results format is not aligned with mem0's
    required format, causing the test to fail.

    After applying the fix, the test should pass.
    """

    # Prepare dummy response content with text, thinking, and tool_use blocks
    dummy_content = [
        {"type": "thinking", "thinking": "Processing"},
        {"type": "text", "text": "Hello, world!"},
        {"type": "tool_use", "name": "dummy_tool", "input": {"param": "value"}},
    ]

    # Create a dummy async function to replace the internal async call
    async def dummy_async_call(*args, **kwargs):
        return DummyChatResponse(dummy_content)

    # Patch the internal async call inside generate_response to return dummy response
    with patch.object(AgentScopeLLM, "generate_response", wraps=AgentScopeLLM.generate_response) as gen_resp_mock:
        # Patch the internal _async_call to our dummy_async_call
        with patch("src.agentscope.memory._mem0_utils.AgentScopeLLM.generate_response.__globals__['_async_call']", new=dummy_async_call):
            # Instantiate AgentScopeLLM with minimal config
            llm = AgentScopeLLM(config={"model": "dummy_model"})

            # Call generate_response with tools present (has_tool=True)
            result_with_tools = llm.generate_response(
                messages=[{"role": "user", "content": "Test"}],
                tools=[{"name": "dummy_tool"}],
            )

            # The result should be a dict with keys "content" and "tool_calls"
            assert isinstance(result_with_tools, dict), "Expected dict output when tools are present"
            assert "content" in result_with_tools, "Missing 'content' key in output dict"
            assert "tool_calls" in result_with_tools, "Missing 'tool_calls' key in output dict"
            assert "Processing" in result_with_tools["content"], "Thinking part missing in content"
            assert "Hello, world!" in result_with_tools["content"], "Text part missing in content"
            assert isinstance(result_with_tools["tool_calls"], list), "'tool_calls' should be a list"
            assert any(tc.get("name") == "dummy_tool" for tc in result_with_tools["tool_calls"]), "Tool call missing"

            # Call generate_response with no tools (has_tool=False)
            result_no_tools = llm.generate_response(
                messages=[{"role": "user", "content": "Test"}],
                tools=None,
            )

            # The result should be a string containing thinking and text parts
            assert isinstance(result_no_tools, str), "Expected string output when no tools are present"
            assert "[Thinking: Processing]" in result_no_tools, "Thinking part missing in string output"
            assert "Hello, world!" in result_no_tools, "Text part missing in string output"
            # The tool_use block should not appear as string in output
            assert "dummy_tool" not in result_no_tools, "Tool info should not appear in string output"

@pytest.mark.asyncio
async def test_agentscope_llm_generate_response_empty_content(monkeypatch):
    """
    Test that generate_response returns the correct empty outputs
    when the model response content is empty, depending on presence of tools.
    """

    async def dummy_async_call_empty(*args, **kwargs):
        return DummyChatResponse(content=[])

    with patch("src.agentscope.memory._mem0_utils.AgentScopeLLM.generate_response.__globals__['_async_call']", new=dummy_async_call_empty):
        llm = AgentScopeLLM(config={"model": "dummy_model"})

        # With tools present, should return dict with empty content and tool_calls list
        result_with_tools = llm.generate_response(
            messages=[{"role": "user", "content": "Test"}],
            tools=[{"name": "dummy_tool"}],
        )
        assert isinstance(result_with_tools, dict), "Expected dict output when tools are present"
        assert result_with_tools.get("content") == "", "Expected empty content string"
        assert isinstance(result_with_tools.get("tool_calls"), list), "Expected tool_calls to be a list"
        assert len(result_with_tools["tool_calls"]) == 0, "Expected empty tool_calls list"

        # With no tools, should return empty string
        result_no_tools = llm.generate_response(
            messages=[{"role": "user", "content": "Test"}],
            tools=None,
        )
        assert isinstance(result_no_tools, str), "Expected string output when no tools are present"
        assert result_no_tools == "", "Expected empty string output when no tools and empty content"


def test_format_relations_method_present_and_correct():
