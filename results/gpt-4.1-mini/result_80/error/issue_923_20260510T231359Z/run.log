import pytest
from unittest.mock import patch, AsyncMock

from src.agentscope.memory._mem0_utils import AgentScopeLLM


class DummyChatResponse:
    def __init__(self, content):
        self.content = content


@pytest.mark.asyncio
async def test_agentscope_llm_generate_response_tool_and_text_format():
    # Prepare a dummy response content simulating the model output with tool calls and text/thinking blocks
    dummy_response_content = [
        {"type": "thinking", "thinking": "Analyzing input"},
        {"type": "text", "text": "Here is some answer text."},
        {"type": "tool_use", "name": "search_tool", "input": {"query": "python testing"}},
    ]

    dummy_response = DummyChatResponse(content=dummy_response_content)

    # Patch the internal async call to return our dummy response
    async def dummy_async_call():
        return dummy_response

    # Patch asyncio.run to call dummy_async_call instead of the real network call
    with patch("src.agentscope.memory._mem0_utils.asyncio.run", side_effect=lambda coro: asyncio.get_event_loop().run_until_complete(dummy_async_call())):
        llm = AgentScopeLLM(config=type("Config", (), {"model": "dummy_model"}))
        # Provide tools to trigger tool_calls output format
        tools = [{"name": "search_tool"}]

        result = llm.generate_response(
            messages=[{"role": "user", "content": "test message"}],
            tools=tools,
        )

        # The result should be a dict with keys "content" and "tool_calls"
        assert isinstance(result, dict), "Result should be a dict when tools are provided"
        assert "content" in result, "Result dict should contain 'content' key"
        assert "tool_calls" in result, "Result dict should contain 'tool_calls' key"

        # The content should include the thinking and text parts concatenated with newline
        expected_content = "[Thinking: Analyzing input]\nHere is some answer text."
        assert result["content"] == expected_content, f"Content mismatch: {result['content']}"

        # The tool_calls should contain one dict with the correct tool name and arguments
        assert isinstance(result["tool_calls"], list), "tool_calls should be a list"
        assert len(result["tool_calls"]) == 1, "There should be exactly one tool call"
        tool_call = result["tool_calls"][0]
        assert tool_call["name"] == "search_tool"
        assert tool_call["arguments"] == {"query": "python testing"}


