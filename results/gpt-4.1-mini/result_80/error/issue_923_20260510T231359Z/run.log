[32mimport asyncio
import pytest
from unittest.mock import patch, AsyncMock

from src.agentscope.memory._mem0_utils import AgentScopeLLM


class DummyChatResponse:
    def __init__(self, content):
        self.content = content


@pytest.mark.asyncio
async def test_agentscope_llm_generate_response_tool_and_no_tool(monkeypatch):
    """
    This test verifies that AgentScopeLLM.generate_response returns the correct
    output format both when tools are provided and when they are not.

    The buggy code returns an incorrect format for tool_results when tools are used,
    causing failures downstream. The fix aligns the output format with mem0's expectations.

    The test mocks the internal async call to return a crafted response with mixed
    block types (text, thinking, tool_use) and asserts that the output matches the
    expected dict format with "content" and "tool_calls" keys when tools are given,
    and a string when no tools are given.
    """

    # Prepare a dummy response content with mixed block types
    dummy_content = [
        {"type": "thinking", "thinking": "Analyzing input"},
        {"type": "text", "text": "Here is the answer."},
        {"type": "tool_use", "name": "search", "input": {"query": "test"}},
    ]

    # Patch the internal async call to return our dummy response
    async def dummy_async_call():
        return DummyChatResponse(dummy_content)

    llm = AgentScopeLLM(config=None)

    # Patch the _async_call method inside generate_response to our dummy
    with patch.object(llm, 'generate_response', wraps=llm.generate_response) as gen_resp_mock:
        with patch('src.agentscope.memory._mem0_utils.AgentScopeLLM.generate_response.__globals__'
                   + "['asyncio'].run", side_effect=lambda coro: asyncio.get_event_loop().run_until_complete(coro)):
            with patch('src.agentscope.memory._mem0_utils.AgentScopeLLM.generate_response.__globals__'
                       + "['_async_call']", new=dummy_async_call):
                # Actually patch the _async_call attribute in the method's closure
                # Because _async_call is local, patching it directly is tricky.
                # Instead, patch the entire generate_response to call dummy_async_call internally.
                # So we patch the method to call dummy_async_call and then _parse_response.

                # We do a manual call to _parse_response to simulate the internal logic.
                # But since the test must run real method, we patch asyncio.run to call dummy_async_call.

                # Test with tools provided (has_tool=True)
                tools = [{"name": "search"}]
                # Patch asyncio.run to return dummy response
                with patch('asyncio.run', side_effect=lambda coro: dummy_async_call()):
                    result_with_tools = llm.generate_response(
                        messages=[{"role": "user", "content": "Hello"}],
                        tools=tools,
                    )

                # The expected output is a dict with keys "content" and "tool_calls"
                expected_content = "[Thinking: Analyzing input]\nHere is the answer."
                expected_tool_calls = [{"name": "search", "arguments": {"query": "test"}}]

                assert isinstance(result_with_tools, dict), "Expected dict output when tools are provided"
                assert result_with_tools.get("content") == expected_content
                assert result_with_tools.get("tool_calls") == expected_tool_calls

                # Test without tools (has_tool=False)
                with patch('asyncio.run', side_effect=lambda coro: dummy_async_call()):
                    result_without_tools = llm.generate_response(
                        messages=[{"role": "user", "content": "Hello"}],
                        tools=None,
                    )

                # The expected output is a string combining thinking and text blocks
                expected_str = "[Thinking: Analyzing input]\nHere is the answer."

                assert isinstance(result_without_tools, str), "Expected string output when no tools are provided"
                assert result_without_tools == expected_str


def test_format_relations_in_mem0_long_term_memory():
    """
    This test verifies that the _format_relations method in Mem0LongTermMemory
    correctly formats relations from a search result dictionary.

    The buggy code did not handle relations correctly, causing errors or missing data.
    The fix added the _format_relations method and integrated it.

    This test imports the real Mem0LongTermMemory class and calls _format_relations
    with a sample input, asserting the expected formatted output.
    """
    from src.agentscope.memory._mem0_long_term_memory import Mem0LongTermMemory

    mem = Mem0LongTermMemory(agent_name="test", user_name="user", model=None, embedding_model=None)

    sample_result = {
        "relations": [
            {"source": "NodeA", "relationship": "connected_to", "destination": "NodeB"},
            {"source": "NodeC", "relationship": "linked_with", "destination": "NodeD"},
        ]
    }

    formatted = mem._format_relations(sample_result)

    expected = [
        "NodeA -- connected_to -- NodeB",
        "NodeC -- linked_with -- NodeD",
    ]

    assert formatted == expected

    # Also test with no relations key returns empty list
    assert mem._format_relations({}) == []

    # Test with empty relations list returns empty list
    assert mem._format_relations({"relations": []}) == [][0m
