    assert len(formatted) == 2, "Should format all relations"
    assert formatted[0] == "NodeA -- connected_to -- NodeB"
    assert formatted[1] == "NodeX -- linked_with -- NodeY"

    # Test with no relations key returns empty list
    assert mem._format_relations({"results": []}) == []

