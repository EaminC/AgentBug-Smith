# Stage 1: build and test
FROM node:20-alpine AS test_builder

WORKDIR /app

# Install dependencies and build project
COPY . .
RUN apk add --no-cache bash git && \
    if [ -f "package-lock.json" ]; then \
      npm install && \
      npm run build; \
    elif [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm && \
      pnpm install && \
      pnpm run build; \
    else \
      npm install && \
      npm run build; \
    fi

# Run tests using vitest as per package.json scripts
RUN npx vitest run

# Preflight check to verify vitest is available and basic import works
RUN node -e "import('vitest').then(() => console.log('preflight ok')).catch(e => { console.error(e); process.exit(1) })"

# Set mandatory environment variables for Forge
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Stage 2: production runtime
FROM node:20-alpine AS runtime

WORKDIR /app

COPY package.json package-lock.json* pnpm-lock.yaml* ./

# Install production dependencies only
RUN apk add --no-cache bash && \
    if [ -f "package-lock.json" ]; then \
      npm ci --omit=dev; \
    elif [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm && \
      pnpm install --prod; \
    else \
      npm ci --omit=dev; \
    fi

COPY . .

ENV NODE_ENV=production

# Set mandatory environment variables for Forge
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

CMD ["/bin/bash"][0m
