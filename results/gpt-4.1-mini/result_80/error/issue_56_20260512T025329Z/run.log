    agent = SearchAgent(enable_web_search=False)

    # The buggy code tries to access config_dict['general']['search_engine'] directly,
    # which raises KeyError. So on buggy code, this test should error or fail.
    # On fixed code, it should not raise and should log "No search engine is set."
    # We assert that no exception is raised and the log message is present.

    # Check that engine_name attribute is None or falsy due to missing key
    assert getattr(agent, "engine_name", None) in (None, "")

    # Check that the log message about missing search engine is present
    assert any("No search engine is set." in log for log in logs)


def test_search_agent_with_search_engine_key(monkeypatch):
    # Prepare a config dict with 'search_engine' key in 'general'
    config_data = {
        'general': {
            'search_engine': 'google'
        },
        'google': {
            'api_key': 'dummy_key'
        }
    }

    class DummyConfig:
        def read(self):
            return config_data

    monkeypatch.setattr(search_agent, "Config", lambda *args, **kwargs: DummyConfig())

    logs = []

    class DummyConsole:
        def log(self, msg):
            logs.append(msg)

    monkeypatch.setattr(search_agent.SearchAgent, "console", DummyConsole())

    agent = SearchAgent(enable_web_search=False)

    # On both buggy and fixed code, with the key present, engine_name should be set correctly
    assert agent.engine_name == 'google'

    # The log message about missing search engine should NOT appear
    assert not any("No search engine is set." in log for log in logs)[0m
