def test_search_agent_handles_missing_search_engine_key(monkeypatch):
    """
    This test verifies that SearchAgent does not raise KeyError when
    'search_engine' is missing in config['general'] and logs a message instead.
    """

    # Prepare a config dict without 'search_engine' key in 'general'
    config_dict = {
        "general": {
            # 'search_engine' key is intentionally missing
            "other_setting": "value"
        },
        # even if other keys exist, they should not matter here
        "some_engine": {
            "name": "some_engine",
            "api_key": "dummy"
        }
    }

    dummy_config = DummyConfig(config_dict)
    dummy_console = DummyConsole()

    # Patch the Config class to return our dummy config
    monkeypatch.setattr(search_agent, "Config", lambda *args, **kwargs: dummy_config)
    # Patch the console attribute on SearchAgent to our dummy console
    # We will instantiate SearchAgent with enable_web_search=True to force config reading
    # But we patch the console attribute after instantiation

    # Instantiate SearchAgent with enable_web_search=True to trigger config reading
    agent = SearchAgent(enable_web_search=True)
    # Override console with dummy_console to capture logs
    agent.console = dummy_console

    # The buggy code will raise KeyError here when accessing config_dict['general']['search_engine']
    # The fixed code uses .get() and logs a message and returns early

    # We test that no KeyError is raised and that the log message is present
    # Because the constructor returns early if no search_engine is set, engine_name should be None or empty
    assert hasattr(agent, "engine_name")
    # engine_name should be None or falsy because 'search_engine' key is missing
    assert not agent.engine_name
    # The dummy_console should have logged the message about no search engine set
    assert any("No search engine is set" in msg for msg in dummy_console.messages)


def test_search_agent_with_search_engine_key(monkeypatch):
    """
    This test verifies that SearchAgent correctly reads the search_engine key
    when it is present in the config.
    """

    config_dict = {
        "general": {
            "search_engine": "some_engine"
        },
        "some_engine": {
            "name": "some_engine",
            "api_key": "dummy"
        }
    }

    dummy_config = DummyConfig(config_dict)
    dummy_console = DummyConsole()

    monkeypatch.setattr(search_agent, "Config", lambda *args, **kwargs: dummy_config)

    agent = SearchAgent(enable_web_search=True)
    agent.console = dummy_console

    # The engine_name should be set correctly
    assert agent.engine_name == "some_engine"
    # The search_engine config should be read and have the correct name
    # The buggy code reads search_engine = config.read().get(self.engine_name)
    # We can check that attribute exists on agent (it is set in __init__)
    # But since the attribute is local in __init__, we can't access it directly.
    # So just check engine_name correctness and no error raised.
    assert not dummy_console.messages  # no error logs


def test_search_agent_with_enable_web_search_false(monkeypatch):
    """
    This test verifies that SearchAgent does not read config or raise error
    when enable_web_search is False.
