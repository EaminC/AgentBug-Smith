    # Patch ReflectAgent.invoke to raise if called (should not be called in this test)
    def reflect_invoke(self, requirement):
        raise AssertionError("ReflectAgent.invoke should not be called when debug_env is 'just_generate_code'")
    monkeypatch.setattr(ReflectAgent, "invoke", reflect_invoke)

    # Patch LeaderAgent.console.log to capture logs
    logs = []
    monkeypatch.setattr(LeaderAgent, "console", MagicMock(log=lambda self, msg: logs.append(msg)))

    # Create a LeaderAgent instance with minimal required attributes
    agent = LeaderAgent.__new__(LeaderAgent)
    agent.console = MagicMock(log=lambda msg: logs.append(msg))
    agent.project = MagicMock()
    agent.project.debug_env = None
    agent.project.entry_file = "tests/dummy_entry_file.py"
    agent.agent = MagicMock()
    agent.requirement = "dummy requirement"

    # Patch read_file_to_string to return dummy code string
    monkeypatch.setattr("agent.function.tech_leader.read_file_to_string", lambda filepath: "print('hello')")

    # Patch SetupAgent to avoid real invocation
    monkeypatch.setattr("agent.function.tech_leader.SetupAgent", SetupAgent)

    # Patch ReflectAgent to avoid real invocation
    monkeypatch.setattr("agent.function.tech_leader.ReflectAgent", ReflectAgent)

    # Run the part of start() method that triggers the bug fix behavior
    # We simulate the relevant part of start() to isolate test
    agent.project.debug_env = "just_generate_code"
    existing_code = "print('hello')"
    setup_agent = SetupAgent(agent.agent)
    setup_agent.invoke(existing_code)

    # Normally ReflectAgent.invoke would be called only if debug_env != 'just_generate_code'
    if agent.project.debug_env != 'just_generate_code':
        reflect_agent = ReflectAgent(agent.agent, agent.project)
        reflect_agent.invoke(agent.requirement)
    else:
        agent.console.log("The code execution and reflection are skipped.")

    # Check that the skip log message is present
    assert any("skipped" in log.lower() for log in logs)


@pytest.mark.parametrize("config_dict,expected_engine_name", [
    ({"general": {"search_engine": "google"}}, "google"),
    ({"general": {}}, None),
    ({"general": {"search_engine": ""}}, ""),
])
def test_search_agent_engine_name(monkeypatch, config_dict, expected_engine_name):
    class DummyConfig:
        def read(self):
            return config_dict

    monkeypatch.setattr(search_agent, "config", DummyConfig())
    monkeypatch.setattr(search_agent.SearchAgent, "console", MagicMock(log=lambda msg: None))

    agent = search_agent.SearchAgent(enable_web_search=True)
    assert agent.engine_name == expected_engine_name or agent.engine_name is None

