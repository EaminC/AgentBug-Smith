    monkeypatch.setattr(SearchAgent, "__init__", patched_init)

    # Now instantiate SearchAgent and check behavior
    agent = SearchAgent(enable_web_search=True)

    # The buggy code would raise KeyError here; fixed code should not raise and log a message
    # So if no exception, test passes so far
    # Check that console logged the expected message about missing search engine
    found_log = any("No search engine is set." in msg for msg in dummy_console.logged_messages)
    assert found_log, "Expected log message about missing search engine not found"


def test_search_agent_with_search_engine_key(monkeypatch):
    # Provide a config dict with 'search_engine' key to verify normal behavior
    dummy_config_data = {
        "general": {
            "search_engine": "google"
        },
        "google": {
            "name": "google",
            "url": "https://www.google.com"
        }
    }

    dummy_console = DummyConsole()

    monkeypatch.setattr(search_agent, "Config", lambda *args, **kwargs: DummyConfig(dummy_config_data))

    original_init = SearchAgent.__init__

    def patched_init(self, enable_web_search=True):
        original_init(self, enable_web_search)
        self.console = dummy_console

    monkeypatch.setattr(SearchAgent, "__init__", patched_init)

    agent = SearchAgent(enable_web_search=True)

    # The engine_name should be set correctly
    assert agent.engine_name == "google"

    # The search_engine dict should have 'name' key set to engine_name
    # The original code sets search_engine['name'] = self.engine_name
    # We can check if agent has attribute search_engine and its 'name' is correct
    # But the original class does not expose search_engine as attribute, so we test engine_name only
    # Also no error should be raised
    # No "No search engine is set." log should be present
    found_log = any("No search engine is set." in msg for msg in dummy_console.logged_messages)
    assert not found_log, "Unexpected log message about missing search engine found"


def test_search_agent_no_config(monkeypatch):
    # Simulate Config.read returning empty dict or no 'general' key
    dummy_config_data = {}

    dummy_console = DummyConsole()

    monkeypatch.setattr(search_agent, "Config", lambda *args, **kwargs: DummyConfig(dummy_config_data))

    original_init = SearchAgent.__init__

    def patched_init(self, enable_web_search=True):
        original_init(self, enable_web_search)
        self.console = dummy_console

    monkeypatch.setattr(SearchAgent, "__init__", patched_init)

    # This should not raise but log about missing search engine
    agent = SearchAgent(enable_web_search=True)

    found_log = any("No search engine is set." in msg for msg in dummy_console.logged_messages)
    assert found_log, "Expected log message about missing search engine not found"


# The above tests ensure that the SearchAgent constructor handles missing 'search_engine' key safely,
