    def __init__(self, data):
        self._data = data

    def read(self):
        return self._data


def test_search_agent_handles_missing_search_engine(monkeypatch):
    # Setup a config dict without 'search_engine' key in 'general'
    config_data = {
        "general": {
            # 'search_engine' key is intentionally missing to trigger the bug
        }
    }
    dummy_config = DummyConfig(config_data)

    # Patch Config.read to return our dummy config data
    monkeypatch.setattr(search_agent.Config, "read", dummy_config.read)

    # Patch Console.log to capture logs
    logs = []

    def fake_log(msg):
        logs.append(msg)

    monkeypatch.setattr(search_agent.SearchAgent, "console", Console())
    monkeypatch.setattr(search_agent.SearchAgent.console, "log", fake_log)

    # Create SearchAgent instance with enable_web_search=False to trigger config reading path
    agent = SearchAgent(enable_web_search=False)

    # The engine_name should be None or falsy due to missing key
    assert agent.engine_name is None or agent.engine_name == ""

    # The log should contain the message about no search engine set
    assert any("No search engine is set." in log for log in logs)


def test_search_agent_with_search_engine(monkeypatch):
    # Setup a config dict with 'search_engine' key in 'general'
    config_data = {
        "general": {
            "search_engine": "google"
        },
        "google": {
            "api_key": "dummy_key"
        }
    }
    dummy_config = DummyConfig(config_data)

    monkeypatch.setattr(search_agent.Config, "read", dummy_config.read)

    # Patch Console.log to capture logs (should not log no search engine message)
    logs = []

    def fake_log(msg):
        logs.append(msg)

    monkeypatch.setattr(search_agent.SearchAgent, "console", Console())
    monkeypatch.setattr(search_agent.SearchAgent.console, "log", fake_log)

    agent = SearchAgent(enable_web_search=False)

    # The engine_name should be set to 'google'
    assert agent.engine_name == "google"

    # The logs should NOT contain the no search engine message
    assert not any("No search engine is set." in log for log in logs)[0m
