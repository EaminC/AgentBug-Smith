    dummy_console = DummyConsole()
    monkeypatch.setattr(search_agent, "console", dummy_console)

    agent = search_agent.SearchAgent(enable_web_search=enable_web_search)

    # The agent should have no engine_name set
    assert getattr(agent, "engine_name", None) is None or agent.engine_name == ""

    # The log should contain the message about no search engine set
    assert any("No search engine is set" in m for m in dummy_console.logged) or not dummy_console.logged

