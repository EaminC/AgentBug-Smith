    assert agent.engine_name == 'google'


def test_search_agent_real_init_handles_missing_search_engine(monkeypatch):
    # This test calls the real SearchAgent.__init__ but patches Config.read to simulate missing key
    config_data = {
        'general': {
            # no 'search_engine' key
        }
    }

    class DummyConfig:
        def read(self):
            return config_data

    dummy_config = DummyConfig()
    monkeypatch.setattr(search_agent, "Config", lambda *args, **kwargs: dummy_config)

    logs = []

    class DummyConsole:
        def log(self, msg):
            logs.append(msg)

    # Patch SearchAgent.console to DummyConsole via patching __init__ after creation
    # We create instance with enable_web_search=True
    agent = SearchAgent(enable_web_search=True)
    agent.console = DummyConsole()

    # Because __init__ reads config and tries to get engine_name, it should set engine_name to None and log message
    # But since __init__ already ran with the patched Config, engine_name should be None
    # We verify that no KeyError is raised and log message is present

    assert agent.engine_name is None
    assert "No search engine is set." in logs


# The above tests verify that the bug causing KeyError on missing 'search_engine' key is fixed.
# On buggy code, these tests will fail with KeyError.
# On fixed code, these tests pass.[0m
