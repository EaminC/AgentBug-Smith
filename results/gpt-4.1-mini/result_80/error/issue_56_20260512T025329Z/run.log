    monkeypatch.setattr(tech_leader, "ReflectAgent", lambda agent, project: dummy_reflect_agent)

    # Patch LeaderAgent.console to capture logs
    dummy_console = DummyConsole()
    monkeypatch.setattr(tech_leader.LeaderAgent, "console", dummy_console)

    # Create a dummy LeaderAgent instance with minimal required attributes
    leader_agent = LeaderAgent.__new__(LeaderAgent)
    leader_agent.project = mock.Mock()
