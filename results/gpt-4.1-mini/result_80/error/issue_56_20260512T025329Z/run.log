def test_search_agent_init_with_empty_general(monkeypatch):
    """
    This test verifies that SearchAgent handles empty 'general' dict gracefully.
    """

    config_dict = {
        "general": {},
    }

    dummy_config = DummyConfig(config_dict)
    dummy_console = DummyConsole()

    monkeypatch.setattr(search_agent, "Config", lambda *args, **kwargs: dummy_config)

    agent = SearchAgent(enable_web_search=True)
    agent.console = dummy_console

    assert not agent.engine_name
    assert any("No search engine is set" in msg for msg in dummy_console.messages)[0m
