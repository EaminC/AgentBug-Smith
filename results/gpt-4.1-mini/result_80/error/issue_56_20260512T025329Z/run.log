def test_search_agent_init_with_missing_search_engine(monkeypatch):
    # Patch the config.read method to simulate config without 'search_engine' key
    dummy_config = {
        'general': {
            # 'search_engine' key is intentionally missing to simulate old config
        }
    }

    class DummyConfig:
        def read(self):
            return dummy_config

    # Patch the config module inside search_agent to use DummyConfig
    monkeypatch.setattr(search_agent, "config", DummyConfig())

    # Patch the console.log method to capture logs
    logs = []

    class DummyConsole:
        def log(self, msg):
            logs.append(msg)

    # Patch the SearchAgent.console to DummyConsole instance
    monkeypatch.setattr(search_agent.SearchAgent, "console", DummyConsole())

    # Create SearchAgent instance with enable_web_search=True to trigger config reading
    agent = search_agent.SearchAgent(enable_web_search=True)

    # The engine_name attribute should be None or falsy because 'search_engine' key is missing
    # In buggy code, this would raise KeyError, so this line should fail in buggy code
    # After fix, it should not raise and engine_name should be None or ''
    assert getattr(agent, "engine_name", None) in (None, "")

    # The console should log the message about no search engine set
    assert any("No search engine is set." in log for log in logs)


