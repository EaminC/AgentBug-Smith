    monkeypatch.setattr(search_agent, "Config", fail_config)

    # Instantiate with enable_web_search=False should not raise
    agent = SearchAgent(enable_web_search=False)
    # It should have engine_name attribute set to None
    assert agent.engine_name is None or agent.engine_name == ""


