from unittest.mock import patch, MagicMock
from agent.function import search_agent


def test_search_agent_init_with_missing_search_engine_key(monkeypatch):
    """
    Test that SearchAgent does not raise KeyError when 'search_engine' key is missing
    in the config_dict['general'] dictionary.

    This test triggers the buggy behavior on the old codebase (KeyError),
    and after the fix, it should pass without exceptions.
    """

    # Prepare a dummy config object with a read() method returning a dict missing 'search_engine'
    dummy_config = MagicMock()
    dummy_config.read.return_value = {
        'general': {
            # 'search_engine' key is intentionally missing to trigger the bug
        }
    }

    # Patch the config module used inside search_agent to return our dummy_config
    monkeypatch.setattr(search_agent, "config", dummy_config)

    # Patch the console attribute in SearchAgent to a dummy with a log method
    dummy_console = MagicMock()
    monkeypatch.setattr(search_agent, "Console", MagicMock(return_value=dummy_console))

    # Instantiate SearchAgent with enable_web_search=False to force config reading path
    # The buggy code will raise KeyError here, fixed code will handle missing key gracefully
    try:
        agent = search_agent.SearchAgent(enable_web_search=False)
    except KeyError as e:
        pytest.fail(f"SearchAgent raised KeyError unexpectedly: {e}")

    # After initialization, engine_name should be None or falsy due to missing key
    assert getattr(agent, "engine_name", None) in (None, ''), "engine_name should be None or empty string when missing"

    # The console.log should be called with the warning message about missing search engine
    dummy_console.log.assert_called_with("No search engine is set.")[0m
