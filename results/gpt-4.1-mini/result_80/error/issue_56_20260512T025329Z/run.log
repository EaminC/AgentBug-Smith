def test_search_agent_handles_missing_search_engine_key(monkeypatch):
    # Patch config.read to simulate config dict without 'search_engine' key
    dummy_config = {
        'general': {
            # 'search_engine' key is intentionally missing to trigger the bug
        }
    }

    class DummyConfig:
        def read(self):
            return dummy_config

    # Patch the config module inside search_agent to use DummyConfig
    monkeypatch.setattr(search_agent, "config", DummyConfig())

    # Patch console.log to capture logs
    logs = []
    monkeypatch.setattr(search_agent.SearchAgent, "console", MagicMock(log=lambda msg: logs.append(msg)))

    # Create SearchAgent instance with enable_web_search=True to trigger code path
    agent = search_agent.SearchAgent(enable_web_search=True)

    # Because 'search_engine' key is missing, engine_name should be None and log message emitted
    assert agent.engine_name is None or agent.engine_name == ""
    assert any("No search engine is set." in log for log in logs)


