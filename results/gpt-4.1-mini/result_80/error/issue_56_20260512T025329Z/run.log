def test_search_agent_init_handles_missing_search_engine(monkeypatch):
    # Patch console.log to capture logs
    logs = []

    class DummyConsole:
        def log(self, msg):
            logs.append(msg)

    # Patch config.read() is done by fixture

    # Instantiate SearchAgent with enable_web_search=True to trigger config reading
    agent = SearchAgent(enable_web_search=True)
    # The buggy code tries to access config_dict['general']['search_engine'] directly and will raise KeyError
    # The fixed code uses .get() and logs a message and returns early.

    # If the bug is present, this test will error out with KeyError and fail.
    # After fix, it should not raise and logs should contain the message about no search engine set.
