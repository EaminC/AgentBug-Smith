from unittest.mock import patch, MagicMock
from agent.function import search_agent


def test_search_agent_init_with_missing_search_engine_key(monkeypatch):
    """
    This test verifies that SearchAgent initialization does not raise KeyError
    when the 'search_engine' key is missing in the config's 'general' section.
    It should handle missing key gracefully (e.g., by logging and returning early).

    On the buggy codebase, this test will fail with KeyError.
    After the fix, it should pass.
    """

    # Prepare a config dict missing 'search_engine' key in 'general'
    fake_config_dict = {
        'general': {
            # 'search_engine' key is intentionally missing here
            'other_setting': 'value'
        }
    }

    # Patch the config.read method used inside SearchAgent.__init__ to return our fake config
    class FakeConfig:
        def read(self):
            return fake_config_dict

    # Patch the config attribute in search_agent module to our FakeConfig instance
    monkeypatch.setattr(search_agent, "config", FakeConfig())

    # Patch the console attribute to a MagicMock to capture logs without printing
    monkeypatch.setattr(search_agent, "Console", lambda: MagicMock())

    # Now instantiate SearchAgent with enable_web_search=False to trigger config reading
    # It should not raise KeyError even though 'search_engine' key is missing
    agent = search_agent.SearchAgent(enable_web_search=False)

    # The engine_name attribute should be None or falsy because 'search_engine' key is missing
    assert not getattr(agent, "engine_name", None), "engine_name should be None or falsy when missing in config"

    # If the fix is applied, no exception is raised and engine_name is None/falsy
    # If buggy, this test will error out with KeyError


def test_search_agent_init_with_search_engine_key(monkeypatch):
    """
    This test verifies SearchAgent initialization when 'search_engine' key is present.
    It should set engine_name correctly and not raise.
    """

    fake_config_dict = {
        'general': {
            'search_engine': 'google'
        },
        'google': {
            'api_key': 'dummy_key'
        }
    }

    class FakeConfig:
        def read(self):
            return fake_config_dict

    monkeypatch.setattr(search_agent, "config", FakeConfig())
    monkeypatch.setattr(search_agent, "Console", lambda: MagicMock())

    agent = search_agent.SearchAgent(enable_web_search=False)

    assert agent.engine_name == 'google'
    # The search_engine config should be read and set properly


@pytest.mark.parametrize("enable_web_search", [True, False])
def test_search_agent_enable_web_search(monkeypatch, enable_web_search):
    """
    Test that SearchAgent sets enable_web_search attribute correctly.
    """

    # Minimal config to avoid KeyError
    fake_config_dict = {
        'general': {
            'search_engine': 'duckduckgo'
        },
        'duckduckgo': {
            'api_key': 'dummy'
        }
    }

    class FakeConfig:
        def read(self):
            return fake_config_dict

    monkeypatch.setattr(search_agent, "config", FakeConfig())
    monkeypatch.setattr(search_agent, "Console", lambda: MagicMock())

    agent = search_agent.SearchAgent(enable_web_search=enable_web_search)
    assert agent.enable_web_search == enable_web_search

