    """

    # Prepare a dummy config dict without 'search_engine' key in 'general'
    dummy_config = {
        'general': {
            # 'search_engine' key is intentionally missing to simulate old config
        }
    }

    # Patch the config.read method to return our dummy config
    class DummyConfig:
        def read(self_inner):
            return dummy_config

    # Patch the config attribute in search_agent module to use DummyConfig instance
    monkeypatch.setattr(search_agent, "config", DummyConfig())

    # Patch the console.log method to capture logs
    logged_messages = []

    class DummyConsole:
        def log(self_inner, msg):
            logged_messages.append(msg)

    monkeypatch.setattr(search_agent, "console", DummyConsole())

    # Instantiate SearchAgent with enable_web_search=False to avoid other code paths
    agent = search_agent.SearchAgent(enable_web_search=False)

    # The engine_name should be None or falsy due to missing key
    assert getattr(agent, "engine_name", None) is None or agent.engine_name == ""

    # The log should contain the message about no search engine set
    assert any("No search engine is set" in m for m in logged_messages)

    # Because of the fix, no KeyError should be raised and the test should pass


def test_search_agent_init_with_search_engine_key(monkeypatch):
    """
