import unittest
from unittest.mock import patch, AsyncMock

from agentscope.memory._long_term_memory._mem0._mem0_utils import _run_async
from agentscope.memory._long_term_memory._mem0._mem0_long_term_memory import Mem0LongTermMemory
from agentscope.message import Msg
from agentscope.model.ollama import OllamaChatModel, OllamaTextEmbedding


class TestMem0LongTermMemoryOllama(unittest.TestCase):
    def setUp(self):
        # Patch the OllamaChatModel.__call__ and OllamaTextEmbedding.__call__ to avoid real network calls
        self.chatmodel_patcher = patch(
            "agentscope.model.ollama.OllamaChatModel.__call__",
            new_callable=AsyncMock,
        )
        self.embedding_patcher = patch(
            "agentscope.model.ollama.OllamaTextEmbedding.__call__",
            new_callable=AsyncMock,
        )
        self.mock_chat_call = self.chatmodel_patcher.start()
        self.mock_embedding_call = self.embedding_patcher.start()

        # Mock chat model response to simulate a normal response with content attribute
        class DummyContent:
            content = "dummy response"

        async def dummy_chat_response(*args, **kwargs):
            # Return an object with a content attribute (simulate ChatResponse)
            return DummyContent()

        self.mock_chat_call.side_effect = dummy_chat_response

        # Mock embedding model response to simulate embedding vector
        class DummyEmbedding:
            embeddings = [[0.1, 0.2, 0.3]]

        async def dummy_embedding_response(*args, **kwargs):
            return DummyEmbedding()

        self.mock_embedding_call.side_effect = dummy_embedding_response

    def tearDown(self):
        self.chatmodel_patcher.stop()
        self.embedding_patcher.stop()

    def test_record_and_retrieve_no_exception(self):
        long_term_memory = Mem0LongTermMemory(
            agent_name="Friday",
            user_name="user_123",
            model=OllamaChatModel(
                "qwen3:0.6b",
                True,
                host="http://host.docker.internal:11434",
            ),
            embedding_model=OllamaTextEmbedding(
                "qwen3-embedding:0.6b",
                1024,
                host="http://host.docker.internal:11434",
            ),
            on_disk=False,
        )

        async def test():
            # Record a message
            await long_term_memory.record([Msg(name="user", content="我喜欢住民宿", role="user")])
            # Retrieve using a query message
            retrieve_result = await long_term_memory.retrieve([Msg(name="user", content="我的住宿偏好", role="user")])
            return retrieve_result

        # Run the async test and assert no exceptions and valid result
        result = asyncio.run(test())
        self.assertIsNotNone(result)
        # The result should be a list or similar container (Mem0LongTermMemory returns list of Msg)
        self.assertTrue(hasattr(result, "__iter__"))
        # Each item should be a Msg instance
        for item in result:
            self.assertTrue(isinstance(item, Msg))


if __name__ == "__main__":
