from agentscope.message import Msg


class TestMem0LongTermMemoryOllama(unittest.TestCase):
    def setUp(self):
        # Patch the OllamaChatModel and OllamaTextEmbedding __call__ methods to return dummy responses
        # that simulate the expected behavior without real network calls.
        self.chatmodel_patcher = patch(
            "agentscope.model.ollama.OllamaChatModel.__call__",
            new_callable=AsyncMock,
        )
        self.embedding_patcher = patch(
            "agentscope.model.ollama.OllamaTextEmbedding.__call__",
            new_callable=AsyncMock,
        )

        self.mock_chatmodel_call = self.chatmodel_patcher.start()
        self.mock_embedding_call = self.embedding_patcher.start()

        # Mock chat model response to simulate a normal chat response object with .content attribute
        class DummyChatResponse:
            def __init__(self):
                self.content = "dummy response content"
                self.choices = [{"message": {"content": "dummy response content"}}]

        async def dummy_chat_response(*args, **kwargs):
            return DummyChatResponse()

        self.mock_chatmodel_call.side_effect = dummy_chat_response

        # Mock embedding model response to simulate embedding vector list
        class DummyEmbeddingResponse:
            def __init__(self):
                self.embeddings = [[0.1, 0.2, 0.3]]

        async def dummy_embedding_response(*args, **kwargs):
            return DummyEmbeddingResponse()

        self.mock_embedding_call.side_effect = dummy_embedding_response

    def tearDown(self):
        self.chatmodel_patcher.stop()
        self.embedding_patcher.stop()

    def test_record_and_retrieve(self):
        long_term_memory = Mem0LongTermMemory(
            agent_name="Friday",
            user_name="user_123",
            model=OllamaChatModel(
                "qwen3:0.6b",
                True,
                host="http://host.docker.internal:11434",
            ),
            embedding_model=OllamaTextEmbedding(
                "qwen3-embedding:0.6b",
                1024,
                host="http://host.docker.internal:11434",
            ),
            on_disk=False,
        )

        async def test_async():
            # Record a message
            await long_term_memory.record([Msg(name="user", content="我喜欢住民宿", role="user")])
            # Retrieve based on a query message
            retrieve_result = await long_term_memory.retrieve([Msg(name="user", content="我的住宿偏好", role="user")])
            return retrieve_result

        # Use the _run_async helper from the fixed code to run the coroutine properly
        result = _run_async(test_async())

        # Assert that result is not None and contains expected dummy response content
        self.assertIsNotNone(result)
        # The result should be a list of messages or similar; check type and content
        self.assertTrue(hasattr(result, "__iter__"))
        # Check that at least one message content matches the dummy response content
        contents = [msg.content for msg in result if hasattr(msg, "content")]
        self.assertIn("dummy response content", contents)


