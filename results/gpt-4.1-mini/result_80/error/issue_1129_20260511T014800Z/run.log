class TestLongTermMemory(unittest.TestCase):
    @patch("agentscope.model.ollama.OllamaChatModel.__call__", new_callable=AsyncMock)
    @patch("agentscope.model.ollama.OllamaTextEmbedding.__call__", new_callable=AsyncMock)
    def test_record_and_retrieve(self, mock_embedding_call, mock_chat_call):
        # Setup mock return values for OllamaChatModel and OllamaTextEmbedding calls
        # The mocked chat model returns a response object with a 'content' attribute
        class DummyResponse:
            def __init__(self, content):
                self.content = content

        # The mocked embedding model returns a dummy embedding list
        mock_embedding_call.return_value = [0.1, 0.2, 0.3]

        # The mocked chat model returns a DummyResponse with content string
        mock_chat_call.return_value = DummyResponse("dummy response content")

        long_term_memory = Mem0LongTermMemory(
            agent_name="Friday",
            user_name="user_123",
            model=OllamaChatModel(
                "qwen3:0.6b",
                True,
                host="http://host.docker.internal:11434",
            ),
            embedding_model=OllamaTextEmbedding(
                "qwen3-embedding:0.6b",
                1024,
                host="http://host.docker.internal:11434",
            ),
            on_disk=False,
        )

        async def test():
            # Record a message
            await long_term_memory.record([Msg(name="user", content="我喜欢住民宿", role="user")])
            # Retrieve with a query message
            retrieve_result = await long_term_memory.retrieve([Msg(name="user", content="我的住宿偏好", role="user")])
            return retrieve_result

        result = asyncio.run(test())
        # Assert the result is not None and contains expected dummy content
        self.assertIsNotNone(result)
        # Since the dummy response content is "dummy response content", check if it's in the result string
        self.assertIn("dummy response content", str(result))


