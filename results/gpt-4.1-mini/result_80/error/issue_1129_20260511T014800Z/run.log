class TestMem0LongTermMemoryOllama(unittest.TestCase):
    def setUp(self):
        # Patch the OllamaChatModel and OllamaTextEmbedding __call__ methods to simulate async responses
        self.chat_patcher = patch.object(OllamaChatModel, "__call__", new_callable=AsyncMock)
        self.embed_patcher = patch.object(OllamaTextEmbedding, "__call__", new_callable=AsyncMock)

        self.mock_chat_call = self.chat_patcher.start()
        self.mock_embed_call = self.embed_patcher.start()

        # Simulate a chat response object with .content attribute
        class DummyChatResponse:
            def __init__(self, content):
                self.content = content

        # Simulate embedding response object with .embeddings attribute
        class DummyEmbeddingResponse:
            def __init__(self, embeddings):
                self.embeddings = embeddings

        # Setup dummy return values for chat model call
        async def dummy_chat_response(*args, **kwargs):
            # Return an object with a content attribute (string)
            return DummyChatResponse(content="dummy response")

        # Setup dummy return values for embedding model call
        async def dummy_embedding_response(*args, **kwargs):
            # Return an object with embeddings attribute as list of list of floats
            return DummyEmbeddingResponse(embeddings=[[0.1, 0.2, 0.3]])

        self.mock_chat_call.side_effect = dummy_chat_response
        self.mock_embed_call.side_effect = dummy_embedding_response

    def tearDown(self):
        self.chat_patcher.stop()
        self.embed_patcher.stop()

    def test_record_and_retrieve(self):
        long_term_memory = Mem0LongTermMemory(
            agent_name="Friday",
            user_name="user_123",
            model=OllamaChatModel(
                "qwen3:0.6b",
                True,
                host="http://host.docker.internal:11434",
            ),
            embedding_model=OllamaTextEmbedding(
                "qwen3-embedding:0.6b",
                1024,
                host="http://host.docker.internal:11434",
            ),
            on_disk=False,
        )

        async def test_async():
            # Record a message
            await long_term_memory.record([Msg(name="user", content="我喜欢住民宿", role="user")])
            # Retrieve based on a query message
            retrieve_result = await long_term_memory.retrieve([Msg(name="user", content="我的住宿偏好", role="user")])
            return retrieve_result

        # Run the async test and get result
        result = asyncio.run(test_async())

        # Assert the result is not None and is a list (Mem0LongTermMemory returns list of messages)
        self.assertIsNotNone(result)
        self.assertIsInstance(result, list)
        # Assert that the mocked chat model was called at least once
        self.assertTrue(self.mock_chat_call.called)
        # Assert that the mocked embedding model was called at least once
        self.assertTrue(self.mock_embed_call.called)
        # Assert that the content of the first retrieved message is a string (dummy response)
        if len(result) > 0:
            self.assertIsInstance(result[0].content, str)


