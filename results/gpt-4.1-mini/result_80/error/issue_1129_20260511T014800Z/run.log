from agentscope.model.ollama import OllamaChatModel, OllamaTextEmbedding
from agentscope.message import Msg


class TestMem0LongTermMemoryWithOllama(unittest.TestCase):
    def setUp(self):
        # Patch the OllamaChatModel.__call__ and OllamaTextEmbedding.__call__ to avoid real network calls
        self.patcher_chat = patch(
            "agentscope.model.ollama.OllamaChatModel.__call__", new_callable=AsyncMock
        )
        self.patcher_embed = patch(
            "agentscope.model.ollama.OllamaTextEmbedding.__call__", new_callable=AsyncMock
        )
        self.mock_chat_call = self.patcher_chat.start()
        self.mock_embed_call = self.patcher_embed.start()

        # Setup dummy response for chat model call
        class DummyChatResponse:
            def __init__(self):
                self.content = "dummy response"
                self.choices = [self]

        self.mock_chat_call.return_value = DummyChatResponse()

        # Setup dummy response for embedding model call
        class DummyEmbeddingResponse:
            def __init__(self):
                self.embeddings = [[0.1, 0.2, 0.3]]

        self.mock_embed_call.return_value = DummyEmbeddingResponse()

    def tearDown(self):
        self.patcher_chat.stop()
        self.patcher_embed.stop()

    def test_record_and_retrieve_no_exception(self):
        long_term_memory = Mem0LongTermMemory(
            agent_name="Friday",
            user_name="user_123",
            model=OllamaChatModel(
                "qwen3:0.6b",
                True,
                host="http://host.docker.internal:11434",
            ),
            embedding_model=OllamaTextEmbedding(
                "qwen3-embedding:0.6b",
                1024,
                host="http://host.docker.internal:11434",
            ),
            on_disk=False,
        )

        async def test():
            # Record a message
            await long_term_memory.record([Msg(name="user", content="我喜欢住民宿", role="user")])
            # Retrieve with a query message
            retrieve_result = await long_term_memory.retrieve([Msg(name="user", content="我的住宿偏好", role="user")])
            return retrieve_result

        # Run the async test and assert no exceptions and result is not None
        result = asyncio.run(test())
        self.assertIsNotNone(result)
        # The dummy response content should be in the result text (depending on Mem0LongTermMemory implementation)
        # We check that the result is a non-empty string or list (depending on implementation)
        self.assertTrue(result)


if __name__ == "__main__":
    unittest.main()[0m
