from agentscope.model.ollama import OllamaChatModel, OllamaTextEmbedding


class TestMem0LongTermMemoryOllama(unittest.TestCase):
    def setUp(self):
        # Patch the OllamaChatModel.__call__ to simulate a valid response
        self.chatmodel_patcher = patch(
            "agentscope.model.ollama.OllamaChatModel.__call__", new_callable=AsyncMock
        )
        self.mock_chat_call = self.chatmodel_patcher.start()

        # Patch the OllamaTextEmbedding.__call__ to simulate a valid embedding response
        self.embedding_patcher = patch(
            "agentscope.model.ollama.OllamaTextEmbedding.__call__", new_callable=AsyncMock
        )
        self.mock_embedding_call = self.embedding_patcher.start()

        # Setup dummy responses for chat and embedding calls
        async def dummy_chat_response(*args, **kwargs):
            class DummyResponse:
                content = "dummy response content"
            return DummyResponse()

        async def dummy_embedding_response(*args, **kwargs):
            class DummyEmbedding:
                embeddings = [[0.1, 0.2, 0.3]]
            return DummyEmbedding()

        self.mock_chat_call.side_effect = dummy_chat_response
        self.mock_embedding_call.side_effect = dummy_embedding_response

    def tearDown(self):
        self.chatmodel_patcher.stop()
        self.embedding_patcher.stop()

    def test_record_and_retrieve(self):
        # Create Mem0LongTermMemory instance with Ollama models
        long_term_memory = Mem0LongTermMemory(
            agent_name="Friday",
            user_name="user_123",
            model=OllamaChatModel(
                "qwen3:0.6b",
                True,
                host="http://host.docker.internal:11434",
            ),
            embedding_model=OllamaTextEmbedding(
                "qwen3-embedding:0.6b",
                1024,
                host="http://host.docker.internal:11434",
            ),
            on_disk=False,
        )

        async def test_async():
            # Record a message
            await long_term_memory.record([Msg(name="user", content="我喜欢住民宿", role="user")])
            # Retrieve based on a query message
            result = await long_term_memory.retrieve([Msg(name="user", content="我的住宿偏好", role="user")])
            return result

        # Run the async test function using _run_async to simulate real usage environment
        result = _run_async(test_async())

        # Assert that result is not None and contains expected dummy response content
        self.assertIsNotNone(result)
        # Because dummy_chat_response returns DummyResponse with content attribute
        # The retrieve method should return something containing that content
        # We check the type or content to ensure no exception and proper flow
        self.assertTrue(hasattr(result, "content") or isinstance(result, str) or isinstance(result, list))


