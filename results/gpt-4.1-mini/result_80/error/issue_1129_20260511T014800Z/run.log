from agentscope.message import Msg
from agentscope.model.ollama import OllamaChatModel, OllamaTextEmbedding


class TestMem0LongTermMemoryOllama(unittest.TestCase):
    def setUp(self):
        # Patch the OllamaChatModel and OllamaTextEmbedding __call__ methods to simulate responses
        patcher_chat = patch.object(OllamaChatModel, "__call__", new_callable=AsyncMock)
        patcher_embed = patch.object(OllamaTextEmbedding, "__call__", new_callable=AsyncMock)
        self.mock_chat_call = patcher_chat.start()
        self.mock_embed_call = patcher_embed.start()
        self.addCleanup(patcher_chat.stop)
        self.addCleanup(patcher_embed.stop)

        # Simulate chat model response with an object having .content attribute (not async_generator)
        class DummyResponse:
            def __init__(self, content):
                self.content = content

        async def dummy_chat_response(*args, **kwargs):
            return DummyResponse("dummy chat response")

        async def dummy_embed_response(*args, **kwargs):
            class DummyEmbedding:
                embeddings = [[0.1, 0.2, 0.3]]
            return DummyEmbedding()

        self.mock_chat_call.side_effect = dummy_chat_response
        self.mock_embed_call.side_effect = dummy_embed_response

    def test_record_and_retrieve(self):
        long_term_memory = Mem0LongTermMemory(
            agent_name="Friday",
            user_name="user_123",
            model=OllamaChatModel(
                "qwen3:0.6b",
                True,
                host="http://host.docker.internal:11434",
            ),
            embedding_model=OllamaTextEmbedding(
                "qwen3-embedding:0.6b",
                1024,
                host="http://host.docker.internal:11434",
            ),
            on_disk=False,
        )

        async def test_async():
            # Record a message
            await long_term_memory.record([Msg(name="user", content="我喜欢住民宿", role="user")])
            # Retrieve related messages
            result = await long_term_memory.retrieve([Msg(name="user", content="我的住宿偏好", role="user")])
            return result

        # Run the async test function using the _run_async helper to simulate real usage context
        result = _run_async(test_async())

        # The result should be a list (or iterable) of messages or similar, not None or exception
        self.assertIsNotNone(result)
        # We expect the mocked chat model to have been called at least once
        self.assertTrue(self.mock_chat_call.called)
        # The result is expected to be iterable (list or similar)
        self.assertTrue(hasattr(result, "__iter__"))


