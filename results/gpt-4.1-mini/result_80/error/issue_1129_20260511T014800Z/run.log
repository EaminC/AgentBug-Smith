            user_name="user_123",
            model=OllamaChatModel(
                "qwen3:0.6b",
                True,
                host="http://host.docker.internal:11434",
            ),
            embedding_model=OllamaTextEmbedding(
                "qwen3-embedding:0.6b",
                1024,
                host="http://host.docker.internal:11434",
            ),
            on_disk=False,
        )

        async def test():
            # Record a message
            await long_term_memory.record([Msg(name="user", content="我喜欢住民宿", role="user")])
            # Retrieve with a query message
            retrieve_result = await long_term_memory.retrieve([Msg(name="user", content="我的住宿偏好", role="user")])
            return retrieve_result

        # Run the async test and get result
        result = asyncio.run(test())

        # Assert the result is not None and is a list (expected retrieval result)
        self.assertIsNotNone(result)
        self.assertIsInstance(result, list)
        # The content of the first retrieved message should be the dummy response content
        self.assertTrue(any("dummy response content" in str(r) for r in result))


if __name__ == "__main__":
