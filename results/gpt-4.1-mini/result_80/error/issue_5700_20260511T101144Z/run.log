[32mfrom dataclasses import dataclass
from typing_extensions import TypedDict

from langgraph.graph.state import StateGraph
from langgraph.runtime import Runtime


@dataclass
class Context:
    username: str


class State(TypedDict):
    foo: str


def test_runtime_context_propagation_to_subgraph() -> None:
    # Subgraph node that uses runtime context
    def subgraph_node_1(state: State, runtime: Runtime[Context]) -> dict[str, str]:
        # Should have runtime.context set properly
        return {"foo": "hi! " + runtime.context.username}

    subgraph_builder = StateGraph(State, context_schema=Context)
    subgraph_builder.add_node(subgraph_node_1)
    subgraph_builder.set_entry_point("subgraph_node_1")
    subgraph = subgraph_builder.compile()

    # Parent graph node that uses runtime context
    def main_node(state: State, runtime: Runtime[Context]) -> dict[str, str]:
        return {"foo": "hello " + runtime.context.username}

    builder = StateGraph(State, context_schema=Context)
    builder.add_node(main_node)
    builder.add_node("node_1", subgraph)
    builder.set_entry_point("main_node")
    builder.add_edge("main_node", "node_1")
    graph = builder.compile()

    context = Context(username="Alice")
    result = graph.invoke({"foo": "world"}, context=context)

    # Both main node and subgraph node should have access to runtime.context.username
    # The subgraph node returns {'foo': 'hi! Alice'}
    # The main node returns {'foo': 'hello Alice'}
    # The final result merges these, so 'foo' key should be from subgraph node (last node)
    # But to be safe, check that the subgraph node executed and had correct context
    assert isinstance(result, dict)
    # The subgraph node's output should be present and correct
    assert result.get("foo") == "hi! Alice" or result.get("foo") == "hello Alice"
    # The runtime context username must be accessible without error (no AttributeError)
    # So if we got here, test passes for context propagation


# This test is designed to fail on the buggy codebase where runtime.context is None in subgraph nodes,
# causing AttributeError. After the fix, this test should pass.[0m
