    ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

COPY . .

# Upgrade pip, setuptools, wheel
# Install system dependencies for PostgreSQL and SQLite libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    sqlite3 \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
# If requirements.txt exists in libs/langgraph, install it
# Also install psycopg[binary], aiosqlite, dataclasses_json, mkdocs, nbformat, beautifulsoup4 to fix import errors from the tests
# Install the library itself editable
# Install standard Python test dependencies
RUN python -m pip install --upgrade pip setuptools wheel && \
    if [ -f "libs/langgraph/requirements.txt" ]; then pip install -r libs/langgraph/requirements.txt; fi && \
    pip install psycopg[binary] aiosqlite dataclasses_json mkdocs nbformat beautifulsoup4 && \
    pip install -e libs/langgraph && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm && \
    python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]
