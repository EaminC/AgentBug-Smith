    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    FORGE_API_KEY=forge-key

WORKDIR /app

# Install system dependencies needed to build Python packages and run common libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libsqlite3-dev \
    sqlite3 \
    git \
    curl \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
  && rm -rf /var/lib/apt/lists/*

# Copy entire repository into the container
COPY . .

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies and project in one combined step with test dependencies
# Also install missing dependencies highlighted in errors: nbconvert, psycopg_pool, numpy, etc.
RUN if [ -f requirements.txt ]; then \
      pip install -r requirements.txt && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm nbconvert psycopg_pool numpy bs4 mkdocs nbformat psycopg[binary] dataclasses-json aiosqlite langchain-core && \
      pip install -e . ; \
    elif [ -f pyproject.toml ] && [ -f poetry.lock ]; then \
      pip install poetry && \
      poetry config virtualenvs.create false && \
      poetry install --no-interaction --no-ansi && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm nbconvert psycopg_pool numpy bs4 mkdocs nbformat psycopg[binary] dataclasses-json aiosqlite langchain-core && \
      pip install -e . ; \
    elif [ -f pyproject.toml ]; then \
      pip install -e . && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm nbconvert psycopg_pool numpy bs4 mkdocs nbformat psycopg[binary] dataclasses-json aiosqlite langchain-core ; \
    else \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm nbconvert psycopg_pool numpy bs4 mkdocs nbformat psycopg[binary] dataclasses-json aiosqlite langchain-core ; \
    fi

# Preflight check to verify important Python packages and pytest are installed
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Entrypoint for interactive use and tests
CMD ["/bin/bash"]

