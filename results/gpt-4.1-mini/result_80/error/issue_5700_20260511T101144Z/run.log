[32mfrom dataclasses import dataclass
from typing_extensions import TypedDict

from langgraph.graph.state import StateGraph
from langgraph.runtime import Runtime


@dataclass
class Context:
    username: str


class State(TypedDict):
    foo: str


def test_runtime_context_propagation_to_subgraph() -> None:
    # Subgraph node that expects runtime context to be passed
    def subgraph_node_1(state: State, runtime: Runtime[Context]) -> dict[str, str]:
        # Should have runtime.context.username available
        return {"foo": "hi! " + runtime.context.username}

    subgraph_builder = StateGraph(State, context_schema=Context)
    subgraph_builder.add_node(subgraph_node_1)
    subgraph_builder.set_entry_point("subgraph_node_1")
    subgraph = subgraph_builder.compile()

    # Parent graph node that also expects runtime context
    def main_node(state: State, runtime: Runtime[Context]) -> dict[str, str]:
        return {"foo": "hello " + runtime.context.username}

    builder = StateGraph(State, context_schema=Context)
    builder.add_node(main_node)
    builder.add_node("node_1", subgraph)
    builder.set_entry_point("main_node")
    builder.add_edge("main_node", "node_1")
    graph = builder.compile()

    # Invoke the parent graph with context, expecting context to propagate to subgraph
    context = Context(username="Alice")
    result = graph.invoke({"foo": "world"}, context=context)

    # The subgraph node result should be merged into the final output
    # Because the subgraph returns {'foo': 'hi! Alice'} and main node returns {'foo': 'hello Alice'}
    # The final result should contain both keys merged, but since keys overlap, the last edge's output may override.
    # The exact merging behavior depends on implementation, but at minimum no AttributeError should occur
    # and runtime.context.username should be accessible in both nodes.
    # We assert that the 'foo' key contains the subgraph's expected string.
    assert "hi! Alice" in result["foo"] or "hello Alice" in result["foo"]
    # Also check that runtime context is accessible in main node
    assert "Alice" in result["foo"]


# This test will fail on the buggy codebase because runtime.context is None in subgraph_node_1,
# causing AttributeError: 'NoneType' object has no attribute 'username'.
# After applying the fix, this test should pass with no exceptions.[0m
