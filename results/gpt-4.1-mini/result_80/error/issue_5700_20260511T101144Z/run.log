COPY . .

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install system packages needed to build Python packages and common dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    sqlite3 \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies with robust conditional logic
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    elif [ -f "libs/langgraph/requirements.txt" ]; then \
        pip install -r libs/langgraph/requirements.txt; \
