WORKDIR /app

COPY . .

# Upgrade pip and setuptools
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies for compiling Python packages and required libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    sqlite3 \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies:
# - Install requirements.txt if exists
# - Install missing test dependencies and packages detected from test import errors (bs4, nbformat, psycopg, psycopg_pool, sqlite_vec, numpy)
# - Install the project itself editable
# - Install standard Python test dependencies including pytest, pytest-mock, pytest-asyncio, pytest-cov, anyio, litellm
