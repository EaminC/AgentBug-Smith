# Install system dependencies needed for compiling Python packages and common libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libsqlite3-dev \
    sqlite3 \
    git \
    curl \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
  && rm -rf /var/lib/apt/lists/*

# Copy entire repository into container
COPY . .

# Upgrade pip, setuptools and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install project dependencies and test dependencies with additional packages needed
RUN if [ -f requirements.txt ]; then \
      pip install -r requirements.txt && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm bs4 mkdocs nbformat psycopg[binary] dataclasses-json aiosqlite langchain-core && \
      pip install -e . ; \
    elif [ -f pyproject.toml ] && [ -f poetry.lock ]; then \
      pip install poetry && \
      poetry config virtualenvs.create false && \
      poetry install --no-interaction --no-ansi && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm bs4 mkdocs nbformat psycopg[binary] dataclasses-json aiosqlite langchain-core && \
      pip install -e . ; \
    elif [ -f pyproject.toml ]; then \
      pip install -e . && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm bs4 mkdocs nbformat psycopg[binary] dataclasses-json aiosqlite langchain-core ; \
    else \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm bs4 mkdocs nbformat psycopg[binary] dataclasses-json aiosqlite langchain-core ; \
    fi

# Preflight check to verify important packages are installed
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

