        def count_to_n(n: int) -> Generator[ToolChunk, None, None]:
            """Count from 1 to n.

            Args:
                n: The number to count to
            """
            for i in range(1, n + 1):
                yield ToolChunk(
                    content=[TextBlock(text=str(i))],
