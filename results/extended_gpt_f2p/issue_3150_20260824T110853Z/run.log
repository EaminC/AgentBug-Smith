[32mimport pytest
import strands
from strands import Agent
from strands._middleware.stages import AgentStreamContext, ExecuteToolStage, MiddlewareInterruptResult
from strands.interrupt import Interrupt, InterruptException
from strands.types._events import ToolResultEvent
from strands.hooks import AfterToolCallEvent, BeforeToolCallEvent


@pytest.fixture
def dummy_tool():
    @strands.tool(name="dummy_tool")
    def tool_func(input_text: str) -> str:
        return f"Processed: {input_text}"

    return tool_func


@pytest.fixture
def dummy_model_provider():
    # A simple mocked model provider that returns a toolUse message followed by a final text message
    from tests.fixtures.mocked_model_provider import MockedModelProvider

    tool_use_msg = {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": "tool_1", "name": "dummy_tool", "input": {"input_text": "test"}}}],
    }
    final_msg = {"role": "assistant", "content": [{"text": "done"}]}
    return MockedModelProvider([tool_use_msg, final_msg])


@pytest.fixture
def agent(dummy_model_provider, dummy_tool):
    return Agent(model=dummy_model_provider, tools=[dummy_tool], callback_handler=None)


def test_agent_stream_context_interrupt_raises_and_resumes():
    """Test that AgentStreamContext.interrupt raises InterruptException on first call and returns response on resume."""
    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    # Interrupt ID should be stable and start with the expected prefix
    interrupt_id_1 = ctx._interrupt_id("test_interrupt")
    interrupt_id_2 = ctx._interrupt_id("test_interrupt")
    assert interrupt_id_1 == interrupt_id_2
    assert interrupt_id_1.startswith("v1:middleware_agent_stream:")

    # On first call, interrupt should raise InterruptException
    with pytest.raises(InterruptException):
        ctx.interrupt("test_interrupt", reason="testing")

    # On resume with a stored interrupt with response, interrupt returns MiddlewareInterruptResult with that response
    stored_interrupt = Interrupt(id=interrupt_id_1, name="test_interrupt", response="approved")
    resumed_ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={interrupt_id_1: stored_interrupt})
    result = resumed_ctx.interrupt("test_interrupt", reason="testing")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "approved"


def test_execute_tool_context_interrupt_behavior(agent, dummy_tool):
    """Test ExecuteToolContext.interrupt behavior: raises on first call, returns response on resume, respects preemptive response."""

    # Middleware that interrupts immediately
    async def interrupting_middleware(context, next_fn):
        context.interrupt("gate", reason="approval needed")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, interrupting_middleware)

    # First call should result in interrupt stop_reason
    result = agent("test input")
    assert result.stop_reason == "interrupt"
    assert len(result.interrupts) == 1
    assert result.interrupts[0].name == "gate"

    # Resume with response should return MiddlewareInterruptResult with that response
    response = "approved"
    result2 = agent([{"interruptResponse": {"interruptId": result.interrupts[0].id, "response": response}}])
    # The middleware interrupt returns MiddlewareInterruptResult with the response
    # We test that the middleware received the response by checking that the interrupt no longer stops
    assert result2.stop_reason != "interrupt"


def test_execute_tool_context_interrupt_preemptive_response_skips_interrupt(agent):
    """Providing a preemptive response to interrupt() skips raising InterruptException and continues."""

    skipped = False

    async def preemptive_middleware(context, next_fn):
        nonlocal skipped
        interrupt_result = context.interrupt("gate", reason="check", response="pre-approved")
        skipped = interrupt_result.response == "pre-approved"
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, preemptive_middleware)

    result = agent("test input")
    assert result.stop_reason == "end_turn"
    assert skipped


def test_execute_tool_context_interrupt_short_circuits_tool_execution(agent):
    """Middleware interrupt short-circuits tool execution; tool is not executed."""

    tool_executed = False

    @strands.tool(name="tracked_tool")
    def tracked_tool() -> str:
        nonlocal tool_executed
        tool_executed = True
        return "done"

    # Replace agent's tools with tracked_tool
    agent._tools = [tracked_tool]

    # Middleware that interrupts immediately
    async def interrupting_middleware(context, next_fn):
        context.interrupt("block", reason="blocked")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, interrupting_middleware)

    result = agent("run tracked_tool")
    assert result.stop_reason == "interrupt"
    assert not tool_executed


def test_agent_stream_context_interrupt_precedence():
    """Test that stored human response takes precedence over preemptive response in _resolve_middleware_interrupt."""
    from strands._middleware.stages import _resolve_middleware_interrupt

    interrupt_id = "v1:middleware_execute_tool:tool_1:test_gate"
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="test_gate", response="human_response")}

    # Even if a preemptive response is given, stored human response is returned
    result = _resolve_middleware_interrupt(interrupts, interrupt_id, "test_gate", None, "preemptive_response")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "human_response"


def test_agent_stream_context_interrupt_id_uniqueness():
    """AgentStreamContext interrupt IDs are stable and unique per name."""
    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})
    id1 = ctx._interrupt_id("gate1")
    id2 = ctx._interrupt_id("gate2")
    id3 = ctx._interrupt_id("gate1")
    assert id1 != id2
    assert id1 == id3
    assert id1.startswith("v1:middleware_agent_stream:")


def test_execute_tool_context_replace_preserves_interrupt(agent):
    """Replacing ExecuteToolContext with dataclasses.replace preserves interrupt functionality."""

    from dataclasses import replace

    interrupt_triggered = False

    async def middleware(context, next_fn):
        nonlocal interrupt_triggered
        new_context = replace(context, tool_use={**context.tool_use, "input": {"expression": "3+3"}})
        # interrupt() must still work on the replaced context
        new_context.interrupt("gate", reason="check")
        interrupt_triggered = True
        async for event in next_fn(new_context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, middleware)

    result = agent("calc")
    # First call interrupts, so interrupt_triggered is False
    assert result.stop_reason == "interrupt"
    assert not interrupt_triggered

    # Resume with response to allow middleware to run and set interrupt_triggered True
    result2 = agent([{"interruptResponse": {"interruptId": result.interrupts[0].id, "response": "yes"}}])
    assert interrupt_triggered


