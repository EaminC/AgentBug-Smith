    return Agent(model=model, tools=[calculator_tool], callback_handler=None)


def test_agent_stream_stage_interrupt_halts_agent(agent):
    """AgentStreamStage interrupt halts the agent execution with InterruptException."""

    async def interrupting_middleware(context: AgentStreamContext, next_fn):
        context.interrupt("agent_stream_gate", reason="Halt here")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(AgentStreamStage, interrupting_middleware)
    result = agent("what is 2+2?")

    assert result.stop_reason == "interrupt"
    assert len(result.interrupts) == 1
    assert result.interrupts[0].name == "agent_stream_gate"
    assert result.interrupts[0].reason == "Halt here"


def test_agent_stream_stage_interrupt_resume_returns_response(agent):
    """AgentStreamStage interrupt resumes with provided response."""

    final_msg = {"role": "assistant", "content": [{"text": "The answer is 4."}]}
    from tests.fixtures.mocked_model_provider import MockedModelProvider

    tool_use_msg = {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": "tool_1", "name": "calculator", "input": {"expression": "2+2"}}}],
    }
    model = MockedModelProvider([tool_use_msg, final_msg, final_msg])
    agent = Agent(model=model, tools=[agent.tools[0]], callback_handler=None)

    received_response = None

    async def interrupting_middleware(context: AgentStreamContext, next_fn):
        nonlocal received_response
        interrupt_result = context.interrupt("agent_stream_gate", reason="Confirm?")
        received_response = interrupt_result.response
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(AgentStreamStage, interrupting_middleware)

    result = agent("what is 2+2?")
    assert result.stop_reason == "interrupt"

    # Resume with response
    result = agent([{"interruptResponse": {"interruptId": result.interrupts[0].id, "response": "yes"}}])
    assert received_response == "yes"


def test_agent_stream_stage_interrupt_preemptive_response_skips_interrupt(agent):
    """Providing a preemptive response skips the interrupt entirely in AgentStreamStage."""

    skipped_interrupt = False

    async def interrupting_middleware(context: AgentStreamContext, next_fn):
        nonlocal skipped_interrupt
        interrupt_result = context.interrupt("agent_stream_gate", reason="Check", response="pre-approved")
        skipped_interrupt = interrupt_result.response == "pre-approved"
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(AgentStreamStage, interrupting_middleware)
    result = agent("what is 2+2?")

    assert result.stop_reason == "end_turn"
    assert skipped_interrupt


def test_execute_tool_stage_interrupt_short_circuits_tool_execution():
    """Middleware interrupt in ExecuteToolStage short-circuits tool execution."""

    tool_executed = False

    @strands.tool(name="tracked_tool")
    def tracked_tool() -> str:
        nonlocal tool_executed
        tool_executed = True
        return "done"

    from tests.fixtures.mocked_model_provider import MockedModelProvider

    tool_use_msg = {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": "t1", "name": "tracked_tool", "input": {}}}],
    }
    final_msg = {"role": "assistant", "content": [{"text": "ok"}]}
    model = MockedModelProvider([tool_use_msg, final_msg])
    agent = Agent(model=model, tools=[tracked_tool], callback_handler=None)

    async def blocker(context, next_fn):
        context.interrupt("block", reason="nope")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, blocker)
    result = agent("do it")

    assert result.stop_reason == "interrupt"
    assert not tool_executed


