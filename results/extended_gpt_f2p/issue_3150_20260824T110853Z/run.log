import strands
from strands import Agent
from strands._middleware.stages import ExecuteToolStage, AgentStreamContext, MiddlewareInterruptResult
from strands.interrupt import InterruptException
from strands.types._events import ToolResultEvent
from tests.fixtures.mocked_model_provider import MockedModelProvider


@pytest.fixture
def dummy_tool():
    @strands.tool(name="dummy")
    def dummy(expression: str) -> str:
        return f"Result: {expression}"

    return dummy


def _make_tool_use_model():
    tool_use_msg = {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": "tool_1", "name": "dummy", "input": {"expression": "1+1"}}}],
    }
    final_msg = {"role": "assistant", "content": [{"text": "done"}]}
    return MockedModelProvider([tool_use_msg, final_msg])


@pytest.fixture
def agent(dummy_tool):
    model = _make_tool_use_model()
    return Agent(model=model, tools=[dummy_tool], callback_handler=None)


@pytest.mark.asyncio
async def test_execute_tool_stage_interrupt_halts(agent):
    """Middleware interrupt on ExecuteToolStage halts execution and raises InterruptException."""

    async def interrupting_middleware(context, next_fn):
        context.interrupt("test_interrupt", reason="testing interrupt")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, interrupting_middleware)

    result = agent("run dummy")
    assert result.stop_reason == "interrupt"
    assert len(result.interrupts) == 1
    assert result.interrupts[0].name == "test_interrupt"


@pytest.mark.asyncio
async def test_execute_tool_stage_interrupt_resume(agent):
    """After interrupt, providing a response resumes execution and returns it."""

    responses = [
        {"role": "assistant", "content": [{"text": "done"}]},
        {"role": "assistant", "content": [{"text": "done"}]},
    ]
    model = MockedModelProvider([
        {
            "role": "assistant",
            "content": [{"toolUse": {"toolUseId": "tool_1", "name": "dummy", "input": {"expression": "1+1"}}}],
        },
        *responses,
    ])
    agent = Agent(model=model, tools=agent._tools, callback_handler=None)

    received_response = None

    async def interrupting_middleware(context, next_fn):
        nonlocal received_response
        interrupt_result = context.interrupt("test_interrupt", reason="testing interrupt")
        received_response = interrupt_result.response
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, interrupting_middleware)

    # First call triggers interrupt
    result = agent("run dummy")
    assert result.stop_reason == "interrupt"

    # Resume with response
    response = "approved"
    result = agent([{"interruptResponse": {"interruptId": result.interrupts[0].id, "response": response}}])
    assert received_response == response


def test_resolve_middleware_interrupt_precedence():
    """Stored human response takes precedence over preemptive response."""

    from strands._middleware.stages import _resolve_middleware_interrupt
    from strands.interrupt import Interrupt

    interrupt_id = "v1:middleware_execute_tool:tool_1:test_gate"
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="test_gate", response="human_response")}

    result = _resolve_middleware_interrupt(interrupts, interrupt_id, "test_gate", None, "preemptive_response")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "human_response"


def test_agent_stream_context_interrupt_behavior():
    """AgentStreamContext interrupt raises InterruptException and returns response on resume."""

    from strands._middleware.stages import AgentStreamContext
    from strands.interrupt import InterruptException

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    # Interrupt raises
    with pytest.raises(InterruptException):
        ctx.interrupt("gate")

    # Interrupt returns response if present
    interrupt_id = ctx._interrupt_id("gate")
    resumed_ctx = AgentStreamContext(
        agent=None,
        messages=[],
        invocation_state={},
        _interrupts={interrupt_id: strands.interrupt.Interrupt(id=interrupt_id, name="gate", response="ok")},
    )
    result = resumed_ctx.interrupt("gate")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "ok"


