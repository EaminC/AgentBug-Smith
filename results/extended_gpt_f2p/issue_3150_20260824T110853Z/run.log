[32mimport pytest

import strands
from strands import Agent
from strands._middleware.stages import AgentStreamContext, ExecuteToolStage, MiddlewareInterruptResult
from strands.interrupt import Interrupt, InterruptException


@pytest.fixture
def dummy_agent():
    # A minimal agent with a dummy model that yields a fixed response
    class DummyModel:
        def __call__(self, prompt):
            return strands.types._events.ToolResultEvent(
                {
                    "toolUseId": "tool_1",
                    "status": "success",
                    "content": [{"text": "dummy response"}],
                }
            )

        async def stream(self, prompt):
            yield strands.types._events.ToolResultEvent(
                {
                    "toolUseId": "tool_1",
                    "status": "success",
                    "content": [{"text": "dummy response"}],
                }
            )

    return Agent(model=DummyModel(), tools=[], callback_handler=None)


def test_execute_tool_context_interrupt_behavior(dummy_agent):
    # Test that ExecuteToolContext.interrupt raises InterruptException on first call and returns response on resume

    async def middleware(context, next_fn):
        # First call: interrupt without response should raise
        context.interrupt("test_interrupt", reason="testing interrupt")

        # Should not reach here if interrupt raised
        async for event in next_fn(context):
            yield event

    dummy_agent._middleware_registry.add_middleware(ExecuteToolStage, middleware)

    # First call triggers interrupt, expect stop_reason interrupt and one interrupt registered
    result = dummy_agent("test")
    assert result.stop_reason == "interrupt"
    assert len(result.interrupts) == 1
    assert result.interrupts[0].name == "test_interrupt"
    assert result.interrupts[0].reason == "testing interrupt"

    # Resume with a response, interrupt() should return MiddlewareInterruptResult with that response
    response = "approved"
    result2 = dummy_agent([{"interruptResponse": {"interruptId": result.interrupts[0].id, "response": response}}])
    # The middleware should have resumed and returned the response wrapped in MiddlewareInterruptResult
    # We cannot directly access the middleware context here, but we can check that no interrupt now occurs
    assert result2.stop_reason != "interrupt"


def test_agent_stream_context_interrupt_behavior():
    # Test AgentStreamContext interrupt raises and returns response correctly

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    # Interrupt id should be stable and namespaced
    id1 = ctx._interrupt_id("gate")
    id2 = ctx._interrupt_id("gate")
    assert id1 == id2
    assert id1.startswith("v1:middleware_agent_stream:")

    # Interrupt without response should raise InterruptException
    with pytest.raises(InterruptException):
        ctx.interrupt("gate", reason="reason")

    # Interrupt with preemptive response returns MiddlewareInterruptResult
    ctx2 = AgentStreamContext(
        agent=None,
        messages=[],
        invocation_state={},
        _interrupts={id1: Interrupt(id=id1, name="gate", response="ok")},
    )
    result = ctx2.interrupt("gate")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "ok"


def test_resolve_middleware_interrupt_precedence():
    # Test that stored human response takes precedence over preemptive response in _resolve_middleware_interrupt

    from strands._middleware.stages import _resolve_middleware_interrupt

    interrupt_id = "v1:middleware_execute_tool:tool_1:test-gate"
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="gate", response="DENIED")}

    result = _resolve_middleware_interrupt(interrupts, interrupt_id, "gate", None, "auto-approve")

    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "DENIED"


def test_execute_tool_context_interrupt_with_preemptive_response(dummy_agent):
    # Test that providing a preemptive response skips raising InterruptException

    async def middleware(context, next_fn):
        result = context.interrupt("preemptive_gate", reason="reason", response="pre-approved")
        assert isinstance(result, MiddlewareInterruptResult)
        assert result.response == "pre-approved"
        async for event in next_fn(context):
            yield event

    dummy_agent._middleware_registry.add_middleware(ExecuteToolStage, middleware)

    result = dummy_agent("test preemptive")
    # The result should not be an interrupt stop because interrupt was preemptively approved
    assert result.stop_reason != "interrupt"


def test_agent_stream_context_interrupt_with_preemptive_response():
    # Test AgentStreamContext interrupt with preemptive response returns without raising

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    result = ctx.interrupt("gate", reason="reason", response="pre-approved")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "pre-approved"[0m
