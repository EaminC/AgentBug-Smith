[32mimport pytest
import strands
from strands import Agent
from strands._middleware.stages import AgentStreamContext, ExecuteToolStage, MiddlewareInterruptResult
from strands.interrupt import Interrupt, InterruptException


@pytest.fixture
def dummy_agent():
    # A minimal agent with a dummy model that yields a fixed response
    class DummyModel:
        def __init__(self):
            self.calls = 0

        def __call__(self, prompt):
            self.calls += 1
            if isinstance(prompt, list):
                # Resume with interruptResponse
                return {"stop_reason": "end_turn", "content": "resumed"}
            # Initial call returns a toolUse message to trigger ExecuteToolStage
            return {
                "stop_reason": "end_turn",
                "content": [{"toolUse": {"toolUseId": "tool_1", "name": "dummy_tool", "input": {}}}],
            }

        async def stream(self, prompt):
            yield {"text": "streamed response"}

    @strands.tool(name="dummy_tool")
    def dummy_tool():
        return "tool executed"

    model = DummyModel()
    agent = Agent(model=model, tools=[dummy_tool], callback_handler=None)
    return agent


def test_agent_stream_context_interrupt_raises_and_resumes():
    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})
    interrupt_id = ctx._interrupt_id("test_interrupt")
    # The interrupt ID should be stable and start with the expected prefix
    assert interrupt_id.startswith("v1:middleware_agent_stream:")
    assert interrupt_id == ctx._interrupt_id("test_interrupt")

    # Interrupt without response should raise InterruptException
    with pytest.raises(InterruptException):
        ctx.interrupt("test_interrupt")

    # Interrupt with stored response returns MiddlewareInterruptResult
    resumed_ctx = AgentStreamContext(
        agent=None,
        messages=[],
        invocation_state={},
        _interrupts={interrupt_id: Interrupt(id=interrupt_id, name="test_interrupt", response="ok")},
    )
    result = resumed_ctx.interrupt("test_interrupt")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "ok"


def test_execute_tool_context_interrupt_precedence(dummy_agent):
    # This test verifies that a stored human response takes precedence over preemptive response
    interrupt_id = "v1:middleware_execute_tool:tool_1:test_gate"
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="test_gate", response="HUMAN_RESPONSE")}

    # Use the internal _resolve_middleware_interrupt function indirectly via ExecuteToolContext.interrupt
    from strands._middleware.stages import ExecuteToolContext

    context = ExecuteToolContext(
        agent=dummy_agent,
        tool=dummy_agent.tools[0],
        tool_use={"toolUseId": "tool_1", "name": "dummy_tool", "input": {}},
        invocation_state={},
        _interrupt_state=dummy_agent._interrupt_state,
    )

    # Patch the _interrupt_state interrupts to our test interrupts dict
    context._interrupt_state.interrupts = interrupts

    # Calling interrupt with a preemptive response should still return the stored human response
    result = context.interrupt("test_gate", response="PREEMPTIVE_RESPONSE")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "HUMAN_RESPONSE"


def test_agent_stream_context_interrupt_preemptive_response(dummy_agent):
    # AgentStreamContext.interrupt with preemptive response should return it without raising
    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})
    result = ctx.interrupt("gate", response="pre-approved")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "pre-approved"


def test_agent_stream_context_interrupt_raises_without_response(dummy_agent):
    # AgentStreamContext.interrupt without stored or preemptive response raises InterruptException
    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})
    with pytest.raises(InterruptException):
        ctx.interrupt("gate")


def test_execute_tool_stage_interrupt_halts_tool_execution(dummy_agent):
    # Middleware that interrupts should halt tool execution and cause stop_reason interrupt
    tool_executed = False

    @strands.tool(name="tracked_tool")
    def tracked_tool():
        nonlocal tool_executed
        tool_executed = True
        return "done"

    dummy_agent.tools.append(tracked_tool)

    async def blocker(context, next_fn):
        context.interrupt("block", reason="nope")
        async for event in next_fn(context):
            yield event

    dummy_agent._middleware_registry.add_middleware(ExecuteToolStage, blocker)
    result = dummy_agent("do it")

    assert result.stop_reason == "interrupt"
    assert not tool_executed


def test_agent_stream_stage_interrupt_halts_agent(dummy_agent):
    # Add middleware to AgentStreamStage that interrupts and verify agent halts with interrupt stop_reason
    from strands._middleware.stages import AgentStreamStage

    async def gate(context, next_fn):
        context.interrupt("agent_stream_gate", reason="check")
        async for event in next_fn(context):
            yield event

    dummy_agent._middleware_registry.add_middleware(AgentStreamStage, gate)
    result = dummy_agent("test input")

    assert result.stop_reason == "interrupt"
    assert any(interrupt.name == "agent_stream_gate" for interrupt in result.interrupts)


def test_agent_stream_stage_interrupt_resume(dummy_agent):
    from strands._middleware.stages import AgentStreamStage

    interrupt_name = "agent_stream_gate"

    async def gate(context, next_fn):
        interrupt_result = context.interrupt(interrupt_name, reason="check")
        # The response should be accessible on resume
        assert isinstance(interrupt_result, MiddlewareInterruptResult)
        async for event in next_fn(context):
            yield event

    dummy_agent._middleware_registry.add_middleware(AgentStreamStage, gate)

    # First call triggers interrupt
    result = dummy_agent("test input")
    assert result.stop_reason == "interrupt"
    interrupt_id = result.interrupts[0].id

    # Resume with a response
    resume_input = [{"interruptResponse": {"interruptId": interrupt_id, "response": "approved"}}]
    resumed_result = dummy_agent(resume_input)
    assert resumed_result.stop_reason == "end_turn" or resumed_result.stop_reason == "success"


def test_agent_stream_context_interrupt_id_stability():
    ctx1 = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})
    ctx2 = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    id1 = ctx1._interrupt_id("stable_name")
    id2 = ctx2._interrupt_id("stable_name")

    assert id1 == id2
    assert id1.startswith("v1:middleware_agent_stream:")


