+AgentStreamStage: MiddlewareStage[AgentStreamContext, EventLoopStopEvent, TypedEvent] = MiddlewareStage(
+    name="agentStream"
+)
+"""Built-in stage wrapping the entire agent output stream (outermost interception point).
+
