from strands import Agent
from strands._middleware.stages import AgentStreamStage, AgentStreamContext, MiddlewareInterruptResult
from strands.interrupt import InterruptException
import pytest


def test_agent_stream_stage_interrupt_behavior():
    # Setup a dummy agent with a simple model that yields a fixed response
    # We mock the model by passing a callable that returns a fixed response
    class DummyModel:
        def __call__(self, prompt):
            return "dummy response"

        async def stream(self, prompt):
            yield {"text": "dummy response"}
            # End with a stop event
            yield {"stop_reason": "end_turn"}

    dummy_model = DummyModel()
    agent = Agent(model=dummy_model, tools=[], callback_handler=None)

    # Middleware that interrupts on the agent stream stage
    async def interrupting_middleware(context: AgentStreamContext, next_fn):
        # Interrupt without a preemptive response, should raise InterruptException
        context.interrupt("test_interrupt", reason="testing interrupt")
        async for event in next_fn(context):
            yield event

    # Add the middleware to the AgentStreamStage
    agent._middleware_registry.add_middleware(AgentStreamStage, interrupting_middleware)

    # Run the agent and expect it to raise InterruptException internally and stop with interrupt
    result = agent("hello")

    # The result should indicate an interrupt stop reason
    assert result.stop_reason == "interrupt"
    # There should be at least one interrupt registered
    assert len(result.interrupts) >= 1
    # The interrupt name should be "test_interrupt"
    assert any(interrupt.name == "test_interrupt" for interrupt in result.interrupts)

    # Now simulate resuming the interrupt by providing a response
    interrupt_id = result.interrupts[0].id
    resumed_result = agent([{"interruptResponse": {"interruptId": interrupt_id, "response": "approved"}}])

    # The resumed call should continue without interrupt
    assert resumed_result.stop_reason != "interrupt"

    # Middleware that interrupts with a preemptive response, should not raise
    async def preemptive_middleware(context: AgentStreamContext, next_fn):
        res = context.interrupt("preemptive", reason="auto approve", response="yes")
        assert isinstance(res, MiddlewareInterruptResult)
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(AgentStreamStage, preemptive_middleware)

    # Run the agent again, should not interrupt due to preemptive response
    result2 = agent("hello again")
    assert result2.stop_reason != "interrupt"


def test_agent_stream_context_interrupt_id_stability():
    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})
    id1 = ctx._interrupt_id("gate")
    id2 = ctx._interrupt_id("gate")
    id3 = ctx._interrupt_id("other_gate")
    # IDs for the same name are stable and equal
    assert id1 == id2
    # Different names produce different IDs
    assert id1 != id3
    # IDs start with the expected prefix
    from strands.interrupt import _AGENT_STREAM_INTERRUPT_ID_PREFIX
    assert id1.startswith(_AGENT_STREAM_INTERRUPT_ID_PREFIX)


def test_agent_stream_context_interrupt_resolution():
    from strands.interrupt import Interrupt

    interrupt_id = "v1:middleware_agent_stream:test"
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="test", response="ok")}

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts=interrupts)

    # Should return MiddlewareInterruptResult with stored response
    result = ctx.interrupt("test")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "ok"

    # Interrupt with no stored response and no preemptive response raises InterruptException
    ctx_empty = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})
    with pytest.raises(InterruptException):
        ctx_empty.interrupt("test2")


def test_agent_stream_stage_yields_events_and_interrupt():
    # Setup dummy model that yields events and ends with a stop event
    class DummyModel:
        async def stream(self, prompt):
            yield {"text": "start"}
            yield {"text": "middle"}
            yield {"stop_reason": "end_turn"}

    dummy_model = DummyModel()
    agent = Agent(model=dummy_model, tools=[], callback_handler=None)

    # Middleware that passes through events but interrupts mid-stream
    async def interrupting_middleware(context: AgentStreamContext, next_fn):
        # Interrupt immediately
        context.interrupt("mid_stream", reason="mid stream interrupt")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(AgentStreamStage, interrupting_middleware)

    # Collect events from stream_async
    events = []
    async for event in agent.stream_async("test"):
        events.append(event)

    # There should be at least one event with interrupt info
    interrupt_events = [e for e in events if hasattr(e, "tool_interrupt_event") or "tool_interrupt_event" in e]
    assert len(interrupt_events) >= 1

    # The final event should have stop_reason interrupt
    stop_events = [e for e in events if hasattr(e, "stop_reason") and e.stop_reason == "interrupt"]
    assert len(stop_events) >= 1[0m
