def test_before_hook_fires_after_hook_skipped_on_interrupt(agent, calculator_tool):
    """On a middleware interrupt, BeforeToolCallEvent fires but AfterToolCallEvent does not."""

    hook_provider = MockHookProvider(event_types="all")
    agent._hooks = [hook_provider]

    async def gate(context, next_fn):
        context.interrupt("gate", reason="check")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, gate)
    result = agent("calc")

    assert result.stop_reason == "interrupt"
    _, events = hook_provider.get_events()
    event_types = [type(event) for event in events]
    assert BeforeToolCallEvent in event_types
    assert AfterToolCallEvent not in event_types


# --- Additional test for fail2pass coverage of AgentStreamStage and interrupt path ---


def test_agent_stream_stage_interrupt_raises_and_resumes():
    """Test that AgentStreamStage middleware interrupt raises and resumes correctly."""

    from strands._middleware.stages import AgentStreamContext
    from strands.interrupt import InterruptException

    # Setup dummy agent and data
    dummy_agent = Agent(model=MockedModelProvider([]), tools=[], callback_handler=None)
    messages = [{"role": "user", "content": "hello"}]
    invocation_state = {}

    # Empty interrupts dict means no prior response
    ctx = AgentStreamContext(agent=dummy_agent, messages=messages, invocation_state=invocation_state, _interrupts={})

    # Interrupt id should be stable and namespaced
    interrupt_id1 = ctx._interrupt_id("gate")
    interrupt_id2 = ctx._interrupt_id("gate")
    assert interrupt_id1 == interrupt_id2
    assert interrupt_id1.startswith("v1:middleware_agent_stream:")

    # Interrupt without prior response or preemptive response raises InterruptException
    with pytest.raises(InterruptException):
        ctx.interrupt("gate", reason="need approval")

    # Provide a prior response in interrupts dict
    resumed_ctx = AgentStreamContext(
        agent=dummy_agent,
        messages=messages,
        invocation_state=invocation_state,
        _interrupts={interrupt_id1: Interrupt(id=interrupt_id1, name="gate", response="approved")},
    )
    result = resumed_ctx.interrupt("gate")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "approved"

    # Provide a preemptive response skips raising
    preemptive_result = ctx.interrupt("gate", response="auto-approved")
    assert isinstance(preemptive_result, MiddlewareInterruptResult)
    assert preemptive_result.response == "auto-approved"


