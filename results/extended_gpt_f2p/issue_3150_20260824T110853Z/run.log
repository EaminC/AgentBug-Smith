import strands
from strands import Agent
from strands._middleware.stages import ExecuteToolStage, MiddlewareInterruptResult
from strands.hooks import AfterToolCallEvent, BeforeToolCallEvent
from strands.interrupt import Interrupt
from strands.types._events import ToolInterruptEvent, ToolResultEvent
from tests.fixtures.mock_hook_provider import MockHookProvider
from tests.fixtures.mocked_model_provider import MockedModelProvider


@pytest.fixture
def calculator_tool():
    @strands.tool(name="calculator")
    def func(expression: str) -> str:
        """Evaluate a math expression."""
        return str(eval(expression))

    return func


def _tool_use_model(responses_after_tool):
    """Build a model that calls the calculator once, then replays the given responses."""
    tool_use_msg = {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": "tool_1", "name": "calculator", "input": {"expression": "2+2"}}}],
    }
    return MockedModelProvider([tool_use_msg, *responses_after_tool])


@pytest.fixture
def model():
    return _tool_use_model([{"role": "assistant", "content": [{"text": "The answer is 4."}]}])


@pytest.fixture
def agent(model, calculator_tool):
    return Agent(model=model, tools=[calculator_tool], callback_handler=None)


@pytest.mark.asyncio
async def test_execute_tool_stage_interrupt_resume(agent):
    """After interrupt, providing a response resumes execution and returns it."""

    responses = [
        {"role": "assistant", "content": [{"text": "done"}]},
        {"role": "assistant", "content": [{"text": "done"}]},
    ]
    model = MockedModelProvider([
        {
            "role": "assistant",
            "content": [{"toolUse": {"toolUseId": "tool_1", "name": "calculator", "input": {"expression": "1+1"}}}],
        },
        *responses,
    ])
    agent = Agent(model=model, tools=[agent._tools[0]], callback_handler=None)

    received_response = None

    async def interrupting_middleware(context, next_fn):
        nonlocal received_response
        interrupt_result = context.interrupt("gate", reason="check")
        received_response = interrupt_result.response
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, interrupting_middleware)

    # First call triggers interrupt
    result = agent("calc")
    assert result.stop_reason == "interrupt"

    # Second call resumes with response
    result = agent([{"interruptResponse": {"interruptId": result.interrupts[0].id, "response": "ok"}}])
    assert received_response == "ok"


@pytest.mark.asyncio
async def test_agent_stream_stage_interrupt_halts(monkeypatch):
    """AgentStreamStage middleware interrupt halts the agent output stream."""

    from strands._middleware.stages import AgentStreamStage

    # Setup a dummy agent with no tools and a mocked model provider
    model = MockedModelProvider([{"role": "assistant", "content": [{"text": "hello"}]}])
    agent = Agent(model=model, tools=[], callback_handler=None)

    async def interrupting_middleware(context, next_fn):
        context.interrupt("stream_gate", reason="stream interrupt test")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(AgentStreamStage, interrupting_middleware)

    # The agent call should raise InterruptException internally and result in stop_reason interrupt
    result = agent("hello")
    assert result.stop_reason == "interrupt"


@pytest.mark.asyncio
async def test_agent_stream_stage_interrupt_resume(monkeypatch):
    """AgentStreamStage middleware resumes after interrupt with given response."""

    from strands._middleware.stages import AgentStreamStage

    model = MockedModelProvider([{"role": "assistant", "content": [{"text": "hello"}]}])
    agent = Agent(model=model, tools=[], callback_handler=None)

    received_response = None

    async def interrupting_middleware(context, next_fn):
        nonlocal received_response
        interrupt_result = context.interrupt("stream_gate", reason="stream interrupt test")
        received_response = interrupt_result.response
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(AgentStreamStage, interrupting_middleware)

