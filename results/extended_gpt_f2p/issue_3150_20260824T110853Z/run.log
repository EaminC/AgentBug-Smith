[32mimport pytest
import strands
from strands import Agent
from strands._middleware.stages import (
    ExecuteToolStage,
    MiddlewareInterruptResult,
    _resolve_middleware_interrupt,
)
from strands.interrupt import Interrupt, InterruptException
from strands.types._events import ToolResultEvent
from strands.hooks import AfterToolCallEvent, BeforeToolCallEvent


@pytest.fixture
def calculator_tool():
    @strands.tool(name="calculator")
    def func(expression: str) -> str:
        return str(eval(expression))

    return func


def _tool_use_model(responses_after_tool):
    tool_use_msg = {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": "tool_1", "name": "calculator", "input": {"expression": "2+2"}}}],
    }
    return strands.MockedModelProvider([tool_use_msg, *responses_after_tool])


@pytest.fixture
def model():
    return _tool_use_model([{"role": "assistant", "content": [{"text": "The answer is 4."}]}])


@pytest.fixture
def agent(model, calculator_tool):
    return Agent(model=model, tools=[calculator_tool], callback_handler=None)


def test_execute_tool_context_interrupt_precedence(calculator_tool):
    """Stored human response takes precedence over preemptive response in _resolve_middleware_interrupt."""
    interrupt_id = "v1:middleware_execute_tool:tool_1:test-gate"
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="gate", response="DENIED")}

    result = _resolve_middleware_interrupt(interrupts, interrupt_id, "gate", None, "auto-approve")

    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "DENIED"


def test_execute_tool_context_interrupt_raises_without_response(calculator_tool):
    """interrupt() raises InterruptException when no response or preemptive response is provided."""
    final_msg = {"role": "assistant", "content": [{"text": "4"}]}
    model = _tool_use_model([final_msg, final_msg])
    agent = Agent(model=model, tools=[calculator_tool], callback_handler=None)

    async def gate(context, next_fn):
        with pytest.raises(InterruptException):
            context.interrupt("gate", reason="check")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, gate)
    result = agent("calc")
    assert result.stop_reason == "interrupt"


def test_execute_tool_context_interrupt_with_preemptive_response(calculator_tool):
    """interrupt() returns preemptive response without raising InterruptException."""
    final_msg = {"role": "assistant", "content": [{"text": "4"}]}
    model = _tool_use_model([final_msg, final_msg])
    agent = Agent(model=model, tools=[calculator_tool], callback_handler=None)

    preemptive_response = "pre-approved"

    async def gate(context, next_fn):
        res = context.interrupt("gate", reason="check", response=preemptive_response)
        assert isinstance(res, MiddlewareInterruptResult)
        assert res.response == preemptive_response
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, gate)
    result = agent("calc")
    assert result.stop_reason == "end_turn"


def test_execute_tool_context_interrupt_id_stability(calculator_tool):
    """interrupt IDs are deterministic and namespaced by tool use ID."""
    final_msg = {"role": "assistant", "content": [{"text": "4"}]}
    model = _tool_use_model([final_msg, final_msg])
    agent = Agent(model=model, tools=[calculator_tool], callback_handler=None)

    ids = set()

    async def gate(context, next_fn):
        interrupt_id = context._interrupt_id("my_gate")
        ids.add(interrupt_id)
        res = context.interrupt("my_gate", reason="check", response="yes")
        assert isinstance(res, MiddlewareInterruptResult)
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, gate)
    result = agent("calc")
    assert len(ids) == 1
    assert result.stop_reason == "end_turn"


def test_execute_tool_stage_interrupt_halts_tool_execution():
    """Middleware interrupt short-circuits tool execution."""
    tool_executed = False

    @strands.tool(name="tracked_tool")
    def tracked_tool() -> str:
        nonlocal tool_executed
        tool_executed = True
        return "done"

    tool_use_msg = {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": "t1", "name": "tracked_tool", "input": {}}}],
    }
    final_msg = {"role": "assistant", "content": [{"text": "ok"}]}
    model = strands.MockedModelProvider([tool_use_msg, final_msg])
    agent = Agent(model=model, tools=[tracked_tool], callback_handler=None)

    async def blocker(context, next_fn):
        context.interrupt("block", reason="nope")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, blocker)
    result = agent("do it")

    assert result.stop_reason == "interrupt"
    assert not tool_executed


def test_agent_stream_stage_interrupt_halts_agent(calculator_tool):
    """AgentStreamStage interrupt halts the agent invocation."""

    model = _tool_use_model([{"role": "assistant", "content": [{"text": "4"}]}])
    agent = Agent(model=model, tools=[calculator_tool], callback_handler=None)

    async def gate(context, next_fn):
        context.interrupt("gate", reason="check")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware("agentStream", gate)
    result = agent("calc")

    assert result.stop_reason == "interrupt"
    assert len(result.interrupts) == 1
    assert result.interrupts[0].name == "gate"


def test_agent_stream_stage_interrupt_resume(calculator_tool):
    """AgentStreamStage interrupt resumes with provided response."""

    model = _tool_use_model([{"role": "assistant", "content": [{"text": "4"}]}])
    agent = Agent(model=model, tools=[calculator_tool], callback_handler=None)

    interrupt_id = None

    async def gate(context, next_fn):
        nonlocal interrupt_id
        try:
            context.interrupt("gate", reason="check")
        except InterruptException as e:
            interrupt_id = e.interrupt.id
            raise
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware("agentStream", gate)
    result = agent("calc")
    assert result.stop_reason == "interrupt"
    assert interrupt_id is not None

    # Resume with response
    result2 = agent([{"interruptResponse": {"interruptId": interrupt_id, "response": "yes"}}])
    assert result2.stop_reason == "end_turn"


