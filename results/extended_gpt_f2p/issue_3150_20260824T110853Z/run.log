import pytest

import strands
from strands import Agent
from strands._middleware.stages import AgentStreamStage, ExecuteToolStage, MiddlewareInterruptResult
from strands.interrupt import InterruptException
from strands.types._events import EventLoopStopEvent


@pytest.fixture
def dummy_model():
    # A dummy model that yields a fixed sequence of events asynchronously
    class DummyModel:
        def __init__(self):
            self.calls = 0

        async def stream(self, *args, **kwargs):
            self.calls += 1
            # Yield a simple event and then a stop event
            yield {"type": "dummy_event", "data": "start"}
            yield EventLoopStopEvent(stop_reason="end_turn")

        def __call__(self, *args, **kwargs):
            # Synchronous call returns a dummy result with stop_reason
            class Result:
                stop_reason = "end_turn"
            return Result()

    return DummyModel()


@pytest.fixture
def agent(dummy_model):
    # Create an agent with the dummy model and no tools
    return Agent(model=dummy_model, tools=[], callback_handler=None)


@pytest.mark.asyncio
async def test_agent_stream_stage_interrupt_halts_agent(agent):
    """Test that AgentStreamStage middleware interrupt halts the agent and returns interrupt result."""

    interrupted = False

    async def interrupting_middleware(context, next_fn):
        nonlocal interrupted
        # Interrupt immediately
        context.interrupt("test_interrupt", reason="Testing interrupt")
        interrupted = True
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(AgentStreamStage, interrupting_middleware)

    # Run the agent asynchronously and collect events
    events = []
    with pytest.raises(InterruptException):
        async for event in agent.stream_async("test"):
            events.append(event)

    # The interrupting middleware should have run and interrupted
    assert interrupted

    # The events list should be empty because interrupt raises before yielding any event
    assert not events


def test_agent_stream_stage_interrupt_resume_returns_response(agent):
    """Test that after interrupt, resuming with a response returns that response."""

    responses = []

    async def interrupting_middleware(context, next_fn):
        interrupt_result = context.interrupt("test_interrupt", reason="Testing interrupt")
        responses.append(interrupt_result.response)
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(AgentStreamStage, interrupting_middleware)

    # First call triggers interrupt
    with pytest.raises(InterruptException):
        agent("test")

    # Compose the interrupt id from the middleware (simulate the id used)
    # The id is deterministic based on the name and prefix, so we can get it from the context method
    # But since we don't have direct access, we fake the id prefix and generate it here:
    import uuid
    from strands.interrupt import _AGENT_STREAM_INTERRUPT_ID_PREFIX

    interrupt_id = f"{_AGENT_STREAM_INTERRUPT_ID_PREFIX}{uuid.uuid5(uuid.NAMESPACE_OID, 'test_interrupt')}"

    # Resume with a response
    result = agent([{"interruptResponse": {"interruptId": interrupt_id, "response": "approved"}}])

    # The middleware should have received the response
    assert responses == ["approved"]

    # The final result should have stop_reason end_turn (normal)
    assert result.stop_reason == "end_turn"


def test_execute_tool_stage_interrupt_short_circuits_tool_execution():
    """Test that ExecuteToolStage interrupt short-circuits tool execution."""

    tool_executed = False

    @strands.tool(name="test_tool")
    def test_tool() -> str:
        nonlocal tool_executed
        tool_executed = True
        return "done"

    # Compose a tool_use message that triggers the tool
    tool_use_msg = {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": "tool_1", "name": "test_tool", "input": {}}}],
    }
    final_msg = {"role": "assistant", "content": [{"text": "ok"}]}
    from tests.fixtures.mocked_model_provider import MockedModelProvider

    model = MockedModelProvider([tool_use_msg, final_msg])
    agent = Agent(model=model, tools=[test_tool], callback_handler=None)

    async def interrupting_middleware(context, next_fn):
        context.interrupt("block", reason="no execution allowed")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, interrupting_middleware)

    result = agent("do it")

    # The interrupt should have halted execution
    assert result.stop_reason == "interrupt"
    # The tool should not have executed
    assert not tool_executed


def test_agent_stream_stage_interrupt_id_deterministic():
    """Test that AgentStreamContext interrupt id is deterministic and stable."""

    from strands._middleware.stages import AgentStreamContext

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    id1 = ctx._interrupt_id("my_gate")
    id2 = ctx._interrupt_id("my_gate")

    assert id1 == id2
    assert id1.startswith("v1:middleware_agent_stream:")


def test_agent_stream_stage_interrupt_resolution_and_raise():
    """Test that AgentStreamContext.interrupt raises InterruptException if no response."""

    from strands._middleware.stages import AgentStreamContext
    from strands.interrupt import InterruptException

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    with pytest.raises(InterruptException):
        ctx.interrupt("gate")

    # Provide a response in interrupts dict to simulate resuming
    interrupt_id = ctx._interrupt_id("gate")
    resumed_ctx = AgentStreamContext(
        agent=None,
        messages=[],
        invocation_state={},
        _interrupts={interrupt_id: strands.interrupt.Interrupt(id=interrupt_id, name="gate", response="ok")},
    )

    result = resumed_ctx.interrupt("gate")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "ok"


def test_resolve_middleware_interrupt_precedence():
    """Test that stored human response takes precedence over preemptive response."""

    from strands._middleware.stages import _resolve_middleware_interrupt, MiddlewareInterruptResult
    from strands.interrupt import Interrupt

    interrupt_id = "v1:middleware_execute_tool:tool_1:test-gate"
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="gate", response="DENIED")}

    result = _resolve_middleware_interrupt(interrupts, interrupt_id, "gate", None, "auto-approve")

    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "DENIED"


