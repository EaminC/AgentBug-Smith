from strands._middleware.stages import (
    AgentStreamContext,
    ExecuteToolStage,
    MiddlewareInterruptResult,
    _resolve_middleware_interrupt,
)
from strands.interrupt import Interrupt, InterruptException


def test_resolve_middleware_interrupt_precedence():
    """Stored human response takes precedence over preemptive response."""
    interrupt_id = "v1:middleware_execute_tool:tool_1:test-gate"
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="gate", response="DENIED")}

    result = _resolve_middleware_interrupt(interrupts, interrupt_id, "gate", None, "auto-approve")

    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "DENIED"


def test_agent_stream_context_interrupt_id_and_resolution():
    """AgentStreamContext interrupt ID is stable and interrupt raises/resumes correctly."""
    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    interrupt_id = ctx._interrupt_id("gate")
    assert interrupt_id.startswith("v1:middleware_agent_stream:")
    # ID is stable for same name
    assert interrupt_id == ctx._interrupt_id("gate")

    # Interrupt raises when no response present
    with pytest.raises(InterruptException):
        ctx.interrupt("gate")

    # Interrupt returns MiddlewareInterruptResult when resumed with response
    resumed_ctx = AgentStreamContext(
        agent=None,
        messages=[],
        invocation_state={},
        _interrupts={interrupt_id: Interrupt(id=interrupt_id, name="gate", response="ok")},
    )
    result = resumed_ctx.interrupt("gate")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "ok"


@pytest.mark.asyncio
async def test_agent_stream_stage_interrupt_flow():
    """Test that AgentStreamStage middleware can interrupt and resume correctly."""
    from strands import Agent
    from strands.types._events import EventLoopStopEvent
    from strands._middleware.stages import AgentStreamStage
    from strands.interrupt import InterruptException

    # Dummy model that yields one event and then stops
    class DummyModel:
        def __init__(self):
            self.calls = 0

        async def stream(self, messages, **kwargs):
            self.calls += 1
            yield {"text": "start"}
            yield EventLoopStopEvent(stop_reason="end_turn")

    # Dummy agent that supports middleware and runs AgentStreamStage
    class DummyAgent(Agent):
        def __init__(self):
            super().__init__(model=DummyModel(), tools=[], callback_handler=None)
            self._middleware_registry.add_middleware(AgentStreamStage, self._middleware_fn)
            self._interrupts = {}

        async def _middleware_fn(self, context, next_fn):
            # Interrupt on first call, then resume on second
            if self._interrupts.get("interrupted"):
                # After resume, just pass through
                async for event in next_fn(context):
                    yield event
            else:
                self._interrupts["interrupted"] = True
                context.interrupt("gate", reason="test interrupt")

        async def stream_async(self, messages):
            # Simulate the agent's stream_async invoking middleware chain
            ctx = AgentStreamContext(
                agent=self,
                messages=messages,
                invocation_state={},
                _interrupts=self._interrupts,
            )
            try:
                async for event in self._middleware_registry.run(AgentStreamStage, ctx):
                    yield event
            except InterruptException as e:
                # Register interrupt in state to simulate agent behavior
                self._interrupts[e.interrupt.id] = e.interrupt
                # Yield a final event with stop_reason interrupt
                yield EventLoopStopEvent(stop_reason="interrupt")

    agent = DummyAgent()

    # First run: should raise interrupt and yield interrupt stop event
    events = []
    async for event in agent.stream_async([]):
        events.append(event)
    assert any(getattr(e, "stop_reason", None) == "interrupt" for e in events)
    assert "interrupted" in agent._interrupts

    # Simulate user resuming with response
    interrupt_id = next(iter(agent._interrupts))
    agent._interrupts[interrupt_id] = Interrupt(id=interrupt_id, name="gate", response="yes")

    # Second run: should pass through and end normally
    agent._interrupts["interrupted"] = True  # Mark resumed
    events = []
    async for event in agent.stream_async([]):
        events.append(event)
    assert any(getattr(e, "stop_reason", None) == "end_turn" for e in events)


@pytest.mark.asyncio
async def test_execute_tool_stage_interrupt_short_circuit():
    """Test that ExecuteToolStage middleware interrupt short-circuits tool execution."""

    import strands
    from strands import Agent
    from strands._middleware.stages import ExecuteToolStage
    from strands.types._events import ToolResultEvent

    tool_executed = False

    @strands.tool(name="tracked_tool")
    def tracked_tool() -> str:
        nonlocal tool_executed
        tool_executed = True
        return "done"

    tool_use_msg = {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": "t1", "name": "tracked_tool", "input": {}}}],
    }
    final_msg = {"role": "assistant", "content": [{"text": "ok"}]}
    from tests.fixtures.mocked_model_provider import MockedModelProvider

    model = MockedModelProvider([tool_use_msg, final_msg])
    agent = Agent(model=model, tools=[tracked_tool], callback_handler=None)

    async def blocker(context, next_fn):
        context.interrupt("block", reason="nope")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, blocker)
    result = agent("do it")

    assert result.stop_reason == "interrupt"
    assert not tool_executed


@pytest.mark.asyncio
async def test_execute_tool_stage_interrupt_resume_executes_tool():
    """Test that after interrupt resumes with approval, tool executes."""

    import strands
    from strands import Agent
    from strands._middleware.stages import ExecuteToolStage
    from strands.types._events import ToolResultEvent

    tool_executed = False

    @strands.tool(name="calc")
    def calculator(expression: str) -> str:
        nonlocal tool_executed
        tool_executed = True
        return str(eval(expression))

    tool_use_msg = {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": "t1", "name": "calc", "input": {"expression": "2+2"}}}],
    }
    final_msg = {"role": "assistant", "content": [{"text": "4"}]}
    from tests.fixtures.mocked_model_provider import MockedModelProvider

    model = MockedModelProvider([tool_use_msg, final_msg, final_msg])
    agent = Agent(model=model, tools=[calculator], callback_handler=None)

    async def approval_gate(context, next_fn):
        interrupt_result = context.interrupt("approve", reason="Allow?")
        if interrupt_result.response != "yes":
            yield ToolResultEvent(
                {
                    "toolUseId": context.tool_use["toolUseId"],
                    "status": "error",
                    "content": [{"text": "Denied"}],
                }
            )
            return
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, approval_gate)

    # First call interrupts
    result = agent("calc")
    assert result.stop_reason == "interrupt"
    assert not tool_executed

    # Resume with approval response
    result = agent([{"interruptResponse": {"interruptId": result.interrupts[0].id, "response": "yes"}}])
    assert tool_executed
    assert result.stop_reason == "end_turn"


