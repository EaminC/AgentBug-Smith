from strands import Agent
from strands._middleware.stages import AgentStreamStage, MiddlewareInterruptResult
from strands.interrupt import InterruptException
import pytest


def test_agent_stream_stage_interrupt_behavior():
    """Test that AgentStreamStage middleware interrupt halts and resumes correctly."""

    # Dummy model that yields a single event then stops
    class DummyModel:
        def __call__(self, messages):
            # Simulate a simple synchronous call returning a result with stop_reason
            class Result:
                stop_reason = "end_turn"
                interrupts = []

            return Result()

        async def stream(self, messages):
            # Simulate async generator yielding one event then stopping
            yield {"text": "start"}
            # Normally would yield more events or final stop event

    dummy_model = DummyModel()

    # Create an agent with the dummy model and no tools
    agent = Agent(model=dummy_model, tools=[], callback_handler=None)

    # Middleware that interrupts on the agent stream stage
	async def interrupting_middleware(context, next_fn):
		# Interrupt without a response to cause halt
		context.interrupt("test_interrupt", reason="Testing interrupt")
		async for event in next_fn(context):
			yield event

    # Register the middleware on the AgentStreamStage
    agent._middleware_registry.add_middleware(AgentStreamStage, interrupting_middleware)

    # Call the agent, expect it to raise InterruptException internally and halt
    result = agent("hello")
    assert result.stop_reason == "interrupt"
    assert len(result.interrupts) == 1
    assert result.interrupts[0].name == "test_interrupt"
    assert result.interrupts[0].reason == "Testing interrupt"

    # Resume with a response, expect the interrupt to return MiddlewareInterruptResult
    response_payload = [{"interruptResponse": {"interruptId": result.interrupts[0].id, "response": "approved"}}]
    resumed_result = agent(response_payload)
    # The middleware interrupt should return the response wrapped in MiddlewareInterruptResult
    # We test that the middleware interrupt returned the response "approved"
    # We do this by adding a middleware that captures the response on resume
    captured_response = None

    async def capture_response_middleware(context, next_fn):
        nonlocal captured_response
        interrupt_result = context.interrupt("test_interrupt")
        captured_response = interrupt_result.response
        async for event in next_fn(context):
            yield event

    # Clear previous middlewares and add the capture middleware
    agent._middleware_registry._middleware.clear()
    agent._middleware_registry.add_middleware(AgentStreamStage, capture_response_middleware)

    # Call again with the resume response
    final_result = agent(response_payload)
    assert captured_response == "approved"
    assert isinstance(captured_response, str)
    assert final_result.stop_reason == "end_turn" or final_result.stop_reason == "interrupt" or final_result.stop_reason == "end" or final_result.stop_reason is not None


def test_agent_stream_context_interrupt_id_stability():
    """Test that AgentStreamContext produces stable interrupt IDs."""

    from strands._middleware.stages import AgentStreamContext

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    id1 = ctx._interrupt_id("gate")
    id2 = ctx._interrupt_id("gate")
    id3 = ctx._interrupt_id("other_gate")

    assert id1.startswith("v1:middleware_agent_stream:")
    assert id1 == id2
    assert id1 != id3


def test_agent_stream_context_interrupt_raises_and_resumes():
    """Test that AgentStreamContext.interrupt raises InterruptException and resumes with response."""

    from strands._middleware.stages import AgentStreamContext
    from strands.interrupt import InterruptException, Interrupt

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    # Interrupt without response raises InterruptException
    with pytest.raises(InterruptException):
        ctx.interrupt("gate", reason="reason")

    # Provide a response in _interrupts to simulate resume
    interrupt_id = ctx._interrupt_id("gate")
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="gate", response="ok")}

    resumed_ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts=interrupts)

    result = resumed_ctx.interrupt("gate")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "ok"


def test_agent_stream_stage_interrupt_short_circuit():
    """Test that AgentStreamStage middleware can short-circuit the agent output stream."""

    class DummyModel:
        def __call__(self, messages):
            class Result:
                stop_reason = "end_turn"
                interrupts = []
            return Result()

        async def stream(self, messages):
            yield {"text": "start"}
            yield {"text": "middle"}
            yield {"text": "end"}

    dummy_model = DummyModel()
    agent = Agent(model=dummy_model, tools=[], callback_handler=None)

    async def short_circuit_middleware(context, next_fn):
        # Interrupt with preemptive response to short-circuit
        interrupt_result = context.interrupt("short_circuit", response="short-circuited")
        # Should not call next_fn because interrupt skips
        yield {"text": interrupt_result.response}

    agent._middleware_registry.add_middleware(AgentStreamStage, short_circuit_middleware)

    result = agent("test")
    # The result should not be an interrupt stop but end_turn or similar
    assert result.stop_reason == "end_turn" or result.stop_reason == "end" or result.stop_reason is not None


