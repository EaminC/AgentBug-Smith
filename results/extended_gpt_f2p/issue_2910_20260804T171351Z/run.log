[32mimport pytest
import openai
from openai import ChatCompletion


def test_openai_version_and_multimodal_support():
    # Check that the openai package version is at least 1.78.0
    version_str = openai.__version__
    major, minor, patch = (int(x) for x in version_str.split("."))
    assert (major, minor, patch) >= (1, 78, 0), f"OpenAI version must be >= 1.78.0 but is {version_str}"

    # Prepare a dummy chat completion request with multi-image inputs support
    # This feature is new in openai 1.78.0, so it should be accepted without error
    # We mock the internal network call by patching openai.ChatCompletion.acreate or create method

    # Since we cannot use unittest.mock, we rely on the real method but override the transport
    # We monkeypatch the _sync_request method to simulate a successful response

    class DummyResponse:
        def __init__(self):
            self.choices = [type("Choice", (), {"message": {"content": "dummy response"}})()]

    original_request = ChatCompletion._sync_request

    def dummy_sync_request(self, *args, **kwargs):
        # Simulate a successful response for multi-image input
        return DummyResponse()

    ChatCompletion._sync_request = dummy_sync_request

    try:
        # Compose a chat completion request with multi-image inputs (dummy data)
        response = openai.ChatCompletion.create(
            model="gpt-4o-mini",
            messages=[
                {"role": "user", "content": "Describe this image."}
            ],
            images=[
                {"url": "https://example.com/image1.png"},
                {"url": "https://example.com/image2.png"},
            ],
        )
        # Assert that the response has the expected dummy content
        assert response.choices[0].message["content"] == "dummy response"
    finally:
        # Restore the original method to avoid side effects
        ChatCompletion._sync_request = original_request[0m
