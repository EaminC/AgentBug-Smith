[32mimport asyncio
import unittest

from agentscope.skill import Skill
from agentscope.tool import Toolkit, ToolGroup
from agentscope.tool import ToolCallBlock
from agentscope.state import AgentState


def _make_skill(name: str, description: str = "desc") -> Skill:
    return Skill(
        name=name,
        description=description,
        dir="/tmp",
        markdown="",
        updated_at=0.0,
    )


class MockSkillLoader:
    def __init__(self, skills):
        self._skills = skills

    async def list_skills(self):
        return self._skills


class TestToolkitSkillGroups(unittest.IsolatedAsyncioTestCase):
    async def test_get_skill_instructions_includes_all_tool_groups(self):
        # Create two tool groups with different skills
        repair_skill = _make_skill("repair_skill", "Repair skill description")
        order_skill = _make_skill("order_skill", "Order skill description")

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[MockSkillLoader([repair_skill])],
        )
        order_group = ToolGroup(
            name="order",
            description="Order tools",
            skills_or_loaders=[MockSkillLoader([order_skill])],
        )

        # Create toolkit with both groups
        toolkit = Toolkit(tool_groups=[repair_group, order_group])

        # Call get_skill_instructions without specifying groups (should include all)
        instructions = await toolkit.get_skill_instructions()

        self.assertIsNotNone(instructions)
        self.assertIn("repair_skill", instructions)
        self.assertIn("order_skill", instructions)

    async def test_get_skill_instructions_filters_by_activated_groups(self):
        # Create skills
        basic_skill = _make_skill("basic_skill", "Basic skill description")
        repair_skill = _make_skill("repair_skill", "Repair skill description")

        # Basic skills in default skills_or_loaders
        basic_loader = MockSkillLoader([basic_skill])

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[MockSkillLoader([repair_skill])],
        )

        # Toolkit with basic loader and repair group
        toolkit = Toolkit(skills_or_loaders=[basic_loader], tool_groups=[repair_group])

        # When activated_groups is empty, only basic group skills should appear
        instructions_empty = await toolkit.get_skill_instructions(activated_groups=[])
        self.assertIsNotNone(instructions_empty)
        self.assertIn("basic_skill", instructions_empty)
        self.assertNotIn("repair_skill", instructions_empty)

        # When activated_groups includes repair, both basic and repair skills appear
        instructions_repair = await toolkit.get_skill_instructions(
            activated_groups=["basic", "repair"]
        )
        self.assertIsNotNone(instructions_repair)
        self.assertIn("basic_skill", instructions_repair)
        self.assertIn("repair_skill", instructions_repair)

    async def test_get_available_tools_includes_skill_viewer_for_all_groups(self):
        # Create a skill in a custom group
        repair_skill = _make_skill("repair_skill", "Repair skill description")
        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[MockSkillLoader([repair_skill])],
        )
        toolkit = Toolkit(tool_groups=[repair_group])

        # Call _get_available_tools with the repair group activated
        tools = await toolkit._get_available_tools(groups=["repair"])

        # The SkillViewer tool should be present because skills exist in the repair group
        self.assertIn(toolkit.builtin_skill_viewer.tool.name, tools)

    async def test_call_skill_viewer_with_custom_group_skill(self):
        # Create a skill in a custom group
        repair_skill = _make_skill("repair_skill", "Repair skill description")
        repair_skill.markdown = "# Repair Skill\nUse this for repair tasks."

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[MockSkillLoader([repair_skill])],
        )
        toolkit = Toolkit(tool_groups=[repair_group])

        # Prepare a ToolCallBlock to call the SkillViewer tool for repair_skill
        tool_call = ToolCallBlock(
            id="test_call_1",
            name="Skill",
            input='{"skill": "repair_skill"}',
        )
        state = AgentState()
        # Activate the repair group in the state context
        state.tool_context.activated_groups.append("repair")

        chunks = []
        async for result in toolkit.call_tool(tool_call, state):
            chunks.append(result)

        # We expect at least one ToolChunk with the skill markdown content
        found = False
        for chunk in chunks:
            if hasattr(chunk, "content") and any(
                "Repair Skill" in getattr(c, "text", "") for c in chunk.content
            ):
                found = True
                break
        self.assertTrue(found, "SkillViewer did not return the repair skill content")


