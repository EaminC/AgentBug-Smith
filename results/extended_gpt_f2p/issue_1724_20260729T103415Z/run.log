        instructions = await toolkit.get_skill_instructions()

        self.assertIsNotNone(instructions)
        self.assertIn("repair_skill", instructions)
        self.assertIn("order_skill", instructions)

    async def test_get_skill_instructions_with_explicit_groups(self) -> None:
        """Test that get_skill_instructions filters skills by activated groups."""
        repair_skill = _make_skill("repair_skill", "Repair skill description")
        order_skill = _make_skill("order_skill", "Order skill description")
        basic_skill = _make_skill("basic_skill", "Basic skill description")

        tool_groups = [
            ToolGroup(
                name="basic",
                description="Basic tools",
                skills_or_loaders=[MockSkillLoader([basic_skill])],
            ),
            ToolGroup(
                name="repair",
                description="Repair tools",
                skills_or_loaders=[MockSkillLoader([repair_skill])],
            ),
            ToolGroup(
                name="order",
                description="Order tools",
                skills_or_loaders=[MockSkillLoader([order_skill])],
            ),
        ]

        toolkit = Toolkit(tool_groups=tool_groups)

        # Only activate 'repair' group
        instructions_repair = await toolkit.get_skill_instructions(activated_groups=["repair"])
        self.assertIsNotNone(instructions_repair)
        self.assertIn("repair_skill", instructions_repair)
        self.assertNotIn("order_skill", instructions_repair)
        self.assertNotIn("basic_skill", instructions_repair)

        # Activate 'basic' and 'order' groups
        instructions_basic_order = await toolkit.get_skill_instructions(activated_groups=["basic", "order"])
        self.assertIsNotNone(instructions_basic_order)
        self.assertIn("basic_skill", instructions_basic_order)
        self.assertIn("order_skill", instructions_basic_order)
        self.assertNotIn("repair_skill", instructions_basic_order)

    async def test_skill_viewer_tool_includes_all_group_skills(self) -> None:
        """Test that SkillViewer tool is available when skills exist in all groups."""
