    async def list_skills(self) -> list[Skill]:
        return self._skills


class TestToolkitSkillInstructions(unittest.IsolatedAsyncioTestCase):
    async def test_get_skill_instructions_includes_all_tool_groups(self) -> None:
        """Test that get_skill_instructions returns skills from all tool groups."""
        repair_skill = _make_skill("repair_skill", "Repair skill description")
        order_skill = _make_skill("order_skill", "Order skill description")

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[MockSkillLoader([repair_skill])],
        )
        order_group = ToolGroup(
            name="order",
            description="Order tools",
            skills_or_loaders=[MockSkillLoader([order_skill])],
        )

        toolkit = Toolkit(tool_groups=[repair_group, order_group])

        # Call without specifying activated_groups to include all groups
        instructions = await toolkit.get_skill_instructions()

        self.assertIsNotNone(instructions)
        self.assertIn("<name>repair_skill</name>", instructions)
        self.assertIn("<name>order_skill</name>", instructions)

    async def test_get_skill_instructions_filters_by_activated_groups(self) -> None:
        """Test that get_skill_instructions filters skills by activated groups."""
        basic_skill = _make_skill("basic_skill", "Basic skill description")
        repair_skill = _make_skill("repair_skill", "Repair skill description")

        basic_loader = MockSkillLoader([basic_skill])
        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[MockSkillLoader([repair_skill])],
        )

        toolkit = Toolkit(
            skills_or_loaders=[basic_loader],
            tool_groups=[repair_group],
        )

        # Only activate "repair" group, so basic skills should be excluded
        instructions = await toolkit.get_skill_instructions(activated_groups=["repair"])

        self.assertIsNotNone(instructions)
        self.assertIn("<name>repair_skill</name>", instructions)
        self.assertNotIn("<name>basic_skill</name>", instructions)

        # Activate no groups, should only include basic skills
        instructions_none = await toolkit.get_skill_instructions(activated_groups=[])

        self.assertIsNotNone(instructions_none)
        self.assertIn("<name>basic_skill</name>", instructions_none)
        self.assertNotIn("<name>repair_skill</name>", instructions_none)


class TestToolkitAvailableTools(unittest.IsolatedAsyncioTestCase):
    async def test_skill_viewer_tool_included_for_all_groups(self) -> None:
        """Test that SkillViewer tool is included when skills from all groups are available."""
        repair_skill = _make_skill("repair_skill", "Repair skill description")
        order_skill = _make_skill("order_skill", "Order skill description")

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[MockSkillLoader([repair_skill])],
        )
        order_group = ToolGroup(
            name="order",
            description="Order tools",
            skills_or_loaders=[MockSkillLoader([order_skill])],
        )

        toolkit = Toolkit(tool_groups=[repair_group, order_group])

        # The _get_available_tools method requires a groups argument
        available_tools = await toolkit._get_available_tools(
            groups=[g.name for g in toolkit.tool_groups]
        )

        # The builtin_skill_viewer tool should be present if any skills exist
        self.assertIn(toolkit.builtin_skill_viewer.tool.name, available_tools)

    async def test_skill_viewer_tool_not_included_if_no_skills(self) -> None:
        """Test that SkillViewer tool is not included if no skills are available."""
        toolkit = Toolkit(tool_groups=[])

        available_tools = await toolkit._get_available_tools(groups=[])

        self.assertNotIn(toolkit.builtin_skill_viewer.tool.name, available_tools)


class TestSkillViewerToolCall(unittest.IsolatedAsyncioTestCase):
    async def test_skill_viewer_tool_call_with_custom_group_skill(self) -> None:
        """Test calling SkillViewer tool with a skill from a custom tool group."""
        skill = _make_skill("custom_skill", "Custom skill description")
        skill.markdown = "# Custom Skill\nDetails about the custom skill."

        custom_group = ToolGroup(
            name="custom",
            description="Custom tools",
            skills_or_loaders=[MockSkillLoader([skill])],
        )

        toolkit = Toolkit(tool_groups=[custom_group])

        # Activate the custom group in the agent state
        state = AgentState()
        state.tool_context.activated_groups.append("custom")

        tool_call = ToolCallBlock(
            id="test_call_1",
            name="Skill",
            input=json.dumps({"skill": "custom_skill"}),
        )

        chunks = []
        async for result in toolkit.call_tool(tool_call, state):
            if hasattr(result, "content"):
                chunks.append(result)

        self.assertTrue(len(chunks) >= 1)
        # The first chunk content text should include the markdown of the skill
        first_chunk_text = chunks[0].content[0].text if chunks[0].content else ""
        self.assertIn("Custom Skill", first_chunk_text)
        self.assertIn("Details about the custom skill", first_chunk_text)


