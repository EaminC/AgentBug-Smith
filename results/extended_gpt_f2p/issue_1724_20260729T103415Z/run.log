[32mimport asyncio
import unittest

from agentscope.skill import SkillLoaderBase, Skill
from agentscope.tool import Toolkit, ToolGroup
from agentscope.message import ToolCallBlock
from agentscope.state import AgentState
from agentscope.tool import ToolChunk


def _make_skill(name: str, description: str = "desc") -> Skill:
    return Skill(
        name=name,
        description=description,
        dir="/tmp",
        markdown=f"# {name}\nDescription: {description}",
        updated_at=0.0,
    )


class MockSkillLoader(SkillLoaderBase):
    def __init__(self, skills: list[Skill]) -> None:
        self._skills = skills

    async def list_skills(self) -> list[Skill]:
        return self._skills


class TestToolkitSkillGroups(unittest.IsolatedAsyncioTestCase):
    async def test_get_skill_instructions_includes_all_tool_groups(self) -> None:
        """Test that get_skill_instructions returns skills from all tool groups."""
        repair_skill = _make_skill("repair_skill", "Repair skill description")
        order_skill = _make_skill("order_skill", "Order skill description")

        tool_groups = [
            ToolGroup(
                name="repair",
                description="Repair tools",
                skills_or_loaders=[MockSkillLoader([repair_skill])],
            ),
            ToolGroup(
                name="order",
                description="Order tools",
                skills_or_loaders=[MockSkillLoader([order_skill])],
            ),
        ]

        toolkit = Toolkit(tool_groups=tool_groups)

        # Call get_skill_instructions without specifying groups to get all
        instructions = await toolkit.get_skill_instructions()

        self.assertIsNotNone(instructions)
        self.assertIn("<name>repair_skill</name>", instructions)
        self.assertIn("<name>order_skill</name>", instructions)

    async def test_get_skill_instructions_with_explicit_groups(self) -> None:
        """Test that get_skill_instructions filters skills by activated groups."""
        repair_skill = _make_skill("repair_skill", "Repair skill description")
        order_skill = _make_skill("order_skill", "Order skill description")

        tool_groups = [
            ToolGroup(
                name="repair",
                description="Repair tools",
                skills_or_loaders=[MockSkillLoader([repair_skill])],
            ),
            ToolGroup(
                name="order",
                description="Order tools",
                skills_or_loaders=[MockSkillLoader([order_skill])],
            ),
        ]

        toolkit = Toolkit(tool_groups=tool_groups)

        # Only activate "repair" group
        instructions = await toolkit.get_skill_instructions(activated_groups=["repair"])

        self.assertIsNotNone(instructions)
        self.assertIn("<name>repair_skill</name>", instructions)
        self.assertNotIn("<name>order_skill</name>", instructions)

    async def test_skill_viewer_tool_includes_all_group_skills(self) -> None:
        """Test that SkillViewer tool is available when skills exist in all groups."""
        repair_skill = _make_skill("repair_skill", "Repair skill description")
        order_skill = _make_skill("order_skill", "Order skill description")

        tool_groups = [
            ToolGroup(
                name="repair",
                description="Repair tools",
                skills_or_loaders=[MockSkillLoader([repair_skill])],
            ),
            ToolGroup(
                name="order",
                description="Order tools",
                skills_or_loaders=[MockSkillLoader([order_skill])],
            ),
        ]

        toolkit = Toolkit(tool_groups=tool_groups)

        # _get_available_tools requires groups argument; pass all group names
        available_tools = await toolkit._get_available_tools([g.name for g in tool_groups])

        # The SkillViewer tool should be present
        self.assertIn(toolkit.builtin_skill_viewer.tool.name, available_tools)

    async def test_call_skill_viewer_with_tool_group_skill(self) -> None:
        """Test calling SkillViewer with a skill from a custom tool group."""
        skill = _make_skill("repair_skill", "Repair skill description")
        toolkit = Toolkit(
            tool_groups=[
                ToolGroup(
                    name="repair",
                    description="Repair tools",
                    skills_or_loaders=[MockSkillLoader([skill])],
                ),
            ],
        )

        tool_call = ToolCallBlock(
            id="test_call_1",
            name="Skill",
            input='{"skill": "repair_skill"}',
        )
        state = AgentState()
        state.tool_context.activated_groups.append("repair")

        chunks = []
        async for result in toolkit.call_tool(tool_call, state):
            if isinstance(result, ToolChunk):
                chunks.append(result)

        self.assertTrue(
            any("repair_skill" in getattr(chunk, "content", [{}])[0].get("text", "") or
                "Repair skill description" in getattr(chunk, "content", [{}])[0].get("text", "")
                for chunk in chunks),
            "SkillViewer did not return the expected skill content",
        )


if __name__ == "__main__":
    unittest.main()[0m
