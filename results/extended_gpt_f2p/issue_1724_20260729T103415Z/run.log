[32mimport asyncio
import json
import unittest
from unittest.async_case import IsolatedAsyncioTestCase

from agentscope.skill import Skill
from agentscope.tool import Toolkit, ToolGroup
from agentscope.message import ToolCallBlock
from agentscope.state import AgentState


def _make_skill(name: str, description: str = "desc") -> Skill:
    return Skill(
        name=name,
        description=description,
        dir="/tmp",
        markdown="",
        updated_at=0.0,
    )


class TestToolkitSkillInstructions(IsolatedAsyncioTestCase):
    async def test_get_skill_instructions_includes_all_tool_groups(self):
        # Create skills in different tool groups
        repair_skill = _make_skill("repair_skill", "Repair skill description")
        order_skill = _make_skill("order_skill", "Order skill description")

        # Create ToolGroups with these skills
        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[repair_skill],
        )
        order_group = ToolGroup(
            name="order",
            description="Order tools",
            skills_or_loaders=[order_skill],
        )

        # Create Toolkit with multiple tool groups
        toolkit = Toolkit(tool_groups=[repair_group, order_group])

        # Call get_skill_instructions without specifying groups (should include all)
        instructions = await toolkit.get_skill_instructions()

        self.assertIsNotNone(instructions)
        self.assertIn("repair_skill", instructions)
        self.assertIn("order_skill", instructions)

    async def test_get_skill_instructions_filters_by_activated_groups(self):
        # Skills
        basic_skill = _make_skill("basic_skill", "Basic skill description")
        repair_skill = _make_skill("repair_skill", "Repair skill description")

        # ToolGroups
        basic_group = ToolGroup(
            name="basic",
            description="Basic tools",
            skills_or_loaders=[basic_skill],
        )
        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[repair_skill],
        )

        # Toolkit with both groups
        toolkit = Toolkit(tool_groups=[basic_group, repair_group])

        # When activated_groups is empty, only basic skills should appear (basic is default)
        instructions_none = await toolkit.get_skill_instructions(activated_groups=[])
        self.assertIsNotNone(instructions_none)
        self.assertIn("basic_skill", instructions_none)
        self.assertNotIn("repair_skill", instructions_none)

        # When activated_groups includes repair, both basic and repair skills appear
        instructions_repair = await toolkit.get_skill_instructions(
            activated_groups=["basic", "repair"]
        )
        self.assertIsNotNone(instructions_repair)
        self.assertIn("basic_skill", instructions_repair)
        self.assertIn("repair_skill", instructions_repair)


class TestToolkitAvailableTools(IsolatedAsyncioTestCase):
    async def test_skill_viewer_in_available_tools_for_all_groups(self):
        # Skill in a non-basic group
        repair_skill = _make_skill("repair_skill", "Repair skill description")

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[repair_skill],
        )

        toolkit = Toolkit(tool_groups=[repair_group])

        # The _get_available_tools method requires a groups list
        # Pass all groups to get all skills
        tools = await toolkit._get_available_tools(groups=["repair"])

        # The SkillViewer tool should be present if skills exist
        self.assertIn(toolkit.builtin_skill_viewer.tool.name, tools)

        # The SkillViewer tool should not appear if no skills in groups
        tools_none = await toolkit._get_available_tools(groups=[])
        # It may or may not appear depending on implementation, but with no skills, it should not
        self.assertNotIn(toolkit.builtin_skill_viewer.tool.name, tools_none)


class TestToolkitCallSkillViewer(IsolatedAsyncioTestCase):
    async def test_call_skill_viewer_with_skill_in_custom_group(self):
        # Skill in custom group
        skill = _make_skill("repair_skill", "Repair skill description")
        skill.markdown = "# Repair Skill\nDetails about repair skill."

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[skill],
        )

        toolkit = Toolkit(tool_groups=[repair_group])

        # Activate the repair group in state
        state = AgentState()
        state.tool_context.activated_groups.append("repair")

        # Call the Skill tool with the skill name
        tool_call = ToolCallBlock(
            id="call1",
            name="Skill",
            input=json.dumps({"skill": "repair_skill"}),
        )

        chunks = []
        async for result in toolkit.call_tool(tool_call, state):
            chunks.append(result)

        # There should be at least one chunk with the skill markdown content
        found = False
        for chunk in chunks:
            if hasattr(chunk, "content"):
                for part in chunk.content:
                    if "Repair Skill" in getattr(part, "text", ""):
                        found = True
                        break
            if found:
                break

        self.assertTrue(found, "SkillViewer did not return the skill content for repair_skill")


