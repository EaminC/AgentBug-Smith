            id="call_1",
            name="Skill",
            input=json.dumps({"skill": "repair_skill"}),
        )
        state = AgentState()
        state.tool_context.activated_groups.append("repair")

        chunks = []
        async for result in toolkit.call_tool(tool_call, state):
            chunks.append(result)

        # There should be at least one ToolChunk with the skill markdown content
        found = any(
            hasattr(chunk, "content") and any(
                hasattr(c, "text") and "Repair Skill" in c.text for c in getattr(chunk, "content", [])
            )
            for chunk in chunks
        )
        self.assertTrue(found, "SkillViewer did not return the expected skill content")[0m
