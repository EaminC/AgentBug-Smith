            skills_or_loaders=[MockSkillLoader([repair_skill])],
        )
        order_group = ToolGroup(
            name="order",
            description="Order tools",
            skills_or_loaders=[MockSkillLoader([order_skill])],
        )

        # Create toolkit with these two groups
        toolkit = Toolkit(tool_groups=[repair_group, order_group])

        # Call get_skill_instructions without specifying groups (should include all)
        instructions = await toolkit.get_skill_instructions()

        # The instructions should include both skills from both groups
        self.assertIsNotNone(instructions)
        self.assertIn("repair_skill", instructions)
        self.assertIn("order_skill", instructions)

    async def test_get_skill_instructions_with_explicit_groups_filters_skills(self):
        # Setup two tool groups with different skills
        repair_skill = _make_skill("repair_skill", "Repair skill description")
        order_skill = _make_skill("order_skill", "Order skill description")

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[MockSkillLoader([repair_skill])],
        )
        order_group = ToolGroup(
            name="order",
            description="Order tools",
            skills_or_loaders=[MockSkillLoader([order_skill])],
        )

        # Create toolkit with these two groups
        toolkit = Toolkit(tool_groups=[repair_group, order_group])

        # Call get_skill_instructions specifying only the 'repair' group
        instructions = await toolkit.get_skill_instructions(activated_groups=["repair"])

        # Should include repair_skill but not order_skill
        self.assertIsNotNone(instructions)
        self.assertIn("repair_skill", instructions)
        self.assertNotIn("order_skill", instructions)

    async def test_get_available_tools_includes_skill_viewer_for_all_groups(self):
        # Setup tool groups with skills
        repair_skill = _make_skill("repair_skill", "Repair skill description")
        order_skill = _make_skill("order_skill", "Order skill description")

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[MockSkillLoader([repair_skill])],
        )
        order_group = ToolGroup(
            name="order",
            description="Order tools",
            skills_or_loaders=[MockSkillLoader([order_skill])],
        )

        toolkit = Toolkit(tool_groups=[repair_group, order_group])

        # The _get_available_tools method requires groups argument
        # Pass all group names to simulate activation of all groups
        available_tools = await toolkit._get_available_tools(groups=["repair", "order"])

        # The builtin_skill_viewer tool should be included because skills exist in these groups
        self.assertIn(toolkit.builtin_skill_viewer.tool.name, available_tools)

    async def test_get_available_tools_excludes_skill_viewer_if_no_skills(self):
        # Setup toolkit with empty groups (no skills)
        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[],
        )
        order_group = ToolGroup(
            name="order",
            description="Order tools",
            skills_or_loaders=[],
        )
        toolkit = Toolkit(tool_groups=[repair_group, order_group])

        # Pass all group names
        available_tools = await toolkit._get_available_tools(groups=["repair", "order"])

        # builtin_skill_viewer should not be included because no skills exist
        self.assertNotIn(toolkit.builtin_skill_viewer.tool.name, available_tools)


