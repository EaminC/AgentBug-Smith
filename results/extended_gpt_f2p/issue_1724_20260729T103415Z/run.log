            id="test_call",
            name="Skill",
            input=json.dumps({"skill": "custom_skill"}),
        )
        state = AgentState()
        # Activate the custom group in the state to simulate context
        state.tool_context.activated_groups.append("custom")

        chunks = []
        response = None
        async for result in toolkit.call_tool(tool_call, state):
            if hasattr(result, "model_dump"):
                # ToolChunk or ToolResponse
                if getattr(result, "state", None) == "running":
                    chunks.append(result)
                else:
                    response = result

        # We expect at least one chunk with the skill markdown content
        self.assertTrue(any("# Custom Skill" in chunk.content[0].text for chunk in chunks))
        # The final response should be success
        self.assertIsNotNone(response)
        self.assertEqual(response.state, "success")[0m
