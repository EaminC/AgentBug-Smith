    async def test_get_skill_instructions_includes_all_tool_groups(self):
        """Test that get_skill_instructions returns skills from all tool groups."""

        # Setup two tool groups with distinct skills
        repair_skill = _make_skill("repair_skill", "Repair skill description")
        order_skill = _make_skill("order_skill", "Order skill description")

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[MockSkillLoader([repair_skill])],
        )
        order_group = ToolGroup(
            name="order",
            description="Order tools",
            skills_or_loaders=[MockSkillLoader([order_skill])],
        )

        toolkit = Toolkit(tool_groups=[repair_group, order_group])

        # Call get_skill_instructions without specifying groups (should include all)
        instructions = await toolkit.get_skill_instructions()

        self.assertIsNotNone(instructions)
        self.assertIn("repair_skill", instructions)
        self.assertIn("order_skill", instructions)

    async def test_get_skill_instructions_filters_by_activated_groups(self):
        """Test that get_skill_instructions filters skills by activated groups."""

        basic_skill = _make_skill("basic_skill", "Basic skill description")
        repair_skill = _make_skill("repair_skill", "Repair skill description")

        basic_loader = MockSkillLoader([basic_skill])

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[MockSkillLoader([repair_skill])],
        )

        toolkit = Toolkit(
            skills_or_loaders=[basic_loader],
            tool_groups=[repair_group],
        )

        # When activated groups is empty, only "basic" skills should appear
        instructions_none = await toolkit.get_skill_instructions(activated_groups=[])
        self.assertIsNotNone(instructions_none)
        self.assertIn("basic_skill", instructions_none)
        self.assertNotIn("repair_skill", instructions_none)

        # When activated groups includes "repair", both skills should appear
        instructions_repair = await toolkit.get_skill_instructions(activated_groups=["repair"])
        self.assertIsNotNone(instructions_repair)
        self.assertIn("basic_skill", instructions_repair)
        self.assertIn("repair_skill", instructions_repair)

    async def test_get_available_tools_includes_skill_viewer_for_all_groups(self):
        """Test that _get_available_tools includes SkillViewer tool for all groups' skills."""

        repair_skill = _make_skill("repair_skill", "Repair skill description")
        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[MockSkillLoader([repair_skill])],
        )

        toolkit = Toolkit(tool_groups=[repair_group])

        # _get_available_tools requires groups argument; pass all group names
        available_tools = await toolkit._get_available_tools(groups=[g.name for g in toolkit.tool_groups])

        # The SkillViewer tool should be present because there are skills in the repair group
        self.assertIn(toolkit.builtin_skill_viewer.tool.name, available_tools)

    async def test_call_skill_viewer_with_skill_in_custom_group(self):
        """Test calling SkillViewer tool with a skill from a custom tool group."""

        repair_skill = _make_skill("repair_skill", "Repair skill markdown content")
        repair_skill.markdown = "# Repair Skill\nDetails about repair skill."

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[MockSkillLoader([repair_skill])],
        )

        toolkit = Toolkit(tool_groups=[repair_group])

        # Prepare a tool call block to call SkillViewer with the repair_skill
        from agentscope.message import ToolCallBlock
        from agentscope.state import AgentState
        from agentscope.tool import ToolChunk, ToolResponse

        tool_call = ToolCallBlock(
            id="test_call_1",
            name="Skill",
            input='{"skill": "repair_skill"}',
        )

        state = AgentState()
        # Activate the repair group to ensure skills from it are visible
        state.tool_context.activated_groups.append("repair")

        chunks = []
        response = None
        async for result in toolkit.call_tool(tool_call, state):
            if isinstance(result, ToolChunk):
                chunks.append(result)
            elif isinstance(result, ToolResponse):
                response = result

        self.assertTrue(len(chunks) > 0)
        # The first chunk content should contain the markdown text of the skill
        self.assertIn("Repair Skill", chunks[0].content[0].text)
        self.assertIsNotNone(response)
        self.assertEqual(response.state, "success")


