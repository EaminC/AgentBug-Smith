[32mimport asyncio
import unittest

from agentscope.skill import Skill
from agentscope.tool import Toolkit, ToolGroup
from agentscope.tool import ToolCallBlock
from agentscope.state import AgentState


def _make_skill(name: str, description: str = "desc") -> Skill:
    return Skill(
        name=name,
        description=description,
        dir="/tmp",
        markdown="",
        updated_at=0.0,
    )


class TestToolkitSkillGroups(unittest.IsolatedAsyncioTestCase):
    async def test_get_skill_instructions_includes_all_tool_groups(self):
        # Create two tool groups with distinct skills
        repair_skill = _make_skill("repair_skill", description="Repair skill desc")
        order_skill = _make_skill("order_skill", description="Order skill desc")

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[repair_skill],
        )
        order_group = ToolGroup(
            name="order",
            description="Order tools",
            skills_or_loaders=[order_skill],
        )

        # Create toolkit with both tool groups
        toolkit = Toolkit(tool_groups=[repair_group, order_group])

        # Call get_skill_instructions without specifying groups (should include all)
        instructions = await toolkit.get_skill_instructions()

        # The instructions should include both skills
        self.assertIsNotNone(instructions)
        self.assertIn("repair_skill", instructions)
        self.assertIn("order_skill", instructions)

    async def test_get_skill_instructions_filters_by_activated_groups(self):
        # Create two tool groups with distinct skills
        repair_skill = _make_skill("repair_skill", description="Repair skill desc")
        order_skill = _make_skill("order_skill", description="Order skill desc")

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[repair_skill],
        )
        order_group = ToolGroup(
            name="order",
            description="Order tools",
            skills_or_loaders=[order_skill],
        )

        # Create toolkit with both tool groups
        toolkit = Toolkit(tool_groups=[repair_group, order_group])

        # Call get_skill_instructions with only "repair" activated
        instructions = await toolkit.get_skill_instructions(activated_groups=["repair"])

        # Should include repair_skill but not order_skill
        self.assertIsNotNone(instructions)
        self.assertIn("repair_skill", instructions)
        self.assertNotIn("order_skill", instructions)

    async def test_get_available_tools_includes_skill_viewer_for_all_groups(self):
        # Create a skill in a custom group
        custom_skill = _make_skill("custom_skill", description="Custom skill desc")
        custom_group = ToolGroup(
            name="custom",
            description="Custom tools",
            skills_or_loaders=[custom_skill],
        )

        toolkit = Toolkit(tool_groups=[custom_group])

        # The _get_available_tools method is async and expects groups parameter
        # We test that SkillViewer tool is included when skills exist in all groups
        available_tools = await toolkit._get_available_tools(groups=["custom"])

        # The SkillViewer tool name should be present in available_tools keys
        self.assertIn(toolkit.builtin_skill_viewer.tool.name, available_tools)

    async def test_call_skill_viewer_with_custom_group_skill(self):
        # Create a skill in a custom group with markdown content
        skill = _make_skill("custom_skill", description="Custom skill desc")
        skill.markdown = "# Custom Skill\nThis is the custom skill content."

        custom_group = ToolGroup(
            name="custom",
            description="Custom tools",
            skills_or_loaders=[skill],
        )

        toolkit = Toolkit(tool_groups=[custom_group])

        # Prepare a ToolCallBlock to call the SkillViewer tool for the custom skill
        tool_call = ToolCallBlock(
            id="test_call_1",
            name="Skill",
            input='{"skill": "custom_skill"}',
        )
        state = AgentState()
        # Activate the custom group in the state so toolkit knows to include it
        state.tool_context.activated_groups.append("custom")

        chunks = []
        async for result in toolkit.call_tool(tool_call, state):
            # We expect ToolChunk results with the skill markdown content
            if hasattr(result, "content") and isinstance(result.content, list):
                chunks.append(result)

        # There should be at least one chunk with the skill markdown text
        self.assertTrue(any("# Custom Skill" in chunk.content[0].text for chunk in chunks))


if __name__ == "__main__":
