[32mimport asyncio
import json
from unittest.async_case import IsolatedAsyncioTestCase

from agentscope.skill import Skill
from agentscope.tool import Toolkit, ToolGroup
from agentscope.message import ToolCallBlock
from agentscope.state import AgentState


def _make_skill(name: str, description: str = "desc") -> Skill:
    """Helper to create a Skill instance."""
    return Skill(
        name=name,
        description=description,
        dir="/tmp",
        markdown="",
        updated_at=0.0,
    )


class TestToolkitSkillInstructionsFail2Pass(IsolatedAsyncioTestCase):
    async def test_get_skill_instructions_includes_all_tool_groups(self) -> None:
        """Test that get_skill_instructions returns skills from all ToolGroups.

        Before fix: only 'basic' group skills are included, so skills from
        custom groups are missing.

        After fix: skills from all tool groups are included.
        """
        # Setup toolkit with multiple tool groups, each with distinct skills
        repair_skill = _make_skill("repair_skill", "Repair related skill")
        order_skill = _make_skill("order_skill", "Order related skill")

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[repair_skill],
        )
        order_group = ToolGroup(
            name="order",
            description="Order tools",
            skills_or_loaders=[order_skill],
        )
        # Also add a basic skill to default skills_or_loaders to simulate basic group
        basic_skill = _make_skill("basic_skill", "Basic group skill")

        toolkit = Toolkit(
            skills_or_loaders=[basic_skill],
            tool_groups=[repair_group, order_group],
        )

        # Call get_skill_instructions without parameters (should include all groups)
        instructions = await toolkit.get_skill_instructions()

        # The instructions should include all three skills from all groups
        self.assertIsNotNone(instructions)
        self.assertIn("repair_skill", instructions)
        self.assertIn("order_skill", instructions)
        self.assertIn("basic_skill", instructions)

    async def test_get_skill_instructions_with_activated_groups_filters_skills(self) -> None:
        """Test that get_skill_instructions filters skills by activated groups.

        Before fix: groups parameter ignored, so filtering does not work.

        After fix: skills are filtered according to activated groups.
        """
        repair_skill = _make_skill("repair_skill", "Repair related skill")
        order_skill = _make_skill("order_skill", "Order related skill")
        basic_skill = _make_skill("basic_skill", "Basic group skill")

        repair_group = ToolGroup(
            name="repair",
            description="Repair tools",
            skills_or_loaders=[repair_skill],
        )
        order_group = ToolGroup(
            name="order",
            description="Order tools",
            skills_or_loaders=[order_skill],
        )

        toolkit = Toolkit(
            skills_or_loaders=[basic_skill],
            tool_groups=[repair_group, order_group],
        )

        # Only activate 'repair' group
        instructions_repair = await toolkit.get_skill_instructions(activated_groups=["repair"])
        self.assertIsNotNone(instructions_repair)
        self.assertIn("repair_skill", instructions_repair)
        self.assertNotIn("order_skill", instructions_repair)
        # Basic skills are always included because skills_or_loaders is separate
        self.assertIn("basic_skill", instructions_repair)

        # Activate no groups (empty list)
        instructions_none = await toolkit.get_skill_instructions(activated_groups=[])
        self.assertIsNotNone(instructions_none)
        # Only basic skills should appear
        self.assertIn("basic_skill", instructions_none)
        self.assertNotIn("repair_skill", instructions_none)
        self.assertNotIn("order_skill", instructions_none)

    async def test_get_available_tools_includes_skill_viewer_for_all_groups(self) -> None:
        """Test that _get_available_tools includes SkillViewer tool for all groups.

        Before fix: SkillViewer only registered with 'basic' group skills.

        After fix: SkillViewer registered if any skills from all groups.
        """
        skill = _make_skill("custom_skill", "Custom skill for testing")
        group = ToolGroup(
            name="custom",
            description="Custom group",
            skills_or_loaders=[skill],
        )
        toolkit = Toolkit(tool_groups=[group])

        # The _get_available_tools method is async and expects groups parameter
        # We test with the custom group name to simulate activated groups
        available_tools = await toolkit._get_available_tools(groups=["custom"])

        # The SkillViewer tool should be present if skills exist
        self.assertIn(toolkit.builtin_skill_viewer.tool.name, available_tools)

    async def test_call_skill_viewer_with_custom_group_skill(self) -> None:
        """Test calling SkillViewer tool with a skill from a custom ToolGroup.

        Before fix: SkillViewer tool not aware of custom group skills.

        After fix: SkillViewer can access skills from all groups.
