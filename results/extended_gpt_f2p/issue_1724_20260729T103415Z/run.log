        order_skill = _make_skill("order_skill", "Order skill description")

        tool_groups = [
            ToolGroup(
                name="repair",
                description="Repair tools",
                skills_or_loaders=[MockSkillLoader([repair_skill])],
            ),
            ToolGroup(
                name="order",
                description="Order tools",
                skills_or_loaders=[MockSkillLoader([order_skill])],
            ),
        ]

        toolkit = Toolkit(tool_groups=tool_groups)

        # _get_available_tools requires groups argument; pass all group names
        available_tools = await toolkit._get_available_tools([g.name for g in tool_groups])

        # The SkillViewer tool should be present
        self.assertIn(toolkit.builtin_skill_viewer.tool.name, available_tools)

    async def test_call_skill_viewer_with_tool_group_skill(self) -> None:
        """Test calling SkillViewer tool returns correct skill content from a tool group."""
        skill = _make_skill("repair_skill", "Repair skill description")
        skill.markdown = "# Repair Skill\nDetails about repair skill."

        toolkit = Toolkit(
