        {"role": "assistant", "content": [{"text": "You live in Seattle, USA."}]},
        {"role": "user", "content": [{"text": "I like pizza"}]},
    ]

    fixed_messages = session_manager._fix_broken_tool_use(messages)

    # Should remove the first message with orphaned toolResult
    assert len(fixed_messages) == 2
    assert fixed_messages[0]["role"] == "assistant"
    assert fixed_messages[0]["content"][0]["text"] == "You live in Seattle, USA."
    assert fixed_messages[1]["role"] == "user"
    assert fixed_messages[1]["content"][0]["text"] == "I like pizza"


def test_fix_broken_tool_use_does_not_affect_normal_conversations(session_manager):
    """Test that normal conversations without orphaned toolResults are unaffected."""
    messages = [
        {"role": "user", "content": [{"text": "Hello"}]},
        {"role": "assistant", "content": [{"text": "Hi there!"}]},
        {"role": "user", "content": [{"text": "How are you?"}]},
    ]

    fixed_messages = session_manager._fix_broken_tool_use(messages)

    # Should remain unchanged
    assert fixed_messages == messages


def test_fix_broken_tool_use_handles_orphaned_tool_use_and_result(session_manager):
    """Test that orphaned toolUse messages get toolResult added and orphaned toolResult messages get removed."""

    # Setup messages with orphaned toolUse and orphaned toolResult at start
    broken_messages = [
        {
            "role": "user",
            "content": [
                {
                    "toolResult": {
                        "toolUseId": "orphaned-result-xyz",
                        "status": "success",
                        "content": [{"text": "Orphaned result"}],
                    }
                }
            ],
        },
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "tooluse-1", "name": "tool1", "input": {"input": "data1"}}},
                {"toolUse": {"toolUseId": "tooluse-2", "name": "tool2", "input": {"input": "data2"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                {
                    "toolResult": {
                        "toolUseId": "tooluse-1",
                        "status": "success",
                        "content": [{"text": "Result for tooluse-1"}],
                    }
                }
            ],
        },
        {"role": "user", "content": [{"text": "Normal message"}]},
    ]

    fixed_messages = session_manager._fix_broken_tool_use(broken_messages)

    # The first message with orphaned toolResult should be removed
    # The orphaned toolUse "tooluse-2" should have a toolResult added in a new message
    # So total messages should be original count -1 +1 = original count
    assert len(fixed_messages) == len(broken_messages)

    # First message should now be the assistant message with toolUse
    assert fixed_messages[0]["role"] == "assistant"
    # The second message should be the user message with toolResult for tooluse-1
    assert fixed_messages[1]["role"] == "user"
    # The third message should be the inserted message with toolResult for tooluse-2
    assert fixed_messages[2]["role"] == "user"
    tool_result_contents = fixed_messages[2]["content"]
    assert any(
        "toolResult" in c and c["toolResult"]["toolUseId"] == "tooluse-2" and c["toolResult"]["status"] == "error"
        for c in tool_result_contents
    )[0m
