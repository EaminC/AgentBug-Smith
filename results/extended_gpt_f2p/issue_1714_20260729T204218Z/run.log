import sys
import asyncio
import unittest
from agentscope.tool import Bash


@unittest.skipIf(
    sys.platform != "win32",
    "This test is only relevant on Windows platform",
)
class TestBashExecuteShellCommandWindow(unittest.IsolatedAsyncioTestCase):
    """
    Test that executing shell commands via Bash tool on Windows does not pop up a console window.
    This indirectly tests that the subprocess is created with CREATE_NO_WINDOW flag.
    """

    async def test_execute_shell_command_no_console_window(self):
        """
        Run a simple shell command and verify it completes successfully without error.
        The bug causes a console window to pop up and focus steal, but this cannot be
        detected directly in this test environment. Instead, we rely on the subprocess
        creation flags to be set correctly (which is part of the fix).
        """
        bash_tool = Bash()

        # Run a simple command that outputs text
        chunks = []
        async for chunk in bash_tool(command="echo HelloWindows"):
            chunks.append(chunk)

        # There should be exactly one chunk with running state and is_last True
        self.assertEqual(len(chunks), 1)
        self.assertEqual(chunks[0].state, "running")
        self.assertTrue(chunks[0].is_last)

        # The output should contain the echoed text
        texts = [block.text for block in chunks[0].content if hasattr(block, "text")]
        output_text = " ".join(texts)
        self.assertIn("HelloWindows", output_text)

        # The command should not error
        self.assertNotEqual(chunks[0].state, "error")


if __name__ == "__main__":
    unittest.main()[0m
