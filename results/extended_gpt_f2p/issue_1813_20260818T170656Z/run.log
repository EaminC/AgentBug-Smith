def test_server_instructions_attribute_exists():
    """Test that MCPClient has the server_instructions attribute after initialization."""
    # We create a client with a dummy transport callable that returns a mock session
    # that has an initialize method returning an object with instructions set.
    import asyncio
    from unittest.mock import AsyncMock, MagicMock

    class DummyInitResult:
        def __init__(self, instructions):
            self.instructions = instructions

    class DummySession:
        def __init__(self, instructions):
            self.instructions = instructions
            self.initialize = AsyncMock(return_value=DummyInitResult(instructions))
            self.get_server_capabilities = MagicMock(return_value=None)
            # Context manager methods
            self.__aenter__ = AsyncMock(return_value=self)
            self.__aexit__ = AsyncMock(return_value=None)

    class DummyTransportCM:
        def __init__(self, session):
            self.session = session
            self.__aenter__ = AsyncMock(return_value=(None, None))
            self.__aexit__ = AsyncMock(return_value=None)

    def dummy_transport_callable():
        # Return a context manager that yields dummy streams (not used)
        return DummyTransportCM(DummySession("Test instructions from server"))

    # Patch the ClientSession inside MCPClient to return our DummySession
    # But we cannot patch here without unittest.mock.patch, which is disallowed.
    # So we rely on the dummy_transport_callable to simulate the transport context manager.

    client = MCPClient(dummy_transport_callable)
