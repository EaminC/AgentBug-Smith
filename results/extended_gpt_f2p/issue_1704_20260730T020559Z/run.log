# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-gpt-4.1-mini/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-gpt-4.1-mini/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-gpt-4.1-mini/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Set Forge environment variables as required
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Explicitly set PYTHONPATH to /app for source imports
ENV PYTHONPATH=/app

# Copy entire repository to container
COPY . .

RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai aioredis apscheduler fastapi

# Unconditionally install the local project in editable mode
RUN pip install -e .

# Install dependencies if requirements.txt exists (safe conditional)
RUN if [ -f "requirements.txt" ]; then pip install -r requirements.txt; fi

# Install poetry dependencies if poetry.lock and pyproject.toml exist (optional)
RUN if [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry && poetry config virtualenvs.create false && poetry install --no-interaction --no-ansi; \
    fi

# Preflight check to verify core modules load correctly
RUN python -c 'import pkg_resources, pytest, aioredis; print("preflight ok")'

# The repository includes tests/ directory but no explicit test runner script.
# Tests can be run via pytest command.

