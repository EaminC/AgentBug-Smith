        # Clear any keys with this prefix before test
        keys = await self.storage._client.keys(f"{self.storage.key_prefix}*")
        if keys:
            await self.storage._client.delete(*keys)

        self.session_id = "test-session"
        self.user_id = "test-user"

    async def asyncTearDown(self):
        # Clean up keys created by test
        keys = await self.storage._client.keys(f"{self.storage.key_prefix}*")
        if keys:
            await self.storage._client.delete(*keys)

    async def test_add_message_keys_have_ttl(self):
        """
        This test verifies that when adding messages via RedisStorage (RedisMemory),
        all message keys created have a TTL set (not -1).

        Before the fix, the last message key created in add() would have TTL=-1,
        causing orphan keys.

        After the fix, all message keys should have TTL > 0.
        """
        # Compose a message
        msg = Msg(role="user", content="hello world", sender="user")

        # Add message to storage (simulate RedisMemory.add)
        # We use upsert_message which calls add internally
        await self.storage.upsert_message(self.user_id, self.session_id, msg)

        # The message list key
        message_list_key = self.storage._message_key(self.user_id, self.session_id)

        # The individual message key for this message
        message_key = self.storage._get_message_key(msg.id)

        # Check TTL for message list key
        ttl_list = await self.storage._client.ttl(message_list_key)
        # Check TTL for individual message key
        ttl_msg = await self.storage._client.ttl(message_key)

        # Assert TTLs are positive (not -1)
        self.assertGreater(ttl_list, 0, "Message list key TTL should be > 0")
        self.assertGreater(ttl_msg, 0, "Individual message key TTL should be > 0")

        # Wait a bit and check keys still exist (TTL not expired too soon)
        await asyncio.sleep(1)
        exists_list = await self.storage._client.exists(message_list_key)
        exists_msg = await self.storage._client.exists(message_key)
        self.assertEqual(exists_list, 1, "Message list key should exist")
        self.assertEqual(exists_msg, 1, "Individual message key should exist")


