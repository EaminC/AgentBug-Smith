[32m# -*- coding: utf-8 -*-
import asyncio
import time
import pytest

from agentscope.memory import RedisMemory
from agentscope.message import Msg


@pytest.mark.asyncio
async def test_redismemory_add_sets_ttl_on_all_keys():
    """
    Test that RedisMemory.add() sets TTL on all message keys immediately,
    preventing orphan keys with TTL=-1.

    This test reproduces the bug where the last message key added in a call
    to add() does not get its TTL set due to pipeline SCAN race.

    The test fails on the buggy codebase (last message key TTL == -1),
    and passes on the fixed codebase (all message keys TTL > 0).
    """
    # Configure RedisMemory with short TTL for test
    mem = RedisMemory(
        session_id="test-session",
        user_id="test-user",
        host="127.0.0.1",
        port=6379,
        password=None,
        key_prefix="test:",
        key_ttl=10,  # TTL 10 seconds
    )

    # Prepare two messages to add in one call to add()
    msg1 = Msg(role="user", content="hello 1", sender="user")
    msg2 = Msg(role="user", content="hello 2", sender="user")

    # Add both messages in one call
    await mem.add(msg1, msg2)

    # Wait a short moment to ensure Redis processes commands
    await asyncio.sleep(0.1)

    # Compose Redis keys for the messages
    key1 = mem._get_message_key(msg1.id)
    key2 = mem._get_message_key(msg2.id)

    # Check TTL for both keys
    ttl1 = await mem._client.ttl(key1)
    ttl2 = await mem._client.ttl(key2)

    # Assert TTLs are positive (key expires)
    assert ttl1 > 0, f"TTL for first message key {key1} is not set properly: {ttl1}"
    assert ttl2 > 0, f"TTL for second message key {key2} is not set properly: {ttl2}"

    # Also check the session messages list key TTL is set
    list_key = mem._message_key(mem.user_id, mem.session_id)
    ttl_list = await mem._client.ttl(list_key)
    assert ttl_list > 0, f"TTL for message list key {list_key} is not set properly: {ttl_list}"

    # Cleanup keys after test
    await mem._client.delete(key1, key2, list_key)[0m
