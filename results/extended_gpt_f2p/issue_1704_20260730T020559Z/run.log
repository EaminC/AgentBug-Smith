# This test verifies that RedisMemory.add() sets TTL on all message keys, preventing orphan keys.
# It fails on the buggy codebase and passes after the fix is applied.

import asyncio
import time

from agentscope.memory import RedisMemory
from agentscope.message import Msg


async def test_redismemory_add_sets_ttl_on_all_msg_keys():
    """
    This test creates a RedisMemory instance with a short TTL,
    adds multiple messages, and verifies that all message keys have TTL > 0.
    On the buggy codebase, the last message key will have TTL = -1 (no expire),
    causing this test to fail.
    After the fix, all keys have TTL > 0 and the test passes.
    """
    # Use a unique session and user id to avoid collisions
    session_id = f"test-session-{int(time.time()*1000)}"
    user_id = f"test-user-{int(time.time()*1000)}"

    mem = RedisMemory(
        session_id=session_id,
        user_id=user_id,
        host="127.0.0.1",
        port=6379,
        password=None,
        key_prefix="test:",
        key_ttl=10,  # TTL 10 seconds
    )

    # Prepare multiple messages to add
    msgs = [Msg("user", f"hello {i}", f"user-{i}") for i in range(3)]

    # Add messages
    await mem.add(msgs)

    # Wait briefly to ensure Redis processed commands
    await asyncio.sleep(0.1)

    # The session messages list key should have TTL > 0
    session_key = mem._get_session_key()
    ttl_session = await mem._client.ttl(session_key)
    assert ttl_session > 0, f"Session key TTL should be > 0 but got {ttl_session}"

    # Each message key should have TTL > 0
    for m in msgs:
        msg_key = mem._get_message_key(m.id)
        ttl_msg = await mem._client.ttl(msg_key)
        assert ttl_msg > 0, f"Message key {msg_key} TTL should be > 0 but got {ttl_msg}"

    # Cleanup keys to avoid polluting Redis
    keys_to_delete = [session_key] + [mem._get_message_key(m.id) for m in msgs]
