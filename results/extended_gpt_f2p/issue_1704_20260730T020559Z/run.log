[32mimport asyncio
import time
import pytest

from src.agentscope.app.storage._redis_storage import RedisStorage
from agentscope.message import Msg


@pytest.mark.asyncio
async def test_redismemory_add_sets_ttl_on_all_msg_keys():
    """
    This test verifies that when adding messages to RedisMemory (RedisStorage),
    all message keys created have a TTL set (i.e., they expire), preventing
    orphan keys with TTL=-1.

    The buggy implementation pipelines SET commands and then runs SCAN before
    pipeline execution, so the last message key created in add() never gets a TTL.

    The fixed implementation sets EXPIRE immediately after each SET in the pipeline.

    This test will fail on the buggy codebase (TTL of last message key is -1),
    and pass after the fix (TTL > 0).
    """
    # Setup RedisStorage with a real Redis client (fakeredis or real Redis)
    # Here we use fakeredis to avoid external dependencies
    import fakeredis.aioredis

    storage = RedisStorage.__new__(RedisStorage)
    storage._client = fakeredis.aioredis.FakeRedis(decode_responses=True)
    storage.key_ttl = 10  # TTL 10 seconds for testing
    # Setup minimal required attributes for key formatting
    storage._key_prefix = "test:"
    storage._user_id = "test-user"
    storage._session_id = "test-session"

    # Patch internal key formatting methods to match RedisMemory keys
    def _get_message_key(msg_id: str) -> str:
        # Matches key pattern for messages
        return f"test:user_id:{storage._user_id}:session:{storage._session_id}:msg:{msg_id}"

    def _message_key(user_id: str, session_id: str) -> str:
        # Key for the list of message IDs in the session
        return f"test:user_id:{user_id}:session:{session_id}:messages"

    storage._get_message_key = _get_message_key
    storage._message_key = _message_key

    # Create two messages to add
    msg1 = Msg(role="user", content="hello 1", sender="user")
    msg2 = Msg(role="user", content="hello 2", sender="user")

    # Add first message
    await storage.add([msg1])

    # Immediately check TTL of the message key for msg1
    ttl1 = await storage._client.ttl(storage._get_message_key(msg1.id))
    # TTL should be positive (not -1)
    assert ttl1 > 0, f"TTL for first message key is not set, got {ttl1}"

    # Add second message
    await storage.add([msg2])

    # Check TTL of the message key for msg2
    ttl2 = await storage._client.ttl(storage._get_message_key(msg2.id))
    # TTL should be positive (not -1)
    assert ttl2 > 0, f"TTL for second message key is not set, got {ttl2}"

    # Also check the session messages list key TTL is set
    list_key = storage._message_key(storage._user_id, storage._session_id)
    list_ttl = await storage._client.ttl(list_key)
    assert list_ttl > 0, f"TTL for message list key is not set, got {list_ttl}"

    # Wait a bit and check keys still exist (not expired prematurely)
    await asyncio.sleep(1)
    exists1 = await storage._client.exists(storage._get_message_key(msg1.id))
    exists2 = await storage._client.exists(storage._get_message_key(msg2.id))
    exists_list = await storage._client.exists(list_key)
    assert exists1 == 1, "First message key unexpectedly expired"
    assert exists2 == 1, "Second message key unexpectedly expired"
    assert exists_list == 1, "Message list key unexpectedly expired"


@pytest.mark.asyncio
async def test_redismemory_add_multiple_messages_all_have_ttl():
    """
    Test adding multiple messages in one call sets TTL on all message keys.
    This covers the pipeline case where multiple SETs happen before SCAN.
    """
    import fakeredis.aioredis

    storage = RedisStorage.__new__(RedisStorage)
    storage._client = fakeredis.aioredis.FakeRedis(decode_responses=True)
    storage.key_ttl = 15
    storage._key_prefix = "test:"
    storage._user_id = "test-user"
    storage._session_id = "test-session"

    def _get_message_key(msg_id: str) -> str:
        return f"test:user_id:{storage._user_id}:session:{storage._session_id}:msg:{msg_id}"

    storage._get_message_key = _get_message_key

    # Create 5 messages
    messages = [Msg(role="user", content=f"msg {i}", sender="user") for i in range(5)]

    # Add all messages at once
    await storage.add(messages)

    # Check TTL on all message keys
    for m in messages:
        ttl = await storage._client.ttl(storage._get_message_key(m.id))
        assert ttl > 0, f"TTL not set for message key {m.id}, got {ttl}"


