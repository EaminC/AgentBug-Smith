[32mimport asyncio
import time
import pytest

from agentscope.memory import RedisMemory
from agentscope.message import Msg


@pytest.mark.asyncio
async def test_redismemory_add_sets_ttl_on_all_keys():
    """
    Regression test for issue #1704:
    RedisMemory.add() should set TTL on all message keys immediately,
    not leak keys with TTL=-1 due to pipeline SCAN race condition.

    This test will fail on the buggy codebase because the last message key
    added in each add() call will have TTL=-1 (no expiration).
    After the fix, all keys will have TTL > 0.
    """
    # Use a very short TTL for test speed
    key_ttl = 5

    mem = RedisMemory(
        session_id="test-session-1704",
        user_id="test-user-1704",
        host="127.0.0.1",
        port=6379,
        password=None,
        key_prefix="test1704:",
        key_ttl=key_ttl,
    )

    # Prepare multiple messages to add
    messages = [
        Msg(role="user", content="hello 1", sender="user"),
        Msg(role="assistant", content="hello 2", sender="bot"),
        Msg(role="user", content="hello 3", sender="user"),
    ]

    # Add all messages in one call to RedisMemory.add()
    await mem.add(*messages)

    # Wait a short moment to ensure Redis processes commands
    await asyncio.sleep(0.1)

    # Check TTL of each message key created
    # The keys are generated by mem._get_message_key(msg.id)
    # They should all have TTL > 0 (not -1)
    for msg in messages:
        key = mem._get_message_key(msg.id)
        ttl = await mem._client.ttl(key)
        assert ttl > 0, f"Key {key} has TTL={ttl}, expected > 0"

    # Also check the session messages list key TTL is set
    session_key = mem._message_key(mem.user_id, mem.session_id)
    session_ttl = await mem._client.ttl(session_key)
    assert session_ttl > 0, f"Session message list key TTL={session_ttl}, expected > 0"

    # Cleanup keys after test
    keys_to_delete = [mem._get_message_key(m.id) for m in messages] + [session_key]
    await mem._client.delete(*keys_to_delete)


if __name__ == "__main__":
    # Run the test standalone if desired
    asyncio.run(test_redismemory_add_sets_ttl_on_all_keys())[0m
