@pytest.mark.asyncio
async def test_redismemory_add_sets_ttl_on_all_keys():
    """
    This test verifies that when messages are added to RedisMemory (via RedisStorage here),
    all message keys have a TTL set, not just the session list key.

    Buggy behavior:
        The last message key created in each add() call never gets a TTL set,
        causing orphan keys with TTL=-1.

    Fixed behavior:
        All keys created by add() have TTL set.
    """
    # Setup RedisStorage with fakeredis for isolated testing
    # This uses the real RedisStorage class but with a fake Redis client
    storage = RedisStorage.__new__(RedisStorage)
    import fakeredis.aioredis
    storage._client = fakeredis.aioredis.FakeRedis(decode_responses=True)
    storage.key_ttl = 10  # TTL 10 seconds for testing

    user_id = "test-user"
    session_id = "test-session"

    # Create a test message
    msg = Msg(role="user", content="hello", sender="user")

    # Add the message to storage (simulates RedisMemory.add)
    # This calls upsert_message internally which should set TTLs properly
    await storage.upsert_message(user_id, session_id, msg)

    # Wait a short moment to ensure Redis processes commands
    await asyncio.sleep(0.1)

    # Check TTL for the session message list key
    session_key = storage._message_key(user_id, session_id)
    ttl_session = await storage._client.ttl(session_key)
    assert ttl_session is not None and ttl_session > 0, (
        f"Session message list key TTL should be > 0 but got {ttl_session}"
    )

    # Check TTL for the individual message key(s)
    # The message keys are stored as separate keys with pattern:
    # {prefix}:user_id:{user_id}:session:{session_id}:msg:{msg.id}
    msg_key = storage._get_message_key(msg.id)
    ttl_msg = await storage._client.ttl(msg_key)
    assert ttl_msg is not None and ttl_msg > 0, (
        f"Message key TTL should be > 0 but got {ttl_msg}"
    )

    # Add a second message to verify multiple keys get TTL
    msg2 = Msg(role="user", content="second message", sender="user")
    await storage.upsert_message(user_id, session_id, msg2)
    await asyncio.sleep(0.1)

    msg2_key = storage._get_message_key(msg2.id)
    ttl_msg2 = await storage._client.ttl(msg2_key)
    assert ttl_msg2 is not None and ttl_msg2 > 0, (
        f"Second message key TTL should be > 0 but got {ttl_msg2}"
    )

    # Also verify the session list TTL is refreshed after adding second message
    ttl_session2 = await storage._client.ttl(session_key)
    assert ttl_session2 is not None and ttl_session2 > 0, (
        f"Session message list key TTL after second message should be > 0 but got {ttl_session2}"
    )

    # Now forcibly remove TTL from one message key to simulate orphan key
    await storage._client.persist(msg_key)
    ttl_msg_no_ttl = await storage._client.ttl(msg_key)
    assert ttl_msg_no_ttl == -1, "TTL should be -1 after persist"

    # Add another message to trigger TTL refresh on existing keys
    msg3 = Msg(role="user", content="third message", sender="user")
    await storage.upsert_message(user_id, session_id, msg3)
    await asyncio.sleep(0.1)

    # TTL for previously persisted key should be restored > 0
    ttl_msg_restored = await storage._client.ttl(msg_key)
    assert ttl_msg_restored is not None and ttl_msg_restored > 0, (
        f"TTL for previously persisted message key should be restored > 0 but got {ttl_msg_restored}"
    )


