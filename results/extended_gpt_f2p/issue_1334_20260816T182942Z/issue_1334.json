      "title": "fix(mcp): prevent agent hang by checking session closure state",
      "url": "https://github.com/strands-agents/harness-sdk/pull/1396",
      "merged": true,
      "base_branch": "main",
      "base_sha": "033574bf7b77a13387fb8a2fcff8202e52453289",
      "head_sha": "2a5dd5d5b6c83dc600eefd6086a0c84c30f110bd",
      "patch": "diff --git a/src/strands/tools/mcp/mcp_client.py b/src/strands/tools/mcp/mcp_client.py\nindex 6ce591bc51..fed635fbc3 100644\n--- a/src/strands/tools/mcp/mcp_client.py\n+++ b/src/strands/tools/mcp/mcp_client.py\n@@ -801,4 +801,10 @@ def _matches_patterns(self, tool: MCPAgentTool, patterns: list[_ToolMatcher]) ->\n         return False\n \n     def _is_session_active(self) -> bool:\n-        return self._background_thread is not None and self._background_thread.is_alive()\n+        if self._background_thread is None or not self._background_thread.is_alive():\n+            return False\n+\n+        if self._close_future is not None and self._close_future.done():\n+            return False\n+\n+        return True\n",
      "test_paths_in_patch": []
    }
