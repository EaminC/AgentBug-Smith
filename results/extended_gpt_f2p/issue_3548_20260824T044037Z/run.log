import pytest


# We import the MockedModelProvider from the existing test fixtures in the repo.
from strands.tests.fixtures.mocked_model_provider import MockedModelProvider


def tool_use_message(name: str, tool_use_id: str = "tool-1", tool_input: dict | None = None) -> dict:
    return {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": tool_use_id, "name": name, "input": tool_input or {}}}],
    }


def text_message(text: str) -> dict:
    return {"role": "assistant", "content": [{"text": text}]}


class TestRiskGateClassifierFail2Pass:
    """Fail2pass test for the new RiskGate vended intervention handler feature.

    This test verifies that the HumanInTheLoop intervention with the classifier option
    correctly interrupts risky tool calls and allows safe ones, and that allowed_tools
    bypass the classifier. The test fails on the buggy codebase (missing classifier logic)
    and passes after applying the patch that adds classifier support.
    """

    def test_classifier_interrupts_risky_tool(self):
        executed = []

        @tool(name="delete_file")
        def delete_file() -> str:
            executed.append(True)
            return "deleted"

        # Mocked model provider simulates the LLM model responses
        model = MockedModelProvider(
            [tool_use_message("delete_file", tool_input={"path": "/data"}), text_message("Done")]
        )

        # Provide a classifier that marks delete_file as requiring approval
        def classifier(event, **kwargs):
            if event.tool_use["name"] == "delete_file":
                return ClassifierResult(requires_human_in_the_loop=True, reason="destructive operation")
            return ClassifierResult(requires_human_in_the_loop=False)

        agent = Agent(
            model=model,
            tools=[delete_file],
            interventions=[HumanInTheLoop(classifier=classifier)],
        )

        result = agent("Delete the file")

        # Should interrupt for approval, no tool executed yet
        assert result.stop_reason == "interrupt"
        assert executed == []
        assert any("destructive operation" in interrupt.reason for interrupt in result.interrupts)

    def test_classifier_allows_safe_tool(self):
        executed = []

        @tool(name="read_file")
        def read_file() -> str:
            executed.append(True)
            return "content"

        model = MockedModelProvider(
            [tool_use_message("read_file", tool_input={"path": "/tmp/x"}), text_message("Done")]
        )

        def classifier(event, **kwargs):
            if event.tool_use["name"] == "read_file":
                return ClassifierResult(requires_human_in_the_loop=False, reason="read-only operation")
            return ClassifierResult(requires_human_in_the_loop=True)

        agent = Agent(
            model=model,
            tools=[read_file],
            interventions=[HumanInTheLoop(classifier=classifier)],
        )

        result = agent("Read the file")

        # Should proceed without interrupt, tool executed
        assert result.stop_reason == "end_turn"
        assert executed == [True]

    def test_allowed_tools_bypass_classifier(self):
        executed = []

        @tool(name="read_file")
        def read_file() -> str:
            executed.append(True)
            return "content"

        model = MockedModelProvider([tool_use_message("read_file"), text_message("Done")])

        # Classifier that would require approval for all tools, but allowed_tools bypass it
        def classifier(event, **kwargs):
            return ClassifierResult(requires_human_in_the_loop=True, reason="should not be called")

        agent = Agent(
            model=model,
            tools=[read_file],
            interventions=[HumanInTheLoop(allowed_tools=["read_file"], classifier=classifier)],
        )

        result = agent("Read")

        # Should run tool freely, classifier not called
        assert result.stop_reason == "end_turn"
        assert executed == [True]

    def test_custom_async_classifier_interrupts(self):
        executed = []

        @tool(name="deploy")
        def deploy() -> str:
            executed.append(True)
            return "deployed"

        model = MockedModelProvider(
            [tool_use_message("deploy", tool_input={"env": "prod"}), text_message("Done")]
        )

        async def async_classifier(event, **kwargs):
            return ClassifierResult(requires_human_in_the_loop=True, reason="async approval required")

        agent = Agent(
            model=model,
            tools=[deploy],
            interventions=[HumanInTheLoop(classifier=async_classifier)],
        )

        result = agent("Deploy")

        # Should interrupt for approval, no tool executed yet
        assert result.stop_reason == "interrupt"
        assert executed == []

    def test_classifier_reason_in_prompt(self):
        prompts = []

        @tool(name="send_email")
        def send_email() -> str:
            return "sent"

        model = MockedModelProvider(
            [tool_use_message("send_email", tool_input={"to": "all@co.com"}), text_message("Done")]
        )

        def classifier(event, **kwargs):
            return ClassifierResult(requires_human_in_the_loop=True, reason="external communication")

        def capture_ask(prompt, **kwargs):
            prompts.append(prompt)
            return "no"

        agent = Agent(
            model=model,
            tools=[send_email],
            interventions=[HumanInTheLoop(classifier=classifier, ask=capture_ask)],
        )

        agent("Send email")

        # The prompt should include the reason and tool name
        assert any("external communication" in p and "send_email" in p for p in prompts)

    def test_classifier_fails_closed_on_exception(self):
        executed = []

        @tool(name="my_tool")
        def my_tool() -> str:
            executed.append(True)
            return "ran"

        def broken_classifier(event, **kwargs):
            raise RuntimeError("model down")

        model = MockedModelProvider([tool_use_message("my_tool"), text_message("Done")])

        agent = Agent(
            model=model,
            tools=[my_tool],
            interventions=[HumanInTheLoop(classifier=broken_classifier)],
        )

        result = agent("Go")

        # Should interrupt due to classifier failure, no tool executed
        assert result.stop_reason == "interrupt"
        assert executed == []

    def test_classifier_malformed_result_fails_closed(self):
        executed = []

        @tool(name="my_tool")
        def my_tool() -> str:
            executed.append(True)
            return "ran"

        class BadResult:
            requires_human_in_the_loop = None

        def bad_classifier(event, **kwargs):
            return BadResult()

        model = MockedModelProvider([tool_use_message("my_tool"), text_message("Done")])

        agent = Agent(
            model=model,
            tools=[my_tool],
            interventions=[HumanInTheLoop(classifier=bad_classifier)],
        )

        result = agent("Go")

        # Should interrupt due to malformed classifier result, no tool executed
        assert result.stop_reason == "interrupt"
        assert executed == []

    def test_trust_removes_classifier_for_tool(self):
        executed = []

        @tool(name="dangerous_tool")
        def dangerous_tool() -> str:
            executed.append(True)
            return "ran"

        model = MockedModelProvider(
            [
                tool_use_message("dangerous_tool", tool_use_id="tool-1"),
                tool_use_message("dangerous_tool", tool_use_id="tool-2"),
                text_message("Done"),
            ]
        )

        call_count = []

        def classifier(event, **kwargs):
            call_count.append(1)
            return ClassifierResult(requires_human_in_the_loop=True, reason="risky")

        def ask(prompt, **kwargs):
            # Approve and trust on first ask
            return "t"

        agent = Agent(
            model=model,
            tools=[dangerous_tool],
            interventions=[HumanInTheLoop(classifier=classifier, enable_trust=True, ask=ask)],
        )

        # First call triggers interrupt and ask, then trust remembers tool
        result = agent("Run dangerous tool")
        assert result.stop_reason == "end_turn"
        assert executed == [True]
        assert len(call_count) == 1

        # Second call should not interrupt (trusted), classifier not called again
        result = agent("Run dangerous tool again")
        assert result.stop_reason == "end_turn"
        assert executed == [True, True]
        assert len(call_count) == 1

        # Confirm trusted tools state includes the tool name
        assert dangerous_tool.__name__ not in agent.state.get(_TRUSTED_TOOLS_KEY, [])
        # The trusted tools key stores tool names, not function names, so check for tool name string
        assert "dangerous_tool" in agent.state.get(_TRUSTED_TOOLS_KEY, [])


