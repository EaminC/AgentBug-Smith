        def mock_classifier(event, **kwargs):
            return ClassifierResult(requires_human_in_the_loop=True, reason="external communication")

        def capture_ask(prompt, **kwargs):
            prompts.append(prompt)
            return "no"

        agent = Agent(
            model=agent_model,
            tools=[send_email],
            interventions=[HumanInTheLoop(classifier=mock_classifier, ask=capture_ask)],
        )

        agent("Send email")

        assert "external communication" in prompts[0]
        assert "send_email" in prompts[0]

