            exec_log.append("delete")
            return "deleted"

        model = MockedModelProvider(
            [
                {
                    "role": "assistant",
                    "content": [
                        {"toolUse": {"toolUseId": "tool-1", "name": "read_file", "input": {}}},
                        {"toolUse": {"toolUseId": "tool-2", "name": "delete_file", "input": {}}},
                    ],
                },
                text_message("Done"),
            ]
        )
        agent = Agent(
            model=model,
