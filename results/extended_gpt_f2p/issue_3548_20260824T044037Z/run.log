        agent_model = MockedModelProvider([tool_use_message("my_tool"), text_message("Done")])
        agent = Agent(
            model=agent_model,
            tools=[my_tool],
            interventions=[HumanInTheLoop(classifier=broken_classifier)],
        )

        result = agent("Go")

