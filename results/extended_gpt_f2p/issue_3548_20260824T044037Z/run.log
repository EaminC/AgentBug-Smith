from strands import Agent
from strands.tools import tool
from strands.vended_interventions.hitl import HumanInTheLoop
from strands.vended_interventions.hitl.classifier import ClassifierResult

# We cannot import tests.fixtures.mocked_model_provider because it does not exist in the repo root.
# Instead, we define a minimal MockedModelProvider here to simulate the model behavior for testing.
# This mock returns predefined messages in sequence for agent model calls.

class MockedModelProvider:
    def __init__(self, messages):
        self._messages = messages
        self._index = 0

    async def __call__(self, prompt, **kwargs):
        # Return the next message in the sequence as the model response
        if self._index < len(self._messages):
            response = self._messages[self._index]
            self._index += 1
            return response
        return {"role": "assistant", "content": [{"text": "Done"}]}

    def __await__(self):
        # Support await syntax for compatibility
        async def dummy():
            return {"role": "assistant", "content": [{"text": "Done"}]}
        return dummy().__await__()

def tool_use_message(name: str, tool_use_id: str = "tool-1", tool_input: dict | None = None) -> dict:
    return {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": tool_use_id, "name": name, "input": tool_input or {}}}],
    }

def text_message(text: str) -> dict:
    return {"role": "assistant", "content": [{"text": text}]}

class TestRiskGateClassifierFail2Pass:
    def test_classifier_true_interrupts_when_risky(self):
        executed = []

        @tool(name="delete_file")
        def delete_file() -> str:
            executed.append(True)
            return "deleted"

        # Mock classifier that always requires human approval for delete_file
        def mock_classifier(event, **kwargs):
            return ClassifierResult(requires_human_in_the_loop=True, reason="destructive operation")

        model = MockedModelProvider(
            [tool_use_message("delete_file", tool_input={"path": "/data"}), text_message("Done")]
        )

        agent = Agent(
            model=model,
            tools=[delete_file],
            interventions=[HumanInTheLoop(classifier=mock_classifier)],
        )

        result = agent("Delete the file")

        # Should interrupt because classifier says approval required
        assert result.stop_reason == "interrupt"
        # Tool should not have executed yet
        assert executed == []
        # Interrupt reason should include the classifier reason
        assert any("destructive operation" in interrupt.reason for interrupt in result.interrupts)

    def test_classifier_allows_tool_when_not_risky(self):
        executed = []

        @tool(name="read_file")
        def read_file() -> str:
            executed.append(True)
            return "content"

        # Mock classifier that never requires approval for read_file
        def mock_classifier(event, **kwargs):
            return ClassifierResult(requires_human_in_the_loop=False, reason="read-only operation")

        model = MockedModelProvider(
            [tool_use_message("read_file", tool_input={"path": "/tmp/x"}), text_message("Done")]
        )

        agent = Agent(
            model=model,
            tools=[read_file],
            interventions=[HumanInTheLoop(classifier=mock_classifier)],
        )

        result = agent("Read the file")

        # Should proceed without interrupt
        assert result.stop_reason == "end_turn"
        # Tool should have executed
        assert executed == [True]

    def test_allowed_tools_bypasses_classifier(self):
        executed = []

        @tool(name="read_file")
        def read_file() -> str:
            executed.append(True)
            return "content"

        # Classifier that would require approval, but allowed_tools bypasses it
        def mock_classifier(event, **kwargs):
            raise AssertionError("Classifier should not be called when allowed_tools bypasses")

        model = MockedModelProvider([tool_use_message("read_file"), text_message("Done")])

        agent = Agent(
            model=model,
            tools=[read_file],
            interventions=[HumanInTheLoop(allowed_tools=["read_file"], classifier=mock_classifier)],
        )

        result = agent("Read")

        # Should proceed without interrupt
        assert result.stop_reason == "end_turn"
        # Tool should have executed
        assert executed == [True]

    def test_custom_classifier_function(self):
        executed = []

        @tool(name="deploy")
        def deploy() -> str:
            executed.append(True)
            return "deployed"

        model = MockedModelProvider(
            [tool_use_message("deploy", tool_input={"env": "prod"}), text_message("Done")]
        )

        def my_classifier(event, **kwargs):
            return ClassifierResult(
                requires_human_in_the_loop=event.tool_use["name"] == "deploy",
                reason="deployment requires approval",
            )

        agent = Agent(
            model=model,
            tools=[deploy],
            interventions=[HumanInTheLoop(classifier=my_classifier)],
        )

        result = agent("Deploy")

        # Should interrupt because classifier says approval required
        assert result.stop_reason == "interrupt"
        # Tool should not have executed yet
        assert executed == []

    def test_classifier_reason_appears_in_prompt(self):
        prompts = []

        @tool(name="send_email")
        def send_email() -> str:
            return "sent"

        model = MockedModelProvider(
            [tool_use_message("send_email", tool_input={"to": "all@co.com"}), text_message("Done")]
        )

        def mock_classifier(event, **kwargs):
            return ClassifierResult(requires_human_in_the_loop=True, reason="external communication")

        def capture_ask(prompt, **kwargs):
            prompts.append(prompt)
            return "no"

        agent = Agent(
            model=model,
            tools=[send_email],
            interventions=[HumanInTheLoop(classifier=mock_classifier, ask=capture_ask)],
        )

        agent("Send email")

        # The prompt should include the reason from the classifier and the tool name
        assert any("external communication" in p and "send_email" in p for p in prompts)

