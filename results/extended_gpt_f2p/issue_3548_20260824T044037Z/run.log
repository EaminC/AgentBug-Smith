[32mimport pytest
import asyncio

from strands import Agent
from strands.tools import tool
from strands.vended_interventions.hitl import HumanInTheLoop
from strands.vended_interventions.hitl.classifier import ClassifierResult
from tests.fixtures.mocked_model_provider import MockedModelProvider


def tool_use_message(name: str, tool_use_id: str = "tool-1", tool_input: dict | None = None) -> dict:
    return {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": tool_use_id, "name": name, "input": tool_input or {}}}],
    }


def text_message(text: str) -> dict:
    return {"role": "assistant", "content": [{"text": text}]}


class TestRiskGateClassifierFail2Pass:
    """Fail2pass tests for the RiskGate-like LLM classifier integration in HumanInTheLoop."""

    def test_classifier_true_interrupts_when_risky(self):
        executed = []

        @tool(name="delete_file")
        def delete_file() -> str:
            executed.append(True)
            return "deleted"

        # Mocked model provider with minimal messages
        agent_model = MockedModelProvider(
            [tool_use_message("delete_file", tool_input={"path": "/data"}), text_message("Done")]
        )

        # Classifier that always requires approval (risky)
        def risky_classifier(event, **kwargs):
            return ClassifierResult(requires_human_in_the_loop=True, reason="destructive operation")

        agent = Agent(
            model=agent_model,
            tools=[delete_file],
            interventions=[HumanInTheLoop(classifier=risky_classifier)],
        )

        result = agent("Delete the file")

        # Should interrupt and not execute tool
        assert result.stop_reason == "interrupt"
        assert executed == []
        assert any("destructive operation" in intr.reason for intr in result.interrupts)

    def test_classifier_allows_tool_when_not_risky(self):
        executed = []

        @tool(name="read_file")
        def read_file() -> str:
            executed.append(True)
            return "content"

        agent_model = MockedModelProvider(
            [tool_use_message("read_file", tool_input={"path": "/tmp/x"}), text_message("Done")]
        )

        # Classifier that never requires approval (safe)
        def safe_classifier(event, **kwargs):
            return ClassifierResult(requires_human_in_the_loop=False, reason="read-only operation")

        agent = Agent(
            model=agent_model,
            tools=[read_file],
            interventions=[HumanInTheLoop(classifier=safe_classifier)],
        )

        result = agent("Read the file")

        # Should run tool without interruption
        assert result.stop_reason == "end_turn"
        assert executed == [True]

    def test_allowed_tools_bypasses_classifier(self):
        executed = []

        @tool(name="read_file")
        def read_file() -> str:
            executed.append(True)
            return "content"

        agent_model = MockedModelProvider([tool_use_message("read_file"), text_message("Done")])

        # Classifier that would require approval if called
        def classifier_should_not_be_called(event, **kwargs):
            pytest.fail("Classifier should not be called for allowed tools")

        agent = Agent(
            model=agent_model,
            tools=[read_file],
            interventions=[HumanInTheLoop(allowed_tools=["read_file"], classifier=classifier_should_not_be_called)],
        )

        result = agent("Read")

        # Should run tool without interruption and classifier not called
        assert result.stop_reason == "end_turn"
        assert executed == [True]

    def test_custom_classifier_function(self):
        executed = []

        @tool(name="deploy")
        def deploy() -> str:
            executed.append(True)
            return "deployed"

        agent_model = MockedModelProvider(
            [tool_use_message("deploy", tool_input={"env": "prod"}), text_message("Done")]
        )

        def my_classifier(event, **kwargs):
            return ClassifierResult(
                requires_human_in_the_loop=event.tool_use["name"] == "deploy",
                reason="deployment requires approval",
            )

        agent = Agent(
            model=agent_model,
            tools=[deploy],
            interventions=[HumanInTheLoop(classifier=my_classifier)],
        )

        result = agent("Deploy")

        # Should interrupt and not execute tool
        assert result.stop_reason == "interrupt"
        assert executed == []

    def test_classifier_reason_appears_in_prompt(self):
        prompts = []

        @tool(name="send_email")
        def send_email() -> str:
            return "sent"

        agent_model = MockedModelProvider(
            [tool_use_message("send_email", tool_input={"to": "all@co.com"}), text_message("Done")]
        )

        def classifier(event, **kwargs):
            return ClassifierResult(requires_human_in_the_loop=True, reason="external communication")

        def capture_ask(prompt, **kwargs):
            prompts.append(prompt)
            return "no"

        agent = Agent(
            model=agent_model,
            tools=[send_email],
            interventions=[HumanInTheLoop(classifier=classifier, ask=capture_ask)],
        )

        agent("Send email")

        # The prompt should include the reason and tool name
        assert any("external communication" in p for p in prompts)
        assert any("send_email" in p for p in prompts)

    @pytest.mark.asyncio
    async def test_async_custom_classifier(self):
        executed = []

        @tool(name="deploy")
        def deploy() -> str:
            executed.append(True)
            return "deployed"

        agent_model = MockedModelProvider(
            [tool_use_message("deploy", tool_input={"env": "prod"}), text_message("Done")]
        )

        async def async_classifier(event, **kwargs):
            return ClassifierResult(
                requires_human_in_the_loop=True,
                reason="async classifier says no",
            )

        agent = Agent(
            model=agent_model,
            tools=[deploy],
            interventions=[HumanInTheLoop(classifier=async_classifier)],
        )

        result = agent("Deploy")

        # Should interrupt and not execute tool
        assert result.stop_reason == "interrupt"
        assert executed == []

