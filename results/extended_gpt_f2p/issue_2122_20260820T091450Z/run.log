        {"role": "user", "content": [{"text": "First question"}]},
        {"role": "assistant", "content": [{"text": "Response"}]},
        {"role": "user", "content": [{"text": "Second question"}]},
    ]

    assert model._find_last_user_text_message_index(messages) == 2


