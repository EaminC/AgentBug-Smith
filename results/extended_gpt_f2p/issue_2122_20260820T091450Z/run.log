import pytest
from strands import Agent, tool
from strands.models import BedrockModel


@tool
def list_tables_empty_content() -> dict:
    """Tool that returns empty content list, simulating MCP tool with no results."""
    return {
        "status": "success",
        "content": [],
    }


@tool
def list_tables_nonempty_content() -> dict:
    """Tool that returns non-empty content list."""
    return {
        "status": "success",
        "content": [{"text": "table1"}, {"text": "table2"}],
    }


def test_nemotron_agent_fails_on_empty_tool_result_content():
    """Test that Nemotron model fails on empty toolResult content before fix, passes after fix.

    This test runs the Agent with a tool that returns empty content list.
    Before the fix, Nemotron model raises ValidationException due to empty content array.
    After the fix, the empty content is normalized to [{'text': ''}] and the call succeeds.

    The test expects failure on buggy codebase and success on fixed codebase.
    """
    agent = Agent(
        model=BedrockModel(model_id="nvidia.nemotron-super-3-120b", streaming=False),
        tools=[list_tables_empty_content],
    )
    # The call should raise an exception on buggy codebase (fail)
    # After fix, it should succeed (pass)
    # We test that the result is a non-empty string response (agent returns string)
    with pytest.raises(Exception):
        _ = agent("What tables are in the database?")


def test_claude_agent_succeeds_on_empty_tool_result_content():
    """Test that Claude model succeeds on empty toolResult content (control)."""
    agent = Agent(
        model=BedrockModel(model_id="us.anthropic.claude-sonnet-4-5-20250929-v1:0", streaming=False),
        tools=[list_tables_empty_content],
    )
    result = agent("What tables are in the database?")
    assert isinstance(result, str)
    assert len(result) > 0


def test_nemotron_agent_succeeds_on_nonempty_tool_result_content():
    """Test that Nemotron model succeeds on non-empty toolResult content."""
    agent = Agent(
        model=BedrockModel(model_id="nvidia.nemotron-super-3-120b", streaming=False),
        tools=[list_tables_nonempty_content],
    )
    result = agent("What tables are in the database?")
    assert isinstance(result, str)
    assert len(result) > 0


def test_claude_agent_succeeds_on_nonempty_tool_result_content():
    """Test that Claude model succeeds on non-empty toolResult content."""
    agent = Agent(
        model=BedrockModel(model_id="us.anthropic.claude-sonnet-4-5-20250929-v1:0", streaming=False),
        tools=[list_tables_nonempty_content],
    )
    result = agent("What tables are in the database?")
