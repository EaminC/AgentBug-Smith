[32mimport pytest
from strands.session.s3_session_manager import S3SessionManager
from strands.types.content import ContentBlock
from strands.types.session import Session, SessionAgent, SessionMessage, SessionType


def test_list_messages_parallel_behavior(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent):
    """
    Test that S3SessionManager.list_messages retrieves messages in parallel and preserves order.

    This test will fail on the buggy codebase (sequential retrieval),
    and pass after the fix (parallel retrieval with order preserved).
    """
    # Create session and agent
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # Create multiple messages with known content and indices
    num_messages = 10
    messages = []
    for i in range(num_messages):
        message = SessionMessage(
            {
                "role": "user",
                "content": [ContentBlock(text=f"Message {i}")],
            },
            i,
        )
        messages.append(message)
        s3_manager.create_message(sample_session.session_id, sample_agent.agent_id, message)

    # List messages using the method under test
    retrieved_messages = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id)

    # Assert that all messages are retrieved
    assert len(retrieved_messages) == num_messages

    # Assert that messages are in order by message_id
    for i, msg in enumerate(retrieved_messages):
        assert msg.message_id == i
        assert msg.message["content"][0]["text"] == f"Message {i}"


def test_list_messages_empty_returns_empty_list(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent):
    """
    Test that listing messages when none exist returns an empty list.

    This test will fail on buggy code if list_messages does not handle empty correctly,
    and pass after the fix.
    """
    # Create session and agent but do not add messages
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # List messages
    retrieved_messages = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id)

    # Assert empty list returned
    assert isinstance(retrieved_messages, list)
    assert len(retrieved_messages) == 0


def test_list_messages_pagination_and_order(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent):
    """
    Test that list_messages supports limit and offset and preserves order.

    This test will fail on buggy code if pagination or ordering is broken,
    and pass after the fix.
    """
    # Create session and agent
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # Create 20 messages
    total_messages = 20
    for i in range(total_messages):
        message = SessionMessage(
            {
                "role": "user",
                "content": [ContentBlock(text=f"Msg {i}")],
            },
            i,
        )
        s3_manager.create_message(sample_session.session_id, sample_agent.agent_id, message)

    # Test limit
    limit = 5
    limited_messages = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id, limit=limit)
    assert len(limited_messages) == limit
    for idx, msg in enumerate(limited_messages):
        assert msg.message_id == idx
        assert msg.message["content"][0]["text"] == f"Msg {idx}"

    # Test offset
    offset = 10
    offset_messages = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id, offset=offset)
    expected_count = total_messages - offset
    assert len(offset_messages) == expected_count
    for idx, msg in enumerate(offset_messages, start=offset):
        assert msg.message_id == idx
        assert msg.message["content"][0]["text"] == f"Msg {idx}"


def test_list_messages_handles_missing_message_gracefully(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent):
    """
    Test that list_messages handles missing or corrupted message objects gracefully.

    This test will fail on buggy code if exceptions are raised during parallel retrieval,
    and pass after the fix with graceful handling.
    """
    # Create session and agent
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # Create 3 messages
    for i in range(3):
        message = SessionMessage(
            {
                "role": "user",
                "content": [ContentBlock(text=f"Msg {i}")],
            },
            i,
        )
        s3_manager.create_message(sample_session.session_id, sample_agent.agent_id, message)

    # Manually delete one message object from S3 to simulate missing file
    key_to_delete = s3_manager._get_message_path(sample_session.session_id, sample_agent.agent_id, 1)
    s3_manager.client.delete_object(Bucket=s3_manager.bucket, Key=key_to_delete)

    # List messages
    retrieved_messages = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id)

    # Should retrieve 2 messages (0 and 2), skipping missing 1, without raising
    retrieved_ids = [msg.message_id for msg in retrieved_messages]
    assert 0 in retrieved_ids
    assert 2 in retrieved_ids
    assert 1 not in retrieved_ids
    assert len(retrieved_messages) == 2


