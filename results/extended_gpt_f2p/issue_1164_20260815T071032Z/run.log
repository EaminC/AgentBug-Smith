    assert len(result) == 0


def test_list_messages_pagination_and_order(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent):
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # Create 10 messages
    for i in range(10):
        message = SessionMessage(
            {
                "role": "user",
                "content": [ContentBlock(text=f"Msg {i}")],
            },
            i,
        )
        s3_manager.create_message(sample_session.session_id, sample_agent.agent_id, message)

    # Test limit
    limited = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id, limit=5)
    assert len(limited) == 5
    for i, msg in enumerate(limited):
        assert msg.message["content"][0]["text"] == f"Msg {i}"

    # Test offset
    offsetted = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id, offset=5)
    assert len(offsetted) == 5
    for i, msg in enumerate(offsetted):
        assert msg.message["content"][0]["text"] == f"Msg {i+5}"


def test_list_messages_handles_missing_message_gracefully(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent):
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # Create 3 messages
    for i in range(3):
        message = SessionMessage(
            {
                "role": "user",
                "content": [ContentBlock(text=f"Message {i}")],
            },
            i,
        )
        s3_manager.create_message(sample_session.session_id, sample_agent.agent_id, message)

    # Manually delete one message file from S3 to simulate missing message
    key_to_delete = s3_manager._get_message_path(sample_session.session_id, sample_agent.agent_id, 1)
    s3_manager.client.delete_object(Bucket=s3_manager.bucket, Key=key_to_delete)

    # List messages, should skip missing message without error
    messages = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id)

    # Should return 2 messages (0 and 2)
    assert len(messages) == 2
    message_ids = [msg.message_id for msg in messages]
    assert 1 not in message_ids
    assert 0 in message_ids
    assert 2 in message_ids


