from strands.session.s3_session_manager import S3SessionManager
from strands.types.content import ContentBlock
from strands.types.session import Session, SessionAgent, SessionMessage, SessionType


@pytest.mark.parametrize("num_messages", [1, 5, 10])
def test_list_messages_parallel_order_preserved(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent, num_messages: int):
    """
    Test that list_messages returns messages in the correct order and uses parallel fetching.
    This test will fail on the buggy codebase because the parallelization is missing or broken.
    """
    # Setup: create session and agent
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # Create multiple messages with distinct content and indices
    messages = []
    for i in range(num_messages):
        msg = SessionMessage(
            {
                "role": "user",
                "content": [ContentBlock(text=f"Message {i}")],
            },
            i,
        )
        messages.append(msg)
        s3_manager.create_message(sample_session.session_id, sample_agent.agent_id, msg)

    # Call list_messages without limit or offset
    retrieved_messages = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id)

    # Assert that all messages are returned
    assert len(retrieved_messages) == num_messages

    # Assert that messages are in the original order by message_id
    for i, msg in enumerate(retrieved_messages):
        assert msg.message["content"][0]["text"] == f"Message {i}"
        assert msg.message_id == i


def test_list_messages_with_limit_and_offset(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent):
    """
    Test that list_messages respects limit and offset parameters.
    This test will fail on buggy codebase if pagination is broken.
    """
    # Setup: create session and agent
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # Create 10 messages
    for i in range(10):
        msg = SessionMessage(
            {
                "role": "user",
                "content": [ContentBlock(text=f"Msg {i}")],
            },
            i,
        )
        s3_manager.create_message(sample_session.session_id, sample_agent.agent_id, msg)

    # Retrieve with limit=3, offset=4
    retrieved = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id, limit=3, offset=4)

    # Should return 3 messages starting from index 4
    assert len(retrieved) == 3
    for idx, msg in enumerate(retrieved, start=4):
        assert msg.message["content"][0]["text"] == f"Msg {idx}"
        assert msg.message_id == idx


