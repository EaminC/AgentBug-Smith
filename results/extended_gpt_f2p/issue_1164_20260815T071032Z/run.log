def test_list_messages_parallel_behavior(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent):
    # Create session and agent
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # Create multiple messages
    messages = []
    for i in range(10):
        message = SessionMessage(
            {
                "role": "user",
                "content": [ContentBlock(text=f"Message {i}")],
            },
            i,
        )
        messages.append(message)
        s3_manager.create_message(sample_session.session_id, sample_agent.agent_id, message)

    # Record start time
    start_time = time.time()
    result = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id)
    duration = time.time() - start_time

    # Check that all messages are returned
    assert len(result) == 10

    # Check that messages are in order by message_id
    for i, msg in enumerate(result):
        assert msg.message["content"][0]["text"] == f"Message {i}"

    # The parallel retrieval should be reasonably fast (less than 2 seconds)
    # This is a soft check, mainly to ensure parallelism is used
    assert duration < 2.0


