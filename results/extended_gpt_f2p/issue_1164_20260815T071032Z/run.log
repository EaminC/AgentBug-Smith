def test_list_messages_parallel_fetch_performance(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent):
    """
    Test that list_messages fetches messages in parallel by measuring elapsed time.
    This test will fail on buggy codebase due to sequential fetching causing longer runtime.
    """
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # Create 5 messages with artificial delay in _read_s3_object by monkeypatching
    original_read = s3_manager._read_s3_object

    def delayed_read(key):
        time.sleep(0.1)  # 100ms delay to simulate network latency
        return original_read(key)

    s3_manager._read_s3_object = delayed_read

    for i in range(5):
        msg = SessionMessage(
            {
                "role": "user",
                "content": [ContentBlock(text=f"Delayed Msg {i}")],
            },
            i,
        )
        s3_manager.create_message(sample_session.session_id, sample_agent.agent_id, msg)

    start_time = time.time()
    messages = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id)
    elapsed = time.time() - start_time

    # Restore original method
    s3_manager._read_s3_object = original_read

    # Assert all messages returned
    assert len(messages) == 5

    # If fetching is parallel, elapsed time should be less than 0.5s (5 * 0.1s sequential = 0.5s)
    # Add some margin for overhead
    assert elapsed < 0.5, f"Elapsed time too long, likely sequential fetching: {elapsed:.2f}s"


def test_list_messages_parallel_fetch_order_consistency(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent):
    """
    Test that list_messages returns messages in the correct order even if _read_s3_object returns out of order.
    This test simulates out-of-order returns by monkeypatching _read_s3_object.
    This test will fail on buggy codebase if order is not preserved.
    """
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # Create 3 messages
    for i in range(3):
        msg = SessionMessage(
            {
                "role": "user",
                "content": [ContentBlock(text=f"Msg {i}")],
            },
            i,
        )
        s3_manager.create_message(sample_session.session_id, sample_agent.agent_id, msg)

    # Save original method
    original_read = s3_manager._read_s3_object

    # Monkeypatch to return messages in reverse order regardless of key
    def reverse_order_read(key):
        # Extract index from key to determine which message to return
        # But return message with reversed index to simulate out-of-order
        # The key ends with message_id.json, extract message_id
        import re

        match = re.search(r"(\d+)\.json$", key)
        if not match:
            return None
        idx = int(match.group(1))
        reversed_idx = 2 - idx  # For 3 messages: 0->2,1->1,2->0
        # Read the reversed message data
        # Compose key for reversed index
        reversed_key = key.replace(f"{idx}.json", f"{reversed_idx}.json")
        return original_read(reversed_key)

    s3_manager._read_s3_object = reverse_order_read

    # Call list_messages
    messages = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id)

    # Restore original method
    s3_manager._read_s3_object = original_read

    # Assert messages are in correct order by message_id (0,1,2)
    for i, msg in enumerate(messages):
        assert msg.message_id == i
        assert msg.message["content"][0]["text"] == f"Msg {i}"


def test_list_messages_handles_missing_message(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent):
    """
    Test that list_messages gracefully handles missing message objects (returns only existing).
    This test simulates a missing message by deleting one after creation.
    """
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # Create 3 messages
    for i in range(3):
        msg = SessionMessage(
            {
                "role": "user",
                "content": [ContentBlock(text=f"Msg {i}")],
            },
            i,
        )
        s3_manager.create_message(sample_session.session_id, sample_agent.agent_id, msg)

    # Delete message with index 1 directly from S3
    key = s3_manager._get_message_path(sample_session.session_id, sample_agent.agent_id, 1)
    s3_manager.client.delete_object(Bucket=s3_manager.bucket, Key=key)

    # Call list_messages
    messages = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id)

    # Should return 2 messages (0 and 2)
    assert len(messages) == 2
    message_ids = [msg.message_id for msg in messages]
    assert 1 not in message_ids
    assert 0 in message_ids
    assert 2 in message_ids


def test_list_messages_parallel_threadpool_used(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent):
    """
    Test that ThreadPoolExecutor is used internally in list_messages by monkeypatching ThreadPoolExecutor.submit.
    This test will fail on buggy codebase where parallelization is not implemented.
    """
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # Create 3 messages
    for i in range(3):
        msg = SessionMessage(
            {
                "role": "user",
                "content": [ContentBlock(text=f"Msg {i}")],
            },
            i,
        )
        s3_manager.create_message(sample_session.session_id, sample_agent.agent_id, msg)

    # Patch ThreadPoolExecutor.submit to count calls
    original_submit = ThreadPoolExecutor.submit
    submit_calls = []

    def counting_submit(self, fn, *args, **kwargs):
        submit_calls.append((fn, args, kwargs))
        return original_submit(self, fn, *args, **kwargs)

    ThreadPoolExecutor.submit = counting_submit

    # Call list_messages
    try:
        _ = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id)
    finally:
        ThreadPoolExecutor.submit = original_submit

    # Assert that submit was called at least once (parallel fetching occurred)
    assert len(submit_calls) >= 1


def test_list_messages_single_message_no_threadpool(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent):
    """
    Test that for a single message, list_messages does not use ThreadPoolExecutor (optimization).
    This test will fail on buggy codebase if optimization is missing.
    """
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # Create single message
    msg = SessionMessage(
        {
            "role": "user",
            "content": [ContentBlock(text="Only message")],
        },
        0,
    )
    s3_manager.create_message(sample_session.session_id, sample_agent.agent_id, msg)

    # Patch ThreadPoolExecutor.submit to detect if called
    original_submit = ThreadPoolExecutor.submit
    submit_called = False

    def submit_flag(self, fn, *args, **kwargs):
        nonlocal submit_called
        submit_called = True
        return original_submit(self, fn, *args, **kwargs)

    ThreadPoolExecutor.submit = submit_flag

    try:
        messages = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id)
    finally:
        ThreadPoolExecutor.submit = original_submit

    # Assert only one message returned
    assert len(messages) == 1
    # Assert submit was not called (no thread pool for single message)
    assert not submit_called, "ThreadPoolExecutor.submit was called for single message, expected optimization"


def test_list_messages_with_offset_and_limit_parallel(s3_manager: S3SessionManager, sample_session: Session, sample_agent: SessionAgent):
    """
    Test list_messages with offset and limit returns correct subset and preserves order.
    """
    s3_manager.create_session(sample_session)
    s3_manager.create_agent(sample_session.session_id, sample_agent)

    # Create 10 messages
    for i in range(10):
        msg = SessionMessage(
            {
                "role": "user",
                "content": [ContentBlock(text=f"Msg {i}")],
            },
            i,
        )
        s3_manager.create_message(sample_session.session_id, sample_agent.agent_id, msg)

    # Retrieve messages with offset=3, limit=4
    retrieved = s3_manager.list_messages(sample_session.session_id, sample_agent.agent_id, limit=4, offset=3)

    # Should return messages with indices 3,4,5,6
    assert len(retrieved) == 4
    expected_indices = list(range(3, 7))
    for msg, expected_idx in zip(retrieved, expected_indices):
        assert msg.message_id == expected_idx
        assert msg.message["content"][0]["text"] == f"Msg {expected_idx}"


