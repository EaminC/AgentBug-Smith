@pytest.mark.asyncio
async def test_agent_connects_to_mcp_server_using_sse_transport():
    """
    Test that an Agent can connect to an MCP server using SSE transport.

    This test will fail on the buggy codebase due to passing an invalid argument
    to the MCP client in SSE transport, causing a RuntimeError.
    After the fix, the connection should succeed without error.
    """
    # Create an SSETransport instance with dummy URL and headers
    transport = SSETransport(
        url="http://localhost:9999/sse",
        headers={"Authorization": "Bearer test"},
    )

    # Create an Agent configured to use the SSETransport for MCP connection
    # Provide all required fields to avoid pydantic validation errors
    agent = Agent(
        name="test-agent",
        role="tester",
        goal="test connection",
        backstory="testing SSE transport connection",
        mcp_transport=transport,
    )

    # Attempt to get MCP tools which triggers the connection internally
    # On buggy code, this will raise RuntimeError due to invalid argument passed
    tools, client = await agent.get_mcp_tools()

    # Assert that tools and client are returned (non-empty tools list and client instance)
    assert tools is not None
    assert client is not None
    assert isinstance(tools, list)
    assert len(tools) >= 0


