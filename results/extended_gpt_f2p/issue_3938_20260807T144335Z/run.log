[32mimport asyncio
import pytest

from crewai.agent.core import Agent
from crewai.mcp.transports.sse import SSETransport


@pytest.mark.asyncio
async def test_agent_connects_to_mcp_server_using_sse_transport():
    """
    Test that an Agent can connect to an MCP server using SSE transport without crashing.

    This test reproduces the bug where an invalid argument was passed to the MCP client
    when using SSE transport, causing a crash. The fix removes the invalid argument.

    The test will fail on the buggy codebase (raising RuntimeError or related errors)
    and pass on the fixed codebase.
    """
    # Minimal valid Agent parameters including required fields to avoid validation errors
    agent = Agent(
        name="test-agent",
        role="tester",
        goal="connect to MCP server",
        backstory="testing SSE transport connection",
        mcp_config={
            "url": "http://localhost:9999/sse",
            "transport": "sse",
            "headers": {"Authorization": "Bearer testtoken"},
        },
    )

    # Attempt to get MCP tools which triggers connection using SSE transport
    # This should not raise RuntimeError related to invalid argument passing
    tools = agent.get_mcp_tools()

    # Assert that tools is a list (or iterable) and not empty (basic sanity)
    assert tools is not None
    assert hasattr(tools, "__iter__")


def test_sync_agent_connects_to_mcp_server_using_sse_transport():
    """
    Synchronous wrapper to run the async test for environments that do not support pytest-asyncio.
    """
