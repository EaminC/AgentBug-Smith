        # get_mcp_tools requires mcps argument, provide a list with our config
        tools = agent.get_mcp_tools(mcps=[mcp_config])
    except Exception as e:
        pytest.fail(f"Agent failed to connect to MCP server using SSE transport: {e}")

    # Assert that tools is a list (or iterable) and not empty
    assert tools is not None
    assert hasattr(tools, "__iter__")


def test_sync_agent_connects_to_mcp_server_using_sse_transport():
    """
    Synchronous wrapper to run the async test.
    """
    asyncio.run(test_agent_connects_to_mcp_server_using_sse_transport())[0m
