import pytest

from crewai.agent.core import Agent
from crewai.crew import Crew


@pytest.mark.asyncio
async def test_agent_connects_to_mcp_server_using_sse_transport():
    """
    This test verifies that an agent can successfully establish a connection to an MCP server
    using SSE transport without raising an exception related to invalid arguments passed
    to the MCP client.

    The bug caused a RuntimeError due to an invalid argument 'terminate_on_close' being passed
    when initializing the MCP client for SSE transport. This test will fail on the buggy codebase
    and pass after the fix is applied.
    """

    # Setup a minimal agent configuration that uses MCP with SSE transport.
    # We simulate the MCP server URL and agent config for the test.
    mcp_config = {
        "transport": "sse",
        "url": "http://localhost:9999/sse",
        "headers": {"Authorization": "Bearer testtoken"},
    }

    # Create an Agent instance with minimal required parameters and the MCP config.
    agent = Agent(
        name="test-agent",
        mcp_config=mcp_config,
        # Other required parameters can be default or minimal
    )

    # Create a Crew instance with the agent
    crew = Crew(agents=[agent])

    # Run the crew kickoff which internally tries to connect to MCP server using SSE transport.
    # We expect no RuntimeError or UnboundLocalError related to invalid argument passing.
    # If the bug is present, this will raise an exception and fail the test.
    try:
        result = await crew.kickoff()
    except RuntimeError as e:
        # Fail the test if the RuntimeError is due to the invalid argument bug
        assert "Failed to get native MCP tools" not in str(e), f"Bug triggered: {e}"
    except Exception as e:
        # Fail the test on any unexpected exception
        pytest.fail(f"Unexpected exception raised: {e}")

    # If no exception, assert that result is not None (or any other success condition)
    assert result is not None, "Crew kickoff did not return a result"


