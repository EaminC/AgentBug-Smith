[32mimport asyncio
import pytest

from crewai.agent.core import Agent
from crewai.mcp.transports.sse import SSETransport


@pytest.mark.asyncio
async def test_agent_connects_to_mcp_server_using_sse_transport():
    """
    Test that an Agent can connect to an MCP server using the SSE transport.

    This test verifies that the agent's get_mcp_tools method does not raise
    an error related to passing invalid arguments to the SSE transport client.
    It simulates the minimal conditions to trigger the bug described in issue #3938.
    """
    # Create an agent instance with minimal required configuration
    agent = Agent(
        name="test-agent",
        mcp_transport="sse",
        mcp_url="http://localhost:9999/sse",
        mcp_headers={"Authorization": "Bearer testtoken"},
    )

    # The get_mcp_tools method requires an argument 'mcps' which is a list of MCP clients.
    # We create a dummy MCP client list with one SSETransport instance to simulate this.
    mcps = [SSETransport(url="http://localhost:9999/sse", headers={"Authorization": "Bearer testtoken"})]

    # Call get_mcp_tools with the mcps argument.
    # Before the fix, this should raise a RuntimeError due to invalid argument passed internally.
    # After the fix, this should succeed and return tools and client without error.
    tools, client = agent.get_mcp_tools(mcps=mcps)

    # Assert that tools is a list or iterable and client is an instance of SSETransport or similar
    assert tools is not None
    assert hasattr(tools, "__iter__")
    assert client is not None
    assert isinstance(client, SSETransport)


def test_sync_agent_connects_to_mcp_server_using_sse_transport():
    """
    Synchronous wrapper to run the async test for compatibility with non-async test runners.
    """
    asyncio.run(test_agent_connects_to_mcp_server_using_sse_transport())[0m
