[32mimport asyncio
import pytest

from crewai.agent.core import Agent
from crewai.mcp.transports.sse import SSETransport


@pytest.mark.asyncio
async def test_agent_connects_to_mcp_server_using_sse_transport():
    """
    Test that an Agent can connect to an MCP server using SSE transport.

    This test attempts to create an Agent configured to use an MCP server
    with SSE transport and then fetch MCP tools from it.

    Before the fix:
        - The test should fail with an error caused by passing an invalid argument
          (`terminate_on_close`) to the MCP client initialization in SSE transport.

    After the fix:
        - The test should pass successfully without raising such errors.
    """
    # Create an Agent instance configured to use SSE transport for MCP connection.
    # We simulate minimal config for MCP with SSE transport.
    # The actual connection will fail since no real server is running,
    # but we want to verify that the invalid argument error does NOT occur.

    # Setup minimal MCP config with SSE transport
    mcp_config = {
        "transport": "sse",
        "url": "http://localhost:9999/sse",
        "headers": {"Authorization": "Bearer testtoken"},
    }

    # Create an Agent instance with a minimal config that uses this MCP config.
    # We use the Agent constructor directly.
    agent = Agent(
        name="test-agent",
        mcp_config=mcp_config,
    )

    # We call get_mcp_tools with mcps argument as empty list or dict to satisfy signature.
    # The buggy code fails due to invalid argument passed internally.
    # The fixed code succeeds or raises a connection error but not argument error.
    with pytest.raises(Exception) as exc_info:
        tools, client = await agent.get_mcp_tools(mcps=[])

    # Check that the error is NOT about an unexpected keyword argument 'terminate_on_close'
    # This confirms the fix that removed the invalid argument.
    assert "terminate_on_close" not in str(exc_info.value)
    # Also check that the error is related to connection or other runtime errors,
    # not the invalid argument error.
    assert any(
        msg in str(exc_info.value).lower()
        for msg in ("connection", "failed", "cannot", "error", "timeout")
    )


def test_sync_agent_connects_to_mcp_server_using_sse_transport():
    """
    Synchronous wrapper to run the async test for compatibility with sync test runners.
    """
    asyncio.run(test_agent_connects_to_mcp_server_using_sse_transport())[0m
