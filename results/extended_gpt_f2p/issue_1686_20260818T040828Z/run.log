def test_agent__call__invalid_tool_name():
    @strands.tool
    def shell(command: str):
        pass

    model = MockedModelProvider(
        [
            {
                "role": "assistant",
                "content": [
                    {
                        "toolUse": {
                            "toolUseId": "tool_use_id",
                            "name": "invalid tool",
                            "input": "{}",
                        }
                    }
                ],
            },
            {"role": "assistant", "content": [{"text": "I invoked a tool!"}]},
        ]
    )

    agent = Agent(tools=[shell], model=model)
