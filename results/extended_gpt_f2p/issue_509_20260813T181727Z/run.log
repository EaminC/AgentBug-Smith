[32mimport pytest
from unittest.mock import patch

from strands.agent.agent import Agent
from strands.agent.conversation_manager.sliding_window_conversation_manager import SlidingWindowConversationManager
from strands.agent.conversation_manager.conversation_manager import ConversationManager
from strands.hooks.registry import HookProvider, HookRegistry
from strands.hooks.events import BeforeModelCallEvent
from tests.fixtures.mocked_model_provider import MockedModelProvider
from strands import tool


def test_per_turn_parameter_validation():
    """Test per_turn parameter validation."""
    # Valid values
    assert SlidingWindowConversationManager(per_turn=False).per_turn is False
    assert SlidingWindowConversationManager(per_turn=True).per_turn is True
    assert SlidingWindowConversationManager(per_turn=3).per_turn == 3


def test_conversation_manager_is_hook_provider_runtime_checkable():
    """Test that ConversationManager implements HookProvider protocol (runtime check)."""
    manager = SlidingWindowConversationManager()
    assert isinstance(manager, HookProvider)


def test_derived_class_register_hooks_presence():
    """Test that derived classes can override register_hooks and call super()."""
    class DummyManager(ConversationManager):
        def apply_management(self, agent, **kwargs):
            pass

        def reduce_context(self, agent, e=None, **kwargs):
            pass

        def register_hooks(self, registry: HookRegistry, **kwargs):
            super().register_hooks(registry, **kwargs)
            registry.add_callback(BeforeModelCallEvent, lambda e: None)

    manager = DummyManager()
    registry = HookRegistry()
    manager.register_hooks(registry)
    assert registry.has_callbacks()


def test_per_turn_hooks_registration_and_callback_invocation():
    """Test that SlidingWindowConversationManager registers hooks and callback is invoked."""
    manager = SlidingWindowConversationManager(per_turn=True)
    registry = HookRegistry()
    manager.register_hooks(registry)
    assert registry.has_callbacks()

    # Create a dummy agent for event
    class DummyAgent:
        messages = []

    dummy_agent = DummyAgent()
    event = BeforeModelCallEvent(agent=dummy_agent)

    # Patch apply_management to track calls
    with patch.object(manager, "apply_management", wraps=manager.apply_management) as mock_apply:
        registry.invoke_callbacks(event)
        assert mock_apply.call_count == 1


def test_per_turn_false_skips_callback_apply_management():
    """Test that per_turn=False disables apply_management calls on BeforeModelCallEvent."""
    manager = SlidingWindowConversationManager(per_turn=False)
    registry = HookRegistry()
    manager.register_hooks(registry)
    assert registry.has_callbacks()

    class DummyAgent:
        messages = []

    dummy_agent = DummyAgent()
    event = BeforeModelCallEvent(agent=dummy_agent)

    with patch.object(manager, "apply_management", wraps=manager.apply_management) as mock_apply:
        registry.invoke_callbacks(event)
        assert mock_apply.call_count == 0


def test_per_turn_integer_applies_every_n_calls():
    """Test that per_turn=N applies management every N model calls."""
    manager = SlidingWindowConversationManager(per_turn=2)
    registry = HookRegistry()
    manager.register_hooks(registry)
    assert registry.has_callbacks()

    class DummyAgent:
        messages = []

    dummy_agent = DummyAgent()
    event = BeforeModelCallEvent(agent=dummy_agent)

    with patch.object(manager, "apply_management", wraps=manager.apply_management) as mock_apply:
        # Call multiple times to simulate multiple model calls
        for i in range(5):
            registry.invoke_callbacks(event)
        # Should be called on 2nd and 4th calls only
        assert mock_apply.call_count == 2


def test_agent_loop_with_per_turn_management_reduces_messages(monkeypatch):
    """Integration test: Agent loop with per_turn management reduces message count during execution."""

    # Prepare SlidingWindowConversationManager with per_turn=1 (every call)
    manager = SlidingWindowConversationManager(per_turn=1, window_size=3)
    # Reset model call count to zero explicitly
    manager._model_call_count = 0

    # Prepare model responses that cause multiple model calls (simulate tool calls)
    responses = [
        {"role": "assistant", "content": [{"toolUse": {"toolUseId": f"{i}", "name": "test", "input": {}}}]}
        for i in range(5)
    ] + [{"role": "assistant", "content": [{"text": "Done"}]}]

    model = MockedModelProvider(responses)

    # Define a dummy tool to allow tool calls
    @tool(name="test")
    def dummy_tool(query: str = "") -> str:
        return "result"

    agent = Agent(model=model, conversation_manager=manager, tools=[dummy_tool])

    # Track message counts during apply_management calls
    message_counts = []

    original_apply_management = manager.apply_management

    def tracking_apply_management(agent_instance, **kwargs):
        # Record message count before management (should be <= window_size after management)
        result = original_apply_management(agent_instance, **kwargs)
        message_counts.append(len(agent_instance.messages))
        return result

    monkeypatch.setattr(manager, "apply_management", tracking_apply_management)

    # Run agent
    agent("Test")

    # Check that message counts are always <= window_size after management
    assert all(count <= manager.window_size for count in message_counts)


def test_state_persistence_of_model_call_count():
    """Test that model_call_count is persisted and restored in SlidingWindowConversationManager."""

    manager = SlidingWindowConversationManager(per_turn=3)
    manager._model_call_count = 7

    state = manager.get_state()
    assert "model_call_count" in state
    assert state["model_call_count"] == 7

    new_manager = SlidingWindowConversationManager(per_turn=3)
    new_manager.restore_from_session(state)
    assert new_manager._model_call_count == 7


