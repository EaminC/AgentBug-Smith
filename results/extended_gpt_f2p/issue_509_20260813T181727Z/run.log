    # We cannot use isinstance(manager, HookProvider) in buggy code (raises TypeError),
    # so we test that HookProvider is a subclass of Protocol and that manager has register_hooks attribute.
    assert hasattr(manager, "register_hooks")


def test_derived_class_register_hooks_presence():
    """Test that derived class of ConversationManager has register_hooks method after fix."""

    from strands.agent.conversation_manager.conversation_manager import ConversationManager

    class MinimalConversationManager(ConversationManager):
        def apply_management(self, agent, **kwargs):
            pass

        def reduce_context(self, agent, e=None, **kwargs):
            pass

    manager = MinimalConversationManager()
    # In buggy code, register_hooks does not exist and raises AttributeError
    # After fix, it exists (even if empty)
    assert hasattr(manager, "register_hooks")
    registry = HookRegistry()
    # Should not raise error calling register_hooks after fix
    manager.register_hooks(registry)


def test_per_turn_hooks_registration_and_callback_invocation():
    """Test that SlidingWindowConversationManager registers hooks and callback is invoked."""

    manager = SlidingWindowConversationManager()
    # In buggy code, per_turn attribute does not exist; simulate it
    setattr(manager, "per_turn", True)
    setattr(manager, "_model_call_count", 0)

    registry = HookRegistry()
    manager.register_hooks(registry)
    assert registry.has_callbacks()

    # Prepare a dummy agent and event
    class DummyAgent:
        def __init__(self):
            self.messages = []

    dummy_agent = DummyAgent()
    event = BeforeModelCallEvent(agent=dummy_agent)

    # The callback _on_before_model_call should be called by registry.invoke_callbacks
    # and apply_management should be called accordingly.

    # Patch apply_management to count calls
    calls = []

    original_apply_management = manager.apply_management

    def counting_apply_management(agent, **kwargs):
        calls.append(1)
        return original_apply_management(agent, **kwargs)

    manager.apply_management = counting_apply_management

    # Invoke callbacks multiple times and check apply_management call count
    for _ in range(5):
        registry.invoke_callbacks(event)

    # Since per_turn=True, apply_management should be called every time
    assert len(calls) == 5


def test_per_turn_false_skips_callback_apply_management():
