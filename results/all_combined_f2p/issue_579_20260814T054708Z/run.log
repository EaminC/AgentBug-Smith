[32mimport asyncio
import pytest

from strands import Agent, tool


@pytest.mark.asyncio
async def test_invocation_state_passed_to_decorator_tool():
    """
    Test that invocation_state kwargs are passed to a decorated tool function.
    """

    @tool
    def decorated_tool(param: str, **kwargs):
        agent = kwargs.get("agent")
        hidden = kwargs.get("hidden")
        return f"Agent: {agent.name if agent else 'none'}, Hidden: {hidden}, Param: {param}"

    agent = Agent(name="test_agent")
    invocation_state = {"agent": agent, "hidden": "secret"}

    tool_use = {"toolUseId": "test-id", "input": {"param": "test_value"}}
    stream = decorated_tool.stream(tool_use, invocation_state)

    results = [event async for event in stream]

    last_event = results[-1]
    assert last_event["status"] == "success"
    assert "Agent: test_agent" in last_event["content"][0]["text"]
    assert "Hidden: secret" in last_event["content"][0]["text"]
    assert "Param: test_value" in last_event["content"][0]["text"]


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_tool():
    """
    Test that invocation_state kwargs are passed to a sub-agent tool.
    """

    @tool
    def sub_agent_tool(query: str, **kwargs):
        agent = kwargs.get("agent")
        hidden = kwargs.get("hidden")
        return f"Sub-agent Agent: {agent.name if agent else 'none'}, Hidden: {hidden}, Query: {query}"

    coordinator_agent = Agent(
        name="coordinator",
        system_prompt="Coordinator agent",
        tools=[sub_agent_tool],
    )

    agent = Agent(name="main_agent")
    invocation_state = {"agent": agent, "hidden": "top_secret"}

    response = coordinator_agent("test query", **invocation_state)

    assert "Sub-agent Agent: main_agent" in response
    assert "Hidden: top_secret" in response
    assert "Query: test query" in response


def test_invocation_state_not_passed_without_kwargs():
    """
    Test that invocation_state kwargs are not passed if not provided.
    """

    @tool
    def simple_tool(param: str, **kwargs):
        agent = kwargs.get("agent")
        hidden = kwargs.get("hidden")
        return f"Agent: {agent}, Hidden: {hidden}, Param: {param}"

    tool_use = {"toolUseId": "test-id", "input": {"param": "value"}}
    stream = simple_tool.stream(tool_use, {})

    async def collect():
        return [event async for event in stream]

    results = asyncio.run(collect())
    last_event = results[-1]
    assert last_event["status"] == "success"
    assert "Agent: None" in last_event["content"][0]["text"]
    assert "Hidden: None" in last_event["content"][0]["text"]
    assert "Param: value" in last_event["content"][0]["text"]


@pytest.mark.asyncio
async def test_invocation_state_passed_to_async_tool():
    """
    Test that invocation_state kwargs are passed to async tools.
    """

    @tool
    async def async_tool(param: str, **kwargs):
        agent = kwargs.get("agent")
        hidden = kwargs.get("hidden")
        await asyncio.sleep(0.01)
        return f"Agent: {agent.name if agent else 'none'}, Hidden: {hidden}, Param: {param}"

    agent = Agent(name="async_agent")
    invocation_state = {"agent": agent, "hidden": "secret"}

    tool_use = {"toolUseId": "async-id", "input": {"param": "async_test"}}
    stream = async_tool.stream(tool_use, invocation_state)

    results = [event async for event in stream]

    last_event = results[-1]
    assert last_event["status"] == "success"
    assert "Agent: async_agent" in last_event["content"][0]["text"]
    assert "Hidden: secret" in last_event["content"][0]["text"]
    assert "Param: async_test" in last_event["content"][0]["text"]


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_with_queue():
    """
    Integration test that a sub-agent tool receives a non-serializable queue from invocation_state.
    """

    queue = asyncio.Queue()

