[32mimport asyncio
import pytest
from strands import Agent, tool


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_tool():
    """
    Test that invocation states are passed correctly to sub-agents when used as tools,
    especially for non-JSON serializable objects.
    """

    # Create a non-serializable object to pass in invocation_state
    queue = asyncio.Queue()

    @tool
    def teacher(query: str, **kwargs):
        # The sub-agent should receive the invocation_state including the queue
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        invocation_state = kwargs

        # Check that the queue is passed correctly in invocation_state
        assert invocation_state.get("queue") is queue

        # Create a sub-agent that uses the hidden_number in its prompt
        teacher_agent = Agent(
            name="teacher",
            system_prompt=(
                f"You're a math teacher helping with math problems. "
                f"You have a hidden number {hidden_number} and must use it in calculations."
            ),
        )

        # The sub-agent is invoked with the query and the same invocation_state
        # This should propagate the queue and other states
        response = teacher_agent(query, **invocation_state)
        return response

    # Coordinator agent uses the teacher tool
    coordinator = Agent(
        name="coordinator",
        system_prompt="You're a coordinator, always pass your query to the teacher agent",
        tools=[teacher],
    )

    # Invocation state includes a hidden number and the queue (non-serializable)
    invocation_state = {"hidden_number": 3, "queue": queue}

    # Call the coordinator with a query and the invocation state
    response = coordinator("times 2", **invocation_state)

    # The response should contain the expected result from the teacher agent
    # Since the teacher agent uses the hidden number 3, times 2 should be 6
    # The exact response depends on the agent's implementation, but we expect the hidden number to be used
    # We check that the response is a non-empty string containing the number 6 or "6" somewhere
    assert isinstance(response, str)
    assert "6" in response or "six" in response.lower()


@pytest.mark.asyncio
async def test_tool_function_receives_invocation_state_kwargs():
    """
    Test that a tool function decorated with @tool receives invocation_state kwargs,
    including non-serializable objects.
    """

    queue = asyncio.Queue()

    @tool
    def sample_tool(param: str, **kwargs):
        # The kwargs should include the queue and agent
        assert kwargs.get("queue") is queue
        agent = kwargs.get("agent")
        assert agent is not None
        return f"param: {param}, agent_name: {agent.name}, queue_present: {queue is not None}"

    agent = Agent(name="test_agent", tools=[sample_tool])

    invocation_state = {"queue": queue}

    result = agent("hello", **invocation_state)

    assert isinstance(result, str)
    assert "param: hello" in result
    assert "agent_name: test_agent" in result
    assert "queue_present: True" in result


@pytest.mark.asyncio
async def test_async_tool_function_receives_invocation_state_kwargs():
    """
    Test that an async tool function decorated with @tool receives invocation_state kwargs.
    """

    queue = asyncio.Queue()

    @tool
    async def async_tool(param: str, **kwargs):
        # The kwargs should include the queue and agent
        assert kwargs.get("queue") is queue
        agent = kwargs.get("agent")
        assert agent is not None
        await asyncio.sleep(0.01)
        return f"async param: {param}, agent_name: {agent.name}, queue_present: {queue is not None}"

    agent = Agent(name="async_agent", tools=[async_tool])

    invocation_state = {"queue": queue}

    result = agent("world", **invocation_state)

    assert isinstance(result, str)
    assert "async param: world" in result
    assert "agent_name: async_agent" in result
    assert "queue_present: True" in result


@pytest.mark.asyncio
async def test_tool_function_receives_agent_and_invocation_state():
    """
    Test that a tool function can receive both the agent and invocation_state kwargs.
    """

    queue = asyncio.Queue()

    @tool
    def tool_with_agent(param: str, agent=None, **kwargs):
        # agent should be passed correctly
        assert agent is not None
        # invocation_state kwargs should include queue
        assert kwargs.get("queue") is queue
        return f"param: {param}, agent_name: {agent.name}, queue_present: {queue is not None}"

    agent = Agent(name="agent_with_tool", tools=[tool_with_agent])

    invocation_state = {"queue": queue}

    result = agent("test", **invocation_state)

    assert isinstance(result, str)
    assert "param: test" in result
    assert "agent_name: agent_with_tool" in result
    assert "queue_present: True" in result


@pytest.mark.asyncio
async def test_tool_function_without_kwargs_still_works():
    """
    Test that a tool function without **kwargs still works and does not receive invocation_state.
    """

    @tool
    def simple_tool(param: str):
        return f"param: {param}"

    agent = Agent(name="simple_agent", tools=[simple_tool])

    # Invocation state with extra keys should not cause error
    invocation_state = {"extra": "value"}

    result = agent("hello", **invocation_state)

    assert isinstance(result, str)
    assert result == "param: hello"


