        },
    )
    tool_results = [value async for value in generator]

    assert len(tool_results) == 1
    tool_result = tool_results[0]

    # Should succeed with the string parameter
    assert tool_result == {
        "status": "success",
        "content": [{"text": "success"}],
        "toolUseId": "test-id-2",
    }



