[32mimport asyncio
import pytest
from asyncio import Queue

from strands import Agent
from strands.tools import tool


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_tool():
    """
    Test that invocation_state kwargs are passed to sub-agent tools correctly,
    especially for non-JSON-serializable objects like asyncio.Queue.
    """

    # Create a complex non-serializable object to pass in invocation_state
    shared_queue = Queue()

    @tool
    def teacher(query: str, **kwargs):
        # The sub-agent tool should receive the invocation_state kwargs
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        queue = kwargs.get("shared_queue")

        # Assert that the shared_queue passed is the same object
        assert queue is shared_queue

        # Create a sub-agent that uses the hidden_number in its prompt
        teacher_agent = Agent(
            name="teacher",
            system_prompt=(
                f"You're a math teacher helping with math problems. "
                f"You have a hidden number {hidden_number} and must use it in calculations."
            ),
        )

        # The sub-agent should be callable and return a string result
        result = teacher_agent(query)
        return result

    # Coordinator agent uses the teacher tool
    coordinator = Agent(
        name="coordinator",
        system_prompt="You're a coordinator, always pass your query to the teacher agent.",
        tools=[teacher],
    )

    # Invocation state includes a hidden number and the shared queue
    invocation_state = {"hidden_number": 3, "shared_queue": shared_queue}

    # Call the coordinator agent with a query and invocation_state
    response = coordinator("times 2", **invocation_state)

    # The response should be a string containing the expected calculation result
    # Since the teacher agent prompt includes hidden_number=3, "times 2" should reflect that
    # We can't assert exact string because the agent is mocked or simple, but response should be str
    assert isinstance(response, str)
    assert "3" in response or "times" in response or len(response) > 0


@pytest.mark.asyncio
async def test_invocation_state_passed_to_decorated_tool():
    """
    Test that invocation_state kwargs are passed to decorated tools via **kwargs.
    """

    shared_queue = Queue()

    @tool
    def decorated_teacher(query: str, **kwargs):
        # Should receive invocation_state kwargs including shared_queue
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        queue = kwargs.get("shared_queue")

        assert queue is shared_queue

        teacher_agent = Agent(
            name="teacher",
            system_prompt=(
                f"You're a math teacher helping with math problems. "
                f"You have a hidden number {hidden_number} and must use it in calculations."
            ),
        )
        return teacher_agent(query)

    coordinator = Agent(
        name="coordinator",
        system_prompt="You're a coordinator, always pass your query to the decorated_teacher agent.",
        tools=[decorated_teacher],
    )

    invocation_state = {"hidden_number": 5, "shared_queue": shared_queue}

    response = coordinator("plus 4", **invocation_state)

    assert isinstance(response, str)
    assert "5" in response or "plus" in response or len(response) > 0


@pytest.mark.asyncio
async def test_agent_parameter_in_decorated_tool():
    """
    Test that the 'agent' parameter is passed correctly to decorated tools via invocation_state.
    """

    @tool
    def tool_with_agent_param(query: str, **kwargs):
        agent = kwargs.get("agent")
        # The agent param should be an Agent instance with name "coordinator"
        assert agent is not None
        assert isinstance(agent, Agent)
        assert agent.name == "coordinator"
        return f"Agent name: {agent.name}, query: {query}"

    coordinator = Agent(
        name="coordinator",
        system_prompt="Coordinator agent",
        tools=[tool_with_agent_param],
    )

    # Pass invocation_state with 'agent' key as coordinator itself
    invocation_state = {"agent": coordinator}

    response = coordinator("hello", **invocation_state)

    assert isinstance(response, str)
    assert "Agent name: coordinator" in response


@pytest.mark.asyncio
async def test_invocation_state_with_non_serializable_object():
    """
    Test that a non-JSON-serializable object in invocation_state is passed to the tool correctly.
    """

    class CustomObject:
        def __repr__(self):
            return "<CustomObject>"

    custom_obj = CustomObject()

    @tool
    def tool_receiving_custom_obj(param: str, **kwargs):
        obj = kwargs.get("custom_obj")
        assert obj is custom_obj
        return f"Received param: {param} and object: {obj}"

    agent = Agent(
        name="agent_with_custom_obj",
        system_prompt="Agent with custom object",
        tools=[tool_receiving_custom_obj],
    )

    invocation_state = {"custom_obj": custom_obj}

    response = agent("test", **invocation_state)

    assert isinstance(response, str)
    assert "Received param: test" in response
    assert "<CustomObject>" in response


