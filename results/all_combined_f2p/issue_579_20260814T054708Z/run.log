[32mimport asyncio
from asyncio import Queue
import pytest

from strands import Agent, tool


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_tool():
    """
    Test that invocation_state kwargs are passed correctly to a sub-agent tool.
    """

    @tool
    def teacher(query: str, **kwargs):
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        # The sub-agent should receive the hidden_number and agent in kwargs
        assert hidden_number == 5
        assert agent is not None
        # Create a sub-agent that uses the hidden_number
        teacher_agent = Agent(
            name="teacher",
            system_prompt=f"You're a math teacher helping with math problems. You have a hidden number {hidden_number} and must use it in calculations.",
        )
        return teacher_agent(query)

    coordinator = Agent(
        name="coordinator",
        system_prompt="You're a coordinator, always pass your query to teacher agent",
        tools=[teacher],
    )
    invocation_state = {"hidden_number": 5}
    response = coordinator("times 2", **invocation_state)
    # The response should contain the hidden_number in some form (string)
    assert "5" in response


def test_invocation_state_passed_to_decorated_tool():
    """
    Test that invocation_state kwargs are passed correctly to a decorated tool function.
    """

    @tool
    def decorated_tool(param: str, **kwargs):
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        assert hidden_number == 10
        assert agent is None or hasattr(agent, "name")
        return f"param={param}, hidden_number={hidden_number}"

    invocation_state = {"hidden_number": 10}
    tool_result = decorated_tool("test", **invocation_state)
    assert "hidden_number=10" in tool_result


def test_agent_parameter_in_decorated_tool():
    """
    Test that the 'agent' parameter is passed correctly to a decorated tool.
    """

    @tool
    def decorated_tool_with_agent(param: str, agent=None):
        if agent is not None:
            return f"Agent: {agent.name}, Param: {param}"
        return f"Param: {param}"

    mock_agent = Agent(name="mock_agent")
    tool_use = {"toolUseId": "test-id", "input": {"param": "hello"}}

    # Call without agent in invocation_state
    result_without_agent = decorated_tool_with_agent("hello")
    assert result_without_agent == "Param: hello"

    # Call with agent in invocation_state
    result_with_agent = decorated_tool_with_agent("hello", agent=mock_agent)
    assert "Agent: mock_agent" in result_with_agent


def test_invocation_state_with_non_serializable_object():
    """
    Test that invocation_state can carry non-JSON-serializable objects like asyncio.Queue.
    """

    shared_queue = Queue()

    @tool
    def tool_using_queue(param: str, **kwargs):
        queue = kwargs.get("shared_queue")
        # The queue object should be the same as shared_queue
        assert queue is shared_queue
        return f"Queue received with param {param}"

    invocation_state = {"shared_queue": shared_queue}
    result = tool_using_queue("test", **invocation_state)
    assert "Queue received" in result


@pytest.mark.asyncio
async def test_invocation_state_propagation_in_async_tool():
    """
    Test that invocation_state kwargs are passed correctly to async decorated tools.
    """

    shared_queue = Queue()

    @tool
    async def async_teacher(query: str, **kwargs):
        hidden_number = kwargs.get("hidden_number")
        queue = kwargs.get("shared_queue")
        assert queue is shared_queue

        teacher_agent = Agent(
            name="teacher_async",
            system_prompt=(
                f"You're a math teacher helping with math problems. "
                f"You have a hidden number {hidden_number} and must use it in calculations."
            ),
        )
        # Simulate async call
        await asyncio.sleep(0.01)
        return teacher_agent(query)

    coordinator = Agent(
        name="coordinator_async",
        system_prompt="Coordinator async agent",
        tools=[async_teacher],
    )

    invocation_state = {"hidden_number": 7, "shared_queue": shared_queue}

    response = await coordinator.invoke_async("times 3", **invocation_state)
    assert "7" in response


