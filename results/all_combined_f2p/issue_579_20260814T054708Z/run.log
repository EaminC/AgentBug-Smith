[32mimport asyncio
import pytest

from strands import Agent, tool


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_tool():
    """
    Test that invocation_state is passed correctly to sub-agents when used as tools.
    """

    @tool
    def teacher(query: str, **kwargs):
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        invocation_state = kwargs

        # Check that the invocation_state contains the hidden_number
        assert invocation_state.get("hidden_number") == 3
        assert agent is not None
        # Return a response string that includes the hidden number
        return f"Answer with hidden number {hidden_number}"

    coordinator = Agent(
        name="coordinator",
        system_prompt="You're a coordinator, always pass your query to teacher agent",
        tools=[teacher],
    )
    invocation_state = {"hidden_number": 3}
    response = coordinator("times 2", **invocation_state)

    # The response should include the hidden number passed via invocation_state
    assert "hidden number 3" in response


@pytest.mark.asyncio
async def test_async_tool_function_receives_invocation_state_kwargs():
    """
    Test that an async tool function receives the invocation_state kwargs properly.
    """

    @tool
    async def async_sample_tool(x: int, **kwargs):
        invocation_state = kwargs
        await asyncio.sleep(0)  # simulate async work
        return x + invocation_state.get("increment", 0)

    invocation_state = {"increment": 20}

    # Use the tool's stream interface to invoke async tool function with invocation_state
    tool_use = {"toolUseId": "test-id", "input": {"x": 7}}
    stream = async_sample_tool.stream(tool_use, invocation_state)
    results = [event async for event in stream]
    # The last event contains the result
    result = results[-1]
    assert result["status"] == "success"
    # The result text should be 7 + 20 = 27
    assert result["content"][0]["text"] == "27"


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_async():
    """
    Test that invocation_state is passed correctly to sub-agents asynchronously.
    """

    queue = asyncio.Queue()

    @tool
    async def teacher_async(query: str, **kwargs):
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        invocation_state = kwargs

        assert invocation_state.get("queue") is queue

        teacher_agent = Agent(
            name="teacher_async",
            system_prompt=(
                f"You're a math teacher helping with math problems. "
                f"You have a hidden number {hidden_number} and must use it in calculations."
            ),
        )

        response = await teacher_agent.invoke_async(query, **invocation_state)
        return response

    coordinator = Agent(
        name="coordinator_async",
        system_prompt="You're a coordinator, always pass your query to teacher agent",
        tools=[teacher_async],
    )

    invocation_state = {"hidden_number": 5, "queue": queue}

    response = await coordinator.invoke_async("times 3", **invocation_state)

    # The response should be a string containing the hidden number 5
    assert "5" in response or "five" in response.lower()


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_sync():
    """
    Test that invocation_state is passed correctly to sub-agents synchronously.
    """

    @tool
    def teacher_sync(query: str, **kwargs):
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        invocation_state = kwargs

        assert invocation_state.get("hidden_number") == 7
        assert agent is not None

        return f"Sync answer with hidden number {hidden_number}"

    coordinator = Agent(
        name="coordinator_sync",
        system_prompt="You're a coordinator, always pass your query to teacher agent",
        tools=[teacher_sync],
    )

    invocation_state = {"hidden_number": 7}

    response = coordinator("times 4", **invocation_state)

    assert "hidden number 7" in response


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_tool_with_queue():
    """
    Test passing a non-serializable object (asyncio.Queue) via invocation_state to sub-agent tool.
    """

    queue = asyncio.Queue()

    @tool
    def teacher_with_queue(query: str, **kwargs):
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        invocation_state = kwargs

        # The queue object should be the same as passed
        assert invocation_state.get("queue") is queue
        assert hidden_number == 9
        assert agent is not None

        # Put a message in the queue to simulate shared state
        async def put_message():
            await queue.put(f"Processed query: {query} with hidden {hidden_number}")

        # Run the coroutine in the event loop
        asyncio.get_event_loop().run_until_complete(put_message())

        return f"Answer with hidden number {hidden_number}"

    coordinator = Agent(
        name="coordinator_queue",
        system_prompt="You're a coordinator, always pass your query to teacher agent",
        tools=[teacher_with_queue],
    )

    invocation_state = {"hidden_number": 9, "queue": queue}

    response = coordinator("times 5", **invocation_state)

    assert "hidden number 9" in response

    # Check that the queue has the message put by the sub-agent tool
    message = await queue.get()
    assert "Processed query" in message
    assert "hidden 9" in message


