[32mimport asyncio
import pytest

from strands import Agent, tool


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_tool():
    """
    Test that invocation_state is passed correctly to sub-agents when using a tool function.
    """

    queue = asyncio.Queue()

    @tool
    def teacher(query: str, **kwargs):
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        invocation_state = kwargs

        # Verify that the invocation_state contains the queue object
        assert invocation_state.get("queue") is queue

        teacher_agent = Agent(
            name="teacher",
            system_prompt=(
                f"You're a math teacher helping with math problems. "
                f"You have a hidden number {hidden_number} and must use it in calculations."
            ),
        )

        # Call the sub-agent synchronously passing invocation_state
        response = teacher_agent(query, **invocation_state)
        return response

    coordinator = Agent(
        name="coordinator",
        system_prompt="You're a coordinator, always pass your query to teacher agent",
        tools=[teacher],
    )

    invocation_state = {"hidden_number": 7, "queue": queue}

    response = coordinator("times 4", **invocation_state)

    # The response should contain the expected calculation result including the hidden number
    assert isinstance(response, str)
    assert "times 4" in response or "8" in response or "28" in response


def test_tool_function_receives_invocation_state_kwargs():
    """
    Test that a tool function receives the invocation_state kwargs properly.
    """

    @tool
    def sample_tool(x: int, **kwargs):
        # The invocation_state should be passed in kwargs
        invocation_state = kwargs
        return x + invocation_state.get("increment", 0)

    invocation_state = {"increment": 10}

    # Call tool function directly with invocation_state kwargs
    result = sample_tool(5, **invocation_state)

    assert result == 15


@pytest.mark.asyncio
async def test_async_tool_function_receives_invocation_state_kwargs():
    """
    Test that an async tool function receives the invocation_state kwargs properly.
    """

    @tool
    async def async_sample_tool(x: int, **kwargs):
        invocation_state = kwargs
        await asyncio.sleep(0)  # simulate async work
        return x + invocation_state.get("increment", 0)

    invocation_state = {"increment": 20}

    result = await async_sample_tool.invoke_async(7, **invocation_state)

    assert result == 27


def test_tool_function_receives_agent_and_invocation_state():
    """
    Test that a tool function can receive both the agent and invocation_state kwargs.
    """

    @tool
    def tool_with_agent(x: int, agent=None, **kwargs):
        invocation_state = kwargs
        # agent should be passed in invocation_state or as explicit argument
        assert agent is not None or "agent" in invocation_state
        increment = invocation_state.get("increment", 0)
        return x + increment

    invocation_state = {"increment": 3, "agent": "dummy_agent"}

    result = tool_with_agent(4, **invocation_state)

    assert result == 7


def test_tool_function_without_kwargs_still_works():
    """
    Test that a tool function without **kwargs still works normally.
    """

    @tool
    def simple_tool(x: int):
        return x * 2

    # Call directly
    result = simple_tool(5)
    assert result == 10

    # Call via stream interface with invocation_state (should ignore invocation_state)
    tool_use = {"toolUseId": "test-id", "input": {"x": 5}}
    stream = simple_tool.stream(tool_use, {"increment": 100})

    # Collect the last event
    async def collect_last():
        last = None
        async for event in stream:
            last = event
        return last

    last_event = asyncio.run(collect_last())

    assert last_event is not None
    assert last_event["status"] == "success"
    assert last_event["content"][0]["text"] == "10"


@pytest.mark.asyncio
