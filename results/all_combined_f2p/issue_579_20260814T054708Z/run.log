from asyncio import Queue
import pytest

from strands import Agent, tool


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_tool():
    """
    Test that invocation_state kwargs are passed correctly to sub-agent tools.
    """

    @tool
    def teacher(query: str, **kwargs):
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        # The sub-agent should receive the hidden_number and agent in kwargs
        assert hidden_number == 5
        assert agent is not None
        # Create a sub-agent that uses the hidden_number in its response
        teacher_agent = Agent(
            name="teacher",
            system_prompt=f"You're a math teacher. Hidden number is {hidden_number}.",
        )
        return teacher_agent(query)

    coordinator = Agent(
        name="coordinator",
        system_prompt="You're a coordinator, always pass your query to teacher agent",
        tools=[teacher],
    )
    invocation_state = {"hidden_number": 5}
    response = coordinator("times 2", **invocation_state)
    assert isinstance(response, str)
    assert "times 2" in response or "times 10" in response or "10" in response


@pytest.mark.asyncio
async def test_invocation_state_passed_to_decorated_tool():
    """
    Test that invocation_state kwargs are passed correctly to decorated tools.
    """

    @tool
    def decorated_tool(param: str, **kwargs):
        # Should receive invocation_state kwargs
        hidden_value = kwargs.get("hidden_value")
        assert hidden_value == 42
        return f"Received {param} and hidden {hidden_value}"

    agent = Agent(name="agent", tools=[decorated_tool])
    invocation_state = {"hidden_value": 42}
    response = agent("test", **invocation_state)
    assert response == "Received test and hidden 42"


@pytest.mark.asyncio
async def test_agent_parameter_in_decorated_tool():
    """
    Test that the 'agent' parameter is passed correctly to decorated tools.
    """

    @tool
    def tool_with_agent(param: str, agent=None):
        # The agent param should be passed from invocation_state
        assert agent is not None
        return f"Agent: {agent.name}, Param: {param}"

    agent = Agent(name="main_agent", tools=[tool_with_agent])
    invocation_state = {"agent": agent}
    response = agent("hello", **invocation_state)
    assert response == f"Agent: main_agent, Param: hello"


@pytest.mark.asyncio
async def test_invocation_state_with_non_serializable_object():
    """
    Test that invocation_state can pass non-JSON-serializable objects like asyncio.Queue.
    """

    shared_queue = Queue()

    @tool
    def tool_with_queue(param: str, **kwargs):
        queue = kwargs.get("shared_queue")
        # The queue should be the same instance as shared_queue
        assert queue is shared_queue
        return f"Queue size: {queue.qsize()}"

    agent = Agent(name="agent_with_queue", tools=[tool_with_queue])
    invocation_state = {"shared_queue": shared_queue}
    response = agent("test", **invocation_state)
    assert response == "Queue size: 0"


