[32mimport asyncio
import pytest

from strands import Agent, tool


@pytest.mark.asyncio
async def test_invocation_state_passed_to_decorator_tool():
    """
    Test that invocation_state kwargs are passed to a tool decorated function.
    """

    @tool
    def decorated_tool(param: str, **kwargs):
        agent = kwargs.get("agent")
        hidden = kwargs.get("hidden")
        return f"Agent: {agent.name if agent else 'none'}, Hidden: {hidden}, Param: {param}"

    agent = Agent(name="test_agent")
    invocation_state = {"agent": agent, "hidden": "secret"}

    tool_use = {"toolUseId": "tool-id", "input": {"param": "test"}}
    stream = decorated_tool.stream(tool_use, invocation_state)

    results = [event async for event in stream]

    last_event = results[-1]
    assert last_event["status"] == "success"
    assert "Agent: test_agent" in last_event["content"][0]["text"]
    assert "Hidden: secret" in last_event["content"][0]["text"]
    assert "Param: test" in last_event["content"][0]["text"]


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_tool():
    """
    Integration test that a sub-agent tool receives invocation_state kwargs.
    """

    @tool
    def sub_agent_tool(query: str, **kwargs):
        agent = kwargs.get("agent")
        hidden = kwargs.get("hidden")
        assert agent is not None
        assert hidden == "secret"
        return f"Sub-agent received query: {query} with hidden: {hidden}"

    main_agent = Agent(
        name="main_agent",
        system_prompt="Main agent",
        tools=[sub_agent_tool],
    )

    agent = Agent(name="main_agent")
    invocation_state = {"agent": agent, "hidden": "secret"}

    response = main_agent("test query", **invocation_state)

    assert "Sub-agent received query: test query with hidden: secret" in response


@pytest.mark.asyncio
async def test_invocation_state_not_passed_without_kwargs():
    """
    Test that if invocation_state is empty, the tool does not receive extra kwargs.
    """

    @tool
    def simple_tool(param: str, **kwargs):
        # kwargs should be empty
        assert kwargs == {}
        return f"Param: {param}"

    main_agent = Agent(
        name="main_agent",
        system_prompt="Main agent",
        tools=[simple_tool],
    )

    response = main_agent("hello")

    assert "Param: hello" in response


@pytest.mark.asyncio
