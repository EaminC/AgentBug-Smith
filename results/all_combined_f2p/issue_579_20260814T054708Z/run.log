[32mimport asyncio
from asyncio import Queue
import pytest

from strands import Agent, tool


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_tool():
    """
    Test that invocation_state is passed correctly to a sub-agent tool.
    """

    @tool
    def teacher(query: str, **kwargs):
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        assert agent is not None
        assert hidden_number == 3
        # Create a sub-agent that uses the hidden_number in its response
        teacher_agent = Agent(
            name="teacher",
            system_prompt=f"You're a math teacher help with math problems. You have got an hidden number {hidden_number} and you must use it in the calculation",
        )
        # The sub-agent returns the query repeated hidden_number times as a simple test
        return teacher_agent(query)

    coordinator = Agent(
        name="coordinator",
        system_prompt="You're a coordinator, always pass your query to teacher agent",
        tools=[teacher],
    )
    invocation_state = {"hidden_number": 3}
    response = coordinator("times 2", **invocation_state)
    # The response should contain the query repeated 3 times or include the hidden_number
    assert "times 2" in response or "3" in response


def test_invocation_state_passed_to_decorated_tool():
    """
    Test that invocation_state is passed correctly to a decorated tool function.
    """

    @tool
    def decorated_tool(param: str, **kwargs):
        # kwargs should contain invocation_state keys
        assert kwargs.get("extra_data") == "value"
        return f"Received: {param} with extra_data: {kwargs.get('extra_data')}"

    agent = Agent(name="agent", tools=[decorated_tool])
    response = agent("test", extra_data="value")
    assert "Received: test with extra_data: value" == response


def test_agent_parameter_in_tool_function():
    """
    Test that the 'agent' parameter is passed correctly to a tool function.
    """

    @tool
    def tool_with_agent(param: str, agent=None):
        assert agent is not None
        return f"Agent name: {agent.name}, param: {param}"

    agent = Agent(name="main_agent", tools=[tool_with_agent])
    response = agent("hello")
    assert "Agent name: main_agent" in response
    assert "param: hello" in response


def test_invocation_state_with_non_serializable_object():
    """
    Test passing non-JSON-serializable objects in invocation_state to a tool.
    """

    shared_queue = Queue()

    @tool
    def tool_with_queue(param: str, **kwargs):
        q = kwargs.get("shared_queue")
        assert q is shared_queue
        return f"Queue received for param: {param}"

    agent = Agent(name="agent_with_queue", tools=[tool_with_queue])
    response = agent("data", shared_queue=shared_queue)
    assert "Queue received for param: data" == response


