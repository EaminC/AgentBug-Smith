[32mimport asyncio
from asyncio import Queue

import pytest

from strands import Agent, tool


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_tool():
    """
    Test that invocation_state is passed correctly to a sub-agent used as a tool.
    """

    @tool
    def teacher(query: str, **kwargs):
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        # The teacher agent uses the hidden number in its response
        teacher_agent = Agent(
            name="teacher",
            system_prompt=f"You're a math teacher help with math problems. You have got a hidden number {hidden_number} and you must use it in the calculation",
        )
        # The teacher agent receives the query and invocation_state forwarded
        return teacher_agent(query, **kwargs)

    coordinator = Agent(
        name="coordinator",
        system_prompt="You're a coordinator, always pass your query to teacher agent",
        tools=[teacher],
    )
    invocation_state = {"hidden_number": 3}

    # The coordinator agent is called with invocation_state, which should be passed to teacher
    response = coordinator("times 2", **invocation_state)

    # The response should reflect the hidden_number usage in the teacher's system prompt
    # We check that the response is a string containing the hidden number and the query
    assert isinstance(response, str)
    assert "3" in response or "hidden number 3" in response


@pytest.mark.asyncio
async def test_invocation_state_passed_to_decorated_tool():
    """
    Test that invocation_state is passed correctly to a decorated tool function.
    """

    @tool
    def decorated_tool(param: str, **kwargs):
        # The tool should receive invocation_state via kwargs
        hidden_value = kwargs.get("hidden_value")
        agent = kwargs.get("agent")
        return f"param={param}, hidden_value={hidden_value}, agent_name={agent.name if agent else None}"

    agent = Agent(name="main_agent", tools=[decorated_tool])
    invocation_state = {"hidden_value": 42}

    response = agent("test_param", **invocation_state)

    # The response should include the hidden_value and agent name
    assert "hidden_value=42" in response
    assert "agent_name=main_agent" in response


def test_agent_parameter_in_tool_function():
    """
    Test that the agent parameter can be passed to a tool function via invocation_state.
    """

    @tool
    def tool_with_agent(param: str, agent=None):
        if agent:
            return f"Agent: {agent.name}, Param: {param}"
        return f"Param: {param}"

    agent = Agent(name="agent1", tools=[tool_with_agent])

    # Call without agent in invocation_state
    response1 = agent("hello")
    assert response1 == "Param: hello"

    # Call with agent in invocation_state
    response2 = agent("hello", agent=agent)
    assert response2 == f"Agent: {agent.name}, Param: hello"


@pytest.mark.asyncio
async def test_invocation_state_with_non_serializable_object():
    """
    Test that invocation_state can carry non JSON serializable objects like asyncio.Queue.
    """

    shared_queue = Queue()

    @tool
    def tool_with_queue(param: str, **kwargs):
        q = kwargs.get("shared_queue")
        assert q is shared_queue
        # Put a message in the queue to confirm usage
        asyncio.get_event_loop().call_soon_threadsafe(q.put_nowait, f"Processed: {param}")
        return f"Received: {param}"

    agent = Agent(name="agent_with_queue", tools=[tool_with_queue])

    response = agent("message", shared_queue=shared_queue)

    # Check that the response is correct
    assert response == "Received: message"

    # Check that the queue has the expected message
    queued_message = await shared_queue.get()
    assert queued_message == "Processed: message"


@pytest.mark.asyncio
async def test_invocation_state_passed_to_async_tool():
    """
    Test that invocation_state is passed correctly to an async tool function.
    """

    shared_queue = Queue()

    @tool
    async def async_tool(param: str, **kwargs):
        sq = kwargs.get("shared_queue")
        assert sq is shared_queue

        await sq.put(f"Async processed: {param}")
        return f"Async received: {param}"

    agent = Agent(name="async_agent", tools=[async_tool])

    # Run the synchronous call in a thread executor to avoid event loop issues
    response = await asyncio.get_event_loop().run_in_executor(
        None, lambda: agent("async_test", shared_queue=shared_queue)
    )

    assert response == "Async received: async_test"
    queued_message = await shared_queue.get()
    assert queued_message == "Async processed: async_test"[0m
