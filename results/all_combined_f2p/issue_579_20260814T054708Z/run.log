[32mimport asyncio
import pytest
from strands import Agent, tool


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_tool():
    """
    Test that invocation_state kwargs are passed to sub-agent tools,
    especially for non-JSON-serializable objects.
    """

    # Create an asyncio.Queue instance to simulate a non-serializable object
    message_queue = asyncio.Queue()

    @tool
    def teacher(query: str, **kwargs):
        # The invocation_state should be passed as kwargs
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        queue = kwargs.get("message_queue")

        # Assert that the passed queue is the same as the one created here
        assert queue is message_queue

        # Create a sub-agent with a system prompt including hidden_number
        teacher_agent = Agent(
            name="teacher",
            system_prompt=(
                f"You're a math teacher help with math problems. "
                f"You have got an hidden number {hidden_number} and you must use it in the calculation"
            ),
        )
        # The sub-agent should be able to receive the query and return a response
        # We expect the sub-agent to use the hidden_number in its response
        return teacher_agent(query)

    # Coordinator agent uses the teacher tool
    coordinator = Agent(
        name="coordinator",
        system_prompt="You're a coordinator, always pass your query to teacher agent",
        tools=[teacher],
    )

    # Invocation state includes hidden_number and the non-serializable message_queue
    invocation_state = {"hidden_number": 3, "message_queue": message_queue}

    # Call the coordinator agent with a query and the invocation state
    response = coordinator("times 2", **invocation_state)

    # The response should be a string containing the expected calculation result
    # Since the teacher agent uses hidden_number=3, "times 2" should result in 6
    # The exact response depends on the sub-agent's implementation, but we test for expected substring
    assert isinstance(response, str)
    # We expect the response to mention the number 6 (3 * 2)
    assert "6" in response or "times 2" in response or "3" in response


@pytest.mark.asyncio
async def test_invocation_state_passed_to_decorator_tool():
    """
    Test that invocation_state kwargs are passed to tools decorated with @tool,
    allowing access to agent and other context.
    """

    @tool
    def sample_tool(param: str, **kwargs):
        # Should receive agent from invocation_state via kwargs
        agent = kwargs.get("agent")
        hidden_value = kwargs.get("hidden_value")
        queue = kwargs.get("queue")

        # Assert that agent is an Agent instance
        assert agent is not None
        assert hasattr(agent, "name")

        # Assert that hidden_value and queue are passed correctly
        assert hidden_value == 42
        assert queue is not None
        assert isinstance(queue, asyncio.Queue)

        return f"Agent: {agent.name}, Param: {param}, Hidden: {hidden_value}"

    # Create an agent to pass as invocation_state
    agent_instance = Agent(name="test_agent")

    # Create a queue to pass as invocation_state
    queue_instance = asyncio.Queue()

    # Invocation state with agent and other arbitrary data
    invocation_state = {
        "agent": agent_instance,
        "hidden_value": 42,
        "queue": queue_instance,
    }

    # Call the tool via stream interface with invocation_state
    tool_use = {"toolUseId": "test-id", "input": {"param": "hello"}}
    stream = sample_tool.stream(tool_use, invocation_state)

    # Collect the result from the async generator
    results = [event async for event in stream]

    # The last event should be success with expected content text
    last_event = results[-1]
    assert last_event["status"] == "success"
    assert "Agent: test_agent" in last_event["content"][0]["text"]
    assert "Param: hello" in last_event["content"][0]["text"]
    assert "Hidden: 42" in last_event["content"][0]["text"]


@pytest.mark.asyncio
async def test_invocation_state_not_passed_without_kwargs():
    """
    Test that if invocation_state is empty, the tool still works without error.
    """

    @tool
    def simple_tool(param: str, **kwargs):
        # kwargs should be empty
        assert kwargs == {}
        return f"Received: {param}"

    tool_use = {"toolUseId": "id-123", "input": {"param": "test"}}
    stream = simple_tool.stream(tool_use, {})

    results = [event async for event in stream]

    last_event = results[-1]
    assert last_event["status"] == "success"
    assert last_event["content"][0]["text"] == "Received: test"


@pytest.mark.asyncio
async def test_invocation_state_passed_to_async_tool():
    """
    Test that invocation_state kwargs are passed to async tools.
    """

    @tool
    async def async_tool(param: str, **kwargs):
        agent = kwargs.get("agent")
        hidden = kwargs.get("hidden")
        await asyncio.sleep(0.01)
        return f"Agent: {agent.name if agent else 'none'}, Hidden: {hidden}, Param: {param}"

    agent = Agent(name="async_agent")
    invocation_state = {"agent": agent, "hidden": "secret"}

    tool_use = {"toolUseId": "async-id", "input": {"param": "async_test"}}
    stream = async_tool.stream(tool_use, invocation_state)

    results = [event async for event in stream]

    last_event = results[-1]
    assert last_event["status"] == "success"
    assert "Agent: async_agent" in last_event["content"][0]["text"]
    assert "Hidden: secret" in last_event["content"][0]["text"]
    assert "Param: async_test" in last_event["content"][0]["text"]


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_with_queue():
    """
    Integration test that a sub-agent tool receives a non-serializable queue from invocation_state.
    """

    queue = asyncio.Queue()

    @tool
    def sub_agent_tool(query: str, **kwargs):
        # The queue should be passed via invocation_state kwargs
        q = kwargs.get("queue")
        assert q is queue

        # Create a sub-agent that returns a message including the queue id
        sub_agent = Agent(name="sub_agent", system_prompt="Dummy sub-agent")
        return f"Sub-agent received query: {query} with queue id {id(q)}"

    main_agent = Agent(
        name="main_agent",
        system_prompt="Main agent",
        tools=[sub_agent_tool],
    )

    invocation_state = {"queue": queue}

    response = main_agent("test query", **invocation_state)

    assert isinstance(response, str)
    assert "test query" in response
    assert str(id(queue)) in response


