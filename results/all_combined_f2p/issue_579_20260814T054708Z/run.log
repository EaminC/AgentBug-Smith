    @pytest.mark.asyncio
    async def test_invocation_state_passed_to_subagent_tool():
        """
        Test that invocation_state kwargs are passed to sub-agent tools correctly,
        especially for non-JSON-serializable objects like asyncio.Queue.
        """
    
        # Create a non-serializable object to pass via invocation_state
        shared_queue = Queue()
    
        @tool
        def teacher(query: str, **kwargs):
            # The sub-agent tool should receive the invocation_state including shared_queue
            hidden_number = kwargs.get("hidden_number")
            agent = kwargs.get("agent")
            invocation_state = kwargs
    
            # Assert that the shared_queue passed is the same object
            assert invocation_state.get("shared_queue") is shared_queue
            assert hidden_number == 3
            assert agent is not None
            assert isinstance(agent, Agent)
    
            # Create a sub-agent that uses the hidden_number in its response
            teacher_agent = Agent(
                name="teacher",
                system_prompt=(
                    f"You're a math teacher help with math problems. "
                    f"You have got an hidden number {hidden_number} and you must use it in the calculation"
                ),
            )
    
            # Call the sub-agent with the query
            response = teacher_agent(query)
            return response
    
        # Coordinator agent uses the teacher tool
        coordinator = Agent(
            name="coordinator",
            system_prompt="You're a coordinator, always pass your query to teacher agent",
            tools=[teacher],
        )
    
        # Invocation state includes hidden_number and the shared_queue
