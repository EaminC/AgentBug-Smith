[32mimport asyncio
from asyncio import Queue

import pytest

from strands import Agent, tool


@pytest.mark.asyncio
async def test_invocation_state_passed_to_subagent_tool():
    """
    Test that invocation state is properly passed to sub-agents via tools decorator.

    This test verifies that a complex, non-JSON-serializable object (asyncio.Queue)
    can be passed through invocation_state to a sub-agent tool and accessed correctly.
    """

    # Create a shared asyncio.Queue to simulate non-serializable shared state
    shared_queue = Queue()

    @tool
    def teacher(query: str, **kwargs):
        # Access invocation state from kwargs
        hidden_number = kwargs.get("hidden_number")
        agent = kwargs.get("agent")
        invocation_state = kwargs

        # The agent parameter should be an Agent instance
        assert agent is not None
        assert isinstance(agent, Agent)

        # The hidden_number should be passed correctly
        assert hidden_number == 42

        # The shared_queue should be passed through invocation_state and accessible
        # We expect the same shared_queue instance here
        assert invocation_state.get("shared_queue") is shared_queue

        # Put a message into the shared queue to simulate message passing
        async def put_message():
            await shared_queue.put(f"Teacher received query: {query} with hidden_number {hidden_number}")

        # Run the coroutine to put message
        asyncio.get_event_loop().run_until_complete(put_message())

        # Create a sub-agent that uses the hidden_number in its response
        teacher_agent = Agent(
            name="teacher",
            system_prompt=f"You're a math teacher with a hidden number {hidden_number} and must use it in calculations.",
        )

        # Call the sub-agent synchronously for simplicity in this test
        response = teacher_agent(query)

        return response

    # Coordinator agent uses the teacher tool
    coordinator = Agent(
        name="coordinator",
        system_prompt="You're a coordinator, always pass your query to teacher agent",
        tools=[teacher],
    )

    # Invocation state includes hidden_number and the shared_queue
    invocation_state = {"hidden_number": 42, "shared_queue": shared_queue}

    # Call the coordinator agent with a query and the invocation state
    response = coordinator("times 2", **invocation_state)

    # The response should be a string containing the query (or processed result)
    assert isinstance(response, str)
    assert "times 2" in response

    # Now check that the shared_queue received the message from the teacher tool
    # We expect one message in the queue
    message = await shared_queue.get()
    assert message == "Teacher received query: times 2 with hidden_number 42"

    # The queue should now be empty
    assert shared_queue.empty()


@pytest.mark.asyncio
async def test_invocation_state_passed_to_decorated_tool():
    """
    Test that invocation state is passed to a decorated tool function and accessible via kwargs.
    """

    shared_queue = Queue()

    @tool
    def sample_tool(param: str, **kwargs):
        # Access the shared_queue from invocation_state passed as kwargs
        sq = kwargs.get("shared_queue")
        assert sq is shared_queue

        # Put a message into the queue
        async def put_message():
            await sq.put(f"Processed param: {param}")

        asyncio.get_event_loop().run_until_complete(put_message())

        # Return a simple string response
        return f"Received: {param}"

    # Create an agent using this tool
    agent = Agent(name="agent", tools=[sample_tool])

    # Invocation state includes the shared_queue
    invocation_state = {"shared_queue": shared_queue}

    # Call the agent with a parameter and invocation state
    response = agent("hello", **invocation_state)

    # Response should be correct
    assert response == "Received: hello"

    # Check the queue for the message
    message = await shared_queue.get()
    assert message == "Processed param: hello"
    assert shared_queue.empty()


@pytest.mark.asyncio
async def test_agent_parameter_in_tool_function():
    """
    Test that the 'agent' parameter is passed to the tool function via invocation_state.
    """

    @tool
    def tool_with_agent_param(param: str, **kwargs):
        agent = kwargs.get("agent")
        assert agent is not None
        assert isinstance(agent, Agent)
        return f"Agent name: {agent.name}, param: {param}"

    agent = Agent(name="main_agent", tools=[tool_with_agent_param])

    # Call agent with invocation_state passing the agent itself
    response = agent("test_param", agent=agent)

    assert response == f"Agent name: main_agent, param: test_param"


@pytest.mark.asyncio
async def test_invocation_state_with_non_serializable_object():
    """
    Test that a non-JSON-serializable object in invocation_state is passed correctly to the tool.
    """

    class CustomObject:
        def __str__(self):
            return "CustomObjectInstance"

    custom_obj = CustomObject()

    @tool
    def tool_receiving_custom_obj(param: str, **kwargs):
        obj = kwargs.get("custom_obj")
        assert obj is custom_obj
        return f"Got param: {param} and object: {obj}"

    agent = Agent(name="agent_with_custom_obj", tools=[tool_receiving_custom_obj])

    response = agent("param_value", custom_obj=custom_obj)

    assert response == "Got param: param_value and object: CustomObjectInstance"


