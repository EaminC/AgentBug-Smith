    async def async_tool(param: str, **kwargs):
        sq = kwargs.get("shared_queue")
        assert sq is shared_queue

        await sq.put(f"Async processed: {param}")
        return f"Async received: {param}"

    agent = Agent(name="async_agent", tools=[async_tool])

    # Run the synchronous call in a thread executor to avoid event loop issues
    response = await asyncio.get_event_loop().run_in_executor(
        None, lambda: agent("async_test", shared_queue=shared_queue)
    )
    assert response == "Async received: async_test"
    # Check that the queue has the expected message
    queued_message = await shared_queue.get()
    assert queued_message == "Async processed: async_test"[0m
