def test_main_archive_behavior():
    """
    Test that main() moves existing memory and workspace to archive
    when they exist, and does not create archive when they don't exist.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        project_path = Path(tmpdir) / "test_project"
        project_path.mkdir()

        # Simulate a previous run by creating memory and workspace directories
        memory_path = project_path / "memory"
        workspace_path = project_path / "workspace"
        memory_path.mkdir()
        workspace_path.mkdir()

        # Put some files in them
        (memory_path / "memory.txt").write_text("old memory")
        (workspace_path / "code.py").write_text("old code")

        # Mock AI to avoid actual API calls
        mock_ai = MagicMock()
        mock_ai.start.return_value = [{"role": "assistant", "content": "test response"}]

        # Patch the AI constructor
        with patch("gpt_engineer.main.AI", return_value=mock_ai):
            # Patch fallback_model to avoid OpenAI API call
            with patch("gpt_engineer.main.fallback_model", return_value="gpt-4"):
                # Capture the DBs instance that gets created
                captured_dbs = []
                original_init = DBs.__init__

                def capturing_init(self, *args, **kwargs):
                    original_init(self, *args, **kwargs)
                    captured_dbs.append(self)

                with patch.object(DBs, "__init__", capturing_init):
                    # Call main with the project path
                    # We need to check if delete_existing parameter exists
                    import inspect

                    sig = inspect.signature(main)
                    params = list(sig.parameters.keys())

                    if "delete_existing" in params:
                        # Buggy version - call with delete_existing=False (default)
                        # This should NOT archive, just use existing directories
                        main(
                            project_path=str(project_path),
                            delete_existing=False,
                            model="gpt-4",
                            temperature=0.1,
                            steps_config=Config.DEFAULT,
                            verbose=False,
                            run_prefix="",
                        )
                        # In buggy version, archive should not exist
                        # and memory/workspace should still be present
                        assert memory_path.exists()
                        assert workspace_path.exists()
                        # archive directory should not be created
                        archive_path = project_path / "archive"
                        assert not archive_path.exists()
                        # DBs.archive should be None (not in buggy version)
                        # Actually buggy version doesn't have archive attribute
                        # So we expect an AttributeError if we try to access it
                        if captured_dbs:
                            dbs_instance = captured_dbs[0]
                            with pytest.raises(AttributeError):
                                _ = dbs_instance.archive
                    else:
                        # Fixed version - no delete_existing parameter
                        # This should archive existing directories
                        main(
                            project_path=str(project_path),
                            model="gpt-4",
                            temperature=0.1,
                            steps_config=Config.DEFAULT,
                            verbose=False,
                            run_prefix="",
                        )
                        # In fixed version, memory and workspace should be moved to archive
                        assert not memory_path.exists()
                        assert not workspace_path.exists()
                        # archive directory should exist
                        archive_path = project_path / "archive"
                        assert archive_path.exists()
                        # There should be a timestamped subdirectory
                        archive_subdirs = list(archive_path.iterdir())
                        assert len(archive_subdirs) == 1
                        timestamp_dir = archive_subdirs[0]
                        assert timestamp_dir.is_dir()
                        # The timestamped directory should contain memory and workspace
                        assert (timestamp_dir / "memory").exists()
                        assert (timestamp_dir / "workspace").exists()
                        # Check that files were moved
                        assert (
                            timestamp_dir / "memory" / "memory.txt"
                        ).read_text() == "old memory"
                        assert (
                            timestamp_dir / "workspace" / "code.py"
                        ).read_text() == "old code"
                        # DBs.archive should be a DB instance
                        if captured_dbs:
                            dbs_instance = captured_dbs[0]
                            assert dbs_instance.archive is not None
                            assert isinstance(dbs_instance.archive, DB)


