def test_archive_moves_memory_and_workspace_to_archive_folder(tmp_path):
    """
    Simulate the behavior of archive step: move memory and workspace to archive/timestamp.
    In buggy code, archive step doesn't exist, so this test will fail because
    archive is not defined (or if defined incorrectly).
    After fix, archive step moves directories.
    """
    # Setup directories similar to main.py
    memory_path = tmp_path / "memory"
    workspace_path = tmp_path / "workspace"
    archive_path = tmp_path / "archive"
    memory_path.mkdir()
    workspace_path.mkdir()
    archive_path.mkdir()

    # Create some files to ensure directories are non-empty
    (memory_path / "file1.txt").write_text("memory content")
    (workspace_path / "file2.txt").write_text("workspace content")

    # Create DBs instance with archive DB (as in fixed code when not initial_run)
    dbs = DBs(
        memory=DB(memory_path),
        logs=DB(memory_path / "logs"),
        input=DB(tmp_path / "input"),
        workspace=DB(workspace_path),
        preprompts=DB(tmp_path / "preprompts"),
        archive=DB(archive_path),
    )

    # Run archive step
    result = archive(None, dbs)  # AI not needed for archive

    # After archive, memory and workspace should be gone from original location
    assert not memory_path.exists()
    assert not workspace_path.exists()

    # They should be inside archive/timestamp
    # We don't know exact timestamp, but we can list archive subdirectories
    archive_subdirs = list(archive_path.iterdir())
    assert len(archive_subdirs) == 1
    timestamp_dir = archive_subdirs[0]
    assert (timestamp_dir / memory_path.name).exists()
    assert (timestamp_dir / workspace_path.name).exists()


