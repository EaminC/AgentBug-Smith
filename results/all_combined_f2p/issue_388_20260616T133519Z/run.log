RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"

# Install project in editable mode with dependencies
RUN pip install --no-cache-dir -e .

# Install test dependencies including pytest (already in pyproject.toml but ensure availability)
RUN pip install --no-cache-dir pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout

# Install litellm for API compatibility with Forge
RUN pip install --no-cache-dir litellm

# Verify installation and imports
RUN python -c "import gpt_engineer, pytest, openai; print('All imports successful')"

# Set final command
CMD ["/bin/bash"][0m
