        # The subdirectory should contain memory and workspace directories.
        assert (subdirs[0] / "memory").exists()
        assert (subdirs[0] / "workspace").exists()
    else:
        # Buggy version: archive does not exist.
        # But memory and workspace should still exist (since delete_existing is false).
        # However, the buggy version has delete_existing parameter default False,
        # so they remain.
        assert memory_path.exists()
        assert workspace_path.exists()


def test_main_without_existing_dirs_no_archive(tmp_path):
    """Test that main does not create archive when memory/workspace are absent."""
    # Fresh project directory, no memory/workspace
    project_path = tmp_path / "project"
    project_path.mkdir()

    runner = CliRunner()
    with patch("gpt_engineer.main.AI") as MockAI:
        mock_ai_instance = MagicMock()
        mock_ai_instance.start.return_value = []
        MockAI.return_value = mock_ai_instance
        with patch("gpt_engineer.main.fallback_model") as mock_fallback:
            mock_fallback.return_value = "gpt-4"
            with patch("gpt_engineer.main.collect_learnings"):
                with patch("gpt_engineer.main.STEPS", STEPS):
                    # Mock steps to a no-op
                    from unittest.mock import Mock
                    mock_step = Mock()
                    with patch("gpt_engineer.main.STEPS", {Config.DEFAULT: [mock_step]}):
                        result = runner.invoke(
                            app,
                            [
                                str(project_path),
                                "--model",
                                "gpt-4",
                                "--temperature",
                                "0.1",
                                "--steps-config",
                                "default",
                                "--run-prefix",
                                "",
                            ],
                        )
    # After fix, archive should not be created because initial_run is True.
    # In buggy version, archive field does not exist.
    # We'll check if archive directory exists.
    archive_path = project_path / "archive"
    # In buggy version, archive directory may not exist (since not created).
    # In fixed version, archive directory should not exist because initial_run=True.
    assert not archive_path.exists()


def test_dbs_archive_field():
    """Test that DBs dataclass has archive field after fix."""
    # In buggy version, DBs has 5 fields.
    # After fix, DBs has 6 fields including archive.
    # This test will fail before patch, pass after.
    # Use dataclasses.fields
    from dataclasses import fields
    fields_list = [f.name for f in fields(DBs)]
    # After fix, fields_list includes 'archive'
