[32mFROM python:3.10-slim AS test_builder

WORKDIR /app

# Set required environment variables for Forge
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Upgrade packaging tools and install system dependencies if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository (ensures external test scripts are present)
COPY . .

# Detect src/ layout to decide on editable install
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." . 2>/dev/null; then \
    echo "src/ layout detected, skipping editable install, setting PYTHONPATH"; \
    ENV_SRC_LAYOUT=true; \
    else \
    echo "No src/ layout, will perform editable install"; \
    ENV_SRC_LAYOUT=false; \
    fi

# Install dependencies based on available lock/manifest files
RUN python -m pip install --upgrade pip setuptools wheel && \
    # Install project dependencies from pyproject.toml (no lockfile present)
    pip install -e . && \
    # Install mandatory testing dependencies
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Preflight import check
RUN python -c 'import pkg_resources, pytest, gpt_engineer; print("preflight ok")'

