    # Run archive step (real function)
    result = archive(None, dbs)

    # After archive, memory and workspace should be gone from original location
    assert not memory_path.exists()
    assert not workspace_path.exists()

    # They should be moved to archive/20240101_123045/
    archive_dir = archive_path / "20240101_123045"
    assert archive_dir.is_dir()
    assert (archive_dir / "memory").is_dir()
    assert (archive_dir / "workspace").is_dir()
    assert (archive_dir / "memory" / "file1.txt").read_text() == "memory content"
    assert (archive_dir / "workspace" / "file2.txt").read_text() == "workspace content"

    # archive returns empty list
    assert result == []


def test_main_without_existing_dirs_no_archive():
    """
    Test that when memory and workspace do NOT exist, archive DB is None.
    In buggy code, archive field does not exist in DBs.
    After fix, archive is a field and can be None.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        project_path = Path(tmpdir) / "project"
        project_path.mkdir()
        # Do NOT create memory/workspace
        prompt_file = project_path / "prompt"
        prompt_file.write_text("test prompt")

        # We need to mock the internal steps to avoid AI calls.
        # Also mock AI constructor.
        with patch("gpt_engineer.main.AI") as MockAI:
            mock_ai_instance = MagicMock()
            mock_ai_instance.start.return_value = []
            MockAI.return_value = mock_ai_instance

            # Capture DBs instance created in main
            captured_dbs = []
            original_dbs_init = DBs.__init__

            def capturing_init(self, *args, **kwargs):
                original_dbs_init(self, *args, **kwargs)
                captured_dbs.append(self)

            with patch.object(DBs, "__init__", capturing_init):
                # Mock steps to avoid execution
                with patch("gpt_engineer.main.STEPS", {Config.DEFAULT: []}):
                    # Run main via typer (but we'll call the function directly to avoid CLI issues)
                    # We'll call the typer command function directly.
                    # The main function expects arguments as per typer decorator.
                    # We'll call it with minimal args.
                    try:
                        typer_main(
