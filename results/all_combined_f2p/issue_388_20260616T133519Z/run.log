def test_archive_step_in_steps_configs():
    """Test that archive step is present in all step configs after fix."""
    # In buggy version, archive is not in any STEPS list.
    # After fix, archive is first step in all configs.
    # This test will fail before patch, pass after.
    for config in Config:
        steps_list = STEPS[config]
        # After fix, first step is archive
        # In buggy version, archive function does not exist, so we cannot import.
        # Instead, check if the first step's __name__ is 'archive' (if it exists).
        # If archive is not defined, the import will fail earlier.
        # We'll just assert that the first step's __name__ is 'archive' after fix.
        # Before fix, the first step is not archive.
        # We'll use a try-except to detect if archive is defined.
        try:
            from gpt_engineer.steps import archive
            # If import succeeds, archive exists (fixed version).
            # Then assert it's the first step.
            assert steps_list[0].__name__ == "archive"
        except ImportError:
            # Buggy version: archive not defined.
            # Then assert that first step is not archive (by checking name).
            # But we cannot know what the first step is; we just know it's not archive.
            # Let's assert that the first step's __name__ is not 'archive' (it can't be).
            # However, the function object may not have __name__? It will.
            # We'll just let the test fail if archive is missing.
            # Actually, we want the test to fail before patch, so we raise AssertionError.
            raise AssertionError("archive step not found in steps config")


def test_main_with_existing_dirs_creates_archive(tmp_path):
    """Test that main moves existing memory/workspace to archive."""
    # Create project directory with memory and workspace
    project_path = tmp_path / "project"
    project_path.mkdir()
    memory_path = project_path / "memory"
    workspace_path = project_path / "workspace"
    memory_path.mkdir()
    workspace_path.mkdir()
    (memory_path / "file.txt").write_text("memory content")
    (workspace_path / "code.py").write_text("workspace content")

    runner = CliRunner()
    with patch("gpt_engineer.main.AI") as MockAI:
        mock_ai_instance = MagicMock()
        mock_ai_instance.start.return_value = []
        MockAI.return_value = mock_ai_instance
        with patch("gpt_engineer.main.fallback_model") as mock_fallback:
            mock_fallback.return_value = "gpt-4"
            with patch("gpt_engineer.main.collect_learnings"):
                with patch("gpt_engineer.main.STEPS", STEPS):
                    # Mock the steps to just call archive (or skip)
                    # We'll mock STEPS to a single step that does nothing.
                    # But we need to test that archive is called.
                    # Instead, we'll directly test that after main runs,
                    # memory and workspace are moved to archive.
