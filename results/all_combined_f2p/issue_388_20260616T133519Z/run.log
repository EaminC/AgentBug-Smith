        workspace_path = project_path / "workspace"
        memory_path.mkdir()
        workspace_path.mkdir()

        # Write a prompt file (required by main)
        prompt_file = project_path / "prompt"
        prompt_file.write_text("Create a simple script")

        # Mock AI to avoid API calls
        with patch("gpt_engineer.main.AI") as MockAI:
            mock_ai_instance = MagicMock()
            mock_ai_instance.start.return_value = []
            MockAI.return_value = mock_ai_instance

            # Mock collect_learnings to avoid analytics
            with patch("gpt_engineer.main.collect_learnings"):
                # Mock steps to avoid actual execution
                with patch("gpt_engineer.main.STEPS") as mock_steps:
                    mock_steps.get.return_value = [lambda ai, dbs: []]

                    # In buggy code, main expects delete_existing argument.
                    # After fix, delete_existing is removed.
                    # We'll use try-except to detect signature mismatch.
                    try:
                        # Attempt to call main with fixed signature (no delete_existing)
                        original_main(
                            project_path=str(project_path),
                            model="gpt-4",
                            temperature=0.1,
                            steps_config=Config.DEFAULT,
                            run_prefix="",
                            verbose=False,
                        )
                    except TypeError as e:
                        # If buggy code, TypeError about missing delete_existing
                        # or unexpected keyword argument.
                        # We'll check if error is about delete_existing.
                        if "delete_existing" in str(e):
                            pytest.fail(
                                f"Buggy code: main still expects delete_existing: {e}"
                            )
                        else:
                            raise

                    # If we get here, the call succeeded.
                    # After fix, archive DB should be created (not None).
                    # We can't directly inspect DBs inside main, but we can check
                    # that the function didn't crash due to missing archive field.
                    # Let's also verify that archive directory exists.
                    archive_path = project_path / "archive"
                    # In the fixed code, when memory/workspace exist, archive is created.
                    # However, the archive step is part of the steps list, not called in main.
                    # The main function creates DBs with archive=None if initial_run.
                    # Since we have memory/workspace, initial_run is False, so archive DB is created.
                    # But we mocked steps, so archive step not executed.
                    # We'll just ensure no exception was raised.
                    assert True


def test_db_archive_field():
    """
    DBs dataclass should have an archive field after fix.
    """
    # In buggy code, DBs has 5 fields; after fix has 6 fields (including archive).
    # This test will fail on buggy code because DBs expects 6 arguments.
    with tempfile.TemporaryDirectory() as tmpdir:
        dirs = ["memory", "logs", "preprompts", "input", "workspace", "archive"]
        paths = [Path(tmpdir) / d for d in dirs]
        for p in paths:
            p.mkdir()
        dbs = [DB(p) for p in paths]
        # If buggy, DBs expects 5 arguments, so this will raise TypeError.
        db_instance = DBs(*dbs)
        # After fix, archive attribute exists.
        assert hasattr(db_instance, "archive")
        assert db_instance.archive is not None


