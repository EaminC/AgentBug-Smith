def test_main_with_existing_dirs_creates_archive():
    """
    When memory and workspace exist, archive DB should be created.
    In buggy code, DBs does not have archive attribute, and main does not create archive.
    After fix, DBs includes archive, and main sets archive DB when dirs exist.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        project_path = Path(tmpdir) / "project"
        project_path.mkdir()
        memory_path = project_path / "memory"
        workspace_path = project_path / "workspace"
        memory_path.mkdir()
        workspace_path.mkdir()

        # Create a dummy file in memory and workspace
        (memory_path / "file.txt").write_text("memory")
        (workspace_path / "app.py").write_text("print('hello')")

        # Mock AI and steps to avoid API calls
        with patch.object(AI, "__init__", return_value=None):
            with patch.object(AI, "start", return_value=[]):
                # We'll call main with minimal mocks.
                # In buggy code, DBs expects 5 arguments; after fix expects 6.
                # We'll test that DBs instantiation works with 6 args (archive present).
                # If buggy, DBs(..., archive=...) will raise TypeError.
                from gpt_engineer.main import main as original_main

                # Patch the steps to avoid real execution
                with patch("gpt_engineer.main.STEPS", {Config.DEFAULT: []}):
                    # Also patch the DBs inside main to capture its construction
                    captured_dbs = None

                    def mock_dbs(*args, **kwargs):
                        nonlocal captured_dbs
                        captured_dbs = DBs(*args, **kwargs)
                        return captured_dbs

                    with patch("gpt_engineer.main.DBs", mock_dbs):
                        # Run main with the existing directories.
                        # We'll call the function directly with mocked typer.
                        # Since main is a typer command, we can invoke it via runner,
                        # but for simplicity we call the underlying function.
                        # We need to mock the arguments as they would be passed by typer.
                        with patch("gpt_engineer.main.fallback_model", return_value="gpt-4"):
                            # In buggy code, main expects delete_existing argument.
                            # After fix, delete_existing is removed.
                            # We'll use try-except to detect signature mismatch.
                            try:
                                # Attempt to call main with fixed signature (no delete_existing)
                                original_main(
                                    project_path=str(project_path),
                                    model="gpt-4",
                                    temperature=0.1,
                                    steps_config=Config.DEFAULT,
                                    run_prefix="",
                                    verbose=False,
                                )
                            except TypeError as e:
                                # If buggy code, main expects delete_existing,
                                # so we call with extra argument.
                                if "delete_existing" in str(e):
                                    # This is the buggy behavior; test should fail.
                                    # We'll raise an assertion error to make test fail.
                                    raise AssertionError(
                                        "Buggy code: delete_existing parameter still present"
                                    )
                                else:
                                    raise

                # If we reach here in fixed code, captured_dbs should have archive.
                if captured_dbs is not None:
                    assert hasattr(captured_dbs, "archive")
                    # Since directories exist, archive should be a DB instance (not None).
                    assert captured_dbs.archive is not None
                    assert isinstance(captured_dbs.archive, DB)


