def test_archive_function_moves_dirs(tmp_path):
    # Simulate existing memory and workspace
    memory_path = tmp_path / "memory"
    workspace_path = tmp_path / "workspace"
    archive_path = tmp_path / "archive"
    memory_path.mkdir()
    workspace_path.mkdir()
    (memory_path / "file1.txt").write_text("memory content")
    (workspace_path / "file2.txt").write_text("workspace content")

    dbs = DBs(
        memory=DB(memory_path),
        logs=DB(memory_path / "logs"),
        input=DB(tmp_path),
        workspace=DB(workspace_path),
        preprompts=DB(Path(__file__).parent.parent / "gpt_engineer" / "preprompts"),
        archive=DB(archive_path),
    )

    # Mock AI (not used by archive)
    mock_ai = MagicMock(spec=AI)

    # Run archive step
    result = archive(mock_ai, dbs)

    # Should return empty list
    assert result == []

    # memory and workspace should be gone
    assert not memory_path.exists()
    assert not workspace_path.exists()

    # archive directory should exist
    assert archive_path.exists()

    # There should be exactly one timestamped subdirectory
    subdirs = list(archive_path.iterdir())
    assert len(subdirs) == 1
    timestamp_dir = subdirs[0]
    assert timestamp_dir.is_dir()

    # The subdirectory should contain moved memory and workspace
    assert (timestamp_dir / "memory").exists()
    assert (timestamp_dir / "workspace").exists()
    assert (timestamp_dir / "memory" / "file1.txt").read_text() == "memory content"
    assert (timestamp_dir / "workspace" / "file2.txt").read_text() == "workspace content"


