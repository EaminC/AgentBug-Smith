[32mimport json
import os
import shutil
import tempfile
from pathlib import Path
from unittest.mock import MagicMock, patch

import pytest
import typer

from gpt_engineer.db import DB, DBs
from gpt_engineer.main import main as gpt_engineer_main
from gpt_engineer.steps import Config, STEPS


def test_main_archive_behavior():
    """
    Test that when main runs with existing memory/workspace directories,
    they are moved to archive and new empty directories are created.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        project_path = Path(tmpdir) / "test_project"
        project_path.mkdir()

        # Simulate a previous run by creating memory and workspace directories
        memory_path = project_path / "memory"
        workspace_path = project_path / "workspace"
        memory_path.mkdir()
        workspace_path.mkdir()

        # Put some files in them
        (memory_path / "memory.txt").write_text("old memory")
        (workspace_path / "code.py").write_text("old code")

        # Mock AI to avoid actual API calls
        mock_ai = MagicMock()
        mock_ai.start.return_value = [
            {"role": "assistant", "content": "test response"}
        ]

        # Mock the steps to only run archive and then stop
        # We'll patch the STEPS dict to only include archive
        original_steps = STEPS[Config.DEFAULT]
        try:
            from gpt_engineer.steps import archive
            STEPS[Config.DEFAULT] = [archive]
        except ImportError:
            # If archive isn't imported yet (buggy code), we need to define it
            import datetime
            import shutil as shutil_module
            import os as os_module

            def archive(ai, dbs):
                os_module.makedirs(dbs.archive.path, exist_ok=True)
                timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
                shutil_module.move(dbs.memory.path, dbs.archive.path / timestamp / dbs.memory.path.name)
                shutil_module.move(
                    dbs.workspace.path, dbs.archive.path / timestamp / dbs.workspace.path.name
                )
                return []

            STEPS[Config.DEFAULT] = [archive]

        # Mock the AI constructor to return our mock
        with patch("gpt_engineer.main.AI", return_value=mock_ai):
            # Mock typer to capture arguments and call our function directly
            # We'll call the main function directly with the arguments
            from gpt_engineer.main import main as original_main

            # Call main with the project path
            # In buggy code, delete_existing parameter exists
            # In fixed code, it doesn't
            # We'll try both signatures
            import inspect
            sig = inspect.signature(original_main)
            params = list(sig.parameters.keys())

            if "delete_existing" in params:
                # Buggy version - call with delete_existing=False (default)
                # This should NOT archive, just use existing directories
                original_main(
                    project_path=str(project_path),
                    delete_existing=False,
                    model="gpt-4",
                    temperature=0.1,
                    steps_config=Config.DEFAULT,
                    verbose=False,
                    run_prefix="",
                )
            else:
                # Fixed version - no delete_existing parameter
                # This should archive existing directories
                original_main(
                    project_path=str(project_path),
                    model="gpt-4",
                    temperature=0.1,
                    steps_config=Config.DEFAULT,
                    verbose=False,
                    run_prefix="",
                )

        # Restore original steps
        STEPS[Config.DEFAULT] = original_steps

        # Check the state
        archive_path = project_path / "archive"
        
        if "delete_existing" in params:
            # Buggy version: memory and workspace should still exist with their files
            # and archive should not exist
            assert memory_path.exists(), "Buggy: memory should still exist"
            assert workspace_path.exists(), "Buggy: workspace should still exist"
            assert (memory_path / "memory.txt").exists(), "Buggy: memory file should exist"
            assert (workspace_path / "code.py").exists(), "Buggy: workspace file should exist"
            # In buggy code, archive directory might not be created at all
            # or might be None in DBs
            pass
        else:
            # Fixed version: memory and workspace should be empty/new directories
            # and old contents should be in archive
            assert memory_path.exists(), "Fixed: new memory directory should exist"
            assert workspace_path.exists(), "Fixed: new workspace directory should exist"
            
            # Original files should not be in the new directories
            # (they might be empty or have new files from the run)
            # The key assertion: archive should contain the old files
            assert archive_path.exists(), "Fixed: archive directory should exist"
            
            # Find the timestamped archive directory
            archive_dirs = list(archive_path.iterdir())
            assert len(archive_dirs) > 0, "Fixed: should have at least one archive directory"
            
            # Check that the archived directories contain our files
            archived_memory_found = False
            archived_workspace_found = False
            
            for archive_dir in archive_dirs:
                archived_memory = archive_dir / "memory"
                archived_workspace = archive_dir / "workspace"
                
                if archived_memory.exists():
                    assert (archived_memory / "memory.txt").exists()
                    archived_memory_found = True
                if archived_workspace.exists():
                    assert (archived_workspace / "code.py").exists()
                    archived_workspace_found = True
            
            assert archived_memory_found, "Fixed: old memory should be archived"
            assert archived_workspace_found, "Fixed: old workspace should be archived"


def test_main_without_existing_dirs():
    """
    Test that when main runs without existing memory/workspace directories,
    archive is None in DBs.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        project_path = Path(tmpdir) / "new_project"
        project_path.mkdir()

        # Mock AI
        mock_ai = MagicMock()
        mock_ai.start.return_value = [
            {"role": "assistant", "content": "test response"}
        ]

        # Patch steps to do nothing so we can inspect DBs
        original_steps = STEPS[Config.DEFAULT]
        STEPS[Config.DEFAULT] = []  # Empty steps list

        with patch("gpt_engineer.main.AI", return_value=mock_ai):
            from gpt_engineer.main import main as original_main
            
            import inspect
            sig = inspect.signature(original_main)
            
            # We need to capture the DBs instance that gets created
            # Patch DBs.__init__ to capture the instance
            captured_dbs = []
            original_init = DBs.__init__
            
            def capturing_init(self, *args, **kwargs):
                original_init(self, *args, **kwargs)
                captured_dbs.append(self)
            
            with patch.object(DBs, '__init__', capturing_init):
                if "delete_existing" in sig.parameters:
                    original_main(
                        project_path=str(project_path),
                        delete_existing=False,
                        model="gpt-4",
                        temperature=0.1,
                        steps_config=Config.DEFAULT,
                        verbose=False,
                        run_prefix="",
                    )
                else:
                    original_main(
                        project_path=str(project_path),
                        model="gpt-4",
                        temperature=0.1,
                        steps_config=Config.DEFAULT,
                        verbose=False,
                        run_prefix="",
                    )
        
        # Restore
        STEPS[Config.DEFAULT] = original_steps
        
        # Check the captured DBs
        assert len(captured_dbs) > 0, "Should have created a DBs instance"
        dbs = captured_dbs[0]
        
        if "delete_existing" in sig.parameters:
            # Buggy version: archive attribute doesn't exist
            assert not hasattr(dbs, 'archive'), "Buggy: DBs should not have archive attribute"
        else:
            # Fixed version: archive should be None for initial run
            assert hasattr(dbs, 'archive'), "Fixed: DBs should have archive attribute"
            assert dbs.archive is None, "Fixed: archive should be None for initial run"


if __name__ == "__main__":
    pytest.main([__file__, "-v"])[0m
