def test_archive_step_moves_directories(tmp_path, monkeypatch):
    """Test the archive step function directly."""
    # This test imports archive from steps.
    # In buggy version, archive does not exist -> ImportError.
    # That will cause test collection error, which is a failure.
    # After fix, archive exists and can be tested.
    from gpt_engineer.steps import archive
    # Create DBs with memory, workspace, archive
    memory_path = tmp_path / "memory"
    workspace_path = tmp_path / "workspace"
    archive_path = tmp_path / "archive"
    memory_path.mkdir()
    workspace_path.mkdir()
    (memory_path / "file.txt").write_text("test")
    (workspace_path / "app.py").write_text("code")
    dbs = DBs(
        memory=DB(memory_path),
        logs=DB(tmp_path / "logs"),
        preprompts=DB(tmp_path / "preprompts"),
        input=DB(tmp_path / "input"),
        workspace=DB(workspace_path),
        archive=DB(archive_path),
    )
    # Mock datetime to have fixed timestamp
    import datetime
    fake_now = datetime.datetime(2024, 1, 1, 12, 30, 45)
    datetime_mock = MagicMock(wraps=datetime.datetime)
    datetime_mock.now.return_value = fake_now
    monkeypatch.setattr(datetime, "datetime", datetime_mock)
    # Run archive step
    archive(None, dbs)
    # Check that memory and workspace are moved
    assert not memory_path.exists()
    assert not workspace_path.exists()
    expected_subdir = archive_path / "20240101_123045"
    assert expected_subdir.exists()
    assert (expected_subdir / "memory").exists()
    assert (expected_subdir / "workspace").exists()
    assert (expected_subdir / "memory" / "file.txt").read_text() == "test"
    assert (expected_subdir / "workspace" / "app.py").read_text() == "code"


