def test_main_with_existing_dirs_creates_archive():
    """
    When memory and workspace exist, archive DB should be created.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        project_path = Path(tmpdir) / "project"
        project_path.mkdir()
        memory_path = project_path / "memory"
        workspace_path = project_path / "workspace"
        memory_path.mkdir()
        workspace_path.mkdir()

        # Create a dummy file in memory and workspace
        (memory_path / "file.txt").write_text("memory")
        (workspace_path / "app.py").write_text("print('hello')")

        # Mock AI and steps to avoid API calls
        with patch.object(AI, "__init__", return_value=None):
            with patch.object(AI, "start", return_value=[]):
                # We'll patch the steps execution to just call archive
                # and verify it moves directories.
                pass

        # Simpler: test archive step directly
        archive_path = project_path / "archive"
        dbs = DBs(
            memory=DB(memory_path),
            logs=DB(memory_path / "logs"),
            input=DB(project_path),
            workspace=DB(workspace_path),
            preprompts=DB(Path(__file__).parent.parent / "gpt_engineer" / "preprompts"),
            archive=DB(archive_path),
        )
        # Before fix, archive step doesn't exist -> ImportError.
        # After fix, archive exists and moves directories.
        # We'll mock datetime to have a fixed timestamp.
        import datetime
        from unittest.mock import patch

        fixed_time = datetime.datetime(2025, 1, 1, 12, 0, 0)
        with patch("datetime.datetime") as mock_datetime:
            mock_datetime.now.return_value = fixed_time
            archive(None, dbs)

        # Check that memory and workspace are moved
        assert not memory_path.exists()
        assert not workspace_path.exists()
        archived_dir = archive_path / "20250101_120000"
        assert archived_dir.exists()
        assert (archived_dir / "memory").exists()
        assert (archived_dir / "workspace").exists()
        assert (archived_dir / "memory" / "file.txt").read_text() == "memory"
        assert (archived_dir / "workspace" / "app.py").read_text() == "print('hello')"


def test_cli_archive_behavior(monkeypatch):
    """
    Test CLI behavior: when memory/workspace exist, archive step is used.
    Mock the internal steps to avoid actual API calls.
    """
    from typer.testing import CliRunner

    runner = CliRunner()
    with tempfile.TemporaryDirectory() as tmpdir:
        project_path = Path(tmpdir) / "project"
        project_path.mkdir()
        memory_path = project_path / "memory"
        workspace_path = project_path / "workspace"
        memory_path.mkdir()
        workspace_path.mkdir()

        # Write a prompt file
        prompt_file = project_path / "prompt"
        prompt_file.write_text("Create a simple script")

        # We'll monkeypatch the steps to avoid real AI calls
        from gpt_engineer import steps as steps_module

        original_steps = steps_module.STEPS

        # Create a mock step that just records calls
        call_log = []

        def mock_archive_step(ai, dbs):
            call_log.append("archive_called")
            return []

        # Replace STEPS with a config that includes our mock archive
        monkeypatch.setitem(
            steps_module.STEPS,
            Config.DEFAULT,
            [mock_archive_step],
        )

        # Also mock AI constructor to avoid needing API key
        from gpt_engineer import ai

        class MockAI:
            def __init__(self, *args, **kwargs):
                pass

            def start(self, *args, **kwargs):
                return []

        monkeypatch.setattr(ai, "AI", MockAI)

        # Run CLI via typer runner
        result = runner.invoke(
            typer_main,
            [str(project_path), "--steps-config", "default"],
            catch_exceptions=False,
        )
        assert result.exit_code == 0
        assert "archive_called" in call_log


