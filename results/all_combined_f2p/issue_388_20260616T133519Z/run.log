def test_main_with_existing_dirs_creates_archive(tmp_path):
    # Create a project directory with existing memory and workspace
    project_path = tmp_path / "project"
    project_path.mkdir()
    memory_path = project_path / "memory"
    workspace_path = project_path / "workspace"
    memory_path.mkdir()
    workspace_path.mkdir()
    (memory_path / "old.txt").write_text("old memory")
    (workspace_path / "old.py").write_text("old workspace")

    runner = CliRunner()

    # Mock the AI class to avoid real API calls
    with patch("gpt_engineer.main.AI") as MockAI:
        mock_ai_instance = MagicMock()
        mock_ai_instance.start.return_value = []
        MockAI.return_value = mock_ai_instance

        # Mock fallback_model to avoid OpenAI call
        with patch("gpt_engineer.main.fallback_model") as mock_fallback:
            mock_fallback.return_value = "gpt-4"

            # Mock collect_learnings to avoid analytics
            with patch("gpt_engineer.main.collect_learnings"):
                # Mock steps to avoid actual execution
                with patch("gpt_engineer.main.STEPS") as mock_steps:
                    mock_steps.get.return_value = [lambda ai, dbs: []]

                    # In buggy code, main expects delete_existing argument.
                    # After fix, delete_existing is removed.
                    # We'll use try-except to detect signature mismatch.
                    try:
                        # Attempt to call main with fixed signature (no delete_existing)
                        result = runner.invoke(
                            app,
                            [
                                "main",
                                str(project_path),
                                "--model",
                                "gpt-4",
                                "--temperature",
                                "0.1",
                                "--steps-config",
                                "default",
                                "--run-prefix",
                                "",
                            ],
                        )
                        # If we reach here, the call succeeded (no TypeError about delete_existing).
                        # That means the fix is applied (signature changed).
                        # The test should pass after fix.
                        assert result.exit_code == 0
                    except TypeError as e:
                        # If we get a TypeError about missing delete_existing,
                        # that's the buggy version. The test should fail.
                        if "delete_existing" in str(e):
                            pytest.fail(
                                "Buggy version: main still expects delete_existing argument"
                            )
                        else:
                            raise


