def test_archive_step_moves_directories(tmp_path):
    """
    Test that the archive step moves memory and workspace directories
    into a timestamped subdirectory under archive.
    """
    # Setup directories
    memory_path = tmp_path / "memory"
    workspace_path = tmp_path / "workspace"
    archive_path = tmp_path / "archive"
    memory_path.mkdir()
    workspace_path.mkdir()
    archive_path.mkdir()
    (memory_path / "file.txt").write_text("memory content")
    (workspace_path / "code.py").write_text("workspace content")

    # Create DBs with archive DB
    dbs = DBs(
        memory=DB(memory_path),
        logs=DB(tmp_path / "logs"),
        preprompts=DB(tmp_path / "preprompts"),
        input=DB(tmp_path / "input"),
        workspace=DB(workspace_path),
        archive=DB(archive_path),
    )

    # Mock datetime to have a predictable timestamp
    with patch("datetime.datetime") as mock_datetime:
        mock_datetime.now.return_value.strftime.return_value = "20201225_170555"
        # Call archive with a dummy AI (not used)
        archive(None, dbs)

    # Assert original directories are gone
    assert not memory_path.exists()
    assert not workspace_path.exists()

    # Assert they are moved to timestamped subdirectory
    archived_memory = archive_path / "20201225_170555" / "memory"
    archived_workspace = archive_path / "20201225_170555" / "workspace"
    assert archived_memory.exists()
    assert archived_workspace.exists()
    assert (archived_memory / "file.txt").read_text() == "memory content"
    assert (archived_workspace / "code.py").read_text() == "workspace content"


