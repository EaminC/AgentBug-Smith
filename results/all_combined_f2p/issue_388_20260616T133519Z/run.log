            # Check that DBs was instantiated with archive=None (since no existing dirs)
            assert len(captured_dbs) > 0
            dbs = captured_dbs[-1]
            # In buggy code, archive attribute does not exist -> AttributeError
            # After fix, archive exists and is None.
            assert dbs.archive is None


