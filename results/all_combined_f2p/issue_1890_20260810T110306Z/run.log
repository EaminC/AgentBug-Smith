+	created_at: string;
+};
+
+const hitlKey = (e: { worker_session_id: string; reply_id: string }) =>
+	`${e.worker_session_id}:${e.reply_id}`;
+
 /**
  * Manages messages for a single ``(agentId, sessionId)`` pair.
  *
