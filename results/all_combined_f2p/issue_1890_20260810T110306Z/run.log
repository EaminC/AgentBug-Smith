        )
        # Drain the pre-existing wakeups so subsequent assertions only
        # see what TeamSay enqueues.
        await self.bus.dequeue_wakeups(max_count=100)
        # Resolve worker IDs.
        sess = await self.storage.get_session(
            self.user_id,
            self.leader_agent.id,
