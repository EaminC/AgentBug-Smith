import unittest.mock

from strands.models.anthropic import AnthropicModel
from strands.models.bedrock import BedrockModel


@pytest.mark.asyncio
async def test_anthropic_tool_choice_pass_fail(monkeypatch, alist):
    # Setup AnthropicModel with mocked client and stream
    model = AnthropicModel(model_id="m1", max_tokens=1)

    # Prepare tool specs and tool_choice
    tool_specs = [{"description": "test tool", "name": "test_tool", "inputSchema": {"json": {"key": "value"}}}]
    tool_choice = {"auto": {}}

    # Mock the client's stream method to yield a simple event
    async def fake_stream(*args, **kwargs):
        yield {"messageStart": {"role": "assistant"}}
        yield {"messageStop": {"stopReason": "end_turn"}}

    monkeypatch.setattr(model, "stream", lambda *args, **kwargs: fake_stream())

    # Call format_request with tool_choice and verify tool_choice is included correctly
    request = model.format_request([{"role": "user", "content": [{"text": "hello"}]}], tool_specs, tool_choice=tool_choice)
    assert "tool_choice" in request
    assert request["tool_choice"] == {"type": "auto"}

    # Call stream with tool_choice and verify it yields expected events
    events = [event async for event in model.stream([{"role": "user", "content": [{"text": "hello"}]}], tool_specs, tool_choice=tool_choice)]
    assert events[0] == {"messageStart": {"role": "assistant"}}
    assert events[-1] == {"messageStop": {"stopReason": "end_turn"}}


@pytest.mark.asyncio
async def test_bedrock_tool_choice_pass_fail(monkeypatch, alist):
    # Setup BedrockModel with mocked client and stream
    model = BedrockModel(model_id="m1")

    # Prepare tool specs and tool_choice
    tool_spec = {
        "name": "test_tool",
        "description": "test tool",
        "inputSchema": {"json": {"key": "value"}},
    }
    tool_choice = {"auto": {}}

    # Mock the client's converse_stream method to yield a simple event
    async def fake_stream(*args, **kwargs):
        yield {"messageStart": {"role": "assistant"}}
        yield {"messageStop": {"stopReason": "end_turn"}}

    monkeypatch.setattr(model, "converse_stream", lambda **kwargs: fake_stream())

    # Call format_request with tool_choice and verify toolChoice is included correctly
    request = model.format_request([{"role": "user", "content": [{"text": "hello"}]}], [tool_spec], tool_choice=tool_choice)
    assert "toolConfig" in request
    assert "toolChoice" in request["toolConfig"]
    assert request["toolConfig"]["toolChoice"] == tool_choice

    # Call stream with tool_choice and verify it yields expected events
    events = [event async for event in model.stream([{"role": "user", "content": [{"text": "hello"}]}], [tool_spec], tool_choice=tool_choice)]
    assert events[0] == {"messageStart": {"role": "assistant"}}
    assert events[-1] == {"messageStop": {"stopReason": "end_turn"}}


@pytest.mark.asyncio
async def test_anthropic_structured_output_tool_choice(monkeypatch, alist):
    model = AnthropicModel(model_id="m1", max_tokens=1)

    class OutputModel:
        def __init__(self, name, age):
            self.name = name
            self.age = age

        def __eq__(self, other):
            return isinstance(other, OutputModel) and self.name == other.name and self.age == other.age

    # Prepare tool spec conversion function to simulate convert_pydantic_to_tool_spec
    def fake_convert_pydantic_to_tool_spec(cls):
        return {"name": "OutputModel", "description": "desc", "inputSchema": {"json": {}}}

    monkeypatch.setattr("strands.models.anthropic.convert_pydantic_to_tool_spec", fake_convert_pydantic_to_tool_spec)

    # Mock the stream method to yield a tool_use event with JSON matching OutputModel
    async def fake_stream(*args, **kwargs):
        yield {"messageStart": {"role": "assistant"}}
        yield {"contentBlockStart": {"start": {"toolUse": {"toolUseId": "123", "name": "OutputModel"}}}}
        yield {"contentBlockDelta": {"delta": {"input_json_delta": '{"name": "John", "age": 30}'}}}
        yield {"contentBlockStop": {}}
        yield {"messageStop": {"stopReason": "tool_use"}}
        yield {"output": OutputModel("John", 30)}

    monkeypatch.setattr(model, "stream", lambda *args, **kwargs: fake_stream())

    # Call structured_output with tool_choice
    tool_choice = {"any": {}}
    stream = model.structured_output(OutputModel, [{"role": "user", "content": [{"text": "Generate a person"}]}], tool_choice=tool_choice)
    events = [event async for event in stream]

    # The last event should contain the output model instance
    assert isinstance(events[-1], dict)
    assert "output" in events[-1]
    assert events[-1]["output"] == OutputModel("John", 30)


