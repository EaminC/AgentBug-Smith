async def test_structured_output_forces_output(monkeypatch):
    # This test ensures structured_output always returns a value even if model doesn't produce output
    from strands import Agent
    from pydantic import BaseModel

    class DummyModel(BaseModel):
        time: str
        weather: str

    # Create a dummy model that returns empty stream
    class DummyProvider:
        def __init__(self):
            pass

        def structured_output(self, output_model_cls, prompt, **kwargs):
            async def gen():
                yield {"output": output_model_cls(time="now", weather="sunny")}

            return gen()

    agent = Agent(DummyProvider())

    result = agent.structured_output(DummyModel, "How are you?")

    # The result is an async generator, consume it
    import asyncio

    async def consume():
        last = None
        async for event in result:
            last = event
        return last

    output = asyncio.run(consume())

    assert output is not None
    assert "output" in output
    assert isinstance(output["output"], DummyModel)
    assert len(output["output"].time) > 0
    assert len(output["output"].weather) > 0[0m
