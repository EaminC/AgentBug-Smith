    request = model.format_request(messages, [tool_spec], tool_choice=tool_choice)
    assert "tool_choice" in request
    assert request["tool_choice"] == {"type": "auto"}

    # Test streaming with tool_choice parameter propagates correctly
    model.converse = lambda **kwargs: None  # dummy to avoid real call
    # We patch stream to test that tool_choice is passed to format_request internally
