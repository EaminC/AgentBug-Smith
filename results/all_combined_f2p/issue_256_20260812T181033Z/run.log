@pytest.mark.asyncio
async def test_bedrock_stream_tool_choice_propagation(bedrock_client, model_id, alist):
    model = BedrockModel(model_id=model_id)
    messages = [{"role": "user", "content": [{"text": "test"}]}]
    tool_spec = {
        "name": "test_tool",
        "description": "test tool",
        "inputSchema": {"json": {"key": "value"}},
    }
    tool_choice = {"auto": {}}

    # Setup mock response for converse_stream
    bedrock_client.converse_stream.return_value = {"stream": ["chunk1", "chunk2"]}

    response = model.stream(messages, [tool_spec], tool_choice=tool_choice)
    chunks = await alist(response)

    assert chunks == ["chunk1", "chunk2"]

    expected_request = {
        "inferenceConfig": {},
        "modelId": model_id,
        "messages": messages,
        "system": [],
        "toolConfig": {
            "tools": [{"toolSpec": tool_spec}],
            "toolChoice": tool_choice,
        },
    }
    bedrock_client.converse_stream.assert_called_once_with(**expected_request)


@pytest.mark.asyncio
async def test_bedrock_structured_output_tool_choice_passed(bedrock_client, model_id, alist):
    model = BedrockModel(model_id=model_id)

    class TestOutputModel:
        def __init__(self, name, age):
            self.name = name
            self.age = age

        def __eq__(self, other):
            return isinstance(other, TestOutputModel) and self.name == other.name and self.age == other.age

    # Mock tool spec conversion
    tool_spec = {
        "name": "TestOutputModel",
        "description": "desc",
        "inputSchema": {"json": {}},
    }

    # Mock the internal stream method to check tool_choice is passed
    async def mock_stream(*args, **kwargs):
        assert "tool_choice" in kwargs
        assert kwargs["tool_choice"] == {"any": {}}
        yield {"output": TestOutputModel("John", 30)}

    model.stream = mock_stream

    messages = [{"role": "user", "content": [{"text": "Generate a person"}]}]

    # The structured_output method should force tool_choice={"any": {}}
    stream = model.structured_output(TestOutputModel, messages)
    events = await alist(stream)

    assert events[-1] == {"output": TestOutputModel("John", 30)}


@pytest.mark.asyncio
async def test_bedrock_stream_stop_reason_override_tool_use(bedrock_client, model_id, alist):
    model = BedrockModel(model_id=model_id)
    messages = [{"role": "user", "content": [{"text": "test"}]}]
    tool_spec = {
        "name": "test_tool",
        "description": "test tool",
        "inputSchema": {"json": {"key": "value"}},
    }
    tool_choice = {"auto": {}}

    # Setup mock response with tool use detected and stopReason "end_turn"
    bedrock_client.converse_stream.return_value = {
        "stream": [
            {"messageStart": {"role": "assistant"}},
            {"contentBlockStart": {"start": {"toolUse": {"toolUseId": "123", "name": "test_tool"}}}},
            {"contentBlockDelta": {"delta": {"test": {"input": '{"param": "value"}'}}}},
            {"contentBlockStop": {}},
            {"messageStop": {"stopReason": "end_turn"}},
        ]
    }

    response = model.stream(messages, [tool_spec], tool_choice=tool_choice)
    events = await alist(response)

    message_stop_event = next(event for event in events if "messageStop" in event)
    assert message_stop_event["messageStop"]["stopReason"] == "tool_use"


@pytest.mark.asyncio
async def test_bedrock_stream_stop_reason_override_non_streaming(bedrock_client, model_id, alist):
