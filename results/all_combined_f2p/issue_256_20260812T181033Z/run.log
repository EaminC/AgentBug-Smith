def test_anthropic_structured_output_tool_choice_auto(anthropic_model):
    class Person(pydantic.BaseModel):
        name: str
        age: int

    messages = [{"role": "user", "content": [{"text": "Generate a person"}]}]

    # The structured_output method internally uses tool_choice={"any": {}}
    # We test that the output is correctly parsed into the model instance
    stream = anthropic_model.structured_output(Person, messages)

    # The stream is async generator, so we consume it
    # We expect the last yielded event to contain the parsed output model
    import asyncio

    async def consume():
        last = None
        async for event in stream:
            last = event
        return last

    result = asyncio.run(consume())

    assert "output" in result
    assert isinstance(result["output"], Person)


