@pytest.mark.asyncio
async def test_tool_choice_warning_for_unsupported(monkeypatch, capsys):
    # Test that providing tool_choice to a model that does not support it emits a warning
    from strands.models.llamaapi import LlamaAPIModel

    model = LlamaAPIModel(model_id="test-model")

    # Patch format_request to track calls
    monkeypatch.setattr(model, "format_request", lambda *args, **kwargs: {"dummy": "request"})

    # Patch the internal client call to return an async generator
    async def fake_stream(*args, **kwargs):
        yield {"messageStart": {"role": "assistant"}}

    monkeypatch.setattr(model.client, "chat", type("Chat", (), {"completions": type("Completions", (), {"create": lambda *a, **k: fake_stream()})()})())

    # Call stream with tool_choice, should emit warning
    import warnings

    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        async for _ in model.stream([{"role": "user", "content": [{"text": "hi"}]}], tool_choice={"auto": {}}):
            pass

        assert any("ToolChoice was provided to this provider but is not supported" in str(warn.message) for warn in w)


