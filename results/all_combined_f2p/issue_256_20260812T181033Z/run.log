@pytest.mark.asyncio
async def test_tool_choice_warning_for_unsupported(monkeypatch, captured_warnings, alist):
    # Use a model that does not support tool_choice (e.g. LlamaAPIModel)
    from strands.models.llamaapi import LlamaAPIModel

    model = LlamaAPIModel(model_id="m1")

    tool_choice = {"auto": {}}

    # Mock the client's chat.completions.create to yield a dummy event
    async def fake_create(*args, **kwargs):
        yield {"messageStart": {"role": "assistant"}}
        yield {"messageStop": {"stopReason": "end_turn"}}

    monkeypatch.setattr(model.client.chat.completions, "create", lambda *args, **kwargs: fake_create())

    # Call stream with tool_choice and verify warning is emitted
    events = [event async for event in model.stream([{"role": "user", "content": [{"text": "hello"}]}], tool_choice=tool_choice)]

    assert len(captured_warnings) == 1
    assert "ToolChoice was provided to this provider but is not supported" in str(captured_warnings[0].message)


