import unittest.mock


@pytest.mark.asyncio
async def test_bedrock_structured_output_tool_choice_propagation(bedrock_client, model, test_output_model_cls, alist):
    """
    Test that BedrockModel.structured_output passes the tool_choice parameter correctly,
    and that the tool_choice is included in the request with the expected value.
    """
    messages = [{"role": "user", "content": [{"text": "Generate a person"}]}]

    # Prepare a tool_spec from the output model class
    tool_spec = {
        "name": "TestOutputModel",
        "description": "Test output model tool",
        "inputSchema": {"json": {"type": "object", "properties": {"name": {"type": "string"}, "age": {"type": "integer"}}}},
    }

    # Setup the mock to capture the request
    captured_requests = []

    async def mock_converse_stream(**kwargs):
        captured_requests.append(kwargs)
        # Simulate streaming response events
        yield {"messageStart": {"role": "assistant"}}
        yield {"contentBlockStart": {"start": {"toolUse": {"toolUseId": "123", "name": "TestOutputModel"}}}}
        yield {"contentBlockDelta": {"delta": {"toolUse": {"input": '{"name": "John", "age": 30}'}}}}
        yield {"contentBlockStop": {}}
        yield {"messageStop": {"stopReason": "tool_use"}}

    bedrock_client.converse_stream.side_effect = mock_converse_stream

    # Call structured_output with a specific tool_choice
    tool_choice = {"tool": {"name": "TestOutputModel"}}
    stream = model.structured_output(test_output_model_cls, messages, tool_choice=tool_choice)
    events = await alist(stream)

    # The last event should contain the parsed output model instance
    assert events[-1] == {"output": test_output_model_cls(name="John", age=30)}

    # Check that the request included the tool_choice parameter as expected
    assert len(captured_requests) == 1
    request = captured_requests[0]
    # The toolConfig should include the toolChoice with the passed tool_choice dict
    assert "toolConfig" in request
    assert "toolChoice" in request["toolConfig"]
    assert request["toolConfig"]["toolChoice"] == tool_choice


