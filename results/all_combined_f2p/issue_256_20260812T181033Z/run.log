@pytest.mark.asyncio
async def test_bedrock_tool_choice_in_format_request_and_stream(
    model: BedrockModel, messages, tool_spec
):
    tool_choice = {"auto": {}}
    request = model.format_request(messages, [tool_spec], tool_choice=tool_choice)
    assert "toolChoice" in request.get("toolConfig", {})
    assert request["toolConfig"]["toolChoice"] == tool_choice

    # Test streaming with tool_choice parameter propagates correctly
    # Mock the client method to capture call args
    model.client.converse_stream.return_value = {"stream": []}
    await anext(model.stream(messages, [tool_spec], tool_choice=tool_choice), None)
    call_args = model.client.converse_stream.call_args[1]
    assert "toolChoice" in call_args.get("toolConfig", {})
    assert call_args["toolConfig"]["toolChoice"] == tool_choice


@pytest.mark.asyncio
