        mock_choice.message.parsed = test_output_model_cls(name="John", age=30)
        mock_response = unittest.mock.Mock()
        mock_response.choices = [mock_choice]
        return [mock_response]

    openai_client.beta.chat.completions.parse = unittest.mock.AsyncMock(side_effect=mock_create)

    # Call structured_output with a specific tool_choice
    tool_choice = {"tool": {"name": "test_tool"}}
    stream = model.structured_output(test_output_model_cls, messages, tool_choice=tool_choice)
    events = await alist(stream)

    # The last event should contain the parsed output model instance
    assert events[-1] == {"output": test_output_model_cls(name="John", age=30)}

    # Check that the request included the tool_choice parameter as expected
    assert len(captured_requests) == 1
    request = captured_requests[0]
    assert "tool_choice" in request
    # The tool_choice should be formatted as per OpenAIModel._format_request_tool_choice
    assert request["tool_choice"] == {"type": "function", "function": {"name": "test_tool"}}


