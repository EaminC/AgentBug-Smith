    model.stream.assert_called_once()
    _, kwargs = model.stream.call_args
    assert "tool_choice" in kwargs
    assert kwargs["tool_choice"] == {"any": {}}


@pytest.mark.asyncio
async def test_bedrock_structured_output_invokes_stream_with_tool_choice(model_id, bedrock_client, test_output_model_cls):
