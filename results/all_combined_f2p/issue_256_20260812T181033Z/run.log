            return isinstance(other, DummyModel) and self.name == other.name and self.age == other.age

    tool_spec = {
        "name": "DummyModel",
        "description": "desc",
        "inputSchema": {"json": {"type": "object"}},
    }

    bedrock_client.converse_stream.return_value = {
        "stream": [
            {"messageStart": {"role": "assistant"}},
            {"contentBlockStart": {"start": {"toolUse": {"toolUseId": "123", "name": "DummyModel"}}}},
            {"contentBlockDelta": {"delta": {"toolUse": {"input": '{"name": "John", "age": 30}'}}}},
            {"contentBlockStop": {}},
            {"messageStop": {"stopReason": "tool_use"}},
        ]
    }

    # Patch convert_pydantic_to_tool_spec to return our tool_spec
    import strands.models.bedrock as bedrock_module
    from strands.models.bedrock import BedrockModel

    # We call structured_output with tool_choice specified, it should propagate
    stream = model.structured_output(DummyModel, [{"role": "user", "content": [{"text": "Generate a person"}]}])
    events = await alist(stream)

    # The last event should contain the parsed output
    last_event = events[-1]
    assert "output" in last_event
    output = last_event["output"]
    assert output.name == "John"
    assert output.age == 30


@pytest.mark.asyncio
async def test_anthropic_structured_output_tool_choice(anthropic_client, model, test_output_model_cls, alist):
    tool_choice = {"any": {}}

    events = [
        unittest.mock.Mock(type="message_start", model_dump=unittest.mock.Mock(return_value={"type": "message_start"})),
        unittest.mock.Mock(
            type="content_block_start",
            model_dump=unittest.mock.Mock(
                return_value={
                    "type": "content_block_start",
                    "index": 0,
                    "content_block": {"type": "tool_use", "id": "123", "name": "TestOutputModel"},
                }
            ),
        ),
        unittest.mock.Mock(
            type="content_block_delta",
            model_dump=unittest.mock.Mock(
                return_value={
                    "type": "content_block_delta",
                    "index": 0,
                    "delta": {"type": "input_json_delta", "partial_json": '{"name": "John", "age": 30}'},
                },
            ),
        ),
        unittest.mock.Mock(
            type="content_block_stop",
            model_dump=unittest.mock.Mock(return_value={"type": "content_block_stop", "index": 0}),
        ),
        unittest.mock.Mock(
            type="message_stop",
            model_dump=unittest.mock.Mock(
                return_value={"type": "message_stop", "message": {"stop_reason": "tool_use"}}
            ),
        ),
        unittest.mock.Mock(
            message=unittest.mock.Mock(
                usage=unittest.mock.Mock(
                    model_dump=unittest.mock.Mock(return_value={"input_tokens": 0, "output_tokens": 0})
                ),
            ),
        ),
    ]

    mock_context = unittest.mock.AsyncMock()
    mock_context.__aenter__.return_value = iter(events)
    anthropic_client.messages.stream.return_value = mock_context

    stream = model.structured_output(test_output_model_cls, [{"role": "user", "content": [{"text": "Generate a person"}]}])
    events_out = await alist(stream)

    # The last event should contain the parsed output
    last_event = events_out[-1]
    assert "output" in last_event
    output = last_event["output"]
    assert output.name == "John"
    assert output.age == 30


@pytest.mark.asyncio
async def test_tool_choice_warns_on_unsupported_provider(mocker, caplog):
    # We test that providing tool_choice to a provider that does not support it emits a warning.
    # Use LlamaAPIModel as example (which ignores tool_choice but warns)
    from strands.models.llamaapi import LlamaAPIModel

    model = LlamaAPIModel(model_id="dummy-model")

    tool_choice = {"auto": {}}

    messages = [{"role": "user", "content": [{"text": "hello"}]}]

    with caplog.at_level("WARNING"):
        # The stream method should emit a warning about unsupported tool_choice
        async for _ in model.stream(messages, tool_choice=tool_choice):
            pass

    found_warning = any("ToolChoice was provided to this provider but is not supported" in rec.message for rec in caplog.records)
    assert found_warning


@pytest.mark.asyncio
async def test_tool_choice_none_no_warning_on_unsupported_provider(mocker, caplog):
    # Use LlamaAPIModel as example
    from strands.models.llamaapi import LlamaAPIModel

    model = LlamaAPIModel(model_id="dummy-model")

    messages = [{"role": "user", "content": [{"text": "hello"}]}]

    with caplog.at_level("WARNING"):
        async for _ in model.stream(messages, tool_choice=None):
            pass

    found_warning = any("ToolChoice was provided to this provider but is not supported" in rec.message for rec in caplog.records)
    assert not found_warning


