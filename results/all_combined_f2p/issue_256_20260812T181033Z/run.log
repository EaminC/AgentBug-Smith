    model.stream.assert_called_once()
    _, kwargs = model.stream.call_args
    assert "tool_choice" in kwargs
    assert kwargs["tool_choice"] == {"any": {}}


@pytest.mark.asyncio
async def test_bedrock_stream_passes_tool_choice_to_format_request(model_id, bedrock_client, tool_spec):
    model = BedrockModel(model_id=model_id)

    messages = [{"role": "user", "content": [{"text": "test"}]}]
    tool_choice = {"tool": {"name": "test_tool"}}

    # Patch the client's converse_stream to return an async generator
    async def dummy_stream():
        yield {"messageStart": {"role": "assistant"}}
        yield {"messageStop": {"stopReason": "end_turn"}}

    bedrock_client.converse_stream = unittest.mock.AsyncMock(return_value={"stream": dummy_stream()})

    # Call stream with tool_choice
    events = []
    async for event in model.stream(messages, [tool_spec], tool_choice=tool_choice):
        events.append(event)

    # Check that the client was called with a request containing the toolChoice
    bedrock_client.converse_stream.assert_called_once()
    called_request = bedrock_client.converse_stream.call_args[1]
    assert "toolConfig" in called_request
    assert "toolChoice" in called_request["toolConfig"]
    assert called_request["toolConfig"]["toolChoice"] == tool_choice


