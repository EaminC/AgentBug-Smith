import pydantic

from strands.models.anthropic import AnthropicModel
from strands.models.bedrock import BedrockModel


@pytest.mark.parametrize(
    "model_cls",
    [
        AnthropicModel,
        BedrockModel,
    ],
)
def test_structured_output_forces_tool_choice_auto(model_cls):
    """
    Test that structured_output forces tool_choice to {"any": {}} for Bedrock and Anthropic models,
    and that the formatted request includes the tool_choice correctly.
    """
    class TestOutputModel(pydantic.BaseModel):
        name: str
        age: int

    model = model_cls()
    messages = [{"role": "user", "content": [{"text": "Generate a person"}]}]

    # Call structured_output, which internally calls stream with tool_choice={"any": {}}
    # We test that the formatted request includes the tool_choice as expected.

    # Patch the model's stream method to capture the formatted request
    # But do not mock the stream method itself, only intercept format_request call

    # We monkeypatch format_request to capture the tool_choice argument
    captured = {}

    original_format_request = model.format_request

    def format_request_capture(messages_arg, tool_specs=None, system_prompt=None, tool_choice=None):
        captured["tool_choice"] = tool_choice
        return original_format_request(messages_arg, tool_specs, system_prompt, tool_choice)

    model.format_request = format_request_capture

    # Call structured_output
    # This will call stream, which calls format_request with tool_choice={"any": {}}
    # We do not consume the stream here, just call to trigger format_request
    # But to fully test, we consume the async generator to completion

    async def consume_stream():
        async for _ in model.structured_output(TestOutputModel, messages):
            pass

    import asyncio

    asyncio.run(consume_stream())

    # Assert that tool_choice was forced to {"any": {}}
    assert captured.get("tool_choice") == {"any": {}}


@pytest.mark.parametrize(
    "model_cls",
    [
        AnthropicModel,
        BedrockModel,
    ],
)
def test_format_request_accepts_tool_choice_and_includes_it(model_cls):
    """
    Test that format_request accepts tool_choice argument and includes it in the formatted request.
    """
    class TestOutputModel(pydantic.BaseModel):
        name: str
        age: int

    model = model_cls()
    messages = [{"role": "user", "content": [{"text": "test"}]}]

    tool_specs = [
        {
            "name": "test_tool",
            "description": "Test tool description",
            "inputSchema": {"json": {"key": "value"}},
        }
    ]

    # Test with tool_choice "auto"
    tool_choice_auto = {"auto": {}}
    request_auto = model.format_request(messages, tool_specs, tool_choice=tool_choice_auto)
    # For Anthropic, tool_choice is under "tool_choice" key with type info
    # For Bedrock, tool_choice is under "toolConfig" -> "toolChoice"
    if model_cls is AnthropicModel:
        assert request_auto.get("tool_choice") == {"type": "auto"}
    elif model_cls is BedrockModel:
        assert request_auto.get("toolConfig", {}).get("toolChoice") == tool_choice_auto

    # Test with tool_choice "any"
    tool_choice_any = {"any": {}}
    request_any = model.format_request(messages, tool_specs, tool_choice=tool_choice_any)
    if model_cls is AnthropicModel:
        assert request_any.get("tool_choice") == {"type": "any"}
    elif model_cls is BedrockModel:
        assert request_any.get("toolConfig", {}).get("toolChoice") == tool_choice_any

    # Test with tool_choice "tool"
    tool_choice_tool = {"tool": {"name": "test_tool"}}
    request_tool = model.format_request(messages, tool_specs, tool_choice=tool_choice_tool)
    if model_cls is AnthropicModel:
        assert request_tool.get("tool_choice") == {"type": "tool", "name": "test_tool"}
    elif model_cls is BedrockModel:
        assert request_tool.get("toolConfig", {}).get("toolChoice") == tool_choice_tool


@pytest.mark.parametrize(
    "model_cls",
    [
        AnthropicModel,
        BedrockModel,
    ],
)
def test_format_request_with_no_tool_choice_defaults(model_cls):
    """
    Test that format_request without tool_choice uses default tool_choice behavior.
    """
    model = model_cls()
    messages = [{"role": "user", "content": [{"text": "test"}]}]

    request = model.format_request(messages)

    if model_cls is AnthropicModel:
        # Anthropic format_request returns no tool_choice key if None
        assert "tool_choice" not in request
    elif model_cls is BedrockModel:
        # Bedrock format_request includes toolChoice default {"auto": {}}
        assert request.get("toolConfig", {}).get("toolChoice") == {"auto": {}}


