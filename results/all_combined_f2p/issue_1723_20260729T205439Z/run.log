                {
                    "id": "3",
                    "created_at": AnyString(),
                    "finished_at": AnyString(),
                    "name": "User",
                    "role": "user",
                    "content": [
                        {
                            "id": AnyString(),
                            "text": "3" * 40,
                            "type": "text",
                        },
                    ],
                    "metadata": {},
                    "usage": None,
                },
            ],
        )

