async def test_ollama_latency_ms_is_int(monkeypatch):
    """
    This test ensures that the latencyMs metric returned by the OllamaModel is an int,
    not a float. Before the fix, latencyMs is a float, which causes validation errors.
    After the fix, latencyMs should be an int.

    The test mocks the internal AsyncClient.chat method to simulate a response with
    total_duration in nanoseconds. The test then asserts that the latencyMs metric
    in the final agent result is an int.
    """

    # Prepare a dummy event to simulate the Ollama streaming response event
    class DummyMessage:
        def __init__(self):
            self.tool_calls = None
            self.content = "test response"

    class DummyEvent:
        def __init__(self):
            self.message = DummyMessage()
            self.done_reason = "stop"
            self.eval_count = 10
            self.prompt_eval_count = 5
            self.total_duration = 1234567890  # nanoseconds (1.23456789 seconds)

    # Async generator to yield dummy events as the stream
    async def dummy_event_generator():
        yield DummyEvent()

    # Patch the AsyncClient.chat method inside OllamaModel to return our dummy generator
    async def dummy_chat(*args, **kwargs):
        return dummy_event_generator()

    # Create OllamaModel instance with dummy host and model_id
    model = OllamaModel(host="http://dummyhost:1234", model_id="dummy-model")

    # Patch the AsyncClient.chat method on the model instance
    # We patch the AsyncClient class inside strands.models.ollama.ollama module
    # but do not patch the model.format_chunk or other methods to ensure real code runs
    # We do this by patching the AsyncClient instance's chat method directly
    # This avoids mocking the buggy code itself, only the network call.
    # Use monkeypatch to patch the AsyncClient.chat coroutine method
    # The AsyncClient instance is created inside OllamaModel.__init__, so patch the class before creating model
    # But we already created model, so patch the chat method on model._client (AsyncClient instance)
    # The _client attribute is private but accessible for testing
    monkeypatch.setattr(model._client, "chat", dummy_chat)

    # Create an Agent using this OllamaModel
    agent = Agent(model=model)

    # Run the agent call to get a result
    result = await agent.acall("Hello")

    # Extract latencyMs metric from the result metrics summary
    accumulated_metrics = result.metrics.get_summary().get("accumulated_metrics", {})
    latency_ms = accumulated_metrics.get("latencyMs")

    # Assert latencyMs is an int (not float)
    assert isinstance(latency_ms, int), f"latencyMs should be int but got {type(latency_ms)}"

    # Assert latencyMs value matches the int conversion of total_duration / 1e6
    expected_latency = int(1234567890 / 1e6)
    assert latency_ms == expected_latency, f"latencyMs value incorrect, expected {expected_latency}, got {latency_ms}"[0m
