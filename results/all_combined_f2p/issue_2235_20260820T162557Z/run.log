[32mimport pytest
import asyncio

import strands
from strands import Agent
from strands.models.ollama import OllamaModel


@pytest.mark.asyncio
async def test_ollama_latency_ms_is_int(monkeypatch):
    """
    This test ensures that the latencyMs metric returned by the OllamaModel is an int,
    not a float. Before the fix, latencyMs is a float, which causes validation errors.
    After the fix, latencyMs should be an int.

    The test mocks the internal AsyncClient.chat method to simulate a response with
    total_duration in nanoseconds. The test then asserts that the latencyMs metric
    in the final agent result is an int.
    """

    # We patch the AsyncClient.chat method used internally by OllamaModel
    # to yield a dummy event with total_duration in nanoseconds.
    # We do not patch OllamaModel.format_chunk or other methods,
    # so the real code path is exercised.

    # Dummy classes to simulate the event returned by AsyncClient.chat
    class DummyMessage:
        def __init__(self):
            self.tool_calls = None
            self.content = "test response"

    class DummyEvent:
        def __init__(self):
            self.message = DummyMessage()
            self.done_reason = "stop"
            self.eval_count = 10
            self.prompt_eval_count = 5
            self.total_duration = 1234567890  # nanoseconds (1.23456789 seconds)

    async def dummy_event_generator():
        yield DummyEvent()

    async def dummy_chat(*args, **kwargs):
        return dummy_event_generator()

    # Patch AsyncClient.chat inside strands.models.ollama
    # The AsyncClient class is imported from httpx.AsyncClient in the real code,
    # but strands.models.ollama imports AsyncClient from ollama package.
    # We patch the AsyncClient attribute on the OllamaModel instance after creation.

    # Create the OllamaModel instance
    model = OllamaModel(host="http://localhost:11434", model_id="gpt-oss")

    # Patch the AsyncClient instance inside the model
    # The model has an attribute _client which is AsyncClient instance
    # We replace its chat method with dummy_chat
    # This avoids importing non-existing submodules.
    # We assume _client attribute exists after model creation.
    # If not, we create a dummy _client with chat method.

    if hasattr(model, "_client"):
        setattr(model._client, "chat", dummy_chat)
    else:
        class DummyClient:
            chat = dummy_chat
        model._client = DummyClient()

    # Prepare messages for the agent call
    messages = [{"role": "user", "content": "Hello"}]

    # Call the streaming method to get events
    events = []
    async for event in model.stream(messages):
        events.append(event)

    # The last event should be the metadata event containing latencyMs
    metadata_event = events[-1]
    assert "metadata" in metadata_event
    metrics = metadata_event["metadata"]["metrics"]
    assert "latencyMs" in metrics

    latency = metrics["latencyMs"]
    # Assert that latencyMs is an int (not float)
    assert isinstance(latency, int), f"latencyMs should be int but got {type(latency)}"

    # Also assert that latency matches int(total_duration / 1e6)
    expected_latency = int(1234567890 / 1e6)
    assert latency == expected_latency, f"latencyMs expected {expected_latency} but got {latency}"[0m
