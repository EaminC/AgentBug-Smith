    })

    it('uses API key from environment variable', () => {
      vi.stubEnv('OPENAI_API_KEY', 'sk-from-env')
      new OpenAIModel({ api: 'responses', modelId: 'gpt-4o' })
      expect(OpenAI).toHaveBeenCalled()
    })

    it('throws error when no API key is available', () => {
