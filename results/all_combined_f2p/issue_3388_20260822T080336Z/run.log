            model = OpenAIResponsesModel(model_id="openai.gpt-oss-120b", bedrock_mantle_config={})
            resolved = model._resolve_client_args()

        assert resolved["base_url"] == "https://bedrock-mantle.eu-west-1.api.aws/v1"
