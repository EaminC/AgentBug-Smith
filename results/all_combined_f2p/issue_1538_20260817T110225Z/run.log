    responses = [
        {
            "interruptResponse": {
                "interruptId": interrupt.id,
                "response": "test_response",
            },
        },
    ]

    result2 = await graph.invoke_async(responses)

    # AfterNodeCallEvent should have been called exactly once now (normal completion)
    assert interrupt_hook.after_count == 1

    # The graph result status should be COMPLETED
    assert result2.status == Status.COMPLETED[0m
