    This test verifies that when a node is interrupted (via BeforeNodeCallEvent),
    the AfterNodeCallEvent hook is not called in the Swarm multi-agent execution.

    The interrupt_hook fixture registers callbacks for BeforeNodeCallEvent (to interrupt)
    and AfterNodeCallEvent (to count calls). We assert that AfterNodeCallEvent is not called
    when the node is interrupted, and is called once when the node completes normally.
    """
    from strands.multiagent.swarm import Swarm
    from strands.agent import Agent, AgentResult
    from strands.multiagent.base import Status

    class SimpleAgent(Agent):
        def __init__(self):
            super().__init__()
            self.name = "simple_agent"
            self.id = "simple_agent"
            self._session_manager = None
            self.hooks = None

        async def invoke_async(self, input_data, invocation_state=None):
            return AgentResult(
                message={"role": "assistant", "content": [{"text": "Hello"}]},
                stop_reason="end_turn",
                state={},
                metrics=None,
            )

        async def stream_async(self, input_data, **kwargs):
            yield {"agent_start": True}
            yield {"result": await self.invoke_async(input_data)}

    agent = SimpleAgent()
    agent.hooks = interrupt_hook

    swarm = Swarm([agent], hooks=[interrupt_hook])

    # Run the swarm synchronously (which calls invoke_async internally)
    # The interrupt_hook will interrupt the node call, so AfterNodeCallEvent should NOT be called.

    result = swarm("Test task")

    # After execution, AfterNodeCallEvent should not have been called (after_count == 0)
    assert interrupt_hook.after_count == 0, "AfterNodeCallEvent was called despite node being interrupted in Swarm"

    # The result status should be INTERRUPTED
    assert result.status == Status.INTERRUPTED

    # Now run the swarm again WITHOUT the interrupt_hook to verify AfterNodeCallEvent is called once normally.

    # Create a new swarm without hooks
