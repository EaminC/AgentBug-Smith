[32mimport pytest
from strands.hooks import AfterNodeCallEvent


@pytest.mark.asyncio
async def test_after_node_call_event_not_emitted_on_interrupt(interrupt_hook):
    """
    Test that AfterNodeCallEvent is NOT emitted when a node is interrupted in multi-agent graph execution.

    This test verifies that when a node is interrupted (via BeforeNodeCallEvent),
    the AfterNodeCallEvent hook is not called, matching the expected behavior described in issue #1538.

    The interrupt_hook fixture registers callbacks for BeforeNodeCallEvent (to interrupt)
    and AfterNodeCallEvent (to count calls). We assert that AfterNodeCallEvent is not called
    when the node is interrupted, and is called once when the node completes normally.
    """
    # The interrupt_hook fixture is expected to be passed in and used here.

    # The interrupt_hook.after_count tracks how many times AfterNodeCallEvent was called.

    # First, run the graph with the interrupt_hook active, which interrupts the node call.
    # This should cause the node to be interrupted and AfterNodeCallEvent NOT to be called.

    # The test_graph_interrupt_on_before_node_call_event test in test_graph.py already exercises this,
    # but here we isolate the AfterNodeCallEvent count behavior explicitly.

    # We will import GraphBuilder and create a simple graph with one node that will be interrupted.

    from strands.multiagent.graph import GraphBuilder, Status
    from strands.agent import Agent, AgentResult
    import asyncio

    class SimpleAgent(Agent):
        def __init__(self):
            super().__init__()
            self.name = "simple_agent"
            self.id = "simple_agent"
            self._session_manager = None
            self.hooks = None

        async def invoke_async(self, input_data, invocation_state=None):
            # Return a simple AgentResult
            return AgentResult(
                message={"role": "assistant", "content": [{"text": "Hello"}]},
                stop_reason="end_turn",
                state={},
                metrics=None,
            )

        async def stream_async(self, input_data, **kwargs):
            yield {"agent_start": True}
            yield {"result": await self.invoke_async(input_data)}

    # Create the agent and graph
    agent = SimpleAgent()
    agent.hooks = interrupt_hook  # Use the interrupt_hook to register BeforeNodeCallEvent and AfterNodeCallEvent callbacks

    builder = GraphBuilder()
    builder.add_node(agent, "simple_agent")
    builder.set_entry_point("simple_agent")
    builder.set_hook_providers([interrupt_hook])
    graph = builder.build()

    # Run the graph synchronously (which calls invoke_async internally)
    # The interrupt_hook will interrupt the node call, so AfterNodeCallEvent should NOT be called.

    result = graph("Test task")

    # After execution, AfterNodeCallEvent should not have been called (after_count == 0)
    assert interrupt_hook.after_count == 0, "AfterNodeCallEvent was called despite node being interrupted"

    # The result status should be INTERRUPTED
    assert result.status == Status.INTERRUPTED

    # Now run the graph again WITHOUT the interrupt_hook to verify AfterNodeCallEvent is called once normally.

    # Remove the interrupt_hook callbacks by creating a new graph without hooks
    builder2 = GraphBuilder()
    builder2.add_node(agent, "simple_agent")
    builder2.set_entry_point("simple_agent")
    graph2 = builder2.build()

    # Reset after_count to 0 manually
    interrupt_hook.after_count = 0

    # Run the graph normally (no interruption)
    result2 = graph2("Test task")

    # AfterNodeCallEvent should be called once
    assert interrupt_hook.after_count == 1, "AfterNodeCallEvent was not called after normal node execution"

    # The result status should be COMPLETED
    assert result2.status == Status.COMPLETED

    # The result should contain the expected message
    node_result = result2.results.get("simple_agent")
    assert node_result is not None
    assert "Hello" in str(node_result.result.message)


