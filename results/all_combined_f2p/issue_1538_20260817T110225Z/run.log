[32mimport pytest
from strands.hooks import AfterNodeCallEvent, BeforeNodeCallEvent


@pytest.mark.asyncio
async def test_after_node_call_event_not_emitted_on_interrupt(interrupt_hook):
    """
    Test that AfterNodeCallEvent is NOT emitted when a node is interrupted during execution.

    This test exercises the multi-agent graph or swarm execution with an interrupt hook that interrupts
    the node before execution. It verifies that the AfterNodeCallEvent callback is not invoked in this case,
    matching the expected behavior after the fix.

    The test uses the interrupt_hook fixture which interrupts nodes on BeforeNodeCallEvent and counts
    AfterNodeCallEvent invocations.
    """
    # The interrupt_hook fixture registers a BeforeNodeCallEvent callback that interrupts the node,
    # and an AfterNodeCallEvent callback that increments after_count.

    # We import Graph and Swarm to test both multi-agent types.
    from strands.multiagent.graph import GraphBuilder, Status
    from strands.agent import Agent
    import asyncio

    # Create a simple agent that returns a fixed response
    class SimpleAgent(Agent):
        def __init__(self):
            super().__init__()
            self.name = "simple_agent"
            self.id = "simple_agent"
            self._session_manager = None
            self.hooks = None

        async def invoke_async(self, *args, **kwargs):
            from strands.agent import AgentResult
            return AgentResult(
                message={"role": "assistant", "content": [{"text": "response"}]},
                stop_reason="end_turn",
                state={},
                metrics=None,
            )

        async def stream_async(self, *args, **kwargs):
            from strands.agent import AgentResult
            yield {"agent_start": True}
            yield {"result": await self.invoke_async(*args, **kwargs)}

    # Build a graph with one node using the simple agent
    builder = GraphBuilder()
    agent = SimpleAgent()
    builder.add_node(agent, "simple_agent")
    builder.set_entry_point("simple_agent")
    builder.set_hook_providers([interrupt_hook])
    graph = builder.build()

    # Run the graph synchronously (which calls invoke_async internally)
    # The interrupt_hook will interrupt the node before execution,
    # so AfterNodeCallEvent should NOT be called.
    result = graph("test task")

    # After execution, the interrupt_hook.after_count should be 0 (no AfterNodeCallEvent)
    assert interrupt_hook.after_count == 0, "AfterNodeCallEvent was emitted despite interrupt"

    # The graph result status should be INTERRUPTED
    assert result.status == Status.INTERRUPTED

    # Now run again with a normal call (simulate a response to the interrupt)
    interrupt = result.interrupts[0]
    responses = [
        {
            "interruptResponse": {
                "interruptId": interrupt.id,
                "response": "test_response",
            },
        },
    ]
    result2 = graph(responses)

    # Now AfterNodeCallEvent should have been called exactly once
    assert interrupt_hook.after_count == 1, "AfterNodeCallEvent was not emitted after normal execution"

    # The second result status should be COMPLETED
    assert result2.status == Status.COMPLETED


@pytest.mark.asyncio
async def test_after_node_call_event_not_emitted_on_interrupt_swarm(interrupt_hook):
    """
    Test that AfterNodeCallEvent is NOT emitted when a swarm node is interrupted during execution.

    This test exercises the multi-agent swarm execution with an interrupt hook that interrupts
    the node before execution. It verifies that the AfterNodeCallEvent callback is not invoked in this case,
    matching the expected behavior after the fix.

    The test uses the interrupt_hook fixture which interrupts nodes on BeforeNodeCallEvent and counts
    AfterNodeCallEvent invocations.
    """
    from strands.multiagent.swarm import Swarm
    from strands.agent import Agent
    import asyncio
    from strands.multiagent.base import Status

    # Create a simple agent that returns a fixed response
    class SimpleAgent(Agent):
        def __init__(self):
            super().__init__()
            self.name = "simple_agent"
            self.id = "simple_agent"
            self._session_manager = None
            self.hooks = None

        async def invoke_async(self, *args, **kwargs):
            from strands.agent import AgentResult
            return AgentResult(
                message={"role": "assistant", "content": [{"text": "response"}]},
                stop_reason="end_turn",
                state={},
                metrics=None,
            )

        async def stream_async(self, *args, **kwargs):
            from strands.agent import AgentResult
            yield {"agent_start": True}
            yield {"result": await self.invoke_async(*args, **kwargs)}

    # Create swarm with one node using the simple agent
    agent = SimpleAgent()
    swarm = Swarm([agent], hooks=[interrupt_hook])

    # Run the swarm synchronously (which calls invoke_async internally)
    # The interrupt_hook will interrupt the node before execution,
    # so AfterNodeCallEvent should NOT be called.
    result = swarm("test task")

    # After execution, the interrupt_hook.after_count should be 0 (no AfterNodeCallEvent)
    assert interrupt_hook.after_count == 0, "AfterNodeCallEvent was emitted despite interrupt in swarm"

    # The swarm result status should be INTERRUPTED
    assert result.status == Status.INTERRUPTED

    # Now run again with a normal call (simulate a response to the interrupt)
    interrupt = result.interrupts[0]
    responses = [
        {
            "interruptResponse": {
                "interruptId": interrupt.id,
                "response": "test_response",
            },
        },
    ]
    result2 = swarm(responses)

    # Now AfterNodeCallEvent should have been called exactly once
    assert interrupt_hook.after_count == 1, "AfterNodeCallEvent was not emitted after normal execution in swarm"

    # The second result status should be COMPLETED
    assert result2.status == Status.COMPLETED[0m
