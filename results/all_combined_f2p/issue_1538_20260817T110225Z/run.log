async def test_after_node_call_event_not_emitted_on_interrupt(interrupt_hook):
    """
    Test that AfterNodeCallEvent is NOT emitted when a node is interrupted in multi-agent graph execution.

    This test verifies that when a node execution is interrupted (via BeforeNodeCallEvent),
    the AfterNodeCallEvent callback is NOT invoked, matching the expected behavior described in issue #1538.

    The interrupt_hook fixture registers callbacks for BeforeNodeCallEvent (to interrupt)
    and AfterNodeCallEvent (to count invocations). We assert that AfterNodeCallEvent count is zero
    after an interrupt.

    The test runs the graph with a single node agent that is interrupted immediately.
    """

    # The interrupt_hook fixture sets up hooks to interrupt and count AfterNodeCallEvent calls.

    # Create a simple agent that returns a successful result
    class SimpleAgent:
        def __init__(self):
            self.name = "simple_agent"
            self.id = "simple_agent"
            self._session_manager = None
            self.hooks = None

        async def invoke_async(self, input_data, invocation_state=None):
            return AgentResult(
                message={"role": "assistant", "content": [{"text": "Completed"}]},
                stop_reason="end_turn",
                state={},
                metrics={},
            )

        async def stream_async(self, input_data, **kwargs):
            yield {"agent_start": True}
            yield {"result": await self.invoke_async(input_data)}

    # Build graph with one node using SimpleAgent
    builder = GraphBuilder()
    agent = SimpleAgent()
    builder.add_node(agent, "simple_agent")
    builder.set_entry_point("simple_agent")
    builder.set_hook_providers([interrupt_hook])
    graph = builder.build()

    # Run the graph - it should be interrupted immediately by the interrupt_hook
    result = await graph.invoke_async("Test task")

    # AfterNodeCallEvent should NOT have been called because node was interrupted
    assert interrupt_hook.after_count == 0

    # The graph result status should be INTERRUPTED
    assert result.status == Status.INTERRUPTED

