[32mimport asyncio
import pytest
from strands.hooks import AfterNodeCallEvent, BeforeNodeCallEvent
from strands.multiagent.graph import GraphBuilder, Status
from strands.multiagent.swarm import Swarm
from strands.agent import AgentResult


@pytest.mark.asyncio
async def test_after_node_call_event_not_emitted_on_interrupt_graph(interrupt_hook):
    """
    Test that AfterNodeCallEvent is NOT emitted when a node is interrupted in Graph.
    This test depends on the interrupt_hook fixture which interrupts the node call.
    Before the fix, AfterNodeCallEvent was emitted even on interrupt, so the after_count would be 1.
    After the fix, AfterNodeCallEvent should NOT be emitted on interrupt, so after_count should be 0.
    """
    builder = GraphBuilder()
    # Create a simple agent that returns a normal result
    class SimpleAgent:
        def __init__(self):
            self.name = "simple_agent"
            self.id = "simple_agent"

        async def stream_async(self, *args, **kwargs):
            yield {"agent_start": True}
            yield {"result": AgentResult(message={"role": "assistant", "content": [{"text": "done"}]}, stop_reason="end_turn", state={}, metrics=None)}

    agent = SimpleAgent()
    builder.add_node(agent, "simple_agent")
    builder.set_hook_providers([interrupt_hook])
    builder.set_entry_point("simple_agent")
    graph = builder.build()

    # Run the graph synchronously to trigger the interrupt and AfterNodeCallEvent hooks
    result = graph("test task")

    # The interrupt_hook.after_count counts how many AfterNodeCallEvent callbacks were called
    # Before fix: after_count == 1 (AfterNodeCallEvent emitted on interrupt)
    # After fix: after_count == 0 (AfterNodeCallEvent NOT emitted on interrupt)
    assert interrupt_hook.after_count == 0, "AfterNodeCallEvent should not be emitted on interrupt in Graph"


@pytest.mark.asyncio
async def test_after_node_call_event_not_emitted_on_interrupt_swarm(interrupt_hook):
    """
    Test that AfterNodeCallEvent is NOT emitted when a node is interrupted in Swarm.
    This test depends on the interrupt_hook fixture which interrupts the node call.
    Before the fix, AfterNodeCallEvent was emitted even on interrupt, so the after_count would be 1.
    After the fix, AfterNodeCallEvent should NOT be emitted on interrupt, so after_count should be 0.
    """
    # Create a simple agent that returns a normal result
    class SimpleAgent:
        def __init__(self):
            self.name = "simple_agent"
            self.id = "simple_agent"
            self._session_manager = None
            self.hooks = None

        async def stream_async(self, *args, **kwargs):
            yield {"agent_start": True}
            yield {"result": AgentResult(message={"role": "assistant", "content": [{"text": "done"}]}, stop_reason="end_turn", state={}, metrics=None)}

    agent = SimpleAgent()
    swarm = Swarm(nodes=[agent], hooks=[interrupt_hook])

    # Run the swarm synchronously to trigger the interrupt and AfterNodeCallEvent hooks
    result = swarm("test task")

    # The interrupt_hook.after_count counts how many AfterNodeCallEvent callbacks were called
    # Before fix: after_count == 1 (AfterNodeCallEvent emitted on interrupt)
    # After fix: after_count == 0 (AfterNodeCallEvent NOT emitted on interrupt)
    assert interrupt_hook.after_count == 0, "AfterNodeCallEvent should not be emitted on interrupt in Swarm"[0m
