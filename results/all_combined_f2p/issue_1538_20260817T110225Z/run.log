[32mimport pytest
from strands.hooks import AfterNodeCallEvent, BeforeNodeCallEvent


@pytest.mark.asyncio
async def test_after_node_call_event_not_emitted_on_interrupt(interrupt_hook):
    """
    Test that AfterNodeCallEvent is NOT emitted when a node is interrupted in multi-agent graph execution.

    This test verifies that when a node execution is interrupted (via BeforeNodeCallEvent),
    the AfterNodeCallEvent callback is NOT invoked, matching the expected behavior described in issue #1538.

    The interrupt_hook fixture registers callbacks for BeforeNodeCallEvent (to interrupt)
    and AfterNodeCallEvent (to count invocations). We assert that AfterNodeCallEvent count is zero
    after an interrupt.

    The test runs the graph with a single node agent that is interrupted immediately.
    """

    # The interrupt_hook fixture sets up hooks to interrupt and count AfterNodeCallEvent calls.

    # Import GraphBuilder and create a simple graph with one node
    from strands.multiagent.graph import GraphBuilder, Status

    # Create a simple agent that returns a successful result
    from strands.agent import AgentResult

    class SimpleAgent:
        def __init__(self):
            self.name = "simple_agent"
            self.id = "simple_agent"

        async def invoke_async(self, *args, **kwargs):
            return AgentResult(
                message={"role": "assistant", "content": [{"text": "Success"}]},
                stop_reason="end_turn",
                state={},
                metrics={},
            )

        async def stream_async(self, *args, **kwargs):
            yield {"agent_start": True}
            yield {"result": await self.invoke_async()}

    agent = SimpleAgent()

    builder = GraphBuilder()
    builder.add_node(agent, "simple_agent")
    builder.set_entry_point("simple_agent")
    builder.set_hook_providers([interrupt_hook])
    graph = builder.build()

    # Run the graph synchronously (which calls invoke_async internally)
    result = graph("test task")

    # After execution, the interrupt_hook.after_count should be 0 because AfterNodeCallEvent
    # should NOT be emitted on interrupt (buggy code emits it, fixed code suppresses it)
    assert interrupt_hook.after_count == 0, (
        "AfterNodeCallEvent was emitted despite node being interrupted, "
        "which violates expected behavior."
    )

    # The result status should be INTERRUPTED
    assert result.status == Status.INTERRUPTED

    # Now run the graph again with a normal (non-interrupting) hook to verify AfterNodeCallEvent is emitted

    # Remove the interrupt callback, keep only the after callback to count
    class AfterCountHook:
        def __init__(self):
            self.after_count = 0

        def register_hooks(self, registry):
            registry.add_callback(AfterNodeCallEvent, self.after_callback)

        async def after_callback(self, event):
            self.after_count += 1

    after_hook = AfterCountHook()
    builder = GraphBuilder()
    builder.add_node(agent, "simple_agent")
    builder.set_entry_point("simple_agent")
    builder.set_hook_providers([after_hook])
    graph = builder.build()

    # Run the graph synchronously
    result = graph("test task")

    # AfterNodeCallEvent should be emitted exactly once for the single node
    assert after_hook.after_count == 1, "AfterNodeCallEvent was not emitted as expected on normal execution."

    # The result status should be COMPLETED
    assert result.status == Status.COMPLETED[0m
