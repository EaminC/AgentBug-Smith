import asyncio

from strands.hooks import AfterNodeCallEvent
from strands.multiagent.graph import GraphBuilder, Status
from strands.multiagent.swarm import Swarm
from strands.hooks import BeforeNodeCallEvent


@pytest.fixture
def interrupt_hook():
    # Define a hook that interrupts BeforeNodeCallEvent and counts AfterNodeCallEvent calls
    class Hook:
        def __init__(self):
            self.after_count = 0

        def register_hooks(self, registry):
            registry.add_callback(BeforeNodeCallEvent, self.interrupt)
            registry.add_callback(AfterNodeCallEvent, self.after_callback)

        def interrupt(self, event):
            return event.interrupt("test_name", reason="test_reason")

        def after_callback(self, event):
            self.after_count += 1

    hook = Hook()
    # We need to register the hook to the graph or swarm hooks manually in tests
    return hook


@pytest.mark.asyncio
async def test_after_node_call_event_not_emitted_on_interrupt_graph(interrupt_hook):
    """
    Test that AfterNodeCallEvent is NOT emitted when a node is interrupted in Graph.
    This test depends on the interrupt_hook fixture which interrupts the node call.
    Before the fix, AfterNodeCallEvent was emitted even on interrupt, so the after_count would be 1.
    After the fix, AfterNodeCallEvent should NOT be emitted on interrupt, so after_count should be 0.
    """
    builder = GraphBuilder()

    # Create a simple agent that returns a normal result asynchronously
    class SimpleAgent:
        def __init__(self):
            self.name = "simple_agent"
            self.id = "simple_agent"
            self.hooks = None
            self._session_manager = None
            self.messages = []
            self.state = None

        async def stream_async(self, *args, **kwargs):
            # Simulate a streaming generator that yields a result
            yield {"agent_start": True}
            yield {"result": "result"}

        async def invoke_async(self, *args, **kwargs):
            return "result"

    agent = SimpleAgent()
    builder.add_node(agent, "simple_agent")
    builder.set_entry_point("simple_agent")

    graph = builder.build()
    # Add the interrupt_hook callbacks to the graph hooks
    graph.hooks.add_callback(BeforeNodeCallEvent, interrupt_hook.interrupt)
    graph.hooks.add_callback(AfterNodeCallEvent, interrupt_hook.after_callback)

    # Run the graph - it should be interrupted by the hook
    result = await graph.invoke_async("test task")

    # AfterNodeCallEvent should NOT have been called due to interrupt
    assert interrupt_hook.after_count == 0
    # The graph status should be INTERRUPTED
    assert result.status == Status.INTERRUPTED


