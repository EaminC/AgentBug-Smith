    assert interrupt_hook.after_count == 1, "AfterNodeCallEvent was not called after normal node execution in Swarm"

    # The result status should be COMPLETED
    assert result2.status == Status.COMPLETED

    # The result should contain the expected message
    node_result = result2.results.get("simple_agent")
    assert node_result is not None
    assert "Hello" in str(node_result.result.message)[0m
