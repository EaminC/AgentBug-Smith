            id=tool_call_id_1,
            name="mock_sequential_tool",
            input='{"input": "test1"}',
        )
        tool_call_1_part1 = ToolCallBlock(
            id=tool_call_id_1,
            name="mock_sequential_tool",
            input='{"input": ',
        )
        tool_call_1_part2 = ToolCallBlock(
            id=tool_call_id_1,
            name="mock_sequential_tool",
            input='"test1"}',
        )
        tool_call_2 = ToolCallBlock(
            id=tool_call_id_2,
            name="mock_sequential_tool",
            input='{"input": "test2"}',
        )
        self.model.set_responses(
            [
                [
                    ChatResponse(
                        content=[text_block, tool_call_1_part1],
