                    ChatResponse(content=[TextBlock(text="!")], is_last=False),
                    ChatResponse(
                        content=[TextBlock(text="Hello world!")],
                        is_last=True,
                    ),
                ],
            ],
        )

        # Test replyStream interface
        events = []
        async for event in self.agent.reply_stream(
            UserMsg(name="user", content="Hi"),
