def user_memory():
    """Fixture to create a UserMemory instance"""
    crew = MockCrew(
        memory_config={
            "provider": "mem0",
            "config": {"user_id": "john"},
            "user_memory" : {}
        }
    )

    user_memory = MagicMock(spec=UserMemory)

