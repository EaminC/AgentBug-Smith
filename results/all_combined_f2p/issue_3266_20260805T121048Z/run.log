def test_search_method_handles_missing_params_keys_without_keyerror(mem0_storage_instance):
    """
    Test that search method does not raise KeyError when params dict is missing keys
    like 'metadata', 'output_format', 'version', 'run_id'.
    This triggers the buggy code path where del params[...] was done without key check.
    """
    mem0_storage = mem0_storage_instance
    mem0_storage.memory = MagicMock(spec=Memory)

    # Patch the memory.search to return dummy results
    mem0_storage.memory.search.return_value = {
        "results": [
            {"score": 0.9, "memory": "Result 1"},
            {"score": 0.8, "memory": "Result 2"},
        ]
    }

    # Prepare params missing keys 'metadata', 'output_format', 'version', 'run_id'
    # We simulate calling search with minimal params so internal code deletes keys safely
    # We call the real search method which will internally delete keys if present
    results = mem0_storage.search("test query", limit=2, score_threshold=0.5)

    mem0_storage.memory.search.assert_called_once()
    # The results should be a list of dicts with 'context' keys added by Mem0Storage.search
    assert isinstance(results, list)
    assert all("context" in r for r in results)
    assert results[0]["context"] == "Result 1"


def test_search_method_does_not_raise_when_params_missing_keys():
    """
    This test instantiates Mem0Storage with minimal config and calls search with params missing keys.
    It should not raise KeyError.
    """
    crew = MockCrew()
    config = {
        "user_id": "user123",
        "run_id": "run123",
        "infer": True,
    }
    mem0_storage = Mem0Storage(type="short_term", crew=crew, config=config)
    mem0_storage.memory = MagicMock(spec=Memory)
    mem0_storage.memory.search.return_value = {
        "results": [
            {"score": 0.95, "memory": "Memory result 1"},
            {"score": 0.85, "memory": "Memory result 2"},
        ]
    }

    # Call search without 'metadata', 'output_format', 'version' keys in params
    results = mem0_storage.search("query", limit=3, score_threshold=0.3)

    mem0_storage.memory.search.assert_called_once()
    assert len(results) == 2
    assert results[0]["context"] == "Memory result 1"


def test_search_method_with_version_and_output_format():
    """
    Test that search method works correctly when version and output_format keys are present.
    """
    crew = MockCrew()
