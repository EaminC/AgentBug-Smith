    # The filters should include user_id and agent_id in an OR clause
    filters = kwargs.get("filters")
    assert filters is not None
    assert "OR" in filters
    or_filters = filters["OR"]
    user_filter = next((f for f in or_filters if "user_id" in f), None)
    agent_filter = next((f for f in or_filters if "agent_id" in f), None)
    assert user_filter is not None and user_filter["user_id"] == "user-abc"
    assert agent_filter is not None and agent_filter["agent_id"] == "agent-xyz"

    # The user_id param should be passed as well
    assert kwargs.get("user_id") == "user-abc"


