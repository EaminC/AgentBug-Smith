[32mimport pytest
from unittest.mock import MagicMock, patch

from crewai.memory.storage.mem0_storage import Mem0Storage


class MockCrew:
    def __init__(self):
        self.agents = [MagicMock(role="Test Agent")]


@pytest.fixture
def mem0_storage():
    # Setup a mock crew with minimal config for Mem0Storage
    crew = MockCrew()
    # Provide embedder_config simulating local_mem0_config with missing keys
    embedder_config = {
        "user_id": "test_user",
        "local_mem0_config": {
            "vector_store": {
                "provider": "pgvector",
                "config": {"dbname": "memory", "host": "localhost", "user": "memory", "password": "memory", "port": 5432},
            },
            "llm": {
                "provider": "vllm",
                "config": {"vllm_base_url": "http://localhost/v1", "temperature": 0.1, "api_key": "EMPTY", "model": "llama4-scout-17b"},
            },
            "embedder": {
                "provider": "huggingface",
                "config": {"model": "sentence-transformers/all-MiniLM-L6-v2"},
            },
        },
        # Intentionally omit keys like 'metadata', 'output_format', 'version' to test robustness
        "run_id": "my_run_id",
        "includes": "include1",
        "excludes": "exclude1",
        "infer": True,
    }
    mem0_storage = Mem0Storage(type="short_term", crew=crew, config=embedder_config)
    return mem0_storage


def test_search_method_handles_missing_params_keys_without_keyerror(mem0_storage):
    # Patch the memory.search method to simulate a search response
    mock_search_results = {
        "results": [
            {"score": 0.9, "memory": "Result 1"},
            {"score": 0.8, "memory": "Result 2"},
        ]
    }
    mem0_storage.memory.search = MagicMock(return_value=mock_search_results)

    # Call search with a query, limit, and score_threshold
    try:
        results = mem0_storage.search("test query", limit=5, score_threshold=0.5)
    except KeyError as e:
        pytest.fail(f"search method raised KeyError unexpectedly: {e}")

    # Assert that the results are returned correctly and keys are present
    assert isinstance(results, list)
    assert len(results) == 2
    # Each result should have 'context' key added by the search method
    for result in results:
        assert "context" in result
        assert result["context"].startswith("Result")

    # Verify that the internal memory.search was called with expected parameters
    mem0_storage.memory.search.assert_called_once()
    called_kwargs = mem0_storage.memory.search.call_args[1]

    # The params dict passed to memory.search should not contain keys that cause KeyError on deletion
    # So keys like 'metadata', 'output_format', 'version' are either present or safely handled
    # We test that no KeyError was raised and call was made with expected keys
    assert "query" in called_kwargs
    assert "limit" in called_kwargs
    assert "threshold" in called_kwargs


def test_save_method_calls_memory_add_with_proper_metadata(mem0_storage):
    mem0_storage.memory.add = MagicMock()

    test_value = "This is a test memory value"
    test_metadata = {"custom_key": "custom_value"}

    mem0_storage.save(test_value, test_metadata)

    mem0_storage.memory.add.assert_called_once()

    # Extract call arguments to verify keys
    call_args, call_kwargs = mem0_storage.memory.add.call_args

    # The first positional argument is the list of messages
    messages = call_args[0]
    assert isinstance(messages, list)
    assert messages[0]["content"] == test_value
    assert messages[0]["role"] == "assistant"

    # The metadata dict should include the memory type and the custom metadata keys
    metadata = call_kwargs.get("metadata")
    assert metadata is not None
    assert metadata.get("type") == "short_term"
    assert metadata.get("custom_key") == "custom_value"

    # The call_kwargs should include run_id, user_id, and agent_id keys
    assert call_kwargs.get("run_id") == mem0_storage.mem0_run_id
    assert call_kwargs.get("user_id") == mem0_storage.config.get("user_id")
    assert "agent_id" in call_kwargs


def test_search_method_filters_include_run_id_and_threshold(mem0_storage):
    mem0_storage.memory.search = MagicMock(return_value={"results": []})

    # Call search with score_threshold and limit
    mem0_storage.search("query text", limit=10, score_threshold=0.7)

    # Verify that memory.search was called with filters including run_id and threshold
    mem0_storage.memory.search.assert_called_once()
    kwargs = mem0_storage.memory.search.call_args[1]

    # The filters should include run_id in an AND clause
    filters = kwargs.get("filters")
    assert filters is not None
    assert "AND" in filters
    run_id_filter = filters["AND"][0]
    assert "run_id" in run_id_filter
