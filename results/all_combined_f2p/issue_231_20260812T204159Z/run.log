                "contentBlockStart": {
                    "start": {
                        "toolUse": {
                            "toolUseId": "t1",
                            "name": "a_tool",
                        },
                    },
                },
            },
            {"messageStop": {"stopReason": "tool_use"}},
        ],
    ]

    def check_kwargs(**kwargs):
        kwargs_kwargs = kwargs["kwargs"]
