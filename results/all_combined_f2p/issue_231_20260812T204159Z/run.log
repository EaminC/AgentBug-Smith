    assert hook_provider.events_received == [StartRequestEvent(agent=agent)]

    # iterate the rest
    async for _ in iterator:
        pass

    assert hook_provider.events_received == [StartRequestEvent(agent=agent), EndRequestEvent(agent=agent)]


