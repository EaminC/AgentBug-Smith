[32mimport unittest
from aider.models import MODEL_SETTINGS


class TestVertexAIClaudeModelSettings(unittest.TestCase):
    def test_vertex_ai_claude_models_in_model_settings(self):
        # The buggy codebase does not include vertex_ai/claude-3-5-sonnet@20240620
        # and vertex_ai/claude-3-opus@20240229 in MODEL_SETTINGS.
        # After the fix, these should be present with expected attributes.

        # Collect all model names in MODEL_SETTINGS
        model_names = [ms.model for ms in MODEL_SETTINGS]

        # Check for presence of vertex_ai/claude-3-5-sonnet@20240620
        self.assertIn(
            "vertex_ai/claude-3-5-sonnet@20240620",
            model_names,
            "Model vertex_ai/claude-3-5-sonnet@20240620 should be in MODEL_SETTINGS",
        )

        # Check for presence of vertex_ai/claude-3-opus@20240229
        self.assertIn(
            "vertex_ai/claude-3-opus@20240229",
            model_names,
            "Model vertex_ai/claude-3-opus@20240229 should be in MODEL_SETTINGS",
        )

        # Verify attributes of vertex_ai/claude-3-5-sonnet@20240620
        sonnet_settings = next(
            (ms for ms in MODEL_SETTINGS if ms.model == "vertex_ai/claude-3-5-sonnet@20240620"),
            None,
        )
        self.assertIsNotNone(sonnet_settings, "Could not find settings for claude-3-5-sonnet")
        self.assertEqual(sonnet_settings.edit_format, "diff")
        self.assertTrue(sonnet_settings.use_repo_map)

        # Verify attributes of vertex_ai/claude-3-opus@20240229
        opus_settings = next(
            (ms for ms in MODEL_SETTINGS if ms.model == "vertex_ai/claude-3-opus@20240229"),
            None,
        )
        self.assertIsNotNone(opus_settings, "Could not find settings for claude-3-opus")
        self.assertEqual(opus_settings.edit_format, "diff")
        self.assertTrue(opus_settings.use_repo_map)
        self.assertTrue(opus_settings.send_undo_reply)


if __name__ == "__main__":
    unittest.main()[0m
