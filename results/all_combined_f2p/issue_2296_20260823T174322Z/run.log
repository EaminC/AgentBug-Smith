import pytest

from strands.session.repository_session_manager import RepositorySessionManager
from strands.types.content import ContentBlock, Message
from strands.types.session import SessionMessage
from tests.fixtures.mock_session_repository import MockedSessionRepository


@pytest.fixture
def session_manager():
    """Create a RepositorySessionManager with a mocked repository."""
    mock_repo = MockedSessionRepository()
    return RepositorySessionManager(session_id="test-session", session_repository=mock_repo)


def test_fix_broken_tool_use_correct_number_of_tool_results(session_manager):
    """
    This test ensures that the _fix_broken_tool_use method does not add extra toolResult blocks
    beyond what is necessary to match the number of toolUse blocks.
    """
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "tooluse-1", "name": "tool1", "input": {"input": "data1"}}},
                {"toolUse": {"toolUseId": "tooluse-2", "name": "tool2", "input": {"input": "data2"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                {"toolResult": {"toolUseId": "tooluse-1", "status": "success", "content": [{"text": "result1"}]}},
                # Missing toolResult for tooluse-2, should be added by fix
            ],
        },
        {"role": "user", "content": [{"text": "Next message"}]},
    ]

    fixed = session_manager._fix_broken_tool_use(copy.deepcopy(messages))

    # There should be exactly one toolResult per toolUse in the next message after assistant message
    assert len(fixed) == 4  # One extra inserted for missing toolResult
    # The inserted message is at index 2 (between original user message and next user message)
    inserted_message = fixed[2]
    assert inserted_message["role"] == "user"
    # It should contain exactly one toolResult for the missing toolUseId
    assert len(inserted_message["content"]) == 1
    tr = inserted_message["content"][0]
    assert "toolResult" in tr
    assert tr["toolResult"]["toolUseId"] == "tooluse-2"
    assert tr["toolResult"]["status"] == "error"
    assert tr["toolResult"]["content"][0]["text"] == "Tool was interrupted."


def test_fix_broken_tool_use_does_not_add_extra_tool_results(session_manager):
    """
    This test verifies that _fix_broken_tool_use does not add extra toolResult blocks
    if the counts already match.
    """
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "tooluse-1", "name": "tool1", "input": {"input": "data1"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                {"toolResult": {"toolUseId": "tooluse-1", "status": "success", "content": [{"text": "result1"}]}},
            ],
        },
        {"role": "user", "content": [{"text": "Next message"}]},
    ]

    fixed = session_manager._fix_broken_tool_use(copy.deepcopy(messages))

    # No new messages inserted, no extra toolResults added
    assert fixed == messages


def test_fix_broken_tool_use_inserts_tool_result_message_when_missing(session_manager):
    """
    This test verifies that if the message following an assistant message with toolUse blocks
    does not contain any toolResult blocks, the fix inserts a new user message with the missing toolResult blocks.
    """
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "orphaned-123", "name": "test_tool", "input": {"input": "test"}}},
            ],
        },
        {"role": "user", "content": [{"text": "Some other message"}]},
    ]

    fixed = session_manager._fix_broken_tool_use(copy.deepcopy(messages))

    # The fix should insert a new user message with the missing toolResult
    assert len(fixed) == 3
    # The inserted message is at index 1
    inserted = fixed[1]
    assert inserted["role"] == "user"
    assert len(inserted["content"]) == 1
    tr = inserted["content"][0]
    assert "toolResult" in tr
    assert tr["toolResult"]["toolUseId"] == "orphaned-123"
    assert tr["toolResult"]["status"] == "error"
    assert tr["toolResult"]["content"][0]["text"] == "Tool was interrupted."


def test_fix_broken_tool_use_does_not_modify_last_message_with_orphaned_tool_use(session_manager):
    """
    This test verifies that the _fix_broken_tool_use method does not modify the last message
    even if it contains orphaned toolUse blocks, as per the design.
    """
    messages = [
        {"role": "user", "content": [{"text": "Hello"}]},
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "last-message-123", "name": "test_tool", "input": {"input": "test"}}}
            ],
        },
    ]

    fixed = session_manager._fix_broken_tool_use(copy.deepcopy(messages))

    # Should remain unchanged since toolUse is in last message
    assert fixed == messages


def test_fix_broken_tool_use_removes_orphaned_tool_result_at_start(session_manager):
    """
    This test verifies that if the first message is a user message containing orphaned toolResult blocks
    (no preceding toolUse), the fix removes that message.
    """
    messages = [
        {
            "role": "user",
            "content": [
                {
                    "toolResult": {
                        "toolUseId": "orphaned-result-123",
                        "status": "success",
                        "content": [{"text": "Seattle, USA"}],
                    }
                }
            ],
        },
        {"role": "assistant", "content": [{"text": "You live in Seattle, USA."}]},
        {"role": "user", "content": [{"text": "I like pizza"}]},
    ]

    fixed = session_manager._fix_broken_tool_use(copy.deepcopy(messages))

    # Should remove the first message with orphaned toolResult
    assert len(fixed) == 2
    assert fixed[0]["role"] == "assistant"
    assert fixed[0]["content"][0]["text"] == "You live in Seattle, USA."
    assert fixed[1]["role"] == "user"
    assert fixed[1]["content"][0]["text"] == "I like pizza"


def test_fix_broken_tool_use_removes_stale_tool_results(session_manager):
    """Test that toolResults with IDs not matching any preceding toolUse are dropped (#2296)."""
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "valid-123", "name": "test_tool", "input": {"input": "test"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                {"toolResult": {"toolUseId": "stale-999", "status": "success", "content": [{"text": "stale"}]}},
                {"toolResult": {"toolUseId": "valid-123", "status": "success", "content": [{"text": "result"}]}},
            ],
        },
        {"role": "user", "content": [{"text": "Final message"}]},
    ]

    fixed_messages = session_manager._fix_broken_tool_use(copy.deepcopy(messages))

    assert len(fixed_messages) == 3
    # The stale toolResult should be removed, only valid remains
    assert fixed_messages[1]["content"] == [
        {"toolResult": {"toolUseId": "valid-123", "status": "success", "content": [{"text": "result"}]}}
    ]


# Additional test to ensure no extra toolResult blocks are added when multiple orphaned toolUse exist
def test_fix_broken_tool_use_multiple_orphaned_tool_use(session_manager):
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "orphaned-1", "name": "tool1", "input": {"input": "data1"}}},
                {"toolUse": {"toolUseId": "orphaned-2", "name": "tool2", "input": {"input": "data2"}}},
            ],
        },
        {"role": "user", "content": [{"text": "Next message"}]},
    ]

    fixed = session_manager._fix_broken_tool_use(copy.deepcopy(messages))

    # Should insert one user message with two toolResult blocks
    assert len(fixed) == 3
    inserted = fixed[1]
    assert inserted["role"] == "user"
    assert len(inserted["content"]) == 2
    tool_use_ids = {tr["toolResult"]["toolUseId"] for tr in inserted["content"]}
    assert tool_use_ids == {"orphaned-1", "orphaned-2"}


# Test that normal conversations without orphaned toolUse/toolResult are unchanged
