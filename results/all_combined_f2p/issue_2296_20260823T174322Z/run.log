+                next_message = messages[index + 1]
+                non_tool_result_content = []
+
+            next_message["content"] = [
+                existing_results.get(tid, generate_missing_tool_result_content([tid])[0]) for tid in tool_use_ids
+            ] + non_tool_result_content
