    # The messages count should remain 2 (no inserted messages)
    assert len(fixed_messages) == 2

    # The toolResult blocks in the user message should be reordered to match toolUse order
    user_msg_content = fixed_messages[1]["content"]
    assert len(user_msg_content) == 2
    assert user_msg_content[0]["toolResult"]["toolUseId"] == "tool-1"
    assert user_msg_content[1]["toolResult"]["toolUseId"] == "tool-2"


def test_fix_broken_tool_use_removes_stale_tool_results(session_manager):
    """
    Test that toolResult blocks with IDs not matching any preceding toolUse are dropped (#2296).
    """
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "valid-123", "name": "test_tool", "input": {"input": "test"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                {"toolResult": {"toolUseId": "stale-999", "status": "success", "content": [{"text": "stale"}]}},
                {"toolResult": {"toolUseId": "valid-123", "status": "success", "content": [{"text": "result"}]}},
            ],
        },
        {"role": "user", "content": [{"text": "Final message"}]},
    ]

    # Insert messages into repository
    from strands.types.session import SessionMessage
    # Clear existing messages for agent
    existing_msgs = session_manager.session_repository.list_messages("test-session", "existing-agent")
    for msg in existing_msgs:
        session_manager.session_repository.delete_message("test-session", "existing-agent", msg.message_id)

    for idx, msg in enumerate(messages):
        session_msg = SessionMessage(message=copy.deepcopy(msg), message_id=idx)
        session_manager.session_repository.create_message("test-session", "existing-agent", session_msg)

    # Initialize agent to trigger fix
    agent = Agent(agent_id="existing-agent")
    session_manager.initialize(agent)

    fixed_messages = agent.messages

    # The stale toolResult should be removed, only valid toolResult remains
    assert len(fixed_messages) == 3
    user_msg_content = fixed_messages[1]["content"]
    assert len(user_msg_content) == 1
    assert user_msg_content[0]["toolResult"]["toolUseId"] == "valid-123"
    assert user_msg_content[0]["toolResult"]["status"] == "success"
    assert user_msg_content[0]["toolResult"]["content"][0]["text"] == "result"[0m
