    ]

    fixed = manager._fix_broken_tool_use(messages)

    # The fixed messages should have inserted a new user message with the missing toolResult
    # after the assistant message with toolUse.
    assert len(fixed) == 3
    # The inserted message is at index 1
    inserted_msg = fixed[1]
    assert inserted_msg["role"] == "user"
    assert len(inserted_msg["content"]) == 1
    assert "toolResult" in inserted_msg["content"][0]
    assert inserted_msg["content"][0]["toolResult"]["toolUseId"] == "orphaned-1"
    assert inserted_msg["content"][0]["toolResult"]["status"] == "error"
    assert inserted_msg["content"][0]["toolResult"]["content"] == [{"text": "Tool was interrupted."}]

    # The original user message with unrelated content is now at index 2
    assert fixed[2]["role"] == "user"
    assert fixed[2]["content"][0]["text"] == "Some unrelated content"


def test_fix_broken_tool_use_does_not_fix_last_message_or_single_message():
    """
    Test that _fix_broken_tool_use does not modify the last message if it contains orphaned toolUse,
    and does not modify a single message with orphaned toolUse.
    """

    manager = RepositorySessionManager(session_id="test-session", session_repository=None)

    # Single message with orphaned toolUse
    single_message = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "only-1", "name": "toolY", "input": {"input": "val"}}},
            ],
        }
    ]

    fixed_single = manager._fix_broken_tool_use(single_message)
    assert fixed_single == single_message

    # Last message with orphaned toolUse (should not fix)
    messages = [
        {"role": "user", "content": [{"text": "Hello"}]},
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "last-1", "name": "toolZ", "input": {"input": "val"}}},
            ],
        },
    ]

    fixed = manager._fix_broken_tool_use(messages)
    assert fixed == messages

# Note: The tests above exercise the _fix_broken_tool_use method behavior that was buggy before the patch.
# On the buggy codebase, these tests should fail due to extra or stale toolResult blocks.
# After applying the patch, these tests should pass with correct toolResult block counts and content.[0m
