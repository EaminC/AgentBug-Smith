@pytest.fixture
def mock_bidi_agent():
    """Create a mock BidiAgent for testing."""
    agent = Mock()
    agent.agent_id = "bidi-agent-1"
    agent.messages = [{"role": "user", "content": [{"text": "Hello from bidi!"}]}]
