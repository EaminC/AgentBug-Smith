[32mfrom strands.session.repository_session_manager import RepositorySessionManager
from strands.types.session import SessionType
from strands.types.exceptions import SessionException
from strands.agent.agent import Agent
from tests.fixtures.mock_session_repository import MockedSessionRepository


def test_fix_broken_tool_use_corrects_tool_result_count():
    """
    Test that _fix_broken_tool_use fixes orphaned toolUse by adding exactly one toolResult per toolUse,
    and removes stale toolResult blocks that do not correspond to any preceding toolUse.

    This test reproduces the issue where the number of toolResult blocks exceeds the number of toolUse blocks,
    causing validation errors. The fix ensures the counts match exactly.
    """
    # Setup a mock repository and session manager
    mock_repo = MockedSessionRepository()
    # Create session explicitly to avoid errors
    session = mock_repo.read_session("test-session")
    if session is None:
        from strands.types.session import Session
        session = Session(session_id="test-session", session_type=SessionType.AGENT)
        mock_repo.create_session(session)
    session_manager = RepositorySessionManager(session_id="test-session", session_repository=mock_repo)

    # Messages with one toolUse and two toolResults (one stale)
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "tooluse-1", "name": "tool1", "input": {"input": "data"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                {"toolResult": {"toolUseId": "stale-999", "status": "success", "content": [{"text": "stale result"}]}},
                {"toolResult": {"toolUseId": "tooluse-1", "status": "success", "content": [{"text": "valid result"}]}},
            ],
        },
        {"role": "user", "content": [{"text": "final message"}]},
    ]

    # Call the fix method
    fixed_messages = session_manager._fix_broken_tool_use(messages)

    # There should be exactly one toolResult matching the toolUse
    assert len(fixed_messages) == 3
    # The second message content should only contain the valid toolResult, stale one removed
    assert fixed_messages[1]["content"] == [
        {"toolResult": {"toolUseId": "tooluse-1", "status": "success", "content": [{"text": "valid result"}]}}
    ]

    # The rest of the messages remain unchanged
    assert fixed_messages[0] == messages[0]
    assert fixed_messages[2] == messages[2]


def test_fix_broken_tool_use_adds_missing_tool_results_and_no_extra():
    """
    Test that _fix_broken_tool_use adds missing toolResult blocks for orphaned toolUse,
    but does not add extra toolResult blocks beyond the number of toolUse blocks.
    """
    mock_repo = MockedSessionRepository()
    session = mock_repo.read_session("test-session")
    if session is None:
        from strands.types.session import Session
        session = Session(session_id="test-session", session_type=SessionType.AGENT)
        mock_repo.create_session(session)
    session_manager = RepositorySessionManager(session_id="test-session", session_repository=mock_repo)

    # Messages with two toolUse in assistant message, and no toolResult message following
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "tooluse-1", "name": "tool1", "input": {"input": "data1"}}},
                {"toolUse": {"toolUseId": "tooluse-2", "name": "tool2", "input": {"input": "data2"}}},
            ],
        },
        {"role": "user", "content": [{"text": "some user message"}]},
    ]

    fixed_messages = session_manager._fix_broken_tool_use(messages)

    # The fix should insert exactly one user message with two toolResult blocks, one per toolUse
    assert len(fixed_messages) == 3
    # The inserted message is at index 1
    inserted_message = fixed_messages[1]
    assert inserted_message["role"] == "user"
    # It should have exactly two toolResult content blocks
    tool_results = [c for c in inserted_message["content"] if "toolResult" in c]
    assert len(tool_results) == 2
    tool_use_ids = {tr["toolResult"]["toolUseId"] for tr in tool_results}
    assert tool_use_ids == {"tooluse-1", "tooluse-2"}
    # Each toolResult should have status "error" and content text "Tool was interrupted."
    for tr in tool_results:
        assert tr["toolResult"]["status"] == "error"
        assert tr["toolResult"]["content"][0]["text"] == "Tool was interrupted."


