def test_fix_broken_tool_use_correct_number_of_tool_results(session_manager):
    """
    Test that _fix_broken_tool_use adds exactly one toolResult per toolUse and removes stale toolResults.

    This test reproduces the bug where the fix adds an incorrect number of toolResult blocks,
    causing validation errors due to more toolResult blocks than toolUse blocks.

    The test sets up a conversation history with orphaned toolUse blocks and stale toolResult blocks,
    then calls _fix_broken_tool_use and asserts the fixed messages have matching counts and correct toolUseId.
    """

    # Conversation history with:
    # - assistant message with two toolUse blocks (one valid, one orphaned)
    # - user message with two toolResult blocks (one stale, one valid)
    # - a final user message with normal text
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "valid-1", "name": "toolA", "input": {"param": "value1"}}},
                {"toolUse": {"toolUseId": "orphaned-2", "name": "toolB", "input": {"param": "value2"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                {"toolResult": {"toolUseId": "stale-999", "status": "success", "content": [{"text": "stale result"}]}},
                {"toolResult": {"toolUseId": "valid-1", "status": "success", "content": [{"text": "valid result"}]}},
            ],
        },
        {
            "role": "user",
            "content": [{"text": "Final user message"}],
        },
    ]

    # Deepcopy to compare after fix
    original_messages = copy.deepcopy(messages)

    fixed_messages = session_manager._fix_broken_tool_use(messages)

    # The fixed messages should have:
    # - The same number of messages (no messages added or removed except orphaned toolResult removal)
    assert len(fixed_messages) == len(original_messages)

    # The user message following the assistant message with toolUse should have exactly two toolResult blocks,
    # one for each toolUse ID, no stale toolResults.
    user_msg = fixed_messages[1]
    assert user_msg["role"] == "user"
    content = user_msg["content"]

    # Extract all toolResult blocks
    tool_results = [block for block in content if "toolResult" in block]

    # There must be exactly two toolResult blocks matching the two toolUse IDs
    assert len(tool_results) == 2

    tool_use_ids = {tu["toolUseId"] for tu in fixed_messages[0]["content"] if "toolUse" in tu}
    tool_result_ids = {tr["toolResult"]["toolUseId"] for tr in tool_results}

    # The toolResult IDs must exactly match the toolUse IDs
    assert tool_result_ids == tool_use_ids

    # The stale toolResult ("stale-999") must be removed
    assert "stale-999" not in tool_result_ids

    # The orphaned toolUse "orphaned-2" must have a toolResult with status "error" and content text "Tool was interrupted."
    orphaned_result = next(
        tr for tr in tool_results if tr["toolResult"]["toolUseId"] == "orphaned-2"
    )
    assert orphaned_result["toolResult"]["status"] == "error"
    assert orphaned_result["toolResult"]["content"][0]["text"] == "Tool was interrupted."


def test_fix_broken_tool_use_does_not_add_extra_tool_results(session_manager):
    """
    Test that _fix_broken_tool_use does not add extra toolResult blocks beyond the number of toolUse blocks.

    This test sets up a conversation with two consecutive orphaned toolUse messages and a following user message,
    then asserts that the fix inserts exactly one user message with two toolResult blocks, no more.
    """

    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "orphaned-1", "name": "toolX", "input": {"param": "x"}}},
                {"toolUse": {"toolUseId": "orphaned-2", "name": "toolY", "input": {"param": "y"}}},
            ],
        },
        {
            "role": "user",
            "content": [{"text": "Next user message"}],
        },
    ]

    fixed_messages = session_manager._fix_broken_tool_use(messages)

    # The fix should insert exactly one user message after the assistant message with toolUse,
    # containing exactly two toolResult blocks, one per toolUse.
    assert len(fixed_messages) == 3

    inserted_message = fixed_messages[1]
    assert inserted_message["role"] == "user"
    content = inserted_message["content"]

    tool_results = [block for block in content if "toolResult" in block]
    assert len(tool_results) == 2

    tool_use_ids = {tu["toolUseId"] for tu in messages[0]["content"] if "toolUse" in tu}
    tool_result_ids = {tr["toolResult"]["toolUseId"] for tr in tool_results}

    assert tool_result_ids == tool_use_ids

    # Each toolResult should have status "error" and content text "Tool was interrupted."
    for tr in tool_results:
        assert tr["toolResult"]["status"] == "error"
        assert tr["toolResult"]["content"][0]["text"] == "Tool was interrupted."


