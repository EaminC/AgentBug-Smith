            "role": "user",
            "content": [
                {"toolResult": {"toolUseId": "stale-999", "status": "success", "content": [{"text": "stale"}]}},
                {"toolResult": {"toolUseId": "valid-123", "status": "success", "content": [{"text": "result"}]}},
            ],
        },
        {"role": "user", "content": [{"text": "Final message"}]},
    ]

    # Use a deep copy to ensure original messages are not mutated
    input_messages = copy.deepcopy(messages)

    fixed_messages = session_manager._fix_broken_tool_use(input_messages)

    # The stale toolResult with toolUseId "stale-999" should be removed
