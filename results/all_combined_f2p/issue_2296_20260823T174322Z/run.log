    return RepositorySessionManager(session_id="test-session")


def test_fix_broken_tool_use_adds_exact_number_of_tool_results(session_manager):
    """
    This test reproduces the bug where _fix_broken_tool_use adds an incorrect number of toolResult blocks
    when fixing orphaned toolUse blocks.

    The buggy behavior adds too many toolResult blocks, causing validation errors.
    The fixed behavior adds exactly one toolResult per orphaned toolUse.

    The test sets up a conversation with two orphaned toolUse blocks in one assistant message,
    followed by a user message with one stale and one valid toolResult.
    After fixing, the stale toolResult should be removed, and only one toolResult per toolUse remains.
    """

    # Prepare messages simulating the bug scenario:
    # Assistant message with two toolUse blocks (two toolUseIds)
    # Next user message has one stale toolResult (not matching any toolUse) and one valid toolResult
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "tooluse-1", "name": "tool1", "input": {"input": "data1"}}},
                {"toolUse": {"toolUseId": "tooluse-2", "name": "tool2", "input": {"input": "data2"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                {"toolResult": {"toolUseId": "stale-tooluse", "status": "success", "content": [{"text": "stale result"}]}},
                {"toolResult": {"toolUseId": "tooluse-1", "status": "success", "content": [{"text": "valid result"}]}},
            ],
        },
        {
            "role": "user",
            "content": [{"text": "some other user message"}],
        },
    ]

    # Make a deep copy to compare later
    original_messages = copy.deepcopy(messages)

    # Call the _fix_broken_tool_use method to fix the messages
    fixed_messages = session_manager._fix_broken_tool_use(messages)

    # The fixed messages should have the same number of messages
    assert len(fixed_messages) == len(original_messages)

    # The second message's content should only have toolResults matching the toolUseIds in the previous assistant message
    second_message_content = fixed_messages[1]["content"]

    # Extract toolUseIds from the first message
    tool_use_ids = {
        block["toolUse"]["toolUseId"]
        for block in fixed_messages[0]["content"]
        if "toolUse" in block
    }

    # Extract toolUseIds from the toolResult blocks in the second message
    tool_result_ids = {
        block["toolResult"]["toolUseId"]
        for block in second_message_content
        if "toolResult" in block
    }

    # Assert that the toolResult IDs exactly match the toolUse IDs (no stale toolResults)
    assert tool_result_ids == tool_use_ids

    # Assert that the stale toolResult is removed
    assert "stale-tooluse" not in tool_result_ids

    # Assert that the missing toolResult for tooluse-2 is added as an error toolResult
    # Find the toolResult for tooluse-2
    tooluse_2_result = next(
        (block for block in second_message_content if "toolResult" in block and block["toolResult"]["toolUseId"] == "tooluse-2"),
        None,
    )
    assert tooluse_2_result is not None
    assert tooluse_2_result["toolResult"]["status"] == "error"
    assert tooluse_2_result["toolResult"]["content"][0]["text"] == "Tool was interrupted."

    # The first toolResult (tooluse-1) should be unchanged and successful
    tooluse_1_result = next(
        (block for block in second_message_content if "toolResult" in block and block["toolResult"]["toolUseId"] == "tooluse-1"),
        None,
    )
    assert tooluse_1_result is not None
    assert tooluse_1_result["toolResult"]["status"] == "success"
    assert tooluse_1_result["toolResult"]["content"][0]["text"] == "valid result"

    # The last message should remain unchanged
    assert fixed_messages[2] == original_messages[2][0m
