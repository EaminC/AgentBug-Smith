    fixed_messages = manager._fix_broken_tool_use(broken_messages)

    # After fixing, the number of messages should be unchanged (3)
    assert len(fixed_messages) == 3, "Fixing should not add or remove messages"

    # The second message (index 1) should now have two toolResult blocks, one for each toolUse
    fixed_user_message_content = fixed_messages[1]["content"]
    tool_result_ids = [block["toolResult"]["toolUseId"] for block in fixed_user_message_content if "toolResult" in block]

    # The toolResult IDs should exactly match the toolUse IDs from the previous assistant message
    expected_tool_use_ids = [block["toolUse"]["toolUseId"] for block in assistant_message["content"]]
    assert set(tool_result_ids) == set(expected_tool_use_ids), (
        "Fixed message should have toolResult blocks matching all toolUse IDs exactly"
    )

    # The newly added toolResult for the orphaned toolUse should have status "error" and the expected content text
    for block in fixed_user_message_content:
        if "toolResult" in block and block["toolResult"]["toolUseId"] == "tooluse-2":
            assert block["toolResult"]["status"] == "error", "Orphaned toolResult should have status 'error'"
            assert (
                block["toolResult"]["content"][0]["text"] == "Tool was interrupted."
            ), "Orphaned toolResult content text should indicate interruption"

    # The third message should remain unchanged
    assert fixed_messages[2] == user_message_2, "Messages after the fixed toolResult message should remain unchanged"


def test_fix_broken_tool_use_does_not_add_extra_tool_results():
    """
    This test ensures that the _fix_broken_tool_use method does not add extra toolResult blocks
    beyond what is necessary to match the number of toolUse blocks.
    """

    manager = RepositorySessionManager(session_id="test-session", session_repository=None)

    # Setup messages with one assistant message with one toolUse and the next user message with two toolResults,
    # one of which is stale (does not match any toolUse).
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "valid-tooluse", "name": "tool", "input": {"param": "value"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                {"toolResult": {"toolUseId": "stale-tooluse", "status": "success", "content": [{"text": "stale result"}]}},
                {"toolResult": {"toolUseId": "valid-tooluse", "status": "success", "content": [{"text": "valid result"}]}},
            ],
        },
    ]

    fixed = manager._fix_broken_tool_use(messages)

    # The stale toolResult should be removed, leaving only one toolResult matching the toolUse
    assert len(fixed) == 2, "Number of messages should remain unchanged"
    user_content = fixed[1]["content"]
    assert len(user_content) == 1, "Stale toolResult blocks should be removed"
    assert user_content[0]["toolResult"]["toolUseId"] == "valid-tooluse", "Only valid toolResult should remain"


def test_fix_broken_tool_use_inserts_tool_result_message_when_missing():
    """
    This test verifies that if the message following an assistant message with toolUse blocks
    does not contain any toolResult blocks, the fix inserts a new user message with the missing toolResult blocks.
    """

    manager = RepositorySessionManager(session_id="test-session", session_repository=None)

    # Assistant message with one toolUse
    assistant_msg = {
        "role": "assistant",
        "content": [
            {"toolUse": {"toolUseId": "tooluse-abc", "name": "tool", "input": {"param": "value"}}},
        ],
    }

    # Next message is a user message with no toolResult blocks (only text)
    user_msg = {
        "role": "user",
        "content": [
            {"text": "Some user message without toolResult"},
        ],
    }

    messages = [assistant_msg, user_msg]

    fixed = manager._fix_broken_tool_use(messages)

    # After fixing, there should be an inserted user message with toolResult blocks after assistant message
    # So total messages should be 3
    assert len(fixed) == 3, "A new user message with toolResult blocks should be inserted"

    # The inserted message should be at index 1 and have role "user"
    inserted_msg = fixed[1]
    assert inserted_msg["role"] == "user", "Inserted message should be a user message"

    # The inserted message content should have one toolResult block matching the toolUse
    content = inserted_msg["content"]
    assert len(content) == 1, "Inserted message should have one toolResult block"
    assert "toolResult" in content[0], "Inserted content block should be a toolResult"
    assert content[0]["toolResult"]["toolUseId"] == "tooluse-abc", "toolResult toolUseId should match toolUse"

    # The original user message should be shifted to index 2
    assert fixed[2] == user_msg, "Original user message should be shifted after inserted toolResult message"


def test_fix_broken_tool_use_does_not_modify_last_message_with_orphaned_tool_use():
    """
    This test verifies that the _fix_broken_tool_use method does not modify the last message
    even if it contains orphaned toolUse blocks, as per the design.
    """

    manager = RepositorySessionManager(session_id="test-session", session_repository=None)

    # Last message is assistant with orphaned toolUse
    last_message = {
        "role": "assistant",
        "content": [
            {"toolUse": {"toolUseId": "orphaned-last", "name": "tool", "input": {"param": "value"}}},
        ],
    }

    messages = [last_message]

    fixed = manager._fix_broken_tool_use(messages)

    # The fixed messages should be identical to the input (no modification)
    assert fixed == messages, "Last message with orphaned toolUse should not be modified"


def test_fix_broken_tool_use_removes_orphaned_tool_result_at_start():
    """
    This test verifies that if the first message is a user message containing orphaned toolResult blocks
    (no preceding toolUse), the fix removes that message.
    """

    manager = RepositorySessionManager(session_id="test-session", session_repository=None)

    # First message is user with orphaned toolResult
    first_message = {
        "role": "user",
        "content": [
            {"toolResult": {"toolUseId": "orphaned-result", "status": "success", "content": [{"text": "some result"}]}},
        ],
    }

    # Next messages are normal
    second_message = {
        "role": "assistant",
        "content": [{"text": "Hello"}],
    }
    third_message = {
        "role": "user",
        "content": [{"text": "Hi"}],
    }

    messages = [first_message, second_message, third_message]

    fixed = manager._fix_broken_tool_use(messages)

    # The first message should be removed
    assert len(fixed) == 2, "Orphaned toolResult message at start should be removed"
    assert fixed[0] == second_message, "First message after fix should be the original second message"


