        {"role": "user", "content": [{"text": "Final message"}]},
    ]

    fixed_messages = session_manager._fix_broken_tool_use(messages)

    assert len(fixed_messages) == 3
    # The stale toolResult should be removed, only valid toolResult remains
    assert fixed_messages[1]["content"] == [
        {"toolResult": {"toolUseId": "valid-123", "status": "success", "content": [{"text": "result"}]}}
    ]


def test_fix_broken_tool_use_adds_exact_number_of_tool_results():
    """Test that the number of toolResult blocks exactly matches the number of toolUse blocks."""
    session_manager = RepositorySessionManager(session_id="test-session")

    # Messages with two orphaned toolUse blocks in assistant message
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "orphaned-1", "name": "tool1", "input": {"input": "data1"}}},
                {"toolUse": {"toolUseId": "orphaned-2", "name": "tool2", "input": {"input": "data2"}}},
            ],
        },
        {"role": "user", "content": [{"text": "Next user message"}]},
    ]

    fixed_messages = session_manager._fix_broken_tool_use(messages)

    # The fix should insert exactly one user message with two toolResult blocks, one per toolUse
    assert len(fixed_messages) == 3
    inserted_message = fixed_messages[1]
    assert inserted_message["role"] == "user"
    tool_results = [content for content in inserted_message["content"] if "toolResult" in content]
    assert len(tool_results) == 2
    tool_use_ids = {tr["toolResult"]["toolUseId"] for tr in tool_results}
    assert tool_use_ids == {"orphaned-1", "orphaned-2"}
    for tr in tool_results:
        # Each toolResult should have status "error" and content indicating interruption
        assert tr["toolResult"]["status"] == "error"
        assert tr["toolResult"]["content"][0]["text"] == "Tool was interrupted."


def test_fix_broken_tool_use_does_not_add_extra_tool_results():
    """Test that no extra toolResult blocks are added beyond the number of toolUse blocks."""
    session_manager = RepositorySessionManager(session_id="test-session")

    # Messages with one toolUse and one toolResult already present
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "used-1", "name": "tool1", "input": {"input": "data1"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                {"toolResult": {"toolUseId": "used-1", "status": "success", "content": [{"text": "result"}]}},
            ],
        },
    ]

    fixed_messages = session_manager._fix_broken_tool_use(messages)

    # The fix should not add any extra toolResult blocks
    assert len(fixed_messages) == 2
    assert fixed_messages == messages


def test_fix_broken_tool_use_handles_consecutive_orphaned_tool_uses():
    """Test that consecutive orphaned toolUse messages each receive a toolResult message."""
    session_manager = RepositorySessionManager(session_id="test-session")

    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "first-1", "name": "tool1", "input": {"input": "data1"}}},
            ],
        },
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "second-2", "name": "tool2", "input": {"input": "data2"}}},
            ],
        },
        {"role": "user", "content": [{"text": "User message"}]},
    ]

    fixed_messages = session_manager._fix_broken_tool_use(messages)

    # There should be two inserted user messages with toolResult blocks, one after each toolUse
    # Total messages: original 3 + 2 inserted = 5
    assert len(fixed_messages) == 5

    # Check inserted toolResult messages after each toolUse
    # After first assistant toolUse
    first_tool_result_msg = fixed_messages[1]
    assert first_tool_result_msg["role"] == "user"
    tr1 = first_tool_result_msg["content"][0]["toolResult"]
    assert tr1["toolUseId"] == "first-1"
    assert tr1["status"] == "error"
    assert tr1["content"][0]["text"] == "Tool was interrupted."

    # After second assistant toolUse (now at index 3 after insertion)
    second_tool_result_msg = fixed_messages[3]
    assert second_tool_result_msg["role"] == "user"
    tr2 = second_tool_result_msg["content"][0]["toolResult"]
    assert tr2["toolUseId"] == "second-2"
    assert tr2["status"] == "error"
    assert tr2["content"][0]["text"] == "Tool was interrupted."


