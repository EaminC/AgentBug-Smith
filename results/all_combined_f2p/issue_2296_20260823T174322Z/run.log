def test_fix_broken_tool_use_correct_tool_result_count():
    """
    Test that _fix_broken_tool_use adds the correct number of toolResult blocks,
    matching the number of toolUse blocks in the previous assistant message,
    and does not add extra toolResult blocks that cause validation errors.

    This test reproduces the bug where extra toolResult blocks are added,
    causing the number of toolResult blocks to exceed the number of toolUse blocks.

    The test should fail on the buggy codebase and pass after the fix.
    """

    # Create a RepositorySessionManager instance with a dummy session_id.
    # We do not rely on any repository for this test.
    manager = RepositorySessionManager(session_id="test-session", session_repository=None)

    # Prepare a conversation history with an assistant message containing two toolUse blocks,
    # and the next user message containing only one toolResult block (missing one).
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "tooluse-1", "name": "tool1", "input": {"input": "foo"}}},
                {"toolUse": {"toolUseId": "tooluse-2", "name": "tool2", "input": {"input": "bar"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                # Only one toolResult, missing the other
                {"toolResult": {"toolUseId": "tooluse-1", "status": "success", "content": [{"text": "result1"}]}},
            ],
        },
        # Additional user message to ensure no trailing message confusion
        {"role": "user", "content": [{"text": "Some other message"}]},
    ]

    # Call the _fix_broken_tool_use method to fix the history
    fixed_messages = manager._fix_broken_tool_use(messages)

    # The fixed messages should have exactly one user message after the assistant message
    # with two toolResult blocks, one for each toolUse id.
    # The missing toolResult for "tooluse-2" should be added with status "error".
    # There should be no extra toolResult blocks.

    # Check the length of fixed_messages is unchanged
    assert len(fixed_messages) == 3

    # The second message (index 1) is the user message with toolResults
    user_msg = fixed_messages[1]
    assert user_msg["role"] == "user"
    content = user_msg["content"]

    # Extract toolUseIds from toolResult blocks
    tool_result_ids = [block["toolResult"]["toolUseId"] for block in content if "toolResult" in block]

    # There must be exactly two toolResult blocks, matching the two toolUse blocks
    assert len(tool_result_ids) == 2
    assert set(tool_result_ids) == {"tooluse-1", "tooluse-2"}

    # Check that the existing toolResult is preserved unchanged
    existing_result = next(block for block in content if block["toolResult"]["toolUseId"] == "tooluse-1")
    assert existing_result["toolResult"]["status"] == "success"
    assert existing_result["toolResult"]["content"] == [{"text": "result1"}]

    # Check that the missing toolResult is added with status "error" and correct content
    missing_result = next(block for block in content if block["toolResult"]["toolUseId"] == "tooluse-2")
    assert missing_result["toolResult"]["status"] == "error"
    assert missing_result["toolResult"]["content"] == [{"text": "Tool was interrupted."}]

    # Check that there are no extra toolResult blocks beyond these two
    assert all("toolResult" in block for block in content)


def test_fix_broken_tool_use_does_not_add_extra_tool_results():
    """
    Test that _fix_broken_tool_use does not add extra toolResult blocks beyond the number of toolUse blocks.

    This test covers the case where the next user message already contains all toolResult blocks,
    so no additional toolResult blocks should be added.
    """

    manager = RepositorySessionManager(session_id="test-session", session_repository=None)

    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "id-1", "name": "toolA", "input": {"input": "a"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                {"toolResult": {"toolUseId": "id-1", "status": "success", "content": [{"text": "ok"}]}},
            ],
        },
        {"role": "user", "content": [{"text": "Another message"}]},
    ]

    fixed = manager._fix_broken_tool_use(messages)

    # The fixed messages should be identical to input (no extra toolResult added)
    assert fixed == messages


def test_fix_broken_tool_use_removes_stale_tool_results():
    """
    Test that _fix_broken_tool_use removes stale toolResult blocks that do not correspond
