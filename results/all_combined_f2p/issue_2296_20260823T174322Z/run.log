def test_fix_broken_tool_use_adds_exact_number_of_tool_results(session_manager):
    """
    Regression test for issue #2296:
    When restoring conversation history with orphaned toolUse blocks,
    the fix should add exactly one toolResult per toolUse, no more, no less.
    """
    # Prepare messages with two orphaned toolUse blocks in an assistant message,
    # and no corresponding toolResult blocks in the next user message.
    broken_messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "orphaned-1", "name": "toolA", "input": {"input": "data1"}}},
                {"toolUse": {"toolUseId": "orphaned-2", "name": "toolB", "input": {"input": "data2"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                {"text": "Some user message unrelated to tool results."}
            ],
        },
    ]

    # Insert these messages into the mock repository as session messages
    # under a session and agent to simulate restored history.
    # Create a session agent in the repository
    session_agent = session_manager.session_repository.read_agent("test-session", "existing-agent")
    if session_agent is None:
        from strands.agent.conversation_manager.sliding_window_conversation_manager import SlidingWindowConversationManager
        from strands.types.session import SessionAgent
        conversation_manager = SlidingWindowConversationManager()
        session_agent = SessionAgent(
            agent_id="existing-agent",
            state={},
            conversation_manager_state=conversation_manager.get_state(),
        )
        session_manager.session_repository.create_agent("test-session", session_agent)

    # Clear any existing messages for clean test
    existing_msgs = session_manager.session_repository.list_messages("test-session", "existing-agent")
    for msg in existing_msgs:
        session_manager.session_repository.delete_message("test-session", "existing-agent", msg.message_id)

    # Add broken messages to repository
    from strands.types.session import SessionMessage
    for idx, msg in enumerate(broken_messages):
        session_msg = SessionMessage(message=copy.deepcopy(msg), message_id=idx)
        session_manager.session_repository.create_message("test-session", "existing-agent", session_msg)

    # Initialize an agent with the same agent_id to trigger restoration and fix
    agent = Agent(agent_id="existing-agent")

    # Initialize the session manager with the agent, which triggers _fix_broken_tool_use internally
    session_manager.initialize(agent)

    fixed_messages = agent.messages

    # There should now be an inserted user message with exactly two toolResult blocks,
    # one per each orphaned toolUse, no duplicates or extras.
    # So total messages: original assistant message, inserted user message with toolResults, original user message
    assert len(fixed_messages) == 3

    # The inserted message is at index 1
    inserted_msg = fixed_messages[1]
    assert inserted_msg["role"] == "user"
    # It should have exactly two content blocks, each with a toolResult matching the toolUse IDs
    tool_results = [c for c in inserted_msg["content"] if "toolResult" in c]
    assert len(tool_results) == 2

    tool_use_ids = {c["toolResult"]["toolUseId"] for c in tool_results}
    assert tool_use_ids == {"orphaned-1", "orphaned-2"}

    # Each toolResult should have status "error" and content indicating interruption
    for tr in tool_results:
        assert tr["toolResult"]["status"] == "error"
        assert tr["toolResult"]["content"][0]["text"] == "Tool was interrupted."


