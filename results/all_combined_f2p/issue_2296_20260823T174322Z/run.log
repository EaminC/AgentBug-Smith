        {
            "role": "user",
            "content": [
                {
                    "toolResult": {
                        "toolUseId": "stale-999",
                        "status": "success",
                        "content": [{"text": "stale"}],
                    }
                },
                {
                    "toolResult": {
                        "toolUseId": "valid-123",
                        "status": "success",
                        "content": [{"text": "result"}],
                    }
                },
            ],
        },
        {
            "role": "user",
            "content": [{"text": "Final message"}],
        },
    ]

    fixed_messages = session_manager._fix_broken_tool_use(messages)

    # After fix, the stale toolResult should be removed,
    # and only one toolResult matching the toolUse remains.
    assert len(fixed_messages) == 3
    assert fixed_messages[1]["role"] == "user"
    # The content should contain exactly one toolResult matching the valid toolUseId
    assert len(fixed_messages[1]["content"]) == 1
    tool_result = fixed_messages[1]["content"][0]
    assert "toolResult" in tool_result
    assert tool_result["toolResult"]["toolUseId"] == "valid-123"
    assert tool_result["toolResult"]["status"] == "success"
    assert tool_result["toolResult"]["content"][0]["text"] == "result"[0m
