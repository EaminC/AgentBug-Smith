def test_fix_broken_tool_use_adds_exact_number_of_tool_results(session_manager):
    """
    Test that _fix_broken_tool_use adds exactly one toolResult per orphaned toolUse,
    and does not add extra toolResult blocks, which would cause validation errors.
    This test reproduces the bug described in issue #2296 and verifies the fix.
    """
    # Prepare messages with orphaned toolUse blocks (toolUse without matching toolResult)
    # The assistant message has two toolUse blocks
    # The following user message has one stale toolResult (not matching any toolUse) and one matching toolResult
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "tooluse-1", "name": "tool1", "input": {"input": "data1"}}},
                {"toolUse": {"toolUseId": "tooluse-2", "name": "tool2", "input": {"input": "data2"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                # Stale toolResult that does not correspond to any toolUse in previous message
                {"toolResult": {"toolUseId": "stale-tooluse", "status": "success", "content": [{"text": "stale"}]}},
                # Valid toolResult matching tooluse-1
                {"toolResult": {"toolUseId": "tooluse-1", "status": "success", "content": [{"text": "result1"}]}},
            ],
        },
        {
            "role": "user",
            "content": [{"text": "Final user message"}],
        },
    ]

    # Make a deep copy to compare after fix
    original_messages = copy.deepcopy(messages)

    # Call the private method _fix_broken_tool_use to fix the messages
    fixed_messages = session_manager._fix_broken_tool_use(messages)

    # The fixed messages should have the same number of messages
    assert len(fixed_messages) == len(original_messages)

    # The second message content should be fixed:
    # - The stale toolResult should be removed
    # - The missing toolResult for tooluse-2 should be added with error status
    # - The valid toolResult for tooluse-1 should remain unchanged

    # Extract toolResult blocks from second message content
    tool_results = [block["toolResult"] for block in fixed_messages[1]["content"] if "toolResult" in block]

    # There should be exactly two toolResult blocks, one per toolUse in previous assistant message
    assert len(tool_results) == 2

    # Collect toolUseIds from toolResults
    tool_result_ids = {tr["toolUseId"] for tr in tool_results}

    # The toolResult IDs must exactly match the toolUse IDs from previous assistant message
    expected_tool_use_ids = {"tooluse-1", "tooluse-2"}
    assert tool_result_ids == expected_tool_use_ids

    # Check that the existing toolResult for tooluse-1 is unchanged
    tr1 = next(tr for tr in tool_results if tr["toolUseId"] == "tooluse-1")
    assert tr1["status"] == "success"
    assert tr1["content"] == [{"text": "result1"}]

    # Check that the missing toolResult for tooluse-2 is added with error status and correct content
    tr2 = next(tr for tr in tool_results if tr["toolUseId"] == "tooluse-2")
    assert tr2["status"] == "error"
    assert tr2["content"] == [{"text": "Tool was interrupted."}]

    # The stale toolResult should be removed, so it must not appear in fixed messages
    stale_tool_result_present = any(
        block.get("toolResult", {}).get("toolUseId") == "stale-tooluse" for block in fixed_messages[1]["content"]
    )
    assert not stale_tool_result_present


def test_fix_broken_tool_use_does_not_add_extra_tool_results(session_manager):
    """
    Test that _fix_broken_tool_use does not add extra toolResult blocks beyond the number of toolUse blocks.
    This test ensures no validation error from Bedrock due to excess toolResult blocks.
    """
    # Prepare messages with one assistant message containing one toolUse
    # The following user message has no toolResult blocks
    messages = [
        {
            "role": "assistant",
            "content": [
                {"toolUse": {"toolUseId": "tooluse-1", "name": "tool1", "input": {"input": "data1"}}},
            ],
        },
        {
            "role": "user",
            "content": [
                {"text": "User message without toolResult"},
            ],
        },
    ]

    # Fix the messages
    fixed_messages = session_manager._fix_broken_tool_use(messages)

    # The fixed messages should have one additional message inserted after the assistant message
    # or the existing user message content updated with one toolResult block
    # Count total toolResult blocks in fixed messages
    total_tool_results = 0
    for msg in fixed_messages:
        total_tool_results += sum(1 for block in msg["content"] if "toolResult" in block)

    # There should be exactly one toolResult block (matching the one toolUse)
    assert total_tool_results == 1

    # The toolResult block's toolUseId must match the toolUseId in assistant message
    found_tool_result_ids = set()
    for msg in fixed_messages:
        for block in msg["content"]:
            if "toolResult" in block:
                found_tool_result_ids.add(block["toolResult"]["toolUseId"])
    assert found_tool_result_ids == {"tooluse-1"}


