[32mimport pytest
import openai
from openai import ChatCompletion


def test_openai_version_and_multimodal_support():
    # Check that the installed openai package version is at least 1.78.0
    version_str = openai.__version__
    major, minor, patch = (int(x) for x in version_str.split(".")[:3])
    assert (major, minor, patch) >= (1, 78, 0), f"OpenAI version is {version_str}, expected >= 1.78.0"

    # Prepare a dummy chat completion call to test multi-image input support
    # We mock the internal network call to always return a dummy response
    # but do not mock ChatCompletion.create itself to ensure real code runs.

    class DummyResponse:
        def __init__(self):
            self.choices = [type("Choice", (), {"message": {"content": "dummy response"}})()]

    # Patch the internal openai HTTP client to simulate a successful response
    # We patch openai._client.request method to return a dummy JSON response
    # This is the internal method used by ChatCompletion.create to send requests.

    import types

    def dummy_request(self, method, url, headers=None, params=None, json=None, stream=False):
        # Return a dummy response JSON matching the expected structure
        return {
            "id": "chatcmpl-123",
            "object": "chat.completion",
            "created": 1234567890,
            "model": "gpt-4o-mini",
            "choices": [
                {
                    "index": 0,
                    "message": {"role": "assistant", "content": "dummy response"},
                    "finish_reason": "stop",
                }
            ],
            "usage": {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15},
        }

    # Save original method to restore later
    original_request = openai._client._SyncClient.request

    try:
        openai._client._SyncClient.request = types.MethodType(dummy_request, openai._client._SyncClient)

        # Compose a chat completion request with multi-image inputs (new in openai 1.78)
        # We simulate sending multiple images as inputs in messages with "image_url" content type.
        # This is a feature introduced in openai 1.78, so buggy versions will error here.

        messages = [
            {"role": "user", "content": "Describe these images."},
            {
                "role": "user",
                "content": [
                    {"type": "image_url", "image_url": {"url": "https://example.com/image1.png"}},
                    {"type": "image_url", "image_url": {"url": "https://example.com/image2.png"}},
                ],
            },
        ]

        # Call ChatCompletion.create with model and messages containing multiple images
        response = ChatCompletion.create(
            model="gpt-4o-mini",
            messages=messages,
        )

        # Assert the response is as expected (dummy response)
        assert hasattr(response, "choices")
        assert len(response.choices) == 1
        assert response.choices[0].message["content"] == "dummy response"

    finally:
        # Restore original method
        openai._client._SyncClient.request = original_request[0m
