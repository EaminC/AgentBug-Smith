import asyncio
from typing import Any, AsyncGenerator, Callable, Union

from utils import MockModel
from agentscope.agent import Agent
from agentscope.middleware import MiddlewareBase
from agentscope.message import UserMsg, TextBlock, SystemMsg
from agentscope.model import ChatResponse
from agentscope.tool import Toolkit


class OuterModifyMiddleware(MiddlewareBase):
    async def on_reply(
        self,
        agent: Agent,
        input_kwargs: dict,
        next_handler: Callable[..., AsyncGenerator],
    ) -> AsyncGenerator:
        modified = UserMsg("user", "MODIFIED")
        async for item in next_handler(inputs=modified):
            yield item


class InnerTransparentMiddleware(MiddlewareBase):
    async def on_reply(
        self,
        agent: Agent,
        input_kwargs: dict,
        next_handler: Callable[..., AsyncGenerator],
    ) -> AsyncGenerator:
        # Assert that the input is the modified one, not the original
        assert input_kwargs["inputs"].get_text_content() == "MODIFIED"
        async for item in next_handler():
            yield item


class TrackingModel(MockModel):
    def __init__(self):
        super().__init__()
        self.received_messages = []

    async def _call_api(self, *args: Any, **kwargs: Any) -> ChatResponse:
        self.received_messages.extend(kwargs.get("messages", []))
        return await super()._call_api(*args, **kwargs)


async def test_on_reply_middleware_next_handler_preserves_kwargs():
    """
    Test that when an outer middleware modifies input_kwargs and calls next_handler
    with modified kwargs, an inner transparent middleware calling next_handler()
    without kwargs still preserves the modified kwargs downstream.
    """
    model = TrackingModel()
    model.set_responses(
        [
            ChatResponse(content=[TextBlock(text="ok")], is_last=True),
        ]
    )

    agent = Agent(
        name="test_agent",
        system_prompt="test prompt",
        model=model,
        toolkit=Toolkit(),
        middlewares=[OuterModifyMiddleware(), InnerTransparentMiddleware()],
    )

    await agent.reply(UserMsg("user", "ORIGINAL"))

    # The model should receive the modified message, not the original
    user_messages = [m for m in model.received_messages if m.role == "user"]
    assert user_messages, "No user messages received by model"
    assert user_messages[-1].get_text_content() == "MODIFIED"


class ModifyMessagesMiddleware(MiddlewareBase):
    async def on_model_call(
        self,
        agent: Agent,
        input_kwargs: dict,
        next_handler: Callable[..., Union[ChatResponse, AsyncGenerator]],
    ) -> Union[ChatResponse, AsyncGenerator]:
        modified_messages = [
            SystemMsg(name="system", content="INJECTED SYSTEM MESSAGE")
        ] + input_kwargs["messages"]
        return await next_handler(messages=modified_messages)


class TransparentModelCallMiddleware(MiddlewareBase):
    async def on_model_call(
        self,
        agent: Agent,
        input_kwargs: dict,
        next_handler: Callable[..., Union[ChatResponse, AsyncGenerator]],
    ) -> Union[ChatResponse, AsyncGenerator]:
        # Assert that the injected system message is present in input_kwargs
        system_messages = [m for m in input_kwargs["messages"] if m.role == "system"]
        assert any(
            "INJECTED SYSTEM MESSAGE" in m.get_text_content() for m in system_messages
        )
        return await next_handler()


async def test_on_model_call_middleware_next_handler_preserves_kwargs():
    """
    Test that when an outer model-call middleware modifies messages and calls next_handler
    with modified messages, an inner transparent middleware calling next_handler()
    without kwargs still preserves the modified messages downstream.
    """
    received_messages = []

    class TrackingModelForModelCall(MockModel):
        async def _call_api(self, *args: Any, **kwargs: Any) -> ChatResponse:
            received_messages.extend(kwargs.get("messages", []))
            return await super()._call_api(*args, **kwargs)

    tracking_model = TrackingModelForModelCall()
    tracking_model.set_responses(
        [
            ChatResponse(content=[TextBlock(text="response")], is_last=True),
        ]
    )

    agent = Agent(
        name="test_agent",
        system_prompt="test prompt",
        model=tracking_model,
        toolkit=Toolkit(),
        middlewares=[ModifyMessagesMiddleware(), TransparentModelCallMiddleware()],
    )

    await agent.reply(UserMsg("user", "test message"))

    system_messages = [m for m in received_messages if m.role == "system"]
    assert system_messages, "No system messages received by model"
    assert any(
        "INJECTED SYSTEM MESSAGE" in m.get_text_content() for m in system_messages
    )[0m
