from agentscope.tool import Toolkit


async def test_reply_input_kwargs_propagation() -> None:
    """Test that outer middleware input_kwargs modifications persist through inner middleware
    even if inner middleware calls next_handler() without kwargs.

    This test reproduces the bug where inner middleware calling next_handler()
    without kwargs resets input_kwargs to original, losing outer modifications.
    """

    received_messages = []

    class TrackingModel(MockModel):
        async def _call_api(self, *args, **kwargs):
            received_messages.extend(kwargs.get("messages", []))
            return await super()._call_api(*args, **kwargs)

    class OuterModifyMiddleware(MiddlewareBase):
        async def on_reply(
            self,
            agent: Agent,
            input_kwargs: dict,
            next_handler,
        ) -> AsyncGenerator:
            # Modify the inputs to a new UserMsg
            modified = UserMsg("user", "MODIFIED")
            async for item in next_handler(inputs=modified):
                yield item

    class InnerTransparentMiddleware(MiddlewareBase):
        async def on_reply(
            self,
            agent: Agent,
            input_kwargs: dict,
            next_handler,
        ) -> AsyncGenerator:
            # Assert that input_kwargs inputs are the modified message
            assert input_kwargs["inputs"].get_text_content() == "MODIFIED"
            # Call next_handler without kwargs, should preserve outer input_kwargs
            async for item in next_handler():
                yield item

    model = TrackingModel()
    model.set_responses(
        [
            ChatResponse(content=[TextBlock(text="ok")], is_last=True),
        ]
    )

    agent = Agent(
        name="test_agent",
        system_prompt="test prompt",
        model=model,
        toolkit=Toolkit(),
        middlewares=[OuterModifyMiddleware(), InnerTransparentMiddleware()],
    )

    await agent.reply(UserMsg("user", "ORIGINAL"))

    # The model should receive the modified message, not the original
    user_messages = [m for m in received_messages if m.role == "user"]
    assert user_messages, "No user messages received by model"
    assert user_messages[-1].get_text_content() == "MODIFIED"


if __name__ == "__main__":
    asyncio.run(test_reply_input_kwargs_propagation())[0m
