[32m# tests/agentsmith_fail2pass_1965.py
import asyncio
from typing import Any, AsyncGenerator, Callable, Union

from utils import MockModel
from agentscope.agent import Agent
from agentscope.middleware import MiddlewareBase
from agentscope.message import UserMsg, TextBlock, SystemMsg
from agentscope.model import ChatResponse
from agentscope.tool import Toolkit


class OuterModifyMiddleware(MiddlewareBase):
    async def on_reply(
        self,
        agent: Agent,
        input_kwargs: dict,
        next_handler: Callable[..., AsyncGenerator],
    ) -> AsyncGenerator:
        modified = UserMsg("user", "MODIFIED")
        async for item in next_handler(inputs=modified):
            yield item


class InnerTransparentMiddleware(MiddlewareBase):
    async def on_reply(
        self,
        agent: Agent,
        input_kwargs: dict,
        next_handler: Callable[..., AsyncGenerator],
    ) -> AsyncGenerator:
        # The inner middleware calls next_handler() without kwargs,
        # expecting the modified input to flow through.
        assert input_kwargs["inputs"].get_text_content() == "MODIFIED"
        async for item in next_handler():
            yield item


class TrackingModel(MockModel):
    def __init__(self):
        super().__init__()
        self.received_messages = []

    async def _call_api(self, *args: Any, **kwargs: Any) -> ChatResponse:
        self.received_messages.extend(kwargs.get("messages", []))
        return await super()._call_api(*args, **kwargs)


async def test_reply_input_kwargs_propagation() -> None:
    """
    Test that when an outer middleware modifies the input_kwargs and calls
    next_handler with modified inputs, an inner middleware that calls
    next_handler() without kwargs still sees the modified inputs and the
    final model call receives the modified inputs, not the original.
    """
    model = TrackingModel()
    model.set_responses(
        [
            ChatResponse(content=[TextBlock(text="ok")], is_last=True),
        ],
    )

    agent = Agent(
        name="test_agent",
        system_prompt="test prompt",
        model=model,
        toolkit=Toolkit(),
        middlewares=[
            OuterModifyMiddleware(),
            InnerTransparentMiddleware(),
        ],
    )

    await agent.reply(UserMsg("user", "ORIGINAL"))

    # The model should receive the modified message, not the original.
    user_messages = [m for m in model.received_messages if m.role == "user"]
    assert user_messages, "No user messages received by model"
    assert user_messages[-1].get_text_content() == "MODIFIED", (
        "Model did not receive modified input; "
        "likely input_kwargs were reset incorrectly."
    )[0m
