[32m# -*- coding: utf-8 -*-
"""Fail2pass regression test for issue #1965: Agent middleware next_handler resets upstream kwargs."""

import asyncio
from typing import Any, AsyncGenerator, Callable, Union

from utils import MockModel
from agentscope.agent import Agent
from agentscope.middleware import MiddlewareBase
from agentscope.message import UserMsg, TextBlock, SystemMsg, Msg
from agentscope.model import ChatResponse
from agentscope.tool import Toolkit


class TrackingModel(MockModel):
    """Model that tracks received messages."""

    def __init__(self) -> None:
        super().__init__()
        self.received_messages = []

    async def _call_api(self, *args: Any, **kwargs: Any) -> ChatResponse:
        self.received_messages.extend(kwargs.get("messages", []))
        return await super()._call_api(*args, **kwargs)


class OuterModifyMiddleware(MiddlewareBase):
    """Middleware that modifies the 'inputs' in on_reply."""

    async def on_reply(
        self,
        agent: Agent,
        input_kwargs: dict,
        next_handler: Callable[..., AsyncGenerator],
    ) -> AsyncGenerator:
        modified = UserMsg("user", "MODIFIED")
        async for item in next_handler(inputs=modified):
            yield item


class InnerTransparentMiddleware(MiddlewareBase):
    """Middleware that calls next_handler() without passing kwargs."""

    async def on_reply(
        self,
        agent: Agent,
        input_kwargs: dict,
        next_handler: Callable[..., AsyncGenerator],
    ) -> AsyncGenerator:
        # Assert that the input is the modified one from outer middleware
        assert input_kwargs["inputs"].get_text_content() == "MODIFIED"
        async for item in next_handler():
            yield item


class OuterModifyModelCallMiddleware(MiddlewareBase):
    """Middleware that modifies the 'messages' in on_model_call."""

    async def on_model_call(
        self,
        agent: Agent,
        input_kwargs: dict,
        next_handler: Callable[..., Union[ChatResponse, AsyncGenerator]],
    ) -> Union[ChatResponse, AsyncGenerator]:
        modified_messages = [
            SystemMsg(
                name="system",
                content="INJECTED SYSTEM MESSAGE",
            ),
        ] + input_kwargs["messages"]
        return await next_handler(messages=modified_messages)


class InnerTransparentModelCallMiddleware(MiddlewareBase):
    """Middleware that calls next_handler() without passing kwargs in on_model_call."""

    async def on_model_call(
        self,
        agent: Agent,
        input_kwargs: dict,
        next_handler: Callable[..., Union[ChatResponse, AsyncGenerator]],
    ) -> Union[ChatResponse, AsyncGenerator]:
        system_messages = [m for m in input_kwargs["messages"] if m.role == "system"]
        assert any(
            "INJECTED SYSTEM MESSAGE" in m.get_text_content()
            for m in system_messages
        )
        return await next_handler()


class PartialForwardModelCallMiddleware(MiddlewareBase):
    """Middleware that forwards only partial kwargs to next_handler in on_model_call."""

    def __init__(self, injected_text: str, inner_flag: dict) -> None:
        self.injected_text = injected_text
        self.inner_flag = inner_flag

    async def on_model_call(
        self,
        agent: Agent,
        input_kwargs: dict,
        next_handler: Callable[..., Union[ChatResponse, AsyncGenerator]],
    ) -> Union[ChatResponse, AsyncGenerator]:
        self.inner_flag["saw_injected"] = any(
            self.injected_text in m.get_text_content()
            for m in input_kwargs["messages"]
        )
        # Forward only tool_choice, omitting messages
        return await next_handler(tool_choice=input_kwargs["tool_choice"])


async def test_on_reply_next_handler_preserves_modified_inputs() -> None:
    """Test that argumentless next_handler() keeps outer reply input changes."""

    received_messages = []

    class TrackingModelForReply(TrackingModel):
        async def _call_api(self, *args: Any, **kwargs: Any) -> ChatResponse:
            received_messages.extend(kwargs.get("messages", []))
            return await super()._call_api(*args, **kwargs)

    tracking_model = TrackingModelForReply()
    tracking_model.set_responses(
        [ChatResponse(content=[TextBlock(text="response")], is_last=True)],
    )

    agent_instance = Agent(
        name="test_agent",
        system_prompt="test prompt",
        model=tracking_model,
        toolkit=Toolkit(),
        middlewares=[
            OuterModifyMiddleware(),
            InnerTransparentMiddleware(),
        ],
    )

    await agent_instance.reply(UserMsg("user", "ORIGINAL"))

    user_messages = [m for m in received_messages if m.role == "user"]
    # The model should receive the modified message, not the original
    assert any("MODIFIED" in m.get_text_content() for m in user_messages)


async def test_on_model_call_next_handler_preserves_modified_messages() -> None:
    """Test that transparent inner model-call middleware keeps outer messages."""

    received_messages = []

    tracking_model = TrackingModel()
    tracking_model.set_responses(
        [ChatResponse(content=[TextBlock(text="response")], is_last=True)],
    )

    agent_instance = Agent(
        name="test_agent",
        system_prompt="test prompt",
        model=tracking_model,
        toolkit=Toolkit(),
        middlewares=[
            OuterModifyModelCallMiddleware(),
            InnerTransparentModelCallMiddleware(),
        ],
    )

    await agent_instance.reply(UserMsg("user", "test message"))

    system_messages = [m for m in received_messages if m.role == "system"]
    # The model should receive the injected system message
    assert any(
        "INJECTED SYSTEM MESSAGE" in m.get_text_content()
        for m in system_messages
    )


async def test_on_model_call_partial_kwargs_preserves_outer_modifications() -> None:
    """Test that partial next_handler kwargs keep outer model-call changes."""

    injected_text = "INJECTED SYSTEM MESSAGE FROM OUTER MIDDLEWARE"
    inner_flag = {"saw_injected": False}
    received_messages = []

    class ModifyMessagesMiddleware(OuterModifyModelCallMiddleware):
        async def on_model_call(
            self,
            agent: Agent,
            input_kwargs: dict,
            next_handler: Callable[..., Union[ChatResponse, AsyncGenerator]],
        ) -> Union[ChatResponse, AsyncGenerator]:
            modified_messages = [
                SystemMsg(
                    name="system",
                    content=injected_text,
                ),
            ] + input_kwargs["messages"]
            return await next_handler(messages=modified_messages)

    tracking_model = TrackingModel()
    tracking_model.set_responses(
        [ChatResponse(content=[TextBlock(text="response")], is_last=True)],
    )

    agent_instance = Agent(
        name="test_agent",
        system_prompt="test prompt",
        model=tracking_model,
        toolkit=Toolkit(),
        middlewares=[
            ModifyMessagesMiddleware(),
            PartialForwardModelCallMiddleware(injected_text, inner_flag),
        ],
    )

    await agent_instance.reply(UserMsg("user", "test message"))

    assert inner_flag["saw_injected"]
    assert any(
        injected_text in m.get_text_content()
        for m in tracking_model.received_messages
    )


def run_all_tests() -> None:
    asyncio.run(test_on_reply_next_handler_preserves_modified_inputs())
    asyncio.run(test_on_model_call_next_handler_preserves_modified_messages())
    asyncio.run(test_on_model_call_partial_kwargs_preserves_outer_modifications())


