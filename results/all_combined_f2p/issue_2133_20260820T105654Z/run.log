[32mfrom strands import Agent
from strands.vended_plugins.skills import Skill, AgentSkills


def test_agent_skills_plugin_preserves_cache_points_in_system_prompt():
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # Create an agent with a structured system prompt containing cache points
    agent = Agent(
        system_prompt=[
            {"text": "Base instructions."},
            {"cachePoint": {"type": "default"}},
            {"text": "More instructions."},
        ],
        plugins=[plugin],
    )

    # Before any invocation, check the system prompt content preserves structure
    initial_content = agent._system_prompt_content
    assert isinstance(initial_content, list)
    assert {"text": "Base instructions."} in initial_content
    assert {"cachePoint": {"type": "default"}} in initial_content
    assert {"text": "More instructions."} in initial_content

    # Save initial length and structure
    initial_length = len(initial_content)
    initial_cache_points = [block for block in initial_content if "cachePoint" in block]

    # After the agent runs (triggering _on_before_invocation via call)
    agent("hello")

    # After invocation, the system prompt content should still be a list
    post_content = agent._system_prompt_content
    assert isinstance(post_content, list)

    # The length should be initial length + 1 (for the injected skills XML block)
    # because the plugin appends the skills XML block as a new text block
    assert len(post_content) == initial_length + 1

    # The original cachePoint blocks should still be present
    post_cache_points = [block for block in post_content if "cachePoint" in block]
    assert post_cache_points == initial_cache_points

    # The first blocks should be the original blocks (order preserved)
    assert post_content[:initial_length - 1] == initial_content[:initial_length - 1]

    # The last block should be the injected skills XML text block containing skill name
    injected_block = post_content[-1]
    assert "text" in injected_block
    assert "<available_skills>" in injected_block["text"]
    assert "<name>my-skill</name>" in injected_block["text"]
    assert "<description>A skill</description>" in injected_block["text"]


def test_agent_skills_plugin_does_not_flatten_system_prompt_after_injection():
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # Create an agent with a structured system prompt containing cache points
    agent = Agent(
        system_prompt=[
            {"text": "Base instructions."},
            {"cachePoint": {"type": "default"}},
            {"text": "More instructions."},
        ],
        plugins=[plugin],
    )

    # Call the agent to trigger injection
    agent("hello")

    # The system prompt content should remain a list of blocks, not flattened to a single text block
    content = agent._system_prompt_content
    assert isinstance(content, list)
    # There should be at least one cachePoint block still present
    assert any("cachePoint" in block for block in content)
    # There should be multiple blocks, not just one
    assert len(content) > 1
    # The cachePoint block should not be converted to text
    for block in content:
        if "cachePoint" in block:
            # The block should be exactly the cachePoint dict, not a text block
            assert block == {"cachePoint": {"type": "default"}}
            break
    else:
        assert False, "cachePoint block missing after injection"


def test_agent_skills_plugin_injection_appends_skills_xml_to_structured_prompt():
    skill1 = Skill(name="skill1", description="Desc1", instructions="Inst1")
    skill2 = Skill(name="skill2", description="Desc2", instructions="Inst2")
    plugin = AgentSkills(skills=[skill1, skill2])

    # Structured system prompt with multiple blocks including cachePoint
    initial_blocks = [
        {"text": "Instruction block 1."},
        {"cachePoint": {"type": "default"}},
        {"text": "Instruction block 2."},
    ]

    agent = Agent(system_prompt=initial_blocks, plugins=[plugin])

    # Call the agent to trigger injection
    agent("hello")

    content = agent._system_prompt_content
    assert isinstance(content, list)
    # Should contain original blocks plus one appended block for skills XML
    assert len(content) == len(initial_blocks) + 1

    # The last block should contain the skills XML with both skill names
    last_block = content[-1]
    assert "text" in last_block
    assert "<available_skills>" in last_block["text"]
    assert "<name>skill1</name>" in last_block["text"]
    assert "<name>skill2</name>" in last_block["text"]

    # The original cachePoint block should still be present and unchanged
    assert {"cachePoint": {"type": "default"}} in content


def test_agent_skills_plugin_injection_with_none_system_prompt():
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # Create an agent with system_prompt=None
    agent = Agent(system_prompt=None, plugins=[plugin])

    # Before invocation, system_prompt_content should be None
    assert agent._system_prompt_content is None

    # Call the agent to trigger injection
    agent("hello")

    # After invocation, system_prompt_content should be a list with one text block containing skills XML
    content = agent._system_prompt_content
    assert isinstance(content, list)
    assert len(content) == 1
    assert "text" in content[0]
    assert "<available_skills>" in content[0]["text"]
    assert "<name>my-skill</name>" in content[0]["text"]


def test_agent_skills_plugin_injection_does_not_accumulate_skills_xml():
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    agent = Agent(
        system_prompt=[
            {"text": "Base instructions."},
            {"cachePoint": {"type": "default"}},
        ],
        plugins=[plugin],
    )

    # Call the agent multiple times
    agent("hello")
    first_content = agent._system_prompt_content

    agent("hello again")
    second_content = agent._system_prompt_content

    # The system prompt content should be identical after repeated injections
    assert first_content == second_content

    # There should be exactly one skills XML block appended
    skills_xml_blocks = [block for block in second_content if "text" in block and "<available_skills>" in block["text"]]
    assert len(skills_xml_blocks) == 1

    # The cachePoint block should still be present
    assert {"cachePoint": {"type": "default"}} in second_content


def test_agent_skills_plugin_injection_preserves_other_non_text_blocks():
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # System prompt with multiple structured blocks including cachePoint and a custom block
    system_prompt = [
        {"text": "Start instructions."},
        {"cachePoint": {"type": "default"}},
        {"customBlock": {"foo": "bar"}},
        {"text": "End instructions."},
    ]

    agent = Agent(system_prompt=system_prompt, plugins=[plugin])

    # Call the agent to trigger injection
    agent("hello")

    content = agent._system_prompt_content
    assert isinstance(content, list)

    # Original blocks except the skills XML block should be present
    for block in system_prompt:
        assert block in content

    # There should be one additional block for skills XML
    assert len(content) == len(system_prompt) + 1

    # The last block should be the skills XML text block
    assert "text" in content[-1]
    assert "<available_skills>" in content[-1]["text"]
    assert "<name>my-skill</name>" in content[-1]["text"]


def test_agent_skills_plugin_injection_with_plain_string_system_prompt():
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # Agent with plain string system prompt
    agent = Agent(system_prompt="Base instructions.", plugins=[plugin])

    # Call the agent to trigger injection
    agent("hello")

    # The system prompt should be a string containing the original plus skills XML
    system_prompt = agent.system_prompt
    assert isinstance(system_prompt, str)
    assert "Base instructions." in system_prompt
    assert "<available_skills>" in system_prompt
    assert "<name>my-skill</name>" in system_prompt

    # The internal _system_prompt_content should be a list with one text block (legacy behavior)
    content = agent._system_prompt_content
    assert isinstance(content, list)
    assert any("<available_skills>" in block.get("text", "") for block in content)


def test_agent_skills_plugin_injection_replaces_previous_xml_string_path():
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # Agent with plain string system prompt containing old injected XML
    old_xml = "\n\n<old>xml</old>"
    agent = Agent(system_prompt=f"Base prompt.{old_xml}", plugins=[plugin])

    # Manually set state to simulate previous injection
    agent.state.set(plugin._state_key, {"last_injected_xml": old_xml})

    # Call the agent to trigger injection
    agent("hello")

    # The old XML should be removed and replaced with new skills XML
    system_prompt = agent.system_prompt
    assert "<old>xml</old>" not in system_prompt
    assert "<available_skills>" in system_prompt
    assert system_prompt.startswith("Base prompt.")


def test_agent_skills_plugin_injection_warns_when_previous_xml_missing(caplog):
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # Agent with plain string system prompt without old injected XML
    agent = Agent(system_prompt="Totally new prompt.", plugins=[plugin])

    # Manually set state to simulate previous injection that is missing
    agent.state.set(plugin._state_key, {"last_injected_xml": "\n\n<old>xml</old>"})

    # Call the agent to trigger injection
    with caplog.at_level("WARNING"):
        agent("hello")

    # Warning about missing previous XML should be logged
    assert "unable to find previously injected skills XML in system prompt" in caplog.text

    # The new skills XML should still be appended
    assert "<available_skills>" in agent.system_prompt
    assert agent.system_prompt.startswith("Totally new prompt.")[0m
