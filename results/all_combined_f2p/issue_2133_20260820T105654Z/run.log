[32mimport pytest

from strands import Agent
from strands.vended_plugins.skills import Skill, AgentSkills
from strands.hooks.events import BeforeInvocationEvent


def test_agent_skills_preserves_cache_points_in_system_prompt():
    """
    Test that AgentSkills plugin preserves cachePoint blocks in structured system prompts.

    This test reproduces the bug where the AgentSkills plugin destroys cache points in the system prompt
    after injection. Before the fix, the system prompt content collapses into a single text block,
    losing all cachePoint blocks. After the fix, the structured blocks including cachePoint are preserved.
    """
    # Create a skill and the AgentSkills plugin
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # Create an agent with a structured system prompt including a cachePoint
    initial_system_prompt_content = [
        {"text": "Base instructions."},
        {"cachePoint": {"type": "default"}},
        {"text": "More instructions."},
    ]
    agent = Agent(
        system_prompt=initial_system_prompt_content,
        plugins=[plugin],
    )

    # Save the initial _system_prompt_content for comparison
    before_invocation_content = list(agent._system_prompt_content)

    # Sanity check: before invocation, the system prompt content matches the initial structured blocks
    assert before_invocation_content == initial_system_prompt_content

    # Create a BeforeInvocationEvent and call the plugin's _on_before_invocation hook
    event = BeforeInvocationEvent(agent=agent)
    plugin._on_before_invocation(event)

    # After the hook runs, the system prompt content should still be a list of blocks,
    # preserving the cachePoint block and the original text blocks, plus the injected skills XML block.
    after_invocation_content = agent._system_prompt_content

    # Check that the after_invocation_content is a list
    assert isinstance(after_invocation_content, list)

    # The first two blocks should be the original ones: text and cachePoint
    assert after_invocation_content[0] == {"text": "Base instructions."}
    assert after_invocation_content[1] == {"cachePoint": {"type": "default"}}

    # The last block should be the injected skills XML text block containing the skill name
    injected_block = after_invocation_content[-1]
    assert "text" in injected_block
    assert "<available_skills>" in injected_block["text"]
    assert "<name>my-skill</name>" in injected_block["text"]

    # The number of blocks after injection should be original blocks plus one injected block
    assert len(after_invocation_content) == len(initial_system_prompt_content) + 1

    # The original blocks should remain unchanged (except for the injected block appended)
    assert after_invocation_content[:-1] == initial_system_prompt_content

    # Run the hook again to verify no accumulation of injected XML (idempotency)
    plugin._on_before_invocation(event)
    after_second_invocation_content = agent._system_prompt_content

    # The content should be identical to after first invocation (no repeated injection)
    assert after_second_invocation_content == after_invocation_content


def test_agent_skills_injection_on_string_system_prompt_preserves_prompt_and_injects_skills():
    """
    Test that AgentSkills plugin injects skills XML correctly when system prompt is a string.

    This verifies that the string path of injection works and the skills XML is appended,
    and that the original prompt text is preserved.
    """
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    base_prompt = "Base instructions."
    agent = Agent(system_prompt=base_prompt, plugins=[plugin])

    # Before invocation, system_prompt is the base prompt string
    assert agent.system_prompt == base_prompt
    assert agent._system_prompt_content == [{"text": base_prompt}]

    event = BeforeInvocationEvent(agent=agent)
    plugin._on_before_invocation(event)

    # After invocation, system_prompt is a string containing the base prompt and injected skills XML
    new_prompt = agent.system_prompt
    assert new_prompt.startswith(base_prompt)
    assert "<available_skills>" in new_prompt
    assert "<name>my-skill</name>" in new_prompt

    # The internal _system_prompt_content is a list with a single text block (legacy string path)
    assert isinstance(agent._system_prompt_content, list)
    assert len(agent._system_prompt_content) == 1
    assert "<available_skills>" in agent._system_prompt_content[0]["text"]

    # Running the hook again should not accumulate injected XML
    plugin._on_before_invocation(event)
    new_prompt_2 = agent.system_prompt
    assert new_prompt_2 == new_prompt


def test_agent_skills_injection_with_none_system_prompt_injects_skills_xml():
    """
    Test that AgentSkills plugin injects skills XML correctly when system prompt is None.

    The plugin should inject the skills XML as the new system prompt.
    """
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    agent = Agent(system_prompt=None, plugins=[plugin])

    # Before invocation, system prompt is None
    assert agent.system_prompt is None
    assert agent._system_prompt_content is None

    event = BeforeInvocationEvent(agent=agent)
    plugin._on_before_invocation(event)

    # After invocation, system prompt is the injected skills XML string
    new_prompt = agent.system_prompt
    assert new_prompt is not None
    assert "<available_skills>" in new_prompt
    assert "<name>my-skill</name>" in new_prompt

    # The internal _system_prompt_content is a list with a single text block containing the skills XML
    assert isinstance(agent._system_prompt_content, list)
    assert len(agent._system_prompt_content) == 1
    assert "<available_skills>" in agent._system_prompt_content[0]["text"]


def test_agent_skills_plugin_state_key_is_unique_and_not_agent_reference():
    """
    Test that the AgentSkills plugin uses a unique state key and does not store the agent reference.

    This ensures the plugin can be safely shared across agents.
    """
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    agent = Agent(system_prompt="Hello", plugins=[])

    # The plugin's state key is a non-empty string
    assert isinstance(plugin._state_key, str)
    assert plugin._state_key != ""

    # The plugin does not store the agent reference as an attribute
    plugin.init_agent(agent)
    assert not hasattr(plugin, "_agent")


def test_agent_skills_tool_activation_and_state_tracking():
    """
    Test that activating a skill via the skills tool returns instructions and tracks activation in agent state.
    """
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])
    agent = Agent(system_prompt="Hello", plugins=[])
    plugin.init_agent(agent)

    # Mock the agent state get/set to a real dict
    state_store = {}

    def state_get(key):
        return state_store.get(key)

    def state_set(key, value):
        state_store[key] = value

    agent.state.get = state_get
    agent.state.set = state_set

    # Create a dummy ToolContext with the agent
    from strands.types.tools import ToolContext

    tool_context = ToolContext(tool_use={"toolUseId": "id", "name": "agent_skills", "input": {}}, agent=agent, invocation_state={})

    # Activate the skill
    response = plugin.skills(skill_name="my-skill", tool_context=tool_context)

    # The response should contain the instructions
    assert "Do the thing" in response

    # The activated skills list in state should include the skill name
    activated_skills = plugin.get_activated_skills(agent)
    assert "my-skill" in activated_skills


def test_agent_skills_plugin_injects_skills_xml_and_preserves_cache_points(monkeypatch):
    """
    End-to-end test that the AgentSkills plugin injects skills XML into a structured system prompt,
    preserving cache points, and that the agent.system_prompt_content reflects this after invocation.
    """
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # Create an agent with structured system prompt including cachePoint
    initial_prompt = [
        {"text": "Base instructions."},
        {"cachePoint": {"type": "default"}},
        {"text": "More instructions."},
    ]
    agent = Agent(system_prompt=initial_prompt, plugins=[plugin])

    # Save original system prompt content
    before_content = list(agent._system_prompt_content)

    # Simulate the before invocation event to trigger injection
    event = BeforeInvocationEvent(agent=agent)
    plugin._on_before_invocation(event)

    # The system prompt content should be a list with original blocks plus injected skills XML block
    after_content = agent._system_prompt_content
    assert isinstance(after_content, list)
    assert len(after_content) == len(before_content) + 1
    assert after_content[0] == {"text": "Base instructions."}
    assert after_content[1] == {"cachePoint": {"type": "default"}}
    assert "text" in after_content[-1]
    assert "<available_skills>" in after_content[-1]["text"]
    assert "<name>my-skill</name>" in after_content[-1]["text"]

    # The original cachePoint block is preserved without modification
    assert any("cachePoint" in block for block in after_content)


def test_agent_skills_plugin_injection_does_not_flatten_cache_points():
    """
    This test ensures that after the AgentSkills plugin injects skills XML,
    the agent._system_prompt_content remains a list of content blocks,
    preserving cachePoint blocks instead of flattening to a single text block.
    """
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # Structured system prompt with cachePoint
    initial_prompt = [
        {"text": "Base instructions."},
        {"cachePoint": {"type": "default"}},
        {"text": "More instructions."},
    ]
    agent = Agent(system_prompt=initial_prompt, plugins=[plugin])

    # Before invocation, _system_prompt_content is structured
    assert agent._system_prompt_content == initial_prompt

    # Trigger the plugin hook that injects skills XML
    event = BeforeInvocationEvent(agent=agent)
    plugin._on_before_invocation(event)

    # After invocation, _system_prompt_content should still be a list with cachePoint preserved
    content_after = agent._system_prompt_content
    assert isinstance(content_after, list)
    assert any("cachePoint" in block for block in content_after)
    # It should not be collapsed into a single text block
    assert len(content_after) > 1


def test_agent_skills_plugin_injection_replaces_previous_xml_without_accumulation():
    """
    Test that repeated invocations of the AgentSkills plugin's injection hook
    replace the previously injected XML instead of accumulating it.
    """
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # Agent with structured system prompt including cachePoint
    initial_prompt = [
        {"text": "Base instructions."},
        {"cachePoint": {"type": "default"}},
        {"text": "More instructions."},
    ]
    agent = Agent(system_prompt=initial_prompt, plugins=[plugin])

    event = BeforeInvocationEvent(agent=agent)

    # First injection
    plugin._on_before_invocation(event)
    first_content = agent._system_prompt_content

    # Second injection
    plugin._on_before_invocation(event)
    second_content = agent._system_prompt_content

    # The content should be identical, no accumulation of injected XML blocks
    assert first_content == second_content

    # The injected XML block should appear only once at the end
    injected_blocks = [block for block in second_content if "text" in block and "<available_skills>" in block["text"]]
    assert len(injected_blocks) == 1


def test_agent_skills_plugin_warns_when_previous_xml_not_found(caplog):
    """
    Test that the AgentSkills plugin logs a warning when the previously injected XML
    is not found in the system prompt during injection.
    """
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # Agent with string system prompt (string path)
    base_prompt = "Original prompt."
    agent = Agent(system_prompt=base_prompt, plugins=[plugin])

    # Manually set state with a last_injected_xml that is not present in the prompt
    agent.state.set(plugin._state_key, {"last_injected_xml": "\n\n<old_injected_xml></old_injected_xml>"})

    event = BeforeInvocationEvent(agent=agent)

    with caplog.at_level("WARNING"):
        plugin._on_before_invocation(event)

    # Warning about unable to find previously injected XML should be logged
    assert "unable to find previously injected skills XML in system prompt" in caplog.text

    # The new system prompt should still contain the skills XML
    assert "<available_skills>" in agent.system_prompt


