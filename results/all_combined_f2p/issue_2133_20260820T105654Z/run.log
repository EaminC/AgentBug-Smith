[32mfrom strands import Agent
from strands.vended_plugins.skills import Skill, AgentSkills


def test_agent_skills_plugin_preserves_cache_points_in_system_prompt():
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    agent = Agent(
        system_prompt=[
            {"text": "Base instructions."},
            {"cachePoint": {"type": "default"}},
            {"text": "More instructions."},
        ],
        plugins=[plugin],
    )

    # Before any invocation, the system prompt content should preserve cache points
    initial_content = agent._system_prompt_content
    assert initial_content == [
        {"text": "Base instructions."},
        {"cachePoint": {"type": "default"}},
        {"text": "More instructions."},
    ]

    # Run the agent to trigger the plugin's _on_before_invocation hook
    agent("hello")

    # After invocation, the system prompt content should still preserve cache points and structured blocks
    post_content = agent._system_prompt_content

    # The post_content should be a list with the original blocks plus the injected skills XML as a new text block
    assert isinstance(post_content, list)
    # The first blocks should be the original ones (including cachePoint)
    assert {"text": "Base instructions."} in post_content
    assert {"cachePoint": {"type": "default"}} in post_content
    assert {"text": "More instructions."} in post_content or any(
        block.get("text", "").startswith("More instructions.") for block in post_content if "text" in block
    )

    # There should be an additional block with the skills XML injected by the plugin
    # It should contain the <available_skills> XML tag and the skill name
    skills_xml_blocks = [block for block in post_content if "text" in block and "<available_skills>" in block["text"]]
    assert len(skills_xml_blocks) == 1
    skills_xml = skills_xml_blocks[0]["text"]
    assert "<available_skills>" in skills_xml
    assert "<name>my-skill</name>" in skills_xml
    assert "<description>A skill</description>" in skills_xml

    # The total number of blocks should be original blocks + 1 injected block
    assert len(post_content) == len(initial_content) + 1[0m
