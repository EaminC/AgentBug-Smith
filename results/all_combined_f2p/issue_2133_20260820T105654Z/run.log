[32mimport logging
import re

import pytest

from strands import Agent
from strands.vended_plugins.skills.agent_skills import AgentSkills
from strands.vended_plugins.skills.skill import Skill
from strands.hooks.events import BeforeInvocationEvent


@pytest.fixture
def skill():
    return Skill(name="my-skill", description="A skill", instructions="Do the thing")


@pytest.fixture
def plugin(skill):
    return AgentSkills(skills=[skill])


def test_agent_skills_plugin_preserves_cache_points_in_system_prompt(plugin):
    # Create agent with structured system prompt containing cache points
    agent = Agent(
        system_prompt=[
            {"text": "Base instructions."},
            {"cachePoint": {"type": "default"}},
            {"text": "More instructions."},
        ],
        plugins=[plugin],
    )

    # Save original system prompt content for comparison
    original_content = list(agent._system_prompt_content)

    # Fire the before invocation hook manually to simulate agent invocation
    event = BeforeInvocationEvent(agent=agent)
    plugin._on_before_invocation(event)

    # After injection, cache points must be preserved in _system_prompt_content
    content = agent._system_prompt_content
    assert isinstance(content, list)
    # Must contain original cachePoint block
    assert {"cachePoint": {"type": "default"}} in content
    # Must contain original text blocks unchanged (except skills XML appended)
    texts = [block.get("text") for block in content if "text" in block]
    # The original text blocks remain
    assert "Base instructions." in texts
    assert "More instructions." in texts
    # The skills XML is appended as a new text block
    skills_xml_blocks = [block for block in content if "text" in block and "<available_skills>" in block["text"]]
    assert len(skills_xml_blocks) == 1
    # The original blocks remain intact (except the skills XML appended)
    assert content[:-1] == original_content

    # The system_prompt property is a string with skills XML appended
    assert isinstance(agent.system_prompt, str)
    assert "<available_skills>" in agent.system_prompt


def test_agent_skills_plugin_does_not_flatten_system_prompt_after_injection(plugin):
    # Create agent with structured system prompt containing cache points
    agent = Agent(
        system_prompt=[
            {"text": "Base instructions."},
            {"cachePoint": {"type": "default"}},
            {"text": "More instructions."},
        ],
        plugins=[plugin],
    )

    # Fire the before invocation hook manually to simulate agent invocation
    event = BeforeInvocationEvent(agent=agent)
    plugin._on_before_invocation(event)

    # The internal _system_prompt_content should remain a list of blocks, not flattened
    content = agent._system_prompt_content
    assert isinstance(content, list)
    # It should contain the cachePoint block
    assert any("cachePoint" in block for block in content)
    # It should contain multiple blocks (not just one text block)
    assert len(content) > 1


def test_agent_skills_plugin_injection_appends_skills_xml_to_structured_prompt(plugin):
    # Create agent with structured system prompt containing cache points
    agent = Agent(
        system_prompt=[
            {"text": "Base instructions."},
            {"cachePoint": {"type": "default"}},
        ],
        plugins=[plugin],
    )

    event = BeforeInvocationEvent(agent=agent)
    plugin._on_before_invocation(event)

    # The last block should be the skills XML text block
    content = agent._system_prompt_content
    assert content[-1].get("text") is not None
    assert "<available_skills>" in content[-1]["text"]


def test_agent_skills_plugin_injection_with_none_system_prompt(plugin):
    # Create agent with None system prompt
    agent = Agent(system_prompt=None, plugins=[plugin])

    event = BeforeInvocationEvent(agent=agent)
    plugin._on_before_invocation(event)

    # After injection, system_prompt_content should be a list with one text block containing skills XML
    content = agent._system_prompt_content
    assert isinstance(content, list)
    assert len(content) == 1
    assert "<available_skills>" in content[0].get("text", "")


def test_agent_skills_plugin_injection_does_not_accumulate_skills_xml(plugin):
    # Create agent with structured system prompt containing cache points
    agent = Agent(
        system_prompt=[
            {"text": "Base instructions."},
            {"cachePoint": {"type": "default"}},
        ],
        plugins=[plugin],
    )

    event = BeforeInvocationEvent(agent=agent)
    # First injection
    plugin._on_before_invocation(event)
    first_content = list(agent._system_prompt_content)

    # Second injection
    plugin._on_before_invocation(event)
    second_content = list(agent._system_prompt_content)

    # The content should be identical (no accumulation of skills XML blocks)
    assert first_content == second_content
    # Only one skills XML block appended
    skills_xml_blocks = [block for block in second_content if "text" in block and "<available_skills>" in block["text"]]
    assert len(skills_xml_blocks) == 1


def test_agent_skills_plugin_injection_preserves_other_non_text_blocks(plugin):
    # Create agent with multiple non-text blocks including cachePoint
    agent = Agent(
        system_prompt=[
            {"text": "Base instructions."},
            {"cachePoint": {"type": "default"}},
            {"cacheControl": {"type": "ephemeral"}},
        ],
        plugins=[plugin],
    )

    event = BeforeInvocationEvent(agent=agent)
    plugin._on_before_invocation(event)

    content = agent._system_prompt_content
    # The non-text blocks remain intact
    assert {"cachePoint": {"type": "default"}} in content
    assert {"cacheControl": {"type": "ephemeral"}} in content
    # The skills XML appended as a text block
    assert any("<available_skills>" in block.get("text", "") for block in content)


def test_agent_skills_plugin_injection_with_plain_string_system_prompt(plugin):
    # Create agent with plain string system prompt
    agent = Agent(system_prompt="Base instructions.", plugins=[plugin])

    event = BeforeInvocationEvent(agent=agent)
    plugin._on_before_invocation(event)

    # The system_prompt is a string with skills XML appended
    assert isinstance(agent.system_prompt, str)
    assert "Base instructions." in agent.system_prompt
    assert "<available_skills>" in agent.system_prompt

    # The internal _system_prompt_content is a list with one text block (flattened)
    content = agent._system_prompt_content
    assert isinstance(content, list)
    assert len(content) == 1
    assert "<available_skills>" in content[0].get("text", "")


def test_agent_skills_plugin_injection_replaces_previous_xml_string_path():
    # Create a plugin with one skill
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # Create agent with string system prompt containing old injected XML
    old_xml = "\n\n<old>xml</old>"
    base_prompt = "Base prompt."
    agent = Agent(system_prompt=base_prompt + old_xml, plugins=[plugin])

    # Store old injected XML in state
    agent.state.set(plugin._state_key, {"last_injected_xml": old_xml})

    event = BeforeInvocationEvent(agent=agent)
    plugin._on_before_invocation(event)

    # The old XML should be removed from the system prompt string
    assert old_xml not in agent.system_prompt
    # The new skills XML should be present
    assert "<available_skills>" in agent.system_prompt
    # The base prompt remains at the start
    assert agent.system_prompt.startswith(base_prompt)


def test_agent_skills_plugin_injection_warns_when_previous_xml_missing(caplog):
    # Create a plugin with one skill
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # Create agent with string system prompt without old injected XML
    base_prompt = "Base prompt."
    agent = Agent(system_prompt=base_prompt, plugins=[plugin])

    # Store old injected XML in state that is not present in prompt
    agent.state.set(plugin._state_key, {"last_injected_xml": "\n\n<old>xml</old>"})

    event = BeforeInvocationEvent(agent=agent)
    with caplog.at_level(logging.WARNING):
        plugin._on_before_invocation(event)

    # Warning about missing previous XML should be logged
    assert "unable to find previously injected skills XML in system prompt" in caplog.text
    # The new skills XML should be appended
    assert "<available_skills>" in agent.system_prompt
    # The base prompt remains at the start
    assert agent.system_prompt.startswith(base_prompt)


def test_agent_skills_plugin_injection_preserves_cache_points_in_system_prompt():
