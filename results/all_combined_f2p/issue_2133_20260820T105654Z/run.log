[32mfrom strands import Agent
from strands.vended_plugins.skills import Skill, AgentSkills


def test_agent_skills_plugin_preserves_cache_points_in_system_prompt():
    skill = Skill(name="my-skill", description="A skill", instructions="Do the thing")
    plugin = AgentSkills(skills=[skill])

    # Create an agent with a structured system prompt containing cache points
    agent = Agent(
        system_prompt=[
            {"text": "Base instructions."},
            {"cachePoint": {"type": "default"}},
            {"text": "More instructions."},
        ],
        plugins=[plugin],
    )

    # Before any invocation, the system prompt content should preserve the structure including cache points
    expected_before = [
        {"text": "Base instructions."},
        {"cachePoint": {"type": "default"}},
        {"text": "More instructions."},
    ]
    assert agent._system_prompt_content == expected_before

    # After the agent runs (triggering _on_before_invocation), cache points should still be preserved
    agent("hello")

    # The system prompt content should still be a list with the original cachePoint block preserved
    content_after = agent._system_prompt_content

    # It should contain the original blocks plus the injected skills XML block appended
    # The first two blocks should be the original ones (text and cachePoint)
    assert content_after[0] == {"text": "Base instructions."}
    assert content_after[1] == {"cachePoint": {"type": "default"}}

    # The last block should be a text block containing the skills XML
    assert isinstance(content_after[-1], dict)
    assert "text" in content_after[-1]
    assert "<available_skills>" in content_after[-1]["text"]

    # The original cachePoint block must still be present exactly once
    cache_points = [block for block in content_after if "cachePoint" in block]
    assert len(cache_points) == 1
    assert cache_points[0] == {"cachePoint": {"type": "default"}}

    # The total number of blocks should be original blocks + 1 (skills XML)
    assert len(content_after) == len(expected_before) + 1[0m
