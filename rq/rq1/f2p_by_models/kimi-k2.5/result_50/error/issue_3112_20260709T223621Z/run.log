# Install system dependencies and clean up in one layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    git \
    && python -m pip install --no-cache-dir --upgrade pip wheel \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/* /root/.cache/pip

# Copy dependency files first for better caching
COPY pyproject.toml .
COPY uv.lock* ./

# Copy source code
COPY src/ ./src/

# Install project and test dependencies
RUN pip install --no-cache-dir -e . && \
    pip install --no-cache-dir \
        pytest \
        pytest-mock \
        pytest-asyncio \
        pytest-cov \
        pytest-timeout \
        pytest-xdist \
        "setuptools<=81.0.0" \
        litellm \
        requests && \
    rm -rf /root/.cache/pip /tmp/*

# Copy remaining files (tests, configs, etc.) - .cache excluded via .dockerignore
COPY . .

# Set PYTHONPATH for src layout (skip pip install -e . for src layout to avoid duplicate modules)
ENV PYTHONPATH=/app/src

# =============================================================================
# Forge API Configuration - OpenAI/Anthropic compatible endpoints
# =============================================================================
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"

# Pre-flight check to verify installation
RUN python -c "import sys; print('Python:', sys.version)" && \
    python -c "import pytest; print('pytest: ok')" && \
    python -c "import crewai; print('crewai: ok')"

# Default command: bash shell
CMD ["/bin/bash"]
