[32m# CrewAI Dockerfile with Forge API Configuration
# Base image: Python 3.12 slim
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install system dependencies for compilation and general use
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install wheel
RUN python -m pip install --upgrade pip wheel

# Copy the entire repository
COPY . .

# Install CrewAI core framework explicitly
RUN pip install "crewai>=0.100.0" || true

# Install project dependencies and the project itself
# Using pip install -e . for editable install (supports both setup.py and pyproject.toml)
RUN if [ -f "pyproject.toml" ] || [ -f "setup.py" ]; then \
        pip install -e .; \
    fi

# Install test dependencies explicitly
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-timeout pytest-xdist \
    "setuptools<=81.0.0" litellm mem0ai requests

# Install additional optional dependencies if available
RUN pip install crewai-tools tiktoken python-dotenv || true

# Handle src layout: set PYTHONPATH for proper imports
ENV PYTHONPATH=/app/src

# Set Forge API environment variables for OpenAI SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Set Forge API environment variables for Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional Forge configuration
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Pre-flight check to verify installation
RUN python -c "import crewai; print('crewai import ok')" && \
    python -c "import pytest; print('pytest import ok')"

# Default command: bash shell
CMD ["/bin/bash"]
