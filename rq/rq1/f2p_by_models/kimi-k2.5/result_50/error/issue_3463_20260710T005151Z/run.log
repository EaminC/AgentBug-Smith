[32m# CrewAI Project Dockerfile - Configured for Forge API
# Base image: Python 3.12 slim
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Configure environment for Forge API compatibility
# OpenAI SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
# Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key
# Additional AI configuration
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0
# Set Python path for src/ layout
ENV PYTHONPATH=/app

# Install system dependencies required for compilation and Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    libffi-dev \
    libssl-dev \
    cargo \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install essential build tools
RUN python -m pip install --upgrade pip wheel setuptools

# Copy the entire repository (including pyproject.toml, uv.lock, src/, tests/)
COPY . .

# Install uv for dependency management (as used by this project)
RUN pip install uv

# Install project dependencies using uv if uv.lock exists, otherwise use pip
# Also install crewai framework SDK and test dependencies
RUN if [ -f "uv.lock" ]; then \
        uv pip install --system -e . || pip install -e .; \
    else \
        pip install -e .; \
    fi

# Explicitly install crewai framework and test dependencies
# These are required for the project to function correctly
RUN pip install --no-cache-dir \
    crewai \
    litellm \
    instructor \
    chromadb \
    openai \
    anthropic \
    pydantic \
    python-dotenv \
    pytest \
    pytest-asyncio \
    pytest-mock \
    pytest-timeout \
    pytest-xdist \
    pytest-recording \
    pytest-subprocess \
    pytest-randomly \
    pytest-split \
    "setuptools<=81.0.0" \
    mem0ai \
    tokenizers \
    onnxruntime \
    pdfplumber \
    pyjwt \
    click \
    appdirs \
    jsonref \
    json-repair \
    blinker \
    json5 \
    portalocker \
    opentelemetry-api \
    opentelemetry-sdk \
    opentelemetry-exporter-otlp-proto-http \
    openpyxl \
    pyvis \
    regex

# Install additional optional dependencies for full functionality
RUN pip install --no-cache-dir \
    crewai-tools \
    tiktoken \
    pandas \
    docling \
    qdrant-client[fastembed] \
    aisuite \
    pillow \
    cairosvg \
    ruff \
    mypy \
    bandit \
    pre-commit \
    types-requests \
    types-pyyaml \
    types-regex \
    types-appdirs \
    || true

# Preflight check to verify critical packages are installed
RUN python -c "import crewai; import pytest; import litellm; import pydantic; print('preflight ok')"

# Verify Python environment and print versions for debugging
RUN python --version && pip --version && python -c "import sys; print(f'Python path: {sys.path}')"

# Default command: bash shell for testing and development
CMD ["/bin/bash"]
