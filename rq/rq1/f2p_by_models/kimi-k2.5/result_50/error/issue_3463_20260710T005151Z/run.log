ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"

# Set PYTHONPATH for src/ layout (no pip install -e . needed)
ENV PYTHONPATH=/app/src:/app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    libffi-dev \
    libssl-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build tools
RUN python -m pip install --no-cache-dir --upgrade pip wheel setuptools

# Copy project files
COPY . .

# Install project dependencies from pyproject.toml if it exists
RUN if [ -f "pyproject.toml" ]; then \
        pip install --no-cache-dir . ; \
    fi

# Install test dependencies
RUN pip install --no-cache-dir \
    pytest>=8.0.0 \
    pytest-asyncio>=0.23.7 \
    pytest-mock \
    pytest-timeout>=2.3.1 \
    pytest-xdist>=3.6.1 \
    pytest-recording>=0.13.2 \
    pytest-subprocess>=1.5.2 \
    pytest-randomly>=3.16.0 \
    pytest-split>=0.9.0 \
    "setuptools<=81.0.0" \
    litellm \
    mem0ai \
    pandas \
    docling \
    qdrant-client[fastembed] \
    aisuite \
    tiktoken \
    pillow \
    cairosvg

# Verify critical packages can be imported
RUN python -c "import sys; sys.path.insert(0, '/app/src'); import crewai; import pytest; import litellm; print('preflight ok')"

CMD ["/bin/bash"]
