    portalocker==2.7.0 \
    && pip install --no-cache-dir \
    pytest pytest-mock pytest-asyncio pytest-cov pytest-timeout pytest-xdist \
    pytest-subprocess pytest-recording pytest-randomly \
    && pip install --no-cache-dir -e . \
    && pip cache purge \
    && rm -rf /root/.cache/pip /tmp/* /var/tmp/* ~/.cache

# Copy the rest of the repository (tests, etc.)
COPY . .

# Final verification in one RUN to avoid extra layers
RUN python -c "import crewai; print('crewai ok')" \
    && python -c "import pytest; print('pytest ok')" \
    && python -c "import litellm; print('litellm ok')" \
    && echo "preflight ok"

# Default command
CMD ["/bin/bash"]
