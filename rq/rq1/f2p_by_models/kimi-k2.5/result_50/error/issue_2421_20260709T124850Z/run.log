# First install the core package with its dependencies
RUN pip install -e ".[tools,embeddings,agentops,pdfplumber,pandas,openpyxl,mem0,docling,aisuite]"

# Install additional test dependencies that may not be in pyproject.toml
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-timeout pytest-xdist pytest-subprocess pytest-recording pytest-randomly litellm mem0ai

# Install crewai-tools separately if needed
RUN pip install "crewai-tools~=0.58.0" || true

# Set environment variables for Forge API (OpenAI-compatible)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Set additional AI configuration
ENV MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

# Set Python path for src layout (tests import via crewai, not src.crewai)
ENV PYTHONPATH=/app/src:/app

# Verify installation by importing key modules
RUN python -c "import crewai; print('crewai imported successfully')" && \
    python -c "import pytest; print('pytest imported successfully')" && \
    python -c "import litellm; print('litellm imported successfully')" && \
    echo "preflight ok"

# Default command
CMD ["/bin/bash"]
