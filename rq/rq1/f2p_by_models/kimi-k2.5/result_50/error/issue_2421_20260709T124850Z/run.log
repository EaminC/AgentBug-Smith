        libxml2-dev \
        libxslt1-dev \
        python3-dev \
        build-essential \
    && pip install --no-cache-dir --upgrade pip wheel \
    && pip install --no-cache-dir "setuptools<=81.0.0" hatchling \
    && if [ -f "requirements.txt" ]; then pip install --no-cache-dir -r requirements.txt; fi \
    && pip install --no-cache-dir -e . \
    && pip install --no-cache-dir \
        pytest pytest-mock pytest-asyncio pytest-cov pytest-timeout pytest-xdist \
        litellm mem0ai \
    && apt-get purge -y --auto-remove gcc g++ build-essential python3-dev \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /root/.cache \
    && find /usr/local/lib/python*/site-packages -name "*.pyc" -delete 2>/dev/null || true \
    && find /usr/local/lib/python*/site-packages -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true \
    && python -c "import crewai; print('crewai ok')" \
    && python -c "import pytest; print('pytest ok')" \
    && echo "preflight ok"

