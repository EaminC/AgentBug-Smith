COPY README.md ./

# Install core dependencies only (without heavy extras) and test tools
# Clean up aggressively after each pip install
RUN pip install --no-cache-dir \
    pydantic>=2.4.2 \
    openai>=1.13.3 \
    litellm==1.74.3 \
    instructor>=1.3.3 \
    pdfplumber>=0.11.4 \
    regex>=2024.9.11 \
    opentelemetry-api>=1.30.0 \
    opentelemetry-sdk>=1.30.0 \
    opentelemetry-exporter-otlp-proto-http>=1.30.0 \
