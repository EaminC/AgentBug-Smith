COPY requirements.txt pyproject.toml ./
COPY autogpt/ ./autogpt/
COPY tests/ ./tests/
COPY scripts/ ./scripts/
COPY main.py run.sh run.bat run_continuous.sh run_continuous.bat ./
COPY data/ ./data/
COPY benchmark/ ./benchmark/

# Install everything in one RUN to minimize layers and cleanup aggressively
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc g++ libxml2-dev libxslt1-dev libffi-dev libssl-dev python3-dev git && \
    pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" && \
    pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio litellm && \
    pip install --no-cache-dir -r requirements.txt 2>/dev/null || true && \
    pip install --no-cache-dir -e . && \
    python -c "import pytest; print('preflight ok')" && \
    apt-get purge -y --auto-remove gcc g++ python3-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /root/.cache/pip /tmp/* /var/tmp/* && \
    find /app -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true

