    && pip install --no-cache-dir -e . 2>/dev/null || echo "Note: Project editable install may have issues" \
    && pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio litellm 2>/dev/null || true \
    && rm -rf /root/.cache/pip /tmp/* /var/tmp/* \
    && find /app -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true

# Preflight check - verify pytest is available
RUN python -c "import pytest; print('preflight ok: pytest available')" \
    && python -c "import sys; print(f'Python: {sys.version}')"

CMD ["/bin/bash"]
