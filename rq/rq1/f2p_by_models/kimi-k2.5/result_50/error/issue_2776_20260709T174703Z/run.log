        /root/.cache /opt/venv/share/man /opt/venv/share/doc \
        /opt/venv/include /usr/share/man /usr/share/doc \
        /usr/local/include/python3.12

# Copy tests
COPY tests/ ./tests/

# Verify installation
RUN python -c "import crewai; print('crewai ok')" \
    && python -c "import pytest; print('pytest ok')"

CMD ["/bin/bash"]
