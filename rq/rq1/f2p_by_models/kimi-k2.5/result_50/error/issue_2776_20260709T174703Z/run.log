    && rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Install test dependencies
RUN pip install --no-cache-dir \
    pytest>=8.0.0 pytest-asyncio>=0.23.7 pytest-subprocess>=1.5.2 pytest-recording>=0.13.2 \
    pytest-randomly>=3.16.0 pytest-timeout>=2.3.1 pytest-xdist>=3.6.1 pytest-mock pytest-cov \
    anyio "setuptools<=81.0.0" mem0ai \
