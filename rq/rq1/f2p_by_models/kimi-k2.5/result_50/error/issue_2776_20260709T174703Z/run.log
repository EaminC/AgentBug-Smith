    pytest-split>=0.9.0 \
    pytest-mock \
    pytest-cov \
    anyio \
    "setuptools<=81.0.0" \
    litellm \
    hatchling

# Copy the entire repository
COPY . .

# For src/ layout, use PYTHONPATH
ENV PYTHONPATH=/app/src

# Pre-flight check to ensure basic imports work
RUN python -c "import sys; print('Python:', sys.version)" && \
    python -c "import pydantic; print('pydantic OK')" && \
