    MODEL=tuzi-kimi-k2.5/kimi-k2.5 \
    AI_TEMPERATURE=0.7 \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1 \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    ANTHROPIC_MODEL=tuzi-kimi-k2.5/kimi-k2.5 \
    ANTHROPIC_SMALL_FAST_MODEL=tuzi-kimi-k2.5/kimi-k2.5 \
    OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    TAVILY_API_KEY=tvly-dev-key \
    GITHUB_TOKEN=ghp_key \
    PYTHONPATH=/app/src

WORKDIR /app

# Install system dependencies first (separate layer for caching)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ python3-dev libxml2-dev libxslt1-dev libffi-dev libssl-dev git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build tools
RUN pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" hatchling

# Install Python dependencies in smaller groups to reduce layer size
RUN pip install --no-cache-dir \
    pydantic>=2.4.2 \
    openai>=1.13.3 \
    litellm==1.60.2 \
    instructor>=1.3.3

RUN pip install --no-cache-dir \
    pdfplumber>=0.11.4 \
    regex>=2024.9.11 \
    opentelemetry-api>=1.30.0 \
    opentelemetry-sdk>=1.30.0 \
    opentelemetry-exporter-otlp-proto-http>=1.30.0

RUN pip install --no-cache-dir \
    chromadb>=0.5.23 \
    openpyxl>=3.1.5 \
    pyvis>=0.3.2 \
    auth0-python>=4.7.1 \
    python-dotenv>=1.0.0

RUN pip install --no-cache-dir \
    click>=8.1.7 \
    appdirs>=1.4.4 \
    jsonref>=1.1.0 \
    json-repair>=0.25.2 \
    uv>=0.4.25 \
    tomli-w>=1.1.0 \
    tomli>=2.0.2 \
    blinker>=1.9.0 \
    json5>=0.10.0

RUN pip install --no-cache-dir \
    crewai-tools~=0.40.1 \
    tiktoken~=0.7.0 \
    fastembed>=0.4.1 \
    mem0ai>=0.1.29 \
    pandas>=2.2.3

RUN pip install --no-cache-dir \
    pytest>=8.0.0 \
    pytest-vcr>=1.0.2 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
    pytest-mock \
    pytest-xdist \
    pytest-timeout \
    pytest-cov

# Copy repository and install in editable mode
COPY . .
RUN pip install --no-cache-dir -e .

# Cleanup build dependencies to reduce image size
RUN apt-get purge -y --auto-remove gcc g++ python3-dev \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /root/.cache/pip

CMD ["/bin/bash"]
