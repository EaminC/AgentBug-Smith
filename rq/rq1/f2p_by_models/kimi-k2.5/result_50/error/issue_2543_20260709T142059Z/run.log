# Using PYTHONPATH instead of editable install for src/ layout compatibility
RUN pip install --no-cache-dir -e .[tools,embeddings,mem0,fastembed] 2>/dev/null || \
    pip install --no-cache-dir -e .

# Install test dependencies
RUN pip install --no-cache-dir \
    pytest>=8.0.0 \
    pytest-vcr>=1.0.2 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
    pytest-mock \
    pytest-xdist \
    pytest-timeout \
    pytest-cov \
    litellm

# Copy the rest of the repository (excluding ignored files like .cache/)
COPY . .

# Verify installation
RUN python -c "import crewai; print('crewai imported successfully')" && \
    python -c "import pytest; print(f'pytest {pytest.__version__}')" && \
    python -c "import litellm; print('litellm imported successfully')"

