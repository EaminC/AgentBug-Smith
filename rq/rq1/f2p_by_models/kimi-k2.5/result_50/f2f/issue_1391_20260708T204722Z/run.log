def test_tavily_tool_names_use_underscores():
    """Test that DeepResearch example uses underscore format for Tavily tool names (issue #1391)."""
    repo_root = Path(__file__).parent.parent
    main_file = repo_root / "examples" / "agent" / "deep_research_agent" / "main.py"
    
    # Read file content - raises FileNotFoundError if missing
    content = main_file.read_text()
    
    # Bug check: hyphenated names should not exist
    assert "tavily-search" not in content, "Found buggy tool name 'tavily-search', should use 'tavily_search'"
    assert "tavily-extract" not in content, "Found buggy tool name 'tavily-extract', should use 'tavily_extract'"
    
    # Fix verification: underscore names should exist
    assert "tavily_search" in content, "Should use 'tavily_search'"
    assert "tavily_extract" in content, "Should use 'tavily_extract'"[0m
