[32mimport inspect
import sys
from pathlib import Path

def test_deep_research_tavily_tool_names_underscore_format():
    """Verify Tavily tool names use underscore format to match MCP registration.
    
    Regression test for issue #1391: Deep Research Agent tool name mismatch
    causes repeated search and skipped extract follow-up.
    
    Bug: Code used hyphenated names ('tavily-search', 'tavily-extract') which
    don't match the MCP-registered underscored names ('tavily_search', 
    'tavily_extract'), breaking name-based branch logic.
    
    Fix: All tool name references use underscore format to ensure consistency
    with MCP registration and proper follow-up extraction triggering.
    """
    # Locate the deep research agent source file
    possible_paths = [
        Path("examples/agent/deep_research_agent/main.py"),
        Path("examples/agent/deep_research_agent/deep_research_agent.py"),
        Path("examples/deep_research/main.py"),
        Path("examples/agent/deep_research/main.py"),
    ]
    
    source_file = None
    for path in possible_paths:
        if path.exists():
            source_file = path
            break
    
    assert source_file is not None, (
        f"Deep Research agent source file not found. "
        f"Searched paths: {[str(p) for p in possible_paths]}"
    )
    
    content = source_file.read_text()
    
    # Bug check: Should NOT contain hyphenated tool names that cause mismatch
    assert "tavily-search" not in content, (
        f"Bug found in {source_file}: Using 'tavily-search' (hyphenated) "
        f"instead of 'tavily_search' (underscored). This breaks MCP tool "
        f"name matching and prevents extract follow-up from triggering."
    )
    assert "tavily-extract" not in content, (
        f"Bug found in {source_file}: Using 'tavily-extract' (hyphenated) "
        f"instead of 'tavily_extract' (underscored). This breaks MCP tool "
        f"name matching and prevents extract follow-up from triggering."
    )
    
    # Fix verification: SHOULD contain underscored tool names matching MCP registry
    assert "tavily_search" in content, (
        f"Expected 'tavily_search' (underscored) in {source_file} "
        f"to match MCP registered tool names and ensure proper branch logic."
    )
    assert "tavily_extract" in content, (
        f"Expected 'tavily_extract' (underscored) in {source_file} "
        f"to match MCP registered tool names and ensure proper extract follow-up."
    )[0m
