# Configure environment variables for Forge API (OpenAI-compatible)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set Python environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src

# Install system dependencies (build tools, compilation libraries)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install essential build tools
RUN python -m pip install --upgrade pip wheel setuptools

# Copy the entire repository
COPY . .

# Install the project and its dependencies
# Using pip install with dev extras for testing support
RUN pip install -e .[dev]

# Install additional test dependencies explicitly
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-forked pytest-timeout \
    pytest-xdist anyio "setuptools<=81.0.0" litellm mem0ai fakeredis aiosqlite greenlet

# Verify installation
RUN python -c "import agentscope; print('agentscope imported successfully')" && \
    python -c "import pytest; print('pytest imported successfully')"

# Final command to start bash shell
CMD ["/bin/bash"]
