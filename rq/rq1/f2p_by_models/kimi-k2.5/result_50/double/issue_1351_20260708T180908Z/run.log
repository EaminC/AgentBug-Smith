"""Regression test for issue 1351: JSON string repair edge case for tool callings."""
from typing import AsyncGenerator
from unittest.async_case import IsolatedAsyncioTestCase
from unittest.mock import Mock, patch, AsyncMock

from agentscope.model import OpenAIChatModel
from agentscope.message import ToolUseBlock


class TestStreamingJsonRepairRegression(IsolatedAsyncioTestCase):
    """Test for issue 1351: edge case where final JSON is shorter than repaired partial."""

    async def test_streaming_tool_input_prefers_valid_final_json(self) -> None:
        """
        Test that when streaming tool arguments, if the final valid JSON
        is shorter than the previously repaired partial JSON, the final
        valid JSON is still used.
        
        This is a regression test for:
        https://github.com/agentscope-ai/agentscope/issues/1351
        
        Before fix: Partial '{"points": ' (repaired length 14) was kept
        instead of final '{"points": 1}' (length 13) because the length
        comparison favored the longer (but incorrect) repaired partial.
        """
        with patch("openai.AsyncClient") as mock_client_class:
            mock_client = AsyncMock()
            mock_client_class.return_value = mock_client

            model = OpenAIChatModel(
                model_name="gpt-4",
                api_key="test_key",
                stream=True,
            )
            model.client = mock_client

            # Simulate streaming: first partial JSON, then completion
            async def stream_generator():
                # First chunk: incomplete JSON that will be repaired to something longer
                chunk1 = Mock()
                chunk1.choices = [
                    Mock(
                        delta=Mock(
                            tool_calls=[
                                Mock(
                                    id="call_123",
                                    type="function",
                                    function=Mock(
                                        name="score",
                                        arguments='{"points": ',
                                    ),
                                ),
                            ],
                        ),
                    ),
                ]
                chunk1.usage = None
                
                # Second chunk: complete valid JSON (shorter than repaired partial)
                chunk2 = Mock()
                chunk2.choices = [
                    Mock(
                        delta=Mock(
                            tool_calls=[
                                Mock(
                                    id="call_123",
                                    type="function",
                                    function=Mock(
                                        arguments="1}",
                                    ),
                                ),
                            ],
                        ),
                    ),
                ]
                chunk2.usage = Mock(output_tokens=5)
                
                yield chunk1
                yield chunk2

            mock_client.chat.completions.create = AsyncMock(
                return_value=stream_generator(),
            )

            result = await model([{"role": "user", "content": "Score it"}])

            responses = []
            async for response in result:
                responses.append(response)

            final_response = responses[-1]
            
            # The key assertion: input should be {"points": 1}, not the repaired partial
            expected_content = [
                ToolUseBlock(
                    type="tool_use",
                    id="call_123",
                    name="score",
                    input={"points": 1},
                    raw_input='{"points": 1}',
                ),
            ]
            self.assertEqual(final_response.content, expected_content)


