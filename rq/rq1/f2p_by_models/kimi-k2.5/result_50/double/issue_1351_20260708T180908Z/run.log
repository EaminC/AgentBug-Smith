RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build tools
RUN python -m pip install --upgrade pip wheel setuptools

# Copy only pyproject.toml first for better layer caching
COPY pyproject.toml ./
COPY src ./src

# Install core dependencies from pyproject.toml first (without extras)
# This helps with caching and avoids timeout
RUN pip install --no-cache-dir \
    aioitertools \
    anthropic \
    dashscope \
    docstring_parser \
    filetype \
    json5 \
    json_repair \
    mcp>=1.13 \
    numpy \
    openai \
    python-datauri \
    opentelemetry-api>=1.39.0 \
    opentelemetry-sdk>=1.39.0 \
    opentelemetry-exporter-otlp>=1.39.0 \
    opentelemetry-semantic-conventions>=0.60b0 \
    python-socketio \
    shortuuid \
    tiktoken \
    sounddevice \
    sqlalchemy \
    python-frontmatter \
    aiofiles

# Install the package in editable mode (core only, no extras)
RUN pip install --no-cache-dir -e . --no-deps

# Install test dependencies explicitly
RUN pip install --no-cache-dir \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-forked \
    pytest-timeout \
    pytest-xdist \
    anyio \
    "setuptools<=81.0.0" \
    litellm \
    mem0ai \
    fakeredis \
    aiosqlite \
    greenlet \
    Pillow \
    transformers \
    jinja2

# Copy the rest of the repository
COPY . .

# Verify installation
RUN python -c "import agentscope; print('agentscope imported successfully')" && \
    python -c "import pytest; print('pytest imported successfully')"

# Final command
CMD ["/bin/bash"]
