[32mFROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Detect src layout and install accordingly
# The project uses src/agentscope layout per pyproject.toml: packages = { find = { where = ["src"] } }
# Tests likely import via src.agentscope, so we avoid editable install to prevent duplicate module paths
RUN python -m pip install --upgrade pip wheel setuptools && \
    if [ -f requirements.txt ]; then \
        pip install -r requirements.txt; \
    fi && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai && \
    pip install -e .[dev] --no-deps || pip install -e .[dev] && \
    pip install -e . --no-deps || pip install -e .

# Set PYTHONPATH for src layout to ensure tests import from single source
ENV PYTHONPATH=/app/src:/app

# Verify installation
RUN python -c "import agentscope, pytest; print('preflight ok')"

