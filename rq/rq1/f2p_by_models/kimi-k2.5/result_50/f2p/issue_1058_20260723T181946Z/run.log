"""Fail2pass test for issue #1058: _json_loads_with_repair causes system hang.

This test verifies that the _json_loads_with_repair function handles complex
JSON strings with special characters (quotes, newlines) without crashing or
hanging, and that the stream_tool_parsing feature works correctly.
"""
import json
from unittest import IsolatedAsyncioTestCase
from unittest.mock import Mock, patch, AsyncMock

from agentscope._utils._common import _json_loads_with_repair
from agentscope.model import OpenAIChatModel, DashScopeChatModel, AnthropicChatModel


class TestJsonLoadsWithRepair(IsolatedAsyncioTestCase):
    """Test cases for _json_loads_with_repair function."""

    def test_json_loads_with_repair_simple_dict(self) -> None:
        """Test that simple JSON dicts are parsed correctly."""
        result = _json_loads_with_repair('{"key": "value"}')
        self.assertEqual(result, {"key": "value"})

    def test_json_loads_with_repair_complex_content(self) -> None:
        """Test that complex content with newlines and quotes is handled.

        This is the core bug: _json_loads_with_repair should not hang or crash
        when processing complex strings with special characters.
        """
        # Complex YAML/JSON content with newlines and quotes (like file_content)
        complex_content = '''{
            "file_content": "apiVersion: v1\\nkind: Pod\\nmetadata:\\n  name: \\"test-pod\\"\\n  labels:\\n    app: nginx"
        }'''
        
        # This should not hang or crash
        result = _json_loads_with_repair(complex_content)
        self.assertIsInstance(result, dict)
        self.assertIn("file_content", result)

    def test_json_loads_with_repair_multiline_yaml(self) -> None:
        """Test multiline YAML content that commonly causes hangs."""
        yaml_content = '''{
            "file_content": "name: example\\nconfig:\\n  - item1\\n  - item2\\n  nested:\\n    key: \\"value with quotes\\""
        }'''
        
        result = _json_loads_with_repair(yaml_content)
        self.assertIsInstance(result, dict)
        self.assertIn("file_content", result)

    def test_json_loads_with_repair_unicode_quotes(self) -> None:
        """Test handling of unicode quotes ("")."""
        content_with_unicode_quotes = '''{
            "description": "This uses \u201cunicode quotes\u201d in the text"
        }'''
        
        result = _json_loads_with_repair(content_with_unicode_quotes)
        self.assertIsInstance(result, dict)

    def test_json_loads_with_repair_incomplete_json(self) -> None:
        """Test that incomplete JSON is repaired without hanging."""
        incomplete = '{"key": "value", "nested": {"a": "b"'
        
        # Should not hang on incomplete JSON
        result = _json_loads_with_repair(incomplete)
        self.assertIsInstance(result, dict)

    def test_json_loads_with_repair_empty_string(self) -> None:
        """Test handling of empty string."""
        result = _json_loads_with_repair("")
        self.assertEqual(result, {})

    def test_json_loads_with_repair_invalid_json(self) -> None:
        """Test handling of completely invalid JSON."""
        result = _json_loads_with_repair("not json at all")
        self.assertEqual(result, {})


class TestStreamToolParsing(IsolatedAsyncioTestCase):
    """Test that stream_tool_parsing feature works correctly."""

    async def test_openai_stream_tool_parsing_disabled(self) -> None:
        """Test that OpenAI model respects stream_tool_parsing=False."""
        with patch("openai.AsyncOpenAI") as mock_client_class:
            mock_client = Mock()
            mock_client_class.return_value = mock_client
            
            model = OpenAIChatModel(
