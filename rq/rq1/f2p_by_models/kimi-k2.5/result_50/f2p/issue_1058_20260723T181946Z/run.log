"""Fail2pass test for issue #1058: _json_loads_with_repair causes system hang.

This test verifies that the _json_loads_with_repair function:
1. Uses stream_stable=True to avoid infinite loops on complex JSON
2. Properly handles complex JSON strings with special characters
3. Returns empty dict on failure instead of hanging
"""
import json
from unittest import IsolatedAsyncioTestCase
from unittest.mock import Mock, patch, AsyncMock

from agentscope._utils._common import _json_loads_with_repair
from agentscope.model import OpenAIChatModel, DashScopeChatModel, AnthropicChatModel
from agentscope.message import ToolUseBlock


class TestJsonLoadsWithRepair(IsolatedAsyncioTestCase):
    """Test cases for _json_loads_with_repair function."""

    def test_complex_json_with_special_characters(self) -> None:
        """Test that complex JSON with special characters doesn't hang."""
        # Complex JSON with newlines, quotes, and special characters
        # This simulates file content that would be passed to a write_file tool
        complex_json = '''{"file_content": "apiVersion: v1\\nkind: Pod\\nmetadata:\\n  name: test\\nspec:\\n  containers:\\n  - name: nginx\\n    image: nginx:latest\\n    ports:\\n    - containerPort: 80", "filename": "pod.yaml"}'''
        
        # This should return a dict, not hang
        result = _json_loads_with_repair(complex_json)
        self.assertIsInstance(result, dict)
        self.assertIn("file_content", result)
        self.assertIn("filename", result)

    def test_incomplete_json_with_newlines(self) -> None:
        """Test that incomplete JSON with newlines is handled gracefully."""
        # Incomplete JSON that would cause issues with the old implementation
        incomplete_json = '{"content": "line1\\nline2\\nline3'
        
        # Should return empty dict, not hang
        result = _json_loads_with_repair(incomplete_json)
        self.assertIsInstance(result, dict)

    def test_json_with_unicode_quotes(self) -> None:
        """Test JSON with unicode smart quotes."""
        # JSON with unicode quotes that might cause parsing issues
        json_with_unicode = '{"text": "Hello "world" test"}'
        
        result = _json_loads_with_repair(json_with_unicode)
        self.assertIsInstance(result, dict)

    def test_very_long_complex_json(self) -> None:
        """Test that very long complex JSON doesn't cause performance issues."""
        # Create a long JSON string with nested structure
        long_content = "line\\n" * 1000
        long_json = f'{{"file_content": "{long_content}", "metadata": {{"key": "value"}}}}'
        
        # Should complete quickly, not hang
        result = _json_loads_with_repair(long_json)
        self.assertIsInstance(result, dict)

    def test_malformed_json_returns_empty_dict(self) -> None:
        """Test that truly malformed JSON returns empty dict."""
        # Completely malformed JSON
        malformed = "this is not json at all {{{"
        
        result = _json_loads_with_repair(malformed)
        self.assertEqual(result, {})

    def test_valid_json_parsed_correctly(self) -> None:
        """Test that valid JSON is still parsed correctly."""
        valid_json = '{"key": "value", "number": 42}'
        
        result = _json_loads_with_repair(valid_json)
        self.assertEqual(result, {"key": "value", "number": 42})


