# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Detect src/ layout: check if tests import via src. or if src/ directory exists with package
# Based on repository structure, this uses src/agentscope/ layout with package_dir={"": "src"} in setup.py
