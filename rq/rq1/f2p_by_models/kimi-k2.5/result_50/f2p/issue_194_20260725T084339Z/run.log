    Test that memory.load() properly converts dict/list[dict] to Msg objects.
    This test should fail before the fix and pass after.
    """

    def setUp(self) -> None:
        self.memory = TemporaryMemory()
        self.temp_file = tempfile.NamedTemporaryFile(
            mode='w',
            suffix='.json',
            delete=False,
            encoding='utf-8'
        )
        self.temp_file.close()

    def tearDown(self) -> None:
        if os.path.exists(self.temp_file.name):
            os.remove(self.temp_file.name)

    def test_load_list_of_dicts_converts_to_msg(self) -> None:
        """
        Test that loading a list of dicts converts them to Msg objects.
        Before fix: memory contains dict objects
        After fix: memory contains Msg objects
        """
        # Create dict inputs (simulating JSON file content)
        dict_memories = [
            {"name": "user", "content": "Hello", "role": "user"},
            {"name": "agent", "content": "Hi there!", "role": "assistant"},
        ]

        # Load the dicts into memory
        self.memory.load(dict_memories)

        # Get the loaded memories
        loaded = self.memory.get_memory()

        # Verify we have the right number of memories
        self.assertEqual(len(loaded), 2)

        # CRITICAL: After fix, these should be Msg objects, not dicts
        for mem in loaded:
            self.assertIsInstance(
                mem,
                Msg,
                f"Expected Msg instance, got {type(mem).__name__}: {mem}"
            )

    def test_load_from_file_converts_to_msg(self) -> None:
        """
        Test that loading from a JSON file converts dicts to Msg objects.
        Before fix: memory contains dict objects
        After fix: memory contains Msg objects
        """
        # Create Msg objects and serialize them to file (proper format)
        msgs = [
            Msg(name="user", content="Hello", role="user"),
            Msg(name="agent", content="How can I help?", role="assistant"),
        ]

        # Write serialized messages to file
        with open(self.temp_file.name, 'w', encoding='utf-8') as f:
            f.write(serialize(msgs))

        # Load from file
        self.memory.load(self.temp_file.name)

        # Get the loaded memories
        loaded = self.memory.get_memory()

        # Verify we have the right number of memories
        self.assertEqual(len(loaded), 2)

        # CRITICAL: After fix, these should be Msg objects, not dicts
        for mem in loaded:
            self.assertIsInstance(
                mem,
                Msg,
                f"Expected Msg instance after loading from file, "
                f"got {type(mem).__name__}: {mem}"
            )

    def test_agent_reply_with_loaded_memory(self) -> None:
        """
        Simulate what happens when Agent tries to use loaded memory.
        The bug causes errors because Agent expects Msg objects but gets dicts.
        """
