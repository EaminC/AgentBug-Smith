[32m# -*- coding: utf-8 -*-
"""
Fail2pass test for memory module issue #194:
The load function loads json file/list[dict] to Agent memory, but the loaded
memory objects are dict instead of Msg. This causes errors when Agent replies.
"""

import unittest
import os
import tempfile

from agentscope.memory import TemporaryMemory
from agentscope.message import Msg, serialize


class MemoryLoadMsgTypeTest(unittest.TestCase):
    """
    Test that memory.load() properly converts dict/list[dict] to Msg objects.
    This is the bug reported in issue #194.
    """

    def setUp(self) -> None:
        self.memory = TemporaryMemory()
        self.temp_file = None

    def tearDown(self) -> None:
        if self.temp_file and os.path.exists(self.temp_file):
            os.remove(self.temp_file)

    def test_load_list_of_dicts_converts_to_msg(self) -> None:
        """
        Test that loading a list of dicts converts them to Msg objects.
        Before the fix: loaded objects remain as dict, causing errors in Agent.reply()
        After the fix: loaded objects are properly converted to Msg instances
        """
        # Create dict representations of messages (as would come from JSON)
        dict_messages = [
            {"name": "user", "content": "Hello", "role": "user"},
            {"name": "agent", "content": "Hi there!", "role": "assistant"},
        ]

        # Load the dicts into memory
        self.memory.load(dict_messages)

        # Get the loaded memory
        loaded_mem = self.memory.get_memory()

        # Verify we have the right number of messages
        self.assertEqual(len(loaded_mem), 2)

        # CRITICAL: Verify that loaded objects are Msg instances, not dict
        # This is what was broken - they were dict before the fix
        for mem in loaded_mem:
            self.assertIsInstance(
                mem,
                Msg,
                f"Expected Msg instance, got {type(mem)}. "
                f"Memory object: {mem}",
            )

    def test_load_from_json_file_converts_to_msg(self) -> None:
        """
        Test that loading from a JSON file properly deserializes to Msg objects.
        """
        # Create a temporary file with serialized messages
        messages = [
            Msg(name="user", content="Hello", role="user"),
            Msg(name="agent", content="How can I help?", role="assistant"),
        ]

        # Create temp file with serialized messages
        with tempfile.NamedTemporaryFile(
            mode="w",
            suffix=".json",
            delete=False,
            encoding="utf-8",
        ) as f:
            f.write(serialize(messages))
            self.temp_file = f.name

        # Clear and load from file
        self.memory.clear()
        self.memory.load(self.temp_file)

        # Get loaded memory
        loaded_mem = self.memory.get_memory()

        # Verify we have the right number of messages
        self.assertEqual(len(loaded_mem), 2)

        # CRITICAL: Verify that loaded objects are Msg instances
        for mem in loaded_mem:
            self.assertIsInstance(
                mem,
                Msg,
                f"Expected Msg instance when loading from file, got {type(mem)}",
            )

    def test_load_string_json_converts_to_msg(self) -> None:
        """
        Test that loading a JSON string properly deserializes to Msg objects.
        """
        # Create a JSON string with message data
        messages = [
            Msg(name="user", content="Test message", role="user"),
        ]
        json_str = serialize(messages)

        # Load from string
        self.memory.load(json_str)

        # Get loaded memory
        loaded_mem = self.memory.get_memory()

        # Verify we have messages
        self.assertEqual(len(loaded_mem), 1)

        # CRITICAL: Verify that loaded objects are Msg instances
        for mem in loaded_mem:
            self.assertIsInstance(
                mem,
                Msg,
                f"Expected Msg instance when loading from string, got {type(mem)}",
            )

    def test_msg_has_required_attributes_for_agent_reply(self) -> None:
        """
        Test that loaded Msg objects have the attributes needed for Agent.reply().
        The bug caused Agent.reply() to fail because dict doesn't have the
        same attributes as Msg.
        """
        dict_messages = [
            {"name": "user", "content": "Hello", "role": "user"},
        ]

        self.memory.load(dict_messages)
        loaded_mem = self.memory.get_memory()

        # Verify Msg attributes that Agent.reply() expects
        msg = loaded_mem[0]
        self.assertTrue(hasattr(msg, "name"))
        self.assertTrue(hasattr(msg, "content"))
        self.assertTrue(hasattr(msg, "role"))
        self.assertTrue(hasattr(msg, "to_dict"))

        # Verify we can call to_dict() (used in many Agent operations)
        self.assertIsInstance(msg.to_dict(), dict)


if __name__ == "__main__":
    unittest.main()[0m
