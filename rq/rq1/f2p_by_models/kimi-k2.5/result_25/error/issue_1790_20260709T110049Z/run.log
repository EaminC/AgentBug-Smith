    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install wheel
RUN python -m pip install --upgrade pip wheel

# Copy the entire repository
COPY . .

# Install crewai core dependencies first (litellm is essential for LLM routing)
RUN pip install litellm>=1.44.22 openai>=1.13.3 instructor>=1.3.3

# Install project dependencies from pyproject.toml
# Use --break-system-packages since we're in a container
RUN pip install --break-system-packages \
    pydantic>=2.4.2 \
    opentelemetry-api>=1.22.0 \
    opentelemetry-sdk>=1.22.0 \
    opentelemetry-exporter-otlp-proto-http>=1.22.0 \
    regex>=2024.9.11 \
    click>=8.1.7 \
    python-dotenv>=1.0.0 \
    appdirs>=1.4.4 \
    jsonref>=1.1.0 \
    json-repair>=0.25.2 \
    auth0-python>=4.7.1 \
    pyvis>=0.3.2 \
    uv>=0.4.25 \
    tomli-w>=1.1.0 \
    tomli>=2.0.2 \
    chromadb>=0.5.23 \
    pdfplumber>=0.11.4 \
    openpyxl>=3.1.5 \
    blinker>=1.9.0 \
    mem0ai>=0.1.29 \
    crewai-tools>=0.17.0 \
    fastembed>=0.4.1

# Install test dependencies
RUN pip install --break-system-packages \
    pytest>=8.0.0 \
    pytest-vcr>=1.0.2 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
    pytest-mock \
    pytest-xdist \
    pytest-timeout \
    setuptools<=81.0.0

# Install hatchling for building
RUN pip install --break-system-packages hatchling

# Install the project itself in editable mode
RUN pip install --break-system-packages -e .

# Pre-flight check - ensure key imports work
RUN python -c "import crewai; import litellm; import pytest; print('Preflight OK')"

# Set environment variables for Forge API (OpenAI-compatible)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional environment variables
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Set PYTHONPATH to include src for test discovery
ENV PYTHONPATH=/app/src:/app

# Final command - must be /bin/bash for testing environment
CMD ["/bin/bash"]
