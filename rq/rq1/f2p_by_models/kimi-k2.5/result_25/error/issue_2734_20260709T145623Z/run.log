[32m# Dockerfile for crewAI - AI agent orchestration framework
# Repository: crewAIInc/crewAI
# Configuration: Forge API integration

FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Prevent Python from writing pyc files and buffering stdout
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Set working directory
WORKDIR /app

# ============================================
# System dependencies for Python packages
# ============================================
# Install build essentials, git, and libraries needed for:
# - lxml (libxml2-dev, libxslt1-dev)
# - chromadb and other compiled deps (gcc, python3-dev)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    libffi-dev \
    libssl-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ============================================
# Upgrade pip and install base tools
# ============================================
RUN python -m pip install --upgrade pip wheel setuptools<=81.0.0

# ============================================
# Forge API Environment Variables
# ============================================
# OpenAI SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# ============================================
# Copy repository contents
# ============================================
COPY . .

# ============================================
# Install Python dependencies and project
# ============================================
# Install project dependencies based on available files
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi

# Install core crewAI framework and dependencies from pyproject.toml
# Using pip install -e . for editable install with hatchling backend
RUN pip install -e .

# Install crewai-tools for enhanced functionality
RUN pip install crewai-tools~=0.42.2 || true

# ============================================
# Install test dependencies
# ============================================
RUN pip install \
    pytest>=8.0.0 \
    pytest-asyncio>=0.23.7 \
    pytest-mock \
    pytest-xdist \
    pytest-timeout>=2.3.1 \
    pytest-subprocess>=1.5.2 \
    pytest-recording>=0.13.2 \
    pytest-randomly>=3.16.0 \
    pytest-cov

# Install additional dependencies that may be needed
RUN pip install \
    litellm \
    mem0ai>=0.1.94 \
    tiktoken~=0.7.0 \
    pandas>=2.2.3 \
    fastembed>=0.4.1 \
    docling>=2.12.0 \
    anyio

# ============================================
# Set PYTHONPATH for src layout
# ============================================
# The repository uses src/ layout, so we add it to PYTHONPATH
ENV PYTHONPATH=/app/src:$PYTHONPATH

# ============================================
# Pre-flight verification
# ============================================
RUN python -c "import crewai; print('crewai import successful')" && \
    python -c "import pytest; print('pytest import successful')"

# ============================================
# Final configuration
# ============================================
# Default to bash shell
CMD ["/bin/bash"]
