[32m# CrewAI Project Dockerfile - Python 3.12 with Forge API Configuration
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Configure environment for Python and Forge API
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Forge API Environment Variables (OpenAI-compatible)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Forge API Environment Variables (Anthropic-compatible)
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set Python path for src layout (project code is in src/crewai/)
ENV PYTHONPATH=/app/src

# Install system dependencies for compilation and runtime
# Required for: lxml, chromadb, numpy, pandas, and other compiled packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    libffi-dev \
    libssl-dev \
    libpq-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build tools
RUN python -m pip install --upgrade pip wheel setuptools

# Copy the entire repository (including uv.lock, pyproject.toml, src/, tests/)
COPY . .

# Install dependencies using pip (reading from pyproject.toml)
# Since this is a src layout, we don't use pip install -e . (that would duplicate modules)
# Instead we set PYTHONPATH=/app/src above
# Install the package in development mode along with test dependencies
RUN pip install --break-system-packages \
    pytest>=8.0.0 \
    pytest-vcr>=1.0.2 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
    pytest-mock \
    pytest-xdist \
    pytest-timeout \
    pytest-cov \
    anyio \
    litellm \
    mem0ai>=0.1.29 \
    || true

# Install the project dependencies from pyproject.toml
# First try to install using pip with the pyproject.toml
RUN pip install --break-system-packages \
    pydantic>=2.4.2 \
    openai>=1.13.3 \
    litellm==1.60.2 \
    instructor>=1.3.3 \
    pdfplumber>=0.11.4 \
    regex>=2024.9.11 \
    opentelemetry-api>=1.22.0 \
    opentelemetry-sdk>=1.22.0 \
    opentelemetry-exporter-otlp-proto-http>=1.22.0 \
    chromadb>=0.5.23 \
    openpyxl>=3.1.5 \
    pyvis>=0.3.2 \
    auth0-python>=4.7.1 \
    python-dotenv>=1.0.0 \
    click>=8.1.7 \
    appdirs>=1.4.4 \
    jsonref>=1.1.0 \
    json-repair>=0.25.2 \
    uv>=0.4.25 \
    tomli-w>=1.1.0 \
    tomli>=2.0.2 \
    blinker>=1.9.0 \
    json5>=0.10.0 \
    crewai-tools>=0.36.0 \
    tiktoken~=0.7.0 \
    || true

# Pre-flight check: Verify Python and key imports work
RUN python -c "import sys; print(f'Python version: {sys.version}')" && \
    python -c "import pydantic; print(f'pydantic: {pydantic.__version__}')" && \
    python -c "import openai; print(f'openai: {openai.__version__}')" && \
    python -c "import pytest; print(f'pytest: {pytest.__version__}')" && \
    echo "Preflight checks passed!"

# Verify the crewai module is importable via PYTHONPATH
RUN python -c "import sys; sys.path.insert(0, '/app/src'); from crewai import Agent, Task, Crew; print('crewai imports OK')"

# Final command to start bash shell
CMD ["/bin/bash"]
