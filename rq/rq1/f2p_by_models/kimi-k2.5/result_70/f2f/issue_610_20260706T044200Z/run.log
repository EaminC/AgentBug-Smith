[32m# Open Interpreter - Python project with Poetry + Node.js for JavaScript execution
# Using Python 3.11 slim as base (project requires ^3.10)
FROM python:3.11-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install system dependencies including Node.js in a single RUN to reduce layers
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    git \
    curl \
    ca-certificates \
    gnupg2 \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20.x (LTS) using NodeSource repository
# Using the new nodesource setup method for better reliability
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# Verify Node.js and npm are properly installed
RUN node --version && npm --version

# Upgrade pip, wheel, setuptools
RUN python -m pip install --upgrade pip wheel setuptools

# Install poetry using pip
RUN pip install poetry

# Configure poetry to not create virtual environments (we're in a container)
ENV POETRY_VIRTUALENVS_CREATE=false

# Copy the entire repository
COPY . .

# Install project dependencies using Poetry
RUN if [ -f "poetry.lock" ]; then \
        echo "Installing with poetry.lock..." && \
        poetry install --no-interaction --no-ansi; \
    else \
        echo "Installing from pyproject.toml without lockfile..." && \
        poetry install --no-interaction --no-ansi --no-root; \
    fi

# Install the project itself in editable mode
RUN pip install -e . || pip install .

# Install pytest and other required test dependencies explicitly
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout \
    litellm \
    "setuptools<=81.0.0"

# Forge API configuration - OpenAI compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Forge API configuration - Anthropic compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Default model configuration
ENV MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-kimi-k2.5/kimi-k2.5

# Additional AI configuration
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

# Ensure Node.js and Python are in PATH explicitly
ENV PATH="/usr/bin:/usr/local/bin:$PATH"

# Preflight check - verify critical imports work and Node.js is accessible
RUN python -c "import interpreter; print('Interpreter import OK')" && \
    python -c "import pytest; print('pytest import OK')" && \
    python -c "import openai; print('openai import OK')" && \
    which node && node --version && \
    echo "Preflight checks passed"

# Default command is bash for interactive testing
CMD ["/bin/bash"]
