[32mimport os
import sys
import pytest

def test_powershell_code_interpreter_creation():
    """Test that PowerShell code interpreter can be created without KeyError."""
    from interpreter.code_interpreters.create_code_interpreter import create_code_interpreter
    
    # This should raise ValueError: Unknown or unsupported language: powershell
    # before the fix, and succeed after the fix
    interpreter = create_code_interpreter("powershell")
    
    # Verify we got a valid interpreter object
    assert interpreter is not None
    assert hasattr(interpreter, 'file_extension')
    assert interpreter.file_extension == "ps1"

def test_powershell_in_language_map():
    """Test that powershell is present in the language map."""
    from interpreter.code_interpreters.language_map import language_map
    
    assert "powershell" in language_map
    
    # Verify we can instantiate it
    ps_class = language_map["powershell"]
    instance = ps_class()
    assert instance is not None
    assert instance.proper_name == "PowerShell"

if __name__ == "__main__":
    pytest.main([__file__, "-v"])[0m
