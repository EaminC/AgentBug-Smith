[32mimport json
import pytest
from metagpt.provider.bedrock.bedrock_provider import get_provider
from metagpt.provider.bedrock.utils import NOT_SUPPORT_STREAM_MODELS


class TestBedrockProviderFixes:
    def test_typo_fix_not_support_stream_models(self):
        """Test that NOT_SUUPORT_STREAM_MODELS typo is fixed to NOT_SUPPORT_STREAM_MODELS."""
        # Before patch: ImportError because the name was NOT_SUUPORT_STREAM_MODELS (typo)
        # After patch: Import succeeds and constant contains expected models
        assert isinstance(NOT_SUPPORT_STREAM_MODELS, dict)
        assert "ai21.j2-mid-v1" in NOT_SUPPORT_STREAM_MODELS

    def test_ai21_jamba_request_format(self):
        """Test that Ai21 Jamba models use messages format instead of prompt format."""
        provider = get_provider("ai21.jamba-instruct-v1:0")
        messages = [{"role": "user", "content": "Hello"}]
        body = provider.get_request_body(messages, {"max_tokens": 100})
        body_dict = json.loads(body)
        
        # Before patch: Ai21Provider had no model_type handling, used base class which produces "prompt" key
        # After patch: Ai21Provider detects jamba and produces "messages" key
        assert "messages" in body_dict, "Jamba should use messages format instead of prompt format"
        assert body_dict["messages"] == messages
        assert "prompt" not in body_dict

    def test_cohere_command_r_message_format(self):
        """Test that Cohere command-r models return list format for messages_to_prompt."""
        provider = get_provider("cohere.command-r-v1:0")
        messages = [{"role": "user", "content": "Hello"}, {"role": "assistant", "content": "Hi"}]
        result = provider.messages_to_prompt(messages)
        
        # Before patch: CohereProvider had no model_name handling, returned string format from base class
        # After patch: CohereProvider detects command-r and returns list format with USER/CHATBOT roles
        assert isinstance(result, list), "command-r should return list format, not string"
        assert result[0]["role"] == "USER"
        assert result[0]["message"] == "Hello"

    def test_cohere_command_r_request_body(self):
        """Test that Cohere command-r request body uses message and chat_history fields."""
        provider = get_provider("cohere.command-r-v1:0")
        messages = [{"role": "system", "content": "Be helpful"}, {"role": "user", "content": "Hello"}]
        body = provider.get_request_body(messages, {})
        body_dict = json.loads(body)
        
        # Before patch: CohereProvider used base class get_request_body producing "prompt" and "stream" keys
        # After patch: CohereProvider for command-r produces "message" and "chat_history" keys
        assert "message" in body_dict, "Command-r should use message field"
        assert "chat_history" in body_dict, "Command-r should use chat_history field"
        assert "prompt" not in body_dict, "Command-r should not use prompt field"[0m
