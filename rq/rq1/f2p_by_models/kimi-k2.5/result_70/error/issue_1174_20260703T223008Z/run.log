[32mFROM python:3.11-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"



# --- end inject ---

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    build-essential \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    gcc \
    g++ \
    libgomp1 \
    zlib1g-dev \
    libjpeg-dev \
    libpng-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# Upgrade pip and core tools
RUN python -m pip install --no-cache-dir --upgrade pip wheel "setuptools>=65.0.0,<82.0.0"

# Install critical packages FIRST (that modules import directly)
# docx module comes from python-docx package
# PIL module comes from Pillow package
RUN pip install --no-cache-dir \
    python-docx \
    Pillow \
    numpy \
    pandas \
    scikit-learn \
    faiss-cpu \
    lancedb \
    qdrant-client \
    libcst \
    loguru \
    aiohttp \
    pydantic \
    PyYAML \
    tenacity \
    tiktoken \
    tqdm \
    anthropic \
    typing-inspect \
    wrapt \
    aiofiles \
    gitpython \
    zhipuai \
    rich \
    nbclient \
    nbformat \
    ipython \
    ipykernel \
    typing-extensions \
    socksio \
    gitignore-parser \
    websockets \
    networkx \
    google-generativeai \
    playwright \
    anytree \
    ipywidgets \
    imap-tools \
    qianfan \
    dashscope \
    rank-bm25 \
    jieba \
    gymnasium \
    boto3 \
    spark_ai_python \
    agentops \
    curl-cffi \
    httplib2 \
    websocket-client \
    meilisearch \
    fire \
    typer \
    openpyxl \
    beautifulsoup4 \
    redis \
    ta \
    channels \
    openai

# Install test dependencies explicitly
RUN pip install --no-cache-dir \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    anyio \
    litellm \
    mem0ai

# Install the project itself (try editable first, then regular)
RUN pip install --no-cache-dir -e . || pip install --no-cache-dir . || true

# Final verification - check critical imports work
RUN python -c "import docx; print('docx OK')" && \
    python -c "from PIL import Image; print('PIL OK')" && \
    python -c "import sys, pytest; print(f'Python {sys.version}'); print('Environment ready')"

CMD ["/bin/bash"]
