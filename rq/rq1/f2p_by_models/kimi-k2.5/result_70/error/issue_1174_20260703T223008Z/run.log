# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"



# --- end inject ---

# Install system dependencies: git, chromium (for mermaid), fonts, nodejs, and build tools
# Added rustc and cargo for building packages that need rust
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 git chromium fonts-ipafont-gothic fonts-wqy-zenhei fonts-thai-tlwg fonts-freefont-ttf libxss1 \
    curl ca-certificates \
    build-essential libxml2-dev libxslt1-dev python3-dev gcc \
    rustc cargo \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Configure environment for mermaid-cli to use system chromium
ENV CHROME_BIN="/usr/bin/chromium" \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD="true"

# Install Mermaid CLI globally
RUN npm install -g @mermaid-js/mermaid-cli && npm cache clean --force

WORKDIR /app
COPY . .

# Fix requirements.txt issues before installing:
# 1. faiss_cpu 1.7.4 doesn't have Python 3.12 wheels - use faiss-cpu>=1.7.4
# 2. Update setuptools to support pkg_resources
# 3. Update qdrant-client to avoid grpcio-tools version conflicts
# 4. Update libcst to a version with pre-built wheels for Python 3.12
RUN sed -i 's/faiss_cpu==1.7.4/faiss-cpu>=1.7.4/' requirements.txt && \
    sed -i 's/setuptools==65.6.3/setuptools>=68.0.0,<81.0.0/' requirements.txt && \
    sed -i 's/qdrant-client==1.7.0/qdrant-client>=1.7.0,<1.12.0/' requirements.txt && \
    sed -i 's/libcst==1.0.1/libcst>=1.1.0,<2.0.0/' requirements.txt

# Step 1: Upgrade pip and install core build tools including setuptools-rust
RUN python -m pip install --upgrade pip wheel && \
    pip install "setuptools>=68.0.0,<81.0.0" setuptools-rust

# Step 2: Install grpcio and grpcio-tools with pre-built wheels first (pinned compatible versions)
RUN pip install "grpcio>=1.62.0,<1.63.0" "grpcio-tools>=1.62.0,<1.63.0" --prefer-binary

# Step 3: Install packages with known build issues individually with binary preference
RUN pip install "libcst>=1.1.0" --prefer-binary

# Step 4: Install numpy first (many packages depend on it)
RUN pip install "numpy>=1.24.3" --prefer-binary

# Step 5: Install opentelemetry packages to avoid backtracking issues
RUN pip install "opentelemetry-api>=1.30.0" "opentelemetry-sdk>=1.30.0" \
    "opentelemetry-exporter-otlp-proto-http>=1.30.0" "opentelemetry-proto>=1.30.0" \
    --prefer-binary

# Step 6: Install remaining requirements
RUN pip install -r requirements.txt --prefer-binary || \
    (echo "Some packages failed with binary preference, trying with no-build-isolation" && \
     pip install -r requirements.txt --prefer-binary --no-build-isolation)

# Step 7: Install the project in editable mode
RUN pip install -e . --no-build-isolation

# Step 8: Install test dependencies
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio litellm pytest-xdist pytest-timeout mem0ai

# Install playwright browsers and system dependencies (ignore errors if playwright not installed)
RUN (playwright install --with-deps 2>/dev/null) || true

# Forge API environment variables for OpenAI compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"

# Forge API environment variables for Anthropic compatibility
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"

# Default model configuration
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"

# Set working directory for running scripts
WORKDIR /app

# Preflight verification to fail fast on missing core modules
RUN python -c 'import pytest; print("preflight ok")'

CMD ["/bin/bash"]
