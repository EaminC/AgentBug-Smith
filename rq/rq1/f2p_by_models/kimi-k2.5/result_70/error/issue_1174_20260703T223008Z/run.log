from metagpt.configs.llm_config import LLMConfig

# This import will fail on buggy code due to typo in name (NOT_SUUPORT_STREAM_MODELS vs NOT_SUPPORT_STREAM_MODELS)
from metagpt.provider.bedrock.utils import NOT_SUPPORT_STREAM_MODELS, SUPPORT_STREAM_MODELS


def test_bedrock_stream_models_typo_fixed():
    """Test that the typo NOT_SUUPORT_STREAM_MODELS is corrected to NOT_SUPPORT_STREAM_MODELS.
    
    In the buggy code, the constant was named NOT_SUUPORT_STREAM_MODELS (extra U).
    The fix corrects this to NOT_SUPPORT_STREAM_MODELS.
    """
    # If we get here, the import succeeded (fixed code)
    assert isinstance(NOT_SUPPORT_STREAM_MODELS, dict)
    assert isinstance(SUPPORT_STREAM_MODELS, dict)


def test_llm_config_session_token_field():
    """Test that LLMConfig includes session_token field for AWS Bedrock authentication.
    
    The fix adds session_token field to support AWS temporary credentials.
    """
    config = LLMConfig()
    assert hasattr(config, "session_token"), "LLMConfig should have session_token attribute"
    assert config.session_token is None, "session_token should default to None"


def test_bedrock_utils_models_populated():
    """Test that the bedrock model lists are properly populated."""
    # Support stream models should have entries
    assert len(SUPPORT_STREAM_MODELS) > 0, "SUPPORT_STREAM_MODELS should not be empty"
    # Both should be dictionaries mapping model names to token limits
    for model_name, token_limit in SUPPORT_STREAM_MODELS.items():
        assert isinstance(model_name, str)
        assert isinstance(token_limit, int)
        assert token_limit > 0[0m
