# Need to install python3-pip explicitly to ensure pip is available
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        python3-dev \
        python3-pip \
        libtcl8.6 \
        libtk8.6 \
        python3-tk \
        tk-dev \
        libx11-6 \
        libxft2 \
        libxss1 \
        tcl-dev && \
    apt-get clean && \
