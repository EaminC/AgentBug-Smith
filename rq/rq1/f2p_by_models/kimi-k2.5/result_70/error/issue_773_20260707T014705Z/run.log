ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install system dependencies with better error handling
# Clean apt state first, then update and install
RUN rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* && \
    apt-get clean && \
    apt-get update -o Acquire::Check-Valid-Until=false -o Acquire::Check-Date=false || \
    (sleep 5 && apt-get update -o Acquire::Check-Valid-Until=false -o Acquire::Check-Date=false) && \
    apt-get install -y --no-install-recommends \
        gcc \
        python3-dev \
        python3-pip \
        libtcl8.6 \
        libtk8.6 \
        python3-tk \
        tk-dev \
        tcl-dev \
        libx11-6 \
        libxft2 \
        libxss1 \
        libxml2-dev \
        libxslt1-dev \
        zlib1g-dev \
        libffi-dev \
        libssl-dev \
        ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Set library path for tkinter and other shared libraries
ENV LD_LIBRARY_PATH="/usr/lib/x86_64-linux-gnu:/usr/local/lib"

# Upgrade pip and install wheel/setuptools first
RUN python3 -m pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0"

# Copy the entire repository
COPY . .

# Install specific compatible versions of langchain and dependencies
# The project uses old langchain imports that were removed in 0.1.x
# langchain.callbacks.openai_info.MODEL_COST_PER_1K_TOKENS was available in 0.0.200-0.0.300 range
RUN python3 -m pip install --no-cache-dir \
    "langchain==0.0.240" \
    "langchain-community<0.1.0" \
    "pydantic<2.0.0" \
    "openai==0.27.8" \
    "tiktoken>=0.0.4" \
    "backoff>=2.0.0" \
    "dataclasses-json==0.5.7" \
    "termcolor==2.3.0" \
    "tabulate==0.9.0" \
    "python-dotenv>=0.21.0" \
    "typer>=0.3.2" \
    "click>=8.0.0" \
    "black==23.3.0" \
    "mypy==1.3.0" \
    "ruff==0.0.272" \
    "pre-commit==3.3.3" \
    "rudder-sdk-python==2.0.2" \
    "agent-protocol==1.0.1"

# Install the project itself without deps (already installed above)
RUN python3 -m pip install --no-cache-dir -e . --no-deps

# Install test dependencies compatible with pytest 7.3.1
RUN python3 -m pip install --no-cache-dir \
    "pytest==7.3.1" \
    "pytest-mock>=3.10.0,<4.0.0" \
    "pytest-asyncio>=0.20.0,<1.0.0" \
    "pytest-cov>=4.0.0,<5.0.0" \
    "pytest-timeout>=2.1.0,<3.0.0" \
    "pytest-xdist>=3.0.0,<4.0.0"

# Verify Python environment and key imports
RUN python3 -c "import sys; print(f'Python {sys.version}')" && \
    python3 -c "import pytest; print(f'pytest {pytest.__version__} available')" && \
    python3 -c "import openai; print(f'openai {openai.__version__} available')" && \
    python3 -c "import langchain; print(f'langchain {langchain.__version__} available')" && \
    python3 -c "from langchain.callbacks.openai_info import MODEL_COST_PER_1K_TOKENS; print('MODEL_COST_PER_1K_TOKENS import OK')" && \
    python3 -c "from gpt_engineer.core.ai import AI; print('gpt_engineer imports working')"

# Default command
CMD ["/bin/bash"]
