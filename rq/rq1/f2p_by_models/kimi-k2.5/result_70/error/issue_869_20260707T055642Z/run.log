# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Install system dependencies
RUN apt-get update && apt-get install -y \
    sudo \
    tk \
    tcl \
    gcc \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Upgrade pip and install wheel
RUN pip install --upgrade pip wheel setuptools

# Install Poetry for dependency management
RUN pip install poetry

# Copy the entire repository
COPY . .

# Configure Poetry to not create a virtual environment (use system Python)
RUN poetry config virtualenvs.create false

# Install dependencies based on available files
# If poetry.lock exists, use poetry install; otherwise fallback to pip
RUN if [ -f "poetry.lock" ]; then \
        poetry install --no-interaction --no-ansi; \
    elif [ -f "pyproject.toml" ]; then \
        pip install -e .; \
    else \
        echo "No pyproject.toml found"; \
    fi

# Install additional test dependencies that may be needed
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov "setuptools<=81.0.0"

# Install litellm for API compatibility
RUN pip install litellm

# Set Forge API environment variables for OpenAI SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Set Forge API environment variables for Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional AI configuration
ENV MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

# Pre-flight check to ensure Python environment is working
RUN python -c "import pytest; import openai; import langchain; print('preflight ok')"

# Final command must be /bin/bash for the testing environment
CMD ["/bin/bash"]
