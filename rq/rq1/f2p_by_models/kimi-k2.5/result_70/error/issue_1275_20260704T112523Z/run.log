[32m# Multi-stage Dockerfile for TensorZero (Rust + JavaScript)
# This is a Rust project with JavaScript/TypeScript UI components

# Stage 1: Base image with Rust and Node.js
FROM rust:1.75-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"



# --- end inject ---

# Install system dependencies for Rust builds and Node.js
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    git \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm globally
RUN npm install -g pnpm

# Set working directory
WORKDIR /app

# Copy the entire repository
COPY . .

# Set Forge API environment variables for OpenAI compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Set Forge API environment variables for Anthropic compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional environment variables
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Build Rust project (gateway and dependencies)
# Build in release mode for better performance
RUN cargo build --release 2>/dev/null || cargo build

# Pre-build test binaries
RUN cargo test --no-run 2>/dev/null || true

# Install Node.js dependencies for root package.json if it exists
RUN if [ -f "package.json" ]; then npm install; fi

# Install UI dependencies and build
RUN if [ -d "ui" ] && [ -f "ui/package.json" ]; then \
    cd ui && pnpm install && pnpm run build || true; \
    fi

# Install Python dependencies for testing and examples
RUN pip3 install --break-system-packages \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    litellm \
    openai \
    requests \
    || pip3 install \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    litellm \
    openai \
    requests

# Preflight checks
RUN rustc --version && cargo --version && node --version && npm --version
RUN python3 -c "import sys; print(f'Python {sys.version}')"

# Final command
CMD ["/bin/bash"]
