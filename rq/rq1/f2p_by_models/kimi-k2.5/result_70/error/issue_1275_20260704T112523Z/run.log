[32m# Dockerfile for TensorZero - JavaScript/Node.js environment with Python and Rust support
# Configured for Forge API compatibility

FROM node:20-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"



# --- end inject ---

# Install system dependencies: Python, Rust, and build tools
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.81.0
ENV PATH="/root/.cargo/bin:$PATH"

# Install pnpm globally
ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm

# Set working directory
WORKDIR /app

# Copy the entire repository
COPY . .

# Set up Python virtual environment and upgrade pip
RUN python3 -m venv /venv && \
    /venv/bin/pip install --upgrade pip wheel

# Set PATH to include virtual environment
ENV PATH="/venv/bin:$PATH"

# Install Python test dependencies and clients
# Note: Using --break-system-packages flag for PEP 668 compatibility
RUN /venv/bin/pip install --break-system-packages \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    litellm \
    openai \
    httpx \
    requests \
    pydantic \
    maturin \
    numpy \
    pandas \
    clickhouse-connect \
    uuid-utils \
    || true

# Install Python client dependencies
RUN if [ -f "clients/python-pyo3/pyproject.toml" ]; then \
    /venv/bin/pip install --break-system-packages -e ./clients/python-pyo3 2>/dev/null || true; \
    fi

RUN if [ -f "clients/python-deprecated/pyproject.toml" ]; then \
    /venv/bin/pip install --break-system-packages -e ./clients/python-deprecated 2>/dev/null || true; \
    fi

RUN if [ -f "clients/openai-python/requirements.txt" ]; then \
    /venv/bin/pip install --break-system-packages -r ./clients/openai-python/requirements.txt 2>/dev/null || true; \
    fi

RUN if [ -f "recipes/requirements.txt" ]; then \
    /venv/bin/pip install --break-system-packages -r ./recipes/requirements.txt 2>/dev/null || true; \
    fi

# Install Node.js dependencies at root if package.json exists
RUN if [ -f "package.json" ]; then npm install || true; fi

# Install pnpm dependencies for UI if available
RUN if [ -d "ui" ] && [ -f "ui/package.json" ]; then \
    cd ui && pnpm install || true; \
    fi

# Set environment variables for Forge API (OpenAI compatible)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Set environment variables for Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set Rust/Cargo environment variables for better network handling
ENV CARGO_NET_RETRY=3
ENV CARGO_NET_TIMEOUT=300

# Set PYTHONPATH for tests to find modules
ENV PYTHONPATH="/app:/app/clients/python-pyo3:/app/clients/python-deprecated:/app/recipes:$PYTHONPATH"

# Preflight checks - verify tools are available
RUN node --version && npm --version && pnpm --version
RUN python3 --version && /venv/bin/pip --version
RUN rustc --version && cargo --version
RUN /venv/bin/python -c "import openai, httpx, requests; print('Python imports OK')" 2>/dev/null || true

# Final command - start bash shell
CMD ["/bin/bash"]
