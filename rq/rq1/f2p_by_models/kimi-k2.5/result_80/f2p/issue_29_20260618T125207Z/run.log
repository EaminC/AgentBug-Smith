def test_filename_generation_prompt_requires_correct_suffix():
    """
    Regression test for Issue #29: Generated training file sometimes had .csv extension.
    
    The fix updates the prompt to explicitly instruct the LLM to ensure the file suffix
    (e.g., .py for Python) is correct for the specified language, preventing 
    generation of data file extensions like .csv for code files.
    """
    # Test with Python as the language (commonly used)
    prompt = pmpt_chain_filename("Python")
    
