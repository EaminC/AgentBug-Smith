    assert "correct for the specified language" in prompt, \
        "Prompt should reference the specified language for suffix validation"
    
    # Verify it provides a clear, language-specific example to guide the LLM
    assert ".py for Python" in prompt, \
        "Prompt should provide clear example of correct language-specific extension"[0m
