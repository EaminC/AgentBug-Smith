def test_filename_prompt_requires_language_specific_extension():
    """
    Test that the filename generation prompt explicitly requires
    the correct file suffix for the specified language.
    
    This prevents the LLM from generating incorrect file types (e.g., .csv)
    instead of code files (e.g., .py).
    """
    prompt = pmpt_chain_filename("python")
    
    # The fix adds explicit instruction about language-specific file suffixes
    assert "for the specified language" in prompt, \
        "Prompt must explicitly mention 'for the specified language' to ensure correct file extension"
    
    # The fix also updates the example to be more specific
    assert ".py for Python" in prompt, \
        "Prompt must include specific example like '.py for Python' to guide the LLM"[0m
