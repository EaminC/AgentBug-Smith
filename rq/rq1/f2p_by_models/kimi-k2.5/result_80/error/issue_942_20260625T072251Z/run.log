    curl \
    firefox-esr \
    git \
    jq \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables evidenced by original Dockerfile
ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
