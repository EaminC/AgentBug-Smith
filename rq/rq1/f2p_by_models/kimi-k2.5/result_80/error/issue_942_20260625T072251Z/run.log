# Install system dependencies evidenced by requirements.txt (selenium, webdriver-manager) and original Dockerfile
RUN apt-get update && apt-get install -y \
    ca-certificates \
    chromium-driver \
    curl \
    firefox-esr \
    git \
    jq \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables evidenced by original Dockerfile
ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="$PATH:/root/.local/bin"

WORKDIR /app

# Copy entire repository to ensure injected test scripts are included
COPY . .

# Install dependencies and package
# Evidence: requirements.txt exists, pyproject.toml exists with hatchling backend
# Not a src layout (autogpt/ directory at root), so editable install is safe
RUN python -m pip install --upgrade pip wheel && \
