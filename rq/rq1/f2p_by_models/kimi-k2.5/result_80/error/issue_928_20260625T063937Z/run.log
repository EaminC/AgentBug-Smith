WORKDIR /app

# Install system dependencies: git (for repository operations), tkinter (as evidenced by CI), and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    python3-tk \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# Conditional package installation based on repository evidence; follows robustness principles
RUN python -m pip install --upgrade pip wheel && \
    if [ -f requirements.txt ]; then \
        pip install -r requirements.txt && pip install -e .; \
