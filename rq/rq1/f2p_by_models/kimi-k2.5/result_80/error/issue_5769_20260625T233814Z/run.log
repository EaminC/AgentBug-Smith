    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    anyio \
    "setuptools<=81.0.0" \
    litellm \
    pytest-xdist \
    pytest-timeout \
    mem0ai

# Install local packages from the monorepo libs/ directories
# Assumption: Repository uses libs/ structure with individual pyproject.toml files
