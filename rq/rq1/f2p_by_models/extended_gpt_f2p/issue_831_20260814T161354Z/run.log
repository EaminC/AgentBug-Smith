from unittest.mock import call

import pytest
from pydantic import BaseModel

from strands import Agent
from strands.models import BedrockModel


@pytest.mark.asyncio
async def test_structured_output_callback_invoked_and_events_populated():
    # Setup a mocked stream generator simulating structured output events
    async def mock_stream():
        yield {
            "contentBlockStart": {
                "start": {"toolUse": {"toolUseId": "tooluse_123", "name": "ContactCard"}},
                "contentBlockIndex": 0,
            }
        }
        yield {"contentBlockDelta": {"delta": {"toolUse": {"input": '{"name": "John", "age": 38, "address": "123 anytown usa, Texas, 78756" }'}}, "contentBlockIndex": 0}}
        yield {"contentBlockStop": {"contentBlockIndex": 0}}
        yield {"messageStop": {"stopReason": "tool_use"}}
        yield {
            "metadata": {
                "usage": {"inputTokens": 10, "outputTokens": 5, "totalTokens": 15},
                "metrics": {"latencyMs": 100},
            }
        }

    # Create a BedrockModel and patch its structured_output method to return the mock stream
    bedrock_model = BedrockModel()
    bedrock_model.structured_output = lambda output_model, prompt, system_prompt=None: mock_stream()

    # Prepare event list to capture callback invocations
    events = []

    def grab_event_callback(**kwargs):
        events.append(kwargs)

    # Create Agent with callback handler
    agent = Agent(model=bedrock_model, callback_handler=grab_event_callback)

    # Define output model for structured output
    class ContactCard(BaseModel):
        name: str
        age: int
        address: str

    # Call structured_output (sync) - this calls the patched structured_output returning the async generator
    # The real method is async, but structured_output is sync and returns an async generator
    # We must consume the async generator to trigger callbacks
    async_gen = bedrock_model.structured_output(ContactCard, "Convert the following data to a contact card <input> John, last name Smith, who resides at 123 anytown usa, Texas, 78756, and is of age 38</input>")

    # Consume all events from the async generator and invoke callback handler if applicable
    # This simulates the internal agent logic that was buggy before fix
    async for event in async_gen:
        # The bug was that callback_handler was not called for structured_output events
        # We simulate that callback_handler is called with event dict if event contains a callback key
        # Here, we simulate that event is a dict and callback is embedded in event if present
        if isinstance(event, dict) and "callback" in event:
            grab_event_callback(**event["callback"])

    # The events list should be populated after consuming the stream
    # Before fix, events would be empty because callback_handler was not called
    # After fix, events should contain at least one callback event
    assert len(events) > 0, "Callback handler was not invoked; events list is empty"

    # Additionally, verify that the events contain expected keys related to token usage or toolUse
    found_tool_use = any("toolUseId" in ev or "inputTokens" in ev for ev in events)
    assert found_tool_use, "Callback events do not contain expected keys"


