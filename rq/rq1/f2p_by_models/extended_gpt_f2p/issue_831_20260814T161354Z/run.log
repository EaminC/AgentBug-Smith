async def test_structured_output_callback_invoked_and_events_populated(agenerator):
    # Prepare a mocked async generator simulating structured output events with TypedEvent-like dicts
    # We simulate the model.structured_output async generator yielding events that include callback events
    async def mock_stream():
        # Start content block event
        yield {
            "contentBlockStart": {
                "start": {"toolUse": {"toolUseId": "tooluse_abc123", "name": "ContactCard"}},
                "contentBlockIndex": 0,
            }
        }
        # Content block delta with partial JSON input
        yield {"contentBlockDelta": {"delta": {"toolUse": {"input": '{"name": "Alice", "age": 30, "address": "123 Lane"}}'}}, "contentBlockIndex": 0}
        # Content block stop event
        yield {"contentBlockStop": {"contentBlockIndex": 0}}
        # Message stop event
        yield {"messageStop": {"stopReason": "tool_use"}}
        # Metadata event with usage info
        yield {
            "metadata": {
                "usage": {"inputTokens": 10, "outputTokens": 5, "totalTokens": 15},
                "metrics": {"latencyMs": 100},
            }
        }

    # Patch the BedrockModel's structured_output method to return our mocked stream
    bedrock_model = BedrockModel()
    bedrock_model.structured_output = lambda output_model, prompt, system_prompt=None: mock_stream()

    events = []

    def grab_event_callback(**kwargs):
        events.append(kwargs)

    agent = Agent(model=bedrock_model, callback_handler=grab_event_callback)

    class ContactCard(BaseModel):
        name: str
        age: int
        address: str

    # Call the synchronous structured_output method which internally runs the async method
    # This should invoke the callback handler for each callback event
    result = agent.structured_output(ContactCard, "Create a contact card for Alice")

    # We expect the callback handler to have been called with events (non-empty list)
    assert len(events) > 0, "Callback handler was not invoked, events list is empty"

    # The last event should contain usage info in the callback
    usage_events = [e for e in events if "usage" in e]
    assert usage_events, "No usage event found in callback invocations"

    # The result should be an instance of ContactCard with expected fields
    assert isinstance(result, ContactCard)
    assert result.name == "Alice"
    assert result.age == 30
    assert result.address == "123 Lane"


