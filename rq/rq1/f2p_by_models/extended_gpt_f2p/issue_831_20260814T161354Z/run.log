                "contentBlockIndex": 0,
            }
        }
        yield {"contentBlockDelta": {"delta": {"toolUse": {"input": '{"name": "Bob", "age": 25, "address": "456 somewhere lane"}'}}, "contentBlockIndex": 0}}
        yield {"contentBlockStop": {"contentBlockIndex": 0}}
        yield {"messageStop": {"stopReason": "tool_use"}}
        yield {
            "metadata": {
                "usage": {"inputTokens": 15, "outputTokens": 7, "totalTokens": 22},
                "metrics": {"latencyMs": 150},
            }
        }

    bedrock_model = BedrockModel()
    bedrock_model.structured_output = lambda output_model, prompt, system_prompt=None: mock_stream()

    events = []

    def grab_event_callback(**kwargs):
        events.append(kwargs)

    agent = Agent(model=bedrock_model, callback_handler=grab_event_callback)

    class ContactCard(BaseModel):
        name: str
        age: int
        address: str

    # Call the synchronous structured_output method which returns the parsed object
    contact_card = agent.structured_output(ContactCard, "Create a contact card for Bob")

    # Callback handler should have been called with events
    assert len(events) > 0, "Callback handler was not invoked in synchronous call"

    # Check that usage event is present in callbacks
    usage_events = [e for e in events if "usage" in e]
    assert usage_events, "No usage event found in synchronous callback invocations"

    # The returned object should be a ContactCard instance with expected data
    assert isinstance(contact_card, ContactCard)
    assert contact_card.name == "Bob"
    assert contact_card.age == 25
    assert contact_card.address == "456 somewhere lane"[0m
