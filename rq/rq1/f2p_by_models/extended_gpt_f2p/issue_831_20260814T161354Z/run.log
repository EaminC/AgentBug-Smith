@pytest.mark.asyncio
async def test_structured_output_callback_invoked():
    # Setup a BedrockModel with a mocked stream method to simulate structured output streaming events
    model = BedrockModel()
    # We simulate the streaming of structured output events with incremental JSON fragments and metadata
    async def fake_stream():
        yield {
            "contentBlockStart": {
                "start": {"toolUse": {"toolUseId": "tooluse_123", "name": "ContactCard"}},
                "contentBlockIndex": 0,
            }
        }
        yield {"contentBlockDelta": {"delta": {"toolUse": {"input": ""}}, "contentBlockIndex": 0}}
        yield {"contentBlockDelta": {"delta": {"toolUse": {"input": '{"name": "John", "age": 38, "address": "123 anytown usa, Texas, 78756" }'}}, "contentBlockIndex": 0}}
        yield {"contentBlockStop": {"contentBlockIndex": 0}}
        yield {"messageStop": {"stopReason": "tool_use"}}
        yield {
            "metadata": {
                "usage": {"inputTokens": 10, "outputTokens": 20, "totalTokens": 30},
                "metrics": {"latencyMs": 100},
            }
        }

    model.stream = fake_stream

    # Collect callback events here
    events = []

    def callback_handler(**kwargs):
        events.append(kwargs)

    agent = Agent(model=model, callback_handler=callback_handler)

    class ContactCard(BaseModel):
        name: str
        age: int
        address: str

    # Call structured_output_async to get structured output and trigger callbacks
    result = await agent.structured_output_async(ContactCard, "Convert the following data to a contact card <input> John, last name Smith, who resides at 123 anytown usa, Texas, 78756, and is of age 38</input>")

    # Assert that callback_handler was called at least once (events list is not empty)
    assert len(events) > 0, "Callback handler was not invoked during structured_output_async"

    # Assert that at least one event contains the expected keys indicating structured output progress
    found_content_block_start = any(
        "event" in e and "contentBlockStart" in e["event"] for e in events
    )
    assert found_content_block_start, "Expected contentBlockStart event not found in callback events"

    # Assert the returned result is an instance of ContactCard with expected data
    assert isinstance(result, ContactCard)
    assert result.name == "John"
    assert result.age == 38
    assert "123 anytown usa" in result.address

    # Assert that token usage metadata was included in at least one callback event
    found_usage = any(
        "event" in e and "metadata" in e["event"] and "usage" in e["event"]["metadata"] for e in events
    )
    assert found_usage, "Expected token usage metadata not found in callback events"[0m
