                "start": {"toolUse": {"toolUseId": "tooluse_xyz", "name": "Person"}},
                "contentBlockIndex": 0,
            }
        }
        yield {"contentBlockDelta": {"delta": {"toolUse": {"input": '{"name": "Bob", "age": 25}'}}, "contentBlockIndex": 0}}
        yield {"contentBlockStop": {"contentBlockIndex": 0}}
        yield {"messageStop": {"stopReason": "tool_use"}}
        yield {
            "metadata": {
                "usage": {"inputTokens": 20, "outputTokens": 10, "totalTokens": 30},
                "metrics": {"latencyMs": 200},
            }
        }

    bedrock_model = BedrockModel()
    bedrock_model.structured_output = lambda output_model, prompt, system_prompt=None: mock_stream()

    events = []

    def grab_event_callback(**kwargs):
        events.append(kwargs)

    agent = Agent(model=bedrock_model, callback_handler=grab_event_callback)

    class Person(BaseModel):
        name: str
        age: int

    # Call the async structured_output_async method directly
    person = await agent.structured_output_async(Person, "Give me a person named Bob")

    # Callback handler should have been called with events
    assert len(events) > 0, "Callback handler was not invoked in async call"

    # Check that usage event is present in callbacks
    usage_events = [e for e in events if "usage" in e]
    assert usage_events, "No usage event found in async callback invocations"

    # The returned object should be a Person instance with expected data
    assert isinstance(person, Person)
    assert person.name == "Bob"
    assert person.age == 25


def test_agent_structured_output_sync_callback_invoked():
    # Setup a mocked stream generator simulating structured output events
    async def mock_stream():
        yield {
            "contentBlockStart": {
