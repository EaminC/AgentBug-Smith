[32mimport asyncio
import unittest
from typing import Any, AsyncGenerator, List

from agentscope.agent import Agent, InjectionConfig
from agentscope.event import ToolResultStartEvent, UserInterruptEvent
from agentscope.message import TextBlock, ToolCallBlock, UserMsg
from agentscope.model import ChatResponse
from agentscope.permission import PermissionBehavior, PermissionContext, PermissionDecision
from agentscope.tool import ToolBase, Toolkit, ToolChunk


class DummyModel:
    def __init__(self):
        self._responses: List[List[ChatResponse]] = []
        self._index = 0

    def set_responses(self, responses: List[List[ChatResponse]]) -> None:
        self._responses = responses
        self._index = 0

    async def __call__(self, *args, **kwargs):
        # Return the next response batch, simulating streaming
        if self._index < len(self._responses):
            batch = self._responses[self._index]
            self._index += 1
            for resp in batch:
                yield resp
        else:
            # No more responses
            return


class ExternalTool(ToolBase):
    name = "external_tool"
    description = "External tool for testing"
    is_external_tool = True
    is_concurrency_safe = True
    is_read_only = True
    is_mcp = False
    input_schema = {"type": "object", "properties": {}, "required": []}

    async def check_permissions(
        self,
        tool_input: dict[str, Any],
        context: PermissionContext,
    ) -> PermissionDecision:
        return PermissionDecision(
            behavior=PermissionBehavior.ALLOW,
            decision_reason="ok",
            message="ok",
        )

    async def __call__(self, **kwargs: Any) -> AsyncGenerator[ToolChunk, None]:
        # Simulate a tool that never finishes (waits forever)
        while True:
            await asyncio.sleep(1)
            yield ToolChunk(
                content=[TextBlock(text="waiting...")],
                is_last=False,
            )


class TestExternalToolStartEventDeduplication(unittest.IsolatedAsyncioTestCase):
    async def test_single_start_event_on_interrupt(self):
        """
        This test reproduces the bug where an external tool call in SUBMITTED state
        emits two ToolResultStartEvent events on interruption.

        The test asserts that only one ToolResultStartEvent is emitted for the tool call.
        """

        model = DummyModel()
        toolkit = Toolkit(tools=[ExternalTool()])
        agent = Agent(
            name="TestAgent",
            system_prompt="You are a test agent.",
            model=model,
            toolkit=toolkit,
            injection_config=InjectionConfig(inject_runtime_state=False),
        )

        # Prepare the model to emit a ToolCallBlock for the external tool
        tool_call_id = "tc-ext-1"
        model.set_responses(
            [
                [
                    ChatResponse(
                        content=[
                            TextBlock(text="Calling external tool."),
                            ToolCallBlock(
                                id=tool_call_id,
                                name="external_tool",
                                input="{}",
                            ),
                        ],
                        is_last=True,
                    ),
                ],
            ],
        )

        # Start the reply_stream and park the tool call in SUBMITTED state
        # We will cancel the reply_stream to simulate interruption
        events = []

        async def drive_agent():
            async for evt in agent.reply_stream(UserMsg(name="user", content="Hi")):
                events.append(evt)

        task = asyncio.create_task(drive_agent())
        # Wait a short time to ensure the tool call is submitted and parked
        await asyncio.sleep(0.1)
        # Send a UserInterruptEvent to interrupt the agent
        interrupt_events = []
        async for evt in agent.reply_stream(
            UserInterruptEvent(reply_id=agent.state.reply_id)
        ):
            interrupt_events.append(evt)
        # Cancel the original task to simulate interruption
        task.cancel()
        try:
            await task
        except asyncio.CancelledError:
            pass

        # Combine all events from initial run and interrupt handling
        all_events = events + interrupt_events

        # Count ToolResultStartEvent for the tool_call_id
        start_events = [
            e for e in all_events
            if isinstance(e, ToolResultStartEvent) and e.tool_call_id == tool_call_id
        ]

        # Assert that only one ToolResultStartEvent was emitted for the external tool call
        self.assertEqual(len(start_events), 1, "Duplicate ToolResultStartEvent emitted for external tool on interruption")


if __name__ == "__main__":
    unittest.main()[0m
