import asyncio
from unittest.async_case import IsolatedAsyncioTestCase

from agentscope.agent import Agent, InjectionConfig
from agentscope.event import UserInterruptEvent, ToolResultStartEvent
from agentscope.message import ToolCallBlock, UserMsg
from agentscope.model import ChatResponse
from agentscope.tool import ToolBase, Toolkit
from agentscope.message import TextBlock

# We create a minimal external tool that is concurrency safe and external
class ExternalTool(ToolBase):
    name = "external_tool"
    description = "An external tool for testing."
    is_external_tool = True
    is_concurrency_safe = True
    is_read_only = True

    async def __call__(self, **kwargs):
        # Simulate waiting for external system by sleeping
        await asyncio.sleep(5)
        yield

class TestExternalToolStartEventDeduplication(IsolatedAsyncioTestCase):
    """Test that interrupting an external tool call in SUBMITTED state
    emits exactly one ToolResultStartEvent (no duplicates).
    """

    def _make_agent(self) -> Agent:
        model = DummyModel()
        toolkit = Toolkit(tools=[ExternalTool()])
        agent = Agent(
            name="TestAgent",
            system_prompt="You are a test agent.",
            model=model,
            toolkit=toolkit,
            injection_config=InjectionConfig(inject_runtime_state=False),
        )
        return agent

    async def test_single_start_event_on_interrupt(self):
        agent = self._make_agent()

        # Setup the model to respond with a tool call that will park in SUBMITTED
        agent.model.set_responses(
            [
                [
                    ChatResponse(
                        content=[
                            TextBlock(text="Calling external tool."),
                            ToolCallBlock(
                                id="tc-ext",
                                name="external_tool",
                                input="{}",
                            ),
                        ],
                        is_last=True,
                    ),
                ],
            ],
        )

        # Start the reply stream and park in SUBMITTED state
        events_before_interrupt = []
        async for evt in agent.reply_stream(UserMsg(name="user", content="Hi")):
            events_before_interrupt.append(evt)
            # We break early to simulate interrupt after tool call is submitted
            if any(
                isinstance(c, ToolCallBlock) and c.id == "tc-ext"
                for c in getattr(evt, "content", [])
            ):
                break

        # Now send a UserInterruptEvent to interrupt the parked tool call
        events_after_interrupt = []
        async for evt in agent.reply_stream(
            UserInterruptEvent(reply_id=agent.state.reply_id)
        ):
            events_after_interrupt.append(evt)

        # Combine all events to count ToolResultStartEvent for the tool call id
        all_events = events_before_interrupt + events_after_interrupt

        start_events = [
            e for e in all_events
            if isinstance(e, ToolResultStartEvent) and e.tool_call_id == "tc-ext"
        ]

        # Assert that exactly one ToolResultStartEvent was emitted for the tool call
        self.assertEqual(len(start_events), 1, "Duplicate ToolResultStartEvent emitted")

# DummyModel mocks the model client to produce controlled responses
class DummyModel:
    def __init__(self):
        self._responses = []
        self._index = 0
        self.model = "dummy-model"
        self.stream = True

    def set_responses(self, responses):
        self._responses = responses
        self._index = 0

    async def __call__(self, *args, **kwargs):
        # Yield responses as if streaming from the model
        if self._index >= len(self._responses):
            return
        batch = self._responses[self._index]
        self._index += 1
        for resp in batch:
            yield resp[0m
