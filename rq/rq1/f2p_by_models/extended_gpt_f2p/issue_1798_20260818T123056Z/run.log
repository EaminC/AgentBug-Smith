    """Test that sync_agent() retries on next call if update_agent() fails."""
    class MockRepository:
        def __init__(self):
            self.update_calls = []
            self.fail_next = False

        def update_agent(self, session_id, session_agent):
            if self.fail_next:
                self.fail_next = False
                raise SessionException("Update failed")
            self.update_calls.append((session_id, session_agent))

