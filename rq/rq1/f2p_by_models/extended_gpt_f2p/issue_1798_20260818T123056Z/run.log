[32mfrom strands.agent.agent import Agent
from strands.session.repository_session_manager import RepositorySessionManager
from strands.types.exceptions import SessionException


def test_sync_agent_skips_update_when_state_not_dirty_and_internal_state_unchanged(monkeypatch):
    """Test that sync_agent() skips update_agent() when state is not dirty and internal state unchanged."""
    # Setup a mock repository with update_agent tracking
    class MockRepo:
        def __init__(self):
            self.updated = []

        def update_agent(self, session_id, session_agent):
            self.updated.append((session_id, session_agent))

        def read_session(self, session_id):
            return None

        def create_session(self, session):
            pass

    repo = MockRepo()
    session_manager = RepositorySessionManager(session_id="test-session", session_repository=repo)

    # Create agent and assign session_manager
    agent = Agent(agent_id="test-agent", session_manager=session_manager)

    # First sync should call update_agent
    session_manager.sync_agent(agent)
    assert len(repo.updated) == 1

    # Clear updates
    repo.updated.clear()

    # Second sync without changes should skip update_agent
    session_manager.sync_agent(agent)
    assert len(repo.updated) == 0


