def test_sync_agent_version_tracking_after_successful_sync(monkeypatch):
    """Test that sync_agent tracks version after successful sync and skips if no changes."""
    class MockRepo:
        def __init__(self):
            self.updated = []

        def update_agent(self, session_id, session_agent):
            self.updated.append((session_id, session_agent))

        def read_session(self, session_id):
            return None

        def create_session(self, session):
            pass

    repo = MockRepo()
    session_manager = RepositorySessionManager(session_id="test-session", session_repository=repo)

    agent = Agent(agent_id="test-agent", session_manager=session_manager)

    # First sync to establish baseline
    session_manager.sync_agent(agent)
    repo.updated.clear()

    initial_version = agent.state._get_version()

    # Modify state (increments version)
    agent.state.set("key", "value")
    assert agent.state._get_version() == initial_version + 1

    # Sync should update due to version change
    session_manager.sync_agent(agent)
    assert len(repo.updated) == 1

    # Clear and sync again without changes should skip update
    repo.updated.clear()
    session_manager.sync_agent(agent)
    assert len(repo.updated) == 0


def test_sync_agent_retries_on_failure(monkeypatch):
    """Test that sync_agent retries on next call if update_agent fails and version not updated."""
    class MockRepo:
        def __init__(self):
            self.updated = []
            self.fail_next = False

        def update_agent(self, session_id, session_agent):
            if self.fail_next:
                self.fail_next = False
                raise SessionException("Update failed")
            self.updated.append((session_id, session_agent))

        def read_session(self, session_id):
            return None

        def create_session(self, session):
            pass

    repo = MockRepo()
    session_manager = RepositorySessionManager(session_id="test-session", session_repository=repo)

    agent = Agent(agent_id="test-agent", session_manager=session_manager)

    # Initial sync to establish baseline
    session_manager.sync_agent(agent)

    # Modify state (increments version)
    agent.state.set("key", "value")

    # Make update_agent fail once
    repo.fail_next = True

    # Sync should raise exception
    try:
        session_manager.sync_agent(agent)
        assert False, "Expected SessionException"
    except SessionException as e:
        assert "Update failed" in str(e)

    # Version should not have updated, so retry should succeed
    session_manager.sync_agent(agent)
    assert len(repo.updated) >= 1


