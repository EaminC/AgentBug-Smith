[32mimport os
import tempfile
import json
import pytest

from crewai.agent import Agent
from crewai.tools.tool_usage import ToolUsage
from crewai.translations.i18n import I18N


class DummyAgent:
    def __init__(self, i18n):
        self.i18n = i18n


class DummyAction:
    def __init__(self, tool_name):
        self.tool_name = tool_name


def test_toolusage_uses_agent_i18n(tmp_path):
    """
    This test verifies that ToolUsage uses the same I18N instance as the Agent,
    so that custom prompt_file changes are reflected in tool usage error messages.

    Steps:
    1. Create a temporary translation JSON file with a custom 'tool_usage_exception' message.
    2. Initialize an I18N instance with this custom prompt_file.
    3. Create a DummyAgent with this I18N instance.
    4. Create a ToolUsage instance with the DummyAgent and a DummyAction.
    5. Check that the ToolUsage's _i18n instance is the same as the agent's.
    6. Check that the 'tool_usage_exception' message from ToolUsage's i18n matches the custom message.
    """

    # Prepare custom translation JSON content
    custom_message = "Custom tool usage exception message for testing."
    translation_content = {
        "tool_usage_exception": custom_message
    }

    # Write this to a temporary JSON file
    translation_file = tmp_path / "en.json"
    with open(translation_file, "w", encoding="utf-8") as f:
        json.dump(translation_content, f)

    # Initialize I18N with the custom prompt_file path
    i18n = I18N(prompt_file=str(translation_file))

    # Create dummy agent with this i18n
    agent = DummyAgent(i18n=i18n)

    # Create dummy action (tool name can be arbitrary)
    action = DummyAction(tool_name="dummy_tool")

    # Create ToolUsage instance with the agent and action
    tool_usage = ToolUsage(agent=agent, action=action)

    # Assert that ToolUsage's i18n is the same instance as agent's i18n
    assert tool_usage._i18n is agent.i18n, "ToolUsage does not use the agent's I18N instance"

    # Assert that the tool_usage_exception message matches the custom message
    # We access the translation via the i18n instance inside ToolUsage
    translated_message = tool_usage._i18n.get("tool_usage_exception")
    assert translated_message == custom_message, (
        "ToolUsage's i18n does not reflect the custom prompt_file translation"
    )[0m
