[32mimport os
import tempfile
import json
import pytest

from crewai.agent import Agent
from crewai.tools.tool_usage import ToolUsage
from crewai.translations.i18n import I18N


class DummyAction:
    def __init__(self):
        self.name = "dummy_tool"
        self.description = "A dummy tool for testing"


class DummyAgent(Agent):
    def __init__(self, i18n: I18N):
        super().__init__()
        self.i18n = i18n
        self.name = "dummy_agent"
        self.tools = [DummyAction()]


def test_toolusage_uses_agent_i18n(tmp_path):
    # Create a custom prompt file with a changed tool_usage_exception message
    custom_prompts = {
        "tool_usage_exception": "CUSTOM TOOL USAGE ERROR MESSAGE"
    }
    prompt_file_path = tmp_path / "en.json"
    with open(prompt_file_path, "w", encoding="utf-8") as f:
        json.dump(custom_prompts, f)

    # Create an I18N instance with the custom prompt file
    i18n_custom = I18N(prompt_file=str(prompt_file_path))

    # Create a dummy agent with this i18n
    agent = DummyAgent(i18n=i18n_custom)

    # Create ToolUsage instance with the dummy agent and dummy action
    action = agent.tools[0]
    tool_usage = ToolUsage(agent=agent, action=action)

    # The ToolUsage's _i18n should be the same instance as agent.i18n
    assert tool_usage._i18n is agent.i18n, "ToolUsage should use the agent's I18N instance"

    # The tool_usage_exception message from ToolUsage's i18n should reflect the custom prompt file
    message = tool_usage._i18n.get("tool_usage_exception")
    assert message == "CUSTOM TOOL USAGE ERROR MESSAGE", (
        "ToolUsage should use the agent's i18n with the custom prompt_file, "
        "but got: " + repr(message)
    )[0m
