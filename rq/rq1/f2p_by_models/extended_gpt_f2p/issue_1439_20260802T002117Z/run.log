def test_tool_usage_uses_agent_i18n_with_custom_prompt_file(tmp_path):
    """
    This test verifies that ToolUsage uses the same I18N instance as the Agent,
    so that custom prompt files (translations) are respected in tool usage error messages.

    Steps:
    1. Create a dummy translation dictionary with a custom message for 'tool_usage_exception'.
    2. Create a DummyI18N instance with this custom translation.
    3. Create a DummyAgent with this DummyI18N instance.
    4. Create a ToolUsage instance passing the DummyAgent.
    5. Trigger the tool usage exception message and verify it uses the custom translation.
    """

    # Custom translation dict with a unique message for 'tool_usage_exception'
    custom_translation = {
        "tool_usage_exception": "Custom tool usage error message for testing."
    }

    # Create dummy I18N with custom translations
    dummy_i18n = DummyI18N(custom_translation)

    # Create dummy agent with this i18n
    dummy_agent = DummyAgent(dummy_i18n)

    # Create dummy action (tool) with a name
    dummy_action = DummyAction(tool_name="dummy_tool")

    # Create ToolUsage instance with dummy agent and dummy action
    tool_usage = ToolUsage(agent=dummy_agent, action=dummy_action)

    # Access the error message from ToolUsage's i18n
    error_message = tool_usage._i18n.t("tool_usage_exception")

    # Assert that the error message matches the custom translation
    assert error_message == "Custom tool usage error message for testing.", (
        "ToolUsage did not use the Agent's I18N instance with the custom prompt file."
    )[0m
