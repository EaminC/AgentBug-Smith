from src.crewai.translations.i18n import I18N


class DummyAgent:
    def __init__(self, i18n):
        self.i18n = i18n


class DummyAction:
    def __init__(self, tool_name):
        self.tool_name = tool_name


def test_tool_usage_uses_agent_i18n_with_custom_prompt_file(tmp_path):
    # Create a custom prompt file with a changed tool_usage_exception message
    custom_prompt = {
        "tool_usage_exception": "Custom error message for tool usage."
    }
    prompt_dir = tmp_path / "translation"
    prompt_dir.mkdir()
    custom_prompt_file = prompt_dir / "en.json"
    with open(custom_prompt_file, "w", encoding="utf-8") as f:
        json.dump(custom_prompt, f)

    # Create an I18N instance with the custom prompt_file path
    i18n = I18N(prompt_file=str(custom_prompt_file))

    # Create a dummy agent with this i18n instance
    agent = DummyAgent(i18n=i18n)

    # Create a dummy action (tool) name
    action = DummyAction(tool_name="dummy_tool")

    # Create ToolUsage instance with the dummy agent and action
    tool_usage = ToolUsage(agent=agent, action=action)

    # The ToolUsage's _i18n instance should be the same as agent.i18n
    assert tool_usage._i18n is agent.i18n, "ToolUsage does not use the agent's i18n instance"

    # The tool_usage_exception message from ToolUsage's i18n should match the custom prompt
    msg = tool_usage._i18n.tool_usage_exception
    assert msg == "Custom error message for tool usage.", (
        "ToolUsage does not use the custom prompt_file's tool_usage_exception message"
    )[0m
