[32mimport os
import json
import tempfile
import pytest

from crewai.agent import Agent
from crewai.tools.tool_usage import ToolUsage
from crewai.translations.i18n import I18N


class DummyAgent(Agent):
    def __init__(self, i18n: I18N):
        super().__init__(name="dummy", i18n=i18n)
        self.i18n = i18n


class DummyAction:
    def __init__(self, tool_name: str):
        self.tool_name = tool_name


def test_tool_usage_uses_agent_i18n_with_custom_prompt_file():
    # Create a temporary directory to hold a custom translation file
    with tempfile.TemporaryDirectory() as tmpdir:
        # Prepare a custom translation JSON with a unique tool_usage_exception message
        custom_translation = {
            "tool_usage_exception": "Custom tool usage error message for testing."
        }
        custom_prompt_file_path = os.path.join(tmpdir, "en.json")
        with open(custom_prompt_file_path, "w", encoding="utf-8") as f:
            json.dump(custom_translation, f)

        # Initialize I18N with the custom prompt_file path
        i18n = I18N(prompt_file=custom_prompt_file_path)

        # Create a dummy agent with this custom i18n
        agent = DummyAgent(i18n=i18n)

        # Create a dummy action (tool) to pass to ToolUsage
        action = DummyAction(tool_name="dummy_tool")

        # Create a ToolUsage instance with the dummy agent and action
        tool_usage = ToolUsage(agent=agent, action=action)

        # The ToolUsage instance's _i18n should be the same instance as agent.i18n
        assert tool_usage._i18n is agent.i18n, "ToolUsage does not use the agent's I18N instance"

        # The tool_usage_exception message from ToolUsage's i18n should match the custom one
        message = tool_usage._i18n.get("tool_usage_exception")
        assert message == "Custom tool usage error message for testing.", (
            "ToolUsage's i18n does not reflect the custom prompt_file translations"
        )[0m
