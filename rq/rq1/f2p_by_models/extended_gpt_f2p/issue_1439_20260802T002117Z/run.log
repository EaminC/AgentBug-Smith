[32mimport os
import json
import tempfile
import pytest

from crewai.agent import Agent
from crewai.tools.tool_usage import ToolUsage
from crewai.translations.i18n import I18N


class DummyAgent:
    def __init__(self, i18n: I18N):
        self.i18n = i18n


class DummyAction:
    def __init__(self, tool_name: str):
        self.tool_name = tool_name


def test_tool_usage_uses_agent_i18n(tmp_path):
    # Prepare a custom prompt file with a modified tool_usage_exception message
    custom_prompts = {
        "tool_usage_exception": "Custom error message for tool usage exception"
    }
    prompt_file_path = tmp_path / "en.json"
    with open(prompt_file_path, "w", encoding="utf-8") as f:
        json.dump(custom_prompts, f)

    # Create an I18N instance with the custom prompt file
    i18n = I18N(prompt_file=str(prompt_file_path))

    # Create a dummy agent with the custom i18n
    agent = DummyAgent(i18n=i18n)

    # Create a dummy action (tool)
    action = DummyAction(tool_name="dummy_tool")

    # Create ToolUsage instance with the dummy agent and action
    tool_usage = ToolUsage(agent=agent, action=action)

    # The ToolUsage instance should use the same i18n instance as the agent
    # and therefore the tool_usage_exception message should be from the custom prompt file
    message = tool_usage._i18n.get("tool_usage_exception")

    # Assert that the message is the custom one, not the default
    assert message == "Custom error message for tool usage exception", (
        "ToolUsage should use the same I18N instance as the agent, "
        "reflecting custom prompt_file changes"
    )[0m
