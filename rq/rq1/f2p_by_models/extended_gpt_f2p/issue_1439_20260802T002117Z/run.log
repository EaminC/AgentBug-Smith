[32mimport os
import tempfile
import json
import pytest

from crewai.agent import Agent
from crewai.tools.tool_usage import ToolUsage
from crewai.translations.i18n import I18N


def test_toolusage_uses_agent_i18n_for_error_message(tmp_path):
    """
    This test verifies that ToolUsage uses the same I18N instance as the Agent,
    so that custom prompt_file translations are reflected in tool error messages.

    Steps:
    1. Create a temporary custom prompt file with a unique 'tool_usage_exception' message.
    2. Initialize an I18N instance with this custom prompt file.
    3. Create an Agent with this I18N instance.
    4. Create a ToolUsage instance with the Agent.
    5. Trigger a tool usage error message and verify it contains the custom message.
    """

    # Create a temporary directory for the custom prompt file
    custom_prompt_dir = tmp_path / "translation"
    custom_prompt_dir.mkdir()
    custom_prompt_file = custom_prompt_dir / "en.json"

    # Custom message to test for
    custom_message = "Custom tool usage exception message for testing."

    # Write a minimal prompt JSON with the custom tool_usage_exception message
    prompt_data = {
        "tool_usage_exception": custom_message
    }
    with open(custom_prompt_file, "w", encoding="utf-8") as f:
        json.dump(prompt_data, f)

    # Initialize I18N with the custom prompt_file path
    i18n = I18N(prompt_file=str(custom_prompt_file))

    # Create an Agent with this I18N instance
    # We mock minimal required Agent attributes for ToolUsage
    class DummyAgent:
        def __init__(self, i18n_instance):
            self.i18n = i18n_instance

    agent = DummyAgent(i18n)

    # Create a dummy action (can be None or minimal stub)
    dummy_action = object()

    # Create ToolUsage instance with the agent
    tool_usage = ToolUsage(agent=agent, action=dummy_action)

    # The ToolUsage class uses _i18n for error messages.
    # We check that the _i18n instance inside ToolUsage is the same as agent.i18n
    assert tool_usage._i18n is agent.i18n, "ToolUsage does not use the agent's I18N instance"

    # Now check that the tool_usage_exception message from ToolUsage's i18n matches the custom message
    # The attribute is usually accessed by i18n.tool_usage_exception or via a method.
    # We test the attribute directly.
    assert tool_usage._i18n.tool_usage_exception == custom_message, (
        "ToolUsage's I18N does not reflect the custom prompt_file message"
    )[0m
