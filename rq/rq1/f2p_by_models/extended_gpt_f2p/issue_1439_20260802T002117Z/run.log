[32mimport pytest
from src.crewai.tools.tool_usage import ToolUsage
from src.crewai.agent import Agent
from src.crewai.translations.i18n import I18N


class DummyI18N(I18N):
    def __init__(self, custom_messages):
        super().__init__()
        self._custom_messages = custom_messages

    def translate(self, key: str, **kwargs) -> str:
        # Return custom message if key exists, else default behavior
        if key in self._custom_messages:
            return self._custom_messages[key]
        return super().translate(key, **kwargs)


class DummyAgent(Agent):
    def __init__(self, i18n_instance):
        # Minimal init to set i18n
        self.i18n = i18n_instance


class DummyAction:
    def __init__(self, name):
        self.name = name


@pytest.mark.parametrize("prompt_file_path", [
    "translations/en.json",
])
def test_toolusage_uses_agent_i18n(tmp_path, prompt_file_path):
    """
    This test verifies that ToolUsage uses the same I18N instance as the agent,
    so that custom prompt_file translations are reflected in tool usage error messages.
    """

    # Setup a custom translation for tool_usage_exception
    custom_error_message = "Custom error message for tool usage exception"

    # Create a dummy I18N instance with the custom translation
    dummy_i18n = DummyI18N({"tool_usage_exception": custom_error_message})

    # Create a dummy agent with this dummy_i18n
    dummy_agent = DummyAgent(dummy_i18n)

    # Create a dummy action (tool) with a name
    dummy_action = DummyAction("dummy_tool")

    # We must provide all required arguments to ToolUsage.__init__
    # The signature is:
    # __init__(self, original_tools, tools_description, tools_names, task, function_calling_llm, agent, action)
    # Provide minimal dummy values for all except agent and action

    original_tools = []
    tools_description = {}
    tools_names = []
    task = None
    function_calling_llm = None

    # Create ToolUsage instance with dummy_agent and dummy_action
    tool_usage = ToolUsage(
        original_tools,
        tools_description,
        tools_names,
        task,
        function_calling_llm,
        dummy_agent,
        dummy_action,
    )

    # The ToolUsage instance should use the agent's i18n instance
    # We check that the _i18n attribute is the same instance as dummy_agent.i18n
    assert tool_usage._i18n is dummy_agent.i18n

    # Also check that the translation for tool_usage_exception comes from the dummy_i18n
    translated_message = tool_usage._i18n.translate("tool_usage_exception")
    assert translated_message == custom_error_message[0m
