from crewai.translations.i18n import I18N


class DummyAgent:
    def __init__(self, i18n):
        self.i18n = i18n


class DummyAction:
    def __init__(self, tool_name):
        self.tool_name = tool_name


def test_tool_usage_uses_agent_i18n(tmp_path):
    # Create a temporary custom prompt file with a modified tool_usage_exception message
    custom_prompt = {
        "tool_usage_exception": "Custom error message for tool usage."
    }
    prompt_dir = tmp_path / "translation"
    prompt_dir.mkdir()
    prompt_file = prompt_dir / "en.json"
    with open(prompt_file, "w", encoding="utf-8") as f:
        json.dump(custom_prompt, f)

    # Create an I18N instance with the custom prompt_file path
    i18n = I18N(prompt_file=str(prompt_file))

    # Create a dummy agent with this i18n
    agent = DummyAgent(i18n=i18n)

    # Create a dummy action with a tool name
    action = DummyAction(tool_name="dummy_tool")

    # Create ToolUsage instance with the dummy agent and action
    tool_usage = ToolUsage(agent=agent, action=action)

    # The ToolUsage instance should use the same i18n instance as the agent
    # We test that the tool_usage_exception message is the custom one from the prompt file
    message = tool_usage._i18n.tool_usage_exception

    # Assert that the message is the custom one we set, not the default
    assert message == "Custom error message for tool usage.", (
        "ToolUsage did not use the agent's I18N instance with the custom prompt_file."
    )[0m
