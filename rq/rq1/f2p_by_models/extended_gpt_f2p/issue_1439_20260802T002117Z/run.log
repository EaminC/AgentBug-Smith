def test_toolusage_uses_agent_i18n(tmp_path):
    """
    This test verifies that ToolUsage uses the same I18N instance as the agent,
    so that custom prompt files with overridden messages are respected in tool usage errors.

    Steps:
    1. Create a temporary translation JSON file with a custom message for 'tool_usage_exception'.
    2. Load this custom prompt file into an I18N instance.
    3. Create a DummyAgent with this I18N instance.
    4. Create a ToolUsage instance with the DummyAgent and a dummy action.
    5. Check that the ToolUsage's internal _i18n instance is the same as the agent's I18N.
    6. Check that the custom message from the prompt file is present in the ToolUsage's error message.
    """

    # Define the custom message for tool_usage_exception
    custom_message = "Custom tool usage exception message for testing."

    # Create a temporary directory for the custom prompt file
    prompt_dir = tmp_path / "translation"
    prompt_dir.mkdir()
    prompt_file = prompt_dir / "en.json"

    # Write the custom translation JSON file
    translation_content = {
        "tool_usage_exception": custom_message
    }
    with open(prompt_file, "w", encoding="utf-8") as f:
        json.dump(translation_content, f)

    # Load the I18N instance with the custom prompt file path
    i18n = I18N(prompt_file=str(prompt_file))

    # Create dummy agent with this i18n
    agent = DummyAgent(i18n=i18n)

    # Create dummy action (tool name can be anything)
    action = DummyAction(tool_name="dummy_tool")

    # Create ToolUsage instance with the dummy agent and action
    tool_usage = ToolUsage(agent=agent, action=action)

    # Assert that ToolUsage's _i18n is the same instance as agent.i18n
    assert tool_usage._i18n is agent.i18n, "ToolUsage does not use the agent's I18N instance"

    # Now simulate getting the tool usage exception message from the i18n instance
    # The ToolUsage class should use this message internally when reporting errors
    # We check that the custom message is present in the i18n translation for 'tool_usage_exception'
    translated_message = tool_usage._i18n.translate("tool_usage_exception")
    assert translated_message == custom_message, (
        "ToolUsage I18N does not reflect the custom prompt_file translation"
    )

    # Additionally, check that the ToolUsage class actually uses this message in its error reporting
    # We simulate a tool usage error message generation (assuming ToolUsage has a method or property for this)
    # Since the actual method to get error message may not be public, we check the _i18n usage directly
    # This ensures that after fix, ToolUsage uses the agent's i18n with the custom prompt_file


if __name__ == "__main__":
