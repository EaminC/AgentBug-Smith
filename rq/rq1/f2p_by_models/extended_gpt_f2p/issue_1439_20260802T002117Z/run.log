[32mimport os
import json
import tempfile
import pytest

from crewai.agent import Agent
from crewai.tools.tool_usage import ToolUsage
from crewai.translations.i18n import I18N


class DummyTool:
    def __init__(self):
        self.name = "dummy_tool"

    def run(self, *args, **kwargs):
        raise ValueError("Tool failed")


class DummyAction:
    def __init__(self, tool):
        self.tool = tool


@pytest.fixture
def temp_prompt_file():
    # Create a temporary directory and write a custom translation JSON
    with tempfile.TemporaryDirectory() as tmpdir:
        prompt_dir = os.path.join(tmpdir, "translation")
        os.makedirs(prompt_dir)
        prompt_path = os.path.join(prompt_dir, "en.json")
        # Custom message for tool_usage_exception
        custom_translation = {
            "tool_usage_exception": "Custom error message for tool usage failure"
        }
        with open(prompt_path, "w", encoding="utf-8") as f:
            json.dump(custom_translation, f)
        yield prompt_path


def test_tool_usage_uses_agent_i18n_with_custom_prompt_file(temp_prompt_file):
    # Setup I18N with custom prompt_file path
    i18n = I18N(prompt_file=temp_prompt_file)

    # Create an Agent and override its i18n with our custom one
    agent = Agent()
    agent.i18n = i18n

    # Create a dummy tool and action
    tool = DummyTool()
    action = DummyAction(tool=tool)

    # Create ToolUsage with the agent and action
    tool_usage = ToolUsage(agent=agent, action=action)

    # The ToolUsage._i18n should be the same instance as agent.i18n
    assert tool_usage._i18n is agent.i18n, "ToolUsage i18n should be the same as agent's i18n"

    # When tool.run() raises, ToolUsage should produce an error message using the custom translation
    error_message = tool_usage.tool_usage_exception_message("dummy error")

    # The error message should contain the custom message from the prompt file
    assert "Custom error message for tool usage failure" in error_message, (
        "ToolUsage error message should include custom translation from agent's i18n"
    )[0m
