[32mimport os
import tempfile
import json
import pytest

from src.crewai.agent import Agent
from src.crewai.tools.tool_usage import ToolUsage
from src.crewai.translations.i18n import I18N


class DummyAgent:
    def __init__(self, i18n):
        self.i18n = i18n


class DummyAction:
    def __init__(self, tool_name):
        self.tool_name = tool_name


def test_tool_usage_uses_agent_i18n(tmp_path):
    """
    This test verifies that ToolUsage uses the same I18N instance as the agent,
    so that custom prompt_file translations are respected in error messages.
    """

    # Create a temporary custom translation file with a unique tool_usage_exception message
    custom_translation = {
        "tool_usage_exception": "Custom error message for tool usage exception"
    }
    translations_dir = tmp_path / "translation"
    translations_dir.mkdir()
    custom_prompt_file = translations_dir / "en.json"
    with open(custom_prompt_file, "w", encoding="utf-8") as f:
        json.dump(custom_translation, f)

    # Create an I18N instance with the custom prompt_file path
    i18n = I18N(prompt_file=str(custom_prompt_file))

    # Create a dummy agent with this i18n instance
    agent = DummyAgent(i18n=i18n)

    # Create a dummy action (tool) name
    action = DummyAction(tool_name="nonexistent_tool")

    # Create ToolUsage instance passing the dummy agent and action
    tool_usage = ToolUsage(agent=agent, action=action)

    # The ToolUsage instance's _i18n should be the same as the agent's i18n
    assert tool_usage._i18n is agent.i18n, "ToolUsage does not use the agent's I18N instance"

    # The error message for tool usage exception should come from the custom translation
    error_message = tool_usage._i18n.t("tool_usage_exception")
    assert error_message == custom_translation["tool_usage_exception"], (
        "ToolUsage error message does not reflect the custom prompt_file translation"
    )[0m
