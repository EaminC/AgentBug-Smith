[32mimport os
import json
import tempfile
import pytest

from crewai.agent import Agent
from crewai.tools.tool_usage import ToolUsage
from crewai.translations import i18n as i18n_module


class DummyAction:
    def __init__(self, tool_name):
        self.tool_name = tool_name


class DummyAgent(Agent):
    def __init__(self, i18n_instance):
        super().__init__()
        self.i18n = i18n_instance


def test_toolusage_uses_agent_i18n(tmp_path):
    # Prepare a temporary custom translation JSON file with a unique message
    custom_prompt_dir = tmp_path / "translation"
    custom_prompt_dir.mkdir()
    en_json_path = custom_prompt_dir / "en.json"

    # Load default English translations from the package to modify
    # We simulate the default translation keys and override one key
    # to verify if ToolUsage picks it up from agent.i18n
    default_translations = {
        "tool_usage_exception": "Default tool usage exception message"
    }
    # Custom translation with changed message
    custom_translations = {
        "tool_usage_exception": "Custom tool usage exception message for testing"
    }

    # Write custom translation JSON file
    with open(en_json_path, "w", encoding="utf-8") as f:
        json.dump(custom_translations, f)

    # Patch the I18N class to load from this custom prompt_file directory
    # We create an I18N instance with prompt_file pointing to tmp_path/translation
    i18n_custom = i18n_module.I18N(prompt_file=str(custom_prompt_dir))

    # Verify that the custom translation is loaded correctly in i18n_custom
    loaded_message = i18n_custom.get("tool_usage_exception")
    assert loaded_message == custom_translations["tool_usage_exception"], (
        "Custom I18N instance did not load the custom translation message as expected."
    )

    # Create a dummy agent with this custom i18n instance
    agent = DummyAgent(i18n_instance=i18n_custom)

    # Create a dummy action with a tool name
    action = DummyAction(tool_name="dummy_tool")

    # Create ToolUsage instance with the agent and action
    tool_usage = ToolUsage(agent=agent, action=action)

    # The ToolUsage._i18n should be the same instance as agent.i18n
    assert tool_usage._i18n is agent.i18n, (
        "ToolUsage does not use the agent's i18n instance but a default one."
    )

    # The message fetched from ToolUsage's i18n should be the custom one
    tool_usage_message = tool_usage._i18n.get("tool_usage_exception")
    assert tool_usage_message == custom_translations["tool_usage_exception"], (
        "ToolUsage's i18n does not reflect the custom prompt_file translations."
    )[0m
