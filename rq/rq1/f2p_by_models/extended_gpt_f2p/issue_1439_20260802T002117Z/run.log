[32mimport os
import tempfile
import json
import pytest

from crewai.agent import Agent
from crewai.tools.tool_usage import ToolUsage
from crewai.translations.i18n import I18N


class DummyAgent:
    def __init__(self, i18n):
        self.i18n = i18n


class DummyAction:
    def __init__(self, tool_name):
        self.tool_name = tool_name


def test_toolusage_uses_agent_i18n(tmp_path):
    # Create a temporary custom prompt file with a unique tool_usage_exception message
    custom_prompt = {
        "tool_usage_exception": "Custom error message for tool usage exception"
    }
    prompt_dir = tmp_path / "translation"
    prompt_dir.mkdir()
    prompt_file = prompt_dir / "en.json"
    with open(prompt_file, "w", encoding="utf-8") as f:
        json.dump(custom_prompt, f)

    # Create an I18N instance with the custom prompt file
    i18n = I18N(prompt_file=str(prompt_file))

    # Create a dummy agent with this i18n instance
    agent = DummyAgent(i18n=i18n)

    # Create a dummy action (tool) name
    action = DummyAction(tool_name="dummy_tool")

    # Create ToolUsage instance with the dummy agent and action
    tool_usage = ToolUsage(agent=agent, action=action)

    # The ToolUsage's _i18n should be the same instance as agent.i18n
    assert tool_usage._i18n is agent.i18n, "ToolUsage does not use the agent's I18N instance"

    # The tool_usage_exception message from ToolUsage's i18n should match the custom prompt file message
    message = tool_usage._i18n.get("tool_usage_exception")
    assert message == custom_prompt["tool_usage_exception"], (
        "ToolUsage's i18n does not reflect the custom prompt_file changes"
    )[0m
