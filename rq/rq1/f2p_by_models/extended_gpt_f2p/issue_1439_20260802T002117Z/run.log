[32mimport os
import json
import tempfile
import pytest

from crewai.agent import Agent
from crewai.tools.tool_usage import ToolUsage


class DummyAgent:
    def __init__(self, i18n):
        self.i18n = i18n


class DummyI18N:
    def __init__(self, messages):
        self.messages = messages

    def translate(self, key):
        return self.messages.get(key, f"Missing translation for {key}")


class DummyAction:
    def __init__(self, tool_name):
        self.tool_name = tool_name


def test_toolusage_uses_agent_i18n(tmp_path):
    # Setup a custom prompt file with a unique translation for tool_usage_exception
    custom_messages = {
        "tool_usage_exception": "Custom error message for tool usage exception"
    }

    # Create a dummy I18N instance with the custom messages
    dummy_i18n = DummyI18N(custom_messages)

    # Create a dummy agent with this dummy_i18n
    dummy_agent = DummyAgent(dummy_i18n)

    # Create a dummy action (tool) with a name
    dummy_action = DummyAction("dummy_tool")

    # Create ToolUsage instance with dummy_agent and dummy_action
    tool_usage = ToolUsage(dummy_agent, dummy_action)

    # Access the internal _i18n attribute of ToolUsage and check it is the same as dummy_agent.i18n
    # This should fail on buggy code where ToolUsage uses a new I18N() instead of agent.i18n
    assert tool_usage._i18n is dummy_agent.i18n, "ToolUsage does not use agent's i18n instance"

    # Check that the translation for 'tool_usage_exception' is the custom one, not default
    translated_message = tool_usage._i18n.translate("tool_usage_exception")
    assert (
        translated_message == custom_messages["tool_usage_exception"]
    ), "ToolUsage i18n translation does not reflect agent's custom prompt_file"


# The test expects that ToolUsage uses the same i18n instance as the agent.
# Before the fix, ToolUsage creates a new I18N() ignoring the agent's i18n,
# so the translation will not match the custom message and the test will fail.
# After the fix, ToolUsage uses agent.i18n, so the test will pass.[0m
