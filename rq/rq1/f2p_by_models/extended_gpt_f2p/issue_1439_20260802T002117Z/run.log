class DummyAgent(Agent):
    """
    A dummy agent subclass to allow setting a custom I18N instance.
    """

    def __init__(self, i18n: I18N):
        super().__init__()
        self.i18n = i18n


def test_tool_usage_uses_agent_i18n(tmp_path):
    """
    This test verifies that ToolUsage uses the same I18N instance as the agent,
    so that custom prompt files are respected in tool usage error messages.

    Steps:
    1. Create a temporary custom prompt file with a unique 'tool_usage_exception' message.
    2. Load this prompt file into an I18N instance.
    3. Create a DummyAgent with this I18N instance.
    4. Create a ToolUsage instance with this agent.
    5. Trigger a tool usage error message and verify it contains the custom message.
    """

    # Create a custom prompt file JSON with a unique tool_usage_exception message
    custom_prompt = {
        "tool_usage_exception": "CUSTOM TOOL USAGE EXCEPTION MESSAGE"
    }
    prompt_file_path = tmp_path / "custom_en.json"
    with open(prompt_file_path, "w", encoding="utf-8") as f:
        json.dump(custom_prompt, f)

    # Load I18N with the custom prompt file
    i18n = I18N(prompt_file=str(prompt_file_path))

    # Create dummy agent with this i18n
    agent = DummyAgent(i18n=i18n)

    # Create a dummy action (can be None or a simple object)
    dummy_action = object()

    # Create ToolUsage with the dummy agent and dummy action
    tool_usage = ToolUsage(agent=agent, action=dummy_action)

    # Access the internal _i18n instance of ToolUsage and verify it is the same as agent.i18n
    assert tool_usage._i18n is agent.i18n, "ToolUsage does not use the agent's I18N instance"

    # The tool_usage_exception message should be from the custom prompt file
    message = tool_usage._i18n.get("tool_usage_exception")
    assert message == "CUSTOM TOOL USAGE EXCEPTION MESSAGE", (
        "ToolUsage error message does not reflect custom prompt_file changes"
    )[0m
