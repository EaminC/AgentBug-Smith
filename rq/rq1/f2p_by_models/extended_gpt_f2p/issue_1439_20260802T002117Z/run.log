[32mimport os
import tempfile
import json
import pytest

from crewai.agent import Agent
from crewai.tools.tool_usage import ToolUsage
from crewai.translations.i18n import I18N


class DummyAgent:
    def __init__(self, i18n):
        self.i18n = i18n


class DummyAction:
    def __init__(self, tool_name):
        self.tool_name = tool_name


def test_toolusage_uses_agent_i18n_for_error_message():
    # Create a temporary directory for a custom prompt file
    with tempfile.TemporaryDirectory() as tmpdir:
        # Create a custom translation JSON file with a modified tool_usage_exception message
        en_path = os.path.join(tmpdir, "en.json")
        custom_message = "Custom tool usage exception message for testing."
        content = {
            "tool_usage_exception": custom_message
        }
        with open(en_path, "w", encoding="utf-8") as f:
            json.dump(content, f)

        # Load I18N with the custom prompt_file path
        i18n_custom = I18N(prompt_file=en_path)

        # Create a dummy agent with this custom i18n
        agent = DummyAgent(i18n=i18n_custom)

        # Create a dummy action (tool) with a name
        action = DummyAction(tool_name="dummy_tool")

        # Create ToolUsage instance with the dummy agent and action
        tool_usage = ToolUsage(agent=agent, action=action)

        # The error message from ToolUsage should include the custom message from the custom prompt file
        error_message = tool_usage.tool_usage_exception()

        # Assert that the error message contains the custom message text
        assert custom_message in error_message, (
            "ToolUsage error message does not use the agent's I18N with the custom prompt_file."
        )

        # Also assert that ToolUsage's _i18n is exactly the agent's i18n instance (not a new default)
        assert tool_usage._i18n is agent.i18n, (
            "ToolUsage does not use the same I18N instance as the agent."
        )[0m
