[32mimport os
import json
import tempfile
import pytest

from crewai.agent import Agent
from crewai.tools.tool_usage import ToolUsage
from crewai.translations import i18n as i18n_module


def test_toolusage_uses_agent_i18n_with_custom_prompt_file(tmp_path):
    """
    This test verifies that ToolUsage uses the same I18N instance as the Agent,
    including any custom prompt_file settings.

    Steps:
    1. Create a temporary custom prompt file with a unique translation for 'tool_usage_exception'.
    2. Initialize an I18N instance with this custom prompt file.
    3. Create an Agent and override its i18n instance with the custom one.
    4. Create a ToolUsage instance with the Agent.
    5. Trigger a tool usage error message and verify that the message contains the custom translation.
    """

    # Create a temporary directory for the custom prompt file
    custom_prompt_dir = tmp_path / "translation"
    custom_prompt_dir.mkdir()
    custom_prompt_file = custom_prompt_dir / "en.json"

    # Custom translation content with a unique message for tool_usage_exception
    custom_translation = {
        "tool_usage_exception": "Custom tool usage error message for testing."
    }

    # Write the custom translation JSON file
    with open(custom_prompt_file, "w", encoding="utf-8") as f:
        json.dump(custom_translation, f)

    # Create an I18N instance with the custom prompt_file path
    # The I18N constructor accepts prompt_file as a path string
    custom_i18n = i18n_module.I18N(prompt_file=str(custom_prompt_file))

    # Create a dummy Agent with the custom i18n instance
    class DummyAgent:
        def __init__(self, i18n_instance):
            self.i18n = i18n_instance

    agent = DummyAgent(custom_i18n)

    # Create dummy action (can be None or a simple object)
    dummy_action = object()

    # Create ToolUsage instance with the agent
    tool_usage = ToolUsage(agent=agent, action=dummy_action)

    # The ToolUsage instance should use the same i18n as the agent
    # Check that the _i18n attribute is the same instance as agent.i18n
    assert tool_usage._i18n is agent.i18n, "ToolUsage does not use the agent's i18n instance"

    # Now test that the tool_usage_exception message is the custom one
    # The I18N class has a method to get translations by key, usually __getitem__ or get()
    # We check the translation for 'tool_usage_exception'
    translated_message = tool_usage._i18n["tool_usage_exception"]

    # Assert that the translated message matches the custom translation
    assert (
        translated_message == custom_translation["tool_usage_exception"]
    ), "ToolUsage i18n does not reflect the custom prompt_file translation"[0m
