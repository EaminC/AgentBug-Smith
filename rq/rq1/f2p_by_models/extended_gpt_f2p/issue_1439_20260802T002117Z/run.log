[32mimport os
import json
import tempfile
import pytest

from src.crewai.agent import Agent
from src.crewai.tools.tool_usage import ToolUsage
from src.crewai.translations.i18n import I18N


class DummyAgent:
    def __init__(self, i18n):
        self.i18n = i18n


class DummyAction:
    def __init__(self, tool_name):
        self.tool_name = tool_name


def test_toolusage_uses_agent_i18n(tmp_path):
    """
    This test verifies that ToolUsage uses the same I18N instance as the agent,
    so that custom prompt_file changes are reflected in tool usage error messages.

    Steps:
    1. Create a temporary custom prompt file with a modified 'tool_usage_exception' message.
    2. Load I18N with this custom prompt file.
    3. Create an agent with this I18N.
    4. Create ToolUsage with this agent.
    5. Check that the ToolUsage's i18n returns the custom message, not the default.
    """

    # Prepare a custom prompt file JSON with a unique message for tool_usage_exception
    custom_prompt = {
        "tool_usage_exception": "Custom error message for tool usage exception."
    }
    prompt_file_path = tmp_path / "en.json"
    with open(prompt_file_path, "w", encoding="utf-8") as f:
        json.dump(custom_prompt, f)

    # Load I18N with the custom prompt file
    i18n_custom = I18N(prompt_file=str(prompt_file_path))

    # Create dummy agent with this i18n
    agent = DummyAgent(i18n=i18n_custom)

    # Create dummy action (tool)
    action = DummyAction(tool_name="dummy_tool")

    # Create ToolUsage with the agent and action
    tool_usage = ToolUsage(agent=agent, action=action)

    # The ToolUsage's i18n should be the same as agent's i18n
    # So the tool_usage_exception message should be the custom one, not the default
    message_from_tool_usage = tool_usage._i18n.get("tool_usage_exception")
    message_from_agent_i18n = agent.i18n.get("tool_usage_exception")

    # Assert that ToolUsage i18n is the same instance as agent.i18n
    assert tool_usage._i18n is agent.i18n

    # Assert that the message matches the custom message we put in the prompt file
    assert message_from_tool_usage == "Custom error message for tool usage exception."
