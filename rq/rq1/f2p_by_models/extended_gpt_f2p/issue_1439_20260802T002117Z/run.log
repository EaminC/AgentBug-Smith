from src.crewai.tools.tool_usage import ToolUsage
from src.crewai.agent import Agent
from src.crewai.translations.i18n import I18N


class DummyI18N(I18N):
    def __init__(self, custom_translations):
        super().__init__()
        self._custom_translations = custom_translations

    def translate(self, key: str, **kwargs) -> str:
        # Return the custom translation if exists, else fallback to base
        if key in self._custom_translations:
            return self._custom_translations[key].format(**kwargs)
        return super().translate(key, **kwargs)


class DummyAgent(Agent):
    def __init__(self, i18n_instance):
        # Minimal init for Agent with i18n
        super().__init__(name="dummy_agent")
        self.i18n = i18n_instance


class DummyAction:
    def __init__(self, tool_name):
        self.tool_name = tool_name


class DummyToolsHandler:
    pass


class DummyTask:
    pass


def test_tool_usage_uses_agent_i18n_with_custom_prompt_file():
    """
    This test verifies that ToolUsage uses the same I18N instance as the Agent,
    so that custom prompt files (translations) are respected in tool usage error messages.

    Steps:
    1. Create a dummy translation dictionary with a custom message for 'tool_usage_exception'.
    2. Create a DummyI18N instance with this custom translation.
    3. Create a DummyAgent with this DummyI18N instance.
    4. Create a ToolUsage instance passing the DummyAgent and other required parameters.
    5. Trigger the tool usage exception message and verify it uses the custom translation.
    """

    # Custom translation dict with a unique message for 'tool_usage_exception'
    custom_translation = {
        "tool_usage_exception": "Custom tool usage error message for testing."
    }

    # Create dummy I18N with custom translations
    dummy_i18n = DummyI18N(custom_translation)

    # Create dummy agent with this i18n
    dummy_agent = DummyAgent(dummy_i18n)

    # Create dummy action (tool) with a name
    dummy_action = DummyAction(tool_name="dummy_tool")

    # Create dummy required parameters for ToolUsage constructor
    dummy_tools_handler = DummyToolsHandler()
    dummy_tools = []
    dummy_original_tools = []
    dummy_tools_description = ""
    dummy_tools_names = []
    dummy_task = DummyTask()
    dummy_function_calling_llm = False

    # Create ToolUsage instance with dummy agent and dummy action and required params
    tool_usage = ToolUsage(
        agent=dummy_agent,
        action=dummy_action,
        tools_handler=dummy_tools_handler,
        tools=dummy_tools,
        original_tools=dummy_original_tools,
        tools_description=dummy_tools_description,
        tools_names=dummy_tools_names,
        task=dummy_task,
        function_calling_llm=dummy_function_calling_llm,
    )

    # The ToolUsage class should use the agent's i18n instance
    # We check that the internal _i18n attribute is the same instance as dummy_i18n
    assert tool_usage._i18n is dummy_i18n

    # Now test that the translation for 'tool_usage_exception' uses the custom message
    translated_message = tool_usage._i18n.translate("tool_usage_exception")
    assert translated_message == "Custom tool usage error message for testing."[0m
