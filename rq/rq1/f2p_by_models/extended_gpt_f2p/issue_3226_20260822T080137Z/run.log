import pytest
from google import genai

from strands.models.gemini import GeminiModel
from strands.types.exceptions import ModelThrottledException


@pytest.mark.asyncio
async def test_vertex_ai_429_plain_text_error_is_converted_to_model_throttled_exception():
    """
    Regression test for issue #3226.

    When Vertex AI returns a 429 with a plain-text error message (not JSON),
    the GeminiModel.stream() method should convert it to ModelThrottledException,
    so that the retry logic can handle it properly.

    This test mocks the generate_content_stream method to raise a ClientError with:
    - code 429
    - status "RESOURCE_EXHAUSTED"
    - message as plain text (not JSON)

    The test asserts that ModelThrottledException is raised, not the raw ClientError.
    """
    error = genai.errors.ClientError(
        429,
        {"error": {"status": "RESOURCE_EXHAUSTED", "message": "Resource exhausted. Please try again later."}},
    )
    model = GeminiModel(model_id="gemini-2.5-flash", client_args={"api_key": "test"})

    # Patch the aio.models.generate_content_stream to raise the above error
    # We do not mock GeminiModel.stream itself, only the internal client call
    # so that the real stream method runs and triggers the error handling code.
    model.client.aio.models.generate_content_stream = asyncio.coroutine(lambda *args, **kwargs: (_ for _ in ()).throw(error))

    with pytest.raises(ModelThrottledException) as excinfo:
        await model.stream([{"role": "user", "content": [{"text": "hi"}]}]).__anext__()

    assert "Resource exhausted" in str(excinfo.value) or "RESOURCE_EXHAUSTED" in str(excinfo.value)[0m
