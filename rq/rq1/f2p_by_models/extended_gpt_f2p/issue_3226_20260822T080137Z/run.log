[32mimport asyncio
import pytest
from google import genai
from strands.models.gemini import GeminiModel
from strands.types.exceptions import ModelThrottledException


@pytest.mark.asyncio
async def test_vertex_ai_429_plain_text_error_converts_to_model_throttled_exception():
    """
    Regression test for issue #3226.

    Vertex AI returns 429 errors with plain-text messages instead of JSON.
    The GeminiModel.stream() method should convert these to ModelThrottledException
    based on the error.status attribute, not relying on JSON parsing of the message.

    This test simulates a Vertex AI 429 error with a plain-text message and asserts
    that ModelThrottledException is raised, not the raw ClientError.
    """
    error = genai.errors.ClientError(
        429,
        {"error": {"status": "RESOURCE_EXHAUSTED", "message": "Resource exhausted. Please try again later."}},
    )
    assert error.code == 429
    assert error.status == "RESOURCE_EXHAUSTED"

    model = GeminiModel(model_id="gemini-2.5-flash", client_args={"api_key": "test"})

    # Patch the internal client to raise the above error when generate_content_stream is called
    # We do not patch GeminiModel.stream itself, so the real method runs and should handle error properly.
    # We patch the internal client aio.models.generate_content_stream to raise the error.
    # This simulates the real Vertex AI 429 plain text error during streaming.
    # The test expects ModelThrottledException to be raised.

    # Import unittest.mock here to patch the internal client method
    import unittest.mock

    with unittest.mock.patch.object(model.client.aio.models, "generate_content_stream", side_effect=error):
        with pytest.raises(ModelThrottledException) as excinfo:
            # Run the async generator to trigger the error
            await asyncio.wait_for(model.stream([{"role": "user", "content": [{"text": "hi"}]}]).__anext__(), timeout=5)

        # The exception message should contain the plain text message from the error
        assert "Resource exhausted. Please try again later." in str(excinfo.value)[0m
