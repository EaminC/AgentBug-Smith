[32mimport asyncio
import pytest
from google import genai

from strands.models.gemini import GeminiModel
from strands.types.exceptions import ModelThrottledException


@pytest.mark.asyncio
async def test_vertex_ai_429_plain_text_message_converted_to_model_throttled_exception():
    """
    Regression test for issue #3226.

    Vertex AI returns 429 RESOURCE_EXHAUSTED errors with plain-text messages,
    not JSON. The GeminiModel.stream() method must convert these to
    ModelThrottledException for proper retry handling.
    """
    error = genai.errors.ClientError(
        429,
        {
            "error": {
                "status": "RESOURCE_EXHAUSTED",
                "message": "Resource exhausted. Please try again later.",
            }
        },
    )
    assert error.code == 429
    assert error.status == "RESOURCE_EXHAUSTED"

    model = GeminiModel(model_id="gemini-2.5-flash", client_args={"api_key": "test"})

    # Patch the internal client to raise the above error on generate_content_stream call
    # We do not mock the GeminiModel.stream method itself, only the internal client call.
    # This ensures the real stream method runs and exercises the error handling logic.
    client_aio = model.client.aio
    original_generate_content_stream = client_aio.models.generate_content_stream

    async def raise_error(*args, **kwargs):
        raise error

    client_aio.models.generate_content_stream = raise_error

    with pytest.raises(ModelThrottledException) as exc_info:
        await asyncio.wait_for(model.stream([{"role": "user", "content": [{"text": "hi"}]}]).__anext__(), timeout=5)

    # Restore original method to avoid side effects for other tests
    client_aio.models.generate_content_stream = original_generate_content_stream

    assert "Resource exhausted" in str(exc_info.value)
    assert isinstance(exc_info.value.__cause__, genai.errors.ClientError)[0m
