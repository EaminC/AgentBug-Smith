+import unittest.mock
+import os
+from strands.models.bedrock import BedrockModel, DEFAULT_BEDROCK_REGION
+
+@unittest.mock.patch("boto3.Session")
+    """Test that BedrockModel uses the provided region."""
+    with unittest.mock.patch.object(os, "environ", {}):
+        BedrockModel()
+        session_cls.return_value.client.assert_called_with(
+            region_name=DEFAULT_BEDROCK_REGION, config=ANY, service_name=ANY
+
+@unittest.mock.patch("boto3.Session")
+def test__init__with_default_environment_variable_region(mock_boto_session):
+    mock_boto_session.return_value.client.return_value = unittest.mock.MagicMock()
+
+    with unittest.mock.patch.dict(os.environ, {"AWS_REGION": "eu-west-2"}):
+        BedrockModel()
+        mock_boto_session.return_value.client.assert_called_with(region_name="eu-west-2", config=unittest.mock.ANY, service_name=unittest.mock.ANY)
+@unittest.mock.patch("boto3.Session")
+def test__init__region_precedence(mock_boto_session):
+    mock_boto_session.return_value.region_name = "us-session-region"
+    mock_boto_session.return_value.client.return_value = unittest.mock.MagicMock()
+
+    with unittest.mock.patch.dict(os.environ, {"AWS_REGION": "us-env-region"}):
+        # specifying a region always wins out
+        BedrockModel(region_name="us-specified-region")
+        mock_boto_session.return_value.client.assert_called_with(region_name="us-specified-region", config=unittest.mock.ANY, service_name=unittest.mock.ANY)
+        
+        # AWS_REGION env var gets priority over session region
+        BedrockModel()
+        mock_boto_session.return_value.client.assert_called_with(region_name="us-env-region", config=unittest.mock.ANY, service_name=unittest.mock.ANY)
+    
+    # With no env var, session region is used
+    with unittest.mock.patch.dict(os.environ, {}, clear=True):
+        BedrockModel()
+        mock_boto_session.return_value.client.assert_called_with(region_name="us-session-region", config=unittest.mock.ANY, service_name=unittest.mock.ANY)
+    
+    # Neither env var nor session region, fallback to default
+    mock_boto_session.return_value.region_name = None
+    with unittest.mock.patch.dict(os.environ, {}, clear=True):
+        BedrockModel()
+        mock_boto_session.return_value.client.assert_called_with(region_name=DEFAULT_BEDROCK_REGION, config=unittest.mock.ANY, service_name=unittest.mock.ANY)
