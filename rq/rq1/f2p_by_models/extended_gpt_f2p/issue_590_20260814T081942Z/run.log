    # Test with None
    tool_use = {"toolUseId": "test-id", "input": {"union_param": None}}
    _, result = generate(complex_schema_tool.stream(tool_use))
    assert result["status"] == "success"
    assert "NoneType: None" in result["content"][0]["text"]


