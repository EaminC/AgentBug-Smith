        return a

    return identity


@pytest.fixture(scope="module")
def identity_stream():
    @strands.tool
    def identity(a: int):
        yield {"event": "abc"}
        return a

    return identity


@pytest.fixture
def identity_tool(request):
    return request.getfixturevalue(request.param)


def test__init__invalid_name():
    with pytest.raises(ValueError, match="Tool name must be a string"):

