def test_aws_region_envvar_priority(monkeypatch):
    """
    Test that AWS_REGION environment variable is prioritized over region in ~/.aws/config.

    This test simulates the presence of a region in ~/.aws/config and sets AWS_REGION env var.
    It verifies that the agent uses the AWS_REGION environment variable for region selection.
    """

    # Simulate region set in ~/.aws/config by monkeypatching boto3 session region_name property
    import boto3.session

    class DummySession:
        @property
        def region_name(self):
            # Simulate region from ~/.aws/config
            return "ap-northeast-1"

    monkeypatch.setattr(boto3.session, "Session", lambda *args, **kwargs: DummySession())

    # Set AWS_REGION environment variable to override region
    monkeypatch.setenv("AWS_REGION", "us-west-2")

    # Create an agent with default model (which uses BedrockModel internally)
    agent = Agent()

    # The agent's model should use the region from AWS_REGION env var, not from DummySession.region_name
    # We test this by checking the region in the BedrockModel session config or equivalent attribute

    # Access the BedrockModel instance inside the agent
    model = agent.model

    # The BedrockModel internally creates a boto3 session or similar; we check the region used
    # We expect the region to be 'us-west-2' from AWS_REGION env var, not 'ap-northeast-1'

    # Since BedrockModel may not expose region directly, we check the model config or session attribute
    # The model config dict should have the region set to 'us-west-2'
    region_used = None
    if hasattr(model, "session") and hasattr(model.session, "region_name"):
        region_used = model.session.region_name
    elif hasattr(model, "config"):
        # Some BedrockModel versions may store region in config
        region_used = model.config.get("region")
    else:
        # Fallback: check environment variable used inside model config if available
        region_used = os.getenv("AWS_REGION")

    assert region_used == "us-west-2", (
        f"Expected region to be 'us-west-2' from AWS_REGION env var, but got '{region_used}'. "
        "AWS_REGION env var should override region in ~/.aws/config."
    )


def test_aws_region_envvar_override_effect(monkeypatch):
    """
    Test that setting AWS_REGION environment variable overrides region in ~/.aws/config
    and allows calling a US model without validation errors.
    """

    # Simulate ~/.aws/config region as ap-northeast-1
    import boto3.session

    class DummySession:
        @property
        def region_name(self):
            return "ap-northeast-1"

    monkeypatch.setattr(boto3.session, "Session", lambda *args, **kwargs: DummySession())

    # Set AWS_REGION to us-west-2 to override
    monkeypatch.setenv("AWS_REGION", "us-west-2")

    # Create an agent with default model (which uses US model id)
    agent = Agent()

    # The model id used should be a US model id (default)
    model_id = None
    if hasattr(agent.model, "config"):
        model_id = agent.model.config.get("model_id")
    else:
        model_id = "us.anthropic.claude-sonnet-4-20250514-v1:0"

    # The region used internally should be us-west-2, not ap-northeast-1
    region_used = None
    if hasattr(agent.model, "session") and hasattr(agent.model.session, "region_name"):
        region_used = agent.model.session.region_name
    elif hasattr(agent.model, "config"):
        region_used = agent.model.config.get("region")
    else:
        region_used = os.getenv("AWS_REGION")

    # The test is that the region used is us-west-2 and model id is US model id
    assert region_used == "us-west-2", f"Expected region to be 'us-west-2' but got '{region_used}'"
    assert model_id.startswith("us."), f"Expected US model id but got '{model_id}'"


@pytest.mark.asyncio
async def test_agent_tool_async_call(monkeypatch, agent):
    """
    Test that calling a tool in async context works and returns expected result.

    This indirectly tests that the agent uses the correct region from AWS_REGION env var
    when calling tools asynchronously.
    """

    # Set AWS_REGION to us-west-2 to override
    monkeypatch.setenv("AWS_REGION", "us-west-2")

    # Use a known tool from the agent
    tool_name = "tool_decorated"
    assert hasattr(agent.tool, tool_name), f"Agent does not have tool '{tool_name}'"

    # Call the tool asynchronously (simulate async context)
    # The tool_decorated expects a parameter random_string
    result = await agent.tool.tool_decorated(random_string="test_async_call")

    # The result should be a dict with status success and content containing the input string
    assert isinstance(result, dict)
    assert result.get("status") == "success"
    content = result.get("content")
    assert isinstance(content, list) and len(content) > 0
    text = content[0].get("text")
    assert "test_async_call" in text


