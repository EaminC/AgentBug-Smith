        region = agent.model.config.get("region")
    if not region and hasattr(agent.model, "_client"):
        # Try to get region from boto3 client config
        client = getattr(agent.model, "_client", None)
        if client and hasattr(client, "_client_config"):
            region = getattr(client._client_config, "region_name", None)

    # Assert that the region is the one from AWS_REGION env var
    assert region == "us-west-2", f"Expected region 'us-west-2' but got '{region}'"


