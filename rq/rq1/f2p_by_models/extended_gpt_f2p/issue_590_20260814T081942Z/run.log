@pytest.mark.asyncio
async def test_agent_tool_async_call(agent, mock_randint):
    mock_randint.return_value = 123

    result = agent.tool.tool_decorated(random_string="abcdEfghI123")

    expected = {
        "content": [
            {
                "text": "abcdEfghI123",
            },
        ],
        "status": "success",
        "toolUseId": "tooluse_tool_decorated_123",
    }

    assert result == expected


@pytest.mark.asyncio
async def test_agent_tool_direct_call(agent):
    result = agent.tool.tool_decorated(random_string="abcdEfghI123")

    expected = {
        "content": [
            {
                "text": "abcdEfghI123",
            },
        ],
        "status": "success",
        "toolUseId": "tooluse_tool_decorated_1",
    }

    assert result == expected


@pytest.mark.asyncio
async def test_run_tool_async_yields_events_and_result(agent, tool_decorated, alist):
    from strands.event_loop.event_loop import run_tool

    tool_use = {"toolUseId": "t1", "name": tool_decorated.tool_name, "input": {"random_string": "abcdEfghI123"}}

    events = await alist(run_tool(agent, tool_use, {}))

    assert events[-1]["toolUseId"] == "t1"
    assert events[-1]["status"] == "success"
    assert any("abcdEfghI123" in content.get("text", "") for content in events[-1]["content"])


@pytest.mark.asyncio
async def test_run_tool_missing_tool_returns_error(agent, alist):
    from strands.event_loop.event_loop import run_tool

    tool_use = {"toolUseId": "missing", "name": "missing_tool", "input": {}}

    events = await alist(run_tool(agent, tool_use, {}))

    assert len(events) == 1
    result = events[0]
    assert result["toolUseId"] == "missing"
    assert result["status"] == "error"
    assert "Unknown tool" in result["content"][0]["text"]


def test_agent_tool_call_with_user_message_override(agent):
