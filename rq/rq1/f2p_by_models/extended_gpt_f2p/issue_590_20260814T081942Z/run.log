@pytest.mark.asyncio
async def test_agent_call_with_env_region(monkeypatch, agent, agenerator):
    """
    Test that calling the agent with AWS_REGION env var set uses the correct region internally.
    """

    # Set AWS_REGION to 'us-west-2'
    monkeypatch.setenv("AWS_REGION", "us-west-2")

    # Patch the agent's model.converse to simulate a response
    agent.model.converse = lambda messages, tools, system_prompt: agenerator(
        [
            {"contentBlockDelta": {"delta": {"text": "response text"}}},
            {"contentBlockStop": {}},
            {"messageStop": {"stopReason": "end_turn"}},
        ]
    )

    # Call the agent with a prompt
    result = agent("Hello")

    # The result message should contain the expected text
    assert result.message == {"role": "assistant", "content": [{"text": "response text"}]}


@pytest.mark.asyncio
async def test_run_tool_async_iter(monkeypatch, agent):
    """
    Test that run_tool returns an async generator and yields expected events.
    """

    # Set AWS_REGION to 'us-west-2'
    monkeypatch.setenv("AWS_REGION", "us-west-2")

    # Define a simple tool that yields events and returns a result
    @tool
    async def async_tool():
        yield {"event": "started"}
        yield {"event": "running"}
        return {"status": "success", "content": [{"text": "done"}]}

    agent.tool_registry.register_tool(async_tool)

    tool_use = {
        "toolUseId": "async-tool-use",
        "name": async_tool.tool_name,
        "input": {},
    }

    events = []
    async for event in run_tool(agent, tool_use, {}):
        events.append(event)

    # The last event should be the tool result with status success
    assert events
    assert events[-1].get("status") == "success"
    assert any("done" in content.get("text", "") for content in events[-1].get("content", []))


