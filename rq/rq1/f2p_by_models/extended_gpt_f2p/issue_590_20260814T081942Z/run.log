def test_agent_init_default_and_string_model():
    """
    Test that Agent initializes with default and string model id correctly.
    """

    agent_default = Agent()
    assert agent_default.model is not None
    assert hasattr(agent_default.model, "config")
    assert agent_default.model.config.get("model_id") == "us.anthropic.claude-sonnet-4-20250514-v1:0" or agent_default.model.config.get("model_id") == "us.anthropic.claude-sonnet-4-20250514-v1:0"

    agent_string = Agent(model="custom-model-id")
    assert agent_string.model.config.get("model_id") == "custom-model-id"


@pytest.mark.asyncio
async def test_run_tool_async_yields_events_and_result(agent, alist):
    """
    Test that run_tool async generator yields events and final result.

    This indirectly tests that the agent uses the correct region from AWS_REGION env var.
    """

    # Set AWS_REGION to us-west-2 to override
    import os

    os.environ["AWS_REGION"] = "us-west-2"

    # Pick a known tool from the agent
    tool_name = "tool_decorated"
    tool_use = {"toolUseId": "test-tool-use-id", "name": tool_name, "input": {"random_string": "value"}}

    from strands.event_loop.event_loop import run_tool

    # run_tool is async generator; collect all events
    events = await alist(run_tool(agent, tool_use, {}))

    # The last event should be the tool result dict with status success
    assert isinstance(events, list)
    assert len(events) > 0
    result = events[-1]
    assert isinstance(result, dict)
    assert result.get("status") == "success"
    assert result.get("toolUseId") == "test-tool-use-id"
    content = result.get("content")
    assert isinstance(content, list)
    assert any("value" in str(item.get("text", "")) for item in content)


@pytest.mark.asyncio
async def test_run_tool_missing_tool_returns_error(agent, alist):
    """
    Test that run_tool returns an error result when the tool is missing.
    """

    import os

    os.environ["AWS_REGION"] = "us-west-2"

    tool_use = {"toolUseId": "missing-tool-use-id", "name": "missing_tool_name", "input": {}}

    from strands.event_loop.event_loop import run_tool

    events = await alist(run_tool(agent, tool_use, {}))

    # The last event should be an error result indicating unknown tool
    assert isinstance(events, list)
    assert len(events) == 1
    result = events[-1]
    assert result.get("status") == "error"
    assert "Unknown tool" in result.get("content", [{}])[0].get("text", "")


@pytest.mark.asyncio
async def test_agent_tool_call_with_user_message_override(monkeypatch, agent):
    """
    Test that calling a tool with user_message_override adds a user message.

    This test indirectly verifies that AWS_REGION env var override works in tool calls.
    """

    monkeypatch.setenv("AWS_REGION", "us-west-2")

    user_message = "override message"
    result = agent.tool.tool_decorated(random_string="abc", user_message_override=user_message)

    # The first message in agent.messages should contain the user_message_override text
    assert agent.messages
    first_message = agent.messages[0]
    assert first_message.get("role") == "user"
    contents = first_message.get("content", [])
    assert any(user_message in block.get("text", "") for block in contents)


@pytest.mark.asyncio
async def test_agent_tool_call_record_direct_tool_call_false(monkeypatch, agent):
    """
    Test that setting record_direct_tool_call=False prevents recording the tool call in messages.
    """

    monkeypatch.setenv("AWS_REGION", "us-west-2")

    agent.record_direct_tool_call = False
    agent.tool.tool_decorated(random_string="abc", user_message_override="msg")

    # The agent.messages should not include the tool call message
    assert agent.messages == [] or len(agent.messages) == 0


