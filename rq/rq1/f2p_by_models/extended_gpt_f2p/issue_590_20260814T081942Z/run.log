def test_agent_tool_call_no_parameter_conflict(monkeypatch, agent, tool_registry):
    """
    Test that calling a tool with parameters that conflict with internal names does not cause errors.

    This test registers a tool with a parameter named 'system_prompt' and calls it.
    """

    monkeypatch.setenv("AWS_REGION", "us-west-2")
    monkeypatch.delenv("AWS_DEFAULT_REGION", raising=False)

    @strands.tools.tool(name="system_prompter")
    def function(system_prompt: str) -> str:
