    @pytest.mark.asyncio
    async def test_aws_region_envvar_override(monkeypatch):
        """
        This test verifies that when both ~/.aws/config region and AWS_REGION environment variable are set,
        the AWS_REGION environment variable takes precedence in BedrockModel region selection.
    
        The bug was that AWS_REGION envvar was ignored if region was set in ~/.aws/config.
        The fix prioritizes AWS_REGION over config file.
    
        Steps:
        - Set AWS_REGION env var to 'us-west-2'
        - Mock BedrockModel to read region from environment variable and config file
        - Confirm that BedrockModel uses AWS_REGION env var region, not config file region
        """
    
        # Setup environment variables and config file simulation
        # Simulate ~/.aws/config region as 'ap-northeast-1'
        # Simulate AWS_REGION env var as 'us-west-2'
    
        # We patch os.environ to simulate environment variables
        monkeypatch.setenv("AWS_REGION", "us-west-2")
        monkeypatch.delenv("AWS_DEFAULT_REGION", raising=False)  # ensure AWS_DEFAULT_REGION is not set
    
        # We patch the boto3 session to simulate config file region
        # But since BedrockModel uses boto3 session internally, we can test the effective region
    
        # Create BedrockModel instance without explicit region
        model = BedrockModel()
    
        # The region used by BedrockModel should be 'us-west-2' because AWS_REGION env var overrides config
        # We check the internal boto3 session region_name property
    
        # Access the boto3 session region_name used by BedrockModel
        region = getattr(model, "_session", None)
        if region is not None:
            # _session is boto3.Session
            region_name = region.region_name
        else:
            # fallback: BedrockModel may expose config dict with region
            region_name = model.config.get("region")
    
        # Assert that region_name is 'us-west-2' (from AWS_REGION env var)
