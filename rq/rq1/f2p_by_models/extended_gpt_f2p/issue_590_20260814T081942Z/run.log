    assert result.get("status") == "success"
    content = result.get("content")
    assert isinstance(content, list)
    assert any("test123" in str(item.get("text", "")) for item in content)


@pytest.mark.asyncio
async def test_agent_tool_call_no_parameter_conflict(monkeypatch, agenerator):
    """
    Test that calling a tool with parameters that do not conflict with internal parameters works.

    This test calls a tool with a parameter and verifies the output.
