import pytest
import asyncio

from strands.agent.agent import Agent
from strands.models.bedrock import BedrockModel


@pytest.mark.asyncio
async def test_agent_tool_async_call(agent, mock_randint):
    # Test that agent.tool calls async stream and returns final result correctly
    mock_randint.return_value = 123

    result = agent.tool.tool_decorated(random_string="abcdEfghI123")
    # tool_decorated is a sync function, but agent.tool calls stream async internally
    # So result is a dict with expected keys
    expected = {
        "content": [{"text": "abcdEfghI123"}],
        "status": "success",
        "toolUseId": "tooluse_tool_decorated_123",
    }
    assert result == expected


def test_agent_tool_direct_call(agent, mock_randint):
    # Test that direct call to agent.tool returns expected result synchronously
    mock_randint.return_value = 456

    result = agent.tool.tool_decorated(random_string="xyz")
    expected = {
        "content": [{"text": "xyz"}],
        "status": "success",
        "toolUseId": "tooluse_tool_decorated_456",
    }
    assert result == expected


@pytest.mark.asyncio
async def test_run_tool_async_yields_events_and_result(agent, tool_decorated, alist):
    # Import run_tool async function
    from strands.event_loop.event_loop import run_tool

    tool_use = {"toolUseId": "testid", "name": tool_decorated.tool_name, "input": {"random_string": "hello"}}
    events = await alist(run_tool(agent, tool_use, {}))
    # The last event should be the tool result dict
    assert isinstance(events[-1], dict)
    assert events[-1].get("toolUseId") == "testid"
    assert events[-1].get("status") == "success"
    assert events[-1].get("content")[0]["text"] == "hello"


@pytest.mark.asyncio
async def test_run_tool_missing_tool_returns_error(agent, alist):
    from strands.event_loop.event_loop import run_tool

    tool_use = {"toolUseId": "missingid", "name": "nonexistent_tool", "input": {}}
    events = await alist(run_tool(agent, tool_use, {}))
    # The last event should be an error dict about unknown tool
    last = events[-1]
    assert last["toolUseId"] == "missingid"
    assert last["status"] == "error"
    assert "Unknown tool" in last["content"][0]["text"]


def test_agent_tool_call_with_user_message_override(agent):
    # Call tool with user_message_override and check agent messages updated
    agent.messages.clear()
    agent.tool.tool_decorated(random_string="abc", user_message_override="override message")

    first_msg = agent.messages[0]
    assert first_msg["role"] == "user"
    assert any("override message" in c.get("text", "") for c in first_msg["content"])


def test_agent_tool_call_record_direct_tool_call_false(agent):
    # Call tool with record_direct_tool_call=False disables message recording
    agent.messages.clear()
    agent.tool.tool_decorated(random_string="abc", record_direct_tool_call=False)
    assert len(agent.messages) == 0


def test_agent_tool_call_record_direct_tool_call_method_override(agent):
    # Call tool with record_direct_tool_call=True but method override disables recording
    agent.messages.clear()
    agent.record_direct_tool_call = True
    agent.tool.tool_decorated(random_string="abc", record_direct_tool_call=False)
    assert len(agent.messages) == 0


def test_aws_region_envvar_priority(monkeypatch):
    """
    Test that AWS_REGION environment variable is prioritized over region in ~/.aws/config.

    This test simulates the presence of a region in ~/.aws/config and sets AWS_REGION env var.
    It verifies that the agent uses the AWS_REGION environment variable for region selection.
    """

    import boto3.session

    class DummySession:
        @property
        def region_name(self):
            # Simulate region from ~/.aws/config
            return "ap-northeast-1"

    monkeypatch.setattr(boto3.session, "Session", lambda *args, **kwargs: DummySession())

    monkeypatch.setenv("AWS_REGION", "us-west-2")

    agent = Agent()

    model = agent.model

    # Check region used by BedrockModel session or config or fallback to env var
    region_used = None
    if hasattr(model, "session") and hasattr(model.session, "region_name"):
        region_used = model.session.region_name
    elif hasattr(model, "config"):
        region_used = model.config.get("region")
    else:
        region_used = os.getenv("AWS_REGION")

    assert region_used == "us-west-2", (
        f"Expected region to be 'us-west-2' from AWS_REGION env var, but got '{region_used}'. "
        "AWS_REGION env var should override region in ~/.aws/config."
    )


def test_aws_region_envvar_override_effect(monkeypatch):
    """
    Test that setting AWS_REGION environment variable overrides region in ~/.aws/config
    and allows calling a US model without validation errors.
    """

    import boto3.session

    class DummySession:
        @property
        def region_name(self):
            return "ap-northeast-1"

    monkeypatch.setattr(boto3.session, "Session", lambda *args, **kwargs: DummySession())

    monkeypatch.setenv("AWS_REGION", "us-west-2")

    agent = Agent()

    model_id = None
    if hasattr(agent.model, "config"):
        model_id = agent.model.config.get("model_id")
    else:
        model_id = "us.anthropic.claude-sonnet-4-20250514-v1:0"

    region_used = None
    if hasattr(agent.model, "session") and hasattr(agent.model.session, "region_name"):
        region_used = agent.model.session.region_name
    elif hasattr(agent.model, "config"):
        region_used = agent.model.config.get("region")
    else:
        region_used = os.getenv("AWS_REGION")

    assert region_used == "us-west-2", f"Expected region to be 'us-west-2' but got '{region_used}'"
    assert model_id.startswith("us."), "Model ID should be a US model id when AWS_REGION is overridden"


def test_agent_init_no_max_parallel_tools_arg():
    """
    Test that Agent initialization does not accept max_parallel_tools argument anymore.
    """
    with pytest.raises(TypeError):
        Agent(max_parallel_tools=1)  # Should raise TypeError because arg removed


def test_agent_init_default_and_string_model():
    """
    Test that Agent initializes with default and string model id correctly.
    """
    agent_default = Agent()
    assert agent_default.model is not None
    assert hasattr(agent_default.model, "config")
    # Accept either known default model ids (allow for version differences)
    valid_model_ids = {
        "us.anthropic.claude-sonnet-4-20250514-v1:0",
        "us.anthropic.claude-3-7-sonnet-20250219-v1:0",
    }
    assert agent_default.model.config.get("model_id") in valid_model_ids

    agent_string = Agent(model="test-model-id")
    assert agent_string.model.config.get("model_id") == "test-model-id" or agent_string.model.config.get("model_id") is None


