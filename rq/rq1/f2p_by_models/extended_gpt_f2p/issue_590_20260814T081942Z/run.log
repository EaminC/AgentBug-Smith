            unittest.mock.call(event={"contentBlockStart": {"start": {}}}),
            unittest.mock.call(event={"contentBlockDelta": {"delta": {"reasoningContent": {"text": "value"}}}}),
            unittest.mock.call(
                agent=agent,
                delta={"reasoningContent": {"text": "value"}},
