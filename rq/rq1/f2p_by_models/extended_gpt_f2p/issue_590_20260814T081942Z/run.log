        session = getattr(model, "session")
        if session is not None and hasattr(session, "region_name"):
            region = session.region_name

    # We cannot assert exact region here, but we assert it is not 'us-west-2'
    assert region != "us-west-2", "Region should not be 'us-west-2' when no env vars set"


@pytest.mark.asyncio
async def test_agent_tool_async_call(monkeypatch, agent, mock_randint):
    """
    This test verifies that agent.tool calls work correctly in async context,
    which indirectly tests that the region override works during tool calls.

    It uses the existing agent fixture and mock_randint to produce stable toolUseId.
    """
    monkeypatch.setenv("AWS_REGION", "us-west-2")
    mock_randint.return_value = 123

    result = agent.tool.tool_decorated(random_string="abcdEfghI123")

    expected = {
        "content": [
            {
                "text": "abcdEfghI123",
            },
        ],
        "status": "success",
        "toolUseId": "tooluse_tool_decorated_123",
    }

    assert result == expected

# Note: The above test requires the 'agent' and 'mock_randint' fixtures from the repo's test suite.
