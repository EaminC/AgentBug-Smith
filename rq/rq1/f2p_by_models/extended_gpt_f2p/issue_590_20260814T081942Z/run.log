@pytest.mark.asyncio
async def test_aws_region_envvar_override_agent_stream(monkeypatch):
    """
    Test that agent.stream_async respects AWS_REGION env var.
    """
    monkeypatch.setenv("AWS_REGION", "us-west-2")

    agent = Agent()

    prompt = "Stream test with region override"

    stream = agent.stream_async(prompt)

    texts = []
    async for event in stream:
        if "data" in event:
            texts.append(event["data"])
        if event.get("complete"):
            break

    # We expect some text in the stream, not empty
    assert any(texts)
    # The region used by the Bedrock client should be us-west-2
    assert agent.model.client.meta.region_name == "us-west-2"


def test_aws_region_envvar_override_agent_call(monkeypatch):
    """
    Test that agent.__call__ respects AWS_REGION env var.
    """
    monkeypatch.setenv("AWS_REGION", "us-west-2")

    agent = Agent()

    # We patch the model's converse method to avoid real API calls
    async def fake_converse(*args, **kwargs):
        yield {"contentBlockDelta": {"delta": {"text": "response"}}}
        yield {"contentBlockStop": {}}
        yield {"messageStop": {"stopReason": "end_turn"}}

    agent.model.converse = fake_converse

    result = agent("Hello")

    assert result.message["content"][0]["text"] == "response"
    assert agent.model.client.meta.region_name == "us-west-2"


@pytest.mark.asyncio
async def test_aws_region_envvar_override_tool_stream(monkeypatch, sample_tool):
    """
    Test that streaming a tool call respects AWS_REGION env var.
    """
    monkeypatch.setenv("AWS_REGION", "us-west-2")

    agent = Agent()
    agent.tool_registry.register_tool(sample_tool)

    test_input = "tool stream region override"

    stream = sample_tool.stream({"toolUseId": "test-tool-stream", "input": {"random_string": test_input}}, {})

    events = []
    async for event in stream:
        events.append(event)

    # The last event should be the tool result
    assert events[-1]["status"] == "success"
    assert events[-1]["content"][0]["text"] == test_input
    assert agent.model.client.meta.region_name == "us-west-2"


