@pytest.mark.asyncio
async def test_aws_region_envvar_override_agent_tool_async(monkeypatch, agent):
    """
    Test that agent.tool calls respect AWS_REGION env var in async context.
    """
    monkeypatch.setenv("AWS_REGION", "us-west-2")

    # Use a tool already registered in the agent (tool_decorated)
    # We patch the random.randint to produce a fixed toolUseId suffix
    import random

    orig_randint = random.randint
    random.randint = lambda a, b: 123

    try:
        result = agent.tool.tool_decorated(random_string="abcdEfghI123")
        assert result["status"] == "success"
        assert result["content"][0]["text"] == "abcdEfghI123"
        assert result["toolUseId"] == "tooluse_tool_decorated_123"
        assert agent.model.client.meta.region_name == "us-west-2"
    finally:
        random.randint = orig_randint


