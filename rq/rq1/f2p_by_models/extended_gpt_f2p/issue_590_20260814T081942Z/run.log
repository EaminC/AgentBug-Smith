def test_aws_region_envvar_priority(monkeypatch):
    """
    Test that AWS_REGION environment variable is prioritized over ~/.aws/config region setting.
    This test simulates the environment where ~/.aws/config has a region set to 'ap-northeast-1',
    but AWS_REGION environment variable is set to 'us-west-2'.
    The agent should use the AWS_REGION value 'us-west-2' for Bedrock model calls.
    """

    # Simulate ~/.aws/config region by patching boto3 session to return ap-northeast-1 by default
    # We do not mock boto3 directly here, but we simulate the environment by setting environment variables accordingly.

    # Set environment variable AWS_REGION to 'us-west-2'
    monkeypatch.setenv("AWS_REGION", "us-west-2")
    # Also set AWS_DEFAULT_REGION to a different value to check that AWS_REGION is prioritized
    monkeypatch.setenv("AWS_DEFAULT_REGION", "ap-northeast-1")

    # Create an Agent instance with default model (which uses BedrockModel internally)
    agent = Agent()

    # Prepare a tool decorated function that returns the region used by the Bedrock client session
    # We will monkeypatch the BedrockModel to expose the region it uses internally

    # Import BedrockModel here to patch
    from strands.models.bedrock import BedrockModel

    # Patch the BedrockModel to capture the region used for the session
    original_init = BedrockModel.__init__

    def patched_init(self, model_id=None, **kwargs):
        original_init(self, model_id=model_id, **kwargs)
        # Capture the region attribute used internally
        self._captured_region = self._client._client_config.region_name

    BedrockModel.__init__ = patched_init

    # Recreate agent to apply patched BedrockModel
    agent = Agent()

    # The region used internally should be 'us-west-2' due to AWS_REGION env var priority
    region_used = agent.model._captured_region

    # Restore original __init__ to avoid side effects
    BedrockModel.__init__ = original_init

    assert region_used == "us-west-2", (
        f"Expected region 'us-west-2' from AWS_REGION env var, but got '{region_used}'. "
        "AWS_REGION env var must be prioritized over ~/.aws/config region."
    )


@pytest.mark.asyncio
async def test_run_tool_respects_region_envvar(monkeypatch, agent):
    """
    Test that run_tool uses the region from AWS_REGION environment variable when invoking a tool.
    This indirectly tests that the Bedrock client session uses the correct region.
    """

    # Set AWS_REGION to 'us-west-2'
    monkeypatch.setenv("AWS_REGION", "us-west-2")
    # Set AWS_DEFAULT_REGION to a different region to ensure AWS_REGION is prioritized
    monkeypatch.setenv("AWS_DEFAULT_REGION", "ap-northeast-1")

    # Define a simple tool that returns the region used by the Bedrock client session
    @tool
    def region_tool():
        # Access the region from the agent's model client
        # We assume the agent is passed as keyword argument
        agent = region_tool._metadata.signature.parameters.get("agent", None)
        # We will get the region from the BedrockModel client inside the agent
        # But since agent is not passed automatically here, we will access global agent for test
        # For this test, we will monkeypatch agent.model._client._client_config.region_name
        return agent.model._client._client_config.region_name if agent else "unknown"

    # Register the tool to the agent's tool registry
    agent.tool_registry.register_tool(region_tool)

    # Prepare tool use dictionary
    tool_use = {
        "toolUseId": "test-region-tool",
        "name": region_tool.tool_name,
        "input": {},
    }

    # Run the tool using run_tool, which is async generator
    # Consume all events and get the last result
    events = []
    async for event in run_tool(agent, tool_use, {}):
        events.append(event)

    # The last event should be the tool result dict
    result = events[-1]

    # The region returned by the tool should be 'us-west-2' as per AWS_REGION env var
    assert result.get("content") and result["content"][0].get("text") == "us-west-2", (
        f"Expected tool to report region 'us-west-2', but got '{result.get('content')[0].get('text')}'."
    )


def test_agent_init_does_not_accept_max_parallel_tools():
    """
    Test that Agent.__init__ does not accept max_parallel_tools argument anymore,
    as it was removed in the fix.
    """
    with pytest.raises(TypeError):
        Agent(max_parallel_tools=1)


def test_agent_tool_direct_call_with_env_region(monkeypatch, agent):
    """
    Test that calling a tool directly on the agent works correctly with AWS_REGION env var set.
    This test ensures that the tool call does not fail due to region misconfiguration.
    """

    # Set AWS_REGION to 'us-west-2'
    monkeypatch.setenv("AWS_REGION", "us-west-2")

    # Use the existing tool_decorated fixture tool from the agent
    # Call the tool directly with a sample input
    result = agent.tool.tool_decorated(random_string="test123")

    # The result should be a dict with status success and content containing the input string
    assert isinstance(result, dict)
    assert result.get("status") == "success"
    assert any("test123" in content.get("text", "") for content in result.get("content", []))


