@pytest.mark.asyncio
async def test_run_tool_async_returns_expected(agent, agenerator):
    """
    Test that run_tool async function yields expected events and final result.

    This test verifies that run_tool is async and yields events correctly.
    """
    # Use a simple tool registered in the agent
    @strands.tools.tool
    def echo_tool(random_string: str) -> str:
        return random_string

    agent.tool_registry.register_tool(echo_tool)

    tool_use = {"toolUseId": "test-tool-use-id", "name": "echo_tool", "input": {"random_string": "hello"}}

    # run_tool is async generator
    events = []
    async for event in run_tool(agent, tool_use, {}):
        events.append(event)

    # The last event should be the tool result
    result = events[-1]

    assert result["toolUseId"] == "test-tool-use-id"
    assert result["status"] == "success"
    assert result["content"][0]["text"] == "hello"


@pytest.mark.asyncio
async def test_mcp_agent_tool_stream_async(monkeypatch, alist):
    """
    Test MCPAgentTool stream is async and yields expected result.

    This test mocks MCPClient.call_tool_sync to return a dummy result and verifies that
    MCPAgentTool.stream yields that result correctly.
    """
    from strands.tools.mcp.mcp_agent_tool import MCPAgentTool

    class DummyMCPClient:
        def call_tool_sync(self, tool_use_id, name, arguments):
            return {"status": "success", "toolUseId": tool_use_id, "content": [{"text": "dummy"}]}

    dummy_client = DummyMCPClient()

    # Create MCPAgentTool with dummy client
    mcp_tool = MCPAgentTool(tool_name="dummy_tool", mcp_client=dummy_client)

    tool_use = {"toolUseId": "dummy-id", "name": "dummy_tool", "input": {"param": "value"}}

    events = await alist(mcp_tool.stream(tool_use, {}))

    # The stream yields exactly one event: the dummy result
    assert len(events) == 1
    result = events[0]

    assert result["toolUseId"] == "dummy-id"
    assert result["status"] == "success"
    assert result["content"][0]["text"] == "dummy"


@pytest.mark.asyncio
async def test_python_agent_tool_stream_async(alist):
    """
    Test PythonAgentTool stream is async and yields expected result.

    This test creates a PythonAgentTool wrapping a simple function and verifies the stream yields the result.
    """
    from strands.tools.tools import PythonAgentTool

    def simple_tool(tool_use, x: int):
        return {"status": "success", "toolUseId": tool_use.get("toolUseId", "unknown"), "content": [{"text": str(x)}]}

    python_tool = PythonAgentTool(
        tool_name="simple_tool",
        tool_spec={
            "name": "simple_tool",
            "description": "Simple tool",
            "inputSchema": {"type": "object", "properties": {"x": {"type": "integer"}}},
        },
        tool_func=simple_tool,
    )

    tool_use = {"toolUseId": "tooluse-1", "name": "simple_tool", "input": {"x": 42}}

    events = await alist(python_tool.stream(tool_use, {}))

    # The stream yields exactly one event: the tool result
    assert len(events) == 1
    result = events[0]

    assert result["toolUseId"] == "tooluse-1"
    assert result["status"] == "success"
    assert result["content"][0]["text"] == "42"


@pytest.mark.asyncio
async def test_tools_executor_run_tools_async(monkeypatch, alist):
    """
    Test that run_tools executes multiple tools concurrently and yields events.

    This test mocks a simple async tool handler that yields events and returns a result.
    """
    from strands.tools.executor import run_tools

    async def dummy_handler(tool_use):
        yield {"event": "start"}
        yield {"event": "processing"}
        return {"toolUseId": tool_use["toolUseId"], "status": "success", "content": [{"text": "done"}]}

    tool_uses = [
        {"toolUseId": "t1", "name": "dummy1", "input": {}},
        {"toolUseId": "t2", "name": "dummy2", "input": {}},
    ]
    event_loop_metrics = type("DummyMetrics", (), {"add_tool_duration": lambda self, *args, **kwargs: None})()
    invalid_tool_use_ids = []
    cycle_trace = None
    parent_span = None

    events = []
    async for event in run_tools(dummy_handler, tool_uses, event_loop_metrics, invalid_tool_use_ids, [], cycle_trace, parent_span):
        events.append(event)

    # Events should include events from both tools and results
    # The last events for each tool are the tool results
    tool_result_events = [e for e in events if isinstance(e, dict) and "status" in e]

    assert len(tool_result_events) == 2
    assert all(r["status"] == "success" for r in tool_result_events)
    assert {r["toolUseId"] for r in tool_result_events} == {"t1", "t2"}


