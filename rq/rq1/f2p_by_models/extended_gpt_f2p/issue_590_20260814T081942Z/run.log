@pytest.fixture
def agent_with_region_override(monkeypatch):
    # Patch environment to simulate AWS_REGION override
    monkeypatch.setenv("AWS_REGION", "us-west-2")
    # Also simulate ~/.aws/config region set to ap-northeast-1 by patching boto3 session region_name
    # But since we cannot patch boto3 directly here without mocking, we rely on the actual environment variable precedence
    # The bug is that AWS_REGION is ignored if ~/.aws/config has region set; after fix AWS_REGION should be prioritized.

    # Create an Agent instance that uses BedrockModel internally
    agent = Agent()
    return agent


@pytest.mark.asyncio
async def test_aws_region_envvar_override(monkeypatch, agent_with_region_override, sample_tool):
    """
    This test verifies that when AWS_REGION environment variable is set,
    the agent uses that region instead of the region set in ~/.aws/config.

    The buggy behavior is that AWS_REGION is ignored if ~/.aws/config has a region set,
    causing calls to fail with invalid model identifier errors.

    The fixed behavior is that AWS_REGION is always prioritized.

    We simulate this by:
    - Setting AWS_REGION env var to 'us-west-2'
    - Assuming ~/.aws/config has region 'ap-northeast-1' (cannot set here, but the bug is about env var precedence)
    - Calling a BedrockModel-based agent with a model id that is US-region specific (us.anthropic.claude-sonnet-4-20250514-v1:0)
    - The call should succeed (or at least not fail with ValidationException about model id invalid for region)
    """

    # The test depends on the BedrockModel inside the Agent to pick up AWS_REGION env var correctly.

    # Use the sample tool to invoke a tool call via the agent to trigger BedrockModel usage
    # We call the tool directly via the agent.tool interface, which internally calls BedrockModel.

    # Patch the tool to the agent's tool registry
    agent = agent_with_region_override
    agent.tool_registry.register_tool(sample_tool)

    # Generate a unique random string to pass to the tool
    test_input = "test-region-override"

    # Call the tool via agent.tool interface
    # This will internally call BedrockModel with the region set by AWS_REGION env var
    result = agent.tool.echo(random_string=test_input)

    # The expected result is a dict with status success and content containing the input string
    assert isinstance(result, dict)
    assert result.get("status") == "success"
    content = result.get("content")
    assert isinstance(content, list)
    assert any(test_input == item.get("text") for item in content if isinstance(item, dict))

    # If the bug is present, the call would fail with ValidationException or region mismatch errors,
    # causing an exception or error status. So this test should fail on buggy code and pass on fixed code.


@pytest.mark.asyncio
async def test_aws_region_envvar_override_async(monkeypatch, agent_with_region_override, sample_tool):
    """
    Async version of the test to verify AWS_REGION env var override in async context.
    """

    agent = agent_with_region_override
    agent.tool_registry.register_tool(sample_tool)

    test_input = "test-region-override-async"

    # Use the async stream interface of the tool
    stream = agent.tool.echo.stream({"toolUseId": "test-async", "input": {"random_string": test_input}}, {})

    # Collect all events from the async generator
    events = []
    async for event in stream:
        events.append(event)

    # The last event should be the tool result dict
    assert events
    result = events[-1]
    assert isinstance(result, dict)
    assert result.get("status") == "success"
    content = result.get("content")
    assert isinstance(content, list)
    assert any(test_input == item.get("text") for item in content if isinstance(item, dict))


