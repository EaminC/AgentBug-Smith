  @pytest.mark.asyncio
  async def test_run_tools_respects_region_env(monkeypatch, agent, alist):
      """
      Test that run_tools function executes tools correctly when AWS_REGION env var is set,
      ensuring region override is respected in tool execution.

      This test runs run_tools with a simple tool use and checks for successful execution.
      """

      monkeypatch.setenv("AWS_REGION", "us-west-2")
      monkeypatch.delenv("AWS_DEFAULT_REGION", raising=False)

      # Prepare a simple tool use from agent's tool registry
      tools = list(agent.tool_registry.get_all_tool_specs().values())
      assert len(tools) > 0, "Agent has no tools registered"
      tool_spec = tools[0]

      tool_use = {
          "toolUseId": "test-tooluse-1",
          "name": tool_spec["name"],
          "input": {"random_string": "hello world"},
      }

      tool_results = []

      # Run tools with the agent's tool_handler
      stream = run_tools(
          handler=agent.tool_handler,
          tool_uses=[tool_use],
          event_loop_metrics=agent.event_loop_metrics,
          invalid_tool_use_ids=[],
          tool_results=tool_results,
          cycle_trace=agent.cycle_trace,
          parent_span=None,
      )

      events = await alist(stream)

      # The last event should be the tool result with status success
      assert len(events) > 0
      last_event = events[-1]
      assert isinstance(last_event, dict)
      assert last_event.get("status") == "success"
      assert last_event.get("toolUseId") == "test-tooluse-1"

      # The tool_results list should contain the result
      assert len(tool_results) == 1
      assert tool_results[0].get("status") == "success"

      # The content text should include the input string
      content_text = tool_results[0].get("content", [{}])[0].get("text", "")
      assert "hello world" in content_text
