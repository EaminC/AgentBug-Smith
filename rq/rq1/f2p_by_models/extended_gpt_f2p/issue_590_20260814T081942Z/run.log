@pytest.mark.asyncio
async def test_aws_region_envvar_override(monkeypatch):
    """
    This test verifies that the AWS_REGION environment variable is prioritized over the region set in ~/.aws/config.

    Steps:
    1. Monkeypatch the environment to simulate AWS_REGION set to 'us-west-2'.
    2. Create an Agent instance and check that the BedrockModel session uses the region from AWS_REGION.
    3. The test should fail on the buggy codebase because AWS_REGION is ignored.
    4. After the fix, the test should pass.
    """
    # Set AWS_REGION environment variable to us-west-2
    monkeypatch.setenv("AWS_REGION", "us-west-2")
    # Also set AWS_DEFAULT_REGION to a different region to ensure AWS_REGION is prioritized
    monkeypatch.setenv("AWS_DEFAULT_REGION", "ap-northeast-1")

    # Create an Agent instance with default model (BedrockModel)
    agent = Agent()

    # The BedrockModel instance is accessible via agent.model
    model = agent.model

    # The model config should reflect the region from AWS_REGION environment variable
    # The BedrockModel config dict may contain region info or session info
    # We check that the region used is 'us-west-2'
    # The exact attribute depends on implementation; we check config keys and values

    # Check if 'region' key is in model config and equals 'us-west-2'
    region = None
    if hasattr(model, "config") and isinstance(model.config, dict):
        region = model.config.get("region")
    # If region is not directly in config, check if model has a session attribute with region
    if region is None and hasattr(model, "session"):
        session = getattr(model, "session")
        if session is not None and hasattr(session, "region_name"):
            region = session.region_name

    # Assert that the region is 'us-west-2' (from AWS_REGION env var)
    assert region == "us-west-2", f"Expected region 'us-west-2' but got {region}"


@pytest.mark.asyncio
async def test_aws_default_region_envvar(monkeypatch):
    """
    This test verifies that if AWS_REGION is not set, AWS_DEFAULT_REGION is used.

    Steps:
    1. Unset AWS_REGION and set AWS_DEFAULT_REGION to 'us-west-2'.
    2. Create an Agent instance and check that the BedrockModel session uses AWS_DEFAULT_REGION.
    """
    monkeypatch.delenv("AWS_REGION", raising=False)
    monkeypatch.setenv("AWS_DEFAULT_REGION", "us-west-2")

    agent = Agent()
    model = agent.model

    region = None
    if hasattr(model, "config") and isinstance(model.config, dict):
        region = model.config.get("region")
    if region is None and hasattr(model, "session"):
        session = getattr(model, "session")
        if session is not None and hasattr(session, "region_name"):
            region = session.region_name

    assert region == "us-west-2", f"Expected region 'us-west-2' but got {region}"


