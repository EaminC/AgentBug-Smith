    monkeypatch.delenv("AWS_DEFAULT_REGION", raising=False)

    # Create an Agent with default model (BedrockModel)
    agent = Agent()

    # The BedrockModel instance inside agent.model should use the region from AWS_REGION env var
    # We check the region attribute or config if available
    # The BedrockModel region is typically set in config or internal boto3 session
    # We check that the region is 'us-west-2' as set in AWS_REGION env var

    # Access the region from the model's boto3 client or config
    # The BedrockModel class has a config dict with model_id and possibly region
    # We check if 'region_name' or 'region' is set in the model config or boto3 session

    # The BedrockModel class may expose the boto3 client or session, or region in config
    # We check agent.model.config for region or agent.model._client._client_config.region_name if available

