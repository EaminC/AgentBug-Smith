@pytest.mark.asyncio
async def test_aws_region_envvar_override(monkeypatch):
    """
    Test that AWS_REGION environment variable overrides region set in ~/.aws/config.

    This test simulates the presence of a region in the AWS config file and sets AWS_REGION envvar.
    It verifies that the BedrockModel uses the AWS_REGION envvar region, not the config file region,
    by checking the model's region used in the session or client.

    The buggy code ignores AWS_REGION envvar and uses the config file region.
    The fixed code prioritizes AWS_REGION envvar.
    """
    # Set AWS_REGION env var to a known region
    monkeypatch.setenv("AWS_REGION", "us-west-2")
    # Also set AWS_DEFAULT_REGION to a different region to ensure AWS_REGION is prioritized
    monkeypatch.setenv("AWS_DEFAULT_REGION", "eu-central-1")

    # Create an agent with default BedrockModel (which reads region)
    agent = Agent()

    # The BedrockModel internally uses boto3 session or client
    # We check that the region used is the AWS_REGION env var, not the config file region
    # The config file region is assumed to be ap-northeast-1 (per issue description)
    # We verify the region used by the model

    # Access the BedrockModel instance
    model = agent.model
    # The BedrockModel has a boto3 session or client attribute (usually _session or _client)
    # We try to get the region_name from the boto3 session or client

    region = None
    # Try to get region from boto3 session if available
    if hasattr(model, "_session"):
        session = getattr(model, "_session")
        if session and hasattr(session, "region_name"):
            region = session.region_name
    # Otherwise try to get region from boto3 client if available
    if not region and hasattr(model, "_client"):
        client = getattr(model, "_client")
        if client and hasattr(client, "meta") and hasattr(client.meta, "region_name"):
            region = client.meta.region_name

    # Assert that region is the AWS_REGION env var value
    assert region == "us-west-2", f"Expected region 'us-west-2' but got '{region}'"


@pytest.mark.asyncio
async def test_agent_tool_direct_call_async(agent):
    """
    Test that calling a tool directly from agent.tool returns expected result in async context.

    This test ensures that the direct tool call correctly processes and returns the tool result,
    which was broken by the buggy run_tool implementation ignoring async.
    """
    # Use the existing tool_decorated tool from the agent
    tool_func = agent.tool.tool_decorated

    # Call the tool directly with a test input
    result = tool_func(random_string="abcdEfghI123")

    expected = {
        "content": [{"text": "abcdEfghI123"}],
        "status": "success",
        "toolUseId": result.get("toolUseId"),  # toolUseId is generated dynamically
    }

    # Check that the result matches expected content and status
    assert result["content"] == expected["content"]
    assert result["status"] == expected["status"]
    assert result["toolUseId"].startswith("tooluse_tool_decorated_")

@pytest.mark.asyncio
async def test_agent_tool_no_parameter_conflict_async(agent, tool_registry, mock_randint, mock_run_tool, agenerator):
    """
    Test that a tool with a parameter named 'system_prompt' does not conflict with agent internals.

    This test verifies that the tool is called correctly and mock_run_tool is called with expected args.
    """
    mock_run_tool.return_value = agenerator([{}])

    @strands.tools.tool(name="system_prompter")
    def function(system_prompt: str) -> str:
        return system_prompt

    agent.tool_registry.register_tool(function)

    mock_randint.return_value = 1

    result = agent.tool.system_prompter(system_prompt="tool prompt")

    # The result should be the string "tool prompt"
    assert result == "tool prompt"
    mock_run_tool.assert_called_once()

