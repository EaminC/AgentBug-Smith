+    def _is_tasks_enabled(self) -> bool:
+        """Check if tasks feature is enabled.
+
+        Tasks are enabled if tasks config is defined and not None.
+
+        Returns:
+            True if task-augmented execution is enabled, False otherwise.
+        """
