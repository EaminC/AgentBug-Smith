@pytest.mark.asyncio
async def test_stream_accepts_vllm_reasoning_delta(monkeypatch):
    # Patch aws_bedrock_token_generator.provide_token to avoid ImportError
    def fake_provide_token(*args, **kwargs):
        return "fake-token"

    monkeypatch.setattr("strands.models._openai_bedrock.provide_token", fake_provide_token, raising=False)

    # Setup model and patch create method
    model = OpenAIModel(model_id="xai.grok-4.3", bedrock_mantle_config={"region": "us-east-1"})

    class Delta:
        def __init__(self, reasoning=None, content=None, tool_calls=None):
            self.reasoning_content = reasoning
            self.content = content
            self.tool_calls = tool_calls

    reasoning_delta = Delta(reasoning="\nI'm thinking")
    stop_delta = Delta()

    events = [
        unittest.mock.Mock(choices=[unittest.mock.Mock(finish_reason=None, delta=reasoning_delta)]),
        unittest.mock.Mock(choices=[unittest.mock.Mock(finish_reason="stop", delta=stop_delta)]),
    ]

    async def fake_create(**kwargs):
        for e in events:
            yield e

    model._client.chat.completions.create = fake_create

    messages = [{"role": "user", "content": [{"text": "hello"}]}]

    collected = []
    async for event in model.stream(messages):
        collected.append(event)

    # Check that reasoning content block is present
    reasoning_blocks = [e for e in collected if "contentBlockDelta" in e and "reasoningContent" in e["contentBlockDelta"]["delta"]]
    assert len(reasoning_blocks) == 1
    assert reasoning_blocks[0]["contentBlockDelta"]["delta"]["reasoningContent"]["text"] == "\nI'm thinking"


