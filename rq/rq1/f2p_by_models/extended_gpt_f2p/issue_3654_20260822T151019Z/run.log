    resolved = model._resolve_client_args()
    base_url = resolved.get("base_url", "")
    assert base_url.startswith("https://bedrock-mantle.ap-southeast-2.api.aws/v1")


@pytest.mark.asyncio
async def test_bedrock_mantle_config_explicit_region_wins_over_boto_session(monkeypatch):
    """
    Test that explicit region takes precedence over a session's region.
    """
    import strands.models.openai as openai_module

    class DummySession:
        region_name = "ap-southeast-2"

    session = DummySession()
    model = OpenAIModel(
        model_id="openai.gpt-oss-120b",
        bedrock_mantle_config={"region": "us-east-1", "boto_session": session},
    )
    resolved = model._resolve_client_args()
    base_url = resolved.get("base_url", "")
    assert base_url.startswith("https://bedrock-mantle.us-east-1.api.aws/v1")


@pytest.mark.asyncio
async def test_bedrock_mantle_config_merges_with_client_args(monkeypatch):
    """
    Test that bedrockMantleConfig composes with client_args; transport options are preserved.
    """
    import strands.models.openai as openai_module

    sentinel_http_client = object()
    model = OpenAIModel(
        model_id="openai.gpt-oss-120b",
        client_args={
            "timeout": 42,
            "http_client": sentinel_http_client,
            "default_headers": {"X-Trace-Id": "abc"},
        },
        bedrock_mantle_config={"region": "us-east-1"},
    )
    resolved = model._resolve_client_args()
    assert resolved["base_url"].startswith("https://bedrock-mantle.us-east-1.api.aws/v1")
    assert resolved["timeout"] == 42
    assert resolved["http_client"] is sentinel_http_client
    assert resolved["default_headers"] == {"X-Trace-Id": "abc"}


@pytest.mark.asyncio
async def test_bedrock_mantle_config_wraps_token_failures(monkeypatch):
    """
    Test that provide_token failures are wrapped in a RuntimeError with actionable context.
    """
    import strands.models.openai as openai_module
    import strands.models._openai_bedrock as bedrock_module

    async def failing_provide_token(*args, **kwargs):
        raise RuntimeError("no credentials in chain")

    original_provide_token = getattr(bedrock_module, "provide_token", None)
    bedrock_module.provide_token = failing_provide_token

    try:
        model = OpenAIModel(model_id="openai.gpt-oss-120b", bedrock_mantle_config={"region": "us-east-1"})
        with pytest.raises(RuntimeError, match="Bedrock Mantle bearer token.*us-east-1"):
