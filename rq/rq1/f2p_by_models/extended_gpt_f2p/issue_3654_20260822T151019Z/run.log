@pytest.mark.asyncio
async def test_stream_fails_on_wrong_routing(monkeypatch):
    # This test simulates the buggy behavior: the base path is wrong for a model,
    # so the server returns a 400 validation error. We simulate this by raising
    # an exception when the wrong base path is used.

    class DummyBadRequestError(Exception):
        def __init__(self, message):
            super().__init__(message)
            self.code = "validation_error"

    class DummyChatCompletions:
        async def create(self, **kwargs):
            # Simulate a 400 validation error for wrong base path
            raise DummyBadRequestError("model 'xai.grok-4.3' isn't supported on this route")

    class DummyOpenAIClient:
        def __init__(self, base_url):
            self.base_url = base_url
            self.chat = types.SimpleNamespace(completions=DummyChatCompletions())

    def fake_resolve_client_args(self):
        # Force base_url to wrong path to simulate buggy routing
        base_url = "https://bedrock-mantle.us-east-1.api.aws/v1"  # Wrong for xai.grok-4.3
        self._client = DummyOpenAIClient(base_url)
        return {"base_url": base_url, "api_key": "dummy"}

    monkeypatch.setattr(OpenAIModel, "_resolve_client_args", fake_resolve_client_args)

    model = OpenAIModel(model_id="xai.grok-4.3", bedrock_mantle_config={"region": "us-east-1"})
    messages = [{"role": "user", "content": [{"text": "hello"}]}]

    with pytest.raises(DummyBadRequestError):
        async for _ in model.stream(messages):
            pass


@pytest.mark.asyncio
async def test_stream_accepts_vllm_reasoning_delta(monkeypatch):
    # Test that the stream method accepts reasoning deltas and yields expected events

    class DummyDelta:
        def __init__(self, reasoning=None, content=None, tool_calls=None):
            self.reasoning_content = reasoning
            self.content = content
            self.tool_calls = tool_calls

    class DummyChoice:
        def __init__(self, finish_reason, delta):
            self.finish_reason = finish_reason
            self.delta = delta

    class DummyEvent:
        def __init__(self, choices):
            self.choices = choices

    class DummyChatCompletions:
        async def create(self, **kwargs):
            async def gen():
                yield DummyEvent([DummyChoice(None, DummyDelta(reasoning="\nI'm thinking"))])
                yield DummyEvent([DummyChoice("stop", DummyDelta())])
            return gen()

    class DummyOpenAIClient:
        def __init__(self):
            self.chat = types.SimpleNamespace(completions=DummyChatCompletions())

    def fake_resolve_client_args(self):
        self._client = DummyOpenAIClient()
        return {"base_url": "https://bedrock-mantle.us-east-1.api.aws/openai/v1", "api_key": "dummy"}

    monkeypatch.setattr(OpenAIModel, "_resolve_client_args", fake_resolve_client_args)

    model = OpenAIModel(model_id="openai.gpt-5.6-terra", bedrock_mantle_config={"region": "us-east-1"})
    messages = [{"role": "user", "content": [{"text": "hello"}]}]

    events = []
    async for event in model.stream(messages):
        events.append(event)

    # We expect messageStart, contentBlockStart, contentBlockDelta with reasoningContent, contentBlockStop, messageStop
    types_seen = [list(e.keys())[0] for e in events if isinstance(e, dict)]
    assert "messageStart" in types_seen
    assert "contentBlockStart" in types_seen
    assert "contentBlockDelta" in types_seen
    assert "contentBlockStop" in types_seen
    assert "messageStop" in types_seen


@pytest.mark.asyncio
async def test_bedrock_mantle_config_rejects_malformed_region(monkeypatch):
    # Test that malformed regions raise ValueError before token minting

    malformed_regions = ["x@attacker.com:443/#", "us-east-1\n", "us-east-1/"]

