@pytest.mark.asyncio
async def test_bedrock_mantle_config_requires_region(monkeypatch):
    """
    Test that bedrockMantleConfig raises when no region can be resolved from config, session, or env.
    """
    import strands.models.openai as openai_module

    # Patch boto3.Session to return None region_name
    import boto3

    class DummySession:
        region_name = None

    monkeypatch.setattr(boto3, "Session", lambda: DummySession())

    model = OpenAIModel(model_id="openai.gpt-oss-120b", bedrock_mantle_config={})
    with pytest.raises(ValueError, match="Could not resolve an AWS region"):
        model._resolve_client_args()


@pytest.mark.asyncio
async def test_bedrock_mantle_config_region_resolved_from_boto_session(monkeypatch):
    """
    Test that an explicit boto_session supplies the region when region is omitted.
    """
    import strands.models.openai as openai_module

    class DummySession:
        region_name = "ap-southeast-2"

    session = DummySession()
    model = OpenAIModel(
        model_id="openai.gpt-oss-120b",
