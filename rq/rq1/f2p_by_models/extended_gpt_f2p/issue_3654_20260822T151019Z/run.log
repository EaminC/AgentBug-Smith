[32mimport asyncio
import pytest
import strands
from strands.models.openai import OpenAIModel


@pytest.mark.asyncio
async def test_bedrock_mantle_routing_for_third_party_models():
    """
    Test that OpenAIModel with bedrockMantleConfig routes third-party models
    (e.g., xai.grok-4.3, google.gemma-4-31b) to the correct Mantle base path (/openai/v1)
    instead of the incorrect /v1 path.

    This test covers the routing bug #3654:
    - Before the fix, these models route to /v1 and cause a 400 validation error.
    - After the fix, they route to /openai/v1 and the request is accepted by the Mantle service.

    The test mocks the internal OpenAI client to avoid real network calls but
    verifies the resolved base_url used by the client.
    """
    # List of test cases: model_id and expected base path suffix
    test_cases = [
        ("xai.grok-4.3", "/openai/v1"),
        ("google.gemma-4-31b", "/openai/v1"),
        ("google.gemma-4-26b-a4b", "/openai/v1"),
        ("openai.gpt-5.6-terra", "/openai/v1"),
        ("google.gemma-3-27b-it", "/v1"),
        ("openai.gpt-oss-120b", "/v1"),
        ("qwen.qwen3-32b", "/v1"),
        ("deepseek.v3.2", "/v1"),
    ]

    for model_id, expected_path in test_cases:
        model = OpenAIModel(model_id=model_id, bedrock_mantle_config={"region": "us-east-1"})

        resolved_args = model._resolve_client_args()
        base_url = resolved_args.get("base_url")
        assert base_url is not None, f"base_url is None for model_id={model_id}"
        assert base_url.endswith(expected_path), (
            f"Model {model_id} routed to {base_url}, expected to end with {expected_path}"
        )


@pytest.mark.asyncio
async def test_stream_invocation_with_bedrock_mantle_config(monkeypatch):
    """
    Test that streaming a request with bedrockMantleConfig routes correctly and
    that the internal client is called with the expected base_url.

    This test mocks the openai AsyncOpenAI client to verify the base_url and api_key
    are set correctly and that the stream method produces expected events.
    """
    import strands.models.openai as openai_module

    # Patch the AsyncOpenAI to a dummy class that records init args and returns async iterator
    class DummyAsyncOpenAI:
        def __init__(self, **kwargs):
            self.init_kwargs = kwargs
            self.chat = self.Chat(self)

        class Chat:
            def __init__(self, outer):
                self.outer = outer

            async def completions_create(self, **kwargs):
                # Return an async generator of dummy events
                async def gen():
                    yield {"messageStart": {"role": "assistant"}}
                    yield {"contentBlockStart": {"start": {}}}
                    yield {"contentBlockDelta": {"delta": {"text": "hello"}}}
                    yield {"contentBlockStop": {}}
                    yield {"messageStop": {"stopReason": "end_turn"}}

                return gen()

            # The real method name is completions.create; we patch __getattr__ to allow that
            def __getattr__(self, name):
                if name == "create":
                    return self.completions_create
                raise AttributeError(name)

        async def __aenter__(self):
            return self

        async def __aexit__(self, exc_type, exc, tb):
            pass

    # Patch the AsyncOpenAI class in strands.models.openai.openai
    monkeypatch.setattr(openai_module.openai, "AsyncOpenAI", lambda **kwargs: DummyAsyncOpenAI(**kwargs))

    # Create model with bedrockMantleConfig for a third-party model
    model_id = "xai.grok-4.3"
    model = OpenAIModel(model_id=model_id, bedrock_mantle_config={"region": "us-east-1"})

    # The resolved client args should have base_url ending with /openai/v1
    resolved_args = model._resolve_client_args()
    base_url = resolved_args.get("base_url")
    assert base_url is not None
    assert base_url.endswith("/openai/v1")

    # Call stream and collect events
    messages = [{"role": "user", "content": [{"text": "hello"}]}]
    events = []
    async for event in model.stream(messages):
        events.append(event)

    # Check that events include messageStart and messageStop
    roles = [e.get("messageStart", {}).get("role") or e.get("messageStop", {}).get("stopReason") for e in events]
    assert "assistant" in roles
    assert any(r in ("end_turn", "max_tokens", "stop") for r in roles)

    # Check that the dummy client was initialized with the correct base_url
    dummy_client = model._client
    assert hasattr(dummy_client, "init_kwargs")
    assert dummy_client.init_kwargs.get("base_url") == base_url


@pytest.mark.asyncio
async def test_bedrock_mantle_config_rejects_custom_base_url(monkeypatch):
    """
    Test that providing both bedrockMantleConfig and client_args with base_url raises ValueError.
    """
    # Patch AsyncOpenAI to dummy to avoid real network calls
