    @pytest.mark.asyncio
    async def test_bedrock_mantle_routing_for_third_party_models():
        """
        Test that OpenAIModel with bedrockMantleConfig routes third-party models
        (e.g., xai.grok-4.3, google.gemma-4-31b) to the correct Mantle base path (/openai/v1)
        instead of the incorrect /v1 path.
    
        This test covers the routing bug #3654:
        - Before the fix, these models route to /v1 and cause a 400 validation error.
        - After the fix, they route to /openai/v1 and the request is accepted by the Mantle service.
    
        The test mocks the internal OpenAI client to avoid real network calls but
        verifies the resolved base_url used by the client.
        """
