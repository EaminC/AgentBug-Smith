[32mimport pytest
import strands.models.openai as openai_mod
from strands.models.openai import OpenAIModel

# This test file targets the Bedrock Mantle base-path routing bug #3654.
# The bug causes third-party models like xai.grok-4.3 and google.gemma-4-31b
# to be routed to the wrong base path (/v1 instead of /openai/v1), causing
# a 400 validation error from the service.
#
# The fix is to extend the prefix list that determines the base path.
#
# This test verifies that the model's resolved base_url matches the expected
# base path for a set of known model ids, including third-party models.
#
# On the buggy codebase, this test should fail due to misrouting.
# After applying the fix, it should pass.

@pytest.mark.parametrize(
    ("model_id", "expected_path"),
    [
        # Models that must route to /openai/v1 (third-party and openai.gpt-5.*)
        ("xai.grok-4.3", "/openai/v1"),
        ("google.gemma-4-31b", "/openai/v1"),
        ("google.gemma-4-26b-a4b", "/openai/v1"),
        ("google.gemma-4-e2b", "/openai/v1"),
        ("openai.gpt-5.6-terra", "/openai/v1"),
        # Models that must route to /v1 (controls)
        ("google.gemma-3-27b-it", "/v1"),
        ("google.gemma-3-4b-it", "/v1"),
        ("openai.gpt-oss-120b", "/v1"),
        ("openai.gpt-oss-safeguard-20b", "/v1"),
        ("qwen.qwen3-32b", "/v1"),
        ("deepseek.v3.2", "/v1"),
        ("mistral.ministral-3-8b-instruct", "/v1"),
        ("zai.glm-5", "/v1"),
        ("moonshotai.kimi-k2.5", "/v1"),
        ("minimax.minimax-m2", "/v1"),
        ("nvidia.nemotron-nano-9b-v2", "/v1"),
        ("writer.palmyra-vision-7b", "/v1"),
    ],
)
def test_bedrock_mantle_routing_for_third_party_models(model_id, expected_path, openai_client, monkeypatch):
    # Patch the aws_bedrock_token_generator.provide_token to avoid ImportError and token minting
    # since the package may not be installed in the test environment.
    # We patch it to a dummy function that returns a fixed token string.
    import strands.models._openai_bedrock as bedrock_mod

    def dummy_provide_token(*args, **kwargs):
        return "dummy-bedrock-token"

    monkeypatch.setattr(bedrock_mod, "provide_token", dummy_provide_token)

    # Create the model with bedrock_mantle_config specifying region
    model = OpenAIModel(model_id=model_id, bedrock_mantle_config={"region": "us-east-1"})

    # Resolve client args to get the base_url
    resolved = model._resolve_client_args()

    # Assert the base_url ends with the expected path
    base_url = resolved.get("base_url", "")
    assert base_url.endswith(expected_path), (
        f"Model id '{model_id}' resolved to base_url '{base_url}', expected to end with '{expected_path}'"
    )


@pytest.mark.asyncio
async def test_bedrock_mantle_config_mints_token_per_request(monkeypatch):
    import strands.models._openai_bedrock as bedrock_mod

    call_count = {"count": 0}

    async def dummy_provide_token(*args, **kwargs):
        call_count["count"] += 1
        return "dummy-token"

    monkeypatch.setattr(bedrock_mod, "provide_token", dummy_provide_token)

    model = OpenAIModel(model_id="openai.gpt-oss-120b", bedrock_mantle_config={"region": "us-east-1"})

    # Call _resolve_client_args multiple times and verify token minting is called each time
    for _ in range(3):
        resolved = model._resolve_client_args()
        assert resolved["api_key"] == "dummy-token"

    assert call_count["count"] == 3


def test_bedrock_mantle_config_region_resolved_from_boto_session(monkeypatch):
    import strands.models._openai_bedrock as bedrock_mod

    def dummy_provide_token(*args, **kwargs):
        return "dummy-token"

    monkeypatch.setattr(bedrock_mod, "provide_token", dummy_provide_token)

    class DummySession:
        region_name = "ap-southeast-2"

    session = DummySession()

    model = OpenAIModel(
        model_id="openai.gpt-oss-120b",
        bedrock_mantle_config={"boto_session": session},
    )

    resolved = model._resolve_client_args()

    assert resolved["base_url"].startswith("https://bedrock-mantle.ap-southeast-2.api.aws")


def test_bedrock_mantle_config_explicit_region_wins_over_boto_session(monkeypatch):
    import strands.models._openai_bedrock as bedrock_mod

    def dummy_provide_token(*args, **kwargs):
        return "dummy-token"

    monkeypatch.setattr(bedrock_mod, "provide_token", dummy_provide_token)

    class DummySession:
        region_name = "ap-southeast-2"

    session = DummySession()

    model = OpenAIModel(
        model_id="openai.gpt-oss-120b",
        bedrock_mantle_config={"region": "us-east-1", "boto_session": session},
    )

    resolved = model._resolve_client_args()

    assert resolved["base_url"].startswith("https://bedrock-mantle.us-east-1.api.aws")


@pytest.mark.asyncio
async def test_bedrock_mantle_config_merges_with_client_args(monkeypatch):
    import strands.models._openai_bedrock as bedrock_mod

    def dummy_provide_token(*args, **kwargs):
        return "dummy-token"

    monkeypatch.setattr(bedrock_mod, "provide_token", dummy_provide_token)

    sentinel_http_client = object()

    model = OpenAIModel(
        model_id="openai.gpt-oss-120b",
        client_args={
            "timeout": 42,
            "http_client": sentinel_http_client,
            "default_headers": {"X-Trace-Id": "abc"},
        },
        bedrock_mantle_config={"region": "us-east-1"},
    )

    resolved = model._resolve_client_args()

    assert resolved["base_url"].startswith("https://bedrock-mantle.us-east-1.api.aws")
    assert resolved["api_key"] == "dummy-token"
    assert resolved["timeout"] == 42
    assert resolved["http_client"] is sentinel_http_client
    assert resolved["default_headers"] == {"X-Trace-Id": "abc"}


