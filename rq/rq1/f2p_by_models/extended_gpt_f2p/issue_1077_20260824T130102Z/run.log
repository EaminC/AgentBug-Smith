@pytest.mark.parametrize("processing_mode", ["sync", "async"])
def test_agent_guardrail_redaction_preserves_tool_result_blocks(bedrock_guardrail, processing_mode):
    INPUT_REDACT_MESSAGE = "Input redacted."
    OUTPUT_REDACT_MESSAGE = "Output redacted."

    bedrock_model = BedrockModel(
        guardrail_id=bedrock_guardrail,
        guardrail_version="DRAFT",
        guardrail_stream_processing_mode=processing_mode,
        guardrail_redact_output=True,
        guardrail_redact_input_message=INPUT_REDACT_MESSAGE,
        guardrail_redact_output_message=OUTPUT_REDACT_MESSAGE,
        region_name="us-east-1",
    )

    @tool
    def list_users() -> str:
        "List my users"
        return """|Name|Email|
|Jerry Barry|jerry@gmail.com|
|CACTUS|cactus@email.com|
"""

    agent = Agent(
        model=bedrock_model,
        system_prompt="You are a helpful assistant.",
        callback_handler=None,
        load_tools_from_directory=False,
        tools=[list_users],
    )

    # First call triggers guardrail on output (because of "CACTUS" in tool output)
    response1 = agent("Who are my users?")
    # Second call normal conversation
    response2 = agent("Hello")

    # The first response should be interrupted by guardrail
    assert response1.stop_reason == "guardrail_intervened"

    # The second response should NOT be interrupted by guardrail
    assert response2.stop_reason != "guardrail_intervened"

    # In sync mode, the output redaction message should be present in the first response text
    if processing_mode == "sync":
        assert OUTPUT_REDACT_MESSAGE in str(response1)
        assert OUTPUT_REDACT_MESSAGE not in str(response2)

    # The toolUse message and toolResult message must be consistent and not redacted incorrectly
    # Find the toolUse block in assistant message (index 1)
    tool_use_blocks = [b for b in agent.messages[1]["content"] if "toolUse" in b]
    assert len(tool_use_blocks) == 1
    tool_use = tool_use_blocks[0]["toolUse"]

    # Find the toolResult block in user message (index 2)
    tool_result_blocks = [b for b in agent.messages[2]["content"] if "toolResult" in b]
    assert len(tool_result_blocks) == 1
    tool_result = tool_result_blocks[0]["toolResult"]

    # toolUseId must match
    assert tool_result["toolUseId"] == tool_use["toolUseId"]

    # The toolResult content text should be redacted with the input redact message, not fully redacted text block
    assert tool_result["content"][0]["text"] == INPUT_REDACT_MESSAGE


