WORKDIR /app

COPY . .

# Detect src/ layout or imports from src. in tests or main code to decide PYTHONPATH usage and install method
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." . 2>/dev/null; then \
        echo "src layout detected or src imports found, setting PYTHONPATH and installing dependencies only"; \
        python -m pip install --upgrade pip setuptools wheel; \
        python -m pip install -r requirements.txt 2>/dev/null || true; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai "langchain<0.1.0" "langchain-community<0.1.0"; \
        echo "Skipping editable install due to src layout"; \
    else \
        echo "No src layout detected, performing editable install"; \
        python -m pip install --upgrade pip setuptools wheel; \
        python -m pip install -r requirements.txt 2>/dev/null || true; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai "langchain<0.1.0" "langchain-community<0.1.0"; \
    fi

# If src layout or src imports detected, set PYTHONPATH to avoid import duplication issues in tests
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." . 2>/dev/null; then \
        echo "export PYTHONPATH=/app" >> /etc/profile.d/pythonpath.sh; \
    fi

# Preflight import check to fail fast if core modules missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Assumption: Entry point script is src/my_project/main.py as per repository evidence
CMD ["/bin/bash"][0m
