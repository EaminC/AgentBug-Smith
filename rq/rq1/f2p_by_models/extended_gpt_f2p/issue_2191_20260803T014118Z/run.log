from crewai.llm import CONTEXT_WINDOW_USAGE_RATIO, LLM


def test_o3_mini_context_window_size():
    """Test that the o3-mini model has the correct context window size."""
    llm = LLM(model="o3-mini")
    # The context window size returned should be 75% of 200000 (the fixed value)
    expected_size = int(200000 * CONTEXT_WINDOW_USAGE_RATIO)
    actual_size = llm.get_context_window_size()
    assert actual_size == expected_size, (
        f"Expected context window size {expected_size} for o3-mini, got {actual_size}"
    )


def test_context_window_size_validation():
    """Test that invalid context window sizes raise ValueError."""
    # Patch the LLM_CONTEXT_WINDOW_SIZES dict to include an invalid size below minimum
    from crewai import llm as crew_llm
