# Detect if src/ directory exists or tests import src.* to decide PYTHONPATH and editable install
RUN set -eux; \
    if [ -d "src" ] || grep -RqE "^\s*(from|import) src\." tests 2>/dev/null; then \
        export PYTHONPATH=/app; \
        python -m pip install --upgrade pip setuptools wheel; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout fakeredis apscheduler fastapi aiofiles aioredis; \
