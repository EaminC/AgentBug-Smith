            found_text = True
            break
    assert found_text

    # Second call: agent should be reusable and produce a normal response
    stream2 = event_loop_cycle(agent=agent, invocation_state={})
    collected_texts = []
    async for event in stream2:
        # event is a dict with keys including "stop" for the final event
        if "contentBlockDelta" in event:
            delta = event["contentBlockDelta"]
            if "delta" in delta and "text" in delta["delta"]:
                collected_texts.append(delta["delta"]["text"])
        elif "stop" in event:
            stop_reason, message, *_ = event["stop"]
            # On stop, message should contain the full text response
            if stop_reason == "end_turn":
                # The message content should include the text from the stream
                content_texts = []
                for c in message.get("content", []):
                    if "text" in c:
                        content_texts.append(c["text"])
                # The text should match the collected texts from deltas
                assert "response after max tokens" in content_texts or "response after max tokens" in collected_texts
                break

    # If we reached here, the agent was reusable and produced a valid response after the exception


