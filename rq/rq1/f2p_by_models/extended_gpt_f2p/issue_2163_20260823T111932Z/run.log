    agent = Agent.__new__(Agent)
    # Setup minimal required attributes
    agent.messages = [{"role": "user", "content": [{"text": "Hello"}]}]
    agent.system_prompt = "system prompt"
    agent._system_prompt_content = None
    agent.tool_registry = None
    agent.thread_pool = threading.Thread()  # dummy thread object, not used here
    agent.event_loop_metrics = None
    agent.hooks = None
    agent.tool_executor = None
    agent._interrupt_state = None
    agent._cancel_signal = threading.Event()
    agent._model_state = {}
    agent._middleware_registry = None
    agent._checkpointing = False
    agent._checkpoint = None
    agent._checkpoint_cycle_index = 0
    agent._checkpoint_resume_position = None
    agent.trace_attributes = {}
    agent.retry_strategy = None

    # Define a mock model with a stream method that first yields a max_tokens stop, then normal text response
    class MockModel:
        def __init__(self):
            self.call_count = 0

        async def _stream_max_tokens(self):
            # Simulate a stream yielding a partial tool use and then a max_tokens stop
            yield {
                "contentBlockStart": {
                    "start": {
                        "toolUse": {
                            "toolUseId": "t1",
                            "name": "mock_tool",
                            "input": {},
                        }
                    }
                }
            }
            yield {"contentBlockStop": {}}
            yield {"messageStop": {"stopReason": "max_tokens"}}

        async def _stream_normal(self):
            # Simulate a normal text response stream
            yield {"contentBlockDelta": {"delta": {"text": "response after max tokens"}}}
            yield {"contentBlockStop": {}}

        def stream(self, *args, **kwargs):
            self.call_count += 1
            if self.call_count == 1:
                return self._stream_max_tokens()
            else:
                return self._stream_normal()

    agent.model = MockModel()

    # First call: expect MaxTokensReachedException with updated message (no "unrecoverable state")
