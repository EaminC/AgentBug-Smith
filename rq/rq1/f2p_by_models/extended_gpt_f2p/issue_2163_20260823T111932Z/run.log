[32mimport asyncio
import threading
import pytest
from strands import Agent
from strands.event_loop.event_loop import event_loop_cycle
from strands.types.exceptions import MaxTokensReachedException


@pytest.mark.asyncio
async def test_agent_reusable_after_max_tokens_reached():
    """
    This test verifies that after a MaxTokensReachedException is raised due to hitting the max_tokens limit,
    the same agent instance can be reused for a subsequent call without needing a full reset.

    Expected behavior after fix:
    - The exception message should NOT mention "unrecoverable state".
    - The agent.messages should contain the partial message.
    - The agent instance should be reusable for a new prompt invocation.
    """

    # Create a minimal Agent instance with required attributes
    agent = Agent.__new__(Agent)
    agent.messages = [{"role": "user", "content": [{"text": "Hello"}]}]
    agent.system_prompt = "p1"
    agent._system_prompt_content = None
    agent.tool_registry = None
    agent.thread_pool = None
    agent.event_loop_metrics = None
    agent.hooks = None
    agent.tool_executor = None
    agent._interrupt_state = None
    agent._cancel_signal = threading.Event()
    agent._model_state = {}
    agent._middleware_registry = None
    agent._checkpointing = False
    agent._checkpoint = None
    agent._checkpoint_cycle_index = 0
    agent._checkpoint_resume_position = None
    agent.trace_attributes = {}
    agent.retry_strategy = None
    agent.model = None

    # We mock the model.stream method to simulate max_tokens stop reason
    # We create an async generator that yields a partial tool use and then a messageStop with stopReason max_tokens
    async def partial_stream():
        yield {
            "contentBlockStart": {
                "start": {
                    "toolUse": {
                        "toolUseId": "t1",
                        "name": "dummy_tool",
                        "input": {},
                    }
                }
            }
        }
        yield {"contentBlockStop": {}}
        yield {"messageStop": {"stopReason": "max_tokens"}}

    class DummyModel:
        def __init__(self):
            self.stream_called = 0

        def stream(self, *args, **kwargs):
            self.stream_called += 1
            return partial_stream()

    dummy_model = DummyModel()
    agent.model = dummy_model

    # First call: expect MaxTokensReachedException with updated message (no "unrecoverable state")
    with pytest.raises(MaxTokensReachedException) as excinfo:
        stream = event_loop_cycle(agent=agent, invocation_state={})
        # Consume the async generator fully to raise the exception
        async for _ in stream:
            pass

    exc_msg = str(excinfo.value)
    assert "unrecoverable state" not in exc_msg
    assert "max_tokens" in exc_msg or "maximum token limit" in exc_msg

    # The partial message should be appended to agent.messages
    assert len(agent.messages) >= 2
    # The last message content should mention partial or incomplete tool use or partial message
    last_msg_content = agent.messages[-1]["content"][0]["text"]
    assert "partial" in last_msg_content.lower() or "incomplete" in last_msg_content.lower()

    # Second call: reuse the same agent instance with a new prompt, expect no exception and normal end_turn stop reason
    # We simulate a normal successful stream that returns a text response and then stops
    async def normal_stream():
        yield {"contentBlockDelta": {"delta": {"text": "Hello again"}}}
        yield {"contentBlockStop": {}}
        yield {"messageStop": {"stopReason": "end_turn"}}

    dummy_model.stream = lambda *args, **kwargs: normal_stream()

    # Add a new user message to agent.messages to simulate new prompt
    agent.messages.append({"role": "user", "content": [{"text": "Second prompt"}]})

    # Run event_loop_cycle again, should complete without exception
    stream = event_loop_cycle(agent=agent, invocation_state={})
    stop_reasons = []
    async for event in stream:
        if "stop" in event:
            stop_reason = event["stop"][0]
            stop_reasons.append(stop_reason)

    # The last stop reason should be "end_turn"
    assert stop_reasons[-1] == "end_turn"


@pytest.mark.asyncio
async def test_max_tokens_exception_message_update():
    """
    This test verifies that the MaxTokensReachedException message is updated to remove
    the phrase "unrecoverable state" and contains the new expected message after the fix.
    """

    # Create a minimal Agent instance with required attributes
    agent = Agent.__new__(Agent)
    agent.messages = [{"role": "user", "content": [{"text": "Hello"}]}]
    agent.system_prompt = "p1"
    agent._system_prompt_content = None
    agent.tool_registry = None
    agent.thread_pool = None
    agent.event_loop_metrics = None
    agent.hooks = None
    agent.tool_executor = None
    agent._interrupt_state = None
    agent._cancel_signal = threading.Event()
    agent._model_state = {}
    agent._middleware_registry = None
    agent._checkpointing = False
    agent._checkpoint = None
    agent._checkpoint_cycle_index = 0
    agent._checkpoint_resume_position = None
    agent.trace_attributes = {}
    agent.retry_strategy = None
    agent.model = None

    # Mock model.stream to yield max_tokens stop reason
    async def partial_stream():
        yield {
            "contentBlockStart": {
                "start": {
                    "toolUse": {
                        "toolUseId": "t1",
                        "name": "dummy_tool",
                        "input": {},
                    }
                }
            }
        }
        yield {"contentBlockStop": {}}
        yield {"messageStop": {"stopReason": "max_tokens"}}

    class DummyModel:
        def stream(self, *args, **kwargs):
            return partial_stream()

    agent.model = DummyModel()

    expected_message_start = (
        "Model stopped generating due to maximum token limit."
    )

    with pytest.raises(MaxTokensReachedException) as excinfo:
        stream = event_loop_cycle(agent=agent, invocation_state={})
        async for _ in stream:
            pass

    exc_msg = str(excinfo.value)
    assert exc_msg.startswith(expected_message_start)
    assert "unrecoverable state" not in exc_msg


