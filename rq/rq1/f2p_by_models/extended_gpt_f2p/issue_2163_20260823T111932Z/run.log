@pytest.mark.asyncio
async def test_agent_reuse_after_max_tokens_exception():
    """
    This test verifies that after the agent raises MaxTokensReachedException due to hitting the max_tokens limit,
    the same agent instance can be reused for subsequent calls without reinitialization.

    Before the fix:
        - The exception message contains "unrecoverable state"
        - The agent instance is not reusable and subsequent calls fail or raise errors.

    After the fix:
        - The exception message no longer contains "unrecoverable state"
        - The agent instance can be called again successfully and produces expected output.
    """
