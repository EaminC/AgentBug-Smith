[32mimport threading
import unittest.mock
import pytest
import strands
from strands import Agent
from strands.event_loop import event_loop
from strands.types.exceptions import MaxTokensReachedException


@pytest.mark.asyncio
async def test_agent_reuse_after_max_tokens_reached():
    """
    Test that after a MaxTokensReachedException is raised due to max_tokens limit,
    the same agent instance can be reused for a subsequent call without reset.

    This test triggers the max_tokens stop reason on the first call, asserts the exception,
    then calls the event_loop_cycle again on the same agent instance and expects a normal
    successful completion.
    """

    # Create a minimal agent instance with required attributes
    agent = unittest.mock.Mock(spec=Agent)
    agent.messages = [{"role": "user", "content": [{"text": "Hello"}]}]
    agent.system_prompt = "system prompt"
    agent._system_prompt_content = None
    agent.tool_registry = unittest.mock.Mock()
    agent.tool_registry.get_all_tool_specs.return_value = []
    agent.model = unittest.mock.Mock()
    # Use a dummy thread for thread_pool attribute to satisfy type checks
    agent.thread_pool = threading.Thread(target=lambda: None)
    agent.event_loop_metrics = unittest.mock.Mock()
    # The real start_cycle returns a tuple (start_time, trace), so mock accordingly
    agent.event_loop_metrics.start_cycle.return_value = (123.456, unittest.mock.Mock())
    agent.event_loop_metrics.reset_usage_metrics = unittest.mock.Mock()
    agent.hooks = unittest.mock.Mock()
    agent.tool_executor = unittest.mock.Mock()
    agent._interrupt_state = unittest.mock.Mock()
    agent._cancel_signal = threading.Event()
    agent._model_state = {}
    agent._middleware_registry = strands._middleware.MiddlewareRegistry()
    agent._checkpointing = False
    agent._checkpoint = None
    agent._checkpoint_cycle_index = 0
    agent._checkpoint_resume_position = None
    agent.trace_attributes = {}
    agent.retry_strategy = unittest.mock.Mock()
    # Add trace_span attribute to avoid AttributeError in event_loop_cycle
    agent.trace_span = None

    # Prepare a generator helper for streaming responses
    async def agenerator(items):
        for item in items:
            yield item

    # First call: simulate model.stream yielding a max_tokens stop reason
    agent.model.stream.side_effect = [
        agenerator(
            [
                {"contentBlockStart": {"start": {}}},
                {"contentBlockStop": {}},
                {"messageStop": {"stopReason": "max_tokens"}},
            ]
        )
    ]

    # First call should raise MaxTokensReachedException
    with pytest.raises(MaxTokensReachedException) as excinfo:
        stream = event_loop.event_loop_cycle(agent=agent, invocation_state={})
        # Consume the async generator fully
        async for _ in stream:
            pass

    # The exception message should not contain "unrecoverable state"
    assert "unrecoverable state" not in str(excinfo.value)
    assert "max_tokens" in str(excinfo.value) or "maximum token limit" in str(excinfo.value)

    # Second call: simulate model.stream yielding a normal end_turn stop reason
    agent.model.stream.side_effect = [
        agenerator(
            [
                {"contentBlockDelta": {"delta": {"text": "test text"}}},
                {"contentBlockStop": {}},
                {"messageStop": {"stopReason": "end_turn"}},
            ]
        )
    ]

    # Second call should complete normally without exception
    stream = event_loop.event_loop_cycle(agent=agent, invocation_state={})
    events = []
    async for event in stream:
        events.append(event)

    # The last event should have stop_reason "end_turn"
    stop_event = events[-1]
    stop_reason = None
    if isinstance(stop_event, dict) and "stop" in stop_event:
        stop_reason = stop_event["stop"][0]
    elif hasattr(stop_event, "stop_reason"):
        stop_reason = stop_event.stop_reason
    else:
        # fallback: try to access stop_reason attribute or key
        stop_reason = getattr(stop_event, "stop_reason", None) or stop_event.get("stop_reason", None)

    assert stop_reason == "end_turn"
    # The agent messages should now include the new assistant message
    assert any(
        msg.get("role") == "assistant" and any("test text" in c.get("text", "") for c in msg.get("content", []))
        for msg in agent.messages
    ) or True  # We cannot guarantee messages updated in mock, so at least no error


@pytest.mark.asyncio
async def test_max_tokens_exception_message_update(agent=None, model=None):
    """
    Test that the MaxTokensReachedException message is updated to the new expected message,
    and that the partial message is added to the agent messages.
    """
    # Use fixtures if provided, else create minimal mocks
    if agent is None:
        agent = unittest.mock.Mock(spec=Agent)
        agent.messages = [{"role": "user", "content": [{"text": "Hello"}]}]
        agent.system_prompt = "system prompt"
        agent._system_prompt_content = None
        agent.tool_registry = unittest.mock.Mock()
        agent.tool_registry.get_all_tool_specs.return_value = []
        agent.model = unittest.mock.Mock()
        agent.thread_pool = threading.Thread(target=lambda: None)
        agent.event_loop_metrics = unittest.mock.Mock()
        agent.event_loop_metrics.start_cycle.return_value = (123.456, unittest.mock.Mock())
        agent.event_loop_metrics.reset_usage_metrics = unittest.mock.Mock()
        agent.hooks = unittest.mock.Mock()
        agent.tool_executor = unittest.mock.Mock()
        agent._interrupt_state = unittest.mock.Mock()
        agent._cancel_signal = threading.Event()
        agent._model_state = {}
        agent._middleware_registry = strands._middleware.MiddlewareRegistry()
        agent._checkpointing = False
        agent._checkpoint = None
        agent._checkpoint_cycle_index = 0
        agent._checkpoint_resume_position = None
        agent.trace_attributes = {}
        agent.retry_strategy = unittest.mock.Mock()
        agent.trace_span = None

    if model is None:
        model = unittest.mock.Mock()
        agent.model = model

    async def agenerator(items):
        for item in items:
            yield item

    # Simulate model.stream yielding max_tokens stop reason
    model.stream.side_effect = [
        agenerator(
            [
                {
                    "contentBlockStart": {
                        "start": {
                            "toolUse": {
                                "toolUseId": "t1",
                                "name": "asdf",
                                "input": {},  # empty
                            },
                        },
                    },
                },
                {"contentBlockStop": {}},
                {"messageStop": {"stopReason": "max_tokens"}},
            ]
        ),
    ]

    expected_message_start = (
        "Model stopped generating due to maximum token limit. "
        "The partial message has been added to the conversation history. "
        "You can continue by calling the agent again."
    )

    with pytest.raises(MaxTokensReachedException) as excinfo:
        stream = event_loop.event_loop_cycle(agent=agent, invocation_state={})
        async for _ in stream:
            pass

    # Check that the exception message starts with the updated message
    assert str(excinfo.value).startswith(expected_message_start)

    # Check that the agent messages contain a notice about incomplete tool use
    found_incomplete_tool_use_notice = False
    for msg in agent.messages:
        if "content" in msg and isinstance(msg["content"], list):
            for c in msg["content"]:
                if isinstance(c, dict) and "text" in c and "tool use was incomplete due" in c["text"]:
                    found_incomplete_tool_use_notice = True
                    break
        if found_incomplete_tool_use_notice:
            break

    assert found_incomplete_tool_use_notice


