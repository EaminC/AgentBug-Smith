[32mimport asyncio
import threading
import uuid

import pytest

import strands
from strands.agent.agent import Agent
from strands.event_loop.event_loop import event_loop_cycle
from strands.telemetry.metrics import EventLoopMetrics
from strands.types.exceptions import MaxTokensReachedException


@pytest.mark.asyncio
async def test_agent_reuse_after_max_tokens_exception():
    """
    Test that an agent instance can be reused after a MaxTokensReachedException is raised,
    without needing to reset the agent. The exception message should reflect the new
    recoverable message, and the agent should produce valid output on subsequent calls.
    """

    # Create a real Agent instance with minimal setup
    agent = Agent()
    # Initialize required attributes for event_loop_cycle to work
    agent.messages = [{"role": "user", "content": [{"text": "Hello"}]}]
    agent.system_prompt = "system prompt"
    agent._system_prompt_content = None
    agent.tool_registry = strands.tools.registry.ToolRegistry()
    agent.thread_pool = threading.Thread()
    agent.event_loop_metrics = EventLoopMetrics()
    agent.hooks = strands.hooks.HookRegistry()
    agent.tool_executor = strands.tools.executors.SequentialToolExecutor()
    agent._interrupt_state = strands.types._interrupt._InterruptState()
    agent._cancel_signal = threading.Event()
    agent._model_state = {}
    agent._middleware_registry = strands._middleware.MiddlewareRegistry()
    agent._checkpointing = False
    agent._checkpoint = None
    agent._checkpoint_cycle_index = 0
    agent._checkpoint_resume_position = None
    agent.trace_attributes = {}
    agent.retry_strategy = strands.event_loop._retry.ModelRetryStrategy()

    # Define a mock model that simulates max_tokens stop reason on first call,
    # then normal text response on second call.
    class MockModel:
        def __init__(self):
            self.call_count = 0

        async def _stream_max_tokens(self):
            yield {
                "contentBlockStart": {
                    "start": {
                        "toolUse": {
                            "toolUseId": "t1",
                            "name": "mock_tool",
                            "input": {},
                        }
                    }
                }
            }
            yield {"contentBlockStop": {}}
            yield {"messageStop": {"stopReason": "max_tokens"}}

        async def _stream_normal(self):
            yield {"contentBlockDelta": {"delta": {"text": "normal response"}}}
            yield {"contentBlockStop": {}}

        def stream(self, *args, **kwargs):
            self.call_count += 1
            if self.call_count == 1:
                return self._stream_max_tokens()
            else:
                return self._stream_normal()

    agent.model = MockModel()

    # First call: expect MaxTokensReachedException
    with pytest.raises(MaxTokensReachedException) as excinfo:
        stream = event_loop_cycle(agent=agent, invocation_state={})
        async for _ in stream:
            pass
    # Check that the exception message contains the new recoverable text (not "unrecoverable")
    assert "maximum token limit" in str(excinfo.value)
    assert "unrecoverable" not in str(excinfo.value)

    # Agent messages should include the partial message from the max_tokens cycle
    assert len(agent.messages) >= 2
    # The second message content should mention incomplete tool use or partial message
    content_text = agent.messages[1]["content"][0].get("text", "")
    assert "incomplete" in content_text or "partial" in content_text or len(content_text) > 0

    # Second call: should succeed normally without exception
    stream = event_loop_cycle(agent=agent, invocation_state={})
    last_event = None
    async for event in stream:
        last_event = event
    # The last event stop reason should be "end_turn"
    stop_reason = last_event["stop"][0]
    assert stop_reason == "end_turn"
    # The last message content should include the normal response text
    last_message = last_event["stop"][1]
    found_text = False
    for block in last_message.get("content", []):
        if "text" in block and "normal response" in block["text"]:
            found_text = True
            break
    assert found_text


@pytest.mark.asyncio
async def test_agent_reuse_multiple_times_after_max_tokens_exception():
    """
    Test that the same agent instance can be called multiple times, alternating between
    max_tokens exception and normal response, without resetting the agent.
    """

    agent = Agent()
    agent.messages = [{"role": "user", "content": [{"text": "Hello"}]}]
    agent.system_prompt = "system prompt"
