import pytest

from strands.agent.agent import Agent
from strands.event_loop.event_loop import event_loop_cycle
from strands.types.exceptions import MaxTokensReachedException


@pytest.mark.asyncio
async def test_agent_reuse_after_max_tokens_reached():
    """
    Test that an Agent instance can be reused after a MaxTokensReachedException is raised.

    Steps:
    1. Create a mock model that yields a max_tokens stop reason on the first call.
    2. On the second call, yield a normal text response.
    3. Create an Agent instance with this mock model and minimal required attributes.
    4. Call event_loop_cycle once and expect MaxTokensReachedException.
    5. Call event_loop_cycle again on the same agent instance and expect a normal successful response.
    6. Assert that the second call succeeds and returns expected output.

    This test fails on the buggy codebase because the agent instance is not reusable after
    MaxTokensReachedException, causing an error or unrecoverable state.
    After the fix, the agent instance can be reused without reset.
    """

    class MockModel:
        def __init__(self):
            self.call_count = 0

        async def stream(self, *args, **kwargs):
            self.call_count += 1
            if self.call_count == 1:
                # First call simulates max_tokens stop reason
                yield {
                    "contentBlockStart": {
                        "start": {
                            "toolUse": {
                                "toolUseId": "t1",
                                "name": "mock_tool",
                                "input": {},
                            }
                        }
                    }
                }
                yield {"contentBlockStop": {}}
                yield {"messageStop": {"stopReason": "max_tokens"}}
            else:
                # Second call returns a normal text response
                yield {"contentBlockDelta": {"delta": {"text": "hello again"}}}
                yield {"contentBlockStop": {}}

        async def count_tokens(self, *args, **kwargs):
            return 10

    # Create a minimal Agent instance with the mock model
    agent = Agent.__new__(Agent)  # bypass __init__
    agent.model = MockModel()
    agent.messages = [{"role": "user", "content": [{"text": "Hello"}]}]
    agent.system_prompt = "system prompt"
    agent._system_prompt_content = None
    # Provide a minimal ToolRegistry mock with get_all_tool_specs method
    class DummyToolRegistry:
        def get_all_tool_specs(self):
            return []
    agent.tool_registry = DummyToolRegistry()
    agent.thread_pool = None
    # Provide a dummy EventLoopMetrics with start_cycle and reset_usage_metrics methods
    class DummyEventLoopMetrics:
        def start_cycle(self, attributes=None):
            return 0, None
        def reset_usage_metrics(self):
            pass
    agent.event_loop_metrics = DummyEventLoopMetrics()
    # Provide dummy hooks with invoke_callbacks_async as async no-op
    class DummyHooks:
        async def invoke_callbacks_async(self, *args, **kwargs):
            pass
    agent.hooks = DummyHooks()
    agent.tool_executor = None
    agent._interrupt_state = None
    agent._cancel_signal = asyncio.Event()
    agent._model_state = {}
    agent._middleware_registry = None
    agent._checkpointing = False
    agent._checkpoint = None
    agent._checkpoint_cycle_index = 0
    agent._checkpoint_resume_position = None
    agent.trace_attributes = {}
    agent.retry_strategy = None
    agent._cancel_signal.clear()

    # First call: expect MaxTokensReachedException
    with pytest.raises(MaxTokensReachedException) as excinfo:
        stream = event_loop_cycle(agent=agent, invocation_state={})
        # Consume the async generator fully to trigger the exception
        async for _ in stream:
            pass

    # The exception message should not contain "unrecoverable state"
    assert "unrecoverable state" not in str(excinfo.value)
    assert "max_tokens" in str(excinfo.value) or "maximum token" in str(excinfo.value)

    # The agent.messages should have been appended with partial message content
    assert len(agent.messages) >= 1

    # Second call: expect normal successful response
    stream = event_loop_cycle(agent=agent, invocation_state={})
    collected_messages = []
    async for event in stream:
        # event is a dict with keys like "stop"
        if "stop" in event:
            stop_reason, message, _, _, _, _, _ = event["stop"]
            collected_messages.append((stop_reason, message))

    # The last stop reason should be "end_turn" (normal completion)
    assert collected_messages[-1][0] == "end_turn"
    # The message content should contain the text "hello again"
    found_hello_again = False
    for _, msg in collected_messages:
        if "content" in msg:
