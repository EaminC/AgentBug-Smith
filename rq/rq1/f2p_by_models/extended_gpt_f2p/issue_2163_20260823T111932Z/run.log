[32mimport threading
import pytest
import strands
import strands.tools.registry
import strands.tools.executors
import strands.hooks
from strands import Agent
from strands.event_loop.event_loop import event_loop_cycle
from strands.telemetry.metrics import EventLoopMetrics
from strands.types.exceptions import MaxTokensReachedException
from strands.types.interrupt import _InterruptState
import asyncio


@pytest.mark.asyncio
async def test_agent_reuse_after_max_tokens_exception():
    """
    Test that an agent instance can be reused after a MaxTokensReachedException is raised,
    without needing to reset the agent. The exception message should reflect the new
    recoverable message, and the agent should produce valid output on subsequent calls.
    """

    # Create a real Agent instance with minimal setup
    agent = Agent()
    # Initialize required attributes for event_loop_cycle to work
    agent.messages = [{"role": "user", "content": [{"text": "Hello"}]}]
    agent.system_prompt = "system prompt"
    agent._system_prompt_content = None
    agent.tool_registry = strands.tools.registry.ToolRegistry()
    # Use ThreadPoolExecutor instead of threading.Thread for thread_pool attribute
    import concurrent.futures
    agent.thread_pool = concurrent.futures.ThreadPoolExecutor(max_workers=1)
    agent.event_loop_metrics = EventLoopMetrics()
    agent.hooks = strands.hooks.HookRegistry()
    agent.tool_executor = strands.tools.executors.SequentialToolExecutor()
    agent._interrupt_state = _InterruptState()
    agent._cancel_signal = threading.Event()
    agent._model_state = {}
    agent._system_prompt_content = None
    agent._middleware_registry = strands._middleware.MiddlewareRegistry()
    agent._checkpointing = False
    agent._checkpoint = None
    agent._checkpoint_cycle_index = 0
    agent._checkpoint_resume_position = None
    agent.trace_attributes = {}
    agent.retry_strategy = strands.event_loop._retry.ModelRetryStrategy()

    # Mock model with a stream method that raises MaxTokensReachedException on first call,
    # then returns a normal response on second call
    class DummyModel:
        def __init__(self):
            self.call_count = 0

        async def stream(self, *args, **kwargs):
            self.call_count += 1
            if self.call_count == 1:
                # Simulate streaming with max_tokens stop reason
                async def gen():
                    yield {"contentBlockStart": {"start": {}}}
                    yield {"contentBlockStop": {}}
                    yield {"messageStop": {"stopReason": "max_tokens"}}
                return gen()
            else:
                # Normal successful response
                async def gen():
                    yield {"contentBlockDelta": {"delta": {"text": "Recovered response"}}}
                    yield {"contentBlockStop": {}}
                return gen()

        async def count_tokens(self, *args, **kwargs):
            return 10

    agent.model = DummyModel()

    # First call: expect MaxTokensReachedException with updated message
    with pytest.raises(MaxTokensReachedException) as excinfo:
        stream = event_loop_cycle(agent=agent, invocation_state={})
        # Consume the async generator fully
        async for _ in stream:
            pass
    expected_message = (
        "Model stopped generating due to maximum token limit. "
        "The partial message has been added to the conversation history. "
        "You can continue by calling the agent again. "
        "For more information see: "
        "https://strandsagents.com/docs/user-guide/concepts/agents/agent-loop/#maxtokensreachedexception"
    )
    assert expected_message in str(excinfo.value)

    # After exception, agent.messages should contain the partial message (2 messages total)
    assert len(agent.messages) == 2
    # The last message content should mention incomplete tool use or partial message
    last_content_text = agent.messages[-1]["content"][0].get("text", "")
    assert "tool use was incomplete" in last_content_text or "partial" in last_content_text or last_content_text != ""

    # Second call: should succeed and produce the recovered response
    stream = event_loop_cycle(agent=agent, invocation_state={})
    messages = []
    async for event in stream:
        if "stop" in event:
            stop_reason, message, _, _, _, _, _ = event["stop"]
            messages.append((stop_reason, message))
    # The last stop reason should be "end_turn"
    assert messages[-1][0] == "end_turn"
    # The last message content text should be "Recovered response"
    content_texts = [block.get("text") for block in messages[-1][1].get("content", []) if "text" in block]
    assert "Recovered response" in content_texts


