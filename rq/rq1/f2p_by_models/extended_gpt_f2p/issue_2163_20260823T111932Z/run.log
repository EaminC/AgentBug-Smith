[32mimport asyncio
import pytest
from strands import Agent
from strands.event_loop.event_loop import event_loop_cycle
from strands.types.exceptions import MaxTokensReachedException


@pytest.mark.asyncio
async def test_agent_reuse_after_max_tokens_reached():
    """
    Test that an Agent instance can be reused after hitting max_tokens limit.

    Steps:
    1. Create an Agent with a mock model that simulates max_tokens stop reason.
    2. Call event_loop_cycle and expect MaxTokensReachedException.
    3. Catch the exception, then call event_loop_cycle again with a normal response.
    4. Assert that the second call succeeds and returns expected output.

    This test fails on the buggy codebase because the agent instance is not reusable after
    MaxTokensReachedException, causing an error or unrecoverable state.
    After the fix, the agent instance can be reused without reset.
    """

    class MockModel:
        def __init__(self):
            self.call_count = 0

        async def stream(self, *args, **kwargs):
            self.call_count += 1
            if self.call_count == 1:
                # First call simulates max_tokens stop reason
                yield {
                    "contentBlockStart": {
                        "start": {
                            "toolUse": {
                                "toolUseId": "t1",
                                "name": "mock_tool",
                                "input": {},
                            }
                        }
                    }
                }
                yield {"contentBlockStop": {}}
                yield {"messageStop": {"stopReason": "max_tokens"}}
            else:
                # Second call returns a normal text response
                yield {"contentBlockDelta": {"delta": {"text": "hello again"}}}
                yield {"contentBlockStop": {}}

        async def count_tokens(self, *args, **kwargs):
            return 10

    # Create a minimal Agent instance with the mock model
    agent = Agent.__new__(Agent)  # bypass __init__
    agent.model = MockModel()
    agent.messages = [{"role": "user", "content": [{"text": "Hello"}]}]
    agent.system_prompt = "system prompt"
    agent._system_prompt_content = None
    agent.tool_registry = type("ToolRegistry", (), {"get_all_tool_specs": lambda self: []})()
    agent.thread_pool = None
    agent.event_loop_metrics = None
    agent.hooks = None
    agent.tool_executor = None
    agent._interrupt_state = None
    agent._cancel_signal = asyncio.Event()
    agent._model_state = {}
    agent._middleware_registry = None
    agent._checkpointing = False
    agent._checkpoint = None
    agent._checkpoint_cycle_index = 0
    agent._checkpoint_resume_position = None
    agent.trace_attributes = {}
    agent.retry_strategy = None
    agent._cancel_signal.clear()

    # First call: expect MaxTokensReachedException
    with pytest.raises(MaxTokensReachedException) as excinfo:
        stream = event_loop_cycle(agent=agent, invocation_state={})
        # Consume the async generator fully to trigger the exception
        async for _ in stream:
            pass

    # The exception message should not mention "unrecoverable state"
    assert "unrecoverable state" not in str(excinfo.value)
    assert "max_tokens limit" in str(excinfo.value) or "maximum token limit" in str(excinfo.value)

    # The agent.messages should contain the partial message added during max_tokens handling
    assert len(agent.messages) >= 2
    # The second message should mention incomplete tool use or partial message
    found_partial_message = any(
        "incomplete" in m.get("content", [{}])[0].get("text", "").lower() or
        "partial" in m.get("content", [{}])[0].get("text", "").lower()
        for m in agent.messages[1:]
    )
    assert found_partial_message

    # Second call: normal usage after catching exception, should succeed
    stream2 = event_loop_cycle(agent=agent, invocation_state={})
    results = []
    async for event in stream2:
        # The event is a dict with keys like 'stop' or 'message'
        if "stop" in event:
            results.append(event["stop"])
    # The last stop event should have stop_reason 'end_turn' and the expected message content
    assert results
    last_stop = results[-1]
    stop_reason = last_stop[0]
    message = last_stop[1]
    assert stop_reason == "end_turn"
    assert message["role"] == "assistant"
    # The message content should include the text "hello again"
    texts = [block.get("text", "") for block in message.get("content", []) if isinstance(block, dict)]
    assert any("hello again" in text for text in texts)[0m
