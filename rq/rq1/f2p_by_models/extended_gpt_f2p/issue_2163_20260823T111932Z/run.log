    agent.retry_strategy = strands.event_loop._retry.ModelRetryStrategy()

    # Model that alternates between max_tokens exception and normal response
    class AlternatingDummyModel:
        def __init__(self):
            self.call_count = 0

        async def stream(self, *args, **kwargs):
            self.call_count += 1
            if self.call_count % 2 == 1:
                # Odd calls: max_tokens stop reason
                async def gen():
                    yield {"contentBlockStart": {"start": {}}}
                    yield {"contentBlockStop": {}}
                    yield {"messageStop": {"stopReason": "max_tokens"}}
                return gen()
            else:
                # Even calls: normal response
                async def gen():
                    yield {"contentBlockDelta": {"delta": {"text": f"Response {self.call_count//2}"}}}
                    yield {"contentBlockStop": {}}
                return gen()

        async def count_tokens(self, *args, **kwargs):
            return 10

    agent.model = AlternatingDummyModel()

    # Call the agent 4 times: expect exceptions on calls 1 and 3, success on 2 and 4
    for i in range(4):
        if i % 2 == 0:
            # Expect exception on odd calls (0-based even index)
            with pytest.raises(MaxTokensReachedException) as excinfo:
                stream = event_loop_cycle(agent=agent, invocation_state={})
                async for _ in stream:
                    pass
            expected_message = (
                "Model stopped generating due to maximum token limit. "
                "The partial message has been added to the conversation history. "
                "You can continue by calling the agent again. "
                "For more information see: "
                "https://strandsagents.com/docs/user-guide/concepts/agents/agent-loop/#maxtokensreachedexception"
            )
            assert expected_message in str(excinfo.value)
        else:
            # Expect success on even calls (0-based odd index)
            stream = event_loop_cycle(agent=agent, invocation_state={})
            last_stop_reason = None
            last_message = None
            async for event in stream:
                if "stop" in event:
                    last_stop_reason, last_message, _, _, _, _, _ = event["stop"]
            assert last_stop_reason == "end_turn"
            # The last message content text should match the response text
            content_texts = [block.get("text") for block in last_message.get("content", []) if "text" in block]
            assert any(f"Response {i//2}" == text for text in content_texts)

    # After all calls, agent.messages should have grown with partial messages from exceptions and normal messages
    assert len(agent.messages) >= 5  # initial + partials + responses


# The tests above exercise the agent reuse after max_tokens exception and verify that the exception message
# is updated and that the agent can continue to be used without resetting. The tests fail on buggy code
# and pass after the fix described in the issue.[0m
