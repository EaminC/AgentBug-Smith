[32mimport asyncio
import threading
import pytest

from strands.agent.agent import Agent
from strands.event_loop.event_loop import event_loop_cycle
from strands.types.exceptions import MaxTokensReachedException


@pytest.mark.asyncio
async def test_agent_reusable_after_max_tokens_reached():
    """
    This test verifies that after a MaxTokensReachedException is raised during an agent event loop cycle,
    the same agent instance can be used again without resetting or reinitializing it.

    Steps:
    1. Create a dummy Agent instance with minimal required attributes.
    2. Mock the agent's model.stream method to simulate a partial response ending with a max_tokens stop reason.
    3. Call event_loop_cycle once and expect MaxTokensReachedException.
    4. Call event_loop_cycle a second time with the same agent instance and expect no exception.
    5. Verify that the agent's messages list contains the partial message after the exception.
    """

    # Create a dummy agent with minimal initialization
    agent = Agent.__new__(Agent)
    agent.messages = [{"role": "user", "content": [{"text": "Hello"}]}]
    agent.system_prompt = "p1"
    agent._system_prompt_content = None
    agent.tool_registry = None
    agent.thread_pool = None
    agent.event_loop_metrics = type("DummyMetrics", (), {"start_cycle": lambda self, attributes=None: (0, None), "reset_usage_metrics": lambda self: None})()
    agent.hooks = None
    agent.tool_executor = None
    agent._interrupt_state = None
    agent._cancel_signal = threading.Event()
    agent._model_state = {}
    agent._middleware_registry = None
    agent._checkpointing = False
    agent._checkpoint = None
    agent._checkpoint_cycle_index = 0
    agent._checkpoint_resume_position = None
    agent.trace_attributes = {}
    agent.retry_strategy = None

    # Define a partial stream that yields a partial toolUse and then a max_tokens stop
    async def partial_stream():
        yield {
            "contentBlockStart": {
                "start": {
                    "toolUse": {
                        "toolUseId": "t1",
                        "name": "dummy_tool",
                        "input": {},
                    }
                }
            }
        }
        yield {"contentBlockStop": {}}
        yield {"messageStop": {"stopReason": "max_tokens"}}

    class DummyModel:
        def __init__(self):
            self.call_count = 0

        def stream(self, *args, **kwargs):
            self.call_count += 1
            return partial_stream()

    dummy_model = DummyModel()
    agent.model = dummy_model

    # First call triggers MaxTokensReachedException
    with pytest.raises(MaxTokensReachedException):
        stream = event_loop_cycle(agent=agent, invocation_state={})
        async for _ in stream:
            pass

    # After exception, agent.messages should have the partial message appended
    assert len(agent.messages) >= 2
    last_message = agent.messages[-1]
    # The last message content should mention incomplete tool use due to max_tokens
    assert any("tool use was incomplete due" in content.get("text", "") for content in last_message.get("content", []))

    # Now call event_loop_cycle again with the same agent instance
    # This should NOT raise an exception and should complete normally
    # We simulate a normal response this time
    async def normal_stream():
        yield {"contentBlockDelta": {"delta": {"text": "final response"}}}
        yield {"contentBlockStop": {}}
        yield {"messageStop": {"stopReason": "end_turn"}}

    class NormalModel:
        def __init__(self):
            self.call_count = 0

        def stream(self, *args, **kwargs):
            self.call_count += 1
            return normal_stream()

    agent.model = NormalModel()

    stream = event_loop_cycle(agent=agent, invocation_state={})
    collected_events = []
    async for event in stream:
        collected_events.append(event)

    # The last event should have stop reason "end_turn"
    stop_reason = collected_events[-1]["stop"][0]
    assert stop_reason == "end_turn"


@pytest.mark.asyncio
async def test_max_tokens_exception_message_update():
    """
    Verify that the MaxTokensReachedException message no longer contains the phrase "unrecoverable state"
    and instead contains the updated message indicating the model stopped due to max token limit.
    """

    agent = Agent.__new__(Agent)
    agent.messages = [{"role": "user", "content": [{"text": "Hello"}]}]
    agent.system_prompt = "p1"
    agent._system_prompt_content = None
    agent.tool_registry = None
    agent.thread_pool = None
    agent.event_loop_metrics = type("DummyMetrics", (), {"start_cycle": lambda self, attributes=None: (0, None), "reset_usage_metrics": lambda self: None})()
    agent.hooks = None
    agent.tool_executor = None
    agent._interrupt_state = None
    agent._cancel_signal = threading.Event()
    agent._model_state = {}
    agent._middleware_registry = None
    agent._checkpointing = False
    agent._checkpoint = None
    agent._checkpoint_cycle_index = 0
    agent._checkpoint_resume_position = None
    agent.trace_attributes = {}
    agent.retry_strategy = None

    async def partial_stream():
        yield {
            "contentBlockStart": {
                "start": {
                    "toolUse": {
                        "toolUseId": "t1",
                        "name": "dummy_tool",
                        "input": {},
                    }
                }
            }
        }
        yield {"contentBlockStop": {}}
        yield {"messageStop": {"stopReason": "max_tokens"}}

    class DummyModel:
        def stream(self, *args, **kwargs):
            return partial_stream()

    agent.model = DummyModel()

    expected_message_start = (
        "Model stopped generating due to maximum token limit. "
        "The partial message has been added to the conversation history. "
        "You can continue by calling the agent again."
    )

    with pytest.raises(MaxTokensReachedException) as excinfo:
        stream = event_loop_cycle(agent=agent, invocation_state={})
        async for _ in stream:
            pass

    # Assert the exception message starts with the updated message (not the old unrecoverable state message)
    assert excinfo.value.args[0].startswith(expected_message_start)


