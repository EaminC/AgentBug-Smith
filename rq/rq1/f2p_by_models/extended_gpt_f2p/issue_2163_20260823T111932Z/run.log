                    },
                ],
                "role": "assistant",
                "metadata": ANY,
            },
        },
        "interrupts": {
            "v1:before_tool_call:t1:78714d6c-613c-5cf4-bf25-7037569941f9": {
                "id": "v1:before_tool_call:t1:78714d6c-613c-5cf4-bf25-7037569941f9",
