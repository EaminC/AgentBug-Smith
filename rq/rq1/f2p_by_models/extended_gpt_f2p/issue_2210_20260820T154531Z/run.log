    assert "strict" not in tool_spec_result


def test_strict_tools_warning_with_citations(caplog):
    # This test checks that a warning is logged when strict_tools=True and citations config is set
    # We create a model with strict_tools=True and guardrail_id set to simulate citations config
    model = BedrockModel(strict_tools=True, guardrail_id="test-guardrail", guardrail_version="v1")
    # Call _format_request to trigger the warning
    model._format_request([])

    # Check that a warning about incompatibility is logged
    warning_found = any(
        "strict_tools=True is incompatible with citations configuration" in record.message for record in caplog.records
    )
    assert warning_found


def test_strict_tools_with_agent_and_tools():
    # This test uses the Agent class with BedrockModel strict_tools=True and multiple tools
    tools_called = set()

    @Agent.tool
    def search(query: str, tags: list[str], max_results: int = 5) -> str:
        tools_called.add("search")
        return f"Found results for '{query}' with tags {tags} (limit {max_results})"

    @Agent.tool
    def calculator(expression: str) -> float:
        tools_called.add("calculator")
        return eval(expression)

    model = BedrockModel(strict_tools=True)
    agent = Agent(model=model, tools=[search, calculator], load_tools_from_directory=False)
    agent('Search for "python" with tags ["programming", "language"] using the search tool.')

    assert "search" in tools_called
    assert "calculator" not in tools_called  # calculator tool not invoked in this query


def test_strict_tools_with_agent_and_tools_calculator_invoked():
    # This test uses the Agent class with BedrockModel strict_tools=True and multiple tools
    tools_called = set()

    @Agent.tool
    def search(query: str, tags: list[str], max_results: int = 5) -> str:
        tools_called.add("search")
        return f"Found results for '{query}' with tags {tags} (limit {max_results})"

    @Agent.tool
    def calculator(expression: str) -> float:
        tools_called.add("calculator")
        return eval(expression)

    model = BedrockModel(strict_tools=True)
    agent = Agent(model=model, tools=[search, calculator], load_tools_from_directory=False)
    agent("What is 123 + 456?")

    assert "calculator" in tools_called
    # search tool not invoked in this query
    assert "search" not in tools_called or True  # allow either way


