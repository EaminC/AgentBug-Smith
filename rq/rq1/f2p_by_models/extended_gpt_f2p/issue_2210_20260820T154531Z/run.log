[32mimport logging
import pytest

import strands
from strands import Agent
from strands.models import BedrockModel


def test_strict_tools_injects_strict_and_closes_schema():
    """Test that strict_tools=True injects 'strict': True and closes schema with additionalProperties: False."""

    tool_specs = [
        {
            "name": "my_tool",
            "description": "A tool",
            "inputSchema": {
                "json": {
                    "type": "object",
                    "properties": {"param": {"type": "string"}},
                    "required": ["param"],
                }
            },
        }
    ]
    model = BedrockModel(strict_tools=True)
    request = model._format_request([{"role": "user", "content": [{"text": "hello"}]}], tool_specs=tool_specs)
    tool_spec_result = request["toolConfig"]["tools"][0]["toolSpec"]

    assert tool_spec_result == {
        "name": "my_tool",
        "description": "A tool",
        "inputSchema": {
            "json": {
                "type": "object",
                "properties": {"param": {"type": "string"}},
                "required": ["param"],
                "additionalProperties": False,
            }
        },
        "strict": True,
    }


def test_strict_tools_does_not_mutate_original():
    """Test that the original tool_spec inputSchema is not mutated by strict_tools=True."""

    tool_specs = [
        {
            "name": "my_tool",
            "description": "A tool",
            "inputSchema": {
                "json": {
                    "type": "object",
                    "properties": {"param": {"type": "string"}},
                    "required": ["param"],
                }
            },
        }
    ]
    original_schema = tool_specs[0]["inputSchema"]["json"].copy()
    model = BedrockModel(strict_tools=True)
    model._format_request([{"role": "user", "content": [{"text": "hello"}]}], tool_specs=tool_specs)

    # Original inputSchema should not have additionalProperties added
    assert tool_specs[0]["inputSchema"]["json"] == original_schema


def test_strict_tools_preserves_additional_properties_true():
    """Test that if additionalProperties is True in inputSchema, it is preserved and not overridden."""

    tool_specs = [
        {
            "name": "my_tool",
            "description": "A tool",
            "inputSchema": {
                "json": {
                    "type": "object",
                    "properties": {"param": {"type": "string"}},
                    "required": ["param"],
                    "additionalProperties": True,
                }
            },
        }
    ]
    model = BedrockModel(strict_tools=True)
    request = model._format_request([{"role": "user", "content": [{"text": "hello"}]}], tool_specs=tool_specs)
    schema = request["toolConfig"]["tools"][0]["toolSpec"]["inputSchema"]["json"]

    assert schema["additionalProperties"] is True


def test_strict_tools_nested_objects():
    """Test that nested object properties also get additionalProperties: False when strict_tools=True."""

    tool_specs = [
        {
            "name": "my_tool",
            "description": "A tool",
            "inputSchema": {
                "json": {
                    "type": "object",
                    "properties": {
                        "config": {
                            "type": "object",
                            "properties": {"value": {"type": "integer"}},
                        }
                    },
                    "required": ["config"],
                }
            },
        }
    ]
    model = BedrockModel(strict_tools=True)
    request = model._format_request([{"role": "user", "content": [{"text": "hello"}]}], tool_specs=tool_specs)
    schema = request["toolConfig"]["tools"][0]["toolSpec"]["inputSchema"]["json"]

    assert schema == {
        "type": "object",
        "properties": {
            "config": {
                "type": "object",
                "properties": {"value": {"type": "integer"}},
                "additionalProperties": False,
            }
        },
        "required": ["config"],
        "additionalProperties": False,
    }


def test_strict_tools_default_no_strict():
    """Test that by default (strict_tools not set) no 'strict' field is added and schema is unchanged."""

    tool_specs = [
        {
            "name": "my_tool",
            "description": "A tool",
            "inputSchema": {
                "json": {
                    "type": "object",
                    "properties": {"param": {"type": "string"}},
                    "required": ["param"],
                }
            },
        }
    ]
    model = BedrockModel()
    request = model._format_request([{"role": "user", "content": [{"text": "hello"}]}], tool_specs=tool_specs)
    tool_spec_result = request["toolConfig"]["tools"][0]["toolSpec"]

    assert "strict" not in tool_spec_result
    assert tool_spec_result["inputSchema"]["json"] == {
        "type": "object",
        "properties": {"param": {"type": "string"}},
        "required": ["param"],
    }


def test_strict_tools_false_no_strict():
    """Test that strict_tools=False disables strict injection."""

    tool_specs = [
        {
            "name": "my_tool",
            "description": "A tool",
            "inputSchema": {"json": {"type": "object", "properties": {"x": {"type": "string"}}}},
        }
    ]
    model = BedrockModel(strict_tools=False)
    request = model._format_request([{"role": "user", "content": [{"text": "hello"}]}], tool_specs=tool_specs)
    tool_spec_result = request["toolConfig"]["tools"][0]["toolSpec"]

    assert "strict" not in tool_spec_result


def test_strict_tools_none_no_strict():
    """Test that strict_tools=None disables strict injection."""

    tool_specs = [
        {
            "name": "my_tool",
            "description": "A tool",
            "inputSchema": {"json": {"type": "object", "properties": {"x": {"type": "string"}}}},
        }
    ]
    model = BedrockModel(strict_tools=None)
    request = model._format_request([{"role": "user", "content": [{"text": "hello"}]}], tool_specs=tool_specs)
    tool_spec_result = request["toolConfig"]["tools"][0]["toolSpec"]

    assert "strict" not in tool_spec_result


def test_strict_tools_applies_to_all_tools():
    """Test that strict_tools=True applies strict and additionalProperties: False to all tool specs."""

    tool_specs = [
        {"name": "tool_a", "description": "Tool A", "inputSchema": {"json": {"type": "object", "properties": {}}}},
        {"name": "tool_b", "description": "Tool B", "inputSchema": {"json": {"type": "object", "properties": {}}}},
    ]
    model = BedrockModel(strict_tools=True)
    request = model._format_request([{"role": "user", "content": [{"text": "hello"}]}], tool_specs=tool_specs)

    for tool in request["toolConfig"]["tools"]:
        if "toolSpec" in tool:
            assert tool["toolSpec"]["strict"] is True
            assert tool["toolSpec"]["inputSchema"]["json"]["additionalProperties"] is False


def test_strict_tools_warning_with_citations(caplog):
    """Test that a warning is logged when strict_tools=True is used alongside citations configuration."""

    caplog.set_level(logging.WARNING, logger="strands.models.bedrock")

    # Setup model with strict_tools=True and citations config
    model = BedrockModel(strict_tools=True, guardrail_id="g1", guardrail_version="v1", guardrail_trace="enabled")

    # Compose messages with citationsContent to trigger warning
    messages = [
        {
            "role": "assistant",
            "content": [
                {
                    "citationsContent": {
                        "citations": [
                            {
                                "location": {"web": {"url": "https://example.com", "domain": "example.com"}},
                                "sourceContent": [{"text": "Example source"}],
                                "title": "Example Title",
                            }
                        ],
                        "content": [{"text": "Some content"}],
                    }
                }
            ],
        }
    ]

    # Call _format_request with tool specs and citations config to trigger warning
    tool_specs = [
        {
            "name": "tool",
            "description": "desc",
            "inputSchema": {"json": {"type": "object", "properties": {}}},
        }
    ]

    _ = model._format_request(messages, tool_specs=tool_specs)

    # Check that a warning about incompatibility is logged
    found_warning = any(
        "strict_tools=True is incompatible with citations configuration" in record.message for record in caplog.records
    )
    assert found_warning


def test_strict_tools_complex_schema_integration():
    """Integration test: Use strict_tools=True with tools having complex schemas and run an agent call."""

    tools_called = set()

    @strands.tool
    def search(query: str, tags: list[str], max_results: int = 5) -> str:
        """Search for items matching query and tags."""
        tools_called.add("search")
        return f"Found results for '{query}' with tags {tags} (limit {max_results})"

    @strands.tool
    def calculator(expression: str) -> float:
        """Calculate the result of a mathematical expression."""
        tools_called.add("calculator")
        return eval(expression)

    model = BedrockModel(strict_tools=True)
    agent = Agent(model=model, tools=[search, calculator], load_tools_from_directory=False)
    agent('Search for "python" with tags ["programming", "language"] using the search tool.')

    assert "search" in tools_called
    assert "calculator" in tools_called[0m
