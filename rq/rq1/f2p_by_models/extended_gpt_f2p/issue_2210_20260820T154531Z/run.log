def test_strict_tools_warning_with_citations(caplog, bedrock_client, model_id, messages):
    tool_specs = [
        {
            "name": "my_tool",
            "description": "A tool",
            "inputSchema": {"json": {"type": "object", "properties": {}}},
        }
    ]
    model = BedrockModel(
        model_id=model_id,
        strict_tools=True,
        guardrail_id="g1",
        guardrail_version="v1",
    )
    with caplog.at_level("WARNING", logger="strands.models.bedrock"):
        _ = model._format_request(messages, tool_specs=tool_specs)

    # Check that a warning about incompatibility with citations is logged
    found_warning = any(
        "strict_tools=True is incompatible with citations configuration" in record.message for record in caplog.records
    )
    assert found_warning


