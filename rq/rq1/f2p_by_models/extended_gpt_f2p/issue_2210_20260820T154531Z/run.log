def test_strict_tools_applies_to_all_tools(bedrock_client, model_id, messages):
    tool_specs = [
        {"name": "tool_a", "description": "Tool A", "inputSchema": {"json": {"type": "object", "properties": {}}}},
        {"name": "tool_b", "description": "Tool B", "inputSchema": {"json": {"type": "object", "properties": {}}}},
    ]
    model = BedrockModel(model_id=model_id, strict_tools=True)
    request = model._format_request(messages, tool_specs=tool_specs)

    for tool in request["toolConfig"]["tools"]:
        if "toolSpec" in tool:
            assert tool["toolSpec"]["strict"] is True
            assert tool["toolSpec"]["inputSchema"]["json"]["additionalProperties"] is False


def test_strict_tools_warning_with_citations(caplog, bedrock_client, model_id, messages):
    # Setup a model with strict_tools=True and citations enabled in additional_request_fields
    model = BedrockModel(
        model_id=model_id,
        strict_tools=True,
        additional_request_fields={"citations": {"enabled": True}},
    )
    caplog.set_level("WARNING", logger="strands.models.bedrock")
    _ = model._format_request(messages)
    # The warning about incompatibility should be emitted
    assert any(
        "strict_tools=True is incompatible with citations configuration" in record.message for record in caplog.records
    )


