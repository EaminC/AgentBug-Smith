[32mimport pytest

from strands.models import BedrockModel
from strands import Agent


def test_strict_tools_injects_strict_and_closes_schema():
    tool_specs = [
        {
            "name": "my_tool",
            "description": "A tool",
            "inputSchema": {
                "json": {
                    "type": "object",
                    "properties": {"param": {"type": "string"}},
                    "required": ["param"],
                }
            },
        }
    ]
    model = BedrockModel(strict_tools=True)
    request = model._format_request([], tool_specs=tool_specs)
    tool_spec_result = request["toolConfig"]["tools"][0]["toolSpec"]

    # The 'strict' flag must be True
    assert tool_spec_result.get("strict") is True

    # The inputSchema must have additionalProperties set to False recursively
    input_schema = tool_spec_result["inputSchema"]["json"]
    assert input_schema.get("additionalProperties") is False
    assert input_schema["type"] == "object"
    assert "properties" in input_schema
    assert input_schema["properties"]["param"]["type"] == "string"
    assert input_schema["required"] == ["param"]


def test_strict_tools_does_not_mutate_original_tool_spec():
    tool_specs = [
        {
            "name": "my_tool",
            "description": "A tool",
            "inputSchema": {
                "json": {
                    "type": "object",
                    "properties": {"param": {"type": "string"}},
                    "required": ["param"],
                }
            },
        }
    ]
    original_schema = tool_specs[0]["inputSchema"]["json"].copy()
    model = BedrockModel(strict_tools=True)
    model._format_request([], tool_specs=tool_specs)

    # The original tool spec inputSchema must not be mutated
    assert tool_specs[0]["inputSchema"]["json"] == original_schema


def test_strict_tools_preserves_additional_properties_true():
    tool_specs = [
        {
            "name": "my_tool",
            "description": "A tool",
            "inputSchema": {
                "json": {
                    "type": "object",
                    "properties": {"param": {"type": "string"}},
                    "required": ["param"],
                    "additionalProperties": True,
                }
            },
        }
    ]
    model = BedrockModel(strict_tools=True)
    request = model._format_request([], tool_specs=tool_specs)
    schema = request["toolConfig"]["tools"][0]["toolSpec"]["inputSchema"]["json"]

    # additionalProperties True must be preserved and not overridden to False
    assert schema["additionalProperties"] is True


def test_strict_tools_applies_to_all_tools():
    tool_specs = [
        {"name": "tool_a", "description": "Tool A", "inputSchema": {"json": {"type": "object", "properties": {}}}},
        {"name": "tool_b", "description": "Tool B", "inputSchema": {"json": {"type": "object", "properties": {}}}},
    ]
    model = BedrockModel(strict_tools=True)
    request = model._format_request([], tool_specs=tool_specs)

    for tool in request["toolConfig"]["tools"]:
        if "toolSpec" in tool:
            assert tool["toolSpec"]["strict"] is True
            assert tool["toolSpec"]["inputSchema"]["json"]["additionalProperties"] is False


def test_strict_tools_nested_objects():
    tool_specs = [
        {
            "name": "my_tool",
            "description": "A tool",
            "inputSchema": {
                "json": {
                    "type": "object",
                    "properties": {
                        "config": {
                            "type": "object",
                            "properties": {"value": {"type": "integer"}},
                        }
                    },
                    "required": ["config"],
                }
            },
        }
    ]
    model = BedrockModel(strict_tools=True)
    request = model._format_request([], tool_specs=tool_specs)
    schema = request["toolConfig"]["tools"][0]["toolSpec"]["inputSchema"]["json"]

    # The nested object must also have additionalProperties set to False
    assert schema == {
        "type": "object",
        "properties": {
            "config": {
                "type": "object",
                "properties": {"value": {"type": "integer"}},
                "additionalProperties": False,
            }
        },
        "required": ["config"],
        "additionalProperties": False,
    }


def test_strict_tools_default_no_strict():
    tool_specs = [
        {
            "name": "my_tool",
            "description": "A tool",
            "inputSchema": {
                "json": {
                    "type": "object",
                    "properties": {"param": {"type": "string"}},
                    "required": ["param"],
                }
            },
        }
    ]
    model = BedrockModel()
    request = model._format_request([], tool_specs=tool_specs)
    tool_spec_result = request["toolConfig"]["tools"][0]["toolSpec"]

    # strict key must not be present when strict_tools is not set
    assert "strict" not in tool_spec_result

    # inputSchema must be unchanged (no additionalProperties added)
    assert tool_spec_result["inputSchema"]["json"] == {
        "type": "object",
        "properties": {"param": {"type": "string"}},
        "required": ["param"],
    }


