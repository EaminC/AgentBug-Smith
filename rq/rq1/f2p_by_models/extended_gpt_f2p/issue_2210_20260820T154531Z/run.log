def test_strict_tools_flag_behavior(strict_tools_value, expect_strict):
    tool_specs = [
        {
            "name": "tool1",
            "description": "desc",
            "inputSchema": {"json": {"type": "object", "properties": {}}},
        }
    ]
    model = BedrockModel(strict_tools=strict_tools_value)
    request = model._format_request([], tool_specs=tool_specs)
    tool_spec = request["toolConfig"]["tools"][0]["toolSpec"]
    if expect_strict:
        assert tool_spec.get("strict") is True
        assert tool_spec["inputSchema"]["json"].get("additionalProperties") is False
    else:
        assert "strict" not in tool_spec
        # additionalProperties may or may not be present if originally present
        # but default schema has no additionalProperties
        assert "additionalProperties" not in tool_spec["inputSchema"]["json"] or tool_spec["inputSchema"]["json"]["additionalProperties"] is True


