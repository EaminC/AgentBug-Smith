    tool_specs = [
        {
            "name": "my_tool",
            "description": "A tool",
            "inputSchema": {
                "json": {
                    "type": "object",
                    "properties": {"param": {"type": "string"}},
                    "required": ["param"],
                }
            },
        }
    ]
    model = BedrockModel(model_id=model_id)
    request = model._format_request(messages, tool_specs=tool_specs)
