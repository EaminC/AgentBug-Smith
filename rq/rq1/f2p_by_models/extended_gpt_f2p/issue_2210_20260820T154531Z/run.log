            "role": "user",
            "content": [
                {
                    "document": {
                        "name": "report.pdf",
                        "format": "pdf",
                        "source": {
                            "location": {"type": "s3", "uri": "s3://my-bucket/report.pdf"},
                        },
                    }
                },
                {
                    "document": {
                        "name": "report.pdf",
                        "format": "pdf",
                        "source": {
                            "location": {
                                "type": "s3",
                                "uri": "s3://my-bucket/report.pdf",
                                "bucketOwner": "123456789012",
