                        "format": "mp4",
                        "source": {
                            "location": {
                                "type": "other",
                            },
                        },
                    }
                },
                {
                    "image": {
                        "format": "png",
                        "source": {
                            "location": {
                                "type": "other",
                            },
                        },
                    }
                },
            ],
        }
    ]

    formatted_request = model._format_request(messages)
    assert len(formatted_request["messages"][0]["content"]) == 1
    assert "Non s3 location sources are not supported by Bedrock | skipping content block" in caplog.text


