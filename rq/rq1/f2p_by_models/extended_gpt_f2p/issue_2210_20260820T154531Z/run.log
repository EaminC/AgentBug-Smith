    tool_spec_result = request["toolConfig"]["tools"][0]["toolSpec"]

    assert tool_spec_result == {
        "name": "my_tool",
        "description": "A tool",
        "inputSchema": {
            "json": {
                "type": "object",
                "properties": {"param": {"type": "string"}},
                "required": ["param"],
                "additionalProperties": False,
            }
        },
        "strict": True,
    }


