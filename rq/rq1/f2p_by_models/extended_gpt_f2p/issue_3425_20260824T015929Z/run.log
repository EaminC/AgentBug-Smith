        {"role": "assistant", "content": [{"text": "a"}, {"text": " \n"}, {"toolUse": {"name": "a_name"}}]},
        {"role": "assistant", "content": [{"text": ""}, {"toolUse": {"name": "a_name"}}]},
        {"role": "assistant", "content": [{"text": "a"}, {"text": " \n"}]},
        # Invalid names
