        mock_model,
        system_prompt_content=None,
        messages=[
            {
                "role": "user",
                "content": [{"text": "hi"}],
                "tracking_id": "durable-1",
                "metadata": {"usage": {"inputTokens": 1, "outputTokens": 1, "totalTokens": 2}},
            }
        ],
        tool_specs=None,
        system_prompt=None,
