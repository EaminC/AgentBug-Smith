from unittest.mock import patch, AsyncMock

from agentscope.model import OpenAIChatModel
from agentscope.credential import OpenAICredential


class TestQwenThinkingEnableForwarding(unittest.IsolatedAsyncioTestCase):
    """Test that thinking_enable parameter is forwarded to extra_body.enable_thinking
    in OpenAIChatModel calls for Qwen models."""

    @patch("openai.AsyncClient")
    async def test_thinking_enable_passed_to_extra_body(self, mock_client_cls):
        """Test that thinking_enable=True is forwarded to extra_body.enable_thinking."""

        mock_create = AsyncMock()
        mock_create.return_value = AsyncMock()
        mock_create.return_value.id = "resp-1"
        mock_create.return_value.choices = []
        mock_client_cls.return_value.chat.completions.create = mock_create

        # Instantiate model with thinking_enable=True
        model = OpenAIChatModel(
            credential=OpenAICredential(api_key="dummy"),
            model="qwen-v1",
            stream=False,
            context_size=128000,
            parameters=OpenAIChatModel.Parameters(thinking_enable=True),
        )

        # Call the model with empty messages
        await model([])

        # Check that extra_body is passed and contains enable_thinking=True
        called_kwargs = mock_create.call_args.kwargs
        self.assertIn("extra_body", called_kwargs, "extra_body not passed in API call")
        self.assertIn(
            "enable_thinking",
            called_kwargs["extra_body"],
            "enable_thinking not in extra_body",
        )
        self.assertTrue(called_kwargs["extra_body"]["enable_thinking"])

    @patch("openai.AsyncClient")
    async def test_thinking_disable_passed_to_extra_body(self, mock_client_cls):
        """Test that thinking_enable=False is forwarded to extra_body.enable_thinking."""

        mock_create = AsyncMock()
        mock_create.return_value = AsyncMock()
        mock_create.return_value.id = "resp-2"
        mock_create.return_value.choices = []
        mock_client_cls.return_value.chat.completions.create = mock_create

        model = OpenAIChatModel(
            credential=OpenAICredential(api_key="dummy"),
            model="qwen-v1",
            stream=False,
            context_size=128000,
            parameters=OpenAIChatModel.Parameters(thinking_enable=False),
        )

        await model([])

        called_kwargs = mock_create.call_args.kwargs
        self.assertIn("extra_body", called_kwargs, "extra_body not passed in API call")
        self.assertIn(
            "enable_thinking",
            called_kwargs["extra_body"],
            "enable_thinking not in extra_body",
        )
        self.assertFalse(called_kwargs["extra_body"]["enable_thinking"])

