@pytest.mark.asyncio
async def test_qwen_thinking_enable_passed_to_extra_body(monkeypatch):
    """
    Test that when using OpenAIChatModel with Qwen model and thinking_enable parameter,
    the extra_body.enable_thinking is properly passed to the underlying API call.

    This test fails on buggy code where thinking_enable is ignored and not forwarded,
    causing structured output with thinking mode enabled to fail.

    After fix, the thinking_enable parameter is forwarded in extra_body, allowing
    disabling thinking mode when needed.
    """
    # We will patch the openai.AsyncClient.chat.completions.create method to capture kwargs
    # and return a dummy valid response.

    # Import openai here to patch AsyncClient
    import openai

    called_kwargs = {}

    class DummyResponse:
        def __init__(self):
            self.id = "dummy-response-id"
            self.choices = [types.SimpleNamespace(message=types.SimpleNamespace(content="dummy"))]
            self.usage = types.SimpleNamespace(prompt_tokens=10, completion_tokens=5, prompt_tokens_details=None)

    async def dummy_create(*args, **kwargs):
        # Capture the extra_body argument passed
        called_kwargs.update(kwargs)
        return DummyResponse()

    # Patch AsyncClient to have chat.completions.create = dummy_create
    class DummyChatCompletions:
        def __init__(self):
            self.create = dummy_create

    class DummyChat:
        def __init__(self):
            self.completions = DummyChatCompletions()

    class DummyAsyncClient:
        def __init__(self, *args, **kwargs):
            pass

        @property
        def chat(self):
            return DummyChat()

    monkeypatch.setattr(openai, "AsyncClient", DummyAsyncClient)

    # We create the model with thinking_enable=True
    model = OpenAIChatModel(
        credential=OpenAICredential(api_key="test"),
        model="qwen-v1",
        stream=False,
        context_size=128_000,
        parameters=OpenAIChatModel.Parameters(thinking_enable=True),
    )

    # Call the model with empty messages and structured_model to simulate structured output usage
    # structured_model is a dummy object to trigger structured output code path
    class DummyStructuredModel:
        pass

    # Await the call
    await model([], structured_model=DummyStructuredModel())

    # Now assert that extra_body is present and contains enable_thinking=True
    # This is the key fix: thinking_enable must be forwarded as extra_body.enable_thinking
    assert "extra_body" in called_kwargs, "extra_body not passed to API call"
    extra_body = called_kwargs["extra_body"]
    assert isinstance(extra_body, dict), "extra_body should be a dict"
    assert "enable_thinking" in extra_body, "enable_thinking not in extra_body"
    assert extra_body["enable_thinking"] is True, "thinking_enable True not forwarded correctly"

    # Also test that if thinking_enable=False, it is forwarded as False
    called_kwargs.clear()

    model2 = OpenAIChatModel(
        credential=OpenAICredential(api_key="test"),
        model="qwen-v1",
        stream=False,
        context_size=128_000,
        parameters=OpenAIChatModel.Parameters(thinking_enable=False),
    )
    await model2([], structured_model=DummyStructuredModel())

    assert "extra_body" in called_kwargs, "extra_body not passed to API call for thinking_enable=False"
    extra_body2 = called_kwargs["extra_body"]
    assert isinstance(extra_body2, dict), "extra_body should be a dict"
    assert "enable_thinking" in extra_body2, "enable_thinking not in extra_body for thinking_enable=False"
    assert extra_body2["enable_thinking"] is False, "thinking_enable False not forwarded correctly"


