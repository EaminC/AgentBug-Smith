    @patch("openai.AsyncClient")
    async def test_stream_usage_in_final(
        self,
        mock_client_cls: MagicMock,
    ) -> None:
        """Usage information is captured and present in final response."""
        chunks = [
            _make_stream_chunk(delta_text="Hi"),
