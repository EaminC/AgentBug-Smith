@pytest.mark.asyncio
async def test_qwen_thinking_enable_passed_to_extra_body(monkeypatch):
    """
    Test that when thinking_enable is set in parameters, it is passed to extra_body
    in the API call for OpenAIChatModel with Qwen model.
    This should fail on buggy code that does not pass thinking_enable.
    """
    import openai

    called_kwargs = {}

    class DummyResponse:
        def __init__(self):
            self.id = "dummy-response-id"
            # Provide tool_calls attribute to avoid AttributeError in parsing
            dummy_message = types.SimpleNamespace(
                content="dummy",
                tool_calls=[],
            )
            self.choices = [types.SimpleNamespace(message=dummy_message)]
            self.usage = types.SimpleNamespace(
                prompt_tokens=10, completion_tokens=5, prompt_tokens_details=None
            )

    async def dummy_create(*args, **kwargs):
        called_kwargs.update(kwargs)
        return DummyResponse()

    class DummyChatCompletions:
        def __init__(self):
            self.create = dummy_create

    class DummyChat:
        def __init__(self):
            self.completions = DummyChatCompletions()

    class DummyAsyncClient:
        def __init__(self, *args, **kwargs):
            pass

        @property
        def chat(self):
            return DummyChat()

    monkeypatch.setattr(openai, "AsyncClient", DummyAsyncClient)

    model = OpenAIChatModel(
        credential=OpenAICredential(api_key="test"),
        model="qwen-v1",
        stream=False,
        context_size=128_000,
        parameters=OpenAIChatModel.Parameters(thinking_enable=True),
    )

    await model([])

    # The thinking_enable parameter should be forwarded in extra_body
    assert "extra_body" in called_kwargs, "extra_body not passed in API call"
    assert (
        called_kwargs["extra_body"].get("enable_thinking") is True
    ), "thinking_enable not forwarded correctly"


