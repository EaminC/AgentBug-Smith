[32mimport unittest
from unittest.mock import patch, AsyncMock

from agentscope.model import OpenAIChatModel
from agentscope.credential import OpenAICredential


class TestQwenThinkingEnableForwarding(unittest.IsolatedAsyncioTestCase):
    """
    Tests that the thinking_enable parameter is properly forwarded to extra_body.enable_thinking
    in OpenAIChatModel when using Qwen models, allowing thinking mode to be toggled.
    """

    @patch("openai.AsyncClient")
    async def test_thinking_enable_forwarded_to_extra_body(self, mock_client_cls):
        """
        When thinking_enable=True is set on the model, the API call should include
        extra_body={"enable_thinking": True}.
        """
        # Setup model with thinking_enable=True
        model = OpenAIChatModel(
            credential=OpenAICredential(api_key="dummy"),
            model="qwen-v1",
            stream=False,
            context_size=128_000,
            parameters=OpenAIChatModel.Parameters(thinking_enable=True),
        )

        # Mock the async create call to return a dummy completion
        mock_create = AsyncMock()
        mock_create.return_value = AsyncMock()
        mock_create.return_value.id = "dummy-id"
        mock_create.return_value.choices = []
        mock_client_cls.return_value.chat.completions.create = mock_create

        # Call the model with empty messages
        await model([])

        # Assert that extra_body is passed and contains enable_thinking=True
        call_kwargs = mock_create.call_args.kwargs
        self.assertIn("extra_body", call_kwargs)
        self.assertEqual(call_kwargs["extra_body"], {"enable_thinking": True})

    @patch("openai.AsyncClient")
    async def test_thinking_disable_forwarded_to_extra_body(self, mock_client_cls):
        """
        When thinking_enable=False is set on the model, the API call should include
        extra_body={"enable_thinking": False}.
        This allows disabling thinking mode for structured output.
        """

        model = OpenAIChatModel(
            credential=OpenAICredential(api_key="dummy"),
            model="qwen-v1",
            stream=False,
            context_size=128_000,
            parameters=OpenAIChatModel.Parameters(thinking_enable=False),
        )

        mock_create = AsyncMock()
        mock_create.return_value = AsyncMock()
        mock_create.return_value.id = "dummy-id"
        mock_create.return_value.choices = []
        mock_client_cls.return_value.chat.completions.create = mock_create

        await model([])

        call_kwargs = mock_create.call_args.kwargs
        self.assertIn("extra_body", call_kwargs)
        self.assertEqual(call_kwargs["extra_body"], {"enable_thinking": False})


if __name__ == "__main__":
    unittest.main()[0m
