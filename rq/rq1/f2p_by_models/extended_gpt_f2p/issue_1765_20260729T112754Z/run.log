[32mimport unittest
from unittest.mock import patch, AsyncMock

from agentscope.model import OpenAIChatModel
from agentscope.credential import OpenAICredential
from agentscope.formatter._formatter_base import Msg


class TestQwenThinkingEnableForwarding(unittest.IsolatedAsyncioTestCase):
    """
    Fail2pass test for issue #1765:
    Verify that the thinking_enable parameter is properly forwarded to extra_body.enable_thinking
    in OpenAIChatModel when using Qwen models, especially when structured output is requested.
    """

    @patch("openai.AsyncClient")
    async def test_thinking_enable_passed_to_extra_body(self, mock_client_cls):
        # Setup a model with thinking_enable True (Qwen thinking mode enabled)
        model = OpenAIChatModel(
            credential=OpenAICredential(api_key="test"),
            model="qwen-v1",
            stream=False,
            context_size=128_000,
            parameters=OpenAIChatModel.Parameters(thinking_enable=True),
        )

        # Patch the AsyncClient chat.completions.create to capture call kwargs
        mock_create = AsyncMock(return_value=AsyncMock())
        mock_client_cls.return_value.chat.completions.create = mock_create

        # Prepare messages as list of Msg objects, not dicts, to avoid formatter errors
        # We create minimal Msg objects for the test
        # Since Msg class is abstract, we create dummy subclass for test
        class DummyMsg(Msg):
            def __init__(self, role: str, content: str):
                self.role = role
                self.content = content

        messages = [DummyMsg(role="user", content="Hello")]

        # Call the model with a dummy message and a structured_model to simulate structured output
        # structured_model triggers structured output mode which is incompatible with thinking mode
        await model(
            messages=messages,
            structured_model={"type": "object", "properties": {"answer": {"type": "string"}}},
        )

        # The call to chat.completions.create should include extra_body with enable_thinking=True
        called_kwargs = mock_create.call_args.kwargs
        self.assertIn("extra_body", called_kwargs)
        self.assertIsInstance(called_kwargs["extra_body"], dict)
        self.assertIn("enable_thinking", called_kwargs["extra_body"])
        self.assertTrue(called_kwargs["extra_body"]["enable_thinking"])

    @patch("openai.AsyncClient")
    async def test_thinking_enable_false_passed_to_extra_body(self, mock_client_cls):
        # Setup a model with thinking_enable False (thinking mode disabled)
        model = OpenAIChatModel(
            credential=OpenAICredential(api_key="test"),
            model="qwen-v1",
            stream=False,
            context_size=128_000,
            parameters=OpenAIChatModel.Parameters(thinking_enable=False),
        )

        mock_create = AsyncMock(return_value=AsyncMock())
        mock_client_cls.return_value.chat.completions.create = mock_create

        class DummyMsg(Msg):
            def __init__(self, role: str, content: str):
                self.role = role
                self.content = content

        messages = [DummyMsg(role="user", content="Hello")]

        await model(
            messages=messages,
            structured_model={"type": "object", "properties": {"answer": {"type": "string"}}},
        )

        called_kwargs = mock_create.call_args.kwargs
        self.assertIn("extra_body", called_kwargs)
        self.assertIsInstance(called_kwargs["extra_body"], dict)
        self.assertIn("enable_thinking", called_kwargs["extra_body"])
        self.assertFalse(called_kwargs["extra_body"]["enable_thinking"])

    @patch("openai.AsyncClient")
    async def test_thinking_enable_default_none_extra_body(self, mock_client_cls):
        # Setup a model with default thinking_enable (None)
        model = OpenAIChatModel(
            credential=OpenAICredential(api_key="test"),
            model="qwen-v1",
            stream=False,
            context_size=128_000,
        )

        mock_create = AsyncMock(return_value=AsyncMock())
        mock_client_cls.return_value.chat.completions.create = mock_create

        class DummyMsg(Msg):
            def __init__(self, role: str, content: str):
                self.role = role
                self.content = content

        messages = [DummyMsg(role="user", content="Hello")]

        await model(messages=messages)

        called_kwargs = mock_create.call_args.kwargs
        # When thinking_enable is None, extra_body should not include enable_thinking
        # It may or may not have extra_body at all, but if present it should not have enable_thinking
        if "extra_body" in called_kwargs:
            self.assertNotIn("enable_thinking", called_kwargs["extra_body"])


# The following is to allow running the test standalone
if __name__ == "__main__":
    unittest.main()[0m
