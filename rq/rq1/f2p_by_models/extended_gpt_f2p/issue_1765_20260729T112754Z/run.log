[32mimport unittest
from unittest.mock import AsyncMock, patch

from agentscope.credential import OpenAICredential
from agentscope.model import OpenAIChatModel


class TestQwenThinkingEnableForwarding(unittest.IsolatedAsyncioTestCase):
    """Fail2pass test for Qwen thinking_enable parameter forwarding bug.

    This test verifies that when using OpenAIChatModel with thinking_enable
    set, the parameter is properly forwarded to the API request's extra_body
    as enable_thinking, allowing disabling thinking mode when structured output
    is required.

    The buggy version does not forward thinking_enable to extra_body.enable_thinking,
    causing structured output to fail with Qwen models.
    """

    @patch("openai.AsyncClient")
    async def test_thinking_enable_passed_to_extra_body(self, mock_client_cls):
        # Setup a model with thinking_enable True (Qwen thinking mode enabled)
        model = OpenAIChatModel(
            credential=OpenAICredential(api_key="test"),
            model="qwen-v1",
            stream=False,
            context_size=128_000,
            parameters=OpenAIChatModel.Parameters(thinking_enable=True),
        )

        # Patch the AsyncClient chat.completions.create to capture call kwargs
        mock_create = AsyncMock(return_value=AsyncMock())
        mock_client_cls.return_value.chat.completions.create = mock_create

        # Call the model with a dummy message and a structured_model to simulate structured output
        # structured_model triggers structured output mode which is incompatible with thinking mode
        await model(
            messages=[{"role": "user", "content": "Hello"}],
            structured_model={"type": "object", "properties": {"answer": {"type": "string"}}},
        )

        # Extract the extra_body passed to the API call
        call_kwargs = mock_create.call_args.kwargs

        # Assert that extra_body is present and enable_thinking is set to True
        self.assertIn("extra_body", call_kwargs, "extra_body missing in API call kwargs")
        self.assertIn(
            "enable_thinking",
            call_kwargs["extra_body"],
            "enable_thinking missing in extra_body",
        )
        self.assertTrue(
            call_kwargs["extra_body"]["enable_thinking"],
            "enable_thinking should be True when thinking_enable=True",
        )

    @patch("openai.AsyncClient")
    async def test_thinking_enable_false_passed_to_extra_body(self, mock_client_cls):
        # Setup a model with thinking_enable False (thinking mode disabled)
        model = OpenAIChatModel(
            credential=OpenAICredential(api_key="test"),
            model="qwen-v1",
            stream=False,
            context_size=128_000,
            parameters=OpenAIChatModel.Parameters(thinking_enable=False),
        )

        # Patch the AsyncClient chat.completions.create to capture call kwargs
        mock_create = AsyncMock(return_value=AsyncMock())
        mock_client_cls.return_value.chat.completions.create = mock_create

        # Call the model with a dummy message and a structured_model to simulate structured output
        await model(
            messages=[{"role": "user", "content": "Hello"}],
            structured_model={"type": "object", "properties": {"answer": {"type": "string"}}},
        )

        # Extract the extra_body passed to the API call
        call_kwargs = mock_create.call_args.kwargs

        # Assert that extra_body is present and enable_thinking is set to False
        self.assertIn("extra_body", call_kwargs, "extra_body missing in API call kwargs")
        self.assertIn(
            "enable_thinking",
            call_kwargs["extra_body"],
            "enable_thinking missing in extra_body",
        )
        self.assertFalse(
            call_kwargs["extra_body"]["enable_thinking"],
            "enable_thinking should be False when thinking_enable=False",
        )

    @patch("openai.AsyncClient")
    async def test_thinking_enable_default_none_extra_body(self, mock_client_cls):
        # Setup a model without specifying thinking_enable (default None)
        model = OpenAIChatModel(
            credential=OpenAICredential(api_key="test"),
            model="qwen-v1",
            stream=False,
            context_size=128_000,
        )

        # Patch the AsyncClient chat.completions.create to capture call kwargs
        mock_create = AsyncMock(return_value=AsyncMock())
        mock_client_cls.return_value.chat.completions.create = mock_create

        # Call the model with a dummy message and no structured_model
        await model(messages=[{"role": "user", "content": "Hello"}])

        # Extract the extra_body passed to the API call
        call_kwargs = mock_create.call_args.kwargs

        # Assert that extra_body is not set when thinking_enable is not specified
        self.assertNotIn("extra_body", call_kwargs, "extra_body should not be present by default")


if __name__ == "__main__":
    unittest.main()[0m
