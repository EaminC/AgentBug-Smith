    @pytest.mark.asyncio
    async def test_anthropic_extended_thinking_blocks_preserved():
        """
        Test that AnthropicChatModel preserves 'thinking' and 'redacted_thinking' blocks
        exactly as returned by the API, avoiding modification that triggers InternalServerError 500.
        This test mocks the Anthropic client to simulate a multi-turn conversation with extended thinking.
        """
    
        # Prepare a mock Anthropic client that simulates the behavior of messages.create
        class MockAnthropicClient:
            def __init__(self):
                self.call_count = 0
    
            async def messages_create(self, **kwargs):
                # On first call, return a response with a redacted_thinking block
                if self.call_count == 0:
                    self.call_count += 1
                    # Simulate an Anthropic message response object with content blocks
                    class ContentBlock:
                        def __init__(self, type_, data=None, thinking=None, signature=None):
                            self.type = type_
                            self.data = data
                            self.thinking = thinking
                            self.signature = signature
    
                    class Response:
                        def __init__(self):
                            self.id = "msg-1"
                            self.content = [
                                ContentBlock(type_="thinking", thinking="visible thought", signature="sig_visible"),
                                ContentBlock(type_="redacted_thinking", data="encrypted_data_abc"),
                                ContentBlock(type_="text", text="Hello with thinking"),
                            ]
                            self.usage = type("Usage", (), {"input_tokens": 10, "output_tokens": 5, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0})()
    
                    return Response()
    
                # On second call, simulate the same response (replay) - should not modify thinking blocks
                elif self.call_count == 1:
                    self.call_count += 1
                    # Return the same response as above to simulate replay
                    class ContentBlock:
                        def __init__(self, type_, data=None, thinking=None, signature=None):
                            self.type = type_
                            self.data = data
                            self.thinking = thinking
                            self.signature = signature
    
                    class Response:
                        def __init__(self):
                            self.id = "msg-2"
                            self.content = [
                                ContentBlock(type_="thinking", thinking="visible thought", signature="sig_visible"),
                                ContentBlock(type_="redacted_thinking", data="encrypted_data_abc"),
                                ContentBlock(type_="text", text="Hello again with thinking"),
                            ]
                            self.usage = type("Usage", (), {"input_tokens": 10, "output_tokens": 5, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0})()
    
                    return Response()
    
                # Any further calls raise error to detect unexpected calls
                else:
                    raise RuntimeError("Unexpected call to messages.create")
    
        # Patch the Anthropic client inside AnthropicChatModel to use our mock client
        # We patch the 'client' attribute of AnthropicChatModel instance after creation
