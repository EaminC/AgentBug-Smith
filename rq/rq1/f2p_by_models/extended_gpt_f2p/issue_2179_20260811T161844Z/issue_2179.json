      "patch": "diff --git a/aider/models.py b/aider/models.py\nindex 9069e5103bc..a2800c7d126 100644\n--- a/aider/models.py\n+++ b/aider/models.py\n@@ -778,6 +778,11 @@ def configure_model_settings(self, model):\n             self.examples_as_sys_msg = True\n             self.reminder = \"user\"\n \n+        if \"o1-\" in model:\n+            self.use_system_prompt = False\n+            self.use_temperature = False\n+            self.streaming = False\n+\n         # use the defaults\n         if self.edit_format == \"diff\":\n             self.use_repo_map = True\n",
