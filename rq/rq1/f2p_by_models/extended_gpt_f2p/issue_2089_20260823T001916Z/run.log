async def test_bidi_agent_loop_send_respects_event_role():
    # Create a mock model with async start and send methods
    mock_model = unittest.mock.AsyncMock()
    # Create the agent with the mock model and no tools
    agent = BidiAgent(model=mock_model, tools=[])
    loop = agent._loop
    await loop.start()
    # Send a BidiTextInputEvent with role="assistant"
    await loop.send(BidiTextInputEvent(text="injected context", role="assistant"))
    # The last message appended should have role "assistant" not "user"
    assert agent.messages[-1] == {"role": "assistant", "content": [{"text": "injected context"}]}[0m
