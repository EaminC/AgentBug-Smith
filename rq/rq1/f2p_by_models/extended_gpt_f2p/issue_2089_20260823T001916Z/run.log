[32mimport pytest
import unittest.mock

from strands.experimental.bidi.agent import BidiAgent
from strands.experimental.bidi.types.events import BidiTextInputEvent


@pytest.mark.asyncio
async def test_bidi_agent_loop_send_respects_event_role():
    # Create an agent with a mocked model
    agent = BidiAgent(model=unittest.mock.AsyncMock())
    loop = agent._loop

    # Mock model start and send methods to avoid real network calls
    agent.model.start = unittest.mock.AsyncMock()
    agent.model.send = unittest.mock.AsyncMock()

    # Start the loop to initialize internal state
    await loop.start()

    # Send a BidiTextInputEvent with role "assistant"
    await loop.send(BidiTextInputEvent(text="injected context", role="assistant"))

    # The last message appended to agent.messages should have the role "assistant"
    assert agent.messages[-1] == {"role": "assistant", "content": [{"text": "injected context"}]}

    # Also verify that model.send was called with the event
    agent.model.send.assert_called_with(unittest.mock.ANY)


@pytest.mark.asyncio
