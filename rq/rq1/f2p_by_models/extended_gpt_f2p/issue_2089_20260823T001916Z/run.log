[32mimport pytest
import unittest.mock

from strands.experimental.bidi.agent.loop import BidiAgent
from strands.experimental.bidi.types.events import BidiTextInputEvent


@pytest.mark.asyncio
async def test_bidi_agent_loop_send_respects_event_role():
    # Create a mock model with async start and send methods
    mock_model = unittest.mock.AsyncMock()
    # Create the agent with the mock model
    agent = BidiAgent(model=mock_model, tools=[])
    loop = agent._loop

    # Start the loop (which calls model.start internally)
    await loop.start()

    # Send a BidiTextInputEvent with role "assistant"
    event = BidiTextInputEvent(text="injected context", role="assistant")
    await loop.send(event)

    # The last message appended to agent.messages should have the role from the event, not hardcoded "user"
    assert agent.messages[-1] == {"role": "assistant", "content": [{"text": "injected context"}]}

    # Also verify that model.send was called with the event
    mock_model.send.assert_awaited_with(event)[0m
