[32mFROM python:3.12-slim

# Set working directory
WORKDIR /app

# Set mandatory Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Copy entire repository
COPY . .

# Detect if "src" directory exists or tests import from "src."
# To avoid editable install if src/ layout is detected.
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." strands-py/tests 2>/dev/null; then \
      python -m pip install --upgrade pip setuptools wheel; \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout pytest-block-network; \
      if [ -f "strands-py/requirements.txt" ]; then pip install -r strands-py/requirements.txt; fi; \
      # Set PYTHONPATH to ensure single-source import for src/ layout \
      echo "src/ layout detected, skipping editable install and setting PYTHONPATH"; \
    else \
      python -m pip install --upgrade pip setuptools wheel; \
      if [ -f "strands-py/requirements.txt" ]; then pip install -r strands-py/requirements.txt; fi; \
      pip install -e strands-py; \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout pytest-block-network; \
      echo "No src/ layout detected, performed editable install"; \
    fi

# If src/ layout detected, set PYTHONPATH to /app to avoid module identity conflicts
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." strands-py/tests 2>/dev/null; then \
      echo "Setting PYTHONPATH=/app due to src/ layout"; \
      echo "export PYTHONPATH=/app" >> /etc/profile.d/pythonpath.sh; \
    fi

# Preflight import check to fail fast if core modules missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Assumption: test scripts are inside strands-py directory; run tests using pytest
# Run tests to verify installation
RUN pytest --maxfail=1 --disable-warnings -q strands-py/tests

