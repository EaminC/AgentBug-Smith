import tempfile
import shutil
from unittest.mock import patch, MagicMock
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from gpt_engineer.ai import AI
from gpt_engineer.chat_to_files import parse_chat, to_files
from gpt_engineer.steps import gen_code


def test_philosophy_prompt_respects_language_choice():
    """
    Test that the philosophy preprompt includes the line
    "Always use the programming language the user asks for."
    and that the AI respects it when generating code for a non-Python language.
    """
    # First, verify the philosophy preprompt contains the required line
    philosophy_path = os.path.join(
        os.path.dirname(__file__), "..", "gpt_engineer", "preprompts", "philosophy"
    )
    with open(philosophy_path, "r") as f:
        philosophy_content = f.read()
    assert (
        "Always use the programming language the user asks for." in philosophy_content
    ), "Philosophy preprompt must contain the language instruction."

    # Create a temporary project directory
    with tempfile.TemporaryDirectory() as tmpdir:
        prompt_path = os.path.join(tmpdir, "prompt")
        with open(prompt_path, "w") as f:
            f.write(
                "Create a simple 'Hello, World!' program in JavaScript. Do not use Python."
            )

        # Mock the AI's start method to return a chat that includes JavaScript code
        mock_response = MagicMock()
        mock_response.content = """
I'll create a simple Hello World program in JavaScript.

Here's the code:

```javascript
// hello.js
console.log("Hello, World!");
```

That's it.
"""
        mock_ai_instance = MagicMock()
        mock_ai_instance.start.return_value = [{"content": mock_response.content}]

        with patch.object(AI, "__new__", return_value=mock_ai_instance):
            with patch.object(AI, "__init__", return_value=None):
                # Run gen_code which uses the AI
                chat = gen_code(prompt_path, "gpt-4", False, False, False)

        # Parse the chat to files
        files = parse_chat(chat)
        file_dict = {}
        to_files(files, tmpdir, file_dict)

        # Check that we have a JavaScript file, not a Python file
        js_files = [f for f in file_dict.keys() if f.endswith(".js")]
        py_files = [f for f in file_dict.keys() if f.endswith(".py")]

        # In buggy version, the AI might generate Python despite the prompt.
        # The fix ensures the philosophy preprompt instructs to use the requested language.
        # So we assert that there is at least one JavaScript file and no Python files.
        assert len(js_files) > 0, "Expected at least one JavaScript file."
        assert len(py_files) == 0, "Should not generate Python files when JavaScript is requested."

        # Additionally, check the content of the first JavaScript file
        if js_files:
            content = file_dict[js_files[0]]
            assert "console.log" in content or "Hello, World" in content, \
                "JavaScript file should contain Hello World code."[0m
