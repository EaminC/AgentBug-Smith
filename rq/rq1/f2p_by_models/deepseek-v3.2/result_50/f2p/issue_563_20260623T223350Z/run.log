from gpt_engineer.steps import gen_code


def test_gen_code_respects_language_request():
    """
    Test that gen_code step respects the user's requested language.
    The bug: the philosophy preprompt didn't explicitly tell the AI to use the language the user asks for.
    The fix: added "Always use the programming language the user asks for." to philosophy.
    We'll mock the AI's chat completion to simulate a response that should be in the requested language.
    """
    # Create a temporary directory for the project
    with tempfile.TemporaryDirectory() as tmpdir:
        project_path = Path(tmpdir)
        # Write a prompt that explicitly requests JavaScript (NodeJS) and forbids Python
        prompt = (
            "Create a simple 'Hello World' web server using NodeJS. "
            "Do NOT use Python. Use JavaScript/NodeJS only."
        )
        prompt_file = project_path / "prompt"
        prompt_file.write_text(prompt)

        # We need to mock the AI's chat completion to return a response that includes
        # a NodeJS file (e.g., index.js) and a package.json.
        # The buggy version would ignore the language request and still generate Python files.
        # We'll mock the internal OpenAI client call in the AI class.
        # The AI class uses `openai.chat.completions.create`.
        # We'll patch that method to return a canned response.

        # Build the mock response structure that mimics OpenAI's API
        mock_choice = MagicMock()
        mock_choice.message.content = json.dumps([
            {"file": "package.json", "code": json.dumps({"name": "test", "version": "1.0.0", "main": "index.js"})},
            {"file": "index.js", "code": "const http = require('http');\nconst server = http.createServer((req, res) => {\n  res.writeHead(200, {'Content-Type': 'text/plain'});\n  res.end('Hello World');\n});\nserver.listen(3000);"},
        ])

        mock_response = MagicMock()
        mock_response.choices = [mock_choice]

        # Patch the openai client used by the AI class
        with patch('openai.chat.completions.create', return_value=mock_response) as mock_create:
            # Also patch the AI's cost tracking to avoid side effects
            with patch.object(AI, 'update_cost', return_value=None):
                # Run the gen_code step
                ai = AI(model="gpt-4", temperature=0.1)
                gen_code(ai, prompt, project_path)

        # After gen_code, check that the generated files are NodeJS files, not Python.
        # The buggy version would generate Python files (e.g., main.py, requirements.txt).
        # The fixed version should generate the files we requested in the mock.
        # We'll assert that no Python files were generated (no .py files, no requirements.txt).
        # Actually, we can't guarantee the mock is used correctly? But we can check that the
        # generated files match the mocked response (since we control the mock).
        # However, the bug is about the AI's actual behavior, not our mock.
        # We need to test that the AI's prompt includes the language instruction.
        # Better: we can inspect the messages sent to the mock to ensure the philosophy
        # preprompt includes the language line.
        # Let's capture the call arguments and check the system message.

        # Get the call arguments to openai.chat.completions.create
        call_args = mock_create.call_args
        # The first argument is the list of messages
        messages = call_args.kwargs.get('messages', [])
        # Find the system message (role 'system')
        system_messages = [m for m in messages if m.get('role') == 'system']
        assert len(system_messages) > 0
        system_message = system_messages[0]['content']

        # The buggy philosophy preprompt lacks the line "Always use the programming language the user asks for."
        # The fixed version includes it.
        # We'll assert that the system message contains that line.
        # However, the system message is built from multiple preprompts (including philosophy).
        # We'll check that the concatenated system message includes the line.
        # Since we can't guarantee the exact wording, we'll check for a substring that is added in the fix.
        # The fix adds: "Always use the programming language the user asks for."
        # Let's check for "programming language the user asks for".
        assert "programming language the user asks for" in system_message, \
            f"Expected philosophy preprompt to instruct using the requested language, but got:\n{system_message}"

        # Additionally, we can verify that the generated files are indeed NodeJS files.
        # The mock response we provided includes package.json and index.js.
        # The gen_code step should have written those files.
        assert (project_path / "package.json").exists()
        assert (project_path / "index.js").exists()
        # Ensure no Python files were generated (the mock didn't include any, but the AI might have added them
        # if the bug were present? Actually the mock forces the response, so the AI can't add extra files.
        # However, we can still check that no .py files exist.
        py_files = list(project_path.glob("*.py"))
        assert len(py_files) == 0, f"Found Python files when NodeJS was requested: {py_files}"
        # Also no requirements.txt
        assert not (project_path / "requirements.txt").exists()


def test_gen_code_uses_requested_language_integration():
    """
    A more realistic integration test: simulate a full run with a mocked AI that returns
    language-specific files based on the prompt.
    We'll test two languages: NodeJS and Python, ensuring the AI's system prompt includes the language instruction.
    """
    # We'll test with a prompt that requests Rust (to avoid confusion with Python).
    with tempfile.TemporaryDirectory() as tmpdir:
        project_path = Path(tmpdir)
        prompt = "Create a simple 'Hello, world!' in Rust. Do not use any other language."
        prompt_file = project_path / "prompt"
        prompt_file.write_text(prompt)

        # Mock response: a Rust Cargo.toml and main.rs
        mock_choice = MagicMock()
        mock_choice.message.content = json.dumps([
            {"file": "Cargo.toml", "code": "[package]\nname = \"hello\"\nversion = \"0.1.0\"\nedition = \"2021\""},
            {"file": "src/main.rs", "code": "fn main() {\n    println!(\"Hello, world!\");\n}"},
        ])
        mock_response = MagicMock()
        mock_response.choices = [mock_choice]

        with patch('openai.chat.completions.create', return_value=mock_response):
            with patch.object(AI, 'update_cost', return_value=None):
                ai = AI(model="gpt-4", temperature=0.1)
                gen_code(ai, prompt, project_path)

        # Check that the system message sent to the AI includes the language instruction.
        # We need to capture the call again.
        # Since we are inside the patch context, we can import openai and check the last call.
        import openai
        call_args = openai.chat.completions.create.call_args
        messages = call_args.kwargs.get('messages', [])
        system_content = "\n".join(m['content'] for m in messages if m.get('role') == 'system')
        # The fixed philosophy preprompt includes the line.
        assert "Always use the programming language the user asks for." in system_content, \
            "The system prompt must instruct to use the requested language."

        # Verify the generated files are Rust files (from our mock).
        assert (project_path / "Cargo.toml").exists()
        assert (project_path / "src" / "main.rs").exists()
        # No Python files
        assert len(list(project_path.glob("**/*.py"))) == 0


