def test_agent_uses_requested_language_not_just_python():
    """
    Test that the agent respects the requested programming language,
    not defaulting to Python when another language is explicitly requested.

    The bug: the philosophy preprompt didn't explicitly instruct to use the
    language the user asks for, causing the agent to default to Python.

    The fix: added "Always use the programming language the user asks for."
    to the philosophy preprompt.

    We test by mocking the internal OpenAI client call to return a simple
    JavaScript file when the prompt requests JavaScript, and verifying the
    generated code is JavaScript, not Python.
    """
    # First, ensure the philosophy preprompt contains the directive.
    # This test will pass after the fix, fail before.
    with open("gpt_engineer/preprompts/philosophy", "r") as f:
        content = f.read()
    assert "Always use the programming language the user asks for." in content, \
        "Philosophy preprompt should instruct to use the requested language"

    # Now test the actual agent behavior.
    # We need to mock the OpenAI API call inside the AI module.
    # The AI module uses openai.ChatCompletion.create (or similar) directly.
    # We'll mock that at the module level where it's used.
    import openai
    from gpt_engineer.ai import AI
    from gpt_engineer.chat_to_files import parse_chat, to_files
    from gpt_engineer.db import DBs

    # Create a temporary directory for the test project
    with tempfile.TemporaryDirectory() as tmpdir:
        # Set up a mock response that returns JavaScript code.
        # The response format should match what parse_chat expects.
        mock_response = MagicMock()
        # Simulate a chat message with JavaScript code.
        mock_message = MagicMock()
        mock_message.content = """
Here is the code:

```javascript
// main.js
console.log("Hello, world!");
```
"""
        mock_response.choices = [MagicMock(message=mock_message)]

        # Patch the openai.ChatCompletion.create method to return our mock.
        with patch.object(openai.ChatCompletion, 'create', return_value=mock_response):
            # Create an AI instance with a dummy API key.
            ai = AI(model="gpt-4", temperature=0.1, api_key="dummy_key")

            # Create a DBs instance with the temporary directory as workspace.
            memory_db = DBs(
                memory=os.path.join(tmpdir, "memory"),
                logs=os.path.join(tmpdir, "logs"),
                preprompts=os.path.join(tmpdir, "preprompts"),
                input=os.path.join(tmpdir, "input"),
                workspace=os.path.join(tmpdir, "workspace"),
                archive=None
            )

            # Write a prompt that explicitly requests JavaScript.
            prompt = "Create a simple hello world program in JavaScript, not Python."
            with open(os.path.join(tmpdir, "input", "prompt"), "w") as f:
                f.write(prompt)

            # Run the agent's generation step.
            # We'll call the ai.start method which is used in steps.py.
            # The ai.start method takes a system prompt and a user prompt.
            # We'll use the generate preprompt as system.
            generate_preprompt_path = "gpt_engineer/preprompts/generate"
            with open(generate_preprompt_path, "r") as f:
                generate_preprompt = f.read()

            # Also include the philosophy preprompt in the system prompt.
            with open("gpt_engineer/preprompts/philosophy", "r") as f:
                philosophy_preprompt = f.read()

            system_prompt = generate_preprompt + "\n" + philosophy_preprompt
            messages = ai.start(system_prompt, prompt)

            # Parse the chat into files.
            parse_chat(messages[-1]["content"])
            # The parse_chat function returns a list of tuples (filename, content).
            # We'll use to_files to write them to the workspace.
            to_files(parse_chat(messages[-1]["content"]), memory_db.workspace)

            # Check that the generated file is JavaScript, not Python.
            workspace_files = os.listdir(memory_db.workspace)
            # There should be at least one file.
            assert len(workspace_files) > 0, "No files generated"
            # Check each file's content for JavaScript, not Python.
            for file in workspace_files:
                filepath = os.path.join(memory_db.workspace, file)
                with open(filepath, "r") as f:
                    content = f.read()
                # The buggy version might still generate Python despite the request.
                # We assert that the content is not Python (i.e., does not contain
                # a Python shebang or typical Python syntax) and is JavaScript.
                # Since we mocked the response to return JavaScript, this should pass.
                # But we also want to ensure the agent didn't ignore the language request.
                # We'll check that the file extension is .js or .javascript, or that
                # the content contains JavaScript keywords.
                if file.endswith('.py'):
                    # If a Python file is generated, that's a bug.
                    # Check that it's not the main file.
                    # In the buggy version, the agent might generate Python.
                    # We'll fail the test if a .py file is present.
                    raise AssertionError(f"Generated a Python file {file} when JavaScript was requested")
                # Also check content for Python shebang.
                if content.startswith('#!/usr/bin/env python'):
                    raise AssertionError(f"Generated Python shebang in {file} when JavaScript was requested")
                # Positive check: content should contain JavaScript.
                if 'console.log' in content or 'function' in content or 'var ' in content or 'let ' in content or 'const ' in content:
                    # This is good.
                    pass
                else:
                    # Might be a non-code file (like README). Accept it.
                    pass

            # Additionally, verify that the generated code matches our mock.
            # The mock returns a file named main.js.
            expected_file = os.path.join(memory_db.workspace, "main.js")
            assert os.path.exists(expected_file), "main.js should have been generated"
            with open(expected_file, "r") as f:
                js_content = f.read()
            assert 'console.log("Hello, world!")' in js_content, "Generated JavaScript content mismatch"

