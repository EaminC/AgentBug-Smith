def test_studio_pre_print_hook_graceful_degradation_on_connection_error():
    """Test that the pre_print hook logs a warning and returns instead of raising."""
    # Register hook with a non-existent Studio URL to force connection error
    TestAgent.register_class_hook(
        "pre_print",
        "studio_forward",
        lambda self, kwargs: as_studio_forward_message_pre_print_hook(
            self, kwargs, studio_url="http://127.0.0.1:9999", run_id="test"
        ),
    )

    agent = TestAgent(name="TestAgent")
    msg = Msg("user", [TextBlock(type="text", text="Hello")], "user")

    # Mock the logger.warning to capture the warning message
    with patch("agentscope.hooks._studio_hooks.logger") as mock_logger:
        # Run the agent's reply which triggers the hook
        asyncio.run(agent.reply(msg))

        # In buggy code, this would raise ConnectionError and test would fail.
        # After fix, it should log warning and return gracefully.
        # Verify warning was logged with expected message.
        mock_logger.warning.assert_called_once()
        call_args = mock_logger.warning.call_args[0]
        assert "Failed to forward message to Studio after" in call_args[0]
        assert "Agent will continue without Studio forwarding." in call_args[0]


