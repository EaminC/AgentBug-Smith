[32mFROM python:3.12-slim

WORKDIR /app

# Copy the entire repository (including externally injected test scripts)
COPY . .

# Set environment variables for Forge
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Detect src/ layout and conditionally install dependencies
# If src/ directory exists or tests import from src., we set PYTHONPATH and
# install only external dependencies (not the project itself) to avoid duplicate
# module loading. Otherwise, we perform an editable install.
RUN python -m pip install --upgrade pip setuptools wheel && \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
