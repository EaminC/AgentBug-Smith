[32mimport json
import pytest
from unittest.mock import patch, MagicMock
from crewai.agent import Agent
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.task import Task
from crewai.utilities.planning_handler import CrewPlanner


def test_knowledge_not_included_in_planning_before_fix():
    """
    This test verifies that knowledge is NOT included in the planning process
    before the fix, and IS included after the fix.
    
    In the buggy code, the _create_tasks_summary method does not include
    agent knowledge in the task summary. After the fix, it should include it.
    """
    # Create an agent with knowledge
    agent = Agent(
        role="Researcher",
        goal="Research AI",
        backstory="Expert",
        knowledge_sources=[
            StringKnowledgeSource(content="AI requires training data.")
        ]
    )
    
    # Create a task for the agent
    task = Task(
        description="Explain AI",
        expected_output="Explanation",
        agent=agent
    )
    
    # Create a crew planner
    planner = CrewPlanner([task], None)
    
    # Get the task summary
    task_summary = planner._create_tasks_summary()
    
    # In the buggy code, knowledge should NOT be included
    # After the fix, knowledge SHOULD be included
    # We'll assert based on whether the fix is applied
    
    # Check if knowledge content appears in the summary
    knowledge_included = "AI requires training data." in task_summary
    knowledge_field_present = '"agent_knowledge"' in task_summary
    
    # Before fix: knowledge_included = False, knowledge_field_present = False
    # After fix: knowledge_included = True, knowledge_field_present = True
    
    # This assertion will fail before the fix and pass after
    assert knowledge_included, "Knowledge content should be included in task summary"
    assert knowledge_field_present, "agent_knowledge field should be present in task summary"
    
    # Also verify the format is correct
    if knowledge_included:
        # Check it's properly quoted/escaped
        assert '"[\\"AI requires training data.\\"]"' in task_summary or '"agent_knowledge"' in task_summary


@patch('crewai.knowledge.storage.knowledge_storage.chromadb')
def test_knowledge_inclusion_with_mocked_chroma(mock_chroma):
    """Test knowledge inclusion with ChromaDB mocked."""
    # Mock ChromaDB collection
    mock_collection = mock_chroma.return_value.get_or_create_collection.return_value
    mock_collection.add.return_value = None
    
    # Create agent with knowledge
    agent = Agent(
        role="Scientist",
        goal="Study",
        backstory="Background",
        knowledge_sources=[
            StringKnowledgeSource(content="Important scientific fact.")
        ]
    )
    
    task = Task(
        description="Study topic",
        expected_output="Report",
        agent=agent
    )
    
    planner = CrewPlanner([task], None)
    task_summary = planner._create_tasks_summary()
    
    # Before fix: these will fail
    # After fix: these will pass
    assert "Important scientific fact." in task_summary
    assert '"agent_knowledge"' in task_summary


def test_no_knowledge_field_when_knowledge_empty():
    """Test that agent_knowledge field is not present when knowledge is empty."""
    agent = Agent(
        role="Analyst",
        goal="Analyze",
        backstory="Background"
    )
    
    task = Task(
        description="Analyze data",
        expected_output="Analysis",
        agent=agent
    )
    
    planner = CrewPlanner([task], None)
    task_summary = planner._create_tasks_summary()
    
    # Both before and after fix: no knowledge field when empty
    assert '"agent_knowledge"' not in task_summary


@patch('crewai.knowledge.storage.knowledge_storage.chromadb')
def test_multiple_knowledge_sources(mock_chroma):
    """Test with multiple knowledge sources."""
    mock_collection = mock_chroma.return_value.get_or_create_collection.return_value
    mock_collection.add.return_value = None
    
    agent = Agent(
        role="Historian",
        goal="Document history",
        backstory="Expert",
        knowledge_sources=[
            StringKnowledgeSource(content="First fact."),
            StringKnowledgeSource(content="Second fact.")
        ]
    )
    
    task = Task(
        description="Document events",
        expected_output="Timeline",
        agent=agent
    )
    
    planner = CrewPlanner([task], None)
    task_summary = planner._create_tasks_summary()
    
    # Before fix: fails
    # After fix: passes (only first knowledge source is included per the patch)
    assert '"agent_knowledge"' in task_summary
    # The patch only includes the first knowledge source
    assert "First fact." in task_summary


