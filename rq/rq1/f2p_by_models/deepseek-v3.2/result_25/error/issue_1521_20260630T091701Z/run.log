    def test_extract_thought_receives_none_raises_typeerror_buggy(self):
        """Test that _extract_thought raises TypeError when text is None (buggy)."""
        # Create a parser instance
        parser = CrewAgentParser()
        # In buggy code, _extract_thought does not handle None input
        # and re.search will raise TypeError.
        # We call the method directly with None to trigger the bug.
        with pytest.raises(TypeError) as exc_info:
            parser._extract_thought(None)
        assert "expected string or bytes-like object" in str(exc_info.value)

    def test_crew_agent_executor_raises_on_none_llm_response_fixed(self):
        """Test that CrewAgentExecutor raises ValueError on None/empty LLM response after fix."""
        # Mock the LLM call to return None, simulating the condition that triggers the bug.
