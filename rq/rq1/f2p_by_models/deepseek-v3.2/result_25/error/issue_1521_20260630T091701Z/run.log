        # Create a CrewAgent with a mocked LLM that returns None.
        mock_llm = MagicMock()
        mock_llm.llm = "gpt-3.5-turbo"
        mock_llm.temperature = 0
        mock_llm.top_p = 1
        mock_llm.frequency_penalty = 0
        mock_llm.presence_penalty = III0
        mock_llm.max_tokens = None
        mock_llm.max_retries = 2
        mock_llm.call = MagicMock(return_value=None)  # Simulate None response

        agent = CrewAgent(
            role="test",
            goal="test",
            backstory="test",
            llm=mock_llm,
            verbose=False,
            allow_delegation=False,
        )
        executor = CrewAgentExecutor(
            agent=agent,
            tools=[],
            verbose=False,
            max_iterations=15,
            early_stopping_method="force",
            callbacks=None,
            use_stop_words=True,
        )
        # Mock the _printer to avoid side effects.
        executor._printer = MagicMock()
        # In buggy code, _invoke_loop would proceed with None answer and cause TypeError later.
        # After fix, _invoke_loop should raise ValueError when answer is None.
        # We'll call _invoke_loop directly (it's private but we need to test).
        # However, _invoke_loop is a generator; we can iterate it.
        # But the error occurs inside the loop when answer is None.
        # Let's simulate the call that leads to _extract_thought.
        # Instead, we can test the public execute_task method.
        # But we need to mock the LLM call inside the executor's _call_llm.
        # Let's patch the litellm.completion call used by the LLM.
        with patch('litellm.completion', return_value=None):
            # In buggy code, this would cause TypeError in _extract_thought.
            # After fix, it should raise ValueError from _invoke_loop.
            # However, the executor catches exceptions and returns them as output?
            # Let's examine the actual flow: execute_task -> _invoke_loop -> _call_llm -> litellm.completion.
            # The fix adds a check after answer is received.
            # We'll call _invoke_loop directly with a mocked _call_llm.
            executor._call_llm = MagicMock(return_value=None)
            # The loop will break after first iteration because answer is None.
            # In buggy code, it would continue and cause TypeError.
            # After fix, it raises ValueError.
            with pytest.raises(ValueError) as exc_info:
                # _invoke_loop is a generator; we need to iterate it.
                # But the check is inside the loop before yielding.
                # Let's call the method that triggers the loop: execute_task.
                # However, execute_task may catch the exception and wrap it.
                # Let's directly test the _invoke_loop's internal logic.
                # We'll monkey-patch the _invoke_loop to call the part that raises.
                # Actually, the fix is in _invoke_loop: after answer is received, if answer is None or empty, raise ValueError.
                # So we can call _invoke_loop and iterate it.
                list(executor._invoke_loop())
            assert "Invalid response from LLM call - None or empty." in str(exc_info.value)

