[32mimport os
import sys
import pytest
from unittest.mock import patch, MagicMock
from crewai.agents.crew_agent_executor import CrewAgentExecutor
from crewai.agents.parser import CrewAgentParser
from crewai.llm import LLM
from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew
from crewai.process import Process


class TestCrewAgentExecutorBug1521:
    """Test for bug #1521: TypeError in _extract_thought due to NoneType input."""

    def test_extract_thought_receives_none_causes_typeerror(self):
        """In buggy version, _extract_thought receives None and raises TypeError.
        In fixed version, the LLM call raises ValueError before parser is called.
        """
        # Create a minimal crew with a task that has output_file
        writer = Agent(
            role="Writer",
            goal="Write a report",
            backstory="Expert writer",
            llm=LLM(
                model="gpt-3.5-turbo",
                temperature=0.7,
            ),
            allow_delegation=False,
        )

        task = Task(
            description="Write a report about AI",
            agent=writer,
            output_file="/tmp/test_report.md",
        )

        crew = Crew(
            agents=[writer],
            tasks=[task],
            process=Process.sequential,
            verbose=False,
        )

        # Mock the LLM call to return None, which triggers the bug
        with patch.object(LLM, 'call') as mock_llm_call:
            mock_llm_call.return_value = None

            # In buggy version, this will proceed to parser and cause TypeError
            # In fixed version, this should raise ValueError from crew_agent_executor
            try:
                crew.kickoff()
                # If we reach here in buggy version, the test should fail because
                # the TypeError wasn't raised (or was caught somewhere else).
                # We'll check that the parser's _extract_thought was called with None
                # by inspecting the error logs or checking that output file wasn't created.
                # However, the simplest is to ensure that if we get here without exception,
                # the buggy version didn't crash as expected, so we need to assert something
                # that will fail on buggy but pass on fixed.
                # Actually, the fixed version raises ValueError, so we shouldn't reach here.
                # So if we reach here, it's buggy (no exception) and test should fail.
                pytest.fail("Expected ValueError from LLM call returning None, but no exception was raised.")
            except ValueError as e:
                # Fixed version: ValueError raised by crew_agent_executor
                assert "Invalid response from LLM call - None or empty." in str(e)
                # Test passes for fixed version
                return
            except TypeError as e:
                # Buggy version: TypeError from re.search in _extract_thought
                assert "expected string or bytes-like object" in str(e)
                # Test fails for buggy version (raises exception -> pytest will mark as error/failure)
                # But we need to re-raise so pytest sees it as a test failure.
                raise
            except Exception as e:
                # Any other exception is unexpected
                raise

    def test_extract_thought_receives_empty_string_causes_no_error(self):
        """Empty string should not cause TypeError, but fixed version raises ValueError."""
        writer = Agent(
            role="Writer",
            goal="Write a report",
            backstory="Expert writer",
            llm=LLM(
                model="gpt-3.5-turbo",
                temperature=0.7,
            ),
            allow_delegation=False,
        )

        task = Task(
            description="Write a report about AI",
            agent=writer,
            output_file="/tmp/test_report2.md",
        )

        crew = Crew(
            agents=[writer],
            tasks=[task],
            process=Process.sequential,
            verbose=False,
        )

        with patch.object(LLM, 'call') as mock_llm_call:
            mock_llm_call.return_value = ""

            try:
                crew.kickoff()
                pytest.fail("Expected ValueError from LLM call returning empty string.")
            except ValueError as e:
                assert "Invalid response from LLM call - None or empty." in str(e)
                # Pass for fixed version
                return
            except Exception:
                # Buggy version might not raise; if it proceeds, test fails.
                # But buggy version might raise something else? We'll let it fail.
                raise

    def test_parser_extract_thought_handles_none_gracefully(self):
        """Direct test of parser's _extract_thought method with None input.
        This is a unit test to confirm the parser itself doesn't handle None.
        """
        parser = CrewAgentParser(llm=MagicMock(), tools=[], callbacks=None)
        # In buggy version, this will raise TypeError
        # In fixed version, the parser might still have the same bug, but the upstream
        # check prevents None from reaching it. However, we test the parser directly.
        with pytest.raises(TypeError) as excinfo:
            parser._extract_thought(None)
        assert "expected string or bytes-like object" in str(excinfo.value)
        # This test passes for both buggy and fixed because the parser method unchanged.
        # The fix is upstream.

    def test_integration_with_mocked_llm_returning_none(self):
        """Integration test that triggers the bug scenario."""
        # Use a simple crew with output_file
        import tempfile
        tmpdir = tempfile.mkdtemp()
        output_file = os.path.join(tmpdir, "report.md")

        writer = Agent(
            role="Writer",
            goal="Write a report",
            backstory="Expert writer",
            llm=LLM(
                model="gpt-3.5-turbo",
                temperature=0.7,
            ),
            allow_delegation=False,
        )

        task = Task(
            description="Write a report about AI",
            agent=writer,
            output_file=output_file,
        )

        crew = Crew(
            agents=[writer],
            tasks=[task],
            process=Process.sequential,
            verbose=False,
        )

        # Mock the internal litellm.completion call to return None
        with patch('litellm.completion') as mock_litellm:
            mock_litellm.return_value = None

            try:
                crew.kickoff()
                # If we get here in buggy version, test should fail.
                # We'll check if file exists (it shouldn't).
                if os.path.exists(output_file):
                    # Unexpected success in buggy version? Actually buggy version would crash earlier.
                    # But if crash is caught somewhere, file might not be written.
                    pass
                # This assertion will fail in buggy version because no exception was raised.
                pytest.fail("Expected exception from LLM returning None.")
            except ValueError as e:
                # Fixed version
                assert "Invalid response from LLM call - None or empty." in str(e)
            except TypeError as e:
                # Buggy version
                assert "expected string or bytes-like object" in str(e)
                raise  # re-raise to make test fail
            except Exception as e:
                # Something else went wrong
                raise

