[32mimport os
import sys
import pytest
from unittest.mock import patch, MagicMock
from crewai import Crew, Agent, Task, LLM
from crewai.agents.crew_agent_executor import CrewAgentExecutor
from crewai.agents.parser import CrewAgentParser


class TestCrewAgentExecutorNoneResponse:
    """Test that CrewAgentExecutor raises ValueError when LLM returns None/empty."""

    def test_llm_none_response_raises_value_error_buggy(self):
        """On buggy code, None response leads to TypeError in _extract_thought.
        
        The buggy code passes None to _extract_thought, causing TypeError.
        After fix, CrewAgentExecutor raises ValueError before parsing.
        """
        # Mock LLM to return None
        with patch.object(LLM, 'call') as mock_llm_call:
            mock_llm_call.return_value = None

            # Create minimal crew with one agent and task
            llm = LLM(model="gpt-4")
            agent = Agent(
                role="test",
                goal="test",
                backstory="test",
                llm=llm,
                allow_delegation=False,
            )
            task = Task(
                description="test",
                agent=agent,
                expected_output="test",
            )
            crew = Crew(
                agents=[agent],
                tasks=[task],
                verbose=False,
            )

            # On buggy code, this will cause TypeError inside parser._extract_thought
            # because answer is None and gets passed to regex search.
            # After fix, CrewAgentExecutor._invoke_loop should raise ValueError.
            with pytest.raises(Exception) as exc_info:
                crew.kickoff()

            # In buggy code, the exception is TypeError from re.search.
            # In fixed code, it's ValueError from _invoke_loop.
            # We'll assert the exception type changes after patch.
            # For the test to be fail2pass, we need the buggy version to fail.
            # Let's check if it's TypeError (bug) or ValueError (fix).
            # But we can't know which version we're running.
            # Instead, we'll assert that the exception message contains
            # either "TypeError" (bug) or "Invalid response from LLM" (fix).
            # However, the test must fail on buggy, pass on fixed.
            # We'll write a test that expects ValueError after fix.
            # On buggy, it will raise TypeError, which is not ValueError -> test fails.
            # On fixed, it raises ValueError -> test passes.
            # So we assert that the exception is ValueError.
            assert isinstance(exc_info.value, ValueError)
            assert "Invalid response from LLM" in str(exc_info.value)

    def test_llm_empty_response_raises_value_error_buggy(self):
        """Empty string response should also raise ValueError after fix."""
        with patch.object(LLM, 'call') as mock_llm_call:
            mock_llm_call.return_value = ""

            llm = LLM(model="gpt-4")
            agent = Agent(
                role="test",
                goal="test",
                backstory="test",
                llm=llm,
                allow_delegation=False,
            )
            task = Task(
                description="test",
                agent=agent,
                expected_output="test",
            )
            crew = Crew(
                agents=[agent],
                tasks=[task],
                verbose=False,
            )

            with pytest.raises(ValueError) as exc_info:
                crew.kickoff()

            assert "Invalid response from LLM" in str(exc_info.value)

    def test_llm_valid_response_no_exception(self):
