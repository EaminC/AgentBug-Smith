from unittest.mock import patch, MagicMock
from crewai import Agent, Task, Crew
from crewai.agents.parser import CrewAgentParser
from crewai.llm import LLM


def test_extract_thought_none_input_raises_error():
    """Test that _extract_thought raises TypeError when text is None (buggy) or ValueError when LLM returns None (fixed)."""
    # Create a parser instance
    parser = CrewAgentParser()
    
    # In buggy version, _extract_thought receives None and re.search raises TypeError
    # We'll test the actual method directly
    with pytest.raises(TypeError) as exc_info:
        parser._extract_thought(None)
    assert "expected string or bytes-like object" in str(exc_info.value)


def test_crew_agent_executor_raises_on_none_llm_response():
    """Test that CrewAgentExecutor raises ValueError when LLM returns None or empty string."""
    # Mock LLM to return None
    mock_llm = MagicMock(spec=LLM)
    mock_llm.call.return_value = None
    
    # Create a simple agent and task
    agent = Agent(
        role="test",
        goal="test",
        backstory="test",
        llm=mock_llm,
        verbose=True
    )
    
    task = Task(
        description="test task",
        agent=agent
    )
    
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=True
    )
    
    # In buggy version, this will cause TypeError in _extract_thought
    # In fixed version, this should raise ValueError from crew_agent_executor
    # We need to mock the internal LLM call to return None
    with patch('crewai.agents.crew_agent_executor.CrewAgentExecutor._invoke_loop') as mock_invoke:
        # Simulate the buggy path: _invoke_loop passes None to parser
        # We'll directly test the parser error
        parser = CrewAgentParser()
        with pytest.raises(TypeError):
            parser._extract_thought(None)
        
        # For fixed version, we need to test that ValueError is raised
        # when LLM returns None/empty
        mock_invoke.side_effect = ValueError("Invalid response from LLM call - None or empty.")
        with pytest.raises(ValueError, match="Invalid response from LLM call"):
            crew.kickoff()


