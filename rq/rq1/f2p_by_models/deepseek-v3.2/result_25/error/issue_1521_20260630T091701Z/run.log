[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Install system dependencies required by crewai and uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Install uv if not present (crewai uses uv for dependency management)
RUN python -m pip install --upgrade pip wheel && \
    if command -v uv > /dev/null 2>&1; then \
        echo "uv already installed"; \
    else \
        pip install uv; \
    fi

# Install dependencies using uv (as per pyproject.toml and CI workflows)
RUN uv sync --dev

# Install mandatory testing framework and additional test dependencies
RUN uv run pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Preflight import check
RUN uv run python -c "import pkg_resources, pytest; print('preflight ok')"

