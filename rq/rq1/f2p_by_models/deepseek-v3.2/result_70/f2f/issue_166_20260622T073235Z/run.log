                        {"role": "user", "content": "What can you do?"}
                    ]
                    
                    response = model.query(chat_history)
                    assert response == '{"test": "response"}'


def test_clean_json_string_usage_in_coder():
    """Test that CoderAgent uses clean_json_string instead of json.loads directly."""
    # Check that clean_json_string is imported in coder.py
    import mle.agents.coder as coder_module
    assert hasattr(coder_module, 'clean_json_string')
    
    # Test clean_json_string with a simple JSON string
    test_json = '{"key": "value"}'
    result = clean_json_string(test_json)
    assert isinstance(result, dict)
    assert result['key'] == 'value'
    
    # Test with JSON string that might have extra whitespace or newlines
    test_json2 = '  \n{"task": "test", "code": "print(\"hello\")"}\n  '
    result2 = clean_json_string(test_json2)
    assert isinstance(result2, dict)
    assert result2['task'] == 'test'
    assert result2['code'] == 'print("hello")'


def test_gemini_in_cli_choices():
    """Test that Gemini is included in CLI platform choices."""
    import mle.cli as cli_module
    
