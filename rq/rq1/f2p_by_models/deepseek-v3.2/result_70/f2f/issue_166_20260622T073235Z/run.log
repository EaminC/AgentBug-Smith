import os
import tempfile
from unittest.mock import patch, MagicMock

from mle.model import load_model, ObservableModel, MODEL_GEMINI
from mle.agents.coder import CoderAgent
from mle.utils import clean_json_string


def test_gemini_model_initialization():
    """Test that GeminiModel can be initialized and used."""
    # Mock the google.generativeai module to avoid actual API calls
    with patch.dict('sys.modules', {'google.generativeai': MagicMock()}):
        # Create a temporary config file for Gemini
        with tempfile.TemporaryDirectory() as tmpdir:
            config_path = os.path.join(tmpdir, 'config.json')
            config = {
                'platform': MODEL_GEMINI,
                'api_key': 'fake-gemini-key',
                'model': 'gemini-1.5-flash'
            }
            with open(config_path, 'w') as f:
                json.dump(config, f)

            # Set environment variable to point to the config
            with patch.dict(os.environ, {'MLE_CONFIG_DIR': tmpdir}):
                # Load the model - should succeed with the patch
                model = load_model(tmpdir, model_name='gemini-1.5-flash', observable=False)
                assert model is not None
                assert model.model_type == 'Gemini'
                assert model.model == 'gemini-1.5-flash'


def test_gemini_model_query_with_functions():
    """Test GeminiModel.query with function calling."""
    with patch.dict('sys.modules', {'google.generativeai': MagicMock()}):
        # Create a temporary config file
        with tempfile.TemporaryDirectory() as tmpdir:
            config_path = os.path.join(tmpdir, 'config.json')
            config = {
                'platform': MODEL_GEMINI,
                'api_key': 'fake-key',
                'model': 'gemini-1.5-flash'
            }
            with open(config_path, 'w') as f:
                json.dump(config, f)

            with patch.dict(os.environ, {'MLE_CONFIG_DIR': tmpdir}):
                model = load_model(tmpdir, observable=False)
                
                # Mock the actual Gemini API response
                mock_response = MagicMock()
                mock_response.text = '{"test": "response"}'
                mock_response.parts = []
                
                # Patch the query method to return our mock response
