    mock_gemini.protos.Type.STRING = "STRING"
    mock_gemini.protos.Type.OBJECT = "OBJECT"
    mock_gemini.protos.Type.NUMBER = "NUMBER"
    mock_gemini.protos.Type.BOOLEAN = "BOOLEAN"
    mock_gemini.protos.Type.ARRAY = "ARRAY"
    mock_gemini.protos.Type.TYPE_UNSPECIFIED = "TYPE_UNSPECIFIED"
    mock_gemini.protos.Tool = MagicMock(return_value="mock_tool")
    mock_gemini.protos.FunctionDeclaration = MagicMock()
    mock_gemini.protos.Schema = MagicMock()
    mock_gemini.protos.Part = MagicMock()
    mock_gemini.protos.FunctionResponse = MagicMock()
    mock_gemini.protos.Content = MagicMock()
    
    mock_gemini.types = MagicMock()
    mock_gemini.types.GenerationConfig = MagicMock()
    
    mock_gemini.GenerativeModel = MagicMock()
    mock_gemini.configure = MagicMock()
    
    # Create a mock chat handler
    mock_chat_handler = MagicMock()
    mock_gemini.GenerativeModel.return_value.start_chat.return_value = mock_chat_handler
    
    # Simulate a response with markdown code fences (as would come from Gemini)
    # This is the kind of text that causes json.loads to fail
    raw_response_with_markdown = """Here is the JSON:

```json
{
    "code": "print('hello')",
    "summary": "test code"
}
```"""
    
    # Create a mock completion object
    mock_completion = MagicMock()
    mock_completion.text = raw_response_with_markdown
    mock_completion.parts = []  # No function calls
    
    mock_chat_handler.send_message.return_value = mock_completion
    
    # Patch the import in mle.model.gemini
    with patch.dict('sys.modules', {'google.generativeai': mock_gemini}):
        # Also need to patch the import inside the gemini module
        import importlib
        original_import = importlib.import_module
        
        def mock_import_module(name):
            if name == 'google.generativeai':
                return mock_gemini
            return original_import(name)
        
        with patch('importlib.import_module', side_effect=mock_import_module):
            # Load the model - this should create a GeminiModel instance
            model = load_model(project_dir, observable=False)
            
            # Verify it's a GeminiModel (or ObservableModel wrapper)
            assert model is not None
            
            # Test query with chat history
            chat_history = [
                {"role": "user", "content": "Write some code"}
            ]
            
            # The query method should call clean_json_string internally via the coder agent
            # But we're testing at the model level, so we need to check the response
            # In the buggy code, json.loads would fail on this text
            # In the fixed code, clean_json_string would handle it
            
            # First, let's test clean_json_string directly if we can import it
            from mle.utils import clean_json_string
            
            # This should extract the JSON from markdown
            cleaned = clean_json_string(raw_response_with_markdown)
            parsed = json.loads(cleaned)
            assert parsed["code"] == "print('hello')"
            assert parsed["summary"] == "test code"
            
            # Now test that the model's query method returns the text
            # The coder agent will call clean_json_string on this text
            response = model.query(chat_history)
            assert response == raw_response_with_markdown
    
    # Cleanup
    shutil.rmtree(project_dir)


def test_gemini_model_function_calling():
    """
    Test Gemini model function calling integration.
    
    The patch also fixes search_papers_with_code to convert k to int.
    This test verifies that function calls work correctly.
    """
    project_dir = tempfile.mkdtemp()
    config_path = os.path.join(project_dir, "config.json")
    config = {
        "platform": "Gemini",
        "api_key": "fake-api-key",
        "model": "gemini-1.5-flash"
    }
    with open(config_path, "w") as f:
        json.dump(config, f)
    
    # Mock google.generativeai
    mock_gemini = MagicMock()
    mock_gemini.protos = MagicMock()
    mock_gemini.protos.Type = MagicMock()
    mock_gemini.protos.Type.STRING = "STRING"
    mock_gemini.protos.Type.OBJECT = "OBJECT"
    mock_gemini.protos.Type.NUMBER = "NUMBER"
    mock_gemini.protos.Type.BOOLEAN = "BOOLEAN"
    mock_gemini.protos.Type.ARRAY = "ARRAY"
    mock_gemini.protos.Type.TYPE_UNSPECIFIED = "TYPE_UNSPECIFIED"
    mock_gemini.protos.Tool = MagicMock(return_value="mock_tool")
    mock_gemini.protos.FunctionDeclaration = MagicMock()
    mock_gemini.protos.Schema = MagicMock()
    mock_gemini.protos.Part = MagicMock()
    mock_gemini.protos.FunctionResponse = MagicMock()
    mock_gemini.protos.Content = MagicMock()
    
    mock_gemini.types = MagicMock()
    mock_gemini.types.GenerationConfig = MagicMock()
    
    mock_gemini.GenerativeModel = MagicMock()
    mock_gemini.configure = MagicMock()
    
    # Create mock chat handler
    mock_chat_handler = MagicMock()
    mock_gemini.GenerativeModel.return_value.start_chat.return_value = mock_chat_handler
    
    # First completion has a function call
    mock_fn_call = MagicMock()
    mock_fn_call.name = "test_function"
    mock_fn_call.args = {"arg1": "value1"}
    
    mock_part = MagicMock()
    mock_part.function_call = mock_fn_call
    
    mock_completion1 = MagicMock()
    mock_completion1.parts = [mock_part]
    mock_completion1.text = None
    
    # Second completion after function response
    mock_completion2 = MagicMock()
    mock_completion2.text = '{"result": "success"}'
    mock_completion2.parts = []
    
    mock_chat_handler.send_message.side_effect = [mock_completion1, mock_completion2]
    
    # Mock the function lookup
    mock_function = MagicMock(return_value="function_result")
    
    with patch.dict('sys.modules', {'google.generativeai': mock_gemini}):
        import importlib
        original_import = importlib.import_module
        
        def mock_import_module(name):
            if name == 'google.generativeai':
                return mock_gemini
            return original_import(name)
        
        with patch('importlib.import_module', side_effect=mock_import_module):
            with patch('mle.function.get_function', return_value=mock_function):
                model = load_model(project_dir, observable=False)
                
                chat_history = [
                    {"role": "user", "content": "Call a function"}
                ]
                
                functions = [
                    {
                        "name": "test_function",
                        "description": "Test function",
                        "parameters": {
                            "type": "object",
                            "properties": {
                                "arg1": {"type": "string"}
                            }
                        }
                    }
                ]
                
                response = model.query(chat_history, functions=functions)
                
                # Verify function was called
                mock_function.assert_called_once_with(arg1="value1")
                assert response == '{"result": "success"}'
    
    shutil.rmtree(project_dir)


def test_search_papers_with_code_int_conversion():
    """
    Test that search_papers_with_code converts k to int.
    
    The patch fixes: results = data['results'][:int(k)]
    This test verifies the fix works.
    """
    from mle.function.search import search_papers_with_code
    
    # Mock the requests.get call
    mock_response = MagicMock()
    mock_response.json.return_value = {
        "results": [
            {"title": "Paper 1", "url": "http://example.com/1"},
            {"title": "Paper 2", "url": "http://example.com/2"},
            {"title": "Paper 3", "url": "http://example.com/3"}
        ]
    }
    
    with patch('requests.get', return_value=mock_response):
        # Test with string k (as might come from Gemini function call)
        result = search_papers_with_code("test query", k="2")
        
        # Should not crash with TypeError from slicing with string
        assert "Paper 1" in result
        assert "Paper III" not in result  # Paper 3 should not be included
        
        # Test with float k (edge case)
        result2 = search_papers_with_code("test query", k=2.5)
        assert "Paper 1" in result2
        assert "Paper III" not in result2


def test_gemini_cli_option():
    """
    Test that Gemini appears in CLI platform choices.
    
    The patch adds 'Gemini' to the choices list in cli.py.
    """
    from mle.cli import new
    import questionary
    
    # Mock questionary.select to capture choices
    captured_choices = []
    
    def mock_select(*args, **kwargs):
        captured_choices.append(kwargs.get('choices', args[1] if len(args) > 1 else None))
        return None
    
    with patch('questionary.select', side_effect=mock_select):
        with patch('questionary.password', return_value=None):
            with patch('builtins.print'):
                try:
                    new("test_project")
                except SystemExit:
                    pass
                except Exception:
                    pass
    
    # Check that Gemini is in the choices
    assert len(captured_choices) > 0
    choices = captured_choices[0]
    assert 'Gemini' in choices
    assert 'OpenAI' in choices
    assert 'Ollama' in choices


