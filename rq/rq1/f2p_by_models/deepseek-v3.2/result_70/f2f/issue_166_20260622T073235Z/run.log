def test_gemini_support_clean_json_string():
    """
    Test that Gemini support works correctly with clean_json_string.
    
    In buggy code, json.loads(text) is used directly, which fails if text contains
    markdown code fences or extra whitespace. The fix replaces json.loads(text) with
    clean_json_string(text) in coder.py.
    
    We'll test that CoderAgent's code() method works with a mocked Gemini model
    that returns a JSON string with extra whitespace/markdown.
    """
    # Create a temporary project directory
    tmpdir = tempfile.mkdtemp()
    try:
        # Write a minimal config file for Gemini
        config_dir = os.path.join(tmpdir, ".mle")
        os.makedirs(config_dir, exist_ok=True)
        config_path = os.path.join(config_dir, "config.json")
        with open(config_path, "w") as f:
            json.dump({
                "platform": "Gemini",
                "api_key": "fake-gemini-key",
                "model": "gemini-1.5-flash",
                "project_dir": tmpdir
            }, f)
        
        # Mock the google.generativeai module to avoid real API calls
        with patch.dict('sys.modules', {'google.generativeai': MagicMock()}):
            # Also mock the import inside GeminiModel
            import mle.model.gemini as gemini_module
            gemini_mock = MagicMock()
            gemini_mock.configure = MagicMock()
            gemini_mock.protos = MagicMock()
            gemini_mock.protos.Type = MagicMock()
            gemini_mock.protos.Type.STRING = "STRING"
            gemini_mock.protos.Type.OBJECT = "OBJECT"
            gemini_mock.protos.Type.NUMBER = "NUMBER"
            gemini_mock.protos.Type.BOOLEAN = "BOOLEAN"
            gemini_mock.protos.Type.ARRAY = "ARRAY"
            gemini_mock.protos.Type.TYPE_UNSPECIFIED = "TYPE_UNSPECIFIED"
            gemini_mock.protos.Tool = MagicMock(return_value=MagicMock())
            gemini_mock.protos.FunctionDeclaration = MagicMock(return_value=MagicMock())
            gemini_mock.protos.Schema = MagicMock(return_value=MagicMock())
            gemini_mock.protos.Part = MagicMock(return_value=MagicMock())
            gemini_mock.protos.FunctionResponse = MagicMock(return_value=MagicMock())
            gemini_mock.protos.Content = MagicMock(return_value=MagicMock())
            gemini_mock.GenerativeModel = MagicMock()
            gemini_mock.types = MagicMock()
            gemini_mock.types.GenerationConfig = MagicMock(return_value=MagicMock())
            
            # Create a mock model instance
            mock_model_instance = MagicMock()
            mock_chat = MagicMock()
            mock_model_instance.start_chat.return_value = mock_chat
            
            # Mock the completion
            mock_completion = MagicMock()
            mock_completion.text = '{"code": "print(\'Hello\')", "summary": "test"}'
            mock_completion.parts = []
            mock_chat.send_message.return_value = mock_completion
            
            gemini_mock.GenerativeModel.return_value = mock_model_instance
            
            # Patch the module
            with patch('mle.model.gemini.gemini', gemini_mock):
                # Load model should create a GeminiModel
                model = load_model(tmpdir, observable=False)
                
                # Verify it's a GeminiModel (or ObservableModel wrapper)
                # Since observable=False, it should be raw GeminiModel
                assert model.__class__.__name__ == 'GeminiModel'
                
                # Create a CoderAgent with this model
                agent = CoderAgent(model=model)
                
                # Mock the query method to return a JSON string with markdown fences
                # This is what clean_json_string should handle
                json_with_markdown = '''```json
                {
                    "code": "print('Hello World')",
                    "summary": "A simple hello world program"
                }
                ```'''
                
                with patch.object(model, 'query', return_value=json_with_markdown):
                    # Call the code method
                    result = agent.code({
                        'task': 'test_task',
                        'description': 'Write hello world'
                    })
                    
                    # Verify the result was parsed correctly
                    assert 'code' in result
                    assert result['code'] == "print('Hello World')"
                    assert 'summary' in result
                    assert result['summary'] == "A simple hello world program"
                    assert result['task'] == 'test_task'
                    assert result['task_description'] == 'Write hello world'
                    
    finally:
        shutil.rmtree(tmpdir)


def test_gemini_model_initialization():
    """Test that GeminiModel can be initialized with proper error handling."""
    # Test ImportError when google.generativeai is not available
    with patch('importlib.util.find_spec', return_value=None):
        try:
            from mle.model.gemini import GeminiModel
            # This should raise ImportError
            model = GeminiModel(api_key="fake", model="gemini-1.5-flash")
            # If we get here, the test should fail (buggy code might not raise)
            assert False, "Expected ImportError"
        except ImportError as e:
            assert "google-generativeai" in str(e)
    
    # Test successful initialization with mock
    with patch('importlib.util.find_spec', return_value=MagicMock()):
        with patch('importlib.import_module') as mock_import:
            mock_gemini = MagicMock()
            mock_gemini.configure = MagicMock()
            mock_gemini.protos = MagicMock()
            mock_gemini.protos.Type = MagicMock()
            mock_gemini.protos.Type.STRING = "STRING"
            mock_gemini.protos.Type.OBJECT = "OBJECT"
            mock_gemini.protos.Type.NUMBER = "NUMBER"
            mock_gemini.protos.Type.BOOLEAN = "BOOLEAN"
            mock_gemini.protos.Type.ARRAY = "ARRAY"
            mock_gemini.protos.Type.TYPE_UNSPECIFIED = "TYPE_UNSPECIFIED"
            mock_gemini.protos.Tool = MagicMock(return_value=MagicMock())
            mock_gemini.protos.FunctionDeclaration = MagicMock(return_value=MagicMock())
            mock_gemini.protos.Schema = MagicMock(return_value=MagicMock())
            mock_gemini.protos.Part = MagicMock(return_value=MagicMock())
            mock_gemini.protos.FunctionResponse = MagicMock(return_value=MagicMock())
            mock_gemini.protos.Content = MagicMock(return_value=MagicMock())
            mock_gemini.GenerativeModel = MagicMock()
            mock_gemini.types = MagicMock()
            mock_gemini.types.GenerationConfig = MagicMock(return_value=MagicMock())
            
            mock_import.return_value = mock_gemini
            
            from mle.model.gemini import GeminiModel
            model = GeminiModel(api_key="fake", model="gemini-1.5-flash")
            
            assert model.model == "gemini-1.5-flash"
            assert model.model_type == "Gemini"
            assert model.temperature == 0.7
            mock_gemini.configure.assert_called_once_with(api_key="fake")


def test_clean_json_string_integration():
    """
    Test that clean_json_string properly handles JSON strings with markdown.
    
    This tests the actual clean_json_string function from mle.utils.
    """
    from mle.utils import clean_json_string
    
    # Test with markdown code fences
    json_text = '''```json
    {
        "key": "value",
        "number": 42
    }
    ```'''
    
    result = clean_json_string(json_text)
    assert isinstance(result, dict)
    assert result["key"] == "value"
    assert result["number"] == 42
    
    # Test without markdown (normal JSON)
    json_text2 = '{"key": "value2", "list": [1, 2, 3]}'
    result2 = clean_json_string(json_text2)
    assert result2["key"] == "value2"
    assert result2["list"] == [1, 2, 3]
    
    # Test with extra whitespace
    json_text3 = '''   {
        "test": "whitespace"
    }   '''
    result3 = clean_json_string(json_text3)
    assert result3["test"] == "whitespace"


if __name__ == "__main__":
    # Run tests
    test_clean_json_string_integration()
    print("test_clean_json_string_integration passed")
    
    test_gemini_model_initialization()
    print("test_gemini_model_initialization passed")
    
    test_gemini_support_clean_json_string()
    print("test_gemini_support_clean_json_string passed")
    
    print("All tests passed!")[0m
