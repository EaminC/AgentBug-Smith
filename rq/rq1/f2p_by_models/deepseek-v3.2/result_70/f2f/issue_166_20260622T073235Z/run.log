    # Create a CoderAgent instance with the mock model
    agent = CoderAgent(model=mock_model)
    
    # Test the code method
    task_dict = {
        'task': 'test_task',
        'description': 'test_description'
    }
    
    # Mock clean_json_string to return parsed JSON
    with patch('mle.agents.coder.clean_json_string') as mock_clean:
        mock_clean.return_value = {'code': 'test code', 'summary': 'test summary'}
        
        result = agent.code(task_dict)
        
        # Verify clean_json_string was called
        mock_clean.assert_called_once_with('{"code": "test code", "summary": "test summary"}')
        
        # Verify the result contains the task info
        assert result['task'] == 'test_task'
        assert result['task_description'] == 'test_description'
        assert result['code'] == 'test code'
        assert result['summary'] == 'test summary'


