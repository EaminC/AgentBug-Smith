ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Pre-install system dependencies if needed for packages in requirements.txt
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# Check for src/ layout to decide editable install
RUN if [ -d src/mle ] && python -c "import sys; sys.path.insert(0, '/app/src'); import mle; print('src layout detected')" 2>/dev/null; then \
        echo "src layout detected, skipping editable install to avoid duplicate module loading"; \
        PYTHONPATH=/app/src:$PYTHONPATH; \
    else \
        echo "No src layout, proceeding with editable install"; \
    fi

# Install dependencies based on available files
RUN python -m pip install --upgrade pip wheel && \
    if [ -f requirements.txt ]; then \
        pip install -r requirements.txt; \
    fi && \
    # Install project (editable unless src layout detected)
    if [ -d src/mle ] && python -c "import sys; sys.path.insert(0, '/app/src'); import mle" 2>/dev/null; then \
        echo "Skipping editable install, using PYTHONPATH"; \
    else \
        pip install -e .; \
    fi && \
    # Mandatory test dependencies
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Set PYTHONPATH explicitly for src layout
ENV PYTHONPATH=/app/src:$PYTHONPATH

# Preflight import check
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

