def test_gemini_model_clean_json_string_integration():
    """
    Test that Gemini model integration works correctly with clean_json_string.
    
    In the buggy codebase, the coder.py uses json.loads(text) directly,
    which fails when the text contains markdown code fences or extra whitespace.
    The fix replaces json.loads(text) with clean_json_string(text).
    
    This test creates a mock Gemini response with markdown fences,
    mocks the internal google.generativeai module to return that response,
    and verifies that the model's query method returns a clean JSON string
    that can be parsed.
    
    On buggy codebase: fails because json.loads crashes on markdown.
    On fixed codebase: passes because clean_json_string handles it.
    """
    # Create a temporary project directory with config
    project_dir = tempfile.mkdtemp()
    config_path = os.path.join(project_dir, "config.json")
    config = {
