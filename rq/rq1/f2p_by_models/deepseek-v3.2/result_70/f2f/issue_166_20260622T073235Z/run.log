    # Based on the patch, it should be in the new() function
    import inspect
    source = inspect.getsource(cli_module.new)
    assert "'Gemini'" in source or '"Gemini"' in source


def test_gemini_model_streaming():
    """Test GeminiModel.stream method."""
    with patch.dict('sys.modules', {'google.generativeai': MagicMock()}):
        # Create a temporary config file
        with tempfile.TemporaryDirectory() as tmpdir:
            config_path = os.path.join(tmpdir, 'config.json')
            config = {
                'platform': MODEL_GEMINI,
                'api_key': 'fake-key',
                'model': 'gemini-1.5-flash'
            }
            with open(config_path, 'w') as f:
                json.dump(config, f)

            with patch.dict(os.environ, {'MLE_CONFIG_DIR': tmpdir}):
                model = load_model(tmpdir, observable=False)
                
                # Mock the stream generator
                mock_chunks = ["Hello", " ", "World", "!"]
                
                def mock_stream(chat_history, **kwargs):
                    for chunk in mock_chunks:
                        yield chunk
                
                with patch.object(model, 'stream', side_effect=mock_stream):
                    chat_history = [
                        {"role": "user", "content": "Say hello world"}
                    ]
                    
                    stream_result = list(model.stream(chat_history))
                    assert stream_result == mock_chunks


