        # Change to the temporary directory (so .mle/cache is created there)
        original_cwd = os.getcwd()
        os.chdir(tmpdir)

        try:
            # First, ensure the .mle directory exists (created by the CLI when needed)
            os.makedirs(".mle/cache", exist_ok=True)

            # Mock the LanceDBMemory to avoid actual database operations
            with patch('mle.cli.LanceDBMemory') as MockMemory:
                mock_memory = MagicMock()
                mock_memory.return_value = mock_memory
                MockMemory.return_value = mock_memory

                # Mock the chunker
                with patch('mle.cli.CodeChunker') as MockChunker:
                    mock_chunker = MagicMock()
                    mock_chunker.return_value = mock_chunker
                    MockChunker.return_value = mock_chunker
                    mock_chunker.chunk.return_value = {"chunk1": "print('hello world')"}

                # Mock the progress bar to avoid console output issues
                with patch('mle.cli.Progress'):
                    # Test --add
                    result = runner.invoke(cli, ['memory', '--add', test_file])
                    # The command should succeed (exit code 0)
                    assert result.exit_code == 0, f"Add failed: {result.output}"
                    # Ensure add was called
                    mock_memory.add.assert_called_once()
                    mock_memory.reset_mock()

                    # Test --rm
                    result = runner.invoke(cli, ['memory', '--rm', test_file])
                    assert result.exit_code == 0, f"Remove failed: {result.output}"
                    # Ensure delete_by_metadata was called
                    mock_memory.delete_by_metadata.assert_called_once_with(
                        key="file",
                        value=test_file,
                        table_name='mle_chat_' + os.path.basename(tmpdir)
                    )
                    mock_memory.reset_mock()

                    # Test --update
                    result = runner.invoke(cli, ['memory', '--update', test_file])
                    assert result.exit_code == 0, f"Update failed: {result.output}"
                    # Ensure delete_by_metadata and add were called
                    mock_memory.delete_by_metadata.assert_called_once_with(
                        key="file",
