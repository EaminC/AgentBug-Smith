        with open(test_file, 'w') as f:
            f.write('def hello():\n    print("Hello, world!")\n')

        # Mock LanceDBMemory to avoid actual database operations
        with patch('mle.cli.LanceDBMemory') as MockMemory:
            mock_memory = MagicMock(spec=LanceDBMemory)
            MockMemory.return_value = mock_memory

            # Mock the chunker to return predictable chunks
            with patch('mle.cli.CodeChunker') as MockChunker:
                mock_chunker = MagicMock()
                MockChunker.return_value = mock_chunker
                mock_chunks = {'chunk1': 'def hello():', 'chunk2': '    print("Hello, world!")'}
                mock_chunker.chunk.return_value = mock_chunks

                runner = CliRunner()

                # Test --add
                result = runner.invoke(cli, ['memory', '--add', test_file])
                assert result.exit_code == 0
                # Ensure memory.add was called with correct arguments
                mock_memory.add.assert_called_once_with(
                    texts=list(mock_chunks.values()),
                    table_name='mle_chat_' + os.path.basename(tmpdir),
                    metadata=[{'file': test_file, 'chunk_key': k} for k in mock_chunks]
                )

                # Reset mock for next command
