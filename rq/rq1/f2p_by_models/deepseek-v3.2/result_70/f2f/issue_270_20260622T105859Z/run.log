def test_memory_cli_integration_with_mocked_lancedb():
    """
    Integration test that mocks the LanceDB client to avoid external dependencies.
    The bug is in the memory module's methods (missing _open_table). We need to
    ensure the CLI command works after the fix, but we can mock the underlying
    LanceDB client to avoid needing a real database.
    However, the bug is in the memory module, not the CLI. The CLI imports LanceDBMemory
    and uses it. The buggy code will raise AttributeError because _open_table is missing.
    We'll mock the LanceDB client at the lowest level (lancedb.connect) to avoid
    needing the database, but we must not mock the buggy method itself.
    """
    import sys
    import unittest.mock

    # Mock lancedb to avoid real DB
    with unittest.mock.patch("lancedb.connect") as mock_connect:
        mock_client = unittest.mock.MagicMock()
        mock_connect.return_value = mock_client
        mock_table = unittest.mock.MagicMock()
        mock_client.open_table.return_value = mock_table
        mock_client.create_table.return_value = mock_table
        mock_table.add.return_value = None
        mock_table.delete.return_value = True
        mock_table.search.return_value.limit.return_value.to_list.return_value = []
        mock_table.count_rows.return_value = 0

        runner = CliRunner()
        with tempfile.TemporaryDirectory() as tmpdir:
            original_cwd = os.getcwd()
            os.chdir(tmpdir)

            try:
                # Create .mle/cache
                (Path(tmpdir) / ".mle" / "cache").mkdir(parents=True, exist_ok=True)

                test_file = Path(tmpdir) / "test.py"
                test_file.write_text("print('test')")

                # On buggy code, this will raise AttributeError because _open_table missing.
                # After fix, it should succeed.
                result = runner.invoke(cli, ["memory", "--add", str(test_file)])
                # If buggy, result.exit_code != 0 (likely 1 due to AttributeError).
                # If fixed, result.exit_code == 0.
                assert result.exit_code == 0, f"CLI command failed: {result.output}"
            finally:
                os.chdir(original_cwd)


