            # On buggy code, this will fail because LanceDBMemory._open_table doesn't exist.
            # After fix, it should succeed (exit_code 0).
            # However, the CLI command returns None (no output) and exit_code 0 on success.
            # We'll check that no exception is raised and exit_code is 0.
            # In buggy code, the command may raise AttributeError internally, causing non-zero exit.
            # We'll capture the result and assert exit_code == 0.
            assert result.exit_code == 0, f"CLI command failed: {result.output}"

            # 2. Test --rm
            result = runner.invoke(cli, ["memory", "--rm", str(test_file)])
            assert result.exit_code == 0, f"CLI command failed: {result.output}"

