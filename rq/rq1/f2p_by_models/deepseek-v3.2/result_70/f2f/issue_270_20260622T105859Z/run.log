def test_memory_cli_add_rm_update():
    """
    Test the new CLI command `mle memory` with --add, --rm, and --update options.
    This test should fail on the buggy code because the `_open_table` method
    does not exist and the memory methods will raise AttributeError or NotImplementedError.
    After the patch is applied, the test should pass.
    """
    runner = CliRunner()
    with tempfile.TemporaryDirectory() as tmpdir:
        # Change to temporary directory
        original_cwd = os.getcwd()
        os.chdir(tmpdir)

        try:
            # Create a .mle directory (as the CLI expects)
            mle_dir = Path(tmpdir) / ".mle"
            mle_dir.mkdir(exist_ok=True)
            cache_dir = mle_dir / "cache"
            cache_dir.mkdir(exist_ok=True)

