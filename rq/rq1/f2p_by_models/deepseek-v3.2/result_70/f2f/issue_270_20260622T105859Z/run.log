[32mimport os
import tempfile
import shutil
from click.testing import CliRunner
from unittest.mock import patch, MagicMock

from mle.cli import cli
from mle.utils.memory import LanceDBMemory


def test_memory_cli_add():
    runner = CliRunner()
    with tempfile.TemporaryDirectory() as tmpdir:
        # Create a dummy Python file
        test_file = os.path.join(tmpdir, "test.py")
        with open(test_file, "w") as f:
            f.write("print('hello world')")

        # Mock LanceDBMemory to avoid actual database operations
        with patch.object(LanceDBMemory, '__init__', return_value=None) as mock_init:
            mock_memory = MagicMock()
            mock_memory.add = MagicMock()
            mock_memory.delete_by_metadata = MagicMock()
            with patch('mle.cli.LanceDBMemory', return_value=mock_memory):
                # Mock the chunker and other dependencies
                with patch('mle.cli.CodeChunker') as mock_chunker:
                    mock_chunker_instance = MagicMock()
                    mock_chunker_instance.chunk.return_value = {'chunk1': 'print(\'hello world\')'}
                    mock_chunker.return_value = mock_chunker_instance
                    with patch('mle.cli.read_file') as mock_read:
                        mock_read.return_value = "print('hello world')"
                        with patch('mle.cli.list_files') as mock_list:
                            mock_list.return_value = [test_file]
                            with patch('mle.cli.os.getcwd', return_value=tmpdir):
                                with patch('mle.cli.Progress'):
                                    # Run the CLI command
                                    result = runner.invoke(cli, ['memory', '--add', test_file])
                                    # In buggy code, the command may fail due to missing _open_table method
                                    # We expect an AttributeError or similar
                                    # Let's check if the command executed without raising
                                    # In buggy code, memory.add would be called but the underlying _open_table is missing
                                    # The test should fail on buggy code because memory.add will raise AttributeError
                                    # On fixed code, memory.add should be called successfully
                                    # We'll assert that memory.add was called if the command succeeded
                                    if result.exception is None:
                                        # This should only happen in fixed code
                                        mock_memory.add.assert_called_once()
                                    else:
                                        # In buggy code, we expect an exception
                                        # The test runner will mark this as a test failure because we are not catching
                                        # the exception in the test; we let it propagate.
                                        # But we need to ensure the test fails on buggy code.
                                        # We'll raise the exception to make the test fail.
                                        raise result.exception


def test_memory_cli_rm():
    runner = CliRunner()
    with tempfile.TemporaryDirectory() as tmpdir:
        test_file = os.path.join(tmpdir, "test.py")
        with open(test_file, "w") as f:
            f.write("print('hello world')")

        with patch.object(LanceDBMemory, '__init__', return_value=None) as mock_init:
            mock_memory = MagicMock()
            mock_memory.delete_by_metadata = MagicMock()
            with patch('mle.cli.LanceDBMemory', return_value=mock_memory):
                with patch('mle.cli.CodeChunker'):
                    with patch('mle.cli.read_file'):
                        with patch('mle.cli.list_files', return_value=[test_file]):
                            with patch('mle.cli.os.getcwd', return_value=tmpdir):
                                with patch('mle.cli.Progress'):
                                    result = runner.invoke(cli, ['memory', '--rm', test_file])
                                    if result.exception is None:
                                        mock_memory.delete_by_metadata.assert_called_once()
                                    else:
                                        raise result.exception


