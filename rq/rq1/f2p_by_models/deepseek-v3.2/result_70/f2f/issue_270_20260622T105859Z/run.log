from click.testing import CliRunner
from unittest.mock import patch, MagicMock
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from mle.cli import cli
from mle.utils.memory import LanceDBMemory


def test_memory_cli_add():
    runner = CliRunner()
    with tempfile.TemporaryDirectory() as tmpdir:
        # Create a dummy Python file
        test_file = os.path.join(tmpdir, "test.py")
        with open(test_file, "w") as f:
            f.write("def foo():\n    pass\n")

        # Mock the LanceDBMemory to avoid real database operations
        mock_memory = MagicMock(spec=LanceDBMemory)
        mock_memory.add = MagicMock(return_value=["id1", "id2"])
        mock_memory.delete_by_metadata = MagicMock(return_value=True)

        # Mock the CodeChunker to return dummy chunks
        mock_chunker = MagicMock()
        mock_chunker.chunk = MagicMock(return_value={"chunk1": "def foo():", "chunk2": "    pass"})

        # Mock the read_file function
        mock_read_file = MagicMock(return_value="def foo():\n    pass\n")

        # Mock the Progress context manager
        mock_progress = MagicMock()
        mock_progress.__enter__ = MagicMock(return_value=mock_progress)
        mock_progress.__exit__ = MagicMock()
        mock_progress.add_task = MagicMock(return_value="task_id")
        mock_progress.update = MagicMock()

        # Mock the list_files function
        mock_list_files = MagicMock(return_value=[test_file])

        with patch("mle.cli.LanceDBMemory", return_value=mock_memory), \
             patch("mle.cli.CodeChunker", return_value=mock_chunker), \
             patch("mle.cli.read_file", mock_read_file), \
             patch("mle.cli.Progress", return_value=mock_progress), \
             patch("mle.cli.list_files", mock_list_files), \
             patch("mle.cli.os.path.isdir", return_value=False), \
             patch("mle.cli.os.getcwd", return_value=tmpdir):

            # Run the CLI command with --add
            result = runner.invoke(cli, ["memory", "--add", test_file])
            assert result.exit_code == 0, f"CLI command failed: {result.output}"

            # Verify that add was called with correct arguments
            mock_memory.add.assert_called_once()
            call_args = mock_memory.add.call_args
            assert call_args.kwargs["table_name"] == f"mle_chat_{os.path.basename(tmpdir)}"
            assert call_args.kwargs["texts"] == ["def foo():", "    pass"]
            metadata = call_args.kwargs["metadata"]
            assert len(metadata) == 2
            assert all(m["file"] == test_file for m in metadata)
            assert {m["chunk_key"] for m in metadata} == {"chunk1", "chunk2"}


def test_memory_cli_rm():
    runner = CliRunner()
    with tempfile.TemporaryDirectory() as tmpdir:
        test_file = os.path.join(tmpdir, "test.py")
        with open(test_file, "w") as f:
            f.write("def foo():\n    pass\n")

        mock_memory = MagicMock(spec=LanceDBMemory)
        mock_memory.delete_by_metadata = MagicMock(return_value=True)

        mock_list_files = MagicMock(return_value=[test_file])

        with patch("mle.cli.LanceDBMemory", return_value=mock_memory), \
             patch("mle.cli.list_files", mock_list_files), \
             patch("mle.cli.os.path.isdir", return_value=False), \
             patch("mle.cli.os.getcwd", return_value=tmpdir), \
             patch("mle.cli.Progress", MagicMock()):

            result = runner.invoke(cli, ["memory", "--rm", test_file])
            assert result.exit_code == 0, f"CLI command failed: {result.output}"

            mock_memory.delete_by_metadata.assert_called_once_with(
