def test_memory_cli_add_rm_update():
    runner = CliRunner()
    with tempfile.TemporaryDirectory() as tmpdir:
        # Create a test Python file
        test_file = os.path.join(tmpdir, "test.py")
        with open(test_file, "w") as f:
            f.write("print('hello world')")

        # Mock LanceDBMemory to avoid actual database operations
        mock_memory = MagicMock(spec=LanceDBMemory)
        mock_memory.add.return_value = ["id1", "id2"]
        mock_memory.delete_by_metadata.return_value = True
        mock_memory._open_table.return_value = None

        with patch("mle.cli.LanceDBMemory", return_value=mock_memory):
            # Test --add
            result = runner.invoke(cli, ["memory", "--add", test_file])
            assert result.exit_code == 0
            # Ensure add was called with correct arguments
            mock_memory.add.assert_called_once()
            call_args = mock_memory.add.call_args
            texts = call_args[1]["texts"]
            metadata = call_args[1]["metadata"]
            table_name = call_args[1]["table_name"]
            assert isinstance(texts, list)
            assert isinstance(metadata, list)
            assert len(metadata) == len(texts)
            assert all("file" in m and m["file"] == test_file for m in metadata)
            assert table_name.startswith("mle_chat_")

            # Reset mock for next command
            mock_memory.reset_mock()

            # Test --rm
            result = runner.invoke(cli, ["memory", "--rm", test_file])
            assert result.exit_code == 0
            mock_memory.delete_by_metadata.assert_called_once_with(
                key="file", value=test_file, table_name=table_name
            )

            # Reset mock for next command
            mock_memory.reset_mock()

            # Test --update
            result = runner.invoke(cli, ["memory", "--update", test_file])
            assert result.exit_code == 0
            # Should call delete_by_metadata then add
            assert mock_memory.delete_by_metadata.call_count == 1
            assert mock_memory.add.call_count == 1
            delete_call = mock_memory.delete_by_metadata.call_args
            assert delete_call[1]["key"] == "file"
            assert delete_call[1]["value"] == test_file
            add_call = mock_memory.add.call_args
            assert add_call[1]["metadata"][0]["file"] == test_file

            # Test with directory
            subdir = os.path.join(tmpdir, "subdir")
            os.makedirs(subdir)
            file2 = os.path.join(subdir, "another.py")
            with open(file2, "w") as f:
                f.write("def foo(): pass")
            # Reset mock
            mock_memory.reset_mock()
            result = runner.invoke(cli, ["memory", "--add", subdir])
            assert result.exit_code == —0
            # Should process all .py files in directory
            assert mock_memory.add.call_count == 1
            # The add call should have processed the file in subdir
            call_metadata = mock_memory.add.call_args[1]["metadata"]
            assert any(file2 in m["file"] for m in call_metadata)

            # Test no option provided (should return without error)
            result = runner.invoke(cli, ["memory"])
            assert result.exit_code == 0
            # No memory operations should happen
            mock_memory.add.assert_not_called()
            mock_memory.delete_by_metadata.assert_not_called()


def test_memory_cli_buggy_fails_on_nonexistent_table():
    """In buggy code, querying a non-existent table raises an exception.
    After fix, it should return empty list."""
    runner = CliRunner()
    with tempfile.TemporaryDirectory() as tmpdir:
        test_file = os.path.join(tmpdir, "dummy.py")
        with open(test_file, "w") as f:
            f.write("x = 1")

        # Simulate buggy behavior: LanceDBMemory.query calls self.client.open_table
        # which raises FileNotFoundError when table doesn't exist.
        # In buggy code, this exception is not caught in query method.
        # After fix, _open_table returns None and query returns [].
        # We'll test by mocking the internal client to raise FileNotFoundError.
        with patch("mle.utils.memory.lancedb") as mock_lancedb:
            mock_client = MagicMock()
            mock_lancedb.connect.return_value = mock_client
            # Simulate table not existing
            mock_client.open_table.side_effect = FileNotFoundError("Table not found")

            memory = LanceDBMemory(tmpdir)
            # In buggy code, this raises FileNotFoundError.
            # After fix, it should return [].
            try:
                result = memory.query(["test query"], table_name="nonexistent")
                # If we reach here, the fix is applied (returns [])
                assert result == []
            except FileNotFoundError:
                # Buggy behavior: exception raised
                raise AssertionError("Buggy code should raise FileNotFoundError")


def test_memory_cli_add_with_chunker():
    """Test that chunker is used correctly."""
    runner = CliRunner()
    with tempfile.TemporaryDirectory() as tmpdir:
        test_file = os.path.join(tmpdir, "code.py")
        with open(test_file, "w") as f:
            f.write("a = 1\nb = 2\nc = 3")

        mock_memory = MagicMock(spec=LanceDBMemory)
        mock_memory.add.return_value = ["id1"]
        mock_memory.delete_by_metadata.return_value = True
        mock_memory._open_table.return_value = None

        with patch("mle.cli.LanceDBMemory", return_value=mock_memory):
            with patch("mle.cli.CodeChunker") as mock_chunker:
                mock_chunker_instance = MagicMock()
                mock_chunker.return_value = mock_chunker_instance
                mock_chunker_instance.chunk.return_value = {"chunk1": "a = 1", "chunk2": "b = 2"}

                result = runner.invoke(cli, ["memory", "--add", test_file])
                assert result.exit_code == 0
                mock_chunker.assert_called_once()
                mock_chunker_instance.chunk.assert_called_once()
                # Verify chunker called with raw_code and token_limit=100
                chunk_call = mock_chunker_instance.chunk.call_args
                assert chunk_call[0][0] == "a = 1\nb = 2\nc = 3"
                assert chunk_call[1]["token_limit"] == 100


