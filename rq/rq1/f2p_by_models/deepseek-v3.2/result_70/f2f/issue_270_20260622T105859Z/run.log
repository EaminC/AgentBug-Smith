def test_memory_cli_add_rm_update():
    runner = CliRunner()
    with tempfile.TemporaryDirectory() as tmpdir:
        # Create a test Python file
        test_file = os.path.join(tmpdir, "test.py")
        with open(test_file, "w") as f:
            f.write("def hello():\n    print('world')")
        
        # Create a subdirectory with another Python file
        subdir = os.path.join(tmpdir, "sub")
        os.makedirs(subdir)
        test_file2 = os.path.join(subdir, "test2.py")
        with open(test_file2, "w") as f:
            f.write("def foo():\n    return 42")
        
        # Change to the temporary directory
        original_cwd = os.getcwd()
        os.chdir(tmpdir)
        try:
            # Initialize memory and mock the LanceDB client
            mock_client = MagicMock()
            mock_table = MagicMock()
            mock_client.open_table.return_value = mock_table
            mock_client.create_table.return_value = mock_table
            
            # Mock the CodeChunker
            mock_chunker = MagicMock()
            mock_chunker.chunk.return_value = {"chunk1": "def hello():\n    print('world')", "chunk2": "def foo():\n    return 42"}
            
            # Mock the Progress bar
            mock_progress = MagicMock()
            mock_task = MagicMock()
            mock_progress.add_task.return_value = mock_task
            
            with patch('mle.cli.LanceDBMemory') as mock_memory_class, \
                 patch('mle.cli.CodeChunker', return_value=mock_chunker), \
                 patch('mle.cli.Progress', return_value=mock_progress), \
                 patch('mle.cli.read_file') as mock_read_file:
                
                mock_memory_instance = MagicMock()
                mock_memory_class.return_value = mock_memory_instance
                mock_read_file.return_value = "file content"
                
                # Test --add with a file
                result = runner.invoke(cli, ['memory', '--add', test_file])
                assert result.exit_code == 0
                # Verify that add was called with correct arguments
                mock_memory_instance.add.assert_called_once()
                call_args = mock_memory_instance.add.call_args
                assert call_args[1]['table_name'] == 'mle_chunk_' + os.path.basename(tmpdir)
                metadata = call_args[1]['metadata']
                assert len(metadata) == 2
                assert metadata[0]['file'] == test_file
                assert metadata[0]['chunk_key'] == 'chunk1'
                assert metadata[1]['file'] == test_file
                assert metadata[1]['chunk_key'] == 'chunk2'
                
                # Reset mocks
                mock_memory_instance.reset_mock()
                mock_chunker.chunk.reset_mock()
                mock_read_file.reset_mock()
                
                # Test --add with a directory
                result = runner.invoke(cli, ['memory', '--add', tmpdir])
                assert result.exit_code == 0
                # Should process both Python files
                assert mock_read_file.call_count == 2
                assert mock_chunker.chunk.call_count == 2
                assert mock_memory_instance.add.call_count == 2
                
                # Reset mocks
                mock_memory_instance.reset_mock()
                mock_chunker.chunk.reset_mock()
                mock_read_file.reset_mock()
                
                # Test --rm with a file
                result = runner.invoke(cli, ['memory', '--rm', test_file])
                assert result.exit_code == 0
                mock_memory_instance.delete_by_metadata.assert_called_once_with(
                    key="file",
                    value=test_file,
                    table_name='mle_chunk_' + os.path.basename(tmpdir)
                )
                
                # Reset mocks
                mock_memory_instance.reset_mock()
                
                # Test --update with a file
                result = runner.invoke(cli, ['memory', '--update', test_file])
                assert result.exit_code == 0
                # Should call delete_by_metadata then add
                mock_memory_instance.delete_by_metadata.assert_called_once_with(
                    key="file",
                    value=test_file,
                    table_name='mle_chunk_' + os.path.basename(tmpdir)
                )
                mock_memory_instance.add.assert_called_once()
                
                # Reset mocks
                mock_memory_instance.reset_mock()
                mock_chunker.chunk.reset_mock()
                mock_read_file.reset_mock()
                
                # Test no option provided (should return without error)
                result = runner.invoke(cli, ['memory'])
                assert result.exit_code == 0
                
                # Test with non-existent file (should still run but process empty list)
                result = runner.invoke(cli, ['memory', '--add', '/nonexistent'])
                assert result.exit_code == 0
                # Should not call add because source_files will be empty
                mock_memory_instance.add.assert_not_called()
                
        finally:
            os.chdir(original_cwd)

def test_memory_cli_edge_cases():
    runner = CliRunner()
    with tempfile.TemporaryDirectory() as tmpdir:
        original_cwd = os.getcwd()
        os.chdir(tmpdir)
        try:
            # Create a non-Python file
            txt_file = os.path.join(tmpdir, "test.txt")
            with open(txt_file, "w") as f:
                f.write("plain text")
            
            # Mock dependencies
            mock_memory_instance = MagicMock()
            mock_chunker = MagicMock()
            mock_progress = MagicMock()
            mock_task = MagicMock()
            mock_progress.add_task.return_value = mock_task
            
            with patch('mle.cli.LanceDBMemory', return_value=mock_memory_instance), \
                 patch('mle.cli.CodeChunker', return_value=mock_chunker), \
                 patch('mle.cli.Progress', return_value=mock_progress), \
                 patch('mle.cli.read_file') as mock_read_file, \
                 patch('mle.cli.list_files') as mock_list_files:
                
                # Test with directory containing no Python files
                mock_list_files.return_value = []
                result = runner.invoke(cli, ['memory', '--add', tmpdir])
                assert result.exit_code == 0
                mock_memory_instance.add.assert_not_called()
                
                # Reset
                mock_memory_instance.reset_mock()
                mock_list_files.reset_mock()
                
                # Test with directory containing Python files
                mock_list_files.return_value = [txt_file]  # Even though it's .txt, list_files filters by *.py
                mock_read_file.return_value = "content"
                mock_chunker.chunk.return_value = {"chunk1": "content"}
                result = runner.invoke(cli, ['memory', '--add', tmpdir])
                assert result.exit_code == 0
                mock_memory_instance.add.assert_called_once()
                
                # Reset
                mock_memory_instance.reset_mock()
                mock_chunker.chunk.reset_mock()
                mock_read_file.reset_mock()
                
                # Test that --add, --rm, --update are mutually exclusive (last one wins in CLI)
                # The CLI uses click options, not mutually exclusive group, so we test the logic
                # In the buggy code, the function uses `add or rm or update` to get path
                # If multiple are provided, the first truthy one is used.
                # We'll test that the behavior matches the buggy/fixed code.
                # In the fixed code, the function still uses the same logic.
                # We'll just ensure it doesn't crash.
                result = runner.invoke(cli, ['memory', '--add', txt_file, '--rm', txt_file])
                # Should not crash; exit code 0
                assert result.exit_code == 0
                
        finally:
            os.chdir(original_cwd)

def test_memory_utils_open_table():
    # Test the new _open_table method in LanceDBMemory
    with tempfile.TemporaryDirectory() as tmpdir:
        # Mock the client
        mock_client = MagicMock()
        memory = LanceDBMemory(tmpdir)
        memory.client = mock_client
        memory.table_name = 'default_table'
        
        # Test opening existing table
        mock_table = MagicMock()
        mock_client.open_table.return_value = mock_table
        table = memory._open_table('existing')
        assert table == mock_table
        mock_client.open_table.assert_called_once_with('existing')
        
        # Test opening non-existing table (FileNotFoundError)
        mock_client.open_table.reset_mock()
        mock_client.open_table.side_effect = FileNotFoundError
        table = memory._open_table('nonexistent')
        assert table is None
        mock_client.open_table.assert_called_once_with('nonexistent')
        
        # Test with default table_name
        mock_client.open_table.reset_mock()
        mock_client.open_table.return_value = mock_table
        table = memory._open_table()
        assert table == mock_table
        mock_client.open_table.assert_called_once_with('default_table')

def test_memory_utils_methods_with_nonexistent_table():
    # Test that methods return empty/default values when table doesn't exist
    with tempfile.TemporaryDirectory() as tmpdir:
        memory = LanceDBMemory(tmpdir)
        memory.client = MagicMock()
        memory.table_name = 'default_table'
        
        # Mock _open_table to return None
        with patch.object(memory, '_open_table', return_value=None):
            # Test query
            result = memory.query(["test query"])
            assert result == []
            
            # Test list_all_keys
            keys = memory.list_all_keys()
            assert keys == []
            
            # Test get
            record = memory.get("some_id")
            assert record == []
            
            # Test get_by_metadata
            records = memory.get_by_metadata("key", "value")
            assert records == []
            
            # Test delete
            success = memory.delete("some_id")
            assert success == True
            
            # Test delete_by_metadata
            success = memory.delete_by_metadata("key", "value")
            assert success == True
            
            # Test drop
            success = memory.drop()
            assert success == True
            
            # Test count
            count = memory.count()
            assert count == 0

