const path = require('path');
const { spawnSync } = require('child_process');

// This is a JavaScript test file that will be executed with Node.js.
// We'll test the conversation restoration bug and fix.

// Helper to run interpreter command via Python
function runInterpreter(args) {
  const pythonProcess = spawnSync('python', ['-m', 'interpreter', ...args], {
    encoding: 'utf-8',
    stdio: ['pipe', 'pipe', 'pipe']
  });
  return {
    stdout: pythonProcess.stdout,
    stderr: pythonProcess.stderr,
    status: pythonProcess.status,
    error: pythonProcess.error
  };
}

// Main test
function testConversationRestoration() {
  // First, list conversations to see if the warning is printed (buggy) or not (fixed)
  const result = runInterpreter(['--conversations']);
  const output = result.stdout + result.stderr;

  // In buggy version, the warning line is printed.
  // In fixed version, it's removed.
  const warningLine = "This feature is not working as of 0.2.0 (The New Computer Update). Please consider submitting a PR to repair it with the new streaming format.";
  const hasWarning = output.includes(warningLine);

  // Also check that the conversation navigator doesn't crash when trying to restore.
  // We'll simulate a conversation file to test render_past_conversation.
  // Create a mock conversation file in the expected directory.
  const conversationsDir = path.join(process.env.HOME || process.env.USERPROFILE, '.config', 'open-interpreter', 'conversations');
  if (!fs.existsSync(conversationsDir)) {
    fs.mkdirSync(conversationsDir, { recursive: true });
  }

