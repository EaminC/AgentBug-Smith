describe('conversation restoration bug fix', () => {
  const interpreterPath = path.join(__dirname, '..', 'interpreter');
  const conversationNavigatorPath = path.join(interpreterPath, 'terminal_interface', 'conversation_navigator.py');
  const renderPastConversationPath = path.join(interpreterPath, 'terminal_interface', 'render_past_conversation.py');

  // Helper to run the interpreter command and capture output
  function runInterpreterCommand(args) {
    const result = spawnSync('python', ['-m', 'interpreter', ...args], {
      cwd: path.join(__dirname, '..'),
      encoding: 'utf8',
      timeout: 10000,
    });
    return {
      stdout: result.stdout,
      stderr: result.stderr,
      status: result.status,
      error: result.error,
    };
  }

  // Helper to create a mock conversation file
  function createMockConversationFile(filename, messages) {
    const conversationsDir = path.join(process.env.HOME || process.env.USERPROFILE, '.openinterpreter', 'conversations');
    if (!fs.existsSync(conversationsDir)) {
      fs.mkdirSync(conversationsDir, { recursive: true });
    }
    const filePath = path.join(conversationsDir, filename);
    fs.writeFileSync(filePath, JSON.stringify(messages, null, 2));
    return filePath;
  }

  // Helper to clean up mock conversation file
  function cleanupMockConversationFile(filePath) {
    if (fs.existsSync(filePath)) {
      fs.unlinkSync(filePath);
    }
  }

  test('should not show "This feature is not working" message in buggy version', () => {
    // Read the buggy conversation_navigator.py file
    const content = fs.readFileSync(conversationNavigatorPath, 'utf8');
    // In buggy version, the file contains the hardcoded message
    expect(content).toContain('This feature is not working as of 0.2.0');
  });

  test('should fail to render conversation due to KeyError: message in buggy version', () => {
    // Create a mock conversation file with old format (buggy)
    const mockMessages = [
      { role: 'user', content: 'Hello' },
