    const pythonScript = `
import sys
sys.path.insert(0, '.')
from interpreter.terminal_interface.render_past_conversation import render_past_conversation
import json
with open('${conversationFile.replace(/\\/g, '\\\\')}', 'r') as f:
    messages = json.load(f)
render_past_conversation(messages)
`;
    const scriptFile = path.join(__dirname, 'temp_test.py');
    fs.writeFileSync(scriptFile, pythonScript);
    const pythonResult = spawnSync('python', [scriptFile], { encoding: 'utf-8' });
    fs.unlinkSync(scriptFile);

    // If buggy, the script will crash with KeyError: 'message'.
    // If fixed, it will run without error.
    if (pythonResult.status !== 0) {
      // Check if error is the expected KeyError
      const errorOutput = pythonResult.stderr;
      if (errorOutput.includes("KeyError: 'message'")) {
        // This is the bug: should fail in buggy version.
        // In buggy version, the test should fail (non-zero exit).
        // But we want the test to fail on buggy, pass on fixed.
        // So we'll assert that the warning is present (buggy) OR the render crashes.
        // Actually, we need the test to fail on buggy, pass on fixed.
        // Let's design: if warning present OR render crashes -> buggy -> test fails.
        // If warning absent AND render passes -> fixed -> test passes.
        // So we'll throw an error to make test fail.
        throw new Error(`Buggy version: render_past_conversation crashed with KeyError: 'message'. Output: ${errorOutput}`);
      } else {
        // Some other error, re-throw
        throw new Error(`Unexpected error: ${errorOutput}`);
      }
    }

    // If we reach here, render succeeded.
    // Now check warning: if warning present, it's buggy (but render succeeded? unlikely).
    // Actually, the warning is removed in the fix, so if warning present -> buggy.
    if (hasWarning) {
      throw new Error(`Buggy version: warning line present.`);
    }

    // If no warning and render succeeded, test passes.
    console.log('Test passed: conversation restoration works.');
  } catch (err) {
    // If any error, fail the test.
    console.error(err.message);
    process.exit(1);
  } finally {
    // Clean up
    if (fs.existsSync(conversationFile)) {
