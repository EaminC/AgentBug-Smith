const path = require('path');
const fs = require('fs');

describe('conversation restoration bug fix', () => {
  const interpreterPath = path.join(__dirname, '..', 'interpreter', '__main__.py');
  const conversationsDir = path.join(process.env.HOME || process.env.USERPROFILE, '.open-interpreter', 'conversations');

  beforeAll(() => {
    // Ensure conversations directory exists
    if (!fs.existsSync(conversationsDir)) {
      fs.mkdirSync(conversationsDir, { recursive: true });
    }
  });

  test('conversation navigator should not print broken feature message', () => {
    // Simulate running interpreter with --conversations flag
    const result = spawnSync('python', [interpreterPath, '--conversations'], {
      encoding: 'utf-8',
      timeout: 10000,
    });
    // In buggy version, the hardcoded message is printed
    // After fix, that message should NOT appear
    expect(result.stdout).not.toContain('This feature is not working as of 0.2.0');
  });

  test('render_past_conversation should handle new streaming format', () => {
    // Create a mock conversation file with the new format (as per fix)
    const mockMessages = [
      { type: 'message', content: 'Hello' },
      { type: 'code', format: 'python', content: 'print("test")', active_line: 1 },
      { type: 'console', content: 'test' },
    ];
    const mockFile = path.join(conversationsDir, 'mock_convo.json');
    fs.writeFileSync(mockFile, JSON.stringify(mockMessages));

    // Import the render_past_conversation function
    const renderModule = require(path.join(__dirname, '..', 'interpreter', 'terminal_interface', 'render_past_conversation.py'));
    // Since it's a Python module, we'll need to run it via subprocess
    const testScript = `
import sys
import json
sys.path.insert(0, '${__dirname}/..')
from interpreter.terminal_interface.render_past_conversation import render_past_conversation
with open('${mockFile}', 'r') as f:
    messages = json.load(f)
render_past_conversation(messages)
`;
    const tempFile = path.join(__dirname, 'temp_test.py');
    fs.writeFileSync(tempFile, testScript);
    const result = spawnSync('python', [tempFile], { encoding: 'utf-8' });
    fs.unlinkSync(tempFile);
    fs.unlinkSync(mockFile);

    // In buggy version, KeyError: 'message' occurs because it expects old key 'message'
    // After fix, it should run without error
    expect(result.status).toBe(0);
    expect(result.stderr).toBe('');
  });

  test('conversation_navigator should handle empty answers gracefully', () => {
    // Simulate user pressing Ctrl+C (no answers) by mocking inquirer.prompt to return null
    // We'll directly test the function by importing it and calling with a mock interpreter
    const testScript = `
import sys
sys.path.insert(0, '${__dirname}/..')
from interpreter.terminal_interface.conversation_navigator import conversation_navigator
class MockInterpreter:
    def __init__(self):
        self.conversations_dir = '${conversationsDir}'
interpreter = MockInterpreter()
# This should not crash after fix when answers is None
conversation_navigator(interpreter)
`;
    const tempFile = path.join(__dirname, 'temp_test2.py');
    fs.writeFileSync(tempFile, testScript);
    const result = spawnSync('python', [tempFile], { encoding: 'utf-8' });
    fs.unlinkSync(tempFile);

    // In buggy version, it may crash because answers is None and not handled
    // After fix, it should exit gracefully
    expect(result.status).toBe(0);
  });
});[0m
