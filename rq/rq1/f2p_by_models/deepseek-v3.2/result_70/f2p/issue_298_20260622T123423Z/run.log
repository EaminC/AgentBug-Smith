            mock_client.get_all.assert_called_once_with(
                agent_id="custom_agent",
                filters=None,
                limit=100
            )
            
            mock_client.reset_mock()
            mem.reset()
            mock_client.reset.assert_called_once_with(agent_id="custom_agent")

