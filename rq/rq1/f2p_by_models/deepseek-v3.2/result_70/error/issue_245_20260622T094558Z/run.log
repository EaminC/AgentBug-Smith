WORKDIR /app

# Copy the entire repository
COPY . .

# Upgrade pip and wheel
RUN python -m pip install --upgrade pip wheel

# Install poetry and dependencies using poetry.lock if exists, else fallback to pip
RUN if [ -f pyproject.toml ] && [ -f poetry.lock ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi --with dev; \
    elif [ -f pyproject.toml ]; then \
        # Assumption: no lockfile; install with pip
        pip install -e .; \
    else \
        echo "No pyproject.toml found. Exiting." && exit 1; \
    fi

# Install mandatory testing dependencies (even if not in pyproject.toml)
