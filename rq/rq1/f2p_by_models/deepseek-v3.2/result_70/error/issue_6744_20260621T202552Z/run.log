        mkdir -p src/backend/base/langflow/frontend; \
        cp -r src/frontend/build/. src/backend/base/langflow/frontend; \
    fi

# Preflight import check to fail fast
RUN python3 -c "import pytest; import langflow; print('preflight ok')"

