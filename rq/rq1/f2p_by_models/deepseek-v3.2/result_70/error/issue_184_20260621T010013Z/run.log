ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

RUN apt-get update && apt-get install -y clang libc++-dev && rm -rf /var/lib/apt/lists/*

COPY . .

# Install cargo-nextest for testing (as per README)
RUN cargo install cargo-nextest

# Build the project (including dev dependencies) to enable test execution
# The repository uses `cargo test-unit`, `cargo test-integration`, `cargo test-e2e` aliases defined in Cargo.toml
# We assume those aliases are present; build with all features to ensure test dependencies are available.
# Use `--all-targets` to include examples, benches, tests.
RUN cargo build --all-targets --verbose

# Preflight check: ensure the main crate can be loaded (use the gateway binary as a proxy)
RUN cargo run --bin gateway -- --help 2>&1 | head -1 || echo "preflight ok"

# The standard test runner for Rust is `cargo test`; but the repo uses `cargo nextest` via aliases.
# We'll install the project's dev dependencies via the build step above.
# No separate install step needed for Rust (cargo handles dependencies).

# The final CMD is inferred from the Dockerfile target 'gateway' which runs the gateway binary.
# However, this is a test builder stage; we keep bash for interactive test execution.
CMD ["/bin/bash"][0m
