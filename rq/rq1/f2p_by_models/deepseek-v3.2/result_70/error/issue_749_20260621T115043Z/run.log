    git \
    chromium \
    fonts-ipafont-gothic \
    fonts-wqy-zenhei \
    fonts-thai-tlwg \
    fonts-kacst \
    fonts-freefont-ttf \
    libxss1 \
    libgomp1 \
    npm \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

