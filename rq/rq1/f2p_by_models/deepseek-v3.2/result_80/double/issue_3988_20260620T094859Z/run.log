ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV PYTHONUNBUFFERED=1
# Set environment variables to satisfy test dependencies (from .github/workflows/tests.yml)
ENV BRAVE_API_KEY=fake-brave-key
ENV SNOWFLAKE_USER=fake-snowflake-user
ENV SNOWFLAKE_PASSWORD=fake-snowflake-password
ENV SNOWFLAKE_ACCOUNT=fake-snowflake-account
ENV SNOWFLAKE_WAREHOUSE=fake-snowflake-warehouse
ENV SNOWFLAKE_DATABASE=fake-snowflake-database
ENV SNOWFLAKE_SCHEMA=fake-snowflake-schema
ENV EMBEDCHAIN_DB_URI=sqlite:///test.db

WORKDIR /app

# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository (critical for externally injected tests)
COPY . .

# Detect if src/ layout is used (check for src directory or imports in tests)
RUN if [ -d "lib/crewai/src" ] || (find . -name "*.py" -type f -exec grep -l "^\s*from src\.\|^\s*import src\." {} \; 2>/dev/null | head -1 | grep -q .); then \
    echo "src/ layout detected; setting PYTHONPATH and skipping editable install" && \
    export PYTHONPATH=/app/lib/crewai/src:$PYTHONPATH; \
    else \
    echo "No src/ layout detected; will perform editable install if possible"; \
    fi

# Install dependencies based on evidence from repository files
# Use uv if lockfile exists (from pyproject.toml tool.uv workspace), else fallback to pip
# The repository uses uv workspace with members: lib/crewai, lib/crewai-tools, lib/devtools
# We'll install dependencies for lib/crewai and lib/crewai-tools as they are the main packages.
RUN if [ -f "uv.lock" ]; then \
    echo "Using uv for dependency installation" && \
    # Install uv if not present (python:3.12-slim may not have it)
    pip install uv && \
    # Install all groups and extras (as in .github/workflows/tests.yml)
    uv sync --all-groups --all-extras --no-install-project && \
    # Install the packages in development mode (editable)
    uv pip install -e ./lib/crewai -e ./lib/crewai-tools; \
    else \
    echo "uv.lock not found, falling back to pip" && \
    # Install from requirements if exists (none evident, but check)
    if [ -f "requirements.txt" ]; then pip install -r requirements.txt; fi && \
    # Install the packages in development mode (editable) if no src/ layout
    if [ ! -d "lib/crewai/src" ] && ! (find . -name "*.py" -type f -exec grep -l "^\s*from src\.\|^\s*import src\." {} \; 2>/dev/null | head -1 | grep -q .); then \
        pip install -e ./lib/crewai -e ./lib/crewai-tools; \
    fi; \
    fi

# Unconditionally install test dependencies (mandatory)
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai \
    pytest-subprocess vcrpy pytest-recording pytest-randomly pytest-split \
    types-requests types-pyyaml types-regex types-appdirs boto3-stubs[bedrock-runtime] types-psycopg2 types-pymysql

# Preflight import check (mandatory)
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Final command (mandatory)
CMD ["/bin/bash"][0m
