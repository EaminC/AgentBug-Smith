ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Upgrade packaging tools first
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Detect src layout or imports with src. to decide editable install
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." . 2>/dev/null; then \
    echo "src layout detected, setting PYTHONPATH and skipping editable install"; \
    ENV PYTHONPATH=/app; \
    # Install dependencies from pyproject.toml if available (no lockfile)
    if [ -f "pyproject.toml" ]; then \
        pip install -e .[dev]; \
    else \
        # Fallback: install core dependencies and test tooling
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi; \
    # Install test dependencies unconditionally
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai fakeredis aiosqlite greenlet; \
else \
    echo "No src layout, performing editable install"; \
    # Install project with dev extras (includes test dependencies)
    if [ -f "pyproject.toml" ]; then \
        pip install -e .[dev]; \
    else \
        # Fallback if pyproject.toml missing (should not happen)
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai fakeredis aiosqlite greenlet; \
    fi; \
fi

# Preflight check to ensure core modules can be imported
RUN python -c 'import pkg_resources, pytest, agentscope; print("preflight ok")'

