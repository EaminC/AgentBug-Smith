[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository (including externally-injected test scripts)
COPY . .

# Detect src/ layout and conditional editable install
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." tests 2>/dev/null; then \
    # src/ layout detected: set PYTHONPATH and skip editable install
    echo "src/ layout detected, skipping editable install" && \
    ENV PYTHONPATH=/app && \
    # Install dependencies from requirements.txt if exists
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi && \
    # Install core dependencies and test tooling
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
    # No src/ layout: proceed with standard editable install
    # Install dependencies from requirements.txt if exists
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi && \
    # Install the project in editable mode
    pip install -e . && \
    # Install test tooling
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Preflight import check to fail fast if core modules are missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

