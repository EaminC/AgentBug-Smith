from agent.core.models import AgentConfiguration, AgentType
from pydantic import ValidationError


def test_agent_configuration_accepts_string_agent_type():
    """
    Test that AgentConfiguration correctly accepts string values for agent_type,
    not just enum values, to fix the validation error.
    """
    # In buggy code, passing AgentType.ITERATIVE (enum) would cause validation error
    # because the field expects a string after pydantic's use_enum_values=True.
    # The fix ensures we can pass either string or enum, but internally converts to string.
    
    # Test 1: Passing string "iterative" should work (this should pass in both buggy and fixed)
    config1 = AgentConfiguration(agent_type="iterative")
    assert config1.agent_type == "iterative"
    
    # Test 2: Passing string "reactive" should work
    config2 = AgentConfiguration(agent_type="reactive")
    assert config2.agent_type == "reactive"
    
    # Test 3: Passing enum AgentType.ITERATIVE should also work, but in buggy code
    # this would cause validation error because the enum value is passed directly
    # while pydantic expects a string due to use_enum_values=True.
    # After fix, enum should be converted to its string value.
    config3 = AgentConfiguration(agent_type=AgentType.ITERATIVE)
    # In fixed code, this should be string "iterative"
    assert config3.agent_type == "iterative"
    
    # Test 4: Passing enum AgentType.REACTIVE should work
    config4 = AgentConfiguration(agent_type=AgentType.REACTIVE)
    assert config4.agent_type == "reactive"
    
    # Test 5: Invalid string should raise ValidationError
    with pytest.raises(ValidationError):
        AgentConfiguration(agent_type="invalid")


def test_agent_configuration_field_type():
