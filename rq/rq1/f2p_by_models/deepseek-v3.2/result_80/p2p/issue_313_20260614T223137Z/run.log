def test_agent_configuration_accepts_string_agent_type():
    """Test that AgentConfiguration accepts string 'reactive' and 'iterative'."""
    # Import after patch should work with strings
    from agent.core.models.configuration import AgentConfiguration
    from agent.core.models import AgentType

    # Test with string "reactive"
    config1 = AgentConfiguration(agent_type="reactive")
    assert config1.agent_type == "reactive"

    # Test with string "iterative"
    config2 = AgentConfiguration(agent_type="iterative")
    assert config2.agent_type == "iterative"

    # Test with enum (should still work via use_enum_values=True)
    config3 = AgentConfiguration(agent_type=AgentType.REACTIVE)
    # After patch, enum values are converted to strings via use_enum_values=True
    assert config3.agent_type == "reactive"

    config4 = AgentConfiguration(agent_type=AgentType.ITERATIVE)
    assert config4.agent_type == "iterative"


def test_create_agent_executor_with_string_agent_type():
    """Test create_agent_executor handles string agent_type correctly."""
    from agent.core.executor import create_agent_executor
    from agent.core.models import AgentType

    # Mock minimal dependencies to avoid needing full agent setup
    class MockAgent:
        pass

    # Test with string "reactive"
    executor1 = create_agent_executor(
        agent=MockAgent(),
        agent_type="reactive",
        config_kwargs={}
    )
    assert executor1.config.agent_type == "reactive"

    # Test with string "iterative"
    executor2 = create_agent_executor(
        agent=MockAgent(),
        agent_type="iterative",
        config_kwargs={}
    )
    assert executor2.config.agent_type == "iterative"

    # Test with enum (should be converted to string)
    executor3 = create_agent_executor(
        agent=MockAgent(),
        agent_type=AgentType.REACTIVE,
        config_kwargs={}
    )
    assert executor3.config.agent_type == "reactive"

    executor4 = create_agent_executor(
        agent=MockAgent(),
        agent_type=AgentType.ITERATIVE,
        config_kwargs={}
    )
    assert executor4.config.agent_type == "iterative"

    # Test invalid string defaults to reactive
    executor5 = create_agent_executor(
        agent=MockAgent(),
        agent_type="invalid",
        config_kwargs={}
    )
    assert executor5.config.agent_type == "reactive"


def test_memory_context_accepts_string_agent_type():
    """Test MemoryContext accepts string agent_type."""
    from agent.core.models import MemoryContext

    # Test with string "iterative"
    context1 = MemoryContext(context_id="test123", agent_type="iterative")
    assert context1.agent_type == "iterative"

    # Test with string "reactive"
    context2 = MemoryContext(context_id="test456", agent_type="reactive")
    assert context2.agent_type == "reactive"


