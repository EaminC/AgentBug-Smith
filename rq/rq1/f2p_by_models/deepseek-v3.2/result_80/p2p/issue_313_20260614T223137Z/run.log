from agent.core.models import AgentConfiguration, AgentType
from pydantic import ValidationError


def test_agent_configuration_accepts_string_agent_type():
    """Test that AgentConfiguration accepts string 'reactive' and 'iterative'."""
    # This should pass after the fix; before the fix, using the enum directly
    # would cause validation errors when the enum is passed as a string representation.
    # The bug was that AgentConfiguration.agent_type expected a string but got an enum.
    # The fix changes the field to accept both enum and string, and the executor
    # converts enum to its string value.
    
    # Test with string "reactive"
    config1 = AgentConfiguration(agent_type="reactive")
    assert config1.agent_type == "reactive"
    
    # Test with string "iterative"
    config2 = AgentConfiguration(agent_type="iterative")
    assert config2.agent_type == "iterative"
    
    # Test with enum AgentType.REACTIVE (should be converted to string via use_enum_values=True)
    config3 = AgentConfiguration(agent_type=AgentType.REACTIVE)
    # After fix, this should be string "reactive"
    assert config3.agent_type == "reactive"
    
    # Test with enum AgentType.ITERATIVE (should be converted to string via use_enum_values=True)
    config4 = AgentConfiguration(agent_type=AgentType.ITERATIVE)
    # After fix, this should be string "iterative"
    assert config4.agent_type == "iterative"


def test_agent_configuration_rejects_invalid_string():
    """Test that invalid string raises ValidationError."""
    with pytest.raises(ValidationError):
        AgentConfiguration(agent_type="invalid")


def test_executor_creates_config_with_string():
    """Test that create_agent_executor handles string agent_type correctly."""
    from agent.core.executor import create_agent_executor
    
    # Mock agent and other dependencies to avoid external calls
    class MockAgent:
        pass
    
    # Test with string "reactive"
    executor = create_agent_executor(
        agent=MockAgent(),
        agent_type="reactive",
        config_kwargs={}
    )
    assert executor.config.agent_type == "reactive"
    
    # Test with string "iterative"
    executor = create_agent_executor(
        agent=MockAgent(),
        agent_type="iterative",
        config_kwargs={}
    )
    assert executor.config.agent_type == "iterative"
    
    # Test with enum AgentType.REACTIVE (should be converted to string)
    executor = create_agent_executor(
        agent=MockAgent(),
        agent_type=AgentType.REACTIVE,
        config_kwargs={}
    )
    assert executor.config.agent_type == "reactive"
    
    # Test with enum AgentType.ITERATIVE (should be converted to string)
    executor = create_agent_executor(
        agent=MockAgent(),
        agent_type=AgentType.ITERATIVE,
        config_kwargs={}
    )
    assert executor.config.agent_type == "iterative"


def test_memory_context_accepts_string_agent_type():
