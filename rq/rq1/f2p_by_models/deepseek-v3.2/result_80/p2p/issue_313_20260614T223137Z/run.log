from pydantic import ValidationError


def test_agent_configuration_accepts_string_agent_type():
    """Test that AgentConfiguration accepts string values for agent_type."""
    from agent.core.models.configuration import AgentConfiguration

    # Should accept string "reactive"
    config1 = AgentConfiguration(agent_type="reactive")
    assert config1.agent_type == "reactive"

    # Should accept string "iterative"
    config2 = AgentConfiguration(agent_type="iterative")
    assert config2.agent_type == "iterative"

    # Should reject invalid string
    with pytest.raises(ValidationError):
        AgentConfiguration(agent_type="invalid")


def test_create_agent_executor_with_string_agent_type():
    """Test that create_agent_executor handles string agent_type correctly."""
    from agent.core.executor import create_agent_executor
    from agent.core.models import AgentConfiguration

    # Test with string "reactive"
    executor1 = create_agent_executor(agent_type="reactive")
    assert isinstance(executor1.config, AgentConfiguration)
    assert executor1.config.agent_type == "reactive"

    # Test with string "iterative"
    executor2 = create_agent_executor(agent_type="iterative")
    assert executor2.config.agent_type == "iterative"

    # Test with uppercase string (should be lowercased)
    executor3 = create_agent_executor(agent_type="ITERATIVE")
    assert executor3.config.agent_type == "iterative"

    # Test with invalid string (should default to reactive)
    executor4 = create_agent_executor(agent_type="invalid")
    assert executor4.config.agent_type == "reactive"


def test_memory_context_accepts_string_agent_type():
    """Test that MemoryContext accepts string values for agent_type."""
    from agent.core.models import MemoryContext

    # Should accept string "reactive"
    ctx1 = MemoryContext(context_id="test1", agent_type="reactive")
    assert ctx1.agent_type == "reactive"

    # Should accept string "iterative"
    ctx2 = MemoryContext(context_id="test2", agent_type="iterative")
    assert ctx2.agent_type == "iterative"

    # Should reject invalid string
    with pytest.raises(ValidationError):
        MemoryContext(context_id="test3", agent_type="invalid")


