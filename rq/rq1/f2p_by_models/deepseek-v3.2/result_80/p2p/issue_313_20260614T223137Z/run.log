def test_agent_configuration_accepts_string_agent_type():
    from agent.core.models.configuration import AgentConfiguration
    from agent.core.models import AgentType

    # In buggy code, AgentConfiguration.agent_type expects AgentType enum,
    # but the field is defined as AgentType | str with use_enum_values=True.
    # The bug is that code passes AgentType.ITERATIVE (enum) instead of string.
    # This test should fail before fix because AgentType.ITERATIVE is an enum,
    # but the validation expects a string due to use_enum_values=True.
    # After fix, both string and enum should work.

    # Test with string (should always work)
    config1 = AgentConfiguration(agent_type="iterative")
    assert config1.agent_type == "iterative"

    # Test with enum (buggy: might raise validation error or store incorrectly)
    config2 = AgentConfiguration(agent_type=AgentType.ITERATIVE)
    # After fix, enum should be converted to its string value via use_enum_values
    assert config2.agent_type == "iterative"

    # Test default
    config3 = AgentConfiguration()
    assert config3.agent_type == "reactive"


