[32mimport pytest
from agent.core.models import AgentConfiguration, AgentType
from pydantic import ValidationError


def test_agent_configuration_accepts_string_agent_type():
    """Test that AgentConfiguration accepts string 'reactive' and 'iterative'."""
    # Should work with string values
    config1 = AgentConfiguration(agent_type="reactive")
    assert config1.agent_type == "reactive"
    
    config2 = AgentConfiguration(agent_type="iterative")
    assert config2.agent_type == "iterative"
    
    # Should also work with enum values (but they should be converted to strings)
    config3 = AgentConfiguration(agent_type=AgentType.REACTIVE)
    # After fix, this should be string "reactive", not the enum
    assert config3.agent_type == "reactive"
    
    config4 = AgentConfiguration(agent_type=AgentType.ITERATIVE)
    assert config4.agent_type == "iterative"


def test_agent_configuration_rejects_invalid_string():
    """Test that invalid string values raise validation error."""
    with pytest.raises(ValidationError) as exc_info:
        AgentConfiguration(agent_type="invalid_type")
    
    # Check that the error message mentions the expected values
    error_str = str(exc_info.value)
    assert "reactive" in error_str or "iterative" in error_str


def test_agent_configuration_uses_enum_values_config():
    """Test that model_config['use_enum_values'] = True converts enums to strings."""
    # This test verifies that when we pass an enum, it gets converted to its string value
    config = AgentConfiguration(agent_type=AgentType.ITERATIVE)
    
    # The bug was that agent_type was set to the enum object instead of its string value
    # After fix, agent_type should be a string
    assert isinstance(config.agent_type, str)
    assert config.agent_type == "iterative"


def test_create_agent_executor_with_string_agent_type():
    """Test that create_agent_executor function handles string agent_type correctly."""
    from agent.core.executor import create_agent_executor
    from agent.core.models import AgentCard
    
    # Mock agent card
    mock_agent_card = AgentCard(
        name="Test Agent",
        description="Test Description",
        version="1.0.0"
    )
    
    # Test with string "iterative"
    executor = create_agent_executor(
        agent=mock_agent_card,
        agent_type="iterative"
    )
    assert executor.config.agent_type == "iterative"
    
    # Test with string "reactive"
    executor = create_agent_executor(
        agent=mock_agent_card,
        agent_type="reactive"
    )
    assert executor.config.agent_type == "reactive"
    
    # Test with enum AgentType.ITERATIVE (should be converted to string)
    executor = create_agent_executor(
        agent=mock_agent_card,
        agent_type=AgentType.ITERATIVE
    )
    assert executor.config.agent_type == "iterative"


def test_memory_context_with_string_agent_type():
    """Test that MemoryContext accepts string agent_type."""
    from agent.core.models import MemoryContext
    
    # Should work with string "iterative"
    context = MemoryContext(
        context_id="test-context",
        agent_type="iterative"
    )
    assert context.agent_type == "iterative"
    
    # Should also work with enum (converted to string)
    context = MemoryContext(
        context_id="test-context",
        agent_type=AgentType.ITERATIVE
    )
    assert context.agent_type == "iterative"


def test_cli_init_agent_uses_string_values():
    """Test that CLI init_agent command uses string values for agent_type."""
    # Import the function that handles agent type selection
    from agent.cli.commands.init_agent import _prompt_for_features
    
    # Create a mock project config
    project_config = {}
    
