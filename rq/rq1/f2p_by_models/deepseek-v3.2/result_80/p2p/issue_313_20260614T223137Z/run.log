    # After fix, the code should use string literals "reactive" and "iterative"
    # Check that AgentType is not imported in the fixed version
    assert not hasattr(init_agent_module, 'AgentType') or \
           init_agent_module.AgentType is not agent.core.models.AgentType[0m
