[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository (including externally injected test scripts)
COPY . .

# Detect src layout or imports from src.
RUN if [ -d "src" ] || grep -rq "^\s*from src\.\|^\s*import src\." . 2>/dev/null; then \
        echo "src layout detected, skipping editable install"; \
        src_layout=1; \
    else \
        echo "no src layout, will do editable install"; \
        src_layout=0; \
    fi

# Install dependencies and project
RUN if [ -f "uv.lock" ]; then \
        pip install uv && \
        uv sync --frozen --no-dev 2>/dev/null || uv sync --no-dev; \
    elif [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    else \
        echo "No requirements.txt or uv.lock found, installing from pyproject.toml"; \
    fi && \
    if [ "$src_layout" = "0" ]; then \
        pip install -e .; \
    fi

# Install test dependencies unconditionally
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Install dev dependencies if uv.lock exists (as per CI) else install from pyproject.toml optional dependencies
RUN if [ -f "uv.lock" ]; then \
        uv sync --dev 2>/dev/null || true; \
    else \
        pip install "crewai[tools]" || true; \
        pip install ruff mypy pre-commit mkdocs mkdocstrings mkdocstrings-python mkdocs-material mkdocs-material-extensions pillow cairosvg pytest-vcr pytest-subprocess 2>/dev/null || true; \
    fi

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}
ENV PYTHONPATH=/app

# Preflight import check
RUN python -c 'import pkg_resources, pytest, crewai; print("preflight ok")'

