ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Install uv (used by the project)
RUN python -m pip install uv

# Change to the langgraph library directory
WORKDIR /app/libs/langgraph

# Install dependencies using uv (frozen lock file, dev group)
# Then ensure test framework and required extras are installed
RUN uv sync --frozen --group dev && \
    uv pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai vcrpy json_repair chromadb

# Preflight check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set working directory back to root for test execution
WORKDIR /app

