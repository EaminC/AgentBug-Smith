[32mFROM python:3.12-slim

WORKDIR /app

# Install system dependencies needed for building some packages (e.g., tiktoken)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    gcc \
    build-essential \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, and wheel to latest versions
RUN python -m pip install --upgrade pip setuptools wheel

# Copy the entire repository (required so external test scripts are included)
COPY . .

# Install uv (the project’s standard package manager) and then install all dependencies
# including dev groups and all extras as done in CI
RUN pip install uv && \
    uv sync --all-groups --all-extras

# Set required Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Preflight check to ensure core tools are available
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"][0m
