[32mimport asyncio

from crewai.agent import Agent
from crewai.project import agent, task
from crewai.task import Task


class TestAsyncDecoratorSupport:
    """Tests for async method support in @agent, @task decorators."""

    def test_async_agent_returns_agent_instance(self):
        """Async agent method should return Agent, not a coroutine."""
        class AsyncAgentCrew:
            @agent
            async def my_agent(self):
                return Agent(
                    role="Test Agent",
                    goal="Test Goal",
                    backstory="Test Backstory",
                )

        crew = AsyncAgentCrew()
        result = crew.my_agent()
        assert isinstance(result, Agent), (
            f"Expected Agent, got {type(result).__name__}"
        )

    def test_async_task_returns_task_instance(self):
        """Async task method should return Task, not a coroutine."""
        class AsyncTaskCrew:
            @task
            async def my_task(self):
                return Task(
                    description="Test Description",
                    expected_output="Test Output",
                )

        crew = AsyncTaskCrew()
        result = crew.my_task()
        assert isinstance(result, Task), (
            f"Expected Task, got {type(result).__name__}"
        )

    def test_async_agent_memoization(self):
        """Async agent methods should be memoized (same object on repeated calls)."""
        class AsyncAgentMemoCrew:
            call_count = 0

            @agent
            async def memo_agent(self):
                AsyncAgentMemoCrew.call_count += 1
                return Agent(
                    role="Memo Agent",
                    goal="Memo Goal",
                    backstory="Memo Backstory",
                )

        crew = AsyncAgentMemoCrew()
        first = crew.memo_agent()
        second = crew.memo_agent()
        assert first is second, "Async agent memoization failed"
        assert AsyncAgentMemoCrew.call_count == 1, (
            "Async agent method called more than once"
        )

    def test_async_task_memoization(self):
        """Async task methods should be memoized."""
        class AsyncTaskMemoCrew:
            call_count = 0

            @task
            async def memo_task(self):
                AsyncTaskMemoCrew.call_count += 1
                return Task(
                    description="Memo Description",
                    expected_output="Memo Output",
                )

        crew = AsyncTaskMemoCrew()
        first = crew.memo_task()
        second = crew.memo_task()
        assert first is second, "Async task memoization failed"
        assert AsyncTaskMemoCrew.call_count == 1, (
            "Async task method called more than once"
        )

    def test_async_task_name_inference(self):
        """Async task should have its name inferred from the method name."""
        class AsyncTaskNameCrew:
            @task
            async def named_task(self):
                return Task(
                    description="Name Test",
                    expected_output="Name Test Output",
                )

        crew = AsyncTaskNameCrew()
        task_instance = crew.named_task()
        assert task_instance.name == "named_task", (
            f"Expected name 'named_task', got '{task_instance.name}'"
        )[0m
