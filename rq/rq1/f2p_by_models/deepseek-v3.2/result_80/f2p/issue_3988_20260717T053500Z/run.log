[32mFROM python:3.12-slim

WORKDIR /app

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repo
COPY . .

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Install package and dependencies (editable) + test tooling
# The workspace root is not a package, so we install lib/crewai and lib/crewai-tools
RUN pip install --no-build-isolation -e lib/crewai -e lib/crewai-tools && \
    pip install \
        pytest pytest-mock pytest-asyncio pytest-cov anyio \
        "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai \
        pytest-subprocess vcrpy==7.0.0 pytest-recording pytest-randomly pytest-split

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"][0m
