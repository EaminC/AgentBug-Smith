    def test_vertex_ai_model_name_normalization():
        """Test that vertex_ai model names are normalized correctly in the Model class."""
        # This test is about the bug described in issue #4109.
        # The bug is that vertex_ai model names containing "-language-models/" cause
        # LiteLLM errors because the provider cannot be parsed.
        # The fix in the issue body (not in the PR) would normalize such names in
        # models.py, but the PR only fixes model-settings.yml entries for anthropic models.
        # However, the PR's patch changes model-settings.yml to remove "-anthropic_models/"
        # from certain vertex_ai model names. This is a different substring, but it's
        # the actual fix applied in the repository.
        # We need to ensure that after the patch, the model names in model-settings.yml
        # do not contain "-anthropic_models/". Before the patch, they do.
        # Therefore, we can test that loading a specific model from model-settings.yml
        # yields the corrected name.
        # We'll test the vertex_ai/claude-3-7-sonnet@20250219 entry.
        import os
        import yaml
        settings_path = os.path.join(
            os.path.dirname(__file__), '..', 'aider', 'resources', 'model-settings.yml'
        )
        with open(settings_path) as f:
            data = yaml.safe_load(f)
        found = False
        for entry in data:
            name = entry.get('name', '')
            if 'vertex_ai' in name and 'claude-3-7-sonnet@20250219' in name:
