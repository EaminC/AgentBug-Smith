# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository (critical for external test injection)
COPY . .

# Set Forge environment variables (required)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Detect src/ layout to avoid duplicate module loading
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." . 2>/dev/null; then \
    echo "src layout detected, skipping editable install"; \
    # Install dependencies from requirements.txt if it exists
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi; \
    # Install testing dependencies unconditionally
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    # Set PYTHONPATH to import from /app directly
    ENV PYTHONPATH=/app; \
else \
    echo "no src layout, performing editable install"; \
    # Install dependencies from requirements.txt if it exists
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi; \
    # Install the project in editable mode
    pip install -e .; \
    # Install testing dependencies unconditionally
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
fi

# Preflight import check
