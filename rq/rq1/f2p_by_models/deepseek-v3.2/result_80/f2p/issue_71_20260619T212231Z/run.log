from unittest.mock import patch, MagicMock
from agentscope.models.openai_model import OpenAIChatWrapper
from agentscope.models.dashscope_model import DashScopeChatWrapper
from agentscope.message import Msg


def test_openai_model_single_message_should_raise_type_error():
    """
    Bug: passing a single dict (not a list) should raise a TypeError after fix.
    In buggy code, it incorrectly raises ValueError about missing role/content.
    After fix, it raises ValueError about type mismatch.
    """
    with patch("openai.OpenAI") as mock_openai_class:
        mock_client = MagicMock()
        mock_openai_class.return_value = mock_client
        mock_response = MagicMock()
        mock_response.choices = [MagicMock()]
        mock_response.choices[0].message.content = "dummy response"
        mock_client.chat.completions.create.return_value = mock_response

        config = {
            "config_name": "test_openai",
            "model_name": "gpt-3.5-turbo",
            "api_key": "dummy_key",
        }
        with patch("agentscope.utils.monitor.SqliteMonitor.register_budget"):
            model = OpenAIChatWrapper(config)

        # Single dict (not a list) - this is the bug trigger
        single_msg = Msg(name="user", role="user", content="hello")

        # In buggy code, this raises ValueError about missing role/content.
        # In fixed code, it raises ValueError about type mismatch.
        with pytest.raises(ValueError) as exc_info:
            model(single_msg)

        # After fix, error message should mention expected type list
        # In buggy code, error message is about missing role/content.
        # We just need to ensure the test fails on buggy code and passes on fixed.
        # The exact error message may differ, but the test will pass if the
        # exception is raised (since buggy code also raises ValueError).
        # However, we need to differentiate: buggy code raises ValueError
        # with "Each message in the 'messages' list must contain a 'role' and 'content' key"
        # while fixed code raises ValueError with "OpenAI `messages` field expected type `list`".
        # So we can assert the error message contains "expected type `list`" after fix.
        # But we must not assert that in buggy code because it will fail.
        # Instead, we can check that the exception is raised (both raise ValueError).
        # The test will pass on both buggy and fixed? No, because buggy code raises
        # ValueError, so the test passes. That's not a fail2pass.
        # We need to make the test fail on buggy code. How?
        # In buggy code, the ValueError is about missing role/content.
        # In fixed code, the ValueError is about type mismatch.
        # We can assert that the error message does NOT contain "role and content key"
        # after fix, but that's not a failure condition.
        # Instead, we can assert that the error message contains "expected type `list`".
        # That will fail on buggy code because the message is different.
        # So we do:
        assert "expected type `list`" in str(exc_info.value)


