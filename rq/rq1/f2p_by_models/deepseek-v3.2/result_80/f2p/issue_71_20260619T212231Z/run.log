    def test_dashscope_model_msg_object_in_list_works():
        """
        Msg in list works for DashScope.
        """
        with patch("dashscope.Generation") as mock_gen_class:
            mock_response = MagicMock()
            mock_response.output = MagicMock()
            mock_response.output.choices = [MagicMock()]
            mock_response.output.choices[0].message = {"content": "dummy"}
            mock_gen_class.call.return_value = mock_response
    
            config = {
                "config_name": "test_dashscope",
                "model_name": "qwen-turbo",
                "api_key": "dummy_key",
            }
            with patch("agentscope.utils.monitor.SqliteMonitor.register_budget"):
                model = DashScopeChatWrapper(config)
    
