    should raise ValueError about missing role/content because the
    check iterates over the dict's keys incorrectly.
    After fix, it should raise a clearer error about expecting a list.
    """
    with patch("openai.OpenAI") as mock_client_class:
        mock_client = MagicMock()
        mock_client_class.return_value = mock_client
        mock_response = MagicMock()
        mock_response.choices = [MagicMock()]
        mock_response.choices[0].message.content = "dummy"
        mock_client.chat.completions.create.return_value = mock_response

        config = {
            "config_name": "test_openai",
            "model_name": "gpt-3.5-turbo",
            "api_key": "dummy_key",
        }
        with patch("agentscope.utils.monitor.SqliteMonitor.register_budget"):
            model = OpenAIChatWrapper(config)

        # Single dict (like Msg.to_dict()) that has role and content
        single_msg = {"role": "user", "content": "hello"}
        # In buggy code, this will raise ValueError about missing role/content
        # because the check iterates over the dict's keys.
        # After fix, it should raise ValueError about expecting list.
        with pytest.raises(ValueError) as exc_info:
            model(single_msg)
        # The exact error message changes after fix.
        # In buggy code, error is "Each message in the 'messages' list must contain a 'role' and 'content' key"
        # In fixed code, error is "OpenAI `messages` field expected type `list`, got `<class 'dict'>` instead."
        # We'll just ensure it raises ValueError; the test will pass if it raises any ValueError.
        assert isinstance(exc_info.value, ValueError)


