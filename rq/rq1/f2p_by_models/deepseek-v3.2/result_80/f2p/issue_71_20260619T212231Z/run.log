import os
import pytest
from unittest.mock import patch, MagicMock

# Add src to path if needed
sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))

from agentscope.models.openai_model import OpenAIChatWrapper
from agentscope.models.dashscope_model import DashScopeChatWrapper
from agentscope.message import Msg


def test_openai_model_single_message_should_raise_type_error():
    """
    On buggy code: passing a single dict (not a list) should raise ValueError
    because the check `all("role" in msg ...)` iterates over dict keys and fails.
    On fixed code: the new `isinstance(messages, list)` check should raise a
    clearer ValueError about type mismatch.
    In both cases, the test expects a ValueError, but the buggy code raises
    ValueError for wrong reason (missing role/content) while fixed code raises
    for type mismatch. However, the buggy code's error is still a ValueError,
    so the test would pass on both? Actually, the buggy code's error message
    is about missing role/content, which is misleading but still a ValueError.
    To make the test fail2pass, we need to assert the error message changes.
    But the requirement is that the test fails on buggy code and passes on fixed.
    Let's design: On buggy code, the single dict passes the isinstance check
    (since it's missing) and goes to the `all(...)` which iterates over dict keys,
    causing `"role" in key` to be False for each key, raising ValueError.
    On fixed code, the isinstance check catches it first and raises ValueError
    with different message. Both raise ValueError, so the test won't fail.
    We need to make the test fail on buggy code. How? The buggy code's error
    is about missing role/content, but the dict does have role and content.
    Wait: The bug report says the dict has role and content, but the buggy code
    iterates over dict keys, so `"role" in "name"` is False. So it will raise.
    That's the bug: it should treat the dict as a single message, not iterate.
    The fix adds isinstance check, which will raise before the role/content check.
    So on buggy code, the error is about missing role/content (incorrect).
    On fixed code, the error is about type mismatch (correct).
    Both are ValueError, but we can differentiate by checking error message.
    We'll assert that the error message contains "expected type `list`".
    On buggy code, the error message does NOT contain that, so assertion fails.
    On fixed code, it does contain that, so assertion passes.
    That's a fail2pass.
    """
    # Mock the OpenAI client to avoid real API calls
    with patch("openai.OpenAI") as mock_openai_class:
        mock_client = MagicMock()
        mock_openai_class.return_value = mock_client
        mock_response = MagicMock()
        mock_response.choices = [MagicMock()]
        mock_response.choices[0].message.content = "dummy response"
        mock_client.chat.completions.create.return_value = mock_response

        config = {
            "config_name": "test_openai",
            "model_name": "gpt-3.5-turbo",
            "api_key": "dummy_key",
        }
        model = OpenAIChatWrapper(config)

        # Single message dict with role and content (as in issue)
        single_msg = Msg(name="user", role="user", content="hello")
        # Convert to dict as expected by the model
        msg_dict = single_msg.to_dict()

        # On buggy code, this raises ValueError with message about missing role/content.
        # On fixed code, raises ValueError with message about expected type list.
        with pytest.raises(ValueError) as exc_info:
            model(msg_dict)

        # Assert the error message indicates type mismatch (fixed behavior)
        assert "expected type `list`" in str(exc_info.value)


def test_dashscope_model_single_message_should_raise_type_error():
    """
    Similar test for DashScope model.
    """
    # Mock the DashScope client. The actual client is accessed via `dashscope.Application`
    # but the wrapper uses `dashscope.Application.call`. We'll mock the module.
    with patch("dashscope.Application") as mock_app_class:
        mock_call = MagicMock()
        mock_app_class.call = mock_call
        mock_response = MagicMock()
        mock_response.output.choices = [MagicMock()]
        mock_response.output.choices[0].message.content = "dummy response"
        mock_call.return_value = mock_response

        config = {
            "config_name": "test_dashscope",
            "model_name": "qwen-turbo",
            "api_key": "dummy_key",
        }
        model = DashScopeChatWrapper(config)

        single_msg = Msg(name="user", role="user", content="hello")
        msg_dict = single_msg.to_dict()

        with pytest.raises(ValueError) as exc_info:
            model(msg_dict)

        assert "expected type `list`" in str(exc_info.value)


def test_openai_model_list_of_messages_works():
    """
    Ensure that a proper list of messages passes the check and returns a mock response.
    This should work on both buggy and fixed code, but we need to mock the API call.
    """
    with patch("openai.OpenAI") as mock_openai_class:
        mock_client = MagicMock()
        mock_openai_class.return_value = mock_client
        mock_response = MagicMock()
        mock_response.choices = [MagicMock()]
        mock_response.choices[0].message.content = "dummy response"
        mock_client.chat.completions.create.return_value = mock_response

        config = {
            "config_name": "test_openai",
            "model_name": "gpt-3.5-turbo",
            "api_key": "dummy_key",
        }
        model = OpenAIChatWrapper(config)

        # List of messages
        messages = [
            Msg(name="user", role="user", content="hello").to_dict(),
            Msg(name="assistant", role="assistant", content="hi").to_dict(),
        ]

        response = model(messages)
        assert response.text == "dummy response"
        # Verify the mock was called with correct arguments
        mock_client.chat.completions.create.assert_called_once()


