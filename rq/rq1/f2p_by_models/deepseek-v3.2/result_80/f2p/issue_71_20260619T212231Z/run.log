from unittest.mock import patch, MagicMock
from agentscope.models.openai_model import OpenAIChatWrapper
from agentscope.models.dashscope_model import DashScopeChatWrapper
from agentscope.message import Msg


def test_openai_model_single_message_as_dict_fails_on_buggy():
    """
    On buggy code, passing a single dict (Msg) directly should raise ValueError
    because the check `all("role" in msg ...)` iterates over the dict keys,
    which fails.
    """
    with patch("openai.OpenAI") as mock_openai_class:
        mock_client = MagicMock()
        mock_openai_class.return_value = mock_client
        mock_response = MagicMock()
        mock_response.choices = [MagicMock()]
        mock_response.choices[0].message = MagicMock()
        mock_response.choices[0].message.content = "dummy"
        mock_client.chat.completions.create.return_value = mock_response

        config = {
            "config_name": "test_openai",
            "model_name": "gpt-3.5-turbo",
            "api_key": "dummy_key",
        }
        with patch("agentscope.utils.monitor.SqliteMonitor.register_budget"):
            model = OpenAIChatWrapper(config)

        msg = Msg(name="user", role="user", content="hello")
        # Pass the Msg object directly (it's a dict). This should raise ValueError
        # on buggy code because the check iterates over dict keys.
        with pytest.raises(ValueError) as exc_info:
            model(msg)
        # The error message should be the one from the buggy check
        assert "Each message in the 'messages' list must contain a 'role'" in str(exc_info.value)


