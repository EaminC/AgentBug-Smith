def test_openai_model_single_message_as_dict_fails_on_buggy():
    """
    In buggy code, passing a single dict (with role and content) should raise
    ValueError because the check iterates over the dict keys.
    After fix, it should raise ValueError about type mismatch (not a list).
    """
    with patch("openai.OpenAI") as mock_client_class:
        mock_client = MagicMock()
        mock_client_class.return_value = mock_client
        mock_response = MagicMock()
        mock_response.choices = [MagicMock()]
        mock_response.choices[0].message = MagicMock()
        mock_response.choices[0].message.content = "dummy"
        mock_response.usage = MagicMock()
        mock_response.usage.total_tokens = 10
        mock_client.chat.completions.create.return_value = mock_response

        config = {
            "config_name": "test_openai",
            "model_name": "gpt-3.5-turbo",
            "api_key": "dummy_key",
        }
        with patch("agentscope.utils.monitor.SqliteMonitor.register_budget"):
            model = OpenAIChatWrapper(config)

        # Single dict (not a list) with role and content
        single_msg = {"role": "user", "content": "hello"}
        # In buggy code, this will raise ValueError because the check
        # iterates over the dict keys, and "role" in msg fails (msg becomes
        # keys like "role", "content").
        # After fix, it will raise ValueError about type mismatch.
        with pytest.raises(ValueError) as exc_info:
            model(single_msg)
        # Ensure the error is the one we expect from buggy code
        # (the buggy error message)
        error_msg = str(exc_info.value)
        # In buggy code, the error is about missing role/content.
        # After fix, error is about type mismatch.
        # We just need the test to fail on buggy, pass on fixed.
        # So we assert that the error contains the buggy message.
        # This assertion will fail after fix because the error message changes.
        assert "Each message in the 'messages' list must contain a 'role'" in error_msg


