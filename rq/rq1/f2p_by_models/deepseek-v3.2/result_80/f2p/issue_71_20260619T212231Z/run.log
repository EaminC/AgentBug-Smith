def test_openai_model_msg_object_as_single_message_should_raise():
    """
    Passing a Msg object (which is a dict subclass) as a single argument.
    This should raise ValueError after fix, but buggy code raises a different ValueError.
    """
    with patch("openai.OpenAI") as mock_openai_class:
        mock_client = MagicMock()
        mock_openai_class.return_value = mock_client
        mock_response = MagicMock()
        mock_response.choices = [MagicMock()]
        mock_response.choices[0].message.content = "dummy response"
        mock_client.chat.completions.create.return_value = mock_response

        config = {
            "config_name": "test_openai",
            "model_name": "gpt-3.5-turbo",
            "api_key": "dummy_key",
        }
        with patch("agentscope.utils.monitor.SqliteMonitor.register_budget"):
            model = OpenAIChatWrapper(config)

        msg = Msg(name="user", role="user", content="hello")
        # Msg is a dict subclass, but still a single dict.
        with pytest.raises(ValueError) as exc_info:
            model(msg)
        # After fix, error mentions expected type list
        assert "expected type `list`" in str(exc_info.value)


