[32mimport os
import sys
from unittest.mock import patch, MagicMock

import pytest

from agentscope.models.openai_model import OpenAIChatWrapper
from agentscope.models.dashscope_model import DashScopeChatWrapper
from agentscope.message import Msg


def test_openai_model_single_message_should_raise_type_error():
    """
    In buggy code, a single dict message (not a list) passes the `all(...)` check
    because `all` over a dict iterates over keys, causing a false pass.
    After the fix, a single dict should raise ValueError about expected type list.
    """
    # Mock the OpenAI client to avoid real API calls
    with patch("openai.OpenAI") as mock_openai_class:
        mock_client = MagicMock()
        mock_openai_class.return_value = mock_client
        mock_response = MagicMock()
        mock_response.choices = [MagicMock()]
        mock_response.choices[0].message.content = "dummy response"
        mock_client.chat.completions.create.return_value = mock_response

        config = {
            "config_name": "test_openai",
            "model_name": "gpt-3.5-turbo",
            "api_key": "dummy_key",
        }
        # Patch monitor to avoid TypeError in register_budget
        with patch("agentscope.utils.monitor.SqliteMonitor.register_budget"):
            model = OpenAIChatWrapper(config)

        # Single dict message (like a Msg object converted to dict)
        single_msg = Msg(name="user", role="user", content="hello").to_dict()

        # In buggy code, this would incorrectly pass the `all(...)` check
        # and proceed to call the API, which would succeed because we mocked it.
        # After the fix, this should raise ValueError about expected type list.
        # We expect the buggy code to NOT raise, and the fixed code to raise.
        try:
            response = model(single_msg)
            # If we reach here, buggy code passed (no exception).
            # That's a failure for the test because we expect the buggy code to fail.
            # Actually, the buggy code would raise ValueError because `all` over a dict
            # iterates over keys, and keys are strings, so `"role" in msg` is False
            # for each key? Wait, let's examine: `msg` is each key string, so
            # `"role" in "name"` is False, so `all` returns False, raising ValueError.
            # That's the bug: it raises ValueError incorrectly (should raise about type).
            # The fix changes the error message to be about type.
            # So the buggy code raises ValueError with old message, fixed code raises
            # with new message. Both raise, but messages differ.
            # We need to detect the difference.
            # Let's capture the exception and check its message.
            # If no exception, that's a test failure (should not happen).
            pytest.fail("Expected ValueError not raised")
        except ValueError as e:
            # Check error message
            if "expected type `list`" in str(e):
                # This is the fixed behavior
                pass
            else:
                # This is the buggy behavior (old message)
                # The test should fail on buggy code, pass on fixed code.
                # So we raise an assertion error to make the test fail on buggy.
                raise AssertionError(
                    f"Unexpected error message (buggy code): {e}"
                )


def test_dashscope_model_single_message_should_raise_type_error():
    """
    Similar test for DashScope model.
    """
    # Mock dashscope.Application to avoid real API calls
    with patch("dashscope.Application") as mock_app_class:
        mock_app = MagicMock()
        mock_app_class.return_value = mock_app
        mock_app.call.return_value = MagicMock(output=MagicMock(choices=[MagicMock(message=MagicMock(content="dummy"))]))

        config = {
            "config_name": "test_dashscope",
            "model_name": "qwen-max",
            "api_key": "dummy_key",
        }
        with patch("agentscope.utils.monitor.SqliteMonitor.register_budget"):
            model = DashScopeChatWrapper(config)

        single_msg = Msg(name="user", role="user", content="hello").to_dict()

        try:
            response = model(single_msg)
            pytest.fail("Expected ValueError not raised")
        except ValueError as e:
            if "expected type `list`" in str(e):
                pass
            else:
                raise AssertionError(
                    f"Unexpected error message (buggy code): {e}"
                )


def test_openai_model_list_of_messages_works():
    """
    Ensure list of messages works for OpenAI model.
    """
    with patch("openai.OpenAI") as mock_openai_class:
        mock_client = MagicMock()
        mock_openai_class.return_value = mock_client
        mock_response = MagicMock()
        mock_response.choices = [MagicMock()]
        mock_response.choices[0].message.content = "dummy response"
        mock_client.chat.completions.create.return_value = mock_response

        config = {
            "config_name": "test_openai",
            "model_name": "gpt-3.5-turbo",
            "api_key": "dummy_key",
        }
        with patch("agentscope.utils.monitor.SqliteMonitor.register_budget"):
            model = OpenAIChatWrapper(config)

        # List of dicts (proper format)
        messages = [
            Msg(name="user", role="user", content="hello").to_dict(),
            Msg(name="assistant", role="assistant", content="hi").to_dict(),
