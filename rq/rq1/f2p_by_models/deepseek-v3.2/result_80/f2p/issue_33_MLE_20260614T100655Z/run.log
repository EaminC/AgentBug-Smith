        for call in generator_calls:
            args = call[0]
            if len(args) >= 2:
                prompt = args[1]
                # Check if this is a task selection prompt or data detection prompt
                if 'Task' in str(prompt) or 'task' in str(prompt):
                    prompts.append('task_selection')
                elif 'Data' in str(prompt) or 'data' in str(prompt):
                    prompts.append('data_detection')
                elif 'Model' in str(prompt) or 'model' in str(prompt):
                    prompts.append('model_selection')
                else:
                    prompts.append('other')
        
        # The key assertion: task selection should happen AFTER data detection
        # In buggy code, task selection happens BEFORE data detection
        # In fixed code, task selection happens AFTER data detection
        
        # Find positions of key operations
        try:
            data_detection_idx = prompts.index('data_detection')
            task_selection_idx = prompts.index('task_selection')
            
            # In fixed code, data detection comes before task selection
            # This test will fail on buggy code where task selection comes first
            assert data_detection_idx < task_selection_idx, \
                f"Data detection (index {data_detection_idx}) should come before task selection (index {task_selection_idx})"
                
        except ValueError:
            # If we can't find the operations, the test should fail
            pytest.fail("Could not find data detection and task selection in the call sequence")

    def test_requirement_includes_dataset_sample_before_task_selection(self):
        """Test that dataset sample is added to requirement before task selection."""
        # Setup mock responses
        self.mock_questionary.text.side_effect = [
            "I want to analyze sentiment",  # requirement
            "/path/to/data.csv"  # dataset path
        ]
        self.mock_questionary.confirm.return_value.ask.return_value = True
        
        # Track the requirement passed to req_based_generator
        captured_requirements = []
        
        def capture_requirement(*args, **kwargs):
            captured_requirements.append(args[0])
            if len(captured_requirements) == 1:
                return 'csv_data'  # data_kind
            elif len(captured_requirements) == 2:
                return 'sentiment_analysis'  # task
            else:
                return 'LSTM'  # model
        
        self.mock_req_generator.side_effect = capture_requirement
        
        # Mock CSV data sample
        sample_data = "text,label\n'Great movie',positive\n'Terrible film',negative"
        self.mock_read_csv.return_value = sample_data
        
        # Mock plan generator
        self.mock_plan_generator.return_value = {'tasks': []}
        
        # Create chain instance
        chain = Chain(Plan.load(self.plan_file), self.mock_agent)
        chain.requirement = "I want to analyze sentiment"
        
        # Run the chain
        try:
            chain.run()
        except SystemExit:
            pass
        
        # Check that requirement passed to task selection includes dataset sample
        # In fixed code, requirement should have dataset sample added before task selection
        # In buggy code, requirement won't have dataset sample during task selection
        
        if len(captured_requirements) >= 2:
            task_selection_requirement = captured_requirements[1]
            # In fixed code, this should contain the dataset sample
            assert "Dataset Sample:" in task_selection_requirement, \
                f"Task selection requirement should include dataset sample, got: {task_selection_requirement}"
            assert sample_data in task_selection_requirement, \
                f"Task selection requirement should contain sample data, got: {task_selection_requirement}"
        else:
            pytest.fail("Task selection was not called with requirement")

if __name__ == "__main__":
    pytest.main([__file__, "-v"])[0m
