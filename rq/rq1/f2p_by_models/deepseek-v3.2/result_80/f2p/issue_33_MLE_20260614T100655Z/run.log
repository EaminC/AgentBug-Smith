from agent.utils.prompt import pmpt_task_select, pmpt_model_select, pmpt_dataset_detect, pmpt_dataset_select
from agent.integration.files import read_csv_file


class MockModel(BaseModel):
    def __init__(self):
        super().__init__()
        self.responses = []

    def set_responses(self, responses):
        self.responses = responses

    def generate(self, prompt, **kwargs):
        if self.responses:
            return self.responses.pop(0)
        return "mock_response"

    def stream_generate(self, prompt, **kwargs):
        yield "mock_stream_response"


def test_chain_task_model_selection_after_data_review():
    """
    Test that task and model architecture selection happens AFTER data review,
    not before, to avoid generic tasks when data is not yet provided.
    This matches the fix in the patch where data review (Step 2) occurs before
    task/model selection (Step 3).
    """
    # Create a temporary project directory
    tmpdir = tempfile.mkdtemp()
    project_dir = os.path.join(tmpdir, "test_project")
    os.makedirs(project_dir)

    # Create a dummy CSV file for data
    csv_path = os.path.join(project_dir, "data.csv")
    with open(csv_path, "w") as f:
        f.write("text,label\n")
        f.write("I love this movie,positive\n")
        f.write("I hate this movie,negative\n")
        f.write("It was okay,neutral\n")

    # Mock configuration
    config_data = {
        'project': {
            'path': project_dir,
            'name': 'test_project'
        }
    }
    with patch.object(Config, 'read', return_value=config_data):
        # Create a mock agent (model)
        mock_agent = MockModel()
        # Set responses for the chain:
        # 1. Data kind detection -> 'csv_data'
        # 2. Task selection -> 'Sentiment Analysis'
        # 3. Model selection -> 'BERT'
        mock_agent.set_responses([
            'csv_data',
            'Sentiment Analysis',
            'BERT'
        ])

        # Create a plan with requirement but no data_kind, dataset, or tasks
        plan = Plan(
            project=project_dir,
            requirement="I want to analyze sentiment of movie reviews.",
            data_kind=None,
            dataset=None,
            tasks=None,
            current_task=0,
            debug=3,
            debug_env="local"
        )
        plan_file = os.path.join(project_dir, "project.yml")
        plan.save(plan_file)

        # Create chain instance
        chain = Chain(plan_file, mock_agent)

        # Override the console to avoid interactive prompts
        chain.console = MagicMock()
        chain.console.log = MagicMock()
        chain.console.status = MagicMock()
        chain.console.status.return_value.__enter__ = MagicMock()
        chain.console.status.return_value.__exit__ = MagicMock()

        # Mock questionary to avoid interactive prompts
        with patch('questionary.confirm', return_value=True), \
             patch('questionary.text', side_effect=[csv_path]) as mock_text, \
             patch('agent.function.chain.req_based_generator') as mock_req_gen, \
             patch('agent.function.chain.plan_generator') as mock_plan_gen, \
             patch('agent.function.chain.match_plan') as mock_match_plan, \
             patch('agent.function.chain.run_command') as mock_run_command:

            # Configure req_based_generator to return our mocked responses
            def req_gen_side_effect(requirement, prompt, agent):
                # Return based on which prompt is being used
                prompt_text = prompt if isinstance(prompt, str) else str(prompt)
                if 'dataset_detect' in prompt_text:
                    return 'csv_data'
                elif 'task_select' in prompt_text:
                    return 'Sentiment Analysis'
                elif 'model_select' in prompt_text:
                    return 'BERT'
                elif 'dataset_select' in prompt_text:
                    return csv_path
                else:
                    return 'unknown'

            mock_req_gen.side_effect = req_gen_side_effect

            # Mock plan_generator to return a simple task list
            mock_plan_gen.return_value = {
                'tasks': [
                    {'name': 'Data Collection', 'resources': []},
                    {'name': 'Data Visualization', 'resources': []},
                    {'name': 'Model Selection', 'resources': []},
                    {'name': 'Model Training', 'resources': []}
                ]
            }

            # Mock match_plan to return a Task object
            def match_plan_side_effect(task_dict):
                return Task(
                    name=task_dict['name'],
                    resources=task_dict.get('resources', []),
                    debug=3
                )
            mock_match_plan.side_effect = match_plan_side_effect

            # Mock run_command to do nothing
            mock_run_command.return_value = None

            # Run the chain's start method (which is the main loop)
            # We'll call the internal method that runs the planning steps
            chain.requirement = plan.requirement
            chain.plan = plan

            # Simulate the planning steps as they occur in the fixed code:
            # Step 1: User requirements understanding (already set)
            # Step 2: Data quick review
            chain.console.log.assert_any_call("[bold red]Step 1: User requirements understanding[bold red]")
            # Actually the console.log calls are mocked, but we can verify order via call_args_list
            # We'll instead verify that data review happens before task selection by checking
            # that req_based_generator is called in the correct order.

            # Trigger the planning logic that happens when plan.tasks is None
            # We'll directly call the relevant part of the run method (extracted for testing)
            chain._run_planning()

            # Get all calls to req_based_generator
            calls = mock_req_gen.call_args_list
            # Extract the prompts from calls
            prompts = [call[0][1] for call in calls]

            # In the buggy code, the order would be:
            # 1. pmpt_task_select (task selection)
            # 2. pmpt_model_select (model selection)
            # 3. pmpt_dataset_detect (data detection)
            # In the fixed code, the order should be:
            # 1. pmpt_dataset_detect (data detection) - Step 2
            # 2. pmpt_task_select (task selection) - Step 3
            # 3. pmpt_model_select (model selection) - Step 3

            # Verify that dataset detection happens before task selection
            dataset_detect_index = None
            task_select_index = None
            model_select_index = None

            for i, prompt in enumerate(prompts):
                if 'dataset_detect' in str(prompt):
                    dataset_detect_index = i
                elif 'task_select' in str(prompt):
                    task_select_index = i
                elif 'model_select' in str(prompt):
                    model_select_index = i

            # Assert dataset detection occurred
            assert dataset_detect_index is not None, "Dataset detection not called"
            # Assert task selection occurred
            assert task_select_index is not None, "Task selection not called"
            # Assert model selection occurred
            assert model_select_index is not None, "Model selection not called"

            # The key assertion: dataset detection must happen BEFORE task selection
            assert dataset_detect_index < task_select_index, \
                "Dataset detection should happen before task selection (fixed order)"
            # Also task selection should happen before or same step as model selection
            # (both are in Step 3 after data review)
            assert task_select_index < model_select_index or task_select_index == model_select_index, \
                "Task selection should happen before or with model selection"

            # Additionally verify that the requirement was updated with dataset sample
            # before task selection (the fix adds dataset sample to requirement)
            assert chain.requirement is not None
            assert "Dataset Sample:" in chain.requirement, \
                "Requirement should be updated with dataset sample before task selection"

    # Cleanup
    shutil.rmtree(tmpdir)


# Helper method to extract the planning logic for testing
def Chain__run_planning(self):
    """
    Extracted planning logic from Chain.run for testing.
    This mimics the fixed code flow.
    """
    self.console.log("[bold red]Step 1: User requirements understanding[bold red]")
    if self.plan.requirement:
        self.console.log(f"[cyan]User Requirement:[/cyan] {self.plan.requirement}")
    else:
        # Mock questionary would handle this
        pass

    if not self.requirement:
        raise SystemExit("The user requirement is not provided.")

    # Step 2: Data quick review
    self.console.log("[bold red]Step 2: Data quick review[bold red]")
    if self.plan.data_kind is None:
        from agent.function.chain import req_based_generator
        from agent.utils.prompt import pmpt_dataset_detect, pmpt_dataset_select
        self.plan.data_kind = req_based_generator(self.requirement, pmpt_dataset_detect(), self.agent)
        if self.plan.data_kind == 'no_data_information_provided':
            self.plan.dataset = req_based_generator(self.requirement, pmpt_dataset_select(), self.agent)
        elif self.plan.data_kind == 'csv_data':
            # Mock questionary would handle this
            pass

    self.console.log(f"[cyan]Data source:[/cyan] {self.plan.dataset}")
    if self.plan.dataset is None or not os.path.exists(self.plan.dataset):
        raise SystemExit("Wrong dataset information. Aborted.")
    else:
        csv_data_sample = read_csv_file(self.plan.dataset)
        self.console.log(f"[cyan]Dataset examples:[/cyan] {csv_data_sample}")
        self.requirement += f"\n\nDataset Sample: {csv_data_sample}"

    # Step 3: Task & Model selection
    self.console.log("[bold red]Step 3: Task & Model selection[bold red]")
    if self.plan.tasks is None:
        self.console.log(
            f"The project [cyan]{self.project_name}[/cyan] has no existing plans. Start planning...")

        from agent.function.chain import req_based_generator
        from agent.utils.prompt import pmpt_task_select, pmpt_model_select
        ml_task_name = req_based_generator(self.requirement, pmpt_task_select(), self.agent)
        self.console.log(f"[cyan]Task detected:[/cyan] {ml_task_name}")
        self.requirement += f"\n\nML Task: {ml_task_name}"

        ml_model_arch = req_based_generator(self.requirement, pmpt_model_select(), self.agent)
        self.console.log(f"[cyan]Model architecture selected:[/cyan] {ml_model_arch}")

        # Step 4 would continue with plan generation...
        # But we stop here for the test


# Monkey-patch for testing
Chain._run_planning = Chain__run_planning


if __name__ == "__main__":
    pytest.main([__file__, "-v"])[0m
