             patch('agent.function.chain.questionary') as mock_questionary, \
             patch('agent.function.chain.run_command'), \
             patch('agent.function.chain.load_plan') as mock_load_plan, \
             patch('agent.function.chain.load_model') as mock_load_model:
            
            # Setup mocks
