            "tasks": None,
            "data_kind": None,
            "dataset": None,
            "debug_env": "local",
            "debug": 3,
        }
        import yaml
        with open(self.project_plan_file, "w") as f:
            yaml.dump(plan_data, f)

    def teardown_method(self):
        shutil.rmtree(self.temp_dir)
        if "MLE_CONFIG" in os.environ:
            del os.environ["MLE_CONFIG"]

    @patch("agent.function.chain.Console")
