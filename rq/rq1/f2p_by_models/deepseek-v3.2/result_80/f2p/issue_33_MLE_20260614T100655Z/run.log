    def test_task_model_selection_after_data_provided(self):
        """Test that task and model selection happen after data is provided."""
        # Simulate the buggy behavior: task and model selected BEFORE data review
        # In buggy code, req_based_generator is called for task and model before data_kind/dataset handling
        # We'll track the order of calls to req_based_generator
        
        call_order = []
        def track_calls(*args, **kwargs):
            call_order.append(args[1])  # prompt template
            # Return different values based on prompt
            prompt = args[1]
            if "Task" in prompt:
                return "Tabular Classification"  # Wrong task without data
            elif "Model" in prompt:
                return "Linear Regression"
            elif "dataset_detect" in prompt:
                return "csv_data"
            elif "dataset_select" in prompt:
                return "dummy.csv"
            else:
                return "dummy"
        
        self.mock_req_gen.side_effect = track_calls
        
        # Create chain with our plan
        plan = Plan.load(self.plan_file)
        chain = Chain(plan, self.mock_agent)
        chain.entry_file = self.entry_file
        
        # Run the chain's start method (which contains the main logic)
        # We'll call the internal method that runs the planning steps
        # Since the bug is in the order of operations, we need to simulate the flow
        # by calling the relevant parts of the run method.
        
        # First, let's directly test the order in the fixed code path.
        # We'll patch the run method to capture the order of operations.
        original_run = chain.run
        order_events = []
        
        def tracked_run():
            # Track when data review happens vs task/model selection
            # In buggy code: task/model come before data review
            # In fixed code: data review (Step 2) comes before task/model (Step 3)
            
            # Simulate the fixed flow by checking the call order of req_based_generator
            # We'll let the mock track calls as above
            try:
                result = original_run()
                return result
            except SystemExit:
                return None
        
        chain.run = tracked_run
        
        # Run the chain (will exit early due to mocked inputs)
        try:
            chain.run()
        except (SystemExit, KeyboardInterrupt):
            pass
        
        # Analyze call order: In buggy code, task and model prompts come before dataset_detect
        # In fixed code, dataset_detect comes before task and model prompts
        task_prompt_calls = [i for i, call in enumerate(call_order) if "Task" in call]
        model_prompt_calls = [i for i, call in enumerate(call_order) if "Model" in call]
        dataset_detect_calls = [i for i, call in enumerate(call_order) if "dataset_detect" in call]
        
        # In buggy code: task and model calls happen BEFORE dataset_detect
        # In fixed code: dataset_detect happens BEFORE task and model
        # Assert that dataset_detect comes before task and model (fixed behavior)
        if dataset_detect_calls and task_prompt_calls:
            # This assertion will fail in buggy code, pass in fixed code
            assert dataset_detect_calls[0] < task_prompt_calls[0], \
                "Task selection should happen AFTER data detection"
        
        if dataset_detect_calls and model_prompt_calls:
            assert dataset_detect_calls[0] < model_prompt_calls[0], \
                "Model selection should happen AFTER data detection"

    def test_data_sample_included_in_requirement_for_task_selection(self):
