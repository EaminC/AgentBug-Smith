from agent.integration.files import read_csv_file

def test_chain_task_model_selection_after_data_review():
    """
    Test that task and model selection happens after data review,
    ensuring the model architecture is chosen based on data samples.
    """
    # Create a temporary project directory
    tmpdir = tempfile.mkdtemp()
    project_path = os.path.join(tmpdir, "test_project")
    os.makedirs(project_path)
    project_plan_file = os.path.join(project_path, "project.yml")
    
    # Mock configuration to return a project
    with patch.object(Config, 'read', return_value={'project': {'path': project_path}}):
        # Create a minimal project plan
        plan = ProjectPlan(
            project=project_path,
            requirement="",
            tasks=None,
            current_task=0,
            dataset=None,
            data_kind=None,
            debug_env="local",
            debug=3
        )
        plan.save(project_plan_file)
        
        # Mock the agent to control LLM responses
        mock_agent = MagicMock(spec=OpenAIAgent)
        # Simulate the responses for data kind detection, dataset selection, task selection, model selection
        # In the buggy version, data_kind detection and dataset selection happen AFTER task/model selection.
        # In the fixed version, data review (including data_kind detection and dataset selection) happens BEFORE task/model selection.
        # We'll mock the calls to reflect the fixed order.
        
        # First, mock the data kind detection: assume csv_data
        mock_agent.generate.return_value = "csv_data"
        # Then mock the dataset selection: user provides a path
        # We'll create a dummy CSV file
        csv_path = os.path.join(project_path, "data.csv")
        with open(csv_path, "w") as f:
            f.write("text,label\n")
            f.write("I love this movie,positive\n")
            f.write("I hate this movie,negative\n")
            f.write("It was okay,neutral\n")
        
        # Mock the task selection: should be "Sentiment Analysis" (since data is text with sentiment labels)
        # In the buggy version, task selection happens before data review, so it might pick a generic task.
        # In the fixed version, task selection happens after data review, so it should pick "Sentiment Analysis".
        # We'll set the mock to return "Sentiment Analysis" for task selection.
        mock_agent.generate.side_effect = [
            "csv_data",  # data_kind detection
            "Sentiment Analysis",  # task selection (after data review in fixed version)
            "LSTM",  # model architecture selection (after data review in fixed version)
        ]
        
        # Create a Chain instance
        chain = Chain(plan, mock_agent)
        chain.requirement = "I want to analyze sentiment in movie reviews."
        chain.plan.requirement = chain.requirement
        
        # Manually set the data_kind and dataset as the fixed code would do
        chain.plan.data_kind = "csv_data"
        chain.plan.dataset = csv_path
        
        # Now simulate the step where task and model are selected (after data review)
        # In the buggy version, task and model are selected before data review.
        # In the fixed version, they are selected after.
        # We'll call the internal method that does the selection, but we need to mock the prompts.
        # Instead, we'll directly test the behavior by checking the order of calls.
        
        # We'll patch the req_based_generator function to capture call order
        from agent.function.generator import req_based_generator
        call_order = []
        def tracked_req_based_generator(req, prompt, agent):
            call_order.append(prompt)
            # Return based on which prompt is being called
            if prompt == pmpt_dataset_detect():
                return "csv_data"
            elif prompt == pmpt_dataset_select():
                return csv_path
            elif prompt == pmpt_task_select():
                return "Sentiment Analysis"
            elif prompt == pmpt_model_select():
                return "LSTM"
            else:
                return "unknown"
        
        with patch('agent.function.generator.req_based_generator', side_effect=tracked_req_based_generator):
            # Run the chain's start method up to the point where tasks are generated
            # We'll patch the plan_generator to avoid actual LLM calls
            mock_task_dicts = {
                'tasks': [
                    {'name': 'Data Collection', 'resources': []},
                    {'name': 'Model Training', 'resources': []},
                ]
            }
            with patch('agent.function.generator.plan_generator', return_value=mock_task_dicts):
                with patch('agent.function.chain.questionary') as mock_q:
                    mock_q.confirm.return_value.ask.return_value = True
                    mock_q.text.return_value.ask.return_value = csv_path
                    # Run the chain's run method partially
                    # We'll just run the steps up to task generation
                    chain.plan.tasks = None
                    chain.plan.current_task = 0
                    chain.entry_file = os.path.join(project_path, "main.py")
                    
                    # In the buggy version, the order of calls is:
                    # 1. pmpt_task_select (before data review)
                    # 2. pmpt_model_select (before data review)
                    # 3. pmpt_dataset_detect (after task/model selection)
                    # In the fixed version, the order is:
                    # 1. pmpt_dataset_detect (data review step)
                    # 2. pmpt_task_select (after data review)
                    # 3. pmpt_model_select (after data review)
                    
                    # We'll simulate the fixed version by calling the internal steps in order
                    # But first, let's check the buggy behavior by patching the run method.
                    # Instead, we'll directly test the condition from the issue:
                    # The issue says: if we generate a task/model arch just with blur requirement and without data,
                    # the generated tasks will be very general. In the above case, I want sentiment analysis.
                    # So the bug is that task/model selection happens before data review.
                    # The fix is that task/model selection happens after data review.
                    
                    # We'll write a test that asserts that task selection is called after dataset detection.
                    # We'll mock the chain's run method to capture the order.
                    original_run = chain.run
                    captured_order = []
                    def mocked_run():
                        # Simulate the fixed code flow
                        # Step 1: User requirements understanding (already done)
                        # Step 2: Data quick review
                        if chain.plan.data_kind is None:
                            data_kind = req_based_generator(chain.requirement, pmpt_dataset_detect(), chain.agent)
                            captured_order.append(('data_kind', data_kind))
                            chain.plan.data_kind = data_kind
                            if chain.plan.data_kind == 'no_data_information_provided':
                                dataset = req_based_generator(chain.requirement, pmpt_dataset_select(), chain.agent)
                                captured_order.append(('dataset_select', dataset))
                                chain.plan.dataset = dataset
                            elif chain.plan.data_kind == 'csv_data':
                                # In the fixed code, this is done via questionary, but we mock it
                                chain.plan.dataset = csv_path
                                captured_order.append(('dataset_path', csv_path))
                        
                        # Step 3: Task & Model selection
                        if chain.plan.tasks is None:
                            ml_task_name = req_based_generator(chain.requirement, pmpt_task_select(), chain.agent)
                            captured_order.append(('task', ml_task_name))
                            ml_model_arch = req_based_generator(chain.requirement, pmpt_model_select(), chain.agent)
                            captured_order.append(('model', ml_model_arch))
                        # Stop here for the test
                        return captured_order
                    
                    with patch.object(chain, 'run', side_effect=mocked_run):
                        order = chain.run()
                        # In the fixed version, data_kind detection should come before task selection
                        # Find indices
                        data_kind_index = next((i for i, (key, _) in enumerate(order) if key == 'data_kind'), -1)
                        task_index = next((i for i, (key, _) in enumerate(order) if key == 'task'), -1)
                        model_index = next((i for i, (key, _) in enumerate(order) if key == 'model'), -1)
                        
                        # Assert that data_kind detection happens before task selection
                        assert data_kind_index != -1, "Data kind detection should happen"
                        assert task_index != -1, "Task selection should happen"
                        assert model_index != -1, "Model selection should happen"
                        assert data_kind_index < task_index, "Data review should happen before task selection (fixed)"
                        assert data_kind_index < model_index, "Data review should happen before model selection (fixed)"
                        
                        # Additionally, assert that the task is "Sentiment Analysis" (not a generic task)
                        task_name = next((val for key, val in order if key == 'task'), None)
                        assert task_name == "Sentiment Analysis", f"Task should be 'Sentiment Analysis', got {task_name}"
        
        # Clean up
        shutil.rmtree(tmpdir)

