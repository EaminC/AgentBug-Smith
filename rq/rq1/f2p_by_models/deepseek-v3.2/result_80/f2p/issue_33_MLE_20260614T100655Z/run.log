                    {'name': 'Model Training', 'resources': []}
                ]
            }
        
        # Mock the req_based_generator for task selection
        def mock_req_based_generator(requirement, prompt, agent):
            # In the buggy version, requirement won't have data samples
            # In the fixed version, requirement will include dataset samples
            if "Dataset Sample:" in requirement:
                # With data samples, we should get a specific task
                return "sentiment_analysis"
            else:
                # Without data samples, we get a generic task
                return "tabular_task"
        
        with patch('agent.function.chain.plan_generator', side_effect=mock_plan_generator), \
