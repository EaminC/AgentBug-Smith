    def test_task_selection_without_data_should_be_general_in_buggy(self):
        """In buggy version, task selection without data leads to generic tabular task."""
        # Simulate the bug: requirement without data leads to generic task
        requirement = "I want to analyze sentiment in text reviews"
        
        # Mock the req_based_generator to return a generic task in buggy version
        # In buggy version, without data sample, it might return "Tabular Classification"
        self.mock_req_based.side_effect = lambda req, prompt, agent: (
            "Tabular Classification" if "pmpt_task_select" in prompt else 
            "LSTM" if "pmpt_model_select" in prompt else
            "no_data_information_provided" if "pmpt_dataset_detect" in prompt else
            "/fake/path/data.csv"
        )
        
        # Mock read_csv_file to return sample data (but in buggy version, this happens AFTER task selection)
        self.mock_read_csv.return_value = "text,label\n'great movie',positive\n'bad acting',negative"
        
        # Mock plan_generator to return dummy tasks
        self.mock_plan_generator.return_value = {
            'tasks': [
                {'name': 'Data Collection', 'resources': []},
                {'name': 'Model Training', 'resources': ['PyTorch']}
            ]
        }
        
        # Mock match_plan to return task objects
        mock_task = MagicMock()
        mock_task.name = "Data Collection"
        self.mock_match_plan.return_value = mock_task
        
        # Set up chain state
        self.chain.requirement = requirement
        self.chain.plan.requirement = requirement
        
        # In buggy version, task selection happens BEFORE data review
        # So we need to simulate the buggy flow
        with patch.object(self.chain, 'gen_file_name', return_value="/fake/entry.py"):
            with patch.object(self.chain, 'update_project_state'):
                # Run the planning phase
                self.chain.plan.tasks = None
                self.chain.plan.data_kind = None
                self.chain.plan.dataset = None
                
                # This should trigger task selection without data
                # In buggy version, this leads to generic task
                self.chain.run()
                
                # Verify that req_based_generator was called for task selection
                # In buggy version, it's called without data sample
                task_calls = [call for call in self.mock_req_based.call_args_list 
                            if call[0][1] and 'pmpt_task_select' in call[0][1]]
                
                # In buggy version, the prompt for task selection doesn't include data samples
                # So the task detected should be generic
                if task_calls:
                    # Check that the requirement passed doesn't include dataset sample
                    req_passed = task_calls[0][0][0]
                    assert "Dataset Sample:" not in req_passed, \
                        "Buggy version should NOT include dataset sample in task selection prompt"
                    
                    # The bug is that task is selected without data, leading to generic task
                    # We expect the mock to return "Tabular Classification" (generic)
                    # This is the bug - should be "Sentiment Analysis" for sentiment requirement
                    # But in buggy version, it's generic
                    pass  # Test will pass in buggy version
    
    def test_task_selection_with_data_should_be_specific_in_fixed(self):
        """In fixed version, task selection happens AFTER data review with samples."""
        # Simulate the fix: requirement with data leads to specific task
        requirement = "I want to analyze sentiment in text reviews"
        
        # Mock the req_based_generator to return specific task in fixed version
        # In fixed version, with data sample, it should return "Sentiment Analysis"
        call_count = 0
        def side_effect(req, prompt, agent):
            nonlocal call_count
            call_count += 1
            if "pmpt_task_select" in prompt:
                # In fixed version, requirement includes dataset sample
                assert "Dataset Sample:" in req, \
                    "Fixed version SHOULD include dataset sample in task selection prompt"
                return "Sentiment Analysis"
            elif "pmpt_model_select" in prompt:
                return "LSTM"
            elif "pmpt_dataset_detect" in prompt:
                return "csv_data"
            else:
                return "/fake/path/data.csv"
        
        self.mock_req_based.side_effect = side_effect
        
        # Mock read_csv_file to return sample data
        self.mock_read_csv.return_value = "text,label\n'great movie',positive\n'bad acting',negative"
        
        # Mock plan_generator
        self.mock_plan_generator.return_value = {
            'tasks': [
                {'name': 'Data Collection', 'resources': []},
                {'name': 'Model Training', 'resources': ['PyTorch']}
            ]
        }
        
        # Mock match_plan
        mock_task = MagicMock()
        mock_task.name = "Data Collection"
        self.mock_match_plan.return_value = mock_task
        
        # Set up chain state
        self.chain.requirement = requirement
        self.chain.plan.requirement = requirement
        
        # In fixed version, we need to simulate the fixed flow
        # The key difference: data review happens BEFORE task selection
        with patch.object(self.chain, 'gen_file_name', return_value="/fake/entry.py"):
            with patch.object(self.chain, 'update_project_state'):
                # Run the planning phase
                self.chain.plan.tasks = None
                self.chain.plan.data_kind = None
                self.chain.plan.dataset = None
                
                # This should trigger data review first, then task selection
                self.chain.run()
                
                # Verify the order of calls
                # In fixed version: dataset_detect -> dataset path -> task_select -> model_select
                calls = self.mock_req_based.call_args_list
                
                # Find task selection call
                task_calls = [call for call in calls 
                            if call[0][1] and 'pmpt_task_select' in call[0][1]]
                
                # Find dataset detection call  
                dataset_calls = [call for call in calls 
                               if call[0][1] and 'pmpt_dataset_detect' in call[0][1]]
                
                # In fixed version, dataset detection should happen BEFORE task selection
                if dataset_calls and task_calls:
                    dataset_index = calls.index(dataset_calls[0])
                    task_index = calls.index(task_calls[0])
                    assert dataset_index < task_index, \
                        "Fixed version: dataset detection should happen BEFORE task selection"
                    
                    # The requirement for task selection should include dataset sample
                    req_for_task = task_calls[0][0][0]
                    assert "Dataset Sample:" in req_for_task, \
                        "Fixed version: task selection prompt should include dataset sample"
                    
                    # Task should be specific to the data
                    # Our mock returns "Sentiment Analysis" for sentiment requirement with text data
                    pass  # Test will pass in fixed version

