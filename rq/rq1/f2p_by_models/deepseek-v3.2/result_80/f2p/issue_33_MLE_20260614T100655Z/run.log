        assert "Dataset Sample:" in requirement
        assert "text,label" in requirement
        return {
            'tasks': [
                {'name': 'Data Collection', 'resources': []},
                {'name': 'Model Training', 'resources': []}
            ]
        }
    
    # Mock req_based_generator to use our mock_agent
    def mock_req_based_generator(requirement, prompt, agent):
        # Just call the mock agent's generate
        return agent.generate(prompt, requirement)
    
    # Mock match_plan to return a Step
    def mock_match_plan(task_dict):
        return Step(name=task_dict['name'], resources=task_dict['resources'])
    
    # Mock questionary calls
    with patch('agent.function.chain.config', config_mock), \
         patch('agent.function.chain.req_based_generator', side_effect=mock_req_based_generator), \
         patch('agent.function.chain.plan_generator', side_effect=mock_plan_generator), \
         patch('agent.function.chain.match_plan', side_effect=mock_match_plan), \
         patch('agent.function.chain.questionary.text') as mock_text, \
         patch('agent.function.chain.questionary.confirm') as mock_confirm, \
         patch('agent.function.chain.read_csv_file') as mock_read_csv, \
         patch('agent.function.chain.os.path.exists') as mock_exists, \
         patch('agent.function.chain.run_command') as mock_run_command:
        
        # Setup mocks
        mock_text.side_effect = [
            csv_path,  # CSV data path prompt
        ]
        mock_confirm.side_effect = [
            True,      # Confirm file usage
            True,      # Confirm plan
            False,     # Skip dependencies installation
        ]
        mock_read_csv.return_value = "text,label\nI love this product!,positive\nThis is terrible.,negative"
        mock_exists.return_value = True
        mock_run_command.return_value = None
        
        # Create Chain instance
        chain = Chain(plan=None, agent=mock_agent)
        chain.project_name = "test_project"
        chain.project_setting_file = project_yml
        chain.plan = MagicMock()
        chain.plan.project = project_path
        chain.plan.requirement = "I want to analyze sentiment of text data"
        chain.plan.data_kind = None
        chain.plan.dataset = None
        chain.plan.tasks = None
        chain.plan.current_task = 0
        chain.plan.debug_env = "local"
        chain.requirement = "I want to analyze sentiment of text data"
        chain.entry_file = None
        
        # Run the chain's start method (simulate the planning phase)
        # We'll call the internal method that generates tasks
        chain._generate_tasks()
        
        # Verify that data_kind was set before task selection
        # In buggy version: data_kind would still be None during task selection
        # In fixed version: data_kind is set to 'csv_data' before task selection
        assert chain.plan.data_kind == "csv_data"
        
        # Verify that dataset path was collected
        assert chain.plan.dataset == csv_path
        
        # Verify that requirement was updated with data sample before task/model selection
        # In buggy version: requirement doesn't contain data sample
        # In fixed version: requirement contains "Dataset Sample:"
        assert "Dataset Sample:" in chain.requirement
        
        # Verify that task selected is sentiment_analysis (not generic tabular task)
        # The mock agent should have been called with prompt containing data sample
        # We check via the side effect that third call (task selection) happened after data sample
        calls = mock_agent.generate.call_args_list
        # First call: data_kind detection
        assert calls[0][0][1] == "I want to analyze sentiment of text data"
        # Second call: task selection (should have data sample in requirement)
        assert "Dataset Sample:" in calls[1][0][1]
        # Third call: model selection (should have data sample in requirement)
        assert "Dataset Sample:" in calls[2][0][1]
        
        # Verify task name is sentiment_analysis
        assert "sentiment_analysis" in chain.requirement
        
    # Cleanup
    shutil.rmtree(tmpdir)

