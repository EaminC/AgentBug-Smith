    def test_task_selection_happens_after_data_review_buggy(self):
        """
        In the buggy version, task selection happens before data review.
        This test verifies that the bug exists: the task selection prompt
        does NOT include data samples.
        """
        # Simulate a requirement that is ambiguous without data
        requirement = "Classify text into positive or negative sentiment"
        self.plan.requirement = requirement
        self.plan.save(self.plan_file)

        # Mock the req_based_generator calls to capture the arguments
        captured_calls = []
        original_req_based = sys.modules['agent.function.chain'].req_based_generator
        def capturing_req_based(req, prompt, agent):
            captured_calls.append((req, prompt))
            # Return dummy values
            if prompt == pmpt_dataset_detect():
                return "csv_data"
            elif prompt == pmpt_task_select():
                return "Text Classification"
            elif prompt == pmpt_model_select():
                return "BERT"
            elif prompt == pmpt_dataset_select():
                return "dummy.csv"
            else:
                return "dummy"
        with patch('agent.function.chain.req_based_generator', side_effect=capturing_req_based):
            # Create chain instance
            chain = Chain(self.plan_file, self.mock_agent)
            # Override the plan with our test plan
            chain.plan = self.plan
            chain.project_home = self.project_path
            chain.project_setting_file = self.plan_file
            chain.project_name = "test_project"
            chain.requirement = requirement

            # Mock the entry file generation
            chain.entry_file = os.path.join(self.project_path, "entry.py")

            # Mock the plan_generator to return a simple task list
            self.mock_plan_generator.return_value = {
                'tasks': [{'name': 'Data Collection', 'resources': []}]
            }
            self.mock_match_plan.return_value = MagicMock(name='Data Collection')

            # Run the chain's start method (which contains the buggy logic)
            # We'll call the internal method that runs the planning loop
            with pytest.raises(SystemExit):
                chain.start()

        # Extract the calls to req_based_generator for task selection
        task_select_calls = [call for call in captured_calls if call[1] == pmpt_task_select()]
        model_select_calls = [call for call in captured_calls if call[1] == pmpt_model_select()]

        # In the buggy version, task selection happens BEFORE data review.
        # Therefore, the requirement passed to task selection should NOT contain dataset samples.
        # We check that the requirement string does NOT contain "Dataset Sample:".
        for req, _ in task_select_calls:
            if "Dataset Sample:" in req:
                # If dataset samples are present, the bug is fixed (or partially fixed).
                # In the buggy version, this should NOT happen.
                # We'll assert False to make the test fail when the bug is fixed.
                # But we need the test to pass when the bug is fixed, so we invert the logic.
                # Actually, we want the test to FAIL on buggy code, PASS on fixed code.
                # So we assert that dataset samples are NOT present (buggy).
                # If they are present, the test passes (fixed).
                # However, the test runner expects an assertion failure for buggy.
                # Let's do: assert "Dataset Sample:" not in req
                # On buggy: condition holds, assertion passes -> test passes (but we want failure).
                # Wait, we need the test to fail on buggy, pass on fixed.
                # So we assert that dataset samples ARE present.
                # On buggy: assertion fails -> test fails (good).
                # On fixed: assertion passes -> test passes (good).
                pass
            else:
                # Dataset samples not present -> buggy behavior.
                # We'll raise an assertion error to fail the test.
                raise AssertionError(
                    "Task selection was called without dataset samples in the requirement. "
                    "This indicates the bug: task selection happens before data review."
                )

        # Similarly for model selection
        for req, _ in model_select_calls:
            if "Dataset Sample:" not in req:
                raise AssertionError(
                    "Model selection was called without dataset samples in the requirement. "
                    "This indicates the bug: model selection happens before data review."
                )

