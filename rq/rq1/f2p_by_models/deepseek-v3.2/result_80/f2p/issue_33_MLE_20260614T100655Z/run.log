            mock_questionary.confirm.return_value.ask.return_value = True
            mock_questionary.text.return_value.ask.return_value = csv_path
            
            mock_plan = MagicMock()
            mock_plan.project = "test_project"
            mock_plan.requirement = None
            mock_plan.tasks = None
            mock_plan.data_kind = None
            mock_plan.dataset = None
