        # Check that task selection prompt is used before dataset detection prompt
        task_prompt = pmpt_task_select()
        dataset_detect_prompt = pmpt_dataset_detect()

        task_index = None
        dataset_detect_index = None
        for i, call in enumerate(calls):
            if len(call[0]) > 1 and call[0][1] == task_prompt:
