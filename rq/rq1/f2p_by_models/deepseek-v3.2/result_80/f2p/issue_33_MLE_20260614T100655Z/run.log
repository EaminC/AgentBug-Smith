        if "plan" in prompt.lower():
            return '{"tasks": [{"name": "Data Collection", "resources": ["pandas"]}, {"name": "Model Training", "resources": ["transformers"]}]}'
        return "mock_response"

    def stream_generate(self, prompt, **kwargs):
        yield "streaming"

def test_chain_task_selection_after_data_provided():
    """
    Test that task and model architecture are selected after data is provided,
    not just based on a blur requirement without data.
    This addresses issue #33 where sentiment analysis task was not correctly identified.
    """
    # Create a temporary directory for the project
    tmpdir = tempfile.mkdtemp()
    project_dir = os.path.join(tmpdir, "test_project")
    os.makedirs(project_dir)
    
    # Create a dummy CSV file for testing
    csv_path = os.path.join(project_dir, "sentiment.csv")
    with open(csv_path, "w") as f:
        f.write("text,label\n")
        f.write("I love this product,positive\n")
        f.write("This is terrible,negative\n")
        f.write("It's okay,neutral\n")
    
    try:
        # Mock the configuration
        with patch.object(Config, 'read') as mock_config_read:
            mock_config_read.return_value = {
                'project': {
                    'path': project_dir,
                    'name': 'test_project'
                }
            }
            
            # Create a minimal plan
            plan = Plan(
                project=project_dir,
                requirement="I want to analyze sentiment of product reviews",
                data_kind=None,
                dataset=None,
                tasks=None,
                current_task=0,
                debug=3,
                debug_env="local"
            )
            
            # Save the plan to a file
            plan_file = os.path.join(project_dir, "project.yml")
            plan.save(plan_file)
            
            # Mock the model
            mock_model = MockModel()
            
            # Create chain with mocked dependencies
            with patch('agent.function.chain.load_model', return_value=mock_model):
                with patch('agent.function.chain.load_plan', return_value=plan):
                    with patch('agent.function.chain.questionary') as mock_questionary:
                        # Mock user interactions
                        mock_questionary.confirm.return_value.ask.return_value = True
                        mock_questionary.text.return_value.ask.side_effect = [
                            "I want to analyze sentiment of product reviews",  # requirement
                            csv_path  # CSV data path
                        ]
                        
                        # Mock file operations
                        with patch('builtins.open', MagicMock()) as mock_open:
                            mock_file = MagicMock()
                            mock_file.__enter__.return_value = mock_file
                            mock_open.return_value = mock_file
                            
                            # Create chain instance
                            chain = Chain(plan, mock_model)
                            
                            # Mock the update_project_state method
                            chain.update_project_state = MagicMock()
                            
                            # Mock the run_command to avoid actual installation
                            with patch('agent.function.chain.run_command'):
                                # Run the chain
                                chain.run()
                                
                                # Verify that data_kind was set to csv_data
                                assert plan.data_kind == "csv_data"
                                
                                # Verify that dataset path was set
                                assert plan.dataset == csv_path
                                
                                # Verify that tasks were generated after data was provided
                                assert plan.tasks is not None
                                assert len(plan.tasks) > 0
                                
                                # Verify that the requirement includes dataset sample
                                assert "Dataset Sample" in chain.requirement
                                
                                # Verify that ML task name includes sentiment analysis
                                # The mock returns "Sentiment Analysis" for task selection
                                # This ensures task is selected after data is provided
                                assert "sentiment" in chain.requirement.lower() or any(
                                    "sentiment" in str(task).lower() for task in plan.tasks
                                )
                                
    finally:
        # Clean up
        shutil.rmtree(tmpdir)

def test_chain_without_data_fails_early():
    """
    Test that chain fails early when no data is provided,
    preventing generic task selection.
    """
    tmpdir = tempfile.mkdtemp()
    project_dir = os.path.join(tmpdir, "test_project2")
    os.makedirs(project_dir)
    
    try:
        with patch.object(Config, 'read') as mock_config_read:
            mock_config_read.return_value = {
                'project': {
                    'path': project_dir,
                    'name': 'test_project2'
                }
            }
            
            plan = Plan(
                project=project_dir,
                requirement="I want to analyze something",
                data_kind=None,
                dataset=None,
                tasks=None,
                current_task=0,
                debug=3,
                debug_env="local"
            )
            
            plan_file = os.path.join(project_dir, "project.yml")
            plan.save(plan_file)
            
            mock_model = MockModel()
            
            with patch('agent.function.chain.load_model', return_value=mock_model):
                with patch('agent.function.chain.load_plan', return_value=plan):
                    with patch('agent.function.chain.questionary') as mock_questionary:
                        # Mock to simulate no data provided
                        mock_questionary.confirm.return_value.ask.return_value = True
                        mock_questionary.text.return_value.ask.side_effect = [
                            "I want to analyze something",
                            ""  # Empty CSV path
                        ]
                        
                        with patch('builtins.open', MagicMock()):
                            chain = Chain(plan, mock_model)
                            chain.update_project_state = MagicMock()
                            
                            # Should raise SystemExit when dataset is invalid
                            with pytest.raises(SystemExit) as exc_info:
                                with patch('agent.function.chain.run_command'):
                                    chain.run()
                            
                            # Verify exit was due to wrong dataset information
                            assert exc_info.type == SystemExit
                            
    finally:
        shutil.rmtree(tmpdir)

