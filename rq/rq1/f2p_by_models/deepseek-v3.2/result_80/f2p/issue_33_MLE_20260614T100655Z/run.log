    def test_task_selection_after_data_provided_buggy(self, mock_run, mock_match, mock_plan_gen, mock_read_csv, mock_req_gen, mock_q, mock_console):
        """In buggy version, task selection happens before data is reviewed, leading to generic task."""
        from agent.function.chain import Chain

        # Mock console
        mock_console_instance = MagicMock()
        mock_console.return_value = mock_console_instance

        # Mock questionary responses
        mock_q.text.side_effect = [
            "sentiment analysis of movie reviews",  # requirement
            self.csv_path,  # CSV path
        ]
        mock_q.confirm.return_value.ask.return_value = True

        # Mock req_based_generator calls
        # In buggy version, order is:
        # 1. ml_task_name (before data review)
        # 2. ml_model_arch (before data review)
        # 3. data_kind detection
        # Let's simulate buggy behavior: task selected as "Tabular Classification" (generic) because no data yet.
        mock_req_gen.side_effect = [
            "Tabular Classification",  # ml_task_name (wrong because no data context)
            "RandomForest",  # ml_model_arch
            "csv_table_data",  # data_kind
        ]

        # Mock read_csv_file to return sample data
        mock_read_csv.return_value = "text,label\nI love this movie,positive"

        # Mock plan_generator
        mock_plan_gen.return_value = {
            "tasks": [
                {"name": "Data Collection", "resources": []},
                {"name": "Model Training", "resources": []},
            ]
        }
        mock_match.side_effect = lambda d: MagicMock(name=d["name"])

        # Create chain instance
        chain = Chain(load_plan=self._mock_load_plan)

        # Run the chain's start method (which internally calls _run)
        # We'll directly test the logic that changed: in buggy code, task selection is before data review.
        # We can inspect the order of calls to req_based_generator.
        try:
            chain._run()
        except SystemExit:
