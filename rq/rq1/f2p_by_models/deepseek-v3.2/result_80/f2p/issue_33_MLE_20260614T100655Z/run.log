    def test_task_selection_without_data_should_fail_on_buggy(self):
        """Test that task/model selection fails without data in buggy version."""
        # In buggy version, req_based_generator is called with only requirement
        # This leads to generic task selection without data context
        
        # Set up mocks for buggy behavior
        self.mock_req_gen.side_effect = self._mock_req_gen_buggy
        
        # Create chain instance
        chain = Chain(self.project_yml, self.mock_agent)
        chain.plan.requirement = "I want to analyze sentiment in text data"
        
        # Try to run the chain - this should fail in buggy version
        # because task is selected without data context
        with pytest.raises(SystemExit):
            chain.run()
        
        # Verify that req_based_generator was called without data context
        # In buggy version, the first call to req_based_generator for task selection
        # should NOT include data samples
        calls = self.mock_req_gen.call_args_list
        task_select_call = None
        for call in calls:
            args, kwargs = call
            if len(args) >= 2 and isinstance(args[1], str) and 'task' in args[1].lower():
                task_select_call = call
                break
        
        if task_select_call:
            args, kwargs = task_select_call
            # In buggy version, the requirement passed should NOT contain data samples
            requirement_arg = args[0]
            assert "Dataset Sample:" not in requirement_arg, \
                "Buggy version should not include data samples in task selection"
    
    def test_task_selection_with_data_should_pass_on_fixed(self):
        """Test that task/model selection works with data in fixed version."""
        # In fixed version, req_based_generator is called with requirement that includes data
        
        # Set up mocks for fixed behavior
        self.mock_req_gen.side_effect = self._mock_req_gen_fixed
        
        # Mock plan_generator to return a valid plan
        self.mock_plan_gen.return_value = {
            'tasks': [
                {'name': 'Data Collection', 'resources': []},
                {'name': 'Model Training', 'resources': []}
            ]
        }
        
        # Mock match_plan to return a Step
        self.mock_match_plan.return_value = Step(name="Test", resources=[])
        
        # Create chain instance
        chain = Chain(self.project_yml, self.mock_agent)
        chain.plan.requirement = "I want to analyze sentiment in text data"
        
        # Run the chain - this should work in fixed version
        try:
            chain.run()
            # If we get here without SystemExit, the test passes for fixed version
            pass
        except SystemExit:
            # This would happen in buggy version, but fixed version should continue
            pytest.fail("Fixed version should not raise SystemExit when data is provided")
        
        # Verify that req_based_generator was called with data context
        # In fixed version, the call to req_based_generator for task selection
        # SHOULD include data samples
        calls = self.mock_req_gen.call_args_list
        task_select_call = None
        for call in calls:
            args, kwargs = call
            if len(args) >= 2 and isinstance(args[1], str) and 'task' in args[1].lower():
                task_select_call = call
                break
        
        if task_select_call:
            args, kwargs = task_select_call
            # In fixed version, the requirement passed SHOULD contain data samples
            requirement_arg = args[0]
            assert "Dataset Sample:" in requirement_arg, \
                "Fixed version should include data samples in task selection"
    
    def _mock_req_gen_buggy(self, requirement, prompt, agent):
        """Mock for buggy version where data is not included in task selection."""
        if 'task' in prompt.lower():
            # In buggy version, return generic task without considering data
            return "tabular_classification"
        elif 'model' in prompt.lower():
            return "RandomForest"
        elif 'dataset' in prompt.lower() and 'detect' in prompt.lower():
            return "csv_data"
        elif 'dataset' in prompt.lower() and 'select' in prompt.lower():
            return "/tmp/test.csv"
        return "mock_result"
    
    def _mock_req_gen_fixed(self, requirement, prompt, agent):
        """Mock for fixed version where data is included in task selection."""
        if 'task' in prompt.lower():
            # In fixed version, check if requirement contains data
            if "Dataset Sample:" in requirement:
                # With data context, return appropriate task
                return "sentiment_analysis"
            else:
                # Without data context, return generic task
                return "tabular_classification"
        elif 'model' in prompt.lower():
            if "sentiment_analysis" in requirement:
                return "BERT"
            else:
                return "RandomForest"
        elif 'dataset' in prompt.lower() and 'detect' in prompt.lower():
            return "csv_data"
        elif 'dataset' in prompt.lower() and 'select' in prompt.lower():
            return "/tmp/test.csv"
        return "mock_result"

