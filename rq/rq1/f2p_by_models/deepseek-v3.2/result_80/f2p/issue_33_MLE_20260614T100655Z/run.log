def test_chain_task_model_selection_with_data(
    mock_config,
    mock_agent,
    mock_plan,
    mock_questionary,
    mock_read_csv,
    mock_req_based_generator,
    mock_plan_generator,
    mock_match_plan,
    mock_run_command,
    mock_os_path_exists,
    mock_open_file
):
    """
    Test that task and model selection uses data samples when provided.
    
    In the buggy version, task and model are selected before data is reviewed,
    leading to generic choices (e.g., 'Tabular Task' instead of 'Sentiment Analysis').
    
    In the fixed version, data review occurs before task/model selection,
    so the task should be 'Sentiment Analysis' and model 'BERT'.
    """
    # Create a temporary project directory
    project_dir = '/tmp/test_project'
    os.makedirs(project_dir, exist_ok=True)
    
    # Create a dummy CSV file
    csv_path = '/tmp/data.csv'
    with open(csv_path, 'w') as f:
        f.write("review,label\n\"great movie\",positive\n\"terrible\",negative")
    
    # Load the plan (mocked)
    with patch('agent.function.chain.load_plan') as mock_load_plan:
        mock_load_plan.return_value = mock_plan
        # Create chain instance
        chain = Chain(mock_plan, mock_agent)
        
        # Override entry file generation to avoid interactive prompt
        chain.entry_file = os.path.join(project_dir, 'generated.py')
        
        # Mock the update_project_state to avoid file writes
        chain.update_project_state = MagicMock()
        
        # Run the chain's start method (which runs the planning loop)
        # We'll run only the planning part, not the full loop
        with patch.object(chain, 'run_task') as mock_run_task:
            chain.start()
    
    # Verify that data review happened before task selection
    # In the fixed code, data_kind is set and dataset is read before task selection.
    # We check that read_csv_file was called before req_based_generator for task selection.
    call_names = [call[0] for call in mock_req_based_generator.mock_calls]
    
    # In the fixed version, the order should be:
    # 1. data_kind detection (csv_data)
    # 2. task selection (Sentiment Analysis)
    # 3. model selection (BERT)
    # Note: dataset selection is skipped because data_kind is 'csv_data'
    
    # Assert that task selection happened after data_kind detection
    assert call_names[0] == ''  # First call is for data_kind
    assert call_names[1] == ''  # Second call is for task selection
    
    # Verify that read_csv_file was called with the dataset path
    mock_read_csv.assert_called_with('/tmp/data.csv')
    
    # Verify that the task selected is 'Sentiment Analysis' (not a generic tabular task)
    # The mock returns 'Sentiment Analysis' as the third call (index 1)
    # But we need to check the actual value passed to req_based_generator for task selection.
    # Since we mocked req_based_generator to return 'Sentiment Analysis', we assume it's correct.
    
    # However, the bug is that in the buggy version, task selection happens BEFORE data review,
    # so the requirement passed to task selection does NOT include data samples.
    # In the fixed version, the requirement is augmented with data samples before task selection.
    # We need to verify that the requirement passed to task selection includes data samples.
    
    # Get the arguments passed to req_based_generator for task selection (second call)
    task_call_args = mock_req_based_generator.call_args_list[1]
    requirement_passed = task_call_args[0][0]  # First positional argument
    prompt_passed = task_call_args[0][1]       # Second positional argument
    
    # In the fixed version, requirement should contain data samples
    assert "Dataset Sample:" in requirement_passed
    assert "review,label" in requirement_passed
    
    # Additionally, verify that the plan's tasks were set
    assert mock_plan.tasks is not None
    assert len(mock_plan.tasks) == 4
    
    # Clean up
    shutil.rmtree(project_dir, ignore_errors=True)
    os.remove(csv_path)


