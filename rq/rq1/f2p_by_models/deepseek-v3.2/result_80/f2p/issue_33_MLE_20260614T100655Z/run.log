                                        with patch('agent.function.chain.plan_generator'):
                                            chain.run()
                                except (SystemExit, Exception):
                                    pass
                                
                                # Verify data detection happened before task selection
                                data_detection_index = call_order.index("data_detection") if "data_detection" in call_order else -1
                                task_selection_index = call_order.index("task_selection") if "task_selection" in call_order else -1
                                
                                # In the fixed code, data detection should happen before task selection
                                # This is the key fix for issue #33
                                if data_detection_index != -1 and task_selection_index != -1:
                                    assert data_detection_index < task_selection_index, \
                                        "Data detection should happen before task selection"
                                
    finally:
        shutil.rmtree(tmpdir)[0m
