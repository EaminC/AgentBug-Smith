            (thread_id, checkpoint_id, checkpoint, metadata)
            VALUES ($1, $2, $3, $4)
            """,
            thread_id,
            checkpoint_id,
            checkpoint_data,
            {"source": "test", "step": 0},
        )
        
        # Now try to load the checkpoint tuple via the buggy method.
        # This should raise TypeError in buggy code, but after fix should handle None.
        try:
            checkpoint_tuple = await async_checkpointer.aget_tuple(
                thread_id,
                checkpoint_id,
                {"configurable": {"thread_id": thread_id}},
            )
            # If we reach here, the bug is fixed.
            # The checkpoint tuple should have empty dict for channel_values.
            assert checkpoint_tuple is not None
            # In the fixed version, channel_values should be an empty dict, not None.
            # The exact behavior depends on the fix; we assert it's a mapping.
            if checkpoint_tuple.checkpoint.channel_values is not None:
                assert isinstance(checkpoint_tuple.checkpoint.channel_values, dict)
        except TypeError as e:
            if "'NoneType' object is not a mapping" in str(e):
                # This is the bug: the test fails on buggy code.
                pytest.fail(f"Bug reproduced: {e}")
            else:
                raise

