@pytest.mark.asyncio
async def test_postgres_checkpointer_loads_none_channel_values_correctly(
    postgres_checkpointer: AsyncPostgresSaver,
) -> None:
    """Test that loading a checkpoint with None channel_values does not raise TypeError.

    This reproduces the bug where `_load_checkpoint_tuple` tries to treat None as a mapping.
    """
    # Create a simple graph to produce a checkpoint
    builder = StateGraph(dict)
    builder.add_node("node", lambda state: state)
    builder.set_entry_point("node")
    builder.add_edge("node", END)
    graph = builder.compile(checkpointer=postgres_checkpointer)

    # Run the graph to create a checkpoint
    thread_id = "test_thread_5557"
    config = {"configurable": {"thread_id": thread_id}}
    result = await graph.ainvoke({"value": 1}, config)
    assert result == {"value": 1}

    # Now directly test the checkpointer's aget_tuple method
    # This should succeed without TypeError: 'NoneType' object is not a mapping
    checkpoint_tuple = await postgres_checkpointer.aget_tuple(config)
    assert checkpoint_tuple is not None
    # The checkpoint tuple should have a valid channel_values dict (or None)
    # The bug is that channel_values being None causes a TypeError in _load_checkpoint_tuple
    # We just need to ensure aget_tuple doesn't raise.
    if checkpoint_tuple.checkpoint is not None:
        # If there's a checkpoint, channel_values should be a dict or None
        # The bug is in _load_checkpoint_tuple when it tries to construct a dict from None.
        pass


@pytest.mark.asyncio
