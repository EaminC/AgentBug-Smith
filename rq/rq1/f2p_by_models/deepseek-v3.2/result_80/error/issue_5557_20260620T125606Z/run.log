    @pytest.mark.asyncio
    async def test_load_checkpoint_with_none_channel_values_buggy(self, postgres_checkpointer):
        # This test should fail on buggy code because channel_values is None.
        # In buggy version, _load_checkpoint_tuple will raise TypeError.
        # In fixed version, it should handle None and convert to empty dict.
