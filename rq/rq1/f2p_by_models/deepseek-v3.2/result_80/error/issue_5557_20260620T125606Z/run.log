# This test reproduces the bug: when loading a checkpoint tuple with a None channel_values,
# the _load_checkpoint_tuple method fails with TypeError: 'NoneType' object is not a mapping.
# The bug is in libs/checkpoint-postgres/langgraph/checkpoint/postgres/aio.py line 413.
