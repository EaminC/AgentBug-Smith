@pytest.fixture
def postgres_checkpointer() -> AsyncPostgresSaver:
    # Use environment variable for connection string, default to a test database
    conn_str = os.environ.get(
        "TEST_POSTGRES_CONNECTION_STRING",
        "postgresql://postgres:postgres@localhost:5432/postgres",
    )
