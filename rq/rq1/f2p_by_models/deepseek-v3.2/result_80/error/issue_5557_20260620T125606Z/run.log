@pytest.mark.asyncio
async def test_postgres_checkpoint_with_empty_channel_values():
    # Ensure normal operation works.
    saver = AsyncPostgresSaver.from_conn_string(POSTGRES_TEST_URL)
    thread_id = "test_thread_empty"
    # Create a simple graph to produce a checkpoint.
    builder = StateGraph()
    builder.add_node("node", lambda x: x)
    builder.set_entry_point("node")
    graph = builder.compile(checkpointer=saver)
    # Run once to create a checkpoint.
    inputs = {"messages": []}
    result = await graph.ainvoke(inputs)
    # Now get the checkpoint tuple.
    checkpoint_tuple = await saver.aget_tuple(thread_id)
    assert checkpoint_tuple is not None
    assert isinstance(checkpoint_tuple.channel_values, dict)
    # Clean up.
    conn = await asyncpg.connect(POSTGRES_TEST_URL)
    await conn.execute("DELETE FROM checkpoints WHERE thread_id = $1", thread_id)
    await conn.close()

