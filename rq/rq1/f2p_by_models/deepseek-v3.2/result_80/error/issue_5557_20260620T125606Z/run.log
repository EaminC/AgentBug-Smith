[32mimport asyncio
import os
import sys
import pytest
from typing import Any, Dict, List, Optional

# Ensure we can import the relevant modules
from langgraph.checkpoint.postgres.aio import AsyncPostgresSaver
from langgraph.checkpoint.base import Checkpoint, CheckpointMetadata
from langgraph.checkpoint.postgres.base import BasePostgresCheckpointer
from langgraph.checkpoint.postgres.aio import AsyncPostgresCheckpointer
from langgraph.checkpoint.postgres.sync import PostgresCheckpointer
import asyncpg
import json
import uuid


class TestPostgresCheckpointLoadBug:
    """Test that reproduces the bug where loading a checkpoint with None channel_values fails."""

    @pytest.fixture
    async def checkpointer(self):
        """Create an AsyncPostgresCheckpointer for testing."""
        # Use environment variable for connection string, default to local test database
        conn_str = os.environ.get(
            "POSTGRES_CONNECTION_STRING",
            "postgresql://postgres:postgres@localhost:5432/postgres"
        )
        checkpointer = AsyncPostgresCheckpointer.from_conn_string(conn_str)
        async with checkpointer:
            # Ensure table exists
            await checkpointer._setup()
            yield checkpointer
            # Clean up test data
            async with checkpointer.pool.acquire() as conn:
                await conn.execute("DELETE FROM checkpoints")

    @pytest.fixture
    def thread_id(self):
        return str(uuid.uuid4())

    @pytest.fixture
    def parent_checkpoint_id(self):
        return None

    @pytest.mark.asyncio
    async def test_load_checkpoint_with_none_channel_values_buggy(self, checkpointer, thread_id):
        """
        Reproduce the bug: when a checkpoint has NULL channel_values in the database,
        _load_checkpoint_tuple raises TypeError: 'NoneType' object is not a mapping.
        
        This happens when continuing an existing thread created before the fix.
        """
        # Simulate a checkpoint written by an older version where channel_values is NULL
        async with checkpointer.pool.acquire() as conn:
            checkpoint_id = str(uuid.uuid4())
            # Insert a checkpoint with NULL channel_values (as would happen in buggy version)
            await conn.execute(
                """
                INSERT INTO checkpoints 
                (checkpoint_id, thread_id, parent_checkpoint_id, checkpoint, checkpoint_ts, channel_values, metadata)
                VALUES ($1, $2, $3, $4, $5, $6, $7)
                """,
                checkpoint_id,
                thread_id,
                None,  # parent_checkpoint_id
                json.dumps({"state": {"messages": []}}),  # checkpoint
                "2024-01-01T00:00:00Z",  # checkpoint_ts
                None,  # channel_values - this is the bug: NULL in DB
                json.dumps({"source": "run", "step": 0}),  # metadata
            )

        # Now try to load it - this should fail with TypeError in buggy code
        # because _load_checkpoint_tuple tries to treat None as a dict.
        with pytest.raises(TypeError) as exc_info:
            await checkpointer.aget_tuple({"thread_id": thread_id, "checkpoint_id": checkpoint_id})
        
        # Verify the error message
        assert "'NoneType' object is not a mapping" in str(exc_info.value)

    @pytest.mark.asyncio
    async def test_load_checkpoint_with_empty_dict_channel_values_fixed(self, checkpointer, thread_id):
        """
        After the fix, checkpoints with NULL channel_values should be loaded as empty dict.
        This test passes only after the fix is applied.
        """
        # Insert a checkpoint with NULL channel_values (simulating old data)
        async with checkpointer.pool.acquire() as conn:
            checkpoint_id = str(uuid.uuid4())
            await conn.execute(
                """
                INSERT INTO checkpoints 
                (checkpoint_id, thread_id, parent_checkpoint_id, checkpoint, checkpoint_ts, channel_values, metadata)
                VALUES ($1, $2, $3, $4, $5, $6, $7)
                """,
                checkpoint_id,
                thread_id,
                None,
                json.dumps({"state": {"messages": []}}),
                "2024-01-01T00:00:00Z",
                None,  # NULL channel_values
                json.dumps({"source": "run", "step": 0}),
            )

        # Try to load it - should not raise TypeError after fix
        try:
            checkpoint_tuple = await checkpointer.aget_tuple(
                {"thread_id": thread_id, "checkpoint_id": checkpoint_id}
            )
            # If we get here, the fix works
            assert checkpoint_tuple is not None
            # channel_values should be empty dict, not None
            assert isinstance(checkpoint_tuple.channel_values, dict)
            assert checkpoint_tuple.channel_values == {}
        except TypeError as e:
            if "'NoneType' object is not a mapping" in str(e):
                pytest.fail(f"Bug still present: {e}")
            else:
                raise

    @pytest.mark.asyncio
    async def test_put_and_get_roundtrip(self, checkpointer, thread_id):
        """Test that putting and getting a checkpoint works correctly."""
        checkpoint = Checkpoint(
            v=1,
            ts="2024-01-01T00:00:00Z",
            channel_values={"messages": []},
            versions_seen={},
            pending_sends=[],
            next_versions=("node",),
        )
        metadata = CheckpointMetadata(
            source="run",
            step=0,
            writes={},
            config={},
            task_id=None,
            dtype="checkpoint",
        )

        # Put a checkpoint
        checkpoint_id = await checkpointer.aput(
            {"thread_id": thread_id},
            checkpoint,
            metadata,
            {"configurable": {}},
        )

        # Get it back
        loaded = await checkpointer.aget_tuple({"thread_id": thread_id, "checkpoint_id": checkpoint_id})
        assert loaded is not None
        assert loaded.checkpoint == checkpoint
        assert loaded.metadata == metadata
        # channel_values should be a dict
        assert isinstance(loaded.channel_values, dict)

    @pytest.mark.asyncio
    async def test_list_checkpoints_with_null_channel_values(self, checkpointer, thread_id):
        """Test listing checkpoints when some have NULL channel_values."""
        # Insert multiple checkpoints, some with NULL channel_values
        async with checkpointer.pool.acquire() as conn:
            for i in range(3):
                checkpoint_id = str(uuid.uuid4())
                await conn.execute(
                    """
                    INSERT INTO checkpoints 
                    (checkpoint_id, thread_id, parent_checkpoint_id, checkpoint, checkpoint_ts, channel_values, metadata)
                    VALUES ($1, $2, $3, $4, $5, $6, $7)
                    """,
                    checkpoint_id,
                    thread_id,
                    None,
                    json.dumps({"state": {"messages": []}}),
                    f"2024-01-01T00:00:{i:02d}Z",
                    None if i % 2 == 0 else json.dumps({}),  # Alternate NULL and empty dict
                    json.dumps({"source": "run", "step": i}),
                )

        # List checkpoints - should not crash even with NULL channel_values
        checkpoints = await checkpointer.alist({"thread_id": thread_id})
        assert len(checkpoints) == 3
        for cp in checkpoints:
            assert cp.thread_id == thread_id
            # channel_values should be properly handled (empty dict after fix)
            assert isinstance(cp.channel_values, dict)


