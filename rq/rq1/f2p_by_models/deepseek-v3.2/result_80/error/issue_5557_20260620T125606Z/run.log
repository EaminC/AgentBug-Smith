@pytest.mark.asyncio
async def test_postgres_checkpoint_load_none_channel_values_bug(mock_asyncpg_pool):
    """Test that loading a checkpoint with NULL channel_values does not raise TypeError.
    
    In buggy version, AsyncPostgresSaver._load_checkpoint_tuple tries to construct
    a dict with None as channel_values, causing TypeError.
    After fix, it should handle None gracefully.
    """
    # Create an AsyncPostgresSaver with a mock pool (via monkeypatch)
    # We'll use a dummy connection string since the pool is mocked.
    saver = AsyncPostgresSaver.from_conn_string("postgresql://localhost/test")
    # The saver internally uses asyncpg pool which we've mocked.
    # Now attempt to load a checkpoint tuple. Our mock returns a row with channel_values = None.
    # In buggy code, this will raise TypeError: 'NoneType' object is not a mapping.
    # After fix, it should return a valid CheckpointTuple or handle None.
    try:
        # This calls _load_checkpoint_tuple internally via aget_tuple
        checkpoint_tuple = await saver.aget_tuple({"thread_id": "test", "checkpoint_id": "test"})
        # If we reach here without exception, the bug is fixed.
        # However, we need to ensure the checkpoint tuple is valid.
        # The checkpoint tuple may have channel_values as an empty dict after fix.
        assert checkpoint_tuple is not None
        # The channel_values should be a dict (maybe empty) after fix.
        # In buggy version, the line constructing "channel_values": {...} would have failed.
        # So we just assert no exception occurred.
    except TypeError as e:
        if "'NoneType' object is not a mapping" in str(e):
            # This is the bug we expect in buggy version.
            pytest.fail(f"Bug reproduced: {e}")
        else:
            raise

def test_sync_postgres_checkpoint_load_none_channel_values_bug(mock_asyncpg_pool):
    """Sync version of the same test."""
    saver = PostgresSaver.from_conn_string("postgresql://localhost/test")
    try:
        checkpoint_tuple = saver.get_tuple({"thread_id": "test", "checkpoint_id": "test"})
        assert checkpoint_tuple is not None
    except TypeError as e:
        if "'NoneType' object is not a mapping" in str(e):
            pytest.fail(f"Bug reproduced: {e}")
        else:
            raise

# Additional test to ensure the fix works in a real graph scenario.
# We'll create a simple graph with a postgres checkpointer (mocked) and simulate
# continuing an existing thread.

@pytest.mark.asyncio
async def test_graph_continue_existing_thread_with_postgres(mock_asyncpg_pool):
    """Test that a graph can continue an existing thread with NULL channel_values."""
    # Build a trivial graph
    builder = StateGraph(dict)
    def node(state):
        return {"result": "ok"}
    builder.add_node("node", node)
    builder.set_entry_point("node")
    builder.add_edge("node", END)
    
    # Use AsyncPostgresSaver as checkpointer
    checkpointer = AsyncPostgresSaver.from_conn_string("postgresql://localhost/test")
    graph = builder.compile(checkpointer=checkpointer)
    
    # First, run a new thread to create a checkpoint.
    # This should work fine.
    thread_id = "new_thread"
    config = {"configurable": {"thread_id": thread_id}}
    result = await graph.ainvoke({"input": "test"}, config=config)
    assert result is not None
    
    # Now simulate continuing an existing thread where the stored checkpoint has NULL channel_values.
    # We'll directly manipulate the mock to return such a row.
    # But the bug is in loading, so we already have the mock returning NULL.
    # Attempt to continue the thread (load the checkpoint).
    # The graph will try to load the checkpoint via checkpointer.aget_tuple.
    # If buggy, it will raise TypeError.
