    memory_checkpointer: AsyncMemorySaver,
) -> None:
    """Same test but with memory checkpointer to ensure the bug is specific to postgres."""
    builder = StateGraph(dict)
    builder.add_node("node", lambda state: state)
    builder.set_entry_point("node")
    builder.add_edge("node", END)
    graph = builder.compile(checkpointer=memory_checkpointer)

    thread_id = "test_thread_5557_memory"
    config = {"configurable": {"thread_id": thread_id}}
    result = await graph.ainvoke({"value": 2}, config)
