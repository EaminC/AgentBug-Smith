            raise AssertionError(f"Bug reproduced in sync: {e}")
        else:
            raise

# The above test will fail on buggy code because the TypeError will be caught
# and we raise AssertionError, causing test failure.
# After fix, the TypeError should not occur, and test passes.

# However, we must ensure the test runs in the repo's environment.
# The repo likely has psycopg and asyncpg installed because they are dependencies
# of langgraph-checkpoint-postgres.
# But the test may be run in a minimal environment.
# If dependencies missing, let it crash with ImportError as per rule.

# We'll also add a test that creates a real checkpoint with None channel_values
# using a memory saver? That's not possible because memory saver doesn't have the bug.
# The bug is specific to postgres saver when loading existing checkpoints.

# Let's also test that the fix doesn't break normal operation.
# We'll create a mock row with proper channel_values dict.

@pytest.mark.asyncio
async def test_load_checkpoint_with_dict_channel_values(monkeypatch):
    row = {
        'checkpoint_id': 'test-id-2',
        'checkpoint': {'state': 'state2'},
        'parent_checkpoint_id': None,
        'checkpoint_type': 'checkpoint',
        'channel_values': {'key': 'value'},
        'metadata': None,
        'created_at': '2025-01-01T00:00:00Z'
    }
    monkeypatch.setattr(asyncpg, 'connect', mock_asyncpg_connect(row))
    saver = AsyncPostgresSaver.from_conn_string("postgresql://localhost/dummy")
    checkpoint_tuple = await saver.aget_tuple(
        thread_id="test-thread-2",
        checkpoint_config={"checkpoint_id": "test-id-2"}
    )
    # Should succeed
    assert checkpoint_tuple is not None

# Finally, we need to ensure the test file is executable and collects.
# We'll add a main guard.

if __name__ == "__main__":
    # Run the async test with asyncio
    asyncio.run(test_load_checkpoint_with_none_channel_values())
    print("Test passed")[0m
