async def create_test_table(conn):
    await conn.execute("""
        CREATE TABLE IF NOT EXISTS checkpoints (
            thread_id TEXT NOT NULL,
            checkpoint_id TEXT NOT NULL,
            parent_id TEXT,
            checkpoint JSONB,
            channel_values JSONB,
            metadata JSONB,
            created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
            PRIMARY KEY (thread_id, checkpoint_id)
        )
    """)
    await conn.execute("CREATE INDEX IF NOT EXISTS parent_idx ON checkpoints (thread_id, parent_id)")
    await conn.execute("CREATE INDEX IF NOT EXISTS created_at_idx ON checkpoints (created_at)")

async def drop_test_table(conn):
    await conn.execute("DROP TABLE IF EXISTS checkpoints")

async def insert_buggy_checkpoint(conn, thread_id: str, checkpoint_id: str, parent_id: Optional[str] = None):
