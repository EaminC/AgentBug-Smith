    checkpoint_tuple = await memory_checkpointer.aget_tuple(config)
    assert checkpoint_tuple is not None
    # Should not raise TypeError


@pytest.mark.asyncio
async def test_continue_existing_thread_with_postgres(
    postgres_checkpointer: AsyncPostgresSaver,
) -> None:
    """Simulate continuing an existing thread that triggers the bug.

    Steps:
    1. Create a checkpoint in a thread.
    2. Try to load it via aget_tuple (which internally calls _load_checkpoint_tuple).
    3. Ensure no TypeError about None channel_values.
    """
    # First invocation
    builder1 = StateGraph(dict)
    builder1.add_node("node", lambda state: state)
    builder1.set_entry_point("node")
    builder1.add_edge("node", END)
    graph1 = builder1.compile(checkpointer=postgres_checkpointer)

    thread_id = "existing_thread_5557"
    config = {"configurable": {"thread_id": thread_id}}
    await graph1.ainvoke({"step": 1}, config)

    # Simulate continuing the thread by loading the checkpoint directly
    # This is where the bug occurs in postgres v2.0.23
    checkpoint_tuple = await postgres_checkpointer.aget_tuple(config)
    # If buggy, the above line would raise TypeError inside _load_checkpoint_tuple
    assert checkpoint_tuple is not None

    # Now continue with a second invocation
    result2 = await graph1.ainvoke({"step": 2}, config)
    assert result2 == {"step": 2}


