from langgraph.checkpoint.postgres.sync import PostgresSaver
from langgraph.checkpoint.base import BaseCheckpointSaver
from langgraph.checkpoint.memory import MemorySaver
from langgraph.graph import StateGraph, START, END
from langgraph.prebuilt import ToolNode, create_tool_node_with_fallback
from langgraph.pregel import Pregel
from langgraph.pregel.types import Checkpoint, CheckpointTuple
import asyncpg
import psycopg2
from psycopg2 import pool
import json


class TestPostgresCheckpointBug5557:
    """Test for bug where continuing an existing thread fails with 'NoneType' object is not a mapping."""

    @pytest.fixture(scope="class")
    def postgres_url(self):
        """Get PostgreSQL connection URL from environment or use default."""
        url = os.environ.get("POSTGRES_URL", "postgresql://postgres:postgres@localhost:5432/postgres")
        return url

    @pytest.fixture(scope="class")
    async def async_checkpointer(self, postgres_url):
        """Create an async PostgreSQL checkpointer."""
        checkpointer = AsyncPostgresSaver.from_conn_string(postgres_url)
        await checkpointer.setup()
        try:
            yield checkpointer
        finally:
            await checkpointer.teardown()

    @pytest.fixture(scope="class")
    def sync_checkpointer(self, postgres_url):
        """Create a sync PostgreSQL checkpointer."""
        checkpointer = PostgresSaver.from_conn_string(postgres_url)
        checkpointer.setup()
        try:
            yield checkpointer
        finally:
            checkpointer.teardown()

    @pytest.mark.asyncio
    async def test_async_checkpoint_continuation_with_null_channel_values(self, async_checkpointer):
        """Test that continuing a thread with null channel_values does not raise TypeError.
        
        The bug occurs when `channel_values` is None in the saved checkpoint.
        """
        # Create a simple graph that uses the checkpointer
        builder = StateGraph(dict)
        builder.add_node("node1", lambda state: {"counter": state.get("counter", 0) + 1})
        builder.set_entry_point("node1")
        builder.add_edge("node1", END)
        
        graph = builder.compile(checkpointer=async_checkpointer)
        
        # First run: create a new thread
        thread_id = "test_thread_async"
        config = {"configurable": {"thread_id": thread_id}}
        
        # Run the graph once
        result = await graph.ainvoke({"counter": -1}, config)
        assert "counter" in result
        assert result["counter"] == 0
        
        # Manually insert a checkpoint with null channel_values to simulate the bug
        # This mimics what might happen with older thread versions
        async with async_checkpointer.pool.acquire() as conn:
            # Get the checkpoint we just created
            checkpoint_row = await conn.fetchrow(
                "SELECT * FROM checkpoints WHERE thread_id = $1 ORDER BY checkpoint_id DESC LIMIT 1",
                thread_id
            )
            
            if checkpoint_row:
                # Update the checkpoint to have null channel_values
                await conn.execute(
                    "UPDATE checkpoints SET checkpoint = $1 WHERE checkpoint_id = $2",
                    json.dumps({
                        "v": 1,
                        "ts": checkpoint_row["checkpoint"]["ts"],
                        "channel_values": None,  # This causes the bug
                        "versions_seen": checkpoint_row["checkpoint"].get("versions_seen", {}),
                        "pending_sends": checkpoint_row["checkpoint"].get("pending_sends", []),
                        "next": checkpoint_row["checkpoint"].get("next", []),
                        "metadata": checkpoint_row["checkpoint"].get("metadata", {}),
                        "parent_config": checkpoint_row["checkpoint"].get("parent_config"),
                    }),
                    checkpoint_row["checkpoint_id"]
                )
        
        # Now try to continue the thread - this should fail in buggy code
        # In fixed code, it should handle None channel_values gracefully
        try:
            result2 = await graph.ainvoke({"counter": 10}, config)
            # If we get here, the fix works
            assert "counter" in result2
            # The graph should run from the checkpoint, but since channel_values is None,
            # it should start fresh with the input state
            assert result2["counter"] == 11  # 10 + 1 from the node
        except TypeError as e:
            if "'NoneType' object is not a mapping" in str(e):
                # This is the bug - channel_values is None and code tries to use it as dict
                pytest.fail(f"Bug reproduced: {e}")
            else:
                raise

    def test_sync_checkpoint_continuation_with_null_channel_values(self, sync_checkpointer):
        """Sync version of the test."""
        builder = StateGraph(dict)
        builder.add_node("node1", lambda state: {"counter": state.get("counter", 0) + 1})
        builder.set_entry_point("node1")
        builder.add_edge("node1", END)
        
        graph = builder.compile(checkpointer=sync_checkpointer)
        
        thread_id = "test_thread_sync"
        config = {"configurable": {"thread_id": thread_id}}
        
        # First run
        result = graph.invoke({"counter": -1}, config)
        assert result["counter"] == 0
        
        # Manually corrupt the checkpoint to have null channel_values
        conn = sync_checkpointer.pool.getconn()
        try:
            with conn.cursor() as cur:
                cur.execute(
                    "SELECT checkpoint_id, checkpoint FROM checkpoints WHERE thread_id = %s ORDER BY checkpoint_id DESC LIMIT 1",
                    (thread_id,)
                )
                row = cur.fetchone()
                if row:
                    checkpoint_id, checkpoint = row
                    # Update to have null channel_values
                    corrupted_checkpoint = {
                        "v": 1,
                        "ts": checkpoint["ts"],
                        "channel_values": None,
                        "versions_seen": checkpoint.get("versions_seen", {}),
                        "pending_sends": checkpoint.get("pending_sends", []),
                        "next": checkpoint.get("next", []),
                        "metadata": checkpoint.get("metadata", {}),
                        "parent_config": checkpoint.get("parent_config"),
                    }
                    cur.execute(
                        "UPDATE checkpoints SET checkpoint = %s WHERE checkpoint_id = %s",
                        (json.dumps(corrupted_checkpoint), checkpoint_id)
                    )
                    conn.commit()
        finally:
            sync_checkpointer.pool.putconn(conn)
        
        # Try to continue - should not raise TypeError about NoneType not being mapping
        try:
            result2 = graph.invoke({"counter":   20}, config)
            assert result2["counter"] == 21
        except TypeError as e:
            if "'NoneType' object is not a mapping" in str(e):
                pytest.fail(f"Bug reproduced in sync version: {e}")
            else:
                raise

    @pytest.mark.asyncio
    async def test_aget_tuple_with_null_channel_values(self, async_checkpointer):
        """Directly test the aget_tuple method with null channel_values."""
        thread_id = "test_direct_async"
        
        # Create a checkpoint with null channel_values
        async with async_checkpointer.pool.acquire() as conn:
            await conn.execute("""
                INSERT INTO checkpoints (thread_id, checkpoint_id, parent_checkpoint_id, checkpoint_type, checkpoint)
                VALUES ($1, $2, $3, $4, $5)
            """, thread_id, "checkpoint1", None, "checkpoint", json.dumps({
                "v": 1,
                "ts": "2024-01-01T00:00:00.000000",
                "channel_values": None,
                "versions_seen": {},
                "pending_sends": [],
                "next": [],
                "metadata": {},
                "parent_config": None,
            }))
        
        # Try to load it - this is where the bug occurs
        config = {"configurable": {"thread_id": thread_id, "checkpoint_id": "checkpoint1"}}
        
        try:
            checkpoint_tuple = await async_checkpointer.aget_tuple(config)
            # If we get here, the fix works
            assert checkpoint_tuple is not None
            # The checkpoint should have empty dict for channel_values or similar
            if checkpoint_tuple.checkpoint:
                # channel_values might be None or empty dict depending on implementation
                # Either is acceptable as long as it doesn't crash
                pass
        except TypeError as e:
            if "'NoneType' object is not a mapping" in str(e):
                pytest.fail(f"Direct bug reproduction in aget_tuple: {e}")
            else:
                raise
        finally:
            # Cleanup
            async with async_checkpointer.pool.acquire() as conn:
                await conn.execute("DELETE FROM checkpoints WHERE thread_id = $1", thread_id)

    def test_get_tuple_with_null_channel_values(self, sync_checkpointer):
        """Directly test the get_tuple method with null channel_values."""
        thread_id = "test_direct_sync"
        
        conn = sync_checkpointer.pool.getconn()
        try:
            with conn.cursor() as cur:
                cur.execute("""
                    INSERT INTO checkpoints (thread_id, checkpoint_id, parent_checkpoint_id, checkpoint_type, checkpoint)
                    VALUES (%s, %s, %s, %s, %s)
                """, (thread_id, "checkpoint1", None, "checkpoint", json.dumps({
                    "v": 1,
                    "ts": "2024-01-01T00:00:00.000000",
                    "channel_values": None,
                    "versions_seen": {},
                    "pending_sends": [],
                    "next": [],
                    "metadata": {},
                    "parent_config": None,
                })))
                conn.commit()
        finally:
            sync_checkpointer.pool.putconn(conn)
        
        config = {"configurable": {"thread_id": thread_id, "checkpoint_id": "checkpoint1"}}
        
        try:
            checkpoint_tuple = sync_checkpointer.get_tuple(config)
            assert checkpoint_tuple is not None
        except TypeError as e:
            if "'NoneType' object is not a mapping" in str(e):
                pytest.fail(f"Direct bug reproduction in get_tuple: {e}")
            else:
                raise
        finally:
            # Cleanup
            conn = sync_checkpointer.pool.getconn()
            try:
                with conn.cursor() as cur:
                    cur.execute("DELETE FROM checkpoints WHERE thread_id = %s", (thread_id,))
                    conn.commit()
            finally:
                sync_checkpointer.pool.putconn(conn)

    @pytest.mark.asyncio
    async def test_real_world_scenario_with_tool_node(self, async_checkpointer):
        """Test a more realistic scenario with a tool node, similar to the issue."""
        # Create a simple tool
        def dummy_tool(query: str) -> str:
            return f"Processed: {query}"
        
        # Create graph with tool node
        builder = StateGraph(dict)
        
        def assistant(state: dict) -> dict:
            return {"query": state.get("query", "") + " processed"}
        
        builder.add_node("assistant", assistant)
        builder.add_node("tools", ToolNode([dummy_tool]))
        builder.set_entry_point("assistant")
        
        def route(state: dict) -> str:
            return "tools" if state.get("use_tools", False) else END
        
        builder.add_conditional_edges("assistant", route)
        builder.add_edge("tools", "assistant")
        
        graph = builder.compile(checkpointer=async_checkpointer)
        
        # Run in a new thread
        thread_id = "real_world_thread"
        config = {"configurable": {"thread_id": thread_id}}
        
        result1 = await graph.ainvoke({"query": "test", "use_tools": True}, config)
        assert "query" in result1
        
        # Corrupt the checkpoint to have null channel_values
        async with async_checkpointer.pool.acquire() as conn:
            checkpoint_row = await conn.fetchrow(
                "SELECT checkpoint_id, checkpoint FROM checkpoints WHERE thread_id = $1 ORDER BY checkpoint_id DESC LIMIT 1",
                thread_id
            )
            
            if checkpoint_row:
                checkpoint_id, checkpoint = checkpoint_row["checkpoint_id"], checkpoint_row["checkpoint"]
                corrupted = {
                    "v": 1,
                    "ts": checkpoint["ts"],
                    "channel_values": None,
                    "versions_seen": checkpoint.get("versions_seen", {}),
                    "pending_sends": checkpoint.get("pending_sends", []),
                    "next": checkpoint.get("next", []),
                    "metadata": checkpoint.get("metadata", {}),
                    "parent_config": checkpoint.get("parent_config"),
                }
                await conn.execute(
                    "UPDATE checkpoints SET checkpoint = $1 WHERE checkpoint_id = $2",
                    json.dumps(corrupted), checkpoint_id
                )
        
        # Continue the thread - should not crash
        try:
            result2 = await graph.ainvoke({"query": "continued"}, config)
            # Should get here without TypeError
            assert "query" in result2
        except TypeError as e:
            if "'NoneType' object is not a mapping" in str(e):
                pytest.fail(f"Real-world bug reproduction: {e}")
            else:
                raise[0m
