            # If we reach here, the bug is fixed (or at least no TypeError).
            # We can assert the structure.
            # The result should be a tuple (checkpoint, checkpoint_id, parent_checkpoint_id, metadata, channel_values, writes)
            assert isinstance(result, tuple)
