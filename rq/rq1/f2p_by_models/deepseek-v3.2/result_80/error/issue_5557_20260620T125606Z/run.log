from langgraph.graph import StateGraph, START, END
from langgraph.prebuilt import create_tool_node_with_fallback
from langgraph.checkpoint.base import BaseCheckpointSaver
import asyncpg
import json

# Mock the asyncpg connection pool to avoid needing a real PostgreSQL instance
# We'll mock the internal network call (asyncpg.connect) to return a mock connection
# that simulates the buggy behavior.

class MockAsyncPGPool:
    def __init__(self, *args, **kwargs):
        pass

    async def __aenter__(self):
        return self

    async def __aexit__(self, *args):
        pass

    async def fetchrow(self, query, *args):
        # Simulate the bug: when channel_values is NULL in the database,
        # the buggy code tries to treat it as a mapping.
        # In the buggy version, _load_checkpoint_tuple tries to load a NULL as a dict.
        # We'll simulate a row where channel_values is None.
        if "channel_values" in query:
            # Return a row with a None channel_values column
            class Row:
                def __init__(self):
                    self.thread_id = "test_thread"
                    self.checkpoint_id = 1
                    self.parent_checkpoint_id = None
                    self.checkpoint = json.dumps({"key": "value"})
                    self.channel_values = None  # This is the bug trigger
                    self.metadata = None
                    self.writes = None
            return Row()
        return None

    async def execute(self, query, *args):
        return None

    async def fetchval(self, query, *args):
        return None

    async def close(self):
        pass

# Patch asyncpg.create_pool to return our mock
import unittest.mock
original_create_pool = asyncpg.create_pool

async def mock_create_pool(*args, **kwargs):
    return MockAsyncPGPool()

asyncpg.create_pool = mock_create_pool

# Also patch asyncpg.connect for sync saver
original_connect = asyncpg.connect
async def mock_connect(*args, **kwargs):
    return MockAsyncPGPool()

asyncpg.connect = mock_connect

# Now we can write the test.
# The bug is in AsyncPostgresSaver._load_checkpoint_tuple (line 413 in aio.py).
# When channel_values is NULL in the database, the buggy code tries to treat it as a dict.
# The fix likely ensures channel_values is loaded as an empty dict if NULL.
# We'll test that aget_tuple works without raising TypeError.

@pytest.mark.asyncio
async def test_postgres_saver_handles_null_channel_values():
    """Test that AsyncPostgresSaver can load a checkpoint where channel_values is NULL."""
    # Create a saver with a dummy connection string (it won't be used due to mocking)
    saver = AsyncPostgresSaver.from_conn_string("postgresql://user:pass@localhost/db")
    # Try to load a checkpoint that has NULL channel_values.
    # In the buggy version, this will raise TypeError: 'NoneType' object is not a mapping.
    # In the fixed version, it should return a checkpoint tuple with channel_values as empty dict.
    try:
        checkpoint = await saver.aget_tuple("test_thread", checkpoint_id=1)
        # If we get here, the bug is fixed (or at least no TypeError).
        # We can assert that channel_values is a dict (maybe empty).
        assert isinstance(checkpoint.channel_values, dict)
    except TypeError as e:
        if "'NoneType' object is not a mapping" in str(e):
            pytest.fail(f"Bug reproduced: {e}")
        else:
            raise

# Also test the sync version for completeness
def test_postgres_saver_sync_handles_null_channel_values():
    """Test that PostgresSaver can load a checkpoint where channel_values is NULL."""
    # Patch asyncpg.connect for sync saver (already done above)
    saver = PostgresSaver.from_conn_string("postgresql://user:pass@localhost/db")
