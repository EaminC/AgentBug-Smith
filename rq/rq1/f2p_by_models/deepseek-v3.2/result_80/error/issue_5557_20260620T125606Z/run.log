@pytest.mark.asyncio
async def test_postgres_checkpoint_channel_values_none(monkeypatch):
    """Test that channel_values NULL is handled."""
    # Skip if module not available
    try:
        from langgraph.checkpoint.postgres.aio import AsyncPostgresSaver
    except ImportError:
        # Let it crash; the pipeline will handle.
        raise

    # Create a mock row that mimics the database row.
    # We'll use a simple dict-like object.
    class MockRow:
        def __init__(self):
            self.data = {
                "channel_values": None,
                "parent_checkpoint_id": None,
                "checkpoint_id": "cid",
                "thread_id": "tid",
                "checkpoint": b'{}',
                "metadata": b'{}',
            }
        def __getitem__(self, key):
            return self.data[key]
        def get(self, key, default=None):
            return self.data.get(key, default)

    # Create a mock connection that returns the row.
    class MockConn:
        async def __aenter__(self):
            return self
        async def __aexit__(self, *args):
            pass
        async def fetchrow(self, query, *args):
            return MockRow()
        async def execute(self, *args, **kwargs):
            pass
        async def fetch(self, *args, **kwargs):
            return []
        async def close(self):
            pass

    class MockPool:
        async def acquire(self):
            return MockConn()
        async def close(self):
            pass
        async def __aenter__(self):
            return self
        async def __aexit__(self, *args):
            pass

    # Create saver and replace its pool.
    saver = AsyncPostgresSaver.from_conn_string("postgresql://localhost/test")
    # Monkeypatch the _initialize to skip
    async def noop_init(self):
        pass
    monkeypatch.setattr(AsyncPostgresSaver, '_initialize', noop_init)
    # Replace the pool with mock
    saver._apool = MockPool()

    # Now call aget_tuple. It will call _load_checkpoint_tuple which uses the pool.
    try:
        result = await saver.aget_tuple(("tid", None))
        # If we get here, the bug is fixed (or didn't trigger). We'll accept.
        # Optionally assert that channel_values is empty dict or None.
        # The method returns a tuple (checkpoint, metadata, parent_checkpoint_id, checkpoint_id, channel_values)
        if result is not None:
            channel_vals = result[4] if len(result) > 4 else None
            # If buggy, it would have raised TypeError before returning.
            # If fixed, channel_vals could be None or {}.
            # We'll just ensure no TypeError.
    except TypeError as e:
        if "'NoneType' object is not a mapping" in str(e):
            raise AssertionError(f"Bug reproduced: {e}")
        else:
            raise

