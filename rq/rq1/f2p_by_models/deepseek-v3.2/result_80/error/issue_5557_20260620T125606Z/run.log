async def test_load_checkpoint_with_null_channel_values(async_postgres_saver, postgres_connection):
    """Test that loading a checkpoint with NULL channel_values does not raise TypeError.
    
    In buggy version, `_load_checkpoint_tuple` tries to treat None as a mapping.
    After fix, it should handle None gracefully (likely default to empty dict).
