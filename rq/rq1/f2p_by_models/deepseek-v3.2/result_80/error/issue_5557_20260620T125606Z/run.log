async def test_postgres_checkpointer_loads_none_channel_values(mock_pg_pool):
    """Test that AsyncPostgresSaver correctly handles None channel_values from database."""
    # Create a checkpointer with a mock pool
    checkpointer = AsyncPostgresSaver.from_conn_string("postgresql://user:pass@localhost/db")
    # Replace the internal pool with our mock
    checkpointer.pool = mock_pg_pool

    # This should not raise TypeError: 'NoneType' object is not a mapping
    # In buggy version, _load_checkpoint_tuple fails when channel_values is None
    try:
        result = await checkpointer.aget_tuple({"checkpoint_id": "test_checkpoint_id", "thread_id": "test_thread_id"})
        # If we get here, the bug is fixed (or the test passes because channel_values is handled)
        # We'll assert something about the result to ensure the test actually runs
        # The result should be None because our mock returns a row with None channel_values
        # but the checkpointer might return None if checkpoint not found.
        # We just want to ensure no TypeError is raised.
        assert result is None or isinstance(result, tuple)
    except TypeError as e:
        if "'NoneType' object is not a mapping" in str(e):
            # This is the bug we expect in the buggy version
            # Let the test fail with this assertion
            assert False, f"Bug reproduced: {e}"
        else:
            raise

