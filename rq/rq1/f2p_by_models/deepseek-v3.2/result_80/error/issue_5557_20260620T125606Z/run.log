@pytest.mark.asyncio
async def test_postgres_checkpoint_channel_values_none():
    """Test that AsyncPostgresSaver handles None channel_values correctly.

    In buggy version, _load_checkpoint_tuple raises TypeError when channel_values is None.
    In fixed version, it should handle None gracefully.
    """
    # We need to create an instance of AsyncPostgresSaver.
    # Since we cannot rely on a real Postgres database, we'll let the test crash if connection fails.
    # That's okay because the environment should have a test Postgres instance.
    # But the existing test suite uses docker-compose for Postgres.
    # We'll assume the test environment provides a POSTGRES_TEST_CONNECTION_STRING.
    conn_str = os.environ.get("POSTGRES_TEST_CONNECTION_STRING")
    if not conn_str:
        # If not set, we cannot run the test. According to rules, we should crash.
        # But we want the test to fail on buggy version, not skip.
        # We'll raise an error that will cause the test to fail.
        raise RuntimeError(
            "POSTGRES_TEST_CONNECTION_STRING environment variable not set. "
            "Cannot test AsyncPostgresSaver."
        )

    # Create the checkpointer
    checkpointer = AsyncPostgresSaver.from_conn_string(conn_str)

    # We need to insert a checkpoint with None channel_values into the database.
    # The bug occurs when loading a checkpoint that was saved by a previous version.
    # We'll directly call _load_checkpoint_tuple with a dict that mimics a saved checkpoint.
    # This is allowed because we're calling the real method.
    # The method signature is _load_checkpoint_tuple(self, value: dict) -> tuple
    # We'll construct a value dict that has "channel_values": None.
    # In the buggy version, this raises TypeError.
    # In the fixed version, it should return a tuple with empty dict for channel_values.
    # However, _load_checkpoint_tuple expects a dict with specific keys from the database.
    # Let's look at the actual code in the repository.
    # Since we cannot inspect the source here, we'll rely on the error trace.
    # The error occurs at line 413 in _load_checkpoint_tuple.
    # The code is trying to do something with "channel_values": { ... }.
    # We'll assume the value dict has a key "channel_values" that is None.
    # We'll call the method and see if it raises TypeError.

    # We need to access the protected method.
    # Use getattr to bypass privacy.
    method = checkpointer._load_checkpoint_tuple
    # Create a dummy checkpoint dict that matches what the database returns.
    # From the stack trace, the method is called from aget_tuple, which passes a dict
    # that includes "channel_values" from the database row.
    # If the database has NULL for channel_values, it will be None.
    dummy_checkpoint = {
        "channel_values": None,
        "id": "test_thread",
        "checkpoint_id": "test_checkpoint",
        "parent_checkpoint_id": None,
        "checkpoint": {},
        "metadata": {},
        "channel_versions": {},
        "pending_sends": [],
        "created_at": "2025-01-01T00:00:00",
        "version": "1.0",
    }

    try:
        result = method(dummy_checkpoint)
        # If we reach here, the method didn't raise TypeError.
        # That means the bug is fixed.
        # We should assert that channel_values is an empty dict or similar.
        # The result is a tuple: (checkpoint, checkpoint_id, parent_checkpoint_id, ...)
        # We'll just ensure no exception.
        assert result is not None
    except TypeError as e:
        if "'NoneType' object is not a mapping" in str(e):
            # This is the bug.
            # The test should fail on buggy version.
            # We'll raise an assertion error to make the test fail.
            raise AssertionError(
                "AsyncPostgresSaver._load_checkpoint_tuple raised TypeError with None channel_values"
            ) from e
        else:
            # Some other TypeError, re-raise.
            raise


@pytest.mark.asyncio
async def test_postgres_checkpoint_real_usage():
    """Test a real graph with AsyncPostgresSaver to reproduce the bug.

    This test creates a graph, runs it, saves a checkpoint, then tries to load it
    in a way that triggers the bug.
    """
    conn_str = os.environ.get("POSTGRES_TEST_CONNECTION_STRING")
    if not conn_str:
        raise RuntimeError("POSTGRES_TEST_CONNECTION_STRING not set")

    # Create a simple graph
    builder = StateGraph(dict)
    builder.add_node("node", lambda state: state)
    builder.set_entry_point("node")
    builder.add_edge("node", END)

    # Compile with AsyncPostgresSaver
    checkpointer = AsyncPostgresSaver.from_conn_string(conn_str)
    graph = builder.compile(checkpointer=checkpointer)

    # Run once to create a checkpoint
    thread_id = "test_thread_5557"
    config = {"configurable": {"thread_id": thread_id}}
    result = await graph.ainvoke({"value": 1}, config)
    assert result == {"value": 1}

    # Now try to continue the thread by loading the checkpoint.
    # The bug occurs when continuing an existing thread.
    # We'll use astream_log to trigger checkpoint loading.
    # But the bug is in aget_tuple, which is called by AsyncPregelLoop.
    # We'll simulate by calling checkpointer.aget_tuple directly.
    checkpoint_config = {
        "configurable": {
            "thread_id": thread_id,
            "checkpoint_id": None,  # latest
        }
    }
    try:
        checkpoint_tuple = await checkpointer.aget_tuple(checkpoint_config)
        # If we reach here, no TypeError.
        # The bug is fixed.
        assert checkpoint_tuple is not None
    except TypeError as e:
        if "'NoneType' object is not a mapping" in str(e):
            raise AssertionError(
                "AsyncPostgresSaver.aget_tuple raised TypeError with None channel_values"
            ) from e
        else:
            raise


