    # In buggy code, it raises TypeError: 'NoneType' object is not a mapping.
    # After fix, it should succeed (or at least not raise that TypeError).
    try:
        checkpoint_tuple = await async_postgres_saver.aget_tuple((thread_id, checkpoint_id))
        # If we get here, the bug is fixed (or at least TypeError is avoided).
        # We can assert something about the returned tuple.
        # channel_values should be an empty dict (or None handled).
        # The method returns a tuple (checkpoint, channel_values, metadata).
        checkpoint, channel_values, metadata = checkpoint_tuple
