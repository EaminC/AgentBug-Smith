                self.metadata = None
                self.channel_values = None  # This is the bug trigger
                self.writes = None
                self.created_at = "2025-01-01"
                self.version = "1.0"
        return Row()

async def test_aget_tuple_with_none_channel_values():
    """Test that aget_tuple handles NULL channel_values gracefully."""
    # We need to replace the internal _get_connection method of AsyncPostgresSaver
    # to return our mock connection.
    # But we must not mock the buggy _load_checkpoint_tuple.
    # Instead, we'll mock the asyncpg pool acquisition.
    import asyncpg
    from unittest.mock import AsyncMock, patch

    # Create a mock pool that returns our mock connection.
    mock_pool = AsyncMock()
    mock_pool.acquire.return_value.__aenter__.return_value = MockAsyncConnection()

    with patch.object(asyncpg, 'create_pool', AsyncMock(return_value=mock_pool)):
        # Instantiate the saver with dummy connection string.
        saver = AsyncPostgresSaver.from_conn_string("postgresql://dummy")
        # Ensure the pool is set (the mock will be used).
        saver.pool = mock_pool

        # Now call aget_tuple with a thread_id that will trigger the bug.
        # In buggy code, this will raise TypeError.
        # In fixed code, it should return a tuple with empty dict for channel_values.
        try:
