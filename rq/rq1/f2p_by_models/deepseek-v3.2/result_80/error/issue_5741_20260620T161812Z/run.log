[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and setuptools
RUN python -m pip install --upgrade pip setuptools wheel

# Copy the entire repository (including externally-injected tests)
COPY . .

# Determine package manager based on file existence
# The repository uses uv (as evidenced by Makefile and GitHub workflows)
# but we fall back to pip if uv is not available or requirements.txt exists.
# However, the primary package is in libs/langgraph (inferred from workflows).
# We need to install the package and its dependencies.
# Assumption: main package is in libs/langgraph, but we install from root if pyproject.toml exists.
# The Makefile installs via `uv pip install -e` for each libs/* with pyproject.toml.

# Check for uv.lock in libs/langgraph (common pattern)
# If uv.lock exists, use uv sync; else fallback to pip.
# Also install test dependencies unconditionally.

# First, install uv if not present
RUN python -m pip install uv

# Install dependencies for libs/langgraph (the main package)
WORKDIR /app/libs/langgraph
# Use uv sync for dev group (as per GitHub workflow)
RUN if [ -f uv.lock ]; then \
        uv sync --frozen --group dev; \
    else \
        # Fallback to pip install with editable install
        python -m pip install -e .; \
    fi

# Install mandatory test dependencies (required by test harness)
RUN python -m pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Preflight import check to ensure core modules are available
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Return to root WORKDIR for test execution
WORKDIR /app

# The final CMD must be inferred from project configuration.
# The Makefile target `test` runs tests in subdirectories.
# Since the test harness will run tests, we default to bash.
CMD ["/bin/bash"][0m
