[32mFROM python:3.12-slim AS test_builder

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Upgrade packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Detect src/ layout to avoid duplicate module loading
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." tests 2>/dev/null; then \
    echo "src/ layout detected, setting PYTHONPATH and skipping editable install" && \
    export PYTHONPATH=/app && \
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
    echo "No src/ layout detected, performing editable install" && \
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Install uv if Makefile uses it (optional)
RUN if [ -f "Makefile" ] && grep -q "uv sync" Makefile; then \
    pip install uv; \
    fi

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

# Multi-stage build for minimal runtime image
FROM python:3.12-slim AS runtime

WORKDIR /app

# Upgrade packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Copy only necessary files from test_builder
COPY --from=test_builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=test_builder /usr/local/bin /usr/local/bin

# Copy application source (excluding tests)
COPY src/ src/
COPY pyproject.toml .

# Install production dependencies only (no dev extras)
RUN if [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt; \
    else \
    pip install .; \
    fi

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Expose default FastAPI port
EXPOSE 8000

# Set the default command based on project scripts
CMD ["agentup", "--help"][0m
