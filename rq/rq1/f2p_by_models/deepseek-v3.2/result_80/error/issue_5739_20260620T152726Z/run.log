[32mimport pytest
from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langchain_core.tools import BaseTool
from langchain_core.messages import BaseMessage, HumanMessage
from langchain_core.runnables import Runnable
from langchain_core.language_models import BaseChatModel
from typing import Callable, Sequence, Any
from langgraph import StateGraph
from langgraph.types import Command, interrupt
from langgraph.checkpoint.memory import MemorySaver
from unittest.mock import Mock, AsyncMock
import asyncio


def test_create_react_agent_with_bind_tools_return_type():
    """Test that create_react_agent accepts a dynamic model callable returning Runnable[LanguageModelInput, BaseMessage]."""
    # Create a mock tool
    mock_tool = Mock(spec=BaseTool)
    mock_tool.name = "mock_tool"
    mock_tool.description = "A mock tool"
    mock_tool.invoke = Mock(return_value="tool result")

    # Create a mock BaseChatModel that returns a Runnable via bind_tools
    mock_model = Mock(spec=BaseChatModel)
    # bind_tools returns a Runnable[LanguageModelInput, BaseMessage]
    mock_runnable = Mock(spec=Runnable)
    mock_model.bind_tools = Mock(return_value=mock_runnable)
    # Simulate the runnable invocation
    mock_runnable.invoke = Mock(return_value=HumanMessage(content="response"))

    # Dynamic model callable that returns the result of bind_tools (Runnable)
    def dynamic_model(state, runtime):
        return mock_model.bind_tools([mock_tool])

    # This should work without type errors in the fixed version
    # In buggy version, the type annotation expects BaseChatModel, not Runnable
    agent = create_react_agent(
        model=dynamic_model,
        tools=[mock_tool],
        checkpointer=MemorySaver(),
    )

    # Verify the agent is created (graph is built)
    assert isinstance(agent, StateGraph)
    # The graph should have nodes
    assert len(agent.nodes) > 0


@pytest.mark.asyncio
async def test_create_react_agent_with_async_bind_tools_return_type():
    """Test that create_react_agent accepts an async dynamic model callable returning Awaitable[Runnable[...]]."""
    mock_tool = Mock(spec=BaseTool)
    mock_tool.name = "mock_tool"
    mock_tool.description = "A mock tool"
    mock_tool.invoke = Mock(return_value="tool result")

    mock_model = Mock(spec=BaseChatModel)
    mock_runnable = Mock(spec=Runnable)
    mock_model.bind_tools = Mock(return_value=mock_runnable)
    mock_runnable.invoke = AsyncMock(return_value=HumanMessage(content="async response"))

    async def async_dynamic_model(state, runtime):
        await asyncio.sleep(0)
        return mock_model.bind_tools([mock_tool])

    agent = create_react_agent(
        model=async_dynamic_model,
        tools=[mock_tool],
        checkpointer=MemorySaver(),
    )

    assert isinstance(agent, StateGraph)
    assert len(agent.nodes) > 0


