[32mimport sys
import pytest
from typing import Any, Callable, Sequence
from unittest.mock import MagicMock, AsyncMock
from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langgraph.graph import StateGraph, END
from langgraph.types import Command, interrupt
from langchain_core.tools import BaseTool
from langchain_core.messages import BaseMessage, HumanMessage, AIMessage
from langchain_core.runnables import Runnable
from langchain_core.language_models import BaseChatModel
from langchain_core.language_models.chat_models import LanguageModelInput


def test_create_react_agent_with_dynamic_model_returning_runnable_binding():
    """Test that create_react_agent accepts a dynamic model callable returning a Runnable[LanguageModelInput, BaseMessage] (e.g., from bind_tools)."""
    # Create a mock tool
    mock_tool = MagicMock(spec=BaseTool)
    mock_tool.name = "test_tool"
    mock_tool.description = "A test tool"
    mock_tool.return_value = "tool result"

    # Create a mock BaseChatModel that will be bound with tools
    mock_model = MagicMock(spec=BaseChatModel)
    # Simulate bind_tools returning a Runnable (not a BaseChatModel)
    bound_runnable = MagicMock(spec=Runnable)
    bound_runnable.invoke = MagicMock(return_value=AIMessage(content="bound response"))
    mock_model.bind_tools = MagicMock(return_value=bound_runnable)

    # Dynamic model callable that returns the bound runnable (Runnable[LanguageModelInput, BaseMessage])
    def dynamic_model(state, runtime):
        # This mimics a user pattern: model.bind_tools(...)
        return mock_model.bind_tools([mock_tool])

    # Build the agent
    agent = create_react_agent(
        model=dynamic_model,
        tools=[mock_tool],
        name="TestAgent",
        prompt="You are a test agent.",
    )

    # Ensure the agent graph can be built and invoked
    graph = StateGraph(agent.state_schema)
    graph.add_node("agent", agent)
    graph.set_entry_point("agent")
    graph.add_edge("agent", END)
    app = graph.compile()

    # Mock the bound runnable's invoke to return a valid AIMessage
    # The actual agent will call the runnable with appropriate input
    # We'll intercept the call to the model callable, but the bug is about type annotation,
    # so we just need to ensure the agent construction doesn't raise a type error.
    # However, we also need to test that the agent works with the bound runnable.
    # We'll simulate a minimal invocation.
    # The agent's _call_model will receive the bound runnable and call its invoke.
    # Let's patch the bound runnable's invoke to return a predictable AIMessage.
    bound_runnable.invoke.return_value = AIMessage(content="test response", tool_calls=[])

    # Invoke the graph with a simple state
    # The state schema is defined by the agent; we need to match it.
    # For a react agent, the state typically includes "messages".
    initial_state = {"messages": [HumanMessage(content="Hello")]}
    try:
        result = app.invoke(initial_state)
        # If we get here, the agent accepted the bound runnable and executed.
        # The buggy version would have a type mismatch because the dynamic model callable
        # returns Runnable[LanguageModelInput, BaseMessage] but the annotation expects BaseChatModel.
        # The fixed version should accept it.
        assert "messages" in result
        # The last message should be from the agent
        last_msg = result["messages"][-1]
        assert isinstance(last_msg, AIMessage)
        assert last_msg.content == "test response"
    except Exception as e:
        # If the bug is present, a type error may be raised during agent construction or invocation.
        # We'll let the test fail by propagating the exception.
        raise


@pytest.mark.asyncio
async def test_create_react_agent_with_async_dynamic_model_returning_runnable_binding():
    """Test that create_react_agent accepts an async dynamic model callable returning an Awaitable[Runnable[...]]."""
    mock_tool = MagicMock(spec=BaseTool)
    mock_tool.name = "async_tool"
    mock_tool.description = "An async test tool"

    mock_model = MagicMock(spec=BaseChatModel)
    bound_runnable = MagicMock(spec=Runnable)
    bound_runnable.invoke = AsyncMock(return_value=AIMessage(content="async bound response"))
    mock_model.bind_tools = MagicMock(return_value=bound_runnable)

    async def async_dynamic_model(state, runtime):
        # Simulate async model loading or binding
        return mock_model.bind_tools([mock_tool])

    agent = create_react_agent(
        model=async_dynamic_model,
        tools=[mock_tool],
        name="AsyncTestAgent",
        prompt="Async test agent.",
    )

    graph = StateGraph(agent.state_schema)
    graph.add_node("agent", agent)
    graph.set_entry_point("agent")
    graph.add_edge("agent", END)
    app = graph.compile()

    bound_runnable.invoke.return_value = AIMessage(content="async test response", tool_calls=[])

    initial_state = {"messages": [HumanMessage(content="Hello async")]}
    # Use ainvoke for async graph (if supported) or invoke with async model.
    # The agent's internal call will await the async_dynamic_model.
    # We'll just invoke synchronously; the agent should handle the async callable.
    # The buggy version would reject the async callable returning a Runnable.
    result = app.invoke(initial_state)
    assert "messages" in result
    last_msg = result["messages"][-1]
    assert isinstance(last_msg, AIMessage)
    assert last_msg.content == "async test response"


def test_create_react_agent_with_dynamic_model_returning_base_chat_model_still_works():
    """Ensure backward compatibility: dynamic model returning BaseChatModel still works."""
    mock_tool = MagicMock(spec=BaseTool)
    mock_tool.name = "compat_tool"
    mock_tool.description = "Compatibility tool"

    mock_model = MagicMock(spec=BaseChatModel)
    mock_model.invoke = MagicMock(return_value=AIMessage(content="direct model response"))

    def dynamic_model(state, runtime):
        return mock_model

    agent = create_react_agent(
        model=dynamic_model,
        tools=[mock_tool],
        name="CompatAgent",
        prompt="Compatibility test.",
    )

    graph = StateGraph(agent.state_schema)
    graph.add_node("agent", agent)
    graph.set_entry_point("agent")
    graph.add_edge("agent", END)
    app = graph.compile()

    mock_model.invoke.return_value = AIMessage(content="direct response", tool_calls=[])

    initial_state = {"messages": [HumanMessage(content="Hello compat")]}
    result = app.invoke(initial_state)
    assert "messages" in result
    last_msg = result["messages"][-1]
    assert isinstance(last_msg, AIMessage)
    assert last_msg.content == "direct response"


