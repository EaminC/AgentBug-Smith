[32mimport pytest
from typing import Any, Callable, Sequence
from langchain_core.tools import BaseTool
from langchain_core.runnables import Runnable
from langchain_core.messages import BaseMessage
from langchain_core.language_models import BaseChatModel
from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langgraph.graph.state import StateGraph
from langgraph.types import interrupt
from langgraph.graph import END


def test_create_react_agent_with_bind_tools_return_type():
    """Test that create_react_agent accepts a dynamic model callable that returns Runnable[LanguageModelInput, BaseMessage] from bind_tools."""
    # Define a simple tool
    def dummy_tool(query: str) -> str:
        return f"Result for {query}"
    
    tools = [dummy_tool]
    
    # Create a mock BaseChatModel that can be bound with tools
    class MockChatModel(BaseChatModel):
        def _generate(self, messages, **kwargs):
            raise NotImplementedError()
        
        @property
        def _llm_type(self) -> str:
            return "mock"
        
        def bind_tools(self, tools, **kwargs):
            # Return a Runnable that conforms to Runnable[LanguageModelInput, BaseMessage]
            # This is what the buggy code incorrectly rejects
            from langchain_core.runnables import RunnableLambda
            
            def invoke_wrapper(input_data):
                # Return a dummy message
                from langchain_core.messages import AIMessage
                return AIMessage(content="Mock response with bound tools")
            
            return RunnableLambda(invoke_wrapper)
    
    # Dynamic model callable that returns the result of bind_tools
    def dynamic_model(state, runtime):
        model = MockChatModel()
        # This returns Runnable[LanguageModelInput, BaseMessage], not BaseChatModel
        return model.bind_tools(tools)
    
    # This should work with the fixed type annotations
    # In buggy code, this raises a type error because dynamic_model returns Runnable, not BaseChatModel
    agent = create_react_agent(
        model=dynamic_model,
        tools=tools,
        checkpointer=None,
    )
    
    # Verify the agent is created successfully
    assert agent is not None
    # The agent should be a StateGraph
    assert isinstance(agent, StateGraph)
    
    # Build the graph to ensure no runtime errors
    graph = agent.compile()
    assert graph is not None


def test_create_react_agent_with_async_bind_tools_return_type():
    """Test that create_react_agent accepts an async dynamic model callable that returns Awaitable[Runnable[LanguageModelInput, BaseMessage]]."""
    import asyncio
    
    # Define a simple tool
    def dummy_tool(query: str) -> str:
        return f"Result for {query}"
    
    tools = [dummy_tool]
    
    # Create a mock BaseChatModel that can be bound with tools
    class MockChatModel(BaseChatModel):
        def _generate(self, messages, **kwargs):
            raise NotImplementedError()
        
        @property
        def _llm_type(self) -> str:
            return "mock"
        
        def bind_tools(self, tools, **kwargs):
            from langchain_core.runnables import RunnableLambda
            
            def invoke_wrapper(input_data):
                from langchain_core.messages import AIMessage
                return AIMessage(content="Mock async response with bound tools")
            
            return RunnableLambda(invoke_wrapper)
    
    # Async dynamic model callable that returns the result of bind_tools
    async def async_dynamic_model(state, runtime):
        model = MockChatModel()
        # This returns Runnable[LanguageModelInput, BaseMessage], not BaseChatModel
        return model.bind_tools(tools)
    
    # This should work with the fixed type annotations
    # In buggy code, this raises a type error because async_dynamic_model returns Awaitable[Runnable], not Awaitable[BaseChatModel]
    agent = create_react_agent(
        model=async_dynamic_model,
        tools=tools,
        checkpointer=None,
    )
    
    # Verify the agent is created successfully
    assert agent is not None
    assert isinstance(agent, StateGraph)
    
    # Build the graph to ensure no runtime errors
    graph = agent.compile()
    assert graph is not None


