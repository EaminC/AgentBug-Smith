    # Simulate bind_tools returning a Runnable[LanguageModelInput, BaseMessage]
    mock_runnable = Mock(spec=Runnable)
    mock_model.bind_tools.return_value = mock_runnable

    # Define a dynamic model callable that returns the bound runnable
    def dynamic_model(state: Any, runtime: Any) -> Runnable[LanguageModelInput, BaseMessage]:
        # In real usage, you'd call model.bind_tools(...)
        # Here we just return the mocked runnable
        return mock_runnable

    # Create the agent with the dynamic model callable
    agent = create_react_agent(
        model=dynamic_model,
        tools=[dummy_tool],
        checkpointer=MemorySaver(),
    )

    # Verify the agent is callable (a StateGraph)
    assert isinstance(agent, StateGraph)

    # Ensure the mock's bind_tools was called (or at least that the dynamic model is used)
    # The actual invocation happens inside create_react_agent, but we can verify
    # that the agent compiles without type errors.
    compiled = agent.compile()
    assert compiled is not None


def test_create_react_agent_with_async_bind_tools_return_type():
    """Test that create_react_agent accepts an async dynamic model callable returning an Awaitable[Runnable[...]]."""
    from asyncio import sleep

    @tool
    def dummy_tool(x: int) -> int:
        """A dummy tool."""
        return x * 2

    mock_model = Mock(spec=BaseChatModel)
    mock_runnable = Mock(spec=Runnable)
    mock_model.bind_tools.return_value = mock_runnable

    async def async_dynamic_model(state: Any, runtime: Any) -> Runnable[LanguageModelInput, BaseMessage]:
        await sleep(0)
        return mock_runnable

    agent = create_react_agent(
        model=async_dynamic_model,
        tools=[dummy_tool],
        checkpointer=MemorySaver(),
    )

    assert isinstance(agent, StateGraph)
    compiled = agent.compile()
    assert compiled is not None


def test_create_react_agent_with_bind_tools_actually_used():
    """Test that a dynamic model callable that returns a bound runnable works end‑to‑end."""
    from langchain_core.messages import AIMessage
    from langgraph.graph import END, START
    from langgraph.checkpoint.memory import MemorySaver

    @tool
    def add_one(x: int) -> int:
        """Add one to the input."""
        return x + 1

    # Create a fake chat model that returns a fixed AIMessage
    class FakeChatModel(BaseChatModel):
        def _generate(self, messages, **kwargs):
            from langchain_core.outputs import ChatGeneration, ChatResult
            message = AIMessage(content="42", tool_calls=[])
            return ChatResult(generations=[ChatGeneration(message=message)])

        async def _agenerate(self, messages, **kwargs):
            from langchain_core.outputs import ChatGeneration, ChatResult
            message = AIMessage(content="42", tool_calls=[])
            return ChatResult(generations=[ChatGeneration(message=message)])

        @property
        def _llm_type(self) -> str:
            return "fake"

    fake_model = FakeChatModel()
    # Bind tools to get a Runnable[LanguageModelInput, BaseMessage]
    bound_model = fake_model.bind_tools([add_one])

    # Dynamic callable that returns the bound runnable
    def dynamic_bound(state, runtime):
        return bound_model

    agent = create_react_agent(
        model=dynamic_bound,
        tools=[add_one],
        checkpointer=MemorySaver(),
    )
    graph = agent.compile()

    # Run the graph with a simple input
    config = {"configurable": {"thread_id": "test-thread-1"}}
    result = graph.invoke({"messages": [HumanMessage(content="What is 41+1?")]}, config)

    # The agent should have produced an AIMessage
    assert len(result["messages"]) > 0
    last_msg = result["messages"][-1]
    assert isinstance(last_msg, AIMessage)
    # The content may be "42" or something else, but at least it's an AI message
    assert last_msg.content is not None


