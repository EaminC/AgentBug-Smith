import pytest
from typing import Callable, Awaitable, Any
from langchain_core.tools import BaseTool
from langchain_core.messages import BaseMessage
from langchain_core.runnables import Runnable
from langchain_core.language_models.chat_models import BaseChatModel
from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langgraph.types import StateSchema, Runtime
from langgraph.prebuilt.types import LanguageModelLike, LanguageModelInput


def test_create_react_agent_accepts_bind_tools_return_type() -> None:
    """Test that create_react_agent accepts a dynamic model callable that returns a Runnable[LanguageModelInput, BaseMessage] (result of bind_tools)."""
    # Create a mock tool
    class MockTool(BaseTool):
        name: str = "mock_tool"
        description: str = "A mock tool"
        def _run(self, *args: Any, **kwargs: Any) -> Any:
            return "mock result"

    tools = [MockTool()]

    # Create a mock BaseChatModel that can be bound with tools
    class MockChatModel(BaseChatModel):
        def _generate(self, messages, stop=None, **kwargs):
            raise NotImplementedError
        @property
        def _llm_type(self) -> str:
            return "mock"

    # Simulate a dynamic model callable that returns a Runnable (as bind_tools would)
    def dynamic_model(state: StateSchema, runtime: Runtime) -> Runnable[LanguageModelInput, BaseMessage]:
        # In real usage, this would be something like model.bind_tools(tools)
        # We'll create a minimal Runnable that satisfies the type.
        from langchain_core.runnables import RunnableLambda
        def dummy(input: LanguageModelInput) -> BaseMessage:
            from langchain_core.messages import AIMessage
            return AIMessage(content="dummy")
        return RunnableLambda(dummy)

    # This should pass type checking after the fix.
    # On buggy code, the type annotation expects BaseChatModel, not Runnable.
    # The test will fail on buggy code because mypy/type checker will raise an error,
    # or runtime may raise a validation error if there's a runtime check.
    # We'll just attempt to call create_react_agent with this callable.
    # If the type annotation is too restrictive, the call will be rejected by mypy
    # (if we run with type checking) or by runtime validation.
    # We'll run it and ensure no TypeError is raised.
    try:
        agent = create_react_agent(
            model=dynamic_model,
            tools=tools,
            checkpointer=None,
        )
        # If we get here, the call succeeded. That's fine.
        # We can optionally assert something about the agent.
        assert agent is not None
    except TypeError as e:
        # On buggy code, if there's a runtime type check that expects BaseChatModel,
        # it might raise a TypeError. That would cause the test to fail (which is what we want).
        # But we need to ensure the test fails on buggy code and passes on fixed code.
        # Since the patch only changes type annotations, runtime behavior may not change.
        # However, there might be isinstance checks in the code that could fail.
        # We'll let the exception propagate, causing test failure.
        raise


def test_create_react_agent_accepts_async_bind_tools_return_type() -> None:
    """Test that create_react_agent accepts an async dynamic model callable that returns an Awaitable[Runnable[...]]."""
    class MockTool(BaseTool):
        name: str = "async_mock_tool"
        description: str = "An async mock tool"
        def _run(self, *args: Any, **kwargs: Any) -> Any:
            return "async mock result"

    tools = [MockTool()]

    async def async_dynamic_model(state: StateSchema, runtime: Runtime) -> Runnable[LanguageModelInput, BaseMessage]:
        from langchain_core.runnables import RunnableLambda
        def dummy(input: LanguageModelInput) -> BaseMessage:
            from langchain_core.messages import AIMessage
            return AIMessage(content="async dummy")
        return RunnableLambda(dummy)

    # This should also be accepted after the fix.
    try:
        agent = create_react_agent(
            model=async_dynamic_model,
            tools=tools,
            checkpointer=None,
        )
        assert agent is not None
    except TypeError:
        raise


def test_create_react_agent_with_actual_bind_tools_pattern() -> None:
    """Test a realistic pattern: model.bind_tools() returns Runnable[LanguageModelInput, BaseMessage]."""
    # We'll mock a chat model and its bind_tools method.
    # Since we cannot rely on actual OpenAI API, we'll mock the internal client.
    # But we must not mock the exact function where the bug lives (create_react_agent).
    # Instead, we'll create a fake model class that has bind_tools.
    # However, we need to avoid importing real chat models that require API keys.
    # Use the existing fake_chat module from the repo if available.
    # Let's see if we can import from tests.fake_chat
    try:
        from tests.fake_chat import FakeChatModel
    except ImportError:
        # Fallback: define a minimal fake that satisfies BaseChatModel and has bind_tools.
        from langchain_core.language_models.chat_models import BaseChatModel
        from langchain_core.runnables import RunnableBinding

        class FakeChatModel(BaseChatModel):
            def _generate(self, messages, stop=None, **kwargs):
                raise NotImplementedError
            @property
            def _llm_type(self) -> str:
                return "fake"
            def bind_tools(self, tools, **kwargs):
                # Return a RunnableBinding (which is a Runnable[LanguageModelInput, BaseMessage])
                # We'll create a simple RunnableLambda.
                from langchain_core.runnables import RunnableLambda
                from langchain_core.messages import AIMessage
                def inner(input):
                    return AIMessage(content="bound")
                return RunnableLambda(inner)

        model = FakeChatModel()
    else:
        model = FakeChatModel()

    class MockTool(BaseTool):
        name: str = "real_tool"
        description: str = "A tool"
        def _run(self, *args: Any, **kwargs: Any) -> Any:
            return "real"

    tools = [MockTool()]

    # Dynamic model callable that returns the result of bind_tools
    def dynamic_model_with_bind_tools(state: StateSchema, runtime: Runtime) -> Runnable[LanguageModelInput, BaseMessage]:
        # This is the pattern that should be allowed after the fix.
        return model.bind_tools(tools)

    # On buggy code, the type annotation expects BaseChatModel, not Runnable.
    # The call may raise a TypeError or mypy error.
    # We'll let the test run and see if it passes.
    agent = create_react_agent(
        model=dynamic_model_with_bind_tools,
        tools=tools,
        checkpointer=None,
    )
    assert agent is not None


if __name__ == "__main__":
    # Allow running with python directly
    pytest.main([__file__, "-v"])[0m
