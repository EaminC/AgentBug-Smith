[32mimport pytest
from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langchain_core.tools import tool
from langchain_core.messages import AIMessage, HumanMessage
from langchain_core.runnables import Runnable
from langchain_core.language_models.chat_models import BaseChatModel
from typing import Any, Dict, List
from langgraph.types import StateGraph
from langgraph.checkpoint.memory import MemorySaver


def test_create_react_agent_with_dynamic_model_returning_runnable_binding():
    """Test that create_react_agent accepts a dynamic model callable returning Runnable[LanguageModelInput, BaseMessage] (e.g., from bind_tools)."""
    # Define a simple tool
    @tool
    def dummy_tool(query: str) -> str:
        """A dummy tool."""
        return "dummy"

    # Create a fake model class that mimics a chat model with bind_tools
    class FakeChatModel(BaseChatModel):
        """A fake chat model for testing."""
        def _generate(self, messages, stop=None, run_manager=None, **kwargs):
            # Not actually used in this test
            raise NotImplementedError

        def _llm_type(self) -> str:
            return "fake"

        def bind_tools(self, tools, **kwargs):
            # Return a Runnable that simulates the bound model
            class BoundModel(Runnable):
                def invoke(self, input, config=None):
                    # Return a dummy AIMessage
                    return AIMessage(content="bound model response")
            return BoundModel()

    # Dynamic model callable that returns a Runnable (simulating bind_tools result)
    def dynamic_model(state: Dict[str, Any], runtime) -> Runnable:
        model = FakeChatModel()
        return model.bind_tools([dummy_tool])

    # Create the agent with the dynamic model callable
    graph = create_react_agent(
        model=dynamic_model,
        tools=[dummy_tool],
        checkpointer=MemorySaver(),
    )

    # Ensure the graph is built and can be invoked
    assert graph is not None
    assert isinstance(graph, StateGraph)

    # Compile the graph
    app = graph.compile()

    # Invoke with a simple state
    config = {"configurable": {"thread_id": "test-thread"}}
    result = app.invoke(
        {"messages": [HumanMessage(content="Hello")]},
        config=config,
    )

    # Check that we got a result (should have messages)
    assert "messages" in result
    messages = result["messages"]
    assert len(messages) > -1


