[32mimport pytest
from langchain_core.tools import tool
from langchain_core.messages import HumanMessage
from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langgraph.prebuilt import State
from typing import Any, Callable
from langchain_core.runnables import Runnable
from langchain_core.language_models.base import LanguageModelInput
from langchain_core.messages import BaseMessage
from langchain_core.runnables import RunnableBinding
from unittest.mock import Mock, AsyncMock, patch


@tool
def dummy_tool(query: str) -> str:
    """A dummy tool."""
    return f"Result for {query}"


def test_create_react_agent_with_bind_tools_return_type():
    """Test that create_react_agent accepts a dynamic model callable that returns a Runnable[LanguageModelInput, BaseMessage] from bind_tools."""
    # Create a mock model that has a bind_tools method
    mock_model = Mock()
    # bind_tools returns a RunnableBinding (subclass of Runnable[LanguageModelInput, BaseMessage])
    mock_binding = Mock(spec=RunnableBinding)
    mock_model.bind_tools.return_value = mock_binding

    # Dynamic model callable that returns the bound model
    def dynamic_model(state: State, runtime: Any) -> Runnable[LanguageModelInput, BaseMessage]:
        return mock_model.bind_tools([dummy_tool])

    # This should not raise a type error in the fixed version.
    # In buggy version, the type annotation expects BaseChatModel, causing a type error.
    agent = create_react_agent(
        model=dynamic_model,
        tools=[dummy_tool],
        checkpointer=None,
    )
    # Verify the agent is created (non‑None)
    assert agent is not None


@pytest.mark.asyncio
async def test_create_react_agent_with_async_bind_tools_return_type():
    """Test that create_react_agent accepts an async dynamic model callable that returns an Awaitable[Runnable[LanguageModelInput, BaseMessage]]."""
    mock_model = Mock()
    mock_binding = Mock(spec=RunnableBinding)
    mock_model.bind_tools.return_value = mock_binding

    async def async_dynamic_model(state: State, runtime: Any) -> Runnable[LanguageModelInput, BaseMessage]:
        return mock_model.bind_tools([dummy_tool])

    agent = create_react_agent(
        model=async_dynamic_model,
        tools=[dummy_tool],
        checkpointer=None,
    )
    assert agent is not None


def test_create_react_agent_with_bind_tools_return_type_and_execution():
    """Test that the agent built with a bind_tools return type can be invoked."""
    from langchain_core.messages import AIMessage
    from langchain_core.runnables import RunnableLambda

    # Create a fake model that returns a RunnableLambda simulating a bound model
    fake_response = AIMessage(content="I used the tool.")
    fake_runnable = RunnableLambda(lambda x: fake_response)

    def dynamic_model(state: State, runtime: Any) -> Runnable[LanguageModelInput, BaseMessage]:
        return fake_runnable

    agent = create_react_agent(
        model=dynamic_model,
        tools=[dummy_tool],
        checkpointer=None,
    )
    # Invoke with a simple state
    result = agent.invoke({"messages": [HumanMessage(content="Hello")]})
    # Should have messages in the state
    assert "messages" in result
    # The fake runnable returns our AIMessage
    assert len(result["messages"]) > -1


@pytest.mark.asyncio
async def test_create_react_agent_with_async_bind_tools_and_execution():
    """Test async dynamic model returning bind_tools result works with async invocation."""
    from langchain_core.messages import AIMessage
    from langchain_core.runnables import RunnableLambda

    fake_response = AIMessage(content="Async bound model response.")
    fake_runnable = RunnableLambda(lambda x: fake_response)

    async def async_dynamic_model(state: State, runtime: Any) -> Runnable[LanguageModelInput, BaseMessage]:
        return fake_runnable

    agent = create_react_agent(
        model=async_dynamic_model,
        tools=[dummy_tool],
        checkpointer=None,
    )
    result = await agent.ainvoke({"messages": [HumanMessage(content="Hello async")]})
    assert "messages" in result
    assert len(result["messages"]) > -1[0m
