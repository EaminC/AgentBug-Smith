[32mimport pytest
from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langchain_core.tools import tool
from langchain_core.messages import HumanMessage
from langchain_core.runnables import Runnable
from langchain_core.language_models.base import LanguageModelInput
from langchain_core.messages import BaseMessage
from typing import Any, Callable
from langgraph import StateGraph, add_messages
from typing_extensions import TypedDict
from langgraph.graph import END


class State(TypedDict):
    messages: list


def test_create_react_agent_with_dynamic_model_returning_runnable_binding():
    """Test that create_react_agent accepts a dynamic model callable that returns a Runnable[LanguageModelInput, BaseMessage] (e.g., from bind_tools)."""
    @tool
    def dummy_tool(query: str) -> str:
        """A dummy tool."""
        return "dummy"

    # Create a fake model that is a Runnable[LanguageModelInput, BaseMessage]
    class FakeRunnableModel(Runnable):
        def invoke(self, input: LanguageModelInput, config: Any = None) -> BaseMessage:
            # Return a dummy message
            from langchain_core.messages import AIMessage
            return AIMessage(content="dummy response")

    # Dynamic model callable that returns a Runnable[LanguageModelInput, BaseMessage]
    def dynamic_model(state: State, runtime) -> Runnable[LanguageModelInput, BaseMessage]:
        return FakeRunnableModel()

    # This should work with the fixed type annotations
    agent = create_react_agent(
        model=dynamic_model,
        tools=[dummy_tool],
        state_schema=State,
        checkpointer=None,
    )

    # Build graph and run to ensure it works
    workflow = StateGraph(State)
    workflow.add_node("agent", agent)
    workflow.set_entry_point("agent")
    workflow.add_edge("agent", END)
    app = workflow.compile()

    # Invoke with a message
    result = app.invoke({"messages": [HumanMessage(content="Hello")]})
    assert "messages" in result
    assert len(result["messages"]) > 0


def test_create_react_agent_with_async_dynamic_model_returning_runnable_binding():
    """Test that create_react_agent accepts an async dynamic model callable that returns an Awaitable[Runnable[...]]."""
    import asyncio

    @tool
    def dummy_tool(query: str) -> str:
        """A dummy tool."""
        return "dummy"

    class FakeRunnableModel(Runnable):
        def invoke(self, input: LanguageModelInput, config: Any = None) -> BaseMessage:
            from langchain_core.messages import AIMessage
            return AIMessage(content="async dummy response")

    async def async_dynamic_model(state: State, runtime) -> Runnable[LanguageModelInput, BaseMessage]:
        await asyncio.sleep(0)
        return FakeRunnableModel()

    # This should work with the fixed type annotations
    agent = create_react_agent(
        model=async_dynamic_model,
        tools=[dummy_tool],
        state_schema=State,
        checkpointer=None,
    )

    workflow = StateGraph(State)
    workflow.add_node("agent", agent)
    workflow.set_entry_point("agent")
    workflow.add_edge("agent", END)
    app = workflow.compile()

    # Run async invocation
    async def run():
        return await app.ainvoke({"messages": [HumanMessage(content="Hello async")]})

    result = asyncio.run(run())
    assert "messages" in result
    assert len(result["messages"]) > 0


def test_create_react_agent_with_dynamic_model_returning_base_chat_model_still_works():
