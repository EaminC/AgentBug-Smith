from typing import Any, Callable, Awaitable
from langgraph import StateGraph
from langgraph.checkpoint.memory import MemorySaver


@tool
def dummy_tool(query: str) -> str:
    """A dummy tool."""
    return f"Processed: {query}"


class MockChatModel(BaseChatModel):
    """Mock chat model that returns a fixed message."""

    def _generate(self, messages, **kwargs):
        from langchain_core.outputs import ChatGeneration, ChatResult
        from langchain_core.messages import AIMessage

        message = AIMessage(content="Mock response")
        generation = ChatGeneration(message=message)
        return ChatResult(generations=[generation])

    def bind_tools(self, tools, **kwargs):
        # Return a Runnable that mimics the behavior of bind_tools
        from langchain_core.runnables import RunnableLambda

        def invoke_wrapper(inputs, **kwargs):
            return self._generate([HumanMessage(content=str(inputs))], **kwargs).generations[0].message

        return RunnableLambda(invoke_wrapper)

    @property
    def _llm_type(self):
        return "mock"


def test_create_react_agent_with_bind_tools_return_type():
    """Test that create_react_agent accepts a dynamic model callable that returns a Runnable from bind_tools."""
