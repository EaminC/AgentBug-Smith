[32mimport pytest
from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langchain_core.tools import tool
from langchain_core.messages import HumanMessage
from langchain_core.runnables import Runnable
from langchain_core.language_models import BaseChatModel
from typing import Any, Callable
from langgraph import StateGraph
from langgraph.graph import MessagesState


def test_create_react_agent_with_bind_tools_return_type():
    """Test that create_react_agent accepts a dynamic model callable that returns a Runnable[LanguageModelInput, BaseMessage] (e.g., from bind_tools)."""
    # Define a simple tool
    @tool
    def dummy_tool(x: int) -> int:
        """Dummy tool."""
        return x

    # Create a mock BaseChatModel that can be bound with tools
    # We'll mock the internal model client to avoid needing real API keys
    # Use a simple fake class that mimics the behavior
    class MockChatModel(BaseChatModel):
        def bind_tools(self, tools):
            # Return a Runnable that just passes through
            from langchain_core.runnables import RunnableLambda
            return RunnableLambda(lambda x: x)

        def _generate(self, messages, stop=None, **kwargs):
            raise NotImplementedError

        async def _agenerate(self, messages, stop=None, **kwargs):
            raise NotImplementedError

        @property
        def _llm_type(self):
            return "mock"

    # Dynamic model callable that returns a Runnable (as bind_tools would)
    def dynamic_model(state: MessagesState, runtime) -> Runnable:
        model = MockChatModel()
        # Simulate bind_tools returning Runnable[LanguageModelInput, BaseMessage]
        return model.bind_tools([dummy_tool])

    # Create the agent with the dynamic model callable
    # This should work with the fixed type annotations
    graph = create_react_agent(
        model=dynamic_model,
        tools=[dummy_tool],
        checkpointer=None,
    )

    # Verify the graph is built correctly
    assert isinstance(graph, StateGraph)
    # The graph should have nodes like "agent", "tools", etc.
    # We can check that the graph can be compiled
    app = graph.compile()
    # Ensure it's callable
    assert callable(app)

    # Test a simple invocation with mocked model execution
    # We need to intercept the actual model call to avoid NotImplementedError
    # Patch the internal model client's invoke method
    import langchain_core.runnables.base
    original_invoke = langchain_core.runnables.base.Runnable.invoke

    def mock_invoke(self, input, config=None):
        # If it's the mocked model's bound runnable, return a dummy message
        from langchain_core.messages import AIMessage
        if isinstance(input, dict) and "messages" in input:
            return {"messages": [AIMessage(content="Mock response")]}
        return original_invoke(self, input, config)

    # Temporarily replace the invoke method
    langchain_core.runnables.base.Runnable.invoke = mock_invoke
    try:
        result = app.invoke({"messages": [HumanMessage(content="Hello")]})
        assert "messages" in result
        # Should have at least the AI response
        assert len(result["messages"]) > 0
    finally:
        langchain_core.runnables.base.Runnable.invoke = original_invoke


def test_create_react_agent_with_async_bind_tools_return_type():
    """Test that create_react_agent accepts an async dynamic model callable that returns an Awaitable[Runnable[...]]."""
    from asyncio import sleep
    from langchain_core.tools import tool
    from langchain_core.runnables import Runnable

    @tool
    def async_tool(x: str) -> str:
        """Async dummy tool."""
        return x

    class AsyncMockChatModel(BaseChatModel):
        def bind_tools(self, tools):
            from langchain_core.runnables import RunnableLambda
            return RunnableLambda(lambda x: x)

        def _generate(self, messages, stop=None, **kwargs):
            raise NotImplementedError

        async def _agenerate(self, messages, stop=None, **kwargs):
            raise NotImplementedError

        @property
        def _llm_type(self):
            return "async_mock"

    async def async_dynamic_model(state: MessagesState, runtime) -> Runnable:
        await sleep(0)
        model = AsyncMockChatModel()
        return model.bind_tools([async_tool])

    # This should be accepted by the fixed type annotations
    graph = create_react_agent(
        model=async_dynamic_model,
        tools=[async_tool],
        checkpointer=None,
    )
    assert isinstance(graph, StateGraph)
    app = graph.compile()
    assert callable(app)

    # Test async invocation
    import asyncio
    import langchain_core.runnables.base
    original_ainvoke = langchain_core.runnables.base.Runnable.ainvoke

    async def mock_ainvoke(self, input, config=None):
        from langchain_core.messages import AIMessage
        if isinstance(input, dict) and "messages" in input:
            return {"messages": [AIMessage(content="Async mock response")]}
        return await original_ainvoke(self, input, config)

    langchain_core.runnables.base.Runnable.ainvoke = mock_ainvoke
    try:
        async def run_test():
            result = await app.ainvoke({"messages": [HumanMessage(content="Hello async")]})
            assert "messages" in result
            assert len(result["messages"]) > 0
        asyncio.run(run_test())
    finally:
        langchain_core.runnables.base.Runnable.ainvoke = original_ainvoke


def test_create_react_agent_with_plain_model_still_works():
    """Ensure backward compatibility: plain BaseChatModel still works."""
    from langchain_core.tools import tool

    @tool
    def simple_tool() -> str:
        return "ok"

    class PlainChatModel(BaseChatModel):
        def _generate(self, messages, stop=None, **kwargs):
            raise NotImplementedError

        async def _agenerate(self, messages, stop=None, **kwargs):
            raise NotImplementedError

        @property
        def _llm_type(self):
            return "plain"

    plain_model = PlainChatModel()
    graph = create_react_agent(
        model=plain_model,
        tools=[simple_tool],
        checkpointer=None,
    )
    assert isinstance(graph, StateGraph)
    # Should compile without error
    app = graph.compile()
    assert callable(app)


