[32mimport pytest
from typing import Any, Callable, Sequence
from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langgraph.graph import StateGraph
from langchain_core.tools import BaseTool
from langchain_core.runnables import Runnable
from langchain_core.language_models import BaseChatModel
from langchain_core.messages import BaseMessage
from langgraph.types import LanguageModelLike, LanguageModelInput
from langgraph.runtime import Runtime
from langgraph.checkpoint.memory import MemorySaver
from langgraph.graph.state import State


def test_create_react_agent_accepts_bind_tools_return_type() -> None:
    """Test that create_react_agent accepts a dynamic model callable that returns a Runnable[LanguageModelInput, BaseMessage] (e.g., from bind_tools)."""

    # Define a simple tool
    class DummyTool(BaseTool):
        name: str = "dummy"
        description: str = "A dummy tool"
        def _run(self, *args: Any, **kwargs: Any) -> Any:
            return "dummy"

    # Create a fake chat model that can be bound
    class FakeChatModel(BaseChatModel):
        def _generate(self, messages, **kwargs):
            from langchain_core.outputs import ChatResult, ChatGeneration
            from langchain_core.messages import AIMessage
            return ChatResult(generations=[ChatGeneration(message=AIMessage(content="hi"))])

        @property
        def _llm_type(self) -> str:
            return "fake"

        def bind_tools(self, tools, **kwargs):
            # Return a Runnable that mimics the bound model
            from langchain_core.runnables import RunnableLambda
            from langchain_core.messages import AIMessage
            def invoke_wrapper(input: LanguageModelInput, **kwargs):
                return AIMessage(content="bound response")
            return RunnableLambda(invoke_wrapper)

    fake_model = FakeChatModel()

    # Dynamic model callable that returns a Runnable (as bind_tools would)
    def dynamic_model(state: State, runtime: Runtime) -> Runnable[LanguageModelInput, BaseMessage]:
        # In real usage, you might bind tools based on state/runtime
        return fake_model.bind_tools([DummyTool()])

    # This should not raise a type error after the fix.
    # Before the fix, the type annotation required BaseChatModel, not Runnable.
    graph = create_react_agent(
        model=dynamic_model,
        tools=[DummyTool()],
        checkpointer=MemorySaver(),
    )
    assert isinstance(graph, StateGraph)


def test_create_react_agent_accepts_async_bind_tools_return_type() -> None:
    """Test that create_react_agent accepts an async dynamic model callable that returns an Awaitable[Runnable[...]]."""

    class DummyTool(BaseTool):
        name: str = "dummy"
        description: str = "A dummy tool"
        def _run(self, *args: Any, **kwargs: Any) -> Any:
            return "dummy"

    class FakeChatModel(BaseChatModel):
        def _generate(self, messages, **kwargs):
            from langchain_core.outputs import ChatResult, ChatGeneration
            from langchain_core.messages import AIMessage
            return ChatResult(generations=[ChatGeneration(message=AIMessage(content="hi"))])

        @property
        def _llm_type(self) -> str:
            return "fake"

        def bind_tools(self, tools, **kwargs):
            from langchain_core.runnables import RunnableLambda
            from langchain_core.messages import AIMessage
            def invoke_wrapper(input: LanguageModelInput, **kwargs):
                return AIMessage(content="bound async")
            return RunnableLambda(invoke_wrapper)

    fake_model = FakeChatModel()

    async def async_dynamic_model(state: State, runtime: Runtime) -> Runnable[LanguageModelInput, BaseMessage]:
        # Simulate async operation
        return fake_model.bind_tools([DummyTool()])

    # Should not raise type error after fix.
    graph = create_react_agent(
        model=async_dynamic_model,
        tools=[DummyTool()],
        checkpointer=MemorySaver(),
    )
    assert isinstance(graph, StateGraph)


def test_create_react_agent_accepts_base_chat_model_still_works() -> None:
    """Ensure backward compatibility: dynamic model returning BaseChatModel still works."""

    class DummyTool(BaseTool):
        name: str = "dummy"
        description: str = "A dummy tool"
        def _run(self, *args: Any, **kwargs: Any) -> Any:
            return "dummy"

    class FakeChatModel(BaseChatModel):
        def _generate(self, messages, **kwargs):
            from langchain_core.outputs import ChatResult, ChatGeneration
            from langchain_core.messages import AIMessage
            return ChatResult(generations=[ChatGeneration(message=AIMessage(content="hi"))])

        @property
        def _llm_type(self) -> str:
            return "fake"

    fake_model = FakeChatModel()

    def dynamic_model(state: State, runtime: Runtime) -> BaseChatModel:
        return fake_model

    graph = create_react_agent(
        model=dynamic_model,
        tools=[DummyTool()],
        checkpointer=MemorySaver(),
    )
    assert isinstance(graph, StateGraph)


def test_create_react_agent_accepts_language_model_like_static() -> None:
    """Test that a static LanguageModelLike (e.g., a bound model) is accepted."""

    class DummyTool(BaseTool):
        name: str = "dummy"
        description: str = "A dummy tool"
        def _run(self, *args: Any, **kwargs: Any) -> Any:
            return "dummy"

    class FakeChatModel(BaseChatModel):
        def _generate(self, messages, **kwargs):
            from langchain_core.outputs import ChatResult, ChatGeneration
            from langchain_core.messages import AIMessage
            return ChatResult(generations=[ChatGeneration(message=AIMessage(content="hi"))])

        @property
        def _llm_type(self) -> str:
            return "fake"

        def bind_tools(self, tools, **kwargs):
            from langchain_core.runnables import RunnableLambda
            from langchain_core.messages import AIMessage
            def invoke_wrapper(input: LanguageModelInput, **kwargs):
                return AIMessage(content="bound static")
            return RunnableLambda(invoke_wrapper)

    fake_model = FakeChatModel()
    bound_model = fake_model.bind_tools([DummyTool()])

    # Should accept LanguageModelLike directly (which includes Runnable[LanguageModelInput, BaseMessage])
    graph = create_react_agent(
        model=bound_model,
        tools=[DummyTool()],
        checkpointer=MemorySaver(),
    )
    assert isinstance(graph, StateGraph)[0m
