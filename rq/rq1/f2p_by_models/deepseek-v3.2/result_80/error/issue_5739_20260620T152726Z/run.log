[32mimport pytest
from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langchain_core.tools import tool
from langchain_core.messages import HumanMessage
from langchain_core.runnables import Runnable
from langchain_core.language_models import BaseChatModel
from typing import Any, Callable
from langgraph import StateGraph
from langgraph.graph import END


def test_create_react_agent_with_bind_tools_return_type():
    """Test that create_react_agent accepts a dynamic model callable that returns a Runnable[LanguageModelInput, BaseMessage] (e.g., from bind_tools)."""
    # Define a simple tool
    @tool
    def dummy_tool() -> str:
        """A dummy tool."""
        return "dummy"

    # Create a mock BaseChatModel that returns a Runnable when bind_tools is called
    class MockChatModel(BaseChatModel):
        def _generate(self, messages, **kwargs):
            raise NotImplementedError("Should not be called in this test")

        def bind_tools(self, tools, **kwargs):
            # Return a Runnable that mimics the return type of bind_tools
            class MockRunnable(Runnable):
                def invoke(self, input, config=None):
                    # Return a dummy message
                    from langchain_core.messages import AIMessage
                    return AIMessage(content="dummy")

            return MockRunnable()

        @property
        def _llm_type(self):
            return "mock"

    # Dynamic model callable that returns a Runnable (as bind_tools would)
    def dynamic_model_callable(state, runtime):
        model = MockChatModel()
        # This returns Runnable[LanguageModelInput, BaseMessage]
        return model.bind_tools([dummy_tool])

    # Create the agent with the dynamic callable
    agent = create_react_agent(
        model=dynamic_model_callable,
        tools=[dummy_tool],
        name="test_agent",
    )

    # Build a simple graph to verify it works
    graph = StateGraph()
    graph.add_node("agent", agent)
    graph.set_entry_point("agent")
    graph.add_edge("agent", END)
    runnable = graph.compile()

    # Invoke with a simple state
    result = runnable.invoke({"messages": [HumanMessage(content="hello")]})
    assert "messages" in result
    # Should have added an AIMessage
    assert len(result["messages"]) == 2
    assert result["messages"][-1].content == "dummy"


def test_create_react_agent_with_async_bind_tools_return_type():
    """Test that create_react_agent accepts an async dynamic model callable that returns an Awaitable[Runnable[...]]."""
    import asyncio

    @tool
    def dummy_tool() -> str:
        """A dummy tool."""
        return "dummy"

    class MockChatModel(BaseChatModel):
        def _generate(self, messages, **kwargs):
            raise NotImplementedError("Should not be called in this test")

        def bind_tools(self, tools, **kwargs):
            class MockRunnable(Runnable):
                def invoke(self, input, config=None):
                    from langchain_core.messages import AIMessage
                    return AIMessage(content="async dummy")

            return MockRunnable()

        @property
        def _llm_type(self):
            return "mock"

    async def async_dynamic_model_callable(state, runtime):
        await asyncio.sleep(0)
        model = MockChatModel()
        return model.bind_tools([dummy_tool])

    agent = create_react_agent(
        model=async_dynamic_model_callable,
        tools=[dummy_tool],
        name="test_async_agent",
    )

    graph = StateGraph()
    graph.add_node("agent", agent)
    graph.set_entry_point("agent")
    graph.add_edge("agent", END)
    runnable = graph.compile()

    # Run synchronously (the agent's internal handling should work)
    result = runnable.invoke({"messages": [HumanMessage(content="hello")]})
    assert "messages" in result
    assert len(result["messages"]) == 2
    assert result["messages"][-1].content == "async dummy"


def test_create_react_agent_with_direct_chat_model_still_works():
    """Ensure backward compatibility: direct BaseChatModel still works."""
    from langchain_core.messages import AIMessage

    @tool
    def dummy_tool() -> str:
        return "dummy"

    class DirectChatModel(BaseChatModel):
        def _generate(self, messages, **kwargs):
            from langchain_core.outputs import ChatGeneration, ChatResult
            return ChatResult(generations=[ChatGeneration(message=AIMessage(content="direct"))])

        @property
        def _llm_type(self):
            return "direct"

    agent = create_react_agent(
        model=DirectChatModel(),
        tools=[dummy_tool],
        name="direct_agent",
    )

    graph = StateGraph()
    graph.add_node("agent", agent)
    graph.set_entry_point("agent")
    graph.add_edge("agent", END)
    runnable = graph.compile()

    result = runnable.invoke({"messages": [HumanMessage(content="hello")]})
    assert "messages" in result
    assert result["messages"][-1].content == "direct"[0m
