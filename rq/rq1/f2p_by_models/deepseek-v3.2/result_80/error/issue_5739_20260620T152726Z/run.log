[32mimport sys
import pytest
from typing import Any, Callable, Sequence, Union, Awaitable
from unittest.mock import MagicMock, AsyncMock, patch
from langchain_core.tools import BaseTool
from langchain_core.messages import BaseMessage
from langchain_core.language_models import BaseChatModel
from langchain_core.runnables import Runnable
from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langgraph.types import LanguageModelLike, LanguageModelInput
from langgraph.graph import StateGraph
from langgraph.graph.state import StateSchema
from langgraph.runtime import Runtime


def test_create_react_agent_accepts_bind_tools_return_type() -> None:
    """Test that create_react_agent accepts a dynamic model callable that returns a Runnable[LanguageModelInput, BaseMessage] (e.g., from bind_tools)."""
    # Create a mock tool
    mock_tool = MagicMock(spec=BaseTool)
    mock_tool.name = "test_tool"
    mock_tool.description = "A test tool"

    # Create a mock model that will be bound with tools
    mock_model = MagicMock(spec=BaseChatModel)
    # Simulate bind_tools returning a Runnable[LanguageModelInput, BaseMessage]
    mock_runnable = MagicMock(spec=Runnable)
    mock_model.bind_tools.return_value = mock_runnable

    # Dynamic model callable that returns the result of bind_tools
    def dynamic_model(state: StateSchema, runtime: Runtime) -> Runnable[LanguageModelInput, BaseMessage]:
        # In real usage, you might conditionally bind tools based on state/runtime
        return mock_model.bind_tools([mock_tool])

    # Create the agent with the dynamic model callable
    graph = create_react_agent(
        model=dynamic_model,
        tools=[mock_tool],
        name="TestAgent",
    )

    # Verify the graph is created (no type error)
    assert isinstance(graph, StateGraph)


@pytest.mark.asyncio
async def test_create_react_agent_accepts_async_bind_tools_return_type() -> None:
    """Test that create_react_agent accepts an async dynamic model callable that returns an Awaitable[Runnable[LanguageModelInput, BaseMessage]]."""
    mock_tool = MagicMock(spec=BaseTool)
    mock_tool.name = "test_tool"
    mock_tool.description = "A test tool"

    mock_model = MagicMock(spec=BaseChatModel)
    mock_runnable = MagicMock(spec=Runnable)
    mock_model.bind_tools.return_value = mock_runnable

    async def async_dynamic_model(state: StateSchema, runtime: Runtime) -> Runnable[LanguageModelInput, BaseMessage]:
        return mock_model.bind_tools([mock_tool])

    graph = create_react_agent(
        model=async_dynamic_model,
        tools=[mock_tool],
        name="TestAgent",
    )

    assert isinstance(graph, StateGraph)


