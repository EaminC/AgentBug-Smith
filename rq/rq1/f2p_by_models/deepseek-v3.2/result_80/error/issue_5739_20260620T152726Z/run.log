    # Create a fake chat model that can be bound with tools
    class FakeChatModel(BaseChatModel):
        def _generate(self, messages, stop=None, run_manager=None, **kwargs):
            from langchain_core.outputs import ChatGeneration, ChatResult
            from langchain_core.messages import AIMessage
            return ChatResult(generations=[ChatGeneration(message=AIMessage(content="42"))])

        def bind_tools(self, tools, **kwargs):
            # Return a Runnable that is not a BaseChatModel but a Runnable[LanguageModelInput, BaseMessage]
            # This simulates the real behavior of bind_tools
            from langchain_core.runnables import RunnableLambda
            def fake_invoke(input: LanguageModelInput, **kwargs) -> BaseMessage:
                from langchain_core.messages import AIMessage
                return AIMessage(content="bound model response")
            return RunnableLambda(fake_invoke)

        @property
        def _llm_type(self) -> str:
            return "fake"

    # Dynamic model callable that returns a Runnable (as bind_tools would)
    def dynamic_model(state: Any, runtime: Any) -> Runnable[LanguageModelInput, BaseMessage]:
        model = FakeChatModel()
        # This returns a Runnable, not a BaseChatModel
        return model.bind_tools([dummy_tool])

    # Should not raise a type error in buggy version; but mypy would complain.
    # We test that the function can be called and the agent built.
    graph = create_react_agent(
        model=dynamic_model,
        tools=[dummy_tool],
        state_schema=dict,
    )
    assert graph is not None
    # Ensure it's a StateGraph
    assert isinstance(graph, StateGraph)

def test_create_react_agent_with_async_bind_tools_return_type():
    """Test that create_react_agent accepts an async dynamic model callable that returns an Awaitable[Runnable[...]]."""
    @tool
    def dummy_tool(x: int) -> int:
        """Dummy tool."""
        return x * 2

    class FakeChatModel(BaseChatModel):
        def _generate(self, messages, stop=None, run_manager=None, **kwargs):
            from langchain_core.outputs import ChatGeneration, ChatResult
            from langchain_core.messages import AIMessage
            return ChatResult(generations=[ChatGeneration(message=AIMessage(content="42"))])

        def bind_tools(self, tools, **kwargs):
            from langchain_core.runnables import RunnableLambda
            def fake_invoke(input: LanguageModelInput, **kwargs) -> BaseMessage:
                from langchain_core.messages import AIMessage
                return AIMessage(content="bound async model response")
            return RunnableLambda(fake_invoke)

        @property
        def _llm_type(self) -> str:
            return "fake"

    async def async_dynamic_model(state: Any, runtime: Any) -> Runnable[LanguageModelInput, BaseMessage]:
        model = FakeChatModel()
        return model.bind_tools([dummy_tool])

    graph = create_react_agent(
        model=async_dynamic_model,
        tools=[dummy_tool],
        state_schema=dict,
    )
    assert graph is not None
    assert isinstance(graph, StateGraph)

def test_create_react_agent_with_bind_tools_actually_works():
    """Integration test: create an agent with a bound model and run it."""
    from langchain_core.runnables import RunnableLambda
    from langchain_core.messages import AIMessage

    @tool
    def add_one(x: int) -> int:
        """Add one to the input."""
        return x + 1

    # Create a fake model that returns a Runnable (bound model)
    class FakeModel(BaseChatModel):
        def _generate(self, messages, stop=None, run_manager=None, **kwargs):
            from langchain_core.outputs import ChatGeneration, ChatResult
            return ChatResult(generations=[ChatGeneration(message=AIMessage(content="thinking"))])

        def bind_tools(self, tools, **kwargs):
            # Return a Runnable that mimics a bound model
            def bound_invoke(input: LanguageModelInput, **kwargs) -> BaseMessage:
                # In a real scenario, the bound model would handle tool calls.
                # For simplicity, we just return an AIMessage.
                return AIMessage(content="I can use tools", tool_calls=[])
            return RunnableLambda(bound_invoke)

        @property
        def _llm_type(self) -> str:
            return "fake"

    def dynamic_bound_model(state, runtime):
        model = FakeModel()
        return model.bind_tools([add_one])

    # This should succeed after the fix; before the fix, type annotations would reject.
    graph_builder = create_react_agent(
        model=dynamic_bound_model,
        tools=[add_one],
        state_schema=dict,
    )
    # Compile with a memory checkpointer
    memory = MemorySaver()
    app = graph_builder.compile(checkpointer=memory)
    # Invoke with a simple message
    config = {"configurable": {"thread_id": "test-thread"}}
    # The agent should process without type errors.
    # We don't need to assert the exact output, just that it runs.
    result = app.invoke({"messages": [HumanMessage(content="hello")]}, config=config)
    assert "messages" in result
    # At least one message added
    assert len(result["messages"]) > 0[0m
