class MockRunnable(Runnable[LanguageModelInput, BaseMessage]):
    def invoke(self, input: LanguageModelInput, config=None, **kwargs):
        raise NotImplementedError
    async def ainvoke(self, input: LanguageModelInput, config=None, **kwargs):
        raise NotImplementedError

def test_create_react_agent_with_dynamic_model_returning_runnable():
    """Test that create_react_agent accepts a dynamic model callable returning Runnable[LanguageModelInput, BaseMessage]."""
    # Create a mock tool
    mock_tool = Mock(spec=BaseTool)
    mock_tool.name = "test_tool"
    mock_tool.description = "A test tool"
    mock_tool.args_schema = None
    mock_tool.func = lambda x: x

    # Create a mock model that will be bound
    mock_model = MockChatModel()
    # Simulate bind_tools returning a Runnable
    bound_runnable = MockRunnable()

    # Dynamic model callable that returns a Runnable (as bind_tools would)
    def dynamic_model(state, runtime):
        return bound_runnable

    # This should work with the fixed type annotations
    graph = create_react_agent(
        model=dynamic_model,
        tools=[mock_tool],
        checkpointer=MemorySaver(),
    )

    assert isinstance(graph, StateGraph)

