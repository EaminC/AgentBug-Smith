[32mimport pytest
from langchain_core.tools import tool
from langchain_core.messages import HumanMessage
from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langgraph.graph import StateGraph
from typing import TypedDict, Annotated, Sequence
from langchain_core.messages import BaseMessage
import operator


class State(TypedDict):
    messages: Annotated[Sequence[BaseMessage], operator.add]


def test_create_react_agent_with_dynamic_model_returning_bind_tools():
    """Test that create_react_agent accepts a dynamic model callable that returns a Runnable[LanguageModelInput, BaseMessage] (e.g., from bind_tools)."""

    # Define a simple tool
    @tool
    def dummy_tool():
        """A dummy tool."""
        return "dummy"

    # Create a fake model that mimics a BaseChatModel with bind_tools
    class FakeModel:
        def bind_tools(self, tools):
            # Return a Runnable-like object (not a BaseChatModel)
            # In real usage, bind_tools returns a RunnableBinding which is Runnable[LanguageModelInput, BaseMessage]
            # We'll simulate that with a simple callable that returns a BaseMessage
            def runnable(input_data):
                # This is a minimal stand-in for a Runnable that returns a BaseMessage
                from langchain_core.messages import AIMessage
                return AIMessage(content="fake response")

            runnable.bind_tools = lambda *args, **kwargs: runnable
            return runnable

    fake_model = FakeModel()

    # Dynamic model callable that returns the result of bind_tools
    def dynamic_model(state, runtime):
        # Return a Runnable[LanguageModelInput, BaseMessage] (simulated)
        return fake_model.bind_tools([dummy_tool])

    # Build the agent with the dynamic model callable
    agent = create_react_agent(
        model=dynamic_model,
        tools=[dummy_tool],
        state_schema=State,
    )

    # Ensure it's a StateGraph
    assert isinstance(agent, StateGraph)

    # Verify the agent can be compiled (no type errors)
    graph = agent.compile()
    assert graph is not None

    # Run a simple invocation to ensure no runtime errors
    # We'll mock the actual model execution because we don't have a real LLM.
    # The test passes if the agent is constructed without type errors.
    # Since we can't actually run the fake model through the graph without a real LLM,
    # we'll just check that the graph compiles and has the expected structure.
    assert hasattr(graph, "invoke")


def test_create_react_agent_with_async_dynamic_model_returning_bind_tools():
    """Test that create_react_agent accepts an async dynamic model callable that returns an Awaitable[Runnable[LanguageModelInput, BaseMessage]]."""

    # Define a simple tool
    @tool
    def dummy_tool():
        """A dummy tool."""
        return "dummy"

    # Create a fake model that mimics a BaseChatModel with bind_tools
    class FakeModel:
        def bind_tools(self, tools):
            # Return a Runnable-like object (not a BaseChatModel)
            def runnable(input_data):
                from langchain_core.messages import AIMessage
                return AIMessage(content="fake async response")

            runnable.bind_tools = lambda *args, **kwargs: runnable
            return runnable

    fake_model = FakeModel()

    # Async dynamic model callable that returns the result of bind_tools
    async def async_dynamic_model(state, runtime):
        # Return a Runnable[LanguageModelInput, BaseMessage] (simulated)
        return fake_model.bind_tools([dummy_tool])

    # Build the agent with the async dynamic model callable
    agent = create_react_agent(
        model=async_dynamic_model,
        tools=[dummy_tool],
        state_schema=State,
    )

    assert isinstance(agent, StateGraph)
    graph = agent.compile()
    assert graph is not None
    assert hasattr(graph, "ainvoke")


def test_create_react_agent_with_static_model_bind_tools():
    """Test that create_react_agent accepts a static model that is already a Runnable[LanguageModelInput, BaseMessage] (e.g., from bind_tools)."""

    @tool
    def dummy_tool():
        return "dummy"

    class FakeModel:
        def bind_tools(self, tools):
            def runnable(input_data):
                from langchain_core.messages import AIMessage
                return AIMessage(content="static bind_tools response")

            runnable.bind_tools = lambda *args, **kwargs: runnable
            return runnable

    fake_model = FakeModel()
    # Simulate a model that has already called bind_tools
    bound_model = fake_model.bind_tools([dummy_tool])

    # Pass the bound model directly (static)
    agent = create_react_agent(
        model=bound_model,
        tools=[dummy_tool],
        state_schema=State,
    )

    assert isinstance(agent, StateGraph)
    graph = agent.compile()
    assert graph is not None
    assert hasattr(graph, "invoke")[0m
