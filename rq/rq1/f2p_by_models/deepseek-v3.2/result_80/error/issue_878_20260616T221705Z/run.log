WORKDIR /app

# Install system dependencies for Python packages and MySQL client
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ default-libmysqlclient-dev pkg-config curl && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install poetry for dependency management
RUN pip install poetry

# Copy entire repository (as required)
COPY . .

# Navigate to platform directory
WORKDIR /app/platform

# Install project dependencies with poetry (handle PEP 668 with --break-system-packages)
RUN if [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi; \
    else \
        echo "No poetry.lock found, installing with pip"; \
        pip install --break-system-packages -e .; \
    fi

# Install test dependencies and additional required packages
RUN pip install --break-system-packages pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout \
    anyio "setuptools<=81.0.0" litellm mem0ai

# Install AI framework SDKs explicitly
RUN pip install --break-system-packages langchain openai

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set environment variables for Forge API
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
