RUN python -c 'import tiktoken; print("tiktoken ok")'
RUN python -c 'import langchain; print(f"langchain {langchain.__version__}")'
RUN python -c 'import sys, os, json, requests; print("Standard libraries ok")'

# Set WORKDIR back to repository root for running scripts
WORKDIR /app

# Default command for test harness
CMD ["/bin/bash"][0m
