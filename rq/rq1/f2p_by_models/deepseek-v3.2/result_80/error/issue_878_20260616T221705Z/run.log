def test_create_model_preserves_model_name():
    """Test that create_model correctly sets model_name on WrappedChatOpenAI."""
    user = UserBase(id="test", email="test@example.com")
    settings = ModelSettings(
        model="gpt-3.5-turbo",
        temperature=0.9,
        max_tokens=500,
        language="English",
    )
    
    model = create_model(settings, user, streaming=False)
    
    # In buggy code: get_model_name would convert "gpt-3.5-turbo" to "gpt-3.5-turbo-0613"
    # In fixed code: model_name should be "gpt-3.5-turbo" (no conversion)
    assert model.model_name == "gpt-3.5-turbo"
    assert model.max_tokens == 500


