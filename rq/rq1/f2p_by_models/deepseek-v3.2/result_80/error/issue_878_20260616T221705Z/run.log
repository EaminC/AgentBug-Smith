        # GPT-3.5-turbo max tokens is 4096 per LLM_MODEL_MAX_TOKENS
        # Prompt tokens count will be 100
        agent_service.calculate_max_tokens("dummy prompt")
        # max_allowed_tokens for gpt-3.5-turbo is 4096
        # requested_tokens = 4096 - 100 = 3996
        # min(500, 3996) = 500, so max_tokens should stay 500
        assert mock_model.max_tokens == 500

    def test_calculate_max_tokens_reduces_when_prompt_large(self, agent_service, mock_model):
        """Test that max_tokens is reduced when prompt tokens consume most of the budget."""
        mock_model.max_tokens = 5000  # higher than allowed
        mock_model.model_name = LLM_Model("gpt-3.5-turbo")
        # Simulate a huge prompt that leaves only 100 tokens available
        with patch.object(agent_service.token_service, "count", return_value=3996):
            agent_service.calculate_max_tokens("huge prompt")
            # requested_tokens = 4096 - 3996 = 100
            # min(5000, 100) = 100
            assert mock_model.max_tokens == 100

    def test_calculate_max_tokens_handles_multiple_prompts(self, agent_service, mock_model):
        """Test that token counting sums across multiple prompt strings."""
        mock_model.max_tokens = 2000
        mock_model.model_name = LLM_Model("gpt-3.5-turbo")
        # Each call to count returns 500, total 1000
        with patch.object(agent_service.token_service, "count", side_effect=[500, 500]):
            agent_service.calculate_max_tokens("prompt1", "prompt2")
            # requested_tokens = 4096 - 1000 = 3096
            # min(2000, 3096) = 2000
            assert mock_model.max_tokens == 2000

    def test_calculate_max_tokens_never_goes_below_one(self, agent_service, mock_model):
        """Ensure max_tokens never becomes negative or zero."""
        mock_model.max_tokens = 5000
        mock_model.model_name = LLM_Model("gpt-3.5-turbo")
        # Prompt tokens exceed max allowed, making requested_tokens negative
        with patch.object(agent_service.token_service, "count", return_value=5000):
            agent_service.calculate_max_tokens("excessive prompt")
            # requested_tokens = 4096 - 5000 = -904
            # min(5000, -904) = -904, but OpenAI requires >=1
            # The buggy code would set max_tokens = -904 causing OpenAIError
            # After fix, max_tokens will be -904 (still wrong) but the real bug is that
            # the model's max_tokens should never be negative; the fix ensures we don't subtract
            # beyond the model's limit, but we still need to ensure it's at least 1.
            # However, the actual fix uses min() which could still produce negative.
            # The test will fail on buggy because max_tokens becomes negative.
            # We'll assert that max_tokens is > 0 after the fix.
            assert mock_model.max_tokens > 0

