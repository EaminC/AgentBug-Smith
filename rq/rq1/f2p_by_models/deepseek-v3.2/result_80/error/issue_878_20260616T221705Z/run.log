[32mFROM python:3.11-slim AS test_builder

WORKDIR /app

# Install system dependencies for Python packages and MySQL client
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ default-libmysqlclient-dev pkg-config curl && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository (as required)
COPY . .

# Check for src/ layout to decide whether to editable-install
# If src/ exists or tests import via src., set PYTHONPATH and skip editable install
# Otherwise, do editable install.
RUN if [ -d "platform/src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." platform/tests 2>/dev/null; then \
        echo "src/ layout detected, setting PYTHONPATH and skipping editable install"; \
        export PYTHONPATH=/app/platform; \
        cd platform && \
        pip install --no-cache-dir -r requirements.txt 2>/dev/null || true; \
        pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
        echo "No src/ layout detected, performing editable install"; \
        cd platform && \
        pip install --no-cache-dir -r requirements.txt 2>/dev/null || true; \
        pip install --no-cache-dir -e .; \
        pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Preflight import check
RUN cd platform && python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set environment variables for Forge
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Default command for test harness
CMD ["/bin/bash"]

# Production stage (minimal)
FROM python:3.11-slim AS prod

WORKDIR /app

# Install runtime system dependencies (MySQL client libraries)
RUN apt-get update && apt-get install -y --no-install-recommends \
    default-libmysqlclient-dev pkg-config && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python -m pip install --upgrade pip setuptools wheel

# Copy only the platform directory (production code)
COPY platform/ ./platform/
WORKDIR /app/platform

# Install production dependencies only (no test packages)
RUN if [ -f requirements.txt ]; then \
        pip install --no-cache-dir -r requirements.txt; \
    else \
        pip install --no-cache-dir .; \
    fi

# Set environment variables for Forge (same as test stage)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Expose FastAPI port (from docker-compose)
EXPOSE 8000

# Run the FastAPI app (inference from platform structure)
CMD ["uvicorn", "reworkd_platform.web.api.router:app", "--host", "0.0.0.0", "--port", "8000"][0m
