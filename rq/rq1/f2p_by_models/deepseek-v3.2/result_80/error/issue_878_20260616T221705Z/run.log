    # That's fine.
    # We'll test that max_tokens is >= 1 after calculate_max_tokens.
    service.calculate_max_tokens("prompt")

    # Assert max_tokens is >= 1
    assert mock_model.max_tokens >= 1, f"max_tokens became negative: {mock_model.max_tokens}"


@pytest.mark.asyncio
async def test_start_goal_does_not_cause_negative_max_tokens(
    mock_token_service, mock_model, user, model_settings
):
