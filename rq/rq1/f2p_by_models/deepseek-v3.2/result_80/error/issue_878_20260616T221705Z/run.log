    @pytest.fixture
    def agent_service(self, mock_model, mock_token_service):
        with patch(
            "reworkd_platform.web.api.agent.agent_service.open_ai_agent_service.TokenService",
            return_value=mock_token_service,
        ):
            service = OpenAIAgentService(
                model=mock_model,
                language="English",
                chain=None,
                callbacks=[],
            )
            service.token_service = mock_token_service
            return service

    def test_calculate_max_tokens_positive(self, agent_service, mock_model):
        """Test that max_tokens is reduced but stays positive."""
        # Simulate a token count that leaves room
        agent_service.token_service.count.return_value = 500
        agent_service.calculate_max_tokens("some prompt")
        # max_allowed_tokens for gpt-3.5-turbo is 4000 (from LLM_MODEL_MAX_TOKENS)
        # requested_tokens = 4000 - 500 = 3500
        # model.max_tokens should be min(1000, 3500) = 1000 (unchanged)
        assert mock_model.max_tokens == 1000

    def test_calculate_max_tokens_exceeds_limit(self, agent_service, mock_model):
        """Test that max_tokens is capped when prompts consume most tokens."""
        # Make token count high, leaving only 50 tokens available
        agent_service.token_service.count.return_value = 3950
        agent_service.calculate_max_tokens("large prompt")
        # requested_tokens = 4000 - 3950 = 50
        # model.max_tokens should be min(1000, 50) = 50
        assert mock_model.max_tokens == 50

    def test_calculate_max_tokens_buggy_negative(self, agent_service, mock_model):
        """Buggy code would subtract tokens and could make max_tokens negative."""
        # Simulate token count exceeding max allowed tokens
        agent_service.token_service.count.return_value = 5000
        agent_service.calculate_max_tokens("huge prompt")
        # requested_tokens = 4000 - 5000 = -1000
        # model.max_tokens should be min(1000, -1000) = -1000
        # This would cause OpenAIError: -1000 is less than the minimum of 1
        # The fix ensures max_tokens is at least 1? Actually min(1000, -1000) = -1000
        # But the bug is that the old code directly subtracted tokens, which could go negative.
        # The new calculate_max_tokens still can set negative, but the real issue is that
        # the model's max_tokens should never be negative. The fix ensures we don't subtract
        # multiple times and we cap at the model's max, but we still need to ensure it's >=1.
        # However the patch doesn't add a floor of 1, it just prevents multiple subtractions.
        # The test should verify that after the fix, max_tokens is not negative when
        # the buggy code would have made it negative.
        # Let's check that max_tokens is not less than 1.
        assert mock_model.max_tokens >= 1, "max_tokens should not be less than 1"

    def test_start_goal_uses_calculate_max_tokens(self, agent_service, mock_model):
        """Test that start_goal calls calculate_max_tokens instead of direct subtraction."""
        with patch.object(agent_service, "calculate_max_tokens") as mock_calc:
            # Mock the chain and other dependencies
            agent_service.chain = MagicMock()
            agent_service.chain.arun = AsyncMock(return_value=["task1", "task2"])
            # Call start_goal
            result = agent_service.start_goal("Test goal")
            # Ensure calculate_max_tokens was called
            assert mock_calc.called
            # Ensure max_tokens wasn't directly decremented (we can't easily test that,
            # but we can verify that calculate_max_tokens was called with the prompt)
            mock_calc.assert_called_once()

