                reasoning="test",
                action="reason",
                arg="arg",
            )
            mock_parser = PydanticOutputParser(pydantic_object=Analysis)
            mock_parser.parse = MagicMock(return_value=mock_analysis)
            with patch("reworkd_platform.web.api.agent.agent_service.open_ai_agent_service.PydanticOutputParser", return_value=mock_parser):
