def test_calculate_max_tokens_fixed():
    """
    After fix, calculate_max_tokens ensures max_tokens doesn't exceed allowed limit.
    This test should pass only after the fix is applied.
    """
    from reworkd_platform.schemas import LLM_MODEL_MAX_TOKENS

    # Import the actual class after patch is applied
    agent = OpenAIAgentService(
        model=MagicMock(spec=WrappedChatOpenAI),
        language="en",
        token_service=MagicMock(spec=TokenService),
        callbacks=[],
        max_iterations=1,
    )

    # Mock token service to return negative count (bug scenario)
    agent.token_service.count.return_value = -351
    agent.model.model_name = LLM_Model.gpt_3_5_turbo
    agent.model.max_tokens = 1000

    # Call calculate_max_tokens (added in fix)
    agent.calculate_max_tokens("some prompt")

    # After fix, max_tokens should be clamped to allowed limit
    max_allowed = LLM_MODEL_MAX_TOKENS.get(agent.model.model_name, 4000)
    # requested_tokens = max_allowed - (-351) = max_allowed + 351
    # Then min(1000, requested_tokens) = 1000 because requested_tokens > 1000
    # So max_tokens should remain 1000, not become negative.
    assert agent.model.max_tokens == 1000
    assert agent.model.max_tokens > 0  # Must be positive


