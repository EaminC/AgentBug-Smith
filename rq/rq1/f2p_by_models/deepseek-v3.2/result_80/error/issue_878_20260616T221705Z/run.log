@pytest.mark.asyncio
async def test_calculate_max_tokens_uses_model_name():
    """Test that calculate_max_tokens uses model_name from WrappedChatOpenAI."""
    mock_token_service = MagicMock(spec=TokenService)
    mock_token_service.count.return_value = 100

    # Create model with model_name set
    model = WrappedChatOpenAI(
        max_tokens=2000,
        model=LLM_Model.gpt_4,  # this should set model_name via Field alias
        openai_api_key="fake-key",
        temperature=0.5,
        streaming=False,
    )
    # Ensure model_name is set (should be via alias)
    assert model.model_name == LLM_Model.gpt_4

    agent = OpenAIAgentService(
        model=model,
        token_service=mock_token_service,
        language="English",
        callbacks=[],
    )

    # Call calculate_max_tokens
    agent.calculate_max_tokens("prompt")

    # Verify max_tokens updated (should use LLM_MODEL_MAX_TOKENS for gpt-4)
    # We'll just check it's not negative
    assert agent.model.max_tokens >= 1


