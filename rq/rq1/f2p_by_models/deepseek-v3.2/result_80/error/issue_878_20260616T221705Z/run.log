        # In fixed code, model should be LLM_Model.gpt_4 (string "gpt-4")
        # Since we patched __init__, we can't check the actual model attribute.
        # Instead we test that WrappedChatOpenAI.model_name is set via alias.
        # Let's test with actual instantiation (unmocked) but mock openai key.
        pass

    # Actually test with mocked openai api key to avoid network calls
    with patch('openai.api_key', 'dummy'), patch('openai.api_base', 'http://dummy'):
        model = create_model(settings, user, streaming=False)
        # In fixed code, model.model should be "gpt-4" (string)
        assert model.model == "gpt-4"
        # model.max_tokens should be 1000
        assert model.max_tokens == 1000
        # model.model_name should be LLM_Model.gpt_4 (via Field alias)
        assert model.model_name == LLM_Model.gpt_4

def test_calculate_max_tokens_with_multiple_prompts():
    """Test calculate_max_tokens sums tokens across multiple prompts."""
    mock_model = MagicMock(spec=WrappedChatOpenAI)
    mock_model.max_tokens = 3000
    mock_model.model_name = LLM_Model.gpt_3_5_turbo

    mock_token_service = MagicMock(spec=TokenService)
    # First call returns 100, second 200, third 300
    mock_token_service.count.side_effect = [100, 200, 300]

    agent = OpenAIAgentService(
        model=mock_model,
        language="English",
        agent_id="test",
        token_service=mock_token_service,
    )
    agent.token_service = mock_token_service

    agent.calculate_max_tokens("prompt1", "prompt2", "prompt3")

    # token_service.count should be called three times
    assert mock_token_service.count.call_count == 3
    # max_allowed_tokens default 4000, prompt_tokens = 100+200+300=600
    # requested_tokens = 4000 - 600 = 3400
    # max_tokens = min(3000, 3400) = 3000
    assert mock_model.max_tokens == 3000

