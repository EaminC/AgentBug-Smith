def test_create_model_sets_model_name():
    """Test that create_model sets model_name correctly (alias for model)."""
    user = MagicMock()
    user.email = "test@example.com"
    model_settings = ModelSettings(
        model=LLM_Model.gpt_3_5_turbo,
        temperature=0.5,
        max_tokens=100,
    )
    api_key = "fake-key"

    with patch("reworkd_platform.web.api.agent.model_settings.rotate_keys") as mock_rotate:
        mock_rotate.return_value = api_key
        model = create_model(model_settings, user, streaming=False)

    # After fix, model.model_name should be set via Field alias
    assert model.model_name == LLM_Model.gpt_3_5_turbo
    # Also ensure max_tokens is set
    assert model.max_tokens == 100


