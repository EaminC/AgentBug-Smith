    mock_model.apredict_messages.return_value = MagicMock(content="")

    # Call start_goal
    await service.start_goal("Test goal")

    # In buggy code, max_tokens would be decreased by token count, possibly negative.
    # In fixed code, calculate_max_tokens ensures max_tokens doesn't go below 1.
    # Assert max_tokens is >= 1
    assert mock_model.max_tokens >= 1, f"max_tokens negative after start_goal: {mock_model.max_tokens}"


