        # max_tokens becomes 0, which OpenAI may reject (needs >=1).
        # The fix doesn't clamp to >=1, but the bug is about negative values.
        # This test is to ensure at least we don't go negative.
        assert model.max_tokens == 0  # This is okay for this test

