        max_tokens=1000,
    )
    user = UserBase(email="test@example.com")

    # Mock ChatOpenAI constructor to capture arguments
    with patch('reworkd_platform.web.api.agent.model_settings.ChatOpenAI.__init__') as mock_init:
        mock_init.return_value = None
