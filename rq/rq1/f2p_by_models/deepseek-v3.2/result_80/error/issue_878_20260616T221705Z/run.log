    # That's single subtraction, not multiple.
    # So the fix should prevent ANY negative max_tokens.
    # But the current fix doesn't!
    
    # Wait, maybe I'm misunderstanding. Let me check the actual git diff again.
    # The diff shows calculate_max_tokens implementation.
    # It doesn't have any floor at 1.
    # So maybe the test should verify that max_tokens can be negative?
    # That doesn't make sense for fail2pass.
    
    # I think the real issue is that the validation happens in OpenAI API.
    # The fix ensures we don't SUBTRACT multiple times (overcounting).
    # With overcounting fixed, max_tokens is less likely to go negative.
    # So the test should simulate overcounting scenario.
    
    # Reset for overcounting test
    mock_token_service.count.return_value = 200
    agent_service.model.max_tokens = 300
    
    # Simulate buggy behavior: two separate subtractions of 200 each
    # In buggy: after first: 100, after second: -100
    # In fixed: calculate_max_tokens sums: 200+200=400, requested_tokens=4000-400=3600
    # max_tokens = min(300, 3600) = 300
    
    # Call calculate_max_tokens with two prompts (simulating what start_goal does)
    agent_service.calculate_max_tokens("Prompt 1", "Prompt 2")
    
    # max_tokens should remain 300 (positive)
    assert agent_service.model.max_tokens == 300
    
    # Now test that if we call calculate_max_tokens twice (buggy scenario),
    # it still doesn't go negative because it recalculates from original each time.
    agent_service.model.max_tokens = 300
    agent_service.calculate_max_tokens("Prompt 1")
    # After first: max_tokens = min(300, 4000-200) = min(300, 3800) = 300
    assert agent_service.model.max_tokens == 300
    
    agent_service.calculate_max_tokens("Prompt 2")
    # After second: Still starts from original 300, not reduced 300
    # Actually calculate_max_tokens uses current self.model.max_tokens which is 300
    # requested_tokens = 4000-200=3800
    # max_tokens = min(300, 3800) = 300
    assert agent_service.model.max_tokens == 300
    
    # So the fix prevents cumulative subtraction.[0m
