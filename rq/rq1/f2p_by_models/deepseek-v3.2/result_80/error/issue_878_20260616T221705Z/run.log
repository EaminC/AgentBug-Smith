FROM python:3.11-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Set environment variable to allow pip to modify system packages
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Install system dependencies for Python packages and MySQL client
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ default-libmysqlclient-dev pkg-config curl \
    libxml2-dev libxslt1-dev python3-dev && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python -m pip install --upgrade pip

# Copy entire repository
COPY . .

# Navigate to platform directory where pyproject.toml is located
WORKDIR /app/platform

# Extract dependencies from pyproject.toml and install them manually
# This avoids poetry dependency resolution issues
RUN pip install --break-system-packages \
    fastapi==0.98.0 \
    uvicorn[standard]==0.22.0 \
    "pydantic[dotenv]==1.10.8" \
    yarl==1.9.2 \
    ujson==5.7.0 \
    "SQLAlchemy[asyncio]==2.0.15" \
    aiomysql==0.1.1 \
    mysqlclient==2.1.1 \
    httptools==0.5.0 \
    sentry-sdk==1.25.0 \
    loguru==0.7.0 \
    aiokafka==0.8.1 \
    requests==2.28.0 \
    langchain==0.0.199 \
    openai==0.27.7 \
    wikipedia==1.4.0 \
    replicate==0.8.3 \
    lanarky==0.7.8 \
    weaviate-client==3.19.2 \
    tiktoken==0.4.0 \
    numpy==1.24.3 \
    vecs==0.2.6 \
    grpcio==1.54.2 \
    "pinecone-client[grpc]==2.2.2"

# Install dev dependencies for testing
# Use compatible versions from pyproject.toml
RUN pip install --break-system-packages \
    pytest==7.3.1 \
    pytest-cov==4.1.0 \
    pytest-mock==3.10.0 \
    pytest-asyncio==0.21.0 \
    pluggy==1.5.0 \
    iniconfig==2.0.0 \
    coverage==7.6.7 \
    flake8==6.0.0 \
    mypy==1.3.0 \
    isort==5.12.0 \
    pre-commit==3.3.2 \
    wemake-python-styleguide==0.18.0 \
    black==23.3.0 \
    autoflake==2.1.1 \
    autopep8==2.0.2 \
    anyio==3.7.0 \
    pytest-env==0.8.1 \
    "taskiq[reload]==0.6.0" \
    httpx==0.24.1

# Install the project in development mode
RUN pip install --break-system-packages -e .

# Set Python path to include the project root
ENV PYTHONPATH=/app/platform

# Set additional environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0
ENV ANTHROPIC_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key
ENV REWORKD_PLATFORM_ENVIRONMENT=pytest
ENV REWORKD_PLATFORM_DB_BASE=reworkd_platform_test
ENV REWORKD_PLATFORM_SENTRY_DSN=

# Simple preflight check - test imports
RUN python -c 'import pytest; print(f"pytest {pytest.__version__}")'
RUN python -c 'import pluggy; print(f"pluggy {pluggy.__version__}")'
RUN python -c 'import openai; print(f"openai {openai.__version__}")'
