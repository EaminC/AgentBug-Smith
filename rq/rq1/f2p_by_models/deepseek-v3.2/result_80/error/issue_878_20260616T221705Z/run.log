def test_openai_agent_service_calculate_max_tokens_prevents_negative():
    """Test that calculate_max_tokens ensures max_tokens is at least 1."""
    # Create a mock model with a high max_tokens that would cause overflow
    mock_model = MagicMock(spec=WrappedChatOpenAI)
    mock_model.max_tokens = 10000  # Arbitrary high value
    mock_model.model_name = LLM_Model.gpt_3_5_turbo

    # Mock token service to return a high token count
    mock_token_service = MagicMock(spec=TokenService)
    # Simulate token count that would make requested_tokens negative
    mock_token_service.count.return_value = 5000  # tokens in prompts

    # Create agent service with mocks
    agent = OpenAIAgentService(
        model=mock_model,
        language="English",
        agent_id="test",
        token_service=mock_token_service,
    )

    # Replace token service with mock
    agent.token_service = mock_token_service

    # Call calculate_max_tokens with a prompt
    agent.calculate_max_tokens("A test prompt")

    # Verify token service was called
    mock_token_service.count.assert_called_once_with("A test prompt")

    # In buggy code, max_tokens would be set to a negative value.
    # In fixed code, max_tokens should be clamped to min(self.model.max_tokens, requested_tokens)
    # where requested_tokens = max_allowed_tokens - prompt_tokens.
    # For gpt-3.5-turbo, max_allowed_tokens is 4000 (from LLM_MODEL_MAX_TOKENS default).
    # requested_tokens = 4000 - 5000 = -1000.
    # min(10000, -1000) = -1000 in buggy code, but the fix ensures max_tokens is not negative?
    # Actually the fix doesn't explicitly clamp to >=1, but the OpenAI API would reject negative.
    # The bug was that max_tokens became negative causing OpenAIError.
    # The fix uses calculate_max_tokens which sets max_tokens = min(self.model.max_tokens, requested_tokens).
    # If requested_tokens is negative, max_tokens becomes negative -> still bug.
    # Wait, let's examine the patch: calculate_max_tokens does not clamp to >=1.
    # However the issue is about max_tokens less than minimum of 1.
    # The patch changes from subtracting tokens from self.model.max_tokens to using calculate_max_tokens.
    # But calculate_max_tokens still can produce negative if prompt_tokens > max_allowed_tokens.
    # However max_allowed_tokens for gpt-3.5-turbo is 4000, prompt_tokens 5000 > 4000.
    # So requested_tokens negative -> max_tokens negative.
    # The bug might be that max_tokens should never go below 1.
    # Let's test that after fix, max_tokens is at least 1.
    # Actually the patch doesn't add a lower bound. So test may fail on buggy and fixed?
    # Need to see what the buggy code did: self.model.max_tokens -= token_service.count(...)
    # If max_tokens started at 10000, after subtracting 5000 becomes 5000 (still positive).
    # But the error says -351 is less than minimum of 1. So max_tokens became negative.
    # That means initial max_tokens was low and token count high.
    # Let's simulate that: set model.max_tokens = 1000, token count 1351 => 1000 - 1351 = -351.
    # In buggy code, max_tokens becomes -351.
    # In fixed code, calculate_max_tokens does:
    # max_allowed_tokens = LLM_MODEL_MAX_TOKENS.get(self.model.model_name, 4000) = 4000
    # prompt_tokens = 1351
    # requested_tokens = 4000 - 1351 = 2649
    # self.model.max_tokens = min(self.model.max_tokens, requested_tokens) = min(1000, 2649) = 1000
    # So max_tokens stays 1000 (positive). That fixes the negative issue.
    # Therefore test should verify max_tokens >= 1 after calculate_max_tokens.

    # Let's adjust test to replicate bug scenario.
    mock_model.max_tokens = 1000
    mock_token_service.count.return_value = 1351

    agent.calculate_max_tokens("Prompt")

    # max_tokens should be >= 1
    assert mock_model.max_tokens >= 1, f"max_tokens became negative: {mock_model.max_tokens}"
    # Specifically, it should be 1000 (since min(1000, 4000-1351=2649) = 1000)
    assert mock_model.max_tokens == 1000

