def test_openai_provider_creation():
    """Test that OpenAIProvider can be created and returns a model."""
    # Mock the config to avoid needing real API keys
    mock_config = MagicMock()
    mock_config.name = "OpenAI"
    mock_config.default_model = "gpt-5-2025-08-07"
    mock_config.api_key = "fake-api-key"
    mock_config.parameters = {}
    mock_config.default_embedding_model = "text-embedding-3-small"
    mock_config.embedding_parameters = {}

    provider = OpenAIProvider(mock_config)

    # Mock agno imports to avoid actual network calls
    with patch('agno.models.openai.OpenAIChat') as mock_openai_chat:
        mock_openai_chat.return_value = MagicMock(id="gpt-5-2025-08-07")
        model = provider.create_model()
        assert model is not None
        mock_openai_chat.assert_called_once_with(
            id="gpt-5-2025-08-07",
            api_key="fake-api-key",
            temperature=None,
            max_tokens=None,
            top_p=None,
            frequency_penalty=None,
            presence_penalty=None,
        )

    with patch('agno.knowledge.embedder.openai.OpenAIEmbedder') as mock_embedder:
        mock_embedder.return_value = MagicMock(id="text-embedding-3-small")
        embedder = provider.create_embedder()
        assert embedder is not None
        mock_embedder.assert_called_once_with(
            id="text-embedding-3-small",
            api_key="fake-api-key",
            dimensions=None,
            encoding_format="float",
        )


def test_openai_provider_in_factory():
    """Test that ModelFactory can create an OpenAI provider."""
    # Mock config manager to return OpenAI config
    mock_config_manager = MagicMock(spec=ConfigManager)
    mock_provider_config = MagicMock()
    mock_provider_config.name = "OpenAI"
    mock_provider_config.provider_type = "openai"
    mock_provider_config.default_model = "gpt-5-2025-08-07"
    mock_provider_config.api_key = "fake-key"
    mock_provider_config.parameters = {}
    mock_provider_config.default_embedding_model = "text-embedding-3-small"
    mock_provider_config.embedding_parameters = {}

    mock_config_manager.get_provider_config.return_value = mock_provider_config

    factory = ModelFactory(config_manager=mock_config_manager)

    # Ensure OpenAI provider is in registry
    assert "openai" in factory._provider_registry
    assert factory._provider_registry["openai"] == OpenAIProvider

    # Create provider
    provider = factory.create_provider("openai")
    assert isinstance(provider, OpenAIProvider)
    assert provider.config == mock_provider_config


