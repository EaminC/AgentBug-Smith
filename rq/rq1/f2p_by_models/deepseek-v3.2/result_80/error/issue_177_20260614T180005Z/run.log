[32mimport os
import sys
import pytest
from unittest.mock import patch, MagicMock
from valuecell.adapters.models.factory import ModelFactory, OpenAIProvider
from valuecell.config.manager import ConfigManager


def test_openai_provider_creation():
    """Test that OpenAIProvider can be instantiated and creates a model."""
    # Mock config to avoid needing real API key
    mock_config = MagicMock()
    mock_config.name = "OpenAI"
    mock_config.default_model = "gpt-5-2025-08-07"
    mock_config.api_key = "sk-test123"
    mock_config.parameters = {}
    mock_config.default_embedding_model = "text-embedding-3-small"
    mock_config.embedding_parameters = {}

    provider = OpenAIProvider(mock_config)
    assert provider.config.name == "OpenAI"

    # Mock the agno imports to avoid actual installation issues
    with patch.dict(sys.modules, {'agno.models.openai': MagicMock(), 'agno.knowledge.embedder.openai': MagicMock()}):
        # Mock the OpenAIChat class
        mock_openai_chat = MagicMock()
        sys.modules['agno.models.openai'].OpenAIChat = mock_openai_chat
        mock_openai_chat.return_value = MagicMock(id="gpt-5-2025-08-07")

        # Mock the OpenAIEmbedder class
        mock_openai_embedder = MagicMock()
        sys.modules['agno.knowledge.embedder.openai'].OpenAIEmbedder = mock_openai_embedder
        mock_openai_embedder.return_value = MagicMock(id="text-embedding-3-small")

        # Test model creation
        model = provider.create_model()
        assert model is not None
        mock_openai_chat.assert_called_once_with(
            id="gpt-5-2025-08-07",
            api_key="sk-test123",
            temperature=None,
            max_tokens=None,
            top_p=None,
            frequency_penalty=None,
            presence_penalty=None,
        )

        # Test embedder creation
        embedder = provider.create_embedder()
        assert embedder is not None
        mock_openai_embedder.assert_called_once_with(
            id="text-embedding-3-small",
            api_key="sk-test123",
            dimensions=None,
            encoding_format="float",
        )


def test_model_factory_openai_registration():
    """Test that ModelFactory includes OpenAIProvider."""
    factory = ModelFactory()
    assert "openai" in factory._providers
    assert factory._providers["openai"] == OpenAIProvider


def test_config_manager_openai_in_preferred_order():
    """Test that ConfigManager includes 'openai' in preferred order."""
    config_manager = ConfigManager()
    # Access the private _preferred_model_providers list via introspection
    # The patch adds 'openai' to the list in __init__
    # We'll check by creating a mock config that includes openai
    mock_config = {
        "models": {
            "providers": {
                "openai": {
                    "config_file": "providers/openai.yaml",
                    "api_key_env": "OPENAI_API_KEY"
                }
            }
        }
    }
    with patch.object(config_manager, '_config', mock_config):
        # Trigger provider loading
        config_manager._load_model_providers()
        # The _preferred_model_providers is built in __init__, but we can check
        # that openai is in the list of available providers
        providers = config_manager.get_model_providers()
        # In buggy code, 'openai' won't be in the list; after fix, it should be.
        # This test will fail on buggy code because the provider won't be loaded.
        assert "openai" in providers


def test_openai_provider_import_error():
    """Test that OpenAIProvider raises ImportError when agno is missing."""
    mock_config = MagicMock()
    mock_config.default_model = "gpt-5-2025-08-07"
    provider = OpenAIProvider(mock_config)

    # Temporarily remove agno module from sys.modules to simulate missing import
    original_openai = sys.modules.get('agno.models.openai')
    original_embedder = sys.modules.get('agno.knowledge.embedder.openai')
    sys.modules.pop('agno.models.openai', None)
    sys.modules.pop('agno.knowledge.embedder.openai', None)
    try:
        with pytest.raises(ImportError, match="agno package not installed"):
            provider.create_model()
    finally:
        if original_openai:
            sys.modules['agno.models.openai'] = original_openai
        if original_embedder:
            sys.modules['agno.knowledge.embedder.openai'] = original_embedder


def test_openai_embedding_model_id_required():
    """Test that OpenAIProvider requires embedding model ID."""
    mock_config = MagicMock()
    mock_config.name = "OpenAI"
    mock_config.default_embedding_model = None  # No default set
    mock_config.embedding_parameters = {}
    provider = OpenAIProvider(mock_config)

    with patch.dict(sys.modules, {'agno.knowledge.embedder.openai': MagicMock()}):
        # Mock the import so we reach the ValueError check
        sys.modules['agno.knowledge.embedder.openai'].OpenAIEmbedder = MagicMock()
        with pytest.raises(ValueError, match="No embedding model specified"):
            provider.create_embedder(model_id=None)


