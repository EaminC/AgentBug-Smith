def test_openai_provider_creation():
    """
    Test that OpenAIProvider can be instantiated and create_model works
    when the agno package is available.
    """
    # Mock the config to have OpenAI settings
    mock_config = MagicMock()
    mock_config.name = "OpenAI"
    mock_config.default_model = "gpt-5-2025-08-07"
    mock_config.api_key = "sk-test123"
    mock_config.parameters = {"temperature": 0.7}
    mock_config.default_embedding_model = "text-embedding-3-small"
    mock_config.embedding_parameters = {"encoding_format": "float"}

    provider = OpenAIProvider(mock_config)

    # Mock the import of agno.models.openai.OpenAIChat
    with patch("agno.models.openai.OpenAIChat") as MockOpenAIChat:
        mock_model_instance = MagicMock()
        MockOpenAIChat.return_value = mock_model_instance

        model = provider.create_model()

        # Ensure the model was created with correct parameters
        MockOpenAIChat.assert_called_once_with(
            id="gpt-5-2025-08-07",
            api_key="sk-test123",
            temperature=0.7,
            max_tokens=None,
            top_p=None,
            frequency_penalty=None,
            presence_penalty=None,
        )
        assert model is mock_model_instance

    # Test create_embedder
    with patch("agno.knowledge.embedder.openai.OpenAIEmbedder") as MockOpenAIEmbedder:
        mock_embedder_instance = MagicMock()
        MockOpenAIEmbedder.return_value = mock_embedder_instance

        embedder = provider.create_embedder()

        MockOpenAIEmbedder.assert_called_once_with(
            id="text-embedding-3-small",
            api_key="sk-test123",
            dimensions=None,
            encoding_format="float",
        )
        assert embedder is mock_embedder_instance


