[32mimport os
import sys
import pytest
from unittest.mock import patch, MagicMock
from valuecell.adapters.models.factory import ModelFactory, OpenAIProvider
from valuecell.config.manager import ConfigManager


def test_openai_provider_creation():
    """
    Test that OpenAIProvider can be instantiated and creates a model correctly.
    This test should fail in buggy code (no OpenAIProvider) and pass after patch.
    """
    # Ensure the provider type exists in factory registry
    assert "openai" in ModelFactory._providers

    # Mock config to avoid needing real API key
    mock_config = MagicMock()
    mock_config.name = "OpenAI"
    mock_config.default_model = "gpt-5-2025-08-07"
    mock_config.api_key = "fake-api-key"
    mock_config.parameters = {}
    mock_config.default_embedding_model = "text-embedding-3-small"
    mock_config.embedding_parameters = {}

    # Create provider instance
    provider = OpenAIProvider(mock_config)
    assert provider.config.name == "OpenAI"

    # Mock agno imports to avoid actual network calls
    with patch("agno.models.openai.OpenAIChat") as mock_openai_chat:
        mock_openai_chat.return_value = MagicMock()
        model = provider.create_model()
        # Verify OpenAIChat was called with expected arguments
        mock_openai_chat.assert_called_once_with(
            id="gpt-5-2025-08-07",
            api_key="fake-api-key",
            temperature=None,
            max_tokens=None,
            top_p=None,
            frequency_penalty=None,
            presence_penalty=None,
        )
        assert model is not None

    # Test embedder creation
    with patch("agno.knowledge.embedder.openai.OpenAIEmbedder") as mock_embedder:
        mock_embedder.return_value = MagicMock()
        embedder = provider.create_embedder()
        mock_embedder.assert_called_once_with(
            id="text-embedding-3-small",
            api_key="fake-api-key",
            dimensions=None,
            encoding_format="float",
        )
        assert embedder is not None


def test_openai_in_config_manager():
    """
    Test that ConfigManager includes 'openai' in preferred providers.
    """
    # Mock environment to avoid file dependencies
    with patch.dict(os.environ, {}, clear=True):
        with patch("valuecell.config.manager.load_yaml_config") as mock_load:
            mock_load.return_value = {
                "models": {
                    "providers": {
                        "openai": {"config_file": "providers/openai.yaml"}
                    }
                }
            }
            cm = ConfigManager()
            # Verify openai is in the provider order list
            assert "openai" in cm._get_provider_order()


def test_model_factory_openai():
    """
    Test ModelFactory can create an OpenAI model via provider.
    """
    # Mock config manager to return openai config
    mock_cm = MagicMock(spec=ConfigManager)
    mock_cm.get_model_provider_config.return_value = MagicMock(
        name="OpenAI",
        default_model="gpt-5-2025-08-07",
        api_key="fake-key",
        parameters={},
        default_embedding_model="text-embedding-3-small",
        embedding_parameters={},
    )

    factory = ModelFactory(config_manager=mock_cm)

    # Mock OpenAIProvider.create_model to avoid actual agno instantiation
    with patch.object(OpenAIProvider, "create_model") as mock_create:
        mock_create.return_value = MagicMock()
        model = factory.create_model(provider="openai")
        assert model is not None
        mock_create.assert_called_once()


def test_utils_model_json_mode_openai():
    """
    Test that model_should_use_json_mode returns True for OpenAI models.
    This depends on the patch adding OpenAI check in utils/model.py.
    """
    from valuecell.utils.model import model_should_use_json_mode

    # Mock an OpenAI model instance
    mock_model = MagicMock()
    mock_model.provider = "openai"
    mock_model.name = "OpenAIChat"

    # In buggy code, this will return False (since OpenAI not handled).
    # After patch, should return True.
    result = model_should_use_json_mode(mock_model)
    # Assert True after fix; will fail before patch.
    assert result is True


if __name__ == "__main__":
    pytest.main([__file__, "-v"])[0m
