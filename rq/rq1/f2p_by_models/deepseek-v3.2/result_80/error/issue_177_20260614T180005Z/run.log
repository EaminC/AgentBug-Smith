    from valuecell.utils.model import model_should_use_json_mode
    
    # Mock an OpenAI model
    mock_openai_model = MagicMock()
    mock_openai_model.provider = "openai"
    mock_openai_model.name = "OpenAIChat"
    
    # This should return True after the fix
    result = model_should_use_json_mode(mock_openai_model)
    # In buggy code, this would be False; in fixed code, True
    assert result == True


def test_openai_provider_import_error():
    """Test that OpenAIProvider raises ImportError when agno is not installed."""
    mock_config = MagicMock()
    mock_config.name = "OpenAI"
    mock_config.default_model = "gpt-5-2025-08-07"
    mock_config.api_key = "sk-test123"
    mock_config.parameters = {}
    
    provider = OpenAIProvider(mock_config)
    
    # Remove agno modules from sys.modules to simulate missing package
    with patch.dict(sys.modules, {"agno.models.openai": None, "agno.knowledge.embedder.openai": None}):
        with pytest.raises(ImportError, match="agno package not installed"):
            provider.create_model()
        
        with pytest.raises(ImportError, match="agno package not installed"):
            provider.create_embedder()


def test_openai_provider_no_embedding_model():
    """Test OpenAIProvider raises ValueError when no embedding model is configured."""
    mock_config = MagicMock()
    mock_config.name = "OpenAI"
    mock_config.default_model = "gpt-5-2025-08-07"
    mock_config.api_key = "sk-test123"
    mock_config.parameters = {}
    mock_config.default_embedding_model = None  # No default embedding model
    mock_config.embedding_parameters = {}
    
    provider = OpenAIProvider(mock_config)
    
    with patch.dict(sys.modules, {"agno.models.openai": MagicMock(), "agno.knowledge.embedder.openai": MagicMock()}):
        # Mock the OpenAIChat import for model creation (should work)
        mock_openai_chat = MagicMock()
        sys.modules["agno.models.openai"].OpenAIChat = mock_openai_chat
        
        # Model creation should work
        provider.create_model()
        
        # But embedder creation should fail
        with pytest.raises(ValueError, match="No embedding model specified"):
            provider.create_embedder()[0m
