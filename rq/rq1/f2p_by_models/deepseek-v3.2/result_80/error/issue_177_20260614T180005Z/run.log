def test_openai_provider_import_error():
    """
    Test that OpenAIProvider raises ImportError when agno is missing.
    """
    mock_config = MagicMock()
    mock_config.name = "OpenAI"
    mock_config.default_model = "gpt-5-2025-08-07"
    mock_config.api_key = "sk-test123"
    mock_config.parameters = {}
    provider = OpenAIProvider(mock_config)

    # Simulate missing agno package
    with patch.dict(sys.modules, {"agno.models.openai": None}):
        with pytest.raises(ImportError) as exc_info:
            provider.create_model()
        assert "agno package not installed" in str(exc_info.value)

    with patch.dict(sys.modules, {"agno.knowledge.embedder.openai": None}):
        with pytest.raises(ImportError) as exc_info:
            provider.create_embedder()
        assert "agno package not installed" in str(exc_info.value)


def test_model_should_use_json_mode_openai():
    """
    Test that model_should_use_json_mode returns True for OpenAI models.
    """
    from valuecell.utils.model import model_should_use_json_mode
    from agno.models.openai import OpenAIChat as AgnoOpenAIChatModel

    # Create a mock OpenAI model with correct provider and name
    mock_model = MagicMock()
    mock_model.provider = AgnoOpenAIChatModel.provider
    mock_model.name = AgnoOpenAIChatModel.name

    # In buggy state, this will return False because OpenAI check is missing.
