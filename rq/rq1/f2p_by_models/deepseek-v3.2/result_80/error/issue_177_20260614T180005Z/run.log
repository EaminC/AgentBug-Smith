[32mimport os
import pytest
from unittest.mock import patch, MagicMock
from valuecell.adapters.models.factory import ModelFactory, OpenAIProvider
from valuecell.config.manager import ConfigManager


def test_openai_provider_creation_before_patch():
    """Test that OpenAI provider is not available before the patch."""
    factory = ModelFactory()
    # Before patch, OpenAI provider should not be in registry
    assert "openai" not in factory._provider_registry


def test_openai_provider_creation_after_patch():
    """Test that OpenAI provider can be created after patch."""
    # Mock config to avoid needing actual API key
    mock_config = MagicMock()
    mock_config.name = "OpenAI"
    mock_config.default_model = "gpt-5-2025-08-07"
    mock_config.default_embedding_model = "text-embedding-3-small"
    mock_config.api_key = "fake-key"
    mock_config.parameters = {}
    mock_config.embedding_parameters = {}
    
    provider = OpenAIProvider(mock_config)
    assert provider.config.name == "OpenAI"


def test_openai_model_creation_with_mocked_agno():
    """Test OpenAI model creation with mocked agno imports."""
    # Skip if OpenAIProvider doesn't exist (pre-patch)
    if "openai" not in ModelFactory._provider_registry:
        pytest.skip("OpenAI provider not available in buggy version")
    
    mock_config = MagicMock()
    mock_config.name = "OpenAI"
    mock_config.default_model = "gpt-5-2025-08-07"
    mock_config.api_key = "fake-key"
    mock_config.parameters = {}
    
    provider = OpenAIProvider(mock_config)
    
    # Mock agno imports
    mock_openai_chat = MagicMock()
    mock_openai_chat_instance = MagicMock()
    mock_openai_chat.return_value = mock_openai_chat_instance
    
    with patch.dict('sys.modules', {'agno.models.openai': MagicMock(OpenAIChat=mock_openai_chat)}):
        model = provider.create_model()
        assert model is mock_openai_chat_instance
        mock_openai_chat.assert_called_once_with(
            id="gpt-5-2025-08-07",
            api_key="fake-key",
            temperature=None,
            max_tokens=None,
            top_p=None,
            frequency_penalty=None,
            presence_penalty=None,
        )


def test_openai_embedder_creation_with_mocked_agno():
    """Test OpenAI embedder creation with mocked agno imports."""
    # Skip if OpenAIProvider doesn't exist (pre-patch)
    if "openai" not in ModelFactory._provider_registry:
        pytest.skip("OpenAI provider not available in buggy version")
    
    mock_config = MagicMock()
    mock_config.name = "OpenAI"
    mock_config.default_embedding_model = "text-embedding-3-small"
    mock_config.api_key = "fake-key"
    mock_config.embedding_parameters = {}
    
    provider = OpenAIProvider(mock_config)
    
    # Mock agno imports
    mock_openai_embedder = MagicMock()
    mock_openai_embedder_instance = MagicMock()
    mock_openai_embedder.return_value = mock_openai_embedder_instance
    
    with patch.dict('sys.modules', {'agno.knowledge.embedder.openai': MagicMock(OpenAIEmbedder=mock_openai_embedder)}):
        embedder = provider.create_embedder()
        assert embedder is mock_openai_embedder_instance
        mock_openai_embedder.assert_called_once_with(
            id="text-embedding-3-small",
            api_key="fake-key",
            dimensions=None,
            encoding_format="float",
        )


def test_config_manager_includes_openai():
    """Test that ConfigManager includes OpenAI in preferred providers."""
    # Mock environment to avoid file loading issues
    with patch.object(ConfigManager, '_load_configs', return_value={}):
        cm = ConfigManager()
        
        # Check that openai is in the preferred providers list
        # This is hardcoded in the patch to config/manager.py
        assert "openai" in cm._preferred_providers


def test_model_factory_openai_integration():
    """Test that ModelFactory can create OpenAI models through normal flow."""
    # Skip if OpenAI provider not registered
    if "openai" not in ModelFactory._provider_registry:
        pytest.skip("OpenAI provider not available in buggy version")
    
    # Mock config manager to return OpenAI config
    mock_config_manager = MagicMock()
    mock_openai_config = MagicMock()
    mock_openai_config.name = "OpenAI"
    mock_openai_config.provider_type = "openai"
    mock_openai_config.default_model = "gpt-5-2025-08-07"
    mock_openai_config.api_key = "fake-key"
    mock_openai_config.parameters = {}
    
    mock_config_manager.get_model_provider_config.return_value = mock_openai_config
    
    factory = ModelFactory(mock_config_manager)
    
    # Mock the actual provider creation
    mock_provider = MagicMock()
    mock_model = MagicMock()
    mock_provider.create_model.return_value = mock_model
    
    with patch.object(factory, '_create_provider', return_value=mock_provider):
        model = factory.create_model(provider_type="openai")
        assert model is mock_model
        mock_provider.create_model.assert_called_once_with(model_id=None)


def test_model_should_use_json_mode_openai():
    """Test that model_should_use_json_mode returns True for OpenAI models."""
    from valuecell.utils.model import model_should_use_json_mode
    
    # Create a mock OpenAI model
    mock_openai_model = MagicMock()
    mock_openai_model.provider = "openai"
    mock_openai_model.name = "OpenAIChat"
    
    # Before patch, this should return False
    # After patch, it should return True
    result = model_should_use_json_mode(mock_openai_model)
    
    # This test will fail before patch, pass after patch
    assert result == True, "OpenAI models should use JSON mode after patch"


