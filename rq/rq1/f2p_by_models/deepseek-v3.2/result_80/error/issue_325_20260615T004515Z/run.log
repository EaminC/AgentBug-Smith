from unittest.mock import patch, MagicMock
from gpt_engineer.ai import AI, create_chat_model, fallback_model

def test_ai_initialization_without_azure():
    """Test AI initialization without Azure endpoint uses ChatOpenAI."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        ai = AI(model_name="gpt-4", temperature=0.1, azure_endpoint="")
        assert ai.azure_endpoint == ""
        assert ai.model_name == "gpt-4"
        assert ai.llm is not None
        # In buggy code, create_chat_model signature is wrong; this will cause error.
        # After fix, it should work.

def test_ai_initialization_with_azure():
    """Test AI initialization with Azure endpoint uses AzureChatOpenAI."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        ai = AI(
            model_name="my-deployment",
            temperature=0.2,
            azure_endpoint="https://myresource.openai.azure.com"
        )
        assert ai.azure_endpoint == "https://myresource.openai.azure.com"
        assert ai.model_name == "my-deployment"
        assert ai.llm is not None

def test_create_chat_model_with_azure():
    """Test create_chat_model returns AzureChatOpenAI when azure_endpoint is set."""
    # Mock self with azure_endpoint attribute
    mock_self = MagicMock()
    mock_self.azure_endpoint = "https://myresource.openai.azure.com"
    # Mock AzureChatOpenAI import and instantiation
    with patch('gpt_engineer.ai.AzureChatOpenAI') as mock_azure:
        mock_azure.return_value = MagicMock()
        result = create_chat_model(mock_self, "my-deployment", 0.2)
        mock_azure.assert_called_once_with(
            openai_api_base="https://myresource.openai.azure.com",
            openai_api_version="2023-05-15",
            deployment_name="my-deployment",
            openai_api_type="azure",
            streaming=True,
        )
        assert result is mock_azure.return_value

def test_create_chat_model_without_azure():
    """Test create_chat_model returns ChatOpenAI when azure_endpoint is empty."""
    mock_self = MagicMock()
    mock_self.azure_endpoint = ""
    with patch('gpt_engineer.ai.ChatOpenAI') as mock_openai:
        mock_openai.return_value = MagicMock()
        result = create_chat_model(mock_self, "gpt-4", 0.1)
