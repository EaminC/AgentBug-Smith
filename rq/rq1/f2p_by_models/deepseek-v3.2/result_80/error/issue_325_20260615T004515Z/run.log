import sys
import pytest
from unittest.mock import patch, MagicMock
from gpt_engineer.ai import AI, create_chat_model, fallback_model

def test_ai_initialization_without_azure():
    """Test that AI initializes correctly without Azure endpoint."""
    ai = AI(model_name="gpt-4", temperature=0.1)
    assert ai.model_name == "gpt-4"
    assert ai.temperature == 0.1
    assert ai.azure_endpoint == ""
    # The llm should be a ChatOpenAI instance (mocked)
    assert ai.llm is not None

def test_ai_initialization_with_azure():
    """Test that AI initializes correctly with Azure endpoint."""
    # Mock the langchain imports to avoid actual API calls
    with patch('langchain.chat_models.AzureChatOpenAI') as mock_azure_chat:
        mock_azure_chat.return_value = MagicMock()
        ai = AI(
            model_name="my-gpt4-deployment",
            temperature=0.2,
            azure_endpoint="https://myairesource.openai.azure.com"
        )
        assert ai.model_name == "my-gpt4-deployment"
        assert ai.temperature == 0.2
        assert ai.azure_endpoint == "https://myairesource.openai.azure.com"
        # The llm should be an AzureChatOpenAI instance
        mock_azure_chat.assert_called_once_with(
            openai_api_base="https://myairesource.openai.azure.com",
            openai_api_version="2023-05-15",
            deployment_name="my-gpt4-deployment",
            openai_api_type="azure",
            streaming=True,
        )

def test_create_chat_model_without_azure():
    """Test create_chat_model without Azure endpoint."""
    # Mock the langchain imports
    with patch('langchain.chat_models.ChatOpenAI') as mock_chat_openai:
        mock_chat_openai.return_value = MagicMock()
        # Create a mock AI instance with no azure_endpoint
        mock_ai = MagicMock()
        mock_ai.azure_endpoint = ""
        model = create_chat_model(mock_ai, "gpt-4", 0.1)
        mock_chat_openai.assert_called_once_with(
            model="gpt-4",
            temperature=0.1,
            streaming=True,
        )

def test_create_chat_model_with_azure():
    """Test create_chat_model with Azure endpoint."""
    # Mock the langchain imports
    with patch('langchain.chat_models.AzureChatOpenAI') as mock_azure_chat:
        mock_azure_chat.return_value = MagicMock()
        # Create a mock AI instance with azure_endpoint
        mock_ai = MagicMock()
        mock_ai.azure_endpoint = "https://myairesource.openai.azure.com"
        model = create_chat_model(mock_ai, "my-gpt4-deployment", 0.2)
        mock_azure_chat.assert_called_once_with(
            openai_api_base="https://myairesource.openai.azure.com",
            openai_api_version="2023-05-15",
            deployment_name="my-gpt4-deployment",
            openai_api_type="azure",
            streaming=True,
        )

def test_fallback_model():
    """Test the fallback_model function."""
    # Test that gpt-4 returns gpt-4
    assert fallback_model("gpt-4") == "gpt-4"
    # Test that unknown model returns gpt-3.5-turbo
    assert fallback_model("unknown-model") == "gpt-3.5-turbo"
    # Test that gpt-3.5-turbo returns gpt-3.5-turbo
    assert fallback_model("gpt-3.5-turbo") == "gpt-3.5-turbo"

def test_ai_model_name_fallback_without_azure():
    """Test that model name fallback works without Azure."""
    ai = AI(model_name="unknown-model", temperature=0.1)
    # Without Azure, unknown model should fallback to gpt-3.5-turbo
    assert ai.model_name == "gpt-3.5-turbo"

def test_ai_model_name_no_fallback_with_azure():
    """Test that model name does NOT fallback with Azure endpoint."""
    # Mock the langchain imports
    with patch('langchain.chat_models.AzureChatOpenAI') as mock_azure_chat:
        mock_azure_chat.return_value = MagicMock()
        ai = AI(
            model_name="my-deployment",
            temperature=0.1,
            azure_endpoint="https://myairesource.openai.azure.com"
        )
        # With Azure, the model name should be used as-is (no fallback)
        assert ai.model_name == "my-deployment"

def test_main_with_azure_option():
    """Test that the main function accepts --azure option."""
    # We need to test that the CLI option is properly passed to AI
    # Since we can't easily test the CLI directly, we'll test the AI initialization
    # with the parameters that would come from main
    with patch('gpt_engineer.main.AI') as mock_ai_class:
        # Import and run main with Azure option
        import gpt_engineer.main
        # We'll test by patching sys.argv and calling main directly
        with patch.object(sys, 'argv', ['gpt-engineer', '--azure', 'https://myairesource.openai.azure.com', './projects/example/', 'my-deployment']):
            try:
                gpt_engineer.main.main()
            except SystemExit:
                pass  # main() calls typer which exits
        # Check that AI was called with azure_endpoint
        mock_ai_class.assert_called_once_with(
            model_name='my-deployment',
            temperature=0.1,
            azure_endpoint='https://myairesource.openai.azure.com'
        )

def test_environment_variable_for_api_key():
    """Test that OPENAI_API_KEY environment variable is used."""
    # This test ensures that the API key from environment is passed to the LLM
    # We'll mock the ChatOpenAI constructor and check its arguments
    with patch.dict(os.environ, {'OPENAI_API_KEY': 'test-key-123'}):
        with patch('langchain.chat_models.ChatOpenAI') as mock_chat_openai:
            mock_chat_openai.return_value = MagicMock()
            ai = AI(model_name="gpt-4", temperature=0.1)
            # The ChatOpenAI should be initialized with the API key from environment
            mock_chat_openai.assert_called_once()
            # Check that openai_api_key is not explicitly passed (it should come from environment)
            call_kwargs = mock_chat_openai.call_args[1]
            # In langchain, if openai_api_key is not provided, it reads from environment
            # So we just verify the call was made with expected parameters
            assert call_kwargs['model'] == 'gpt-4'
            assert call_kwargs['temperature'] == 0.1
            assert call_kwargs['streaming'] == True

if __name__ == "__main__":
