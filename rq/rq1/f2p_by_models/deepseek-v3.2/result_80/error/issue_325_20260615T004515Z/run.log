import sys
import pytest
from unittest.mock import patch, MagicMock
from gpt_engineer.ai import AI, create_chat_model, fallback_model


def test_ai_initialization_without_azure():
    """Test that AI initializes correctly without Azure endpoint."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        ai = AI(model_name="gpt-4", temperature=0.1)
        assert ai.model_name == "gpt-4"
        assert ai.temperature == 0.1
        assert ai.azure_endpoint == ""
        # The llm should be a ChatOpenAI instance (mocked)
        assert ai.llm is not None


def test_ai_initialization_with_azure():
    """Test that AI initializes correctly with Azure endpoint."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        endpoint = "https://myairesource.openai.azure.com"
        ai = AI(model_name="my-gpt4-deployment", temperature=0.2, azure_endpoint=endpoint)
        assert ai.model_name == "my-gpt4-deployment"
        assert ai.temperature == 0.2
        assert ai.azure_endpoint == endpoint
        # The llm should be an AzureChatOpenAI instance (mocked)
        assert ai.llm is not None


def test_create_chat_model_without_azure():
    """Test create_chat_model without Azure endpoint."""
    # Mock the AI instance with no azure_endpoint
    mock_ai = MagicMock()
    mock_ai.azure_endpoint = ""
    # Mock the ChatOpenAI constructor
    with patch("gpt_engineer.ai.ChatOpenAI") as mock_chat_openai:
        mock_chat_openai.return_value = "chat_openai_instance"
        result = create_chat_model(mock_ai, "gpt-4", 0.1)
        assert result == "chat_openai_instance"
        mock_chat_openai.assert_called_once_with(
            model="gpt-4",
            temperature=0.1,
            streaming=True,
            model_kwargs={"top_p": 0.95},
        )


def test_create_chat_model_with_azure():
    """Test create_chat_model with Azure endpoint."""
    # Mock the AI instance with azure_endpoint
    mock_ai = MagicMock()
    mock_ai.azure_endpoint = "https://myairesource.openai.azure.com"
    # Mock the AzureChatOpenAI constructor
    with patch("gpt_engineer.ai.AzureChatOpenAI") as mock_azure_chat_openai:
        mock_azure_chat_openai.return_value = "azure_chat_openai_instance"
        result = create_chat_model(mock_ai, "my-gpt4-deployment", 0.2)
        assert result == "azure_chat_openai_instance"
        mock_azure_chat_openai.assert_called_once_with(
            openai_api_base="https://myairesource.openai.azure.com",
            openai_api_version="2023-05-15",
            deployment_name="my-gpt4-deployment",
            openai_api_type="azure",
            streaming=True,
        )


def test_fallback_model():
    """Test fallback_model function."""
    # Test with valid model
    assert fallback_model("gpt-4") == "gpt-4"
    assert fallback_model("gpt-3.5-turbo") == "gpt-3.5-turbo"
    # Test with invalid model
    assert fallback_model("invalid-model") == "gpt-3.5-turbo"


def test_ai_tokenizer_setup():
    """Test that tokenizer is set up correctly."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        ai = AI(model_name="gpt-4")
        # The tokenizer should be set (mocked)
        assert ai.tokenizer is not None


def test_ai_with_azure_endpoint_and_fallback():
    """Test that model name is not changed when Azure endpoint is provided."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        ai = AI(model_name="my-deployment", azure_endpoint="https://example.openai.azure.com")
        # Model name should stay as given, not fallback
        assert ai.model_name == "my-deployment"
        # In the buggy code, fallback_model would be called regardless of azure_endpoint
        # This test will fail on buggy code because fallback_model would change the name


def test_ai_without_azure_endpoint_and_invalid_model():
    """Test that fallback is applied when no Azure endpoint and invalid model."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        ai = AI(model_name="invalid-model")
        # Should fallback to gpt-3.5-turbo
        assert ai.model_name == "gpt-3.5-turbo"


def test_main_cli_azure_option():
    """Test that the CLI accepts --azure option."""
    # Import main to test the parameter
    from gpt_engineer.main import main
    import typer
    # This test ensures the azure_endpoint parameter exists in main
    # We'll just verify by checking the function signature
    import inspect
    sig = inspect.signature(main)
    assert "azure_endpoint" in sig.parameters
    param = sig.parameters["azure_endpoint"]
    assert param.default == ""
    # Check the typer.Option annotation
    assert isinstance(param.default, typer.models.OptionInfo)


def test_azure_endpoint_passed_to_ai():
    """Test that azure_endpoint from CLI is passed to AI constructor."""
    # Mock the AI constructor to capture arguments
    with patch("gpt_engineer.main.AI") as mock_ai:
        from gpt_engineer.main import main
        import sys
        # Simulate CLI call with --azure
        test_args = ["gpt-engineer", "--azure", "https://test.openai.azure.com", "./projects/example/", "my-model"]
        with patch.object(sys, "argv", test_args):
            # We need to mock the rest of the main function to avoid side effects
            with patch("gpt_engineer.main.run") as mock_run:
                mock_run.return_value = None
                try:
                    main()
                except SystemExit:
                    pass  # Typer exits
        # Check that AI was called with azure_endpoint
        mock_ai.assert_called_once()
        call_kwargs = mock_ai.call_args[1]
        assert "azure_endpoint" in call_kwargs
        assert call_kwargs["azure_endpoint"] == "https://test.openai.azure.com"
        assert call_kwargs["model_name"] == "my-model"


