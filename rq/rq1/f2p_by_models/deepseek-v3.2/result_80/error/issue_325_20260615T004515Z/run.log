def test_ai_initialization_with_azure_and_gpt4_model():
    """Edge case: Azure endpoint with model name 'gpt-4' should not trigger fallback."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        with patch("gpt_engineer.ai.AzureChatOpenAI") as mock_azure_chat:
            mock_azure_chat.return_value = MagicMock()
            endpoint = "https://myairesource.openai.azure.com"
            ai = AI(model_name="gpt-4", temperature=0.1, azure_endpoint=endpoint)
            assert ai.model_name == "gpt-4"
            mock_azure_chat.assert_called_once_with(
                openai_api_base=endpoint,
                openai_api_version="2023-05-15",
                deployment_name="gpt-4",
                openai_api_type="azure",
                streaming=True,
            )[0m
