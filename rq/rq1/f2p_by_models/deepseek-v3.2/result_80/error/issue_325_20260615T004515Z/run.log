import pytest
from unittest.mock import patch, MagicMock, Mock
from gpt_engineer.ai import AI, create_chat_model, fallback_model


def test_ai_initialization_without_azure():
    """Test AI initialization without Azure endpoint uses ChatOpenAI."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        with patch("gpt_engineer.ai.ChatOpenAI") as mock_chat_openai:
            mock_instance = MagicMock()
            mock_chat_openai.return_value = mock_instance
            ai = AI(model_name="gpt-4", temperature=0.1, azure_endpoint="")
            assert ai.azure_endpoint == ""
            assert ai.model_name == "gpt-4"
            mock_chat_openai.assert_called_once_with(
                model="gpt-4",
                temperature=0.1,
                streaming=True,
                callbacks=None,
                model_kwargs={},
            )
            assert ai.llm == mock_instance


def test_ai_initialization_with_azure():
    """Test AI initialization with Azure endpoint uses AzureChatOpenAI."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        with patch("gpt_engineer.ai.AzureChatOpenAI") as mock_azure_chat:
            mock_instance = MagicMock()
            mock_azure_chat.return_value = mock_instance
            ai = AI(
                model_name="my-deployment",
                temperature=0.2,
                azure_endpoint="https://myresource.openai.azure.com",
            )
            assert ai.azure_endpoint == "https://myresource.openai.azure.com"
            assert ai.model_name == "my-deployment"
            mock_azure_chat.assert_called_once_with(
                openai_api_base="https://myresource.openai.azure.com",
                openai_api_version="2023-05-15",
                deployment_name="my-deployment",
                openai_api_type="azure",
                streaming=True,
            )
            assert ai.llm == mock_instance


