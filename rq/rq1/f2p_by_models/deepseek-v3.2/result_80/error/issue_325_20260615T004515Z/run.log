            # Model name should remain unchanged (no fallback) when Azure endpoint is provided
            assert ai.model_name == "custom-deployment"
            mock_azure_chat_openai.assert_called_once_with(
                openai_api_base="https://myairesource.openai.azure.com",
                openai_api_version="2023-05-15",
                deployment_name="custom-deployment",
                openai_api_type="azure",
                streaming=True,
            )


