    assert fallback_model("unknown-model") == "gpt-3.5-turbo"


def test_ai_model_name_fallback_without_azure():
    """Test that model name fallback works when no Azure endpoint."""
    with patch("gpt_engineer.ai.ChatOpenAI"):
        with patch("gpt_engineer.ai.get_tokenizer"):
            # Unknown model should fallback to gpt-3.5-turbo
            ai = AI(model_name="unknown-model", temperature=0.1, azure_endpoint="")
            assert ai.model_name == "gpt-3.5-turbo"


def test_ai_model_name_no_fallback_with_azure():
    """Test that model name is NOT fallbacked when Azure endpoint is provided."""
    with patch("gpt_engineer.ai.AzureChatOpenAI"):
        with patch("gpt_engineer.ai.get_tokenizer"):
            # With Azure endpoint, model name should be used as-is (deployment name)
            ai = AI(
                model_name="custom-deployment",
                temperature=0.1,
                azure_endpoint="https://example.openai.azure.com",
            )
            assert ai.model_name == "custom-deployment"


def test_main_cli_azure_option():
    """Test that main CLI accepts --azure option."""
    # Import main to ensure it has the azure_endpoint parameter
    from gpt_engineer.main import main
    import inspect
    sig = inspect.signature(main)
    # Check that azure_endpoint parameter exists
    assert "azure_endpoint" in sig.parameters
    param = sig.parameters["azure_endpoint"]
    # Check default value is empty string
    assert param.default == ""
    # Check that it's a typer.Option
    assert hasattr(param, "default")  # indirect check


