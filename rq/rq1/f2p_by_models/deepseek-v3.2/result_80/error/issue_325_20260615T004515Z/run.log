            assert call_kwargs["openai_api_base"] == self.azure_endpoint
            assert call_kwargs["deployment_name"] == "my-deployment"
            assert call_kwargs["openai_api_type"] == "azure"


def test_fallback_model():
    """Test fallback_model returns gpt-3.5-turbo for unknown models."""
    assert fallback_model("unknown") == "gpt-3.5-turbo"
    assert fallback_model("gpt-4") == "gpt-4"
    assert fallback_model("gpt-3.5-turbo") == "gpt-3.5-turbo"


