def test_create_chat_model_with_azure():
    """Test create_chat_model when azure_endpoint is set."""
    # We need to mock the internal network client used by AzureChatOpenAI
    # The bug is that create_chat_model signature changed.
    # In buggy code, create_chat_model is defined as def create_chat_model(model: str, temperature) -> BaseChatModel
    # but AI.__init__ calls create_chat_model(self, self.model_name, self.temperature)
    # This will cause a TypeError because too many arguments.
    # We'll test the fixed version: create_chat_model(self, model, temperature) with azure_endpoint.
    # We'll create a mock AI instance with azure_endpoint set.
    class MockAI:
        def __init__(self):
            self.azure_endpoint = "https://myairesource.openai.azure.com"

    mock_self = MockAI()
    with patch("gpt_engineer.ai.AzureChatOpenAI") as mock_azure_chat:
        mock_azure_chat.return_value = MagicMock()
        # In buggy code, this call will fail because create_chat_model expects 2 args.
        # In fixed code, it should succeed.
        result = create_chat_model(mock_self, "my-deployment", 0.1)
        # Assert AzureChatOpenAI was instantiated with correct parameters
        mock_azure_chat.assert_called_once_with(
            openai_api_base="https://myairesource.openai.azure.com",
            openai_api_version="2023-05-15",
            deployment_name="my-deployment",
            openai_api_type="azure",
            streaming=True,
        )
        assert result is not None


