    assert fallback_model("unknown-model") == "gpt-3.5-turbo"


def test_ai_with_azure_endpoint_and_fallback_model():
    """Test that model name is not changed when Azure endpoint is provided."""
    with patch("gpt_engineer.ai.AzureChatOpenAI") as mock_azure_chat_openai:
        mock_llm = MagicMock()
        mock_azure_chat_openai.return_value = mock_llm
        with patch("gpt_engineer.ai.tiktoken.get_encoding") as mock_get_encoding:
            mock_tokenizer = MagicMock()
            mock_get_encoding.return_value = mock_tokenizer
            ai = AI(
                model_name="custom-deployment",
                temperature=0.1,
                azure_endpoint="https://myairesource.openai.azure.com",
