[32mimport os
import sys
import pytest
from unittest.mock import patch, MagicMock
from gpt_engineer.ai import AI, create_chat_model, fallback_model


def test_ai_init_without_azure():
    """Test AI initialization without Azure endpoint uses ChatOpenAI."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        with patch("gpt_engineer.ai.ChatOpenAI") as mock_chat_openai:
            mock_instance = MagicMock()
            mock_chat_openai.return_value = mock_instance
            ai = AI(model_name="gpt-4", temperature=0.1, azure_endpoint="")
            assert ai.azure_endpoint == ""
            assert ai.model_name == "gpt-4"
            mock_chat_openai.assert_called_once_with(
                model="gpt-4",
                temperature=0.1,
                streaming=True,
                callbacks=None,
                model_kwargs={"top_p": 1.0},
            )
            assert ai.llm == mock_instance


def test_ai_init_with_azure():
    """Test AI initialization with Azure endpoint uses AzureChatOpenAI."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        with patch("gpt_engineer.ai.AzureChatOpenAI") as mock_azure_chat:
            mock_instance = MagicMock()
            mock_azure_chat.return_value = mock_instance
            ai = AI(
                model_name="my-deployment",
                temperature=0.2,
                azure_endpoint="https://myairesource.openai.azure.com",
            )
            assert ai.azure_endpoint == "https://myairesource.openai.azure.com"
            assert ai.model_name == "my-deployment"
            mock_azure_chat.assert_called_once_with(
                openai_api_base="https://myairesource.openai.azure.com",
                openai_api_version="2023-05-15",
                deployment_name="my-deployment",
                openai_api_type="azure",
                streaming=True,
            )
            assert ai.llm == mock_instance


def test_create_chat_model_without_azure():
    """Test create_chat_model without Azure endpoint returns ChatOpenAI."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        with patch("gpt_engineer.ai.ChatOpenAI") as mock_chat_openai:
            mock_instance = MagicMock()
            mock_chat_openai.return_value = mock_instance
            # Create a mock self object with azure_endpoint empty
            mock_self = MagicMock()
            mock_self.azure_endpoint = ""
            result = create_chat_model(mock_self, "gpt-4", 0.1)
            mock_chat_openai.assert_called_once_with(
                model="gpt-4",
                temperature=0.1,
                streaming=True,
                callbacks=None,
                model_kwargs={"top_p": 1.0},
            )
            assert result == mock_instance


def test_create_chat_model_with_azure():
    """Test create_chat_model with Azure endpoint returns AzureChatOpenAI."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        with patch("gpt_engineer.ai.AzureChatOpenAI") as mock_azure_chat:
            mock_instance = MagicMock()
            mock_azure_chat.return_value = mock_instance
            # Create a mock self object with azure_endpoint set
            mock_self = MagicMock()
            mock_self.azure_endpoint = "https://myairesource.openai.azure.com"
            result = create_chat_model(mock_self, "my-deployment", 0.2)
            mock_azure_chat.assert_called_once_with(
                openai_api_base="https://myairesource.openai.azure.com",
                openai_api_version="2023-05-15",
                deployment_name="my-deployment",
                openai_api_type="azure",
                streaming=True,
            )
            assert result == mock_instance


def test_fallback_model():
    """Test fallback_model returns correct model names."""
    assert fallback_model("gpt-4") == "gpt-4"
    assert fallback_model("gpt-3.5-turbo") == "gpt-3.5-turbo"
    assert fallback_model("unknown-model") == "gpt-3.5-turbo"


def test_ai_init_azure_endpoint_affects_model_name():
    """Test that AI.__init__ uses fallback_model only when azure_endpoint is empty."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        with patch("gpt_engineer.ai.ChatOpenAI") as mock_chat_openai:
            mock_chat_openai.return_value = MagicMock()
            ai1 = AI(model_name="unknown-model", azure_endpoint="")
            # In buggy code, fallback_model is always called, so model_name becomes "gpt-3.5-turbo"
            # In fixed code, fallback_model is called only when azure_endpoint == ""
            # The test will fail on buggy because model_name is incorrectly set.
            # We assert the expected fixed behavior.
            assert ai1.model_name == "gpt-3.5-turbo"

        with patch("gpt_engineer.ai.AzureChatOpenAI") as mock_azure_chat:
            mock_azure_chat.return_value = MagicMock()
            ai2 = AI(
                model_name="unknown-model",
                azure_endpoint="https://myairesource.openai.azure.com",
            )
            # In buggy code, fallback_model is always called, so model_name becomes "gpt-3.5-turbo"
            # In fixed code, fallback_model is NOT called, so model_name stays "unknown-model"
            # The test will fail on buggy because model_name is incorrectly changed.
            assert ai2.model_name == "unknown-model"


def test_ai_init_passes_self_to_create_chat_model():
    """Test that AI.__init__ passes self to create_chat_model."""
    with patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
        with patch("gpt_engineer.ai.create_chat_model") as mock_create:
            mock_create.return_value = MagicMock()
            ai = AI(model_name="gpt-4", azure_endpoint="")
            # In buggy code, create_chat_model is called with (model, temperature)
            # In fixed code, create_chat_model is called with (self, model, temperature)
            # The test will fail on buggy because create_chat_model receives wrong args.
            mock_create.assert_called_once_with(ai, "gpt-4", 0.1)


if __name__ == "__main__":
    pytest.main([__file__, "-v"])[0m
