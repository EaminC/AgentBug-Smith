            azure_endpoint="https://azure.openai.azure.com",
        )
        assert ai.model_name == "custom-deployment"
        # Verify fallback_model was not applied (since azure_endpoint != "")
        MockAzureChatOpenAI.assert_called_once()
        call_kwargs = MockAzureChatOpenAI.call_args[1]
        assert call_kwargs["deployment_name"] == "custom-deployment"


def test_ai_without_azure_endpoint_applies_fallback():
    """When azure_endpoint is empty, model_name should go through fallback_model."""
    with patch("gpt_engineer.ai.ChatOpenAI") as MockChatOpenAI:
        mock_llm = MagicMock()
        MockChatOpenAI.return_value = mock_llm
        # Mock fallback_model to return a different value
        with patch("gpt_engineer.ai.fallback_model", return_value="gpt-3.5-turbo"):
            ai = AI(model_name="unknown-model", temperature=0.1, azure_endpoint="")
            assert ai.model_name == "gpt-3.5-turbo"
            MockChatOpenAI.assert_called_once()
            call_kwargs = MockChatOpenAI.call_args[1]
            assert call_kwargs["model"] == "gpt-3.5-turbo"


