import os
from unittest.mock import patch, MagicMock
import pytest

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))

from gpt_engineer.ai import AI, create_chat_model, fallback_model


def test_azure_endpoint_support():
    """
    Test that AI can be instantiated with an Azure endpoint and that
    create_chat_model returns an AzureChatOpenAI instance when azure_endpoint is set.
    """
    # Mock the langchain imports to avoid actual network calls
    with patch("gpt_engineer.ai.AzureChatOpenAI") as MockAzureChatOpenAI, patch(
        "gpt_engineer.ai.ChatOpenAI"
    ) as MockChatOpenAI, patch("gpt_engineer.ai.openai") as mock_openai, patch(
        "gpt_engineer.ai.get_tokenizer"
    ) as mock_get_tokenizer:
        # Configure mocks
        mock_llm = MagicMock()
        MockAzureChatOpenAI.return_value = mock_llm
        MockChatOpenAI.return_value = mock_llm
        mock_get_tokenizer.return_value = MagicMock()

        # Test 1: Azure endpoint provided
        azure_endpoint = "https://myairesource.openai.azure.com"
        deployment_name = "my-gpt4-deployment"
        ai_with_azure = AI(
            model_name=deployment_name,
            temperature=0.1,
            azure_endpoint=azure_endpoint,
        )

        # Verify that AzureChatOpenAI was called with correct parameters
        MockAzureChatOpenAI.assert_called_once()
        call_kwargs = MockAzureChatOpenAI.call_args[1]
        assert call_kwargs["openai_api_base"] == azure_endpoint
        assert call_kwargs["deployment_name"] == deployment_name
        assert call_kwargs["openai_api_type"] == "azure"
        assert call_kwargs["streaming"] is True
        assert call_kwargs["openai_api_version"] == "2023-05-15"

        # Verify that ChatOpenAI was NOT called
        MockChatOpenAI.assert_not_called()

        # Verify that model_name is preserved (no fallback)
        assert ai_with_azure.model_name == deployment_name
        assert ai_with_azure.azure_endpoint == azure_endpoint

        # Reset mocks
        MockAzureChatOpenAI.reset_mock()
        MockChatOpenAI.reset_mock()

        # Test 2: No Azure endpoint (standard OpenAI)
        ai_standard = AI(model_name="gpt-4", temperature=0.1, azure_endpoint="")

        # Verify that ChatOpenAI was called with correct parameters
        MockChatOpenAI.assert_called_once()
        call_kwargs = MockChatOpenAI.call_args[1]
        assert call_kwargs["model"] == "gpt-4"
        assert call_kwargs["temperature"] == 0.1
        assert call_kwargs["streaming"] is True

        # Verify that AzureChatOpenAI was NOT called
        MockAzureChatOpenAI.assert_not_called()

        # Verify that model_name uses fallback logic
        assert ai_standard.model_name == "gpt-4"

        # Test 3: Fallback model behavior when no Azure endpoint
        ai_fallback = AI(model_name="unknown-model", temperature=0.2, azure_endpoint="")

        # Verify that ChatOpenAI was called with fallback model
        # The second call is for ai_fallback
        assert MockChatOpenAI.call_count == 2
        # Check the last call's model argument
        last_call_kwargs = MockChatOpenAI.call_args_list[1][1]
        # fallback_model should convert "unknown-model" to "gpt-3.5-turbo"
        assert last_call_kwargs["model"] == "gpt-3.5-turbo"

        # Test 4: create_chat_model function signature change
        # The patch changed create_chat_model to accept self as first parameter
        # This test ensures the function is callable with the new signature
        # when azure_endpoint is set
        ai_instance = AI(
            model_name=deployment_name,
            temperature=0.1,
            azure_endpoint=azure_endpoint,
        )
        # The AI constructor already calls create_chat_model internally
        # We just verify it was called with correct self reference
        assert ai_instance.llm is mock_llm


def test_azure_endpoint_with_fallback_model():
    """
    Test that when azure_endpoint is provided, the model_name is NOT passed through
    fallback_model (it should be used as-is as deployment name).
    """
    with patch("gpt_engineer.ai.AzureChatOpenAI") as MockAzureChatOpenAI, patch(
        "gpt_engineer.ai.ChatOpenAI"
    ) as MockChatOpenAI, patch("gpt_engineer.ai.get_tokenizer") as mock_get_tokenizer:
        mock_llm = MagicMock()
        MockAzureChatOpenAI.return_value = mock_llm
        mock_get_tokenizer.return_value = MagicMock()

        # This model name would normally fallback to gpt-3.5-turbo
        # But with Azure endpoint, it should be used as-is
        deployment_name = "some-custom-deployment"
        ai = AI(
            model_name=deployment_name,
            temperature=0.1,
            azure_endpoint="https://myairesource.openai.azure.com",
        )

        # Verify AzureChatOpenAI was called with the exact deployment name
        MockAzureChatOpenAI.assert_called_once()
        call_kwargs = MockAzureChatOpenAI.call_args[1]
        assert call_kwargs["deployment_name"] == deployment_name

        # Verify ChatOpenAI was never called
        MockChatOpenAI.assert_not_called()


def test_azure_endpoint_empty_string_same_as_none():
    """
    Test that empty string azure_endpoint is treated the same as not providing it
    (should use standard OpenAI).
    """
    with patch("gpt_engineer.ai.AzureChatOpenAI") as MockAzureChatOpenAI, patch(
        "gpt_engineer.ai.ChatOpenAI"
    ) as MockChatOpenAI, patch("gpt_engineer.ai.get_tokenizer") as mock_get_tokenizer:
        mock_llm = MagicMock()
        MockChatOpenAI.return_value = mock_llm
        mock_get_tokenizer.return_value = MagicMock()

        # Empty string should trigger standard OpenAI
        ai1 = AI(model_name="gpt-4", temperature=0.1, azure_endpoint="")

        # Not providing azure_endpoint (default) should also trigger standard OpenAI
        ai2 = AI(model_name="gpt-4", temperature=0.1)

        # Both should call ChatOpenAI, not AzureChatOpenAI
        assert MockChatOpenAI.call_count == 2
        MockAzureChatOpenAI.assert_not_called()


if __name__ == "__main__":
    pytest.main([__file__, "-v"])[0m
