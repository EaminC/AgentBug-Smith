[32mFROM python:3.10-slim AS test_builder

# Install system dependencies for headless browser, git, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    gnupg2 \
    libgtk-3-0 \
    libdbus-glib-1-2 \
    dbus-x11 \
    xvfb \
    ca-certificates \
    chromium \
    chromium-driver \
    firefox-esr \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for Forge and Python
ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=${FORGE_API_KEY} \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

WORKDIR /app

# Copy entire repository (including externally injected test scripts)
COPY . .

# Upgrade packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Determine install method based on repository evidence
# Check for src/ layout or imports to decide editable install
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." . 2>/dev/null; then \
    # src layout detected: avoid editable install, set PYTHONPATH
    export AVOID_EDITABLE=1 && \
    echo "src layout detected, skipping editable install"; \
    else \
    export AVOID_EDITABLE=0 && \
    echo "no src layout, will perform editable install"; \
    fi

# Install dependencies and project based on evidence
RUN if [ -f "requirements.txt" ]; then \
    # Use requirements.txt but strip Docker-excluded section
    sed -i '/Items below this point will not be included in the Docker Image/,$d' requirements.txt && \
    pip install -r requirements.txt; \
    fi && \
    # Install test dependencies unconditionally (as per critical instruction)
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai && \
    # Install the project itself (editable only if no src layout)
    if [ "$AVOID_EDITABLE" -eq 0 ]; then \
        pip install -e .; \
    fi

# Preflight import check to fail fast
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set PYTHONPATH for src layout cases (ensures tests can import)
ENV PYTHONPATH=/app

# Default command for test harness
CMD ["/bin/bash"]

# Second stage: minimal runtime image (production)
FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    chromium-driver \
    firefox-esr \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=${FORGE_API_KEY} \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

WORKDIR /app

COPY --from=test_builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=test_builder /app/autogpt ./autogpt
COPY --from=test_builder /app/requirements.txt .
# Strip dev/test sections from requirements.txt for production
RUN sed -i '/Items below this point will not be included in the Docker Image/,$d' requirements.txt && \
    sed -i '/##Dev/d' requirements.txt && \
    pip install --no-cache-dir -r requirements.txt

# Create non-root user
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

ENTRYPOINT ["python", "-m", "autogpt"][0m
