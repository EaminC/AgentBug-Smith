[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Copy entire repository to include externally-injected test scripts
COPY . .

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Install system dependencies for Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade core packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Determine package manager and install dependencies
# Check for uv.lock and pyproject.toml in ./python directory (as per repository layout)
RUN if [ -f "./python/uv.lock" ]; then \
        pip install uv && \
        uv sync --project ./python --locked --dev; \
    elif [ -f "./python/pyproject.toml" ]; then \
        # If only pyproject.toml exists, install project and test dependencies
        pip install -e ./python && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
        # Fallback: install from requirements.txt if present
        if [ -f "./python/requirements.txt" ]; then \
            pip install -r ./python/requirements.txt; \
        fi && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Detect src/ layout to avoid duplicate module loading
RUN if [ -d "./python/src" ] || (find ./python -name "*.py" -type f -exec grep -l "^\s*from src\.\|^\s*import src\." {} \; 2>/dev/null | head -n 1 | grep -q .); then \
        echo "src/ layout detected - setting PYTHONPATH and skipping editable install"; \
        export PYTHONPATH=/app/python:$PYTHONPATH; \
    else \
        echo "No src/ layout - performing editable install"; \
        pip install -e ./python; \
    fi

# Preflight import check to fail fast
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

