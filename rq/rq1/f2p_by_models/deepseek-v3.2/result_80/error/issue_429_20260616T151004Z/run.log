[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Install system dependencies for building Python packages and uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install uv for faster Python package management (as per README recommendation)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Copy entire repository (including any externally injected test scripts)
COPY . .

# Check for src/ layout or imports from src. to decide on editable install
RUN if [ -d "./python/src" ] || grep -Rq "^\s*from src\.|^\s*import src\." ./python/tests 2>/dev/null; then \
    echo "Detected src layout or src imports - skipping editable install" && \
    cd python && \
    uv pip install --upgrade pip setuptools wheel && \
    uv sync --locked --all-extras --dev 2>/dev/null || ( \
        echo "uv sync failed, falling back to pip" && \
        uv pip install -r requirements.txt 2>/dev/null || true && \
        uv pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai \
    ) && \
    echo "Setting PYTHONPATH to include /app/python" && \
    export PYTHONPATH="/app/python:$PYTHONPATH"; \
    else \
    echo "No src layout detected - performing editable install" && \
    cd python && \
    uv pip install --upgrade pip setuptools wheel && \
    uv sync --locked --all-extras --dev 2>/dev/null || ( \
        echo "uv sync failed, falling back to pip" && \
        uv pip install -r requirements.txt 2>/dev/null || true && \
        uv pip install -e . && \
        uv pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai \
    ); \
    fi

# Preflight check to verify core modules are available
RUN cd python && python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command for test environment
CMD ["/bin/bash"]

# Production stage (minimal runtime)
FROM python:3.12-slim AS runtime

WORKDIR /app

# Install runtime system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for production
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
