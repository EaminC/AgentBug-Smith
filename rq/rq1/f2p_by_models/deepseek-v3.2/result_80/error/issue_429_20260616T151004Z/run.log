    mock_config.base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
    mock_config.parameters = {"temperature": 0.7, "max_tokens": 16384}
    mock_config.embedding_parameters = {"dimensions": 2048, "encoding_format": "float"}

    # 3. Instantiate the provider
    provider = DashScopeProvider(mock_config)
    assert provider.config is mock_config

    # 4. Mock the agno imports to avoid actual API calls
    with patch("agno.models.dashscope.DashScope") as MockDashScope:
        with patch("agno.knowledge.embedder.openai.OpenAIEmbedder") as MockEmbedder:
            # 4a. Test model creation
            model = provider.create_model()
            MockDashScope.assert_called_once()
            call_kwargs = MockDashScope.call_args[1]
            assert call_kwargs["id"] == "qwen3-max"
            assert call_kwargs["api_key"] == "fake-dashscope-key"
            assert call_kwargs["base_url"] is None  # because base_url contains "compatible-mode"
            assert call_kwargs["temperature"] == 0.7
            assert call_kwargs["max_tokens"] == 16384
            assert model is MockDashScope.return_value

            # 4b. Test embedder creation
            embedder = provider.create_embedder()
            MockEmbedder.assert_called_once()
            call_kwargs = MockEmbedder.call_args[1]
            assert call_kwargs["id"] == "text-embedding-v4"
            assert call_kwargs["api_key"] == "fake-dashscope-key"
            assert call_kwargs["base_url"] == "https://dashscope.aliyuncs.com/compatible-mode/v1"
            assert call_kwargs["dimensions"] == 2048
            assert call_kwargs["encoding_format"] == "float"
            assert embedder is MockEmbedder.return_value

    # 5. Test through ModelFactory with a mock config manager
    with patch.object(ConfigManager, "get_provider_config") as mock_get_config:
        mock_get_config.return_value = mock_config
        factory = ModelFactory()
        # This should not raise KeyError after the fix
        model = factory.create_model("dashscope", model_id="qwen-plus")
        # The factory will call provider.create_model, which we have mocked above.
        # We just need to ensure no exception is raised.
        assert model is not None


def test_dashscope_provider_without_agno():
    """Test that DashScopeProvider raises ImportError if agno is not installed."""
    # Simulate missing agno module
    import builtins
    real_import = builtins.__import__

    def mock_import(name, *args, **kwargs):
        if name == "agno.models.dashscope" or name == "agno.knowledge.embedder.openai":
            raise ImportError("No module named 'agno'")
        return real_import(name, *args, **kwargs)

    with patch("builtins.__import__", side_effect=mock_import):
        mock_config = MagicMock()
        mock_config.default_model = "qwen3-max"
        mock_config.default_embedding_model = "text-embedding-v4"
        provider = DashScopeProvider(mock_config)
        with pytest.raises(ImportError, match="agno package not installed"):
            provider.create_model()
        with pytest.raises(ImportError, match="agno package not installed"):
            provider.create_embedder()


def test_dashscope_config_integration():
    """Test that the config.yaml includes dashscope and the provider is loadable."""
    # This test assumes the fixed config.yaml is present.
    # We'll check that the config manager can load dashscope provider config.
    config_manager = ConfigManager()
    # The config manager should have a dashscope entry in models.providers
    providers = config_manager.config.get("models", {}).get("providers", {})
    assert "dashscope" in providers
    dashscope_config = providers["dashscope"]
    assert dashscope_config["config_file"] == "providers/dashscope.yaml"
    assert dashscope_config["api_key_env"] == "DASHSCOPE_API_KEY"

    # Try to load the provider config (this will read the YAML file)
    # If the file is missing in buggy code, this may raise an exception.
    provider_config = config_manager.get_provider_config("dashscope")
    assert provider_config is not None
    assert provider_config["name"] == "DashScope"
    assert provider_config["provider_type"] == "dashscope"
    assert provider_config["enabled"] is True
    assert provider_config["connection"]["base_url"] == "https://dashscope.aliyuncs.com/compatible-mode/v1"
    assert provider_config["connection"]["api_key_env"] == "DASHSCOPE_API_KEY"
    assert provider_config["default_model"] == "qwen3-max"


