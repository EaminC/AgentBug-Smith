[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Copy entire repository
COPY . .

# Detect src layout and import patterns
RUN if [ -d "./python/src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." ./python/tests 2>/dev/null; then \
        echo "src layout detected, skipping editable install"; \
        export SKIP_EDITABLE_INSTALL=1; \
    else \
        echo "no src layout, will perform editable install"; \
        export SKIP_EDITABLE_INSTALL=0; \
    fi

# Install uv if uv.lock exists (preferred), else fallback to pip
RUN cd ./python && \
    python -m pip install --upgrade pip setuptools wheel && \
    if [ -f "uv.lock" ]; then \
        pip install uv && \
        uv sync --locked --all-extras --dev; \
    elif [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    else \
        echo "No uv.lock or requirements.txt found, installing from pyproject.toml"; \
    fi && \
    if [ "$SKIP_EDITABLE_INSTALL" -eq 0 ]; then \
        pip install -e .; \
    fi && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Preflight check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

FROM python:3.12-slim AS runtime

WORKDIR /app

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

COPY --from=test_builder /app/python /app
COPY --from=test_builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=test_builder /usr/local/bin /usr/local/bin

# Install only production dependencies
