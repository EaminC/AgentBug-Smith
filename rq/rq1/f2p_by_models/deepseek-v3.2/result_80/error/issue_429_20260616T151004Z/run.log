ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libssl-dev \
    libffi-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install uv
RUN python -m pip install --upgrade pip setuptools wheel
RUN python -m pip install uv

# Copy entire repository to include externally-injected test scripts
COPY . .

# Switch to python directory for dependency installation
WORKDIR /app/python

# branch: python/uv.lock with hatchling build system

# Install dependencies using uv (creates virtual environment at .venv)
RUN uv sync --locked --dev

# Install project in development mode
RUN uv pip install -e .

# Install additional test dependencies
RUN uv pip install "pytest" "pytest-mock" "pytest-xdist" "pytest-timeout" "mem0ai" "litellm" "anyio" "setuptools<=81.0.0"

# Set PYTHONPATH to include the project
ENV PYTHONPATH=/app/python

# Preflight check - test critical imports using venv python
RUN .venv/bin/python -c "import pkg_resources; import pytest; print('pytest version:', pytest.__version__); print('preflight ok')"

# Install standard Python packages for standalone script execution
RUN uv pip install requests numpy pandas

# Add venv bin to PATH for easier access
ENV PATH="/app/python/.venv/bin:$PATH"

# Set working directory back to root for bash shell
WORKDIR /app

CMD ["/bin/bash"][0m
