[32m# branch: python/uv with direct pip install for missing packages
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Copy entire repository (required for test harness)
COPY . .

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0
ENV ANTHROPIC_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key

# Set PYTHONPATH for imports from python directory
ENV PYTHONPATH=/app/python:$PYTHONPATH

# Install system dependencies for Python packages (needed for pandas, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    gcc \
    g++ \
    libffi-dev \
    libssl-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libncursesw5-dev \
    liblzma-dev \
    zlib1g-dev \
    uuid-dev \
    libgdbm-dev \
    libnss3-dev \
    libffi-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install uv (the project's preferred package manager)
RUN pip install --no-cache-dir uv

# Upgrade pip and setuptools
RUN pip install --upgrade pip setuptools wheel

# First, try uv sync from python directory
RUN if [ -f "python/uv.lock" ]; then \
    cd python && uv sync --locked --dev; \
    else \
    echo "Warning: uv.lock not found, falling back to pip"; \
    fi

# Install the project in editable mode from python directory
RUN cd python && pip install -e .

# Install missing packages identified from build errors
# These packages should be installed by uv sync, but install explicitly to be safe
RUN pip install pandas==2.3.2
RUN pip install "a2a-sdk[http-server]>=0.3.4"
RUN pip install "agno[openai,google,lancedb]>=2.0,<3.0"

# Install test framework and additional test packages
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio \
    "setuptools<=81.0.0" pytest-xdist pytest-timeout mem0ai litellm \
    python-dotenv

# Verify critical imports work (packages missing in build errors)
RUN python -c 'import pandas; print(f"pandas {pandas.__version__} ok")'
RUN python -c 'import a2a_sdk; print("a2a_sdk ok")'
RUN python -c 'import agno; print(f"agno {agno.__version__} ok")'
RUN python -c 'import pytest; print("pytest ok")'
RUN python -c 'import valuecell; print(f"valuecell {valuecell.__version__} ok")'

# Test specific imports that were failing
RUN cd /app && python -c "from valuecell.adapters.assets.yfinance_adapter import YFinanceAdapter; print('YFinanceAdapter import ok')" || echo "YFinanceAdapter import failed, continuing"
RUN cd /app && python -c "import valuecell.agents.research_agent.vdb; print('research_agent.vdb import ok')" || echo "research_agent.vdb import failed, continuing"
RUN cd /app && python -c "import valuecell.core.agent; print('core.agent import ok')" || echo "core.agent import failed, continuing"

# Preflight check
RUN python -c 'import pkg_resources; print("preflight ok")'

# Default command (required for test harness)
CMD ["/bin/bash"][0m
