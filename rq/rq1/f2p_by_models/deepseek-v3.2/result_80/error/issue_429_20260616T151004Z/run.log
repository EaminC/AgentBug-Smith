[32mFROM python:3.12-slim AS builder

WORKDIR /app

# Install system dependencies needed for Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy the entire project
COPY . .

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Detect if src layout is used to avoid duplicate module loading
RUN if [ -d "python/src" ] || grep -Rq "^\s*from src\.|^\s*import src\." python/tests 2>/dev/null; then \
        echo "Detected src layout, skipping editable install"; \
        export SKIP_EDITABLE_INSTALL=1; \
    else \
        echo "No src layout detected, will perform editable install"; \
        export SKIP_EDITABLE_INSTALL=0; \
    fi

# Install Python dependencies using uv if available, otherwise pip
WORKDIR /app/python
RUN python -m pip install --upgrade pip setuptools wheel && \
    if [ -f "uv.lock" ]; then \
        pip install uv && \
        uv sync --locked --all-extras --dev; \
    elif [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    else \
        echo "No requirements.txt found, installing base dependencies"; \
    fi && \
    if [ "$SKIP_EDITABLE_INSTALL" = "0" ]; then \
        pip install -e .; \
    fi && \
    # Install mandatory test dependencies
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Preflight check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests from the Makefile target
RUN if [ -f "/app/Makefile" ]; then \
        cd /app && make test; \
    else \
        pytest valuecell/core/ --cov=valuecell.core; \
    fi

# Production stage
FROM python:3.12-slim

WORKDIR /app

# Install runtime system dependencies (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Copy only the python directory from builder
COPY --from=builder /app/python /app/python
COPY --from=builder /app/python/pyproject.toml /app/python/

WORKDIR /app/python

# Install production dependencies only (no dev extras)
RUN python -m pip install --upgrade pip setuptools wheel && \
    if [ -f "uv.lock" ]; then \
        pip install uv && \
        uv sync --locked --no-dev; \
    elif [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    else \
        pip install .; \
    fi

# Set Forge environment variables in production
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Default command
CMD ["/bin/bash"][0m
