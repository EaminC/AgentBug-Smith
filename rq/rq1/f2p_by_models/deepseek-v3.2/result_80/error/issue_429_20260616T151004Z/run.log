# Upgrade packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Detect src layout to avoid duplicate module loading
RUN if [ -d "python/src" ] || grep -Rq "^\s*from src\.|^\s*import src\." python/ 2>/dev/null; then \
    echo "src layout detected - skipping editable install"; \
    ENV PYTHONPATH=/app/python; \
    else \
    echo "no src layout - will perform editable install"; \
    fi

# Install dependencies based on evidence from repository files
WORKDIR /app/python

# Check for uv.lock (uv is mentioned in README and workflows)
RUN if [ -f "uv.lock" ]; then \
    pip install uv && \
    uv sync --locked --all-extras --dev; \
    # Install test dependencies unconditionally (pytest etc.)
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    # If src layout detected, skip editable install; else install project
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." . 2>/dev/null; then \
        echo "src layout - skipping editable install"; \
    else \
        pip install -e .; \
    fi; \
# Fallback: check for pyproject.toml
elif [ -f "pyproject.toml" ]; then \
    # Check for poetry.lock
    if [ -f "poetry.lock" ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi; \
    else \
        # No lockfile - use pip editable install
        pip install -e .; \
    fi; \
    # Install test dependencies unconditionally
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
# Final fallback: check for requirements.txt
elif [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt; \
    # Install test dependencies unconditionally
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    # If src layout detected, skip editable install; else install project
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." . 2>/dev/null; then \
        echo "src layout - skipping editable install"; \
    else \
        pip install -e .; \
    fi; \
else \
    # No dependency file found - install test dependencies only
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
fi

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set PYTHONPATH if src layout detected (fallback from earlier detection)
ENV PYTHONPATH=${PYTHONPATH:-/app/python}

# Run tests (as per Makefile target)
CMD ["/bin/bash"]

# Production stage (minimal)
FROM python:3.12-slim AS runtime

WORKDIR /app

# Copy only python directory for production
