        with patch("agno.models.dashscope.DashScope", mock_dashscope):
            config = MagicMock()
            config.default_model = "qwen3-max"
            config.parameters = {"temperature": 0.7, "max_tokens": 16384}
            config.api_key = "test_key"
            config.base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
            provider = DashScopeProvider(config=config)
            model = provider.create_model()
            assert model == "mock_model"
            mock_dashscope.assert_called_once_with(
