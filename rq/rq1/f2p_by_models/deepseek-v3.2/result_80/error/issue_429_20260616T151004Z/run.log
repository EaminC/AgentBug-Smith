        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi --only main; \
    else \
        pip install .; \
    fi; \
elif [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt; \
    pip install .; \
else \
    pip install .; \
fi

