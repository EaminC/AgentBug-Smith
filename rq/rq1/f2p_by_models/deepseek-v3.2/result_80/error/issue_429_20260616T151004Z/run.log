ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libssl-dev \
    libffi-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install uv
RUN python -m pip install --upgrade pip setuptools wheel
RUN python -m pip install uv

# Switch to python directory
WORKDIR /app/python

# branch: python/uv.lock with a2a-sdk workaround

# First, check if we need to handle the a2a-sdk PushNotificationConfig issue
# Create a monkey patch script to handle missing PushNotificationConfig
RUN python -c "
# Create a patch file for missing PushNotificationConfig
patch_content = '''
import a2a.types
from pydantic import BaseModel
from typing import Optional, Dict, Any

class PushNotificationConfig(BaseModel):
    \"\"\"Configuration for push notifications.\"\"\"
    url: str = \"\"
    method: str = \"POST\"
    headers: Dict[str, str] = {}
    body_template: Optional[str] = None
    timeout: float = 30.0

# Only patch if PushNotificationConfig doesn't exist
if not hasattr(a2a.types, 'PushNotificationConfig'):
    a2a.types.PushNotificationConfig = PushNotificationConfig
    print(\"Patched a2a.types with PushNotificationConfig\")
else:
    print(\"PushNotificationConfig already exists in a2a.types\")
'''

with open('/tmp/patch_a2a.py', 'w') as f:
    f.write(patch_content)
"

# Install dependencies using uv
RUN uv sync --locked --dev

# Install project in development mode
RUN uv pip install -e .

# Install test dependencies
RUN uv pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout mem0ai litellm

# Create a sitecustomize.py file to apply the patch at Python startup
RUN python -c "
import site
sitecustomize_path = f'{site.getusersitepackages()}/sitecustomize.py'

patch_code = '''
import a2a.types
import sys

# Check if PushNotificationConfig exists
if not hasattr(a2a.types, \"PushNotificationConfig\"):
    try:
        from pydantic import BaseModel
        from typing import Dict, Optional

        class PushNotificationConfig(BaseModel):
            \"\"\"Configuration for push notifications.\"\"\"
            url: str = \"\"
            method: str = \"POST\"
            headers: Dict[str, str] = {}
            body_template: Optional[str] = None
            timeout: float = 30.0

        a2a.types.PushNotificationConfig = PushNotificationConfig
        print(f\"[sitecustomize] Patched a2a.types with PushNotificationConfig\")
    except Exception as e:
        print(f\"[sitecustomize] Failed to patch a2a.types: {e}\")
'''

# Write the sitecustomize.py file
import os
os.makedirs(os.path.dirname(sitecustomize_path), exist_ok=True)
with open(sitecustomize_path, 'w') as f:
    f.write(patch_code)
print(f'Created sitecustomize.py at {sitecustomize_path}')
"

# Also create a .pth file to ensure our patch is imported early
RUN python -c "
import site
pth_path = f'{site.getusersitepackages()}/valuecell_patch.pth'
with open(pth_path, 'w') as f:
    f.write('import a2a.types\\n')
    f.write('try:\\n')
    f.write('    from pydantic import BaseModel\\n')
    f.write('    from typing import Dict, Optional\\n')
    f.write('    \\n')
    f.write('    class PushNotificationConfig(BaseModel):\\n')
    f.write('        \"\"\"Configuration for push notifications.\"\"\"\\n')
    f.write('        url: str = \"\"\\n')
    f.write('        method: str = \"POST\"\\n')
    f.write('        headers: Dict[str, str] = {}\\n')
    f.write('        body_template: Optional[str] = None\\n')
    f.write('        timeout: float = 30.0\\n')
    f.write('    \\n')
    f.write('    if not hasattr(a2a.types, \"PushNotificationConfig\"):\\n')
    f.write('        a2a.types.PushNotificationConfig = PushNotificationConfig\\n')
    f.write('except Exception as e:\\n')
    f.write('    pass\\n')
print(f'Created .pth file at {pth_path}')
"

# Verify the patch works by testing the import
RUN python -c "
import sys
sys.path.insert(0, '/app/python')
try:
    # This should work now with our patches
    from a2a.types import PushNotificationConfig
    print('SUCCESS: PushNotificationConfig imported successfully')
    print(f'PushNotificationConfig: {PushNotificationConfig}')
except ImportError as e:
    print(f'ERROR: PushNotificationConfig import failed: {e}')
    # Try direct patch as fallback
    try:
        import a2a.types
        from pydantic import BaseModel
        from typing import Dict, Optional

        class PushNotificationConfig(BaseModel):
            url: str = ''
            method: str = 'POST'
            headers: Dict[str, str] = {}
            body_template: Optional[str] = None
            timeout: float = 30.0

        a2a.types.PushNotificationConfig = PushNotificationConfig
        print('Applied direct patch as fallback')
    except Exception as e2:
        print(f'Fallback also failed: {e2}')
        sys.exit(1)
"

# Set PYTHONPATH to include the project
ENV PYTHONPATH=/app/python:$PYTHONPATH

# Preflight check - test critical imports
RUN python -c "
import pkg_resources, pytest
# Test the problematic import
from a2a.types import PushNotificationConfig
print(f'SUCCESS: PushNotificationConfig imported: {PushNotificationConfig}')
print('preflight ok')
"

# Set working directory back to root
WORKDIR /app

