class TestDashScopeProvider:
    """Test that DashScopeProvider is correctly integrated and can create models."""

    def test_dashscope_provider_registered(self):
        """Check that DashScopeProvider is registered in ModelFactory."""
        factory = ModelFactory()
        assert "dashscope" in factory._provider_classes
        assert factory._provider_classes["dashscope"] == DashScopeProvider

    def test_dashscope_provider_import_error_without_agno(self):
        """DashScopeProvider.create_model should raise ImportError if agno not installed."""
        provider = DashScopeProvider(MagicMock())
        with patch.dict(sys.modules, {"agno.models.dashscope": None}):
            with pytest.raises(ImportError, match="agno package not installed"):
                provider.create_model()

    def test_dashscope_provider_creates_model_with_agno_mocked(self):
        """DashScopeProvider.create_model should call agno's DashScope with correct parameters."""
        # Mock the agno module
        mock_dashscope = MagicMock()
        mock_agno_module = MagicMock()
        mock_agno_module.DashScope = mock_dashscope
        with patch.dict(sys.modules, {"agno.models.dashscope": mock_agno_module}):
            provider = DashScopeProvider(MagicMock())
            provider.config.default_model = "qwen3-max"
            provider.config.api_key = "test-key"
            provider.config.base_url = None
            provider.config.parameters = {"temperature": 0.7, "max_tokens": 1000}

            model = provider.create_model()

            # Verify DashScope was called with correct arguments
            mock_dashscope.assert_called_once_with(
                id="qwen3-max",
                api_key="test-key",
                base_url=None,
                temperature=0.7,
                max_tokens=1000,
                top_p=None,
            )
            assert model is mock_dashscope.return_value

    def test_dashscope_provider_embedder_import_error(self):
        """DashScopeProvider.create_embedder should raise ImportError if agno not installed."""
        provider = DashScopeProvider(MagicMock())
