[32mimport os
import sys
import pytest
from unittest.mock import patch, MagicMock
from valuecell.adapters.models.factory import ModelFactory, DashScopeProvider
from valuecell.config.manager import ConfigManager


class TestDashScopeProvider:
    """Test DashScope provider creation and configuration."""

    def test_dashscope_provider_registered(self):
        """Check that DashScopeProvider is registered in ModelFactory."""
        factory = ModelFactory()
        assert "dashscope" in factory._providers
        assert factory._providers["dashscope"] == DashScopeProvider

    def test_dashscope_provider_creation_without_config(self):
        """Test that DashScopeProvider can be instantiated without config."""
        provider = DashScopeProvider(config=None)
        assert provider.config is None

    def test_dashscope_provider_create_model_import_error(self):
        """Test that create_model raises ImportError when agno is missing."""
        provider = DashScopeProvider(config=None)
        with patch.dict(sys.modules, {"agno.models.dashscope": None}):
            with pytest.raises(ImportError) as exc_info:
                provider.create_model()
        assert "agno package not installed" in str(exc_info.value)

    def test_dashscope_provider_create_model_success(self):
        """Test successful model creation with mocked agno."""
        mock_config = MagicMock()
        mock_config.default_model = "qwen3-max"
        mock_config.parameters = {"temperature": 0.7, "max_tokens": 16384}
        mock_config.api_key = "test-key"
        mock_config.base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"

        provider = DashScopeProvider(config=mock_config)

        mock_dashscope = MagicMock()
        with patch("agno.models.dashscope.DashScope", mock_dashscope):
            model = provider.create_model()

        # Verify DashScope was called with correct arguments
        mock_dashscope.assert_called_once()
        call_kwargs = mock_dashscope.call_args[1]
        assert call_kwargs["id"] == "qwen3-max"
        assert call_kwargs["api_key"] == "test-key"
        # base_url should be None because it contains "compatible-mode"
        assert call_kwargs["base_url"] is None
        assert call_kwargs["temperature"] == 0.7
        assert call_kwargs["max_tokens"] == 16384

    def test_dashscope_provider_create_model_with_custom_id(self):
        """Test model creation with custom model_id."""
        mock_config = MagicMock()
        mock_config.default_model = "qwen3-max"
        mock_config.parameters = {}
        mock_config.api_key = "test-key"
        mock_config.base_url = None

        provider = DashScopeProvider(config=mock_config)

        mock_dashscope = MagicMock()
        with patch("agno.models.dashscope.DashScope", mock_dashscope):
            model = provider.create_model(model_id="qwen-plus")

        call_kwargs = mock_dashscope.call_args[1]
        assert call_kwargs["id"] == "qwen-plus"

    def test_dashscope_provider_create_embedder_import_error(self):
        """Test that create_embedder raises ImportError when agno is missing."""
        provider = DashScopeProvider(config=None)
        with patch.dict(sys.modules, {"agno.knowledge.embedder.openai": None}):
            with pytest.raises(ImportError) as exc_info:
                provider.create_embedder()
        assert "agno package not installed" in str(exc_info.value)

    def test_dashscope_provider_create_embedder_no_model_error(self):
        """Test create_embedder raises ValueError when no model specified."""
        mock_config = MagicMock()
        mock_config.default_embedding_model = None
        mock_config.name = "DashScope"
        mock_config.embedding_parameters = {}
        mock_config.api_key = "test-key"
        mock_config.base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"

        provider = DashScopeProvider(config=mock_config)

        with patch("agno.knowledge.embedder.openai.OpenAIEmbedder"):
            with pytest.raises(ValueError) as exc_info:
                provider.create_embedder()
        assert "No embedding model specified" in str(exc_info.value)

    def test_dashscope_provider_create_embedder_success(self):
        """Test successful embedder creation with mocked OpenAIEmbedder."""
        mock_config = MagicMock()
        mock_config.default_embedding_model = "text-embedding-v4"
        mock_config.embedding_parameters = {"dimensions": 2048, "encoding_format": "float"}
        mock_config.api_key = "test-key"
        mock_config.base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
        mock_config.name = "DashScope"

        provider = DashScopeProvider(config=mock_config)

        mock_embedder = MagicMock()
        with patch("agno.knowledge.embedder.openai.OpenAIEmbedder", mock_embedder):
            embedder = provider.create_embedder()

        mock_embedder.assert_called_once()
        call_kwargs = mock_embedder.call_args[1]
        assert call_kwargs["id"] == "text-embedding-v4"
        assert call_kwargs["api_key"] == "test-key"
        assert call_kwargs["base_url"] == "https://dashscope.aliyuncs.com/compatible-mode/v1"
        assert call_kwargs["dimensions"] == 2048
        assert call_kwargs["encoding_format"] == "float"

    def test_dashscope_provider_create_embedder_with_custom_model(self):
        """Test embedder creation with custom model_id."""
        mock_config = MagicMock()
        mock_config.default_embedding_model = "text-embedding-v4"
        mock_config.embedding_parameters = {}
        mock_config.api_key = "test-key"
        mock_config.base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
        mock_config.name = "DashScope"

        provider = DashScopeProvider(config=mock_config)

        mock_embedder = MagicMock()
        with patch("agno.knowledge.embedder.openai.OpenAIEmbedder", mock_embedder):
            embedder = provider.create_embedder(model_id="text-embedding-v3", dimensions=1024)

        call_kwargs = mock_embedder.call_args[1]
        assert call_kwargs["id"] == "text-embedding-v3"
        assert call_kwargs["dimensions"] == 1024

    def test_factory_create_dashscope_model(self):
        """Test ModelFactory can create a DashScope model via provider."""
        # Mock config manager to return dashscope provider config
        mock_config_manager = MagicMock(spec=ConfigManager)
        mock_provider_config = MagicMock()
        mock_provider_config.provider_type = "dashscope"
        mock_provider_config.name = "DashScope"
        mock_provider_config.default_model = "qwen3-max"
        mock_provider_config.parameters = {"temperature": 0.7}
        mock_provider_config.api_key = "test-key"
        mock_provider_config.base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
        mock_config_manager.get_provider_config.return_value = mock_provider_config

        factory = ModelFactory(config_manager=mock_config_manager)

        mock_dashscope = MagicMock()
        with patch("agno.models.dashscope.DashScope", mock_dashscope):
            model = factory.create_model(provider_type="dashscope")

        mock_config_manager.get_provider_config.assert_called_once_with("dashscope")
        mock_dashscope.assert_called_once()
        call_kwargs = mock_dashscope.call_args[1]
        assert call_kwargs["id"] == "qwen3-max"
        assert call_kwargs["api_key"] == "test-key"

    def test_dashscope_config_in_default_config(self):
        """Test that dashscope provider config is present in default config."""
        # This test will fail on buggy code because dashscope.yaml doesn't exist
        config_manager = ConfigManager()
        # This should load the configs/providers/dashscope.yaml file
        # If the file doesn't exist, it will raise an error
        provider_config = config_manager.get_provider_config("dashscope")
        assert provider_config is not None
        assert provider_config.provider_type == "dashscope"
        assert provider_config.name == "DashScope"
        # Verify some expected fields from the YAML
        assert hasattr(provider_config, "default_model")
        assert provider_config.default_model == "qwen3-max"
        assert hasattr(provider_config, "connection")
        assert provider_config.connection["base_url"] == "https://dashscope.aliyuncs.com/compatible-mode/v1"

    def test_dashscope_provider_without_compatible_mode_url(self):
        """Test that base_url is used when it doesn't contain 'compatible-mode'."""
        mock_config = MagicMock()
        mock_config.default_model = "qwen3-max"
        mock_config.parameters = {}
        mock_config.api_key = "test-key"
        mock_config.base_url = "https://dashscope.aliyuncs.com/api/v1"  # No compatible-mode

        provider = DashScopeProvider(config=mock_config)

        mock_dashscope = MagicMock()
        with patch("agno.models.dashscope.DashScope", mock_dashscope):
            model = provider.create_model()

        call_kwargs = mock_dashscope.call_args[1]
        assert call_kwargs["base_url"] == "https://dashscope.aliyuncs.com/api/v1"

    def test_dashscope_embedder_dimensions_conversion(self):
        """Test that dimensions parameter is converted to int."""
        mock_config = MagicMock()
        mock_config.default_embedding_model = "text-embedding-v4"
        mock_config.embedding_parameters = {"dimensions": "2048", "encoding_format": "float"}
        mock_config.api_key = "test-key"
        mock_config.base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
        mock_config.name = "DashScope"

        provider = DashScopeProvider(config=mock_config)

        mock_embedder = MagicMock()
        with patch("agno.knowledge.embedder.openai.OpenAIEmbedder", mock_embedder):
            embedder = provider.create_embedder()

        call_kwargs = mock_embedder.call_args[1]
        # dimensions should be int, not str
        assert call_kwargs["dimensions"] == 2048
        assert isinstance(call_kwargs["dimensions"], int)[0m
