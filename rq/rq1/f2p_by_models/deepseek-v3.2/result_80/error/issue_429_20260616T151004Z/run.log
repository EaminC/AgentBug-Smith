import sys
import pytest
from unittest.mock import patch, MagicMock, AsyncMock
from valuecell.adapters.models.factory import ModelFactory, DashScopeProvider
from valuecell.config.manager import ConfigManager


def test_dashscope_provider_creation_buggy():
    """
    Test that DashScopeProvider can be instantiated and create_model works.
    In buggy codebase, DashScopeProvider does not exist, so import fails.
    After patch, it should exist and create_model should work with mocked agno.
    """
    # First, verify that DashScopeProvider is in the factory registry after patch.
    # In buggy codebase, 'dashscope' key is not in ModelFactory._PROVIDER_CLASSES.
    # This will cause KeyError when trying to get provider.
    # After patch, it should be present.
    if 'dashscope' not in ModelFactory._PROVIDER_CLASSES:
        # This is the buggy state: DashScopeProvider not registered.
        # The test should fail because we expect it to be present after patch.
        # We'll assert that the key is missing, causing the test to fail.
        # But we need to make the test fail with an assertion error, not import error.
        # So we'll check and raise an assertion.
        raise AssertionError("DashScopeProvider not registered in ModelFactory._PROVIDER_CLASSES")

    # If we reach here, the provider is registered (fixed state).
    # Now test that DashScopeProvider can be instantiated and create_model works.
    # We must mock the internal agno imports to avoid actual API calls.
    with patch('agno.models.dashscope.DashScope') as MockDashScope:
        with patch('agno.knowledge.embedder.openai.OpenAIEmbedder') as MockEmbedder:
            # Create a minimal config for DashScopeProvider
            config = MagicMock()
            config.name = "DashScope"
            config.provider_type = "dashscope"
            config.default_model = "qwen3-max"
            config.default_embedding_model = "text-embedding-v4"
            config.api_key = "fake-key"
            config.base_url = None
            config.parameters = {"temperature": 0.7, "max_tokens": 16384}
            config.embedding_parameters = {"dimensions": 2048, "encoding_format": "float"}

            provider = DashScopeProvider(config)
            # Test create_model
            model = provider.create_model()
            # Should have called DashScope constructor with expected args
            MockDashScope.assert_called_once()
            call_kwargs = MockDashScope.call_args.kwargs
            assert call_kwargs['id'] == "qwen3-max"
            assert call_kwargs['api_key'] == "fake-key"
            assert call_kwargs['temperature'] == 0.7
            assert call_kwargs['max_tokens'] == 16384
            # Test create_embedder
            embedder = provider.create_embedder()
            MockEmbedder.assert_called_once()
            embedder_call_kwargs = MockEmbedder.call_args.kwargs
            assert embedder_call_kwargs['id'] == "text-embedding-v4"
            assert embedder_call_kwargs['api_key'] == "fake-key"
            assert embedder_call_kwargs['dimensions'] == 2048
            assert embedder_call_kwargs['encoding_format'] == "float"


def test_dashscope_provider_with_factory():
    """
    Test that ModelFactory can create a DashScope model via provider.
    In buggy codebase, factory will raise KeyError for 'dashscope'.
    After patch, it should succeed with mocked agno.
    """
    # Mock the config manager to return a dashscope provider config
    with patch('valuecell.config.manager.ConfigManager') as MockConfigManager:
        mock_config = MagicMock()
        mock_config.get_provider_config.return_value = {
            'name': 'DashScope',
            'provider_type': 'dashscope',
            'enabled': True,
            'connection': {
                'base_url': 'https://dashscope.aliyuncs.com/compatible-mode/v1',
                'api_key_env': 'DASHSCOPE_API_KEY'
            },
            'default_model': 'qwen3-max',
            'defaults': {'temperature': 0.7, 'max_tokens': 16384},
            'models': [{'id': 'qwen3-max', 'name': 'Qwen3 Max'}],
            'embedding': {
                'default_model': 'text-embedding-v4',
                'defaults': {'dimensions': 2048, 'encoding_format': 'float'}
            }
        }
        mock_config.get_provider_api_key.return_value = 'fake-key'
        MockConfigManager.return_value = mock_config

        factory = ModelFactory(mock_config)
        # Mock the internal DashScopeProvider.create_model to avoid agno import
        with patch('valuecell.adapters.models.factory.DashScopeProvider.create_model') as mock_create:
            mock_create.return_value = MagicMock()
            model = factory.create_model(provider_type='dashscope', model_id='qwen3-max')
            assert model is not None
            # Ensure create_model was called with correct model_id
            mock_create.assert_called_once_with(model_id='qwen3-max')


def test_dashscope_provider_import_error_handling():
    """
    Test that DashScopeProvider raises ImportError if agno is not installed.
    This tests the error handling added in the provider.
    """
    # Temporarily remove agno from sys.modules to simulate missing import
    import sys
    agno_modules = [k for k in sys.modules if k.startswith('agno')]
    saved = {}
    for k in agno_modules:
        saved[k] = sys.modules.pop(k)
    try:
        # Re-import the module to trigger ImportError
        import importlib
        import valuecell.adapters.models.factory
        importlib.reload(valuecell.adapters.models.factory)
        DashScopeProviderReloaded = valuecell.adapters.models.factory.DashScopeProvider
        config = MagicMock()
        config.name = "DashScope"
        config.default_model = "qwen3-max"
        config.api_key = "fake-key"
        config.parameters = {}
        provider = DashScopeProviderReloaded(config)
        with pytest.raises(ImportError) as exc_info:
            provider.create_model()
        assert "agno package not installed" in str(exc_info.value)
    finally:
        # Restore agno modules
        for k, v in saved.items():
            sys.modules[k] = v
        # Re-import the original module to avoid side effects
        importlib.reload(valuecell.adapters.models.factory)


def test_dashscope_provider_base_url_handling():
    """
    Test that DashScopeProvider correctly handles base_url with 'compatible-mode'.
