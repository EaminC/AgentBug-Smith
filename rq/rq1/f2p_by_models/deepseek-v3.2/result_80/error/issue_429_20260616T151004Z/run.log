import sys
import pytest
from unittest.mock import patch, MagicMock
from valuecell.adapters.models.factory import ModelFactory, DashScopeProvider
from valuecell.config.manager import ConfigManager


def test_dashscope_provider_creation_buggy():
    """
    Test that DashScopeProvider is correctly registered and can be instantiated.
    In the buggy codebase, DashScopeProvider is not defined, causing an ImportError
    or KeyError when trying to create a model with provider_type 'dashscope'.
    After the fix, DashScopeProvider is added to ModelFactory._PROVIDER_CLASSES.
    """
    # Ensure the config manager can load the dashscope provider config
    config_manager = ConfigManager()
    # Load the providers configuration
    config_manager.load_providers()

    # Check that 'dashscope' is in the provider registry
    factory = ModelFactory(config_manager)
    # This will fail in buggy code because DashScopeProvider is not in _PROVIDER_CLASSES
    assert "dashscope" in factory._PROVIDER_CLASSES

    # Try to get provider config for dashscope
    provider_config = config_manager.get_provider_config("dashscope")
    # In buggy code, this may be None because dashscope.yaml doesn't exist
    assert provider_config is not None
    assert provider_config.provider_type == "dashscope"

    # Now test creating a model instance via the factory
    # Mock the agno imports to avoid actual API calls
    with patch("agno.models.dashscope.DashScope") as mock_dashscope_class:
        mock_dashscope_class.return_value = MagicMock()
        # Also mock OpenAIEmbedder for embedder creation
        with patch("agno.knowledge.embedder.openai.OpenAIEmbedder") as mock_embedder_class:
            mock_embedder_class.return_value = MagicMock()

            # Set up environment variable for API key
            with patch.dict(os.environ, {"DASHSCOPE_API_KEY": "test-key"}):
                # Create model via factory
                model = factory.create_model(
                    provider_type="dashscope",
                    model_id="qwen3-max",
                    temperature=0.7
                )
                # In buggy code, this will raise KeyError because 'dashscope' not in _PROVIDER_CLASSES
                assert model is not None
                # Verify the mocked DashScope was called with correct parameters
                mock_dashscope_class.assert_called_once()
                call_kwargs = mock_dashscope_class.call_args.kwargs
                assert call_kwargs["id"] == "qwen3-max"
                assert call_kwargs["temperature"] == 0.7
                assert call_kwargs["api_key"] == "test-key"

                # Test embedder creation
                embedder = factory.create_embedder(
                    provider_type="dashscope",
                    model_id="text-embedding-v4"
                )
                assert embedder is not None
                mock_embedder_class.assert_called_once()
                embedder_call_kwargs = mock_embedder_class.call_args.kwargs
                assert embedder_call_kwargs["id"] == "text-embedding-v4"
                assert embedder_call_kwargs["api_key"] == "test-key"


