import pytest
from unittest.mock import patch, MagicMock, AsyncMock
from valuecell.adapters.models.factory import ModelFactory, DashScopeProvider
from valuecell.config.manager import ConfigManager


class TestDashScopeProvider:
    """Test DashScope provider integration."""

    def test_dashscope_provider_registered(self):
        """Ensure DashScopeProvider is registered in ModelFactory."""
        factory = ModelFactory()
        assert "dashscope" in factory._providers
        assert factory._providers["dashscope"] is DashScopeProvider

    def test_dashscope_provider_import_error(self):
        """Test that DashScopeProvider raises ImportError when agno is missing."""
        # Simulate missing agno.models.dashscope
        with patch.dict(sys.modules, {"agno.models.dashscope": None}):
            with pytest.raises(ImportError, match="agno package not installed"):
                provider = DashScopeProvider(MagicMock())
                provider.create_model()

    def test_dashscope_create_model_without_agno_mock(self):
        """Test create_model with mocked agno import."""
        # Mock the config
        mock_config = MagicMock()
        mock_config.default_model = "qwen3-max"
        mock_config.base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
        mock_config.api_key = "fake-dashscope-key"
        mock_config.parameters = {"temperature": 0.7, "max_tokens": 16384}

        # Mock the agno.models.dashscope.DashScope class
        mock_dashscope_class = MagicMock()
        mock_dashscope_instance = MagicMock()
        mock_dashscope_class.return_value = mock_dashscope_instance

        with patch("agno.models.dashscope.DashScope", mock_dashscope_class):
            provider = DashScopeProvider(mock_config)
            model = provider.create_model()

        # Verify the DashScope class was called with correct parameters
        mock_dashscope_class.assert_called_once_with(
            id="qwen3-max",
            api_key="fake-dashscope-key",
            base_url=None,  # because base_url contains "compatible-mode"
            temperature=0.7,
            max_tokens=16384,
            top_p=None,
        )
        assert model is mock_dashscope_instance

    def test_dashscope_create_model_with_custom_params(self):
        """Test create_model with custom model_id and parameters."""
        mock_config = MagicMock()
        mock_config.default_model = "qwen3-max"
        mock_config.base_url = None  # No base_url
        mock_config.api_key = "fake-key"
        mock_config.parameters = {"temperature": 0.8, "top_p": 0.9}

        mock_dashscope_class = MagicMock()
        mock_dashscope_instance = MagicMock()
        mock_dashscope_class.return_value = mock_dashscope_instance

        with patch("agno.models.dashscope.DashScope", mock_dashscope_class):
            provider = DashScopeProvider(mock_config)
            model = provider.create_model(
                model_id="qwen-plus",
                temperature=0.5,
                max_tokens=1000,
                extra_param="ignored",
            )

        mock_dashscope_class.assert_called_once_with(
            id="qwen-plus",
            api_key="fake-key",
            base_url=None,
            temperature=0.5,
            max_tokens=1000,
            top_p=0.9,
        )
        assert model is mock_dashscope_instance

    def test_dashscope_create_embedder(self):
        """Test create_embedder with mocked OpenAIEmbedder."""
        mock_config = MagicMock()
        mock_config.default_embedding_model = "text-embedding-v4"
        mock_config.api_key = "fake-embed-key"
        mock_config.base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
        mock_config.embedding_parameters = {
            "dimensions": 2048,
            "encoding_format": "float",
        }

        mock_openai_embedder_class = MagicMock()
        mock_embedder_instance = MagicMock()
        mock_openai_embedder_class.return_value = mock_embedder_instance

        with patch("agno.knowledge.embedder.openai.OpenAIEmbedder", mock_openai_embedder_class):
            provider = DashScopeProvider(mock_config)
            embedder = provider.create_embedder()

        mock_openai_embedder_class.assert_called_once_with(
            id="text-embedding-v4",
            api_key="fake-embed-key",
            base_url="https://dashscope.aliyuncs.com/compatible-mode/v1",
            dimensions=2048,
            encoding_format="float",
        )
        assert embedder is mock_embedder_instance

    def test_dashscope_create_embedder_with_custom_model_id(self):
        """Test create_embedder with custom model_id and parameters."""
        mock_config = MagicMock()
        mock_config.default_embedding_model = "text-embedding-v4"
        mock_config.api_key = "fake-key"
        mock_config.base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
        mock_config.embedding_parameters = {"dimensions": 1024}

        mock_openai_embedder_class = MagicMock()
        mock_embedder_instance = MagicMock()
        mock_openai_embedder_class.return_value = mock_embedder_instance

        with patch("agno.knowledge.embedder.openai.OpenAIEmbedder", mock_openai_embedder_class):
            provider = DashScopeProvider(mock_config)
            embedder = provider.create_embedder(
                model_id="text-embedding-v3",
                dimensions=512,
                encoding_format="base64",
            )

        mock_openai_embedder_class.assert_called_once_with(
            id="text-embedding-v3",
            api_key="fake-key",
            base_url="https://dashscope.aliyuncs.com/compatible-mode/v1",
            dimensions=512,
            encoding_format="base64",
        )
        assert embedder is mock_embedder_instance

    def test_dashscope_create_embedder_no_default_model(self):
        """Test create_embedder raises ValueError when no default embedding model."""
        mock_config = MagicMock()
        mock_config.default_embedding_model = None
        mock_config.name = "DashScope"

        provider = DashScopeProvider(mock_config)
        with pytest.raises(ValueError, match="No embedding model specified for provider 'DashScope'"):
            provider.create_embedder()

    def test_dashscope_factory_instantiation(self):
        """Test that ModelFactory can instantiate a DashScopeProvider."""
        # Mock config manager to return a dashscope provider config
        mock_config_manager = MagicMock(spec=ConfigManager)
        mock_provider_config = MagicMock()
        mock_provider_config.provider_type = "dashscope"
        mock_provider_config.name = "DashScope"
        mock_provider_config.base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
        mock_provider_config.api_key = "test-key"
        mock_provider_config.default_model = "qwen3-max"
        mock_provider_config.parameters = {}
        mock_provider_config.default_embedding_model = "text-embedding-v4"
        mock_provider_config.embedding_parameters = {}

        mock_config_manager.get_provider_config.return_value = mock_provider_config

        factory = ModelFactory(config_manager=mock_config_manager)

        # Mock the DashScope import inside the provider
        mock_dashscope_class = MagicMock()
        mock_dashscope_instance = MagicMock()
        mock_dashscope_class.return_value = mock_dashscope_instance

        with patch("agno.models.dashscope.DashScope", mock_dashscope_class):
            model = factory.create_model(provider_type="dashscope")

        assert model is mock_dashscope_instance
        mock_config_manager.get_provider_config.assert_called_once_with("dashscope")

    def test_dashscope_provider_in_config_yaml(self):
        """Ensure dashscope provider is listed in config.yaml models section."""
        # Load the actual config.yaml
        config_path = os.path.join(
            os.path.dirname(__file__), "..", "..", "configs", "config.yaml"
        )
        if os.path.exists(config_path):
            import yaml
            with open(config_path, "r") as f:
                config = yaml.safe_load(f)
            assert "dashscope" in config.get("models", {})
            dashscope_config = config["models"]["dashscope"]
            assert dashscope_config["config_file"] == "providers/dashscope.yaml"
            assert dashscope_config["api_key_env"] == "DASHSCOPE_API_KEY"
        else:
            pytest.skip("config.yaml not found")

    def test_dashscope_provider_yaml_exists(self):
        """Ensure dashscope.yaml exists in providers directory."""
        yaml_path = os.path.join(
            os.path.dirname(__file__), "..", "..", "configs", "providers", "dashscope.yaml"
        )
        assert os.path.exists(yaml_path), f"dashscope.yaml not found at {yaml_path}"

