import sys
import pytest
from unittest.mock import patch, MagicMock
from valuecell.adapters.models.factory import ModelFactory, DashScopeProvider
from valuecell.config.manager import ConfigManager


class TestDashScopeProvider:
    """Test that DashScopeProvider is correctly integrated and can create models."""

    def test_dashscope_provider_registered(self):
        """Check that DashScopeProvider is registered in ModelFactory."""
        factory = ModelFactory()
        assert "dashscope" in factory._provider_classes
        assert factory._provider_classes["dashscope"] is DashScopeProvider

    def test_dashscope_provider_import_error_without_agno(self):
        """DashScopeProvider.create_model should raise ImportError if agno not installed."""
        # Simulate missing agno module by removing it from sys.modules temporarily
        agno_key = "agno.models.dashscope"
        original_module = sys.modules.get(agno_key)
        if agno_key in sys.modules:
            del sys.modules[agno_key]
        try:
            provider = DashScopeProvider(config=MagicMock())
            provider.config.default_model = "qwen3-max"
            provider.config.parameters = {}
            provider.config.api_key = "fake-key"
            provider.config.base_url = None
            with pytest.raises(ImportError) as exc_info:
                provider.create_model()
            assert "agno package not installed" in str(exc_info.value)
        finally:
            if original_module:
                sys.modules[agno_key] = original_module

    def test_dashscope_provider_create_model_with_agno_mocked(self):
        """DashScopeProvider.create_model should call agno.models.dashscope.DashScope with correct args."""
        with patch("agno.models.dashscope.DashScope") as mock_dashscope_class:
            mock_dashscope_instance = MagicMock()
            mock_dashscope_class.return_value = mock_dashscope_instance
            provider = DashScopeProvider(config=MagicMock())
            provider.config.default_model = "qwen3-max"
            provider.config.parameters = {"temperature": 0.7, "max_tokens": 16384}
            provider.config.api_key = "fake-dashscope-key"
            provider.config.base_url = None
            model = provider.create_model()
            assert model is mock_dashscope_instance
            mock_dashscope_class.assert_called_once_with(
                id="qwen3-max",
                api_key="fake-dashscope-key",
                base_url=None,
                temperature=0.7,
                max_tokens=16384,
                top_p=None,
            )

    def test_dashscope_provider_create_model_with_custom_model_id(self):
        """DashScopeProvider.create_model should use provided model_id."""
        with patch("agno.models.dashscope.DashScope") as mock_dashscope_class:
            mock_dashscope_instance = MagicMock()
            mock_dashscope_class.return_value = mock_dashscope_instance
            provider = DashScopeProvider(config=MagicMock())
            provider.config.default_model = "qwen3-max"
            provider.config.parameters = {"temperature": 0.7}
            provider.config.api_key = "fake-key"
            provider.config.base_url = None
            model = provider.create_model(model_id="qwen-plus")
            assert model is mock_dashscope_instance
            mock_dashscope_class.assert_called_once_with(
                id="qwen-plus",
                api_key="fake-key",
                base_url=None,
                temperature=0.7,
                max_tokens=None,
                top_p=None,
            )

    def test_dashscope_provider_create_embedder_with_agno_mocked(self):
        """DashScopeProvider.create_embedder should call agno.knowledge.embedder.openai.OpenAIEmbedder."""
        with patch("agno.knowledge.embedder.openai.OpenAIEmbedder") as mock_embedder_class:
            mock_embedder_instance = MagicMock()
            mock_embedder_class.return_value = mock_embedder_instance
            provider = DashScopeProvider(config=MagicMock())
            provider.config.default_embedding_model = "text-embedding-v4"
            provider.config.embedding_parameters = {"dimensions": 2048, "encoding_format": "float"}
            provider.config.api_key = "fake-key"
            provider.config.base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
            embedder = provider.create_embedder()
            assert embedder is mock_embedder_instance
            mock_embedder_class.assert_called_once_with(
                id="text-embedding-v4",
                api_key="fake-key",
                base_url="https://dashscope.aliyuncs.com/compatible-mode/v1",
                dimensions=2048,
                encoding_format="float",
            )

    def test_dashscope_provider_create_embedder_without_default_model(self):
        """DashScopeProvider.create_embedder should raise ValueError if no embedding model specified."""
        provider = DashScopeProvider(config=MagicMock())
        provider.config.default_embedding_model = None
        provider.config.embedding_parameters = {}
        with pytest.raises(ValueError) as exc_info:
            provider.create_embedder()
        assert "No embedding model specified" in str(exc_info.value)

