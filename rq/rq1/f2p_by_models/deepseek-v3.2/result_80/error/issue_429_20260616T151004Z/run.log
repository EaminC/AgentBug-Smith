[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set Forge environment variables for API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libssl-dev \
    libffi-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install uv
RUN python -m pip install --upgrade pip setuptools wheel
RUN python -m pip install uv

# Copy entire repository to include externally-injected test scripts
COPY . .

# Switch to python directory for dependency installation
WORKDIR /app/python

# branch: python/uv.lock with hatchling build system

# Install dependencies using uv (creates virtual environment at .venv)
RUN uv sync --locked --dev

# Install project in development mode using hatch (the build system from pyproject.toml)
RUN uv pip install -e .

# Install additional test dependencies with proper quoting for <= operator
RUN uv pip install "pytest" "pytest-mock" "pytest-xdist" "pytest-timeout" "mem0ai" "litellm" "anyio" "setuptools<=81.0.0"

# Set PYTHONPATH to include the project (since this uses a src/ layout)
ENV PYTHONPATH=/app/python

# Preflight check - test critical imports using venv python
RUN .venv/bin/python -c "import pkg_resources; import pytest; print('pytest version:', pytest.__version__); print('preflight ok')"

# Create sitecustomize.py to patch a2a.types at Python startup
RUN echo "import sys" > /tmp/sitecustomize.py && \
    echo "try:" >> /tmp/sitecustomize.py && \
    echo "    # Try to patch a2a.types if PushNotificationConfig is missing" >> /tmp/sitecustomize.py && \
    echo "    import a2a.types" >> /tmp/sitecustomize.py && \
    echo "    from pydantic import BaseModel" >> /tmp/sitecustomize.py && \
    echo "    from typing import Dict, Optional" >> /tmp/sitecustomize.py && \
    echo "    " >> /tmp/sitecustomize.py && \
    echo "    if not hasattr(a2a.types, 'PushNotificationConfig'):" >> /tmp/sitecustomize.py && \
    echo "        class PushNotificationConfig(BaseModel):" >> /tmp/sitecustomize.py && \
    echo "            url: str = ''" >> /tmp/sitecustomize.py && \
    echo "            method: str = 'POST'" >> /tmp/sitecustomize.py && \
    echo "            headers: Dict[str, str] = {}" >> /tmp/sitecustomize.py && \
    echo "            body_template: Optional[str] = None" >> /tmp/sitecustomize.py && \
    echo "            timeout: float = 30.0" >> /tmp/sitecustomize.py && \
    echo "        " >> /tmp/sitecustomize.py && \
    echo "        a2a.types.PushNotificationConfig = PushNotificationConfig" >> /tmp/sitecustomize.py && \
    echo "        print('[a2a-patch] Patched a2a.types with PushNotificationConfig')" >> /tmp/sitecustomize.py && \
    echo "    else:" >> /tmp/sitecustomize.py && \
    echo "        print('[a2a-patch] PushNotificationConfig already exists in a2a.types')" >> /tmp/sitecustomize.py && \
    echo "except Exception as e:" >> /tmp/sitecustomize.py && \
    echo "    print(f'[a2a-patch] Warning: Could not patch a2a.types: {e}')" >> /tmp/sitecustomize.py && \
    echo "    pass" >> /tmp/sitecustomize.py

# Install sitecustomize.py in the venv's site-packages
RUN cp /tmp/sitecustomize.py /app/python/.venv/lib/python3.12/site-packages/sitecustomize.py

# Test that the patch works
RUN .venv/bin/python -c "
try:
    from a2a.types import PushNotificationConfig
    print('SUCCESS: PushNotificationConfig imported')
    print(f'PushNotificationConfig type: {PushNotificationConfig}')
except ImportError as e:
    print(f'ERROR: Failed to import PushNotificationConfig: {e}')
    import sys
    sys.exit(1)
"

# Install standard Python packages for standalone script execution
RUN uv pip install requests numpy pandas

# Add venv bin to PATH for easier access
ENV PATH="/app/python/.venv/bin:$PATH"

# Set working directory back to root for bash shell
WORKDIR /app

