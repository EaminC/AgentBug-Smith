# branch: python - ValueCell with pinned dependencies
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Set Python path
ENV PYTHONPATH=/app/python:/app

# Forge API configuration
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional environment variables
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2

# Navigate to python directory
WORKDIR /app/python

# Upgrade pip and install dependencies from pyproject.toml using pip
RUN pip install --upgrade pip setuptools wheel

# Install project dependencies with pinned versions
RUN pip install "python-okx>=0.4.0" \
    "pytz>=2023.3" \
    "python-dateutil>=2.8.2" \
    "fastapi>=0.104.0" \
    "pydantic>=2.0.0" \
    "uvicorn>=0.24.0" \
    "a2a-sdk[http-server]==0.3.4" \
    "yfinance>=0.2.65" \
    "requests>=2.32.5" \
    "akshare>=1.17.44" \
    "agno[openai, google, lancedb]>=2.0,<3.0" \
    "edgartools>=4.12.2" \
    "sqlalchemy>=2.0.43" \
    "aiosqlite>=0.19.0" \
    "unstructured>=0.18.15" \
    "markdown>=3.9" \
    "loguru>=0.7.3" \
    "aiofiles>=24.1.0" \
    "crawl4ai>=0.7.4" \
    "ccxt>=4.5.15"

# Install dev dependencies for testing
RUN pip install "pytest>=7.4.0" \
    "pytest-cov>=4.1.0" \
    "pytest-asyncio>=1.0.0" \
    "diff-cover>=9.0.0" \
    ruff \
    isort \
    pytest-mock \
    pytest-timeout \
    "setuptools<=81.0.0" \
    litellm \
    mem0ai

# Install the project in development mode
