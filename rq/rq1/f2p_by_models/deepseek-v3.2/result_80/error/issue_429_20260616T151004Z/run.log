[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Install system dependencies for Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for Forge
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Copy the entire repository
COPY . .

# Check for src layout to decide on editable install
RUN if [ -d "python/src" ] || grep -Rq "^\s*from src\.|^\s*import src\." python/ 2>/dev/null; then \
    echo "src layout detected; skipping editable install" && \
    ENV PYTHONPATH=/app/python; \
    else \
    echo "No src layout; will perform editable install"; \
    fi

# Navigate to python directory for package installation
WORKDIR /app/python

# Upgrade packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies based on available lockfiles
# Check for uv.lock first, then poetry.lock, then requirements.txt
RUN if [ -f "uv.lock" ]; then \
    pip install uv && \
    uv sync --locked --all-extras --dev; \
    elif [ -f "poetry.lock" ]; then \
    pip install poetry && \
    poetry config virtualenvs.create false && \
    poetry install --no-interaction --no-ansi; \
    elif [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt; \
    else \
    echo "No lockfile or requirements.txt found"; \
    fi

# Install test dependencies unconditionally
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Perform editable install only if no src layout detected
RUN if [ ! -d "src" ] && ! grep -Rq "^\s*from src\.|^\s*import src\." . 2>/dev/null; then \
    pip install -e .; \
    else \
    echo "Skipping editable install due to src layout"; \
    fi

# Preflight check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command
CMD ["/bin/bash"]

# Production stage (minimal)
FROM python:3.12-slim AS runtime

WORKDIR /app

# Copy only necessary Python package
COPY --from=test_builder /app/python /app/python

# Set environment variables for Forge
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

WORKDIR /app/python

# Install production dependencies only (no dev)
RUN python -m pip install --upgrade pip setuptools wheel
RUN if [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt; \
    elif [ -f "pyproject.toml" ]; then \
    pip install .; \
    else \
    echo "No requirements found"; \
    fi

# Expose port for the application (default from README)
EXPOSE 1420

# Command inferred from README (start.sh runs the application)
CMD ["bash", "../start.sh"][0m
