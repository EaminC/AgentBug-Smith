[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

COPY . .

# Detect src/ layout or tests importing via src.
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." . 2>/dev/null; then \
      SRC_LAYOUT=1; \
    else \
      SRC_LAYOUT=0; \
    fi && \
    python -m pip install --upgrade pip setuptools wheel && \
    if [ -f "requirements.txt" ]; then \
      if [ "$SRC_LAYOUT" -eq 1 ]; then \
        pip install -r requirements.txt; \
      else \
        pip install -r requirements.txt && pip install -e .; \
      fi; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
      pip install poetry && \
      poetry config virtualenvs.create false && \
      poetry install --no-interaction --no-ansi && \
      if [ "$SRC_LAYOUT" -eq 0 ]; then \
        pip install -e .; \
      fi; \
    elif [ -f "pyproject.toml" ]; then \
      if [ "$SRC_LAYOUT" -eq 0 ]; then \
        pip install -e .; \
