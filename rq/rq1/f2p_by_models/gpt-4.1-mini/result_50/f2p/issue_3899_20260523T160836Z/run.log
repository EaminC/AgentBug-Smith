[32mfrom unittest.mock import MagicMock, patch

import pytest

from crewai.a2a.config import A2AConfig


def test_a2a_server_does_not_delegate_again_after_completed(monkeypatch):
    """
    Test that when the A2A remote agent returns status "completed" and trust_remote_completion_status=True,
    the server agent does not delegate the same request again, avoiding infinite loops.
    """

    from crewai.a2a.wrapper import _delegate_to_a2a
    from crewai import Agent, Task

    # Setup an agent with trust_remote_completion_status=True to trust remote completion status
    a2a_config = A2AConfig(
        endpoint="http://fake-endpoint",
        trust_remote_completion_status=True,
    )

    agent = Agent(
        role="test role",
        goal="test goal",
        backstory="test backstory",
        a2a=a2a_config,
    )

    task = Task(description="test task", expected_output="expected", agent=agent)

    class MockAgentResponse:
        is_a2a = True
        message = "request message"
        a2a_ids = ["http://fake-endpoint"]

    # We will patch the internal call that executes the delegation to simulate the remote agent response
    with patch("crewai.a2a.wrapper.execute_a2a_delegation") as mock_execute_delegation, \
         patch("crewai.a2a.wrapper._fetch_agent_cards_concurrently") as mock_fetch_cards:

        # Mock agent card info
        mock_card = MagicMock()
        mock_card.name = "FakeAgent"
        mock_fetch_cards.return_value = ({"http://fake-endpoint": mock_card}, {})

        # Simulate remote agent returning status "completed" with a result
        mock_execute_delegation.return_value = {
            "status": "completed",
            "result": "final result from remote agent",
            "history": [],
        }

        # Call _delegate_to_a2a, it should return immediately with the remote result and NOT delegate again
        result = _delegate_to_a2a(
            self=agent,
            agent_response=MockAgentResponse(),
            task=task,
            original_fn=lambda *args, **kwargs: "fallback result",
            context=None,
            tools=None,
            agent_cards={"http://fake-endpoint": mock_card},
            original_task_description="test task",
        )

        # Assert that the result is the remote agent's final result
        assert result == "final result from remote agent"

        # Assert that execute_a2a_delegation was called exactly once (no repeated delegation)
        assert mock_execute_delegation.call_count == 1


def test_a2a_server_delegates_again_if_trust_flag_false(monkeypatch):
    """
    Test that when trust_remote_completion_status=False, even if remote agent returns "completed",
    the server agent still processes the result and may delegate again.
    """

    from crewai.a2a.wrapper import _delegate_to_a2a
    from crewai import Agent, Task

    a2a_config = A2AConfig(
        endpoint="http://fake-endpoint",
        trust_remote_completion_status=False,
    )

    agent = Agent(
        role="test role",
        goal="test goal",
        backstory="test backstory",
        a2a=a2a_config,
    )

    task = Task(description="test task", expected_output="expected", agent=agent)

    class MockAgentResponse:
        is_a2a = True
        message = "request message"
        a2a_ids = ["http://fake-endpoint"]

    with patch("crewai.a2a.wrapper.execute_a2a_delegation") as mock_execute_delegation, \
         patch("crewai.a2a.wrapper._fetch_agent_cards_concurrently") as mock_fetch_cards:

        mock_card = MagicMock()
        mock_card.name = "FakeAgent"
        mock_fetch_cards.return_value = ({"http://fake-endpoint": mock_card}, {})

        # Simulate remote agent returning status "completed"
        mock_execute_delegation.return_value = {
            "status": "completed",
            "result": "remote completed result",
            "history": [],
        }

        # Track calls to original_fn to detect delegation continuation
        call_count = 0

        def mock_original_fn(self, task, context, tools):
            nonlocal call_count
            call_count += 1
            # Return a server-generated final answer on first call
            if call_count == 1:
                return '{"is_a2a": false, "message": "server final answer", "a2a_ids": []}'
            return "unexpected call"

        result = _delegate_to_a2a(
            self=agent,
            agent_response=MockAgentResponse(),
            task=task,
            original_fn=mock_original_fn,
            context=None,
            tools=None,
            agent_cards={"http://fake-endpoint": mock_card},
            original_task_description="test task",
        )

        # The server agent should have called original_fn at least once to process the completed result
        assert call_count >= 1

        # The final result should be the server agent's final answer, not the remote agent's raw result
        assert result == "server final answer"


