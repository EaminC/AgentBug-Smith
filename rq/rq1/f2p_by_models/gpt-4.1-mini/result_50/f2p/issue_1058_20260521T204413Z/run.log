[32mFROM python:3.10-slim AS test_builder

# Set working directory
WORKDIR /app

# Copy entire repository
COPY . .

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel

# Detect src/ layout or tests import with src.
RUN if [ -d "src" ] || grep -RqE "^\s*(from|import) src\." tests 2>/dev/null; then \
      pip install -r requirements.txt 2>/dev/null || true && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout ; \
    else \
      pip install -r requirements.txt 2>/dev/null || true && \
      pip install -e . && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout ; \
    fi

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests (assumes tests are in tests/ directory)
RUN pytest || true

# Runtime image
FROM python:3.10-slim AS runtime

WORKDIR /app

COPY . .

RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt 2>/dev/null || true && \
    pip install -e .

