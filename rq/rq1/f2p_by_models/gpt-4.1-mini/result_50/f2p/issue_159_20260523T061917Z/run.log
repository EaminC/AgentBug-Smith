[32mimport json
import builtins
import pytest

from mle.agents.advisor import AdviseAgent
from mle.workflow import baseline
from mle.utils.system import print_in_box


class DummyModel:
    def __init__(self):
        self.queries = []

    def query(self, chat_history, response_format=None):
        self.queries.append(chat_history)
        last_user_msg = chat_history[-1]["content"].lower()

        # Simulate the first query to verify dataset clarity
        if "your task is to determine if the dataset refers to" in last_user_msg:
            # Return "No" to simulate unclear dataset name
            return "No"

        # Simulate the second query to suggest datasets
        if "since the user has not provided a specific dataset" in last_user_msg:
            # Return a JSON string with datasets and reason
            response = {
                "datasets": [
                    "MNIST",
                    "CIFAR-10",
                    "ImageNet",
                    "COCO",
                    "Fashion-MNIST"
                ],
                "reason": "Based on the user's blur dataset description, these are popular image datasets suitable for various ML tasks."
            }
            return json.dumps(response)

        # Default fallback
        return "Yes"


class DummyConsole:
    def __init__(self):
        self.status_messages = []
        self.printed_panels = []

    def status(self, message):
        # Context manager that yields self
        class DummyStatus:
            def __enter__(inner_self):
                self.status_messages.append(message)
                return inner_self

            def __exit__(inner_self, exc_type, exc_val, exc_tb):
                return False

        return DummyStatus()

    def print(self, panel):
        self.printed_panels.append(panel)


def test_clarify_dataset_blur_name(monkeypatch):
    """
    Test that when a blur dataset name is provided, the advisor suggests datasets.
    This should fail on buggy code (no clarify_dataset call) and pass on fixed code.
    """

    dummy_model = DummyModel()
    dummy_console = DummyConsole()

    # Patch print_in_box to avoid actual console output
    monkeypatch.setattr("mle.utils.system.print_in_box", lambda *a, **k: None)

    # Patch questionary.select to simulate user selecting the first suggested dataset
    def dummy_select(prompt, choices):
        class DummySelect:
            def ask(self):
                return choices[0]
        return DummySelect()

    monkeypatch.setattr("questionary.select", dummy_select)

    # Patch get_config to return a dummy config dict to avoid NoneType error in AdviseAgent.__init__
    import mle.agents.advisor
    monkeypatch.setattr(mle.agents.advisor, "get_config", lambda: {"search_key": "dummy"})

    advisor = AdviseAgent(dummy_model, dummy_console)

    # Call clarify_dataset with a blur dataset name
    result = advisor.clarify_dataset("blur-dataset")

    # The result should be one of the suggested datasets from DummyModel.query
    assert result in ["MNIST", "CIFAR-10", "ImageNet", "COCO", "Fashion-MNIST"]

    # The dummy model should have been queried twice: once for clarity check, once for suggestions
    assert len(dummy_model.queries) == 2


def test_baseline_calls_clarify_dataset(monkeypatch):
    """
    Test that baseline() calls clarify_dataset and stores the clarified dataset.
    This test simulates the user inputting a blur dataset name.
    """

    dummy_model = DummyModel()
    dummy_console = DummyConsole()

    # Patch print_in_box to avoid actual console output
    monkeypatch.setattr("mle.utils.system.print_in_box", lambda *a, **k: None)

    # Patch questionary.select to simulate user selecting the first suggested dataset
    def dummy_select(prompt, choices):
        class DummySelect:
            def ask(self):
                return choices[0]
        return DummySelect()

    monkeypatch.setattr("questionary.select", dummy_select)

    # Patch get_config to return a dummy config dict to avoid NoneType error in AdviseAgent.__init__
    import mle.agents.advisor
    monkeypatch.setattr(mle.agents.advisor, "get_config", lambda: {"search_key": "dummy"})

    # Patch AdviseAgent in mle.workflow.baseline to use our dummy model and console
    import mle.workflow.baseline as baseline_module

    # Patch AdviseAgent to use dummy model and console inside baseline
    original_advise_agent = baseline_module.AdviseAgent

    def dummy_advise_agent_factory(model, console):
        # Ignore passed model and console, use dummy ones
        return AdviseAgent(dummy_model, dummy_console)

    monkeypatch.setattr(baseline_module, "AdviseAgent", dummy_advise_agent_factory)

    # Patch ask_text to simulate user input of blur dataset name
    # ask_text is imported inside baseline.py, so patch the function in that module
    monkeypatch.setattr(baseline_module, "ask_text", lambda prompt: "blur-dataset")

    # Patch print_in_box to avoid output during baseline
    monkeypatch.setattr(baseline_module, "print_in_box", lambda *a, **k: None)

    # Run baseline with a temporary directory (can be any string, no real IO expected)
    # The dummy cache context manager will be used internally; no patch needed here
    result = baseline("dummy_work_dir", model=dummy_model)

    # The baseline should return None (no error)
    assert result is None

    # The dummy model should have been queried at least twice (clarify_dataset calls model.query twice)
    assert len(dummy_model.queries) >= 2

    # The dataset stored in cache should be one of the suggested datasets
    # We can't access cache internals easily here, but we can check that clarify_dataset was called
    # by verifying dummy_model queries count and that the last query was the suggestion request
    last_query = dummy_model.queries[-1][-1]["content"].lower()
    assert "since the user has not provided a specific dataset" in last_query


