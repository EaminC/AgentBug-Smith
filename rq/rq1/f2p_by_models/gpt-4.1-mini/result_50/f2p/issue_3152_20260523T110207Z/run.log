ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Expose no ports explicitly (no evidence of network service)

# Default command inferred from project main.py entrypoint
CMD ["/bin/bash"][0m
