[32mFROM python:3.12-slim AS test_builder

# Set working directory
WORKDIR /app

# Copy entire repository to preserve test scripts and all files
COPY . .

# Detect if src/ layout or tests import via src.
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
      export USE_SRC_LAYOUT=1; \
    else \
      export USE_SRC_LAYOUT=0; \
    fi && \
    python -m pip install --upgrade pip setuptools wheel && \
    if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt; \
    fi && \
    if [ "$USE_SRC_LAYOUT" -eq 1 ]; then \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
      pip install -e . pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# When src layout detected, set PYTHONPATH to /app to avoid module import conflicts
ENV PYTHONPATH=/app

# Preflight import check for core modules
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

# Run tests with pytest
RUN pytest -vv --maxfail=3 --disable-warnings

# Minimal runtime image
FROM python:3.12-slim AS runtime

WORKDIR /app

COPY --from=test_builder /app /app

# Install production dependencies only (no dev/test tools)
RUN python -m pip install --upgrade pip setuptools wheel && \
    if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt; \
    fi && \
    pip install -e .

