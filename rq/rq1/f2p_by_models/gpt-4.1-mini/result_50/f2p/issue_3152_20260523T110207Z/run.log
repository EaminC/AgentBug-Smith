# Set PYTHONPATH to /app for proper imports if src/ layout
ENV PYTHONPATH=/app

# Preflight check to verify installation
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

# Final command must be bash for interactive test shell
CMD ["/bin/bash"]

