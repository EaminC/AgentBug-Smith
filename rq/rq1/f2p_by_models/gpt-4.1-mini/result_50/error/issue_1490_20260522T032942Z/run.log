@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_blocks_correctly():
    """
    This test verifies that DeepResearchAgent correctly handles model output blocks
    that include a leading 'thinking' block without a 'text' key, which previously
    caused a KeyError.

    The test mocks the internal model client's chat completion call to return a response
    with blocks starting with a 'thinking' type block followed by a 'text' type block.
    It then runs the agent's _generate_deepresearch_report method and asserts that
    the final report content is extracted from the 'text' block, not the 'thinking' block.

    On the buggy codebase, this test should fail with KeyError.
    After the fix, this test should pass.
    """

    # Instantiate the agent with the specific model that triggers the issue
    agent = DeepResearchAgent(model_name="Qwen3.5-397B-A17B-FPB")

    # Patch the internal model client's chat completions to simulate the buggy model output
    # The response blocks simulate the problematic output:
    # first block is 'thinking' without 'text', second block is 'text' with actual content
    fake_response_blocks = [
        {"type": "thinking", "thinking": "processing intermediate thoughts..."},
        {"type": "text", "text": "This is the final report content."},
    ]

    # Patch the model's chat completions create method to return the fake blocks
    # We patch the internal call that the agent uses to get model completions
    # The agent calls self.model.chat.completions.create(...)
    # We mock this to return an object with .choices[0].message.content blocks
    class FakeChoice:
        def __init__(self, blocks):
            self.message = type("Message", (), {"content": blocks})

    class FakeResponse:
        def __init__(self, blocks):
            self.choices = [FakeChoice(blocks)]

    async def fake_chat_completions_create(*args, **kwargs):
        return FakeResponse(fake_response_blocks)

    # Patch the model attribute's chat.completions.create async method
    # We patch the 'create' method on agent.model.chat.completions
    # to return our fake response with the thinking block first
    with patch.object(agent.model.chat.completions, "create", new=fake_chat_completions_create):
        # Run the _generate_deepresearch_report coroutine to trigger the bug/fix
        # We provide minimal dummy arguments for checklist and msgs as they are not used in block extraction
        checklist = "dummy checklist"
        msgs = [{"role": "user", "content": "dummy message"}]

        # The method returns the final report content string
        final_report_content = await agent._generate_deepresearch_report(checklist, msgs)

    # Assert that the final report content is correctly extracted from the 'text' block,
    # not from the first 'thinking' block, thus no KeyError occurs and content is correct
    assert final_report_content == "This is the final report content."[0m
