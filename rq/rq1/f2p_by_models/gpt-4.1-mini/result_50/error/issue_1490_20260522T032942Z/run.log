[32mimport asyncio
import pytest
from unittest.mock import patch, AsyncMock

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_blocks_without_keyerror():
    """
    This test verifies that DeepResearchAgent correctly handles model output blocks
    that start with a 'thinking' block without a 'text' key, followed by a 'text' block.
    It simulates the buggy scenario that previously caused a KeyError and ensures
    the agent extracts the text from the correct block.

    The test mocks the internal model client's chat completions to return a response
    with a thinking block first, then a text block, mimicking the Qwen3.5-397B-A17B-FPB model output.

    Expected:
    - No KeyError is raised.
    - The extracted final report content matches the text in the 'text' block.
    """

    # Instantiate the agent with the problematic model name
    agent = DeepResearchAgent(model_name="Qwen3.5-397B-A17B-FPB")

    # Prepare a dummy user query
    agent.user_query = "What is the impact of climate change on polar bears?"

    # Prepare blocks simulating the buggy model output:
    # first block is 'thinking' without 'text', second block is 'text' with content
    buggy_blocks = [
        {"type": "thinking", "thinking": "Processing your request..."},
        {"type": "text", "text": "Polar bears are affected by melting ice caps."},
    ]

    # Patch the internal model client's chat completion call to return the buggy blocks
    # We patch the _generate_deepresearch_report method's internal call to self.model.chat.completions.create
    # The actual method calls self.model.chat.completions.create(...) and expects a list of blocks in response
    # We mock that call to return the buggy blocks wrapped in the expected structure.
    async def fake_chat_completions_create(*args, **kwargs):
        class DummyResponse:
            def __init__(self, blocks):
                self.choices = [AsyncMock()]
                self.choices[0].message = {"content": None, "blocks": blocks}
                self.choices[0].message.__getitem__ = lambda s, k: self.choices[0].message[k]

            def __await__(self):
                async def coro():
                    return self
                return coro().__await__()

        return DummyResponse(buggy_blocks)

    # Patch the model attribute and its chat.completions.create method
    with patch.object(agent, "model", create=True) as mock_model:
        mock_model.stream = False
        mock_model.chat = AsyncMock()
        mock_model.chat.completions = AsyncMock()
        mock_model.chat.completions.create = AsyncMock(side_effect=fake_chat_completions_create)

