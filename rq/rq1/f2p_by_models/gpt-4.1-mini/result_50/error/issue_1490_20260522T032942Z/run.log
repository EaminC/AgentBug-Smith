@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_blocks_correctly():
    """
    This test verifies that DeepResearchAgent correctly handles model outputs
    that contain a leading 'thinking' block before the actual 'text' block,
    which previously caused a KeyError in the buggy code.

    It mocks the internal model client's chat completion call to return a response
    with blocks starting with a 'thinking' type block followed by a 'text' type block.

    The test asserts that the final report content extracted by the agent is from
    the 'text' block, not the 'thinking' block, thus avoiding KeyError.
    """

    # Instantiate the agent with the problematic model name
    agent = DeepResearchAgent(model_name="Qwen3.5-397B-A17B-FPB")

    # Prepare a dummy user query for research
    agent.user_query = "What is the impact of AI on climate change?"

    # Mock the model's chat completion method to simulate the buggy model output
    # The output blocks include a 'thinking' block first, then a 'text' block
    thinking_block = {"type": "thinking", "thinking": "Processing your request..."}
    text_block = {"type": "text", "text": "AI can help reduce carbon emissions by optimizing energy use."}
    mocked_blocks = [thinking_block, text_block]

    # Patch the model's chat completions create method inside the agent instance
    # We patch the internal method that returns the blocks list
    async def fake_chat_completions_create(*args, **kwargs):
        class DummyResponse:
            def __init__(self):
                self.choices = [{"message": {"content": mocked_blocks}}]

            async def __aiter__(self):
                yield self

        return DummyResponse()

    # Patch the model's chat.completions.create method to return the mocked blocks
    # The agent code calls self.model.chat.completions.create(...)
    # We patch this method on the agent's model attribute
    with patch.object(agent.model.chat.completions, "create", new=AsyncMock(return_value=mocked_blocks)):

        # Call the internal method that previously caused KeyError by accessing blocks[0]["text"]
        # We call _generate_deepresearch_report which uses that logic internally
        # We run the coroutine and catch exceptions if any
        try:
            # Run the coroutine to generate the report
            final_report = await agent._generate_deepresearch_report()
        except KeyError as e:
            pytest.fail(f"KeyError was raised during report generation: {e}")
        except Exception as e:
            pytest.fail(f"Unexpected exception was raised: {e}")

        # Assert that the final report content is exactly the text from the text block
        # This confirms that the agent correctly extracted the text block, skipping the thinking block
        assert isinstance(final_report, str)
        assert "carbon emissions" in final_report
        assert final_report == text_block["text"]


