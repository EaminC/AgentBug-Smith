[32mimport asyncio
import pytest
from unittest.mock import AsyncMock, patch

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_blocks(monkeypatch):
    """
    This test verifies that DeepResearchAgent correctly handles model outputs
    that include a leading 'thinking' block before the actual 'text' block,
    which previously caused a KeyError.

    The test mocks the model's internal call to return blocks with a 'thinking'
    type block first, followed by a 'text' type block. It asserts that the
    agent extracts the text from the correct block without raising KeyError,
    and that the final report content matches the expected text.
    """

    # Instantiate the agent with the problematic model name
    agent = DeepResearchAgent(model_name="Qwen3.5-397B-A17B-FPB")

    # Prepare a dummy user query
    agent.user_query = "What is the impact of climate change on polar bears?"

    # Mock the model's call to return blocks with a leading thinking block
    thinking_block = {"type": "thinking", "thinking": "Processing your request..."}
    text_block = {"type": "text", "text": "Polar bears are affected by melting ice."}
    mocked_blocks = [thinking_block, text_block]

    # Patch the internal method that calls the model to return the mocked blocks
    # We patch the _model_call method or equivalent that returns blocks.
    # Since the exact method is not specified, patch the model's call attribute.
    # The agent uses self.model.stream and calls the model asynchronously,
    # so we patch the model's async call to return the mocked blocks.

    async def mock_model_call(*args, **kwargs):
        return mocked_blocks

    # Patch the model's __call__ or method that returns blocks
    # The DeepResearchAgent uses self.model.stream and calls it asynchronously.
    # We patch the model attribute to have an async __call__ returning mocked_blocks.
    # If the agent uses a different method, adjust accordingly.

    class DummyModel:
        stream = False

        async def __call__(self, *args, **kwargs):
            return mocked_blocks

    agent.model = DummyModel()

    # Patch the logger to suppress output during test
    with patch("examples.agent.deep_research_agent.deep_research_agent.logger.info"):
        # Run the internal method that generates the deep research report
        # This method is async and returns the final report content string.
        # We call _generate_deepresearch_report which uses the blocks and extracts text.
        final_report = await agent._generate_deepresearch_report()

    # The final report content should be the text from the text block, not from the thinking block
    expected_text = text_block["text"]
    assert final_report == expected_text, (
        "The agent should extract text from the 'text' block, "
        "not from the leading 'thinking' block, avoiding KeyError."
    )[0m
