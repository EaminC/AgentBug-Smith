import pytest
from unittest.mock import AsyncMock, patch

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_blocks(monkeypatch):
    """
    This test verifies that DeepResearchAgent correctly handles model output blocks
    that include a leading 'thinking' block without a 'text' key, followed by a 'text' block.
    It should not raise KeyError and should extract the text from the correct block.
    """

    # Prepare a DeepResearchAgent instance with the problematic model name
    agent = DeepResearchAgent(model_name="Qwen3.5-397B-A17B-FPB")

    # Patch the internal model client call to simulate the model response with thinking block first
    thinking_block = {"type": "thinking", "thinking": "processing..."}
    text_block = {"type": "text", "text": "This is the final report content."}
    fake_blocks = [thinking_block, text_block]

    # We patch the _call_model method or the method that returns blocks to return our fake blocks
    # Since the bug is at line 931 where blocks[0]["text"] is accessed,
    # we want to simulate the method that returns blocks to return fake_blocks.
    # The exact method to patch is the model's call that returns blocks.
    # We patch the model's async call to completions to return fake_blocks.

    async def fake_generate_response(*args, **kwargs):
        # Simulate the response blocks as returned by the model
        return fake_blocks

    # Patch the model's generate_response or similar method used internally
    # We patch the model attribute's __call__ or generate_response method
    # The DeepResearchAgent uses self.model.stream and calls self.model(...).
    # So patch agent.model.__call__ to return fake_blocks
    monkeypatch.setattr(agent.model, "__call__", AsyncMock(return_value=fake_blocks))

    # Now test the internal method _extract_text_from_blocks directly
    # It should return the text from the text block, ignoring the thinking block
    extracted_text = agent._extract_text_from_blocks(fake_blocks)
    assert extracted_text == "This is the final report content."

    # Also test the code path that triggers the bug: _generate_deepresearch_report
    # We patch the internal model call to return fake_blocks
    # We patch the logger to suppress output

    with patch("examples.agent.deep_research_agent.deep_research_agent.logger") as mock_logger:
        # Run the _generate_deepresearch_report coroutine with minimal parameters
        # It is async, so we run it with asyncio
        report = await agent._generate_deepresearch_report(checklist="Checklist content")

        # The returned report should be the text from the text block, not raise KeyError
        assert isinstance(report, str)
        assert "This is the final report content." in report

        # The logger.info should be called with the final report content
        mock_logger.info.assert_called()
        args, kwargs = mock_logger.info.call_args
        assert "final Report" in args[0]
        assert "This is the final report content." in args[1]

    # Additionally, test that if no text block is present, a ValueError is raised
    no_text_blocks = [{"type": "thinking", "thinking": "still thinking"}]
    with pytest.raises(ValueError):
        agent._extract_text_from_blocks(no_text_blocks)[0m
