import pytest
from unittest.mock import AsyncMock, patch

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_blocks_without_keyerror():
    """
    This test verifies that DeepResearchAgent correctly handles model output blocks
    that contain a leading 'thinking' block without a 'text' key, followed by a 'text' block.
    The buggy code raises KeyError when accessing blocks[0]['text'] if the first block is 'thinking'.
    The fix extracts the first block of type 'text' safely.

    Steps:
    - Create a DeepResearchAgent instance with the problematic model id.
    - Patch the internal model client's chat completion call to return blocks with a leading 'thinking' block.
    - Call the internal _generate_deepresearch_report method to trigger the code path.
    - Assert that the final report content is extracted from the 'text' block, not raising KeyError.
    """

    # Use the exact model id that triggers the bug
    model_id = "Qwen3.5-397B-A17B-FPB"

    # Instantiate the agent with the model id and a dummy user query
    agent = DeepResearchAgent(user_query="Test query for thinking block", model=model_id)

    # Prepare fake blocks simulating the buggy model output:
    # first block is 'thinking' without 'text', second block is 'text' with content
    fake_blocks = [
        {"type": "thinking", "thinking": "Processing intermediate thoughts..."},
        {"type": "text", "text": "This is the final report content."},
    ]

    # Patch the agent's model chat completion call to return the fake blocks
    # The method _generate_deepresearch_report calls self.model.chat.completions.create
    # We patch that to return an object with attribute 'choices[0].message.content' or similar
    # But from the diff and context, it seems the agent calls self.model.chat.completions.create and gets a list of blocks
    # We patch the call to return the blocks directly as the method expects

    # The exact call path to patch is agent.model.chat.completions.create
    # We'll patch it to an async mock returning an object with attribute 'choices' containing 'message' with 'content' or 'blocks'
    # But the agent code uses 'blocks' directly from the response, so we patch to return an object with 'choices[0].message.content' or just 'blocks'

    # To simplify, patch the create method to return an object with attribute 'choices' whose first element has 'message' attribute with 'content' or 'blocks'
    # But since the agent code uses blocks = await self.model.chat.completions.create(...), and then uses blocks[0]['text'], it suggests the return is a list of dicts (blocks)
    # So patch to return the fake_blocks list directly.

    async def fake_create(*args, **kwargs):
        return fake_blocks

    agent.model.chat.completions.create = AsyncMock(side_effect=fake_create)

    # Run the internal method that triggers the bug and fix
    # _generate_deepresearch_report is async and returns the final report content
    # We call it and check the returned content matches the 'text' block content

    final_report = await agent._generate_deepresearch_report()

    # The final_report should be the text from the second block, not raise KeyError
    assert final_report == "This is the final report content."


@pytest.mark.asyncio
async def test_extract_text_from_blocks_raises_valueerror_on_no_text_block():
    """
    Test that the internal method _extract_text_from_blocks raises ValueError
    if no block of type 'text' is present in the blocks list.
    """

    model_id = "Qwen3.5-397B-A17B-FPB"
    agent = DeepResearchAgent(user_query="Dummy query", model=model_id)

    blocks_without_text = [
        {"type": "thinking", "thinking": "Still thinking..."},
        {"type": "thinking", "thinking": "More thinking..."},
    ]

    with pytest.raises(ValueError) as excinfo:
        agent._extract_text_from_blocks(blocks_without_text)

    assert "No text block found" in str(excinfo.value)
    assert "thinking" in str(excinfo.value)


@pytest.mark.asyncio
async def test_summarize_intermediate_results_uses_extract_text(monkeypatch):
    """
    Test that summarize_intermediate_results uses the _extract_text_from_blocks method
    to safely extract text from blocks, avoiding KeyError on 'thinking' blocks.
    """

    model_id = "Qwen3.5-397B-A17B-FPB"
    agent = DeepResearchAgent(user_query="Test summarize", model=model_id)

    # Prepare fake blocks with leading thinking block
    fake_blocks = [
        {"type": "thinking", "thinking": "Thinking..."},
        {"type": "text", "text": "Summary text here."},
    ]

    # Patch the model chat completion to return fake blocks
    async def fake_create(*args, **kwargs):
        return fake_blocks

    agent.model.chat.completions.create = AsyncMock(side_effect=fake_create)

    # Patch _extract_text_from_blocks to track calls and call original
    original_extract = agent._extract_text_from_blocks

    called = {}

    def track_extract(blocks):
        called["called"] = True
        return original_extract(blocks)

    agent._extract_text_from_blocks = track_extract

    # Run summarize_intermediate_results which internally calls the model and extracts text
    result = await agent.summarize_intermediate_results()

    # Check that _extract_text_from_blocks was called
    assert called.get("called", False)

    # The working_plan of the last subtask should be the text from the text block
    assert agent.current_subtask[-1].working_plan == "Summary text here."

    # The result should be a ToolResponse with a text block containing the summary text
    # The ToolResponse is a list of dicts with 'type' and 'text'
    assert isinstance(result, list)
    assert any(block.get("text") == "Summary text here." for block in result)


