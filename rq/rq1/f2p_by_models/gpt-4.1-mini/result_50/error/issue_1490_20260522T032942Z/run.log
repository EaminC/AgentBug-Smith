import pytest
from unittest.mock import patch, AsyncMock

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_blocks(monkeypatch):
    """
    Test that DeepResearchAgent correctly handles model output blocks that start with a 'thinking' block
    and then a 'text' block, avoiding KeyError on 'text' key access.
    """

    # Prepare a dummy response simulating the buggy model output:
    # The first block is 'thinking' without 'text', second block is 'text'.
    dummy_blocks = [
        {"type": "thinking", "thinking": "processing intermediate thoughts"},
        {"type": "text", "text": "This is the final report content."},
    ]

    # Patch the internal model client's chat completion call to return dummy_blocks
    # The DeepResearchAgent calls self.model.chat.completions.create(...) internally.
    # We patch that to return an object with .choices[0].message.content parsed as blocks.
    # But since the agent likely calls an async method and expects blocks as output,
    # we patch the method that returns blocks directly.

    # We need to patch the model's chat.completions.create method to return a response
    # that the agent uses to extract blocks. The exact internal structure depends on the code,
    # but we will patch the method that returns blocks for the final report generation.

    # Since the bug is at line 931 in deep_research_agent.py:
    # final_report_content = blocks[0]["text"]
    # and blocks is the output from the model, we patch the method that returns blocks.

    # Patch the _generate_deepresearch_report method's internal call to model.chat.completions.create
    # to return dummy_blocks as the blocks.

    # We patch DeepResearchAgent._generate_deepresearch_report to call the real method,
    # but patch the model.chat.completions.create to return dummy_blocks wrapped properly.

    # Setup the DeepResearchAgent instance with the buggy model name.
    agent = DeepResearchAgent(model_name="Qwen3.5-397B-A17B-FPB")

    async def dummy_chat_completions_create(*args, **kwargs):
        # Return a dummy response object with .choices[0].message.content = dummy_blocks
        class DummyChoice:
            def __init__(self):
                self.message = type("Message", (), {"content": dummy_blocks})

        class DummyResponse:
            def __init__(self):
                self.choices = [DummyChoice()]

        return DummyResponse()

    # Patch the model.chat.completions.create method
    monkeypatch.setattr(agent.model.chat.completions, "create", dummy_chat_completions_create)

    # We test the internal method _generate_deepresearch_report to see if it raises KeyError or not.
    # It is async and expects some arguments: checklist (list).
    checklist = ["item1", "item2"]

    # Run and assert no KeyError and the final report content is the expected text from the text block
    final_report = None
    try:
        final_report = await agent._generate_deepresearch_report(checklist)
    except KeyError as e:
        pytest.fail(f"KeyError raised unexpectedly: {e}")
    except Exception as e:
        pytest.fail(f"Unexpected exception raised: {e}")

    # The final_report should be the text from the 'text' block in dummy_blocks
    expected_text = "This is the final report content."
    assert expected_text in final_report, "Final report content does not contain expected text"

    # Also test the internal _extract_text_from_blocks method if available (post-fix)
    if hasattr(agent, "_extract_text_from_blocks"):
        extracted_text = agent._extract_text_from_blocks(dummy_blocks)
        assert extracted_text == expected_text, "_extract_text_from_blocks did not extract expected text"

    # Additionally, test that if no text block is present, it raises ValueError
    if hasattr(agent, "_extract_text_from_blocks"):
        with pytest.raises(ValueError):
            agent._extract_text_from_blocks([{"type": "thinking", "thinking": "no text here"}])[0m
