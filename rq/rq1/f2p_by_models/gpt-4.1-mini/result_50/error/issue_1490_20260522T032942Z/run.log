import pytest
from unittest.mock import patch, AsyncMock

# Import the DeepResearchAgent class from the real module
from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_blocks(monkeypatch):
    """
    Test that DeepResearchAgent correctly handles model output blocks
    that start with a 'thinking' block followed by a 'text' block,
    avoiding KeyError and producing the expected final report content.

    This test reproduces the bug described in issue #1490:
    When the model returns blocks like:
      [{'type': 'thinking', 'thinking': '...'}, {'type': 'text', 'text': 'final text'}]
    the agent should extract the 'text' block content correctly.

    The test mocks the internal model client's call to return such blocks,
    then runs the agent's _generate_deepresearch_report method and asserts
    the final report content is as expected.
    """

    # Create an instance of DeepResearchAgent with the problematic model name
    agent = DeepResearchAgent(model_name="Qwen3.5-397B-A17B-FPB")

    # Prepare dummy data for the agent's internal state to allow _generate_deepresearch_report to run
    agent.user_query = "Test research query"
    agent.prompt_dict = {
        "reporting_sys_prompt": (
            "System prompt with original_task: {original_task} and checklist: {checklist}"
        )
    }

    # Define dummy checklist for formatting
    checklist = "dummy checklist"

    # Prepare dummy messages list (empty for this test)
    msgs = []

    # Prepare the blocks that simulate the buggy model output:
    # first block is 'thinking' type without 'text', second block is 'text' type with text
    buggy_blocks = [
        {"type": "thinking", "thinking": "processing intermediate thoughts"},
        {"type": "text", "text": "This is the final report content."},
    ]

    # Patch the internal model client's call to return the buggy_blocks
    # The agent calls self.model.chat.completions.create, so we patch that
    # We patch the model attribute of the agent to mock chat.completions.create
    class DummyChatCompletions:
        async def create(self, *args, **kwargs):
            return buggy_blocks

    class DummyModel:
        def __init__(self):
            self.stream = False
            self.chat = self

        completions = property(lambda self: self)
        chat = property(lambda self: self)

        async def create(self, *args, **kwargs):
            return buggy_blocks

    dummy_model = DummyModel()

    # Assign dummy model to agent
    agent.model = dummy_model

    # Because _generate_deepresearch_report is async, run it with asyncio
    # It returns final_report_content string
    final_report_content = await agent._generate_deepresearch_report(
        checklist=checklist,
        msgs=msgs,
    )

    # Assert that the final_report_content is extracted from the 'text' block, not the 'thinking' block
    assert final_report_content == "This is the final report content."


@pytest.mark.asyncio
async def test_deep_research_agent_extract_text_from_blocks_method():
    """
    Test the _extract_text_from_blocks method directly with various block inputs,
    including blocks starting with 'thinking' and containing 'text' later,
    and verify it raises ValueError when no 'text' block is present.
    """

    agent = DeepResearchAgent(model_name="dummy")

    # Blocks with 'thinking' first, then 'text'
    blocks = [
        {"type": "thinking", "thinking": "some thought"},
        {"type": "text", "text": "desired text content"},
    ]
    text = agent._extract_text_from_blocks(blocks)
    assert text == "desired text content"

    # Blocks with only 'text' block
    blocks = [{"type": "text", "text": "only text"}]
    text = agent._extract_text_from_blocks(blocks)
    assert text == "only text"

    # Blocks with no 'text' block
    blocks = [{"type": "thinking", "thinking": "no text here"}]
    with pytest.raises(ValueError) as excinfo:
        agent._extract_text_from_blocks(blocks)
    assert "No text block found" in str(excinfo.value)[0m
