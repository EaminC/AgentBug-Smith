from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_block(monkeypatch):
    """
    Test that DeepResearchAgent correctly handles model output blocks
    that start with a 'thinking' block followed by a 'text' block, avoiding KeyError.
    """

    # Prepare a dummy model name that triggers the buggy behavior
    model_name = "Qwen3.5-397B-A17B-FPB"

    # Instantiate the agent with the model name
    agent = DeepResearchAgent(model=model_name)

    # Patch the agent's model client call to simulate the buggy model output
    # The output blocks include a 'thinking' block first, then a 'text' block
    fake_blocks = [
        {"type": "thinking", "thinking": "processing..."},
        {"type": "text", "text": "This is the final report content."},
    ]

    # We patch the internal method that calls the model to return the fake blocks
    # The actual buggy code tries to access blocks[0]["text"] which raises KeyError
    # The fix is to extract the first block with type 'text'
    async def fake_call_model(*args, **kwargs):
        return fake_blocks

    # Patch the internal method that sends messages to the model and returns blocks
    # The method _call_model or similar is not explicitly named in the snippet,
    # but from the context, DeepResearchAgent likely has an async method that returns blocks.
    # We patch the _call_model or _model_call method or the method that returns blocks.
    # Since the exact method name is not given, we patch the _generate_deepresearch_report method
    # to call the real method but patch the internal model call inside it.

    # Instead, patch the model's chat completion method used inside DeepResearchAgent
    # The agent uses self.model.stream and calls self.model.chat.completions.create
    # We patch that to return a dummy response with the blocks

    # Patch the chat completions create method to return the fake blocks
    # The exact client is not shown, but we can patch the model attribute's chat.completions.create

    # Setup patch for the model's chat completions create method
    # We mock it to return an object with .choices[0].message.content = fake_blocks
    # But the agent expects blocks as a list of dicts, so we mock the method to return fake_blocks directly

    # Patch the model's chat completions create method to return fake_blocks
    # We patch the model attribute of the agent

    class DummyResponse:
        def __init__(self, blocks):
            self.choices = [self]
            self.message = self
            self.content = blocks

    async def dummy_chat_completions_create(*args, **kwargs):
        return DummyResponse(fake_blocks)

    # Patch the model.chat.completions.create to dummy_chat_completions_create
    # The attribute chain: agent.model.chat.completions.create
    # We patch it using monkeypatch

    # Setup dummy async method to replace create
    async def async_dummy_create(*args, **kwargs):
        return DummyResponse(fake_blocks)

    # Patch the nested attribute
    # First patch agent.model.chat.completions.create
    # We need to ensure agent.model.chat.completions.create is patchable

    # Use patch.object with nested patching
    with patch.object(agent.model.chat.completions, "create", new=async_dummy_create):
        # Run the method that triggers the bug: _generate_deepresearch_report
        # This method is async and returns the final report content
        # We call it with dummy checklist and user query

        checklist = ["item1", "item2"]
        # Set user query to something
        agent.user_query = "What is the impact of AI on society?"

        # Call the method and get the report content
        final_report = await agent._generate_deepresearch_report(checklist)

        # The final_report should be the text from the 'text' block, not raise KeyError
        # So it should equal "This is the final report content."
        assert final_report == "This is the final report content."


@pytest.mark.asyncio
async def test_extract_text_from_blocks_raises_on_no_text_block():
    """
    Test that _extract_text_from_blocks raises ValueError if no text block is present.
    """
    agent = DeepResearchAgent(model="Qwen3.5-397B-A17B-FPB")

    blocks = [
        {"type": "thinking", "thinking": "processing..."},
        {"type": "thinking", "thinking": "still processing..."},
    ]

    with pytest.raises(ValueError) as excinfo:
        agent._extract_text_from_blocks(blocks)

    assert "No text block found" in str(excinfo.value)
    assert "thinking" in str(excinfo.value)  # The block types are reported


@pytest.mark.asyncio
async def test_summarize_intermediate_results_uses_extract_text(monkeypatch):
    """
    Test that summarize_intermediate_results uses _extract_text_from_blocks and does not raise KeyError
    when blocks start with a thinking block.
    """
    agent = DeepResearchAgent(model="Qwen3.5-397B-A17B-FPB")

    # Prepare fake blocks with thinking then text
    fake_blocks = [
        {"type": "thinking", "thinking": "thinking..."},
        {"type": "text", "text": "Intermediate summary text."},
    ]

    # Patch the model.chat.completions.create to return fake_blocks
    class DummyResponse:
        def __init__(self, blocks):
            self.choices = [self]
            self.message = self
            self.content = blocks

    async def async_dummy_create(*args, **kwargs):
        return DummyResponse(fake_blocks)

    with patch.object(agent.model.chat.completions, "create", new=async_dummy_create):
        # Patch current_subtask to have at least one item with working_plan attribute
        class DummySubtask:
            def __init__(self):
                self.working_plan = None

        agent.current_subtask = [DummySubtask()]

        # Call summarize_intermediate_results and check no KeyError occurs
        tool_response = await agent.summarize_intermediate_results()

        # The working_plan should be set to the text block content
        assert agent.current_subtask[-1].working_plan == "Intermediate summary text."

        # The tool_response should be a dict or object with content containing the text block
        # We check the content attribute or dict keys
        # The exact structure depends on ToolResponse, but we check the text in content
        # If tool_response is a dict or has .content attribute
        content_text = None
        if hasattr(tool_response, "content"):
            content_text = tool_response.content
        elif isinstance(tool_response, dict):
            content_text = tool_response.get("content", None)

        # The content should contain the intermediate summary text
        assert content_text is not None
        assert "Intermediate summary text." in str(content_text) or content_text == "Intermediate summary text."


