from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_blocks(monkeypatch):
    """
    This test verifies that DeepResearchAgent correctly handles model output
    blocks that start with a 'thinking' block followed by a 'text' block,
    avoiding KeyError on 'text' key access.

    On the buggy codebase, this test should fail with KeyError.
    After the fix, it should pass.
    """

    # Prepare a dummy model name that triggers the bug scenario
    model_name = "Qwen3.5-397B-A17B-FPB"

    # Instantiate the agent with the buggy model name
    agent = DeepResearchAgent(model=model_name)

    # Patch the agent's model call to simulate the buggy model output
    # The model returns blocks with a leading 'thinking' block and then a 'text' block
    thinking_then_text_blocks = [
        {"type": "thinking", "thinking": "processing intermediate thoughts..."},
