[32mimport asyncio
import pytest
from unittest.mock import patch, AsyncMock

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_blocks():
    """
    This test verifies that DeepResearchAgent correctly handles model output blocks
    that include a leading 'thinking' block without a 'text' key, which previously
    caused a KeyError. The test mocks the internal model client's chat completion
    call to return blocks with a 'thinking' block followed by a 'text' block.

    Expected behavior:
    - The agent should extract the 'text' from the correct block without raising KeyError.
    - The final report content should match the 'text' block content.
    """

    # Create an instance of DeepResearchAgent with the problematic model name
    agent = DeepResearchAgent(model_name="Qwen3.5-397B-A17B-FPB")

    # Prepare a dummy user query
    agent.user_query = "Test research query"

    # Prepare mock blocks simulating the buggy model output:
    # first block is 'thinking' without 'text' key, second block has 'text'
    mock_blocks = [
        {"type": "thinking", "thinking": "Processing..."},
        {"type": "text", "text": "This is the final report content."},
    ]

    # Patch the internal model client's chat completion method to return the mock blocks
    # The method to patch is assumed to be agent.model.chat.completions.create or similar
    # We patch the method that returns the blocks list used in _generate_deepresearch_report
    # We patch DeepResearchAgent.model.chat.completions.create to return a dummy response with blocks

    # The exact method name depends on the implementation, but from the patch and code,
    # it looks like agent.model.chat.completions.create is called and returns an object with 'choices' containing 'message' with 'content' or 'blocks'.
    # We mock it to return an object with .choices[0].message.content or .choices[0].message.blocks

    # We create a dummy async function to replace the real call
    async def mock_chat_completion(*args, **kwargs):
        class DummyChoice:
            def __init__(self):
                self.message = {"blocks": mock_blocks}

        class DummyResponse:
            def __init__(self):
                self.choices = [DummyChoice()]

        return DummyResponse()

    # Patch the model's chat completion method
    with patch.object(agent.model.chat.completions, "create", new=mock_chat_completion):
        # Call the internal method that triggers the bug: _generate_deepresearch_report
        # It is async and returns the final report content string
        final_report = await agent._generate_deepresearch_report()

        # The final report content should be the text from the second block, not raise KeyError
        assert final_report == "This is the final report content."


@pytest.mark.asyncio
async def test_extract_text_from_blocks_raises_value_error_on_no_text_block():
    """
    This test verifies that the _extract_text_from_blocks method raises a ValueError
    when no block with type 'text' is present in the blocks list.
    """

    agent = DeepResearchAgent(model_name="Qwen3.5-397B-A17B-FPB")

    # Blocks without any 'text' type block
    blocks = [
        {"type": "thinking", "thinking": "Still thinking..."},
        {"type": "thinking", "thinking": "Almost done..."},
    ]

    with pytest.raises(ValueError) as excinfo:
        agent._extract_text_from_blocks(blocks)

    assert "No text block found in model output" in str(excinfo.value)[0m
