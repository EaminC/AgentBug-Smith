[32mimport asyncio
import pytest
from unittest.mock import patch, AsyncMock

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_block_correctly():
    """
    This test verifies that DeepResearchAgent correctly handles model output blocks
    that start with a 'thinking' block followed by a 'text' block, avoiding KeyError.

    It simulates the model response with blocks:
    [{'type': 'thinking', 'thinking': 'some internal thought'}, {'type': 'text', 'text': 'final report text'}]

    The buggy code would raise KeyError on blocks[0]['text'] because blocks[0] is 'thinking' type without 'text' key.
    The fixed code extracts the first block with type 'text' safely.

    The test asserts that the final report content extracted matches the expected text block content.
    """

    # Create an instance of DeepResearchAgent with the problematic model name
    agent = DeepResearchAgent(model_name="Qwen3.5-397B-A17B-FPB")

    # Patch the internal model call to simulate the buggy model output
    # The agent calls self.model.chat.completions.create internally, so patch that
    # We patch the model attribute's chat.completions.create coroutine to return the blocks with thinking + text
    thinking_block = {"type": "thinking", "thinking": "some internal thought"}
    text_block = {"type": "text", "text": "This is the final report content."}
    fake_blocks = [thinking_block, text_block]

    # We need to patch the async method that returns blocks
    # From the deep_research_agent.py code, the method that calls model.chat.completions.create returns blocks
    # We patch the model.chat.completions.create to return a dummy object with .choices[0].message.content parsed into blocks
    # But since the agent code expects blocks directly, we patch the method that returns blocks or patch the model call to return blocks

    # Patch the model.chat.completions.create to return a dummy with .choices[0].message.content that the agent parses into blocks
    # To simplify, patch the _generate_deepresearch_report method to call the real method but patch the model call inside

    async def fake_chat_completions_create(*args, **kwargs):
        class DummyChoice:
            def __init__(self):
                self.message = type("Message", (), {})()
                # The agent expects blocks as list of dicts, so we simulate the content as blocks
                # The agent code expects blocks = response.choices[0].message.content
                # So we set content to fake_blocks
                self.message.content = fake_blocks

        class DummyResponse:
            def __init__(self):
                self.choices = [DummyChoice()]

        return DummyResponse()

    # Patch the model.chat.completions.create async method
    with patch.object(agent.model.chat.completions, "create", new=AsyncMock(side_effect=fake_chat_completions_create)):

