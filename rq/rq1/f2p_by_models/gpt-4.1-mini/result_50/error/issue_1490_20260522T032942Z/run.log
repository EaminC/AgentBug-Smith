async def test_deep_research_agent_handles_thinking_blocks():
    """
    This test verifies that DeepResearchAgent correctly handles model output blocks
    that include a leading 'thinking' block without a 'text' key, followed by a 'text' block.
    It should not raise KeyError and should extract the text content properly.
    """

    # Instantiate the agent with the specific model that triggers the bug
    agent = DeepResearchAgent(model_name="Qwen3.5-397B-A17B-FPB")

    # Prepare dummy blocks simulating the buggy model output:
    # First block is 'thinking' type without 'text', second block is 'text' type with text content.
    thinking_block = {"type": "thinking", "thinking": "processing..."}
    text_block = {"type": "text", "text": "This is the final report content."}
    blocks = [thinking_block, text_block]

    # Patch the internal model call that returns blocks to simulate the buggy model response
    # We patch the method that calls the model and returns blocks.
    # From the patch, _generate_deepresearch_report calls self.model.chat.completions.create,
    # but we do not mock the entire method, only the internal client call.
    # We patch the model's chat.completions.create to return the blocks above.

    # The DeepResearchAgent uses self.model.stream and self.model.chat.completions.create internally.
    # We patch the create method to return a dummy object with .choices[0].message.content = blocks

    # However, the agent expects the blocks as a list of dicts, so we patch the method that returns blocks.

    # We patch the _generate_deepresearch_report method to call the real method but mock the model call inside.

    # Patch the model's chat.completions.create to return a dummy response with the blocks
    dummy_response = AsyncMock()
    dummy_response.choices = [AsyncMock()]
    dummy_response.choices[0].message = AsyncMock()
    dummy_response.choices[0].message.content = blocks

