[32mimport asyncio
import pytest
from unittest.mock import patch, AsyncMock

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_blocks(monkeypatch):
    """
    This test verifies that DeepResearchAgent can handle model output blocks
    that start with a 'thinking' type block followed by a 'text' type block,
    which previously caused a KeyError due to direct indexing without filtering.

    The test mocks the model's generate_response method to return blocks with
    a leading 'thinking' block and a subsequent 'text' block, simulating the
    Qwen3.5-397B-A17B-FPB model behavior.

    Expected behavior:
    - The agent should extract the 'text' block correctly without raising KeyError.
    - The final report content should match the text in the 'text' block.
    """

    # Create an instance of DeepResearchAgent with the problematic model name
    agent = DeepResearchAgent(model_name="Qwen3.5-397B-A17B-FPB")

    # Patch the model's generate_response method to simulate the buggy output blocks
    thinking_block = {"type": "thinking", "thinking": "processing..."}
    text_block = {"type": "text", "text": "This is the final report content."}
    mocked_blocks = [thinking_block, text_block]

    async def mock_generate_response(*args, **kwargs):
        # Simulate the model returning blocks with a leading thinking block
        return mocked_blocks

    # Patch the internal model client's generate_response method used by DeepResearchAgent
    # We patch the method that returns the blocks list, so the agent will receive the mocked blocks
    # The exact method to patch depends on DeepResearchAgent implementation:
    # From the patch, it looks like the agent calls self.model.generate_response or similar.
    # We patch DeepResearchAgent.model.generate_response to return mocked_blocks.
    monkeypatch.setattr(agent.model, "generate_response", mock_generate_response)

    # Run the method that triggers the bug: _generate_deepresearch_report
    # This method is async and returns the final report content.
    # We call it with dummy checklist and user_query to trigger the bug.
    checklist = "dummy checklist"
    agent.user_query = "dummy query"

    # The method _generate_deepresearch_report is async and returns a string report
    report = await agent._generate_deepresearch_report(checklist)

    # Assert that the report content matches the text block's text, not the thinking block
    assert report == text_block["text"], (
        "The agent failed to extract the correct text block from the model output blocks."
    )[0m
