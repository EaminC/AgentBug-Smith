import pytest
from unittest.mock import patch, AsyncMock

# Import the DeepResearchAgent from the real module
from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_blocks_correctly():
    """
    This test verifies that DeepResearchAgent correctly handles model output blocks
    that start with a 'thinking' type block followed by a 'text' type block,
    avoiding KeyError and producing the expected final report content.
    """

    # Create an instance of DeepResearchAgent with the buggy model name
    # The actual model initialization parameters may vary; adjust as needed.
    # We assume a minimal init is possible with model name only for test.
    agent = DeepResearchAgent(model_name="Qwen3.5-397B-A17B-FPB")

    # Patch the model's call to simulate the buggy model output with thinking block first
    thinking_block = {"type": "thinking", "thinking": "processing..."}
    text_block = {"type": "text", "text": "This is the final report content."}
    mocked_blocks = [thinking_block, text_block]

    # Patch the internal model call that returns blocks to return our mocked_blocks
    # The exact method to patch depends on DeepResearchAgent internals.
    # From the patch, it seems the model is called via self.model or similar.
    # We'll patch the method that returns the blocks for final report generation.

    # We patch the _generate_deepresearch_report method's internal call to self.model
    # to return mocked_blocks as output blocks.

    # Because the code calls self.model.stream and awaits self.model(...),
    # we patch the model's __call__ method to return mocked_blocks.

    # Patch the model attribute on the agent
    agent.model = AsyncMock()
    # The model call returns a dict with 'choices' containing 'message' with 'content' as blocks
    # But from the code, it seems blocks is the direct output of the model call.
    # So we mock the model call to return mocked_blocks directly.

    # Setup the mock to return mocked_blocks when awaited
    agent.model.stream = False
    agent.model.__call__.return_value = asyncio.Future()
    agent.model.__call__.return_value.set_result(mocked_blocks)

    # We patch the logger to suppress output during test
    with patch("examples.agent.deep_research_agent.deep_research_agent.logger") as mock_logger:
        # Run the _generate_deepresearch_report coroutine with minimal parameters
        # The method signature:
        # async def _generate_deepresearch_report(self, checklist: str) -> str:
        # Provide a dummy checklist string
        checklist = "dummy checklist"

        # Run the method and capture the final report content
        final_report = await agent._generate_deepresearch_report(checklist)

        # The final_report should be the text from the text block, not raise KeyError
        assert final_report == "This is the final report content."

        # Also ensure the logger.info was called with the final report content
        mock_logger.info.assert_called()
        args, kwargs = mock_logger.info.call_args
        assert "final Report" in args[0]
        assert "This is the final report content." in args[1]


@pytest.mark.asyncio
async def test_extract_text_from_blocks_raises_on_no_text_block():
    """
    This test verifies that _extract_text_from_blocks raises a ValueError
    if no block of type 'text' is found.
    """

    agent = DeepResearchAgent(model_name="Qwen3.5-397B-A17B-FPB")

    # Blocks with no 'text' type block
    blocks = [
        {"type": "thinking", "thinking": "processing..."},
        {"type": "thinking", "thinking": "still processing..."},
    ]

    with pytest.raises(ValueError) as excinfo:
        # Call the _extract_text_from_blocks method directly
        agent._extract_text_from_blocks(blocks)

    # The error message should mention no text block found
    assert "No text block found" in str(excinfo.value)[0m
