from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_handles_thinking_blocks(monkeypatch):
    """
    This test verifies that DeepResearchAgent correctly handles model output blocks
    that start with a 'thinking' block followed by a 'text' block, avoiding KeyError.

    It simulates the buggy scenario where the first block is 'thinking' without 'text' key,
    and expects the agent to extract the 'text' from the correct block.

    On the buggy codebase, this test should fail with KeyError.
    After the fix, it should pass.
    """

    # Prepare a dummy model name that triggers the problematic behavior
    model_name = "Qwen3.5-397B-A17B-FPB"

    # Create the agent instance
    agent = DeepResearchAgent(model=model_name)

    # Patch the agent's model call to return a mocked response with thinking block first
    thinking_then_text_blocks = [
        {"type": "thinking", "thinking": "processing..."},
        {"type": "text", "text": "This is the final report content."},
    ]

    # We patch the internal call that returns the blocks list to simulate the model output
    # The exact method to patch depends on the agent's implementation.
    # From the patch, it looks like _generate_deepresearch_report calls self.model.chat.completions.create
    # But we must not patch the method under test, only the internal client call.
    # So we patch the model's chat completions create method to return the blocks above.

    # The agent uses self.model.stream and calls chat.completions.create with msgs and stream
    # We patch self.model.chat.completions.create to return the blocks list wrapped in a suitable object.

    # Define a dummy async function to replace chat.completions.create
    async def dummy_chat_completions_create(*args, **kwargs):
        # Return an object with an attribute 'choices' that has 'message' with 'content' as blocks
        # But from the code, it seems it expects blocks directly from the call
        # The code snippet shows:
        # blocks = await self.model.chat.completions.create(...)
        # So the returned value is blocks list directly
        return thinking_then_text_blocks

    # Patch the model's chat completions create method
    # The model attribute is agent.model
    # We patch agent.model.chat.completions.create
    # But agent.model might be a string (model name) in this codebase, so we need to patch deeper.

    # To patch correctly, we patch DeepResearchAgent._generate_deepresearch_report's call to self.model.chat.completions.create
    # But we cannot patch _generate_deepresearch_report itself.
    # Instead, patch the model client inside the agent.

    # The agent likely has an attribute self.model that is a model client object.
    # So we patch agent.model.chat.completions.create

    # To do so, we patch the attribute after instantiation.

    # First, check if agent.model has attribute chat.completions.create
    # If not, we create a dummy mock for agent.model with chat.completions.create

    # Setup the mock model client
    class DummyChat:
        def __init__(self):
            self.completions = AsyncMock()
            self.completions.create = AsyncMock(side_effect=dummy_chat_completions_create)

    class DummyModel:
        def __init__(self):
            self.chat = DummyChat()
            self.stream = False

    agent.model = DummyModel()

    # Now run the method that triggers the bug
    # The bug occurs in _generate_deepresearch_report, which is async and takes checklist argument
    # We call it with a dummy checklist

    checklist = "dummy checklist"

    # Run and capture output
    final_report = await agent._generate_deepresearch_report(checklist)

    # The final_report should be the text from the text block, not raise KeyError
    expected_text = "This is the final report content."

    assert final_report == expected_text, (
        "DeepResearchAgent failed to extract text from blocks with leading thinking block."
    )[0m
