        {"type": "thinking", "thinking": "Thinking..."},
        {"type": "text", "text": "Extracted text content."},
        {"type": "other", "data": "irrelevant"},
    ]

    # Call the _extract_text_from_blocks method directly
    extracted_text = agent._extract_text_from_blocks(blocks)

    # It should return the text from the 'text' block, ignoring 'thinking'
    assert extracted_text == "Extracted text content"

    # Test that it raises ValueError if no 'text' block is present
    blocks_no_text = [{"type": "thinking", "thinking": "Only thinking block"}]

    with pytest.raises(ValueError):
        agent._extract_text_from_blocks(blocks_no_text)[0m
