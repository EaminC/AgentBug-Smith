# --- end inject ---

# Injected environment variables for Forge API support
ENV FORGE_API_KEY="forge-key" \
    OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Set working directory to repository root /app
WORKDIR /app

# Copy entire repository (do not selectively copy to satisfy tests and scripts)
COPY . .

# Install system dependencies required for Python packages that may need compilation, git for test imports
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    libffi-dev \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies robustly:
# - Check if requirements.txt exists in autogpt subfolder (main project)
# - If exists, install from it and editable install of autogpt
# - Always install testing dependencies and extras
RUN if [ -f "autogpt/requirements.txt" ]; then \
    pip install -r autogpt/requirements.txt && pip install -e autogpt; \
else \
    pip install -e autogpt; \
fi && \
pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai

# Preflight: test imports to verify environment is ready
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default to bash for test harness compatibility
CMD ["/bin/bash"]

# branch: python/requirements.txt, robust dependency install, Forge API env vars, test tooling included
