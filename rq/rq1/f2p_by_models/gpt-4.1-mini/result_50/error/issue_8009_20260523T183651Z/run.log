[32mFROM python:3.10-slim as test_builder

WORKDIR /app

# Set Forge environment variables required by the prompt
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Copy entire repository for tests and build
COPY . .

# Upgrade pip and core packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Determine if src/ layout or imports from src. exist in tests (to avoid editable install)
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        echo "Detected src/ layout or src. imports in tests; setting PYTHONPATH and installing dependencies without editable install"; \
        export PYTHONPATH=/app; \
        pip install -r autogpt/requirements.txt 2>/dev/null || true; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
        echo "No src/ layout detected; installing dependencies with editable install"; \
        pip install -r autogpt/requirements.txt 2>/dev/null || true; \
        pip install -e autogpt; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Preflight import check to fail early if core modules missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests to ensure functionality
RUN pytest -v --cov=autogpt --cov-branch --cov-report term-missing --numprocesses=4 --durations=10 tests/unit tests/integration

# Final minimal runtime image
FROM python:3.10-slim

WORKDIR /app

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

COPY --from=test_builder /app/autogpt /app/autogpt
COPY --from=test_builder /app/requirements.txt /app/requirements.txt
COPY --from=test_builder /app/setup.py /app/setup.py
# Assumption: setup.py exists for production install

RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt 2>/dev/null || true && \
    pip install -e . --no-deps

CMD ["/bin/bash"][0m
