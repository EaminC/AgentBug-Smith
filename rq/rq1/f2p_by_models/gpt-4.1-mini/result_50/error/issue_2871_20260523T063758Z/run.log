ARG BUILD_TYPE=dev

FROM python:3.10-slim AS base

# Install system dependencies needed by project or tests (minimal here)
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium-driver \
    firefox-esr \
    ca-certificates \
    curl \
    jq \
    wget \
    git \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/root/.local/bin:${PATH}"

WORKDIR /app

COPY requirements.txt .

# Detect src/ layout or imports from src.* in tests for PYTHONPATH logic
# Assumption: No src/ directory and no import src. in tests as none provided in file list
# Thus we will use editable install.

FROM base AS test_builder

COPY . .

RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai && \
    python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests to verify build
RUN pytest --cov=autogpt --cov-report term-missing --cov-branch --cov-report xml --cov-report term

# Runtime image with minimal dependencies only (no test deps)
FROM python:3.10-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium-driver \
    firefox-esr \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/root/.local/bin:${PATH}"

WORKDIR /app

COPY requirements.txt .
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt && \
    # Assumption: no editable install in runtime to keep image minimal, install only prod deps
    python -c 'import pkg_resources; print("runtime preflight ok")'

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

