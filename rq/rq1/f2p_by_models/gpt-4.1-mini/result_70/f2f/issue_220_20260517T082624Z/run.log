# --- end inject ---

FROM python:3.12-slim

WORKDIR /app

# Inject Forge API environment variables for OpenAI and Anthropic SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Copy entire repo into container
COPY . .

# Upgrade Python packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies and project editable install with robust conditional logic
RUN if [ -f requirements.txt ]; then \
        pip install -r requirements.txt && \
        pip install -e . ; \
    elif [ -f pyproject.toml ] && [ -f poetry.lock ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi && \
        pip install -e . ; \
    elif [ -f pyproject.toml ]; then \
        pip install -e . ; \
    else \
        pip install -e . ; \
    fi

# Install test dependencies explicitly for pytest framework
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout

# Validate that pytest and packaging is functional
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Entrypoint command: bash
CMD ["/bin/bash"]

# branch: python/requirements.txt or pyproject.toml
