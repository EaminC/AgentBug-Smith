[32mimport os
import shutil
import tempfile
import yaml
import pytest
from mle.utils import system


class DummyConsole:
    def __init__(self):
        self.logged = []

    def log(self, msg):
        self.logged.append(msg)


@pytest.fixture
def temp_config_dir(monkeypatch):
    # Create a temporary directory to act as config dir
    temp_dir = tempfile.mkdtemp()
    monkeypatch.setenv("MLE_CONFIG_DIR", temp_dir)
    yield temp_dir
    shutil.rmtree(temp_dir)


def write_config_file(path, content):
    with open(path, "w") as f:
        yaml.dump(content, f)


def test_check_config_with_missing_file(temp_config_dir):
    console = DummyConsole()
    # No config file present
    result = system.check_config(console)
    assert result is False
    assert any("not found" in msg for msg in console.logged)


def test_check_config_with_empty_file(temp_config_dir):
    console = DummyConsole()
    config_path = os.path.join(temp_config_dir, "config.yaml")
    # Write empty file (yaml.safe_load returns None)
    with open(config_path, "w") as f:
        f.write("")
    result = system.check_config(console)
    assert result is False
    assert any("could not be loaded" in msg for msg in console.logged)


def test_check_config_with_valid_file_no_search_key(temp_config_dir):
    console = DummyConsole()
    config_path = os.path.join(temp_config_dir, "config.yaml")
    write_config_file(config_path, {"some_key": "some_value"})
    # Ensure SEARCH_API_KEY is not set before
    if "SEARCH_API_KEY" in os.environ:
        del os.environ["SEARCH_API_KEY"]
    result = system.check_config(console)
    assert result is True
    assert "SEARCH_API_KEY" not in os.environ


def test_check_config_with_valid_file_with_search_key(temp_config_dir):
    console = DummyConsole()
    config_path = os.path.join(temp_config_dir, "config.yaml")
    write_config_file(config_path, {"search_key": "dummy_api_key"})
    # Clear env var if set
    if "SEARCH_API_KEY" in os.environ:
        del os.environ["SEARCH_API_KEY"]
    result = system.check_config(console)
    assert result is True
    assert os.environ.get("SEARCH_API_KEY") == "dummy_api_key"


def test_check_config_moves_old_config(temp_config_dir, monkeypatch):
    console = DummyConsole()
    old_path = os.path.join(temp_config_dir, "config.yaml.old")
    new_path = os.path.join(temp_config_dir, "config.yaml")
    # Write old config file
    write_config_file(old_path, {"search_key": "old_key"})
    # Remove new config if exists
    if os.path.exists(new_path):
        os.remove(new_path)
    result = system.check_config(console)
    # Old file should be moved to new path
    assert os.path.exists(new_path)
    assert not os.path.exists(old_path)
    assert result is True
    assert os.environ.get("SEARCH_API_KEY") == "old_key"[0m
