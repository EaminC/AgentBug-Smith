    console.log.assert_called()
    # The message should mention could not be loaded or similar
    assert any("could not be loaded" in str(call.args[0]) for call in console.log.call_args_list)


def test_check_config_with_valid_file_no_search_key(temp_config_dir):
    config_path = os.path.join(temp_config_dir, "config.yaml")
    # Write valid yaml without search_key
    write_yaml_config(config_path, {"some_key": "some_value"})

    console = mock.Mock()
    with mock.patch("os.path.expanduser", return_value=temp_config_dir):
        result = system.check_config(console)
    assert result is True


def test_check_config_with_valid_file_with_search_key(temp_config_dir):
    config_path = os.path.join(temp_config_dir, "config.yaml")
    # Write valid yaml with search_key
    write_yaml_config(config_path, {"search_key": "dummy_key"})

    console = mock.Mock()
    # Remove SEARCH_API_KEY if set
    if "SEARCH_API_KEY" in os.environ:
        del os.environ["SEARCH_API_KEY"]
    with mock.patch("os.path.expanduser", return_value=temp_config_dir):
        result = system.check_config(console)
    assert result is True
    # Check that environment variable is set
    assert os.environ.get("SEARCH_API_KEY") == "dummy_key"


def test_check_config_moves_old_config(temp_config_dir):
    # Simulate old config at ~/.mle_config.yaml
    old_config_path = os.path.join(temp_config_dir, "..", ".mle_config.yaml")
    old_config_path = os.path.abspath(old_config_path)
    new_config_path = os.path.join(temp_config_dir, "config.yaml")

    # Create old config file
    os.makedirs(os.path.dirname(old_config_path), exist_ok=True)
    with open(old_config_path, "w") as f:
        yaml.dump({"search_key": "old_dummy"}, f)

    # Patch expanduser to point ~/.mle to temp_config_dir
    original_expanduser = os.path.expanduser

    def fake_expanduser(path):
        if path == "~/.mle":
            return temp_config_dir
        return original_expanduser(path)

    # We patch os.path.exists but avoid recursion by calling original os.path.exists
    original_os_path_exists = os.path.exists

    def side_effect_exists(path):
        if path == old_config_path:
            return True
        if path == new_config_path:
            return False
        return original_os_path_exists(path)

    with mock.patch("os.path.expanduser", side_effect=fake_expanduser):
        with mock.patch("os.path.exists", side_effect=side_effect_exists):
            console = mock.Mock()
            result = system.check_config(console)

    assert result is True
