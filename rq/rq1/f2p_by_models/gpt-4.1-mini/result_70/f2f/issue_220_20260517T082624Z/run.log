    def fake_expanduser(path):
        if path == "~/.mle":
            return temp_config_dir
        return original_expanduser(path)

    # We patch os.path.exists but avoid recursion by calling original os.path.exists
    original_os_path_exists = os.path.exists

    def side_effect_exists(path):
        if path == old_config_path:
            return True
        if path == new_config_path:
            return False
        return original_os_path_exists(path)

    with mock.patch("os.path.expanduser", side_effect=fake_expanduser):
        with mock.patch("os.path.exists", side_effect=side_effect_exists):
            console = mock.Mock()
            result = system.check_config(console)

    assert result is True
    # The old config should have been moved to new config path
    assert os.path.exists(new_config_path)
    # The old config should no longer exist
    assert not os.path.exists(old_config_path)
    # The environment variable should be set from old config
    assert os.environ.get("SEARCH_API_KEY") == "old_dummy"[0m
