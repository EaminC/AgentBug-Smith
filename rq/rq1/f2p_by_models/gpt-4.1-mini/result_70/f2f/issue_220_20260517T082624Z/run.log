def write_yaml_config(path, data):
    with open(path, "w") as f:
        yaml.dump(data, f)


def test_check_config_with_empty_file(temp_config_dir):
    config_path = os.path.join(temp_config_dir, "config.yaml")
    # Write an empty file (which loads as None)
    with open(config_path, "w") as f:
        f.write("")

    console = mock.Mock()
    # Patch os.path.expanduser to point to temp_config_dir for ~/.mle
    with mock.patch("os.path.expanduser", return_value=temp_config_dir):
        result = system.check_config(console)
    assert result is False
