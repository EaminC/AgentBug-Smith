def test_lancedb_memory_add_query_delete_count_drop_reset(dummy_project_path):
    # Patch get_config to return a controlled config dict
    with patch("mle.utils.memory.get_config") as mock_get_config:
        mock_get_config.return_value = {"platform": "OpenAI", "api_key": "dummy_key"}

        # Patch lancedb.connect to return a mock client
        with patch("mle.utils.memory.lancedb.connect") as mock_connect:
            mock_client = MagicMock()
            mock_connect.return_value = mock_client

