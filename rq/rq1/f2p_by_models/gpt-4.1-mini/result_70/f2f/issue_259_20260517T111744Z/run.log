def test_lancedb_memory_add_query_delete_count_drop_reset(dummy_project_path):
    # Patch get_config to return a controlled config dict
    with patch("mle.utils.memory.get_config") as mock_get_config:
        mock_get_config.return_value = {"platform": "OpenAI", "api_key": "dummy_key"}

        # Patch lancedb.connect to return a mock client
        with patch("mle.utils.memory.lancedb.connect") as mock_connect:
            mock_client = MagicMock()
            mock_connect.return_value = mock_client

            # Mock table_names to simulate no tables initially
            mock_client.table_names.return_value = []

            # Mock create_table and open_table
            mock_table = MagicMock()
            mock_client.open_table.return_value = mock_table

            # Mock open_table().add to do nothing
            mock_table.add.return_value = None

            # Mock open_table().search().limit().to_list to return dummy search results
            mock_search = MagicMock()
            mock_table.search.return_value = mock_search
            mock_search.limit.return_value = mock_search
            mock_search.to_list.return_value = [{"id": "dummy_id", "text": "dummy_text", "vector": [0.1, 0.2]}]

            # Mock open_table().delete to return True
            mock_table.delete.return_value = True

            # Mock client.drop_table to return True
            mock_client.drop_table.return_value = True

            # Mock open_table().count_rows to return a count
            mock_table.count_rows.return_value = 1

            # Patch the embedding registry to return a dummy embedding object
            with patch("mle.utils.memory.get_registry") as mock_get_registry:
                dummy_embedding = MagicMock()
                dummy_embedding.compute_source_embeddings.side_effect = lambda texts: [[0.1, 0.2, 0.3] for _ in texts]
                mock_get_registry.return_value.get.return_value = dummy_embedding

                mem = memory.LanceDBMemory(dummy_project_path)

                # Test add with multiple texts
                texts = ["hello world", "test text"]
                ids = mem.add(texts)
                assert isinstance(ids, list)
                assert len(ids) == len(texts)
                # The client should have created a table with these texts
                mock_client.create_table.assert_called_once()
                # The data passed to create_table should contain keys: vector, text, id, metadata
                called_data = mock_client.create_table.call_args[1]["data"]
                assert len(called_data) == len(texts)
                for item in called_data:
                    assert "vector" in item
                    assert "text" in item
                    assert "id" in item
                    assert "metadata" in item

                # Test query returns expected structure
                results = mem.query(["hello"])
                assert isinstance(results, list)
                assert len(results) == 1
                assert isinstance(results[0], list)
                assert all(isinstance(r, dict) for r in results[0])

                # Test delete returns True
                assert mem.delete(ids[0]) is True

                # Test drop returns True
                assert mem.drop() is True

                # Test count returns int
                count = mem.count()
                assert isinstance(count, int)
                assert count == 1

                # Test reset calls drop
                with patch.object(mem, "drop") as mock_drop:
                    mem.reset()
                    mock_drop.assert_called_once()


def test_lancedb_memory_add_single_text_and_metadata(dummy_project_path):
    with patch("mle.utils.memory.get_config") as mock_get_config, \
         patch("mle.utils.memory.lancedb.connect") as mock_connect, \
         patch("mle.utils.memory.get_registry") as mock_get_registry:

        mock_get_config.return_value = {"platform": "OpenAI", "api_key": "dummy_key"}
        mock_client = MagicMock()
        mock_connect.return_value = mock_client
        mock_client.table_names.return_value = []

        mock_table = MagicMock()
        mock_client.open_table.return_value = mock_table
        mock_table.add.return_value = None

        dummy_embedding = MagicMock()
        dummy_embedding.compute_source_embeddings.side_effect = lambda texts: [[0.1, 0.2, 0.3] for _ in texts]
        mock_get_registry.return_value.get.return_value = dummy_embedding

        mem = memory.LanceDBMemory(dummy_project_path)

        text = "single text"
        metadata = {"key": "value"}
        ids = mem.add(text, metadata)
        assert isinstance(ids, list)
        assert len(ids) == 1

        # It should create the table on first add call
        mock_client.create_table.assert_called_once()
        called_data = mock_client.create_table.call_args[1]["data"]
        assert len(called_data) == 1
        item = called_data[0]
        assert item["text"] == text
        assert item["metadata"] == metadata
        assert "vector" in item
        assert "id" in item


