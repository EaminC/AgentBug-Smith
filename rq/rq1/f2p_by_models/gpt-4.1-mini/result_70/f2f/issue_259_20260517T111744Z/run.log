[32mFROM python:3.11-slim AS test_builder

WORKDIR /app

# Copy entire repo for tests and build
COPY . .

# Detect src/ layout or tests importing src to avoid editable install if needed
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi; \
    # Check for src/ directory or tests importing src. If yes, skip editable install and set PYTHONPATH
    if [ -d "src" ] || grep -R -qE '^\s*(from|import) src(\.|$)' tests 2>/dev/null; then \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
        echo "src layout detected, skipping editable install"; \
    else \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# Set PYTHONPATH if src layout detected to avoid import conflicts (fallback)
RUN if [ -d "src" ] || grep -R -qE '^\s*(from|import) src(\.|$)' tests 2>/dev/null; then \
        echo "Setting PYTHONPATH=/app for src layout"; \
        echo 'export PYTHONPATH=/app' >> /etc/profile.d/pythonpath.sh; \
    fi

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests to validate build and environment; assuming test discovery via pytest
RUN pytest || (echo "Tests failed" && exit 1)

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Minimal runtime image for production
FROM python:3.11-slim AS runtime

WORKDIR /app

COPY --from=test_builder /app /app

# Install only production dependencies
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -f "requirements.txt" ]; then \
        pip install --no-cache-dir -r requirements.txt; \
    fi; \
    pip install --no-cache-dir -e .; \
    # Remove test dependencies if any leftover (assumption: no test deps in requirements.txt) \
    true

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

CMD ["/bin/bash"][0m
