def test_query_returns_string_and_limits_tools(monkeypatch):
    gemini = gemini_module.GeminiModel(api_key="key", model=None)

    # We simulate a sequence where the model calls a function multiple times,
    # then stops after the search attempt limit.

    call_count = {"count": 0}

    def dummy_get_function(name):
        def dummy_func(**kwargs):
            return f"result_for_{name}_{call_count['count']}"
        return dummy_func

    monkeypatch.setattr(gemini_module, "get_function", dummy_get_function)

    # Prepare dummy function call parts for the response
    def dummy_generate_content(model, contents, config):
        # On first calls, return a function call, then no function call to end
        if call_count["count"] < 4:
            call_count["count"] += 1
            func_call = DummyFunctionCall(name="search_arxiv", args={"query": "test"})
            part = DummyTypesPart(function_call=func_call)
            content = DummyTypesContent(parts=[part])
            candidate = DummyCandidate(content=content)
            return DummyResponse(candidates=[candidate])
        else:
            return DummyResponse(text="final response")

    monkeypatch.setattr(gemini.client.models, "generate_content", dummy_generate_content)

    # Compose chat history with some user messages
    chat_history = [
        {"role": "system", "content": "System instruction"},
        {"role": "user", "content": "Hello"},
    ]

    # Provide functions that include search functions to test limit
    functions = [
        {"name": "search_arxiv", "description": "Search arxiv", "parameters": {"type": "object", "properties": {"query": {"type": "string"}}}},
    ]

    response = gemini.query(chat_history, functions=functions)

    # The response should be a string and include the warning about search limit
    assert isinstance(response, str)
    assert "Search function limit" in response or "final response" in response


