[32mimport builtins
import types as pytypes
import pytest

from mle.model import gemini
from mle.function import SEARCH_FUNCTIONS


class DummyFunctionResponse:
    def __init__(self, name, args):
        self.name = name
        self.args = args


class DummyPart:
    def __init__(self, function_call=None, text=""):
        self.function_call = function_call
        self.text = text


class DummyContent:
    def __init__(self, parts=None, role=None):
        self.parts = parts or []
        self.role = role


class DummyCandidate:
    def __init__(self, content=None):
        self.content = content


class DummyResponse:
    def __init__(self, candidates=None, text=""):
        self.candidates = candidates or []
        self.text = text


class DummyClientModels:
    def __init__(self):
        self.generate_content_called = 0
        self.generate_content_stream_called = 0

    def generate_content(self, model, contents, config):
        self.generate_content_called += 1
        # Simulate function call on 2nd call to test tool calling logic
        if self.generate_content_called == 1:
            # First response with a function call
            func_call = DummyFunctionResponse(
                name="search_arxiv",
                args={"query": "test query"}
            )
            part = DummyPart(function_call=func_call)
            content = DummyContent(parts=[part])
            candidate = DummyCandidate(content=content)
            return DummyResponse(candidates=[candidate], text="")
        elif self.generate_content_called == 2:
            # Second response with no function call, normal text
            content = DummyContent(parts=[])
            candidate = DummyCandidate(content=content)
            return DummyResponse(candidates=[candidate], text="Final answer from Gemini")
        else:
            # After tool calls exhausted, just return final text
            return DummyResponse(candidates=[], text="Final answer from Gemini")

    def generate_content_stream(self, model, contents, config):
        self.generate_content_stream_called += 1
        # Yield some dummy streamed chunks
        for i in range(3):
            yield pytypes.SimpleNamespace(text=f"stream chunk {i+1}")


class DummyClient:
    def __init__(self):
        self.models = DummyClientModels()


@pytest.fixture(autouse=True)
def patch_gemini_client(monkeypatch):
    # Patch the gemini.client.Client to our DummyClient
    monkeypatch.setattr(gemini.client, "Client", lambda api_key=None: DummyClient())
    # Patch get_function to a dummy function that returns a fixed string
    monkeypatch.setattr(gemini, "get_function", lambda name: lambda **kwargs: f"called {name} with {kwargs}")
    # Patch process_function_name to identity
    monkeypatch.setattr(gemini, "process_function_name", lambda name: name)


def test_gemini_model_query_basic_function_call():
    model = gemini.GeminiModel(api_key="dummy", model="dummy-model", temperature=0.5)

    # Prepare chat history with system, user, assistant messages
    chat_history = [
        {"role": "system", "content": "System instruction here."},
        {"role": "user", "content": "Hello, please search something."},
        {"role": "assistant", "content": "Sure, searching now."}
    ]

    # Provide a dummy function declaration for search_arxiv
    functions = [{
        "name": "search_arxiv",
        "description": "Search arxiv papers",
        "parameters": {
            "type": "object",
            "properties": {
                "query": {"type": "string", "description": "Search query"}
            },
            "required": ["query"]
        }
    }]

    # Call query with functions to trigger tool calling logic
    response = model.query(chat_history, functions=functions)

    # The dummy client returns "Final answer from Gemini" after function call
    assert "Final answer from Gemini" in response

    # The function call history should contain the search_arxiv call
    assert "search_arxiv" in model.func_call_history

    # The function call history length should be 1 (only one call)
    assert len(model.func_call_history) == 1


def test_gemini_model_query_max_search_limit():
    model = gemini.GeminiModel(api_key="dummy", model="dummy-model", temperature=0.5)

    # Prepare chat history with system and user messages
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Please search multiple times."}
    ]

    # Provide a dummy function declaration for search_arxiv
    functions = [{
        "name": "search_arxiv",
        "description": "Search arxiv papers",
        "parameters": {
            "type": "object",
            "properties": {
                "query": {"type": "string", "description": "Search query"}
            },
            "required": ["query"]
        }
    }]

    # Patch get_function to simulate search function returning dummy results
    def dummy_search_function(**kwargs):
        return "dummy search result"

    # Patch get_function to always return dummy_search_function
    gemini.get_function = lambda name: dummy_search_function

    # Patch process_function_name to identity
    gemini.process_function_name = lambda name: name

    # Manually set func_call_history to simulate already 3 search calls
    model.func_call_history = ["search_arxiv", "search_arxiv", "search_arxiv"]

    # Call query with functions to trigger tool calling logic and limit check
    response = model.query(chat_history, functions=functions)

    # The response should contain the warning about search function limit reached
    assert "[GEMINI WARNING]" in response
    assert "Search function limit" in response

    # The function call history should not grow beyond 3 search calls
    assert model.func_call_history.count("search_arxiv") == 3


def test_gemini_model_stream_yields_text_chunks():
    model = gemini.GeminiModel(api_key="dummy", model="dummy-model", temperature=0.5)

    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Stream test message."}
    ]

    # Collect streamed chunks
    chunks = list(model.stream(chat_history))

    # There should be 3 chunks as per dummy client
    assert len(chunks) == 3

    # Each chunk text should contain "stream chunk"
    for i, chunk in enumerate(chunks, 1):
        assert f"stream chunk {i}" == chunk


def test_create_gemini_tools_none_for_empty_functions():
    model = gemini.GeminiModel(api_key="dummy", model="dummy-model", temperature=0.5)
    # Empty functions list should return None
    assert model._create_gemini_tools([]) is None
    assert model._create_gemini_tools(None) is None


def test_adapt_history_for_gemini_formats_correctly():
    model = gemini.GeminiModel(api_key="dummy", model="dummy-model", temperature=0.5)

    chat_history = [
        {"role": "system", "content": "System message."},
        {"role": "user", "content": "User message."},
        {"role": "assistant", "content": "Assistant message."},
        {"role": "unknown", "content": "Should be ignored."},
        {"role": "user", "content": None},  # None content should be ignored
    ]

    system_instruction, prompt = model._adapt_history_for_gemini(chat_history)

    assert system_instruction == "System message."
    # prompt should contain user and assistant messages only
    roles = [msg['role'] for msg in prompt]
    assert roles == ['user', 'model']
    # parts text should match
    assert prompt[0]['parts'][0]['text'] == "User message."
    assert prompt[1]['parts'][0]['text'] == "Assistant message."


def test_query_returns_warning_if_max_tool_turns_reached(monkeypatch):
    model = gemini.GeminiModel(api_key="dummy", model="dummy-model", temperature=0.5)

    # Prepare chat history with system and user messages
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Please do many tool calls."}
    ]

    # Provide a dummy function declaration for a dummy tool
    functions = [{
        "name": "dummy_tool",
        "description": "Dummy tool",
        "parameters": {
            "type": "object",
            "properties": {},
            "required": []
        }
    }]

    # Patch get_function to simulate a tool that always triggers a function call
    def dummy_tool_function(**kwargs):
        return "dummy result"

    monkeypatch.setattr(gemini, "get_function", lambda name: dummy_tool_function)
    monkeypatch.setattr(gemini, "process_function_name", lambda name: name)

    # Patch the client models.generate_content to always return a function call to dummy_tool
    call_count = {"count": 0}

    def generate_content_side_effect(model_name, contents, config):
        call_count["count"] += 1
        if call_count["count"] <= gemini.GeminiModel.query.__defaults__[0]:
            func_call = DummyFunctionResponse(
                name="dummy_tool",
                args={}
            )
            part = DummyPart(function_call=func_call)
            content = DummyContent(parts=[part])
            candidate = DummyCandidate(content=content)
            return DummyResponse(candidates=[candidate], text="")
        else:
            return DummyResponse(candidates=[], text="Done")

    model.client.models.generate_content = generate_content_side_effect

    # Run query, expecting it to hit max tool turns and return warning
    result = model.query(chat_history, functions=functions)

    assert "[GEMINI WARNING]" in result
    assert "Max tool turns" in result or "Search function limit" in result

