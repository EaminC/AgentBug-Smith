        return DummyPart(text=f"Function response for {name}")


class DummyContentClass:
    def __init__(self, role=None, parts=None):
        self.role = role
        self.parts = parts or []


class DummyFunctionCallingConfig:
    def __init__(self, mode=None):
        self.mode = mode


class DummyToolConfig:
    def __init__(self, function_calling_config=None):
        self.function_calling_config = function_calling_config


class DummyGenerateContentConfig:
    def __init__(self, temperature=None, tools=None, system_instruction=None,
                 response_mime_type=None, tool_config=None):
        self.temperature = temperature
        self.tools = tools
        self.system_instruction = system_instruction
        self.response_mime_type = response_mime_type
        self.tool_config = tool_config


@pytest.fixture(autouse=True)
def patch_gemini(monkeypatch):
    # Patch the gemini_module.client.Client to return DummyClient
    # Patch types.Tool, types.FunctionDeclaration, types.Schema, types.Part, types.Content, types.ToolConfig, types.FunctionCallingConfig
    # to dummy classes/functions to avoid import errors or attribute errors

    # Patch client module
    monkeypatch.setattr(gemini_module, "client", pytypes.SimpleNamespace(Client=lambda api_key=None: DummyClient()))

    # Patch types module
    dummy_types = pytypes.SimpleNamespace(
        Tool=DummyTool,
        FunctionDeclaration=DummyFunctionDeclaration,
        Schema=DummySchema,
        Part=DummyPartClass,
        Content=DummyContentClass,
        ToolConfig=DummyToolConfig,
        FunctionCallingConfig=DummyFunctionCallingConfig,
        GenerateContentConfig=DummyGenerateContentConfig,
    )
    monkeypatch.setattr(gemini_module, "types", dummy_types)

    # Patch get_function to a dummy function that returns a lambda returning a string
    def dummy_get_function(name):
        def dummy_func(**kwargs):
            return f"called {name} with {kwargs}"
        return dummy_func

    monkeypatch.setattr(gemini_module, "get_function", dummy_get_function)

    # Patch process_function_name to identity function
    monkeypatch.setattr(gemini_module, "process_function_name", lambda x: x)


def test_adapt_history_for_gemini_format():
    model = gemini_module.GeminiModel(api_key="dummy", model="dummy-model")

    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Hello, how are you?"},
        {"role": "assistant", "content": "I am fine, thank you."},
        {"role": "user", "content": "Tell me a joke."},
    ]

    system_instruction, prompt = model._adapt_history_for_gemini(chat_history)

    assert system_instruction == "System instruction."
    assert isinstance(prompt, list)
    assert len(prompt) == 3
    assert prompt[0]["role"] == "user"
    assert prompt[0]["parts"][0]["text"] == "Hello, how are you?"
    assert prompt[1]["role"] == "model"
    assert prompt[1]["parts"][0]["text"] == "I am fine, thank you."
    assert prompt[2]["role"] == "user"
    assert prompt[2]["parts"][0]["text"] == "Tell me a joke."


def test_create_gemini_tools_none_and_nonempty():
    model = gemini_module.GeminiModel(api_key="dummy", model="dummy-model")

    # None input returns None
    assert model._create_gemini_tools(None) is None
    assert model._create_gemini_tools([]) is None

    # Non-empty input returns list with Tool
    functions = [
        {
            "name": "search_arxiv",
            "description": "Search arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                },
            },
        }
    ]

    tools = model._create_gemini_tools(functions)
    assert isinstance(tools, list)
    assert len(tools) == 1
    tool = tools[0]
    assert hasattr(tool, "function_declarations")
    assert len(tool.function_declarations) == 1
    decl = tool.function_declarations[0]
    assert decl.name == "search_arxiv"
    assert decl.description == "Search arxiv papers"
    assert hasattr(decl.parameters, "type")
    assert decl.parameters.type == "OBJECT"
    assert "query" in decl.parameters.properties


def test_query_returns_string_and_limits_tools():
    model = gemini_module.GeminiModel(api_key="dummy", model="dummy-model")

    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Please search something."},
    ]

    functions = [
        {
            "name": "search_arxiv",
            "description": "Search arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                },
            },
        }
    ]

    # The dummy client is designed to simulate one function call then final text
    response = model.query(chat_history, functions=functions)
    assert isinstance(response, str)
    assert "Final response text" in response or "[GEMINI WARNING]" in response or response != ""

    # Test that function call limit is respected
    # We simulate multiple calls by monkeypatching func_call_history manually
    model.func_call_history = ["search_arxiv"] * 4
    response2 = model.query(chat_history, functions=functions)
    assert "[GEMINI WARNING]" in response2


def test_gemini_model_stream():
    model = gemini_module.GeminiModel(api_key="dummy", model="dummy-model")

    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Stream test."},
    ]

    chunks = list(model.stream(chat_history))
    assert len(chunks) > 0
    for chunk in chunks:
        assert isinstance(chunk, str)
        assert chunk.startswith("streamed chunk")


