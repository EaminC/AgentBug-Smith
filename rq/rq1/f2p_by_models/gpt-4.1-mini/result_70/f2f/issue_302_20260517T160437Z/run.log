def test_adapt_history_for_gemini_format():
    model = gemini_module.GeminiModel(api_key="dummy_key", model=None)
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Hello!"},
        {"role": "assistant", "content": "Hi there!"},
        {"role": "user", "content": "How are you?"},
    ]
    system_instruction, prompt = model._adapt_history_for_gemini(chat_history)
    assert "System instruction." in system_instruction
    assert isinstance(prompt, list)
    assert all(isinstance(p, dict) for p in prompt)
    roles = {p["role"] for p in prompt}
    assert roles.issubset({"user", "model"})


