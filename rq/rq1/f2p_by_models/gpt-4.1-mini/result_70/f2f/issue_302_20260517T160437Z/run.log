            content = pytypes.SimpleNamespace(parts=[part])
            candidate = pytypes.SimpleNamespace(content=content)
            return pytypes.SimpleNamespace(candidates=[candidate], text=None)
        else:
            # Return a normal text response
            return pytypes.SimpleNamespace(candidates=[], text="Final response text")

    def generate_content_stream(self, model, contents, config):
