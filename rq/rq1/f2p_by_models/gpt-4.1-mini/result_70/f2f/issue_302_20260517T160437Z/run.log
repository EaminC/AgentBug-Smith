def test_gemini_model_init_properties():
    gm = gemini_module.GeminiModel(api_key="dummy_api_key", model="gemini-2.5-flash", temperature=0.5)
    assert gm.api_key is None  # api_key is not stored directly, only used for client init
    assert gm.model == "gemini-2.5-flash"
    assert gm.model_type == "Gemini"
    assert gm.temperature == 0.5
    assert hasattr(gm, "client")
    assert hasattr(gm.client, "models")
    assert gm.func_call_history == []


def test_adapt_history_for_gemini_format():
    gm = gemini_module.GeminiModel(api_key="dummy", model="gemini-2.5-flash")
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there!"},
        {"role": "user", "content": "How are you?"},
    ]
    system_instruction, prompt = gm._adapt_history_for_gemini(chat_history)
    assert system_instruction.strip() == "System instruction."
    assert isinstance(prompt, list)
    assert all(isinstance(p, dict) for p in prompt)
    roles = [p["role"] for p in prompt]
    assert roles == ["user", "model", "user"]
    parts_texts = [p["parts"][0]["text"] for p in prompt]
    assert parts_texts == ["Hello", "Hi there!", "How are you?"]


def test_create_gemini_tools_none_and_nonempty():
    gm = gemini_module.GeminiModel(api_key="dummy", model="gemini-2.5-flash")
    # None input
    tools_none = gm._create_gemini_tools(None)
    assert tools_none is None

    # Empty list input
    tools_empty = gm._create_gemini_tools([])
    assert tools_empty is None

    # Non-empty input
    functions = [
        {
            "name": "search_arxiv",
            "description": "Search Arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                },
            },
        }
    ]
    tools = gm._create_gemini_tools(functions)
    assert tools is not None
    assert isinstance(tools, list)
    assert isinstance(tools[0], gm.types.Tool)
    assert len(tools[0].function_declarations) == 1
    decl = tools[0].function_declarations[0]
    assert decl.name == "search_arxiv"
    assert decl.description == "Search Arxiv papers"
    assert isinstance(decl.parameters, gm.types.Schema)


def test_query_handles_no_functions_and_empty_history():
    gm = gemini_module.GeminiModel(api_key="dummy", model="gemini-2.5-flash")

    # Empty chat history and no functions
    response = gm.query([])
    assert isinstance(response, str)
    assert "Dummy response text" in response

    # Chat history with system and user, no functions
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Hello"},
    ]
    response = gm.query(chat_history)
    assert isinstance(response, str)
    assert "Dummy response text" in response


def test_query_returns_string_and_limits_tools():
    gm = gemini_module.GeminiModel(api_key="dummy", model="gemini-2.5-flash")

    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Please search for AI papers."},
    ]
    functions = [
        {
            "name": "search_arxiv",
            "description": "Search Arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                },
            },
        }
    ]

    # Patch get_function to a dummy function that returns a fixed string
    def dummy_search_arxiv(query):
        return f"Results for {query}"

    original_get_function = gemini_module.get_function
    gemini_module.get_function = lambda name: dummy_search_arxiv

    # Patch the client's generate_content to simulate function call and response
    class DummyFunctionCallPart:
        def __init__(self):
            self.function_call = DummyFunctionCall(name="search_arxiv", args={"query": "AI"})
            self.text = None

    class DummyCandidate:
