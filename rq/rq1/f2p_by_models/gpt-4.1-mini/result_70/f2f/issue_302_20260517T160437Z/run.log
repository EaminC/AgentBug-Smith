            self.system_instruction = system_instruction
            self.response_mime_type = response_mime_type
            self.tool_config = tool_config
    monkeypatch.setattr(gemini_module.types, "GenerateContentConfig", DummyGenerateContentConfig)


def test_adapt_history_for_gemini_format():
    model = gemini_module.GeminiModel(api_key="dummy", model="dummy-model")

    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Hello, Gemini!"},
        {"role": "assistant", "content": "Hello, human!"},
        {"role": "user", "content": "How are you?"},
    ]

    system_instruction, prompt = model._adapt_history_for_gemini(chat_history)

    assert system_instruction == "System instruction."
    assert isinstance(prompt, list)
    assert len(prompt) == 3
    assert prompt[0]["role"] == "user"
    assert prompt[0]["parts"][0]["text"] == "Hello, Gemini!"
    assert prompt[1]["role"] == "model"
    assert prompt[1]["parts"][0]["text"] == "Hello, human!"
    assert prompt[2]["role"] == "user"
    assert prompt[2]["parts"][0]["text"] == "How are you?"


def test_gemini_model_query_basic_function_call():
    model = gemini_module.GeminiModel(api_key="dummy", model="dummy-model")

    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Please search arxiv for test query."},
    ]

    # Provide a function definition for search_arxiv
    functions = [
        {
            "name": "search_arxiv",
            "description": "Search arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"}
                },
                "required": ["query"]
            }
        }
    ]

    # Patch get_function to a dummy function that returns a known value
    def dummy_search_arxiv(query):
        return f"Results for {query}"

    # Patch get_function to return dummy_search_arxiv for "search_arxiv"
    original_get_function = gemini_module.get_function
    gemini_module.get_function = lambda name: dummy_search_arxiv if name == "search_arxiv" else original_get_function(name)

    response = model.query(chat_history, functions=functions)

    # Restore original get_function
    gemini_module.get_function = original_get_function

    assert isinstance(response, str)
    assert "Final answer" in response or "Results for" in response


def test_gemini_model_query_function_call_limit():
    model = gemini_module.GeminiModel(api_key="dummy", model="dummy-model")

    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Please search arxiv multiple times."},
    ]

    functions = [
        {
            "name": "search_arxiv",
            "description": "Search arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"}
                },
                "required": ["query"]
            }
        }
    ]

    # Patch get_function to a dummy function that returns a known value
    def dummy_search_arxiv(query):
        return f"Results for {query}"

    original_get_function = gemini_module.get_function
    gemini_module.get_function = lambda name: dummy_search_arxiv if name == "search_arxiv" else original_get_function(name)

    # Patch DummyClientModels.generate_content to always return a function call to simulate infinite loop
    dummy_client_instance = model.client
    original_generate_content = dummy_client_instance.models.generate_content

    def generate_content_loop(model_name, contents, config):
        fn_call = DummyFunctionCall(
            name="search_arxiv",
            args={"query": "test query"}
        )
        part_with_fn = DummyPart(function_call=fn_call)
        content = DummyContent(parts=[part_with_fn])
        candidate = DummyCandidate(content=content)
        return DummyResponse(candidates=[candidate])

    dummy_client_instance.models.generate_content = generate_content_loop

    response = model.query(chat_history, functions=functions)

    dummy_client_instance.models.generate_content = original_generate_content
    gemini_module.get_function = original_get_function

    assert isinstance(response, str)
    assert "[GEMINI WARNING]" in response


def test_gemini_model_stream():
    model = gemini_module.GeminiModel(api_key="dummy", model="dummy-model")

    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Stream test."},
    ]

    chunks = list(model.stream(chat_history))

    assert len(chunks) == 3
    for i, chunk in enumerate(chunks, 1):
        assert f"chunk {i}" == chunk


def test_create_gemini_tools_none_and_nonempty():
    model = gemini_module.GeminiModel(api_key="dummy", model="dummy-model")

    # Empty functions list returns None
    tools_none = model._create_gemini_tools([])
    assert tools_none is None

    # Non-empty functions list returns a list with one Tool object
    functions = [
        {
            "name": "func1",
            "description": "desc",
            "parameters": {
                "type": "object",
                "properties": {
                    "param1": {"type": "string", "description": "desc param1"}
                },
                "required": ["param1"]
            }
        }
    ]

    tools = model._create_gemini_tools(functions)
    assert isinstance(tools, list)
    assert len(tools) == 1
    # The dummy Tool returns a list with one string "dummy_tool"
    assert tools[0] == "dummy_tool" or isinstance(tools[0], list) or hasattr(tools[0], "__iter__")


