def test_gemini_model_query_basic_function_call():
    # Initialize GeminiModel with dummy api_key and model
    model = gemini_module.GeminiModel(api_key="dummy_key", model="dummy-model", temperature=0.5)

    # Prepare chat history with system, user, assistant messages
    chat_history = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Please search for papers about AI."},
        {"role": "assistant", "content": "Sure, I will do that."}
    ]

    # Provide a dummy function in functions argument
    functions = [
        {
            "name": "search_arxiv",
            "description": "Search papers on arXiv",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"}
                },
                "required": ["query"]
            }
        }
    ]

    # Call query method, expecting it to handle function call and return final text
    response = model.query(chat_history, functions=functions)

    # The dummy client returns "Final response text" after processing function call
    assert isinstance(response, str)
    assert "Final response text" in response


def test_gemini_model_query_function_call_limit(monkeypatch):
    # Initialize GeminiModel with dummy api_key and model
    model = gemini_module.GeminiModel(api_key="dummy_key", model="dummy-model", temperature=0.5)

    # Prepare chat history with system and user messages
    chat_history = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Please search for papers about AI."}
    ]

    # Provide a dummy function in functions argument
    functions = [
        {
            "name": "search_arxiv",
            "description": "Search papers on arXiv",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"}
                },
                "required": ["query"]
            }
        }
    ]

    # Patch get_function to always return a dummy function that returns a string
    def dummy_search_function(query):
        return f"Results for {query}"

    monkeypatch.setattr(gemini_module, "get_function", lambda name: dummy_search_function)

    # Patch the client.models.generate_content to simulate repeated function calls exceeding limit
    call_count = {"count": 0}

    def generate_content_side_effect(model_name, contents, config):
        call_count["count"] += 1
        if call_count["count"] <= 5:
            # Always return a function call to search_arxiv
            func_call = DummyFunctionCall(name="search_arxiv", args={"query": "test"})
            part = DummyPart(function_call=func_call)
            content = DummyContent(parts=[part])
            candidate = DummyCandidate(content=content)
            return DummyResponse(candidates=[candidate], text="")
        else:
            # After limit, return normal text to stop loop
            content = DummyContent(parts=[])
            candidate = DummyCandidate(content=content)
            return DummyResponse(candidates=[candidate], text="Limit reached response")

    dummy_client = DummyClient()
    dummy_client.models.generate_content = generate_content_side_effect
    monkeypatch.setattr(gemini_module.client, "Client", lambda api_key=None: dummy_client)

    # Re-initialize model to use patched client
    model = gemini_module.GeminiModel(api_key="dummy_key", model="dummy-model", temperature=0.5)

    # Run query, expecting it to stop after search attempts limit and return warning message
    response = model.query(chat_history, functions=functions)

    assert isinstance(response, str)
    assert "[GEMINI WARNING]" in response or "Limit reached response" in response


def test_gemini_model_stream(monkeypatch):
    # Initialize GeminiModel with dummy api_key and model
    model = gemini_module.GeminiModel(api_key="dummy_key", model="dummy-model", temperature=0.5)

    # Prepare chat history with system and user messages
    chat_history = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Stream some data."}
    ]

    # Patch client.models.generate_content_stream to dummy generator
    dummy_client = DummyClient()
    monkeypatch.setattr(gemini_module.client, "Client", lambda api_key=None: dummy_client)

    # Re-initialize model to use patched client
    model = gemini_module.GeminiModel(api_key="dummy_key", model="dummy-model", temperature=0.5)

    # Collect streamed chunks
    chunks = list(model.stream(chat_history))

    assert len(chunks) == 3
    for i, chunk in enumerate(chunks, 1):
        assert f"stream chunk {i}" == chunk

