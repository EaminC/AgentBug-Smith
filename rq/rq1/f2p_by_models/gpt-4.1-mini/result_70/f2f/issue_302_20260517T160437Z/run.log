    # Setup model with dummy client returning a simple response without function calls
    dummy_response = DummyResponse(
        text="Hello from Gemini!",
        candidates=[DummyCandidate(content=DummyContent(parts=[DummyPart(text="Hello from Gemini!")]))]
    )
    dummy_client = DummyClient(responses=[dummy_response])
    monkeypatch.setattr(gemini.client, "Client", lambda api_key=None: dummy_client)
    model = gemini.GeminiModel(api_key="dummy", model="test-model")
    # Patch the client instance in model to dummy_client
    model.client = dummy_client

    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Say hello."},
    ]
    result = model.query(chat_history)
    assert isinstance(result, str)
    assert "Hello from Gemini" in result


def test_query_with_function_call_and_limit(monkeypatch):
    # Prepare function call parts and responses to simulate function calling and limit
    # First response returns a function call to "search_arxiv"
    func_call = DummyFunctionResponse(name="search_arxiv", args={"query": "test"})
    part_with_func_call = DummyPart(function_call=func_call)
    content_with_func_call = DummyContent(parts=[part_with_func_call])
    candidate_with_func_call = DummyCandidate(content=content_with_func_call)
    response_with_func_call = DummyResponse(text="", candidates=[candidate_with_func_call])

    # Second response returns no function call, just text
    response_final = DummyResponse(text="Final response after function call", candidates=[])

    dummy_client = DummyClient(responses=[response_with_func_call, response_final])
    monkeypatch.setattr(gemini.client, "Client", lambda api_key=None: dummy_client)
    model = gemini.GeminiModel(api_key="dummy", model="test-model")
    model.client = dummy_client

    # Patch get_function to a dummy function that returns a fixed result
    monkeypatch.setattr(gemini, "get_function", lambda name: lambda **kwargs: f"result_of_{name}")

    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Search something."},
    ]

    # Run query and expect it to process function call and then final response
    result = model.query(chat_history, functions=[{"name": "search_arxiv", "description": "Search arxiv", "parameters": {"type": "object", "properties": {"query": {"type": "string", "description": "search query"}}}}])
    assert isinstance(result, str)
    assert "Final response" in result or "result_of_search_arxiv" not in result  # result should be final text, not function call output


def test_query_function_call_limit(monkeypatch):
    # Prepare a sequence of responses all with function calls to a search function to trigger limit
    func_call = DummyFunctionResponse(name="search_arxiv", args={"query": "test"})
    part_with_func_call = DummyPart(function_call=func_call)
    content_with_func_call = DummyContent(parts=[part_with_func_call])
    candidate_with_func_call = DummyCandidate(content=content_with_func_call)
    response_with_func_call = DummyResponse(text="", candidates=[candidate_with_func_call])

    # Provide enough responses to exceed SEARCH_ATTEMPT_LIMIT (3)
    responses = [response_with_func_call] * 5

    dummy_client = DummyClient(responses=responses)
    monkeypatch.setattr(gemini.client, "Client", lambda api_key=None: dummy_client)
    model = gemini.GeminiModel(api_key="dummy", model="test-model")
    model.client = dummy_client

    monkeypatch.setattr(gemini, "get_function", lambda name: lambda **kwargs: f"result_of_{name}")

    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Search something repeatedly."},
    ]

    result = model.query(chat_history, functions=[{"name": "search_arxiv", "description": "Search arxiv", "parameters": {"type": "object", "properties": {"query": {"type": "string", "description": "search query"}}}}])
    assert "[GEMINI WARNING]" in result
    assert "Search function limit" in result


def test_stream_yields_chunks(monkeypatch):
    dummy_client = DummyClient()
    monkeypatch.setattr(gemini.client, "Client", lambda api_key=None: dummy_client)
    model = gemini.GeminiModel(api_key="dummy", model="test-model")
    model.client = dummy_client

    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Stream test."},
    ]

    chunks = list(model.stream(chat_history))
    assert len(chunks) == 3
    for i, chunk in enumerate(chunks, 1):
        assert f"chunk {i}" == chunk

