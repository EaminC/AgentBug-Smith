[32mimport builtins
import types as pytypes
import pytest
from unittest.mock import patch, MagicMock

from mle.model import gemini


class DummyFunctionResponse:
    def __init__(self, name, response):
        self.name = name
        self.response = response


class DummyPart:
    def __init__(self, function_call=None, text=""):
        self.function_call = function_call
        self.text = text


class DummyFunctionCall:
    def __init__(self, name, args):
        self.name = name
        self.args = args


class DummyContent:
    def __init__(self, parts=None, role=None):
        self.parts = parts or []
        self.role = role


class DummyCandidate:
    def __init__(self, content):
        self.content = content


class DummyResponse:
    def __init__(self, candidates=None, text=""):
        self.candidates = candidates or []
        self.text = text


class DummyClientModels:
    def __init__(self):
        self.generate_content_called = 0
        self.generate_content_stream_called = 0

    def generate_content(self, model, contents, config):
        self.generate_content_called += 1
        # Simulate a function call on first call, then normal text response
        if self.generate_content_called == 1:
            # Return a response with a function call part
            fn_call = DummyFunctionCall(name="search_arxiv", args={"query": "test"})
            part_with_fn = DummyPart(function_call=fn_call)
            content = DummyContent(parts=[part_with_fn])
            candidate = DummyCandidate(content=content)
            return DummyResponse(candidates=[candidate], text="")
        else:
            # Return a normal text response without function call
            content = DummyContent(parts=[])
            candidate = DummyCandidate(content=content)
            return DummyResponse(candidates=[candidate], text="Final response text")

    def generate_content_stream(self, model, contents, config):
        self.generate_content_stream_called += 1
        # Yield a few dummy chunks
        for i in range(3):
            yield pytypes.SimpleNamespace(text=f"chunk {i+1}")


class DummyClient:
    def __init__(self):
        self.models = DummyClientModels()


@pytest.fixture(autouse=True)
def patch_google_genai(monkeypatch):
    # Patch the google.genai.client.Client to our DummyClient
    monkeypatch.setattr(gemini.client, "Client", lambda api_key=None: DummyClient())
    # Patch types.FunctionDeclaration, Schema, Tool, Part, Content, GenerateContentConfig, ToolConfig, FunctionCallingConfig
    monkeypatch.setattr(gemini.types, "FunctionDeclaration", lambda **kwargs: kwargs)
    monkeypatch.setattr(gemini.types, "Schema", lambda **kwargs: kwargs)
    monkeypatch.setattr(gemini.types, "Tool", lambda function_declarations=None: pytypes.SimpleNamespace(function_declarations=function_declarations))
    monkeypatch.setattr(gemini.types, "Part", pytypes.SimpleNamespace(
        from_function_response=lambda name, response: DummyPart(function_call=None, text=f"Function response for {name}")
    ))
    monkeypatch.setattr(gemini.types, "Content", lambda role=None, parts=None: DummyContent(parts=parts, role=role))
    monkeypatch.setattr(gemini.types, "GenerateContentConfig", lambda **kwargs: kwargs)
    monkeypatch.setattr(gemini.types, "ToolConfig", lambda **kwargs: kwargs)
    monkeypatch.setattr(gemini.types, "FunctionCallingConfig", lambda **kwargs: kwargs)


def test_adapt_history_for_gemini_and_query_basic():
    model = gemini.GeminiModel(api_key="dummy_key", model="dummy-model", temperature=0.5)

    chat_history = [
        {"role": "system", "content": "System instruction"},
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there!"},
    ]

    system_instruction, prompt = model._adapt_history_for_gemini(chat_history)
    assert system_instruction == "System instruction"
    assert isinstance(prompt, list)
    assert len(prompt) == 2
    assert prompt[0]["role"] == "user"
    assert prompt[0]["parts"][0]["text"] == "Hello"
    assert prompt[1]["role"] == "model"
    assert prompt[1]["parts"][0]["text"] == "Hi there!"

    # Test query with no functions, should return final response text
    response = model.query(chat_history)
    assert isinstance(response, str)
    assert "Final response text" in response


def test_create_gemini_tools_and_query_with_function_call():
    model = gemini.GeminiModel(api_key="dummy_key", model="dummy-model", temperature=0.5)

    # Provide a dummy function declaration
    functions = [
        {
            "name": "search_arxiv",
            "description": "Search Arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                },
            },
        }
    ]

    tools = model._create_gemini_tools(functions)
    assert tools is not None
    assert hasattr(tools[0], "function_declarations")
    assert len(tools[0].function_declarations) == 1
    decl = tools[0].function_declarations[0]
    assert decl["name"] == "search_arxiv"
    assert "parameters" in decl

    # Prepare chat history that triggers function call
    chat_history = [
        {"role": "system", "content": "System instruction"},
        {"role": "user", "content": "Find papers about AI"},
    ]

    # Patch get_function to a dummy function that returns a known string
    def dummy_search_arxiv(query):
        return f"Results for query: {query}"

    original_get_function = gemini.get_function
    gemini.get_function = lambda name: dummy_search_arxiv if name == "search_arxiv" else lambda **kwargs: "unknown"

    try:
        response = model.query(chat_history, functions=functions)
        assert isinstance(response, str)
        # The response should be the final response text or a warning if search limit reached
        assert response != ""
        # The function call history should contain the function name
        assert "search_arxiv" in model.func_call_history
    finally:
        gemini.get_function = original_get_function


def test_query_max_search_attempts_limit():
    model = gemini.GeminiModel(api_key="dummy_key", model="dummy-model", temperature=0.5)

    functions = [
        {
            "name": "search_arxiv",
            "description": "Search Arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                },
            },
        }
    ]

    chat_history = [
        {"role": "system", "content": "System instruction"},
        {"role": "user", "content": "Find papers about AI"},
    ]

    # Patch get_function to a dummy function that returns a known string
    def dummy_search_arxiv(query):
        return f"Results for query: {query}"

    original_get_function = gemini.get_function
    gemini.get_function = lambda name: dummy_search_arxiv if name == "search_arxiv" else lambda **kwargs: "unknown"

    # Patch DummyClientModels.generate_content to always return a function call to "search_arxiv"
    dummy_client_models = DummyClientModels()
    dummy_client_models.generate_content = lambda model, contents, config: DummyResponse(
        candidates=[DummyCandidate(content=DummyContent(parts=[DummyPart(function_call=DummyFunctionCall(name="search_arxiv", args={"query": "test"}) )]))],
        text=""
    )
    dummy_client_models.generate_content_called = 0

    dummy_client = DummyClient()
    dummy_client.models = dummy_client_models

    # Patch the client.Client to return our dummy client with overridden generate_content
    with patch.object(gemini.client, "Client", return_value=dummy_client):
        model.client = dummy_client
        # Manually set func_call_history to simulate 3 previous search calls
        model.func_call_history = ["search_arxiv", "search_arxiv", "search_arxiv"]
        result = model.query(chat_history, functions=functions)
        # It should print a warning and break the loop
        assert "[GEMINI WARNING]" in result

    gemini.get_function = original_get_function


def test_stream_yields_chunks():
    model = gemini.GeminiModel(api_key="dummy_key", model="dummy-model", temperature=0.5)

    chat_history = [
        {"role": "system", "content": "System instruction"},
        {"role": "user", "content": "Hello"},
    ]

    chunks = list(model.stream(chat_history))
    assert len(chunks) == 3
    for i, chunk in enumerate(chunks, 1):
        assert chunk == f"chunk {i}"[0m
