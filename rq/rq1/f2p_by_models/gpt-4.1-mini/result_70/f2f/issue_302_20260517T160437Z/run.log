class DummyTypesContent:
    def __init__(self, role=None, parts=None):
        self.role = role
        self.parts = parts or []

class DummyFunctionCall:
    def __init__(self, name=None, args=None):
        self.name = name
        self.args = args or {}

class DummyFunctionResponse:
    def __init__(self, name=None, response=None):
        self.name = name
        self.response = response

class DummyCandidate:
    def __init__(self, content=None, text=None):
        self.content = content
        self.text = text

class DummyResponse:
    def __init__(self, candidates=None, text=None):
        self.candidates = candidates or []
        self.text = text

class DummyChatHandler:
    def __init__(self, history):
        self.history = history
        self.send_message_called = 0
        self.last_message = None

    def send_message(self, content, generation_config=None, stream=False):
        self.send_message_called += 1
        self.last_message = content
        # Return dummy response
        return DummyResponse(text="dummy response")

class DummyModel:
    def __init__(self, model_name):
        self.model_name = model_name

    def start_chat(self, history):
