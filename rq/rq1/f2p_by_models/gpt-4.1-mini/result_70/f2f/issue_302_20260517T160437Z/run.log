[32mimport builtins
import types as pytypes
import pytest

from mle.model import gemini


class DummyFunctionCall:
    def __init__(self, name, args):
        self.name = name
        self.args = args


class DummyPart:
    def __init__(self, function_call=None, text=""):
        self.function_call = function_call
        self.text = text


class DummyContent:
    def __init__(self, parts=None, role=None):
        self.parts = parts or []
        self.role = role


class DummyCandidate:
    def __init__(self, content=None):
        self.content = content


class DummyResponse:
    def __init__(self, text="", candidates=None):
        self.text = text
        self.candidates = candidates or []


class DummyClientModels:
    def __init__(self):
        self.generate_content_calls = []
        self.generate_content_stream_called = False

    def generate_content(self, model, contents, config):
        self.generate_content_calls.append((model, contents, config))
        # Simulate a function call on first call, then normal text response
        # We simulate a function call only once, then no function call.
        if not hasattr(self, "called_once"):
            self.called_once = True
            # Create a dummy function call part
            fn_call = DummyFunctionCall(name="search_arxiv", args={"query": "test"})
            part = DummyPart(function_call=fn_call)
            content = DummyContent(parts=[part])
            candidate = DummyCandidate(content=content)
            return DummyResponse(candidates=[candidate])
        else:
            # No function call, just text response
            return DummyResponse(text="Final response text")

    def generate_content_stream(self, model, contents, config):
        self.generate_content_stream_called = True
        # Yield dummy chunks with text attribute
        class DummyChunk:
            def __init__(self, text):
                self.text = text

        yield DummyChunk("streamed chunk 1")
        yield DummyChunk("streamed chunk 2")


class DummyClient:
    def __init__(self):
        self.models = DummyClientModels()


def test_adapt_history_for_gemini_and_query(monkeypatch):
    # Patch the client.Client to return our dummy client
    monkeypatch.setattr(gemini.client, "Client", lambda api_key=None: DummyClient())

    # Create GeminiModel instance with dummy api_key and model
    model = gemini.GeminiModel(api_key="dummy_key", model="dummy-model")

    # Prepare chat history with system, user, assistant messages
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Hello, how are you?"},
        {"role": "assistant", "content": "I am fine, thanks!"},
    ]

    # Test _adapt_history_for_gemini returns expected system and prompt
    system_instruction, prompt = model._adapt_history_for_gemini(chat_history)
    assert system_instruction == "System instruction."
    assert isinstance(prompt, list)
    assert len(prompt) == 2
    assert prompt[0]["role"] == "user"
    assert prompt[0]["parts"][0]["text"] == "Hello, how are you?"
    assert prompt[1]["role"] == "model"
    assert prompt[1]["parts"][0]["text"] == "I am fine, thanks!"

    # Test _create_gemini_tools with empty and with one function
    assert model._create_gemini_tools([]) is None
    functions = [
        {
            "name": "search_arxiv",
            "description": "Search arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                },
            },
        }
    ]
    tools = model._create_gemini_tools(functions)
    assert tools is not None
    assert isinstance(tools, list)
    assert hasattr(tools[0], "function_declarations")

    # Prepare chat history with a function call expected
    chat_history_with_func = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Search something."},
    ]

    # Patch get_function to a dummy function that returns a known value
    monkeypatch.setattr(gemini, "get_function", lambda name: lambda **kwargs: f"result for {name}")

    # Patch process_function_name to identity function
    monkeypatch.setattr(gemini, "process_function_name", lambda name: name)

    # Run query and check that it returns the final response text
    response = model.query(chat_history_with_func, functions=functions)
    assert isinstance(response, str)
    # Because dummy client returns "Final response text" after function call, response should contain that
    assert "Final response text" in response or response.startswith("[GEMINI WARNING]")

    # Test that func_call_history contains the function call name
    assert "search_arxiv" in model.func_call_history

    # Test stream method yields text chunks
    stream_chunks = list(model.stream(chat_history_with_func))
    assert len(stream_chunks) == 2
    assert all(isinstance(chunk, str) for chunk in stream_chunks)
    assert stream_chunks[0] == "streamed chunk 1"
    assert stream_chunks[1] == "streamed chunk 2"[0m
