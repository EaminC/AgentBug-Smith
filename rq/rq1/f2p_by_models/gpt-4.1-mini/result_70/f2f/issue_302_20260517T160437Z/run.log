def test_gemini_model_init_properties():
    api_key = "dummy_api_key"
    model_name = "gemini-2.5-flash"
    temperature = 0.5

    gm = gemini_module.GeminiModel(api_key=api_key, model=model_name, temperature=temperature)
    assert gm.model == model_name
    assert gm.temperature == temperature
    assert gm.model_type == "Gemini"
    assert hasattr(gm, "client")
    assert hasattr(gm.client, "models")
    assert gm.func_call_history == []


def test_adapt_history_for_gemini_format():
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there!"},
        {"role": "user", "content": "How are you?"},
        {"role": "assistant", "content": "I'm fine."},
    ]

    system_instruction, prompt = gemini_module.GeminiModel._adapt_history_for_gemini(gemini_module.GeminiModel, chat_history)
    assert "System instruction." in system_instruction
    assert isinstance(prompt, list)
    # Check prompt roles and parts structure
    for msg in prompt:
        assert "role" in msg
        assert "parts" in msg
        assert isinstance(msg["parts"], list)
        for part in msg["parts"]:
            assert "text" in part


def test_create_gemini_tools_none_and_nonempty():
    gm = gemini_module.GeminiModel(api_key="dummy", model="gemini-2.5-flash")

    # Test None input
    tools_none = gm._create_gemini_tools(None)
    assert tools_none is None

    # Test empty list input
    tools_empty = gm._create_gemini_tools([])
    assert tools_empty is None

    # Test non-empty functions list
    functions = [
        {
            "name": "search_arxiv",
            "description": "Search Arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                },
            },
        }
    ]
    tools = gm._create_gemini_tools(functions)
    assert isinstance(tools, list)
    assert len(tools) == 1
    tool = tools[0]
    assert hasattr(tool, "function_declarations")
    assert len(tool.function_declarations) == 1
    decl = tool.function_declarations[0]
    assert decl.name == "search_arxiv"
    assert decl.description == "Search Arxiv papers"
    assert hasattr(decl.parameters, "properties")
    assert "query" in decl.parameters.properties


def test_query_handles_no_functions_and_empty_history():
    gm = gemini_module.GeminiModel(api_key="dummy", model="gemini-2.5-flash")

    # Empty chat history, no functions
    response = gm.query([])
    assert isinstance(response, str)
    assert "final response" in response or response.startswith("[GEMINI WARNING]") or response != ""

    # Chat history with no functions argument
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Hello"},
    ]
    response2 = gm.query(chat_history)
    assert isinstance(response2, str)
    assert response2 != ""


def test_query_returns_string_and_limits_tools():
    gm = gemini_module.GeminiModel(api_key="dummy", model="gemini-2.5-flash")

    # Provide a chat history and functions to trigger function calls
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Please search for AI papers."},
    ]
    functions = [
        {
            "name": "search_arxiv",
            "description": "Search Arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                },
            },
        }
    ]

    # Patch get_function to a dummy function that returns a fixed string
    def dummy_search_arxiv(query):
        return f"Results for {query}"

    original_get_function = gemini_module.get_function
    gemini_module.get_function = lambda name: dummy_search_arxiv

    try:
        response = gm.query(chat_history, functions=functions)
        assert isinstance(response, str)
        # The response should be the final text or a warning string
        assert response != ""
    finally:
        gemini_module.get_function = original_get_function


