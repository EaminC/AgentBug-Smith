def test_gemini_model_init_properties():
    api_key = "dummy_api_key"
    model_name = "dummy-model-1"
    temperature = 0.5
    model = gemini_module.GeminiModel(api_key=api_key, model=model_name, temperature=temperature)
    assert model.api_key is None or True  # no api_key attribute stored, but no error
    assert model.model == model_name or model.model == 'gemini-2.5-flash'
    assert model.temperature == temperature
    assert hasattr(model, "client")
    assert hasattr(model, "func_call_history")
    assert isinstance(model.func_call_history, list)


def test_adapt_history_for_gemini_format():
    model = gemini_module.GeminiModel(api_key="key", model=None)
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there!"},
        {"role": "user", "content": "How are you?"},
    ]
    system_instruction, prompt = model._adapt_history_for_gemini(chat_history)
    assert "System instruction." in system_instruction
    assert isinstance(prompt, list)
    assert all(isinstance(p, dict) for p in prompt)
    roles = [p["role"] for p in prompt]
    assert roles == ["user", "model", "user"]
    parts_texts = [p["parts"][0]["text"] for p in prompt]
    assert parts_texts == ["Hello", "Hi there!", "How are you?"]


def test_create_gemini_tools_none_and_nonempty():
    model = gemini_module.GeminiModel(api_key="key", model=None)
    # None input returns None
    assert model._create_gemini_tools(None) is None
    # Empty list returns None
    assert model._create_gemini_tools([]) is None
    # Non-empty list returns list of Tool objects
    functions = [
        {
            "name": "func1",
            "description": "desc1",
            "parameters": {
                "type": "object",
                "properties": {
                    "param1": {"type": "string", "description": "desc param1"},
                    "param2": {"type": "integer", "description": "desc param2"},
                },
            },
        }
    ]
    tools = model._create_gemini_tools(functions)
    assert isinstance(tools, list)
    assert len(tools) == 1
    tool = tools[0]
    assert hasattr(tool, "function_declarations")
    decl = tool.function_declarations[0]
    assert decl.name == "func1"
    assert decl.description == "desc1"
    assert isinstance(decl.parameters, pytypes.SimpleNamespace) or hasattr(decl.parameters, "type")


def test_query_handles_no_functions_and_empty_history():
    model = gemini_module.GeminiModel(api_key="key", model=None)
    # Empty chat history, no functions
    response = model.query([])
    assert isinstance(response, str)
    assert response != ""
    # Non-empty chat history, no functions
    chat_history = [
        {"role": "user", "content": "Hello world!"},
    ]
    response = model.query(chat_history)
    assert isinstance(response, str)
    assert "Hello world" in response or response != ""


def test_query_returns_string_and_limits_tools(monkeypatch):
    model = gemini_module.GeminiModel(api_key="key", model=None)

    # Patch get_function to a dummy function that returns a fixed string
    def dummy_function(**kwargs):
        return "dummy result"

    monkeypatch.setattr(gemini_module, "get_function", lambda name: dummy_function)

    # Prepare chat history with a function call simulated in the response
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Call function please."},
    ]

    # Patch client.models.generate_content to simulate function calls and responses
    call_count = {"count": 0}

    def fake_generate_content(model_name, contents, config):
        call_count["count"] += 1
        # On first calls, simulate function_call in response
        if call_count["count"] <= 3:
            func_call = DummyFunctionCall(name="search_arxiv", args={"query": "test"})
            part = DummyTypesPart(function_call=func_call)
            content = DummyTypesContent(parts=[part])
            candidate = DummyCandidate(content=content, text="")
            return DummyResponse(candidates=[candidate], text="")
        else:
            # No function call, return final text
            return DummyResponse(candidates=[], text="Final response text")

    monkeypatch.setattr(model.client.models, "generate_content", fake_generate_content)

    # Run query, expecting it to call dummy_function and eventually return final text
    result = model.query(chat_history, functions=[{"name": "search_arxiv", "description": "desc", "parameters": {"type": "object", "properties": {"query": {"type": "string"}}}}])
    assert isinstance(result, str)
    assert "Final response text" in result or "[GEMINI WARNING]" in result


def test_gemini_model_stream():
    model = gemini_module.GeminiModel(api_key="key", model=None)
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Stream test."},
    ]

    # The stream method yields texts from the dummy response stream
    chunks = list(model.stream(chat_history))
    assert isinstance(chunks, list)
    assert all(isinstance(chunk, str) for chunk in chunks)
    assert len(chunks) > 0
    assert "stream chunk" in chunks[0]  # check dummy stream content pattern

