def test_adapt_history_for_gemini_format():
    model = gemini_module.GeminiModel(api_key="dummy_key", model="dummy_model")
    chat_history = [
        {"role": "system", "content": "system instruction"},
        {"role": "user", "content": "hello"},
        {"role": "assistant", "content": "hi there"},
        {"role": "user", "content": "how are you?"},
        {"role": "system", "content": "another system line"},
    ]
    system_instruction, prompt = model._adapt_history_for_gemini(chat_history)
    assert "system instruction" in system_instruction
    assert "another system line" in system_instruction
    assert isinstance(prompt, list)
    assert all(isinstance(p, dict) for p in prompt)
    roles = [p["role"] for p in prompt]
    assert "user" in roles
    assert "model" in roles
    # The prompt parts should have 'parts' key with list of dicts with 'text'
    for p in prompt:
        assert "parts" in p
        assert isinstance(p["parts"], list)
        for part in p["parts"]:
            assert "text" in part


def test_create_gemini_tools_none_and_nonempty():
    model = gemini_module.GeminiModel(api_key="dummy_key", model="dummy_model")
    # None or empty list returns None
    assert model._create_gemini_tools(None) is None
    assert model._create_gemini_tools([]) is None

    # Non-empty functions list returns list of Tool instances
    functions = [
        {
            "name": "func1",
            "description": "desc1",
            "parameters": {
                "type": "object",
                "properties": {
                    "param1": {"type": "string", "description": "desc param1"},
                    "param2": {"type": "integer", "description": "desc param2"},
                }
            }
        }
    ]
    tools = model._create_gemini_tools(functions)
    assert isinstance(tools, list)
    assert len(tools) == 1
    tool = tools[0]
    assert hasattr(tool, "function_declarations")
    decl = tool.function_declarations[0]
    assert decl.name == "func1"
    assert decl.description == "desc1"
    assert hasattr(decl.parameters, "properties")
    assert "param1" in decl.parameters.properties
    assert "param2" in decl.parameters.properties


def test_query_returns_string_and_limits_tools():
    model = gemini_module.GeminiModel(api_key="dummy_key", model="dummy_model")

    # Prepare chat history with system and user messages
    chat_history = [
        {"role": "system", "content": "system instruction"},
        {"role": "user", "content": "please search"},
    ]

    # Provide functions that include a search function to trigger function call logic
    functions = [
        {
            "name": "search_arxiv",
            "description": "Search Arxiv",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "search query"}
                }
            }
        }
    ]

    # Call query and check it returns a string
    response = model.query(chat_history, functions=functions)
    assert isinstance(response, str)
    # The dummy_get_function returns a string containing function name
    assert "dummy result for search_arxiv" in response or "final response text" in response or "[GEMINI WARNING]" in response

    # Test that function call history limits search attempts
    # Manually set func_call_history to exceed limit and call query again
    model.func_call_history = ["search_arxiv"] * (len(SEARCH_FUNCTIONS) + 1)
    response2 = model.query(chat_history, functions=functions)
    assert isinstance(response2, str)
    assert "[GEMINI WARNING]" in response2


def test_query_handles_no_functions_and_empty_history():
    model = gemini_module.GeminiModel(api_key="dummy_key", model="dummy_model")

    # Empty chat history and no functions
    chat_history = []
    response = model.query(chat_history)
    assert isinstance(response, str)
    assert response != ""


def test_gemini_model_stream():
    model = gemini_module.GeminiModel(api_key="dummy_key", model="dummy_model")

    chat_history = [
        {"role": "system", "content": "system instruction"},
        {"role": "user", "content": "stream test"},
    ]

    # Collect streamed chunks
    chunks = list(model.stream(chat_history))
    assert len(chunks) > 0
    for chunk in chunks:
        assert isinstance(chunk, str)
        assert chunk.startswith("stream chunk")


# Additional test to verify that the model_type and temperature are set correctly
def test_gemini_model_init_properties():
    model = gemini_module.GeminiModel(api_key="dummy_key", model=None, temperature=0.5)
    assert model.model_type == "Gemini"
    assert model.temperature == 0.5
    assert model.model == "gemini-2.5-flash"  # default model when None passed
    # The client attribute should be DummyClient instance
    assert hasattr(model, "client")
    assert hasattr(model.client, "models")
    assert hasattr(model.client.models, "generate_content")
    assert hasattr(model.client.models, "generate_content_stream")[0m
