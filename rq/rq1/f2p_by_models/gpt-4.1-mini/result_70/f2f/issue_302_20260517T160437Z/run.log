def test_gemini_model_init_properties():
    api_key = "test_api_key"
    model_name = "test-model-1"
    temperature = 0.5

    gemini = gemini_module.GeminiModel(api_key=api_key, model=model_name, temperature=temperature)

    assert gemini.api_key is None or True  # api_key is not stored directly, but no error
    assert gemini.model == model_name
    assert gemini.temperature == temperature
    assert gemini.model_type == "Gemini"
    assert hasattr(gemini, "client")
    assert hasattr(gemini.client, "models")


def test_adapt_history_for_gemini_format():
    gemini = gemini_module.GeminiModel(api_key="key", model=None)

    chat_history = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Hello!"},
        {"role": "assistant", "content": "Hi, how can I help?"},
        {"role": "user", "content": "Tell me a joke."},
    ]

    system_instruction, prompt = gemini._adapt_history_for_gemini(chat_history)

    assert "helpful assistant" in system_instruction
    assert isinstance(prompt, list)
    assert all(isinstance(p, dict) for p in prompt)
    roles = [p["role"] for p in prompt]
    assert roles == ["user", "model", "user"]
    parts_texts = [p["parts"][0]["text"] for p in prompt]
    assert parts_texts == ["Hello!", "Hi, how can I help?", "Tell me a joke."]


def test_create_gemini_tools_none_and_nonempty():
    gemini = gemini_module.GeminiModel(api_key="key", model=None)

    # None input returns None
    assert gemini._create_gemini_tools(None) is None
    assert gemini._create_gemini_tools([]) is None

    # Non-empty functions list returns a list with one Tool
    functions = [
        {
            "name": "func1",
            "description": "desc1",
            "parameters": {
                "type": "object",
                "properties": {
                    "param1": {"type": "string", "description": "desc param1"},
                    "param2": {"type": "integer", "description": "desc param2"},
                },
            },
        }
    ]

    tools = gemini._create_gemini_tools(functions)
    assert isinstance(tools, list)
    assert len(tools) == 1
    tool = tools[0]
    assert hasattr(tool, "function_declarations")
    decl = tool.function_declarations[0]
    assert decl.name == "func1"
    assert decl.description == "desc1"
    assert isinstance(decl.parameters, DummyTypesSchema)
    assert "param1" in decl.parameters.properties
    assert "param2" in decl.parameters.properties


def test_query_handles_no_functions_and_empty_history(monkeypatch):
    gemini = gemini_module.GeminiModel(api_key="key", model=None)

    # Patch the client's generate_content to return a fixed text
    def dummy_generate_content(model, contents, config):
        return DummyResponse(text="response text")

    monkeypatch.setattr(gemini.client.models, "generate_content", dummy_generate_content)

    # Empty chat history and no functions
    response = gemini.query([], functions=None)
    assert isinstance(response, str)
