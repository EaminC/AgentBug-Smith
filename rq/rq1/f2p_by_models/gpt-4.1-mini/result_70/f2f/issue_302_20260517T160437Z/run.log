    assert prompt[1]["role"] == "model"
    assert prompt[1]["parts"][0]["text"] == "Hi there!"


def test_create_gemini_tools_none():
    model = gemini.GeminiModel(api_key="dummy", model="dummy-model")
    tools = model._create_gemini_tools(None)
    assert tools is None
    tools = model._create_gemini_tools([])
    assert tools is None


def test_create_gemini_tools_basic():
    model = gemini.GeminiModel(api_key="dummy", model="dummy-model")
    functions = [
        {
            "name": "search_arxiv",
            "description": "Search arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                },
            },
        }
    ]
    tools = model._create_gemini_tools(functions)
    assert tools is not None
    # tools is a list of one Tool object
    assert isinstance(tools, list)
    assert len(tools) == 1
    tool = tools[0]
    assert hasattr(tool, "function_declarations")
    decl = tool.function_declarations[0]
    assert decl.name == "search_arxiv"
    assert decl.description == "Search arxiv papers"


def test_query_simple_response():
    model = gemini.GeminiModel(api_key="dummy", model="dummy-model")
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Hello"},
    ]
    response = model.query(chat_history)
    assert isinstance(response, str)
    assert response == "final response"


def test_query_with_function_call(monkeypatch):
    model = gemini.GeminiModel(api_key="dummy", model="dummy-model")
    # Patch get_function to a dummy function that returns a known value
    monkeypatch.setattr(gemini, "get_function", lambda name: lambda **kwargs: f"result for {name}")

    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "trigger function"},
    ]
    response = model.query(chat_history, functions=[
        {
            "name": "search_arxiv",
            "description": "Search arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                },
            },
        }
    ])
    # The response should be a string (final_response_content)
    assert isinstance(response, str)
    # Because the dummy function returns "result for search_arxiv"
    assert "result for search_arxiv" in response or response == "" or response.startswith("[GEMINI WARNING]") or response == "final response"


def test_query_function_call_limit(monkeypatch):
    model = gemini.GeminiModel(api_key="dummy", model="dummy-model")
    monkeypatch.setattr(gemini, "get_function", lambda name: lambda **kwargs: f"result for {name}")

    # Compose chat history that triggers function call repeatedly
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "trigger function"},
    ]

    # Manually fill func_call_history to simulate many search calls
    model.func_call_history = SEARCH_FUNCTIONS * 4  # more than SEARCH_ATTEMPT_LIMIT

    response = model.query(chat_history, functions=[
        {
            "name": "search_arxiv",
            "description": "Search arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                },
            },
        }
    ])
    # The response should contain the warning about search function limit
    assert "[GEMINI WARNING]" in response


def test_stream_yields_chunks():
    model = gemini.GeminiModel(api_key="dummy", model="dummy-model")
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Hello"},
    ]
    chunks = list(model.stream(chat_history))
    assert len(chunks) == 2
    assert all(hasattr(chunk, "text") for chunk in chunks)
    assert chunks[0].text == "stream chunk 1"
    assert chunks[1].text == "stream chunk 2"[0m
