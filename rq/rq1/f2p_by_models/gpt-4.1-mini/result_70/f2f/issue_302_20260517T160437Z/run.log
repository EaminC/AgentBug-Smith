        {"role": "user", "content": "Stream test"},
    ]

    stream = gm.stream(chat_history)
    chunks = list(stream)
    assert isinstance(chunks, list)
    assert all(isinstance(chunk, str) for chunk in chunks)
    assert "chunk1" in chunks[0]
