            def __init__(self, name=None, args=None):
                self.name = name
                self.args = args or {}

        class DummyPart:
            def __init__(self, function_call=None):
                self.function_call = function_call

        class DummyContent:
            def __init__(self, parts=None):
                self.parts = parts or []

        class DummyCandidate:
            def __init__(self, content=None, text="dummy response"):
                self.content = content or DummyContent()
                self.text = text

        class DummyResponse:
            def __init__(self, candidates=None, text="dummy response"):
                self.candidates = candidates or []
                self.text = text

        # If contents is empty or no functions, return simple text response
        if not contents:
            return DummyResponse(text="Hello from dummy GeminiModel")

        # If last content has a function call request, simulate a function call
        last_content = contents[-1] if isinstance(contents, list) else None
        if last_content and isinstance(last_content, dict):
            # Check if last content has a function call request
            for part in last_content.get('parts', []):
                if isinstance(part, dict) and part.get('function_call'):
                    fn_call = DummyFunctionCall(name=part['function_call']['name'], args=part['function_call'].get('args', {}))
                    dummy_part = DummyPart(function_call=fn_call)
                    dummy_content = DummyContent(parts=[dummy_part])
                    dummy_candidate = DummyCandidate(content=dummy_content, text="Function call response")
                    return DummyResponse(candidates=[dummy_candidate], text="Function call response")

        # Default dummy response with no function call
        return DummyResponse(text="Hello from dummy GeminiModel")

    def generate_content_stream(self, model, contents, config):
        # Yield dummy chunks with text attribute
        class DummyChunk:
            def __init__(self, text):
                self.text = text

        yield DummyChunk("streamed chunk 1")
        yield DummyChunk("streamed chunk 2")
        yield DummyChunk("streamed chunk 3")


class DummyTypesFunctionDeclaration:
    def __init__(self, name, description, parameters):
        self.name = name
        self.description = description
        self.parameters = parameters


class DummyTypesSchema:
    def __init__(self, type, properties=None, required=None):
