def test_adapt_history_for_gemini_format():
    model = gemini_module.GeminiModel(api_key="dummy", model="dummy-model")

    chat_history = [
        {"role": "system", "content": "System instruction here."},
        {"role": "user", "content": "Hello, how are you?"},
        {"role": "assistant", "content": "I am fine, thank you."},
        {"role": "user", "content": "Tell me a joke."},
    ]

    system_instruction, prompt = model._adapt_history_for_gemini(chat_history)

    assert system_instruction == "System instruction here."
    assert isinstance(prompt, list)
    assert len(prompt) == 3
    assert prompt[0]["role"] == "user"
    assert prompt[0]["parts"][0]["text"] == "Hello, how are you?"
    assert prompt[1]["role"] == "model"
    assert prompt[1]["parts"][0]["text"] == "I am fine, thank you."
    assert prompt[2]["role"] == "user"
    assert prompt[2]["parts"][0]["text"] == "Tell me a joke."


def test_create_gemini_tools_none_and_nonempty():
    model = gemini_module.GeminiModel(api_key="dummy", model="dummy-model")

    # Test with None
    tools_none = model._create_gemini_tools(None)
    assert tools_none is None

    # Test with empty list
    tools_empty = model._create_gemini_tools([])
    assert tools_empty is None

    # Test with one function dict
    func_dict = {
        "name": "search_arxiv",
        "description": "Search arxiv papers",
        "parameters": {
            "type": "object",
            "properties": {
                "query": {"type": "string", "description": "Search query"},
                "max_results": {"type": "integer", "description": "Max results to return"},
            },
        },
    }
    tools = model._create_gemini_tools([func_dict])
    assert isinstance(tools, list)
    assert len(tools) == 1
    tool = tools[0]
    assert hasattr(tool, "function_declarations")
    assert len(tool.function_declarations) == 1
    decl = tool.function_declarations[0]
    assert decl.name == "search_arxiv"
    assert decl.description == "Search arxiv papers"
    assert hasattr(decl.parameters, "properties")
    assert "query" in decl.parameters.properties
    assert "max_results" in decl.parameters.properties


def test_query_returns_string_and_limits_tools():
    model = gemini_module.GeminiModel(api_key="dummy", model="dummy-model", temperature=0.5)

    # Provide chat history that triggers a function call (search_arxiv)
    chat_history = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Find papers about AI."},
    ]

    # Provide functions that include 'search_arxiv' to allow function call
    functions = [
        {
            "name": "search_arxiv",
            "description": "Search arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                },
            },
        }
    ]

    # Patch get_function to a dummy function that returns a fixed string
    def dummy_search_arxiv(query):
        return f"Results for {query}"

    import mle.function

    monkeypatch = pytest.MonkeyPatch()
    monkeypatch.setattr(mle.function, "get_function", lambda name: dummy_search_arxiv if name == "search_arxiv" else lambda **kwargs: "unknown")
    monkeypatch.setattr(mle.function, "process_function_name", lambda name: name)
    monkeypatch.setattr(mle.function, "SEARCH_FUNCTIONS", ["search_arxiv"])

    # Run query - should perform one function call then return final text
    result = model.query(chat_history, functions=functions)

    monkeypatch.undo()

    assert isinstance(result, str)
    assert "Final answer from model." in result or "[GEMINI WARNING]" in result or "FunctionResponse" not in result


def test_gemini_model_query_function_call_limit():
    model = gemini_module.GeminiModel(api_key="dummy", model="dummy-model", temperature=0.5)

    # Prepare chat history and functions to trigger repeated search function calls
    chat_history = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Find papers about AI."},
    ]

    functions = [
        {
            "name": "search_arxiv",
            "description": "Search arxiv papers",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {"type": "string", "description": "Search query"},
                },
            },
        }
    ]

    # Patch get_function to a dummy function that returns a fixed string
    def dummy_search_arxiv(query):
        return f"Results for {query}"

    import mle.function

    monkeypatch = pytest.MonkeyPatch()
    monkeypatch.setattr(mle.function, "get_function", lambda name: dummy_search_arxiv if name == "search_arxiv" else lambda **kwargs: "unknown")
    monkeypatch.setattr(mle.function, "process_function_name", lambda name: name)
    monkeypatch.setattr(mle.function, "SEARCH_FUNCTIONS", ["search_arxiv"])

    # Manually fill func_call_history to simulate repeated calls
    model.func_call_history = ["search_arxiv"] * 3

    # Run query - should detect search function call limit and return warning string
    result = model.query(chat_history, functions=functions)

    monkeypatch.undo()

    assert isinstance(result, str)
    assert "[GEMINI WARNING]" in result


