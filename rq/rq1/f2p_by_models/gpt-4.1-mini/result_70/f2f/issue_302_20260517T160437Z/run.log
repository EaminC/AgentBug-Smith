def test_adapt_history_for_gemini_basic():
    model = gemini.GeminiModel(api_key="dummy", model="test-model")
    chat_history = [
        {"role": "system", "content": "System instruction."},
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there!"},
        {"role": "user", "content": "How are you?"},
    ]
    system_instruction, prompt = model._adapt_history_for_gemini(chat_history)
    assert system_instruction == "System instruction."
    assert isinstance(prompt, list)
    assert all(isinstance(p, dict) for p in prompt)
    roles = [p["role"] for p in prompt]
    assert roles == ["user", "model", "user"]
    parts_texts = [p["parts"][0]["text"] for p in prompt]
    assert parts_texts == ["Hello", "Hi there!", "How are you?"]


def test_create_gemini_tools_empty_and_nonempty():
    model = gemini.GeminiModel(api_key="dummy", model="test-model")
    # Empty functions list returns None
    assert model._create_gemini_tools([]) is None
    # Non-empty functions list returns list with Tool dict
    funcs = [
        {
            "name": "func1",
            "description": "desc1",
            "parameters": {
                "type": "object",
                "properties": {
                    "param1": {"type": "string", "description": "desc param1"},
                    "param2": {"type": "integer", "description": "desc param2"},
                },
            },
        }
    ]
    tools = model._create_gemini_tools(funcs)
    assert isinstance(tools, list)
    assert "function_declarations" in tools[0]
    decl = tools[0]["function_declarations"][0]
    assert decl["name"] == "func1"
    assert decl["description"] == "desc1"
    assert "parameters" in decl
    params = decl["parameters"]
    assert "properties" in params
    assert "param1" in params["properties"]
    assert "param2" in params["properties"]
    assert params["required"] == ["param1", "param2"]


