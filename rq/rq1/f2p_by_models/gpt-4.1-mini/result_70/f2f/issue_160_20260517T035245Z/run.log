    def __init__(self):
        self.messages = MagicMock()

    def create(self, **kwargs):
        pass


@pytest.fixture
def dummy_model(monkeypatch):
    # Patch the internal client to simulate Claude behavior
    model = Model(api_key="dummy", model="claude-2")
    dummy_client = DummyClient()
    model.client = dummy_client

    def dummy_create(**kwargs):
        # Simulate the first call returns a tool_use stop_reason with a function call
        if not hasattr(model, "_called_once"):
            model._called_once = True
            func = DummyFunc(
                id="123",
                name="search_function",
                input={"query": "test query"},
            )
            return DummyCompletionContent(
                stop_reason="tool_use",
                content=[func],
            )
        else:
            # Simulate the second call returns normal text content
            return DummyCompletionContent(
                stop_reason=None,
                content=[MagicMock(text="def main():\n    print('Hello World')")],
            )

    dummy_client.messages.create.side_effect = dummy_create
    return model


def test_coder_agent_generates_code(dummy_model):
    # Setup a CoderAgent with the dummy model
    agent = CoderAgent(model=dummy_model, working_dir="test-claude")

    # Provide a user prompt that would trigger code generation
    user_prompt = "Create a Python script that prints Hello World."

    # Run the agent's main method to generate code
    result = agent.run(user_prompt)

    # The result should contain the generated code snippet
    assert "def main()" in result or "print" in result

    # The dummy_model should have recorded at least one function call
    assert len(dummy_model.func_call_history) > 0

    # The function call history should contain the search_function call
    assert any(
