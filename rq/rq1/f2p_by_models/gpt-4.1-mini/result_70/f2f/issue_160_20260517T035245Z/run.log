            else:
                return "def foo():\n    return 42\n"

        def stream(self, chat_history, **kwargs):
            yield "streamed response"

    return DummyClaudeModel(api_key="dummy", model="claude-2", temperature=0.5)


def test_claude_query_generates_code(dummy_claude_model):
    # Test that the dummy Claude model returns code string containing "def "
    chat_history = [{"role": "system", "content": "You are a helpful assistant."}]
    code = dummy_claude_model.query(chat_history)
    assert isinstance(code, str)
    assert "def " in code


def test_query_handles_no_tool_use():
    # Test that query returns text normally if no tool_use stop_reason
    class DummyModelNoToolUse(Model):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, **kwargs)
            self.model_type = MODEL_CLAUDE
            self.temperature = 0.5

        def query(self, chat_history, **kwargs):
            # Return a dummy completion with no tool_use stop_reason
            return "normal response"

        def stream(self, chat_history, **kwargs):
            yield "streamed response"

    dummy = DummyModelNoToolUse(api_key="dummy", model="claude-2", temperature=0.5)
    chat_history = [{"role": "system", "content": "system prompt"}]
    response = dummy.query(chat_history)
    assert response == "normal response"[0m
