        {"role": "user", "content": "Create a python file named test.py with a print statement."}
    ]

    # Call the query method which should trigger the tool call and then final response
    output = dummy_coder_agent.model.query(chat_history, functions=[{
        "name": "create_file",
        "parameters": {
            "type": "object",
            "properties": {
                "filename": {"type": "string"},
                "content": {"type": "string"}
            },
            "required": ["filename", "content"]
        }
    }], response_format={"type": "text"})

    # Assert that the output is the final text response
    assert output == "Code generated successfully"

    # Assert that the function call history recorded the function call
