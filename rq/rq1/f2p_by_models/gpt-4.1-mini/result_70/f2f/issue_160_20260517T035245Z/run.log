    # Provide a prompt that would trigger code generation
    prompt = (
        "Start a project called test-claude and generate a Python file with a function foo "
        "that returns 42."
    )

    # Run the coder agent to generate code
    code = coder.generate_code(prompt)

    # Assert that code is generated and contains the expected function definition
    assert code is not None, "Coder did not generate any code"
    assert "def foo()" in code, "Generated code does not contain expected function definition"

    # Additionally, check that the generated command (if any) is correct format
    command = coder.generate_command(prompt)
    assert command is not None, "Coder did not generate any command"
    assert isinstance(command, str), "Generated command is not a string"
    assert len(command) > 0, "Generated command is empty"


def test_planner_executes_well_and_returns_plan(dummy_model):
    planner = Planner(model=dummy_model)

    # Provide a simple project plan prompt
    prompt = "Plan a project called test-claude with steps to create a Python function foo."

    plan = planner.plan(prompt)

    # Assert that the plan is returned and is a non-empty string
    assert plan is not None, "Planner did not return any plan"
    assert isinstance(plan, str), "Planner output is not a string"
    assert len(plan) > 0, "Planner returned an empty plan"


def test_integration_coder_and_planner(dummy_model):
    # Integration test: planner generates a plan, coder generates code from plan
    planner = Planner(model=dummy_model)
    coder = Coder(model=dummy_model, working_dir="test-claude")

    plan_prompt = "Plan a project called test-claude with steps to create a Python function foo."
    plan = planner.plan(plan_prompt)
    assert plan is not None and len(plan) > 0

    code = coder.generate_code(plan)
    assert code is not None and "def foo()" in code


