    assert "user" in roles
    # Check that the last two messages correspond to tool_use and tool_result
    assert chat_history[-2]["role"] == "assistant"
    assert chat_history[-1]["role"] == "user"
    assert chat_history[-2]["content"][0]["type"] == "tool_use"
    assert chat_history[-1]["content"][0]["type"] == "tool_result"[0m
