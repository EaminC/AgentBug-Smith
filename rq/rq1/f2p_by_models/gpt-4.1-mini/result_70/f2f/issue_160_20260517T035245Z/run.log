    coder_agent = coder_module.Coder(model=model_with_mocked_client, working_dir=".", console=None)

    # Patch the actual functions create_directory and create_file to track calls
    called_functions = {}

    def fake_create_directory(path):
        called_functions["create_directory"] = path
        return f"Directory {path} created"

    def fake_create_file(path, content):
        called_functions["create_file"] = (path, content)
        return f"File {path} created with content length {len(content)}"

    with patch("mle.function.files.create_directory", side_effect=fake_create_directory), \
         patch("mle.function.files.create_file", side_effect=fake_create_file), \
         patch("mle.function.execution.execute_command", side_effect=lambda cmd: f"Executed {cmd}"), \
         patch("mle.function.search.search_code", side_effect=lambda query: f"Search results for {query}"):
        # Run the coder agent query method with chat history and functions list
        # The functions list should match those the agent can call
        functions = [
            {"name": "create_directory", "parameters": {"type": "object", "properties": {"path": {"type": "string"}}}},
            {"name": "create_file", "parameters": {"type": "object", "properties": {"path": {"type": "string"}, "content": {"type": "string"}}}},
            {"name": "execute_command", "parameters": {"type": "object", "properties": {"command": {"type": "string"}}}},
            {"name": "search_code", "parameters": {"type": "object", "properties": {"query": {"type": "string"}}}},
        ]

        output = coder_agent.model.query(chat_history, functions=functions, response_format={"type": "json"})

    # After the fix, the agent should have called create_directory with path "test-claude"
    assert "create_directory" in called_functions, "create_directory was not called"
    assert called_functions["create_directory"] == "test-claude"

    # The output should be a string (the final text response from the model)
    assert isinstance(output, str)
    # The output should not be empty
    assert output.strip() != ""

    # The test fails on buggy code because no code generation or function call happens,
    # so called_functions will be empty and assertion fails.
    # After fix, the test passes as the function call is detected and output returned.[0m
