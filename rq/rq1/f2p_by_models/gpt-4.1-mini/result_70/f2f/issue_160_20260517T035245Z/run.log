    assert "print('Hello World')" in result

    # The function call history should contain the search call
    assert any(call["name"] == "search" for call in coder.model.func_call_history)


def test_coder_generate_code_without_tool_use(dummy_model):
    # Setup a Coder agent with the dummy model
    coder = Coder(model=dummy_model, working_dir="test-claude")

    # Prepare a chat history with a system prompt and user prompt
    chat_history = [
        {"role": "system", "content": "You are a programmer."},
        {"role": "user", "content": "Write a function that adds two numbers."}
    ]

    # Patch dummy_client to return direct text without tool_use
    def dummy_create_no_tool_use(max_tokens, model, system, messages, temperature, stream=False, tools=None):
        return DummyCompletion(
            stop_reason=None,
            content=[DummyCompletionContent(text="def add(a, b):\n    return a + b")]
        )

    dummy_model.client.messages.create.side_effect = dummy_create_no_tool_use

    # Call the query method which should return code directly
    result = coder.model.query(chat_history, response_format={"type": "python"})

    # The result should contain the generated code string
    assert "def add" in result
    assert "return a + b" in result[0m
