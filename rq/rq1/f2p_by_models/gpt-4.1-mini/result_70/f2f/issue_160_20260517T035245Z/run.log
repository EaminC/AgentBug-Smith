        self.model_type = model_module.MODEL_CLAUDE
        self.temperature = temperature
        self.client = DummyClaudeClient()
        self.model = "dummy-claude-model"
        self.func_call_history = []

    monkeypatch.setattr(claude_cls, "__init__", dummy_init)

