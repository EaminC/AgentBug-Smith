def test_claude_query_tool_use(monkeypatch):
    # Patch ClaudeModel.__init__ to use DummyClaudeClient and avoid import error for anthropic
    # The class name in model.py might be ClaudeModel or ModelClaude; adjust accordingly
    # The patch references ModelClaude, but import failed, so fallback to ClaudeModel if present
    claude_cls = None
