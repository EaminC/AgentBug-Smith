    tool_use_response.stop_reason = "tool_use"
    tool_use_response.content = [func_call]

    # Second call returns final text content after tool use
    final_response = MagicMock()
    final_response.stop_reason = None
    final_response.content = [MagicMock(text="Code generated successfully")]

    # Setup side effects for client.messages.create to simulate recursive calls
    mock_client.messages.create.side_effect = [tool_use_response, final_response]

    # Prepare chat history with system prompt and user prompt
