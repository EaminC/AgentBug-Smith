import pytest
from mle.agents import coder, debugger
from mle.model import ModelClaude


def test_coder_sys_prompt_contains_leverage_phrase():
    # The bug was that the sys_prompt in coder.Coder __init__ did not contain the phrase "Your can leverage your capabilities"
    # We test that after initialization, the sys_prompt contains this exact phrase.
    # We instantiate the coder agent with a dummy model (None) and working_dir.
    agent = coder.Coder(model=None, working_dir="test-claude")
    # Check that the phrase "Your can leverage your capabilities" is in the sys_prompt string
    assert "Your can leverage your capabilities" in agent.sys_prompt


def test_debugger_sys_prompt_contains_leverage_phrase():
    # Similar test for debugger.DebugAgent sys_prompt
    agent = debugger.DebugAgent(model=None)
    assert "Your can leverage your capabilities" in agent.sys_prompt


def test_modelclaude_query_function_call_history_and_recursive_call(monkeypatch):
    # This test verifies that ModelClaude.query properly handles tool_use stop_reason,
    # calls the function, appends to func_call_history, and recursively calls query again.
    # We mock the internal client.messages.create to simulate the tool_use response and then a normal response.

    model = ModelClaude(api_key="dummy", model=None)

    # Prepare dummy chat history
    chat_history = [
        {"role": "system", "content": "System prompt"},
        {"role": "user", "content": "User message"},
    ]

    # Define a dummy function to be called by get_function
    def dummy_function(**kwargs):
        return "dummy result"

    # Patch get_function to return dummy_function
    import mle.model as model_module
    monkeypatch.setattr(model_module, "get_function", lambda name: dummy_function)

    # Patch process_function_name to return the name unchanged
    monkeypatch.setattr(model_module, "process_function_name", lambda name: name)

    # Patch SEARCH_FUNCTIONS to a list with one element to test search_attempts logic
    monkeypatch.setattr(model_module, "SEARCH_FUNCTIONS", ["search"])

    # We simulate two calls to client.messages.create:
    # First returns a tool_use stop_reason with a tool_use content,
    # second returns a normal completion with stop_reason != tool_use

    class DummyFunc:
        def __init__(self):
            self.type = "tool_use"
            self.id = "func_id"
            self.name = "test_func"
            self.input = {}

    class DummyCompletion:
        def __init__(self, stop_reason, content):
            self.stop_reason = stop_reason
            self.content = content

    # We keep track of calls to simulate different responses
    call_count = {"count": 0}

    def dummy_create(**kwargs):
        call_count["count"] += 1
        if call_count["count"] == 1:
            # First call simulates tool_use stop_reason with one tool_use function
            return DummyCompletion(
                stop_reason="tool_use",
                content=[DummyFunc()]
            )
        else:
            # Second call simulates normal completion with text content
            return DummyCompletion(
                stop_reason="stop",
                content=[type("Content", (), {"text": "final response"})()]
            )

    # Patch model.client.messages.create to dummy_create
    monkeypatch.setattr(model.client.messages, "create", dummy_create)

    # Call query and expect it to return the final response text
    response = model.query(chat_history, functions=[{"name": "test_func", "parameters": {}}])

    # The response should be the final response text from second call
    assert response == "final response"

    # The func_call_history should have one entry with the function name and arguments
    assert len(model.func_call_history) == 1
    assert model.func_call_history[0]["name"] == "test_func"
    assert model.func_call_history[0]["arguments"] == {}

    # The chat_history should have been extended with tool_use and tool_result messages
    roles = [msg["role"] for msg in chat_history]
    # There should be at least one assistant and one user role added for tool_use and tool_result
    assert "assistant" in roles
    assert "user" in roles


def test_modelclaude_query_removes_parameters_key(monkeypatch):
    # This test verifies that in ModelClaude.query,
    # the "parameters" key in functions is replaced by "input_schema"

    model = ModelClaude(api_key="dummy", model=None)

    # Patch client.messages.create to return a normal completion
    class DummyCompletion:
        def __init__(self):
            self.stop_reason = "stop"
            self.content = [type("Content", (), {"text": "response"})()]

    def dummy_create(**kwargs):
        # Check that functions have input_schema and no parameters
        tools = kwargs.get("tools", [])
        for tool in tools:
            assert "input_schema" in tool
            assert "parameters" not in tool
        return DummyCompletion()

    monkeypatch.setattr(model.client.messages, "create", dummy_create)

    chat_history = [{"role": "system", "content": "sys"}]

    # Provide functions with parameters key
    functions = [{"name": "func1", "parameters": {"type": "object"}}]

    # Call query, which should trigger the assertion in dummy_create
    response = model.query(chat_history, functions=functions)

    assert response == "response"


