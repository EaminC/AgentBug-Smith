ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

# Copy entire repository into container
COPY . .

# Install dependencies in src/frontend
RUN if [ -f "src/frontend/package-lock.json" ]; then \
      cd src/frontend && npm ci; \
    elif [ -f "src/frontend/package.json" ]; then \
      cd src/frontend && npm install; \
    else \
      echo "No frontend package manifest found"; \
    fi

# Install dependencies in scripts/aws for standalone script and tests
RUN if [ -f "scripts/aws/package-lock.json" ]; then \
      cd scripts/aws && npm ci; \
    elif [ -f "scripts/aws/package.json" ]; then \
      cd scripts/aws && npm install; \
    else \
      echo "No aws package manifest found"; \
    fi

EXPOSE 3000

CMD ["/bin/bash"]
