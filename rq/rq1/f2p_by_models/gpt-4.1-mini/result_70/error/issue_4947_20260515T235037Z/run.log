ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"

# Set working directory to /app inside the container
WORKDIR /app

# Copy entire repository into the container
COPY . .

# Install JavaScript dependencies inside src/frontend where package.json resides
RUN if [ -f "src/frontend/package-lock.json" ]; then \
      cd src/frontend && npm ci; \
    elif [ -f "src/frontend/yarn.lock" ]; then \
      cd src/frontend && yarn install --frozen-lockfile; \
    elif [ -f "src/frontend/pnpm-lock.yaml" ]; then \
      npm install -g pnpm && cd src/frontend && pnpm install; \
    else \
      cd src/frontend && npm install; \
    fi

# Verify Node and npm versions
RUN node -v && npm -v

# Default to bash shell to keep container running interactively
CMD ["/bin/bash"]
