[32mFROM node:21-alpine AS test_builder

# Set working directory
WORKDIR /app

# Copy entire repository
COPY . .

# Install frontend dependencies including test tools
RUN if [ -f "src/frontend/package-lock.json" ]; then \
      cd src/frontend && npm ci; \
    elif [ -f "src/frontend/package.json" ]; then \
      cd src/frontend && npm install; \
    else \
      echo "No frontend package manifest found"; \
    fi

# Run frontend tests to verify setup
RUN cd src/frontend && npx playwright test --project=chromium

# Minimal runtime image stage
FROM node:21-alpine AS runtime

WORKDIR /app

# Copy only production relevant files from test_builder
COPY --from=test_builder /app/src/frontend /app/src/frontend
COPY --from=test_builder /app/src/backend /app/src/backend
COPY --from=test_builder /app/package.json /app/package.json
COPY --from=test_builder /app/package-lock.json /app/package-lock.json

# Install only production dependencies
RUN if [ -f "package-lock.json" ]; then \
      npm ci --omit=dev; \
    elif [ -f "package.json" ]; then \
      npm install --omit=dev; \
    fi

# Expose default port if known (makefile shows backend run on 7860, frontend on 3000)
EXPOSE 7860 3000

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Assumption: main app is Python backend with uv runner, but since this is JS Dockerfile (per prompt)
# we keep CMD as /bin/bash as required by prompt
CMD ["/bin/bash"][0m
