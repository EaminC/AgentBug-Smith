ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

# Copy entire repository into container
COPY . .

# Install dependencies based on lock files
RUN if [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm && \
      pnpm install --frozen-lockfile; \
    elif [ -f "package-lock.json" ]; then \
      npm ci; \
    else \
      npm install; \
    fi

# Conditionally install standard JavaScript test frameworks if missing
RUN if ! npm list jest mocha > /dev/null 2>&1; then npm install --save-dev jest mocha; fi

# Verify jest is installed and can be required; warn but do not fail if missing
RUN node -e "try { require('jest'); console.log('preflight ok'); } catch(e) { console.warn('jest not installed'); }"

