[32mFROM node:20-alpine AS test_builder

WORKDIR /app

# Install pnpm if not present
RUN if ! command -v pnpm >/dev/null 2>&1; then npm install -g pnpm@10.15.0; fi

COPY . .

# Install dependencies including dev dependencies using pnpm in the clients/openai-node directory
RUN if [ -f "clients/openai-node/package.json" ] && [ -f "clients/openai-node/pnpm-lock.yaml" ]; then \
      cd clients/openai-node && \
      pnpm install --frozen-lockfile && \
      pnpm test; \
    else \
      echo "clients/openai-node package.json or pnpm-lock.yaml not found"; \
      exit 1; \
    fi

# Install dependencies for internal/tensorzero-node and run tests
RUN if [ -f "internal/tensorzero-node/package.json" ] && [ -f "internal/tensorzero-node/pnpm-lock.yaml" ]; then \
      cd internal/tensorzero-node && \
      pnpm install --frozen-lockfile && \
      pnpm test; \
    else \
      echo "internal/tensorzero-node package.json or pnpm-lock.yaml not found"; \
      exit 1; \
    fi

# Preflight check for Node.js environment
RUN node -e "console.log('preflight ok')"

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

