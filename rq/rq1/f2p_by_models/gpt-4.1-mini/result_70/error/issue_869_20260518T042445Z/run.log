[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly_key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set environment variables for Forge API compatibility with OpenAI and Anthropic SDKs
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Other environment variables from .env for runtime
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV MODEL=tensorblock/gpt-4.1-mini
ENV AI_TEMPERATURE=0.7
ENV GITHUB_TOKEN=ghp_key
ENV TAVILY_API_KEY=tvly_key

# Set working directory
WORKDIR /app

# Copy entire repository to container
COPY . .

# Upgrade pip, setuptools, wheel to latest
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies commonly needed for Python projects with compiled packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    python3-dev && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies robustly:
# If requirements.txt present, install requirements, then install package itself,
# then install test dependencies explicitly needed for test suite.
RUN if [ -f requirements.txt ]; then \
    pip install -r requirements.txt && pip install -e . ; \
elif [ -f pyproject.toml ] && [ ! -f poetry.lock ]; then \
    pip install -e . ; \
elif [ -f pyproject.toml ] && [ -f poetry.lock ]; then \
    pip install poetry && poetry install && pip install -e . ; \
else \
    echo "No Python dependency files found."; \
fi

# Explicitly install test dependencies to avoid ImportError during test collection
RUN pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm backoff dataclasses_json langchain

# Sanity check that pytest and pkg_resources are importable
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Final command to keep container open in bash shell for test harness
CMD ["/bin/bash"]

