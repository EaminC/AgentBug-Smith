[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Copy entire repository including injected tests
COPY . .

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Upgrade pip, setuptools, wheel early
# Install poetry and dependencies if pyproject.toml exists
RUN set -eux; \
    if [ -f "pyproject.toml" ]; then \
        python -m pip install --upgrade pip setuptools wheel; \
        pip install poetry; \
        poetry config virtualenvs.create false; \
        poetry install --no-interaction --no-ansi; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    else \
        python -m pip install --upgrade pip setuptools wheel; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests with pytest to verify installation
RUN pytest -v

# Build minimal runtime image
FROM python:3.12-slim AS runtime

WORKDIR /app

COPY --from=test_builder /app /app

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Install only runtime dependencies via poetry if lockfile exists, else fallback to install without dev dependencies
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    pip install poetry; \
    if [ -f "poetry.lock" ]; then \
        poetry config virtualenvs.create false; \
        poetry install --no-dev --no-interaction --no-ansi; \
    else \
        poetry config virtualenvs.create false; \
        poetry install --no-dev --no-interaction --no-ansi || true; \
    fi

