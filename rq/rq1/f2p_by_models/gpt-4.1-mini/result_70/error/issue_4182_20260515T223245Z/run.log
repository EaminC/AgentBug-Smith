      cd src/frontend && npm install; \
    else \
      echo "No package.json in src/frontend, skipping npm install there"; \
    fi

# Install dependencies in scripts/aws if package.json is there
RUN if [ -f "scripts/aws/package.json" ]; then \
      cd scripts/aws && npm install; \
    else \
      echo "No package.json in scripts/aws, skipping npm install there"; \
    fi

# Install Jest and Mocha for testing compatibility
RUN npm install --no-save jest mocha || true

# Preflight check to confirm jest is installed
RUN node -e "require('jest'); console.log('preflight ok')" || true

# Default command: start bash shell
CMD ["/bin/bash"]
