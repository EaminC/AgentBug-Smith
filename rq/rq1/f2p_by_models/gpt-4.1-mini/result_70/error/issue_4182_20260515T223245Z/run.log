# Install Jest and Mocha globally for testing compatibility
RUN npm install -g jest mocha || true

# Preflight check to confirm jest is installed
RUN node -e "require('jest'); console.log('preflight ok')" || true

# Default command: start bash shell
CMD ["/bin/bash"]
