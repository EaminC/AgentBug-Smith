[32m# Use official Node.js 21 image as base for build/test stage
FROM node:21 AS test_builder

# Set working directory
WORKDIR /app

# Copy entire repository to /app
COPY . .

# Install frontend dependencies if package.json exists in src/frontend
RUN if [ -f src/frontend/package.json ]; then \
      cd src/frontend && npm install; \
    fi

# Install backend dependencies if package.json exists in root (assuming for JS, but no such file shown; assume frontend only)
# Assumption: No root package.json; frontend under src/frontend

# Run frontend tests if test files exist
# Assumption: Tests are run via npm scripts in src/frontend
RUN if [ -f src/frontend/package.json ]; then \
      cd src/frontend && npm test; \
    fi

# Preflight check: ensure node_modules installed correctly
RUN if [ -d src/frontend/node_modules ]; then echo "node_modules installed"; else echo "node_modules missing" && exit 1; fi

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Minimal runtime image for production
FROM node:21-alpine AS runtime

WORKDIR /app

# Copy only production dependencies from test_builder
COPY --from=test_builder /app/src/frontend/package.json ./src/frontend/
COPY --from=test_builder /app/src/frontend/package-lock.json ./src/frontend/
COPY --from=test_builder /app/src/frontend/node_modules ./src/frontend/node_modules

# Copy entire repository to runtime image
COPY . .

# Install only production dependencies in src/frontend
RUN if [ -f src/frontend/package.json ]; then \
      cd src/frontend && npm install --production; \
    fi

# Expose port 3000 (default frontend port)
EXPOSE 3000

# Set Forge environment variables in runtime
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Default command inferred from Makefile: frontend runs on port 3000 using npm start in src/frontend
CMD ["sh", "-c", "cd src/frontend && npm start"][0m
