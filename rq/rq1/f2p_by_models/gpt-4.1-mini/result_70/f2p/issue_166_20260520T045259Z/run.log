def test_map_chat_history_from_openai(model_instance):
    input_history = [
        {"role": "system", "content": "System message"},
        {"role": "user", "content": "User message"},
        {"role": "assistant", "content": "Assistant message"},
    ]
    mapped = model_instance._map_chat_history_from_openai(input_history)
    expected = [
        {"role": "model", "parts": "System message"},
        {"role": "user", "parts": "User message"},
        {"role": "model", "parts": "Assistant message"},
    ]
    assert mapped == expected


def test_map_functions_from_openai_types(model_instance):
    functions = [
        {
            "name": "func1",
            "description": "desc1",
            "parameters": {
                "type": "object",
                "properties": {
                    "param1": {"type": "string", "description": "desc param1"},
                    "param2": {"type": "integer", "description": "desc param2"},
                },
            },
        }
    ]
    tool = model_instance._map_functions_from_openai(functions)
    assert isinstance(tool, DummyProtos.Tool)
    decl = tool.function_declarations[0]
    assert decl.name == "func1"
    assert decl.description == "desc1"
    assert isinstance(decl.parameters, DummyProtos.Schema)
    assert decl.parameters.type == DummyProtos.OBJECT
    assert "param1" in decl.parameters.properties
    assert "param2" in decl.parameters.properties


def test_mapping_response_format_from_openai(model_instance):
    assert model_instance._mapping_response_format_from_openai({"type": "json_object"}) == "application/json"
    assert model_instance._mapping_response_format_from_openai({"type": "text"}) is None
    assert model_instance._mapping_response_format_from_openai({}) is None


