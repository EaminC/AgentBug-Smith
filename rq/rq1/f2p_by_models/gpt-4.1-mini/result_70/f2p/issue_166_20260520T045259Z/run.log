def test_load_model_returns_gemini_model(monkeypatch, dummy_api_key, dummy_model_name):
    # Patch get_config to return Gemini platform and api_key
    monkeypatch.setattr(
        "mle.utils.get_config",
        lambda *args, **kwargs: {"platform": "Gemini", "api_key": dummy_api_key},
    )
    model = load_model(project_dir=".", model_name=dummy_model_name)
    assert isinstance(model._model, GeminiModel)
    assert model._model.api_key == dummy_api_key or hasattr(model._model, "gemini")


@patch("importlib.util.find_spec")
@patch("importlib.import_module")
def test_gemini_model_init_and_query(mock_import_module, mock_find_spec, dummy_api_key, dummy_model_name, dummy_chat_history):
    # Setup mocks for google.generativeai module and its classes/methods
    mock_find_spec.return_value = True

