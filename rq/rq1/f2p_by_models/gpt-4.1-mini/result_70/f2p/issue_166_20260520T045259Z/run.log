    mock_import_module.return_value = mock_gemini

    # Mock configure method
    mock_gemini.configure = MagicMock()

    # Mock protos and types for GeminiModel
    mock_gemini.protos = MagicMock()
    mock_gemini.types = MagicMock()

    # Setup protos.Type enum mapping
    mock_gemini.protos.Type.STRING = 1
    mock_gemini.protos.Type.OBJECT = 2
    mock_gemini.protos.Type.NUMBER = 3
    mock_gemini.protos.Type.BOOLEAN = 4
    mock_gemini.protos.Type.ARRAY = 5
    mock_gemini.protos.Type.TYPE_UNSPECIFIED = 0

    # Mock protos.FunctionDeclaration and Schema to just return their input for simplicity
    mock_gemini.protos.FunctionDeclaration = lambda **kwargs: kwargs
    mock_gemini.protos.Schema = lambda **kwargs: kwargs
    mock_gemini.protos.Tool = lambda function_declarations: function_declarations
    mock_gemini.protos.Part = lambda **kwargs: kwargs
    mock_gemini.protos.FunctionResponse = lambda **kwargs: kwargs
    mock_gemini.protos.Content = lambda **kwargs: kwargs

    # Mock types.GenerationConfig to just return its kwargs
    mock_gemini.types.GenerationConfig = lambda **kwargs: kwargs

    # Mock GenerativeModel and chat handler
    mock_chat_handler = MagicMock()
    mock_completion = MagicMock()
    mock_completion.parts = []

    # The send_message returns a completion with text attribute
    mock_completion.text = "response text"
    mock_chat_handler.send_message.return_value = mock_completion
    mock_gemini.GenerativeModel.return_value.start_chat.return_value = mock_chat_handler

    # Instantiate GeminiModel
