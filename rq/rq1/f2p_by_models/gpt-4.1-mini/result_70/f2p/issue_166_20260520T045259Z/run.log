    # Patch protos.Type to dummy integer values
    type_map = {
        "string": model_instance.gemini.protos.Type.STRING,
        "object": model_instance.gemini.protos.Type.OBJECT,
        "integer": model_instance.gemini.protos.Type.NUMBER,
        "boolean": model_instance.gemini.protos.Type.BOOLEAN,
        "array": model_instance.gemini.protos.Type.ARRAY,
        "TYPE_UNSPECIFIED": model_instance.gemini.protos.Type.TYPE_UNSPECIFIED,
    }
    # Call mapping
    tool = model_instance._map_functions_from_openai(functions)
    # The returned tool should have function_declarations attribute with one item
    assert hasattr(tool, "function_declarations")
    assert len(tool.function_declarations) == 1
    fd = tool.function_declarations[0]
    assert fd.name == "func1"
    assert fd.description == "desc1"
    # Parameters should be a Schema object with type OBJECT
    assert fd.parameters.type == type_map["object"]
    # Properties keys match
    assert "param1" in fd.parameters.properties
    assert "param2" in fd.parameters.properties
    # Required keys include param1 and param2
    assert set(fd.parameters.required) == {"param1", "param2"}


def test_mapping_response_format_from_openai(model_instance):
    # JSON object type returns application/json
    assert model_instance._mapping_response_format_from_openai({"type": "json_object"}) == "application/json"
    # Other types return None
    assert model_instance._mapping_response_format_from_openai({"type": "text"}) is None
    assert model_instance._mapping_response_format_from_openai({}) is None


