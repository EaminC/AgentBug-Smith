    mock_gemini.configure.assert_called_once_with(api_key=dummy_api_key)
    mock_gemini.GenerativeModel.assert_called_once_with(dummy_model_name)
    mock_chat_handler.send_message.assert_called()

    # Test stream method yields chunks
    mock_chunk = MagicMock()
    mock_chunk.text = "streamed chunk"
    mock_chat_handler.send_message.return_value = iter([mock_chunk])

    chunks = list(model.stream(dummy_chat_history))
    assert chunks == ["streamed chunk"]


def test_cli_platform_choices_contains_gemini():
    import mle.cli

    # The platform choices list should contain 'Gemini'
    choices = [choice for choice in mle.cli.questionary.select.call_args[1]["choices"]] if hasattr(mle.cli.questionary.select, "call_args") else None
    # Instead of relying on call_args, directly check the source code string for the choices list
    # This is a fallback if questionary.select is not patched
    # We just assert that the string 'Gemini' is in the cli.py file choices list
    import inspect
    source = inspect.getsource(mle.cli)
    assert "'Gemini'" in source or '"Gemini"' in source


