def test_query_with_function_call(model_instance, dummy_gemini):
    # Setup dummy function call and responses
    fn_call = DummyFunctionCall(name="search", args={"query": "test"})
    part_with_fn = DummyPart(text="Function call text", function_call=fn_call)
    part_response = DummyPart(text="Final response", function_call=None)
    dummy_gemini.GenerativeModel = lambda model: DummyGenerativeModel(model)
    chat_handler = DummyChatHandler([part_with_fn, part_response])
