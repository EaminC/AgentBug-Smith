import builtins
from unittest.mock import patch, MagicMock

import mle.model.gemini as gemini_module


class DummyFunctionCall:
    def __init__(self, name, args):
        self.name = name
        self.args = args


class DummyPart:
    def __init__(self, text, function_call=None):
        self.text = text
        self.function_call = function_call


class DummyChatHandler:
    def __init__(self, parts):
        self.parts = parts
        self.send_message_calls = []

    def send_message(self, content, **kwargs):
        self.send_message_calls.append((content, kwargs))
        # If content is a string, return first part text
        if isinstance(content, str):
            # Return a dummy completion object with parts attribute
            class Completion:
                def __init__(self, parts):
                    self.parts = parts
                    self.text = parts[-1].text if parts else ""
            return Completion(self.parts)
        # If content is a gemini Content object (mocked as any object), return last part text
        else:
            class Completion:
                def __init__(self, parts):
                    self.parts = parts
                    self.text = parts[-1].text if parts else ""
            return Completion(self.parts)

    def start_chat(self, history):
        return self


class DummyGenerativeModel:
    def __init__(self, model):
        self.model = model
        self.chat_handler = None

    def start_chat(self, history):
        # Return a DummyChatHandler with some dummy parts
        if self.chat_handler:
            return self.chat_handler
        return DummyChatHandler([])


class DummyGemini:
    def __init__(self):
        self.protos = MagicMock()
        self.types = MagicMock()
        self.GenerativeModel = DummyGenerativeModel

    def configure(self, api_key):
        pass


