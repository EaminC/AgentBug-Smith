def test_stream_yields_text_chunks(model_instance, dummy_gemini):
    # Setup dummy stream generator yielding parts with text
    parts = [DummyPart(text=f"chunk{i}") for i in range(3)]

    def dummy_stream(*args, **kwargs):
        for part in parts:
            yield part

    dummy_gemini.GenerativeModel = lambda model: DummyGenerativeModel(model)
    chat_handler = DummyGenerativeModel(model_instance.model)
    chat_handler.start_chat = lambda history: MagicMock(send_message=dummy_stream)
    dummy_gemini.GenerativeModel = lambda model: chat_handler
    model_instance.gemini = dummy_gemini

    chat_history = [
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there!"},
    ]

    chunks = list(model_instance.stream(chat_history))
    assert len(chunks) == 3
    assert all(isinstance(chunk, str) for chunk in chunks)
    assert chunks == [f"chunk{i}" for i in range(3)]


