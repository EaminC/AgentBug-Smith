def test_map_chat_history_from_openai_maps_roles_and_content(model_instance):
    chat_history = [
        {"role": "system", "content": "System message"},
        {"role": "user", "content": "User message"},
        {"role": "assistant", "content": "Assistant message"},
    ]
    mapped = model_instance._map_chat_history_from_openai(chat_history)
    # Each item should have keys 'role' and 'parts'
    for item in mapped:
        assert "role" in item
        assert "parts" in item
    # Check mapping of roles
    assert mapped[0]["role"] == "model"
    assert mapped[0]["parts"] == "System message"
    assert mapped[1]["role"] == "user"
    assert mapped[1]["parts"] == "User message"
    assert mapped[2]["role"] == "model"
    assert mapped[2]["parts"] == "Assistant message"


def test_map_functions_from_openai_types(model_instance):
