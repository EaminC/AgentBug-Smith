def test_map_chat_history_from_openai(model_instance):
    input_history = [
        {"role": "system", "content": "system content"},
        {"role": "user", "content": "user content"},
        {"role": "assistant", "content": "assistant content"},
    ]
    mapped = model_instance._map_chat_history_from_openai(input_history)
    # Each dict should have keys "role" and "parts"
    for entry in mapped:
        assert "role" in entry
        assert "parts" in entry
    # Check mapping correctness
    assert mapped[0]["role"] == "model"
    assert mapped[0]["parts"] == "system content"
    assert mapped[1]["role"] == "user"
    assert mapped[1]["parts"] == "user content"
    assert mapped[2]["role"] == "model"
    assert mapped[2]["parts"] == "assistant content"


def test_map_functions_from_openai(model_instance):
    functions = [
        {
            "name": "func1",
            "description": "desc1",
            "parameters": {
                "type": "object",
                "properties": {
                    "param1": {"type": "string", "description": "desc param1"},
                    "param2": {"type": "integer", "description": "desc param2"},
                },
            },
        }
    ]
    tools = model_instance._map_functions_from_openai(functions)
    assert hasattr(tools, "function_declarations")
    assert len(tools.function_declarations) == 1
    fd = tools.function_declarations[0]
    assert fd.name == "func1"
    assert fd.description == "desc1"
    # parameters is a Schema object
    assert fd.parameters.type == model_instance.gemini.protos.Type.OBJECT
    assert "param1" in fd.parameters.properties
    assert "param2" in fd.parameters.properties


def test_mapping_response_format_from_openai(model_instance):
    assert model_instance._mapping_response_format_from_openai({"type": "json_object"}) == "application/json"
    assert model_instance._mapping_response_format_from_openai({"type": "text"}) is None
    assert model_instance._mapping_response_format_from_openai({}) is None


def test_query_without_functions(model_instance, dummy_gemini):
    # Setup dummy chat handler with parts without function calls
    parts = [DummyPart(text="response text")]
    chat_handler = DummyChatHandler(parts)
    dummy_gemini.GenerativeModel = lambda model: DummyGenerativeModel(model)
    dummy_gemini.GenerativeModel(model_instance.model).chat_handler = chat_handler
    model_instance.gemini = dummy_gemini

    chat_history = [
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there!"},
    ]
    # Run query, should return the text of last part
    result = model_instance.query(chat_history)
    assert isinstance(result, str)
    assert "response text" in result


def test_query_with_function_call(model_instance, dummy_gemini):
    # Setup dummy function call and responses
    fn_call = DummyFunctionCall(name="search", args={"query": "test"})
    part_with_fn = DummyPart(text="Function call text", function_call=fn_call)
    part_response = DummyPart(text="Final response", function_call=None)
    chat_handler = DummyChatHandler([part_with_fn, part_response])
    dummy_gemini.GenerativeModel = lambda model: DummyGenerativeModel(model)
    dummy_gemini.GenerativeModel(model_instance.model).chat_handler = chat_handler
    model_instance.gemini = dummy_gemini

    # Patch get_function to a dummy function that returns a fixed string
    # Patch also SEARCH_FUNCTIONS to include "search"
    with patch.object(gemini_module, "get_function", return_value=dummy_search_function), \
         patch.object(gemini_module, "SEARCH_FUNCTIONS", ["search"]):
        chat_history = [
            {"role": "user", "content": "Hello"},
            {"role": "assistant", "content": "Hi there!"},
        ]
        result = model_instance.query(chat_history, functions=[{"name": "search"}])
        assert isinstance(result, str)
        assert "Final response" in result


def test_stream_yields_text_chunks(model_instance, dummy_gemini):
    # Setup dummy stream generator yielding parts with text
    parts = [DummyPart(text=f"chunk{i}") for i in range(3)]

    def dummy_stream(*args, **kwargs):
        for part in parts:
            yield part

    dummy_gemini.GenerativeModel = lambda model: DummyGenerativeModel(model)
    chat_handler = DummyGenerativeModel(model_instance.model)
    chat_handler.start_chat = lambda history: MagicMock(send_message=dummy_stream)
    dummy_gemini.GenerativeModel = lambda model: chat_handler
    model_instance.gemini = dummy_gemini

    chat_history = [
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there!"},
    ]

    chunks = list(model_instance.stream(chat_history))
    assert len(chunks) == 3
    assert all(hasattr(chunk, "text") for chunk in chunks)
    assert [chunk.text for chunk in chunks] == [f"chunk{i}" for i in range(3)]


def test_init_raises_import_error(monkeypatch):
    # Patch importlib.util.find_spec to None to simulate missing dependency
    monkeypatch.setattr(importlib.util, "find_spec", lambda name: None)
    with pytest.raises(ImportError):
        gemini_module.GeminiModel(api_key="key", model="model")


def test_model_type_and_temperature(model_instance):
    assert model_instance.model_type == "Gemini"
    assert isinstance(model_instance.temperature, float)
    assert model_instance.temperature == 0.7


def test_map_chat_history_preserves_unknown_keys(model_instance):
    # Test that unknown keys are preserved as is
    input_history = [
        {"role": "user", "content": "hello", "extra": "value"},
    ]
    mapped = model_instance._map_chat_history_from_openai(input_history)
    assert "extra" in mapped[0]
    assert mapped[0]["extra"] == "value" or mapped[0].get("extra") == "value"


def test_map_functions_handles_unknown_type(model_instance):
    # Provide a function with unknown parameter type
    functions = [
        {
            "name": "func_unknown",
            "description": "desc",
            "parameters": {
                "type": "unknown_type",
                "properties": {
                    "param": {"type": "unknown_type", "description": "desc"},
                },
            },
        }
    ]
    tools = model_instance._map_functions_from_openai(functions)
    # The type should be TYPE_UNSPECIFIED for unknown types
    fd = tools.function_declarations[0]
    assert fd.parameters.type == model_instance.gemini.protos.Type.TYPE_UNSPECIFIED
    for prop in fd.parameters.properties.values():
        assert prop.type == model_instance.gemini.protos.Type.TYPE_UNSPECIFIED


