                self.function_response = function_response

        class FunctionResponse:
            def __init__(self, name=None, response=None):
                self.name = name
                self.response = response

        class Content:
            def __init__(self, parts=None):
                self.parts = parts or []

    class types:
        class GenerationConfig:
