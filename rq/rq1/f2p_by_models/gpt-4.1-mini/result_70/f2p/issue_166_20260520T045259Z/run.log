[32mFROM python:3.11-slim AS test_builder

# Set working directory
WORKDIR /app

# Copy entire repository into container
COPY . .

# Detect if src/ layout or tests import src.
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        echo "Detected src/ layout or tests import src."; \
        SRC_LAYOUT=1; \
    else \
        SRC_LAYOUT=0; \
    fi; \
    echo $SRC_LAYOUT > .src_layout_flag

# Upgrade pip, setuptools, wheel, install requirements, project and test dependencies conditionally
RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -f requirements.txt ]; then \
        if [ "$(cat .src_layout_flag)" = "1" ]; then \
            pip install -r requirements.txt; \
            pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
        else \
