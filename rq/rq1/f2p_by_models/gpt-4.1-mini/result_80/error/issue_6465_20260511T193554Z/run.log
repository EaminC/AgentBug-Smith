[32mimport dataclasses
import pytest
from langchain_core.messages import AIMessage
from langchain_core.tools import tool as dec_tool
from langgraph.graph import StateGraph, MessagesState, START, END
from langgraph.prebuilt import ToolNode
from langgraph.prebuilt.tool_node import ToolRuntime


@dataclasses.dataclass
class MyContext:
    some_info: str


@dec_tool
def get_info_error(rt: ToolRuntime[MyContext]):
    """This tool returns error."""
    return rt.context.some_info


@dec_tool
def get_info_ok_but_no_typechecking(rt: ToolRuntime):
    """This tool is ok, but lacks type checking."""
    return rt.context.some_info  # type: ignore


def test_tool_runtime_generic_type_argument_support():
    """
    This test verifies that a tool function accepting ToolRuntime with generic type arguments
    is correctly injected and executed within a ToolNode graph.

    Before the fix, this test should fail due to missing runtime injection.
    After the fix, the test should pass and return the expected context info.
    """
    builder = StateGraph(MessagesState, context_schema=MyContext)
    builder.add_node(
        "tool_node", ToolNode([get_info_ok_but_no_typechecking, get_info_error])
    )
    builder.add_edge(START, "tool_node")
    builder.add_edge("tool_node", END)
    graph = builder.compile()
    result = graph.invoke(
        {
            "messages": [
                AIMessage(
                    "_",
                    tool_calls=[
                        {"name": "get_info_ok_but_no_typechecking", "args": {}, "id": "1"},
                        {"name": "get_info_error", "args": {}, "id": "2"},
                    ],
                )
            ]
        },
        context=MyContext(some_info="this is info"),
    )
    # The last two messages should be ToolMessages with content from the context
    tool_messages = result["messages"][-2:]
    # The first tool call (no type checking) returns the context info
    assert tool_messages[0].content == "this is info"
    assert tool_messages[0].name == "get_info_ok_but_no_typechecking"
    assert tool_messages[0].tool_call_id == "1"
    # The second tool call (with generic ToolRuntime) returns the context info as well
    assert tool_messages[1].content == "this is info"
    assert tool_messages[1].name == "get_info_error"
    assert tool_messages[1].tool_call_id == "2"
    # Both messages should be of type 'tool' and have no error status
    assert all(m.type == "tool" for m in tool_messages)
    assert all(getattr(m, "status", None) is None for m in tool_messages)[0m
