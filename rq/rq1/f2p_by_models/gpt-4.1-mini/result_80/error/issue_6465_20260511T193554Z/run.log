[32mFROM python:3.11-slim as test_builder

# Set working directory
WORKDIR /app

# Copy entire repository to ensure all files, including injected tests, are available
COPY . .

# Upgrade pip, setuptools, wheel early to avoid import-time errors
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies and test tooling:
# The project uses pyproject.toml in ./libs/langgraph, no requirements.txt detected
# Use conditional logic to install dependencies for the langgraph library
RUN if [ -f "libs/langgraph/pyproject.toml" ]; then \
      pip install poetry && \
      poetry config virtualenvs.create false && \
      poetry install --no-interaction --no-ansi --directory libs/langgraph && \
      pip install -e libs/langgraph && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    else \
      pip install -e libs/langgraph && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# Set environment variables required for Forge API
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Run preflight to catch import errors early
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests using Makefile test target in libs/langgraph directory
RUN make -C libs/langgraph test

# Minimal runtime image
FROM python:3.11-slim as runtime

WORKDIR /app

# Copy only the langgraph library source and metadata for production
COPY libs/langgraph ./libs/langgraph

# Set environment variables required for Forge API
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel

# Install production dependencies only (using poetry if available)
RUN if [ -f "libs/langgraph/pyproject.toml" ]; then \
      pip install poetry && \
      poetry config virtualenvs.create false && \
      poetry install --no-dev --no-interaction --no-ansi --directory libs/langgraph; \
    else \
      pip install -e libs/langgraph; \
    fi

# Final command as per requirement
CMD ["/bin/bash"][0m
