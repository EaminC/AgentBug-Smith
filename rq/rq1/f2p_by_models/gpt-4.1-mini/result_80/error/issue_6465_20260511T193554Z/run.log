# --- end inject ---

# Set working directory
WORKDIR /app

# Copy entire repository to ensure all files are available
COPY . .

# Upgrade pip, setuptools, wheel early to avoid import-time errors
RUN python -m pip install --upgrade pip setuptools wheel

# Install main python package from libs/langgraph in editable mode plus missing dependencies found in test errors
# Also install test dependencies explicitly
RUN pip install --no-cache-dir \
    "psycopg[binary]" \
    redis \
    dataclasses-json \
    pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm \
    && pip install -e libs/langgraph

# Set Forge API environment variables for OpenAI-compatible and Anthropic-compatible SDKs
