[32mimport dataclasses
import pytest
from langchain_core.messages import AIMessage
from langgraph.prebuilt.tool_node import ToolNode, ToolRuntime
from langchain_core.tools import tool as dec_tool


@dataclasses.dataclass
class MyContext:
    some_info: str


@dec_tool
def get_info(rt: ToolRuntime[MyContext]):
    """This tool returns info from context."""
    return rt.context.some_info


@pytest.mark.anyio
async def test_tool_runtime_generic() -> None:
    """Test that ToolRuntime with generic type arguments is correctly injected."""

    # Create a mock runtime with context
    mock_runtime = ToolRuntime.__annotations__.get("context", None)
    # Instead of using ToolRuntime.__annotations__, create a mock runtime object manually
    class MockRuntime:
        context = MyContext(some_info="test_info")
        state = {"some_info": "test_info"}
        tool_call_id = "call_1"

    mock_runtime = MockRuntime()

    config = {"configurable": {"__pregel_runtime": mock_runtime}}

    result = await ToolNode([get_info]).ainvoke(
        {
            "messages": [
                AIMessage(
                    "call tool",
                    tool_calls=[
                        {
                            "name": "get_info",
                            "args": {},
                            "id": "call_1",
                        }
                    ],
                )
            ]
        },
        config=config,
    )

    tool_message = result["messages"][-1]
    assert tool_message.type == "tool"
    assert tool_message.content == "test_info"
    assert tool_message.tool_call_id == "call_1"[0m
