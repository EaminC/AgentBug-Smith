ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Copy entire repository contents
COPY . .

# Upgrade pip, setuptools and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies if requirements.txt exists, else try poetry if pyproject.toml and poetry.lock exist,
# else just install the repo editable
# Then install the repo in editable mode and always install test-related dependencies
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry && poetry install; \
    else \
        true; \
    fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# Preflight check to ensure all packages installed properly
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

# Reduce pytest warnings noise
ENV PYTEST_ADDOPTS="-p no:warnings"

CMD ["/bin/bash"]

