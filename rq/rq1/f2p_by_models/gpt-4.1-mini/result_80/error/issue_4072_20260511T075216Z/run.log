# --- end inject ---

# Set environment variables for Forge API compatibility
ENV FORGE_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Copy entire repo into container
COPY . .

# Upgrade pip and setuptools
RUN python -m pip install --upgrade pip setuptools wheel

# Install poetry and project dependencies using poetry if pyproject.toml and uv.lock exist
RUN set -eux; \
    if [ -f "pyproject.toml" ] && [ -f "uv.lock" ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm vcrpy; \
    else \
        pip install -e . && pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm vcrpy; \
    fi

# Verify installation
RUN python -c 'import pkg_resources, pytest, vcr; print("preflight ok")'

# Prevent pytest warnings in test runs
ENV PYTEST_ADDOPTS="-p no:warnings"

CMD ["/bin/bash"]

