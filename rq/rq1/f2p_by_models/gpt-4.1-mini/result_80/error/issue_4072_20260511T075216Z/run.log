# --- end inject ---

# Set Forge API environment variables for OpenAI and Anthropic SDK compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Copy entire repository contents
COPY . .

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies for building Python packages (if needed)
RUN apt-get update && apt-get install -y gcc libxml2-dev libxslt1-dev python3-dev git && rm -rf /var/lib/apt/lists/*

# Install dependencies
# If requirements.txt exists, install from it
# Else if pyproject.toml and poetry.lock exist, install poetry and use poetry install
# Else skip to avoid errors
# Then install the repo in editable mode
# Always install test dependencies including vcrpy which was missing
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry && poetry install; \
    else \
        true; \
    fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm vcrpy

# Preflight check to confirm packages installed correctly
RUN python -c "import pkg_resources, pytest, vcr; print('preflight ok')"

# Reduce pytest warning noise
ENV PYTEST_ADDOPTS="-p no:warnings"

CMD ["/bin/bash"]

