# Install pnpm globally, install project dependencies using pnpm, then build
# Use conditional logic: if pnpm lockfile exists, prefer pnpm install
RUN npm install -g pnpm && \
    if [ -f "pnpm-lock.yaml" ]; then \
      pnpm install && pnpm run build; \
    elif [ -f "package-lock.json" ]; then \
      npm ci && npm run build; \
    else \
      npm install && npm run build; \
    fi

# Install test tooling if not installed (jest, types)
