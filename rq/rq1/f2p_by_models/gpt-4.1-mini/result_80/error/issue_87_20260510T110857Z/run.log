WORKDIR /app

# Copy entire repository into the container
COPY . .

# Install dependencies using preferred package manager: pnpm if lockfile exists, then npm ci, otherwise npm install
RUN if [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm && pnpm install && pnpm run build; \
    elif [ -f "package-lock.json" ]; then \
      npm ci && npm run build; \
    else \
      npm install && npm run build; \
    fi

# Install test dependencies explicitly to ensure test framework availability
RUN npm install --save-dev jest @types/jest ts-jest || true

# Validate TypeScript and Jest availability with a preflight check
RUN node -e "require('typescript'); require('jest'); console.log('preflight ok')" || true

# Expose default port just in case
EXPOSE 3141

# Default command to keep container alive with interactive shell
CMD ["/bin/bash"]

