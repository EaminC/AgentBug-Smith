ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set working directory
WORKDIR /app

# Copy the entire repository to the container
COPY . .

# Install dependencies using pnpm if pnpm-lock.yaml exists
RUN if [ -f "pnpm-lock.yaml" ]; then \
  npm install -g pnpm && pnpm install && pnpm run build; \
  else \
  npm install && npm run build; \
  fi

# Install test dependencies
RUN npm install --save-dev jest ts-jest @types/jest || true

# Preflight check for TypeScript and Jest
RUN node -e "require('typescript'); require('jest'); console.log('preflight ok')" || true

# Expose port 3141
EXPOSE 3141

# Default command
CMD ["/bin/bash"]

