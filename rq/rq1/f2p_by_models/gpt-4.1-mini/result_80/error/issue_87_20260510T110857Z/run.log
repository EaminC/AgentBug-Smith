[32m# Use official Node.js 20 slim base image for build/test stage
FROM node:20-slim AS test_builder

# Set working directory
WORKDIR /app

# Copy entire repository for build and tests (critical for injected tests)
COPY . .

# Install all dependencies including dev dependencies and build the project
RUN if [ -f "package.json" ]; then \
      npm install; \
      npm run build; \
    fi

# Run preflight check to verify core modules and test framework installation
RUN node -e 'require("typescript"); require("jest"); console.log("preflight ok")'

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Install test dependencies unconditionally to avoid test failures
RUN npm install --save-dev jest @types/jest ts-jest

# Run tests (assumption: test script defined in package.json runs jest)
RUN npm test

# Use official Node.js 20 slim base image for production stage
FROM node:20-slim AS runtime

WORKDIR /app

# Copy only production dependencies and built files from build stage
COPY --from=test_builder /app/package.json ./package.json
COPY --from=test_builder /app/package-lock.json ./package-lock.json
COPY --from=test_builder /app/dist ./dist
COPY --from=test_builder /app/node_modules ./node_modules

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Expose default port 3141 as per inferred from README dev command output
EXPOSE 3141

# Default command to run a bash shell
CMD ["/bin/bash"][0m
