# Additional environment variables from project .env for completeness
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"
ENV AI_STOP_SEQUENCES=""
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"

# Set work directory inside container
WORKDIR /app

# Copy the entire repository into the container
COPY . .

# Install pnpm globally if pnpm-lock.yaml exists, then install dependencies and build
RUN if [ -f "pnpm-lock.yaml" ]; then \
    npm install -g pnpm && \
    pnpm install && \
    pnpm run build || true; \
else \
    npm install && \
    npm run build || true; \
fi

# Ensure jest and ts-jest are installed for testing
RUN if [ -f "pnpm-lock.yaml" ]; then \
      pnpm add --save-dev jest ts-jest @types/jest || true; \
    else \
      npm install --save-dev jest ts-jest @types/jest || true; \
    fi

# Preflight check for TypeScript and jest availability
RUN node -e "require('typescript'); require('jest'); console.log('preflight ok');" || true

EXPOSE 3141

# Use bash as the default container command for testing environment
CMD ["/bin/bash"]

