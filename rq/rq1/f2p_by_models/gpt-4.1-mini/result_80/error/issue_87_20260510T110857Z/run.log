ENV OPENAI_API_KEY="$FORGE_API_KEY"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="$FORGE_API_KEY"

# Set working directory
WORKDIR /app

# Copy the entire repository
COPY . .

# Install dependencies and build
RUN if [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm && \
      pnpm install && \
      pnpm run build || true; \
    elif [ -f "package-lock.json" ]; then \
      npm ci && \
      npm run build || true; \
    elif [ -f "yarn.lock" ]; then \
      yarn install && \
      yarn build || true; \
    else \
      npm install && \
      npm run build || true; \
    fi

# Install standard test tooling if not present
RUN if [ -f "pnpm-lock.yaml" ]; then \
      pnpm add -w --save-dev jest ts-jest @types/jest; \
    elif [ -f "package-lock.json" ]; then \
      npm install --save-dev jest ts-jest @types/jest; \
    elif [ -f "yarn.lock" ]; then \
      yarn add --dev jest ts-jest @types/jest; \
    else \
      npm install --save-dev jest ts-jest @types/jest; \
    fi

# Preflight to verify jest is installed
RUN node -e "require('jest'); console.log('preflight ok');"

# Expose optional port (if any service listens)
EXPOSE 3141

# Default command for interactive bash shell
CMD ["/bin/bash"]

