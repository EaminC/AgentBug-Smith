# --- end inject ---

# --- Inject project environment variables for Forge API compatibility ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"
ENV AI_STOP_SEQUENCES=""
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"

# Forge API env var overrides for OpenAI and Anthropic compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"

# Set working directory inside container
WORKDIR /app

# Copy all project files into container
COPY . .

# Install pnpm globally, install dependencies, and build project
RUN npm install -g pnpm && \
    pnpm install && \
    pnpm run build || true

# Install jest and ts-jest for testing as dev dependencies
RUN pnpm add --save-dev jest ts-jest @types/jest

# Preflight check to verify TypeScript and jest availability
RUN node -e "require('typescript'); require('jest'); console.log('preflight ok');"

# Expose default port if applicable (optional)
EXPOSE 3141

# Use bash as the default command for container
CMD ["/bin/bash"]

# branch: node/package.json with pnpm and Forge API env variables, TypeScript build and Jest test deps installed
