# Preflight check for typescript and jest availability
RUN node -e "require('typescript'); require('jest'); console.log('preflight ok')" || true

# Expose port 3141 (kept from prior Dockerfile)
EXPOSE 3141

# Default CMD to keep container open in bash shell as per requirements
CMD ["/bin/bash"]

