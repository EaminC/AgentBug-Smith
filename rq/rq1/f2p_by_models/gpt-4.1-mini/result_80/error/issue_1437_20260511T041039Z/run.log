# --- end inject ---

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    FORGE_API_KEY=forge-key \
    FORGE_BASE_URL=https://api.forge.tensorblock.co/v1 \
    MODEL=tensorblock/gpt-4.1-mini \
    AI_TEMPERATURE=0.7 \
    GITHUB_TOKEN=ghp_key \
    TAVILY_API_KEY=tvly-key \
    ANTHROPIC_MODEL=tensorblock/gpt-4.1-mini \
    ANTHROPIC_SMALL_FAST_MODEL=tensorblock/gpt-4.1-mini

WORKDIR /app

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies commonly needed for Python projects
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    libffi-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy the entire repository
COPY . .

# Install Python dependencies and the project itself with robust logic for pyproject.toml + poetry.lock
RUN set -eux; \
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt && pip install -e .; \
    elif [ -f "poetry.lock" ] && [ -f "pyproject.toml" ]; then \
        pip install poetry && poetry config virtualenvs.create false && poetry install; \
    elif [ -f "pyproject.toml" ]; then \
        pip install -e .; \
    else \
        echo "No requirements.txt or pyproject.toml detected, skipping dependency install"; \
    fi; \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# Preflight check to catch missing dependencies early
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

