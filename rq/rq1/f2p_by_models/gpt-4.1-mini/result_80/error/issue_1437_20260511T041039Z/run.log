    fi && \
    pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# Verify installation integrity
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

# Entrypoint
CMD ["/bin/bash"]

