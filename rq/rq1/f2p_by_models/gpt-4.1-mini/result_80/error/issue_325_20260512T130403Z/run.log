# Install test dependencies and litellm
RUN set -eux; \
    python -m pip install --upgrade pip setuptools==81.0.0 wheel; \
    if [ -f requirements.txt ]; then pip install -r requirements.txt; fi; \
    pip install -e .; \
    pip install pytest==7.3.1 pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio litellm

# Run a simple import test only for packages that actually exist and do not error
RUN python -c 'import pytest; import litellm; print("preflight ok")'

# Default command to open bash shell
CMD ["/bin/bash"]

