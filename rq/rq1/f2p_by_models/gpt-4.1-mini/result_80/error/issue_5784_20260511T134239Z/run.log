[32mimport pytest
from typing import TypedDict, NotRequired, Sequence
from langchain_core.messages import BaseMessage
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


def test_agent_state_optional_fields_behavior() -> None:
    # AgentState should allow missing 'remaining_steps' and 'is_last_step' keys without error
    # This test verifies that the state dict can omit these keys and still be accepted
    # Before the fix, these keys were required and missing them would cause errors

    # Minimal valid state with only 'messages'
    minimal_state = {
        "messages": [BaseMessage(content="hello", type="human")]
    }

    # State with 'remaining_steps' and 'is_last_step' explicitly set
    full_state = {
        "messages": [BaseMessage(content="hello", type="human")],
        "remaining_steps": 3,
        "is_last_step": True,
    }

    # State with 'remaining_steps' only
    remaining_only_state = {
        "messages": [BaseMessage(content="hello", type="human")],
        "remaining_steps": 1,
    }

    # State with 'is_last_step' only
    is_last_only_state = {
        "messages": [BaseMessage(content="hello", type="human")],
        "is_last_step": False,
    }

    # The create_react_agent function uses _get_state_value internally,
    # which should handle missing optional keys gracefully.

    # We test that the internal logic that checks for stopping condition
    # does not raise KeyError or similar when optional keys are missing.

    # We will call the internal stopping condition function indirectly by
    # invoking create_react_agent and then calling the stopping condition.

    # Create a dummy agent with a simple model that returns a fixed output
    def dummy_model(messages):
        return "dummy output"

    # Create the agent with default parameters
    agent = create_react_agent(dummy_model)

    # Access the stopping condition function (private, but for test)
    stopping_condition = agent._is_done

    # It should accept all these states without error and return a bool
    for state in [
        minimal_state,
        full_state,
        remaining_only_state,
        is_last_only_state,
    ]:
        result = stopping_condition(state)
        assert isinstance(result, bool), "Stopping condition must return bool"

    # Additionally, test that the agent state TypedDict allows missing keys
    # by creating instances and verifying no KeyError on access with defaults
    # This is more of a static typing check but can be runtime checked by dict access

    # Access keys with dict.get to simulate optional behavior
    for state in [
        minimal_state,
        full_state,
        remaining_only_state,
        is_last_only_state,
    ]:
        remaining = state.get("remaining_steps", None)
        is_last = state.get("is_last_step", False)
        assert (remaining is None or isinstance(remaining, int))
        assert isinstance(is_last, bool)

# This test should fail before the patch because the TypedDict requires these keys,
# and the internal logic expects them to be present, causing errors.
# After the patch, the keys are NotRequired, and the logic handles missing keys gracefully,
# so the test should pass.[0m
