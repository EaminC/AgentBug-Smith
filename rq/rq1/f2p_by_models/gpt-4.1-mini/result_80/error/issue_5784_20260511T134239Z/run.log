[32mimport pytest
from typing import TypedDict, NotRequired, Sequence

from langchain_core.messages import BaseMessage
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


class DummyMessage(BaseMessage):
    content: str
    type: str = "dummy"


def test_agent_state_optional_fields_behavior():
    # AgentState should allow missing 'remaining_steps' and 'is_last_step' fields without error
    # This test verifies that the TypedDict fields marked as NotRequired behave as optional.

    # Compose a minimal valid AgentState with only required 'messages'
    minimal_state: AgentState = {
        "messages": [DummyMessage(content="Hello")]
        # 'remaining_steps' and 'is_last_step' omitted intentionally
    }

    # The following should not raise KeyError or TypeError
    # but the buggy codebase may treat them as required and fail
    assert "messages" in minimal_state
    assert isinstance(minimal_state["messages"], Sequence)

    # Now test with 'remaining_steps' present
    state_with_remaining: AgentState = {
        "messages": [DummyMessage(content="Hello")],
        "remaining_steps": 5,
    }
    assert state_with_remaining["remaining_steps"] == 5

    # Now test with 'is_last_step' present
    # Since 'is_last_step' is NotRequired, it may not be present in AgentState TypedDict,
    # but the Pydantic model or runtime may accept it optionally.
    # So we test that adding it does not cause errors.
    # We cast to dict to bypass TypedDict static checks for test purposes.
    state_with_is_last = dict(minimal_state)
    state_with_is_last["is_last_step"] = True
    assert state_with_is_last["is_last_step"] is True


def test_create_react_agent_completion_behavior():
    # This test exercises the create_react_agent function's _should_finish logic,
    # which depends on optional 'remaining_steps' and 'is_last_step' fields.
    # The buggy code treats 'is_last_step' as required and may fail if missing.
    # The fix marks them as NotRequired, so missing fields should be handled gracefully.

    # Import the internal _should_finish function via the returned agent object
