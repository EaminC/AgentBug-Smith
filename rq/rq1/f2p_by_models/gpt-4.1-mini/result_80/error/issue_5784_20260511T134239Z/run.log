from typing import TypedDict, NotRequired, Sequence

from langchain_core.messages import BaseMessage
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


class DummyMessage(BaseMessage):
    content: str
    type: str = "dummy"


def test_agent_state_optional_fields_behavior():
    # AgentState should accept 'messages' as required and 'remaining_steps' as optional
    # Before fix, 'remaining_steps' is required, so omitting it should raise TypeError
    # After fix, 'remaining_steps' is NotRequired, so omitting it should be allowed

    # Construct valid messages list
    messages: Sequence[BaseMessage] = [DummyMessage(content="Hello")]

    # Case 1: Provide all fields including remaining_steps
    state_full: AgentState = {
        "messages": messages,
        "remaining_steps": 5,
    }
    assert "remaining_steps" in state_full

    # Case 2: Omit remaining_steps
    # Before fix: this should raise a TypeError due to missing required field
    # After fix: this should be allowed
    try:
        state_partial: AgentState = {
            "messages": messages,
            # 'remaining_steps' omitted intentionally
        }  # type: ignore
    except TypeError:
        # This is expected behavior in buggy code
        pass
    else:
        # If no error, then the fix is applied
        assert "remaining_steps" not in state_partial


