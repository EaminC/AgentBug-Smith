[32mimport pytest
from typing import TypedDict, NotRequired, Sequence
from langchain_core.messages import BaseMessage
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


class DummyMessage(BaseMessage):
    content: str
    type: str = "dummy"


def test_agent_state_optional_fields_behavior():
    # AgentState should allow missing 'remaining_steps' and 'is_last_step' keys without error
    # This test verifies that the TypedDict fields marked as NotRequired behave as optional keys

    # Construct a minimal valid AgentState dict with only required 'messages' key
    minimal_state = {
        "messages": [DummyMessage(content="Hello")]
        # 'remaining_steps' and 'is_last_step' omitted intentionally
    }

    # The following should not raise KeyError or TypeError when passed to create_react_agent internals
    # We test the internal _is_done function indirectly by calling create_react_agent and simulating state

    # We will simulate the _is_done function logic by calling the internal function via create_react_agent
    # Since _is_done is nested, we replicate the logic here for test purposes

    # Import the internal _get_state_value function from the module to test behavior
    from langgraph.prebuilt.chat_agent_executor import _get_state_value

    # _get_state_value should return None or default values for missing keys
    remaining_steps = _get_state_value(minimal_state, "remaining_steps", None)
    is_last_step = _get_state_value(minimal_state, "is_last_step", False)

    # Assert that missing keys return the default values
    assert remaining_steps is None
    assert is_last_step is False

    # Now test the _is_done logic from create_react_agent with various states

    # We replicate the logic here for clarity:
    def is_done(state: AgentState) -> bool:
        has_tool_calls = False  # Simplified for test; no tool calls
        all_tools_return_direct = True  # Simplified for test

        remaining_steps = _get_state_value(state, "remaining_steps", None)
        is_last_step = _get_state_value(state, "is_last_step", False)

        if remaining_steps is not None:
            if remaining_steps < 1 and all_tools_return_direct:
                return True
            elif remaining_steps < 2 and has_tool_calls:
                return True

        return False

    # Case 1: minimal_state with no remaining_steps or is_last_step
    assert is_done(minimal_state) is False

    # Case 2: state with remaining_steps = 0, should be done
    state_with_remaining = {
        "messages": [DummyMessage(content="Hi")],
        "remaining_steps": 0,
    }
    assert is_done(state_with_remaining) is True

    # Case 3: state with remaining_steps = 1, no tool calls, should not be done
    state_remaining_one = {
        "messages": [DummyMessage(content="Hi")],
        "remaining_steps": 1,
    }
    assert is_done(state_remaining_one) is False

    # Case 4: state with is_last_step True but no remaining_steps, should not be done (per logic)
    state_is_last_step = {
        "messages": [DummyMessage(content="Hi")],
        "is_last_step": True,
    }
    assert is_done(state_is_last_step) is False

    # Case 5: state with remaining_steps < 1 and all_tools_return_direct True, done
    state_remaining_neg = {
        "messages": [DummyMessage(content="Hi")],
        "remaining_steps": -1,
    }
    assert is_done(state_remaining_neg) is True


def test_agent_state_type_enforcement():
    # This test verifies that AgentState TypedDict enforces 'messages' key as required
    # and 'remaining_steps' and 'is_last_step' as optional (NotRequired)

    # Missing 'messages' key should raise a TypeError when type checking or runtime check
    # Since TypedDict does not enforce at runtime, we simulate by checking dict keys

    valid_state = {
        "messages": [DummyMessage(content="msg")],
    }

    # 'remaining_steps' and 'is_last_step' optional, so no error if missing
    assert "remaining_steps" not in valid_state
    assert "is_last_step" not in valid_state

    # 'messages' key must be present
    assert "messages" in valid_state

    # Adding optional keys should be accepted
    valid_state["remaining_steps"] = 5
    valid_state["is_last_step"] = True

    assert valid_state["remaining_steps"] == 5
    assert valid_state["is_last_step"] is True


@pytest.mark.parametrize(
    "state_dict, expected_remaining_steps, expected_is_last_step",
    [
        ({"messages": [DummyMessage(content="x")]}, None, False),
        ({"messages": [DummyMessage(content="x")], "remaining_steps": 3}, 3, False),
        ({"messages": [DummyMessage(content="x")], "is_last_step": True}, None, True),
        (
            {"messages": [DummyMessage(content="x")], "remaining_steps": 0, "is_last_step": True},
            0,
            True,
        ),
    ],
)
def test_get_state_value_behavior(state_dict, expected_remaining_steps, expected_is_last_step):
    from langgraph.prebuilt.chat_agent_executor import _get_state_value

    remaining_steps = _get_state_value(state_dict, "remaining_steps", None)
    is_last_step = _get_state_value(state_dict, "is_last_step", False)

    assert remaining_steps == expected_remaining_steps
    assert is_last_step == expected_is_last_step[0m
