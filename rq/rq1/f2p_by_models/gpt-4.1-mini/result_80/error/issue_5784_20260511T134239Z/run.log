[32mimport pytest
from typing import TypedDict, NotRequired, Sequence
from langchain_core.messages import BaseMessage
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


def test_agentstate_optional_fields_behavior() -> None:
    # AgentState should allow missing 'remaining_steps' and 'is_last_step' keys without error
    # This test checks that the TypedDict definition with NotRequired fields behaves as expected

    # Prepare a minimal valid state with only 'messages' key
    minimal_state = AgentState(messages=[BaseMessage(content="Hello", type="human")])

    # The following should NOT raise KeyError or TypeError because fields are NotRequired
    # Accessing missing optional fields should be handled gracefully in create_react_agent logic

    # The create_react_agent function returns a callable; we test its internal logic indirectly
    # We'll test the internal _should_stop function behavior by simulating calls with various states

    # Import the internal function _should_stop from the module (it's nested, so we access via create_react_agent closure)
    # We extract the function by creating an agent and getting the function attribute

    agent = create_react_agent(
        tools=[],
        llm=None,
        pre_model_hook=None,
        post_model_hook=None,
        runtime=None,
    )

    # The agent callable has an attribute _should_stop; test it with different states

    # State with no 'remaining_steps' and no 'is_last_step' (both optional)
    state_no_optional = {"messages": [BaseMessage(content="Hi", type="human")]}
    # The _should_stop function expects a dict with keys, so test it
    # We expect it to return False because no stopping conditions met
    assert agent._should_stop(state_no_optional) is False

    # State with 'remaining_steps' set to 0 and no 'is_last_step'
    state_remaining_zero = {
        "messages": [BaseMessage(content="Hi", type="human")],
        "remaining_steps": 0,
    }
    # Should stop because remaining_steps < 1 and no tools (all_tools_return_direct assumed True)
    assert agent._should_stop(state_remaining_zero) is True

    # State with 'remaining_steps' set to 1 and 'is_last_step' True
    state_remaining_one_last = {
        "messages": [BaseMessage(content="Hi", type="human")],
        "remaining_steps": 1,
        "is_last_step": True,
    }
    # Should not stop because remaining_steps not < 1 and no tools
    assert agent._should_stop(state_remaining_one_last) is False

    # State with 'remaining_steps' set to 1 and 'is_last_step' False
    state_remaining_one_not_last = {
        "messages": [BaseMessage(content="Hi", type="human")],
        "remaining_steps": 1,
        "is_last_step": False,
    }
    assert agent._should_stop(state_remaining_one_not_last) is False

    # State with 'remaining_steps' missing but 'is_last_step' True and has tool calls
    state_last_step_with_tools = {
        "messages": [BaseMessage(content="Hi", type="human")],
        "is_last_step": True,
        "agent_outcome": {"tool": "foo", "tool_input": "bar", "log": "log"},
    }
    # The _should_stop logic does not consider 'agent_outcome' here, so it should return False
    assert agent._should_stop(state_last_step_with_tools) is False


@pytest.mark.parametrize(
    "state_dict,expected",
    [
        (
            {"messages": [BaseMessage(content="Hi", type="human")]},
            False,
        ),
        (
            {"messages": [BaseMessage(content="Hi", type="human")], "remaining_steps": 0},
            True,
        ),
        (
            {"messages": [BaseMessage(content="Hi", type="human")], "remaining_steps": 1},
            False,
        ),
        (
            {
                "messages": [BaseMessage(content="Hi", type="human")],
                "remaining_steps": 1,
                "is_last_step": True,
            },
            False,
        ),
    ],
)
def test_should_stop_various_states(state_dict, expected):
    agent = create_react_agent(
        tools=[],
        llm=None,
        pre_model_hook=None,
        post_model_hook=None,
        runtime=None,
    )
    assert agent._should_stop(state_dict) is expected[0m
