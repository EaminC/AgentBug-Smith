    type: str


def test_agent_state_optional_fields_behavior() -> None:
    # AgentState should allow 'remaining_steps' as optional field (NotRequired)
    # and 'is_last_step' is not present in AgentState TypedDict (buggy) but
    # is handled in code as optional managed value.
    # This test verifies that creating a react agent with state missing these
    # optional fields does not raise KeyError or validation error after fix.

    # Prepare a minimal valid state with only required 'messages' field
    state: AgentState = {
        "messages": [
            {"content": "Hello", "type": "human"},
            {"content": "Hi, how can I help?", "type": "ai"},
        ]
        # 'remaining_steps' and 'is_last_step' are omitted intentionally
    }

    # The create_react_agent function returns a callable agent function
    # that uses the state internally. We test that it accepts the state
    # without optional fields and runs without error.

    agent = create_react_agent()

    # Call the agent with the minimal state and check it returns a boolean
    # indicating whether to stop or continue (True/False).
    # The exact logic changed in the fix, so we check for no exceptions and
    # that the return type is bool.

    result = agent(state)
    assert isinstance(result, bool)

    # Also test with 'remaining_steps' present but 'is_last_step' omitted
    state_with_remaining: AgentState = {
        "messages": [
            {"content": "Hello again", "type": "human"},
            {"content": "What can I do for you?", "type": "ai"},
        ],
        "remaining_steps": 0,
    }
    result2 = agent(state_with_remaining)
    assert isinstance(result2, bool)

    # Test with both 'remaining_steps' and 'is_last_step' present (simulate managed)
    # Since 'is_last_step' is not declared in AgentState TypedDict, we cast to Any
    state_full: Any = {
        "messages": [
            {"content": "Final message", "type": "human"},
            {"content": "Goodbye!", "type": "ai"},
        ],
        "remaining_steps": 1,
        "is_last_step": True,
    }
    result3 = agent(state_full)
    assert isinstance(result3, bool)


