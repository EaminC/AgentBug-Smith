    pip install -r requirements.txt; \
    fi && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm bs4 mkdocs nbformat psycopg[binary] aiosqlite langchain-core dataclasses-json

# Install editable libs that exist under libs/
RUN pip install -e libs/checkpoint || true && \
    pip install -e libs/checkpoint-postgres || true && \
    pip install -e libs/checkpoint-sqlite || true && \
    pip install -e libs/prebuilt || true && \
    pip install -e libs/langgraph || true && \
    pip install -e libs/sdk-py || true && \
    pip install -e libs/cli || true

# No root project edit install because no setup.py/pyproject.toml at root

# Sanity check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

