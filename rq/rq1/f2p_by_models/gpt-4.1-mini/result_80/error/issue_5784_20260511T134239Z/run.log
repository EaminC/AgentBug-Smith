from typing import TypedDict, NotRequired, Sequence
from langchain_core.messages import BaseMessage
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


class DummyMessage(BaseMessage):
    content: str
    type: str = "dummy"


def test_agent_state_optional_fields_behavior():
    # AgentState should allow missing is_last_step and remaining_steps keys due to NotRequired
    # This test verifies that code consuming AgentState behaves correctly when those keys are missing.

    # Compose a minimal valid AgentState dict with only messages
    state_minimal = AgentState(messages=[DummyMessage(content="hello")])

    # Compose a full AgentState dict with all fields
    state_full = AgentState(
        messages=[DummyMessage(content="hello")],
        remaining_steps=3,
    )

    # The buggy code treats is_last_step and remaining_steps as required,
    # so passing state_minimal (missing those keys) should cause an error or assertion failure.
    # After the fix, it should accept state_minimal without error.

    # We test the internal logic of create_react_agent's _is_done function indirectly
    # by calling the function that uses _get_state_value on these states.

    # We simulate the _is_done function from create_react_agent with minimal inputs
    # to check if it handles missing keys gracefully.

    # Import the internal _is_done function indirectly by creating an agent and calling it
    # We patch the pre_model_hook and other parameters to None or defaults.

    # Create a dummy agent with minimal parameters to access _is_done
    agent = create_react_agent(
        llm=None,
        tools=[],
        pre_model_hook=None,
        post_model_hook=None,
        max_steps=5,
        early_stopping=True,
        runtime=None,
        runtime_kwargs=None,
    )

    # The agent returned is a RunnableCallable with _is_done as a nested function.
    # We extract _is_done from the closure of the agent's __call__ method.

    # The agent is a RunnableCallable wrapping a function with closure variables.
    # We find _is_done in the closure variables.

    # This is a bit hacky but necessary for testing the internal logic.

    # Extract _is_done function from agent closure
    _is_done = None
    for cell in agent.__call__.__closure__ or []:
        if callable(cell.cell_contents) and cell.cell_contents.__name__ == "_is_done":
            _is_done = cell.cell_contents
            break
    assert _is_done is not None, "Could not find _is_done function in agent closure"

    # Test with full state (should return False because remaining_steps=3)
    done_full = _is_done(state_full)
    assert done_full is False

    # Test with minimal state (missing remaining_steps and is_last_step)
    # Buggy code expects these keys, so this should raise KeyError or TypeError before fix
    # After fix, it should return False gracefully.
    try:
        done_minimal = _is_done(state_minimal)
    except Exception as e:
        # On buggy code, expect an exception due to missing keys
        # We assert that exception is raised here to confirm buggy behavior
        assert isinstance(e, (KeyError, TypeError)), f"Unexpected exception type: {type(e)}"
    else:
        # On fixed code, no exception, should return False
        assert done_minimal is False


def test_agent_state_pydantic_optional_fields():
    # Test that AgentStatePydantic accepts missing is_last_step and remaining_steps fields

    from langgraph.prebuilt.chat_agent_executor import AgentStatePydantic

    # Create instance with only messages
    instance_minimal = AgentStatePydantic(messages=[DummyMessage(content="hi")])
    assert instance_minimal.messages[0].content == "hi"
    assert instance_minimal.remaining_steps is None
    assert instance_minimal.is_last_step is None

    # Create instance with all fields
    instance_full = AgentStatePydantic(
        messages=[DummyMessage(content="hi")],
        remaining_steps=10,
        is_last_step=True,
    )
    assert instance_full.remaining_steps == 10
    assert instance_full.is_last_step is True


@pytest.mark.parametrize(
    "state_dict, expected_remaining_steps, expected_is_last_step",
    [
        ({"messages": [DummyMessage(content="msg")]}, None, None),
        ({"messages": [DummyMessage(content="msg")], "remaining_steps": 5}, 5, None),
        ({"messages": [DummyMessage(content="msg")], "is_last_step": True}, None, True),
        (
            {
                "messages": [DummyMessage(content="msg")],
                "remaining_steps": 2,
                "is_last_step": False,
            },
            2,
            False,
        ),
    ],
)
def test_agent_state_dict_optional_fields(state_dict, expected_remaining_steps, expected_is_last_step):
    # Test that AgentState TypedDict accepts optional fields properly

    # This test will fail on buggy code if required keys are missing
    # After fix, it should pass.

    # We check that the dict can be assigned to AgentState type
    # and that the optional keys behave as expected.

    # Use AgentStatePydantic to validate and parse the dict
    from langgraph.prebuilt.chat_agent_executor import AgentStatePydantic

    # Create pydantic model instance
    model_instance = AgentStatePydantic(**state_dict)

    assert model_instance.remaining_steps == expected_remaining_steps
    assert model_instance.is_last_step == expected_is_last_step


