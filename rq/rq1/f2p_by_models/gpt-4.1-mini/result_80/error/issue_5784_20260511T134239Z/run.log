[32mimport pytest
from typing import TypedDict, NotRequired, Sequence
from langchain_core.messages import BaseMessage
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


class DummyMessage(BaseMessage):
    content: str
    type: str = "dummy"


def test_agent_state_optional_fields_behavior() -> None:
    # AgentState should allow missing is_last_step and remaining_steps keys
    # because they are NotRequired in the TypedDict.

    # Construct a minimal valid AgentState dict with only messages
    state_minimal: AgentState = {
        "messages": [DummyMessage(content="Hello")]
        # 'is_last_step' and 'remaining_steps' omitted intentionally
    }

    # The create_react_agent function internally uses _get_state_value to access
    # 'remaining_steps' and 'is_last_step' with default fallbacks, so it should
    # not raise KeyError for missing keys.

    # We test the internal logic that uses these fields by calling the
    # _should_stop function indirectly via create_react_agent's returned agent.

    # create_react_agent returns a callable agent function; we simulate a call
    # with the minimal state and check that it runs without error.

    agent = create_react_agent()

    # The agent function expects a state dict with 'messages' key at minimum.
    # It should handle missing 'remaining_steps' and 'is_last_step' gracefully.

    # We call the agent with the minimal state and assert no exceptions occur.
    try:
        # The agent callable expects a dict-like state
        result = agent(state_minimal)
    except Exception as e:
        pytest.fail(f"Agent raised an exception with minimal state: {e}")

    # Now test with 'remaining_steps' provided but 'is_last_step' missing
    state_with_remaining: AgentState = {
        "messages": [DummyMessage(content="Hello")],
        "remaining_steps": 0,
    }
    try:
        result = agent(state_with_remaining)
    except Exception as e:
        pytest.fail(f"Agent raised an exception with remaining_steps only: {e}")

    # Now test with both 'remaining_steps' and 'is_last_step' provided
    state_full: AgentState = {
        "messages": [DummyMessage(content="Hello")],
        "remaining_steps": 0,
        "is_last_step": True,
    }
    try:
        result = agent(state_full)
    except Exception as e:
        pytest.fail(f"Agent raised an exception with full state: {e}")

    # If no exceptions were raised, the test passes, confirming that the
    # optional fields are handled correctly as NotRequired in AgentState.


def test_agent_state_type_enforcement() -> None:
    # Test that AgentState enforces 'messages' key as required
    with pytest.raises(KeyError):
        # Missing 'messages' key should cause error when agent is called
        agent = create_react_agent()
        agent({})  # type: ignore

    # Test that 'messages' must be a sequence of BaseMessage
    agent = create_react_agent()
    with pytest.raises(TypeError):
        # Passing wrong type for messages should raise
        agent({"messages": "not a sequence"})  # type: ignore


@pytest.mark.parametrize(
    "state",
    [
        {"messages": [DummyMessage(content="Hi")]},
        {"messages": [DummyMessage(content="Hi")], "remaining_steps": 5},
        {"messages": [DummyMessage(content="Hi")], "is_last_step": True},
        {
            "messages": [DummyMessage(content="Hi")],
            "remaining_steps": 3,
            "is_last_step": False,
        },
    ],
)
def test_agent_state_accepts_various_combinations(state: dict) -> None:
    # Parametrized test to confirm AgentState accepts various optional field combos
    agent = create_react_agent()
    try:
        agent(state)  # type: ignore
    except Exception as e:
        pytest.fail(f"Agent raised exception with state {state}: {e}")[0m
