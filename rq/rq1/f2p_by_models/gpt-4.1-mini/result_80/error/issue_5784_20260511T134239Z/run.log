import pytest
from typing import TypedDict, NotRequired
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


class DummyBaseMessage(TypedDict):
    type: str
    content: str


def test_agent_state_optional_fields_behavior():
    """
    This test verifies that the AgentState TypedDict correctly treats
    'remaining_steps' as optional (NotRequired) and that the agent's
    logic for determining last step behaves correctly when these fields
    are missing or present.

    Before the fix, 'remaining_steps' and 'is_last_step' were required fields,
    so omitting them would cause validation or runtime errors.
    After the fix, they are NotRequired, so the agent should handle missing keys gracefully.
    """

    # Compose a minimal valid AgentState with only required 'messages' field
    minimal_state = {
        "messages": [{"type": "chat", "content": "Hello"}]
    }

    # Compose a state with remaining_steps present
    state_with_remaining = {
        "messages": [{"type": "chat", "content": "Hello"}],
        "remaining_steps": 0,
    }

    # Compose a state with remaining_steps and is_last_step present (simulate old required fields)
    state_full = {
        "messages": [{"type": "chat", "content": "Hello"}],
        "remaining_steps": 1,
        "is_last_step": True,
    }

    # The create_react_agent function returns an agent callable with an internal function
    # _should_stop_func that uses _get_state_value to check these keys.
    # We will test that _should_stop_func returns expected results for these states.

    # Create an agent instance with default parameters
    agent = create_react_agent()

    # Access the internal _should_stop_func method for testing
    should_stop = agent._should_stop_func

    # Test minimal state: missing remaining_steps and is_last_step
    # The agent should not stop (False) because remaining_steps is None and is_last_step is False by default
    assert should_stop(minimal_state) is False

    # Test state with remaining_steps = 0, no is_last_step key
    # According to the logic, remaining_steps < 1 and all_tools_return_direct True => should stop True
    # We simulate all_tools_return_direct True by patching _should_stop_func's closure or by providing keys
    # But since we cannot patch internal variables easily, we test the logic as is:
    # The logic returns True if remaining_steps < 1 and all_tools_return_direct (which is True)
    # So we expect True here.
    # However, the agent's _should_stop_func uses _get_state_value with default False for is_last_step,
    # so this should be True.
    assert should_stop(state_with_remaining) is True

    # Test full state with remaining_steps=1 and is_last_step=True
    # The logic returns False because remaining_steps is not < 1 and not < 2 with has_tool_calls True
    # But since has_tool_calls is False in the default call, it returns False.
    # So we expect False here.
    assert should_stop(state_full) is False


@pytest.mark.parametrize(
    "state,expected",
    [
        ({"messages": [{"type": "chat", "content": "Hi"}]}, False),
        ({"messages": [{"type": "chat", "content": "Hi"}], "remaining_steps": 0}, True),
        ({"messages": [{"type": "chat", "content": "Hi"}], "remaining_steps": 2}, False),
        ({"messages": [{"type": "chat", "content": "Hi"}], "remaining_steps": 1, "is_last_step": True}, False),
        ({"messages": [{"type": "chat", "content": "Hi"}], "remaining_steps": 0, "is_last_step": True}, True),
    ],
)
def test_agent_state_with_various_remaining_steps(state, expected):
    agent = create_react_agent()
    assert agent._should_stop_func(state) == expected[0m
