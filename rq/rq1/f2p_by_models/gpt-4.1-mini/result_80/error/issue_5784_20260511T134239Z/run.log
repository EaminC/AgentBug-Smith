[32mimport pytest
from typing import TypedDict, NotRequired, Sequence

from langchain_core.messages import BaseMessage
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


class DummyMessage(BaseMessage):
    content: str
    type: str = "dummy"


def test_agent_state_optional_fields_behavior() -> None:
    # AgentState should allow missing is_last_step and remaining_steps keys due to NotRequired

    # Construct a state dict with only messages (required)
    state_minimal: AgentState = {
        "messages": [DummyMessage(content="Hello")],
        # 'remaining_steps' and 'is_last_step' are omitted intentionally
    }

    # The create_react_agent function internally calls _get_state_value for these keys
    # We test that it does not raise KeyError and behaves as expected

    # We test the internal function _should_stop_react_agent from create_react_agent closure
    # To do this, we call create_react_agent and extract the function to test

    agent = create_react_agent()

    # Access the internal _should_stop_react_agent function (it's a closure inside create_react_agent)
    # Since it's nested, we simulate calling the function via the agent's method that uses it
    # The function is not exposed, so we test the public API behavior that depends on it

    # We simulate states with various combinations of optional fields

    # Case 1: minimal state with only messages
    # The function should return False (do not stop) because remaining_steps is None and is_last_step is False by default
    assert agent._should_stop_react_agent(state_minimal) is False

    # Case 2: remaining_steps present and less than 1, all_tools_return_direct True
    state_with_remaining = {
        "messages": [DummyMessage(content="Hi")],
        "remaining_steps": 0,
    }
    # We patch the all_tools_return_direct and has_tool_calls to True to trigger stop condition
    # Since _should_stop_react_agent uses these variables, we simulate by monkeypatching the function locally

    # We define a helper function to call the internal logic with controlled params
    def should_stop(state, all_tools_return_direct=True, has_tool_calls=True):
        # replicate the logic from create_react_agent._should_stop_react_agent
        remaining_steps = state.get("remaining_steps", None)
        if remaining_steps is not None:
            if remaining_steps < 1 and all_tools_return_direct:
                return True
            elif remaining_steps < 2 and has_tool_calls:
                return True
        return False

    assert should_stop(state_with_remaining) is True

    # Case 3: is_last_step present and True, remaining_steps None, has_tool_calls True
    state_with_is_last = {
        "messages": [DummyMessage(content="Hey")],
        "is_last_step": True,
    }
    # According to the old buggy logic, this would return True if remaining_steps is None and is_last_step True and has_tool_calls True
    # But the fixed logic ignores is_last_step if remaining_steps is None, so it returns False
    # We test the fixed logic here:
    assert should_stop(state_with_is_last, all_tools_return_direct=False, has_tool_calls=True) is False


def test_agent_state_typed_dict_fields() -> None:
    # Test that AgentState TypedDict marks remaining_steps as NotRequired
    # This means we can instantiate without these keys without type errors or runtime errors

    # Minimal valid state
    minimal_state: AgentState = {
        "messages": [DummyMessage(content="Test")],
    }

    # Should not raise KeyError when accessing optional keys
    assert "remaining_steps" not in minimal_state
    assert "is_last_step" not in minimal_state

    # Adding optional keys
    full_state: AgentState = {
        "messages": [DummyMessage(content="Test")],
        "remaining_steps": 5,
    }
    assert full_state["remaining_steps"] == 5


@pytest.mark.parametrize(
    "state,expected",
    [
        ({"messages": [DummyMessage(content="msg")]}, False),
        ({"messages": [DummyMessage(content="msg")], "remaining_steps": 0}, True),
        ({"messages": [DummyMessage(content="msg")], "remaining_steps": 1}, True),
        ({"messages": [DummyMessage(content="msg")], "remaining_steps": 2}, False),
        ({"messages": [DummyMessage(content="msg")], "is_last_step": True}, False),
    ],
)
def test_should_stop_react_agent_behavior(state, expected) -> None:
    # This test verifies the stop condition logic with various states

    def should_stop(state, all_tools_return_direct=True, has_tool_calls=True):
        remaining_steps = state.get("remaining_steps", None)
        if remaining_steps is not None:
            if remaining_steps < 1 and all_tools_return_direct:
                return True
            elif remaining_steps < 2 and has_tool_calls:
                return True
        return False

    result = should_stop(state)
    assert result == expected[0m
