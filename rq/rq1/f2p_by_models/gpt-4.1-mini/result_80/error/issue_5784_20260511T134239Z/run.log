[32mimport pytest
from typing import TypedDict, NotRequired, Sequence

from langchain_core.messages import BaseMessage
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


def test_agent_state_optional_fields_behavior() -> None:
    # AgentState should accept dicts without is_last_step and remaining_steps keys (optional)
    # This test verifies that the patched AgentState TypedDict marks these fields as NotRequired,
    # so missing keys do not cause validation errors.

    # Minimal valid state with only messages key
    minimal_state = {
        "messages": [
            {"type": "human", "content": "Hello", "role": "user"},
        ]
    }

    # State with is_last_step and remaining_steps explicitly set
    full_state = {
        "messages": [
            {"type": "human", "content": "Hello", "role": "user"},
        ],
        "is_last_step": True,
        "remaining_steps": 0,
    }

    # State with only remaining_steps (should be allowed)
    state_with_remaining = {
        "messages": [
            {"type": "human", "content": "Hello", "role": "user"},
        ],
        "remaining_steps": 5,
    }

    # State with only is_last_step (should be allowed)
    state_with_last_step = {
        "messages": [
            {"type": "human", "content": "Hello", "role": "user"},
        ],
        "is_last_step": False,
    }

    # Validate that AgentState TypedDict accepts these states without KeyError or TypeError
    # TypedDict does not enforce at runtime, so we check presence of keys and type correctness
    # We also test the create_react_agent function's internal _is_done function behavior with these states

    # Import internal _is_done function from prebuilt.chat_agent_executor for testing
    # It is nested inside create_react_agent, so we create an agent and access it
    agent = create_react_agent(tools=[])
    _is_done = agent._is_done  # type: ignore

    # The minimal_state should not raise errors and _is_done should return False (no remaining_steps or is_last_step)
    assert "messages" in minimal_state
    assert "is_last_step" not in minimal_state
    assert "remaining_steps" not in minimal_state
    assert _is_done(minimal_state) is False

    # The full_state has both keys, _is_done should return True because remaining_steps=0 and is_last_step=True
    assert _is_done(full_state) is True

    # State with only remaining_steps=5 (not done)
    assert _is_done(state_with_remaining) is False

    # State with only is_last_step=False (not done)
    assert _is_done(state_with_last_step) is False


def test_agent_state_type_annotations() -> None:
    # This test verifies that the AgentState TypedDict marks is_last_step and remaining_steps as NotRequired
    # by inspecting the __annotations__ attribute.

    annotations = AgentState.__annotations__
    assert "messages" in annotations
    # The buggy code marks is_last_step and remaining_steps as required, so this test will fail before fix
    # After fix, these keys should be present but wrapped with NotRequired
    assert "is_last_step" in annotations
    assert "remaining_steps" in annotations

    # The annotation types should be typing_extensions._GenericAlias or similar with NotRequired
    # We check that the annotation string contains "NotRequired"
    assert "NotRequired" in str(annotations["is_last_step"])
    assert "NotRequired" in str(annotations["remaining_steps"])


