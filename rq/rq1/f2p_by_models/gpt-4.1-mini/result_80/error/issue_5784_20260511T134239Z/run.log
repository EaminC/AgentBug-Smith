import pytest
from typing import TypedDict, NotRequired, Sequence
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent
from langgraph.prebuilt.chat_agent_executor import _get_state_value  # internal helper
from langgraph.prebuilt.chat_agent_executor import BaseMessage


def test_agent_state_optional_fields_behavior() -> None:
    """
    This test verifies that the AgentState TypedDict correctly treats
    'remaining_steps' and 'is_last_step' as optional fields (NotRequired).
    Before the fix, these fields were required and missing them caused errors.
    After the fix, they are optional and code handles their absence gracefully.
    """

    # Compose minimal valid AgentState with only required 'messages'
    minimal_state: AgentState = {
        "messages": [
            {"content": "Hello", "type": "human"},
        ],
        # 'remaining_steps' and 'is_last_step' intentionally omitted to test optionality
    }

    # The internal _get_state_value helper should return None or default for missing keys
    remaining = _get_state_value(minimal_state, "remaining_steps", None)
    is_last = _get_state_value(minimal_state, "is_last_step", False)

    # Before fix: remaining_steps and is_last_step were required, so missing keys caused errors
    # After fix: they are optional, so missing keys return default values
    # We assert that missing keys do not raise and return expected defaults
    assert remaining is None
    assert is_last is False

    # Compose AgentState with both optional fields present
    full_state: AgentState = {
        "messages": [
            {"content": "Hello", "type": "human"},
        ],
        "remaining_steps": 3,
        "is_last_step": True,
    }

    # Values should be accessible and correct
    remaining_full = _get_state_value(full_state, "remaining_steps", None)
    is_last_full = _get_state_value(full_state, "is_last_step", False)

    assert remaining_full == 3
    assert is_last_full is True


def test_create_react_agent_with_various_states() -> None:
    """
    Test the create_react_agent function's internal logic that uses the optional
    fields 'remaining_steps' and 'is_last_step' to determine if the agent is done.
    The logic should handle missing keys gracefully.
    """

    # We import the internal function from the module to test the logic that uses these fields
    from langgraph.prebuilt.chat_agent_executor import _is_done

    # Case 1: No remaining_steps, is_last_step True, has_tool_calls True
    state1 = {
        "messages": [{"content": "msg", "type": "human"}],
        "is_last_step": True,
    }
    assert _is_done(state1) is False  # Because remaining_steps is None and is_last_step True but no tool calls

    # Case 2: remaining_steps = 0, all_tools_return_direct = True
    state2 = {
        "messages": [{"content": "msg", "type": "human"}],
        "remaining_steps": 0,
    }
    # We simulate the parameters for _is_done logic by patching _get_state_value usage
    # But since _is_done uses _get_state_value internally, we test the actual function behavior
    # We need to simulate has_tool_calls and all_tools_return_direct to True for test
    # The actual _is_done function in the fixed code only uses state dict, so we test it directly

    # The _is_done function expects keys: 'remaining_steps', 'is_last_step', and checks tool calls presence
    # We simulate minimal state with remaining_steps and no tool calls
    # The function returns True if remaining_steps < 1 and all_tools_return_direct is True
    # But since no tool calls, it should be False

