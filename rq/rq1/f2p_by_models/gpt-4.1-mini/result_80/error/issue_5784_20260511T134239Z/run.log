[32mimport pytest
from typing import TypedDict, NotRequired, Sequence
from langchain_core.messages import BaseMessage
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


def test_agent_state_optional_fields_behavior() -> None:
    # AgentState should allow missing 'remaining_steps' and 'is_last_step' keys
    # due to NotRequired usage after the fix.

    # Construct a minimal valid state with only 'messages'
    minimal_state: AgentState = {
        "messages": [BaseMessage(content="Hello", type="human")]
    }

    # This should not raise KeyError or similar, and should be accepted by create_react_agent internals
    # We test the internal _should_stop function indirectly by calling create_react_agent and checking behavior

    # We mock minimal parameters for create_react_agent
    # We only test the _should_stop logic indirectly by calling it via the returned agent function

    # Create a dummy agent with minimal required arguments
    agent = create_react_agent(
        llm=None,  # None is acceptable for this test, as we won't invoke llm calls
        tools=[],
        pre_model_hook=None,
        post_model_hook=None,
        runtime=None,
    )

    # The _should_stop function is internal; we test it by calling the returned agent with state
    # We simulate the state dict passed to _should_stop by calling the internal method via the agent

    # The agent returned is a RunnableCallable, which is callable
    # We call it with the minimal state and check that no exception is raised and output is as expected

    # Since the agent expects a dict with at least 'messages', and 'remaining_steps' and 'is_last_step' are optional,
    # the call should not fail due to missing keys.

    # We call the agent with minimal_state and expect it to run without KeyError
    try:
        result = agent(minimal_state)
    except KeyError as e:
        pytest.fail(f"Agent raised KeyError for missing optional field: {e}")

    # Additionally, test that the agent's internal _should_stop returns False for minimal state
    # We access the _should_stop method from the agent (it's a nested function)
    # The agent is a RunnableCallable with a __call__ method; the _should_stop is a closure inside create_react_agent
    # We cannot access it directly, so we test behavior by calling the agent and checking output type

    # The agent returns a dict or similar; we check that the call succeeded and returned a dict
    assert isinstance(result, dict) or result is None


def test_agent_state_with_explicit_optional_fields() -> None:
    # Test that AgentState allows explicit presence of optional fields and behaves correctly

    state_with_fields: AgentState = {
        "messages": [BaseMessage(content="Hello", type="human")],
        "remaining_steps": 0,
    }

    # 'is_last_step' is NotRequired and not present here; should still work
    agent = create_react_agent(
        llm=None,
        tools=[],
        pre_model_hook=None,
        post_model_hook=None,
        runtime=None,
    )

    try:
        result = agent(state_with_fields)
    except Exception as e:
        pytest.fail(f"Agent raised exception with optional fields present: {e}")

    assert isinstance(result, dict) or result is None


