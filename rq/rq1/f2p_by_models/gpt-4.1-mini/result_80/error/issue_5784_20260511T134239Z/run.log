[32mimport pytest
from typing import TypedDict, NotRequired, Sequence
from langchain_core.messages import BaseMessage
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


class DummyMessage(BaseMessage):
    content: str
    type: str = "dummy"


def test_agent_state_typeddict_optional_fields() -> None:
    # AgentState should accept dicts without is_last_step and remaining_steps keys
    # because they are NotRequired fields after the fix.

    # Valid state with messages only (missing is_last_step and remaining_steps)
    state_minimal = {
        "messages": [DummyMessage(content="hello")]
    }

    # Valid state with messages and remaining_steps only
    state_with_remaining = {
        "messages": [DummyMessage(content="hello")],
        "remaining_steps": 3,
    }

    # Valid state with messages and is_last_step only (should be allowed after fix)
    state_with_is_last = {
        "messages": [DummyMessage(content="hello")],
        "is_last_step": True,
    }

    # Valid state with all fields present
    state_full = {
        "messages": [DummyMessage(content="hello")],
        "remaining_steps": 2,
        "is_last_step": False,
    }

    # The buggy code marks is_last_step and remaining_steps as required,
    # so state_minimal and state_with_is_last should fail validation before fix.
    # After fix, all should be accepted.

    # We test that create_react_agent's internal _should_stop function
    # can be called without KeyError on these states.

    # Access the internal _should_stop function via create_react_agent
    # It is defined inside create_react_agent, so we create an agent and get it.

    agent = create_react_agent()

    # The _should_stop function is nested; we access it via closure or attribute.
    # The fix patch shows _should_stop defined inside create_react_agent with no export.
    # So we test indirectly by calling the agent with these states.

    # The agent returned is a RunnableCallable; it expects input with state.
    # We simulate calling the agent with these states and check no KeyError.

    # The agent expects a dict with "state" key containing the AgentState.
    # We wrap accordingly.

    for test_state in [state_minimal, state_with_remaining, state_with_is_last, state_full]:
        # Compose input dict
        input_dict = {"state": test_state}

        # Call the agent; it should not raise KeyError for missing keys after fix.
        # We do not care about the output here, only that no exception is raised.
        try:
            result = agent.invoke(input_dict)
        except KeyError as e:
            pytest.fail(f"Agent raised KeyError for state {test_state}: {e}")
        except Exception:
            # Other exceptions are allowed (e.g., because of dummy messages),
            # but KeyError specifically should not happen.
            pass


def test_agent_state_required_keys_validation() -> None:
    # The buggy code requires is_last_step and remaining_steps keys,
    # so a dict missing these keys should fail validation.
    # After fix, only messages is required.

    # We test the AgentState TypedDict __required_keys__ attribute if exists,
    # or simulate validation by checking required keys.

    required_keys = getattr(AgentState, "__required_keys__", None)
    # After fix, required_keys should only include "messages"
    assert required_keys is None or required_keys == {"messages"}

    # Test that a dict missing required keys raises TypeError when used as AgentState
    # TypedDicts do not enforce at runtime, so we simulate by checking keys manually.

    minimal_state = {"messages": [DummyMessage(content="hi")]}

    # Missing keys is_last_step and remaining_steps should be allowed after fix
    # But before fix, code may expect them.

    # So we assert that minimal_state keys cover required keys
    if required_keys is not None:
        missing = required_keys - minimal_state.keys()
        assert not missing, f"Missing required keys: {missing}"


# The tests above should fail on the buggy codebase (due to missing required keys)
# and pass on the fixed codebase where is_last_step and remaining_steps are NotRequired.[0m
