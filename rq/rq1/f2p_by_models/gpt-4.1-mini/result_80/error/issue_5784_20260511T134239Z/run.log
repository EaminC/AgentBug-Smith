[32mimport pytest
from typing import Any, Dict, List, Optional

from langgraph.prebuilt.chat_agent_executor import (
    AgentState,
    AgentStatePydantic,
    create_react_agent,
)
from langchain_core.messages import BaseMessage


def test_agent_state_optional_fields_behavior() -> None:
    """
    Test that AgentState TypedDict treats 'remaining_steps' and 'is_last_step' as optional fields,
    and that the logic in create_react_agent's is_finished function behaves correctly when these
    fields are omitted or present with various values.

    This test should fail on the buggy codebase where these fields are required,
    and pass after the fix marking them as NotRequired.
    """

    # Minimal valid state with only 'messages' field (required)
    minimal_state: AgentState = {
        "messages": [BaseMessage(content="Hello", type="human")]
    }

    # State with remaining_steps and is_last_step omitted (should be allowed after fix)
    # On buggy codebase, this should raise a type error or fail validation
    # We test the runtime behavior by passing to is_finished function

    # We need to get the is_finished function from create_react_agent
    # create_react_agent returns an agent object with is_finished method
    # The agent requires some parameters, but we can pass minimal dummy values

    # Create dummy parameters for create_react_agent
    dummy_llm = None
    dummy_tools = []
    dummy_runtime = None
    dummy_pre_model_hook = None

    agent = create_react_agent(
        llm=dummy_llm,
        tools=dummy_tools,
        runtime=dummy_runtime,
        pre_model_hook=dummy_pre_model_hook,
    )

    # The is_finished function expects a state dict with keys:
    # 'messages', optionally 'remaining_steps', 'is_last_step'

    # Case 1: minimal_state with only messages
    # Expected: is_finished returns False (no remaining_steps or is_last_step)
    assert agent.is_finished(minimal_state) is False

    # Case 2: state with remaining_steps = 0 and all_tools_return_direct = True
    state_with_remaining_steps: AgentState = {
        "messages": [BaseMessage(content="Hi", type="human")],
        "remaining_steps": 0,
    }
    # The is_finished logic:
    # if remaining_steps < 1 and all_tools_return_direct: return True
    # We simulate all_tools_return_direct = True by patching the method or monkeypatching
    # But since is_finished uses only state, we can test directly by calling the internal logic
    # Instead, we can test the public is_finished method by monkeypatching _get_state_value or patching agent

    # To test properly, we replicate the logic here for the test:
    # We call agent.is_finished with state_with_remaining_steps and simulate all_tools_return_direct = True

    # Since agent.is_finished uses _get_state_value internally, which reads from state dict,
    # and all_tools_return_direct is a parameter to is_finished, but in the code it's internal,
    # so we cannot pass it directly. The code in create_react_agent has is_finished as a closure,
    # so we cannot call it with parameters.

    # So instead, we test the public is_finished method with state including remaining_steps and is_last_step

    # We test with is_last_step omitted (should be allowed)
    assert agent.is_finished(state_with_remaining_steps) is False

    # Case 3: state with remaining_steps = 0 and is_last_step = True
    state_with_both: AgentState = {
        "messages": [BaseMessage(content="Hi", type="human")],
        "remaining_steps": 0,
        "is_last_step": True,
    }
    # According to the fixed logic, is_last_step is ignored if remaining_steps is present
    # So is_finished should return True if remaining_steps < 1 and all_tools_return_direct is True
    # But since all_tools_return_direct is internal, and we cannot set it, we expect False
    # Because the default in the closure is False for all_tools_return_direct

    # So we expect False here as well
    assert agent.is_finished(state_with_both) is False

    # Case 4: state with is_last_step = True only, no remaining_steps
    state_with_is_last_step_only: AgentState = {
        "messages": [BaseMessage(content="Hi", type="human")],
        "is_last_step": True,
    }
    # According to the buggy code, is_last_step is required, so this is valid only after fix
    # The is_finished function returns False because remaining_steps is None and is_last_step True and has_tool_calls False
    # has_tool_calls is False by default in closure, so returns False

    assert agent.is_finished(state_with_is_last_step_only) is False


def test_agent_state_pydantic_optional_fields() -> None:
    """
    Test that AgentStatePydantic model accepts optional fields 'remaining_steps' and 'is_last_step',
    and that they default to None if omitted.
    """

    # Create instance with only messages
    instance = AgentStatePydantic(messages=[BaseMessage(content="Hi", type="human")])
    assert instance.messages
    assert instance.remaining_steps is None
    assert instance.is_last_step is None

    # Create instance with remaining_steps only
    instance2 = AgentStatePydantic(
        messages=[BaseMessage(content="Hi", type="human")], remaining_steps=3
    )
    assert instance2.remaining_steps == 3
    assert instance2.is_last_step is None

    # Create instance with is_last_step only
    instance3 = AgentStatePydantic(
        messages=[BaseMessage(content="Hi", type="human")], is_last_step=True
    )
    assert instance3.is_last_step is True
    assert instance3.remaining_steps is None

    # Create instance with both fields
    instance4 = AgentStatePydantic(
        messages=[BaseMessage(content="Hi", type="human")],
        remaining_steps=2,
        is_last_step=False,
    )
    assert instance4.remaining_steps == 2
    assert instance4.is_last_step is False[0m
