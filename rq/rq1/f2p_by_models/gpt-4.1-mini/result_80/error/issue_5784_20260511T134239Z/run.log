[32mimport pytest
from typing import TypedDict, NotRequired, Sequence

from langchain_core.messages import BaseMessage
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


class DummyMessage(BaseMessage):
    content: str
    type: str = "dummy"


def test_agent_state_optional_fields_behavior():
    """
    Test that AgentState TypedDict correctly treats 'remaining_steps' as optional (NotRequired),
    and that the create_react_agent function's internal logic handles missing 'remaining_steps'
    and 'is_last_step' keys gracefully.

    Before the fix:
      - AgentState requires 'remaining_steps' and 'is_last_step' keys.
      - Omitting them causes validation or runtime errors.
    After the fix:
      - These keys are NotRequired (optional).
      - Logic in create_react_agent handles missing keys without error.
    """

    # Compose a minimal valid AgentState dict with only required 'messages' key
    minimal_state: AgentState = {
        "messages": [DummyMessage(content="Hello")]
        # 'remaining_steps' and 'is_last_step' omitted intentionally
    }

    # The function create_react_agent returns a callable (agent)
    agent_callable = create_react_agent()

    # The internal function _is_done is not exposed, but we can test the public interface
    # We simulate the internal _is_done logic by calling the agent with state and checking no error

    # The agent callable expects some input; we pass minimal_state as state
    # We expect no exceptions raised, and the agent to handle missing keys gracefully
    try:
        # The agent callable is a RunnableLike, which accepts input dict
        # We call it with minimal_state and check it returns without error
        result = agent_callable(minimal_state)
    except Exception as e:
        pytest.fail(f"Agent callable raised an exception with minimal state: {e}")

    # Now test with 'remaining_steps' present but 'is_last_step' missing
    state_with_remaining = {
        "messages": [DummyMessage(content="Hello")],
        "remaining_steps": 0,
    }
    try:
        result = agent_callable(state_with_remaining)
    except Exception as e:
        pytest.fail(f"Agent callable raised an exception with 'remaining_steps' but missing 'is_last_step': {e}")

    # Now test with both 'remaining_steps' and 'is_last_step' present
    state_full = {
        "messages": [DummyMessage(content="Hello")],
        "remaining_steps": 0,
        "is_last_step": True,
    }
    try:
        result = agent_callable(state_full)
    except Exception as e:
        pytest.fail(f"Agent callable raised an exception with full state: {e}")

    # If we reach here, the test passes, meaning the optional fields are handled correctly


def test_agent_state_type_annotations():
    """
    Test that the AgentState TypedDict type annotations reflect NotRequired for 'remaining_steps'.

    This test will fail before the fix because 'remaining_steps' is required and
    creating a dict without it would cause a mypy or runtime TypedDict validation error.
    After the fix, it should pass.
    """
    # This is a type-level test; runtime TypedDict does not enforce required keys strictly,
    # but we can check presence in __required_keys__ attribute if present.

    # AgentState is a TypedDict; check that 'remaining_steps' is not in __required_keys__ if attribute exists
    required_keys = getattr(AgentState, "__required_keys__", None)
    if required_keys is not None:
        assert "remaining_steps" not in required_keys, (
            "'remaining_steps' should not be required in AgentState TypedDict"
        )
    # Also check that 'messages' is required
    if required_keys is not None:
        assert "messages" in required_keys, "'messages' should be required in AgentState TypedDict"


