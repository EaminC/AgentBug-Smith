[32mimport pytest
from typing import TypedDict, NotRequired, Sequence
from langchain_core.messages import BaseMessage
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


def test_agent_state_optional_fields_behavior() -> None:
    # AgentState should allow missing is_last_step and remaining_steps keys due to NotRequired
    # We test that creating a state dict without these keys does not raise errors and
    # that the create_react_agent function behaves correctly with such partial state.

    # Minimal valid state with only messages
    minimal_state: AgentState = {
        "messages": [BaseMessage(content="Hello", type="human")]
        # 'is_last_step' and 'remaining_steps' keys omitted intentionally
    }

    # The patched code marks is_last_step and remaining_steps as NotRequired,
    # so this should be accepted without KeyError or TypeError.
    # Before patch, this would fail type checks or runtime checks.

    # The create_react_agent function returns a callable that uses the state.
    # We test that it can be called with minimal_state and does not raise.
    agent_callable = create_react_agent()

    # Call with minimal state; expect no exceptions
    try:
        result = agent_callable(minimal_state)
    except Exception as e:
        pytest.fail(f"Agent callable raised an exception with minimal state: {e}")

    # Also test with state including remaining_steps only
    state_with_remaining_steps: AgentState = {
        "messages": [BaseMessage(content="Hi again", type="human")],
        "remaining_steps": 3,
    }
    try:
        result = agent_callable(state_with_remaining_steps)
    except Exception as e:
        pytest.fail(f"Agent callable raised an exception with remaining_steps: {e}")

    # Also test with state including is_last_step only (simulate via dict cast)
    # Since is_last_step is NotRequired and not in TypedDict explicitly, we simulate by casting
    state_with_is_last_step = {
        "messages": [BaseMessage(content="Last step?", type="human")],
        "is_last_step": True,
    }
    try:
        result = agent_callable(state_with_is_last_step)  # type: ignore
    except Exception as e:
        pytest.fail(f"Agent callable raised an exception with is_last_step: {e}")

    # Test that the agent callable returns a value (not None)
    assert result is not None


def test_agent_state_required_fields_enforcement() -> None:
    # Test that missing 'messages' key raises error or is rejected
    incomplete_state = {}

    agent_callable = create_react_agent()

    with pytest.raises(KeyError):
        # This should raise because 'messages' is required
        agent_callable(incomplete_state)  # type: ignore


def test_agent_state_with_all_fields() -> None:
    # Test with all fields present
    full_state: AgentState = {
        "messages": [BaseMessage(content="Full state", type="human")],
        "remaining_steps": 1,
        "is_last_step": False,
    }

    agent_callable = create_react_agent()

    try:
        result = agent_callable(full_state)  # type: ignore
    except Exception as e:
        pytest.fail(f"Agent callable raised an exception with full state: {e}")

    assert result is not None[0m
