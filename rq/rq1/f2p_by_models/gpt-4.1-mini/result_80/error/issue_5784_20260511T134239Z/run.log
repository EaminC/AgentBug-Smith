[32mimport pytest
from typing import TypedDict, NotRequired, Sequence
from langchain_core.messages import BaseMessage
from langgraph.prebuilt.chat_agent_executor import AgentState, create_react_agent


class DummyMessage(BaseMessage):
    content: str
    type: str = "dummy"


def test_agent_state_optional_fields_behavior():
    """
    Test that AgentState TypedDict treats 'remaining_steps' as optional (NotRequired),
    and that the logic in create_react_agent's is_done function behaves correctly
    when 'remaining_steps' is missing or present with various values.

    This test should fail on the buggy codebase where 'remaining_steps' is required,
    causing validation or logic errors, and pass after the fix marking it NotRequired.
    """

    # Compose a minimal valid AgentState with only required 'messages'
    minimal_state: AgentState = {
        "messages": [DummyMessage(content="Hello")]
        # 'remaining_steps' is omitted intentionally
    }

    # Compose states with various 'remaining_steps' values
    state_with_remaining_steps_0: AgentState = {
        "messages": [DummyMessage(content="Hello")],
        "remaining_steps": 0,
    }
    state_with_remaining_steps_1: AgentState = {
        "messages": [DummyMessage(content="Hello")],
        "remaining_steps": 1,
    }
    state_with_remaining_steps_2: AgentState = {
        "messages": [DummyMessage(content="Hello")],
        "remaining_steps": 2,
    }

    # Create the react agent with default parameters
    agent = create_react_agent()

    # Access the internal _is_done function from the created agent
    # It is a closure, so we access it by calling the agent's _is_done attribute if exists
    # or by calling the returned callable directly with state.
    # The actual implementation returns a callable, so we can call it with state.
    is_done = agent._is_done if hasattr(agent, "_is_done") else None
    if is_done is None:
        # Fallback: the agent itself is callable and returns result
        is_done = agent

    # Define a helper to call is_done with a state dict
    def call_is_done(state_dict):
        # The is_done function expects a state dict with keys as in AgentState
        # It uses _get_state_value internally to get 'remaining_steps' and 'is_last_step'
        # We simulate the presence or absence of keys accordingly.
        return is_done(state_dict)

    # Test that minimal_state without 'remaining_steps' does not cause error and returns False
    # Because remaining_steps is None, and is_last_step is False by default in buggy code
    # The buggy code expects remaining_steps required, so it may error or behave incorrectly.
    result_minimal = call_is_done(minimal_state)
    assert result_minimal is False

    # Test with remaining_steps = 0 and all_tools_return_direct = True (default)
    # Should return True because remaining_steps < 1 and all_tools_return_direct is True
    result_0 = call_is_done(state_with_remaining_steps_0)
    assert result_0 is True

    # Test with remaining_steps = 1, should return False (remaining_steps not < 1 or < 2)
    result_1 = call_is_done(state_with_remaining_steps_1)
    assert result_1 is False

    # Test with remaining_steps = 2, should return False
    result_2 = call_is_done(state_with_remaining_steps_2)
    assert result_2 is False

    # Also test that passing 'is_last_step' key does not cause error (even if optional)
    state_with_is_last_step = {
        "messages": [DummyMessage(content="Hello")],
        "remaining_steps": 0,
        "is_last_step": True,
    }
    result_is_last_step = call_is_done(state_with_is_last_step)
    assert result_is_last_step is True


def test_agent_state_type_accepts_optional_fields():
    """
    Test that AgentState TypedDict accepts missing 'remaining_steps' field without error.
    This verifies that NotRequired is effective.
    """

    # This should be valid according to the fixed AgentState definition
    state_without_remaining_steps: AgentState = {
        "messages": [DummyMessage(content="Test")]
    }

    # No exception should be raised when accessing keys
    assert "remaining_steps" not in state_without_remaining_steps

    # The 'messages' key must be present and is a sequence of BaseMessage
    assert isinstance(state_without_remaining_steps["messages"], Sequence)


@pytest.mark.parametrize(
    "state_dict, expected",
    [
        ({"messages": [DummyMessage(content="Hi")], "remaining_steps": 0}, True),
        ({"messages": [DummyMessage(content="Hi")], "remaining_steps": 1}, False),
        ({"messages": [DummyMessage(content="Hi")]}, False),  # missing remaining_steps
    ],
)
def test_is_done_behavior_various_states(state_dict, expected):
    """
    Parametrized test to check is_done behavior for various AgentState dicts.
    """

    agent = create_react_agent()
    is_done = agent._is_done if hasattr(agent, "_is_done") else agent

    result = is_done(state_dict)
    assert result == expected[0m
