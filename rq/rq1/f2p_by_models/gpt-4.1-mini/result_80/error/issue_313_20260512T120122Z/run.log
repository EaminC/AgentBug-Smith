# Install project dependencies and test dependencies with pip
# Install pytest etc. explicitly as required
RUN if [ -f "requirements.txt" ]; then pip install -r requirements.txt ; fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout anyio "setuptools<=81.0.0" litellm structlog uvicorn fastapi

# Set PYTHONPATH to /app to support running standalone scripts that import project modules
ENV PYTHONPATH=/app

# Default command: open bash shell
CMD ["/bin/bash"]

