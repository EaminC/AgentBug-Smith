[32mFROM python:3.11-slim AS test_builder

WORKDIR /app

# Copy entire repository
COPY . .

# Detect src/ layout or imports from src. in tests
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
      echo "Detected src layout or src imports in tests, setting PYTHONPATH"; \
      export PYTHONPATH=/app; \
      python -m pip install --upgrade pip setuptools wheel && \
      pip install -r requirements.txt 2>/dev/null || true && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout ; \
    else \
      python -m pip install --upgrade pip setuptools wheel && \
      pip install -r requirements.txt 2>/dev/null || true && \
      pip install -e . && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout ; \
    fi

# Set environment variable for src/ layout to avoid import issues if used
ENV PYTHONPATH=/app

# Preflight import check to fail fast if core modules missing
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

# Run tests as defined in Makefile target 'test'
RUN make test

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

FROM python:3.11-slim AS runtime

WORKDIR /app

COPY . .

# Install only production dependencies and the package itself (without dev/test dependencies)
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt 2>/dev/null || true && \
    pip install -e . && \
    # uninstall test dependencies to keep runtime minimal
