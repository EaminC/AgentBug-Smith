    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Set working directory
WORKDIR /app

# Copy the entire project into the container
COPY . .

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies needed for Python packages compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies and the package itself, plus test and runtime deps
# Install pytest, pytest-mock, pytest-asyncio, pytest-cov, pytest-xdist, pytest-timeout, setuptools capped, litellm explicitly
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout anyio "setuptools<=81.0.0" litellm

# Set PYTHONPATH for correct imports if needed
ENV PYTHONPATH=/app

# Default command: keep container open with bash shell
CMD ["/bin/bash"]

