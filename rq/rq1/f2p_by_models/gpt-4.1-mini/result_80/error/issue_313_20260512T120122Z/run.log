# Install Python dependencies from requirements.txt if it exists
RUN if [ -f requirements.txt ]; then pip install -r requirements.txt; fi

# Install the package itself in editable mode and standard test deps for Python
RUN pip install -e . \
    && pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout anyio "setuptools<=81.0.0" litellm

# Set PYTHONPATH to /app for correct imports
ENV PYTHONPATH=/app

# Default command to keep container open with bash shell
CMD ["/bin/bash"]

