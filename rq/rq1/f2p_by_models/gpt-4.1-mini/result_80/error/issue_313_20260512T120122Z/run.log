    && pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout anyio "setuptools<=81.0.0" litellm

# Set PYTHONPATH environment variable for source layout
ENV PYTHONPATH=/app

# Default command that launches bash shell
CMD ["/bin/bash"]
