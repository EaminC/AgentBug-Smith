# Use Poetry to install dependencies and package
RUN poetry config virtualenvs.create false && \
    poetry install --no-interaction --no-ansi

# Install test dependencies explicitly
RUN python -m pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout anyio "setuptools<=81.0.0" litellm

# Set PYTHONPATH for running standalone scripts
ENV PYTHONPATH=/app

# Default command
CMD ["/bin/bash"]

