[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Copy entire repo including python subdir as metadata is in ./python
COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

RUN python -m pip install --upgrade pip setuptools wheel && \
    if [ -f "python/requirements.txt" ]; then \
        pip install -r python/requirements.txt && \
        pip install -e python && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout ; \
    elif [ -f "python/pyproject.toml" ] && [ -f "python/poetry.lock" ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi && \
        pip install -e python && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout ; \
    elif [ -f "python/pyproject.toml" ]; then \
        pip install -e python && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout ; \
    else \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout ; \
    fi

# Preflight import check to fail fast if missing modules
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests with pytest on python directory as per Makefile and workflow
RUN pytest python

FROM python:3.12-slim AS runtime

WORKDIR /app

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Install only production dependencies
RUN python -m pip install --upgrade pip setuptools wheel && \
    if [ -f "python/requirements.txt" ]; then \
        pip install -r python/requirements.txt && \
        pip install python; \
    elif [ -f "python/pyproject.toml" ] && [ -f "python/poetry.lock" ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-dev --no-interaction --no-ansi && \
        pip install python; \
    elif [ -f "python/pyproject.toml" ]; then \
        pip install python; \
    fi

