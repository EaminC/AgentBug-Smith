[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set Forge API environment variables for OpenAI and Anthropic SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    FORGE_API_KEY=forge-key

WORKDIR /app

COPY . .

# Upgrade pip, setuptools and wheel, install system dependencies needed for building packages and missing libs for testing
RUN python -m pip install --upgrade pip setuptools wheel \
    && apt-get update && apt-get install -y --no-install-recommends \
        gcc libpq-dev libsqlite3-dev libxml2-dev libxslt1-dev libffi-dev python3-dev build-essential curl \
        libjpeg-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies from requirements.txt if it exists
RUN if [ -f requirements.txt ]; then pip install -r requirements.txt; fi

# Install project itself and test dependencies required for running tests and standalone scripts
# Including packages required in import errors from previous test runs: nbconvert, psycopg_pool, numpy, sqlite_vec, bs4, mkdocs, langchain_core, aiosqlite, dataclasses_json
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm bs4 mkdocs nbconvert psycopg[binary] psycopg_pool numpy langchain_core aiosqlite dataclasses_json sqlite_vec

ENV PYTHONPATH=/app

# Preflight check for pytest
RUN python -c "import pytest; print('pytest ok')"

CMD ["/bin/bash"]

