[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    FORGE_API_KEY=forge-key

WORKDIR /app

COPY . .

RUN python -m pip install --upgrade pip setuptools wheel \
 && apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev libsqlite3-dev libxml2-dev libxslt1-dev libffi-dev python3-dev build-essential curl \
 && rm -rf /var/lib/apt/lists/*

RUN if [ -f requirements.txt ]; then \
      pip install -r requirements.txt; \
    fi

# This repo does NOT appear to have a setup.py or pyproject.toml at root for pip install -e .
# So skip pip install -e . and just install test and common dependencies explicitly
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm ormsgpack langchain-core bs4 mkdocs nbformat nbconvert psycopg psycopg_pool aiosqlite dataclasses-json numpy sqlite_vec pandas

RUN python -c "import pytest, ormsgpack, langchain_core, bs4, mkdocs, nbformat, nbconvert, psycopg, psycopg_pool, aiosqlite, dataclasses_json, numpy, sqlite_vec, pandas; print('preflight ok')"

CMD ["/bin/bash"]

# branch: python/requirements.txt, no editable install due to missing setup.py or pyproject.toml
# simplified pip install -e . removal
# set Forge API env vars as per instructions
# ensure Python build deps and useful libs installed
# support running standalone Python scripts at /app
