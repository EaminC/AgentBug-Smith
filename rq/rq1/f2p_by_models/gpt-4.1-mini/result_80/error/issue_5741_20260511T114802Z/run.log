        python3-dev \
        build-essential \
        curl \
        libjpeg-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies from requirements.txt if it exists, then install project in editable mode
RUN if [ -f requirements.txt ]; then \
        pip install -r requirements.txt; \
    fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# Additional suspect dependencies to fix missing import errors from tests
RUN pip install bs4 mkdocs nbconvert psycopg[binary] psycopg_pool numpy langchain_core aiosqlite dataclasses_json sqlite_vec pandas ormsgpack

# Set PYTHONPATH for correct imports during standalone script execution
ENV PYTHONPATH=/app

# Preflight test checking pytest import and langgraph import to validate install
RUN python -c "import pytest, langgraph; print('preflight ok')"

CMD ["/bin/bash"]

