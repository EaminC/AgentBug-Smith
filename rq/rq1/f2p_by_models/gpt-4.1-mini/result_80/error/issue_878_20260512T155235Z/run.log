[32mFROM python:3.11-slim AS test_builder

WORKDIR /app

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

RUN python -m pip install --upgrade pip setuptools wheel && \
    if [ -f "platform/requirements.txt" ]; then \
        pip install -r platform/requirements.txt && \
        pip install -e ./platform && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout ; \
    elif [ -f "platform/poetry.lock" ] && [ -f "platform/pyproject.toml" ]; then \
        pip install poetry && \
        cd platform && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout ; \
    elif [ -f "platform/pyproject.toml" ]; then \
        pip install -e ./platform && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout ; \
