[32mFROM python:3.11-slim AS test_builder

# Set working directory
WORKDIR /app

# Copy entire repository into working directory
COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Upgrade pip, setuptools and wheel early to avoid import-time errors
# The project metadata is in ./libs/langgraph (pyproject.toml)
# Detect src/ layout or src. imports in tests (not evident from files), assume no src layout
# Install dependencies with pip install -e libs/langgraph, and install test dependencies unconditionally
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r libs/langgraph/requirements.txt 2>/dev/null || true && \
    pip install -e libs/langgraph && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout

# Preflight check to ensure required modules are importable
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run build and test commands as per Makefile in libs/langgraph
RUN make -C libs/langgraph build && \
    make -C libs/langgraph test

# Final minimal runtime stage
FROM python:3.11-slim AS runtime

WORKDIR /app

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Install only production dependencies from libs/langgraph
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r libs/langgraph/requirements.txt 2>/dev/null || true && \
    pip install libs/langgraph

# Final preflight check for production image
RUN python -c 'import pkg_resources; print("preflight ok")'

CMD ["/bin/bash"][0m
