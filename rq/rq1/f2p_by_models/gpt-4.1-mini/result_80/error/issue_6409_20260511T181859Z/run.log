    gcc \
    libpq-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools and wheel and install python dependencies
RUN python -m pip install --upgrade pip setuptools wheel && \
    # Install requirements if present
    if [ -f "libs/langgraph/requirements.txt" ]; then pip install -r libs/langgraph/requirements.txt; fi && \
    if [ -f "libs/checkpoint-postgres/requirements.txt" ]; then pip install -r libs/checkpoint-postgres/requirements.txt; fi && \
    if [ -f "libs/checkpoint-sqlite/requirements.txt" ]; then pip install -r libs/checkpoint-sqlite/requirements.txt; fi && \
    # Install libraries in editable mode
    pip install -e libs/langgraph && \
    pip install -e libs/checkpoint && \
    pip install -e libs/checkpoint-postgres && \
    pip install -e libs/checkpoint-sqlite && \
    pip install -e libs/prebuilt && \
    pip install -e libs/sdk-py && \
    pip install -e libs/cli && \
    # Install extra test dependencies explicitly
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout beautifulsoup4 mkdocs nbformat psycopg[binary] aiosqlite dataclasses_json

RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

