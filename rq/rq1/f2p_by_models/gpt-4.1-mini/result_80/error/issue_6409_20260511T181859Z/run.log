[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set environment variables for Forge API compatibility with best practice using ARG for keys
ARG FORGE_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

# Copy entire repo for build and tests
COPY . .

# Install system dependencies needed for Python packages and build tooling
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and essential packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python requirements if present, then install libraries in editable mode
RUN if [ -f "libs/langgraph/requirements.txt" ]; then pip install -r libs/langgraph/requirements.txt; fi && \
    if [ -f "libs/checkpoint-postgres/requirements.txt" ]; then pip install -r libs/checkpoint-postgres/requirements.txt; fi && \
    if [ -f "libs/checkpoint-sqlite/requirements.txt" ]; then pip install -r libs/checkpoint-sqlite/requirements.txt; fi && \
    pip install -e libs/langgraph && \
    pip install -e libs/checkpoint && \
    pip install -e libs/checkpoint-postgres && \
    pip install -e libs/checkpoint-sqlite && \
    pip install -e libs/prebuilt && \
    pip install -e libs/sdk-py && \
    pip install -e libs/cli

# Install extra test dependencies explicitly to avoid ImportErrors
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout beautifulsoup4 mkdocs nbformat psycopg[binary] aiosqlite dataclasses_json redis

# Preflight check to verify installed packages
RUN python -c 'import pkg_resources, pytest, redis, psycopg, aiosqlite, dataclasses_json; print("preflight ok")'

CMD ["/bin/bash"]

