[32mimport os
import pytest
from langchain_core.runnables import RunnableConfig
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from langchain.chat_models import ChatOpenAI
from unittest.mock import patch

# We will mock the internal model client call to avoid real API calls.
# The test will run the real PostgresSaver and graph logic to reproduce the serialization error.

DB_URI = os.getenv("TEST_POSTGRES_URI", "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable")

@pytest.mark.skipif(DB_URI is None, reason="No Postgres URI provided")
def test_postgres_saver_serialization_issue(monkeypatch):
    # Use ChatOpenAI as a stand-in for init_chat_model with a dummy response
    # We patch the internal _call method to return a dummy AIMessage-like dict
    # to simulate the model response without real API calls.

    from langchain.schema import AIMessage

    class DummyModel(ChatOpenAI):
        def _call(self, prompt, stop=None):
            # Return a dummy AIMessage object
            return AIMessage(content="Hello from dummy model")

    model = DummyModel(model_name="gpt-4", temperature=0)

    # Patch model.invoke to return a list of AIMessage objects (simulate real response)
    def dummy_invoke(messages):
        # Return a list with one AIMessage
        return [AIMessage(content="Dummy response")]

    model.invoke = dummy_invoke

    with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
        # We do not call checkpointer.setup() because it is done internally on context enter.

        def call_model(state: MessagesState):
            response = model.invoke(state["messages"])
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test-thread-1"
            }
        }

        # Run the graph stream twice with different inputs to simulate usage
        # This should fail on buggy code due to AIMessage not being JSON serializable,
        # and succeed after the fix.

        # First input
        input_1 = {"messages": [{"role": "user", "content": "hi! I'm bob"}]}
        chunks_1 = list(graph.stream(input_1, config, stream_mode="values"))
        # Validate output is list and last message content is string
        assert isinstance(chunks_1, list)
        assert len(chunks_1) > 0
        last_msg_1 = chunks_1[-1]["messages"][-1]
        # last_msg_1 should be AIMessage or dict with content attribute
        assert hasattr(last_msg_1, "content") or isinstance(last_msg_1, dict)
        if hasattr(last_msg_1, "content"):
            assert isinstance(last_msg_1.content, str)
        else:
            assert isinstance(last_msg_1.get("content", None), str)

        # Second input
        input_2 = {"messages": [{"role": "user", "content": "what's my name?"}]}
        chunks_2 = list(graph.stream(input_2, config, stream_mode="values"))
        assert isinstance(chunks_2, list)
        assert len(chunks_2) > 0
        last_msg_2 = chunks_2[-1]["messages"][-1]
        assert hasattr(last_msg_2, "content") or isinstance(last_msg_2, dict)
        if hasattr(last_msg_2, "content"):
            assert isinstance(last_msg_2.content, str)
        else:
