[32mimport os
import pytest
from langchain.chat_models import ChatOpenAI
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from unittest.mock import patch


@pytest.mark.skipif(
    os.environ.get("PG_TEST_URI") is None,
    reason="Postgres test URI not set in environment variable PG_TEST_URI",
)
def test_postgres_saver_serialization_error():
    """
    This test reproduces the JSON serialization error when using PostgresSaver
    with a node returning AIMessage objects directly. It should fail on the buggy
    codebase due to TypeError: Object of type AIMessage is not JSON serializable.
    After the fix, it should pass without error.
    """
    # Use environment variable for DB URI to avoid hardcoding credentials
    DB_URI = os.environ["PG_TEST_URI"]

    # Use ChatOpenAI with a dummy model to avoid real API calls
    # Patch the internal _call method to return a fixed response
    model = ChatOpenAI(model_name="gpt-3.5-turbo", temperature=0)

    def dummy_invoke(messages):
        # Return a list with a dict simulating AIMessage structure
        # but as plain dicts to avoid serialization issues
        return [{"role": "assistant", "content": "Hello from dummy model"}]

    # Patch model.invoke to dummy_invoke to avoid real API calls and serialization issues
    with patch.object(model, "invoke", side_effect=dummy_invoke):
        with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
            # We do not call checkpointer.setup() because from_conn_string does it

            def call_model(state: MessagesState):
                # The node returns a dict with "messages" key containing the response
                response = model.invoke(state["messages"])
                return {"messages": response}

            builder = StateGraph(MessagesState)
            builder.add_node(call_model)
            builder.add_edge(START, "call_model")

            graph = builder.compile(checkpointer=checkpointer)

            config = {
                "configurable": {
                    "thread_id": "test-thread"
                }
            }

            # Run the graph stream with initial user message
            # This should raise TypeError on buggy code, pass on fixed code
            # We collect all chunks to force full execution
            chunks = list(
                graph.stream(
                    {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
                    config,
                    stream_mode="values"
                )
            )
            # Assert that the last chunk contains the expected assistant message content
            assert chunks[-1]["messages"][-1]["content"] == "Hello from dummy model"

            # Run a second query to ensure no serialization error on subsequent calls
            chunks2 = list(
                graph.stream(
                    {"messages": [{"role": "user", "content": "what's my name?"}]},
                    config,
                    stream_mode="values"
                )
            )
            assert chunks2[-1]["messages"][-1]["content"] == "Hello from dummy model"


if __name__ == "__main__":
    pytest.main([__file__])[0m
