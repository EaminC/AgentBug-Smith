[32mimport os
import pytest
from langchain.chat_models import ChatOpenAI
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver

@pytest.mark.skipif(
    "POSTGRES_TEST_URI" not in os.environ,
    reason="POSTGRES_TEST_URI environment variable not set"
)
def test_postgres_saver_serialization_issue():
    """
    This test reproduces the JSON serialization error when using PostgresSaver
    with a node returning AIMessage objects. It should fail on the buggy codebase
    and pass after the fix is applied.
    """
    # Use environment variable for DB connection string
    DB_URI = os.environ["POSTGRES_TEST_URI"]

    # Initialize a dummy chat model that returns a simple dict-like response
    # to avoid real API calls and ensure deterministic behavior.
    # We patch the invoke method of ChatOpenAI to return a list of dicts simulating messages.
    class DummyChatModel(ChatOpenAI):
        def __init__(self):
            super().__init__(model_name="gpt-4", temperature=0)
        def invoke(self, messages):
            # Return a list of dicts simulating AIMessage objects
            return [{"role": "assistant", "content": "Hello, this is a dummy response."}]

    model = DummyChatModel()

    with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
        # Do not call setup() explicitly; from_conn_string should handle it.

        def call_model(state: MessagesState):
            # Call the dummy model's invoke method with the messages
            response = model.invoke(state["messages"])
            # Return the response wrapped in dict as expected by the graph
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test-thread"
            }
        }

        # Run the graph streaming with initial user message
        # This should raise TypeError on buggy code, pass on fixed code
        results = []
        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
            config,
            stream_mode="values"
        ):
            results.append(chunk)

        # Assert that results contain expected structure and no serialization error occurred
        assert len(results) > 0
        last_messages = results[-1]["messages"]
        assert isinstance(last_messages, list)
        assert last_messages[-1]["content"] == "Hello, this is a dummy response."

        # Run again with a different message to confirm consistent behavior
        results2 = []
        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "what's my name?"}]},
            config,
            stream_mode="values"
        ):
            results2.append(chunk)

        assert len(results2) > 0
        last_messages2 = results2[-1]["messages"]
        assert isinstance(last_messages2, list)
        assert last_messages2[-1]["content"] == "Hello, this is a dummy response."[0m
