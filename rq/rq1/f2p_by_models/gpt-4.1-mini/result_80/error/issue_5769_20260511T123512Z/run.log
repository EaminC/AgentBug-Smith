[32mimport os
import pytest
from langchain_core.runnables import RunnableConfig
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from langchain.chat_models import ChatOpenAI
from unittest.mock import patch, MagicMock

# We will mock the internal model client's invoke method to avoid real API calls.
# We do not mock the method where the bug is, only the internal call to the model.

DB_URI = os.environ.get(
    "TEST_POSTGRES_URI", "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable"
)

@pytest.mark.skipif(
    not DB_URI.startswith("postgresql://"),
    reason="Postgres URI not configured for tests"
)
def test_postgres_saver_serialization_issue():
    """
    This test reproduces the serialization issue with PostgresSaver and AIMessage objects.
    It uses a mocked chat model to avoid external API calls.
    The test should fail on the buggy codebase with a TypeError about AIMessage not JSON serializable,
    and pass after the fix is applied.
    """

    # Mock chat model to return a simple dict simulating AIMessage list
    class DummyResponse:
        def __init__(self):
            self.messages = [{"role": "assistant", "content": "Hello from dummy model"}]

        def __getitem__(self, key):
            if key == "messages":
                return self.messages
            raise KeyError(key)

    class DummyModel:
        def invoke(self, messages):
            # Return dummy AIMessage-like object (dict simulating AIMessage)
            return DummyResponse()

    model = DummyModel()

    with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
        # Do not call setup() explicitly, as from_conn_string may handle it.

        def call_model(state: MessagesState):
            # Use the dummy model invoke method
            response = model.invoke(state["messages"])
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test-thread"
            }
        }

        # Run the graph stream twice to simulate two calls
        # We expect no serialization error after fix.
        # If buggy, this will raise TypeError about AIMessage not JSON serializable.

        # Collect outputs to assert on
        outputs = []

        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
            config,
            stream_mode="values"
        ):
            outputs.append(chunk)

        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "what's my name?"}]},
            config,
            stream_mode="values"
        ):
            outputs.append(chunk)

        # Assert that outputs contain messages with expected structure
        # The dummy model returns a dict with "messages" key containing list of dicts
        # We check that the last chunk has "messages" and that it is a list with dicts
        assert outputs, "No output chunks produced"
        for chunk in outputs:
            assert "messages" in chunk
            messages = chunk["messages"]
            assert isinstance(messages, DummyResponse) or isinstance(messages, list) or hasattr(messages, "__getitem__")
            # If DummyResponse, it has .messages attribute
            if isinstance(messages, DummyResponse):
                msgs = messages.messages
            else:
                msgs = messages
            assert isinstance(msgs, list)
            assert all(isinstance(m, dict) for m in msgs)
            # Check that at least one message has role and content keys
            assert any("role" in m and "content" in m for m in msgs)

