[32mimport os
import pytest
from langchain.chat_models import ChatOpenAI
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver

@pytest.mark.skipif(
    "POSTGRES_URI" not in os.environ,
    reason="POSTGRES_URI environment variable must be set for this test"
)
def test_postgres_saver_serialization_issue():
    """
    This test reproduces the JSON serialization error when using PostgresSaver
    with a LangGraph StateGraph that returns AIMessage objects.
    The test should fail on the buggy codebase due to TypeError on AIMessage serialization,
    and pass on the fixed codebase.
    """
    # Use a dummy chat model that returns a simple dict instead of AIMessage to avoid external API calls
    class DummyModel:
        def invoke(self, messages):
            # Return a list of dict messages mimicking AIMessage structure but JSON serializable
            return [{"role": "assistant", "content": "dummy response"}]

    model = DummyModel()

    DB_URI = os.environ["POSTGRES_URI"]

    with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
        # Do not call setup() explicitly; context manager should handle it

        def call_model(state: MessagesState):
            # Use the dummy model invoke that returns JSON-serializable dicts
            response = model.invoke(state["messages"])
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test-thread"
            }
        }

        # Run the graph stream twice with different inputs to exercise checkpoint saving
        outputs = []
        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "hello"}]},
            config,
            stream_mode="values"
        ):
            outputs.append(chunk["messages"][-1]["content"])

        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "how are you?"}]},
            config,
            stream_mode="values"
        ):
            outputs.append(chunk["messages"][-1]["content"])

        # Assert that outputs contain expected dummy responses
        assert outputs == ["dummy response", "dummy response"][0m
