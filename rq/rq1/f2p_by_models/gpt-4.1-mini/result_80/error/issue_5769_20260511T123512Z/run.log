[32mimport os
import pytest
from langchain.chat_models import ChatOpenAI
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver

# We will mock the ChatOpenAI.invoke method to avoid real API calls and produce a dummy AIMessage-like output
# but we do not mock the PostgresSaver or graph streaming to test the serialization issue.

class DummyAIMessage:
    def __init__(self, role, content):
        self.role = role
        self.content = content

    def pretty_print(self):
        # Dummy print method to simulate the real AIMessage method
        print(f"{self.role}: {self.content}")

@pytest.fixture(scope="module")
def model(monkeypatch):
    # Patch ChatOpenAI.invoke to return a dummy AIMessage list
    model = ChatOpenAI(model_name="gpt-4", temperature=0)
    def dummy_invoke(messages):
        # Return a list with one DummyAIMessage simulating the AI response
        return [DummyAIMessage("assistant", "This is a dummy response.")]
    monkeypatch.setattr(model, "invoke", dummy_invoke)
    return model

@pytest.fixture(scope="module")
def postgres_uri():
    # Use environment variable or default local postgres URI for testing
    # The test requires a running Postgres instance accessible at this URI
    return os.environ.get("TEST_POSTGRES_URI", "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable")

def test_postgres_saver_serialization_issue(model, postgres_uri):
    """
    This test reproduces the serialization issue with PostgresSaver when returning AIMessage objects.
    It should fail on the buggy codebase with a TypeError and pass after the fix.
    """
    # Setup PostgresSaver checkpointer
    with PostgresSaver.from_conn_string(postgres_uri) as checkpointer:
        # Define a model call node that returns the AIMessage list directly
        def call_model(state: MessagesState):
            response = model.invoke(state["messages"])
            # Return the raw AIMessage list (not JSON serializable in buggy code)
            return {"messages": response}

        # Build the graph with one node calling the model
        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test-thread-1"
            }
        }

        # Run the graph stream with initial user message
        # This triggers the checkpoint saving with AIMessage in the checkpoint metadata
        chunks = list(
            graph.stream(
                {"messages": [{"role": "user", "content": "Hello, test!"}]},
                config,
                stream_mode="values"
            )
        )

        # Assert that the output is as expected and no serialization error occurs
        # We expect the last chunk to contain the dummy AIMessage with our dummy response
        assert len(chunks) > 0
        last_chunk = chunks[-1]
        assert "messages" in last_chunk
        # The last message should be DummyAIMessage with expected content
        last_message = last_chunk["messages"][-1]
        assert hasattr(last_message, "role")
        assert hasattr(last_message, "content")
        assert last_message.content == "This is a dummy response."

        # Also test a second call to ensure consistent behavior
        chunks2 = list(
            graph.stream(
                {"messages": [{"role": "user", "content": "What is your name?"}]},
                config,
                stream_mode="values"
            )
        )
        assert len(chunks2) > 0
        last_chunk2 = chunks2[-1]
        assert "messages" in last_chunk2
        last_message2 = last_chunk2["messages"][-1]
        assert hasattr(last_message2, "role")
        assert hasattr(last_message2, "content")
        assert last_message2.content == "This is a dummy response."

# Note: This test requires a running PostgreSQL instance accessible via the given URI.
# It is designed to fail on the buggy codebase due to JSON serialization of AIMessage,
# and pass after the fix that serializes checkpoint metadata properly.[0m
