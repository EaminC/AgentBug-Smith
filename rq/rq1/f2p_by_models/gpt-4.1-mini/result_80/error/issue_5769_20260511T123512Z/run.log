[32mimport os
import pytest
from langchain.chat_models import ChatOpenAI
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from unittest.mock import patch

# We will mock the internal model client call inside ChatOpenAI to avoid real API calls
# but we will not mock the PostgresSaver or graph streaming logic.

@pytest.mark.skipif(
    "POSTGRES_URI" not in os.environ,
    reason="POSTGRES_URI environment variable not set for Postgres connection"
)
def test_postgres_saver_serialization_issue():
    """
    This test reproduces the JSON serialization error when using PostgresSaver
    with a node returning AIMessage objects.

    It should fail on the buggy codebase with TypeError: Object of type AIMessage is not JSON serializable,
    and pass after the fix is applied.
    """
    # Use environment variable for Postgres connection to allow flexible testing
    DB_URI = os.environ["POSTGRES_URI"]

    # Patch the internal client invoke to return a dummy message structure
    # that mimics the real AIMessage but is serializable.
    # We patch ChatOpenAI._call to return a dict simulating the message content.
    # This avoids real network calls and ensures deterministic output.

    # The model.invoke(state["messages"]) calls ChatOpenAI.__call__ internally,
    # which calls _call method. We patch _call to return a dummy response.

    dummy_response = [{"role": "assistant", "content": "Hello from dummy model!"}]

    def dummy_call(self, prompt, stop=None):
        # Return a dict that looks like the expected message list
        return dummy_response

    with patch.object(ChatOpenAI, "_call", dummy_call):
        model = ChatOpenAI(model_name="gpt-4", temperature=0)

        with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
            # We do not call checkpointer.setup() explicitly because from_conn_string does it.

            def call_model(state: MessagesState):
                # The model.invoke returns dummy_response list
                response = model.invoke(state["messages"])
                return {"messages": response}

            builder = StateGraph(MessagesState)
            builder.add_node(call_model)
            builder.add_edge(START, "call_model")

            graph = builder.compile(checkpointer=checkpointer)

            config = {
                "configurable": {
                    "thread_id": "test-thread-1"
                }
            }

            # We expect streaming to succeed without serialization errors
            # Collect all messages from the stream
            all_messages = []
            for chunk in graph.stream(
                {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
                config,
                stream_mode="values"
            ):
                all_messages.append(chunk["messages"][-1])

            # The last message content should match dummy response content
            assert all_messages[-1]["content"] == "Hello from dummy model!"

            # Run a second stream to test multiple calls
            all_messages_2 = []
            for chunk in graph.stream(
                {"messages": [{"role": "user", "content": "what's my name?"}]},
                config,
                stream_mode="values"
            ):
                all_messages_2.append(chunk["messages"][-1])

            assert all_messages_2[-1]["content"] == "Hello from dummy model!"


if __name__ == "__main__":
    pytest.main([__file__])[0m
