[32mimport os
import pytest
from langchain.chat_models import ChatOpenAI
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from unittest.mock import patch

# We will mock the internal model client's invoke method to avoid real API calls
# but we will not mock the call_model function or PostgresSaver methods themselves.

@pytest.mark.skipif(
    "POSTGRES_URI" not in os.environ,
    reason="Environment variable POSTGRES_URI must be set to a valid Postgres connection string"
)
def test_postgres_saver_serialization_issue():
    """
    This test reproduces the JSON serialization error when using PostgresSaver
    with a node returning AIMessage objects.

    It uses a mocked ChatOpenAI model to return a dummy AIMessage,
    and runs a simple StateGraph with PostgresSaver as checkpointer.

    The test expects no TypeError to be raised during graph streaming,
    which fails on the buggy code and passes after the fix.
    """
    DB_URI = os.environ["POSTGRES_URI"]

    # Initialize the chat model with a dummy ChatOpenAI that returns a fixed AIMessage
    model = ChatOpenAI(model_name="gpt-3.5-turbo", temperature=0)

    # Patch the internal _call method of ChatOpenAI to return a dummy AIMessage response
    # We patch the _call method, which is the internal method that sends the request
    # This avoids mocking the entire ChatOpenAI or the call_model function.
    dummy_response = [
        {"role": "assistant", "content": "Hello, this is a dummy response."}
    ]

    def dummy_call(self, prompt, stop=None):
        # Return a ChatCompletionResponse-like object with messages attribute
        class DummyResponse:
            def __init__(self, messages):
                self.messages = messages
        return DummyResponse(dummy_response)

    with patch.object(ChatOpenAI, "_call", dummy_call):
        with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
            # Do not call setup() explicitly, PostgresSaver.from_conn_string does it internally

            def call_model(state: MessagesState):
                # The model.invoke returns AIMessage objects internally
                response = model.invoke(state["messages"])
                return {"messages": response}

            builder = StateGraph(MessagesState)
            builder.add_node(call_model)
            builder.add_edge(START, "call_model")

            graph = builder.compile(checkpointer=checkpointer)

            config = {
                "configurable": {
                    "thread_id": "test-thread-1"
                }
            }

            # Run the graph stream twice with different inputs to ensure no serialization error
            # The test will fail on buggy code due to TypeError on AIMessage serialization
            # and pass after fix.
            for input_messages in [
                [{"role": "user", "content": "Hi! I'm Bob"}],
                [{"role": "user", "content": "What's my name?"}],
            ]:
                chunks = list(
                    graph.stream(
                        {"messages": input_messages},
                        config,
                        stream_mode="values"
                    )
                )
                # Assert that chunks is not empty and last chunk contains AIMessage-like dict
                assert len(chunks) > 0
                last_chunk = chunks[-1]
                assert "messages" in last_chunk
                # The last message should be a dict with role and content keys (serializable)
                last_msg = last_chunk["messages"][-1]
                assert isinstance(last_msg, dict)
                assert "role" in last_msg
                assert "content" in last_msg
                # The content should match the dummy response content
                assert last_msg["content"] == "Hello, this is a dummy response."

# This test requires a running Postgres instance accessible via POSTGRES_URI environment variable.
# Example:
# export POSTGRES_URI="postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable"
# pytest tests/agentsmith_fail2pass_5769.py

# The test will fail on buggy code with TypeError: Object of type AIMessage is not JSON serializable
# and pass after applying the patch fixing metadata serialization in PostgresSaver.[0m
