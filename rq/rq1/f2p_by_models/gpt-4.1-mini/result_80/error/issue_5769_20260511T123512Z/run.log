[32mimport os
import pytest
from langchain_core.runnables import RunnableConfig
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from langchain.schema import AIMessage

# We will mock the model's invoke method to return a simple AIMessage object
class DummyModel:
    def invoke(self, messages):
        # Return a list containing one AIMessage to simulate model response
        return [AIMessage(content="This is a dummy response.")]

@pytest.mark.skipif(
    os.getenv("POSTGRES_TEST_URI") is None,
    reason="POSTGRES_TEST_URI environment variable not set"
)
def test_postgres_saver_serialization():
    """
    This test reproduces the JSON serialization error with PostgresSaver
    when saving AIMessage objects in the checkpoint metadata.
    It uses a dummy model that returns AIMessage instances.
    The test should fail on buggy code (TypeError) and pass after fix.
    """
    DB_URI = os.getenv("POSTGRES_TEST_URI")
    model = DummyModel()

    with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
        # Setup is optional if already done, but safe to call
        checkpointer.setup()

        def call_model(state: MessagesState):
            response = model.invoke(state["messages"])
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test-thread"
            }
        }

        # Run the graph stream with initial input
        # We expect no serialization error here
        outputs = []
        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "Hello from test"}]},
            config,
            stream_mode="values"
        ):
            # The last message should be AIMessage with dummy content
            last_msg = chunk["messages"][-1]
            outputs.append(last_msg.content)
            # Also check type is AIMessage
            assert isinstance(last_msg, AIMessage)

        # Run the graph stream again with different input to test repeated saving
        outputs2 = []
        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "What is your name?"}]},
            config,
            stream_mode="values"
        ):
            last_msg = chunk["messages"][-1]
            outputs2.append(last_msg.content)
            assert isinstance(last_msg, AIMessage)

        # Assert that outputs contain the dummy response string
        assert all("dummy response" in text for text in outputs)
        assert all("dummy response" in text for text in outputs2)[0m
