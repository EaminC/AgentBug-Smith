# --- end inject ---

# Set Forge API environment variables for OpenAI and Anthropic SDK compatibility
ENV FORGE_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

COPY . .

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies required for Python packages and compilation
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    libsqlite3-dev \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
# Check multiple possible requirements files to cover different subfolders
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt ; \
    elif [ -f "libs/langgraph/requirements.txt" ]; then \
        pip install -r libs/langgraph/requirements.txt ; \
    else \
        echo "No requirements.txt found"; \
    fi

# Install additional required packages for testing and runtime explicitly
RUN pip install \
    pytest pytest-mock pytest-asyncio pytest-cov anyio \
    "setuptools<=81.0.0" litellm \
    bs4 mkdocs nbformat nbconvert \
    psycopg[binary] psycopg_pool aiosqlite sqlite_vec numpy dataclasses_json

# Install the project itself in editable mode
RUN pip install -e libs/langgraph

# Preflight to check proper installs
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

