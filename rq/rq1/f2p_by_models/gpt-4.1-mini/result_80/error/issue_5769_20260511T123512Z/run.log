[32mimport os
import pytest
from langchain.chat_models import ChatOpenAI
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from unittest.mock import patch


@pytest.mark.skipif(
    os.getenv("POSTGRES_TEST_URI") is None,
    reason="POSTGRES_TEST_URI environment variable not set",
)
def test_postgres_saver_serialization_issue():
    """
    This test reproduces the JSON serialization error when using PostgresSaver
    with a node returning AIMessage objects. The test should fail on the buggy
    codebase and pass on the fixed codebase.
    """
    # Use environment variable for DB URI or fallback to default local URI
    DB_URI = os.getenv("POSTGRES_TEST_URI", "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable")

    # Initialize a dummy chat model that returns a dict with 'messages' key containing a list with a dict
    # to simulate the AIMessage structure without calling external API.
    class DummyModel:
        def invoke(self, messages):
            # Return a list of dicts simulating AIMessage objects
            return [{"role": "assistant", "content": "Hello from dummy model"}]

    model = DummyModel()

    with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
        # Do not call setup() to avoid side effects; assume DB is ready.

        def call_model(state: MessagesState):
            # This returns a dict with 'messages' key containing list of dicts (simulating AIMessage)
            response = model.invoke(state["messages"])
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test-thread"
            }
        }

        # Run the graph stream twice with different inputs to test checkpoint saving and loading
        outputs = []
        for input_messages in [
            {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
            {"messages": [{"role": "user", "content": "what's my name?"}]},
        ]:
            # Collect all chunks from the stream
            chunks = list(graph.stream(input_messages, config, stream_mode="values"))
            # Extract last message content from last chunk to verify output
            last_message = chunks[-1]["messages"][-1]
            outputs.append(last_message["content"])

        # Assert that outputs are as expected from dummy model
        assert outputs == ["Hello from dummy model", "Hello from dummy model"]


# This test requires a running Postgres instance accessible via POSTGRES_TEST_URI environment variable.
# It uses a dummy chat model to avoid external API calls and focuses on reproducing the serialization error.
# On the buggy codebase, this test should fail with a TypeError about AIMessage not being JSON serializable.
# On the fixed codebase, this test should pass successfully.[0m
