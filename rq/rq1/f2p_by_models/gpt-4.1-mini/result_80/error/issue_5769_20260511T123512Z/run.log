[32mimport os
import pytest
from langchain.chat_models import ChatOpenAI
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from unittest.mock import patch

# We will mock the internal model client's invoke method to avoid real API calls.
# We do NOT mock the model.invoke method itself, so the real logic runs.
# This test expects that the PostgresSaver can handle AIMessage serialization properly.

DB_URI = os.getenv("POSTGRES_TEST_URI", "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable")

@pytest.mark.skipif(
    DB_URI is None or DB_URI == "",
    reason="Postgres DB URI not set in environment variable POSTGRES_TEST_URI",
)
def test_postgres_saver_serialization_with_ai_message(monkeypatch):
    # Initialize the chat model (using langchain's ChatOpenAI as a stand-in for init_chat_model)
    # We patch the internal _call method to return a dummy AIMessage-like dict to avoid real calls.
    model = ChatOpenAI(model_name="gpt-3.5-turbo", temperature=0)

    # Patch the model's _call method to return a dummy AIMessage object compatible with langchain
    # The real model.invoke calls _call internally, so this avoids network calls.
    def dummy_call(messages, stop=None):
        # Return a list of messages with one AIMessage-like dict
        from langchain.schema import AIMessage
        return [AIMessage(content="Hello from dummy model")]

    monkeypatch.setattr(model, "_call", dummy_call)

    with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
        # Setup the checkpointer schema
        checkpointer.setup()

        def call_model(state: MessagesState):
            response = model.invoke(state["messages"])
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test-thread"
            }
        }

        # Run the graph stream with initial user message
        results = []
        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
            config,
            stream_mode="values"
        ):
            # Collect the last message content for assertion
            last_msg = chunk["messages"][-1]
            results.append(last_msg.content)

        # Run a second query to test multiple calls
        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "what's my name?"}]},
            config,
            stream_mode="values"
        ):
            last_msg = chunk["messages"][-1]
            results.append(last_msg.content)

        # Assert that the dummy responses are present and no serialization error occurred
        assert any("Hello from dummy model" in r for r in results)
        # Also assert that results length is at least 2 (two calls)
        assert len(results) >= 2

# This test should fail on buggy code (due to AIMessage not JSON serializable error)
# and pass on fixed code (where metadata serialization is fixed).[0m
