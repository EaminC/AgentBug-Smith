[32mimport os
import pytest
from langchain.chat_models import init_chat_model
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from unittest.mock import patch


@pytest.mark.skipif(
    os.getenv("POSTGRES_TEST_URI") is None,
    reason="POSTGRES_TEST_URI environment variable not set",
)
def test_postgres_saver_serialization_issue():
    """
    This test reproduces the JSON serialization error when using PostgresSaver
    with a real LLM message object returned from the model. The test should fail
    on the buggy codebase with a TypeError about AIMessage not being JSON serializable,
    and pass on the fixed codebase.
    """

    # Use environment variable for DB URI or fallback to default localhost
    DB_URI = os.getenv(
        "POSTGRES_TEST_URI",
        "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable",
    )

    # Initialize a simple chat model with a dummy response to avoid real API calls
    # We patch the internal model client invoke method to return a dummy AIMessage list
    model = init_chat_model(model="anthropic:claude-3-5-haiku-latest")

    # Patch the model.invoke method to return a dummy AIMessage list for testing
    # This avoids external API calls and ensures consistent test behavior
    dummy_response = [
        {
            "type": "ai_message",
            "role": "assistant",
            "content": "Hello, this is a test response.",
            "additional_kwargs": {},
            "example": False,
        }
    ]

    def fake_invoke(messages):
        # Return dummy AIMessage list (simulate model response)
        return dummy_response

    with PostgresSaver.from_conn_string(DB_URI) as checkpointer, patch.object(
        model, "invoke", side_effect=fake_invoke
    ):
        def call_model(state: MessagesState):
            response = model.invoke(state["messages"])
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test-thread-1"
            }
        }

        # Run the graph stream twice with different inputs to test checkpoint saving
        # The test will fail on buggy code due to serialization error and pass after fix
        outputs = []
        for input_msg in [
            {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
            {"messages": [{"role": "user", "content": "what's my name?"}]},
        ]:
            for chunk in graph.stream(input_msg, config, stream_mode="values"):
                outputs.append(chunk["messages"][-1])

        # Assert that the outputs are as expected (list of dicts with type ai_message)
        assert all(
            isinstance(msg, list) or isinstance(msg, dict) or hasattr(msg, "__iter__")
            for msg in outputs
        )
        # Check that the last message content matches dummy response content
        last_message = outputs[-1]
        # The dummy_invoke returns a list of dicts, so last_message is list of dicts
        # We check the content field of the first message dict
        if isinstance(last_message, list):
            content = last_message[0].get("content", None)
        elif isinstance(last_message, dict):
            content = last_message.get("content", None)
        else:
            content = None
        assert content == "Hello, this is a test response."[0m
