[32mimport os
import pytest
from langchain_core.runnables import RunnableConfig
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from langchain.chat_models import ChatOpenAI
from unittest.mock import patch

# We will mock the internal model client's invoke method to return a dummy AIMessage-like object
class DummyAIMessage:
    def __init__(self, content):
        self.content = content

    def pretty_print(self):
        # Just a dummy print method to simulate the real one
        print(f"AIMessage: {self.content}")

class DummyModel:
    def invoke(self, messages):
        # Return a list with a dummy AIMessage object to simulate the real response
        return [DummyAIMessage("dummy response")]

@pytest.mark.integration
def test_postgres_saver_with_stategraph_stream(monkeypatch):
    # We patch the init_chat_model to return our DummyModel to avoid real API calls
    with patch("langchain.chat_models.init_chat_model", return_value=DummyModel()):
        model = DummyModel()

        # Use a local Postgres URI; this should be configured in the test environment
        DB_URI = os.environ.get("TEST_POSTGRES_URI", "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable")

        # Use PostgresSaver context manager
        with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
            # Define the node function that calls the model
            def call_model(state: MessagesState):
                response = model.invoke(state["messages"])
                return {"messages": response}

            builder = StateGraph(MessagesState)
            builder.add_node(call_model)
            builder.add_edge(START, "call_model")

            graph = builder.compile(checkpointer=checkpointer)

            config = {
                "configurable": {
                    "thread_id": "test-thread-1"
                }
            }

            # Run the graph stream twice with different inputs to test persistence and serialization
            outputs = []
            for chunk in graph.stream(
                {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
                config,
                stream_mode="values"
            ):
                # The last message should have pretty_print method
                chunk["messages"][-1].pretty_print()
                outputs.append(chunk["messages"][-1].content)

            for chunk in graph.stream(
                {"messages": [{"role": "user", "content": "what's my name?"}]},
                config,
                stream_mode="values"
            ):
                chunk["messages"][-1].pretty_print()
                outputs.append(chunk["messages"][-1].content)

            # Assert that outputs contain our dummy response twice
            assert outputs == ["dummy response", "dummy response"]


