from unittest.mock import patch

# We will mock the internal model client's invoke method to return a dummy AIMessage-like object
# but do not mock the PostgresSaver or the graph streaming logic itself.

class DummyAIMessage:
    def __init__(self, content):
        self.content = content
        self.role = "assistant"

    def pretty_print(self):
        # For test output visibility
        print(f"AIMessage(role={self.role}, content={self.content})")

    def __repr__(self):
        return f"DummyAIMessage(role={self.role}, content={self.content})"

@pytest.fixture(scope="module")
def db_uri():
    # Use environment variable or default for Postgres connection string
    # The test requires a running Postgres instance accessible at this URI
    return os.getenv("TEST_POSTGRES_URI", "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable")

@pytest.mark.skipif(
    not os.getenv("TEST_POSTGRES_URI"),
    reason="TEST_POSTGRES_URI environment variable not set, skipping Postgres integration test",
)
def test_postgres_saver_serialization(db_uri):
    # Patch the model.invoke to return a DummyAIMessage instead of a real AIMessage
    # This avoids dependency on actual LLM calls and ensures the returned object is consistent
    # The bug is about JSON serialization of AIMessage, so we simulate that with DummyAIMessage

    # Create a dummy ChatModel with invoke patched
    class DummyModel(ChatModel):
        def invoke(self, messages):
            # Return a DummyAIMessage object simulating the LLM response
            return DummyAIMessage("Hello from dummy model")

    model = DummyModel()

    with PostgresSaver.from_conn_string(db_uri) as checkpointer:
        # Setup the checkpointer schema
        checkpointer.setup()

        def call_model(state: MessagesState):
            # Call the dummy model with the messages from state
            response = model.invoke(state["messages"])
            # Return dictionary with "messages" key containing the DummyAIMessage object
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test-thread-1"
            }
        }

        # Run the graph stream with initial user message
        # This should not raise serialization errors after the fix
        chunks = list(graph.stream(
            {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
            config,
            stream_mode="values"
        ))

        # Assert that chunks were produced and contain DummyAIMessage instances
        assert len(chunks) > 0
        last_chunk = chunks[-1]
        # The last chunk's "messages" should be a DummyAIMessage instance
        assert "messages" in last_chunk
        assert isinstance(last_chunk["messages"], DummyAIMessage)

        # Also test a second query to ensure no serialization error on subsequent calls
        chunks2 = list(graph.stream(
            {"messages": [{"role": "user", "content": "what's my name?"}]},
            config,
            stream_mode="values"
        ))
        assert len(chunks2) > 0
        last_chunk2 = chunks2[-1]
        assert "messages" in last_chunk2
        assert isinstance(last_chunk2["messages"], DummyAIMessage)[0m
