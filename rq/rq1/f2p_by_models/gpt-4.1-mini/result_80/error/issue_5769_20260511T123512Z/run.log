[32mimport pytest
import os
import sys
import asyncio
from unittest.mock import patch

from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from langchain.chat_models import init_chat_model

# We will mock the internal model client's invoke method to avoid real API calls
# and return a dummy AIMessage-like object that simulates the real response.

class DummyAIMessage:
    def __init__(self, content="dummy response"):
        self.content = content
        self.role = "assistant"
    def pretty_print(self):
        # simulate the method used in the example
        print(f"{self.role}: {self.content}")

class DummyModel:
    def invoke(self, messages):
        # Return a dummy AIMessage object instead of a real one
        return DummyAIMessage(content="This is a dummy response")

@pytest.mark.skipif(
    "POSTGRES_URI" not in os.environ,
    reason="POSTGRES_URI environment variable not set for Postgres connection"
)
def test_postgres_saver_json_serialization_issue():
    """
    This test reproduces the JSON serialization error when using PostgresSaver
    with a node returning AIMessage objects. It should fail on buggy code (TypeError)
    and pass after fix (no exception).
    """
    DB_URI = os.environ["POSTGRES_URI"]
    model = DummyModel()

    with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
        # checkpointer.setup()  # optional, but usually needed

        def call_model(state: MessagesState):
            response = model.invoke(state["messages"])
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test_thread"
            }
        }

        # We run the graph streaming twice with different inputs,
        # expecting no serialization error after fix.

        # Collect outputs to verify they are DummyAIMessage instances
        outputs = []

        # First run
        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
            config,
            stream_mode="values"
        ):
            # The last message should be DummyAIMessage
            msg = chunk["messages"][-1]
            assert isinstance(msg, DummyAIMessage)
            outputs.append(msg.content)
            # Also test pretty_print does not error
            msg.pretty_print()

        # Second run
        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "what's my name?"}]},
            config,
            stream_mode="values"
        ):
            msg = chunk["messages"][-1]
            assert isinstance(msg, DummyAIMessage)
            outputs.append(msg.content)
            msg.pretty_print()

        # Check that outputs contain expected dummy response strings
        assert outputs == ["This is a dummy response", "This is a dummy response"]


@pytest.mark.asyncio
async def test_postgres_saver_async_json_serialization_issue():
    """
    Async version of the test to ensure async PostgresSaver also does not raise
    JSON serialization errors with AIMessage-like objects.
    """
    import langgraph.checkpoint.postgres.aio as pg_aio
    from langgraph.graph import StateGraph, MessagesState, START

    DB_URI = os.environ.get("POSTGRES_URI")
    if not DB_URI:
        pytest.skip("POSTGRES_URI environment variable not set")

    model = DummyModel()

    async with pg_aio.AsyncPostgresSaver.from_conn_string(DB_URI) as checkpointer:
        # checkpointer.setup()  # optional

        def call_model(state: MessagesState):
            response = model.invoke(state["messages"])
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test_thread_async"
            }
        }

        outputs = []

        async for chunk in graph.stream_async(
            {"messages": [{"role": "user", "content": "hello async"}]},
            config,
            stream_mode="values"
        ):
            msg = chunk["messages"][-1]
            assert isinstance(msg, DummyAIMessage)
            outputs.append(msg.content)
            msg.pretty_print()

        async for chunk in graph.stream_async(
            {"messages": [{"role": "user", "content": "what's async name?"}]},
            config,
            stream_mode="values"
        ):
            msg = chunk["messages"][-1]
            assert isinstance(msg, DummyAIMessage)
            outputs.append(msg.content)
            msg.pretty_print()

        assert outputs == ["This is a dummy response", "This is a dummy response"][0m
