[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set Forge API environment variables for OpenAI and Anthropic SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set build arg for Forge API key to be used in ENV
ARG FORGE_API_KEY=forge-key
ENV FORGE_API_KEY=$FORGE_API_KEY

WORKDIR /app

COPY . .

# Upgrade pip and setuptools
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies needed for python packages (compilation, database, etc.)
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    libsqlite3-dev \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies, fallback if requirements.txt not found
RUN if [ -f requirements.txt ]; then \
        pip install -r requirements.txt; \
    elif [ -f libs/langgraph/requirements.txt ]; then \
        pip install -r libs/langgraph/requirements.txt; \
    else \
        echo "No requirements.txt found, skipping."; \
    fi

# Install required test tooling and runtime packages including missing ones like redis, nbconvert, numpy, psycopg_pool, sqlite_vec
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio \
    "setuptools<=81.0.0" litellm bs4 mkdocs nbformat nbconvert \
    psycopg[binary] psycopg_pool aiosqlite sqlite_vec numpy redis

# Install the local langgraph package in editable mode to avoid import errors
RUN pip install -e libs/langgraph

# Basic sanity check to confirm critical packages are available
RUN python -c 'import pkg_resources, pytest, redis, nbconvert, psycopg_pool, sqlite_vec, numpy; print("preflight ok")'

# Use default shell to run container with interactive bash prompt
CMD ["/bin/bash"]

# branch: python/requirements.txt with robust dependency handling and Forge API environment vars
