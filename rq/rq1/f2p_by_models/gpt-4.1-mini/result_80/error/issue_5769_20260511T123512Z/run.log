[32mimport os
import pytest
from langchain.chat_models import ChatOpenAI
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from unittest.mock import patch

# We will mock the internal model client's invoke method to avoid real API calls
# but we will not mock the PostgresSaver or graph logic, so the serialization error can manifest.

DB_URI = os.environ.get(
    "TEST_POSTGRES_URI", "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable"
)

@pytest.mark.skipif(
    not DB_URI.startswith("postgresql://"),
    reason="Postgres URI not configured for test",
)
def test_postgres_saver_serialization_issue():
    # Initialize a dummy chat model with a mock invoke method
    model = ChatOpenAI(model_name="gpt-4", temperature=0)

    # Patch the internal _call method to return a fixed response to avoid network calls
    with patch.object(model, "_call", return_value={"choices": [{"message": {"role": "assistant", "content": "Hello from mock"}}]}):
        with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
            # Define a node function that calls the model and returns the raw messages (AIMessage objects)
            def call_model(state: MessagesState):
                response = model.invoke(state["messages"])
                return {"messages": response}

            builder = StateGraph(MessagesState)
            builder.add_node(call_model)
            builder.add_edge(START, "call_model")

            graph = builder.compile(checkpointer=checkpointer)

            config = {
                "configurable": {
                    "thread_id": "test-thread"
                }
            }

            # Run the graph streaming with initial input to trigger checkpoint saving
            # This should fail on buggy code due to AIMessage not being JSON serializable
            results = []
            for chunk in graph.stream(
                {"messages": [{"role": "user", "content": "Hi, test message"}]},
                config,
                stream_mode="values"
            ):
                results.append(chunk)

            # Assert that results contain expected structure and that no serialization error occurred
            assert len(results) > 0
            last_messages = results[-1]["messages"]
            # The last message should be a list of dicts or similar serializable structure, not raw AIMessage
            # We check that the last message is a dict with role and content keys
            assert isinstance(last_messages, list)
            assert all(isinstance(m, dict) for m in last_messages)
            assert "role" in last_messages[-1]
            assert "content" in last_messages[-1]

            # Run a second stream to ensure multiple runs work without error
            results2 = []
            for chunk in graph.stream(
                {"messages": [{"role": "user", "content": "What is your name?"}]},
                config,
                stream_mode="values"
            ):
                results2.append(chunk)

            assert len(results2) > 0
            last_messages2 = results2[-1]["messages"]
            assert isinstance(last_messages2, list)
            assert all(isinstance(m, dict) for m in last_messages2)
            assert "role" in last_messages2[-1]
            assert "content" in last_messages2[-1][0m
