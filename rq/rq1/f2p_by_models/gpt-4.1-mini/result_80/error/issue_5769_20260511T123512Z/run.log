[32mimport os
import pytest
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from langchain.chat_models import init_chat_model

@pytest.mark.skipif(
    "POSTGRES_URI" not in os.environ,
    reason="POSTGRES_URI environment variable not set, skipping PostgresSaver integration test",
)
def test_postgres_saver_serialization_issue():
    """
    This test reproduces the JSON serialization issue with PostgresSaver
    when saving AIMessage objects in checkpoint metadata.

    It uses a real PostgresSaver instance connected to a test database.

    The test will fail on the buggy codebase with a TypeError about AIMessage not being JSON serializable.
    After applying the fix, the test should pass.
    """
    # Use environment variable for DB URI or fallback to default local test URI
    DB_URI = os.environ.get("POSTGRES_URI", "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable")

    # Initialize a dummy chat model that returns a simple dict with string messages
    # We mock the internal model.invoke to avoid real API calls and return a string message
    model = init_chat_model(model="anthropic:claude-3-5-haiku-latest")

    # Patch model.invoke to return a simple serializable dict instead of AIMessage to isolate the test to PostgresSaver
    original_invoke = model.invoke
    def dummy_invoke(messages):
        # Return a list of dicts (serializable) imitating messages
        return [{"role": "assistant", "content": "dummy response"}]
    model.invoke = dummy_invoke

    with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
        # We do not call checkpointer.setup() because from_conn_string should handle it

        def call_model(state: MessagesState):
            response = model.invoke(state["messages"])
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test-thread"
            }
        }

        # Run the graph stream twice with different inputs to trigger checkpoint saves
        outputs = []
        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
            config,
            stream_mode="values"
        ):
            outputs.append(chunk)

        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "what's my name?"}]},
            config,
            stream_mode="values"
        ):
            outputs.append(chunk)

        # Assert that outputs contain expected keys and are serializable
        # The buggy code will raise TypeError during checkpoint saving, so this line won't be reached there
        assert all("messages" in chunk for chunk in outputs)
        # The last message content should be the dummy response string
        assert outputs[-1]["messages"][-1]["content"] == "dummy response"

    # Restore original invoke method
    model.invoke = original_invoke[0m
