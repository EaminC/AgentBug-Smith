[32mimport os
import pytest
from langchain_core.runnables import RunnableConfig
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from langchain.schema import AIMessage

import builtins

# We will mock the model's invoke method to return AIMessage objects to simulate the bug.
class DummyModel:
    def invoke(self, messages):
        # Return an AIMessage instance, which is not JSON serializable by default
        return AIMessage(content="This is a dummy AI message")

@pytest.mark.skipif(
    os.getenv("POSTGRES_TEST_URI") is None,
    reason="POSTGRES_TEST_URI environment variable not set",
)
def test_postgres_saver_serialization_issue():
    """
    This test reproduces the JSON serialization error when using PostgresSaver with
    a node returning AIMessage objects. It should fail before the fix and pass after.
    """
    DB_URI = os.getenv("POSTGRES_TEST_URI")
    model = DummyModel()

    with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
        # We do not call checkpointer.setup() here because from_conn_string should handle it.

        def call_model(state: MessagesState):
            response = model.invoke(state["messages"])
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test-thread"
            }
        }

        # The first call with a user message
        input_1 = {"messages": [{"role": "user", "content": "Hello"}]}
        # The second call with another user message
        input_2 = {"messages": [{"role": "user", "content": "What is my name?"}]}

        # We expect the streaming to run without JSON serialization errors.
        # The buggy code will raise TypeError: Object of type AIMessage is not JSON serializable
        # The fixed code will pass.

        # Consume the stream fully to trigger all internal saves
        results_1 = list(graph.stream(input_1, config, stream_mode="values"))
        results_2 = list(graph.stream(input_2, config, stream_mode="values"))

        # Assert that the returned chunks contain AIMessage instances in the "messages" key
        for chunk in results_1 + results_2:
            assert "messages" in chunk
            # The last message should be an AIMessage instance
            assert isinstance(chunk["messages"][-1], AIMessage)

        # Additionally, check that the messages content matches expected dummy content
        assert results_1[-1]["messages"][-1].content == "This is a dummy AI message"
        assert results_2[-1]["messages"][-1].content == "This is a dummy AI message"[0m
