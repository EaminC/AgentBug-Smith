[32mimport os
import pytest
from langchain.chat_models import ChatOpenAI
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from unittest.mock import patch

# We will mock the internal model client's invoke method to avoid real API calls.
# We do not mock the call_model function or PostgresSaver methods to ensure the real code runs.

DB_URI = os.environ.get(
    "LANGGRAPH_TEST_POSTGRES_URI",
    "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable",
)

@pytest.mark.skipif(
    not DB_URI.startswith("postgresql://"),
    reason="Postgres URI not configured for testing",
)
def test_postgres_saver_serialization_issue():
    # Initialize the chat model with a dummy model that returns a fixed response
    model = ChatOpenAI(model_name="gpt-3.5-turbo", temperature=0)

    # Patch the internal _client method to avoid real network calls and return a dummy response
    # We patch the _client attribute's chat.completions.create method inside ChatOpenAI
    # to return a dummy response with the expected structure.
    class DummyResponse:
        def __init__(self):
            self.choices = [type("Choice", (), {"message": {"role": "assistant", "content": "Hello from dummy model"}})()]

    class DummyClient:
        def __init__(self):
            self.chat = self
            self.completions = self

        def create(self, *args, **kwargs):
            return DummyResponse()

    with patch.object(model, "_client", DummyClient()):
        with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
            # Do not call setup() to avoid side effects; assume DB is ready.

            def call_model(state: MessagesState):
                response = model.invoke(state["messages"])
                return {"messages": response}

            builder = StateGraph(MessagesState)
            builder.add_node(call_model)
            builder.add_edge(START, "call_model")

            graph = builder.compile(checkpointer=checkpointer)

            config = {
                "configurable": {
                    "thread_id": "test-thread-1"
                }
            }

            # Run the graph stream with initial input and collect outputs
            outputs = []
            for chunk in graph.stream(
                {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
                config,
                stream_mode="values"
            ):
                outputs.append(chunk)

            # Run the graph stream again with a follow-up input
            outputs2 = []
            for chunk in graph.stream(
                {"messages": [{"role": "user", "content": "what's my name?"}]},
                config,
                stream_mode="values"
            ):
                outputs2.append(chunk)

            # Assert that outputs contain messages with expected structure
            assert outputs, "No output chunks from first stream"
            assert outputs2, "No output chunks from second stream"

            # Check that the last message in outputs is a dict with role and content keys
            last_msg = outputs[-1]["messages"][-1]
            assert isinstance(last_msg, dict), "Last message should be a dict"
            assert "role" in last_msg and "content" in last_msg, "Last message missing keys"

            last_msg2 = outputs2[-1]["messages"][-1]
            assert isinstance(last_msg2, dict), "Last message of second stream should be a dict"
            assert "role" in last_msg2 and "content" in last_msg2, "Last message of second stream missing keys"

            # This test will fail on buggy code due to serialization error,
            # and pass after the fix that ensures AIMessage is converted properly.

if __name__ == "__main__":
    pytest.main([__file__])[0m
