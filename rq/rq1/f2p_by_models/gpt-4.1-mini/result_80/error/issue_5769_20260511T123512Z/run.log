import pytest
from langchain_core.runnables import RunnableConfig
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from langchain.schema import AIMessage

# We will mock the model.invoke method to avoid real network calls
import builtins
from unittest.mock import patch, MagicMock

DB_URI = os.environ.get("POSTGRES_TEST_URI", "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable")

@pytest.mark.skipif(
    DB_URI is None or DB_URI == "",
    reason="POSTGRES_TEST_URI environment variable not set",
)
def test_postgres_saver_serialization_issue():
    """
    This test reproduces the JSON serialization error when using PostgresSaver with a node returning AIMessage.
    It should fail on the buggy codebase with TypeError about AIMessage not being JSON serializable,
    and pass after the fix is applied.
    """
    # Initialize the model and patch its invoke method to return a dummy AIMessage list
    from langchain.chat_models import init_chat_model
    model = init_chat_model(model="anthropic:claude-3-5-haiku-latest")

    # Patch model.invoke to return a list of AIMessage instances (simulate a response)
    dummy_response = [AIMessage(content="dummy response")]

    with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
        # Do not call setup() explicitly; context manager should handle it

        def call_model(state: MessagesState):
            # The real method is called, but model.invoke is patched
            response = model.invoke(state["messages"])
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "1"
            }
        }

        # Patch model.invoke to return dummy_response
        with patch.object(model, "invoke", return_value=dummy_response):
            # Run the graph streaming for first input
            chunks1 = list(
                graph.stream(
                    {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
                    config,
                    stream_mode="values",
                )
            )
            # The last message in the last chunk should be an AIMessage with content "dummy response"
            assert isinstance(chunks1[-1]["messages"][-1], AIMessage)
            assert chunks1[-1]["messages"][-1].content == "dummy response"

            # Run the graph streaming for second input
            chunks2 = list(
                graph.stream(
                    {"messages": [{"role": "user", "content": "what's my name?"}]},
                    config,
                    stream_mode="values",
                )
            )
            assert isinstance(chunks2[-1]["messages"][-1], AIMessage)
            assert chunks2[-1]["messages"][-1].content == "dummy response"[0m
