[32mimport os
import pytest
from langchain.chat_models import ChatOpenAI
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from unittest.mock import patch

@pytest.mark.skipif(
    "POSTGRES_TEST_URI" not in os.environ,
    reason="POSTGRES_TEST_URI environment variable not set",
)
def test_postgres_saver_serialization_issue():
    """
    This test reproduces the JSON serialization error when using PostgresSaver with
    a real LLM message object in the checkpoint metadata.

    It should fail on the buggy codebase with a TypeError about AIMessage not being JSON serializable,
    and pass after the fix is applied.
    """
    # Use environment variable for Postgres URI to avoid hardcoding credentials
    DB_URI = os.environ["POSTGRES_TEST_URI"]

    # Initialize a dummy chat model that returns a simple dict with a message-like object
    # We patch the internal model client call to avoid real API calls and to control the output
    model = ChatOpenAI(model_name="gpt-4", temperature=0)

    # Patch the model.invoke to return a dummy AIMessage-like object
    # We do NOT patch PostgresSaver or the graph.stream method itself
    class DummyAIMessage:
        def __init__(self, content):
            self.content = content
            self.role = "assistant"
        def pretty_print(self):
            return f"Role: {self.role}, Content: {self.content}"
        def __repr__(self):
            return f"DummyAIMessage(content={self.content!r})"

    def dummy_invoke(messages):
        # Return a list of DummyAIMessage objects to simulate the real response
        return [DummyAIMessage("Hello from dummy model")]

    # Use PostgresSaver with context manager to ensure cleanup
    with PostgresSaver.from_conn_string(DB_URI) as checkpointer:
        # Setup is optional; uncomment if needed
        # checkpointer.setup()

        def call_model(state: MessagesState):
            response = dummy_invoke(state["messages"])
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test-thread"
            }
        }

        # Run the graph stream twice with different inputs to trigger checkpoint saving
        # We collect the output messages to verify they are DummyAIMessage instances
        outputs = []
        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
            config,
            stream_mode="values"
        ):
            outputs.append(chunk["messages"][-1])

        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "what's my name?"}]},
            config,
            stream_mode="values"
        ):
            outputs.append(chunk["messages"][-1])

        # Assert that all outputs are instances of DummyAIMessage
        assert all(isinstance(msg, DummyAIMessage) for msg in outputs)

        # Assert that the content of the last message is as expected
        assert outputs[-1].content == "Hello from dummy model"

        # If the test reaches this point without serialization errors,
        # it means the fix is applied and the test passes.

# Note:
# To run this test, set environment variable POSTGRES_TEST_URI to a valid Postgres connection string,
# e.g. postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable
# This avoids hardcoding credentials and allows the test to run in CI environments with proper setup.[0m
