[32mimport os
import pytest
from langchain.chat_models import ChatOpenAI
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from unittest.mock import patch

# We mock the internal model client's network call to avoid real API calls.
# We do not mock the model.invoke method itself to ensure real method runs.
# We patch the internal _call method of ChatOpenAI to return a dummy AIMessage.

@pytest.fixture(scope="module")
def postgres_uri():
    # Use environment variable or default for local Postgres test instance
    return os.getenv("TEST_POSTGRES_URI", "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable")

@pytest.fixture(scope="module")
def model():
    # Initialize the chat model with a dummy model name
    # We will patch its internal call to avoid network
    return ChatOpenAI(model="gpt-4", temperature=0)

class DummyAIMessage:
    def __init__(self, content="dummy response"):
        self.content = content
        self.role = "assistant"
    def __repr__(self):
        return f"AIMessage(content={self.content!r})"
    def pretty_print(self):
        # mimic the interface used in example
        print(f"{self.role}: {self.content}")

@pytest.mark.skipif(
    os.getenv("TEST_POSTGRES_URI") is None,
    reason="TEST_POSTGRES_URI environment variable not set for Postgres connection"
)
def test_postgres_saver_serialization(postgres_uri, model):
    # Patch the internal _call method of ChatOpenAI to return DummyAIMessage
    # This avoids real network calls and ensures consistent output.
    with patch.object(
        model._client,
        "chat.completions.create",
        return_value={
            "choices": [{"message": {"role": "assistant", "content": "Hello from dummy"}}]
        },
    ):
        with PostgresSaver.from_conn_string(postgres_uri) as checkpointer:
            # We do not call checkpointer.setup() explicitly because from_conn_string does it.

            def call_model(state: MessagesState):
                # The model.invoke returns AIMessage normally, but here it will be patched
                response = model.invoke(state["messages"])
                return {"messages": response}

            builder = StateGraph(MessagesState)
            builder.add_node(call_model)
            builder.add_edge(START, "call_model")

            graph = builder.compile(checkpointer=checkpointer)

            config = {
                "configurable": {
                    "thread_id": "test-thread-1"
                }
            }

            # Run the graph stream for two inputs and collect outputs
            outputs1 = []
            for chunk in graph.stream(
                {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
                config,
                stream_mode="values"
            ):
                # The last message should have pretty_print method
                # We collect the content for assertion
                msg = chunk["messages"][-1]
                outputs1.append(msg.content)

            outputs2 = []
            for chunk in graph.stream(
                {"messages": [{"role": "user", "content": "what's my name?"}]},
                config,
                stream_mode="values"
            ):
                msg = chunk["messages"][-1]
                outputs2.append(msg.content)

            # Assert that outputs are not empty and contain expected dummy content
            assert outputs1, "First stream produced no output"
            assert outputs2, "Second stream produced no output"
            # The dummy patched response content is "Hello from dummy"
            assert any("Hello from dummy" in out for out in outputs1)
            assert any("Hello from dummy" in out for out in outputs2)[0m
