COPY . .

# Upgrade pip and setuptools
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies needed for common Python packages
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    libsqlite3-dev \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# Install project requirements if requirements.txt exists
RUN if [ -f "libs/langgraph/requirements.txt" ]; then \
        pip install -r libs/langgraph/requirements.txt ; \
    fi

# Install missing dependencies reported by tests and others explicitly
RUN pip install \
    pytest pytest-mock pytest-asyncio pytest-cov anyio \
    "setuptools<=81.0.0" litellm \
    bs4 mkdocs nbformat \
    psycopg[aio] aiosqlite dataclasses_json

# Install the project itself editable
RUN pip install -e libs/langgraph

# Preflight test to confirm installations
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]
