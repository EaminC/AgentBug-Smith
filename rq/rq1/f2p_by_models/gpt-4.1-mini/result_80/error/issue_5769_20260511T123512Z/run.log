[32mimport os
import pytest
import psycopg
from langchain_core.runnables import RunnableConfig
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver
from langchain.chat_models import ChatOpenAI
from langchain.schema import AIMessage

# We use ChatOpenAI with a dummy model to avoid real API calls.
# The test will mock the model's invoke method to return a fixed AIMessage.
# This ensures the test is deterministic and does not require network or API keys.

@pytest.fixture(scope="module")
def postgres_uri():
    # The test expects a local Postgres instance running with this URI.
    # Adjust as needed for your environment.
    return os.environ.get("TEST_POSTGRES_URI", "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable")

@pytest.fixture(scope="module")
def model(monkeypatch):
    # Create a dummy ChatOpenAI instance
    model = ChatOpenAI(model_name="gpt-4", temperature=0)

    # Patch the invoke method to return a fixed AIMessage
    def dummy_invoke(messages):
        # Return a list with a single AIMessage
        return [AIMessage(content="Hello from dummy model")]

    monkeypatch.setattr(model, "invoke", dummy_invoke)
    return model

def test_postgres_saver_serialization(postgres_uri, model):
    # This test reproduces the bug where AIMessage is not JSON serializable
    # when using PostgresSaver as checkpointer.
    # Before the fix, this test should fail with TypeError.
    # After the fix, it should pass.

    with PostgresSaver.from_conn_string(postgres_uri) as checkpointer:
        # Setup is optional; uncomment if needed
        # checkpointer.setup()

        def call_model(state: MessagesState):
            response = model.invoke(state["messages"])
            return {"messages": response}

        builder = StateGraph(MessagesState)
        builder.add_node(call_model)
        builder.add_edge(START, "call_model")

        graph = builder.compile(checkpointer=checkpointer)

        config = {
            "configurable": {
                "thread_id": "test-thread-1"
            }
        }

        # Run the graph stream with initial input
        # We expect no exceptions, especially no TypeError for serialization
        outputs = []
        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "hi! I'm bob"}]},
            config,
            stream_mode="values"
        ):
            # Collect output messages content for assertion
            msgs = chunk["messages"]
            assert isinstance(msgs, list)
            assert all(isinstance(m, AIMessage) for m in msgs)
            outputs.append(msgs[-1].content)

        # Run the graph stream again with a different input
        for chunk in graph.stream(
            {"messages": [{"role": "user", "content": "what's my name?"}]},
            config,
            stream_mode="values"
        ):
            msgs = chunk["messages"]
            assert isinstance(msgs, list)
            assert all(isinstance(m, AIMessage) for m in msgs)
            outputs.append(msgs[-1].content)

        # Check that outputs contain the dummy model response
        assert all("Hello from dummy model" == content for content in outputs)[0m
