[32mimport os
import pytest
from langchain.chat_models import ChatModel
from langchain.schema import AIMessage
from langgraph.graph import StateGraph, MessagesState, START
from langgraph.checkpoint.postgres import PostgresSaver

# We will mock the ChatModel.invoke method to avoid real API calls
# but not mock the PostgresSaver or graph streaming to test the serialization issue.

@pytest.fixture(scope="module")
def model():
    # Create a dummy ChatModel with a mocked invoke method
    class DummyChatModel(ChatModel):
        def invoke(self, messages):
            # Return an AIMessage instance to simulate LLM response
            return AIMessage(content="Hello from dummy model", role="assistant")
    return DummyChatModel()

@pytest.fixture(scope="module")
def checkpointer():
    # Use environment variable or default for DB URI
    DB_URI = os.getenv("POSTGRES_TEST_URI", "postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable")
    with PostgresSaver.from_conn_string(DB_URI) as saver:
        # Setup the database schema if needed
        saver.setup()
        yield saver

def test_postgres_saver_serialization(model, checkpointer):
    """
    This test reproduces the JSON serialization error when using PostgresSaver with
    a graph that returns AIMessage objects in the state.
    The test should fail on the buggy codebase with TypeError and pass after the fix.
    """
    def call_model(state: MessagesState):
        # The node returns a dict with "messages" key holding AIMessage
        response = model.invoke(state["messages"])
        return {"messages": response}

    builder = StateGraph(MessagesState)
    builder.add_node(call_model)
    builder.add_edge(START, "call_model")

    graph = builder.compile(checkpointer=checkpointer)

    config = {
        "configurable": {
            "thread_id": "test-thread"
        }
    }

    # Run the graph stream for the first input
    input_1 = {"messages": [{"role": "user", "content": "hi! I'm bob"}]}
    chunks_1 = list(graph.stream(input_1, config, stream_mode="values"))
    # The last chunk should contain messages with AIMessage type
    last_messages_1 = chunks_1[-1]["messages"]
    assert isinstance(last_messages_1[-1], AIMessage)
    assert last_messages_1[-1].content == "Hello from dummy model"

    # Run the graph stream for the second input
    input_2 = {"messages": [{"role": "user", "content": "what's my name?"}]}
    chunks_2 = list(graph.stream(input_2, config, stream_mode="values"))
    last_messages_2 = chunks_2[-1]["messages"]
    assert isinstance(last_messages_2[-1], AIMessage)
    assert last_messages_2[-1].content == "Hello from dummy model"

    # If no exception is raised, the test passes
    # The buggy codebase raises TypeError: AIMessage not JSON serializable

# Note: This test requires a running Postgres instance accessible by the DB_URI.
# The test will fail on buggy code due to serialization error and pass after the fix.[0m
