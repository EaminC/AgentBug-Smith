[32mimport asyncio
import pytest

from agentscope.agent._react_agent import ReActAgent
from agentscope.message import Msg


class DummyMemory:
    def __init__(self):
        self.records = []

    async def add(self, msg):
        self.records.append(msg)


@pytest.mark.asyncio
async def test_static_control_records_longterm_memory_with_structured_output():
    """
    Test that under static_control mode, when structured_output is generated,
    the reply message is recorded to longterm memory.

    Buggy behavior: no record added to memory under static_control mode.
    Fixed behavior: record is added.
    """
    # Create a dummy memory to track additions
    dummy_memory = DummyMemory()

    # Create the agent with static_control enabled and dummy memory
    agent = ReActAgent(
        name="test_agent",
        memory=dummy_memory,
        max_iters=3,
        _static_control=True,
    )

    # Patch _reasoning to simulate structured output with text content
    # We simulate that the agent generates structured_output and a text reply
    async def fake_reasoning(tool_choice):
        # Return a Msg with text content and structured_output metadata
        return Msg(
            "test_agent",
            ["This is a structured output reply."],
            "assistant",
            metadata={"structured": "output"},
        )

    # Patch _summarizing to avoid actual summarizing
    async def fake_summarizing():
        return Msg(
            "test_agent",
            ["Summary reply."],
            "assistant",
            metadata={"summary": True},
        )

    agent._reasoning = fake_reasoning
    agent._summarizing = fake_summarizing

    # Run the agent's main call to produce a reply message
    reply = await agent._call(tool_choice=None)

    # The reply should be a Msg instance with the expected text and metadata
    assert isinstance(reply, Msg)
    assert reply.metadata is not None
    assert "structured" in reply.metadata

    # The dummy memory should have recorded the reply message
    # Buggy: dummy_memory.records is empty
    # Fixed: dummy_memory.records contains the reply
    assert len(dummy_memory.records) == 1
    assert dummy_memory.records[0] == reply

    # Also verify the reply content matches what fake_reasoning returned
    assert "structured output reply" in reply.content[0].lower() or "summary" in reply.content[0].lower()


