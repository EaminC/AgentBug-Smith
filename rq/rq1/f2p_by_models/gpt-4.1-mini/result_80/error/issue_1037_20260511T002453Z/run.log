    )
    agent._static_control = True

    reply_msg = await agent.run(tool_choice=None)

    # The reply message metadata should be None or empty
    assert reply_msg.metadata is None or reply_msg.metadata == {}

    # The dummy memory should have recorded the reply message once
    assert len(dummy_memory.records) == 1
    recorded_msg = dummy_memory.records[0]
    assert recorded_msg == reply_msg

