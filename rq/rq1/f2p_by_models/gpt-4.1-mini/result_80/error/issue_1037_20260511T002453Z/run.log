[32mimport asyncio
import pytest

from agentscope.agent._react_agent import ReActAgent
from agentscope.message import Msg
from agentscope.memory import MemoryBase


class DummyMemory(MemoryBase):
    def __init__(self):
        super().__init__()
        self.added_messages = []

    async def add(self, msg: Msg):
        self.added_messages.append(msg)


@pytest.mark.asyncio
async def test_static_control_mode_records_longterm_memory_with_structured_output():
    """
    This test verifies that under static_control mode with structured_output enabled,
    the ReActAgent records the reply message to longterm memory when the reply condition is met.

    Buggy behavior: The message is not recorded to longterm memory under static_control mode.
    Fixed behavior: The message is recorded to longterm memory.
    """

    # Setup dummy memory to capture added messages
    dummy_memory = DummyMemory()

    # Create a ReActAgent instance with static_control=True and a dummy memory
    agent = ReActAgent(
        name="test_agent",
        memory=dummy_memory,
        max_iters=3,
        structured_output=True,
        static_control=True,
    )

    # Patch _reasoning and _summarizing to simulate structured output and reply message
    async def fake_reasoning(tool_choice):
        # Return a Msg with structured output metadata and text content
        return Msg(
            "test_agent",
            content_blocks=["structured output text"],
            role="assistant",
            metadata={"structured_output": {"key": "value"}},
        )

    async def fake_summarizing():
        return Msg(
            "test_agent",
            content_blocks=["summary text"],
            role="assistant",
            metadata={"structured_output": {"summary": True}},
        )

    agent._reasoning = fake_reasoning
    agent._summarizing = fake_summarizing

    # Run the agent's reasoning loop (the main entry point)
    reply_msg = await agent.run()

    # Assert that the reply message is returned and has structured output metadata
    assert reply_msg is not None
    assert reply_msg.metadata is not None
    assert "structured_output" in reply_msg.metadata

    # Assert that the dummy memory recorded the reply message (longterm memory)
    # This is the key check: under static_control mode with structured_output,
    # the reply message should be added to memory.
    assert len(dummy_memory.added_messages) > 0
    assert any(
        "structured_output" in m.metadata for m in dummy_memory.added_messages
    ), "Reply message with structured output should be recorded to longterm memory"


if __name__ == "__main__":
    asyncio.run(test_static_control_mode_records_longterm_memory_with_structured_output())[0m
