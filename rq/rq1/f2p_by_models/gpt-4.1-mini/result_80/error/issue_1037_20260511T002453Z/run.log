class DummyModelNoStructured:
    """
    Dummy model that simulates no structured output generated.
    """

    async def __call__(self, *args, **kwargs):
        # Return a Msg without structured output metadata
        return Msg(
            "dummy_model",
            content_blocks={"text": ["dummy text response"]},
            role="assistant",
            metadata=None,
        )


class DummyFormatter:
    """
    Dummy formatter that does nothing special.
    """

    def format(self, *args, **kwargs):
        return "formatted"


@pytest.mark.asyncio
async def test_static_control_records_longterm_memory_with_structured_output():
    """
    Test that under static_control mode, when structured_output is generated,
    the reply message is recorded to longterm memory.

    Buggy behavior: no record added to memory under static_control mode.
    Fixed behavior: record is added.
    """
    dummy_memory = DummyMemory()

    # Create the agent with static_control enabled and dummy memory
    # Provide required sys_prompt, model, formatter arguments
    sys_prompt = "system prompt"
    model = DummyModelWithStructuredOutput()
    formatter = DummyFormatter()

    agent = ReActAgent(
        name="test_agent",
        sys_prompt=sys_prompt,
        model=model,
        formatter=formatter,
        memory=dummy_memory,
        max_iters=3,
    )
    # Enable static_control mode explicitly
    agent._static_control = True

    # We call the async _run method that triggers the reasoning loop
    # Provide minimal tool_choice argument (None or empty)
    # The method to run the agent is _run (not run)
    reply_msg = await agent._run(tool_choice=None)

    # Check that the reply message has structured output metadata
    assert reply_msg.metadata is not None
    assert "structured_output" in reply_msg.metadata

    # Check that the dummy memory recorded the reply message
    # The fix ensures memory.add is called with the reply message
    assert len(dummy_memory.added_messages) == 1
    assert dummy_memory.added_messages[0] == reply_msg


@pytest.mark.asyncio
async def test_static_control_no_duplicate_memory_add_when_no_structured_output():
    """
    Test that under static_control mode, if no structured output is generated,
    the agent still returns a reply and records it once.

    This test ensures no duplicate or missing memory additions.
    """
    dummy_memory = DummyMemory()

    sys_prompt = "system prompt"
    model = DummyModelNoStructured()
    formatter = DummyFormatter()

    agent = ReActAgent(
        name="test_agent",
        sys_prompt=sys_prompt,
        model=model,
        formatter=formatter,
        memory=dummy_memory,
        max_iters=1,
    )
    agent._static_control = True

    reply_msg = await agent._run(tool_choice=None)

    # The reply message should not have structured output metadata
    assert reply_msg.metadata is None or "structured_output" not in reply_msg.metadata

    # The memory should have exactly one added message (the reply)
    assert len(dummy_memory.added_messages) == 1
    assert dummy_memory.added_messages[0] == reply_msg[0m
