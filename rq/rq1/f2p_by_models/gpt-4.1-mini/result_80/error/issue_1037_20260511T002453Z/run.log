[32mimport asyncio
import pytest
from unittest.mock import AsyncMock, patch

from src.agentscope.agent._react_agent import ReActAgent
from src.agentscope.message import Msg


class DummyMemory:
    def __init__(self):
        self.added_messages = []

    async def add(self, msg):
        self.added_messages.append(msg)


@pytest.mark.asyncio
async def test_static_control_mode_records_longterm_memory_with_structured_output():
    """
    This test verifies that under static_control mode with structured output enabled,
    the ReActAgent records the reply message to longterm memory when the reply condition is met.

    Buggy behavior: The message is not recorded to longterm memory under static_control mode.
    Fixed behavior: The message is recorded to longterm memory.
    """

    dummy_memory = DummyMemory()

    # We create the agent with static control mode enabled by setting _static_control attribute after init,
    # because the constructor does not accept static_control argument.
    agent = ReActAgent(name="test_agent", memory=dummy_memory, max_iters=3)
    agent._static_control = True

    # Patch _reasoning to simulate structured output generation and text content
    # The _reasoning method returns a Msg with structured_output metadata and text content
    structured_output = {"key": "value"}

    async def fake_reasoning(tool_choice):
        return Msg(
            sender="test_agent",
            content=["This is a structured output text"],
            role="assistant",
            metadata=structured_output,
        )

    agent._reasoning = AsyncMock(side_effect=fake_reasoning)

    # Patch _summarizing to produce a fallback message if needed
    async def fake_summarizing():
        return Msg(
            sender="test_agent",
            content=["Summary text"],
            role="assistant",
            metadata=None,
        )

    agent._summarizing = AsyncMock(side_effect=fake_summarizing)

    # Run the agent's main async call that triggers the reasoning loop and memory add
    reply_msg = await agent._run_react_loop(tool_choice=None)

    # The reply message should have the structured_output metadata
    assert reply_msg.metadata == structured_output

    # The dummy memory should have recorded the reply message because static_control is True
    # The bug was that under static_control mode, the message was not recorded to longterm memory
    assert len(dummy_memory.added_messages) == 1
    assert dummy_memory.added_messages[0] == reply_msg

    # The reply message content should match the fake reasoning output content
    assert "This is a structured output text" in reply_msg.content


@pytest.mark.asyncio
async def test_static_control_mode_no_duplicate_memory_add_when_not_static():
    """
    This test verifies that when static_control mode is off,
    the message is recorded to longterm memory only once.
    """

    dummy_memory = DummyMemory()

