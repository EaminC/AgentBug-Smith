[32mimport asyncio
import pytest

from agentscope.agent._react_agent import ReActAgent
from agentscope.memory import Memory
from agentscope.message import Msg


class DummyMemory(Memory):
    def __init__(self):
        super().__init__()
        self.added_messages = []

    async def add(self, msg: Msg):
        self.added_messages.append(msg)
        await super().add(msg)


@pytest.mark.asyncio
async def test_static_control_mode_records_longterm_memory_with_structured_output():
    """
    Test that under static_control mode, when structured_output is generated,
    the reply message is recorded to longterm memory.

    This test triggers the bug where the message is returned but not recorded
    in longterm memory under static_control mode with structured output.
    """

    # Setup a dummy memory to track added messages
    dummy_memory = DummyMemory()

    # Create a ReActAgent instance with static_control enabled and dummy memory
    agent = ReActAgent(
        name="test_agent",
        memory=dummy_memory,
        max_iters=3,
        _static_control=True,
    )

    # Patch the agent's _reasoning and _summarizing methods to simulate structured output generation
    # We do not mock the entire method, only patch to produce controlled output

    # We simulate _reasoning to produce a Msg with structured_output metadata on first call
    # and a Msg with text content but no structured output on second call
    reasoning_calls = 0

    async def fake_reasoning(tool_choice):
        nonlocal reasoning_calls
        reasoning_calls += 1
        if reasoning_calls == 1:
            # Return a Msg with structured_output metadata and no text content blocks
            msg = Msg(
                sender="assistant",
                content_blocks={},
                role="assistant",
                metadata={"structured_output": {"key": "value"}},
            )
            return msg
        else:
            # Return a Msg with text content blocks and no structured output
            msg = Msg(
                sender="assistant",
                content_blocks={"text": "Here is the response text."},
                role="assistant",
                metadata=None,
            )
            return msg

    # Patch _reasoning method
    agent._reasoning = fake_reasoning

    # Patch _summarizing to return a Msg with structured_output metadata
    async def fake_summarizing():
        return Msg(
            sender="assistant",
            content_blocks={"text": "Summary response."},
            role="assistant",
            metadata={"structured_output": {"summary": True}},
        )

    agent._summarizing = fake_summarizing

    # Run the agent's main method that triggers the reasoning-acting loop
    # This is the method that should add the reply message to memory under static_control mode
    reply_msg = await agent._run_react_loop(tool_choice=None)

    # Assert the reply message has structured_output metadata
    assert reply_msg.metadata is not None
    assert "structured_output" in reply_msg.metadata

    # Assert the dummy memory recorded the reply message
    # The bug is that under static_control mode, the message is returned but not recorded
    # So before the fix, dummy_memory.added_messages would be empty
    # After the fix, it should contain the reply message
    assert len(dummy_memory.added_messages) > 0
    # The last added message should be the reply message
    assert dummy_memory.added_messages[-1] == reply_msg

    # Additionally, check that the reply message content matches expected text content
    assert reply_msg.content_blocks is not None
    # It should contain either the text from reasoning or summarizing
    assert (
        "text" in reply_msg.content_blocks
        or reply_msg.content_blocks == {}
    )


@pytest.mark.asyncio
async def test_static_control_mode_no_duplicate_memory_add_on_non_structured_output():
    """
    Test that under static_control mode, if no structured_output is generated,
    the reply message is still recorded to longterm memory once.
    """

    dummy_memory = DummyMemory()

    agent = ReActAgent(
        name="test_agent",
        memory=dummy_memory,
        max_iters=1,
        _static_control=True,
    )

    # Patch _reasoning to return a Msg with text but no structured_output metadata
    async def fake_reasoning(tool_choice):
        return Msg(
            sender="assistant",
            content_blocks={"text": "Simple text response."},
            role="assistant",
            metadata=None,
        )

    agent._reasoning = fake_reasoning

    # Patch _summarizing to return a Msg with no structured_output metadata
    async def fake_summarizing():
        return Msg(
            sender="assistant",
            content_blocks={"text": "Summary response."},
            role="assistant",
            metadata=None,
        )

    agent._summarizing = fake_summarizing

    reply_msg = await agent._run_react_loop(tool_choice=None)

    # The reply message should be recorded to memory once
    assert len(dummy_memory.added_messages) == 1
    assert dummy_memory.added_messages[0] == reply_msg

    # The reply message should have text content
    assert "text" in reply_msg.content_blocks


@pytest.mark.asyncio
async def test_non_static_control_mode_does_not_record_longterm_memory():
    """
    Test that when static_control mode is disabled, the reply message is not
    recorded to longterm memory automatically.
    """

    dummy_memory = DummyMemory()

    agent = ReActAgent(
        name="test_agent",
        memory=dummy_memory,
        max_iters=1,
        _static_control=False,
    )

    async def fake_reasoning(tool_choice):
        return Msg(
            sender="assistant",
            content_blocks={"text": "Response text."},
            role="assistant",
            metadata={"structured_output": {"key": "value"}},
        )

    agent._reasoning = fake_reasoning

    async def fake_summarizing():
        return Msg(
            sender="assistant",
            content_blocks={"text": "Summary response."},
            role="assistant",
            metadata={"structured_output": {"summary": True}},
        )

    agent._summarizing = fake_summarizing

    reply_msg = await agent._run_react_loop(tool_choice=None)

    # The reply message should NOT be recorded to memory automatically
    assert len(dummy_memory.added_messages) == 0

    # The reply message should have structured_output metadata
    assert reply_msg.metadata is not None
    assert "structured_output" in reply_msg.metadata


if __name__ == "__main__":
    # Run tests with asyncio event loop
    asyncio.run(test_static_control_mode_records_longterm_memory_with_structured_output())
    asyncio.run(test_static_control_mode_no_duplicate_memory_add_on_non_structured_output())
    asyncio.run(test_non_static_control_mode_does_not_record_longterm_memory())[0m
