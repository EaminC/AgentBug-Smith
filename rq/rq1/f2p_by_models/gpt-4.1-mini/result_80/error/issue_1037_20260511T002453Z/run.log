@pytest.mark.asyncio
async def test_static_control_records_longterm_memory_with_structured_output():
    """
    Test that under static_control mode, when structured_output is generated,
    the reply message is recorded to longterm memory.

    Buggy behavior: no record added to memory under static_control mode.
    Fixed behavior: record is added.
    """
    dummy_memory = DummyMemory()

    # Create the agent with static_control enabled and dummy memory
    # Provide required sys_prompt, model, formatter arguments
    sys_prompt = "system prompt"
    model = DummyModelWithStructuredOutput()
    formatter = DummyFormatter()

    agent = ReActAgent(
        name="test_agent",
        sys_prompt=sys_prompt,
        model=model,
        formatter=formatter,
        memory=dummy_memory,
        max_iters=3,
    )
    # Enable static_control mode explicitly
    agent._static_control = True

    # Run the agent's run method (async)
    reply_msg = await agent.run(tool_choice=None)

    # Assert that the reply message has structured output metadata
    assert reply_msg.metadata is not None
    assert isinstance(reply_msg.metadata, dict)
    assert "key" in reply_msg.metadata

    # Assert that the memory recorded the reply message once
    assert len(dummy_memory.records) == 1
    recorded_msg = dummy_memory.records[0]
    assert recorded_msg is reply_msg


