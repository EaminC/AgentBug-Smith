[32mimport asyncio
import pytest

from agentscope.agent._react_agent import ReActAgent
from agentscope.message import Msg
from agentscope.memory import MemoryBase


class DummyMemory(MemoryBase):
    def __init__(self):
        super().__init__()
        self._added_messages = []

    async def add(self, msg: Msg):
        self._added_messages.append(msg)

    def get_all(self):
        return self._added_messages


@pytest.mark.asyncio
async def test_static_control_mode_records_longterm_memory_with_structured_output():
    """
    This test verifies that when ReActAgent is in static_control mode and structured_output is generated,
    the reply message is recorded to longterm memory.
    The buggy code does not record the message, so this test should fail before the fix.
    After applying the fix, the test should pass.
    """

    # Setup dummy memory to track added messages
    memory = DummyMemory()

    # Create a ReActAgent instance with static_control enabled and dummy memory
    agent = ReActAgent(
        name="test_agent",
        memory=memory,
        max_iters=3,
        _static_control=True,
    )

    # Patch _reasoning and _summarizing to simulate structured output and text response
    # We do not mock the entire method, just patch to simulate behavior

    # Simulate _reasoning returning a Msg with structured_output metadata and text content
    async def fake_reasoning(tool_choice):
        # Simulate structured output metadata
        structured_output = {"key": "value"}
        # Return a Msg with text content and structured_output metadata
        return Msg(
            sender="test_agent",
            content=["This is a text response"],
            role="assistant",
            metadata=structured_output,
        )

    # Simulate _summarizing returning a Msg with structured output metadata
    async def fake_summarizing():
        return Msg(
            sender="test_agent",
            content=["Summary text"],
            role="assistant",
            metadata={"summary": True},
        )

    # Patch the agent methods
    agent._reasoning = fake_reasoning
    agent._summarizing = fake_summarizing

    # Run the agent's main call to generate a reply message
    reply_msg = await agent._call(tool_choice=None)

    # The reply message should have metadata (structured output)
    assert reply_msg.metadata is not None, "Reply message should have structured output metadata"

    # The memory should have recorded the reply message in static_control mode
    added_messages = memory.get_all()
    assert len(added_messages) > 0, "Longterm memory should have recorded the reply message"

    # The recorded message should be the same as the reply message
    assert added_messages[-1] == reply_msg, "Recorded message should match the reply message"

    # The content of the reply message should match expected text
    assert "This is a text response" in reply_msg.content or "Summary text" in reply_msg.content


if __name__ == "__main__":
    # Run the test standalone
    asyncio.run(test_static_control_mode_records_longterm_memory_with_structured_output())[0m
