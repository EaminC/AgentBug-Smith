[32mimport asyncio
import pytest
from unittest.mock import AsyncMock

from agentscope.agent._react_agent import ReActAgent
from agentscope.message.msg import Msg
from agentscope.memory.memory import Memory
from agentscope.model.openai import OpenAIModel
from agentscope.formatter.formatter import Formatter


class DummyMemory(Memory):
    def __init__(self):
        super().__init__()
        self.added_messages = []

    async def add(self, msg: Msg):
        self.added_messages.append(msg)
        await asyncio.sleep(0)  # simulate async
        return True


@pytest.mark.asyncio
async def test_static_control_mode_records_longterm_memory_with_structured_output():
    """
    This test verifies that under static_control mode with structured output enabled,
    the ReActAgent records the reply message to longterm memory when the reply condition is met.

    Buggy behavior: The message is not recorded to longterm memory under static_control mode.
    Fixed behavior: The message is recorded to longterm memory.
    """

    dummy_memory = DummyMemory()

    # Minimal system prompt for testing
    sys_prompt = "You are a helpful assistant."

    # Use a dummy model that returns a fixed response for reasoning
    class DummyModel(OpenAIModel):
        async def _acall(self, prompt, **kwargs):
            # Return a dummy completion with structured output
            class DummyCompletion:
                def __init__(self):
                    self.choices = [type("Choice", (), {"message": {"content": "structured output"}})()]
            return DummyCompletion()

    dummy_model = DummyModel()

    # Use a dummy formatter that just returns input
    class DummyFormatter(Formatter):
        def format(self, *args, **kwargs):
            return "formatted"

    dummy_formatter = DummyFormatter()

    # Create the agent with required arguments
    agent = ReActAgent(
        name="test_agent",
        sys_prompt=sys_prompt,
        model=dummy_model,
        formatter=dummy_formatter,
        memory=dummy_memory,
        max_iters=3,
    )

    # Enable static control mode manually (since no constructor arg)
    agent._static_control = True

    # Enable structured output to trigger the bug scenario
    agent.structured_output = True

    # Run the agent's main call method to get a reply message
    reply_msg = await agent.call("Hello, please provide structured output.")

    # The reply message should have metadata (structured output)
    assert reply_msg.metadata is not None

    # The dummy memory should have recorded the reply message once
    assert len(dummy_memory.added_messages) == 1
    assert dummy_memory.added_messages[0] == reply_msg


@pytest.mark.asyncio
async def test_static_control_mode_no_duplicate_memory_add_when_not_static():
    """
    This test verifies that when static_control mode is off,
    the message is recorded to longterm memory only once.
    """

    dummy_memory = DummyMemory()

    sys_prompt = "You are a helpful assistant."

    class DummyModel(OpenAIModel):
        async def _acall(self, prompt, **kwargs):
            class DummyCompletion:
                def __init__(self):
                    self.choices = [type("Choice", (), {"message": {"content": "structured output"}})()]
            return DummyCompletion()

    dummy_model = DummyModel()

    class DummyFormatter(Formatter):
        def format(self, *args, **kwargs):
            return "formatted"

    dummy_formatter = DummyFormatter()

    agent = ReActAgent(
        name="test_agent",
        sys_prompt=sys_prompt,
        model=dummy_model,
        formatter=dummy_formatter,
        memory=dummy_memory,
        max_iters=3,
    )

    # static_control mode off
    agent._static_control = False

    agent.structured_output = True

    reply_msg = await agent.call("Hello, please provide structured output.")

    assert reply_msg.metadata is not None

    # The dummy memory should have recorded the reply message once
    assert len(dummy_memory.added_messages) == 1
    assert dummy_memory.added_messages[0] == reply_msg[0m
