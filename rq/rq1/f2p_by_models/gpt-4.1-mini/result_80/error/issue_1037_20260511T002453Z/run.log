from agentscope.message import Msg


@pytest.mark.asyncio
async def test_static_control_mode_records_longterm_memory_with_structured_output():
    """
    Test that under static_control mode, when structured_output is generated,
    the agent records the reply message to longterm memory.

    This test triggers the bug where the message is returned without recording
    to longterm memory under static_control mode when structured output is present.

    The test will fail on the buggy codebase (no memory add call),
    and pass after the fix (memory add called).
    """

    # Setup a ReActAgent instance with static_control mode enabled
    agent = ReActAgent(
        name="test_agent",
        max_iters=3,
        static_control=True,
    )

    # Patch the memory.add method to track calls
    agent.memory = AsyncMock()
    agent.memory.add = AsyncMock()

    # Patch _reasoning to simulate structured output and text content
    # The first call returns a Msg with structured_output in metadata and text content
    # The second call returns a Msg without structured output (simulate normal flow)
    structured_output = {"key": "value"}
    msg_with_structured_output = Msg(
        sender="test_agent",
        content_blocks=["structured output text"],
        role="assistant",
        metadata=structured_output,
    )
    msg_with_structured_output.has_content_blocks = lambda x: x == "text"
    msg_with_structured_output.get_content_blocks = lambda x: ["structured output text"] if x == "text" else []

    # The _reasoning method will return this message on first call, then a normal message
    reasoning_calls = [msg_with_structured_output, Msg("test_agent", ["final text"], "assistant")]

    async def fake_reasoning(tool_choice):
        if reasoning_calls:
            return reasoning_calls.pop(0)
        return Msg("test_agent", ["fallback text"], "assistant")

    agent._reasoning = fake_reasoning

    # Patch _summarizing to return a fallback message if needed
    agent._summarizing = AsyncMock(return_value=Msg("test_agent", ["summary text"], "assistant"))

    # Run the agent's main run method (async)
    reply_msg = await agent.run(tool_choice=None)

    # Assert the reply message has the structured output metadata
    assert reply_msg.metadata == structured_output

    # Assert memory.add was called with the reply message (recorded to longterm memory)
    # This is the key assertion that fails on buggy codebase
    agent.memory.add.assert_awaited_with(reply_msg)

    # Also check the reply message content is as expected
    assert "structured output text" in reply_msg.content_blocks or "final text" in reply_msg.content_blocks


if __name__ == "__main__":
    asyncio.run(test_static_control_mode_records_longterm_memory_with_structured_output())[0m
