[32mFROM python:3.10-slim AS test_builder

ENV PYTHONUNBUFFERED=1
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

WORKDIR /app

COPY . .

RUN set -eux; \
    # Upgrade pip and packaging tools early
    python -m pip install --upgrade pip setuptools wheel; \
    # Detect src layout or src import usage to decide install method
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        # src layout detected, install deps only, set PYTHONPATH
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    else \
        # No src layout, do editable install
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    fi

RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests (assumption: tests directory exists with pytest tests)
RUN pytest tests

FROM python:3.10-slim AS runtime

ENV PYTHONUNBUFFERED=1
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

WORKDIR /app

COPY . .

RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    pip install -r requirements.txt 2>/dev/null || true; \
    pip install -e .; \
    # Remove test dependencies if any installed in editable install extras
    pip uninstall -y pytest pytest-mock pytest-asyncio pytest-cov anyio litellm || true

CMD ["/bin/bash"][0m
