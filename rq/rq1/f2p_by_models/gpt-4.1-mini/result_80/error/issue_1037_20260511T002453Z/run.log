        return self._messages


@pytest.mark.asyncio
async def test_static_control_mode_records_longterm_memory_with_structured_output():
    """
    This test verifies that under static_control mode with structured output enabled,
    the ReActAgent records the reply message to longterm memory when the reply condition is met.

    Buggy behavior: The message is not recorded to longterm memory under static_control mode.
    Fixed behavior: The message is recorded to longterm memory.
    """

    # Setup dummy memory to capture added messages
    dummy_memory = DummyMemory()

    # Create a ReActAgent instance with static_control=True and a dummy memory
    # We do not pass structured_output to constructor because it is not a constructor argument.
    # Instead, we simulate structured output by setting a property or by mocking internal behavior.
    # Since the bug relates to structured output generation and memory recording,
    # we will patch the _reasoning method to simulate structured output generation.

    agent = ReActAgent(
        name="test_agent",
        memory=dummy_memory,
        max_iters=3,
        static_control=True,
    )

    # Patch _reasoning to simulate a message with structured output and text content
    async def fake_reasoning(tool_choice):
        # Return a Msg instance with text content and structured output metadata
        return Msg(
            agent.name,
            ["This is a structured output response."],
            "assistant",
            metadata={"structured_output": {"key": "value"}},
        )

    agent._reasoning = fake_reasoning

    # Patch _summarizing to produce a fallback message if needed
    async def fake_summarizing():
        return Msg(
            agent.name,
            ["Summary response."],
            "assistant",
            metadata={"structured_output": {"summary": True}},
        )

    agent._summarizing = fake_summarizing

    # Run the agent's main run loop (the __call__ method) with dummy tool_choice
    reply_msg = await agent(tool_choice=None)

    # Check that the reply message has structured output metadata
    assert reply_msg.metadata is not None
    assert isinstance(reply_msg.metadata, dict)
    assert "structured_output" in reply_msg.metadata

    # Check that the dummy memory recorded the reply message
    recorded_messages = dummy_memory.get_all()
    assert len(recorded_messages) > 0, "Expected message to be recorded in longterm memory"

    # The recorded message should be the same as the reply message
    assert recorded_messages[-1] == reply_msg

    # Also verify that the reply message content matches the fake reasoning output
    assert any("structured output" in text for text in reply_msg.get_content_blocks("text"))


if __name__ == "__main__":
    asyncio.run(test_static_control_mode_records_longterm_memory_with_structured_output())[0m
