import pytest

from src.agentscope.agent._react_agent import ReActAgent
from src.agentscope.message._message_base import Msg


class DummyMemory:
    def __init__(self):
        self.records = []
    async def add(self, msg):
        self.records.append(msg)


class DummyModel:
    """A dummy model that simulates structured output generation."""
    async def __call__(self, *args, **kwargs):
        # Simulate a response with structured output
        class DummyResponse:
            def __init__(self):
                self.choices = [self]
                self.message = Msg(
                    "dummy_model",
                    content_blocks={"text": ["dummy text"]},
                    role="assistant",
                    metadata={"structured": True},
                )
        return DummyResponse()


class DummyModelNoStructured:
    """A dummy model that simulates no structured output generation."""
    async def __call__(self, *args, **kwargs):
        # Simulate a response without structured output
        class DummyResponse:
            def __init__(self):
                self.choices = [self]
                self.message = Msg(
                    "dummy_model",
                    content_blocks={"text": ["dummy text no structured"]},
                    role="assistant",
                    metadata=None,
                )
        return DummyResponse()


class DummyFormatter:
