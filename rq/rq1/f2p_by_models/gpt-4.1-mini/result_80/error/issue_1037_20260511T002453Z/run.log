import pytest

from src.agentscope.agent._react_agent import ReActAgent
from src.agentscope.memory.base import Memory
from src.agentscope.message.msg import Msg
from src.agentscope.model.openai import OpenAIModel
from src.agentscope.formatter.formatter import Formatter


class DummyMemory(Memory):
    def __init__(self):
        super().__init__()
        self._messages = []
        self._added_messages = []

    async def add(self, msg: Msg):
        self._added_messages.append(msg)
        self._messages.append(msg)

    async def get_all(self):
        return self._messages


class DummyFormatter(Formatter):
    def format(self, *args, **kwargs):
        return "dummy formatted prompt"


class DummyModel(OpenAIModel):
    async def _acall(self, prompt, **kwargs):
        # Return a dummy response with structured output in metadata
        # Simulate a response that triggers structured output generation
        return Msg(
            "dummy_model",
            content_blocks={"text": ["dummy response text"]},
            role="assistant",
            metadata={"structured_output": {"key": "value"}},
        )


@pytest.mark.asyncio
async def test_static_control_mode_records_longterm_memory_with_structured_output():
    """
    This test verifies that when ReActAgent is in static_control mode and structured_output is generated,
    the reply message is recorded to longterm memory.
    The buggy code does not record the message, so this test should fail before the fix.
    After applying the fix, the test should pass.
    """

    memory = DummyMemory()
    formatter = DummyFormatter()
    model = DummyModel()

    sys_prompt = "You are a test agent."

    # Create the agent with static_control mode enabled
    agent = ReActAgent(
        name="test_agent",
        sys_prompt=sys_prompt,
        model=model,
        formatter=formatter,
        memory=memory,
        max_iters=3,
    )
    # Enable static_control mode forcibly
    agent._static_control = True

    # We simulate structured_output mode by setting the agent's structured_output attribute
    # This is to trigger the code path where structured output is generated and returned
    agent.structured_output = True

    # Run the agent's main method to get a reply message
    reply_msg = await agent.run("Hello, please generate structured output.")

    # The reply message should contain metadata with structured_output
    assert reply_msg.metadata is not None
    assert "structured_output" in reply_msg.metadata

    # The memory should have recorded the reply message in longterm memory
    # The buggy code does not do this under static_control mode, so this test fails before fix
    added_messages = memory._added_messages
    assert any(
        msg.metadata is not None and "structured_output" in msg.metadata
        for msg in added_messages
    ), "Reply message with structured output was not recorded to longterm memory under static_control mode"


if __name__ == "__main__":
