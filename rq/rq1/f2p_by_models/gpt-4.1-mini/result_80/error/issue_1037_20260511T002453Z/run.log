[32mimport asyncio
import pytest
from unittest.mock import AsyncMock

from src.agentscope.agent._react_agent import ReActAgent
from src.agentscope.memory.memory import Memory
from src.agentscope.message.msg import Msg
from src.agentscope.model.openai import OpenAIModel
from src.agentscope.formatter.formatter import Formatter


class DummyMemory(Memory):
    def __init__(self):
        super().__init__()
        self._added_messages = []
        self.add = AsyncMock(side_effect=self._add)

    async def _add(self, msg: Msg):
        self._added_messages.append(msg)

    def get_added_messages(self):
        return self._added_messages


class DummyModel(OpenAIModel):
    async def _acall(self, prompt, **kwargs):
        # Return a dummy response that triggers structured output and text content
        class DummyResponse:
            def __init__(self):
                self.choices = [type("Choice", (), {"message": {"content": "dummy text", "metadata": {"structured": True}}})()]

        return DummyResponse()


class DummyFormatter(Formatter):
    def format(self, *args, **kwargs):
        return "formatted prompt"


@pytest.mark.asyncio
async def test_static_control_mode_records_longterm_memory_with_structured_output():
    """
    This test verifies that under static_control mode with structured output enabled,
    the ReActAgent records the reply message to longterm memory when the reply condition is met.

    Buggy behavior: The message is not recorded to longterm memory under static_control mode.
    Fixed behavior: The message is recorded to longterm memory.
    """

    dummy_memory = DummyMemory()
    dummy_model = DummyModel()
    dummy_formatter = DummyFormatter()

    sys_prompt = "system prompt for testing"

    agent = ReActAgent(
        name="test_agent",
        sys_prompt=sys_prompt,
        model=dummy_model,
        formatter=dummy_formatter,
        memory=dummy_memory,
        max_iters=3,
    )
    # Enable static control mode explicitly
    agent._static_control = True
    # Enable structured output
    agent.structured_output = True

    # Run the agent's reasoning loop once
    reply_msg = await agent._run_once()

    # Check that the reply message has structured output metadata
    assert reply_msg.metadata is not None
    assert isinstance(reply_msg.metadata, dict)
    assert "structured" in reply_msg.metadata

    # Check that the memory add method was called with the reply message
    added_messages = dummy_memory.get_added_messages()
    assert any(msg is reply_msg for msg in added_messages), "Reply message should be recorded to longterm memory under static_control mode"


@pytest.mark.asyncio
async def test_static_control_mode_no_duplicate_memory_add_when_not_static():
    """
    This test verifies that when static_control mode is off,
    the message is recorded to longterm memory only once.
    """

    dummy_memory = DummyMemory()
    dummy_model = DummyModel()
    dummy_formatter = DummyFormatter()

    sys_prompt = "system prompt for testing"

    agent = ReActAgent(
        name="test_agent",
        sys_prompt=sys_prompt,
        model=dummy_model,
        formatter=dummy_formatter,
        memory=dummy_memory,
        max_iters=3,
    )
    # Disable static control mode explicitly
    agent._static_control = False
    # Enable structured output
    agent.structured_output = True

    # Run the agent's reasoning loop once
    reply_msg = await agent._run_once()

    # Check that the reply message has structured output metadata
    assert reply_msg.metadata is not None
    assert isinstance(reply_msg.metadata, dict)
    assert "structured" in reply_msg.metadata

    # Check that the memory add method was called exactly once with the reply message
    added_messages = dummy_memory.get_added_messages()
    count = sum(1 for msg in added_messages if msg is reply_msg)
    assert count == 1, "Reply message should be recorded exactly once to longterm memory when static_control mode is off"[0m
