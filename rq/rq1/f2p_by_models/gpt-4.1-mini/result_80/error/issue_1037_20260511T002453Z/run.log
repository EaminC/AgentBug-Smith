        self.added = []

    async def add(self, msg):
        self.added.append(msg)


class DummyModel:
    async def chat_completions_create(self, *args, **kwargs):
        # Return a dummy completion with a structured output in metadata
        class DummyChoice:
            def __init__(self):
                self.message = Msg(
                    "model",
                    "dummy response",
                    "assistant",
                    metadata={"structured_output": {"key": "value"}},
                )

        class DummyResponse:
            def __init__(self):
                self.choices = [DummyChoice()]

        return DummyResponse()


@pytest.mark.asyncio
async def test_static_control_records_longterm_memory_with_structured_output():
    """
    Test that under static_control mode, when structured_output is generated,
    the reply message is recorded to longterm memory.

    Buggy behavior: no record added to memory under static_control mode.
    Fixed behavior: record is added.
    """
    dummy_memory = DummyMemory()

    # Create the agent with static_control enabled and dummy memory
    # We must set the static_control flag via the attribute after creation,
    # because __init__ does not accept _static_control param.
    agent = ReActAgent(
        name="test_agent",
        memory=dummy_memory,
        max_iters=3,
    )
    agent._static_control = True
    agent.model = DummyModel()

    # Provide a prompt that triggers structured output
    # We simulate the _reasoning and _summarizing methods by patching the model response
    # so that the agent generates a structured output.

    # Run the agent's run method with a dummy input
    reply = await agent.run("test input")

    # The reply should have metadata with structured_output
    assert reply.metadata is not None
    assert "structured_output" in reply.metadata

    # The dummy_memory should have recorded the reply message once
    assert len(dummy_memory.added) == 1
    assert dummy_memory.added[0] == reply


@pytest.mark.asyncio
