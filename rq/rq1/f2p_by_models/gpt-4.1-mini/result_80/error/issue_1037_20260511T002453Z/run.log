[32mimport asyncio
import pytest

from agentscope.agent._react_agent import ReActAgent
from agentscope.memory.memory import Memory
from agentscope.message import Msg


class DummyMemory(Memory):
    def __init__(self):
        super().__init__()
        self.added_messages = []

    async def add(self, msg: Msg):
        self.added_messages.append(msg)
        await super().add(msg)


@pytest.mark.asyncio
async def test_static_control_records_longterm_memory_with_structured_output():
    """
    Test that under static_control mode, when structured_output is generated,
    the reply message is recorded to longterm memory.

    Buggy behavior: reply message is not recorded to longterm memory under static_control mode.
    Fixed behavior: reply message is recorded to longterm memory.
    """
    # Setup dummy memory to track calls to add()
    memory = DummyMemory()

    # Create ReActAgent with static_control mode enabled
    agent = ReActAgent(
        name="test_agent",
        memory=memory,
        max_iters=3,
        _static_control=True,
    )

    # Patch _reasoning and _summarizing to simulate structured output generation
    # and text content generation to trigger the reply message creation.

    # We simulate that _reasoning returns a Msg with structured_output metadata and text content.
    # This should cause the agent to break the loop and produce a reply message.

    structured_output = {"key": "value"}

    async def fake_reasoning(tool_choice):
        # Return a Msg with text content and structured_output metadata
        return Msg(
            sender="test_agent",
            content_blocks=["dummy text"],
            role="assistant",
            metadata=structured_output,
        )

    # Patch the agent's _reasoning method
    agent._reasoning = fake_reasoning

    # Patch the agent's _summarizing method to produce a fallback message if needed
    async def fake_summarizing():
        return Msg(
            sender="test_agent",
            content_blocks=["summary text"],
            role="assistant",
            metadata=None,
        )

    agent._summarizing = fake_summarizing

    # Run the agent's main method that triggers the reasoning-acting loop
    reply_msg = await agent._run_react_loop(tool_choice=None)

    # Check that the reply message has the structured_output metadata
    assert reply_msg.metadata == structured_output

    # Check that the reply message was recorded in longterm memory
    # Under buggy code, memory.add would not be called with reply_msg
    # Under fixed code, memory.add is called with reply_msg
    assert any(
        msg is reply_msg for msg in memory.added_messages
    ), "Reply message was not recorded to longterm memory under static_control mode"[0m
