[32mimport asyncio
import pytest
from unittest.mock import AsyncMock, patch

from agentscope.agent._react_agent import ReActAgent
from agentscope.message import Msg
from agentscope.model.openai import OpenAIModel
from agentscope.formatter.formatter_openai import FormatterOpenAI


@pytest.mark.asyncio
async def test_static_control_mode_records_longterm_memory_with_structured_output():
    """
    Test that under static_control mode, when structured_output is generated,
    the agent records the reply message to longterm memory.

    This test triggers the bug where the message is returned without recording
    to longterm memory under static_control mode when structured output is present.

    The test will fail on the buggy codebase (no memory add call),
    and pass after the fix (memory add called).
    """

    # Create a dummy structured output metadata
    dummy_structured_output = {"key": "value"}

    # Create a dummy Msg with structured output metadata
    dummy_msg_with_structured_output = Msg(
        "test_agent",
        ["This is a structured output response."],
        "assistant",
        metadata=dummy_structured_output,
    )

    # Patch _reasoning to return a Msg with structured output on first call,
    # then a Msg without structured output on subsequent calls to simulate loop end
    async def fake_reasoning(tool_choice):
        if not hasattr(fake_reasoning, "called"):
            fake_reasoning.called = True
            return dummy_msg_with_structured_output
        else:
            return Msg("test_agent", ["No structured output"], "assistant")

    # Patch _summarizing to return a Msg with structured output
    async def fake_summarizing():
        return dummy_msg_with_structured_output

    # Create minimal required objects for ReActAgent constructor
    sys_prompt = "You are a helpful assistant."
    model = OpenAIModel(model="gpt-4o-mini", temperature=0)
    formatter = FormatterOpenAI()

    # Instantiate the agent with static_control mode enabled
    agent = ReActAgent(
        name="test_agent",
        sys_prompt=sys_prompt,
        model=model,
        formatter=formatter,
        max_iters=3,
    )
    agent._static_control = True

    # Patch the internal memory.add method to track calls
    agent.memory.add = AsyncMock()

    # Patch _reasoning and _summarizing methods
    agent._reasoning = fake_reasoning
    agent._summarizing = fake_summarizing

    # Run the agent's main method that triggers the bug
    reply = await agent._run_react_loop(tool_choice=None)

    # Assert the reply message has the structured output metadata
    assert reply.metadata == dummy_structured_output

    # Assert that memory.add was called at least once with the reply message
    # This is the key check: on buggy codebase, this call is missing
    agent.memory.add.assert_called()
    called_args = agent.memory.add.call_args[0]
    assert len(called_args) == 1
    added_msg = called_args[0]
    assert isinstance(added_msg, Msg)
    assert added_msg.metadata == dummy_structured_output

    # Also assert the reply is the message returned by the agent
    assert reply == added_msg or reply.metadata == added_msg.metadata

# Run the test if executed as main (optional)
if __name__ == "__main__":
    asyncio.run(test_static_control_mode_records_longterm_memory_with_structured_output())[0m
