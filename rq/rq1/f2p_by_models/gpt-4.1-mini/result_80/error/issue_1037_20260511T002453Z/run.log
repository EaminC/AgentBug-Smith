        self.records.append(msg)


class DummyModelWithStructuredOutput:
    """
    Dummy model that simulates generating structured output on first call,
    and then a text message with content blocks.
    """

    def __init__(self):
        self.call_count = 0

    async def __call__(self, *args, **kwargs):
        self.call_count += 1
        if self.call_count == 1:
            # Simulate structured output generation
            return {
                "structured_output": {"key": "value"},
                "text": None,
            }
        else:
            # Simulate text message generation with content blocks
            return {
                "structured_output": None,
                "text": "This is a reply text.",
            }


class DummyModelNoStructured:
    """
    Dummy model that never generates structured output,
    only returns text.
    """

    async def __call__(self, *args, **kwargs):
        return {
            "structured_output": None,
            "text": "Just a plain text reply.",
        }


class DummyFormatter:
    """
