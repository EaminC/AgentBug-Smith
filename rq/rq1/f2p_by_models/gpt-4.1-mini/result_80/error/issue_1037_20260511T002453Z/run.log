from agentscope.memory.base import Memory
from agentscope.message import Msg
from agentscope.model.openai import OpenAIChatModel
from agentscope.formatter.openai import OpenAIChatFormatter


class DummyMemory(Memory):
    def __init__(self):
        super().__init__()
        self._added_messages = []

    async def add(self, msg: Msg):
        self._added_messages.append(msg)

    def get_all(self):
        return self._added_messages


@pytest.mark.asyncio
async def test_static_control_mode_records_longterm_memory_with_structured_output():
    """
    This test verifies that under static_control mode with structured output enabled,
    the ReActAgent records the reply message to longterm memory when the reply condition is met.

    Buggy behavior: The message is not recorded to longterm memory under static_control mode.
    Fixed behavior: The message is recorded to longterm memory.
    """

    dummy_memory = DummyMemory()

    # Prepare dummy model that returns a structured output in the first iteration
    dummy_model = OpenAIChatModel()
    dummy_model.chat = AsyncMock()

    # Simulate a response that includes structured output metadata
    async def dummy_chat(*args, **kwargs):
        # Return a Msg with structured_output metadata
        return Msg(
            "test_agent",
            ["Structured output text"],
            "assistant",
            metadata={"structured_output": {"key": "value"}},
        )

    dummy_model.chat.side_effect = dummy_chat

    # Use a simple formatter that just passes messages through
    formatter = OpenAIChatFormatter()

    # Create the agent with required args
    agent = ReActAgent(
        name="test_agent",
        sys_prompt="You are a test agent.",
        model=dummy_model,
        formatter=formatter,
        memory=dummy_memory,
        max_iters=3,
    )

    # Enable static control mode explicitly
    agent._static_control = True
    agent.structured_output = True

    # Run the agent's run method with a dummy input and tool_choice (None)
    reply_msg = await agent.run("dummy input", tool_choice=None)

    # Check that the reply message metadata contains structured_output
    assert reply_msg.metadata is not None
    assert "structured_output" in reply_msg.metadata

    # Check that the dummy_memory recorded the reply message exactly once
    added_messages = dummy_memory.get_all()
    assert len(added_messages) == 1
    assert added_messages[0] == reply_msg


@pytest.mark.asyncio
async def test_static_control_mode_no_duplicate_memory_add_when_not_static():
    """
    This test verifies that when static_control mode is off,
    the message is recorded to longterm memory only once.
    """

    dummy_memory = DummyMemory()

    dummy_model = OpenAIChatModel()
    dummy_model.chat = AsyncMock()

    async def dummy_chat(*args, **kwargs):
        return Msg(
            "test_agent",
            ["Some text response"],
            "assistant",
            metadata={"structured_output": {"key": "value"}},
        )

    dummy_model.chat.side_effect = dummy_chat

    formatter = OpenAIChatFormatter()

    agent = ReActAgent(
        name="test_agent",
        sys_prompt="You are a test agent.",
        model=dummy_model,
        formatter=formatter,
        memory=dummy_memory,
        max_iters=3,
    )

    # static control mode off
    agent._static_control = False
    agent.structured_output = True

    reply_msg = await agent.run("dummy input", tool_choice=None)

    # Check that the reply message metadata contains structured_output
    assert reply_msg.metadata is not None
    assert "structured_output" in reply_msg.metadata

    added_messages = dummy_memory.get_all()
    # Should be exactly one add call
    assert len(added_messages) == 1
    assert added_messages[0] == reply_msg[0m
