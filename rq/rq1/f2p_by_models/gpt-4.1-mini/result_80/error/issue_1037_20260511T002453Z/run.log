        # Create a dummy structured output metadata
        dummy_structured_output = {"key": "value"}
    
        # Create a dummy Msg with structured output metadata
        dummy_msg_with_structured_output = Msg(
            "test_agent",
            ["This is a structured output response."],
            "assistant",
            metadata=dummy_structured_output,
        )
    
        # Patch _reasoning to return a Msg with structured output on first call,
        # then None to simulate end of loop
        async def fake_reasoning(tool_choice):
            # Return a Msg with structured output on first call
            # Then on subsequent calls, return a Msg without structured output
            if not hasattr(fake_reasoning, "called"):
                fake_reasoning.called = True
                return dummy_msg_with_structured_output
            else:
                # Return a Msg without structured output to simulate no more output
                return Msg("test_agent", ["No structured output"], "assistant")
    
        # Patch _summarizing to return a Msg with structured output
        async def fake_summarizing():
            return dummy_msg_with_structured_output
    
        # We need to create an instance of ReActAgent with static_control mode enabled.
        # The ReActAgent constructor does not accept static_control as a direct argument,
        # but the bugfix patch references self._static_control.
        # So we must set _static_control attribute manually after creation.
    
