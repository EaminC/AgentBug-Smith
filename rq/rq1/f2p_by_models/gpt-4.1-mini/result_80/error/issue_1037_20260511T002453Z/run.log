[32mimport asyncio
import pytest

from agentscope.agent._react_agent import ReActAgent
from agentscope.message import Msg
from agentscope.memory.memory import MemoryBase


class DummyMemory(MemoryBase):
    def __init__(self):
        super().__init__()
        self._records = []

    async def add(self, msg: Msg):
        self._records.append(msg)

    async def get_all(self):
        return self._records


@pytest.mark.asyncio
async def test_static_control_records_longterm_memory_with_structured_output():
    """
    Test that under static_control mode, when structured_output is generated,
    the reply message is recorded into longterm memory.

    Buggy behavior:
        - The reply message is not recorded into longterm memory under static_control mode,
          even when structured_output is generated.

    Fixed behavior:
        - The reply message is properly recorded into longterm memory.
    """
    # Setup dummy memory to track added messages
    memory = DummyMemory()

    # Create ReActAgent with static_control mode enabled
    agent = ReActAgent(
        name="test_agent",
        memory=memory,
        max_iters=3,
        _static_control=True,
    )

    # Patch _reasoning to simulate structured output generation and text content
    # We simulate the agent generating a structured output and a text reply in the first iteration
    structured_output = {"key": "value"}
    text_content = ["This is a structured output response."]

    async def dummy_reasoning(tool_choice):
        # Return a Msg with text content and metadata as structured_output
        return Msg(
            sender=agent.name,
            content_blocks=text_content,
            role="assistant",
            metadata=structured_output,
        )

    agent._reasoning = dummy_reasoning

    # Run the agent's reasoning loop (simulate a call that triggers reply generation)
    reply_msg = await agent._run_react_loop(tool_choice=None)

    # Check that the reply message is returned and has the structured output metadata
    assert reply_msg is not None
    assert reply_msg.metadata == structured_output
    assert any("structured output" in c for c in reply_msg.content_blocks)

    # Check that the reply message was recorded in longterm memory
    # Under buggy code, this will fail because memory.add is not called
    records = await memory.get_all()
    assert any(
        r.metadata == structured_output and r.content_blocks == reply_msg.content_blocks
        for r in records
    ), "Reply message with structured output should be recorded in longterm memory under static_control mode"


@pytest.mark.asyncio
async def test_static_control_records_longterm_memory_when_no_structured_output():
    """
    Test that under static_control mode, when no structured_output is generated,
    the reply message is still recorded into longterm memory.

    This ensures that the agent always records reply messages under static_control mode.
    """
    memory = DummyMemory()

    agent = ReActAgent(
        name="test_agent",
        memory=memory,
        max_iters=1,
        _static_control=True,
    )

    # Patch _reasoning to simulate no structured output and text content
    text_content = ["Just a plain text response."]

    async def dummy_reasoning(tool_choice):
        return Msg(
            sender=agent.name,
            content_blocks=text_content,
            role="assistant",
            metadata=None,
        )

    agent._reasoning = dummy_reasoning

    reply_msg = await agent._run_react_loop(tool_choice=None)

    assert reply_msg is not None
    assert reply_msg.metadata is None
    assert any("plain text" in c for c in reply_msg.content_blocks)

    records = await memory.get_all()
    assert any(
        r.content_blocks == reply_msg.content_blocks for r in records
    ), "Reply message should be recorded in longterm memory under static_control mode"


@pytest.mark.asyncio
async def test_non_static_control_does_not_record_longterm_memory():
    """
    Test that when static_control mode is disabled, the reply message is not recorded
    into longterm memory automatically by the agent.

    This checks that the memory.add call is conditional on static_control mode.
    """
    memory = DummyMemory()

    agent = ReActAgent(
        name="test_agent",
        memory=memory,
        max_iters=1,
        _static_control=False,
    )

    text_content = ["Response without static control."]

    async def dummy_reasoning(tool_choice):
        return Msg(
            sender=agent.name,
            content_blocks=text_content,
            role="assistant",
            metadata=None,
        )

    agent._reasoning = dummy_reasoning

    reply_msg = await agent._run_react_loop(tool_choice=None)

    assert reply_msg is not None
    assert any("without static control" in c for c in reply_msg.content_blocks)

    records = await memory.get_all()
    # Under non-static_control, memory should not have the reply message automatically
    assert not any(
        r.content_blocks == reply_msg.content_blocks for r in records
    ), "Reply message should NOT be recorded in longterm memory when static_control is False"[0m
