[32mimport asyncio
import pytest
from unittest.mock import AsyncMock, patch

from agentscope.agent._react_agent import ReActAgent
from agentscope.message import Msg
from agentscope.memory.memory import Memory


@pytest.mark.asyncio
async def test_static_control_mode_records_longterm_memory_with_structured_output():
    """
    Test that under static_control mode with structured_output enabled,
    the agent records the reply message to longterm memory when reply condition is met.

    This test triggers the bug where the reply message is returned but not recorded to memory.
    After the fix, the reply message should be recorded to memory.
    """

    # Prepare a dummy Memory instance with an async add method we can monitor
    memory = Memory()
    memory.add = AsyncMock()

    # Patch the _reasoning and _summarizing methods to simulate structured output generation
    async def dummy_reasoning(tool_choice):
        # Simulate a Msg with structured output and text content
        msg = Msg(
            name="ReActAgent",
            content_blocks=["dummy text response"],
            role="assistant",
            metadata={"structured_key": "structured_value"},
        )
        return msg

    async def dummy_summarizing():
        # Simulate a summarizing Msg with structured output
        msg = Msg(
            name="ReActAgent",
            content_blocks=["summary text"],
            role="assistant",
            metadata={"structured_key": "structured_value"},
        )
        return msg

    # Create the agent with static_control=True and max_iters > 0
    agent = ReActAgent(
        name="ReActAgent",
        memory=memory,
        max_iters=3,
        _static_control=True,
        structured_output=True,
    )

    # Patch internal methods to control behavior
    with patch.object(agent, "_reasoning", side_effect=dummy_reasoning) as mock_reasoning, \
         patch.object(agent, "_summarizing", side_effect=dummy_summarizing) as mock_summarizing:

        # Run the agent's main call (async)
        reply_msg = await agent()

        # The reply message should be a Msg instance with structured output metadata
        assert isinstance(reply_msg, Msg)
        assert reply_msg.metadata is not None
        assert "structured_key" in reply_msg.metadata

        # The memory.add method should be called with the reply message
        memory.add.assert_awaited_with(reply_msg)

        # The _reasoning method should be called at least once
        assert mock_reasoning.call_count > 0

        # The _summarizing method should not be called because reasoning returns reply
        assert mock_summarizing.call_count == 0


@pytest.mark.asyncio
async def test_static_control_mode_records_longterm_memory_when_no_early_reply():
    """
    Test that under static_control mode with structured_output enabled,
    if no early reply is generated in reasoning loop, summarizing reply is recorded to memory.
    """

    memory = Memory()
    memory.add = AsyncMock()

    # _reasoning returns a Msg without content_blocks "text" to force loop to continue
    async def dummy_reasoning(tool_choice):
        msg = Msg(
            name="ReActAgent",
            content_blocks=[],  # no text content to trigger next iteration
            role="assistant",
            metadata=None,
        )
        return msg

    async def dummy_summarizing():
        msg = Msg(
            name="ReActAgent",
            content_blocks=["final summary text"],
            role="assistant",
            metadata={"structured_key": "structured_value"},
        )
        return msg

    agent = ReActAgent(
        name="ReActAgent",
        memory=memory,
        max_iters=1,  # force max iteration reached
        _static_control=True,
        structured_output=True,
    )

    with patch.object(agent, "_reasoning", side_effect=dummy_reasoning) as mock_reasoning, \
         patch.object(agent, "_summarizing", side_effect=dummy_summarizing) as mock_summarizing:

        reply_msg = await agent()

        assert isinstance(reply_msg, Msg)
        assert reply_msg.metadata is not None
        assert "structured_key" in reply_msg.metadata

        # The memory.add method should be called with the summarizing reply message
        memory.add.assert_awaited_with(reply_msg)

        # _reasoning called once due to max_iters=1
        assert mock_reasoning.call_count == 1

        # _summarizing called once because no early reply
        assert mock_summarizing.call_count == 1[0m
