WORKDIR /app

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Assumption: python project metadata is under ./python, so requirements or pyproject.toml are inside python/
# We check for requirements.txt or pyproject.toml inside python/ and install accordingly
RUN set -eux; \
    cd python; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -f requirements.txt ]; then \
        pip install -r requirements.txt && pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout && pip install -e .; \
    elif [ -f pyproject.toml ] && [ -f poetry.lock ]; then \
        pip install poetry && poetry config virtualenvs.create false && poetry install --no-interaction --no-ansi && pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout && pip install -e . ; \
    elif [ -f pyproject.toml ]; then \
        pip install -e . && pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout ; \
    else \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests as in Makefile: "uv run pytest ./python"
# Assumption: uv is not guaranteed installed, fallback to pytest directly
RUN set -eux; \
    if command -v uv >/dev/null 2>&1; then \
        uv run pytest ./python; \
    else \
        pytest ./python; \
    fi

FROM python:3.12-slim AS runtime

WORKDIR /app

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

RUN set -eux; \
    cd python; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -f requirements.txt ]; then \
        pip install -r requirements.txt; \
    elif [ -f pyproject.toml ] && [ -f poetry.lock ]; then \
        pip install poetry && poetry config virtualenvs.create false && poetry install --no-dev --no-interaction --no-ansi; \
    elif [ -f pyproject.toml ]; then \
        pip install .; \
    fi

CMD ["/bin/bash"][0m
