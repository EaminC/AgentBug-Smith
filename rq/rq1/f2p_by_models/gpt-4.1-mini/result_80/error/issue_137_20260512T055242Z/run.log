    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN="forge-key"

WORKDIR /app

# Install system dependencies needed for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    libffi-dev \
    make \
    && rm -rf /var/lib/apt/lists/*

# Copy entire project into container
COPY . .

# Upgrade pip, setuptools and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install python dependencies if requirements.txt exists
RUN set -eux; \
    if [ -f "python/requirements.txt" ]; then \
        pip install -r python/requirements.txt; \
    fi

# Install test dependencies and the project itself in editable mode
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm
RUN pip install -e ./python

# Preflight check to verify imports
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Use bash shell as the container command
CMD ["/bin/bash"]
