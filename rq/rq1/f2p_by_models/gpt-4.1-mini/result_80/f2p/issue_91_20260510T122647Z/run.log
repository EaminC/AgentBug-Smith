[32mimport pytest
from agentscope.agents import TextToImageAgent, DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.msghub import msghub
import agentscope


def test_text_to_image_agent_receives_dialogagent_message():
    # Initialize agentscope with dummy model configs to avoid real API calls
    agent_to_chat = agentscope.init(model_configs=[
        {
            "config_name": "qwen-max",
            "model_type": "dashscope_chat",
            "model_name": "qwen-max",
            "api_key": "dummy_api_key"
        }
    ])
    agent_to_image = agentscope.init(model_configs=[
        {
            "config_name": "wanx-v1",
            "model_type": "dashscope_image_synthesis",
            "model_name": "wanx-v1",
            "api_key": "dummy_api_key"
        }
    ])

    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt="You are tasked with narrowing down the user's description of the need to 100 words or less and relaying it to the painter for him to draw. Note that the language you generate after listening must be spoken to the painter!",
        model_config_name="qwen-max"
    )
    agent_2 = TextToImageAgent(
        name="painter",
        sys_prompt="You are a painter, and your task is to take an assistant's description of the image and generate it",
        model_config_name="wanx-v1"
    )
    useragent = UserAgent()

    # Compose initial message from user
    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    with msghub(participants=[agent_1, agent_2]) as hub:
        # Send message to DialogAgent
        agent_1(x)
        # Then call TextToImageAgent without explicit input, it should get last message from memory
        image_msg = agent_2()

        # The returned message from TextToImageAgent should have content and url (image_urls)
        assert image_msg is not None, "TextToImageAgent reply returned None"
        assert hasattr(image_msg, "content"), "TextToImageAgent reply missing content"
        assert hasattr(image_msg, "url"), "TextToImageAgent reply missing url"
        assert image_msg.content != "", "TextToImageAgent reply content is empty"
        assert image_msg.url is not None, "TextToImageAgent reply url is None"

        # Also check that the TextToImageAgent memory contains the last message with content
        mem = agent_2.memory.get_memory()
        assert len(mem) > 0, "TextToImageAgent memory is empty"
        last_mem_msg = mem[-1]
        assert hasattr(last_mem_msg, "content"), "Last memory message missing content"
        assert last_mem_msg.content != "", "Last memory message content is empty"

        # The content in the memory should be related to the dialog agent's output
        # i.e. the TextToImageAgent should have received the dialog agent's message content
        # We check that the content is not the initial user message (which was passed to DialogAgent)
        # but the processed message from DialogAgent (which should be in memory)
        # Since we cannot guarantee exact content, just check that content is a non-empty string
        assert isinstance(last_mem_msg.content, str)
        assert len(last_mem_msg.content) > 10  # arbitrary minimal length to ensure meaningful content


if __name__ == "__main__":
    pytest.main([__file__])[0m
