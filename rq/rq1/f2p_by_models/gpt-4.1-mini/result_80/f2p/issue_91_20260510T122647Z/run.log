# --- end inject ---

# Set environment variables for Forge API (OpenAI-compatible and Anthropic-compatible)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

COPY . .

RUN python -m pip install --upgrade pip setuptools wheel

# Install Poetry
RUN pip install poetry

# Install dependencies using Poetry, disable virtualenv creation to install in global environment
RUN poetry config virtualenvs.create false && poetry install --no-interaction --no-ansi

# Reinstall the package as editable to ensure tests can import the 'agentscope' module
RUN pip install -e .

# Install required test dependencies explicitly
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio litellm "setuptools<=81.0.0"

# Set PYTHONPATH to /app so that import of src packages works in tests
ENV PYTHONPATH=/app

# Preflight verification that pytest and pkg_resources can be imported
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

