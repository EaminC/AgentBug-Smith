def test_text_to_image_agent_receives_dialogagent_message():
    # Patch the internal model calls to avoid real API calls and return dummy responses
    class DummyResponse:
        def __init__(self):
            self.text = "Narrowed description for painter"
            self.image_urls = ["http://dummyimage.com/fake.png"]

    def dummy_chat_model_call(prompt):
        return DummyResponse()

    def dummy_image_model_call(text):
        return DummyResponse()

    with patch("agentscope.models.dashscope_model.DashScopeChatModel.__call__", side_effect=dummy_chat_model_call), \
         patch("agentscope.models.dashscope_model.DashScopeImageSynthesisModel.__call__", side_effect=dummy_image_model_call):
        # Initialize agentscope with dummy model configs to avoid real API calls
        agent_to_chat = agentscope.init(
            model_configs=[
                {
                    "config_name": "qwen-max",
                    "model_type": "dashscope_chat",
                    "model_name": "qwen-max",
                    "api_key": "dummy_api_key",
                }
            ]
        )
        agent_to_image = agentscope.init(
            model_configs=[
                {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "dummy_api_key",
                }
            ]
        )

        # Create DialogAgent with required parameters
        agent_1 = DialogAgent(
            name="assistants",
            sys_prompt=(
                "You are tasked with narrowing down the user's description of the need "
                "to 100 words or less and relaying it to the painter for him to draw. "
                "Note that the language you generate after listening must be spoken to the painter!"
            ),
            model_config_name="qwen-max",
        )

        # Create TextToImageAgent with empty sys_prompt as per fix
        agent_2 = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )

        useragent = UserAgent()

        # Create initial message from user
        x = Msg(
            name="host",
            content="I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha",
        )

        with msghub(participants=[agent_1, agent_2]) as hub:
            # DialogAgent receives user message and replies
            response_msg = agent_1(x)
            assert response_msg is not None
            assert hasattr(response_msg, "content")
            assert "narrow" in response_msg.content.lower() or "description" in response_msg.content.lower()

            # TextToImageAgent should receive the message from DialogAgent memory automatically (fix)
            image_msg = agent_2()
            assert image_msg is not None
            assert hasattr(image_msg, "content")
            assert "image" in image_msg.content.lower()
            # The image URLs should be present and be a list with at least one URL
            assert hasattr(image_msg, "url")
            assert isinstance(image_msg.url, list)
            assert len(image_msg.url) > 0
            assert image_msg.url[0].startswith("http")

            # UserAgent can be called without error
            useragent()

            # Check that TextToImageAgent memory contains the DialogAgent's message
            memory_msgs = agent_2.memory.get_memory()
            assert any(
                (msg.content == response_msg.content or msg.content == image_msg.content)
                for msg in memory_msgs
            ) or len(memory_msgs) >= 2[0m
