from unittest.mock import patch
from aider.models import ModelInfoManager


class TestBedrockClaudeSonnet45Support(unittest.TestCase):
    def setUp(self):
        # Load the model info manager fresh for each test
        self.mim = ModelInfoManager()

    def test_bedrock_claude_sonnet_4_5_model_registered(self):
        # The model name to test for
        model_name = "bedrock/global.anthropic.claude-sonnet-4-5-20250929-v1:0"

        # The model should be registered in the model info manager after the fix
        # Before the fix, this test should fail because the model is not registered
        found = False
        for model in self.mim.models:
            if model.name == model_name:
                found = True
                # Check some expected properties from the patch
                self.assertEqual(model.edit_format, "diff")
                self.assertTrue(model.use_repo_map)
                self.assertIn("thinking_tokens", model.accepts_settings)
                self.assertEqual(model.editor_model_name, model_name)
                # Check extra_params keys exist
                self.assertIn("extra_params", model.__dict__)
                self.assertIn("extra_headers", model.extra_params)
                self.assertIn("anthropic-beta", model.extra_params["extra_headers"])
                break
        self.assertTrue(found, f"Model {model_name} not registered in model-settings.yml")


