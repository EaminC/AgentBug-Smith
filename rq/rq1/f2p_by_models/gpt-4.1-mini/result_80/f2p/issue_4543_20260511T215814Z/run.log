[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Copy entire repo to ensure injected tests/scripts are included
COPY . .

# Upgrade package tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Detect src layout or src imports in tests to avoid editable install if src layout detected
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
      pip install -r requirements.txt 2>/dev/null || true && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    else \
      pip install -r requirements.txt 2>/dev/null || true && \
      pip install -e . && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# Preflight import check to fail fast if core modules missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests to verify installation and code correctness
RUN pytest

# Minimal runtime image
