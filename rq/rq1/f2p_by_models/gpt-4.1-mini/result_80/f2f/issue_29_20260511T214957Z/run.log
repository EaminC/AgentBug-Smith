def test_gen_file_name_suffix_correct(chain_with_agent):
    # The generated filename must have correct suffix (.py for python)
    filename = chain_with_agent.gen_file_name("Generate a training script")
    assert filename.endswith(".py")
    assert "training_script" in filename


def test_gen_file_name_accepts_user_input(chain_with_agent):
    # This test simulates user rejecting the generated filename and providing a new one
    buggy_response = "File Name: training_data.csv"
    chain_with_agent.agent = DummyAgent(buggy_response)

    # Patch questionary.confirm to return False (reject generated name)
    # Patch questionary.text to return a valid python filename
