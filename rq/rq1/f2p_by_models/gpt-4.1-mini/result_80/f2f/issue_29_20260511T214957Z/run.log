[32mimport os
import builtins
import pytest
from unittest import mock

from agent.function.chain import Chain, extract_file_name
from agent.types.step import Plan, Task


def test_extract_file_name_parsing():
    # Valid extraction
    content = "File Name: train_model.py"
    filename = extract_file_name(content)
    assert filename == "train_model.py"

    # Leading/trailing spaces
    content = "File Name:   example.py  "
    filename = extract_file_name(content)
    assert filename == "example.py"

    # No "File Name:" prefix
    content = "Filename: wrong_prefix.py"
    filename = extract_file_name(content)
    assert filename is None

    # Empty after prefix
    content = "File Name:   "
    filename = extract_file_name(content)
    assert filename is None

    # Multiple lines, filename on first line
    content = "File Name: first.py\nSome other text"
    filename = extract_file_name(content)
    assert filename == "first.py"


def test_generated_file_name_is_not_csv(monkeypatch):
    # This test ensures that the generated file name is not a .csv file,
    # which was a bug reported in the issue.

    plan = Plan(
        project_name="dummy_project",
        project="/tmp/dummy_project",
        launch_env="dummy_env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    # Setup console mock with context manager support for status()
    chain.console = mock.Mock()
    chain.console.status.return_value.__enter__.return_value = chain.console
    chain.console.status.return_value.__exit__.return_value = None
    chain.agent = mock.Mock()
    chain.chat_history = []

    class DummyChoice:
        def __init__(self, content):
            self.message = mock.Mock()
            self.message.content = content

    class DummyCompletion:
        def __init__(self, content):
            self.choices = [DummyChoice(content)]

    # Simulate the agent returning a .csv file name, which is incorrect
    chain.agent.completions.return_value = DummyCompletion("File Name: data.csv")

    # Patch questionary.confirm to always confirm True
    monkeypatch.setattr("questionary.confirm", lambda *args, **kwargs: True)

    filename = chain.gen_file_name("generate training file")
    # The bug was that sometimes .csv was returned, but the fix should prevent this.
    # So the filename should NOT end with .csv
    assert filename is not None
    assert not filename.endswith(".csv"), "Generated file name should not be .csv"


def test_training_entry_file_attribute_usage(tmp_path):
    # Test that Chain uses training_entry_file attribute consistently

    plan = Plan(
        project_name="dummy_project",
        project=str(tmp_path),
        launch_env="dummy_env",
        current_task=1,
        lang="python",
        llm="dummy",
        training_entry_file=str(tmp_path / "entry.py"),
        debug_env=None,
        requirement="do something",
        dataset="dataset.csv",
        tasks=[Task(name="task1", description="desc")],
