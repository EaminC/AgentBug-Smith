def test_extract_file_name_parsing():
    # Valid output with correct format
    valid_output = "File Name: training_script.py"
    filename = extract_file_name(valid_output)
    assert filename is not None
    assert filename.endswith(".py")
    assert "training_script" in filename

    # Invalid output returns empty string (not None)
    invalid_output = "No file name here"
    filename = extract_file_name(invalid_output)
    assert filename == ""


def test_gen_file_name_suffix_correct(chain_with_agent):
    # Should generate a filename with correct suffix for python
    filename = chain_with_agent.gen_file_name("Generate training entry")
    assert filename.endswith(".py")
    # It should update the plan.training_entry_file attribute
    assert chain_with_agent.plan.training_entry_file == filename
    # The filename should be inside the project directory
    assert filename.startswith(chain_with_agent.plan.project)


def test_gen_file_name_accepts_user_input(chain_with_agent):
    # Patch questionary.confirm to return False to simulate user rejecting the generated name
    with mock.patch("questionary.confirm", return_value=False), \
         mock.patch("questionary.text", return_value="custom_name.py"):
        filename = chain_with_agent.gen_file_name("Generate training entry")
        assert filename.endswith(".py")
        assert filename.endswith("custom_name.py")
        assert chain_with_agent.plan.training_entry_file == filename


def test_gen_task_content_reads_training_entry_file(chain_with_agent, tmp_path):
    # Create a dummy training entry file
    training_file_path = tmp_path / "training_script.py"
    training_file_path.write_text("print('hello world')")

    chain_with_agent.plan.training_entry_file = str(training_file_path)
    chain_with_agent.plan.lang = "python"
    chain_with_agent.console = mock.Mock()
    # Provide dummy agent completions to avoid errors in handle_streaming
    chain_with_agent.agent = DummyAgent("print('dummy')")
    chain_with_agent.console.status.return_value.__enter__.return_value = mock.Mock()
    chain_with_agent.console.status.return_value.__exit__.return_value = None
    chain_with_agent.console.print = mock.Mock()
    chain_with_agent.console.log = mock.Mock()

    task = Task(name="dummy", debug=False, kind="train")

    content = chain_with_agent.gen_task_content(task)
    assert content is not None
    assert "print" in content


def test_gen_task_content_no_file_returns_none(chain_with_agent):
    # Provide a non-existent file path
    chain_with_agent.plan.training_entry_file = "/non/existent/file.py"
    chain_with_agent.plan.lang = "python"
    chain_with_agent.console = mock.Mock()
    chain_with_agent.agent = DummyAgent("print('dummy')")
    chain_with_agent.console.status.return_value.__enter__.return_value = mock.Mock()
    chain_with_agent.console.status.return_value.__exit__.return_value = None
    chain_with_agent.console.print = mock.Mock()
    chain_with_agent.console.log = mock.Mock()

    task = Task(name="dummy", debug=False, kind="train")

    content = chain_with_agent.gen_task_content(task)
    assert content is None


def test_training_entry_file_attribute_usage(tmp_path):
    # Test that training_entry_file attribute is used correctly in Chain methods
    plan = Plan(
        project_name="dummy_project",
        project=str(tmp_path / "dummy_project"),
        launch_env="dummy_env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.console = mock.Mock()
    chain.console.status.return_value.__enter__.return_value = mock.Mock()
    chain.console.status.return_value.__exit__.return_value = None
    chain.console.print = mock.Mock()
    chain.console.log = mock.Mock()
    chain.chat_history = []
    chain.agent = DummyAgent("File Name: train_entry.py")
    chain.user_requirement = None
    chain.project_home = plan.project
    chain.project_setting_file = os.path.join(chain.project_home, "project.yml")
    chain.training_entry_file = None
    chain.dataset = None
    chain.project_name = plan.project_name

    # Patch read_file_to_string to return dummy content
    def dummy_read_file_to_string(path):
        return "print('dummy')"

    with mock.patch("agent.function.chain.read_file_to_string", side_effect=dummy_read_file_to_string), \
         mock.patch("questionary.confirm", return_value=True):
        filename = chain.gen_file_name("Generate training entry")
        assert filename.endswith(".py")
        assert chain.plan.training_entry_file == filename

    # Now test update_project_state does not raise and updates project_setting_file
    # Patch update_project_state to just set a flag
    called = {}

    def dummy_update_project_state():
        called['updated'] = True

    chain.update_project_state = dummy_update_project_state
    chain.user_requirement = "some requirement"
    chain.training_entry_file = filename
    chain.dataset = "some_dataset"
    chain.plan.requirement = chain.user_requirement
    chain.plan.dataset = chain.dataset

    # Simulate the main loop condition to test no exceptions
    # We patch questionary.text to provide dataset input if needed
    with mock.patch("questionary.text", return_value="dataset_path"), \
         mock.patch("questionary.confirm", return_value=True):
        # We test that no exception is raised when user_requirement and dataset are set
        # and training_entry_file is set
        # The method that uses training_entry_file is gen_task_content; test it here
        task = Task(name="dummy", debug=False, kind="train")
        chain.agent = DummyAgent("print('dummy')")
        content = chain.gen_task_content(task)
        assert content is not None

    # Confirm that dummy_update_project_state was called if used
