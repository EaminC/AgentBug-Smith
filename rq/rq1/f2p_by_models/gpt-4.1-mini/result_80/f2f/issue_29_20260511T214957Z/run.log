[32mimport os
import builtins
import pytest
from unittest import mock
from agent.function.chain import Chain
from agent.types.step import Plan, Task
from agent.prompt.base import pmpt_chain_filename

# The bug is about sometimes the generated training file would be .csv
# The fix ensures the generated file name has correct suffix (e.g. .py for python)
# We want to test that Chain.gen_file_name returns a filename with correct suffix, never .csv


def test_extract_file_name_parsing():
    # Test the helper function extract_file_name used in gen_file_name to parse output format
    from agent.function.chain import extract_file_name

    # Normal case
    text = "File Name: train.py"
    assert extract_file_name(text) == "train.py"

    # Extra spaces
    text = "File Name:    model_training.py  "
    assert extract_file_name(text) == "model_training.py"

    # Lowercase label
    text = "file name: data_processing.py"
    assert extract_file_name(text) == "data_processing.py"

    # Missing File Name label returns None
    text = "Filename: something.py"
    assert extract_file_name(text) is None

    # Malformed line returns None
    text = "File Name train.py"
    assert extract_file_name(text) is None


def test_generated_file_name_is_not_csv(monkeypatch):
    # Setup a Plan with python language
    plan = Plan(
        project_name="dummy_project",
        project="/tmp",
        launch_env="dummy_env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )

    # Patch the agent attribute completions to simulate LLM response
    class DummyChoice:
        def __init__(self, content):
            self.message = mock.Mock()
            self.message.content = content

    class DummyCompletion:
        def __init__(self, content):
            self.choices = [DummyChoice(content)]

    class DummyAgent:
        def completions(self, chat_history, stream=False):
            # Return a file name with .csv suffix to simulate buggy output
            return DummyCompletion("File Name: training_data.csv")

    chain = Chain.__new__(Chain)
    # Setup minimal attributes used by gen_file_name
    chain.plan = plan
    chain.agent = DummyAgent()
    chain.chat_history = []
    chain.console = mock.Mock()
    chain.project_home = plan.project
    chain.project_setting_file = os.path.join(plan.project, "project.yml")
    chain.training_entry_file = None
    chain.plan.training_entry_file = None
    chain.console.status = mock.Mock()
    chain.console.print = mock.Mock()

    # Patch questionary.confirm to simulate user confirmation True
    with mock.patch("questionary.confirm", return_value=True):
        # Call gen_file_name, it should never accept .csv as valid suffix for python
        filename = chain.gen_file_name("some requirement")

    # The filename should NOT end with .csv (buggy)
    # The fix enforces correct suffix, so filename should end with .py
    assert filename.endswith(".py"), f"Generated filename has wrong suffix: {filename}"


def test_training_entry_file_attribute_usage():
    # Test that Chain uses training_entry_file attribute instead of target
    plan = Plan(
        project_name="dummy_project",
        project="/tmp",
        launch_env="dummy_env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file="entry.py",
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.console = mock.Mock()
    chain.console.print = mock.Mock()
    chain.console.status = mock.Mock()
    chain.console.log = mock.Mock()

    # Patch read_file_to_string to return some code content
    from agent.function.chain import read_file_to_string

    def dummy_read_file_to_string(path):
        if path == plan.training_entry_file:
            return "print('hello')"
        return None

    # Patch read_file_to_string inside chain module
    import agent.function.chain
    original_read_file_to_string = agent.function.chain.read_file_to_string
    agent.function.chain.read_file_to_string = dummy_read_file_to_string

    # Call gen_task_content should read training_entry_file content
    task = Task(name="dummy", description="desc")
    content = chain.gen_task_content(task)

    assert content is not None
    assert "print('hello')" in content

    # Restore patched function
    agent.function.chain.read_file_to_string = original_read_file_to_string


