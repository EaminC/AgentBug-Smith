    class DummyAgent:
        def completions(self, chat_history, stream=False):
            # Return a dummy file name with .py extension
            return DummyCompletion("File Name: train.py")

    chain.agent = DummyAgent()
    return chain


def test_gen_file_name_returns_correct_extension(chain_instance):
    # Test that gen_file_name returns a filename with .py extension
    with mock.patch("agent.function.chain.extract_file_name", return_value="train.py"):
        with mock.patch("agent.function.chain.questionary.confirm", return_value=True):
            filename = chain_instance.gen_file_name("Train a model")
            assert filename.endswith(".py")
            assert "train.py" in filename


def test_gen_file_name_never_returns_csv(monkeypatch, chain_instance):
    # Simulate LLM returning .csv first, then .py after rejection
    responses = ["data.csv", "train.py"]
    confirm_calls = [False, True]

    def side_effect_confirm(*args, **kwargs):
        return confirm_calls.pop(0)

    monkeypatch.setattr(chain_instance.console, "print", lambda *a, **k: None)
    monkeypatch.setattr(chain_instance.console, "status", lambda *a, **k: mock.MagicMock(__enter__=lambda s: s, __exit__=lambda s, exc_type, exc_val, exc_tb: False))
    monkeypatch.setattr(questionary, "confirm", side_effect=side_effect_confirm)
    monkeypatch.setattr(questionary, "text", side_effect=lambda *a, **k: "train.py")

    with mock.patch("agent.function.chain.extract_file_name", side_effect=responses):
        filename = chain_instance.gen_file_name("Generate a training script")
        assert filename.endswith(".py")
        assert not filename.endswith(".csv")


def test_gen_file_name_reject_and_rename(monkeypatch, chain_instance):
    # Simulate user rejecting first generated name and providing a new one
    monkeypatch.setattr(chain_instance.console, "print", lambda *a, **k: None)
    monkeypatch.setattr(chain_instance.console, "status", lambda *a, **k: mock.MagicMock(__enter__=lambda s: s, __exit__=lambda s, exc_type, exc_val, exc_tb: False))
    monkeypatch.setattr(questionary, "confirm", side_effect=[False, True])
    monkeypatch.setattr(questionary, "text", side_effect=["data.csv", "train.py"])

    with mock.patch("agent.function.chain.extract_file_name", side_effect=["data.csv", "train.py"]):
        filename = chain_instance.gen_file_name("Train a model")
        assert filename.endswith(".py")
        assert "train.py" in filename


def test_gen_task_content_reads_correct_file(tmp_path, chain_instance):
    # Create a dummy training entry file with some content
    file_path = tmp_path / "train.py"
    file_path.write_text("print('hello world')")
    chain_instance.plan.training_entry_file = str(file_path)
    chain_instance.plan.lang = "python"
    chain_instance.user_requirement = "Train a model"

    content = chain_instance.gen_task_content(Task(name="dummy", debug=False))
    assert "print('hello world')" in content


def test_run_command_uses_training_entry_file(monkeypatch, chain_instance, tmp_path):
    # Create dummy training entry file
    file_path = tmp_path / "train.py"
    file_path.write_text("print('run test')")
    chain_instance.plan.training_entry_file = str(file_path)
    chain_instance.plan.lang = "python"
    chain_instance.user_requirement = "Train a model"

    # Patch run_command to capture command
    called = {}

    def fake_run_command(cmd):
        called['cmd'] = cmd
        return ("output", 0)

    monkeypatch.setattr("agent.utils.system.run_command", fake_run_command)

    # Run debug task
    task = Task(name="dummy", debug=True)
    chain_instance.gen_task_content(task)
    # The command should use the training_entry_file path
    assert any(str(file_path) in part for part in called['cmd'])


def test_update_project_state_updates_plan_file(tmp_path, chain_instance):
    # Patch update_project_plan to capture call
    called = {}

    def fake_update_project_plan(project_home, plan_dict):
        called['project_home'] = project_home
        called['plan_dict'] = plan_dict

    monkeypatch = mock.patch("agent.utils.config.update_project_plan", side_effect=fake_update_project_plan)
    with monkeypatch:
        chain_instance.plan.training_entry_file = "train.py"
        chain_instance.update_project_state()
        assert called['project_home'] == chain_instance.project_home
        assert "training_entry_file" in called['plan_dict']


def test_main_loop_requires_dataset_and_requirement(monkeypatch, chain_instance):
    # Setup chain with no requirement and no dataset
    chain_instance.plan.requirement = None
    chain_instance.plan.dataset = None
    chain_instance.user_requirement = None
    chain_instance.dataset = None

    # Patch questionary.text to provide requirement and dataset
    inputs = iter(["My requirement", "my_dataset.csv"])

    def fake_text(*args, **kwargs):
        return next(inputs)

    monkeypatch.setattr(questionary, "text", side_effect=fake_text)
    monkeypatch.setattr(questionary, "confirm", return_value=True)
    monkeypatch.setattr(chain_instance.console, "print", lambda *a, **k: None)
    monkeypatch.setattr(chain_instance.console, "status", lambda *a, **k: mock.MagicMock(__enter__=lambda s: s, __exit__=lambda s, exc_type, exc_val, exc_tb: False))
    monkeypatch.setattr(chain_instance, "gen_file_name", lambda req: "train.py")
    monkeypatch.setattr(chain_instance, "update_project_state", lambda: None)

    # We test the main loop logic by calling the relevant code inside gen_task_content or a similar method
    # But gen_task_content requires a Task, so create a dummy one
    task = Task(name="dummy", debug=False)

    # The main loop is inside Chain.run() or similar, but not exposed.
    # So we simulate the logic that requires dataset and requirement.
    # We check that after setting, plan has the values.
    # We simulate the main loop partially here:

    # Simulate requirement input
    if chain_instance.plan.requirement is None:
        chain_instance.user_requirement = questionary.text("Hi, what are your requirements?").ask()
        chain_instance.plan.requirement = chain_instance.user_requirement

    # Simulate dataset input
    if chain_instance.plan.dataset is None:
        chain_instance.dataset = questionary.text("Where is your raw dataset?").ask()
        chain_instance.plan.dataset = chain_instance.dataset

    assert chain_instance.plan.requirement == "My requirement"
    assert chain_instance.plan.dataset == "my_dataset.csv"


