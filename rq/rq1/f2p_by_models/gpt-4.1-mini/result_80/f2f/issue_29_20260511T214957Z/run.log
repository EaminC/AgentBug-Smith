[32mimport os
import builtins
import pytest
from unittest import mock

from agent.function.chain import Chain, extract_file_name
from agent.types.step import Plan, Task


def test_extract_file_name_parsing():
    # The extract_file_name function should correctly parse the file name from the prompt output
    content = "File Name: train_model.py"
    filename = extract_file_name(content)
    assert filename == "train_model.py"

    content = "File Name: data_preprocessing.py\nSome extra text"
    filename = extract_file_name(content)
    assert filename == "data_preprocessing.py"

    content = "File Name:    example.py   "
    filename = extract_file_name(content)
    assert filename == "example.py"

    content = "No file name here"
    filename = extract_file_name(content)
    assert filename == ""


def test_generated_file_name_is_not_csv(monkeypatch):
    # The generated file name should never be a .csv file (bug was that sometimes it was)
    # We mock the agent.completions to return a .csv file name and check that gen_file_name corrects it

    plan = Plan(
        project_name="test_project",
        project="/tmp/test_project",
        launch_env="env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.console = mock.Mock()
    chain.chat_history = []

    # Mock agent.completions to return a .csv file name
    class DummyChoice:
        def __init__(self, content):
            self.message = mock.Mock()
            self.message.content = content

    class DummyCompletion:
        def __init__(self, content):
            self.choices = [DummyChoice(content)]

    class DummyAgent:
        def completions(self, chat_history, stream=False):
            # Return a .csv file name to simulate buggy behavior
            return DummyCompletion("File Name: training_data.csv")

    chain.agent = DummyAgent()

    # Patch questionary.confirm to always return True (accept the generated name)
    monkeypatch.setattr("questionary.confirm", lambda *args, **kwargs: True)

    # Patch questionary.text to return a valid python file name if asked
    monkeypatch.setattr("questionary.text", lambda *args, **kwargs: "train.py")

    # Call gen_file_name and check that the returned file name is not .csv
    filename = chain.gen_file_name("some requirement")

    # The buggy code would accept .csv, but fixed code should not.
    # Because the test cannot know internal fix logic, we check that the returned filename ends with .py
    assert filename.endswith(".py")
    assert not filename.endswith(".csv")


