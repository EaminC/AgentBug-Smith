    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.console = mock.Mock()
    chain.agent = mock.Mock()

    dummy_response = mock.Mock()
    dummy_response.choices = [mock.Mock()]
    dummy_response.choices[0].message = mock.Mock()
    dummy_response.choices[0].message.content = "File Name: training_script.py"
    chain.agent.completions = mock.Mock(return_value=dummy_response)

    # Simulate user cancelling the confirm prompt (returns False)
    with mock.patch("questionary.confirm", return_value=False), \
         mock.patch("questionary.text", side_effect=KeyboardInterrupt):
        # gen_file_name should propagate KeyboardInterrupt or return None gracefully
        with pytest.raises(KeyboardInterrupt):
            chain.gen_file_name("some requirement")

