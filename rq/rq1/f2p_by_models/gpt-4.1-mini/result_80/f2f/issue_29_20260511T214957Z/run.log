[32mimport os
import re
import builtins
import pytest
from unittest import mock

from agent.function.chain import Chain
from agent.types.step import Plan, Task
from agent.utils.system import extract_file_name, read_file_to_string


def test_training_entry_file_attribute_usage():
    """
    Test that the Chain class uses 'training_entry_file' attribute instead of 'target'.
    This test ensures the attribute is present and can be set and retrieved properly.
    """
    plan = Plan(
        project_name="test_project",
        project="/tmp",
        launch_env="env",
        current_task=1,
        lang="python",
        llm="dummy",
        training_entry_file="entry.py",
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    assert hasattr(chain.plan, "training_entry_file")
    assert chain.plan.training_entry_file == "entry.py"


def test_gen_task_content_reads_training_entry_file(tmp_path):
    """
    Test that gen_task_content reads content from the training_entry_file.
    """
    file_path = tmp_path / "train_entry.py"
    content = "print('hello')"
    file_path.write_text(content)

    plan = Plan(
        project_name="test_project",
        project=str(tmp_path),
        launch_env="env",
        current_task=1,
        lang="python",
        llm="dummy",
        training_entry_file=str(file_path),
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.console = mock.Mock()
    chain.agent = mock.Mock()

    # patch read_file_to_string to use the real function
    # but it should read the file correctly
    result = chain.gen_task_content(Task(name="dummy"))
    assert content in result


def test_gen_task_content_no_file_returns_none(tmp_path):
    """
    Test gen_task_content returns None if training_entry_file does not exist.
    """
    plan = Plan(
        project_name="test_project",
        project=str(tmp_path),
        launch_env="env",
        current_task=1,
        lang="python",
        llm="dummy",
        training_entry_file=str(tmp_path / "nonexistent.py"),
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.console = mock.Mock()
    chain.agent = mock.Mock()

    result = chain.gen_task_content(Task(name="dummy"))
    assert result is None


def test_gen_file_name_suffix_correct(monkeypatch):
    """
    Test that gen_file_name returns a filename with correct suffix for python.
    """
    plan = Plan(
        project_name="test_project",
        project="/tmp",
        launch_env="env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.console = mock.Mock()
    chain.agent = mock.Mock()
    chain.chat_history = []

    # Mock agent.completions to return a filename with .py suffix
    dummy_response = mock.Mock()
    dummy_response.choices = [mock.Mock()]
    dummy_response.choices[0].message = mock.Mock()
    dummy_response.choices[0].message.content = "File Name: train_script.py"
    chain.agent.completions = mock.Mock(return_value=dummy_response)

    # Patch questionary.confirm to always accept
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: True)

    filename = chain.gen_file_name("some requirement")
    assert filename.endswith(".py")
    assert "train_script.py" in filename


def test_gen_file_name_accepts_user_input(monkeypatch):
    """
    Test that gen_file_name allows user to reject generated name and provide new one.
    """
    plan = Plan(
        project_name="dummy_project",
        project="/tmp",
        launch_env="dummy_env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.console = mock.Mock()
    chain.agent = mock.Mock()
    chain.chat_history = []

    # First response with wrong name
    dummy_response1 = mock.Mock()
    dummy_response1.choices = [mock.Mock()]
    dummy_response1.choices[0].message = mock.Mock()
    dummy_response1.choices[0].message.content = "File Name: wrong_name.txt"

    # Second response with correct name
    dummy_response2 = mock.Mock()
    dummy_response2.choices = [mock.Mock()]
    dummy_response2.choices[0].message = mock.Mock()
    dummy_response2.choices[0].message.content = "File Name: correct_name.py"

    # Setup agent.completions to always return dummy_response1 (simulate only one call)
    chain.agent.completions = mock.Mock(return_value=dummy_response1)

    # Patch questionary.confirm to reject first name, accept second
    confirm_side_effect = [False, True]
    text_side_effect = ["correct_name.py"]

    monkeypatch.setattr("questionary.confirm", lambda *a, **k: confirm_side_effect.pop(0))
    monkeypatch.setattr("questionary.text", lambda *a, **k: text_side_effect.pop(0))

    filename = chain.gen_file_name("some requirement")
    assert filename.endswith(".py")
    assert "correct_name.py" in filename


def test_gen_file_name_handles_keyboard_interrupt(monkeypatch):
    """
    Test that gen_file_name handles KeyboardInterrupt gracefully.
    """
    plan = Plan(
        project_name="dummy_project",
        project="/tmp",
        launch_env="dummy_env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.console = mock.Mock()
    chain.agent = mock.Mock()
    chain.chat_history = []

    dummy_response = mock.Mock()
    dummy_response.choices = [mock.Mock()]
    dummy_response.choices[0].message = mock.Mock()
    dummy_response.choices[0].message.content = "File Name: train.py"
    chain.agent.completions = mock.Mock(return_value=dummy_response)

    def raise_keyboard_interrupt(*args, **kwargs):
        raise KeyboardInterrupt()

    monkeypatch.setattr("questionary.confirm", raise_keyboard_interrupt)

    with pytest.raises(KeyboardInterrupt):
        chain.gen_file_name("some requirement")


def test_extract_file_name_parsing():
    """
    Test extract_file_name parses file name correctly from text.
    """
    text = "Some text\nFile Name: example.py\nMore text"
    filename = extract_file_name(text)
    assert filename == "example.py"


def test_extract_file_name_returns_empty_string_for_none():
    """
    Test extract_file_name returns empty string if input is None.
    """
    assert extract_file_name(None) == ""


def test_extract_file_name_handles_various_formats():
    """
    Test extract_file_name handles various input formats gracefully.
    """
    assert extract_file_name("") == ""
    assert extract_file_name("File Name: test.py") == "test.py"
    assert extract_file_name("File Name: test.py\nExtra") == "test.py"
    assert extract_file_name("No file name here") == ""


def test_extract_file_name_none_input_returns_empty_string():
    # Defensive test: extract_file_name should not raise on None input
    assert extract_file_name(None) == ""


def test_extract_file_name_empty_string_returns_empty_string():
    assert extract_file_name("") == ""


def test_gen_file_name_sets_chat_history(monkeypatch):
    """
    Test that gen_file_name initializes and uses chat_history attribute.
    """
