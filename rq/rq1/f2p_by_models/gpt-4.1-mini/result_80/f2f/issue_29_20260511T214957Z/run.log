def test_gen_file_name_reject_and_accept(monkeypatch):
    # Test gen_file_name returns the new filename when user rejects generated name and provides a new one

    plan = Plan(
        project_name="dummy_project",
        project="/tmp/dummy_project",
        launch_env="dummy_env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.console = mock.Mock()

    # Provide a context manager mock for console.status
    class DummyStatusCM:
        def __enter__(self):
            return chain.console
        def __exit__(self, exc_type, exc_val, exc_tb):
            return False
    chain.console.status = mock.Mock(return_value=DummyStatusCM())

    # Mock agent to return a valid filename
    class DummyChoice:
        def __init__(self, content):
            self.message = mock.Mock()
            self.message.content = content

    class DummyCompletion:
        def __init__(self, content):
            self.choices = [DummyChoice(content)]

    class DummyAgent:
        def completions(self, chat_history, stream=False):
            return DummyCompletion("File Name: train.py")

    chain.agent = DummyAgent()
    chain.chat_history = []

    # Patch questionary.confirm to first return False (reject), then True (accept new)
    confirm_calls = iter([False, True])
    monkeypatch.setattr("questionary.confirm", lambda *args, **kwargs: next(confirm_calls))
    # Patch questionary.text to provide a new filename
    monkeypatch.setattr("questionary.text", lambda *args, **kwargs: "new_train.py")

    filename = chain.gen_file_name("Train a model")
    assert filename == os.path.join(plan.project, "new_train.py")
    assert chain.plan.training_entry_file == filename


