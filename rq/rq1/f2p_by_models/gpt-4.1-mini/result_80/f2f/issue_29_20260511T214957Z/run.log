    chain.console = DummyConsole()
    chain.chat_history = []
    chain.agent = DummyAgent("File Name: training_script.py")
    chain.user_requirement = None
    chain.project_home = plan.project
    chain.project_setting_file = os.path.join(chain.project_home, "project.yml")
    chain.training_entry_file = None
    chain.dataset = None
    chain.project_name = plan.project_name
    return chain


def test_extract_file_name_parsing():
    # Valid output with correct format
    valid_output = "File Name: training_script.py"
    filename = extract_file_name(valid_output)
    assert filename.endswith(".py")
    assert "training_script" in filename

    # Output with extra whitespace
    valid_output_ws = "  File Name:   example_train.py  "
    filename_ws = extract_file_name(valid_output_ws)
    assert filename_ws.endswith(".py")
    assert "example_train" in filename_ws

    # Output with no "File Name:" prefix returns empty string
    invalid_output = "No file name here"
    filename = extract_file_name(invalid_output)
    assert filename == ""

    # None input returns empty string
    filename = extract_file_name(None)
    assert filename == ""

    # Empty string input returns empty string
    filename = extract_file_name("")
    assert filename == ""


def test_gen_file_name_sets_chat_history(monkeypatch, chain_with_agent):
    chain = chain_with_agent
    # Patch console.status to DummyStatusContext to support context manager
    chain.console.status = lambda msg: DummyStatusContext()

    # Patch questionary.confirm to always return True
    monkeypatch.setattr(questionary, "confirm", lambda *a, **k: mock.Mock(ask=lambda: True))

    filename = chain.gen_file_name("Generate training entry")
    # The filename should end with .py (correct suffix)
    assert filename.endswith(".py")
    # The chat_history should contain system and user messages
    assert any("system" == msg.get("role") for msg in chain.chat_history)
    assert any("user" == msg.get("role") for msg in chain.chat_history)


def test_gen_file_name_accepts_user_input(monkeypatch, chain_with_agent):
    chain = chain_with_agent
    chain.console.status = lambda msg: DummyStatusContext()

    # Setup dummy completion with wrong suffix first, then correct suffix after user input
    dummy_response_wrong = DummyAgent("File Name: wrong.csv").completions([])
    dummy_response_correct = DummyAgent("File Name: correct.py").completions([])

    # Mock completions to return wrong suffix first, then correct suffix
    completions = [dummy_response_wrong, dummy_response_correct]

    def completions_side_effect(chat_history, stream=False):
        return completions.pop(0)

    chain.agent.completions = mock.Mock(side_effect=completions_side_effect)

    # Confirm mock to simulate user rejecting first filename, accepting second
    confirms = [False, True]

    class ConfirmMock:
        def __init__(self):
            self.calls = 0

        def ask(self):
            return confirms.pop(0)

    monkeypatch.setattr(questionary, "confirm", lambda *a, **k: ConfirmMock())

    # Text mock to provide new filename input
    texts = ["correct.py"]

    def text_mock(*args, **kwargs):
        class TextAnswer:
            def ask(self_inner):
                return texts.pop(0)
        return TextAnswer()

    monkeypatch.setattr(questionary, "text", text_mock)

    filename = chain.gen_file_name("some requirement")
    assert filename.endswith(".py")
    assert filename == os.path.join(chain.plan.project, "correct.py")


def test_gen_task_content_reads_training_entry_file(monkeypatch, chain_with_agent, tmp_path):
    chain = chain_with_agent
    chain.console.status = lambda msg: DummyStatusContext()

    # Create a dummy training entry file with some python code
    training_file_path = tmp_path / "train_entry.py"
    training_file_path.write_text("print('hello world')")

    chain.plan.training_entry_file = str(training_file_path)
    chain.plan.lang = "python"

    # Patch agent.completions to return a dummy completion with code
    dummy_code = "print('dummy code')"
    dummy_response = DummyAgent(dummy_code).completions([])
    chain.agent.completions = mock.Mock(return_value=dummy_response)

    # Patch read_file_to_string to read the file content
    import agent.function.chain as chain_module

    monkeypatch.setattr(chain_module, "read_file_to_string", lambda path: training_file_path.read_text())

    task = Task(name="dummy", kind="train", debug=False)
    content = chain.gen_task_content(task)
    assert content is not None
    assert "print" in content


def test_gen_task_content_no_file_returns_none(monkeypatch, chain_with_agent):
    chain = chain_with_agent
    chain.console.status = lambda msg: DummyStatusContext()

    # Provide a non-existent training_entry_file path
    chain.plan.training_entry_file = "/non/existent/file.py"
    chain.plan.lang = "python"

    # Patch read_file_to_string to return None simulating file not found
    import agent.function.chain as chain_module
    monkeypatch.setattr(chain_module, "read_file_to_string", lambda path: None)

    task = Task(name="dummy", kind="train", debug=False)
    content = chain.gen_task_content(task)
    assert content is None


def test_training_entry_file_attribute_usage(tmp_path, monkeypatch):
