[32mimport os
import builtins
import pytest
from unittest.mock import MagicMock, patch, mock_open

from agent.function.chain import Chain, extract_file_name
from agent.types.step import Plan, Task


class DummyAgent:
    def __init__(self, completion_text):
        self.completion_text = completion_text
        self.called_with = []

    def completions(self, chat_history, stream=False):
        self.called_with.append((chat_history, stream))
        class DummyChoice:
            def __init__(self, content):
                self.message = type("Msg", (), {"content": content})
        class DummyCompletion:
            def __init__(self, choices):
                self.choices = choices
        return DummyCompletion([DummyChoice(self.completion_text)])


@pytest.fixture
def chain_with_dummy_agent(tmp_path):
    # Setup a minimal Plan object
    plan = Plan(
        project_name="test_project",
        project=str(tmp_path),
        launch_env="test_env",
        current_task=1,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.chat_history = []
    chain.console = MagicMock()
    # Provide a context manager for console.status
    class DummyStatusCM:
        def __init__(self, msg):
            self.msg = msg
        def __enter__(self):
            return None
        def __exit__(self, exc_type, exc_val, exc_tb):
            return False
    chain.console.status.side_effect = lambda msg: DummyStatusCM(msg)
    chain.console.print = MagicMock()
    chain.console.log = MagicMock()
    chain.project_home = str(tmp_path)
    chain.project_setting_file = os.path.join(chain.project_home, "project.yml")
    chain.user_requirement = None
    chain.training_entry_file = None
    chain.dataset = None
    chain.project_name = plan.project_name
    chain.update_project_state = MagicMock()
    chain.agent = DummyAgent("File Name: train.py")
    return chain


def test_extract_file_name_parsing():
    assert extract_file_name("File Name: train.py") == "train.py"
    assert extract_file_name("File Name: data_processing.py") == "data_processing.py"
    assert extract_file_name("File Name: ") == ""
    assert extract_file_name("") == ""
    assert extract_file_name(None) == ""
    assert extract_file_name("Some irrelevant text") == ""
    assert extract_file_name("File Name: train.csv") == "train.csv"


def test_extract_file_name_returns_empty_string_for_none():
    assert extract_file_name(None) == ""


def test_extract_file_name_empty_string_returns_empty_string():
    assert extract_file_name("") == ""


def test_extract_file_name_none_input_returns_empty_string():
    assert extract_file_name(None) == ""


def test_extract_file_name_handles_various_formats():
    assert extract_file_name("File Name: my_script.py") == "my_script.py"
    assert extract_file_name("File Name: my-script.py") == "my-script.py"
    assert extract_file_name("File Name: my_script") == "my_script"
    assert extract_file_name("File Name: my_script.py\nExtra") == "my_script.py"


def test_generated_file_name_is_not_csv(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    # Provide a dummy completion that returns a .csv file name (which is buggy)
    chain.agent = DummyAgent("File Name: train.csv")
    # Patch questionary.confirm to always accept
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: True)
    # Patch questionary.text to return None (no rename)
    monkeypatch.setattr("questionary.text", lambda *a, **k: None)

    filename = chain.gen_file_name("some requirement")
    # The bug is that sometimes .csv is returned, which is wrong.
    # The fix should ensure the filename is not .csv.
    # So the test expects the filename NOT to end with .csv
    assert not filename.endswith(".csv"), "Generated filename should not be .csv"


def test_gen_file_name_sets_chat_history(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: True)
    monkeypatch.setattr("questionary.text", lambda *a, **k: None)
    chain.agent = DummyAgent("File Name: train.py")

    filename = chain.gen_file_name("req")
    assert filename.endswith(".py")
    # The chat history should contain the system prompt and user requirement
    assert any("Machine Learning Engineer" in msg["content"] for msg in chain.chat_history if msg["role"] == "system")
    assert any("req" == msg["content"] for msg in chain.chat_history if msg["role"] == "user")


def test_gen_file_name_accepts_user_input(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    # Simulate user confirms the generated name
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: True)
    # No rename requested
    monkeypatch.setattr("questionary.text", lambda *a, **k: None)
    chain.agent = DummyAgent("File Name: train.py")

    filename = chain.gen_file_name("req")
    assert filename.endswith(".py")
    assert chain.plan.training_entry_file == filename


def test_gen_file_name_user_cancels(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    # User rejects the generated name
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: False)
    # User provides a new name
    monkeypatch.setattr("questionary.text", lambda *a, **k: "custom_train.py")
    chain.agent = DummyAgent("File Name: train.py")

    filename = chain.gen_file_name("req")
    assert filename.endswith(".py")
    assert filename.endswith("custom_train.py")
    assert chain.plan.training_entry_file.endswith("custom_train.py")


def test_gen_file_name_no_name_raises(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: True)
    monkeypatch.setattr("questionary.text", lambda *a, **k: None)
    # Agent returns empty file name
    chain.agent = DummyAgent("File Name: ")

    with pytest.raises(SystemExit):
        chain.gen_file_name("req")


def test_gen_file_name_malformed_completion(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: True)
    monkeypatch.setattr("questionary.text", lambda *a, **k: None)
    # Agent returns no file name line at all
    chain.agent = DummyAgent("")

    with pytest.raises(SystemExit):
        chain.gen_file_name("req")


def test_gen_task_content_reads_training_entry_file(tmp_path, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    # Create a dummy training entry file with some content
    file_path = tmp_path / "train.py"
    file_path.write_text("print('hello world')")
    chain.plan.training_entry_file = str(file_path)
    chain.plan.lang = "python"
    chain.user_requirement = "some requirement"

    # The agent attribute is not used here, so keep dummy
    content = chain.gen_task_content(Task(name="dummy"))
    assert content is not None
    assert "print('hello world')" in content


def test_gen_task_content_no_file_returns_none(chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    # No training_entry_file set
    chain.plan.training_entry_file = None
    chain.plan.lang = "python"
    chain.user_requirement = "some requirement"

    content = chain.gen_task_content(Task(name="dummy"))
    assert content is None


