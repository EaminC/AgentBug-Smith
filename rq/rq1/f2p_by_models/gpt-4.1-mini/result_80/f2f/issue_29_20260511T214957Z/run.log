[32mimport os
import pytest
from unittest import mock
from agent.function.chain import Chain
from agent.types.step import Plan, Task
from agent.prompt.base import pmpt_chain_filename

# We will mock the agent's completions method to simulate the LLM response for filename generation.
# The buggy code sometimes generates a .csv file, which is incorrect for Python projects.
# The fix ensures the generated filename has the correct suffix (.py).
# This test will fail on buggy code (filename ends with .csv) and pass on fixed code (filename ends with .py).

class DummyCompletionChoice:
    def __init__(self, content):
        self.message = mock.Mock()
        self.message.content = content

class DummyCompletion:
    def __init__(self, content):
        self.choices = [DummyCompletionChoice(content)]

class DummyAgent:
    def __init__(self, response_content):
        self._response_content = response_content
        self.completions = mock.Mock(side_effect=self._completions)

    def _completions(self, chat_history, stream=False):
        return DummyCompletion(self._response_content)

@pytest.fixture
def dummy_plan(tmp_path):
    # Setup a dummy project directory and plan
    project_dir = tmp_path / "dummy_project"
    project_dir.mkdir()
    # Create a dummy training entry file path (initially None)
    plan = Plan(
        project_name="dummy_project",
        project=str(project_dir),
        launch_env="",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    return plan

