    plan = Plan(
        project_name="dummy_project",
        project=str(tmp_path / "dummy_project"),
        launch_env="dummy_env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    # Patch config.read to avoid AttributeError in Chain __init__
    with mock.patch("agent.utils.config.read", return_value={"project": {"path": plan.project}}):
        chain = Chain.__new__(Chain)
        chain.plan = plan
        chain.console = Console()
        chain.chat_history = []
        chain.agent = DummyAgent("File Name: train_entry.py")
        chain.user_requirement = None
        chain.project_home = plan.project
        chain.project_setting_file = os.path.join(chain.project_home, "project.yml")
        chain.training_entry_file = None
        chain.dataset = None
        chain.project_name = plan.project_name

        # Patch read_file_to_string to return dummy content
        def dummy_read_file_to_string(path):
            return "print('dummy')"

        with mock.patch("agent.function.chain.read_file_to_string", side_effect=dummy_read_file_to_string):
