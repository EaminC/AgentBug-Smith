def test_update_project_state_called(monkeypatch):
    # Test that update_project_state calls update_project_plan with correct args

    plan = Plan(
        project_name="dummy_project",
        project="/tmp/dummy_project",
        launch_env="dummy_env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.console = mock.Mock()
    chain.agent = mock.Mock()
    chain.chat_history = []

    # Patch update_project_plan to track calls
    import agent.function.chain as chain_module

    called = {}

    def fake_update_project_plan(path, plan_dict):
        called['called'] = True
        called['path'] = path
        called['plan_dict'] = plan_dict

    monkeypatch.setattr(chain_module, "update_project_plan", fake_update_project_plan)

    chain.project_home = "/tmp/dummy_project"
    chain.update_project_state()

    assert called.get('called') is True
    assert called.get('path') == "/tmp/dummy_project"
    assert isinstance(called.get('plan_dict'), dict)


