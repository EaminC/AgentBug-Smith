def test_extract_file_name_returns_empty_string_for_none():
    # If input is None, extract_file_name returns empty string
    result = extract_file_name(None)
    assert result == ""


def test_extract_file_name_handles_various_formats():
    # Test various formats of the output string
    outputs = [
        "File Name: example.py",
        "File Name: example.csv",
        "File Name: example.txt",
        "File Name: example",
        "File Name: example.py\nExtra text",
        "Some prefix File Name: example.py",
        "File Name:example.py",
        "File Name : example.py",
    ]
    for output in outputs:
        filename = extract_file_name(output)
        # Should return a string, possibly empty, but not None
        assert filename is not None
        # If "File Name:" present, filename should contain a dot or be non-empty
        if "File Name:" in output:
            assert isinstance(filename, str)
            # If filename is not empty, it should not contain newline
            assert "\n" not in filename


