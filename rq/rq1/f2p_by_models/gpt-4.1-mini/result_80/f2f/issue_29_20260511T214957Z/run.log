from agent.utils.system import run_command
import questionary


@pytest.fixture
def dummy_plan(tmp_path):
    # Create a dummy Plan object with minimal required fields
    return Plan(
        project_name="dummy_project",
        project=str(tmp_path),
        launch_env="dummy_env",
        current_task=1,
        lang="python",
        llm="dummy_llm",
        training_entry_file=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
