         mock.patch("questionary.text", return_value="custom_script.py"):
        filename = chain_with_agent.gen_file_name("Generate a training script")
        assert filename.endswith(".py")
        assert filename.endswith(".py") and "custom_script" in filename


def test_gen_task_content_reads_training_entry_file(tmp_path, chain_with_agent):
    # Test that gen_task_content reads from training_entry_file and returns prompt content
    # Setup a dummy training entry file with python code
    training_file = tmp_path / "train_script.py"
    training_file.write_text("print('hello world')")

    chain_with_agent.plan.training_entry_file = str(training_file)
    chain_with_agent.plan.lang = "python"
    chain_with_agent.console = mock.Mock()

    # Create a minimal valid Task with required fields
    task = Task(name="dummy", debug=False, kind="train")

    content = chain_with_agent.gen_task_content(task)
    assert content is not None
    assert "print('hello world')" in content


def test_gen_task_content_no_file_returns_none(chain_with_agent):
    # If training_entry_file does not exist, gen_task_content returns None
    chain_with_agent.plan.training_entry_file = "/non/existent/file.py"
    chain_with_agent.plan.lang = "python"
    chain_with_agent.console = mock.Mock()

    task = Task(name="dummy", debug=False, kind="train")

    content = chain_with_agent.gen_task_content(task)
    assert content is None


