                filename = chain.gen_file_name("Generate training entry")
                assert filename.endswith(".py")
                assert chain.training_entry_file is not None

            # Test gen_task_content reads from training_entry_file
            task = Task(name="dummy", debug=False, kind="train")
            content = chain.gen_task_content(task)
            assert content is not None
            assert "print" in content


def test_update_project_state_called(monkeypatch, chain_with_dummy_agent):
    chain_with_dummy_agent.plan.training_entry_file = "/tmp/train.py"
    chain_with_dummy_agent.plan.requirement = "req"
    chain_with_dummy_agent.plan.dataset = "dataset.csv"
    chain_with_dummy_agent.project_setting_file = "/tmp/project.yml"
    chain_with_dummy_agent.console = Console()

    called = {}

    def dummy_update_project_state():
        called["updated"] = True

    chain_with_dummy_agent.update_project_state = dummy_update_project_state
    chain_with_dummy_agent.user_requirement = "req"
    chain_with_dummy_agent.dataset = "dataset.csv"

    # Simulate the main loop iteration that triggers update_project_state
    # We patch questionary.text and confirm to avoid interaction
    monkeypatch.setattr(questionary, "text", lambda *a, **k: mock.Mock(ask=lambda: "somefile.py"))
    monkeypatch.setattr(questionary, "confirm", lambda *a, **k: mock.Mock(ask=lambda: True))

    # Force training_entry_file to None to trigger gen_file_name
    chain_with_dummy_agent.training_entry_file = None
    chain_with_dummy_agent.gen_file_name = lambda x: "somefile.py"

    # Run minimal part of the loop to update project state
    chain_with_dummy_agent.user_requirement = "req"
    chain_with_dummy_agent.dataset = "dataset.csv"
    chain_with_dummy_agent.plan.requirement = "req"
    chain_with_dummy_agent.plan.dataset = "dataset.csv"

    # Call update_project_state explicitly
    chain_with_dummy_agent.update_project_state()
    assert called.get("updated", False)


