        chain.training_entry_file = None
        chain.user_requirement = None
        chain.dataset = None
        chain.console = mock.Mock()
        chain.console.print = mock.Mock()
        chain.console.log = mock.Mock()

        # Patch questionary.text to provide requirement and dataset
        monkeypatch.setattr("agent.function.chain.questionary.text", lambda *a, **k: "dummy_input")
        monkeypatch.setattr("agent.function.chain.questionary.confirm", lambda *a, **k: True)

        # Patch gen_file_name to return a valid filename
        monkeypatch.setattr(chain, "gen_file_name", lambda req: str(dummy_plan.project + "/train.py"))
        # Patch update_project_state to do nothing
        monkeypatch.setattr(chain, "update_project_state", lambda: None)

        # Patch task_selector to return a dummy task name
        with mock.patch("agent.function.chain.task_selector", return_value="dummy_task_name"):
            # Run the main loop once and break by raising SystemExit after first iteration
            def run_once():
                count = 0
                original_is_running = True
                while original_is_running:
                    count += 1
                    if count > 1:
                        raise SystemExit("Test exit")
                    # Simulate the main loop body from run()
                    if chain.plan.requirement is None:
                        chain.user_requirement = "Train a model"
                        chain.plan.requirement = chain.user_requirement
                    if chain.training_entry_file is None:
                        chain.training_entry_file = chain.gen_file_name(chain.user_requirement)
                        chain.update_project_state()
                    if chain.plan.dataset is None:
                        chain.dataset = "dummy_dataset.csv"
                        chain.plan.dataset = chain.dataset
                    if chain.plan.tasks is None:
                        chain.console.log("Planning tasks...")
                        ml_task_name = "dummy_task_name"
                        chain.console.print(f"Task detected: {ml_task_name}")
                        chain.plan.tasks = [dummy_task]
                    break

            run_once()
            # After run_once, the plan should have training_entry_file, requirement, dataset, and tasks
            assert chain.plan.training_entry_file is not None
            assert chain.plan.requirement is not None
            assert chain.plan.dataset is not None
            assert chain.plan.tasks is not None and len(chain.plan.tasks) > 0


