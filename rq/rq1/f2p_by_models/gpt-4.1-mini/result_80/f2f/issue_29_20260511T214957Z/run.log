def chain_with_agent(dummy_plan):
    # Create a Chain instance with dummy plan and dummy agent
    chain = Chain.__new__(Chain)  # bypass __init__
    chain.plan = dummy_plan
    chain.project_home = dummy_plan.project
    chain.project_setting_file = os.path.join(chain.project_home, "project.yml")
    chain.console = mock.Mock()
    chain.chat_history = []
    chain.agent = None  # to be set in test
    chain.training_entry_file = None
    chain.user_requirement = None
    chain.project_name = dummy_plan.project_name
    chain.dataset = None
    return chain

def test_gen_file_name_suffix_correct(chain_with_agent):
    # This test mocks the agent.completions to return a filename with .csv (buggy) or .py (fixed)
    # We test that the returned filename ends with .py (correct suffix for python projects)
    # The test should fail on buggy code (endswith .csv) and pass on fixed code (endswith .py)

    # First test with buggy response (simulate buggy code)
    buggy_response = "File Name: training_data.csv"
    chain_with_agent.agent = DummyAgent(buggy_response)

    # Patch questionary.confirm to always return True to avoid interactive prompt
    with mock.patch("questionary.confirm", return_value=True), \
         mock.patch("questionary.text", side_effect=lambda *args, **kwargs: "training_entry.py"):

        filename = chain_with_agent.gen_file_name("Generate a training script")

        # Assert that the filename ends with .py (this will fail on buggy code)
        # This is the fail2pass assertion: fails on buggy, passes on fixed
        assert filename.endswith(".py"), f"Generated filename should end with .py but got {filename}"

def test_gen_file_name_accepts_user_input(chain_with_agent):
    # This test simulates user rejecting the generated filename and providing a new one
    buggy_response = "File Name: training_data.csv"
    chain_with_agent.agent = DummyAgent(buggy_response)

    # Patch questionary.confirm to return False (reject generated name)
    # Patch questionary.text to return a valid python filename
    with mock.patch("questionary.confirm", return_value=False), \
         mock.patch("questionary.text", return_value="custom_script.py"):

        filename = chain_with_agent.gen_file_name("Generate a training script")

        # The filename should be the user provided one
        assert filename.endswith(".py"), f"User provided filename should end with .py but got {filename}"
        assert "custom_script.py" in filename

