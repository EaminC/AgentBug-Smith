[32mimport os
import builtins
import pytest
from unittest import mock

from agent.function.chain import Chain
from agent.prompt.base import pmpt_chain_filename
from agent.types.step import Plan
from agent.function.chain import extract_file_name


def test_extract_file_name_parsing():
    # The function extract_file_name should parse the file name from the prompt output correctly.
    # It should handle the format "File Name: filename.py" and extract "filename.py"
    content = "File Name: train_model.py"
    filename = extract_file_name(content)
    assert filename == "train_model.py"

    # Test with extra whitespace
    content = "File Name:   data_processing.py  "
    filename = extract_file_name(content)
    assert filename == "data_processing.py"

    # Test with no "File Name:" prefix returns None or empty string
    content = "train_model.py"
    filename = extract_file_name(content)
    assert filename is None or filename == ""

    # Test with multiple lines, file name on second line
    content = "Some text\nFile Name: pipeline.py\nMore text"
    filename = extract_file_name(content)
    assert filename == "pipeline.py"


def test_generated_file_name_is_not_csv(monkeypatch):
    # This test ensures that the generated file name is never a .csv file,
    # which was the bug reported (sometimes .csv was generated incorrectly).

    # Setup a dummy Plan and Chain instance
    plan = Plan(
        project_name="dummy_project",
        project="/tmp/dummy_project",
        launch_env="dummy_env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan

    # Mock console and agent completions to simulate the file name generation
    chain.console = mock.Mock()
    # Provide a context manager mock for console.status
    class DummyStatusCM:
        def __enter__(self):
            return chain.console
        def __exit__(self, exc_type, exc_val, exc_tb):
            return False
    chain.console.status = mock.Mock(return_value=DummyStatusCM())

    # Mock agent with completions method returning a .csv file name (buggy behavior)
    class DummyChoice:
        def __init__(self, content):
            self.message = mock.Mock()
            self.message.content = content

    class DummyCompletion:
        def __init__(self, content):
            self.choices = [DummyChoice(content)]

    class DummyAgent:
        def completions(self, chat_history, stream=False):
            # Return a .csv file name to simulate buggy output
            return DummyCompletion("File Name: data.csv")

    chain.agent = DummyAgent()
    chain.chat_history = []

    # Patch questionary.confirm to always confirm True
    monkeypatch.setattr("questionary.confirm", lambda *args, **kwargs: True)
    # Patch questionary.text to provide a fallback filename if asked
    monkeypatch.setattr("questionary.text", lambda *args, **kwargs: "train.py")

    # Call gen_file_name and check that the returned file name is NOT .csv
    filename = chain.gen_file_name("Train a model")
    # The bug is that .csv is returned; the fix ensures the file is not .csv
    # So the test expects the filename to NOT end with .csv
    assert not filename.endswith(".csv"), "Generated file name should not be .csv"

    # Also check that the plan.training_entry_file is updated accordingly
    assert chain.plan.training_entry_file == filename


def test_training_entry_file_attribute_usage(tmp_path):
    # This test verifies that the Chain uses training_entry_file attribute consistently
    # instead of the old target attribute.

    # Create a dummy training file
    training_file = tmp_path / "train_script.py"
    training_file.write_text("print('Hello World')")

    plan = Plan(
        project_name="dummy_project",
        project=str(tmp_path),
        launch_env="dummy_env",
        current_task=1,
        lang="python",
        llm="dummy",
        training_entry_file=str(training_file),
        debug_env=None,
        requirement="Train a model",
        dataset="dataset.csv",
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.console = mock.Mock()

    # Provide a context manager mock for console.status
    class DummyStatusCM:
        def __enter__(self):
            return chain.console
        def __exit__(self, exc_type, exc_val, exc_tb):
            return False
    chain.console.status = mock.Mock(return_value=DummyStatusCM())

    # Patch read_file_to_string to read the training_entry_file content
    from agent.function.chain import read_file_to_string

    # Use real read_file_to_string, but file exists so it should read correctly
    content = read_file_to_string(str(training_file))
    assert "Hello World" in content

    # Patch agent.completions to return a dummy response
    class DummyChoice:
        def __init__(self, content):
            self.message = mock.Mock()
            self.message.content = content

    class DummyCompletion:
        def __init__(self, content):
            self.choices = [DummyChoice(content)]

    class DummyAgent:
        def completions(self, chat_history, stream=False):
            return DummyCompletion("File Name: train_script.py")

    chain.agent = DummyAgent()
    chain.chat_history = []

    # Call gen_task_content which uses training_entry_file internally
    from agent.types.step import Task
    task = Task(name="dummy_task", debug=False)
    content = chain.gen_task_content(task)
    assert content is not None
    assert "print('Hello World')" in content


