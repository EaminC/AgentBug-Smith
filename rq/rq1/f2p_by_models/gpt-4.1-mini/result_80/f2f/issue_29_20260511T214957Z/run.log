[32mimport os
import re
import builtins
import pytest
from unittest import mock

from agent.function.chain import Chain
from agent.types.step import Plan, Task
from agent.utils.system import extract_file_name, read_file_to_string

# We will mock the agent attribute inside Chain to simulate completions returning a file name.
# Also mock questionary to simulate user interaction.

# Helper dummy classes and functions

class DummyCompletionChoice:
    def __init__(self, content):
        self.message = type("Message", (), {"content": content})

class DummyCompletion:
    def __init__(self, content):
        self.choices = [DummyCompletionChoice(content)]

class DummyAgent:
    def __init__(self, response_content):
        self.response_content = response_content
        self.called_with = None

    def completions(self, chat_history, stream=False):
        self.called_with = (chat_history, stream)
        return DummyCompletion(self.response_content)

def dummy_read_file_to_string(path):
    # Return a fixed string if path matches expected training entry file
    if path and path.endswith("train.py"):
        return "print('hello world')"
    return None

@pytest.fixture
def dummy_plan(tmp_path):
    # Create a dummy Plan object with required attributes
    return Plan(
        project_name="dummy_project",
        project=str(tmp_path),
        launch_env="dummy_env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )

@pytest.fixture
def chain_with_dummy_agent(dummy_plan):
    chain = Chain.__new__(Chain)  # bypass __init__
    chain.plan = dummy_plan
    chain.project_home = dummy_plan.project
    chain.project_setting_file = os.path.join(chain.project_home, "project.yml")
    chain.console = mock.Mock()
    chain.agent = DummyAgent("File Name: train.py")
    chain.chat_history = []
    chain.user_requirement = None
    chain.dataset = None
    chain.training_entry_file = None
    return chain

def test_extract_file_name_parsing():
    # Valid file name extraction
    assert extract_file_name("File Name: example.py") == "example.py"
    assert extract_file_name("File Name: example") == "example"
    # No match returns empty string (not None)
    assert extract_file_name("Random text") == ""
    # None input returns empty string
    assert extract_file_name(None) == ""
    # Empty string returns empty string
    assert extract_file_name("") == ""

def test_gen_file_name_sets_chat_history(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    # Patch questionary.confirm to always return True
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: True)
    # Patch questionary.text to return None (no rename)
    monkeypatch.setattr("questionary.text", lambda *a, **k: None)
    # Patch Chain.agent.completions to return a file name with .py suffix
    chain.agent = DummyAgent("File Name: train.py")

    filename = chain.gen_file_name("some requirement")
    assert filename.endswith(".py")
    assert chain.training_entry_file.endswith("train.py")
    # chat_history should be cleared
    assert chain.chat_history == []

def test_gen_file_name_accepts_user_input(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: False)
    monkeypatch.setattr("questionary.text", lambda *a, **k: "custom_train.py")
    chain.agent = DummyAgent("File Name: train.py")

    filename = chain.gen_file_name("req")
    assert filename.endswith("custom_train.py")
    assert chain.training_entry_file.endswith("custom_train.py")

def test_gen_task_content_reads_training_entry_file(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    # Setup training_entry_file to a dummy path
    chain.plan.training_entry_file = os.path.join(chain.plan.project, "train.py")
    chain.training_entry_file = chain.plan.training_entry_file
    chain.plan.lang = "python"

    # Patch read_file_to_string to return some code
    monkeypatch.setattr("agent.utils.system.read_file_to_string", dummy_read_file_to_string)

    task = Task(name="dummy", description="desc")
    content = chain.gen_task_content(task)
    assert isinstance(content, str)
    assert "print" in content

def test_gen_task_content_no_file_returns_none(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    chain.plan.training_entry_file = None
    chain.training_entry_file = None
    chain.plan.lang = "python"
    monkeypatch.setattr("agent.utils.system.read_file_to_string", lambda x: None)

    task = Task(name="dummy", description="desc")
    content = chain.gen_task_content(task)
    assert content is None

def test_training_entry_file_attribute_usage(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    # Initially None
    assert chain.training_entry_file is None
    # Simulate gen_file_name sets it
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: True)
    monkeypatch.setattr("questionary.text", lambda *a, **k: None)
    chain.agent = DummyAgent("File Name: train.py")
    filename = chain.gen_file_name("req")
    assert chain.training_entry_file == filename
    # The plan attribute should also be updated
    assert chain.plan.training_entry_file == filename

def test_update_project_state_called(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    chain.console.print = mock.Mock()
    chain.update_project_state = mock.Mock()
    # Simulate user requirement and dataset set
    chain.plan.requirement = "req"
    chain.user_requirement = "req"
    chain.plan.dataset = "dataset.csv"
    chain.dataset = "dataset.csv"
    # Simulate training_entry_file set
    chain.training_entry_file = "train.py"
    chain.plan.training_entry_file = "train.py"

    # Patch questionary to avoid interactive calls
    monkeypatch.setattr("questionary.text", lambda *a, **k: "dataset.csv")
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: True)

    # We simulate the main loop to run one iteration and then break
    # We'll call gen_file_name to set the file name
    chain.gen_file_name = mock.Mock(return_value="train.py")

    # We patch run_command to avoid actual execution
    monkeypatch.setattr("agent.function.chain.run_command", lambda cmd: ("", 0))

    # We patch task_selector to return a dummy task name
    monkeypatch.setattr("agent.function.chain.task_selector", lambda req, agent: "dummy_task")

    # We patch Chain.gen_task_content to return some content
    monkeypatch.setattr("agent.function.chain.Chain.gen_task_content", lambda self, task, params=None: "print('hello')")

    # Patch questionary.confirm for plan confirmation
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: True)

    # Setup plan tasks to None to trigger planning
    chain.plan.tasks = None

    # Run the main loop once by patching is_running to False after first iteration
    # We'll patch the while loop by patching Chain.update_project_state to raise SystemExit after call
    def update_project_state_side_effect():
        raise SystemExit("Stop after update_project_state")

    chain.update_project_state.side_effect = update_project_state_side_effect

    with pytest.raises(SystemExit):
        chain.__class__.main = lambda self: None  # dummy main to avoid recursion
        # We call the method that contains the loop: run_chain or similar
        # The code does not expose a single run method, so we simulate the loop by calling gen_file_name and update_project_state
        # Instead, we test that update_project_state is called when requirement and dataset are set
        chain.update_project_state()

def test_gen_file_name_reject_and_accept(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    # Simulate user rejects initial file name and provides a new one
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: False)
    monkeypatch.setattr("questionary.text", lambda *a, **k: "new_train.py")
    chain.agent = DummyAgent("File Name: train.py")

    filename = chain.gen_file_name("req")
    assert filename.endswith("new_train.py")
    assert chain.training_entry_file.endswith("new_train.py")

def test_extract_file_name_returns_empty_string_for_none():
    # Defensive test: extract_file_name should not raise on None
    result = extract_file_name(None)
    assert result == ""

def test_extract_file_name_empty_string_returns_empty_string():
    result = extract_file_name("")
    assert result == ""

def test_extract_file_name_none_input_returns_empty_string():
    result = extract_file_name(None)
    assert result == ""

def test_extract_file_name_handles_various_formats():
    assert extract_file_name("File Name: example.py") == "example.py"
    assert extract_file_name("File Name: example") == "example"
    assert extract_file_name("Random text") == ""

# Additional test to ensure that the file name generated is never .csv (the bug)
def test_generated_file_name_is_not_csv(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    # Simulate the agent returning a .csv file name (buggy behavior)
    chain.agent = DummyAgent("File Name: data.csv")
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: True)
    monkeypatch.setattr("questionary.text", lambda *a, **k: None)

    filename = chain.gen_file_name("some requirement")
    # The fix should ensure that the file name is not .csv, so this test expects the filename to NOT end with .csv
    # On buggy codebase this will fail (filename ends with .csv)
    # On fixed codebase it should pass (filename ends with .py or other correct suffix)
    assert not filename.endswith(".csv"), "Generated file name should not have .csv suffix"

# Test that Chain.gen_task_content reads from training_entry_file attribute, not target
def test_gen_task_content_reads_correct_attribute(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    chain.plan.training_entry_file = os.path.join(chain.plan.project, "train.py")
    chain.training_entry_file = chain.plan.training_entry_file
    chain.plan.lang = "python"
