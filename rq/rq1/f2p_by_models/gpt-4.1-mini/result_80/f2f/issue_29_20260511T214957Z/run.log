def test_update_project_state_called(monkeypatch):
    plan = Plan(
        project_name="dummy_project",
        project="/tmp",
        launch_env="dummy_env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file="/tmp/train.py",
        debug_env=None,
        requirement="req",
        dataset="dataset_path",
        tasks=None,
        description=None,
    )
    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.console = DummyConsole()
    chain.chat_history = []
    chain.agent = DummyAgent("File Name: train.py")
    chain.user_requirement = "req"
    chain.project_home = plan.project
    chain.project_setting_file = os.path.join(chain.project_home, "project.yml")
    chain.training_entry_file = plan.training_entry_file
    chain.dataset = plan.dataset
    chain.project_name = plan.project_name

    called = {}

    def dummy_update_project_state():
        called["updated"] = True

    chain.update_project_state = dummy_update_project_state

    # Patch console.status to DummyStatusContext
    chain.console.status = lambda msg: DummyStatusContext()

    # Patch questionary.confirm to always return True
    monkeypatch.setattr(questionary, "confirm", lambda *a, **k: mock.Mock(ask=lambda: True))

    filename = chain.gen_file_name("some requirement")
    assert called.get("updated") is None  # update_project_state not called by gen_file_name

    # Call update_project_state explicitly and check
    chain.update_project_state()
    assert called.get("updated") is True


