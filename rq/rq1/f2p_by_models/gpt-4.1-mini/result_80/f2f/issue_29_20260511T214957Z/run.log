def test_extract_file_name_parsing():
    # Test that extract_file_name extracts filename correctly from various strings
    valid_output = "File Name: training_script.py"
    filename = extract_file_name(valid_output)
    assert filename.endswith(".py")
    assert "training_script" in filename

    invalid_output = "No file name here"
    filename = extract_file_name(invalid_output)
    assert filename == ""

    csv_output = "File Name: data.csv"
    filename = extract_file_name(csv_output)
    # Should accept .csv as valid filename (but bug was about sometimes generating .csv)
    assert filename.endswith(".csv")


