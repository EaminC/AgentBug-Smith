    chain.user_requirement = "req"
    chain.training_entry_file = None
    chain.dataset = None
    chain.plan.requirement = "req"
    chain.plan.dataset = None

    # Patch gen_file_name to return a filename
    chain.gen_file_name = lambda x: "/tmp/filename.py"

    # Patch console.print to do nothing
    chain.console.print = lambda *a, **k: None

    # Patch plan.tasks to simulate no tasks so planning triggers
    chain.plan.tasks = None

    # Patch task_selector to return a dummy task name
    from agent.function.chain import task_selector

    monkeypatch.setattr("agent.function.chain.task_selector", lambda req, agent: "dummy_task")

    # Patch questionary.text to simulate dataset input
    monkeypatch.setattr("questionary.text", lambda *a, **k: "dataset")

    # Patch questionary.confirm for plan confirmation
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: ConfirmMock())

    # Call the main loop method (run_chain) with a dummy task
    # The method is not exposed, so we test update_project_state indirectly
    # Instead, call gen_file_name and check update_project_state is called after setting training_entry_file
    chain.training_entry_file = None
    chain.user_requirement = "req"
    chain.gen_file_name("req")
    chain.update_project_state()
    assert called.get("yes") is True


