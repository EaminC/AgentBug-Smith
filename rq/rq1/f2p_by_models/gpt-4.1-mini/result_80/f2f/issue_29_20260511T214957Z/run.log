[32mimport os
import re
import pytest
from unittest import mock

from agent.function.chain import Chain
from agent.types.step import Plan, Task
from agent.utils.system import extract_file_name


# We must mock the internal LLM call to avoid real network calls.
# The Chain class requires a llm_agent argument, which must have a completions method.
class DummyLLMAgent:
    def __init__(self):
        self.completions_called_with = None

    def completions(self, chat_history, stream=False):
        self.completions_called_with = (chat_history, stream)
        # Return a dummy response with a valid file name in the expected format.
        class DummyChoice:
            def __init__(self, content):
                self.message = type("Message", (), {"content": content})

        class DummyCompletion:
            def __init__(self, choices):
                self.choices = choices

        # Provide a file name with .py suffix, never .csv
        return DummyCompletion([DummyChoice("File Name: train.py")])


@pytest.fixture
def dummy_plan(tmp_path):
    # Provide minimal required fields for Plan
    return Plan(
        project_name="dummy_project",
        project=str(tmp_path / "dummy_project"),
        launch_env="dummy_env",
        current_task=1,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )


@pytest.fixture
def chain_with_dummy_agent(dummy_plan):
    agent = DummyLLMAgent()
    chain = Chain(dummy_plan, agent)
    return chain


def test_extract_file_name_parsing():
    # Normal case
    content = "File Name: train.py"
    filename = extract_file_name(content)
    assert filename == "train.py"

    # Case with extra spaces and newlines
    content = "\nFile Name:   example.py  \n"
    filename = extract_file_name(content)
    assert filename == "example.py"


def test_extract_file_name_returns_empty_string_for_none():
    # Should not raise, should return empty string
    assert extract_file_name(None) == ""


def test_extract_file_name_empty_string_returns_empty_string():
    assert extract_file_name("") == ""


def test_extract_file_name_none_input_returns_empty_string():
    assert extract_file_name(None) == ""


def test_generated_file_name_is_not_csv(chain_with_dummy_agent):
    # The dummy agent returns "File Name: train.py"
    # The generated file name should never be .csv
    filename = chain_with_dummy_agent.gen_file_name("some requirement")
    assert filename.endswith(".py")
    assert not filename.endswith(".csv")


def test_gen_file_name_sets_chat_history(chain_with_dummy_agent):
    # The chat_history should be cleared after gen_file_name
    chain_with_dummy_agent.chat_history = ["old history"]
    filename = chain_with_dummy_agent.gen_file_name("some requirement")
    assert chain_with_dummy_agent.chat_history == []
    assert filename.endswith(".py")


def test_gen_file_name_accepts_user_input(monkeypatch, chain_with_dummy_agent):
    # Simulate user confirming the generated file name
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: True)
    filename = chain_with_dummy_agent.gen_file_name("some requirement")
    assert filename.endswith(".py")


def test_gen_file_name_user_cancels(monkeypatch, chain_with_dummy_agent):
    # Simulate user rejecting the generated file name and providing a new one
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: False)
    monkeypatch.setattr("questionary.text", lambda *a, **k: "custom_name.py")
    filename = chain_with_dummy_agent.gen_file_name("some requirement")
    assert filename.endswith(".py")
    assert "custom_name.py" in filename


def test_gen_file_name_no_name_raises(monkeypatch, chain_with_dummy_agent):
    # Simulate user rejecting and providing no new name (None)
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: False)
    monkeypatch.setattr("questionary.text", lambda *a, **k: None)
    filename = chain_with_dummy_agent.gen_file_name("some requirement")
    # Should return the original generated name because no new name was given
    assert filename.endswith(".py")


def test_gen_file_name_malformed_completion(monkeypatch, chain_with_dummy_agent):
    # Patch the agent.completions to return malformed content
    def bad_completions(chat_history, stream=False):
        class DummyChoice:
            def __init__(self, content):
                self.message = type("Message", (), {"content": content})

        class DummyCompletion:
            def __init__(self, choices):
                self.choices = choices

        return DummyCompletion([DummyChoice("No file name here")])

    chain_with_dummy_agent.agent.completions = bad_completions
    filename = chain_with_dummy_agent.gen_file_name("some requirement")
    # The extract_file_name should return empty string if no match
    assert filename == "" or filename is None


def test_gen_task_content_reads_training_entry_file(tmp_path, chain_with_dummy_agent):
    # Create a dummy training entry file with some content
    file_path = tmp_path / "train.py"
    file_path.write_text("print('hello world')")

    # Set the plan's training_entry_file to the dummy file path
    chain_with_dummy_agent.plan.training_entry_file = str(file_path)

    # Create a dummy task
    task = Task(name="dummy", debug=False)

    content = chain_with_dummy_agent.gen_task_content(task)
    assert content is not None
    assert "print('hello world')" in content


def test_gen_task_content_no_file_returns_none(chain_with_dummy_agent):
    # Set training_entry_file to a non-existent file
    chain_with_dummy_agent.plan.training_entry_file = "/non/existent/file.py"
    task = Task(name="dummy", debug=False)
    content = chain_with_dummy_agent.gen_task_content(task)
    assert content is None


def test_training_entry_file_attribute_usage(chain_with_dummy_agent):
    # The Chain should use training_entry_file attribute consistently
    chain_with_dummy_agent.plan.training_entry_file = "/tmp/dummy.py"
    assert chain_with_dummy_agent.plan.training_entry_file == "/tmp/dummy.py"


def test_update_project_state_called(monkeypatch, chain_with_dummy_agent):
    # Patch update_project_state to track calls
    called = {}

    def fake_update():
        called["called"] = True

    chain_with_dummy_agent.update_project_state = fake_update
    # Trigger code path that calls update_project_state
    chain_with_dummy_agent.plan.training_entry_file = None
    chain_with_dummy_agent.user_requirement = "req"
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: True)
    monkeypatch.setattr("questionary.text", lambda *a, **k: "train.py")
    # forcibly call gen_file_name to set training_entry_file
    chain_with_dummy_agent.gen_file_name("req")
    # Call update_project_state explicitly
    chain_with_dummy_agent.update_project_state()
    assert called.get("called", False)


def test_gen_file_name_reject_and_accept(monkeypatch, chain_with_dummy_agent):
