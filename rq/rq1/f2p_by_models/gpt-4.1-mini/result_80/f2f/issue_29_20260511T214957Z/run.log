    chain.chat_history = []

    class DummyChoice:
        def __init__(self, content):
            self.message = mock.Mock()
            self.message.content = content

    class DummyCompletion:
        def __init__(self, content):
            self.choices = [DummyChoice(content)]

    chain.agent.completions.return_value = DummyCompletion("File Name: main.py")

    # User rejects generated name first (confirm returns False), then provides new name
    monkeypatch.setattr("questionary.confirm", lambda *args, **kwargs: False)
