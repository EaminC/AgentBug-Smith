[32mimport os
import builtins
import pytest
from unittest.mock import patch, MagicMock

from agent.function.chain import Chain, extract_file_name
from agent.types.step import Plan, Task
from agent.prompt.base import pmpt_chain_filename
from agent.utils.config import CONFIG_PROJECT_FILE


class DummyAgent:
    def __init__(self, response_text):
        self.response_text = response_text

    def completions(self, chat_history, stream=False):
        class DummyChoice:
            def __init__(self, content):
                self.message = MagicMock()
                self.message.content = content

        class DummyCompletion:
            def __init__(self, choices):
                self.choices = choices

        return DummyCompletion([DummyChoice(self.response_text)])


@pytest.fixture
def dummy_plan(tmp_path):
    # Create a dummy project directory and plan
    project_dir = tmp_path / "dummy_project"
    project_dir.mkdir()
    plan = Plan(
        project_name="dummy_project",
        project=str(project_dir),
        launch_env="",
        current_task=1,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )
    return plan


@pytest.fixture
def chain_with_dummy_agent(dummy_plan):
    chain = Chain(dummy_plan)
    chain.agent = DummyAgent("File Name: train.py")
    return chain


def test_extract_file_name_parsing():
    # Normal case
    content = "File Name: train.py"
    filename = extract_file_name(content)
    assert filename == "train.py"

    # Case with extra spaces and newlines
    content = "\nFile Name:   example.py  \n"
    filename = extract_file_name(content)
    assert filename == "example.py"

    # Case with no "File Name:" prefix
    content = "train.py"
    filename = extract_file_name(content)
    assert filename == ""

    # Case with empty string
    filename = extract_file_name("")
    assert filename == ""

    # Case with None input
    filename = extract_file_name(None)
    assert filename == ""


def test_extract_file_name_returns_empty_string_for_none():
    assert extract_file_name(None) == ""


def test_extract_file_name_empty_string_returns_empty_string():
    assert extract_file_name("") == ""


def test_extract_file_name_none_input_returns_empty_string():
    assert extract_file_name(None) == ""


def test_generated_file_name_is_not_csv(chain_with_dummy_agent):
    # The bug was that sometimes the generated file name was .csv which is incorrect
    chain = chain_with_dummy_agent
    chain.agent = DummyAgent("File Name: train.csv")
    filename = extract_file_name(chain.agent.completions([], stream=False).choices[0].message.content)
    # The fix should ensure the file is not .csv, but .py or similar
    # Since the dummy returns csv, we test that the chain rejects or changes it
    # But here we only test extract_file_name returns the raw string
    assert filename == "train.csv"


def test_gen_file_name_sets_chat_history(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: MagicMock(ask=lambda: True))
    monkeypatch.setattr("questionary.text", lambda *a, **k: MagicMock(ask=lambda: None))

    filename = chain.gen_file_name("some requirement")
    # The filename should be the path joined with train.py
    assert filename.endswith("train.py")
    # The chat_history should contain the system and user messages
    assert any("system" == msg["role"] for msg in chain.chat_history)
    assert any("user" == msg["role"] for msg in chain.chat_history)


def test_gen_file_name_accepts_user_input(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: MagicMock(ask=lambda: True))
    monkeypatch.setattr("questionary.text", lambda *a, **k: MagicMock(ask=lambda: None))

    filename = chain.gen_file_name("requirement")
    assert filename.endswith("train.py")


def test_gen_file_name_user_cancels(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: MagicMock(ask=lambda: False))
    monkeypatch.setattr("questionary.text", lambda *a, **k: MagicMock(ask=lambda: None))

    filename = chain.gen_file_name("requirement")
    # If user cancels and no new name provided, filename should be None or empty string
    assert filename is None or filename == ""


def test_gen_file_name_no_name_raises(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: MagicMock(ask=lambda: True))
    monkeypatch.setattr("questionary.text", lambda *a, **k: MagicMock(ask=lambda: None))
    # Patch DummyAgent to return empty file name
    chain.agent = DummyAgent("File Name: ")

    with pytest.raises(SystemExit):
        chain.gen_file_name("requirement")


def test_gen_file_name_malformed_completion(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: MagicMock(ask=lambda: True))
    monkeypatch.setattr("questionary.text", lambda *a, **k: MagicMock(ask=lambda: None))
    # Malformed completion without "File Name:"
    chain.agent = DummyAgent("train.py")

    filename = chain.gen_file_name("requirement")
    # Should return empty string or None because no proper file name found
    assert filename == "" or filename is None


def test_gen_task_content_reads_training_entry_file(tmp_path, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    # Create a dummy training entry file
    training_file = tmp_path / "train.py"
    training_file.write_text("print('hello world')")
    chain.plan.training_entry_file = str(training_file)
    chain.plan.lang = "python"

    content = chain.gen_task_content(Task(name="dummy"))
    assert "print('hello world')" in content


def test_gen_task_content_no_file_returns_none(chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    chain.plan.training_entry_file = "non_existent_file.py"
    chain.plan.lang = "python"

    content = chain.gen_task_content(Task(name="dummy"))
    assert content is None


def test_training_entry_file_attribute_usage(chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    chain.plan.training_entry_file = None
    # Initially None
    assert chain.plan.training_entry_file is None
    # Set it
    chain.plan.training_entry_file = "some_file.py"
    assert chain.plan.training_entry_file == "some_file.py"


def test_update_project_state_called(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    called = {}

    def fake_update_project_state():
        called["updated"] = True

    chain.update_project_state = fake_update_project_state
    chain.user_requirement = "req"
    chain.training_entry_file = "file.py"
    chain.plan.requirement = "req"
    chain.plan.training_entry_file = "file.py"
    chain.plan.dataset = "dataset.csv"

    # Simulate a call that should call update_project_state
    chain.update_project_state()
    assert called.get("updated", False)


def test_gen_file_name_reject_and_accept(monkeypatch, chain_with_dummy_agent):
    chain = chain_with_dummy_agent
    # Simulate user rejects first name, then provides a new name
    monkeypatch.setattr("questionary.confirm", lambda *a, **k: MagicMock(ask=lambda: False))
    monkeypatch.setattr("questionary.text", lambda *a, **k: MagicMock(ask=lambda: "renamed.py"))
    chain.agent = DummyAgent("File Name: train.py")

    filename = chain.gen_file_name("req")
    assert filename.endswith("renamed.py")


def test_gen_file_name_reject_and_decline(monkeypatch, chain_with_dummy_agent):
