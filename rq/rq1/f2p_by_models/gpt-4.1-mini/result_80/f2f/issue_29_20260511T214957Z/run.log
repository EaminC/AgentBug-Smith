def test_gen_file_name_reject_and_accept(monkeypatch):
    # Test gen_file_name with user rejecting generated name and providing new name
    plan = Plan(
        project_name="dummy_project",
        project="/tmp",
        launch_env="dummy_env",
        current_task=0,
        lang="python",
        llm="dummy",
        training_entry_file=None,
        debug_env=None,
        requirement=None,
        dataset=None,
        tasks=None,
        description=None,
    )

    class DummyChoice:
        def __init__(self, content):
            self.message = mock.Mock()
            self.message.content = content

    class DummyCompletion:
        def __init__(self, content):
            self.choices = [DummyChoice(content)]

    class DummyAgent:
        def completions(self, chat_history, stream=False):
            return DummyCompletion("File Name: train.py")

    chain = Chain.__new__(Chain)
    chain.plan = plan
    chain.agent = DummyAgent()
    chain.chat_history = []
    chain.console = mock.Mock()
    chain.console.print = mock.Mock()
    chain.console.status = mock.Mock()
    chain.project_setting_file = os.path.join(plan.project, "project.yml")
    chain.training_entry_file = None
    chain.plan.training_entry_file = None
    chain.plan.path = plan.project

    # Patch questionary.confirm to return False first (reject), then True (accept new)
    confirms = iter([False])
    monkeypatch.setattr("questionary.confirm", lambda *args, **kwargs: next(confirms, True))

    # Patch questionary.text to simulate user input for new file name
    monkeypatch.setattr("questionary.text", lambda *args, **kwargs: "new_train.py")

    filename = chain.gen_file_name("some requirement")

    assert filename.endswith(".py")
    assert filename.endswith(".py")
    assert filename == os.path.join(plan.project, "new_train.py")
    assert chain.training_entry_file == filename
    assert chain.plan.training_entry_file == filename


