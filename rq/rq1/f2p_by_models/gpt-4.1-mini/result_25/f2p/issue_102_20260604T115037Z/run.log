[32mimport importlib
import sys
import pytest

def test_agentscope_web_studio_import():
    """
    Test that the agentscope.web.studio package can be imported without ImportError.
    This fails if __init__.py is missing in agentscope.web.studio.
    """
    # Remove from sys.modules if already imported to force re-import
    module_name = "agentscope.web.studio"
    if module_name in sys.modules:
        del sys.modules[module_name]

    # Attempt import
    module = importlib.import_module(module_name)

    # Assert the imported module has __path__ attribute (indicating it's a package)
    assert hasattr(module, "__path__"), "agentscope.web.studio should be a package with __path__ attribute"

    # Also check that the module is not empty (should have at least one attribute)
    assert len(dir(module)) > 0, "agentscope.web.studio package should not be empty"[0m
