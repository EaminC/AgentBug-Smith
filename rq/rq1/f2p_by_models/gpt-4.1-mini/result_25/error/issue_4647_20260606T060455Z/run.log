async def test_gemini_completion_process_stream_chunk_text_property_warning(monkeypatch):
    """
    Test that _process_stream_chunk does not rely on chunk.text property when non-text parts exist,
    avoiding the warning and discarding of thought content.

    This test simulates a chunk with non-text parts and verifies that thought parts are emitted
    and chunk.text is not used directly.
    """

    model_name = "gemini/gemini-3.1-pro-preview"
    client = GeminiCompletion(model=model_name)

    # Create dummy parts with a function_call and thought part
    class DummyPart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates=None):
            self.candidates = candidates or []

        @property
        def text(self):
            # Simulate that accessing .text triggers warning and returns None
            return None

    thought_text = "Reasoning step 1."
    function_call_text = "Function call data."

    parts = [
        DummyPart(text=function_call_text, function_call=True),
        DummyPart(text=thought_text, thought=True),
    ]
    content = DummyContent(parts=parts)
    candidate = DummyCandidate(content=content)
    chunk = DummyChunk(candidates=[candidate])

    emitted_thought_chunks = []
    emitted_function_call_chunks = []

    def fake_emit_thinking_chunk_event(self, chunk_str, **kwargs):
        emitted_thought_chunks.append(chunk_str)

    def fake_emit_stream_chunk_event(self, chunk_str, **kwargs):
        emitted_function_call_chunks.append(chunk_str)

    monkeypatch.setattr(GeminiCompletion, "_emit_thinking_chunk_event", fake_emit_thinking_chunk_event)
    monkeypatch.setattr(GeminiCompletion, "_emit_stream_chunk_event", fake_emit_stream_chunk_event)

    full_response, function_calls, usage_data = client._process_stream_chunk(chunk, "", [], {})

    # The thought_text should be emitted as a thinking chunk event
    assert thought_text in emitted_thought_chunks, "Thought content was not emitted"

    # The function_call_text should be emitted as a stream chunk event
    assert function_call_text in emitted_function_call_chunks, "Function call content was not emitted"

    # full_response should be empty because chunk.text is None and no normal text parts
    assert full_response == "", "full_response should be empty when no normal text parts"

    # function_calls and usage_data should be empty or default
    assert isinstance(function_calls, list)
    assert isinstance(usage_data, dict)[0m
