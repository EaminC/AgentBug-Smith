    def fake_emit(self, event):
        emitted_events.append(event)

    # Patch the event bus emit method in GeminiCompletion instance
    monkeypatch.setattr(gemini_completion.crewai_event_bus, "emit", fake_emit)

    # Instantiate GeminiCompletion with a thinking model version >= 2.5 to trigger thinking_config
    # We pass thinking_config=None to test auto-setting include_thoughts=True
    gemini = gemini_completion.GeminiCompletion(model="gemini/gemini-3.1-pro-preview", thinking_config=None)

    # Build a dummy chunk with a thought part and a normal text part
    thought_text = "This is a thought part."
    normal_text = "This is a normal text part."

    parts = [
        DummyPart(text=thought_text, thought=True),
        DummyPart(text=normal_text, thought=False),
    ]
    candidate_content = DummyCandidateContent(parts=parts)
    candidate = DummyCandidate(content=candidate_content)
    chunk = DummyChunk(candidates=[candidate])

    # We call the real _process_stream_chunk method with our dummy chunk
    # It should emit both stream chunk events and thinking chunk events
    full_response = ""
    function_calls = []
    usage_data = None

    # Run the method (sync) - it returns updated full_response etc.
    full_response, function_calls, usage_data = gemini._process_stream_chunk(
        chunk=chunk,
        full_response=full_response,
        function_calls=function_calls,
        usage_data=usage_data,
        from_task=None,
        from_agent=None,
    )

    # Assertions:

    # The full_response should include the normal text part but NOT the thought part
    assert normal_text in full_response
    assert thought_text not in full_response

    # The emitted events should include at least one LLMThinkingChunkEvent with the thought text
    found_thought_event = any(
        getattr(event, "type", None) == "llm_thinking_chunk" and getattr(event, "chunk", None) == thought_text
        for event in emitted_events
    )
    assert found_thought_event, "Thought chunk event was not emitted"

    # The emitted events should also include a stream chunk event with the normal text
    found_stream_event = any(
        getattr(event, "type", None) == "llm_stream_chunk" and getattr(event, "chunk", None) == normal_text
        for event in emitted_events
    )
    assert found_stream_event, "Stream chunk event for normal text was not emitted"

    # There should be no warnings or errors raised (implicit by test success)


@pytest.mark.asyncio
async def test_prepare_generation_config_sets_thinking_config():
    """
    Test that _prepare_generation_config sets thinking_config when model version >= 2.5
    and that include_thoughts=True is set.
    """

    # Instantiate GeminiCompletion with model version 2.5+ and no explicit thinking_config
    gemini = gemini_completion.GeminiCompletion(model="gemini/gemini-2.5-pro", thinking_config=None)

    # Call _prepare_generation_config and check that thinking_config is set with include_thoughts=True
    config = gemini._prepare_generation_config()

    assert config.thinking_config is not None, "thinking_config should be set for model >= 2.5"
    assert getattr(config.thinking_config, "include_thoughts", False) is True, "include_thoughts should be True"


