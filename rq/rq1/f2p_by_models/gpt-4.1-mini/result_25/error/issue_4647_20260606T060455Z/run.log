[32mimport pytest
import asyncio

from crewai.llms.providers.gemini import completion
from crewai.llms.providers.gemini import types as gemini_types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_in_stream(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model returns thought content in streaming mode.

    This test verifies that thought parts are included in the streamed output and
    that the thought event is emitted. On the buggy codebase, thought content is discarded
    and no thought events are emitted, causing this test to fail.

    After applying the fix, thought content should be surfaced and the test should pass.
    """

    # Prepare a fake streaming chunk with thought parts and normal text parts
    class FakePart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class FakeCandidateContent:
        def __init__(self, parts):
            self.parts = parts

    class FakeCandidate:
        def __init__(self, content):
            self.content = content

    class FakeChunk:
        def __init__(self, candidates=None, usage_metadata=None):
            self.candidates = candidates or []
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # This property triggers warning in buggy code if non-text parts exist
            # Return concatenated text of all parts that are not thought or function_call
            texts = []
            for candidate in self.candidates:
                if candidate.content and candidate.content.parts:
                    for part in candidate.content.parts:
                        if not getattr(part, "thought", False) and not getattr(part, "function_call", False):
                            texts.append(part.text)
            return "".join(texts)

    # Create thought and text parts
    thought_text = "This is a thought."
    normal_text = "This is normal output."
    parts = [
        FakePart(text=thought_text, thought=True),
        FakePart(text=normal_text, thought=False),
    ]
    candidate_content = FakeCandidateContent(parts=parts)
    candidate = FakeCandidate(content=candidate_content)
    chunk = FakeChunk(candidates=[candidate])

    # Instantiate GeminiCompletion with a thinking model version >= 2.5 to trigger thinking_config
    # We patch the internal client call to avoid real network calls
    # We will call _process_stream_chunk directly to test the logic

    # Patch _extract_token_usage to avoid errors
    def fake_extract_token_usage(self, chunk):
        return {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}

    monkeypatch.setattr(completion.GeminiCompletion, "_extract_token_usage", fake_extract_token_usage)

    # Create instance with version >= 2.5 to get thinking_config auto-set
    gemini = completion.GeminiCompletion(model="gemini/gemini-2.5-pro")

    # Prepare variables for _process_stream_chunk
    full_response = ""
    function_calls = []
    usage_data = {}

    # Collect emitted events by monkeypatching crewai_event_bus.emit
    emitted_events = []

    def fake_emit(self, event):
        emitted_events.append(event)

    monkeypatch.setattr(completion.crewai_event_bus, "emit", fake_emit)

    # Call _process_stream_chunk with the fake chunk
    full_response, function_calls, usage_data = gemini._process_stream_chunk(
        chunk=chunk,
        full_response=full_response,
        function_calls=function_calls,
        usage_data=usage_data,
        from_task=None,
        from_agent=None,
    )

    # Assertions:

    # 1. full_response should include the normal text part but not the thought part
    assert normal_text in full_response
    assert thought_text not in full_response

    # 2. function_calls should be empty (no function_call parts)
    assert function_calls == []

    # 3. usage_data should be populated by fake_extract_token_usage
    assert usage_data == {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}

    # 4. emitted_events should include an LLMThinkingChunkEvent with the thought text
    from crewai.events.types.llm_events import LLMThinkingChunkEvent

    thought_events = [e for e in emitted_events if isinstance(e, LLMThinkingChunkEvent)]
    assert len(thought_events) == 1
    assert thought_events[0].chunk == thought_text

    # 5. emitted_events should also include an LLMStreamChunkEvent with the normal text
    from crewai.events.types.llm_events import LLMStreamChunkEvent

    stream_events = [e for e in emitted_events if isinstance(e, LLMStreamChunkEvent)]
    # There should be at least one stream event with the normal text chunk
    assert any(normal_text == e.chunk for e in stream_events) is True

    # 6. The thinking_config should be set to include_thoughts=True automatically for gemini-2.5+
    assert gemini.thinking_config is not None
    assert getattr(gemini.thinking_config, "include_thoughts", False) is True[0m
