        DummyPart(text=thought_text, thought=True),
        DummyPart(text=normal_text, thought=False),
    ]
    candidate_content = DummyCandidateContent(parts=parts)
    candidate = DummyCandidate(content=candidate_content)
    response = DummyResponse(candidates=[candidate])

    extracted_text = gemini_completion._extract_text_from_response(response)

    # The extracted text should contain only the normal text, not the thought text
    assert normal_text in extracted_text
    assert thought_text not in extracted_text[0m
