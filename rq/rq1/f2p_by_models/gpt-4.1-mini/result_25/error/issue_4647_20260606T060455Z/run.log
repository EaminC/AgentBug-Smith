[32mimport pytest
import asyncio

from crewai.llms.providers.gemini import completion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_emitted(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model (gemini-3.1-pro-preview)
    returns thought content in streaming mode and emits LLMThinkingChunkEvent.
    This test fails on buggy code (no thought content emitted),
    and passes after the fix which includes thinking_config and emits thoughts.
    """

    # We will patch the internal gemini client to simulate a streaming response
    # that includes thought parts, function_call parts, and text parts.

    # Prepare a dummy chunk structure mimicking the real gemini streaming chunk
    class DummyPart:
        def __init__(self, text=None, function_call=None, thought=False):
            self.text = text
            self.function_call = function_call
            self.thought = thought

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates, text=None, usage_metadata=None):
            self.candidates = candidates
            self._text = text
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # The buggy code uses this property which emits warning if non-text parts exist
            # We simulate this behavior by returning concatenated text parts only
            # but the fix uses parts directly.
            texts = []
            for candidate in self.candidates:
                if candidate.content and candidate.content.parts:
                    for part in candidate.content.parts:
                        if part.text and not part.thought and not part.function_call:
                            texts.append(part.text)
            return "".join(texts)

    # Create parts: one thought, one function_call, one normal text
    thought_text = "This is a thought."
    function_call_obj = {"name": "dummy_function", "arguments": "{}"}
    normal_text = "Hello world."

    parts = [
        DummyPart(text=thought_text, thought=True),
        DummyPart(function_call=function_call_obj),
        DummyPart(text=normal_text),
    ]

    dummy_content = DummyContent(parts=parts)
    dummy_candidate = DummyCandidate(content=dummy_content)
    dummy_chunk = DummyChunk(candidates=[dummy_candidate], text=normal_text)

    # Instantiate GeminiCompletion with a thinking model version >= 2.5
    # We force thinking_config=None to test auto-setting in constructor
    gemini = completion.GeminiCompletion(model="gemini/gemini-3.1-pro-preview", thinking_config=None)

    # Patch _emit_stream_chunk_event and _emit_thinking_chunk_event to capture emitted events
    emitted_stream_chunks = []
    emitted_thinking_chunks = []

    def fake_emit_stream_chunk_event(self, chunk, **kwargs):
        emitted_stream_chunks.append(chunk)

    def fake_emit_thinking_chunk_event(self, chunk, **kwargs):
        emitted_thinking_chunks.append(chunk)

    gemini._emit_stream_chunk_event = fake_emit_stream_chunk_event.__get__(gemini)
    gemini._emit_thinking_chunk_event = fake_emit_thinking_chunk_event.__get__(gemini)

    # Call _process_stream_chunk with dummy chunk
    full_response, function_calls, usage_data = gemini._process_stream_chunk(
        dummy_chunk,
        full_response="",
        function_calls=[],
        usage_data=None,
    )

    # Assertions:
    # 1. The full_response should include the normal text part only (thoughts not concatenated)
    assert normal_text in full_response
    assert thought_text not in full_response  # Thought text is not part of full_response string

    # 2. The emitted stream chunks should include the normal text only
    assert normal_text in emitted_stream_chunks

    # 3. The emitted thinking chunks should include the thought text
    assert any(thought_text in chunk for chunk in emitted_thinking_chunks)

    # 4. The thinking_config should be set automatically for gemini-3.1-pro-preview model
    assert gemini.thinking_config is not None
    assert getattr(gemini.thinking_config, "include_thoughts", False) is True

    # 5. There should be no warnings or errors emitted by the .text property usage
    # (This is implicit: if buggy, thought text is discarded and no thinking chunks emitted)

    # This test fails on buggy code because no thinking chunks are emitted and thought text is discarded.
    # After the fix, the thinking chunks are emitted and test passes.[0m
