@pytest.mark.asyncio
async def test_extract_text_from_response_excludes_thought_parts():
    """
    This test verifies that _extract_text_from_response excludes thought parts from text extraction.
    """

    # Create dummy parts including thought and normal text
    thought_part = DummyPart(text="thought text", thought=True)
    normal_part1 = DummyPart(text="normal1", thought=False)
    normal_part2 = DummyPart(text="normal2", thought=False)

    content = DummyContent(parts=[thought_part, normal_part1, normal_part2])
    candidate = DummyCandidate(content=content)

    # Create a dummy response with candidates list
    class DummyResponse:
        def __init__(self, candidates):
            self.candidates = candidates

    response = DummyResponse(candidates=[candidate])

    # Call the function under test
    text = gemini_completion._extract_text_from_response(response)

    # The extracted text should include normal parts but exclude thought parts
    assert "normal1" in text
    assert "normal2" in text
    assert "thought text" not in text

    # The text should be concatenation of normal parts only
    assert text == "normal1normal2"[0m
