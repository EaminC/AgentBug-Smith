[32mimport pytest
import asyncio

import crewai.llms.providers.gemini.completion as gemini_completion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_streaming(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model returns thought content in streaming mode.

    This test verifies that when using a Gemini thinking model (gemini-3.1-pro-preview or gemini-2.5+),
    and streaming responses, the thought parts are surfaced and emitted as events.

    Expected behavior:
    - The thought content parts are emitted via _emit_thinking_chunk_event.
    - The full text response includes text parts but does not discard thought parts.
    """

    # Prepare a dummy GeminiCompletion instance with a thinking model version >= 2.5
    # We patch the internal client to simulate streaming response with thought parts.

    class DummyPart:
        def __init__(self, text=None, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, text=None, candidates=None, usage_metadata=None):
            self._text = text
            self.candidates = candidates or []
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # Emulate the buggy behavior: accessing text property triggers warning if non-text parts present
            # For this test, we simulate that text property returns None or empty if candidates have non-text parts
            # But we want to test that thought parts are surfaced anyway.
            # So we simulate text property returning None to force _process_stream_chunk to rely on parts.
            return self._text

    # Create parts: one thought part, one text part, one function_call part
    thought_part = DummyPart(text="This is a thought.", thought=True)
    text_part = DummyPart(text="This is normal text.", thought=False)
    function_call_part = DummyPart(text=None, thought=False, function_call=True)

    content = DummyContent(parts=[thought_part, text_part, function_call_part])
    candidate = DummyCandidate(content=content)
    chunk = DummyChunk(text=None, candidates=[candidate], usage_metadata=None)

    # Instantiate GeminiCompletion with thinking_config enabled
    # We pass thinking_config explicitly to ensure include_thoughts=True
    thinking_config = types.ThinkingConfig(include_thoughts=True)
    client = gemini_completion.GeminiCompletion(model="gemini/gemini-3.1-pro-preview", thinking_config=thinking_config)

    # We will capture emitted events by monkeypatching _emit_thinking_chunk_event and _emit_stream_chunk_event
    emitted_thought_chunks = []
    emitted_text_chunks = []

    def fake_emit_thinking_chunk_event(self, chunk, **kwargs):
        emitted_thought_chunks.append(chunk)

    def fake_emit_stream_chunk_event(self, chunk, **kwargs):
        emitted_text_chunks.append(chunk)

    monkeypatch.setattr(client, "_emit_thinking_chunk_event", fake_emit_thinking_chunk_event)
    monkeypatch.setattr(client, "_emit_stream_chunk_event", fake_emit_stream_chunk_event)

    # Call the real _process_stream_chunk method with our dummy chunk
    full_response, function_calls, usage_data = client._process_stream_chunk(chunk, full_response="", function_calls=[], usage_data=None)

    # Assertions:
    # The thought part text should be emitted via _emit_thinking_chunk_event
    assert any("thought" in chunk or "This is a thought." in chunk for chunk in emitted_thought_chunks), \
        "Thought content was not emitted as thinking chunk event."

    # The text part should be emitted via _emit_stream_chunk_event
    assert any("This is normal text." in chunk for chunk in emitted_text_chunks), \
        "Text content was not emitted as stream chunk event."

    # The full_response should contain the text part but not the thought part
    assert "This is normal text." in full_response, "Full response missing text part."
    assert "This is a thought." not in full_response, "Full response should not contain thought part text."

    # function_calls and usage_data should be empty or None as no function_call or usage metadata was simulated
    assert function_calls == [], "Function calls list should be empty."
    assert usage_data is None, "Usage data should be None."


@pytest.mark.asyncio
async def test_prepare_generation_config_includes_thinking_config():
    """
    Test that _prepare_generation_config sets thinking_config when using a thinking model.
    """

    thinking_config = types.ThinkingConfig(include_thoughts=True)
    client = gemini_completion.GeminiCompletion(
        model="gemini/gemini-3.1-pro-preview",
        thinking_config=thinking_config,
    )

    config = client._prepare_generation_config(system_instruction="test", tools=None, response_model=None)

    # The returned config should have thinking_config set to the one we passed
    assert hasattr(config, "thinking_config"), "GenerateContentConfig missing thinking_config attribute."
    assert config.thinking_config == thinking_config, "thinking_config not set correctly in generation config."


