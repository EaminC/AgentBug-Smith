@pytest.mark.asyncio
async def test_gemini_completion_thoughts_streamed(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model includes thought parts in streaming output.

    This test verifies that the thought content is surfaced as separate events and included in the final output.
    On the buggy codebase, thought parts are discarded or cause warnings, so this test should fail.
