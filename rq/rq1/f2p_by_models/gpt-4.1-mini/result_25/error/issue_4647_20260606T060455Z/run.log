[32mimport pytest
import asyncio

import crewai.llms.providers.gemini.completion as gemini_completion
from google.genai import types


class DummyPart:
    def __init__(self, text=None, thought=False, function_call=False):
        self.text = text
        self.thought = thought
        self.function_call = function_call


class DummyContent:
    def __init__(self, parts):
        self.parts = parts


class DummyCandidate:
    def __init__(self, content):
        self.content = content


class DummyChunk:
    def __init__(self, text=None, candidates=None, usage_metadata=None):
        self._text = text
        self.candidates = candidates or []
        self.usage_metadata = usage_metadata

    @property
    def text(self):
        # This property triggers warning in buggy code if non-text parts present
        # We simulate that by returning concatenated text of all text parts
        if self.candidates:
            candidate = self.candidates[0]
            if candidate.content and candidate.content.parts:
                texts = []
                for part in candidate.content.parts:
                    if part.text:
                        texts.append(part.text)
                return "".join(texts)
        return self._text


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_emitted(capsys):
    """
    This test verifies that when using a Gemini thinking model with streaming,
    the thought parts are surfaced via events (printed here for test).

    On buggy code, thought parts are discarded and no thought output is emitted.
    On fixed code, thought parts are emitted and visible in output.
    """

    # Instantiate GeminiCompletion with a thinking model version >= 2.5 to trigger thinking_config
    # We do not pass thinking_config explicitly to test default behavior
    model_name = "gemini/gemini-3.1-pro-preview"
    client = gemini_completion.GeminiCompletion(model=model_name)

    # Prepare a dummy chunk simulating a streaming chunk from Gemini with thought parts
    thought_text = "This is a thought part."
    normal_text = "This is normal text."

    thought_part = DummyPart(text=thought_text, thought=True)
    normal_part = DummyPart(text=normal_text, thought=False)
    function_call_part = DummyPart(text=None, function_call=True)

    content = DummyContent(parts=[function_call_part, thought_part, normal_part])
    candidate = DummyCandidate(content=content)
    chunk = DummyChunk(text=None, candidates=[candidate])

    # full_response, function_calls, usage_data are accumulators in _process_stream_chunk
    full_response = ""
    function_calls = []
    usage_data = {}

    # Patch _emit_thinking_chunk_event to capture emitted thoughts for assertion
    emitted_thoughts = []

    original_emit_thinking_chunk_event = client._emit_thinking_chunk_event

    def capture_thinking_chunk_event(chunk, **kwargs):
        emitted_thoughts.append(chunk)
        return original_emit_thinking_chunk_event(chunk, **kwargs)

    client._emit_thinking_chunk_event = capture_thinking_chunk_event

    # Call the real _process_stream_chunk method with our dummy chunk
    # This method is synchronous
    full_response, function_calls, usage_data = client._process_stream_chunk(
        chunk=chunk,
        full_response=full_response,
        function_calls=function_calls,
        usage_data=usage_data,
    )

    # After processing, the full_response should include normal_text but not thought_text
    # The thought_text should be emitted via _emit_thinking_chunk_event and captured
    assert normal_text in full_response, "Normal text part should be included in full_response"

    # The thought_text should NOT be in full_response (not concatenated there)
    assert thought_text not in full_response, "Thought text should not be concatenated in full_response"

    # The thought_text should be emitted via _emit_thinking_chunk_event and captured
    assert emitted_thoughts, "Thought parts should be emitted via _emit_thinking_chunk_event"
    assert any(thought_text in emitted for emitted in emitted_thoughts), "Emitted thoughts should include the thought text"

    # The function_call part should not appear in text or thoughts
    assert all("function_call" not in emitted for emitted in emitted_thoughts), "Function call parts should not be emitted as thoughts"


@pytest.mark.asyncio
async def test_prepare_generation_config_sets_thinking_config():
    """
    This test verifies that _prepare_generation_config sets thinking_config
    when the model version is >= 2.5 and no explicit thinking_config is provided.
    """

    model_name = "gemini/gemini-2.5-pro"
    client = gemini_completion.GeminiCompletion(model=model_name)

    # Call _prepare_generation_config with minimal arguments
    config = client._prepare_generation_config()

    # The returned config should have thinking_config set and include_thoughts True
