[32mimport pytest
import asyncio

from crewai.llms.providers.gemini import completion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thinking_output_is_accessible(monkeypatch):
    """
    This test verifies that when using a Gemini thinking model with streaming,
    the thought content is surfaced via the LLMThinkingChunkEvent events.

    On the buggy codebase, the thought content is silently discarded and not emitted,
    causing this test to fail (no thought events captured).

    After the fix, thought content is emitted and captured, making this test pass.
    """

    # Use a GeminiCompletion instance with a thinking model version >= 2.5
    # to trigger thinking_config and thought output.
    model_name = "gemini/gemini-3.1-pro-preview"

    # We will collect emitted events here
    emitted_thought_chunks = []

    # Patch the event bus emit method to capture LLMThinkingChunkEvent events
    # but do not patch the GeminiCompletion methods themselves.
    original_emit = completion.crewai_event_bus.emit

    def emit_capture(sender, event):
        # We only capture thinking chunk events
        if event.__class__.__name__ == "LLMThinkingChunkEvent":
            emitted_thought_chunks.append(event.chunk)
        # Call original emit to preserve normal behavior
        return original_emit(sender, event)

    monkeypatch.setattr(completion.crewai_event_bus, "emit", emit_capture)

    # Instantiate GeminiCompletion with the thinking model
    gemini = completion.GeminiCompletion(model=model_name)

    # Prepare a prompt that would cause the model to produce thought output
    prompt = "Explain your reasoning step by step."

    # Because actual network calls to Gemini API are not feasible in tests,
    # we monkeypatch the _client.chat.completions.create method to simulate
    # a streaming response with thought parts.

    class DummyPart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates=None, text=None, usage_metadata=None):
            self.candidates = candidates or []
            self._text = text
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # This triggers the warning in buggy code if non-text parts present
            return self._text

    # Simulated streaming chunks with thought parts
    thought_text = "I think the answer is 42 because "
    normal_text = "the question is about life."

    dummy_chunks = [
        DummyChunk(
            candidates=[
                DummyCandidate(
                    DummyContent(
                        parts=[
                            DummyPart(text=thought_text, thought=True),
                        ]
                    )
                )
            ]
        ),
        DummyChunk(
            candidates=[
                DummyCandidate(
                    DummyContent(
                        parts=[
                            DummyPart(text=normal_text),
                        ]
                    )
                )
            ]
        ),
    ]

    # We will simulate the _process_stream_chunk calls with these dummy chunks
    full_response = ""
    function_calls = []
    usage_data = {}

    # Call _process_stream_chunk for each dummy chunk
    for chunk in dummy_chunks:
        full_response, function_calls, usage_data = gemini._process_stream_chunk(
            chunk, full_response, function_calls, usage_data
        )

    # The full_response should contain the normal text but not the thought text
    # because thought parts are emitted as events, not concatenated.
    assert normal_text in full_response
    assert thought_text not in full_response

    # The emitted_thought_chunks list should contain the thought text from the first chunk
    assert any(thought_text in chunk for chunk in emitted_thought_chunks), (
        "Thought text was not emitted as LLMThinkingChunkEvent. "
        "This indicates the bug is present."
    )[0m
