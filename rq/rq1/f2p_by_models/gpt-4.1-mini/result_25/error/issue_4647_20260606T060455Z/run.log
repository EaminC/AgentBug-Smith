[32mimport pytest
import asyncio

from crewai.llms.providers.gemini import completion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_thoughts_streaming_emission(monkeypatch):
    """
    Test that GeminiCompletion surfaces thought content from thinking models
    when streaming is enabled.

    This test verifies that:
    - The thinking_config is set to include thoughts for Gemini 2.5+ models.
    - The _process_stream_chunk emits thought chunks via _emit_thinking_chunk_event.
    """

    # Prepare a dummy GeminiCompletion instance with a thinking model version >= 2.5
    # We patch the internal client to avoid real network calls.
    class DummyClient:
        def generate_stream(self, *args, **kwargs):
            # Yield a simulated streaming chunk with thought parts
            # This simulates the response structure with thought parts included.
            thought_part = types.GenerateContentPart(
                text="This is a thought.",
                thought=True,
                function_call=None,
            )
            text_part = types.GenerateContentPart(
                text="This is normal text.",
                thought=False,
                function_call=None,
            )
            candidate = types.GenerateContentCandidate(
                content=types.GenerateContent(
                    parts=[thought_part, text_part]
                )
            )
            chunk = types.GenerateContentResponse(
                candidates=[candidate],
                text=None,
                usage_metadata=None,
            )
            yield chunk

    # Patch the internal client to our dummy client
    monkeypatch.setattr(completion.GeminiCompletion, "_client", DummyClient())

    # Instantiate GeminiCompletion with a gemini-2.5+ model name to trigger thinking_config
    gemini = completion.GeminiCompletion(model="gemini/gemini-3.1-pro-preview")

    # Confirm that thinking_config is set to include_thoughts=True
    assert gemini.thinking_config is not None
    assert gemini.thinking_config.include_thoughts is True

    # We will collect emitted thought chunks here
    emitted_thoughts = []

    # Patch the _emit_thinking_chunk_event to capture emitted thoughts instead of emitting
    def capture_thinking_chunk_event(self, chunk, **kwargs):
        emitted_thoughts.append(chunk)

    monkeypatch.setattr(
        completion.GeminiCompletion,
        "_emit_thinking_chunk_event",
        capture_thinking_chunk_event,
    )

    # Patch _emit_stream_chunk_event to capture normal text chunks (optional)
    emitted_texts = []

    def capture_stream_chunk_event(self, chunk, **kwargs):
        emitted_texts.append(chunk)

    monkeypatch.setattr(
        completion.GeminiCompletion,
        "_emit_stream_chunk_event",
        capture_stream_chunk_event,
    )

    # Call _prepare_generation_config and verify thinking_config is included in config
    gen_config = gemini._prepare_generation_config()
    assert gen_config.thinking_config is not None
    assert gen_config.thinking_config.include_thoughts is True

    # Simulate streaming response processing
    # We call _process_stream_chunk with the dummy chunk from DummyClient.generate_stream
    # and verify that thought parts are emitted correctly.

    # Get the dummy chunk
    dummy_chunk = next(DummyClient().generate_stream())

    # Prepare dummy parameters for _process_stream_chunk
    full_response = ""
    function_calls = []
    usage_data = None

    # Call the real method under test
    full_response, function_calls, usage_data = gemini._process_stream_chunk(
        dummy_chunk,
        full_response,
        function_calls,
        usage_data,
        from_task=None,
        from_agent=None,
    )

    # The full_response should contain the normal text part only (not thought)
    assert "This is normal text." in full_response
    assert "This is a thought." not in full_response

    # The emitted_thoughts list should contain the thought text
    assert any("This is a thought." in t for t in emitted_thoughts)

    # The emitted_texts list should contain the normal text
    assert any("This is normal text." in t for t in emitted_texts)

    # The function_calls list should remain empty (no function calls in dummy chunk)
    assert function_calls == []

    # usage_data should remain None (no usage metadata in dummy chunk)
    assert usage_data is None


@pytest.mark.asyncio
async def test_gemini_completion_text_extraction_filters_thoughts():
    """
    Test that _extract_text_from_response excludes thought parts from the final text.
    """

    # Create a GenerateContentResponse with mixed thought and non-thought parts
    thought_part = types.GenerateContentPart(text="Thought text", thought=True)
    normal_part = types.GenerateContentPart(text="Normal text", thought=False)
    candidate = types.GenerateContentCandidate(
        content=types.GenerateContent(parts=[thought_part, normal_part])
    )
    response = types.GenerateContentResponse(candidates=[candidate])

    # Extract text using the method
    extracted_text = completion._extract_text_from_response(response)

    # The extracted text should contain only the normal part, not the thought part
    assert "Normal text" in extracted_text
    assert "Thought text" not in extracted_text[0m
