[32mimport pytest
import asyncio

from crewai.llms.providers.gemini.completion import GeminiCompletion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_streaming():
    """
    Test that GeminiCompletion with a thinking model (gemini-3.1-pro-preview)
    returns thought content when streaming is enabled.

    This test verifies that thought parts are emitted and accessible,
    not discarded silently.

    Fail2pass:
    - On buggy codebase, thought parts are discarded and test fails.
    - After fix, thought parts are emitted and test passes.
    """

    # Use a known thinking model version >= 2.5 that supports thoughts
    model_name = "gemini/gemini-3.1-pro-preview"

    # Instantiate GeminiCompletion with streaming enabled
    # We do not override thinking_config to test default behavior
    client = GeminiCompletion(model=model_name)

    # Prepare a prompt that will trigger thought output
    prompt = "Explain why the sky is blue."

    # Collect emitted thought chunks
    thought_chunks = []

    # Patch the _emit_thinking_chunk_event method to capture thought chunks
    original_emit_thinking_chunk_event = client._emit_thinking_chunk_event

    def capture_thought_chunk(chunk, **kwargs):
        thought_chunks.append(chunk)
        return original_emit_thinking_chunk_event(chunk, **kwargs)

    client._emit_thinking_chunk_event = capture_thought_chunk

    # Run the streaming completion call
    # We use async generator interface to consume chunks
    thought_found = False
    full_text = ""

    async for chunk in client.stream(prompt):
        # chunk is a string of text parts (excluding thoughts)
        full_text += chunk

    # After streaming completes, check that thought chunks were captured
    # We expect at least one thought chunk emitted for thinking model
    assert len(thought_chunks) > 0, "No thought chunks were emitted by GeminiCompletion"

    # Also verify that the thought chunks contain non-empty text
    assert any(chunk.strip() for chunk in thought_chunks), "Thought chunks are empty"

    # Optionally verify that full_text is not empty
    assert full_text.strip(), "Full text response is empty"

    # Restore original method to avoid side effects
    client._emit_thinking_chunk_event = original_emit_thinking_chunk_event[0m
