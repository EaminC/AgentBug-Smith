            self.candidates = candidates

    thought_part = DummyPart(text="Thought text", thought=True)
    normal_part = DummyPart(text="Normal text", thought=False)

    content = DummyContent(parts=[thought_part, normal_part])
    candidate = DummyCandidate(content=content)
    response = DummyResponse(candidates=[candidate])

    text = completion._extract_text_from_response(response)

    # The extracted text should include only normal_part.text, not thought_part.text
    assert "Normal text" in text
    assert "Thought text" not in text[0m
