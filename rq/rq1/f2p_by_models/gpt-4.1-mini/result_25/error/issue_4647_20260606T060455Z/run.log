            self.usage_metadata = usage_metadata

        @property
        def text(self):
            return self._text

    # Create parts: one thought, one function_call, one text
    thought_part = DummyPart(text="Thought text.", thought=True)
    function_call_part = DummyPart(text=None, function_call=True)
    text_part = DummyPart(text="Normal text.", thought=False)

    candidate_content = DummyCandidateContent(parts=[function_call_part, thought_part, text_part])
    candidate = DummyCandidate(content=candidate_content)
    chunk = DummyChunk(candidates=[candidate], text=None)

    # We will capture emitted events by patching _emit_stream_chunk_event and _emit_thinking_chunk_event
    emitted_stream_chunks = []
    emitted_thinking_chunks = []

    original_emit_stream = gemini._emit_stream_chunk_event
    original_emit_thinking = gemini._emit_thinking_chunk_event

    def capture_emit_stream(chunk_text, *args, **kwargs):
        emitted_stream_chunks.append(chunk_text)
        return original_emit_stream(chunk_text, *args, **kwargs)

    def capture_emit_thinking(chunk_text, *args, **kwargs):
        emitted_thinking_chunks.append(chunk_text)
        return original_emit_thinking(chunk_text, *args, **kwargs)

    gemini._emit_stream_chunk_event = capture_emit_stream
    gemini._emit_thinking_chunk_event = capture_emit_thinking

    full_response, function_calls, usage_data = gemini._process_stream_chunk(chunk, "", [], {})

    # The full_response should include only the normal text part
    assert "Normal text." in full_response
    assert "Thought text." not in full_response

    # The emitted thinking chunks should include the thought text
    assert "Thought text." in emitted_thinking_chunks

    # The emitted stream chunks should include the normal text part
    assert "Normal text." in emitted_stream_chunks

    # The function_calls list should be empty (no function_call text part emitted)
    assert function_calls == []

    # usage_data should be a dict (empty or not)
    assert isinstance(usage_data, dict)


@pytest.mark.asyncio
async def test_stream_method_yields_text_and_thought_chunks(monkeypatch):
    """
    Integration test: stream method yields text chunks and thought chunks separately.

    This test fails on buggy code where thought chunks are discarded,
    and passes after the fix.
    """
    model_name = "gemini/gemini-3.1-pro-preview"
    gemini = completion.GeminiCompletion(model=model_name)

    # Patch the internal client stream method to yield chunks with thought parts
    class DummyPart:
        def __init__(self, text=None, thought=False):
            self.text = text
            self.thought = thought

    class DummyCandidateContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates=None, text=None):
            self.candidates = candidates or []
            self._text = text
            self.usage_metadata = None

        @property
        def text(self):
            return self._text

    async def dummy_stream(*args, **kwargs):
        thought_part = DummyPart(text="Thought chunk.", thought=True)
        text_part = DummyPart(text="Text chunk.", thought=False)
        candidate_content = DummyCandidateContent(parts=[thought_part, text_part])
        candidate = DummyCandidate(content=candidate_content)
        chunk = DummyChunk(candidates=[candidate], text=None)
        yield chunk

        # Another chunk with only text part
        candidate_content2 = DummyCandidateContent(parts=[DummyPart(text=" More text.", thought=False)])
        candidate2 = DummyCandidate(content=candidate_content2)
        chunk2 = DummyChunk(candidates=[candidate2], text=None)
        yield chunk2

    gemini._client.chat.completions.stream = dummy_stream

    # Capture emitted thinking chunks
    emitted_thoughts = []

    original_emit_thinking = gemini._emit_thinking_chunk_event

    def capture_emit_thinking(chunk, *args, **kwargs):
        emitted_thoughts.append(chunk)
        return original_emit_thinking(chunk, *args, **kwargs)

    gemini._emit_thinking_chunk_event = capture_emit_thinking

    collected_text = ""
    async for chunk_text in gemini.stream("Hello", stream=True):
        collected_text += chunk_text

    # The thought chunk should be emitted separately, not included in collected_text
    assert "Thought chunk." not in collected_text
    assert "Text chunk." in collected_text
    assert " More text." in collected_text

    # The thought chunk should be emitted as event
    assert "Thought chunk." in emitted_thoughts
    assert len(emitted_thoughts) == 1

