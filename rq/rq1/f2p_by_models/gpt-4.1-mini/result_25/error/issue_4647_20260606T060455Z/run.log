        )

    # Patch the internal _stream_generator method to use dummy_stream
    async def dummy_acall(self, *args, **kwargs):
        full_response = ""
        function_calls = []
        usage_data = None
        async for chunk in dummy_stream():
            full_response, function_calls, usage_data = self._process_stream_chunk(
                chunk, full_response, function_calls, usage_data
            )
        return full_response

    # Instantiate GeminiCompletion with the thinking model
    llm = gemini_completion.GeminiCompletion(model=model_name)

    # Patch the acall method to use our dummy stream
    llm.acall = dummy_acall.__get__(llm)

    # Collect emitted thinking chunks by patching _emit_thinking_chunk_event
    emitted_thoughts = []

    def capture_thinking_chunk_event(self, chunk, **kwargs):
        emitted_thoughts.append(chunk)

    llm._emit_thinking_chunk_event = capture_thinking_chunk_event.__get__(llm)

    # Run the async call
    result = await llm.acall("Test prompt")

    # The final result should include all non-thought text parts concatenated
    # The emitted_thoughts should include the thought text "thinking..."
    assert "Hello " in result
    assert "world!" in result
    assert "thinking..." not in result  # thought parts are not concatenated into final text

    # The thought chunk should be emitted as an event
    assert any("thinking..." in thought for thought in emitted_thoughts)

    # On buggy code, emitted_thoughts would be empty or thought text discarded, causing this assert to fail


def test_prepare_generation_config_sets_thinking_config():
    """
    Test that _prepare_generation_config sets thinking_config with include_thoughts=True for thinking models.
    """

    model_name = "gemini/gemini-3.1-pro-preview"
    llm = gemini_completion.GeminiCompletion(model=model_name)

    config = llm._prepare_generation_config()

    # The config should have thinking_config with include_thoughts=True
    assert hasattr(config, "thinking_config")
    assert config.thinking_config is not None
    assert config.thinking_config.include_thoughts is True


def test_process_stream_chunk_emits_thought_events():
    """
    Test that _process_stream_chunk emits thinking chunk events for thought parts.
    """

    model_name = "gemini/gemini-3.1-pro-preview"
    llm = gemini_completion.GeminiCompletion(model=model_name)

    # Prepare dummy parts
    thought_text = "some reasoning"
    normal_text = "answer text"

    part_thought = types.GenerateContentPart(text=thought_text, thought=True)
    part_text = types.GenerateContentPart(text=normal_text, thought=False)

    candidate = types.GenerateContentCandidate(content=types.GenerateContent(parts=[part_thought, part_text]))
    chunk = types.GenerateContentResponse(candidates=[candidate])

    # Capture emitted thinking chunks
    emitted_thoughts = []

    def capture_thinking_chunk_event(self, chunk, **kwargs):
        emitted_thoughts.append(chunk)

    llm._emit_thinking_chunk_event = capture_thinking_chunk_event.__get__(llm)

    full_response, function_calls, usage_data = llm._process_stream_chunk(
        chunk, "", [], None
    )

    # The full_response should include the normal text but not the thought text
    assert normal_text in full_response
    assert thought_text not in full_response

    # The thought text should be emitted as a thinking chunk event
    assert any(thought_text in t for t in emitted_thoughts)[0m
