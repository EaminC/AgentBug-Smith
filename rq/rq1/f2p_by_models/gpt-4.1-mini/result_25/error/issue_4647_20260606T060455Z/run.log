[32mimport pytest
import asyncio

from crewai.llms.providers.gemini.completion import GeminiCompletion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_are_emitted_and_accessible():
    """
    This test verifies that when using a Gemini thinking model with streaming,
    the thought parts are correctly emitted and accessible via events.

    It exercises the real GeminiCompletion._process_stream_chunk method with a
    mocked streaming chunk that includes thought parts, ensuring the thought
    text is emitted and included in the final response.

    This test should fail on the buggy codebase (thoughts discarded),
    and pass after the fix (thoughts emitted and accessible).
    """

    # Instantiate GeminiCompletion with a thinking model version >= 2.5 to trigger thinking_config
    llm = GeminiCompletion(model="gemini/gemini-3.1-pro-preview")

    # Prepare a GenerateContentConfig and verify thinking_config is set
    config = llm._prepare_generation_config()
    assert config.thinking_config is not None
    assert config.thinking_config.include_thoughts is True

    # Prepare a fake streaming chunk with thought parts and normal text parts
    # We construct a minimal chunk mimicking the real structure expected by _process_stream_chunk

    class FakePart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class FakeContent:
        def __init__(self, parts):
            self.parts = parts

    class FakeCandidate:
        def __init__(self, content):
            self.content = content

    class FakeChunk:
        def __init__(self, candidates, usage_metadata=None):
            self.candidates = candidates
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # This property triggers the warning if non-text parts are present
            # We simulate that it returns None to force _process_stream_chunk to use parts
            return None

    # Create parts: one thought part, one normal text part, one function_call part
    thought_text = "This is a thought part."
    normal_text = "This is a normal text part."
    func_call_text = "function_call_data"

    parts = [
        FakePart(text=thought_text, thought=True),
        FakePart(text=normal_text),
        FakePart(text=func_call_text, function_call=True),
    ]

    content = FakeContent(parts=parts)
    candidate = FakeCandidate(content=content)
    chunk = FakeChunk(candidates=[candidate])

    # Variables to capture emitted events
    emitted_thought_chunks = []
    emitted_stream_chunks = []

    # Patch the event emitter methods on llm to capture emitted chunks
    original_emit_thinking_chunk_event = llm._emit_thinking_chunk_event
    original_emit_stream_chunk_event = llm._emit_stream_chunk_event

    def capture_thinking_chunk_event(chunk, **kwargs):
        emitted_thought_chunks.append(chunk)
        return original_emit_thinking_chunk_event(chunk, **kwargs)

    def capture_stream_chunk_event(chunk, **kwargs):
        emitted_stream_chunks.append(chunk)
        return original_emit_stream_chunk_event(chunk, **kwargs)

    llm._emit_thinking_chunk_event = capture_thinking_chunk_event
    llm._emit_stream_chunk_event = capture_stream_chunk_event

    # Call the real _process_stream_chunk method with our fake chunk
    full_response, function_calls, usage_data = llm._process_stream_chunk(chunk, "", {}, {})

    # Restore original methods to avoid side effects
    llm._emit_thinking_chunk_event = original_emit_thinking_chunk_event
    llm._emit_stream_chunk_event = original_emit_stream_chunk_event

    # Assertions:
    # The full_response should include the normal text part but not the thought part
    assert normal_text in full_response
    assert thought_text not in full_response  # Thought text is emitted separately, not concatenated

    # The thought chunk event should have been emitted with the thought text
    assert any(thought_text == chunk for chunk in emitted_thought_chunks)

    # The normal text chunk event should have been emitted with the normal text
    assert any(normal_text == chunk for chunk in emitted_stream_chunks)

    # The function_call part should not appear in either emitted chunks as text
    assert all(func_call_text != chunk for chunk in emitted_thought_chunks)
    assert all(func_call_text != chunk for chunk in emitted_stream_chunks)[0m
