[32mimport pytest
import asyncio

from crewai.llms.providers.gemini.completion import GeminiCompletion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_streaming(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model returns thought content in streaming mode.

    This test verifies that the thought parts are included in the streamed chunks and that
    the thought content is accessible via the event system.

    This test should fail on the buggy codebase because thought content is discarded,
    and pass on the fixed codebase where thought content is properly surfaced.
    """

    # We will simulate a GeminiCompletion instance with a thinking model version >= 2.5
    # and call _prepare_generation_config to verify thinking_config is set.
    # Then we simulate streaming chunks containing thought parts and verify that
    # thought chunks are emitted.

    # Create an instance with a thinking model version string to trigger thinking_config
    model_name = "gemini/gemini-3.1-pro-preview"
    client = GeminiCompletion(model=model_name)

    # The thinking_config should be set automatically for gemini-2.5+ models
    assert client.thinking_config is not None
    assert isinstance(client.thinking_config, types.ThinkingConfig)
    assert client.thinking_config.include_thoughts is True

    # Prepare generation config and verify thinking_config is included
    gen_config = client._prepare_generation_config()
    assert hasattr(gen_config, "thinking_config")
    assert gen_config.thinking_config.include_thoughts is True

    # We will simulate a streaming chunk with thought parts.
    # Since the internal streaming method is complex and depends on the google.genai client,
    # we will simulate the call to _process_stream_chunk directly with a crafted chunk.

    # Create dummy part objects with thought and text attributes
    class DummyPart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates=None, usage_metadata=None):
            self.candidates = candidates or []
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # The buggy code uses chunk.text which triggers a warning if non-text parts exist.
            # We simulate that text property returns None to force fallback to parts processing.
            return None

    # Prepare dummy parts: one thought part and one normal text part
    thought_text = "This is a thought part."
    normal_text = "This is a normal text part."
    parts = [
        DummyPart(text=thought_text, thought=True),
        DummyPart(text=normal_text, thought=False),
    ]
    content = DummyContent(parts=parts)
    candidate = DummyCandidate(content=content)
    chunk = DummyChunk(candidates=[candidate])

    # We will capture emitted events by monkeypatching _emit_thinking_chunk_event and _emit_stream_chunk_event
    emitted_thought_chunks = []
    emitted_text_chunks = []

    def fake_emit_thinking_chunk_event(self, chunk_str, **kwargs):
        emitted_thought_chunks.append(chunk_str)

    def fake_emit_stream_chunk_event(self, chunk_str, **kwargs):
        emitted_text_chunks.append(chunk_str)

    monkeypatch.setattr(GeminiCompletion, "_emit_thinking_chunk_event", fake_emit_thinking_chunk_event)
    monkeypatch.setattr(GeminiCompletion, "_emit_stream_chunk_event", fake_emit_stream_chunk_event)

    # Call _process_stream_chunk with the dummy chunk
    full_response, function_calls, usage_data = client._process_stream_chunk(chunk, "", [], {})

    # The buggy code discards thought parts, so emitted_thought_chunks would be empty.
    # The fixed code emits thought chunks, so emitted_thought_chunks should contain thought_text.
    # We assert that thought_text is in emitted_thought_chunks to verify fix.

    assert thought_text in emitted_thought_chunks, "Thought content was not emitted in streaming chunks"

    # The normal text part should be emitted as a stream chunk and included in full_response
    assert normal_text in emitted_text_chunks, "Normal text content was not emitted in streaming chunks"
    assert normal_text in full_response, "Normal text content was not included in full_response"

    # The full_response should not contain the thought_text concatenated (thoughts are separate events)
    assert thought_text not in full_response, "Thought text should not be concatenated into full_response"

    # function_calls and usage_data should be empty dicts or lists as no function calls or usage metadata simulated
    assert isinstance(function_calls, list)
    assert isinstance(usage_data, dict)


@pytest.mark.asyncio
async def test_gemini_completion_prepare_generation_config_sets_thinking_config():
    """
    Test that _prepare_generation_config sets thinking_config when GeminiCompletion is initialized
    with a thinking model version >= 2.5 and no explicit thinking_config provided.
    """

    model_name = "gemini/gemini-2.5-pro"
    client = GeminiCompletion(model=model_name)

    # thinking_config should be set automatically to include_thoughts=True
    assert client.thinking_config is not None
    assert client.thinking_config.include_thoughts is True

    gen_config = client._prepare_generation_config()
    assert hasattr(gen_config, "thinking_config")
    assert gen_config.thinking_config.include_thoughts is True


