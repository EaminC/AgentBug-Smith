[32mimport pytest
import asyncio

from crewai.llms.providers.gemini import completion as gemini_completion
from google import genai
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_streaming_emitted(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model and stream=True
    emits thought chunks and includes thought content in the output.

    This test verifies that:
    - The thinking_config is set to include_thoughts=True.
    - The thought parts are emitted as separate events.
    - The full response includes all text parts (non-thought).
    """

    # Prepare a dummy thinking model name >= 2.5 to trigger thinking_config
    model_name = "gemini/gemini-3.1-pro-preview"

    # Create a dummy GeminiCompletion instance with the thinking model
    llm = gemini_completion.GeminiCompletion(model=model_name)

    # The thinking_config should be set automatically to include_thoughts=True
    assert llm.thinking_config is not None
    assert llm.thinking_config.include_thoughts is True

    # Prepare a fake stream chunk simulating a response with thought parts and text parts
    # We will create a GenerateContentResponse-like object with candidates and parts

    class DummyPart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates=None, usage_metadata=None):
            self.candidates = candidates or []
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # Simulate the property that raises warning if non-text parts exist
            # We simulate that text property returns None if non-text parts present
            # to mimic buggy behavior
            has_non_text_parts = any(
                getattr(part, "function_call", False) or getattr(part, "thought", False)
                for candidate in self.candidates
                for part in candidate.content.parts
            )
            if has_non_text_parts:
                # buggy code returns text but emits warning; here we simulate None to force use of parts
                return None
            else:
                # concatenate all text parts
                return "".join(
                    part.text for candidate in self.candidates for part in candidate.content.parts if part.text
                )

    # Create parts: one thought part, one normal text part, one function_call part
    thought_text = "This is a thought chunk."
    normal_text = "This is normal text."
    function_call_text = "function_call data"

    parts = [
        DummyPart(text=thought_text, thought=True),
        DummyPart(text=normal_text),
        DummyPart(text=function_call_text, function_call=True),
    ]

    dummy_content = DummyContent(parts=parts)
    dummy_candidate = DummyCandidate(content=dummy_content)
    dummy_chunk = DummyChunk(candidates=[dummy_candidate])

    # We will capture emitted events by patching the _emit_stream_chunk_event and _emit_thinking_chunk_event methods

    emitted_stream_chunks = []
    emitted_thinking_chunks = []

    def fake_emit_stream_chunk_event(self, chunk, **kwargs):
        emitted_stream_chunks.append(chunk)

    def fake_emit_thinking_chunk_event(self, chunk, **kwargs):
        emitted_thinking_chunks.append(chunk)

    # Patch the methods on the instance
    llm._emit_stream_chunk_event = fake_emit_stream_chunk_event.__get__(llm)
    llm._emit_thinking_chunk_event = fake_emit_thinking_chunk_event.__get__(llm)

    # Call the _process_stream_chunk method with the dummy chunk
    full_response, function_calls, usage_data = llm._process_stream_chunk(
        dummy_chunk, full_response="", function_calls=[], usage_data=None
    )

    # The full_response should include normal text and function_call text but not thought text
    # Because function_call text is not added to full_response, only normal text is added
    # According to patch, function_call parts do not add to full_response, only normal text parts do
    # So full_response should be normal_text only
    assert normal_text in full_response
    assert thought_text not in full_response
    assert function_call_text not in full_response  # function_call text is not appended to full_response

    # The emitted_thinking_chunks should include the thought_text
    assert thought_text in emitted_thinking_chunks

    # The emitted_stream_chunks should include the normal_text (function_call parts are emitted as tool call events, not stream chunks)
    assert normal_text in emitted_stream_chunks

    # The function_calls list should include the function_call_text as a tool call (simulate)
    # Actually, _process_stream_chunk returns function_calls updated with tool calls
    # The dummy chunk has a function_call part, so function_calls should be updated
    # But our dummy parts do not have full tool call structure, so function_calls remains empty
    # We just check function_calls is a list (empty or not)
    assert isinstance(function_calls, list)

    # usage_data should be None as dummy chunk has no usage_metadata
    assert usage_data is None


@pytest.mark.asyncio
async def test_gemini_completion_prepare_generation_config_sets_thinking_config():
    """
    Test that _prepare_generation_config sets thinking_config when using thinking models.
    """

    model_name = "gemini/gemini-3.1-pro-preview"
    llm = gemini_completion.GeminiCompletion(model=model_name)

    # The thinking_config should be set automatically
    assert llm.thinking_config is not None
    assert llm.thinking_config.include_thoughts is True

    # Prepare generation config and verify thinking_config is included
    config = llm._prepare_generation_config()

    # The config is a GenerateContentConfig instance
    # It should have a thinking_config attribute set to include_thoughts=True
    assert hasattr(config, "thinking_config")
    assert config.thinking_config is not None
    assert config.thinking_config.include_thoughts is True


