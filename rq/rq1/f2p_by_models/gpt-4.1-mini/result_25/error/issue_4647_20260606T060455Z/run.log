[32mimport pytest
import asyncio

from crewai.llms.providers.gemini import completion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_stream_includes_thoughts(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model and stream=True
    surfaces thought content in the streaming chunks.

    This test will fail on the buggy codebase because thought parts are discarded,
    and pass on the fixed codebase where thought parts are emitted as events.
    """

    # Prepare a dummy chunk simulating a streaming response with thought parts
    class DummyPart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates=None, text=None, usage_metadata=None):
            self.candidates = candidates or []
            self._text = text
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # Emulate the buggy .text property that raises warning if non-text parts exist
            # For simplicity, just return _text
            return self._text

    # Create thought and normal text parts
    thought_text = "This is a thought chunk."
    normal_text = "This is a normal text chunk."
    parts = [
        DummyPart(text=thought_text, thought=True),
        DummyPart(text=normal_text, thought=False),
    ]
    content = DummyContent(parts=parts)
    candidate = DummyCandidate(content=content)
    chunk = DummyChunk(candidates=[candidate], text=None)

    # Instantiate GeminiCompletion with a thinking model version >= 2.5 to trigger thinking_config
    # Use a dummy model name that triggers thinking_config logic
    model_name = "gemini/gemini-3.1-pro-preview"
    gemini = completion.GeminiCompletion(model=model_name)

    # Patch _emit_thinking_chunk_event and _emit_stream_chunk_event to capture emitted events
    emitted_thought_chunks = []
    emitted_stream_chunks = []

    def fake_emit_thinking_chunk_event(self, chunk_text, **kwargs):
        emitted_thought_chunks.append(chunk_text)

    def fake_emit_stream_chunk_event(self, chunk_text, **kwargs):
        emitted_stream_chunks.append(chunk_text)

    # Patch the methods on the instance only (not the class)
    gemini._emit_thinking_chunk_event = fake_emit_thinking_chunk_event.__get__(gemini)
    gemini._emit_stream_chunk_event = fake_emit_stream_chunk_event.__get__(gemini)

    # Call _process_stream_chunk with the dummy chunk
    full_response, function_calls, usage_data = gemini._process_stream_chunk(
        chunk=chunk,
        full_response="",
        function_calls=[],
        usage_data=None,
        from_task=None,
        from_agent=None,
    )

    # The buggy code discards thought parts, so emitted_thought_chunks would be empty
    # The fixed code emits thought parts, so emitted_thought_chunks should contain thought_text
    # We assert that the thought chunk is emitted and included in events

    # Assert that the thought chunk was emitted
    assert any(thought_text in c for c in emitted_thought_chunks), (
        "Thought chunk was not emitted in streaming events. "
        "This indicates the bug is present."
    )

    # Assert that the normal text chunk was emitted as a stream chunk
    assert any(normal_text in c for c in emitted_stream_chunks), (
        "Normal text chunk was not emitted in streaming events."
    )

    # Assert that the full_response includes the normal text but not the thought text (per design)
    assert normal_text in full_response, "Normal text chunk missing from full_response."
    assert thought_text not in full_response, "Thought text should not be concatenated to full_response."

    # Also test that the thinking_config is set to include_thoughts=True for thinking models
    assert gemini.thinking_config is not None, "thinking_config should be set for thinking models."
    assert gemini.thinking_config.include_thoughts is True, "thinking_config.include_thoughts should be True."


@pytest.mark.asyncio
async def test_prepare_generation_config_sets_thinking_config():
    """
    Test that _prepare_generation_config sets thinking_config when using thinking models.
    """

    model_name = "gemini/gemini-2.5-pro"
    gemini = completion.GeminiCompletion(model=model_name)

    # Call _prepare_generation_config and check that thinking_config is included
    config = gemini._prepare_generation_config()

    # The config should be a GenerateContentConfig with thinking_config included
    assert hasattr(config, "thinking_config"), "thinking_config missing in generation config."
    assert config.thinking_config is not None, "thinking_config should not be None."
    assert config.thinking_config.include_thoughts is True, "thinking_config.include_thoughts should be True."


@pytest.mark.asyncio
async def test_extract_text_from_response_excludes_thought_parts():
    """
    Test that _extract_text_from_response excludes thought parts from the extracted text.
    """

    # Create dummy parts with thought and non-thought text
    class DummyPart:
        def __init__(self, text, thought=False):
            self.text = text
            self.thought = thought

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyResponse:
        def __init__(self, candidates):
            self.candidates = candidates

    thought_text = "This is a thought."
    normal_text = "This is normal text."
    parts = [
        DummyPart(text=thought_text, thought=True),
        DummyPart(text=normal_text, thought=False),
    ]
    content = DummyContent(parts=parts)
    candidate = DummyCandidate(content=content)
    response = DummyResponse(candidates=[candidate])

    extracted_text = completion._extract_text_from_response(response)

    # The extracted text should include normal_text but exclude thought_text
    assert normal_text in extracted_text, "Normal text missing from extracted text."
    assert thought_text not in extracted_text, "Thought text should be excluded from extracted text."


@pytest.mark.asyncio
async def test_streaming_with_thought_and_function_call_parts(monkeypatch):
    """
    Test _process_stream_chunk handles function_call and thought parts correctly.
    """

    class DummyPart:
        def __init__(self, text="", thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates=None, text=None, usage_metadata=None):
            self.candidates = candidates or []
            self._text = text
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            return self._text

    # Parts: one function_call, one thought, one normal text
    func_call_part = DummyPart(text="function call text", function_call=True)
    thought_part = DummyPart(text="thought text", thought=True)
    normal_part = DummyPart(text="normal text", thought=False)

    content = DummyContent(parts=[func_call_part, thought_part, normal_part])
    candidate = DummyCandidate(content=content)
    chunk = DummyChunk(candidates=[candidate], text=None)

    gemini = completion.GeminiCompletion(model="gemini/gemini-3.1-pro-preview")

    emitted_thought_chunks = []
    emitted_stream_chunks = []

    def fake_emit_thinking_chunk_event(self, chunk_text, **kwargs):
        emitted_thought_chunks.append(chunk_text)

    def fake_emit_stream_chunk_event(self, chunk_text, **kwargs):
        emitted_stream_chunks.append(chunk_text)

    gemini._emit_thinking_chunk_event = fake_emit_thinking_chunk_event.__get__(gemini)
    gemini._emit_stream_chunk_event = fake_emit_stream_chunk_event.__get__(gemini)

    full_response, function_calls, usage_data = gemini._process_stream_chunk(
        chunk=chunk,
        full_response="",
        function_calls=[],
        usage_data=None,
        from_task=None,
        from_agent=None,
    )

    # function_call parts are handled elsewhere, so no direct emission here expected
    # thought_part text should be emitted as thinking chunk event
    assert any("thought text" in c for c in emitted_thought_chunks), "Thought part not emitted as thinking chunk."

    # normal_part text should be emitted as stream chunk event and included in full_response
    assert any("normal text" in c for c in emitted_stream_chunks), "Normal text part not emitted as stream chunk."
    assert "normal text" in full_response, "Normal text missing from full_response."

    # function_call text should not be emitted as stream chunk or thinking chunk here
    assert all("function call text" not in c for c in emitted_thought_chunks), "Function call text incorrectly emitted as thinking chunk."
    assert all("function call text" not in c for c in emitted_stream_chunks), "Function call text incorrectly emitted as stream chunk."[0m
