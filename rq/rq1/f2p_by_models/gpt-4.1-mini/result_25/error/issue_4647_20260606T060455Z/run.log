[32mimport pytest
import asyncio

from crewai.llms.providers.gemini import completion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_in_stream(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model returns thought parts in streaming output.

    This test verifies that when using a Gemini thinking model (gemini-3.1-pro-preview or gemini-2.5+),
    the streaming response includes thought content parts and that these parts are emitted as events.

    The buggy implementation ignores thought parts and only returns text parts,
    causing the test to fail. After the fix, thought parts should be present and emitted.
    """

    # Prepare a dummy thinking model name that triggers thinking_config inclusion
    model_name = "gemini/gemini-3.1-pro-preview"

    # Create an instance of GeminiCompletion with the thinking model
    gemini = completion.GeminiCompletion(model=model_name)

    # We will simulate a streaming response chunk with thought parts.
    # To do this, we need to mock the internal client call that yields streaming chunks.
    # We do NOT mock _process_stream_chunk or _prepare_generation_config,
    # but we mock the internal network client to yield a crafted chunk.

    # Define a dummy GenerateContentResponse chunk with thought parts
    class DummyPart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyCandidateContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates, usage_metadata=None):
            self.candidates = candidates
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # This property triggers warning if non-text parts exist.
            # We simulate that it returns None to force _process_stream_chunk
            # to iterate parts instead.
            return None

    # Create thought part and normal text part
    thought_text = "This is a thought part."
    normal_text = "This is a normal text part."

    thought_part = DummyPart(text=thought_text, thought=True)
    normal_part = DummyPart(text=normal_text, thought=False)

    dummy_content = DummyCandidateContent(parts=[thought_part, normal_part])
    dummy_candidate = DummyCandidate(content=dummy_content)
    dummy_chunk = DummyChunk(candidates=[dummy_candidate])

    # We patch the internal _client.stream_generate_content method to yield our dummy chunk
    # The real method signature is async generator yielding chunks
    async def dummy_stream_generate_content(*args, **kwargs):
        yield dummy_chunk

    # Patch the _client attribute and its stream_generate_content method
    class DummyClient:
        def __init__(self):
            self.stream_generate_content = dummy_stream_generate_content

    gemini._client = DummyClient()

    # We will collect emitted events by patching the event bus emit method
    emitted_thought_chunks = []
    emitted_stream_chunks = []

    def fake_emit(self, event):
        # event is a Pydantic model instance
        # We check type to separate thought chunks and normal stream chunks
        if event.type == "llm_thinking_chunk":
            emitted_thought_chunks.append(event.chunk)
        elif event.type == "llm_stream_chunk":
            emitted_stream_chunks.append(event.chunk)

    # Patch the global event bus emit method used by gemini
    # The gemini instance calls crewai_event_bus.emit(self, event=...)
    # We patch crewai_event_bus.emit to our fake_emit
    import crewai.llms.base_llm as base_llm

    original_emit = base_llm.crewai_event_bus.emit
    base_llm.crewai_event_bus.emit = fake_emit

    try:
        # Call the streaming method and collect the full response
        # The method is async, so we must await it
        # We use the call() method with stream=True to get async generator
        # and then iterate it to trigger _process_stream_chunk internally

        # The call signature is:
        # async def call(self, prompt, *, stream=False, **kwargs)
        # We'll pass a simple prompt and stream=True

        prompt = "Test prompt"

        # Collect all chunks from the async generator
        chunks = []
        async for chunk in gemini.call(prompt, stream=True):
            chunks.append(chunk)

        # After iteration, check that thought chunks were emitted
        # and that the full response includes the normal text part but not thought part
        # Because thought parts are emitted separately as events

        # The thought chunk event must contain the thought_text
        assert any(thought_text in c for c in emitted_thought_chunks), "Thought chunk not emitted"

        # The stream chunk events must include the normal text part
        assert any(normal_text in c for c in emitted_stream_chunks), "Normal text chunk not emitted"

        # The final concatenated response from call() should include normal_text but not thought_text
        # Because thought parts are emitted as separate events, not concatenated in main text
        full_response = "".join(chunks)
        assert normal_text in full_response, "Normal text missing from response"
        assert thought_text not in full_response, "Thought text should not be concatenated in main response"

    finally:
        # Restore original emit method
        base_llm.crewai_event_bus.emit = original_emit[0m
