[32mimport pytest
import asyncio

from crewai.llms.providers.gemini import completion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_streaming(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model includes thought content in streaming responses.

    This test verifies that when using a Gemini thinking model (gemini-3.1-pro-preview or gemini-2.5+),
    the thought parts are surfaced via events during streaming, not discarded or only logged as warnings.

    It triggers a streaming completion call and collects emitted thought chunks.
    The test fails on buggy code where thought parts are ignored and no thought events are emitted.
    After the fix, thought chunks should be emitted and captured.
    """

    # Prepare a dummy GeminiCompletion instance with a thinking model name
    model_name = "gemini/gemini-3.1-pro-preview"

    # Patch the internal client to simulate streaming chunks including thought parts
    # We patch the _client.chat.completions.stream method to yield crafted chunks

    class DummyPart:
        def __init__(self, text=None, function_call=False, thought=False):
            self.text = text
            self.function_call = function_call
            self.thought = thought

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates=None, text=None, usage_metadata=None):
            self.candidates = candidates or []
            self._text = text
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # The buggy code triggers warning if non-text parts present
            # We simulate that text property returns concatenated text parts only
            if self._text is not None:
                return self._text
            # If no direct text, fallback to concatenating parts text
            if self.candidates and self.candidates[0].content:
                return "".join(
                    part.text for part in self.candidates[0].content.parts if part.text
                )
            return ""

    # Simulate streaming response with mixed parts: text, function_call, thought
    thought_texts = ["This is a thought part 1. ", "Another thought part 2. "]
    text_parts = ["Hello ", "world! "]
    function_call_parts = [True, False]  # just flags, no text

    # Build parts list for candidate.content.parts
    parts = []
    # Add a text part
    parts.append(DummyPart(text=text_parts[0], thought=False))
    # Add a thought part
    parts.append(DummyPart(text=thought_texts[0], thought=True))
    # Add a function_call part (simulate no text)
    parts.append(DummyPart(text=None, function_call=True))
    # Add another text part
    parts.append(DummyPart(text=text_parts[1], thought=False))
    # Add another thought part
    parts.append(DummyPart(text=thought_texts[1], thought=True))

    dummy_candidate = DummyCandidate(DummyContent(parts))
    dummy_chunk = DummyChunk(candidates=[dummy_candidate])

    # We will yield this chunk once in the stream to simulate streaming
    async def dummy_stream(*args, **kwargs):
        yield dummy_chunk

    # Patch the GeminiCompletion instance's _client.chat.completions.stream method
    # to our dummy_stream
    # Also patch _prepare_generation_config to ensure thinking_config is set
    # We want to test the real _process_stream_chunk method behavior

    # Instantiate GeminiCompletion
    gemini = completion.GeminiCompletion(model=model_name)

    # Patch _client.chat.completions.stream
    gemini._client.chat.completions.stream = dummy_stream

    # Collect emitted thought chunks by patching _emit_thinking_chunk_event
    emitted_thoughts = []

    original_emit_thinking = gemini._emit_thinking_chunk_event

    def capture_emit_thinking(chunk, *args, **kwargs):
        emitted_thoughts.append(chunk)
        return original_emit_thinking(chunk, *args, **kwargs)

    gemini._emit_thinking_chunk_event = capture_emit_thinking

    # Run the streaming call and collect the full response text
    full_response = ""
    async for chunk_text in gemini.stream("Test prompt", stream=True):
        full_response += chunk_text

    # The full response should include the text parts concatenated
    expected_text = "".join(text_parts)
    assert expected_text in full_response, "Full response missing expected text parts"

    # The emitted thought chunks should include all thought texts
    for thought_text in thought_texts:
        assert any(thought_text in emitted for emitted in emitted_thoughts), (
            "Thought text not emitted in thinking chunk events: " + thought_text
        )

    # The test fails on buggy code because emitted_thoughts would be empty
    # and thought parts would not be surfaced.


