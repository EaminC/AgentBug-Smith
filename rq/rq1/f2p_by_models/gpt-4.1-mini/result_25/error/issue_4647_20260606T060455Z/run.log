[32mimport pytest
import asyncio

from crewai.llms.providers.gemini import completion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_are_emitted(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model includes thought parts in streaming output.

    This test triggers a streaming call to a Gemini thinking model (gemini-3.1-pro-preview)
    and asserts that thought content chunks are emitted via the event system.

    On the buggy codebase, thought parts are discarded and not emitted, so this test should fail.
    After the fix, thought parts are emitted and the test should pass.
    """

    # We patch the internal client call to simulate a streaming response including thought parts.
    # We do NOT patch _process_stream_chunk or _prepare_generation_config to test real logic.

    # Prepare a dummy streaming response chunk with thought parts
    class DummyPart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates, usage_metadata=None):
            self.candidates = candidates
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # Emulate property that triggers warning if non-text parts exist
            # For test, just return None to force processing of parts
            return None

    # Create thought part and normal text part
    thought_text = "This is a thought chunk."
    normal_text = "This is a normal text chunk."

    thought_part = DummyPart(text=thought_text, thought=True)
    normal_part = DummyPart(text=normal_text, thought=False)

    dummy_content = DummyContent(parts=[thought_part, normal_part])
    dummy_candidate = DummyCandidate(content=dummy_content)
    dummy_chunk = DummyChunk(candidates=[dummy_candidate])

    # We will capture emitted events by patching the event bus emit method
    emitted_thought_chunks = []

    def fake_emit(self, event):
        # We expect event to be LLMThinkingChunkEvent for thought parts
        # The event has attribute 'chunk' with the thought text
        # We collect these for assertion
        # The event type string is "llm_thinking_chunk"
        if getattr(event, "type", None) == "llm_thinking_chunk":
            emitted_thought_chunks.append(event.chunk)

    # Patch the event bus emit method on GeminiCompletion instance
    # The event bus is accessed as crewai_event_bus.emit inside _emit_thinking_chunk_event
    # We patch the emit method on the crewai_event_bus object used by GeminiCompletion

    # Access the crewai_event_bus from the module
    import crewai.llms.base_llm as base_llm

    # Save original emit method to restore later
    original_emit = base_llm.crewai_event_bus.emit
    base_llm.crewai_event_bus.emit = fake_emit

    # Instantiate GeminiCompletion with a thinking model name that triggers thinking_config
    gemini = completion.GeminiCompletion(model="gemini/gemini-3.1-pro-preview")

    # We call _process_stream_chunk directly with our dummy chunk
    # It returns updated full_response, function_calls, usage_data
    # We start with empty full_response and others

    full_response = ""
    function_calls = []
    usage_data = {}

    # Call the method under test
    full_response, function_calls, usage_data = gemini._process_stream_chunk(
        dummy_chunk,
        full_response,
        function_calls,
        usage_data,
        from_task=None,
        from_agent=None,
    )

    # Restore original emit method
    base_llm.crewai_event_bus.emit = original_emit

    # The full_response should include the normal text part only (thought parts not concatenated)
    assert normal_text in full_response
    assert thought_text not in full_response

    # The emitted_thought_chunks should contain the thought_text
    assert len(emitted_thought_chunks) == 1
    assert emitted_thought_chunks[0] == thought_text

    # The function_calls and usage_data remain unchanged (empty)
    assert function_calls == []
    assert usage_data == {}


@pytest.mark.asyncio
async def test_prepare_generation_config_includes_thinking_config():
    """
    Test that _prepare_generation_config sets thinking_config for thinking models.

    On the buggy codebase, thinking_config is not set, so thought content is not requested.
    After the fix, thinking_config is set with include_thoughts=True.
    """

    gemini = completion.GeminiCompletion(model="gemini/gemini-3.1-pro-preview")

    config = gemini._prepare_generation_config()

    # The config is a GenerateContentConfig and should have thinking_config attribute set
    # with include_thoughts=True
    assert hasattr(config, "thinking_config")
    assert config.thinking_config is not None
    assert getattr(config.thinking_config, "include_thoughts", False) is True


