@pytest.mark.asyncio
async def test_gemini_completion_thoughts_emitted(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model includes thought parts in streaming output.

    This test verifies that thought content is surfaced via events when using a Gemini thinking model
    with stream=True. It fails on the buggy codebase where thought parts are discarded and passes
    after the fix that includes thinking_config and emits thought chunks.

    The test mocks the internal streaming client to simulate a response with thought parts.
    """

    # Prepare a dummy chunk simulating a streaming response with thought parts
    class DummyPart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates=None, usage_metadata=None):
            self.candidates = candidates or []
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # This property triggers the warning if non-text parts exist
            # We simulate that by raising if thought parts exist and text is accessed improperly
            has_non_text = any(
                getattr(part, "thought", False) or getattr(part, "function_call", False)
                for part in self.candidates[0].content.parts
            )
            if has_non_text:
                # Simulate the buggy behavior warning by raising an exception to catch misuse
                raise RuntimeError("Accessing .text with non-text parts triggers warning")
            # Otherwise concatenate text parts
            return "".join(part.text for part in self.candidates[0].content.parts if part.text)

    # Create parts: one normal text part, one thought part
    parts = [
        DummyPart(text="Hello, ", thought=False),
        DummyPart(text="this is a thought.", thought=True),
        DummyPart(text=" World!", thought=False),
    ]
    content = DummyContent(parts=parts)
    candidate = DummyCandidate(content=content)
    chunk = DummyChunk(candidates=[candidate])

    # Instantiate GeminiCompletion with a thinking model version >= 2.5 to trigger thinking_config
    gemini = completion.GeminiCompletion(model="gemini/gemini-3.1-pro-preview")

    # Patch the internal client streaming method to yield our dummy chunk once
    async def dummy_stream(*args, **kwargs):
        yield chunk

    # Patch the _client.chat.completions.stream method
    # The internal client is google.genai.client.Client, but we patch the GeminiCompletion._client attribute
    # We patch _client.chat.completions.stream to our dummy_stream
    # Access _client attribute
    client = gemini._client
    # Patch the nested attribute
    client.chat.completions.stream = dummy_stream

    # Collect emitted thinking chunks
    emitted_thoughts = []

    # Patch the _emit_thinking_chunk_event method to capture emitted thoughts
    original_emit_thinking = gemini._emit_thinking_chunk_event

    def capture_emit_thinking(chunk, **kwargs):
        emitted_thoughts.append(chunk)
        return original_emit_thinking(chunk, **kwargs)

    gemini._emit_thinking_chunk_event = capture_emit_thinking

    # Also patch _emit_stream_chunk_event to avoid RuntimeError from .text property access in buggy code
    # We patch it to just collect normal text chunks without raising
    emitted_texts = []

    original_emit_stream = gemini._emit_stream_chunk_event

    def capture_emit_stream(chunk, **kwargs):
        emitted_texts.append(chunk)
        return original_emit_stream(chunk, **kwargs)

    gemini._emit_stream_chunk_event = capture_emit_stream

    # Run the streaming call and collect full response
    full_response = ""
    async for chunk_text in gemini.stream("Say hello"):
        full_response += chunk_text

