[32mimport pytest
import asyncio

import crewai.llms.providers.gemini.completion as gemini_completion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_emitted(monkeypatch):
    """
    This test verifies that when using a Gemini thinking model with streaming,
    the thought parts are emitted as events and included in the output.

    On the buggy codebase, thought parts are discarded and not emitted,
    causing this test to fail. After the fix, thought parts are emitted
    and the test passes.
    """

    # Prepare a dummy chunk simulating a streaming response with thought parts
    class DummyPart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates=None, usage_metadata=None):
            self.candidates = candidates or []
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # This property triggers the warning if non-text parts exist
            # We simulate that behavior by raising a warning if parts have thought or function_call
            has_non_text = any(
                getattr(part, "thought", False) or getattr(part, "function_call", False)
                for part in self.candidates[0].content.parts
            )
            if has_non_text:
                # Simulate the warning behavior by returning None or empty string
                return ""
            # Otherwise, concatenate all text parts
            return "".join(part.text for part in self.candidates[0].content.parts if part.text)

    # Create parts including thought parts and normal text parts
    thought_text = "This is a thought part."
    normal_text = "This is a normal text part."
    parts = [
        DummyPart(text=thought_text, thought=True),
        DummyPart(text=normal_text, thought=False),
    ]
    content = DummyContent(parts=parts)
    candidate = DummyCandidate(content=content)
    chunk = DummyChunk(candidates=[candidate])

    # Instantiate GeminiCompletion with a thinking model version >= 2.5 to trigger thinking_config
    # Use a dummy model name that matches the version regex
    model_name = "gemini/gemini-3.1-pro-preview"
    gemini = gemini_completion.GeminiCompletion(model=model_name)

    # Patch the _emit_stream_chunk_event and _emit_thinking_chunk_event to capture emitted events
    emitted_stream_chunks = []
    emitted_thinking_chunks = []

    def fake_emit_stream_chunk_event(self, chunk, **kwargs):
        emitted_stream_chunks.append(chunk)

    def fake_emit_thinking_chunk_event(self, chunk, **kwargs):
        emitted_thinking_chunks.append(chunk)

    monkeypatch.setattr(gemini, "_emit_stream_chunk_event", fake_emit_stream_chunk_event.__get__(gemini))
    monkeypatch.setattr(gemini, "_emit_thinking_chunk_event", fake_emit_thinking_chunk_event.__get__(gemini))

    # Call _process_stream_chunk with the dummy chunk
    full_response, function_calls, usage_data = gemini._process_stream_chunk(chunk, full_response="", function_calls=[], usage_data=None)

    # The full_response should include the normal text part but not thought parts concatenated
    assert normal_text in full_response
    # The thought text should NOT be in full_response (thoughts are emitted separately)
    assert thought_text not in full_response

    # The emitted_thinking_chunks should include the thought text part
    assert any(thought_text in c for c in emitted_thinking_chunks), "Thought parts should be emitted as thinking chunk events"

    # The emitted_stream_chunks should include the normal text part
    assert any(normal_text in c for c in emitted_stream_chunks), "Normal text parts should be emitted as stream chunk events"

    # Also verify that the thinking_config is set automatically for thinking models
    config = gemini._prepare_generation_config()
    assert config.thinking_config is not None
    assert config.thinking_config.include_thoughts is True[0m
