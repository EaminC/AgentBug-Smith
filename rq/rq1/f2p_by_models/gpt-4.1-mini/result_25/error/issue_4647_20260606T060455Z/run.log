[32mimport pytest
import asyncio

from crewai.llms.providers.gemini import completion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_emitted(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model includes thought parts in streaming output.

    This test triggers the streaming method and verifies that thought parts are emitted
    as events and included in the output, not discarded or only warnings logged.

    Fail2pass: On buggy code, thought parts are discarded and test should fail.
               On fixed code, thought parts are emitted and test should pass.
    """

    # Prepare a dummy GeminiCompletion instance with a thinking model name >= 2.5
    model_name = "gemini/gemini-3.1-pro-preview"

    # Patch the internal client to simulate streaming response with thought parts
    class DummyPart:
        def __init__(self, text=None, function_call=None, thought=False):
            self.text = text
            self.function_call = function_call
            self.thought = thought

    class DummyCandidateContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates=None, text=None, usage_metadata=None):
            self.candidates = candidates or []
            self._text = text
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # This property triggers warning if non-text parts exist in buggy code
            return self._text

    # Prepare thought and normal text parts
    thought_text = "This is a thought part."
    normal_text = "This is normal text."

    thought_part = DummyPart(text=thought_text, thought=True)
    normal_part = DummyPart(text=normal_text, thought=False)

    candidate_content = DummyCandidateContent(parts=[thought_part, normal_part])
    candidate = DummyCandidate(content=candidate_content)

    # Chunk contains candidates with thought and normal parts, no direct chunk.text
    chunk = DummyChunk(candidates=[candidate], text=None)

    # Create GeminiCompletion instance with thinking_config=None to trigger default include_thoughts=True
    gemini = completion.GeminiCompletion(model=model_name)

    # We will collect emitted events here
    emitted_thinking_chunks = []
    emitted_stream_chunks = []

    # Patch the event emitter methods to capture calls
    def fake_emit_thinking_chunk_event(self, chunk, **kwargs):
        emitted_thinking_chunks.append(chunk)

    def fake_emit_stream_chunk_event(self, chunk, **kwargs):
        emitted_stream_chunks.append(chunk)

    # Patch the instance methods
    gemini._emit_thinking_chunk_event = fake_emit_thinking_chunk_event.__get__(gemini)
    gemini._emit_stream_chunk_event = fake_emit_stream_chunk_event.__get__(gemini)

    # Call _process_stream_chunk with our dummy chunk
    full_response, function_calls, usage_data = gemini._process_stream_chunk(chunk, "", [], {})

    # The full_response should include the normal text part but not thought text concatenated
    assert normal_text in full_response

    # The thought text should NOT be in full_response concatenated (thoughts are separate)
    assert thought_text not in full_response

    # The emitted_thinking_chunks should include the thought text
    assert any(thought_text in c for c in emitted_thinking_chunks)

    # The emitted_stream_chunks should include the normal text
    assert any(normal_text in c for c in emitted_stream_chunks)

    # The thinking_config should be set to include_thoughts=True for this model
    assert gemini.thinking_config is not None
    assert getattr(gemini.thinking_config, "include_thoughts", False) is True

    # Also test _prepare_generation_config sets thinking_config in the config
    config = gemini._prepare_generation_config()
    assert hasattr(config, "thinking_config")
    assert config.thinking_config is not None
    assert getattr(config.thinking_config, "include_thoughts", False) is True

    # Finally, test _extract_text_from_response excludes thought parts from text extraction
    # Build a dummy GenerateContentResponse-like object
    class DummyResponse:
        def __init__(self, candidates):
            self.candidates = candidates

    # Candidate with thought and normal parts
    candidate = type("Candidate", (), {})()
    candidate.content = type("Content", (), {})()
    candidate.content.parts = [thought_part, normal_part]

    response = DummyResponse(candidates=[candidate])

    extracted_text = completion._extract_text_from_response(response)
    # Should include only normal text, not thought text
    assert normal_text in extracted_text
    assert thought_text not in extracted_text[0m
