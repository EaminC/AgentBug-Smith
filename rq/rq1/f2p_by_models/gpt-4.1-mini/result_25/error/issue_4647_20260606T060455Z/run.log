[32mimport pytest
import asyncio

from crewai.llms.providers.gemini.completion import GeminiCompletion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_in_stream(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model includes thought parts in streaming output.

    This test verifies that thought content is surfaced in the streaming response chunks,
    not discarded or only present as opaque metadata.

    It exercises the real GeminiCompletion._process_stream_chunk method with a mocked streaming
    chunk containing thought parts, and asserts that the thought text is emitted via the
    _emit_thinking_chunk_event method.

    The test will fail on the buggy codebase because thought parts are ignored and not emitted.
    After the fix, the test should pass.
    """

    # Prepare a dummy GeminiCompletion instance with a thinking_config forcing include_thoughts=True
    thinking_config = types.ThinkingConfig(include_thoughts=True)
    gemini = GeminiCompletion(thinking_config=thinking_config)

    # Prepare dummy data structures to simulate a streaming chunk with thought parts
    class DummyPart:
        def __init__(self, text=None, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates=None, usage_metadata=None, text=None):
            self.candidates = candidates or []
            self.usage_metadata = usage_metadata
            self._text = text

        @property
        def text(self):
            # The buggy code uses this property which triggers warning if non-text parts exist
            return self._text

    # Create parts: one thought part, one normal text part, one function_call part
    thought_text = "This is a thought chunk."
    normal_text = "This is normal text."
    function_call_text = "function_call_data"

    parts = [
        DummyPart(text=thought_text, thought=True),
        DummyPart(text=normal_text, thought=False),
        DummyPart(text=function_call_text, function_call=True),
    ]

    content = DummyContent(parts=parts)
    candidate = DummyCandidate(content=content)
    chunk = DummyChunk(candidates=[candidate], usage_metadata=True, text=None)

    # Variables to capture emitted events
    emitted_thinking_chunks = []
    emitted_stream_chunks = []

    # Patch the _emit_thinking_chunk_event and _emit_stream_chunk_event to capture calls
    def fake_emit_thinking_chunk_event(chunk, **kwargs):
        emitted_thinking_chunks.append(chunk)

    def fake_emit_stream_chunk_event(chunk, **kwargs):
        emitted_stream_chunks.append(chunk)

    gemini._emit_thinking_chunk_event = fake_emit_thinking_chunk_event
    gemini._emit_stream_chunk_event = fake_emit_stream_chunk_event

    # Call the real _process_stream_chunk method
    full_response = ""
    function_calls = []
    usage_data = None

    full_response, function_calls, usage_data = gemini._process_stream_chunk(
        chunk, full_response, function_calls, usage_data
    )

    # Assertions:

    # The thought text should be emitted via _emit_thinking_chunk_event
    assert any(thought_text in chunk for chunk in emitted_thinking_chunks), \
        "Thought text was not emitted in thinking chunk events."

    # The normal text should be emitted via _emit_stream_chunk_event and included in full_response
    assert any(normal_text in chunk for chunk in emitted_stream_chunks), \
        "Normal text was not emitted in stream chunk events."
    assert normal_text in full_response, "Normal text not included in full_response."

    # The function_call part should not appear in text or thinking chunks (usually handled separately)
    # So it should not be in full_response or emitted_thinking_chunks or emitted_stream_chunks
    assert all(function_call_text not in chunk for chunk in emitted_thinking_chunks), \
        "Function call text incorrectly emitted in thinking chunk events."
    assert all(function_call_text not in chunk for chunk in emitted_stream_chunks), \
        "Function call text incorrectly emitted in stream chunk events."
    assert function_call_text not in full_response, "Function call text incorrectly in full_response."[0m
