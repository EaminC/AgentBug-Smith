[32mimport pytest
import asyncio

from crewai.llms.providers.gemini import completion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_emitted(monkeypatch):
    """
    This test verifies that when using a Gemini thinking model with streaming,
    the thought parts are properly surfaced via events.

    BUGGY behavior:
      - Thought parts are discarded and not emitted.
      - chunk.text triggers a warning and thought content is lost.

    FIXED behavior:
      - thinking_config is set to include_thoughts=True.
      - _process_stream_chunk emits LLMThinkingChunkEvent for thought parts.
    """

    # Prepare a dummy GeminiCompletion instance with thinking_config None so it sets include_thoughts=True internally
    gemini = completion.GeminiCompletion(model="gemini/gemini-3.1-pro-preview")

    # We will simulate a streaming chunk with thought parts.
    # Create a fake part with thought=True and text content.
    class DummyPart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates, usage_metadata=None):
            self.candidates = candidates
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # Simulate property that triggers warning if non-text parts present
            # For test, just return None to force _process_stream_chunk to look at parts
            return None

    # Create thought part and normal text part
    thought_text = "This is a thought chunk."
    normal_text = "This is a normal text chunk."

    thought_part = DummyPart(text=thought_text, thought=True)
    normal_part = DummyPart(text=normal_text, thought=False)

    content = DummyContent(parts=[thought_part, normal_part])
    candidate = DummyCandidate(content=content)
    chunk = DummyChunk(candidates=[candidate])

    # We will capture emitted events by monkeypatching crewai_event_bus.emit
    emitted_events = []

    def fake_emit(self, event):
        emitted_events.append(event)

    # Patch the event bus emit method on the GeminiCompletion instance
    monkeypatch.setattr(completion.crewai_event_bus, "emit", fake_emit)

    # Call _process_stream_chunk with our dummy chunk
    full_response = ""
    function_calls = []
    usage_data = {}

    # The method is synchronous, call directly
    result = gemini._process_stream_chunk(
        chunk=chunk,
        full_response=full_response,
        function_calls=function_calls,
        usage_data=usage_data,
    )

    # result is a tuple: (full_response, function_calls, usage_data)
    full_response, function_calls, usage_data = result

    # Check that thought text was emitted via LLMThinkingChunkEvent
    # and normal text was appended to full_response and emitted as LLMStreamChunkEvent

    # There should be at least one LLMThinkingChunkEvent with chunk == thought_text
    thought_events = [e for e in emitted_events if getattr(e, "type", None) == "llm_thinking_chunk"]
    assert any(thought_text in getattr(e, "chunk", "") for e in thought_events), \
        "Thought chunk was not emitted as LLMThinkingChunkEvent"

    # There should be at least one LLMStreamChunkEvent with chunk == normal_text
    stream_events = [e for e in emitted_events if getattr(e, "type", None) == "llm_stream_chunk"]
    assert any(normal_text in getattr(e, "chunk", "") for e in stream_events), \
        "Normal text chunk was not emitted as LLMStreamChunkEvent"

    # The full_response should contain the normal_text but NOT the thought_text
    assert normal_text in full_response, "Normal text missing from full_response"
    assert thought_text not in full_response, "Thought text should not be in full_response"

    # Also verify that the thinking_config was set to include_thoughts=True for this model
    assert gemini.thinking_config is not None, "thinking_config should not be None"
    assert getattr(gemini.thinking_config, "include_thoughts", False) is True, \
        "thinking_config.include_thoughts should be True"


@pytest.mark.asyncio
async def test_prepare_generation_config_sets_thinking_config():
    """
    Test that _prepare_generation_config sets thinking_config when thinking_config attribute is set.
    """

    gemini = completion.GeminiCompletion(model="gemini/gemini-3.1-pro-preview")

    # forcibly set thinking_config to a custom value
    gemini.thinking_config = types.ThinkingConfig(include_thoughts=True)

    config = gemini._prepare_generation_config()

    # The returned config should have thinking_config attribute set and matching gemini.thinking_config
    assert hasattr(config, "thinking_config"), "GenerateContentConfig missing thinking_config"
    assert config.thinking_config.include_thoughts is True, "thinking_config.include_thoughts should be True"


