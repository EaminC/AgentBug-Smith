[32mimport pytest
import asyncio

from crewai.llms.providers.gemini import completion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_are_emitted(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model includes thought parts in streaming output.

    This test verifies that thought parts are emitted as LLMThinkingChunkEvent events,
    and that the full response text includes the concatenated text parts excluding thoughts.

    On the buggy codebase, thought parts are discarded and not emitted, causing this test to fail.
    After the fix, thought parts are included and emitted, so this test should pass.
    """

    # Prepare a dummy GeminiCompletion instance with a thinking model version >= 2.5
    # We patch the internal client call to simulate streaming response with thought parts.

    # Create a dummy chunk structure that simulates a streaming chunk from Gemini with thought parts
    class DummyPart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates, usage_metadata=None):
            self.candidates = candidates
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # This triggers the warning if non-text parts exist in buggy code
            # Return concatenated text parts only for simulation
            texts = []
            for candidate in self.candidates:
                if candidate.content and candidate.content.parts:
                    for part in candidate.content.parts:
                        if part.text and not part.thought and not part.function_call:
                            texts.append(part.text)
            return "".join(texts)

    # We will capture emitted events by patching the event bus emit method
    emitted_thinking_chunks = []
    emitted_stream_chunks = []

    def dummy_emit(self, event):
        # event is an instance of LLMThinkingChunkEvent or LLMStreamChunkEvent
        # We distinguish by event.type
        if hasattr(event, "type"):
            if event.type == "llm_thinking_chunk":
                emitted_thinking_chunks.append(event.chunk)
            elif event.type == "llm_stream_chunk":
                emitted_stream_chunks.append(event.chunk)

    # Patch the crewai_event_bus.emit method used inside GeminiCompletion
    monkeypatch.setattr(completion.crewai_event_bus, "emit", dummy_emit)

    # Instantiate GeminiCompletion with a thinking model version >= 2.5 to trigger thinking_config
    gemini = completion.GeminiCompletion(model="gemini/gemini-3.1-pro-preview")

    # Construct a dummy chunk with mixed parts: text, thought, function_call
    parts = [
        DummyPart(text="Hello, ", thought=False),
        DummyPart(text="this is a thought.", thought=True),
        DummyPart(text=" How are you?", thought=False),
        DummyPart(text="func_call_data", function_call=True),
    ]
    content = DummyContent(parts=parts)
    candidate = DummyCandidate(content=content)
    chunk = DummyChunk(candidates=[candidate])

    # Call _process_stream_chunk with the dummy chunk
    # This method returns updated full_response, function_calls, usage_data
    full_response, function_calls, usage_data = gemini._process_stream_chunk(
        chunk=chunk,
        full_response="",
        function_calls=[],
        usage_data=None,
        from_task=None,
        from_agent=None,
    )

    # The full_response should concatenate only text parts excluding thoughts and function calls
    expected_response = "Hello,  How are you?"
    assert full_response == expected_response, "Full response text should exclude thought and function_call parts"

    # The emitted_thinking_chunks should include the thought text
    assert any("this is a thought." in chunk for chunk in emitted_thinking_chunks), \
        "Thought parts should be emitted as LLMThinkingChunkEvent"

    # The emitted_stream_chunks should include the non-thought text parts
    emitted_text = "".join(emitted_stream_chunks)
    assert "Hello, " in emitted_text and " How are you?" in emitted_text, \
        "Non-thought text parts should be emitted as LLMStreamChunkEvent"

    # The function_calls list should remain empty as no function_call parts are processed here
    assert function_calls == [], "No function calls should be extracted in this test chunk"


@pytest.mark.asyncio
async def test_prepare_generation_config_sets_thinking_config():
    """
    Test that _prepare_generation_config sets thinking_config when using thinking models.

    On buggy codebase, thinking_config is not set, so thought parts are not included.
    After fix, thinking_config is set with include_thoughts=True.
    """
    gemini = completion.GeminiCompletion(model="gemini/gemini-3.1-pro-preview")

    config = gemini._prepare_generation_config()

    # The config should have thinking_config attribute set with include_thoughts=True
    assert hasattr(config, "thinking_config") and config.thinking_config is not None, \
        "thinking_config should be set in generation config for thinking models"

    assert getattr(config.thinking_config, "include_thoughts", False) is True, \
        "thinking_config.include_thoughts should be True for thinking models"


@pytest.mark.asyncio
async def test_extract_text_from_response_excludes_thought_parts():
    """
    Test that _extract_text_from_response excludes thought parts from the final text.

    On buggy codebase, thought parts might be included or cause warnings.
    After fix, thought parts are excluded from extracted text.
    """

    # Create dummy response with parts including thought and non-thought
    class DummyPart:
        def __init__(self, text, thought=False):
            self.text = text
            self.thought = thought

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyResponse:
        def __init__(self, candidates):
            self.candidates = candidates

    parts = [
        DummyPart(text="Visible text. ", thought=False),
        DummyPart(text="Invisible thought.", thought=True),
        DummyPart(text=" More visible text.", thought=False),
    ]
    content = DummyContent(parts=parts)
    candidate = DummyCandidate(content=content)
    response = DummyResponse(candidates=[candidate])

    extracted_text = completion._extract_text_from_response(response)

    assert "Invisible thought." not in extracted_text, "Thought parts should be excluded from extracted text"
    assert "Visible text." in extracted_text and "More visible text." in extracted_text, \
        "Non-thought text parts should be included in extracted text"[0m
