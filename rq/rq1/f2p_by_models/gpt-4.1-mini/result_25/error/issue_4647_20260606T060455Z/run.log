[32mimport pytest
import asyncio

from crewai.llms.providers.gemini import completion
from google.genai import types


@pytest.mark.asyncio
async def test_gemini_completion_thoughts_emitted(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model includes thought parts in the streaming output.

    This test verifies that when using a Gemini thinking model with streaming,
    the thought content is emitted as events and included in the final output.

    On the buggy codebase, this test should fail because thought parts are ignored.
    After the fix, this test should pass.
    """

    # Use a GeminiCompletion instance with a thinking model version >= 2.5 to trigger thinking_config
    model_name = "gemini/gemini-3.1-pro-preview"

    # Patch the internal client to simulate streaming response with thought parts
    class DummyPart:
        def __init__(self, text="", thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates=None, text=None, usage_metadata=None):
            self.candidates = candidates or []
            self._text = text
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # This triggers the warning on buggy code if non-text parts exist
            return self._text

    # Create thought and text parts
    thought_text = "This is a thought part. "
    normal_text = "This is normal text. "

    thought_part = DummyPart(text=thought_text, thought=True)
    text_part = DummyPart(text=normal_text, thought=False)
    content = DummyContent(parts=[thought_part, text_part])
    candidate = DummyCandidate(content=content)
    chunk = DummyChunk(candidates=[candidate], text=None)

    # Instantiate GeminiCompletion with the model name
    gemini = completion.GeminiCompletion(model=model_name)

    # Patch _emit_thinking_chunk_event and _emit_stream_chunk_event to capture emitted chunks
    emitted_thinking_chunks = []
    emitted_stream_chunks = []

    def fake_emit_thinking_chunk_event(self, chunk, **kwargs):
        emitted_thinking_chunks.append(chunk)

    def fake_emit_stream_chunk_event(self, chunk, **kwargs):
        emitted_stream_chunks.append(chunk)

    # Patch the methods on the instance
    gemini._emit_thinking_chunk_event = fake_emit_thinking_chunk_event.__get__(gemini)
    gemini._emit_stream_chunk_event = fake_emit_stream_chunk_event.__get__(gemini)

    # Run _process_stream_chunk with the dummy chunk
    full_response, function_calls, usage_data = gemini._process_stream_chunk(chunk, "", [], {})

    # The full_response should include the normal text part only (thought parts are emitted separately)
    assert normal_text in full_response

    # The thought text should not be in full_response (thoughts are not concatenated)
    assert thought_text not in full_response

    # The thought text should be emitted via _emit_thinking_chunk_event
    assert any(thought_text in c for c in emitted_thinking_chunks)

    # The normal text should be emitted via _emit_stream_chunk_event
    assert any(normal_text in c for c in emitted_stream_chunks)

    # Also test that _prepare_generation_config sets thinking_config with include_thoughts=True
    config = gemini._prepare_generation_config()
    assert config.thinking_config is not None
    assert config.thinking_config.include_thoughts is True


@pytest.mark.asyncio
async def test_gemini_completion_prepare_generation_config_sets_thinking_config():
    """
    Test that _prepare_generation_config sets thinking_config for thinking models automatically.
    """

    model_name = "gemini/gemini-2.5-pro"

    gemini = completion.GeminiCompletion(model=model_name)

    config = gemini._prepare_generation_config()

    assert config.thinking_config is not None
    assert config.thinking_config.include_thoughts is True


