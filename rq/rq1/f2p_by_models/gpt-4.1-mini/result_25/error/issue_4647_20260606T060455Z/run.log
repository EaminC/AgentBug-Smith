@pytest.mark.asyncio
async def test_gemini_completion_thoughts_streaming(monkeypatch):
    """
    This test verifies that when using a Gemini thinking model with streaming,
    the thought content is properly surfaced via events.

    On the buggy codebase, thought parts are discarded and not emitted,
    causing this test to fail.

    After the fix, thought parts are emitted as LLMThinkingChunkEvent,
    and this test should pass.
    """

    # Prepare a dummy chunk that simulates a streaming chunk with thought parts
    class DummyPart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

