@pytest.mark.asyncio
async def test_gemini_completion_thoughts_are_emitted(monkeypatch):
    """
    Test that GeminiCompletion with a thinking model includes thought content in streaming responses.

    This test verifies that thought chunks are emitted as events and included in the final response,
    which fails on the buggy codebase and passes after the fix.
    """

    # Prepare a dummy thinking model name that triggers thinking_config include_thoughts=True
    model_name = "gemini/gemini-3.1-pro-preview"

    # Create a GeminiCompletion instance with the thinking model
    gemini = completion.GeminiCompletion(model=model_name)

    # We will simulate a streaming call by mocking the internal client to yield a crafted response
    # that includes thought parts.

    # Define a dummy thought part and text part
    class DummyPart:
        def __init__(self, text, thought=False, function_call=False):
            self.text = text
            self.thought = thought
            self.function_call = function_call

    class DummyCandidateContent:
        def __init__(self, parts):
            self.parts = parts

    class DummyCandidate:
        def __init__(self, content):
            self.content = content

    class DummyChunk:
        def __init__(self, candidates=None, text=None, usage_metadata=None):
            self.candidates = candidates or []
            self._text = text
            self.usage_metadata = usage_metadata

        @property
        def text(self):
            # The buggy code uses this property which triggers warnings if non-text parts exist
            # We simulate that it returns concatenated text parts only
            # But in buggy code, it raises warning if non-text parts exist
            # Here we just return the text attribute for simplicity
            return self._text

    # We will patch gemini._client.chat.completions.stream to yield DummyChunk objects
    # with thought parts included

    async def dummy_stream(*args, **kwargs):
        # First chunk: contains a thought part and a text part
        thought_part = DummyPart(text="This is a thought.", thought=True)
        text_part = DummyPart(text="This is normal text.", thought=False)
        candidate_content = DummyCandidateContent(parts=[thought_part, text_part])
        candidate = DummyCandidate(content=candidate_content)
        chunk = DummyChunk(candidates=[candidate], text=None)
        yield chunk

        # Second chunk: only normal text part
        candidate_content2 = DummyCandidateContent(parts=[DummyPart(text=" More text.", thought=False)])
        candidate2 = DummyCandidate(content=candidate_content2)
        chunk2 = DummyChunk(candidates=[candidate2], text=None)
        yield chunk2

    # Patch the internal client stream method
    gemini._client.chat.completions.stream = dummy_stream

    # We will collect emitted thinking chunks by patching _emit_thinking_chunk_event
    emitted_thoughts = []

    original_emit_thinking = gemini._emit_thinking_chunk_event

    def capture_emit_thinking(chunk, *args, **kwargs):
        emitted_thoughts.append(chunk)
        return original_emit_thinking(chunk, *args, **kwargs)

    gemini._emit_thinking_chunk_event = capture_emit_thinking

    # Run the streaming call
    full_response = ""
    async for chunk in gemini.stream("Hello", stream=True):
        full_response += chunk

    # After streaming, check that the thought chunk was emitted
    # On buggy code, emitted_thoughts will be empty (test fails)
    # On fixed code, emitted_thoughts will contain the thought text

    assert len(emitted_thoughts) == 1, "Thought chunks were not emitted from GeminiCompletion"

    # Check that the emitted thought text matches expected
    assert emitted_thoughts[0] == "This is a thought.", "Emitted thought chunk text mismatch"

    # The full response should include the normal text parts concatenated
    # The thought text is not part of full_response (it is emitted separately)
    assert "This is normal text." in full_response
    assert " More text." in full_response

    # The thought text should not be in full_response (to avoid duplication)
    assert "This is a thought." not in full_response

    # The test passes if thought chunks are emitted and text parts are concatenated correctly


