            # The exit code should be non-zero because the reset failed
            assert result.returncode != 0, (
                f"Command {cmd} should fail with non-zero exit code due to memory reset failure."
            )

    finally:
        # Restore original working directory
        os.chdir(old_cwd)
        # Clean up temporary directory
