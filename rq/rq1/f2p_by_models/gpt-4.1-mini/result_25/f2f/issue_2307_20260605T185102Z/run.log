            # The command should NOT fail with "No crew found."
            assert "No crew found" not in combined_output, (
                f"Command {cmd} unexpectedly failed with 'No crew found'. Output:\n{combined_output}"
            )

            # It should fail with the expected memory system not initialized error
            assert "knowledge memory system is not initialized" in combined_output, (
                f"Command {cmd} did not report the expected memory system error. Output:\n{combined_output}"
            )

            # The exit code should be non-zero due to the RuntimeError raised in DummyCrew
            assert result.returncode != 0, (
                f"Command {cmd} unexpectedly exited with code 0. Output:\n{combined_output}"
            )

    finally:
        # Restore original working directory and clean up temp directory
        os.chdir(old_cwd)
        shutil.rmtree(temp_dir)[0m
