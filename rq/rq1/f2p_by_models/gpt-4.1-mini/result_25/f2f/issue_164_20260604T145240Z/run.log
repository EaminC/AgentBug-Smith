[32mimport os
import re
import builtins
import pytest
import mle.cli as cli_module
import mle.workflow.report as report_module
from click.testing import CliRunner


def test_cli_report_invalid_repo(monkeypatch):
    runner = CliRunner()

    # Run 'mle report' with an invalid repo argument (no slash)
    result = runner.invoke(cli_module.report, ['invalidrepo'])
    assert result.exit_code == 0
    assert "Invalid github repository" in result.output


def test_cli_report_valid_repo_no_config(monkeypatch, tmp_path):
    runner = CliRunner()

    # Setup: simulate no config file
    monkeypatch.setattr(cli_module, "check_config", lambda: False)

    # Patch ctx.invoke to record calls
    invoked = {}
    def fake_invoke(cmd, **kwargs):
        invoked['cmd'] = cmd
        invoked['kwargs'] = kwargs
        return True
    monkeypatch.setattr(cli_module, "new", lambda **kwargs: True)

    # Patch os.chdir to record directory changes
    changed_dirs = []
    monkeypatch.setattr(os, "chdir", lambda d: changed_dirs.append(d))

    # Patch workflow.report to record call arguments
    called = {}
    def fake_report(work_dir, repo, model):
        called['work_dir'] = work_dir
        called['repo'] = repo
        called['model'] = model
        return True
    monkeypatch.setattr(cli_module.workflow, "report", fake_report)

    # Run with valid repo argument
    repo_arg = "MLSysOps/MLE-agent"
    result = runner.invoke(cli_module.report, [repo_arg])
    assert result.exit_code == 0

    # It should invoke new project creation with correct project name
    assert 'cmd' in invoked
    assert invoked['kwargs']['name'] == f"mle-report-{repo_arg.replace('/', '_').lower()}"

    # It should change directory to new project folder
    expected_dir = os.path.join(os.getcwd(), invoked['kwargs']['name'])
    assert changed_dirs and changed_dirs[0] == expected_dir

    # It should call workflow.report with new project directory and repo
    assert called['work_dir'] == expected_dir
    assert called['repo'] == repo_arg


def test_cli_report_valid_repo_with_config(monkeypatch):
    runner = CliRunner()

    # Setup: simulate config present
    monkeypatch.setattr(cli_module, "check_config", lambda: True)

    # Patch workflow.report to record call arguments
    called = {}
    def fake_report(work_dir, repo, model):
        called['work_dir'] = work_dir
        called['repo'] = repo
        called['model'] = model
        return True
    monkeypatch.setattr(cli_module.workflow, "report", fake_report)

    repo_arg = "MLSysOps/MLE-agent"
    result = runner.invoke(cli_module.report, [repo_arg])
    assert result.exit_code == 0

    # It should call workflow.report with current directory and repo
    assert called['work_dir'] == os.getcwd()
    assert called['repo'] == repo_arg


def test_report_workflow_invokes_summaryagent(monkeypatch, tmp_path):
    # Prepare a dummy model loader that returns a dummy model
    monkeypatch.setattr(report_module, "load_model", lambda work_dir, model=None: "dummy_model")

    # Patch SummaryAgent to record initialization and summarize call
    class DummySummaryAgent:
        def __init__(self, model, github_repo=None, github_token=None):
            self.model = model
            self.github_repo = github_repo
            self.github_token = github_token
            self.summarize_called = False

        def summarize(self):
            self.summarize_called = True
            return {"summary": "dummy summary"}

    monkeypatch.setattr(report_module, "SummaryAgent", DummySummaryAgent)

    # Patch ask_github_token to return a dummy token
    monkeypatch.setattr(report_module, "ask_github_token", lambda: "dummy_token")

    # Patch print_in_box to just pass
    monkeypatch.setattr(report_module, "print_in_box", lambda *args, **kwargs: None)

    # Call report workflow with dummy repo and model
    result = report_module.report(str(tmp_path), "MLSysOps/MLE-agent", model=None)

    # The function returns None normally (no explicit return)
    assert result is None


def test_ask_github_token_prompts_and_writes(monkeypatch, tmp_path):
    # Setup config file path and content
    config_path = tmp_path / "config.yaml"
