    result4 = runner.invoke(cli_module.report, [])
    assert result4.exit_code == 0


def test_report_workflow_asks_github_token(monkeypatch):
    # Patch get_config to simulate no integration config
    monkeypatch.setattr(report_module, "get_config", lambda: {})

    # Patch questionary.password.ask to return a fake token
    class DummyPassword:
        def ask(self):
            return "dummy-token"

    class DummyQuestionary:
        def password(self, prompt):
            return DummyPassword()

    monkeypatch.setattr(report_module, "questionary", DummyQuestionary())

    token = report_module.ask_github_token()
    assert token == "dummy-token"

    # Patch get_config to simulate existing github token
    monkeypatch.setattr(report_module, "get_config", lambda: {"integration": {"github": {"token": "existing-token"}}})

    token2 = report_module.ask_github_token()
    assert token2 == "existing-token"


def test_report_function_runs_with_valid_repo(monkeypatch):
    # Patch load_model to dummy
    monkeypatch.setattr(report_module, "load_model", lambda work_dir, model=None: "model")

    # Patch SummaryAgent to dummy class with summarize method
    class DummySummaryAgent:
        def __init__(self, model, github_repo=None, github_token=None):
            self.model = model
            self.github_repo = github_repo
            self.github_token = github_token

        def summarize(self):
            return {"summary": "dummy"}

    monkeypatch.setattr(report_module, "SummaryAgent", DummySummaryAgent)

    # Patch ask_github_token to return dummy token
    monkeypatch.setattr(report_module, "ask_github_token", lambda: "dummy-token")

    # Patch print_in_box to capture output
    outputs = []

    def dummy_print_in_box(msg, console, title=None, color=None):
        outputs.append((msg, title, color))

    monkeypatch.setattr(report_module, "print_in_box", dummy_print_in_box)

    # Run report function with valid github_repo
    report_module.report("/fake/dir", "MLSysOps/MLE-agent", model=None)

    assert outputs
    msg, title, color = outputs[0]
    assert title == "Github Summarizer"
    assert color == "green"
    assert "summary" in msg


def test_report_function_aborts_on_empty_repo(monkeypatch):
    # Patch load_model to dummy
    monkeypatch.setattr(report_module, "load_model", lambda work_dir, model=None: "model")

    # Patch ask_text to return empty string
    monkeypatch.setattr(report_module, "ask_text", lambda prompt: "")

    # Patch print_in_box to capture output
    outputs = []

    def dummy_print_in_box(msg, console, title=None, color=None):
        outputs.append((msg, title, color))

    monkeypatch.setattr(report_module, "print_in_box", dummy_print_in_box)

    # Run report function with empty github_repo (simulate user input)
    report_module.report("/fake/dir", "", model=None)

    assert outputs
    msg, title, color = outputs[0]
    assert title == "Error"
    assert color == "red"
    assert "empty" in msg.lower()


