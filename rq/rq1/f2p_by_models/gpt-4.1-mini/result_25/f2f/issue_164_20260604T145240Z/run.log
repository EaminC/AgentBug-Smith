    result = cli_module.report.callback(ctx, repo=None, model=None)
    assert result is False
    assert any("Invalid github repository" in log for log in dummy_console.logs)

    # 2) Test with valid repo argument, config present (should call workflow.report with cwd)
    dummy_console.logs.clear()
