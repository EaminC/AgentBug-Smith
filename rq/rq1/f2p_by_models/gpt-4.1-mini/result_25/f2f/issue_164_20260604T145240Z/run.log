[32mimport os
import re
import builtins
import pytest
import mle.cli as cli_module
import mle.workflow.report as report_module


def test_report_command_local_and_github(monkeypatch, tmp_path):
    """
    Test the `mle report` CLI command behavior for local project and github repo input.

    Buggy behavior:
    - Running `mle report` without github repo argument or config leads to error or no report.
    - Running `mle report <github-url>` with invalid repo format does not error properly.
    - Running `mle report <github-url>` with valid repo but no config does not create project dir or call report properly.

    Fixed behavior:
    - Running `mle report` without argument prompts user and runs report locally.
    - Running `mle report <github-url>` with valid repo creates project dir and runs report in that dir.
    - Invalid github repo format prints error and returns False.
    """

    # Setup: patch questionary.text and password to simulate user input
    # Also patch console.log to capture logs
    logs = []
    def fake_log(msg):
        logs.append(msg)

    # Patch questionary.text to simulate user input for local report prompt
    def fake_questionary_text(prompt):
        # For local report, user inputs empty string (simulate no github repo)
        return ""

    # Patch questionary.password to simulate github token input
    def fake_questionary_password(prompt):
        return "fake-token"

    # Patch cli_module.console.log for capturing logs
    monkeypatch.setattr(cli_module, "console", type("FakeConsole", (), {"log": fake_log})())

    # Patch questionary.text and password in cli_module and report_module
    monkeypatch.setattr("questionary.text", lambda prompt: "MLSysOps/MLE-agent")
    monkeypatch.setattr("questionary.password", lambda prompt: "fake-token")

    # Patch os.chdir to track directory changes without actually changing
    changed_dirs = []
    def fake_chdir(path):
        changed_dirs.append(path)
    monkeypatch.setattr(os, "chdir", fake_chdir)

    # Patch cli_module.check_config to simulate no config initially, then config present
    config_state = {"called": 0}
    def fake_check_config():
        config_state["called"] += 1
        # First call: no config, second call: config present
        return config_state["called"] > 1
    monkeypatch.setattr(cli_module, "check_config", fake_check_config)

    # Patch cli_module.new command invoke to just record call without side effects
    invoked_new = []
    def fake_new(name):
        invoked_new.append(name)
    monkeypatch.setattr(cli_module, "new", fake_new)

    # Patch workflow.report to record calls and return True
    called_reports = []
    def fake_workflow_report(work_dir, repo=None, model=None):
        called_reports.append((work_dir, repo, model))
        return True
    monkeypatch.setattr(cli_module.workflow, "report", fake_workflow_report)
    monkeypatch.setattr(cli_module.workflow, "baseline", lambda wd, m: True)

    # Test 1: call report command with no repo argument (simulate local project)
    # It should prompt user (patched), then call workflow.report with current dir and repo
    result = cli_module.report.callback(None, None, None)
    # Because repo is None, it asks user for repo, patched to "MLSysOps/MLE-agent"
    # check that workflow.report was called with current dir and repo
    assert called_reports, "workflow.report was not called"
    work_dir, repo_arg, model_arg = called_reports[-1]
    assert os.path.isdir(work_dir) or work_dir == os.getcwd()
    assert repo_arg == "MLSysOps/MLE-agent"

    # Test 2: call report command with invalid repo argument
    # It should log error and return False
    logs.clear()
    ret = cli_module.report.callback(None, "invalidrepo", None)
    assert ret is False
    assert any("Invalid github repository" in log for log in logs)

    # Test 3: call report command with valid github repo argument and no config
    # It should invoke new project creation, change directory, and call workflow.report in new dir
    logs.clear()
    called_reports.clear()
    invoked_new.clear()
    changed_dirs.clear()
    config_state["called"] = 0  # reset to simulate no config first call

    valid_repo = "MLSysOps/MLE-agent"
    ret = cli_module.report.callback(None, valid_repo, None)
    # It should invoke new project creation with project name
    expected_project_name = f"mle-report-{valid_repo.replace('/', '_').lower()}"
    assert invoked_new and invoked_new[0] == expected_project_name
    # It should change directory to the new project dir
    assert changed_dirs and changed_dirs[0].endswith(expected_project_name)
    # It should call workflow.report with new project dir and repo
    assert called_reports and called_reports[0][0].endswith(expected_project_name)
    assert called_reports[0][1] == valid_repo
    # The command should return True (from fake_workflow_report)
    assert ret is True


def test_report_workflow_asks_github_token(monkeypatch):
    """
    Test the report workflow function asks for github token if not configured,
    and calls SummaryAgent.summarize returning expected output.
    """

    # Patch get_config to return no github integration config initially
    monkeypatch.setattr(report_module, "get_config", lambda: {})

    # Patch questionary.password to simulate github token input
    monkeypatch.setattr("questionary.password", lambda prompt: "fake-token")

    # Patch write_config to record config writes
    written_configs = []
    def fake_write_config(config):
        written_configs.append(config)
    monkeypatch.setattr(report_module, "write_config", fake_write_config)

    # Patch SummaryAgent.summarize to return dummy summary
    class DummySummaryAgent:
        def __init__(self, model, github_repo=None, github_token=None):
            self.model = model
            self.github_repo = github_repo
            self.github_token = github_token
        def summarize(self):
            return {"summary": "dummy summary"}
    monkeypatch.setattr(report_module, "SummaryAgent", DummySummaryAgent)

    # Patch load_model to dummy model
    monkeypatch.setattr(report_module, "load_model", lambda work_dir, model=None: "dummy-model")

    # Patch print_in_box to just pass
    monkeypatch.setattr(report_module, "print_in_box", lambda *args, **kwargs: None)

    # Call report workflow with dummy work_dir and github_repo
    summary = report_module.report("/tmp", "MLSysOps/MLE-agent", None)

    # It should write config with github token
    assert written_configs, "Config was not written with github token"
    assert "integration" in written_configs[0]
    assert "github" in written_configs[0]["integration"]
    assert written_configs[0]["integration"]["github"]["token"] == "fake-token"

    # The summary returned should be the dummy summary dict
    assert isinstance(summary, dict)
    assert summary.get("summary") == "dummy summary"


def test_ask_github_token_behavior(monkeypatch):
    """
    Test ask_github_token returns token from config or asks user if missing.
    """

    # Case 1: config has github token
    monkeypatch.setattr(report_module, "get_config", lambda: {"integration": {"github": {"token": "token-from-config"}}})
    monkeypatch.setattr(report_module, "write_config", lambda config: None)
    token = report_module.ask_github_token()
    assert token == "token-from-config"

    # Case 2: config missing github integration, should ask user and write config
    config_store = {}
    def fake_get_config():
        return config_store
    def fake_write_config(config):
        config_store.update(config)
    monkeypatch.setattr(report_module, "get_config", fake_get_config)
    monkeypatch.setattr(report_module, "write_config", fake_write_config)
    monkeypatch.setattr("questionary.password", lambda prompt: "asked-token")

    config_store.clear()
    token = report_module.ask_github_token()
    assert token == "asked-token"
    assert "integration" in config_store
    assert "github" in config_store["integration"]
    assert config_store["integration"]["github"]["token"] == "asked-token"[0m
