    def fake_invoke(cmd, **kwargs):
        invoked["cmd"] = cmd
        invoked["kwargs"] = kwargs
        return True

    # We need to patch the 'new' command used in ctx.invoke(new, ...)
    # The cli.py imports new from cli.py itself, so patch cli_module.new
    monkeypatch.setattr(cli_module, "new", lambda *a, **k: True)

    # Patch os.chdir to avoid changing directory in test environment
    monkeypatch.setattr(os, "chdir", lambda path: None)

    # Run `mle report` without argument: should prompt and reject invalid repo format
    result = runner.invoke(cli_module.report, [])

    # It should log an invalid github repository message and return False (exit code 0)
    assert any("Invalid github repository" in log for log in logs)
    # The command returns False, but click commands return exit_code 0 unless exception
    assert result.exit_code == 0

    # Now test with valid repo argument, check project naming and workflow.report call

    # Clear logs and invoked
    logs.clear()
    invoked.clear()

    # Patch workflow.report to record call and return True
    called = {}

    def fake_workflow_report(work_dir, repo, model):
        called["work_dir"] = work_dir
        called["repo"] = repo
        called["model"] = model
        return True

    monkeypatch.setattr(workflow_module, "report", fake_workflow_report)

    # Patch check_config to False to trigger project creation branch
    monkeypatch.setattr(cli_module, "check_config", lambda: False)

    # Run `mle report <valid_repo>`
    valid_repo = "MLSysOps/MLE-agent"
    result2 = runner.invoke(cli_module.report, [valid_repo])

    # It should invoke the new project creation and call workflow.report with correct directory and repo
    assert "cmd" not in invoked  # Because we patched new to a lambda, no ctx.invoke call recorded
    # The called workflow.report should have repo equal to valid_repo
    assert called.get("repo") == valid_repo
    # The work_dir should end with the project name mle-report-mlsysops_mle-agent
    assert called.get("work_dir", "").endswith("mle-report-mlsysops_mle-agent")
    # The command should exit with 0
    assert result2.exit_code == 0


def test_report_workflow_calls(monkeypatch):
    """
    Test the report workflow function calls SummaryAgent with github_repo and github_token.
    """

    # Patch load_model to return a dummy model object
    monkeypatch.setattr(report_module, "load_model", lambda work_dir, model=None: "dummy_model")

    # Patch SummaryAgent to record initialization and summarize call
    class DummySummaryAgent:
        def __init__(self, model, github_repo=None, github_token=None):
            self.model = model
            self.github_repo = github_repo
            self.github_token = github_token
            self.summarize_called = False

        def summarize(self):
            self.summarize_called = True
            return {"summary": "dummy summary"}

    monkeypatch.setattr(report_module, "SummaryAgent", DummySummaryAgent)

    # Patch ask_github_token to return a dummy token
    monkeypatch.setattr(report_module, "ask_github_token", lambda: "dummy_token")

    # Patch print_in_box to just pass
    monkeypatch.setattr(report_module, "print_in_box", lambda *a, **k: None)

    # Call report with dummy parameters
    work_dir = "/tmp"
    github_repo = "MLSysOps/MLE-agent"
    model = None

    result = report_module.report(work_dir, github_repo, model)

    # The DummySummaryAgent instance should have been created with correct repo and token
    # We cannot directly access the instance, but the summarize call returns a dict
    assert isinstance(result, dict) or result is None or result is True or result is False

    # Because summarize returns dict, print_in_box is called, and report returns None
    # So we check that the function completes without error


