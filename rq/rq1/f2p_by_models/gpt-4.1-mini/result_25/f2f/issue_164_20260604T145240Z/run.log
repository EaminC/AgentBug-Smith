def test_cli_report_local_and_github(monkeypatch, tmp_path):
    """
    Test the `mle report` CLI command behavior:
    1) When called with no repo argument and no config, it asks for repo and fails on invalid input.
    2) When called with a valid github repo argument and no config, it creates a new project and runs report.
    3) When called with a valid github repo argument and config present, it runs report in current dir.

    This test should fail on buggy code and pass on fixed code.
    """

    # Setup dummy context to capture invoke calls
    ctx = DummyContext()

    # Patch os.getcwd to return tmp_path
    monkeypatch.setattr(os, "getcwd", lambda: str(tmp_path))

    # Patch os.chdir to actually change directory within tmp_path
    current_dir = [str(tmp_path)]

    def fake_chdir(path):
        current_dir[0] = path

    monkeypatch.setattr(os, "chdir", fake_chdir)

    # Patch check_config to simulate no config initially, then config present
    # We will toggle this in tests
    config_state = {"has_config": False}

    def fake_check_config():
        return config_state["has_config"]

    monkeypatch.setattr(cli_module, "check_config", fake_check_config)

    # Patch questionary.text to simulate user input for repo prompt
    # First test: user inputs invalid repo string
    inputs = iter(["invalidrepo", "MLSysOps/MLE-agent"])

    def fake_questionary_text(prompt):
        return next(inputs)

    monkeypatch.setattr(cli_module.questionary, "text", fake_questionary_text)

    # Patch console.log to capture logs
    logs = []

    class DummyConsole:
        def log(self, msg):
            logs.append(msg)

    monkeypatch.setattr(cli_module, "console", DummyConsole())

    # Patch workflow.report to a dummy function that returns True
    # We want to ensure it is called with correct arguments
    called_reports = []

    def dummy_workflow_report(work_dir, repo=None, model=None):
        called_reports.append((work_dir, repo, model))
        return True

    monkeypatch.setattr(cli_module.workflow, "report", dummy_workflow_report)

    # Patch cli_module.new command to dummy function that creates directory
    def dummy_new(name):
        os.makedirs(os.path.join(str(tmp_path), name), exist_ok=True)

    monkeypatch.setattr(cli_module, "new", dummy_new)

    # 1) Call report with no repo argument and no config
    # It should ask for repo, get invalid input, log error, and return False
    config_state["has_config"] = False
    result = cli_module.report.callback(ctx)
    assert result is False
    assert any("Invalid github repository" in log for log in logs)

    # 2) Call report with valid github repo argument and no config
    # It should create new project, chdir, and call workflow.report with new dir
    logs.clear()
    called_reports.clear()
    config_state["has_config"] = False
    repo_arg = "MLSysOps/MLE-agent"
    # call with repo argument
    result = cli_module.report.callback(ctx, repo=repo_arg, model=None)
    assert result is True
    # It should have invoked new command
    assert any(cmd[0].__name__ == "new" for cmd in ctx.invoked_commands)
    # It should have changed directory to new project folder
    expected_dir = os.path.join(str(tmp_path), f"mle-report-mlsysops_mle-agent")
    assert current_dir[0] == expected_dir
    # workflow.report should be called with new project dir and repo arg
    assert called_reports
    work_dir, repo, model = called_reports[0]
    assert work_dir == expected_dir
    assert repo == repo_arg

    # 3) Call report with valid github repo argument and config present
    # It should call workflow.report in current dir without changing directory
    logs.clear()
    called_reports.clear()
    config_state["has_config"] = True
    current_dir[0] = str(tmp_path)
    result = cli_module.report.callback(ctx, repo=repo_arg, model=None)
    assert result is True
    # workflow.report should be called with current dir and repo arg
    assert called_reports
    work_dir, repo, model = called_reports[0]
    assert work_dir == str(tmp_path)
    assert repo == repo_arg


