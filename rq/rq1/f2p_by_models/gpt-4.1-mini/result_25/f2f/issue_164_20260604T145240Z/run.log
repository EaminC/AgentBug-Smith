    # Setup a dummy context object with invoke method to capture calls to `new` command
    class DummyContext:
        def __init__(self):
            self.invoked_new = False
            self.new_name = None

        def invoke(self, cmd, **kwargs):
            # We expect new to be invoked with name=project_name
            if cmd.__name__ == "new":
                self.invoked_new = True
                self.new_name = kwargs.get("name")
