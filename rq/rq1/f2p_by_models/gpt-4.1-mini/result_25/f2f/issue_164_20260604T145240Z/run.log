def test_cli_report_local_and_github(monkeypatch, tmp_path):
    """
    Test the `mle report` CLI command behavior:
    - When called with no repo argument, it should prompt user for repo.
    - When called with invalid repo format, it should fail with console log.
    - When called with valid github repo string, it should create a new project directory
      and call workflow.report with correct parameters.
    """

    runner = CliRunner()
    ctx = DummyContext()

    # Patch check_config to simulate no config initially
    monkeypatch.setattr(cli_module, "check_config", lambda: False)

    # Patch questionary.text to simulate user input for repo prompt
    monkeypatch.setattr("questionary.text", lambda *a, **kw: type("Ans", (), {"ask": lambda self: "MLSysOps/MLE-agent"})())

    # Patch console.log to capture logs
    logs = []
    monkeypatch.setattr(cli_module.console, "log", lambda msg: logs.append(msg))

    # Patch os.chdir to track directory changes
    changed_dirs = []

    def fake_chdir(path):
        changed_dirs.append(path)

    monkeypatch.setattr(os, "chdir", fake_chdir)

    # Patch workflow.report to a dummy function that records call args and returns True
    called_args = {}

    def dummy_report(work_dir, repo, model):
        called_args["work_dir"] = work_dir
        called_args["repo"] = repo
        called_args["model"] = model
        return True

    monkeypatch.setattr(cli_module.workflow, "report", dummy_report)

    # Run the CLI command with no repo argument (should prompt)
    result = runner.invoke(cli_module.cli, ["report"], obj=ctx)

    # It should have invoked new project creation with correct project name
    assert any(cmd == cli_module.new for cmd, _ in ctx.invoked_commands)
    # The new project directory should be created and chdir called to it
    expected_project_name = "mle-report-mlsysops_mle-agent"
    assert expected_project_name in changed_dirs
    # workflow.report should be called with that directory and repo string
    assert called_args.get("work_dir") == os.path.join(os.getcwd(), expected_project_name)
    assert called_args.get("repo") == "MLSysOps/MLE-agent"
    # The CLI command should return True (success)
    assert result.exit_code == 0
    assert result.output == "" or isinstance(result.output, str)

    # Now test invalid repo format: simulate questionary.text returning invalid repo string
    monkeypatch.setattr("questionary.text", lambda *a, **kw: type("Ans", (), {"ask": lambda self: "invalidrepo"})())
    logs.clear()
    ctx.invoked_commands.clear()
    changed_dirs.clear()
    called_args.clear()

    result = runner.invoke(cli_module.cli, ["report"], obj=ctx)
    # It should log an invalid repo message and return False
    assert any("Invalid github repository" in msg for msg in logs)
    assert result.exit_code == 0  # click commands returning False exit with 0, so check output
    # No new project created or chdir called
    assert not ctx.invoked_commands
    assert not changed_dirs
    assert not called_args

    # Now test with repo argument passed directly, with config check True (simulate config present)
    monkeypatch.setattr(cli_module, "check_config", lambda: True)
    ctx.invoked_commands.clear()
    changed_dirs.clear()
    called_args.clear()

    # Patch workflow.report again to record call
    monkeypatch.setattr(cli_module.workflow, "report", dummy_report)

    result = runner.invoke(cli_module.cli, ["report", "MLSysOps/MLE-agent"], obj=ctx)
    # It should call workflow.report with current working directory and repo argument
    assert called_args.get("work_dir") == os.getcwd()
    assert called_args.get("repo") == "MLSysOps/MLE-agent"
    # No new project creation or chdir
    assert not ctx.invoked_commands
    assert not changed_dirs
    # Exit code success
    assert result.exit_code == 0


def test_report_workflow_calls(monkeypatch, tmp_path):
    """
    Test the report workflow function calls SummaryAgent.summarize and prints output.
    """

    # Patch load_model to return dummy model object
    monkeypatch.setattr(report_module, "load_model", lambda work_dir, model=None: "dummy_model")

    # Patch ask_github_token to return a dummy token
    monkeypatch.setattr(report_module, "ask_github_token", lambda: "dummy_token")

    # Patch SummaryAgent to a dummy class that records init args and returns fixed summary
    class DummySummaryAgent:
        def __init__(self, model, github_repo=None, github_token=None):
            self.model = model
            self.github_repo = github_repo
            self.github_token = github_token

        def summarize(self):
            return {"summary": "dummy summary"}

    monkeypatch.setattr(report_module, "SummaryAgent", DummySummaryAgent)

    # Patch print_in_box to record printed content
    printed = {}

    def dummy_print_in_box(content, console, title=None, color=None):
        printed["content"] = content
        printed["title"] = title
        printed["color"] = color

    monkeypatch.setattr(report_module, "print_in_box", dummy_print_in_box)

    # Call report function with dummy work_dir and github_repo
    ret = report_module.report(str(tmp_path), "MLSysOps/MLE-agent", model=None)

    # It should call SummaryAgent.summarize and print the summary json
    assert ret is None or ret is None  # report returns None normally
    assert "summary" in printed.get("content", "")
    assert printed.get("title") == "Github Summarizer"
    assert printed.get("color") == "green"[0m
