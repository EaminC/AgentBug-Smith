    # Patch get_config to return empty config initially
    monkeypatch.setattr(report_module, "get_config", lambda: config_data)

    # Patch write_config to update config_data
    def fake_write_config(new_config):
        config_data.clear()
        config_data.update(new_config)
    monkeypatch.setattr(report_module, "write_config", fake_write_config)

    # Patch questionary.password to simulate user input token
    monkeypatch.setattr(report_module.questionary, "password", lambda *args, **kwargs: type("A", (), {"ask": lambda self: "token123"})())

    token = report_module.ask_github_token()
    assert token == "token123"
    assert "integration" in config_data
    assert "github" in config_data["integration"]
    assert config_data["integration"]["github"]["token"] == "token123"


