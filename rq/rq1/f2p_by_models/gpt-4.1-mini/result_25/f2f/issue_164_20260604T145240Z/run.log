    ret = report_module.report("/tmp", "MLSysOps/MLE-agent", model=None)

    # It should print the summary box with JSON string of summary
    assert "content" in printed
    assert printed["title"] == "Github Summarizer"
    assert printed["color"] == "green"
    assert '"summary": "dummy_summary"' in printed["content"]

