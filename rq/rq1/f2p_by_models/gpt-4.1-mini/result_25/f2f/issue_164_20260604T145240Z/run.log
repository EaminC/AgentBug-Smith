def test_report_command_local_and_github(monkeypatch):
    """
    Test the `mle report` CLI command behavior:
    1. Running `mle report` without repo argument prompts user for GitHub repo,
       and rejects invalid repo format.
    2. Running `mle report <github_repo>` triggers report workflow with correct project naming.
    """

    runner = CliRunner()

    # Patch questionary.text to simulate user input for repo prompt
    def fake_text_prompt(*args, **kwargs):
        return "invalid-repo-format"  # invalid format to test validation

    monkeypatch.setattr("questionary.text", fake_text_prompt)

    # Patch console.log to capture logs
    logs = []

    class DummyConsole:
        def log(self, msg):
            logs.append(msg)

    monkeypatch.setattr(cli_module, "console", DummyConsole())

    # Patch check_config to always return False to test project creation branch
    monkeypatch.setattr(cli_module, "check_config", lambda: False)

    # Patch ctx.invoke to record invocation instead of real call
    invoked = {}

    def fake_invoke(cmd, **kwargs):
        invoked["cmd"] = cmd
        invoked["kwargs"] = kwargs

    # Run `mle report` without argument: should prompt and reject invalid repo format
    result = runner.invoke(cli_module.report, [])
    assert result.exit_code == 0
    assert any("Invalid github repository" in log for log in logs)
    assert result.output == "" or result.output is not None

    # Now test valid github repo argument triggers project creation and workflow.report call
    valid_repo = "MLSysOps/MLE-agent"

    # Patch check_config to False to test new project creation branch
    monkeypatch.setattr(cli_module, "check_config", lambda: False)

    # Patch ctx.invoke to track call to new project creation
    invoked.clear()

    # Patch workflow.report to track call and simulate success
    called = {}

    def fake_workflow_report(work_dir, repo, model):
        called["work_dir"] = work_dir
        called["repo"] = repo
        called["model"] = model
        return True

    monkeypatch.setattr(workflow_module, "report", fake_workflow_report)

    # Patch os.chdir to track directory change
    changed_dirs = []

    def fake_chdir(path):
        changed_dirs.append(path)

    monkeypatch.setattr(os, "chdir", fake_chdir)

    # Patch ctx.invoke to fake new project creation command
    def fake_ctx_invoke(cmd, **kwargs):
        invoked["cmd"] = cmd
        invoked["kwargs"] = kwargs

    # Run `mle report <valid_repo>`
    result = runner.invoke(cli_module.report, [valid_repo], obj=None, catch_exceptions=False, standalone_mode=False)
    # We expect True returned from fake_workflow_report, so result.exit_code should be 0
    assert result.exit_code == 0
    # Check that new project creation was invoked
    assert "cmd" in invoked
    # Check that directory was changed to the new project directory
    expected_project_name = f"mle-report-{valid_repo.replace('/', '_').lower()}"
    assert changed_dirs and changed_dirs[0].endswith(expected_project_name)
    # Check that workflow.report was called with correct repo argument
    assert called.get("repo") == valid_repo
    assert called.get("work_dir").endswith(expected_project_name)

    # Now test check_config True branch: no new project creation, direct call to workflow.report
    monkeypatch.setattr(cli_module, "check_config", lambda: True)
    called.clear()
    changed_dirs.clear()

    result = runner.invoke(cli_module.report, [valid_repo], obj=None, catch_exceptions=False, standalone_mode=False)
    assert result.exit_code == 0
    # workflow.report should be called with current working directory and repo
    assert called.get("repo") == valid_repo
    assert called.get("work_dir") == os.getcwd()
    # No directory change expected
    assert not changed_dirs


