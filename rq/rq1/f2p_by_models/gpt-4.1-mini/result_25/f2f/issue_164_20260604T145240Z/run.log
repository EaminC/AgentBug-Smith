    def fake_check_config_true():
        return True

    def fake_check_config_false():
        return False

    def fake_questionary_text(prompt):
        # Simulate user entering empty repo string to test invalid input path
        return ""

    def fake_questionary_text_valid(prompt):
        # Simulate user entering valid repo string
        return "MLSysOps/MLE-agent"

    class DummyConsole:
        def __init__(self):
            self.logs = []

        def log(self, msg):
            self.logs.append(msg)

    dummy_console = DummyConsole()

    def fake_workflow_report(work_dir, repo, model):
        called_reports.append((work_dir, repo, model))
        return True

    # Patch objects in cli_module
    monkeypatch.setattr(cli_module, "check_config", fake_check_config_true)
    monkeypatch.setattr(cli_module, "console", dummy_console)
    monkeypatch.setattr(cli_module.workflow, "report", fake_workflow_report)

    # 1) Test with no repo argument and user inputs empty repo (should log invalid and return False)
    monkeypatch.setattr(cli_module.questionary, "text", fake_questionary_text)
