[32mimport os
import re
import pytest
import tempfile
import shutil

import mle.cli as cli_module
import mle.workflow.report as report_module
import mle.workflow as workflow_module


def test_report_command_behavior(monkeypatch):
    """
    Test the `mle report` CLI command behavior for local project and github repo argument.
    This test covers:
    - Running `mle report` without repo argument prompts for repo and validates input.
    - Running `mle report <github-repo>` creates a new project directory and calls workflow.report with correct args.
    """

    # Patch console.log to capture logs
    logs = []
    monkeypatch.setattr(cli_module.console, "log", lambda msg: logs.append(msg))

    # Patch questionary.text to simulate user input for repo prompt
    # First test: no repo argument, prompt returns invalid repo string
    monkeypatch.setattr("questionary.text", lambda *a, **kw: type("Ans", (), {"ask": lambda s: "invalidrepo"})())

    # Patch check_config to always return False to simulate no config
    monkeypatch.setattr(cli_module, "check_config", lambda: False)

    # Patch ctx.invoke to record invocation of 'new' command
    invoked = {}
    def fake_invoke(cmd, **kwargs):
        invoked["cmd"] = cmd
        invoked["kwargs"] = kwargs
    monkeypatch.setattr("click.Context.invoke", fake_invoke)

    # Patch workflow.report to record call arguments
    called_workflow_report = {}
    def fake_workflow_report(work_dir, repo, model):
        called_workflow_report["work_dir"] = work_dir
        called_workflow_report["repo"] = repo
        called_workflow_report["model"] = model
        return True
    monkeypatch.setattr(workflow_module, "report", fake_workflow_report)

    # Create a temporary directory to simulate cwd
    with tempfile.TemporaryDirectory() as tmpdir:
        old_cwd = os.getcwd()
        os.chdir(tmpdir)
        try:
            # Call report command with no repo argument (should prompt)
            result = cli_module.report.callback(None, None)
            # It should log invalid repo message and return False
            assert result is False
            assert any("Invalid github repository" in log for log in logs)

            # Clear logs and invoked for next test
            logs.clear()
            invoked.clear()
            called_workflow_report.clear()

            # Now test with valid github repo argument
            valid_repo = "MLSysOps/MLE-agent"

            # Patch check_config to False to simulate no config, so new project created
            monkeypatch.setattr(cli_module, "check_config", lambda: False)

            # Call report command with valid repo argument
            # We must create a dummy click.Context to pass as ctx
            class DummyCtx:
                def invoke(self, cmd, **kwargs):
                    invoked["cmd"] = cmd
                    invoked["kwargs"] = kwargs

            ctx = DummyCtx()

            # Call the command function directly with ctx, repo, model
            ret = cli_module.report.callback(ctx, valid_repo, None)

            # It should invoke 'new' command with project_name
            assert "cmd" in invoked
            assert invoked["kwargs"].get("name") == f"mle-report-{valid_repo.replace('/', '_').lower()}"

            # It should call workflow.report with new project directory and repo
            expected_dir = os.path.join(tmpdir, f"mle-report-{valid_repo.replace('/', '_').lower()}")
            assert called_workflow_report.get("work_dir") == expected_dir
            assert called_workflow_report.get("repo") == valid_repo
            assert ret is True

        finally:
            os.chdir(old_cwd)


