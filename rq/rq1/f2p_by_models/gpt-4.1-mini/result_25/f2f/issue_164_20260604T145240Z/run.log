    def __init__(self):
        self.invoked_commands = []

    def invoke(self, cmd, **kwargs):
        self.invoked_commands.append((cmd, kwargs))
        # simulate creating a directory for new project
        if cmd.__name__ == "new" and "name" in kwargs:
