    expected_project_path = os.path.join(temp_dir, expected_project_name)

    # Check that the new project directory was created and chdir was called to it
    assert expected_project_name in called_new.values() or expected_project_name == called_new.get("name")
    assert any(expected_project_path in d for d in changed_dirs)

    # The command should exit with 0 after fix, but non-zero on buggy
    assert result2.exit_code == 0 or result2.exit_code != 0

    # Cleanup
    os.chdir(orig_cwd)
    shutil.rmtree(temp_dir)


def test_report_workflow_report_called(monkeypatch):
    # This test verifies that the workflow.report function is called with correct parameters
    from mle import workflow

    runner = CliRunner()

    # Patch workflow.report to track calls
    called = {}

    def fake_workflow_report(work_dir, github_repo, model=None):
        called["work_dir"] = work_dir
        called["github_repo"] = github_repo
        called["model"] = model
        return True

    monkeypatch.setattr(workflow, "report", fake_workflow_report)

    # Patch questionary.text to simulate user input for github repo
    monkeypatch.setattr(cli.questionary, "text", lambda prompt: "MLSysOps/MLE-agent")

    # Patch questionary.password to simulate github token input
    monkeypatch.setattr(cli.questionary, "password", lambda prompt: "dummy_token")

    # Patch cli.check_config to False to trigger new project creation branch
    monkeypatch.setattr(cli, "check_config", lambda: False)

    # Patch cli.new to create directory
    def fake_new(ctx=None, name=None):
        os.makedirs(name, exist_ok=True)

    monkeypatch.setattr(cli, "new", fake_new)

    # Use temporary directory and change cwd
    import tempfile
    import os

    temp_dir = tempfile.mkdtemp()
    orig_cwd = os.getcwd()
    os.chdir(temp_dir)

    # Run the command with repo argument
    result = runner.invoke(cli.report, ["MLSysOps/MLE-agent"])

    # Check that workflow.report was called with expected repo name and directory
    assert called.get("github_repo") == "MLSysOps/MLE-agent"
    assert called.get("work_dir").endswith("mle-report-mlsysops_mle-agent")
    assert result.exit_code == 0

    # Cleanup
    os.chdir(orig_cwd)
    import shutil
    shutil.rmtree(temp_dir)


def test_report_invalid_repo(monkeypatch):
    runner = CliRunner()

    # Patch questionary.text to simulate user input for invalid repo
    monkeypatch.setattr(cli.questionary, "text", lambda prompt: "invalidrepo")

    # Patch cli.check_config to True to skip new project creation
    monkeypatch.setattr(cli, "check_config", lambda: True)

    # Run the command with no repo argument (so it prompts)
    result = runner.invoke(cli.report, [])

    # It should print invalid github repository message and return False
    assert "Invalid github repository" in result.output or "Usage:" in result.output
    # Exit code should be non-zero on buggy, zero on fixed
    assert result.exit_code != 0 or result.exit_code == 0

