def test_cli_report_local_and_github(monkeypatch):
    """
    Test the 'mle report' CLI command behavior:
    - When called with no repo argument and no config, it should prompt for repo and fail on invalid input.
    - When called with a valid github repo argument, it should create a new project directory and call workflow.report.
    """

    # Setup a temporary directory to simulate cwd and projects
    tmpdir = tempfile.mkdtemp()
    orig_cwd = os.getcwd()
    os.chdir(tmpdir)

    ctx = DummyContext()

