def test_report_command_local_and_github(monkeypatch):
    runner = CliRunner()

    # Patch questionary.text to simulate user input for local report prompt
    def fake_text(prompt):
        # For the first call, simulate user entering empty string (local project)
        return None

    # Patch questionary.password to simulate github token input
    def fake_password(prompt):
        return "dummy_github_token"

    # Patch re.match to simulate github repo validation
    import re as real_re

    # We will test two scenarios:
    # 1) mle report with no argument -> asks for github repo -> invalid input -> returns False
    # 2) mle report with github repo argument -> runs workflow.report with correct args

    # Scenario 1: no argument, user inputs invalid repo string -> should return False
    monkeypatch.setattr("questionary.text", lambda prompt: "invalidrepo")
    monkeypatch.setattr("mle.cli.re.match", real_re.match)
    result = runner.invoke(cli_module.report, [])
    # The command should return False (exit code 0 but output contains error log)
    assert result.exit_code == 0
    assert "Invalid github repository" in result.output

    # Scenario 2: with valid github repo argument
    dummy_ctx = DummyContext()

    # Patch cli_module.check_config to False to simulate no config
    monkeypatch.setattr(cli_module, "check_config", lambda: False)

    # Patch cli_module.workflow.report to a dummy function that returns True
    monkeypatch.setattr(cli_module.workflow, "report", lambda work_dir, repo, model: True)

    # Patch cli_module.new command to dummy function that creates directory
    def dummy_new(name):
        os.makedirs(name, exist_ok=True)

    monkeypatch.setattr(cli_module, "new", dummy_new)

    # Run with valid github repo argument
    valid_repo = "MLSysOps/MLE-agent"
    result2 = runner.invoke(cli_module.report, [valid_repo], obj=dummy_ctx)

    # It should return True from workflow.report
    assert result2.exit_code == 0
    assert result2.output == ""

    # The dummy_ctx should have invoked new command with correct project name
    expected_project_name = f"mle-report-{valid_repo.replace('/', '_').lower()}"
    invoked_names = [kwargs.get("name") for cmd, kwargs in dummy_ctx.invoked if "name" in kwargs]
    assert expected_project_name in invoked_names

    # Scenario 3: with config check True (simulate existing config)
    monkeypatch.setattr(cli_module, "check_config", lambda: True)

    # Patch workflow.report to check if called with current directory and repo
    called_args = {}

    def fake_report(work_dir, repo, model):
        called_args["work_dir"] = work_dir
        called_args["repo"] = repo
        called_args["model"] = model
        return True

    monkeypatch.setattr(cli_module.workflow, "report", fake_report)

    result3 = runner.invoke(cli_module.report, [valid_repo])

    assert result3.exit_code == 0
    assert called_args["repo"] == valid_repo
    assert called_args["work_dir"] == os.getcwd()


