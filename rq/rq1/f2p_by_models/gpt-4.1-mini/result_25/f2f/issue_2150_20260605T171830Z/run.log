[32mimport pytest
from crewai import Agent, Task, Crew, Process, LLM
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource

def test_agent_with_knowledge_source_no_api_status_error():
    """
    This test reproduces the bug described in issue #2150:
    APIStatusError.__init__() missing 2 required keyword-only arguments: 'response' and 'body'

    The test runs the example from the documentation that uses a StringKnowledgeSource,
    an Agent, a Task, and a Crew with knowledge sources enabled.

    The test expects no exception related to APIStatusError or missing arguments,
    and expects the crew kickoff to complete successfully and produce an answer
    containing the expected information about John's city and age.

    On the buggy codebase, this test should fail with an error about missing arguments.
    After applying the fix, this test should pass without error.
    """

    # Create a knowledge source with user info
    content = "Users name is John. He is 30 years old and lives in San Francisco."
    string_source = StringKnowledgeSource(content=content)

    # Create an LLM with temperature 0 for deterministic output
    llm = LLM(model="gpt-4o-mini", temperature=0)

    # Create an agent with the knowledge store
    agent = Agent(
        role="About User",
        goal="You know everything about the user.",
        backstory="You are a master at understanding people and their preferences.",
        verbose=True,
        allow_delegation=False,
        llm=llm,
    )

    # Create a task for the agent
    task = Task(
        description="Answer the following questions about the user: {question}",
        expected_output="An answer to the question.",
        agent=agent,
    )

    # Create a crew with the agent, task, and knowledge source enabled
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=True,
        process=Process.sequential,
        knowledge_sources=[string_source],
    )

    # Run the crew kickoff with a question about John
    result = crew.kickoff(inputs={"question": "What city does John live in and how old is he?"})

    # The result should be a dict containing the task output
    assert isinstance(result, dict), "Result should be a dict"

    # The task description is the key for the output in the result
    output = result.get(task.description)
    assert output is not None, "Output for the task should be present in the result"

    # The output should contain the city and age info from the knowledge source
    output_lower = output.lower()
    assert "san francisco" in output_lower, "Output should mention 'San Francisco'"
    assert "30" in output_lower, "Output should mention age '30'"

    # No exceptions related to APIStatusError or missing arguments should be raised
    # This is implicitly tested by the test completing successfully


# The test runner will discover and run this test.
# On the buggy codebase, this test should fail with the described error.
# After the fix, this test should pass.[0m
