[32mimport pytest
from crewai import Agent, Task, Crew, Process, LLM
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource


def test_agent_with_knowledge_source_no_api_status_error():
    """
    This test reproduces the scenario described in issue #2150 where
    using a knowledge source with an Agent and Crew caused an APIStatusError
    due to missing required keyword-only arguments in the exception.

    The test will fail on the buggy codebase with an error like:
    APIStatusError.__init__() missing 2 required keyword-only arguments: 'response' and 'body'

    After applying the fix, the test should pass without raising that error.
    """

    # Create a knowledge source with some user info content
    content = "Users name is John. He is 30 years old and lives in San Francisco."
    string_source = StringKnowledgeSource(content=content)

    # Create an LLM with temperature 0 for deterministic output
    llm = LLM(model="gpt-4o-mini", temperature=0)

    # Create an agent with the knowledge store enabled
    agent = Agent(
        role="About User",
        goal="You know everything about the user.",
        backstory="You are a master at understanding people and their preferences.",
        verbose=True,
        allow_delegation=False,
        llm=llm,
    )

    # Create a task for the agent
    task = Task(
        description="Answer the following questions about the user: {question}",
        expected_output="An answer to the question.",
        agent=agent,
    )

    # Create a crew with the agent, task, and knowledge source
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=True,
        process=Process.sequential,
        knowledge_sources=[string_source],  # Enable knowledge source here
    )

    # Kickoff the crew with a question input
    result = crew.kickoff(inputs={"question": "What city does John live in and how old is he?"})

    # Assert that the result contains an answer string (non-empty)
    # This ensures the process completed successfully without raising the APIStatusError
    assert result is not None
    assert isinstance(result, dict)
    # The task description is the key in the result dictionary for the output
    # We check that the output answer is a non-empty string
    output_values = list(result.values())
    assert len(output_values) > 0
    answer = output_values[0]
    assert isinstance(answer, str)
    assert len(answer.strip()) > 0
    # Optionally check that the answer mentions the city and age
    assert "San Francisco" in answer or "san francisco" in answer.lower()
    assert "30" in answer or "thirty" in answer.lower() or "years old" in answer.lower()[0m
