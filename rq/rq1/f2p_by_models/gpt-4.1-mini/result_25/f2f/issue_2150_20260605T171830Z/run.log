[32mimport pytest
from crewai import Agent, Task, Crew, Process, LLM
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource


def test_agent_with_knowledge_source_no_api_status_error():
    """
    This test reproduces the bug described in issue #2150 where
    APIStatusError.__init__() was missing required keyword-only arguments.

    The test creates a StringKnowledgeSource, an LLM, an Agent, a Task,
    and a Crew with knowledge sources enabled, then runs kickoff with a question.

    The test expects no exceptions related to missing arguments in APIStatusError.
    It asserts that the result contains a non-empty answer string.

    On the buggy codebase, this test should fail with a TypeError or similar.
    After the fix, this test should pass without error.
    """

    content = "Users name is John. He is 30 years old and lives in San Francisco."
    string_source = StringKnowledgeSource(content=content)

    # Use a deterministic LLM model with temperature=0
    llm = LLM(model="gpt-4o-mini", temperature=0)

    agent = Agent(
        role="About User",
        goal="You know everything about the user.",
        backstory="You are a master at understanding people and their preferences.",
        verbose=True,
        allow_delegation=False,
        llm=llm,
    )

    task = Task(
        description="Answer the following questions about the user: {question}",
        expected_output="An answer to the question.",
        agent=agent,
    )

    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=True,
        process=Process.sequential,
        knowledge_sources=[string_source],
    )

    # Run kickoff with a question input
    result = crew.kickoff(inputs={"question": "What city does John live in and how old is he?"})

    # Assert that result is a dict and contains the expected answer string
    assert isinstance(result, dict), "Result should be a dictionary"
    # The task key is the description string uppercased, but to be safe check any string value
    found_answer = False
    for v in result.values():
        if isinstance(v, str) and "san francisco" in v.lower() and "30" in v:
            found_answer = True
            break
    assert found_answer, "The answer should mention San Francisco and age 30"


# Note: This test does not mock the LLM calls, so it requires valid environment or
# will raise authentication errors unrelated to the bug.
# The bug fix ensures no missing arguments error occurs during knowledge upsert.[0m
