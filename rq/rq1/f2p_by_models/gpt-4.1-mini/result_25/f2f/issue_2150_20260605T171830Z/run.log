[32mimport pytest
from crewai import Agent, Task, Crew, Process, LLM
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource


def test_agent_with_knowledge_source_no_api_status_error():
    """
    This test reproduces the scenario described in issue #2150 where using a StringKnowledgeSource
    with an Agent and Crew caused an APIStatusError due to missing arguments in the exception.

    The test will fail on the buggy codebase with an error about missing keyword-only arguments
    'response' and 'body' in APIStatusError.__init__.

    After applying the fix, the test should pass without such an error.
    """

    # Create a knowledge source with sample content
    content = "Users name is John. He is 30 years old and lives in San Francisco."
    string_source = StringKnowledgeSource(content=content)

    # Create an LLM with temperature=0 for deterministic output
    llm = LLM(model="gpt-4o-mini", temperature=0)

    # Create an agent with the knowledge source
    agent = Agent(
        role="About User",
        goal="You know everything about the user.",
        backstory="You are a master at understanding people and their preferences.",
        verbose=True,
        allow_delegation=False,
        llm=llm,
    )

    # Create a task that queries the knowledge source
    task = Task(
        description="Answer the following questions about the user: {question}",
        expected_output="An answer to the question.",
        agent=agent,
    )

    # Create a crew with the agent, task, and knowledge source
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=True,
        process=Process.sequential,
        knowledge_sources=[string_source],
    )

    # Run the crew kickoff with a question input
    result = crew.kickoff(inputs={"question": "What city does John live in and how old is he?"})

    # Assert that the result contains a non-empty answer string
    # This ensures the knowledge source was used and no exception was raised
    assert result is not None
    assert isinstance(result, dict)
    # The task output key is the task description by default, so check for that key
    task_output_key = task.description
    assert task_output_key in result
    answer = result[task_output_key]
    assert isinstance(answer, str)
    assert "San Francisco" in answer or "30" in answer or "John" in answer

    # No exception should be raised during kickoff; if buggy, an error about APIStatusError init missing args occurs
    # This test relies on that behavior to fail on buggy code and pass on fixed code.[0m
