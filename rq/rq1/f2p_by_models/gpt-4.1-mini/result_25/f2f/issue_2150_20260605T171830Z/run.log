[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV GITHUB_TOKEN="ghp_key"
ENV HF_TOKEN="hf_key"
# --- end inject ---

# Set standard working directory
WORKDIR /app

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Copy entire repository
COPY . .

# Determine if src/ directory or src imports exist (conditional src/ layout)
RUN set -eux; \
    if [ -d "src" ] || grep -Rq '^\s*from src\.|^\s*import src\.' . 2>/dev/null; then \
        export PYTHONPATH=/app; \
        python -m pip install --upgrade pip setuptools wheel; \
        if [ -f "requirements.txt" ]; then \
            pip install -r requirements.txt; \
        elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
            pip install poetry; \
            poetry config virtualenvs.create false; \
            poetry install --no-interaction --no-ansi; \
        elif [ -f "pyproject.toml" ]; then \
            pip install -e .; \
        fi; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
        python -m pip install --upgrade pip setuptools wheel; \
        if [ -f "requirements.txt" ]; then \
            pip install -r requirements.txt && pip install -e .; \
        elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
            pip install poetry; \
            poetry config virtualenvs.create false; \
            poetry install --no-interaction --no-ansi && pip install -e .; \
        elif [ -f "pyproject.toml" ]; then \
            pip install -e .; \
        fi; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Preflight import check to fail fast if modules missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set PYTHONPATH if src/ layout detected, else unset
RUN if [ -d "src" ] || grep -Rq '^\s*from src\.|^\s*import src\.' . 2>/dev/null; then echo "Setting PYTHONPATH=/app"; else echo "No src/ layout detected"; fi
ENV PYTHONPATH=/app

# Final command as inferred from pyproject.toml scripts and repo structure:
# The main entrypoint python script is src/my_project/main.py
CMD ["python", "src/my_project/main.py"][0m
