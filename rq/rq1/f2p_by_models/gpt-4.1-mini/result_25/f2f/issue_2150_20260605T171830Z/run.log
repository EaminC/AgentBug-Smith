[32mimport pytest
from crewai import Agent, Task, Crew, Process, LLM
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource


def test_agent_with_knowledge_source_no_api_status_error():
    """
    This test reproduces the scenario from issue #2150 where using a knowledge source with an Agent
    caused an APIStatusError due to missing required arguments in the exception constructor.

    The test creates a simple knowledge source with user info, sets up an LLM with deterministic output,
    creates an Agent with that knowledge source, and runs a Crew kickoff with a question about the user.

    The expected behavior is that no exception related to APIStatusError.__init__ missing arguments is raised,
    and the Crew kickoff completes with a result containing an answer string including the city and age.

    On the buggy codebase, this test should fail with a TypeError or similar due to the exception constructor.
    After applying the fix, this test should pass.
    """

    content = "Users name is John. He is 30 years old and lives in San Francisco."
    string_source = StringKnowledgeSource(content=content)

    llm = LLM(model="gpt-4o-mini", temperature=0)

    agent = Agent(
        role="About User",
        goal="You know everything about the user.",
        backstory="You are a master at understanding people and their preferences.",
        verbose=False,
        allow_delegation=False,
        llm=llm,
    )

    task = Task(
        description="Answer the following questions about the user: {question}",
        expected_output="An answer to the question.",
        agent=agent,
    )

    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=False,
        process=Process.sequential,
        knowledge_sources=[string_source],
    )

    # Run the crew kickoff with a question about the user
    result = crew.kickoff(inputs={"question": "What city does John live in and how old is he?"})

    # The result should be a dict with keys for each task, containing an answer string
    assert isinstance(result, dict), "Result should be a dictionary"
    assert len(result) == 1, "There should be one task result"
    answer = next(iter(result.values()))
    assert isinstance(answer, str), "Answer should be a string"
    assert "San Francisco" in answer or "30" in answer, "Answer should mention city or age"
    assert "John" in answer or "user" in answer.lower(), "Answer should relate to the user"

    # No exceptions should be raised during kickoff


# Note: This test requires network access or valid API keys if real LLM calls are made.
# If the environment does not have valid API keys, the test may fail due to authentication errors,
# but it should not fail due to the APIStatusError constructor missing arguments bug.[0m
