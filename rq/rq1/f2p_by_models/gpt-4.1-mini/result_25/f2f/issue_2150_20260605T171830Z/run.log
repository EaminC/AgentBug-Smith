[32mimport pytest
import os
from crewai import Agent, Task, Crew, Process, LLM
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource

def test_agent_with_knowledge_source_no_api_status_error():
    """
    This test reproduces the bug described in issue #2150:
    APIStatusError.__init__() missing 2 required keyword-only arguments: 'response' and 'body'

    The test creates a StringKnowledgeSource, an LLM, an Agent, a Task, and a Crew with knowledge sources,
    then runs kickoff with a question input.

    The buggy code raises an error during knowledge upsert due to missing arguments in APIStatusError.
    The fix removes the buggy call and properly sets knowledge with embedder.

    This test should fail (non-zero exit) on the buggy codebase and pass (exit 0) after applying the fix.
    """

    # Prepare knowledge source content
    content = "Users name is John. He is 30 years old and lives in San Francisco."
    string_source = StringKnowledgeSource(content=content)

    # Create deterministic LLM
    llm = LLM(model="gpt-4o-mini", temperature=0)

    # Create agent with knowledge store
    agent = Agent(
        role="About User",
        goal="You know everything about the user.",
        backstory="You are a master at understanding people and their preferences.",
        verbose=True,
        allow_delegation=False,
        llm=llm,
    )

    # Create task for the agent
    task = Task(
        description="Answer the following questions about the user: {question}",
        expected_output="An answer to the question.",
        agent=agent,
    )

    # Create crew with the agent, task, and knowledge source enabled
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=True,
        process=Process.sequential,
        knowledge_sources=[string_source],
    )

    # Run kickoff with a question input
    result = crew.kickoff(inputs={"question": "What city does John live in and how old is he?"})

    # Assert that result is a dict with expected keys and no error
    assert isinstance(result, dict), "Result should be a dict"
    # The result should contain the task description key or output key
    # We check for presence of the task description or a non-empty output
    output_values = list(result.values())
    assert any(isinstance(v, str) and len(v) > 0 for v in output_values), "Output should contain a non-empty string answer"

    # Additionally, check that no error keys or exceptions are in the result
    # (If the buggy code raises, this test will fail before this point)
    # We do not expect any error keys in the result dict
    assert not any("error" in str(k).lower() for k in result.keys()), "Result should not contain error keys"


# Note:
# This test runs the real code path that triggers the knowledge upsert.
# The buggy code raises an exception about missing keyword-only arguments in APIStatusError.__init__.
# After applying the fix, the test should pass without exceptions and produce a valid output.[0m
