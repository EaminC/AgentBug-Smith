[32mimport pytest
import os

from crewai import Agent, Task, Crew, Process, LLM
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource


def test_agent_with_knowledge_source_no_api_status_error():
    """
    This test reproduces the bug described in issue #2150 where
    an APIStatusError.__init__() fails due to missing required keyword-only arguments
    'response' and 'body' when using a knowledge source with an agent.

    The test will fail on the buggy codebase with an exception,
    and pass on the fixed codebase without error.
    """

    # Arrange: Create a knowledge source with simple content
    content = "Users name is John. He is 30 years old and lives in San Francisco."
    string_source = StringKnowledgeSource(content=content)

    # Use a deterministic LLM model with temperature 0
    llm = LLM(model="gpt-4o-mini", temperature=0)

    # Create an agent with knowledge store enabled
    agent = Agent(
        role="About User",
        goal="You know everything about the user.",
        backstory="You are a master at understanding people and their preferences.",
        verbose=True,
        allow_delegation=False,
        llm=llm,
    )

    # Create a task that queries the agent about the user
    task = Task(
        description="Answer the following questions about the user: {question}",
        expected_output="An answer to the question.",
        agent=agent,
    )

    # Create a crew with the agent, task, and knowledge source
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=True,
        process=Process.sequential,
        knowledge_sources=[string_source],
    )

    # Act: Kickoff the crew with a question input
    # This triggers the knowledge upsert and LLM call internally
    try:
        result = crew.kickoff(inputs={"question": "What city does John live in and how old is he?"})
    except Exception as e:
        # On buggy codebase, an exception related to APIStatusError missing arguments is expected
        # Re-raise to fail the test
        raise e

    # Assert: The result should contain an answer string without errors
    assert result is not None
    assert isinstance(result, dict)
    # The task output key is usually the task description or id; check for presence of answer text
    output_values = list(result.values())
    assert any(isinstance(v, str) and "San Francisco" in v and "30" in v for v in output_values), \
        "Expected answer about John's city and age in the output"


# The test relies on the real LLM and knowledge source integration.
# It will fail on the buggy codebase due to missing arguments in APIStatusError.__init__,
# and pass on the fixed codebase where the knowledge setup is corrected.[0m
