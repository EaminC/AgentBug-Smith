[32mimport pytest
import re
from crewai import Agent, Task, Crew, Process, LLM
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource


def test_agent_with_knowledge_source_no_api_status_error():
    """
    This test reproduces the scenario described in issue #2150:
    When using an Agent with a knowledge source StringKnowledgeSource,
    kickoff should complete without raising an APIStatusError due to missing arguments.

    The test will fail on the buggy codebase due to the missing required keyword-only arguments
    in APIStatusError.__init__() when upserting documents.

    After the fix, the test should pass without exceptions.
    """

    # Prepare knowledge source content
    content = "Users name is John. He is 30 years old and lives in San Francisco."
    string_source = StringKnowledgeSource(content=content)

    # Create an LLM with temperature 0 for deterministic output
    llm = LLM(model="gpt-4o-mini", temperature=0)

    # Create an agent with the knowledge store
    agent = Agent(
        role="About User",
        goal="You know everything about the user.",
        backstory="You are a master at understanding people and their preferences.",
        verbose=True,
        allow_delegation=False,
        llm=llm,
    )

    # Create a task that queries the knowledge
    task = Task(
        description="Answer the following questions about the user: {question}",
        expected_output="An answer to the question.",
        agent=agent,
    )

    # Create a crew with the agent, task, and knowledge source
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=True,
        process=Process.sequential,
        knowledge_sources=[string_source],
    )

    # Run kickoff with a question input
    # The test expects no exception related to APIStatusError missing arguments
    result = crew.kickoff(inputs={"question": "What city does John live in and how old is he?"})

    # Assert the result is a dict and contains expected keys
    assert isinstance(result, dict)
    # The output should contain the task description key and a non-empty answer string
    assert any(
        isinstance(v, str) and len(v) > 0
        for v in result.values()
    )
    # Optionally check that the answer mentions San Francisco and 30
    combined_text = " ".join(str(v).lower() for v in result.values())
    assert "san francisco" in combined_text
    assert "30" in combined_text or "thirty" in combined_text

