[32mimport pytest
from crewai import Agent, Task, Crew, Process, LLM
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource


def test_agent_with_knowledge_source_no_api_status_error():
    """
    This test reproduces the scenario described in issue #2150 where using
    a knowledge source with an Agent and Crew leads to an APIStatusError
    due to missing required keyword-only arguments.

    The test will fail on the buggy codebase with an exception about missing
    'response' and 'body' arguments in APIStatusError.__init__.

    After applying the fix, the test should pass without exceptions.
    """

    # Create a knowledge source with user info
    content = "Users name is John. He is 30 years old and lives in San Francisco."
    string_source = StringKnowledgeSource(content=content)

    # Create an LLM with temperature 0 for deterministic output
    llm = LLM(model="gpt-4o-mini", temperature=0)

    # Create an agent with knowledge store enabled
    agent = Agent(
        role="About User",
        goal="You know everything about the user.",
        backstory="You are a master at understanding people and their preferences.",
        verbose=True,
        allow_delegation=False,
        llm=llm,
    )

    # Create a task that queries the user info
    task = Task(
        description="Answer the following questions about the user: {question}",
        expected_output="An answer to the question.",
        agent=agent,
    )

    # Create a crew with the agent, task, and knowledge source
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=True,
        process=Process.sequential,
        knowledge_sources=[string_source],
    )

    # Kickoff the crew with a question input
    result = crew.kickoff(inputs={"question": "What city does John live in and how old is he?"})

    # Assert that the result contains a non-empty answer string
    assert result is not None
    assert isinstance(result, dict)
    # The task description is the key in the result dict
    # We expect the output to be a string containing "San Francisco" and "30"
    output_values = list(result.values())
    assert len(output_values) > 0
    answer = output_values[0]
    assert isinstance(answer, str)
    assert "San Francisco" in answer or "30" in answer or "John" in answer

    # No exceptions should be raised during the kickoff call


# Note: This test runs the actual code path that triggers the bug in the buggy codebase.
# The fix patch modifies Agent and Crew to properly set knowledge and avoid the missing arguments error.
# Thus, this test will fail on buggy and pass on fixed code.[0m
