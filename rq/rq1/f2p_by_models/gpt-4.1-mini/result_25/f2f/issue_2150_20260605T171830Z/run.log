[32mimport pytest
from crewai import Agent, Task, Crew, Process, LLM
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource

def test_agent_with_knowledge_source_no_api_status_error():
    """
    This test reproduces the bug described in issue #2150:
    "Failed to upsert documents: APIStatusError.__init__() missing 2 required keyword-only arguments: 'response' and 'body'"

    The test creates a StringKnowledgeSource, an LLM, an Agent, a Task, and a Crew with knowledge sources.
    It then runs crew.kickoff with a question input.

    Expected behavior:
    - No exception related to APIStatusError missing arguments is raised.
    - The result contains a non-empty answer string.

    Fail2pass:
    - On the buggy codebase, this test should fail with an exception about missing arguments.
    - After the fix, this test should pass without exceptions.
    """

    content = "Users name is John. He is 30 years old and lives in San Francisco."
    string_source = StringKnowledgeSource(content=content)

    llm = LLM(model="gpt-4o-mini", temperature=0)

    agent = Agent(
        role="About User",
        goal="You know everything about the user.",
        backstory="You are a master at understanding people and their preferences.",
        verbose=True,
        allow_delegation=False,
        llm=llm,
    )

    task = Task(
        description="Answer the following questions about the user: {question}",
        expected_output="An answer to the question.",
        agent=agent,
    )

    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=True,
        process=Process.sequential,
        knowledge_sources=[string_source],
    )

    # Run kickoff and assert no exception and valid output
    result = crew.kickoff(inputs={"question": "What city does John live in and how old is he?"})

    # The result should be a dict with task outputs
    assert isinstance(result, dict)
    assert len(result) > 0

    # The output for the task should contain an answer string with expected content
    # We check that the answer mentions "San Francisco" and "30" as a minimal sanity check
    answer_str = None
    for v in result.values():
        if isinstance(v, str):
            answer_str = v
            break
        elif hasattr(v, "get") and callable(v.get):
            # If output is dict-like, try to get a string answer
            for val in v.values():
                if isinstance(val, str):
                    answer_str = val
                    break
            if answer_str:
                break

    assert answer_str is not None
    assert "San Francisco" in answer_str or "30" in answer_str or "john" in answer_str.lower()  # case insensitive check

# Note:
# This test relies on real LLM calls and knowledge source upsert.
# It will fail on the buggy codebase with the missing keyword-only arguments error.
# After applying the fix, it should pass successfully.[0m
