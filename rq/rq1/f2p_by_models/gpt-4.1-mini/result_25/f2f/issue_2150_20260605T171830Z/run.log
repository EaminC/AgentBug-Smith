[32mimport pytest
import os
from crewai import Agent, Task, Crew, Process, LLM
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource

def test_agent_with_knowledge_source_no_api_status_error(monkeypatch):
    # Monkeypatch the LLM._call method to avoid real API calls and simulate a successful response
    # This prevents actual network calls and API key errors during testing
    def dummy_llm_call(self, prompt, **kwargs):
        # Return a dummy response that would be expected from the LLM call
        return "John lives in San Francisco and is 30 years old."

    # Patch the _call method of the LLM instance
    monkeypatch.setattr(LLM, "_call", dummy_llm_call)

    # Create a knowledge source with some content
    content = "Users name is John. He is 30 years old and lives in San Francisco."
    string_source = StringKnowledgeSource(content=content)

    # Create an LLM with temperature 0 for deterministic output
    llm = LLM(model="gpt-4o-mini", temperature=0)

    # Create an agent with the knowledge store
    agent = Agent(
        role="About User",
        goal="You know everything about the user.",
        backstory="You are a master at understanding people and their preferences.",
        verbose=True,
        allow_delegation=False,
        llm=llm,
    )

    # Create a task that uses the agent
    task = Task(
        description="Answer the following questions about the user: {question}",
        expected_output="An answer to the question.",
        agent=agent,
    )

    # Create a crew with the agent, task, and knowledge source
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=True,
        process=Process.sequential,
        knowledge_sources=[string_source],
    )

    # Run the crew kickoff with a question input
    result = crew.kickoff(inputs={"question": "What city does John live in and how old is he?"})

    # Assert that the result is a dict and contains the expected output key
    assert isinstance(result, dict)
    # The task description is the key in the result dict (interpolated)
    # We check that the output contains expected info (case insensitive)
    output_values = list(result.values())
    assert any(
        "san francisco" in str(v).lower() and "30" in str(v)
        for v in output_values
    )[0m
