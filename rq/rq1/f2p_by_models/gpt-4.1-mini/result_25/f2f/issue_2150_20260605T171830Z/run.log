[32mimport pytest
from crewai import Agent, Task, Crew, Process, LLM
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource

def test_agent_with_knowledge_source_no_api_status_error():
    """
    This test reproduces the issue #2150 where using a knowledge source with an Agent
    caused a TypeError due to missing required keyword-only arguments in APIStatusError.__init__.
    The test will fail on the buggy codebase and pass after the fix is applied.
    """
    # Prepare knowledge source content
    content = "Users name is John. He is 30 years old and lives in San Francisco."
    string_source = StringKnowledgeSource(content=content)

    # Create an LLM with temperature 0 for deterministic output
    llm = LLM(model="gpt-4o-mini", temperature=0)

    # Create an Agent with knowledge store
    agent = Agent(
        role="About User",
        goal="You know everything about the user.",
        backstory="You are a master at understanding people and their preferences.",
        verbose=True,
        allow_delegation=False,
        llm=llm,
    )

    # Create a Task for the Agent
    task = Task(
        description="Answer the following questions about the user: {question}",
        expected_output="An answer to the question.",
        agent=agent,
    )

    # Create a Crew with the Agent, Task, and knowledge source
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=True,
        process=Process.sequential,
        knowledge_sources=[string_source],
    )

    # Run the Crew kickoff with input question
    result = crew.kickoff(inputs={"question": "What city does John live in and how old is he?"})

    # Assert that the result is a dict and contains the expected output key
    assert isinstance(result, dict), "Crew kickoff result should be a dictionary"
    assert task.description.format(question="dummy") in task.description or True  # sanity check for formatting
    # The result should contain the task description key or some output key
    # Since the output format can vary, check that the result is not empty
    assert len(result) > 0, "Crew kickoff result should not be empty"

    # Additionally, check that the answer contains expected substrings
    answer_values = [v for v in result.values() if isinstance(v, str)]
    combined_answer = " ".join(answer_values).lower()
    assert "san francisco" in combined_answer, "Answer should mention 'San Francisco'"
    assert "30" in combined_answer, "Answer should mention age '30'"

# Note: This test does not mock LLM calls or network requests.
# On the buggy codebase, it should raise the APIStatusError __init__ missing argument error.
# After the fix, it should run successfully and produce a valid answer.[0m
