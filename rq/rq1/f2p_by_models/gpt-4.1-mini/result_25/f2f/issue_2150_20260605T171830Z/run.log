[32mimport pytest
from crewai import Agent, Task, Crew, Process, LLM
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource


def test_agent_with_knowledge_source_no_api_status_error():
    """
    This test reproduces the bug described in issue #2150 where
    an APIStatusError.__init__() is missing required keyword-only arguments
    when upserting documents with knowledge sources.

    The test creates a StringKnowledgeSource, an LLM, an Agent with the knowledge,
    a Task, and a Crew with the knowledge source enabled, then runs kickoff.

    The test expects no exception to be raised during kickoff and that the
    result contains a non-empty answer string.

    On the buggy codebase, this test should fail with a TypeError or similar.
    After applying the fix, this test should pass.
    """
    content = "Users name is John. He is 30 years old and lives in San Francisco."
    string_source = StringKnowledgeSource(content=content)

    # Use a deterministic LLM model and temperature
    llm = LLM(model="gpt-4o-mini", temperature=0)

    agent = Agent(
        role="About User",
        goal="You know everything about the user.",
        backstory="You are a master at understanding people and their preferences.",
        verbose=True,
        allow_delegation=False,
        llm=llm,
    )

    task = Task(
        description="Answer the following questions about the user: {question}",
        expected_output="An answer to the question.",
        agent=agent,
    )

    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=True,
        process=Process.sequential,
        knowledge_sources=[string_source],
    )

    # Run kickoff with a question about the user
    result = crew.kickoff(inputs={"question": "What city does John live in and how old is he?"})

    # Assert result is a dict with expected keys and non-empty answer
    assert isinstance(result, dict)
    assert "answer" in result or any(isinstance(v, str) and v for v in result.values())
    # Check that the answer contains expected substrings
    answer_text = ""
    if "answer" in result:
        answer_text = result["answer"]
    else:
        # fallback: find first non-empty string value
        for v in result.values():
            if isinstance(v, str) and v:
                answer_text = v
                break
    assert "San Francisco" in answer_text or "30" in answer_text or "John" in answer_text[0m
