    """
    import uvicorn
    import examples.reactv2_agent_with_mcp.code.mcp_servers as mcp_servers

    # Run uvicorn server in a separate thread
    config = uvicorn.Config(mcp_servers.main_app, host="127.0.0.1", port=8001, log_level="critical")
    server = uvicorn.Server(config)

    thread = threading.Thread(target=server.run, daemon=True)
    thread.start()

    # Wait for the server to be ready
    timeout = 10
    interval = 0.1
    total_wait = 0
    while total_wait < timeout:
        try:
            with socket.create_connection(("127.0.0.1", 8001), timeout=1):
                break
        except OSError:
            time.sleep(interval)
            total_wait += interval
    else:
        pytest.fail("MCP server did not start in time")

    yield

    # Shutdown uvicorn server
    server.should_exit = True
    thread.join(timeout=5)


@pytest.mark.usefixtures("start_mcp_servers")
def test_react_agent_v2_with_streamable_http_mcp():
    """
    Test that ReActAgentV2 can use MCP servers with streamable_http type.
    This requires the patch to support streamable_http MCP clients.
