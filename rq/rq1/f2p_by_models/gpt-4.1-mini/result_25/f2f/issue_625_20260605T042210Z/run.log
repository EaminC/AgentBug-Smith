    """
    import uvicorn
    import examples.reactv2_agent_with_mcp.code.mcp_servers as mcp_servers

    # Check if port 8001 is free
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        sock.bind(("127.0.0.1", 8001))
        sock.close()
    except OSError:
        # Port is in use, assume server is running
        yield
        return

    def run_server():
        uvicorn.run(mcp_servers.main_app, host="127.0.0.1", port=8001, log_level="error")

    thread = threading.Thread(target=run_server, daemon=True)
    thread.start()
    # Wait for server to start
    for _ in range(30):
        try:
            r = requests.get("http://127.0.0.1:8001/sse_app/sse", timeout=1)
            if r.status_code in (200, 404, 405):
                break
        except Exception:
            time.sleep(0.5)
    else:
        pytest.fail("MCP servers failed to start")

    yield

    # No explicit shutdown; daemon thread will exit on test end


@pytest.mark.usefixtures("start_mcp_servers")
def test_react_agent_v2_with_streamable_http_mcp():
    """
    Test that ReActAgentV2 can use MCP servers with streamable_http type.
    This requires the patch to properly handle streamable_http MCP servers.
    """
    # Setup model configs and init agentscope
    model_name = "qwen-plus"
    custom_api_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"

    import agentscope

    agentscope.init(
        model_configs=[
            {
                "config_name": "my_config",
                "model_type": "dashscope_chat",
                "model_name": "qwen-plus",
            },
            {
                "config_name": "my_config2",
                "client_args": {
                    "base_url": custom_api_url,
                },
                "api_key": "dummy_api_key_for_test",
                "model_type": "openai_chat",
                "model_name": model_name,
            },
        ],
    )
    OpenAIFormatter.supported_model_regexes.append(model_name)

    # Setup MCP servers in toolkit
    toolkit = ServiceToolkit()
    toolkit.add_mcp_servers(
        {
            "mcpServers": {
                "add-tool": {
                    "type": "sse",
                    "url": "http://127.0.0.1:8001/sse_app/sse",
                },
                "multiply-tool": {
                    "type": "streamable_http",
                    "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
                },
            },
        },
    )

    agent = ReActAgentV2(
        name="Friday",
        max_iters=3,
        model_config_name="my_config",
        service_toolkit=toolkit,
        sys_prompt="You're a helpful assistant named Friday.",
    )

    # Compose a message that triggers both tools
    user_msg = Msg(
        "user",
        "Calculate 2345 multiplied by 3456, then add 4567 to the result, what is the final outcome?",
        "user",
    )

    # Run the agent synchronously and get the result
    res_msg = agent(user_msg)

    # The expected answer is (2345 * 3456) + 4567 = 8107927
    expected_answer = "8107927"

    # The response content should contain the expected answer as a substring
    assert expected_answer in res_msg.content, f"Expected answer {expected_answer} not in response: {res_msg.content}"[0m
