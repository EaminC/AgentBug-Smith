    # Add examples/reactv2_agent_with_mcp/code to sys.path to import mcp_servers
    code_dir = os.path.join(os.path.dirname(__file__), "..", "examples", "reactv2_agent_with_mcp", "code")
    code_dir = os.path.abspath(code_dir)
    if code_dir not in sys.path:
        sys.path.insert(0, code_dir)
    import mcp_servers

    # Run uvicorn server in a thread
    server_thread = threading.Thread(
        target=uvicorn.run,
        args=(mcp_servers.main_app,),
        kwargs={"host": "127.0.0.1", "port": 8001, "log_level": "critical"},
        daemon=True,
    )
    server_thread.start()

    # Wait for server to start
    time.sleep(2)

    yield

    # No explicit shutdown, daemon thread will exit on test exit


def test_react_agent_v2_with_streamable_http_mcp(start_mcp_servers):
    """
    Test that ReActAgentV2 can use MCP servers with streamable_http type.
    This requires the patch to support streamable_http MCP client.
    """

    # Setup model configs and initialize agentscope
    model_name = "qwen-plus"
    custom_api_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"

    agentscope.init(
        model_configs=[
            {
                "config_name": "my_config",
                "model_type": "dashscope_chat",
                "model_name": "qwen-plus",
            },
            {
                "config_name": "my_config2",
                "client_args": {
                    "base_url": custom_api_url,
                },
                "api_key": "dummy_api_key_for_test",
                "model_type": "openai_chat",
                "model_name": model_name,
            },
        ],
    )
    OpenAIFormatter.supported_model_regexes.append(model_name)

    # Setup ServiceToolkit with MCP servers including streamable_http type
    toolkit = ServiceToolkit()
    toolkit.add_mcp_servers(
        {
            "mcpServers": {
                "add-tool": {
                    "type": "sse",
                    "url": "http://127.0.0.1:8001/sse_app/sse",
                },
                "multiply-tool": {
                    "type": "streamable_http",
                    "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
                },
            },
        },
    )

    agent = ReActAgentV2(
        name="Friday",
        max_iters=3,
        model_config_name="my_config",
        service_toolkit=toolkit,
        sys_prompt="You're a helpful assistant named Friday.",
    )

    # Compose a message that triggers both tools usage
    user_msg = Msg(
        "user",
        "Calculate 2345 multiplied by 3456, then add 4567 to the result, what is the final outcome?",
        "user",
    )

    # Run the agent synchronously
    res_msg = agent(user_msg)

    # The expected result is the correct calculation: 2345*3456 + 4567
    expected_result = 2345 * 3456 + 4567
    # The agent's response content should contain the expected result as a string
    assert str(expected_result) in res_msg.content, f"Expected result {expected_result} not found in response: {res_msg.content}"[0m
