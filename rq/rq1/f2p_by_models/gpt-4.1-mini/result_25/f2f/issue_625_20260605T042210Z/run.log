                    "url": "http://127.0.0.1:8001/sse_app/sse",
                },
                "multiply-tool": {
                    "type": "streamable_http",
                    "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
                },
            },
        },
    )

    # Create the agent with the toolkit
    agent = ReActAgentV2(
        name="Friday",
        max_iters=3,
        model_config_name="my_config",
        service_toolkit=toolkit,
        sys_prompt="You're a helpful assistant named Friday.",
    )

    # Compose a message that requires both tools
    user_msg = Msg(
        "user",
        "Calculate 2345 multiplied by 3456, then add 4567 to the result, what is the final outcome?",
        "user",
    )

    # Run the agent synchronously (blocking call)
    res_msg = agent(user_msg)

    # The expected answer is 2345*3456 + 4567 = 8107920 + 4567 = 8112487
    expected_answer = "8112487"

    # The content should contain the expected answer as a substring (allow some flexibility)
    assert expected_answer in res_msg.content, f"Expected answer {expected_answer} not found in response: {res_msg.content}"[0m
