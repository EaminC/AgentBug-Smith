@pytest.fixture(scope="module")
def start_mcp_servers():
    """
    Start the MCP servers from examples/reactv2_agent_with_mcp/code/mcp_servers.py
    in a background thread using uvicorn.
    If uvicorn is not installed, this fixture will fail to import and cause the test to error,
    which is expected in the buggy state.
    """
    import uvicorn
    import sys
    import pathlib

    # Import the mcp_servers module from examples/reactv2_agent_with_mcp/code
    repo_root = pathlib.Path(__file__).parent.parent.resolve()
    code_dir = repo_root / "examples" / "reactv2_agent_with_mcp" / "code"
    sys.path.insert(0, str(code_dir))
    import mcp_servers

    # Run uvicorn server in a thread
    def run_server():
        uvicorn.run(mcp_servers.main_app, host="127.0.0.1", port=8001, log_level="error")

    thread = threading.Thread(target=run_server, daemon=True)
    thread.start()

    # Wait for the server to be ready by checking port 8001
    for _ in range(30):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            try:
                sock.connect(("127.0.0.1", 8001))
                break
            except ConnectionRefusedError:
                time.sleep(0.5)
    else:
        pytest.fail("MCP server did not start in time")

    yield

    # No explicit shutdown needed as daemon thread will exit


def test_react_agent_v2_with_streamable_http_mcp(start_mcp_servers):
    """
    Test that ReActAgentV2 can call MCP servers including streamable_http type.
