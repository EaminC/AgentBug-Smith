    # Run the agent synchronously (blocking call)
    res_msg = agent(user_msg)

    # The expected result is 2345*3456 + 4567 = 8107920 + 4567 = 8112487
    expected_answer = "8112487"

    # The content should contain the expected answer as a substring (allowing some formatting)
    assert expected_answer in res_msg.content, f"Expected result {expected_answer} not in response: {res_msg.content}"[0m
