    import examples.reactv2_agent_with_mcp.code.mcp_servers as mcp_servers

    config = uvicorn.Config(mcp_servers.main_app, host="127.0.0.1", port=8001, log_level="error")
    server = uvicorn.Server(config)

    thread = threading.Thread(target=server.run, daemon=True)
    thread.start()

    # Wait a bit for the server to start
    timeout = 10
    for _ in range(timeout * 10):
        if server.started:
            break
        time.sleep(0.1)
    else:
        pytest.fail("MCP servers failed to start within timeout")

    yield

    # Shutdown server after tests
    server.should_exit = True
    thread.join(timeout=5)


def test_react_agent_v2_with_streamable_http_mcp(start_mcp_servers):
    """
    Test that ReActAgentV2 can use MCP servers with streamable_http type.
    This test will fail on the buggy codebase because streamable_http client
    support is missing, and pass after the fix.
    """
    # Setup the ServiceToolkit with MCP servers config as in the example
    toolkit = ServiceToolkit()
    toolkit.add_mcp_servers(
        {
            "mcpServers": {
                "add-tool": {
                    "type": "sse",
                    "url": "http://127.0.0.1:8001/sse_app/sse",
                },
                "multiply-tool": {
                    "type": "streamable_http",
                    "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
                },
            },
        },
    )

    # Register the custom model name to OpenAIFormatter to avoid unknown model errors
    model_name = "qwen-plus"
    OpenAIFormatter.supported_model_regexes.append(model_name)

    # Initialize the agent with the toolkit and model config name
    agent = ReActAgentV2(
        name="Friday",
        max_iters=3,
        model_config_name="my_config",
        service_toolkit=toolkit,
        sys_prompt="You're a helpful assistant named Friday.",
    )

    # Compose a message that triggers both multiply and add tools via MCP servers
    user_msg = Msg(
        "user",
        "Calculate 2345 multiplied by 3456, then add 4567 to the result, what is the final outcome?",
        "user",
    )

    # Run the agent synchronously to get the response message
    res_msg = agent(user_msg)

    # The expected result is 2345*3456 + 4567 = 8107920 + 4567 = 8112487
    expected_answer = "8112487"

    # Assert the response content contains the expected answer
    # We allow some flexibility in formatting, so just check substring
    assert expected_answer in res_msg.content, f"Expected answer {expected_answer} not found in response: {res_msg.content}"[0m
