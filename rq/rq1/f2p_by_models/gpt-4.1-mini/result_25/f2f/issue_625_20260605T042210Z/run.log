def test_react_agent_v2_with_streamable_http_mcp(start_mcp_servers):
    """
    Test that ReActAgentV2 can use the streamable_http MCP server to perform
    a calculation via the MCP tools.
    This test should fail on buggy code (no streamable_http support),
    and pass after the fix.
