[32mimport asyncio
import os
import socket
import threading
import time

import pytest

from agentscope.agents import ReActAgentV2
from agentscope.message import Msg
from agentscope.service import ServiceToolkit


def wait_for_port(host: str, port: int, timeout: float = 5.0) -> bool:
    """Wait until a TCP port is open on the given host."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            sock.settimeout(0.5)
            try:
                sock.connect((host, port))
                return True
            except Exception:
                time.sleep(0.1)
    return False


@pytest.fixture(scope="module")
def start_mcp_servers():
    """
    Start the MCP servers from examples/reactv2_agent_with_mcp/code/mcp_servers.py
    in a background thread using uvicorn, then yield control to tests.
    After tests, shut down the server.
    """
    import uvicorn
    import examples.reactv2_agent_with_mcp.code.mcp_servers as mcp_servers

    config = uvicorn.Config(
        mcp_servers.main_app,
        host="127.0.0.1",
        port=8001,
        log_level="critical",
        loop="asyncio",
        lifespan="on",
    )
    server = uvicorn.Server(config)

    thread = threading.Thread(target=server.run, daemon=True)
    thread.start()

    # Wait for server to be ready
    assert wait_for_port("127.0.0.1", 8001, timeout=10), "MCP servers did not start in time"

    yield

    # Shutdown uvicorn server gracefully
    server.should_exit = True
    thread.join(timeout=5)


@pytest.mark.usefixtures("start_mcp_servers")
def test_react_agent_v2_with_streamable_http_mcp():
    """
    This test verifies that ReActAgentV2 can interact with MCP servers
    including the streamable_http type server.

    It uses the example reactv2_agent_with_http_mcp_demo.py setup:
    - Adds MCP servers with both SSE and streamable_http types.
    - Sends a calculation request that involves both tools.
    - Checks that the final answer is correct.

    Expected behavior:
    - On buggy codebase (without streamable_http support), this test should fail.
    - On fixed codebase (with streamable_http support), this test should pass.
    """
    # Setup the toolkit and agent as in reactv2_agent_with_http_mcp_demo.py
    from agentscope.formatters import OpenAIFormatter

    model_name = "qwen-plus"
    custom_api_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"

    # Initialize agentscope with configs
    import agentscope

    agentscope.init(
        model_configs=[
            {
                "config_name": "my_config",
                "model_type": "dashscope_chat",
                "model_name": "qwen-plus",
            },
            {
                "config_name": "my_config2",
                "client_args": {
                    "base_url": custom_api_url,
                },
                "api_key": os.environ.get("DASHSCOPE_API_KEY"),
                "model_type": "openai_chat",
                "model_name": model_name,
            },
        ],
    )
    OpenAIFormatter.supported_model_regexes.append(model_name)

    toolkit = ServiceToolkit()
    toolkit.add_mcp_servers(
        {
            "mcpServers": {
                "add-tool": {
                    "type": "sse",
                    "url": "http://127.0.0.1:8001/sse_app/sse",
                },
                "multiply-tool": {
                    "type": "streamable_http",
                    "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
                },
            },
        },
    )

    agent = ReActAgentV2(
        name="Friday",
        max_iters=3,
        model_config_name="my_config",
        service_toolkit=toolkit,
        sys_prompt="You're a helpful assistant named Friday.",
    )

    # Compose the message to trigger both tools
    user_msg = Msg(
        "user",
        "Calculate 2345 multiplied by 3456, then add 4567 to the result, what is the final outcome?",
        "user",
    )

    # Run the agent synchronously (agent is callable)
    # The output should be the correct calculation: 2345*3456 + 4567 = 8107927
    res_msg = agent(user_msg)

    # The content should contain the correct final answer (as a number or string)
    # We allow some flexibility in formatting but must include the correct number
    expected_answer = 2345 * 3456 + 4567  # 8107927

    # Check that the expected answer is in the response content as a substring
    assert str(expected_answer) in res_msg.content, (
        f"Expected answer {expected_answer} not found in agent response: {res_msg.content}"
    )[0m
