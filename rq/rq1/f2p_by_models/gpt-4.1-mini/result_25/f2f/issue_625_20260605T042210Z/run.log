        {
            "mcpServers": {
                "add-tool": {
                    "type": "sse",
                    "url": "http://127.0.0.1:8001/sse_app/sse",
                },
                "multiply-tool": {
                    "type": "streamable_http",
                    "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
                },
            },
        },
    )

    # Create the agent
    agent = ReActAgentV2(
        name="Friday",
        max_iters=3,
        model_config_name="my_config",
        service_toolkit=toolkit,
        sys_prompt="You're a helpful assistant named Friday.",
    )

    # Compose the user message
    user_msg = Msg(
        "user",
        "Calculate 2345 multiplied by 3456, then add 4567 to the result, what is the final outcome?",
        "user",
    )

    # Call the agent and get the response
    res_msg = agent(user_msg)

    # The expected answer is 2345*3456 + 4567 = 8105527
    # We check that the response contains the correct numeric answer as a substring
    expected_answer = "8105527"

    assert expected_answer in res_msg.content, f"Expected answer {expected_answer} not in response: {res_msg.content}"[0m
