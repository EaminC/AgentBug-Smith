    # Initialize agentscope with model configs including a dummy config for testing
    model_name = "qwen-plus"
    custom_api_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"

    agentscope.init(
        model_configs=[
            {
                "config_name": "my_config",
                "model_type": "dashscope_chat",
                "model_name": "qwen-plus",
            },
            {
                "config_name": "my_config2",
                "client_args": {
                    "base_url": custom_api_url,
                },
                "api_key": "dummy_api_key_for_test",
                "model_type": "openai_chat",
                "model_name": model_name,
            },
        ],
    )
    OpenAIFormatter.supported_model_regexes.append(model_name)

    # Setup MCP servers in toolkit with streamable_http type
    toolkit = ServiceToolkit()
    toolkit.add_mcp_servers(
        {
            "mcpServers": {
                "add-tool": {
                    "type": "sse",
                    "url": "http://127.0.0.1:8001/sse_app/sse",
                },
                "multiply-tool": {
                    "type": "streamable_http",
                    "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
                },
            },
        },
    )

    agent = ReActAgentV2(
        name="Friday",
        max_iters=3,
        model_config_name="my_config",
        service_toolkit=toolkit,
        sys_prompt="You're a helpful assistant named Friday.",
    )

    # Compose a prompt that triggers both tools
    prompt = (
        "Calculate 2345 multiplied by 3456, then add 4567 to the result, "
        "what is the final outcome?"
    )
    msg = Msg("user", prompt, "user")

    # Run the agent synchronously and get the response
    res_msg = agent(msg)

    # The expected answer is (2345 * 3456) + 4567 = 8107927
    expected_answer = "8107927"

    # Check if the expected answer is in the response content
    assert expected_answer in res_msg.content, f"Expected '{expected_answer}' in response, got: {res_msg.content}"[0m
