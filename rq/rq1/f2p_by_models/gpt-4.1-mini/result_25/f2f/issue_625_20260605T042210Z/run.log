def test_react_agent_v2_with_streamable_http_mcp():
    """
    Test the ReActAgentV2 with MCP servers configured for both SSE and streamable HTTP.
    This test sends a calculation request that uses both the add and multiply tools
    exposed via MCP servers.
    """

    # Model name used in example
    model_name = "qwen-plus"

    # Setup the service toolkit with MCP servers as in the example
    toolkit = ServiceToolkit()
    toolkit.add_mcp_servers(
        {
            "mcpServers": {
                "add-tool": {
                    "type": "sse",
                    "url": "http://127.0.0.1:8001/sse_app/sse",
                },
                "multiply-tool": {
                    "type": "streamable_http",
                    "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
                },
            },
        },
    )

    # Append model name to OpenAIFormatter to support non-OpenAI model
    if model_name not in OpenAIFormatter.supported_model_regexes:
        OpenAIFormatter.supported_model_regexes.append(model_name)

    agent = ReActAgentV2(
        name="Friday",
        max_iters=3,
        model_config_name="my_config",
        service_toolkit=toolkit,
        sys_prompt="You're a helpful assistant named Friday.",
    )

    # Compose the message to trigger both multiply and add tools
    user_msg = Msg(
        "user",
        "Calculate 2345 multiplied by 3456, then add 4567 to the result, what is the final outcome?",
        "user",
    )

    # Run the agent synchronously
    res_msg = agent(user_msg)

    # The expected result is 2345*3456 + 4567 = 8107920 + 4567 = 8112487
    expected_answer = "8112487"

    # The response content should contain the expected answer as a substring
    assert expected_answer in res_msg.content, f"Expected answer {expected_answer} not found in response: {res_msg.content}"[0m
