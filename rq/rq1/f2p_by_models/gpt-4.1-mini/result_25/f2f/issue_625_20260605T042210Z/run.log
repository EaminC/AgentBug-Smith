def test_react_agent_v2_with_streamable_http_mcp(start_mcp_servers):
    """
    This test verifies that the ReActAgentV2 can correctly use MCP servers
    including the new streamable_http type.
    It sends a calculation request to the agent which uses MCP tools for addition and multiplication.
    The expected final answer is 2345 * 3456 + 4567 = 8107927.
    """

    model_name = "qwen-plus"
    custom_api_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"

    # Initialize agentscope with two model configs, one dashscope_chat and one openai_chat
    import agentscope
    agentscope.init(
        model_configs=[
            {
                "config_name": "my_config",
                "model_type": "dashscope_chat",
                "model_name": "qwen-plus",
            },
            {
                "config_name": "my_config2",
                "client_args": {
                    "base_url": custom_api_url,
                },
                "api_key": "dummy_api_key_for_test",
                "model_type": "openai_chat",
                "model_name": model_name,
            },
        ],
    )
    OpenAIFormatter.supported_model_regexes.append(model_name)

    # Setup ServiceToolkit and add MCP servers with both SSE and streamable_http types
    toolkit = ServiceToolkit()
    toolkit.add_mcp_servers(
        {
            "mcpServers": {
                "add-tool": {
                    "type": "sse",
                    "url": "http://127.0.0.1:8001/sse_app/sse",
                },
                "multiply-tool": {
                    "type": "streamable_http",
                    "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
                },
            },
        },
    )

    agent = ReActAgentV2(
        name="Friday",
        max_iters=3,
        model_config_name="my_config",
        service_toolkit=toolkit,
        sys_prompt="You're a helpful assistant named Friday.",
    )

    # Compose the user message requesting the calculation
    user_msg = Msg(
        "user",
        "Calculate 2345 multiplied by 3456, then add 4567 to the result, what is the final outcome?",
        "user",
    )

    # Run the agent synchronously (blocking)
    res_msg = agent(user_msg)

    # The expected result is 2345 * 3456 + 4567 = 8107927
    expected_answer = "8107927"

    # Assert the expected answer is contained in the response content
    assert expected_answer in res_msg.content, f"Expected answer {expected_answer} not found in response: {res_msg.content}"[0m
