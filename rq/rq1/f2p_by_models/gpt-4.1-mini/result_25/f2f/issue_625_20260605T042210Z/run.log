import agentscope

# We will run the MCP servers from the example module in a thread for testing.
# This requires uvicorn and the example server code.
# The test will fail if the patch is not applied because the streamable_http client support is missing.

@pytest.fixture(scope="module")
def start_mcp_servers():
    # Import here to avoid import errors if uvicorn is not installed
    import uvicorn
    import examples.reactv2_agent_with_mcp.code.mcp_servers as mcp_servers

    # Run the Starlette app with uvicorn in a separate thread
    config = uvicorn.Config(mcp_servers.main_app, host="127.0.0.1", port=8001, log_level="critical")
    server = uvicorn.Server(config)

    thread = threading.Thread(target=server.run, daemon=True)
    thread.start()

    # Wait for server to start
    timeout = 10
    for _ in range(timeout * 10):
        if server.started:
            break
        time.sleep(0.1)
    else:
        pytest.fail("MCP servers did not start in time")

    yield

    # Shutdown server
    server.should_exit = True
    thread.join(timeout=5)


@pytest.mark.asyncio
async def test_react_agent_v2_with_streamable_http_mcp(start_mcp_servers):
    # Initialize agentscope with model configs including dashscope_chat and openai_chat with custom base_url
    model_name = "qwen-plus"
    custom_api_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"

    agentscope.init(
        model_configs=[
            {
                "config_name": "my_config",
                "model_type": "dashscope_chat",
                "model_name": "qwen-plus",
            },
            {
                "config_name": "my_config2",
                "client_args": {
                    "base_url": custom_api_url,
                },
                "api_key": "dummy_api_key_for_test",
                "model_type": "openai_chat",
                "model_name": model_name,
            },
        ],
    )
    OpenAIFormatter.supported_model_regexes.append(model_name)

    # Setup toolkit with MCP servers URLs as in example
    toolkit = ServiceToolkit()
    toolkit.add_mcp_servers(
        {
            "mcpServers": {
                "add-tool": {
                    "type": "sse",
                    "url": "http://127.0.0.1:8001/sse_app/sse",
                },
                "multiply-tool": {
                    "type": "streamable_http",
                    "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
                },
            },
        },
    )

    agent = ReActAgentV2(
        name="Friday",
        max_iters=3,
        model_config_name="my_config",
        service_toolkit=toolkit,
        sys_prompt="You're a helpful assistant named Friday.",
    )

    # Compose a message to trigger both add and multiply tools via MCP servers
    user_msg = Msg(
        "user",
        "Calculate 2345 multiplied by 3456, then add 4567 to the result, what is the final outcome?",
        "user",
    )

    # Run the agent synchronously in a thread-safe way because agent() is sync
    loop = asyncio.get_event_loop()
    res_msg = await loop.run_in_executor(None, agent, user_msg)

    # The expected answer is 2345*3456 + 4567 = 8107920 + 4567 = 8112487
    expected_answer = "8112487"

    # The agent's response content should contain the expected answer as a substring
    assert expected_answer in res_msg.content, f"Expected answer {expected_answer} not found in response: {res_msg.content}"[0m
