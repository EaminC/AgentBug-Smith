    import uvicorn
    import examples.reactv2_agent_with_mcp.code.mcp_servers as mcp_servers

    # Run uvicorn server in a thread
    config = uvicorn.Config(mcp_servers.main_app, host="127.0.0.1", port=8001, log_level="critical")
    server = uvicorn.Server(config)

    thread = threading.Thread(target=server.run, daemon=True)
    thread.start()

    # Wait for server to be ready by polling the port
    for _ in range(30):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            result = sock.connect_ex(("127.0.0.1", 8001))
            if result == 0:
                break
        time.sleep(0.5)
    else:
        pytest.fail("MCP server did not start in time")

    yield

    # Shutdown server (uvicorn server does not have a direct stop method, so rely on daemon thread exit)
    # No explicit shutdown needed here


