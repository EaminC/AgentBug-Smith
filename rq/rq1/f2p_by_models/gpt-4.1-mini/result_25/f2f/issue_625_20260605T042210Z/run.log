        name="Friday",
        max_iters=3,
        model_config_name="my_config",
        service_toolkit=toolkit,
        sys_prompt="You're a helpful assistant named Friday.",
    )

    # Compose a message that triggers both add and multiply tools
    user_msg = Msg(
        "user",
        "Calculate 2345 multiplied by 3456, then add 4567 to the result, what is the final outcome?",
        "user",
    )

    # Call the agent synchronously (blocking)
    res_msg = agent(user_msg)

    # The expected result is (2345 * 3456) + 4567 = 8107927
    # The agent should return this number in the content
    expected_answer = "8107927"

    # Assert the expected answer is in the response content
    assert expected_answer in res_msg.content, f"Expected {expected_answer} in response but got: {res_msg.content}"[0m
