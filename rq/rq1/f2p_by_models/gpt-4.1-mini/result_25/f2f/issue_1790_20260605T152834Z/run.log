class DummyAgent(BaseModel):
    name: str = "dummy_agent"


def test_watsonx_embedder_usage():
    """
    Test that Crew can be created with a Watsonx embedder configuration without
    raising an error about missing OpenAI API key.
    This test fails on the buggy codebase due to fallback to OpenAI embedder
    requiring an API key, and passes on the fixed codebase.
    """

    # Dummy Watsonx embedder config
    watson_embedder_config = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy-watsonx-url",
            "api_key": "dummy-api-key",
            "project_id": "dummy-project-id",
        },
    }

    # Create a StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Create a Crew with the Watsonx embedder config and the knowledge source
    # The buggy code will raise ValueError about missing OpenAI API key
    # The fixed code will accept the Watsonx embedder config and not raise
    crew = Crew(
        agents=[DummyAgent()],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=watson_embedder_config,
        process=None,
        verbose=False,
    )

    # Validate that the Crew's internal knowledge object is created and has the embedder config set
    assert crew._knowledge is not None, "Crew knowledge should be initialized"
    assert isinstance(crew._knowledge, Knowledge), "Crew knowledge should be a Knowledge instance"
    assert crew._knowledge.embedder_config == watson_embedder_config, "Embedder config should match Watsonx config"

    # Validate that the knowledge source inside crew._knowledge includes our string_source
    assert any(
        isinstance(src, StringKnowledgeSource) and src.content == string_source.content
        for src in crew._knowledge.sources
    ), "StringKnowledgeSource should be included in knowledge sources"

    # Validate that the embedder config is not None and has provider 'watson'
    assert crew._knowledge.embedder_config.get("provider") == "watson", "Embedder provider should be 'watson'"[0m
