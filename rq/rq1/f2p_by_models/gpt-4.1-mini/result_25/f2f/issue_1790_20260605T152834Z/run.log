def test_watsonx_embedder_usage(monkeypatch):
    """
    Test that a Crew with a Watsonx embedder configuration does not raise an error
    about missing OpenAI API key and correctly sets the embedder config.
    This test fails on the buggy codebase and passes after the fix.
    """

    # Prepare a minimal string knowledge source content
    content = "User's name is John. He is 30 years old and lives in San Francisco."

    # Watsonx embedder config example (dummy values)
    watsonx_embedder = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy-watsonx-api-url",
            "api_key": "dummyapikey",
            "project_id": "dummyprojectid",
        },
    }

    # Create StringKnowledgeSource with embedder config
    string_source = StringKnowledgeSource(content=content)

    # Create Crew with knowledge_sources and watsonx embedder config
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=watsonx_embedder,
        process=None,
        verbose=False,
    )

    # The Crew should create _knowledge with the embedder config set correctly
    knowledge = getattr(crew, "_knowledge", None)
    assert knowledge is not None, "Crew did not create _knowledge attribute"

    # The knowledge should be an instance of Knowledge
    assert isinstance(knowledge, Knowledge)

    # The embedder_config should match watsonx_embedder dict
    assert knowledge.embedder_config == watsonx_embedder

    # The sources should include our string_source
    assert string_source in knowledge.sources

    # The storage attribute of the knowledge should be None or properly set
    # (We do not test storage internals here)
    assert hasattr(knowledge, "storage")

    # Try to save documents via the knowledge storage to ensure no fallback to OpenAI occurs
    # This will raise if storage is None or misconfigured, but we only check no OpenAI key error
    if knowledge.storage is not None:
        # We patch storage.save to a no-op to avoid side effects
        original_save = knowledge.storage.save
        knowledge.storage.save = lambda chunks: None
        try:
            string_source.storage = knowledge.storage
            string_source._save_documents()
        finally:
            knowledge.storage.save = original_save

    # If no exceptions raised, test passes


