import pytest
import numpy as np

from pydantic import ValidationError

from crewai.crew import Crew
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.knowledge import Knowledge
from crewai.utilities.embedding_configurator import EmbeddingConfigurator


class DummyWatsonEmbeddingFunction:
    def __init__(self, model, api_url, api_key, project_id):
        self.model = model
        self.api_url = api_url
        self.api_key = api_key
        self.project_id = project_id

    def embed(self, texts):
        # Return dummy embeddings (list of numpy arrays)
        return [np.zeros(10) for _ in texts]


def dummy_create_embedding_function(embedder_config):
    # This dummy replaces the internal embedding function creation for watson provider
    if embedder_config.get("provider") == "watson":
        config = embedder_config.get("config", {})
        return DummyWatsonEmbeddingFunction(
            model=config.get("model"),
            api_url=config.get("api_url"),
            api_key=config.get("api_key"),
            project_id=config.get("project_id"),
        )
    # fallback to None for other providers
    return None


@pytest.fixture(autouse=True)
def patch_embedding_configurator(monkeypatch):
    # Patch the internal method that creates embedding functions to use dummy for watson
    # We patch the EmbeddingConfigurator._create_embedding_function method indirectly
    # by patching the function it calls internally if possible.
    # Since we cannot mock the exact method with unittest.mock, we patch the class method.
    original_method = EmbeddingConfigurator._create_embedding_function

    def patched_create_embedding_function(self, embedder_config):
        if embedder_config.get("provider") == "watson":
            return dummy_create_embedding_function(embedder_config)
        return original_method(self, embedder_config)

    monkeypatch.setattr(EmbeddingConfigurator, "_create_embedding_function", patched_create_embedding_function)
    yield
    monkeypatch.setattr(EmbeddingConfigurator, "_create_embedding_function", original_method)


def test_watson_embedder_usage_does_not_require_openai_key():
    """
    Test that configuring a Crew with a StringKnowledgeSource and a Watson embedder
    does not raise an error about missing OpenAI API key and correctly sets the embedder.
    """

    # Setup dummy Watson embedder config
    watson_embedder_config = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy.watsonx.api",
            "api_key": "dummyapikey",
            "project_id": "dummyprojectid",
        },
    }

    # Create a StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Create Crew with knowledge_sources and watson embedder config
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=watson_embedder_config,
        process=None,
        verbose=False,
    )

    # The Crew should have a _knowledge attribute with embedder_config set to watson config
    knowledge = getattr(crew, "_knowledge", None)
    assert knowledge is not None, "Crew did not initialize _knowledge attribute"
    assert isinstance(knowledge, Knowledge), "_knowledge is not an instance of Knowledge"
    assert knowledge.embedder_config == watson_embedder_config, "Embedder config not set correctly"

    # The storage attribute of the knowledge source should be set and not None
    # This implies the embedder function was created without error
    storage = string_source.storage
    assert storage is not None, "Knowledge source storage is None, embedder might not be set"

    # The embedder function inside storage should be the dummy watson embedder function
    embedder_func = getattr(storage, "embedding_function", None)
    assert embedder_func is not None, "Embedding function not set in storage"
    # Check that the embedder function is our dummy watson embedder function by attribute
    assert hasattr(embedder_func, "model") and embedder_func.model == "ibm/slate-125m-english-rtrvr"

    # Try embedding a sample text to confirm dummy embedder works
    embeddings = embedder_func.embed(["test text"])
    assert isinstance(embeddings, list), "Embeddings output is not a list"
    assert all(isinstance(e, np.ndarray) for e in embeddings), "Embeddings are not numpy arrays"
    assert embeddings[0].shape == (10,), "Embedding vector shape is incorrect"[0m
