[32mimport pytest
from typing import Optional, Dict, Any
from crewai.crew import Crew
from crewai.knowledge.source import StringKnowledgeSource
from crewai.knowledge.knowledge import Knowledge
from crewai.knowledge.storage.knowledge_storage import KnowledgeStorage


def test_watsonx_embedder_configuration_does_not_require_openai_key():
    """
    Test that configuring a Crew with a Watsonx embedder does not raise an error
    about missing OpenAI API key and correctly sets up the knowledge storage.

    This test reproduces the bug where Watsonx embedder configuration
    incorrectly falls back to OpenAI embedding and raises a ValueError.

    After the fix, the Crew should accept the Watsonx embedder config without error.
    """

    # Prepare a Watsonx embedder config as per the issue description
    watson_embedder_config = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy-watsonx-url.com",
            "api_key": "dummy_api_key",
            "project_id": "dummy_project_id",
        }
    }

    # Create a StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Create the Crew with the knowledge_sources and embedder config
    # This should not raise an error about missing OpenAI API key
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=watson_embedder_config,
        process=None,
        verbose=False,
    )

    # The Crew's knowledge should be initialized and use the embedder config
    # The knowledge attribute is private _knowledge, but we can check knowledge_sources and embedder_config
    knowledge = getattr(crew, "_knowledge", None)
    assert knowledge is not None, "Crew did not initialize knowledge with embedder config"

    # The knowledge should have the sources we provided
    assert isinstance(knowledge, Knowledge)
    assert len(knowledge.sources) == 1
    assert knowledge.sources[0].content == string_source.content

    # The knowledge should have the embedder_config set to the watson config
    assert knowledge.embedder_config == watson_embedder_config

    # The knowledge storage should be initialized (not None)
    # And should not raise error on save (simulate save call)
    storage: Optional[KnowledgeStorage] = knowledge.storage
    assert storage is not None, "Knowledge storage was not initialized"

    # The storage should not raise ValueError due to missing OpenAI key when saving documents
    # We test this by calling _save_documents on the knowledge source, which calls storage.save
    # This indirectly tests that storage was created with the correct embedder config
    # We expect no ValueError about OpenAI key here
    # Note: _save_documents is protected, but we call it for test purpose
    try:
        knowledge.sources[0]._save_documents()
    except ValueError as e:
        pytest.fail(f"Saving documents raised ValueError unexpectedly: {e}")

    # If no exceptions were raised, test passes


# The test is designed so that on the buggy codebase, it will raise ValueError about missing OpenAI API key,
# causing test failure.
# After the fix, the test will pass without errors.[0m
