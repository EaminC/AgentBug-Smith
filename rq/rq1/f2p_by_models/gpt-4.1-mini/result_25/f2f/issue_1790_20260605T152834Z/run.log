[32mimport os
import pytest

from pydantic import ValidationError

from crewai.crew import Crew
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.knowledge.knowledge import Knowledge


def test_watsonx_embedder_usage(monkeypatch):
    """
    Test that Crew can be created with a Watsonx embedder configuration without raising OpenAI API key error.
    This reproduces the bug where Watsonx embedder config falls back to OpenAI and raises a ValueError.
    The fix ensures that the embedder config is respected and no OpenAI key is required.
    """

    # Setup a Watsonx embedder config as per the bug report
    watson_embedder_config = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://example-watsonx-api-url.com",
            "api_key": "dummy-watsonx-api-key",
            "project_id": "dummy-project-id",
        },
    }

    # Create a StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Create a Crew instance with the Watsonx embedder and the knowledge source
    # This should NOT raise a ValueError about missing OpenAI API key
    crew = None
    try:
        crew = Crew(
            agents=[],
            tasks=[],
            knowledge_sources=[string_source],
            embedder=watson_embedder_config,
            process="sequential",
            verbose=True,
        )
    except ValueError as e:
        # Fail the test if the error message is about OpenAI API key missing
        if "OpenAI API key" in str(e):
            pytest.fail(
                "Crew creation failed due to missing OpenAI API key when using Watsonx embedder."
            )
        else:
            raise

    # Assert that the crew was created and knowledge is initialized with correct embedder config
    assert crew is not None
    # The crew should have a _knowledge attribute with embedder_config matching watson_embedder_config
    knowledge = getattr(crew, "_knowledge", None)
    assert knowledge is not None, "Crew _knowledge attribute should be initialized."
    assert isinstance(knowledge, Knowledge)
    assert knowledge.embedder_config == watson_embedder_config
    # The knowledge sources inside knowledge should include the string_source
    assert string_source in knowledge.sources


def test_crew_with_invalid_embedder_falls_back_to_default():
    """
    Test that if embedder config is empty or missing provider, the default OpenAI embedder is used,
    which requires an OpenAI API key and raises ValueError if missing.
    This test ensures the fallback behavior is as expected.
    """
    string_source = StringKnowledgeSource(
        content="Some content for fallback test."
    )

    # Provide empty embedder config to trigger fallback
    empty_embedder_config = {}

    with pytest.raises(ValueError) as excinfo:
        Crew(
            agents=[],
            tasks=[],
            knowledge_sources=[string_source],
            embedder=empty_embedder_config,
            process="sequential",
            verbose=True,
        )
    assert "OpenAI API key" in str(excinfo.value)[0m
