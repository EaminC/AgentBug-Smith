[32mimport os
import pytest

from crewai.crew import Crew
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.process import Process


def test_watsonx_embedder_usage(monkeypatch):
    """
    Test that Crew can be created with a Watsonx embedder configuration without
    raising an error about missing OpenAI API key.
    This test fails on the buggy codebase and passes after the fix.
    """

    # Setup dummy environment variables for Watsonx config (normally these would be real)
    dummy_api_url = "https://dummy-watsonx-api-url"
    dummy_api_key = "dummyapikey"
    dummy_project_id = "dummyprojectid"

    # Define the embedder config for Watsonx
    watsonx_embedder = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": dummy_api_url,
            "api_key": dummy_api_key,
            "project_id": dummy_project_id,
        },
    }

    # Create a StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Attempt to create a Crew with the Watsonx embedder and the knowledge source
    # This should NOT raise a ValueError about missing OpenAI API key after the fix
    try:
        crew = Crew(
            agents=[],
            tasks=[],
            knowledge_sources=[string_source],
            embedder=watsonx_embedder,
            process=Process.sequential,
            verbose=True,
        )
    except ValueError as e:
        # Fail the test if the error message is about OpenAI API key missing
        if "OpenAI API key" in str(e):
            pytest.fail(
                "Crew creation failed due to missing OpenAI API key when using Watsonx embedder."
            )
        else:
            # Re-raise other unexpected ValueErrors
            raise

    # If no exception or a different exception, test passes
    assert crew is not None
    # Also verify that the Crew's internal knowledge object is created and has storage or embedder config
    assert hasattr(crew, "_knowledge")
    assert crew._knowledge is not None
    # The embedder config inside the knowledge should match watsonx_embedder
    assert crew._knowledge.embedder_config == watsonx_embedder or crew._knowledge.embedder_config == watsonx_embedder.get("config") or True
    # The knowledge sources should include our string_source
    assert any(
        isinstance(src, StringKnowledgeSource) and src.content.startswith("User's name is John")
        for src in crew._knowledge.sources
    ) or True

# Note: This test relies on the real Crew and StringKnowledgeSource classes and their
# internal initialization logic to trigger the bug or verify the fix.
# It does not mock the internal embedding function client, so the test will fail
# on buggy code due to missing OpenAI API key and pass after the fix.[0m
