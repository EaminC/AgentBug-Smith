import os
from pathlib import Path

import numpy as np

from crewai.crew import Crew
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.knowledge.storage.knowledge_storage import KnowledgeStorage


def test_watsonx_embedder_usage(monkeypatch):
    """
    Test that a Crew configured with a Watsonx embedder does not raise an error
    asking for OpenAI API key, and correctly uses the Watsonx embedder config.

    This test reproduces the bug described in issue #1790 where the embedder config
    with provider "watson" causes an error asking for OpenAI API key.

    The test will fail on the buggy codebase (raising ValueError about OpenAI key),
    and pass on the fixed codebase.
    """

    # Setup a dummy Watsonx embedder config
    watson_embedder_config = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy-watsonx-api-url",
            "api_key": "dummyapikey",
            "project_id": "dummyprojectid",
        },
    }

    # Create a StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Create a Crew with the knowledge_sources and the Watsonx embedder config
    # This should NOT raise an error about missing OpenAI API key
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=watson_embedder_config,
        process="sequential",
        verbose=False,
    )

    # The Crew's internal knowledge storage should be initialized with the Watsonx embedder config
    knowledge = crew._knowledge
    assert knowledge is not None, "Crew knowledge should be initialized"
    storage = knowledge.storage
    assert storage is not None, "Knowledge storage should be initialized"

    # The embedder config used in storage should match the Watsonx config
    # The storage has an embedder_config attribute or similar
    # We check the embedder config dict keys and provider
    embedder_config = getattr(storage, "embedder_config", None)
    if embedder_config is None:
        # fallback: check knowledge.embedder_config
        embedder_config = getattr(knowledge, "embedder_config", None)
    assert embedder_config is not None, "Embedder config should be set in knowledge or storage"
    assert embedder_config.get("provider") == "watson", "Embedder provider should be 'watson'"
    assert embedder_config.get("config", {}).get("model") == "ibm/slate-125m-english-rtrvr"

    # Also test that saving documents does not raise error due to missing storage or embedder
    # We patch the storage.save method to a dummy function to avoid actual network calls
    def dummy_save(chunks):
        # Just record that save was called
        dummy_save.called = True

    dummy_save.called = False
    storage.save = dummy_save

    # Prepare chunks for the knowledge source and save them
    string_source.chunks = ["dummy chunk"]
    string_source.storage = storage
    string_source._save_documents()
    assert dummy_save.called, "Storage save method should be called without error"


# Run the test standalone if invoked directly
if __name__ == "__main__":
    import sys
    import pytest

    sys.exit(pytest.main([__file__]))[0m
