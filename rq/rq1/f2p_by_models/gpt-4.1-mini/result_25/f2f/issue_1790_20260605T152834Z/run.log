import pytest

from crewai.crew import Crew
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.process import Process


def test_watsonx_embedder_config_usage(monkeypatch):
    """
    Test that Crew can be created with a Watsonx embedder configuration without
    requiring an OpenAI API key, i.e., it does not raise ValueError about missing OpenAI key.

    This test covers the bug where using Watsonx embedder config caused fallback to OpenAI embedder
    and raised an error asking for OpenAI API key.

    The test should fail on the buggy codebase (raising ValueError about missing OpenAI key),
    and pass on the fixed codebase (no such error).
    """

    # Setup dummy Watsonx embedder config
    watson_embedder_config = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy-watsonx-api-url",
            "api_key": "dummy-api-key",
            "project_id": "dummy-project-id",
        },
    }

    # Create a simple StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Attempt to create a Crew with the Watsonx embedder config and the knowledge source
    # This should NOT raise a ValueError about missing OpenAI API key on fixed codebase
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=watson_embedder_config,
        process=Process.sequential,
        verbose=False,
    )

    # The Crew instance should have _knowledge attribute set with the embedder config applied
    # Check that the embedder config is exactly the one we passed
    knowledge = getattr(crew, "_knowledge", None)
    assert knowledge is not None, "Crew _knowledge attribute should be initialized"
    assert knowledge.embedder_config == watson_embedder_config, "Embedder config should match Watsonx config"

    # Also check that the knowledge sources inside _knowledge include our string_source
    assert string_source in knowledge.sources, "Knowledge sources should include the string_source"

    # If no exception raised and assertions passed, test passes


if __name__ == "__main__":
