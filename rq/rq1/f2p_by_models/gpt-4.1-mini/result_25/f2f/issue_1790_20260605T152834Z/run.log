from crewai.process import Process


def test_watsonx_embedder_usage(monkeypatch):
    """
    Test that Crew can be created with a Watsonx embedder configuration without
    raising an error about missing OpenAI API key.
    This test should fail on buggy code (raises ValueError about OpenAI API key)
    and pass on fixed code.
    """

    # Setup dummy environment variables for Watsonx config (normally required)
    os.environ["WATSONX_URL"] = "https://dummy-watsonx-url"
    os.environ["WATSONX_APIKEY"] = "dummy-api-key"
    os.environ["WATSONX_PROJECT_ID"] = "dummy-project-id"

    # Prepare embedder config for Watsonx
    watson_embedder = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": os.environ["WATSONX_URL"],
            "api_key": os.environ["WATSONX_APIKEY"],
            "project_id": os.environ["WATSONX_PROJECT_ID"],
        },
    }

    # Create a StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Attempt to create Crew with Watsonx embedder and knowledge_sources
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=watson_embedder,
        process=Process.sequential,
        verbose=False,
    )

    # The Crew instance should have _knowledge attribute set with embedder_config
    # Check that the embedder config is correctly assigned in the knowledge object
    knowledge = getattr(crew, "_knowledge", None)
    assert knowledge is not None, "Crew _knowledge attribute should be set"
    assert knowledge.embedder_config == watson_embedder, "Embedder config should match Watsonx config"

    # Also check that no ValueError about OpenAI API key is raised during creation
    # (If buggy, this test will error out before this point)


