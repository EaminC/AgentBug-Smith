def test_watsonx_embedder_usage():
    """
    Test that Crew correctly uses Watsonx embedder configuration without falling back to OpenAI.
    This test reproduces the bug where missing OpenAI API key is requested even if Watsonx embedder is configured.
    The test should fail on buggy code and pass after the fix.
    """

    # Setup a StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Define a dummy Watsonx embedder config
    watson_embedder_config = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy-watsonx-api-url",
            "api_key": "dummy_api_key",
            "project_id": "dummy_project_id",
        }
    }

    # Create Crew with knowledge_sources and embedder set to Watsonx config
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=watson_embedder_config,
        process=None,
        verbose=False,
    )

    # The knowledge attribute should be created internally with the correct embedder config
    knowledge = getattr(crew, "_knowledge", None)
    assert knowledge is not None, "Crew did not create knowledge attribute"

    # The embedder_config of knowledge should match watson_embedder_config
    assert knowledge.embedder_config == watson_embedder_config, "Embedder config mismatch"

    # The sources in knowledge should include the string_source
