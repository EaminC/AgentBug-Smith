import pytest
from pathlib import Path

# We import Crew and StringKnowledgeSource from the installed package
# The test is designed to fail on buggy codebase (missing proper embedder handling for Watsonx)
# and pass on fixed codebase (correct embedder usage).
from crewai.crew import Crew
from crewai.knowledge.source import StringKnowledgeSource


def test_watsonx_embedder_usage():
    """
    Test that Crew can be instantiated with a Watsonx embedder configuration
    without raising an error asking for OpenAI API key.
    This test fails on buggy codebase and passes on fixed codebase.
    """
    # Setup dummy environment variables for Watsonx embedder config
    os.environ["WATSONX_URL"] = "https://dummy.watsonx.api"
    os.environ["WATSONX_APIKEY"] = "dummyapikey"
    os.environ["WATSONX_PROJECT_ID"] = "dummyprojectid"

    # Prepare embedder config for Watsonx
    embedder_config = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": os.environ["WATSONX_URL"],
            "api_key": os.environ["WATSONX_APIKEY"],
            "project_id": os.environ["WATSONX_PROJECT_ID"],
        },
    }

    # Create a StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Attempt to create a Crew with the Watsonx embedder and the knowledge source
    # On buggy codebase, this raises ValueError about missing OpenAI API key.
    # On fixed codebase, this succeeds without error.
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=embedder_config,
        process=None,
        verbose=False,
    )

    # Assert the Crew instance is created and knowledge is set
    # The knowledge attribute is internal and may be private, but we check it exists and is not None
    # This confirms the embedder config was accepted properly.
    assert crew is not None
    # The Crew should have _knowledge attribute set (private), which should have embedder_config matching input
    knowledge = getattr(crew, "_knowledge", None)
    assert knowledge is not None
    assert knowledge.embedder_config == embedder_config
    # Also verify the knowledge sources are correctly assigned
    assert len(knowledge.sources) == 1
    assert knowledge.sources[0].content == string_source.content

    # Clean up environment variables
    del os.environ["WATSONX_URL"]
    del os.environ["WATSONX_APIKEY"]
    del os.environ["WATSONX_PROJECT_ID"][0m
