[32mimport os
import pytest

from crewai.crew import Crew
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.process import Process


@pytest.mark.parametrize("embedder_config", [
    # Buggy config: Watson embedder config triggers OpenAI API key error
    {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy-watsonx-url",
            "api_key": "dummy_api_key",
            "project_id": "dummy_project_id",
        },
    },
    # Control config: OpenAI embedder config (should work normally)
    {
        "provider": "openai",
        "config": {"model": "text-embedding-3-small"},
    }
])
def test_crew_with_watson_embedder_does_not_require_openai_api_key(embedder_config):
    """
    Test that creating a Crew with a Watsonx embedder config does not raise an error
    about missing OpenAI API key, and that the embedder config is accepted properly.

    This test fails on buggy codebase (raises ValueError about OpenAI API key),
    and passes on fixed codebase.
    """
    # Prepare a simple StringKnowledgeSource with content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Create Crew with knowledge_sources and embedder config
    # This triggers the internal Knowledge and KnowledgeStorage initialization
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=embedder_config,
        process=Process.sequential,
        verbose=False,
    )

    # Assert the Crew instance is created and has _knowledge attribute set
    # _knowledge is internal but should be set if knowledge_sources are processed
    assert crew is not None
    assert hasattr(crew, "_knowledge")
    assert crew._knowledge is not None

    # The embedder config inside _knowledge should match what we passed
    assert crew._knowledge.embedder_config == embedder_config

    # The sources inside _knowledge should include our string_source
    assert string_source in crew._knowledge.sources

    # Attempt to save documents via the knowledge storage to ensure no errors
    # This indirectly tests that the embedder function was created without OpenAI key error
    if crew._knowledge.storage:
        # The storage.save method should accept chunks without errors
        # We simulate chunks to avoid actual embedding calls
        crew._knowledge.storage.save([])  # empty chunks list should not error
    else:
        # Storage might be None if no knowledge storage was created, still acceptable
        pass

