import pytest

from crewai.crew import Crew
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.process import Process


def test_watsonx_embedder_configuration():
    """
    Test that Crew can be created with a Watsonx embedder configuration
    without raising an error about missing OpenAI API key.
    """

    # Dummy Watsonx embedder config (values do not need to be real for this test)
    watson_embedder = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy-watsonx-api-url",
            "api_key": "dummy-api-key",
            "project_id": "dummy-project-id",
        },
    }

    # Create a StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Attempt to create a Crew with the Watsonx embedder config and knowledge_sources
    # This should NOT raise an error about missing OpenAI API key.
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=watson_embedder,
        process=Process.sequential,
        verbose=False,
    )

    # Assert the Crew object is created and has knowledge_sources set
    assert crew is not None
    assert crew.knowledge_sources is not None
    assert len(crew.knowledge_sources) == 1
    assert crew.embedder == watson_embedder

    # Also assert that the knowledge attribute is properly created internally
    # (the fix ensures knowledge is created from knowledge_sources and embedder config)
    # The knowledge attribute is private _knowledge, but test its presence and type
    assert hasattr(crew, "_knowledge")
    assert crew._knowledge is not None

    # The storage inside the knowledge should not be None (indicating embedder setup)
    assert crew._knowledge.storage is not None

    # The embedder config inside knowledge should match watson_embedder
    assert crew._knowledge.embedder_config == watson_embedder


if __name__ == "__main__":
    pytest.main([__file__])[0m
