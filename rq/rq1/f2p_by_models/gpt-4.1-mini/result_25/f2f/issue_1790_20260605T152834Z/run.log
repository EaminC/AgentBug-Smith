[32mimport os
import pytest
import numpy as np

from crewai.crew import Crew
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.knowledge.knowledge import Knowledge


def test_watsonx_embedder_usage(monkeypatch):
    """
    Test that a Crew configured with a Watsonx embedder does not raise an error
    about missing OpenAI API key and correctly sets the embedder config.
    This test fails on buggy code (raises ValueError about OpenAI API key)
    and passes on fixed code.
    """

    # Dummy Watsonx embedder config (fake values)
    watsonx_embedder = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://fake-watsonx-api-url",
            "api_key": "fake-api-key",
            "project_id": "fake-project-id",
        },
    }

    # Create a StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Create a Crew with the knowledge_sources and the Watsonx embedder config
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=watsonx_embedder,
        process=None,
        verbose=False,
    )

    # The Crew should have a _knowledge attribute of type Knowledge
    # and the embedder_config inside _knowledge should match watsonx_embedder
    assert hasattr(crew, "_knowledge")
    assert isinstance(crew._knowledge, Knowledge)
    assert crew._knowledge.embedder_config == watsonx_embedder

    # Also the knowledge_sources inside _knowledge should include our string_source
    assert string_source in crew._knowledge.sources

    # Try to save documents to storage to trigger embedder usage
    # This should not raise a ValueError about OpenAI API key
    # Instead, it should either succeed or raise a different error if any
    # We just want to confirm no OpenAI key error is raised
    try:
        # The storage attribute might be None or set; if set, try saving chunks
        if string_source.storage:
            # We fake some chunks to test save
            string_source.chunks = ["dummy chunk"]
            string_source._save_documents()
    except ValueError as e:
        # Fail if error message mentions OpenAI API key missing
        assert "OpenAI API key" not in str(e), "OpenAI API key error raised unexpectedly"


if __name__ == "__main__":
    pytest.main([__file__])[0m
