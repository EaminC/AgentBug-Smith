def test_watsonx_embedder_configuration():
    """
    Test that Crew can be created with a Watsonx embedder configuration
    without raising an error about missing OpenAI API key.
    This test fails on buggy code (raises ValueError about OpenAI API key)
    and passes on fixed code.
    """

    # Dummy Watsonx embedder config
    watsonx_embedder = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy-watsonx-url.example.com",
            "api_key": "dummyapikey",
            "project_id": "dummyprojectid",
        }
    }

    # Create a StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Attempt to create a Crew with the Watsonx embedder config and knowledge_sources
    # On buggy code, this should raise a ValueError about missing OpenAI API key
    # On fixed code, this should succeed without error
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=watsonx_embedder,
        process=None,
        verbose=False,
    )

    # Assert that the crew's knowledge attribute is set and uses the embedder config
    # This indirectly confirms that the embedder config was accepted
    assert crew is not None
    # The Crew model validator should create _knowledge attribute with embedder config
    knowledge = getattr(crew, "_knowledge", None)
    assert knowledge is not None
    assert knowledge.embedder_config == watsonx_embedder

    # Also verify that the knowledge sources are preserved
    assert len(knowledge.sources) == 1
    assert knowledge.sources[0].content == string_source.content

    # No exceptions should be raised during Crew creation


