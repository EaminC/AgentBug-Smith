[32mimport os
import pytest
from pathlib import Path

from crewai.crew import Crew
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.knowledge.knowledge import Knowledge
from crewai.knowledge.storage.knowledge_storage import KnowledgeStorage


def test_watsonx_embedder_usage(monkeypatch):
    """
    Test that Crew can be created with a Watsonx embedder configuration without
    raising an error about missing OpenAI API key.

    This test reproduces the bug where using Watsonx embedder incorrectly falls back
    to OpenAI embedder and raises a ValueError about missing OpenAI API key.

    After the fix, the Watsonx embedder config is respected and no such error occurs.
    """

    # Dummy Watsonx config values (not real keys)
    watsonx_config = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy-watsonx-api-url",
            "api_key": "dummy-watsonx-api-key",
            "project_id": "dummy-project-id",
        },
    }

    # Create a simple StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # We expect no exception when creating Crew with Watsonx embedder config
    # If buggy, it will raise ValueError about missing OpenAI API key
    crew = None
    try:
        crew = Crew(
            agents=[],
            tasks=[],
            knowledge_sources=[string_source],
            embedder=watsonx_config,
            process=None,
            verbose=False,
        )
    except ValueError as e:
        # Fail the test if the error message is about OpenAI API key missing
        if "OpenAI API key" in str(e):
            pytest.fail(
                "Crew creation failed due to missing OpenAI API key when using Watsonx embedder"
            )
        else:
            # Re-raise other unexpected ValueErrors
            raise

    # Additional sanity checks on the created crew
    assert crew is not None
    # The crew should have _knowledge attribute set with embedder_config matching watsonx_config
    knowledge = getattr(crew, "_knowledge", None)
    assert knowledge is not None
    assert isinstance(knowledge, Knowledge)
    # The embedder_config inside knowledge should match watsonx_config
    assert knowledge.embedder_config == watsonx_config
    # The knowledge sources inside knowledge should include our string_source
    assert string_source in knowledge.sources

    # The storage inside knowledge should be None or a KnowledgeStorage instance
    # (depending on fix, but must not raise error)
    storage = knowledge.storage
    assert storage is None or isinstance(storage, KnowledgeStorage)


# This test file intentionally does not mock internal embedding clients,
# to ensure the real codepath is exercised and the bug is caught or fixed.[0m
