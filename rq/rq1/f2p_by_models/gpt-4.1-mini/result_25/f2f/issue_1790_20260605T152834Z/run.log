ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV GITHUB_TOKEN="ghp_key"
ENV HF_TOKEN="hf_key"
# --- end inject ---

WORKDIR /app

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Copy entire repository into container
COPY . .

# Detect src/ layout or imports from src to avoid editable install if found
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." . 2>/dev/null; then \
    python -m pip install --upgrade pip setuptools wheel && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai && \
    pip install -r requirements.txt 2>/dev/null || true && \
    # Use PYTHONPATH to avoid editable install that breaks src/ imports \
    true; \
  else \
    python -m pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt 2>/dev/null || true && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
  fi

# Set PYTHONPATH if src/ layout detected to avoid import conflicts
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." . 2>/dev/null; then \
    echo "src layout detected, setting PYTHONPATH=/app"; \
  fi
ENV PYTHONPATH=/app

# Preflight import check to fail fast if core modules missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Assumption: main entrypoint is in src/my_project/main.py, run with python src/my_project/main.py
CMD [ "python", "src/my_project/main.py" ][0m
