import pytest
from typing import Optional, Dict, Any

from pydantic import BaseModel

from crewai.crew import Crew
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.knowledge.storage.knowledge_storage import KnowledgeStorage


class DummyWatsonEmbedding:
    def embed(self, texts):
        # Return dummy embeddings (list of lists of floats)
        return [[0.1] * 10 for _ in texts]


class DummyKnowledgeStorage(KnowledgeStorage):
    def __init__(self, embedder_config: Optional[Dict[str, Any]] = None):
        super().__init__()
        self.embedder_config = embedder_config
        self.embedding_function = None
        if embedder_config and embedder_config.get("provider") == "watson":
            # Simulate watson embedding function setup
            self.embedding_function = DummyWatsonEmbedding()
        else:
            # fallback to default (which would raise error if OpenAI key missing)
            self.embedding_function = None

    def save(self, chunks):
        # Dummy save method, do nothing
        pass


def test_watson_embedder_usage(monkeypatch):
    """
    Test that when using Watson provider embedder config, no OpenAI API key error is raised,
    and the embedder is correctly set to Watson embedding function.
    """

    # Patch KnowledgeStorage in StringKnowledgeSource to use DummyKnowledgeStorage
    # so we avoid real network calls and OpenAI key requirement
    original_storage_init = StringKnowledgeSource.__fields__['storage'].default_factory

    def dummy_storage_factory():
        return DummyKnowledgeStorage()

    # Patch default_factory to dummy storage factory
    StringKnowledgeSource.__fields__['storage'].default_factory = dummy_storage_factory

    # Compose embedder config for Watson provider
    watson_embedder_config = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy-watson-url",
            "api_key": "dummy_api_key",
            "project_id": "dummy_project_id",
        },
    }

    # Create a StringKnowledgeSource with the dummy storage
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco.",
        storage=DummyKnowledgeStorage(embedder_config=watson_embedder_config),
    )

    # Create Crew with the embedder config for Watson
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=watson_embedder_config,
        process=None,
        verbose=False,
    )

    # The storage inside the knowledge source should have the Watson embedding function set
    storage = string_source.storage
    assert storage is not None
    assert storage.embedding_function is not None
    # It should be our DummyWatsonEmbedding instance
    assert isinstance(storage.embedding_function, DummyWatsonEmbedding)

    # Also test that no ValueError about missing OpenAI key is raised
    # by trying to save documents (which would call embedding)
    try:
        string_source._save_documents()
    except ValueError as e:
        pytest.fail(f"Unexpected ValueError raised: {e}")

    # Restore original default_factory to avoid side effects
    StringKnowledgeSource.__fields__['storage'].default_factory = original_storage_init[0m
