class DummyWatsonEmbedder:
    def __init__(self, model, api_url, api_key, project_id):
        self.model = model
        self.api_url = api_url
        self.api_key = api_key
        self.project_id = project_id

    def embed(self, texts):
        # Return fixed dummy embeddings for testing
        return [np.ones(5) for _ in texts]


def test_watson_embedder_usage(monkeypatch):
    """
    Test that Crew with Watson embedder configuration does not raise OpenAI API key error
    and correctly sets up knowledge with the Watson embedder.
    """

    # Patch the internal embedding configurator to return our dummy watson embedder
    # This avoids real network calls and simulates watson embedder usage
    from crewai.utilities import embedding_configurator

    def dummy_configure_embedder(embedder_config):
        if embedder_config.get("provider") == "watson":
            config = embedder_config.get("config", {})
            return DummyWatsonEmbedder(
                model=config.get("model"),
                api_url=config.get("api_url"),
                api_key=config.get("api_key"),
                project_id=config.get("project_id"),
            )
        # fallback to original for others
        return embedding_configurator.configure_embedder_original(embedder_config)

    # Save original function to call fallback
    embedding_configurator.configure_embedder_original = embedding_configurator.configure_embedder
    monkeypatch.setattr(embedding_configurator, "configure_embedder", dummy_configure_embedder)

    # Prepare a crew with a StringKnowledgeSource and Watson embedder config
    watson_embedder_config = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy-watson-url",
            "api_key": "dummyapikey",
            "project_id": "dummyprojectid",
        },
    }

    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Create Crew with knowledge_sources and watson embedder config
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=watson_embedder_config,
        process=None,
        verbose=False,
    )

    # The knowledge attribute should be created internally and use the watson embedder
    # Access internal _knowledge attribute (should be set by model_validator)
    knowledge = getattr(crew, "_knowledge", None)
    assert knowledge is not None, "Crew did not create internal knowledge from knowledge_sources"

    # The embedder configured in knowledge.storage should be our DummyWatsonEmbedder instance
    storage = knowledge.storage
    assert storage is not None, "Knowledge storage is not initialized"
    embedder_func = getattr(storage, "_embedding_function", None)
    # The embedding function should be our DummyWatsonEmbedder instance or wrap it
    # We check that the embedder function has an embed method and matches dummy config
    assert embedder_func is not None, "Knowledge storage has no embedding function"
    assert hasattr(embedder_func, "embed"), "Embedding function does not have embed method"

    # Test that embedding function returns expected dummy embeddings
    embeddings = embedder_func.embed(["test text"])
    assert isinstance(embeddings, list), "Embedding function did not return a list"
    assert len(embeddings) == 1, "Embedding function returned wrong number of embeddings"
    assert np.allclose(embeddings[0], np.ones(5)), "Embedding function returned unexpected embeddings"


