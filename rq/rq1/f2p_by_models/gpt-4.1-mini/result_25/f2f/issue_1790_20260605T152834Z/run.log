import pytest

from crewai.crew import Crew
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.process import Process


@pytest.mark.parametrize("embedder_config", [
    {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy-watsonx-url.com",
            "api_key": "dummyapikey",
            "project_id": "dummyprojectid",
        }
    },
])
def test_watsonx_embedder_usage(embedder_config):
    """
    Test that Crew can be created with a Watsonx embedder configuration without raising
    an error related to missing OpenAI API key.
    This fails on buggy code (raises ValueError about OpenAI API key),
    and passes on fixed code.
    """
    # Create a StringKnowledgeSource with some content
    string_source = StringKnowledgeSource(
        content="User's name is John. He is 30 years old and lives in San Francisco."
    )

    # Create Crew with the Watsonx embedder config and the knowledge source
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=embedder_config,
        process=Process.sequential,
        verbose=False,
    )

    # Access the internal knowledge storage to trigger embedder initialization
    knowledge = crew._knowledge
    assert knowledge is not None
    # The storage should be initialized with the embedder config
    storage = knowledge.storage
    assert storage is not None
    # The embedder config in knowledge should match what was passed
    assert knowledge.embedder_config == embedder_config

    # The embedder function should be set and not default to OpenAIEmbeddingFunction
    # We check that no ValueError about missing OpenAI API key is raised during creation
    # This is implicitly tested by the fact that no exception was raised above.

    # Additionally, test that the embedder provider is 'watson'
    # This is a private attribute but we can check the config used
    assert storage._embedder_config is not None
    assert storage._embedder_config.get("provider") == "watson"


def test_default_embedder_without_config_raises_openai_key_error():
    """
    Test that creating Crew with a knowledge source but no embedder config
    raises the expected ValueError about missing OpenAI API key on buggy code.
    On fixed code, this should not raise or should handle properly.
    """
    string_source = StringKnowledgeSource(
        content="This is a test content without embedder config."
    )

    # Create Crew without embedder config
    # On buggy code, this should raise ValueError about OpenAI API key when accessing knowledge storage
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=[string_source],
        embedder=None,
        process=Process.sequential,
        verbose=False,
    )

    # Accessing _knowledge.storage should raise ValueError on buggy code
    # On fixed code, it should not raise or handle gracefully
    storage = crew._knowledge.storage
    assert storage is not None
    # We can try to save documents to trigger embedder usage
    # But since no documents, just check storage is initialized
    # No exception should be raised here in fixed code


def test_crew_with_empty_knowledge_sources_and_embedder_none():
    """
    Test that Crew creation with empty knowledge_sources and no embedder config
    does not raise errors and knowledge is None or empty.
    """
    crew = Crew(
        agents=[],
        tasks=[],
        knowledge_sources=None,
        embedder=None,
        process=Process.sequential,
        verbose=False,
    )
    # _knowledge attribute may be None or have empty sources
    knowledge = getattr(crew, "_knowledge", None)
    if knowledge is not None:
        assert knowledge.sources == []
        assert knowledge.storage is None
    else:
        assert knowledge is None


