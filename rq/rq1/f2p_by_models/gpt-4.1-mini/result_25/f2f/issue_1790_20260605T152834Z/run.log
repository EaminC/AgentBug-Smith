    # Setup a minimal crew configuration with Watsonx embedder config
    embedder_config = {
        "provider": "watson",
        "config": {
            "model": "ibm/slate-125m-english-rtrvr",
            "api_url": "https://dummy-watsonx-url.example.com",
            "api_key": "dummyapikey",
            "project_id": "dummyprojectid",
        }
