import pytest
import openai
import litellm

def test_openai_version_and_litellm_version_compatibility():
    # Check that openai version is at least 1.78.0
    openai_version = tuple(int(x) for x in openai.__version__.split("."))
    assert openai_version >= (1, 78, 0), f"OpenAI version is too low: {openai.__version__}"

    # Check that litellm version is at least 1.72.0
    litellm_version = tuple(int(x) for x in litellm.__version__.split("."))
    assert litellm_version >= (1, 72, 0), f"litellm version is too low: {litellm.__version__}"

def test_openai_chat_completion_with_mock(monkeypatch):
    # We test that openai.ChatCompletion.create can be called without error and returns expected dummy data.
    # We do not mock openai.ChatCompletion.create itself, but monkeypatch the internal _make_request to simulate response.

    class DummyResponse:
        def __init__(self):
            self.choices = [type("Choice", (), {"message": {"content": "Hello from dummy"}})()]

    def dummy_make_request(self, *args, **kwargs):
        return {"choices": [{"message": {"content": "Hello from dummy"}}]}

    # Patch openai._api_requestor.APIRequestor._request to return dummy response dict
    # This is the internal network call used by openai.ChatCompletion.create
    import openai._api_requestor
    original_request = openai._api_requestor.APIRequestor._request
    openai._api_requestor.APIRequestor._request = lambda self, *a, **k: dummy_make_request(self, *a, **k)

    try:
        response = openai.ChatCompletion.create(
            model="gpt-4o-mini",
            messages=[{"role": "user", "content": "Say hello"}],
        )
        assert "choices" in response
        assert response["choices"][0]["message"]["content"] == "Hello from dummy"
    finally:
        openai._api_requestor.APIRequestor._request = original_request

def test_litellm_simple_call():
    # Test that litellm can be instantiated and called with a prompt, returning a string.
    # We do not mock litellm.LiteLLM.__call__, but monkeypatch the internal network call.
    import litellm
    import asyncio

    # Monkeypatch litellm's internal _call method to return dummy response
    original_call = litellm.LiteLLM._call

    async def dummy_call(self, prompt, **kwargs):
        return "dummy response"

    litellm.LiteLLM._call = dummy_call

    try:
        llm = litellm.LiteLLM()
        # litellm.LiteLLM.__call__ is async, so run in event loop
        result = asyncio.run(llm("Hello"))
        assert result == "dummy response"
    finally:
        litellm.LiteLLM._call = original_call[0m
