import asyncio

@pytest.mark.asyncio
async def test_litellm_call_returns_string():
    import litellm

    # Find an internal async call method to patch in LiteLLM
    candidate_methods = ["_acall", "_call_async", "_call", "call_async"]
    method_to_patch = None
    for m in candidate_methods:
        if hasattr(litellm.LiteLLM, m):
            method_to_patch = m
            break

    assert method_to_patch is not None, "Could not find internal async call method to patch in litellm.LiteLLM"

    # Patch the internal async call method to simulate a dummy response
    original_method = getattr(litellm.LiteLLM, method_to_patch)

    async def dummy_async_call(self, *args, **kwargs):
        return "dummy response"

    setattr(litellm.LiteLLM, method_to_patch, dummy_async_call)

    try:
        llm = litellm.LiteLLM()
        result = await getattr(llm, method_to_patch)()
        assert isinstance(result, str), "The call did not return a string"
        assert result == "dummy response", "The call did not return the expected dummy response"
    finally:
        # Restore original method
        setattr(litellm.LiteLLM, method_to_patch, original_method)


def test_litellm_version_allows_openai_178():
    import litellm
    version_str = getattr(litellm, "__version__", None)
    assert version_str is not None, "litellm package does not have __version__ attribute"

    # Check that litellm version is at least 1.72.0 (the fixed version)
    from packaging.version import Version, InvalidVersion
    try:
        v = Version(version_str)
    except InvalidVersion:
        pytest.fail(f"litellm __version__ attribute is not a valid version string: {version_str}")

    assert v >= Version("1.72.0"), f"litellm version {version_str} is older than 1.72.0, which is required for openai 1.78 support"


def test_openai_version_is_178():
    import openai
    version_str = getattr(openai, "__version__", None)
    assert version_str is not None, "openai package does not have __version__ attribute"

    from packaging.version import Version, InvalidVersion
    try:
        v = Version(version_str)
    except InvalidVersion:
        pytest.fail(f"openai __version__ attribute is not a valid version string: {version_str}")

    assert v >= Version("1.78.0"), f"openai version {version_str} is older than 1.78.0, which is required for the new features"


