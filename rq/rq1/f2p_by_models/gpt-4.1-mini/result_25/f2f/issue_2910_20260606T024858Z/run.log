[32mimport pytest
import asyncio

@pytest.mark.asyncio
async def test_litellm_call_returns_string(monkeypatch):
    import litellm

    # Patch the internal network call method used by litellm.LiteLLM to avoid real API calls.
    # The exact internal method name changed between versions; we detect and patch accordingly.

    # Find candidate internal async call methods to patch
    candidate_methods = ["_acall", "_call_async", "_call", "call_async"]
    method_to_patch = None
    for m in candidate_methods:
        if hasattr(litellm.LiteLLM, m):
            method_to_patch = m
            break

    assert method_to_patch is not None, "Could not find internal async call method to patch in litellm.LiteLLM"

    # Define a dummy async method to replace the internal call
    async def dummy_internal_call(self, prompt, **kwargs):
        return "dummy response"

    # Patch the method
    setattr(litellm.LiteLLM, method_to_patch, dummy_internal_call)

    # Instantiate LiteLLM and call it
    llm = litellm.LiteLLM()
    result = await llm("Hello")

    assert isinstance(result, str), "Expected result to be a string"
    assert result == "dummy response", "Unexpected dummy response from LiteLLM call"

def test_litellm_version_allows_openai_178():
    import litellm
    version_str = getattr(litellm, "__version__", None)
    assert version_str is not None, "litellm package does not have __version__ attribute"

    # Parse version string to tuple of ints for comparison
    version_parts = version_str.split(".")
    version_nums = []
    for part in version_parts:
        try:
            version_nums.append(int(part))
        except ValueError:
            # Handle cases like '1.72.0rc1' by ignoring non-digit suffixes
            digits = ''.join(filter(str.isdigit, part))
            version_nums.append(int(digits) if digits else 0)

    # The fix requires litellm >= 1.72.0
    required_version = (1, 72, 0)
    assert tuple(version_nums) >= required_version, f"litellm version {version_str} is less than required 1.72.0"

def test_openai_version_is_178_or_higher():
    import openai
    version_str = getattr(openai, "__version__", None)
    assert version_str is not None, "openai package does not have __version__ attribute"

    version_parts = version_str.split(".")
    version_nums = []
    for part in version_parts:
        try:
            version_nums.append(int(part))
        except ValueError:
            digits = ''.join(filter(str.isdigit, part))
            version_nums.append(int(digits) if digits else 0)

    required_version = (1, 78, 0)
    assert tuple(version_nums) >= required_version, f"openai version {version_str} is less than required 1.78.0"[0m
