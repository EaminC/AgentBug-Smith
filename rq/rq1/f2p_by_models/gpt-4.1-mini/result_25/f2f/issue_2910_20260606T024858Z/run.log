class DummyOpenAIResponse:
    def __init__(self):
        self.choices = [types.SimpleNamespace(message={"content": "dummy response"})]
        self.usage = {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15}

def dummy_chat_completions_create(*args, **kwargs):
    # Check that images field is present in messages to simulate multi-image input support
    messages = kwargs.get("messages", [])
    found_images = False
    for msg in messages:
        if isinstance(msg, dict) and "images" in msg:
            found_images = True
            break
    if not found_images:
        raise ValueError("No images field found in messages for multi-image input test")
