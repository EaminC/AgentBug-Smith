import crewai.llm
import crewai.litellm

# We will test that crewai.llm can work with openai 1.78.0 features.
# The bug is about dependency incompatibility blocking usage of openai 1.78.
# We cannot test the dependency resolution itself here,
# but we can test that the code can instantiate and call the LLM interface
# that internally uses openai >=1.78 features.

# We will mock the internal openai client call to simulate a response,
# but we will NOT mock the crewai.llm interface itself.

# The crewai.llm module uses litellm internally which wraps openai.
# We will patch litellm's internal openai client call to return a dummy response.

# The goal is to run a simple LLM call that would fail if openai 1.78 is not supported.

# We do not use unittest.mock per instructions.
# Instead, we monkeypatch the network call by patching litellm's internal openai client attribute.

import crewai.llm
import crewai.litellm

def dummy_openai_chat_create(*args, **kwargs):
    # Simulate a successful chat completion response with multi-image input support dummy
    class DummyResponse:
        def __init__(self):
            self.choices = [types.SimpleNamespace(message=types.SimpleNamespace(content="dummy response"))]
            self.usage = {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15}
    return DummyResponse()

def test_llm_call_supports_openai_178(monkeypatch):
    # Patch litellm's internal openai chat completions create method to dummy
    # The real litellm client is crewai.litellm._client which is an openai client
    # It has chat.completions.create method
    # We patch that method to dummy_openai_chat_create

    # Access the internal client
    client = crewai.litellm._client

    # Save original method
    orig_create = client.chat.completions.create

    # Patch
    client.chat.completions.create = dummy_openai_chat_create

    # Create an LLM instance and call it with a simple prompt
    llm = crewai.llm.LLM()

    # Call with a simple prompt string
    response = llm.call("Hello, test multi-image input support")

    # Restore original method
    client.chat.completions.create = orig_create

    # Assert the response is the dummy response content
    assert isinstance(response, str)
    assert "dummy response" in response

    # Also test that usage metrics are returned by llm.call_with_usage
    client.chat.completions.create = dummy_openai_chat_create
    response2, usage = llm.call_with_usage("Hello again")
    client.chat.completions.create = orig_create

    assert isinstance(response2, str)
    assert "dummy response" in response2
    assert isinstance(usage, dict)
    assert "prompt_tokens" in usage
    assert "completion_tokens" in usage
    assert "total_tokens" in usage

