[32mimport pytest
import openai
from crewai.llm import OpenAIChatLLM


class DummyOpenAIResponse:
    def __init__(self):
        self.choices = [type("Choice", (), {"message": {"content": "Hello from dummy response"}})()]


def dummy_create(*args, **kwargs):
    return DummyOpenAIResponse()


def test_openai_178_compatibility(monkeypatch):
    # Patch the internal openai.chat.completions.create method to dummy_create
    # so that the test does not depend on actual network calls or API keys.
    # We patch the internal client, not the method under test.
    monkeypatch.setattr(openai.chat.completions, "create", dummy_create)

    # Create an instance of the OpenAIChatLLM which uses openai internally
    llm = OpenAIChatLLM(model="gpt-4o-mini")

    # Call the llm with a simple prompt
    response = llm.call("Say hello")

    # Assert that the response is the dummy response content
    # This verifies that the code path using openai 1.78 style calls works correctly
    assert response == "Hello from dummy response"

    # Also assert that the openai version is at least 1.78.0 to confirm environment
    # This will fail if the environment is still locked to 1.75 or below
    version_tuple = tuple(int(x) for x in openai.__version__.split(".") if x.isdigit())
    assert version_tuple >= (1, 78, 0), f"OpenAI version is too old: {openai.__version__}"[0m
