[32mimport pytest
import asyncio

@pytest.mark.asyncio
async def test_litellm_call_returns_string(monkeypatch):
    import litellm

    # Find an internal async call method to patch
    candidate_methods = ["_acall", "_call_async", "_call", "call_async"]
    method_to_patch = None
    for m in candidate_methods:
        if hasattr(litellm.LiteLLM, m):
            method_to_patch = m
            break

    assert method_to_patch is not None, "Could not find internal async call method to patch in litellm.LiteLLM"

    # Patch the internal async call method to return a dummy response
    async def dummy_call(self, prompt, **kwargs):
        return "dummy response"

    setattr(litellm.LiteLLM, method_to_patch, dummy_call)

    llm = litellm.LiteLLM()
    result = await llm("Hello")

    assert isinstance(result, str), "The result should be a string"
    assert result == "dummy response", "The dummy call should return the dummy response"


def test_litellm_version_allows_openai_178():
    import litellm
    version_str = getattr(litellm, "__version__", None)
    assert version_str is not None, "litellm package does not have __version__ attribute"

    # Parse version numbers
    parts = version_str.split(".")
    major = int(parts[0]) if len(parts) > 0 else 0
    minor = int(parts[1]) if len(parts) > 1 else 0
    patch = int(parts[2]) if len(parts) > 2 else 0

    # Check that version is >= 1.72.0 to allow openai 1.78
    assert (major, minor, patch) >= (1, 72, 0), f"litellm version {version_str} is too old, must be >= 1.72.0"


def test_openai_version_allows_178():
    import openai
    version_str = getattr(openai, "__version__", None)
    assert version_str is not None, "openai package does not have __version__ attribute"

    # Parse version numbers
    parts = version_str.split(".")
    major = int(parts[0]) if len(parts) > 0 else 0
    minor = int(parts[1]) if len(parts) > 1 else 0
    patch = int(parts[2]) if len(parts) > 2 else 0

    # Check that version is >= 1.78.0
    assert (major, minor, patch) >= (1, 78, 0), f"openai version {version_str} is too old, must be >= 1.78.0"[0m
