import asyncio


@pytest.mark.asyncio
async def test_litellm_call_returns_string(monkeypatch):
    import litellm

    # Identify an internal async call method to patch in LiteLLM
    candidate_methods = ["_acall", "_call_async", "_call", "call_async"]
    method_to_patch = None
    for m in candidate_methods:
        if hasattr(litellm.LiteLLM, m):
            method_to_patch = m
            break

    assert method_to_patch is not None, "Could not find internal async call method to patch in litellm.LiteLLM"

    # Patch the internal async call method to return a dummy response
    async def dummy_call(self, *args, **kwargs):
        return "dummy response"

    setattr(litellm.LiteLLM, method_to_patch, dummy_call)

    llm = litellm.LiteLLM()

    # Call the public async call method and check result is string
    # We try both async call interfaces if available
    if hasattr(llm, "acall"):
        result = await llm.acall("test prompt")
    elif hasattr(llm, "call_async"):
        result = await llm.call_async("test prompt")
    else:
        # fallback to synchronous call if no async call method
        result = llm("test prompt")

    assert isinstance(result, str), "Expected string result from LiteLLM call"


