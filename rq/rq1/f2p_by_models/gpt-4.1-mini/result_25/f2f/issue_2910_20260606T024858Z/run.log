import asyncio

@pytest.mark.asyncio
async def test_litellm_call_returns_string():
    import litellm

    # Find an internal async call method to patch in LiteLLM
    candidate_methods = ["_acall", "_call_async", "_call", "call_async"]
    method_to_patch = None
    for m in candidate_methods:
        if hasattr(litellm.LiteLLM, m):
            method_to_patch = m
            break

    assert method_to_patch is not None, "Could not find internal async call method to patch in litellm.LiteLLM"

    # Save original method
    original_method = getattr(litellm.LiteLLM, method_to_patch)

    async def dummy_call(self, prompt, *args, **kwargs):
        # Return a dummy string response
        return "dummy response"

    # Patch the internal method with dummy_call
    setattr(litellm.LiteLLM, method_to_patch, dummy_call)

    try:
        llm = litellm.LiteLLM()
        result = await llm("Hello world")
        assert isinstance(result, str), "The LiteLLM call did not return a string"
        assert result == "dummy response", "The LiteLLM call did not return the expected dummy response"
    finally:
        # Restore original method
        setattr(litellm.LiteLLM, method_to_patch, original_method)


def test_litellm_version_allows_openai_178():
    import litellm
    version_str = getattr(litellm, "__version__", None)
    assert version_str is not None, "litellm package does not have __version__ attribute"

    # Parse version string into tuple of ints for comparison
    version_parts = version_str.split(".")
    version_nums = []
    for part in version_parts:
        try:
            version_nums.append(int(part))
        except ValueError:
            # If non-numeric suffix, ignore
            break

    # Check that version is at least 1.72.0
    assert version_nums >= [1, 72, 0], f"litellm version {version_str} is less than required 1.72.0 for openai 1.78 compatibility"[0m
