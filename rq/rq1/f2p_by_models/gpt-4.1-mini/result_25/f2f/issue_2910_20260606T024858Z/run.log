# We will test that the current litellm version used by crewai is >= 1.72.0
# and that the openai version is >= 1.78.0, which is the new supported version.
# The buggy code pins litellm to 1.68.0 and openai <1.76.0, so this test should fail there.
# After patch, litellm 1.72.0 and openai 1.78.0 are allowed, so test should pass.

def test_litellm_version_and_openai_version():
    # Check litellm version
    import litellm
    litellm_version = tuple(int(x) for x in litellm.__version__.split('.') if x.isdigit())
    # We want at least 1.72.0
    assert litellm_version >= (1, 72, 0), f"litellm version is {litellm.__version__}, expected >= 1.72.0"

    # Check openai version
    import openai
    openai_version = tuple(int(x) for x in openai.__version__.split('.') if x.isdigit())
    # We want at least 1.78.0
    assert openai_version >= (1, 78, 0), f"openai version is {openai.__version__}, expected >= 1.78.0"

def test_llm_call_works_with_openai_178(monkeypatch):
    # We test that crewai.llm.LLM can make a call to openai.ChatCompletion
    # We patch openai.ChatCompletion.create to return a dummy response
    import openai

    class DummyChatCompletion:
        @staticmethod
        def create(*args, **kwargs):
            return {
                "choices": [
                    {"message": {"content": "dummy response"}}
                ],
                "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2},
                "id": "dummy-id",
                "object": "chat.completion",
                "created": 1234567890,
                "model": "gpt-4"
            }

    monkeypatch.setattr(openai.ChatCompletion, "create", DummyChatCompletion.create)

    llm = crewai.llm.LLM(model="gpt-4")
    response = llm.chat_complete(messages=[{"role": "user", "content": "Hello"}])
    assert "dummy response" in response

def test_litellm_import_and_version():
    # Just test that litellm can be imported and version is accessible
    import litellm
    assert hasattr(litellm, "__version__")
    # Version string must be non-empty
    assert len(litellm.__version__) > 0

def test_openai_import_and_version():
    import openai
    assert hasattr(openai, "__version__")
    assert len(openai.__version__) > 0

