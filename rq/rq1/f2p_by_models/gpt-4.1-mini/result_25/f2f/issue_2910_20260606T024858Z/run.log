def test_openai_version_and_litellm_version_compatibility():
    import importlib.metadata
    # Check that openai version is >=1.78.0 and litellm version is >=1.72.0
    # This test will fail if versions are not updated as per patch
    openai_version = importlib.metadata.version("openai")
    litellm_version = importlib.metadata.version("litellm")

    def version_tuple(v):
        return tuple(int(x) for x in v.split(".") if x.isdigit())

    assert version_tuple(openai_version) >= (1, 78, 0), f"openai version is {openai_version}, expected >=1.78.0"
    assert version_tuple(litellm_version) >= (1, 72, 0), f"litellm version is {litellm_version}, expected >=1.72.0"


def test_openai_chat_completion_with_mock(monkeypatch):
    # This test verifies that openai.ChatCompletion.create can be called and returns expected dummy data
    # We monkeypatch the internal network call to avoid real API calls

    import openai

    # The internal network call is openai.api_requestor.APIRequestor._request in openai 1.78+
    # We patch it to return a dummy response dict

    # Find the APIRequestor class and patch its _request method
    # The import path changed in openai 1.78, so we try to import the correct module
    try:
        from openai.api_requestor import APIRequestor
    except ImportError:
        pytest.skip("openai.api_requestor.APIRequestor not found, skipping test")

    def dummy_request(self, method, url, params=None, headers=None, stream=False, request_id=None):
        # Return a dummy response dict mimicking a chat completion response
        return {
            "choices": [
                {
                    "message": {
                        "role": "assistant",
                        "content": "Hello from dummy"
                    },
                    "finish_reason": "stop",
                    "index": 0
                }
            ],
            "created": 1234567890,
            "id": "chatcmpl-dummy",
            "model": "gpt-4o-mini",
            "object": "chat.completion",
            "usage": {
                "prompt_tokens": 5,
                "completion_tokens": 5,
                "total_tokens": 10
            }
        }

    monkeypatch.setattr(APIRequestor, "_request", dummy_request)

    # Call openai.ChatCompletion.create and verify the dummy response
    response = openai.ChatCompletion.create(
        model="gpt-4o-mini",
        messages=[{"role": "user", "content": "Say hello"}]
    )
    assert "choices" in response
    assert response["choices"][0]["message"]["content"] == "Hello from dummy"


