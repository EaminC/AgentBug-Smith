import asyncio

@pytest.mark.asyncio
async def test_litellm_call_returns_string():
    import litellm

    # Find an internal async call method to patch in LiteLLM
    candidate_methods = ["_acall", "_call_async", "_call", "call_async"]
    method_to_patch = None
    for m in candidate_methods:
        if hasattr(litellm.LiteLLM, m):
            method_to_patch = m
            break

    assert method_to_patch is not None, "Could not find internal async call method to patch in litellm.LiteLLM"

    # Patch the internal method to return a dummy response
    original_method = getattr(litellm.LiteLLM, method_to_patch)

    async def dummy_call(self, *args, **kwargs):
        return "dummy response"

    setattr(litellm.LiteLLM, method_to_patch, dummy_call)

    try:
        llm = litellm.LiteLLM()
        # Call the async method and check the return type
        result = await getattr(llm, method_to_patch)()
        assert isinstance(result, str), "Expected string response from LiteLLM async call"
    finally:
        # Restore original method
        setattr(litellm.LiteLLM, method_to_patch, original_method)


