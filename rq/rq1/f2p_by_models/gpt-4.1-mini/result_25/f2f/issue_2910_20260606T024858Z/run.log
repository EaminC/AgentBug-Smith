import asyncio
import crewai.llm
import crewai.lite_agent
import crewai.agent
import crewai.tasks.task

from crewai.llm import LLM
from crewai.lite_agent import LiteAgent
from crewai.agent import Agent
from crewai.tasks.task import Task


class DummyOpenAIClient:
    def __init__(self):
        self.called = False

    async def acreate(self, *args, **kwargs):
        self.called = True
        # Return a dummy response mimicking openai 1.78 multi-image input support
        return {
            "choices": [
                {
                    "message": {
                        "content": "Dummy response with multi-image support"
                    }
                }
            ],
            "usage": {
                "prompt_tokens": 10,
                "completion_tokens": 5,
                "total_tokens": 15
            }
        }


@pytest.mark.asyncio
async def test_llm_call_with_openai_178_support(monkeypatch):
    # Patch the internal openai client used by crewai.llm.LLM to use DummyOpenAIClient
    dummy_client = DummyOpenAIClient()

    # monkeypatch the internal _client attribute of LLM instance to dummy_client
    # We create an LLM instance and replace its _client with dummy_client
    llm = LLM(model="gpt-4o-mini")
    llm._client = dummy_client

    # Call the LLM with a simple prompt and verify the dummy response is returned correctly
    response = await llm.acall("Hello, test multi-image input support")

    assert dummy_client.called, "OpenAI client was not called"
    assert isinstance(response, str)
    assert "multi-image support" in response


def test_lite_agent_usage_with_openai_178(monkeypatch):
    # Patch the internal openai client used by LiteAgent to dummy client
    dummy_client = DummyOpenAIClient()

    agent = LiteAgent(name="test-agent", llm=LLM(model="gpt-4o-mini"))
    agent.llm._client = dummy_client

    # Run agent's run method with a simple prompt
    result = asyncio.run(agent.run("Test prompt for openai 1.78 support"))

    assert dummy_client.called, "OpenAI client was not called in LiteAgent"
    assert isinstance(result, str)
    assert "multi-image support" in result


def test_agent_task_execution_with_openai_178(monkeypatch):
    dummy_client = DummyOpenAIClient()

    # Create an Agent with LLM patched to dummy client
    agent = Agent(name="test-agent", llm=LLM(model="gpt-4o-mini"))
    agent.llm._client = dummy_client

    # Create a simple Task that returns a prompt
    task = Task(name="test-task", prompt="Say hello with multi-image support")

    # Run the agent to execute the task
    result = asyncio.run(agent.execute_task(task))

    assert dummy_client.called, "OpenAI client was not called in Agent task execution"
    assert isinstance(result, str)
    assert "multi-image support" in result


