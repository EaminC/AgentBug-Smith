        name="测试模型",
        description="描述含中文",
        version="1.0",
        image_urls=["http://example.com/图片.png"],
        raw={"key": "值"},
    )
    s = str(m)
    # The output should contain Chinese characters, not escaped unicode
    assert "测试模型" in s
    assert "描述含中文" in s
    assert "图片.png" in s
    assert "值" in s
    # It should be valid JSON
    parsed = json.loads(s)
    assert parsed["name"] == "测试模型"
    assert parsed["raw"]["key"] == "值"

