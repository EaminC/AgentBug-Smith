    # To avoid mocking the reply method, we monkeypatch the internal _call_model method to return our response
    # But since the codebase is unknown in detail, we do a direct test of the logging line in the module

    # Instead, test the logging_utils._chat function which is patched in the fix and used for logging

    # Use logging_utils._chat to log a dict with Chinese characters and capture output
    logging_utils.logger.addHandler(capture_handler)
    logging_utils.logger.setLevel(logging.DEBUG)

    test_message = {"message": "这是中文测试"}  # "This is a Chinese test"

    # Call the _chat function which logs with json.dumps(..., ensure_ascii=False) in fixed code
    logging_utils._chat(test_message)

    logs = capture_handler.get_logs()

    # Remove handlers after test
    logger.removeHandler(capture_handler)
    logging_utils.logger.removeHandler(capture_handler)

    # Check that logs contain Chinese characters unescaped (not \uXXXX)
    # If buggy, json.dumps will escape Chinese characters as \uXXXX
    # So the log string will contain \u instead of actual Chinese chars

    # Assert that the log contains the Chinese characters literally, not escaped unicode
