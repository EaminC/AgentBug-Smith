import src.agentscope.agents.dict_dialog_agent as dict_dialog_agent_module


def test_model_str_returns_json_with_chinese_characters():
    # Create a Model instance with Chinese characters in fields
    m = model_module.Model(
        config_name="测试模型",
        model_type="test",
        model_id="模型ID",
        image_urls=["http://example.com/图片1.png", "http://example.com/图片2.png"],
        raw={"key": "值", "nested": {"子键": "子值"}},
    )
    s = str(m)
    # The string should be valid JSON and contain Chinese characters unescaped
    data = json.loads(s)
    assert data["config_name"] == "测试模型"
    assert data["raw"]["nested"]["子键"] == "子值"
    # Check that the JSON string contains Chinese characters literally (not escaped)
    assert "测试模型" in s
    assert "子键" in s
    # Check that ensure_ascii=False is respected by verifying no \u escapes for Chinese chars
    assert not re.search(r"\\u[0-9a-fA-F]{4}", s)


def test_dict_dialog_agent_reply_logs_chinese_correctly(caplog):
    # Setup caplog to capture debug logs from dict_dialog_agent
    caplog.set_level(logging.DEBUG, logger="src.agentscope.agents.dict_dialog_agent.logger")

    # Create a dummy input dict with Chinese characters
    input_dict = {"question": "你好，世界！"}

    # Create a dummy DictDialogAgent instance
    agent = dict_dialog_agent_module.DictDialogAgent()

    # Patch the _call_model method to return a dict with Chinese characters
    def dummy_call_model(x):
        return {"speak": "这是一个测试", "raw": {"response": "测试内容"}}

    agent._call_model = dummy_call_model

    # Call reply and capture output
    response = agent.reply(input_dict)

    # The response should contain the Chinese speak text
    assert "speak" in response
    assert response["speak"] == "这是一个测试"

    # The debug log should contain the JSON string with Chinese characters unescaped
    found_log = False
    for record in caplog.records:
        if record.levelno == logging.DEBUG and "这是一个测试" in record.message:
            found_log = True
            # The logged message should contain Chinese characters literally, not escaped
            assert "这是一个测试" in record.message
            assert "\\u" not in record.message
    assert found_log, "Did not find debug log with Chinese characters"


def test_logging_utils_logger_log_ensure_ascii_false():
    """
    Test that the logger.log call in utils.logging_utils._chat uses json.dumps with ensure_ascii=False,
    so that Chinese characters are output as-is, not escaped.
    """
    logger = logging_utils_module.logger

    # Remove all handlers first to avoid duplicates
    logger.remove()

    # Add a sink to capture logs at LEVEL_CHAT_SAVE
    captured = []

    def capture_sink(message):
        captured.append(message)

    # Add sink with the custom level LEVEL_CHAT_SAVE
    # If LEVEL_CHAT_SAVE is an int, we can add by level number
    # If it is a string, ensure it is registered
    level_chat_save = logging_utils_module.LEVEL_CHAT_SAVE
    # If LEVEL_CHAT_SAVE is int, add by number
    if isinstance(level_chat_save, int):
        logger.add(capture_sink, level=level_chat_save)
    else:
        # Register the level if not exist
        try:
            logger.level(level_chat_save)
        except ValueError:
            logger.level(level_chat_save, no=25)
        logger.add(capture_sink, level=level_chat_save)

    # Prepare a message dict with Chinese characters
    message = {"content": "测试中文日志"}

    # Call the _chat function which logs with json.dumps(..., ensure_ascii=False)
    logging_utils_module._chat(message)

    # There should be at least one captured log message
    assert captured, "No log messages captured"

    # The logged message should contain Chinese characters literally, not escaped
    logged_text = captured[0].record["message"]
    assert "测试中文日志" in logged_text
    assert "\\u" not in logged_text


