class CaptureLogHandler(logging.Handler):
    """Custom log handler to capture logs in a string buffer."""

    def __init__(self):
        super().__init__()
        self.log_capture_string = io.StringIO()

    def emit(self, record):
        msg = self.format(record)
        self.log_capture_string.write(msg + "\n")

    def get_logs(self):
        return self.log_capture_string.getvalue()


def test_json_logging_supports_chinese_in_dict_dialog_agent():
    """
    Test that the DictDialogAgent logs JSON with ensure_ascii=False so Chinese characters are not escaped.
    This test fails on buggy code where ensure_ascii=True (default) causes Chinese to be escaped.
    """

    # Setup a logger capture
    logger = logging.getLogger("agentscope.agents.dict_dialog_agent")
    capture_handler = CaptureLogHandler()
    formatter = logging.Formatter("%(message)s")
    capture_handler.setFormatter(formatter)
    logger.addHandler(capture_handler)
    logger.setLevel(logging.DEBUG)

    # Prepare a DictDialogAgent instance with minimal config to call reply
