            return {"speak": "中文日志测试", "extra": {"key": "值"}}

    agent = DummyAgent()

    # Call reply which logs debug message with json.dumps(..., ensure_ascii=False)
    response = agent.reply({"input": "测试"})

    # Check that debug log was captured
