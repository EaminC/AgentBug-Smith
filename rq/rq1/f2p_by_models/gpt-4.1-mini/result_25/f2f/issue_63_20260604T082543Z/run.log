def test_logging_utils_logger_log_ensure_ascii_false():
    """
    Test that the logger.log call in utils.logging_utils._chat uses json.dumps with ensure_ascii=False,
    so that Chinese characters are output as-is, not escaped.
    """
    import src.agentscope.utils.logging_utils as logging_utils

    logger = logging_utils.logger

    # Remove all handlers first to avoid duplicates
    logger.remove()

    # Add a sink to capture logs at LEVEL_CHAT_SAVE
    captured = []

    def capture_sink(message):
        captured.append(message)

    level_chat_save = getattr(logging_utils, "LEVEL_CHAT_SAVE", None)
    assert level_chat_save is not None, "LEVEL_CHAT_SAVE not defined in logging_utils"

    # Add sink with the custom level LEVEL_CHAT_SAVE
    logger.add(capture_sink, level=level_chat_save)

    # Compose a message with Chinese characters
    message = {"text": "测试中文日志输出", "nested": {"key": "值"}}

    # Call _chat which logs with ensure_ascii=False
    logging_utils._chat(message)

    # Remove sink after test
    logger.remove()

    # There should be at least one captured message
    assert len(captured) > 0

    # The logged message should contain the Chinese characters unescaped
    logged_msg = captured[0].strip()
    assert "测试中文日志输出" in logged_msg
    assert "\\u" not in logged_msg  # no unicode escape sequences


def test_json_dumps_ensure_ascii_false_in_model_str_and_dict_dialog_agent():
    """
    Test that json.dumps calls in dict_dialog_agent.reply and model __str__ use ensure_ascii=False.
    This verifies Chinese characters appear correctly in logs and string outputs.
    """
