    # The debug message should contain Chinese characters, not escaped unicode
    assert "中文日志测试" in debug_msg
    assert "值" in debug_msg


def test_logging_utils_logger_debug_json_dumps_ensure_ascii_false():
    """
    Test that the logger.debug call in dict_dialog_agent.reply uses json.dumps with ensure_ascii=False.
    We do this by patching the logger to capture the debug message and check the output.
    """
    import src.agentscope.agents.dict_dialog_agent as dict_dialog_agent_module
    import logging

    caplog_records = []

    class CaptureHandler(logging.Handler):
        def emit(self, record):
            caplog_records.append(record)

    logger = logging.getLogger("agentscope")
    # Remove existing handlers to avoid duplicate logs in test environment
    for h in logger.handlers[:]:
        logger.removeHandler(h)
    logger.addHandler(CaptureHandler())
    logger.setLevel(logging.DEBUG)

    class DummyMemory:
        def add(self, x):
            pass

        def get_memory(self):
            return []

    class DummyAgent(dict_dialog_agent_module.DictDialogAgent):
        def __init__(self):
            # Patch model attribute to dummy to avoid PromptEngine init error
            super().__init__(name="dummy", use_memory=False)
            self.memory = DummyMemory()
            self.sys_prompt = ""
            # Patch model attribute to dummy model
            self.model = model_module.Model(
                name="dummy_model",
                description="desc",
                version="1.0",
                image_urls=[],
                raw={},
            )
            class DummyEngine:
                def join(self, *args):
                    return "prompt"
            self.engine = DummyEngine()

        def _call(self, x):
            # Return a dict with Chinese characters
            return {"speak": "中文日志测试", "extra": {"key": "值"}}

    agent = DummyAgent()

    # Call reply which logs debug message with json.dumps(..., ensure_ascii=False)
    response = agent.reply({"input": "测试"})

    # Check that debug log was captured
    debug_logs = [r for r in caplog_records if r.levelno == logging.DEBUG]
    assert len(debug_logs) > 0
    debug_msg = debug_logs[0].getMessage()
    # The debug message should contain Chinese characters, not escaped unicode
    assert "中文日志测试" in debug_msg
    assert "值" in debug_msg

