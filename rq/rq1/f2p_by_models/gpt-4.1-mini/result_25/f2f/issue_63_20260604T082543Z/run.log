                    assert loaded["speak"] == "中文日志测试"
                    assert loaded["extra"]["key"] == "值"
                except Exception:
                    assert False, "Logged message is not valid JSON"

    assert found, "Did not find debug log with Chinese characters logged correctly"[0m
