            # Provide minimal required args to avoid AttributeError
            super().__init__(name="dummy", use_memory=False)
            self.memory = DummyMemory()
            self.sys_prompt = ""
            # Patch model attribute to avoid AttributeError in PromptEngine init
            self.model = None
            class DummyEngine:
                def join(self, *args):
                    return "prompt"
            self.engine = DummyEngine()

        def _call(self, x):
            # Return a dict with Chinese characters
            return {"speak": "中文日志测试", "extra": {"key": "值"}}

    agent = DummyAgent()

    # Call reply with some input
    response = agent.reply({"input": "测试"})

    # Check that the debug log contains Chinese characters unescaped
    found_chinese_in_log = any(
        "中文日志测试" in record.getMessage() and "\\u" not in record.getMessage()
        for record in caplog_records
    )
    assert found_chinese_in_log, "Chinese characters not found unescaped in debug log"


@pytest.mark.parametrize("json_func", [json.dumps])
def test_model_init_and_str_with_chinese(json_func):
    """
    Test that the Model class serializes to JSON with ensure_ascii=False,
    so that Chinese characters are output as-is, not escaped.
    """
    from src.agentscope.models import model as model_module

    Model = getattr(model_module, "Model", None)
    assert Model is not None, "Model class not found in src.agentscope.models.model"

    # Create a Model instance with Chinese characters in fields
    m = Model(
        config_name="测试模型",
        model_type="test",
        model_id="模型ID",
        image_urls=["http://example.com/图片1.png", "http://example.com/图片2.png"],
        raw={"key": "值", "nested": {"子键": "子值"}},
    )

    # The __str__ method should produce JSON with ensure_ascii=False
    s = str(m)
    assert "测试模型" in s
    assert "模型ID" in s
    assert "图片1" in s
    assert "子键" in s
    assert "\\u" not in s

    # Also test that json_func called on the serialized dict uses ensure_ascii=False
    serialized = {
        "config_name": m.config_name,
        "model_type": m.model_type,
        "model_id": m.model_id,
        "image_urls": m.image_urls,
        "raw": m.raw,
    }
    json_str = json_func(serialized, indent=4, ensure_ascii=False)
    assert "测试模型" in json_str
    assert "模型ID" in json_str
    assert "图片1" in json_str
    assert "子键" in json_str
    assert "\\u" not in json_str


