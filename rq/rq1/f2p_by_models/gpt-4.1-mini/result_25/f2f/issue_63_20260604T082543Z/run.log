[32mimport json
import logging
import re
import pytest

from src.agentscope.agents import dict_dialog_agent
from src.agentscope.utils import logging_utils


def test_dict_dialog_agent_reply_logs_chinese_correctly(caplog):
    """
    Test that DictDialogAgent.reply logs the response JSON with ensure_ascii=False,
    so Chinese characters are logged as-is, not escaped Unicode.
    """
    # Setup a minimal agent instance with a dummy model attribute to avoid AttributeError
    class DummyModel:
        def __call__(self, *args, **kwargs):
            return {"speak": "你好，世界", "raw": {"key": "值"}}

    agent = dict_dialog_agent.DictDialogAgent.__new__(dict_dialog_agent.DictDialogAgent)
    # Patch required attributes for reply method to work
    agent.model = DummyModel()
    # The reply method calls self.model, so we patch it to return a dict with Chinese chars
    # We also patch logger to capture debug logs
    caplog.set_level(logging.DEBUG, logger="src.agentscope.agents.dict_dialog_agent.logger")

    # Call reply with no input to trigger logging
    response = agent.reply()

    # Check that the debug log contains Chinese characters, not escaped Unicode
    logs = caplog.text
    assert "你好" in logs or "值" in logs, "Chinese characters should appear in logs, not escaped Unicode"
    # Also check that the log line is valid JSON with indent and ensure_ascii=False effect
    # Extract JSON from log line (may have prefix)
    json_text_match = re.search(r"\{[\s\S]*\}", logs)
    assert json_text_match is not None, "Log should contain JSON"
    json_text = json_text_match.group(0)
    # Load JSON to verify it's valid
    loaded = json.loads(json_text)
    # The loaded JSON should contain the keys we expect
    assert "speak" in loaded
    assert "raw" in loaded
    # The raw dict should contain the Chinese key "key"
    assert "key" in loaded["raw"]
    # The value should be the Chinese string, not escaped
    assert loaded["raw"]["key"] == "值"


def test_logging_utils_logger_log_ensure_ascii_false():
    """
    Test that the logger.log call in utils.logging_utils._chat uses json.dumps with ensure_ascii=False,
    so that Chinese characters are output as-is, not escaped.
    """
    logger = logging_utils.logger

    # Remove all handlers first to avoid duplicates
    logger.remove()

    # Add a sink to capture logs at LEVEL_CHAT_SAVE
    captured = []

    def capture_sink(message):
        captured.append(message)

    level_chat_save = logging_utils.LEVEL_CHAT_SAVE
    # Add sink with the custom level LEVEL_CHAT_SAVE
    # This will fail if LEVEL_CHAT_SAVE is not registered, which is part of the fix
    logger.add(capture_sink, level=level_chat_save)

    # Call the _chat function with a dict containing Chinese characters
    test_message = {"内容": "测试中文", "数字": 123}
    logging_utils._chat(test_message)

    # There should be at least one captured log message
    assert len(captured) > 0
    # The logged message should contain Chinese characters, not escaped Unicode
    logged_text = captured[0]
    assert "测试中文" in logged_text
    # It should be valid JSON
    loaded = json.loads(logged_text)
    assert loaded["内容"] == "测试中文"
    assert loaded["数字"] == 123


