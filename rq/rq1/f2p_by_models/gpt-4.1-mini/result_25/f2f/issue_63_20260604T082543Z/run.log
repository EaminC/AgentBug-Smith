[32mimport json
import logging
import re

import pytest

from src.agentscope.agents import dict_dialog_agent as dict_dialog_agent_module
from src.agentscope.utils import logging_utils as logging_utils_module


def test_dict_dialog_agent_reply_logs_chinese_correctly(caplog):
    # Setup caplog to capture debug logs from dict_dialog_agent logger
    logger_name = "src.agentscope.agents.dict_dialog_agent.logger"
    caplog.set_level(logging.DEBUG, logger=logger_name)

    # Create a dummy input dict with Chinese characters
    input_dict = {"question": "你好，世界！"}

    # DictDialogAgent requires a 'name' argument in constructor
    agent = dict_dialog_agent_module.DictDialogAgent(name="test_agent")

    # Call reply method with input containing Chinese characters
    response = agent.reply(input_dict)

    # Check that the debug log contains Chinese characters unescaped (not \uXXXX)
    logs = [record.getMessage() for record in caplog.records if record.name == logger_name and record.levelno == logging.DEBUG]

    assert logs, "No debug logs captured from dict_dialog_agent"

    # The logged JSON string should contain Chinese characters directly, not escaped unicode
    found_chinese = any(re.search(r"[\u4e00-\u9fff]", log) for log in logs)
    found_escaped = any(r"\u" in log for log in logs)

    assert found_chinese, "Chinese characters not found in debug logs"
    assert not found_escaped, "Chinese characters are escaped in debug logs"


def test_logging_utils_logger_log_ensure_ascii_false():
    """
    Test that the logger.log call in utils.logging_utils._chat uses json.dumps with ensure_ascii=False,
    so that Chinese characters are output as-is, not escaped.
    """
    logger = logging_utils_module.logger

    # Remove all handlers first to avoid duplicates
    logger.remove()

    # Add a sink to capture logs at LEVEL_CHAT_SAVE
    captured = []

    def capture_sink(message):
        captured.append(message)

    level_chat_save = logging_utils_module.LEVEL_CHAT_SAVE
    # Add sink with the custom level LEVEL_CHAT_SAVE
    logger.add(capture_sink, level=level_chat_save)

    # Prepare a message dict with Chinese characters
    message = {"content": "测试中文日志"}

    # Call the _chat function which logs with json.dumps(..., ensure_ascii=False)
    logging_utils_module._chat(message)

    # There should be at least one captured log message
    assert captured, "No logs captured at LEVEL_CHAT_SAVE"

    # The logged message should contain Chinese characters directly, not escaped unicode
    logged_str = captured[0]
    assert "测试中文日志" in logged_str, "Chinese characters not found in logged message"
    assert r"\u" not in logged_str, "Chinese characters are escaped in logged message"


@pytest.mark.parametrize("json_func", [json.dumps])
def test_model_init_and_str_with_chinese(json_func):
    # Import Model class here to avoid import errors if missing
    from src.agentscope.models import model as model_module

    # Create a Model instance with Chinese characters in fields
    m = model_module.Model(
        config_name="测试模型",
        model_type="test",
        model_id="模型ID",
        image_urls=["http://example.com/图片1.png", "http://example.com/图片2.png"],
        raw={"key": "值", "nested": {"子键": "子值"}},
    )

    # The __str__ method should produce JSON string with Chinese characters unescaped
    s = str(m)
    # It should be valid JSON
    parsed = json.loads(s)
    # Check keys and values contain Chinese characters as expected
    assert parsed["config_name"] == "测试模型"
    assert parsed["model_id"] == "模型ID"
    assert "图片1" in parsed["image_urls"][0]
    assert parsed["raw"]["key"] == "值"
    assert parsed["raw"]["nested"]["子键"] == "子值"

    # The string should contain Chinese characters directly, not escaped unicode
    assert "测试模型" in s
    assert r"\u" not in s


