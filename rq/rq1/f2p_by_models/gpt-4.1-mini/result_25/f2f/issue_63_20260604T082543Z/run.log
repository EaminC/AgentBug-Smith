    # Create a Model instance with Chinese characters in fields
    m = Model(
        config_name="测试模型",
        model_type="test",
        model_id="模型ID",
        image_urls=["http://example.com/图片1.png", "http://example.com/图片2.png"],
        raw={"key": "值", "nested": {"子键": "子值"}},
    )

    # The __str__ method should produce JSON with ensure_ascii=False, so Chinese chars appear
    s = str(m)
    assert "测试模型" in s
    assert "模型ID" in s
    assert "图片1" in s
    assert "子键" in s
    assert "\\u" not in s

    # Patch logger to capture debug logs from dict_dialog_agent.reply
    caplog_records = []

    class CaptureHandler(logging.Handler):
        def emit(self, record):
            caplog_records.append(record)

    logger = logging.getLogger("agentscope")
    # Remove existing handlers and add capture handler
    for h in logger.handlers[:]:
        logger.removeHandler(h)
    logger.addHandler(CaptureHandler())
    logger.setLevel(logging.DEBUG)

    class DummyMemory:
