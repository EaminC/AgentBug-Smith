            # It should contain the Chinese characters literally, not escaped
            if "测试中文" in logged_msg and "值" in logged_msg:
                found = True
                # Also check that no \u escape sequences appear for these chars
                assert "\\u" not in logged_msg
    assert found, "Did not find log record with unescaped Chinese characters"


