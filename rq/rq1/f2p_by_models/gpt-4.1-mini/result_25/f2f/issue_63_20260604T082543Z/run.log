    def test_json_dumps_ensure_ascii_false_in_model_str_and_dict_dialog_agent(json_obj):
        """
        Test that json.dumps with ensure_ascii=False is used in model __str__ and dict_dialog_agent reply logging.
        This indirectly tests the fix by checking that dumping JSON with Chinese characters does not escape them.
        """
        import src.agentscope.agents.dict_dialog_agent as dict_dialog_agent_module
        import src.agentscope.models.model as model_module
    
        # Test json.dumps with ensure_ascii=False in model __str__
        # The Model class is not directly exposed, so we test the __str__ method of a dummy class
        # that mimics the serialization behavior of the Model class __str__ method.
        class DummyModel:
            def __init__(self, raw):
                self.raw = raw
                self.image_urls = []
            def __str__(self):
                serialized_fields = {
                    "image_urls": self.image_urls,
                    "raw": self.raw,
                }
                # The bug fix adds ensure_ascii=False here
                return json.dumps(serialized_fields, indent=4, ensure_ascii=False)
    
        model_instance = DummyModel(json_obj)
        s = str(model_instance)
        # The string should contain Chinese characters unescaped
        for v in json_obj.values():
            if isinstance(v, str):
                assert v in s
            elif isinstance(v, list):
                for item in v:
                    assert item in s
            elif isinstance(v, dict):
                for inner_v in v.values():
                    assert inner_v in s
        assert "\\u" not in s
    
        # Test dict_dialog_agent reply logging uses ensure_ascii=False
        # Create dummy agent with minimal memory and _call returning json_obj
        class DummyAgent(dict_dialog_agent_module.DictDialogAgent):
            def __init__(self):
                class DummyMemory:
                    def add(self, x):
                        pass
                self.memory = DummyMemory()
    
            def _call(self, x):
                return json_obj
    
        agent = DummyAgent()
    
        # Capture debug logs
        caplog_records = []
    
        class CaptureHandler(logging.Handler):
            def emit(self, record):
                caplog_records.append(record)
    
        logger = logging.getLogger("agentscope")
        logger.addHandler(CaptureHandler())
        logger.setLevel(logging.DEBUG)
    
