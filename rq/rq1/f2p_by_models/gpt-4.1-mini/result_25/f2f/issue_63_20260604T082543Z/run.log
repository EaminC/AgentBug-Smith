def test_logging_utils_logger_log_ensure_ascii_false():
    """
    Test that logging_utils._chat logs the message with json.dumps(..., ensure_ascii=False).
    We patch the logger to capture the logged message and verify that Chinese characters
    are not escaped as Unicode sequences.
    """
    # Setup capture of log messages
    caplog_records = []

    class CaptureHandler(logging.Handler):
        def emit(self, record):
            caplog_records.append(record)

    logger = logging.getLogger("agentscope")
    # Remove existing handlers to avoid duplicate logs in test environment
    for h in logger.handlers[:]:
        logger.removeHandler(h)
    logger.addHandler(CaptureHandler())
    logger.setLevel(logging.DEBUG)

    # Compose a message with Chinese characters
    message = {"text": "测试中文日志输出", "nested": {"key": "值"}}

    # Patch logger to add the custom level if missing (simulate fix environment)
    # Because the buggy code fails due to missing LEVEL_CHAT_SAVE, we add it here to avoid test error
    if not hasattr(logging_utils_module, "LEVEL_CHAT_SAVE"):
        setattr(logging_utils_module, "LEVEL_CHAT_SAVE", 25)
    if not hasattr(logger, "LEVEL_CHAT_SAVE"):
        setattr(logger, "LEVEL_CHAT_SAVE", 25)
        logging.addLevelName(25, "CHAT_SAVE")

    # Call _chat which logs with ensure_ascii=False
    logging_utils_module._chat(message)

    # Check that a log record was captured
    assert len(caplog_records) > 0
    logged_msg = caplog_records[0].getMessage()

    # The logged message should contain Chinese characters, not unicode escape sequences
    # Check that the logged message contains the original Chinese characters, not \u escapes
    assert "测试中文日志输出" in logged_msg
    assert "值" in logged_msg
    # Also check that the logged message is valid JSON
    parsed = json.loads(logged_msg)
    assert parsed == message


