def test_logging_utils_logger_log_ensure_ascii_false():
    """
    Test that the logger.log call in utils.logging_utils._chat uses json.dumps with ensure_ascii=False,
    so that Chinese characters are output as-is, not escaped.
    """
    import src.agentscope.utils.logging_utils as logging_utils

    logger = logging_utils.logger

    # Remove all handlers first to avoid duplicates
    logger.remove()

    # Add a sink to capture logs at LEVEL_CHAT_SAVE
    captured = []

    def capture_sink(message):
        captured.append(message)

    level_chat_save = logging_utils.LEVEL_CHAT_SAVE
    # Add sink with the custom level LEVEL_CHAT_SAVE
    # This will fail if LEVEL_CHAT_SAVE is not registered, which is part of the fix
    logger.add(capture_sink, level=level_chat_save)

    # Compose a message with Chinese characters
    message = {"text": "测试中文日志输出", "nested": {"key": "值"}}

    # Call _chat which logs with ensure_ascii=False
    logging_utils._chat(message)

    # There should be at least one log message captured
    assert len(captured) > 0

    # The logged message should contain the Chinese characters unescaped
    logged_message = captured[0].strip()
    # It should contain the Chinese characters literally, not escaped unicode
    assert "测试中文日志输出" in logged_message
    assert "\\u" not in logged_message


def test_json_dumps_ensure_ascii_false_in_model_str_and_dict_dialog_agent():
    """
    Test that the Model __str__ method and DictDialogAgent.reply logs JSON with ensure_ascii=False,
    so Chinese characters appear correctly.
    """
    import src.agentscope.models.model as model_module
    import src.agentscope.agents.dict_dialog_agent as dict_dialog_agent_module
    import logging

    # Test Model __str__ method outputs JSON with ensure_ascii=False
    # Create a Model instance with Chinese characters in fields
    m = model_module.Model(
        config_name="测试模型",
        model_type="test",
        model_id="模型ID",
        image_urls=["http://example.com/图片1.png", "http://example.com/图片2.png"],
        raw={"key": "值", "nested": {"子键": "子值"}},
    )
    s = str(m)
    # The string should contain Chinese characters literally, not escaped unicode
    assert "测试模型" in s
    assert "模型ID" in s
    assert "图片1.png" in s
    assert "值" in s
    assert "\\u" not in s

    # Test DictDialogAgent.reply logs JSON with ensure_ascii=False
    # Patch logger to capture debug messages
    caplog_records = []

    class CaptureHandler(logging.Handler):
        def emit(self, record):
            caplog_records.append(record)

    logger = logging.getLogger("agentscope")
    # Remove existing handlers to avoid duplicate logs in test environment
    for h in logger.handlers[:]:
        logger.removeHandler(h)
    logger.addHandler(CaptureHandler())
    logger.setLevel(logging.DEBUG)

    class DummyMemory:
        def add(self, x):
            pass

        def get_memory(self):
            return []

    class DummyAgent(dict_dialog_agent_module.DictDialogAgent):
        def __init__(self):
            # Provide minimal init params to avoid AttributeError
            super().__init__(name="dummy", use_memory=False)
            self.memory = DummyMemory()
            self.sys_prompt = ""
            # Provide dummy engine with join method
            class DummyEngine:
                def join(self, *args):
                    return "prompt"
            self.engine = DummyEngine()

        def _call(self, x):
            # Return a dict with Chinese characters
            return {"speak": "中文日志测试", "extra": {"key": "值"}}

    agent = DummyAgent()
    # Call reply with dummy input
    response = agent.reply({"input": "测试"})

    # The debug log should contain Chinese characters unescaped
    debug_msgs = [r.getMessage() for r in caplog_records if r.levelno == logging.DEBUG]
    assert any("中文日志测试" in msg for msg in debug_msgs)
    assert all("\\u" not in msg for msg in debug_msgs)


@pytest.mark.parametrize("json_func", [json.dumps])
def test_model_init_and_str_with_chinese(json_func):
    """
    Test that the Model class serializes to JSON with ensure_ascii=False,
    so that Chinese characters are output as-is, not escaped.
    """
    from src.agentscope.models import model as model_module

    # Create a Model instance with Chinese characters in fields
    m = model_module.Model(
        config_name="测试模型",
        model_type="test",
        model_id="模型ID",
        image_urls=["http://example.com/图片1.png", "http://example.com/图片2.png"],
        raw={"key": "值", "nested": {"子键": "子值"}},
    )
    s = json_func({
        "config_name": m.config_name,
        "model_type": m.model_type,
        "model_id": m.model_id,
        "image_urls": m.image_urls,
        "raw": m.raw,
    }, indent=4, ensure_ascii=False)
    # The JSON string should contain Chinese characters literally
    assert "测试模型" in s
    assert "模型ID" in s
    assert "图片1.png" in s
    assert "值" in s
    assert "\\u" not in s


def test_model_init_logs_kwargs_with_chinese(caplog):
    """
    Test that Model __init__ logs kwargs with ensure_ascii=False so Chinese chars appear correctly.
    """
    from src.agentscope.models import model as model_module

    caplog.set_level(logging.DEBUG, logger="src.agentscope.models.model.logger")

