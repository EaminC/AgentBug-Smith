    # The log should contain Chinese characters literally
    found = False
    for record in caplog.records:
        if "测试模型" in record.getMessage() and "参数" in record.getMessage() and "值" in record.getMessage():
            found = True
            # Also ensure no escaped unicode
            assert "\\u" not in record.getMessage()
    assert found


