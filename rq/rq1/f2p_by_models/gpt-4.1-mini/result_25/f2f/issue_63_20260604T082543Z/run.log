[32mimport json
import logging
import io
import sys
import builtins

import pytest

def test_json_dumps_ensure_ascii_false_in_model_str_and_dict_dialog_agent():
    """
    Test that json.dumps calls in model.__str__ and dict_dialog_agent.reply use ensure_ascii=False,
    so that Chinese characters are output as-is, not escaped.
    """
    import src.agentscope.models.model as model_module
    import src.agentscope.agents.dict_dialog_agent as dict_dialog_agent_module

    # Check that Model.__str__ returns a JSON string with Chinese characters unescaped
    # We create a minimal Model instance with Chinese characters
    # The Model class should have __str__ method that uses json.dumps(..., ensure_ascii=False)
    # We test that the output string contains the Chinese characters, not escaped unicode

    # Create a Model instance with Chinese characters in fields
    # We must find a way to create a Model instance; if Model is a class, instantiate it
    # If Model is missing, this test will fail (expected on buggy code)
    try:
        m = model_module.Model(
            name="测试模型",
            description="描述含中文",
            version="1.0",
            image_urls=["http://example.com/图片.png"],
            raw={"key": "值"},
        )
    except AttributeError:
        # On buggy codebase, Model may not exist or constructor signature may differ
        pytest.skip("Model class or constructor not available in buggy codebase")

    s = str(m)
    # The string s should contain the Chinese characters literally, not escaped
    assert "测试模型" in s
    assert "描述含中文" in s
    assert "图片.png" in s
    assert "值" in s
    # Also check that the string is valid JSON
    parsed = json.loads(s)
    assert parsed["name"] == "测试模型"
    assert parsed["description"] == "描述含中文"
    assert parsed["image_urls"][0] == "http://example.com/图片.png"
    assert parsed["raw"]["key"] == "值"

    # Now test dict_dialog_agent.reply logs with ensure_ascii=False in json.dumps
    # We create a DictDialogAgent instance and call reply with input containing Chinese characters
    # We capture the logger output at DEBUG level and check that the logged JSON string contains Chinese characters unescaped

    # Setup logger capture
    logger = logging.getLogger("agentscope")
    logger.setLevel(logging.DEBUG)
    stream = io.StringIO()
    handler = logging.StreamHandler(stream)
    handler.setLevel(logging.DEBUG)
    logger.addHandler(handler)

    # Create a minimal DictDialogAgent subclass that overrides _call to return a dict with Chinese characters
    class DummyAgent(dict_dialog_agent_module.DictDialogAgent):
        def __init__(self):
            # We must call super().__init__ with minimal args
            # The buggy code may require model attribute; patch it after init
            super().__init__(name="dummy", use_memory=False)
            # Patch model attribute with a dummy object with __str__ method
            self.model = m
            # Patch engine to a dummy to avoid errors
            class DummyEngine:
                def join(self, *args):
                    return "prompt"
            self.engine = DummyEngine()

        def _call(self, x):
            # Return dict with Chinese characters
            return {"speak": "中文日志测试", "extra": {"key": "值"}}

    agent = DummyAgent()
    # Call reply with dummy input
    _ = agent.reply({"input": "测试"})

    # Flush logger and get output
    handler.flush()
    log_output = stream.getvalue()

    logger.removeHandler(handler)

    # The logged message should contain Chinese characters unescaped (not \uXXXX)
    # We check for presence of Chinese characters directly
    assert "中文日志测试" in log_output
    assert "值" in log_output
    # Also check that the logged string is valid JSON
    # Extract JSON from log output by finding first '{' and last '}'
    first_brace = log_output.find("{")
    last_brace = log_output.rfind("}")
    assert first_brace != -1 and last_brace != -1 and last_brace > first_brace
    json_str = log_output[first_brace:last_brace+1]
    parsed_log = json.loads(json_str)
    assert parsed_log["speak"] == "中文日志测试"
    assert parsed_log["extra"]["key"] == "值"

def test_logging_utils_logger_log_ensure_ascii_false():
    """
    Test that the logger.log call in utils.logging_utils._chat uses json.dumps with ensure_ascii=False,
    so that Chinese characters are output as-is, not escaped.
    """
    import src.agentscope.utils.logging_utils as logging_utils_module
    import loguru

    # Setup a loguru logger with a sink to capture logs
    captured = []

    def capture_sink(message):
        captured.append(message)

    # Add sink with level that includes LEVEL_CHAT_SAVE
    logger = logging_utils_module.logger
    # Remove all handlers first to avoid duplicates
    logger.remove()
    logger.add(capture_sink, level=logging_utils_module.LEVEL_CHAT_SAVE)

    # Prepare a message dict with Chinese characters
    msg = {"text": "测试中文日志输出", "nested": {"key": "值"}}

    # Call _chat which calls logger.log with json.dumps(..., ensure_ascii=False)
    logging_utils_module._chat(msg)

    # The captured list should have one entry with the JSON string
    assert len(captured) == 1
    logged_str = captured[0].strip()
    # The logged string should contain Chinese characters literally, not escaped unicode
    assert "测试中文日志输出" in logged_str
    assert "值" in logged_str

    # Also check that the logged string is valid JSON
    parsed = json.loads(logged_str)
    assert parsed["text"] == "测试中文日志输出"
    assert parsed["nested"]["key"] == "值"[0m
