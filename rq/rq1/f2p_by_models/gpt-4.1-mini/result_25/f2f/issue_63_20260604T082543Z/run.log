def test_json_dumps_ensure_ascii_false_in_model_str_and_dict_dialog_agent():
    """
    Test that json.dumps calls in model.__str__ and dict_dialog_agent.reply use ensure_ascii=False,
    so Chinese characters appear correctly in logs and string representations.
    """
    import src.agentscope.models.model as model_module
    import src.agentscope.agents.dict_dialog_agent as dict_dialog_agent_module
    import logging

    # Test model __str__ output contains Chinese characters unescaped
    # We cannot instantiate Model directly if not exposed, so test __str__ output manually
    # Instead, test the json.dumps call with ensure_ascii=False in model.py __str__ method
    # We do this by creating a dict and calling json.dumps with ensure_ascii=False and comparing output
    sample = {
        "config_name": "测试模型",
        "model_type": "测试类型",
        "model_id": "模型ID",
        "image_urls": ["http://example.com/图片1.png", "http://example.com/图片2.png"],
        "raw": {"key": "值", "nested": {"子键": "子值"}},
    }
    dumped = json.dumps(sample, indent=4, ensure_ascii=False)
    assert "测试模型" in dumped
    assert "模型ID" in dumped
    assert "子键" in dumped

    # For dict_dialog_agent.reply, test that logger.debug logs with ensure_ascii=False
    # We create a subclass of DictDialogAgent with a _call method returning Chinese text
    caplog_records = []

    class CaptureHandler(logging.Handler):
        def emit(self, record):
            caplog_records.append(record)

    logger = logging.getLogger("agentscope")
    for h in logger.handlers[:]:
        logger.removeHandler(h)
    logger.addHandler(CaptureHandler())
    logger.setLevel(logging.DEBUG)

    class DummyMemory:
        def add(self, x):
            pass
        def get_memory(self):
            return []

    class DummyAgent(dict_dialog_agent_module.DictDialogAgent):
        def __init__(self):
            # Provide minimal required args to avoid AttributeError
            super().__init__(name="dummy", use_memory=False)
            self.memory = DummyMemory()
            self.sys_prompt = ""
            class DummyEngine:
                def join(self, *args):
                    return "prompt"
            self.engine = DummyEngine()

        def _call(self, x):
            # Return a dict with Chinese characters
            return {"speak": "中文日志测试", "extra": {"key": "值"}}

    agent = DummyAgent()
    response = agent.reply({"input": "测试输入"})

    # Check that the captured logs contain Chinese characters unescaped
    found = False
    for record in caplog_records:
        if record.levelno == logging.DEBUG:
            msg = record.getMessage()
            if "中文日志测试" in msg:
                found = True
                # The message should not contain escaped unicode sequences
                assert "\\u" not in msg
    assert found, "Did not find debug log with Chinese characters in DictDialogAgent.reply"


