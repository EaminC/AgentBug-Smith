def test_logging_utils_logger_log_ensure_ascii_false(caplog):
    """
    Test that the logging_utils._chat function logs messages with ensure_ascii=False,
    so Chinese characters are not escaped.
    """
    from src.agentscope.utils import logging_utils

    logger = logging.getLogger("agentscope")
    logger.setLevel(logging.DEBUG)
    caplog.set_level(logging.DEBUG, logger="agentscope")

    # Prepare a Chinese message dict
    message = {"text": "测试中文日志", "nested": {"key": "值"}}

    # Call the _chat function which internally calls logger.log with json.dumps
    logging_utils._chat(message)

    # Check that the log record contains the Chinese characters unescaped
    found = False
    for record in caplog.records:
        if record.levelno == logging_utils.LEVEL_CHAT_SAVE:
            # The message should be a JSON string with Chinese characters unescaped
            log_msg = record.getMessage()
            # It should contain the Chinese characters as is, not escaped unicode
            if "测试中文日志" in log_msg and "值" in log_msg:
                # Also ensure no \u escape sequences for these characters
                assert not re.search(r"\\u[0-9a-fA-F]{4}", log_msg)
                found = True
    assert found, "Did not find expected log record with unescaped Chinese characters"


