# ---------------------------------------------------------------------------
# RQ4 gitignore
# ---------------------------------------------------------------------------

# Python venvs (one per agent component)
agent/.venv/

# Real secrets — only .env.example is tracked
agent/config/.env
agent/openhands-config/.env

# mini-swe-agent is a read-only external module.
# Everything inside agent/mini-swe-agent/ is regenerated by scripts/setup.sh.
agent/mini-swe-agent/

# Editor / OS junk
.DS_Store
*.swp
*.swo
.idea/

# Local artifacts we don't want to track.
# Per-rollout trajectories are large (up to ~1 MB each) and reproducible
# from utils/verify/solve.py; only the aggregate CSV + figures go to git.
data/verify/runs/**/trajectory.json
data/verify/runs/**/prompt.txt
data/verify/runs/**/_no_patch.json
data/verify/runs/**/_build_failed.json
data/verify/runs/**/_timeout.json

# Local-only sandbox output that may end up at the repo root
/testbed/
/patch.txt
/results/eval/
.vscode/
__pycache__/
*.pyc
utils/.env

# data/ layout:
#   data/raw/                 — sparse-checkout of AgentBug-Smith (hundreds
#                               of MB, regenerable via utils/pipeline.py).
#   data/index.jsonl          — full classified index (after LLM classify,
#                               ~600 KB). Regenerable.
#   data/splits/              — repo-disjoint train/test split output.
#                               Regenerable via utils/split/run.py.
#   data/verify/              — TRACKED. Contains:
#                                 _pool/                  verify build dirs (4.8 MB)
#                                 issue_index_*.jsonl     full per-combo indexes
#                                 issue_index_pilot30_*   pilot-30 subsets (generated by
#                                                       utils/verify/make_pilot30_index.py)
#                                 audit.json              pool audit report
#                               Solves "I cloned the repo, now what?": these
#                               files are needed for solve.py to run without
#                               first re-running utils/pipeline.py.
#   data/verify/runs/         — UNTRACKED. Per-rollout outputs (patch.txt,
#                               trajectory.json, image_meta.json, …). These
#                               are produced by solve.py rollout. The
#                               fine-grained ignores below catch the heavy
#                               / non-portable bits.
data/raw/
data/index.jsonl
data/splits/
data/verify/runs/

# Validator-rejected skill drafts. The train pipeline saves failed
# runs here so we can inspect them, but they should never enter the
# repo: they're known-bad and the validator already replaced them
# with the fallback_generic_fix.md.
*.hallucinated.*
agent/skills/**/*.hallucinated.*

# Local plaintext scratch — contains secrets / chat history, NEVER track.
history.txt
*.local.txt
utils/.env
agent/openhands-sdk/   # local openhands SDK install (large, reproducible)
logs/                 # per-run logs (large, reproducible)

# Training traces: keep metrics locally+remotely, but never commit logs/dockerfiles that embed API tokens.
data/training_trace/**/run.log
data/training_trace/**/env.dockerfile
