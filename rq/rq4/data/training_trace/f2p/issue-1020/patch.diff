diff --git a/src/strands/tools/decorator.py b/src/strands/tools/decorator.py
index 99aa7e372..0258fc7d7 100644
--- a/src/strands/tools/decorator.py
+++ b/src/strands/tools/decorator.py
@@ -633,6 +633,17 @@ def tool(  # type: ignore
 
         # Create function tool metadata
         tool_meta = FunctionToolMetadata(f, context_param)
+
+        # Validate context parameter name matches function signature
+        if context_param is not None:
+            if context_param not in inspect.signature(f).parameters:
+                raise ValueError(f"param_name=<{list(inspect.signature(f).parameters.keys())}> | ToolContext param must be named '{context_param}'")
+        else:
+            # If any param is ToolContext but no context flag set, raise error
+            for param in inspect.signature(f).parameters.values():
+                if param.annotation == ToolContext:
+                    raise ValueError("@tool(context) must be set if passing in ToolContext param")
+
         tool_spec = tool_meta.extract_metadata()
         if name is not None:
             tool_spec["name"] = name
