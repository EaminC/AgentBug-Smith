diff --git a/src/strands/tools/registry.py b/src/strands/tools/registry.py
index 15150847d..3b543d1ed 100644
--- a/src/strands/tools/registry.py
+++ b/src/strands/tools/registry.py
@@ -694,3 +694,25 @@ class ToolRegistry:
 
         if exceptions:
             raise exceptions[0]
+    def replace(self, tool: AgentTool) -> None:
+        """Replace an existing tool with a new implementation.
+
+        Args:
+            tool: The new tool instance to replace the existing one.
+
+        Raises:
+            ValueError: If the tool does not exist in the registry.
+        """
+        existing_tool = self.registry.get(tool.tool_name)
+        if existing_tool is None:
+            raise ValueError(f"Cannot replace tool '{tool.tool_name}' - tool does not exist")
+
+        # Replace the tool in the main registry
+        self.registry[tool.tool_name] = tool
+
+        # Manage dynamic_tools accordingly
+        if tool.is_dynamic:
+            self.dynamic_tools[tool.tool_name] = tool
+        else:
+            if tool.tool_name in self.dynamic_tools:
+                del self.dynamic_tools[tool.tool_name]
