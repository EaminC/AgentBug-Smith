             agent.messages = self._fix_broken_tool_use(agent.messages)
 
     def _fix_broken_tool_use(self, messages: list[Message]) -> list[Message]:
+        # Remove orphaned toolResult messages that do not have a preceding toolUse
+        new_messages = []
+        seen_tool_use_ids = set()
+        for msg in messages:
+            # Check if message contains only toolResult(s)
+            if all("toolResult" in c for c in msg["content"]):
+                tool_result_ids = {c["toolResult"]["toolUseId"] for c in msg["content"] if "toolResult" in c}
+                # If none of the toolResult ids have been seen as toolUse ids yet, skip this message
+                if not tool_result_ids.intersection(seen_tool_use_ids):
+                    continue
+            for c in msg["content"]:
+                if "toolUse" in c:
+                    seen_tool_use_ids.add(c["toolUse"]["toolUseId"])
+            new_messages.append(msg)
+        messages = new_messages
+
         """Add tool_result after orphaned tool_use messages.
 
         Before 1.15.0, strands had a bug where they persisted sessions with a potentially broken messages array.
