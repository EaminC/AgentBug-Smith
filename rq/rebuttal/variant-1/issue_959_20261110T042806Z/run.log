# Extra environment variables
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV MODEL=openrouter2/openai/gpt-4.1-mini
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0
ENV TAVILY_API_KEY=tvly-key
ENV GITHUB_TOKEN=ghp_key

# Copy entire repository
COPY . .

# Install system dependencies needed for building Python packages including mcp
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       gcc \
       python3-dev \
       libffi-dev \
       build-essential \
       libxml2-dev \
       libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install project dependencies if requirements.txt exists and install project
RUN if [ -f requirements.txt ]; then \
    pip install --no-cache-dir -r requirements.txt ; \
    fi && pip install --no-cache-dir -e .

# Install testing and essential packages incl. mcp, fastmcp, pytest
RUN pip install --no-cache-dir \
    pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout pytest-block-network \
    "setuptools<=81.0.0" litellm mem0ai vcrpy json_repair chromadb syrupy respx \
    langgraph-checkpoint-sqlite aiosqlite langgraph-checkpoint-postgres \
    "psycopg[binary,pool]" redis apscheduler fastapi fakeredis boto3 agno pydantic-ai fastmcp ray mcp

# Preflight check for critical imports
RUN python -c 'import pkg_resources, pytest, ray, mcp, fastmcp; print("preflight ok")'

# Set PYTHONPATH for src/ layout
ENV PYTHONPATH=/app:/app/src

# Default command to keep container running
CMD ["/bin/bash"]
