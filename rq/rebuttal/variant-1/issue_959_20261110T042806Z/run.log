ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV MODEL=openrouter2/openai/gpt-4.1-mini
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

# Set working directory
WORKDIR /app

# Copy complete repository
COPY . .

# Install system dependencies needed for building Python packages
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       gcc \
       python3-dev \
       libffi-dev \
       build-essential \
       libxml2-dev \
       libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and setuptools
RUN python -m pip install --upgrade pip setuptools wheel

# Pin mcp to a compatible version to avoid ImportErrors (adjust version as appropriate)
RUN pip install --no-cache-dir "mcp==1.12.3"

# Install project dependencies if requirements.txt exists
RUN if [ -f "requirements.txt" ]; then pip install --no-cache-dir -r requirements.txt; fi

# Install the project itself in editable mode
RUN pip install --no-cache-dir -e .

# Install testing and other dependencies
RUN pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai vcrpy json_repair chromadb syrupy respx langgraph-checkpoint-sqlite aiosqlite langgraph-checkpoint-postgres "psycopg[binary,pool]" redis apscheduler fastapi fakeredis boto3 agno pydantic-ai fastmcp ray

# Preflight check
RUN python -c 'import pkg_resources, pytest, ray, mcp; print("preflight ok")'

# Set PYTHONPATH for possible src/ layout
ENV PYTHONPATH=/app:/app/src

# Default to keep container open with bash shell
CMD ["/bin/bash"]
