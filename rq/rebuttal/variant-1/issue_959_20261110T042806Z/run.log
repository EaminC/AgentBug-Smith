[32m# branch: python/pyproject.toml
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"

# Set working directory
WORKDIR /app

# Copy entire repository contents
COPY . .

# Install system dependencies for Python packages and compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc python3-dev libffi-dev build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install project dependencies
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt && pip install -e . && pip install ray mcp; \
    else \
      pip install -e . && pip install ray mcp; \
    fi

# Install testing tools and commonly needed test packages excluding pytest-block-network
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout \
    "setuptools<=81.0.0" litellm mem0ai vcrpy json_repair chromadb syrupy respx langgraph-checkpoint-sqlite \
    aiosqlite langgraph-checkpoint-postgres "psycopg[binary,pool]" redis apscheduler fastapi fakeredis boto3 agno \
    pydantic-ai fastmcp

# Preflight check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set PYTHONPATH for src/ layout
ENV PYTHONPATH=/app:/app/src

# Default command to keep container running and CLI access
CMD ["/bin/bash"]
