[32m# branch: python/requirements.txt
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Export additional environment variables (from .env)
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV MODEL=openrouter2/openai/gpt-4.1-mini
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0
ENV TAVILY_API_KEY=tvly-key
ENV GITHUB_TOKEN=ghp_key

# Copy entire repository to /app
COPY . .

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc python3-dev libffi-dev build-essential libxml2-dev libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies if requirements.txt exists, then install the project
RUN if [ -f requirements.txt ]; then pip install --no-cache-dir -r requirements.txt; fi && pip install --no-cache-dir -e .

# Install essential testing packages and dependencies
# Removed pytest-block-network (unavailable) and ensured required test dependencies
RUN pip install --no-cache-dir \
    pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout \
    anyio "setuptools<=81.0.0" litellm mem0ai vcrpy json_repair chromadb syrupy respx \
    langgraph-checkpoint-sqlite aiosqlite langgraph-checkpoint-postgres \
    "psycopg[binary,pool]" redis apscheduler fastapi fakeredis boto3 agno pydantic-ai \
    fastmcp ray mcp

# Preflight test for critical imports
RUN python -c 'import pkg_resources, pytest, ray, mcp, fastmcp; print("preflight ok")'

# Set PYTHONPATH for src/ layout
ENV PYTHONPATH=/app:/app/src

# Default command to keep container running
CMD ["/bin/bash"]
