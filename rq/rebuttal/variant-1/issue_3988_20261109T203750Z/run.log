# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set Forge API environment variables for OpenAI and Anthropic compatibility
ENV FORGE_API_KEY=forge-key \
    OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Set working directory
WORKDIR /app

# Install system dependencies for building Python packages, including cryptography
RUN apt-get update && apt-get install -y \
    gcc \
    libffi-dev \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository into container
COPY . .

# Install project dependencies if requirements.txt exists
RUN if [ -f "requirements.txt" ]; then \
    pip install --no-cache-dir -r requirements.txt; \
    fi

# Install the project in editable mode
RUN pip install --no-cache-dir -e .

# Install test dependencies explicitly including cryptography
RUN pip install --no-cache-dir \
    pytest pytest-mock pytest-asyncio pytest-cov pytest-timeout pytest-xdist pytest-split \
    cryptography litellm json_repair chromadb appdirs pyjwt "setuptools<=81.0.0"

# Set PYTHONPATH including workspace sub-package source directories
ENV PYTHONPATH=/app:/app/lib/crewai/src:/app/lib/crewai-tools/src:/app/lib/devtools/src

# Default command
CMD ["/bin/bash"]

# branch: python project with requirements.txt, editable install, cryptography and test deps, Forge API env vars
