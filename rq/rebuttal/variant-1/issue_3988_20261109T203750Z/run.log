[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    FORGE_API_KEY=forge-key \
    FORGE_BASE_URL=https://api.forge.tensorblock.co/v1 \
    MODEL=openrouter2/openai/gpt-4.1-mini \
    AI_TEMPERATURE=0.7 \
    ANTHROPIC_MODEL=openrouter2/openai/gpt-4.1-mini \
    ANTHROPIC_SMALL_FAST_MODEL=openrouter2/openai/gpt-4.1-mini \
    TAVILY_API_KEY=tvly-key \
    GITHUB_TOKEN=ghp_key \
    PYTHONPATH=/app:/app/lib/crewai/src:/app/lib/crewai-tools/src:/app/lib/devtools/src

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y \
    gcc \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and setuptools
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire project
COPY . .

# Install Python packages including pytest-related ones, excluding problematic pytest-block-network
RUN pip install --no-cache-dir numpy pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout pytest-xdist "setuptools<=81.0.0" litellm vcrpy boto3-stubs[bedrock-runtime]>=1.40.54 "types-requests~=2.31.0.6" "types-pyyaml==6.0.*" "types-regex==2024.11.6.*" "types-appdirs==1.4.*" "types-psycopg2>=2.9.21.20251012" "types-pymysql>=1.1.0.20250916" && pip install -e .

# Default command
CMD ["/bin/bash"]

# branch: python project with pyproject.toml, Forge API env vars, robust system deps, test deps, excluding pytest-block-network
