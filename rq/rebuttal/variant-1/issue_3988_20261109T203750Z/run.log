ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y \
    gcc \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire project into container
COPY . .

# Install poetry to handle pyproject.toml dependencies
RUN pip install --no-cache-dir poetry

# Install dependencies (excluding package itself), then install editable package
RUN poetry config virtualenvs.create false && \
    poetry install --no-root --no-interaction --no-ansi && \
    pip install --no-cache-dir -e . \
    json_repair pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout pytest-xdist "setuptools<=81.0.0" litellm

# Set environment variables for Forge API compatibility and test environment
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    FORGE_API_KEY=forge-key \
    FORGE_BASE_URL=https://api.forge.tensorblock.co/v1 \
    MODEL=openrouter2/openai/gpt-4.1-mini \
    AI_TEMPERATURE=0.7 \
    ANTHROPIC_MODEL=openrouter2/openai/gpt-4.1-mini \
    ANTHROPIC_SMALL_FAST_MODEL=openrouter2/openai/gpt-4.1-mini \
    TAVILY_API_KEY=tvly-key \
    GITHUB_TOKEN=ghp_key

# Set PYTHONPATH to include app and relevant subfolders
ENV PYTHONPATH=/app:/app/lib/crewai/src:/app/lib/crewai-tools/src:/app/lib/devtools/src

# Default command for the container
CMD ["/bin/bash"]

