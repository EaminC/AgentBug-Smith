# Install system dependencies necessary for building some Python packages (like numpy) and development
RUN apt-get update && apt-get install -y \
    gcc \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repo into container
COPY . .

# Install Python dependencies including numpy, pytest, and additional test dependencies
RUN pip install --no-cache-dir numpy pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout pytest-xdist pytest-block-network "setuptools<=81.0.0" litellm \
    && pip install -e .

# Default command
CMD ["/bin/bash"]

