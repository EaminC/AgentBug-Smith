    pytest pytest-mock pytest-asyncio pytest-cov pytest-timeout pytest-xdist \
    litellm json_repair chromadb appdirs "setuptools<=81.0.0"

# Set PYTHONPATH to include app root and relevant lib subfolders
ENV PYTHONPATH=/app:/app/lib/crewai/src:/app/lib/crewai-tools/src

# Default command
CMD ["/bin/bash"]

