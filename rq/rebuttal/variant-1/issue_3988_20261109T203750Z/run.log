# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set Forge API environment variables for OpenAI and Anthropic compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Set other environment variables from existing .env
ENV FORGE_API_KEY="forge-key" \
    FORGE_BASE_URL="https://api.forge.tensorblock.co/v1" \
    MODEL="openrouter2/openai/gpt-4.1-mini" \
    AI_TEMPERATURE="0.7" \
    ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini" \
    ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini" \
    TAVILY_API_KEY="tvly-key" \
    GITHUB_TOKEN="ghp_key"

# Working directory
WORKDIR /app

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y \
    gcc \
    libffi-dev \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel to latest
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository to container
COPY . .

# Install project dependencies - no requirements.txt detected, using pip editable install
RUN pip install --no-cache-dir -e .

# Install key test dependencies explicitly
RUN pip install --no-cache-dir \
    pytest pytest-mock pytest-asyncio pytest-cov pytest-timeout pytest-xdist pytest-split \
    litellm json_repair chromadb appdirs pyjwt "setuptools<=81.0.0" \
    opentelemetry-api opentelemetry-sdk opentelemetry-exporter-otlp-proto-http opentelemetry-proto

# Set PYTHONPATH for src layout
ENV PYTHONPATH=/app:/app/lib/crewai/src:/app/lib/crewai-tools/src:/app/lib/devtools/src

# Default command is bash for testing environment
CMD ["/bin/bash"]

# branch: python project with pyproject.toml, editable install, Forge API env vars, explicit testing deps, src layout
