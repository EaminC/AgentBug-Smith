@pytest.mark.asyncio
async def test_openai_streaming_tool_input_prefers_valid_final_json() -> None:
    """Test OpenAIChatModel streaming tool input keeps the final valid JSON dict."""
    with patch("openai.AsyncClient") as mock_client_class:
        mock_client = AsyncMock()
        mock_client_class.return_value = mock_client

        model = OpenAIChatModel(
            model_name="gpt-4",
            api_key="test_key",
            stream=True,
