    # Auxiliary methods - ensure all Mock objects have complete attributes
    def _create_mock_response(
        self,
        content: str = "",
        prompt_tokens: int = 10,
        completion_tokens: int = 20,
    ) -> Mock:
        """Create a standard mock response."""
        message = Mock()
        message.content = content
