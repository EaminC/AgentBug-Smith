[32m# -*- coding: utf-8 -*-
"""Fail2pass test for issue #1351: JSON string repair edge case for tool callings."""
import asyncio
from unittest.mock import AsyncMock, Mock, patch

from agentscope.model import AnthropicChatModel, DashScopeChatModel, OpenAIChatModel
from agentscope.message import ToolUseBlock


async def test_anthropic_streaming_tool_input_prefers_valid_final_json() -> None:
    """Test AnthropicChatModel streaming tool input keeps the final valid JSON dict."""
    with patch("anthropic.AsyncAnthropic") as mock_client_class:
        mock_client = AsyncMock()
        mock_client_class.return_value = mock_client

        model = AnthropicChatModel(
            model_name="claude-3-sonnet-20240229",
            api_key="test_key",
            stream=True,
        )
        model.client = mock_client

        # Simulate streaming events with partial JSON fragments for tool input
        class AnthropicContentBlockMock:
            def __init__(self, block_type, **kwargs):
                self.type = block_type
                for k, v in kwargs.items():
                    setattr(self, k, v)

        class AnthropicEventMock:
            def __init__(self, event_type, **kwargs):
                self.type = event_type
                for k, v in kwargs.items():
                    setattr(self, k, v)

        events = [
            AnthropicEventMock(
                "message_start",
                message=Mock(usage=Mock(input_tokens=10, output_tokens=0)),
            ),
            AnthropicEventMock(
                "content_block_start",
                index=0,
                content_block=AnthropicContentBlockMock(
                    "tool_use",
                    id="tool_123",
                    name="score",
                ),
            ),
            AnthropicEventMock(
                "content_block_delta",
                index=0,
                delta=Mock(
                    type="input_json_delta",
                    partial_json='{"points": ',
                ),
            ),
            AnthropicEventMock(
                "content_block_delta",
                index=0,
                delta=Mock(
                    type="input_json_delta",
                    partial_json="1}",
                ),
            ),
            AnthropicEventMock(
                "message_delta",
                usage=Mock(output_tokens=5),
            ),
        ]

        async def mock_stream():
            for event in events:
                yield event

        mock_client.messages.create = AsyncMock(return_value=mock_stream())
        result = await model([{"role": "user", "content": "Score it"}])

        responses = []
        async for response in result:
            responses.append(response)

        final_response = responses[-1]
        expected_content = [
            ToolUseBlock(
                type="tool_use",
                id="tool_123",
                name="score",
                input={"points": 1},
                raw_input='{"points": 1}',
            ),
        ]
        assert final_response.content == expected_content


async def test_dashscope_streaming_tool_input_prefers_valid_final_json() -> None:
    """Test DashScopeChatModel streaming tool input keeps the final valid JSON dict."""
    model = DashScopeChatModel(
        model_name="qwen-turbo",
        api_key="test_key",
        stream=True,
    )

    # Prepare chunks simulating partial JSON arguments for a tool call
    def create_mock_chunk(tool_calls=None):
        tool_calls = tool_calls or []
        chunk = Mock()
        chunk.status_code = 200
        chunk.output = Mock()
        chunk.output.choices = [Mock()]
        chunk.output.choices[0].message = Mock()
        chunk.output.choices[0].message.tool_calls = []
        for tc in tool_calls:
            tc_mock = Mock()
            tc_mock.id = tc["id"]
            tc_mock.index = 0
            tc_mock.function = Mock()
            tc_mock.function.name = tc["function"]["name"]
            tc_mock.function.arguments = tc["function"]["arguments"]
            chunk.output.choices[0].message.tool_calls.append(tc_mock)
        chunk.usage = Mock()
        chunk.usage.input_tokens = 5
        chunk.usage.output_tokens = 10
        return chunk

    chunks = [
        create_mock_chunk(
            tool_calls=[
                {
                    "index": 0,
                    "id": "call_123",
                    "function": {
                        "name": "score",
                        "arguments": '{"points": ',
                    },
                },
            ],
        ),
        create_mock_chunk(
            tool_calls=[
                {
                    "index": 0,
                    "id": "call_123",
                    "function": {
                        "name": "score",
                        "arguments": "1}",
                    },
                },
            ],
        ),
    ]

    async def async_gen():
        for c in chunks:
            yield c

    with patch(
        "dashscope.aigc.generation.AioGeneration.call",
    ) as mock_call:
        mock_call.return_value = async_gen()
        result = await model([{"role": "user", "content": "Score it"}])

        responses = []
        async for response in result:
            responses.append(response)

        final_response = responses[-1]
        expected_content = [
            ToolUseBlock(
                type="tool_use",
                id="call_123",
                name="score",
                input={"points": 1},
                raw_input='{"points": 1}',
            ),
        ]
        assert final_response.content == expected_content


async def test_openai_streaming_tool_input_prefers_valid_final_json() -> None:
    """Test OpenAIChatModel streaming tool input keeps the final valid JSON dict."""
    with patch("openai.AsyncClient") as mock_client_class:
        mock_client = AsyncMock()
        mock_client_class.return_value = mock_client

        model = OpenAIChatModel(
            model_name="gpt-4",
            api_key="test_key",
            stream=True,
        )
        model.client = mock_client

        # Prepare streaming chunks with partial tool call arguments
        class MessageMock(dict):
            def __init__(self, data):
                super().__init__(data)
                for k, v in data.items():
                    setattr(self, k, v)

        class MockStream:
            def __init__(self, chunks_data):
                self.chunks_data = chunks_data
                self.index = 0

            async def __aenter__(self):
                return self

            async def __aexit__(self, exc_type, exc_val, exc_tb):
                pass

            def __aiter__(self):
                return self

            async def __anext__(self):
                if self.index >= len(self.chunks_data):
                    raise StopAsyncIteration
                chunk_data = self.chunks_data[self.index]
                self.index += 1

                choice = Mock()
                delta = Mock()
                delta.content = None
                delta.reasoning_content = None
                delta.audio = Mock()
                delta.audio.__contains__ = lambda self, key: False
                if "tool_calls" in chunk_data:
                    tool_call_mocks = []
                    for tc_data in chunk_data["tool_calls"]:
                        tc_mock = Mock()
                        tc_mock.id = tc_data["id"]
                        tc_mock.function = Mock()
                        tc_mock.function.name = tc_data["name"]
                        tc_mock.function.arguments = tc_data["arguments"]
                        tool_call_mocks.append(tc_mock)
                    delta.tool_calls = tool_call_mocks
                else:
                    delta.tool_calls = []
                choice.delta = delta

                chunk = Mock()
                chunk.choices = [choice]
                chunk.usage = Mock()
                chunk.usage.prompt_tokens = 5
                chunk.usage.completion_tokens = 10
                return chunk

        stream_mock = MockStream(
            [
                {
                    "tool_calls": [
                        {
                            "id": "call_123",
                            "name": "score",
                            "arguments": '{"points": ',
                        },
                    ],
                },
                {
                    "tool_calls": [
                        {
                            "id": "call_123",
                            "name": "score",
                            "arguments": "1}",
                        },
                    ],
                },
            ],
        )

        mock_client.chat.completions.create = AsyncMock(return_value=stream_mock)

        result = await model([{"role": "user", "content": "Score it"}])

        responses = []
        async for response in result:
            responses.append(response)

        final_response = responses[-1]
        expected_content = [
            ToolUseBlock(
                type="tool_use",
                id="call_123",
                name="score",
                input={"points": 1},
                raw_input='{"points": 1}',
            ),
        ]
        assert final_response.content == expected_content


