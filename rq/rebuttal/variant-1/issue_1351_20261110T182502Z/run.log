        client_kwargs = {"timeout": 30}
        with patch("openai.AsyncClient") as mock_client:
            model = OpenAIChatModel(
                model_name="gpt-4o",
                api_key="test_key",
                stream=False,
                reasoning_effort="high",
                organization="org-123",
                client_kwargs=client_kwargs,
                generate_kwargs=generate_kwargs,
