                        delta.tool_calls = tool_call_mocks
                    else:
                        delta.tool_calls = []

                    choice.delta = delta

                chunk = Mock()
                chunk.choices = [choice]
                chunk.usage = Mock()
                chunk.usage.prompt_tokens = 5
                chunk.usage.completion_tokens = 10
                return chunk

        return MockStream(chunks_data)



