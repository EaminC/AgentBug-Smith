import pytest

from agentscope.model import AnthropicChatModel, DashScopeChatModel, OpenAIChatModel
from agentscope.message import ToolUseBlock


@pytest.mark.asyncio
async def test_anthropic_streaming_tool_input_prefers_valid_final_json():
    """Test AnthropicChatModel streaming tool input keeps the final valid JSON dict."""
    with patch("anthropic.AsyncAnthropic") as mock_client_class:
        mock_client = AsyncMock()
        mock_client_class.return_value = mock_client

        model = AnthropicChatModel(
            model_name="claude-3-sonnet-20240229",
            api_key="test_key",
            stream=True,
        )
        model.client = mock_client

        events = [
            # Start message event
            Mock(type="message_start", message=Mock(usage=Mock(input_tokens=10, output_tokens=0))),
            # Start tool_use content block
            Mock(
                type="content_block_start",
                index=0,
                content_block=Mock(type="tool_use", id="tool_123", name="score"),
            ),
            # Partial JSON input chunk 1 (incomplete)
            Mock(
                type="content_block_delta",
                index=0,
                delta=Mock(type="input_json_delta", partial_json='{"points": '),
            ),
            # Partial JSON input chunk 2 (completes JSON)
            Mock(
                type="content_block_delta",
                index=0,
                delta=Mock(type="input_json_delta", partial_json="1}"),
            ),
            # Message delta event with usage
            Mock(type="message_delta", usage=Mock(output_tokens=5)),
        ]

        async def mock_stream():
            for event in events:
                yield event

        mock_client.messages.create = AsyncMock(return_value=mock_stream())
        result = await model([{"role": "user", "content": "Score it"}])

        responses = []
        async for response in result:
            responses.append(response)

        final_response = responses[-1]
        expected_content = [
            ToolUseBlock(
                type="tool_use",
                id="tool_123",
                name="score",
                input={"points": 1},
                raw_input='{"points": 1}',
            ),
        ]
        assert final_response.content == expected_content


