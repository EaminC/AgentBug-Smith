[32mimport pytest
import importlib.util

from mle.model import load_model, MODEL_GEMINI


def test_gemini_model_importable_and_loadable():
    # Check that the gemini module is importable
    spec = importlib.util.find_spec("mle.model.gemini")
    assert spec is not None, "mle.model.gemini module should be importable"

    # Check that the GeminiModel class is present
    gemini_module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(gemini_module)
    assert hasattr(gemini_module, "GeminiModel"), "GeminiModel class should be defined"

def test_load_model_with_gemini_platform(monkeypatch):
    # Patch get_config to return a config with platform Gemini
    def fake_get_config(project_dir):
        return {
            "platform": MODEL_GEMINI,
            "api_key": "fake_api_key",
            "model": "gemini-1.5-flash"
        }
    # Patch mle.utils.get_config to our fake_get_config
    import mle.utils
    monkeypatch.setattr(mle.utils, "get_config", fake_get_config)

    # Load model should return an instance of GeminiModel wrapped in ObservableModel
    model_wrapper = load_model("dummy_project_dir", model_name="gemini-1.5-flash", observable=True)
    # Check that the loaded model is an instance of GeminiModel
    # The wrapped model is in model_wrapper._model
    gemini_model_class = getattr(__import__("mle.model.gemini", fromlist=["GeminiModel"]), "GeminiModel")
    assert isinstance(model_wrapper._model, gemini_model_class)

def test_gemini_model_query_and_stream(monkeypatch):
    # Import GeminiModel class
    from mle.model.gemini import GeminiModel

    # We will monkeypatch the gemini attribute of GeminiModel instance to simulate the gemini client and its methods
    class DummyFunctionCall:
        def __init__(self, name, args):
            self.name = name
            self.args = args

    class DummyPart:
        def __init__(self, function_call=None, text="response text"):
            self.function_call = function_call
            self.text = text

    class DummyCompletion:
        def __init__(self, parts):
            self.parts = parts
            self.text = "final response text"

    class DummyChatHandler:
        def __init__(self):
            self.sent_messages = []

        def send_message(self, message, **kwargs):
            self.sent_messages.append((message, kwargs))
            # Simulate a function call in the first completion
            if isinstance(message, str):
                # Return a completion with a function call part
                fn_call = DummyFunctionCall(name="search_papers_with_code", args={"query": "test"})
                part = DummyPart(function_call=fn_call)
                return DummyCompletion(parts=[part])
            else:
                # This is the second call with function response parts
                return DummyCompletion(parts=[], text="final response text")

    class DummyGenerativeModel:
        def __init__(self, model):
            self.model = model

        def start_chat(self, history):
            return DummyChatHandler()

    class DummyGemini:
        protos = type("protos", (), {
            "Type": type("Type", (), {
                "STRING": 1,
                "OBJECT": 2,
                "NUMBER": 3,
                "BOOLEAN": 4,
                "ARRAY": 5,
                "TYPE_UNSPECIFIED": 0,
            }),
            "Tool": lambda **kwargs: "tool",
            "FunctionDeclaration": lambda **kwargs: "func_decl",
            "Schema": lambda **kwargs: "schema",
            "Part": lambda **kwargs: DummyPart(text="response text"),
            "FunctionResponse": lambda **kwargs: "func_resp",
            "Content": lambda **kwargs: "content",
        })
        types = type("types", (), {
            "GenerationConfig": lambda **kwargs: "gen_config"
        })
        GenerativeModel = DummyGenerativeModel

    # Instantiate GeminiModel with dummy api_key and model
    model = GeminiModel(api_key="dummy_key", model="gemini-1.5-flash")

    # Replace gemini attribute with dummy gemini client
    model.gemini = DummyGemini()

    # Prepare a dummy chat history in openai format
    chat_history = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Tell me about AI."}
    ]

    # Call query method, should return the final response text from dummy completion
    response = model.query(chat_history)
    assert isinstance(response, str)
    assert "final response text" in response

    # Call stream method, should yield chunks with text attribute
    chunks = list(model.stream(chat_history))
    assert len(chunks) > 0
    for chunk in chunks:
        assert hasattr(chunk, "text")
        assert isinstance(chunk.text, str)

# Run all tests if executed as main
if __name__ == "__main__":
    pytest.main([__file__])[0m
