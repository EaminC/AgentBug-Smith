import importlib.util
import pytest

import mle.model
import mle.utils
import mle.function


def test_load_model_with_gemini_platform(monkeypatch):
    # Patch importlib.util.find_spec and importlib.import_module to simulate gemini installed
    def fake_find_spec(name):
        if name == "google.generativeai":
            return True
        return None

    monkeypatch.setattr(importlib.util, "find_spec", fake_find_spec)

    class DummyGemini:
        def configure(self, api_key):
            self.api_key = api_key

    def fake_import_module(name):
        if name == "google.generativeai":
            return DummyGemini()
        return importlib.import_module(name)

    monkeypatch.setattr(importlib, "import_module", fake_import_module)

    # Patch get_config to return Gemini platform config
    def fake_get_config(project_dir):
        return {
            "platform": "Gemini",
            "api_key": "dummy_api_key",
            "model": "gemini-1.5-flash",
        }

    monkeypatch.setattr(mle.utils, "get_config", fake_get_config)

    # Now test load_model returns GeminiModel instance
    model = mle.model.load_model("some_project_dir")
    # The model should be an instance of the GeminiModel class
    # Import GeminiModel here for isinstance check
    from mle.model.gemini import GeminiModel
    assert isinstance(model, GeminiModel)
    assert model.api_key == "dummy_api_key"
    assert model.model == "gemini-1.5-flash"


