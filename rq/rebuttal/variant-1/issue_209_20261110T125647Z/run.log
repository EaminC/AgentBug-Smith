@pytest.mark.asyncio
async def test_workflow_completion_callback_invoked():
    # This flag and container for result will be set by the callback
    callback_called = False
    callback_result = None

    def on_workflow_complete(result: str) -> None:
        nonlocal callback_called, callback_result
        callback_called = True
        callback_result = result

    # We test all three orchestrators that invoke the callback on completion
    # We pass the callback to the constructor and run a dummy workflow that completes immediately

    # Helper coroutine to run orchestrator.run and verify callback invocation
    async def run_and_check_callback(orchestrator):
        # Run the orchestrator's run method with a minimal dummy workflow name and empty input
        # The run method is async and returns the final summary/result string
        result = await orchestrator.run("dummy_workflow", {})

        # The callback should have been called exactly once with the same result string
        assert callback_called is True, "Callback was not called"
        assert callback_result == result, "Callback result does not match run result"
        assert isinstance(result, str) and len(result) > 0, "Run result should be a non-empty string"

    # Instantiate LLMOrchestrator with the callback
    llm_orch = LLMOrchestrator(
        name="test-llm",
        pubsub=None,
        execution=None,
        final_summary_callback=on_workflow_complete,
    )
    # Reset flags before run
    callback_called = False
    callback_result = None
    await run_and_check_callback(llm_orch)

    # Instantiate RandomOrchestrator with the callback
    random_orch = RandomOrchestrator(
        name="test-random",
        pubsub=None,
        execution=None,
        final_summary_callback=on_workflow_complete,
    )
    callback_called = False
    callback_result = None
    await run_and_check_callback(random_orch)

    # Instantiate RoundRobinOrchestrator with the callback
    roundrobin_orch = RoundRobinOrchestrator(
        name="test-roundrobin",
        pubsub=None,
        execution=None,
        final_summary_callback=on_workflow_complete,
    )
    callback_called = False
    callback_result = None
    await run_and_check_callback(roundrobin_orch)[0m
