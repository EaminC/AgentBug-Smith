import pytest

from dapr_agents.agents.orchestrators.llm.orchestrator import LLMOrchestrator
from dapr_agents.agents.orchestrators.random import RandomOrchestrator
from dapr_agents.agents.orchestrators.roundrobin import RoundRobinOrchestrator


@pytest.mark.asyncio
async def test_workflow_completion_callback_invoked():
    """
    This test verifies that the onWorkflowCompletion callback is invoked with the final
    workflow summary when running an orchestrator instance.

    Fail2pass criteria:
    - Before the patch, the callback is not invoked, so the test fails.
    - After the patch, the callback is invoked with the correct summary, so the test passes.
    """

    # Container for the callback result
    callback_result = {}

    def on_workflow_completion(summary: str) -> None:
        callback_result["summary"] = summary

    # Test with LLMOrchestrator
    orchestrator = LLMOrchestrator(final_summary_callback=on_workflow_completion)

    # Run a simple workflow that returns a known final summary
    # We simulate a minimal workflow by patching or invoking run with a simple task
    # For the test, we just call run with a prompt that yields a known final summary
    final_summary = await orchestrator.run("Test prompt for callback")

    # The callback should have been called with the same final summary
    assert "summary" in callback_result, "Callback was not invoked"
    assert callback_result["summary"] == final_summary, "Callback summary mismatch"

    # Test with RandomOrchestrator
    callback_result.clear()
    random_orchestrator = RandomOrchestrator(final_summary_callback=on_workflow_completion)
    final_output = await random_orchestrator.run("random test input")
    assert "summary" in callback_result, "Callback was not invoked for RandomOrchestrator"
    assert callback_result["summary"] == final_output, "Callback summary mismatch for RandomOrchestrator"

    # Test with RoundRobinOrchestrator
    callback_result.clear()
    roundrobin_orchestrator = RoundRobinOrchestrator(final_summary_callback=on_workflow_completion)
    final_output_rr = await roundrobin_orchestrator.run("roundrobin test input")
    assert "summary" in callback_result, "Callback was not invoked for RoundRobinOrchestrator"
    assert callback_result["summary"] == final_output_rr, "Callback summary mismatch for RoundRobinOrchestrator"[0m
