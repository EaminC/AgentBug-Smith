    async def simple_roundrobin_workflow():
        return "final-summary-roundrobin"

    # LLMOrchestrator test
    orchestrator_llm = LLMOrchestrator(
        name="test-orchestrator-llm",
        final_summary_callback=on_workflow_completion,
    )
    # Patch the _run_workflow method to simulate immediate completion with known result
    orchestrator_llm._run_workflow = lambda *args, **kwargs: simple_llm_workflow()

