from dapr_agents.agents.orchestrators.llm.orchestrator import LLMOrchestrator


def test_workflow_completion_callback_invoked():
    # This test verifies that the onWorkflowCompletion callback is invoked with the final summary
    # when running a workflow using LLMOrchestrator.

    # Container for callback result
    callback_results = []

    def on_workflow_complete(summary: str) -> None:
        callback_results.append(summary)

    # Create orchestrator with the final_summary_callback set
    orchestrator = LLMOrchestrator(
        name="test-orchestrator",
        final_summary_callback=on_workflow_complete,
    )

    # We simulate a workflow run by calling the internal method that triggers the callback.
    # Since the real run method requires complex setup and external dependencies,
    # we directly call the callback invoker to test the callback mechanism.
    test_summary = "final workflow summary"

    # Call the protected method that should invoke the callback
    orchestrator._invoke_final_summary_callback(test_summary)

    # Assert that the callback was called with the correct summary
    assert len(callback_results) == 1
    assert callback_results[0] == test_summary[0m
