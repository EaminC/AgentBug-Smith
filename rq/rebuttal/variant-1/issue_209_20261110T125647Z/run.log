from dapr_agents.agents.orchestrators.random import RandomOrchestrator
from dapr_agents.agents.orchestrators.roundrobin import RoundRobinOrchestrator


def test_workflow_completion_callback_invoked():
    """
    Test that the onWorkflowCompletion callback is invoked with the final workflow result.

    This test creates an LLMOrchestrator with a callback that stores the final summary.
    It runs a simple workflow that completes immediately with a known result.
    The test asserts that the callback was called and received the expected result.

    Fail2pass criteria:
    - On the buggy codebase, the callback is not invoked, so the test fails.
    - After the fix, the callback is invoked, and the test passes.
    """

    callback_called = threading.Event()
    callback_result = {}

    def on_workflow_completion(summary: str) -> None:
        callback_result["summary"] = summary
        callback_called.set()

    # Create orchestrator with the callback
    # We test LLMOrchestrator, RandomOrchestrator, and RoundRobinOrchestrator
    # to cover all patched orchestrators.

    # LLMOrchestrator test
    orchestrator_llm = LLMOrchestrator(
        name="test-orchestrator-llm",
        final_summary_callback=on_workflow_completion,
    )

    # We simulate a workflow run that returns a known final summary.
    # Since the actual workflow run is complex and depends on external systems,
    # we directly invoke the internal callback method to simulate completion.
    test_summary_llm = "LLM workflow final summary"
    orchestrator_llm._invoke_final_summary_callback(test_summary_llm)

    # Wait for callback to be called
    assert callback_called.wait(timeout=2), "Callback was not called for LLMOrchestrator"
    assert callback_result["summary"] == test_summary_llm

    # Reset for next test
    callback_called.clear()
    callback_result.clear()

    # RandomOrchestrator test
    orchestrator_random = RandomOrchestrator(
        name="test-orchestrator-random",
        final_summary_callback=on_workflow_completion,
    )
    test_summary_random = "Random workflow final output"
    orchestrator_random._invoke_final_summary_callback(test_summary_random)

    assert callback_called.wait(timeout=2), "Callback was not called for RandomOrchestrator"
    assert callback_result["summary"] == test_summary_random

    callback_called.clear()
    callback_result.clear()

    # RoundRobinOrchestrator test
    orchestrator_rr = RoundRobinOrchestrator(
        name="test-orchestrator-rr",
        final_summary_callback=on_workflow_completion,
    )
    test_summary_rr = "RoundRobin workflow final output"
    orchestrator_rr._invoke_final_summary_callback(test_summary_rr)

    assert callback_called.wait(timeout=2), "Callback was not called for RoundRobinOrchestrator"
    assert callback_result["summary"] == test_summary_rr[0m
