[32mimport asyncio
import pytest

from dapr_agents.agents.orchestrators.llm.orchestrator import LLMOrchestrator


@pytest.mark.asyncio
async def test_workflow_completion_callback_invoked():
    # This test verifies that the onWorkflowCompletion callback is invoked
    # with the final workflow summary when the workflow completes.

    callback_called = asyncio.Event()
    callback_result = {}

    def on_workflow_completion(summary: str) -> None:
        callback_result["summary"] = summary
        callback_called.set()

    # Create an LLMOrchestrator with the final_summary_callback set
    orchestrator = LLMOrchestrator(
        name="test-orchestrator",
        final_summary_callback=on_workflow_completion,
    )

    # Run a simple workflow that completes successfully.
    # We use a minimal workflow ID and input; the orchestrator should produce a final summary.
    # The actual workflow logic is internal; we just check callback invocation.
    workflow_id = "test-workflow-callback"
    input_data = {"input": "test"}

    # Run the orchestrator workflow asynchronously
    final_summary = await orchestrator.run(workflow_id=workflow_id, input=input_data)

    # Wait for the callback to be called (with timeout)
    await asyncio.wait_for(callback_called.wait(), timeout=5)

    # Assert that the callback was called with the same summary as returned by run()
    assert "summary" in callback_result, "Callback was not called"
    assert callback_result["summary"] == final_summary, "Callback summary mismatch"

    # Also assert that the final summary is a non-empty string
    assert isinstance(final_summary, str)
    assert len(final_summary) > 0[0m
