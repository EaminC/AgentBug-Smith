[32mimport threading
import time

import pytest

from dapr_agents.agents.orchestrators.llm.orchestrator import LLMOrchestrator


def test_workflow_completion_callback_invoked():
    """
    This test verifies that the onWorkflowCompletion callback is invoked with the final
    workflow summary when running an LLMOrchestrator instance.

    Fail2pass criteria:
    - Before the patch, the callback is not invoked, so the test fails.
    - After the patch, the callback is invoked with the correct summary, so the test passes.
    """

    # Container for the callback result
    callback_result = {}

    def on_workflow_completion(summary: str) -> None:
        callback_result["summary"] = summary

    # Create an orchestrator instance with the final_summary_callback set
    orchestrator = LLMOrchestrator(final_summary_callback=on_workflow_completion)

    # Run the orchestrator workflow.
    # We simulate a short run by calling run with a simple prompt.
    # The run method is synchronous, so it will complete before we check the callback.
    prompt = "Hello, test workflow completion callback."
    final_summary = orchestrator.run(prompt)

    # Allow a short time for callback to be invoked (in case async or threaded)
    time.sleep(0.1)

    # Assert that the callback was called with the final summary
    assert "summary" in callback_result, "Callback was not invoked"
    assert callback_result["summary"] == final_summary, "Callback summary does not match final summary"

    # Also assert that the final summary is a non-empty string
    assert isinstance(final_summary, str)
    assert len(final_summary) > 0


# Run the test if executed as a script
if __name__ == "__main__":
    pytest.main([__file__])[0m
