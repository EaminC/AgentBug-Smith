import pytest

from dapr_agents.agents.orchestrators.llm.orchestrator import LLMOrchestrator
from dapr_agents.agents.orchestrators.random import RandomOrchestrator
from dapr_agents.agents.orchestrators.roundrobin import RoundRobinOrchestrator


@pytest.mark.asyncio
async def test_workflow_completion_callback_invoked():
    # This test verifies that the onWorkflowCompletion callback is invoked with the final summary
    # when running a workflow using LLMOrchestrator, RandomOrchestrator, and RoundRobinOrchestrator.

    # Container for callback results
    callback_results = []

    def on_workflow_complete(summary: str) -> None:
        callback_results.append(summary)

    # Create orchestrators with the final_summary_callback set
    llm_orchestrator = LLMOrchestrator(
        name="test-llm-orchestrator",
        final_summary_callback=on_workflow_complete,
    )
    random_orchestrator = RandomOrchestrator(
        name="test-random-orchestrator",
        final_summary_callback=on_workflow_complete,
    )
    roundrobin_orchestrator = RoundRobinOrchestrator(
        name="test-roundrobin-orchestrator",
        final_summary_callback=on_workflow_complete,
    )

    # Define a simple dummy workflow runner for each orchestrator that returns a fixed string
    async def dummy_run(orchestrator):
        # Simulate a workflow run that returns a final summary string
        # We call the internal _invoke_final_summary_callback manually to simulate completion
        final_summary = "workflow completed successfully"
        # Normally, the orchestrator.run would call this internally, but we simulate here
        orchestrator._invoke_final_summary_callback(final_summary)
        return final_summary

    # Run dummy workflows
    llm_result = await dummy_run(llm_orchestrator)
    random_result = await dummy_run(random_orchestrator)
    roundrobin_result = await dummy_run(roundrobin_orchestrator)

    # Check that the callback was called with the expected final summary for each orchestrator
    expected_summary = "workflow completed successfully"
    assert llm_result == expected_summary
    assert random_result == expected_summary
    assert roundrobin_result == expected_summary

    # The callback_results list should contain three entries, one for each orchestrator
    assert len(callback_results) == 3
    assert all(summary == expected_summary for summary in callback_results)[0m
