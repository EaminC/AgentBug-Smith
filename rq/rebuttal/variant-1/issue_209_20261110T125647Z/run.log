[32mimport threading
import time

import pytest

from dapr_agents.agents.orchestrators.llm.orchestrator import LLMOrchestrator


def test_workflow_completion_callback_invoked():
    """
    Test that the onWorkflowCompletion callback is invoked with the final workflow result.

    This test creates an LLMOrchestrator with a callback that stores the final summary.
    It runs a simple workflow that completes immediately with a known result.
    The test asserts that the callback was called and received the expected result.

    Fail2pass criteria:
    - On the buggy codebase, the callback is not invoked, so the test fails.
    - After the fix, the callback is invoked, and the test passes.
    """

    callback_called = threading.Event()
    callback_result = {}

    def on_workflow_completion(summary: str) -> None:
        callback_result["summary"] = summary
        callback_called.set()

    # Create orchestrator with the callback
    orchestrator = LLMOrchestrator(
        name="test-orchestrator",
        final_summary_callback=on_workflow_completion,
    )

    # Define a minimal workflow that returns a fixed final summary
    # We simulate the workflow by patching _run_workflow method to return a known string
    # but since we must not mock the orchestrator method itself, we will run the real run method
    # with a simple prompt that leads to immediate completion.
    # The orchestrator run method is async, so we run it synchronously with asyncio.

    import asyncio

    async def run_workflow():
        # Use a prompt that leads to immediate final summary
        prompt = "Say hello"
        result = await orchestrator.run(prompt)
        return result

    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    final_result = loop.run_until_complete(run_workflow())
    loop.close()

    # Wait briefly for callback to be called (should be immediate)
    callback_called.wait(timeout=5)

    # Assert callback was called
    assert callback_called.is_set(), "Workflow completion callback was not called"

    # Assert callback received the final result
    assert "summary" in callback_result, "Callback did not receive summary"
    assert callback_result["summary"] == final_result, "Callback summary does not match final result"

    # Assert final_result is a non-empty string
    assert isinstance(final_result, str)
    assert len(final_result) > 0[0m
