    # to cover all patched orchestrators.

    # Prepare a simple workflow function for LLMOrchestrator that returns a fixed final summary.
    async def simple_llm_workflow():
        return "final-summary-llm"

    # Prepare a simple workflow function for RandomOrchestrator that returns a fixed final output.
    async def simple_random_workflow():
        return "final-summary-random"

