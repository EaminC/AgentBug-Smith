# Use official Python 3.12 slim image as base
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter3/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter3/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter3/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Copy entire project to container
COPY . .

# Install system dependencies needed for building some Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies based on presence of lockfiles or requirements
RUN if [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
      pip install poetry && poetry config virtualenvs.create false && poetry install --no-interaction --no-ansi; \
    elif [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt; \
    else \
      echo "No lockfile or requirements.txt found, skipping dependency installation."; \
    fi

# Install the repository itself in editable mode
RUN pip install -e .

# Install required test packages explicitly except removing unavailable pytest-block-network
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout "setuptools<=81.0.0" litellm mem0ai vcrpy json_repair chromadb syrupy respx langgraph-checkpoint-sqlite aiosqlite langgraph-checkpoint-postgres "psycopg[binary,pool]" redis apscheduler fastapi fakeredis mcp "ray[default]" boto3 agno pydantic-ai fastmcp

# Preflight check for pytest and pkg_resources
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set PYTHONPATH based on src directory presence
RUN if [ -d "src" ]; then echo "src directory detected, setting PYTHONPATH"; fi
ENV PYTHONPATH=/app:/app/src

# Default command to run bash shell for tests
CMD ["/bin/bash"]

# branch: python/pyproject.toml-or-requirements.txt

