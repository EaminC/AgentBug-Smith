import os
import tempfile
import shutil
import pytest
from click.testing import CliRunner
from mle.cli import memory
from mle.utils.memory import LanceDBMemory


def create_sample_py_file(dir_path, filename, content):
    file_path = os.path.join(dir_path, filename)
    with open(file_path, "w", encoding="utf-8") as f:
        f.write(content)
    return file_path


@pytest.fixture
def temp_working_dir():
    # Create a temporary directory for testing
    temp_dir = tempfile.mkdtemp()
    old_cwd = os.getcwd()
    os.chdir(temp_dir)
    try:
        yield temp_dir
    finally:
        os.chdir(old_cwd)
        shutil.rmtree(temp_dir)


def test_memory_add_rm_update_commands(temp_working_dir):
    runner = CliRunner()

    # Create sample python files
    file1 = create_sample_py_file(temp_working_dir, "test1.py", "print('hello world')\n")
    file2 = create_sample_py_file(temp_working_dir, "test2.py", "def foo():\n    return 42\n")

    memory_obj = LanceDBMemory(temp_working_dir)
    table_name = "mle_chat_" + temp_working_dir.split(os.sep)[-1]

    # Initially, memory should have no keys
    assert memory_obj.list_all_keys(table_name) == []

    # Add file1
    result_add = runner.invoke(memory, ["--add", file1])
    assert result_add.exit_code == 0
    keys_after_add = memory_obj.list_all_keys(table_name)
    assert len(keys_after_add) > 0

    # Add file2
    result_add2 = runner.invoke(memory, ["--add", file2])
    assert result_add2.exit_code == 0
    keys_after_add2 = memory_obj.list_all_keys(table_name)
    assert len(keys_after_add2) > len(keys_after_add)

    # Remove file1
    result_rm = runner.invoke(memory, ["--rm", file1])
    assert result_rm.exit_code == 0
    keys_after_rm = memory_obj.list_all_keys(table_name)
    # keys after removal should be less or equal than before
    assert len(keys_after_rm) <= len(keys_after_add2)

    # Update file2 (should remove old chunks and add new ones)
    result_update = runner.invoke(memory, ["--update", file2])
    assert result_update.exit_code == 0
    keys_after_update = memory_obj.list_all_keys(table_name)
