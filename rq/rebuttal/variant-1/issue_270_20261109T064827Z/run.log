import os
import tempfile
import shutil
import pytest
from click.testing import CliRunner
from mle import cli
from mle.utils.memory import LanceDBMemory


def test_memory_add_rm_update(tmp_path):
    # Setup: create a temporary Python file to add to memory
    test_file = tmp_path / "test_script.py"
    test_code = "def foo():\n    return 42\n"
    test_file.write_text(test_code)

    runner = CliRunner()

    # Use the CLI to add the file to memory
    result_add = runner.invoke(cli.memory, ['--add', str(test_file)])
    assert result_add.exit_code == 0

    # Verify memory contains the added file chunks
    memory = LanceDBMemory(str(tmp_path))
    table_name = 'mle_chat_' + str(tmp_path).split(os.sep)[-1]
    keys = memory.list_all_keys(table_name=table_name)
    assert len(keys) > 0

    # Use the CLI to update the file in memory (should remove old chunks and add new ones)
    result_update = runner.invoke(cli.memory, ['--update', str(test_file)])
    assert result_update.exit_code == 0

    # After update, keys should still exist (chunks replaced)
    keys_after_update = memory.list_all_keys(table_name=table_name)
    assert len(keys_after_update) > 0

    # Use the CLI to remove the file from memory
    result_rm = runner.invoke(cli.memory, ['--rm', str(test_file)])
    assert result_rm.exit_code == 0

    # After removal, keys related to the file should be gone
    keys_after_rm = memory.list_all_keys(table_name=table_name)
    # The keys should be empty or none related to the file
    assert keys_after_rm == [] or all(not k.startswith(str(test_file)) for k in keys_after_rm)


def test_memory_rm_nonexistent_file(tmp_path):
    # Attempt to remove a file that was never added
    fake_file = tmp_path / "nonexistent.py"
    runner = CliRunner()
    result_rm = runner.invoke(cli.memory, ['--rm', str(fake_file)])
    assert result_rm.exit_code == 0
    # Should not raise error and memory should remain empty
    memory = LanceDBMemory(str(tmp_path))
    table_name = 'mle_chat_' + str(tmp_path).split(os.sep)[-1]
    keys = memory.list_all_keys(table_name=table_name)
    assert keys == []


def test_memory_add_directory(tmp_path):
    # Create multiple Python files in a directory
    dir_path = tmp_path / "src"
    dir_path.mkdir()
    file1 = dir_path / "a.py"
    file2 = dir_path / "b.py"
    file1.write_text("print('a')")
    file2.write_text("print('b')")

    runner = CliRunner()
    # Add directory, should add both files
    result_add = runner.invoke(cli.memory, ['--add', str(dir_path)])
    assert result_add.exit_code == 0

    memory = LanceDBMemory(str(tmp_path))
    table_name = 'mle_chat_' + str(tmp_path).split(os.sep)[-1]
    keys = memory.list_all_keys(table_name=table_name)
    assert len(keys) > 0

    # Remove directory, should remove all chunks from both files
    result_rm = runner.invoke(cli.memory, ['--rm', str(dir_path)])
    assert result_rm.exit_code == 0
    keys_after_rm = memory.list_all_keys(table_name=table_name)
    assert keys_after_rm == []


def test_memory_no_option():
    runner = CliRunner()
    # Invoke memory command with no options should do nothing but exit 0
    result = runner.invoke(cli.memory, [])
    assert result.exit_code == 0
    assert result.output == "" or result.output is None

# The tests above rely on the fixed code where memory commands properly add, remove, update chunks.
# On the buggy codebase, these tests should fail due to missing or incorrect memory CRUD behavior.
# After applying the patch, these tests should pass with exit code 0.
