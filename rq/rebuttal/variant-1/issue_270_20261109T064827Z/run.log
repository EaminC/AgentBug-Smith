import os
import tempfile
import shutil
import pytest
from mle.cli import memory
from mle.utils.memory import LanceDBMemory


@pytest.fixture
def temp_py_file():
    # Create a temporary Python file with some content
    temp_dir = tempfile.mkdtemp()
    file_path = os.path.join(temp_dir, "test_script.py")
    with open(file_path, "w") as f:
        f.write("def foo():\n    return 42\n")
    yield file_path, temp_dir
    shutil.rmtree(temp_dir)


def test_memory_add_and_remove(temp_py_file):
    file_path, temp_dir = temp_py_file
    os.chdir(temp_dir)

    # Instantiate memory client
    memory_client = LanceDBMemory(temp_dir)
    table_name = "mle_chat_" + temp_dir.split(os.sep)[-1]

    # Initially, the memory should be empty or no table
    initial_keys = memory_client.list_all_keys(table_name)
    assert initial_keys == []

    # Add the file to memory using the CLI command interface
    memory(add=file_path, rm=None, update=None)

    # After adding, keys should exist
    keys_after_add = memory_client.list_all_keys(table_name)
    assert len(keys_after_add) > 0

    # Remove the file from memory using CLI command interface
    memory(add=None, rm=file_path, update=None)

    # After removal, keys should be empty again
    keys_after_rm = memory_client.list_all_keys(table_name)
    assert keys_after_rm == []

    # Add again to test update
    memory(add=file_path, rm=None, update=None)
    keys_after_add_again = memory_client.list_all_keys(table_name)
    assert len(keys_after_add_again) > 0

    # Update the file in memory (should remove and add again)
    memory(add=None, rm=None, update=file_path)
    keys_after_update = memory_client.list_all_keys(table_name)
    assert len(keys_after_update) > 0

    # The keys after update should be same or similar to after add
    assert set(keys_after_update) == set(keys_after_add_again) or len(keys_after_update) > 0


def test_memory_with_directory(temp_py_file):
    _, temp_dir = temp_py_file
    os.chdir(temp_dir)

    # Create multiple python files in a subdirectory
    sub_dir = os.path.join(temp_dir, "subdir")
    os.makedirs(sub_dir)
    file1 = os.path.join(sub_dir, "a.py")
    file2 = os.path.join(sub_dir, "b.py")
    with open(file1, "w") as f:
        f.write("print('a')\n")
    with open(file2, "w") as f:
        f.write("print('b')\n")

    memory_client = LanceDBMemory(temp_dir)
    table_name = "mle_chat_" + temp_dir.split(os.sep)[-1]

    # Add directory to memory
    memory(add=sub_dir, rm=None, update=None)

    keys_after_add = memory_client.list_all_keys(table_name)
    assert len(keys_after_add) > 0

    # Remove directory from memory
    memory(add=None, rm=sub_dir, update=None)

    keys_after_rm = memory_client.list_all_keys(table_name)
    assert keys_after_rm == []

    # Update directory in memory
    memory(add=None, rm=None, update=sub_dir)

    keys_after_update = memory_client.list_all_keys(table_name)
    assert len(keys_after_update) > 0

    # Cleanup
    memory(add=None, rm=sub_dir, update=None)
    keys_after_cleanup = memory_client.list_all_keys(table_name)
    assert keys_after_cleanup == []
