import os
import tempfile
import shutil
import pytest
from mle.utils.memory import LanceDBMemory
from mle.cli import memory as cli_memory
from click.testing import CliRunner


def create_temp_py_file(dir_path, filename, content):
    path = os.path.join(dir_path, filename)
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)
    return path


def test_memory_add_rm_update(tmp_path):
    """
    Test the `mle memory` CLI commands --add, --rm, and --update
    on a temporary Python file, verifying that memory entries
    are correctly added, removed, and updated.
    """

    # Prepare a temporary directory with a Python file
    py_content_v1 = "def foo():\n    return 42\n"
    py_content_v2 = "def foo():\n    return 43\n"

    file_path = create_temp_py_file(tmp_path, "testfile.py", py_content_v1)

    # Change working directory to tmp_path to match CLI expectations
    old_cwd = os.getcwd()
    os.chdir(tmp_path)

    runner = CliRunner()

    # Compose the table name as per CLI logic
    table_name = "mle_chat_" + os.getcwd().split("/")[-1]

    # Instantiate LanceDBMemory for direct checks
    memory = LanceDBMemory(os.getcwd())

    try:
        # 1) Add the file to memory
        result_add = runner.invoke(cli_memory, ["--add", file_path])
        assert result_add.exit_code == 0

        # After add, memory should contain chunks for the file
        keys_after_add = memory.list_all_keys(table_name)
        assert len(keys_after_add) > 0

        # The metadata for the file should be present
        records = memory.get_by_metadata("file", file_path, table_name)
        assert len(records) > 0
        # The text chunks should include the function definition
        assert any("def foo" in r.get("text", "") for r in records)

        # 2) Update the file: change content and update memory
        with open(file_path, "w", encoding="utf-8") as f:
            f.write(py_content_v2)

        result_update = runner.invoke(cli_memory, ["--update", file_path])
        assert result_update.exit_code == 0

        # After update, memory should reflect new content
        records_after_update = memory.get_by_metadata("file", file_path, table_name)
        assert len(records_after_update) > 0
        # The updated content should be present
        assert any("return 43" in r.get("text", "") for r in records_after_update)

        # 3) Remove the file from memory
        result_rm = runner.invoke(cli_memory, ["--rm", file_path])
        assert result_rm.exit_code == 0

        # After removal, no records should remain for the file
        records_after_rm = memory.get_by_metadata("file", file_path, table_name)
        assert len(records_after_rm) == 0

    finally:
        os.chdir(old_cwd)
