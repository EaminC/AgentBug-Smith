import os
import tempfile
import shutil
from pathlib import Path
from click.testing import CliRunner
from mle.cli import memory


def test_memory_add_rm_update(tmp_path):
    # Prepare a temporary Python file to add to memory
    test_file = tmp_path / "test_file.py"
    test_file.write_text("print('hello world')\n" * 10)

    runner = CliRunner()

    # Run memory add command
    result_add = runner.invoke(memory, ['--add', str(test_file)])
    assert result_add.exit_code == 0, f"Add command failed: {result_add.output}"

    # Run memory rm command
    result_rm = runner.invoke(memory, ['--rm', str(test_file)])
    assert result_rm.exit_code == 0, f"Remove command failed: {result_rm.output}"

    # Write updated content to file
    test_file.write_text("print('updated content')\n" * 5)

    # Run memory update command
    result_update = runner.invoke(memory, ['--update', str(test_file)])
    assert result_update.exit_code == 0, f"Update command failed: {result_update.output}"

    # Run memory rm command again to clean up
    result_rm2 = runner.invoke(memory, ['--rm', str(test_file)])
    assert result_rm2.exit_code == 0, f"Remove command failed: {result_rm2.output}"
