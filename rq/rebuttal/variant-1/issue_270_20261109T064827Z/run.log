import os
import tempfile
import shutil
import pytest
from mle.utils.memory import LanceDBMemory
from mle.cli import memory as cli_memory
import click
from click.testing import CliRunner


@pytest.fixture
def temp_py_file():
    # Create a temporary directory and a Python file inside it
    temp_dir = tempfile.mkdtemp()
    file_path = os.path.join(temp_dir, "test_file.py")
    with open(file_path, "w") as f:
        f.write(
            "def foo():\n"
            "    return 'bar'\n"
            "\n"
            "print(foo())\n"
        )
    yield file_path, temp_dir
    shutil.rmtree(temp_dir)


def test_memory_add_rm_update(temp_py_file):
    file_path, temp_dir = temp_py_file
    runner = CliRunner()

    # Use the temp_dir as cwd for the CLI commands
    # Add the file to memory
    result_add = runner.invoke(
        cli_memory,
        ["--add", file_path],
        obj={},
        standalone_mode=False,
        catch_exceptions=False,
        env={"PWD": temp_dir},
    )
    assert result_add.exit_code == 0

    # Check that memory contains entries for the file
    memory = LanceDBMemory(temp_dir)
    table_name = "mle_chat_" + temp_dir.split(os.sep)[-1]
    keys = memory.list_all_keys(table_name)
    assert len(keys) > 0

    # Remove the file from memory
    result_rm = runner.invoke(
        cli_memory,
        ["--rm", file_path],
        obj={},
        standalone_mode=False,
        catch_exceptions=False,
        env={"PWD": temp_dir},
    )
    assert result_rm.exit_code == 0

    # After removal, keys should be empty or memory empty
    keys_after_rm = memory.list_all_keys(table_name)
    assert len(keys_after_rm) == 0

    # Update the file (should add it again)
    result_update = runner.invoke(
        cli_memory,
        ["--update", file_path],
        obj={},
        standalone_mode=False,
        catch_exceptions=False,
        env={"PWD": temp_dir},
    )
    assert result_update.exit_code == 0

    keys_after_update = memory.list_all_keys(table_name)
    assert len(keys_after_update) > 0

    # Clean up by removing again
    memory.delete_by_metadata("file", file_path, table_name=table_name)
    keys_final = memory.list_all_keys(table_name)
    assert len(keys_final) == 0
