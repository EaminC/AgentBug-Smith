import os
import tempfile
import shutil
import pytest
from click.testing import CliRunner
from mle.cli import memory
from mle.utils.memory import LanceDBMemory


def create_temp_py_file(dir_path, filename, content):
    path = os.path.join(dir_path, filename)
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)
    return path


@pytest.fixture
def temp_dir_with_py_files():
    temp_dir = tempfile.mkdtemp()
    try:
        # Create two python files with simple content
        file1 = create_temp_py_file(temp_dir, "file1.py", "print('hello world')\n")
        file2 = create_temp_py_file(temp_dir, "file2.py", "def foo():\n    return 42\n")
        yield temp_dir, [file1, file2]
    finally:
        shutil.rmtree(temp_dir)


def test_memory_add_rm_update(temp_dir_with_py_files):
    temp_dir, files = temp_dir_with_py_files
    runner = CliRunner()

    # Use the directory path for --add option to add all .py files
    result_add = runner.invoke(memory, ["--add", temp_dir])
    assert result_add.exit_code == 0, f"Add command failed: {result_add.output}"

    # Verify that the memory contains entries for these files
    memory_instance = LanceDBMemory(os.getcwd())
    table_name = "mle_chat_" + os.getcwd().split(os.sep)[-1]

    # Check that keys exist for all files added
    keys = memory_instance.list_all_keys(table_name)
    assert keys, "No keys found after adding files."

    # Check that metadata for each file exists in memory
    for file_path in files:
        records = memory_instance.get_by_metadata("file", file_path, table_name)
        assert records, f"No records found for file {file_path} after add."

    # Now test --rm option for one file
    result_rm = runner.invoke(memory, ["--rm", files[0]])
    assert result_rm.exit_code == 0, f"Remove command failed: {result_rm.output}"

    # The removed file's records should be gone
    records_after_rm = memory_instance.get_by_metadata("file", files[0], table_name)
    assert not records_after_rm, f"Records still found for removed file {files[0]}"

    # The other file's records should still exist
    records_other = memory_instance.get_by_metadata("file", files[1], table_name)
    assert records_other, f"Records missing for file {files[1]} after removing other file"

    # Modify the second file content
    with open(files[1], "w", encoding="utf-8") as f:
        f.write("def foo():\n    return 100\n")

    # Test --update option for the second file
    result_update = runner.invoke(memory, ["--update", files[1]])
    assert result_update.exit_code == 0, f"Update command failed: {result_update.output}"

    # After update, records should exist and reflect new content (at least still present)
    records_after_update = memory_instance.get_by_metadata("file", files[1], table_name)
    assert records_after_update, f"No records found for file {files[1]} after update"

    # Clean up by removing the second file from memory
    runner.invoke(memory, ["--rm", files[1]])


def test_memory_no_path_option():
    runner = CliRunner()
    # Calling memory command without any option should do nothing and exit 0
    result = runner.invoke(memory, [])
    assert result.exit_code == 0
    assert result.output == "" or result.output is None


def test_memory_with_nonexistent_path():
    runner = CliRunner()
    fake_path = "/path/does/not/exist.py"
    result_add = runner.invoke(memory, ["--add", fake_path])
    # Should not raise but may exit 0 or 1 depending on implementation; we expect exit 0 but no records
    assert result_add.exit_code == 0 or result_add.exit_code == 1

    memory_instance = LanceDBMemory(os.getcwd())
    table_name = "mle_chat_" + os.getcwd().split(os.sep)[-1]
    records = memory_instance.get_by_metadata("file", fake_path, table_name)
    assert not records, "Records found for non-existent file path"


if __name__ == "__main__":
    pytest.main([__file__])
