import os
import tempfile
import shutil
import pytest
from click.testing import CliRunner
from mle.cli import memory
from mle.utils.memory import LanceDBMemory


@pytest.fixture
def temp_py_file():
    # Create a temporary directory and a python file inside it
    temp_dir = tempfile.mkdtemp()
    file_path = os.path.join(temp_dir, "testfile.py")
    with open(file_path, "w") as f:
        f.write("def foo():\n    return 'bar'\n")
    yield file_path, temp_dir
    shutil.rmtree(temp_dir)


def test_memory_add_rm_update(temp_py_file):
    file_path, temp_dir = temp_py_file
    runner = CliRunner()

    # Change working directory to temp_dir for the test
    old_cwd = os.getcwd()
    os.chdir(temp_dir)
    try:
        # Test adding the file to memory
        result_add = runner.invoke(memory, ["--add", file_path])
        assert result_add.exit_code == 0

        # Check that the memory contains entries for the added file
        memory_instance = LanceDBMemory(temp_dir)
        table_name = "mle_chat_" + temp_dir.split(os.sep)[-1]
        keys_after_add = memory_instance.list_all_keys(table_name)
        assert len(keys_after_add) > 0

        # Test removing the file from memory
        result_rm = runner.invoke(memory, ["--rm", file_path])
        assert result_rm.exit_code == 0

        # After removal, keys should be empty or no entries for the file
        keys_after_rm = memory_instance.list_all_keys(table_name)
        # The keys should be empty or none related to file_path
        # We cannot guarantee empty because other tests may run, but no keys with file_path metadata
        # So we check get_by_metadata returns empty
        records = memory_instance.get_by_metadata("file", file_path, table_name)
        assert records == []

        # Test updating the file in memory (should add it back)
        result_update = runner.invoke(memory, ["--update", file_path])
        assert result_update.exit_code == 0

        # After update, keys should exist again
        keys_after_update = memory_instance.list_all_keys(table_name)
        assert len(keys_after_update) > 0

        # Also verify that the metadata for the file exists
        records_after_update = memory_instance.get_by_metadata("file", file_path, table_name)
        assert len(records_after_update) > 0
        for rec in records_after_update:
            assert rec.get("metadata", {}).get("file") == file_path

    finally:
        os.chdir(old_cwd)
