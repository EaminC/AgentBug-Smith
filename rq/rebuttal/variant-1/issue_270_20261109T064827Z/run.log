def test_memory_add_rm_update(tmp_path):
    # Setup: create a temporary Python file with some content
    test_file = tmp_path / "test_script.py"
    test_file.write_text("print('hello world')\nprint('test')\n")

    # Instantiate LanceDBMemory with tmp_path as project path
    memory_instance = LanceDBMemory(str(tmp_path))

    # Use the CLI memory command to add the file
    # The CLI command expects to be called with parameters, so call the function directly
    memory(add=str(test_file), rm=None, update=None)

    # After adding, the memory table should contain entries for the file chunks
    # The table name is constructed as 'mle_chat_' + last directory name
    table_name = "mle_chat_" + str(tmp_path).split(os.sep)[-1]

    # Query all keys in the table, should not be empty after add
    keys_after_add = memory_instance.list_all_keys(table_name=table_name)
    assert len(keys_after_add) > 0, "Memory add did not store any chunks"

    # Now remove the file from memory using the CLI command
    memory(add=None, rm=str(test_file), update=None)

    # After removal, the keys should be empty or zero count
    keys_after_rm = memory_instance.list_all_keys(table_name=table_name)
    assert len(keys_after_rm) == 0, "Memory remove did not delete all chunks"

