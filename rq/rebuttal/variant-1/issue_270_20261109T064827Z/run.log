import os
import tempfile
import shutil
import pytest
from click.testing import CliRunner
from mle import cli
from mle.utils.memory import LanceDBMemory


@pytest.fixture
def temp_py_file():
    # Create a temporary directory and a python file inside it
    temp_dir = tempfile.mkdtemp()
    file_path = os.path.join(temp_dir, "test_file.py")
    with open(file_path, "w") as f:
        f.write(
            "def foo():\n"
            "    return 'bar'\n"
            "\n"
            "class Test:\n"
            "    pass\n"
        )
    yield temp_dir, file_path
    shutil.rmtree(temp_dir)


def test_memory_add_rm_update(temp_py_file):
    temp_dir, file_path = temp_py_file
    runner = CliRunner()

    # Use the CLI to add the file to memory
    result_add = runner.invoke(cli.memory, ["--add", file_path])
    assert result_add.exit_code == 0

    # Verify that memory has chunks related to the file
    memory = LanceDBMemory(temp_dir)
    table_name = 'mle_chat_' + temp_dir.split(os.sep)[-1]
    keys = memory.list_all_keys(table_name)
    assert len(keys) > 0, "Memory should contain chunks after adding file"

    # Use the CLI to remove the file from memory
    result_rm = runner.invoke(cli.memory, ["--rm", file_path])
    assert result_rm.exit_code == 0

    # Verify that memory no longer has chunks related to the file
    keys_after_rm = memory.list_all_keys(table_name)
    # The keys should be empty or no chunks related to the file remain
    # Because delete_by_metadata removes all chunks with metadata.file == file_path
    # So keys_after_rm should be empty or at least no chunk with that file metadata
    # We check by querying get_by_metadata
    chunks_after_rm = memory.get_by_metadata("file", file_path, table_name)
    assert len(chunks_after_rm) == 0, "Memory should have no chunks after removing file"

    # Use the CLI to update the file (should add it back)
    result_update = runner.invoke(cli.memory, ["--update", file_path])
    assert result_update.exit_code == 0

    # Verify that memory has chunks again after update
    chunks_after_update = memory.get_by_metadata("file", file_path, table_name)
    assert len(chunks_after_update) > 0, "Memory should contain chunks after updating file"


def test_memory_command_no_path():
    runner = CliRunner()
    # Calling memory command without any option should do nothing and exit 0
    result = runner.invoke(cli.memory, [])
    assert result.exit_code == 0
    assert result.output == ""


def test_memory_command_directory(temp_py_file):
    temp_dir, _ = temp_py_file
    runner = CliRunner()

    # Add the directory (should add all .py files inside)
    result_add_dir = runner.invoke(cli.memory, ["--add", temp_dir])
    assert result_add_dir.exit_code == 0

    memory = LanceDBMemory(temp_dir)
    table_name = 'mle_chat_' + temp_dir.split(os.sep)[-1]
    keys = memory.list_all_keys(table_name)
    assert len(keys) > 0, "Memory should contain chunks after adding directory"

    # Remove directory
    result_rm_dir = runner.invoke(cli.memory, ["--rm", temp_dir])
    assert result_rm_dir.exit_code == 0

    chunks_after_rm = memory.get_by_metadata("file", os.path.join(temp_dir, "test_file.py"), table_name)
    assert len(chunks_after_rm) == 0, "Memory should have no chunks after removing directory"


def test_memory_command_invalid_path():
    runner = CliRunner()
    # Use a non-existent path, should not crash, just do nothing
    fake_path = "/non/existent/path/for/memory_test.py"
    result = runner.invoke(cli.memory, ["--add", fake_path])
    # The command should exit 0 even if path does not exist (no exception)
    assert result.exit_code == 0


def test_memory_delete_nonexistent_table(temp_py_file):
    temp_dir, file_path = temp_py_file
    memory = LanceDBMemory(temp_dir)
    # Use a fake table name that does not exist
    fake_table = "nonexistent_table_for_test"
    # delete_by_metadata should return True even if table does not exist
    result = memory.delete_by_metadata("file", file_path, fake_table)
    assert result is True
    # delete by record id on nonexistent table should also return True
    result2 = memory.delete("fake_id", fake_table)
    assert result2 is True
    # drop on nonexistent table should return True
    result3 = memory.drop(fake_table)
    assert result3 is True
    # count on nonexistent table should return 0
    count = memory.count(fake_table)
    assert count == 0
    # get on nonexistent table should return empty list
    records = memory.get("fake_id", fake_table)
    assert records == []
    # get_by_metadata on nonexistent table should return empty list
    records2 = memory.get_by_metadata("file", file_path, fake_table)
    assert records2 == []
    # query on nonexistent table should return empty list
    results = memory.query(["test query"], fake_table)
    assert results == []
