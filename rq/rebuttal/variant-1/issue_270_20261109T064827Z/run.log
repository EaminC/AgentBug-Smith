import os
import tempfile
import shutil
import pytest
from click.testing import CliRunner
from mle.cli import memory
from mle.utils.memory import LanceDBMemory

@pytest.fixture
def temp_py_files():
    # Create a temporary directory with some Python files
    temp_dir = tempfile.mkdtemp()
    file1 = os.path.join(temp_dir, "file1.py")
    file2 = os.path.join(temp_dir, "file2.py")
    with open(file1, "w") as f:
        f.write("print('hello world')\n")
    with open(file2, "w") as f:
        f.write("def foo():\n    return 42\n")
    yield temp_dir, [file1, file2]
    shutil.rmtree(temp_dir)

def test_memory_add_rm_update(temp_py_files):
    temp_dir, files = temp_py_files
    runner = CliRunner()
    # Use the directory path to add files to memory
    result_add = runner.invoke(memory, ['--add', temp_dir])
    assert result_add.exit_code == 0

    # Check that the memory contains entries for these files
    mem = LanceDBMemory(os.getcwd())
    table_name = 'mle_chat_' + os.getcwd().split('/')[-1]

    # The keys should include the files added
    keys = mem.list_all_keys(table_name)
    assert keys, "Memory keys should not be empty after add"

    # Remove one file by path
    result_rm = runner.invoke(memory, ['--rm', files[0]])
    assert result_rm.exit_code == 0

    # After removal, keys related to the removed file should be gone
    # We check by metadata search for file key
    removed_records = mem.get_by_metadata('file', files[0], table_name)
    assert removed_records == [], "Removed file chunks should be deleted"

    # Update the other file (should remove old chunks and add new ones)
    result_update = runner.invoke(memory, ['--update', files[1]])
    assert result_update.exit_code == 0

    # After update, the file chunks should exist again
    updated_records = mem.get_by_metadata('file', files[1], table_name)
    assert updated_records, "Updated file chunks should exist"

    # Clean up by removing the other file
    runner.invoke(memory, ['--rm', files[1]])

def test_memory_no_path_option():
    # Invoking memory command with no options should do nothing and pass
    runner = CliRunner()
    result = runner.invoke(memory, [])
    assert result.exit_code == 0
    # No output expected
    assert result.output == ''

def test_memory_add_single_file(tmp_path):
    # Create a single python file
    file_path = tmp_path / "single.py"
    file_path.write_text("x = 1\n")

    runner = CliRunner()
    result = runner.invoke(memory, ['--add', str(file_path)])
    assert result.exit_code == 0

    mem = LanceDBMemory(os.getcwd())
    table_name = 'mle_chat_' + os.getcwd().split('/')[-1]
    records = mem.get_by_metadata('file', str(file_path), table_name)
    assert records, "Single added file should have chunks in memory"

    # Remove it
    result_rm = runner.invoke(memory, ['--rm', str(file_path)])
    assert result_rm.exit_code == 0
    records_after_rm = mem.get_by_metadata('file', str(file_path), table_name)
    assert records_after_rm == []

def test_memory_update_nonexistent_file(tmp_path):
    # Create a python file path but do not add it first
    file_path = tmp_path / "nonexistent.py"
    file_path.write_text("y = 2\n")

    runner = CliRunner()
    # Update should add it even if not present before
    result = runner.invoke(memory, ['--update', str(file_path)])
    assert result.exit_code == 0

    mem = LanceDBMemory(os.getcwd())
    table_name = 'mle_chat_' + os.getcwd().split('/')[-1]
    records = mem.get_by_metadata('file', str(file_path), table_name)
    assert records, "Update on new file should add chunks"

    # Clean up
    runner.invoke(memory, ['--rm', str(file_path)])
