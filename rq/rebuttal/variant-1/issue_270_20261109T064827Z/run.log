            f.write("# added comment\n")
        result_update = run_cli_memory_command(["--update", file2_path])
        assert result_update.returncode == 0, f"Update failed: {result_update.stderr}"

        # Check that file2.py chunks exist after update
        records_file2 = memory_obj.get_by_metadata("file", file2_path, table_name)
        assert len(records_file2) > 0, "file2.py chunks missing after update"

    finally:
        os.chdir(cwd)
