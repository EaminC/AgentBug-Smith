import os
import tempfile
import shutil
import pytest
from click.testing import CliRunner
from mle.cli import memory
from mle.utils.memory import LanceDBMemory

def create_temp_py_file(dir_path, filename, content):
    file_path = os.path.join(dir_path, filename)
    with open(file_path, "w", encoding="utf-8") as f:
        f.write(content)
    return file_path

@pytest.fixture
def temp_py_files():
    temp_dir = tempfile.mkdtemp()
    try:
        # Create two python files with simple content
        file1 = create_temp_py_file(temp_dir, "file1.py", "print('hello from file1')\n")
        file2 = create_temp_py_file(temp_dir, "file2.py", "print('hello from file2')\n")
        yield temp_dir, file1, file2
    finally:
        shutil.rmtree(temp_dir)

def test_memory_add_rm_update(temp_py_files):
    temp_dir, file1, file2 = temp_py_files
    runner = CliRunner()

    # 1. Test adding a single file
    result_add = runner.invoke(memory, ['--add', file1])
    assert result_add.exit_code == 0

    memory_instance = LanceDBMemory(os.getcwd())
    table_name = 'mle_chat_' + os.getcwd().split('/')[-1]

    # After adding, the memory should have entries for file1
    keys_after_add = memory_instance.list_all_keys(table_name)
    assert len(keys_after_add) > 0

    # 2. Test removing the file from memory
    result_rm = runner.invoke(memory, ['--rm', file1])
    assert result_rm.exit_code == 0

    # After removal, keys related to file1 should be gone
    # We check by metadata search for file1, should be empty
    records_after_rm = memory_instance.get_by_metadata('file', file1, table_name)
    assert records_after_rm == []

    # 3. Test update: add file2 first, then update it (should remove old chunks and add new)
    result_add2 = runner.invoke(memory, ['--add', file2])
    assert result_add2.exit_code == 0
    keys_after_add2 = memory_instance.list_all_keys(table_name)
    assert len(keys_after_add2) > 0

    result_update = runner.invoke(memory, ['--update', file2])
    assert result_update.exit_code == 0

    # After update, file2 chunks should still exist (re-added)
    records_after_update = memory_instance.get_by_metadata('file', file2, table_name)
    assert len(records_after_update) > 0

    # 4. Test adding a directory (should add both .py files)
    result_add_dir = runner.invoke(memory, ['--add', temp_dir])
    assert result_add_dir.exit_code == 0

    # Check that both files' chunks exist in memory
    rec_file1 = memory_instance.get_by_metadata('file', file1, table_name)
    rec_file2 = memory_instance.get_by_metadata('file', file2, table_name)
    assert len(rec_file1) > 0
    assert len(rec_file2) > 0

    # 5. Test removing directory (should remove all chunks for both files)
    result_rm_dir = runner.invoke(memory, ['--rm', temp_dir])
    assert result_rm_dir.exit_code == 0

    rec_file1_after_rm_dir = memory_instance.get_by_metadata('file', file1, table_name)
    rec_file2_after_rm_dir = memory_instance.get_by_metadata('file', file2, table_name)
    assert rec_file1_after_rm_dir == []
    assert rec_file2_after_rm_dir == []

def test_memory_no_path_option():
    runner = CliRunner()
    # Calling memory command without any option should do nothing and not fail
    result = runner.invoke(memory, [])
    assert result.exit_code == 0
    # No output expected
    assert result.output == ""
