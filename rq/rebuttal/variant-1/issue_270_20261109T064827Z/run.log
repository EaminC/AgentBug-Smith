import os
import tempfile
import shutil
import pytest
from mle.utils.memory import LanceDBMemory
from mle.cli import memory
import click
from click.testing import CliRunner


@pytest.fixture
def temp_py_file():
    # Create a temporary directory and a python file inside it
    temp_dir = tempfile.mkdtemp()
    file_path = os.path.join(temp_dir, "testfile.py")
    with open(file_path, "w") as f:
        f.write("def foo():\n    return 'bar'\n")
    yield file_path, temp_dir
    shutil.rmtree(temp_dir)


def test_memory_add_rm_update(temp_py_file):
    file_path, temp_dir = temp_py_file

    # Change working directory to temp_dir to simulate real usage
    orig_cwd = os.getcwd()
    os.chdir(temp_dir)

    runner = CliRunner()

    # Test adding the file to memory
    result_add = runner.invoke(memory, ['--add', file_path])
    assert result_add.exit_code == 0

    # Verify that the memory contains the added chunks
    mem = LanceDBMemory(temp_dir)
    table_name = 'mle_chat_' + temp_dir.split(os.sep)[-1]
    keys_after_add = mem.list_all_keys(table_name)
    assert len(keys_after_add) > 0, "Memory should contain chunks after adding file"

    # Test removing the file from memory
    result_rm = runner.invoke(memory, ['--rm', file_path])
    assert result_rm.exit_code == 0

    keys_after_rm = mem.list_all_keys(table_name)
    # After removal, keys related to the file should be gone
    # We check that no metadata with the file path remains
    records = mem.get_by_metadata('file', file_path, table_name)
    assert records == [], "Memory should have no records after removal"

    # Test updating the file in memory (should add it back)
    result_update = runner.invoke(memory, ['--update', file_path])
    assert result_update.exit_code == 0

    keys_after_update = mem.list_all_keys(table_name)
    assert len(keys_after_update) > 0, "Memory should contain chunks after update"

    os.chdir(orig_cwd)
