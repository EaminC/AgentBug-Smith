import os
import tempfile
import shutil
from pathlib import Path
import subprocess

import pytest

from mle.cli import memory
from mle.utils.memory import LanceDBMemory

def run_cli_memory_command(args):
    # Run the CLI memory command via subprocess to simulate CLI usage
    # We run `python -m mle.cli memory` with args
    # We use subprocess to isolate environment and simulate CLI
    cmd = ["python", "-m", "mle.cli", "memory"] + args
    result = subprocess.run(cmd, capture_output=True, text=True)
    return result

@pytest.fixture(scope="module")
def temp_project_dir():
    # Create a temporary directory with some python files
    tmpdir = tempfile.mkdtemp()
    # Create a subdirectory with python files
    subdir = os.path.join(tmpdir, "subdir")
    os.makedirs(subdir, exist_ok=True)
    # Create python files
    file1 = os.path.join(tmpdir, "file1.py")
    file2 = os.path.join(subdir, "file2.py")
    with open(file1, "w") as f:
        f.write("print('hello from file1')\n")
    with open(file2, "w") as f:
        f.write("print('hello from file2')\n")
    yield tmpdir
    shutil.rmtree(tmpdir)

def test_memory_add_rm_update(temp_project_dir):
    cwd = os.getcwd()
    try:
        os.chdir(temp_project_dir)
        # Use the CLI memory command to add the directory
        result_add = run_cli_memory_command(["--add", temp_project_dir])
        assert result_add.returncode == 0, f"Add failed: {result_add.stderr}"

        # Check that memory contains entries for both files
        memory_obj = LanceDBMemory(temp_project_dir)
        table_name = "mle_chat_" + Path(temp_project_dir).name
        keys = memory_obj.list_all_keys(table_name)
        assert len(keys) > 0, "No keys found after add"

        # Remove one file by absolute path
        file1_path = os.path.join(temp_project_dir, "file1.py")
        result_rm = run_cli_memory_command(["--rm", file1_path])
        assert result_rm.returncode == 0, f"Remove failed: {result_rm.stderr}"

        # Check that keys related to file1.py are removed
        # We check metadata by querying get_by_metadata
        records_file1 = memory_obj.get_by_metadata("file", file1_path, table_name)
        assert len(records_file1) == 0, "file1.py chunks not removed after rm"

        # Update file2.py (should remove old chunks and add new ones)
        file2_path = os.path.join(temp_project_dir, "subdir", "file2.py")
        # Modify file2.py content
