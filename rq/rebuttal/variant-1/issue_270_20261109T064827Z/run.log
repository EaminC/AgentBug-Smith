import os
import tempfile
import shutil
import pytest
from click.testing import CliRunner
from mle.cli import memory
from mle.utils.memory import LanceDBMemory

@pytest.fixture
def temp_py_files():
    # Create a temporary directory with some python files
    temp_dir = tempfile.mkdtemp()
    file1 = os.path.join(temp_dir, "file1.py")
    file2 = os.path.join(temp_dir, "file2.py")
    with open(file1, "w") as f:
        f.write("print('hello world')\n")
    with open(file2, "w") as f:
        f.write("def foo():\n    return 42\n")
    yield temp_dir, file1, file2
    shutil.rmtree(temp_dir)

def test_memory_add_rm_update(temp_py_files):
    temp_dir, file1, file2 = temp_py_files
    runner = CliRunner()

    # Use the directory for --add
    result_add = runner.invoke(memory, ['--add', temp_dir])
    assert result_add.exit_code == 0

    # Check that memory contains entries for these files
    mem = LanceDBMemory(os.getcwd())
    table_name = 'mle_chat_' + os.getcwd().split('/')[-1]

    # After add, keys for file1 and file2 should exist
    keys = mem.list_all_keys(table_name)
    assert keys, "Memory keys should not be empty after add"

    # Remove file1 from memory
    result_rm = runner.invoke(memory, ['--rm', file1])
    assert result_rm.exit_code == 0

    # After removal, no chunks with file1 metadata should remain
    records_file1 = mem.get_by_metadata('file', file1, table_name)
    assert records_file1 == [], "File1 chunks should be removed after --rm"

    # Update file2 (should remove old chunks and add new ones)
    result_update = runner.invoke(memory, ['--update', file2])
    assert result_update.exit_code == 0

    # After update, file2 chunks should exist
    records_file2 = mem.get_by_metadata('file', file2, table_name)
    assert records_file2, "File2 chunks should exist after --update"

    # Clean up by removing file2
    runner.invoke(memory, ['--rm', file2])

    # Confirm file2 chunks removed
    records_file2_after_rm = mem.get_by_metadata('file', file2, table_name)
    assert records_file2_after_rm == []

def test_memory_no_path_option():
    runner = CliRunner()
    # Call memory without any option, should do nothing but exit 0
    result = runner.invoke(memory, [])
    assert result.exit_code == 0
    # No exception or error message expected
    assert not result.output.strip()

def test_memory_add_nonexistent_file():
    runner = CliRunner()
    fake_path = "/path/does/not/exist.py"
    result = runner.invoke(memory, ['--add', fake_path])
    # Should exit 0 but no chunks added
    assert result.exit_code == 0
    mem = LanceDBMemory(os.getcwd())
    table_name = 'mle_chat_' + os.getcwd().split('/')[-1]
    records = mem.get_by_metadata('file', fake_path, table_name)
    assert records == []

def test_memory_rm_nonexistent_file():
    runner = CliRunner()
    fake_path = "/path/does/not/exist.py"
    result = runner.invoke(memory, ['--rm', fake_path])
    # Should exit 0 and not fail
    assert result.exit_code == 0

def test_memory_update_nonexistent_file():
    runner = CliRunner()
    fake_path = "/path/does/not/exist.py"
    result = runner.invoke(memory, ['--update', fake_path])
    # Should exit 0 and not fail
    assert result.exit_code == 0
