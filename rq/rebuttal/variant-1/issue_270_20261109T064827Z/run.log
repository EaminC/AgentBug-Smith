import os
import tempfile
import shutil
import pytest
from click.testing import CliRunner
from mle.cli import memory
from mle.utils.memory import LanceDBMemory

@pytest.fixture
def temp_py_files():
    # Create a temporary directory with some python files
    temp_dir = tempfile.mkdtemp()
    file1 = os.path.join(temp_dir, "file1.py")
    file2 = os.path.join(temp_dir, "file2.py")
    with open(file1, "w") as f:
        f.write("print('hello from file1')\n")
    with open(file2, "w") as f:
        f.write("print('hello from file2')\n")
    yield temp_dir, file1, file2
    shutil.rmtree(temp_dir)

def test_memory_add_rm_update(temp_py_files):
    temp_dir, file1, file2 = temp_py_files
    runner = CliRunner()

    # Use the directory for --add
    result_add = runner.invoke(memory, ['--add', temp_dir])
    assert result_add.exit_code == 0

    # Verify that chunks from file1 and file2 are added
    memory_obj = LanceDBMemory(os.getcwd())
    table_name = 'mle_chat_' + os.getcwd().split('/')[-1]

    # The table should contain entries for file1 and file2
    keys_file1 = memory_obj.get_by_metadata('file', file1, table_name=table_name)
    keys_file2 = memory_obj.get_by_metadata('file', file2, table_name=table_name)
    assert len(keys_file1) > 0
    assert len(keys_file2) > 0

    # Now test --rm removes all chunks related to file1
    result_rm = runner.invoke(memory, ['--rm', file1])
    assert result_rm.exit_code == 0
    keys_file1_after_rm = memory_obj.get_by_metadata('file', file1, table_name=table_name)
    assert len(keys_file1_after_rm) == 0

    # file2 chunks should still exist
    keys_file2_after_rm = memory_obj.get_by_metadata('file', file2, table_name=table_name)
    assert len(keys_file2_after_rm) > 0

    # Now test --update on file2 (should remove old and add new chunks)
    # Modify file2 content
    with open(file2, "w") as f:
        f.write("print('updated content')\n")
    result_update = runner.invoke(memory, ['--update', file2])
    assert result_update.exit_code == 0
    keys_file2_after_update = memory_obj.get_by_metadata('file', file2, table_name=table_name)
    assert len(keys_file2_after_update) > 0

    # Confirm that after update, the old chunks are replaced (at least one chunk exists)
    # We can't check exact chunk keys but presence suffices

def test_memory_no_path_option():
    runner = CliRunner()
    # Invoke memory command without any option, should do nothing and exit 0
    result = runner.invoke(memory, [])
    assert result.exit_code == 0
