import os
import tempfile
import shutil
import pytest
from click.testing import CliRunner
from mle.cli import memory
from mle.utils.memory import LanceDBMemory


@pytest.fixture
def temp_py_file():
    # Create a temporary Python file for testing
    temp_dir = tempfile.mkdtemp()
    file_path = os.path.join(temp_dir, "test_file.py")
    with open(file_path, "w") as f:
        f.write("def foo():\n    return 'bar'\n")
    yield file_path
    shutil.rmtree(temp_dir)


def test_memory_add_rm_update(temp_py_file):
    runner = CliRunner()

    # Test adding the file to memory
    result_add = runner.invoke(memory, ["--add", temp_py_file])
    assert result_add.exit_code == 0

    # Check that the file chunks have been added to memory
    mem = LanceDBMemory(os.getcwd())
    table_name = "mle_chat_" + os.getcwd().split("/")[-1]
    keys = mem.list_all_keys(table_name)
    assert len(keys) > 0, "Memory should contain keys after add"

    # Test removing the file from memory
    result_rm = runner.invoke(memory, ["--rm", temp_py_file])
    assert result_rm.exit_code == 0

    # After removal, keys related to the file should be gone
    keys_after_rm = mem.list_all_keys(table_name)
    # The keys related to the file should be removed; keys_after_rm may be empty or smaller
    # We check that no metadata with file == temp_py_file remains
    records = mem.get_by_metadata("file", temp_py_file, table_name)
    assert records == [], "Memory should have no records for the file after rm"

    # Test updating the file in memory (should add it back)
    result_update = runner.invoke(memory, ["--update", temp_py_file])
    assert result_update.exit_code == 0

    # After update, keys related to the file should exist again
    records_after_update = mem.get_by_metadata("file", temp_py_file, table_name)
    assert len(records_after_update) > 0, "Memory should contain records for the file after update"

    # Clean up by removing the file again
    runner.invoke(memory, ["--rm", temp_py_file])
