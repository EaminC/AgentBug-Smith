import os
import tempfile
import shutil
import pytest
from click.testing import CliRunner
from mle.cli import memory
from mle.utils.memory import LanceDBMemory

@pytest.fixture
def temp_py_files():
    # Create a temporary directory with some Python files
    temp_dir = tempfile.mkdtemp()
    file1 = os.path.join(temp_dir, "file1.py")
    file2 = os.path.join(temp_dir, "file2.py")
    with open(file1, "w") as f:
        f.write("print('hello world')\n")
    with open(file2, "w") as f:
        f.write("def foo():\n    return 42\n")
    yield temp_dir, [file1, file2]
    shutil.rmtree(temp_dir)

def test_memory_add_rm_update(temp_py_files):
    temp_dir, files = temp_py_files
    runner = CliRunner()

    # Use the first file path for rm and update tests
    file_to_test = files[0]

    # Run memory --add on the directory
    result_add = runner.invoke(memory, ['--add', temp_dir])
    assert result_add.exit_code == 0

    # Check that the memory table contains entries for the added files
    memory_instance = LanceDBMemory(os.getcwd())
    table_name = 'mle_chat_' + os.getcwd().split('/')[-1]
    keys = memory_instance.list_all_keys(table_name)
    # There should be keys after adding files
    assert len(keys) > 0

    # Run memory --rm on one file
    result_rm = runner.invoke(memory, ['--rm', file_to_test])
    assert result_rm.exit_code == 0

    # After removal, keys related to that file should be gone
    # We check by metadata
    records = memory_instance.get_by_metadata('file', file_to_test, table_name)
    assert len(records) == 0

    # Run memory --update on the other file
    file_to_update = files[1]
    result_update = runner.invoke(memory, ['--update', file_to_update])
    assert result_update.exit_code == 0

    # After update, records for that file should exist
    records_after_update = memory_instance.get_by_metadata('file', file_to_update, table_name)
    assert len(records_after_update) > 0

    # Clean up by removing updated file from memory
    runner.invoke(memory, ['--rm', file_to_update])
