def test_memory_add_rm_update(temp_py_file):
    temp_dir, file_path = temp_py_file
    runner = CliRunner()

    # Use the temp_dir as cwd for the command context
    # Add the file to memory
    result_add = runner.invoke(memory, ['--add', file_path], catch_exceptions=False, env={"PWD": temp_dir})
    assert result_add.exit_code == 0

    # Instantiate LanceDBMemory directly to check contents
    mem = LanceDBMemory(temp_dir)
    table_name = 'mle_chat_' + temp_dir.split(os.sep)[-1]

    # After add, there should be keys in the table
    keys_after_add = mem.list_all_keys(table_name)
    assert len(keys_after_add) > 0

    # Remove the file from memory
    result_rm = runner.invoke(memory, ['--rm', file_path], catch_exceptions=False, env={"PWD": temp_dir})
    assert result_rm.exit_code == 0

    # After removal, keys should be empty or none
    keys_after_rm = mem.list_all_keys(table_name)
    assert len(keys_after_rm) == 0

    # Add again to test update
    result_add_again = runner.invoke(memory, ['--add', file_path], catch_exceptions=False, env={"PWD": temp_dir})
    assert result_add_again.exit_code == 0
    keys_after_add_again = mem.list_all_keys(table_name)
    assert len(keys_after_add_again) > 0

    # Update the file in memory (should remove old and add new)
    result_update = runner.invoke(memory, ['--update', file_path], catch_exceptions=False, env={"PWD": temp_dir})
    assert result_update.exit_code == 0

    # After update, keys should still exist and be valid
    keys_after_update = mem.list_all_keys(table_name)
    assert len(keys_after_update) > 0

    # The keys after update should be the same or different but not empty
    assert keys_after_update != []

def test_memory_no_option():
    runner = CliRunner()
    # Calling memory command without any option should do nothing and exit 0
    result = runner.invoke(memory, [], catch_exceptions=False)
    assert result.exit_code == 0
