import os
import tempfile
import shutil
import pytest
from click.testing import CliRunner
from mle.cli import memory
from mle.utils.memory import LanceDBMemory


def create_temp_py_file(dir_path, filename, content):
    file_path = os.path.join(dir_path, filename)
    with open(file_path, "w", encoding="utf-8") as f:
        f.write(content)
    return file_path


@pytest.fixture
def temp_project_dir():
    # Create a temporary directory to simulate a project directory
    temp_dir = tempfile.mkdtemp(prefix="mle_test_project_")
    yield temp_dir
    shutil.rmtree(temp_dir)


def test_memory_add_rm_update(temp_project_dir):
    runner = CliRunner()

    # Create a sample python file
    file_content_v1 = "def foo():\n    return 42\n"
    file_content_v2 = "def foo():\n    return 43\n"
    py_file = create_temp_py_file(temp_project_dir, "test_file.py", file_content_v1)

    # Change working directory to temp_project_dir for the CLI command
    old_cwd = os.getcwd()
    os.chdir(temp_project_dir)
    try:
        # 1) Test adding the file to memory
        result_add = runner.invoke(memory, ["--add", py_file])
        assert result_add.exit_code == 0

        # Verify that the memory table contains entries for the file
        memory_instance = LanceDBMemory(temp_project_dir)
        table_name = "mle_chat_" + temp_project_dir.split(os.sep)[-1]
        keys = memory_instance.list_all_keys(table_name=table_name)
        assert len(keys) > 0

        # 2) Test removing the file from memory
        result_rm = runner.invoke(memory, ["--rm", py_file])
        assert result_rm.exit_code == 0

        # After removal, keys for that file should be gone
        keys_after_rm = memory_instance.list_all_keys(table_name=table_name)
        # The keys related to the removed file should not exist
        # We check by querying metadata for the file, expecting empty list
        records = memory_instance.get_by_metadata("file", py_file, table_name=table_name)
        assert records == []

        # 3) Test updating the file in memory
        # First add it again
        result_add_again = runner.invoke(memory, ["--add", py_file])
        assert result_add_again.exit_code == 0

        # Modify the file content
        with open(py_file, "w", encoding="utf-8") as f:
            f.write(file_content_v2)

        # Update the file in memory
        result_update = runner.invoke(memory, ["--update", py_file])
        assert result_update.exit_code == 0

        # After update, the memory should reflect the new content chunks
        # We check that the keys exist and records for the file exist
        records_after_update = memory_instance.get_by_metadata("file", py_file, table_name=table_name)
        assert len(records_after_update) > 0

    finally:
        os.chdir(old_cwd)
