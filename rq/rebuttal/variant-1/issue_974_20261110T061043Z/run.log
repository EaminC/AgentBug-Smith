[32mimport pytest
import asyncio

from strands.models.litellm import LiteLLMModel
from strands.types.exceptions import ContextWindowOverflowException
from litellm.exceptions import ContextWindowExceededError


@pytest.mark.asyncio
async def test_litellm_context_window_overflow_exception_mapping():
    """
    This test verifies that when the LiteLLMModel encounters a context window overflow error
    from the litellm client, it raises the typed ContextWindowOverflowException.

    Before the fix:
        The litellm client raises ContextWindowExceededError but the model does not map it,
        so the test will fail to catch ContextWindowOverflowException.

    After the fix:
        The model maps ContextWindowExceededError to ContextWindowOverflowException,
        so the test passes by catching the expected exception.
    """
    model = LiteLLMModel(
        model_id="litellm_proxy/us.anthropic.claude-3-7-sonnet-20250219-v1:0",
        client_args={
            "api_base": "http://0.0.0.0:4000",
            "api_key": "key",
        },
    )

    # Patch the litellm.acompletion method internally by monkeypatching the model's client_args to raise
    # ContextWindowExceededError when called.
    # We do not mock the model.stream method itself, only the internal litellm.acompletion call.
    # Since we cannot use unittest.mock, we patch by replacing the attribute on litellm module.

    import litellm

    original_acompletion = litellm.acompletion

    async def raise_context_window_error(*args, **kwargs):
        raise ContextWindowExceededError(
            message="Input too long for model context window",
            model="dummy-model",
            llm_provider="dummy-provider",
        )

    litellm.acompletion = raise_context_window_error

    # The input is very large to simulate overflow, but actual content is irrelevant since we mock.
    messages = [{"role": "user", "content": [{"text": "Hi" * 1000000}]}]

    caught = False
    try:
        # model.stream is an async generator, so we must iterate it asynchronously
        async for _ in model.stream(messages):
            pass
    except ContextWindowOverflowException:
        caught = True
    except Exception as e:
        # If any other exception is raised, fail the test
        pytest.fail(f"Unexpected exception raised: {e}")
    finally:
        # Restore original acopmletion method to avoid side effects
        litellm.acompletion = original_acompletion

    assert caught, "ContextWindowOverflowException was not raised as expected"[0m
