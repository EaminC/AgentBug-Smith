from strands import Agent
from strands.models.litellm import LiteLLMModel
from strands.types.exceptions import ContextWindowOverflowException


@pytest.mark.asyncio
async def test_litellm_context_window_overflow_exception():
    """
    Test that LiteLLMModel raises ContextWindowOverflowException on context window overflow.

    This test sends a very large input to the model to trigger a context window overflow error.
    It asserts that the raised exception is ContextWindowOverflowException, not the raw litellm error.
    """
    model = LiteLLMModel(
        model_id="litellm_proxy/us.anthropic.claude-3-7-sonnet-20250219-v1:0",
        params={
            "api_base": "http://0.0.0.0:4000",
            "api_key": "key",
        },
    )
    agent = Agent(model=model)

    large_input = "Hi" * 1000000

    with pytest.raises(ContextWindowOverflowException):
        # The agent call is async, so we await it.
        # The agent call returns a coroutine or an awaitable.
        # If agent is sync, just call it directly.
        # We try both to be safe.
        result = agent(large_input)
        if hasattr(result, "__await__"):
            await result
        else:
            # synchronous call
            pass  # no further action needed, exception should be raised


