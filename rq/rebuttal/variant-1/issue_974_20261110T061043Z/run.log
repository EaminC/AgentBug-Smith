[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY=forge-key \
    FORGE_BASE_URL=https://api.forge.tensorblock.co/v1 \
    MODEL=openrouter2/openai/gpt-4.1-mini \
    AI_TEMPERATURE=0.7 \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    ANTHROPIC_MODEL=openrouter2/openai/gpt-4.1-mini \
    ANTHROPIC_SMALL_FAST_MODEL=openrouter2/openai/gpt-4.1-mini \
    OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    TAVILY_API_KEY=tvly-key \
    GITHUB_TOKEN=ghp_key
# --- end inject ---

# Set working directory
WORKDIR /app

# Install system dependencies needed for Python build and runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc python3-dev libxml2-dev libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Install dependencies using requirements.txt if it exists, else install editable.
RUN if [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt; \
    else \
    pip install -e .; \
    fi

# Install Python test dependencies (excluding pytest-block-network which is not found in PyPI)
RUN pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout setuptools<=81.0.0 litellm opentelemetry-api opentelemetry-sdk

# Set PYTHONPATH to include /app and /app/src since source code is in src/
ENV PYTHONPATH=/app:/app/src

# Preflight check to verify installation succeeded
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command to run bash shell
CMD ["/bin/bash"]

# branch: python/pyproject.toml fixed test deps and system dependencies
