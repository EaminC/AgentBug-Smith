[32mimport pytest
from strands import Agent
from strands.models.litellm import LiteLLMModel
from strands.types.exceptions import ContextWindowOverflowException

@pytest.mark.asyncio
async def test_litellm_context_window_overflow_exception(monkeypatch):
    # Setup a LiteLLMModel with dummy proxy parameters
    model = LiteLLMModel(
        model_id="litellm_proxy/us.anthropic.claude-3-7-sonnet-20250219-v1:0",
        params={
            "api_base": "http://0.0.0.0:4000",
            "api_key": "key"
        }
    )
    agent = Agent(model=model)

    # Monkeypatch the model's stream method to simulate a context window overflow error raised by litellm
    class DummyContextWindowExceededError(Exception):
        pass

    async def dummy_stream(messages):
        raise DummyContextWindowExceededError("Input is too long for requested model.")

    # Patch the internal litellm.acompletion call indirectly by patching the model's stream to raise the error
    # We do this because the actual litellm client call is inside model.stream
    original_stream = model.stream
    async def patched_stream(messages):
        raise ContextWindowOverflowException("Input is too long for requested model.")
    model.stream = patched_stream

    # Now test that calling agent with a very large input raises ContextWindowOverflowException
    with pytest.raises(ContextWindowOverflowException):
        # The agent call triggers model.stream internally
        await agent("Hi" * 1000000)

    # Restore original stream method to avoid side effects
    model.stream = original_stream[0m
