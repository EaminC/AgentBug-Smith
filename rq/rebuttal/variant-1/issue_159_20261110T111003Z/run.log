    def __init__(self):
        self.query_calls = []

    def query(self, chat_history, response_format=None):
        self.query_calls.append((chat_history, response_format))
        last_user_msg = None
        for msg in reversed(chat_history):
            if msg["role"] == "user":
                last_user_msg = msg["content"]
