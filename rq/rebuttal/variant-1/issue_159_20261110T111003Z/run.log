                self.status_messages.append(message)
                return self_

            def __exit__(self_, exc_type, exc_val, exc_tb):
                return False

        return DummyStatus()


def test_clarify_dataset_suggests_for_blur_input():
    model = DummyModel()
    console = DummyConsole()
    agent = advisor_mod.AdviseAgent(model=model, console=console)

    # Provide a deliberately unclear dataset name to trigger suggestions
    unclear_dataset_name = "blur dataset"

    # Call clarify_dataset, which should detect unclear dataset and return suggestions
    result = agent.clarify_dataset(unclear_dataset_name)

    # The result should be one of the suggested datasets (a string from the list)
    assert result in ["mnist", "cifar10", "imagenet", "fashion-mnist", "svhn"]

    # The model should have been queried at least twice (verification + suggestion)
    assert len(model.query_calls) >= 2

    # The console should have shown status messages for verification and suggestion
    status_msgs = console.status_messages
    assert any("verifing dataset" in msg.lower() for msg in status_msgs)
    assert any("suggesting datasets" in msg.lower() for msg in status_msgs)


def test_clarify_dataset_returns_none_for_clear_input():
    model = DummyModel()
    console = DummyConsole()
    agent = advisor_mod.AdviseAgent(model=model, console=console)

    # Provide a clear dataset name that should be recognized as valid
    clear_dataset_name = "mnist"

    # Call clarify_dataset, which should detect clear dataset and return None
    result = agent.clarify_dataset(clear_dataset_name)

    assert result is None

    # The model should have been queried once (verification only)
    assert len(model.query_calls) == 1

    # The console should have shown status message for verification only
    status_msgs = console.status_messages
    assert any("verifing dataset" in msg.lower() for msg in status_msgs)
    assert not any("suggesting datasets" in msg.lower() for msg in status_msgs)[0m
