import mle.agents.advisor as advisor_mod


class DummyModel:
    def __init__(self):
        self.query_calls = []

    def query(self, chat_history, response_format=None):
        self.query_calls.append((chat_history, response_format))
        last_user_msg = next(
            (msg["content"] for msg in reversed(chat_history) if msg["role"] == "user"),
            ""
        ).lower()

        # Simulate the verification step: if dataset is "blur" or unclear, answer "No"
        if "the dataset provided by the user is:" in last_user_msg:
            if "blur" in last_user_msg or "unclear" in last_user_msg:
                return "No"
            else:
                return "Yes"

        # Simulate the suggestion step: return a JSON string with datasets and reason
        if "suggest up to five publicly available datasets" in last_user_msg:
            response = {
                "datasets": [
                    "mnist",
                    "cifar10",
                    "imagenet",
                    "fashion-mnist",
                    "svhn"
                ],
                "reason": "Based on the user's dataset description, these datasets are popular and relevant."
            }
            return json.dumps(response)

        return "Yes"


class DummyConsole:
