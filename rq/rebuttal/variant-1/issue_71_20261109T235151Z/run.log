from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.models.model import ModelResponse


class DummyClient:
    def chat(self, **kwargs):
        # Return a dummy ModelResponse with fixed text and raw content
        return ModelResponse(text="dummy response", raw={"choices": [{"message": {"content": "dummy response"}}]})


@pytest.fixture
def dummy_openai_model():
    # Create an instance of OpenAIChatWrapper with a dummy client to avoid real API calls
    model = OpenAIChatWrapper("dummy-config")
    model.client = DummyClient()
    return model


def test_openai_model_accepts_list_of_messages(dummy_openai_model):
    # Provide a list of messages with role and content, should not raise error
    messages = [
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi, how can I help you?"},
    ]
    response = dummy_openai_model(messages)
    assert isinstance(response, ModelResponse)
    assert response.text == "dummy response"


def test_openai_model_accepts_single_msg_object(dummy_openai_model):
    # Provide a single message as a dict (not a list)
    single_message = {"role": "user", "content": "Hello single message"}
    # This should raise ValueError in buggy code, but pass after fix
    with pytest.raises(ValueError) as e:
        dummy_openai_model(single_message)
    # After fix, the call should raise ValueError about expecting list, not about missing role/content
    assert "expected type `list`" in str(e.value)


def test_openai_model_rejects_non_list_messages(dummy_openai_model):
    # Pass an int instead of list or dict
    with pytest.raises(ValueError) as e:
        dummy_openai_model(123)
    assert "expected type `list`" in str(e.value)


def test_openai_model_rejects_list_missing_role_or_content(dummy_openai_model):
    # Pass a list with one dict missing 'role'
    bad_messages = [{"content": "Hello"}]
    with pytest.raises(ValueError) as e:
        dummy_openai_model(bad_messages)
    assert "must contain a 'role' and 'content' key" in str(e.value)


def test_openai_model_rejects_empty_list(dummy_openai_model):
    # Pass an empty list, should not raise error about role/content but may be allowed
    # Depending on implementation, empty list might be accepted or rejected.
    # Here we test it does not raise the role/content error.
    try:
        dummy_openai_model([])
    except ValueError as e:
        # It should not be about missing role/content keys
        assert "role" not in str(e)
    except Exception:
        # Any other exception is allowed here
        pass[0m
