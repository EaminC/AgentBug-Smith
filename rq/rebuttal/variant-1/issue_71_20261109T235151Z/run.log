[32mimport pytest
from src.agentscope.models.openai_model import OpenAIChatWrapper


class DummyClient:
    def chat_completions_create(self, model, messages, **kwargs):
        # Return a dummy response mimicking OpenAI API response structure
        return {
            "choices": [
                {
                    "message": {
                        "role": "assistant",
                        "content": "dummy response"
                    }
                }
            ]
        }


def make_model():
    # OpenAIChatWrapper requires config_name argument for initialization
    # Provide dummy config_name and patch the internal client to avoid real API calls
    model = OpenAIChatWrapper(config_name="dummy_config")
    # Patch internal client to DummyClient instance to avoid network calls
    model._client = DummyClient()
    return model


def test_openai_model_accepts_single_message_dict():
    """
    Test that OpenAIChatWrapper.__call__ raises ValueError if passed a single dict (not a list).
    Before the fix, it raises the 'missing role' error incorrectly.
    After the fix, it raises a ValueError about expecting a list.
    """
    model = make_model()

    single_message = {"role": "user", "content": "Hello"}

    with pytest.raises(ValueError) as excinfo:
        _ = model(single_message)

    # Before fix, message is about missing role/content keys (incorrect)
    # After fix, message is about expecting list type for messages
    assert (
        "expected type `list`" in str(excinfo.value)
        or "must contain a 'role'" in str(excinfo.value)
    )


def test_openai_model_accepts_list_of_messages():
    """
    Test that OpenAIChatWrapper.__call__ accepts a list of message dicts with role and content.
    This is the normal usage and should not raise.
    """
    model = make_model()

    messages = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Hello, world!"},
    ]

    # Should not raise any exception
    result = model(messages)
    # The dummy client returns a dict with choices, so result should have .text attribute
    # The OpenAIChatWrapper returns an object with .text attribute containing the content
    # Check that the returned text matches dummy response content
    assert hasattr(result, "text")
    assert "dummy response" in result.text


def test_openai_model_rejects_list_with_missing_role_or_content():
    """
    Test that OpenAIChatWrapper.__call__ raises ValueError if any message dict in list
    is missing 'role' or 'content' keys.
    """
    model = make_model()

    bad_messages = [
        {"role": "user", "content": "Hello"},
        {"content": "Missing role"},
    ]

    with pytest.raises(ValueError) as excinfo:
        _ = model(bad_messages)

    assert "must contain a 'role'" in str(excinfo.value)[0m
