from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


class DummyClientChatCompletions:
    def create(self, model, messages, **kwargs):
        # Return a dummy response object with .text attribute
        class DummyResponse:
            def __init__(self):
                self.text = "dummy response"
                self.raw = {"choices": [{"message": {"content": "dummy response"}}]}
        return DummyResponse()


class DummyClientChat:
    def __init__(self):
        self.completions = DummyClientChatCompletions()


class DummyClient:
    def __init__(self):
        self.chat = DummyClientChat()


@pytest.fixture
def dummy_openai_model():
    model = OpenAIChatWrapper(config_name="dummy-config")
    # Inject dummy client to avoid real API calls
    model.client = DummyClient()
    model.model_name = "dummy-model"
    return model


def test_openai_model_accepts_list_of_messages(dummy_openai_model):
    # Provide a list of messages with role and content, should not raise error
    messages = [
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi, how can I help you?"},
    ]
    response = dummy_openai_model(messages)
    assert hasattr(response, "text")
    assert response.text == "dummy response"


def test_openai_model_accepts_single_msg_object(dummy_openai_model):
    # Provide a single message as a dict (not a list)
    single_message = {"role": "user", "content": "Hello single message"}
    # This should raise ValueError in buggy code, but after fix it should raise about expecting list
    with pytest.raises(ValueError) as e:
        dummy_openai_model(single_message)
    # After fix, the call should raise ValueError about expecting list, not about missing role/content
    assert "expected type `list`" in str(e.value)


def test_openai_model_rejects_non_list_messages(dummy_openai_model):
    # Pass an int instead of list or dict
    with pytest.raises((ValueError, TypeError)) as e:
        dummy_openai_model(123)
    # The error message should mention expected list or be a TypeError due to iteration
    assert (
        "expected type `list`" in str(e.value)
        or "object is not iterable" in str(e.value)
        or isinstance(e.value, TypeError)
    )


def test_openai_model_rejects_list_missing_role_or_content(dummy_openai_model):
    # Provide a list with one message missing 'role'
    messages = [
        {"content": "Hello"},
    ]
    with pytest.raises(ValueError) as e:
        dummy_openai_model(messages)
    assert "must contain a 'role' and 'content' key" in str(e.value)


def test_openai_model_rejects_list_with_non_dict(dummy_openai_model):
    # Provide a list with a non-dict element
    messages = [
        {"role": "user", "content": "Hello"},
        "not a dict",
    ]
    with pytest.raises(ValueError) as e:
        dummy_openai_model(messages)
    assert "must contain a 'role' and 'content' key" in str(e.value)


