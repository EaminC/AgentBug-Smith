[32mimport pytest
from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


@pytest.fixture
def dummy_openai_model():
    # The OpenAIChatWrapper requires a config_name argument, provide a dummy string.
    model = OpenAIChatWrapper(config_name="dummy-config", model_name="gpt-3.5-turbo")
    return model


def test_openai_model_accepts_list_of_messages(dummy_openai_model):
    # A list of messages with role and content keys should be accepted.
    messages = [
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi! How can I help you?"},
    ]
    # Should not raise
    response = dummy_openai_model(messages)
    assert hasattr(response, "text")


def test_openai_model_rejects_single_message_dict_with_missing_type_check(dummy_openai_model):
    # Passing a single dict (not in a list) should raise ValueError about expected list type.
    single_message = {"role": "user", "content": "Hello"}
    with pytest.raises(ValueError) as e:
        dummy_openai_model(single_message)
    assert "expected type `list`" in str(e.value)


def test_openai_model_rejects_single_message_msg_instance(dummy_openai_model):
    # Passing a single Msg instance (not in a list) should raise ValueError about expected list type.
    single_msg = Msg(name="user", role="user", content="Hello")
    with pytest.raises(ValueError) as e:
        dummy_openai_model(single_msg)
    assert "expected type `list`" in str(e.value)


def test_openai_model_rejects_messages_missing_role_or_content(dummy_openai_model):
    # Passing a list of dicts missing role or content keys should raise ValueError about missing keys.
    invalid_messages = [
        {"role": "user", "content": "Hello"},
        {"content": "Missing role key"},
    ]
    with pytest.raises(ValueError) as e:
        dummy_openai_model(invalid_messages)
    assert "must contain a 'role' and 'content' key" in str(e.value)


def test_openai_model_accepts_msg_list_with_msg_instances(dummy_openai_model):
    # Passing a list of Msg instances should be accepted.
    msgs = [
        Msg(name="user", role="user", content="Hello"),
        Msg(name="assistant", role="assistant", content="Hi!"),
    ]
    # Should not raise
    response = dummy_openai_model(msgs)
    assert hasattr(response, "text")[0m
