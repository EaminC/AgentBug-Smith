from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


class DummyClient:
    def chat_completions_create(self, model, messages, **kwargs):
        # Return a dummy response with the same messages concatenated
        content = " ".join(msg["content"] for msg in messages)
        return {"choices": [{"message": {"content": content}}]}


@pytest.fixture
def dummy_openai_model():
    # Provide required config_name argument to avoid TypeError
    model = OpenAIChatWrapper(config_name="dummy-config", model_name="dummy-model")
    # Patch the internal client to avoid real API calls
    model.client = DummyClient()
    return model


def test_openai_model_accepts_list_of_messages(dummy_openai_model):
    messages = [
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there!"},
    ]
    result = dummy_openai_model(messages)
    assert hasattr(result, "text")
    assert "Hello" in result.text
    assert "Hi there!" in result.text


def test_openai_model_accepts_single_msg_object(dummy_openai_model):
    # Single message as a dict, not a list
    single_message = {"role": "user", "content": "Hello single message"}
    # This should raise ValueError in buggy code, but pass after fix
    result = dummy_openai_model(single_message)
    assert hasattr(result, "text")
    assert "Hello single message" in result.text


def test_openai_model_rejects_non_list_messages(dummy_openai_model):
    # Pass an int instead of list or dict
    with pytest.raises(ValueError) as e:
        dummy_openai_model(123)
    assert "expected type `list`" in str(e.value)


def test_openai_model_rejects_messages_missing_role_or_content(dummy_openai_model):
    # List with one dict missing 'role'
    bad_messages = [{"content": "missing role"}]
    with pytest.raises(ValueError) as e:
        dummy_openai_model(bad_messages)
    assert "must contain a 'role' and 'content' key" in str(e.value)

    # List with one dict missing 'content'
    bad_messages = [{"role": "user"}]
    with pytest.raises(ValueError) as e:
        dummy_openai_model(bad_messages)
    assert "must contain a 'role' and 'content' key" in str(e.value)[0m
