class DummyResponse:
    def __init__(self):
        self.choices = [types.SimpleNamespace(message={"content": "dummy response"})]

    @property
    def text(self):
        return self.choices[0].message["content"]


@pytest.fixture
def dummy_openai_model(monkeypatch):
    # Create an instance of OpenAIChatWrapper with dummy config
    model = OpenAIChatWrapper(config_name="dummy-config")

    # Patch the internal client to avoid real API calls
    dummy_completions = types.SimpleNamespace(create=lambda *a, **k: DummyResponse())
    dummy_chat = types.SimpleNamespace(completions=dummy_completions)
    dummy_client = types.SimpleNamespace(chat=dummy_chat)

    # The real attribute name is likely 'client' not '_client' based on typical usage
    # Try patching 'client' attribute instead of '_client'
    setattr(model, "client", dummy_client)

    return model


def test_openai_model_accepts_list_of_messages(dummy_openai_model):
    # Passing a list of messages with role and content should work
    messages = [{"role": "user", "content": "Hello"}]
    response = dummy_openai_model(messages)
    assert isinstance(response.text, str)
    assert "dummy response" in response.text


def test_openai_model_accepts_single_msg_object(dummy_openai_model):
    # Passing a single message dict with role and content should raise ValueError in buggy code,
    # but after fix, it should raise ValueError because input must be a list.
    # So here we test that passing a single dict raises ValueError about expecting list type.
    single_message = {"role": "user", "content": "Hello"}

    with pytest.raises(ValueError) as excinfo:
        dummy_openai_model(single_message)

    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_rejects_non_list_messages(dummy_openai_model):
    # Passing a non-list, non-dict (e.g., string) should raise ValueError about expecting list
    non_list_input = "this is not a list"

    with pytest.raises(ValueError) as excinfo:
        dummy_openai_model(non_list_input)

    assert "expected type `list`" in str(excinfo.value)[0m
