from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


class DummyClient:
    # Dummy client to mock the real openai client interface minimally
    class Chat:
        class Completions:
            @staticmethod
            def create(model, messages, **kwargs):
                # Return a dummy response object with .text attribute
                class DummyResponse:
                    text = "dummy response"
                return DummyResponse()
        completions = Completions()
    chat = Chat()


@pytest.fixture
def dummy_openai_model():
    # Create an instance of OpenAIChatWrapper with a dummy client to avoid real API calls
    model = OpenAIChatWrapper(config_name="dummy_config")
    model.client = DummyClient()
    model.model_name = "dummy-model"
    model.generate_args = {}
    return model


def test_openai_model_accepts_list_of_messages(dummy_openai_model):
    # Pass a list of messages with role and content keys
    messages = [
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there!"}
    ]
    # Should not raise and return a response with .text attribute
    response = dummy_openai_model(messages)
    assert hasattr(response, "text")
    assert response.text == "dummy response"


def test_openai_model_rejects_non_list_messages(dummy_openai_model):
    # Pass a single dict message with role and content keys (not a list)
    message = {"role": "user", "content": "Hello"}
    # Should raise ValueError about expecting list type
    with pytest.raises(ValueError) as excinfo:
        dummy_openai_model(message)
    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_rejects_list_missing_role_or_content(dummy_openai_model):
    # Pass a list with one dict missing 'role' key
    messages = [{"content": "Hello"}]
    with pytest.raises(ValueError) as excinfo:
        dummy_openai_model(messages)
    assert "must contain a 'role' and 'content' key" in str(excinfo.value)


def test_openai_model_accepts_single_msg_object(dummy_openai_model):
    # Pass a single Msg object (which is dict-like) inside a list
    msg = Msg(name="user", role="user", content="Hello")
    response = dummy_openai_model([msg])
    assert hasattr(response, "text")
    assert response.text == "dummy response"[0m
