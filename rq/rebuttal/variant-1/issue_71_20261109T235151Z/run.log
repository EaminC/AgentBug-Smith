[32mimport pytest
from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg


class DummyClient:
    class Chat:
        class Completions:
            def create(self, model, messages, **kwargs):
                # Return dummy response with minimal structure
                class DummyResponse:
                    def model_dump(self):
                        return {"choices": [{"message": {"content": "dummy response"}}]}
                return DummyResponse()
        completions = Completions()
    chat = Chat()


@pytest.fixture
def dummy_openai_model():
    # Create an instance of OpenAIChatWrapper with dummy client and minimal config
    model = OpenAIChatWrapper.__new__(OpenAIChatWrapper)
    model.model_name = "dummy_model"
    model.generate_args = {}
    model.client = DummyClient()
    model._save_model_invocation = lambda *a, **k: None
    class DummyMonitor:
        def update(self, *a, **k): pass
    model.monitor = DummyMonitor()
    return model


def test_openai_model_accepts_list_of_messages(dummy_openai_model):
    # Passing a list of dict messages with role and content should succeed
    messages = [{"role": "user", "content": "Hello"}]
    response = dummy_openai_model(messages)
    assert hasattr(response, "model_dump")
    dumped = response.model_dump()
    assert "choices" in dumped


def test_openai_model_accepts_single_msg_object(dummy_openai_model):
    # Passing a list containing a single Msg object should succeed
    msg = Msg(name="user", role="user", content="Hello")
    response = dummy_openai_model([msg])
    assert hasattr(response, "model_dump")
    dumped = response.model_dump()
    assert "choices" in dumped


def test_openai_model_rejects_non_list_messages(dummy_openai_model):
    # Passing a single dict (not inside a list) should raise ValueError about type
    msg = {"role": "user", "content": "Hello"}
    with pytest.raises(ValueError) as excinfo:
        dummy_openai_model(msg)
    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_rejects_missing_role_or_content(dummy_openai_model):
    # Passing a list with a dict missing role or content should raise ValueError
    bad_messages = [{"role": "user"}, {"content": "Hello"}]
    with pytest.raises(ValueError) as excinfo:
        dummy_openai_model(bad_messages)
    assert "must contain a 'role' and 'content'" in str(excinfo.value)[0m
