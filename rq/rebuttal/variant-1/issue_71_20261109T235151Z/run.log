[32mimport pytest
import types

from src.agentscope.models.openai_model import OpenAIChatWrapper


class DummyResponse:
    def __init__(self):
        self.text = "dummy response"
        self.raw = {"choices": [{"message": {"content": "dummy response"}}]}


@pytest.fixture
def dummy_openai_model(monkeypatch):
    # Create an instance of OpenAIChatWrapper with dummy config
    model = OpenAIChatWrapper(config_name="dummy-config")

    # Patch the internal client to avoid real API calls
    dummy_completions = types.SimpleNamespace(create=lambda *a, **k: DummyResponse())
    dummy_chat = types.SimpleNamespace(completions=dummy_completions)
    dummy_client = types.SimpleNamespace(chat=dummy_chat)
    monkeypatch.setattr(model, "_client", dummy_client)

    return model


def test_openai_model_accepts_list_of_messages(dummy_openai_model):
    # Provide a list of messages with role and content, should not raise error
    messages = [
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi, how can I help you?"},
    ]
    response = dummy_openai_model(messages)
    assert response.text == "dummy response"


def test_openai_model_accepts_single_msg_object(dummy_openai_model):
    # Provide a single message as dict, should raise ValueError about expecting list (after fix)
    single_message = {"role": "user", "content": "Hello single message"}
    with pytest.raises(ValueError) as e:
        dummy_openai_model(single_message)
    # The error message should mention expected type list
    assert "expected type `list`" in str(e.value)


def test_openai_model_rejects_non_list_messages(dummy_openai_model):
    # Pass an int instead of list or dict
    with pytest.raises(TypeError):
        dummy_openai_model(123)

    # Pass a list with missing keys in one message
    bad_messages = [{"role": "user", "content": "Hello"}, {"content": "missing role"}]
    with pytest.raises(ValueError) as e:
        dummy_openai_model(bad_messages)
    assert "must contain a 'role'" in str(e.value)[0m
