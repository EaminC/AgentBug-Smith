[32mimport pytest
from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg
from src.agentscope.models.model import ModelResponse


class DummyClientChatCompletions:
    def create(self, model, messages, **kwargs):
        # Return a dummy response object with a .model_dump() method
        class DummyResponse:
            def model_dump(self):
                return {
                    "id": "dummy_id",
                    "object": "chat.completion",
                    "created": 0,
                    "model": model,
                    "choices": [{"message": {"role": "assistant", "content": "dummy response"}}],
                    "usage": {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0},
                }
        return DummyResponse()


class DummyClient:
    def __init__(self):
        self.chat = self
        self.completions = DummyClientChatCompletions()


@pytest.fixture
def dummy_openai_model():
    # Create an OpenAIChatWrapper with a dummy client that returns a valid dummy response
    model = OpenAIChatWrapper(config_name="dummy_config")
    model.client = DummyClient()
    model.model_name = "dummy_model"
    model.generate_args = {}
    return model


def test_openai_model_accepts_list_of_messages(dummy_openai_model):
    # Pass a list of messages, each with role and content
    messages = [
        {"role": "user", "content": "Hello"},
        {"role": "assistant", "content": "Hi there!"},
    ]
    response = dummy_openai_model(messages)
    assert isinstance(response, ModelResponse)
    assert "dummy response" in response.text


def test_openai_model_accepts_single_msg_object(dummy_openai_model):
    # Pass a single Msg object inside a list (simulate user passing a single message dict)
    msg = Msg(name="user", role="user", content="Hello")
    response = dummy_openai_model([msg])
    assert isinstance(response, ModelResponse)
    assert "dummy response" in response.text


def test_openai_model_rejects_non_list_messages(dummy_openai_model):
    # Passing a single dict (not inside a list) should raise ValueError about type
    msg = {"role": "user", "content": "Hello"}
    with pytest.raises(ValueError) as excinfo:
        dummy_openai_model(msg)
    assert "expected type `list`" in str(excinfo.value)


def test_openai_model_rejects_missing_role_or_content(dummy_openai_model):
    # Passing a list with a dict missing role or content should raise ValueError about keys
    bad_messages = [{"role": "user"}, {"content": "Hello"}]
    with pytest.raises(ValueError) as excinfo:
        dummy_openai_model(bad_messages)
    assert "must contain a 'role' and 'content' key" in str(excinfo.value)[0m
