def test_openai_model_accepts_single_message_dict():
    """
    Test that OpenAIChatWrapper.__call__ accepts a single message dict (not a list)
    and raises the expected ValueError before the fix, and after the fix it raises
    a different error or passes the type check.
    """

    # Prepare a single message dict with 'role' and 'content'
    single_message = {"role": "user", "content": "Hello"}

    # Instantiate OpenAIChatWrapper with a dummy client to avoid real API calls
    model = OpenAIChatWrapper(model_name="gpt-3.5-turbo")
    # Inject dummy client to avoid network calls
    model.client = DummyOpenAIClient()

    # Before the fix, calling with a single dict should raise ValueError about missing role/content
    # After the fix, calling with a single dict should raise ValueError about type (not list)
    # So we test that the ValueError message contains the expected substring.

    with pytest.raises(ValueError) as excinfo:
        _ = model(single_message)

    # The error message should mention that messages must be a list (after fix),
    # or mention missing role/content (before fix).
    # We assert that the error message contains either substring.
    msg = str(excinfo.value)
    assert (
        "expected type `list`" in msg
        or "Each message in the 'messages' list must contain a 'role'" in msg
    )


