from src.agentscope.models.openai_model import OpenAIChatWrapper
from src.agentscope.message import Msg

# We will mock the internal OpenAI client call to avoid real API calls and errors.
# The test must exercise the real __call__ method of OpenAIChatWrapper,
# but patch the internal network call to always return a dummy response.

import openai
import types

class DummyResponse:
    def __init__(self):
        self.choices = [types.SimpleNamespace(message={"role": "assistant", "content": "dummy response"})]

class DummyOpenAIClient:
    def chat_completions_create(self, *args, **kwargs):
        # Return a dummy response object with .choices[0].message.content
        return DummyResponse()

@pytest.fixture
def openai_chat_wrapper(monkeypatch):
    # Create an instance of OpenAIChatWrapper with dummy config
    model = OpenAIChatWrapper(
        model_name="dummy-model",
        client_args=None,
        generate_args=None,
        budget=None,
    )
    # Patch the internal client to dummy client
    monkeypatch.setattr(model, "_client", types.SimpleNamespace(chat=comtypes := types.SimpleNamespace(completions=types.SimpleNamespace(create=lambda *a, **k: DummyResponse()))))
    # Patch the method that calls the client to use our dummy
    monkeypatch.setattr(model, "_client", types.SimpleNamespace(chat=types.SimpleNamespace(completions=types.SimpleNamespace(create=lambda *a, **k: DummyResponse()))))
    return model

def test_openai_model_accepts_list_of_messages(openai_chat_wrapper):
    # Should accept a list of dict messages with role and content keys
    messages = [{"role": "user", "content": "Hello"}]
    result = openai_chat_wrapper(messages)
    assert hasattr(result, "choices")
    assert result.choices[0].message["content"] == "dummy response"

def test_openai_model_rejects_single_message_dict_with_missing_type_check(openai_chat_wrapper):
    # Passing a single dict (not a list) should raise ValueError about type
    single_message = {"role": "user", "content": "Hello"}
    with pytest.raises(ValueError) as e:
        openai_chat_wrapper(single_message)
    assert "expected type `list`" in str(e.value)

def test_openai_model_rejects_single_message_msg_instance(openai_chat_wrapper):
    # Passing a single Msg instance (not a list) should raise ValueError about type
    single_msg = Msg(name="user", role="user", content="Hello")
    with pytest.raises(ValueError) as e:
        openai_chat_wrapper(single_msg)
    assert "expected type `list`" in str(e.value)

def test_openai_model_accepts_msg_list_with_msg_instances(openai_chat_wrapper):
    # Passing a list of Msg instances should be accepted and converted properly
    msg_list = [Msg(name="user", role="user", content="Hello")]
    # Convert Msg instances to dicts as the model expects dicts
    dict_list = [{"role": m.role, "content": m.content} for m in msg_list]
    result = openai_chat_wrapper(dict_list)
    assert hasattr(result, "choices")
    assert result.choices[0].message["content"] == "dummy response"[0m
