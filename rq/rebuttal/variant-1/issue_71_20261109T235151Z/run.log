[32m# Use official lightweight Python base image
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory inside the container
WORKDIR /app

# Upgrade pip and setuptools to latest stable versions
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Copy the entire repository into the container
COPY . .

# Install dependencies if requirements.txt exists
RUN if [ -f "requirements.txt" ]; then \
        pip install --no-cache-dir -r requirements.txt; \
    fi

# Install the project itself
RUN pip install --no-cache-dir -e .

# Install test dependencies (excluding pytest-block-network since it fails)
RUN pip install --no-cache-dir \
    pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout setuptools<=81.0.0 litellm pre-commit

# Set PYTHONPATH to allow imports from /app and /app/src
ENV PYTHONPATH=/app:/app/src

# Default command to keep container running in bash prompt
CMD ["/bin/bash"]
