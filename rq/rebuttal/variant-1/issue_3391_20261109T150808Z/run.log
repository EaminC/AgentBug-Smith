import pytest
from unittest.mock import MagicMock, patch

from crewai.memory.storage.mem0_storage import Mem0Storage


class DummyMemory:
    def __init__(self):
        self.add_calls = []
        self.search_calls = []

    def add(self, conversations, **kwargs):
        self.add_calls.append((conversations, kwargs))

    def search(self, **kwargs):
        self.search_calls.append(kwargs)
        return {"results": [{"score": 0.9, "memory": "Result 1"}, {"score": 0.4, "memory": "Result 2"}]}


@pytest.fixture
def dummy_mem0_storage():
    # Patch Memory and MemoryClient to DummyMemory to avoid import errors and external calls
    with patch("mem0.memory.main.Memory.from_config", return_value=DummyMemory()), \
         patch("mem0.memory.main.Memory.__new__", return_value=DummyMemory()), \
         patch("mem0.client.main.MemoryClient.__new__", return_value=DummyMemory()):
        crew = MagicMock()
        crew.agents = [MagicMock(role="AgentOne")]
        config = {
            "user_id": "user123",
            "run_id": "run123",
            "includes": "include",
            "excludes": "exclude",
            "infer": True,
            "agent_id": "agent-xyz",
        }
        mem0_storage = Mem0Storage(type="short_term", crew=crew, config=config)
        return mem0_storage


def test_save_with_long_metadata_trims_and_splits_messages(dummy_mem0_storage):
    # Compose a metadata with messages that would produce a combined metadata > 2000 chars if naive
    long_user_message = "User message: " + ("A" * 2100)
    long_assistant_message = "Final Answer: " + ("B" * 2100)

    messages = [
        {"role": "system", "content": "System prompt"},
        {"role": "user", "content": long_user_message},
        {"role": "assistant", "content": long_assistant_message},
    ]

    metadata = {
        "messages": messages,
        "description": "A test description that is irrelevant",
        "extra": "extra metadata",
    }

    # The value passed to save is ignored if messages present, but provide something anyway
    value = "This is a dummy value"

    dummy_mem0_storage.memory.add = MagicMock()

    dummy_mem0_storage.save(value, metadata.copy())

    # The call to add should contain conversations with user and assistant roles extracted and trimmed
    args, kwargs = dummy_mem0_storage.memory.add.call_args

    conversations = args[0]
    meta = kwargs.get("metadata", {})

    # Assert conversations is a list with two dicts: user and assistant roles
    assert isinstance(conversations, list)
    assert any(c.get("role") == "user" for c in conversations)
    assert any(c.get("role") == "assistant" for c in conversations)

    # The user content should be the trimmed user message without the "User message:" prefix
    user_content = next(c["content"] for c in conversations if c["role"] == "user")
    assert user_content == "A" * 2100

    # The assistant content should be the trimmed assistant message without the "Final Answer:" prefix
    assistant_content = next(c["content"] for c in conversations if c["role"] == "assistant")
    assert assistant_content == "B" * 2100

    # Metadata should include original keys except "messages" removed, and type added
    assert meta.get("type") == "short_term"
    assert "messages" not in meta
    assert meta.get("description") == "A test description that is irrelevant"
    assert meta.get("extra") == "extra metadata"

    # The agent_id param should be set from config
    assert kwargs.get("agent_id") == "agent-xyz"


def test_save_without_messages_uses_value_as_assistant(dummy_mem0_storage):
    metadata = {"some_key": "some_value"}
    value = "Assistant response text"

    dummy_mem0_storage.memory.add = MagicMock()

    dummy_mem0_storage.save(value, metadata.copy())

    args, kwargs = dummy_mem0_storage.memory.add.call_args
    conversations = args[0]

    # Should be a single assistant message with the value content
    assert conversations == [{"role": "assistant", "content": value}]

    meta = kwargs.get("metadata", {})
    assert meta.get("type") == "short_term"
    assert meta.get("some_key") == "some_value"


def test_save_with_multiple_agents_agent_id_length_limit(dummy_mem0_storage):
    # Setup crew with multiple agents with long role names to test agent_id truncation/sanitization
    dummy_mem0_storage.crew.agents = [
        MagicMock(role="AgentOneVeryLongRoleNameThatExceedsLimit"),
        MagicMock(role="AgentTwoVeryLongRoleNameThatExceedsLimit"),
        MagicMock(role="AgentThreeVeryLongRoleNameThatExceedsLimit"),
    ]

    metadata = {"messages": [
        {"role": "user", "content": "User message: Hello"},
        {"role": "assistant", "content": "Final Answer: Hi there"},
    ]}

    dummy_mem0_storage.memory.add = MagicMock()

    dummy_mem0_storage.save("ignored value", metadata.copy())

    args, kwargs = dummy_mem0_storage.memory.add.call_args
    agent_id = kwargs.get("agent_id", "")

    # Agent id should be a sanitized string and not exceed 255 chars
    assert isinstance(agent_id, str)
    assert len(agent_id) <= 255
    # Should contain parts of all agent roles joined by underscore sanitized
    for agent in dummy_mem0_storage.crew.agents:
        sanitized_role = agent.role.replace(" ", "_")
        assert any(part in agent_id for part in sanitized_role.split("_"))


def test_search_returns_expected_results(dummy_mem0_storage):
    dummy_mem0_storage.memory.search = MagicMock(return_value={
        "results": [
            {"score": 0.95, "memory": "Memory 1"},
            {"score": 0.5, "memory": "Memory 2"},
            {"score": 0.3, "memory": "Memory 3"},
        ]
    })

    results = dummy_mem0_storage.search("query text", limit=2, score_threshold=0.4)

    dummy_mem0_storage.memory.search.assert_called_once()

    # Results should be filtered by threshold and limited
    assert len(results) == 3  # The method returns all results, filtering is external
    assert results[0]["context"] == "Memory 1"
    assert results[1]["context"] == "Memory 2"


def test_save_and_search_with_agent_id_and_user_id():
    # Patch Memory to DummyMemory to avoid import error
    with patch("mem0.memory.main.Memory.__new__", return_value=DummyMemory()):
        config = {
            "agent_id": "agent-123",
            "user_id": "user-456",
        }
        mem0_storage = Mem0Storage(type="external", config=config)

        mem0_storage.memory.add = MagicMock()
        mem0_storage.memory.search = MagicMock(return_value={
            "results": [{"score": 0.9, "memory": "Result 1"}]
        })

        # Save with messages
        messages = [
            {"role": "user", "content": "User message: Hello world"},
            {"role": "assistant", "content": "Final Answer: Hi user"},
        ]
        mem0_storage.save("ignored", {"messages": messages})

        # Check add called with user and assistant messages extracted
        args, kwargs = mem0_storage.memory.add.call_args
        conversations = args[0]
        assert any(c["role"] == "user" and c["content"] == "Hello world" for c in conversations)
        assert any(c["role"] == "assistant" and c["content"] == "Hi user" for c in conversations)

        # Search call should include filters with OR user_id and agent_id
        results = mem0_storage.search("query", limit=1, score_threshold=0.5)
        mem0_storage.memory.search.assert_called_once()
        called_kwargs = mem0_storage.memory.search.call_args[1]
        filters = called_kwargs.get("filters", {})
        assert "OR" in filters
        or_filters = filters["OR"]
        assert {"user_id": "user-456"} in or_filters
        assert {"agent_id": "agent-123"} in or_filters

        # Results returned correctly
        assert len(results) == 1
        assert results[0]["context"] == "Result 1"
