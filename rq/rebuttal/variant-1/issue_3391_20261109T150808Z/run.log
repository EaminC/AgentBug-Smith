from unittest.mock import MagicMock, patch
import pytest

from crewai.memory.storage.mem0_storage import Mem0Storage


class MockCrew:
    def __init__(self):
        self.agents = [MagicMock(role="Test Agent")]


@pytest.fixture
def mem0_storage_with_mocked_memory():
    mock_memory = MagicMock()
    crew = MockCrew()
    config = {
        "user_id": "test_user",
        "run_id": "run123",
        "includes": "include1",
        "excludes": "exclude1",
        "infer": True,
    }
    with patch("mem0.memory.main.Memory.from_config", return_value=mock_memory):
        mem0_storage = Mem0Storage(type="short_term", crew=crew, config=config)
    return mem0_storage, mock_memory


def test_save_with_large_metadata_and_messages(mem0_storage_with_mocked_memory):
    """
    Regression test for issue #3391:
    When saving memory with external memory and Mem0, metadata length can exceed 2000 characters
    due to including assistant, user, and system prompts in metadata.

    This test ensures that the save method correctly extracts user and assistant messages
    and sends a trimmed conversation list to memory.add without exceeding metadata limits.

    The test fails on buggy code (which sends all messages in metadata causing length breach)
    and passes after the fix which extracts and sends only relevant messages.
    """
    mem0_storage, mock_memory = mem0_storage_with_mocked_memory

    # Construct a large metadata with messages that would exceed 2000 characters if sent fully
    system_prompt = (
        "You are Friendly chatbot assistant. You are a kind and knowledgeable chatbot assistant. "
        "You excel at understanding user needs, providing helpful responses, and maintaining engaging conversations. "
        "You remember previous interactions to provide a personalized experience.\n"
        "Your personal goal is: Engage in useful and interesting conversations with users while remembering context.\n"
        "To give my best complete final answer to the task respond using the exact following format:\n"
        "\nThought: I now can give a great answer\nFinal Answer: Your final answer must be the great and the most complete as possible, it must be outcome described.\n"
        "\nI MUST use these formats, my job depends on it!"
    )
    user_message_content = (
        "\nCurrent Task: Respond to user conversation. User message: What do you know about me?\n\n"
        "This is the expected criteria for your final answer: Contextually appropriate, helpful, and friendly response.\n"
        "you MUST return the actual complete content as the final answer, not a summary.\n"
        "\n# Useful context: \nExternal memories:\n- User is from India\n- User is interested in the solar system\n"
        "- User name is Vidit Ostwal\n- User is interested in French cuisine\n\n"
        "Begin! This is VERY important to you, use the tools available and give your best Final Answer, your job depends on it!\n\nThought:"
    )
    assistant_message_content = (
        "I now can give a great answer  \nFinal Answer: Hi Vidit! From our previous conversations, I know you're from India and have a great interest in the solar system. "
        "It's fascinating to explore the wonders of space, isn't it? Also, I remember you have a passion for French cuisine, which has so many delightful dishes to explore. "
        "If there's anything specific you'd like to discuss or learn about—whether it's about the solar system or some great French recipes—feel free to let me know! I'm here to help."
    )

    # Compose messages list as would be in metadata
    messages = [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": user_message_content},
        {"role": "assistant", "content": assistant_message_content},
    ]

    # Compose metadata with a large description and messages
    metadata = {
        "description": "Respond to user conversation. User message: What do you know about me?",
        "messages": messages,
        "agent": "Friendly chatbot assistant",
    }

    # Call save with a dummy value and the large metadata
    mem0_storage.save("dummy response", metadata)

    # The expected calls to memory.add should contain only the extracted user and assistant messages,
    # not the entire messages or system prompt in metadata.
    expected_conversations = [
        {"role": "user", "content": "What do you know about me?"},
        {"role": "assistant", "content": assistant_message_content},
    ]

    # The metadata passed to memory.add should include the original metadata keys except messages,
    # plus the "type" key with memory type.
    expected_metadata = {
        "type": "short_term",
        "description": "Respond to user conversation. User message: What do you know about me?",
        "agent": "Friendly chatbot assistant",
    }

    # Assert memory.add was called once with expected trimmed conversations and metadata
    mock_memory.add.assert_called_once()
    call_args = mock_memory.add.call_args
    actual_conversations = call_args[0][0]
    actual_kwargs = call_args[1]

    assert actual_conversations == expected_conversations, "Conversations passed to memory.add are not trimmed correctly"
    assert actual_kwargs.get("metadata") == expected_metadata, "Metadata passed to memory.add includes unexpected keys or messages"
    assert actual_kwargs.get("infer") is True
    assert actual_kwargs.get("run_id") == "run123"
    assert actual_kwargs.get("user_id") == "test_user"
    assert actual_kwargs.get("agent_id") == "Test_Agent"
