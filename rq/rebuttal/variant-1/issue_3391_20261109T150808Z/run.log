            "includes": "includeX",
            "excludes": "excludeY",
            "infer": True,
        }
        mem0_storage = Mem0Storage(type="short_term", crew=crew, config=embedder_config)
        mem0_storage.memory = dummy_memory
        return mem0_storage, dummy_memory


def test_save_with_large_metadata_does_not_fail_and_truncates(monkeypatch, mem0_storage_with_dummy_memory):
    mem0_storage, dummy_memory = mem0_storage_with_dummy_memory

    # Compose a very large user message and assistant message to exceed 2000 chars
    large_user_message = "User message: " + ("A" * 2100)
    large_assistant_message = "Final Answer: " + ("B" * 2100)

    # Compose messages list as metadata simulating conversation
    messages = [
        {"role": "system", "content": "System prompt"},
        {"role": "user", "content": large_user_message},
        {"role": "assistant", "content": large_assistant_message},
    ]

    metadata = {
        "description": "Test large metadata",
        "messages": messages,
        "agent": "TestAgent",
    }

    # The value param is ignored if messages are present, but provide anyway
    value = "Dummy assistant response"

    # Call save, should not raise and should call memory.add with truncated content
    mem0_storage.save(value, metadata)

    # There should be exactly one add call
    assert len(dummy_memory.add_calls) == 1

    conversations, params = dummy_memory.add_calls[0]

    # Conversations should be a list of dicts with roles user and assistant
    roles = [msg.get("role") for msg in conversations]
    assert "user" in roles
    assert "assistant" in roles

    # The user content should be truncated to not exceed 2000 chars (or at least not full 2100)
    user_content = next(msg["content"] for msg in conversations if msg["role"] == "user")
    assistant_content = next(msg["content"] for msg in conversations if msg["role"] == "assistant")

    # The user content should be the large_user_message content but truncated or cleaned
    # The buggy code would send full content causing failure, fixed code truncates or cleans
    # So assert user content length is <= 2000
    assert len(user_content) <= 2000

    # The assistant content should be the text after "Final Answer:" marker, truncated or cleaned
    # So it should start with B's and length <= 2000
    assert assistant_content.startswith("B")
    assert len(assistant_content) <= 2000

    # Metadata passed to add should include type short_term and agent
    assert params.get("metadata", {}).get("type") == "short_term"
    assert params.get("agent_id") == "AgentA_AgentB" or params.get("agent_id") == "TestAgent" or params.get("agent_id") is not None

    # The run_id and user_id should be passed correctly
    assert params.get("run_id") == "run123"
    assert params.get("user_id") == "test_user"

    # The infer flag should be True
    assert params.get("infer") is True

def test_save_without_messages_uses_value_directly(mem0_storage_with_dummy_memory):
    mem0_storage, dummy_memory = mem0_storage_with_dummy_memory

    metadata = {"some_key": "some_value"}
    value = "Assistant direct message"

    mem0_storage.save(value, metadata)

    assert len(dummy_memory.add_calls) == 1
    conversations, params = dummy_memory.add_calls[0]

    # Should have one conversation with role assistant and content equal to value
    assert conversations == [{"role": "assistant", "content": value}]

    # Metadata should include the original keys plus type short_term
    assert params.get("metadata", {}).get("type") == "short_term"
    assert params.get("metadata", {}).get("some_key") == "some_value"

def test_get_user_and_assistant_message_parsing(monkeypatch):
    # Create a Mem0Storage instance with minimal config
    mem0_storage = Mem0Storage(type="short_term", config={})

    # Test _get_user_message extracts after "User message:"
    user_text = "User message: Hello user!"
    extracted_user = mem0_storage._get_user_message(user_text)
    assert extracted_user == "Hello user!"

    # If no "User message:" prefix, returns original
    plain_text = "Just some text"
    assert mem0_storage._get_user_message(plain_text) == plain_text

    # Test _get_assistant_message extracts after "Final Answer:"
    assistant_text = "Some intro\nFinal Answer: This is the final answer."
    extracted_assistant = mem0_storage._get_assistant_message(assistant_text)
    assert extracted_assistant == "This is the final answer."

    # If no "Final Answer:" marker, returns original
    plain_assistant = "No marker here"
    assert mem0_storage._get_assistant_message(plain_assistant) == plain_assistant
