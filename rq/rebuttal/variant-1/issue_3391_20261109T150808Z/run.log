import pytest
from unittest.mock import MagicMock, patch
from crewai.memory.storage.mem0_storage import Mem0Storage


class DummyMemory:
    def __init__(self):
        self.add_calls = []
    def add(self, conversations, **kwargs):
        self.add_calls.append((conversations, kwargs))


@pytest.fixture
def mem0_storage_with_dummy_memory():
    # Patch Memory to use DummyMemory to avoid import errors and real network calls
    with patch("mem0.memory.main.Memory.from_config") as mock_from_config, \
         patch("mem0.memory.main.Memory.__init__", lambda self, *args, **kwargs: None), \
         patch("mem0.memory.main.Memory.add", new=DummyMemory.add):
        dummy_mem = DummyMemory()
        # Patch the instance returned by from_config to dummy_mem
        mock_from_config.return_value = dummy_mem
        # Create Mem0Storage instance with config that triggers the bug scenario
        config = {
            "user_id": "test_user",
            "run_id": "test_run",
        }
        mem0_storage = Mem0Storage(type="short_term", config=config)
        # Override the memory attribute to dummy_mem to capture calls
        mem0_storage.memory = dummy_mem
        yield mem0_storage, dummy_mem


def test_save_handles_long_metadata_without_failure(mem0_storage_with_dummy_memory):
    mem0_storage, dummy_mem = mem0_storage_with_dummy_memory

    # Create a very long user and assistant message to simulate metadata > 2000 chars
    long_user_message = "User message: " + "A" * 2100
    long_assistant_message = "Final Answer: " + "B" * 2100

    # Compose messages list as would be in metadata
    messages = [
        {"role": "system", "content": "System prompt"},
        {"role": "user", "content": long_user_message},
        {"role": "assistant", "content": long_assistant_message},
    ]

    metadata = {
        "messages": messages,
        "description": "Test with very long messages to exceed 2000 chars",
        "agent": "TestAgent"
    }

    # The value param is ignored when messages exist, but provide one anyway
    value = "dummy value"

    # Call save - should not raise and should call memory.add with trimmed messages
    mem0_storage.save(value, metadata)

    # There should be exactly one call to add
    assert len(dummy_mem.add_calls) == 1

    conversations, params = dummy_mem.add_calls[0]

    # conversations should be a list of dicts with roles 'user' and 'assistant'
    roles = [msg["role"] for msg in conversations]
    assert "user" in roles
    assert "assistant" in roles

    # The user content should be the trimmed user message without the prefix "User message: "
    user_msg = next(msg["content"] for msg in conversations if msg["role"] == "user")
    assert user_msg == "A" * 2100

    # The assistant content should be the trimmed assistant message without the prefix "Final Answer:"
    assistant_msg = next(msg["content"] for msg in conversations if msg["role"] == "assistant")
    assert assistant_msg == "B" * 2100

    # Metadata passed to add should include type "short_term" and description and agent keys
    assert params.get("metadata", {}).get("type") == "short_term"
    assert "description" in params.get("metadata", {})
    assert params.get("metadata", {}).get("agent") == "TestAgent"

    # The run_id and user_id should be passed correctly
    assert params.get("run_id") == "test_run"
    assert params.get("user_id") == "test_user"


def test_save_without_messages_uses_value_as_assistant_message(mem0_storage_with_dummy_memory):
    mem0_storage, dummy_mem = mem0_storage_with_dummy_memory

    metadata = {"some_key": "some_value"}
    value = "Assistant response content"

    mem0_storage.save(value, metadata)

    assert len(dummy_mem.add_calls) >= 1
    conversations, params = dummy_mem.add_calls[-1]

    # Should only have one message with role assistant and content equal to value
    assert len(conversations) == 1
    assert conversations[0]["role"] == "assistant"
    assert conversations[0]["content"] == value

    # Metadata should include type
    assert params.get("metadata", {}).get("type") == "short_term"


def test_save_with_messages_and_no_special_prefixes(mem0_storage_with_dummy_memory):
    mem0_storage, dummy_mem = mem0_storage_with_dummy_memory

    messages = [
        {"role": "user", "content": "Hello there"},
        {"role": "assistant", "content": "Hi! How can I help?"},
    ]

    metadata = {
        "messages": messages,
        "agent": "AgentX"
    }

    mem0_storage.save("ignored value", metadata)

    assert len(dummy_mem.add_calls) >= 1
    conversations, params = dummy_mem.add_calls[-1]

    # The user message should be exactly "Hello there"
    user_msg = next(msg["content"] for msg in conversations if msg["role"] == "user")
    assert user_msg == "Hello there"

    # The assistant message should be exactly "Hi! How can I help?"
    assistant_msg = next(msg["content"] for msg in conversations if msg["role"] == "assistant")
    assert assistant_msg == "Hi! How can I help?"

    # Metadata should include type and agent
    assert params.get("metadata", {}).get("type") == "short_term"
    assert params.get("metadata", {}).get("agent") == "AgentX"
