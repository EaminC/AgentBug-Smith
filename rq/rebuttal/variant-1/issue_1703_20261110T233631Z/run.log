from crewai.agent import Agent
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.task import Task
from crewai.utilities.planning_handler import CrewPlanner


def test_agent_knowledge_included_in_planning_summary():
    """
    Test that agent knowledge is included in the planning summary generated by CrewPlanner.

    This test will fail on the buggy codebase where knowledge is not included,
    and pass after the fix that includes knowledge in the planning process.
    """
    # Create an agent with knowledge sources
    knowledge_content = "Critical knowledge for planning: Always validate inputs."
    knowledge_source = StringKnowledgeSource(content=knowledge_content)
    agent = Agent(
        role="Planner Agent",
        goal="Plan tasks effectively",
        backstory="Experienced planner",
        knowledge_sources=[knowledge_source],
    )

    # Create a task assigned to this agent
    task = Task(
        description="Plan the execution of tasks",
        expected_output="Detailed step-by-step plan",
        agent=agent,
        tools=[],
    )

    # Create CrewPlanner with the single task
    planner = CrewPlanner(tasks=[task], planning_agent_llm=None)

    # Generate the tasks summary which should include the knowledge content
    tasks_summary = planner._create_tasks_summary()

    # Assert that the knowledge content is included in the tasks summary string
    assert knowledge_content in tasks_summary, (
        "Agent knowledge content should be included in the tasks summary for planning."
    )

    # Also assert that the agent role and task description are included as sanity checks
    assert agent.role in tasks_summary, "Agent role should be included in tasks summary."
    assert task.description in tasks_summary, "Task description should be included in tasks summary."[0m
