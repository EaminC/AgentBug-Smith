[32mimport pytest

from crewai.agent import Agent
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.task import Task
from crewai.utilities.planning_handler import CrewPlanner


@pytest.mark.parametrize("knowledge_content", [
    "Critical knowledge for planning",
    "AI systems require careful training and validation.",
])
def test_agent_knowledge_included_in_planning_summary(knowledge_content):
    """
    Test that verifies knowledge sources are properly included in the planning summary.
    This test should fail on the buggy codebase where knowledge is not included,
    and pass after the fix that includes knowledge in the planning summary.
    """
    # Create an agent with knowledge
    agent = Agent(
        role="Planner Agent",
        goal="Plan tasks effectively",
        backstory="Experienced planner",
        knowledge_sources=[StringKnowledgeSource(content=knowledge_content)],
    )

    # Create a task assigned to this agent
    task = Task(
        description="Plan the execution of tasks",
        expected_output="A detailed plan",
        agent=agent,
    )

    # Create the crew planner with this single task
    planner = CrewPlanner(tasks=[task], planning_agent_llm=None)

    # Generate the tasks summary which should include knowledge content
    tasks_summary = planner._create_tasks_summary()

    # Assert that the knowledge content is included in the summary string
    assert knowledge_content in tasks_summary, (
        "Agent knowledge content should be included in the tasks summary for planning."
    )
    # Also assert that the agent role is included (sanity check)
    assert agent.role in tasks_summary, "Agent role should be included in the tasks summary."
    # Assert that the task description is included
    assert task.description in tasks_summary, "Task description should be included in the tasks summary."[0m
