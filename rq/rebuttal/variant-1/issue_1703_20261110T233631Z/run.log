[32mimport pytest
from crewai.agent import Agent
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.task import Task
from crewai.utilities.planning_handler import CrewPlanner


@pytest.mark.parametrize(
    "knowledge_content",
    [
        "Critical knowledge for planning",
        "AI systems require careful training and validation.",
    ],
)
def test_agent_knowledge_included_in_planning_summary(knowledge_content):
    """
    Test that agent knowledge sources are included in the planning task summary.

    This test will fail on the buggy codebase where knowledge is not included,
    and pass after the fix where knowledge is properly included in the planning summary.
    """
    # Create an agent with knowledge source
    agent = Agent(
        role="Planner Agent",
        goal="Plan tasks with knowledge",
        backstory="Experienced planner",
        knowledge_sources=[StringKnowledgeSource(content=knowledge_content)],
    )

    # Create a task assigned to the agent
    task = Task(
        description="Plan a complex task",
        expected_output="Detailed plan",
        agent=agent,
    )

    # Create CrewPlanner with the task
    planner = CrewPlanner(tasks=[task], planning_agent_llm=None)

    # Generate the tasks summary which should include knowledge content
    summary = planner._create_tasks_summary()

    # Assert knowledge content is included in the summary string
    assert knowledge_content in summary, "Knowledge content should be included in planning summary"

    # Assert the summary contains the agent_knowledge field indicating knowledge inclusion
    assert '"agent_knowledge"' in summary, "agent_knowledge field should be present in planning summary"

    # Also ensure other task and agent details are present
    assert task.description in summary, "Task description should be present in planning summary"
    assert task.expected_output in summary, "Expected output should be present in planning summary"
    assert agent.role in summary, "Agent role should be present in planning summary"[0m
