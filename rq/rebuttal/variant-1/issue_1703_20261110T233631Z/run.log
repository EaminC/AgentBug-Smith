[32mimport pytest

from crewai.agent import Agent
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.task import Task
from crewai.utilities.planning_handler import CrewPlanner


@pytest.mark.parametrize(
    "knowledge_content",
    [
        "Critical knowledge for planning",
        "AI systems require careful training and validation.",
    ],
)
def test_agent_knowledge_included_in_planning_summary(knowledge_content):
    """
    Test that verifies knowledge sources are properly included in the planning task summary.
    This test fails on the buggy codebase where knowledge is not included,
    and passes after the fix which includes knowledge in the planning summary.
    """
    # Create an agent with a knowledge source containing the test knowledge_content
    agent = Agent(
        role="Planner Agent",
        goal="Plan tasks with knowledge",
        backstory="Experienced planner",
        knowledge_sources=[StringKnowledgeSource(content=knowledge_content)],
    )

    # Create a task assigned to this agent
    task = Task(
        description="Plan task with knowledge",
        expected_output="Detailed plan including knowledge",
        agent=agent,
    )

    # Create a CrewPlanner with this single task
    planner = CrewPlanner(tasks=[task], planning_agent_llm=None)

    # Generate the tasks summary which should include knowledge content
    tasks_summary = planner._create_tasks_summary()

    # Assert that the knowledge content is included in the summary string
    assert knowledge_content in tasks_summary, (
        "Knowledge content must be included in the planning task summary."
    )

    # Assert that the 'agent_knowledge' field is present in the summary string
    assert '"agent_knowledge"' in tasks_summary, (
        "The 'agent_knowledge' field must be present in the planning task summary."
    )

    # Also verify that other expected fields are present to ensure summary integrity
    assert task.description in tasks_summary, "Task description must be present in summary."
    assert task.expected_output in tasks_summary, "Expected output must be present in summary."
    assert agent.role in tasks_summary, "Agent role must be present in summary."[0m
