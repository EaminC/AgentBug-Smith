[32mimport pytest
from crewai.agent import Agent
from crewai.knowledge.source.string_knowledge_source import StringKnowledgeSource
from crewai.task import Task
from crewai.utilities.planning_handler import CrewPlanner


@pytest.mark.usefixtures("monkeypatch")
def test_agent_knowledge_included_in_planning_summary():
    """
    Test that agent knowledge sources are included in the planning summary.
    This test should fail on the buggy codebase where knowledge is not included,
    and pass after the fix which includes knowledge in the planning process.
    """
    # Create an agent with knowledge sources
    knowledge_content = "Critical knowledge for planning"
    knowledge_source = StringKnowledgeSource(content=knowledge_content)
    agent = Agent(
        role="Planner Agent",
        goal="Plan using all available knowledge",
        backstory="Experienced planner",
        knowledge_sources=[knowledge_source],
    )

    # Create a task assigned to the agent
    task = Task(
        description="Plan a complex project",
        expected_output="Detailed step-by-step plan",
        agent=agent,
    )

    # Create a CrewPlanner with the task
    planner = CrewPlanner(tasks=[task], planning_agent_llm=None)

    # Generate the tasks summary which should include knowledge content
    tasks_summary = planner._create_tasks_summary()

    # Assert that the knowledge content is included in the summary string
    # This assertion will fail on the buggy codebase because knowledge is omitted
    assert knowledge_content in tasks_summary, (
        "Agent knowledge content should be included in the tasks summary for planning"
    )

    # Also assert that the knowledge field label is present in the summary
    assert '"agent_knowledge"' in tasks_summary, (
        "The tasks summary should include the 'agent_knowledge' field when knowledge is present"
    )[0m
