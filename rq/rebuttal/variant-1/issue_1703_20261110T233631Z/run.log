# --- end inject ---

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set working directory to the repository root
WORKDIR /app

# Upgrade pip and install system dependencies needed for Python packages
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && python -m pip install --upgrade pip setuptools wheel \
    # Install dependencies if requirements.txt exists, else fallback to pip install -e .
    && if [ -f "requirements.txt" ]; then pip install -r requirements.txt; fi \
    # Install the repo itself editable for local development
    && pip install -e . \
    # Install additional required testing dependencies
    && pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm \
    # Clean apt cache to reduce image size
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set PYTHONPATH to include the src/ directory
ENV PYTHONPATH=/app:/app/src

# Default command to keep container running with bash shell
CMD ["/bin/bash"]

