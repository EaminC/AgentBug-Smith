FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-MGE50a9855d8f050b491afda3c14c715cf0e"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-MGE50a9855d8f050b491afda3c14c715cf0e"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-MGE50a9855d8f050b491afda3c14c715cf0e"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory inside container
WORKDIR /app

# Set environment variables for Forge API compatibility (OpenAI and Anthropic)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-MGE50a9855d8f050b491afda3c14c715cf0e \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-MGE50a9855d8f050b491afda3c14c715cf0e \
    FORGE_API_KEY=forge-MGE50a9855d8f050b491afda3c14c715cf0e \
    FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Install system dependencies required for building and compiling Python extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        libffi-dev \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools and wheel safely
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repo contents
COPY . .

# Install Python dependencies and the project itself
# Use requirements.txt if exists, else install only the project and test deps
RUN if [ -f requirements.txt ]; then \
        pip install --no-cache-dir -r requirements.txt; \
    fi && \
    pip install --no-cache-dir -e . && \
    pip install --no-cache-dir pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm

# Set PYTHONPATH to repo root (no src/ folder detected)
ENV PYTHONPATH=/app

# Default command to keep container open in bash shell, required for test harness
CMD ["/bin/bash"]

