[32mimport os
import pytest
from gpt_engineer.core.ai import AI


def test_azure_deployment_name_handling(monkeypatch):
    """
    This test verifies that when using Azure OpenAI with a deployment name,
    the model initialization uses the correct API version and deployment_name
    without mixing deployment name and model name, avoiding model-not-found errors.
    """

    # Setup environment variables to simulate Azure usage
    monkeypatch.setenv("OPENAI_API_VERSION", "2024-05-01-preview")

    # Create AI instance with azure_endpoint and a deployment_name as model_name
    azure_endpoint = "https://fake-azure-endpoint.openai.azure.com/"
    deployment_name = "my-azure-deployment"

    ai = AI(
        model_name=deployment_name,
        azure_endpoint=azure_endpoint,
        streaming=False,
    )

    # The internal _create_chat_model method should create an AzureChatOpenAI
    # with the correct openai_api_version and deployment_name matching the deployment_name
    chat_model = ai._create_chat_model()

    # The model_name should be used as deployment_name, not as model name
    # The openai_api_version should be "2024-05-01-preview" as per the fix
    # We check attributes on the chat_model to confirm correct setup

    # The class AzureChatOpenAI is from langchain.chat_models.azure_chat_openai
    # It has attributes: azure_endpoint, openai_api_version, deployment_name, openai_api_type, streaming

    # Check that the deployment_name is set correctly
    assert hasattr(chat_model, "deployment_name")
    assert chat_model.deployment_name == deployment_name

    # Check that the openai_api_version is the fixed one
    assert hasattr(chat_model, "openai_api_version")
    assert chat_model.openai_api_version == "2024-05-01-preview"

    # Check that the azure_endpoint is set correctly
    assert hasattr(chat_model, "azure_endpoint")
    assert chat_model.azure_endpoint == azure_endpoint

    # Check that the openai_api_type is "azure"
    assert hasattr(chat_model, "openai_api_type")
    assert chat_model.openai_api_type == "azure"

    # Check that streaming is False as set
    assert hasattr(chat_model, "streaming")
    assert chat_model.streaming is False

    # Finally, check that the model_name attribute of AI is still the deployment_name string
    assert ai.model_name == deployment_name


@pytest.mark.parametrize(
    "openai_api_version_env,expected_version",
    [
        ("2023-05-15", "2024-05-01-preview"),  # buggy version fallback replaced by fixed
        ("2024-05-01-preview", "2024-05-01-preview"),
        ("", "2024-05-01-preview"),
    ],
)
def test_openai_api_version_env(monkeypatch, openai_api_version_env, expected_version):
    """
    Test that the openai_api_version used in AzureChatOpenAI is always the fixed
    '2024-05-01-preview' regardless of environment variable fallback.
    """

    if openai_api_version_env:
        monkeypatch.setenv("OPENAI_API_VERSION", openai_api_version_env)
    else:
        monkeypatch.delenv("OPENAI_API_VERSION", raising=False)

    ai = AI(
        model_name="deployment",
        azure_endpoint="https://fake-azure-endpoint.openai.azure.com/",
        streaming=False,
    )
    chat_model = ai._create_chat_model()

    assert chat_model.openai_api_version == expected_version
    assert chat_model.deployment_name == "deployment"
    assert chat_model.azure_endpoint == "https://fake-azure-endpoint.openai.azure.com/"
    assert chat_model.openai_api_type == "azure"


def test_non_azure_model_creation():
    """
    Test that when no azure_endpoint is given, AI creates a non-Azure chat model
    and does not raise errors related to deployment_name or model_name confusion.
    """

    ai = AI(
        model_name="gpt-4",
        azure_endpoint=None,
        streaming=False,
    )
    chat_model = ai._create_chat_model()

    # The chat_model should not have azure specific attributes
    # It should have attribute model_name equal to "gpt-4"
    assert hasattr(chat_model, "model_name")
    assert chat_model.model_name == "gpt-4"


