# Set working directory inside the container
WORKDIR /app

# Set environment variables for Forge API compatibility with OpenAI and Anthropic SDKs
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-MGE50a9855d8f050b491afda3c14c715cf0e
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-MGE50a9855d8f050b491afda3c14c715cf0e

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies (if needed for compiling Python packages or runtime)
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libffi-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository into the container
COPY . .

# Install Python dependencies based on presence of lock/requirements files
# Priority: requirements.txt > poetry.lock (install poetry) > pyproject.toml only

RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt && pip install -e . && \
        pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm; \
    elif [ -f "poetry.lock" ]; then \
        pip install poetry && poetry config virtualenvs.create false && poetry install && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm; \
    elif [ -f "pyproject.toml" ]; then \
        pip install -e . && \
        pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm; \
    else \
        pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm; \
    fi

# Set PYTHONPATH for correct module imports
ENV PYTHONPATH=/app

# Default command to keep container open in bash shell
CMD ["/bin/bash"]

