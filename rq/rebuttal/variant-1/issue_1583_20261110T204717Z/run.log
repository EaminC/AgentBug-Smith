RUN if [ -f requirements.txt ]; then \
    pip install --no-cache-dir -r requirements.txt; \
    fi && pip install --no-cache-dir -e . && pip install --no-cache-dir \
    pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout pytest-block-network 'setuptools<=81.0.0'

# Set PYTHONPATH assuming no src/ layout
ENV PYTHONPATH=/app

# Verify installation sanity
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command to open bash shell
CMD ["/bin/bash"]

