# Install testing dependencies excluding problematic litellm version
RUN pip install --no-cache-dir pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network setuptools<=81.0.0

# Set PYTHONPATH for application
ENV PYTHONPATH=/app

# Default command
CMD ["/bin/bash"]

