# Upgrade pip, setuptools and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies from requirements.txt if present + repository + test dependencies
RUN if [ -f requirements.txt ]; then \
    pip install --no-cache-dir -r requirements.txt; \
    fi && \
    pip install --no-cache-dir -e . && \
    pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout pytest-block-network 'setuptools<=81.0.0' litellm

# Set PYTHONPATH assuming no src/ layout
ENV PYTHONPATH=/app

# Verify installation sanity
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command to open bash shell
CMD ["/bin/bash"]

