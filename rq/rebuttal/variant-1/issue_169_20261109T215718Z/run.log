import textwrap

from gpt_engineer.chat_to_files import to_files


def test_file_names_with_backticks_and_square_brackets():
    # Input chat with filenames enclosed in backticks and square brackets
    chat = textwrap.dedent(
        """
    This is a sample program.

    `file1.py`
    ```python
    print("Hello, World!")
    ```

    [file2.py]
    ```python
    def add(a, b):
        return a + b
    ```

    `file3.py`
    ```python
    def sub(a, b):
        return a - b
    ```
    """
    )
    workspace = {}
    to_files(chat, workspace)

    # The all_output.txt should contain the full chat
    assert workspace["all_output.txt"] == chat

    # The filenames should be normalized without backticks or square brackets
    expected_files = {
        "file1.py": 'print("Hello, World!")\n',
        "file2.py": "def add(a, b):\n    return a + b\n",
        "file3.py": "def sub(a, b):\n    return a - b\n",
        "README.md": "\nThis is a sample program.\n\n`file1.py`\n",
    }

    for file_name, file_content in expected_files.items():
        assert workspace[file_name] == file_content
