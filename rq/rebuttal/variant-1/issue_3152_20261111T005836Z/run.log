import pytest
from crewai import Crew, Agent, Task, Process, LLM
from crewai.memory.external.external_memory import ExternalMemory


@pytest.fixture(autouse=True)
def patch_env_vars(monkeypatch):
    # Patch environment variables for MEM0 and Azure OpenAI keys and config
    monkeypatch.setenv("MEM0_API_KEY", "dummy_mem0_api_key")
    monkeypatch.setenv("MEM0_ORG_ID", "dummy_org_id")
    monkeypatch.setenv("MEM0_PROJECT_ID", "dummy_project_id")
    monkeypatch.setenv("OPENAI_API_KEY", "dummy_openai_api_key")
    monkeypatch.setenv("AZURE_OPENAI_API_BASE", "https://dummy.openai.azure.com/")
    yield


def test_external_memory_save_with_mem0():
    """
    This test verifies that ExternalMemory configured with mem0 provider
    correctly saves memory without raising errors.

    It uses dummy API keys and mocks the internal network call by patching
    the internal client add method indirectly by invoking the real save method.

    The test fails on the buggy codebase due to incorrect parameter type sent to mem0 API,
    and passes after the fix that wraps the saved value in assistant message format.
    """

    # Create an agent with minimal config
    chat_agent = Agent(
        role="Friendly chatbot assistant",
        goal="Engage in useful and interesting conversations with users while remembering context.",
        backstory="You are a kind and knowledgeable chatbot assistant.",
        llm=LLM("azure/gpt-4.1"),
        verbose=False,
    )

    # Create a task that uses the agent
    chat_task = Task(
        description="Respond to user conversation. User message: {user_msg}",
        expected_output="Contextually appropriate, helpful, and friendly response.",
        agent=chat_agent,
    )

    # Configure ExternalMemory with mem0 provider and dummy config
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {
                "user_id": "user-123",
                "org_id": os.getenv("MEM0_ORG_ID"),
                "project_id": os.getenv("MEM0_PROJECT_ID"),
                "api_key": os.getenv("MEM0_API_KEY"),
            },
        }
    )

    # Create Crew with external memory
    chat_crew = Crew(
        agents=[chat_agent],
        tasks=[chat_task],
        process=Process.sequential,
        external_memory=external_memory,
        verbose=False,
        embedder={
            "provider": "openai",
            "config": {
                "api_key": os.getenv("OPENAI_API_KEY"),
                "api_base": os.getenv("AZURE_OPENAI_API_BASE"),
                "api_type": "azure",
                "api_version": "2023-05-15",
                "model": "text-embedding-ada-002",
                "deployment_id": "text-embedding-ada-002",
            },
        },
    )

    # Attempt to save a memory entry using the external memory save method
    # This will internally call mem0 client's add method with the correct format after fix
    try:
        external_memory.save("Hello, this is a test memory entry.", {"test_key": "test_value"})
    except Exception as e:
        pytest.fail(f"ExternalMemory.save raised an exception: {e}")

    # If no exception, test passes indicating memory save works with mem0 format


def test_external_memory_search_with_mem0():
    """
    This test verifies that ExternalMemory configured with mem0 provider
    can perform search without raising errors.

    It uses dummy API keys and mocks the internal network call by invoking the real search method.

    The test fails on the buggy codebase if the search parameters are malformed,
    and passes after the fix.
    """

    chat_agent = Agent(
        role="Friendly chatbot assistant",
        goal="Engage in useful and interesting conversations with users while remembering context.",
        backstory="You are a kind and knowledgeable chatbot assistant.",
        llm=LLM("azure/gpt-4.1"),
        verbose=False,
    )

    chat_task = Task(
        description="Respond to user conversation. User message: {user_msg}",
        expected_output="Contextually appropriate, helpful, and friendly response.",
        agent=chat_agent,
    )

    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {
                "user_id": "user-123",
                "org_id": os.getenv("MEM0_ORG_ID"),
                "project_id": os.getenv("MEM0_PROJECT_ID"),
                "api_key": os.getenv("MEM0_API_KEY"),
            },
        }
    )

    chat_crew = Crew(
        agents=[chat_agent],
        tasks=[chat_task],
        process=Process.sequential,
        external_memory=external_memory,
        verbose=False,
        embedder={
            "provider": "openai",
            "config": {
                "api_key": os.getenv("OPENAI_API_KEY"),
                "api_base": os.getenv("AZURE_OPENAI_API_BASE"),
                "api_type": "azure",
                "api_version": "2023-05-15",
                "model": "text-embedding-ada-002",
                "deployment_id": "text-embedding-ada-002",
            },
        },
    )

    try:
        results = external_memory.search("test query", limit=3, score_threshold=0.5)
    except Exception as e:
        pytest.fail(f"ExternalMemory.search raised an exception: {e}")

    # The results should be a list (possibly empty)
    assert isinstance(results, list), "Search results should be a list"


