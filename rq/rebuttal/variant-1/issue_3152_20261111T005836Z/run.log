import pytest
from crewai import Crew, Agent, Task, Process, LLM
from crewai.memory.external.external_memory import ExternalMemory


@pytest.fixture
def setup_chat_crew():
    # Setup environment variables with dummy keys to avoid real API calls
    import os
    os.environ["MEM0_API_KEY"] = "dummy_mem0_api_key"
    os.environ["MEM0_ORG_ID"] = "dummy_org_id"
    os.environ["MEM0_PROJECT_ID"] = "dummy_project_id"
    os.environ["OPENAI_API_KEY"] = "dummy_openai_api_key"
    os.environ["AZURE_OPENAI_API_BASE"] = "https://dummy.openai.azure.com/"
    os.environ["AZURE_OPENAI_API_VERSION"] = "2023-05-15"

    # Create an agent with a role and LLM
    chat_agent = Agent(
        role="Friendly chatbot assistant",
        goal="Engage in useful and interesting conversations with users while remembering context.",
        backstory="You are a kind and knowledgeable chatbot assistant. You excel at understanding user needs, providing helpful responses, and maintaining engaging conversations. You remember previous interactions to provide a personalized experience.",
        llm=LLM("azure/gpt-4.1"),
        verbose=True,
    )

    # Create a task that uses the agent
    chat_task = Task(
        description="Respond to user conversation. User message: {user_msg}",
        expected_output="Contextually appropriate, helpful, and friendly response.",
        agent=chat_agent,
    )

    # Setup external memory with mem0 provider and dummy config
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {
                "user_id": "user-123",
                "org_id": "dummy_org_id",
                "project_id": "dummy_project_id",
                "api_key": "dummy_mem0_api_key",
            },
        }
    )

    # Create the crew with the agent, task, process, and external memory
    chat_crew = Crew(
        agents=[chat_agent],
        tasks=[chat_task],
        process=Process.sequential,
        external_memory=external_memory,
        verbose=True,
        embedder={
            "provider": "openai",
            "config": {
                "api_key": "dummy_openai_api_key",
                "api_base": "https://dummy.openai.azure.com/",
                "api_type": "azure",
                "api_version": "2023-05-15",
                "model": "text-embedding-ada-002",
                "deployment_id": "text-embedding-ada-002",
            },
        },
    )
    return chat_crew


def test_external_memory_save_and_search(setup_chat_crew, monkeypatch):
    chat_crew = setup_chat_crew

    # Patch input to simulate user input and exit after one interaction
    inputs = iter(["Hello, how are you?", "exit"])
    monkeypatch.setattr(builtins, "input", lambda _: next(inputs))

    # Kickoff the crew with user message
    response = chat_crew.kickoff(inputs={"user_msg": "Hello, how are you?"})

    # The response should be a non-empty string (the assistant's reply)
    assert isinstance(response, str)
    assert len(response) > 0


def test_external_memory_save_value_wrapping():
    from crewai.memory.storage.mem0_storage import Mem0Storage
    from types import SimpleNamespace

    # Create a dummy crew with memory_config for mem0
    dummy_crew = SimpleNamespace()
    dummy_crew.memory_config = {
        "provider": "mem0",
        "config": {
            "user_id": "user-123",
            "org_id": "dummy_org_id",
            "project_id": "dummy_project_id",
            "api_key": "dummy_mem0_api_key",
        },
    }
    dummy_crew.agents = [SimpleNamespace(role="Friendly chatbot assistant")]

    # Instantiate Mem0Storage with dummy crew
    mem0_storage = Mem0Storage(type="short_term", crew=dummy_crew)

    # Mock the memory.add method to capture the call arguments
    called_args = {}

    def mock_add(value, **kwargs):
        called_args["value"] = value
        called_args["kwargs"] = kwargs

    mem0_storage.memory.add = mock_add

    # Save a test value and metadata
    test_value = "Test memory content"
    test_metadata = {"key": "value"}

    mem0_storage.save(test_value, test_metadata)

    # The value passed to memory.add should be a list of dict with role and content keys
    assert isinstance(called_args["value"], list)
    assert len(called_args["value"]) == 1
    assert isinstance(called_args["value"][0], dict)
    assert called_args["value"][0].get("role") == "assistant"
    assert called_args["value"][0].get("content") == test_value

    # Metadata should include the memory type and the test metadata keys
    assert "metadata" in called_args["kwargs"]
    assert called_args["kwargs"]["metadata"].get("type") == "short_term"
    assert called_args["kwargs"]["metadata"].get("key") == "value"[0m
