[32mimport os
import pytest
from crewai import Crew, Agent, Task, Process, LLM
from crewai.memory.external.external_memory import ExternalMemory

@pytest.mark.skipif(
    not os.getenv("MEM0_API_KEY") or not os.getenv("MEM0_ORG_ID") or not os.getenv("MEM0_PROJECT_ID"),
    reason="MEM0_API_KEY, MEM0_ORG_ID, and MEM0_PROJECT_ID environment variables must be set for this test"
)
def test_external_memory_save_with_mem0():
    """
    This test verifies that ExternalMemory configured with mem0 provider
    can save memory without raising errors.

    It uses dummy API keys and mocks the internal network call by invoking the real save method.

    The test fails on the buggy codebase if the save parameters are malformed,
    and passes after the fix.
    """

    chat_agent = Agent(
        role="Friendly chatbot assistant",
        goal="Engage in useful and interesting conversations with users while remembering context.",
        backstory="You are a kind and knowledgeable chatbot assistant.",
        llm=LLM("azure/gpt-4.1"),
        verbose=False,
    )

    chat_task = Task(
        description="Respond to user conversation. User message: {user_msg}",
        expected_output="Contextually appropriate, helpful, and friendly response.",
        agent=chat_agent,
    )

    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {
                "user_id": "user-123",
                "org_id": os.getenv("MEM0_ORG_ID"),
                "project_id": os.getenv("MEM0_PROJECT_ID"),
                "api_key": os.getenv("MEM0_API_KEY"),
            },
        }
    )

    # Save a test memory entry, should not raise error
    try:
        external_memory.save("Test memory content for mem0 save", {"test_key": "test_value"})
    except Exception as e:
        pytest.fail(f"ExternalMemory.save raised an exception: {e}")

@pytest.mark.skipif(
