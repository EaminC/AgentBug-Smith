from unittest.mock import MagicMock

from crewai.agent import Agent
from crewai.crew import Crew
from crewai.task import Task
from crewai.process import Process
from crewai.llm import LLM
from crewai.memory.external.external_memory import ExternalMemory


class DummyMemoryClient:
    def __init__(self, *args, **kwargs):
        self.add_calls = []
        self.search_calls = []
    def add(self, value, **kwargs):
        self.add_calls.append((value, kwargs))
    def search(self, query, **kwargs):
        self.search_calls.append((query, kwargs))
        # Return dummy search results with scores
        return {"results": [
            {"score": 0.9, "content": "Relevant memory 1"},
            {"score": 0.3, "content": "Less relevant memory 2"},
        ]}


@pytest.fixture(autouse=True)
def patch_external_memory(monkeypatch):
    # Patch ExternalMemory to use DummyMemoryClient internally to avoid mem0 import error
    original_init = ExternalMemory.__init__

    def dummy_init(self, embedder_config=None, *args, **kwargs):
        # Instead of real mem0 client, just assign dummy client
        self.memory = DummyMemoryClient()
        self.embedder_config = embedder_config
        self.config = embedder_config
        self._user_id = "user-123"
        self._org_id = ""
        self._project_id = ""
        self._local_mem0_config = None
        self._initialized = True

    monkeypatch.setattr(ExternalMemory, "__init__", dummy_init)
    yield
    monkeypatch.setattr(ExternalMemory, "__init__", original_init)


def test_external_memory_save_and_search_with_mem0_style_config():
    # Setup environment variables (empty strings to simulate presence)
    import os
    os.environ["MEM0_API_KEY"] = "dummy_api_key"

    # Create agent
    chat_agent = Agent(
        role="Friendly chatbot assistant",
        goal="Engage in useful and interesting conversations with users while remembering context.",
        backstory="You are a kind and knowledgeable chatbot assistant. You excel at understanding user needs, providing helpful responses, and maintaining engaging conversations. You remember previous interactions to provide a personalized experience.",
        llm=LLM("azure/gpt-4.1"),
        verbose=False
    )

    # Create task
    chat_task = Task(
        description="Respond to user conversation. User message: {user_msg}",
        expected_output="Contextually appropriate, helpful, and friendly response.",
        agent=chat_agent
    )

    # External memory configured with mem0 style config
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {
                "user_id": "user-123",
                "org_id": "dummy_org",
                "project_id": "dummy_project",
            }
        }
    )

    # Create crew with external memory
    chat_crew = Crew(
        agents=[chat_agent],
        tasks=[chat_task],
        process=Process.sequential,
        external_memory=external_memory,
        verbose=False,
        embedder={
            "provider": "openai",
            "config": {
                "api_key": "dummy_openai_key",
                "api_base": "https://dummy.openai.api",
                "api_type": "azure",
                "api_version": "2023-05-15",
                "model": "text-embedding-ada-002",
                "deployment_id": "text-embedding-ada-002"
            }
        }
    )

    # Simulate a user message and kickoff the crew
    user_message = "Hello, how are you?"
    output = chat_crew.kickoff(inputs={"user_msg": user_message})

    # The dummy memory client should have recorded an add call with the correct format
    mem = external_memory.memory
    assert len(mem.add_calls) == 1, "Memory add was not called exactly once"

    added_value, add_kwargs = mem.add_calls[0]
    # The added value should be a list of dicts with role and content keys (fix requires this)
    assert isinstance(added_value, list), "Added value should be a list"
    assert len(added_value) == 1, "Added value list should have one message"
    message = added_value[0]
    assert isinstance(message, dict), "Message should be a dict"
    assert message.get("role") == "assistant", "Message role should be 'assistant'"
    assert message.get("content") == output, "Message content should match output"

    # Also test search returns filtered results by score threshold
    results = external_memory.memory.search("Hello", limit=5, score_threshold=0.5)
    # The dummy returns two results, only one above 0.5 score
    filtered = [r for r in results["results"] if r["score"] >= 0.5]
    assert len(filtered) == 1, "Only one result should meet score threshold"
    assert filtered[0]["content"] == "Relevant memory 1"


