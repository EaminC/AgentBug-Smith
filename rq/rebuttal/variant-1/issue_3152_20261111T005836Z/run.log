[32mimport pytest
from crewai.agent import Agent
from crewai.task import Task
from crewai.llm import LLM
from crewai.memory.external.external_memory import ExternalMemory
from crewai.crew import Crew
from crewai.process import Process

class DummyMemoryClient:
    def __init__(self):
        self.add_calls = []
        self.search_calls = []
    def add(self, value, **kwargs):
        self.add_calls.append((value, kwargs))
        # Simulate success
        return True
    def search(self, query, **kwargs):
        self.search_calls.append((query, kwargs))
        # Return dummy search results
        return {"results": [{"score": 0.9, "content": "dummy result"}]}

@pytest.fixture
def setup_crew_with_mem0(monkeypatch):
    # Patch ExternalMemory to use DummyMemoryClient to avoid real network calls
    dummy_client = DummyMemoryClient()

    def dummy_external_memory_init(self, embedder_config):
        # We do not call super().__init__ to avoid Pydantic validation issues
        object.__setattr__(self, "memory", dummy_client)
        object.__setattr__(self, "memory_config", embedder_config)

    monkeypatch.setattr(ExternalMemory, "__init__", dummy_external_memory_init)

    chat_agent = Agent(
        role="Friendly chatbot assistant",
        goal="Engage in useful and interesting conversations with users while remembering context.",
        backstory="You are a kind and knowledgeable chatbot assistant. You excel at understanding user needs, providing helpful responses, and maintaining engaging conversations. You remember previous interactions to provide a personalized experience.",
        llm=LLM("azure/gpt-4.1"),
        verbose=True,
    )
    chat_task = Task(
        description="Respond to user conversation. User message: {user_msg}",
        expected_output="Contextually appropriate, helpful, and friendly response.",
        agent=chat_agent,
    )
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {
                "user_id": "user-123",
                "org_id": "org-abc",
                "project_id": "proj-xyz",
            },
        }
    )
    chat_crew = Crew(
        agents=[chat_agent],
        tasks=[chat_task],
        process=Process.sequential,
        external_memory=external_memory,
        verbose=True,
    )
    return chat_crew, external_memory.memory

def test_mem0_external_memory_save_behavior(setup_crew_with_mem0):
    chat_crew, dummy_memory = setup_crew_with_mem0
    user_message = "Hello, how are you?"
    # Kickoff the crew with user message input
    response = chat_crew.kickoff(inputs={"user_msg": user_message})

    # The dummy memory client should have recorded an add call with a list of dicts (assistant message)
    assert len(dummy_memory.add_calls) == 1
    value_passed, kwargs_passed = dummy_memory.add_calls[0]
    # The value passed to add must be a list with dict containing role assistant and content user_message
    assert isinstance(value_passed, list)
    assert len(value_passed) == 1
    assert value_passed[0]["role"] == "assistant"
    assert value_passed[0]["content"] == response or value_passed[0]["content"] == user_message or isinstance(value_passed[0]["content"], str)
    # Metadata must include the memory type
    assert "metadata" in kwargs_passed
    assert kwargs_passed["metadata"].get("type") == "short_term" or kwargs_passed["metadata"].get("type") is not None

def test_mem0_external_memory_save_fails_if_value_not_list(setup_crew_with_mem0):
    chat_crew, dummy_memory = setup_crew_with_mem0

    # Manually call external_memory.memory.add with a string (simulate buggy call)
    # This should not raise inside dummy, but the real code expects a list
    try:
        dummy_memory.add("This is a string not a list", agent_id="TestAgent", infer=False, metadata={})
    except Exception:
        pytest.fail("DummyMemoryClient.add raised unexpectedly")

    # Now test that the crew kickoff triggers add with a list (correct usage)
    response = chat_crew.kickoff(inputs={"user_msg": "Test message"})
    value_passed, kwargs_passed = dummy_memory.add_calls[-1]
    assert isinstance(value_passed, list)
    assert all(isinstance(item, dict) for item in value_passed)
    assert value_passed[0].get("role") == "assistant"[0m
