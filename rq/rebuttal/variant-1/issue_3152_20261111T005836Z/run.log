[32mimport pytest
from unittest.mock import MagicMock

from crewai.memory.storage.mem0_storage import Mem0Storage


class DummyCrew:
    def __init__(self, memory_config):
        self.memory_config = memory_config
        self.agents = [MagicMock(role="Test_Agent")]


def test_mem0_storage_save_calls_add_with_assistant_message():
    """
    This test verifies that the Mem0Storage.save method calls the underlying
    memory.add method with the value wrapped as a list of dicts with role 'assistant'
    and content equal to the original value. This matches the fix that changed the
    call from passing a string to passing a list of messages.
    """
    # Setup dummy crew with mem0 config
    crew = DummyCrew(
        memory_config={
            "provider": "mem0",
            "config": {
                "user_id": "user-123",
                "org_id": "org-abc",
                "project_id": "proj-xyz",
                "api_key": "dummy_api_key",
            },
        }
    )

    mem0_storage = Mem0Storage(type="short_term", crew=crew)

    # Mock the memory attribute's add method
    mem0_storage.memory.add = MagicMock()

    test_value = "This is a test memory content"
    test_metadata = {"foo": "bar"}

    mem0_storage.save(test_value, test_metadata)

    # Expected call argument: list of dict with role 'assistant' and content test_value
    expected_message = [{"role": "assistant", "content": test_value}]

    # The add method should be called once with the wrapped message and metadata including type
    mem0_storage.memory.add.assert_called_once()
    call_args, call_kwargs = mem0_storage.memory.add.call_args

    # The first positional argument should be the expected_message list
    assert call_args[0] == expected_message

    # Metadata dict should include the memory type and the test metadata keys
    assert "metadata" in call_kwargs
    assert call_kwargs["metadata"].get("type") == "short_term"
    for k, v in test_metadata.items():
        assert call_kwargs["metadata"].get(k) == v

    # agent_id should be the sanitized role of the first agent
    assert call_kwargs.get("agent_id") == "Test_Agent"

    # infer should be False by default
    assert call_kwargs.get("infer") is False

    # If memory is an instance of MemoryClient, output_format should be set to 'v1.1'
    # We do not know the exact type here, so just check if output_format is present or not
    # This is not mandatory for fail2pass but good to check presence if applicable
    # We skip this check because it depends on internal type detection


def test_mem0_storage_save_fails_if_value_is_str_before_patch():
    """
    This test is designed to fail on the buggy codebase where the save method
    passes a string directly to memory.add, which causes an error in mem0 API.
    After the fix, this test should pass because the value is wrapped as a list of messages.
    """
    crew = DummyCrew(
        memory_config={
            "provider": "mem0",
            "config": {
                "user_id": "user-123",
                "org_id": "org-abc",
                "project_id": "proj-xyz",
                "api_key": "dummy_api_key",
            },
        }
    )

    mem0_storage = Mem0Storage(type="short_term", crew=crew)

    # Patch the memory.add method to raise an error if called with a string (buggy behavior)
    def add_side_effect(value, **kwargs):
        if isinstance(value, str):
            raise ValueError("Expected a list of items but got type 'str'.")
        return None

    mem0_storage.memory.add = MagicMock(side_effect=add_side_effect)

    test_value = "This is a test memory content"
    test_metadata = {"foo": "bar"}

    # On buggy code, this will raise ValueError, causing test failure
    # On fixed code, it will not raise, so test passes
    mem0_storage.save(test_value, test_metadata)


@pytest.mark.parametrize("memory_type", ["short_term", "long_term"])
def test_mem0_storage_save_metadata_includes_type(memory_type):
    """
    Test that the metadata passed to memory.add always includes the memory type.
    """
    crew = DummyCrew(
        memory_config={
            "provider": "mem0",
            "config": {
                "user_id": "user-123",
                "org_id": "org-abc",
                "project_id": "proj-xyz",
                "api_key": "dummy_api_key",
            },
        }
    )

    mem0_storage = Mem0Storage(type=memory_type, crew=crew)
    mem0_storage.memory.add = MagicMock()

    test_value = "Another test memory content"
    test_metadata = {"custom": "data"}

    mem0_storage.save(test_value, test_metadata)

    _, call_kwargs = mem0_storage.memory.add.call_args

    assert "metadata" in call_kwargs
    assert call_kwargs["metadata"].get("type") == memory_type
    assert call_kwargs["metadata"].get("custom") == "data"[0m
