    # Patch the save method of the external memory storage to call add with string (buggy)
    original_save = chat_crew.external_memory.save

    def buggy_save(value, metadata):
        # Directly call add with string value instead of list
        dummy_client.add(value, agent_id="Test_Agent", infer=False, metadata={"type": "short_term"})

    chat_crew.external_memory.save = buggy_save

    # Run kickoff, which triggers save internally
    user_message = "Hello, this triggers buggy save"
    with pytest.raises(AssertionError):
        # We expect our assertions below to fail because add is called with string, not list
        output = chat_crew.kickoff(inputs={"user_msg": user_message})

        # Check the call arguments to add
        add_value, _ = dummy_client.add_calls[-1]
        # This should fail because add_value is string, not list
        assert isinstance(add_value, list), "Memory add value should be a list (buggy test should fail here)"

    # Restore original save method to avoid side effects
    chat_crew.external_memory.save = original_save[0m
