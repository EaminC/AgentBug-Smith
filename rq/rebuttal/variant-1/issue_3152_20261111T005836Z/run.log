[32mimport os
import pytest
from crewai import Crew, Agent, Task, Process, LLM
from crewai.memory.external.external_memory import ExternalMemory


@pytest.mark.skipif(
    "MEM0_API_KEY" not in os.environ or not os.environ["MEM0_API_KEY"],
    reason="MEM0_API_KEY env var not set",
)
@pytest.mark.skipif(
    "OPENAI_API_KEY" not in os.environ and "AZURE_OPENAI_API_KEY" not in os.environ,
    reason="OpenAI or Azure OpenAI API key env var not set",
)
def test_external_memory_save_with_mem0():
    """
    Integration test to verify that saving memory with mem0 provider works correctly.

    This test uses real environment variables for MEM0 and OpenAI/Azure OpenAI keys.
    It creates a Crew with ExternalMemory configured for mem0 and performs a kickoff
    with a user message. The test asserts that the returned reply is a non-empty string,
    indicating the memory save and retrieval process worked without error.

    This test will fail on the buggy codebase due to incorrect memory saving format,
    and pass after the fix that wraps the saved value in a list of assistant messages.
    """

    # Setup environment variables for mem0 and openai keys (should be set externally)
    mem0_api_key = os.environ.get("MEM0_API_KEY", "")
    mem0_org_id = os.environ.get("MEM0_ORG_ID", "")
    mem0_project_id = os.environ.get("MEM0_PROJECT_ID", "")
    openai_api_key = os.environ.get("OPENAI_API_KEY", "") or os.environ.get("AZURE_OPENAI_API_KEY", "")
    openai_api_base = os.environ.get("AZURE_OPENAI_API_BASE", "")
    openai_api_type = os.environ.get("AZURE_OPENAI_API_TYPE", "azure")
    openai_api_version = os.environ.get("AZURE_OPENAI_API_VERSION", "2023-05-15")
    openai_model = os.environ.get("AZURE_OPENAI_MODEL", "text-embedding-ada-002")
    openai_deployment_id = os.environ.get("AZURE_OPENAI_DEPLOYMENT_ID", "text-embedding-ada-002")

    # Skip test if required mem0 config is missing
    if not mem0_api_key or not mem0_org_id or not mem0_project_id:
        pytest.skip("MEM0_API_KEY, MEM0_ORG_ID, or MEM0_PROJECT_ID env vars not set")

    # Create agent
    chat_agent = Agent(
        role="Friendly chatbot assistant",
        goal="Engage in useful and interesting conversations with users while remembering context.",
        backstory=(
            "You are a kind and knowledgeable chatbot assistant. You excel at understanding user needs, "
            "providing helpful responses, and maintaining engaging conversations. You remember previous "
            "interactions to provide a personalized experience."
        ),
        llm=LLM("azure/gpt-4.1"),
        verbose=False,
    )

    # Create task
    chat_task = Task(
        description="Respond to user conversation. User message: {user_msg}",
        expected_output="Contextually appropriate, helpful, and friendly response.",
        agent=chat_agent,
    )

    # Setup external memory with mem0 provider
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {
                "user_id": "user-123",
                "org_id": mem0_org_id,
                "project_id": mem0_project_id,
                "api_key": mem0_api_key,
            },
        }
    )

    # Create Crew with external memory and embedder config for OpenAI/Azure
    chat_crew = Crew(
        agents=[chat_agent],
        tasks=[chat_task],
        process=Process.sequential,
        external_memory=external_memory,
        verbose=False,
        embedder={
            "provider": "openai",
            "config": {
                "api_key": openai_api_key,
                "api_base": openai_api_base,
                "api_type": openai_api_type,
                "api_version": openai_api_version,
                "model": openai_model,
                "deployment_id": openai_deployment_id,
            },
        },
    )

    # Perform kickoff with a sample user message
    user_message = "Hello, how are you?"
    result = chat_crew.kickoff(inputs={"user_msg": user_message})

    # Assert the result is a non-empty string (indicating successful memory save and response)
    assert isinstance(result, str)
    assert len(result.strip()) > 0[0m
