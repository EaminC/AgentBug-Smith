import builtins
import pytest

from crewai import Crew, Agent, Task, Process, LLM
from crewai.memory.external.external_memory import ExternalMemory


class DummyMemory:
    def __init__(self):
        self.saved = []
        self.searched = []

    def add(self, value, **kwargs):
        self.saved.append((value, kwargs))

    def search(self, query, **kwargs):
        self.searched.append((query, kwargs))
        # Return dummy search results
        return {"results": [{"score": 0.9, "content": "Found memory content"}]}


class DummyExternalMemory(ExternalMemory):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        # Replace internal memory client with dummy to avoid network calls
        self.memory = DummyMemory()


@pytest.fixture
def setup_chat_crew(monkeypatch):
    # Patch ExternalMemory to use DummyExternalMemory to avoid real network calls
    monkeypatch.setattr("crewai.memory.external.external_memory.ExternalMemory", DummyExternalMemory)

    chat_agent = Agent(
        role="Friendly chatbot assistant",
        goal="Engage in useful and interesting conversations with users while remembering context.",
        backstory="You are a kind and knowledgeable chatbot assistant. You excel at understanding user needs, providing helpful responses, and maintaining engaging conversations. You remember previous interactions to provide a personalized experience.",
        llm=LLM("azure/gpt-4.1"),
        verbose=True
    )
    chat_task = Task(
        description="Respond to user conversation. User message: {user_msg}",
        expected_output="Contextually appropriate, helpful, and friendly response.",
        agent=chat_agent
    )
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {
                "user_id": "user-123",
                "org_id": "org-abc",
                "project_id": "proj-xyz",
            }
        }
    )
    chat_crew = Crew(
        agents=[chat_agent],
        tasks=[chat_task],
        process=Process.sequential,
        external_memory=external_memory,
        verbose=True,
        embedder={
            "provider": "openai",
            "config": {
                "api_key": "dummy_api_key",
                "api_base": "https://dummy.openai.azure.com/",
                "api_type": "azure",
                "api_version": "2023-05-15",
                "model": "text-embedding-ada-002",
                "deployment_id": "text-embedding-ada-002"
            }
        }
    )
    return chat_crew


def test_external_memory_save_and_search(setup_chat_crew, monkeypatch):
    chat_crew = setup_chat_crew

    # Patch input to simulate user input and exit after one interaction
    inputs = iter(["Hello, how are you?", "exit"])
    monkeypatch.setattr(builtins, "input", lambda _: next(inputs))

    # Kickoff the crew with user message
    response = chat_crew.kickoff(inputs={"user_msg": "Hello, how are you?"})

    # The dummy memory should have saved the message wrapped as assistant message list
    mem = chat_crew.external_memory.memory
    assert hasattr(mem, "saved")
    assert len(mem.saved) == 1
    saved_value, saved_kwargs = mem.saved[0]

    # The saved value must be a list of dicts with role assistant and content equal to the response value
    assert isinstance(saved_value, list)
    assert len(saved_value) == 1
    assert saved_value[0]["role"] == "assistant"
    # The content saved should be the response string (the value passed to save)
    assert saved_value[0]["content"] == response

    # The metadata should include the memory type "short_term" or similar
    assert "metadata" in saved_kwargs
    assert "type" in saved_kwargs["metadata"]

    # Also test that search returns expected dummy results
    results = chat_crew.external_memory.search("test query", limit=3, score_threshold=0.5)
    assert isinstance(results, list)
    assert len(results) == 1
    assert results[0]["content"] == "Found memory content"


def test_external_memory_save_value_wrapping(setup_chat_crew):
    # Directly test that the save method wraps the value correctly as a list of assistant messages
    mem = setup_chat_crew.external_memory.memory
    test_value = "Test message for save"
    test_metadata = {"foo": "bar"}

    # Clear previous saved
    mem.saved.clear()

    setup_chat_crew.external_memory.save(test_value, test_metadata)

    assert len(mem.saved) == 1
    saved_value, _ = mem.saved[0]
    assert isinstance(saved_value, list)
    assert saved_value[0]["role"] == "assistant"
    assert saved_value[0]["content"] == test_value

# This test file verifies that the external memory save method correctly wraps the saved value
# into a list of assistant messages, which fixes the bug where mem0 API expected a list but got a string.
# The test fails on buggy code and passes after the fix.[0m
