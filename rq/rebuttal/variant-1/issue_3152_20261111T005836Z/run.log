import pytest
from crewai import Crew, Agent, Task, Process, LLM
from crewai.memory.external.external_memory import ExternalMemory

@pytest.mark.skipif(
    "MEM0_API_KEY" not in os.environ or not os.environ["MEM0_API_KEY"],
    reason="MEM0_API_KEY environment variable not set",
)
@pytest.mark.skipif(
    "OPENAI_API_KEY" not in os.environ or not os.environ["OPENAI_API_KEY"],
    reason="OPENAI_API_KEY environment variable not set",
)
def test_external_memory_save_with_mem0():
    """
    Integration test to verify that ExternalMemory with mem0 provider
    saves memory correctly without error.
    This test will fail on buggy code and pass on fixed code.
    """

    # Setup environment variables for mem0 and Azure OpenAI keys
    mem0_api_key = os.environ.get("MEM0_API_KEY")
    openai_api_key = os.environ.get("OPENAI_API_KEY")
    mem0_org_id = os.environ.get("MEM0_ORG_ID", "")
    mem0_project_id = os.environ.get("MEM0_PROJECT_ID", "")
    azure_api_base = os.environ.get("AZURE_API_BASE", "")
    azure_deployment_id = os.environ.get("AZURE_DEPLOYMENT_ID", "text-embedding-ada-002")

    # Create the agent
    chat_agent = Agent(
        role="Friendly chatbot assistant",
        goal="Engage in useful and interesting conversations with users while remembering context.",
        backstory=(
            "You are a kind and knowledgeable chatbot assistant. "
            "You excel at understanding user needs, providing helpful responses, "
            "and maintaining engaging conversations. You remember previous interactions "
            "to provide a personalized experience."
        ),
        llm=LLM("azure/gpt-4.1"),
        verbose=False,
    )

    # Create the task
    chat_task = Task(
        description="Respond to user conversation. User message: {user_msg}",
        expected_output="Contextually appropriate, helpful, and friendly response.",
        agent=chat_agent,
    )

    # Setup external memory with mem0 provider
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {
                "user_id": "test-user-123",
                "org_id": mem0_org_id,
                "project_id": mem0_project_id,
                "api_key": mem0_api_key,
            },
        }
    )

    # Create the Crew with external memory and embedder config for Azure OpenAI
    chat_crew = Crew(
        agents=[chat_agent],
        tasks=[chat_task],
        process=Process.sequential,
        external_memory=external_memory,
        verbose=False,
        embedder={
            "provider": "openai",
            "config": {
                "api_key": openai_api_key,
                "api_base": azure_api_base,
                "api_type": "azure",
                "api_version": "2023-05-15",
                "model": "text-embedding-ada-002",
                "deployment_id": azure_deployment_id,
            },
        },
    )

    # Use a test message to save to external memory via kickoff
    user_message = "Hello, how are you today?"

    # Kickoff the crew with user message input
    output = chat_crew.kickoff(inputs={"user_msg": user_message})

    # Assert output is a non-empty string (indicating response generated)
    assert isinstance(output, str)
    assert len(output.strip()) > 0

    # Additional: Check that no error was raised and output is not an error message
    error_indicators = [
        "error",
        "failed",
        "exception",
        "cannot",
        "400 Bad Request",
        "API request failed",
    ]
    lower_output = output.lower()
    for indicator in error_indicators:
        assert indicator not in lower_output, f"Output contains error indicator: {indicator}"[0m
