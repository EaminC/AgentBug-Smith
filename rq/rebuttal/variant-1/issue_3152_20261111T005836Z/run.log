[32mimport pytest
from unittest.mock import MagicMock

from crewai.agent import Agent
from crewai.crew import Crew
from crewai.task import Task
from crewai.memory.external.external_memory import ExternalMemory
from crewai.llm import LLM
from crewai.process import Process


class DummyMemoryClient:
    def __init__(self):
        self.add_calls = []

    def add(self, value, **kwargs):
        self.add_calls.append((value, kwargs))


@pytest.fixture
def setup_crew_with_mem0(monkeypatch):
    # Patch ExternalMemory to use DummyMemoryClient to avoid real network calls
    dummy_client = DummyMemoryClient()

    def dummy_external_memory_init(self, embedder_config):
        self.memory = dummy_client
        self.memory_config = embedder_config

    monkeypatch.setattr(ExternalMemory, "__init__", dummy_external_memory_init)

    # Create agent, task, external memory, and crew with mem0 config
    chat_agent = Agent(
        role="Friendly chatbot assistant",
        goal="Engage in useful and interesting conversations with users while remembering context.",
        backstory="You are a kind and knowledgeable chatbot assistant. You excel at understanding user needs, providing helpful responses, and maintaining engaging conversations. You remember previous interactions to provide a personalized experience.",
        llm=LLM("azure/gpt-4.1"),
        verbose=True,
    )
    chat_task = Task(
        description="Respond to user conversation. User message: {user_msg}",
        expected_output="Contextually appropriate, helpful, and friendly response.",
        agent=chat_agent,
    )
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {
                "user_id": "user-123",
                "org_id": "org-abc",
                "project_id": "proj-xyz",
            },
        }
    )
    chat_crew = Crew(
        agents=[chat_agent],
        tasks=[chat_task],
        process=Process.sequential,
        external_memory=external_memory,
        verbose=True,
        embedder={
            "provider": "openai",
            "config": {
                "api_key": "dummy_api_key",
                "api_base": "https://dummy.openai.azure.com/",
                "api_type": "azure",
                "api_version": "2023-05-15",
                "model": "text-embedding-ada-002",
                "deployment_id": "text-embedding-ada-002",
            },
        },
    )
    return chat_crew, dummy_client, chat_agent


def test_mem0_external_memory_save_behavior(setup_crew_with_mem0):
    chat_crew, dummy_client, chat_agent = setup_crew_with_mem0

    # Simulate kickoff with user message input
    user_message = "Hello, how are you?"
    output = chat_crew.kickoff(inputs={"user_msg": user_message})

    # After kickoff, the dummy_client.add should have been called with a list of dicts (assistant message)
    assert dummy_client.add_calls, "Expected memory.add to be called to save memory"

    # Extract the first call arguments to add
    add_value, add_kwargs = dummy_client.add_calls[0]

    # The value passed to add should be a list with a dict having keys 'role' and 'content'
    assert isinstance(add_value, list), "Memory add value should be a list"
    assert len(add_value) == 1, "Memory add value list should have one item"
    assert isinstance(add_value[0], dict), "Memory add list item should be a dict"
    assert "role" in add_value[0], "Memory add dict should have 'role' key"
    assert "content" in add_value[0], "Memory add dict should have 'content' key"
    assert add_value[0]["role"] == "assistant", "Memory add dict 'role' should be 'assistant'"
    assert add_value[0]["content"] == output, "Memory add dict 'content' should match output"

    # The metadata should include the agent id matching the agent role sanitized
    assert "agent_id" in add_kwargs, "Memory add kwargs should include 'agent_id'"
    expected_agent_id = chat_agent.role.replace(" ", "_")
    assert add_kwargs["agent_id"] == expected_agent_id, "agent_id should be sanitized agent role"

    # The metadata dict should include the memory type "short_term" or similar
    metadata = add_kwargs.get("metadata")
    assert metadata is not None, "Memory add kwargs should include 'metadata'"
    assert "type" in metadata, "Metadata should include 'type' key"
    assert metadata["type"] in {"short_term", "long_term"}, "Metadata type should be short_term or long_term"

    # The infer flag should be False
    assert add_kwargs.get("infer") is False, "infer flag should be False"


def test_mem0_external_memory_save_fails_if_value_not_list(setup_crew_with_mem0):
    # This test ensures that if the bug is present (passing string instead of list), the test fails
    # We simulate the buggy behavior by patching the save method to call memory.add with a string

