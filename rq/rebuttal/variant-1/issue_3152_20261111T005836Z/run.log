                "api_version": "2023-05-15",
                "model": "text-embedding-ada-002",
                "deployment_id": "text-embedding-ada-002",
            },
        },
    )

    # Kickoff the crew with a test input, should not raise error and produce a string output
    try:
        output = chat_crew.kickoff(inputs={"user_msg": "Hello, how are you?"})
    except Exception as e:
        pytest.fail(f"Crew.kickoff raised an exception: {e}")

