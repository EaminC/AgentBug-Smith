import pytest
from unittest.mock import MagicMock, patch

from crewai.agent import Agent
from crewai.crew import Crew
from crewai.task import Task
from crewai.llm import LLM
from crewai.process import Process
from crewai.memory.external.external_memory import ExternalMemory


@pytest.fixture
def patch_mem0_memory_add():
    # Patch the internal network call inside mem0 MemoryClient.add to simulate success
    # We patch the HTTP request or the mem0 client's add method indirectly by patching the add method
    # in the MemoryClient instance used by ExternalMemory.
    # We do not patch the save method itself, only the internal client call.
    with patch("mem0.client.main.MemoryClient.add") as mock_add:
        # Simulate successful add call returning None or similar
        mock_add.return_value = None
        yield mock_add


@pytest.fixture
def patch_openai_embedding_call():
    # Patch openai embedding call or crewai embedder calls to avoid real network calls
    # We patch the openai embedding call inside the embedder used by ExternalMemory
    with patch("openai.embeddings_utils.Embedding.create") as mock_embedding:
        mock_embedding.return_value = {"data": [{"embedding": [0.0] * 1536}]}
        yield mock_embedding


def test_external_memory_save_with_mem0(patch_mem0_memory_add):
    """
    Test that ExternalMemory configured with mem0 provider correctly saves memory
    as a list of assistant messages, not a raw string, to avoid 400 Bad Request errors.
    This test fails on buggy code and passes after fix.
    """
    # Setup environment variables for mem0 and Azure OpenAI (dummy values)
    os.environ["MEM0_API_KEY"] = "dummy_mem0_api_key"
    os.environ["MEM0_ORG_ID"] = "dummy_org_id"
    os.environ["MEM0_PROJECT_ID"] = "dummy_project_id"
    os.environ["OPENAI_API_KEY"] = "dummy_openai_api_key"
    os.environ["OPENAI_API_BASE"] = "https://dummy.openai.azure.com/"
    os.environ["OPENAI_API_TYPE"] = "azure"
    os.environ["OPENAI_API_VERSION"] = "2023-05-15"

    # Create Agent
    chat_agent = Agent(
        role="Friendly chatbot assistant",
        goal="Engage in useful and interesting conversations with users while remembering context.",
        backstory=(
            "You are a kind and knowledgeable chatbot assistant. You excel at understanding user needs, "
            "providing helpful responses, and maintaining engaging conversations. You remember previous "
            "interactions to provide a personalized experience."
        ),
        llm=LLM("azure/gpt-4.1"),
        verbose=False,
    )

    # Create Task
    chat_task = Task(
        description="Respond to user conversation. User message: {user_msg}",
        expected_output="Contextually appropriate, helpful, and friendly response.",
        agent=chat_agent,
    )

    # Create ExternalMemory with mem0 provider config
    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {
                "user_id": "user-123",
                "org_id": os.environ["MEM0_ORG_ID"],
                "project_id": os.environ["MEM0_PROJECT_ID"],
                "api_key": os.environ["MEM0_API_KEY"],
            },
        }
    )

    # Create Crew with ExternalMemory and embedder config for openai embeddings
    chat_crew = Crew(
        agents=[chat_agent],
        tasks=[chat_task],
        process=Process.sequential,
        external_memory=external_memory,
        verbose=False,
        embedder={
            "provider": "openai",
            "config": {
                "api_key": os.environ["OPENAI_API_KEY"],
                "api_base": os.environ["OPENAI_API_BASE"],
                "api_type": os.environ["OPENAI_API_TYPE"],
                "api_version": os.environ["OPENAI_API_VERSION"],
                "model": "text-embedding-ada-002",
                "deployment_id": "text-embedding-ada-002",
            },
        },
    )

    # Patch the internal add method of mem0 MemoryClient to avoid real network calls
    # and to inspect the call arguments.
    with patch("mem0.client.main.MemoryClient.add") as mock_add:
        mock_add.return_value = None

        # Run kickoff with a sample user message
        user_message = "Hello, how are you?"
        output = chat_crew.kickoff(inputs={"user_msg": user_message})

        # Assert output is a non-empty string (the agent's reply)
        assert isinstance(output, str)
        assert len(output) > 0

        # Assert that the external memory's add method was called once
        assert mock_add.call_count == 1

        # Extract the first call arguments to add
        call_args, call_kwargs = mock_add.call_args

        # The first positional argument to add should be a list of messages with role assistant
        saved_value = call_args[0]
        assert isinstance(saved_value, list), "Saved memory value should be a list"
        assert len(saved_value) == 1, "Saved memory list should contain exactly one message"
        message = saved_value[0]
        assert isinstance(message, dict), "Each message should be a dict"
        assert message.get("role") == "assistant", "Message role should be 'assistant'"
        assert message.get("content") == output, "Message content should match the agent's output"

        # Metadata should include the memory type short_term or similar
        metadata = call_kwargs.get("metadata")
        assert metadata is not None, "Metadata should be provided"
        assert "type" in metadata, "Metadata should include 'type' key"
        assert metadata["type"] in {"short_term", "long_term", "persistent", "working"}, "Metadata type should be valid"

        # agent_id should be a string
        agent_id = call_kwargs.get("agent_id")
        assert isinstance(agent_id, str) and len(agent_id) > 0

        # infer flag should be False
        infer_flag = call_kwargs.get("infer")
        assert infer_flag is False or infer_flag is None

        # If output_format is present, it should be 'v1.1'
        output_format = call_kwargs.get("output_format")
        if output_format is not None:
            assert output_format == "v1.1"


# This test file only contains one fail2pass test for the mem0 memory save bug.
# It relies on the real ExternalMemory and Crew classes, but patches the internal
# mem0 MemoryClient add method to avoid network calls and to verify correct usage.[0m
