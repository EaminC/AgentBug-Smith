    def test_external_memory_save_fails_with_old_format():
        # This test simulates the buggy behavior: saving a string instead of list of dicts
        # We patch ExternalMemory.memory.add to raise an error if input is not list of dicts
    
        class FailingMemoryClient(DummyMemoryClient):
            def add(self, value, **kwargs):
                # Raise error if value is not list of dicts with 'role' and 'content'
                if not (isinstance(value, list) and all(isinstance(m, dict) and "role" in m and "content" in m for m in value)):
                    raise ValueError("Expected a list of items but got type \"str\".")
                super().add(value, **kwargs)
    
        import os
        os.environ["MEM0_API_KEY"] = "dummy_api_key"
    
        # Patch ExternalMemory to use FailingMemoryClient
        original_init = ExternalMemory.__init__
    
        def dummy_init(self, embedder_config=None, *args, **kwargs):
            self.memory = FailingMemoryClient()
            self.embedder_config = embedder_config
            self.config = embedder_config
            self._user_id = "user-123"
            self._org_id = ""
            self._project_id = ""
            self._local_mem0_config = None
            self._initialized = True
    
        ExternalMemory.__init__ = dummy_init
    
        # Create agent and task as before
        chat_agent = Agent(
            role="Friendly chatbot assistant",
            goal="Engage in useful and interesting conversations with users while remembering context.",
            backstory="You are a kind and knowledgeable chatbot assistant. You excel at understanding user needs, providing helpful responses, and maintaining engaging conversations. You remember previous interactions to provide a personalized experience.",
            llm=LLM("azure/gpt-4.1"),
            verbose=False
        )
        chat_task = Task(
            description="Respond to user conversation. User message: {user_msg}",
            expected_output="Contextually appropriate, helpful, and friendly response.",
            agent=chat_agent
        )
