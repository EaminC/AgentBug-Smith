def test_external_memory_search_with_mem0():
    """
    This test verifies that ExternalMemory configured with mem0 provider
    can perform search without raising errors.

    It uses dummy API keys and mocks the internal network call by invoking the real search method.

    The test fails on the buggy codebase if the search parameters are malformed,
    and passes after the fix.
    """

    chat_agent = Agent(
        role="Friendly chatbot assistant",
        goal="Engage in useful and interesting conversations with users while remembering context.",
        backstory="You are a kind and knowledgeable chatbot assistant.",
        llm=LLM("azure/gpt-4.1"),
        verbose=False,
    )

    chat_task = Task(
        description="Respond to user conversation. User message: {user_msg}",
        expected_output="Contextually appropriate, helpful, and friendly response.",
        agent=chat_agent,
    )

    external_memory = ExternalMemory(
        embedder_config={
            "provider": "mem0",
            "config": {
                "user_id": "user-123",
                "org_id": os.getenv("MEM0_ORG_ID"),
                "project_id": os.getenv("MEM0_PROJECT_ID"),
                "api_key": os.getenv("MEM0_API_KEY"),
            },
        }
    )

    # Perform a search, should not raise error and return a list
    try:
        results = external_memory.search("test query", limit=3, score_threshold=0.5)
    except Exception as e:
        pytest.fail(f"ExternalMemory.search raised an exception: {e}")

    assert isinstance(results, list), "Search results should be a list"

