[32mFROM python:3.12-slim

# Set working directory
WORKDIR /app

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    build-essential \
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Copy all files into container
COPY . .

# Install Python dependencies with editable install and test dependencies
RUN pip install -e . \
    && pip install pytest pytest-asyncio pytest-mock pytest-subprocess pytest-xdist pytest-timeout pytest-recording pytest-randomly pytest-split vcrpy "setuptools<=81.0.0" litellm json_repair

# Set PYTHONPATH to include the base app directory and lib folder for imports
ENV PYTHONPATH=/app:/app/lib

# Default command to open bash shell
CMD ["/bin/bash"]

# branch: python/pyproject.toml with editable install and Forge API env vars, test deps with correct quoting
