ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Install system dependencies needed for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies from pyproject.toml (poetry) or requirements.txt or pip install
RUN if [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm; \
    elif [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm; \
    else \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm; \
    fi

# Set PYTHONPATH to include /app and src directories if they exist for correct imports
RUN if [ -d "/app/lib/crewai/src" ]; then \
        echo "Setting PYTHONPATH to /app:/app/lib/crewai/src"; \
        echo "export PYTHONPATH=/app:/app/lib/crewai/src" >> /etc/profile.d/pythonpath.sh; \
        export PYTHONPATH=/app:/app/lib/crewai/src; \
    elif [ -d "/app/lib/crewai-tools/src" ]; then \
        echo "Setting PYTHONPATH to /app:/app/lib/crewai-tools/src"; \
        echo "export PYTHONPATH=/app:/app/lib/crewai-tools/src" >> /etc/profile.d/pythonpath.sh; \
        export PYTHONPATH=/app:/app/lib/crewai-tools/src; \
    else \
        echo "Setting PYTHONPATH to /app"; \
        echo "export PYTHONPATH=/app" >> /etc/profile.d/pythonpath.sh; \
        export PYTHONPATH=/app; \
    fi
ENV PYTHONPATH=/app

# Default to bash for test harness and interactive usage
CMD ["/bin/bash"]

