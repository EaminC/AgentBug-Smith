[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Install system dependencies needed for Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies if requirements.txt exists, then install repo in editable mode and testing tools
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm; \
    else \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm; \
    fi

# Set PYTHONPATH environment variable and append /app/src if src directory exists
ENV PYTHONPATH=/app
RUN if [ -d "src" ]; then \
        echo "src directory found, appending to PYTHONPATH"; \
        export PYTHONPATH=/app:/app/src; \
    fi

# Default command to keep container alive
CMD ["/bin/bash"]

