[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Set Forge API environment variables for OpenAI and Anthropic compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV FORGE_API_KEY=forge-key

# Install system dependencies needed for building Python packages and testing
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    build-essential \
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Install dependencies with pip: prefer requirements.txt if exists, else just install editable package
# Also install pytest and testing dependencies explicitly (removed pytest-block-network due to package not found error)
RUN if [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt && pip install -e .; \
    else \
    pip install -e .; \
    fi && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm chromadb

# Set PYTHONPATH environment variable depending on src/ directory presence to support imports
RUN if [ -d "src" ]; then \
    echo "export PYTHONPATH=/app:/app/src" >> /etc/profile.d/pythonpath.sh; \
    else \
    echo "export PYTHONPATH=/app" >> /etc/profile.d/pythonpath.sh; \
    fi
ENV PYTHONPATH=/app

# Default command to open bash shell
CMD ["/bin/bash"]

# branch: python with pip install, Forge API env vars, pytest and test deps, PYTHONPATH set
