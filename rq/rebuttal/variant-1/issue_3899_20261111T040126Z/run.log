ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Set Forge API environment variables for OpenAI and Anthropic compatibility
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Install system dependencies needed for building Python packages and testing
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    build-essential \
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Install project dependencies if requirements.txt exists,
# then install project editable package
# then install testing dependencies including missing "json_repair"
RUN if [ -f "requirements.txt" ]; then pip install -r requirements.txt; fi \
    && pip install -e . \
    && pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm json_repair

# Set PYTHONPATH to include source directories for correct imports in tests
ENV PYTHONPATH=/app:/app/lib/crewai/src:/app/lib/crewai-tools/src

# Default command to open bash shell
CMD ["/bin/bash"]

