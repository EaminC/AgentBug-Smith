    class MockResponse:
        is_a2a = True
        message = "Please help"
        a2a_ids = ["http://test-endpoint.com/"]

    # Patch internal calls to simulate A2A delegation and agent cards
    import builtins

    # We patch execute_a2a_delegation and _fetch_agent_cards_concurrently by monkeypatching
    # inside the wrapper module namespace.
    import crewai.a2a.wrapper as wrapper

    def fake_execute_a2a_delegation(*args, **kwargs):
        return {
            "status": "completed",
            "result": "Done by remote",
            "history": [],
        }

    def fake_fetch_agent_cards_concurrently(*args, **kwargs):
        class DummyCard:
            name = "Test"
        return ({"http://test-endpoint.com/": DummyCard()}, {})

    wrapper.execute_a2a_delegation = fake_execute_a2a_delegation
    wrapper._fetch_agent_cards_concurrently = fake_fetch_agent_cards_concurrently

    # Define original_fn behavior depending on trust_flag
    call_count = 0

    def original_fn(self, task, context, tools):
        nonlocal call_count
        call_count += 1
        if trust_flag is False:
            # Simulate server agent final answer
            return '{"is_a2a": false, "message": "Server final answer", "a2a_ids": []}'
        # If trust_flag True, original_fn should not be called
        raise RuntimeError("original_fn should not be called when trust_remote_completion_status=True")

    if trust_flag:
        # When trust_flag True, original_fn should not be called
        result = _delegate_to_a2a(
            self=agent,
            agent_response=MockResponse(),
            task=task,
            original_fn=original_fn,
            context=None,
            tools=None,
            agent_cards={"http://test-endpoint.com/": types.SimpleNamespace(name="Test")},
            original_task_description="test",
        )
        assert result == expected_result
        assert call_count == 0
    else:
        # When trust_flag False, original_fn should be called at least once
        result = _delegate_to_a2a(
            self=agent,
            agent_response=MockResponse(),
            task=task,
            original_fn=original_fn,
            context=None,
            tools=None,
            agent_cards={"http://test-endpoint.com/": types.SimpleNamespace(name="Test")},
            original_task_description="test",
        )
        assert call_count >= 1
        assert result == expected_result


