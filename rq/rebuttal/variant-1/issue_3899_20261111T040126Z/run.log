[32mimport pytest
from crewai.a2a.config import A2AConfig


@pytest.mark.parametrize("trust_flag,expected_result", [
    (True, "Done by remote"),
    (False, "Server final answer"),
])
def test_a2a_delegate_trust_remote_completion_status_behavior(trust_flag, expected_result):
    """
    Test that when trust_remote_completion_status is True, the _delegate_to_a2a function returns
    the remote agent's completed result directly, preventing repeated delegation.
    When False, it allows the server agent to handle the response, possibly delegating again.
    """
    from crewai.a2a.wrapper import _delegate_to_a2a
    from crewai import Agent, Task

    a2a_config = A2AConfig(
        endpoint="http://dummy-endpoint",
        trust_remote_completion_status=trust_flag,
    )

    agent = Agent(
        role="test role",
        goal="test goal",
        backstory="test backstory",
        a2a=a2a_config,
    )

    task = Task(description="test task", expected_output="expected", agent=agent)

    class MockResponse:
        is_a2a = True
        message = "dummy message"
        a2a_ids = ["http://dummy-endpoint/"]

    # We patch the internal calls to simulate the remote A2A agent response and cards
    import crewai.a2a.wrapper as wrapper_module

    # Patch execute_a2a_delegation to always return a completed status with a result
    def fake_execute_a2a_delegation(*args, **kwargs):
        return {
            "status": "completed",
            "result": "Done by remote",
            "history": [],
        }

    # Patch _fetch_agent_cards_concurrently to return a dummy agent card
    class DummyCard:
        name = "dummy"

    def fake_fetch_agent_cards_concurrently(*args, **kwargs):
        return ({"http://dummy-endpoint": DummyCard()}, {})

    # Patch the original_fn fallback to simulate server agent response when trust_flag is False
    call_counter = {"count": 0}

    def fake_original_fn(self, task, context, tools):
        call_counter["count"] += 1
        return '{"is_a2a": false, "message": "Server final answer", "a2a_ids": []}'

    # Apply patches by monkeypatching the module attributes
    original_execute = wrapper_module.execute_a2a_delegation
    original_fetch = wrapper_module._fetch_agent_cards_concurrently

    wrapper_module.execute_a2a_delegation = fake_execute_a2a_delegation
    wrapper_module._fetch_agent_cards_concurrently = fake_fetch_agent_cards_concurrently

    try:
        result = _delegate_to_a2a(
            self=agent,
            agent_response=MockResponse(),
            task=task,
            original_fn=fake_original_fn,
            context=None,
            tools=None,
            agent_cards={"http://dummy-endpoint": DummyCard()},
            original_task_description="test task",
        )
    finally:
        # Restore original functions
        wrapper_module.execute_a2a_delegation = original_execute
        wrapper_module._fetch_agent_cards_concurrently = original_fetch

    if trust_flag:
        # When trust_remote_completion_status=True, result should be remote's result directly
        assert result == "Done by remote"
        # The original_fn fallback should not be called
        assert call_counter["count"] == 0
    else:
        # When trust_remote_completion_status=False, server agent handles response
        assert result == "Server final answer"
        # The fallback original_fn should be called at least once
        assert call_counter["count"] >= 1


def test_a2a_config_default_trust_remote_completion_status_false():
    """Verify that the default value of trust_remote_completion_status is False."""
    config = A2AConfig(endpoint="http://dummy-endpoint")
    assert config.trust_remote_completion_status is False[0m
