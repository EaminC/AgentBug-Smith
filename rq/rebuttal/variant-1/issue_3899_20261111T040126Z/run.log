from crewai.a2a.config import A2AConfig


@pytest.mark.parametrize(
    "trust_flag,expected_result",
    [
        (True, "Done by remote"),
        (False, "Server final answer"),
    ],
)
def test_a2a_delegate_trust_remote_completion_status_behavior(trust_flag, expected_result):
    """
    Test that when trust_remote_completion_status is True, the _delegate_to_a2a function
    returns the remote agent's completed result directly, avoiding repeated delegation.
    When False, the server agent processes the response and returns its own answer.
    """
    from crewai.a2a.wrapper import _delegate_to_a2a
    from crewai import Agent, Task

    a2a_config = A2AConfig(
        endpoint="http://test-endpoint.com",
        trust_remote_completion_status=trust_flag,
    )

    agent = Agent(
        role="test manager",
        goal="coordinate",
        backstory="test",
        a2a=a2a_config,
    )

    task = Task(description="test", expected_output="test", agent=agent)

    class MockResponse:
        is_a2a = True
        message = "Please help"
        a2a_ids = ["http://test-endpoint.com/"]

    call_count = 0

    def mock_original_fn(self, task, context, tools):
        nonlocal call_count
        call_count += 1
        if trust_flag is False:
            # Server returns its own final answer on first call
            return '{"is_a2a": false, "message": "Server final answer", "a2a_ids": []}'
        # Should not be called when trust_flag is True
        return "unexpected"

    # Patch internal calls to simulate A2A delegation and agent cards
    import builtins
    import types

    # Patch execute_a2a_delegation to simulate remote agent response
    import crewai.a2a.wrapper as wrapper_module

    original_execute_a2a_delegation = wrapper_module.execute_a2a_delegation
    original_fetch_agent_cards_concurrently = wrapper_module._fetch_agent_cards_concurrently

    def fake_execute_a2a_delegation(*args, **kwargs):
        return {
            "status": "completed",
            "result": "Done by remote",
            "history": [],
        }

    def fake_fetch_agent_cards_concurrently(*args, **kwargs):
        class DummyCard:
            name = "Test"

        return ({"http://test-endpoint.com/": DummyCard()}, {})

    wrapper_module.execute_a2a_delegation = fake_execute_a2a_delegation
    wrapper_module._fetch_agent_cards_concurrently = fake_fetch_agent_cards_concurrently

    try:
        result = _delegate_to_a2a(
            self=agent,
            agent_response=MockResponse(),
            task=task,
            original_fn=mock_original_fn,
            context=None,
            tools=None,
            agent_cards={"http://test-endpoint.com/": types.SimpleNamespace(name="Test")},
            original_task_description="test",
        )
    finally:
        wrapper_module.execute_a2a_delegation = original_execute_a2a_delegation
        wrapper_module._fetch_agent_cards_concurrently = original_fetch_agent_cards_concurrently

    assert result == expected_result
    if trust_flag is False:
        assert call_count >= 1
    else:
        assert call_count == 0


