ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Environment variables for Forge API usage
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    FORGE_API_KEY=forge-key \
    FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"

# Install system dependencies needed for building some Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies and the package itself
RUN if [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt && pip install -e .; \
elif [ -f "pyproject.toml" ] && [ ! -f "poetry.lock" ]; then \
    pip install -e .; \
else \
    pip install -e .; \
fi

# Install test dependencies including pytest and fixed setuptools version
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout setuptools==81.0.0 litellm json_repair

# Set PYTHONPATH including src paths for correct imports
ENV PYTHONPATH=/app:/app/lib/crewai/src:/app/lib/crewai-tools/src

# Default to bash shell for interactive and test environment usage
CMD ["/bin/bash"]

# branch: python/src layout with Forge API environment setup and fixed package install syntax
