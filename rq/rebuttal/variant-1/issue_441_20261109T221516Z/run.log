[32mimport unittest
from agentscope.message import Msg
from agentscope.models.ollama_model import OllamaChatWrapper


class OllamaChatWrapperRoleTest(unittest.TestCase):
    def test_format_role_user_instead_of_system(self):
        """
        Test that OllamaChatWrapper.format returns a list with a single dict
        where the role is 'user' (not 'system') and the content includes the
        system prompt and conversation history.

        This test fails on the buggy codebase where the role is 'system',
        causing the test to fail due to mismatch.
        After the fix, the role is corrected to 'user' and the test passes.
        """
        system_msg = Msg("system", "You are a helpful assistant", role="system")
        conversation = [
            Msg("user", "What is the weather today?", role="user"),
            Msg("assistant", "It is sunny today", role="assistant"),
        ]

        model = OllamaChatWrapper(config_name="", model_name="llama2")

        formatted = model.format(system_msg, conversation)
        self.assertIsInstance(formatted, list)
        self.assertEqual(len(formatted), 1)
        message = formatted[0]
        self.assertIsInstance(message, dict)
        self.assertIn("role", message)
        self.assertIn("content", message)

        # The role must be "user" (not "system") as per the fix
        self.assertEqual(message["role"], "user")

        # The content should include the system message and conversation history
        content = message["content"]
        self.assertIn("You are a helpful assistant", content)
        self.assertIn("user: What is the weather today?", content)
        self.assertIn("assistant: It is sunny today", content)


if __name__ == "__main__":
    unittest.main()[0m
