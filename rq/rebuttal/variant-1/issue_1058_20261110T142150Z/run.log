# Set working directory
WORKDIR /app

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Upgrade pip, setuptools, wheel
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install system dependencies needed for Python build
RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Install project dependencies (check requirements.txt fallback, no requirements.txt seen)
RUN if [ -f "requirements.txt" ]; then \
        pip install --no-cache-dir -r requirements.txt; \
    fi

# Always install project package editable
RUN pip install --no-cache-dir -e .

# Additional testing and common dependencies
RUN pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout \
    setuptools<=81.0.0 litellm mem0ai vcrpy json_repair chromadb syrupy respx langgraph-checkpoint-sqlite \
    aiosqlite langgraph-checkpoint-postgres "psycopg[binary,pool]" redis apscheduler fastapi fakeredis mcp "ray[default]" boto3 agno pydantic-ai fastmcp

# PYTHONPATH for src/ layout
ENV PYTHONPATH=/app:/app/src

# Default to bash shell for container
CMD ["/bin/bash"]

