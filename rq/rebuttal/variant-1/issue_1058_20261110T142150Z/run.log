# --- Environment variables for Forge API compatibility ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"

# Set working directory
WORKDIR /app

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies for building Python packages
RUN apt-get update \
    && apt-get install -y gcc python3-dev libffi-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository to /app
COPY . .

# Install Python dependencies and the package itself, including full and dev extras (to fix missing optional deps)
RUN if [ -f "requirements.txt" ]; then \
        pip install --no-cache-dir -r requirements.txt; \
        pip install --no-cache-dir -e .; \
    elif [ -f "pyproject.toml" ]; then \
        pip install --no-cache-dir .[full,dev]; \
    else \
        pip install --no-cache-dir -e .; \
    fi

# Install testing and common Python dependencies explicitly
RUN pip install --no-cache-dir \
    pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout pytest-block-network \
    "setuptools<=81.0.0" litellm mem0ai vcrpy json_repair chromadb syrupy respx langgraph-checkpoint-sqlite \
    aiosqlite langgraph-checkpoint-postgres "psycopg[binary,pool]" redis apscheduler fastapi fakeredis mcp \
    "ray[default]" boto3 agno pydantic-ai fastmcp

# Set PYTHONPATH for src/ layout (src directory exists)
ENV PYTHONPATH=/app:/app/src

# Default to bash shell for the container
CMD ["/bin/bash"]

# branch: python/pyproject.toml with full and dev extras for testing
