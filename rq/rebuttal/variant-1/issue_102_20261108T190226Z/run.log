import importlib
import sys
import pytest

def test_import_agentscope_web_studio():
    """
    Test that the package agentscope.web.studio is importable.
    This will fail if __init__.py is missing in the studio directory.
    """
    # Remove from sys.modules if already imported to force re-import
    modules_to_remove = [m for m in sys.modules if m.startswith("agentscope.web.studio")]
    for m in modules_to_remove:
        del sys.modules[m]

    # Try to import the package
    module = importlib.import_module("agentscope.web.studio")

    # Assert that the module is not None and has expected attributes (if any)
    assert module is not None
    # The module should be a package (have __path__)
    assert hasattr(module, "__path__")
    # The module name should be exactly as expected
    assert module.__name__ == "agentscope.web.studio"
