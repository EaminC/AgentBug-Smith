import importlib
import sys
import pytest

def test_import_agentscope_web_studio():
    """
    Test that the package agentscope.web.studio can be imported.
    This will fail if __init__.py is missing in the agentscope.web.studio directory.
    """
    module_name = "agentscope.web.studio"
    if module_name in sys.modules:
        del sys.modules[module_name]
    try:
        mod = importlib.import_module(module_name)
    except ModuleNotFoundError as e:
        pytest.fail(f"Failed to import module '{module_name}': {e}")
    # The module should have __path__ attribute as a package
    assert hasattr(mod, "__path__"), f"{module_name} is not recognized as a package"
    # The module path should include the studio directory
    paths = list(mod.__path__)
    assert any("studio" in p for p in paths), f"{module_name}.__path__ does not contain 'studio' directory"
