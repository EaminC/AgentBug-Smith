[32mimport os
import tempfile
import uuid

import pytest

from mle.utils.memory import LanceDBMemory


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for the LanceDB database
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir)
        yield mem


def test_list_all_keys_and_get_and_delete_by_metadata(memory_instance):
    mem = memory_instance
    table_name = mem.table_name

    # Prepare test data
    records = [
        {"id": str(uuid.uuid4()), "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": str(uuid.uuid4()), "text": "goodbye world", "metadata": {"tag": "farewell"}},
        {"id": str(uuid.uuid4()), "text": "hello again", "metadata": {"tag": "greeting"}},
    ]

    # Clear table if exists
    if table_name in mem.client.table_names():
        mem.drop(table_name)

    # Add records
    mem.client.create_table(table_name, data=records)
    mem.client.open_table(table_name).create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys(table_name)
    assert set(keys) == set(r["id"] for r in records)

    # Test get returns the correct record by id
    for record in records:
        result = mem.get(record["id"], table_name)
        assert len(result) == 1
        assert result[0]["id"] == record["id"]
        assert result[0]["text"] == record["text"]
        assert result[0]["metadata"] == record["metadata"]

    # Test get returns empty list for non-existing id
    result = mem.get("non-existing-id", table_name)
    assert result == []

    # Test get_by_metadata returns correct records
    greeting_records = mem.get_by_metadata("tag", "greeting", table_name)
    greeting_ids = {r["id"] for r in greeting_records}
    expected_greeting_ids = {r["id"] for r in records if r["metadata"]["tag"] == "greeting"}
    assert greeting_ids == expected_greeting_ids

    # Test delete_by_metadata deletes records with given metadata
    deleted = mem.delete_by_metadata("tag", "farewell", table_name)
    assert deleted is True or deleted is False  # Accept bool return, but deletion should be attempted

    # After deletion, records with tag "farewell" should be gone
    remaining_records = mem.client.open_table(table_name).search(query_type="fts").to_list()
    remaining_ids = {r["id"] for r in remaining_records}
    assert all(r["metadata"]["tag"] != "farewell" for r in remaining_records)
    assert all(r["id"] in remaining_ids for r in remaining_ids)

    # The farewell record id should no longer be in keys
    farewell_ids = {r["id"] for r in records if r["metadata"]["tag"] == "farewell"}
    assert farewell_ids.isdisjoint(remaining_ids)

    # Test delete deletes a record by id
    to_delete_id = records[0]["id"]
    deleted_ok = mem.delete(to_delete_id, table_name)
    assert deleted_ok is True or deleted_ok is False

    # Confirm deletion
    post_delete_result = mem.get(to_delete_id, table_name)
    assert post_delete_result == []


def test_drop_table(memory_instance):
    mem = memory_instance
    table_name = mem.table_name

    # Create table with some data
    data = [{"id": str(uuid.uuid4()), "text": "sample", "metadata": {"key": "value"}}]
    if table_name in mem.client.table_names():
        mem.drop(table_name)
