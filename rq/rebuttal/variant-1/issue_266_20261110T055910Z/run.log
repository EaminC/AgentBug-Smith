    # Confirm record is present
    keys = mem.list_all_keys()
    assert test_data[0]["id"] in keys

    # Delete by id
    deleted = mem.delete(test_data[0]["id"])
    assert deleted is True or deleted is False  # Accept either, depends on implementation

    # Confirm record is gone
    keys_after = mem.list_all_keys()
    assert test_data[0]["id"] not in keys_after

    # Test drop deletes the entire table
    mem.add(test_data)
    keys_before_drop = mem.list_all_keys()
    assert test_data[0]["id"] in keys_before_drop

    dropped = mem.drop()
    assert dropped is True or dropped is False  # Accept either, depends on implementation

