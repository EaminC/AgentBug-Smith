def test_add_and_list_all_keys(memory_instance):
    mem = memory_instance

    # Clear any existing data for a clean test
    mem.drop("test_memory")

    # Add sample data
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"tag": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"tag": "latin"}},
    ]
    mem.add(records, table_name="test_memory")

    # List all keys
    keys = mem.list_all_keys("test_memory")

    # The keys returned should match the ids added
    assert set(keys) == {"id1", "id2", "id3"}


def test_get_record_by_id(memory_instance):
    mem = memory_instance

    # Add a record
    record = {"id": "unique_id", "text": "some text here", "metadata": {"category": "example"}}
    mem.add([record], table_name="test_memory")

    # Retrieve by id
    result = mem.get("unique_id", table_name="test_memory")

    # Result should be a list with one dict matching the record id
    assert isinstance(result, list)
    assert len(result) == 1
    assert result[0]["id"] == "unique_id"
    assert result[0]["text"] == "some text here"


def test_get_by_metadata(memory_instance):
    mem = memory_instance

    # Add records with metadata
    records = [
        {"id": "m1", "text": "data one", "metadata": {"type": "alpha"}},
        {"id": "m2", "text": "data two", "metadata": {"type": "beta"}},
        {"id": "m3", "text": "data three", "metadata": {"type": "alpha"}},
    ]
    mem.add(records, table_name="test_memory")

    # Query by metadata key-value
    results = mem.get_by_metadata("type", "alpha", table_name="test_memory", n_results=10)

    # Should return records with type alpha
    ids = {r["id"] for r in results}
    assert "m1" in ids
    assert "m3" in ids
    assert "m2" not in ids


