import uuid
from mle.utils.memory import LanceDBMemory


@pytest.fixture(scope="module")
def memory_instance(tmp_path_factory):
    # Create a LanceDBMemory instance with a temporary directory
    tmp_dir = tmp_path_factory.mktemp("memory_test")
    mem = LanceDBMemory(project_path=str(tmp_dir))
    yield mem
    # Cleanup: drop the table after tests
    mem.drop()


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance
    table_name = mem.table_name

    # Prepare test data
    test_records = [
        {"id": str(uuid.uuid4()), "text": "Hello world", "metadata": {"category": "greeting"}},
        {"id": str(uuid.uuid4()), "text": "Goodbye world", "metadata": {"category": "farewell"}},
        {"id": str(uuid.uuid4()), "text": "Hello again", "metadata": {"category": "greeting"}},
    ]

    # Add records to memory
    mem.client.drop_table(table_name) if table_name in mem.client.table_names() else None
    mem.client.create_table(table_name, data=test_records)
    table = mem.client.open_table(table_name)
    table.create_fts_index("id")

    # Test list_all_keys returns all inserted ids
    keys = mem.list_all_keys()
    assert set(keys) == {rec["id"] for rec in test_records}

    # Test get returns correct record by id
    for rec in test_records:
        result = mem.get(rec["id"])
        assert len(result) == 1
        assert result[0]["id"] == rec["id"]
        assert result[0]["text"] == rec["text"]

    # Test get returns empty list for unknown id
    unknown_id = str(uuid.uuid4())
    result = mem.get(unknown_id)
    assert result == []

def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance
    table_name = mem.table_name

    # Prepare test data
    test_records = [
        {"id": str(uuid.uuid4()), "text": "Apple pie", "metadata": {"type": "dessert"}},
        {"id": str(uuid.uuid4()), "text": "Banana split", "metadata": {"type": "dessert"}},
        {"id": str(uuid.uuid4()), "text": "Caesar salad", "metadata": {"type": "salad"}},
    ]

    # Reset table with test data
    mem.client.drop_table(table_name) if table_name in mem.client.table_names() else None
    mem.client.create_table(table_name, data=test_records)
    table = mem.client.open_table(table_name)
    table.create_fts_index("id")

    # Test get_by_metadata returns correct records
    desserts = mem.get_by_metadata("type", "dessert", n_results=10)
    dessert_ids = {d["id"] for d in desserts}
    expected_dessert_ids = {rec["id"] for rec in test_records if rec["metadata"]["type"] == "dessert"}
    assert dessert_ids == expected_dessert_ids

    # Test delete_by_metadata removes correct records
    delete_result = mem.delete_by_metadata("type", "dessert")
    assert delete_result is True or delete_result is False  # Accept bool result

    # After deletion, no dessert records should remain
    remaining = mem.get_by_metadata("type", "dessert", n_results=10)
    assert remaining == []

    # Non-dessert records should remain
    salads = mem.get_by_metadata("type", "salad", n_results=10)
    assert len(salads) == 1
    assert salads[0]["text"] == "Caesar salad"[0m
