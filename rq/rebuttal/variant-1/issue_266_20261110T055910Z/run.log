    # Test list_all_keys returns all ids
    keys = mem.list_all_keys()
    assert isinstance(keys, list)
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns correct record for id1
    recs = mem.get("id1")
    assert isinstance(recs, list)
    assert len(recs) == 1
    assert recs[0]["id"] == "id1"
    assert recs[0]["text"] == "hello world"
    assert recs[0]["metadata"]["tag"] == "greeting"

    # Test get returns empty list for non-existent id
    recs_none = mem.get("nonexistent")
    assert isinstance(recs_none, list)
    assert len(recs_none) == 0


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance
    # Prepare records
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"category": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"category": "greeting"}},
    ]
    if mem.table_name in mem.client.table_names():
        mem.client.drop_table(mem.table_name)
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test get_by_metadata returns correct records for category=greeting
    results = mem.get_by_metadata("category", "greeting")
    assert isinstance(results, list)
    assert len(results) == 2
    ids = {r["id"] for r in results}
    assert ids == {"id1", "id3"}

    # Test get_by_metadata returns correct records for category=test
    results_test = mem.get_by_metadata("category", "test")
    assert isinstance(results_test, list)
    assert len(results_test) == 1
    assert results_test[0]["id"] == "id2"

    # Test delete_by_metadata deletes records with category=test
    deleted = mem.delete_by_metadata("category", "test")
    # LanceDB delete returns bool or None, accept both but must not be exception or other
    assert deleted is True or deleted is False or deleted is None

    # After deletion, get_by_metadata for category=test should return empty list
    results_after = mem.get_by_metadata("category", "test")
    assert isinstance(results_after, list)
    assert len(results_after) == 0


def test_delete_and_drop(memory_instance):
    mem = memory_instance
    # Prepare records
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"tag": "test"}},
    ]
    if mem.table_name in mem.client.table_names():
        mem.client.drop_table(mem.table_name)
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Delete record id1
    deleted = mem.delete("id1")
    # LanceDB delete returns bool or None, accept both but must not be exception or other
    assert deleted is True or deleted is False or deleted is None

    # After deletion, get should not find id1
    recs = mem.get("id1")
    assert isinstance(recs, list)
    assert len(recs) == 0

    # Drop the entire table
    dropped = mem.drop()
    # LanceDB drop returns bool or None, accept both
    assert dropped is True or dropped is False or dropped is None

    # After drop, table should not exist
    assert mem.table_name not in mem.client.table_names()[0m
