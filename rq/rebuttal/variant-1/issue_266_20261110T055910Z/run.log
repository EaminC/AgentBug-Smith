def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Clear any existing data by dropping the table if exists
    mem.drop("test_memory")

    # Add some test records
    records = [
        {"id": "id1", "query": "query1", "metadata": {"tag": "A"}},
        {"id": "id2", "query": "query2", "metadata": {"tag": "B"}},
        {"id": "id3", "query": "query3", "metadata": {"tag": "A"}},
    ]
    mem.add(records, table_name="test_memory")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys("test_memory")
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns correct record for id1
    result = mem.get("id1", "test_memory")
    assert isinstance(result, list)
    assert len(result) == 1
    assert result[0]["id"] == "id1"
    assert result[0]["query"] == "query1"

    # Test get returns empty list for non-existing id
    result_empty = mem.get("nonexistent_id", "test_memory")
    assert isinstance(result_empty, list)
    assert len(result_empty) == 0


