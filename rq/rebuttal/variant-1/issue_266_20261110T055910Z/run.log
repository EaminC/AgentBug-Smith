    remaining_keys = mem.list_all_keys()
    for item in test_data:
        if item["metadata"]["category"] == "A":
            assert item["id"] not in remaining_keys
        else:
            assert item["id"] in remaining_keys


def test_delete_and_drop(memory_instance):
