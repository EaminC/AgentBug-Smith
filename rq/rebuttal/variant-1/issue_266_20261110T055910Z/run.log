    # Verify record with id 'del2' still exists
    result2 = mem.get("del2", table_name="test_memory")
    assert len(result2) == 1
    assert result2[0]["id"] == "del2"


def test_delete_and_drop(memory_instance):
    mem = memory_instance

    # Add a record
    record = {"id": "to_delete", "text": "will be deleted", "metadata": {}}
    mem.add([record], table_name="test_memory")

    # Delete the record by id
    deleted = mem.delete("to_delete", table_name="test_memory")
    assert deleted is True

    # Confirm deletion
    result = mem.get("to_delete", table_name="test_memory")
    assert result == []

    # Drop the entire table
