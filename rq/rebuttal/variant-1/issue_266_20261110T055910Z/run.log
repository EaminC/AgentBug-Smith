import uuid
from mle.utils.memory import LanceDBMemory

@pytest.fixture(scope="module")
def memory_instance(tmp_path_factory):
    # Create a LanceDBMemory instance with a temporary directory
    tmp_dir = tmp_path_factory.mktemp("lancedb_test")
    mem = LanceDBMemory(project_path=str(tmp_dir))
    # Ensure the table is clean before tests
    mem.drop()
    yield mem
    # Cleanup after tests
    mem.drop()

def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Prepare test data
    records = [
        {"id": str(uuid.uuid4()), "text": "Hello world", "metadata": {"tag": "greeting"}},
        {"id": str(uuid.uuid4()), "text": "Goodbye world", "metadata": {"tag": "farewell"}},
        {"id": str(uuid.uuid4()), "text": "Hello again", "metadata": {"tag": "greeting"}},
    ]

    # Add records to memory
    mem.add(records)

    # Test list_all_keys returns all inserted ids
    keys = mem.list_all_keys()
    assert set(keys) >= {r["id"] for r in records}, "list_all_keys should return all inserted record ids"

    # Test get returns the correct record for each id
    for record in records:
        result = mem.get(record_id=record["id"])
        assert len(result) == 1, f"get should return exactly one record for id {record['id']}"
        assert result[0]["id"] == record["id"], f"get returned wrong record for id {record['id']}"
        assert result[0]["text"] == record["text"], f"get returned wrong text for id {record['id']}"
        assert result[0]["metadata"] == record["metadata"], f"get returned wrong metadata for id {record['id']}"

def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Prepare test data
    records = [
        {"id": str(uuid.uuid4()), "text": "Alpha", "metadata": {"category": "A"}},
        {"id": str(uuid.uuid4()), "text": "Beta", "metadata": {"category": "B"}},
        {"id": str(uuid.uuid4()), "text": "Gamma", "metadata": {"category": "A"}},
    ]

    # Add records to memory
    mem.add(records)

    # Test get_by_metadata returns correct records
    category_a_records = mem.get_by_metadata("category", "A", n_results=10)
    category_a_ids = {r["id"] for r in category_a_records}
    expected_ids = {r["id"] for r in records if r["metadata"]["category"] == "A"}
    assert category_a_ids == expected_ids, "get_by_metadata should return all records with matching metadata"

    # Test delete_by_metadata deletes the correct records
    success = mem.delete_by_metadata("category", "A")
    assert success, "delete_by_metadata should return True on success"

    # After deletion, records with category A should be gone
    remaining_keys = mem.list_all_keys()
    for rid in expected_ids:
        assert rid not in remaining_keys, "Records with deleted metadata should be removed"

    # Records with category B should remain
    remaining_b_ids = {r["id"] for r in records if r["metadata"]["category"] == "B"}
    assert remaining_b_ids.issubset(set(remaining_keys)), "Records with other metadata should remain"

def test_delete_and_drop(memory_instance):
    mem = memory_instance

    # Add a record
    record = {"id": str(uuid.uuid4()), "text": "To be deleted", "metadata": {"temp": "yes"}}
    mem.add([record])

    # Confirm record is present
    keys = mem.list_all_keys()
    assert record["id"] in keys

    # Delete the record by id
    deleted = mem.delete(record_id=record["id"])
    assert deleted, "delete should return True on successful deletion"

    # Confirm record is gone
    keys_after_delete = mem.list_all_keys()
    assert record["id"] not in keys_after_delete

    # Drop the entire table
    dropped = mem.drop()
    assert dropped, "drop should return True on successful drop"

    # After drop, listing keys should raise or return empty list
    # We allow either behavior depending on implementation
    try:
        keys_after_drop = mem.list_all_keys()
        assert keys_after_drop == [], "After drop, list_all_keys should return empty list"
    except Exception:
        # If error raised, also acceptable
        pass[0m
