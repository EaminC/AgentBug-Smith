    keys = mem.list_all_keys(table_name)
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns correct record by id
    rec = mem.get("id2", table_name)
    assert len(rec) == 1
    assert rec[0]["id"] == "id2"
    assert rec[0]["text"] == "goodbye world"
    assert rec[0]["metadata"]["tag"] == "farewell"

    # Test get returns empty list for missing id
    rec_none = mem.get("nonexistent_id", table_name)
    assert rec_none == []

    # Test get_by_metadata returns correct records
    greeting_recs = mem.get_by_metadata("tag", "greeting", table_name)
    assert len(greeting_recs) == 2
    assert all(r["metadata"]["tag"] == "greeting" for r in greeting_recs)

    # Test delete_by_metadata deletes correct records
    result = mem.delete_by_metadata("tag", "farewell", table_name)
    assert result is True or result is None  # depending on implementation may return None or True

    # After deletion, keys should not include id2
    keys_after_delete = mem.list_all_keys(table_name)
    assert "id2" not in keys_after_delete
    assert "id1" in keys_after_delete
    assert "id3" in keys_after_delete

    # Cleanup
    mem.drop(table_name)[0m
