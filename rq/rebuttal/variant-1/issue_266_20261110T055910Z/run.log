    assert rec[0]["text"] == "goodbye world"
    assert rec[0]["metadata"]["tag"] == "farewell"

    # Test get by id for non-existent id returns empty list
    rec_none = mem.get("nonexistentid")
    assert rec_none == []

    # Test get_by_metadata returns correct records
