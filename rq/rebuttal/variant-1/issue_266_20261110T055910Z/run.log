WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libc6-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy the entire repository to the container
COPY . .

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies if requirements.txt exists
RUN if [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt; \
    fi

# Install the project and testing dependencies with proper quoting
RUN pip install -e . && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm

# Set PYTHONPATH for module imports
ENV PYTHONPATH=/app

# Default command to keep container open with bash shell
CMD ["/bin/bash"]

