import pytest
from mle.utils.memory import LanceDBMemory


@pytest.fixture(scope="module")
def memory_instance():
    # Patch get_config to avoid NotImplementedError in LanceDBMemory.__init__
    import mle.utils.memory as memory_module

    def dummy_get_config(project_path):
        return {"platform": "OpenAI", "api_key": "dummy_api_key"}

    original_get_config = memory_module.get_config
    memory_module.get_config = dummy_get_config

    # Create a temporary directory for LanceDB storage
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir)
        yield mem

    # Restore original get_config
    memory_module.get_config = original_get_config


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance
    # Add some records
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"tag": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"tag": "latin"}},
    ]
    # Add records to LanceDBMemory table
    # LanceDBMemory add expects data with keys: id, text, metadata
    mem.client.drop_table(mem.table_name) if mem.table_name in mem.client.table_names() else None
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys()
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns the correct record for id2
    result = mem.get("id2")
    assert isinstance(result, list)
    assert len(result) == 1
    assert result[0]["id"] == "id2"
    assert result[0]["text"] == "foo bar"
    assert result[0]["metadata"]["tag"] == "test"

    # Test get returns empty list for non-existent id
    result_empty = mem.get("nonexistent_id")
    assert isinstance(result_empty, list)
    assert len(result_empty) == 0


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance
    mem.client.drop_table(mem.table_name) if mem.table_name in mem.client.table_names() else None
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"category": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"category": "greeting"}},
    ]
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test get_by_metadata returns correct records for category=greeting
    results = mem.get_by_metadata("category", "greeting")
    assert isinstance(results, list)
    assert len(results) == 2
    ids = {r["id"] for r in results}
    assert ids == {"id1", "id3"}

    # Test delete_by_metadata deletes records with category=test
    deleted = mem.delete_by_metadata("category", "test")
    assert deleted is True or deleted is False  # LanceDB delete returns bool, accept either

    # After deletion, get_by_metadata for category=test should return empty
    results_after = mem.get_by_metadata("category", "test")
    assert isinstance(results_after, list)
    assert len(results_after) == 0


def test_delete_and_drop(memory_instance):
    mem = memory_instance
    mem.client.drop_table(mem.table_name) if mem.table_name in mem.client.table_names() else None
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"tag": "test"}},
    ]
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Delete record id1
    deleted = mem.delete("id1")
    assert deleted is True or deleted is False

    # After deletion, get for id1 should return empty
    result = mem.get("id1")
    assert isinstance(result, list)
    assert len(result) == 0

    # Drop the entire table
    dropped = mem.drop()
    assert dropped is True or dropped is False

    # After drop, table should not exist
    assert mem.table_name not in mem.client.table_names()[0m
