import tempfile
import pytest
from mle.utils.memory import LanceDBMemory


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for the LanceDB database
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Clear table if exists
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add some records
    records = [
        {"id": "rec1", "text": "Hello world", "metadata": {"tag": "greeting"}},
        {"id": "rec2", "text": "Goodbye world", "metadata": {"tag": "farewell"}},
        {"id": "rec3", "text": "Hello again", "metadata": {"tag": "greeting"}},
    ]
    mem.add(records, table_name=mem.table_name)

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys()
    assert set(keys) == {"rec1", "rec2", "rec3"}

    # Test get returns the correct record by id
    rec1 = mem.get("rec1")
    assert isinstance(rec1, list)
    assert len(rec1) == 1
    assert rec1[0]["id"] == "rec1"
    assert rec1[0]["text"] == "Hello world"

    # Test get returns empty list for non-existent id
    rec_none = mem.get("nonexistent")
    assert rec_none == []

    # Test get_by_metadata returns correct records
    greetings = mem.get_by_metadata("tag", "greeting")
    assert isinstance(greetings, list)
    assert len(greetings) == 2
    ids = {r["id"] for r in greetings}
    assert ids == {"rec1", "rec3"}

    # Test delete_by_metadata removes records correctly
    deleted = mem.delete_by_metadata("tag", "farewell")
    assert deleted is True or deleted is False  # depends on backend, but should not error

    # After deletion, rec2 should not be found
    keys_after_delete = mem.list_all_keys()
    assert "rec2" not in keys_after_delete
    assert "rec1" in keys_after_delete
    assert "rec3" in keys_after_delete

    # Clean up
    mem.drop(mem.table_name)[0m
