        mem = LanceDBMemory(table_name="test_memory", client_path=tmpdir)
        yield mem
        # Cleanup: drop the test table after tests
        mem.drop("test_memory")


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Prepare test data
    records = [
        {"id": "rec1", "metadata": {"tag": "alpha"}, "content": "First record"},
        {"id": "rec2", "metadata": {"tag": "beta"}, "content": "Second record"},
        {"id": "rec3", "metadata": {"tag": "alpha"}, "content": "Third record"},
    ]

    # Add records to the memory
    mem.delete("rec1")
    mem.delete("rec2")
    mem.delete("rec3")
    mem.add(records, table_name="test_memory")

    # Test list_all_keys returns all IDs
    keys = mem.list_all_keys("test_memory")
    assert set(keys) >= {"rec1", "rec2", "rec3"}, "list_all_keys should include all inserted record IDs"

    # Test get returns the correct record by ID
    rec = mem.get("rec2", "test_memory")
    assert isinstance(rec, list), "get should return a list"
    assert len(rec) == 1, "get should return exactly one record for existing ID"
    assert rec[0]["id"] == "rec2", "get should return record with matching ID"

    # Test get returns empty list for non-existent ID
    rec_none = mem.get("nonexistent_id", "test_memory")
    assert rec_none == [], "get should return empty list for non-existent ID"


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Prepare test data
    records = [
        {"id": "mrec1", "metadata": {"category": "catA"}, "content": "Record A1"},
        {"id": "mrec2", "metadata": {"category": "catB"}, "content": "Record B1"},
        {"id": "mrec3", "metadata": {"category": "catA"}, "content": "Record A2"},
    ]

    # Clean up any existing records with these IDs
    mem.delete("mrec1")
    mem.delete("mrec2")
    mem.delete("mrec3")

    # Add records
    mem.add(records, table_name="test_memory")

    # Test get_by_metadata returns correct records
    catA_records = mem.get_by_metadata("category", "catA", "test_memory", n_results=10)
    catA_ids = {r["id"] for r in catA_records}
    assert catA_ids == {"mrec1", "mrec3"}, "get_by_metadata should return all records with matching metadata"

    # Test delete_by_metadata deletes matching records
    deleted = mem.delete_by_metadata("category", "catA", "test_memory")
    assert deleted is True or deleted is False, "delete_by_metadata should return a boolean"

    # After deletion, records with category catA should be gone
    remaining_catA = mem.get_by_metadata("category", "catA", "test_memory", n_results=10)
    assert remaining_catA == [], "Records with deleted metadata should no longer exist"

    # Records with category catB should remain
    catB_records = mem.get_by_metadata("category", "catB", "test_memory", n_results=10)
    assert len(catB_records) == 1 and catB_records[0]["id"] == "mrec2", "Records with other metadata should remain"


def test_delete_and_drop(memory_instance):
