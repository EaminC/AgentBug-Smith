import uuid
from mle.utils.memory import LanceDBMemory


@pytest.fixture(scope="module")
def memory_instance(tmp_path_factory):
    # Create a LanceDBMemory instance with a temporary directory for isolation
    tmp_dir = tmp_path_factory.mktemp("lancedb_memory_test")
    mem = LanceDBMemory(project_path=str(tmp_dir))
    # Ensure the table is clean before tests
    mem.drop()
    yield mem
    # Cleanup after tests
    mem.drop()


def test_list_all_keys_and_get_methods(memory_instance):
    mem = memory_instance
    table_name = mem.table_name

    # Prepare test data
    records = [
        {
            "id": str(uuid.uuid4()),
            "text": "Hello world",
            "metadata": {"category": "greeting"}
        },
        {
            "id": str(uuid.uuid4()),
            "text": "Goodbye world",
            "metadata": {"category": "farewell"}
        },
        {
            "id": str(uuid.uuid4()),
            "text": "Hello again",
            "metadata": {"category": "greeting"}
        }
    ]

    # Add records to the memory table
    mem.add(records)

    # Test list_all_keys returns all inserted IDs
    keys = mem.list_all_keys()
    assert isinstance(keys, list)
    assert set(keys) >= {r["id"] for r in records}, "list_all_keys should return all inserted record IDs"

    # Test get returns the correct record for each ID
    for record in records:
        result = mem.get(record_id=record["id"])
        assert isinstance(result, list)
        assert len(result) == 1
        assert result[0]["id"] == record["id"]
        assert result[0]["text"] == record["text"]
        assert result[0]["metadata"] == record["metadata"]

    # Test get with non-existent ID returns empty list
    fake_id = str(uuid.uuid4())
    result = mem.get(record_id=fake_id)
    assert isinstance(result, list)
    assert len(result) == 0


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance
    table_name = mem.table_name

    # Prepare test data with distinct metadata values
    records = [
        {
            "id": str(uuid.uuid4()),
            "text": "Data science is fun",
            "metadata": {"topic": "science"}
        },
        {
            "id": str(uuid.uuid4()),
            "text": "I love cooking",
            "metadata": {"topic": "cooking"}
        },
        {
            "id": str(uuid.uuid4()),
            "text": "Science experiments",
            "metadata": {"topic": "science"}
        }
    ]

    # Add records to the memory table
    mem.add(records)

    # Test get_by_metadata returns correct records for topic=science
    science_records = mem.get_by_metadata(key="topic", value="science", n_results=10)
    assert isinstance(science_records, list)
    assert len(science_records) == 2
    for rec in science_records:
        assert rec["metadata"]["topic"] == "science"

    # Test get_by_metadata returns correct records for topic=cooking
    cooking_records = mem.get_by_metadata(key="topic", value="cooking", n_results=10)
    assert isinstance(cooking_records, list)
    assert len(cooking_records) == 1
    assert cooking_records[0]["metadata"]["topic"] == "cooking"

    # Delete records by metadata topic=science
    delete_result = mem.delete_by_metadata(key="topic", value="science")
    assert delete_result is True or delete_result is False  # Should return a boolean

    # After deletion, get_by_metadata for science should return empty or fewer results
    post_delete_science = mem.get_by_metadata(key="topic", value="science", n_results=10)
    assert isinstance(post_delete_science, list)
    assert len(post_delete_science) == 0

    # Records with topic=cooking should still exist
    post_delete_cooking = mem.get_by_metadata(key="topic", value="cooking", n_results=10)
    assert len(post_delete_cooking) == 1
    assert post_delete_cooking[0]["metadata"]["topic"] == "cooking"[0m
