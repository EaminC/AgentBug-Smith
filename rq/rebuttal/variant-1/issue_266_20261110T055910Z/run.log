import pytest
from mle.utils.memory import LanceDBMemory

@pytest.fixture(scope="module")
def memory_instance(tmp_path_factory):
    # Create a LanceDBMemory instance with a temporary directory
    tmp_path = tmp_path_factory.mktemp("memory_test")
    mem = LanceDBMemory(project_path=str(tmp_path))
    # Ensure clean state
    mem.drop()
    yield mem
    # Cleanup after tests
    mem.drop()

def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance
    # Add some records
    records = [
        {"id": str(uuid.uuid4()), "query": "What is AI?", "metadata": {"type": "question"}},
        {"id": str(uuid.uuid4()), "query": "Define ML", "metadata": {"type": "definition"}},
        {"id": str(uuid.uuid4()), "query": "Explain deep learning", "metadata": {"type": "explanation"}},
    ]
    # Add records to LanceDBMemory table
    # The add method expects a list of dicts with keys: id, query, metadata
    mem.add(records)

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys()
    assert set(keys) == set(r["id"] for r in records), "list_all_keys should return all inserted record ids"

    # Test get returns the correct record for each id
    for r in records:
        result = mem.get(r["id"])
        assert len(result) == 1, f"get should return exactly one record for id {r['id']}"
        assert result[0]["id"] == r["id"], f"Returned record id should match requested id {r['id']}"

    # Test get returns empty list for non-existent id
    fake_id = str(uuid.uuid4())
    result = mem.get(fake_id)
    assert result == [], "get should return empty list for non-existent id"

def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance
    mem.drop()
    # Add records with metadata
    records = [
        {"id": str(uuid.uuid4()), "query": "Q1", "metadata": {"category": "A"}},
        {"id": str(uuid.uuid4()), "query": "Q2", "metadata": {"category": "B"}},
        {"id": str(uuid.uuid4()), "query": "Q3", "metadata": {"category": "A"}},
    ]
    mem.add(records)

    # Test get_by_metadata returns correct records
    results = mem.get_by_metadata("category", "A")
    result_ids = {r["id"] for r in results}
    expected_ids = {r["id"] for r in records if r["metadata"]["category"] == "A"}
    assert result_ids == expected_ids, "get_by_metadata should return all records matching metadata"

    # Test delete_by_metadata deletes correct records
    success = mem.delete_by_metadata("category", "A")
    assert success, "delete_by_metadata should return True on success"

    # After deletion, get_by_metadata for category A should return empty
    results_after = mem.get_by_metadata("category", "A")
    assert results_after == [], "Records with deleted metadata should no longer exist"

    # Records with category B should still exist
    results_b = mem.get_by_metadata("category", "B")
    assert len(results_b) == 1 and results_b[0]["metadata"]["category"] == "B", "Records with other metadata should remain"

def test_delete_and_drop(memory_instance):
    mem = memory_instance
    mem.drop()
    # Add a record
    record = {"id": str(uuid.uuid4()), "query": "Delete me", "metadata": {"flag": "test"}}
    mem.add([record])

    # Delete by id
    deleted = mem.delete(record["id"])
    assert deleted, "delete should return True when deleting existing record"

    # Confirm deletion
    result = mem.get(record["id"])
    assert result == [], "Deleted record should not be retrievable"

    # Add again and drop table
    mem.add([record])
    dropped = mem.drop()
    assert dropped, "drop should return True when dropping table"

    # After drop, list_all_keys should fail or return empty list
    keys = mem.list_all_keys()
    assert keys == [], "After dropping table, list_all_keys should return empty list"

# The tests above rely on LanceDBMemory's add, list_all_keys, get, get_by_metadata,
# delete_by_metadata, delete, and drop methods working as expected.
# On buggy code, these tests should fail due to missing or incorrect implementations.
# After applying the fix, tests should pass.[0m
