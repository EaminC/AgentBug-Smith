def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Clear the table if exists
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add some records
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"tag": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"tag": "latin"}},
    ]
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test list_all_keys returns all inserted ids
    keys = mem.list_all_keys()
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns correct record for id1
    result = mem.get("id1")
    assert isinstance(result, list)
    assert len(result) == 1
    assert result[0]["id"] == "id1"
    assert result[0]["text"] == "hello world"

    # Test get returns empty list for non-existing id
    result_none = mem.get("nonexistent_id")
    assert isinstance(result_none, list)
    assert len(result_none) == 0


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Clear the table if exists
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add some records with metadata
    records = [
        {"id": "a1", "text": "apple", "metadata": {"category": "fruit"}},
        {"id": "b2", "text": "banana", "metadata": {"category": "fruit"}},
        {"id": "c3", "text": "carrot", "metadata": {"category": "vegetable"}},
    ]
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test get_by_metadata returns correct records
    fruits = mem.get_by_metadata("category", "fruit", n_results=10)
    fruit_ids = {r["id"] for r in fruits}
    assert fruit_ids == {"a1", "b2"}

    # Test delete_by_metadata deletes records with category vegetable
    deleted = mem.delete_by_metadata("category", "vegetable")
    assert deleted is True or deleted is False  # just check returns a bool

    # After deletion, carrot record should be gone
    veggies = mem.get_by_metadata("category", "vegetable")
    assert veggies == []

    # The fruit records should still be present
    fruits_after = mem.get_by_metadata("category", "fruit", n_results=10)
    fruit_ids_after = {r["id"] for r in fruits_after}
    assert fruit_ids_after == {"a1", "b2"}


def test_delete_and_drop(memory_instance):
