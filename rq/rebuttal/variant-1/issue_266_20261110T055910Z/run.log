        yield mem

def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Clear any existing data
    mem.drop("test_memory")

    # Add some records
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"tag": "example"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"tag": "latin"}},
    ]
    mem.add(records, table_name="test_memory")

    # Test list_all_keys returns all IDs
    keys = mem.list_all_keys("test_memory")
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns the correct record by id
    record = mem.get("id2", "test_memory")
    assert isinstance(record, list)
    assert len(record) == 1
    assert record[0]["id"] == "id2"
    assert record[0]["text"] == "foo bar"
    assert record[0]["metadata"]["tag"] == "example"

    # Test get returns empty list for non-existent id
    no_record = mem.get("nonexistent", "test_memory")
    assert no_record == []

def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Clear any existing data
    mem.drop("test_memory")

    # Add some records with metadata
    records = [
        {"id": "id10", "text": "apple pie", "metadata": {"category": "food"}},
        {"id": "id11", "text": "banana split", "metadata": {"category": "food"}},
        {"id": "id12", "text": "car repair", "metadata": {"category": "service"}},
    ]
    mem.add(records, table_name="test_memory")

    # Test get_by_metadata returns correct records
    food_records = mem.get_by_metadata("category", "food", "test_memory", n_results=10)
    food_ids = {r["id"] for r in food_records}
    assert food_ids == {"id10", "id11"}

    # Test delete_by_metadata deletes the correct records
    deleted = mem.delete_by_metadata("category", "food", "test_memory")
    assert deleted is True or deleted is False  # Accept either, depending on implementation

    # After deletion, get_by_metadata should return empty list
