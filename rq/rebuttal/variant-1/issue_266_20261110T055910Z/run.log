from mle.utils.memory import LanceDBMemory
import uuid


@pytest.fixture(scope="module")
def memory_instance(tmp_path_factory):
    # Create a LanceDBMemory instance with a temporary directory
    tmp_path = tmp_path_factory.mktemp("memory_test")
    mem = LanceDBMemory(project_path=str(tmp_path))
    yield mem
    # Cleanup: drop the test table after tests
    mem.drop()


def test_list_all_keys_and_get_and_delete(memory_instance):
    mem = memory_instance
    table = mem.table_name

    # Prepare test data
    test_records = [
        {"id": str(uuid.uuid4()), "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": str(uuid.uuid4()), "text": "foo bar", "metadata": {"tag": "test"}},
        {"id": str(uuid.uuid4()), "text": "lance db", "metadata": {"tag": "db"}},
    ]

    # Add records to memory
    mem.add(test_records)

    # Test list_all_keys returns all inserted ids
    keys = mem.list_all_keys()
    for rec in test_records:
        assert rec["id"] in keys

    # Test get returns the correct record by id
    for rec in test_records:
        result = mem.get(rec["id"])
        assert isinstance(result, list)
        assert len(result) == 1
        assert result[0]["id"] == rec["id"]
        assert result[0]["text"] == rec["text"]

    # Test get with non-existent id returns empty list
    result = mem.get("non-existent-id-12345")
    assert result == []

    # Test get_by_metadata returns correct records
    greeting_results = mem.get_by_metadata("tag", "greeting")
    assert any(r["id"] == test_records[0]["id"] for r in greeting_results)

    # Test delete removes a record
    to_delete_id = test_records[1]["id"]
    deleted = mem.delete(to_delete_id)
    assert deleted is True or deleted is None  # depending on implementation, accept True or None

    # After deletion, get should return empty list
    result_after_delete = mem.get(to_delete_id)
    assert result_after_delete == []

    # Test delete_by_metadata removes records by metadata
    deleted_meta = mem.delete_by_metadata("tag", "db")
    assert deleted_meta is True or deleted_meta is None

    # After delete_by_metadata, records with tag=db should be gone
    db_results = mem.get_by_metadata("tag", "db")
    assert db_results == []

    # Remaining keys should not contain deleted ids
    remaining_keys = mem.list_all_keys()
    assert to_delete_id not in remaining_keys
    assert test_records[2]["id"] not in remaining_keys


def test_drop_table(memory_instance):
    mem = memory_instance
    table = mem.table_name

    # Add a record
    record = {"id": str(uuid.uuid4()), "text": "drop test", "metadata": {"tag": "drop"}}
    mem.add([record])

    # Confirm record exists
    keys_before = mem.list_all_keys()
    assert record["id"] in keys_before

    # Drop the table
    dropped = mem.drop()
    assert dropped is True or dropped is None

    # After drop, listing keys should fail or return empty list
    # We allow either behavior depending on implementation
    try:
        keys_after = mem.list_all_keys()
        assert keys_after == []
    except Exception:
        # If error raised because table missing, that's acceptable
        pass[0m
