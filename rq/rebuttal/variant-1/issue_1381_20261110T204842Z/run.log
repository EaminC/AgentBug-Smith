        )
        self.assertEqual(
            len(msgs),
            0,
        )

        msgs = await self.memory_session.get_memory(
            mark="session2_mark",
        )
        self.assertListEqual(
            [_.id for _ in msgs],
            [str(_) for _ in [6, 7, 8, 9]],
        )
        msgs = await self.memory_session.get_memory(
