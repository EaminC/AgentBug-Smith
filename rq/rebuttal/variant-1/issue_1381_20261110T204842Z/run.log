+            )
+            .order_by(self.memory.MessageTable.index),
+        )
+        indices = [row[0] for row in result.fetchall()]
+        self.assertEqual(
+            len(set(indices)),
+            len(messages),
+            "Indices not unique",
+        )
+        self.assertEqual(
+            indices,
+            list(range(len(messages))),
+            "Indices not contiguous",
