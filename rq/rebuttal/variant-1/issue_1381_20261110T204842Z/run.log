[32mimport asyncio
import unittest
from sqlalchemy.ext.asyncio import create_async_engine
from agentscope.memory import AsyncSQLAlchemyMemory
from agentscope.message import Msg


class TestAsyncSQLAlchemyMemoryConcurrency(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        self.engine = create_async_engine(
            "sqlite+aiosqlite:///:memory:",
            echo=False,
        )
        self.memory = AsyncSQLAlchemyMemory(
            session_id="test_session",
            user_id="test_user",
            engine_or_session=self.engine,
        )

    async def asyncTearDown(self):
        await self.memory.clear()
        await self.engine.dispose()

    async def test_concurrent_add(self):
        """Test concurrent add() calls to AsyncSQLAlchemyMemory do not cause duplicate primary key errors.

        This test simulates parallel tool calls adding messages concurrently,
        which previously caused IntegrityError due to duplicate primary keys.
        """
        messages = [Msg("system", f"msg_{i}", "system") for i in range(20)]

        # Run concurrent adds to simulate parallel tool calls
        await asyncio.gather(*(self.memory.add(msg) for msg in messages))

        # Retrieve all stored messages
        stored_msgs = await self.memory.get_memory()

        # Assert all messages are stored (no duplicates lost)
        self.assertEqual(len(stored_msgs), len(messages))

        # Assert all message ids are unique
        stored_ids = {msg.id for msg in stored_msgs}
        self.assertEqual(len(stored_ids), len(messages))

        # Assert indices are unique and contiguous starting at 0
        result = await self.memory.session.execute(
            self.memory.session.bind.dialect.statement_compiler(
                self.memory.session.bind.dialect,
                self.memory.MessageTable.__table__.select()
                .where(self.memory.MessageTable.session_id == self.memory.session_id)
                .order_by(self.memory.MessageTable.index)
            ).statement
        )
        indices = [row.index for row in await result.fetchall()]
        self.assertEqual(indices, list(range(len(messages))))


if __name__ == "__main__":
    unittest.main()[0m
