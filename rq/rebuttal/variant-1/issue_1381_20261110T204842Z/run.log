[32mimport asyncio
import unittest
from sqlalchemy.ext.asyncio import create_async_engine

from agentscope.memory import AsyncSQLAlchemyMemory
from agentscope.message import Msg


class AsyncSQLAlchemyMemoryConcurrentAddTest(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        self.engine = create_async_engine(
            "sqlite+aiosqlite:///:memory:",
        )
        self.memory = AsyncSQLAlchemyMemory(
            session_id="session_concurrent",
            user_id="user_concurrent",
            engine_or_session=self.engine,
        )

    async def asyncTearDown(self):
        await self.memory.clear()
        await self.engine.dispose()

    async def test_concurrent_add(self):
        """Test concurrent add calls to AsyncSQLAlchemyMemory do not cause duplicate primary key errors.

        This test reproduces the bug described in issue #1381:
        When multiple coroutines call memory.add() concurrently, duplicate primary key conflicts occur.

        The fix introduces a lock to serialize writes, so this test should fail on buggy code
        and pass after applying the fix.
        """
        messages = [Msg("system", f"msg_{i}", "system") for i in range(20)]

        # Run concurrent adds of single messages to simulate parallel tool calls
        await asyncio.gather(*(self.memory.add(msg) for msg in messages))

        # Verify all messages were added
        stored = await self.memory.get_memory()
        self.assertEqual(len(stored), len(messages))

        # Verify indices are unique and contiguous (0..len-1)
        result = await self.memory.session.execute(
            self.memory.session.bind.dialect.statement_compiler(
                self.memory.session.bind.dialect,
                self.memory.MessageTable.__table__.select()
                .with_only_columns([self.memory.MessageTable.index])
                .where(self.memory.MessageTable.session_id == self.memory.session_id)
                .order_by(self.memory.MessageTable.index)
            ).statement
        )
        indices = [row[0] for row in result.fetchall()]
        self.assertEqual(len(set(indices)), len(messages), "Indices are not unique")
        self.assertEqual(indices, list(range(len(messages))), "Indices are not contiguous")


if __name__ == "__main__":
    unittest.main()[0m
