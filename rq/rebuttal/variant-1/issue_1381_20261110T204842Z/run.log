[32mimport asyncio
import unittest

from agentscope.memory import AsyncSQLAlchemyMemory
from agentscope.message import Msg
from sqlalchemy.ext.asyncio import create_async_engine


class TestAsyncSQLAlchemyMemoryConcurrentAdd(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        self.engine = create_async_engine("sqlite+aiosqlite:///:memory:")
        self.memory = AsyncSQLAlchemyMemory(
            session_id="test_session",
            user_id="test_user",
            engine_or_session=self.engine,
        )

    async def asyncTearDown(self):
        await self.memory.clear()
        await self.memory.close()
        await self.engine.dispose()

    async def test_concurrent_add(self):
        """Test that concurrent add() calls do not cause duplicate primary key errors.

        This test simulates concurrent calls to AsyncSQLAlchemyMemory.add()
        which caused IntegrityError in the buggy version due to race conditions.
        """

        # Prepare 20 distinct messages
        messages = [Msg("system", f"msg_{i}", "system") for i in range(20)]

        # Concurrently add all messages, simulating parallel tool calls
        await asyncio.gather(*(self.memory.add(msg) for msg in messages))

        # Retrieve all stored messages
        stored_msgs = await self.memory.get_memory()

        # Assert all messages are stored (no duplicates lost)
        self.assertEqual(len(stored_msgs), len(messages))

        # Assert all message ids are unique
        stored_ids = {msg.id for msg in stored_msgs}
        self.assertEqual(len(stored_ids), len(messages))

        # Assert indices are unique and contiguous starting from 0
        result = await self.memory.session.execute(
            self.memory.session.bind.dialect.statement_compiler(
                self.memory.session.bind.dialect,
                self.memory.MessageTable.__table__.select().where(
                    self.memory.MessageTable.session_id == self.memory.session_id
                ).order_by(self.memory.MessageTable.index)
            ).statement
        )
        indices = [row[0] for row in result.scalars().all()]
        # But the above is complicated, better use sqlalchemy select:
        from sqlalchemy import select

        result = await self.memory.session.execute(
            select(self.memory.MessageTable.index).filter(
                self.memory.MessageTable.session_id == self.memory.session_id
            ).order_by(self.memory.MessageTable.index)
        )
        indices = [row[0] for row in result.fetchall()]

        self.assertEqual(len(set(indices)), len(messages), "Indices are not unique")
        self.assertEqual(indices, list(range(len(messages))), "Indices are not contiguous")


if __name__ == "__main__":
