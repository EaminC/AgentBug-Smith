ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Copy entire repository into container
COPY . .

# Install system dependencies needed for Python package builds
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libsqlite3-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install the project in editable mode and dependencies
RUN pip install --no-cache-dir -e . \
    && pip install --no-cache-dir \
    pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout setuptools\<=81.0.0 litellm pytest-xdist aiosqlite greenlet \
    mem0ai vcrpy json_repair chromadb syrupy respx langgraph-checkpoint-sqlite langgraph-checkpoint-postgres \
    psycopg[binary,pool] redis apscheduler fastapi fakeredis mcp ray[default] boto3 agno pydantic-ai fastmcp

# Environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set PYTHONPATH to cover src layout
ENV PYTHONPATH=/app:/app/src

# Preflight check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default CMD
CMD ["/bin/bash"]
