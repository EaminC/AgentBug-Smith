        await self.memory_user.delete_by_mark("shared")
        msgs = await self.memory_user.get_memory()
        self.assertListEqual(
            [_.id for _ in msgs],
            [str(_) for _ in range(3, 10)],
        )
        msgs = await self.memory.get_memory()
        self.assertListEqual(
            [_.id for _ in msgs],
            [str(_) for _ in range(6)],
        )

        # Clean up
