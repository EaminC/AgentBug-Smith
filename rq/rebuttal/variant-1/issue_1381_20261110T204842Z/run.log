[32mimport asyncio
import unittest

from agentscope.memory import AsyncSQLAlchemyMemory
from agentscope.message import Msg
from sqlalchemy.ext.asyncio import create_async_engine


class TestAsyncSQLAlchemyMemoryConcurrency(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        self.engine = create_async_engine("sqlite+aiosqlite:///:memory:")
        self.memory = AsyncSQLAlchemyMemory(
            session_id="session_concurrent",
            user_id="user_concurrent",
            engine_or_session=self.engine,
        )

    async def asyncTearDown(self):
        await self.memory.clear()
        await self.engine.dispose()

    async def test_concurrent_add(self):
        """Test that concurrent add() calls do not cause duplicate primary key errors.

        This test simulates parallel calls to AsyncSQLAlchemyMemory.add() with multiple
        messages concurrently, reproducing the race condition that caused duplicate
        primary key conflicts before the fix.

        The test passes if all messages are added without IntegrityError and the
        stored messages count matches the input count.
        """
        messages = [Msg("system", f"Tool result {i}", "system") for i in range(20)]

        # Concurrently add each message individually to simulate parallel_tool_calls=True
        await asyncio.gather(*(self.memory.add(msg) for msg in messages))

        stored = await self.memory.get_memory()
        self.assertEqual(len(stored), len(messages), "Not all messages were stored")

        # Verify that the indices assigned are unique and contiguous
        result = await self.memory.session.execute(
            self.memory.session.bind.dialect.statement_compiler(
                self.memory.session.bind.dialect,
                self.memory.MessageTable.__table__.select().order_by(
                    self.memory.MessageTable.index
                ),
            ).statement
        )
        indices = [row[0] for row in await result.fetchall()]
        # Because of SQLite in-memory and async, fallback to direct query:
        result = await self.memory.session.execute(
            self.memory.MessageTable.__table__.select().order_by(
                self.memory.MessageTable.index
            )
        )
        indices = [row.index for row in result.fetchall()]

        self.assertEqual(
            len(set(indices)),
            len(messages),
            "Indices are not unique, indicating duplicate entries",
        )
        self.assertEqual(
            indices,
            list(range(len(messages))),
            "Indices are not contiguous starting from zero",
        )


if __name__ == "__main__":
