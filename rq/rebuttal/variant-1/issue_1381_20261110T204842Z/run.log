from agentscope.message import Msg
from sqlalchemy.ext.asyncio import create_async_engine


class AsyncSQLAlchemyMemoryConcurrentAddTest(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self) -> None:
        self.engine = create_async_engine("sqlite+aiosqlite:///:memory:")
        self.memory = AsyncSQLAlchemyMemory(
            session_id="test_session",
            user_id="test_user",
            engine_or_session=self.engine,
        )

    async def asyncTearDown(self) -> None:
        await self.memory.clear()
        await self.engine.dispose()

    async def test_concurrent_add(self) -> None:
        """Test that concurrent add() calls don't cause IntegrityError.

        This test reproduces the bug described in issue #1381 where parallel
        calls to memory.add() cause duplicate primary key conflicts.

        The test runs multiple add() calls concurrently and verifies that
        all messages are stored uniquely without duplicates or integrity errors.
        """
        messages = [Msg("system", f"Tool result {i}", "system") for i in range(20)]

        # Run concurrent add calls to simulate parallel_tool_calls=True scenario
        await asyncio.gather(*(self.memory.add(msg) for msg in messages))

        # Retrieve all stored messages
        stored_messages = await self.memory.get_memory()

        # Assert all messages were stored
        self.assertEqual(len(stored_messages), len(messages))

        # Verify indices are unique and contiguous
        result = await self.memory.session.execute(
            self.memory.session.bind.dialect.statement_compiler(
                self.memory.session.bind.dialect,
                self.memory.MessageTable.__table__.select()
                .with_only_columns([self.memory.MessageTable.index])
                .where(self.memory.MessageTable.session_id == self.memory.session_id)
                .order_by(self.memory.MessageTable.index),
            ).statement
        )
        indices = [row[0] for row in result.fetchall()]

        self.assertEqual(len(set(indices)), len(messages), "Indices are not unique")
        self.assertEqual(indices, list(range(len(messages))), "Indices are not contiguous")[0m
