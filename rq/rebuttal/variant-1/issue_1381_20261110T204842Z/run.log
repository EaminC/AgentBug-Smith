[32mimport asyncio
import unittest

from agentscope.memory import AsyncSQLAlchemyMemory
from agentscope.message import Msg
from sqlalchemy import select


class AsyncSQLAlchemyMemoryConcurrentAddTest(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Use in-memory SQLite for testing
        from sqlalchemy.ext.asyncio import create_async_engine

        self.engine = create_async_engine("sqlite+aiosqlite:///:memory:")
        self.memory = AsyncSQLAlchemyMemory(
            session_id="test_session",
            user_id="test_user",
            engine_or_session=self.engine,
        )

    async def asyncTearDown(self):
        await self.memory.clear()
        await self.engine.dispose()

    async def test_concurrent_add_no_duplicate_integrity_error(self):
        """
        Test that concurrent add() calls do not cause duplicate primary key conflicts.

        This test simulates parallel tool calls adding messages concurrently to AsyncSQLAlchemyMemory.
        It should fail on the buggy codebase due to IntegrityError and pass after the fix.
        """
        messages = [Msg("system", f"msg_{i}", "system") for i in range(20)]

        # Run multiple concurrent add calls
        await asyncio.gather(*(self.memory.add(msg) for msg in messages))

        # Verify all messages were added
        stored_msgs = await self.memory.get_memory()
        self.assertEqual(len(stored_msgs), len(messages))

        # Verify indices are unique and contiguous
        result = await self.memory.session.execute(
            select(self.memory.MessageTable.index)
            .filter(self.memory.MessageTable.session_id == self.memory.session_id)
            .order_by(self.memory.MessageTable.index)
        )
        indices = [row[0] for row in result.fetchall()]
        self.assertEqual(len(set(indices)), len(messages), "Indices are not unique")
        self.assertEqual(indices, list(range(len(messages))), "Indices are not contiguous")


if __name__ == "__main__":
    unittest.main()[0m
