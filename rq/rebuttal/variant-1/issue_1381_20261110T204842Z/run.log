[32mimport asyncio
import unittest
from sqlalchemy.ext.asyncio import create_async_engine
from sqlalchemy import select

from agentscope.memory import AsyncSQLAlchemyMemory
from agentscope.message import Msg


class AsyncSQLAlchemyMemoryConcurrentAddTest(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        self.engine = create_async_engine(
            "sqlite+aiosqlite:///:memory:",
        )
        self.memory = AsyncSQLAlchemyMemory(
            session_id="test_session",
            user_id="test_user",
            engine_or_session=self.engine,
        )

    async def asyncTearDown(self):
        await self.memory.clear()
        await self.memory.close()
        await self.engine.dispose()

    async def test_concurrent_add(self):
        """Test that concurrent add() calls don't cause IntegrityError.

        This reproduces the bug from issue #1381 where parallel_tool_calls=True
        causes concurrent calls to memory.add() that lead to duplicate primary key errors.
        """
        messages = [Msg("system", f"Tool result {i}", "system") for i in range(20)]

        # Run concurrent adds to simulate parallel tool calls
        await asyncio.gather(*(self.memory.add(msg) for msg in messages))

        # Verify all messages were added
        stored = await self.memory.get_memory()
        self.assertEqual(len(stored), len(messages))

        # Verify indices are unique and contiguous (0..len(messages)-1)
        result = await self.memory.session.execute(
            select(self.memory.MessageTable.index)
            .filter(self.memory.MessageTable.session_id == self.memory.session_id)
            .order_by(self.memory.MessageTable.index)
        )
        indices = [row[0] for row in result.fetchall()]
        self.assertEqual(len(set(indices)), len(messages), "Indices not unique")
        self.assertEqual(indices, list(range(len(messages))), "Indices not contiguous")


if __name__ == "__main__":
    unittest.main()[0m
