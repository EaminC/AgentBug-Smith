import re
from aider import models

def test_bedrock_claude_sonnet_4_5_model_settings():
    """
    Test that the model settings for the new Bedrock Claude Sonnet 4.5 model
    are correctly loaded and contain expected keys and values.

    This test verifies that the model name 'bedrock/global.anthropic.claude-sonnet-4-5-20250929-v1:0'
    is present in the model settings with the correct configuration.

    On the buggy codebase (before the patch), this model name will not be found,
    causing the test to fail. After applying the patch, the model should be present,
    and the test should pass.
    """
    model_name = "bedrock/global.anthropic.claude-sonnet-4-5-20250929-v1:0"
