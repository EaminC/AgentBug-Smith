    os.makedirs(knowledge_dir, exist_ok=True)

    # Initialize dummy app with reset method
    class DummyApp:
        def __init__(self):
            self.reset_called = False

        def reset(self):
            self.reset_called = True

    dummy_app = DummyApp()
    storage.app = dummy_app
    storage.collection = object()

    storage.reset()

    # After reset, knowledge directory should not exist
    assert not os.path.exists(knowledge_dir), "Knowledge directory should be removed after reset"

    # app and collection should be None after reset
    assert storage.app is None, "Expected app to be None after knowledge reset"
    assert storage.collection is None, "Expected collection to be None after knowledge reset"[0m
