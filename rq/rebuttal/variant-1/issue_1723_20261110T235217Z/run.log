    def test_rag_storage_reset_removes_storage_dir_and_resets_app(storage_type):
        """
        Test that the reset method removes the storage directory and resets the app and collection attributes.
        This test expects that after reset:
        - The storage directory is removed.
        - The app attribute is None.
        - The collection attribute is None.
        """
        from crewai.memory.storage import rag_storage
    
        storage = rag_storage.RAGStorage(type=storage_type)
    
        # Setup: create dummy directory to simulate existing storage
        storage_dir = os.path.join(db_storage_path(), storage_type)
        os.makedirs(storage_dir, exist_ok=True)
    
        # Setup dummy app with reset method
        class DummyApp:
            def __init__(self):
                self.reset_called = False
    
            def reset(self):
                self.reset_called = True
    
        dummy_app = DummyApp()
        storage.app = dummy_app
        storage.collection = object()
    
        # Call reset
        storage.reset()
    
        # After reset, storage directory should not exist
        assert not os.path.exists(storage_dir), f"{storage_type} directory should be removed after reset"
    
        # app and collection should be None after reset
