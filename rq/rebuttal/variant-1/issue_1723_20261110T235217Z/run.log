import shutil
import pytest

from crewai.utilities.paths import db_storage_path


def test_knowledge_storage_reset_removes_knowledge_dir_and_resets_app():
    """
    This test verifies that the reset method of KnowledgeStorage properly resets the internal app,
    removes the knowledge storage directory, and clears the collection reference.

    On the buggy codebase, this test should fail due to disk I/O error or improper handling.
    After the fix, it should pass cleanly.
    """
    from crewai.knowledge.storage.knowledge_storage import KnowledgeStorage
    from crewai.utilities.constants import KNOWLEDGE_DIRECTORY

    storage = KnowledgeStorage()

    base_path = os.path.join(db_storage_path(), KNOWLEDGE_DIRECTORY)
    os.makedirs(base_path, exist_ok=True)
    dummy_file = os.path.join(base_path, "dummy.db")
    with open(dummy_file, "w") as f:
        f.write("dummy content")

    class DummyApp:
        def __init__(self):
            self.reset_called = False

        def reset(self):
            self.reset_called = True

    dummy_app = DummyApp()
    storage.app = dummy_app
    storage.collection = object()

    storage.reset()

    # After reset, app and collection should be None, and directory removed
    assert storage.app is None, "Expected knowledge storage app to be None after reset"
    assert storage.collection is None, "Expected knowledge storage collection to be None after reset"
    assert not os.path.exists(base_path), "Expected knowledge storage directory to be removed after reset"
    assert dummy_app.reset_called, "Expected DummyApp.reset to be called"


@pytest.mark.parametrize("storage_type", ["short_term_memory", "long_term_memory"])
def test_rag_storage_reset_removes_storage_dir_and_resets_app(storage_type):
    """
    This test verifies that the reset method of RAGStorage properly resets the internal app,
    removes the storage directory, and clears the collection reference.

    On the buggy codebase, this test should fail due to a disk I/O error or improper handling.
    After the fix, it should pass cleanly.
    """
    from crewai.memory.storage import rag_storage

    # Instantiate RAGStorage with required type argument
    storage = rag_storage.RAGStorage(type=storage_type)

    storage_dir = os.path.join(db_storage_path(), storage_type)
    os.makedirs(storage_dir, exist_ok=True)
    dummy_file = os.path.join(storage_dir, "dummy.db")
    with open(dummy_file, "w") as f:
        f.write("dummy content")

    class DummyApp:
        def __init__(self):
            self.reset_called = False

        def reset(self):
            self.reset_called = True

    dummy_app = DummyApp()
    storage.app = dummy_app
    storage.collection = object()

    storage.reset()

    # After reset, app and collection should be None, and directory removed
    assert storage.app is None, "Expected RAGStorage app to be None after reset"
    assert storage.collection is None, "Expected RAGStorage collection to be None after reset"
    assert not os.path.exists(storage_dir), "Expected RAGStorage directory to be removed after reset"
    assert dummy_app.reset_called, "Expected DummyApp.reset to be called"


