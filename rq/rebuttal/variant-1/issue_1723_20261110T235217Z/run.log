[32mimport os
import shutil
import pytest

from crewai.memory.storage import rag_storage
from crewai.utilities.paths import db_storage_path


def test_rag_storage_reset_removes_storage_dir_and_resets_app():
    """
    This test verifies that the reset method of RAGStorage properly resets the internal app,
    removes the storage directory, and clears the collection reference.

    On the buggy codebase, this test should fail due to a disk I/O error or improper handling.
    After the fix, it should pass cleanly.
    """
    # Setup: create a dummy directory to simulate the storage path
    storage_dir = os.path.join(db_storage_path(), "short_term_memory")
    # Use the same type as rag_storage default type for short term memory
    # The type attribute is usually 'short_term_memory' or similar; we check the default
    # But to be safe, instantiate and get .type attribute
    storage = rag_storage.RAGStorage()
    storage_type = getattr(storage, "type", "short_term_memory")
    storage_dir = os.path.join(db_storage_path(), storage_type)

    # Ensure the directory exists before reset
    os.makedirs(storage_dir, exist_ok=True)
    # Create a dummy file inside to simulate existing data
    dummy_file = os.path.join(storage_dir, "dummy.db")
    with open(dummy_file, "w") as f:
        f.write("dummy content")

    # Assign dummy app and collection to simulate initialized state
    class DummyApp:
        def __init__(self):
            self.reset_called = False

        def reset(self):
            self.reset_called = True

    dummy_app = DummyApp()
    storage.app = dummy_app
    storage.collection = object()  # dummy non-None collection

    # Call reset and assert behavior
    storage.reset()

    # After reset, app and collection should be None
    assert storage.app is None, "Expected storage.app to be None after reset"
    assert storage.collection is None, "Expected storage.collection to be None after reset"

    # The dummy app's reset method should have been called
    assert dummy_app.reset_called, "Expected app.reset() to be called during reset"

    # The storage directory should be removed
    assert not os.path.exists(storage_dir), "Expected storage directory to be removed after reset"


def test_knowledge_storage_reset_removes_knowledge_dir_and_resets_app():
    """
    This test verifies that the reset method of KnowledgeStorage properly resets the internal app,
    removes the knowledge storage directory, and clears the collection reference.

    On the buggy codebase, this test should fail due to disk I/O error or improper handling.
    After the fix, it should pass cleanly.
    """
    from crewai.knowledge.storage.knowledge_storage import KnowledgeStorage
    from crewai.utilities.constants import KNOWLEDGE_DIRECTORY

    storage = KnowledgeStorage()

    base_path = os.path.join(db_storage_path(), KNOWLEDGE_DIRECTORY)
    os.makedirs(base_path, exist_ok=True)
    dummy_file = os.path.join(base_path, "dummy.db")
    with open(dummy_file, "w") as f:
        f.write("dummy content")

    class DummyApp:
        def __init__(self):
            self.reset_called = False

        def reset(self):
            self.reset_called = True

    dummy_app = DummyApp()
    storage.app = dummy_app
    storage.collection = object()

    storage.reset()

    assert storage.app is None, "Expected knowledge storage app to be None after reset"
    assert storage.collection is None, "Expected knowledge storage collection to be None after reset"
    assert dummy_app.reset_called, "Expected knowledge storage app.reset() to be called"
    assert not os.path.exists(base_path), "Expected knowledge storage directory to be removed after reset"


@pytest.mark.parametrize("storage_type", ["short_term_memory", "long_term_memory"])
def test_rag_storage_reset_handles_app_none_and_existing_app(storage_type):
    """
    Test that reset works correctly whether app is None or already initialized.
    """
    storage = rag_storage.RAGStorage()
    storage.type = storage_type

    base_path = os.path.join(db_storage_path(), storage_type)
    os.makedirs(base_path, exist_ok=True)
