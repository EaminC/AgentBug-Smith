[32mimport os
import shutil
import pytest

from crewai.utilities.paths import db_storage_path


@pytest.mark.parametrize("storage_type", ["short_term_memory", "long_term_memory"])
def test_rag_storage_reset_removes_storage_dir_and_resets_app(storage_type):
    """
    Test that the reset method removes the storage directory and resets the app and collection attributes.
    This test expects that after reset:
    - The storage directory is removed.
    - The app attribute is None.
    - The collection attribute is None.
    """
    from crewai.memory.storage import rag_storage

    storage = rag_storage.RAGStorage(type=storage_type)

    # Setup: create dummy directory to simulate existing storage
    storage_dir = os.path.join(db_storage_path(), storage_type)
    os.makedirs(storage_dir, exist_ok=True)

    # Setup dummy app with reset method
    class DummyApp:
        def __init__(self):
            self.reset_called = False

        def reset(self):
            self.reset_called = True

    dummy_app = DummyApp()
    storage.app = dummy_app
    storage.collection = object()

    # Call reset
    storage.reset()

    # After reset, storage directory should not exist
    assert not os.path.exists(storage_dir), f"{storage_type} directory should be removed after reset"

    # app and collection should be None after reset
    assert storage.app is None, f"Expected app to be None after reset for {storage_type}"
    assert storage.collection is None, f"Expected collection to be None after reset for {storage_type}"


def test_rag_storage_reset_handles_app_none_and_existing_app():
    """
    Test that reset works correctly whether app is None or already initialized.
    For both cases, after reset:
    - The storage directory is removed.
    - The app attribute is None.
    - The collection attribute is None.
    """
    from crewai.memory.storage import rag_storage

    for storage_type in ["short_term_memory", "long_term_memory"]:
        # Case 1: app is None
        storage = rag_storage.RAGStorage(type=storage_type)
        storage.app = None
        storage.collection = object()

        # Setup dummy directory to avoid FileNotFoundError on rmtree
        storage_dir = os.path.join(db_storage_path(), storage_type)
        os.makedirs(storage_dir, exist_ok=True)

        storage.reset()

        assert not os.path.exists(storage_dir), f"{storage_type} directory should be removed after reset when app is None"
        assert storage.app is None, f"Expected app to be None after reset when initially None for {storage_type}"
        assert storage.collection is None, f"Expected collection to be None after reset when initially None for {storage_type}"

        # Case 2: app is initialized with dummy app
        storage = rag_storage.RAGStorage(type=storage_type)
        class DummyApp:
            def __init__(self):
                self.reset_called = False
            def reset(self):
                self.reset_called = True

        dummy_app = DummyApp()
        storage.app = dummy_app
        storage.collection = object()

        # Setup dummy directory again
        os.makedirs(storage_dir, exist_ok=True)

        storage.reset()

        assert not os.path.exists(storage_dir), f"{storage_type} directory should be removed after reset when app is initialized"
        assert storage.app is None, f"Expected app to be None after reset when initially initialized for {storage_type}"
        assert storage.collection is None, f"Expected collection to be None after reset when initially initialized for {storage_type}"


