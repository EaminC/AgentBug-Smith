ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter3/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter3/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Set Forge API environment variables for OpenAI and Anthropic SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Also set other environment variables from project .env with actual values
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV MODEL=openrouter3/openai/gpt-4.1-mini
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0
ENV AI_STOP_SEQUENCES=
ENV ANTHROPIC_MODEL=openrouter3/openai/gpt-4.1-mini
ENV ANTHROPIC_SMALL_FAST_MODEL=openrouter3/openai/gpt-4.1-mini
ENV TAVILY_API_KEY=tvly-key
ENV GITHUB_TOKEN=ghp_key

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies needed to build Python packages
RUN apt-get update && apt-get install -y gcc libffi-dev libssl-dev && rm -rf /var/lib/apt/lists/*

# Copy entire repository content into the container
COPY . .

# Install python dependencies and the package itself
RUN if [ -f "requirements.txt" ]; then \
        pip install --no-cache-dir -r requirements.txt && \
        pip install --no-cache-dir -e . ; \
    elif [ -f "pyproject.toml" ]; then \
        pip install --no-cache-dir -e . ; \
    elif [ -f "setup.py" ]; then \
        pip install --no-cache-dir -e . ; \
    fi

# Install testing and essential Python dependency packages
RUN pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout \
    setuptools"<=81.0.0" litellm mem0ai vcrpy json_repair chromadb syrupy respx langgraph-checkpoint-sqlite \
    aiosqlite langgraph-checkpoint-postgres "psycopg[binary,pool]" redis apscheduler fastapi fakeredis mcp \
    "ray[default]" boto3 agno pydantic-ai fastmcp

# Set PYTHONPATH for import resolution; detect src/ layout
ENV PYTHONPATH=/app:/app/src

# Preflight check for pytest and pkg_resources
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command to keep bash open for test running
CMD ["/bin/bash"]

# branch: python/pyproject.toml with src/ layout, Forge API env vars set, robust install with test deps

