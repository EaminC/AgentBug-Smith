import os
import tempfile
import sys
from types import FunctionType
from inspect import isfunction, ismethod
from typing import ClassVar

import pytest

from crewai.cli import utils
from crewai.crew import Crew


@pytest.fixture
def temp_crew_project():
    with tempfile.TemporaryDirectory() as temp_dir:
        old_cwd = os.getcwd()
        os.chdir(temp_dir)

        crew_content = """
from crewai.crew import Crew
from crewai.agent import Agent

def create_crew() -> Crew:
    agent = Agent(role="test", goal="test", backstory="test")
    return Crew(agents=[agent], tasks=[])

# Direct crew instance
direct_crew = Crew(agents=[], tasks=[])
"""

        with open("crew.py", "w") as f:
            f.write(crew_content)

        os.makedirs("src", exist_ok=True)
        with open(os.path.join("src", "crew.py"), "w") as f:
            f.write(crew_content)

        # Create a src/templates directory that should be ignored
        os.makedirs(os.path.join("src", "templates"), exist_ok=True)
        with open(os.path.join("src", "templates", "crew.py"), "w") as f:
            f.write("# This should be ignored")

        yield temp_dir

        os.chdir(old_cwd)


def test_get_crews_finds_valid_crews(temp_crew_project):
    crews = utils.get_crews()
    assert len(crews) > 0
    for crew in crews:
        assert isinstance(crew, Crew)


def test_get_crews_with_nonexistent_file(temp_crew_project):
    crews = utils.get_crews(crew_path="nonexistent.py", require=False)
    assert crews == []


def test_get_crews_with_required_nonexistent_file(temp_crew_project, capsys):
    with pytest.raises(SystemExit):
        utils.get_crews(crew_path="nonexistent.py", require=True)
    captured = capsys.readouterr()
    assert "No valid Crew instance found" in captured.out


def test_get_crews_with_invalid_module(temp_crew_project, capsys):
    # Write invalid import to crew.py
    with open("crew.py", "w") as f:
        f.write("import nonexistent_module\n")

    crews = utils.get_crews(crew_path="crew.py", require=False)
    assert crews == []

    with pytest.raises(SystemExit):
        utils.get_crews(crew_path="crew.py", require=True)
    captured = capsys.readouterr()
    assert "Error" in captured.out


def test_get_crews_ignores_template_directories(temp_crew_project):
    # This test ensures that crew.py inside templates directory is ignored
    crews = utils.get_crews()
    # None of the crew instances should come from templates directory
    for crew in crews:
        # The crew instances should not have __file__ attribute containing 'templates'
        if hasattr(crew, "__module__"):
            mod = sys.modules.get(crew.__module__)
            if mod and hasattr(mod, "__file__"):
                assert "templates" not in mod.__file__


def test_get_crew_instance_function_and_class():
    # Define dummy Crew class with is_crew_class annotated as ClassVar to avoid PydanticUserError
    class DummyCrew(Crew):
        is_crew_class: ClassVar[bool] = True

        def __init__(self):
            pass

        def crew(self):
            return self

    def crew_function() -> Crew:
        return DummyCrew()

    # The function returning Crew instance
    crew_from_func = utils.get_crew_instance(crew_function)
    assert isinstance(crew_from_func, Crew)

    # The class itself (should instantiate and return crew)
    crew_from_class = utils.get_crew_instance(DummyCrew)
    assert isinstance(crew_from_class, Crew)

    # An instance of Crew
    crew_instance = DummyCrew()
    crew_from_instance = utils.get_crew_instance(crew_instance)
    assert isinstance(crew_from_instance, Crew)

    # A non-crew object returns None
    assert utils.get_crew_instance(42) is None
    assert utils.get_crew_instance("not a crew") is None
    assert utils.get_crew_instance(object()) is None
