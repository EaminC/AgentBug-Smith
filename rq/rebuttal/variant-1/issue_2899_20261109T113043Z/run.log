import os
import sys
import tempfile
import subprocess
import pytest

import crewai.cli.utils as utils


@pytest.fixture
def temp_crew_project():
    # Setup a temporary directory with a crew.py file that defines a valid Crew instance
    with tempfile.TemporaryDirectory() as temp_dir:
        old_cwd = os.getcwd()
        os.chdir(temp_dir)

        # Write a crew.py file with a minimal Crew instance definition
        crew_content = """
from crewai.crew import Crew
from crewai.agent import Agent

def create_crew() -> Crew:
    agent = Agent(role="test", goal="test", backstory="test")
    return Crew(agents=[agent], tasks=[])

# Direct crew instance
direct_crew = Crew(agents=[], tasks=[])
"""

        with open("crew.py", "w") as f:
            f.write(crew_content)

        # Also create a src directory with crew.py to test multi-path search
        os.makedirs("src", exist_ok=True)
        with open(os.path.join("src", "crew.py"), "w") as f:
            f.write(crew_content)

        # Create a src/templates directory with crew.py that should be ignored
        os.makedirs(os.path.join("src", "templates"), exist_ok=True)
        with open(os.path.join("src", "templates", "crew.py"), "w") as f:
            f.write("# This should be ignored")

        yield temp_dir

        os.chdir(old_cwd)


def test_get_crews_finds_valid_crews(temp_crew_project, monkeypatch):
    # Patch fetch_crews to return a dummy Crew instance to avoid complex imports
    from crewai.crew import Crew

    dummy_crew = Crew(agents=[], tasks=[])

    def mock_fetch_crews(module_attr):
        return [dummy_crew]

    monkeypatch.setattr(utils, "fetch_crews", mock_fetch_crews)

    crews = utils.get_crews()

    assert len(crews) > 0
    assert dummy_crew in crews


def test_get_crews_with_nonexistent_file(temp_crew_project):
    # Should return empty list if crew.py not found and require=False
    crews = utils.get_crews(crew_path="nonexistent.py", require=False)
    assert crews == []


def test_get_crews_with_required_nonexistent_file(temp_crew_project, capsys):
    # Should raise SystemExit and print error if require=True and crew.py not found
    with pytest.raises(SystemExit):
        utils.get_crews(crew_path="nonexistent.py", require=True)
    captured = capsys.readouterr()
    assert "No valid Crew instance found" in captured.out


def test_get_crews_with_invalid_module(temp_crew_project, capsys):
    # Write invalid crew.py that imports a nonexistent module
    with open("crew.py", "w") as f:
        f.write("import nonexistent_module\n")

    # Should return empty list with require=False
    crews = utils.get_crews(crew_path="crew.py", require=False)
    assert crews == []

    # Should raise SystemExit with require=True and print error
    with pytest.raises(SystemExit):
        utils.get_crews(crew_path="crew.py", require=True)
    captured = capsys.readouterr()
    assert "Error" in captured.out


def test_get_crews_ignores_template_directories(temp_crew_project, monkeypatch):
    from crewai.crew import Crew

    dummy_crew = Crew(agents=[], tasks=[])
    detected_templates = []

    def mock_fetch_crews(module_attr):
        # Record if module_attr's __file__ contains 'templates'
        if hasattr(module_attr, "__file__") and "templates" in module_attr.__file__:
            detected_templates.append(True)
        return [dummy_crew]

    monkeypatch.setattr(utils, "fetch_crews", mock_fetch_crews)

    utils.get_crews()

    # Assert no crew was loaded from templates directory
    assert not detected_templates


def test_get_crew_instance_with_various_inputs():
    from crewai.crew import Crew
    from crewai.cli.utils import get_crew_instance
    from types import FunctionType

    class DummyCrew(Crew):
        def __init__(self):
            pass

    dummy_crew_instance = DummyCrew()

    # A class with is_crew_class attribute True
    class CrewClass:
        is_crew_class = True

        def crew(self):
            return dummy_crew_instance

    # A function returning Crew instance and annotated properly
    def crew_function() -> Crew:
        return dummy_crew_instance

    # A function without proper annotation
    def no_crew_function():
        return dummy_crew_instance

    # Test with class having is_crew_class True
    assert get_crew_instance(CrewClass) == dummy_crew_instance

    # Test with function annotated returning Crew
    assert get_crew_instance(crew_function) == dummy_crew_instance

    # Test with function not annotated returns None
    assert get_crew_instance(no_crew_function) is None

    # Test with direct Crew instance
    assert get_crew_instance(dummy_crew_instance) == dummy_crew_instance

    # Test with unrelated object returns None
    assert get_crew_instance(object()) is None
