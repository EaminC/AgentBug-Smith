import os
import tempfile
import sys
import pytest

from crewai.cli import utils
from crewai.crew import Crew


@pytest.fixture
def temp_crew_project():
    with tempfile.TemporaryDirectory() as temp_dir:
        old_cwd = os.getcwd()
        os.chdir(temp_dir)

        # Write a crew.py that defines a Crew instance and a function returning Crew
        crew_content = """
from crewai.crew import Crew
from crewai.agent import Agent

def create_crew() -> Crew:
    agent = Agent(role="test", goal="test", backstory="test")
    return Crew(agents=[agent], tasks=[])

# Direct crew instance
direct_crew = Crew(agents=[], tasks=[])
"""

        with open("crew.py", "w") as f:
            f.write(crew_content)

        # Also create src/crew.py with same content to test src directory search
        os.makedirs("src", exist_ok=True)
        with open(os.path.join("src", "crew.py"), "w") as f:
            f.write(crew_content)

        # Create a src/templates directory that should be ignored by get_crews
        os.makedirs(os.path.join("src", "templates"), exist_ok=True)
        with open(os.path.join("src", "templates", "crew.py"), "w") as f:
            f.write("# This should be ignored")

        yield temp_dir

        os.chdir(old_cwd)


def test_get_crews_finds_valid_crews(temp_crew_project):
    crews = utils.get_crews()
    # Should find at least the direct_crew and create_crew instances
    assert any(isinstance(c, Crew) for c in crews)
    # Should not include anything from templates directory
    for c in crews:
        assert "templates" not in getattr(c, "__module__", "")


def test_get_crews_with_nonexistent_file(temp_crew_project):
    crews = utils.get_crews(crew_path="nonexistent.py", require=False)
    assert crews == []


def test_get_crews_with_required_nonexistent_file(temp_crew_project, capsys):
    with pytest.raises(SystemExit):
        utils.get_crews(crew_path="nonexistent.py", require=True)
    captured = capsys.readouterr()
    assert "No valid Crew instance found" in captured.out


def test_get_crews_with_invalid_module(temp_crew_project, capsys):
    # Overwrite crew.py with invalid import to simulate import error
    with open("crew.py", "w") as f:
        f.write("import nonexistent_module\n")

    # Should return empty list without require
    crews = utils.get_crews(crew_path="crew.py", require=False)
    assert crews == []

    # Should raise SystemExit with require=True and print error message
    with pytest.raises(SystemExit):
        utils.get_crews(crew_path="crew.py", require=True)
    captured = capsys.readouterr()
    assert "Error" in captured.out


def test_get_crews_ignores_template_directories(temp_crew_project):
    # This test ensures that crew.py under templates directory is ignored
    crews = utils.get_crews()
    # None of the crew instances should come from templates directory
    for c in crews:
        mod_file = getattr(c, "__module__", "")
        assert "templates" not in mod_file


def test_get_crew_instance_function_and_class():
    # Import get_crew_instance from utils
    get_crew_instance = utils.get_crew_instance

    # Define a dummy Crew subclass with is_crew_class attribute
    class DummyCrew(Crew):
        is_crew_class = True

        def crew(self):
            return self

    # A class with is_crew_class True returns instance
    assert isinstance(get_crew_instance(DummyCrew), Crew)

    # A function returning Crew instance with proper return type hint
    def crew_func() -> Crew:
        return DummyCrew()

    assert isinstance(get_crew_instance(crew_func), Crew)

    # An instance of Crew returns itself
    dummy_instance = DummyCrew()
    assert get_crew_instance(dummy_instance) is dummy_instance

    # An unrelated object returns None
    assert get_crew_instance(object()) is None
