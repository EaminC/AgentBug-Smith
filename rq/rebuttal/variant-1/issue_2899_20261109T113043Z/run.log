import os
import tempfile
import pytest
from click.testing import CliRunner

from crewai.cli import cli
from crewai.cli import utils


@pytest.fixture
def temp_crew_project():
    with tempfile.TemporaryDirectory() as temp_dir:
        old_cwd = os.getcwd()
        os.chdir(temp_dir)

        # Write a minimal crew.py that defines a Crew instance
        crew_content = """
from crewai.crew import Crew
from crewai.agent import Agent

def create_crew() -> Crew:
    agent = Agent(role="test", goal="test", backstory="test")
    return Crew(agents=[agent], tasks=[])

# Direct crew instance
direct_crew = Crew(agents=[], tasks=[])
"""
        with open("crew.py", "w") as f:
            f.write(crew_content)

        # Also create a src directory with crew.py to test multiple search paths
        os.makedirs("src", exist_ok=True)
        with open(os.path.join("src", "crew.py"), "w") as f:
            f.write(crew_content)

        # Create a src/templates directory with crew.py that should be ignored
        os.makedirs(os.path.join("src", "templates"), exist_ok=True)
        with open(os.path.join("src", "templates", "crew.py"), "w") as f:
            f.write("# This should be ignored")

        yield temp_dir

        os.chdir(old_cwd)


def test_reset_memories_command_runs_without_name_error(temp_crew_project):
    """
    This test runs the CLI command 'reset-memories' with -akn flags
    and asserts that it does not raise errors related to undefined names
    like 'JsonValue', 'TaskOutput', or 'Task'.

    Before the fix, this command raises NameError and fails.
    After the fix, it should run and exit with code 0.
    """
    runner = CliRunner()

    # Run the command as if from CLI: crewai reset-memories -akn
    # We expect no traceback or NameError in output.
    result = runner.invoke(cli.cli, ["reset-memories", "-akn"])

    # The command should exit with code 0 (success) after fix
    assert result.exit_code == 0, f"Command failed with output:\n{result.output}"

    # The output should NOT contain the error messages from the bug
    forbidden_msgs = [
        "name 'JsonValue' is not defined",
        "name 'TaskOutput' is not defined",
        "name 'Task' is not defined",
        "An unexpected error occurred: No crew found.",
    ]
    for msg in forbidden_msgs:
        assert msg not in result.output, f"Found forbidden error message in output: {msg}"
