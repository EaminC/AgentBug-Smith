import os
import tempfile
import pytest

from crewai.cli import utils


@pytest.fixture
def temp_crew_project():
    with tempfile.TemporaryDirectory() as temp_dir:
        old_cwd = os.getcwd()
        os.chdir(temp_dir)

        # Correct Crew instantiation with required fields to avoid validation error
        crew_content = """
from crewai.crew import Crew
from crewai.agent import Agent

def create_crew() -> Crew:
    agent = Agent(role="test", goal="test", backstory="test")
    return Crew(agents=[agent], tasks=[])

# Direct crew instance with valid agents list (one Agent) and empty tasks list
direct_crew = Crew(agents=[Agent(role="test", goal="test", backstory="test")], tasks=[])
"""

        with open("crew.py", "w") as f:
            f.write(crew_content)

        os.makedirs("src", exist_ok=True)
        with open(os.path.join("src", "crew.py"), "w") as f:
            f.write(crew_content)

        # Create a src/templates directory that should be ignored
        os.makedirs(os.path.join("src", "templates"), exist_ok=True)
        with open(os.path.join("src", "templates", "crew.py"), "w") as f:
            f.write("# This should be ignored")

        yield temp_dir

        os.chdir(old_cwd)


def test_get_crews_finds_valid_crews(temp_crew_project):
    crews = utils.get_crews()
    assert len(crews) > 0
    # Check that all returned crews are instances of Crew
    from crewai.crew import Crew as CrewClass
    assert all(isinstance(c, CrewClass) for c in crews)


def test_get_crews_with_nonexistent_file(temp_crew_project):
    crews = utils.get_crews(crew_path="nonexistent.py", require=False)
    assert len(crews) == 0


def test_get_crews_with_required_nonexistent_file(temp_crew_project, capsys):
    with pytest.raises(SystemExit):
        utils.get_crews(crew_path="nonexistent.py", require=True)

    captured = capsys.readouterr()
    assert "No valid Crew instance found" in captured.out


def test_get_crews_with_invalid_module(temp_crew_project, capsys):
    # Write invalid import to crew.py to simulate import error
    with open("crew.py", "w") as f:
        f.write("import nonexistent_module\n")

    crews = utils.get_crews(crew_path="crew.py", require=False)
    assert len(crews) == 0

    with pytest.raises(SystemExit):
        utils.get_crews(crew_path="crew.py", require=True)

    captured = capsys.readouterr()
    assert "Error" in captured.out


def test_get_crews_ignores_template_directories(temp_crew_project):
    # The test ensures that crew.py inside templates directory is ignored
    crews = utils.get_crews()
    # None of the crew instances should come from the templates directory
    for crew in crews:
        crew_file = getattr(crew, "__module__", None)
        if crew_file:
            assert "templates" not in crew_file
