import os
import tempfile

import pytest
from click.testing import CliRunner

from crewai.cli import main as cli


@pytest.fixture
def temp_crew_project():
    """
    Create a temporary directory with a minimal crew.py file defining a Crew instance.
    This simulates the presence of a crew.py file for the CLI command to load.
    """
    with tempfile.TemporaryDirectory() as temp_dir:
        old_cwd = os.getcwd()
        os.chdir(temp_dir)

        crew_content = """
from crewai.crew import Crew
from crewai.agent import Agent

agent = Agent(role="test", goal="test", backstory="test")
crew = Crew(agents=[agent], tasks=[])

def get_crew() -> Crew:
    return crew
"""

        with open("crew.py", "w") as f:
            f.write(crew_content)

        yield temp_dir

        os.chdir(old_cwd)


def test_reset_memories_command_runs_without_name_error(temp_crew_project):
    """
    This test runs the CLI command 'reset-memories' with -akn flags
    and asserts that it does not raise errors related to undefined names
    like 'JsonValue', 'TaskOutput', or 'Task'.

    Before the fix, this command raises NameError and fails.
    After the fix, it should run and exit with code 0.
    """
    runner = CliRunner()

    # Run the command as if from CLI: crewai reset-memories -akn
    # We expect no traceback or NameError in output.
    result = runner.invoke(cli.cli, ["reset-memories", "-akn"])

    # The command should exit with code 0 (success)
    assert result.exit_code == 0, f"Command failed with output:\n{result.output}"

    # The output should not contain any NameError or related undefined name errors
    forbidden_errors = [
        "NameError: name 'JsonValue' is not defined",
        "NameError: name 'TaskOutput' is not defined",
        "NameError: name 'Task' is not defined",
        "An unexpected error occurred: No crew found.",
    ]
    for err in forbidden_errors:
        assert err not in result.output, f"Found unexpected error in output: {err}"
