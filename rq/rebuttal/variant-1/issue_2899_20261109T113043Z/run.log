import os
import tempfile
import subprocess
import sys
import pytest

from pathlib import Path


@pytest.fixture
def temp_crew_project():
    with tempfile.TemporaryDirectory() as temp_dir:
        old_cwd = os.getcwd()
        os.chdir(temp_dir)

        # Write a minimal crew.py that defines a Crew instance
        crew_content = """
from crewai.crew import Crew
from crewai.agent import Agent

def create_crew() -> Crew:
    agent = Agent(role="test", goal="test", backstory="test")
    return Crew(agents=[agent], tasks=[])

# Direct crew instance
direct_crew = Crew(agents=[], tasks=[])
"""

        with open("crew.py", "w") as f:
            f.write(crew_content)

        # Also create a src directory with crew.py to test multiple search paths
        os.makedirs("src", exist_ok=True)
        with open(os.path.join("src", "crew.py"), "w") as f:
            f.write(crew_content)

        # Create a src/templates directory that should be ignored by get_crews
        os.makedirs(os.path.join("src", "templates"), exist_ok=True)
        with open(os.path.join("src", "templates", "crew.py"), "w") as f:
            f.write("# This should be ignored")

        yield temp_dir

        os.chdir(old_cwd)


def test_get_crews_returns_crews_and_no_errors(temp_crew_project):
    """
    This test verifies that the get_crews function:
    - Finds Crew instances from crew.py in current and src directories
    - Ignores crew.py files in templates directories
    - Does not raise errors about undefined names (JsonValue, TaskOutput, Task)
    - Does not print "No crew found" error when crew.py exists
    """

    # We run the get_crews function via a subprocess call to the CLI reset-memories command
    # which triggers the bug before the patch and works after the patch.
    # We simulate the CLI command 'crewai reset-memories -akn' by invoking the CLI module.

    # We run a python command that imports the utils.get_crews and calls it with require=True
    # to trigger the error if no crew found.

    # Compose a small python script to run inside the temp_crew_project directory
    script = """
import sys
from crewai.cli import utils

try:
    crews = utils.get_crews(crew_path="crew.py", require=True)
    # Print number of crews found for verification
    print(f"Found {len(crews)} crew(s)")
except SystemExit as e:
    print(f"SystemExit with code: {e.code}")
    sys.exit(e.code)
except Exception as e:
    print(f"Unexpected exception: {e}")
    sys.exit(1)
"""

    # Run the script in a subprocess with cwd=temp_crew_project
    proc = subprocess.run(
        [sys.executable, "-c", script],
        cwd=temp_crew_project,
        capture_output=True,
        text=True,
        timeout=10,
    )

    # The buggy code will fail with SystemExit or print errors about undefined names or "No crew found"
    # The fixed code will succeed and print "Found N crew(s)" with N > 0

    stdout = proc.stdout
    stderr = proc.stderr

    # Assert that the output contains "Found" and number of crews > 0
    # This will fail on buggy code that raises SystemExit or prints error messages

    assert proc.returncode == 0, f"Process failed with code {proc.returncode}\nSTDOUT:\n{stdout}\nSTDERR:\n{stderr}"
    assert "Found" in stdout, f"Expected 'Found' in stdout but got:\n{stdout}"
    assert "crew(s)" in stdout, f"Expected 'crew(s)' in stdout but got:\n{stdout}"

    # Also assert that error messages about undefined names or "No crew found" are NOT in output
    forbidden_msgs = [
        "JsonValue",
        "TaskOutput",
        "Task",
        "No crew found",
        "Error processing attribute Field",
        "Error processing attribute aggregate_raw_outputs_from_task_outputs",
        "Error processing attribute aggregate_raw_outputs_from_tasks",
    ]
    combined_output = stdout + "\n" + stderr
    for msg in forbidden_msgs:
        assert msg not in combined_output, f"Unexpected error message found: {msg}"
