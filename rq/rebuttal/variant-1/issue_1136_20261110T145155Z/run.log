[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter3/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter3/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter3/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install system dependencies needed for building Python packages and runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libssl-dev \
    python3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools and wheel
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Copy the entire project into the container
COPY . .

# Install the project dependencies and test dependencies in a single RUN command
RUN pip install --no-cache-dir -e . && \
    pip install --no-cache-dir pytest pytest-mock pytest-xdist pytest-timeout \
    "setuptools<=81.0.0" litellm mem0ai vcrpy json_repair chromadb syrupy respx \
    langgraph-checkpoint-sqlite aiosqlite langgraph-checkpoint-postgres \
    "psycopg[binary,pool]" redis apscheduler fastapi fakeredis mcp[all] ray[default] \
    boto3 agno pydantic-ai fastmcp greenlet

# Explicit PYTHONPATH setting for src/ layout
ENV PYTHONPATH=/app:/app/src

# Default command
CMD ["/bin/bash"]

# branch: python/pyproject.toml full install with test dependencies and system libs
