# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter3/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter3/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter3/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set environment variables for Forge and Anthropic APIs using Forge API key passed as build arg/env
ENV FORGE_API_KEY="forge-key" \
    OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Other environment variables injected
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1" \
    MODEL="openrouter3/openai/gpt-4.1-mini" \
    AI_TEMPERATURE="0.7" \
    ANTHROPIC_MODEL="openrouter3/openai/gpt-4.1-mini" \
    ANTHROPIC_SMALL_FAST_MODEL="openrouter3/openai/gpt-4.1-mini" \
    TAVILY_API_KEY="tvly-key" \
    GITHUB_TOKEN="ghp_key"

# Set working directory
WORKDIR /app

# Install system dependencies for Python package building and runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libssl-dev \
    python3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository to container
COPY . .

# Install project with extras and test dependencies to resolve modules like ray, mcp, greenlet, a2a, etc
RUN pip install --no-cache-dir -e . \
    && pip install --no-cache-dir pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network \
    setuptools<=81.0.0 litellm mem0ai vcrpy redis ray fakeredis greenlet \
    aiosqlite mcp fastapi httpx a2a-sdk nacos-sdk-python

# Set PYTHONPATH for src/ layout
ENV PYTHONPATH=/app:/app/src

# Default command
CMD ["/bin/bash"]

