import pytest
from mle.utils.memory import LanceDBMemory
import tempfile
import os


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for LanceDB storage
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Clear any existing data in the table by dropping it if exists
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add sample data
    sample_data = [
        {"id": "id1", "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"tag": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"tag": "latin"}},
    ]
    mem.client.create_table(mem.table_name, data=sample_data)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys()
    assert set(keys) == {"id1", "id2", "id3"}, f"Expected keys to be all ids, got {keys}"

    # Test get returns the correct record for id1
    records = mem.get("id1")
    assert isinstance(records, list), "get should return a list"
    assert len(records) == 1, "get should return exactly one record"
    assert records[0]["id"] == "id1", "Returned record id should match requested id"
    assert records[0]["text"] == "hello world", "Returned record text should match"

    # Test get returns empty list for non-existent id
    no_records = mem.get("nonexistent_id")
    assert isinstance(no_records, list)
    assert len(no_records) == 0, "get should return empty list if no record found"


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Clear table and add sample data
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    sample_data = [
        {"id": "id10", "text": "alpha", "metadata": {"category": "A"}},
        {"id": "id11", "text": "beta", "metadata": {"category": "B"}},
        {"id": "id12", "text": "gamma", "metadata": {"category": "A"}},
    ]
    mem.client.create_table(mem.table_name, data=sample_data)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test get_by_metadata returns correct records
    results = mem.get_by_metadata("category", "A")
    assert isinstance(results, list)
    assert len(results) == 2
    ids = {r["id"] for r in results}
    assert ids == {"id10", "id12"}

    # Test delete_by_metadata deletes the correct records
    success = mem.delete_by_metadata("category", "A")
    assert success is True

    # After deletion, get_by_metadata should return empty list for category A
    results_after = mem.get_by_metadata("category", "A")
    assert isinstance(results_after, list)
    assert len(results_after) == 0

    # Records with category B should remain
    results_b = mem.get_by_metadata("category", "B")
    assert len(results_b) == 1
    assert results_b[0]["id"] == "id11"


def test_delete_and_drop(memory_instance):
    mem = memory_instance

    # Clear table and add sample data
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    sample_data = [
        {"id": "del1", "text": "to be deleted", "metadata": {"tag": "del"}},
        {"id": "del2", "text": "to stay", "metadata": {"tag": "keep"}},
    ]
    mem.client.create_table(mem.table_name, data=sample_data)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Delete record del1
    deleted = mem.delete("del1")
    assert deleted is True

    # Check del1 no longer exists
    recs = mem.get("del1")
    assert len(recs) == 0

    # del2 should still exist
    recs2 = mem.get("del2")
    assert len(recs2) == 1

    # Drop the table
    dropped = mem.drop()
    assert dropped is True

    # Table should no longer exist
    assert mem.table_name not in mem.client.table_names()
