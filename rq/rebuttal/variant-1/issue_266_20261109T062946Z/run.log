import pytest
from mle.utils.memory import LanceDBMemory
import tempfile
import os


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for the LanceDB database
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem


def test_list_all_keys_and_get_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Clear the table if exists
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add sample data
    data = [
        {"id": "id1", "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": "id2", "text": "goodbye world", "metadata": {"tag": "farewell"}},
        {"id": "id3", "text": "hello again", "metadata": {"tag": "greeting"}},
    ]
    mem.client.create_table(mem.table_name, data=data)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys()
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get by id returns correct record
    record = mem.get("id2")
    assert isinstance(record, list)
    assert len(record) == 1
    assert record[0]["id"] == "id2"
    assert record[0]["text"] == "goodbye world"

    # Test get with non-existing id returns empty list
    record_none = mem.get("nonexistent")
    assert record_none == []

    # Test get_by_metadata returns correct filtered results
    greetings = mem.get_by_metadata("tag", "greeting", n_results=10)
    assert len(greetings) == 2
    assert all(r["metadata"]["tag"] == "greeting" for r in greetings)

    # Test delete_by_metadata removes matching records
    deleted = mem.delete_by_metadata("tag", "farewell")
    assert deleted is True or deleted is False  # Depending on backend, but should not error

    # After deletion, id2 should be gone
    keys_after = mem.list_all_keys()
    assert "id2" not in keys_after
    assert "id1" in keys_after and "id3" in keys_after

    # Clean up
    mem.drop(mem.table_name)
