import pytest
from mle.utils.memory import LanceDBMemory
import tempfile
import os


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for LanceDB storage
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Clear table if exists
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add some records
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"category": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"category": "latin"}},
    ]
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys()
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns correct record for id1
    rec = mem.get("id1")
    assert isinstance(rec, list)
    assert len(rec) == 1
    assert rec[0]["id"] == "id1"
    assert rec[0]["text"] == "hello world"

    # Test get returns empty list for non-existent id
    rec_none = mem.get("nonexistent")
    assert isinstance(rec_none, list)
    assert len(rec_none) == 0


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Clear table if exists
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add some records with metadata
    records = [
        {"id": "idA", "text": "apple", "metadata": {"type": "fruit"}},
        {"id": "idB", "text": "banana", "metadata": {"type": "fruit"}},
        {"id": "idC", "text": "carrot", "metadata": {"type": "vegetable"}},
    ]
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test get_by_metadata returns correct records
    fruits = mem.get_by_metadata("type", "fruit", n_results=10)
    fruit_ids = {r["id"] for r in fruits}
    assert fruit_ids == {"idA", "idB"}

    veggies = mem.get_by_metadata("type", "vegetable")
    assert len(veggies) == 1
    assert veggies[0]["id"] == "idC"

    # Test delete_by_metadata removes records with type=fruit
    result = mem.delete_by_metadata("type", "fruit")
    assert result is True

    # After deletion, get_by_metadata for fruit should return empty list
    fruits_after = mem.get_by_metadata("type", "fruit")
    assert fruits_after == []

    # The vegetable record should still exist
    veggies_after = mem.get_by_metadata("type", "vegetable")
    assert len(veggies_after) == 1
    assert veggies_after[0]["id"] == "idC"


def test_delete_and_drop(memory_instance):
    mem = memory_instance

    # Clear table if exists
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add a record
    records = [{"id": "del1", "text": "to be deleted", "metadata": {}}]
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Delete the record by id
    deleted = mem.delete("del1")
    assert deleted is True

    # After deletion, get should return empty list
    recs = mem.get("del1")
    assert recs == []

    # Drop the table
    dropped = mem.drop()
    assert dropped is True

    # The table should no longer exist
    assert mem.table_name not in mem.client.table_names()
