import pytest
from mle.utils.memory import LanceDBMemory
import tempfile
import os


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for LanceDB storage
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Clear table if exists
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add some records
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"category": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"category": "latin"}},
    ]
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys()
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns correct record by id
    rec = mem.get("id2")
    assert isinstance(rec, list)
    assert len(rec) == 1
    assert rec[0]["id"] == "id2"
    assert rec[0]["text"] == "foo bar"

    # Test get returns empty list if id not found
    rec_none = mem.get("nonexistent_id")
    assert rec_none == []

    # Test get_by_metadata returns matching records
    results = mem.get_by_metadata("category", "greeting")
    assert any(r["id"] == "id1" for r in results)

    # Test get_by_metadata returns empty list if no matches
    no_results = mem.get_by_metadata("category", "nonexistent")
    assert no_results == []

    # Test delete_by_metadata deletes matching records
    deleted = mem.delete_by_metadata("category", "test")
    assert deleted is True or deleted is False  # just check method runs

    # After deletion, id2 should be gone
    keys_after = mem.list_all_keys()
    assert "id2" not in keys_after

    # Clean up
    mem.drop(mem.table_name)


def test_delete_and_drop(memory_instance):
    mem = memory_instance

    # Setup table with one record
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)
    records = [{"id": "deltest", "text": "to be deleted", "metadata": {}}]
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Delete by record_id
    deleted = mem.delete("deltest")
    assert deleted is True or deleted is False  # just ensure method runs

    # Confirm deletion
    keys = mem.list_all_keys()
    assert "deltest" not in keys

    # Drop table
    dropped = mem.drop()
    assert dropped is True or dropped is False  # ensure drop runs

    # Table should no longer exist
    assert mem.table_name not in mem.client.table_names()
