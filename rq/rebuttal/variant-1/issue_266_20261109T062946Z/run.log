import pytest
import uuid
from mle.utils.memory import LanceDBMemory


@pytest.fixture(scope="module")
def memory_instance(tmp_path_factory):
    # Create a LanceDBMemory instance with a temporary directory
    tmp_path = tmp_path_factory.mktemp("lancedb_test")
    mem = LanceDBMemory(project_path=str(tmp_path))
    # Clean up any existing table with default name
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)
    yield mem
    # Cleanup after tests
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)


def test_list_all_keys_and_get_and_delete_by_metadata(memory_instance):
    mem = memory_instance
    table = mem.table_name

    # Prepare test data
    records = [
        {
            "id": str(uuid.uuid4()),
            "text": "Hello world",
            "metadata": {"category": "greeting", "lang": "en"}
        },
        {
            "id": str(uuid.uuid4()),
            "text": "Bonjour le monde",
            "metadata": {"category": "greeting", "lang": "fr"}
        },
        {
            "id": str(uuid.uuid4()),
            "text": "Goodbye world",
            "metadata": {"category": "farewell", "lang": "en"}
        }
    ]

    # Add records to memory
    mem.add(records)

    # Test list_all_keys returns all inserted IDs
    keys = mem.list_all_keys()
    inserted_ids = {r["id"] for r in records}
    assert inserted_ids.issubset(set(keys)), "list_all_keys should return all inserted record IDs"

    # Test get by id returns the correct record
    for record in records:
        result = mem.get(record["id"])
        assert len(result) == 1, f"get should return exactly one record for id {record['id']}"
        assert result[0]["id"] == record["id"], "Returned record ID should match requested ID"
        assert result[0]["text"] == record["text"], "Returned record text should match inserted text"

    # Test get_by_metadata returns correct records
    greetings = mem.get_by_metadata("category", "greeting")
    greeting_ids = {r["id"] for r in greetings}
    expected_greeting_ids = {records[0]["id"], records[1]["id"]}
    assert expected_greeting_ids.issubset(greeting_ids), "get_by_metadata should return all greeting category records"

    # Test delete_by_metadata removes the correct records
    deleted = mem.delete_by_metadata("lang", "fr")
    assert deleted is True or deleted is False, "delete_by_metadata should return a boolean"

    # After deletion, records with lang=fr should be gone
    remaining_keys = mem.list_all_keys()
    assert records[1]["id"] not in remaining_keys, "Record with lang=fr should be deleted"

    # Cleanup
    mem.drop()


def test_delete_and_drop(memory_instance):
    mem = memory_instance
    table = mem.table_name

    # Insert a single record
    record = {
        "id": str(uuid.uuid4()),
        "text": "Test record",
        "metadata": {"tag": "test"}
    }
    mem.add([record])

    # Confirm record is present
    keys = mem.list_all_keys()
    assert record["id"] in keys

    # Delete by id
    deleted = mem.delete(record["id"])
    assert deleted is True or deleted is False, "delete should return a boolean"

    # Confirm record is gone
    keys_after_delete = mem.list_all_keys()
    assert record["id"] not in keys_after_delete

    # Drop the table
    dropped = mem.drop()
    assert dropped is True or dropped is False, "drop should return a boolean"

    # Table should no longer exist
    assert mem.table_name not in mem.client.table_names()


def test_get_by_metadata_limit(memory_instance):
    mem = memory_instance
    table = mem.table_name

    # Insert multiple records with same metadata key-value
    records = []
    for i in range(10):
        records.append({
            "id": str(uuid.uuid4()),
            "text": f"Record {i}",
            "metadata": {"group": "testgroup"}
        })
    mem.add(records)

    # Retrieve with limit 5
    results = mem.get_by_metadata("group", "testgroup", n_results=5)
    assert len(results) == 5, "get_by_metadata should respect n_results limit"

    # Cleanup
    mem.drop()
