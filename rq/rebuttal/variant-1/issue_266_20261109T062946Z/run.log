import pytest
from mle.utils.memory import LanceDBMemory
import tempfile
import os


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for LanceDB storage
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Clear any existing data
    mem.drop("test_memory")

    # Add some records
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"category": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"category": "latin"}},
    ]
    mem.client.create_table("test_memory", data=records)
    mem.client.open_table("test_memory").create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys("test_memory")
    assert isinstance(keys, list)
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns correct record by id
    result = mem.get("id2", "test_memory")
    assert isinstance(result, list)
    assert len(result) == 1
    assert result[0]["id"] == "id2"
    assert result[0]["text"] == "foo bar"

    # Test get returns empty list for non-existent id
    result_empty = mem.get("nonexistent", "test_memory")
    assert isinstance(result_empty, list)
    assert len(result_empty) == 0


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Clear and recreate table with known data
    mem.drop("test_memory")
    records = [
        {"id": "idA", "text": "alpha", "metadata": {"type": "letter"}},
        {"id": "idB", "text": "beta", "metadata": {"type": "letter"}},
        {"id": "idC", "text": "gamma", "metadata": {"type": "greek"}},
    ]
    mem.client.create_table("test_memory", data=records)
    mem.client.open_table("test_memory").create_fts_index("id")

    # Test get_by_metadata returns correct filtered results
    results = mem.get_by_metadata("type", "letter", "test_memory", n_results=10)
    assert isinstance(results, list)
    ids = {r["id"] for r in results}
    assert ids == {"idA", "idB"}

    # Test delete_by_metadata deletes matching records
    success = mem.delete_by_metadata("type", "letter", "test_memory")
    assert success is True

    # After deletion, those records should be gone
    remaining_keys = mem.list_all_keys("test_memory")
    assert "idA" not in remaining_keys
    assert "idB" not in remaining_keys
    assert "idC" in remaining_keys


def test_delete_and_drop(memory_instance):
    mem = memory_instance

    # Clear and recreate table with one record
    mem.drop("test_memory")
    records = [{"id": "to_delete", "text": "delete me", "metadata": {}}]
    mem.client.create_table("test_memory", data=records)
    mem.client.open_table("test_memory").create_fts_index("id")

    # Delete the record by id
    deleted = mem.delete("to_delete", "test_memory")
    assert deleted is True

    # Confirm record is deleted
    keys = mem.list_all_keys("test_memory")
    assert "to_delete" not in keys

    # Drop the entire table
    dropped = mem.drop("test_memory")
    assert dropped is True

    # Table should no longer exist
    assert "test_memory" not in mem.client.table_names()
