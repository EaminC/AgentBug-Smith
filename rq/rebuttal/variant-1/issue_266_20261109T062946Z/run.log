import pytest
import uuid
from mle.utils.memory import LanceDBMemory


@pytest.fixture(scope="module")
def memory_instance(tmp_path_factory):
    # Create a LanceDBMemory instance with a temporary directory for isolation
    tmp_path = tmp_path_factory.mktemp("lancedb_memory_test")
    mem = LanceDBMemory(project_path=str(tmp_path))
    # Use a unique table name to avoid collisions
    mem.table_name = f"test_table_{uuid.uuid4().hex}"
    yield mem
    # Cleanup: drop the test table after tests
    mem.drop(mem.table_name)


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Add some records
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"tag": "example"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"tag": "latin"}},
    ]

    # Insert records by adding them to the table
    # LanceDBMemory add() expects list of dicts with id, text, metadata
    mem.add(records, table_name=mem.table_name)

    # Test list_all_keys returns all inserted ids
    keys = mem.list_all_keys(mem.table_name)
    assert set(keys) >= {"id1", "id2", "id3"}, "list_all_keys should return all inserted ids"

    # Test get returns the correct record for id1
    result = mem.get("id1", mem.table_name)
    assert isinstance(result, list), "get should return a list"
    assert len(result) == 1, "get should return exactly one record for existing id"
    assert result[0]["id"] == "id1", "get should return record with matching id"

    # Test get returns empty list for non-existent id
    result_none = mem.get("nonexistentid", mem.table_name)
    assert isinstance(result_none, list)
    assert len(result_none) == 0, "get should return empty list for non-existent id"


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Add records with metadata tags
    records = [
        {"id": "m1", "text": "apple", "metadata": {"category": "fruit"}},
        {"id": "m2", "text": "banana", "metadata": {"category": "fruit"}},
        {"id": "m3", "text": "carrot", "metadata": {"category": "vegetable"}},
    ]
    mem.add(records, table_name=mem.table_name)

    # Test get_by_metadata returns correct records for category=fruit
    fruits = mem.get_by_metadata("category", "fruit", mem.table_name, n_results=10)
    fruit_ids = {r["id"] for r in fruits}
    assert "m1" in fruit_ids and "m2" in fruit_ids, "get_by_metadata should return records with matching metadata"
    assert all(r["metadata"]["category"] == "fruit" for r in fruits), "All returned records should have category=fruit"

    # Test delete_by_metadata deletes records with category=vegetable
    deleted = mem.delete_by_metadata("category", "vegetable", mem.table_name)
    assert deleted is True or deleted is False, "delete_by_metadata should return a boolean"

    # After deletion, get_by_metadata for category=vegetable should return empty list
    veggies = mem.get_by_metadata("category", "vegetable", mem.table_name)
    assert isinstance(veggies, list)
    assert len(veggies) == 0, "Records with deleted metadata should no longer be found"


def test_delete_and_drop(memory_instance):
    mem = memory_instance

    # Add a record
    record = {"id": "del1", "text": "to be deleted", "metadata": {"flag": "temp"}}
    mem.add([record], table_name=mem.table_name)

    # Delete by id
    deleted = mem.delete("del1", mem.table_name)
    assert deleted is True or deleted is False, "delete should return a boolean"

    # Confirm deletion by get
    result = mem.get("del1", mem.table_name)
    assert isinstance(result, list)
    assert len(result) == 0, "Deleted record should not be found"

    # Drop the table
    dropped = mem.drop(mem.table_name)
    assert dropped is True or dropped is False, "drop should return a boolean"

    # After drop, listing keys should raise or return empty list
    with pytest.raises(Exception):
        mem.list_all_keys(mem.table_name)
