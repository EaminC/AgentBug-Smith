+
+        Returns:
+            List[dict]: A list of records matching the metadata criteria.
+        """
+        table_name = table_name or self.table_name
+        table = self.client.open_table(table_name)
+        return table.search(query_type="fts") \
+            .where(f"metadata.{key} = '{value}'") \
