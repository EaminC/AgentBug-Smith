import pytest
import uuid
from mle.utils.memory import LanceDBMemory


@pytest.fixture(scope="module")
def memory_instance(tmp_path_factory):
    # Create a LanceDBMemory instance with a temporary directory as DB path
    tmp_path = tmp_path_factory.mktemp("lancedb_test")
    mem = LanceDBMemory(db_path=str(tmp_path), table_name="test_memory")
    # Ensure clean state by dropping table if exists
    mem.drop("test_memory")
    yield mem
    # Cleanup after tests
    mem.drop("test_memory")


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Prepare test data
    test_data = [
        {"id": str(uuid.uuid4()), "query": "What is AI?", "metadata": {"type": "question"}},
        {"id": str(uuid.uuid4()), "query": "Explain ML.", "metadata": {"type": "question"}},
        {"id": str(uuid.uuid4()), "query": "Define data science.", "metadata": {"type": "definition"}},
    ]

    # Add test data to memory
    mem.add(test_data)

    # Test list_all_keys returns all inserted IDs
    keys = mem.list_all_keys()
    inserted_ids = [item["id"] for item in test_data]
    # All inserted ids should be in the keys list
    for _id in inserted_ids:
        assert _id in keys, f"ID {_id} should be in list_all_keys result"

    # Test get returns the correct record for each id
    for record in test_data:
        result = mem.get(record_id=record["id"])
        assert isinstance(result, list), "get() should return a list"
        assert len(result) == 1, "get() should return exactly one record for existing id"
        assert result[0]["id"] == record["id"], "Returned record ID should match requested ID"
        assert result[0]["query"] == record["query"], "Returned record query should match inserted query"

    # Test get returns empty list for non-existing id
    non_existing_id = str(uuid.uuid4())
    result = mem.get(record_id=non_existing_id)
    assert isinstance(result, list), "get() should return a list"
    assert len(result) == 0, "get() should return empty list for non-existing id"


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Prepare test data with metadata
    test_data = [
        {"id": str(uuid.uuid4()), "query": "Test 1", "metadata": {"category": "A"}},
        {"id": str(uuid.uuid4()), "query": "Test 2", "metadata": {"category": "B"}},
        {"id": str(uuid.uuid4()), "query": "Test 3", "metadata": {"category": "A"}},
    ]

    # Add test data to memory
    mem.add(test_data)

    # Test get_by_metadata returns correct records
    results = mem.get_by_metadata(key="category", value="A", n_results=10)
    assert isinstance(results, list)
    # All returned records must have metadata.category == "A"
    for record in results:
        assert "metadata" in record and record["metadata"].get("category") == "A"

    # The number of returned records should match how many have category "A"
    expected_count = sum(1 for d in test_data if d["metadata"]["category"] == "A")
    assert len(results) == expected_count

    # Test delete_by_metadata removes records with category "B"
    deleted = mem.delete_by_metadata(key="category", value="B")
    assert isinstance(deleted, bool)
    assert deleted is True or deleted is False  # Should be a bool

    # After deletion, no records with category "B" should remain
    remaining = mem.get_by_metadata(key="category", value="B", n_results=10)
    assert len(remaining) == 0


def test_delete_and_drop(memory_instance):
    mem = memory_instance

    # Prepare test data
    record = {"id": str(uuid.uuid4()), "query": "To be deleted", "metadata": {"tag": "delete"}}
    mem.add([record])

    # Delete by id
    deleted = mem.delete(record_id=record["id"])
    assert deleted is True or deleted is False  # Should be a bool

    # Confirm deletion: get should return empty list
    result = mem.get(record_id=record["id"])
    assert len(result) == 0

    # Drop the table
    dropped = mem.drop()
    assert dropped is True or dropped is False  # Should be a bool

    # After drop, listing keys should raise or return empty list
    with pytest.raises(Exception):
        mem.list_all_keys()
