    # Test get returns correct record for id2
    record = mem.get("id2", "test_memory")
    assert len(record) == 1, "get should return exactly one record for existing ID"
    assert record[0]["id"] == "id2", "get should return the record with the requested ID"
    assert record[0]["query"] == "What is Python?", "Returned record should have correct query"

    # Test get returns empty list for non-existent ID
    no_record = mem.get("nonexistent_id", "test_memory")
    assert no_record == [], "get should return empty list for non-existent ID"

    # Test get_by_metadata returns correct records
    results = mem.get_by_metadata("category", "tech", "test_memory", n_results=10)
    result_ids = {r["id"] for r in results}
    assert "id1" in result_ids and "id2" in result_ids, "get_by_metadata should return records with matching metadata"
    assert "id3" not in result_ids, "get_by_metadata should not return records with non-matching metadata"

    # Test delete_by_metadata deletes correct records
    delete_result = mem.delete_by_metadata("category", "tech", "test_memory")
    assert delete_result is True, "delete_by_metadata should return True on successful deletion"

    # After deletion, keys should no longer include id1 and id2
    keys_after_delete = mem.list_all_keys("test_memory")
    assert "id1" not in keys_after_delete and "id2" not in keys_after_delete, "Deleted records should be removed from keys"
    assert "id3" in keys_after_delete, "Non-deleted records should remain"

