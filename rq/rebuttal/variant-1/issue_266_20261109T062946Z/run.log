import os
import tempfile
import pytest

from mle.utils.memory import LanceDBMemory


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for the LanceDB database
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem


def test_memory_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Clean slate: drop table if exists
    mem.drop("test_memory")

    # Add some records
    records = [
        {"id": "rec1", "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": "rec2", "text": "foo bar", "metadata": {"tag": "code"}},
        {"id": "rec3", "text": "lorem ipsum", "metadata": {"tag": "latin"}},
    ]
    mem.add(records, table_name="test_memory")

    # Test list_all_keys returns all added ids
    keys = mem.list_all_keys("test_memory")
    assert set(keys) == {"rec1", "rec2", "rec3"}

    # Test get returns the correct record for a given id
    rec = mem.get("rec2", "test_memory")
    assert isinstance(rec, list)
    assert len(rec) == 1
    assert rec[0]["id"] == "rec2"
    assert rec[0]["text"] == "foo bar"
    assert rec[0]["metadata"]["tag"] == "code"

    # Test get returns empty list for non-existent id
    rec_none = mem.get("nonexistent", "test_memory")
    assert rec_none == []

def test_memory_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Clean slate: drop table if exists
    mem.drop("test_memory")

    # Add records with metadata
    records = [
        {"id": "a1", "text": "data one", "metadata": {"category": "A"}},
        {"id": "a2", "text": "data two", "metadata": {"category": "A"}},
        {"id": "b1", "text": "data three", "metadata": {"category": "B"}},
    ]
    mem.add(records, table_name="test_memory")

    # Retrieve by metadata
    results_a = mem.get_by_metadata("category", "A", "test_memory", n_results=10)
    assert isinstance(results_a, list)
    assert len(results_a) == 2
    ids_a = {r["id"] for r in results_a}
    assert ids_a == {"a1", "a2"}

    results_b = mem.get_by_metadata("category", "B", "test_memory")
    assert len(results_b) == 1
    assert results_b[0]["id"] == "b1"

    # Delete by metadata
    deleted = mem.delete_by_metadata("category", "A", "test_memory")
    assert deleted is True or deleted is False  # Accept either but must not error

    # After deletion, no records with category A should remain
    remaining_a = mem.get_by_metadata("category", "A", "test_memory", n_results=10)
    assert remaining_a == []

    # Records with category B should still exist
    remaining_b = mem.get_by_metadata("category", "B", "test_memory")
    assert len(remaining_b) == 1
    assert remaining_b[0]["id"] == "b1"

def test_memory_delete_and_drop(memory_instance):
    mem = memory_instance

    # Clean slate: drop table if exists
    mem.drop("test_memory")

    # Add a record
    record = [{"id": "del1", "text": "to be deleted", "metadata": {}}]
    mem.add(record, table_name="test_memory")

    # Confirm record exists
    rec = mem.get("del1", "test_memory")
    assert len(rec) == 1

    # Delete the record by id
    deleted = mem.delete("del1", "test_memory")
    assert deleted is True or deleted is False  # Accept either but must not error

    # Confirm record no longer exists
    rec_after = mem.get("del1", "test_memory")
    assert rec_after == []

    # Drop the table
    dropped = mem.drop("test_memory")
    assert dropped is True or dropped is False  # Accept either but must not error

    # After drop, listing keys should fail or return empty list
    with pytest.raises(Exception):
        mem.list_all_keys("test_memory")
