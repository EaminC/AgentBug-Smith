    data = [{
        "id": "unique_id",
        "query": "Sample query",
        "response": "Sample response",
        "metadata": {"tag": "sample"}
    }]
    mem.add(data, table_name="test_memory")

    # After adding, list_all_keys should include the new id
    keys = mem.list_all_keys("test_memory")
    assert "unique_id" in keys, "After add, the new id should be listed"

