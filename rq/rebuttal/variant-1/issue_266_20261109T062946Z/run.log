import pytest
from mle.utils.memory import LanceDBMemory
import tempfile
import os


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for LanceDB storage
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Clear the table if exists
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add some records
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"tag": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"tag": "latin"}},
    ]
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys()
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns correct record for id1
    result = mem.get("id1")
    assert isinstance(result, list)
    assert len(result) == 1
    assert result[0]["id"] == "id1"
    assert result[0]["text"] == "hello world"

    # Test get returns empty list for unknown id
    result_empty = mem.get("unknown_id")
    assert isinstance(result_empty, list)
    assert len(result_empty) == 0


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Clear and recreate table with records
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    records = [
        {"id": "idA", "text": "apple", "metadata": {"category": "fruit"}},
        {"id": "idB", "text": "banana", "metadata": {"category": "fruit"}},
        {"id": "idC", "text": "carrot", "metadata": {"category": "vegetable"}},
    ]
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test get_by_metadata returns correct records for category=fruit
    fruits = mem.get_by_metadata("category", "fruit", n_results=10)
    fruit_ids = {r["id"] for r in fruits}
    assert fruit_ids == {"idA", "idB"}

    # Test get_by_metadata returns empty list for non-existent metadata
    no_match = mem.get_by_metadata("category", "meat")
    assert no_match == []

    # Test delete_by_metadata removes records with category=fruit
    deleted = mem.delete_by_metadata("category", "fruit")
    assert deleted is True or deleted is False  # Depends on implementation but should not error

    # After deletion, get_by_metadata for fruit should return empty list
    fruits_after_delete = mem.get_by_metadata("category", "fruit")
    assert fruits_after_delete == []

    # The vegetable record should still exist
    veg = mem.get("idC")
    assert len(veg) == 1
    assert veg[0]["text"] == "carrot"


def test_delete_and_drop(memory_instance):
    mem = memory_instance

    # Clear and recreate table with one record
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    records = [{"id": "del1", "text": "to be deleted", "metadata": {}}]
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Delete the record by id
    deleted = mem.delete("del1")
    assert deleted is True or deleted is False  # Should not error

    # After deletion, get should return empty list
    result = mem.get("del1")
    assert result == []

    # Drop the entire table
    dropped = mem.drop()
    assert dropped is True or dropped is False

    # Table should no longer exist
    assert mem.table_name not in mem.client.table_names()
