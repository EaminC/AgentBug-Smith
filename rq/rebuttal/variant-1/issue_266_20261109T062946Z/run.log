import pytest
from mle.utils.memory import LanceDBMemory
import tempfile
import os


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for LanceDB storage
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir)
        yield mem


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance
    table_name = mem.table_name

    # Clean slate: drop table if exists
    if table_name in mem.client.table_names():
        mem.drop(table_name)

    # Add some records
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
        {"id": "id2", "text": "goodbye world", "metadata": {"category": "farewell"}},
        {"id": "id3", "text": "hello again", "metadata": {"category": "greeting"}},
    ]
    mem.client.create_table(table_name, data=records)
    mem.client.open_table(table_name).create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys(table_name)
    assert isinstance(keys, list)
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns correct record for id1
    result = mem.get("id1", table_name)
    assert isinstance(result, list)
    assert len(result) == 1
    assert result[0]["id"] == "id1"
    assert result[0]["text"] == "hello world"

    # Test get returns empty list for non-existent id
    result_empty = mem.get("nonexistent", table_name)
    assert isinstance(result_empty, list)
    assert len(result_empty) == 0


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance
    table_name = mem.table_name

    # Clean slate: drop table if exists
    if table_name in mem.client.table_names():
        mem.drop(table_name)

    # Add some records with metadata
    records = [
        {"id": "id10", "text": "foo bar", "metadata": {"tag": "alpha"}},
        {"id": "id11", "text": "bar baz", "metadata": {"tag": "beta"}},
        {"id": "id12", "text": "baz qux", "metadata": {"tag": "alpha"}},
    ]
    mem.client.create_table(table_name, data=records)
    mem.client.open_table(table_name).create_fts_index("id")

    # Test get_by_metadata returns correct records for tag=alpha
    results = mem.get_by_metadata("tag", "alpha", table_name, n_results=10)
    assert isinstance(results, list)
    assert len(results) == 2
    ids = {r["id"] for r in results}
    assert ids == {"id10", "id12"}

    # Test delete_by_metadata deletes records with tag=beta
    deleted = mem.delete_by_metadata("tag", "beta", table_name)
    assert deleted is True or deleted is False  # Accept either, depending on implementation

    # After deletion, get_by_metadata for tag=beta returns empty list
    results_after = mem.get_by_metadata("tag", "beta", table_name, n_results=10)
    assert isinstance(results_after, list)
    assert len(results_after) == 0

    # The other records with tag=alpha remain
    results_alpha = mem.get_by_metadata("tag", "alpha", table_name, n_results=10)
    assert len(results_alpha) == 2


def test_delete_and_drop(memory_instance):
    mem = memory_instance
    table_name = mem.table_name

    # Clean slate: drop table if exists
    if table_name in mem.client.table_names():
        mem.drop(table_name)

    # Add a record
    records = [
        {"id": "id20", "text": "to be deleted", "metadata": {"flag": "delete"}},
    ]
    mem.client.create_table(table_name, data=records)
    mem.client.open_table(table_name).create_fts_index("id")

    # Delete the record by id
    deleted = mem.delete("id20", table_name)
    assert deleted is True or deleted is False  # Accept either, depending on implementation

    # Confirm record is gone
    result = mem.get("id20", table_name)
    assert isinstance(result, list)
    assert len(result) == 0

    # Drop the table
    dropped = mem.drop(table_name)
    assert dropped is True or dropped is False

    # Confirm table no longer exists
    assert table_name not in mem.client.table_names()
