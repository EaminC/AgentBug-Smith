import pytest
from mle.utils.memory import LanceDBMemory
import tempfile
import os

@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for LanceDB storage
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem

def test_list_all_keys_and_get_and_delete_by_metadata(memory_instance):
    mem = memory_instance
    table = mem.table_name

    # Clear the table if exists
    mem.drop(table)

    # Add sample data
    sample_data = [
        {"id": "id1", "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"tag": "code"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"tag": "latin"}},
    ]
    mem.client.create_table(table, sample_data)
    mem.client.open_table(table).create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys(table)
    assert set(keys) == {"id1", "id2", "id3"}, f"Expected keys not found, got {keys}"

    # Test get by id returns correct record
    record = mem.get("id2", table)
    assert len(record) == 1, "Expected one record for id2"
    assert record[0]["id"] == "id2", "Returned record id mismatch"
    assert record[0]["text"] == "foo bar", "Returned record text mismatch"

    # Test get with non-existing id returns empty list
    no_record = mem.get("nonexistent", table)
    assert no_record == [], "Expected empty list for nonexistent id"

    # Test get_by_metadata returns correct records
    code_records = mem.get_by_metadata("tag", "code", table)
    assert len(code_records) == 1, "Expected one record with tag=code"
    assert code_records[0]["id"] == "id2", "Metadata query returned wrong record"

    # Test delete_by_metadata removes records correctly
    deleted = mem.delete_by_metadata("tag", "latin", table)
    assert deleted is True or deleted is False, "delete_by_metadata should return bool"

    # After deletion, the record with tag=latin should be gone
    remaining_keys = mem.list_all_keys(table)
    assert "id3" not in remaining_keys, "Record with tag=latin was not deleted"

    # Clean up
    mem.drop(table)

def test_delete_and_drop(memory_instance):
    mem = memory_instance
    table = mem.table_name

    # Add sample data
    sample_data = [
        {"id": "del1", "text": "to be deleted", "metadata": {"type": "temp"}},
    ]
    mem.client.create_table(table, sample_data)
    mem.client.open_table(table).create_fts_index("id")

    # Delete by id
    deleted = mem.delete("del1", table)
    assert deleted is True or deleted is False, "delete should return bool"

    # Confirm deletion
    keys = mem.list_all_keys(table)
    assert "del1" not in keys, "Record del1 should be deleted"

    # Drop the table
    dropped = mem.drop(table)
    assert dropped is True or dropped is False, "drop should return bool"

    # After drop, table should not exist
    assert table not in mem.client.table_names()

# Additional sanity test: add and query
