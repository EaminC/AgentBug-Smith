import pytest
from mle.utils.memory import LanceDBMemory
import tempfile
import os


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for LanceDB storage
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance
    # Clean slate: drop table if exists
    mem.drop("test_memory")

    # Add sample data
    data = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"category": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"category": "latin"}},
    ]
    mem.client.create_table("test_memory", data=data)
    mem.client.open_table("test_memory").create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys("test_memory")
    assert set(keys) == {"id1", "id2", "id3"}, f"Expected keys to be id1,id2,id3 but got {keys}"

    # Test get returns correct record for id2
    record = mem.get("id2", "test_memory")
    assert isinstance(record, list), "get should return a list"
    assert len(record) == 1, "get should return exactly one record"
    assert record[0]["id"] == "id2", f"Expected record id 'id2' but got {record[0]['id']}"
    assert record[0]["text"] == "foo bar"

    # Test get returns empty list for unknown id
    record_none = mem.get("nonexistent", "test_memory")
    assert record_none == [], "get should return empty list for unknown id"


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance
    mem.drop("test_memory")

    data = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"category": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"category": "test"}},
    ]
    mem.client.create_table("test_memory", data=data)
    mem.client.open_table("test_memory").create_fts_index("id")

    # Test get_by_metadata returns correct records
    results = mem.get_by_metadata("category", "test", "test_memory", n_results=10)
    assert len(results) == 2, f"Expected 2 results for category=test, got {len(results)}"
    ids = {r["id"] for r in results}
    assert ids == {"id2", "id3"}

    # Test delete_by_metadata deletes correct records
    success = mem.delete_by_metadata("category", "test", "test_memory")
    assert success is True or success is False, "delete_by_metadata should return a boolean"

    # After deletion, get_by_metadata should return no results
    results_after = mem.get_by_metadata("category", "test", "test_memory", n_results=10)
    assert results_after == [], "Expected no results after delete_by_metadata"

    # list_all_keys should only contain id1 now
    keys = mem.list_all_keys("test_memory")
    assert keys == ["id1"], f"Expected only 'id1' after deletion but got {keys}"
