@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for LanceDB storage
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem


def test_list_all_keys_and_get_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Clear table if exists
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add some records
    records = [
        {"id": "id1", "metadata": {"tag": "alpha"}, "content": "first record"},
        {"id": "id2", "metadata": {"tag": "beta"}, "content": "second record"},
        {"id": "id3", "metadata": {"tag": "alpha"}, "content": "third record"},
    ]
    mem.client.create_table(mem.table_name, data=records)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys()
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns correct record by id
    rec = mem.get("id2")
    assert isinstance(rec, list)
    assert len(rec) == 1
    assert rec[0]["id"] == "id2"
    assert rec[0]["metadata"]["tag"] == "beta"

    # Test get returns empty list for non-existent id
    rec_none = mem.get("nonexistent")
    assert rec_none == []

    # Test get_by_metadata returns correct records
    alpha_recs = mem.get_by_metadata("tag", "alpha")
    assert len(alpha_recs) == 2
    alpha_ids = {r["id"] for r in alpha_recs}
    assert alpha_ids == {"id1", "id3"}

    # Test delete_by_metadata deletes correct records
    deleted = mem.delete_by_metadata("tag", "alpha")
    assert deleted is True or deleted is False  # depends on implementation but should not error

    # After deletion, keys should not contain alpha tagged ids
    remaining_keys = mem.list_all_keys()
    assert "id2" in remaining_keys
    assert "id1" not in remaining_keys
    assert "id3" not in remaining_keys

    # Cleanup
    mem.drop(mem.table_name)


def test_delete_and_drop(memory_instance):
    mem = memory_instance

    # Setup table with one record
