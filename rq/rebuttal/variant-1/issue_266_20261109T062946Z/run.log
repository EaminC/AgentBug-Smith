    # Override client with a LanceDB client pointed at temp_dir
    import lancedb
    mem.client = lancedb.connect(temp_dir.name)
    mem.table_name = "test_table"
    # Ensure clean start by dropping if exists
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)
    yield mem
    # Cleanup
    mem.drop(mem.table_name)
    temp_dir.cleanup()

def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Add some records
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"category": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"category": "latin"}},
    ]
    # Add records to LanceDB table
    if mem.table_name not in mem.client.table_names():
        mem.client.create_table(mem.table_name, data=records)
        mem.client.open_table(mem.table_name).create_fts_index("id")
    else:
        mem.client.open_table(mem.table_name).add(data=records)

    # Test list_all_keys returns all inserted ids
    keys = mem.list_all_keys()
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns correct record for id1
    result = mem.get("id1")
    assert isinstance(result, list)
    assert len(result) == 1
    assert result[0]["id"] == "id1"
    assert result[0]["text"] == "hello world"

    # Test get returns empty list for non-existent id
    result_none = mem.get("nonexistent")
    assert isinstance(result_none, list)
    assert len(result_none) == 0

def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Add records with metadata
    records = [
        {"id": "m1", "text": "apple", "metadata": {"type": "fruit"}},
        {"id": "m2", "text": "carrot", "metadata": {"type": "vegetable"}},
        {"id": "m3", "text": "banana", "metadata": {"type": "fruit"}},
    ]
    if mem.table_name not in mem.client.table_names():
        mem.client.create_table(mem.table_name, data=records)
        mem.client.open_table(mem.table_name).create_fts_index("id")
    else:
        mem.client.open_table(mem.table_name).add(data=records)

    # Test get_by_metadata returns correct records
    fruits = mem.get_by_metadata("type", "fruit", n_results=10)
    fruit_ids = {r["id"] for r in fruits}
    assert "m1" in fruit_ids
    assert "m3" in fruit_ids
    assert "m2" not in fruit_ids

    # Test delete_by_metadata removes records with type=vegetable
    deleted = mem.delete_by_metadata("type", "vegetable")
    assert deleted is True or deleted is False  # Depends on LanceDB implementation

    # After deletion, vegetable record should be gone
    vegs = mem.get_by_metadata("type", "vegetable")
    assert vegs == []

    # Fruit records should remain
    fruits_after = mem.get_by_metadata("type", "fruit")
    fruit_ids_after = {r["id"] for r in fruits_after}
    assert "m1" in fruit_ids_after
    assert "m3" in fruit_ids_after

def test_delete_and_drop(memory_instance):
    mem = memory_instance

    # Add a record
    record = {"id": "del1", "text": "to be deleted", "metadata": {"flag": "yes"}}
    if mem.table_name not in mem.client.table_names():
        mem.client.create_table(mem.table_name, data=[record])
        mem.client.open_table(mem.table_name).create_fts_index("id")
    else:
        mem.client.open_table(mem.table_name).add(data=[record])

    # Delete by id
    deleted = mem.delete("del1")
    assert deleted is True or deleted is False  # LanceDB returns bool

    # Confirm deletion
    result = mem.get("del1")
    assert result == []

    # Drop table
    dropped = mem.drop()
    assert dropped is True or dropped is False

    # Table should no longer exist
    assert mem.table_name not in mem.client.table_names()
