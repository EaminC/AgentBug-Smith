import unittest
import tempfile
import os
from mle.utils.memory import LanceDBMemory


class TestLanceDBMemoryManageAPI(unittest.TestCase):
    def setUp(self):
        # Create a temporary directory for LanceDB storage
        self.tmpdir = tempfile.TemporaryDirectory()
        self.mem = LanceDBMemory(project_path=self.tmpdir.name, table_name="test_memory")

        # Prepare some test data
        self.test_data = [
            {"id": "id1", "query": "What is AI?", "metadata": {"category": "tech"}},
            {"id": "id2", "query": "What is Python?", "metadata": {"category": "programming"}},
            {"id": "id3", "query": "What is LanceDB?", "metadata": {"category": "database"}},
        ]
        # Add test data to the memory
        self.mem.add(self.test_data, table_name="test_memory")

    def tearDown(self):
        self.tmpdir.cleanup()

    def test_list_all_keys(self):
        keys = self.mem.list_all_keys(table_name="test_memory")
        # The keys returned should match the ids we inserted
        self.assertCountEqual(keys, [item["id"] for item in self.test_data])

    def test_get_record_by_id(self):
        record = self.mem.get("id2", table_name="test_memory")
        self.assertEqual(len(record), 1)
        self.assertEqual(record[0]["id"], "id2")
        self.assertEqual(record[0]["query"], "What is Python?")

        # Test non-existing id returns empty list
        record_none = self.mem.get("nonexistent", table_name="test_memory")
        self.assertEqual(record_none, [])

    def test_get_by_metadata(self):
        records = self.mem.get_by_metadata("category", "tech", table_name="test_memory")
        self.assertTrue(any(r["id"] == "id1" for r in records))
        self.assertFalse(any(r["id"] == "id2" for r in records))

        # Test limit parameter
        records_limited = self.mem.get_by_metadata("category", "tech", table_name="test_memory", n_results=1)
        self.assertLessEqual(len(records_limited), 1)

        # Test no match returns empty list
        no_match = self.mem.get_by_metadata("category", "nonexistent", table_name="test_memory")
        self.assertEqual(no_match, [])

    def test_delete_by_metadata(self):
        # Delete records with category "tech"
        result = self.mem.delete_by_metadata("category", "tech", table_name="test_memory")
        self.assertTrue(result)

        # After deletion, no records with category "tech" should remain
        remaining = self.mem.get_by_metadata("category", "tech", table_name="test_memory")
        self.assertEqual(remaining, [])

        # Other records should remain
        others = self.mem.list_all_keys(table_name="test_memory")
        self.assertIn("id2", others)
        self.assertIn("id3", others)


if __name__ == "__main__":
    unittest.main()
