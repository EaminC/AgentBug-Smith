import pytest
from mle.utils.memory import LanceDBMemory
import tempfile
import os

@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for LanceDB storage
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem

def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Clear table if exists
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add sample data
    data = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"category": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"category": "latin"}},
    ]
    mem.client.create_table(mem.table_name, data=data)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys()
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns correct record for id1
    rec = mem.get("id1")
    assert isinstance(rec, list)
    assert len(rec) == 1
    assert rec[0]["id"] == "id1"
    assert rec[0]["text"] == "hello world"

    # Test get returns empty list for non-existent id
    rec_none = mem.get("nonexistent")
    assert rec_none == []

def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Clear table if exists
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add sample data
    data = [
        {"id": "a1", "text": "alpha", "metadata": {"type": "letter"}},
        {"id": "b2", "text": "beta", "metadata": {"type": "letter"}},
        {"id": "c3", "text": "cat", "metadata": {"type": "animal"}},
    ]
    mem.client.create_table(mem.table_name, data=data)
    mem.client.open_table(mem.table_name).create_fts_index("id")

    # Test get_by_metadata returns correct records
    letters = mem.get_by_metadata("type", "letter", n_results=10)
    letter_ids = {r["id"] for r in letters}
    assert letter_ids == {"a1", "b2"}

    animals = mem.get_by_metadata("type", "animal")
    assert len(animals) == 1
    assert animals[0]["id"] == "c3"

    # Test delete_by_metadata deletes correct records
    deleted = mem.delete_by_metadata("type", "letter")
    assert deleted is True or deleted is False  # Depends on lancedb return

    # After deletion, get_by_metadata should return empty for letters
    letters_after = mem.get_by_metadata("type", "letter")
    assert letters_after == []

    # Animal record should still exist
    animals_after = mem.get_by_metadata("type", "animal")
    assert len(animals_after) == 1
    assert animals_after[0]["id"] == "c3"
