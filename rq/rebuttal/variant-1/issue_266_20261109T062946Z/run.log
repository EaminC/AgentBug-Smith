        {"id": "id2", "query": "What is Python?", "metadata": {"category": "language"}},
        {"id": "id3", "query": "What is OpenAI?", "metadata": {"category": "company"}},
    ]
    mem.add(records, table_name=mem.table_name)

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys()
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns the correct record for id1
    result = mem.get("id1")
    assert isinstance(result, list)
    assert len(result) == 1
    assert result[0]["id"] == "id1"
    assert result[0]["query"] == "What is AI?"

    # Test get returns empty list for non-existent id
    result_empty = mem.get("nonexistent_id")
    assert isinstance(result_empty, list)
    assert len(result_empty) == 0


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Clear table first
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add records with metadata
    records = [
        {"id": "id10", "query": "Q1", "metadata": {"tag": "keep"}},
        {"id": "id11", "query": "Q2", "metadata": {"tag": "delete"}},
        {"id": "id12", "query": "Q3", "metadata": {"tag": "delete"}},
    ]
    mem.add(records, table_name=mem.table_name)

    # Test get_by_metadata returns correct records
    results = mem.get_by_metadata("tag", "delete")
    assert isinstance(results, list)
    assert len(results) == 2
    ids = {r["id"] for r in results}
    assert ids == {"id11", "id12"}

    # Test delete_by_metadata deletes correct records
    success = mem.delete_by_metadata("tag", "delete")
    assert success is True

    # After deletion, get_by_metadata should return empty list
    results_after = mem.get_by_metadata("tag", "delete")
    assert isinstance(results_after, list)
    assert len(results_after) == 0

    # The record with tag "keep" should still exist
    keep_results = mem.get_by_metadata("tag", "keep")
    assert len(keep_results) == 1
    assert keep_results[0]["id"] == "id10"


def test_delete_and_drop(memory_instance):
    mem = memory_instance

    # Clear table first
    if mem.table_name in mem.client.table_names():
        mem.drop(mem.table_name)

    # Add a record
    record = [{"id": "del1", "query": "Delete me", "metadata": {"foo": "bar"}}]
    mem.add(record, table_name=mem.table_name)

    # Delete the record by id
    deleted = mem.delete("del1")
    assert deleted is True

    # Confirm deletion
    result = mem.get("del1")
    assert isinstance(result, list)
    assert len(result) == 0

    # Drop the entire table
    dropped = mem.drop()
    assert dropped is True

    # Table should no longer exist
    assert mem.table_name not in mem.client.table_names()
