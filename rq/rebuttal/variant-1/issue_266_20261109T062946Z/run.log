def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Clear any existing data in the test table
    mem.drop("test_memory")

    # Add some test data
    test_data = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
        {"id": "id2", "text": "goodbye world", "metadata": {"category": "farewell"}},
        {"id": "id3", "text": "hello again", "metadata": {"category": "greeting"}},
    ]
    mem.client.create_table("test_memory", data=test_data)
    mem.client.open_table("test_memory").create_fts_index("id")

    # Test list_all_keys returns all IDs
    keys = mem.list_all_keys("test_memory")
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns the correct record for id1
    record = mem.get("id1", "test_memory")
    assert isinstance(record, list)
    assert len(record) == 1
    assert record[0]["id"] == "id1"
    assert record[0]["text"] == "hello world"

    # Test get returns empty list for non-existent id
    no_record = mem.get("nonexistent_id", "test_memory")
    assert isinstance(no_record, list)
    assert len(no_record) == 0


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Clear any existing data in the test table
    mem.drop("test_memory")

    # Add some test data
    test_data = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
        {"id": "id2", "text": "goodbye world", "metadata": {"category": "farewell"}},
        {"id": "id3", "text": "hello again", "metadata": {"category": "greeting"}},
    ]
    mem.client.create_table("test_memory", data=test_data)
    mem.client.open_table("test_memory").create_fts_index("id")

    # Test get_by_metadata returns correct records
    greetings = mem.get_by_metadata("category", "greeting", "test_memory", n_results=10)
    assert isinstance(greetings, list)
    assert len(greetings) == 2
    ids = {r["id"] for r in greetings}
    assert ids == {"id1", "id3"}

    # Test delete_by_metadata deletes the correct records
    result = mem.delete_by_metadata("category", "farewell", "test_memory")
    assert result is True or result is False  # Depending on LanceDB implementation

    # After deletion, only greeting category records remain
    remaining_keys = mem.list_all_keys("test_memory")
    assert "id2" not in remaining_keys
    assert "id1" in remaining_keys
    assert "id3" in remaining_keys


def test_delete_and_drop(memory_instance):
    mem = memory_instance

    # Clear any existing data in the test table
    mem.drop("test_memory")

    # Add test data
    test_data = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
