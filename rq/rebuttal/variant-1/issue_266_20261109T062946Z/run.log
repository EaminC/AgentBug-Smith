import os
import tempfile
import pytest
from mle.utils.memory import LanceDBMemory


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for LanceDB storage
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem


def test_add_and_list_all_keys(memory_instance):
    mem = memory_instance

    # Prepare sample data
    data = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"category": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"category": "latin"}},
    ]

    # Add data to memory
    mem.add(data)

    # List all keys
    keys = mem.list_all_keys()
    # We expect all three ids to be present
    assert set(keys) == {"id1", "id2", "id3"}


def test_get_record_by_id(memory_instance):
    mem = memory_instance

    # Add a record
    record = {"id": "unique_id_123", "text": "some text", "metadata": {"tag": "special"}}
    mem.add([record])

    # Retrieve by id
    result = mem.get("unique_id_123")
    assert isinstance(result, list)
    assert len(result) == 1
    assert result[0]["id"] == "unique_id_123"
    assert result[0]["text"] == "some text"
    assert result[0]["metadata"]["tag"] == "special"

    # Test retrieving non-existent id returns empty list
    empty_result = mem.get("non_existent_id_456")
    assert isinstance(empty_result, list)
    assert len(empty_result) == 0


def test_get_by_metadata(memory_instance):
    mem = memory_instance

    # Add multiple records with metadata
    records = [
        {"id": "m1", "text": "alpha", "metadata": {"type": "A"}},
        {"id": "m2", "text": "beta", "metadata": {"type": "B"}},
        {"id": "m3", "text": "gamma", "metadata": {"type": "A"}},
    ]
    mem.add(records)

    # Query by metadata key-value
    results = mem.get_by_metadata("type", "A")
    assert isinstance(results, list)
    ids = {r["id"] for r in results}
    assert "m1" in ids
    assert "m3" in ids
    assert "m2" not in ids

    # Limit results
    limited_results = mem.get_by_metadata("type", "A", n_results=1)
    assert len(limited_results) == 1


def test_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Add records with metadata
    records = [
        {"id": "d1", "text": "to delete 1", "metadata": {"remove": "yes"}},
        {"id": "d2", "text": "to keep", "metadata": {"remove": "no"}},
        {"id": "d3", "text": "to delete 2", "metadata": {"remove": "yes"}},
    ]
    mem.add(records)

    # Delete by metadata
    success = mem.delete_by_metadata("remove", "yes")
    assert success is True or success is False  # Accept either, depends on implementation

    # After deletion, none of the deleted ids should be found
    remaining_keys = mem.list_all_keys()
    assert "d2" in remaining_keys
    assert "d1" not in remaining_keys
    assert "d3" not in remaining_keys


def test_delete_record(memory_instance):
    mem = memory_instance

    # Add a record
    record = {"id": "del_id", "text": "delete me", "metadata": {"flag": "del"}}
    mem.add([record])

    # Delete the record
    deleted = mem.delete("del_id")
    assert deleted is True or deleted is False  # Accept either, depends on implementation

    # Confirm deletion
    result = mem.get("del_id")
    assert isinstance(result, list)
    assert len(result) == 0


def test_drop_table(memory_instance):
    mem = memory_instance

    # Add a record to ensure table exists
