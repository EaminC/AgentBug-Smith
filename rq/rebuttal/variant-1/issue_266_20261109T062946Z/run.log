import pytest
from mle.utils.memory import LanceDBMemory
import tempfile
import os


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory for LanceDB storage
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Clear any existing data
    mem.drop("test_memory")

    # Add some records
    records = [
        {"id": "id1", "text": "hello world", "metadata": {"tag": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"tag": "test"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"tag": "latin"}},
    ]
    mem.client.create_table("test_memory", data=records)
    mem.client.open_table("test_memory").create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys("test_memory")
    assert set(keys) == {"id1", "id2", "id3"}

    # Test get returns the correct record for id1
    result = mem.get("id1", "test_memory")
    assert isinstance(result, list)
    assert len(result) == 1
    assert result[0]["id"] == "id1"
    assert result[0]["text"] == "hello world"

    # Test get returns empty list for non-existent id
    result_none = mem.get("nonexistent", "test_memory")
    assert isinstance(result_none, list)
    assert len(result_none) == 0

def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    mem.drop("test_memory")

    records = [
        {"id": "id10", "text": "apple", "metadata": {"category": "fruit"}},
        {"id": "id11", "text": "banana", "metadata": {"category": "fruit"}},
        {"id": "id12", "text": "carrot", "metadata": {"category": "vegetable"}},
    ]
    mem.client.create_table("test_memory", data=records)
    mem.client.open_table("test_memory").create_fts_index("id")

    # Test get_by_metadata returns correct records
    fruits = mem.get_by_metadata("category", "fruit", "test_memory", n_results=10)
    fruit_ids = {r["id"] for r in fruits}
    assert fruit_ids == {"id10", "id11"}

    # Test delete_by_metadata removes correct records
    deleted = mem.delete_by_metadata("category", "fruit", "test_memory")
    assert deleted is True

    # After deletion, get_by_metadata for fruit returns empty
    fruits_after = mem.get_by_metadata("category", "fruit", "test_memory", n_results=10)
    assert fruits_after == []

    # The vegetable record should remain
    vegs = mem.get_by_metadata("category", "vegetable", "test_memory", n_results=10)
    assert len(vegs) == 1
    assert vegs[0]["id"] == "id12"

def test_delete_and_drop(memory_instance):
    mem = memory_instance

    mem.drop("test_memory")

    records = [
        {"id": "id20", "text": "data1", "metadata": {}},
        {"id": "id21", "text": "data2", "metadata": {}},
    ]
    mem.client.create_table("test_memory", data=records)
    mem.client.open_table("test_memory").create_fts_index("id")

    # Delete one record by id
    deleted = mem.delete("id20", "test_memory")
    assert deleted is True

    # Confirm id20 is gone
    keys = mem.list_all_keys("test_memory")
    assert "id20" not in keys
    assert "id21" in keys

    # Drop entire table
    dropped = mem.drop("test_memory")
    assert dropped is True

    # Table should no longer exist
    assert "test_memory" not in mem.client.table_names()
