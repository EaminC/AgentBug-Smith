import pytest
import uuid
from mle.utils.memory import LanceDBMemory


@pytest.fixture(scope="module")
def memory():
    # Use a temporary in-memory LanceDB client for testing
    # The LanceDBMemory constructor requires no arguments for default client
    mem = LanceDBMemory()
    # Ensure clean state
    try:
        mem.drop()
    except Exception:
        pass
    yield mem
    # Cleanup after tests
    try:
        mem.drop()
    except Exception:
        pass


def test_list_all_keys_and_get(memory):
    # Add some records
    records = [
        {"id": str(uuid.uuid4()), "text": "first record", "metadata": {"tag": "alpha"}},
        {"id": str(uuid.uuid4()), "text": "second record", "metadata": {"tag": "beta"}},
        {"id": str(uuid.uuid4()), "text": "third record", "metadata": {"tag": "alpha"}},
    ]
    # Add records to the memory table
    for rec in records:
        memory.add(
            [
                {
                    "id": rec["id"],
                    "text": rec["text"],
                    "metadata": rec["metadata"],
                }
            ],
            table_name=memory.table_name,
        )

    # List all keys
    keys = memory.list_all_keys()
    # All added record ids should be in the keys list
    for rec in records:
        assert rec["id"] in keys

    # Test get by id returns the correct record
    for rec in records:
        result = memory.get(rec["id"])
        assert isinstance(result, list)
        assert len(result) == 1
        assert result[0]["id"] == rec["id"]
        assert result[0]["text"] == rec["text"]
        assert result[0]["metadata"] == rec["metadata"]


def test_get_by_metadata_and_delete_by_metadata(memory):
    # Add records with metadata tags
    records = [
        {"id": str(uuid.uuid4()), "text": "record one", "metadata": {"category": "test"}},
        {"id": str(uuid.uuid4()), "text": "record two", "metadata": {"category": "test"}},
        {"id": str(uuid.uuid4()), "text": "record three", "metadata": {"category": "prod"}},
    ]
    for rec in records:
        memory.add(
            [
                {
                    "id": rec["id"],
                    "text": rec["text"],
                    "metadata": rec["metadata"],
                }
            ],
            table_name=memory.table_name,
        )

    # Retrieve by metadata key-value pair
    test_records = memory.get_by_metadata("category", "test", n_results=10)
    assert isinstance(test_records, list)
    # Should find exactly the two records with category "test"
    found_ids = {r["id"] for r in test_records}
    expected_ids = {records[0]["id"], records[1]["id"]}
    assert found_ids == expected_ids

    # Delete by metadata key-value pair
    success = memory.delete_by_metadata("category", "test")
    assert success is True

    # After deletion, get_by_metadata for "test" should return empty list
    test_records_after = memory.get_by_metadata("category", "test")
    assert test_records_after == []

    # Records with category "prod" should still exist
    prod_records = memory.get_by_metadata("category", "prod")
    assert len(prod_records) == 1
    assert prod_records[0]["id"] == records[2]["id"]


def test_delete_and_drop(memory):
    # Add a record
    rec_id = str(uuid.uuid4())
    memory.add(
        [
            {
                "id": rec_id,
                "text": "to be deleted",
                "metadata": {"flag": "delete"},
            }
        ],
        table_name=memory.table_name,
    )

    # Confirm record exists
    result = memory.get(rec_id)
    assert len(result) == 1

    # Delete the record by id
    deleted = memory.delete(rec_id)
    assert deleted is True

    # Confirm record no longer exists
    result_after = memory.get(rec_id)
    assert result_after == []

    # Drop the entire table
    dropped = memory.drop()
    assert dropped is True

    # After drop, listing keys should raise or return empty
    with pytest.raises(Exception):
        memory.list_all_keys()
