import pytest
from mle.utils.memory import LanceDBMemory
import tempfile
import os


@pytest.fixture(scope="module")
def memory_instance():
    # Create a temporary directory to store the LanceDB database
    with tempfile.TemporaryDirectory() as tmpdir:
        mem = LanceDBMemory(project_path=tmpdir, table_name="test_memory")
        yield mem


def test_list_all_keys_and_get(memory_instance):
    mem = memory_instance

    # Clear any existing data
    mem.drop("test_memory")

    # Add some test data
    test_data = [
        {"id": "id1", "text": "hello world", "metadata": {"category": "greeting"}},
        {"id": "id2", "text": "foo bar", "metadata": {"category": "example"}},
        {"id": "id3", "text": "lorem ipsum", "metadata": {"category": "latin"}},
    ]
    mem.client.create_table("test_memory", data=test_data)
    mem.client.open_table("test_memory").create_fts_index("id")

    # Test list_all_keys returns all ids
    keys = mem.list_all_keys("test_memory")
    assert set(keys) == {"id1", "id2", "id3"}, f"Expected keys to be all ids, got {keys}"

    # Test get returns correct record by id
    record = mem.get("id2", "test_memory")
    assert isinstance(record, list), "get() should return a list"
    assert len(record) == 1, "get() should return exactly one record for existing id"
    assert record[0]["id"] == "id2", f"Expected id2 record, got {record[0]['id']}"

    # Test get returns empty list for non-existing id
    no_record = mem.get("nonexistent", "test_memory")
    assert isinstance(no_record, list), "get() should return a list"
    assert len(no_record) == 0, "get() should return empty list for non-existing id"


def test_get_by_metadata_and_delete_by_metadata(memory_instance):
    mem = memory_instance

    # Clear and add test data
    mem.drop("test_memory")
    test_data = [
        {"id": "idA", "text": "alpha", "metadata": {"tag": "first"}},
        {"id": "idB", "text": "beta", "metadata": {"tag": "second"}},
        {"id": "idC", "text": "gamma", "metadata": {"tag": "first"}},
    ]
    mem.client.create_table("test_memory", data=test_data)
    mem.client.open_table("test_memory").create_fts_index("id")

    # Test get_by_metadata returns correct records
    results = mem.get_by_metadata("tag", "first", "test_memory", n_results=10)
    ids = {r["id"] for r in results}
    assert ids == {"idA", "idC"}, f"Expected records with tag=first, got {ids}"

    # Test delete_by_metadata deletes correct records
    success = mem.delete_by_metadata("tag", "first", "test_memory")
    assert success is True or success is False, "delete_by_metadata should return a boolean"

    # After deletion, records with tag=first should be gone
    remaining = mem.get_by_metadata("tag", "first", "test_memory")
    assert len(remaining) == 0, "Records with tag=first should be deleted"

    # Records with tag=second should remain
    remaining_second = mem.get_by_metadata("tag", "second", "test_memory")
    assert len(remaining_second) == 1 and remaining_second[0]["id"] == "idB"


def test_delete_and_drop(memory_instance):
