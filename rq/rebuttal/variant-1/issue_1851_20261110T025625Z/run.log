[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter3/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter3/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter3/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Copy entire repository into the container
COPY . .

# Install system dependencies needed to build Python packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libc6-dev libpq-dev libffi-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies and project itself
RUN if [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt && pip install -e . ; \
elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
    pip install poetry && poetry install && pip install -e . ; \
elif [ -f "pyproject.toml" ]; then \
    pip install -e . ; \
else \
    pip install -e . ; \
fi

# Install pytest and important test dependencies
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm mem0ai vcrpy json_repair chromadb syrupy respx langgraph-checkpoint-sqlite aiosqlite langgraph-checkpoint-postgres "psycopg[binary,pool]" redis apscheduler fastapi fakeredis mcp "ray[default]" boto3 agno pydantic-ai fastmcp

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set PYTHONPATH depending on repo structure
RUN if [ -d "src" ]; then \
    echo 'src layout detected, setting PYTHONPATH /app:/app/src' && \
    echo 'export PYTHONPATH=/app:/app/src' >> /etc/profile; \
    export PYTHONPATH=/app:/app/src; \
else \
    echo 'No src layout detected, setting PYTHONPATH /app' && \
    echo 'export PYTHONPATH=/app' >> /etc/profile; \
    export PYTHONPATH=/app; \
fi

ENV PYTHONPATH=/app:/app/src

CMD ["/bin/bash"]

