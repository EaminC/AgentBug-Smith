[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter3/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter3/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter3/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Inject environment variables for Forge API and Anthropic compatibility
ENV FORGE_API_KEY=forge-key \
    FORGE_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    # Fudge setuptools_scm version to avoid build error
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_AIDER_CHAT=0.0.0

# Copy entire repository
COPY . .

# Install system dependencies needed for build
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libc6-dev libpq-dev libffi-dev libssl-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Upgrade pip setuptools wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies from requirements.txt if present
RUN if [ -f requirements.txt ]; then \
    grep -v '^litellm' requirements.txt > requirements_no_litellm.txt && pip install --no-cache-dir -r requirements_no_litellm.txt ; \
    else echo "No requirements.txt found" ; \
    fi

# Install package editable mode plus test deps, including litellm unpinned
RUN pip install --no-cache-dir -e . \
    pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network \
    "setuptools<=81.0.0" litellm mem0ai vcrpy json_repair chromadb syrupy \
    respx langgraph-checkpoint-sqlite aiosqlite langgraph-checkpoint-postgres \
    "psycopg[binary,pool]" redis apscheduler fastapi fakeredis mcp "ray[default]" \
    boto3 agno pydantic-ai fastmcp

# Confirm successful install and pytest import
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set PYTHONPATH for imports
ENV PYTHONPATH=/app

# Default command to launch bash shell
CMD ["/bin/bash"]

# branch: python/requirements.txt with setuptools-scm version fudge
