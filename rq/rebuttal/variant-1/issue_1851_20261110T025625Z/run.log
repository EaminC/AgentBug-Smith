RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies from requirements.txt, filtering out litellm to avoid version conflict
RUN if [ -f requirements.txt ]; then \
    grep -vE '^litellm==' requirements.txt > requirements_filtered.txt && \
    pip install --no-cache-dir -r requirements_filtered.txt; \
    fi

# Install the package and standard Python test dependencies alongside a compatible litellm version
RUN pip install --no-cache-dir -e . pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm mem0ai vcrpy json_repair chromadb syrupy respx langgraph-checkpoint-sqlite aiosqlite langgraph-checkpoint-postgres "psycopg[binary,pool]" redis apscheduler fastapi fakeredis mcp "ray[default]" boto3 agno pydantic-ai fastmcp || true

# Preflight test to confirm installation
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]
