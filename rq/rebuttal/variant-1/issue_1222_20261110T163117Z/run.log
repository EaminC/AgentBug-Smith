[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set environment variables for Forge API (OpenAI-compatible and Anthropic-compatible)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set working directory to the root of the repository
WORKDIR /app

# Install system dependencies needed for typical Python package installations
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy full repository into container
COPY . .

# Upgrade pip, setuptools and wheel early
RUN python -m pip install --upgrade pip setuptools wheel

# Install python dependencies from requirements.txt, if it exists, and then install the repo editable
RUN if [ -f "requirements.txt" ]; then pip install -r requirements.txt; fi && \
    pip install -e .

# Install pytest and common pytest plugins explicitly to ensure test environment
RUN pip install --no-cache-dir pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network setuptools<=81.0.0 litellm

# Set PYTHONPATH to /app for module imports
ENV PYTHONPATH=/app

# Default command to start a bash shell, needed for the test harness
CMD ["/bin/bash"]

