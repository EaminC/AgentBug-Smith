# Install project dependencies including full and dev optional dependencies and essential test packages
RUN pip install --no-cache-dir -e .[full,dev] \
    && pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm mcp ray fakeredis aiosqlite greenlet py-openjudge

# Set PYTHONPATH for src layout
ENV PYTHONPATH=/app:/app/src

# Default command to keep the container interactive bash shell
CMD ["/bin/bash"]

