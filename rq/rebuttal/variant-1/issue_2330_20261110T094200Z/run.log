    ), "researcher agent's function_calling_llm should be the local_llm instance"

    # reporting_analyst agent's function_calling_llm should be the online_llm instance
    reporting_agent = crew.reporting_analyst()
    assert (
        isinstance(reporting_agent["function_calling_llm"], LLM)
    ), "reporting_analyst agent's function_calling_llm should be an LLM instance"
    assert (
