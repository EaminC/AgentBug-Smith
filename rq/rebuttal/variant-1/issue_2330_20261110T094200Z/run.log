[32mimport pytest

from crewai.llm import LLM
from crewai.project import CrewBase, agent, llm, task


@CrewBase
class TestFunctionCallingLLMCrew:
    agents_config = "tests/config/agents.yaml"
    tasks_config = "tests/config/tasks.yaml"

    @llm
    def local_llm(self):
        return LLM(
            model="openai/model_name",
            api_key="None",
            base_url="http://xxx.xxx.xxx.xxx:8000/v1",
        )

    @agent
    def researcher(self):
        return LLM(
            model="openai/model_name",
            api_key="None",
            base_url="http://xxx.xxx.xxx.xxx:8000/v1",
        )

    @agent
    def reporting_analyst(self):
        return LLM(
            model="online_llm",
            api_key="None",
            base_url="http://xxx.xxx.xxx.xxx:8000/v1",
        )

    @task
    def research_task(self):
        return {"description": "dummy", "expected_output": "dummy"}

    @task
    def reporting_task(self):
        return {"description": "dummy", "expected_output": "dummy"}


def test_function_calling_llm_mapping():
    crew = TestFunctionCallingLLMCrew()

    # The local_llm method returns an LLM instance
    local_llm_instance = crew.local_llm()

    # researcher agent should have function_calling_llm resolved to the local_llm instance
    researcher_agent = crew.researcher()
    # We expect that the function_calling_llm attribute of the agent config is set to the local_llm instance
    # This tests the fix that looks up function_calling_llm in llms, not agents
    assert (
        researcher_agent.function_calling_llm is local_llm_instance
    ), "researcher agent's function_calling_llm should be the local_llm instance"

    # reporting_analyst agent has function_calling_llm as a string "online_llm" (not registered llm)
    reporting_agent = crew.reporting_analyst()
    # The fix should fallback to string if not found in llms, so function_calling_llm remains a string
    assert (
        reporting_agent.function_calling_llm == "online_llm"
    ), "reporting_analyst agent's function_calling_llm should fallback to string 'online_llm'"[0m
