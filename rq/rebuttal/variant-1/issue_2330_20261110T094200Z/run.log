from crewai.llm import LLM
from crewai.project import CrewBase, agent, llm


@CrewBase
class TestCrewFunctionCallingLLM:
    agents_config = "tests/config/agents.yaml"
    tasks_config = "tests/config/tasks.yaml"

    @llm
    def local_llm(self):
        return LLM(
            model="openai/model_name",
            api_key="None",
            base_url="http://xxx.xxx.xxx.xxx:8000/v1",
        )

    @llm
    def online_llm(self):
        return LLM(
            model="online_llm",
            api_key="None",
            base_url="http://yyy.yyy.yyy.yyy:8000/v1",
        )

    @agent
    def researcher(self):
        from crewai.agent import Agent

        return Agent(config=self.agents_config["researcher"])

    @agent
    def reporting_analyst(self):
        from crewai.agent import Agent

        return Agent(config=self.agents_config["reporting_analyst"])


def test_function_calling_llm_mapping():
    crew = TestCrewFunctionCallingLLM()

    # The researcher agent has function_calling_llm set to "local_llm" which is a registered llm method
    researcher_agent = crew.researcher()
    local_llm_instance = crew.local_llm()
    assert (
        researcher_agent.function_calling_llm is local_llm_instance
    ), "Agent's function_calling_llm should be the local_llm instance"

    # The reporting_analyst agent has function_calling_llm set to a string "online_llm"
    reporting_agent = crew.reporting_analyst()
    # It should resolve to the online_llm instance
    online_llm_instance = crew.online_llm()
    # The agent's function_calling_llm should be an LLM instance with model "online_llm"
    assert (
        reporting_agent.function_calling_llm.model == "online_llm"
    ), "Agent's function_calling_llm should be the online_llm instance"

    # Also ensure that the function_calling_llm attribute is an instance of LLM
    assert isinstance(
        reporting_agent.function_calling_llm, LLM
    ), "Agent's function_calling_llm should be an LLM instance"[0m
