[32mfrom crewai.llm import LLM
from crewai.project import CrewBase, agent, llm


@CrewBase
class TestCrewFunctionCallingLLM:
    agents_config = "config/agents.yaml"

    @llm
    def local_llm(self):
        return LLM(
            model="openai/model_name",
            api_key="None",
            base_url="http://xxx.xxx.xxx.xxx:8000/v1",
        )

    @agent
    def researcher(self):
        return self.agents_config["researcher"]

    @agent
    def reporting_analyst(self):
        return self.agents_config["reporting_analyst"]


def test_agent_function_calling_llm_mapping():
    crew = TestCrewFunctionCallingLLM()

    # The 'researcher' agent has function_calling_llm set to "local_llm" which is a registered llm function
    researcher_agent = crew.researcher()
    local_llm_instance = crew.local_llm()
    assert (
        researcher_agent.function_calling_llm is local_llm_instance
    ), "The researcher agent's function_calling_llm should be the local_llm instance"

    # The 'reporting_analyst' agent has function_calling_llm set to "online_llm" which is not registered as a function,
    # so it should remain as the string "online_llm"
    reporting_agent = crew.reporting_analyst()
    assert (
        reporting_agent.function_calling_llm == "online_llm"
    ), "The reporting_analyst agent's function_calling_llm should remain the string 'online_llm' if not registered"[0m
