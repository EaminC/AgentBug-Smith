[32mimport pytest

from crewai.llm import LLM
from crewai.project import CrewBase, agent, crew, llm, task
from crewai.agent import Agent
from crewai.crew import Crew
from crewai.task import Task


@CrewBase
class InternalCrew:
    agents_config = "config/agents.yaml"
    tasks_config = "config/tasks.yaml"

    @llm
    def local_llm(self):
        return LLM(
            model='openai/model_name',
            api_key="None",
            base_url="http://xxx.xxx.xxx.xxx:8000/v1"
        )

    @agent
    def researcher(self):
        return Agent(config=self.agents_config["researcher"])

    @agent
    def reporting_analyst(self):
        return Agent(config=self.agents_config["reporting_analyst"])

    @task
    def research_task(self):
        return Task(config=self.tasks_config["research_task"])

    @task
    def reporting_task(self):
        return Task(config=self.tasks_config["reporting_task"])

    @crew
    def crew(self):
        return Crew(agents=self.agents, tasks=self.tasks, verbose=True)


def test_agent_function_calling_llm():
    crew = InternalCrew()
    llm_instance = crew.local_llm()
    researcher_agent = crew.researcher()
    reporting_agent = crew.reporting_analyst()

    # The researcher agent's function_calling_llm should be the local_llm instance
    assert (
        researcher_agent.function_calling_llm is llm_instance
    ), "researcher agent's function_calling_llm should be the local_llm instance"

    # The reporting analyst agent's function_calling_llm should be a string "online_llm"
    # because "online_llm" is not registered in llms, so it falls back to string
    assert (
        reporting_agent.function_calling_llm == "online_llm"
    ), "reporting analyst agent's function_calling_llm should fallback to string 'online_llm'"

    # The crew kickoff should run without KeyError related to function_calling_llm
    # Run kickoff with inputs that match the tasks expecting these agents
    inputs = {
        "topic": "plants",
        "keyword": "failed",
        "log_file": "/home/tecs/sa.log",
        "capture_time": 5,
        "now_time": "2025-02-28 17:19:00",
        "remote_host": "127.0.0.1",
    }

    crew_instance = crew.crew()
    result = crew_instance.kickoff(inputs=inputs)

    # The kickoff should produce a result object with a raw attribute containing some expected string
    # We check that the result contains the topic "plants" indicating the before_kickoff hook or agent ran
    assert hasattr(result, "raw"), "kickoff result should have 'raw' attribute"
    assert "plants" in result.raw, "kickoff result raw output should contain 'plants'"[0m
