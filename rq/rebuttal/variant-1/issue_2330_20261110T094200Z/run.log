[32mimport pytest

from crewai.llm import LLM
from crewai.project import CrewBase, agent, llm, task


@CrewBase
class TestCrewFunctionCallingLLM:
    agents_config = "tests/config/agents.yaml"
    tasks_config = "tests/config/tasks.yaml"

    @llm
    def local_llm(self):
        return LLM(
            model="openai/model_name",
            api_key="None",
            base_url="http://xxx.xxx.xxx.xxx:8000/v1",
        )

    @agent
    def researcher(self):
        from crewai.agent import Agent

        return Agent(config=self.agents_config["researcher"])

    @agent
    def reporting_analyst(self):
        from crewai.agent import Agent

        return Agent(config=self.agents_config["reporting_analyst"])

    @task
    def research_task(self):
        from crewai.task import Task

        return Task(config=self.tasks_config["research_task"])

    @task
    def reporting_task(self):
        from crewai.task import Task

        return Task(config=self.tasks_config["reporting_task"])


def test_function_calling_llm_mapping():
    crew = TestCrewFunctionCallingLLM()

    # The researcher agent has function_calling_llm set to "local_llm" which is a registered llm method
    researcher_agent = crew.researcher()
    local_llm_instance = crew.local_llm()
    # The function_calling_llm attribute should be the actual llm instance, not a string
    assert (
        researcher_agent.function_calling_llm is local_llm_instance
    ), "researcher agent's function_calling_llm should be the local_llm instance"

    # The reporting_analyst agent has function_calling_llm set to "online_llm" which is NOT registered as llm method
    reporting_agent = crew.reporting_analyst()
    # It should fallback to the string value as per the fix
    assert (
        reporting_agent.function_calling_llm == "online_llm"
    ), "reporting_analyst agent's function_calling_llm should fallback to string 'online_llm'"[0m
