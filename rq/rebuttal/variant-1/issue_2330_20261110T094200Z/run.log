[32mimport pytest

from crewai.llm import LLM
from crewai.project import CrewBase, agent, crew, llm, task
from crewai.agent import Agent


@CrewBase
class TestCrewWithFunctionCallingLLM:
    agents_config = "tests/config/agents.yaml"
    tasks_config = "tests/config/tasks.yaml"

    @llm
    def local_llm(self):
        # Return a dummy LLM instance
        return LLM(
            model="openai/model_name",
            api_key="None",
            base_url="http://xxx.xxx.xxx.xxx:8000/v1",
        )

    @agent
    def researcher(self):
        return Agent(config=self.agents_config["researcher"])

    @agent
    def reporting_analyst(self):
        return Agent(config=self.agents_config["reporting_analyst"])

    @task
    def research_task(self):
        return None  # Not needed for this test

    @task
    def reporting_task(self):
        return None  # Not needed for this test

    @crew
    def crew(self):
        # Minimal crew for kickoff test
        from crewai.crew import Crew

        return Crew(agents=self.agents, tasks=self.tasks, verbose=False)


def test_agent_function_calling_llm():
    crew = TestCrewWithFunctionCallingLLM()

    # The researcher agent has function_calling_llm set to "local_llm" which is registered as an llm function
    researcher_agent = crew.researcher()
    local_llm_instance = crew.local_llm()

    # The function_calling_llm attribute on the agent should be the actual LLM instance, not a string
    assert (
        researcher_agent.function_calling_llm is local_llm_instance
    ), "Agent's function_calling_llm should be the LLM instance returned by the llm method"

    # The reporting_analyst agent has function_calling_llm set to "online_llm" which is not registered as an llm function,
    # so the attribute should remain a string (fallback)
    reporting_agent = crew.reporting_analyst()
    assert isinstance(
        reporting_agent.function_calling_llm, str
    ), "Agent's function_calling_llm should be a string fallback when llm not found"
    assert reporting_agent.function_calling_llm == "online_llm"


def test_crew_kickoff_runs_without_keyerror():
    crew = TestCrewWithFunctionCallingLLM()

    # Prepare inputs that match the expected keys for the researcher agent's task
    inputs = {
        "topic": "LLMs",
    }

    # The kickoff should run without raising KeyError related to function_calling_llm
    # We do not care about the actual output here, only that no exception is raised
    result = crew.crew().kickoff(inputs=inputs)
    assert result is not None, "Crew kickoff should return a result object"


@pytest.mark.vcr(filter_headers=["authorization"])
def test_agent_function_calling_llm_vcr():
    # This test is to ensure no regression with VCR recordings if used in the repo
    crew = TestCrewWithFunctionCallingLLM()
    researcher_agent = crew.researcher()
    assert researcher_agent.function_calling_llm is not None


@pytest.mark.vcr(filter_headers=["authorization"])
def test_crew_kickoff_runs_without_keyerror_vcr():
    crew = TestCrewWithFunctionCallingLLM()
    inputs = {"topic": "LLMs"}
    result = crew.crew().kickoff(inputs=inputs)
    assert result is not None[0m
