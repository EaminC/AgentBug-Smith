[32mimport pytest

from crewai.llm import LLM
from crewai.project import CrewBase, agent, crew, llm, task
from crewai.agent import Agent
from crewai.crew import Crew
from crewai.task import Task


@CrewBase
class InternalCrew:
    agents_config = "config/agents.yaml"
    tasks_config = "config/tasks.yaml"

    @llm
    def local_llm(self):
        return LLM(
            model='openai/model_name',
            api_key="None",
            base_url="http://xxx.xxx.xxx.xxx:8000/v1"
        )

    @agent
    def researcher(self):
        return Agent(config=self.agents_config["researcher"])

    @agent
    def reporting_analyst(self):
        return Agent(config=self.agents_config["reporting_analyst"])

    @task
    def research_task(self):
        return Task(config=self.tasks_config["research_task"])

    @task
    def reporting_task(self):
        return Task(config=self.tasks_config["reporting_task"])

    @crew
    def crew(self):
        return Crew(agents=self.agents, tasks=self.tasks, verbose=True)


def test_agent_function_calling_llm():
    crew = InternalCrew()
    llm_instance = crew.local_llm()
    researcher_agent = crew.researcher()
    reporting_agent = crew.reporting_analyst()

    # The researcher agent's function_calling_llm should be the local_llm instance
    assert (
        researcher_agent.function_calling_llm is llm_instance
    ), "Agent's function_calling_llm should be the registered local_llm instance"

    # The reporting_analyst agent's function_calling_llm is a string 'online_llm' (not registered),
    # so it should remain a string after mapping (fallback behavior)
    assert (
        isinstance(reporting_agent.function_calling_llm, str)
        and reporting_agent.function_calling_llm == "online_llm"
    ), "Agent's function_calling_llm should remain as string if not found in registered LLMs"


@pytest.mark.vcr(filter_headers=["authorization"])
def test_crew_kickoff_runs_without_keyerror():
    crew = InternalCrew()
    inputs = {"topic": "LLMs"}
    # kickoff should run without raising KeyError related to function_calling_llm
    result = crew.crew().kickoff(inputs=inputs)
    assert result is not None


@pytest.mark.vcr(filter_headers=["authorization"])
def test_agent_and_task_memoization():
    crew = InternalCrew()
    first_agent = crew.researcher()
    second_agent = crew.researcher()
    assert first_agent is second_agent, "Agent memoization failed"

    first_task = crew.research_task()
    second_task = crew.research_task()
    assert first_task is second_task, "Task memoization failed"

    first_crew = crew.crew()
    second_crew = crew.crew()
    assert first_crew is second_crew, "Crew memoization failed"[0m
