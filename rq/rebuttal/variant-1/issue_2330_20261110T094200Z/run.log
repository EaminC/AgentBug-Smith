from crewai.llm import LLM
from crewai.project import CrewBase, agent, llm


@CrewBase
class TestFunctionCallingLLMCrew:
    agents_config = {
        "researcher": {
            "role": "Researcher Role",
            "goal": "Researcher Goal",
            "backstory": "Researcher Backstory",
            "function_calling_llm": "local_llm",
        },
        "reporting_analyst": {
            "role": "Reporting Analyst Role",
            "goal": "Reporting Analyst Goal",
            "backstory": "Reporting Analyst Backstory",
            "function_calling_llm": "online_llm",
        },
    }
    tasks_config = {}

    @llm
    def local_llm(self):
        return LLM(
            model="openai/model_name",
            api_key="None",
            base_url="http://xxx.xxx.xxx.xxx:8000/v1",
        )

    @llm
    def online_llm(self):
        return LLM(
            model="online_llm",
            api_key="None",
            base_url="http://online.llm.server/v1",
        )

    @agent
    def researcher(self):
        return self.agents_config["researcher"]

    @agent
    def reporting_analyst(self):
        return self.agents_config["reporting_analyst"]


def test_function_calling_llm_mapping():
    crew = TestFunctionCallingLLMCrew()

    # The local_llm method returns an LLM instance
    local_llm_instance = crew.local_llm()

    # researcher agent should have function_calling_llm resolved to the local_llm instance
    researcher_agent = crew.researcher()
    assert (
        researcher_agent["function_calling_llm"] is local_llm_instance
    ), "agent's function_calling_llm is not correctly resolved to local_llm instance"

    # reporting_analyst agent has function_calling_llm as string "online_llm" (not registered llm)
    reporting_agent = crew.reporting_analyst()
    # After fix, function_calling_llm should be the string "online_llm" because no llm registered with that name
    assert (
        reporting_agent["function_calling_llm"] == "online_llm"
    ), "agent's function_calling_llm fallback to string failed"[0m
