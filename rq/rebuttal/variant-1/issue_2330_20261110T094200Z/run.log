[32mimport pytest

from crewai.agent import Agent
from crewai.llm import LLM
from crewai.project import CrewBase, agent, crew, llm, task
from crewai.crew import Crew


@CrewBase
class TestCrewWithFunctionCallingLLM:
    agents_config = {
        "researcher": {
            "role": "Researcher",
            "goal": "Research Goal",
            "backstory": "Research Backstory",
            "function_calling_llm": "local_llm",
        },
        "reporting_analyst": {
            "role": "Reporting Analyst",
            "goal": "Reporting Goal",
            "backstory": "Reporting Backstory",
            "function_calling_llm": "online_llm",
        },
    }
    tasks_config = {
        "research_task": {
            "description": "Research Task Description",
            "expected_output": "Research Task Output",
            "agent": "researcher",
        },
        "reporting_task": {
            "description": "Reporting Task Description",
            "expected_output": "Reporting Task Output",
            "agent": "reporting_analyst",
        },
    }

    @llm
    def local_llm(self):
        return LLM(
            model="local_model",
            api_key="dummy",
            base_url="http://localhost:8000/v1",
        )

    @llm
    def online_llm(self):
        return LLM(
            model="online_llm",
            api_key="dummy",
            base_url="http://online.api/v1",
        )

    @agent
    def researcher(self):
        return Agent(config=self.agents_config["researcher"])

    @agent
    def reporting_analyst(self):
        return Agent(config=self.agents_config["reporting_analyst"])

    @task
    def research_task(self):
        return self.tasks_config["research_task"]

    @task
    def reporting_task(self):
        return self.tasks_config["reporting_task"]

    @crew
    def crew(self):
        return Crew(agents=self.agents, tasks=self.tasks, verbose=False)


def test_agent_function_calling_llm():
    crew = TestCrewWithFunctionCallingLLM()
    researcher_agent = crew.researcher()
    reporting_agent = crew.reporting_analyst()

    # The researcher agent's function_calling_llm should be the local_llm instance
    local_llm_instance = crew.local_llm()
    assert (
        researcher_agent.function_calling_llm is not None
    ), "researcher agent function_calling_llm should not be None"
    assert (
        researcher_agent.function_calling_llm.model == local_llm_instance.model
    ), "researcher agent function_calling_llm should be the local_llm instance"

    # The reporting agent's function_calling_llm should be the string "online_llm" because no llm named online_llm is registered as a function
    # But since we defined online_llm as a llm method, it should be an instance of LLM
    online_llm_instance = crew.online_llm()
    assert (
        reporting_agent.function_calling_llm is not None
    ), "reporting agent function_calling_llm should not be None"
    assert (
        reporting_agent.function_calling_llm.model == online_llm_instance.model
    ), "reporting agent function_calling_llm should be the online_llm instance"


def test_crew_kickoff_runs_without_keyerror():
    crew = TestCrewWithFunctionCallingLLM()
    inputs = {"topic": "LLMs"}

    # kickoff should run without raising KeyError related to function_calling_llm
    result = crew.crew().kickoff(inputs=inputs)

    # We do not care about the actual output here, only that no exception is raised and result is not None
    assert result is not None, "Crew kickoff returned None unexpectedly"


@pytest.mark.vcr(filter_headers=["authorization"])
def test_agent_function_calling_llm_vcr():
    crew = TestCrewWithFunctionCallingLLM()
    researcher_agent = crew.researcher()
    assert researcher_agent.function_calling_llm is not None
    assert isinstance(researcher_agent.function_calling_llm, LLM)


