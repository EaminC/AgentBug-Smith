[32mfrom crewai.llm import LLM
from crewai.project import CrewBase, agent, llm


@CrewBase
class TestCrewFunctionCallingLLM:
    agents_config = {
        "researcher": {
            "function_calling_llm": "local_llm",
        },
        "reporting_analyst": {
            "function_calling_llm": "online_llm",
        },
    }

    @llm
    def local_llm(self):
        return LLM(
            model="openai/model_name",
            api_key="None",
            base_url="http://xxx.xxx.xxx.xxx:8000/v1",
        )

    @llm
    def online_llm(self):
        return LLM(
            model="online_llm",
            api_key="None",
            base_url="http://online.llm/v1",
        )

    @agent
    def researcher(self):
        # The Agent constructor returns an object with attributes including function_calling_llm
        # We simulate minimal Agent with function_calling_llm attribute set from config mapping
        # The CrewBase decorator should map function_calling_llm string to llm instance
        return self.agents_config["researcher"]

    @agent
    def reporting_analyst(self):
        return self.agents_config["reporting_analyst"]


def test_agent_function_calling_llm_mapping():
    crew = TestCrewFunctionCallingLLM()

    researcher_agent = crew.researcher()
    reporting_agent = crew.reporting_analyst()

    # After fix, function_calling_llm should be replaced by the llm instance, not a string
    # The agents_config dict is mutated in place by CrewBase mapping, so researcher_agent is a dict with function_calling_llm replaced
    # So researcher_agent["function_calling_llm"] should be the instance returned by crew.local_llm()
    local_llm_instance = crew.local_llm()
    online_llm_instance = crew.online_llm()

    assert (
        researcher_agent["function_calling_llm"] is local_llm_instance
    ), "The researcher agent's function_calling_llm should be the local_llm instance"

    # reporting_analyst's function_calling_llm is "online_llm" string originally, after fix it should be the online_llm instance
    assert (
        reporting_agent["function_calling_llm"] is online_llm_instance
    ), "The reporting_analyst agent's function_calling_llm should be the online_llm instance"[0m
