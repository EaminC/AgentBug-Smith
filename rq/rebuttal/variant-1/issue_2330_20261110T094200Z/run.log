[32mfrom crewai.agent import Agent
from crewai.llm import LLM
from crewai.project import CrewBase, agent, llm, task


@CrewBase
class InternalCrew:
    agents_config = "config/agents.yaml"
    tasks_config = "config/tasks.yaml"

    @llm
    def local_llm(self):
        return LLM(
            model='openai/model_name',
            api_key="None",
            base_url="http://xxx.xxx.xxx.xxx:8000/v1"
        )

    @agent
    def researcher(self):
        return Agent(config=self.agents_config["researcher"])

    @agent
    def reporting_analyst(self):
        return Agent(config=self.agents_config["reporting_analyst"])

    @task
    def research_task(self):
        return task(config=self.tasks_config["research_task"])

    @task
    def reporting_task(self):
        return task(config=self.tasks_config["reporting_task"])


def test_agent_function_calling_llm():
    crew = InternalCrew()
    llm_instance = crew.local_llm()
    researcher_agent = crew.researcher()
    reporting_agent = crew.reporting_analyst()

    # The researcher agent's function_calling_llm should be the local_llm instance
    assert researcher_agent.function_calling_llm is llm_instance, (
        "researcher agent's function_calling_llm should be the local_llm instance"
    )

    # The reporting_analyst agent's function_calling_llm should be a string "online_llm"
    # because "online_llm" is not registered as an llm function, so fallback to string
    assert isinstance(reporting_agent.function_calling_llm, str), (
        "reporting_analyst agent's function_calling_llm should fallback to string"
    )
    assert reporting_agent.function_calling_llm == "online_llm", (
        "reporting_analyst agent's function_calling_llm should equal 'online_llm'"
    )[0m
