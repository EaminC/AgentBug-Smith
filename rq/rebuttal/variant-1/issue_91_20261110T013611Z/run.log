def test_text_to_image_agent_receives_dialog_agent_message():
    # Initialize agents with dummy model configs (no real API calls)
    agent_to_chat = agentscope.init(model_configs=[
        {
            "config_name": "qwen-max",
            "model_type": "dashscope_chat",
            "model_name": "qwen-max",
            "api_key": "dummy_api_key"
        }
    ])
    agent_to_image = agentscope.init(model_configs=[
        {
            "config_name": "wanx-v1",
            "model_type": "dashscope_image_synthesis",
            "model_name": "wanx-v1",
            "api_key": "dummy_api_key"
        }
    ])

    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt="You are tasked with narrowing down the user's description of the need to 100 words or less and relaying it to the painter for him to draw. Note that the language you generate after listening must be spoken to the painter!",
        model_config_name="qwen-max"
    )
    agent_2 = TextToImageAgent(
        name="painter",
        sys_prompt="You are a painter, and your task is to take an assistant's description of the image and generate it",
        model_config_name="wanx-v1"
    )
    useragent = UserAgent()

    # Compose initial user message
    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    with msghub(participants=[agent_1, agent_2]) as hub:
        # DialogAgent receives user message and replies
        res_1 = agent_1(x)
        # TextToImageAgent should receive the message relayed by DialogAgent automatically via msghub
        res_2 = agent_2()

    # The TextToImageAgent's reply message should contain a URL (image_urls) and content
    # The bug was that agent_2() got None input and failed
    # After fix, agent_2() should produce a valid Msg with url attribute set (non-empty)
    assert res_2 is not None, "TextToImageAgent reply returned None"
    assert hasattr(res_2, "url"), "TextToImageAgent reply missing url attribute"
    assert res_2.url, "TextToImageAgent reply url attribute is empty"
    assert isinstance(res_2.content, str) and len(res_2.content) > 0, "TextToImageAgent reply content is empty"

    # Also verify that the content passed to TextToImageAgent is the output from DialogAgent
    # The content should be a string and not the original user message
    assert res_1.content != x.content, "DialogAgent did not modify the content"
    assert res_1.content in agent_2.memory.get_memory()[-1].content or res_1.content in res_2.content, \
        "TextToImageAgent did not receive DialogAgent's content"

    # The memory of TextToImageAgent should contain the last message from DialogAgent
    mem = agent_2.memory.get_memory()
    assert any(isinstance(m, Msg) and m.content == res_2.content for m in mem), "TextToImageAgent memory missing last reply"

    # The test will fail on buggy code because agent_2() call without argument returns None and causes error
    # After fix, agent_2() uses memory fallback and returns valid message


if __name__ == "__main__":
    pytest.main([__file__])[0m
