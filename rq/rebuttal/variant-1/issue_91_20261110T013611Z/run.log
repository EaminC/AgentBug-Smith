@pytest.fixture(autouse=True)
def patch_agentscope_init(monkeypatch):
    # Patch agentscope.init to return dummy model wrappers to avoid real API calls
    def dummy_init(model_configs):
        class DummyModelWrapper:
            def __init__(self, model_name):
                self.model_name = model_name

            def __call__(self, content):
                return DummyModel()(content)

        # Return dummy model wrapper keyed by model_config_name
        return DummyModelWrapper(model_configs[0]["model_name"])

    monkeypatch.setattr(agentscope, "init", dummy_init)


def test_text_to_image_agent_receives_dialog_agent_message():
    # Initialize dummy agents with patched init
    agent_to_chat = agentscope.init(model_configs=[
        {
            "config_name": "qwen-max",
            "model_type": "dashscope_chat",
            "model_name": "qwen-max",
            "api_key": "dummy_api_key"
        }
    ])
    agent_to_image = agentscope.init(model_configs=[
        {
            "config_name": "wanx-v1",
            "model_type": "dashscope_image_synthesis",
            "model_name": "wanx-v1",
            "api_key": "dummy_api_key"
        }
    ])

    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt="You are tasked with narrowing down the user's description of the need to 100 words or less and relaying it to the painter for him to draw. Note that the language you generate after listening must be spoken to the painter!",
        model_config_name="qwen-max"
    )
    # According to the fix patch, TextToImageAgent no longer requires sys_prompt argument
    agent_2 = TextToImageAgent(
        name="painter",
        model_config_name="wanx-v1"
    )
    useragent = UserAgent()

    # Compose initial message from user
    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    # Use msghub to simulate group chat with both agents
    with msghub(participants=[agent_1, agent_2]) as hub:
        # DialogAgent receives user message and replies
        agent_1(x)
        # TextToImageAgent should receive the message relayed by DialogAgent from memory automatically
        msg = agent_2()
        # UserAgent can also be called but not required for this test
        useragent()

    # Assert that the TextToImageAgent generated a message with image URLs
    assert msg is not None, "TextToImageAgent did not return a message"
    assert hasattr(msg, "url"), "Returned message has no 'url' attribute"
    assert isinstance(msg.url, (list, tuple)), "Returned message url attribute is not a list or tuple"
    assert len(msg.url) > 0, "Returned message url list is empty"
    assert msg.url[0].startswith("http"), "Returned image url does not look valid"

    # Assert that the content of the message is the expected string
    assert "generated image" in msg.content.lower(), "Returned message content does not indicate image generation"[0m
