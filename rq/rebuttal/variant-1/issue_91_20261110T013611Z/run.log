[32mimport pytest
import agentscope
from agentscope.agents import TextToImageAgent, DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.msghub import msghub

def test_text_to_image_agent_receives_dialog_agent_message():
    # Setup dummy model configs with fake API keys to avoid real API calls
    chat_model_config = {
        "config_name": "qwen-max",
        "model_type": "dashscope_chat",
        "model_name": "qwen-max",
        "api_key": "dummy_api_key"
    }
    image_model_config = {
        "config_name": "wanx-v1",
        "model_type": "dashscope_image_synthesis",
        "model_name": "wanx-v1",
        "api_key": "dummy_api_key"
    }

    # Initialize agentscope with both models
    agentscope.init(model_configs=[chat_model_config, image_model_config])

    # Create DialogAgent with required sys_prompt and model_config_name
    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt=(
            "You are tasked with narrowing down the user's description of the need to 100 words or less "
            "and relaying it to the painter for him to draw. Note that the language you generate after "
            "listening must be spoken to the painter!"
        ),
        model_config_name="qwen-max"
    )

    # Create TextToImageAgent with only required args (sys_prompt removed after fix)
    agent_2 = TextToImageAgent(
        name="painter",
        model_config_name="wanx-v1"
    )

    useragent = UserAgent()

    # Compose initial message from user
    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    # Use msghub to create a chat hub with both agents
    with msghub(participants=[agent_1, agent_2]) as hub:
        # Send initial message to DialogAgent
        agent_1(x)
        # Then call TextToImageAgent with no explicit message to test if it picks last memory message internally
        msg = agent_2()
        # The TextToImageAgent should produce a message with content and url (image URLs)
        assert msg is not None
        assert hasattr(msg, "content")
        assert hasattr(msg, "url")
        assert msg.content != ""
        assert isinstance(msg.url, (list, tuple))
        assert len(msg.url) > 0

        # Also test that memory of TextToImageAgent contains the last message
        mem = agent_2.memory.get_memory()
        assert len(mem) > 0
        # The last memory message content should match the generated message content
        assert mem[-1].content == msg.content

        # Optionally test that UserAgent can be called without error
        useragent()

# This test should fail on buggy code because agent_2() call without argument returns None or errors,
# and pass on fixed code where agent_2.reply() fetches last memory message if no argument provided.[0m
