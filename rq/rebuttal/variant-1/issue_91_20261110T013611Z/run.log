    # Create initial user message
    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    # Use msghub with both agents as participants
    with msghub(participants=[agent_1, agent_2]) as hub:
        # Send user message to DialogAgent
        agent_1(x)
        # Then call TextToImageAgent without explicit message argument
        # The fix should allow agent_2 to retrieve last message from memory automatically
