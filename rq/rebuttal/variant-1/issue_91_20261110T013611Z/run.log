import agentscope
from agentscope.agents import TextToImageAgent, DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.msghub import msghub


def test_text_to_image_agent_receives_dialog_agent_message():
    # Initialize agents with dummy model configs (no real API calls)
    agent_to_chat = agentscope.init(model_configs=[
        {
            "config_name": "qwen-max",
            "model_type": "dashscope_chat",
            "model_name": "qwen-max",
            "api_key": "dummy_api_key"
        }
    ])
    agent_to_image = agentscope.init(model_configs=[
        {
            "config_name": "wanx-v1",
            "model_type": "dashscope_image_synthesis",
            "model_name": "wanx-v1",
            "api_key": "dummy_api_key"
        }
    ])

    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt="You are tasked with narrowing down the user's description of the need to 100 words or less and relaying it to the painter for him to draw. Note that the language you generate after listening must be spoken to the painter!",
        model_config_name="qwen-max"
    )
    # According to the fix patch, TextToImageAgent no longer requires sys_prompt argument
    agent_2 = TextToImageAgent(
        name="painter",
        model_config_name="wanx-v1"
    )
    useragent = UserAgent()

    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    with msghub(participants=[agent_1, agent_2]) as hub:
        # Send initial message to DialogAgent
        agent_1(x)
        # Then call TextToImageAgent without argument (should get last memory message)
        msg = agent_2()
        # The returned message should be a Msg instance with content and url attributes
        assert msg is not None
        assert hasattr(msg, "content")
        assert hasattr(msg, "url")
        # The content should mention "generated image"
        assert "generated image" in msg.content.lower()
        # The url field should be a non-empty list or similar
        assert msg.url is not None
        assert isinstance(msg.url, (list, tuple))
        assert len(msg.url) > 0

        # Also test that TextToImageAgent memory has the last message from DialogAgent
        memory_messages = agent_2.memory.get_memory()
        assert any(isinstance(m, Msg) for m in memory_messages)
        # The last message in memory should be the image generation message
        assert memory_messages[-1].content == msg.content

        # UserAgent call to ensure no exceptions
        useragent()

# The test expects that on buggy code, agent_2() call without argument returns None or errors,
# and on fixed code, it returns the last message from memory and proceeds correctly.[0m
