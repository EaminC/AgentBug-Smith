    agent_to_image = agentscope.init(model_configs=[
        {
            "config_name": "wanx-v1",
            "model_type": "dashscope_image_synthesis",
            "model_name": "wanx-v1",
            "api_key": "dummy_api_key"
        }
    ])

    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt="You are tasked with narrowing down the user's description of the need to 100 words or less and relaying it to the painter for him to draw. Note that the language you generate after listening must be spoken to the painter!",
        model_config_name="qwen-max"
    )
    # Do NOT pass sys_prompt to TextToImageAgent as per fix patch
    agent_2 = TextToImageAgent(
        name="painter",
        model_config_name="wanx-v1"
    )
    useragent = UserAgent()

    # Compose initial user message
    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    # Use msghub with both agents to simulate group chat
    with msghub(participants=[agent_1, agent_2]) as hub:
        # Send initial message to DialogAgent
        agent_1(x)
        # Then call TextToImageAgent without explicit input, it should get last message from memory
        msg_from_image_agent = agent_2()

    # Assert that TextToImageAgent produced a message with content and url (image URLs)
    assert msg_from_image_agent is not None
    assert hasattr(msg_from_image_agent, "content")
    assert hasattr(msg_from_image_agent, "url")
    assert msg_from_image_agent.content != ""
    assert isinstance(msg_from_image_agent.url, (list, tuple))
    assert len(msg_from_image_agent.url) > 0

    # Assert that the memory of TextToImageAgent contains at least one message
    mem = agent_2.memory.get_memory()
    assert len(mem) >= 1
    # The last memory message should be the image generation message
    assert mem[-1].content == msg_from_image_agent.content
    assert mem[-1].url == msg_from_image_agent.url[0m
