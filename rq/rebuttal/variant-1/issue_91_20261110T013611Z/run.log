def test_text_to_image_agent_receives_dialog_agent_message():
    # Initialize agents with dummy model configs (no real API calls)
    agent_to_chat = agentscope.init(model_configs=[
        {
            "config_name": "qwen-max",
            "model_type": "dashscope_chat",
            "model_name": "qwen-max",
            "api_key": "dummy_api_key"
        }
    ])
    agent_to_image = agentscope.init(model_configs=[
        {
            "config_name": "wanx-v1",
            "model_type": "dashscope_image_synthesis",
            "model_name": "wanx-v1",
            "api_key": "dummy_api_key"
        }
    ])

    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt="You are tasked with narrowing down the user's description of the need to 100 words or less and relaying it to the painter for him to draw. Note that the language you generate after listening must be spoken to the painter!",
        model_config_name="qwen-max"
    )
    # According to the fix patch, TextToImageAgent no longer requires sys_prompt argument
    agent_2 = TextToImageAgent(
        name="painter",
        model_config_name="wanx-v1"
    )
    useragent = UserAgent()

    # Compose initial user message
    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    # Use msghub with both agents to simulate group chat
    with msghub(participants=[agent_1, agent_2]) as hub:
        # DialogAgent receives user message and processes it
        agent_1(x)
        # TextToImageAgent should receive the last message from memory automatically (fix)
        msg = agent_2()
        # UserAgent can also be called to simulate user participation (no-op here)
        useragent()

    # Assert that the TextToImageAgent produced a message with expected content type
    assert msg is not None, "TextToImageAgent did not produce any message"
    assert hasattr(msg, "content"), "Output message missing 'content' attribute"
    assert "image" in msg.content.lower() or hasattr(msg, "url"), "Output message does not indicate image generation"
    # Assert that the TextToImageAgent's memory contains at least one message
    mem = agent_2.memory.get_memory() if agent_2.memory else []
    assert len(mem) > 0, "TextToImageAgent memory is empty after reply"
    # Assert that the last memory message is the one generated by TextToImageAgent
    assert mem[-1].name == agent_2.name, "Last memory message is not from TextToImageAgent"[0m
