def test_text_to_image_agent_receives_dialog_agent_message():
    # Initialize agents with dummy model configs
    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt="You are tasked with narrowing down the user's description of the need to 100 words or less and relaying it to the painter for him to draw. Note that the language you generate after listening must be spoken to the painter!",
        model_config_name="qwen-max"
    )
    agent_2 = TextToImageAgent(
        name="painter",
        sys_prompt="You are a painter, and your task is to take an assistant's description of the image and generate it",
        model_config_name="wanx-v1"
    )
    useragent = UserAgent()

    # Create initial user message
    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    # Use msghub with both agents to simulate group chat
    with msghub(participants=[agent_1, agent_2]) as hub:
        # DialogAgent receives user message
        agent_1(x)
        # TextToImageAgent should receive the last message from memory automatically (fix applied)
        msg = agent_2()

    # The returned message should be a Msg instance with the painter's name and image url
    assert msg is not None
    assert msg.name == "painter"
    assert hasattr(msg, "url")
    assert isinstance(msg.url, list)
    assert len(msg.url) > 0
    assert msg.url[0].startswith("http")
    # The content should mention image generation
    assert "image" in msg.content.lower() or "generated" in msg.content.lower()[0m
