        assert msg is not None
        assert hasattr(msg, "content")
        assert "image" in msg.content.lower() or "generated image" in msg.content.lower()

        # The memory of agent_2 should contain the original message and the generated message
        mem = agent_2.memory.get_memory()
        assert any(isinstance(m, Msg) and m.content == x.content for m in mem), "Original message should be in memory"
