def test_text_to_image_agent_receives_dialog_agent_message():
    # Initialize model configs with dummy API keys to avoid real API calls
    # This is to ensure the test runs without external dependencies
    chat_model_config = {
        "config_name": "qwen-max",
        "model_type": "dashscope_chat",
        "model_name": "qwen-max",
        "api_key": "dummy_api_key"
    }
    image_model_config = {
        "config_name": "wanx-v1",
        "model_type": "dashscope_image_synthesis",
        "model_name": "wanx-v1",
        "api_key": "dummy_api_key"
    }

    # Initialize agentscope with the dummy configs
    agentscope.init(model_configs=[chat_model_config, image_model_config])

    # Create DialogAgent with required sys_prompt and model_config_name
    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt="You are tasked with narrowing down the user's description of the need to 100 words or less and relaying it to the painter for him to draw. Note that the language you generate after listening must be spoken to the painter!",
        model_config_name="qwen-max"
    )

    # Create TextToImageAgent without sys_prompt argument (as per fixed code)
    agent_2 = TextToImageAgent(
        name="painter",
        model_config_name="wanx-v1"
    )

    # Create UserAgent
    useragent = UserAgent()

    # Create initial message from user
    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    # Use msghub to simulate group chat
    with msghub(participants=[agent_1, agent_2]) as hub:
        # DialogAgent receives user message and replies
        agent_1(x)
        # TextToImageAgent replies without explicit input,
        # should retrieve last message from memory internally after fix
        result_msg = agent_2()
        # UserAgent call to simulate user interaction (optional)
        useragent()

    # Assert that the TextToImageAgent produced a message with expected content
    assert result_msg is not None
    assert hasattr(result_msg, "content")
    assert "image" in result_msg.content.lower() or "generated image" in result_msg.content.lower()

    # Assert that the memory of TextToImageAgent contains the message from DialogAgent
    memory_messages = agent_2.memory.get_memory()
    assert any(isinstance(m, Msg) and m.content for m in memory_messages)

    # Assert that the last memory message content is not None or empty
    assert memory_messages[-1].content != "" and memory_messages[-1].content is not None[0m
