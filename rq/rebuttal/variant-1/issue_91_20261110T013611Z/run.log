[32mimport pytest
import agentscope
from agentscope.agents import TextToImageAgent, DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.msghub import msghub

def test_text_to_image_agent_receives_dialog_agent_message():
    # Setup dummy model configs with fake API keys to avoid real API calls
    chat_model_config = {
        "config_name": "qwen-max",
        "model_type": "dashscope_chat",
        "model_name": "qwen-max",
        "api_key": "dummy_api_key"
    }
    image_model_config = {
        "config_name": "wanx-v1",
        "model_type": "dashscope_image_synthesis",
        "model_name": "wanx-v1",
        "api_key": "dummy_api_key"
    }

    # Initialize agentscope with both models
    agentscope.init(model_configs=[chat_model_config, image_model_config])

    # Create DialogAgent with required sys_prompt and model_config_name
    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt=(
            "You are tasked with narrowing down the user's description of the need to 100 words or less "
            "and relaying it to the painter for him to draw. Note that the language you generate after "
            "listening must be spoken to the painter!"
        ),
        model_config_name="qwen-max"
    )

    # Create TextToImageAgent with required args (sys_prompt removed after fix)
    agent_2 = TextToImageAgent(
        name="painter",
        model_config_name="wanx-v1"
    )

    useragent = UserAgent()
    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    with msghub(participants=[agent_1, agent_2]) as hub:
        # Send initial message to DialogAgent
        agent_1(x)
        # Then call TextToImageAgent without args, expecting it to fetch last message from memory
        msg = agent_2()
        # The returned msg should be a Msg instance with content indicating image generation
        assert msg is not None
        assert hasattr(msg, "content")
        assert "image" in msg.content.lower() or "generated" in msg.content.lower()
        # The memory of agent_2 should contain the message from agent_1 and the generated image message
        memory_msgs = agent_2.memory.get_memory()
        assert any(isinstance(m, Msg) and m.content == x.content for m in memory_msgs) or len(memory_msgs) > 0

    # Also test that calling agent_2 with explicit last memory message works equivalently
    with msghub(participants=[agent_1, agent_2]) as hub:
        agent_1(x)
        last_msg = agent_2.memory.get_memory()[-1]
        msg2 = agent_2(last_msg)
        assert msg2 is not None
        assert hasattr(msg2, "content")
        assert "image" in msg2.content.lower() or "generated" in msg2.content.lower()
        assert msg2 != x  # The reply message should be different from the input message

# This test will fail on the buggy codebase because TextToImageAgent.reply() does not handle None input properly,
# causing it to receive None and raise an error.
# After the fix, TextToImageAgent.reply() fetches last memory message if input is None, so the test passes.[0m
