[32mimport pytest
import agentscope
from agentscope.agents import TextToImageAgent, DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.msghub import msghub


def test_text_to_image_agent_receives_dialog_agent_message():
    # Initialize agents with dummy model configs to avoid real API calls
    agent_to_chat = agentscope.init(model_configs=[
        {
            "config_name": "qwen-max",
            "model_type": "dashscope_chat",
            "model_name": "qwen-max",
            "api_key": "dummy_api_key"
        }
    ])
    agent_to_image = agentscope.init(model_configs=[
        {
            "config_name": "wanx-v1",
            "model_type": "dashscope_image_synthesis",
            "model_name": "wanx-v1",
            "api_key": "dummy_api_key"
        }
    ])

    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt="You are tasked with narrowing down the user's description of the need to 100 words or less and relaying it to the painter for him to draw. Note that the language you generate after listening must be spoken to the painter!",
        model_config_name="qwen-max"
    )
    # According to the fix patch, TextToImageAgent no longer requires sys_prompt argument
    agent_2 = TextToImageAgent(
        name="painter",
        model_config_name="wanx-v1"
    )
    useragent = UserAgent()

    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    with msghub(participants=[agent_1, agent_2]) as hub:
        # Send message to DialogAgent
        agent_1(x)
        # TextToImageAgent should be able to receive the message from DialogAgent via memory automatically
        msg = agent_2()
        # UserAgent call to simulate user interaction, not essential for this test
        useragent()

    # Assert that the TextToImageAgent generated a message and it contains the expected content
    assert msg is not None, "TextToImageAgent did not return a message"
    assert hasattr(msg, "content"), "Returned message has no content attribute"
    assert "image" in msg.content.lower() or "generated image" in msg.content.lower(), "Returned message content does not indicate image generation"

    # Also assert that the memory of TextToImageAgent contains the last message from DialogAgent
    mem = agent_2.memory.get_memory()
    assert any(x.content in m.content for m in mem if hasattr(m, "content")), "TextToImageAgent memory does not contain DialogAgent's message content"[0m
