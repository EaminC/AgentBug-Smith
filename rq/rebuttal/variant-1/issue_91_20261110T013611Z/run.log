[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="openrouter2/openai/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="openrouter2/openai/gpt-4.1-mini"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set working directory to the repo root
WORKDIR /app

# Install system dependencies required for building some python packages (like lxml for example)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       gcc \
       g++ \
       libxml2-dev \
       libxslt1-dev \
       python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy full repository content
COPY . .

# Upgrade pip and setuptools
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies if requirements.txt exists, then install the repo editable
RUN if [ -f "requirements.txt" ]; then pip install -r requirements.txt; fi
RUN pip install -e .

# Install pytest and mandatory testing packages to ensure test framework availability
RUN pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-timeout pytest-block-network "setuptools<=81.0.0" litellm

# Set PYTHONPATH to support src/ layout
ENV PYTHONPATH=/app:/app/src

# Final command to keep container open with shell
CMD ["/bin/bash"]

