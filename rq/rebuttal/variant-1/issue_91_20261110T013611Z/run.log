[32mimport pytest
import agentscope
from agentscope.agents import TextToImageAgent, DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.msghub import msghub

def test_text_to_image_agent_receives_dialog_agent_message():
    # Setup dummy model configs with fake API keys to avoid real API calls
    chat_model_config = {
        "config_name": "qwen-max",
        "model_type": "dashscope_chat",
        "model_name": "qwen-max",
        "api_key": "dummy_api_key"
    }
    image_model_config = {
        "config_name": "wanx-v1",
        "model_type": "dashscope_image_synthesis",
        "model_name": "wanx-v1",
        "api_key": "dummy_api_key"
    }

    # Initialize agentscope with both models
    agentscope.init(model_configs=[chat_model_config, image_model_config])

    # Create DialogAgent with required sys_prompt and model_config_name
    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt=(
            "You are tasked with narrowing down the user's description of the need to 100 words or less "
            "and relaying it to the painter for him to draw. Note that the language you generate after "
            "listening must be spoken to the painter!"
        ),
        model_config_name="qwen-max"
    )

    # Create TextToImageAgent with required args (sys_prompt removed after fix)
    agent_2 = TextToImageAgent(
        name="painter",
        model_config_name="wanx-v1"
    )

    useragent = UserAgent()

    # Compose initial user message
    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    # Use msghub for multi-agent chat
    with msghub(participants=[agent_1, agent_2]) as hub:
        # DialogAgent receives user message and replies
        agent_1(x)

        # TextToImageAgent should receive the last message from memory automatically (fix)
        msg_from_image_agent = agent_2()

        # UserAgent called to simulate user interaction (optional)
        useragent()

    # Validate that TextToImageAgent produced a message with expected content
    assert msg_from_image_agent is not None
    assert hasattr(msg_from_image_agent, "content")
    assert "generated image" in msg_from_image_agent.content.lower()

    # Validate that TextToImageAgent memory contains the last message with content
    mem = agent_2.memory.get_memory() if agent_2.memory else []
    assert any(hasattr(m, "content") and m.content for m in mem)

    # Validate that the content passed to TextToImageAgent is not None
    # This ensures the fix for the bug where x was None is effective
    last_msg = agent_2.memory.get_memory()[-1] if mem else None
    assert last_msg is not None
    assert hasattr(last_msg, "content")
    assert last_msg.content is not None and last_msg.content != ""

# This test will fail on buggy code (TextToImageAgent.reply receives None)
# and pass on fixed code (TextToImageAgent.reply fetches last message from memory).[0m
