[32mimport pytest
from agentscope.agents import TextToImageAgent, DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.msghub import msghub
import agentscope


def test_text_to_image_agent_receives_dialog_agent_message():
    # Setup dummy model configs with fake API keys to avoid real API calls
    chat_model_config = {
        "config_name": "qwen-max",
        "model_type": "dashscope_chat",
        "model_name": "qwen-max",
        "api_key": "dummy_api_key"
    }
    image_model_config = {
        "config_name": "wanx-v1",
        "model_type": "dashscope_image_synthesis",
        "model_name": "wanx-v1",
        "api_key": "dummy_api_key"
    }

    # Initialize agentscope with both models
    agentscope.init(model_configs=[chat_model_config, image_model_config])

    # Create DialogAgent with required sys_prompt and model_config_name
    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt=(
            "You are tasked with narrowing down the user's description of the need to 100 words or less "
            "and relaying it to the painter for him to draw. Note that the language you generate after "
            "listening must be spoken to the painter!"
        ),
        model_config_name="qwen-max"
    )

    # Create TextToImageAgent with required args (sys_prompt removed after fix)
    agent_2 = TextToImageAgent(
        name="painter",
        model_config_name="wanx-v1"
    )

    useragent = UserAgent()

    # Create initial message from user
    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    # Use msghub for group chat with both agents
    with msghub(participants=[agent_1, agent_2]) as hub:
        # DialogAgent receives user message and replies
        agent_1(x)
        # TextToImageAgent should receive the last message from memory automatically (x=None)
        msg = agent_2()
        # UserAgent can be called (though no message here)
        useragent()

    # Check that the TextToImageAgent's reply message contains expected content
    assert msg is not None
    assert hasattr(msg, "content")
    assert "image" in msg.content.lower() or "generated image" in msg.content.lower()
    # Check that the TextToImageAgent memory contains the last message from DialogAgent
    memory_msgs = agent_2.memory.get_memory()
    assert any("assistants" in m.name or "painter" in m.name for m in memory_msgs)
    # Check that the content from DialogAgent is present in the memory for TextToImageAgent
    assert any("fancy upscale restaurant" in (m.content or "") for m in memory_msgs)[0m
