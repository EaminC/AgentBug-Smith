def test_text_to_image_agent_receives_dialog_agent_message():
    # Initialize agents with dummy model configs (model loading patched)
    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt="You are tasked with narrowing down the user's description of the need to 100 words or less and relaying it to the painter for him to draw. Note that the language you generate after listening must be spoken to the painter!",
        model_config_name="qwen-max"
    )
    agent_2 = TextToImageAgent(
        name="painter",
        model_config_name="wanx-v1"
    )
    useragent = UserAgent()

    # Compose initial message from user
    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    # Use msghub to simulate group chat with both agents
    with msghub(participants=[agent_1, agent_2]) as hub:
        # DialogAgent receives initial user message and replies
        msg_from_dialog = agent_1(x)
        assert msg_from_dialog is not None
        assert hasattr(msg_from_dialog, "content")
        assert len(msg_from_dialog.content) > 0

        # TextToImageAgent should receive the dialog agent's message automatically (fix applied)
        msg_from_image = agent_2()
        # The message should be a Msg instance with image url
        assert msg_from_image is not None
        assert hasattr(msg_from_image, "url")
        assert isinstance(msg_from_image.url, list)
        assert len(msg_from_image.url) > 0

        # UserAgent can also be called (no error)
        useragent()

    # Additionally, verify that TextToImageAgent memory contains the dialog message
    memory_msgs = agent_2.memory.get_memory()
    assert any(isinstance(m, Msg) and m.content == msg_from_dialog.content for m in memory_msgs), \
        "TextToImageAgent memory should contain the dialog agent's message content"[0m
