import agentscope
from agentscope.agents import TextToImageAgent, DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.msghub import msghub


def test_text_to_image_agent_receives_dialog_agent_message():
    # Setup dummy model configs with fake API keys to avoid real API calls
    chat_model_config = {
        "config_name": "qwen-max",
        "model_type": "dashscope_chat",
        "model_name": "qwen-max",
        "api_key": "dummy_api_key"
    }
    image_model_config = {
        "config_name": "wanx-v1",
        "model_type": "dashscope_image_synthesis",
        "model_name": "wanx-v1",
        "api_key": "dummy_api_key"
    }

    # Initialize agentscope with both models
    agentscope.init(model_configs=[chat_model_config, image_model_config])

    # Create DialogAgent with required sys_prompt and model_config_name
    agent_1 = DialogAgent(
        name="assistants",
        sys_prompt=(
            "You are tasked with narrowing down the user's description of the need to 100 words or less "
            "and relaying it to the painter for him to draw. Note that the language you generate after "
            "listening must be spoken to the painter!"
        ),
        model_config_name="qwen-max"
    )

    # Create TextToImageAgent with required args (no sys_prompt argument as per fixed code)
    agent_2 = TextToImageAgent(
        name="painter",
        model_config_name="wanx-v1"
    )

    useragent = UserAgent()
    x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

    with msghub(participants=[agent_1, agent_2]) as hub:
        # Send initial message to DialogAgent
        agent_1(x)

        # Call TextToImageAgent without argument to test it fetches last memory message
        msg = agent_2()

        # The returned message should be a Msg instance with content indicating image generation
        assert msg is not None
        assert hasattr(msg, "content")
        assert "image" in msg.content.lower() or "generated image" in msg.content.lower()

        # The TextToImageAgent's memory should contain the original message and the generated image message
        mem = agent_2.memory.get_memory()
        assert any(isinstance(m, Msg) and m.content == x.content for m in mem)
        assert any(isinstance(m, Msg) and m.content == msg.content for m in mem)

        # The TextToImageAgent's reply method should not receive None as input internally
        # This is indirectly tested by the fact that msg is returned and contains expected content

    # Also test that calling agent_2 with explicit message from memory works equivalently
    msg2 = agent_2(agent_2.memory.get_memory()[0])
    assert msg2 is not None
    assert hasattr(msg2, "content")
    assert "image" in msg2.content.lower() or "generated image" in msg2.content.lower()[0m
