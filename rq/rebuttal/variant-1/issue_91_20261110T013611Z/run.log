        # Send message to DialogAgent
        agent_1(x)
        # Then invoke TextToImageAgent without explicit message, it should pick last from memory
        msg = agent_2()
        # The returned message should have content indicating image generation
        assert msg is not None
        assert hasattr(msg, "content")
        assert "image" in msg.content.lower() or "generated" in msg.content.lower()
        # The memory of agent_2 should contain the last message with content from agent_1
        mem = agent_2.memory.get_memory()
        assert len(mem) > 0
        # The last memory content should be a Msg instance with non-empty content
        assert hasattr(mem[-1], "content")
        assert mem[-1].content is not None
        # The content should be a string and not empty
        assert isinstance(mem[-1].content, str)
        assert len(mem[-1].content) > 0[0m
