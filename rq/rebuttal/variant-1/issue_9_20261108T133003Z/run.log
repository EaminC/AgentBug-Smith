[32mimport pytest
import openai
from ai import AI

class DummyModel:
    @staticmethod
    def retrieve(name):
        if name == "gpt-4":
            # Simulate that gpt-4 is not available (raise InvalidRequestError)
            raise openai.error.InvalidRequestError(message="Model not found", param=None, code=None)
        return {"id": name}

def test_ai_model_fallback(monkeypatch):
    # Patch openai.Model.retrieve to our dummy method that raises for gpt-4
    monkeypatch.setattr(openai.Model, "retrieve", DummyModel.retrieve)

    # Instantiate AI - it should fallback to gpt-3.5-turbo due to the simulated error
    ai_instance = AI()

    # The kwargs should contain model set to "gpt-3.5-turbo"
    assert ai_instance.kwargs.get("model") == "gpt-3.5-turbo"

    # Also test that start and next methods work normally with this fallback model
    system_prompt = "You are a helpful assistant."
    user_prompt = "Hello, how are you?"

    messages = ai_instance.start(system_prompt, user_prompt)
    assert isinstance(messages, list)
    assert messages[0]["role"] == "system"
    assert messages[1]["role"] == "user"

    # Call next with the messages, no prompt override
    new_messages = ai_instance.next(messages)
    # It should return a list with one more message appended
    assert len(new_messages) == len(messages) + 1
    assert new_messages[-1]["role"] == "assistant"
    assert isinstance(new_messages[-1]["content"], str)
    assert len(new_messages[-1]["content"]) > 0

@pytest.mark.parametrize("model_name,expected", [
    ("gpt-4", False),
    ("gpt-3.5-turbo", True),
])
def test_ai_model_retrieve_real(monkeypatch, model_name, expected):
    # This test checks that if gpt-4 is available, AI does not fallback
    # and if not, it falls back. We simulate both cases.

    def retrieve_mock(name):
        if name == "gpt-4":
            if model_name == "gpt-4":
                return {"id": "gpt-4"}
            else:
                raise openai.error.InvalidRequestError(message="Model not found", param=None, code=None)
        return {"id": name}

    monkeypatch.setattr(openai.Model, "retrieve", retrieve_mock)

    ai_instance = AI()
    if expected:
        # fallback to gpt-3.5-turbo expected
        assert ai_instance.kwargs.get("model") == "gpt-3.5-turbo"
    else:
        # no fallback, model key should not be forced to gpt-3.5-turbo
        assert ai_instance.kwargs.get("model") != "gpt-3.5-turbo"[0m
