[32mimport pytest
import openai
from ai import AI


class DummyInvalidRequestError(Exception):
    pass


class DummyModel:
    @staticmethod
    def retrieve(name):
        if name == "gpt-4":
            raise DummyInvalidRequestError("Model not available")
        return {"id": name}


def test_ai_model_fallback(monkeypatch):
    # Patch openai.Model.retrieve to our dummy method that raises for gpt-4
    monkeypatch.setattr(openai.Model, "retrieve", DummyModel.retrieve)

    # Patch openai.error.InvalidRequestError to our dummy exception class
    # openai.error may not exist, so patch openai.error via sys.modules trick
    import sys
    import types

    if not hasattr(openai, "error"):
        error_module = types.SimpleNamespace(InvalidRequestError=DummyInvalidRequestError)
        sys.modules["openai.error"] = error_module
        setattr(openai, "error", error_module)

    # Create AI instance, which should fallback to gpt-3.5-turbo due to dummy retrieve raising
    ai_instance = AI()

    # The model should be set to gpt-3.5-turbo in kwargs after fallback
    assert ai_instance.kwargs.get("model") == "gpt-3.5-turbo"


@pytest.mark.parametrize("model_name,expected", [
    ("gpt-4", False),
    ("gpt-3.5-turbo", True),
])
def test_ai_model_retrieve_real(model_name, expected):
    # This test checks that the dummy retrieve raises for gpt-4 and not for gpt-3.5-turbo
    # We use the dummy retrieve directly here

    def dummy_retrieve(name):
        if name == "gpt-4":
            raise DummyInvalidRequestError("Model not available")
        return {"id": name}

    if model_name == "gpt-4":
        with pytest.raises(DummyInvalidRequestError):
            dummy_retrieve(model_name)
    else:
        result = dummy_retrieve(model_name)
        assert result["id"] == model_name
        assert expected is True


def test_ai_start_and_next_basic():
    # Basic sanity test for AI.start and AI.next methods
    ai = AI(model="gpt-3.5-turbo")

    system_msg = "You are a helpful assistant."
    user_msg = "Hello, AI!"
    messages = ai.start(system_msg, user_msg)
    assert isinstance(messages, list)
    assert messages[0]["role"] == "system"
    assert messages[1]["role"] == "user"

    # Call next with messages and a prompt, should return messages with assistant reply appended
    new_messages = ai.next(messages, prompt="Say hi")
    assert isinstance(new_messages, list)
    assert new_messages[-1]["role"] == "assistant"
    assert isinstance(new_messages[-1]["content"], str)
    assert len(new_messages) == len(messages) + 1[0m
