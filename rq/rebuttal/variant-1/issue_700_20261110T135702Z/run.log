RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies excluding litellm version which is incompatible
RUN if [ -f "requirements.txt" ]; then \
    grep -v '^litellm==' requirements.txt > requirements.compat.txt || true; \
    pip install --no-cache-dir -r requirements.compat.txt; \
    fi && \
    pip install --no-cache-dir -e . && \
    pip install --no-cache-dir litellm==0.1.450 pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network "setuptools<=81.0.0"

# Set PYTHONPATH for importing modules
ENV PYTHONPATH=/app

# Verify installation
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Final command for container
CMD ["/bin/bash"]

