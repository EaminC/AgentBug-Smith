    pip install --no-cache-dir litellm && \
    pip install --no-cache-dir pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network "setuptools<=81.0.0"

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    FORGE_API_KEY="forge-key" \
    FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Set PYTHONPATH to support direct imports
ENV PYTHONPATH=/app

# Verify installation with import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

