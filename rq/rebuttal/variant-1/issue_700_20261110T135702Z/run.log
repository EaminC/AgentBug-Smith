COPY . .

# Upgrade pip and setup tools
RUN python -m pip install --upgrade pip setuptools wheel

# Install python dependencies excluding pinned litellm version (which causes install failure)
RUN if [ -f "requirements.txt" ]; then \
      grep -v '^litellm==' requirements.txt > requirements.compat.txt || true; \
      pip install --no-cache-dir -r requirements.compat.txt; \
    fi && \
    pip install --no-cache-dir -e . && \
    pip install --no-cache-dir litellm && \
    pip install --no-cache-dir pytest pytest-mock pytest-xdist pytest-timeout pytest-block-network "setuptools<=81.0.0"

# Set PYTHONPATH for direct module imports
ENV PYTHONPATH=/app

# Verify installation
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Start bash shell - required for test harness
CMD ["/bin/bash"]

