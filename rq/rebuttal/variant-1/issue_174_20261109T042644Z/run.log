        # We check that the base_url attribute exists and equals custom_base_url
        assert hasattr(m.client, "base_url"), "OpenAI client missing base_url attribute"
        assert m.client.base_url == custom_base_url

    finally:
        # Restore original get_config to avoid side effects
        model.get_config = original_get_config


