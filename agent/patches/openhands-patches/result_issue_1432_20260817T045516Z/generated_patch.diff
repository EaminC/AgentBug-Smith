diff --git a/src/strands/models/litellm.py b/src/strands/models/litellm.py
index ec6579c58..69dcc11f5 100644
--- a/src/strands/models/litellm.py
+++ b/src/strands/models/litellm.py
@@ -192,6 +192,23 @@ class LiteLLMModel(OpenAIModel):
             A LiteLLM compatible messages array.
         """
         formatted_messages = cls._format_system_messages(system_prompt, system_prompt_content=system_prompt_content)
+
+        # Add cachePoint block after last assistant message if cache_strategy is "auto"
+        if kwargs.get("cache_strategy") == "auto":
+            last_assistant_idx = None
+            for i in reversed(range(len(messages))):
+                if messages[i]["role"] == "assistant":
+                    last_assistant_idx = i
+                    break
+            if last_assistant_idx is not None:
+                # Deep copy the messages list to avoid side effects
+                import copy
+                messages = copy.deepcopy(messages)
+                if "content" not in messages[last_assistant_idx]:
+                    messages[last_assistant_idx]["content"] = []
+                if isinstance(messages[last_assistant_idx]["content"], list):
+                    messages[last_assistant_idx]["content"].append({"cachePoint": {"type": "default"}})
+
         formatted_messages.extend(cls._format_regular_messages(messages))
 
         return [message for message in formatted_messages if message["content"] or "tool_calls" in message]
