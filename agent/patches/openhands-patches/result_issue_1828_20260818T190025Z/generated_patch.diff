+def test_is_new_session_flag_on_new_and_existing_sessions(mock_repository):
+    # New session should have _is_new_session True
+    new_session_manager = RepositorySessionManager(session_id="new-session", session_repository=mock_repository)
+    assert new_session_manager._is_new_session is True
+
+    # Existing session should have _is_new_session False
+    existing_session = Session(session_id="existing-session", session_type=SessionType.AGENT)
+    mock_repository.create_session(existing_session)
+    existing_session_manager = RepositorySessionManager(session_id="existing-session", session_repository=mock_repository)
+    assert existing_session_manager._is_new_session is False
+
+
+def test_initialize_skips_read_agent_for_new_session(mock_repository):
+    # Create a new session manager (new session)
+    new_session_manager = RepositorySessionManager(session_id="new-session-init", session_repository=mock_repository)
+
+    # Mock agent
+    agent = Agent(agent_id="agent1", messages=[{"role": "user", "content": [{"text": "Hello"}]}])
+
+    # Spy on session_repository.read_agent method
+    mock_repository.read_agent = lambda session_id, agent_id: (_ for _ in ()).throw(Exception("Should not call read_agent for new session"))
+
+    # Should not raise exception because read_agent is not called
+    new_session_manager.initialize(agent)
+
+
+def test_initialize_bidi_agent_skips_read_agent_for_new_session(mock_repository):
+    new_session_manager = RepositorySessionManager(session_id="new-session-bidi", session_repository=mock_repository)
+
+    class DummyBidiAgent:
+        def __init__(self, agent_id):
+            self.agent_id = agent_id
+            self.messages = []
+
+    agent = DummyBidiAgent("bidi-agent1")
+
+    # Spy on session_repository.read_agent method
+    mock_repository.read_agent = lambda session_id, agent_id: (_ for _ in ()).throw(Exception("Should not call read_agent for new session"))
+
+    # Should not raise exception because read_agent is not called
+    new_session_manager.initialize_bidi_agent(agent)
+
+
+def test_initialize_multi_agent_skips_read_multi_agent_for_new_session(mock_repository):
+    new_session_manager = RepositorySessionManager(session_id="new-session-multi", session_repository=mock_repository)
+
+    class DummyMultiAgent:
+        def __init__(self):
+            self.id = "multi-agent1"
+            self.deserialize_state_called = False
+
+        def deserialize_state(self, state):
+            self.deserialize_state_called = True
+
+    multi_agent = DummyMultiAgent()
+
+    # Spy on session_repository.read_multi_agent method
+    mock_repository.read_multi_agent = lambda session_id, agent_id, **kwargs: (_ for _ in ()).throw(Exception("Should not call read_multi_agent for new session"))
+
+    # Should not raise exception because read_multi_agent is not called
+    new_session_manager.initialize_multi_agent(multi_agent)
+
+    # But multi-agent create must be called
+    assert multi_agent.deserialize_state_called is False
+
