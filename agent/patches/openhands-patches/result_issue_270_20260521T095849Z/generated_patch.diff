@@ -33,6 +33,90 @@ def cli():
     """
     pass
 
+@cli.group()
+def memory():
+    """
+    memory: Manage the embedded file chunks in memory.
+
+    Commands:
+        --add <file_or_dir>: Add file or dir chunks to memory.
+        --rm <file_key>: Remove all chunks with the same file name.
+        --update <file_key>: Remove and add the file chunks again.
+    """
+    pass
+
+
+@memory.command('--add')
+@click.argument('path')
+def add(path):
+    memory = LanceDBMemory(os.getcwd())
+    working_dir = os.getcwd()
+    table_name = 'mle_chat_' + working_dir.split('/')[-1]
+    chunker = CodeChunker(os.path.join(working_dir, '.mle', 'cache'), 'py')
+
+    if os.path.isdir(path):
+        file_paths = list_files(path, ['*.py'])  # TODO: support other file types
+        for file_path in file_paths:
+            raw_code = read_file(file_path)
+            chunks = chunker.chunk(raw_code, token_limit=100)
+            memory.add(
+                texts=list(chunks.values()),
+                table_name=table_name,
+                metadata=[{'file': file_path, 'chunk_key': k} for k, _ in chunks.items()]
+            )
+    elif os.path.isfile(path):
+        raw_code = read_file(path)
+        chunks = chunker.chunk(raw_code, token_limit=100)
+        memory.add(
+            texts=list(chunks.values()),
+            table_name=table_name,
+            metadata=[{'file': path, 'chunk_key': k} for k, _ in chunks.items()]
+        )
+    else:
+        console.print(f"[red]Invalid path: {path}[/red]")
+
+
+@memory.command('--rm')
+@click.argument('file_key')
+def rm(file_key):
+    memory = LanceDBMemory(os.getcwd())
+    working_dir = os.getcwd()
+    table_name = 'mle_chat_' + working_dir.split('/')[-1]
+    file_name = os.path.basename(file_key)
+    records = memory.get_by_metadata('file', file_key, table_name=table_name, n_results=1000)
+    if not records:
+        console.print(f"[red]No chunks found for file: {file_key}[/red]")
+        return
+    # Remove all chunks with matching file key
+    for record in records:
+        memory.delete(record['id'], table_name=table_name)
+    console.print(f"[green]Removed all chunks for file: {file_key}[/green]")
+
+
+@memory.command('--update')
+@click.argument('file_key')
+def update(file_key):
+    memory = LanceDBMemory(os.getcwd())
+    working_dir = os.getcwd()
+    table_name = 'mle_chat_' + working_dir.split('/')[-1]
+    # Remove chunks first
+    records = memory.get_by_metadata('file', file_key, table_name=table_name, n_results=1000)
+    for record in records:
+        memory.delete(record['id'], table_name=table_name)
+    # Then add the file again
+    chunker = CodeChunker(os.path.join(working_dir, '.mle', 'cache'), 'py')
+    if os.path.isfile(file_key):
+        raw_code = read_file(file_key)
+        chunks = chunker.chunk(raw_code, token_limit=100)
+        memory.add(
+            texts=list(chunks.values()),
+            table_name=table_name,
+            metadata=[{'file': file_key, 'chunk_key': k} for k, _ in chunks.items()]
+        )
+        console.print(f"[green]Updated memory chunks for file: {file_key}[/green]")
+    else:
+        console.print(f"[red]Invalid path for update: {file_key}[/red]")
+
 
 @cli.command()
 @click.pass_context
