+@cli.command()
+@click.option('--host', default='0.0.0.0', help='Host to bind the server to')
+@click.option('--port', default=8000, help='Port to bind the server to')
+@click.option('--dev-cmd', default='pnpm dev', help='Command to run the dev server')
+def report_server(host, port, dev_cmd):
+    import subprocess
+    import threading
+
+    # Start the dev server in a separate thread
+    def run_dev():
+        proc = subprocess.Popen(dev_cmd, shell=True)
+        proc.wait()
+
+    dev_thread = threading.Thread(target=run_dev)
+    dev_thread.start()
+
+    # Start the FastAPI server
+    click.echo(f"Starting FastAPI server on {host}:{port} and running dev command '{dev_cmd}'")
+    uvicorn.run(app, host=host, port=port)
+
+    # Wait for the dev server thread to finish
+    dev_thread.join()
+
