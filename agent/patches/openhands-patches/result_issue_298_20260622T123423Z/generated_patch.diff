+@cli.command()
+@click.option('--mem0_token', default=None, help='Mem0 API token to use for memory service')
+def mem0_interact(mem0_token):
+    """
+    Interact with Mem0 memory service.
+    """
+    from some.mem0_client import Mem0  # Assuming this is the client library for Mem0
+
+    mem0 = Mem0(api_token=mem0_token) if mem0_token else Mem0()  # Use community version if no token
+
+    # Provide a simple REPL interface for demo
+    while True:
+        query = input('Mem0 query (or type "exit" to quit): ')
+        if query == 'exit':
+            break
+
+        results = mem0.query(query)
+        print(f"Results for query '{query}':")
+        for res in results:
+            print(f"- {res}")
+
+@cli.command()
+@click.option('--mem0_token', default=None, help='Mem0 API token to use for memory service')
+@click.option('--add_content', default=None, help='Content to add to memory')
+@click.option('--metadata', default=None, help='Metadata as JSON string')
+def mem0_add(mem0_token, add_content, metadata):
+    """
+    Add content to Mem0 memory service with optional metadata.
+    """
+    import json
+    from some.mem0_client import Mem0
+
+    mem0 = Mem0(api_token=mem0_token) if mem0_token else Mem0()
+
+    meta_dict = json.loads(metadata) if metadata else {}
+    mem0.add(add_content, meta_dict)
+    print(f"Added content to Mem0 memory.")
+
+
 
