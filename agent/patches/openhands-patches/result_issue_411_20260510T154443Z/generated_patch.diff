--- a/src/agentscope/service/execute_code/exec_shell.py
+++ b/src/agentscope/service/execute_code/exec_shell.py
@@ -7,25 +7,29 @@ from agentscope.service.service_response import ServiceResponse
 
 def execute_shell_command(command: str) -> ServiceResponse:
     """
-    Executes a given shell command.
+    Executes a given shell command safely using a whitelist.
 
     Args:
         command (str): The shell command to execute.
 
     Returns:
         ServiceResponse: Contains either the output from the shell command as a
-        string if sucessful, or an error message include the error type.
+        string if successful, or an error message including the error type.
 
     Note:
-        Use any bash/shell commands you want (e.g. find, grep, cat, ls),
-        but note that :
-        1. interactive session commands (e.g. python, vim) or commands that
-        change current state (e.g. cd that change the current directory)
-        are NOT supported yet, so please do not invoke them.
-        2. be VERY CAREFUL when using commands that will
-        change/edit the files current directory (e.g. rm, sed).
-    ...
+        Only commands listed in the ALLOWED_COMMANDS are permitted.
     """
+    ALLOWED_COMMANDS = {"ls", "cat", "echo", "pwd", "whoami", "date", "id"}
+
+    # Extract the base command to check if it is allowed
+    base_command = command.strip().split()[0]
+    if base_command not in ALLOWED_COMMANDS:
+        return ServiceResponse(
+            status=ServiceExecStatus.ERROR,
+            content=f"Command '{base_command}' is not allowed for security reasons."
+        )
+
+
     try:
         result = subprocess.run(
             command,
