43 class DurableAgent(AgentBase):
44     """
45     Workflow-native durable agent runtime on top of AgentBase.
46 
47     Overview:
48         Wires your AgentBase behavior into Dapr Workflows for durable, pub/sub-driven runs.
49         Persists state using the built-in AgentWorkflowState schema while still honoring
50         safe hook overrides (entry_factory, message_coercer, etc.).
51 
52     """
53 
54     def __init__(
55         self,
56         *,
57         # Profile / prompt
58         profile: Optional[AgentProfileConfig] = None,
59         name: Optional[str] = None,
60         role: Optional[str] = None,
61         goal: Optional[str] = None,
62         instructions: Optional[Iterable[str]] = None,
63         style_guidelines: Optional[Iterable[str]] = None,
64         system_prompt: Optional[str] = None,
65         prompt_template: Optional[PromptTemplateBase] = None,
66         # Infrastructure
67         pubsub: Optional[AgentPubSubConfig] = None,
68         state: Optional[AgentStateConfig] = None,
69         registry: Optional[AgentRegistryConfig] = None,
70         # Memory / runtime
71         memory: Optional[AgentMemoryConfig] = None,
72         llm: Optional[ChatClientBase] = None,
73         tools: Optional[Iterable[Any]] = None,
74         # Behavior / execution
75         execution: Optional[AgentExecutionConfig] = None,
76         # Misc
77         agent_metadata: Optional[Dict[str, Any]] = None,
78         workflow_grpc: Optional[WorkflowGrpcOptions] = None,
79         runtime: Optional[wf.WorkflowRuntime] = None,
80     ) -> None:
81         """
82         Initialize behavior, infrastructure, and workflow runtime.
83 
84         Args:
85             profile: High-level profile (can be overridden by explicit fields).
86             name: Agent name (required if not in `profile`).
87             role: Agent role/persona label.
88             goal: High-level objective for prompting context.
89             instructions: Extra instruction lines for the system prompt.
90             style_guidelines: Style directives for the system prompt.
91             system_prompt: System prompt override.
92             prompt_template: Optional explicit prompt template instance.
93 
94             pubsub: Optional Dapr Pub/Sub configuration for triggers/broadcasts.
95                 If omitted, the agent won't subscribe to any topics and can only be
96                 triggered directly via AgentRunner.
97             state: Durable state configuration (store/key + optional hooks).
98             registry: Team registry configuration.
99             execution: Execution dials for the agent run.
100 
101             memory: Conversation memory config; defaults to in-memory, or Dapr state-backed if available.
102             llm: Chat client; defaults to `get_default_llm()`.
103             tools: Optional tool callables or `AgentTool` instances.
104 
105             agent_metadata: Extra metadata to publish to the registry.
106             workflow_grpc: Optional gRPC overrides for the workflow runtime channel.
107             runtime: Optional pre-existing workflow runtime to attach to.
108         """
109         super().__init__(
110             pubsub=pubsub,
111             profile=profile,
112             name=name,
113             role=role,
114             goal=goal,
115             instructions=instructions,
116             style_guidelines=style_guidelines,
117             system_prompt=system_prompt,
118             state=state,
119             memory=memory,
120             registry=registry,
121             execution=execution,
122             agent_metadata=agent_metadata,
123             workflow_grpc=workflow_grpc,
124             llm=llm,
125             tools=tools,
126             prompt_template=prompt_template,
127         )
128 
129         apply_grpc_options(self.workflow_grpc_options)
130 
131         self._runtime: wf.WorkflowRuntime = runtime or wf.WorkflowRuntime()
132         self._runtime_owned = runtime is None
133         self._registered = False
134         self._started = False
135 
