623     def _get_knowledge_search_query(self, task_prompt: str) -> str | None:
624         """Generate a search query for the knowledge base based on the task description."""
625         crewai_event_bus.emit(
626             self,
627             event=KnowledgeQueryStartedEvent(
628                 task_prompt=task_prompt,
629                 agent=self,
630             ),
631         )
632         query = self.i18n.slice("knowledge_search_query").format(
633             task_prompt=task_prompt
634         )
635         rewriter_prompt = self.i18n.slice("knowledge_search_query_system_prompt")
636         if not isinstance(self.llm, BaseLLM):
637             self._logger.log(
638                 "warning",
639                 f"Knowledge search query failed: LLM for agent '{self.role}' is not an instance of BaseLLM",
640             )
641             crewai_event_bus.emit(
642                 self,
643                 event=KnowledgeQueryFailedEvent(
644                     agent=self,
645                     error="LLM is not compatible with knowledge search queries",
646                 ),
647             )
648             return None
649 
650         try:
651             rewritten_query = self.llm.call(
652                 [
653                     {
654                         "role": "system",
655                         "content": rewriter_prompt,
656                     },
657                     {"role": "user", "content": query},
658                 ]
659             )
660             crewai_event_bus.emit(
661                 self,
662                 event=KnowledgeQueryCompletedEvent(
663                     query=query,
664                     agent=self,
665                 ),
666             )
667             return rewritten_query
668         except Exception as e:
669             crewai_event_bus.emit(
670                 self,
671                 event=KnowledgeQueryFailedEvent(
672                     agent=self,
673                     error=str(e),
674                 ),
675             )
676             return None
677 
678     def kickoff(
679         self,
680         messages: Union[str, List[Dict[str, str]]],
681         response_format: Optional[Type[Any]] = None,
682     ) -> LiteAgentOutput:
683         """
684         Execute the agent with the given messages using a LiteAgent instance.
685 
686         This method is useful when you want to use the Agent configuration but
687         with the simpler and more direct execution flow of LiteAgent.
688 
689         Args:
690             messages: Either a string query or a list of message dictionaries.
691                      If a string is provided, it will be converted to a user message.
692                      If a list is provided, each dict should have 'role' and 'content' keys.
693             response_format: Optional Pydantic model for structured output.
694 
695         Returns:
696             LiteAgentOutput: The result of the agent execution.
697         """
698         lite_agent = LiteAgent(
699             role=self.role,
700             goal=self.goal,
701             backstory=self.backstory,
702             llm=self.llm,
703             tools=self.tools or [],
704             max_iterations=self.max_iter,
705             max_execution_time=self.max_execution_time,
706             respect_context_window=self.respect_context_window,
707             verbose=self.verbose,
708             response_format=response_format,
709             i18n=self.i18n,
710             original_agent=self,
711         )
712 
713         return lite_agent.kickoff(messages)
714 
