209         task: Task,
210         context: Optional[str] = None,
211         tools: Optional[List[BaseTool]] = None,
212     ) -> str:
213         """Execute a task with the agent.
214 
215         Args:
216             task: Task to execute.
217             context: Context to execute the task in.
218             tools: Tools to use for the task.
219 
220         Returns:
221             Output of the agent
222 
223         Raises:
224             TimeoutError: If execution exceeds the maximum execution time.
225             ValueError: If the max execution time is not a positive integer.
226             RuntimeError: If the agent execution fails for other reasons.
227         """
228         if self.tools_handler:
229             self.tools_handler.last_used_tool = {}  # type: ignore # Incompatible types in assignment (expression has type "dict[Never, Never]", variable has type "ToolCalling")
230 
231         task_prompt = task.prompt()
232 
233         # If the task requires output in JSON or Pydantic format,
234         # append specific instructions to the task prompt to ensure
235         # that the final answer does not include any code block markers
236         if task.output_json or task.output_pydantic:
237             # Generate the schema based on the output format
238             if task.output_json:
239                 # schema = json.dumps(task.output_json, indent=2)
240                 schema = generate_model_description(task.output_json)
241                 task_prompt += "\n" + self.i18n.slice(
242                     "formatted_task_instructions"
243                 ).format(output_format=schema)
244 
245             elif task.output_pydantic:
246                 schema = generate_model_description(task.output_pydantic)
247                 task_prompt += "\n" + self.i18n.slice(
248                     "formatted_task_instructions"
249                 ).format(output_format=schema)
250 
251         if context:
252             task_prompt = self.i18n.slice("task_with_context").format(
253                 task=task_prompt, context=context
254             )
255 
256         if self._is_any_available_memory():
257             contextual_memory = ContextualMemory(
258                 self.crew.memory_config,
259                 self.crew._short_term_memory,
260                 self.crew._long_term_memory,
261                 self.crew._entity_memory,
262                 self.crew._user_memory,
263                 self.crew._external_memory,
264             )
265             memory = contextual_memory.build_context_for_task(task, context)
266             if memory.strip() != "":
267                 task_prompt += self.i18n.slice("memory").format(memory=memory)
268         knowledge_config = (
269             self.knowledge_config.model_dump() if self.knowledge_config else {}
270         )
271 
272         if self.knowledge:
273             crewai_event_bus.emit(
274                 self,
275                 event=KnowledgeRetrievalStartedEvent(
276                     agent=self,
277                 ),
278             )
279             try:
280                 self.knowledge_search_query = self._get_knowledge_search_query(
281                     task_prompt
282                 )
283                 if self.knowledge_search_query:
284                     agent_knowledge_snippets = self.knowledge.query(
285                         [self.knowledge_search_query], **knowledge_config
286                     )
287                     if agent_knowledge_snippets:
288                         self.agent_knowledge_context = extract_knowledge_context(
289                             agent_knowledge_snippets
290                         )
291                         if self.agent_knowledge_context:
292                             task_prompt += self.agent_knowledge_context
293                     if self.crew:
294                         knowledge_snippets = self.crew.query_knowledge(
295                             [self.knowledge_search_query], **knowledge_config
296                         )
297                         if knowledge_snippets:
298                             self.crew_knowledge_context = extract_knowledge_context(
299                                 knowledge_snippets
300                             )
301                             if self.crew_knowledge_context:
302                                 task_prompt += self.crew_knowledge_context
303 
304                     crewai_event_bus.emit(
305                         self,
306                         event=KnowledgeRetrievalCompletedEvent(
307                             query=self.knowledge_search_query,
308                             agent=self,
309                             retrieved_knowledge=(
310                                 (self.agent_knowledge_context or "")
311                                 + (
312                                     "\n"
313                                     if self.agent_knowledge_context
314                                     and self.crew_knowledge_context
315                                     else ""
316                                 )
317                                 + (self.crew_knowledge_context or "")
318                             ),
319                         ),
320                     )
321             except Exception as e:
322                 crewai_event_bus.emit(
323                     self,
324                     event=KnowledgeSearchQueryFailedEvent(
325                         query=self.knowledge_search_query or "",
326                         agent=self,
327                         error=str(e),
328                     ),
329                 )
330 
331         tools = tools or self.tools or []
332         self.create_agent_executor(tools=tools, task=task)
333 
334         if self.crew and self.crew._train:
335             task_prompt = self._training_handler(task_prompt=task_prompt)
336         else:
337             task_prompt = self._use_trained_data(task_prompt=task_prompt)
338 
339         try:
340             crewai_event_bus.emit(
341                 self,
342                 event=AgentExecutionStartedEvent(
343                     agent=self,
344                     tools=self.tools,
345                     task_prompt=task_prompt,
346                     task=task,
347                 ),
348             )
349 
350             # Determine execution method based on timeout setting
351             if self.max_execution_time is not None:
352                 if (
353                     not isinstance(self.max_execution_time, int)
354                     or self.max_execution_time <= 0
355                 ):
356                     raise ValueError(
357                         "Max Execution time must be a positive integer greater than zero"
358                     )
359                 result = self._execute_with_timeout(
360                     task_prompt, task, self.max_execution_time
361                 )
362             else:
363                 result = self._execute_without_timeout(task_prompt, task)
364 
365         except TimeoutError as e:
366             # Propagate TimeoutError without retry
367             crewai_event_bus.emit(
368                 self,
369                 event=AgentExecutionErrorEvent(
370                     agent=self,
371                     task=task,
372                     error=str(e),
373                 ),
374             )
375             raise e
376         except Exception as e:
377             if e.__class__.__module__.startswith("litellm"):
378                 # Do not retry on litellm errors
379                 crewai_event_bus.emit(
380                     self,
381                     event=AgentExecutionErrorEvent(
382                         agent=self,
383                         task=task,
384                         error=str(e),
385                     ),
386                 )
387                 raise e
388             self._times_executed += 1
389             if self._times_executed > self.max_retry_limit:
390                 crewai_event_bus.emit(
391                     self,
392                     event=AgentExecutionErrorEvent(
393                         agent=self,
394                         task=task,
395                         error=str(e),
396                     ),
397                 )
398                 raise e
399             result = self.execute_task(task, context, tools)
400 
401         if self.max_rpm and self._rpm_controller:
402             self._rpm_controller.stop_rpm_counter()
403 
404         # If there was any tool in self.tools_results that had result_as_answer
405         # set to True, return the results of the last tool that had
406         # result_as_answer set to True
407         for tool_result in self.tools_results:  # type: ignore # Item "None" of "list[Any] | None" has no attribute "__iter__" (not iterable)
408             if tool_result.get("result_as_answer", False):
409                 result = tool_result["result"]
410         crewai_event_bus.emit(
411             self,
412             event=AgentExecutionCompletedEvent(agent=self, task=task, output=result),
413         )
414         return result

