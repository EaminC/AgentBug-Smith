416     def _execute_with_timeout(self, task_prompt: str, task: Task, timeout: int) -> str:
417         """Execute a task with a timeout.
418 
419         Args:
420             task_prompt: The prompt to send to the agent.
421             task: The task being executed.
422             timeout: Maximum execution time in seconds.
423 
424         Returns:
425             The output of the agent.
426 
427         Raises:
428             TimeoutError: If execution exceeds the timeout.
429             RuntimeError: If execution fails for other reasons.
430         """
431         import concurrent.futures
432 
433         with concurrent.futures.ThreadPoolExecutor() as executor:
434             future = executor.submit(
435                 self._execute_without_timeout, task_prompt=task_prompt, task=task
436             )
437 
438             try:
439                 return future.result(timeout=timeout)
440             except concurrent.futures.TimeoutError:
441                 future.cancel()
442                 raise TimeoutError(
443                     f"Task '{task.description}' execution timed out after {timeout} seconds. Consider increasing max_execution_time or optimizing the task."
444                 )
445             except Exception as e:
446                 future.cancel()
447                 raise RuntimeError(f"Task execution failed: {str(e)}")
448 
449     def _execute_without_timeout(self, task_prompt: str, task: Task) -> str:
450         """Execute a task without a timeout.
451 
452         Args:
453             task_prompt: The prompt to send to the agent.
454             task: The task being executed.
455 
456         Returns:
457             The output of the agent.
458         """
459         return self.agent_executor.invoke(
460             {
461                 "input": task_prompt,
462                 "tool_names": self.agent_executor.tools_names,
463                 "tools": self.agent_executor.tools_description,
464                 "ask_for_human_input": task.human_input,
465             }
466         )["output"]
467 
468     def create_agent_executor(
469         self, tools: Optional[List[BaseTool]] = None, task=None
470     ) -> None:
471         """Create an agent executor for the agent.
472 
473         Returns:
474             An instance of the CrewAgentExecutor class.
475         """
476         raw_tools: List[BaseTool] = tools or self.tools or []
477         parsed_tools = parse_tools(raw_tools)
478 
479         prompt = Prompts(
480             agent=self,
481             has_tools=len(raw_tools) > 0,
482             i18n=self.i18n,
483             use_system_prompt=self.use_system_prompt,
484             system_template=self.system_template,
485             prompt_template=self.prompt_template,
486             response_template=self.response_template,
487         ).task_execution()
488 
489         stop_words = [self.i18n.slice("observation")]
490 
491         if self.response_template:
492             stop_words.append(
493                 self.response_template.split("{{ .Response }}")[1].strip()
494             )
495 
496         self.agent_executor = CrewAgentExecutor(
497             llm=self.llm,
498             task=task,
499             agent=self,
500             crew=self.crew,
501             tools=parsed_tools,
502             prompt=prompt,
503             original_tools=raw_tools,
504             stop_words=stop_words,
505             max_iter=self.max_iter,
506             tools_handler=self.tools_handler,
507             tools_names=get_tool_names(parsed_tools),
508             tools_description=render_text_description_and_args(parsed_tools),
509             step_callback=self.step_callback,
510             function_calling_llm=self.function_calling_llm,
511             respect_context_window=self.respect_context_window,
512             request_within_rpm_limit=(
513                 self._rpm_controller.check_or_wait if self._rpm_controller else None
514             ),
515             callbacks=[TokenCalcHandler(self._token_process)],
516         )
