32     def build_context_for_task(self, task, context) -> str:
33         """
34         Automatically builds a minimal, highly relevant set of contextual information
35         for a given task.
36         """
37         query = f"{task.description} {context}".strip()
38 
39         if query == "":
40             return ""
41 
42         context = []
43         context.append(self._fetch_ltm_context(task.description))
44         context.append(self._fetch_stm_context(query))
45         context.append(self._fetch_entity_context(query))
46         context.append(self._fetch_external_context(query))
47         if self.memory_provider == "mem0":
48             context.append(self._fetch_user_context(query))
49         return "\n".join(filter(None, context))
50 
51     def _fetch_stm_context(self, query) -> str:
52         """
53         Fetches recent relevant insights from STM related to the task's description and expected_output,
54         formatted as bullet points.
55         """
56 
57         if self.stm is None:
58             return ""
59 
60         stm_results = self.stm.search(query)
61         formatted_results = "\n".join(
62             [
63                 f"- {result['memory'] if self.memory_provider == 'mem0' else result['context']}"
64                 for result in stm_results
65             ]
66         )
67         return f"Recent Insights:\n{formatted_results}" if stm_results else ""
68 
69     def _fetch_ltm_context(self, task) -> Optional[str]:
70         """
71         Fetches historical data or insights from LTM that are relevant to the task's description and expected_output,
72         formatted as bullet points.
73         """
74 
75         if self.ltm is None:
76             return ""
77 
78         ltm_results = self.ltm.search(task, latest_n=2)
79         if not ltm_results:
80             return None
81 
82         formatted_results = [
83             suggestion
84             for result in ltm_results
85             for suggestion in result["metadata"]["suggestions"]  # type: ignore # Invalid index type "str" for "str"; expected type "SupportsIndex | slice"
86         ]
87         formatted_results = list(dict.fromkeys(formatted_results))
88         formatted_results = "\n".join([f"- {result}" for result in formatted_results])  # type: ignore # Incompatible types in assignment (expression has type "str", variable has type "list[str]")
89 
90         return f"Historical Data:\n{formatted_results}" if ltm_results else ""
91 
92     def _fetch_entity_context(self, query) -> str:
93         """
94         Fetches relevant entity information from Entity Memory related to the task's description and expected_output,
95         formatted as bullet points.
96         """
97         if self.em is None:
98             return ""
99 
100         em_results = self.em.search(query)
101         formatted_results = "\n".join(
102             [
103                 f"- {result['memory'] if self.memory_provider == 'mem0' else result['context']}"
104                 for result in em_results
105             ]  # type: ignore #  Invalid index type "str" for "str"; expected type "SupportsIndex | slice"
106         )
107         return f"Entities:\n{formatted_results}" if em_results else ""
108 
109     def _fetch_user_context(self, query: str) -> str:
110         """
111         Fetches and formats relevant user information from User Memory.
112         Args:
113             query (str): The search query to find relevant user memories.
114         Returns:
115             str: Formatted user memories as bullet points, or an empty string if none found.
116         """
117 
118         if self.um is None:
119             return ""
120 
121         user_memories = self.um.search(query)
122         if not user_memories:
123             return ""
124 
125         formatted_memories = "\n".join(
126             f"- {result['memory']}" for result in user_memories
127         )
128         return f"User memories/preferences:\n{formatted_memories}"
129 
130     def _fetch_external_context(self, query: str) -> str:
131         """
132         Fetches and formats relevant information from External Memory.
133         Args:
134             query (str): The search query to find relevant information.
135         Returns:
136             str: Formatted information as bullet points, or an empty string if none found.
137         """
138         if self.exm is None:
139             return ""
140 
141         external_memories = self.exm.search(query)
142 
143         if not external_memories:
144             return ""
145 
146         formatted_memories = "\n".join(
147             f"- {result['memory']}" for result in external_memories
148         )
149         return f"External memories:\n{formatted_memories}"

