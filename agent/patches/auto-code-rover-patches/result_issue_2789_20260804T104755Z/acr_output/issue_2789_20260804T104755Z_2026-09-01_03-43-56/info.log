588     def _validate_docker_installation(self) -> None:
589         """Check if Docker is installed and running."""
590         if not shutil.which("docker"):
591             raise RuntimeError(
592                 f"Docker is not installed. Please install Docker to use code execution with agent: {self.role}"
593             )
594 
595         try:
596             subprocess.run(
597                 ["docker", "info"],
598                 check=True,
599                 stdout=subprocess.PIPE,
600                 stderr=subprocess.PIPE,
601             )
602         except subprocess.CalledProcessError:
603             raise RuntimeError(
604                 f"Docker is not running. Please start Docker to use code execution with agent: {self.role}"
605             )
