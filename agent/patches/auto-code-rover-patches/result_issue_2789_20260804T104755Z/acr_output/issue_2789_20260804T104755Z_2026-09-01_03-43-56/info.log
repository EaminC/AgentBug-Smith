312                                     "\n"
313                                     if self.agent_knowledge_context
314                                     and self.crew_knowledge_context
315                                     else ""
316                                 )
317                                 + (self.crew_knowledge_context or "")
318                             ),
319                         ),
320                     )
321             except Exception as e:
322                 crewai_event_bus.emit(
323                     self,
324                     event=KnowledgeSearchQueryFailedEvent(
325                         query=self.knowledge_search_query or "",
326                         agent=self,
327                         error=str(e),
328                     ),
329                 )
330 
331         tools = tools or self.tools or []
332         self.create_agent_executor(tools=tools, task=task)
333 
334         if self.crew and self.crew._train:
335             task_prompt = self._training_handler(task_prompt=task_prompt)
336         else:
337             task_prompt = self._use_trained_data(task_prompt=task_prompt)
338 
339         try:
340             crewai_event_bus.emit(
341                 self,
342                 event=AgentExecutionStartedEvent(
343                     agent=self,
344                     tools=self.tools,
345                     task_prompt=task_prompt,
346                     task=task,
347                 ),
348             )
349 
350             # Determine execution method based on timeout setting
351             if self.max_execution_time is not None:
352                 if (
353                     not isinstance(self.max_execution_time, int)
354                     or self.max_execution_time <= 0
355                 ):
356                     raise ValueError(
357                         "Max Execution time must be a positive integer greater than zero"
358                     )
359                 result = self._execute_with_timeout(
360                     task_prompt, task, self.max_execution_time
361                 )
362             else:
363                 result = self._execute_without_timeout(task_prompt, task)
364 
365         except TimeoutError as e:
366             # Propagate TimeoutError without retry
367             crewai_event_bus.emit(
368                 self,
369                 event=AgentExecutionErrorEvent(
370                     agent=self,
371                     task=task,
372                     error=str(e),
373                 ),
374             )
375             raise e
376         except Exception as e:
377             if e.__class__.__module__.startswith("litellm"):
378                 # Do not retry on litellm errors
379                 crewai_event_bus.emit(
380                     self,
381                     event=AgentExecutionErrorEvent(
382                         agent=self,
383                         task=task,
384                         error=str(e),
385                     ),
386                 )
387                 raise e
388             self._times_executed += 1
389             if self._times_executed > self.max_retry_limit:
390                 crewai_event_bus.emit(
391                     self,
392                     event=AgentExecutionErrorEvent(
393                         agent=self,
394                         task=task,
395                         error=str(e),
396                     ),
397                 )
398                 raise e
399             result = self.execute_task(task, context, tools)
400 
401         if self.max_rpm and self._rpm_controller:
402             self._rpm_controller.stop_rpm_counter()
403 
404         # If there was any tool in self.tools_results that had result_as_answer
405         # set to True, return the results of the last tool that had
406         # result_as_answer set to True
407         for tool_result in self.tools_results:  # type: ignore # Item "None" of "list[Any] | None" has no attribute "__iter__" (not iterable)
408             if tool_result.get("result_as_answer", False):
409                 result = tool_result["result"]
410         crewai_event_bus.emit(
411             self,
412             event=AgentExecutionCompletedEvent(agent=self, task=task, output=result),
413         )
414         return result
415 
416     def _execute_with_timeout(self, task_prompt: str, task: Task, timeout: int) -> str:
417         """Execute a task with a timeout.
418 
419         Args:
420             task_prompt: The prompt to send to the agent.
421             task: The task being executed.
422             timeout: Maximum execution time in seconds.
423 
424         Returns:
425             The output of the agent.
426 
427         Raises:
428             TimeoutError: If execution exceeds the timeout.
429             RuntimeError: If execution fails for other reasons.
430         """
431         import concurrent.futures
432 
433         with concurrent.futures.ThreadPoolExecutor() as executor:
434             future = executor.submit(
435                 self._execute_without_timeout, task_prompt=task_prompt, task=task
436             )
437 
438             try:
439                 return future.result(timeout=timeout)
440             except concurrent.futures.TimeoutError:
441                 future.cancel()
442                 raise TimeoutError(
443                     f"Task '{task.description}' execution timed out after {timeout} seconds. Consider increasing max_execution_time or optimizing the task."
444                 )
445             except Exception as e:
446                 future.cancel()
447                 raise RuntimeError(f"Task execution failed: {str(e)}")
448 
449     def _execute_without_timeout(self, task_prompt: str, task: Task) -> str:
450         """Execute a task without a timeout.
451 
452         Args:
453             task_prompt: The prompt to send to the agent.
454             task: The task being executed.
455 
456         Returns:
457             The output of the agent.
458         """
459         return self.agent_executor.invoke(
460             {
461                 "input": task_prompt,
462                 "tool_names": self.agent_executor.tools_names,
463                 "tools": self.agent_executor.tools_description,
464                 "ask_for_human_input": task.human_input,
465             }
466         )["output"]
467 
468     def create_agent_executor(
469         self, tools: Optional[List[BaseTool]] = None, task=None
470     ) -> None:
471         """Create an agent executor for the agent.
472 
473         Returns:
474             An instance of the CrewAgentExecutor class.
475         """
476         raw_tools: List[BaseTool] = tools or self.tools or []
477         parsed_tools = parse_tools(raw_tools)
478 
479         prompt = Prompts(
480             agent=self,
481             has_tools=len(raw_tools) > 0,
482             i18n=self.i18n,
483             use_system_prompt=self.use_system_prompt,
484             system_template=self.system_template,
485             prompt_template=self.prompt_template,
486             response_template=self.response_template,
487         ).task_execution()
488 
489         stop_words = [self.i18n.slice("observation")]
490 
491         if self.response_template:
492             stop_words.append(
493                 self.response_template.split("{{ .Response }}")[1].strip()
494             )
495 
496         self.agent_executor = CrewAgentExecutor(
497             llm=self.llm,
498             task=task,
499             agent=self,
500             crew=self.crew,
501             tools=parsed_tools,
502             prompt=prompt,
503             original_tools=raw_tools,
504             stop_words=stop_words,
505             max_iter=self.max_iter,
506             tools_handler=self.tools_handler,
507             tools_names=get_tool_names(parsed_tools),
508             tools_description=render_text_description_and_args(parsed_tools),
509             step_callback=self.step_callback,
510             function_calling_llm=self.function_calling_llm,
511             respect_context_window=self.respect_context_window,
512             request_within_rpm_limit=(
513                 self._rpm_controller.check_or_wait if self._rpm_controller else None
514             ),
515             callbacks=[TokenCalcHandler(self._token_process)],
516         )
517 
