678     def kickoff(
679         self,
680         messages: Union[str, List[Dict[str, str]]],
681         response_format: Optional[Type[Any]] = None,
682     ) -> LiteAgentOutput:
683         """
684         Execute the agent with the given messages using a LiteAgent instance.
685 
686         This method is useful when you want to use the Agent configuration but
687         with the simpler and more direct execution flow of LiteAgent.
688 
689         Args:
690             messages: Either a string query or a list of message dictionaries.
691                      If a string is provided, it will be converted to a user message.
692                      If a list is provided, each dict should have 'role' and 'content' keys.
693             response_format: Optional Pydantic model for structured output.
694 
695         Returns:
696             LiteAgentOutput: The result of the agent execution.
697         """
698         lite_agent = LiteAgent(
699             role=self.role,
700             goal=self.goal,
701             backstory=self.backstory,
702             llm=self.llm,
703             tools=self.tools or [],
704             max_iterations=self.max_iter,
705             max_execution_time=self.max_execution_time,
706             respect_context_window=self.respect_context_window,
707             verbose=self.verbose,
708             response_format=response_format,
709             i18n=self.i18n,
710             original_agent=self,
711         )
712 
713         return lite_agent.kickoff(messages)
714 
715     async def kickoff_async(
716         self,
717         messages: Union[str, List[Dict[str, str]]],
718         response_format: Optional[Type[Any]] = None,
719     ) -> LiteAgentOutput:
720         """
721         Execute the agent asynchronously with the given messages using a LiteAgent instance.
722 
723         This is the async version of the kickoff method.
724 
725         Args:
726             messages: Either a string query or a list of message dictionaries.
727                      If a string is provided, it will be converted to a user message.
728                      If a list is provided, each dict should have 'role' and 'content' keys.
729             response_format: Optional Pydantic model for structured output.
730 
731         Returns:
732             LiteAgentOutput: The result of the agent execution.
733         """
734         lite_agent = LiteAgent(
735             role=self.role,
736             goal=self.goal,
737             backstory=self.backstory,
738             llm=self.llm,
739             tools=self.tools or [],
740             max_iterations=self.max_iter,
741             max_execution_time=self.max_execution_time,
742             respect_context_window=self.respect_context_window,
743             verbose=self.verbose,
744             response_format=response_format,
745             i18n=self.i18n,
746             original_agent=self,
747         )
748 
749         return await lite_agent.kickoff_async(messages)

