404         # If there was any tool in self.tools_results that had result_as_answer
405         # set to True, return the results of the last tool that had
406         # result_as_answer set to True
407         for tool_result in self.tools_results:  # type: ignore # Item "None" of "list[Any] | None" has no attribute "__iter__" (not iterable)
408             if tool_result.get("result_as_answer", False):
409                 result = tool_result["result"]
410         crewai_event_bus.emit(
411             self,
412             event=AgentExecutionCompletedEvent(agent=self, task=task, output=result),
413         )
414         return result

