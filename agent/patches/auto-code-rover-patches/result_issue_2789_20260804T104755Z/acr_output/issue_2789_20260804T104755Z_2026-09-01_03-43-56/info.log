12 class ContextualMemory:
13     def __init__(
14         self,
15         memory_config: Optional[Dict[str, Any]],
16         stm: ShortTermMemory,
17         ltm: LongTermMemory,
18         em: EntityMemory,
19         um: UserMemory,
20         exm: ExternalMemory,
21     ):
22         if memory_config is not None:
23             self.memory_provider = memory_config.get("provider")
24         else:
25             self.memory_provider = None
