543     def _training_handler(self, task_prompt: str) -> str:
544         """Handle training data for the agent task prompt to improve output on Training."""
545         if data := CrewTrainingHandler(TRAINING_DATA_FILE).load():
546             agent_id = str(self.id)
547 
548             if data.get(agent_id):
549                 human_feedbacks = [
550                     i["human_feedback"] for i in data.get(agent_id, {}).values()
551                 ]
552                 task_prompt += (
553                     "\n\nYou MUST follow these instructions: \n "
554                     + "\n - ".join(human_feedbacks)
555                 )
556 
557         return task_prompt
558 
559     def _use_trained_data(self, task_prompt: str) -> str:
560         """Use trained data for the agent task prompt to improve output."""
561         if data := CrewTrainingHandler(TRAINED_AGENTS_DATA_FILE).load():
562             if trained_data_output := data.get(self.role):
563                 task_prompt += (
564                     "\n\nYou MUST follow these instructions: \n - "
565                     + "\n - ".join(trained_data_output["suggestions"])
566                 )
567         return task_prompt
568 
569     def _render_text_description(self, tools: List[Any]) -> str:
570         """Render the tool name and description in plain text.
571 
572         Output will be in the format of:
573 
574         .. code-block:: markdown
575 
576             search: This tool is used for search
577             calculator: This tool is used for math
578         """
579         description = "\n".join(
580             [
581                 f"Tool name: {tool.name}\nTool description:\n{tool.description}"
582                 for tool in tools
583             ]
584         )
585 
586         return description
