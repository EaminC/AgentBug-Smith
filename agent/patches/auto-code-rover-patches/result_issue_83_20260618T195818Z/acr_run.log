508     async def close(self) -> None:
509         """
510         Close all connections to MCP servers and clean up resources.
511         
512         This method should be called when the client is no longer needed to
513         ensure proper cleanup of all resources and connections.
514         """
515         logger.info("Closing MCP client and all server connections")
516         
517         # Verify we're in the same task as the one that created the connections
518         current_task = asyncio.current_task()
519         for server_name, server_task in self._task_locals.items():
520             if server_task != current_task:
521                 logger.warning(
522                     f"Attempting to close server '{server_name}' in a different task "
523                     f"than it was created in. This may cause errors."
524                 )
525         
526         # Close all connections
527         try:
528             await self._exit_stack.aclose()
529             self._sessions.clear()
530             self._server_tools.clear()
531             self._task_locals.clear()
532             logger.info("MCP client successfully closed")
533         except Exception as e:
534             logger.error(f"Error closing MCP client: {str(e)}")
535             raise
