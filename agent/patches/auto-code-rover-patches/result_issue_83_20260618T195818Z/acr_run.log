18 class MCPClient(BaseModel):
19     """
20     Client for connecting to MCP servers and integrating their tools with the Dapr agent framework.
21 
22     This client manages connections to one or more MCP servers, retrieves their tools,
23     and converts them to native AgentTool objects that can be used in the agent framework.
24 
25     Attributes:
26         allowed_tools: Optional set of tool names to include (when None, all tools are included)
27         server_timeout: Timeout in seconds for server connections
28         sse_read_timeout: Read timeout for SSE connections in seconds
