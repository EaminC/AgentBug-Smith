18 class MCPClient(BaseModel):
19     """
20     Client for connecting to MCP servers and integrating their tools with the Dapr agent framework.
21 
22     This client manages connections to one or more MCP servers, retrieves their tools,
23     and converts them to native AgentTool objects that can be used in the agent framework.
24 
25     Attributes:
26         allowed_tools: Optional set of tool names to include (when None, all tools are included)
27         server_timeout: Timeout in seconds for server connections
28         sse_read_timeout: Read timeout for SSE connections in seconds
29     """
30     allowed_tools: Optional[Set[str]] = Field(default=None, description="Optional set of tool names to include (when None, all tools are included)")
31     server_timeout: float = Field(default=5.0, description="Timeout in seconds for server connections")
32     sse_read_timeout: float = Field(default=300.0, description="Read timeout for SSE connections in seconds")
33 
34     # Private attributes not exposed in model schema
35     _exit_stack: AsyncExitStack = PrivateAttr(default_factory=AsyncExitStack)
36     _sessions: Dict[str, ClientSession] = PrivateAttr(default_factory=dict)
37     _server_tools: Dict[str, List[AgentTool]] = PrivateAttr(default_factory=dict)
38     _server_prompts: Dict[str, Dict[str, Prompt]] = PrivateAttr(default_factory=dict)
39     _task_locals: Dict[str, Any] = PrivateAttr(default_factory=dict)
40     _server_configs: Dict[str, Dict[str, Any]] = PrivateAttr(default_factory=dict)
41 
42     def model_post_init(self, __context: Any) -> None:
43         """Initialize the client after the model is created."""
44         logger.debug("Initializing MCP client")
45         super().model_post_init(__context)
46     
47     @asynccontextmanager
48     async def create_session(self, server_name: str) -> AsyncGenerator[ClientSession, None]:
49         """
50         Create an ephemeral session for the given server and yield it.
51         Used during tool execution to avoid reuse issues.
52 
53         Args:
54             server_name: The server to create a session for.
55 
56         Yields:
57             A short-lived, initialized MCP session.
58         """
59         logger.debug(f"[MCP] Creating ephemeral session for server '{server_name}'")
60         session = await self._create_ephemeral_session(server_name)
61         try:
62             yield session
63         finally:
64             # Session cleanup is managed by AsyncExitStack (via transport module)
65             pass
66     
67     async def connect_stdio(
68         self,
69         server_name: str,
70         command: str,
71         args: List[str],
72         env: Optional[Dict[str, str]] = None
73     ) -> None:
74         """
75         Connect to an MCP server using stdio transport and store the connection
76         metadata for future dynamic reconnection if needed.
77 
78         Args:
79             server_name (str): Unique identifier for this server connection.
80             command (str): Executable to run.
81             args (List[str]): Command-line arguments.
82             env (Optional[Dict[str, str]]): Environment variables for the process.
83 
84         Raises:
85             RuntimeError: If a server with the same name is already connected.
86             Exception: If connection setup or initialization fails.
87         """
88         logger.info(f"Connecting to MCP server '{server_name}' via stdio: {command} {args}")
89 
90         if server_name in self._sessions:
91             raise RuntimeError(f"Server '{server_name}' is already connected")
92 
93         try:
94             self._task_locals[server_name] = asyncio.current_task()
95 
96             from dapr_agents.tool.mcp.transport import connect_stdio as transport_connect_stdio
97             session = await transport_connect_stdio(
98                 command=command,
99                 args=args,
100                 env=env,
101                 stack=self._exit_stack
102             )
103 
104             await session.initialize()
105             self._sessions[server_name] = session
106 
107             # Store how to reconnect this server later
108             self._server_configs[server_name] = {
109                 "type": "stdio",
110                 "params": {"command": command, "args": args, "env": env},
111             }
112 
113             logger.debug(f"Initialized session for server '{server_name}', loading tools and prompts")
114             await self._load_tools_from_session(server_name, session)
115             await self._load_prompts_from_session(server_name, session)
116             logger.info(f"Successfully connected to MCP server '{server_name}'")
117 
118         except Exception as e:
119             logger.error(f"Failed to connect to MCP server '{server_name}': {str(e)}")
120             self._sessions.pop(server_name, None)
121             self._task_locals.pop(server_name, None)
122             self._server_configs.pop(server_name, None)
123             raise
124 
125     async def connect_sse(
126         self,
127         server_name: str,
128         url: str,
129         headers: Optional[Dict[str, str]] = None
130     ) -> None:
131         """
132         Connect to an MCP server using Server-Sent Events (SSE) transport and store
133         the connection metadata for future dynamic reconnection if needed.
134 
135         Args:
136             server_name (str): Unique identifier for this server connection.
137             url (str): The SSE endpoint URL.
138             headers (Optional[Dict[str, str]]): HTTP headers to include with the request.
139 
140         Raises:
141             RuntimeError: If a server with the same name is already connected.
142             Exception: If connection setup or initialization fails.
143         """
144         logger.info(f"Connecting to MCP server '{server_name}' via SSE: {url}")
145 
146         if server_name in self._sessions:
147             raise RuntimeError(f"Server '{server_name}' is already connected")
148 
149         try:
150             self._task_locals[server_name] = asyncio.current_task()
151 
152             from dapr_agents.tool.mcp.transport import connect_sse as transport_connect_sse
153             session = await transport_connect_sse(
154                 url=url,
155                 headers=headers,
156                 timeout=self.server_timeout,
157                 read_timeout=self.sse_read_timeout,
158                 stack=self._exit_stack
159             )
160 
161             await session.initialize()
162             self._sessions[server_name] = session
163 
164             # Store how to reconnect this server later
165             self._server_configs[server_name] = {
166                 "type": "sse",
167                 "params": {
168                     "url": url,
169                     "headers": headers,
170                     "timeout": self.server_timeout,
171                     "read_timeout": self.sse_read_timeout,
172                 },
173             }
174 
175             logger.debug(f"Initialized session for server '{server_name}', loading tools and prompts")
176             await self._load_tools_from_session(server_name, session)
177             await self._load_prompts_from_session(server_name, session)
178             logger.info(f"Successfully connected to MCP server '{server_name}'")
179 
180         except Exception as e:
181             logger.error(f"Failed to connect to MCP server '{server_name}': {str(e)}")
182             self._sessions.pop(server_name, None)
183             self._task_locals.pop(server_name, None)
184             self._server_configs.pop(server_name, None)
185             raise
186     
187     async def _load_tools_from_session(self, server_name: str, session: ClientSession) -> None:
188         """
189         Load tools from a given MCP session and convert them to AgentTools.
190         
191         Args:
192             server_name: Unique identifier for this server
193             session: The MCP client session
194         """
195         logger.debug(f"Loading tools from server '{server_name}'")
196         
197         try:
198             # Get tools from the server
199             tools_response = await session.list_tools()
200             
201             # Convert MCP tools to agent tools
202             converted_tools = []
203             for mcp_tool in tools_response.tools:
204                 # Skip tools not in allowed_tools if filtering is enabled
205                 if self.allowed_tools and mcp_tool.name not in self.allowed_tools:
206                     logger.debug(f"Skipping tool '{mcp_tool.name}' (not in allowed_tools)")
207                     continue
208                 
209                 try:
210                     agent_tool = await self.wrap_mcp_tool(server_name, mcp_tool)
211                     converted_tools.append(agent_tool)
212                 except Exception as e:
213                     logger.warning(f"Failed to convert tool '{mcp_tool.name}': {str(e)}")
214             
215             self._server_tools[server_name] = converted_tools
216             logger.info(f"Loaded {len(converted_tools)} tools from server '{server_name}'")
217         except Exception as e:
218             logger.warning(f"Failed to load tools from server '{server_name}': {str(e)}")
219             self._server_tools[server_name] = []
220     
221     async def _load_prompts_from_session(self, server_name: str, session: ClientSession) -> None:
222         """
223         Load prompts from a given MCP session.
224         
225         Args:
226             server_name: Unique identifier for this server
227             session: The MCP client session
228         """
229         logger.debug(f"Loading prompts from server '{server_name}'")
230         try:
231             response = await session.list_prompts()
232             prompt_dict = {prompt.name: prompt for prompt in response.prompts}
233             self._server_prompts[server_name] = prompt_dict
234 
235             loaded = [
236                 f"{p.name} ({len(p.arguments or [])} args)" 
237                 for p in response.prompts
238             ]
239             logger.info(
240                 f"Loaded {len(loaded)} prompts from server '{server_name}': " +
241                 ", ".join(loaded)
242             )
243         except Exception as e:
244             logger.warning(f"Failed to load prompts from server '{server_name}': {str(e)}")
245             self._server_prompts[server_name] = []
246     
247     async def _create_ephemeral_session(self, server_name: str) -> ClientSession:
248         """
249         Create a fresh session for a single tool call.
250 
251         Args:
252             server_name: The MCP server to connect to.
253 
254         Returns:
255             A fully initialized ephemeral ClientSession.
256         """
257         config = self._server_configs.get(server_name)
258         if not config:
259             raise ToolError(f"No stored config found for server '{server_name}'")
260 
261         try:
262             if config["type"] == "stdio":
263                 from dapr_agents.tool.mcp.transport import connect_stdio
264                 session = await connect_stdio(**config["params"], stack=self._exit_stack)
265             elif config["type"] == "sse":
266                 from dapr_agents.tool.mcp.transport import connect_sse
267                 session = await connect_sse(**config["params"], stack=self._exit_stack)
268             else:
269                 raise ToolError(f"Unknown transport type: {config['type']}")
270             
271             await session.initialize()
272             return session
273         except Exception as e:
274             logger.error(f"Failed to create ephemeral session: {e}")
275             raise ToolError(f"Could not create session for '{server_name}': {e}") from e
276 
277     async def wrap_mcp_tool(self, server_name: str, mcp_tool: MCPTool) -> AgentTool:
278         """
279         Wrap an MCPTool as an AgentTool with dynamic session creation at runtime,
280         based on stored server configuration.
281 
282         Args:
283             server_name: The MCP server that registered the tool.
284             mcp_tool: The MCPTool object describing the tool.
285 
286         Returns:
287             An AgentTool instance that can be executed by the agent.
288 
289         Raises:
290             ToolError: If the tool cannot be executed or configuration is missing.
291         """
292         tool_name = f"{server_name}_{mcp_tool.name}"
293         tool_docs = f"{mcp_tool.description or ''} (from MCP server: {server_name})"
294 
295         logger.debug(f"Wrapping MCP tool: {tool_name}")
296 
297         def build_executor(client: MCPClient, server_name: str, tool_name: str):
298             async def executor(**kwargs: Any) -> Any:
299                 """
300                 Execute the tool using a dynamically created session context.
301 
302                 Args:
303                     kwargs: Input arguments to the tool.
304 
305                 Returns:
306                     Result from the tool execution.
307 
308                 Raises:
309                     ToolError: If execution fails or response is malformed.
310                 """
311                 logger.info(f"[MCP] Executing tool '{tool_name}' with args: {kwargs}")
312                 try:
313                     async with client.create_session(server_name) as session:
314                         result = await session.call_tool(tool_name, kwargs)
315                         logger.debug(f"[MCP] Received result from tool '{tool_name}'")
316                         return client._process_tool_result(result)
317                 except Exception as e:
318                     logger.exception(f"Execution failed for '{tool_name}'")
319                     raise ToolError(f"Error executing tool '{tool_name}': {str(e)}") from e
320 
321             return executor
322 
323         # Build executor using dynamic context-managed session resolution
324         tool_func = build_executor(self, server_name, mcp_tool.name)
325 
326         # Optionally generate args model from input schema
327         args_model = None
328         if getattr(mcp_tool, "inputSchema", None):
329             try:
330                 from dapr_agents.tool.mcp.schema import create_pydantic_model_from_schema
331                 args_model = create_pydantic_model_from_schema(
332                     mcp_tool.inputSchema, f"{tool_name}Args"
333                 )
334                 logger.debug(f"Generated argument model for tool '{tool_name}'")
335             except Exception as e:
336                 logger.warning(f"Failed to create schema for tool '{tool_name}': {str(e)}")
337 
338         return AgentTool(
339             name=tool_name,
340             description=tool_docs,
341             func=tool_func,
342             args_model=args_model,
343         )
