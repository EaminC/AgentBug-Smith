│ cc = agent.structured_output(ContactCard, "Convert the following data to a contact card <input> John, last name Smith, who resides at 123       │
│ anytown usa, Texas, 78756, and is of age 38</input>")                                                                                           │
│                                                                                                                                                 │
│                                                                                                                                                 │
│ print(events) #Nothing populated here                                                                                                           │
