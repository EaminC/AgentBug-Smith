86     def __init__(self, api_key, model, temperature=0.7):
87         """
88         Initialize the OpenAI model.
89         Args:
90             api_key (str): The OpenAI API key.
91             model (str): The model with version.
92             temperature (float): The temperature value.
93         """
94         super().__init__()
95 
96         dependency = "openai"
97         spec = importlib.util.find_spec(dependency)
98         if spec is not None:
99             self.openai = importlib.import_module(dependency).OpenAI
100         else:
101             raise ImportError(
102                 "It seems you didn't install openai. In order to enable the OpenAI client related features, "
103                 "please make sure openai Python package has been installed. "
104                 "More information, please refer to: https://openai.com/product"
105             )
106 
107         self.model = model if model else 'gpt-4o-2024-08-06'
108         self.model_type = MODEL_OPENAI
109         self.temperature = temperature
110         self.client = self.openai(api_key=api_key)
111         self.func_call_history = []
112 
113     def query(self, chat_history, **kwargs):
114         """
115         Query the LLM model.
116 
117         Args:
118             chat_history: The context (chat history).
119         """
120         parameters = kwargs
121         completion = self.client.chat.completions.create(
122             model=self.model,
123             messages=chat_history,
124             temperature=self.temperature,
125             stream=False,
126             **parameters
127         )
128 
129         resp = completion.choices[0].message
130         if resp.function_call:
131             function_name = process_function_name(resp.function_call.name)
132             arguments = json.loads(resp.function_call.arguments)
133             print("[MLE FUNC CALL]: ", function_name)
134             self.func_call_history.append({"name": function_name, "arguments": arguments})
135             # avoid the multiple search function calls
136             search_attempts = [item for item in self.func_call_history if item['name'] in SEARCH_FUNCTIONS]
137             if len(search_attempts) > 3:
138                 parameters['function_call'] = "none"
139             result = get_function(function_name)(**arguments)
140             chat_history.append({"role": "assistant", "function_call": dict(resp.function_call)})
141             chat_history.append({"role": "function", "content": result, "name": function_name})
142             return self.query(chat_history, **parameters)
143         else:
144             return resp.content
145 
146     def stream(self, chat_history, **kwargs):
147         """
148         Stream the output from the LLM model.
149         Args:
150             chat_history: The context (chat history).
151         """
152         arguments = ''
153         function_name = ''
154         for chunk in self.client.chat.completions.create(
155                 model=self.model,
156                 messages=chat_history,
157                 temperature=self.temperature,
158                 stream=True,
159                 **kwargs
160         ):
161             delta = chunk.choices[0].delta
162             if delta.function_call:
163                 if delta.function_call.name:
164                     function_name = process_function_name(delta.function_call.name)
165                 if delta.function_call.arguments:
166                     arguments += delta.function_call.arguments
167 
168             if chunk.choices[0].finish_reason == "function_call":
169                 result = get_function(function_name)(**json.loads(arguments))
170                 chat_history.append({"role": "function", "content": result, "name": function_name})
171                 yield from self.stream(chat_history, **kwargs)
172             else:
173                 yield delta.content

