617 class Config(str, Enum):
618     """
619     Enumeration representing different configuration modes for the code processing system.
620 
621     Members:
622     - DEFAULT: Standard procedure for generating, executing, and reviewing code.
623     - BENCHMARK: Used for benchmarking the system's performance without execution.
624     - SIMPLE: A basic procedure involving generation, execution, and review.
625     - LITE: A lightweight procedure for generating code without further processing.
626     - CLARIFY: Process that starts with clarifying ambiguities before code generation.
627     - EXECUTE_ONLY: Only executes the code without generation.
628     - EVALUATE: Execute the code and then undergo a human review.
629     - USE_FEEDBACK: Uses prior feedback for code generation and subsequent steps.
630     - IMPROVE_CODE: Focuses on improving existing code based on a provided prompt.
631     - EVAL_IMPROVE_CODE: Validates files and improves existing code.
632     - EVAL_NEW_CODE: Evaluates newly generated code without further steps.
633 
634     Each configuration mode dictates the sequence and type of operations performed on the code.
635     """
636 
637     DEFAULT = "default"
638     BENCHMARK = "benchmark"
639     SIMPLE = "simple"
640     LITE = "lite"
641     CLARIFY = "clarify"
642     EXECUTE_ONLY = "execute_only"
643     EVALUATE = "evaluate"
644     USE_FEEDBACK = "use_feedback"
645     IMPROVE_CODE = "improve_code"
646     EVAL_IMPROVE_CODE = "eval_improve_code"
647     EVAL_NEW_CODE = "eval_new_code"
648 
649 
650 STEPS = {
651     Config.DEFAULT: [
652         simple_gen,
653         gen_entrypoint,
654         execute_entrypoint,
655         human_review,
656     ],
657     Config.LITE: [
658         lite_gen,
659     ],
660     Config.CLARIFY: [
661         clarify,
662         gen_clarified_code,
