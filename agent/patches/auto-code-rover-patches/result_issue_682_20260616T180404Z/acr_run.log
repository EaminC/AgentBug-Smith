504 def get_improve_prompt(ai: AI, dbs: DBs):
505     """
506     Asks the user what they would like to fix.
507     """
508 
509     if not dbs.input.get("prompt"):
510         dbs.input["prompt"] = input(
511             "\nWhat do you need to improve with the selected files?\n"
512         )
513 
514     confirm_str = "\n".join(
515         [
516             "-----------------------------",
517             "The following files will be used in the improvement process:",
518             f"{FILE_LIST_NAME}:",
519             colored(str(dbs.project_metadata[FILE_LIST_NAME]), "green"),
520             "",
521             "The inserted prompt is the following:",
522             colored(f"{dbs.input['prompt']}", "green"),
523             "-----------------------------",
524             "",
525             "You can change these files in your project before proceeding.",
526             "",
527             "Press enter to proceed with modifications.",
528             "",
529         ]
530     )
531     input(confirm_str)
532     return []
533 
534 
535 def improve_existing_code(ai: AI, dbs: DBs):
536     """
537     Process and improve the code from a specified set of existing files based on a user prompt.
538 
539     This function first retrieves the code from the designated files and then formats this
540     code to be processed by the Language Learning Model (LLM). After setting up the system prompt
541     for existing code improvements, the files' contents are sent to the LLM. Finally, the user's
542     prompt detailing desired improvements is passed to the LLM, and the subsequent response
543     from the LLM is used to overwrite the original files.
544 
545     Parameters:
546     - ai (AI): An instance of the AI model that is responsible for processing and generating
547       responses based on the provided system and user inputs.
548     - dbs (DBs): An instance containing the database configurations, user prompts, and project metadata.
549       It is used to fetch the selected files for improvement and the user's improvement prompt.
550 
551     Returns:
552     - list[Message]: Returns a list of Message objects that record the interaction between the
553       system, user, and the AI model. This includes both the input to and the response from the LLM.
554 
555     Notes:
556     - Ensure that the user has correctly set up the desired files for improvement and provided an
557       appropriate prompt before calling this function.
558     - The function expects the files to be formatted in a specific way to be properly processed by the LLM.
559     """
560 
561     """
562     After the file list and prompt have been aquired, this function is called
563     to sent the formatted prompt to the LLM.
564     """
565 
566     files_info = get_code_strings(
567         dbs.workspace, dbs.project_metadata
568     )  # this has file names relative to the workspace path
569 
570     messages = [
571         SystemMessage(content=setup_sys_prompt_existing_code(dbs)),
572     ]
573     # Add files as input
574     for file_name, file_str in files_info.items():
575         code_input = format_file_to_input(file_name, file_str)
576         messages.append(HumanMessage(content=f"{code_input}"))
577 
578     messages.append(HumanMessage(content=f"Request: {dbs.input['prompt']}"))
579 
580     messages = ai.next(messages, step_name=curr_fn())
581 
582     overwrite_files_with_edits(messages[-1].content.strip(), dbs)
583     return messages
584 
585 
586 def human_review(ai: AI, dbs: DBs):
587     """
588     Collects human feedback on the code and stores it in memory.
589 
590     This function prompts the user for a review of the generated or improved code using the `human_review_input`
591     function. If a valid review is provided, it's serialized to JSON format and stored within the database's
592     memory under the "review" key.
593 
594     Parameters:
595     - ai (AI): An instance of the AI model. Although not directly used within the function, it is kept as
596       a parameter for consistency with other functions.
597     - dbs (DBs): An instance containing the database configurations, user prompts, project metadata,
598       and memory storage. This function specifically interacts with the memory storage to save the human review.
599 
600     Returns:
601     - list: Returns an empty list, indicating that there's no subsequent interaction with the LLM
602       or no further messages to be processed.
603 
604     Notes:
605     - It's assumed that the `human_review_input` function handles all the interactions with the user to
606       gather feedback and returns either the feedback or None if no feedback was provided.
607     - Ensure that the database's memory has enough space or is set up correctly to store the serialized review data.
608     """
609 
610     """Collects and stores human review of the code"""
611     review = human_review_input()
612     if review is not None:
613         dbs.memory["review"] = review.to_json()  # type: ignore
614     return []
615 
