187 def clarify(ai: AI, dbs: DBs) -> List[Message]:
188     """
189     Interactively queries the user for clarifications on the prompt and saves the AI's responses.
190 
191     This function presents a series of clarifying questions to the user, based on the AI's
192     initial assessment of the provided prompt. The user can continue to interact and seek
193     clarifications until they indicate that they have "nothing to clarify" or manually
194     opt to move on. If the user doesn't provide any input, the AI is instructed to make its
195     own assumptions and to state them explicitly before proceeding.
196 
197     Parameters:
198     - ai (AI): An instance of the AI model.
199     - dbs (DBs): An instance containing the database configurations, which includes system
200       and input prompts.
201 
202     Returns:
203     - List[Message]: A list of message objects encapsulating the AI's generated output and
204       interactions.
205 
206     """
207     messages: List[Message] = [SystemMessage(content=dbs.preprompts["clarify"])]
208     user_input = dbs.input["prompt"]
209     while True:
210         messages = ai.next(messages, user_input, step_name=curr_fn())
211         msg = messages[-1].content.strip()
212 
213         if "nothing to clarify" in msg.lower():
214             break
215 
216         if msg.lower().startswith("no"):
217             print("Nothing to clarify.")
218             break
219 
220         print()
221         user_input = input('(answer in text, or "c" to move on)\n')
222         print()
223 
224         if not user_input or user_input == "c":
225             print("(letting gpt-engineer make its own assumptions)")
226             print()
227             messages = ai.next(
228                 messages,
229                 "Make your own assumptions and state them explicitly before starting",
230                 step_name=curr_fn(),
231             )
232             print()
233             return messages
234 
235         user_input += """
236             \n\n
237             Is anything else unclear? If yes, ask another question.\n
238             Otherwise state: "Nothing to clarify"
239             """
240 
241     print()
242     return messages
243 
244 
245 def gen_clarified_code(ai: AI, dbs: DBs) -> List[dict]:
246     """
247     Generates code based on clarifications obtained from the user.
248 
249     This function processes the messages logged during the user's clarification session
250     and uses them, along with the system's prompts, to guide the AI in generating code.
251     The generated code is saved to a specified workspace.
252 
253     Parameters:
254     - ai (AI): An instance of the AI model, responsible for processing and generating the code.
255     - dbs (DBs): An instance containing the database configurations, which includes system
256       and input prompts.
257 
258     Returns:
259     - List[dict]: A list of message dictionaries capturing the AI's interactions and generated
260       outputs during the code generation process.
261     """
262     messages = AI.deserialize_messages(dbs.logs[clarify.__name__])
263 
264     messages = [
265         SystemMessage(content=setup_sys_prompt(dbs)),
266     ] + messages[
267         1:
268     ]  # skip the first clarify message, which was the original clarify priming prompt
269     messages = ai.next(
270         messages,
271         dbs.preprompts["generate"].replace("FILE_FORMAT", dbs.preprompts["file_format"]),
272         step_name=curr_fn(),
273     )
274 
275     to_files_and_memory(messages[-1].content.strip(), dbs)
276     return messages
277 
278 
279 def execute_entrypoint(ai: AI, dbs: DBs) -> List[dict]:
280     """
281     Executes the specified entry point script (`run.sh`) from a workspace.
282 
283     This function prompts the user to confirm whether they wish to execute a script named
284     'run.sh' located in the specified workspace. If the user confirms, the script is
285     executed using a subprocess. The user is informed that they can interrupt the
286     execution at any time using ctrl+c.
287 
288     Parameters:
289     - ai (AI): An instance of the AI model, not directly used in this function but
290       included for consistency with other functions.
291     - dbs (DBs): An instance containing the database configurations and workspace
292       information.
293 
294     Returns:
295     - List[dict]: An empty list. This function does not produce a list of messages
296       but returns an empty list for consistency with the return type of other related
297       functions.
298 
299     Note:
300     The function assumes the presence of a 'run.sh' script in the specified workspace.
301     Ensure the script is available and that it has the appropriate permissions
302     (e.g., executable) before invoking this function.
303     """
304     command = dbs.workspace["run.sh"]
305 
306     print()
307     print(
308         colored(
309             "Do you want to execute this code? (Y/n)",
310             "red",
311         )
312     )
313     print()
314     print(command)
315     print()
316     if input().lower() not in ["", "y", "yes"]:
317         print("Ok, not executing the code.")
318         return []
319     print("Executing the code...")
320     print()
321     print(
322         colored(
323             "Note: If it does not work as expected, consider running the code"
324             + " in another way than above.",
325             "green",
326         )
327     )
328     print()
329     print("You can press ctrl+c *once* to stop the execution.")
330     print()
331 
332     p = subprocess.Popen("bash run.sh", shell=True, cwd=dbs.workspace.path)
333     try:
334         p.wait()
335     except KeyboardInterrupt:
336         print()
337         print("Stopping execution.")
338         print("Execution stopped.")
339         p.kill()
340         print()
341 
342     return []
343 
344 
345 def gen_entrypoint(ai: AI, dbs: DBs) -> List[dict]:
346     """
347     Generates an entry point script based on a given codebase's information.
348 
349     This function prompts the AI model to generate a series of Unix terminal commands
350     required to a) install dependencies and b) run all necessary components of a codebase
351     provided in the workspace. The generated commands are then saved to 'run.sh' in the
352     workspace.
353 
354     Parameters:
355     - ai (AI): An instance of the AI model.
356     - dbs (DBs): An instance containing the database configurations and workspace
357       information, particularly the 'all_output.txt' which contains details about the
358       codebase on disk.
359 
360     Returns:
361     - List[dict]: A list of messages containing the AI's response.
362 
363     Notes:
364     - The AI is instructed not to install packages globally, use 'sudo', provide
365       explanatory comments, or use placeholders. Instead, it should use example values
366       where necessary.
367     - The function uses regular expressions to extract command blocks from the AI's
368       response to create the 'run.sh' script.
369     - It assumes the presence of an 'all_output.txt' file in the specified workspace
370       that contains information about the codebase.
371     """
372     messages = ai.start(
373         system=(
374             "You will get information about a codebase that is currently on disk in "
375             "the current folder.\n"
376             "From this you will answer with code blocks that includes all the necessary "
377             "unix terminal commands to "
378             "a) install dependencies "
379             "b) run all necessary parts of the codebase (in parallel if necessary).\n"
380             "Do not install globally. Do not use sudo.\n"
381             "Do not explain the code, just give the commands.\n"
382             "Do not use placeholders, use example values (like . for a folder argument) "
383             "if necessary.\n"
384         ),
385         user="Information about the codebase:\n\n" + dbs.memory["all_output.txt"],
386         step_name=curr_fn(),
387     )
388     print()
389 
390     regex = r"```\S*\n(.+?)```"
391     matches = re.finditer(regex, messages[-1].content.strip(), re.DOTALL)
392     dbs.workspace["run.sh"] = "\n".join(match.group(1) for match in matches)
393     return messages
394 
395 
396 def use_feedback(ai: AI, dbs: DBs):
397     """
398     Uses the provided feedback to improve the generated code.
399 
400     This function takes in user feedback and applies it to modify previously
401     generated code. If feedback is available, the AI model is primed with the
402     system prompt and user instructions and then proceeds to process the feedback.
403     The modified code is then saved back to the workspace. If feedback is not found,
404     the user is informed to provide a 'feedback' file in the appropriate directory.
405 
406     Parameters:
407     - ai (AI): An instance of the AI model.
408     - dbs (DBs): An instance containing the database configurations and workspace
409       information, particularly the 'all_output.txt' which contains the previously
410       generated code, and 'input' which may contain the feedback from the user.
411 
412     Notes:
413     - The function assumes the feedback will be found in 'dbs.input["feedback"]'.
414     - If feedback is provided, the AI processes it and the resulting code is saved
415       back to the workspace.
416     - If feedback is absent, an instruction is printed to the console, and the program
417       terminates.
418     """
419     messages = [
420         SystemMessage(content=setup_sys_prompt(dbs)),
421         HumanMessage(content=f"Instructions: {dbs.input['prompt']}"),
422         AIMessage(
423             content=dbs.memory["all_output.txt"]
424         ),  # reload previously generated code
425     ]
426     if dbs.input["feedback"]:
427         messages = ai.next(messages, dbs.input["feedback"], step_name=curr_fn())
428         to_files_and_memory(messages[-1].content.strip(), dbs)
429         return messages
430     else:
431         print(
432             "No feedback was found in the input folder. Please create a file "
433             + "called 'feedback' in the same folder as the prompt file."
434         )
435         exit(1)
436 
437 
438 def set_improve_filelist(ai: AI, dbs: DBs):
439     """
440     Set the list of files for the AI to work with in the 'existing code mode'.
441 
442     This function initiates the process to determine which files from an existing
443     codebase the AI should work with. By calling `ask_for_files()`, it prompts for
444     and sets the specific files that should be considered, storing their full paths.
445 
446     Parameters:
447     - ai (AI): An instance of the AI model. Although passed to this function, it is
448       not used within the function scope and might be for consistency with other
449       function signatures.
450     - dbs (DBs): An instance containing the database configurations and project metadata,
451       which is used to gather information about the existing codebase. Additionally,
452       the 'input' is used to handle user interactions related to file selection.
453 
454     Returns:
455     - list: Returns an empty list, which can be utilized for consistency in return
456       types across related functions.
457 
458     Note:
459     - The selected file paths are stored as a side-effect of calling `ask_for_files()`,
460       and they aren't directly returned by this function.
461     """
462     """Sets the file list for files to work with in existing code mode."""
463     ask_for_files(dbs.project_metadata, dbs.workspace)  # stores files as full paths.
464     return []
