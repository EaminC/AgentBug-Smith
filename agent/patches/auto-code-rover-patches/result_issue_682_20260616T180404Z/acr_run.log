467 def assert_files_ready(ai: AI, dbs: DBs):
468     """
469     Verify the presence of required files for headless 'improve code' execution.
470 
471     This function checks the existence of 'file_list.txt' in the project metadata
472     and the presence of a 'prompt' in the input. If either of these checks fails,
473     an assertion error is raised to alert the user of the missing requirements.
474 
475     Parameters:
476     - ai (AI): An instance of the AI model. Although passed to this function, it is
477       not used within the function scope and might be for consistency with other
478       function signatures.
479     - dbs (DBs): An instance containing the database configurations and project metadata,
480       which is used to validate the required files' presence.
481 
482     Returns:
483     - list: Returns an empty list, which can be utilized for consistency in return
484       types across related functions.
485 
486     Raises:
487     - AssertionError: If 'file_list.txt' is not present in the project metadata
488       or if 'prompt' is not present in the input.
489 
490     Notes:
491     - This function is typically used in 'auto_mode' scenarios to ensure that the
492       necessary files are set up correctly before proceeding with the 'improve code'
493       operation.
494     """
495     """Checks that the required files are present for headless
496     improve code execution."""
497     assert (
498         "file_list.txt" in dbs.project_metadata
499     ), "For auto_mode file_list.txt need to be in your .gpteng folder."
500     assert "prompt" in dbs.input, "For auto_mode a prompt file must exist."
501     return []
502 
