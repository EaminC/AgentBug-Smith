682     def token_count(self, messages):
683         if type(messages) is list:
684             try:
685                 return litellm.token_counter(model=self.name, messages=messages)
686             except Exception as err:
687                 print(f"Unable to count tokens: {err}")
688                 return 0
689 
690         if not self.tokenizer:
691             return
692 
693         if type(messages) is str:
694             msgs = messages
695         else:
696             msgs = json.dumps(messages)
697 
