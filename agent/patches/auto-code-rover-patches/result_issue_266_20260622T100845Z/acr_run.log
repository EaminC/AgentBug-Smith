250     def delete(self, record_id: str, table_name: Optional[str] = None) -> bool:
251         """
252         Deletes a record from the specified memory table.
253 
254         Args:
255             record_id (str): The ID of the record to delete.
256             table_name (Optional[str]): The name of the table to delete the record from. Defaults to self.table_name.
257 
258         Returns:
