163     def __init__(self, project_path: str):
164         """
165         Memory: A base class for memory and external knowledge management.
166         Args:
167             project_path: the path to store the data.
168         """
169         self.db_name = '.mle'
170         self.table_name = 'memory'
171         self.client = lancedb.connect(uri=self.db_name)
172 
173         config = get_config(project_path)
174         if config["platform"] == "OpenAI":
175             self.text_embedding = get_registry().get("openai").create(api_key=config["api_key"])
176         else:
177             raise NotImplementedError
178 
179     def add(
180             self,
181             texts: List[str],
182             metadata: Optional[List[Dict]] = None,
183             table_name: Optional[str] = None,
184             ids: Optional[List[str]] = None,
185     ) -> List[str]:
186         """
187         Adds a list of text items to the specified memory table in the database.
188 
189         Args:
190             texts (List[str]): A list of text strings to be added.
191             metadata (Optional[List[Dict]]): A list of metadata to be added.
192             table_name (Optional[str]): The name of the table to add data to. Defaults to self.table_name.
193             ids (Optional[List[str]]): A list of unique IDs for the text items.
194                 If not provided, random UUIDs are generated.
195 
196         Returns:
197             List[str]: A list of IDs associated with the added text items.
198         """
199         if isinstance(texts, str):
200             texts = (texts,)
201 
202         if metadata is None:
203             metadata = [None, ] * len(texts)
204         elif isinstance(metadata, dict):
205             metadata = (metadata,)
206         else:
207             assert len(texts) == len(metadata)
208 
209         embeds = self.text_embedding.compute_source_embeddings(texts)
210 
211         table_name = table_name or self.table_name
212         ids = ids or [str(uuid.uuid4()) for _ in range(len(texts))]
213 
214         data = [
215             {
216                 "vector": embed,
217                 "text": text,
218                 "id": idx,
219                 "metadata": meta,
220             } for idx, text, embed, meta in zip(ids, texts, embeds, metadata)
221         ]
222 
223         if table_name not in self.client.table_names():
224             self.client.create_table(table_name, data=data)
225         else:
226             self.client.open_table(table_name).add(data=data)
227 
228         return ids
229 
230     def query(self, query_texts: List[str], table_name: Optional[str] = None, n_results: int = 5) -> List[List[dict]]:
231         """
232         Queries the specified memory table for similar text embeddings.
233 
234         Args:
235             query_texts (List[str]): A list of query text strings.
236             table_name (Optional[str]): The name of the table to query. Defaults to self.table_name.
237             n_results (int): The maximum number of results to retrieve per query. Default is 5.
238 
239         Returns:
240             List[List[dict]]: A list of results for each query text, each result being a dictionary with
241             keys such as "vector", "text", and "id".
242         """
243         table_name = table_name or self.table_name
244         table = self.client.open_table(table_name)
245         query_embeds = self.text_embedding.compute_source_embeddings(query_texts)
246 
247         results = [table.search(query).limit(n_results).to_list() for query in query_embeds]
248         return results
249 
250     def delete(self, record_id: str, table_name: Optional[str] = None) -> bool:
251         """
252         Deletes a record from the specified memory table.
253 
254         Args:
255             record_id (str): The ID of the record to delete.
256             table_name (Optional[str]): The name of the table to delete the record from. Defaults to self.table_name.
257 
258         Returns:
259             bool: True if the deletion was successful, False otherwise.
260         """
261         table_name = table_name or self.table_name
262         table = self.client.open_table(table_name)
263         return table.delete(f"id = '{record_id}'")
264 
265     def drop(self, table_name: Optional[str] = None) -> bool:
266         """
267         Drops (deletes) the specified memory table.
268 
269         Args:
270             table_name (Optional[str]): The name of the table to delete. Defaults to self.table_name.
271 
272         Returns:
273             bool: True if the table was successfully dropped, False otherwise.
274         """
275         table_name = table_name or self.table_name
276         return self.client.drop_table(table_name)
277 
278     def count(self, table_name: Optional[str] = None) -> int:
279         """
280         Counts the number of records in the specified memory table.
281 
282         Args:
283             table_name (Optional[str]): The name of the table to count records in. Defaults to self.table_name.
284 
285         Returns:
286             int: The number of records in the table.
287         """
288         table_name = table_name or self.table_name
289         table = self.client.open_table(table_name)
290         return table.count_rows()
291 
292     def reset(self) -> None:
293         """
294         Resets the memory by dropping the default memory table.
295         """
296         self.drop()

