240             List[List[dict]]: A list of results for each query text, each result being a dictionary with
241             keys such as "vector", "text", and "id".
242         """
243         table_name = table_name or self.table_name
244         table = self.client.open_table(table_name)
245         query_embeds = self.text_embedding.compute_source_embeddings(query_texts)
246 
247         results = [table.search(query).limit(n_results).to_list() for query in query_embeds]
248         return results
