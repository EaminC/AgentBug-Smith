209                 session_id=self.session_id,
210                 agent_id=agent.agent_id,
211                 offset=agent.conversation_manager.removed_message_count,
212             )
213             if len(session_messages) > 0:
214                 self._latest_agent_message[agent.agent_id] = session_messages[-1]
215 
216             # Restore the agents messages array including the optional prepend messages
217             agent.messages = prepend_messages + [session_message.to_message() for session_message in session_messages]
218 
219             # Fix broken session histories: https://github.com/strands-agents/sdk-python/issues/859
220             agent.messages = self._fix_broken_tool_use(agent.messages)
221 
222     def _fix_broken_tool_use(self, messages: list[Message]) -> list[Message]:
223         """Fix broken tool use/result pairs in message history.
224 
225         This method handles two issues:
226         1. Orphaned toolUse messages without corresponding toolResult.
227            Before 1.15.0, strands had a bug where they persisted sessions with a potentially broken messages array.
228            This method retroactively fixes that issue by adding a tool_result outside of session management.
229            After 1.15.0, this bug is no longer present.
230         2. Orphaned toolResult messages without corresponding toolUse (e.g., when pagination truncates messages)
231 
232         Args:
233             messages: The list of messages to fix
234             agent_id: The agent ID for fetching previous messages
235             removed_message_count: Number of messages removed by the conversation manager
236 
237         Returns:
238             Fixed list of messages with proper tool use/result pairs
239         """
240         # First, check if the oldest message has orphaned toolResult (no preceding toolUse) and remove it.
241         if messages:
242             first_message = messages[0]
243             if first_message["role"] == "user" and any("toolResult" in content for content in first_message["content"]):
244                 logger.warning(
245                     "Session message history starts with orphaned toolResult with no preceding toolUse. "
246                     "This typically happens when messages are truncated due to pagination limits. "
247                     "Removing orphaned toolResult message to maintain valid conversation structure."
248                 )
249                 messages.pop(0)
250 
251         # Then check for orphaned toolUse messages
252         for index, message in enumerate(messages):
253             # Check all but the latest message in the messages array
254             # The latest message being orphaned is handled in the agent class
255             if index + 1 < len(messages):
256                 if any("toolUse" in content for content in message["content"]):
257                     tool_use_ids = [
258                         content["toolUse"]["toolUseId"] for content in message["content"] if "toolUse" in content
259                     ]
260 
261                     # Check if there are more messages after the current toolUse message
262                     tool_result_ids = [
263                         content["toolResult"]["toolUseId"]
264                         for content in messages[index + 1]["content"]
265                         if "toolResult" in content
266                     ]
267 
268                     missing_tool_use_ids = list(set(tool_use_ids) - set(tool_result_ids))
269                     # If there are missing tool use ids, that means the messages history is broken
270                     if missing_tool_use_ids:
271                         logger.warning(
272                             "Session message history has an orphaned toolUse with no toolResult. "
273                             "Adding toolResult content blocks to create valid conversation."
274                         )
275                         # Create the missing toolResult content blocks
276                         missing_content_blocks = generate_missing_tool_result_content(missing_tool_use_ids)
277 
278                         if tool_result_ids:
279                             # If there were any toolResult ids, that means only some of the content blocks are missing
280                             messages[index + 1]["content"].extend(missing_content_blocks)
281                         else:
282                             # The message following the toolUse was not a toolResult, so lets insert it
283                             messages.insert(index + 1, {"role": "user", "content": missing_content_blocks})
284         return messages
285 
286     def sync_multi_agent(self, source: "MultiAgentBase", **kwargs: Any) -> None:
287         """Serialize and update the multi-agent state into the session repository.
288 
289         Args:
290             source: Multi-agent source object to sync to the session.
291             **kwargs: Additional keyword arguments for future extensibility.
292         """
293         self.session_repository.update_multi_agent(self.session_id, source)
294 
295     def initialize_multi_agent(self, source: "MultiAgentBase", **kwargs: Any) -> None:
296         """Initialize multi-agent state from the session repository.
297 
298         Args:
299             source: Multi-agent source object to restore state into
300             **kwargs: Additional keyword arguments for future extensibility.
301         """
302         state = self.session_repository.read_multi_agent(self.session_id, source.id, **kwargs)
303         if state is None:
304             self.session_repository.create_multi_agent(self.session_id, source, **kwargs)
305         else:
306             logger.debug("session_id=<%s> | restoring multi-agent state", self.session_id)
307             source.deserialize_state(state)
308 
309     def initialize_bidi_agent(self, agent: "BidiAgent", **kwargs: Any) -> None:
310         """Initialize a bidirectional agent with a session.
311 
312         Args:
313             agent: BidiAgent to initialize from the session
314             **kwargs: Additional keyword arguments for future extensibility.
315         """
316         if agent.agent_id in self._latest_agent_message:
317             raise SessionException("The `agent_id` of an agent must be unique in a session.")
318         self._latest_agent_message[agent.agent_id] = None
319 
320         session_agent = self.session_repository.read_agent(self.session_id, agent.agent_id)
321 
322         if session_agent is None:
323             logger.debug(
324                 "agent_id=<%s> | session_id=<%s> | creating bidi agent",
325                 agent.agent_id,
326                 self.session_id,
327             )
328 
329             session_agent = SessionAgent.from_bidi_agent(agent)
330             self.session_repository.create_agent(self.session_id, session_agent)
331             # Initialize messages with sequential indices
332             session_message = None
333             for i, message in enumerate(agent.messages):
334                 session_message = SessionMessage.from_message(message, i)
335                 self.session_repository.create_message(self.session_id, agent.agent_id, session_message)
336             self._latest_agent_message[agent.agent_id] = session_message
337         else:
338             logger.debug(
339                 "agent_id=<%s> | session_id=<%s> | restoring bidi agent",
340                 agent.agent_id,
341                 self.session_id,
342             )
343             agent.state = AgentState(session_agent.state)
344 
345             session_agent.initialize_bidi_internal_state(agent)
346 
347             # BidiAgent has no conversation_manager, so no prepend_messages or removed_message_count
348             session_messages = self.session_repository.list_messages(
349                 session_id=self.session_id,
350                 agent_id=agent.agent_id,
351                 offset=0,
352             )
353             if len(session_messages) > 0:
354                 self._latest_agent_message[agent.agent_id] = session_messages[-1]
355 
356             # Restore the agents messages array
357             agent.messages = [session_message.to_message() for session_message in session_messages]
358 
359             # Fix broken session histories: https://github.com/strands-agents/sdk-python/issues/859
360             agent.messages = self._fix_broken_tool_use(agent.messages)
361 
362     def append_bidi_message(self, message: Message, agent: "BidiAgent", **kwargs: Any) -> None:
363         """Append a message to the bidirectional agent's session.
364 
365         Args:
366             message: Message to add to the agent in the session
367             agent: BidiAgent to append the message to
368             **kwargs: Additional keyword arguments for future extensibility.
369         """
370         # Calculate the next index (0 if this is the first message, otherwise increment the previous index)
371         latest_agent_message = self._latest_agent_message[agent.agent_id]
372         if latest_agent_message:
373             next_index = latest_agent_message.message_id + 1
374         else:
375             next_index = 0
376 
377         session_message = SessionMessage.from_message(message, next_index)
378         self._latest_agent_message[agent.agent_id] = session_message
379         self.session_repository.create_message(self.session_id, agent.agent_id, session_message)
380 
381     def sync_bidi_agent(self, agent: "BidiAgent", **kwargs: Any) -> None:
382         """Serialize and update the bidirectional agent into the session repository.
383 
384         Args:
385             agent: BidiAgent to sync to the session.
386             **kwargs: Additional keyword arguments for future extensibility.
387         """
388         self.session_repository.update_agent(
389             self.session_id,
390             SessionAgent.from_bidi_agent(agent),
391         )

