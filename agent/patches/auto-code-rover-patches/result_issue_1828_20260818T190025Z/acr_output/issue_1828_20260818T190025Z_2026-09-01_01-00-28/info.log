295     def initialize_multi_agent(self, source: "MultiAgentBase", **kwargs: Any) -> None:
296         """Initialize multi-agent state from the session repository.
297 
298         Args:
299             source: Multi-agent source object to restore state into
300             **kwargs: Additional keyword arguments for future extensibility.
301         """
302         state = self.session_repository.read_multi_agent(self.session_id, source.id, **kwargs)
303         if state is None:
304             self.session_repository.create_multi_agent(self.session_id, source, **kwargs)
305         else:
306             logger.debug("session_id=<%s> | restoring multi-agent state", self.session_id)
307             source.deserialize_state(state)
