99     def sync_agent(self, agent: "Agent", **kwargs: Any) -> None:
100         """Serialize and update the agent into the session repository.
101 
102         Only updates the agent if state has been modified or internal state has changed.
103         This optimization reduces unnecessary I/O operations when the agent processes
104         messages without modifying its state.
105 
106         Args:
107             agent: Agent to sync to the session.
108             **kwargs: Additional keyword arguments for future extensibility.
109         """
110         # Get current versions and conversation manager state
111         current_state_version = agent.state._get_version()
112         current_interrupt_state_version = agent._interrupt_state._get_version()
113         current_conversation_manager_state = agent.conversation_manager.get_state()
114 
115         # Check if we have a previous state to compare against
116         last_synced = self._last_synced_internal_state.get(agent.agent_id)
117 
118         # Determine if we need to update by comparing versions
119         if last_synced is None:
120             # First sync for this agent - always update
121             state_changed = True
122             internal_state_changed = True
123             conversation_manager_state_changed = True
124         else:
125             state_changed = current_state_version != last_synced.get("state_version")
126             internal_state_changed = current_interrupt_state_version != last_synced.get("interrupt_state_version")
127             conversation_manager_state_changed = (
128                 current_conversation_manager_state != last_synced.get("conversation_manager_state")
129             )
130 
131         if not state_changed and not internal_state_changed and not conversation_manager_state_changed:
132             logger.debug(
133                 "agent_id=<%s> | session_id=<%s> | skipping sync, no changes detected",
134                 agent.agent_id,
135                 self.session_id,
136             )
137             return
138 
139         logger.debug(
140             "agent_id=<%s> | session_id=<%s> | state_changed=<%s>, internal_state_changed=<%s>, "
141             "conversation_manager_state_changed=<%s> | syncing agent",
142             agent.agent_id,
143             self.session_id,
144             state_changed,
145             internal_state_changed,
146             conversation_manager_state_changed,
147         )
148 
149         # Perform the update
150         self.session_repository.update_agent(
151             self.session_id,
152             SessionAgent.from_agent(agent),
153         )
154 
155         # Update tracked versions after successful sync
156         self._last_synced_internal_state[agent.agent_id] = {
157             "state_version": current_state_version,
158             "interrupt_state_version": current_interrupt_state_version,
159             "conversation_manager_state": copy.deepcopy(current_conversation_manager_state),
160         }
161 
162     def initialize(self, agent: "Agent", **kwargs: Any) -> None:
163         """Initialize an agent with a session.
164 
165         Args:
166             agent: Agent to initialize from the session
167             **kwargs: Additional keyword arguments for future extensibility.
168         """
169         if agent.agent_id in self._latest_agent_message:
170             raise SessionException("The `agent_id` of an agent must be unique in a session.")
171         self._latest_agent_message[agent.agent_id] = None
172 
173         session_agent = self.session_repository.read_agent(self.session_id, agent.agent_id)
174 
175         if session_agent is None:
176             logger.debug(
177                 "agent_id=<%s> | session_id=<%s> | creating agent",
178                 agent.agent_id,
179                 self.session_id,
180             )
181 
182             session_agent = SessionAgent.from_agent(agent)
183             self.session_repository.create_agent(self.session_id, session_agent)
184             # Initialize messages with sequential indices
185             session_message = None
186             for i, message in enumerate(agent.messages):
187                 session_message = SessionMessage.from_message(message, i)
188                 self.session_repository.create_message(self.session_id, agent.agent_id, session_message)
189             self._latest_agent_message[agent.agent_id] = session_message
190         else:
191             logger.debug(
192                 "agent_id=<%s> | session_id=<%s> | restoring agent",
193                 agent.agent_id,
194                 self.session_id,
195             )
196             agent.state = AgentState(session_agent.state)
197 
198             session_agent.initialize_internal_state(agent)
199 
200             # Restore the conversation manager to its previous state, and get the optional prepend messages
201             prepend_messages = agent.conversation_manager.restore_from_session(session_agent.conversation_manager_state)
202 
203             if prepend_messages is None:
204                 prepend_messages = []
205 
206             # List the messages currently in the session, using an offset of the messages previously removed
207             # by the conversation manager.
208             session_messages = self.session_repository.list_messages(
209                 session_id=self.session_id,
210                 agent_id=agent.agent_id,
211                 offset=agent.conversation_manager.removed_message_count,
212             )
213             if len(session_messages) > 0:
214                 self._latest_agent_message[agent.agent_id] = session_messages[-1]
215 
216             # Restore the agents messages array including the optional prepend messages
217             agent.messages = prepend_messages + [session_message.to_message() for session_message in session_messages]
218 
219             # Fix broken session histories: https://github.com/strands-agents/sdk-python/issues/859
220             agent.messages = self._fix_broken_tool_use(agent.messages)
221 
222     def _fix_broken_tool_use(self, messages: list[Message]) -> list[Message]:
223         """Fix broken tool use/result pairs in message history.
224 
225         This method handles two issues:
226         1. Orphaned toolUse messages without corresponding toolResult.
227            Before 1.15.0, strands had a bug where they persisted sessions with a potentially broken messages array.
228            This method retroactively fixes that issue by adding a tool_result outside of session management.
229            After 1.15.0, this bug is no longer present.
230         2. Orphaned toolResult messages without corresponding toolUse (e.g., when pagination truncates messages)
231 
232         Args:
233             messages: The list of messages to fix
234             agent_id: The agent ID for fetching previous messages
235             removed_message_count: Number of messages removed by the conversation manager
236 
237         Returns:
238             Fixed list of messages with proper tool use/result pairs
239         """
240         # First, check if the oldest message has orphaned toolResult (no preceding toolUse) and remove it.
241         if messages:
242             first_message = messages[0]
243             if first_message["role"] == "user" and any("toolResult" in content for content in first_message["content"]):
244                 logger.warning(
245                     "Session message history starts with orphaned toolResult with no preceding toolUse. "
246                     "This typically happens when messages are truncated due to pagination limits. "
247                     "Removing orphaned toolResult message to maintain valid conversation structure."
248                 )
249                 messages.pop(0)
250 
251         # Then check for orphaned toolUse messages
252         for index, message in enumerate(messages):
253             # Check all but the latest message in the messages array
254             # The latest message being orphaned is handled in the agent class
255             if index + 1 < len(messages):
256                 if any("toolUse" in content for content in message["content"]):
257                     tool_use_ids = [
258                         content["toolUse"]["toolUseId"] for content in message["content"] if "toolUse" in content
259                     ]
260 
261                     # Check if there are more messages after the current toolUse message
262                     tool_result_ids = [
263                         content["toolResult"]["toolUseId"]
264                         for content in messages[index + 1]["content"]
265                         if "toolResult" in content
266                     ]
267 
268                     missing_tool_use_ids = list(set(tool_use_ids) - set(tool_result_ids))
269                     # If there are missing tool use ids, that means the messages history is broken
270                     if missing_tool_use_ids:
271                         logger.warning(
272                             "Session message history has an orphaned toolUse with no toolResult. "
273                             "Adding toolResult content blocks to create valid conversation."
274                         )
275                         # Create the missing toolResult content blocks
276                         missing_content_blocks = generate_missing_tool_result_content(missing_tool_use_ids)
277 
278                         if tool_result_ids:
279                             # If there were any toolResult ids, that means only some of the content blocks are missing
280                             messages[index + 1]["content"].extend(missing_content_blocks)
281                         else:
282                             # The message following the toolUse was not a toolResult, so lets insert it
283                             messages.insert(index + 1, {"role": "user", "content": missing_content_blocks})
284         return messages
285 
286     def sync_multi_agent(self, source: "MultiAgentBase", **kwargs: Any) -> None:
