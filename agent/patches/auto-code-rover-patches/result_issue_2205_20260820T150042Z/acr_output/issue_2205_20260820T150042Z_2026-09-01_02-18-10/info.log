20 class SlidingWindowConversationManager(ConversationManager):
21     """Implements a sliding window strategy for managing conversation history.
22 
23     This class handles the logic of maintaining a conversation window that preserves tool usage pairs and avoids
24     invalid window states.
25 
26     When truncation is enabled (the default), large tool results are partially truncated, preserving the first
27     and last 200 characters, and image blocks inside tool results are replaced with descriptive text placeholders.
28     Truncation targets the oldest tool results first so the most relevant recent context is preserved as long
29     as possible.
30 
31     Supports proactive management during agent loop execution via the per_turn parameter.
32     """
33 
34     def __init__(
35         self,
36         window_size: int = 40,
37         should_truncate_results: bool = True,
38         *,
39         per_turn: bool | int = False,
40     ):
41         """Initialize the sliding window conversation manager.
42 
43         Args:
44             window_size: Maximum number of messages to keep in the agent's history.
45                 Defaults to 40 messages.
46             should_truncate_results: Truncate tool results when a message is too large for the model's context window
47             per_turn: Controls when to apply message management during agent execution.
48                 - False (default): Only apply management at the end (default behavior)
49                 - True: Apply management before every model call
50                 - int (e.g., 3): Apply management before every N model calls
51 
52                 When to use per_turn: If your agent performs many tool operations in loops
53                 (e.g., web browsing with frequent screenshots), enable per_turn to proactively
54                 manage message history and prevent the agent loop from slowing down. Start with
55                 per_turn=True and adjust to a specific frequency (e.g., per_turn=5) if needed
56                 for performance tuning.
57 
58         Raises:
59             ValueError: If per_turn is 0 or a negative integer.
60         """
61         if isinstance(per_turn, int) and not isinstance(per_turn, bool) and per_turn <= 0:
62             raise ValueError(f"per_turn must be a positive integer, True, or False, got {per_turn}")
63 
64         super().__init__()
65 
66         self.window_size = window_size
67         self.should_truncate_results = should_truncate_results
68         self.per_turn = per_turn
69         self._model_call_count = 0
70 
71     def register_hooks(self, registry: "HookRegistry", **kwargs: Any) -> None:
72         """Register hook callbacks for per-turn conversation management.
73 
74         Args:
75             registry: The hook registry to register callbacks with.
76             **kwargs: Additional keyword arguments for future extensibility.
77         """
78         super().register_hooks(registry, **kwargs)
79 
80         # Always register the callback - per_turn check happens in the callback
81         registry.add_callback(BeforeModelCallEvent, self._on_before_model_call)
82 
83     def _on_before_model_call(self, event: BeforeModelCallEvent) -> None:
84         """Handle before model call event for per-turn management.
85 
86         This callback is invoked before each model call. It tracks the model call count and applies message management
87         based on the per_turn configuration.
88 
89         Args:
90             event: The before model call event containing the agent and model execution details.
91         """
92         # Check if per_turn is enabled
93         if self.per_turn is False:
94             return
95 
96         self._model_call_count += 1
97 
98         # Determine if we should apply management
99         should_apply = False
100         if self.per_turn is True:
101             should_apply = True
102         elif isinstance(self.per_turn, int) and self.per_turn > 0:
103             should_apply = self._model_call_count % self.per_turn == 0
104 
105         if should_apply:
106             logger.debug(
107                 "model_call_count=<%d>, per_turn=<%s> | applying per-turn conversation management",
108                 self._model_call_count,
109                 self.per_turn,
110             )
111             self.apply_management(event.agent)
112 
113     def get_state(self) -> dict[str, Any]:
114         """Get the current state of the conversation manager.
115 
116         Returns:
117             Dictionary containing the manager's state, including model call count for per-turn tracking.
118         """
119         state = super().get_state()
120         state["model_call_count"] = self._model_call_count
121         return state
122 
123     def restore_from_session(self, state: dict[str, Any]) -> list | None:
124         """Restore the conversation manager's state from a session.
125 
126         Args:
127             state: Previous state of the conversation manager
128 
129         Returns:
130             Optional list of messages to prepend to the agent's messages.
131         """
132         result = super().restore_from_session(state)
133         self._model_call_count = state.get("model_call_count", 0)
134         return result
135 
136     def apply_management(self, agent: "Agent", **kwargs: Any) -> None:
137         """Apply the sliding window to the agent's messages array to maintain a manageable history size.
138 
139         This method is called after every event loop cycle to apply a sliding window if the message count
140         exceeds the window size.
141 
142         Args:
143             agent: The agent whose messages will be managed.
144                 This list is modified in-place.
145             **kwargs: Additional keyword arguments for future extensibility.
146         """
147         messages = agent.messages
148 
149         if len(messages) <= self.window_size:
150             logger.debug(
151                 "message_count=<%s>, window_size=<%s> | skipping context reduction", len(messages), self.window_size
152             )
153             return
154         self.reduce_context(agent)
155 
156     def reduce_context(self, agent: "Agent", e: Exception | None = None, **kwargs: Any) -> None:
157         """Trim the oldest messages to reduce the conversation context size.
158 
159         The method handles special cases where trimming the messages leads to:
160          - toolResult with no corresponding toolUse
161          - toolUse with no corresponding toolResult
162 
163         Args:
164             agent: The agent whose messages will be reduce.
165                 This list is modified in-place.
166             e: The exception that triggered the context reduction, if any.
167             **kwargs: Additional keyword arguments for future extensibility.
168 
169         Raises:
170             ContextWindowOverflowException: If the context cannot be reduced further and a context overflow
171                 error was provided (e is not None). When called during routine window management (e is None),
172                 logs a warning and returns without modification.
173         """
174         messages = agent.messages
175 
176         # Try to truncate the tool result first
177         oldest_message_idx_with_tool_results = self._find_oldest_message_with_tool_results(messages)
178         if oldest_message_idx_with_tool_results is not None and self.should_truncate_results:
179             logger.debug(
180                 "message_index=<%s> | found message with tool results at index", oldest_message_idx_with_tool_results
181             )
182             results_truncated = self._truncate_tool_results(messages, oldest_message_idx_with_tool_results)
183             if results_truncated:
184                 logger.debug("message_index=<%s> | tool results truncated", oldest_message_idx_with_tool_results)
185                 return
186 
187         # Try to trim index id when tool result cannot be truncated anymore
188         # If the number of messages is less than the window_size, then we default to 2, otherwise, trim to window size
189         trim_index = 2 if len(messages) <= self.window_size else len(messages) - self.window_size
190 
191         # Find the next valid trim point that:
192         # 1. Starts with a user message (required by most model providers)
193         # 2. Does not start with an orphaned toolResult
194         # 3. Does not start with a toolUse unless its toolResult immediately follows
195         # Falls back to an assistant(toolUse) + user(toolResult) boundary if no plain user message exists.
196         # This is acceptable because providers treat a complete toolUse/toolResult pair as a valid
197         # conversation continuation, and without this fallback tool-heavy conversations cannot be trimmed.
198         fallback_trim_index = None
199 
200         while trim_index < len(messages):
201             # Prefer starting with a user message
202             if messages[trim_index]["role"] != "user":
203                 # Track first valid assistant(toolUse) + user(toolResult) pair as fallback
204                 if (
205                     fallback_trim_index is None
206                     and any("toolUse" in content for content in messages[trim_index]["content"])
207                     and trim_index + 1 < len(messages)
208                     and messages[trim_index + 1]["role"] == "user"
209                     and any("toolResult" in content for content in messages[trim_index + 1]["content"])
210                 ):
211                     fallback_trim_index = trim_index
212 
213                 trim_index += 1
214                 continue
215 
216             if (
217                 # Oldest message cannot be a toolResult because it needs a toolUse preceding it
218                 any("toolResult" in content for content in messages[trim_index]["content"])
219                 or (
220                     # Oldest message can be a toolUse only if a toolResult immediately follows it.
221                     # Note: toolUse content normally appears only in assistant messages, but this
222                     # check is kept as a defensive safeguard for non-standard message formats.
223                     any("toolUse" in content for content in messages[trim_index]["content"])
224                     and not (
225                         trim_index + 1 < len(messages)
226                         and any("toolResult" in content for content in messages[trim_index + 1]["content"])
227                     )
228                 )
229             ):
230                 trim_index += 1
231             else:
232                 break
233         else:
234             # No plain user message found — use assistant+toolResult fallback if available
235             if fallback_trim_index is not None:
236                 logger.debug(
237                     "trim_index=<%s> | no plain user message trim point found, "
238                     "falling back to assistant(toolUse) + user(toolResult) boundary",
239                     fallback_trim_index,
240                 )
241                 trim_index = fallback_trim_index
242             elif e is not None:
243                 raise ContextWindowOverflowException("Unable to trim conversation context!") from e
244             else:
245                 logger.warning(
246                     "window_size=<%s>, message_count=<%s> | unable to trim conversation context, "
247                     "no valid trim point found",
248                     self.window_size,
249                     len(messages),
250                 )
251                 return
252 
253         # trim_index represents the number of messages being removed from the agents messages array
254         self.removed_message_count += trim_index
255 
256         # Overwrite message history
257         messages[:] = messages[trim_index:]
258 
259     def _truncate_tool_results(self, messages: Messages, msg_idx: int) -> bool:
260         """Truncate tool results and replace image blocks in a message to reduce context size.
261 
262         For text blocks within tool results, all blocks are partially truncated unless they
263         have already been truncated. The first and last _PRESERVE_CHARS characters are kept,
264         and the removed middle is replaced with a notice indicating how many characters were
265         removed. The tool result status is not changed.
266 
267         Image blocks nested inside tool result content are replaced with a short descriptive placeholder.
268 
269         Args:
270             messages: The conversation message history.
271             msg_idx: Index of the message containing tool results to truncate.
272 
273         Returns:
274             True if any changes were made to the message, False otherwise.
275         """
276         if msg_idx >= len(messages) or msg_idx < 0:
277             return False
278 
279         def _image_placeholder(image_block: Any) -> str:
280             source: Any = image_block.get("source", {})
281             media_type = image_block.get("format", "unknown")
282             data = source.get("bytes", b"")
283             return f"[image: {media_type}, {len(data) if data else 0} bytes]"
284 
285         message = messages[msg_idx]
286         changes_made = False
287         new_content: list[ContentBlock] = []
288 
289         for content in message.get("content", []):
290             if "toolResult" in content:
291                 tool_result: Any = content["toolResult"]
292                 tool_result_items = tool_result.get("content", [])
293                 new_items: list[ToolResultContent] = []
294                 item_changed = False
295 
296                 for item in tool_result_items:
297                     # Replace image items nested inside toolResult content
298                     if "image" in item:
299                         new_items.append({"text": _image_placeholder(item["image"])})
300                         item_changed = True
301                         continue
302 
303                     # Partially truncate text items that have not already been truncated
304                     if "text" in item:
305                         text = item["text"]
306                         truncation_marker = "... [truncated:"
307                         if truncation_marker not in text and len(text) > 2 * _PRESERVE_CHARS:
308                             prefix = text[:_PRESERVE_CHARS]
309                             suffix = text[-_PRESERVE_CHARS:]
310                             removed = len(text) - 2 * _PRESERVE_CHARS
311                             truncated_text = (
312                                 f"{prefix}...\n\n... [truncated: {removed} chars removed] ...\n\n...{suffix}"
313                             )
314                             new_items.append({"text": truncated_text})
315                             item_changed = True
316                             continue
317 
318                     new_items.append(item)
319 
320                 if item_changed:
321                     updated_tool_result: Any = {
322                         **{k: v for k, v in tool_result.items() if k != "content"},
323                         "content": new_items,
324                     }
325                     new_content.append({"toolResult": updated_tool_result})
326                     changes_made = True
327                 else:
328                     new_content.append(content)
329                 continue
330 
331             new_content.append(content)
332 
333         if changes_made:
334             message["content"] = new_content
335 
336         return changes_made
337 
338     def _find_oldest_message_with_tool_results(self, messages: Messages) -> int | None:
339         """Find the index of the oldest message containing tool results.
340 
341         Iterates from oldest to newest so that truncation targets the least-recent
342         (and therefore least relevant) tool results first.
343 
344         Args:
345             messages: The conversation message history.
346 
347         Returns:
348             Index of the oldest message with tool results, or None if no such message exists.
349         """
350         # Iterate from oldest to newest
351         for idx in range(len(messages)):
352             current_message = messages[idx]
353             for content in current_message.get("content", []):
354                 if isinstance(content, dict) and "toolResult" in content:
355                     return idx
356 
357         return None

