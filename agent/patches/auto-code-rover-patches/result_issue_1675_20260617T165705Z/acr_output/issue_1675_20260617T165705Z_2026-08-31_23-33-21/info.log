994         else:
995             map_tokens = 0
996             map_mul_no_files = 1
997 
998         raise SwitchCoder(
999             edit_format=self.coder.edit_format,
1000             summarize_from_coder=False,
1001             from_coder=coder,
1002             map_tokens=map_tokens,
1003             map_mul_no_files=map_mul_no_files,
1004             show_announcements=False,
