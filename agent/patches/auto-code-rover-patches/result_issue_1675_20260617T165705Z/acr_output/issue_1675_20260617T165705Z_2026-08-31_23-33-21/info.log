1159     def cmd_read_only(self, args):
1160         "Add files to the chat that are for reference, not to be edited"
1161         if not args.strip():
1162             self.io.tool_error("Please provide filenames or directories to read.")
1163             return
1164 
1165         filenames = parse_quoted_filenames(args)
1166         for pattern in filenames:
1167             # Expand tilde for home directory
1168             expanded_pattern = expanduser(pattern)
1169 
1170             expanded_paths = glob.glob(expanded_pattern, recursive=True)
1171             if not expanded_paths:
1172                 self.io.tool_error(f"No matches found for: {pattern}")
1173                 continue
1174 
1175             for path in expanded_paths:
1176                 abs_path = self.coder.abs_root_path(path)
1177                 if os.path.isfile(abs_path):
1178                     self._add_read_only_file(abs_path, path)
1179                 elif os.path.isdir(abs_path):
1180                     self._add_read_only_directory(abs_path, path)
1181                 else:
1182                     self.io.tool_error(f"Not a file or directory: {abs_path}")
