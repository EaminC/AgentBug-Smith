550     def raw_cmd_diff(self, args=""):
551         if not self.coder.repo:
552             self.io.tool_error("No git repository found.")
553             return
554 
555         current_head = self.coder.repo.get_head_commit_sha()
556         if current_head is None:
557             self.io.tool_error("Unable to get current commit. The repository might be empty.")
558             return
559 
560         if len(self.coder.commit_before_message) < 2:
561             commit_before_message = current_head + "^"
562         else:
563             commit_before_message = self.coder.commit_before_message[-2]
564 
565         if not commit_before_message or commit_before_message == current_head:
566             self.io.tool_warning("No changes to display since the last message.")
567             return
568 
569         self.io.tool_output(f"Diff since {commit_before_message[:7]}...")
570 
571         diff = self.coder.repo.diff_commits(
572             self.coder.pretty,
573             commit_before_message,
574             "HEAD",
575         )
576 
577         self.io.print(diff)
