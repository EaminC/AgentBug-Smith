772     def cmd_drop(self, args=""):
773         "Remove files from the chat session to free up context space"
774 
775         if not args.strip():
776             self.io.tool_output("Dropping all files from the chat session.")
777             self._drop_all_files()
778             return
779 
780         filenames = parse_quoted_filenames(args)
781         for word in filenames:
782             # Expand tilde in the path
783             expanded_word = os.path.expanduser(word)
784 
785             # Handle read-only files separately, without glob_filtered_to_repo
786             read_only_matched = [f for f in self.coder.abs_read_only_fnames if expanded_word in f]
787 
788             if read_only_matched:
789                 for matched_file in read_only_matched:
790                     self.coder.abs_read_only_fnames.remove(matched_file)
791                     self.io.tool_output(f"Removed read-only file {matched_file} from the chat")
792 
793             matched_files = self.glob_filtered_to_repo(expanded_word)
794 
795             if not matched_files:
796                 matched_files.append(expanded_word)
797 
798             for matched_file in matched_files:
799                 abs_fname = self.coder.abs_root_path(matched_file)
800                 if abs_fname in self.coder.abs_fnames:
801                     self.coder.abs_fnames.remove(abs_fname)
802                     self.io.tool_output(f"Removed {matched_file} from the chat")
803 
