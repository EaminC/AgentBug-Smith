941     def basic_help(self):
942         commands = sorted(self.get_commands())
943         pad = max(len(cmd) for cmd in commands)
944         pad = "{cmd:" + str(pad) + "}"
945         for cmd in commands:
946             cmd_method_name = f"cmd_{cmd[1:]}".replace("-", "_")
947             cmd_method = getattr(self, cmd_method_name, None)
948             cmd = pad.format(cmd=cmd)
949             if cmd_method:
950                 description = cmd_method.__doc__
951                 self.io.tool_output(f"{cmd} {description}")
952             else:
953                 self.io.tool_output(f"{cmd} No description available.")
954         self.io.tool_output()
955         self.io.tool_output("Use `/help <question>` to ask questions about how to use aider.")
