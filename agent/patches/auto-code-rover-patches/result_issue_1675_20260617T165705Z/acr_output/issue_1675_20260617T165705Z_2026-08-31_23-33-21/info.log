830     def cmd_test(self, args):
831         "Run a shell command and add the output to the chat on non-zero exit code"
832         if not args and self.coder.test_cmd:
833             args = self.coder.test_cmd
834 
835         if not args:
836             return
837 
838         if not callable(args):
839             if type(args) is not str:
840                 raise ValueError(repr(args))
841             return self.cmd_run(args, True)
