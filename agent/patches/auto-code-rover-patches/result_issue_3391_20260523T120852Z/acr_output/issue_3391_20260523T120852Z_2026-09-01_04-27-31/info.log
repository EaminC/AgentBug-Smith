72     def _create_long_term_memory(self, output) -> None:
73         """Create and save long-term and entity memory items based on evaluation."""
74         if (
75             self.crew
76             and self.crew._long_term_memory
77             and self.crew._entity_memory
78             and self.task
79             and self.agent
80         ):
81             try:
82                 ltm_agent = TaskEvaluator(self.agent)
83                 evaluation = ltm_agent.evaluate(self.task, output.text)
84 
85                 if isinstance(evaluation, ConverterError):
86                     return
87 
88                 long_term_memory = LongTermMemoryItem(
89                     task=self.task.description,
90                     agent=self.agent.role,
91                     quality=evaluation.quality,
92                     datetime=str(time.time()),
93                     expected_output=self.task.expected_output,
94                     metadata={
95                         "suggestions": evaluation.suggestions,
96                         "quality": evaluation.quality,
97                     },
98                 )
99                 self.crew._long_term_memory.save(long_term_memory)
100 
101                 entity_memories = [
102                     EntityMemoryItem(
103                         name=entity.name,
104                         type=entity.type,
105                         description=entity.description,
106                         relationships="\n".join(
107                             [f"- {r}" for r in entity.relationships]
108                         ),
109                     )
110                     for entity in evaluation.entities
111                 ]
112                 if entity_memories:
113                     self.crew._entity_memory.save(entity_memories)
114             except AttributeError as e:
115                 print(f"Missing attributes for long term memory: {e}")
116                 pass
117             except Exception as e:
118                 print(f"Failed to add to long term memory: {e}")
119                 pass
120         elif (
121             self.crew
122             and self.crew._long_term_memory
123             and self.crew._entity_memory is None
124         ):
125             self._printer.print(
126                 content="Long term memory is enabled, but entity memory is not enabled. Please configure entity memory or set memory=True to automatically enable it.",
127                 color="bold_yellow",
128             )
129 
130     def _ask_human_input(self, final_answer: str) -> str:
131         """Prompt human input with mode-appropriate messaging."""
132         event_listener.formatter.pause_live_updates()
133         try:
134             self._printer.print(
135                 content=f"\033[1m\033[95m ## Final Result:\033[00m \033[92m{final_answer}\033[00m"
136             )
137 
138             # Training mode prompt (single iteration)
139             if self.crew and getattr(self.crew, "_train", False):
140                 prompt = (
141                     "\n\n=====\n"
142                     "## TRAINING MODE: Provide feedback to improve the agent's performance.\n"
143                     "This will be used to train better versions of the agent.\n"
144                     "Please provide detailed feedback about the result quality and reasoning process.\n"
145                     "=====\n"
146                 )
147             # Regular human-in-the-loop prompt (multiple iterations)
148             else:
149                 prompt = (
150                     "\n\n=====\n"
151                     "## HUMAN FEEDBACK: Provide feedback on the Final Result and Agent's actions.\n"
152                     "Please follow these guidelines:\n"
153                     " - If you are happy with the result, simply hit Enter without typing anything.\n"
154                     " - Otherwise, provide specific improvement requests.\n"
155                     " - You can provide multiple rounds of feedback until satisfied.\n"
156                     "=====\n"
157                 )
158 
159             self._printer.print(content=prompt, color="bold_yellow")
160             response = input()
161             if response.strip() != "":
162                 self._printer.print(
163                     content="\nProcessing your feedback...", color="cyan"
164                 )
165             return response
166         finally:
167             event_listener.formatter.resume_live_updates()

