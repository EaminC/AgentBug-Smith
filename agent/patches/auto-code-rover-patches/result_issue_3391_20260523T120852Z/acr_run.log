12 class Mem0Storage(Storage):
13     """
14     Extends Storage to handle embedding and searching across entities using Mem0.
15     """
16     def __init__(self, type, crew=None, config=None):
17         super().__init__()
18 
19         self._validate_type(type)
20         self.memory_type = type
21         self.crew = crew
22         self.config = config or {}
23 
24         self._extract_config_values()
25         self._initialize_memory()
26 
27     def _validate_type(self, type):
28         supported_types = {"short_term", "long_term", "entities", "external"}
29         if type not in supported_types:
30             raise ValueError(
31                 f"Invalid type '{type}' for Mem0Storage. Must be one of: {', '.join(supported_types)}"
32             )
33 
34     def _extract_config_values(self):
35         self.mem0_run_id = self.config.get("run_id")
36         self.includes = self.config.get("includes")
37         self.excludes = self.config.get("excludes")
38         self.custom_categories = self.config.get("custom_categories")
39         self.infer = self.config.get("infer", True)
40 
41     def _initialize_memory(self):
42         api_key = self.config.get("api_key") or os.getenv("MEM0_API_KEY")
43         org_id = self.config.get("org_id")
44         project_id = self.config.get("project_id")
45         local_config = self.config.get("local_mem0_config")
46 
47         if api_key:
48             self.memory = (
49                 MemoryClient(api_key=api_key, org_id=org_id, project_id=project_id)
50                 if org_id and project_id
51                 else MemoryClient(api_key=api_key)
52             )
53             if self.custom_categories:
54                 self.memory.update_project(custom_categories=self.custom_categories)
55         else:
56             self.memory = (
57                 Memory.from_config(local_config)
58                 if local_config and len(local_config)
59                 else Memory()
60             )
61 
62     def _create_filter_for_search(self):
63         """
64         Returns:
65             dict: A filter dictionary containing AND conditions for querying data.
66                 - Includes user_id and agent_id if both are present.
67                 - Includes user_id if only user_id is present.
68                 - Includes agent_id if only agent_id is present.
69                 - Includes run_id if memory_type is 'short_term' and mem0_run_id is present.
70         """
71         filter = defaultdict(list)
72 
73         if self.memory_type == "short_term" and self.mem0_run_id:
74             filter["AND"].append({"run_id": self.mem0_run_id})
75         else:
76             user_id = self.config.get("user_id", "")
77             agent_id = self.config.get("agent_id", "")
78 
79             if user_id and agent_id:
80                 filter["OR"].append({"user_id": user_id})
81                 filter["OR"].append({"agent_id": agent_id})
82             elif user_id:
83                 filter["AND"].append({"user_id": user_id})
84             elif agent_id:
85                 filter["AND"].append({"agent_id": agent_id})
86 
87         return filter
88 
89     def save(self, value: Any, metadata: Dict[str, Any]) -> None:
90         user_id = self.config.get("user_id", "")
91         assistant_message = [{"role" : "assistant","content" : value}]
92 
93         base_metadata = {
94             "short_term": "short_term",
95             "long_term": "long_term",
96             "entities": "entity",
97             "external": "external"
98         }
99 
100         # Shared base params
101         params: dict[str, Any] = {
102             "metadata": {"type": base_metadata[self.memory_type], **metadata},
103             "infer": self.infer
104         }
105 
106         # MemoryClient-specific overrides
107         if isinstance(self.memory, MemoryClient):
108             params["includes"] = self.includes
109             params["excludes"] = self.excludes
110             params["output_format"] = "v1.1"
111             params["version"] = "v2"
112 
113         if self.memory_type == "short_term" and self.mem0_run_id:
114             params["run_id"] = self.mem0_run_id
115 
116         if user_id:
117             params["user_id"] = user_id
118 
119         if agent_id := self.config.get("agent_id", self._get_agent_name()):
120             params["agent_id"] = agent_id
121 
122         self.memory.add(assistant_message, **params)
123 
124     def search(self,query: str,limit: int = 3,score_threshold: float = 0.35) -> List[Any]:
125         params = {
126             "query": query,
127             "limit": limit,
128             "version": "v2",
129             "output_format": "v1.1"
130             }
131 
132         if user_id := self.config.get("user_id", ""):
133             params["user_id"] = user_id
134 
135         memory_type_map = {
136             "short_term": {"type": "short_term"},
137             "long_term": {"type": "long_term"},
138             "entities": {"type": "entity"},
139             "external": {"type": "external"},
140         }
141 
142         if self.memory_type in memory_type_map:
143             params["metadata"] = memory_type_map[self.memory_type]
144             if self.memory_type == "short_term":
145                 params["run_id"] = self.mem0_run_id
146 
147         # Discard the filters for now since we create the filters
148         # automatically when the crew is created.
149 
150         params["filters"] = self._create_filter_for_search()
151         params['threshold'] = score_threshold
152 
153         if isinstance(self.memory, Memory):
154             del params["metadata"], params["version"], params['output_format']
155             if params.get("run_id"):
156                 del params["run_id"]
157 
158         results = self.memory.search(**params)
159 
160         # This makes it compatible for Contextual Memory to retrieve
161         for result in results["results"]:
162             result["context"] = result["memory"]
163         
164         return [r for r in results["results"]]
165 
166     def reset(self):
167         if self.memory:
168             self.memory.reset()
169 
170     def _sanitize_role(self, role: str) -> str:
171         """
172         Sanitizes agent roles to ensure valid directory names.
173         """
174         return role.replace("\n", "").replace(" ", "_").replace("/", "_")
175 
176     def _get_agent_name(self) -> str:
177         if not self.crew:
178             return ""
179 
180         agents = self.crew.agents
181         agents = [self._sanitize_role(agent.role) for agent in agents]
182         agents = "_".join(agents)
183         return sanitize_collection_name(name=agents, max_collection_length=MAX_AGENT_ID_LENGTH_MEM0)

