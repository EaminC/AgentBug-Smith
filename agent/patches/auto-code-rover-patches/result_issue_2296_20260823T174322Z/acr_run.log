374             # Initialize messages with sequential indices
375             session_message = None
376             for i, message in enumerate(agent.messages):
377                 session_message = SessionMessage.from_message(message, i)
378                 self.session_repository.create_message(self.session_id, agent.agent_id, session_message)
379             self._latest_agent_message[agent.agent_id] = session_message
380         else:
381             logger.debug(
382                 "agent_id=<%s> | session_id=<%s> | restoring bidi agent",
383                 agent.agent_id,
384                 self.session_id,
385             )
386             agent.state = AgentState(session_agent.state)
387 
388             session_agent.initialize_bidi_internal_state(agent)
389 
