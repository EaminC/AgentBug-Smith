327     def initialize_multi_agent(self, source: "MultiAgentBase", **kwargs: Any) -> None:
328         """Initialize multi-agent state from the session repository.
329 
330         Args:
331             source: Multi-agent source object to restore state into
332             **kwargs: Additional keyword arguments for future extensibility.
333         """
334         # Skip read_multi_agent call for new sessions since no multi-agents can exist yet
