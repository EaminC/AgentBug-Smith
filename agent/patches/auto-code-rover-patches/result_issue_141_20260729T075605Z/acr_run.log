72 class OllamaChatWrapper(OllamaWrapperBase):
73     """The model wrapper for Ollama chat API."""
74 
75     model_type: str = "ollama_chat"
76 
77     def __call__(
78         self,
79         messages: Sequence[dict],
80         options: Optional[dict] = None,
81         keep_alive: Optional[str] = None,
82         **kwargs: Any,
83     ) -> ModelResponse:
84         """Generate response from the given messages.
85 
86         Args:
87             messages (`Sequence[dict]`):
88                 A list of messages, each message is a dict contains the `role`
89                 and `content` of the message.
90             options (`dict`, default `None`):
91                 The extra arguments used in ollama chat API, which takes
92                 effect only on this call, and will be merged with the
93                 `options` input in the constructor,
94                 e.g. `{"temperature": 0., "seed": 123}`.
95             keep_alive (`str`, default `None`):
96                 How long the model will stay loaded into memory following
97                 the request, which takes effect only on this call, and will
98                 override the `keep_alive` input in the constructor.
99 
100         Returns:
101             `ModelResponse`:
102                 The response text in `text` field, and the raw response in
103                 `raw` field.
104         """
105         # step1: prepare parameters accordingly
106         if options is None:
107             options = self.options
108         else:
109             options = {**self.options, **options}
110 
111         keep_alive = keep_alive or self.keep_alive
112 
113         # step2: forward to generate response
114         response = ollama.chat(
115             model=self.model_name,
116             messages=messages,
117             options=options,
118             keep_alive=keep_alive,
119             **kwargs,
120         )
121 
122         # step2: record the api invocation if needed
123         self._save_model_invocation(
124             arguments={
125                 "model": self.model_name,
126                 "messages": messages,
127                 "options": options,
128                 "keep_alive": keep_alive,
129                 **kwargs,
130             },
131             response=response,
132         )
133 
134         # step3: monitor the response
135         self.update_monitor(
136             call_counter=1,
137             prompt_tokens=response["prompt_eval_count"],
138             completion_tokens=response["eval_count"],
139             total_tokens=response["prompt_eval_count"]
140             + response["eval_count"],
141         )
142 
143         # step4: return response
144         return ModelResponse(
145             text=response["message"]["content"],
146             raw=response,
147         )
148 
149     def _register_default_metrics(self) -> None:
150         """Register metrics to the monitor."""
151         self.monitor.register(
152             self._metric("call_counter"),
153             metric_unit="times",
154         )
155         self.monitor.register(
156             self._metric("prompt_tokens"),
157             metric_unit="tokens",
158         )
159         self.monitor.register(
160             self._metric("completion_tokens"),
161             metric_unit="token",
162         )
163         self.monitor.register(
164             self._metric("total_tokens"),
165             metric_unit="token",
166         )
167 
168     def format(
169         self,
170         *args: Union[MessageBase, Sequence[MessageBase]],
171     ) -> List[dict]:
172         """A basic strategy to format the input into the required format of
173         Ollama Chat API.
174 
175         Note for ollama chat api, the content field shouldn't be empty string.
176 
177         Args:
178             args (`Union[MessageBase, Sequence[MessageBase]]`):
179                 The input arguments to be formatted, where each argument
180                 should be a `Msg` object, or a list of `Msg` objects.
181                 In distribution, placeholder is also allowed.
182 
183         Returns:
184             `List[dict]`:
185                 The formatted messages.
186         """
187         ollama_msgs = []
188         for msg in args:
189             if msg is None:
190                 continue
191             if isinstance(msg, MessageBase):
192                 # content shouldn't be empty string
193                 if msg.content == "":
194                     logger.warning(
195                         "In ollama chat API, the content field cannot be "
196                         "empty string. To avoid error, the empty string is "
197                         "replaced by a blank space automatically, but the "
198                         "model may not work as expected.",
199                     )
200                     msg.content = " "
201 
202                 ollama_msg = {
203                     "role": msg.role,
204                     "content": _convert_to_str(msg.content),
205                 }
206 
207                 # image url
208                 if msg.url is not None:
209                     ollama_msg["images"] = [msg.url]
210 
211                 ollama_msgs.append(ollama_msg)
212             elif isinstance(msg, list):
213                 ollama_msgs.extend(self.format(*msg))
214             else:
215                 raise TypeError(
216                     f"Invalid message type: {type(msg)}, `Msg` is expected.",
217                 )
218 
219         return ollama_msgs

