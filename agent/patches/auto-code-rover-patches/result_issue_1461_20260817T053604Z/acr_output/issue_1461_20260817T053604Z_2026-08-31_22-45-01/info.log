19 class AgentResult:
20     """Represents the last result of invoking an agent with a prompt.
21 
22     Attributes:
23         stop_reason: The reason why the agent's processing stopped.
24         message: The last message generated by the agent.
25         metrics: Performance metrics collected during processing.
26         state: Additional state information from the event loop.
27         interrupts: List of interrupts if raised by user.
28         structured_output: Parsed structured output when structured_output_model was specified.
29     """
30 
31     stop_reason: StopReason
32     message: Message
33     metrics: EventLoopMetrics
34     state: Any
35     interrupts: Sequence[Interrupt] | None = None
36     structured_output: BaseModel | None = None
37 
38     def __str__(self) -> str:
39         """Get the agent's last message as a string.
40 
41         This method extracts and concatenates all text content from the final message, ignoring any non-text content
42         like images or structured data. If there's no text content but structured output is present, it serializes
43         the structured output instead.
44 
45         Returns:
46             The agent's last message as a string.
47         """
48         content_array = self.message.get("content", [])
49 
50         result = ""
51         for item in content_array:
52             if isinstance(item, dict):
53                 if "text" in item:
54                     result += item.get("text", "") + "\n"
55                 elif "citationsContent" in item:
56                     citations_block = item["citationsContent"]
57                     if "content" in citations_block:
58                         for content in citations_block["content"]:
59                             if isinstance(content, dict) and "text" in content:
60                                 result += content.get("text", "") + "\n"
61 
62         if not result and self.structured_output:
63             result = self.structured_output.model_dump_json()
64 
65         return result
66 
