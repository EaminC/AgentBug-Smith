175         self.additional_params = kwargs
176         self.is_anthropic = self._is_anthropic_model(model)
177 
178         litellm.drop_params = True
179 
180         # Normalize self.stop to always be a List[str]
181         if stop is None:
182             self.stop: List[str] = []
183         elif isinstance(stop, str):
184             self.stop = [stop]
185         else:
186             self.stop = stop
