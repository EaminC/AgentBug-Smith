83 def pmpt_task_select():
84     task_list = load_yml('task.yml')
85 
86     return f"""
87     As an ML project expert, you are tasked with selecting the most appropriate tasks based on the user's requirements
88     and provided data samples.
89 
90     Instructions:
91     - Analyze the provided user requirements and data samples carefully.
92     - Select three tasks that are most relevant to the requirements.
93     - For each selected task, provide a one-sentence description explaining its relevance.
94 
95     Available Tasks:
96     {task_list}
97 
98     Output Format:
99     Your response should include three entries formatted as a list of strings, where each string contains the task name followed by its description, e.g.:
100     ["Task1, Description of Task1", "Task2, Description of Task2", "Task3, Description of Task3"]
101 
102     Note: Return only the task names followed by a brief description, without any additional information or punctuation.
103     """
104 
105 
106 def pmpt_model_select():
107     return f"""
108     As an ML project expert, you are tasked with recommending three different AI model architectures based on the
109     user's requirements, provided data samples, and selected ML tasks. Each recommended model should align with one
110     of the specific criteria: best overall performance, balanced performance, and fastest computation.
111 
112     Instructions:
113     - Analyze the provided user requirements, data samples, and ML tasks.
114     - Select three models:
115         1. The best performing model in terms of accuracy.
116         2. A model with balanced performance considering both accuracy and computational efficiency.
117         3. The fastest model in terms of computational speed.
118     - For each model, provide a brief one-sentence summary that includes its suitability for the targeted task, its
119     accuracy, and its speed.
120 
121     Output Format:
122     Please return a list of three strings, where each string includes the model's name followed by its summary.
123     Ensure the description highlights how the model meets one of the selection criteria (best, balanced, fastest).
124     Example format:
125     ["ModelName1, Best for task X with high accuracy of Y%, suitable for complex data analysis.",
126      "ModelName2, Balanced model, offers moderate accuracy with better speed, good for real-time applications.",
127      "ModelName3, Fastest model with lower accuracy, best for quick processing where speed is prioritized over precision."]
128 
129     Note: Ensure that the architecture names with summary are returned without any additional punctuation.
130     """
131 
132 
133 def analyze_requirement(requirement: str, sys_prompt: str, llm_agent):
134     """
135     Generate the project plan based on the user's requirements.
136     :param requirement: the user's requirements.
137     :param sys_prompt: the system prompt.
138     :param llm_agent: the language model agent.
139     :return: the project plan.
140     """
141     chat_history = [
142         {"role": 'system', "content": sys_prompt},
143         {"role": 'user', "content": requirement}
144     ]
145     return llm_agent.query(chat_history)
146 
147 
148 def description_generator(requirement: str, task_list, llm_agent):
149     """
150     Generate the detailed description of the plan.
151     :param requirement: the user's requirements.
152     :param task_list: the selected task list.
153     :param llm_agent: the language model agent.
154     :return: the detailed description of the plan.
155     """
156     user_prompt = f"""
157     Overall Requirements: {requirement}
158     Tasks: {task_list}
159     """
160 
161     chat_history = [
162         {"role": 'system', "content": pmpt_task_desc()},
163         {"role": 'user', "content": user_prompt}
164     ]
165     return json.loads(llm_agent.query(chat_history))
166 
167 
168 def plan_generator(
169         requirement: str,
170         llm_agent,
171 ):
172     """
173     Generate the project plan based on the user's requirements.
174     :param requirement: the user's requirements.
175     :param llm_agent: the language model agent.
176     :return: the project plan.
177     """
178     task_list = []
179     for task in load_yml('plan.yml'):
180         task_list.append(
181             {
182                 'name': task['name'],
183                 'prompt': task['prompt'],
184                 'resources': [r['name'] for r in task.get('resources')]
185             }
186         )
187     chat_history = [
188         {"role": 'system', "content": pmpt_plan(json.dumps(task_list))},
189         {"role": 'user', "content": requirement}
190     ]
191     target_tasks = llm_agent.query(chat_history)
192 
193     # generate the completed plan with detailed description
194     return description_generator(requirement, target_tasks, llm_agent)

