64 def pmpt_dataset_detect():
65     # Load and format the dataset names for display
66     data_options = load_yml('data.yml')
67 
68     return f"""
69     You are an machine learning engineer tasked with detecting the appropriate dataset based on user requirements.
70 
71     Instructions:
