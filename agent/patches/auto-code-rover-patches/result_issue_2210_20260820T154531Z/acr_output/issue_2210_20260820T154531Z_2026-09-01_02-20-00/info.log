131     def __init__(
132         self,
133         *,
134         boto_session: boto3.Session | None = None,
135         boto_client_config: BotocoreConfig | None = None,
136         region_name: str | None = None,
137         endpoint_url: str | None = None,
138         **model_config: Unpack[BedrockConfig],
139     ):
140         """Initialize provider instance.
141 
142         Args:
143             boto_session: Boto Session to use when calling the Bedrock Model.
144             boto_client_config: Configuration to use when creating the Bedrock-Runtime Boto Client.
145             region_name: AWS region to use for the Bedrock service.
146                 Defaults to the AWS_REGION environment variable if set, or "us-west-2" if not set.
147             endpoint_url: Custom endpoint URL for VPC endpoints (PrivateLink)
148             **model_config: Configuration options for the Bedrock model.
149         """
150         if region_name and boto_session:
151             raise ValueError("Cannot specify both `region_name` and `boto_session`.")
152 
153         session = boto_session or boto3.Session()
154         resolved_region = region_name or session.region_name or os.environ.get("AWS_REGION") or DEFAULT_BEDROCK_REGION
155         self.config = BedrockModel.BedrockConfig(
156             model_id=BedrockModel._get_default_model_with_warning(resolved_region, model_config),
157             include_tool_result_status="auto",
158         )
159         self.update_config(**model_config)
160 
161         logger.debug("config=<%s> | initializing", self.config)
162 
163         # Add strands-agents to the request user agent
164         if boto_client_config:
165             existing_user_agent = getattr(boto_client_config, "user_agent_extra", None)
166 
167             # Append 'strands-agents' to existing user_agent_extra or set it if not present
168             if existing_user_agent:
169                 new_user_agent = f"{existing_user_agent} strands-agents"
170             else:
171                 new_user_agent = "strands-agents"
172 
173             client_config = boto_client_config.merge(BotocoreConfig(user_agent_extra=new_user_agent))
174         else:
175             client_config = BotocoreConfig(user_agent_extra="strands-agents", read_timeout=DEFAULT_READ_TIMEOUT)
176 
177         self.client = session.client(
178             service_name="bedrock-runtime",
179             config=client_config,
180             endpoint_url=endpoint_url,
181             region_name=resolved_region,
182         )
183 
184         logger.debug("region=<%s> | bedrock client created", self.client.meta.region_name)
185 
186     @property
187     def _cache_strategy(self) -> str | None:
188         """The cache strategy for this model based on its model ID.
189 
190         Returns the appropriate cache strategy name, or None if automatic caching is not supported for this model.
191         """
192         model_id = self.config.get("model_id", "").lower()
193         if "claude" in model_id or "anthropic" in model_id:
194             return "anthropic"
195         return None
196 
197     @override
198     def update_config(self, **model_config: Unpack[BedrockConfig]) -> None:  # type: ignore
199         """Update the Bedrock Model configuration with the provided arguments.
200 
201         Args:
202             **model_config: Configuration overrides.
203         """
204         validate_config_keys(model_config, self.BedrockConfig)
205         self.config.update(model_config)
206 
207     @override
208     def get_config(self) -> BedrockConfig:
209         """Get the current Bedrock Model configuration.
210 
211         Returns:
212             The Bedrock model configuration.
213         """
214         return self.config
215 
