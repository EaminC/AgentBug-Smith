320     def _get_additional_request_fields(self, tool_choice: ToolChoice | None) -> dict[str, Any]:
321         """Get additional request fields, removing thinking if tool_choice forces tool use.
322 
323         Bedrock's API does not allow thinking mode when tool_choice forces tool use.
324         When forcing a tool (e.g., for structured_output retry), we temporarily disable thinking.
325 
326         Args:
327             tool_choice: The tool choice configuration.
328 
329         Returns:
330             A dict containing additionalModelRequestFields if configured, or empty dict.
331         """
332         additional_fields = self.config.get("additional_request_fields")
333         if not additional_fields:
334             return {}
335 
336         # Check if tool_choice is forcing tool use ("any" or specific "tool")
337         is_forcing_tool = tool_choice is not None and ("any" in tool_choice or "tool" in tool_choice)
338 
339         if is_forcing_tool and "thinking" in additional_fields:
340             # Create a copy without the thinking key
341             fields_without_thinking = {k: v for k, v in additional_fields.items() if k != "thinking"}
342             if fields_without_thinking:
343                 return {"additionalModelRequestFields": fields_without_thinking}
344             return {}
345 
346         return {"additionalModelRequestFields": additional_fields}
347 
348     def _inject_cache_point(self, messages: list[dict[str, Any]]) -> None:
349         """Inject a cache point at the end of the last user message.
350 
351         Args:
352             messages: List of messages to inject cache point into (modified in place).
353         """
354         if not messages:
355             return
356 
357         last_user_idx: int | None = None
358         for msg_idx, msg in enumerate(messages):
359             content = msg.get("content", [])
360             for block_idx, block in reversed(list(enumerate(content))):
361                 if "cachePoint" in block:
362                     del content[block_idx]
363                     logger.warning(
364                         "msg_idx=<%s>, block_idx=<%s> | stripped existing cache point (auto mode manages cache points)",
365                         msg_idx,
366                         block_idx,
367                     )
368             if msg.get("role") == "user":
369                 last_user_idx = msg_idx
370 
371         if last_user_idx is not None and messages[last_user_idx].get("content"):
372             messages[last_user_idx]["content"].append({"cachePoint": {"type": "default"}})
373             logger.debug("msg_idx=<%s> | added cache point to last user message", last_user_idx)
374 
375     def _find_last_user_text_message_index(self, messages: Messages) -> int | None:
376         """Find the index of the last user message containing text or image content.
377 
378         This is used for guardrail_latest_message to ensure that guardContent wrapping
379         targets the correct message even when toolResult messages follow.
380 
381         Args:
382             messages: List of messages to search
383 
384         Returns:
385             Index of the last user message with text/image content, or None if not found
386         """
387         for idx, msg in reversed(list(enumerate(messages))):
388             if msg["role"] == "user" and any("text" in cb or "image" in cb for cb in msg.get("content", [])):
389                 return idx
390         return None
391 
392     def _format_bedrock_messages(self, messages: Messages) -> list[dict[str, Any]]:
393         """Format messages for Bedrock API compatibility.
394 
395         This function ensures messages conform to Bedrock's expected format by:
396         - Filtering out SDK_UNKNOWN_MEMBER content blocks
397         - Eagerly filtering content blocks to only include Bedrock-supported fields
398         - Ensuring all message content blocks are properly formatted for the Bedrock API
399         - Optionally wrapping the last user message in guardrailConverseContent blocks
400         - Injecting cache points when cache_config is set with strategy="auto"
401 
402         Args:
403             messages: List of messages to format
404 
405         Returns:
406             Messages formatted for Bedrock API compatibility
407 
408         Note:
409             Unlike other APIs that ignore unknown fields, Bedrock only accepts a strict
410             subset of fields for each content block type and throws validation exceptions
411             when presented with unexpected fields. Therefore, we must eagerly filter all
412             content blocks to remove any additional fields before sending to Bedrock.
413             https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ContentBlock.html
414         """
415         cleaned_messages: list[dict[str, Any]] = []
416 
417         filtered_unknown_members = False
418         dropped_deepseek_reasoning_content = False
419 
420         # Pre-compute the index of the last user message containing text or image content.
421         # This ensures guardContent wrapping is maintained across tool execution cycles, where
422         # the final message in the list is a toolResult (role=user) rather than text/image content.
423         last_user_text_idx = None
424         if self.config.get("guardrail_latest_message", False):
425             last_user_text_idx = self._find_last_user_text_message_index(messages)
426 
427         for idx, message in enumerate(messages):
428             cleaned_content: list[dict[str, Any]] = []
429 
430             for content_block in message["content"]:
431                 # Filter out SDK_UNKNOWN_MEMBER content blocks
432                 if "SDK_UNKNOWN_MEMBER" in content_block:
433                     filtered_unknown_members = True
434                     continue
435 
436                 # DeepSeek models have issues with reasoningContent
437                 # TODO: Replace with systematic model configuration registry (https://github.com/strands-agents/sdk-python/issues/780)
438                 if "deepseek" in self.config["model_id"].lower() and "reasoningContent" in content_block:
439                     dropped_deepseek_reasoning_content = True
440                     continue
441 
442                 # Format content blocks for Bedrock API compatibility
443                 formatted_content = self._format_request_message_content(content_block)
444                 if formatted_content is None:
445                     continue
446 
447                 # Wrap text or image content in guardContent if this is the last user text/image message
448                 if idx == last_user_text_idx and ("text" in formatted_content or "image" in formatted_content):
449                     if "text" in formatted_content:
450                         formatted_content = {"guardContent": {"text": {"text": formatted_content["text"]}}}
451                     elif "image" in formatted_content:
452                         formatted_content = {"guardContent": {"image": formatted_content["image"]}}
453 
454                 cleaned_content.append(formatted_content)
455 
456             # Create new message with cleaned content (skip if empty)
457             if cleaned_content:
458                 cleaned_messages.append({"content": cleaned_content, "role": message["role"]})
459 
460         if filtered_unknown_members:
461             logger.warning(
462                 "Filtered out SDK_UNKNOWN_MEMBER content blocks from messages, consider upgrading boto3 version"
463             )
464         if dropped_deepseek_reasoning_content:
465             logger.debug(
466                 "Filtered DeepSeek reasoningContent content blocks from messages - https://api-docs.deepseek.com/guides/reasoning_model#multi-round-conversation"
467             )
468 
469         # Inject cache point into cleaned_messages (not original messages) if cache_config is set
470         cache_config = self.config.get("cache_config")
471         if cache_config:
472             strategy: str | None = cache_config.strategy
473             if strategy == "auto":
474                 strategy = self._cache_strategy
475                 if not strategy:
476                     logger.warning(
477                         "model_id=<%s> | cache_config is enabled but this model does not support automatic caching",
478                         self.config.get("model_id"),
479                     )
480             if strategy == "anthropic":
481                 self._inject_cache_point(cleaned_messages)
482 
483         return cleaned_messages
484 
485     def _should_include_tool_result_status(self) -> bool:
486         """Determine whether to include tool result status based on current config."""
487         include_status = self.config.get("include_tool_result_status", "auto")
488 
489         if include_status is True:
490             return True
491         elif include_status is False:
492             return False
493         else:  # "auto"
494             return any(model in self.config["model_id"] for model in _MODELS_INCLUDE_STATUS)
495 
496     def _handle_location(self, location: SourceLocation) -> dict[str, Any] | None:
497         """Convert location content block to Bedrock format if its an S3Location."""
498         if location["type"] == "s3":
499             s3_location = cast(S3Location, location)
500             formatted_document_s3: dict[str, Any] = {"uri": s3_location["uri"]}
501             if "bucketOwner" in s3_location:
502                 formatted_document_s3["bucketOwner"] = s3_location["bucketOwner"]
503             return {"s3Location": formatted_document_s3}
504         else:
505             logger.warning("Non s3 location sources are not supported by Bedrock | skipping content block")
506             return None
507 
508     def _format_request_message_content(self, content: ContentBlock) -> dict[str, Any] | None:
509         """Format a Bedrock content block.
510 
511         Bedrock strictly validates content blocks and throws exceptions for unknown fields.
512         This function extracts only the fields that Bedrock supports for each content type.
513 
514         Args:
515             content: Content block to format.
516 
517         Returns:
518             Bedrock formatted content block.
519 
520         Raises:
521             TypeError: If the content block type is not supported by Bedrock.
522         """
523         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_CachePointBlock.html
524         if "cachePoint" in content:
525             cache_point = content["cachePoint"]
526             result: dict[str, Any] = {"type": cache_point["type"]}
527             if "ttl" in cache_point:
528                 result["ttl"] = cache_point["ttl"]
529             return {"cachePoint": result}
530 
531         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_DocumentBlock.html
532         if "document" in content:
533             document = content["document"]
534             result = {}
535 
536             # Handle required fields (all optional due to total=False)
537             if "name" in document:
538                 result["name"] = document["name"]
539             if "format" in document:
540                 result["format"] = document["format"]
541 
542             # Handle source - supports bytes or location
543             if "source" in document:
544                 source = document["source"]
545                 formatted_document_source: dict[str, Any] | None
546                 if "location" in source:
547                     formatted_document_source = self._handle_location(source["location"])
548                     if formatted_document_source is None:
549                         return None
550                 elif "bytes" in source:
551                     formatted_document_source = {"bytes": source["bytes"]}
552                 result["source"] = formatted_document_source
553 
554             # Handle optional fields
555             if "citations" in document and document["citations"] is not None:
556                 result["citations"] = {"enabled": document["citations"]["enabled"]}
557             if "context" in document:
558                 result["context"] = document["context"]
559 
560             return {"document": result}
561 
562         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_GuardrailConverseContentBlock.html
563         if "guardContent" in content:
564             guard = content["guardContent"]
565             guard_text = guard["text"]
566             result = {"text": {"text": guard_text["text"], "qualifiers": guard_text["qualifiers"]}}
567             return {"guardContent": result}
568 
569         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ImageBlock.html
570         if "image" in content:
571             image = content["image"]
572             source = image["source"]
573             formatted_image_source: dict[str, Any] | None
574             if "location" in source:
575                 formatted_image_source = self._handle_location(source["location"])
576                 if formatted_image_source is None:
577                     return None
578             elif "bytes" in source:
579                 formatted_image_source = {"bytes": source["bytes"]}
580             result = {"format": image["format"], "source": formatted_image_source}
581             return {"image": result}
582 
583         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ReasoningContentBlock.html
584         if "reasoningContent" in content:
585             reasoning = content["reasoningContent"]
586             result = {}
587 
588             if "reasoningText" in reasoning:
589                 reasoning_text = reasoning["reasoningText"]
590                 result["reasoningText"] = {}
591                 if "text" in reasoning_text:
592                     result["reasoningText"]["text"] = reasoning_text["text"]
593                 # Only include signature if truthy (avoid empty strings)
594                 if reasoning_text.get("signature"):
595                     result["reasoningText"]["signature"] = reasoning_text["signature"]
596 
597             if "redactedContent" in reasoning:
598                 result["redactedContent"] = reasoning["redactedContent"]
599 
600             return {"reasoningContent": result}
601 
602         # Pass through text and other simple content types
603         if "text" in content:
604             return {"text": content["text"]}
605 
606         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolResultBlock.html
607         if "toolResult" in content:
608             tool_result = content["toolResult"]
609             # Normalize empty toolResult content arrays.
610             # Some model providers (e.g., Nemotron) reject toolResult blocks with
611             # content: [] via the Converse API, while others (e.g., Claude) accept
612             # them. Replace empty content with a minimal text block to ensure
613             # cross-model compatibility. This follows the same pattern as the
614             # TypeScript SDK's _formatMessages in bedrock.ts.
615             tool_result_content_list = tool_result.get("content") or [{"text": ""}]
616             formatted_content: list[dict[str, Any]] = []
617             for tool_result_content in tool_result_content_list:
618                 if "json" in tool_result_content:
619                     # Handle json field since not in ContentBlock but valid in ToolResultContent
620                     formatted_content.append({"json": tool_result_content["json"]})
621                 else:
622                     formatted_message_content = self._format_request_message_content(
623                         cast(ContentBlock, tool_result_content)
624                     )
625                     if formatted_message_content is None:
626                         continue
627                     formatted_content.append(formatted_message_content)
628 
629             result = {
630                 "content": formatted_content,
631                 "toolUseId": tool_result["toolUseId"],
632             }
633             if "status" in tool_result and self._should_include_tool_result_status():
634                 result["status"] = tool_result["status"]
635             return {"toolResult": result}
636 
637         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolUseBlock.html
638         if "toolUse" in content:
639             tool_use = content["toolUse"]
640             return {
641                 "toolUse": {
642                     "input": tool_use["input"],
643                     "name": tool_use["name"],
644                     "toolUseId": tool_use["toolUseId"],
645                 }
646             }
647 
648         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_VideoBlock.html
649         if "video" in content:
650             video = content["video"]
651             source = video["source"]
652             formatted_video_source: dict[str, Any] | None
653             if "location" in source:
654                 formatted_video_source = self._handle_location(source["location"])
655                 if formatted_video_source is None:
656                     return None
657             elif "bytes" in source:
658                 formatted_video_source = {"bytes": source["bytes"]}
659             result = {"format": video["format"], "source": formatted_video_source}
660             return {"video": result}
661 
662         # https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_CitationsContentBlock.html
663         if "citationsContent" in content:
664             citations = content["citationsContent"]
665             result = {}
666 
667             if "citations" in citations:
668                 result["citations"] = []
669                 for citation in citations["citations"]:
670                     filtered_citation: dict[str, Any] = {}
671                     if "location" in citation:
672                         filtered_citation["location"] = citation["location"]
673                     if "sourceContent" in citation:
674                         filtered_source_content: list[dict[str, Any]] = []
675                         for source_content in citation["sourceContent"]:
676                             if "text" in source_content:
677                                 filtered_source_content.append({"text": source_content["text"]})
678                         if filtered_source_content:
679                             filtered_citation["sourceContent"] = filtered_source_content
680                     if "title" in citation:
681                         filtered_citation["title"] = citation["title"]
682                     result["citations"].append(filtered_citation)
683 
684             if "content" in citations:
685                 filtered_content: list[dict[str, Any]] = []
686                 for generated_content in citations["content"]:
687                     if "text" in generated_content:
688                         filtered_content.append({"text": generated_content["text"]})
689                 if filtered_content:
690                     result["content"] = filtered_content
691 
692             return {"citationsContent": result}
693 
694         raise TypeError(f"content_type=<{next(iter(content))}> | unsupported type")
695 
696     def _has_blocked_guardrail(self, guardrail_data: dict[str, Any]) -> bool:
697         """Check if guardrail data contains any blocked policies.
698 
699         Args:
700             guardrail_data: Guardrail data from trace information.
701 
702         Returns:
703             True if any blocked guardrail is detected, False otherwise.
704         """
705         input_assessment = guardrail_data.get("inputAssessment", {})
706         output_assessments = guardrail_data.get("outputAssessments", {})
707 
708         # Check input assessments
709         if any(self._find_detected_and_blocked_policy(assessment) for assessment in input_assessment.values()):
710             return True
711 
712         # Check output assessments
713         if any(self._find_detected_and_blocked_policy(assessment) for assessment in output_assessments.values()):
714             return True
715 
716         return False
717 
718     def _generate_redaction_events(self) -> list[StreamEvent]:
719         """Generate redaction events based on configuration.
720 
721         Returns:
722             List of redaction events to yield.
723         """
724         events: list[StreamEvent] = []
725 
726         if self.config.get("guardrail_redact_input", True):
727             logger.debug("Redacting user input due to guardrail.")
728             events.append(
729                 {
730                     "redactContent": {
731                         "redactUserContentMessage": self.config.get(
732                             "guardrail_redact_input_message", "[User input redacted.]"
733                         )
734                     }
735                 }
736             )
737 
738         if self.config.get("guardrail_redact_output", False):
739             logger.debug("Redacting assistant output due to guardrail.")
740             events.append(
741                 {
742                     "redactContent": {
743                         "redactAssistantContentMessage": self.config.get(
744                             "guardrail_redact_output_message",
745                             "[Assistant output redacted.]",
746                         )
747                     }
748                 }
749             )
750 
751         return events
752 
753     @override
754     async def count_tokens(
755         self,
756         messages: Messages,
757         tool_specs: list[ToolSpec] | None = None,
758         system_prompt: str | None = None,
759         system_prompt_content: list[SystemContentBlock] | None = None,
760     ) -> int:
761         """Count tokens using Bedrock's native CountTokens API.
762 
763         Uses the same message format as the Converse API to get accurate token counts
764         directly from the Bedrock service.
765 
766         Args:
767             messages: List of message objects to count tokens for.
768             tool_specs: List of tool specifications to include in the count.
769             system_prompt: Plain string system prompt. Ignored if system_prompt_content is provided.
770             system_prompt_content: Structured system prompt content blocks.
771 
772         Returns:
773             Total input token count.
774         """
775         try:
776             if system_prompt and system_prompt_content is None:
777                 system_prompt_content = [{"text": system_prompt}]
778 
779             request = self._format_request(messages, tool_specs, system_prompt_content)
780             converse_input: dict[str, Any] = {}
781             if "messages" in request:
782                 converse_input["messages"] = request["messages"]
783             if "system" in request:
784                 converse_input["system"] = request["system"]
785             if "toolConfig" in request:
786                 converse_input["toolConfig"] = request["toolConfig"]
787 
788             response = await asyncio.to_thread(
789                 self.client.count_tokens,
790                 modelId=self.config["model_id"],
791                 input={"converse": converse_input},
792             )
793             input_tokens = response.get("inputTokens")
794             if input_tokens is None:
795                 raise ProviderTokenCountError("Bedrock count_tokens returned None for inputTokens")
796             total_tokens: int = input_tokens
797 
798             logger.debug("model_id=<%s>, total_tokens=<%d> | native token count", self.config["model_id"], total_tokens)
799             return total_tokens
800         except Exception as e:
801             logger.debug(
802                 "model_id=<%s>, error=<%s> | native token counting failed, falling back to estimation",
803                 self.config["model_id"],
804                 e,
805             )
806             return await super().count_tokens(messages, tool_specs, system_prompt, system_prompt_content)
807 
808     @override
809     async def stream(
810         self,
811         messages: Messages,
812         tool_specs: list[ToolSpec] | None = None,
813         system_prompt: str | None = None,
814         *,
815         tool_choice: ToolChoice | None = None,
816         system_prompt_content: list[SystemContentBlock] | None = None,
817         **kwargs: Any,
818     ) -> AsyncGenerator[StreamEvent, None]:
819         """Stream conversation with the Bedrock model.
820 
821         This method calls either the Bedrock converse_stream API or the converse API
822         based on the streaming parameter in the configuration.
823 
824         Args:
825             messages: List of message objects to be processed by the model.
826             tool_specs: List of tool specifications to make available to the model.
827             system_prompt: System prompt to provide context to the model.
828             tool_choice: Selection strategy for tool invocation.
829             system_prompt_content: System prompt content blocks to provide context to the model.
830             **kwargs: Additional keyword arguments for future extensibility.
831 
832         Yields:
833             Model events.
834 
835         Raises:
836             ContextWindowOverflowException: If the input exceeds the model's context window.
837             ModelThrottledException: If the model service is throttling requests.
838         """
839 
840         def callback(event: StreamEvent | None = None) -> None:
841             loop.call_soon_threadsafe(queue.put_nowait, event)
842             if event is None:
843                 return
844 
845         loop = asyncio.get_event_loop()
846         queue: asyncio.Queue[StreamEvent | None] = asyncio.Queue()
847 
848         # Handle backward compatibility: if system_prompt is provided but system_prompt_content is None
849         if system_prompt and system_prompt_content is None:
850             system_prompt_content = [{"text": system_prompt}]
851 
852         thread = asyncio.to_thread(self._stream, callback, messages, tool_specs, system_prompt_content, tool_choice)
853         task = asyncio.create_task(thread)
854 
855         while True:
856             event = await queue.get()
857             if event is None:
858                 break
859 
860             yield event
861 
862         await task
863 
864     def _stream(
865         self,
866         callback: Callable[..., None],
867         messages: Messages,
868         tool_specs: list[ToolSpec] | None = None,
869         system_prompt_content: list[SystemContentBlock] | None = None,
870         tool_choice: ToolChoice | None = None,
871     ) -> None:
872         """Stream conversation with the Bedrock model.
873 
874         This method operates in a separate thread to avoid blocking the async event loop with the call to
875         Bedrock's converse_stream.
876 
877         Args:
878             callback: Function to send events to the main thread.
879             messages: List of message objects to be processed by the model.
880             tool_specs: List of tool specifications to make available to the model.
881             system_prompt_content: System prompt content blocks to provide context to the model.
882             tool_choice: Selection strategy for tool invocation.
883 
884         Raises:
885             ContextWindowOverflowException: If the input exceeds the model's context window.
886             ModelThrottledException: If the model service is throttling requests.
887         """
888         try:
889             logger.debug("formatting request")
890             request = self._format_request(messages, tool_specs, system_prompt_content, tool_choice)
891             logger.debug("request=<%s>", request)
892 
893             logger.debug("invoking model")
894             streaming = self.config.get("streaming", True)
895 
896             logger.debug("got response from model")
897             if streaming:
898                 response = self.client.converse_stream(**request)
899                 for chunk in response["stream"]:
900                     if (
901                         "metadata" in chunk
902                         and "trace" in chunk["metadata"]
903                         and "guardrail" in chunk["metadata"]["trace"]
904                     ):
905                         guardrail_data = chunk["metadata"]["trace"]["guardrail"]
906                         if self._has_blocked_guardrail(guardrail_data):
907                             for event in self._generate_redaction_events():
908                                 callback(event)
909 
910                     callback(chunk)
911 
912             else:
913                 response = self.client.converse(**request)
914                 for event in self._convert_non_streaming_to_streaming(response):
915                     callback(event)
916 
917                 if (
918                     "trace" in response
919                     and "guardrail" in response["trace"]
920                     and self._has_blocked_guardrail(response["trace"]["guardrail"])
921                 ):
922                     for event in self._generate_redaction_events():
923                         callback(event)
924 
925         except ClientError as e:
926             error_message = str(e)
927 
928             if (
929                 e.response["Error"]["Code"] == "ThrottlingException"
930                 or e.response["Error"]["Code"] == "throttlingException"
931             ):
932                 raise ModelThrottledException(error_message) from e
933 
934             if any(overflow_message in error_message for overflow_message in BEDROCK_CONTEXT_WINDOW_OVERFLOW_MESSAGES):
935                 logger.warning("bedrock threw context window overflow error")
936                 raise ContextWindowOverflowException(e) from e
937 
938             region = self.client.meta.region_name
939 
940             # Aid in debugging by adding more information
941             add_exception_note(e, f"└ Bedrock region: {region}")
942             add_exception_note(e, f"└ Model id: {self.config.get('model_id')}")
943 
944             if (
945                 e.response["Error"]["Code"] == "AccessDeniedException"
946                 and "You don't have access to the model" in error_message
947             ):
948                 add_exception_note(
949                     e,
950                     "└ For more information see "
951                     "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#model-access-issue",
952                 )
953 
954             if (
955                 e.response["Error"]["Code"] == "ValidationException"
956                 and "with on-demand throughput isn’t supported" in error_message
957             ):
958                 add_exception_note(
959                     e,
960                     "└ For more information see "
961                     "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#on-demand-throughput-isnt-supported",
962                 )
963 
964             raise e
965 
966         finally:
967             callback()
968             logger.debug("finished streaming response from model")
969 
970     def _convert_non_streaming_to_streaming(self, response: dict[str, Any]) -> Iterable[StreamEvent]:
971         """Convert a non-streaming response to the streaming format.
972 
973         Args:
974             response: The non-streaming response from the Bedrock model.
975 
976         Returns:
977             An iterable of response events in the streaming format.
978         """
979         # Yield messageStart event
980         yield {"messageStart": {"role": response["output"]["message"]["role"]}}
981 
982         # Process content blocks
983         for content in cast(list[ContentBlock], response["output"]["message"]["content"]):
984             # Yield contentBlockStart event if needed
985             if "toolUse" in content:
986                 yield {
987                     "contentBlockStart": {
988                         "start": {
989                             "toolUse": {
990                                 "toolUseId": content["toolUse"]["toolUseId"],
991                                 "name": content["toolUse"]["name"],
992                             }
993                         },
994                     }
995                 }
996 
997                 # For tool use, we need to yield the input as a delta
998                 input_value = json.dumps(content["toolUse"]["input"])
999 
1000                 yield {"contentBlockDelta": {"delta": {"toolUse": {"input": input_value}}}}
1001             elif "text" in content:
1002                 # Then yield the text as a delta
1003                 yield {
1004                     "contentBlockDelta": {
1005                         "delta": {"text": content["text"]},
1006                     }
1007                 }
1008             elif "reasoningContent" in content:
1009                 # Then yield the reasoning content as a delta
1010                 yield {
1011                     "contentBlockDelta": {
1012                         "delta": {"reasoningContent": {"text": content["reasoningContent"]["reasoningText"]["text"]}}
1013                     }
1014                 }
1015 
1016                 if "signature" in content["reasoningContent"]["reasoningText"]:
1017                     yield {
1018                         "contentBlockDelta": {
1019                             "delta": {
1020                                 "reasoningContent": {
1021                                     "signature": content["reasoningContent"]["reasoningText"]["signature"]
1022                                 }
1023                             }
1024                         }
1025                     }
1026             elif "citationsContent" in content:
1027                 # For non-streaming citations, emit text and metadata deltas in sequence
1028                 # to match streaming behavior where they flow naturally
1029                 if "content" in content["citationsContent"]:
1030                     text_content = "".join([content["text"] for content in content["citationsContent"]["content"]])
1031                     yield {
1032                         "contentBlockDelta": {"delta": {"text": text_content}},
1033                     }
1034 
1035                 for citation in content["citationsContent"]["citations"]:
1036                     # Emit citation metadata, only including fields that are present
1037                     # Nova grounding may omit title/sourceContent
1038                     citation_metadata: CitationsDelta = {}
1039                     if "title" in citation:
1040                         citation_metadata["title"] = citation["title"]
1041                     if "location" in citation:
1042                         citation_metadata["location"] = citation["location"]
1043                     if "sourceContent" in citation:
1044                         citation_metadata["sourceContent"] = citation["sourceContent"]
1045                     yield {"contentBlockDelta": {"delta": {"citation": citation_metadata}}}
1046 
1047             # Yield contentBlockStop event
1048             yield {"contentBlockStop": {}}
1049 
1050         # Yield messageStop event
1051         yield {
1052             "messageStop": {
1053                 "stopReason": response["stopReason"],
1054                 "additionalModelResponseFields": response.get("additionalModelResponseFields"),
1055             }
1056         }
1057 
1058         # Yield metadata event
1059         if "usage" in response or "metrics" in response or "trace" in response:
1060             metadata: StreamEvent = {"metadata": {}}
1061             if "usage" in response:
1062                 metadata["metadata"]["usage"] = response["usage"]
1063             if "metrics" in response:
1064                 metadata["metadata"]["metrics"] = response["metrics"]
1065             if "trace" in response:
1066                 metadata["metadata"]["trace"] = response["trace"]
1067             yield metadata
1068 
1069     def _find_detected_and_blocked_policy(self, input: Any) -> bool:
1070         """Recursively checks if the assessment contains a detected and blocked guardrail.
1071 
1072         Args:
1073             input: The assessment to check.
1074 
1075         Returns:
1076             True if the input contains a detected and blocked guardrail, False otherwise.
1077 
1078         """
1079         # Check if input is a dictionary
1080         if isinstance(input, dict):
1081             # Check if current dictionary has action: BLOCKED and detected: true
1082             if input.get("action") == "BLOCKED" and input.get("detected") and isinstance(input.get("detected"), bool):
1083                 return True
1084 
1085             # Otherwise, recursively check all values in the dictionary
1086             return self._find_detected_and_blocked_policy(input.values())
1087 
1088         elif isinstance(input, (list, ValuesView)):
1089             # Handle case where input is a list or dict_values
1090             return any(self._find_detected_and_blocked_policy(item) for item in input)
1091         # Otherwise return False
1092         return False
1093 
1094     @override
1095     async def structured_output(
1096         self,
1097         output_model: type[T],
1098         prompt: Messages,
1099         system_prompt: str | None = None,
1100         **kwargs: Any,
1101     ) -> AsyncGenerator[dict[str, T | Any], None]:
1102         """Get structured output from the model.
1103 
1104         Args:
1105             output_model: The output model to use for the agent.
1106             prompt: The prompt messages to use for the agent.
1107             system_prompt: System prompt to provide context to the model.
1108             **kwargs: Additional keyword arguments for future extensibility.
1109 
1110         Yields:
1111             Model events with the last being the structured output.
1112         """
1113         tool_spec = convert_pydantic_to_tool_spec(output_model)
1114 
1115         response = self.stream(
1116             messages=prompt,
1117             tool_specs=[tool_spec],
1118             system_prompt=system_prompt,
