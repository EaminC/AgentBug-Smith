61 class BedrockModel(Model):
62     """AWS Bedrock model provider implementation.
63 
64     The implementation handles Bedrock-specific features such as:
65 
66     - Tool configuration for function calling
67     - Guardrails integration
68     - Caching points for system prompts and tools
69     - Streaming responses
70     - Context window overflow detection
71     """
72 
73     class BedrockConfig(BaseModelConfig, total=False):
74         """Configuration options for Bedrock models.
75 
