174 def execute_entrypoint(ai: AI, dbs: DBs) -> List[dict]:
175     command = dbs.workspace["run.sh"]
176 
177     print("Do you want to execute this code?")
178     print()
179     print(command)
180     print()
181     print('If yes, press enter. Otherwise, type "no"')
182     print()
183     if input() not in ["", "y", "yes"]:
184         print("Ok, not executing the code.")
185         return []
186     print("Executing the code...")
187     print()
188     print(
189         colored(
190             "Note: If it does not work as expected, consider running the code"
191             + " in another way than above.",
192             "green",
193         )
194     )
195     print()
196     print("You can press ctrl+c *once* to stop the execution.")
197     print()
198 
199     p = subprocess.Popen("bash run.sh", shell=True, cwd=dbs.workspace.path)
200     try:
201         p.wait()
202     except KeyboardInterrupt:
203         print()
204         print("Stopping execution.")
205         print("Execution stopped.")
206         p.kill()
207         print()
208 
209     return []
