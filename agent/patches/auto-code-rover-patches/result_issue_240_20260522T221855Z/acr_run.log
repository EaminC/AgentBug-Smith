41 def simple_gen(ai: AI, dbs: DBs) -> List[dict]:
42     """Run the AI on the main prompt and save the results"""
43     messages = ai.start(setup_sys_prompt(dbs), get_prompt(dbs))
44     to_files(messages[-1]["content"], dbs.workspace)
45     return messages
46 
47 
48 def clarify(ai: AI, dbs: DBs) -> List[dict]:
49     """
50     Ask the user if they want to clarify anything and save the results to the workspace
51     """
52     messages = [ai.fsystem(dbs.preprompts["qa"])]
53     user_input = get_prompt(dbs)
54     while True:
55         messages = ai.next(messages, user_input)
56 
57         if messages[-1]["content"].strip() == "Nothing more to clarify.":
58             break
59 
60         if messages[-1]["content"].strip().lower().startswith("no"):
61             print("Nothing more to clarify.")
62             break
63 
64         print()
65         user_input = input('(answer in text, or "c" to move on)\n')
66         print()
67 
68         if not user_input or user_input == "c":
69             print("(letting gpt-engineer make its own assumptions)")
70             print()
71             messages = ai.next(
72                 messages,
73                 "Make your own assumptions and state them explicitly before starting",
74             )
75             print()
76             return messages
77 
78         user_input += (
79             "\n\n"
80             "Is anything else unclear? If yes, only answer in the form:\n"
81             "{remaining unclear areas} remaining questions.\n"
82             "{Next question}\n"
83             'If everything is sufficiently clear, only answer "Nothing more to clarify.".'
84         )
85 
86     print()
87     return messages
88 
