41 def simple_gen(ai: AI, dbs: DBs) -> List[dict]:
42     """Run the AI on the main prompt and save the results"""
43     messages = ai.start(setup_sys_prompt(dbs), get_prompt(dbs))
44     to_files(messages[-1]["content"], dbs.workspace)
45     return messages
46 
47 
48 def clarify(ai: AI, dbs: DBs) -> List[dict]:
49     """
50     Ask the user if they want to clarify anything and save the results to the workspace
51     """
52     messages = [ai.fsystem(dbs.preprompts["qa"])]
53     user_input = get_prompt(dbs)
54     while True:
55         messages = ai.next(messages, user_input)
56 
57         if messages[-1]["content"].strip() == "Nothing more to clarify.":
58             break
59 
60         if messages[-1]["content"].strip().lower().startswith("no"):
61             print("Nothing more to clarify.")
62             break
63 
64         print()
65         user_input = input('(answer in text, or "c" to move on)\n')
66         print()
67 
68         if not user_input or user_input == "c":
69             print("(letting gpt-engineer make its own assumptions)")
70             print()
71             messages = ai.next(
72                 messages,
73                 "Make your own assumptions and state them explicitly before starting",
74             )
75             print()
76             return messages
77 
78         user_input += (
79             "\n\n"
80             "Is anything else unclear? If yes, only answer in the form:\n"
81             "{remaining unclear areas} remaining questions.\n"
82             "{Next question}\n"
83             'If everything is sufficiently clear, only answer "Nothing more to clarify.".'
84         )
85 
86     print()
87     return messages
88 
89 
90 def gen_spec(ai: AI, dbs: DBs) -> List[dict]:
91     """
92     Generate a spec from the main prompt + clarifications and save the results to
93     the workspace
94     """
95     messages = [
96         ai.fsystem(setup_sys_prompt(dbs)),
97         ai.fsystem(f"Instructions: {dbs.input['prompt']}"),
98     ]
99 
100     messages = ai.next(messages, dbs.preprompts["spec"])
101 
102     dbs.memory["specification"] = messages[-1]["content"]
103 
104     return messages
105 
106 
107 def respec(ai: AI, dbs: DBs) -> List[dict]:
108     messages = json.loads(dbs.logs[gen_spec.__name__])
109     messages += [ai.fsystem(dbs.preprompts["respec"])]
110 
111     messages = ai.next(messages)
112     messages = ai.next(
113         messages,
114         (
115             "Based on the conversation so far, please reiterate the specification for "
116             "the program. "
117             "If there are things that can be improved, please incorporate the "
118             "improvements. "
119             "If you are satisfied with the specification, just write out the "
120             "specification word by word again."
121         ),
122     )
123 
124     dbs.memory["specification"] = messages[-1]["content"]
125     return messages
126 
127 
128 def gen_unit_tests(ai: AI, dbs: DBs) -> List[dict]:
129     """
130     Generate unit tests based on the specification, that should work.
131     """
132     messages = [
133         ai.fsystem(setup_sys_prompt(dbs)),
134         ai.fuser(f"Instructions: {dbs.input['prompt']}"),
135         ai.fuser(f"Specification:\n\n{dbs.memory['specification']}"),
136     ]
137 
138     messages = ai.next(messages, dbs.preprompts["unit_tests"])
139 
140     dbs.memory["unit_tests"] = messages[-1]["content"]
141     to_files(dbs.memory["unit_tests"], dbs.workspace)
142 
143     return messages
144 
145 
146 def gen_clarified_code(ai: AI, dbs: DBs) -> List[dict]:
147     """Takes clarification and generates code"""
148 
149     messages = json.loads(dbs.logs[clarify.__name__])
150 
151     messages = [
152         ai.fsystem(setup_sys_prompt(dbs)),
153     ] + messages[1:]
154     messages = ai.next(messages, dbs.preprompts["use_qa"])
155 
156     to_files(messages[-1]["content"], dbs.workspace)
157     return messages
158 
