212 def gen_entrypoint(ai: AI, dbs: DBs) -> List[dict]:
213     messages = ai.start(
214         system=(
215             "You will get information about a codebase that is currently on disk in "
216             "the current folder.\n"
217             "From this you will answer with code blocks that includes all the necessary "
218             "unix terminal commands to "
219             "a) install dependencies "
220             "b) run all necessary parts of the codebase (in parallel if necessary).\n"
221             "Do not install globally. Do not use sudo.\n"
222             "Do not explain the code, just give the commands.\n"
223             "Do not use placeholders, use example values (like . for a folder argument) "
224             "if necessary.\n"
225         ),
226         user="Information about the codebase:\n\n" + dbs.workspace["all_output.txt"],
227     )
228     print()
229 
230     regex = r"```\S*\n(.+?)```"
231     matches = re.finditer(regex, messages[-1]["content"], re.DOTALL)
232     dbs.workspace["run.sh"] = "\n".join(match.group(1) for match in matches)
233     return messages
