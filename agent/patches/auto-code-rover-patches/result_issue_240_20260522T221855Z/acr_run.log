16 def setup_sys_prompt(dbs: DBs) -> str:
17     return (
18         dbs.preprompts["generate"] + "\nUseful to know:\n" + dbs.preprompts["philosophy"]
19     )
20 
21 
22 def get_prompt(dbs: DBs) -> str:
23     """While we migrate we have this fallback getter"""
24     assert (
25         "prompt" in dbs.input or "main_prompt" in dbs.input
26     ), "Please put your prompt in the file `prompt` in the project directory"
27 
28     if "prompt" not in dbs.input:
29         print(
30             colored("Please put the prompt in the file `prompt`, not `main_prompt", "red")
31         )
32         print()
33         return dbs.input["main_prompt"]
34 
35     return dbs.input["prompt"]
36 
