179     @classmethod
180     def format_request_tool_message(cls, tool_result: ToolResult, **kwargs: Any) -> dict[str, Any]:
181         """Format an OpenAI compatible tool message.
182 
183         Args:
184             tool_result: Tool result collected from a tool execution.
185             **kwargs: Additional keyword arguments for future extensibility.
186 
187         Returns:
188             OpenAI compatible tool message.
189         """
190         contents = cast(
191             list[ContentBlock],
192             [
193                 {"text": json.dumps(content["json"])} if "json" in content else content
194                 for content in tool_result["content"]
195             ],
196         )
197 
198         return {
199             "role": "tool",
200             "tool_call_id": tool_result["toolUseId"],
201             "content": [cls.format_request_message_content(content) for content in contents],
202         }
