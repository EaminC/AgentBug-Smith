360         # If weak_model_name is provided, override the model settings
361         if provided_weak_model_name:
362             self.weak_model_name = provided_weak_model_name
363 
364         if not self.weak_model_name:
365             self.weak_model = self
366             return
367 
368         if self.weak_model_name == self.name:
369             self.weak_model = self
370             return
