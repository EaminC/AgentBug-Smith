298                 "supports_function_calling": True,
299                 "supports_parallel_function_calling": True,
300                 "supports_vision": True,
301             }
302 
303         # Are all needed keys/params available?
304         res = self.validate_environment()
305         self.missing_keys = res.get("missing_keys")
306         self.keys_in_environment = res.get("keys_in_environment")
307 
308         if self.info.get("max_input_tokens", 0) < 32 * 1024:
309             self.max_chat_history_tokens = 1024
310         else:
311             self.max_chat_history_tokens = 2 * 1024
312 
313         self.configure_model_settings(model)
314         if weak_model is False:
315             self.weak_model_name = None
316         else:
317             self.get_weak_model(weak_model)
