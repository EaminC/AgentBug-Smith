265 class Model:
266     name = None
267 
268     edit_format = "whole"
269     use_repo_map = False
270     send_undo_reply = False
271     accepts_images = False
272     weak_model_name = None
273     lazy = False
274     reminder_as_sys_msg = False
275     examples_as_sys_msg = False
276 
277     max_chat_history_tokens = 1024
278     weak_model = None
279 
280     def __init__(self, model, weak_model=None):
281         self.name = model
282 
283         # Do we have the model_info?
284         try:
285             self.info = litellm.get_model_info(model)
286         except Exception:
287             self.info = dict()
288 
289         if not self.info and "gpt-4o" in self.name:
290             self.info = {
291                 "max_tokens": 4096,
292                 "max_input_tokens": 128000,
293                 "max_output_tokens": 4096,
294                 "input_cost_per_token": 5e-06,
295                 "output_cost_per_token": 1.5e-5,
296                 "litellm_provider": "openai",
297                 "mode": "chat",
298                 "supports_function_calling": True,
299                 "supports_parallel_function_calling": True,
300                 "supports_vision": True,
301             }
302 
303         # Are all needed keys/params available?
304         res = self.validate_environment()
305         self.missing_keys = res.get("missing_keys")
306         self.keys_in_environment = res.get("keys_in_environment")
307 
308         if self.info.get("max_input_tokens", 0) < 32 * 1024:
309             self.max_chat_history_tokens = 1024
310         else:
311             self.max_chat_history_tokens = 2 * 1024
312 
313         self.configure_model_settings(model)
314         if weak_model is False:
315             self.weak_model_name = None
316         else:
317             self.get_weak_model(weak_model)
318 
319     def configure_model_settings(self, model):
320         for ms in MODEL_SETTINGS:
321             # direct match, or match "provider/<model>"
322             if model == ms.name:
323                 for field in fields(ModelSettings):
324                     val = getattr(ms, field.name)
325                     setattr(self, field.name, val)
326                 return  # <--
327 
328         model = model.lower()
329 
330         if ("llama3" in model or "llama-3" in model) and "70b" in model:
331             self.edit_format = "diff"
332             self.use_repo_map = True
333             self.send_undo_reply = True
334             self.examples_as_sys_msg = True
335             return  # <--
336 
337         if "gpt-4-turbo" in model or ("gpt-4-" in model and "-preview" in model):
338             self.edit_format = "udiff"
339             self.use_repo_map = True
340             self.send_undo_reply = True
341             return  # <--
342 
343         if "gpt-4" in model or "claude-3-opus" in model:
344             self.edit_format = "diff"
345             self.use_repo_map = True
346             self.send_undo_reply = True
347             return  # <--
348 
349         if "gpt-3.5" in model or "gpt-4" in model:
350             self.reminder_as_sys_msg = True
351 
352         # use the defaults
353         if self.edit_format == "diff":
354             self.use_repo_map = True
355 
356     def __str__(self):
357         return self.name
358 
359     def get_weak_model(self, provided_weak_model_name):
360         # If weak_model_name is provided, override the model settings
361         if provided_weak_model_name:
362             self.weak_model_name = provided_weak_model_name
363 
364         if not self.weak_model_name:
365             self.weak_model = self
366             return
367 
368         if self.weak_model_name == self.name:
369             self.weak_model = self
370             return
371 
372         self.weak_model = Model(
373             self.weak_model_name,
374             weak_model=False,
375         )
376         return self.weak_model
377 
378     def commit_message_models(self):
379         return [self.weak_model]
380 
381     def tokenizer(self, text):
382         return litellm.encode(model=self.name, text=text)
383 
384     def token_count(self, messages):
385         if not self.tokenizer:
386             return
387 
388         if type(messages) is str:
389             msgs = messages
390         else:
391             msgs = json.dumps(messages)
392 
393         return len(self.tokenizer(msgs))
394 
395     def token_count_for_image(self, fname):
396         """
397         Calculate the token cost for an image assuming high detail.
398         The token cost is determined by the size of the image.
399         :param fname: The filename of the image.
400         :return: The token cost for the image.
401         """
402         width, height = self.get_image_size(fname)
403 
404         # If the image is larger than 2048 in any dimension, scale it down to fit within 2048x2048
405         max_dimension = max(width, height)
406         if max_dimension > 2048:
407             scale_factor = 2048 / max_dimension
408             width = int(width * scale_factor)
409             height = int(height * scale_factor)
410 
411         # Scale the image such that the shortest side is 768 pixels long
412         min_dimension = min(width, height)
413         scale_factor = 768 / min_dimension
414         width = int(width * scale_factor)
415         height = int(height * scale_factor)
416 
417         # Calculate the number of 512x512 tiles needed to cover the image
418         tiles_width = math.ceil(width / 512)
419         tiles_height = math.ceil(height / 512)
420         num_tiles = tiles_width * tiles_height
421 
422         # Each tile costs 170 tokens, and there's an additional fixed cost of 85 tokens
423         token_cost = num_tiles * 170 + 85
424         return token_cost
425 
426     def get_image_size(self, fname):
427         """
428         Retrieve the size of an image.
429         :param fname: The filename of the image.
430         :return: A tuple (width, height) representing the image size in pixels.
431         """
432         with Image.open(fname) as img:
433             return img.size
434 
435     def validate_environment(self):
436         # https://github.com/BerriAI/litellm/issues/3190
437 
438         model = self.name
439         res = litellm.validate_environment(model)
440         if res["keys_in_environment"]:
441             return res
442         if res["missing_keys"]:
443             return res
444 
445         provider = self.info.get("litellm_provider", "").lower()
446         if provider == "cohere_chat":
447             return validate_variables(["COHERE_API_KEY"])
448         if provider == "gemini":
449             return validate_variables(["GEMINI_API_KEY"])
450         if provider == "groq":
451             return validate_variables(["GROQ_API_KEY"])
452 
453         return res
454 
455 
456 def register_models(model_def_fnames):
457     model_metadata_files_loaded = []
458     for model_def_fname in model_def_fnames:
459         if not os.path.exists(model_def_fname):
460             continue
461         model_metadata_files_loaded.append(model_def_fname)
462         try:
463             with open(model_def_fname, "r") as model_def_file:
464                 model_def = json.load(model_def_file)
465         except json.JSONDecodeError as e:
466             raise Exception(f"Error loading model definition from {model_def_fname}: {e}")
467 
468         litellm.register_model(model_def)
469 
470     return model_metadata_files_loaded
471 
472 
473 def validate_variables(vars):
474     missing = []
475     for var in vars:
476         if var not in os.environ:
477             missing.append(var)
478     if missing:
479         return dict(keys_in_environment=False, missing_keys=missing)
480     return dict(keys_in_environment=True, missing_keys=missing)
481 
482 
483 def sanity_check_models(io, main_model):
484     sanity_check_model(io, main_model)
485     if main_model.weak_model and main_model.weak_model is not main_model:
486         sanity_check_model(io, main_model.weak_model)
487 
488 
489 def sanity_check_model(io, model):
490     show = False
491 
492     if model.missing_keys:
493         show = True
494         io.tool_error(f"Model {model}: Missing these environment variables:")
495         for key in model.missing_keys:
496             io.tool_error(f"- {key}")
497     elif not model.keys_in_environment:
498         show = True
499         io.tool_output(f"Model {model}: Unknown which environment variables are required.")
500 
501     if not model.info:
502         show = True
503         io.tool_output(
504             f"Model {model}: Unknown model, context window size and token costs unavailable."
505         )
506 
507         possible_matches = fuzzy_match_models(model.name)
508         if possible_matches:
509             io.tool_output("Did you mean one of these?")
510             for match in possible_matches:
511                 fq, m = match
512                 if fq == m:
513                     io.tool_error(f"- {m}")
514                 else:
515                     io.tool_error(f"- {m} ({fq})")
516 
517     if show:
518         io.tool_error(urls.model_warnings)
519 
520 
521 def fuzzy_match_models(name):
522     name = name.lower()
523 
524     chat_models = []
525     for model, attrs in litellm.model_cost.items():
526         model = model.lower()
527         if attrs.get("mode") != "chat":
528             continue
529         provider = (attrs["litellm_provider"] + "/").lower()
530 
531         if model.startswith(provider):
532             fq_model = model
533         else:
534             fq_model = provider + model
535 
536         chat_models.append((fq_model, model))
537 
538     # exactly matching model
539     # matching_models = [
540     #    (fq,m) for fq,m in chat_models
541     #    if name == fq or name == m
542     # ]
543     # if matching_models:
544     #    return matching_models
545 
546     # Check for model names containing the name
547     matching_models = [(fq, m) for fq, m in chat_models if name in fq]
548     if matching_models:
549         return matching_models
550 
551     # Check for slight misspellings
552     models = [m for fq, m in chat_models]
553     matching_models = difflib.get_close_matches(name, models, n=3, cutoff=0.8)
554     if matching_models:
555         return list(zip(matching_models, matching_models))
556 
557     fq_models = [fq for fq, m in chat_models]
558     matching_models = difflib.get_close_matches(name, fq_models, n=3, cutoff=0.8)
559     return list(zip(matching_models, matching_models))
560 
561 
562 def print_matching_models(io, search):
563     matches = fuzzy_match_models(search)
564     if matches:
565         io.tool_output(f'Models which match "{search}":')
566         for model in matches:
567             fq, m = model
568             if fq == m:
569                 io.tool_output(f"- {m}")
570             else:
571                 io.tool_output(f"- {m} ({fq})")
572     else:
573         io.tool_output(f'No models match "{search}".')
574 
575 
576 def main():
577     if len(sys.argv) != 2:
578         print("Usage: python models.py <model_name>")
579         sys.exit(1)
580 
581     model_name = sys.argv[1]
582     matching_models = fuzzy_match_models(model_name)
583 
584     if matching_models:
585         print(f"Matching models for '{model_name}':")
586         for model in matching_models:
587             print(model)
588     else:
589         print(f"No matching models found for '{model_name}'.")
590 
591 
592 if __name__ == "__main__":
593     main()

