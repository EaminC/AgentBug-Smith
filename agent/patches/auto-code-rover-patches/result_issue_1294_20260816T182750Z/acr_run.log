197     @override
198     @classmethod
199     def _format_system_messages(
200         cls,
201         system_prompt: str | None = None,
202         *,
203         system_prompt_content: list[SystemContentBlock] | None = None,
204         **kwargs: Any,
205     ) -> list[dict[str, Any]]:
206         """Format system messages for LiteLLM with cache point support.
207 
208         Args:
209             system_prompt: System prompt to provide context to the model.
210             system_prompt_content: System prompt content blocks to provide context to the model.
211             **kwargs: Additional keyword arguments for future extensibility.
212 
213         Returns:
214             List of formatted system messages.
215         """
216         # Handle backward compatibility: if system_prompt is provided but system_prompt_content is None
217         if system_prompt and system_prompt_content is None:
218             system_prompt_content = [{"text": system_prompt}]
219 
220         system_content: list[dict[str, Any]] = []
221         for block in system_prompt_content or []:
222             if "text" in block:
223                 system_content.append({"type": "text", "text": block["text"]})
224             elif "cachePoint" in block and block["cachePoint"].get("type") == "default":
225                 # Apply cache control to the immediately preceding content block
226                 # for LiteLLM/Anthropic compatibility
227                 if system_content:
228                     system_content[-1]["cache_control"] = {"type": "ephemeral"}
229 
230         # Create single system message with content array rather than mulitple system messages
231         return [{"role": "system", "content": system_content}] if system_content else []
