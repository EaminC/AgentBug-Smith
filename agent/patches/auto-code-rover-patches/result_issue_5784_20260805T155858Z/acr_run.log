93 StateSchema = TypeVar("StateSchema", bound=Union[AgentState, AgentStatePydantic])
94 StateSchemaType = Type[StateSchema]
95 
96 PROMPT_RUNNABLE_NAME = "Prompt"
97 
98 Prompt = Union[
99     SystemMessage,
100     str,
101     Callable[[StateSchema], LanguageModelInput],
102     Runnable[StateSchema, LanguageModelInput],
103 ]
104 
105 
106 def _get_state_value(state: StateSchema, key: str, default: Any = None) -> Any:
107     return (
108         state.get(key, default)
109         if isinstance(state, dict)
110         else getattr(state, key, default)
111     )
112 
113 
114 def _get_prompt_runnable(prompt: Optional[Prompt]) -> Runnable:
115     prompt_runnable: Runnable
116     if prompt is None:
117         prompt_runnable = RunnableCallable(
118             lambda state: _get_state_value(state, "messages"), name=PROMPT_RUNNABLE_NAME
119         )
120     elif isinstance(prompt, str):
121         _system_message: BaseMessage = SystemMessage(content=prompt)
122         prompt_runnable = RunnableCallable(
123             lambda state: [_system_message] + _get_state_value(state, "messages"),
124             name=PROMPT_RUNNABLE_NAME,
125         )
126     elif isinstance(prompt, SystemMessage):
127         prompt_runnable = RunnableCallable(
128             lambda state: [prompt] + _get_state_value(state, "messages"),
129             name=PROMPT_RUNNABLE_NAME,
130         )
131     elif inspect.iscoroutinefunction(prompt):
132         prompt_runnable = RunnableCallable(
133             None,
134             prompt,
135             name=PROMPT_RUNNABLE_NAME,
136         )
137     elif callable(prompt):
138         prompt_runnable = RunnableCallable(
139             prompt,
140             name=PROMPT_RUNNABLE_NAME,
141         )
142     elif isinstance(prompt, Runnable):
143         prompt_runnable = prompt
144     else:
145         raise ValueError(f"Got unexpected type for `prompt`: {type(prompt)}")
146 
147     return prompt_runnable
148 
149 
150 def _should_bind_tools(
151     model: LanguageModelLike, tools: Sequence[BaseTool], num_builtin: int = 0
152 ) -> bool:
153     if isinstance(model, RunnableSequence):
154         model = next(
155             (
156                 step
157                 for step in model.steps
158                 if isinstance(step, (RunnableBinding, BaseChatModel))
159             ),
160             model,
161         )
162 
163     if not isinstance(model, RunnableBinding):
164         return True
165 
166     if "tools" not in model.kwargs:
167         return True
168 
169     bound_tools = model.kwargs["tools"]
170     if len(tools) != len(bound_tools) - num_builtin:
171         raise ValueError(
172             "Number of tools in the model.bind_tools() and tools passed to create_react_agent must match"
173             f" Got {len(tools)} tools, expected {len(bound_tools) - num_builtin}"
174         )
175 
176     tool_names = set(tool.name for tool in tools)
177     bound_tool_names = set()
178     for bound_tool in bound_tools:
179         # OpenAI-style tool
180         if bound_tool.get("type") == "function":
181             bound_tool_name = bound_tool["function"]["name"]
182         # Anthropic-style tool
183         elif bound_tool.get("name"):
184             bound_tool_name = bound_tool["name"]
185         else:
186             # unknown tool type so we'll ignore it
187             continue
188 
189         bound_tool_names.add(bound_tool_name)
190 
191     if missing_tools := tool_names - bound_tool_names:
192         raise ValueError(f"Missing tools '{missing_tools}' in the model.bind_tools()")
193 
194     return False
195 
196 
197 def _get_model(model: LanguageModelLike) -> BaseChatModel:
198     """Get the underlying model from a RunnableBinding or return the model itself."""
199     if isinstance(model, RunnableSequence):
200         model = next(
201             (
202                 step
203                 for step in model.steps
204                 if isinstance(step, (RunnableBinding, BaseChatModel))
205             ),
206             model,
207         )
208 
209     if isinstance(model, RunnableBinding):
210         model = model.bound
211 
212     if not isinstance(model, BaseChatModel):
213         raise TypeError(
214             f"Expected `model` to be a ChatModel or RunnableBinding (e.g. model.bind_tools(...)), got {type(model)}"
215         )
216 
217     return model
218 
219 
220 def _validate_chat_history(
221     messages: Sequence[BaseMessage],
222 ) -> None:
223     """Validate that all tool calls in AIMessages have a corresponding ToolMessage."""
224     all_tool_calls = [
225         tool_call
226         for message in messages
227         if isinstance(message, AIMessage)
228         for tool_call in message.tool_calls
229     ]
230     tool_call_ids_with_results = {
231         message.tool_call_id for message in messages if isinstance(message, ToolMessage)
232     }
233     tool_calls_without_results = [
234         tool_call
235         for tool_call in all_tool_calls
236         if tool_call["id"] not in tool_call_ids_with_results
237     ]
238     if not tool_calls_without_results:
239         return
240 
241     error_message = create_error_message(
242         message="Found AIMessages with tool_calls that do not have a corresponding ToolMessage. "
243         f"Here are the first few of those tool calls: {tool_calls_without_results[:3]}.\n\n"
244         "Every tool call (LLM requesting to call a tool) in the message history MUST have a corresponding ToolMessage "
245         "(result of a tool invocation to return to the LLM) - this is required by most LLM providers.",
246         error_code=ErrorCode.INVALID_CHAT_HISTORY,
247     )
248     raise ValueError(error_message)
249 
250 
251 def create_react_agent(
252     model: Union[
253         str,
254         LanguageModelLike,
255         Callable[[StateSchema, Runtime[ContextT]], BaseChatModel],
256         Callable[[StateSchema, Runtime[ContextT]], Awaitable[BaseChatModel]],
257         Callable[
258             [StateSchema, Runtime[ContextT]], Runnable[LanguageModelInput, BaseMessage]
259         ],
260         Callable[
261             [StateSchema, Runtime[ContextT]],
262             Awaitable[Runnable[LanguageModelInput, BaseMessage]],
263         ],
264     ],
265     tools: Union[Sequence[Union[BaseTool, Callable, dict[str, Any]]], ToolNode],
266     *,
267     prompt: Optional[Prompt] = None,
268     response_format: Optional[
269         Union[StructuredResponseSchema, tuple[str, StructuredResponseSchema]]
270     ] = None,
271     pre_model_hook: Optional[RunnableLike] = None,
272     post_model_hook: Optional[RunnableLike] = None,
273     state_schema: Optional[StateSchemaType] = None,
274     context_schema: Optional[Type[Any]] = None,
275     checkpointer: Optional[Checkpointer] = None,
276     store: Optional[BaseStore] = None,
277     interrupt_before: Optional[list[str]] = None,
278     interrupt_after: Optional[list[str]] = None,
279     debug: bool = False,
280     version: Literal["v1", "v2"] = "v2",
281     name: Optional[str] = None,
282     **deprecated_kwargs: Any,
283 ) -> CompiledStateGraph:
284     """Creates an agent graph that calls tools in a loop until a stopping condition is met.
285 
286     For more details on using `create_react_agent`, visit [Agents](https://langchain-ai.github.io/langgraph/agents/overview/) documentation.
287 
288     Args:
289         model: The language model for the agent. Supports static and dynamic
290             model selection.
291 
292             - **Static model**: A chat model instance (e.g., `ChatOpenAI()`) or
293               string identifier (e.g., `"openai:gpt-4"`)
294             - **Dynamic model**: A callable with signature
295               `(state, runtime) -> BaseChatModel` that returns different models
296               based on runtime context
297               If the model has tools bound via `.bind_tools()` or other configurations,
298               the return type should be a Runnable[LanguageModelInput, BaseMessage]
299               Coroutines are also supported, allowing for asynchronous model selection.
300 
301             Dynamic functions receive graph state and runtime, enabling
302             context-dependent model selection. Must return a `BaseChatModel`
303             instance. For tool calling, bind tools using `.bind_tools()`.
304             Bound tools must be a subset of the `tools` parameter.
305 
306             Dynamic model example:
307             ```python
308             from dataclasses import dataclass
309 
310             @dataclass
311             class ModelContext:
312                 model_name: str = "gpt-3.5-turbo"
313 
314             # Instantiate models globally
315             gpt4_model = ChatOpenAI(model="gpt-4")
316             gpt35_model = ChatOpenAI(model="gpt-3.5-turbo")
317 
318             def select_model(state: AgentState, runtime: Runtime[ModelContext]) -> ChatOpenAI:
319                 model_name = runtime.context.model_name
320                 model = gpt4_model if model_name == "gpt-4" else gpt35_model
321                 return model.bind_tools(tools)
322             ```
323 
324             !!! note "Dynamic Model Requirements"
325                 Ensure returned models have appropriate tools bound via
326                 `.bind_tools()` and support required functionality. Bound tools
327                 must be a subset of those specified in the `tools` parameter.
328 
329         tools: A list of tools or a ToolNode instance.
330             If an empty list is provided, the agent will consist of a single LLM node without tool calling.
331         prompt: An optional prompt for the LLM. Can take a few different forms:
332 
333             - str: This is converted to a SystemMessage and added to the beginning of the list of messages in state["messages"].
334             - SystemMessage: this is added to the beginning of the list of messages in state["messages"].
335             - Callable: This function should take in full graph state and the output is then passed to the language model.
336             - Runnable: This runnable should take in full graph state and the output is then passed to the language model.
337 
338         response_format: An optional schema for the final agent output.
339 
340             If provided, output will be formatted to match the given schema and returned in the 'structured_response' state key.
341             If not provided, `structured_response` will not be present in the output state.
342             Can be passed in as:
343 
344                 - an OpenAI function/tool schema,
345                 - a JSON Schema,
346                 - a TypedDict class,
347                 - or a Pydantic class.
348                 - a tuple (prompt, schema), where schema is one of the above.
349                     The prompt will be used together with the model that is being used to generate the structured response.
350 
351             !!! Important
352                 `response_format` requires the model to support `.with_structured_output`
353 
354             !!! Note
355                 The graph will make a separate call to the LLM to generate the structured response after the agent loop is finished.
356                 This is not the only strategy to get structured responses, see more options in [this guide](https://langchain-ai.github.io/langgraph/how-tos/react-agent-structured-output/).
357 
358         pre_model_hook: An optional node to add before the `agent` node (i.e., the node that calls the LLM).
359             Useful for managing long message histories (e.g., message trimming, summarization, etc.).
360             Pre-model hook must be a callable or a runnable that takes in current graph state and returns a state update in the form of
361                 ```python
362                 # At least one of `messages` or `llm_input_messages` MUST be provided
363                 {
364                     # If provided, will UPDATE the `messages` in the state
365                     "messages": [RemoveMessage(id=REMOVE_ALL_MESSAGES), ...],
366                     # If provided, will be used as the input to the LLM,
367                     # and will NOT UPDATE `messages` in the state
368                     "llm_input_messages": [...],
369                     # Any other state keys that need to be propagated
370                     ...
371                 }
372                 ```
373 
374             !!! Important
375                 At least one of `messages` or `llm_input_messages` MUST be provided and will be used as an input to the `agent` node.
376                 The rest of the keys will be added to the graph state.
377 
378             !!! Warning
379                 If you are returning `messages` in the pre-model hook, you should OVERWRITE the `messages` key by doing the following:
380 
381                 ```python
382                 {
383                     "messages": [RemoveMessage(id=REMOVE_ALL_MESSAGES), *new_messages]
384                     ...
385                 }
386                 ```
387         post_model_hook: An optional node to add after the `agent` node (i.e., the node that calls the LLM).
388             Useful for implementing human-in-the-loop, guardrails, validation, or other post-processing.
389             Post-model hook must be a callable or a runnable that takes in current graph state and returns a state update.
390 
391             !!! Note
392                 Only available with `version="v2"`.
393         state_schema: An optional state schema that defines graph state.
394             Must have `messages` and `remaining_steps` keys.
395             Defaults to `AgentState` that defines those two keys.
396         context_schema: An optional schema for runtime context.
397         checkpointer: An optional checkpoint saver object. This is used for persisting
398             the state of the graph (e.g., as chat memory) for a single thread (e.g., a single conversation).
399         store: An optional store object. This is used for persisting data
400             across multiple threads (e.g., multiple conversations / users).
401         interrupt_before: An optional list of node names to interrupt before.
402             Should be one of the following: "agent", "tools".
403             This is useful if you want to add a user confirmation or other interrupt before taking an action.
404         interrupt_after: An optional list of node names to interrupt after.
405             Should be one of the following: "agent", "tools".
406             This is useful if you want to return directly or run additional processing on an output.
407         debug: A flag indicating whether to enable debug mode.
408         version: Determines the version of the graph to create.
409             Can be one of:
410 
411             - `"v1"`: The tool node processes a single message. All tool
412                 calls in the message are executed in parallel within the tool node.
413             - `"v2"`: The tool node processes a tool call.
414                 Tool calls are distributed across multiple instances of the tool
415                 node using the [Send](https://langchain-ai.github.io/langgraph/concepts/low_level/#send)
416                 API.
417         name: An optional name for the CompiledStateGraph.
418             This name will be automatically used when adding ReAct agent graph to another graph as a subgraph node -
419             particularly useful for building multi-agent systems.
420 
421     !!! warning "`config_schema` Deprecated"
422         The `config_schema` parameter is deprecated in v0.6.0 and support will be removed in v2.0.0.
423         Please use `context_schema` instead to specify the schema for run-scoped context.
424 
425 
426     Returns:
427         A compiled LangChain runnable that can be used for chat interactions.
428 
429     The "agent" node calls the language model with the messages list (after applying the prompt).
430     If the resulting AIMessage contains `tool_calls`, the graph will then call the ["tools"][langgraph.prebuilt.tool_node.ToolNode].
431     The "tools" node executes the tools (1 tool per `tool_call`) and adds the responses to the messages list
432     as `ToolMessage` objects. The agent node then calls the language model again.
433     The process repeats until no more `tool_calls` are present in the response.
434     The agent then returns the full list of messages as a dictionary containing the key "messages".
435 
436     ``` mermaid
437         sequenceDiagram
438             participant U as User
439             participant A as LLM
440             participant T as Tools
441             U->>A: Initial input
442             Note over A: Prompt + LLM
443             loop while tool_calls present
444                 A->>T: Execute tools
445                 T-->>A: ToolMessage for each tool_calls
446             end
447             A->>U: Return final state
448     ```
449 
450     Example:
451         ```python
452         from langgraph.prebuilt import create_react_agent
453 
454         def check_weather(location: str) -> str:
455             '''Return the weather forecast for the specified location.'''
456             return f"It's always sunny in {location}"
457 
458         graph = create_react_agent(
459             "anthropic:claude-3-7-sonnet-latest",
460             tools=[check_weather],
461             prompt="You are a helpful assistant",
462         )
463         inputs = {"messages": [{"role": "user", "content": "what is the weather in sf"}]}
464         for chunk in graph.stream(inputs, stream_mode="updates"):
465             print(chunk)
466         ```
467     """
468     if (
469         config_schema := deprecated_kwargs.pop("config_schema", MISSING)
470     ) is not MISSING:
471         warn(
472             "`config_schema` is deprecated and will be removed. Please use `context_schema` instead.",
473             category=LangGraphDeprecatedSinceV10,
474         )
475 
476         if context_schema is None:
477             context_schema = config_schema
478 
479     if version not in ("v1", "v2"):
480         raise ValueError(
481             f"Invalid version {version}. Supported versions are 'v1' and 'v2'."
482         )
483 
484     if state_schema is not None:
485         required_keys = {"messages", "remaining_steps"}
486         if response_format is not None:
487             required_keys.add("structured_response")
488 
489         schema_keys = set(get_type_hints(state_schema))
490         if missing_keys := required_keys - set(schema_keys):
491             raise ValueError(f"Missing required key(s) {missing_keys} in state_schema")
492 
493     if state_schema is None:
494         state_schema = (
495             AgentStateWithStructuredResponse
496             if response_format is not None
497             else AgentState
498         )
499 
500     llm_builtin_tools: list[dict] = []
501     if isinstance(tools, ToolNode):
502         tool_classes = list(tools.tools_by_name.values())
503         tool_node = tools
504     else:
505         llm_builtin_tools = [t for t in tools if isinstance(t, dict)]
506         tool_node = ToolNode([t for t in tools if not isinstance(t, dict)])
507         tool_classes = list(tool_node.tools_by_name.values())
508 
509     is_dynamic_model = not isinstance(model, (str, Runnable)) and callable(model)
510     is_async_dynamic_model = is_dynamic_model and inspect.iscoroutinefunction(model)
511 
512     tool_calling_enabled = len(tool_classes) > 0
513 
514     if not is_dynamic_model:
515         if isinstance(model, str):
516             try:
517                 from langchain.chat_models import (  # type: ignore[import-not-found]
518                     init_chat_model,
519                 )
520             except ImportError:
521                 raise ImportError(
522                     "Please install langchain (`pip install langchain`) to "
523                     "use '<provider>:<model>' string syntax for `model` parameter."
524                 )
525 
526             model = cast(BaseChatModel, init_chat_model(model))
527 
528         if (
529             _should_bind_tools(model, tool_classes, num_builtin=len(llm_builtin_tools))  # type: ignore[arg-type]
530             and len(tool_classes + llm_builtin_tools) > 0
531         ):
532             model = cast(BaseChatModel, model).bind_tools(
533                 tool_classes + llm_builtin_tools  # type: ignore[operator]
534             )
535 
536         static_model: Optional[Runnable] = _get_prompt_runnable(prompt) | model  # type: ignore[operator]
537     else:
538         # For dynamic models, we'll create the runnable at runtime
539         static_model = None
540 
541     # If any of the tools are configured to return_directly after running,
542     # our graph needs to check if these were called
543     should_return_direct = {t.name for t in tool_classes if t.return_direct}
544 
545     def _resolve_model(
546         state: StateSchema, runtime: Runtime[ContextT]
547     ) -> LanguageModelLike:
548         """Resolve the model to use, handling both static and dynamic models."""
549         if is_dynamic_model:
550             return _get_prompt_runnable(prompt) | model(state, runtime)  # type: ignore[operator]
551         else:
552             return static_model
553 
554     async def _aresolve_model(
555         state: StateSchema, runtime: Runtime[ContextT]
556     ) -> LanguageModelLike:
557         """Async resolve the model to use, handling both static and dynamic models."""
558         if is_async_dynamic_model:
559             resolved_model = await model(state, runtime)  # type: ignore[misc,operator]
560             return _get_prompt_runnable(prompt) | resolved_model
561         elif is_dynamic_model:
562             return _get_prompt_runnable(prompt) | model(state, runtime)  # type: ignore[operator]
563         else:
564             return static_model
565 
566     def _are_more_steps_needed(state: StateSchema, response: BaseMessage) -> bool:
567         has_tool_calls = isinstance(response, AIMessage) and response.tool_calls
568         all_tools_return_direct = (
569             all(call["name"] in should_return_direct for call in response.tool_calls)
570             if isinstance(response, AIMessage)
571             else False
572         )
573         remaining_steps = _get_state_value(state, "remaining_steps", None)
574         is_last_step = _get_state_value(state, "is_last_step", False)
575         return (
576             (remaining_steps is None and is_last_step and has_tool_calls)
577             or (
578                 remaining_steps is not None
579                 and remaining_steps < 1
580                 and all_tools_return_direct
581             )
582             or (remaining_steps is not None and remaining_steps < 2 and has_tool_calls)
583         )
584 
585     def _get_model_input_state(state: StateSchema) -> StateSchema:
586         if pre_model_hook is not None:
587             messages = (
588                 _get_state_value(state, "llm_input_messages")
589             ) or _get_state_value(state, "messages")
590             error_msg = f"Expected input to call_model to have 'llm_input_messages' or 'messages' key, but got {state}"
591         else:
592             messages = _get_state_value(state, "messages")
593             error_msg = (
594                 f"Expected input to call_model to have 'messages' key, but got {state}"
595             )
596 
597         if messages is None:
598             raise ValueError(error_msg)
599 
600         _validate_chat_history(messages)
601         # we're passing messages under `messages` key, as this is expected by the prompt
602         if isinstance(state_schema, type) and issubclass(state_schema, BaseModel):
603             state.messages = messages  # type: ignore
604         else:
605             state["messages"] = messages  # type: ignore
606 
607         return state
608 
609     # Define the function that calls the model
610     def call_model(
611         state: StateSchema, runtime: Runtime[ContextT], config: RunnableConfig
612     ) -> StateSchema:
613         if is_async_dynamic_model:
614             msg = (
615                 "Async model callable provided but agent invoked synchronously. "
616                 "Use agent.ainvoke() or agent.astream(), or "
617                 "provide a sync model callable."
618             )
619             raise RuntimeError(msg)
620 
621         model_input = _get_model_input_state(state)
622 
623         if is_dynamic_model:
624             # Resolve dynamic model at runtime and apply prompt
625             dynamic_model = _resolve_model(state, runtime)
626             response = cast(AIMessage, dynamic_model.invoke(model_input, config))  # type: ignore[arg-type]
627         else:
628             response = cast(AIMessage, static_model.invoke(model_input, config))  # type: ignore[union-attr]
629 
630         # add agent name to the AIMessage
631         response.name = name
632 
633         if _are_more_steps_needed(state, response):
634             return {
635                 "messages": [
636                     AIMessage(
637                         id=response.id,
638                         content="Sorry, need more steps to process this request.",
639                     )
640                 ]
641             }
642         # We return a list, because this will get added to the existing list
643         return {"messages": [response]}
644 
645     async def acall_model(
646         state: StateSchema, runtime: Runtime[ContextT], config: RunnableConfig
647     ) -> StateSchema:
648         model_input = _get_model_input_state(state)
649 
650         if is_dynamic_model:
651             # Resolve dynamic model at runtime and apply prompt
652             # (supports both sync and async)
653             dynamic_model = await _aresolve_model(state, runtime)
654             response = cast(AIMessage, await dynamic_model.ainvoke(model_input, config))  # type: ignore[arg-type]
655         else:
656             response = cast(AIMessage, await static_model.ainvoke(model_input, config))  # type: ignore[union-attr]
657 
658         # add agent name to the AIMessage
659         response.name = name
660         if _are_more_steps_needed(state, response):
661             return {
662                 "messages": [
663                     AIMessage(
664                         id=response.id,
665                         content="Sorry, need more steps to process this request.",
666                     )
667                 ]
668             }
669         # We return a list, because this will get added to the existing list
670         return {"messages": [response]}
671 
672     input_schema: StateSchemaType
673     if pre_model_hook is not None:
674         # Dynamically create a schema that inherits from state_schema and adds 'llm_input_messages'
675         if isinstance(state_schema, type) and issubclass(state_schema, BaseModel):
676             # For Pydantic schemas
677             from pydantic import create_model
678 
679             input_schema = create_model(
680                 "CallModelInputSchema",
681                 llm_input_messages=(list[AnyMessage], ...),
682                 __base__=state_schema,
683             )
684         else:
685             # For TypedDict schemas
686             class CallModelInputSchema(state_schema):  # type: ignore
687                 llm_input_messages: list[AnyMessage]
688 
689             input_schema = CallModelInputSchema
690     else:
691         input_schema = state_schema
692 
693     def generate_structured_response(
694         state: StateSchema, runtime: Runtime[ContextT], config: RunnableConfig
695     ) -> StateSchema:
696         if is_async_dynamic_model:
697             msg = (
698                 "Async model callable provided but agent invoked synchronously. "
699                 "Use agent.ainvoke() or agent.astream(), or provide a sync model callable."
700             )
701             raise RuntimeError(msg)
702 
703         messages = _get_state_value(state, "messages")
704         structured_response_schema = response_format
705         if isinstance(response_format, tuple):
706             system_prompt, structured_response_schema = response_format
707             messages = [SystemMessage(content=system_prompt)] + list(messages)
708 
709         resolved_model = _resolve_model(state, runtime)
710         model_with_structured_output = _get_model(
711             resolved_model
712         ).with_structured_output(
713             cast(StructuredResponseSchema, structured_response_schema)
714         )
715         response = model_with_structured_output.invoke(messages, config)
716         return {"structured_response": response}
717 
718     async def agenerate_structured_response(
719         state: StateSchema, runtime: Runtime[ContextT], config: RunnableConfig
720     ) -> StateSchema:
721         messages = _get_state_value(state, "messages")
722         structured_response_schema = response_format
723         if isinstance(response_format, tuple):
724             system_prompt, structured_response_schema = response_format
725             messages = [SystemMessage(content=system_prompt)] + list(messages)
726 
727         resolved_model = await _aresolve_model(state, runtime)
728         model_with_structured_output = _get_model(
729             resolved_model
730         ).with_structured_output(
731             cast(StructuredResponseSchema, structured_response_schema)
732         )
733         response = await model_with_structured_output.ainvoke(messages, config)
734         return {"structured_response": response}
735 
736     if not tool_calling_enabled:
737         # Define a new graph
738         workflow = StateGraph(state_schema=state_schema, context_schema=context_schema)
739         workflow.add_node(
740             "agent",
741             RunnableCallable(call_model, acall_model),
742             input_schema=input_schema,
743         )
744         if pre_model_hook is not None:
745             workflow.add_node("pre_model_hook", pre_model_hook)  # type: ignore[arg-type]
746             workflow.add_edge("pre_model_hook", "agent")
747             entrypoint = "pre_model_hook"
748         else:
749             entrypoint = "agent"
750 
751         workflow.set_entry_point(entrypoint)
752 
753         if post_model_hook is not None:
754             workflow.add_node("post_model_hook", post_model_hook)  # type: ignore[arg-type]
755             workflow.add_edge("agent", "post_model_hook")
756 
757         if response_format is not None:
758             workflow.add_node(
759                 "generate_structured_response",
760                 RunnableCallable(
761                     generate_structured_response,
762                     agenerate_structured_response,
763                 ),
764             )
765             if post_model_hook is not None:
766                 workflow.add_edge("post_model_hook", "generate_structured_response")
767             else:
768                 workflow.add_edge("agent", "generate_structured_response")
769 
770         return workflow.compile(
771             checkpointer=checkpointer,
772             store=store,
773             interrupt_before=interrupt_before,
774             interrupt_after=interrupt_after,
775             debug=debug,
776             name=name,
777         )
778 
779     # Define the function that determines whether to continue or not
780     def should_continue(state: StateSchema) -> Union[str, list[Send]]:
781         messages = _get_state_value(state, "messages")
782         last_message = messages[-1]
783         # If there is no function call, then we finish
784         if not isinstance(last_message, AIMessage) or not last_message.tool_calls:
785             if post_model_hook is not None:
786                 return "post_model_hook"
787             elif response_format is not None:
788                 return "generate_structured_response"
789             else:
790                 return END
791         # Otherwise if there is, we continue
792         else:
793             if version == "v1":
794                 return "tools"
795             elif version == "v2":
796                 if post_model_hook is not None:
797                     return "post_model_hook"
798                 return [
799                     Send(
800                         "tools",
801                         ToolCallWithContext(
802                             __type="tool_call_with_context",
803                             tool_call=tool_call,
804                             state=state,
805                         ),
806                     )
807                     for tool_call in last_message.tool_calls
808                 ]
809 
810     # Define a new graph
811     workflow = StateGraph(
812         state_schema=state_schema or AgentState, context_schema=context_schema
813     )
814 
815     # Define the two nodes we will cycle between
816     workflow.add_node(
817         "agent",
818         RunnableCallable(call_model, acall_model),
819         input_schema=input_schema,
820     )
821     workflow.add_node("tools", tool_node)
822 
823     # Optionally add a pre-model hook node that will be called
824     # every time before the "agent" (LLM-calling node)
825     if pre_model_hook is not None:
826         workflow.add_node("pre_model_hook", pre_model_hook)  # type: ignore[arg-type]
827         workflow.add_edge("pre_model_hook", "agent")
828         entrypoint = "pre_model_hook"
829     else:
830         entrypoint = "agent"
831 
832     # Set the entrypoint as `agent`
833     # This means that this node is the first one called
834     workflow.set_entry_point(entrypoint)
835 
836     agent_paths = []
837     post_model_hook_paths = [entrypoint, "tools"]
838 
839     # Add a post model hook node if post_model_hook is provided
840     if post_model_hook is not None:
841         workflow.add_node("post_model_hook", post_model_hook)  # type: ignore[arg-type]
842         agent_paths.append("post_model_hook")
843         workflow.add_edge("agent", "post_model_hook")
844     else:
845         agent_paths.append("tools")
846 
847     # Add a structured output node if response_format is provided
848     if response_format is not None:
849         workflow.add_node(
850             "generate_structured_response",
851             RunnableCallable(
852                 generate_structured_response,
853                 agenerate_structured_response,
854             ),
855         )
856         if post_model_hook is not None:
857             post_model_hook_paths.append("generate_structured_response")
858         else:
859             agent_paths.append("generate_structured_response")
860     else:
861         if post_model_hook is not None:
862             post_model_hook_paths.append(END)
863         else:
864             agent_paths.append(END)
865 
866     if post_model_hook is not None:
867 
868         def post_model_hook_router(state: StateSchema) -> Union[str, list[Send]]:
869             """Route to the next node after post_model_hook.
870 
871             Routes to one of:
872             * "tools": if there are pending tool calls without a corresponding message.
873             * "generate_structured_response": if no pending tool calls exist and response_format is specified.
874             * END: if no pending tool calls exist and no response_format is specified.
875             """
876 
877             messages = _get_state_value(state, "messages")
878             tool_messages = [
879                 m.tool_call_id for m in messages if isinstance(m, ToolMessage)
880             ]
881             last_ai_message = next(
882                 m for m in reversed(messages) if isinstance(m, AIMessage)
883             )
884             pending_tool_calls = [
885                 c for c in last_ai_message.tool_calls if c["id"] not in tool_messages
886             ]
887 
888             if pending_tool_calls:
889                 return [
890                     Send(
891                         "tools",
892                         ToolCallWithContext(
893                             __type="tool_call_with_context",
894                             tool_call=tool_call,
895                             state=state,
896                         ),
897                     )
898                     for tool_call in pending_tool_calls
899                 ]
900             elif isinstance(messages[-1], ToolMessage):
901                 return entrypoint
902             elif response_format is not None:
903                 return "generate_structured_response"
904             else:
905                 return END
906 
907         workflow.add_conditional_edges(
908             "post_model_hook",
909             post_model_hook_router,  # type: ignore[arg-type]
910             path_map=post_model_hook_paths,
911         )
912 
913     workflow.add_conditional_edges(
914         "agent",
915         should_continue,  # type: ignore[arg-type]
916         path_map=agent_paths,
917     )
918 
919     def route_tool_responses(state: StateSchema) -> str:
920         for m in reversed(_get_state_value(state, "messages")):
921             if not isinstance(m, ToolMessage):
922                 break
923             if m.name in should_return_direct:
924                 return END
925 
926         # handle a case of parallel tool calls where
927         # the tool w/ `return_direct` was executed in a different `Send`
928         if isinstance(m, AIMessage) and m.tool_calls:
929             if any(call["name"] in should_return_direct for call in m.tool_calls):
930                 return END
931 
932         return entrypoint
933 
934     if should_return_direct:
935         workflow.add_conditional_edges(
936             "tools", route_tool_responses, path_map=[entrypoint, END]
937         )
938     else:
939         workflow.add_edge("tools", entrypoint)
940 
941     # Finally, we compile it!
942     # This compiles it into a LangChain Runnable,
943     # meaning you can use it as you would any other runnable
944     return workflow.compile(
945         checkpointer=checkpointer,
946         store=store,
947         interrupt_before=interrupt_before,
948         interrupt_after=interrupt_after,
949         debug=debug,
950         name=name,
951     )
952 
953 
954 # Keep for backwards compatibility
955 create_tool_calling_executor = create_react_agent
956 
