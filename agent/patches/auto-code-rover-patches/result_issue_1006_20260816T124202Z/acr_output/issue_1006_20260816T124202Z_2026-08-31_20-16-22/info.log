323     def __call__(
324         self,
325         prompt: AgentInput = None,
326         *,
327         invocation_state: dict[str, Any] | None = None,
328         structured_output_model: Type[BaseModel] | None = None,
329         **kwargs: Any,
330     ) -> AgentResult:
331         """Process a natural language prompt through the agent's event loop.
332 
333         This method implements the conversational interface with multiple input patterns:
334         - String input: `agent("hello!")`
335         - ContentBlock list: `agent([{"text": "hello"}, {"image": {...}}])`
336         - Message list: `agent([{"role": "user", "content": [{"text": "hello"}]}])`
337         - No input: `agent()` - uses existing conversation history
338 
339         Args:
340             prompt: User input in various formats:
341                 - str: Simple text input
342                 - list[ContentBlock]: Multi-modal content blocks
343                 - list[Message]: Complete messages with roles
344                 - None: Use existing conversation history
345             invocation_state: Additional parameters to pass through the event loop.
346             structured_output_model: Pydantic model type(s) for structured output (overrides agent default).
347             **kwargs: Additional parameters to pass through the event loop.[Deprecating]
348 
349         Returns:
350             Result object containing:
351 
352                 - stop_reason: Why the event loop stopped (e.g., "end_turn", "max_tokens")
353                 - message: The final message from the model
354                 - metrics: Performance metrics from the event loop
355                 - state: The final state of the event loop
356                 - structured_output: Parsed structured output when structured_output_model was specified
357         """
358         return run_async(
359             lambda: self.invoke_async(
360                 prompt, invocation_state=invocation_state, structured_output_model=structured_output_model, **kwargs
361             )
362         )
363 
364     async def invoke_async(
365         self,
366         prompt: AgentInput = None,
367         *,
368         invocation_state: dict[str, Any] | None = None,
369         structured_output_model: Type[BaseModel] | None = None,
370         **kwargs: Any,
371     ) -> AgentResult:
372         """Process a natural language prompt through the agent's event loop.
373 
374         This method implements the conversational interface with multiple input patterns:
375         - String input: Simple text input
376         - ContentBlock list: Multi-modal content blocks
377         - Message list: Complete messages with roles
378         - No input: Use existing conversation history
379 
380         Args:
381             prompt: User input in various formats:
382                 - str: Simple text input
383                 - list[ContentBlock]: Multi-modal content blocks
384                 - list[Message]: Complete messages with roles
385                 - None: Use existing conversation history
386             invocation_state: Additional parameters to pass through the event loop.
387             structured_output_model: Pydantic model type(s) for structured output (overrides agent default).
388             **kwargs: Additional parameters to pass through the event loop.[Deprecating]
389 
390         Returns:
391             Result: object containing:
392 
393                 - stop_reason: Why the event loop stopped (e.g., "end_turn", "max_tokens")
394                 - message: The final message from the model
395                 - metrics: Performance metrics from the event loop
396                 - state: The final state of the event loop
397         """
398         events = self.stream_async(
399             prompt, invocation_state=invocation_state, structured_output_model=structured_output_model, **kwargs
400         )
401         async for event in events:
402             _ = event
403 
404         return cast(AgentResult, event["result"])
405 
406     def structured_output(self, output_model: Type[T], prompt: AgentInput = None) -> T:
407         """This method allows you to get structured output from the agent.
408 
409         If you pass in a prompt, it will be used temporarily without adding it to the conversation history.
410         If you don't pass in a prompt, it will use only the existing conversation history to respond.
411 
412         For smaller models, you may want to use the optional prompt to add additional instructions to explicitly
413         instruct the model to output the structured data.
414 
415         Args:
416             output_model: The output model (a JSON schema written as a Pydantic BaseModel)
417                 that the agent will use when responding.
418             prompt: The prompt to use for the agent in various formats:
419                 - str: Simple text input
420                 - list[ContentBlock]: Multi-modal content blocks
421                 - list[Message]: Complete messages with roles
422                 - None: Use existing conversation history
423 
424         Raises:
425             ValueError: If no conversation history or prompt is provided.
426         """
427         warnings.warn(
428             "Agent.structured_output method is deprecated."
429             " You should pass in `structured_output_model` directly into the agent invocation."
430             " see: https://strandsagents.com/latest/documentation/docs/user-guide/concepts/agents/structured-output/",
431             category=DeprecationWarning,
432             stacklevel=2,
433         )
434 
435         return run_async(lambda: self.structured_output_async(output_model, prompt))
436 
437     async def structured_output_async(self, output_model: Type[T], prompt: AgentInput = None) -> T:
438         """This method allows you to get structured output from the agent.
439 
440         If you pass in a prompt, it will be used temporarily without adding it to the conversation history.
441         If you don't pass in a prompt, it will use only the existing conversation history to respond.
442 
443         For smaller models, you may want to use the optional prompt to add additional instructions to explicitly
444         instruct the model to output the structured data.
445 
446         Args:
447             output_model: The output model (a JSON schema written as a Pydantic BaseModel)
448                 that the agent will use when responding.
449             prompt: The prompt to use for the agent (will not be added to conversation history).
450 
451         Raises:
452             ValueError: If no conversation history or prompt is provided.
453         -
454         """
455         if self._interrupt_state.activated:
456             raise RuntimeError("cannot call structured output during interrupt")
457 
458         warnings.warn(
459             "Agent.structured_output_async method is deprecated."
460             " You should pass in `structured_output_model` directly into the agent invocation."
461             " see: https://strandsagents.com/latest/documentation/docs/user-guide/concepts/agents/structured-output/",
462             category=DeprecationWarning,
463             stacklevel=2,
464         )
465         await self.hooks.invoke_callbacks_async(BeforeInvocationEvent(agent=self))
466         with self.tracer.tracer.start_as_current_span(
467             "execute_structured_output", kind=trace_api.SpanKind.CLIENT
468         ) as structured_output_span:
469             try:
470                 if not self.messages and not prompt:
471                     raise ValueError("No conversation history or prompt provided")
472 
473                 temp_messages: Messages = self.messages + await self._convert_prompt_to_messages(prompt)
474 
475                 structured_output_span.set_attributes(
476                     {
477                         "gen_ai.system": "strands-agents",
478                         "gen_ai.agent.name": self.name,
479                         "gen_ai.agent.id": self.agent_id,
480                         "gen_ai.operation.name": "execute_structured_output",
481                     }
482                 )
483                 if self.system_prompt:
484                     structured_output_span.add_event(
485                         "gen_ai.system.message",
486                         attributes={"role": "system", "content": serialize([{"text": self.system_prompt}])},
487                     )
488                 for message in temp_messages:
489                     structured_output_span.add_event(
490                         f"gen_ai.{message['role']}.message",
491                         attributes={"role": message["role"], "content": serialize(message["content"])},
492                     )
493                 events = self.model.structured_output(output_model, temp_messages, system_prompt=self.system_prompt)
494                 async for event in events:
495                     if isinstance(event, TypedEvent):
496                         event.prepare(invocation_state={})
497                         if event.is_callback_event:
498                             self.callback_handler(**event.as_dict())
499 
500                 structured_output_span.add_event(
501                     "gen_ai.choice", attributes={"message": serialize(event["output"].model_dump())}
502                 )
503                 return event["output"]
504 
505             finally:
506                 await self.hooks.invoke_callbacks_async(AfterInvocationEvent(agent=self))
507 
508     def cleanup(self) -> None:
509         """Clean up resources used by the agent.
510 
511         This method cleans up all tool providers that require explicit cleanup,
512         such as MCP clients. It should be called when the agent is no longer needed
513         to ensure proper resource cleanup.
514 
515         Note: This method uses a "belt and braces" approach with automatic cleanup
516         through finalizers as a fallback, but explicit cleanup is recommended.
517         """
518         self.tool_registry.cleanup()
519 
520     def __del__(self) -> None:
521         """Clean up resources when agent is garbage collected."""
522         # __del__ is called even when an exception is thrown in the constructor,
523         # so there is no guarantee tool_registry was set..
524         if hasattr(self, "tool_registry"):
525             self.tool_registry.cleanup()
526 
527     async def stream_async(
528         self,
529         prompt: AgentInput = None,
530         *,
531         invocation_state: dict[str, Any] | None = None,
532         structured_output_model: Type[BaseModel] | None = None,
533         **kwargs: Any,
534     ) -> AsyncIterator[Any]:
535         """Process a natural language prompt and yield events as an async iterator.
536 
537         This method provides an asynchronous interface for streaming agent events with multiple input patterns:
538         - String input: Simple text input
539         - ContentBlock list: Multi-modal content blocks
540         - Message list: Complete messages with roles
541         - No input: Use existing conversation history
542 
543         Args:
544             prompt: User input in various formats:
545                 - str: Simple text input
546                 - list[ContentBlock]: Multi-modal content blocks
547                 - list[Message]: Complete messages with roles
548                 - None: Use existing conversation history
549             invocation_state: Additional parameters to pass through the event loop.
550             structured_output_model: Pydantic model type(s) for structured output (overrides agent default).
551             **kwargs: Additional parameters to pass to the event loop.[Deprecating]
552 
553         Yields:
554             An async iterator that yields events. Each event is a dictionary containing
555                 information about the current state of processing, such as:
556 
557                 - data: Text content being generated
558                 - complete: Whether this is the final chunk
559                 - current_tool_use: Information about tools being executed
560                 - And other event data provided by the callback handler
561 
562         Raises:
563             ConcurrencyException: If another invocation is already in progress on this agent instance.
564             Exception: Any exceptions from the agent invocation will be propagated to the caller.
565 
566         Example:
567             ```python
568             async for event in agent.stream_async("Analyze this data"):
569                 if "data" in event:
570                     yield event["data"]
571             ```
572         """
573         # Acquire lock to prevent concurrent invocations
574         # Using threading.Lock instead of asyncio.Lock because run_async() creates
575         # separate event loops in different threads
576         acquired = self._invocation_lock.acquire(blocking=False)
577         if not acquired:
578             raise ConcurrencyException(
579                 "Agent is already processing a request. Concurrent invocations are not supported."
580             )
581 
582         try:
583             self._interrupt_state.resume(prompt)
584 
585             self.event_loop_metrics.reset_usage_metrics()
586 
587             merged_state = {}
588             if kwargs:
589                 warnings.warn("`**kwargs` parameter is deprecating, use `invocation_state` instead.", stacklevel=2)
590                 merged_state.update(kwargs)
591                 if invocation_state is not None:
592                     merged_state["invocation_state"] = invocation_state
593             else:
594                 if invocation_state is not None:
595                     merged_state = invocation_state
596 
597             callback_handler = self.callback_handler
598             if kwargs:
599                 callback_handler = kwargs.get("callback_handler", self.callback_handler)
600 
601             # Process input and get message to add (if any)
602             messages = await self._convert_prompt_to_messages(prompt)
603 
604             self.trace_span = self._start_agent_trace_span(messages)
605 
606             with trace_api.use_span(self.trace_span):
607                 try:
608                     events = self._run_loop(messages, merged_state, structured_output_model)
609 
610                     async for event in events:
611                         event.prepare(invocation_state=merged_state)
612 
613                         if event.is_callback_event:
614                             as_dict = event.as_dict()
615                             callback_handler(**as_dict)
616                             yield as_dict
617 
618                     result = AgentResult(*event["stop"])
619                     callback_handler(result=result)
620                     yield AgentResultEvent(result=result).as_dict()
621 
622                     self._end_agent_trace_span(response=result)
623 
624                 except Exception as e:
625                     self._end_agent_trace_span(error=e)
626                     raise
627 
628         finally:
629             self._invocation_lock.release()
630 
631     async def _run_loop(
632         self,
633         messages: Messages,
634         invocation_state: dict[str, Any],
635         structured_output_model: Type[BaseModel] | None = None,
636     ) -> AsyncGenerator[TypedEvent, None]:
637         """Execute the agent's event loop with the given message and parameters.
638 
639         Args:
640             messages: The input messages to add to the conversation.
641             invocation_state: Additional parameters to pass to the event loop.
642             structured_output_model: Optional Pydantic model type for structured output.
643 
644         Yields:
645             Events from the event loop cycle.
646         """
647         await self.hooks.invoke_callbacks_async(BeforeInvocationEvent(agent=self))
648 
649         agent_result: AgentResult | None = None
650         try:
651             yield InitEventLoopEvent()
652 
653             await self._append_messages(*messages)
654 
655             structured_output_context = StructuredOutputContext(
656                 structured_output_model or self._default_structured_output_model
657             )
658 
659             # Execute the event loop cycle with retry logic for context limits
660             events = self._execute_event_loop_cycle(invocation_state, structured_output_context)
661             async for event in events:
662                 # Signal from the model provider that the message sent by the user should be redacted,
663                 # likely due to a guardrail.
664                 if (
665                     isinstance(event, ModelStreamChunkEvent)
666                     and event.chunk
667                     and event.chunk.get("redactContent")
668                     and event.chunk["redactContent"].get("redactUserContentMessage")
669                 ):
670                     self.messages[-1]["content"] = self._redact_user_content(
671                         self.messages[-1]["content"], str(event.chunk["redactContent"]["redactUserContentMessage"])
672                     )
673                     if self._session_manager:
674                         self._session_manager.redact_latest_message(self.messages[-1], self)
675                 yield event
676 
677             # Capture the result from the final event if available
678             if isinstance(event, EventLoopStopEvent):
679                 agent_result = AgentResult(*event["stop"])
680 
681         finally:
682             self.conversation_manager.apply_management(self)
683             await self.hooks.invoke_callbacks_async(AfterInvocationEvent(agent=self, result=agent_result))
684 
685     async def _execute_event_loop_cycle(
686         self, invocation_state: dict[str, Any], structured_output_context: StructuredOutputContext | None = None
687     ) -> AsyncGenerator[TypedEvent, None]:
688         """Execute the event loop cycle with retry logic for context window limits.
689 
690         This internal method handles the execution of the event loop cycle and implements
691         retry logic for handling context window overflow exceptions by reducing the
692         conversation context and retrying.
693 
694         Args:
695             invocation_state: Additional parameters to pass to the event loop.
696             structured_output_context: Optional structured output context for this invocation.
697 
698         Yields:
699             Events of the loop cycle.
700         """
701         # Add `Agent` to invocation_state to keep backwards-compatibility
702         invocation_state["agent"] = self
703 
704         if structured_output_context:
705             structured_output_context.register_tool(self.tool_registry)
706 
707         try:
708             events = event_loop_cycle(
709                 agent=self,
710                 invocation_state=invocation_state,
711                 structured_output_context=structured_output_context,
712             )
713             async for event in events:
714                 yield event
715 
716         except ContextWindowOverflowException as e:
717             # Try reducing the context size and retrying
718             self.conversation_manager.reduce_context(self, e=e)
719 
720             # Sync agent after reduce_context to keep conversation_manager_state up to date in the session
721             if self._session_manager:
722                 self._session_manager.sync_agent(self)
723 
724             events = self._execute_event_loop_cycle(invocation_state, structured_output_context)
725             async for event in events:
726                 yield event
727 
728         finally:
729             if structured_output_context:
730                 structured_output_context.cleanup(self.tool_registry)
731 
732     async def _convert_prompt_to_messages(self, prompt: AgentInput) -> Messages:
733         if self._interrupt_state.activated:
734             return []
735 
736         messages: Messages | None = None
737         if prompt is not None:
738             # Check if the latest message is toolUse
739             if len(self.messages) > 0 and any("toolUse" in content for content in self.messages[-1]["content"]):
740                 # Add toolResult message after to have a valid conversation
741                 logger.info(
742                     "Agents latest message is toolUse, appending a toolResult message to have valid conversation."
743                 )
744                 tool_use_ids = [
745                     content["toolUse"]["toolUseId"] for content in self.messages[-1]["content"] if "toolUse" in content
746                 ]
747                 await self._append_messages(
748                     {
749                         "role": "user",
750                         "content": generate_missing_tool_result_content(tool_use_ids),
751                     }
752                 )
753             if isinstance(prompt, str):
754                 # String input - convert to user message
755                 messages = [{"role": "user", "content": [{"text": prompt}]}]
756             elif isinstance(prompt, list):
757                 if len(prompt) == 0:
758                     # Empty list
759                     messages = []
760                 # Check if all item in input list are dictionaries
761                 elif all(isinstance(item, dict) for item in prompt):
762                     # Check if all items are messages
763                     if all(all(key in item for key in Message.__annotations__.keys()) for item in prompt):
764                         # Messages input - add all messages to conversation
765                         messages = cast(Messages, prompt)
766 
767                     # Check if all items are content blocks
768                     elif all(any(key in ContentBlock.__annotations__.keys() for key in item) for item in prompt):
769                         # Treat as List[ContentBlock] input - convert to user message
770                         # This allows invalid structures to be passed through to the model
771                         messages = [{"role": "user", "content": cast(list[ContentBlock], prompt)}]
772         else:
773             messages = []
774         if messages is None:
775             raise ValueError("Input prompt must be of type: `str | list[Contentblock] | Messages | None`.")
776         return messages
777 
778     def _start_agent_trace_span(self, messages: Messages) -> trace_api.Span:
779         """Starts a trace span for the agent.
780 
781         Args:
782             messages: The input messages.
783         """
784         model_id = self.model.config.get("model_id") if hasattr(self.model, "config") else None
785         return self.tracer.start_agent_span(
786             messages=messages,
787             agent_name=self.name,
788             model_id=model_id,
789             tools=self.tool_names,
790             system_prompt=self.system_prompt,
791             custom_trace_attributes=self.trace_attributes,
792             tools_config=self.tool_registry.get_all_tools_config(),
793         )
794 
795     def _end_agent_trace_span(
796         self,
797         response: Optional[AgentResult] = None,
798         error: Optional[Exception] = None,
799     ) -> None:
800         """Ends a trace span for the agent.
801 
802         Args:
803             span: The span to end.
804             response: Response to record as a trace attribute.
805             error: Error to record as a trace attribute.
806         """
807         if self.trace_span:
808             trace_attributes: dict[str, Any] = {
809                 "span": self.trace_span,
810             }
811 
812             if response:
813                 trace_attributes["response"] = response
814             if error:
815                 trace_attributes["error"] = error
816 
817             self.tracer.end_agent_span(**trace_attributes)
818 
819     def _initialize_system_prompt(
820         self, system_prompt: str | list[SystemContentBlock] | None
821     ) -> tuple[str | None, list[SystemContentBlock] | None]:
822         """Initialize system prompt fields from constructor input.
823 
824         Maintains backwards compatibility by keeping system_prompt as str when string input
825         provided, avoiding breaking existing consumers.
826 
827         Maps system_prompt input to both string and content block representations:
828         - If string: system_prompt=string, _system_prompt_content=[{text: string}]
829         - If list with text elements: system_prompt=concatenated_text, _system_prompt_content=list
830         - If list without text elements: system_prompt=None, _system_prompt_content=list
831         - If None: system_prompt=None, _system_prompt_content=None
832         """
833         if isinstance(system_prompt, str):
834             return system_prompt, [{"text": system_prompt}]
835         elif isinstance(system_prompt, list):
836             # Concatenate all text elements for backwards compatibility, None if no text found
837             text_parts = [block["text"] for block in system_prompt if "text" in block]
838             system_prompt_str = "\n".join(text_parts) if text_parts else None
839             return system_prompt_str, system_prompt
840         else:
841             return None, None
842 
843     async def _append_messages(self, *messages: Message) -> None:
844         """Appends messages to history and invoke the callbacks for the MessageAddedEvent."""
845         for message in messages:
846             self.messages.append(message)
847             await self.hooks.invoke_callbacks_async(MessageAddedEvent(agent=self, message=message))
