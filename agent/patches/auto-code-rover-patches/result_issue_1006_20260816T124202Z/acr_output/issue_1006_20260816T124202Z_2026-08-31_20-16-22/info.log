90 class Agent:
91     """Core Agent implementation.
92 
93     An agent orchestrates the following workflow:
94 
95     1. Receives user input
96     2. Processes the input using a language model
97     3. Decides whether to use tools to gather information or perform actions
98     4. Executes those tools and receives results
99     5. Continues reasoning with the new information
100     6. Produces a final response
101     """
102 
103     # For backwards compatibility
104     ToolCaller = _ToolCaller
105 
106     def __init__(
107         self,
108         model: Union[Model, str, None] = None,
109         messages: Optional[Messages] = None,
110         tools: Optional[list[Union[str, dict[str, str], "ToolProvider", Any]]] = None,
111         system_prompt: Optional[str | list[SystemContentBlock]] = None,
112         structured_output_model: Optional[Type[BaseModel]] = None,
113         callback_handler: Optional[
114             Union[Callable[..., Any], _DefaultCallbackHandlerSentinel]
115         ] = _DEFAULT_CALLBACK_HANDLER,
116         conversation_manager: Optional[ConversationManager] = None,
117         record_direct_tool_call: bool = True,
118         load_tools_from_directory: bool = False,
119         trace_attributes: Optional[Mapping[str, AttributeValue]] = None,
120         *,
121         agent_id: Optional[str] = None,
122         name: Optional[str] = None,
123         description: Optional[str] = None,
124         state: Optional[Union[AgentState, dict]] = None,
125         hooks: Optional[list[HookProvider]] = None,
126         session_manager: Optional[SessionManager] = None,
127         tool_executor: Optional[ToolExecutor] = None,
128     ):
129         """Initialize the Agent with the specified configuration.
130 
131         Args:
132             model: Provider for running inference or a string representing the model-id for Bedrock to use.
133                 Defaults to strands.models.BedrockModel if None.
134             messages: List of initial messages to pre-load into the conversation.
135                 Defaults to an empty list if None.
136             tools: List of tools to make available to the agent.
137                 Can be specified as:
138 
139                 - String tool names (e.g., "retrieve")
140                 - File paths (e.g., "/path/to/tool.py")
141                 - Imported Python modules (e.g., from strands_tools import current_time)
142                 - Dictionaries with name/path keys (e.g., {"name": "tool_name", "path": "/path/to/tool.py"})
143                 - ToolProvider instances for managed tool collections
144                 - Functions decorated with `@strands.tool` decorator.
145 
146                 If provided, only these tools will be available. If None, all tools will be available.
147             system_prompt: System prompt to guide model behavior.
148                 Can be a string or a list of SystemContentBlock objects for advanced features like caching.
149                 If None, the model will behave according to its default settings.
150             structured_output_model: Pydantic model type(s) for structured output.
151                 When specified, all agent calls will attempt to return structured output of this type.
152                 This can be overridden on the agent invocation.
153                 Defaults to None (no structured output).
154             callback_handler: Callback for processing events as they happen during agent execution.
155                 If not provided (using the default), a new PrintingCallbackHandler instance is created.
156                 If explicitly set to None, null_callback_handler is used.
157             conversation_manager: Manager for conversation history and context window.
158                 Defaults to strands.agent.conversation_manager.SlidingWindowConversationManager if None.
159             record_direct_tool_call: Whether to record direct tool calls in message history.
160                 Defaults to True.
161             load_tools_from_directory: Whether to load and automatically reload tools in the `./tools/` directory.
162                 Defaults to False.
163             trace_attributes: Custom trace attributes to apply to the agent's trace span.
164             agent_id: Optional ID for the agent, useful for session management and multi-agent scenarios.
165                 Defaults to "default".
166             name: name of the Agent
167                 Defaults to "Strands Agents".
168             description: description of what the Agent does
169                 Defaults to None.
170             state: stateful information for the agent. Can be either an AgentState object, or a json serializable dict.
171                 Defaults to an empty AgentState object.
172             hooks: hooks to be added to the agent hook registry
173                 Defaults to None.
174             session_manager: Manager for handling agent sessions including conversation history and state.
175                 If provided, enables session-based persistence and state management.
176             tool_executor: Definition of tool execution strategy (e.g., sequential, concurrent, etc.).
177 
178         Raises:
179             ValueError: If agent id contains path separators.
180         """
181         self.model = BedrockModel() if not model else BedrockModel(model_id=model) if isinstance(model, str) else model
182         self.messages = messages if messages is not None else []
183         # initializing self._system_prompt for backwards compatibility
184         self._system_prompt, self._system_prompt_content = self._initialize_system_prompt(system_prompt)
185         self._default_structured_output_model = structured_output_model
186         self.agent_id = _identifier.validate(agent_id or _DEFAULT_AGENT_ID, _identifier.Identifier.AGENT)
187         self.name = name or _DEFAULT_AGENT_NAME
188         self.description = description
189 
190         # If not provided, create a new PrintingCallbackHandler instance
191         # If explicitly set to None, use null_callback_handler
192         # Otherwise use the passed callback_handler
193         self.callback_handler: Union[Callable[..., Any], PrintingCallbackHandler]
194         if isinstance(callback_handler, _DefaultCallbackHandlerSentinel):
195             self.callback_handler = PrintingCallbackHandler()
196         elif callback_handler is None:
197             self.callback_handler = null_callback_handler
198         else:
199             self.callback_handler = callback_handler
200 
201         self.conversation_manager = conversation_manager if conversation_manager else SlidingWindowConversationManager()
202 
203         # Process trace attributes to ensure they're of compatible types
204         self.trace_attributes: dict[str, AttributeValue] = {}
205         if trace_attributes:
206             for k, v in trace_attributes.items():
207                 if isinstance(v, (str, int, float, bool)) or (
208                     isinstance(v, list) and all(isinstance(x, (str, int, float, bool)) for x in v)
209                 ):
210                     self.trace_attributes[k] = v
211 
212         self.record_direct_tool_call = record_direct_tool_call
213         self.load_tools_from_directory = load_tools_from_directory
214 
215         self.tool_registry = ToolRegistry()
216 
217         # Process tool list if provided
218         if tools is not None:
219             self.tool_registry.process_tools(tools)
220 
221         # Initialize tools and configuration
222         self.tool_registry.initialize_tools(self.load_tools_from_directory)
223         if load_tools_from_directory:
224             self.tool_watcher = ToolWatcher(tool_registry=self.tool_registry)
225 
226         self.event_loop_metrics = EventLoopMetrics()
227 
228         # Initialize tracer instance (no-op if not configured)
229         self.tracer = get_tracer()
230         self.trace_span: Optional[trace_api.Span] = None
231 
232         # Initialize agent state management
233         if state is not None:
234             if isinstance(state, dict):
235                 self.state = AgentState(state)
236             elif isinstance(state, AgentState):
237                 self.state = state
238             else:
239                 raise ValueError("state must be an AgentState object or a dict")
240         else:
241             self.state = AgentState()
242 
243         self.tool_caller = _ToolCaller(self)
244 
245         self.hooks = HookRegistry()
246 
247         self._interrupt_state = _InterruptState()
248 
249         # Initialize lock for guarding concurrent invocations
250         # Using threading.Lock instead of asyncio.Lock because run_async() creates
251         # separate event loops in different threads, so asyncio.Lock wouldn't work
252         self._invocation_lock = threading.Lock()
253 
254         # Initialize session management functionality
255         self._session_manager = session_manager
256         if self._session_manager:
257             self.hooks.add_hook(self._session_manager)
258 
259         # Allow conversation_managers to subscribe to hooks
260         self.hooks.add_hook(self.conversation_manager)
261 
262         self.tool_executor = tool_executor or ConcurrentToolExecutor()
263 
264         if hooks:
265             for hook in hooks:
266                 self.hooks.add_hook(hook)
267         self.hooks.invoke_callbacks(AgentInitializedEvent(agent=self))
268 
