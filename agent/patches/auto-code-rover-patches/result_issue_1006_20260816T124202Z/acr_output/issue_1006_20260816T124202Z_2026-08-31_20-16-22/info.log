269     @property
270     def system_prompt(self) -> str | None:
271         """Get the system prompt as a string for backwards compatibility.
272 
273         Returns the system prompt as a concatenated string when it contains text content,
274         or None if no text content is present. This maintains backwards compatibility
275         with existing code that expects system_prompt to be a string.
276 
277         Returns:
278             The system prompt as a string, or None if no text content exists.
279         """
280         return self._system_prompt
281 
282     @system_prompt.setter
283     def system_prompt(self, value: str | list[SystemContentBlock] | None) -> None:
284         """Set the system prompt and update internal content representation.
285 
286         Accepts either a string or list of SystemContentBlock objects.
287         When set, both the backwards-compatible string representation and the internal
288         content block representation are updated to maintain consistency.
289 
290         Args:
291             value: System prompt as string, list of SystemContentBlock objects, or None.
292                   - str: Simple text prompt (most common use case)
293                   - list[SystemContentBlock]: Content blocks with features like caching
294                   - None: Clear the system prompt
295         """
296         self._system_prompt, self._system_prompt_content = self._initialize_system_prompt(value)
