299     def tool(self) -> _ToolCaller:
300         """Call tool as a function.
301 
302         Returns:
303             Tool caller through which user can invoke tool as a function.
304 
305         Example:
306             ```
307             agent = Agent(tools=[calculator])
308             agent.tool.calculator(...)
309             ```
310         """
