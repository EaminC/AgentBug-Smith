24 class GitRepo:
25     repo = None
26     aider_ignore_file = None
27     aider_ignore_spec = None
28     aider_ignore_ts = 0
29     aider_ignore_last_check = 0
30     subtree_only = False
31     ignore_file_cache = {}
32     git_repo_error = None
33 
34     def __init__(
35         self,
36         io,
37         fnames,
38         git_dname,
39         aider_ignore_file=None,
40         models=None,
41         attribute_author=True,
42         attribute_committer=True,
43         attribute_commit_message_author=False,
44         attribute_commit_message_committer=False,
45         commit_prompt=None,
46         subtree_only=False,
47     ):
48         self.io = io
49         self.models = models
50 
51         self.normalized_path = {}
52         self.tree_files = {}
53 
54         self.attribute_author = attribute_author
55         self.attribute_committer = attribute_committer
56         self.attribute_commit_message_author = attribute_commit_message_author
57         self.attribute_commit_message_committer = attribute_commit_message_committer
58         self.commit_prompt = commit_prompt
59         self.subtree_only = subtree_only
60         self.ignore_file_cache = {}
61 
62         if git_dname:
63             check_fnames = [git_dname]
64         elif fnames:
65             check_fnames = fnames
66         else:
67             check_fnames = ["."]
68 
69         repo_paths = []
70         for fname in check_fnames:
71             fname = Path(fname)
72             fname = fname.resolve()
73 
74             if not fname.exists() and fname.parent.exists():
75                 fname = fname.parent
76 
77             try:
78                 repo_path = git.Repo(fname, search_parent_directories=True).working_dir
79                 repo_path = utils.safe_abs_path(repo_path)
80                 repo_paths.append(repo_path)
81             except ANY_GIT_ERROR:
82                 pass
83 
84         num_repos = len(set(repo_paths))
85 
86         if num_repos == 0:
87             raise FileNotFoundError
88         if num_repos > 1:
89             self.io.tool_error("Files are in different git repos.")
90             raise FileNotFoundError
91 
92         # https://github.com/gitpython-developers/GitPython/issues/427
93         self.repo = git.Repo(repo_paths.pop(), odbt=git.GitDB)
94         self.root = utils.safe_abs_path(self.repo.working_tree_dir)
95 
96         if aider_ignore_file:
97             self.aider_ignore_file = Path(aider_ignore_file)
98 
99     def commit(self, fnames=None, context=None, message=None, aider_edits=False):
100         if not fnames and not self.repo.is_dirty():
101             return
102 
103         diffs = self.get_diffs(fnames)
104         if not diffs:
105             return
106 
107         if message:
108             commit_message = message
109         else:
110             commit_message = self.get_commit_message(diffs, context)
111 
112         if aider_edits and self.attribute_commit_message_author:
113             commit_message = "aider: " + commit_message
114         elif self.attribute_commit_message_committer:
115             commit_message = "aider: " + commit_message
116 
117         if not commit_message:
118             commit_message = "(no commit message provided)"
119 
120         full_commit_message = commit_message
121         # if context:
122         #    full_commit_message += "\n\n# Aider chat conversation:\n\n" + context
123 
124         cmd = ["-m", full_commit_message, "--no-verify"]
125         if fnames:
126             fnames = [str(self.abs_root_path(fn)) for fn in fnames]
127             for fname in fnames:
128                 try:
129                     self.repo.git.add(fname)
130                 except ANY_GIT_ERROR as err:
131                     self.io.tool_error(f"Unable to add {fname}: {err}")
132             cmd += ["--"] + fnames
133         else:
134             cmd += ["-a"]
135 
136         original_user_name = self.repo.config_reader().get_value("user", "name")
137         original_committer_name_env = os.environ.get("GIT_COMMITTER_NAME")
138         committer_name = f"{original_user_name} (aider)"
139 
140         if self.attribute_committer:
141             os.environ["GIT_COMMITTER_NAME"] = committer_name
142 
143         if aider_edits and self.attribute_author:
144             original_auther_name_env = os.environ.get("GIT_AUTHOR_NAME")
145             os.environ["GIT_AUTHOR_NAME"] = committer_name
146 
147         try:
148             self.repo.git.commit(cmd)
149             commit_hash = self.get_head_commit_sha(short=True)
150             self.io.tool_output(f"Commit {commit_hash} {commit_message}", bold=True)
151             return commit_hash, commit_message
152         except ANY_GIT_ERROR as err:
153             self.io.tool_error(f"Unable to commit: {err}")
154         finally:
155             # Restore the env
156 
157             if self.attribute_committer:
158                 if original_committer_name_env is not None:
159                     os.environ["GIT_COMMITTER_NAME"] = original_committer_name_env
160                 else:
161                     del os.environ["GIT_COMMITTER_NAME"]
162 
163             if aider_edits and self.attribute_author:
164                 if original_auther_name_env is not None:
165                     os.environ["GIT_AUTHOR_NAME"] = original_auther_name_env
166                 else:
167                     del os.environ["GIT_AUTHOR_NAME"]
168 
169     def get_rel_repo_dir(self):
170         try:
171             return os.path.relpath(self.repo.git_dir, os.getcwd())
172         except ValueError:
173             return self.repo.git_dir
174 
175     def get_commit_message(self, diffs, context):
176         diffs = "# Diffs:\n" + diffs
177 
178         content = ""
179         if context:
180             content += context + "\n"
181         content += diffs
182 
183         system_content = self.commit_prompt or prompts.commit_system
184         messages = [
185             dict(role="system", content=system_content),
186             dict(role="user", content=content),
187         ]
188 
189         commit_message = None
190         for model in self.models:
191             num_tokens = model.token_count(messages)
192             max_tokens = model.info.get("max_input_tokens") or 0
193             if max_tokens and num_tokens > max_tokens:
194                 continue
195             commit_message = simple_send_with_retries(
196                 model.name, messages, extra_params=model.extra_params
197             )
198             if commit_message:
199                 break
200 
201         if not commit_message:
202             self.io.tool_error("Failed to generate commit message!")
203             return
204 
205         commit_message = commit_message.strip()
206         if commit_message and commit_message[0] == '"' and commit_message[-1] == '"':
207             commit_message = commit_message[1:-1].strip()
208 
209         return commit_message
210 
211     def get_diffs(self, fnames=None):
212         # We always want diffs of index and working dir
213 
214         current_branch_has_commits = False
215         try:
216             active_branch = self.repo.active_branch
217             try:
218                 commits = self.repo.iter_commits(active_branch)
219                 current_branch_has_commits = any(commits)
220             except ANY_GIT_ERROR:
221                 pass
222         except (TypeError,) + ANY_GIT_ERROR:
223             pass
224 
225         if not fnames:
226             fnames = []
227 
228         diffs = ""
229         for fname in fnames:
230             if not self.path_in_repo(fname):
231                 diffs += f"Added {fname}\n"
232 
233         try:
234             if current_branch_has_commits:
235                 args = ["HEAD", "--"] + list(fnames)
236                 diffs += self.repo.git.diff(*args)
237                 return diffs
238 
239             wd_args = ["--"] + list(fnames)
240             index_args = ["--cached"] + wd_args
241 
242             diffs += self.repo.git.diff(*index_args)
243             diffs += self.repo.git.diff(*wd_args)
244 
245             return diffs
246         except ANY_GIT_ERROR as err:
247             self.io.tool_error(f"Unable to diff: {err}")
248 
249     def diff_commits(self, pretty, from_commit, to_commit):
250         args = []
251         if pretty:
252             args += ["--color"]
253         else:
254             args += ["--color=never"]
255 
256         args += [from_commit, to_commit]
257         diffs = self.repo.git.diff(*args)
258 
259         return diffs
260 
261     def get_tracked_files(self):
262         if not self.repo:
263             return []
264 
265         try:
266             commit = self.repo.head.commit
267         except ValueError:
268             commit = None
269         except ANY_GIT_ERROR as err:
270             self.git_repo_error = err
271             self.io.tool_error(f"Unable to list files in git repo: {err}")
272             self.io.tool_output("Is your git repo corrupted?")
273             return []
274 
275         files = set()
276         if commit:
277             if commit in self.tree_files:
278                 files = self.tree_files[commit]
279             else:
280                 try:
281                     for blob in commit.tree.traverse():
282                         if blob.type == "blob":  # blob is a file
283                             files.add(blob.path)
284                 except ANY_GIT_ERROR as err:
285                     self.git_repo_error = err
286                     self.io.tool_error(f"Unable to list files in git repo: {err}")
287                     self.io.tool_output("Is your git repo corrupted?")
288                     return []
289                 files = set(self.normalize_path(path) for path in files)
290                 self.tree_files[commit] = set(files)
291 
292         # Add staged files
293         index = self.repo.index
294         staged_files = [path for path, _ in index.entries.keys()]
295         files.update(self.normalize_path(path) for path in staged_files)
296 
297         res = [fname for fname in files if not self.ignored_file(fname)]
298 
299         return res
300 
301     def normalize_path(self, path):
302         orig_path = path
303         res = self.normalized_path.get(orig_path)
304         if res:
305             return res
306 
307         path = str(Path(PurePosixPath((Path(self.root) / path).relative_to(self.root))))
308         self.normalized_path[orig_path] = path
309         return path
310 
311     def refresh_aider_ignore(self):
312         if not self.aider_ignore_file:
313             return
314 
315         current_time = time.time()
316         if current_time - self.aider_ignore_last_check < 1:
317             return
318 
319         self.aider_ignore_last_check = current_time
320 
321         if not self.aider_ignore_file.is_file():
322             return
323 
324         mtime = self.aider_ignore_file.stat().st_mtime
325         if mtime != self.aider_ignore_ts:
326             self.aider_ignore_ts = mtime
327             self.ignore_file_cache = {}
328             lines = self.aider_ignore_file.read_text().splitlines()
329             self.aider_ignore_spec = pathspec.PathSpec.from_lines(
330                 pathspec.patterns.GitWildMatchPattern,
331                 lines,
332             )
333 
334     def ignored_file(self, fname):
335         self.refresh_aider_ignore()
336 
337         if fname in self.ignore_file_cache:
338             return self.ignore_file_cache[fname]
339 
340         result = self.ignored_file_raw(fname)
341         self.ignore_file_cache[fname] = result
342         return result
343 
344     def ignored_file_raw(self, fname):
345         if self.subtree_only:
346             fname_path = Path(self.normalize_path(fname))
347             try:
348                 cwd_path = Path.cwd().resolve().relative_to(Path(self.root).resolve())
349             except ValueError:
350                 # Issue #1524
351                 # ValueError: 'C:\\dev\\squid-certbot' is not in the subpath of
352                 # 'C:\\dev\\squid-certbot'
353                 # Clearly, fname is not under cwd... so ignore it
354                 return True
355 
356             if cwd_path not in fname_path.parents and fname_path != cwd_path:
357                 return True
358 
359         if not self.aider_ignore_file or not self.aider_ignore_file.is_file():
360             return False
361 
362         try:
363             fname = self.normalize_path(fname)
364         except ValueError:
365             return True
366 
367         return self.aider_ignore_spec.match_file(fname)
368 
369     def path_in_repo(self, path):
370         if not self.repo:
371             return
372         if not path:
373             return
374 
375         tracked_files = set(self.get_tracked_files())
376         return self.normalize_path(path) in tracked_files
377 
378     def abs_root_path(self, path):
379         res = Path(self.root) / path
380         return utils.safe_abs_path(res)
381 
382     def get_dirty_files(self):
383         """
384         Returns a list of all files which are dirty (not committed), either staged or in the working
385         directory.
386         """
387         dirty_files = set()
388 
389         # Get staged files
390         staged_files = self.repo.git.diff("--name-only", "--cached").splitlines()
391         dirty_files.update(staged_files)
392 
393         # Get unstaged files
394         unstaged_files = self.repo.git.diff("--name-only").splitlines()
395         dirty_files.update(unstaged_files)
396 
397         return list(dirty_files)
398 
399     def is_dirty(self, path=None):
400         if path and not self.path_in_repo(path):
401             return True
402 
403         return self.repo.is_dirty(path=path)
404 
405     def get_head_commit(self):
406         try:
407             return self.repo.head.commit
408         except (ValueError,) + ANY_GIT_ERROR:
409             return None
410 
411     def get_head_commit_sha(self, short=False):
412         commit = self.get_head_commit()
413         if not commit:
414             return
415         if short:
416             return commit.hexsha[:7]
417         return commit.hexsha
418 
419     def get_head_commit_message(self, default=None):
420         commit = self.get_head_commit()
421         if not commit:
422             return default
423         return commit.message

