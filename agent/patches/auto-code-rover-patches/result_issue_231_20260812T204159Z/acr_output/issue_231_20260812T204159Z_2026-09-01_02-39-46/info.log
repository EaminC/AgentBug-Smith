59 class Agent:
60     """Core Agent interface.
61 
62     An agent orchestrates the following workflow:
63 
64     1. Receives user input
65     2. Processes the input using a language model
66     3. Decides whether to use tools to gather information or perform actions
67     4. Executes those tools and receives results
68     5. Continues reasoning with the new information
69     6. Produces a final response
70     """
71 
72     class ToolCaller:
73         """Call tool as a function."""
74 
75         def __init__(self, agent: "Agent") -> None:
76             """Initialize instance.
77 
78             Args:
79                 agent: Agent reference that will accept tool results.
80             """
81             # WARNING: Do not add any other member variables or methods as this could result in a name conflict with
82             #          agent tools and thus break their execution.
83             self._agent = agent
84 
85         def __getattr__(self, name: str) -> Callable[..., Any]:
86             """Call tool as a function.
87 
88             This method enables the method-style interface (e.g., `agent.tool.tool_name(param="value")`).
89             It matches underscore-separated names to hyphenated tool names (e.g., 'some_thing' matches 'some-thing').
90 
91             Args:
92                 name: The name of the attribute (tool) being accessed.
93 
94             Returns:
95                 A function that when called will execute the named tool.
96 
97             Raises:
98                 AttributeError: If no tool with the given name exists or if multiple tools match the given name.
99             """
100 
101             def caller(
102                 user_message_override: Optional[str] = None,
103                 record_direct_tool_call: Optional[bool] = None,
104                 **kwargs: Any,
105             ) -> Any:
106                 """Call a tool directly by name.
107 
108                 Args:
109                     user_message_override: Optional custom message to record instead of default
110                     record_direct_tool_call: Whether to record direct tool calls in message history. Overrides class
111                         attribute if provided.
112                     **kwargs: Keyword arguments to pass to the tool.
113 
114                 Returns:
115                     The result returned by the tool.
116 
117                 Raises:
118                     AttributeError: If the tool doesn't exist.
119                 """
120                 normalized_name = self._find_normalized_tool_name(name)
121 
122                 # Create unique tool ID and set up the tool request
123                 tool_id = f"tooluse_{name}_{random.randint(100000000, 999999999)}"
124                 tool_use: ToolUse = {
125                     "toolUseId": tool_id,
126                     "name": normalized_name,
127                     "input": kwargs.copy(),
128                 }
129 
130                 # Execute the tool
131                 tool_result = self._agent.tool_handler.process(
132                     tool=tool_use,
133                     model=self._agent.model,
134                     system_prompt=self._agent.system_prompt,
135                     messages=self._agent.messages,
136                     tool_config=self._agent.tool_config,
137                     kwargs=kwargs,
138                 )
139 
140                 if record_direct_tool_call is not None:
141                     should_record_direct_tool_call = record_direct_tool_call
142                 else:
143                     should_record_direct_tool_call = self._agent.record_direct_tool_call
144 
145                 if should_record_direct_tool_call:
146                     # Create a record of this tool execution in the message history
147                     self._agent._record_tool_execution(
148                         tool_use, tool_result, user_message_override, self._agent.messages
149                     )
150 
151                 # Apply window management
152                 self._agent.conversation_manager.apply_management(self._agent)
153 
154                 return tool_result
155 
156             return caller
157 
158         def _find_normalized_tool_name(self, name: str) -> str:
159             """Lookup the tool represented by name, replacing characters with underscores as necessary."""
160             tool_registry = self._agent.tool_registry.registry
161 
162             if tool_registry.get(name, None):
163                 return name
164 
165             # If the desired name contains underscores, it might be a placeholder for characters that can't be
166             # represented as python identifiers but are valid as tool names, such as dashes. In that case, find
167             # all tools that can be represented with the normalized name
168             if "_" in name:
169                 filtered_tools = [
170                     tool_name for (tool_name, tool) in tool_registry.items() if tool_name.replace("-", "_") == name
171                 ]
172 
173                 # The registry itself defends against similar names, so we can just take the first match
174                 if filtered_tools:
175                     return filtered_tools[0]
176 
177             raise AttributeError(f"Tool '{name}' not found")
178 
179     def __init__(
180         self,
181         model: Union[Model, str, None] = None,
182         messages: Optional[Messages] = None,
183         tools: Optional[list[Union[str, dict[str, str], Any]]] = None,
184         system_prompt: Optional[str] = None,
185         callback_handler: Optional[
186             Union[Callable[..., Any], _DefaultCallbackHandlerSentinel]
187         ] = _DEFAULT_CALLBACK_HANDLER,
188         conversation_manager: Optional[ConversationManager] = None,
189         max_parallel_tools: int = os.cpu_count() or 1,
190         record_direct_tool_call: bool = True,
191         load_tools_from_directory: bool = True,
192         trace_attributes: Optional[Mapping[str, AttributeValue]] = None,
193         *,
194         name: Optional[str] = None,
195         description: Optional[str] = None,
196         state: Optional[Union[AgentState, dict]] = None,
197     ):
198         """Initialize the Agent with the specified configuration.
199 
200         Args:
201             model: Provider for running inference or a string representing the model-id for Bedrock to use.
202                 Defaults to strands.models.BedrockModel if None.
203             messages: List of initial messages to pre-load into the conversation.
204                 Defaults to an empty list if None.
205             tools: List of tools to make available to the agent.
206                 Can be specified as:
207 
208                 - String tool names (e.g., "retrieve")
209                 - File paths (e.g., "/path/to/tool.py")
210                 - Imported Python modules (e.g., from strands_tools import current_time)
211                 - Dictionaries with name/path keys (e.g., {"name": "tool_name", "path": "/path/to/tool.py"})
212                 - Functions decorated with `@strands.tool` decorator.
213 
214                 If provided, only these tools will be available. If None, all tools will be available.
215             system_prompt: System prompt to guide model behavior.
216                 If None, the model will behave according to its default settings.
217             callback_handler: Callback for processing events as they happen during agent execution.
218                 If not provided (using the default), a new PrintingCallbackHandler instance is created.
219                 If explicitly set to None, null_callback_handler is used.
220             conversation_manager: Manager for conversation history and context window.
221                 Defaults to strands.agent.conversation_manager.SlidingWindowConversationManager if None.
222             max_parallel_tools: Maximum number of tools to run in parallel when the model returns multiple tool calls.
223                 Defaults to os.cpu_count() or 1.
224             record_direct_tool_call: Whether to record direct tool calls in message history.
225                 Defaults to True.
226             load_tools_from_directory: Whether to load and automatically reload tools in the `./tools/` directory.
227                 Defaults to True.
228             trace_attributes: Custom trace attributes to apply to the agent's trace span.
229             name: name of the Agent
230                 Defaults to None.
231             description: description of what the Agent does
232                 Defaults to None.
233             state: stateful information for the agent. Can be either an AgentState object, or a json serializable dict.
234                 Defaults to an empty AgentState object.
235 
236         Raises:
237             ValueError: If max_parallel_tools is less than 1.
238         """
239         self.model = BedrockModel() if not model else BedrockModel(model_id=model) if isinstance(model, str) else model
240         self.messages = messages if messages is not None else []
241 
242         self.system_prompt = system_prompt
243 
244         # If not provided, create a new PrintingCallbackHandler instance
245         # If explicitly set to None, use null_callback_handler
246         # Otherwise use the passed callback_handler
247         self.callback_handler: Union[Callable[..., Any], PrintingCallbackHandler]
248         if isinstance(callback_handler, _DefaultCallbackHandlerSentinel):
249             self.callback_handler = PrintingCallbackHandler()
250         elif callback_handler is None:
251             self.callback_handler = null_callback_handler
252         else:
253             self.callback_handler = callback_handler
254 
255         self.conversation_manager = conversation_manager if conversation_manager else SlidingWindowConversationManager()
256 
257         # Process trace attributes to ensure they're of compatible types
258         self.trace_attributes: dict[str, AttributeValue] = {}
259         if trace_attributes:
260             for k, v in trace_attributes.items():
261                 if isinstance(v, (str, int, float, bool)) or (
262                     isinstance(v, list) and all(isinstance(x, (str, int, float, bool)) for x in v)
263                 ):
264                     self.trace_attributes[k] = v
265 
266         # If max_parallel_tools is 1, we execute tools sequentially
267         self.thread_pool = None
268         self.thread_pool_wrapper = None
269         if max_parallel_tools > 1:
270             self.thread_pool = ThreadPoolExecutor(max_workers=max_parallel_tools)
271             self.thread_pool_wrapper = ThreadPoolExecutorWrapper(self.thread_pool)
272         elif max_parallel_tools < 1:
273             raise ValueError("max_parallel_tools must be greater than 0")
274 
275         self.record_direct_tool_call = record_direct_tool_call
276         self.load_tools_from_directory = load_tools_from_directory
277 
278         self.tool_registry = ToolRegistry()
279         self.tool_handler = AgentToolHandler(tool_registry=self.tool_registry)
280 
281         # Process tool list if provided
282         if tools is not None:
283             self.tool_registry.process_tools(tools)
284 
285         # Initialize tools and configuration
286         self.tool_registry.initialize_tools(self.load_tools_from_directory)
287         if load_tools_from_directory:
288             self.tool_watcher = ToolWatcher(tool_registry=self.tool_registry)
289 
290         self.event_loop_metrics = EventLoopMetrics()
291 
292         # Initialize tracer instance (no-op if not configured)
293         self.tracer = get_tracer()
294         self.trace_span: Optional[trace.Span] = None
295 
296         # Initialize agent state management
297         if state is not None:
298             if isinstance(state, dict):
299                 self.state = AgentState(state)
300             elif isinstance(state, AgentState):
301                 self.state = state
302             else:
303                 raise ValueError("state must be an AgentState object or a dict")
304         else:
305             self.state = AgentState()
306 
307         self.tool_caller = Agent.ToolCaller(self)
308         self.name = name
309         self.description = description
310 
311     @property
312     def tool(self) -> ToolCaller:
313         """Call tool as a function.
314 
315         Returns:
316             Tool caller through which user can invoke tool as a function.
317 
318         Example:
319             ```
320             agent = Agent(tools=[calculator])
321             agent.tool.calculator(...)
322             ```
323         """
324         return self.tool_caller
325 
326     @property
327     def tool_names(self) -> list[str]:
328         """Get a list of all registered tool names.
329 
330         Returns:
331             Names of all tools available to this agent.
332         """
333         all_tools = self.tool_registry.get_all_tools_config()
334         return list(all_tools.keys())
335 
336     @property
337     def tool_config(self) -> ToolConfig:
338         """Get the tool configuration for this agent.
339 
340         Returns:
341             The complete tool configuration.
342         """
343         return self.tool_registry.initialize_tool_config()
344 
345     def __del__(self) -> None:
346         """Clean up resources when Agent is garbage collected.
347 
348         Ensures proper shutdown of the thread pool executor if one exists.
349         """
350         if self.thread_pool_wrapper and hasattr(self.thread_pool_wrapper, "shutdown"):
351             self.thread_pool_wrapper.shutdown(wait=False)
352             logger.debug("thread pool executor shutdown complete")
353 
354     def __call__(self, prompt: str, **kwargs: Any) -> AgentResult:
355         """Process a natural language prompt through the agent's event loop.
356 
357         This method implements the conversational interface (e.g., `agent("hello!")`). It adds the user's prompt to
358         the conversation history, processes it through the model, executes any tool calls, and returns the final result.
359 
360         Args:
361             prompt: The natural language prompt from the user.
362             **kwargs: Additional parameters to pass through the event loop.
363 
364         Returns:
365             Result object containing:
366 
367                 - stop_reason: Why the event loop stopped (e.g., "end_turn", "max_tokens")
368                 - message: The final message from the model
369                 - metrics: Performance metrics from the event loop
370                 - state: The final state of the event loop
371         """
372         callback_handler = kwargs.get("callback_handler", self.callback_handler)
373 
374         self._start_agent_trace_span(prompt)
375 
376         try:
377             events = self._run_loop(prompt, kwargs)
378             for event in events:
379                 if "callback" in event:
380                     callback_handler(**event["callback"])
381 
382             stop_reason, message, metrics, state = event["stop"]
383             result = AgentResult(stop_reason, message, metrics, state)
384 
385             self._end_agent_trace_span(response=result)
386 
387             return result
388 
389         except Exception as e:
390             self._end_agent_trace_span(error=e)
391             raise
392 
393     def structured_output(self, output_model: Type[T], prompt: Optional[str] = None) -> T:
394         """This method allows you to get structured output from the agent.
395 
396         If you pass in a prompt, it will be added to the conversation history and the agent will respond to it.
397         If you don't pass in a prompt, it will use only the conversation history to respond.
398         If no conversation history exists and no prompt is provided, an error will be raised.
399 
400         For smaller models, you may want to use the optional prompt string to add additional instructions to explicitly
401         instruct the model to output the structured data.
402 
403         Args:
404             output_model: The output model (a JSON schema written as a Pydantic BaseModel)
405                 that the agent will use when responding.
406             prompt: The prompt to use for the agent.
407         """
408         messages = self.messages
409         if not messages and not prompt:
410             raise ValueError("No conversation history or prompt provided")
411 
412         # add the prompt as the last message
413         if prompt:
414             messages.append({"role": "user", "content": [{"text": prompt}]})
415 
416         # get the structured output from the model
417         events = self.model.structured_output(output_model, messages)
418         for event in events:
419             if "callback" in event:
420                 self.callback_handler(**cast(dict, event["callback"]))
421 
422         return event["output"]
423 
424     async def stream_async(self, prompt: str, **kwargs: Any) -> AsyncIterator[Any]:
425         """Process a natural language prompt and yield events as an async iterator.
426 
427         This method provides an asynchronous interface for streaming agent events, allowing
428         consumers to process stream events programmatically through an async iterator pattern
429         rather than callback functions. This is particularly useful for web servers and other
430         async environments.
431 
432         Args:
433             prompt: The natural language prompt from the user.
434             **kwargs: Additional parameters to pass to the event loop.
435 
436         Returns:
437             An async iterator that yields events. Each event is a dictionary containing
438             information about the current state of processing, such as:
439             - data: Text content being generated
440             - complete: Whether this is the final chunk
441             - current_tool_use: Information about tools being executed
442             - And other event data provided by the callback handler
443 
444         Raises:
445             Exception: Any exceptions from the agent invocation will be propagated to the caller.
446 
447         Example:
448             ```python
449             async for event in agent.stream_async("Analyze this data"):
450                 if "data" in event:
451                     yield event["data"]
452             ```
453         """
454         callback_handler = kwargs.get("callback_handler", self.callback_handler)
455 
456         self._start_agent_trace_span(prompt)
457 
458         try:
459             events = self._run_loop(prompt, kwargs)
460             for event in events:
461                 if "callback" in event:
462                     callback_handler(**event["callback"])
463                     yield event["callback"]
464 
465             stop_reason, message, metrics, state = event["stop"]
466             result = AgentResult(stop_reason, message, metrics, state)
467 
468             self._end_agent_trace_span(response=result)
469 
470         except Exception as e:
471             self._end_agent_trace_span(error=e)
472             raise
473 
474     def _run_loop(self, prompt: str, kwargs: dict[str, Any]) -> Generator[dict[str, Any], None, None]:
475         """Execute the agent's event loop with the given prompt and parameters."""
476         try:
477             # Extract key parameters
478             yield {"callback": {"init_event_loop": True, **kwargs}}
479 
480             # Set up the user message with optional knowledge base retrieval
481             message_content: list[ContentBlock] = [{"text": prompt}]
482             new_message: Message = {"role": "user", "content": message_content}
483             self.messages.append(new_message)
484 
485             # Execute the event loop cycle with retry logic for context limits
486             yield from self._execute_event_loop_cycle(kwargs)
487 
488         finally:
489             self.conversation_manager.apply_management(self)
490 
491     def _execute_event_loop_cycle(self, kwargs: dict[str, Any]) -> Generator[dict[str, Any], None, None]:
492         """Execute the event loop cycle with retry logic for context window limits.
493 
494         This internal method handles the execution of the event loop cycle and implements
495         retry logic for handling context window overflow exceptions by reducing the
496         conversation context and retrying.
497 
498         Yields:
499             Events of the loop cycle.
500         """
501         # Add `Agent` to kwargs to keep backwards-compatibility
502         kwargs["agent"] = self
503 
504         try:
505             # Execute the main event loop cycle
506             yield from event_loop_cycle(
507                 model=self.model,
508                 system_prompt=self.system_prompt,
509                 messages=self.messages,  # will be modified by event_loop_cycle
510                 tool_config=self.tool_config,
511                 tool_handler=self.tool_handler,
512                 tool_execution_handler=self.thread_pool_wrapper,
513                 event_loop_metrics=self.event_loop_metrics,
514                 event_loop_parent_span=self.trace_span,
515                 kwargs=kwargs,
516             )
517 
518         except ContextWindowOverflowException as e:
519             # Try reducing the context size and retrying
520             self.conversation_manager.reduce_context(self, e=e)
521             yield from self._execute_event_loop_cycle(kwargs)
522 
523     def _record_tool_execution(
524         self,
525         tool: ToolUse,
526         tool_result: ToolResult,
527         user_message_override: Optional[str],
528         messages: Messages,
529     ) -> None:
530         """Record a tool execution in the message history.
531 
532         Creates a sequence of messages that represent the tool execution:
533 
534         1. A user message describing the tool call
535         2. An assistant message with the tool use
536         3. A user message with the tool result
537         4. An assistant message acknowledging the tool call
538 
539         Args:
540             tool: The tool call information.
541             tool_result: The result returned by the tool.
542             user_message_override: Optional custom message to include.
543             messages: The message history to append to.
544         """
545         # Create user message describing the tool call
546         user_msg_content: List[ContentBlock] = [
547             {"text": (f"agent.tool.{tool['name']} direct tool call.\nInput parameters: {json.dumps(tool['input'])}\n")}
548         ]
549 
550         # Add override message if provided
551         if user_message_override:
552             user_msg_content.insert(0, {"text": f"{user_message_override}\n"})
553 
554         # Create the message sequence
555         user_msg: Message = {
556             "role": "user",
557             "content": user_msg_content,
558         }
559         tool_use_msg: Message = {
560             "role": "assistant",
561             "content": [{"toolUse": tool}],
562         }
563         tool_result_msg: Message = {
564             "role": "user",
565             "content": [{"toolResult": tool_result}],
566         }
567         assistant_msg: Message = {
568             "role": "assistant",
569             "content": [{"text": f"agent.{tool['name']} was called"}],
570         }
571 
572         # Add to message history
573         messages.append(user_msg)
574         messages.append(tool_use_msg)
575         messages.append(tool_result_msg)
576         messages.append(assistant_msg)
577 
578     def _start_agent_trace_span(self, prompt: str) -> None:
579         """Starts a trace span for the agent.
580 
581         Args:
582             prompt: The natural language prompt from the user.
583         """
584         model_id = self.model.config.get("model_id") if hasattr(self.model, "config") else None
585 
586         self.trace_span = self.tracer.start_agent_span(
587             prompt=prompt,
588             model_id=model_id,
589             tools=self.tool_names,
590             system_prompt=self.system_prompt,
591             custom_trace_attributes=self.trace_attributes,
592         )
593 
594     def _end_agent_trace_span(
595         self,
596         response: Optional[AgentResult] = None,
597         error: Optional[Exception] = None,
598     ) -> None:
599         """Ends a trace span for the agent.
600 
601         Args:
602             span: The span to end.
603             response: Response to record as a trace attribute.
604             error: Error to record as a trace attribute.
605         """
606         if self.trace_span:
607             trace_attributes: dict[str, Any] = {
608                 "span": self.trace_span,
609             }
610 
611             if response:
612                 trace_attributes["response"] = response
613             if error:
614                 trace_attributes["error"] = error
615 
616             self.tracer.end_agent_span(**trace_attributes)

