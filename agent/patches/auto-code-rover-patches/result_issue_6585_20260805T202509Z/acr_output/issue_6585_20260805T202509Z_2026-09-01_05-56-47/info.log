409     async def _execute_batch(
410         self,
411         grouped_ops: dict,
412         results: list[Result],
413         conn: AsyncConnection[DictRow],
414     ) -> None:
415         async with self._cursor(pipeline=True) as cur:
416             if GetOp in grouped_ops:
417                 await self._batch_get_ops(
418                     cast(Sequence[tuple[int, GetOp]], grouped_ops[GetOp]),
419                     results,
420                     cur,
421                 )
422 
423             if SearchOp in grouped_ops:
424                 await self._batch_search_ops(
425                     cast(Sequence[tuple[int, SearchOp]], grouped_ops[SearchOp]),
426                     results,
427                     cur,
428                 )
429 
430             if ListNamespacesOp in grouped_ops:
431                 await self._batch_list_namespaces_ops(
432                     cast(
433                         Sequence[tuple[int, ListNamespacesOp]],
434                         grouped_ops[ListNamespacesOp],
435                     ),
436                     results,
437                     cur,
438                 )
439 
440             if PutOp in grouped_ops:
441                 await self._batch_put_ops(
442                     cast(Sequence[tuple[int, PutOp]], grouped_ops[PutOp]),
443                     cur,
444                 )
445 
446     async def _batch_get_ops(
447         self,
448         get_ops: Sequence[tuple[int, GetOp]],
449         results: list[Result],
450         cur: AsyncCursor[DictRow],
451     ) -> None:
452         for query, params, namespace, items in self._get_batch_GET_ops_queries(get_ops):
453             await cur.execute(query, params)
454             rows = cast(list[Row], await cur.fetchall())
455             key_to_row = {row["key"]: row for row in rows}
456             for idx, key in items:
457                 row = key_to_row.get(key)
458                 if row:
459                     results[idx] = _row_to_item(
460                         namespace, row, loader=self._deserializer
461                     )
462                 else:
463                     results[idx] = None
464 
465     async def _batch_put_ops(
466         self,
467         put_ops: Sequence[tuple[int, PutOp]],
468         cur: AsyncCursor[DictRow],
469     ) -> None:
470         queries, embedding_request = self._prepare_batch_PUT_queries(put_ops)
471         if embedding_request:
472             if self.embeddings is None:
473                 # Should not get here since the embedding config is required
474                 # to return an embedding_request above
475                 raise ValueError(
476                     "Embedding configuration is required for vector operations "
477                     f"(for semantic search). "
478                     f"Please provide an EmbeddingConfig when initializing the {self.__class__.__name__}."
479                 )
480             query, txt_params = embedding_request
481             vectors = await self.embeddings.aembed_documents(
482                 [param[-1] for param in txt_params]
483             )
484             queries.append(
485                 (
486                     query,
487                     [
488                         p
489                         for (ns, k, pathname, _), vector in zip(
490                             txt_params, vectors, strict=False
491                         )
492                         for p in (ns, k, pathname, vector)
493                     ],
494                 )
495             )
496 
497         for query, params in queries:
498             await cur.execute(query, params)
499 
500     async def _batch_search_ops(
501         self,
502         search_ops: Sequence[tuple[int, SearchOp]],
503         results: list[Result],
504         cur: AsyncCursor[DictRow],
505     ) -> None:
506         queries, embedding_requests = self._prepare_batch_search_queries(search_ops)
