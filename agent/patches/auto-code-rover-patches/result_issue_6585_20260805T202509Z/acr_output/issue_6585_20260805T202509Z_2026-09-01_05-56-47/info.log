228     async def setup(self) -> None:
229         """Set up the store database asynchronously.
230 
231         This method creates the necessary tables in the Postgres database if they don't
232         already exist and runs database migrations. It MUST be called directly by the user
233         the first time the store is used.
234         """
235 
236         async def _get_version(cur: AsyncCursor[DictRow], table: str) -> int:
237             await cur.execute(
238                 f"""
239                 CREATE TABLE IF NOT EXISTS {table} (
240                     v INTEGER PRIMARY KEY
241                 )
242             """
243             )
244             await cur.execute(f"SELECT v FROM {table} ORDER BY v DESC LIMIT 1")
245             row = cast(dict, await cur.fetchone())
246             if row is None:
247                 version = -1
248             else:
249                 version = row["v"]
250             return version
251 
252         async with self._cursor() as cur:
253             version = await _get_version(cur, table="store_migrations")
254             for v, sql in enumerate(self.MIGRATIONS[version + 1 :], start=version + 1):
255                 await cur.execute(sql)
256                 await cur.execute("INSERT INTO store_migrations (v) VALUES (%s)", (v,))
257 
258             if self.index_config:
259                 version = await _get_version(cur, table="vector_migrations")
260                 for v, migration in enumerate(
261                     self.VECTOR_MIGRATIONS[version + 1 :], start=version + 1
262                 ):
263                     sql = migration.sql
264                     if migration.params:
265                         params = {
266                             k: v(self) if v is not None and callable(v) else v
267                             for k, v in migration.params.items()
268                         }
269                         if "dims" in params:
270                             try:
271                                 params["dims"] = int(params["dims"])
272                             except Exception as e:
273                                 raise ValueError(
274                                     f"Invalid dims for vector index: {params['dims']}"
275                                 ) from e
276                         if "vector_type" in params:
277                             vt = str(params["vector_type"])
278                             if vt not in ("vector", "halfvec"):
279                                 raise ValueError(
280                                     f"Invalid vector_type for pgvector: {vt}"
281                                 )
282                             params["vector_type"] = vt
283                         if "index_type" in params:
284                             it = str(params["index_type"])
285                             if it not in ("hnsw", "ivfflat"):
286                                 raise ValueError(
287                                     f"Invalid index_type for pgvector: {it}"
288                                 )
289                             params["index_type"] = it
290                         sql = sql % params
291                     await cur.execute(sql)
292                     await cur.execute(
293                         "INSERT INTO vector_migrations (v) VALUES (%s)", (v,)
294                     )
