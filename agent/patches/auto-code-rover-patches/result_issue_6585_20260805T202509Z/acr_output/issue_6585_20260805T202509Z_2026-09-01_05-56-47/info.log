228     async def setup(self) -> None:
229         """Set up the store database asynchronously.
230 
231         This method creates the necessary tables in the Postgres database if they don't
232         already exist and runs database migrations. It MUST be called directly by the user
233         the first time the store is used.
234         """
235 
236         async def _get_version(cur: AsyncCursor[DictRow], table: str) -> int:
237             await cur.execute(
238                 f"""
239                 CREATE TABLE IF NOT EXISTS {table} (
240                     v INTEGER PRIMARY KEY
241                 )
242             """
243             )
244             await cur.execute(f"SELECT v FROM {table} ORDER BY v DESC LIMIT 1")
245             row = cast(dict, await cur.fetchone())
246             if row is None:
247                 version = -1
248             else:
249                 version = row["v"]
250             return version
251 
252         async with self._cursor() as cur:
253             version = await _get_version(cur, table="store_migrations")
254             for v, sql in enumerate(self.MIGRATIONS[version + 1 :], start=version + 1):
255                 await cur.execute(sql)
256                 await cur.execute("INSERT INTO store_migrations (v) VALUES (%s)", (v,))
257 
258             if self.index_config:
259                 version = await _get_version(cur, table="vector_migrations")
260                 for v, migration in enumerate(
261                     self.VECTOR_MIGRATIONS[version + 1 :], start=version + 1
262                 ):
263                     sql = migration.sql
264                     if migration.params:
265                         params = {
266                             k: v(self) if v is not None and callable(v) else v
267                             for k, v in migration.params.items()
268                         }
269                         if "dims" in params:
270                             try:
271                                 params["dims"] = int(params["dims"])
272                             except Exception as e:
273                                 raise ValueError(
274                                     f"Invalid dims for vector index: {params['dims']}"
275                                 ) from e
276                         if "vector_type" in params:
277                             vt = str(params["vector_type"])
278                             if vt not in ("vector", "halfvec"):
279                                 raise ValueError(
280                                     f"Invalid vector_type for pgvector: {vt}"
281                                 )
282                             params["vector_type"] = vt
283                         if "index_type" in params:
284                             it = str(params["index_type"])
285                             if it not in ("hnsw", "ivfflat"):
286                                 raise ValueError(
287                                     f"Invalid index_type for pgvector: {it}"
288                                 )
289                             params["index_type"] = it
290                         sql = sql % params
291                     await cur.execute(sql)
292                     await cur.execute(
293                         "INSERT INTO vector_migrations (v) VALUES (%s)", (v,)
294                     )
295 
296     async def sweep_ttl(self) -> int:
297         """Delete expired store items based on TTL.
298 
299         Returns:
300             int: The number of deleted items.
301         """
302         async with self._cursor() as cur:
303             await cur.execute(
304                 """
305                 DELETE FROM store
306                 WHERE expires_at IS NOT NULL AND expires_at < NOW()
307                 """
308             )
309             deleted_count = cur.rowcount
310             return deleted_count
311 
312     async def start_ttl_sweeper(
313         self, sweep_interval_minutes: int | None = None
314     ) -> asyncio.Task[None]:
315         """Periodically delete expired store items based on TTL.
316 
317         Returns:
318             Task that can be awaited or cancelled.
319         """
320         if not self.ttl_config:
321             return asyncio.create_task(asyncio.sleep(0))
322 
323         if self._ttl_sweeper_task is not None and not self._ttl_sweeper_task.done():
324             return self._ttl_sweeper_task
325 
326         self._ttl_stop_event.clear()
327 
328         interval = float(
329             sweep_interval_minutes or self.ttl_config.get("sweep_interval_minutes") or 5
330         )
331         logger.info(f"Starting store TTL sweeper with interval {interval} minutes")
332 
333         async def _sweep_loop() -> None:
334             while not self._ttl_stop_event.is_set():
335                 try:
336                     try:
337                         await asyncio.wait_for(
338                             self._ttl_stop_event.wait(),
339                             timeout=interval * 60,
340                         )
341                         break
342                     except asyncio.TimeoutError:
343                         pass
344 
345                     expired_items = await self.sweep_ttl()
346                     if expired_items > 0:
347                         logger.info(f"Store swept {expired_items} expired items")
348                 except asyncio.CancelledError:
349                     break
350                 except Exception as exc:
351                     logger.exception("Store TTL sweep iteration failed", exc_info=exc)
352 
353         task = asyncio.create_task(_sweep_loop())
354         task.set_name("ttl_sweeper")
355         self._ttl_sweeper_task = task
356         return task
357 
358     async def stop_ttl_sweeper(self, timeout: float | None = None) -> bool:
359         """Stop the TTL sweeper task if it's running.
360 
361         Args:
362             timeout: Maximum time to wait for the task to stop, in seconds.
363                 If `None`, wait indefinitely.
364 
365         Returns:
366             bool: True if the task was successfully stopped or wasn't running,
367                 False if the timeout was reached before the task stopped.
368         """
369         if self._ttl_sweeper_task is None or self._ttl_sweeper_task.done():
370             return True
371 
372         logger.info("Stopping TTL sweeper task")
373         self._ttl_stop_event.set()
374 
375         if timeout is not None:
376             try:
377                 await asyncio.wait_for(self._ttl_sweeper_task, timeout=timeout)
378                 success = True
379             except asyncio.TimeoutError:
380                 success = False
381         else:
382             await self._ttl_sweeper_task
383             success = True
384 
385         if success:
386             self._ttl_sweeper_task = None
387             logger.info("TTL sweeper task stopped")
388         else:
389             logger.warning("Timed out waiting for TTL sweeper task to stop")
390 
391         return success
392 
