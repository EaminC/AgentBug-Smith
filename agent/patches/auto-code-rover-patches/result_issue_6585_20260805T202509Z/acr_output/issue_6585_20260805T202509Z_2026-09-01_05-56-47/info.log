396     async def __aexit__(
397         self,
398         exc_type: type[BaseException] | None,
399         exc_val: BaseException | None,
400         exc_tb: TracebackType | None,
401     ) -> None:
402         # Ensure the TTL sweeper task is stopped when exiting the context
