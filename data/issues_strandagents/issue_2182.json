  "number": 2182,
  "title": "[BUG] OpenAIModel ignores vLLM reasoning field (delta.reasoning / message.reasoning)",
  "url": "https://github.com/strands-agents/harness-sdk/issues/2182",
  "state": "closed",
  "created_at": "2026-04-21T23:31:41Z",
