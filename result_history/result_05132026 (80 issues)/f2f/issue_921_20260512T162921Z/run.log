[32mFROM python:3.10-slim AS test_builder

WORKDIR /app

# Copy entire repository for tests and build
COPY . .

# Upgrade pip, setuptools, wheel early for robust installs
RUN python -m pip install --upgrade pip setuptools wheel

# Install Poetry if pyproject.toml exists
RUN if [ -f "pyproject.toml" ]; then \
      pip install poetry && \
      poetry config virtualenvs.create false && \
      poetry install --no-interaction --no-ansi; \
    else \
      echo "No pyproject.toml found, skipping Poetry install"; \
    fi

# Install testing dependencies unconditionally to avoid test collection errors
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout

# Install the project itself in editable mode if no src/ layout detected
# Assumption: No src/ directory detected, editable install is safe
RUN if [ ! -d "src" ]; then pip install -e .; else echo "src/ layout detected, skipping editable install"; fi

# Preflight import check to catch missing core modules early
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests as part of the build to verify install and code integrity
RUN pytest --cov=gpt_engineer

# Final stage: minimal runtime image with only production dependencies
FROM python:3.10-slim AS runtime

WORKDIR /app

COPY --from=test_builder /app /app

# Upgrade pip and install only production dependencies via Poetry if lockfile is present
RUN if [ -f "poetry.lock" ]; then \
      python -m pip install --upgrade pip setuptools wheel && \
      pip install poetry && \
      poetry config virtualenvs.create false && \
      poetry install --no-dev --no-interaction --no-ansi; \
    else \
      python -m pip install --upgrade pip setuptools wheel && \
      pip install -e .; \
    fi

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

CMD ["/bin/bash"][0m
