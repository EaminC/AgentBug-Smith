    model_name = "gpt-4"

    # Call the function and check it returns a dict with keys "prompt" and "completion"
    # or at least a dict.
    result = token_usage.get_openai_token_cost_for_model(model_name)

    assert isinstance(result, dict)
    # The dict should have keys related to token cost info, usually "prompt" and "completion"
    # but we allow any keys as long as dict is returned.
    assert len(result) > 0


