class TestDashScopeChatModelMultimodal(IsolatedAsyncioTestCase):
    async def test_multimodal_model_uses_async_call(self):
        model = DashScopeChatModel(
            model_name="qwen-vl-plus",
            api_key="test_key",
            stream=False,
            multimodality=True,
        )
        messages = [{"role": "user", "content": "Describe this image."}]

        mock_response = AsyncMock()
        mock_response.status_code = 200
        mock_response.output.choices = [AsyncMock()]
        mock_response.output.choices[0].message = AsyncMock()
        mock_response.output.choices[0].message.content = "This is a test image."

        with patch(
            "dashscope.AioMultiModalConversation.call",
            new_callable=AsyncMock,
        ) as mock_call:
            mock_call.return_value = mock_response
            result = await model(messages)
            mock_call.assert_called_once()
            call_kwargs = mock_call.call_args[1]
            assert call_kwargs["messages"] == messages
            assert call_kwargs["model"] == "qwen-vl-plus"
            # The result should have content with a TextBlock containing the response text
            assert hasattr(result, "content")
            assert isinstance(result.content, list)
            assert any(
                isinstance(block, TextBlock) and block.text == "This is a test image."
                for block in result.content
            )[0m
