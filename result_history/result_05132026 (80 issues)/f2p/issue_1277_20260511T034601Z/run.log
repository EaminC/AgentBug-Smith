[32mFROM python:3.10-slim AS test_builder

WORKDIR /app

COPY . .

# Detect src layout or imports from src in tests to decide install strategy
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        echo "Detected src layout or src imports in tests. Setting PYTHONPATH and installing dependencies without editable install."; \
        export PYTHONPATH=/app; \
        python -m pip install --upgrade pip setuptools wheel; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    else \
        echo "No src layout detected. Installing with editable install."; \
        python -m pip install --upgrade pip setuptools wheel; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    fi

# Preflight check to ensure core modules load properly
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

# Assumption: tests exist under tests/ and pytest can discover and run them
RUN pytest tests

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
