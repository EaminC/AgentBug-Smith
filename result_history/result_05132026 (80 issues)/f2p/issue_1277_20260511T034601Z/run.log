from unittest.mock import AsyncMock, patch

from agentscope.model import DashScopeChatModel, ChatResponse
from agentscope.message import TextBlock


class TestDashScopeChatModelMultimodalAsync(IsolatedAsyncioTestCase):
    async def test_multimodal_model_call_is_async(self):
        """
        Regression test for issue #1277:
        When multimodality=True, DashScopeChatModel.__call__ must use
        async dashscope.AioMultiModalConversation.call() instead of blocking
        sync MultiModalConversation.call().

        This test mocks dashscope.AioMultiModalConversation.call to verify
        it is awaited and called correctly, and that the returned result
        is a ChatResponse with expected content.

        On buggy code, this test should fail (e.g. timeout or wrong call).
        After fix, this test should pass.
        """
        model = DashScopeChatModel(
            model_name="qwen-vl-plus",
            api_key="test_key",
            stream=False,
            multimodality=True,
        )
        messages = [{"role": "user", "content": "Describe this image."}]

        # Prepare a dummy ChatResponse-like mock to be returned by the async call
        dummy_response = ChatResponse(
            content=[TextBlock(type="text", text="This is a test image.")],
            metadata={},
            raw=None,
        )

        # Patch the async call method to return the dummy_response
        with patch(
            "dashscope.AioMultiModalConversation.call",
            new_callable=AsyncMock,
        ) as mock_async_call:
            mock_async_call.return_value = dummy_response

            # Call the model asynchronously
            result = await model(messages)

            # Assert the async call was awaited exactly once
            mock_async_call.assert_awaited_once()

            # Check call arguments include expected messages and model name
            call_kwargs = mock_async_call.call_args[1]
            self.assertEqual(call_kwargs["messages"], messages)
            self.assertEqual(call_kwargs["model"], "qwen-vl-plus")

            # Assert the result is a ChatResponse instance with expected content
            self.assertIsInstance(result, ChatResponse)
            self.assertEqual(
                result.content,
                [TextBlock(type="text", text="This is a test image.")],
            )

    async def test_multimodal_model_call_blocks_event_loop_if_sync(self):
        """
        This test attempts to detect blocking behavior by measuring elapsed time
        when calling the model with multimodality=True.

        On buggy code, the synchronous call blocks the event loop, so other
        async tasks cannot run concurrently, causing delays.

        On fixed code, the call is async and does not block the event loop.

        This test is a heuristic and may fail if environment is heavily loaded.

        We run a concurrent async task that increments a counter every 0.05s,
        and run the model call concurrently. If the model call blocks, the
        counter increments will be delayed.
        """
        model = DashScopeChatModel(
            model_name="qwen-vl-plus",
            api_key="test_key",
            stream=False,
            multimodality=True,
        )
        messages = [{"role": "user", "content": "Describe this image."}]

        # Patch the async call method to simulate a delay
        async def fake_async_call(*args, **kwargs):
            # Simulate some async work with sleep
            await asyncio.sleep(0.1)
            return ChatResponse(
                content=[TextBlock(type="text", text="Fake async response")],
                metadata={},
                raw=None,
            )

        with patch(
            "dashscope.AioMultiModalConversation.call",
            new=fake_async_call,
        ):
            counter = 0
            stop_flag = False

            async def counter_task():
                nonlocal counter, stop_flag
                while not stop_flag:
                    counter += 1
                    await asyncio.sleep(0.05)

            # Run model call and counter_task concurrently
            counter_task_coro = counter_task()
            model_call_coro = model(messages)

            # Run both concurrently with timeout
            try:
                results = await asyncio.wait_for(
                    asyncio.gather(model_call_coro, counter_task_coro),
                    timeout=1.0,
                )
            except asyncio.TimeoutError:
                self.fail("Test timed out, possibly due to blocking call")

            # Stop the counter task
            stop_flag = True

            # If the model call blocks the event loop, counter increments will be low
            # We expect at least 10 increments (0.05s * 10 = 0.5s)
            self.assertGreaterEqual(
                counter,
                8,
                "Counter increments too low, event loop may be blocked by sync call",
            )[0m
