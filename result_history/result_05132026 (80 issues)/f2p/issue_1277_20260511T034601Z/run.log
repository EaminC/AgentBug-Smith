    async def test_multimodal_model_call_is_async(self):
        """
        Regression test for issue #1277:
        When multimodality=True, DashScopeChatModel.__call__ must use
        async dashscope.AioMultiModalConversation.call() instead of blocking
        sync MultiModalConversation.call().
    
        This test mocks dashscope.AioMultiModalConversation.call to verify
        it is awaited and called correctly, and that the returned result
        is a ChatResponse with expected content.
    
        On buggy code, this test should fail (e.g. timeout or wrong call).
        After fix, this test should pass.
        """
        model = DashScopeChatModel(
            model_name="qwen-vl-plus",
            api_key="test_key",
            stream=False,
            multimodality=True,
        )
        messages = [{"role": "user", "content": "Describe this image."}]
    
        # Prepare a dummy ChatResponse-like mock to be returned by the async call
