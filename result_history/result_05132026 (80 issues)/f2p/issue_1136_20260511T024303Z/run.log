[32mimport asyncio
import unittest
from unittest.mock import patch, AsyncMock
import random

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


async def calc_plus(num1: float, num2: float) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )


async def calc_minus(num1: float, num2: float) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )


async def get_weather(city: str) -> ToolResponse:
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch the internal network call of DashScopeChatModel to return a dummy response
        # We patch the internal _create_chat_completion_async method if exists, else _create_chat_completion
        # This is to avoid real network calls but keep the logic of tool calls intact

        target_async = "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion_async"
        target_sync = "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion"

        try:
            patcher = patch(target_async, new_callable=AsyncMock)
            self.mock_create_chat_completion = patcher.start()
            self.addCleanup(patcher.stop)
            self._patched_async = True
        except AttributeError:
            patcher = patch(target_sync, new_callable=AsyncMock)
            self.mock_create_chat_completion = patcher.start()
            self.addCleanup(patcher.stop)
            self._patched_async = False

        # Prepare a dummy response for the patched method
        # The response should simulate a single tool call per unique input
        # We simulate a response that returns a tool_use message followed by a tool_result message
        # The content is empty list to avoid repeated calls bug in qwen3-max

        async def dummy_create_chat_completion(messages, **kwargs):
            # Find the last assistant message that triggers a tool call
            last_msg = messages[-1]
            # Compose a dummy response with one tool call and one tool result
            tool_call = {
                "type": "tool_use",
                "id": "call_dummy_id",
                "name": "get_weather",
                "input": {"city": "北京"},
            }
            tool_result = {
                "type": "tool_result",
                "id": "call_dummy_id",
                "name": "get_weather",
                "output": [
                    {
                        "type": "text",
                        "text": "北京今天是晴天。",
                    }
                ],
            }
            # Compose assistant message with tool call and empty content list
            assistant_msg = {
                "role": "assistant",
                "content": [],
                "tool_calls": [
                    {
                        "id": "call_dummy_id",
                        "type": "function",
                        "function": {
                            "name": "get_weather",
                            "arguments": '{"city": "北京"}',
                        },
                    }
                ],
            }
            # Return a list of messages simulating the streaming chunks
            # For simplicity, return a list with the assistant message and tool result message
            return [assistant_msg, tool_result]

        self.mock_create_chat_completion.side_effect = dummy_create_chat_completion

    async def test_no_repeated_identical_tool_calls(self):
        # Setup toolkit and register tools
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        # Create ReActAgent with qwen3-max model
        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        # Prepare user message
        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Run the agent to get streaming responses
        streaming = await jarvis(msg)

        # Collect all tool_use calls from the streaming output
        tool_use_calls = []
        async for item in streaming:
            # item is a dict representing a message chunk
            if isinstance(item, dict) and item.get("type") == "tool_use":
                tool_use_calls.append(item)

        # We expect only one tool_use call with input city "北京"
        self.assertEqual(len(tool_use_calls), 1)
        self.assertEqual(tool_use_calls[0]["name"], "get_weather")
        self.assertEqual(tool_use_calls[0]["input"], {"city": "北京"})

        # Also check that the tool_use call ids are unique (only one here)
        ids = [call["id"] for call in tool_use_calls]
        self.assertEqual(len(ids), len(set(ids)))

        # This test will fail on buggy code because multiple identical tool calls appear
        # After the fix, only one tool call should be made for the same input

