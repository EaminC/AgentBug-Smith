[32mFROM python:3.10-slim AS test_builder

# Set working directory
WORKDIR /app

# Copy entire repository
COPY . .

# Detect if src/ layout or tests import src.
RUN set -eux; \
    if [ -d "src" ] || grep -RqE "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        echo "Detected src/ layout or src imports, setting PYTHONPATH and skipping editable install"; \
        export PYTHONPATH=/app; \
        python -m pip install --upgrade pip setuptools wheel && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm && \
        if [ -f "requirements.txt" ]; then pip install -r requirements.txt; fi; \
    else \
        python -m pip install --upgrade pip setuptools wheel && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm && \
        if [ -f "requirements.txt" ]; then pip install -r requirements.txt; fi && \
        pip install -e .; \
    fi

# Preflight check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests (assumption: tests can be run with pytest)
RUN pytest -v

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Minimal runtime image
FROM python:3.10-slim AS runtime

WORKDIR /app

COPY . .

# Install only production dependencies (no -e or dev)
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
