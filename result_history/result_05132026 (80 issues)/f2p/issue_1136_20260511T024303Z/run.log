class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch the internal network call of DashScopeChatModel to return a dummy response
        # We patch the internal _create_chat_completion_async method of DashScopeChatModel
        # to avoid real network calls but keep the logic of tool calls intact.
        # This is because the buggy code triggers repeated tool calls with identical parameters.

        # The patch target is inside agentscope.model._dashscope_model.DashScopeChatModel
        # We patch _create_chat_completion_async (async) method because _create_chat_completion does not exist.

        target_async = "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion_async"

        patcher = patch(target_async, new_callable=AsyncMock)
        self.mock_create_chat_completion = patcher.start()
        self.addCleanup(patcher.stop)

        # The dummy response simulates a single tool call and result, no repeated calls.
        async def dummy_create_chat_completion(messages, **kwargs):
            # We simulate a response with one tool call and one tool result.
            # The agent should not repeat identical tool calls consecutively.
            # The response format is a dict with 'choices' key.
            # We simulate the streaming behavior by returning a list of chunks.
            # For simplicity, return a single chunk with a tool call, then tool result.

            # We simulate the agent outputting a tool call with id "call_123" and name "get_weather"
            # then the system outputs the tool result for that call.

            # The agent's final message content is empty list [] to avoid repeated calls.

            # Compose the simulated response content:
            # The agent's message with tool call:
            agent_message = {
                "role": "assistant",
                "content": [],
                "tool_calls": [
                    {
                        "id": "call_123",
                        "type": "function",
                        "function": {
                            "name": "get_weather",
                            "arguments": '{"city": "北京"}',
                        },
                    }
                ],
            }
            # The system's tool result message:
            system_message = {
                "role": "tool",
                "tool_call_id": "call_123",
                "name": "get_weather",
                "content": [
                    {
                        "type": "text",
                        "text": "北京今天是晴天。",
                    }
                ],
            }
            # The agent's final message after tool result:
            agent_final_message = {
                "role": "assistant",
                "content": "天气信息已提供。",
            }

            # We simulate the sequence of messages returned by the model
            # For simplicity, return them as a list in 'choices' with 'message' key
            return {
                "choices": [
                    {"message": agent_message},
                    {"message": system_message},
                    {"message": agent_final_message},
                ]
            }

        self.mock_create_chat_completion.side_effect = dummy_create_chat_completion

    async def test_no_repeated_identical_tool_calls(self):
        # Prepare tool functions
        async def get_weather(city: str) -> agentscope.tool.ToolResponse:
            return agentscope.tool.ToolResponse(
                content=[
                    agentscope.message.TextBlock(
                        type="text",
                        text=f"{city}今天是晴天。",
                    )
                ]
            )

        async def calc_plus(num1: float, num2: float) -> agentscope.tool.ToolResponse:
            return agentscope.tool.ToolResponse(
                content=[
                    agentscope.message.TextBlock(
                        type="text",
                        text=str(num1 + num2),
                    )
                ]
            )

        async def calc_minus(num1: float, num2: float) -> agentscope.tool.ToolResponse:
            return agentscope.tool.ToolResponse(
                content=[
                    agentscope.message.TextBlock(
                        type="text",
                        text=str(num1 - num2),
                    )
                ]
            )

        # Register tools in toolkit
        toolkit = agentscope.toolkit.Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        # Create ReActAgent with qwen3-max model
        jarvis = agentscope.agent.ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=agentscope.model._dashscope_model.DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=agentscope.formatter.DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=agentscope.memory.InMemoryMemory(),
        )

        # Create user message
        msg = agentscope.message.Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Run the agent once
        streaming = await jarvis(msg)

        # Collect all messages from the streaming generator
        collected = []
        async for chunk in streaming:
            collected.append(chunk)

        # We expect exactly one tool call with name "get_weather" and input city "北京"
        # and no repeated identical tool calls consecutively.

        # Extract all tool call messages from collected
        tool_calls = [
            m
            for m in collected
            if isinstance(m, dict)
            and m.get("type") == "tool_use"
            and m.get("name") == "get_weather"
            and m.get("input", {}).get("city") == "北京"
        ]

        # Assert that there is exactly one tool call (no repeated identical calls)
        self.assertEqual(
            len(tool_calls),
            1,
            "Expected exactly one tool call with city '北京', but found repeated calls.",
        )

        # Also check that the tool call id is unique (only one)
        tool_call_ids = {m.get("id") for m in tool_calls}
        self.assertEqual(len(tool_call_ids), 1, "Tool call IDs should be unique and single.")

        # Check that the final assistant message content is not None or [{"text": None}]
        # but an empty list or string (due to patch fix)
        last_assistant_msgs = [
            m
            for m in collected
            if isinstance(m, dict)
            and m.get("role") == "assistant"
        ]
        # There should be at least one assistant message
        self.assertTrue(len(last_assistant_msgs) > 0, "No assistant messages found.")

        # Check content of last assistant message
        last_content = last_assistant_msgs[-1].get("content")
        # It should not be [{"text": None}] or None
        self.assertNotEqual(
            last_content,
            [{"text": None}],
            "Assistant message content should not be [{'text': None}].",
        )
        self.assertIsNotNone(
            last_content,
            "Assistant message content should not be None.",
        )


