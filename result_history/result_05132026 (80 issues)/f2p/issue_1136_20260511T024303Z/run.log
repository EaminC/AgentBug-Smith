[32mimport asyncio
import random
import unittest
from unittest.mock import patch, AsyncMock

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


async def calc_plus(
    num1: float,
    num2: float,
) -> ToolResponse:
    """
    加法计算器，计算两个数字的和

    Args:
        num1 (float): 第一个数字
        num2 (float): 第二个数字
    """

    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )


async def calc_minus(
    num1: float,
    num2: float,
) -> ToolResponse:
    """
    减法计算器，计算两个数字的差

    Args:
        num1 (float): 第一个数字
        num2 (float): 第二个数字
    """

    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )


async def get_weather(
    city: str,
) -> ToolResponse:
    """
    获取天气信息

    Args:
        city (str): 城市名称
    """
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch DashScopeChatModel._create_chat_completion to mock the network call and return a dummy response
        # The actual method to patch is _create_chat_completion (sync) which is called by __call__
        patcher = patch(
            "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion",
            new=self._mock_create_chat_completion,
        )
        self.addCleanup(patcher.stop)
        patcher.start()

    def _mock_create_chat_completion(self, messages, *args, **kwargs):
        # This mock simulates a response from the model that calls the get_weather tool multiple times with identical parameters
        # We'll simulate a sequence of tool_use and tool_result messages with different call ids but same input
        # The agent code expects a streaming async generator, but _create_chat_completion returns a sync object that the async method wraps
        # So we return a dummy object with an async generator method 'stream' that yields the expected messages

        class DummyStream:
            def __init__(self):
                self._messages = [
                    # Tool use 1
                    {
                        "type": "tool_use",
                        "id": "call_0ef073b5854945d28291749c",
                        "name": "get_weather",
                        "input": {"city": "北京"},
                    },
                    # Tool result 1
                    {
                        "type": "tool_result",
                        "id": "call_0ef073b5854945d28291749c",
                        "name": "get_weather",
                        "output": [
                            {"type": "text", "text": "北京今天是雨天。"}
                        ],
                    },
                    # Tool use 2 (same parameters)
                    {
                        "type": "tool_use",
                        "id": "call_0110ba389bf4426eb8142e40",
                        "name": "get_weather",
                        "input": {"city": "北京"},
                    },
                    # Tool result 2
                    {
                        "type": "tool_result",
                        "id": "call_0110ba389bf4426eb8142e40",
                        "name": "get_weather",
                        "output": [
                            {"type": "text", "text": "北京今天是晴天。"}
                        ],
                    },
                    # Tool use 3 (same parameters)
                    {
                        "type": "tool_use",
                        "id": "call_c269ad671e84471aa31f7828",
                        "name": "get_weather",
                        "input": {"city": "北京"},
                    },
                    # Tool result 3
                    {
                        "type": "tool_result",
                        "id": "call_c269ad671e84471aa31f7828",
                        "name": "get_weather",
                        "output": [
                            {"type": "text", "text": "北京今天是多云。"}
                        ],
                    },
                ]

            async def __aiter__(self):
                for msg in self._messages:
                    yield msg

        return DummyStream()

    async def test_no_repeated_identical_tool_calls(self):
        # Prepare tools and agent as in the reproduction steps
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Run the agent and collect all tool_use calls emitted
        tool_use_calls = []

        async for response in jarvis(msg):
            # The response is expected to be a dict with type "tool_use" or "tool_result" or normal assistant message
            if isinstance(response, dict) and response.get("type") == "tool_use":
                tool_use_calls.append(response)

        # We expect that the tool_use calls with identical parameters are not repeated excessively
        # The buggy behavior is repeated tool calls with identical parameters multiple times consecutively
        # The fix should prevent repeated identical calls consecutively

        # Check that no two consecutive tool_use calls have the same name and input
        for i in range(1, len(tool_use_calls)):
            prev = tool_use_calls[i - 1]
            curr = tool_use_calls[i]
            self.assertFalse(
                prev["name"] == curr["name"] and prev["input"] == curr["input"],
                msg=f"Repeated identical consecutive tool calls detected at indices {i-1} and {i}",
            )

        # Also check that at least two distinct tool_use calls exist (to ensure multiple calls happened)
        self.assertGreaterEqual(len(tool_use_calls), 2, "Expected multiple tool calls")

        # Check that all tool_use calls have the expected tool name and input keys
        for call in tool_use_calls:
            self.assertEqual(call["name"], "get_weather")
            self.assertIn("city", call["input"])
            self.assertEqual(call["input"]["city"], "北京")


