[32mimport asyncio
import unittest
from unittest.mock import patch, AsyncMock
import random

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


async def calc_plus(
    num1: float,
    num2: float,
) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )


async def calc_minus(
    num1: float,
    num2: float,
) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )


async def get_weather(
    city: str,
) -> ToolResponse:
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch DashScopeChatModel._call to mock the network call and return a dummy response
        # We patch _call because _create_chat_completion_async does not exist in the current codebase
        patcher = patch(
            "agentscope.model._dashscope_model.DashScopeChatModel._call",
            new_callable=AsyncMock,
        )
        self.mock_call = patcher.start()
        self.addCleanup(patcher.stop)

        # The mock response simulates a typical chat completion response with tool calls
        # We simulate a response that would cause repeated identical tool calls if buggy
        async def dummy_call(*args, **kwargs):
            # Return a dummy streaming async generator that yields a single message with tool call
            async def dummy_gen():
                # Simulate a tool_use message with get_weather call
                yield {
                    "choices": [
                        {
                            "delta": {
                                "role": "assistant",
                                "content": [],
                                "tool_calls": [
                                    {
                                        "id": "call_123",
                                        "type": "function",
                                        "function": {
                                            "name": "get_weather",
                                            "arguments": '{"city": "北京"}',
                                        },
                                    }
                                ],
                            },
                            "finish_reason": None,
                        }
                    ]
                }
                # Then simulate tool_result message
                yield {
                    "choices": [
                        {
                            "delta": {
                                "role": "tool",
                                "tool_call_id": "call_123",
                                "content": "北京今天是晴天。",
                                "name": "get_weather",
                            },
                            "finish_reason": "stop",
                        }
                    ]
                }

            return dummy_gen()

        self.mock_call.side_effect = dummy_call

    async def test_no_repeated_identical_tool_calls(self):
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Collect all outputs from the async generator
        outputs = []
        async for output in jarvis(msg):
            outputs.append(output)

        # We expect only one tool call with name get_weather and city 北京
        tool_calls = [
            o for o in outputs if isinstance(o, dict) and o.get("type") == "tool_use"
        ]
        # There should be exactly one tool_use call
        self.assertEqual(len(tool_calls), 1)

        # The tool call name should be get_weather
        self.assertEqual(tool_calls[0]["name"], "get_weather")

        # The input city should be 北京
        self.assertEqual(tool_calls[0]["input"]["city"], "北京")

        # There should be no repeated identical tool calls consecutively
        # We check the sequence of tool_use calls in outputs
        names = [o["name"] for o in tool_calls]
        # Since only one call expected, no repetition
        self.assertEqual(len(names), len(set(names)))

        # Also check that the content of the assistant message after tool call is not [{"text": None}]
        # This is related to the bug fixed in formatter
        for o in outputs:
            if isinstance(o, dict) and o.get("role") == "assistant":
                content = o.get("content")
                # Content should not be [{"text": None}] which triggers repeated calls
                self.assertNotEqual(content, [{"text": None}])

        # Check that the mock_call was called at least once
        self.assertTrue(self.mock_call.called)


if __name__ == "__main__":
