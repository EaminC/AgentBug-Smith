[32mimport asyncio
import random
import unittest
from unittest.mock import patch, AsyncMock

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


async def calc_plus(
    num1: float,
    num2: float,
) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )


async def calc_minus(
    num1: float,
    num2: float,
) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )


async def get_weather(
    city: str,
) -> ToolResponse:
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch DashScopeChatModel._create_chat_completion to mock the network call and return a dummy response
        # _create_chat_completion is the internal async method that sends messages to DashScope API
        # We patch it to simulate the model response without real network calls
        # We do not patch the method that runs the logic of tool calls, only the network call
        patcher = patch(
            "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion",
            new_callable=AsyncMock,
        )
        self.mock_create_chat_completion = patcher.start()
        self.addCleanup(patcher.stop)

        # Setup the mock to return a dummy streaming response that simulates tool calls
        # For simplicity, we simulate a single response chunk with a tool call and tool result
        async def dummy_streaming_response(*args, **kwargs):
            # This dummy response simulates the agent calling get_weather once with city "北京"
            # and then returning a tool result message.
            # The test will check that the tool is not called repeatedly with identical parameters.
            yield {
                "choices": [
                    {
                        "delta": {
                            "role": "assistant",
                            "content": [
                                {"text": None}
                            ],
                            "tool_calls": [
                                {
                                    "id": "call_1",
                                    "type": "function",
                                    "function": {
                                        "name": "get_weather",
                                        "arguments": '{"city": "北京"}',
                                    },
                                }
                            ],
                        },
                        "finish_reason": None,
                    }
                ]
            }
            yield {
                "choices": [
                    {
                        "delta": {
                            "role": "tool",
                            "tool_call_id": "call_1",
                            "content": "北京今天是晴天。",
                        },
                        "finish_reason": "stop",
                    }
                ]
            }

        self.mock_create_chat_completion.side_effect = dummy_streaming_response

    async def test_no_repeated_identical_tool_calls(self):
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Collect all tool calls made during the agent run
        tool_calls_made = []

        # Patch the toolkit's call_tool method to record calls
        original_call_tool = toolkit.call_tool

        async def call_tool_and_record(name, inputs):
            tool_calls_made.append((name, inputs))
            return await original_call_tool(name, inputs)

        toolkit.call_tool = call_tool_and_record

        # Run the agent
        # It returns an async generator because stream=True
        streaming = jarvis(msg)
        # Consume the streaming generator fully
        async for _ in streaming:
            pass

        # Check that the tool 'get_weather' was called only once with city "北京"
        calls_for_get_weather = [
            call for call in tool_calls_made if call[0] == "get_weather"
        ]
        self.assertEqual(len(calls_for_get_weather), 1)
        self.assertEqual(calls_for_get_weather[0][1], {"city": "北京"})

        # Also check that no repeated identical tool calls are made
        # i.e., no duplicate calls with same name and inputs
        seen = set()
        for name, inputs in tool_calls_made:
            key = (name, tuple(sorted(inputs.items())))
            self.assertNotIn(key, seen)
            seen.add(key)


if __name__ == "__main__":
    unittest.main()[0m
