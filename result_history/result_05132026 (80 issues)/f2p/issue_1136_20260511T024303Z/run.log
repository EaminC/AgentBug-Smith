[32mimport asyncio
import random
import unittest
from unittest.mock import patch, AsyncMock

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


async def calc_plus(
    num1: float,
    num2: float,
) -> ToolResponse:
    """
    加法计算器，计算两个数字的和

    Args:
        num1 (float): 第一个数字
        num2 (float): 第二个数字
    """

    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )
    
async def calc_minus(
    num1: float,
    num2: float,
) -> ToolResponse:
    """
    减法计算器，计算两个数字的差

    Args:
        num1 (float): 第一个数字
        num2 (float): 第二个数字
    """

    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )

async def get_weather(
    city: str,
) -> ToolResponse:
    """
    获取天气信息

    Args:
        city (str): 城市名称
    """
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch DashScopeChatModel._create_chat_completion to mock the network call and return a dummy response
        # _create_chat_completion is not present; instead patch DashScopeChatModel._create_chat_completion_async
        # But as per current code, the method is named _create_chat_completion_async
        # We patch the internal async method that sends messages to DashScope API
        # We do not patch the method that runs the logic of tool calls, only the network call
        patcher = patch(
            "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion_async",
            new_callable=AsyncMock,
        )
        self.mock_create_chat_completion = patcher.start()
        self.addCleanup(patcher.stop)

        # Setup dummy response for the mocked method
        # The dummy response simulates a single tool call and tool result with unique id each time
        async def dummy_create_chat_completion(messages, **kwargs):
            # Find if the last message from assistant contains a tool call
            last_assistant_msg = None
            for msg in reversed(messages):
                if msg.get("role") == "assistant":
                    last_assistant_msg = msg
                    break
            # Compose dummy response simulating tool call and tool result
            # We simulate that the model returns a tool_use block with unique id and then tool_result block
            # For simplicity, just return a static response with unique id based on count
            # We'll count how many times this function was called to generate unique ids
            call_count = getattr(self, "_call_count", 0)
            self._call_count = call_count + 1
            call_id = f"call_{call_count:08x}"

            # Compose response chunks as if streaming
            # For simplicity, return a list of dicts representing chunks
            # But the real method returns an async generator or similar, so we return a list for test
            # The test code awaits the agent call, so we must simulate the streaming interface
            # We return a list with a single dict representing the final message

            # Compose tool_use message
            tool_use = {
                "type": "tool_use",
                "id": call_id,
                "name": "get_weather",
                "input": {"city": "北京"},
            }
            # Compose tool_result message
            tool_result = {
                "type": "tool_result",
                "id": call_id,
                "name": "get_weather",
                "output": [
                    {
                        "type": "text",
                        "text": "北京今天是晴天。",
                    }
                ],
            }
            # Compose assistant final message content after tool calls
            assistant_content = (
                "根据您提供的多条记录，北京近期的天气情况如下：\n"
                "- 晴天：5次\n"
                "- 多云：3次\n"
                "- 雨天：3次\n"
                "这表明北京最近天气以晴天为主，间有多云和降雨。不过，这些数据并非实时气象信息，仅反映您输入的历史记录。如需准确的当前天气，请查询权威天气预报服务。"
            )

            # We simulate the streaming by yielding dicts one by one
            # But since the agent call expects an async iterable, we create async generator
            async def gen():
                # Yield tool_use message
                yield {"role": "assistant", "content": [tool_use]}
                # Yield tool_result message
                yield {"role": "system", "content": [tool_result]}
                # Yield final assistant message
                yield {"role": "assistant", "content": assistant_content}

            return gen()

        self.mock_create_chat_completion.side_effect = dummy_create_chat_completion

    async def test_no_repeated_identical_tool_calls(self):
        # Prepare toolkit with three tools
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Collect all tool_use messages seen during the streaming
        tool_use_calls = []

        # The agent returns an async iterable (streaming)
        streaming = await jarvis(msg)

        # Consume the streaming and collect tool_use messages
        async for chunk in streaming:
            # chunk is a dict with role and content
            # content can be list of blocks or string
            content = chunk.get("content")
            if isinstance(content, list):
                for block in content:
                    if isinstance(block, dict) and block.get("type") == "tool_use":
                        tool_use_calls.append(block)

        # Check that tool_use calls are not repeated consecutively with identical parameters
        # The bug was repeated tool calls with identical parameters multiple times
        # So we assert that no two consecutive tool_use calls have the same name and input
        for i in range(1, len(tool_use_calls)):
            prev = tool_use_calls[i - 1]
            curr = tool_use_calls[i]
            self.assertFalse(
                prev["name"] == curr["name"] and prev["input"] == curr["input"],
                msg=f"Repeated identical tool call detected at index {i}: {curr}",
            )

        # Also assert that there is at least one tool call
        self.assertGreater(len(tool_use_calls), 0, "No tool calls were made.")

        # Assert that the number of tool calls is reasonable (not excessively large)
        # The bug caused many repeated calls, so we expect a small number here
        self.assertLessEqual(len(tool_use_calls), 5, "Too many repeated tool calls.")

if __name__ == "__main__":
    unittest.main()[0m
