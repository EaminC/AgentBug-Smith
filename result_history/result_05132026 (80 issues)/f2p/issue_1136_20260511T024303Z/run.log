        self.mock_create_chat_completion = patcher.start()
        self.addCleanup(patcher.stop)

        # The dummy response simulates a single tool call per input, no repeated calls.
        # We simulate a chat completion response with one tool call for "get_weather" with city "北京".

        async def dummy_create_chat_completion(self_obj, messages, **kwargs):
            # Compose a dummy response that uses the tool once with city "北京"
            # and returns a tool result once.
            # This is a simplified simulation of the DashScope API response.

            # The agent expects a list of dict messages, we simulate the response format:
            # The response should contain a tool_use message and a tool_result message.

            # We simulate the tool_use message:
            tool_use_msg = {
                "role": "assistant",
                "content": [],
                "tool_calls": [
                    {
                        "id": "call_123",
                        "type": "function",
                        "function": {
                            "name": "get_weather",
                            "arguments": '{"city": "北京"}',
                        },
                    }
                ],
            }
            # The tool_result message:
            tool_result_msg = {
                "role": "tool",
                "tool_call_id": "call_123",
                "name": "get_weather",
                "content": [
                    {
                        "type": "text",
                        "text": "北京今天是晴天。",
                    }
                ],
            }
            # The final assistant message after tool result:
            final_assistant_msg = {
                "role": "assistant",
                "content": "北京天气晴朗。",
            }

            # Return the messages as a list to simulate streaming or full response
            return [tool_use_msg, tool_result_msg, final_assistant_msg]

        self.mock_create_chat_completion.side_effect = dummy_create_chat_completion

    async def test_no_repeated_identical_tool_calls(self):
        # Prepare toolkit with the three tools
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        # Create the agent with qwen3-max model (buggy model)
        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Run the agent
        # It should only call the tool once with city "北京"
        streaming = await jarvis(msg)

        # Collect all tool_use calls from the streaming output
        # streaming is an async iterable of messages
        tool_calls = []
        async for item in streaming:
            # We expect item to be a dict with keys like "type"
            if isinstance(item, dict) and item.get("type") == "tool_use":
                tool_calls.append(item)

        # Assert that there is exactly one tool call
        self.assertEqual(len(tool_calls), 1, "Expected exactly one tool call")

        # Assert the tool call is for get_weather with city "北京"
        tool_call = tool_calls[0]
        self.assertEqual(tool_call.get("name"), "get_weather")
        self.assertEqual(tool_call.get("input"), {"city": "北京"})

        # Assert no repeated identical tool calls (no duplicates)
        # We check that all tool calls are unique by their name and input
        seen = set()
        for call in tool_calls:
            key = (call.get("name"), frozenset(call.get("input", {}).items()))
            self.assertNotIn(key, seen, "Repeated identical tool call found")
            seen.add(key)


