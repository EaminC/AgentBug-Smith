[32mimport asyncio
import unittest
from unittest.mock import patch, AsyncMock
import random

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


async def calc_plus(
    num1: float,
    num2: float,
) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )


async def calc_minus(
    num1: float,
    num2: float,
) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )


async def get_weather(
    city: str,
) -> ToolResponse:
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch DashScopeChatModel._create_chat_completion to mock network call
        # The internal method is _create_chat_completion (sync) or _create_chat_completion_async (async)
        # The actual method to patch depends on the codebase; here we patch _create_chat_completion
        # to avoid AttributeError on _create_chat_completion_async which does not exist.
        patcher = patch(
            "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion",
            new_callable=AsyncMock,
        )
        self.mock_create_chat = patcher.start()
        self.addCleanup(patcher.stop)

        # Setup the mock to simulate a chat completion with a single tool call per invocation
        # and a response that does not cause repeated identical tool calls.

        async def mock_create_chat_completion(messages, **kwargs):
            # Simulate a response that uses the tool once with the city "北京"
            # and returns a tool_use message followed by a tool_result message
            # with different content each time to simulate randomness.
            # We simulate only one tool call per chat completion call.
            # The test will call the agent once, so one tool call expected.

            # Find the last user message content
            last_user_msg = None
            for m in reversed(messages):
                if m.get("role") == "user":
                    last_user_msg = m
                    break
            city = None
            if last_user_msg:
                content = last_user_msg.get("content")
                if isinstance(content, str):
                    city = content.strip()
                elif isinstance(content, list):
                    # If content is list of dicts with text keys
                    for c in content:
                        if isinstance(c, dict) and "text" in c:
                            city = c["text"]
                            break

            # Compose tool_use message
            tool_use_msg = {
                "type": "tool_use",
                "id": "call_1234567890abcdef",
                "name": "get_weather",
                "input": {"city": city or "北京"},
            }
            # Compose tool_result message
            weather_conditions = ["晴天", "多云", "雨天"]
            weather_text = f"{city or '北京'}今天是{random.choice(weather_conditions)}。"
            tool_result_msg = {
                "type": "tool_result",
                "id": "call_1234567890abcdef",
                "name": "get_weather",
                "output": [
                    {
                        "type": "text",
                        "text": weather_text,
                    }
                ],
            }

            # Compose assistant message that includes the tool_use
            assistant_msg = {
                "role": "assistant",
                "content": [{"text": None}],
                "tool_calls": [
                    {
                        "id": "call_1234567890abcdef",
                        "type": "function",
                        "function": {
                            "name": "get_weather",
                            "arguments": f'{{"city": "{city or "北京"}"}}',
                        },
                    }
                ],
            }

            # Return a list of messages as the model's response
            # The agent code expects an async generator or async iterable yielding partial messages,
            # but here we simplify by returning a list with the final message.
            # The patched method is async and returns the final completion result.
            return [assistant_msg, tool_use_msg, tool_result_msg]

        self.mock_create_chat.side_effect = mock_create_chat_completion

    async def test_no_repeated_identical_tool_calls(self):
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Run the agent once
        # The buggy behavior is that multiple identical tool calls happen consecutively.
        # The fixed behavior is that only one tool call happens for the input.
        # We test that the agent's output contains exactly one tool call with the city "北京".

        streaming = await jarvis(msg)

        # The streaming is an async generator or async iterable yielding messages
        # Collect all outputs
        outputs = []
        async for output in streaming:
            outputs.append(output)

        # Check that among outputs, there is exactly one tool_use with input city "北京"
        tool_use_calls = [
            o for o in outputs
            if isinstance(o, dict) and o.get("type") == "tool_use"
            and o.get("name") == "get_weather"
            and o.get("input", {}).get("city") == "北京"
        ]

        # Assert only one such tool_use call
        self.assertEqual(len(tool_use_calls), 1, "Expected exactly one tool_use call with city 北京")

        # Also check that the tool_result corresponding to this call is present
        tool_result_calls = [
            o for o in outputs
            if isinstance(o, dict) and o.get("type") == "tool_result"
            and o.get("name") == "get_weather"
        ]

        self.assertEqual(len(tool_result_calls), 1, "Expected exactly one tool_result call for get_weather")

        # Check that the tool_result output text contains the city name
        output_texts = []
        for tr in tool_result_calls:
            for block in tr.get("output", []):
                if block.get("type") == "text":
                    output_texts.append(block.get("text"))

        self.assertTrue(any("北京" in text for text in output_texts), "Expected output text to mention 北京")


if __name__ == "__main__":
    unittest.main()[0m
