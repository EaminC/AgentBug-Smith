        # The internal method is _call or _acall depending on implementation
        model_cls = DashScopeChatModel
        # Try to patch the internal async call method if exists
        if hasattr(model_cls, "_acall"):
            self.patcher = patch(
                "agentscope.model._dashscope_model.DashScopeChatModel._acall",
                new_callable=AsyncMock,
            )
        elif hasattr(model_cls, "_call"):
            self.patcher = patch(
                "agentscope.model._dashscope_model.DashScopeChatModel._call",
                new_callable=AsyncMock,
            )
        else:
            raise RuntimeError(
                "Neither _acall nor _call found in DashScopeChatModel"
            )
        self.mock_call = self.patcher.start()
        # Setup dummy response to simulate a normal model response
        # The response structure should be consistent with the expected output of DashScopeChatModel
        # We simulate a single tool call response with unique call ids each time
        async def dummy_response(*args, **kwargs):
            # Return a dummy response that would cause the agent to call tools multiple times if buggy
            # We simulate a normal response with a single tool call per invocation
            # The content is empty string to simulate qwen3-max behavior
            return {
                "choices": [
                    {
                        "message": {
                            "role": "assistant",
                            "content": "",
                            "tool_calls": [
                                {
                                    "id": f"call_{random.randint(100000,999999)}",
                                    "type": "function",
                                    "function": {
                                        "name": "get_weather",
                                        "arguments": '{"city": "北京"}',
                                    },
                                }
                            ],
                        }
                    }
                ]
            }

        self.mock_call.side_effect = dummy_response

    async def asyncTearDown(self):
        self.patcher.stop()

    async def test_no_repeated_identical_tool_calls(self):
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Collect all tool call names and arguments from the streaming output
        tool_calls_seen = []

        async for output in jarvis(msg):
            # output is expected to be a dict representing the assistant message or tool use
            # We check if output is a dict with type "tool_use"
            if isinstance(output, dict) and output.get("type") == "tool_use":
                # Extract tool name and input
                name = output.get("name")
                input_args = output.get("input")
                # Append tuple for comparison
                tool_calls_seen.append((name, str(input_args)))

        # We expect that the tool "get_weather" is called multiple times but NOT repeatedly with identical parameters consecutively
        # So no two consecutive calls should be identical in name and input
        for i in range(1, len(tool_calls_seen)):
            self.assertFalse(
                tool_calls_seen[i] == tool_calls_seen[i - 1],
                msg=f"Repeated identical tool call detected at positions {i-1} and {i}: {tool_calls_seen[i]}",
            )

        # Also, we expect at least some tool calls (more than 1) to confirm multiple calls happen
        self.assertGreater(len(tool_calls_seen), 1, "Expected multiple tool calls")

        # And all tool calls should be to "get_weather" with input city "北京"
        for name, input_str in tool_calls_seen:
            self.assertEqual(name, "get_weather")
            self.assertIn('"city": "北京"', input_str)


