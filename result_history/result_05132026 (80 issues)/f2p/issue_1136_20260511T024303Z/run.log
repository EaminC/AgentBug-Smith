[32mimport asyncio
import random
import unittest
from unittest.mock import patch, AsyncMock

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


async def calc_plus(
    num1: float,
    num2: float,
) -> ToolResponse:
    """
    加法计算器，计算两个数字的和

    Args:
        num1 (float): 第一个数字
        num2 (float): 第二个数字
    """

    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )
    
async def calc_minus(
    num1: float,
    num2: float,
) -> ToolResponse:
    """
    减法计算器，计算两个数字的差

    Args:
        num1 (float): 第一个数字
        num2 (float): 第二个数字
    """

    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )

async def get_weather(
    city: str,
) -> ToolResponse:
    """
    获取天气信息

    Args:
        city (str): 城市名称
    """
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch DashScopeChatModel._create_chat_completion to mock the network call and return a dummy response
        # The actual method to patch is _create_chat_completion (sync) or _create_chat_completion_async (async)
        # Inspecting the source, the async method is named _create_chat_completion
        # So patch _create_chat_completion to avoid real network calls
        patcher = patch(
            "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion",
            new_callable=AsyncMock,
        )
        self.mock_create_chat_completion = patcher.start()
        self.addCleanup(patcher.stop)

        # Setup mock to return a dummy successful response with a single tool call and tool result
        # The dummy response must simulate the model's output with no repeated identical tool calls
        # We simulate a single tool call to get_weather with city "北京"

        # The dummy response should be a ChatResponse-like object with content and tool_calls
        # We create a minimal dummy response that the model expects

        class DummyChatResponse:
            def __init__(self):
                self.content = [
                    {
                        "type": "tool_use",
                        "id": "call_123",
                        "name": "get_weather",
                        "input": {"city": "北京"},
                    }
                ]
                self.tool_calls = [
                    {
                        "id": "call_123",
                        "type": "function",
                        "function": {
                            "name": "get_weather",
                            "arguments": '{"city": "北京"}',
                        },
                    }
                ]
                self.usage = None
                self.metadata = {}

        async def dummy_create_chat_completion(*args, **kwargs):
            return DummyChatResponse()

        self.mock_create_chat_completion.side_effect = dummy_create_chat_completion

    async def test_no_repeated_identical_tool_calls(self):
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)
    
        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=False,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )
    
        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )
    
        # jarvis(msg) returns a coroutine that resolves to a list of messages
        # We await it to get the full list of messages
        messages = await jarvis(msg)

        # We expect only one tool_use message with name get_weather and input city 北京
        tool_use_msgs = [m for m in messages if isinstance(m.content, list) and any(
            (hasattr(b, "type") and b.type == "tool_use") or
            (isinstance(b, dict) and b.get("type") == "tool_use")
            for b in (m.content if isinstance(m.content, list) else [])
        )]

        # If no tool_use messages found, fail
        self.assertTrue(tool_use_msgs, "No tool_use messages found in response")

        # Extract all tool_use blocks from all messages
        all_tool_uses = []
        for m in tool_use_msgs:
            for block in m.content:
                if (hasattr(block, "type") and block.type == "tool_use") or (isinstance(block, dict) and block.get("type") == "tool_use"):
                    all_tool_uses.append(block)

        # Check that all tool uses have unique ids
        ids = [tu.id if hasattr(tu, "id") else tu.get("id") for tu in all_tool_uses]
        self.assertEqual(len(ids), len(set(ids)), "Repeated tool call ids found")

        # Check that tool uses with the same name and input do not appear multiple times consecutively
        # We check that there are no consecutive tool calls with identical name and input
        for i in range(len(all_tool_uses) - 1):
            current = all_tool_uses[i]
            next_ = all_tool_uses[i+1]
            current_name = current.name if hasattr(current, "name") else current.get("name")
            next_name = next_.name if hasattr(next_, "name") else next_.get("name")
            current_input = getattr(current, "input", None) or current.get("input")
            next_input = getattr(next_, "input", None) or next_.get("input")
            if current_name == next_name and current_input == next_input:
                self.fail(
                    f"Repeated consecutive tool calls with identical parameters found: {current_name} {current_input}"
                )

        # Also assert that at least one tool call was made (sanity)
        self.assertGreaterEqual(len(all_tool_uses), 1, "No tool calls found")

if __name__ == "__main__":
    unittest.main()[0m
