                    },
                    {
                        "video": self.mock_video_path,
                    },
                    {
                        "text": "</system-info>",
                    },
                ],
            },
            {
                "role": "user",
                "content": "<history>\nassistant:"
                " The capital of Japan is Tokyo.\n</history>",
            },
        ]

        self.maxDiff = None
        self.assertListEqual(expected_result, res)

