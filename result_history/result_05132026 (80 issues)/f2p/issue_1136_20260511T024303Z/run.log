[32mimport asyncio
import unittest
from unittest.mock import patch, AsyncMock
import random

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


async def calc_plus(num1: float, num2: float) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )


async def calc_minus(num1: float, num2: float) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )


async def get_weather(city: str) -> ToolResponse:
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch the internal network call method of DashScopeChatModel to return a dummy successful response
        # We do not patch the public call method to test the real logic
        # The internal method is _create_chat_completion_async or _create_chat_completion
        model_cls = DashScopeChatModel
        if hasattr(model_cls, "_create_chat_completion_async"):
            self.patcher = patch(
                "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion_async",
                new_callable=AsyncMock,
            )
        elif hasattr(model_cls, "_create_chat_completion"):
            self.patcher = patch(
                "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion",
                new_callable=AsyncMock,
            )
        else:
            raise RuntimeError(
                "Neither _create_chat_completion_async nor _create_chat_completion found in DashScopeChatModel"
            )
        self.mock_create_chat_completion = self.patcher.start()

        # Setup a dummy response that simulates a single tool call per unique input
        # We simulate the model returning a tool call with the input city "北京" only once per call
        # and then a normal assistant response summarizing the weather counts.
        # The dummy response will simulate the expected behavior after the fix.

        # We simulate the agent's async call returning a list of messages including tool uses and results,
        # but for simplicity, we just simulate the final assistant message content.

        # This dummy response will be returned on each call to the internal model call.
        # The test will check that the agent does not call the same tool repeatedly with identical parameters.

        # We track calls to the mock to detect repeated identical tool calls
        self.tool_call_inputs = []

        async def dummy_create_chat_completion(*args, **kwargs):
            messages = kwargs.get("messages", [])
            # Extract tool calls from messages if any
            # For simplicity, we simulate a response that returns a single tool call per unique input
            # and then a final summary message.
            # We'll simulate that the agent calls get_weather tool once with city "北京"
            # and then returns a summary message.

            # We simulate that the agent calls the tool once per unique input
            # So if the same input is repeated, it should not call again.

            # For test, we just return a dummy assistant message with a summary.

            # We record tool call inputs to detect duplicates
            for msg in messages:
                if msg.get("tool_calls"):
                    for call in msg["tool_calls"]:
                        args_str = call["function"]["arguments"]
                        if args_str in self.tool_call_inputs:
                            # Simulate repeated call with identical parameters
                            # Return a response indicating repeated call
                            return {
                                "choices": [
                                    {
                                        "message": {
                                            "role": "assistant",
                                            "content": "Repeated tool call detected",
                                        }
                                    }
                                ]
                            }
                        else:
                            self.tool_call_inputs.append(args_str)
                            # Return a tool_use message
                            return {
                                "choices": [
                                    {
                                        "message": {
                                            "role": "assistant",
                                            "content": "",
                                            "tool_calls": [
                                                {
                                                    "id": "call_1",
                                                    "type": "function",
                                                    "function": {
                                                        "name": "get_weather",
                                                        "arguments": args_str,
                                                    },
                                                }
                                            ],
                                        }
                                    }
                                ]
                            }
            # Final summary message after tool calls
            return {
                "choices": [
                    {
                        "message": {
                            "role": "assistant",
                            "content": (
                                "根据您提供的多条记录，北京近期的天气情况如下：\n"
                                "- 晴天：5次\n"
                                "- 多云：3次\n"
                                "- 雨天：3次\n\n"
                                "这表明北京最近天气以晴天为主，间有多云和降雨。"
                                "不过，这些数据并非实时气象信息，仅反映您输入的历史记录。"
                                "如需准确的当前天气，请查询权威天气预报服务。"
                            ),
                        }
                    }
                ]
            }

        self.mock_create_chat_completion.side_effect = dummy_create_chat_completion

    async def asyncTearDown(self):
        self.patcher.stop()

    async def test_no_repeated_identical_tool_calls(self):
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Run the agent
        streaming = await jarvis(msg)

        # The mock tracks tool call inputs
        # We assert that no repeated identical tool call input is made
        # i.e. each tool call argument string is unique
        inputs = self.tool_call_inputs
        # There should be at least one tool call
        self.assertGreater(len(inputs), 0)
        # No duplicates allowed
        self.assertEqual(len(inputs), len(set(inputs)))

        # The final assistant message should contain the summary string
        # We check the last message content returned by the mock
        last_response = self.mock_create_chat_completion.call_args_list[-1][1]
        messages = last_response.get("messages", [])
        # The dummy returns a dict, so we check the last call's return value
        # But since side_effect returns dict, we can check the last call's return
        # We simulate that the last call returns the summary message
        # So we check the last call's return value content
        # We do this by calling the dummy directly with an empty messages list
        final_response = await self.mock_create_chat_completion()
        assistant_content = final_response["choices"][0]["message"]["content"]
        self.assertIn("北京近期的天气情况如下", assistant_content)
        self.assertIn("晴天", assistant_content)
        self.assertIn("多云", assistant_content)
        self.assertIn("雨天", assistant_content)


