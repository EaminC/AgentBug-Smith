                    ],
                    role="system",
                ),
                # Final assistant message summarizing weather
                Msg(
                    name="Jarvis",
                    content=(
                        "根据您提供的多条记录，北京近期的天气情况如下：\n"
                        "- 晴天：2次\n- 多云：0次\n- 雨天：1次\n"
                        "这表明北京最近天气以晴天为主，间有多云和降雨。"
                    ),
                    role="assistant",
                ),
            ]

            for msg in tool_calls:
                yield msg

        patcher = patch(
            "agentscope.model._dashscope_model.DashScopeChatModel.__call__",
            new=mock_call,
        )
        self._patcher = patcher
        patcher.start()
        self.addCleanup(patcher.stop)

    async def test_no_repeated_identical_tool_calls(self):
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Collect all messages from the streaming generator
        messages = []
        async for m in jarvis(msg):
            messages.append(m)

        # Extract all tool_use blocks from assistant messages
        tool_use_calls = []
        for m in messages:
            if m.role == "assistant" and isinstance(m.content, list):
                for block in m.content:
                    if isinstance(block, dict) and block.get("type") == "tool_use":
                        tool_use_calls.append((block["name"], block["input"]))

        # Check that tool_use calls are not repeated consecutively with identical parameters
        # i.e., no two consecutive calls have same tool name and input
        for i in range(len(tool_use_calls) - 1):
            self.assertFalse(
                tool_use_calls[i] == tool_use_calls[i + 1],
                msg=(
                    f"Repeated identical consecutive tool calls found: "
                    f"{tool_use_calls[i]} and {tool_use_calls[i+1]}"
                ),
            )

        # Also check that at least one tool call was made
        self.assertGreater(len(tool_use_calls), 0, "No tool calls were made")

        # Check that the final assistant message contains a summary string
        final_assistant_msgs = [m for m in messages if m.role == "assistant" and isinstance(m.content, str)]
        self.assertTrue(
            any("北京" in m.content and "天气" in m.content for m in final_assistant_msgs),
            "Final assistant message does not contain expected weather summary",
        )


