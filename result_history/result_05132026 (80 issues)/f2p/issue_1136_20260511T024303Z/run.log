[32mimport asyncio
import unittest
from unittest.mock import patch, AsyncMock

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


async def calc_plus(num1: float, num2: float) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )


async def calc_minus(num1: float, num2: float) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )


async def get_weather(city: str) -> ToolResponse:
    # Return deterministic weather for testing to avoid randomness
    weather_map = {
        "北京": "晴天",
        "上海": "多云",
        "广州": "雨天",
    }
    weather = weather_map.get(city, "晴天")
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{city}今天是{weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch the internal network call method of DashScopeChatModel to return a dummy successful response
        # We do not patch the public call method to test the real logic
        # The internal method is _create_chat_completion_async or _create_chat_completion
        model_cls = DashScopeChatModel
        if hasattr(model_cls, "_create_chat_completion_async"):
            patch_target = "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion_async"
        elif hasattr(model_cls, "_create_chat_completion"):
            patch_target = "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion"
        else:
            raise RuntimeError(
                "Neither _create_chat_completion_async nor _create_chat_completion found in DashScopeChatModel"
            )

        self.patcher = patch(patch_target, new_callable=AsyncMock)
        self.mock_create_chat = self.patcher.start()

        # Dummy response simulating a single tool call and response
        # This dummy response is simplified and must be consistent with the model's expected output
        # The key is that the model returns a single tool call, not repeated identical calls
        dummy_response = {
            "choices": [
                {
                    "message": {
                        "role": "assistant",
                        "content": "",
                        "tool_calls": [
                            {
                                "id": "call_123",
                                "type": "function",
                                "function": {
                                    "name": "get_weather",
                                    "arguments": '{"city": "北京"}',
                                },
                            }
                        ],
                    }
                }
            ]
        }
        self.mock_create_chat.return_value = dummy_response

    async def asyncTearDown(self):
        self.patcher.stop()

    async def test_no_repeated_identical_tool_calls(self):
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Run the agent to get the streaming generator
        streaming = await jarvis(msg)

        # Collect all messages from the streaming generator
        results = []
        async for item in streaming:
            results.append(item)

        # We expect exactly one tool call with name "get_weather" and input city "北京"
        tool_calls = [
            msg
            for msg in results
            if isinstance(msg, dict)
            and msg.get("type") == "tool_use"
            and msg.get("name") == "get_weather"
        ]

        # Assert that there is exactly one tool call to get_weather
        self.assertEqual(len(tool_calls), 1, "Repeated identical tool calls found")

        # Assert the input parameter is correct
        input_param = tool_calls[0].get("input")
        self.assertIsNotNone(input_param, "Tool call input missing")
        self.assertEqual(input_param.get("city"), "北京", "Tool call input city mismatch")

        # Assert the tool result is present and corresponds to the tool call id
        tool_results = [
            msg
            for msg in results
            if isinstance(msg, dict)
            and msg.get("type") == "tool_result"
            and msg.get("name") == "get_weather"
        ]

        self.assertEqual(len(tool_results), 1, "Tool result missing or multiple results found")

        # The tool_result id should match the tool_use id
        self.assertEqual(
            tool_results[0].get("id"),
            tool_calls[0].get("id"),
            "Tool result id does not match tool call id",
        )


if __name__ == "__main__":
    unittest.main()[0m
