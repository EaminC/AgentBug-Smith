        ]
    )


async def get_weather(city: str) -> ToolResponse:
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch DashScopeChatModel._call to mock the network call and return a dummy response
        # _call is the internal async method that sends messages to DashScope API
        # We patch it to simulate the model response without real network calls
        patcher = patch("agentscope.model._dashscope_model.DashScopeChatModel._call", new_callable=AsyncMock)
        self.mock_call = patcher.start()
        self.addCleanup(patcher.stop)

        # The mock response simulates a model response that triggers multiple tool calls
        # We simulate the model returning multiple tool_use messages with identical parameters
        # The mock returns a sequence of messages that would cause repeated tool calls if buggy
        async def mock_call_side_effect(messages, **kwargs):
            # We simulate a response that includes multiple tool_use calls with identical input
            # The ReActAgent will parse these and call the tools accordingly
            # We simulate the streaming generator by yielding chunks
            # Each yield is a dict with "choices" key containing "delta" with content or tool_use
            # For simplicity, yield a list with one dict representing the final message
            # We simulate 3 tool_use calls with identical parameters "city": "北京"
            # The agent should call the tool 3 times with same input, but not more
            # The bug causes repeated calls beyond expected, so we check count later

            # Compose tool_use messages
            tool_calls = [
                {
                    "type": "tool_use",
                    "id": f"call_{i:02x}",
                    "name": "get_weather",
                    "input": {"city": "北京"},
                }
                for i in range(3)
            ]

            # Compose tool_result messages for each call
            tool_results = [
                {
                    "type": "tool_result",
                    "id": f"call_{i:02x}",
                    "name": "get_weather",
                    "output": [
                        {
                            "type": "text",
                            "text": f"北京今天是{random.choice(['晴天','多云','雨天'])}。",
                        }
                    ],
                }
                for i in range(3)
            ]

            # The agent expects a stream of messages; we yield tool_use then tool_result alternately
            # For the test, yield all tool_use first then all tool_result
            for tool_use in tool_calls:
                yield {"choices": [{"delta": {"tool_use": tool_use}}]}
            for tool_result in tool_results:
                yield {"choices": [{"delta": {"tool_result": tool_result}}]}
            # Then a final assistant message summarizing weather
            final_message = {
                "role": "assistant",
                "content": "根据您提供的多条记录，北京近期的天气情况如下：\n- 晴天：X次\n- 多云：Y次\n- 雨天：Z次\n"
                           "这表明北京最近天气以晴天为主，间有多云和降雨。不过，这些数据并非实时气象信息，仅反映您输入的历史记录。如需准确的当前天气，请查询权威天气预报服务。"
            }
            yield {"choices": [{"delta": {"content": final_message["content"], "role": "assistant"}}]}

        self.mock_call.side_effect = mock_call_side_effect

    async def test_no_repeated_identical_tool_calls(self):
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Collect all tool calls made by the agent
        tool_call_names = []
        tool_call_inputs = []

        # Patch the toolkit's run_tool method to record calls and call real function
        original_run_tool = toolkit.run_tool

        async def run_tool_mock(name, input_dict):
            tool_call_names.append(name)
            tool_call_inputs.append(input_dict)
            return await original_run_tool(name, input_dict)

        toolkit.run_tool = run_tool_mock

        # Run the agent with the message
        # It will invoke the model mock_call, which yields multiple tool_use/tool_result
        # The agent will call the registered tools accordingly
        await jarvis(msg)

        # Check that the tool "get_weather" was called exactly 3 times with identical input {"city": "北京"}
        calls = [(n, i) for n, i in zip(tool_call_names, tool_call_inputs) if n == "get_weather" and i == {"city": "北京"}]
        self.assertEqual(len(calls), 3, "Expected exactly 3 calls to get_weather with city 北京")

        # Check no extra repeated calls beyond 3 for the same parameters
        # If buggy, calls would be more than 3
        self.assertEqual(len(tool_call_names), len(calls), "No other tool calls expected")

        # Also check that the inputs are all identical
        for input_dict in tool_call_inputs:
            self.assertEqual(input_dict, {"city": "北京"})

