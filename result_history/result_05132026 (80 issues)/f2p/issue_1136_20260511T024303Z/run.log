[32mimport asyncio
import random
import unittest
from unittest.mock import patch, AsyncMock

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


async def calc_plus(
    num1: float,
    num2: float,
) -> ToolResponse:
    """
    加法计算器，计算两个数字的和

    Args:
        num1 (float): 第一个数字
        num2 (float): 第二个数字
    """

    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )


async def calc_minus(
    num1: float,
    num2: float,
) -> ToolResponse:
    """
    减法计算器，计算两个数字的差

    Args:
        num1 (float): 第一个数字
        num2 (float): 第二个数字
    """

    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )


async def get_weather(
    city: str,
) -> ToolResponse:
    """
    获取天气信息

    Args:
        city (str): 城市名称
    """
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch DashScopeChatModel._create_chat_completion_async to mock the network call and return a dummy response
        # The actual method to patch is _create_chat_completion_async (async)
        patcher = patch(
            "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion_async",
            new_callable=AsyncMock,
        )
        self.mock_create_chat_completion_async = patcher.start()
        self.addCleanup(patcher.stop)

        # Dummy response simulating a chat completion with multiple tool calls
        # We simulate that the model returns multiple tool_use messages with the same parameters but different IDs
        async def dummy_create_chat_completion_async(*args, **kwargs):
            # Simulate a streaming async generator that yields multiple tool_use messages with different IDs but same input
            # The ReActAgent should not call the same tool repeatedly with identical parameters
            # We simulate 3 tool calls with same input but different ids
            async def gen():
                # First tool call
                yield {
                    "choices": [
                        {
                            "delta": {
                                "role": "assistant",
                                "content": [{"text": None}],
                                "tool_calls": [
                                    {
                                        "id": "call_1",
                                        "type": "function",
                                        "function": {
                                            "name": "get_weather",
                                            "arguments": '{"city": "北京"}',
                                        },
                                    }
                                ],
                            }
                        }
                    ]
                }
                # Tool result for first call
                yield {
                    "choices": [
                        {
                            "delta": {
                                "role": "tool",
                                "tool_call_id": "call_1",
                                "name": "get_weather",
                                "content": "北京今天是晴天。",
                            }
                        }
                    ]
                }
                # Second tool call with same parameters but different id
                yield {
                    "choices": [
                        {
                            "delta": {
                                "role": "assistant",
                                "content": [{"text": None}],
                                "tool_calls": [
                                    {
                                        "id": "call_2",
                                        "type": "function",
                                        "function": {
                                            "name": "get_weather",
                                            "arguments": '{"city": "北京"}',
                                        },
                                    }
                                ],
                            }
                        }
                    ]
                }
                # Tool result for second call
                yield {
                    "choices": [
                        {
                            "delta": {
                                "role": "tool",
                                "tool_call_id": "call_2",
                                "name": "get_weather",
                                "content": "北京今天是多云。",
                            }
                        }
                    ]
                }
                # Third tool call with same parameters but different id
                yield {
                    "choices": [
                        {
                            "delta": {
                                "role": "assistant",
                                "content": [{"text": None}],
                                "tool_calls": [
                                    {
                                        "id": "call_3",
                                        "type": "function",
                                        "function": {
                                            "name": "get_weather",
                                            "arguments": '{"city": "北京"}',
                                        },
                                    }
                                ],
                            }
                        }
                    ]
                }
                # Tool result for third call
                yield {
                    "choices": [
                        {
                            "delta": {
                                "role": "tool",
                                "tool_call_id": "call_3",
                                "name": "get_weather",
                                "content": "北京今天是雨天。",
                            }
                        }
                    ]
                }
                # Final assistant message summarizing
                yield {
                    "choices": [
                        {
                            "delta": {
                                "role": "assistant",
                                "content": "根据您提供的多条记录，北京近期的天气情况如下：\n- 晴天：1次\n- 多云：1次\n- 雨天：1次",
                            }
                        }
                    ]
                }

            return gen()

        self.mock_create_chat_completion_async.side_effect = dummy_create_chat_completion_async

    async def test_no_repeated_identical_tool_calls(self):
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Collect all outputs from the async generator
        outputs = []
        async for output in jarvis(msg):
            outputs.append(output)

        # We expect that the tool "get_weather" is called multiple times but with different call ids
        # and the parameters should be identical but calls should be distinct (not repeated calls with same id)
        tool_call_ids = set()
        tool_call_inputs = []
        for output in outputs:
            if isinstance(output, dict):
                # We look for tool_use messages
                if output.get("type") == "tool_use" and output.get("name") == "get_weather":
                    tool_call_ids.add(output.get("id"))
                    tool_call_inputs.append(output.get("input"))

        # Assert that there are multiple distinct tool call ids
        self.assertGreaterEqual(len(tool_call_ids), 2, "Should have multiple distinct tool call ids")

        # Assert that all inputs are identical (all city == "北京")
        for inp in tool_call_inputs:
            self.assertEqual(inp, {"city": "北京"})

        # Assert that no duplicate tool call ids exist
        self.assertEqual(len(tool_call_ids), len(tool_call_inputs))

        # Assert that the final assistant message contains a summary of weather counts
        last_output = outputs[-1]
        self.assertIn("晴天", last_output if isinstance(last_output, str) else "")
        self.assertIn("多云", last_output if isinstance(last_output, str) else "")
        self.assertIn("雨天", last_output if isinstance(last_output, str) else "")


if __name__ == "__main__":
    unittest.main()[0m
