[32mimport asyncio
import random
import unittest
from unittest.mock import patch, AsyncMock

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


async def calc_plus(
    num1: float,
    num2: float,
) -> ToolResponse:
    """
    加法计算器，计算两个数字的和

    Args:
        num1 (float): 第一个数字
        num2 (float): 第二个数字
    """

    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )


async def calc_minus(
    num1: float,
    num2: float,
) -> ToolResponse:
    """
    减法计算器，计算两个数字的差

    Args:
        num1 (float): 第一个数字
        num2 (float): 第二个数字
    """

    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )


async def get_weather(
    city: str,
) -> ToolResponse:
    """
    获取天气信息

    Args:
        city (str): 城市名称
    """
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch DashScopeChatModel._create_chat_completion to mock the network call and return a dummy response
        # The actual method to patch is _create_chat_completion (sync) or _create_chat_completion_async (async)
        # Check which one exists; patch the async one if present, else the sync one.
        # We patch the internal async method that sends messages to DashScope API
        # We do not patch the method that runs the logic of tool calls, only the network call

        # The method to patch is _create_chat_completion (sync) or _create_chat_completion_async (async)
        # We try async first, fallback to sync if async not found
        target_async = "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion_async"
        target_sync = "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion"

        # Try patch async method first
        try:
            patcher = patch(target_async, new_callable=AsyncMock)
            self.mock_create_chat_completion = patcher.start()
            self.addCleanup(patcher.stop)
            self._patched_async = True
        except AttributeError:
            patcher = patch(target_sync, new_callable=AsyncMock)
            self.mock_create_chat_completion = patcher.start()
            self.addCleanup(patcher.stop)
            self._patched_async = False

        # Setup dummy response for the mocked method
        # The dummy response should simulate a chat completion response that triggers tool calls
        # We simulate a sequence of messages that includes tool_use blocks with different ids and inputs
        # The response is a generator or async generator yielding partial messages (stream=True)

        # We simulate a simple response that includes a tool call to get_weather with city "北京"
        # and then a tool result message with the weather text

        # The ReActAgent calls the model with stream=True, so the mocked method should be async generator

        async def dummy_chat_completion(*args, **kwargs):
            # Yield a message that triggers a tool call get_weather with city 北京
            yield {
                "choices": [
                    {
                        "delta": {
                            "role": "assistant",
                            "content": [{"text": None}],
                            "tool_calls": [
                                {
                                    "id": "call_1",
                                    "type": "function",
                                    "function": {
                                        "name": "get_weather",
                                        "arguments": '{"city": "北京"}',
                                    },
                                }
                            ],
                        },
                        "finish_reason": None,
                    }
                ]
            }
            # Yield a tool result message
            yield {
                "choices": [
                    {
                        "delta": {
                            "role": "tool",
                            "tool_call_id": "call_1",
                            "name": "get_weather",
                            "content": "北京今天是晴天。",
                        },
                        "finish_reason": None,
                    }
                ]
            }
            # Yield a final assistant message summarizing weather counts
            yield {
                "choices": [
                    {
                        "delta": {
                            "role": "assistant",
                            "content": "根据您提供的多条记录，北京近期的天气情况如下：\n- 晴天：5次\n- 多云：3次\n- 雨天：3次\n\n这表明北京最近天气以晴天为主，间有多云和降雨。不过，这些数据并非实时气象信息，仅反映您输入的历史记录。如需准确的当前天气，请查询权威天气预报服务。",
                        },
                        "finish_reason": "stop",
                    }
                ]
            }

        self.mock_create_chat_completion.side_effect = dummy_chat_completion

    async def test_no_repeated_identical_tool_calls(self):
        # Prepare tools and agent as in the example
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Run the agent with the message
        # It returns an async generator for streaming responses
        streaming = await jarvis(msg)

        # Collect all outputs from the streaming generator
        outputs = []
        async for output in streaming:
            outputs.append(output)

        # We expect that the tool "get_weather" is called only once with input city "北京"
        # Check the outputs for tool_use blocks and count distinct calls with same parameters

        tool_calls = []
        for out in outputs:
            # Each output is a Msg or similar object
            # We check if it contains tool_calls
            if hasattr(out, "tool_calls") and out.tool_calls:
                for call in out.tool_calls:
                    if call.get("function", {}).get("name") == "get_weather":
                        tool_calls.append(call)

        # Assert that there is exactly one tool call to get_weather with city 北京
        self.assertEqual(len(tool_calls), 1)

        # Assert the arguments are as expected
        args_json = tool_calls[0]["function"]["arguments"]
        self.assertIn('"city": "北京"', args_json)

        # Also check that the final assistant message contains the summary string
        final_texts = [o.content if isinstance(o.content, str) else "" for o in outputs if getattr(o, "role", None) == "assistant"]
        found_summary = any(
            "北京近期的天气情况如下" in text for text in final_texts if text
        )
        self.assertTrue(found_summary)


if __name__ == "__main__":
    unittest.main()[0m
