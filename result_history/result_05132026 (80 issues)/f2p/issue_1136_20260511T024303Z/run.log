import unittest
from unittest.mock import patch, AsyncMock

import random

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


async def calc_plus(
    num1: float,
    num2: float,
) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )


async def calc_minus(
    num1: float,
    num2: float,
) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )


async def get_weather(
    city: str,
) -> ToolResponse:
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch DashScopeChatModel._send_request to mock the network call and return a dummy response
        # _send_request is the internal async method that sends messages to DashScope API
        # We patch it to simulate the model response without real network calls
        # We do not patch the method that runs the logic of tool calls, only the network call
        patcher = patch("agentscope.model._dashscope_model.DashScopeChatModel._send_request", new_callable=AsyncMock)
        self.mock_send_request = patcher.start()
        self.addCleanup(patcher.stop)

        # The dummy response simulates a single tool call with unique id and name
        # We simulate the model returning a sequence of messages with tool calls
        # For the test, we simulate that the model returns only one tool call per invocation
        # and that the agent does not repeat the same tool call multiple times

        # We simulate the model response as a generator of chunks for streaming
        async def dummy_send_request(messages, **kwargs):
            # The model returns a single tool call message with a unique id
            # The content is empty string to simulate qwen3-max behavior
            # The tool call name is 'get_weather' with input city '北京'
            # We simulate the model returning only one tool call per invocation
            # The agent should not repeat the same tool call multiple times
            # We simulate a single response chunk
            return {
                "choices": [
                    {
                        "delta": {
                            "role": "assistant",
                        },
                        "finish_reason": None,
                    },
                    {
                        "delta": {
                            "content": "",
                            "tool_call": {
                                "name": "get_weather",
                                "arguments": '{"city": "北京"}',
                            },
                        },
                        "finish_reason": None,
                    },
                    {
                        "delta": {},
                        "finish_reason": "stop",
                    },
                ]
            }

        self.mock_send_request.side_effect = dummy_send_request

    async def test_no_repeated_identical_tool_calls(self):
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Run the agent and collect all tool calls made
        tool_call_names = []

        # Patch the toolkit's call_tool method to record tool calls
        original_call_tool = toolkit.call_tool

        async def call_tool_and_record(name, *args, **kwargs):
            tool_call_names.append(name)
            return await original_call_tool(name, *args, **kwargs)

        toolkit.call_tool = call_tool_and_record

        # Run the agent once
        # The buggy behavior is that the same tool is called multiple times with identical parameters
        # The fixed behavior is that the tool is called only once per unique input
        # We test that the tool_call_names list has no consecutive duplicates
        # For this test, since the dummy model returns only one tool call, the list should have exactly one element

        await jarvis(msg)

        # Assert that the tool was called exactly once
        self.assertEqual(len(tool_call_names), 1)

        # Assert that the tool called is 'get_weather'
        self.assertEqual(tool_call_names[0], "get_weather")


if __name__ == "__main__":
