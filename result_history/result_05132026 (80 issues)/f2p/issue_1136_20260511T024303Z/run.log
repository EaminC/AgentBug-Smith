[32mimport asyncio
import unittest
from unittest.mock import patch, AsyncMock
import random

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    """
    This test verifies that when using the qwen3-max model with multiple tools,
    the agent does not repeatedly invoke the same tool consecutively with identical parameters.

    The buggy behavior causes repeated identical tool calls.
    The fix ensures that repeated calls with identical parameters do not occur.
    """

    async def asyncSetUp(self):
        # Patch DashScopeChatModel._client_call to mock the network call and return a dummy response
        patcher = patch("agentscope.model._dashscope_model.DashScopeChatModel._client_call", new_callable=AsyncMock)
        self.mock_client_call = patcher.start()
        self.addCleanup(patcher.stop)

        # Setup dummy response simulating a single tool call sequence with unique IDs
        # The response is a generator of chunks simulating streaming output
        # We simulate a response with multiple tool calls but no repeated identical calls in a row
        async def dummy_streaming_response(*args, **kwargs):
            # Yield chunks that simulate a tool call and tool result alternation
            # We simulate 3 different tool calls with different IDs and inputs
            calls = [
                {
                    "type": "tool_use",
                    "id": "call_1",
                    "name": "get_weather",
                    "input": {"city": "北京"},
                },
                {
                    "type": "tool_result",
                    "id": "call_1",
                    "name": "get_weather",
                    "output": [{"type": "text", "text": "北京今天是晴天。"}],
                },
                {
                    "type": "tool_use",
                    "id": "call_2",
                    "name": "calc_plus",
                    "input": {"num1": 1, "num2": 2},
                },
                {
                    "type": "tool_result",
                    "id": "call_2",
                    "name": "calc_plus",
                    "output": [{"type": "text", "text": "3"}],
                },
                {
                    "type": "tool_use",
                    "id": "call_3",
                    "name": "calc_minus",
                    "input": {"num1": 5, "num2": 3},
                },
                {
                    "type": "tool_result",
                    "id": "call_3",
                    "name": "calc_minus",
                    "output": [{"type": "text", "text": "2"}],
                },
            ]
            for call in calls:
                yield call

        self.mock_client_call.side_effect = dummy_streaming_response

    async def test_no_repeated_identical_tool_calls(self):
        # Define tool functions
        async def calc_plus(num1: float, num2: float) -> ToolResponse:
            return ToolResponse(
                content=[
                    TextBlock(type="text", text=str(num1 + num2)),
                ]
            )

        async def calc_minus(num1: float, num2: float) -> ToolResponse:
            return ToolResponse(
                content=[
                    TextBlock(type="text", text=str(num1 - num2)),
                ]
            )

        async def get_weather(city: str) -> ToolResponse:
            # Return a fixed weather to avoid randomness in test
            return ToolResponse(
                content=[
                    TextBlock(type="text", text=f"{city}今天是晴天。"),
                ]
            )

        # Setup toolkit and register tools
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        # Create the agent with qwen3-max model
        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="dummy_key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        # Compose a message that triggers multiple tool calls
        msg = Msg(
            name="user1",
            content="请帮我计算并告诉我北京的天气",
            role="user",
        )

        # Collect all tool calls made during the agent run
        tool_calls_seen = []

        # Patch the toolkit's _call_tool_function to record calls and call real method
        original_call_tool_function = toolkit._call_tool_function

        async def wrapped_call_tool_function(tool_name, *args, **kwargs):
            # Record call parameters for detection of repeated calls
            tool_calls_seen.append((tool_name, args, kwargs))
            return await original_call_tool_function(tool_name, *args, **kwargs)

        toolkit._call_tool_function = wrapped_call_tool_function

        # Run the agent to completion and collect the streaming output
        # The agent returns an async generator of messages
        streaming = await jarvis(msg)

        # Consume the streaming generator fully
        results = []
        async for item in streaming:
            results.append(item)

        # Now analyze tool_calls_seen to detect repeated consecutive identical calls
        # We consider calls identical if tool_name and args and kwargs match exactly
        repeated_calls = False
        for i in range(1, len(tool_calls_seen)):
            prev = tool_calls_seen[i - 1]
            curr = tool_calls_seen[i]
            if prev == curr:
                repeated_calls = True
                break

        # Assert that no repeated consecutive identical tool calls happened
        self.assertFalse(
            repeated_calls,
            "Repeated identical consecutive tool calls detected for qwen3-max model"
        )


if __name__ == "__main__":
    unittest.main()[0m
