[32mimport asyncio
import random
import unittest
from unittest.mock import patch, AsyncMock

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


async def calc_plus(
    num1: float,
    num2: float,
) -> ToolResponse:
    """Addition calculator."""
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )


async def calc_minus(
    num1: float,
    num2: float,
) -> ToolResponse:
    """Subtraction calculator."""
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )


async def get_weather(
    city: str,
) -> ToolResponse:
    """Get weather info."""
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch DashScopeChatModel._create_chat_completion_async to mock network call
        # The method _create_chat_completion_async is the internal async method for chat completions
        patcher = patch(
            "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion_async",
            new_callable=AsyncMock,
        )
        self.mock_create_chat = patcher.start()
        self.addCleanup(patcher.stop)

        # Setup dummy streaming response generator for the mocked method
        async def dummy_streaming_response(*args, **kwargs):
            # Yield a few dummy chunks simulating streaming
            yield {"choices": [{"delta": {"content": "test"}}]}
            yield {"choices": [{"delta": {"content": " response"}}]}
            yield {"choices": [{"delta": {}}]}  # end of stream

        self.mock_create_chat.side_effect = dummy_streaming_response

    async def test_no_repeated_identical_tool_calls(self):
        """Test that Qwen3-Max model does not repeatedly call the same tool with identical parameters."""

        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Collect all tool_use blocks emitted during the agent run
        tool_use_calls = []

        # Patch the Toolkit's call_tool method to intercept tool calls and record inputs
        original_call_tool = toolkit.call_tool

        async def call_tool_and_record(*args, **kwargs):
            response = await original_call_tool(*args, **kwargs)
            # args[0] is the tool name, args[1] is the input dict
            tool_name = args[0] if len(args) > 0 else None
            tool_input = args[1] if len(args) > 1 else None
            tool_use_calls.append((tool_name, tool_input))
            return response

        with patch.object(toolkit, "call_tool", new=call_tool_and_record):
            # Run the agent (streaming generator)
            # Consume the streaming generator fully to trigger all tool calls
            async for _ in jarvis(msg):
                pass

        # Now analyze the recorded tool calls
        # We expect no consecutive repeated tool calls with identical parameters
        # i.e. no two adjacent calls with same tool name and same input dict

        self.assertGreaterEqual(len(tool_use_calls), 1, "No tool calls were made.")

        for i in range(1, len(tool_use_calls)):
            prev_call = tool_use_calls[i - 1]
            curr_call = tool_use_calls[i]
            # Assert that if tool name and input are identical, they are not consecutive
            self.assertFalse(
                prev_call == curr_call,
                f"Repeated identical tool call detected at calls {i-1} and {i}: {curr_call}",
            )


if __name__ == "__main__":
    unittest.main()[0m
