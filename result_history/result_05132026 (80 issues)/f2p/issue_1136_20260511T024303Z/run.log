async def calc_plus(
    num1: float,
    num2: float,
) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )


async def calc_minus(
    num1: float,
    num2: float,
) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )


async def get_weather(
    city: str,
) -> ToolResponse:
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch DashScopeChatModel._create_chat_completion_async to mock the network call and return a dummy response
        # The actual async method to patch is _create_chat_completion_async
        patcher = patch(
            "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion_async",
            new_callable=AsyncMock,
        )
        self.mock_create_chat_completion_async = patcher.start()
        self.addCleanup(patcher.stop)

        # Setup a dummy async generator to simulate streaming response from model
        async def dummy_streaming_response(*args, **kwargs):
            # Simulate a single message with one tool call and one tool result
            # The content should not be None or [{"text": None}] to avoid repeated calls
            yield {
                "choices": [
                    {
                        "delta": {
                            "role": "assistant",
                            "content": [{"text": ""}],
                            "tool_calls": [
                                {
                                    "id": "call_123",
                                    "type": "function",
                                    "function": {
                                        "name": "get_weather",
                                        "arguments": '{"city": "北京"}',
                                    },
                                }
                            ],
                        }
                    }
                ]
            }
            yield {
                "choices": [
                    {
                        "delta": {
                            "role": "tool",
                            "tool_call_id": "call_123",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "北京今天是晴天。",
                                }
                            ],
                            "name": "get_weather",
                        }
                    }
                ]
            }
            yield {
                "choices": [
                    {
                        "delta": {
                            "role": "assistant",
                            "content": "根据您提供的天气信息，北京近期天气晴朗。",
                        }
                    }
                ]
            }

        self.mock_create_chat_completion_async.side_effect = dummy_streaming_response

    async def test_no_repeated_identical_tool_calls(self):
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=True,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # Collect all messages from the async generator
        messages = []
        async for message in jarvis(msg):
            messages.append(message)

        # Count how many times get_weather tool is called with identical parameters
        tool_calls = [
            m
            for m in messages
            if isinstance(m.content, list)
            and any(
                getattr(block, "type", None) == "tool_use" and block.name == "get_weather"
                for block in m.content
            )
        ]

        # We expect only one tool call to get_weather with city "北京"
        self.assertEqual(len(tool_calls), 1, "Expected exactly one get_weather tool call")

        # Check the tool call input parameters are correct and identical
        tool_use_block = None
        for block in tool_calls[0].content:
            if getattr(block, "type", None) == "tool_use" and block.name == "get_weather":
                tool_use_block = block
                break

        self.assertIsNotNone(tool_use_block, "Tool use block for get_weather not found")
        self.assertEqual(tool_use_block.input, {"city": "北京"})

        # Check that the final assistant message contains expected summary text
        final_assistant_msgs = [
            m for m in messages if m.role == "assistant" and isinstance(m.content, str)
        ]
        self.assertTrue(
            any("北京近期天气晴朗" in m.content for m in final_assistant_msgs),
            "Expected assistant to summarize weather info",
        )


if __name__ == "__main__":
