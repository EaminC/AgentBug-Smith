[32mimport asyncio
import random
import unittest
from unittest.mock import patch, AsyncMock

from agentscope.agent import ReActAgent
from agentscope.formatter import DashScopeChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.message import Msg, TextBlock
from agentscope.model import DashScopeChatModel
from agentscope.tool import Toolkit, ToolResponse


async def calc_plus(
    num1: float,
    num2: float,
) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 + num2),
            ),
        ]
    )


async def calc_minus(
    num1: float,
    num2: float,
) -> ToolResponse:
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=str(num1 - num2),
            ),
        ]
    )


async def get_weather(
    city: str,
) -> ToolResponse:
    weather_conditions = ["晴天", "多云", "雨天"]
    random_weather = random.choice(weather_conditions)
    location = city
    return ToolResponse(
        content=[
            TextBlock(
                type="text",
                text=f"{location}今天是{random_weather}。",
            ),
        ]
    )


class TestQwen3MaxRepeatedToolCalls(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch the internal network call method of DashScopeChatModel to return a dummy successful response
        # The actual internal method is _create_chat_completion_async
        # But if it does not exist, fallback to _create_chat_completion (sync) wrapped with AsyncMock
        # We try to patch _create_chat_completion_async first, if AttributeError, patch _create_chat_completion

        # We patch _create_chat_completion_async if exists, else _create_chat_completion
        # We do not patch the public call method to test the real logic

        # Determine which attribute to patch
        model_cls = DashScopeChatModel
        if hasattr(model_cls, "_create_chat_completion_async"):
            patch_target = "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion_async"
        elif hasattr(model_cls, "_create_chat_completion"):
            patch_target = "agentscope.model._dashscope_model.DashScopeChatModel._create_chat_completion"
        else:
            raise RuntimeError("Neither _create_chat_completion_async nor _create_chat_completion found in DashScopeChatModel")

        self.patcher = patch(patch_target, new_callable=AsyncMock)
        self.mock_create_chat = self.patcher.start()

        # Setup the mock to return a dummy successful GenerationResponse-like object
        # The actual returned object is from dashscope.GenerationResponse or similar
        # We create a dummy object with status_code=200 and output containing a minimal valid response

        class DummyGenerationResponse:
            def __init__(self):
                self.status_code = 200
                self.request_id = "dummy-request-id"
                self.code = None
                self.message = None
                self.output = [
                    {
                        "type": "tool_use",
                        "id": "call_123",
                        "name": "get_weather",
                        "input": {"city": "北京"},
                    },
                    {
                        "type": "tool_result",
                        "id": "call_123",
                        "name": "get_weather",
                        "output": [
                            {
                                "type": "text",
                                "text": "北京今天是晴天。",
                            }
                        ],
                    },
                ]
                self.usage = None

        self.mock_create_chat.return_value = DummyGenerationResponse()

    async def asyncTearDown(self):
        self.patcher.stop()

    async def test_no_repeated_identical_tool_calls(self):
        toolkit = Toolkit()
        toolkit.register_tool_function(get_weather)
        toolkit.register_tool_function(calc_plus)
        toolkit.register_tool_function(calc_minus)

        jarvis = ReActAgent(
            name="Jarvis",
            sys_prompt="你是一个名为 Jarvis 的助手",
            model=DashScopeChatModel(
                model_name="qwen3-max",
                api_key="key",
                stream=False,
            ),
            formatter=DashScopeChatFormatter(),
            toolkit=toolkit,
            memory=InMemoryMemory(),
        )

        msg = Msg(
            name="user1",
            content="北京天气",
            role="user",
        )

        # jarvis(msg) returns a coroutine that resolves to a list of messages
        messages = await jarvis(msg)

        # We want to assert that the tool calls in the messages do not contain repeated identical calls consecutively
        # Extract all tool_use blocks from assistant messages
        tool_calls = []
        for m in messages:
            if m.get("role") == "assistant" and "tool_calls" in m:
                for call in m["tool_calls"]:
                    tool_calls.append((call["name"], call["function"]["arguments"]))

        # Check that no two consecutive tool calls are identical
        for i in range(1, len(tool_calls)):
            self.assertFalse(
                tool_calls[i] == tool_calls[i - 1],
                f"Repeated identical consecutive tool calls found: {tool_calls[i]}",
            )

        # Also check that at least one tool call was made
        self.assertGreater(len(tool_calls), 0, "No tool calls were made by the agent")


if __name__ == "__main__":
    unittest.main()[0m
