[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Copy entire repository to ensure all files including injected tests are present
COPY . .

# Detect src/ layout or src imports in tests to decide installation method
RUN set -e; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -d "src" ] || grep -RqE "^\s*(from|import) src\." tests 2>/dev/null; then \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
        export PYTHONPATH=/app; \
    else \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# Preflight check to fail fast on missing core modules
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Explicitly run tests to verify test suite integrity (assumption: tests folder exists)
RUN pytest --maxfail=1 --disable-warnings -q || (echo "Tests failed" && exit 1)

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}


# Minimal runtime image for production
FROM python:3.12-slim AS runtime

WORKDIR /app

COPY --from=test_builder /app /app

# Install only production dependencies
RUN set -e; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -f "requirements.txt" ]; then \
        pip install --no-cache-dir -r requirements.txt; \
    else \
        pip install --no-cache-dir -e .; \
    fi

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

