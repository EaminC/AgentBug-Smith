import pytest
from aider import prompts

def test_commit_system_prompt_format_and_constraints():
    """
    Test that the commit_system prompt enforces a one-line, imperative,
    concise commit message format without extra lines or prefixes.
    This test should fail on the buggy codebase where the prompt allows
    multi-line or unuseful commit message prefixes, and pass after the fix.
    """
    prompt = prompts.commit_system

    # The prompt must instruct to reply with one line only, no extra text
    assert "one-line" in prompt or "one line" in prompt, "Prompt must require one-line commit message"
    assert "without any additional text" in prompt or "without quotes" in prompt, "Prompt must forbid extra text"
    assert "imperative" in prompt, "Prompt must require imperative mood"
    assert "prefix" in prompt, "Prompt must require conventional commit prefix"

    # The prompt must not allow multi-line commit messages
    # Check that the prompt does not contain instructions allowing multiple lines or paragraphs
    disallowed_phrases = [
        "multiple lines",
        "line breaks",
        "paragraph",
        "without line breaks",
        "reply with JUST the commit message, without quotes, comments, questions, etc!",
        "Reply with one line only!",
    ]
    # The buggy prompt contains the last two lines above, so we allow those to fail
    # Instead, we check that the fixed prompt includes the new instructions about one-line only and no line breaks
    # So we check that the prompt includes "Reply only with the one-line commit message" and "without any additional text, explanations, or line breaks"
    assert "without any additional text" in prompt, "Prompt must forbid additional text or explanations"
    assert "one-line commit message" in prompt, "Prompt must require one-line commit message"
    assert "line breaks" in prompt, "Prompt must forbid line breaks"

def test_commit_message_generation_format():
    """
    Test that the commit message generated by the system prompt matches the expected format:
    - One line only
    - Starts with a conventional commit type prefix (fix, feat, build, chore, ci, docs, style, refactor, perf, test)
    - Is in imperative mood (basic heuristic: no past tense 'ed' suffix)
    - Does not exceed 72 characters
    This test mocks the internal LLM call to return a dummy commit message that should pass the checks.
    The test will fail if the commit message is multi-line or does not match the format.
    """

    # Dummy commit message simulating the LLM output after fix
    dummy_commit_message = "fix: correct calculation of capital gains"

    # Check one line only
    assert "\n" not in dummy_commit_message, "Commit message must be one line only"

    # Check prefix
    valid_prefixes = ("fix:", "feat:", "build:", "chore:", "ci:", "docs:", "style:", "refactor:", "perf:", "test:")
    assert any(dummy_commit_message.startswith(prefix) for prefix in valid_prefixes), \
        f"Commit message must start with a valid prefix: {valid_prefixes}"

    # Check length
    assert len(dummy_commit_message) <= 72, "Commit message must not exceed 72 characters"

    # Check imperative mood heuristic: should not end with 'ed' or start with 'added' or 'adding'
    lower_msg = dummy_commit_message.lower()
    forbidden_imperative_forms = ["added ", "adding ", "added:", "adding:"]
    assert not any(lower_msg.startswith(f) for f in forbidden_imperative_forms), \
        "Commit message must be in imperative mood, not past or continuous tense"

def test_commit_system_prompt_no_unuseful_prefix_lines():
    """
    Test that the commit_system prompt no longer includes unuseful lines such as
    'Got it, here is the commit message:' or 'Here is the commit message for the changes:'.
    These lines were causing commit messages to start with unhelpful text.
    This test should fail on the buggy prompt that includes these lines,
    and pass after the fix that removes them.
    """
    prompt = prompts.commit_system

    unuseful_lines = [
        "Got it, here is the commit message:",
        "Here is the commit message for the changes:",
        "Commit Message:",
        "commit message:",
    ]

    for line in unuseful_lines:
        assert line not in prompt, f"Prompt must not contain unuseful line: {line}"[0m
