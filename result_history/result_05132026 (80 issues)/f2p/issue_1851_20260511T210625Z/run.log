[32mimport pytest
from aider import prompts


def test_commit_system_prompt_format_and_constraints():
    """
    Test that the commit_system prompt enforces a one-line, imperative,
    concise commit message format without extra lines or prefixes.
    This test should fail on the buggy codebase where the prompt allows
    multi-line or unuseful commit message prefixes, and pass after the fix.
    """
    prompt = prompts.commit_system

    # The prompt must instruct to reply with one line only, no extra text
    assert ("one-line" in prompt or "one line" in prompt), "Prompt must require one-line commit message"
    assert (
        "without any additional text" in prompt
        or "without quotes" in prompt
        or "without line breaks" in prompt
    ), "Prompt must forbid extra text or line breaks"
    assert "imperative" in prompt, "Prompt must require imperative mood"
    assert "prefix" in prompt, "Prompt must require conventional commit prefix"


def test_commit_system_prompt_length_limit():
    """
    Test that the commit_system prompt requires commit messages to not exceed 72 characters.
    This is a standard git commit message length limit.
    """
    prompt = prompts.commit_system
    assert "72 characters" in prompt or "not exceed 72" in prompt, "Prompt must require commit message length limit"


def test_commit_system_prompt_imperative_mood_example():
    """
    Test that the prompt requires imperative mood with an example.
    """
    prompt = prompts.commit_system
    assert "imperative mood" in prompt or "imperative tense" in prompt, "Prompt must require imperative mood"
    # The example might be "Add feature" or "Add"
    assert "Add feature" in prompt or "Add" in prompt, "Prompt should give example of imperative mood"


def test_commit_system_prompt_no_unuseful_prefix_lines():
    """
    Test that the commit_system prompt no longer includes unuseful lines such as
    'Got it, here is the commit message:' or 'Here is the commit message for the changes:'.
    These lines were causing commit messages to start with unhelpful text.
    This test should fail on the buggy prompt that includes these lines,
    and pass after the fix that removes them.
    """
    prompt = prompts.commit_system

    unuseful_lines = [
        "Got it, here is the commit message:",
        "Here is the commit message for the changes:",
        "Commit Message:",
        "commit message:",
    ]

    for line in unuseful_lines:
        assert line not in prompt, f"Prompt must not contain unuseful line: {line}"[0m
