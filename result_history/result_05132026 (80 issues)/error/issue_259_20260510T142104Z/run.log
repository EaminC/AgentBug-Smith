        self.assertEqual(common_prefix, os.path.abspath(self.test_dir), "Log directory is not inside save_dir")

        # The log directory should exist
        self.assertTrue(os.path.exists(dir_log), "Log directory does not exist")

        # Also check that the config files are saved inside save_dir
        # file_manager.path_db should be inside save_dir
        self.assertTrue(hasattr(file_manager, "path_db"), "file_manager.path_db attribute missing")
        path_db = file_manager.path_db
        self.assertIsNotNone(path_db, "file_manager.path_db is None")
        common_prefix_db = os.path.commonpath([path_db, self.test_dir])
        self.assertEqual(common_prefix_db, os.path.abspath(self.test_dir), "DB path is not inside save_dir")
        self.assertTrue(os.path.exists(os.path.dirname(path_db)), "DB directory does not exist")


if __name__ == "__main__":
