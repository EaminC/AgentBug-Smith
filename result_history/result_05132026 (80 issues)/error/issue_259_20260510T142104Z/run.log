            save_log=True,
        )

        # file_manager.dir_log should be set and inside the custom save_dir
        self.assertTrue(
            hasattr(file_manager, "dir_log"),
            "file_manager.dir_log attribute missing",
        )
        dir_log = file_manager.dir_log
        self.assertIsNotNone(dir_log)
        self.assertTrue(os.path.isabs(dir_log))
        self.assertTrue(dir_log.startswith(os.path.abspath(self.test_dir)))

        # The directory should exist
        self.assertTrue(os.path.exists(dir_log))

        # Also check that the config file (agentscope.db) is inside save_dir
        db_path = file_manager.path_db
        self.assertIsNotNone(db_path)
        self.assertTrue(os.path.isabs(db_path))
        self.assertTrue(db_path.startswith(os.path.abspath(self.test_dir)))
        self.assertTrue(os.path.exists(db_path))


if __name__ == "__main__":
    unittest.main()[0m
