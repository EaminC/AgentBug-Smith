[32mimport os
import shutil
import unittest

import agentscope
from agentscope.file_manager import file_manager


class TestConversationLogPath(unittest.TestCase):
    """
    Test that when a custom save_dir is set in agentscope.init,
    the conversation logs are generated in that directory,
    not in the default folder.
    """

    def setUp(self) -> None:
        # Use a unique directory for this test
        self.test_dir = "./.unittest_conversation_log_path"
        if os.path.exists(self.test_dir):
            shutil.rmtree(self.test_dir)

    def tearDown(self) -> None:
        if os.path.exists(self.test_dir):
            shutil.rmtree(self.test_dir)

    def test_log_path_respects_save_dir(self):
        # Initialize agentscope with a custom save_dir
        agentscope.init(
            project="test_project",
            name="test_agent",
            save_dir=self.test_dir,
            save_log=True,
        )

        # The file_manager.dir_log should be inside the custom save_dir
        log_dir = str(file_manager.dir_log)
        self.assertTrue(log_dir.startswith(os.path.abspath(self.test_dir)),
                        f"Log directory {log_dir} does not start with {os.path.abspath(self.test_dir)}")

        # The log directory should exist after init
        self.assertTrue(os.path.exists(log_dir),
                        f"Log directory {log_dir} does not exist after initialization")

        # Create a dummy log file to simulate conversation log generation
        dummy_log_file = os.path.join(log_dir, "conversation.log")
        with open(dummy_log_file, "w", encoding="utf-8") as f:
            f.write("Test conversation log content")

        # Check that the dummy log file exists in the custom directory
        self.assertTrue(os.path.isfile(dummy_log_file),
                        "Conversation log file was not created in the custom save_dir")

        # Also check that the default directory does NOT contain the log file
        default_dir = os.path.abspath("./test_runs")
        default_log_file = os.path.join(default_dir, "conversation.log")
        self.assertFalse(os.path.exists(default_log_file),
                         "Conversation log file should not be created in the default directory")


if __name__ == "__main__":
    unittest.main()[0m
