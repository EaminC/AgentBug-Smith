[32mimport os
import shutil
import unittest

import agentscope
from agentscope.file_manager import FileManager
from agentscope.utils import MonitorFactory


class TestLogPathConfig(unittest.TestCase):
    def setUp(self) -> None:
        # Define a custom directory for logs
        self.custom_log_dir = "./custom_log_dir"
        # Clean up before test
        if os.path.exists(self.custom_log_dir):
            shutil.rmtree(self.custom_log_dir)

    def tearDown(self) -> None:
        # Clean up after test
        if os.path.exists(self.custom_log_dir):
            shutil.rmtree(self.custom_log_dir)
        MonitorFactory._instance = None  # pylint: disable=W0212

    def test_log_path_respects_save_dir(self):
        # Initialize agentscope with a custom save_dir
        agentscope.init(
            project="test",
            name="test_agent",
            save_dir=self.custom_log_dir,
            save_log=True,
        )

        # The file_manager's log directory should be inside the custom_log_dir
        fm = FileManager()
        # The log directory path should start with the custom_log_dir absolute path
        log_dir_path = os.path.abspath(fm.dir_log)
        custom_dir_path = os.path.abspath(self.custom_log_dir)
        self.assertTrue(
            log_dir_path.startswith(custom_dir_path),
            f"Log directory {log_dir_path} is not inside the custom save_dir {custom_dir_path}",
        )

        # Also check that the directory actually exists
        self.assertTrue(os.path.exists(log_dir_path), "Log directory does not exist")

        # Check that a config file or log file is created inside the directory (if applicable)
        # We check for any files inside the log directory
        files = os.listdir(log_dir_path)
        self.assertTrue(len(files) > 0, "No files found in the log directory")

        # Re-init with save_log=False should disable log directory creation
        agentscope.init(
            project="test",
            name="test_agent",
            save_dir=self.custom_log_dir,
            save_log=False,
        )
        # When save_log=False, dir_log should be None or not exist
        fm2 = FileManager()
        if fm2.dir_log is not None:
            self.assertFalse(os.path.exists(fm2.dir_log), "Log directory should not exist when save_log=False")


if __name__ == "__main__":
    unittest.main()[0m
