import os
import shutil
import tempfile

import agentscope
from agentscope import file_manager


class TestConversationLogPath(unittest.TestCase):
    def setUp(self):
        # Create a temporary directory for testing
        self.test_dir = tempfile.mkdtemp(prefix="unittest_conversation_log_path_")

    def tearDown(self):
        # Clean up the temporary directory after test
        shutil.rmtree(self.test_dir, ignore_errors=True)

    def test_log_path_respects_save_dir(self):
        # Initialize agentscope with a custom save_dir and save_log enabled
        agentscope.init(
            project="test_project",
            name="test_agent",
            save_dir=self.test_dir,
            save_log=True,
        )

        # file_manager.dir_log should be set and inside the custom save_dir
        # It should be a Path-like object convertible to str
        self.assertTrue(hasattr(file_manager, "dir_log"), "file_manager.dir_log attribute missing")
        log_dir = os.path.abspath(str(file_manager.dir_log))
        test_dir_abs = os.path.abspath(self.test_dir)

        # The log directory should be inside the test_dir
        self.assertTrue(
            log_dir.startswith(test_dir_abs),
            f"log_dir {log_dir} is not inside save_dir {test_dir_abs}",
        )

        # The directory should exist on filesystem
        self.assertTrue(os.path.isdir(log_dir), f"log_dir {log_dir} does not exist")

        # Also check that the agentscope.db file is created inside the save_dir (monitor db path)
        db_path = getattr(file_manager, "path_db", None)
        self.assertIsNotNone(db_path, "file_manager.path_db attribute missing")
        db_path_abs = os.path.abspath(str(db_path))
        self.assertTrue(
            db_path_abs.startswith(test_dir_abs),
            f"db_path {db_path_abs} is not inside save_dir {test_dir_abs}",
        )
        self.assertTrue(os.path.isfile(db_path_abs), f"db_path {db_path_abs} file does not exist")


if __name__ == "__main__":
    unittest.main()[0m
