class TestConversationLogPath(unittest.TestCase):
    def setUp(self):
        # Create a temporary directory for the test save_dir
        self.test_dir = tempfile.mkdtemp(prefix="unittest_conversation_log_path_")

    def tearDown(self):
        # Clean up the temporary directory after test
        shutil.rmtree(self.test_dir, ignore_errors=True)

    def test_log_path_respects_save_dir(self):
        # Initialize agentscope with a custom save_dir and save_log enabled
        agentscope.init(
            project="test_project",
            name="test_agent",
            save_dir=self.test_dir,
            save_log=True,
