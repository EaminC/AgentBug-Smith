[32mimport unittest
import tempfile
import shutil
import os

import agentscope
from agentscope import file_manager


class TestConversationLogPath(unittest.TestCase):
    def setUp(self):
        # Create a temporary directory for save_dir
        self.test_dir = tempfile.mkdtemp(prefix="unittest_conversation_log_path_")

    def tearDown(self):
        # Remove the temporary directory after test
        shutil.rmtree(self.test_dir)

    def test_log_path_respects_save_dir(self):
        # Initialize agentscope with a custom save_dir and save_log enabled
        agentscope.init(
            project="test_project",
            name="test_agent",
            save_dir=self.test_dir,
            save_log=True,
        )

        # file_manager.dir_log should be set and inside the custom save_dir
        self.assertTrue(hasattr(file_manager, "dir_log"), "file_manager.dir_log attribute missing")
        self.assertIsNotNone(file_manager.dir_log)
        # The log directory should be inside the test_dir
        self.assertTrue(
            os.path.commonpath([file_manager.dir_log, self.test_dir]) == self.test_dir,
            f"Log directory {file_manager.dir_log} is not inside save_dir {self.test_dir}",
        )
        # The log directory should exist on filesystem
        self.assertTrue(os.path.exists(file_manager.dir_log), "Log directory does not exist on filesystem")


if __name__ == "__main__":
