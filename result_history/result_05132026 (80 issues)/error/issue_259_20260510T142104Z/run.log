[32mimport os
import shutil
import unittest

import agentscope
from agentscope.file_manager import dir_log


class TestLogPathConfig(unittest.TestCase):
    def setUp(self) -> None:
        # Use a custom directory for saving logs
        self.custom_log_dir = "./.custom_log_dir"
        if os.path.exists(self.custom_log_dir):
            shutil.rmtree(self.custom_log_dir)

    def tearDown(self) -> None:
        if os.path.exists(self.custom_log_dir):
            shutil.rmtree(self.custom_log_dir)

    def test_log_path_respects_save_dir(self):
        # Initialize agentscope with custom save_dir
        agentscope.init(
            project="test",
            name="test_agent",
            save_dir=self.custom_log_dir,
            save_log=True,
        )
        # After init, the log directory should be inside the custom save_dir
        # The file_manager.dir_log should be set accordingly
        self.assertTrue(os.path.exists(self.custom_log_dir))
        # The log directory path should start with the custom_log_dir path
        log_dir_path = str(dir_log)
        self.assertTrue(log_dir_path.startswith(os.path.abspath(self.custom_log_dir)))
        # Also check that the directory actually exists
        self.assertTrue(os.path.isdir(log_dir_path))

        # Create a dummy log file to verify write permissions
        dummy_log_file = os.path.join(log_dir_path, "dummy.log")
        with open(dummy_log_file, "w", encoding="utf-8") as f:
            f.write("test log content")
        self.assertTrue(os.path.isfile(dummy_log_file))


if __name__ == "__main__":
    unittest.main()[0m
