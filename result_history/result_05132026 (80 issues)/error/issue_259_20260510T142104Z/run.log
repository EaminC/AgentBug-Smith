        # file_manager.dir_log should be set and inside the custom save_dir
        self.assertTrue(
            hasattr(file_manager, "dir_log"),
            "file_manager.dir_log attribute missing",
        )
        # The dir_log should be a subdirectory of the test_dir
        dir_log_path = str(file_manager.dir_log)
        self.assertTrue(
            os.path.commonpath([dir_log_path, self.test_dir]) == self.test_dir,
            f"dir_log path {dir_log_path} is not inside save_dir {self.test_dir}",
        )
        # The directory should actually exist on disk
        self.assertTrue(
            os.path.exists(dir_log_path),
            f"dir_log path {dir_log_path} does not exist",
        )


if __name__ == "__main__":
    unittest.main()[0m
