[32mimport unittest
import tempfile
import shutil
import os
from pathlib import Path

import agentscope
from agentscope import file_manager


class TestConversationLogPath(unittest.TestCase):
    def setUp(self) -> None:
        # Create a temporary directory for save_dir
        self.test_dir = tempfile.mkdtemp(prefix="unittest_conversation_log_path_")

    def tearDown(self) -> None:
        # Remove temporary directory after test
        shutil.rmtree(self.test_dir, ignore_errors=True)

    def test_log_path_respects_save_dir(self):
        # Initialize agentscope with a custom save_dir and save_log enabled
        agentscope.init(
            project="test_project",
            name="test_agent",
            save_dir=self.test_dir,
            save_log=True,
        )

        # file_manager.dir_log should be set and inside the custom save_dir
        self.assertTrue(hasattr(file_manager, "dir_log"), "file_manager.dir_log attribute missing")

        dir_log = file_manager.dir_log
        # dir_log should be a Path or str pointing inside the save_dir
        self.assertTrue(isinstance(dir_log, (str, Path)), "file_manager.dir_log is not str or Path")

        # Convert to Path for easier checks
        dir_log_path = Path(dir_log)
        save_dir_path = Path(self.test_dir)

        # dir_log should be inside save_dir (or equal)
        try:
            dir_log_path.relative_to(save_dir_path)
        except ValueError:
            self.fail(f"file_manager.dir_log {dir_log_path} is not inside save_dir {save_dir_path}")

        # The log directory should exist
        self.assertTrue(dir_log_path.exists(), f"Log directory {dir_log_path} does not exist")

        # The log directory should be a directory
        self.assertTrue(dir_log_path.is_dir(), f"Log path {dir_log_path} is not a directory")


if __name__ == "__main__":
