[32mimport unittest
import tempfile
import shutil
import os
from pathlib import Path

import agentscope
from agentscope import file_manager


class TestConversationLogPath(unittest.TestCase):
    def setUp(self):
        # Create a temporary directory for the test save_dir
        self.test_dir = tempfile.mkdtemp(prefix="unittest_conversation_log_path_")

    def tearDown(self):
        # Clean up the temporary directory after test
        shutil.rmtree(self.test_dir, ignore_errors=True)

    def test_log_path_respects_save_dir(self):
        # Initialize agentscope with a custom save_dir and save_log enabled
        agentscope.init(
            project="test_project",
            name="test_agent",
            save_dir=self.test_dir,
            save_log=True,
        )

        # file_manager.dir_log should be set and inside the custom save_dir
        self.assertTrue(hasattr(file_manager, "dir_log"), "file_manager.dir_log attribute missing")

        # dir_log should be a Path or str and should be inside save_dir
        dir_log_path = file_manager.dir_log
        # Convert to Path if it's str
        if isinstance(dir_log_path, str):
            dir_log_path = Path(dir_log_path)

        self.assertTrue(isinstance(dir_log_path, Path), "file_manager.dir_log is not a Path object")

        # dir_log should be inside the save_dir
        save_dir_path = Path(self.test_dir).resolve()
        dir_log_path_resolved = dir_log_path.resolve()
        self.assertTrue(
            str(dir_log_path_resolved).startswith(str(save_dir_path)),
            f"file_manager.dir_log ({dir_log_path_resolved}) is not inside save_dir ({save_dir_path})",
        )

        # The directory should exist
        self.assertTrue(dir_log_path.exists(), "file_manager.dir_log directory does not exist")

        # The directory should be a directory
        self.assertTrue(dir_log_path.is_dir(), "file_manager.dir_log is not a directory")


if __name__ == "__main__":
    unittest.main()[0m
