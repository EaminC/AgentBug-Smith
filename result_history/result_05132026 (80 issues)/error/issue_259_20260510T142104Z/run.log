[32mimport unittest
import tempfile
import shutil
import os

import agentscope
from agentscope import file_manager


class TestConversationLogPath(unittest.TestCase):
    def setUp(self):
        # Create a temporary directory for save_dir
        self.test_dir = tempfile.mkdtemp(prefix="unittest_conversation_log_path_")

    def tearDown(self):
        # Remove the temporary directory after test
        shutil.rmtree(self.test_dir, ignore_errors=True)

    def test_log_path_respects_save_dir(self):
        # Initialize agentscope with a custom save_dir and save_log enabled
        agentscope.init(
            project="test_project",
            name="test_agent",
            save_dir=self.test_dir,
            save_log=True,
        )

        # file_manager.dir_log should be set and inside the custom save_dir
        self.assertTrue(hasattr(file_manager, "dir_log"), "file_manager.dir_log attribute missing")
        self.assertIsNotNone(file_manager.dir_log, "file_manager.dir_log is None")
        dir_log_path = str(file_manager.dir_log)
        self.assertTrue(dir_log_path.startswith(self.test_dir), f"dir_log path {dir_log_path} not inside save_dir {self.test_dir}")

        # The directory should exist on filesystem
        self.assertTrue(os.path.exists(dir_log_path), f"dir_log path {dir_log_path} does not exist")

        # Also check that the log directory is not the default one (which might be './runs' or similar)
        self.assertNotEqual(os.path.abspath(dir_log_path), os.path.abspath("./runs"), "dir_log path is default runs directory, not custom save_dir")

        # Cleanup: forcibly remove the log directory if it exists
        if os.path.exists(dir_log_path):
            shutil.rmtree(dir_log_path, ignore_errors=True)


if __name__ == "__main__":
