[32mimport unittest
import tempfile
import shutil
import os

import agentscope
from agentscope import file_manager


class TestConversationLogPath(unittest.TestCase):
    def setUp(self):
        # Create a temporary directory for save_dir
        self.test_dir = tempfile.mkdtemp(prefix="unittest_conversation_log_path_")

    def tearDown(self):
        # Clean up the temporary directory after test
        shutil.rmtree(self.test_dir, ignore_errors=True)

    def test_log_path_respects_save_dir(self):
        # Initialize agentscope with a custom save_dir and save_log enabled
        agentscope.init(
            project="test_project",
            name="test_agent",
            save_dir=self.test_dir,
            save_log=True,
        )

        # file_manager.dir_log should be set and inside the custom save_dir
        self.assertTrue(hasattr(file_manager, "dir_log"), "file_manager.dir_log attribute missing")
        dir_log = file_manager.dir_log
        self.assertIsNotNone(dir_log)
        # The dir_log path should be inside the test_dir
        abs_dir_log = os.path.abspath(dir_log)
        abs_test_dir = os.path.abspath(self.test_dir)
        self.assertTrue(abs_dir_log.startswith(abs_test_dir), f"dir_log {abs_dir_log} not inside save_dir {abs_test_dir}")

        # Also check that the directory actually exists
        self.assertTrue(os.path.exists(dir_log), f"dir_log path {dir_log} does not exist")


if __name__ == "__main__":
