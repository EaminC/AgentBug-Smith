            save_log=True,
        )

        # file_manager.dir_log should be set and inside the custom save_dir
        self.assertTrue(
            hasattr(file_manager, "dir_log"),
            "file_manager.dir_log attribute missing",
        )
        self.assertIsNotNone(file_manager.dir_log)
        self.assertTrue(
            os.path.commonpath([os.path.abspath(file_manager.dir_log), os.path.abspath(self.test_dir)]) == os.path.abspath(self.test_dir),
            f"dir_log {file_manager.dir_log} is not inside save_dir {self.test_dir}",
        )

        # Also check that the directory actually exists
        self.assertTrue(
            os.path.isdir(file_manager.dir_log),
            f"dir_log path {file_manager.dir_log} does not exist as a directory",
        )


if __name__ == "__main__":
    unittest.main()[0m
