        self.assertIsNotNone(dir_log, "file_manager.dir_log is None")
        self.assertTrue(
            os.path.isabs(dir_log),
            f"file_manager.dir_log is not absolute path: {dir_log}",
        )
        # The log directory should be inside the save_dir
        common_path = os.path.commonpath([self.test_dir, dir_log])
        self.assertEqual(
            common_path,
            os.path.abspath(self.test_dir),
            f"file_manager.dir_log {dir_log} is not inside save_dir {self.test_dir}",
        )
        # The directory should exist
        self.assertTrue(os.path.exists(dir_log), "file_manager.dir_log directory does not exist")


if __name__ == "__main__":
