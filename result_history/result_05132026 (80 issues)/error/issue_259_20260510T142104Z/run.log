        )
        self.assertIsNotNone(file_manager.dir_log)
        # The dir_log path should be inside the test_dir
        self.assertTrue(
            os.path.commonpath([os.path.abspath(file_manager.dir_log), os.path.abspath(self.test_dir)]) == os.path.abspath(self.test_dir),
            f"file_manager.dir_log {file_manager.dir_log} is not inside save_dir {self.test_dir}",
        )
        # The directory should actually exist
        self.assertTrue(os.path.isdir(file_manager.dir_log))


if __name__ == "__main__":
