# Base image for build and test stage (Node 20 LTS slim)
FROM node:20-slim AS test_builder

# Set working directory
WORKDIR /app

# Copy entire repository (including injected test scripts)
COPY . .

# Install dependencies and build project using pnpm (preferred by repo metadata)
RUN if [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm && \
      pnpm install && \
      pnpm build; \
    elif [ -f "package-lock.json" ]; then \
      npm ci && npm run build; \
    else \
      npm install && npm run build; \
    fi

# Install all dependencies including devDependencies and test tools
# Vitest is used as the test runner as per package.json and vitest.config.ts
RUN if [ -f "pnpm-lock.yaml" ]; then \
      pnpm install; \
    elif [ -f "package-lock.json" ]; then \
      npm ci; \
    else \
      npm install; \
    fi

# Run tests (using vitest as per package.json scripts)
RUN npx vitest run

# Preflight check to verify Node version and pnpm installed
RUN node --version && if command -v pnpm > /dev/null; then pnpm --version; else echo "pnpm not installed"; fi

# Final minimal runtime image containing only production dependencies
FROM node:20-alpine AS runtime

WORKDIR /app

# Copy only production dependencies and build artifacts from test_builder
COPY --from=test_builder /app .

# Install only production dependencies (if pnpm-lock.yaml exist, use pnpm install --prod)
RUN if [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm && \
      pnpm install --prod; \
    elif [ -f "package-lock.json" ]; then \
      npm ci --production; \
    else \
      npm install --production; \
    fi

# Set required environment variables for Forge
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Infer command from package.json: default to 'npm run dev' if 'dev' script exists, else fallback to bash
RUN if node -e "process.exit(process.env.npm_package_scripts_dev ? 0 : 1)"; then \
      echo 'CMD ["npm", "run", "dev"]' > /cmd.sh; \
    else \
      echo 'CMD ["/bin/bash"]' > /cmd.sh; \
    fi

CMD ["/bin/bash"][0m
