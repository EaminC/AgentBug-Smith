ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Environment variables for Forge API compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV FORGE_API_KEY="forge-key"

WORKDIR /app

# Install system dependencies for Python builds and common packages needed by the repo
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    gcc \
    curl \
    git \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repo
COPY . .

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies from requirements.txt if it exists
# Also install required test dependencies and additional missing packages discovered from errors: orjson, pandas, pydantic_settings, langfuse, haystack, sqlglot
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt; \
    fi && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm orjson pandas pydantic_settings langfuse haystack sqlglot

# Install the repository itself for local imports
RUN pip install -e .

# Preflight check to confirm pytest and other packages import correctly
RUN python -c 'import pytest, orjson, pandas, pydantic_settings, langfuse, haystack, sqlglot; print("preflight ok")'

# Default command to keep container open with bash shell (required for test harness)
CMD ["/bin/bash"]

# branch: python/requirements.txt with added missing packages and editable install
