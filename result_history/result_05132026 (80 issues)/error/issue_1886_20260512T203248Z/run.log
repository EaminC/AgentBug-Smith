# Install system dependencies needed for building some Python packages and running tests
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    gcc \
    curl \
    git \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repo into container
COPY . .

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies: if requirements.txt exists, install from it; always install project in editable mode and test deps
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt; \
    fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm orjson pandas sqlglot haystack pydantic_settings langfuse locust hamilton aioresponses

# Set PYTHONPATH for src/ style layout
ENV PYTHONPATH=/app/src

# Preflight check to ensure important imports succeed
RUN python -c 'import pkg_resources, pytest, orjson, pandas, sqlglot, haystack, pydantic_settings, langfuse, locust, hamilton, aioresponses; print("preflight ok")'

# Set default command to bash (required for test harness)
CMD ["/bin/bash"]

