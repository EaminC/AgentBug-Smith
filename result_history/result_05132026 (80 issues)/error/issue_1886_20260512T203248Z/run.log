[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set working directory
WORKDIR /app

# Set Forge API environment variables for OpenAI and Anthropic compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Install system dependencies required for Python build and runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    gcc \
    curl \
    git \
    libxml2-dev \
    libxslt1-dev \
  && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Upgrade pip and essential packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Install python dependencies if requirements.txt exists
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt; \
    fi

# Install required test tools and litellm regardless
RUN pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm

# Preflight import test to verify key packages import without error
RUN python -c 'import pkg_resources, pytest, orjson, pandas, sqlglot, haystack, pydantic_settings, langfuse, hamilton, aioresponses; print("preflight ok")'

# Command to keep container running in bash shell
CMD ["/bin/bash"]

# branch: python/requirements.txt
# Installed system dependencies and Python deps
# Set Forge API env variables for OpenAI and Anthropic
# Fully copied repo
# Preflight import test included
# WORKDIR /app
