[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Detect src/ layout or import src. in tests for import handling
RUN set -eux; \
    if [ -d "wren-ai-service/src" ] || grep -Rq "^\s*from src\.|^\s*import src\." wren-ai-service/tests 2>/dev/null; then \
        echo "Detected src/ layout or src imports in tests"; \
        export PYTHONPATH=/app/wren-ai-service; \
        python -m pip install --upgrade pip setuptools wheel; \
        pip install -r wren-ai-service/requirements.txt 2>/dev/null || true; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    else \
        echo "No src/ layout or src imports detected"; \
        python -m pip install --upgrade pip setuptools wheel; \
        pip install -r wren-ai-service/requirements.txt 2>/dev/null || true; \
        pip install -e ./wren-ai-service; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# Set PYTHONPATH if src layout detected to avoid editable install
ENV PYTHONPATH=/app/wren-ai-service

# Preflight import check to fail fast if core modules missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests via Makefile or just test script if exists, else fallback to pytest directly
RUN set -eux; \
    cd wren-ai-service; \
    if command -v just >/dev/null 2>&1 && just --list | grep -q '^test$'; then \
        just test; \
    elif [ -f Makefile ] && grep -q '^test:' Makefile; then \
        make test; \
    elif [ -f tests/test_main.py ] || [ -d tests ]; then \
        pytest tests; \
    else \
        echo "No standard test target or tests found"; \
    fi

FROM python:3.12-slim AS runtime

WORKDIR /app

COPY --from=test_builder /app/wren-ai-service /app

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt 2>/dev/null || true && \
    pip install -e . && \
    # Remove test dependencies to minimize image size
    pip uninstall -y pytest pytest-mock pytest-asyncio pytest-cov anyio litellm pytest-xdist pytest-timeout || true

# Explicit assumption: main service entrypoint inferred as 'wren-ai-service/main.py' since no other CMD found in configs
CMD ["/bin/bash"][0m
