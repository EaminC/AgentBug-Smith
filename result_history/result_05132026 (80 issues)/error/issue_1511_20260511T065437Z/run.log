# --- end inject ---

# Set environment variables for Forge API (OpenAI-compatible)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Set environment variables for Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Also inject other environment variables from root .env file for completeness
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV MODEL=tensorblock/gpt-4.1-mini
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0
ENV AI_STOP_SEQUENCES=""
ENV GITHUB_TOKEN=ghp_key
ENV TAVILY_API_KEY=tvly-key
ENV ANTHROPIC_MODEL=tensorblock/gpt-4.1-mini
ENV ANTHROPIC_SMALL_FAST_MODEL=tensorblock/gpt-4.1-mini

WORKDIR /app

COPY . .

# Detect src/ layout or tests importing src to set PYTHONPATH appropriately for import resolution
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." src 2>/dev/null; then \
        echo "Detected src/ layout" > .src_layout_detected; \
    else \
        echo "No src/ layout detected" > .src_layout_detected; \
    fi

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install project dependencies and the project itself in editable mode plus test dependencies
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# Set or unset PYTHONPATH based on src/ layout detection
ENV PYTHONPATH=/app
RUN if grep -q "No src/ layout detected" .src_layout_detected; then \
      unset PYTHONPATH; \
    fi

# Run simple preflight check to verify installation
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Final command to open bash shell for test harness
CMD ["/bin/bash"]

