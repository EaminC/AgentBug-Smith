[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set working directory
WORKDIR /app

# Copy entire repository for installation and testing
COPY . .

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

# Install system dependencies needed for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc python3-dev libffi-dev libssl-dev && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, and wheel to latest stable
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python packages depending on repo config
# This handles requirements.txt or poetry lockfile setup gracefully
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt && pip install -e .; \
    elif [ -f "poetry.lock" ] && [ -f "pyproject.toml" ]; then \
      pip install poetry && \
      poetry config virtualenvs.create false && \
      poetry install --no-root && \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    elif [ -f "pyproject.toml" ]; then \
      pip install -e . && pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    else \
      echo "No recognized Python package config found."; \
    fi

# Explicitly install testing dependencies if requirements.txt used
RUN if [ -f "requirements.txt" ]; then \
      pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    fi

# For src layout, set PYTHONPATH to allow standalone script imports
ENV PYTHONPATH=/app/src

# Preflight test to verify installed packages
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Final command: launch bash shell (required by the test harness)
CMD ["/bin/bash"]

# branch: python project with requirements.txt or poetry, Forge API env vars, editable install, test deps, prepared for standalone scripts
