    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

# Copy entire repository
COPY . .

# Upgrade pip, setuptools and wheel
RUN pip install --upgrade pip setuptools wheel

# Install dependencies and the package
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt && pip install -e .; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
      pip install poetry && poetry config virtualenvs.create false && poetry install --no-interaction --no-ansi && pip install -e .; \
    elif [ -f "pyproject.toml" ]; then \
      pip install -e .; \
    else \
      echo "No recognized Python dependency files found."; \
    fi

# Install test dependencies unconditionally
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# If src/ directory exists, set PYTHONPATH for imports
RUN if [ -d "src" ]; then \
      echo "export PYTHONPATH=/app/src" >> /etc/profile.d/pythonpath.sh; \
    fi

# Preflight: confirm pytest and package are importable
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

