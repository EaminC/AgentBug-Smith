[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set environment variables for Forge API (OpenAI and Anthropic compatible)
ENV FORGE_API_KEY=forge-key
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

COPY . .

# Upgrade pip, setuptools and wheel
RUN pip install --upgrade pip setuptools wheel

# Install dependencies using poetry only if poetry.lock and pyproject.toml exist
RUN if [ -f "poetry.lock" ] && [ -f "pyproject.toml" ]; then \
      pip install poetry && \
      poetry config virtualenvs.create false && \
      poetry install --no-interaction --no-ansi --no-root; \
    fi

# Install the package and test dependencies
RUN pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# Detect src/ layout and set PYTHONPATH if needed
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." src 2>/dev/null; then \
      echo "Detected src/ layout" > /app/.src_layout_detected && \
      echo "export PYTHONPATH=/app/src" >> /etc/profile.d/pythonpath.sh; \
    else \
      echo "No src/ layout detected" > /app/.src_layout_detected; \
    fi

# Preflight check: import important packages
