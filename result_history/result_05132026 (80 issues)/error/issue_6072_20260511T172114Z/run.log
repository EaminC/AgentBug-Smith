WORKDIR /app

COPY . .

# Install system dependencies for Python build, common libraries, and deps for missing imports
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc python3-dev libpq-dev libsqlite3-dev libxml2-dev libxslt1-dev curl \
    libglib2.0-0 libgtk-3-0 libgdk-pixbuf2.0-0 libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies - requirements.txt if exists
