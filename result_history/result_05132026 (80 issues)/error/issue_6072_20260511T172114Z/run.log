RUN pip install \
    pytest pytest-mock pytest-asyncio pytest-cov anyio setuptools<=81.0.0 litellm \
    mkdocs syrupy httpx pytest-dotenv pytest-watcher pytest-xdist[psutil] pytest-repeat mypy ruff jupyter

# Add libs directory to PYTHONPATH to resolve import issues seen in tests
ENV PYTHONPATH=/app/libs:$PYTHONPATH

# Preflight checks to ensure imports and environment are configured correctly
RUN python -c 'import pkg_resources, pytest, mkdocs, langgraph, langgraph.checkpoint; print("preflight ok")'

# Default to bash shell
CMD ["/bin/bash"]

