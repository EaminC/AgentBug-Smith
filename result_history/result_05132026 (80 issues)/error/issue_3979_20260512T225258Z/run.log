FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set Forge API environment variables for OpenAI and Anthropic SDK compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY="forge-key" \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN="forge-key"

WORKDIR /app

# Install system dependencies needed for building Python packages including colorama
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc git libffi-dev libssl-dev libyaml-dev python3-dev python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository into container
COPY . .

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Detect src/ layout usage to decide PYTHONPATH and install approach
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        echo true > /tmp/src_layout_flag; \
    else \
        echo false > /tmp/src_layout_flag; \
    fi

# Install dependencies with retry logic and install project editable if no src/ layout
RUN set -eux; \
    SRC_LAYOUT=$(cat /tmp/src_layout_flag); \
    if [ -f "requirements.txt" ]; then \
        apt-get update && apt-get install -y libyaml-dev && rm -rf /var/lib/apt/lists/*; \
        for i in 1 2 3; do \
          pip install --no-cache-dir -r requirements.txt && break || sleep 5; \
        done; \
        if [ "$SRC_LAYOUT" = false ]; then \
            pip install --no-cache-dir -e . || echo "Editable install failed, proceeding without it."; \
        fi; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry; \
        poetry config virtualenvs.create false; \
        poetry install --no-interaction --no-ansi; \
        if [ "$SRC_LAYOUT" = false ]; then \
            pip install --no-cache-dir -e . || echo "Editable install failed, proceeding without it."; \
        fi; \
    elif [ -f "pyproject.toml" ]; then \
        if [ "$SRC_LAYOUT" = false ]; then \
            pip install --no-cache-dir -e . || echo "Editable install failed, proceeding without it."; \
        fi; \
    else \
        echo "No recognized Python dependency files."; \
    fi

# Install standard Python test dependencies explicitly, plus colorama to fix ImportError
RUN pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio litellm pytest-xdist pytest-timeout colorama

# If src layout is detected, set PYTHONPATH environment variable
RUN set -eux; \
    SRC_LAYOUT=$(cat /tmp/src_layout_flag); \
    if [ "$SRC_LAYOUT" = true ]; then \
        echo "export PYTHONPATH=/app" > /etc/profile.d/pythonpath.sh; \
    fi

# Test that installations succeed without import errors
RUN python -c 'import pkg_resources, pytest, yaml, colorama; print("preflight ok")'

# Entrypoint: bash shell for test harness compatibility
CMD ["/bin/bash"]

# branch: python/requirements.txt
