FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# --- Inject environment variables for Forge API ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"

# Set Forge-compatible environment variables for OpenAI and Anthropic SDKs
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY="forge-key" \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN="forge-key"

# Install system dependencies including libyaml-dev for PyYAML build compatibility
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    git \
    libffi-dev \
    libssl-dev \
    libyaml-dev \
    python3-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app

# Copy the entire repository
COPY . .

# Detect if a src/ layout is used
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        echo "true" > /tmp/src_layout_flag; \
    else \
        echo "false" > /tmp/src_layout_flag; \
    fi

# Upgrade pip and setuptools
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies and project in editable mode if no src layout
RUN set -eux; \
    SRC_LAYOUT=$(cat /tmp/src_layout_flag); \
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
        if [ "$SRC_LAYOUT" = "false" ]; then \
            pip install -e .; \
        fi; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry; \
        poetry config virtualenvs.create false; \
        poetry install --no-interaction --no-ansi; \
        if [ "$SRC_LAYOUT" = "false" ]; then \
            pip install -e .; \
        fi; \
    elif [ -f "pyproject.toml" ]; then \
        if [ "$SRC_LAYOUT" = "false" ]; then \
            pip install -e .; \
        fi; \
    fi

# Install testing tools separately
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio litellm pytest-xdist pytest-timeout

# Set PYTHONPATH if src/ layout is detected
RUN set -eux; \
    SRC_LAYOUT=$(cat /tmp/src_layout_flag); \
    if [ "$SRC_LAYOUT" = "true" ]; then \
        echo "export PYTHONPATH=/app" >> /etc/profile.d/pythonpath.sh; \
        export PYTHONPATH=/app; \
    fi

# Run preflight to verify installation
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default to bash shell
CMD ["/bin/bash"]
