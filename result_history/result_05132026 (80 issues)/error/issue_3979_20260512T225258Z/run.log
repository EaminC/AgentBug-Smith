FROM python:3.10-slim AS test_builder

# Set working directory
WORKDIR /app

# Set environment variables for Python
ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Copy entire repository into container
COPY . .

# Detect src/ layout or import src. usage in tests
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        SRC_LAYOUT=true; \
    else \
        SRC_LAYOUT=false; \
    fi; \
    echo "SRC_LAYOUT=$SRC_LAYOUT" > /tmp/src_layout_flag

# Install build tools and dependencies based on detected files and src layout
RUN set -eux; \
    . /tmp/src_layout_flag; \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
        if [ "$SRC_LAYOUT" = "false" ]; then \
            pip install -e .; \
        fi; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry; \
        poetry config virtualenvs.create false; \
        poetry install --no-interaction --no-ansi; \
        if [ "$SRC_LAYOUT" = "false" ]; then \
            pip install -e .; \
        fi; \
    elif [ -f "pyproject.toml" ]; then \
        if [ "$SRC_LAYOUT" = "false" ]; then \
            pip install -e .; \
        fi; \
    fi; \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout

# If src layout, set PYTHONPATH to avoid editable install
RUN set -eux; \
    . /tmp/src_layout_flag; \
    if [ "$SRC_LAYOUT" = "true" ]; then \
        echo "export PYTHONPATH=/app" >> /etc/profile.d/pythonpath.sh; \
        export PYTHONPATH=/app; \
    fi

# Run preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests to verify build
RUN pytest -n auto --cov=agpt --cov-branch --cov-report term-missing --cov-report xml tests/unit tests/integration tests/challenges

# Final minimal runtime image
FROM python:3.10-slim AS runtime

WORKDIR /app

ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=${FORGE_API_KEY} \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

COPY . .

# Install only production dependencies
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt && \
    pip install agpt && \
    rm -rf /root/.cache/pip

CMD ["/bin/bash"][0m
