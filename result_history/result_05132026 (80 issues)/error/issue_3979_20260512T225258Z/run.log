FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key" \
    FORGE_BASE_URL="https://api.forge.tensorblock.co/v1" \
    MODEL="tensorblock/gpt-4.1-mini" \
    AI_TEMPERATURE="0.7" \
    GITHUB_TOKEN="ghp_key" \
    TAVILY_API_KEY="tvly-key" \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN="forge-key" \
    # Overriding OPENAI_BASE_URL with Forge's compatible endpoint
    OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY="forge-key"

# Set Forge-compatible environment variables for Anthropic SDK compatibility explicitly
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN="forge-key"

WORKDIR /app

# Install system dependencies needed for building Python packages and for libyaml build fixes
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc git libffi-dev libssl-dev libyaml-dev python3-dev python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repo (DO NOT fail build silently if files missing)
COPY . .

# Upgrade pip and wheel, constrain setuptools for PyYAML compatibility
RUN python -m pip install --upgrade pip wheel
RUN python -m pip install "setuptools<=81.0.0"

# Detect if src layout is used (used to decide PYTHONPATH handling and editable install)
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        echo "true" > /tmp/src_layout_flag; \
    else \
        echo "false" > /tmp/src_layout_flag; \
    fi

# Install dependencies and project with retry logic for intermittent network issues
RUN set -eux; \
    SRC_LAYOUT=$(cat /tmp/src_layout_flag); \
    if [ -f "requirements.txt" ]; then \
        apt-get update && apt-get install -y libyaml-dev && rm -rf /var/lib/apt/lists/*; \
        # Retry pip install for robustness (3 attempts)
        for i in 1 2 3; do \
          pip install --no-cache-dir -r requirements.txt && break || sleep 5; \
        done; \
        if [ "$SRC_LAYOUT" = "false" ]; then \
            pip install --no-cache-dir -e .; \
        fi; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry; \
        poetry config virtualenvs.create false; \
        poetry install --no-interaction --no-ansi; \
        if [ "$SRC_LAYOUT" = "false" ]; then \
            pip install --no-cache-dir -e .; \
        fi; \
    elif [ -f "pyproject.toml" ]; then \
        if [ "$SRC_LAYOUT" = "false" ]; then \
            pip install --no-cache-dir -e .; \
        fi; \
    else \
        echo "No recognized Python dependency files."; \
    fi

# Install explicit standard Python test dependencies that might not be in requirements
RUN pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov anyio litellm pytest-xdist pytest-timeout

# For src layout, set PYTHONPATH environment variable
RUN set -eux; \
    SRC_LAYOUT=$(cat /tmp/src_layout_flag); \
    if [ "$SRC_LAYOUT" = "true" ]; then \
        echo "export PYTHONPATH=/app" > /etc/profile.d/pythonpath.sh; \
    fi

# Run a minimal python command to validate install (preflight)
RUN python -c 'import pkg_resources, pytest, yaml; print("preflight ok")'

# Docker entrypoint MUST be bash shell for tests to run correctly
CMD ["/bin/bash"]

# branch: python/requirements.txt
