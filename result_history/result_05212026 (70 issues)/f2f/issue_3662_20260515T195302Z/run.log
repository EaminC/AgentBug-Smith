[32m# Stage 1: Build and Test
FROM node:20-alpine AS test_builder

WORKDIR /app

# Install pnpm globally; retry if necessary
RUN apk add --no-cache curl bash && \
    for i in 1 2 3; do \
        npm install -g pnpm@10.15.0 && break || \
        if [ $i -eq 3 ]; then \
          echo "Failed to install pnpm"; exit 1; \
        fi; \
        sleep $((10 * i)); \
    done

# Copy entire repo
COPY . .

# Install dependencies with pnpm in the python client directory (clients/python is JS project root as per instructions)
RUN if [ -f "clients/python/package.json" ] && [ -f "clients/python/pnpm-lock.yaml" ]; then \
      cd clients/python && pnpm install --frozen-lockfile; \
    else \
      echo "No pnpm lockfile or package.json in clients/python, skipping pnpm install"; \
    fi

# Run tests in clients/python directory
RUN if [ -f "clients/python/package.json" ]; then \
      cd clients/python && pnpm run test; \
    else \
      echo "No package.json in clients/python, skipping tests"; \
    fi

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Stage 2: Production Runtime
FROM node:20-alpine AS runtime

WORKDIR /app

# Copy only necessary files for production installation from clients/python
COPY clients/python/package.json clients/python/pnpm-lock.yaml ./clients/python/
COPY clients/python/ ./

# Install production dependencies only
RUN if [ -f "clients/python/package.json" ] && [ -f "clients/python/pnpm-lock.yaml" ]; then \
      cd clients/python && pnpm install --prod --frozen-lockfile; \
    else \
      echo "No pnpm lockfile or package.json in clients/python, skipping production install"; \
    fi

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Set working directory to clients/python as main app location for CMD
WORKDIR /app/clients/python

# Final command as per instructions
CMD ["/bin/bash"][0m
