[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly_key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

# Copy entire repository into container
COPY . .

# Upgrade pip and install setuptools with pkg_resources support
RUN python -m pip install --upgrade pip setuptools wheel setuptools_scm

# Install system dependencies required for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libffi-dev libssl-dev python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Explicitly install setuptools again to ensure pkg_resources is available
RUN pip install setuptools

# Install faiss-cpu and numpy explicitly to avoid conflicts
RUN pip install faiss-cpu==1.13.2 numpy

# Install Python dependencies from requirements.txt excluding faiss-cpu and numpy to avoid conflicts
RUN if [ -f "requirements.txt" ]; then \
    grep -vE '^faiss_cpu==' requirements.txt | \
    grep -vE 'llama-index-vector-stores-faiss' | \
    grep -vE '^numpy==' > filtered_requirements.txt && \
    pip install -r filtered_requirements.txt; \
    fi

# Install the repository and standard Python test dependencies
RUN pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm

# Preflight sanity check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

