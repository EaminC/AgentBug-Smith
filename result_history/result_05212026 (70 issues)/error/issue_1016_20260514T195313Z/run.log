    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

COPY . .

# Upgrade pip, setuptools, wheel, and install system dependencies
RUN python -m pip install --upgrade pip setuptools wheel pkg_resources && \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libffi-dev libssl-dev python3-dev pkg-config && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies and project package, plus testing dependencies
RUN if [ -f "requirements.txt" ]; then \
    pip install --use-pep517 -r requirements.txt ; \
    fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm

# Preflight check that pip installs succeeded
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

