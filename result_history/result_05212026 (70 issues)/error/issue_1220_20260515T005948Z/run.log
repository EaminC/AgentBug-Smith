[32mFROM python:3.9-slim

# Set work directory
WORKDIR /app

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=${FORGE_API_KEY} \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Copy entire repository
COPY . .

# Detect src/ layout or import src. in tests to decide installation method
RUN set -eux; \
    # Upgrade pip, setuptools, wheel early to avoid import-time errors \
    python -m pip install --upgrade pip setuptools wheel; \
    if [ -f "requirements.txt" ]; then \
        if [ -d "src" ] || grep -RqE "^\s*(from|import) src\." tests 2>/dev/null; then \
            pip install -r requirements.txt 2>/dev/null || true; \
            pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
        else \
            pip install -r requirements.txt 2>/dev/null || true; \
            pip install -e .; \
            pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
        fi; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry; \
        poetry config virtualenvs.create false; \
        poetry install --no-interaction --no-ansi; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    elif [ -f "pyproject.toml" ]; then \
        if [ -d "src" ] || grep -RqE "^\s*(from|import) src\." tests 2>/dev/null; then \
            pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
        else \
            pip install -e .; \
            pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
        fi; \
    else \
        # Assumption: no recognized package manager files, install test deps only \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# Preflight import check to fail fast if core modules are missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# If src/ layout or src. imports detected, set PYTHONPATH to /app to avoid module identity conflicts
RUN if [ -d "src" ] || grep -RqE "^\s*(from|import) src\." tests 2>/dev/null; then echo 'export PYTHONPATH=/app' >> /etc/profile.d/pythonpath.sh; fi
ENV PYTHONPATH=/app

