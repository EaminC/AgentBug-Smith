# Set working directory inside container
WORKDIR /app

# Copy entire repository to container
COPY . .

# Install pnpm globally if pnpm-lock.yaml exists, else fallback to npm install
RUN if [ -f pnpm-lock.yaml ]; then \
      npm install -g pnpm && \
      pnpm install && \
      if grep -q '"build"' package.json; then \
        pnpm run build; \
      fi; \
    else \
      npm install && \
      if grep -q '"build"' package.json; then \
        npm run build; \
      fi; \
    fi

# Install standard test tooling for JavaScript (jest, mocha)
RUN npm install --no-save jest mocha || true

# Verify that node and jest are available (preflight)
RUN node -e "require('jest'); console.log('preflight ok')" || true

# Default command to keep container running with bash shell (required by test harness)
CMD ["/bin/bash"]

