# otherwise fallback to npm install
RUN npm install -g pnpm && \
    if [ -f "pnpm-lock.yaml" ]; then \
      pnpm install; \
    elif [ -f "package-lock.json" ]; then \
      npm ci; \
    elif [ -f "yarn.lock" ]; then \
      npm install -g yarn && yarn install; \
    else \
      npm install; \
    fi

