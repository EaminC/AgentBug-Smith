ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set working directory
WORKDIR /app

# Copy the entire repository
COPY . .

# Conditionally install pnpm globally if pnpm-lock.yaml exists
RUN if [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm; \
    fi

# Install dependencies with pnpm if pnpm-lock.yaml exists, else npm ci if package-lock.json exists, else npm install
RUN if [ -f "pnpm-lock.yaml" ]; then \
      pnpm install; \
    elif [ -f "package-lock.json" ]; then \
      npm ci; \
    else \
      npm install; \
    fi

# Run build script if present
RUN if grep -q '"build"' package.json 2>/dev/null; then npm run build || true; else echo "No build script found, skipping build"; fi

# Ensure standard JS test frameworks are installed
RUN npm list jest >/dev/null 2>&1 || npm install --no-save jest mocha || true

# Preflight check
RUN node -e "console.log('preflight ok')"

# Entrypoint: bash shell
CMD ["/bin/bash"]

