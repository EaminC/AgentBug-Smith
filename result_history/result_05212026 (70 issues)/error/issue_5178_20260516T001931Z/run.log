[32mFROM node:24-alpine AS test_builder

WORKDIR /app

# Copy entire repository including clients/python as indicated
COPY . .

# Install pnpm if not present and install dependencies with dev
RUN if ! command -v pnpm >/dev/null 2>&1; then \
      npm install -g pnpm@latest; \
    fi && \
    if [ -f "pnpm-lock.yaml" ]; then \
      pnpm install --frozen-lockfile; \
    else \
      echo "No pnpm-lock.yaml found, skipping pnpm install"; \
    fi

# Build the project if build script exists
RUN if grep -q '"build"' package.json 2>/dev/null; then \
      pnpm run build; \
    else \
      echo "No build script found, skipping build"; \
    fi

# Run tests using pnpm
RUN if grep -q '"test"' package.json 2>/dev/null; then \
      pnpm run test; \
    else \
      echo "No test script found, skipping tests"; \
    fi

# Set environment variables required by forge
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Preflight check for node environment
RUN node -e "console.log('preflight ok')"

# Final minimal runtime image
FROM node:24-alpine AS runtime

WORKDIR /app

# Copy only production files (assuming package.json and pnpm-lock.yaml)
COPY package.json pnpm-lock.yaml ./

# Install only production dependencies
RUN if [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm@latest && pnpm install --frozen-lockfile --prod; \
    else \
      npm install --production; \
    fi

# Copy rest of the application code
COPY . .

# Set environment variables required by forge in runtime
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# CMD inferred from package.json scripts - fallback to /bin/bash if no start script
# Check if package.json defines "start" script
RUN if grep -q '"start"' package.json 2>/dev/null; then \
      echo '["pnpm","start"]' > /cmd.json; \
    else \
      echo '["/bin/bash"]' > /cmd.json; \
    fi

CMD ["sh","-c","cat /cmd.json | jq -r '. | @sh' | xargs -I {} sh -c {}"][0m
