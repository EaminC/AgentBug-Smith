RUN if [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm; \
    fi

# Install dependencies using pnpm if pnpm-lock.yaml exists
RUN if [ -f "pnpm-lock.yaml" ]; then \
      pnpm install; \
    else \
      npm install; \
    fi

# Run build script if defined
RUN if grep -q '"build"' package.json 2>/dev/null; then \
      npm run build || true; \
    else \
      echo "No build script found, skipping build"; \
    fi

# Ensure standard JS test frameworks (jest and mocha) are installed
RUN npm list jest >/dev/null 2>&1 || npm install --no-save jest mocha || true

# Preflight check to confirm node and jest availability
RUN node -e "require('jest'); console.log('preflight ok')" || true

# Entrypoint to bash shell
CMD ["/bin/bash"]

