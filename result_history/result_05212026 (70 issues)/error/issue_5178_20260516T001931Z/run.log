# Copy entire repository to container
COPY . .

# Install dependencies using pnpm if pnpm-lock.yaml exists, else npm
RUN if [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm && \
      pnpm install && \
      if grep -q '"build"' package.json 2>/dev/null; then npm run build; fi; \
    else \
      npm install && \
      if grep -q '"build"' package.json 2>/dev/null; then npm run build; fi; \
    fi

# Ensure jest and mocha test frameworks are installed to run tests
RUN npm list jest >/dev/null 2>&1 || npm install --no-save jest mocha || true

# Verify node and jest are available (preflight)
RUN node -e "require('jest'); console.log('preflight ok')" || true

# Default command to keep container running with bash shell (required by test harness)
CMD ["/bin/bash"]

