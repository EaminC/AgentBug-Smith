# Install dependencies based on package manager lock file presence
RUN if [ -f "package-lock.json" ]; then \
      npm ci; \
    elif [ -f "yarn.lock" ]; then \
      npm install -g yarn && yarn install; \
    else \
      npm install; \
    fi

# Install standard JavaScript testing dependencies
RUN npm install --no-save jest mocha || true

# Preflight checks to verify installation
RUN node -v && npm -v

CMD ["/bin/bash"]
