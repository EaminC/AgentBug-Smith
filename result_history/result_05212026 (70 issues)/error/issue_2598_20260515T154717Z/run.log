ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly_key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"

WORKDIR /app

# Copy all source code to /app
COPY . .

# Install Python Poetry for dependencies
RUN python3 -m pip install --upgrade pip setuptools wheel && \
    pip install poetry

# Install Python dependencies via poetry, install package, and test deps
RUN poetry config virtualenvs.create false && \
    poetry install --no-interaction --no-ansi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# Install Node.js dependencies in src/frontend
RUN if [ -f "src/frontend/package-lock.json" ]; then \
        cd src/frontend && npm ci; \
    elif [ -f "src/frontend/package.json" ]; then \
        cd src/frontend && npm install; \
    fi

# Install Node.js dependencies in scripts/aws
RUN if [ -f "scripts/aws/package-lock.json" ]; then \
        cd scripts/aws && npm ci; \
    elif [ -f "scripts/aws/package.json" ]; then \
        cd scripts/aws && npm install; \
    fi

# Install common JS test frameworks
RUN npm install --no-save jest mocha || true

# Final CMD (required)
CMD ["/bin/bash"]

