ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Also include the FORGE_API_KEY and FORGE_BASE_URL for compatibility
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Set working directory
WORKDIR /app

# Copy entire repo into container
COPY . .

# Install dependencies based on package-lock.json, yarn.lock, or pnpm-lock.yaml
RUN if [ -f "package.json" ]; then \
      if [ -f "package-lock.json" ]; then \
        npm ci; \
      elif [ -f "yarn.lock" ]; then \
        npm install -g yarn && yarn install; \
      elif [ -f "pnpm-lock.yaml" ]; then \
        npm install -g pnpm && pnpm install; \
      else \
        npm install; \
      fi \
    else \
      echo "package.json not found, skipping install"; \
    fi

# Install test tools locally without saving them to package.json, ignore errors
RUN npm install --no-save jest mocha || true

# Default command to start bash shell
CMD ["/bin/bash"]
