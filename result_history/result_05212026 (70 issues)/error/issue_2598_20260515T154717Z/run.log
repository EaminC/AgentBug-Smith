[32mFROM node:21-alpine AS test_builder

WORKDIR /app

# Copy entire repository for external test injection preservation
COPY . .

# Install all dependencies including devDependencies using npm ci if package-lock.json exists
RUN if [ -f "package-lock.json" ]; then \
      npm ci; \
    elif [ -f "yarn.lock" ]; then \
      npm install -g yarn && yarn install; \
    else \
      npm install; \
    fi

# Preflight check: verify Node.js and npm installation
RUN node -v && npm -v

# Run the standard test suite using npm test if available, fallback to npx jest if jest is installed
RUN if npm run | grep -q "test"; then \
      npm test; \
    elif npx -q jest --version >/dev/null 2>&1; then \
      npx jest; \
    else \
      echo "No test script found, skipping tests"; \
    fi

# Build stage: build the project if build script exists
RUN if npm run | grep -q "build"; then npm run build; else echo "No build script found"; fi


FROM node:21-alpine AS runtime

WORKDIR /app

COPY package*.json ./

# Install only production dependencies
RUN if [ -f "package-lock.json" ]; then \
      npm ci --only=production; \
    elif [ -f "yarn.lock" ]; then \
      npm install -g yarn && yarn install --production; \
    else \
      npm install --production; \
    fi

COPY . .

# Set Forge environment variables as required
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Expose port if specified in npm scripts or default to 3000 (common for frontend dev)
# Assumption: default port 3000 as no explicit port found in metadata
EXPOSE 3000

# Infer CMD from package.json "start" script if available, else fallback to bash
CMD ["npm", "start"][0m
