    OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1

WORKDIR /app

# Install system dependencies needed for build and Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libffi-dev \
    libssl-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository into container at /app
COPY . .

# Upgrade pip, setuptools, wheel, and install dependencies
# Install test dependencies and project itself in editable mode with all
