[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Install core build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# Detect src/ layout or src. imports in tests to avoid editable install if present
RUN set -eux; \
    if [ -d "src" ] || grep -RqE '^\s*(from|import) src(\.|$)' tests 2>/dev/null; then \
        echo "Detected src/ layout or src. imports; setting PYTHONPATH and installing deps without editable install"; \
        python -m pip install --upgrade pip setuptools wheel; \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
        export PYTHONPATH=/app; \
    else \
        echo "No src/ layout detected; installing with editable install"; \
        python -m pip install --upgrade pip setuptools wheel; \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# Preflight import check to fail fast if core modules missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Run the standard test runner to verify project integrity
RUN python -m pytest -v

