WORKDIR /app

# Install system packages needed for building Python packages and running Python
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libffi-dev libssl-dev libxml2-dev libxslt1-dev python3-dev curl && rm -rf /var/lib/apt/lists/*

# Copy the entire repository into container
COPY . .

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies and the package itself, plus required test dependencies, including cryptography for tests
RUN \
  if [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt && pip install -e . && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai pyjwt chromadb json_repair appdirs cryptography; \
  elif [ -f "pyproject.toml" ]; then \
    if [ -f "poetry.lock" ]; then \
      pip install poetry && \
      poetry config virtualenvs.create false && \
      poetry install --no-interaction --no-ansi && \
      pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai pyjwt chromadb json_repair appdirs cryptography; \
    else \
      pip install -e . && \
      pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai pyjwt chromadb json_repair appdirs cryptography; \
    fi \
  else \
    pip install -e . && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai pyjwt chromadb json_repair appdirs cryptography; \
  fi

# Preflight check to confirm installs
RUN python -c 'import pkg_resources, pytest, cryptography; print("preflight ok")'

# Default command to provide shell access
CMD ["/bin/bash"]

