RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libffi-dev libssl-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repo into container
COPY . .

# Upgrade pip, setuptools, wheel
