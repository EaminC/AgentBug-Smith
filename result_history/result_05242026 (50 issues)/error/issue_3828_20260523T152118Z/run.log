# Use poetry if poetry.lock is present
RUN if [ -f "pyproject.toml" ]; then \
        if [ -f "poetry.lock" ]; then \
          pip install poetry && poetry config virtualenvs.create false && poetry install --no-interaction --no-ansi && pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai; \
        else \
          pip install -e . && pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai; \
        fi \
    elif [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt && pip install -e . && pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai; \
    else \
        pip install -e . && pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai; \
    fi

# Preflight check to verify installation
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command to keep container open with bash shell
CMD ["/bin/bash"]
