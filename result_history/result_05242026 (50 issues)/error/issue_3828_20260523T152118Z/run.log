# Set environment variables for Forge API compatibility (OpenAI and Anthropic)
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY="forge-key" \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN="forge-key"

# Add subpackage dirs to PYTHONPATH for pytest imports
ENV PYTHONPATH="/app/lib/crewai/src:/app/lib/crewai-tools/src"
ENV OTEL_SDK_DISABLED="true"

# Working directory inside the container
WORKDIR /app

# Install system dependencies needed for building Python packages and runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libffi-dev libssl-dev libxml2-dev libxslt1-dev python3-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository into the container
COPY . .

# Upgrade pip, setuptools, wheel for latest package management
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies and repository in editable mode + necessary test deps including missing ones from errors
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt && pip install -e . && \
      pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai pyjwt chromadb json_repair appdirs cryptography opentelemetry-exporter-otlp-proto-http botocore; \
    elif [ -f "pyproject.toml" ]; then \
      if [ -f "poetry.lock" ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi && \
        pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai pyjwt chromadb json_repair appdirs cryptography opentelemetry-exporter-otlp-proto-http botocore; \
      else \
        pip install -e . && \
        pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai pyjwt chromadb json_repair appdirs cryptography opentelemetry-exporter-otlp-proto-http botocore; \
      fi \
    else \
      pip install -e . && \
      pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai pyjwt chromadb json_repair appdirs cryptography opentelemetry-exporter-otlp-proto-http botocore; \
    fi

# Preflight check to confirm installs to catch import errors early
RUN python -c 'import pkg_resources, pytest, cryptography, opentelemetry.exporter.otlp.proto.http, botocore; print("preflight ok")'

# Default command to keep container open on bash shell
CMD ["/bin/bash"]

