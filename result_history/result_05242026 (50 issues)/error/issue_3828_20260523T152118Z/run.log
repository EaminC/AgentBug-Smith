    ANTHROPIC_AUTH_TOKEN=forge-key \
    FORGE_API_KEY=forge-key

WORKDIR /app

# Install system dependencies needed for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libffi-dev \
    libssl-dev \
    curl \
  && rm -rf /var/lib/apt/lists/*

# Copy entire repository into container
COPY . .

# Upgrade pip, setuptools, and wheel
# Install requirements.txt if it exists, then install the package in editable mode
# Then install standard test dependencies explicitly to avoid import errors
