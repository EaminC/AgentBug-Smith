# --- end inject ---

# Set Forge environment variables for OpenAI and Anthropic API compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY="forge-key" \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN="forge-key"

# Add subpackage dirs to PYTHONPATH to allow pytest imports
ENV PYTHONPATH="/app/lib/crewai:/app/lib/crewai-tools"

WORKDIR /app

# Install system packages needed to build Python packages and run Python
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libffi-dev libssl-dev curl && rm -rf /var/lib/apt/lists/*

# Copy entire repo into container
COPY . .

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies using pyproject.toml if it exists
# Use poetry if poetry.lock is present
RUN if [ -f "pyproject.toml" ]; then \
        if [ -f "poetry.lock" ]; then \
          pip install poetry && poetry config virtualenvs.create false && poetry install --no-interaction --no-ansi && pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai; \
        else \
          pip install -e . && pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai; \
        fi \
    elif [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt && pip install -e . && pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai; \
    else \
        pip install -e . && pip install pytest pytest-mock pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm mem0ai; \
    fi

# Preflight check to verify installation
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command to keep container open with bash shell
CMD ["/bin/bash"]
