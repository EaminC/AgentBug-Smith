[32mFROM python:3.11-slim AS test_builder

WORKDIR /app

# Install system dependencies required for building some packages if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Detect src/ layout or src imports in tests to decide on editable install
RUN python -m pip install --upgrade pip setuptools wheel && \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." lib/crewai/tests 2>/dev/null; then \
        pip install -r requirements.txt 2>/dev/null || true && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
        pip install -r requirements.txt 2>/dev/null || true && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests on the entire lib/crewai directory as per testpaths configuration
RUN uv run pytest lib/crewai -v --maxfail=3 --disable-warnings

# Assumption: The main application entrypoint is src/my_project/main.py based on provided files
# No explicit EXPOSE declared since no network ports are described

FROM python:3.11-slim AS runtime

WORKDIR /app

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt 2>/dev/null || true && \
    pip install -e . && \
    # Install only production dependencies, exclude test tooling
    pip uninstall -y pytest pytest-mock pytest-asyncio pytest-cov anyio litellm pytest-xdist pytest-timeout mem0ai 2>/dev/null || true

RUN python -c 'import pkg_resources; print("runtime preflight ok")'

