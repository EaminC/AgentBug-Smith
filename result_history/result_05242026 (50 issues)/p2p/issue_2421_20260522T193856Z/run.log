[32mfrom textwrap import dedent
import pytest
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description='string needs to be maintained')


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent can produce output as a Pydantic model
    and that the next agent in the flow can consume that output without error.

    It reproduces the bug where output_pydantic usage caused import errors related
    to 'google.genai' module and ensures the flow completes successfully.
    """

    # Create first agent with minimal configuration
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Create first task assigned to first_agent
    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with minimal configuration
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
    )

    # Create second task assigned to second_agent with output_pydantic set
    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create Crew with both agents and tasks, sequential processing, and memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process='sequential',
        verbose=True,
        memory=True,
    )

    # Run the crew kickoff and get the result
    result = crew.kickoff()

    # Assert that the crew execution completed successfully
    # and that the output of the second task is an instance of ResponseFormat
    assert result is not None, "Crew kickoff returned None"
    assert task_2.output is not None, "Second task output is None"
    assert isinstance(task_2.output, ResponseFormat), (
        f"Expected output type ResponseFormat but got {type(task_2.output)}"
    )
    # Also check that the string field is not empty
    assert task_2.output.string, "ResponseFormat.string is empty"[0m
