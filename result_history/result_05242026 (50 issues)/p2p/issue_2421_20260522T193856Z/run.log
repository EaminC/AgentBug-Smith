[32mfrom textwrap import dedent
import pytest
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description='string needs to maintained')


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent can produce a Pydantic model output
    when given a Pydantic model to output_pydantic parameter, and that the
    next agent can consume that output without errors.

    Before the fix, this test should fail with an ImportError related to
    'google.genai' module missing when using output_pydantic.

    After the fix, this test should pass without errors.
    """

    # Create first agent with minimal configuration
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Create first task assigned to first_agent
    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with minimal configuration
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
    )

    # Create second task assigned to second_agent with output_pydantic set
    task_2 = Task(
        description="task mentioned",
        expected_output="expected output metioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create a Crew with both agents and tasks, sequential process, memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Run the crew kickoff and get the result
    result = crew.kickoff()

    # Assert that the result is a dict containing the expected keys for both tasks
    assert isinstance(result, dict)
    assert len(result) == 2
    # The keys should correspond to task IDs, but we check values for output
    outputs = list(result.values())
    # The second task output should be an instance of ResponseFormat or dict convertible to it
    # Because output_pydantic is set, the output should be a dict matching ResponseFormat
    # We allow dict or ResponseFormat instance depending on implementation
    second_output = outputs[-1]
    if isinstance(second_output, dict):
        # Validate keys and types
        assert "string" in second_output
        assert isinstance(second_output["string"], str)
    else:
        # If output is a Pydantic model instance
        assert isinstance(second_output, ResponseFormat)
        assert isinstance(second_output.string, str)

    # Also check that no error messages related to import or conversion are present in logs
    # This is implicit by successful completion and no exceptions raised


# Note:
# This test relies on the real Agent, Task, Crew classes and their interaction.
# It does not mock the internal LLM or network calls to allow natural failure or success.
# On buggy codebase, this test should fail due to ImportError or conversion error.
# On fixed codebase, this test should pass.[0m
