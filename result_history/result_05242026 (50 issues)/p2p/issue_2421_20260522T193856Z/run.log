[32mfrom textwrap import dedent
import pytest
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description='string needs to be maintained')


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent can produce a Pydantic model output
    and that a subsequent agent can consume that output without errors.

    It reproduces the bug where the output_pydantic parameter causes import errors
    related to 'google.genai' module when converting text to Pydantic model.

    The test should fail on the buggy codebase and pass after the fix.
    """

    # Create first agent with minimal configuration
    first_agent = Agent(
        role="first_agent_role",
        goal=dedent("Complete the first task and produce output."),
        backstory=dedent("First agent backstory."),
        tools=[],
        verbose=False,
        allow_delegation=False,
        memory=True,
    )

    # Task for the first agent
    task_1 = Task(
        description="First task description",
        expected_output="Output from first agent",
        agent=first_agent,
    )

    # Create second agent that expects output in Pydantic model format
    second_agent = Agent(
        role="second_agent_role",
        goal=dedent("Use output from first agent as input."),
        backstory=dedent("Second agent backstory."),
        tools=[],
        verbose=False,
        allow_delegation=False,
        memory=True,
    )

    # Task for the second agent that expects a Pydantic model output
    task_2 = Task(
        description="Second task description",
        expected_output="Processed output from second agent",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create a crew with both agents and tasks, sequential processing
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=False,
        memory=True,
    )

    # Kickoff the crew and get results
    result = crew.kickoff()

    # Validate that the result contains output for both tasks
    assert task_1.description in result, "First task output missing in result"
    assert task_2.description in result, "Second task output missing in result"

    # Validate that the second task output is an instance of ResponseFormat
    output_2 = result[task_2.description]
    assert isinstance(output_2, ResponseFormat), (
        f"Expected output of type ResponseFormat, got {type(output_2)}"
    )

    # Validate that the string field in ResponseFormat is not empty
    assert output_2.string and isinstance(output_2.string, str), (
        "ResponseFormat.string field is empty or not a string"
    )[0m
