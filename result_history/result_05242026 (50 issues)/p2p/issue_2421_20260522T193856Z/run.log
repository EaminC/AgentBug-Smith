ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"

WORKDIR /app

# Copy full repository to container
COPY . .

# Upgrade pip and setuptools
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies and test frameworks
RUN set -eux; \
    if [ -f requirements.txt ]; then \
        pip install -r requirements.txt; \
    fi; \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout "setuptools<=81.0.0" litellm

# Install project itself editable to allow local imports
RUN pip install -e .

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set PYTHONPATH for src layout to resolve 'crewai' imports for tests
ENV PYTHONPATH=/app/src

# Default command for container
CMD ["/bin/bash"]

