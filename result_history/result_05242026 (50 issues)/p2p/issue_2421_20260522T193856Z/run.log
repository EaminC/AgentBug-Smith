[32mfrom textwrap import dedent
import pytest
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to be maintained")


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent flow with output_pydantic parameter set to a Pydantic model
    works without raising import errors related to 'google.genai' and correctly produces output
    as an instance of the Pydantic model.

    The test creates two agents and two tasks in a sequential crew:
    - The first agent runs a simple task producing a string output.
    - The second agent expects output in the form of the ResponseFormat Pydantic model.

    The test asserts that the crew kickoff completes successfully and the output of the second task
    is an instance of ResponseFormat with a non-empty string field.
    """

    # Create first agent with minimal configuration
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Create first task assigned to first agent
    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with minimal configuration
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
    )

    # Create second task assigned to second agent with output_pydantic set
    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create a crew with both agents and tasks, sequential processing, verbose and memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Run the crew kickoff and get the result
    result = crew.kickoff()

    # Assert the crew completed successfully and returned output for the second task
    assert result is not None, "Crew kickoff returned None"
    assert isinstance(result, dict), "Crew kickoff result should be a dictionary"

    # The result dict keys are task IDs; find the second task output
    second_task_output = None
    for task_id, output in result.items():
        # We expect output to be a dict with keys including 'output' or similar
        # Try to find output that matches ResponseFormat structure
        if isinstance(output, dict) and "string" in output:
            second_task_output = output
            break

    assert second_task_output is not None, "Second task output not found in crew result"

    # Validate that the output can be parsed into ResponseFormat model
    parsed_output = ResponseFormat.parse_obj(second_task_output)
