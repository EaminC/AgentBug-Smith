class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to be maintained")


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent can produce output as a Pydantic model
    and that the next agent in the crew can consume this output without errors.

    The bug was that using output_pydantic parameter often failed with an import error
    related to google.genai module. After the fix, this flow should work reliably.
    """

    # Create first agent with minimal setup and a dummy tool list (empty for simplicity)
    first_agent = Agent(
        role="first_agent_role",
        goal=dedent(
            """
            This is the goal of the first agent.
            It should produce output that can be consumed by the second agent.
            """
        ),
        backstory=dedent(
            """
            The first agent is responsible for producing initial output.
            """
        ),
        tools=[],
        verbose=False,
        allow_delegation=False,
        memory=True,
    )

    # Create first task assigned to the first agent
    task_1 = Task(
        description="First task description",
        expected_output="Expected output from first agent.",
        agent=first_agent,
    )

    # Create second agent that will consume the output of the first agent
    second_agent = Agent(
        role="second_agent_role",
        goal=dedent(
            """
            This is the goal of the second agent.
            It should consume output from the first agent as a Pydantic model.
            """
        ),
        backstory="Second agent backstory",
        tools=[],
        verbose=False,
        allow_delegation=False,
        memory=True,
    )

    # Create second task assigned to the second agent with output_pydantic set
    task_2 = Task(
        description="Second task description",
        expected_output="Expected output from second agent.",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create a crew with both agents and tasks, process is sequential
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=False,
        memory=True,
    )

    # Kickoff the crew and get the result
    result = crew.kickoff()

    # Assert that the result is a dict and contains output for both tasks
    assert isinstance(result, dict), "Crew kickoff result should be a dictionary"
    assert task_1.description in result, "Result should contain first task output"
    assert task_2.description in result, "Result should contain second task output"

    # Assert that the output of the second task is an instance of the Pydantic model
    output_2 = result[task_2.description]
    assert isinstance(output_2, ResponseFormat), (
        "Second task output should be an instance of ResponseFormat Pydantic model"
    )

    # Assert that the string field in the Pydantic model is not empty
    assert output_2.string and isinstance(output_2.string, str), (
        "ResponseFormat.string should be a non-empty string"
    )[0m
