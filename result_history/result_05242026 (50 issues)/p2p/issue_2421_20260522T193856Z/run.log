[32mfrom textwrap import dedent
import pytest
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description='string needs to maintained')


def test_agent_output_pydantic_model_flow():
    """
    This test reproduces the bug where using output_pydantic parameter in a Task causes
    an error related to missing 'google.genai' module when converting text to Pydantic model.
    The test creates two agents in a Crew, the second agent expects output in a Pydantic model.
    The test asserts that the Crew kickoff completes successfully and the output of the second task
    is an instance of the Pydantic model ResponseFormat.

    Expected behavior after fix:
    - No ImportError or module not found error occurs.
    - The second task's output is correctly parsed into the Pydantic model.
    """

    # First agent with minimal configuration
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Second agent expects output in ResponseFormat Pydantic model
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
    )

    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process='sequential',
        verbose=True,
        memory=True,
    )

    result = crew.kickoff()

    # Assert the crew finished without errors
    assert result is not None, "Crew kickoff returned None, expected result dict"

    # The result should be a dict with keys for each task id
    assert isinstance(result, dict), "Crew kickoff result should be a dict"

    # The second task's output should be present and be a ResponseFormat instance
    # The keys in result are task ids, so find the second task's output by matching description
    # We assume the result dict contains task outputs keyed by task id or description
    # We'll find the output corresponding to task_2 by matching description in the result keys or values

    # Since the exact structure may vary, we check any value in result that matches ResponseFormat
    found_response_format = False
    for output in result.values():
        if isinstance(output, ResponseFormat):
            found_response_format = True
            break
        # Sometimes output might be dict convertible to ResponseFormat
        if isinstance(output, dict):
            try:
                model_instance = ResponseFormat.parse_obj(output)
                found_response_format = True
                break
            except Exception:
                continue

    assert found_response_format, (
        "The output of the second task is not a ResponseFormat instance or parsable dict"
    )[0m
