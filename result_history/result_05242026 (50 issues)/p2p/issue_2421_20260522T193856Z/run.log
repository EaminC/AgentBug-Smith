[32mimport pytest
from pydantic import BaseModel, Field
from textwrap import dedent

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to be maintained")


def test_agent_output_pydantic_model_flow():
    """
    Test that an agent producing a pydantic model output via output_pydantic parameter
    works properly without import errors related to 'google.genai' and that the next agent
    can consume the output correctly.

    This test should fail on the buggy codebase due to import errors and pass after the fix.
    """

    # Create first agent with minimal configuration and a simple task
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent that expects output in the form of the ResponseFormat pydantic model
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
    )

    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create a Crew with both agents and tasks, sequential processing and memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Run the crew kickoff and get the result
    result = crew.kickoff()

    # Assert that the result is a dict containing the output of the last task
    # and that the output can be parsed as ResponseFormat
    assert isinstance(result, dict), "Crew kickoff result should be a dict"
    assert task_2.description in result, "Result should contain the second task output"
    output = result[task_2.description]
    # The output should be an instance of ResponseFormat or dict convertible to it
    if isinstance(output, dict):
        parsed = ResponseFormat(**output)
    else:
        parsed = output
    assert isinstance(parsed, ResponseFormat), "Output should be a ResponseFormat instance"
    # The string field should be non-empty
    assert parsed.string and isinstance(parsed.string, str), "ResponseFormat.string should be a non-empty string"[0m
