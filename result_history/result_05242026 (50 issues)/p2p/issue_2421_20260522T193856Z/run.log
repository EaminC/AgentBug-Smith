[32mimport pytest
from pydantic import BaseModel, Field
from textwrap import dedent

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to be maintained")


def test_agent_output_pydantic_model_flow():
    """
    This test reproduces the bug where using output_pydantic parameter in a Task
    causes an import error related to 'google.genai' module when converting text
    to a Pydantic model.

    The test creates two agents and two tasks in a Crew, where the second task
    expects output in the form of a Pydantic model. It asserts that the Crew
    kickoff completes successfully and that the output of the second task is an
    instance of the expected Pydantic model.

    On the buggy codebase, this test should fail with an ImportError or related
    error. After applying the fix, this test should pass.
    """
    # Create first agent with minimal configuration
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Create first task assigned to first agent
    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with minimal configuration
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
        verbose=True,
        memory=True,
    )

    # Create second task assigned to second agent, expecting output as ResponseFormat
    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create Crew with both agents and tasks, sequential process with memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Run the Crew kickoff and get results
    result = crew.kickoff()

    # Assert that the result is a dict and contains output for the second task
    assert isinstance(result, dict)
    assert task_2.id in result

    # Assert the output for the second task is an instance of ResponseFormat
    output = result[task_2.id]
    assert isinstance(output, ResponseFormat)

    # Assert the string field is present and non-empty
    assert hasattr(output, "string")
    assert isinstance(output.string, str)
    assert len(output.string) > 0[0m
