        first_agent = Agent(role = "role mentioned",
                                goal = dedent( f"""Goals mentioned"""),
                                backstory = dedent("""Back story mentioned"""),
                                tools=[tool mentioned],
                                verbose=True,
                                allow_delegation=True,
                                memory = True
