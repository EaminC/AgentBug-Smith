[32mimport pytest
from pydantic import BaseModel, Field
from textwrap import dedent

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description='string needs to maintained')


def test_agent_output_pydantic_model_flow():
    """
    Test that an agent producing a pydantic model output with output_pydantic parameter
    works without error and that the next agent can consume it correctly.

    This test will fail on the buggy codebase due to ImportError related to google.genai
    and will pass after the fix.
    """

    # Create first agent with a simple task
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with output_pydantic set to ResponseFormat
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
        verbose=True,
        memory=True,
    )

    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create crew with both agents and tasks, process sequentially
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Kickoff crew execution
    result = crew.kickoff()

    # Assert that the result is a dict and contains expected keys
    # The output of the second task should be an instance of ResponseFormat
    assert isinstance(result, dict), "Crew kickoff result should be a dict"
    assert task_2.id in result, "Result should contain output for second task"
    output = result[task_2.id]
    # The output should be a dict with keys matching ResponseFormat fields
    assert isinstance(output, dict), "Task output should be a dict"
    assert "string" in output, "Output dict should contain 'string' key"
    # The string value should be non-empty
    assert isinstance(output["string"], str) and output["string"], "Output 'string' should be a non-empty string"[0m
