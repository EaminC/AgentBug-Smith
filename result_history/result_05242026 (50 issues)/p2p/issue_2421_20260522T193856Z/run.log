[32mimport pytest
from textwrap import dedent
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to be maintained")


def test_agent_output_pydantic_model_flow():
    """
    This test reproduces the bug where using output_pydantic parameter with an agent
    causes a failure related to missing google.genai module.
    The test creates two agents and two tasks in a Crew, where the second task expects
    output in the form of a Pydantic model. The test asserts that the Crew kickoff
    completes successfully and that the output of the second task is an instance of
    the expected Pydantic model.

    Before the fix, this test should fail with an ImportError or related error.
    After applying the fix, this test should pass.
    """

    # Create first agent with minimal required parameters
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Create first task assigned to first agent
    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with minimal required parameters
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
    )

    # Create second task assigned to second agent with output_pydantic parameter
    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create a Crew with the two agents and two tasks, sequential processing
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Run the crew kickoff and get results
    result = crew.kickoff()

    # Assert that the crew execution was successful
    assert result is not None, "Crew kickoff returned None, expected result dict"

    # The result should be a dict with task outputs keyed by task id or name
    # We check that the output for the second task is present and is a Pydantic model instance
    # The exact key depends on implementation; we try to find the output for task_2

    # Find output for task_2 by matching description or agent role in result keys
    # result is expected to be a dict mapping task identifiers to outputs
    # We try to find the output corresponding to task_2 description

    # Since the exact structure is unknown, we try to find any output that is instance of ResponseFormat
    found_pydantic_output = False
    if isinstance(result, dict):
        for value in result.values():
            if isinstance(value, ResponseFormat):
                found_pydantic_output = True
                # Also check that the string field is non-empty string
                assert isinstance(value.string, str)
                assert len(value.string) > 0
                break

    assert found_pydantic_output, "Did not find output as ResponseFormat instance in crew results"[0m
