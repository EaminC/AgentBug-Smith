[32mfrom textwrap import dedent
import pytest
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description='string needs to be maintained')


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent can produce output as a Pydantic model
    and that the next agent in a sequential crew can consume that output
    without errors related to missing modules (e.g., 'google.genai').

    The test creates two agents and two tasks:
    - The first agent runs a task producing some output.
    - The second agent runs a task expecting output in the form of the ResponseFormat Pydantic model.

    The crew is run sequentially with memory enabled.

    Expected:
    - The crew kickoff completes successfully.
    - The output of the second task is an instance of ResponseFormat.
    """

    # Create first agent with minimal viable configuration
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Create first task assigned to first agent
    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with minimal configuration
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
        verbose=True,
        memory=True,
    )

    # Create second task assigned to second agent, expecting Pydantic output
    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create crew with both agents and tasks, sequential processing, and memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Run the crew kickoff and get results
    result = crew.kickoff()

    # Assert the crew finished successfully
    assert result is not None, "Crew kickoff returned None, expected result object"

    # The result should contain outputs keyed by task id or index; find second task output
    # We expect the output of the second task to be a ResponseFormat instance
    # The exact structure depends on crew implementation; try to find output for task_2
    # We'll check if any output is an instance of ResponseFormat

    # Collect all outputs from the result, which might be a dict or list
    outputs = []
    if isinstance(result, dict):
        outputs.extend(result.values())
    elif isinstance(result, list):
        outputs.extend(result)
    else:
        outputs.append(result)

    # Check if any output is instance of ResponseFormat
    found_pydantic_output = any(isinstance(output, ResponseFormat) for output in outputs)

    assert found_pydantic_output, (
        "Expected output of second task to be a ResponseFormat instance, "
        "but it was not found in crew kickoff result."
    )[0m
