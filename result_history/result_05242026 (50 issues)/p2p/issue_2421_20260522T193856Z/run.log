[32mfrom textwrap import dedent
import pytest
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to be maintained")


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent crew flow using output_pydantic with a Pydantic model
    completes successfully without raising import errors related to 'google.genai'.

    The test creates two agents and two tasks:
    - The first agent runs a simple task.
    - The second agent expects output in the form of the ResponseFormat Pydantic model.

    The crew is run sequentially with memory enabled.

    Expected:
    - The crew kickoff completes without exceptions.
    - The output of the second task is an instance of ResponseFormat.
    """
    # Create first agent with minimal config
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with output_pydantic set
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
        verbose=True,
        memory=True,
    )

    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create crew with both agents and tasks, sequential process
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Run the crew kickoff and assert no exceptions and correct output type
    result = crew.kickoff()

    # The result should be a dict with task outputs keyed by task id or name
    # We check that the output for task_2 is an instance of ResponseFormat
    # The exact key depends on implementation, so we find the output by task_2 id
    output = result.get(task_2.id) or result.get(task_2.description) or None

    assert output is not None, "No output found for second task"
    assert isinstance(output, ResponseFormat), "Output is not a ResponseFormat instance"
    # Optionally check that the string field is non-empty
    assert output.string, "ResponseFormat string field is empty"[0m
