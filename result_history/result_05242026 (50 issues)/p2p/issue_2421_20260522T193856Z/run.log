[32mimport pytest
from pydantic import BaseModel, Field
from textwrap import dedent

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to be maintained")


def test_agent_output_pydantic_model_flow():
    """
    Test that an agent can produce output as a Pydantic model and that the next agent
    can consume that output without error, specifically verifying the fix for issue #2421.
    """

    # Create first agent with minimal valid configuration
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Create first task assigned to first_agent
    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with minimal valid configuration
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
    )

    # Create second task assigned to second_agent with output_pydantic set
    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create crew with both agents and tasks, sequential processing, and memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Kickoff the crew execution
    result = crew.kickoff()

    # Assert that the crew execution completed successfully and returned output for the last task
    assert result is not None, "Crew kickoff returned None"
    # The result should be a dictionary with task outputs keyed by task id or name
    # We check that the output for the second task is an instance of ResponseFormat or dict with 'string' key
    # Because output_pydantic is set, the output should be a pydantic model instance or dict
    # We allow dict for flexibility depending on implementation
    output_values = list(result.values())
    assert len(output_values) >= 2, "Expected at least two task outputs"
    second_task_output = output_values[-1]
    # If output is a dict, check it has the expected key
    if isinstance(second_task_output, dict):
        assert "string" in second_task_output, "Output dict missing 'string' key"
        assert isinstance(second_task_output["string"], str), "'string' key is not a string"
    else:
        # If output is a pydantic model instance, check type and attribute
        assert isinstance(second_task_output, ResponseFormat), "Output is not instance of ResponseFormat"
        assert isinstance(second_task_output.string, str), "ResponseFormat.string is not a string"[0m
