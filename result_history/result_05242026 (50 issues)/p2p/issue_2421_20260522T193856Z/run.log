[32mfrom textwrap import dedent
import pytest
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to maintained")


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent can produce output as a Pydantic model
    and that the next agent in the flow can consume that output without error.

    Before fix: This test should fail due to ImportError related to 'google.genai'.
    After fix: This test should pass without errors.
    """

    # Create first agent with minimal required parameters
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent that expects output in the form of ResponseFormat Pydantic model
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
        verbose=True,
        memory=True,
    )

    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create crew with sequential processing and memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Kickoff the crew execution
    result = crew.kickoff()

    # Assert that the crew execution completed successfully
    assert result is not None, "Crew kickoff returned None, expected valid result"

    # Assert that the output of the second task is an instance of ResponseFormat
    second_task_output = result.get(task_2.id)
    assert second_task_output is not None, "Second task output is None"
    assert isinstance(second_task_output, ResponseFormat), (
        f"Second task output is not a ResponseFormat instance, got {type(second_task_output)}"
    )

    # Assert that the string field in the ResponseFormat output is not empty
    assert second_task_output.string, "ResponseFormat.string field is empty"[0m
