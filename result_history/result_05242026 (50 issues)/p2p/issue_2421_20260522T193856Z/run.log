[32mimport pytest
from textwrap import dedent
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to be maintained")


def test_agent_output_pydantic_model_flow():
    """
    This test reproduces the bug where using output_pydantic parameter in an agent task
    causes an error "No module named 'google.genai'".
    The test creates two agents and two tasks in a crew, where the second task uses output_pydantic.
    The test asserts that the crew kickoff completes successfully and the output of the second task
    is an instance of the ResponseFormat pydantic model.
    """

    # Create first agent with minimal required parameters
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Create first task assigned to first agent
    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with minimal required parameters
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
    )

    # Create second task assigned to second agent with output_pydantic set
    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create crew with both agents and tasks, sequential process and memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Run the crew kickoff and get the results
    result = crew.kickoff()

    # Assert the crew finished successfully
    assert result["success"] is True

    # Assert the second task output is a ResponseFormat instance
    task_2_output = result["task_results"][1]["output"]
    assert isinstance(task_2_output, ResponseFormat)
    # Also assert the output has the expected attribute 'string'
    assert hasattr(task_2_output, "string")
    # The string attribute should be a non-empty string
    assert isinstance(task_2_output.string, str)
    assert len(task_2_output.string) > 0[0m
