from textwrap import dedent
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to be maintained")


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent can produce output as a Pydantic model
    and that the next agent in a sequential Crew flow can consume that output
    without errors related to missing modules or conversion failures.

    This test is expected to fail on the buggy codebase due to the error:
    "Failed to add to long term memory: Failed to convert text into a Pydantic model
    due to error: No module named 'google.genai'".

    After applying the fix, the test should pass without errors.
    """

    # Create first agent with minimal configuration and no output_pydantic
    first_agent = Agent(
        role="role mentioned",
        goal=dedent(
            """\
            Goals mentioned
            """
        ),
        backstory=dedent(
            """\
            Back story mentioned
            """
        ),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent that expects output in the form of ResponseFormat Pydantic model
    second_agent = Agent(
        role="role mentioned",
        goal=dedent(
            """\
            goal mentioned
            """
        ),
        backstory="back story mentioned",
        verbose=True,
        memory=True,
    )

    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create Crew with sequential process and memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Run the crew kickoff and get the results
    result = crew.kickoff()

    # Assert that the crew ran successfully and returned a dictionary with expected keys
    assert isinstance(result, dict), "Crew kickoff result should be a dictionary"

    # Assert that the second task's output is a dict matching the Pydantic model keys
    # The output should be under the second task's id or name; we check any dict value for keys
    # Because the exact structure depends on implementation, we check presence of 'string' key
    found_output = False
    for task_id, output in result.items():
        if isinstance(output, dict) and "string" in output:
            found_output = True
            break

    assert found_output, (
        "Output from the second agent task should be a dict containing the 'string' key "
        "matching the ResponseFormat Pydantic model"
    )[0m
