[32mfrom textwrap import dedent
import pytest
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description='string needs to be maintained')


def test_agent_output_pydantic_model_flow():
    """
    Test that an agent with output_pydantic parameter set to a Pydantic model
    produces output correctly without import errors related to google.genai.
    This test should fail on the buggy codebase and pass after the fix.
    """
    # Create first agent with minimal setup
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with output_pydantic set to ResponseFormat
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
    )

    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create crew with both agents and tasks, process sequentially
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process='sequential',
        verbose=True,
        memory=True,
    )

    # Kickoff the crew and get results
    result = crew.kickoff()

    # Assert that the result contains output for both tasks
    assert isinstance(result, dict)
    assert task_1.description in result
    assert task_2.description in result

    # Assert that the output for the second task is an instance of ResponseFormat
    output_2 = result[task_2.description]
    assert isinstance(output_2, ResponseFormat)

    # Assert that the string field is present and is a non-empty string
    assert hasattr(output_2, 'string')
    assert isinstance(output_2.string, str)
    assert len(output_2.string) > 0[0m
