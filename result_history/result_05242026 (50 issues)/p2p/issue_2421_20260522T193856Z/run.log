[32mfrom textwrap import dedent
import pytest
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to be maintained")


def test_agent_output_pydantic_model_flow():
    """
    This test creates two agents in a Crew with two sequential tasks.
    The second task uses output_pydantic=ResponseFormat to enforce output format.
    The test verifies that the Crew kickoff completes successfully and the output
    of the second task is an instance of ResponseFormat with a non-empty string field.

    This test fails on the buggy codebase due to ImportError related to google.genai
    when converting text to Pydantic model output, and passes after the fix.
    """
    # Create first agent with minimal role, goal, backstory, no tools for simplicity
    first_agent = Agent(
        role="First agent role",
        goal=dedent(
            """
            Perform the first task and produce some output.
            """
        ),
        backstory=dedent(
            """
            This agent starts the flow.
            """
        ),
        tools=[],
        verbose=False,
        allow_delegation=True,
        memory=True,
    )

    # Task 1 executed by first_agent
    task_1 = Task(
        description="First task description",
        expected_output="Some output from first task.",
        agent=first_agent,
    )

    # Create second agent with output_pydantic set to ResponseFormat
    second_agent = Agent(
        role="Second agent role",
        goal=dedent(
            """
            Take output from first task and produce a ResponseFormat pydantic model output.
            """
        ),
        backstory="Second agent backstory",
        verbose=False,
        allow_delegation=True,
        memory=True,
    )

    # Task 2 executed by second_agent, expects output as ResponseFormat pydantic model
    task_2 = Task(
        description="Second task description",
        expected_output="Output as ResponseFormat pydantic model",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create Crew with sequential process
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=False,
        memory=True,
    )

    # Kickoff the crew and get results
    results = crew.kickoff()

    # Assert results is a dict with keys for each task
    assert isinstance(results, dict), "Crew kickoff result should be a dict"
    assert task_1.description in results, "First task result missing"
    assert task_2.description in results, "Second task result missing"

    # The output of task 2 should be an instance of ResponseFormat
    output_task_2 = results[task_2.description]
    assert isinstance(output_task_2, ResponseFormat), (
        "Output of second task should be instance of ResponseFormat"
    )

    # The string field should be non-empty
    assert output_task_2.string and isinstance(output_task_2.string, str), (
        "ResponseFormat.string field should be a non-empty string"
    )[0m
