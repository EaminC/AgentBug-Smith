[32mfrom textwrap import dedent
import pytest
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description='string needs to be maintained')


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent can produce output as a Pydantic model
    and that the next agent in the flow can consume that output without error.

    Bug: Previously, using output_pydantic parameter caused an ImportError related
    to 'google.genai' module when converting text into a Pydantic model.

    This test should fail on the buggy codebase and pass after the fix.
    """

    # Create first agent with minimal setup
    first_agent = Agent(
        role="first_agent_role",
        goal=dedent("Complete the first task and produce output."),
        backstory=dedent("First agent backstory."),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Task for first agent
    task_1 = Task(
        description="First task description",
        expected_output="First task expected output.",
        agent=first_agent,
    )

    # Create second agent that expects output as a Pydantic model
    second_agent = Agent(
        role="second_agent_role",
        goal=dedent("Process output from first agent."),
        backstory="Second agent backstory.",
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Task for second agent with output_pydantic set to ResponseFormat
    task_2 = Task(
        description="Second task description",
        expected_output="Second task expected output.",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create a Crew with both agents and tasks, process sequentially
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process='sequential',
        verbose=True,
        memory=True,
    )

    # Run the crew kickoff and get results
    result = crew.kickoff()

    # Assert that the result for the second task is an instance of ResponseFormat
    assert isinstance(result[task_2], ResponseFormat), (
        f"Expected output to be an instance of ResponseFormat, got {type(result[task_2])}"
    )

    # Assert that the string field in the ResponseFormat is non-empty
    assert result[task_2].string and isinstance(result[task_2].string, str), (
        "Expected 'string' field in ResponseFormat to be a non-empty string."
    )[0m
