[32mimport pytest
from textwrap import dedent
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to be maintained")


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent can produce output as a Pydantic model
    and that the next agent in the flow can consume that output without error.

    The test fails on the buggy codebase due to import errors related to
    google.genai module when using output_pydantic parameter.
    After the fix, the test should pass without errors.
    """

    # Create the first agent with minimal setup
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Task for the first agent
    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create the second agent, which expects a Pydantic model output
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
    )

    # Task for the second agent, with output_pydantic specified
    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create a Crew with both agents and tasks, sequential processing, and memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Run the crew kickoff and get the result
    result = crew.kickoff()

    # Assert that the result contains output for both tasks
    assert task_1.id in result, "First task output missing in crew result"
    assert task_2.id in result, "Second task output missing in crew result"

    # Assert that the second task output is an instance of ResponseFormat
    output_2 = result[task_2.id]
    assert isinstance(output_2, ResponseFormat), "Second task output is not a ResponseFormat instance"

    # Assert that the string field in the ResponseFormat output is not empty
    assert output_2.string, "ResponseFormat string field is empty"[0m
