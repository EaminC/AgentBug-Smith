from pydantic import BaseModel, Field
from textwrap import dedent

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to maintained")


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent can produce a Pydantic model output
    and that the next agent can consume it without errors.

    Before fix: This test should fail due to ImportError or conversion errors.
    After fix: This test should pass successfully.
    """

    # Create first agent with minimal config
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Create first task assigned to first_agent
    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with minimal config
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
    )

    # Create second task assigned to second_agent with output_pydantic set
    task_2 = Task(
        description="task mentioned",
        expected_output="expected output metioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create a Crew with both agents and tasks, sequential process, with memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Kickoff the crew execution
    result = crew.kickoff()

    # Assert the crew execution finished successfully
    assert result is not None
    # Assert that the second task output is an instance of ResponseFormat
    output = result.get(task_2.id)
    assert output is not None
    assert isinstance(output, ResponseFormat)
    # Assert the output string field is a non-empty string
    assert isinstance(output.string, str)
    assert output.string.strip() != ""[0m
