[32mimport pytest
from textwrap import dedent
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to be maintained")


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent flow with output_pydantic parameter works correctly without
    raising import errors related to google.genai module. It creates two agents and two tasks,
    the second task expects output in the form of a pydantic model. The test asserts that the
    Crew kickoff completes successfully and returns output matching the pydantic model.
    """
    # Create first agent with minimal configuration
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Create first task assigned to first_agent
    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with minimal configuration
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
    )

    # Create second task assigned to second_agent with output_pydantic set
    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create Crew with both agents and tasks, sequential process, and memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Run the Crew kickoff and get the result
    result = crew.kickoff()

    # Assert that result is a dict and contains output for task_2 matching ResponseFormat
    assert isinstance(result, dict)
    # The result should contain task_2 output key (usually task id or description)
    # We check that the output can be parsed into ResponseFormat without error
    # Since keys may be task descriptions or ids, we try to find the output for task_2
    found_output = None
    for value in result.values():
        if isinstance(value, dict) and "string" in value:
            found_output = value
            break
    assert found_output is not None, "No output matching ResponseFormat found in crew result"
    # Validate that the output matches the ResponseFormat model
    model_instance = ResponseFormat.parse_obj(found_output)
    assert isinstance(model_instance, ResponseFormat)
    assert isinstance(model_instance.string, str)
    assert len(model_instance.string) > 0

# Note:
# This test is designed to fail on the buggy codebase where the import error or LLM provider error occurs,
# and pass on the fixed codebase where the bug is resolved.[0m
