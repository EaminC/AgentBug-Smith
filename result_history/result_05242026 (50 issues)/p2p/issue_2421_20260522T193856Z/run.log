[32mfrom textwrap import dedent
import pytest
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to be maintained")


def test_agent_output_pydantic_model_flow():
    """
    This test reproduces the bug where using output_pydantic parameter with an Agent
    causes an ImportError related to 'google.genai' module.

    The test creates two agents and two tasks in a Crew:
    - The first agent runs a simple task.
    - The second agent uses output_pydantic with ResponseFormat model.

    The test asserts that the Crew kickoff completes successfully and returns a dict
    containing the expected pydantic model output from the second task.

    On the buggy codebase, this test should fail with ImportError or related error.
    After the fix, this test should pass.
    """

    # Create first agent with minimal setup
    first_agent = Agent(
        role="role mentioned",
        goal=dedent(
            """Goals mentioned"""
        ),
        backstory=dedent(
            """Back story mentioned"""
        ),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Task for first agent
    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with minimal setup
    second_agent = Agent(
        role="role mentioned",
        goal=dedent(
            """goal mentioned"""
        ),
        backstory="back story mentioned",
    )

    # Task for second agent with output_pydantic set to ResponseFormat
    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create Crew with sequential process and memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Run the crew kickoff
    result = crew.kickoff()

    # Assert the result is a dict and contains output for task_2
    assert isinstance(result, dict), "Crew kickoff result should be a dict"
    # The keys in result should include task_2's id or description
    # We check that the output for the second task is a dict matching ResponseFormat keys
    found_output = False
    for task_id, output in result.items():
        if isinstance(output, dict) and "string" in output:
            found_output = True
            # Validate that output matches ResponseFormat model
            model_instance = ResponseFormat(**output)
            assert isinstance(model_instance, ResponseFormat)
            break
    assert found_output, "Output matching ResponseFormat model not found in crew result"[0m
