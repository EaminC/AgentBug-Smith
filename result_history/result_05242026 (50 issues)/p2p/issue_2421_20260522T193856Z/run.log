[32mfrom textwrap import dedent
import pytest
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description="string needs to maintained")


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent can produce a Pydantic model output
    and that the next agent can consume it without error.

    Before the fix, this test should fail with an ImportError related to
    'google.genai' module when using output_pydantic parameter.

    After the fix, this test should pass successfully.
    """

    # Create first agent with minimal setup
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Create first task assigned to first agent
    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent with minimal setup
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
    )

    # Create second task assigned to second agent with output_pydantic
    task_2 = Task(
        description="task mentioned",
        expected_output="expected output metioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create crew with both agents and tasks, sequential process, with memory
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Kickoff the crew and get results
    result = crew.kickoff()

    # Assert the crew completed successfully and returned expected pydantic output
    assert result is not None
    # The last task's output should be an instance of ResponseFormat
    last_task_output = result.get(task_2.id)
    assert isinstance(last_task_output, ResponseFormat)
    # The 'string' field should be present and non-empty string
    assert hasattr(last_task_output, "string")
    assert isinstance(last_task_output.string, str)
    assert len(last_task_output.string) > 0[0m
