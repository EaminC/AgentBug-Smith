                                output_pydantic=ResponseFormat
                                )

        first_crew = Crew(agents = [first_agent, second_agent], 
                    tasks = [task_1, task_2], 
                    process = 'sequential',
                    verbose = True,
                    memory=True
                    )
        
        result = first_crew.kickoff()
        return result

