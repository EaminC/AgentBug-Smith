[32mfrom textwrap import dedent
import pytest
from pydantic import BaseModel, Field

from crewai.agent import Agent
from crewai.task import Task
from crewai.crew import Crew


class ResponseFormat(BaseModel):
    string: str = Field(description='string needs to be maintained')


def test_agent_output_pydantic_model_flow():
    """
    This test verifies that an agent can produce output as a Pydantic model
    and that the next agent in the crew can consume that output without error.

    It reproduces the bug where output_pydantic usage fails with an import error
    related to 'google.genai'. The test should fail on the buggy codebase and
    pass after the fix is applied.
    """

    # Create first agent with minimal required parameters
    first_agent = Agent(
        role="role mentioned",
        goal=dedent("Goals mentioned"),
        backstory=dedent("Back story mentioned"),
        tools=[],
        verbose=True,
        allow_delegation=True,
        memory=True,
    )

    # Task for first agent
    task_1 = Task(
        description="Task description mentioned",
        expected_output="expected output mentioned.",
        agent=first_agent,
    )

    # Create second agent which expects output in the form of ResponseFormat Pydantic model
    second_agent = Agent(
        role="role mentioned",
        goal=dedent("goal mentioned"),
        backstory="back story mentioned",
    )

    # Task for second agent with output_pydantic set
    task_2 = Task(
        description="task mentioned",
        expected_output="expected output mentioned",
        agent=second_agent,
        output_pydantic=ResponseFormat,
    )

    # Create a crew with both agents and tasks, process sequentially, with memory enabled
    crew = Crew(
        agents=[first_agent, second_agent],
        tasks=[task_1, task_2],
        process="sequential",
        verbose=True,
        memory=True,
    )

    # Run the crew kickoff
    result = crew.kickoff()

    # Assert that the result is not None and contains expected keys
    assert result is not None, "Crew kickoff returned None, expected a result dictionary"
    assert isinstance(result, dict), "Crew kickoff result should be a dictionary"

    # Check that both tasks have results in the output
    assert len(result) >= 2, "Expected at least two task results in the crew output"

    # Check that the second task output is an instance of ResponseFormat or dict convertible to it
    second_task_output = result.get(task_2.id) or result.get(task_2.description)
    assert second_task_output is not None, "Second task output missing in crew result"

    # If output is dict, try to parse it into ResponseFormat
    if isinstance(second_task_output, dict):
        parsed_output = ResponseFormat.parse_obj(second_task_output)
    elif isinstance(second_task_output, ResponseFormat):
        parsed_output = second_task_output
    else:
        pytest.fail("Second task output is neither dict nor ResponseFormat instance")

    # Assert the parsed output has the expected attribute
    assert hasattr(parsed_output, "string"), "Parsed output missing 'string' attribute"
    assert isinstance(parsed_output.string, str), "'string' attribute should be of type str"
    assert len(parsed_output.string) > 0, "'string' attribute should not be empty"[0m
