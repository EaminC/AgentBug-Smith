def test_vision_flag_for_gpt4_turbo():
    """
    Test that the AI class correctly sets vision=True for gpt-4-turbo models.
    In buggy code, vision is only set if "vision" in model_name, missing gpt-4-turbo.
    After fix, vision should be True for gpt-4-turbo and gpt-4-turbo-2024-04-09.
    """
    # Test with gpt-4-turbo (should have vision=True after fix)
    ai = AI(model_name="gpt-4-turbo")
    # In buggy code, vision will be False because "vision" not in model_name.
    # After fix, vision should be True.
    assert ai.vision == True, f"Expected vision=True for gpt-4-turbo, got {ai.vision}"

    # Test with gpt-4-turbo-2024-04-09 (should also have vision=True after fix)
    ai2 = AI(model_name="gpt-4-turbo-2024-04-09")
    assert ai2.vision == True, f"Expected vision=True for gpt-4-turbo-2024-04-09, got {ai2.vision}"

    # Test with gpt-4-vision-preview (should have vision=True in both buggy and fixed)
    ai3 = AI(model_name="gpt-4-vision-preview")
    assert ai3.vision == True, f"Expected vision=True for gpt-4-vision-preview, got {ai3.vision}"

    # Test with gpt-4 (should have vision=False)
    ai4 = AI(model_name="gpt-4")
    assert ai4.vision == False, f"Expected vision=False for gpt-4, got {ai4.vision}"

    # Test with gpt-4-0125-preview (should have vision=False)
    ai5 = AI(model_name="gpt-4-0125-preview")
    assert ai5.vision == False, f"Expected vision=False for gpt-4-0125-preview, got {ai5.vision}"

    # Test with claude-3-opus (should have vision=True after fix)
    ai6 = AI(model_name="claude-3-opus")
    assert ai6.vision == True, f"Expected vision=True for claude-3-opus, got {ai6.vision}"

    # Test with gpt-4-turbo-preview (should have vision=False because "preview" in name and not vision-preview)
    ai7 = AI(model_name="gpt-4-turbo-preview")
    assert ai7.vision == False, f"Expected vision=False for gpt-4-turbo-preview, got {ai7.vision}"


def test_vision_images_included_in_messages():
    """
    Test that when vision=True, images from an image directory are included in the messages.
    This test mocks the underlying LLM call to verify the message structure.
    """
    # Create a temporary directory with an image file
    with tempfile.TemporaryDirectory() as tmpdir:
        image_dir = Path(tmpdir) / "images"
        image_dir.mkdir()
        # Create a dummy image file (just a valid PNG header)
        dummy_image_path = image_dir / "test.png"
        with open(dummy_image_path, "wb") as f:
            # PNG header bytes
            f.write(b'\x89PNG\r\n\x1a\n' + b'0' * 100)

        # Create a prompt file
        prompt_file = Path(tmpdir) / "prompt"
        prompt_file.write_text("Create a website based on this image.")

        # Create AI instance with gpt-4-turbo (vision should be True after fix)
        ai = AI(model_name="gpt-4-turbo")

        # Mock the underlying langchain ChatOpenAI/Anthropic call to capture messages
        mock_response = MagicMock()
        mock_response.content = "```html\n<html>test</html>\n```"
        mock_llm = AsyncMock()
        mock_llm.ainvoke = AsyncMock(return_value=mock_response)

        with patch.object(ai, 'llm', mock_llm):
            # Prepare memory and execution env
            memory = MockMemory()
            execution_env = MockExecutionEnv()
            prompt = Prompt(
                prompt_file.read_text(),
                image_dir=str(image_dir) if ai.vision else None
            )

            # Run code generation step
            result = gen_code(ai, prompt, memory, execution_env)

            # Verify that the LLM was called with messages that include image content
            call_args = mock_llm.ainvoke.call_args
            assert call_args is not None, "LLM was not called"
            messages = call_args[0][0]  # first argument is list of messages
            # Find the user message that should contain images
            user_messages = [msg for msg in messages if msg.type == "human"]
            assert len(user_messages) > 0, "No human message found"
            user_message = user_messages[0]
            content = user_message.content

            # In buggy code, vision=False for gpt-4-turbo, so images are not included.
            # After fix, vision=True, so images should be included.
            if ai.vision:
                # Check that image content is present (either as URL or base64)
                # Langchain's image message format may vary; we check for something image-related.
                # For simplicity, we check that the content is a list (multiple parts) and includes an image part.
                assert isinstance(content, list), f"Expected content to be a list for vision models, got {type(content)}"
                image_parts = [part for part in content if hasattr(part, 'type') and part.type == 'image_url']
                assert len(image_parts) > 0, "No image parts found in message"
            else:
                # If vision is False, content should be a plain string (no images)
                assert isinstance(content, str), f"Expected content to be a string for non-vision models, got {type(content)}"


