[32mimport pytest

from src.agentscope.agent._react_agent import ReactAgent
from src.agentscope.toolkit import Toolkit
from src.agentscope.plan import PlanNotebook


class DummyTool:
    def __init__(self, name):
        self.name = name

    def __call__(self):
        return f"Tool {self.name} called"


class DummyPlanNotebook(PlanNotebook):
    def __init__(self):
        super().__init__(description="Dummy plan notebook")
        self._tools = [DummyTool("tool1"), DummyTool("tool2")]

    def list_tools(self):
        return self._tools


def test_reset_equipped_tools_registration_behavior():
    """
    This test verifies the behavior of ReactAgent initialization regarding
    the registration of reset_equipped_tools when plan_notebook is provided
    but enable_meta_tool is False.

    Buggy behavior:
        - reset_equipped_tools is registered even if enable_meta_tool is False
          but plan_notebook is provided.
        - This leads to a logical conflict because plan_related tool group is
          not created and reset_equipped_tools is meaningless.

    Fixed behavior:
        - reset_equipped_tools is only registered if enable_meta_tool is True.
    """

    toolkit = Toolkit()

    plan_notebook = DummyPlanNotebook()

    # Case 1: enable_meta_tool=False, plan_notebook provided (buggy case)
    agent_buggy = ReactAgent(
        toolkit=toolkit,
        knowledge=None,
        enable_meta_tool=False,
        plan_notebook=plan_notebook,
        enable_rewrite_query=False,
        parallel_tool_calls=False,
    )

    # In buggy code, reset_equipped_tools is registered even if enable_meta_tool=False
    # So toolkit.reset_equipped_tools should be in registered tool functions
    registered_funcs = [func for func in toolkit._registered_tool_functions]

    # We expect that reset_equipped_tools is NOT registered when enable_meta_tool=False
    # So this assertion should fail on buggy code and pass on fixed code
    assert toolkit.reset_equipped_tools not in registered_funcs, (
        "reset_equipped_tools should NOT be registered when enable_meta_tool=False"
    )

    # Case 2: enable_meta_tool=True, plan_notebook provided (expected behavior)
    toolkit2 = Toolkit()
    agent_fixed = ReactAgent(
        toolkit=toolkit2,
        knowledge=None,
        enable_meta_tool=True,
        plan_notebook=plan_notebook,
        enable_rewrite_query=False,
        parallel_tool_calls=False,
    )
    registered_funcs2 = [func for func in toolkit2._registered_tool_functions]
    assert toolkit2.reset_equipped_tools in registered_funcs2, (
        "reset_equipped_tools should be registered when enable_meta_tool=True"
    )

    # Also check that the "plan_related" tool group is created only when enable_meta_tool=True
    # The toolkit has a _tool_groups dict mapping group names to tools
    assert "plan_related" not in toolkit._tool_groups, (
        "plan_related group should NOT exist when enable_meta_tool=False"
    )
    assert "plan_related" in toolkit2._tool_groups, (
        "plan_related group should exist when enable_meta_tool=True"
    )[0m
