[32mimport pytest

from src.agentscope.agent._react_agent import ReactAgent
from src.agentscope.toolkit import Toolkit
from src.agentscope.plan import PlanNotebook


class DummyTool:
    def __init__(self, name):
        self.name = name

    def __call__(self):
        return f"Tool {self.name} called"


class DummyPlanNotebook(PlanNotebook):
    def __init__(self):
        super().__init__(description="Dummy plan notebook")
        self._tools = [DummyTool("tool1"), DummyTool("tool2")]

    def list_tools(self):
        return self._tools


def test_reset_equipped_tools_registration_behavior():
    """
    This test verifies the behavior of ReactAgent initialization regarding
    the registration of the reset_equipped_tools function in the toolkit,
    depending on the enable_meta_tool and plan_notebook parameters.

    Buggy behavior:
        If enable_meta_tool=False and plan_notebook is provided,
        reset_equipped_tools is registered, but no "plan_related" tool group is created,
        which is logically inconsistent.

    Fixed behavior:
        reset_equipped_tools is only registered when enable_meta_tool=True,
        ensuring consistent tool group management.
    """
    plan_notebook = DummyPlanNotebook()

    # Case 1: enable_meta_tool=False, plan_notebook provided
    agent1 = ReactAgent(
        knowledge=None,
        toolkit=Toolkit(),
        enable_meta_tool=False,
        plan_notebook=plan_notebook,
        enable_rewrite_query=False,
        parallel_tool_calls=False,
    )

    # In buggy code, reset_equipped_tools is registered even if enable_meta_tool=False
    # We expect that reset_equipped_tools is NOT registered in this case (fail test if it is)
    registered_functions_1 = agent1.toolkit._registered_tool_functions
    # Check that reset_equipped_tools is NOT registered
    assert agent1.toolkit.reset_equipped_tools not in registered_functions_1, (
        "reset_equipped_tools should NOT be registered when enable_meta_tool=False, "
        "even if plan_notebook is provided"
    )

    # Also check that plan_related tool group does not exist when enable_meta_tool=False
    assert "plan_related" not in agent1.toolkit.tool_groups, (
        "plan_related tool group should NOT be created when enable_meta_tool=False"
    )

    # Case 2: enable_meta_tool=True, plan_notebook provided
    agent2 = ReactAgent(
        knowledge=None,
        toolkit=Toolkit(),
        enable_meta_tool=True,
        plan_notebook=plan_notebook,
        enable_rewrite_query=False,
        parallel_tool_calls=False,
    )

    # In fixed code, reset_equipped_tools is registered only if enable_meta_tool=True
    registered_functions_2 = agent2.toolkit._registered_tool_functions
    assert agent2.toolkit.reset_equipped_tools in registered_functions_2, (
        "reset_equipped_tools should be registered when enable_meta_tool=True"
    )

    # plan_related tool group should exist when enable_meta_tool=True
    assert "plan_related" in agent2.toolkit.tool_groups, (
        "plan_related tool group should be created when enable_meta_tool=True"
    )

    # The plan_related group should contain the tools from plan_notebook
    plan_related_tools = agent2.toolkit.tool_groups["plan_related"].tools
    plan_tools = plan_notebook.list_tools()
    # Check that all plan_notebook tools are registered in plan_related group
    for tool in plan_tools:
        assert tool in plan_related_tools, (
            f"Tool {tool} from plan_notebook should be in plan_related tool group"
        )[0m
