[32mimport pytest
from src.agentscope.agent._react_agent import ReactAgent
from src.agentscope.tool.toolkit import Toolkit


class DummyTool:
    def __init__(self, name):
        self.name = name

    def __call__(self):
        return f"Tool {self.name} called"


class DummyPlanNotebook:
    def __init__(self):
        self.description = "Dummy plan notebook description"
        self._tools = [DummyTool("tool1"), DummyTool("tool2")]

    def list_tools(self):
        return self._tools


def test_reset_equipped_tools_registration_conflict():
    """
    This test verifies that when plan_notebook is provided but enable_meta_tool=False,
    the reset_equipped_tools function is NOT registered as a tool function.

    Buggy behavior: reset_equipped_tools is registered even when enable_meta_tool=False.
    Fixed behavior: reset_equipped_tools is only registered if enable_meta_tool=True.
    """

    plan_notebook = DummyPlanNotebook()

    # Case 1: enable_meta_tool=False, plan_notebook provided
    # In buggy code, reset_equipped_tools is registered; in fixed code, it is not.
    agent = ReactAgent(
        knowledge=None,
        enable_rewrite_query=False,
        enable_meta_tool=False,
        plan_notebook=plan_notebook,
        parallel_tool_calls=False,
    )

    # The reset_equipped_tools method should NOT be registered in toolkit.tool_functions
    # when enable_meta_tool is False.
    registered_functions = agent.toolkit.tool_functions
    reset_func = agent.toolkit.reset_equipped_tools

    # Assert that reset_equipped_tools is NOT registered
    assert reset_func not in registered_functions, (
        "reset_equipped_tools should NOT be registered when enable_meta_tool=False "
        "but plan_notebook is provided."
    )

    # Case 2: enable_meta_tool=True, plan_notebook provided
    # reset_equipped_tools should be registered.
    agent2 = ReactAgent(
        knowledge=None,
        enable_rewrite_query=False,
        enable_meta_tool=True,
        plan_notebook=plan_notebook,
        parallel_tool_calls=False,
    )

    registered_functions2 = agent2.toolkit.tool_functions
    reset_func2 = agent2.toolkit.reset_equipped_tools

    # Assert that reset_equipped_tools IS registered
    assert reset_func2 in registered_functions2, (
        "reset_equipped_tools should be registered when enable_meta_tool=True "
        "and plan_notebook is provided."
    )

    # Additionally, verify that the "plan_related" tool group is created only when enable_meta_tool=True
    # The toolkit has a method or attribute to check groups; if not, check by side effect.

    # For agent with enable_meta_tool=True, "plan_related" group should exist
    assert "plan_related" in agent2.toolkit.tool_groups, (
        '"plan_related" tool group should be created when enable_meta_tool=True.'
    )

    # For agent with enable_meta_tool=False, "plan_related" group should NOT exist
    assert "plan_related" not in agent.toolkit.tool_groups, (
        '"plan_related" tool group should NOT be created when enable_meta_tool=False.'
    )[0m
