[32mimport pytest

from src.agentscope.agent._react_agent import ReactAgent
from src.agentscope.tool.toolkit import Toolkit
from src.agentscope.plan.plan_notebook import PlanNotebook


class DummyTool:
    def __init__(self, name):
        self.name = name

    def __call__(self):
        return f"Tool {self.name} called"


class DummyPlanNotebook:
    description = "Dummy plan notebook"

    def list_tools(self):
        return [DummyTool("tool1"), DummyTool("tool2")]


def test_reset_equipped_tools_registration_behavior():
    """
    This test verifies that when ReactAgent is initialized with plan_notebook set
    but enable_meta_tool=False, the reset_equipped_tools function is NOT registered
    as a tool function. This matches the fixed behavior after patch.

    Before the fix:
      - reset_equipped_tools was registered if plan_notebook was set regardless of enable_meta_tool.
      - This caused a logical conflict because plan_related group was not created if enable_meta_tool=False.

    After the fix:
      - reset_equipped_tools is only registered if enable_meta_tool=True.
      - If enable_meta_tool=False and plan_notebook is set, reset_equipped_tools is NOT registered.
    """

    plan_notebook = DummyPlanNotebook()

    # Case 1: enable_meta_tool=True, plan_notebook set
    agent_with_meta = ReactAgent(
        toolkit=Toolkit(),
        knowledge=None,
        enable_meta_tool=True,
        plan_notebook=plan_notebook,
        enable_rewrite_query=False,
        parallel_tool_calls=False,
    )
    # The reset_equipped_tools function should be registered
    registered_functions = agent_with_meta.toolkit.list_registered_functions()
    found_reset = any(
        func.__name__ == "reset_equipped_tools" for func in registered_functions
    )
    assert found_reset, "reset_equipped_tools should be registered when enable_meta_tool=True"

    # Case 2: enable_meta_tool=False, plan_notebook set
    agent_without_meta = ReactAgent(
        toolkit=Toolkit(),
        knowledge=None,
        enable_meta_tool=False,
        plan_notebook=plan_notebook,
        enable_rewrite_query=False,
        parallel_tool_calls=False,
    )
    # The reset_equipped_tools function should NOT be registered
    registered_functions = agent_without_meta.toolkit.list_registered_functions()
    found_reset = any(
        func.__name__ == "reset_equipped_tools" for func in registered_functions
    )
    assert (
        not found_reset
    ), "reset_equipped_tools should NOT be registered when enable_meta_tool=False but plan_notebook is set"

    # Additionally, check that plan tools are registered in the default group (no group name)
    # when enable_meta_tool=False
    registered_tools = agent_without_meta.toolkit.list_registered_functions()
    tool_names = [func.__name__ for func in registered_tools]
    # The plan_notebook tools should be registered as functions (tool1, tool2)
    # Since DummyTool instances are callable objects, their __call__ method is registered,
    # but toolkit registers the function itself, so check for presence of DummyTool instances
    # We check that the number of registered functions is at least the number of plan_notebook tools
    # plus any other functions
    assert len(registered_tools) >= len(plan_notebook.list_tools()), (
        "Plan notebook tools should be registered when enable_meta_tool=False"
    )[0m
