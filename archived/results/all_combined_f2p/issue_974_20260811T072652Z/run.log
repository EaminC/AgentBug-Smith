[32mimport pytest

from src.agentscope.agent._react_agent import ReactAgent
from src.agentscope.tool.toolkit import Toolkit
from src.agentscope.plan.plan_notebook import PlanNotebook


class DummyTool:
    def __init__(self, name):
        self.name = name

    def __call__(self):
        return f"Tool {self.name} called"


class DummyPlanNotebook(PlanNotebook):
    def __init__(self):
        super().__init__(description="Dummy plan notebook")
        self._tools = [DummyTool("A"), DummyTool("B")]

    def list_tools(self):
        return self._tools


def test_reset_equipped_tools_registration_behavior():
    """
    This test verifies that when ReactAgent is initialized with plan_notebook set but enable_meta_tool=False,
    the reset_equipped_tools tool function is NOT registered.

    Before the fix, reset_equipped_tools was registered even if enable_meta_tool=False, which is incorrect.

    After the fix, reset_equipped_tools is only registered if enable_meta_tool=True.
    """

    plan_notebook = DummyPlanNotebook()
    toolkit = Toolkit()

    # Case 1: enable_meta_tool=False, plan_notebook provided
    agent = ReactAgent(
        toolkit=toolkit,
        knowledge=None,
        enable_meta_tool=False,
        plan_notebook=plan_notebook,
        enable_rewrite_query=False,
        parallel_tool_calls=False,
    )

    # The reset_equipped_tools should NOT be registered because enable_meta_tool is False
    registered_funcs = [func for func in toolkit._tool_functions]
    # The buggy code registers reset_equipped_tools here, so this should fail on buggy code
    assert toolkit.reset_equipped_tools not in registered_funcs, (
        "reset_equipped_tools should NOT be registered when enable_meta_tool is False"
    )

    # Case 2: enable_meta_tool=True, plan_notebook provided
    toolkit2 = Toolkit()
    agent2 = ReactAgent(
        toolkit=toolkit2,
        knowledge=None,
        enable_meta_tool=True,
        plan_notebook=plan_notebook,
        enable_rewrite_query=False,
        parallel_tool_calls=False,
    )

    # The reset_equipped_tools should be registered because enable_meta_tool is True
    registered_funcs2 = [func for func in toolkit2._tool_functions]
    assert toolkit2.reset_equipped_tools in registered_funcs2, (
        "reset_equipped_tools should be registered when enable_meta_tool is True"
    )

    # Also check that plan_related group is created only when enable_meta_tool=True
    assert "plan_related" in toolkit2._tool_groups, (
        "plan_related group should be created when enable_meta_tool is True"
    )
    assert "plan_related" not in toolkit._tool_groups, (
        "plan_related group should NOT be created when enable_meta_tool is False"
    )[0m
