[32mimport pytest
from datetime import timedelta
from strands.tools.mcp import MCPClient
from mcp.client.stdio import stdio_client, StdioServerParameters


@pytest.mark.skip(reason="Requires 'uv' command and environment; integration test for bug #1221")
def test_mcp_client_connection_stability_with_client_timeout():
    """
    Integration test to verify MCPClient connection remains stable when multiple tool calls timeout quickly.

    This test reproduces the bug where MCPClient connection would collapse when tool responses arrive after client-side timeout.
    It makes multiple calls with a very small timeout to trigger "unknown request id" errors and verifies that the connection
    does not collapse and subsequent calls succeed.

    This test requires the 'uv' command line tool and the ability to run subprocesses, so it is skipped by default.
    """

    SERVER_CODE = '''#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["fastmcp", "strands-agents"]
# ///

import asyncio
from fastmcp import FastMCP

mcp = FastMCP("test-server")

@mcp.tool()
async def slow_tool() -> str:
    """A tool that takes 3 seconds"""
    await asyncio.sleep(3)
    return "completed"

if __name__ == "__main__":
    mcp.run()
'''

    import tempfile
    import os

    # Write the server code to a temporary file
    with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False) as f:
        f.write(SERVER_CODE)
        server_path = f.name

    client = MCPClient(
        lambda: stdio_client(StdioServerParameters(
            command="uv",
            args=["run", "--script", server_path]
        ))
    )

    with client:
        # Make multiple calls with very small timeout to trigger "unknown request id" errors
        for i in range(3):
            try:
                result = client.call_tool_sync(
                    tool_use_id=f"test_{i}",
                    name="slow_tool",
                    arguments={},
                    read_timeout_seconds=timedelta(milliseconds=10),  # Very small timeout to force timeout
                )
            except Exception:
                pass  # Ignore exceptions, we're testing connection stability

        # Verify connection is still alive by making a successful call with a longer timeout
        result = client.call_tool_sync(
            tool_use_id="final_test", name="slow_tool", arguments={}, read_timeout_seconds=timedelta(seconds=5)
        )
        assert result["status"] == "success"
        assert result["content"][0]["text"] == "completed"

    # Clean up temporary server file
    os.unlink(server_path)[0m
