import os
import tempfile
from datetime import timedelta

import pytest
from mcp.client.stdio import StdioServerParameters, stdio_client

from strands.tools.mcp import MCPClient


SERVER_CODE = '''#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["fastmcp"]
# ///
import asyncio
from fastmcp import FastMCP

mcp = FastMCP("test-server")

@mcp.tool()
async def slow_tool() -> str:
    """A tool that takes 3 seconds"""
    await asyncio.sleep(3)
    return "completed"

if __name__ == "__main__":
    mcp.run()
'''


@pytest.mark.asyncio
async def test_mcp_client_connection_stability_with_client_timeout():
    """
    Integration test to verify that MCPClient connection remains stable when tool calls timeout.

    This test reproduces the issue where a tool call times out on the client side,
    but the server responds later, causing the client to receive a response with an unknown request ID.
    The fix ensures that such non-fatal errors do not cause connection collapse.

    Steps:
    - Start a subprocess MCP server that has a slow tool (3 seconds).
    - Create MCPClient using stdio_client to connect to the server.
    - Make multiple calls with a very small timeout (1 second) to trigger client-side timeouts.
    - Verify that the client does not raise fatal exceptions and connection remains alive.
    - Make a final successful call to confirm connection stability.
    """
    with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False) as f:
        f.write(SERVER_CODE)
        server_script_path = f.name

    client = MCPClient(
        lambda: stdio_client(
            StdioServerParameters(
                command="uv",
                args=["run", "--script", server_script_path],
            )
        )
    )

    try:
        with client:
            # Make several calls with very small timeout to trigger timeouts and orphaned responses
            for i in range(3):
                try:
                    client.call_tool_sync(
                        tool_use_id=f"test_{i}",
                        name="slow_tool",
                        arguments={},
                        read_timeout_seconds=timedelta(seconds=1),
                    )
                except Exception as e:
                    # We expect timeouts or errors, but connection should remain alive
                    assert isinstance(e, (TimeoutError, RuntimeError)) or "unknown request id" in str(e).lower()

            # Final call with sufficient timeout to verify connection is still alive
            result = client.call_tool_sync(
                tool_use_id="final_test",
                name="slow_tool",
                arguments={},
                read_timeout_seconds=timedelta(seconds=5),
            )
            assert result["status"] == "success"
            assert "completed" in "".join(block.get("text", "") for block in result["content"])

    finally:
        os.unlink(server_script_path)[0m
