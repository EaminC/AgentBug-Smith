[32mimport asyncio
import os
import tempfile
from datetime import timedelta

import pytest
from mcp.client.stdio import StdioServerParameters, stdio_client

from strands.tools.mcp import MCPClient


SERVER_CODE = '''#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["fastmcp"]
# ///
import asyncio
from fastmcp import FastMCP

mcp = FastMCP("test-server")

@mcp.tool()
async def slow_tool() -> str:
    """A tool that takes 3 seconds"""
    await asyncio.sleep(3)
    return "completed"

if __name__ == "__main__":
    mcp.run()
'''


@pytest.mark.asyncio
async def test_mcp_client_connection_stability_with_client_timeout():
    """
    Integration test to verify that MCPClient connection remains stable when multiple calls timeout.

    This test reproduces the issue where a tool call times out on the client side but the server
    eventually sends a response, causing the client to receive a response with an unknown request ID.
    The fix ensures that such non-fatal errors do not cause the MCPClient connection to collapse,
    allowing subsequent calls to succeed.

    Steps:
    1. Start a MCPClient connected to a slow tool server.
    2. Make multiple calls with a very small timeout to trigger client-side timeouts.
    3. Verify that the client logs non-fatal errors but does not raise exceptions.
    4. Verify that a subsequent call succeeds, demonstrating connection stability.
    """
    # Write the server code to a temporary file
    with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False) as f:
        server_path = f.name
        f.write(SERVER_CODE)

    client = MCPClient(
        lambda: stdio_client(
            StdioServerParameters(
                command="uv",
                args=["run", "--script", server_path],
            )
        )
    )

    try:
        with client:
            # Spy on the logger to capture non-fatal error messages
            # We patch the client's _log_debug_with_thread method to detect logs
            # We do not use unittest.mock.patch to avoid mocking the tested method itself
            # Instead, we monkeypatch manually

            original_log_debug = client._log_debug_with_thread
            logs = []

            def log_debug_capture(msg, *args, **kwargs):
                logs.append(msg % args if args else msg)
                return original_log_debug(msg, *args, **kwargs)

            client._log_debug_with_thread = log_debug_capture

            # Make multiple calls with very small timeout to trigger "unknown request id" errors
            for i in range(3):
                try:
                    result = client.call_tool_sync(
                        tool_use_id=f"test_{i}",
                        name="slow_tool",
                        arguments={},
                        read_timeout_seconds=timedelta(milliseconds=1),  # Very small timeout to force timeout
                    )
                except Exception:
                    # We expect exceptions due to timeout; ignore them here
                    pass

            # Verify connection is still alive by making a successful call with sufficient timeout
            result = client.call_tool_sync(
                tool_use_id="final_test", name="slow_tool", arguments={}, read_timeout_seconds=timedelta(seconds=5)
            )
            assert result["status"] == "success"
            assert result["content"][0]["text"] == "completed"

            # Verify that non-fatal error messages were logged
            assert any("ignoring non-fatal MCP session error" in log for log in logs)
    finally:
        try:
            os.unlink(server_path)
        except Exception:
            pass[0m
