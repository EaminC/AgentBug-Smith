    usage_next = ai_instance.token_usage_log[1]
    assert usage_next.step_name == step_name_next
    # Cumulative totals should be sums of previous plus current
    assert usage_next.total_prompt_tokens >= usage_start.total_prompt_tokens
    assert usage_next.total_completion_tokens >= usage_start.total_completion_tokens
