[32mimport pytest
from gpt_engineer import ai


def test_token_usage_logging_and_formatting():
    # Create AI instance with a dummy model name that triggers fallback tokenizer
    model_name = "nonexistent-model-for-testing"
    ai_instance = ai.AI(model=model_name)

    # Start a conversation with step_name
    system_prompt = "System prompt for testing."
    user_prompt = "User prompt for testing."
    step_name_1 = "start_step"
    messages = ai_instance.start(system_prompt, user_prompt, step_name=step_name_1)

    # Check that token usage log has one entry after start
    assert len(ai_instance.token_usage_log) == 1
    usage_1 = ai_instance.token_usage_log[0]
    assert usage_1.step_name == step_name_1
    # Tokens counts should be positive integers
    assert usage_1.in_step_prompt_tokens > 0
    assert usage_1.in_step_completion_tokens >= 0
    assert usage_1.in_step_total_tokens == usage_1.in_step_prompt_tokens + usage_1.in_step_completion_tokens
    assert usage_1.total_prompt_tokens == usage_1.in_step_prompt_tokens
    assert usage_1.total_completion_tokens == usage_1.in_step_completion_tokens
    assert usage_1.total_tokens == usage_1.in_step_total_tokens

    # Call next with additional prompt and step_name
    prompt_2 = "Additional prompt for next call."
    step_name_2 = "next_step"
    messages = ai_instance.next(messages, prompt_2, step_name=step_name_2)

    # Token usage log should have two entries now
    assert len(ai_instance.token_usage_log) == 2
    usage_2 = ai_instance.token_usage_log[1]
    assert usage_2.step_name == step_name_2
    # Tokens counts should be positive integers and cumulative totals should increase
    assert usage_2.in_step_prompt_tokens > 0
    assert usage_2.in_step_completion_tokens >= 0
    assert usage_2.in_step_total_tokens == usage_2.in_step_prompt_tokens + usage_2.in_step_completion_tokens
    assert usage_2.total_prompt_tokens >= usage_1.total_prompt_tokens
    assert usage_2.total_completion_tokens >= usage_1.total_completion_tokens
    assert usage_2.total_tokens >= usage_1.total_tokens

    # The cumulative totals in usage_2 should be sums of usage_1 and usage_2 in-step tokens
    assert usage_2.total_prompt_tokens == usage_1.total_prompt_tokens + usage_2.in_step_prompt_tokens
    assert usage_2.total_completion_tokens == usage_1.total_completion_tokens + usage_2.in_step_completion_tokens
    assert usage_2.total_tokens == usage_1.total_tokens + usage_2.in_step_total_tokens

    # Test formatting of token usage log
    formatted_log = ai_instance.format_token_usage_log()
    # The formatted log should be a string containing CSV headers and at least two lines of data
    assert isinstance(formatted_log, str)
    lines = formatted_log.strip().split("\n")
    assert lines[0].startswith("step_name,")
    # There should be header + 2 lines for two steps
    assert len(lines) == 3
    # Each line after header should contain the step_name and token counts separated by commas
    for line, usage in zip(lines[1:], ai_instance.token_usage_log):
        parts = line.split(",")
        assert parts[0] == usage.step_name
        # Check that token counts are integers and match the logged values
        assert int(parts[1]) == usage.in_step_prompt_tokens
        assert int(parts[2]) == usage.in_step_completion_tokens
        assert int(parts[3]) == usage.in_step_total_tokens
        assert int(parts[4]) == usage.total_prompt_tokens
        assert int(parts[5]) == usage.total_completion_tokens
        assert int(parts[6]) == usage.total_tokens

    # Test num_tokens and num_tokens_from_messages consistency
    text = "Hello, world!"
    num_tokens_text = ai_instance.num_tokens(text)
    # num_tokens_from_messages should count tokens for messages including roles and content
    messages_for_count = [
        {"role": "system", "content": "System message"},
        {"role": "user", "content": text},
    ]
    num_tokens_messages = ai_instance.num_tokens_from_messages(messages_for_count)
    # num_tokens_messages should be at least sum of num_tokens of each content plus overhead tokens
    total_content_tokens = sum(ai_instance.num_tokens(m["content"]) for m in messages_for_count)
    # Overhead tokens are fixed per message and reply
    overhead_tokens = 4 * len(messages_for_count) + 2
    assert num_tokens_messages == total_content_tokens + overhead_tokens

    # num_tokens should return positive integer for non-empty string
    assert num_tokens_text > 0


def test_token_usage_log_accumulates_correctly():
    ai_instance = ai.AI(model="gpt-4")
    # Simulate multiple steps with dummy messages and answers
    steps = [
        ("step1", "Hello world!"),
        ("step2", "Another answer."),
        ("step3", "Final answer."),
    ]
    messages = [
        {"role": "system", "content": "System prompt"},
        {"role": "user", "content": "User prompt"},
    ]
    for step_name, answer in steps:
        # Update token usage log manually using the method
        ai_instance.update_token_usage_log(messages, answer, step_name)
        # Append assistant message to messages to simulate conversation
        messages.append({"role": "assistant", "content": answer})

    # Check that token usage log length matches number of steps
    assert len(ai_instance.token_usage_log) == len(steps)

    # Check cumulative totals increase correctly
    cumulative_prompt = 0
    cumulative_completion = 0
    cumulative_total = 0
    for usage, (_, answer) in zip(ai_instance.token_usage_log, steps):
        prompt_tokens = usage.in_step_prompt_tokens
        completion_tokens = usage.in_step_completion_tokens
        total_tokens = usage.in_step_total_tokens
        cumulative_prompt += prompt_tokens
        cumulative_completion += completion_tokens
        cumulative_total += total_tokens
        assert usage.total_prompt_tokens == cumulative_prompt
        assert usage.total_completion_tokens == cumulative_completion
        assert usage.total_tokens == cumulative_total
        # Total tokens equal prompt + completion tokens
        assert total_tokens == prompt_tokens + completion_tokens
        # Completion tokens equal tokens in answer
        assert completion_tokens == ai_instance.num_tokens(answer)


def test_start_and_next_methods_token_usage_integration():
