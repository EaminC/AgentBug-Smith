import pytest
from agent.function.search_agent import SearchAgent
from agent.utils import config


def test_search_agent_missing_search_engine_key(monkeypatch):
    """
    Regression test for KeyError when 'search_engine' is missing from config.
    
    Issue: Config without 'search_engine' field caused KeyError in SearchAgent.__init__
    Fix: Use .get() method with None check instead of direct dict access.
    """
    # Simulate config without 'search_engine' key
    def mock_config_read():
        return {
            'general': {
                'other_setting': 'value'
                # Note: 'search_engine' key is intentionally omitted
            }
        }
    
    monkeypatch.setattr(config, 'read', mock_config_read)
    
    # Buggy behavior: raises KeyError: 'search_engine'
    # Fixed behavior: handles gracefully, sets engine_name to None and returns early
    try:
        agent = SearchAgent(enable_web_search=True)
    except KeyError as exc:
        if 'search_engine' in str(exc):
            pytest.fail(f"SearchAgent raised KeyError for missing 'search_engine' config: {exc}")
        raise
    
    # Verify graceful handling: engine_name should be None when config key is missing
    assert agent.engine_name is None, "engine_name should be None when search_engine config is missing"[0m
