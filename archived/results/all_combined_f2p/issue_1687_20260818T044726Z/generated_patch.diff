+import inspect
+import asyncio
+import threading
+from strands.plugins import Plugin
+
+class SyncPlugin:
+    def __init__(self):
+        self.initialized = False
+    def init_plugin(self, agent):
+        self.initialized = True
+        agent.add_hook(lambda e: None)
+
+class AsyncPlugin:
+    def __init__(self):
+        self.initialized = False
+    async def init_plugin(self, agent):
+        await asyncio.sleep(0.01)
+        self.initialized = True
+        agent.add_hook(lambda e: None)
+
+
+def test_sync_plugin_init():
+    plugin = SyncPlugin()
+    agent = Agent(plugins=[plugin])
+    assert plugin.initialized
+
+def test_async_plugin_init():
+    plugin = AsyncPlugin()
+    agent = Agent(plugins=[plugin])
+    # Since init_plugin is async, it should be awaited before returning from init
+    assert plugin.initialized
+
+def test_multiple_plugins():
+    plugin1 = SyncPlugin()
+    plugin2 = AsyncPlugin()
+    agent = Agent(plugins=[plugin1, plugin2])
+    assert plugin1.initialized
+    assert plugin2.initialized
+
+def test_none_plugins():
+    agent = Agent(plugins=None)
+    assert agent is not None
+
+def test_empty_plugins():
+    agent = Agent(plugins=[])
+    assert agent is not None
