        lines = formatted.strip().split('\n')
        # Should have two lines: one read-only, one editable.
        assert len(lines) == 2
        # First line should be read-only.
        assert lines[0].startswith(" R ")
        # Second line should be editable (three spaces).
        assert lines[1].startswith("   ")
        # Ensure the read-only file appears only once.
        # Count occurrences of "file.py (dir1)" in the formatted string.
        # There should be exactly one.
        count = formatted.count("file.py (dir1)")
        assert count == 1

        # Additional edge case: same file name in same directory (should not happen, but ensure no crash)
        rel_fnames_same = [str(Path("dir1/file.py")), str(Path("dir1/other.py"))]
        minimal_ids = io.compute_minimal_fileids(rel_fnames_same)
        assert minimal_ids[rel_fnames_same[0]] == "file.py"
        assert minimal_ids[rel_fnames_same[1]] == "other.py"

        # Test that the prompt method uses the new formatting.
        # We'll mock the internal call to format_files_for_input by checking that
