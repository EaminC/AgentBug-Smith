        with tempfile.TemporaryDirectory() as tmpdir:
            root = Path(tmpdir)
            # Create some dummy files
            f1 = root / "dir1" / "file.py"
            f2 = root / "dir2" / "file.py"
            f1.parent.mkdir(parents=True, exist_ok=True)
            f2.parent.mkdir(parents=True, exist_ok=True)
            f1.touch()
            f2.touch()
    
            io = InputOutput()
            io.root = root
    
