def test_format_files_for_input_with_duplicate_names():
    with tempfile.TemporaryDirectory() as tmpdir:
        root = Path(tmpdir)
        # Create files with same name in nested directories.
        f1 = root / "a" / "b" / "c" / "file.py"
        f2 = root / "a" / "b" / "d" / "file.py"
        f1.parent.mkdir(parents=True, exist_ok=True)
        f2.parent.mkdir(parents=True, exist_ok=True)
        f1.touch()
        f2.touch()

        io = InputOutput()
        io.root = root

        rel_fnames = [
            str(Path("a/b/c/file.py")),
            str(Path("a/b/d/file.py"))
        ]
        try:
            minimal_ids = io.compute_minimal_fileids(rel_fnames)
        except AttributeError:
            # Buggy version: missing method -> test fails
            raise
        # Shared prefix is "a/b", so minimal unique IDs should be "c/file.py" and "d/file.py".
        assert minimal_ids["a/b/c/file.py"] == "c/file.py"
        assert minimal_ids["a/b/d/file.py"] == "d/file.py"

        formatted = io.format_files_for_input(rel_fnames, [])
        lines = formatted.strip().split('\n')
        assert len(lines) == 2
        # Format should be "   file.py (c)" and "   file.py (d)".
        assert lines[0] == "   file.py (c)"
        assert lines[1] == "   file.py (d)"


