        formatted = io.format_files_for_input(rel_fnames, [])
        # Should list both files as editable (no " R " prefix)
        lines = formatted.strip().split('\n')
        assert len(lines) == 2
        assert all(not line.startswith(" R ") for line in lines)
        # The formatting includes three spaces before the filename for editable files.
        assert "   file.py (dir1)" in formatted
        assert "   file.py (dir2)" in formatted

        # Now test with one file marked as read-only.
        # In the buggy version, the read-only file would still appear in the editable list
        # because the old code didn't filter. The new method should filter it out.
        read_only = [rel_fnames[0]]
        formatted = io.format_files_for_input(rel_fnames, read_only)
        lines = formatted.strip().split('\n')
        # Should have two lines: one read-only, one editable.
        assert len(lines) == 2
        # First line should be read-only.
        assert lines[0].startswith(" R ")
        # Second line should be editable (three spaces).
        assert lines[1].startswith("   ")
        # Ensure the read-only file appears only once (in the read-only section).
        # The editable section should not contain the same file.
        assert "file.py (dir1)" in lines[0]
        assert "file.py (dir2)" in lines[1][0m
