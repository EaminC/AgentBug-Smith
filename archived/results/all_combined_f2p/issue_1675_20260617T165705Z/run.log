[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Copy the entire repository
COPY . .

# Upgrade packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Check for src/ layout to avoid duplicate module loading
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." . 2>/dev/null; then \
    echo "src layout detected, skipping editable install, setting PYTHONPATH"; \
    export PYTHONPATH=/app; \
    pip install -r requirements.txt && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
    pip install -r requirements.txt && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command (required by test harness)
CMD ["/bin/bash"]

# Multi-stage: production image
FROM python:3.12-slim AS production

WORKDIR /app

# Copy only the necessary files from test_builder (site-packages)
COPY --from=test_builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=test_builder /usr/local/bin /usr/local/bin

# Copy the aider package source (if needed) - but for production we just need the installed package
# The package is already installed in the test_builder stage and copied via site-packages.

# Set Forge environment variables (same as above)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Ensure the entrypoint is the aider CLI (from pyproject.toml: aider = "aider.main:main")
ENTRYPOINT ["aider"][0m
