        # Actually compute_minimal_fileids returns a relative path from the shared prefix.
        # For dir1/file.py and dir2/file.py, shared prefix is empty, so minimal ids are the full relative paths.
        assert minimal_ids[rel_fnames[0]] == "dir1/file.py"
        assert minimal_ids[rel_fnames[1]] == "dir2/file.py"

