    "setuptools<=81.0.0" litellm mem0ai && \
    pip install -e .

# Install dev dependencies for comprehensive testing
RUN if [ -f "requirements/requirements-dev.txt" ]; then \
    pip install -r requirements/requirements-dev.txt; \
    fi

