ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

WORKDIR /app

# Install system dependencies for Python packages and standalone script execution
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    gcc \
    pkg-config \
    libffi-dev \
