def test_context_passed_when_context_explicitly_empty():
    """
    Test that when a task is created with context=[], it does NOT receive context from previous tasks.
    This test reproduces the bug described in issue #2789.
    """

    # Create three agents (can be the same agent reused)
    agent = Agent(
        role="Test Agent",
        goal="Test goal",
        backstory="Test backstory",
        allow_delegation=False,
    )

    # Create three tasks:
    # - task1 and task2 are normal tasks
    # - task3 explicitly sets context=[] (empty list), so it should NOT get context from previous tasks
    task1 = Task(
        description="Task 1 description",
        expected_output="Task 1 output",
        agent=agent,
    )
    task2 = Task(
        description="Task 2 description",
        expected_output="Task 2 output",
        agent=agent,
    )
    task3 = Task(
        description="Task 3 description",
        expected_output="Task 3 output",
        agent=agent,
        context=[],
    )

    # Create a crew with these tasks in sequence
    crew = Crew(
        agents=[agent],
        tasks=[task1, task2, task3],
        process="sequential",
    )

    # Patch the execute_sync method of Task to capture the context passed to task3
    # We want to verify that task3's context is empty string (no context)
    # We will let the real execute_sync run for task1 and task2 to generate outputs

    # Run the crew kickoff to execute all tasks
    # We will check the context passed to task3 by inspecting its prompt_context attribute after execution

    result = crew.kickoff()

    # After kickoff, task3.output should be set
    assert task3.output is not None

    # The prompt_context attribute of task3 should be empty string or equivalent (no context)
    # Because context=[] means no context should be passed
    # If the bug is present, prompt_context would include outputs from task1 and task2
    # So we assert that prompt_context is empty or only whitespace

    prompt_context = getattr(task3, "prompt_context", None)
    # prompt_context might be None or empty string if no context was passed
    # Accept None or empty string as no context
    assert prompt_context in (None, "", " "), "Task 3 prompt_context should be empty when context=[]"

