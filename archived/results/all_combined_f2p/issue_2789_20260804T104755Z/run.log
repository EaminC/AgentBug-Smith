    # We expect the output to be related only to task3's description (or mock output)
    # Since the LLM call is real, just check that output does not contain task1 or task2 description or output

    if task3.output and task3.output.raw:
        output_raw = task3.output.raw
        # It should NOT contain task1 or task2 descriptions or outputs
        assert "Task 1 description" not in output_raw
        assert "Task 2 description" not in output_raw
        assert "Task 1 output" not in output_raw
        assert "Task 2 output" not in output_raw[0m
