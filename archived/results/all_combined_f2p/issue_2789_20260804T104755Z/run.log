[32mfrom crewai.agent import Agent
from crewai.crew import Crew
from crewai.task import Task
from crewai.tasks.task_output import TaskOutput
from crewai.process import Process
from unittest.mock import patch, ANY
import pytest


def test_context_passed_when_context_explicitly_empty():
    """
    Test that when a task is created with context=[] explicitly,
    it does NOT receive context from previous tasks.

    This test reproduces the bug described in issue #2789:
    - Create a sequential crew with 3 tasks.
    - The third task has context=[] explicitly.
    - Before the fix, the third task would receive context from previous tasks.
    - After the fix, the third task's context should be empty (no previous outputs included).
    """

    # Create an agent
    agent = Agent(
        role="Test Agent",
        goal="Test goal",
        backstory="Test backstory",
        allow_delegation=False,
    )

    # Create three tasks
    task1 = Task(
        description="Task 1 description",
        expected_output="Output 1",
        agent=agent,
    )
    task2 = Task(
        description="Task 2 description",
        expected_output="Output 2",
        agent=agent,
    )
    # Third task explicitly sets context to empty list
    task3 = Task(
        description="Task 3 description",
        expected_output="Output 3",
        agent=agent,
        context=[],
    )

    # Build a sequential crew with these tasks
    crew = Crew(
        agents=[agent],
        tasks=[task1, task2, task3],
        process=Process.sequential,
    )

    # Patch Task.execute_sync to capture the context passed to the third task
    original_execute_sync = Task.execute_sync

    contexts_passed = {}

    def capture_execute_sync(self, context=None, tools=None, **kwargs):
        # Record the context passed for each task by description
        contexts_passed[self.description] = context
        # Call the original method to keep normal behavior
        return original_execute_sync(self, context=context, tools=tools, **kwargs)

    with patch.object(Task, "execute_sync", new=capture_execute_sync):
        crew.kickoff()

    # The first and second tasks should have context as empty string (default)
    assert contexts_passed.get("Task 1 description") == ""
    assert contexts_passed.get("Task 2 description") != ""  # task2 context is default (previous outputs)
    # The third task's context should be empty string because context=[] means no context
    # The bug was that it was receiving previous tasks' outputs as context, which is wrong
    assert contexts_passed.get("Task 3 description") == "", (
        "Task 3 should have empty context string when context=[] explicitly set"
    )[0m
