[32mfrom unittest.mock import patch

import pytest

from crewai.agent import Agent
from crewai.crew import Crew
from crewai.task import Task
from crewai.tasks.task_output import TaskOutput


@pytest.mark.vcr(filter_headers=["authorization"])
def test_context_passed_when_context_explicitly_empty():
    """
    Test that when a task has context explicitly set to an empty list,
    no context from previous tasks is passed.
    This should fail on the buggy codebase (context from previous tasks is passed),
    and pass after the fix (no context is passed).
    """
    researcher = Agent(
        role="Researcher",
        goal="Make the best research and analysis on content about AI and AI agents",
        backstory="You're an expert researcher, specialized in technology, software engineering, AI and startups. You work as a freelancer and is now working on doing research and analysis for a new customer.",
        allow_delegation=False,
    )

    writer = Agent(
        role="Senior Writer",
        goal="Write the best content about AI and AI agents.",
        backstory="You're a senior writer, specialized in technology, software engineering, AI and startups. You work as a freelancer and is now working on writing content for a new customer.",
        allow_delegation=False,
    )

    # Create three tasks, third task has context=[]
    task1 = Task(
        description="Generate a list of 5 interesting ideas to explore for an article.",
        expected_output="Bullet point list of 5 important events.",
        agent=researcher,
    )
    task2 = Task(
        description="Research the history of AI and give me the 5 most important events.",
        expected_output="Bullet point list of 5 important events.",
        agent=researcher,
    )
    task3 = Task(
        description="Write an article about the history of AI and its most important events.",
        expected_output="A 4 paragraph article about AI.",
        agent=writer,
        context=[],
    )

    crew = Crew(
        agents=[researcher, writer],
        process="sequential",
        tasks=[task1, task2, task3],
    )

    # Patch Task.execute_sync to capture the context argument passed to the third task
    with patch.object(Task, "execute_sync", wraps=Task.execute_sync) as mock_execute_sync:
        crew.kickoff()

        # Find the call corresponding to task3
        call_args_list = mock_execute_sync.call_args_list
        # The last call should be for task3
        last_call = call_args_list[-1]
        # Extract context argument
        context_passed = last_call.kwargs.get("context", None)

        # The context passed to task3 should be empty string or empty (no context from previous tasks)
        # On buggy codebase, context_passed will be non-empty string containing previous tasks outputs
        # On fixed codebase, context_passed should be empty string
        assert context_passed == "", "Context was passed to task3 despite context=[]"


@pytest.mark.vcr(filter_headers=["authorization"])
def test_context_passed_when_context_none_or_not_specified():
    """
    Test that when a task has context set to None or not specified,
    context from previous tasks is passed.
    This should fail on the buggy codebase (context always passed),
    and pass after the fix (context passed only when context is None or NOT_SPECIFIED).
    """
    researcher = Agent(
        role="Researcher",
        goal="Make the best research and analysis on content about AI and AI agents",
        backstory="You're an expert researcher, specialized in technology, software engineering, AI and startups. You work as a freelancer and is now working on doing research and analysis for a new customer.",
        allow_delegation=False,
    )

    writer = Agent(
        role="Senior Writer",
        goal="Write the best content about AI and AI agents.",
        backstory="You're a senior writer, specialized in technology, software engineering, AI and AI startups. You work as a freelancer and is now working on writing content for a new customer.",
        allow_delegation=False,
    )

    # Create three tasks, third task has context=None (default)
    task1 = Task(
        description="Generate a list of 5 interesting ideas to explore for an article.",
        expected_output="Bullet point list of 5 important events.",
        agent=researcher,
    )
    task2 = Task(
        description="Research the history of AI and give me the 5 most important events.",
        expected_output="Bullet point list of 5 important events.",
        agent=researcher,
    )
    task3 = Task(
        description="Write an article about the history of AI and its most important events.",
        expected_output="A 4 paragraph article about AI.",
        agent=writer,
        context=None,  # Explicit None
    )

    crew = Crew(
        agents=[researcher, writer],
        process="sequential",
        tasks=[task1, task2, task3],
    )

    # Patch Task.execute_sync to capture the context argument passed to the third task
    with patch.object(Task, "execute_sync", wraps=Task.execute_sync) as mock_execute_sync:
        crew.kickoff()

        # Find the call corresponding to task3
        call_args_list = mock_execute_sync.call_args_list
        # The last call should be for task3
        last_call = call_args_list[-1]
        # Extract context argument
        context_passed = last_call.kwargs.get("context", None)

        # The context passed to task3 should be a non-empty string containing previous tasks outputs
        # On buggy codebase, context always passed, so this test passes
        # On fixed codebase, context passed only when context is None or NOT_SPECIFIED, so this test passes
        assert isinstance(context_passed, str)
        assert len(context_passed) > 0, "Context was not passed to task3 when context=None"


    # Now test with context not specified (default)
    task3_default_context = Task(
        description="Write an article about the history of AI and its most important events.",
        expected_output="A 4 paragraph article about AI.",
        agent=writer,
        # context not set, should be NOT_SPECIFIED internally
    )

    crew2 = Crew(
        agents=[researcher, writer],
        process="sequential",
        tasks=[task1, task2, task3_default_context],
    )

    with patch.object(Task, "execute_sync", wraps=Task.execute_sync) as mock_execute_sync2:
        crew2.kickoff()

        call_args_list = mock_execute_sync2.call_args_list
        last_call = call_args_list[-1]
        context_passed = last_call.kwargs.get("context", None)

        assert isinstance(context_passed, str)
        assert len(context_passed) > 0, "Context was not passed to task3 when context not specified"[0m
