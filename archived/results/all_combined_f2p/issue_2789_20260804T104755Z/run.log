[32mfrom crewai.agent import Agent
from crewai.crew import Crew
from crewai.task import Task
from crewai.tasks.task_output import TaskOutput
from crewai.crews.crew_output import CrewOutput
from crewai.process import Process
from unittest.mock import patch, ANY


def test_context_passed_when_context_explicitly_empty():
    """
    Test that a Task with context=[] does NOT receive context string from previous tasks.
    This test reproduces the bug described in issue #2789.
    """

    # Create three agents
    agent1 = Agent(
        role="Agent 1",
        goal="Goal 1",
        backstory="Backstory 1",
        allow_delegation=False,
    )
    agent2 = Agent(
        role="Agent 2",
        goal="Goal 2",
        backstory="Backstory 2",
        allow_delegation=False,
    )
    agent3 = Agent(
        role="Agent 3",
        goal="Goal 3",
        backstory="Backstory 3",
        allow_delegation=False,
    )

    # Create three tasks
    task1 = Task(
        description="Task 1 description",
        expected_output="Output 1",
        agent=agent1,
    )
    task2 = Task(
        description="Task 2 description",
        expected_output="Output 2",
        agent=agent2,
        context=[task1],
    )
    # Third task explicitly sets context to empty list
    task3 = Task(
        description="Task 3 description",
        expected_output="Output 3",
        agent=agent3,
        context=[],
    )

    # Create a crew with sequential process
    crew = Crew(
        agents=[agent1, agent2, agent3],
        tasks=[task1, task2, task3],
        process=Process.sequential,
    )

    # Patch Task.execute_sync to capture the context argument passed to task3 execution
    original_execute_sync = Task.execute_sync

    contexts_passed = []

    def capture_context(self, context=None, tools=None, **kwargs):
        if self == task3:
            # Record the context string passed to task3
            contexts_passed.append(context)
        return original_execute_sync(self, context=context, tools=tools, **kwargs)

    with patch.object(Task, "execute_sync", new=capture_context):
        result = crew.kickoff()

    # Assert that the context passed to task3 is empty string (no previous tasks output)
    # Buggy behavior: context passed is non-empty string containing previous tasks output
    # Fixed behavior: context passed is empty string
    assert len(contexts_passed) == 1, "Task 3 execute_sync was not called exactly once"
    context_passed_to_task3 = contexts_passed[0]
    assert context_passed_to_task3 == "", (
        "Expected empty context string for task with context=[], "
        "but got non-empty context."
    )

    # Also verify that the final output is a CrewOutput and contains outputs for all tasks
    assert isinstance(result, CrewOutput)
    assert len(result.tasks_output) == 3
    # The last task output should correspond to task3
    assert result.tasks_output[-1].description == "Task 3 description"


def test_context_passed_when_context_none_or_not_specified():
    """
    Test that a Task with context=None or context=NOT_SPECIFIED receives context string from previous tasks.
    This complements the test for explicit empty list context.
    """

    agent1 = Agent(
        role="Agent 1",
        goal="Goal 1",
        backstory="Backstory 1",
        allow_delegation=False,
    )
    agent2 = Agent(
        role="Agent 2",
        goal="Goal 2",
        backstory="Backstory 2",
        allow_delegation=False,
    )

    task1 = Task(
        description="Task 1 description",
        expected_output="Output 1",
        agent=agent1,
    )
    # context is None (default)
    task2 = Task(
        description="Task 2 description",
        expected_output="Output 2",
        agent=agent2,
    )

    crew = Crew(
        agents=[agent1, agent2],
        tasks=[task1, task2],
        process=Process.sequential,
    )

    # Patch Task.execute_sync to capture the context argument passed to task2 execution
    original_execute_sync = Task.execute_sync

    contexts_passed = []

    def capture_context(self, context=None, tools=None, **kwargs):
        if self == task2:
            contexts_passed.append(context)
        return original_execute_sync(self, context=context, tools=tools, **kwargs)

    with patch.object(Task, "execute_sync", new=capture_context):
        crew.kickoff()

    assert len(contexts_passed) == 1, "Task 2 execute_sync was not called exactly once"
    context_passed_to_task2 = contexts_passed[0]
    # Because context is None, the context string should be non-empty (aggregated from previous tasks)
    assert isinstance(context_passed_to_task2, str)
    assert context_passed_to_task2 != "", (
        "Expected non-empty context string for task with context=None or not specified, "
        "but got empty context."
    )[0m
