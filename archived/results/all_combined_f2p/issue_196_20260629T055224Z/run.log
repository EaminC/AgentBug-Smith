        # Create a 15x15 board (default size)
        agent = BoardAgent(name="test_board", board_size=15)

        # Simulate a horizontal win for black
        # Place four black stones in a row at (7, 0) through (7, 3)
        for col in range(4):
            agent.board[7, col] = NAME_TO_PIECE[NAME_BLACK]

        # Now black's move at (7, 4) should create a win (five in a row)
        move_row, move_col = 7, 4

        # Prepare the input message as the agent expects
        input_msg = {
            "name": NAME_BLACK,
            "content": (move_row, move_col),
        }

        # Mock the speak method to avoid side effects
        agent.speak = Mock()

        # Call reply with the move
        result = agent.reply(input_msg)

        # In the buggy version, the board is not updated before check_win,
        # so check_win will see only four stones and return False.
        # The game will not end, and the board will be updated afterward.
        # In the fixed version, the board is updated first, then check_win sees
        # five stones and returns True, ending the game with a win message.

        # Assert that the game has ended (should be True in fixed version)
        assert agent.game_end is True, "Game should have ended with a win"

