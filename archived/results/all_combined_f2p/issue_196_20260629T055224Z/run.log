import pytest
import numpy as np
from unittest.mock import patch, MagicMock
from examples.game_gomoku.code.board_agent import BoardAgent, NAME_TO_PIECE, NAME_BLACK, NAME_WHITE

class TestGomokuWinCheckBug:
    """Test for the bug where win check is performed before updating the board."""

    def test_win_check_after_board_update(self):
        """Ensure win detection works correctly after the board is updated."""
        # Create a board agent with a small board for testing
        board_size = 5
        agent = BoardAgent(name="board", board_size=board_size)

        # Simulate a winning move for black: place 4 black pieces horizontally,
        # then a fifth one to win. We'll test that the win is detected after board update.
        # Start with an empty board.
        assert agent.board.sum() == 0

        # Place 4 black pieces in row 0, columns 0-3
        for col in range(4):
            agent.board[0, col] = NAME_TO_PIECE[NAME_BLACK]

        # Now black makes a move at (0,4) to complete a line of 5.
        # In the buggy code, check_win is called BEFORE updating the board,
        # so it would not detect the win because the new piece isn't on the board yet.
        # In the fixed code, the board is updated first, then check_win should detect win.
        move_msg = {
            "name": NAME_BLACK,
            "content": (0, 4)
        }

        # Call reply with the move
        response = agent.reply(move_msg)

        # Check that the game_end flag is set correctly.
        # In the buggy version, game_end would be False because win check fails.
        # In the fixed version, game_end should be True.
        # We'll assert that game_end is True (expect pass after fix, fail before fix).
        assert agent.game_end is True, "Game should end with a win after board update"

        # Additionally, verify the board state includes the new piece
        assert agent.board[0, 4] == NAME_TO_PIECE[NAME_BLACK]
        # Verify there are exactly 5 black pieces in row 0
        assert np.sum(agent.board[0, :] == NAME_TO_PIECE[NAME_BLACK]) == 5

    def test_no_false_win_before_update(self):
        """Ensure that a win is not falsely detected before board update."""
        # Create a board agent
        board_size = 5
        agent = BoardAgent(name="board", board_size=board_size)

        # Place 3 black pieces in row 0, columns 0-2
        for col in range(3):
            agent.board[0, col] = NAME_TO_PIECE[NAME_BLACK]

        # Black makes a move at (0,3) – this creates 4 in a row, not 5.
        # The buggy code would check win before update, and still not win (since only 3 on board).
        # The fixed code also should not win.
        move_msg = {
            "name": NAME_BLACK,
            "content": (0, 3)
        }

        response = agent.reply(move_msg)

        # Game should not end
        assert agent.game_end is False, "Game should not end with only 4 in a row"
        # Board should be updated
        assert agent.board[0, 3] == NAME_TO_PIECE[NAME_BLACK]

    def test_vertical_win_after_update(self):
        """Test vertical win detection after board update."""
        board_size = 5
        agent = BoardAgent(name="board", board_size=board_size)

        # Place 4 white pieces vertically in column 2, rows 0-3
        for row in range(4):
            agent.board[row, 2] = NAME_TO_PIECE[NAME_WHITE]

        # White makes a move at (4,2) to complete vertical line
        move_msg = {
            "name": NAME_WHITE,
            "content": (4, 2)
        }

        response = agent.reply(move_msg)

        # After fix, game_end should be True
        assert agent.game_end is True, "Vertical win should be detected after board update"
        assert agent.board[4, 2] == NAME_TO_PIECE[NAME_WHITE]

