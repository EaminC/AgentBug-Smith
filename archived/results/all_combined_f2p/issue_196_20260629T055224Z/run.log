    def test_win_detection_after_board_update(self) -> None:
        """Test that a win is detected when the board is updated before checking.

        In the buggy version, check_win is called before the board is updated,
        so the newly placed stone is not counted, causing false negatives.
        In the fixed version, the board is updated first, then check_win is called,
        so wins are correctly detected.
