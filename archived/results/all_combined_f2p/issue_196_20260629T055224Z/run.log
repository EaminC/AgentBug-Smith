import numpy as np

sys.path.insert(0, "examples/game_gomoku/code")

def test_gomoku_win_check_bug():
    """Test that the win check correctly includes the current move after updating the board."""
    # Import the board agent class from the example
    from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    # Create a board agent
    board_size = 15
    agent = BoardAgent(name="board", board_size=board_size)

    # Simulate a horizontal win for black
    # Place four black pieces in a row
    for col in range(4):
        agent.board[0, col] = NAME_TO_PIECE[NAME_BLACK]

    # Now black makes the winning move at (0,4)
    move_msg = {"name": NAME_BLACK, "content": (0, 4)}

    # In buggy code, check_win is called before board is updated,
    # so it will not detect the win because the piece at (0,4) is not on board yet.
    # In fixed code, board is updated first, then check_win should detect win.
    response = agent.reply(move_msg)

    # After fix, game_end should be True because black wins
    assert agent.game_end == True
    assert f"{NAME_BLACK} wins" in response["content"]

def test_gomoku_no_false_win_before_update():
    """Test that check_win doesn't falsely detect win before board is updated."""
    from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    board_size = 15
    agent = BoardAgent(name="board", board_size=board_size)

    # Place four black pieces
    for col in range(4):
        agent.board[0, col] = NAME_TO_PIECE[NAME_BLACK]

    # Place a white piece at (0,4) to block
    agent.board[0, 4] = NAME_TO_PIECE[NAME_WHITE]

    # Now black moves at (0,5) - should not be a win
    move_msg = {"name": NAME_BLACK, "content": (0, 5)}
    response = agent.reply(move_msg)

    # In buggy code, check_win is called before board update, so it will not see the piece at (0,5)
    # and will not detect a win (correct). In fixed code, same logic.
    # But we need to ensure that after fix, the game does not end (no win).
    # The board after move: black at 0,0-3 and 0,5; white at 0,4 -> no five in a row.
    assert agent.game_end == False
    # The response should prompt next player (white)
    assert NAME_WHITE in response["content"]

def test_gomoku_diagonal_win():
    """Test diagonal win detection after board update."""
    from board_agent import BoardAgent, NAME_WHITE, NAME_TO_PIECE

    board_size = 15
    agent = BoardAgent(name="board", board_size=board_size)

    # Place four white pieces diagonally
    for i in range(4):
        agent.board[i, i] = NAME_TO_PIECE[NAME_WHITE]

    # White makes the winning move at (4,4)
    move_msg = {"name": NAME_WHITE, "content": (4, 4)}
    response = agent.reply(move_msg)

    # After fix, game_end should be True
    assert agent.game_end == True
    assert f"{NAME_WHITE} wins" in response["content"]

def test_gomoku_vertical_win():
    """Test vertical win detection after board update."""
    from board_agent import BoardAgent, NAME_BLACK, NAME_TO_PIECE

    board_size = 15
    agent = BoardAgent(name="board", board_size=board_size)

    # Place four black pieces vertically
    for row in range(4):
        agent.board[row, 7] = NAME_TO_PIECE[NAME_BLACK]

    # Black makes the winning move at (4,7)
    move_msg = {"name": NAME_BLACK, "content": (4, 7)}
    response = agent.reply(move_msg)

    # After fix, game_end should be True
    assert agent.game_end == True
    assert f"{NAME_BLACK} wins" in response["content"]

def test_gomoku_draw_detection():
    """Test that draw detection still works correctly after fix."""
    from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    board_size = 3  # Small board for quick fill
    agent = BoardAgent(name="board", board_size=board_size)

    # Fill board with alternating pieces, leaving one empty spot
    for r in range(board_size):
        for c in range(board_size):
            if (r + c) % 2 == 0:
                agent.board[r, c] = NAME_TO_PIECE[NAME_BLACK]
            else:
                agent.board[r, c] = NAME_TO_PIECE[NAME_WHITE]

    # Set one cell empty (0,0)
    agent.board[0, 0] = 0

    # Black moves into the last empty spot
    move_msg = {"name": NAME_BLACK, "content": (0, 0)}
    response = agent.reply(move_msg)

    # After the move, board is full and no win -> draw
    assert agent.game_end == True
    assert "draw" in response["content"].lower()[0m
