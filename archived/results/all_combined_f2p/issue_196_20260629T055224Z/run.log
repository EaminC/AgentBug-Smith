    agent.board[2,0] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[2,1] = NAME_TO_PIECE[NAME_WHITE]
    # The last cell (2,2) is empty.

    # Now black's move at (2,2) will fill the last cell, causing a draw.
    move_msg = {
        "name": NAME_BLACK,
        "content": (2, 2)
    }

    result = agent.reply(move_msg)
    # In both buggy and fixed code, check_draw should be called after board update.
    # However, in buggy code, check_win is called before board update, and since (2,2) doesn't create a win,
    # it proceeds to update board and then check_draw (which returns True).
    # In fixed code, board is updated first, then check_draw is called (returns True) before check_win.
    # The draw detection should work in both, but the bug is about win detection, not draw.
    # So this test should pass on both buggy and fixed code.
    assert agent.game_end == True
    assert "draw" in result["content"][0m
