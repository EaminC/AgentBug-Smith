[32mimport sys
import os
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))

from examples.game_gomoku.code.board_agent import (
    BoardAgent,
    NAME_BLACK,
    NAME_WHITE,
    NAME_TO_PIECE,
    PIECE_EMPTY,
    BOARD_SIZE,
)
from agentscope.message import Msg


def test_board_agent_win_check_bug():
    """Test that the win check correctly includes the current move after updating the board."""
    # Create a board agent
    agent = BoardAgent(name="board", board_size=BOARD_SIZE)

    # Simulate black's first move
    move1 = {"name": NAME_BLACK, "content": (7, 7)}
    reply1 = agent.reply(move1)
    assert not agent.game_end
    assert agent.board[7, 7] == NAME_TO_PIECE[NAME_BLACK]

    # Simulate white's move
    move2 = {"name": NAME_WHITE, "content": (7, 8)}
    reply2 = agent.reply(move2)
    assert not agent.game_end
    assert agent.board[7, 8] == NAME_TO_PIECE[NAME_WHITE]

    # Black makes four in a row horizontally
    agent.board[7, -1] = PIECE_EMPTY  # ensure board is clear
    agent.board[7, 6] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 5] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 4] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 3] = NAME_TO_PIECE[NAME_BLACK]
    # Now black places the fifth piece at (7,2) to win
    move_win = {"name": NAME_BLACK, "content": (7, 2)}
    reply_win = agent.reply(move_win)

    # In buggy code, check_win is called before board is updated,
    # so it will not detect the win because (7,2) is empty during check.
    # In fixed code, board is updated first, then check_win sees the five in a row.
    assert agent.game_end, "Game should end with black winning"
    assert f"{NAME_BLACK} wins" in reply_win["content"] or "The game ends" in reply_win["content"]


def test_board_agent_win_check_diagonal():
    """Test win detection on diagonal after board update."""
    agent = BoardAgent(name="board", board_size=BOARD_SIZE)

    # Setup a diagonal four in a row for black
    positions = [(0, 0), (1, 1), (2, 2), (3, 3)]
    for r, c in positions:
        agent.board[r, c] = NAME_TO_PIECE[NAME_BLACK]

    # Now black places the winning fifth piece at (4,4)
    move = {"name": NAME_BLACK, "content": (4, 4)}
    reply = agent.reply(move)

    # In buggy code, check_win runs before board update, so (4,4) is empty during check -> no win detected.
    # In fixed code, board is updated first, then check_win sees five in a row -> win detected.
    assert agent.game_end, "Game should end with black winning (diagonal)"
    win_msg = reply["content"]
    assert NAME_BLACK in win_msg or "wins" in win_msg


def test_board_agent_no_false_win():
    """Ensure that a move that does NOT create five in a row does not trigger win."""
    agent = BoardAgent(name="board", board_size=BOARD_SIZE)

    # Place four black pieces horizontally
    agent.board[5, 0] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[5, 1] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[5, 2] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[5, 3] = NAME_TO_PIECE[NAME_BLACK]

    # Black places a piece elsewhere (not completing five)
    move = {"name": NAME_BLACK, "content": (5, —1)}
    reply = agent.reply(move)

    # Should not end the game
    assert not agent.game_end, "Game should not end with only four in a row"
    # The reply should be a normal board prompt, not a win message
    assert "The game ends" not in reply["content"] or "wins" not in reply["content"]


def test_board_agent_draw_detection():
    """Test that draw detection works correctly after board update."""
    agent = BoardAgent(name="board", board_size=3)  # small board for quick fill

    # Fill the board except one cell
    for r in range(3):
        for c in range(3):
            if not (r == 2 and c == 2):
                agent.board[r, c] = NAME_TO_PIECE[NAME_BLACK] if (r + c) % 2 == 0 else NAME_TO_PIECE[NAME_WHITE]

    # Last move by white fills the board -> draw
    move = {"name": NAME_WHITE, "content": (2, 2)}
    reply = agent.reply(move)

    # In both buggy and fixed code, draw check happens after board update.
    # But in buggy code, win check runs before board update and might incorrectly trigger win.
    # However here we have no five in a row, so win check should be false.
    # The draw should be detected.
    assert agent.game_end, "Game should end in a draw"
    assert "draw" in reply["content"].lower()[0m
