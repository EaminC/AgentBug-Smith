def test_gomoku_win_check_bug():
    """Test that the win check correctly includes the current move after updating the board."""
    # Import the board agent class from the example
    from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    # Create a board agent
    agent = BoardAgent(name="board", board_size=15)

    # Simulate a game where black makes a winning move
    # Place four black pieces in a row horizontally
    for col in range(4):
        agent.board[7, col] = NAME_TO_PIECE[NAME_BLACK]

    # Now black plays at (7, 4) to complete five in a row
    move_msg = {"name": NAME_BLACK, "content": (7, 4)}

    # In buggy code, check_win is called BEFORE board is updated,
    # so it would not count the current move and would not detect win.
    # In fixed code, board is updated first, then check_win detects win.
    response = agent.reply(move_msg)

    # After fix, the game should end with black winning
    assert agent.game_end is True
    assert "wins!" in response["content"]
    assert NAME_BLACK in response["content"]

def test_gomoku_no_false_win_before_update():
    """Test that check_win doesn't falsely detect win before board is updated."""
    from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent(name="board", board_size=15)

    # Place three black pieces (not enough to win)
    for col in range(3):
        agent.board[7, col] = NAME_TO_PIECE[NAME_BLACK]

    # Black plays at (7, 3) - now four in a row, still not winning
    move_msg = {"name": NAME_BLACK, "content": (7, 3)}

    # In buggy code, check_win is called before update, so it would still not win (correct).
    # In fixed code, same logic applies.
    response = agent.reply(move_msg)

    # Game should not end
    assert agent.game_end is False
    assert "wins!" not in response["content"]
    # Should be prompting next player
    assert NAME_WHITE in response["content"]

def test_gomoku_diagonal_win():
    """Test diagonal win detection after board update."""
    from board_agent import BoardAgent, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent(name="board", board_size=15)

    # Place four white pieces diagonally
    for i in range(4):
        agent.board[i, i] = NAME_TO_PIECE[NAME_WHITE]

    # White plays at (4, 4) to complete diagonal five
    move_msg = {"name": NAME_WHITE, "content": (4, 4)}

    response = agent.reply(move_msg)

    # After fix, win should be detected
    assert agent.game_end is True
    assert "wins!" in response["content"]
    assert NAME_WHITE in response["content"]

def test_gomoku_vertical_win():
    """Test vertical win detection after board update."""
    from board_agent import BoardAgent, NAME_BLACK, NAME_TO_PIECE

    agent = BoardAgent(name="board", board_size=15)

    # Place four black pieces vertically
    for row in range(4):
        agent.board[row, -1] = NAME_TO_PIECE[NAME_BLACK]

    # Black plays at (4, -1) to complete vertical five
    move_msg = {"name": NAME_BLACK, "content": (4, -1)}

    response = agent.reply(move_msg)

    # After fix, win should be detected
    assert agent.game_end is True
    assert "wins!" in response["content"]
    assert NAME_BLACK in response["content"]

def test_gomoku_draw_detection():
    """Test that draw detection still works correctly after fix."""
    from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    agent = BoardAgent(name="board", board_size=3)  # small board for quick draw

    # Fill board almost completely
    agent.board[0, 0] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[0, 1] = NAME_TO_PIECE[NAME_WHITE]
    agent.board[0, 2] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[1, 0] = NAME_TO_PIECE[NAME_WHITE]
    agent.board[1, 1] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[1, 2] = NAME_TO_PIECE[NAME_WHITE]
    agent.board[2, 0] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[2, 1] = NAME_TO_PIECE[NAME_WHITE]
    # Only (2,2) is empty

    # White plays the last move, which should result in a draw
    move_msg = {"name": NAME_WHITE, "content": (2, 2)}

    response = agent.reply(move_msg)

    # Draw should be detected regardless of bug/fix
    assert agent.game_end is True
    assert "draw" in response["content"].lower()[0m
