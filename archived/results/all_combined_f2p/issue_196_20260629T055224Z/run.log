[32mimport sys
import os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'examples', 'game_gomoku', 'code'))

from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE
from agentscope.message import Msg

def test_check_win_after_board_update():
    """
    Test that check_win is called after the board is updated with the new move.
    In buggy code, check_win is called before the board is updated, causing
    the win condition to be missed because the current move is not counted.
    After the fix, check_win is called after board update, so wins are detected.
    """
    # Create a board agent with a small board (5x5) for simplicity
    agent = BoardAgent(name="board", board_size=5)

    # Simulate a winning sequence for black
    # Place four black pieces in a row horizontally
    agent.board[0, 0] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[0, 1] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[0, 2] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[0, 3] = NAME_TO_PIECE[NAME_BLACK]
    # The next move at (0,4) should create five in a row and win

    # Send a move from black player at (0,4)
    move_msg = Msg(
        name=NAME_BLACK,
        content=(0, 4),
        role="user",
    )

    # Call reply with the move
    response = agent.reply(move_msg)

    # In buggy code, the board is not updated before check_win,
    # so check_win will see only four pieces and not detect win.
    # Therefore game_end will be False (or content will not contain "wins").
    # In fixed code, board is updated first, check_win sees five pieces,
    # game_end becomes True and content contains "wins".

    # Check that the game has ended with a win
    assert agent.game_end is True, f"Expected game_end=True, got {agent.game_end}"
    assert "wins" in response.content, f"Expected 'wins' in response, got: {response.content}"
    assert NAME_BLACK in response.content, f"Expected {NAME_BLACK} in win message, got: {response.content}"

    # Additionally verify the board has the move recorded
    assert agent.board[0, 4] == NAME_TO_PIECE[NAME_BLACK], "Board not updated with move"

def test_check_win_vertical():
    """Test vertical win detection after fix."""
    agent = BoardAgent(name="board", board_size=5)
    # Place four white pieces vertically
    agent.board[0, -1] = NAME_TO_PIECE[NAME_WHITE]
    agent.board[1, -1] = NAME_TO_PIECE[NAME_WHITE]
    agent.board[2, -1] = NAME_TO_PIECE[NAME_WHITE]
    agent.board[3, -1] = NAME_TO_PIECE[NAME_WHITE]
    # Winning move at (4, -1)
    move_msg = Msg(
        name=NAME_WHITE,
        content=(4, -1),
        role="user",
    )
    response = agent.reply(move_msg)
    assert agent.game_end is True
    assert "wins" in response.content
    assert NAME_WHITE in response.content
    assert agent.board[4, -1] == NAME_TO_PIECE[NAME_WHITE]

