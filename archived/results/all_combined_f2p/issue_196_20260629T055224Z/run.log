import os
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))

from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE
from agentscope.message import Msg


def test_board_agent_win_check_bug():
    """
    Test that the win check bug is fixed: the board must be updated before checking for a win.
    In the buggy version, check_win is called before updating the board, missing the current move.
    In the fixed version, the board is updated first, then check_win correctly includes the new move.
    """
    # Create a board agent with a small board for simplicity
    board_size = 5
    agent = BoardAgent(name="board", board_size=board_size)

    # Simulate a winning move for black (player1) on a diagonal
    # Place four black pieces in a diagonal line
    for i in range(4):
        agent.board[i, i] = NAME_TO_PIECE[NAME_BLACK]

    # Now black's next move at (4,4) should create five in a row and win
    move_msg = Msg(
        name=NAME_BLACK,
        content=(4, 4),
        role="user",
    )

    # Call reply with the move
    response = agent.reply(move_msg.to_dict())

    # In the buggy version, the board is not updated before check_win,
    # so check_win sees only four pieces and returns False.
    # The game_end flag remains False, and the response content will be a board prompt.
    # In the fixed version, the board is updated first, check_win returns True,
    # game_end becomes True, and the content is a win message.

    # Extract the actual content from the response (it's a dict with a 'content' field)
    # The reply method returns a dict with key 'content'? Actually, it returns a dict with 'content'?
    # Looking at the code, reply returns a dict with 'content' being the message content.
    # But the method ends with returning the message? Let's check: reply returns the message dict.
    # The response is the message dict, so we can get content via response['content'].
    content = response['content']

    # In the fixed version, we expect a win message.
    expected_win_message = f"The game ends, {NAME_BLACK} wins!"
    # In the buggy version, we expect a board prompt (since win is not detected).
    # The board prompt contains "Current board" and the next player.
    expected_board_prompt_prefix = "Current board"

    # Assert that the game_end flag is True in fixed version, False in buggy.
    # This is the key difference: buggy version fails to detect win, so game_end remains False.
    # Fixed version detects win, so game_end becomes True.
    # We'll assert that the test passes only when the fix is applied.
    # That means: on buggy code, assert game_end is False (test fails).
    # On fixed code, assert game_end is True (test passes).
    # However, we need a single test that fails on buggy and passes on fixed.
    # We can do that by checking the content: if it's a win message, game_end must be True.
    # If it's a board prompt, game_end must be False.
    # But we don't know which version we're running. Instead, we can assert that the win is detected.
    # So we assert that the content is the win message and game_end is True.
    # On buggy code, this assertion will fail because content will be a board prompt.
    # On fixed code, it will pass.
    assert agent.game_end is True, f"game_end should be True after a winning move, but is {agent.game_end}"
    assert expected_win_message in content, f"Expected win message '{expected_win_message}' not found in content: '{content}'"

    # Additionally, verify that the board was updated with the new piece.
    assert agent.board[4, 4] == NAME_TO_PIECE[NAME_BLACK], "Board was not updated with the new move."


def test_board_agent_win_check_bug_horizontal():
    """
    Another test with a horizontal winning line.
    """
    board_size = 5
    agent = BoardAgent(name="board", board_size=board_size)

    # Place four black pieces horizontally at row 0, columns 0-3
    for col in range(4):
        agent.board[0, col] = NAME_TO_PIECE[NAME_BLACK]

    # Winning move at (0,4)
    move_msg = Msg(
        name=NAME_BLACK,
        content=(0, 4),
        role="user",
    )

    response = agent.reply(move_msg.to_dict())
    content = response['content']

    # Fixed version: win detected
    expected_win_message = f"The game ends, {NAME_BLACK} wins!"
    assert agent.game_end is True, f"game_end should be True after a winning move, but is {agent.game_end}"
    assert expected_win_message in content, f"Expected win message '{expected_win_message}' not found in content: '{content}'"
    assert agent.board[0, 4] == NAME_TO_PIECE[NAME_BLACK], "Board was not updated with the new move."


def test_board_agent_no_win():
    """
    Test that a non-winning move does not end the game.
    """
    board_size = 5
    agent = BoardAgent(name="board", board_size=board_size)

    # Place three black pieces diagonally (not enough to win)
    for i in range(3):
        agent.board[i, i] = NAME_TO_PIECE[NAME_BLACK]

    # Move at (3,3) makes four in a row, but not five yet.
    move_msg = Msg(
        name=NAME_BLACK,
        content=(3, 3),
        role="user",
    )

    response = agent.reply(move_msg.to_dict())
    content = response['content']

    # Should not be a win message
    win_message = f"The game ends, {NAME_BLACK} wins!"
    assert win_message not in content, f"Unexpected win message: {content}"
    # game_end should be False
    assert agent.game_end is False, f"game_end should be False for non-winning move, but is {agent.game_end}"
    # Board should be updated
    assert agent.board[3, 3] == NAME_TO_PIECE[NAME_BLACK], "Board was not updated with the new move."


