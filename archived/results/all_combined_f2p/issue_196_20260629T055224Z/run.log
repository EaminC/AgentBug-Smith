import os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'examples', 'game_gomoku', 'code'))

import numpy as np

def test_gomoku_win_check_bug():
    """Test that the win check correctly includes the current move after updating the board."""
    # Import the board agent class from the example
    from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    # Create a board agent
    board_agent = BoardAgent(name="board", board_size=15)
    # Simulate a move that would create a win after placing the piece
    # We'll create a scenario where black has four in a row horizontally, and the fifth piece is placed
    # In the buggy version, check_win is called before board is updated, so it won't detect win
    # In the fixed version, board is updated first, then check_win detects win
    board_agent.board = np.zeros((15, 15), dtype=int)
    # Place four black pieces in a row at row 7, columns 0-3
    for col in range(4):
        board_agent.board[7, col] = NAME_TO_PIECE[NAME_BLACK]
    
    # Now simulate black placing the winning piece at (7, 4)
    move_msg = {"name": NAME_BLACK, "content": (7, 4)}
    
    # Call reply with the move
    response = board_agent.reply(move_msg)
    
    # In buggy version: board not updated before check_win, so check_win returns False
    # Then board is updated, but win is never checked again, so game_end remains False
    # In fixed version: board updated first, then check_win returns True, game_end set to True
    if board_agent.game_end:
        # Fixed version: win detected
        assert "wins" in response["content"], f"Expected win message, got: {response['content']}"
    else:
        # Buggy version: win not detected
        # The buggy version would have updated the board but not detected win
        # So board should have the piece at (7,4)
        assert board_agent.board[7, 4] == NAME_TO_PIECE[NAME_BLACK]
        # And game_end should be False
        assert not board_agent.game_end
        # And response should be a board prompt for next player
        assert NAME_WHITE in response["content"]

def test_gomoku_no_false_win_before_update():
    """Test that check_win doesn't falsely detect win before board is updated."""
    from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE
    
    board_agent = BoardAgent(name="board", board_size=15)
    board_agent.board = np.zeros((15, 15), dtype=int)
    # Place three black pieces (not enough for win)
    board_agent.board[7, 0] = NAME_TO_PIECE[NAME_BLACK]
    board_agent.board[7, 1] = NAME_TO_PIECE[NAME_BLACK]
    board_agent.board[7, 2] = NAME_TO_PIECE[NAME_BLACK]
    
    # Place a black piece at (7, 3) - still only four total, not a win
    move_msg = {"name": NAME_BLACK, "content": (7, 3)}
    response = board_agent.reply(move_msg)
    
    # In both versions, no win should be detected
    # But in buggy version, check_win is called before board update with only three pieces on board
    # (since the new piece isn't placed yet), so it correctly returns False
    # In fixed version, board is updated first (now four pieces), check_win returns False (needs five)
    # So both should have game_end False
    assert not board_agent.game_end
    # Board should have the new piece
    assert board_agent.board[7, 3] == NAME_TO_PIECE[NAME_BLACK]
    # Response should prompt next player
    assert NAME_WHITE in response["content"]

def test_gomoku_diagonal_win():
    """Test diagonal win detection after board update."""
    from board_agent import BoardAgent, NAME_WHITE, NAME_TO_PIECE
    
    board_agent = BoardAgent(name="board", board_size=15)
    board_agent.board = np.zeros((15, 15), dtype=int)
    # Place four white pieces in a diagonal
    for i in range(4):
        board_agent.board[i, i] = NAME_TO_PIECE[NAME_WHITE]
    
    # Place the winning fifth piece
    move_msg = {"name": NAME_WHITE, "content": (4, 4)}
    response = board_agent.reply(move_msg)
    
    # In buggy version: check_win before update sees only four pieces, returns False
    # Board gets updated but win never rechecked, game_end remains False
    # In fixed version: board updated first, check_win sees five pieces, returns True
