[32mimport sys
import os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), "../examples/game_gomoku/code"))

from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE
from agentscope.message import Msg


def test_board_agent_win_check_before_board_update():
    """Test that the buggy code fails to detect a win when the winning move is placed.
    
    In the buggy version, check_win is called before the board is updated,
    so the newly placed stone is not counted. This test creates a scenario
    where a player makes a winning move (5 in a row) and expects the game
    to end with a win. The buggy version will not detect the win and will
    instead continue the game (or declare a draw if board is full).
    """
    # Create a board agent with a small board for simplicity
    # We'll manually set up the board state to have 4 in a row for black.
    agent = BoardAgent(name="board", board_size=15)
    # Reset board to empty
    agent.board.fill(0)
    
    # Simulate black placing stones to create 4 in a row horizontally
    # Positions: (7,0), (7,1), (7,2), (7,3) are black
    agent.board[7, 0] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 1] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 2] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 3] = NAME_TO_PIECE[NAME_BLACK]
    
    # Now black's next move at (7,4) should win (5 in a row).
    # In the buggy code, check_win is called before board is updated,
    # so it will see only 4 stones and return False.
    # In the fixed code, board is updated first, then check_win sees 5 stones.
    
    # Simulate black's move message
    move_msg = {
        "name": NAME_BLACK,
        "content": (7, 4),  # winning move
    }
    
    # Call reply with the move
    result = agent.reply(move_msg)
    
    # In the buggy version, game_end should still be False because win not detected.
    # In the fixed version, game_end should be True because win is detected.
    # However, note that the buggy version also has a logic flow where if check_win
    # returns True, it sets game_end and returns; else it updates board and checks draw.
    # Since check_win returns False, it proceeds to update board and check draw.
    # The board is not full, so draw is False, and it sets next player.
    # Therefore, after the buggy reply, game_end is False and content is the next player prompt.
    # After the fixed reply, game_end is True and content is win message.
    
    # Let's check the actual behavior.
    if agent.game_end:
        # Fixed version: game ended with win
        # Ensure content contains win message
        assert "wins" in result["content"] or "The game ends" in result["content"]
    else:
        # Buggy version: game did not end
        # Ensure content is the next player prompt (contains board or player)
        assert NAME_WHITE in result["content"] or "board" in result["content"].lower()
        # Additionally, the board should have the stone placed at (7,4)
        assert agent.board[7, 4] == NAME_TO_PIECE[NAME_BLACK]
        # And the stone count should be 5, but win not detected due to bug.
        # We can verify that check_win would now return True if called after board update.
        # This is the bug: check_win(row, col, piece) should be True but was called before update.
        # So we can call check_win manually to confirm it's a winning position.
        assert agent.check_win(7, 4, NAME_TO_PIECE[NAME_BLACK]) == True


def test_board_agent_win_check_after_board_update():
    """Test that the fixed code correctly detects a win after board update.
    
    This test is similar to above but asserts the expected fixed behavior.
    """
    agent = BoardAgent(name="board", board_size=15)
    agent.board.fill(0)
    
    # Set up 4 in a row for black
    agent.board[7, 0] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 1] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 2] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 3] = NAME_TO_PIECE[NAME_BLACK]
    
    move_msg = {
        "name": NAME_BLACK,
        "content": (7, 4),
    }
    
    result = agent.reply(move_msg)
    
    # Fixed version: game should end with win
    assert agent.game_end == True
    assert "wins" in result["content"] or "The game ends" in result["content"]
    # Ensure the board is updated
    assert agent.board[7, 4] == NAME_TO_PIECE[NAME_BLACK]


def test_board_agent_draw_detection():
    """Test that draw detection still works correctly after the fix.
    
    In both buggy and fixed versions, draw check occurs after board update.
    This test ensures draw detection is not broken.
    """
    agent = BoardAgent(name="board", board_size=3)  # small board to fill easily
    agent.board.fill(0)
    
    # Fill the board with alternating stones without any win.
    # For a 3x3 board, we can fill all positions.
    # Black at (0,0), white at (0,1), black at (0,2),
    # white at (1,0), black at (1,1), white at (1,2),
    # black at (2,0), white at (2,1), and last move black at (2,2) should cause draw.
    moves = [
        (NAME_BLACK, (0,0)),
        (NAME_WHITE, (0,1)),
        (NAME_BLACK, (0,2)),
        (NAME_WHITE, (1,0)),
        (NAME_BLACK, (1,1)),
        (NAME_WHITE, (1,2)),
        (NAME_BLACK, (2,0)),
        (NAME_WHITE, (2,1)),
    ]
    for player, pos in moves:
        agent.board[pos] = NAME_TO_PIECE[player]
    
    # Now black's move at (2,2) fills the board, should be a draw.
    move_msg = {
        "name": NAME_BLACK,
        "content": (2, 2),
    }
    
    result = agent.reply(move_msg)
    
    # In both versions, game_end should be True and content should be draw message.
    assert agent.game_end == True
    assert "draw" in result["content"].lower()
    assert agent.board[2, 2] == NAME_TO_PIECE[NAME_BLACK]


