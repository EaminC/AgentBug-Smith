from agentscope.agents import AgentBase
from agentscope.message import Msg
from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE
import numpy as np

def test_board_agent_win_check_bug():
    """Test that the win check works correctly after the board is updated."""
    # Create a board agent with a small board for testing
    board_size = 5
    agent = BoardAgent(name="board", board_size=board_size)

    # Simulate a game where black makes a winning move
    # We'll set up the board so that black has 4 in a row horizontally,
    # and the next move at (0,4) makes 5 in a row.
    # In the buggy version, the win check happens before the board is updated,
    # so it would not detect the win because the new piece is not on the board yet.
    # In the fixed version, the board is updated first, then win check should detect.

    # Manually set the board state: row 0, columns 0-3 are black pieces
    agent.board[0, 0] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[0, 1] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[0, 2] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[0, 3] = NAME_TO_PIECE[NAME_BLACK]
    # column 4 is empty

    # Now black makes move at (0,4)
    move_msg = Msg(
        name=NAME_BLACK,
        content=(0, 4),
        role="user",
    )

    # Call reply with the move
    response = agent.reply(move_msg)

    # In the buggy version, the win check would fail because the board hasn't been updated.
    # So the game would not end, and the response content would be the next player prompt.
    # In the fixed version, the win check should succeed and the game ends with a win message.
    # We assert that the game_end is True and the content contains "wins"
    assert agent.game_end is True, "Game should have ended with a win"
    assert "wins" in response["content"], f"Expected win message, got: {response['content']}"
    assert NAME_BLACK in response["content"], f"Winner should be {NAME_BLACK}"

    # Additionally, verify that the board was updated with the new piece
    assert agent.board[0, 4] == NAME_TO_PIECE[NAME_BLACK], "Board should have the new piece"

def test_board_agent_win_check_diagonal():
    """Test win check on diagonal after board update."""
    board_size = 5
    agent = BoardAgent(name="board", board_size=board_size)

    # Set up a diagonal of 4 black pieces from (0,0) to (3,3)
    for i in range(4):
        agent.board[i, i] = NAME_TO_PIECE[NAME_BLACK]

    # Black makes move at (4,4) to complete 5 in a row
    move_msg = Msg(
        name=NAME_BLACK,
        content=(4, 4),
        role="user",
    )

    response = agent.reply(move_msg)

    assert agent.game_end is True, "Game should have ended with a win"
    assert "wins" in response["content"], f"Expected win message, got: {response['content']}"
    assert NAME_BLACK in response["content"], f"Winner should be {NAME_BLACK}"
    assert agent.board[4, 4] == NAME_TO_PIECE[NAME_BLACK]

def test_board_agent_no_win_before_update():
    """Test that a move that does not create a win does not end the game."""
    board_size = 5
    agent = BoardAgent(name="board", board_size=board_size)

    # Set up a single black piece at (0,0)
    agent.board[0, 0] = NAME_TO_PIECE[NAME_BLACK]

    # Black makes move at (0,1) - not a win
    move_msg = Msg(
        name=NAME_BLACK,
        content=(0, 1),
        role="user",
    )

    response = agent.reply(move_msg)

    # Game should not end
    assert agent.game_end is False, "Game should not end with only two pieces"
    # Should be next player's turn
    assert NAME_WHITE in response["content"], f"Should prompt next player {NAME_WHITE}, got: {response['content']}"
    assert agent.board[0, 1] == NAME_TO_PIECE[NAME_BLACK]

def test_board_agent_draw():
    """Test that a draw is detected correctly."""
    board_size = 3  # Small board to easily fill
    agent = BoardAgent(name="board", board_size=board_size)

    # Fill the board except one cell with alternating pieces
    # We'll fill manually to avoid win condition
    # Row 0: black, white, black
    agent.board[0, 0] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[0, 1] = NAME_TO_PIECE[NAME_WHITE]
    agent.board[0, 2] = NAME_TO_PIECE[NAME_BLACK]
    # Row 1: white, black, white
    agent.board[1, 0] = NAME_TO_PIECE[NAME_WHITE]
    agent.board[1, 1] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[1, 2] = NAME_TO_PIECE[NAME_WHITE]
    # Row 2: black, white, empty (to be filled by black)
    agent.board[2, 0] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[2, 1] = NAME_TO_PIECE[NAME_WHITE]
    # (2,2) is empty

    # Black makes the last move at (2,2) - this should result in a draw
    move_msg = Msg(
        name=NAME_BLACK,
        content=(2, 2),
        role="user",
    )

    response = agent.reply(move_msg)

    # In the buggy version, the win check would run before board update, then draw check.
    # Since the board is not updated, draw check would see an empty cell and not call draw.
    # Then the board is updated, but win check is already done.
    # In the fixed version, board is updated first, then draw check should detect draw.
    assert agent.game_end is True, "Game should have ended in a draw"
    assert "draw" in response["content"].lower(), f"Expected draw message, got: {response['content']}"
    assert agent.board[2, 2] == NAME_TO_PIECE[NAME_BLACK]

if __name__ == "__main__":
    # Run the tests manually if needed
    test_board_agent_win_check_bug()
    test_board_agent_win_check_diagonal()
    test_board_agent_no_win_before_update()
    test_board_agent_draw()
    print("All tests passed!")[0m
