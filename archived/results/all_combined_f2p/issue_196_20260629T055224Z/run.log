def test_gomoku_win_check_bug():
    """Test that the win check correctly includes the current move after updating the board."""
    # Import the board agent class from the example
    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    # Create a minimal board agent instance
    board_size = 15
    agent = BoardAgent(name="board", board_size=board_size)

    # Simulate a scenario where a win is achieved by placing the 5th piece in a row
    # We'll manually set up the board state
    # Let's create a horizontal win for black
    # Place 4 black pieces in a row at positions (7,0), (7,1), (7,2), (7,3)
    agent.board[7, 0] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 1] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 2] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 3] = NAME_TO_PIECE[NAME_BLACK]

    # Now black makes the winning move at (7,4)
    move = {"name": NAME_BLACK, "content": (7, 4)}

    # Call reply with this move
    # In buggy code: check_win is called BEFORE updating board, so it won't detect win
    # In fixed code: board is updated first, then check_win detects win
    result = agent.reply(move)

    # The agent should have set game_end to True and announced black wins
    assert agent.game_end == True, "Game should have ended with a win"
    
    # Check that the win message is in the content
    # The agent returns a dict with a 'content' field
    assert isinstance(result, dict)
    content = result.get('content', '')
    assert NAME_BLACK in content and "wins" in content, f"Expected win message, got: {content}"

    # Also verify the board was updated with the move
    assert agent.board[7, 4] == NAME_TO_PIECE[NAME_BLACK], "Board should have been updated with the move"

def test_gomoku_no_false_win_before_update():
    """Test that check_win doesn't falsely detect win before board is updated."""
    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    board_size = 15
    agent = BoardAgent(name="board", board_size=board_size)

    # Set up a scenario where black has 3 in a row, and is about to place 4th (not winning)
    agent.board[5, -1] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[5, 0] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[5, 1] = NAME_TO_PIECE[NAME_BLACK]

    # Place the 4th piece at (5,2) - still not a win
    move = {"name": NAME_BLACK, "content": (5, 2)}

    result = agent.reply(move)

    # Game should not end
    assert agent.game_end == False, "Game should not end with only 4 in a row"
    
    # Board should be updated
    assert agent.board[5, 2] == NAME_TO_PIECE[NAME_BLACK]

def test_gomoku_diagonal_win():
    """Test diagonal win detection after board update."""
    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_WHITE, NAME_TO_PIECE

    board_size = 15
    agent = BoardAgent(name="board", board_size=board_size)

    # Set up a diagonal for white
    agent.board[0, 0] = NAME_TO_PIECE[NAME_WHITE]
    agent.board[1, 1] = NAME_TO_PIECE[NAME_WHITE]
    agent.board[2, 2] = NAME_TO_PIECE[NAME_WHITE]
    agent.board[3, 3] = NAME_TO_PIECE[NAME_WHITE]

    # Winning move at (4,4)
    move = {"name": NAME_WHITE, "content": (4, 4)}

    result = agent.reply(move)

    assert agent.game_end == True, "Diagonal win should be detected"
    assert NAME_WHITE in str(result.get('content', ''))

def test_gomoku_vertical_win():
    """Test vertical win detection after board update."""
    from examples.game_gomoku.code.board_agent import BoardAgent, NAME_BLACK, NAME_TO_PIECE

    board_size = 15
    agent = BoardAgent(name="board", board_size=board_size)

    # Vertical line
    agent.board[0, 10] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[1, 10] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[2, 10] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[3, 10] = NAME_TO_PIECE[NAME_BLACK]

    move = {"name": NAME_BLACK, "content": (4, 10)}

    result = agent.reply(move)

    assert agent.game_end == True, "Vertical win should be detected"
    assert NAME_BLACK in str(result.get('content', ''))

