    agent.board[3, 3] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[4, 4] = NAME_TO_PIECE[NAME_BLACK]
    # Black moves at (5,5)
    move_msg = Msg(
        name=NAME_BLACK,
        content=[5, 5],
        role="user",
    )
    response = agent.reply(move_msg.to_dict())
    assert agent.game_end is True, "Diagonal win should be detected"


def test_no_win_before_five():
    """Ensure game does not end prematurely with four in a row."""
    agent = BoardAgent(name="board", board_size=15)
    # Set three black stones horizontally
    agent.board[7, 5] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 6] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 7] = NAME_TO_PIECE[NAME_BLACK]
    # Black moves at (7,8) -> now four in a row, not five.
    move_msg = Msg(
        name=NAME_BLACK,
        content=[7, 8],
        role="user",
    )
    response = agent.reply(move_msg.to_dict())
    assert agent.game_end is False, "Game should not end with only four in a row"[0m
