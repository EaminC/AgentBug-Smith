    # We'll manually set the board state before the move
    agent.board = np.full((board_size, board_size), NAME_EMPTY, dtype=int)
    # Place four black stones vertically at (0,2), (1,2), (2,2), (3,2)
    agent.board[0, 2] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[1, 2] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[2, 2] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[3, 2] = NAME_TO_PIECE[NAME_BLACK]

