[32mimport sys
import os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'examples', 'game_gomoku', 'code'))

import pytest
import numpy as np

def test_gomoku_win_check_bug():
    """Test that the win check correctly includes the current move after updating the board."""
    # Import the board agent class from the example
    from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    # Create a board agent with a small board for testing
    board_size = 5
    agent = BoardAgent(name="host", board_size=board_size)

    # Simulate a horizontal win for black
    # Place four black pieces in a row
    for col in range(4):
        agent.board[0, col] = NAME_TO_PIECE[NAME_BLACK]

    # Now black makes the winning move at (0, 4)
    # In the buggy version, check_win is called BEFORE the board is updated,
    # so it will not detect the win because the current move is not on the board yet.
    # In the fixed version, the board is updated first, then check_win is called.
    move_msg = {"name": NAME_BLACK, "content": (0, 4)}
    response = agent.reply(move_msg)

    # Check that the game ends with black winning
    assert agent.game_end is True
    # The response content should contain the win message
    # The reply method returns a dict with a 'content' field
    assert "wins" in response["content"]
    assert NAME_BLACK in response["content"]

def test_gomoku_no_false_win_before_update():
    """Test that check_win doesn't falsely detect win before board is updated."""
    from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    board_size = 5
    agent = BoardAgent(name="host", board_size=board_size)

    # Place three black pieces in a row (not enough to win)
    for col in range(3):
        agent.board[0, col] = NAME_TO_PIECE[NAME_BLACK]

    # Now black makes a move at (0, 3) - still not a win (only four in a row)
    # In the buggy version, check_win is called before board update,
    # but it should still return False because even with the current move,
    # there are only four pieces (if we included it). However, the bug is that
    # the current move is not on the board, so check_win only sees three pieces.
    # This test is to ensure the fix doesn't break the logic for non-winning moves.
    move_msg = {"name": NAME_BLACK, "content": (0, 3)}
    response = agent.reply(move_msg)

    # The game should not end
    assert agent.game_end is False
    # The response should be a prompt for the next player
    assert "The game ends" not in response["content"]
    assert NAME_WHITE in response["content"]  # Next player is white

def test_gomoku_diagonal_win():
    """Test diagonal win detection after board update."""
    from board_agent import BoardAgent, NAME_WHITE, NAME_TO_PIECE

    board_size = 5
    agent = BoardAgent(name="host", board_size=board_size)

    # Place four white pieces in a diagonal
    for i in range(4):
        agent.board[i, i] = NAME_TO_PIECE[NAME_WHITE]

    # White makes the winning move at (4, 4)
    move_msg = {"name": NAME_WHITE, "content": (4, 4)}
    response = agent.reply(move_msg)

    assert agent.game_end is True
    assert "wins" in response["content"]
    assert NAME_WHITE in response["content"]

def test_gomoku_vertical_win():
    """Test vertical win detection after board update."""
    from board_agent import BoardAgent, NAME_BLACK, NAME_TO_PIECE

    board_size = 5
    agent = BoardAgent(name="host", board_size=board_size)

    # Place four black pieces in a column
    for row in range(4):
        agent.board[row, 0] = NAME_TO_PIECE[NAME_BLACK]

    # Black makes the winning move at (4, 0)
    move_msg = {"name": NAME_BLACK, "content": (4, 0)}
    response = agent.reply(move_msg)

    assert agent.game_end is True
    assert "wins" in response["content"]
    assert NAME_BLACK in response["content"]

def test_gomoku_draw_detection():
    """Test that draw detection still works correctly after fix."""
    from board_agent import BoardAgent, NAME_BLACK, NAME_WHITE, NAME_TO_PIECE

    board_size = 3  # Small board to easily fill
    agent = BoardAgent(name="host", board_size=board_size)

    # Fill the board without a win
    # Black and white alternate
    for row in range(board_size):
        for col in range(board_size):
            if (row + col) % 2 == 0:
                agent.board[row, col] = NAME_TO_PIECE[NAME_BLACK]
            else:
                agent.board[row, col] = NAME_TO_PIECE[NAME_WHITE]

    # Make a move that doesn't create a win but board is full
    # Find an empty spot (there shouldn't be any)
    # Actually the board is already full, so any move should be invalid.
    # Let's test that the draw detection works when the board is full after the move.
    # We'll reset the board and fill it except one spot.
    agent = BoardAgent(name="host", board_size=board_size)
    # Fill all but (0,0)
    for row in range(board_size):
        for col in range(board_size):
            if not (row == 0 and col == 0):
                if (row + col) % 2 == 0:
                    agent.board[row, col] = NAME_TO_PIECE[NAME_BLACK]
                else:
                    agent.board[row, col] = NAME_TO_PIECE[NAME_WHITE]

    # Now black makes the last move at (0,0) - no win, but board is full -> draw
    move_msg = {"name": NAME_BLACK, "content": (0, 0)}
    response = agent.reply(move_msg)

    # The game should end in a draw
    assert agent.game_end is True
    assert "draw" in response["content"].lower()[0m
