        board_size = 5
        agent = BoardAgent(name="board", board_size=board_size)

        # Place 4 black pieces on diagonal (0,0), (1,1), (2,2), (3,3)
        for i in range(4):
            agent.board[i, i] = NAME_TO_PIECE[NAME_BLACK]

        # Black makes a move at (4,4) to complete diagonal
        move_msg = {
            "name": NAME_BLACK,
            "content": (4, 4)
        }

        response = agent.reply(move_msg)

        # After fix, game_end should be True
        assert agent.game_end is True, "Diagonal win should be detected after board update"
        assert agent.board[4, 4] == NAME_TO_PIECE[NAME_BLACK]

    def test_game_continues_after_non_winning_move(self):
        """Ensure game continues normally when no win occurs."""
        board_size = 5
        agent = BoardAgent(name="board", board_size=board_size)

        # Black makes a move at (2,2)
        move_msg = {
            "name": NAME_BLACK,
            "content": (2, 2)
        }

        response = agent.reply(move_msg)

        # Game should not end
        assert agent.game_end is False
        # Board should be updated
        assert agent.board[2, 2] == NAME_TO_PIECE[NAME_BLACK]
        # Next player should be white
        # The response content should contain the board and prompt for white
        assert NAME_WHITE in response["content"] or "white" in response["content"].lower()

    def test_draw_detection(self):
        """Test that draw detection still works after the fix."""
        board_size = III  # Use a small board to easily fill
        agent = BoardAgent(name="board", board_size=board_size)

        # Fill the board completely with alternating colors (no win)
        # Create a pattern that doesn't have 5 in a row
        for row in range(board_size):
            for col in range(board_size):
                if (row + col) % 2 == 0:
                    agent.board[row, col] = NAME_TO_PIECE[NAME_BLACK]
                else:
                    agent.board[row, col] = NAME_TO_PIECE[NAME_WHITE]

        # Remove one piece to make a move possible
        agent.board[0, 0] = 0

        # Black makes the last move at (0,0)
        move_msg = {
            "name": NAME_BLACK,
            "content": (0, 0)
        }

        response = agent.reply(move_msg)

        # After the move, board is full and no win -> should be draw
        assert agent.game_end is True
        assert "draw" in response["content"].lower()

    def test_win_takes_precedence_over_draw(self):
        """If a move causes both a win and fills the board, win should be announced."""
        board_size = 5
        agent = BoardAgent(name="board", board_size=board_size)

        # Fill board except one spot, and create a winning situation
        # Place black pieces in row 0, columns 0-3 (4 pieces)
        for col in range(4):
            agent.board[0, col] = NAME_TO_PIECE[NAME_BLACK]

        # Fill rest of board with alternating colors (no other wins)
        for row in range(1, board_size):
            for col in range(board_size):
                if (row + col) % 2 == 0:
                    agent.board[row, col] = NAME_TO_PIECE[NAME_BLACK]
                else:
                    agent.board[row, col] = NAME_TO_PIECE[NAME_WHITE]

        # Ensure the winning spot (0,4) is empty
        assert agent.board[0, 4] == 0

        # Black makes winning move at (0,4) which also fills the board
        move_msg = {
            "name": NAME_BLACK,
            "content": (0, 4)
        }

        response = agent.reply(move_msg)

        # Should announce win, not draw
        assert agent.game_end is True
        assert "wins" in response["content"].lower()
        assert NAME_BLACK.lower() in response["content"].lower()[0m
