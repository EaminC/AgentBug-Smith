from agentscope.message import Msg


def test_check_win_before_board_update_bug():
    """
    Test that the buggy code fails to detect a win when the winning move
    creates a five-in-a-row that includes the current move.
    In buggy version, check_win is called BEFORE the board is updated,
    so the current move is not counted, causing false negative.
    In fixed version, board is updated first, then check_win works correctly.
    """
    # Create a 15x15 board (default size)
    agent = BoardAgent(name="board", board_size=15)

    # Simulate a scenario where black places a stone that completes a five-in-a-row.
    # We'll manually set up the board to have four black stones in a row horizontally.
    # Positions: (7,5), (7,6), (7,7), (7,8) are black.
    # Then black's move at (7,9) should win.
    agent.board[7, 5] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 6] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 7] = NAME_TO_PIECE[NAME_BLACK]
    agent.board[7, 8] = NAME_TO_PIECE[NAME_BLACK]
    # (7,9) is empty.

    # Send a move from black at (7,9)
    move_msg = Msg(
        name=NAME_BLACK,
        content=[7, 9],
        role="user",
    )

    # Call reply with the move.
    # In buggy version, check_win is called before board[7,9] is set to black,
    # so it will not see five in a row and will not set game_end.
    # In fixed version, board is updated first, then check_win sees the win.
    response = agent.reply(move_msg.to_dict())

    # The buggy version will NOT have set game_end to True.
    # The fixed version will have game_end True.
    # We assert that game_end is True (expect pass after fix, fail before fix).
    assert agent.game_end is True, "Game should have ended with a win for black"

    # Additionally, the content should contain "wins!"
    # In buggy version, content will be the normal board prompt.
    # In fixed version, content will be the win message.
    # We can check that the response content contains "wins".
    # The reply method returns a dict with key "content".
    # Actually reply returns the agent itself? Let's inspect: board_agent's reply returns dict? No, it returns self.
    # The method ends with `return self`.
    # So we need to check the last spoken message.
    # Instead, we can check the content of the message that the agent spoke.
    # But simpler: we can check that the win detection happened.
    # Since we already assert game_end, that's enough for fail2pass.
    # However, to be thorough, we can also verify that the win detection logic
    # in check_win works when the board is updated.
    # Let's also directly call check_win after the board is updated.
    # This is just to confirm the logic.
    win_detected = agent.check_win(7, 9, NAME_TO_PIECE[NAME_BLACK])
    assert win_detected is True, "check_win should detect five in a row after board update"


def test_check_win_vertical():
    """Test vertical five-in-a-row detection after fix."""
    agent = BoardAgent(name="board", board_size=15)
    # Set four white stones vertically at col 3
    agent.board[2, 3] = NAME_TO_PIECE[NAME_WHITE]
    agent.board[3, 3] = NAME_TO_PIECE[NAME_WHITE]
    agent.board[4, 3] = NAME_TO_PIECE[NAME_WHITE]
    agent.board[5, 3] = NAME_TO_PIECE[NAME_WHITE]
    # White moves at (6,3)
    move_msg = Msg(
        name=NAME_WHITE,
        content=[6, 3],
        role="user",
