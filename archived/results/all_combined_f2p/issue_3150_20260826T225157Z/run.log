[32mimport pytest

import strands
from strands import Agent
from strands._middleware.stages import AgentStreamContext, MiddlewareInterruptResult
from strands.interrupt import Interrupt, InterruptException


def test_agent_stream_context_interrupt_raises_and_resumes():
    """Test that AgentStreamContext.interrupt raises InterruptException on first call and returns response on resume."""

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    # InterruptException is raised on first call (no response)
    with pytest.raises(InterruptException):
        ctx.interrupt("test_interrupt", reason="testing")

    # Prepare resumed context with stored interrupt response
    interrupt_id = ctx._interrupt_id("test_interrupt")
    resumed_ctx = AgentStreamContext(
        agent=None,
        messages=[],
        invocation_state={},
        _interrupts={interrupt_id: Interrupt(id=interrupt_id, name="test_interrupt", response="approved")},
    )

    result = resumed_ctx.interrupt("test_interrupt")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "approved"


def test_agent_stream_context_interrupt_with_preemptive_response():
    """Test that providing a preemptive response returns it without raising."""

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    result = ctx.interrupt("preemptive_interrupt", reason="testing", response="auto-approved")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "auto-approved"


def test_agent_stream_context_interrupt_id_stability():
    """Test that interrupt IDs are stable and namespaced."""

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    id1 = ctx._interrupt_id("gate")
    id2 = ctx._interrupt_id("gate")
    id3 = ctx._interrupt_id("other_gate")

    assert id1 == id2
    assert id1 != id3
    assert id1.startswith("v1:middleware_agent_stream:")


def test_agent_stream_context_interrupt_resolution_precedence():
    """Test that stored human response takes precedence over preemptive response."""

    interrupt_id = "v1:middleware_agent_stream:" + "dummyid"
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="gate", response="DENIED")}

    # Create a context with interrupts dict containing a stored response
    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts=interrupts)

    # Even if preemptive response is provided, stored response takes precedence
    result = ctx.interrupt("gate", response="auto-approve")
    assert result == MiddlewareInterruptResult(response="DENIED")


def test_agent_stream_context_interrupt_raises_if_no_response():
    """Test that interrupt raises if no stored or preemptive response."""

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    with pytest.raises(InterruptException):
        ctx.interrupt("no_response_interrupt")


@pytest.mark.asyncio
async def test_agent_stream_stage_middleware_interrupt_flow():
    """Test a middleware interrupt on AgentStreamStage halts the agent and returns interrupt info."""

    @strands.tool(name="dummy_tool")
    def dummy_tool() -> str:
        return "done"

    # Use a simple model that returns a toolUse message and then a final message
    from tests.fixtures.mocked_model_provider import MockedModelProvider

    tool_use_msg = {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": "tool_1", "name": "dummy_tool", "input": {}}}],
    }
    final_msg = {"role": "assistant", "content": [{"text": "final"}]}
    model = MockedModelProvider([tool_use_msg, final_msg])

    agent = Agent(model=model, tools=[dummy_tool], callback_handler=None)

    interrupt_called = False

    async def interrupting_middleware(context: AgentStreamContext, next_fn):
        nonlocal interrupt_called
        context.interrupt("agent_stream_gate", reason="approval needed")
        interrupt_called = True
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware("agentStream", interrupting_middleware)

    # Run agent, expect interrupt stop_reason and interrupt recorded
    result = agent("test input")
    assert result.stop_reason == "interrupt"
    assert interrupt_called
    assert len(result.interrupts) == 1
    assert result.interrupts[0].name == "agent_stream_gate"


def test_agent_stream_context_repr_excludes_interrupts():
    """Test that AgentStreamContext repr excludes _interrupts field."""

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={"id": Interrupt(id="id", name="name")})
    repr_str = repr(ctx)
    assert "_interrupts" not in repr_str


def test_agent_stream_context_interrupt_reason_and_response():
    """Test interrupt reason and response are correctly passed and returned."""

    interrupt_id = "v1:middleware_agent_stream:" + "dummyid"
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="gate", response="user_response")}

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts=interrupts)

    result = ctx.interrupt("gate", reason="please approve")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "user_response"


def test_agent_stream_context_interrupt_raises_runtime_error_after_stop_event():
    """Test that interrupt raises RuntimeError if called after pass has ended (simulated)."""

    # This behavior is documented but the actual RuntimeError raising is done by run loop,
    # so here we just test that interrupt can be called multiple times with response.

    interrupt_id = "v1:middleware_agent_stream:" + "dummyid"
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="gate", response="response")}

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts=interrupts)

    # First call returns response
    result1 = ctx.interrupt("gate")
    assert result1.response == "response"

    # Second call returns response again (idempotent)
    result2 = ctx.interrupt("gate")
    assert result2.response == "response"[0m
