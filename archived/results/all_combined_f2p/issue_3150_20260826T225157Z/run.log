from strands import Agent
from strands._middleware.stages import AgentStreamStage, MiddlewareInterruptResult
from strands.interrupt import InterruptException
import pytest


def test_agent_stream_stage_interrupt_raises_and_resumes():
    """Test that AgentStreamStage interrupt raises InterruptException on first call and resumes with response."""

    # Dummy agent that yields a fixed event loop stop event at the end
    class DummyAgent:
        def __init__(self):
            self._interrupts = {}

        async def run_stream(self, context):
            # Middleware chain simulation: call middleware, then yield a final event
            try:
                # Middleware calls interrupt, which should raise InterruptException
                context.interrupt("test_interrupt", reason="testing interrupt")
            except InterruptException as e:
                # Register interrupt with response None initially
                self._interrupts[e.interrupt.id] = e.interrupt
                raise
            yield {"result": "final"}

    dummy_agent = DummyAgent()

    # Create an AgentStreamContext with empty interrupts dict
    from strands._middleware.stages import AgentStreamContext

    context = AgentStreamContext(
        agent=dummy_agent,
        messages=[],
        invocation_state={},
        _interrupts={},
    )

    # First call: interrupt should raise InterruptException
    with pytest.raises(InterruptException):
        context.interrupt("test_interrupt", reason="testing interrupt")

    # Simulate resuming with a response
    interrupt_id = context._interrupt_id("test_interrupt")
    resumed_context = AgentStreamContext(
        agent=dummy_agent,
        messages=[],
        invocation_state={},
        _interrupts={interrupt_id: dummy_agent._interrupts.get(interrupt_id) or None},
    )
    # Manually set the response on the interrupt to simulate user response
    resumed_context._interrupts[interrupt_id] = resumed_context._interrupts.get(interrupt_id) or None
    if resumed_context._interrupts[interrupt_id] is None:
        from strands.interrupt import Interrupt
        resumed_context._interrupts[interrupt_id] = Interrupt(id=interrupt_id, name="test_interrupt", response="user_response")
    else:
        resumed_context._interrupts[interrupt_id].response = "user_response"

    result = resumed_context.interrupt("test_interrupt", reason="testing interrupt")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "user_response"


def test_agent_stream_stage_interrupt_id_stability():
    """Test that AgentStreamContext._interrupt_id returns stable and namespaced ids."""
    from strands._middleware.stages import AgentStreamContext

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})
    id1 = ctx._interrupt_id("gate")
    id2 = ctx._interrupt_id("gate")
    id3 = ctx._interrupt_id("other_gate")

    assert id1.startswith("v1:middleware_agent_stream:")
    assert id1 == id2
    assert id1 != id3


def test_agent_stream_stage_interrupt_preemptive_response():
    """Test that providing a preemptive response returns it without raising."""

    from strands._middleware.stages import AgentStreamContext

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    result = ctx.interrupt("gate", response="preapproved")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "preapproved"


def test_agent_stream_stage_interrupt_raises_without_response():
    """Test that interrupt raises InterruptException if no prior response or preemptive response."""

    from strands._middleware.stages import AgentStreamContext
    from strands.interrupt import InterruptException

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    with pytest.raises(InterruptException):
        ctx.interrupt("gate")


def test_agent_stream_stage_interrupt_with_existing_response():
    """Test that interrupt returns stored response if present."""

    from strands._middleware.stages import AgentStreamContext, MiddlewareInterruptResult
    from strands.interrupt import Interrupt

    interrupt_id = "v1:middleware_agent_stream:" + "dummyid"
    stored_interrupt = Interrupt(id=interrupt_id, name="gate", response="stored_response")

    ctx = AgentStreamContext(
        agent=None,
        messages=[],
        invocation_state={},
        _interrupts={interrupt_id: stored_interrupt},
    )

    result = ctx.interrupt("gate")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "stored_response"[0m
