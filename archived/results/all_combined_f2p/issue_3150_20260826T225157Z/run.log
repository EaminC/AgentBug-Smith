[32mimport pytest

from strands._middleware.stages import AgentStreamContext, MiddlewareInterruptResult
from strands.interrupt import Interrupt, InterruptException


def test_stored_human_response_takes_precedence_over_preemptive():
    """A stored human response must win over a middleware's preemptive response=.

    Guards against accidentally swapping the two checks in _resolve_middleware_interrupt,
    which would let a middleware default silently override a human decision.
    """
    interrupt_id = "v1:middleware_execute_tool:tool_1:test-gate"
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="gate", response="DENIED")}

    result = AgentStreamContext._resolve_middleware_interrupt(
        interrupts, interrupt_id, "gate", None, "auto-approve"
    )

    assert result == MiddlewareInterruptResult(response="DENIED")


def test_agent_stream_context_interrupt_id_and_resolution():
    """AgentStreamContext.interrupt raises, resolves, and produces a stable namespaced id."""

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    interrupt_id = ctx._interrupt_id("gate")
    assert interrupt_id.startswith("v1:middleware_agent_stream:")
    # The id is stable for the same name
    assert interrupt_id == ctx._interrupt_id("gate")

    # Interrupt without response raises InterruptException
    with pytest.raises(InterruptException):
        ctx.interrupt("gate")

    # Interrupt with stored response returns MiddlewareInterruptResult
    resumed = AgentStreamContext(
        agent=None,
        messages=[],
        invocation_state={},
        _interrupts={interrupt_id: Interrupt(id=interrupt_id, name="gate", response="ok")},
    )
    result = resumed.interrupt("gate")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "ok"


def test_agent_stream_stage_interrupt_with_existing_response():
    """Test that interrupt returns stored response if present."""

    interrupt_id = "v1:middleware_agent_stream:" + "dummyid"
    stored_interrupt = Interrupt(id=interrupt_id, name="gate", response="stored_response")

    ctx = AgentStreamContext(
        agent=None,
        messages=[],
        invocation_state={},
        _interrupts={interrupt_id: stored_interrupt},
    )

    # The interrupt id generated by _interrupt_id differs from the dummyid suffix,
    # so we patch _interrupt_id to return our known id for this test.
    original_interrupt_id_method = ctx._interrupt_id
    ctx._interrupt_id = lambda name: interrupt_id

    try:
        result = ctx.interrupt("gate")
        assert isinstance(result, MiddlewareInterruptResult)
        assert result.response == "stored_response"
    finally:
        ctx._interrupt_id = original_interrupt_id_method


def test_agent_stream_stage_interrupt_raises_without_response():
    """Test that interrupt raises InterruptException if no response is stored or provided."""

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    with pytest.raises(InterruptException):
        ctx.interrupt("gate")


def test_agent_stream_stage_interrupt_with_preemptive_response():
    """Test that interrupt returns preemptive response if no stored response."""

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    # Patch _interrupt_id to a fixed value to avoid randomness
    original_interrupt_id_method = ctx._interrupt_id
    ctx._interrupt_id = lambda name: "v1:middleware_agent_stream:fixedid"

    try:
        result = ctx.interrupt("gate", response="pre-approved")
        assert isinstance(result, MiddlewareInterruptResult)
        assert result.response == "pre-approved"
    finally:
