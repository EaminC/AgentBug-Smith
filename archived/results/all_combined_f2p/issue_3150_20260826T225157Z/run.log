from strands import Agent
from strands._middleware.stages import AgentStreamStage, AgentStreamContext, MiddlewareInterruptResult
from strands.interrupt import InterruptException
import pytest
import asyncio


@pytest.mark.asyncio
async def test_agent_stream_stage_interrupt_behavior():
    """
    Test that AgentStreamStage middleware can interrupt the agent stream,
    raising InterruptException on first call and returning the response on resume.
    """

    # Create a dummy agent with no tools and a dummy model that yields a simple event loop stop event.
    class DummyModel:
        def __call__(self, *args, **kwargs):
            # Return a dummy result with stop_reason 'end_turn'
            class DummyResult:
                stop_reason = "end_turn"
                interrupts = []
            return DummyResult()

        async def stream(self, *args, **kwargs):
            # Async generator yielding a single dummy event and then stopping
            yield {"dummy_event": True}
            return

    agent = Agent(model=DummyModel(), tools=[], callback_handler=None)

    # Prepare a middleware that interrupts on first call
    async def interrupting_middleware(context: AgentStreamContext, next_fn):
        # On first call, interrupt without a response to raise InterruptException
        context.interrupt("test_interrupt", reason="Testing interrupt")
        async for event in next_fn(context):
            yield event

    # Add the middleware to the AgentStreamStage
    agent._middleware_registry.add_middleware(AgentStreamStage, interrupting_middleware)

    # First call: should raise InterruptException and halt
    with pytest.raises(InterruptException):
        # Call the agent asynchronously to trigger the middleware
        async for _ in agent.stream_async("hello"):
            pass

    # Simulate a resume with a response to the interrupt
    interrupt_id_prefix = "v1:middleware_agent_stream:"
    # The interrupt id is deterministic based on the name, so we can reconstruct it
    from uuid import uuid5, NAMESPACE_OID

    interrupt_id = f"{interrupt_id_prefix}{uuid5(NAMESPACE_OID, 'test_interrupt')}"

    # Provide the interrupt response to resume
    resume_input = [{"interruptResponse": {"interruptId": interrupt_id, "response": "approved"}}]

    # Track the response received by the middleware
    received_response = None

    async def middleware_with_response(context: AgentStreamContext, next_fn):
        nonlocal received_response
        result = context.interrupt("test_interrupt", reason="Testing interrupt")
        received_response = result.response
        async for event in next_fn(context):
            yield event

    # Clear previous middlewares and add the new one
    agent._middleware_registry._middleware[AgentStreamStage] = []
    agent._middleware_registry.add_middleware(AgentStreamStage, middleware_with_response)

    # Call the agent with the resume input, should not raise and should return the response
    result = agent(resume_input)
    assert result.stop_reason == "end_turn"
    assert received_response == "approved"


def test_agent_stream_context_interrupt_id_stability_and_resolution():
    """
    Test that AgentStreamContext interrupt IDs are stable and that interrupt resolution behaves correctly.
    """
    from strands._middleware.stages import _resolve_middleware_interrupt
    from strands.interrupt import Interrupt

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    # Interrupt ID should start with the agent stream prefix and be stable
    interrupt_id_1 = ctx._interrupt_id("gate")
    interrupt_id_2 = ctx._interrupt_id("gate")
    assert interrupt_id_1.startswith("v1:middleware_agent_stream:")
    assert interrupt_id_1 == interrupt_id_2

    # Interrupt without response should raise InterruptException
    with pytest.raises(InterruptException):
        ctx.interrupt("gate")

    # Provide a stored interrupt with a response and check resolution returns it
    stored_interrupts = {interrupt_id_1: Interrupt(id=interrupt_id_1, name="gate", response="ok")}
    resumed_ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts=stored_interrupts)
    result = resumed_ctx.interrupt("gate")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "ok"


def test_resolve_middleware_interrupt_precedence():
    """
    Test that stored human response takes precedence over preemptive middleware response in _resolve_middleware_interrupt.
    """
    from strands._middleware.stages import _resolve_middleware_interrupt
    from strands._middleware.stages import MiddlewareInterruptResult
    from strands.interrupt import Interrupt

    interrupt_id = "v1:middleware_execute_tool:tool_1:test-gate"
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="gate", response="DENIED")}

    # Even if middleware provides a preemptive response, stored human response should be returned
    result = _resolve_middleware_interrupt(interrupts, interrupt_id, "gate", None, "auto-approve")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "DENIED"[0m
