import strands
from strands import Agent
from strands._middleware.stages import ExecuteToolStage, MiddlewareInterruptResult
from strands.interrupt import InterruptException
from strands.types._events import ToolResultEvent


@pytest.fixture
def calculator_tool():
    @strands.tool(name="calculator")
    def func(expression: str) -> str:
        """Evaluate a math expression."""
        return str(eval(expression))

    return func


@pytest.fixture
def agent(calculator_tool):
    # Use a simple model that calls the calculator tool once and then returns a final message.
    from tests.fixtures.mocked_model_provider import MockedModelProvider

    tool_use_msg = {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": "tool_1", "name": "calculator", "input": {"expression": "2+2"}}}],
    }
    final_msg = {"role": "assistant", "content": [{"text": "The answer is 4."}]}
    model = MockedModelProvider([tool_use_msg, final_msg])
    return Agent(model=model, tools=[calculator_tool], callback_handler=None)


def test_execute_tool_stage_interrupt_short_circuits_tool(agent):
    """Middleware interrupt on ExecuteToolStage short-circuits tool execution and halts agent."""

    tool_executed = False

    @strands.tool(name="tracked_tool")
    def tracked_tool() -> str:
        nonlocal tool_executed
        tool_executed = True
        return "done"

    # Replace tools with tracked_tool for this test
    agent._tools = [tracked_tool]

    async def interrupting_middleware(context, next_fn):
        context.interrupt("block", reason="interrupting for test")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, interrupting_middleware)

    result = agent("do something")

    assert result.stop_reason == "interrupt"
    assert not tool_executed
    assert len(result.interrupts) == 1
    assert result.interrupts[0].name == "block"


@pytest.mark.asyncio
async def test_execute_tool_stage_interrupt_yields_event(agent):
    """The ExecuteToolStage middleware interrupt yields a ToolInterruptEvent mid-stream."""

    async def interrupting_middleware(context, next_fn):
        context.interrupt("interrupt_midstream", reason="testing midstream interrupt")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, interrupting_middleware)

    events = []
    async for event in agent.stream_async("calc 2+2"):
        events.append(event)

    # There should be at least one ToolInterruptEvent with the interrupt name
    interrupt_events = [event for event in events if "tool_interrupt_event" in event]
    assert len(interrupt_events) == 1
    interrupt_names = [interrupt.name for interrupt in interrupt_events[0]["tool_interrupt_event"]["interrupts"]]
    assert "interrupt_midstream" in interrupt_names

    # The last event should have stop_reason "interrupt"
    assert any(getattr(event.get("result", None), "stop_reason", None) == "interrupt" for event in events)


def test_execute_tool_stage_interrupt_resume_response(agent):
    """After an interrupt, resuming with a response returns that response and continues execution."""

    final_msg = {"role": "assistant", "content": [{"text": "The answer is 4."}]}
    from tests.fixtures.mocked_model_provider import MockedModelProvider

    # Model that calls tool once, then returns final_msg twice (for resume)
    tool_use_msg = {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": "tool_1", "name": "calculator", "input": {"expression": "2+2"}}}],
    }
    model = MockedModelProvider([tool_use_msg, final_msg, final_msg])
    agent = Agent(model=model, tools=agent._tools, callback_handler=None)

    received_response = None

    async def gate(context, next_fn):
        nonlocal received_response
        interrupt_result = context.interrupt("approve_calc", reason="Confirm?")
        received_response = interrupt_result.response
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, gate)

    # First call triggers interrupt
    result = agent("what is 2+2?")
    assert result.stop_reason == "interrupt"
    assert len(result.interrupts) == 1

    # Resume with response
    result = agent([{"interruptResponse": {"interruptId": result.interrupts[0].id, "response": "yes"}}])
    assert received_response == "yes"
    assert result.stop_reason == "end_turn"


def test_execute_tool_stage_interrupt_denial_blocks_tool(agent):
    """Middleware interrupt denial returns an error result and blocks tool execution."""

    tool_executed = False
    original_stream = agent._tools[0].stream

    async def tracking_stream(*args, **kwargs):
        nonlocal tool_executed
        tool_executed = True
        async for event in original_stream(*args, **kwargs):
            yield event

    agent._tools[0].stream = tracking_stream

    async def approval_gate(context, next_fn):
        interrupt_result = context.interrupt("approve", reason="Allow?")
        if interrupt_result.response != "yes":
            yield ToolResultEvent(
                {
                    "toolUseId": context.tool_use["toolUseId"],
                    "status": "error",
                    "content": [{"text": "Denied by middleware"}],
                }
            )
            return
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, approval_gate)

    # First call triggers interrupt
    result = agent("calc")
    assert result.stop_reason == "interrupt"

    # Resume with denial response
    result = agent([{"interruptResponse": {"interruptId": result.interrupts[0].id, "response": "no"}}])
    assert not tool_executed
    assert any("Denied by middleware" in c.get("text", "") for c in result.content)


def test_execute_tool_stage_interrupt_approval_executes_tool(agent):
    """When middleware receives approval, the tool actually executes."""

    tool_executed = False
    original_stream = agent._tools[0].stream

    async def tracking_stream(*args, **kwargs):
        nonlocal tool_executed
        tool_executed = True
        async for event in original_stream(*args, **kwargs):
            yield event

    agent._tools[0].stream = tracking_stream

    async def approval_gate(context, next_fn):
        interrupt_result = context.interrupt("approve", reason="Allow?")
        if interrupt_result.response != "yes":
            yield ToolResultEvent(
                {
                    "toolUseId": context.tool_use["toolUseId"],
                    "status": "error",
                    "content": [{"text": "Denied"}],
                }
            )
            return
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, approval_gate)

    # First call triggers interrupt
    result = agent("calc")
    assert result.stop_reason == "interrupt"

    # Resume with approval response
    result = agent([{"interruptResponse": {"interruptId": result.interrupts[0].id, "response": "yes"}}])
    assert tool_executed
    assert result.stop_reason == "end_turn" or result.stop_reason == "complete"


@pytest.mark.asyncio
async def test_agent_stream_stage_interrupt_behavior(agent):
    """Test that AgentStreamStage middleware can interrupt the whole agent pass and resume."""

    from strands._middleware.stages import AgentStreamStage
    from strands.interrupt import InterruptException

    responses = []

    async def interrupting_middleware(ctx, next_fn):
        try:
            interrupt_result = ctx.interrupt("agent_stream_gate", reason="Confirm agent pass?")
            responses.append(interrupt_result.response)
        except InterruptException:
            # Interrupt raised, yield nothing further
            return
        async for event in next_fn(ctx):
            yield event

    agent._middleware_registry.add_middleware(AgentStreamStage, interrupting_middleware)

    # First call triggers interrupt, should stop with reason "interrupt"
    result = agent("calculate 2+2")
    assert result.stop_reason == "interrupt"

    # Resume with response
    result = agent([{"interruptResponse": {"interruptId": result.interrupts[0].id, "response": "approved"}}])
    assert responses == ["approved"]
    assert result.stop_reason == "end_turn" or result.stop_reason == "complete"


def test_middleware_interrupt_id_is_deterministic(agent):
    """The interrupt ID is namespaced by tool_use_id and stable."""

    async def gate(context, next_fn):
        context.interrupt("my_gate", reason="check")
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, gate)

    result = agent("what is 2+2?")
    assert result.interrupts[0].id.startswith("v1:middleware_execute_tool:tool_1:")
    # Calling interrupt again with same name produces same id
    ctx = None
    async def capture_context(context, next_fn):
        nonlocal ctx
        ctx = context
        async for event in next_fn(context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, capture_context)
    agent("calc")
    id1 = ctx._interrupt_id("my_gate")
    id2 = ctx._interrupt_id("my_gate")
    assert id1 == id2


def test_context_replace_preserves_interrupt(agent):
    """dataclasses.replace() on ExecuteToolContext preserves interrupt functionality."""

    from dataclasses import replace

    interrupt_worked = False

    async def replace_then_interrupt(context, next_fn):
        nonlocal interrupt_worked
        new_context = replace(context, tool_use={**context.tool_use, "input": {"expression": "3+3"}})
        # interrupt() must still work on the replaced context (it carries _interrupt_state).
        new_context.interrupt("gate", reason="check")
        interrupt_worked = True
        async for event in next_fn(new_context):
            yield event

    agent._middleware_registry.add_middleware(ExecuteToolStage, replace_then_interrupt)

    result = agent("calc")
    assert result.stop_reason == "interrupt"
    assert not interrupt_worked

