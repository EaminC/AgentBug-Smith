import strands
from strands import Agent
from strands._middleware.stages import AgentStreamContext, ExecuteToolStage, MiddlewareInterruptResult
from strands.interrupt import Interrupt, InterruptException
from strands.types._events import EventLoopStopEvent, ToolResultEvent
from tests.fixtures.mocked_model_provider import MockedModelProvider


@pytest.fixture
def calculator_tool():
    @strands.tool(name="calculator")
    def func(expression: str) -> str:
        """Evaluate a math expression."""
        return str(eval(expression))

    return func


@pytest.fixture
def model():
    # Model that returns a toolUse message then a final assistant message
    tool_use_msg = {
        "role": "assistant",
        "content": [{"toolUse": {"toolUseId": "tool_1", "name": "calculator", "input": {"expression": "2+2"}}}],
    }
    final_msg = {"role": "assistant", "content": [{"text": "The answer is 4."}]}
    return MockedModelProvider([tool_use_msg, final_msg])


@pytest.fixture
def agent(model, calculator_tool):
    return Agent(model=model, tools=[calculator_tool], callback_handler=None)


@pytest.mark.asyncio
async def test_agent_stream_stage_interrupt_behavior(agent):
    """Test that AgentStreamStage middleware can interrupt the whole agent pass and resume."""

    # Middleware that interrupts on first call, then resumes with response
    responses = []

    async def interrupting_middleware(ctx: AgentStreamContext, next_fn):
        try:
            # Interrupt the agent stream with a named gate
            interrupt_result = ctx.interrupt("agent_stream_gate", reason="Confirm agent pass?")
            responses.append(interrupt_result.response)
        except InterruptException:
            # Interrupt raised, yield nothing further
            return
        async for event in next_fn(ctx):
            yield event

    # Add middleware to AgentStreamStage
    agent._middleware_registry.add_middleware("agentStream", interrupting_middleware)

    # First call triggers interrupt, should stop with reason "interrupt"
    result = agent("calculate 2+2")
    assert result.stop_reason == "interrupt"
    assert len(result.interrupts) == 1
    assert result.interrupts[0].name == "agent_stream_gate"
    assert responses == []

    # Resume with a response to the interrupt
    resumed_result = agent([{"interruptResponse": {"interruptId": result.interrupts[0].id, "response": "approved"}}])
    # The middleware should have received the response and continued
    assert resumed_result.stop_reason == "end_turn"
    assert responses == ["approved"]


def test_resolve_middleware_interrupt_precedence():
    """Test that stored human response takes precedence over preemptive response."""

    interrupt_id = "v1:middleware_execute_tool:tool_1:test-gate"
    interrupts = {interrupt_id: Interrupt(id=interrupt_id, name="test-gate", response="HUMAN_RESPONSE")}

    # Provide a preemptive response that should be ignored because human response exists
    result = strands._middleware.stages._resolve_middleware_interrupt(
        interrupts, interrupt_id, "test-gate", None, "PREEMPTIVE_RESPONSE"
    )
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "HUMAN_RESPONSE"


def test_agent_stream_context_interrupt_id_and_resolution():
    """Test AgentStreamContext interrupt id stability and interrupt resolution."""

    ctx = AgentStreamContext(agent=None, messages=[], invocation_state={}, _interrupts={})

    interrupt_id = ctx._interrupt_id("test_gate")
    assert interrupt_id.startswith("v1:middleware_agent_stream:")
    # Id should be stable for the same name
    assert interrupt_id == ctx._interrupt_id("test_gate")

    # Interrupt without response raises InterruptException
    with pytest.raises(InterruptException):
        ctx.interrupt("test_gate")

    # Interrupt with stored response returns MiddlewareInterruptResult
    resumed_ctx = AgentStreamContext(
        agent=None,
        messages=[],
        invocation_state={},
        _interrupts={interrupt_id: Interrupt(id=interrupt_id, name="test_gate", response="OK")},
    )
    result = resumed_ctx.interrupt("test_gate")
    assert isinstance(result, MiddlewareInterruptResult)
    assert result.response == "OK"[0m
