from strands.models import BedrockModel, CacheConfig


@pytest.mark.asyncio
async def test_cache_point_injection_before_reasoning_block(bedrock_client):
    """
    Test that when using BedrockModel with cache_config.strategy='auto',
    the cache point is injected into the last user message content before
    any reasoningContent block, not appended after it.

    This test triggers the buggy behavior before the fix (cache point appended after reasoningContent),
    which causes validation errors in Bedrock API.

    After the fix, the cache point is correctly inserted before reasoningContent,
    and the model invocation succeeds without validation errors.
    """
    # Prepare messages with last user message containing reasoningContent block
    messages = [
        {"role": "user", "content": [{"text": "Hello"}]},
        {"role": "assistant", "content": [{"text": "Hi there!"}]},
        {
            "role": "user",
            "content": [
                {"text": "Please think carefully."},
                {"reasoningContent": {"reasoningText": {"text": "Thinking...", "signature": "sig1"}}},
            ],
        },
    ]

    # Create BedrockModel with cache_config.strategy="auto"
    model = BedrockModel(
        model_id="us.anthropic.claude-sonnet-4-6",
        cache_config=CacheConfig(strategy="auto"),
    )

    # Call _format_bedrock_messages to get formatted messages with cache point injected
    formatted_messages = model._format_bedrock_messages(messages)

    # Find the last user message in formatted_messages
    last_user_msg = None
    for msg in reversed(formatted_messages):
        if msg.get("role") == "user":
            last_user_msg = msg
            break

    assert last_user_msg is not None, "No user message found in formatted messages"

    content = last_user_msg.get("content", [])
    assert content, "Last user message content is empty"

    # Find indices of reasoningContent blocks and cachePoint blocks
    reasoning_indices = [i for i, block in enumerate(content) if "reasoningContent" in block]
    cachepoint_indices = [i for i, block in enumerate(content) if "cachePoint" in block]

    # There must be exactly one reasoningContent block
    assert len(reasoning_indices) == 1, "Expected exactly one reasoningContent block"

    reasoning_idx = reasoning_indices[0]

    # There must be exactly one cachePoint block
    assert len(cachepoint_indices) == 1, "Expected exactly one cachePoint block"

    cachepoint_idx = cachepoint_indices[0]

    # The cachePoint block must be inserted before the reasoningContent block
    assert cachepoint_idx < reasoning_idx, (
        "Cache point must be inserted before reasoningContent block to avoid Bedrock API validation error"
    )

    # Also verify the cachePoint type is "default"
    cache_point_block = content[cachepoint_idx]["cachePoint"]
    assert cache_point_block.get("type") == "default", "Cache point type should be 'default'"

    # Additionally, try to invoke the model's stream method to ensure no validation error occurs
    # We mock the bedrock_client.converse_stream to simulate a successful response
    bedrock_client.converse_stream.return_value = {"stream": ["chunk1", "chunk2"]}

    # Call stream and collect results
    chunks = []
    async for chunk in model.stream(messages):
        chunks.append(chunk)

    # Assert that chunks are as mocked
    assert chunks == ["chunk1", "chunk2"], "Streamed chunks do not match expected mocked response"


@pytest.mark.asyncio
async def test_cache_point_not_appended_after_reasoning_block(bedrock_client):
    """
    Negative test to confirm that cache point is NOT appended after reasoningContent block.

    This test will fail on buggy code where cache point is appended after reasoningContent,
    causing Bedrock API validation error.
    """
    messages = [
        {"role": "user", "content": [{"text": "Hello"}]},
        {"role": "assistant", "content": [{"text": "Hi there!"}]},
        {
            "role": "user",
            "content": [
                {"text": "Please think carefully."},
                {"reasoningContent": {"reasoningText": {"text": "Thinking...", "signature": "sig1"}}},
            ],
        },
    ]

    model = BedrockModel(
        model_id="us.anthropic.claude-sonnet-4-6",
        cache_config=CacheConfig(strategy="auto"),
    )

    formatted_messages = model._format_bedrock_messages(messages)

    last_user_msg = None
    for msg in reversed(formatted_messages):
        if msg.get("role") == "user":
            last_user_msg = msg
            break

    content = last_user_msg.get("content", [])

    reasoning_indices = [i for i, block in enumerate(content) if "reasoningContent" in block]
    cachepoint_indices = [i for i, block in enumerate(content) if "cachePoint" in block]

    # This test expects the buggy behavior: cachePoint index > reasoningContent index (appended after)
    assert len(reasoning_indices) == 1
    assert len(cachepoint_indices) == 1

    reasoning_idx = reasoning_indices[0]
    cachepoint_idx = cachepoint_indices[0]

    # This assertion will fail after fix, but passes on buggy code
    assert cachepoint_idx > reasoning_idx, (
        "Cache point is appended after reasoningContent block (buggy behavior)"
    )

    # Try to invoke stream, expecting a validation error (simulate by raising exception)
    def raise_validation_error(*args, **kwargs):
        from botocore.exceptions import ClientError

        error_response = {
            "Error": {
                "Code": "ValidationException",
                "Message": "Cache point cannot be inserted after reasoning block",
            }
        }
        raise ClientError(error_response, "ConverseStream")

    bedrock_client.converse_stream.side_effect = raise_validation_error

    with pytest.raises(Exception) as excinfo:
        async for _ in model.stream(messages):
            pass

    assert "Cache point cannot be inserted after reasoning block" in str(excinfo.value)


@pytest.mark.asyncio
async def test_cache_point_injection_with_multiple_user_messages(bedrock_client):
    """
    Test that cache point is injected only into the last user message with content,
    and not into assistant messages or earlier user messages.
    """
    messages = [
        {"role": "user", "content": [{"text": "First user message"}]},
        {"role": "assistant", "content": [{"text": "Assistant reply"}]},
        {"role": "user", "content": [{"text": "Second user message"}]},
        {"role": "assistant", "content": [{"text": "Second assistant reply"}]},
        {
            "role": "user",
            "content": [
                {"text": "Third user message"},
                {"reasoningContent": {"reasoningText": {"text": "Thinking...", "signature": "sig2"}}},
            ],
        },
    ]

    model = BedrockModel(
        model_id="us.anthropic.claude-sonnet-4-6",
        cache_config=CacheConfig(strategy="auto"),
    )

    formatted_messages = model._format_bedrock_messages(messages)

    # Check that only the last user message has cachePoint inserted before reasoningContent
    for idx, msg in enumerate(formatted_messages):
        if msg["role"] == "user":
            content = msg.get("content", [])
            cachepoint_blocks = [block for block in content if "cachePoint" in block]
            reasoning_blocks = [block for block in content if "reasoningContent" in block]

            if idx == len(formatted_messages) - 1:
                # Last user message: must have cachePoint before reasoningContent
                assert len(cachepoint_blocks) == 1, "Last user message should have one cachePoint"
                assert len(reasoning_blocks) == 1, "Last user message should have one reasoningContent"
                cachepoint_idx = content.index(cachepoint_blocks[0])
                reasoning_idx = content.index(reasoning_blocks[0])
                assert cachepoint_idx < reasoning_idx, "Cache point must be before reasoningContent"
            else:
                # Earlier user messages: no cachePoint
                assert len(cachepoint_blocks) == 0, "Earlier user messages should not have cachePoint"


