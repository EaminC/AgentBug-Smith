@pytest.mark.asyncio
async def test_cache_point_injection_with_no_content_blocks():
    """
    Test that cache point injection does not fail when last user message has empty content list.
    """
    messages = [
        {"role": "user", "content": [{"text": "Hello"}]},
        {"role": "assistant", "content": [{"text": "Hi"}]},
        {"role": "user", "content": []},
