  @pytest.mark.asyncio
  async def test_cache_point_injection_with_no_content_blocks(bedrock_client):
      """
      Test that cache point injection does not fail when last user message has empty content list.
      """
      messages = [
          {"role": "user", "content": [{"text": "Hello"}]},
          {"role": "assistant", "content": [{"text": "Hi"}]},
          {"role": "user", "content": []},
      ]

      model = BedrockModel(
          model_id="us.anthropic.claude-sonnet-4-6",
          cache_config=CacheConfig(strategy="auto"),
      )

      # Should not raise any exception
      formatted_messages = model._format_bedrock_messages(messages)

      last_user_msg = None
      for msg in reversed(formatted_messages):
          if msg.get("role") == "user":
              last_user_msg = msg
              break

      # The content list should have one cachePoint block appended since it was empty initially
      content = last_user_msg.get("content", [])
      cachepoint_blocks = [block for block in content if "cachePoint" in block]

      assert len(cachepoint_blocks) == 1, "Cache point should be appended even if content was initially empty"
