@pytest.mark.asyncio
async def test_cache_point_injection_preserves_other_content_blocks(claude_model):
    """
    Test that cache point injection does not remove or alter other content blocks in the last user message.
    """
    messages = [
        {"role": "user", "content": [{"text": "Hello"}, {"image": {"format": "png", "source": {"bytes": b"img"}}}]},
        {"role": "assistant", "content": [{"text": "Response"}]},
        {"role": "user", "content": [{"text": "Follow up"}, {"image": {"format": "png", "source": {"bytes": b"img2"}}}]},
    ]

    formatted = claude_model._format_bedrock_messages(copy.deepcopy(messages))

    last_user_idx = None
    for idx in reversed(range(len(formatted))):
        if formatted[idx]["role"] == "user":
            last_user_idx = idx
            break

    assert last_user_idx is not None

    last_user_content = formatted[last_user_idx]["content"]

    # Check that original content blocks remain
    texts = [block.get("text") for block in last_user_content if "text" in block]
    images = [block.get("image") for block in last_user_content if "image" in block]

    assert "Follow up" in texts
    assert any(img for img in images if img and img.get("format") == "png")

    # Check cachePoint is appended
    assert any("cachePoint" in block for block in last_user_content), "Cache point not injected in last user message"


