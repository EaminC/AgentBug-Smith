  async def test_cache_point_injection_with_non_auto_strategy_no_injection(bedrock_client):
      """
      Test that when cache_config.strategy is not 'auto' or 'anthropic',
      no cache point is injected.
      """
      messages = [
          {"role": "user", "content": [{"text": "Hello"}]},
          {"role": "assistant", "content": [{"text": "Hi"}]},
          {
              "role": "user",
              "content": [
                  {"text": "Please think carefully."},
                  {"reasoningContent": {"reasoningText": {"text": "Thinking...", "signature": "sig8"}}},
              ],
          },
      ]

      model = BedrockModel(
          model_id="us.anthropic.claude-sonnet-4-6",
          cache_config=CacheConfig(strategy="none"),
      )

      formatted_messages = model._format_bedrock_messages(messages)

      # No cachePoint blocks should be present anywhere
      for msg in formatted_messages:
          content = msg.get("content", [])
          for block in content:
              assert "cachePoint" not in block, "No cachePoint should be injected when strategy is not 'auto' or 'anthropic'"
