@pytest.mark.asyncio
async def test_cache_point_injection_with_multiple_reasoning_blocks(bedrock_client):
    """
    Test that cache point is inserted before the first reasoningContent block
    when multiple reasoningContent blocks are present in last user message.
    """
    messages = [
        {"role": "user", "content": [{"text": "Hello"}]},
        {"role": "assistant", "content": [{"text": "Hi"}]},
        {
            "role": "user",
            "content": [
                {"text": "Please think carefully."},
                {"reasoningContent": {"reasoningText": {"text": "Thinking part 1", "signature": "sig6"}}},
                {"reasoningContent": {"reasoningText": {"text": "Thinking part 2", "signature": "sig7"}}},
            ],
        },
    ]

    model = BedrockModel(
        model_id="us.anthropic.claude-sonnet-4-6",
        cache_config=CacheConfig(strategy="auto"),
    )

    formatted_messages = model._format_bedrock_messages(messages)

    last_user_msg = None
    for msg in reversed(formatted_messages):
        if msg.get("role") == "user":
            last_user_msg = msg
            break

    content = last_user_msg.get("content", [])

    reasoning_indices = [i for i, block in enumerate(content) if "reasoningContent" in block]
    cachepoint_indices = [i for i, block in enumerate(content) if "cachePoint" in block]

    assert len(reasoning_indices) == 2
    assert len(cachepoint_indices) == 1

