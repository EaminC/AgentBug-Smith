import asyncio
from strands.models import BedrockModel, CacheConfig


@pytest.mark.asyncio
async def test_cache_point_injection_before_reasoning_block():
    """
    This test verifies that when using BedrockModel with cache_config.strategy='auto',
    the cache point is injected before any reasoningContent blocks in the last user message.

    Steps:
    1. Create a BedrockModel with model_id for Claude and cache_config.strategy='auto'.
    2. Prepare messages with an assistant message containing reasoningContent block.
    3. Call _format_bedrock_messages to trigger cache point injection.
    4. Assert that the cachePoint is inserted before the reasoningContent block,
       not after it.

    This test should fail on the buggy codebase because the cachePoint is appended
    after the reasoningContent block, causing API validation errors.
    After the fix, the cachePoint is inserted before reasoningContent, and the test passes.
    """
    model = BedrockModel(
        model_id="us.anthropic.claude-sonnet-4-6",
        cache_config=CacheConfig(strategy="auto"),
    )

    # Messages with an assistant message containing reasoningContent block at the end
    messages = [
        {"role": "user", "content": [{"text": "Hello"}]},
        {
            "role": "assistant",
            "content": [
                {"text": "Here is some answer."},
                {
                    "reasoningContent": {
                        "reasoningText": {"text": "Thinking deeply...", "signature": "sig123"}
                    }
                },
            ],
        },
        {"role": "user", "content": [{"text": "Thanks!"}]},
    ]

    # Format messages, which internally calls _inject_cache_point
    formatted_messages = model._format_bedrock_messages(messages)

    # Find the last user message in formatted_messages
    last_user_msg = None
    for msg in reversed(formatted_messages):
        if msg.get("role") == "user":
            last_user_msg = msg
            break

    assert last_user_msg is not None, "No user message found after formatting"

    content = last_user_msg.get("content", [])
    # Check that cachePoint is present in the last user message content
    cache_point_indices = [i for i, block in enumerate(content) if "cachePoint" in block]
    assert cache_point_indices, "cachePoint not found in last user message content"

    # Check that reasoningContent blocks are not after cachePoint in last user message
    reasoning_indices = [i for i, block in enumerate(content) if "reasoningContent" in block]

    # If reasoningContent exists, cachePoint should be before it
    if reasoning_indices:
        assert all(cp_idx < min(reasoning_indices) for cp_idx in cache_point_indices), (
            "cachePoint must be inserted before reasoningContent block in last user message"
        )

    # Also verify that the assistant message's content remains unchanged (no cachePoint added there)
    assistant_msgs = [msg for msg in formatted_messages if msg.get("role") == "assistant"]
    assert assistant_msgs, "No assistant message found after formatting"
    for assistant_msg in assistant_msgs:
        for block in assistant_msg.get("content", []):
            assert "cachePoint" not in block, "cachePoint should not be added to assistant messages"


@pytest.mark.asyncio
async def test_stream_invocation_with_cache_point_and_reasoning(monkeypatch):
    """
    This test verifies that invoking the stream method on BedrockModel with cache_config.strategy='auto'
    and messages containing assistant messages with reasoningContent does not raise API validation errors.

    It mocks the Bedrock client's converse_stream method to simulate a successful streaming response.

    This test should fail on the buggy codebase due to API validation errors caused by invalid cachePoint placement.
    After the fix, the test passes with no exceptions.
    """
    model = BedrockModel(
        model_id="us.anthropic.claude-sonnet-4-6",
        cache_config=CacheConfig(strategy="auto"),
    )

    # Prepare messages with assistant message containing reasoningContent block
    messages = [
        {"role": "user", "content": [{"text": "Hello"}]},
        {
            "role": "assistant",
            "content": [
                {"text": "Answer part 1."},
                {
                    "reasoningContent": {
                        "reasoningText": {"text": "Reasoning step 1", "signature": "sig1"}
                    }
                },
            ],
        },
        {"role": "user", "content": [{"text": "Continue"}]},
    ]

    # Mock the bedrock client converse_stream to simulate streaming response
    async def dummy_converse_stream(**kwargs):
        # Return a dummy async iterator of events
        async def event_generator():
            yield {"messageStart": {"role": "assistant"}}
            yield {"contentBlockDelta": {"delta": {"text": "Answer part 1."}}}
            yield {"contentBlockDelta": {"delta": {"reasoningContent": {"text": "Reasoning step 1"}}}}
            yield {"contentBlockStop": {}}
            yield {"messageStop": {"stopReason": "end_turn"}}

        return {"stream": event_generator()}

    # Patch the model's bedrock client converse_stream method
    monkeypatch.setattr(model._bedrock_client, "converse_stream", dummy_converse_stream)

    # Call stream and collect events
    events = []
    async for event in model.stream(messages):
        events.append(event)

    # Check that the events contain expected keys and order
    assert any("messageStart" in e for e in events), "Missing messageStart event"
    assert any("contentBlockDelta" in e for e in events), "Missing contentBlockDelta event"
    assert any("contentBlockStop" in e for e in events), "Missing contentBlockStop event"
    assert any("messageStop" in e for e in events), "Missing messageStop event"

    # Verify that the last user message in the request sent to converse_stream contains cachePoint before reasoningContent
    # We can check the call arguments to converse_stream to verify message formatting
    # But since we patched with dummy_converse_stream, we do not have call args.
    # Instead, we rely on the fact that no exception was raised and events were received.

    # The test passes if no exception is raised and events are yielded as expected.


@pytest.mark.asyncio
async def test_inject_cache_point_inserts_before_reasoning_block(monkeypatch):
    """
    This test directly calls _inject_cache_point on messages with a user message containing reasoningContent,
    and verifies that cachePoint is inserted before reasoningContent block.

    This test should fail on buggy codebase where cachePoint is appended after reasoningContent.
    """
    model = BedrockModel(
        model_id="us.anthropic.claude-sonnet-4-6",
        cache_config=CacheConfig(strategy="auto"),
    )

    messages = [
        {"role": "user", "content": [{"text": "Hello"}, {"reasoningContent": {"reasoningText": {"text": "thinking"}}}]},
        {"role": "assistant", "content": [{"text": "Hi"}]},
        {"role": "user", "content": [{"text": "Another user message"}]},
    ]

    # Call _inject_cache_point directly
    model._inject_cache_point(messages)

    # Find last user message with content
    last_user_msg = None
    for msg in reversed(messages):
        if msg.get("role") == "user":
            last_user_msg = msg
            break

    assert last_user_msg is not None

    content = last_user_msg.get("content", [])

    # Find indices of cachePoint and reasoningContent
    cache_point_indices = [i for i, block in enumerate(content) if "cachePoint" in block]
    reasoning_indices = [i for i, block in enumerate(content) if "reasoningContent" in block]

    assert cache_point_indices, "cachePoint not found in last user message content"
    if reasoning_indices:
        # cachePoint must be before reasoningContent
        assert all(cp_idx < min(reasoning_indices) for cp_idx in cache_point_indices), (
            "cachePoint must be inserted before reasoningContent block in last user message"
        )


