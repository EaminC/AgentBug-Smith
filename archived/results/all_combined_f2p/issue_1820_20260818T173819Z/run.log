@pytest.mark.asyncio
async def test_inject_cache_point_removes_existing_cache_points():
    """
    Test that _inject_cache_point removes existing cachePoint blocks before inserting new one.
    """
    model = BedrockModel(
        model_id="us.anthropic.claude-sonnet-4-6",
        cache_config=CacheConfig(strategy="auto"),
    )

    messages = [
        {"role": "user", "content": [{"text": "Hello"}, {"cachePoint": {"type": "default"}}]},
        {"role": "assistant", "content": [{"text": "Hi"}, {"cachePoint": {"type": "default"}}]},
        {"role": "user", "content": [{"text": "Another user message"}, {"cachePoint": {"type": "default"}}]},
    ]

    model._inject_cache_point(messages)

    # All old cachePoints should be removed except the new one in last user message
    for i, msg in enumerate(messages):
        content = msg.get("content", [])
        cache_points = [block for block in content if "cachePoint" in block]
        if i == 2:
            # Last user message should have exactly one cachePoint at the end
            assert len(cache_points) == 1
            assert content[-1] == cache_points[0]
        else:
            assert len(cache_points) == 0


