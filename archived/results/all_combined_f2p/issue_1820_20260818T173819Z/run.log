    last_user_content = messages_copy[last_user_idx]["content"]
    assert any("cachePoint" in block for block in last_user_content), "New cache point not injected in last user message"

    # No cachePoint in assistant messages
    for msg in messages_copy:
        if msg["role"] == "assistant":
            for block in msg.get("content", []):
                assert "cachePoint" not in block, "Cache point should not be injected in assistant message"


