@pytest.mark.asyncio
async def test_cache_point_injection_position_with_reasoning_content(claude_model):
    """
    Test that when cache_config.strategy == "auto", the cache point is injected before any reasoningContent blocks
    in the last user message's content, not appended after them, to avoid Bedrock API validation errors.
    """
    # Prepare messages with an assistant message that ends with a reasoningContent block
    messages = [
        {"role": "user", "content": [{"text": "Hello"}]},
        {
            "role": "assistant",
            "content": [
                {"text": "Here is some response."},
                {"reasoningContent": {"reasoningText": {"text": "Thinking deeply...", "signature": "sig123"}}},
            ],
        },
        {"role": "user", "content": [{"text": "Next user message"}]},
    ]

    # Copy messages to avoid mutation issues
    messages_copy = copy.deepcopy(messages)

    # Use the internal method to format messages, which calls _inject_cache_point internally
    formatted_messages = claude_model._format_bedrock_messages(messages_copy)

    # Find the last user message index
    last_user_idx = None
    for idx in reversed(range(len(formatted_messages))):
        if formatted_messages[idx]["role"] == "user":
            last_user_idx = idx
            break

    # There should be a last user message
    assert last_user_idx is not None

    # Extract the content of the last user message after formatting
    last_user_content = formatted_messages[last_user_idx]["content"]

    # Verify that a cachePoint was injected in the last user message content
    cache_point_indices = [i for i, block in enumerate(last_user_content) if "cachePoint" in block]
    assert cache_point_indices, "No cachePoint found in last user message content"

    # The cachePoint should be the last block in the last user message content
    assert cache_point_indices[-1] == len(last_user_content) - 1

    # Verify that no reasoningContent blocks are after the cachePoint in the last user message
    for block in last_user_content[cache_point_indices[-1] + 1 :]:
        assert "reasoningContent" not in block, "reasoningContent block found after cachePoint"

    # Additionally, verify that in the assistant message, reasoningContent blocks remain at the end and no cachePoint is appended there
    assistant_msgs = [m for m in formatted_messages if m["role"] == "assistant"]
    assert assistant_msgs, "No assistant messages found"
    assistant_content = assistant_msgs[0]["content"]
    # There should be no cachePoint in assistant message content
    for block in assistant_content:
        assert "cachePoint" not in block, "cachePoint should not be injected into assistant message content"

    # Also verify that the reasoningContent block is still present in the assistant message content
    reasoning_blocks = [block for block in assistant_content if "reasoningContent" in block]
    assert reasoning_blocks, "reasoningContent block missing in assistant message content"


@pytest.mark.asyncio
async def test_cache_point_injection_fails_if_appended_after_reasoning_content(claude_model):
    """
    This test is designed to fail on the buggy codebase where cache points are appended after reasoningContent blocks
    in assistant messages, causing Bedrock API validation errors.
    It attempts to simulate the error by checking the position of cachePoint in assistant messages.
    After the fix, this test should pass.
    """
    messages = [
        {"role": "user", "content": [{"text": "Hello"}]},
        {
            "role": "assistant",
            "content": [
                {"text": "Response"},
                {"reasoningContent": {"reasoningText": {"text": "Thinking...", "signature": "sig"}}},
            ],
        },
    ]

    messages_copy = copy.deepcopy(messages)

    formatted_messages = claude_model._format_bedrock_messages(messages_copy)

    # In buggy code, cachePoint is appended to assistant message content after reasoningContent block
    assistant_msgs = [m for m in formatted_messages if m["role"] == "assistant"]
    assert assistant_msgs, "No assistant messages found"
    assistant_content = assistant_msgs[0]["content"]

    # Check if cachePoint is present
    cache_point_indices = [i for i, block in enumerate(assistant_content) if "cachePoint" in block]

    # On buggy code, cachePoint is appended to assistant message content
    # So cachePoint index would be last index (after reasoningContent)
    # This test expects that cachePoint is NOT after reasoningContent in assistant messages
    # So if cachePoint is found after reasoningContent, fail the test (simulate the bug)
    reasoning_indices = [i for i, block in enumerate(assistant_content) if "reasoningContent" in block]

    if cache_point_indices and reasoning_indices:
        # If cachePoint index is greater than reasoningContent index, this is buggy behavior
        if cache_point_indices[-1] > reasoning_indices[-1]:
            pytest.fail(
                "Cache point injected after reasoningContent block in assistant message, "
                "which causes Bedrock API validation error."
            )
    else:
        # If no cachePoint or no reasoningContent, test passes trivially
        assert True


