def test_cache_point_injection_does_not_mutate_original_messages():
    """
    Test that _format_bedrock_messages does not mutate the original messages list.
    """
    messages = [
        {"role": "user", "content": [{"text": "Hello"}]},
        {
            "role": "user",
            "content": [{"text": "How are you?"}],
        },
    ]

    model = BedrockModel(
        model_id="us.anthropic.claude-sonnet-4-6",
        cache_config=CacheConfig(strategy="auto"),
    )

    import copy

    original_copy = copy.deepcopy(messages)
    formatted = model._format_bedrock_messages(messages)

    # Original messages should remain unchanged (no cachePoint)
    for orig_msg, fmt_msg in zip(messages, formatted):
        if orig_msg.get("role") == "user":
            assert orig_msg == original_copy[formatted.index(orig_msg)]
            # The formatted message should have cachePoint appended
            content = fmt_msg.get("content", [])
            cachepoint_blocks = [block for block in content if "cachePoint" in block]
            assert len(cachepoint_blocks) == 1

    # Original messages do not have cachePoint
    for msg in messages:
        content = msg.get("content", [])
        for block in content:
            assert "cachePoint" not in block


@pytest.mark.asyncio
async def test_stream_with_cache_point_and_reasoning_content_no_validation_error():
    """
    Test that streaming with cache point and reasoningContent does not raise Bedrock API validation error.
    This simulates the real streaming call and ensures the request formatting is correct.
    """
    messages = [
        {"role": "user", "content": [{"text": "Hello"}]},
        {
            "role": "user",
            "content": [
                {"text": "Please think carefully."},
                {"reasoningContent": {"reasoningText": {"text": "Thinking...", "signature": "sig5"}}},
            ],
        },
    ]

    model = BedrockModel(
        model_id="us.anthropic.claude-sonnet-4-6",
        cache_config=CacheConfig(strategy="auto"),
    )

    # Patch the bedrock client converse_stream to a dummy async generator that yields no events
    class DummyAsyncGen:
        def __aiter__(self):
            return self

        async def __anext__(self):
            raise StopAsyncIteration

    model._bedrock_client = type("DummyClient", (), {"converse_stream": lambda *args, **kwargs: DummyAsyncGen()})()

    # Call stream and ensure no exception is raised due to cache point placement
    try:
        stream = model.stream(messages)
        # Consume the async generator fully
        async for _ in stream:
            pass
    except Exception as e:
        pytest.fail(f"Streaming raised an unexpected exception: {e}")


