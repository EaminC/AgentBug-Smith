        content = msg.get("content", [])
        for block in content:
            assert "cachePoint" not in block, "No cachePoint should be injected when no user message"


@pytest.mark.asyncio
async def test_cache_point_injection_with_reasoning_block_only(bedrock_client):
    """
    Test that cache point is injected before reasoningContent block when it is the only content block.
    """
    messages = [
        {"role": "user", "content": [{"reasoningContent": {"reasoningText": {"text": "Thinking...", "signature": "sig3"}}}]},
    ]

    model = BedrockModel(
        model_id="us.anthropic.claude-sonnet-4-6",
        cache_config=CacheConfig(strategy="auto"),
    )

    formatted_messages = model._format_bedrock_messages(messages)

    last_user_msg = formatted_messages[0]
    content = last_user_msg.get("content", [])

    reasoning_indices = [i for i, block in enumerate(content) if "reasoningContent" in block]
    cachepoint_indices = [i for i, block in enumerate(content) if "cachePoint" in block]

    assert len(reasoning_indices) == 1
    assert len(cachepoint_indices) == 1

    reasoning_idx = reasoning_indices[0]
    cachepoint_idx = cachepoint_indices[0]

    assert cachepoint_idx < reasoning_idx, "Cache point must be inserted before reasoningContent block"


@pytest.mark.asyncio
async def test_cache_point_injection_does_not_mutate_original_messages(bedrock_client):
    """
    Test that _format_bedrock_messages does not mutate the original messages list or its content.
    """
    messages = [
        {"role": "user", "content": [{"text": "Original message"}]},
        {"role": "assistant", "content": [{"text": "Assistant message"}]},
        {
            "role": "user",
            "content": [
                {"text": "User message with reasoning"},
                {"reasoningContent": {"reasoningText": {"text": "Thinking...", "signature": "sig4"}}},
            ],
        },
    ]

    import copy

    original_copy = copy.deepcopy(messages)

    model = BedrockModel(
        model_id="us.anthropic.claude-sonnet-4-6",
        cache_config=CacheConfig(strategy="auto"),
    )

    _ = model._format_bedrock_messages(messages)

    # Original messages must remain unchanged (no cachePoint added)
    assert messages == original_copy, "Original messages must not be mutated by _format_bedrock_messages"


