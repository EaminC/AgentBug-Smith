    last_user_msg = None
    for msg in reversed(formatted_messages):
        if msg.get("role") == "user":
            last_user_msg = msg
            break

    # The content list should have one cachePoint block appended since it was empty initially
    content = last_user_msg.get("content", [])
    cachepoint_blocks = [block for block in content if "cachePoint" in block]

    assert len(cachepoint_blocks) == 1, "Cache point should be appended even if content was initially empty"


