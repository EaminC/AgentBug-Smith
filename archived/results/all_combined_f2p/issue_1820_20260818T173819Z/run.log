@pytest.mark.asyncio
async def test_cache_point_injection_with_multiple_user_messages():
    """
    Test that cache point is injected only in the last user message when multiple user messages exist.
    """
    messages = [
        {"role": "user", "content": [{"text": "First message"}]},
        {"role": "assistant", "content": [{"text": "Reply"}]},
        {
            "role": "user",
            "content": [
                {"text": "Second message"},
                {"reasoningContent": {"reasoningText": {"text": "Thinking...", "signature": "sig3"}}},
            ],
        },
    ]

    model = BedrockModel(
        model_id="us.anthropic.claude-sonnet-4-6",
        cache_config=CacheConfig(strategy="auto"),
    )

    formatted_messages = model._format_bedrock_messages(messages)

    user_messages = [msg for msg in formatted_messages if msg.get("role") == "user"]
    assert len(user_messages) == 2

    # First user message should not have cachePoint
    first_user_content = user_messages[0].get("content", [])
    cachepoint_in_first = any("cachePoint" in block for block in first_user_content)
    assert not cachepoint_in_first

    # Last user message should have cachePoint before reasoningContent
    last_user_content = user_messages[1].get("content", [])
    reasoning_indices = [i for i, block in enumerate(last_user_content) if "reasoningContent" in block]
    cachepoint_indices = [i for i, block in enumerate(last_user_content) if "cachePoint" in block]

    assert len(reasoning_indices) == 1
    assert len(cachepoint_indices) == 1
    assert cachepoint_indices[0] < reasoning_indices[0]


@pytest.mark.asyncio
async def test_cache_point_injection_no_user_message():
    """
    Test that no cache point is injected if there is no user message.
    """
    messages = [
        {"role": "assistant", "content": [{"text": "Hello"}]},
        {"role": "assistant", "content": [{"text": "Another reply"}]},
    ]

    model = BedrockModel(
        model_id="us.anthropic.claude-sonnet-4-6",
        cache_config=CacheConfig(strategy="auto"),
    )

    formatted_messages = model._format_bedrock_messages(messages)

    # No cachePoint should be present in any message
    for msg in formatted_messages:
        content = msg.get("content", [])
        for block in content:
            assert "cachePoint" not in block


