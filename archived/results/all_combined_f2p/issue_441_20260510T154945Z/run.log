[32mimport unittest
from unittest.mock import patch, MagicMock

from agentscope.message import Msg
from agentscope.models.ollama_model import OllamaChatWrapper


class TestOllamaChatWrapperRoleFix(unittest.TestCase):
    def setUp(self):
        # Patch the import of ollama to avoid ImportError in test environment
        patcher = patch("agentscope.models.ollama_model.ollama", new=MagicMock())
        self.addCleanup(patcher.stop)
        patcher.start()

        # Initialize the model wrapper with dummy config
        self.model = OllamaChatWrapper(config_name="", model_name="llama3.1")

        # Prepare inputs similar to those used in format_test.py
        self.inputs = [
            Msg("system", "You are a helpful assistant", role="system"),
            [
                Msg("user", "What is the weather today?", role="user"),
                Msg("assistant", "It is sunny today", role="assistant"),
            ],
        ]

    def test_format_role_for_system_message(self):
        # The buggy code sets role to "system" in the formatted prompt,
        # which causes the LLM to ignore user messages.
        # The fix changes the role to "user".
        prompt = self.model.format(*self.inputs)  # type: ignore

        # The expected prompt should have role "user" (not "system") for the system message
        expected_role = "user"
        self.assertIsInstance(prompt, list)
        self.assertGreater(len(prompt), 0)
        self.assertEqual(prompt[0]["role"], expected_role)

        # The content should include the system prompt and conversation history
        content = prompt[0]["content"]
        self.assertIn("You are a helpful assistant", content)
        self.assertIn("user: What is the weather today?", content)
        self.assertIn("assistant: It is sunny today", content)


if __name__ == "__main__":
    unittest.main()[0m
