class TestOllamaChatWrapperRoleFix(unittest.TestCase):
    """
    Fail2pass test for issue #441:
    OllamaChatWrapper.format should set the role of the system message to "user"
    instead of "system" to ensure the assistant receives user messages correctly.
    """

    def setUp(self):
        # Initialize the model wrapper with dummy config
        self.model = OllamaChatWrapper(config_name="", model_name="llama3.1")

        # Prepare a conversation input with system prompt and user-assistant history
        self.inputs = [
            Msg("system", "You are a helpful assistant", role="system"),
            [
                Msg("user", "Hello", role="user"),
                Msg("assistant", "Hi! How can I help you?", role="assistant"),
                Msg("user", "What's your name?", role="user"),
            ],
        ]

    @patch("agentscope.models.ollama_model.OllamaChatWrapper._client")
    def test_format_role_for_system_message(self, mock_client):
        """
        Test that the formatted prompt contains a message with role 'user' for the system content,
        not 'system'. This is critical for the llama3.1 model to respond properly.
        """

        # Mock the internal client to avoid real network calls
        mock_client.return_value = MagicMock()

        # Call the real format method
        formatted_prompt = self.model.format(*self.inputs)

        # The formatted prompt should be a list with one dict containing role and content
        self.assertIsInstance(formatted_prompt, list)
        self.assertEqual(len(formatted_prompt), 1)
        message = formatted_prompt[0]
        self.assertIsInstance(message, dict)

        # The role must be "user" (not "system") according to the fix
        self.assertEqual(message.get("role"), "user")

        # The content should contain the system prompt and conversation history as a string
        content = message.get("content")
        self.assertIsInstance(content, str)
        self.assertIn("You are a helpful assistant", content)
        self.assertIn("user: Hello", content)
        self.assertIn("assistant: Hi! How can I help you?", content)
        self.assertIn("user: What's your name?", content)

        # If the role was "system", the model would not respond properly (fail before fix)
        # This test will fail on buggy code and pass after fix


