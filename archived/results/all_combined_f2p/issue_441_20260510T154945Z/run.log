[32mimport unittest
from unittest.mock import patch, MagicMock

from agentscope.models.ollama_model import OllamaChatWrapper
from agentscope.message import Msg


class TestOllamaChatWrapperRoleFix(unittest.TestCase):
    def setUp(self):
        # Patch import of ollama to avoid ImportError during OllamaChatWrapper init
        patcher = patch("agentscope.models.ollama_model.ollama", new=MagicMock())
        self.addCleanup(patcher.stop)
        self.mock_ollama = patcher.start()

        # Initialize the model wrapper with the buggy model name that triggers the bug
        self.model = OllamaChatWrapper(config_name="", model_name="llama3.1")

        # Prepare input messages: system prompt + conversation history (user + assistant)
        self.inputs = [
            Msg("system", "You are a helpful assistant", role="system"),
            [
                Msg("user", "What is the weather today?", role="user"),
                Msg("assistant", "It is sunny today", role="assistant"),
            ],
        ]

    def test_format_role_for_system_message(self):
        """
        Test that OllamaChatWrapper.format returns a list with a single dict
        whose role is 'user' (not 'system') and content includes system prompt
        and conversation history formatted as expected.

        This test should fail on the buggy codebase (role='system'),
        and pass after the fix (role='user').
        """
        prompt = self.model.format(*self.inputs)
        self.assertIsInstance(prompt, list)
        self.assertEqual(len(prompt), 1)
        message = prompt[0]
        self.assertIsInstance(message, dict)

        # The key fix: role must be 'user' (not 'system')
        self.assertEqual(message.get("role"), "user")

        # Content should be a string containing the system prompt and conversation history
        content = message.get("content")
        self.assertIsInstance(content, str)
        self.assertIn("You are a helpful assistant", content)
        self.assertIn("user: What is the weather today?", content)
        self.assertIn("assistant: It is sunny today", content)


if __name__ == "__main__":
    unittest.main()[0m
