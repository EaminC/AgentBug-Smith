class TestOllamaChatWrapperRoleFix(unittest.TestCase):
    def setUp(self):
        # No mocking of 'ollama' attribute because it does not exist in the module,
        # we want to test real OllamaChatWrapper.format behavior.
        # This test expects the buggy code to produce role "system" in the formatted output,
        # and after fix, it should produce role "user".
        self.model = OllamaChatWrapper(config_name="", model_name="llama3.1")

        self.inputs = [
            Msg("system", "You are a helpful assistant", role="system"),
            [
                Msg("user", "What is the weather today?", role="user"),
                Msg("assistant", "It is sunny today", role="assistant"),
            ],
        ]

    def test_format_role_for_system_message(self):
        # Call the format method with the inputs.
        formatted = self.model.format(*self.inputs)

        # The formatted output is a list with a single dict containing role and content.
        self.assertIsInstance(formatted, list)
        self.assertEqual(len(formatted), 1)
        message = formatted[0]
        self.assertIsInstance(message, dict)
        self.assertIn("role", message)
        self.assertIn("content", message)

        # The bug is that role is "system" instead of "user".
        # So before fix, role == "system" and test should fail if we assert role == "user".
        # After fix, role == "user" and test should pass.
        self.assertEqual(
            message["role"],
            "user",
            msg=f"Expected role 'user' but got '{message['role']}'. This test fails on buggy code and passes after fix.",
        )

        # Also check that the content contains the conversation history as expected.
        content = message["content"]
        self.assertIn("You are a helpful assistant", content)
        self.assertIn("user: What is the weather today?", content)
        self.assertIn("assistant: It is sunny today", content)


