[32mimport unittest
from unittest.mock import patch, MagicMock

from agentscope.message import Msg
from agentscope.models.ollama_model import OllamaChatWrapper


class TestOllamaChatWrapperRoleFix(unittest.TestCase):
    def setUp(self):
        # Patch the 'ollama' import inside OllamaChatWrapper to avoid ImportError
        patcher = patch("agentscope.models.ollama_model.ollama", new=MagicMock())
        self.addCleanup(patcher.stop)
        patcher.start()

        # Initialize the model with the buggy model_name that triggers the bug
        self.model = OllamaChatWrapper(config_name="", model_name="llama3.1")

        # Prepare input messages as per the bug report
        self.inputs = [
            Msg("system", "You are a helpful assistant", role="system"),
            [
                Msg("user", "What is the weather today?", role="user"),
                Msg("assistant", "It is sunny today", role="assistant"),
            ],
        ]

    def test_format_role_for_system_message(self):
        # Call the format method which is buggy before patch: it sets role "system"
        formatted = self.model.format(*self.inputs)

        # The buggy code produces role "system" in the single dict in list
        # The fix changes this role to "user"
        # We assert that the role is "user" to pass after fix and fail before fix
        self.assertEqual(len(formatted), 1)
        self.assertIn("role", formatted[0])
        self.assertEqual(formatted[0]["role"], "user")

        # Also check the content includes the expected conversation history string
        expected_content_start = "You are a helpful assistant"
        self.assertTrue(formatted[0]["content"].startswith(expected_content_start))


if __name__ == "__main__":
    unittest.main()[0m
