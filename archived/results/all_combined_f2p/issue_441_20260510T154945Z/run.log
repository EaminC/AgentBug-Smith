[32mimport unittest
from unittest.mock import patch

from agentscope.message import Msg
from agentscope.models.ollama_model import OllamaChatWrapper


class TestOllamaChatWrapperRoleFix(unittest.TestCase):
    def setUp(self):
        # No patching of 'ollama' attribute, test only the format method behavior
        self.model = OllamaChatWrapper(config_name="", model_name="llama3.1")

        self.inputs = [
            Msg("system", "You are a helpful assistant", role="system"),
            [
                Msg("user", "What is the weather today?", role="user"),
                Msg("assistant", "It is sunny today", role="assistant"),
            ],
        ]

    def test_format_role_for_system_message(self):
        """
        Test that OllamaChatWrapper.format returns a prompt list with a single dict
        whose role is 'user' (not 'system'), and the content includes system prompt
        and conversation history.

        This test should fail on buggy code (role='system'), and pass on fixed code (role='user').
        """
        prompt = self.model.format(*self.inputs)
        self.assertIsInstance(prompt, list)
        self.assertEqual(len(prompt), 1)
        message = prompt[0]
        self.assertIsInstance(message, dict)
        # The fix changes role from 'system' to 'user'
        self.assertEqual(message.get("role"), "user")
        content = message.get("content")
        self.assertIsInstance(content, str)
        self.assertIn("You are a helpful assistant", content)
        self.assertIn("user: What is the weather today?", content)
        self.assertIn("assistant: It is sunny today", content)


if __name__ == "__main__":
    unittest.main()[0m
