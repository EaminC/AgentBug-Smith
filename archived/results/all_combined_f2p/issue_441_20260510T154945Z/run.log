                Msg(
                    "user",
                    "And this images",
                    "user",
                    url=[
                        "/Users/xxx/abc.png",
                        "/Users/xxx/def.mp3",
                    ],
                ),
            ],
        ]

        self.wrong_inputs = [
            Msg("system", "You are a helpful assistant", role="system"),
