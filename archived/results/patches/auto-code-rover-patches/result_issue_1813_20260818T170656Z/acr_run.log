222     async def load_tools(self, **kwargs: Any) -> Sequence[AgentTool]:
223         """Load and return tools from the MCP server.
224 
225         This method implements the ToolProvider interface by loading tools
226         from the MCP server and caching them for reuse.
227 
228         Args:
229             **kwargs: Additional arguments for future compatibility.
230 
231         Returns:
232             List of AgentTool instances from the MCP server.
233         """
234         logger.debug(
235             "started=<%s>, cached_tools=<%s> | loading tools",
236             self._tool_provider_started,
237             self._loaded_tools is not None,
238         )
239 
240         if not self._tool_provider_started:
241             try:
242                 logger.debug("starting MCP client")
243                 self.start()
244                 self._tool_provider_started = True
245                 logger.debug("MCP client started successfully")
246             except Exception as e:
247                 logger.error("error=<%s> | failed to start MCP client", e)
248                 raise ToolProviderException(f"Failed to start MCP client: {e}") from e
249 
250         if self._loaded_tools is None:
251             logger.debug("loading tools from MCP server")
252             self._loaded_tools = []
253             pagination_token = None
254             page_count = 0
255 
256             while True:
257                 logger.debug("page=<%d>, token=<%s> | fetching tools page", page_count, pagination_token)
258                 # Use constructor defaults for prefix and filters in load_tools
259                 paginated_tools = self.list_tools_sync(
260                     pagination_token, prefix=self._prefix, tool_filters=self._tool_filters
261                 )
262 
263                 # Tools are already filtered by list_tools_sync, so add them all
264                 for tool in paginated_tools:
265                     self._loaded_tools.append(tool)
266 
267                 logger.debug(
268                     "page=<%d>, page_tools=<%d>, total_filtered=<%d> | processed page",
269                     page_count,
270                     len(paginated_tools),
271                     len(self._loaded_tools),
272                 )
273 
274                 pagination_token = paginated_tools.pagination_token
275                 page_count += 1
276 
277                 if pagination_token is None:
278                     break
279 
280             logger.debug("final_tools=<%d> | loading complete", len(self._loaded_tools))
281 
282         return self._loaded_tools
