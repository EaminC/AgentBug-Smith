316     def stop(self, exc_type: BaseException | None, exc_val: BaseException | None, exc_tb: TracebackType | None) -> None:
317         """Signals the background thread to stop and waits for it to complete, ensuring proper cleanup of all resources.
318 
319         This method is defensive and can handle partial initialization states that may occur
320         if start() fails partway through initialization.
321 
322         Resources to cleanup:
323         - _background_thread: Thread running the async event loop
324         - _background_thread_session: MCP ClientSession (auto-closed by context manager)
325         - _background_thread_event_loop: AsyncIO event loop in background thread
326         - _close_future: AsyncIO future to signal thread shutdown
327         - _close_exception: Exception that caused the background thread shutdown; None if a normal shutdown occurred.
328         - _init_future: Future for initialization synchronization
329 
330         Cleanup order:
331         1. Signal close future to background thread (if session initialized)
332         2. Wait for background thread to complete
333         3. Reset all state for reuse
334 
335         Args:
336             exc_type: Exception type if an exception was raised in the context
337             exc_val: Exception value if an exception was raised in the context
338             exc_tb: Exception traceback if an exception was raised in the context
339         """
340         self._log_debug_with_thread("exiting MCPClient context")
341 
342         # Only try to signal close future if we have a background thread
343         if self._background_thread is not None:
344             # Signal close future if event loop exists
345             if self._background_thread_event_loop is not None:
346 
347                 async def _set_close_event() -> None:
348                     if self._close_future and not self._close_future.done():
349                         self._close_future.set_result(None)
350 
351                 # Not calling _invoke_on_background_thread since the session does not need to exist
352                 # we only need the thread and event loop to exist.
353                 asyncio.run_coroutine_threadsafe(coro=_set_close_event(), loop=self._background_thread_event_loop)
354 
355             self._log_debug_with_thread("waiting for background thread to join")
356             self._background_thread.join()
357 
358         if self._background_thread_event_loop is not None:
359             self._background_thread_event_loop.close()
360 
361         self._log_debug_with_thread("background thread is closed, MCPClient context exited")
362 
363         # Reset fields to allow instance reuse
364         self._init_future = futures.Future()
365         self._background_thread = None
366         self._background_thread_session = None
367         self._background_thread_event_loop = None
368         self._session_id = uuid.uuid4()
369         self._loaded_tools = None
370         self._tool_provider_started = False
371         self._consumers = set()
372         self._server_task_capable = None
373         self._tool_task_support_cache = {}
374 
375         if self._close_exception:
376             exception = self._close_exception
377             self._close_exception = None
378             raise RuntimeError("Connection to the MCP server was closed") from exception
379 
380     def list_tools_sync(
381         self,
382         pagination_token: str | None = None,
383         prefix: str | None = None,
384         tool_filters: ToolFilters | None = None,
385     ) -> PaginatedList[MCPAgentTool]:
386         """Synchronously retrieves the list of available tools from the MCP server.
387 
388         This method calls the asynchronous list_tools method on the MCP session
389         and adapts the returned tools to the AgentTool interface.
390 
391         Args:
392             pagination_token: Optional token for pagination
393             prefix: Optional prefix to apply to tool names. If None, uses constructor default.
394                    If explicitly provided (including empty string), overrides constructor default.
395             tool_filters: Optional filters to apply to tools. If None, uses constructor default.
396                          If explicitly provided (including empty dict), overrides constructor default.
397 
398         Returns:
399             List[AgentTool]: A list of available tools adapted to the AgentTool interface
400         """
401         self._log_debug_with_thread("listing MCP tools synchronously")
402         if not self._is_session_active():
403             raise MCPClientInitializationError(CLIENT_SESSION_NOT_RUNNING_ERROR_MESSAGE)
404 
405         effective_prefix = self._prefix if prefix is None else prefix
406         effective_filters = self._tool_filters if tool_filters is None else tool_filters
407 
408         async def _list_tools_async() -> ListToolsResult:
409             return await cast(ClientSession, self._background_thread_session).list_tools(cursor=pagination_token)
410 
411         list_tools_response: ListToolsResult = self._invoke_on_background_thread(_list_tools_async()).result()
412         self._log_debug_with_thread("received %d tools from MCP server", len(list_tools_response.tools))
413 
414         mcp_tools = []
415         for tool in list_tools_response.tools:
416             if self._is_tasks_enabled():
417                 # Cache taskSupport for task-augmented execution decisions
418                 task_support = None
419                 if tool.execution is not None and tool.execution.taskSupport is not None:
420                     task_support = tool.execution.taskSupport
421                 self._tool_task_support_cache[tool.name] = task_support or "forbidden"
422 
423             # Apply prefix if specified
424             if effective_prefix:
425                 prefixed_name = f"{effective_prefix}_{tool.name}"
426                 mcp_tool = MCPAgentTool(tool, self, name_override=prefixed_name)
427                 logger.debug("tool_rename=<%s->%s> | renamed tool", tool.name, prefixed_name)
428             else:
429                 mcp_tool = MCPAgentTool(tool, self)
430 
431             # Apply filters if specified
432             if self._should_include_tool_with_filters(mcp_tool, effective_filters):
433                 mcp_tools.append(mcp_tool)
434 
435         self._log_debug_with_thread("successfully adapted %d MCP tools", len(mcp_tools))
436         return PaginatedList[MCPAgentTool](mcp_tools, token=list_tools_response.nextCursor)
