284     def add_consumer(self, consumer_id: Any, **kwargs: Any) -> None:
285         """Add a consumer to this tool provider.
286 
287         Synchronous to prevent GC deadlocks when called from Agent finalizers.
288         """
289         self._consumers.add(consumer_id)
290         logger.debug("added provider consumer, count=%d", len(self._consumers))
