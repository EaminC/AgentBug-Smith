292     def remove_consumer(self, consumer_id: Any, **kwargs: Any) -> None:
293         """Remove a consumer from this tool provider.
294 
295         This method is idempotent - calling it multiple times with the same ID
296         has no additional effect after the first call.
297 
298         Synchronous to prevent GC deadlocks when called from Agent finalizers.
299         Uses existing synchronous stop() method for safe cleanup.
300         """
301         self._consumers.discard(consumer_id)
302         logger.debug("removed provider consumer, count=%d", len(self._consumers))
303 
304         if not self._consumers and self._tool_provider_started:
305             logger.debug("no consumers remaining, cleaning up")
306             try:
307                 self.stop(None, None, None)  # Existing sync method - safe for finalizers
308                 self._tool_provider_started = False
309                 self._loaded_tools = None
310             except Exception as e:
311                 logger.error("error=<%s> | failed to cleanup MCP client", e)
312                 raise ToolProviderException(f"Failed to cleanup MCP client: {e}") from e
