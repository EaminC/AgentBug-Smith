424     if clarify_mode:
425         code_gen_fn = clarified_gen
426     elif lite_mode:
427         code_gen_fn = lite_gen
428     else:
429         code_gen_fn = gen_code
430 
431     # configure execution function
432     if self_heal_mode:
433         execution_fn = self_heal
434     else:
435         execution_fn = execute_entrypoint
436 
437     preprompts_holder = PrepromptsHolder(
438         get_preprompts_path(use_custom_preprompts, Path(project_path))
439     )
440 
441     memory = DiskMemory(memory_path(project_path))
442     memory.archive_logs()
443 
444     execution_env = DiskExecutionEnv()
445     agent = CliAgent.with_default_config(
446         memory,
447         execution_env,
448         ai=ai,
449         code_gen_fn=code_gen_fn,
450         improve_fn=improve_fn,
451         process_code_fn=execution_fn,
452         preprompts_holder=preprompts_holder,
453     )
454 
455     files = FileStore(project_path)
456     if not no_execution:
457         if improve_mode:
458             files_dict_before, is_linting = FileSelector(project_path).ask_for_files()
459 
460             # lint the code
461             if is_linting:
462                 files_dict_before = files.linting(files_dict_before)
463 
464             files_dict = handle_improve_mode(prompt, agent, memory, files_dict_before)
465             if not files_dict or files_dict_before == files_dict:
466                 print(
467                     f"No changes applied. Could you please upload the debug_log_file.txt in {memory.path}/logs folder in a github issue?"
468                 )
469 
470             else:
471                 print("\nChanges to be made:")
472                 compare(files_dict_before, files_dict)
473 
474                 print()
475                 print(colored("Do you want to apply these changes?", "light_green"))
476                 if not prompt_yesno():
477                     files_dict = files_dict_before
478 
479         else:
480             files_dict = agent.init(prompt)
481             # collect user feedback if user consents
482             config = (code_gen_fn.__name__, execution_fn.__name__)
483             collect_and_send_human_review(prompt, model, temperature, config, memory)
484 
485         stage_uncommitted_to_git(path, files_dict, improve_mode)
486 
487         files.push(files_dict)
488 
489     if ai.token_usage_log.is_openai_model():
490         print("Total api cost: $ ", ai.token_usage_log.usage_cost())
491     elif os.getenv("LOCAL_MODEL"):
492         print("Total api cost: $ 0.0 since we are using local LLM.")
493     else:
494         print("Total tokens used: ", ai.token_usage_log.total_tokens())

