50 class AI:
51     """
52     A class that interfaces with language models for conversation management and message serialization.
53 
54     This class provides methods to start and advance conversations, handle message serialization,
55     and implement backoff strategies for rate limit errors when interacting with the OpenAI API.
56 
57     Attributes
58     ----------
59     temperature : float
60         The temperature setting for the language model.
61     azure_endpoint : str
62         The endpoint URL for the Azure-hosted language model.
63     model_name : str
64         The name of the language model to use.
65     streaming : bool
66         A flag indicating whether to use streaming for the language model.
67     llm : BaseChatModel
68         The language model instance for conversation management.
69     token_usage_log : TokenUsageLog
70         A log for tracking token usage during conversations.
71 
72     Methods
73     -------
74     start(system: str, user: str, step_name: str) -> List[Message]
75         Start the conversation with a system message and a user message.
76     next(messages: List[Message], prompt: Optional[str], step_name: str) -> List[Message]
77         Advances the conversation by sending message history to LLM and updating with the response.
78     backoff_inference(messages: List[Message]) -> Any
79         Perform inference using the language model with an exponential backoff strategy.
80     serialize_messages(messages: List[Message]) -> str
81         Serialize a list of messages to a JSON string.
82     deserialize_messages(jsondictstr: str) -> List[Message]
83         Deserialize a JSON string to a list of messages.
84     _create_chat_model() -> BaseChatModel
85         Create a chat model with the specified model name and temperature.
86     """
87 
88     def __init__(
89         self,
90         model_name="gpt-4-turbo",
91         temperature=0.1,
92         azure_endpoint=None,
93         streaming=True,
94         vision=False,
95     ):
96         """
97         Initialize the AI class.
98 
99         Parameters
100         ----------
101         model_name : str, optional
102             The name of the model to use, by default "gpt-4".
103         temperature : float, optional
104             The temperature to use for the model, by default 0.1.
105         """
106         self.temperature = temperature
107         self.azure_endpoint = azure_endpoint
108         self.model_name = model_name
109         self.streaming = streaming
110         self.vision = (
111             ("vision-preview" in model_name)
112             or ("gpt-4-turbo" in model_name and "preview" not in model_name)
113             or ("claude" in model_name)
114         )
115         self.llm = self._create_chat_model()
116         self.token_usage_log = TokenUsageLog(model_name)
117 
118         logger.debug(f"Using model {self.model_name}")
119 
120     def start(self, system: str, user: Any, *, step_name: str) -> List[Message]:
121         """
122         Start the conversation with a system message and a user message.
123 
124         Parameters
125         ----------
126         system : str
127             The content of the system message.
128         user : str
129             The content of the user message.
130         step_name : str
131             The name of the step.
132 
133         Returns
134         -------
135         List[Message]
136             The list of messages in the conversation.
137         """
138 
139         messages: List[Message] = [
140             SystemMessage(content=system),
141             HumanMessage(content=user),
142         ]
143         return self.next(messages, step_name=step_name)
144 
145     def _extract_content(self, content):
146         """
147         Extracts text content from a message, supporting both string and list types.
148         Parameters
149         ----------
150         content : Union[str, List[dict]]
151             The content of a message, which could be a string or a list.
152         Returns
153         -------
154         str
155             The extracted text content.
156         """
157         if isinstance(content, str):
158             return content
159         elif isinstance(content, list) and content and "text" in content[0]:
160             # Assuming the structure of list content is [{'type': 'text', 'text': 'Some text'}, ...]
161             return content[0]["text"]
162         else:
163             return ""
164 
165     def _collapse_text_messages(self, messages: List[Message]):
166         """
167         Combine consecutive messages of the same type into a single message, where if the message content
168         is a list type, the first text element's content is taken. This method keeps `combined_content` as a string.
169 
170         This method iterates through the list of messages, combining consecutive messages of the same type
171         by joining their content with a newline character. If the content is a list, it extracts text from the first
172         text element's content. This reduces the number of messages and simplifies the conversation for processing.
173 
174         Parameters
175         ----------
176         messages : List[Message]
177             The list of messages to collapse.
178 
179         Returns
180         -------
181         List[Message]
182             The list of messages after collapsing consecutive messages of the same type.
183         """
184         collapsed_messages = []
185         if not messages:
186             return collapsed_messages
187 
188         previous_message = messages[0]
189         combined_content = self._extract_content(previous_message.content)
190 
191         for current_message in messages[1:]:
192             if current_message.type == previous_message.type:
193                 combined_content += "\n\n" + self._extract_content(
194                     current_message.content
195                 )
196             else:
197                 collapsed_messages.append(
198                     previous_message.__class__(content=combined_content)
199                 )
200                 previous_message = current_message
201                 combined_content = self._extract_content(current_message.content)
202 
203         collapsed_messages.append(previous_message.__class__(content=combined_content))
204         return collapsed_messages
205 
206     def next(
207         self,
208         messages: List[Message],
209         prompt: Optional[str] = None,
210         *,
211         step_name: str,
212     ) -> List[Message]:
213         """
214         Advances the conversation by sending message history
215         to LLM and updating with the response.
216 
217         Parameters
218         ----------
219         messages : List[Message]
220             The list of messages in the conversation.
221         prompt : Optional[str], optional
222             The prompt to use, by default None.
223         step_name : str
224             The name of the step.
225 
226         Returns
227         -------
228         List[Message]
229             The updated list of messages in the conversation.
230         """
231 
232         if prompt:
233             messages.append(HumanMessage(content=prompt))
234 
235         logger.debug(
236             "Creating a new chat completion: %s",
237             "\n".join([m.pretty_repr() for m in messages]),
238         )
239 
240         if not self.vision:
241             messages = self._collapse_text_messages(messages)
242 
243         response = self.backoff_inference(messages)
244 
245         self.token_usage_log.update_log(
246             messages=messages, answer=response.content, step_name=step_name
247         )
248         messages.append(response)
249         logger.debug(f"Chat completion finished: {messages}")
250 
251         return messages
252 
253     @backoff.on_exception(backoff.expo, openai.RateLimitError, max_tries=7, max_time=45)
254     def backoff_inference(self, messages):
255         """
256         Perform inference using the language model while implementing an exponential backoff strategy.
257 
258         This function will retry the inference in case of a rate limit error from the OpenAI API.
259         It uses an exponential backoff strategy, meaning the wait time between retries increases
260         exponentially. The function will attempt to retry up to 7 times within a span of 45 seconds.
261 
262         Parameters
263         ----------
264         messages : List[Message]
265             A list of chat messages which will be passed to the language model for processing.
266 
267         callbacks : List[Callable]
268             A list of callback functions that are triggered after each inference. These functions
269             can be used for logging, monitoring, or other auxiliary tasks.
270 
271         Returns
272         -------
273         Any
274             The output from the language model after processing the provided messages.
275 
276         Raises
277         ------
278         openai.error.RateLimitError
279             If the number of retries exceeds the maximum or if the rate limit persists beyond the
280             allotted time, the function will ultimately raise a RateLimitError.
281 
282         Example
283         -------
284         >>> messages = [SystemMessage(content="Hello"), HumanMessage(content="How's the weather?")]
285         >>> response = backoff_inference(messages)
286         """
287         return self.llm.invoke(messages)  # type: ignore
288 
289     @staticmethod
290     def serialize_messages(messages: List[Message]) -> str:
291         """
292         Serialize a list of messages to a JSON string.
293 
294         Parameters
295         ----------
296         messages : List[Message]
297             The list of messages to serialize.
298 
299         Returns
300         -------
301         str
302             The serialized messages as a JSON string.
303         """
304         return json.dumps(messages_to_dict(messages))
305 
306     @staticmethod
307     def deserialize_messages(jsondictstr: str) -> List[Message]:
308         """
309         Deserialize a JSON string to a list of messages.
310 
311         Parameters
312         ----------
313         jsondictstr : str
314             The JSON string to deserialize.
315 
316         Returns
317         -------
318         List[Message]
319             The deserialized list of messages.
320         """
321         data = json.loads(jsondictstr)
322         # Modify implicit is_chunk property to ALWAYS false
323         # since Langchain's Message schema is stricter
324         prevalidated_data = [
325             {**item, "tools": {**item.get("tools", {}), "is_chunk": False}}
326             for item in data
327         ]
328         return list(messages_from_dict(prevalidated_data))  # type: ignore
329 
330     def _create_chat_model(self) -> BaseChatModel:
331         """
332         Create a chat model with the specified model name and temperature.
333 
334         Parameters
335         ----------
336         model : str
337             The name of the model to create.
338         temperature : float
339             The temperature to use for the model.
340 
341         Returns
342         -------
343         BaseChatModel
344             The created chat model.
345         """
346         if self.azure_endpoint:
347             return AzureChatOpenAI(
348                 azure_endpoint=self.azure_endpoint,
349                 openai_api_version=os.getenv("OPENAI_API_VERSION", "2023-05-15"),
350                 deployment_name=self.model_name,
351                 openai_api_type="azure",
352                 streaming=self.streaming,
353                 callbacks=[StreamingStdOutCallbackHandler()],
354             )
355         elif "claude" in self.model_name:
356             return ChatAnthropic(
357                 model=self.model_name,
358                 temperature=self.temperature,
359                 callbacks=[StreamingStdOutCallbackHandler()],
360                 streaming=self.streaming,
361                 max_tokens_to_sample=4096,
362             )
363         elif self.vision:
364             return ChatOpenAI(
365                 model=self.model_name,
366                 temperature=self.temperature,
367                 streaming=self.streaming,
368                 callbacks=[StreamingStdOutCallbackHandler()],
369                 max_tokens=4096,  # vision models default to low max token limits
370             )
371         else:
372             return ChatOpenAI(
373                 model=self.model_name,
374                 temperature=self.temperature,
375                 streaming=self.streaming,
376                 callbacks=[StreamingStdOutCallbackHandler()],
377             )

