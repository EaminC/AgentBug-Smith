357     @classmethod
358     def _format_regular_messages(cls, messages: Messages, **kwargs: Any) -> list[dict[str, Any]]:
359         """Format regular messages for OpenAI-compatible providers.
360 
361         Args:
362             messages: List of message objects to be processed by the model.
363             **kwargs: Additional keyword arguments for future extensibility.
364 
365         Returns:
366             List of formatted messages.
367         """
368         formatted_messages = []
369 
370         for message in messages:
371             contents = message["content"]
372 
373             # Check for reasoningContent and warn user
374             if any("reasoningContent" in content for content in contents):
375                 logger.warning(
376                     "reasoningContent is not supported in multi-turn conversations with the Chat Completions API."
377                 )
378 
379             # Filter out content blocks that shouldn't be formatted
380             filtered_contents = []
381             for content in contents:
382                 if any(block_type in content for block_type in ["toolResult", "toolUse", "reasoningContent"]):
383                     continue
384                 if _has_location_source(content):
385                     logger.warning("Location sources are not supported by OpenAI | skipping content block")
386                     continue
387                 filtered_contents.append(content)
388 
389             formatted_contents = [cls.format_request_message_content(content) for content in filtered_contents]
390             formatted_tool_calls = [
391                 cls.format_request_message_tool_call(content["toolUse"]) for content in contents if "toolUse" in content
392             ]
393             formatted_tool_messages = [
394                 cls.format_request_tool_message(content["toolResult"])
395                 for content in contents
396                 if "toolResult" in content
397             ]
398 
399             formatted_message = {
400                 "role": message["role"],
401                 **({"content": formatted_contents} if formatted_contents else {}),
402                 **({"tool_calls": formatted_tool_calls} if formatted_tool_calls else {}),
403             }
404             formatted_messages.append(formatted_message)
405 
406             # Process tool messages to extract images into separate user messages
407             # OpenAI API requires images to be in user role messages only
408             # All tool messages must be grouped together before any user messages with images
409             user_messages_with_images = []
410             for tool_msg in formatted_tool_messages:
411                 tool_msg_clean, user_msg_with_images = cls._split_tool_message_images(tool_msg)
412                 formatted_messages.append(tool_msg_clean)
413                 if user_msg_with_images:
414                     user_messages_with_images.append(user_msg_with_images)
415             formatted_messages.extend(user_messages_with_images)
416 
417         return formatted_messages
418 
419     @classmethod
420     def format_request_messages(
421         cls,
422         messages: Messages,
423         system_prompt: str | None = None,
424         *,
425         system_prompt_content: list[SystemContentBlock] | None = None,
426         **kwargs: Any,
427     ) -> list[dict[str, Any]]:
428         """Format an OpenAI compatible messages array.
429 
430         Args:
431             messages: List of message objects to be processed by the model.
432             system_prompt: System prompt to provide context to the model.
433             system_prompt_content: System prompt content blocks to provide context to the model.
434             **kwargs: Additional keyword arguments for future extensibility.
435 
436         Returns:
437             An OpenAI compatible messages array.
438         """
439         formatted_messages = cls._format_system_messages(system_prompt, system_prompt_content=system_prompt_content)
440         formatted_messages.extend(cls._format_regular_messages(messages))
441 
442         return [message for message in formatted_messages if "content" in message or "tool_calls" in message]
443 
444     def format_request(
445         self,
446         messages: Messages,
447         tool_specs: list[ToolSpec] | None = None,
448         system_prompt: str | None = None,
449         tool_choice: ToolChoice | None = None,
450         *,
451         system_prompt_content: list[SystemContentBlock] | None = None,
452         **kwargs: Any,
453     ) -> dict[str, Any]:
454         """Format an OpenAI compatible chat streaming request.
455 
456         Args:
457             messages: List of message objects to be processed by the model.
458             tool_specs: List of tool specifications to make available to the model.
459             system_prompt: System prompt to provide context to the model.
460             tool_choice: Selection strategy for tool invocation.
461             system_prompt_content: System prompt content blocks to provide context to the model.
462             **kwargs: Additional keyword arguments for future extensibility.
463 
464         Returns:
465             An OpenAI compatible chat streaming request.
466 
467         Raises:
468             TypeError: If a message contains a content block type that cannot be converted to an OpenAI-compatible
469                 format.
470         """
471         return {
472             "messages": self.format_request_messages(
473                 messages, system_prompt, system_prompt_content=system_prompt_content
474             ),
475             "model": self.config["model_id"],
476             "stream": True,
477             "stream_options": {"include_usage": True},
478             "tools": [
479                 {
480                     "type": "function",
481                     "function": {
482                         "name": tool_spec["name"],
483                         "description": tool_spec["description"],
484                         "parameters": tool_spec["inputSchema"]["json"],
485                     },
486                 }
487                 for tool_spec in tool_specs or []
488             ],
489             **(self._format_request_tool_choice(tool_choice)),
490             **cast(dict[str, Any], self.config.get("params", {})),
491         }
