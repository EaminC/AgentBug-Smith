259     @override
260     def format_chunk(self, event: dict[str, Any], **kwargs: Any) -> StreamEvent:
261         """Format a LiteLLM response event into a standardized message chunk.
262 
263         Extends OpenAI's format_chunk to:
264         1. Handle metadata with prompt caching support.
265         2. Extract thought signatures that LiteLLM embeds in tool call IDs for Gemini thinking models.
266 
267         Args:
268             event: A response event from the LiteLLM model.
269             **kwargs: Additional keyword arguments for future extensibility.
270 
271         Returns:
272             The formatted chunk.
273 
274         Raises:
275             RuntimeError: If chunk_type is not recognized.
276         """
277         # Handle metadata case with prompt caching support
278         if event["chunk_type"] == "metadata":
279             usage_data: Usage = {
280                 "inputTokens": event["data"].prompt_tokens,
281                 "outputTokens": event["data"].completion_tokens,
282                 "totalTokens": event["data"].total_tokens,
283             }
284 
285             # Only LiteLLM over Anthropic supports cache write tokens
286             # Waiting until a more general approach is available to set cacheWriteInputTokens
287             if tokens_details := getattr(event["data"], "prompt_tokens_details", None):
288                 if cached := getattr(tokens_details, "cached_tokens", None):
289                     usage_data["cacheReadInputTokens"] = cached
290             if creation := getattr(event["data"], "cache_creation_input_tokens", None):
291                 usage_data["cacheWriteInputTokens"] = creation
292 
293             return StreamEvent(
294                 metadata=MetadataEvent(
295                     metrics={
296                         "latencyMs": 0,  # TODO
297                     },
298                     usage=usage_data,
299                 )
300             )
301 
302         # Extract thought signature from tool call content_start events.
303         # The full encoded ID is kept in toolUseId so that tool result messages continue to match.
304         if event["chunk_type"] == "content_start" and event.get("data_type") == "tool":
305             signature = self._extract_thought_signature(event.get("data"))
306             chunk = super().format_chunk(event)
307             if signature:
308                 tool_use_dict = cast(dict, chunk["contentBlockStart"]["start"]["toolUse"])
309                 tool_use_dict["reasoningSignature"] = signature
310             return chunk
311 
312         # For all other cases, use the parent implementation
313         return super().format_chunk(event)
314 
