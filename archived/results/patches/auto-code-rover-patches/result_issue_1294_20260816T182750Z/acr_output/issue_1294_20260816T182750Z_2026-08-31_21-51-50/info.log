36 class LiteLLMModel(OpenAIModel):
37     """LiteLLM model provider implementation."""
38 
39     class LiteLLMConfig(BaseModelConfig, total=False):
40         """Configuration options for LiteLLM models.
41 
42         Attributes:
43             model_id: Model ID (e.g., "openai/gpt-4o", "anthropic/claude-3-sonnet").
44                 For a complete list of supported models, see https://docs.litellm.ai/docs/providers.
45             params: Model parameters (e.g., max_tokens).
46                 For a complete list of supported parameters, see
47                 https://docs.litellm.ai/docs/completion/input#input-params-1.
48         """
49 
50         model_id: str
51         params: dict[str, Any] | None
52 
53     def __init__(self, client_args: dict[str, Any] | None = None, **model_config: Unpack[LiteLLMConfig]) -> None:
54         """Initialize provider instance.
55 
56         Args:
57             client_args: Arguments for the LiteLLM client.
58                 For a complete list of supported arguments, see
59                 https://github.com/BerriAI/litellm/blob/main/litellm/main.py.
60             **model_config: Configuration options for the LiteLLM model.
61         """
62         self.client_args = client_args or {}
63         validate_config_keys(model_config, self.LiteLLMConfig)
64         self.config = dict(model_config)
65         self._apply_proxy_prefix()
66 
67         logger.debug("config=<%s> | initializing", self.config)
68 
69     @override
70     def update_config(self, **model_config: Unpack[LiteLLMConfig]) -> None:  # type: ignore[override]
71         """Update the LiteLLM model configuration with the provided arguments.
72 
73         Args:
74             **model_config: Configuration overrides.
75         """
76         validate_config_keys(model_config, self.LiteLLMConfig)
77         self.config.update(model_config)
78         self._apply_proxy_prefix()
79 
80     @override
81     def get_config(self) -> LiteLLMConfig:
82         """Get the LiteLLM model configuration.
83 
