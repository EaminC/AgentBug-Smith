283     def _format_request_config(
284         self,
285         tool_specs: list[ToolSpec] | None,
286         system_prompt: str | None,
287         params: dict[str, Any] | None,
288     ) -> genai.types.GenerateContentConfig:
289         """Format Gemini request config.
290 
291         - Docs: https://googleapis.github.io/python-genai/genai.html#genai.types.GenerateContentConfig
292 
293         Args:
294             tool_specs: List of tool specifications to make available to the model.
295             system_prompt: System prompt to provide context to the model.
296             params: Additional model parameters (e.g., temperature).
297 
298         Returns:
299             Gemini request config.
