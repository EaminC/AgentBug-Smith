561     @staticmethod
562     def _validate_gemini_tools(gemini_tools: list[genai.types.Tool]) -> None:
563         """Validate that gemini_tools does not contain FunctionDeclarations.
564 
565         Gemini-specific tools should only include tools that cannot be represented
566         as FunctionDeclarations (e.g., GoogleSearch, CodeExecution, ComputerUse).
567         Standard function calling tools should use the tools interface instead.
568 
569         Args:
570             gemini_tools: List of Gemini tools to validate
571 
572         Raises:
573             ValueError: If any tool contains function_declarations
574         """
575         for tool in gemini_tools:
576             # Check if the tool has function_declarations attribute and it's not empty
577             if hasattr(tool, "function_declarations") and tool.function_declarations:
578                 raise ValueError(
579                     "gemini_tools should not contain FunctionDeclarations. "
580                     "Use the standard tools interface for function calling tools. "
581                     "gemini_tools is reserved for Gemini-specific tools like "
582                     "GoogleSearch, CodeExecution, ComputerUse, UrlContext, and FileSearch."
583                 )

