493     def format_chunk(self, event: dict[str, Any], **kwargs: Any) -> StreamEvent:
494         """Format an OpenAI response event into a standardized message chunk.
495 
496         Args:
497             event: A response event from the OpenAI compatible model.
498             **kwargs: Additional keyword arguments for future extensibility.
499 
500         Returns:
501             The formatted chunk.
502 
503         Raises:
504             RuntimeError: If chunk_type is not recognized.
505                 This error should never be encountered as chunk_type is controlled in the stream method.
506         """
507         match event["chunk_type"]:
508             case "message_start":
509                 return {"messageStart": {"role": "assistant"}}
510 
511             case "content_start":
512                 if event["data_type"] == "tool":
513                     return {
514                         "contentBlockStart": {
515                             "start": {
516                                 "toolUse": {
517                                     "name": event["data"].function.name,
518                                     "toolUseId": event["data"].id,
519                                 }
520                             }
521                         }
522                     }
523 
524                 return {"contentBlockStart": {"start": {}}}
525 
526             case "content_delta":
527                 if event["data_type"] == "tool":
528                     return {
529                         "contentBlockDelta": {"delta": {"toolUse": {"input": event["data"].function.arguments or ""}}}
530                     }
531 
532                 if event["data_type"] == "reasoning_content":
533                     return {"contentBlockDelta": {"delta": {"reasoningContent": {"text": event["data"]}}}}
534 
535                 return {"contentBlockDelta": {"delta": {"text": event["data"]}}}
536 
537             case "content_stop":
538                 return {"contentBlockStop": {}}
539 
540             case "message_stop":
541                 match event["data"]:
542                     case "tool_calls":
543                         return {"messageStop": {"stopReason": "tool_use"}}
544                     case "length":
545                         return {"messageStop": {"stopReason": "max_tokens"}}
546                     case _:
547                         return {"messageStop": {"stopReason": "end_turn"}}
548 
549             case "metadata":
550                 usage_data: Usage = {
551                     "inputTokens": event["data"].prompt_tokens,
552                     "outputTokens": event["data"].completion_tokens,
553                     "totalTokens": event["data"].total_tokens,
554                 }
555 
556                 if tokens_details := getattr(event["data"], "prompt_tokens_details", None):
557                     if cached := getattr(tokens_details, "cached_tokens", None):
558                         usage_data["cacheReadInputTokens"] = cached
559 
560                 return {
561                     "metadata": {
562                         "usage": usage_data,
563                         "metrics": {
564                             "latencyMs": 0,  # TODO
565                         },
566                     },
567                 }
568 
569             case _:
570                 raise RuntimeError(f"chunk_type=<{event['chunk_type']} | unknown type")
571 
572     @asynccontextmanager
573     async def _get_client(self) -> AsyncIterator[Any]:
574         """Get an OpenAI client for making requests.
575 
576         This context manager handles client lifecycle management:
577         - If an injected client was provided during initialization, it yields that client
578           without closing it (caller manages lifecycle).
579         - Otherwise, creates a new AsyncOpenAI client from client_args and automatically
580           closes it when the context exits.
581 
582         Note: We create a new client per request to avoid connection sharing in the underlying
583         httpx client, as the asyncio event loop does not allow connections to be shared.
584         For more details, see https://github.com/encode/httpx/discussions/2959.
585 
586         Yields:
587             Client: An OpenAI-compatible client instance.
588         """
589         if self._custom_client is not None:
590             # Use the injected client (caller manages lifecycle)
591             yield self._custom_client
592         else:
593             # Create a new client from client_args
594             # We initialize an OpenAI context on every request so as to avoid connection sharing in the underlying
595             # httpx client. The asyncio event loop does not allow connections to be shared. For more details, please
596             # refer to https://github.com/encode/httpx/discussions/2959.
597             async with openai.AsyncOpenAI(**self.client_args) as client:
598                 yield client
599 
600     @override
601     async def stream(
602         self,
603         messages: Messages,
604         tool_specs: list[ToolSpec] | None = None,
605         system_prompt: str | None = None,
606         *,
607         tool_choice: ToolChoice | None = None,
608         **kwargs: Any,
609     ) -> AsyncGenerator[StreamEvent, None]:
610         """Stream conversation with the OpenAI model.
611 
612         Args:
613             messages: List of message objects to be processed by the model.
614             tool_specs: List of tool specifications to make available to the model.
615             system_prompt: System prompt to provide context to the model.
616             tool_choice: Selection strategy for tool invocation.
617             **kwargs: Additional keyword arguments for future extensibility.
618 
619         Yields:
620             Formatted message chunks from the model.
621 
622         Raises:
623             ContextWindowOverflowException: If the input exceeds the model's context window.
624             ModelThrottledException: If the request is throttled by OpenAI (rate limits).
625         """
626         logger.debug("formatting request")
627         request = self.format_request(messages, tool_specs, system_prompt, tool_choice)
628         logger.debug("formatted request=<%s>", request)
629 
630         logger.debug("invoking model")
631 
632         # We initialize an OpenAI context on every request so as to avoid connection sharing in the underlying httpx
633         # client. The asyncio event loop does not allow connections to be shared. For more details, please refer to
634         # https://github.com/encode/httpx/discussions/2959.
635         async with self._get_client() as client:
636             try:
637                 response = await client.chat.completions.create(**request)
638             except openai.BadRequestError as e:
639                 # Check if this is a context length exceeded error
640                 if hasattr(e, "code") and e.code == "context_length_exceeded":
641                     logger.warning("OpenAI threw context window overflow error")
642                     raise ContextWindowOverflowException(str(e)) from e
643                 # Re-raise other BadRequestError exceptions
644                 raise
645             except openai.RateLimitError as e:
646                 # All rate limit errors should be treated as throttling, not context overflow
647                 # Rate limits (including TPM) require waiting/retrying, not context reduction
648                 logger.warning("OpenAI threw rate limit error")
649                 raise ModelThrottledException(str(e)) from e
650             except openai.APIError as e:
651                 # Check for alternative context overflow error messages
652                 error_message = str(e)
653                 if any(overflow_msg in error_message for overflow_msg in _CONTEXT_OVERFLOW_MESSAGES):
654                     logger.warning("context window overflow error detected")
655                     raise ContextWindowOverflowException(error_message) from e
656                 # Re-raise other APIError exceptions
657                 raise
658 
659             logger.debug("got response from model")
660             yield self.format_chunk({"chunk_type": "message_start"})
661             tool_calls: dict[int, list[Any]] = {}
662             data_type = None
663             finish_reason = None  # Store finish_reason for later use
664             event = None  # Initialize for scope safety
665 
666             async for event in response:
667                 # Defensive: skip events with empty or missing choices
668                 if not getattr(event, "choices", None):
669                     continue
670                 choice = event.choices[0]
671 
672                 if hasattr(choice.delta, "reasoning_content") and choice.delta.reasoning_content:
673                     chunks, data_type = self._stream_switch_content("reasoning_content", data_type)
674                     for chunk in chunks:
675                         yield chunk
676                     yield self.format_chunk(
677                         {
678                             "chunk_type": "content_delta",
679                             "data_type": data_type,
680                             "data": choice.delta.reasoning_content,
681                         }
682                     )
683 
684                 if choice.delta.content:
685                     chunks, data_type = self._stream_switch_content("text", data_type)
686                     for chunk in chunks:
687                         yield chunk
688                     yield self.format_chunk(
689                         {"chunk_type": "content_delta", "data_type": data_type, "data": choice.delta.content}
690                     )
691 
692                 for tool_call in choice.delta.tool_calls or []:
693                     tool_calls.setdefault(tool_call.index, []).append(tool_call)
694 
695                 if choice.finish_reason:
696                     finish_reason = choice.finish_reason  # Store for use outside loop
697                     if data_type:
698                         yield self.format_chunk({"chunk_type": "content_stop", "data_type": data_type})
699                     break
700 
701             for tool_deltas in tool_calls.values():
702                 yield self.format_chunk({"chunk_type": "content_start", "data_type": "tool", "data": tool_deltas[0]})
703 
704                 for tool_delta in tool_deltas:
705                     yield self.format_chunk({"chunk_type": "content_delta", "data_type": "tool", "data": tool_delta})
706 
707                 yield self.format_chunk({"chunk_type": "content_stop", "data_type": "tool"})
708 
709             yield self.format_chunk({"chunk_type": "message_stop", "data": finish_reason or "end_turn"})
710 
711             # Skip remaining events as we don't have use for anything except the final usage payload
712             async for event in response:
713                 _ = event
714 
715             if event and hasattr(event, "usage") and event.usage:
716                 yield self.format_chunk({"chunk_type": "metadata", "data": event.usage})
717 
718         logger.debug("finished streaming response from model")
719 
720     def _stream_switch_content(self, data_type: str, prev_data_type: str | None) -> tuple[list[StreamEvent], str]:
721         """Handle switching to a new content stream.
722 
723         Args:
724             data_type: The next content data type.
725             prev_data_type: The previous content data type.
726 
727         Returns:
728             Tuple containing:
729             - Stop block for previous content and the start block for the next content.
730             - Next content data type.
731         """
732         chunks = []
733         if data_type != prev_data_type:
734             if prev_data_type is not None:
735                 chunks.append(self.format_chunk({"chunk_type": "content_stop", "data_type": prev_data_type}))
736             chunks.append(self.format_chunk({"chunk_type": "content_start", "data_type": data_type}))
737 
738         return chunks, data_type
739 
740     @override
741     async def structured_output(
742         self, output_model: type[T], prompt: Messages, system_prompt: str | None = None, **kwargs: Any
743     ) -> AsyncGenerator[dict[str, T | Any], None]:
744         """Get structured output from the model.
745 
746         Args:
747             output_model: The output model to use for the agent.
748             prompt: The prompt messages to use for the agent.
749             system_prompt: System prompt to provide context to the model.
750             **kwargs: Additional keyword arguments for future extensibility.
751 
752         Yields:
753             Model events with the last being the structured output.
754 
755         Raises:
756             ContextWindowOverflowException: If the input exceeds the model's context window.
757             ModelThrottledException: If the request is throttled by OpenAI (rate limits).
758         """
759         # We initialize an OpenAI context on every request so as to avoid connection sharing in the underlying httpx
760         # client. The asyncio event loop does not allow connections to be shared. For more details, please refer to
761         # https://github.com/encode/httpx/discussions/2959.
762         async with self._get_client() as client:
763             try:
764                 response: ParsedChatCompletion = await client.beta.chat.completions.parse(
765                     model=self.get_config()["model_id"],
766                     messages=self.format_request(prompt, system_prompt=system_prompt)["messages"],
767                     response_format=output_model,
768                 )
769             except openai.BadRequestError as e:
770                 # Check if this is a context length exceeded error
771                 if hasattr(e, "code") and e.code == "context_length_exceeded":
772                     logger.warning("OpenAI threw context window overflow error")
773                     raise ContextWindowOverflowException(str(e)) from e
774                 # Re-raise other BadRequestError exceptions
775                 raise
776             except openai.RateLimitError as e:
777                 # All rate limit errors should be treated as throttling, not context overflow
778                 # Rate limits (including TPM) require waiting/retrying, not context reduction
779                 logger.warning("OpenAI threw rate limit error")
780                 raise ModelThrottledException(str(e)) from e
781             except openai.APIError as e:
782                 # Check for alternative context overflow error messages
783                 error_message = str(e)
784                 if any(overflow_msg in error_message for overflow_msg in _CONTEXT_OVERFLOW_MESSAGES):
785                     logger.warning("context window overflow error detected")
786                     raise ContextWindowOverflowException(error_message) from e
787                 # Re-raise other APIError exceptions
788                 raise
789 
790         parsed: T | None = None
791         # Find the first choice with tool_calls
792         if len(response.choices) > 1:
793             raise ValueError("Multiple choices found in the OpenAI response.")
794 
795         for choice in response.choices:
796             if isinstance(choice.message.parsed, output_model):
797                 parsed = choice.message.parsed
798                 break
799 
800         if parsed:
801             yield {"output": parsed}
802         else:
803             raise ValueError("No valid tool use or tool use input was found in the OpenAI response.")

