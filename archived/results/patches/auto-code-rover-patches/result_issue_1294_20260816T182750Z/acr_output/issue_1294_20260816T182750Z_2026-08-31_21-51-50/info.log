333     def _format_chunk(self, event: dict[str, Any]) -> StreamEvent:
334         """Format the Gemini response events into standardized message chunks.
335 
336         Args:
337             event: A response event from the Gemini model.
338 
339         Returns:
340             The formatted chunk.
341 
342         Raises:
343             RuntimeError: If chunk_type is not recognized.
344                 This error should never be encountered as we control chunk_type in the stream method.
345         """
346         match event["chunk_type"]:
347             case "message_start":
348                 return {"messageStart": {"role": "assistant"}}
349 
350             case "content_start":
351                 match event["data_type"]:
352                     case "tool":
353                         function_call = event["data"].function_call
354                         # Use Gemini's provided ID or generate one if missing
355                         tool_use_id = function_call.id or f"tooluse_{secrets.token_urlsafe(16)}"
356 
357                         tool_use_start: ContentBlockStartToolUse = {
358                             "name": function_call.name,
359                             "toolUseId": tool_use_id,
360                         }
361                         if event["data"].thought_signature:
362                             tool_use_start["reasoningSignature"] = base64.b64encode(
363                                 event["data"].thought_signature
364                             ).decode("ascii")
365                         return {
366                             "contentBlockStart": {
367                                 "start": {
368                                     "toolUse": tool_use_start,
369                                 },
370                             },
371                         }
372 
373                     case _:
374                         return {"contentBlockStart": {"start": {}}}
375 
376             case "content_delta":
377                 match event["data_type"]:
378                     case "tool":
379                         return {
380                             "contentBlockDelta": {
381                                 "delta": {"toolUse": {"input": json.dumps(event["data"].function_call.args)}}
382                             }
383                         }
384 
385                     case "reasoning_content":
386                         return {
387                             "contentBlockDelta": {
388                                 "delta": {
389                                     "reasoningContent": {
390                                         "text": event["data"].text,
391                                         **(
392                                             {
393                                                 "signature": base64.b64encode(event["data"].thought_signature).decode(
394                                                     "ascii"
395                                                 )
396                                             }
397                                             if event["data"].thought_signature
398                                             else {}
399                                         ),
400                                     },
401                                 },
402                             },
403                         }
404 
405                     case _:
406                         return {"contentBlockDelta": {"delta": {"text": event["data"].text}}}
407 
408             case "content_stop":
409                 return {"contentBlockStop": {}}
410 
411             case "message_stop":
412                 match event["data"]:
413                     case "TOOL_USE":
414                         return {"messageStop": {"stopReason": "tool_use"}}
415                     case "MAX_TOKENS":
416                         return {"messageStop": {"stopReason": "max_tokens"}}
417                     case _:
418                         return {"messageStop": {"stopReason": "end_turn"}}
419 
420             case "metadata":
421                 return {
422                     "metadata": {
423                         "usage": {
424                             "inputTokens": event["data"].prompt_token_count,
425                             "outputTokens": event["data"].total_token_count - event["data"].prompt_token_count,
426                             "totalTokens": event["data"].total_token_count,
427                         },
428                         "metrics": {
429                             "latencyMs": 0,  # TODO
430                         },
431                     },
432                 }
433 
434             case _:  # pragma: no cover
435                 raise RuntimeError(f"chunk_type=<{event['chunk_type']} | unknown type")
436 
437     async def stream(
438         self,
439         messages: Messages,
440         tool_specs: list[ToolSpec] | None = None,
441         system_prompt: str | None = None,
442         tool_choice: ToolChoice | None = None,
443         **kwargs: Any,
444     ) -> AsyncGenerator[StreamEvent, None]:
445         """Stream conversation with the Gemini model.
446 
447         Args:
448             messages: List of message objects to be processed by the model.
449             tool_specs: List of tool specifications to make available to the model.
450             system_prompt: System prompt to provide context to the model.
451             tool_choice: Selection strategy for tool invocation.
452                 Note: Currently unused.
453             **kwargs: Additional keyword arguments for future extensibility.
454 
455         Yields:
456             Formatted message chunks from the model.
457 
458         Raises:
459             ModelThrottledException: If the request is throttled by Gemini.
460         """
461         request = self._format_request(messages, tool_specs, system_prompt, self.config.get("params"))
462 
463         client = self._get_client().aio
464 
465         try:
466             response = await client.models.generate_content_stream(**request)
467 
468             yield self._format_chunk({"chunk_type": "message_start"})
469 
470             data_type: str | None = None
471             tool_used = False
472             candidate = None
473             event = None
474             async for event in response:
475                 candidates = event.candidates
476                 candidate = candidates[0] if candidates else None
477                 content = candidate.content if candidate else None
478                 parts = content.parts if content and content.parts else []
479 
480                 for part in parts:
481                     if part.function_call:
482                         yield self._format_chunk({"chunk_type": "content_start", "data_type": "tool", "data": part})
483                         yield self._format_chunk({"chunk_type": "content_delta", "data_type": "tool", "data": part})
484                         yield self._format_chunk({"chunk_type": "content_stop", "data_type": "tool", "data": part})
485                         tool_used = True
486 
487                     if part.text:
488                         new_data_type = "reasoning_content" if part.thought else "text"
489                         if new_data_type != data_type:
490                             if data_type is not None:
491                                 yield self._format_chunk({"chunk_type": "content_stop", "data_type": data_type})
492                             yield self._format_chunk({"chunk_type": "content_start", "data_type": new_data_type})
493                             data_type = new_data_type
494                         yield self._format_chunk(
495                             {
496                                 "chunk_type": "content_delta",
497                                 "data_type": data_type,
498                                 "data": part,
499                             },
500                         )
501 
502             if data_type is not None:
503                 yield self._format_chunk({"chunk_type": "content_stop", "data_type": data_type})
504             yield self._format_chunk(
505                 {
506                     "chunk_type": "message_stop",
507                     "data": "TOOL_USE" if tool_used else (candidate.finish_reason if candidate else "STOP"),
508                 }
509             )
510             if event:
511                 yield self._format_chunk({"chunk_type": "metadata", "data": event.usage_metadata})
512 
513         except genai.errors.ClientError as error:
514             if not error.message:
515                 raise
516 
517             try:
518                 message = json.loads(error.message) if error.message else {}
519             except json.JSONDecodeError as e:
520                 logger.warning("error_message=<%s> | Gemini API returned non-JSON error", error.message)
521                 # Re-raise the original ClientError (not JSONDecodeError) and make the JSON error the explicit cause
522                 raise error from e
523 
524             match message["error"]["status"]:
525                 case "RESOURCE_EXHAUSTED" | "UNAVAILABLE":
526                     raise ModelThrottledException(error.message) from error
527                 case "INVALID_ARGUMENT":
528                     if "exceeds the maximum number of tokens" in message["error"]["message"]:
529                         raise ContextWindowOverflowException(error.message) from error
530                     raise error
531                 case _:
532                     raise error
533 
534     @override
535     async def structured_output(
536         self, output_model: type[T], prompt: Messages, system_prompt: str | None = None, **kwargs: Any
537     ) -> AsyncGenerator[dict[str, T | Any], None]:
538         """Get structured output from the model using Gemini's native structured output.
539 
540         - Docs: https://ai.google.dev/gemini-api/docs/structured-output
541 
542         Args:
543             output_model: The output model to use for the agent.
544             prompt: The prompt messages to use for the agent.
545             system_prompt: System prompt to provide context to the model.
546             **kwargs: Additional keyword arguments for future extensibility.
547 
548         Yields:
549             Model events with the last being the structured output.
550         """
551         params = {
552             **(self.config.get("params") or {}),
553             "response_mime_type": "application/json",
554             "response_schema": output_model.model_json_schema(),
555         }
556         request = self._format_request(prompt, None, system_prompt, params)
557         client = self._get_client().aio
558         response = await client.models.generate_content(**request)
559         yield {"output": output_model.model_validate(response.parsed)}
560 
561     @staticmethod
562     def _validate_gemini_tools(gemini_tools: list[genai.types.Tool]) -> None:
563         """Validate that gemini_tools does not contain FunctionDeclarations.
564 
565         Gemini-specific tools should only include tools that cannot be represented
566         as FunctionDeclarations (e.g., GoogleSearch, CodeExecution, ComputerUse).
567         Standard function calling tools should use the tools interface instead.
568 
569         Args:
570             gemini_tools: List of Gemini tools to validate
571 
572         Raises:
573             ValueError: If any tool contains function_declarations
574         """
575         for tool in gemini_tools:
576             # Check if the tool has function_declarations attribute and it's not empty
577             if hasattr(tool, "function_declarations") and tool.function_declarations:
578                 raise ValueError(
579                     "gemini_tools should not contain FunctionDeclarations. "
580                     "Use the standard tools interface for function calling tools. "
581                     "gemini_tools is reserved for Gemini-specific tools like "
582                     "GoogleSearch, CodeExecution, ComputerUse, UrlContext, and FileSearch."
583                 )

