397     async def _structured_output_using_response_schema(
398         self, output_model: type[T], prompt: Messages, system_prompt: str | None = None
399     ) -> T:
400         """Get structured output using native response_format support."""
401         response = await litellm.acompletion(
402             **self.client_args,
403             model=self.get_config()["model_id"],
404             messages=self.format_request(prompt, system_prompt=system_prompt)["messages"],
405             response_format=output_model,
406         )
407 
408         if len(response.choices) > 1:
409             raise ValueError("Multiple choices found in the response.")
410         if not response.choices:
411             raise ValueError("No choices found in response")
412 
413         choice = response.choices[0]
414         try:
415             # Parse the message content as JSON
416             tool_call_data = json.loads(choice.message.content)
417             # Instantiate the output model with the parsed data
418             return output_model(**tool_call_data)
419         except ContextWindowExceededError as e:
420             logger.warning("litellm client raised context window overflow in structured_output")
421             raise ContextWindowOverflowException(e) from e
422         except (json.JSONDecodeError, TypeError, ValueError) as e:
423             raise ValueError(f"Failed to parse or load content into model: {e}") from e
424 
425     async def _structured_output_using_tool(
426         self, output_model: type[T], prompt: Messages, system_prompt: str | None = None
427     ) -> T:
428         """Get structured output using tool calling fallback."""
429         tool_spec = convert_pydantic_to_tool_spec(output_model)
430         request = self.format_request(prompt, [tool_spec], system_prompt, cast(ToolChoice, {"any": {}}))
431         args = {**self.client_args, **request, "stream": False}
432         response = await litellm.acompletion(**args)
433 
434         if len(response.choices) > 1:
435             raise ValueError("Multiple choices found in the response.")
436         if not response.choices or response.choices[0].finish_reason != "tool_calls":
437             raise ValueError("No tool_calls found in response")
438 
439         choice = response.choices[0]
440         try:
441             # Parse the tool call content as JSON
442             tool_call = choice.message.tool_calls[0]
443             tool_call_data = json.loads(tool_call.function.arguments)
444             # Instantiate the output model with the parsed data
445             return output_model(**tool_call_data)
446         except ContextWindowExceededError as e:
447             logger.warning("litellm client raised context window overflow in structured_output")
448             raise ContextWindowOverflowException(e) from e
449         except (json.JSONDecodeError, TypeError, ValueError) as e:
450             raise ValueError(f"Failed to parse or load content into model: {e}") from e
451 
452     async def _process_choice_content(
453         self, choice: Any, data_type: str | None, tool_calls: dict[int, list[Any]], is_streaming: bool = True
454     ) -> AsyncGenerator[tuple[str | None, StreamEvent], None]:
455         """Process content from a choice object (streaming or non-streaming).
456 
457         Args:
458             choice: The choice object from the response.
459             data_type: Current data type being processed.
460             tool_calls: Dictionary to collect tool calls.
461             is_streaming: Whether this is from a streaming response.
462 
463         Yields:
464             Tuples of (updated_data_type, stream_event).
465         """
466         # Get the content source - this is the only difference between streaming/non-streaming
467         # We use duck typing here: both choice.delta and choice.message have the same interface
468         # (reasoning_content, content, tool_calls attributes) but different object structures
469         content_source = choice.delta if is_streaming else choice.message
470 
471         # Process reasoning content
472         if hasattr(content_source, "reasoning_content") and content_source.reasoning_content:
473             chunks, data_type = self._stream_switch_content("reasoning_content", data_type)
474             for chunk in chunks:
475                 yield data_type, chunk
476             chunk = self.format_chunk(
477                 {
478                     "chunk_type": "content_delta",
479                     "data_type": "reasoning_content",
480                     "data": content_source.reasoning_content,
481                 }
482             )
483             yield data_type, chunk
484 
485         # Process text content
486         if hasattr(content_source, "content") and content_source.content:
487             chunks, data_type = self._stream_switch_content("text", data_type)
488             for chunk in chunks:
489                 yield data_type, chunk
490             chunk = self.format_chunk(
491                 {
492                     "chunk_type": "content_delta",
493                     "data_type": "text",
494                     "data": content_source.content,
495                 }
496             )
497             yield data_type, chunk
498 
499         # Process tool calls
500         if hasattr(content_source, "tool_calls") and content_source.tool_calls:
501             if is_streaming:
502                 # Streaming: tool calls have index attribute for out-of-order delivery
503                 for tool_call in content_source.tool_calls:
504                     tool_calls.setdefault(tool_call.index, []).append(tool_call)
505             else:
506                 # Non-streaming: tool calls arrive in order, use enumerated index
507                 for i, tool_call in enumerate(content_source.tool_calls):
508                     tool_calls.setdefault(i, []).append(tool_call)
509 
510     async def _process_tool_calls(self, tool_calls: dict[int, list[Any]]) -> AsyncGenerator[StreamEvent, None]:
511         """Process and yield tool call events.
512 
513         Args:
514             tool_calls: Dictionary of tool calls indexed by their position.
515 
516         Yields:
517             Formatted tool call chunks.
518         """
519         for tool_deltas in tool_calls.values():
520             yield self.format_chunk({"chunk_type": "content_start", "data_type": "tool", "data": tool_deltas[0]})
521 
522             for tool_delta in tool_deltas:
523                 yield self.format_chunk({"chunk_type": "content_delta", "data_type": "tool", "data": tool_delta})
524 
525             yield self.format_chunk({"chunk_type": "content_stop", "data_type": "tool"})
526 
527     async def _handle_non_streaming_response(
528         self, litellm_request: dict[str, Any]
529     ) -> AsyncGenerator[StreamEvent, None]:
530         """Handle non-streaming response from LiteLLM.
531 
532         Args:
533             litellm_request: The formatted request for LiteLLM.
534 
535         Yields:
536             Formatted message chunks from the model.
537         """
538         response = await litellm.acompletion(**self.client_args, **litellm_request)
539 
540         logger.debug("got non-streaming response from model")
541         yield self.format_chunk({"chunk_type": "message_start"})
542 
543         tool_calls: dict[int, list[Any]] = {}
544         data_type: str | None = None
545         finish_reason: str | None = None
546 
547         if hasattr(response, "choices") and response.choices and len(response.choices) > 0:
548             choice = response.choices[0]
549 
550             if hasattr(choice, "message") and choice.message:
551                 # Process content using shared logic
552                 async for updated_data_type, chunk in self._process_choice_content(
553                     choice, data_type, tool_calls, is_streaming=False
554                 ):
555                     data_type = updated_data_type
556                     yield chunk
557 
558             if hasattr(choice, "finish_reason"):
559                 finish_reason = choice.finish_reason
560 
561         # Stop the current content block if we have one
562         if data_type:
563             yield self.format_chunk({"chunk_type": "content_stop", "data_type": data_type})
564 
565         # Process tool calls
566         async for chunk in self._process_tool_calls(tool_calls):
567             yield chunk
568 
569         yield self.format_chunk({"chunk_type": "message_stop", "data": finish_reason})
570 
571         # Add usage information if available
572         if hasattr(response, "usage"):
573             yield self.format_chunk({"chunk_type": "metadata", "data": response.usage})
574 
575     async def _handle_streaming_response(self, litellm_request: dict[str, Any]) -> AsyncGenerator[StreamEvent, None]:
576         """Handle streaming response from LiteLLM.
577 
578         Args:
579             litellm_request: The formatted request for LiteLLM.
580 
581         Yields:
582             Formatted message chunks from the model.
583         """
584         # For streaming, use the streaming API
585         response = await litellm.acompletion(**self.client_args, **litellm_request)
586 
587         logger.debug("got response from model")
588         yield self.format_chunk({"chunk_type": "message_start"})
589 
590         tool_calls: dict[int, list[Any]] = {}
591         data_type: str | None = None
592         finish_reason: str | None = None
593 
594         async for event in response:
595             # Defensive: skip events with empty or missing choices
596             if not getattr(event, "choices", None):
597                 continue
598             choice = event.choices[0]
599 
600             # Process content using shared logic
601             async for updated_data_type, chunk in self._process_choice_content(
602                 choice, data_type, tool_calls, is_streaming=True
603             ):
604                 data_type = updated_data_type
605                 yield chunk
606 
607             if choice.finish_reason:
608                 finish_reason = choice.finish_reason
609                 if data_type:
610                     yield self.format_chunk({"chunk_type": "content_stop", "data_type": data_type})
611                 break
612 
613         # Process tool calls
614         async for chunk in self._process_tool_calls(tool_calls):
615             yield chunk
616 
617         yield self.format_chunk({"chunk_type": "message_stop", "data": finish_reason})
618 
619         # Skip remaining events as we don't have use for anything except the final usage payload
620         async for event in response:
621             _ = event
622             if usage := getattr(event, "usage", None):
623                 yield self.format_chunk({"chunk_type": "metadata", "data": usage})
624 
625         logger.debug("finished streaming response from model")
626 
627     def _apply_proxy_prefix(self) -> None:
628         """Apply litellm_proxy/ prefix to model_id when use_litellm_proxy is True.
629 
630         This is a workaround for https://github.com/BerriAI/litellm/issues/13454
631         where use_litellm_proxy parameter is not honored.
632         """
633         if self.client_args.get("use_litellm_proxy") and "model_id" in self.config:
634             model_id = self.get_config()["model_id"]
635             if not model_id.startswith("litellm_proxy/"):
636                 self.config["model_id"] = f"litellm_proxy/{model_id}"

