120     def _get_client(self) -> genai.Client:
121         """Get a Gemini client for making requests.
122 
123         This method handles client lifecycle management:
124         - If an injected client was provided during initialization, it returns that client
125           without managing its lifecycle (caller is responsible for cleanup).
126         - Otherwise, creates a new genai.Client from client_args.
127 
128         Returns:
129             genai.Client: A Gemini client instance.
130         """
131         if self._custom_client is not None:
132             # Use the injected client (caller manages lifecycle)
133             return self._custom_client
134         else:
135             # Create a new client from client_args
136             return genai.Client(**self.client_args)
