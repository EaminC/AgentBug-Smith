99 
100     def _format_request_message_content(self, content: ContentBlock) -> dict[str, Any]:
101         """Format an Anthropic content block.
102 
103         Args:
104             content: Message content.
105 
106         Returns:
107             Anthropic formatted content block.
108 
109         Raises:
110             TypeError: If the content block type cannot be converted to an Anthropic-compatible format.
111         """
112         if "document" in content:
113             mime_type = mimetypes.types_map.get(f".{content['document']['format']}", "application/octet-stream")
114             return {
115                 "source": {
116                     "data": (
117                         content["document"]["source"]["bytes"].decode("utf-8")
118                         if mime_type == "text/plain"
119                         else base64.b64encode(content["document"]["source"]["bytes"]).decode("utf-8")
120                     ),
121                     "media_type": mime_type,
122                     "type": "text" if mime_type == "text/plain" else "base64",
123                 },
124                 "title": content["document"]["name"],
125                 "type": "document",
126             }
127 
128         if "image" in content:
129             return {
130                 "source": {
131                     "data": base64.b64encode(content["image"]["source"]["bytes"]).decode("utf-8"),
132                     "media_type": mimetypes.types_map.get(f".{content['image']['format']}", "application/octet-stream"),
133                     "type": "base64",
134                 },
135                 "type": "image",
136             }
137 
138         if "reasoningContent" in content:
139             return {
140                 "signature": content["reasoningContent"]["reasoningText"]["signature"],
141                 "thinking": content["reasoningContent"]["reasoningText"]["text"],
142                 "type": "thinking",
143             }
144 
145         if "text" in content:
146             return {"text": content["text"], "type": "text"}
147 
148         if "toolUse" in content:
149             return {
150                 "id": content["toolUse"]["toolUseId"],
151                 "input": content["toolUse"]["input"],
152                 "name": content["toolUse"]["name"],
153                 "type": "tool_use",
154             }
155 
156         if "toolResult" in content:
157             return {
158                 "content": [
159                     self._format_request_message_content(
160                         {"text": json.dumps(tool_result_content["json"])}
161                         if "json" in tool_result_content
162                         else cast(ContentBlock, tool_result_content)
163                     )
164                     for tool_result_content in content["toolResult"]["content"]
165                 ],
166                 "is_error": content["toolResult"]["status"] == "error",
167                 "tool_use_id": content["toolResult"]["toolUseId"],
168                 "type": "tool_result",
169             }
170 
171         raise TypeError(f"content_type=<{next(iter(content))}> | unsupported type")
172 
173     def _format_request_messages(self, messages: Messages) -> list[dict[str, Any]]:
174         """Format an Anthropic messages array.
175 
176         Args:
177             messages: List of message objects to be processed by the model.
178 
179         Returns:
180             An Anthropic messages array.
181         """
182         formatted_messages = []
183 
184         for message in messages:
185             formatted_contents: list[dict[str, Any]] = []
186 
187             for content in message["content"]:
188                 if "cachePoint" in content:
189                     formatted_contents[-1]["cache_control"] = {"type": "ephemeral"}
190                     continue
191 
192                 # Check for location sources in image, document, or video content
193                 if _has_location_source(content):
194                     logger.warning("Location sources are not supported by Anthropic | skipping content block")
195                     continue
196 
197                 formatted_contents.append(self._format_request_message_content(content))
198 
199             if formatted_contents:
200                 formatted_messages.append({"content": formatted_contents, "role": message["role"]})
201 
202         return formatted_messages
203 
204     def format_request(
205         self,
206         messages: Messages,
207         tool_specs: list[ToolSpec] | None = None,
208         system_prompt: str | None = None,
209         tool_choice: ToolChoice | None = None,
210     ) -> dict[str, Any]:
211         """Format an Anthropic streaming request.
212 
213         Args:
214             messages: List of message objects to be processed by the model.
215             tool_specs: List of tool specifications to make available to the model.
216             system_prompt: System prompt to provide context to the model.
217             tool_choice: Selection strategy for tool invocation.
218 
219         Returns:
220             An Anthropic streaming request.
221 
222         Raises:
223             TypeError: If a message contains a content block type that cannot be converted to an Anthropic-compatible
224                 format.
225         """
226         return {
227             "max_tokens": self.config["max_tokens"],
228             "messages": self._format_request_messages(messages),
229             "model": self.config["model_id"],
230             "tools": [
231                 {
232                     "name": tool_spec["name"],
233                     "description": tool_spec["description"],
234                     "input_schema": tool_spec["inputSchema"]["json"],
235                 }
236                 for tool_spec in tool_specs or []
237             ],
238             **(self._format_tool_choice(tool_choice)),
239             **({"system": system_prompt} if system_prompt else {}),
240             **(self.config.get("params") or {}),
241         }
242 
243     @staticmethod
244     def _format_tool_choice(tool_choice: ToolChoice | None) -> dict:
245         if tool_choice is None:
246             return {}
247 
248         if "any" in tool_choice:
249             return {"tool_choice": {"type": "any"}}
250         elif "auto" in tool_choice:
251             return {"tool_choice": {"type": "auto"}}
252         elif "tool" in tool_choice:
253             return {"tool_choice": {"type": "tool", "name": cast(ToolChoiceToolDict, tool_choice)["tool"]["name"]}}
254         else:
255             return {}
256 
257     def format_chunk(self, event: dict[str, Any]) -> StreamEvent:
258         """Format the Anthropic response events into standardized message chunks.
259 
260         Args:
261             event: A response event from the Anthropic model.
262 
263         Returns:
264             The formatted chunk.
265 
266         Raises:
267             RuntimeError: If chunk_type is not recognized.
268                 This error should never be encountered as we control chunk_type in the stream method.
269         """
270         match event["type"]:
271             case "message_start":
272                 return {"messageStart": {"role": "assistant"}}
273 
274             case "content_block_start":
275                 content = event["content_block"]
276 
277                 if content["type"] == "tool_use":
278                     return {
279                         "contentBlockStart": {
280                             "contentBlockIndex": event["index"],
281                             "start": {
282                                 "toolUse": {
283                                     "name": content["name"],
284                                     "toolUseId": content["id"],
285                                 }
286                             },
287                         }
288                     }
289 
290                 return {"contentBlockStart": {"contentBlockIndex": event["index"], "start": {}}}
291 
292             case "content_block_delta":
293                 delta = event["delta"]
294 
295                 match delta["type"]:
296                     case "signature_delta":
297                         return {
298                             "contentBlockDelta": {
299                                 "contentBlockIndex": event["index"],
300                                 "delta": {
301                                     "reasoningContent": {
302                                         "signature": delta["signature"],
303                                     },
304                                 },
305                             },
306                         }
307 
308                     case "thinking_delta":
309                         return {
310                             "contentBlockDelta": {
311                                 "contentBlockIndex": event["index"],
312                                 "delta": {
313                                     "reasoningContent": {
314                                         "text": delta["thinking"],
315                                     },
316                                 },
317                             },
318                         }
319 
320                     case "input_json_delta":
321                         return {
322                             "contentBlockDelta": {
323                                 "contentBlockIndex": event["index"],
324                                 "delta": {
325                                     "toolUse": {
326                                         "input": delta["partial_json"],
327                                     },
328                                 },
329                             },
330                         }
331 
332                     case "text_delta":
333                         return {
334                             "contentBlockDelta": {
335                                 "contentBlockIndex": event["index"],
336                                 "delta": {
337                                     "text": delta["text"],
338                                 },
339                             },
340                         }
341 
342                     case _:
343                         raise RuntimeError(
344                             f"event_type=<content_block_delta>, delta_type=<{delta['type']}> | unknown type"
345                         )
346 
347             case "content_block_stop":
348                 return {"contentBlockStop": {"contentBlockIndex": event["index"]}}
349 
350             case "message_stop":
351                 message = event["message"]
352 
353                 return {"messageStop": {"stopReason": message["stop_reason"]}}
354 
355             case "metadata":
356                 usage = event["usage"]
357 
358                 return {
359                     "metadata": {
360                         "usage": {
361                             "inputTokens": usage["input_tokens"],
362                             "outputTokens": usage["output_tokens"],
363                             "totalTokens": usage["input_tokens"] + usage["output_tokens"],
364                         },
365                         "metrics": {
366                             "latencyMs": 0,  # TODO
367                         },
368                     }
369                 }
370 
371             case _:
372                 raise RuntimeError(f"event_type=<{event['type']} | unknown type")
373 
374     @override
375     async def stream(
376         self,
377         messages: Messages,
378         tool_specs: list[ToolSpec] | None = None,
379         system_prompt: str | None = None,
380         *,
381         tool_choice: ToolChoice | None = None,
382         **kwargs: Any,
383     ) -> AsyncGenerator[StreamEvent, None]:
384         """Stream conversation with the Anthropic model.
385 
386         Args:
387             messages: List of message objects to be processed by the model.
388             tool_specs: List of tool specifications to make available to the model.
389             system_prompt: System prompt to provide context to the model.
390             tool_choice: Selection strategy for tool invocation.
391             **kwargs: Additional keyword arguments for future extensibility.
392 
393         Yields:
394             Formatted message chunks from the model.
395 
396         Raises:
397             ContextWindowOverflowException: If the input exceeds the model's context window.
398             ModelThrottledException: If the request is throttled by Anthropic.
399         """
400         logger.debug("formatting request")
401         request = self.format_request(messages, tool_specs, system_prompt, tool_choice)
402         logger.debug("request=<%s>", request)
403 
404         logger.debug("invoking model")
405         try:
406             async with self.client.messages.stream(**request) as stream:
407                 logger.debug("got response from model")
408                 async for event in stream:
409                     if event.type in AnthropicModel.EVENT_TYPES:
410                         if event.type == "message_stop":
411                             # Build dict directly to avoid Pydantic serialization warnings
412                             # when the message contains ParsedTextBlock objects (issue #1746)
413                             yield self.format_chunk(
414                                 {
415                                     "type": "message_stop",
416                                     "message": {"stop_reason": event.message.stop_reason},
417                                 }
418                             )
419                         else:
420                             yield self.format_chunk(event.model_dump())
421 
422                 try:
423                     message_snapshot = await stream.get_final_message()
424                 except AssertionError as e:
425                     logger.warning("error=<%s> | failed to retrieve message snapshot, usage metadata unavailable", e)
426                 else:
427                     yield self.format_chunk({"type": "metadata", "usage": message_snapshot.usage.model_dump()})
428 
429         except anthropic.RateLimitError as error:
430             raise ModelThrottledException(str(error)) from error
431 
432         except anthropic.BadRequestError as error:
433             if any(overflow_message in str(error).lower() for overflow_message in AnthropicModel.OVERFLOW_MESSAGES):
434                 raise ContextWindowOverflowException(str(error)) from error
435 
436             raise error
437 
438         logger.debug("finished streaming response from model")
439 
440     @override
441     async def structured_output(
442         self, output_model: type[T], prompt: Messages, system_prompt: str | None = None, **kwargs: Any
443     ) -> AsyncGenerator[dict[str, T | Any], None]:
444         """Get structured output from the model.
445 
446         Args:
447             output_model: The output model to use for the agent.
448             prompt: The prompt messages to use for the agent.
449             system_prompt: System prompt to provide context to the model.
450             **kwargs: Additional keyword arguments for future extensibility.
451 
452         Yields:
453             Model events with the last being the structured output.
454         """
455         tool_spec = convert_pydantic_to_tool_spec(output_model)
456 
457         response = self.stream(
458             messages=prompt,
459             tool_specs=[tool_spec],
460             system_prompt=system_prompt,
461             tool_choice=cast(ToolChoice, {"any": {}}),
462             **kwargs,
463         )
464         async for event in process_stream(response):
465             yield event
466 
467         stop_reason, messages, _, _ = event["stop"]
468 
469         if stop_reason != "tool_use":
470             raise ValueError(f'Model returned stop_reason: {stop_reason} instead of "tool_use".')
471 
472         content = messages["content"]
473         output_response: dict[str, Any] | None = None
474         for block in content:
475             # if the tool use name doesn't match the tool spec name, skip, and if the block is not a tool use, skip.
476             # if the tool use name never matches, raise an error.
477             if block.get("toolUse") and block["toolUse"]["name"] == tool_spec["name"]:
478                 output_response = block["toolUse"]["input"]
479             else:
480                 continue
481 
482         if output_response is None:
483             raise ValueError("No valid tool use or tool use input was found in the Anthropic response.")
484 
485         yield {"output": output_model(**output_response)}

