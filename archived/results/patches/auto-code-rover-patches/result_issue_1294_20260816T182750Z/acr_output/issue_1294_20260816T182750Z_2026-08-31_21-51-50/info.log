138     def _format_request_content_part(
139         self, content: ContentBlock, tool_use_id_to_name: dict[str, str]
140     ) -> genai.types.Part:
141         """Format content block into a Gemini part instance.
142 
143         - Docs: https://googleapis.github.io/python-genai/genai.html#genai.types.Part
144 
145         Args:
146             content: Message content to format.
147             tool_use_id_to_name: Mapping of tool use id to tool name.
148                 Store the mapping from toolUseId to name for later use in toolResult formatting. This mapping is built
149                 as we format the request, ensuring that when we encounter toolResult blocks (which come after toolUse
150                 blocks in the message history), we can look up the function name.
151 
152         Returns:
153             Gemini part.
154         """
155         if "document" in content:
156             return genai.types.Part(
157                 inline_data=genai.types.Blob(
158                     data=content["document"]["source"]["bytes"],
159                     mime_type=mimetypes.types_map.get(f".{content['document']['format']}", "application/octet-stream"),
160                 ),
161             )
162 
163         if "image" in content:
164             return genai.types.Part(
165                 inline_data=genai.types.Blob(
166                     data=content["image"]["source"]["bytes"],
167                     mime_type=mimetypes.types_map.get(f".{content['image']['format']}", "application/octet-stream"),
168                 ),
169             )
170 
171         if "reasoningContent" in content:
172             thought_signature = content["reasoningContent"]["reasoningText"].get("signature")
173 
174             return genai.types.Part(
175                 text=content["reasoningContent"]["reasoningText"]["text"],
176                 thought=True,
177                 thought_signature=base64.b64decode(thought_signature) if thought_signature else None,
178             )
179 
180         if "text" in content:
181             return genai.types.Part(text=content["text"])
182 
183         if "toolResult" in content:
184             tool_use_id = content["toolResult"]["toolUseId"]
185             function_name = tool_use_id_to_name.get(tool_use_id, tool_use_id)
186 
187             return genai.types.Part(
188                 function_response=genai.types.FunctionResponse(
189                     id=tool_use_id,
190                     name=function_name,
191                     response={
192                         "output": [
193                             tool_result_content
194                             if "json" in tool_result_content
195                             else self._format_request_content_part(
196                                 cast(ContentBlock, tool_result_content),
197                                 tool_use_id_to_name,
198                             ).to_json_dict()
199                             for tool_result_content in content["toolResult"]["content"]
200                         ],
201                     },
202                 ),
203             )
204 
205         if "toolUse" in content:
206             tool_use_id = content["toolUse"]["toolUseId"]
207             tool_use_id_to_name[tool_use_id] = content["toolUse"]["name"]
208 
209             reasoning_signature = content["toolUse"].get("reasoningSignature")
210 
211             return genai.types.Part(
212                 function_call=genai.types.FunctionCall(
213                     args=content["toolUse"]["input"],
214                     id=tool_use_id,
215                     name=content["toolUse"]["name"],
216                 ),
217                 thought_signature=base64.b64decode(reasoning_signature) if reasoning_signature else None,
218             )
219 
220         raise TypeError(f"content_type=<{next(iter(content))}> | unsupported type")
221 
222     def _format_request_content(self, messages: Messages) -> list[genai.types.Content]:
223         """Format message content into Gemini content instances.
224 
225         - Docs: https://googleapis.github.io/python-genai/genai.html#genai.types.Content
226 
227         Args:
228             messages: List of message objects to be processed by the model.
229 
230         Returns:
231             Gemini content list.
232         """
233         # Gemini FunctionResponses are constructed from tool result blocks. Function name is required but is not
234         # available in tool result blocks, hence the mapping.
235         tool_use_id_to_name: dict[str, str] = {}
236 
237         contents = []
238         for message in messages:
239             parts = []
240             for content in message["content"]:
241                 # Check for location sources and skip with warning
242                 if _has_location_source(content):
243                     logger.warning("Location sources are not supported by Gemini | skipping content block")
244                     continue
245                 parts.append(self._format_request_content_part(content, tool_use_id_to_name))
246 
247             contents.append(
248                 genai.types.Content(
249                     parts=parts,
250                     role="user" if message["role"] == "user" else "model",
251                 )
252             )
253 
254         return contents
255 
256     def _format_request_tools(self, tool_specs: list[ToolSpec] | None) -> list[genai.types.Tool | Any]:
257         """Format tool specs into Gemini tools.
258 
259         - Docs: https://googleapis.github.io/python-genai/genai.html#genai.types.Tool
260 
261         Args:
262             tool_specs: List of tool specifications to make available to the model.
263 
264         Return:
265             Gemini tool list.
266         """
267         tools = [
268             genai.types.Tool(
269                 function_declarations=[
270                     genai.types.FunctionDeclaration(
271                         description=tool_spec["description"],
272                         name=tool_spec["name"],
273                         parameters_json_schema=tool_spec["inputSchema"]["json"],
274                     )
275                     for tool_spec in tool_specs or []
276                 ],
277             ),
278         ]
279         if self.config.get("gemini_tools"):
280             tools.extend(self.config["gemini_tools"])
281         return tools
