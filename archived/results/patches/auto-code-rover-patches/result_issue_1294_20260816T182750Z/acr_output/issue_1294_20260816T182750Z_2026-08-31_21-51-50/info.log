59         Attributes:
60             model_id: Model ID (e.g., "gpt-4o").
61                 For a complete list of supported models, see https://platform.openai.com/docs/models.
62             params: Model parameters (e.g., max_tokens).
63                 For a complete list of supported parameters, see
64                 https://platform.openai.com/docs/api-reference/chat/create.
65         """
66 
67         model_id: str
68         params: dict[str, Any] | None
69 
70     def __init__(
71         self,
72         client: Client | None = None,
73         client_args: dict[str, Any] | None = None,
74         **model_config: Unpack[OpenAIConfig],
75     ) -> None:
76         """Initialize provider instance.
77 
78         Args:
79             client: Pre-configured OpenAI-compatible client to reuse across requests.
80                 When provided, this client will be reused for all requests and will NOT be closed
81                 by the model. The caller is responsible for managing the client lifecycle.
82                 This is useful for:
83                 - Injecting custom client wrappers (e.g., GuardrailsAsyncOpenAI)
84                 - Reusing connection pools within a single event loop/worker
85                 - Centralizing observability, retries, and networking policy
86                 - Pointing to custom model gateways
87                 Note: The client should not be shared across different asyncio event loops.
88             client_args: Arguments for the OpenAI client (legacy approach).
89                 For a complete list of supported arguments, see https://pypi.org/project/openai/.
90             **model_config: Configuration options for the OpenAI model.
91 
92         Raises:
93             ValueError: If both `client` and `client_args` are provided.
94         """
95         validate_config_keys(model_config, self.OpenAIConfig)
96         self.config = dict(model_config)
97 
98         # Validate that only one client configuration method is provided
99         if client is not None and client_args is not None and len(client_args) > 0:
100             raise ValueError("Only one of 'client' or 'client_args' should be provided, not both.")
101 
102         self._custom_client = client
103         self.client_args = client_args or {}
104 
105         logger.debug("config=<%s> | initializing", self.config)
106 
107     @override
108     def update_config(self, **model_config: Unpack[OpenAIConfig]) -> None:  # type: ignore[override]
109         """Update the OpenAI model configuration with the provided arguments.
110 
111         Args:
112             **model_config: Configuration overrides.
113         """
114         validate_config_keys(model_config, self.OpenAIConfig)
115         self.config.update(model_config)
116 
117     @override
118     def get_config(self) -> OpenAIConfig:
119         """Get the OpenAI model configuration.
120 
121         Returns:
122             The OpenAI model configuration.
123         """
124         return cast(OpenAIModel.OpenAIConfig, self.config)
125 
126     @classmethod
127     def format_request_message_content(cls, content: ContentBlock, **kwargs: Any) -> dict[str, Any]:
128         """Format an OpenAI compatible content block.
129 
130         Args:
131             content: Message content.
132             **kwargs: Additional keyword arguments for future extensibility.
133 
134         Returns:
135             OpenAI compatible content block.
136 
137         Raises:
138             TypeError: If the content block type cannot be converted to an OpenAI-compatible format.
139         """
140         if "document" in content:
141             mime_type = mimetypes.types_map.get(f".{content['document']['format']}", "application/octet-stream")
142             file_data = base64.b64encode(content["document"]["source"]["bytes"]).decode("utf-8")
143             return {
144                 "file": {
145                     "file_data": f"data:{mime_type};base64,{file_data}",
146                     "filename": content["document"]["name"],
147                 },
148                 "type": "file",
149             }
150 
151         if "image" in content:
152             mime_type = mimetypes.types_map.get(f".{content['image']['format']}", "application/octet-stream")
153             image_data = base64.b64encode(content["image"]["source"]["bytes"]).decode("utf-8")
154 
155             return {
156                 "image_url": {
157                     "detail": "auto",
158                     "format": mime_type,
159                     "url": f"data:{mime_type};base64,{image_data}",
160                 },
161                 "type": "image_url",
162             }
163 
164         if "text" in content:
165             return {"text": content["text"], "type": "text"}
166 
167         raise TypeError(f"content_type=<{next(iter(content))}> | unsupported type")
168 
169     @classmethod
170     def format_request_message_tool_call(cls, tool_use: ToolUse, **kwargs: Any) -> dict[str, Any]:
171         """Format an OpenAI compatible tool call.
172 
173         Args:
174             tool_use: Tool use requested by the model.
175             **kwargs: Additional keyword arguments for future extensibility.
176 
177         Returns:
178             OpenAI compatible tool call.
179         """
180         return {
181             "function": {
182                 "arguments": json.dumps(tool_use["input"]),
183                 "name": tool_use["name"],
184             },
185             "id": tool_use["toolUseId"],
186             "type": "function",
187         }
188 
189     @classmethod
190     def format_request_tool_message(cls, tool_result: ToolResult, **kwargs: Any) -> dict[str, Any]:
191         """Format an OpenAI compatible tool message.
192 
193         Args:
194             tool_result: Tool result collected from a tool execution.
195             **kwargs: Additional keyword arguments for future extensibility.
196 
197         Returns:
198             OpenAI compatible tool message.
199         """
200         contents = cast(
201             list[ContentBlock],
202             [
203                 {"text": json.dumps(content["json"])} if "json" in content else content
204                 for content in tool_result["content"]
205             ],
206         )
207 
208         # Merge adjacent text blocks while preserving the order of non-text
209         # (image/document) content.  When all content is text, join into a
210         # single string for broad compatibility with OpenAI-compatible
211         # endpoints (e.g., Kimi K2.5, vLLM, Ollama).
212         # See https://github.com/strands-agents/sdk-python/issues/1696
213         merged: list[dict[str, Any]] = []
214         has_non_text = False
215         for content_block in contents:
216             if "text" in content_block:
217                 # Merge with the previous entry if it is also text (adjacent)
218                 if merged and merged[-1].get("type") == "text":
219                     merged[-1]["text"] += "\n" + content_block["text"]
220                 else:
221                     merged.append({"type": "text", "text": content_block["text"]})
222             elif "image" in content_block or "document" in content_block:
223                 has_non_text = True
224                 merged.append(cls.format_request_message_content(content_block))
225 
226         content: str | list[dict[str, Any]]
227         if has_non_text:
228             # Keep array format when images/documents are present so that
229             # _split_tool_message_images can extract them into a user message.
230             content = merged
231         else:
232             # All text — the loop already merged adjacent blocks with "\n",
233             # so extract the single resulting entry.
234             content = merged[0]["text"] if merged else ""
235 
236         return {
237             "role": "tool",
238             "tool_call_id": tool_result["toolUseId"],
239             "content": content,
240         }
241 
242     @classmethod
243     def _split_tool_message_images(cls, tool_message: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any] | None]:
244         """Split a tool message into text-only tool message and optional user message with images.
245 
246         OpenAI API restricts images to user role messages only. This method extracts any image
247         content from a tool message and returns it separately as a user message.
248 
249         Args:
250             tool_message: A formatted tool message that may contain images.
251 
252         Returns:
253             A tuple of (tool_message_without_images, user_message_with_images_or_None).
254         """
255         if tool_message.get("role") != "tool":
256             return tool_message, None
257 
258         content = tool_message.get("content", [])
259         if not isinstance(content, list):
260             return tool_message, None
261 
262         # Separate image and non-image content
263         text_content = []
264         image_content = []
265 
266         for item in content:
267             if isinstance(item, dict) and item.get("type") == "image_url":
268                 image_content.append(item)
269             else:
270                 text_content.append(item)
271 
272         # If no images found, return original message
273         if not image_content:
274             return tool_message, None
275 
276         # Let the user know that we are modifying the messages for OpenAI compatibility
277         logger.warning(
278             "tool_call_id=<%s> | Moving image from tool message to a new user message for OpenAI compatibility",
279             tool_message["tool_call_id"],
280         )
281 
282         # Append a message to the text content to inform the model about the upcoming image
283         text_content.append(
284             {
285                 "type": "text",
286                 "text": (
287                     "Tool successfully returned an image. The image is being provided in the following user message."
288                 ),
289             }
290         )
291 
292         # Create the clean tool message with the updated text content
293         tool_message_clean = {
294             "role": "tool",
295             "tool_call_id": tool_message["tool_call_id"],
296             "content": text_content,
297         }
298 
299         # Create user message with only images
300         user_message_with_images = {"role": "user", "content": image_content}
301 
302         return tool_message_clean, user_message_with_images
303 
304     @classmethod
305     def _format_request_tool_choice(cls, tool_choice: ToolChoice | None) -> dict[str, Any]:
306         """Format a tool choice for OpenAI compatibility.
307 
308         Args:
309             tool_choice: Tool choice configuration in Bedrock format.
310 
311         Returns:
312             OpenAI compatible tool choice format.
313         """
314         if not tool_choice:
315             return {}
316 
317         match tool_choice:
318             case {"auto": _}:
319                 return {"tool_choice": "auto"}  # OpenAI SDK doesn't define constants for these values
320             case {"any": _}:
321                 return {"tool_choice": "required"}
322             case {"tool": {"name": tool_name}}:
323                 return {"tool_choice": {"type": "function", "function": {"name": tool_name}}}
324             case _:
325                 # This should not happen with proper typing, but handle gracefully
326                 return {"tool_choice": "auto"}
327 
328     @classmethod
329     def _format_system_messages(
330         cls,
331         system_prompt: str | None = None,
332         *,
333         system_prompt_content: list[SystemContentBlock] | None = None,
334         **kwargs: Any,
335     ) -> list[dict[str, Any]]:
336         """Format system messages for OpenAI-compatible providers.
337 
338         Args:
339             system_prompt: System prompt to provide context to the model.
340             system_prompt_content: System prompt content blocks to provide context to the model.
341             **kwargs: Additional keyword arguments for future extensibility.
342 
343         Returns:
344             List of formatted system messages.
345         """
346         # Handle backward compatibility: if system_prompt is provided but system_prompt_content is None
347         if system_prompt and system_prompt_content is None:
348             system_prompt_content = [{"text": system_prompt}]
349 
350         # TODO: Handle caching blocks https://github.com/strands-agents/sdk-python/issues/1140
351         return [
352             {"role": "system", "content": content["text"]}
353             for content in system_prompt_content or []
354             if "text" in content
355         ]
356 
357     @classmethod
358     def _format_regular_messages(cls, messages: Messages, **kwargs: Any) -> list[dict[str, Any]]:
359         """Format regular messages for OpenAI-compatible providers.
360 
361         Args:
362             messages: List of message objects to be processed by the model.
363             **kwargs: Additional keyword arguments for future extensibility.
364 
365         Returns:
366             List of formatted messages.
367         """
368         formatted_messages = []
369 
370         for message in messages:
371             contents = message["content"]
372 
373             # Check for reasoningContent and warn user
374             if any("reasoningContent" in content for content in contents):
375                 logger.warning(
376                     "reasoningContent is not supported in multi-turn conversations with the Chat Completions API."
377                 )
378 
379             # Filter out content blocks that shouldn't be formatted
380             filtered_contents = []
381             for content in contents:
382                 if any(block_type in content for block_type in ["toolResult", "toolUse", "reasoningContent"]):
383                     continue
384                 if _has_location_source(content):
385                     logger.warning("Location sources are not supported by OpenAI | skipping content block")
386                     continue
387                 filtered_contents.append(content)
388 
389             formatted_contents = [cls.format_request_message_content(content) for content in filtered_contents]
390             formatted_tool_calls = [
391                 cls.format_request_message_tool_call(content["toolUse"]) for content in contents if "toolUse" in content
392             ]
393             formatted_tool_messages = [
394                 cls.format_request_tool_message(content["toolResult"])
395                 for content in contents
396                 if "toolResult" in content
397             ]
398 
399             formatted_message = {
400                 "role": message["role"],
401                 **({"content": formatted_contents} if formatted_contents else {}),
402                 **({"tool_calls": formatted_tool_calls} if formatted_tool_calls else {}),
403             }
404             formatted_messages.append(formatted_message)
405 
406             # Process tool messages to extract images into separate user messages
407             # OpenAI API requires images to be in user role messages only
408             # All tool messages must be grouped together before any user messages with images
409             user_messages_with_images = []
410             for tool_msg in formatted_tool_messages:
411                 tool_msg_clean, user_msg_with_images = cls._split_tool_message_images(tool_msg)
412                 formatted_messages.append(tool_msg_clean)
413                 if user_msg_with_images:
414                     user_messages_with_images.append(user_msg_with_images)
415             formatted_messages.extend(user_messages_with_images)
416 
417         return formatted_messages
418 
419     @classmethod
420     def format_request_messages(
421         cls,
422         messages: Messages,
423         system_prompt: str | None = None,
424         *,
425         system_prompt_content: list[SystemContentBlock] | None = None,
426         **kwargs: Any,
427     ) -> list[dict[str, Any]]:
428         """Format an OpenAI compatible messages array.
429 
430         Args:
431             messages: List of message objects to be processed by the model.
432             system_prompt: System prompt to provide context to the model.
433             system_prompt_content: System prompt content blocks to provide context to the model.
434             **kwargs: Additional keyword arguments for future extensibility.
435 
436         Returns:
437             An OpenAI compatible messages array.
438         """
439         formatted_messages = cls._format_system_messages(system_prompt, system_prompt_content=system_prompt_content)
440         formatted_messages.extend(cls._format_regular_messages(messages))
441 
442         return [message for message in formatted_messages if "content" in message or "tool_calls" in message]
443 
444     def format_request(
445         self,
446         messages: Messages,
447         tool_specs: list[ToolSpec] | None = None,
448         system_prompt: str | None = None,
449         tool_choice: ToolChoice | None = None,
450         *,
451         system_prompt_content: list[SystemContentBlock] | None = None,
452         **kwargs: Any,
453     ) -> dict[str, Any]:
454         """Format an OpenAI compatible chat streaming request.
455 
456         Args:
457             messages: List of message objects to be processed by the model.
458             tool_specs: List of tool specifications to make available to the model.
459             system_prompt: System prompt to provide context to the model.
460             tool_choice: Selection strategy for tool invocation.
461             system_prompt_content: System prompt content blocks to provide context to the model.
462             **kwargs: Additional keyword arguments for future extensibility.
463 
464         Returns:
465             An OpenAI compatible chat streaming request.
466 
467         Raises:
468             TypeError: If a message contains a content block type that cannot be converted to an OpenAI-compatible
469                 format.
470         """
471         return {
472             "messages": self.format_request_messages(
473                 messages, system_prompt, system_prompt_content=system_prompt_content
474             ),
475             "model": self.config["model_id"],
476             "stream": True,
477             "stream_options": {"include_usage": True},
478             "tools": [
479                 {
480                     "type": "function",
481                     "function": {
482                         "name": tool_spec["name"],
483                         "description": tool_spec["description"],
484                         "parameters": tool_spec["inputSchema"]["json"],
485                     },
486                 }
487                 for tool_spec in tool_specs or []
488             ],
489             **(self._format_request_tool_choice(tool_choice)),
490             **cast(dict[str, Any], self.config.get("params", {})),
491         }
492 
493     def format_chunk(self, event: dict[str, Any], **kwargs: Any) -> StreamEvent:
494         """Format an OpenAI response event into a standardized message chunk.
495 
496         Args:
497             event: A response event from the OpenAI compatible model.
498             **kwargs: Additional keyword arguments for future extensibility.
499 
500         Returns:
501             The formatted chunk.
502 
503         Raises:
504             RuntimeError: If chunk_type is not recognized.
505                 This error should never be encountered as chunk_type is controlled in the stream method.
506         """
507         match event["chunk_type"]:
508             case "message_start":
509                 return {"messageStart": {"role": "assistant"}}
510 
511             case "content_start":
512                 if event["data_type"] == "tool":
513                     return {
514                         "contentBlockStart": {
515                             "start": {
516                                 "toolUse": {
517                                     "name": event["data"].function.name,
518                                     "toolUseId": event["data"].id,
519                                 }
520                             }
521                         }
522                     }
523 
524                 return {"contentBlockStart": {"start": {}}}
525 
526             case "content_delta":
527                 if event["data_type"] == "tool":
528                     return {
529                         "contentBlockDelta": {"delta": {"toolUse": {"input": event["data"].function.arguments or ""}}}
530                     }
531 
532                 if event["data_type"] == "reasoning_content":
533                     return {"contentBlockDelta": {"delta": {"reasoningContent": {"text": event["data"]}}}}
534 
535                 return {"contentBlockDelta": {"delta": {"text": event["data"]}}}
536 
537             case "content_stop":
538                 return {"contentBlockStop": {}}
539 
540             case "message_stop":
541                 match event["data"]:
542                     case "tool_calls":
543                         return {"messageStop": {"stopReason": "tool_use"}}
544                     case "length":
545                         return {"messageStop": {"stopReason": "max_tokens"}}
546                     case _:
547                         return {"messageStop": {"stopReason": "end_turn"}}
548 
549             case "metadata":
550                 usage_data: Usage = {
551                     "inputTokens": event["data"].prompt_tokens,
552                     "outputTokens": event["data"].completion_tokens,
553                     "totalTokens": event["data"].total_tokens,
554                 }
555 
556                 if tokens_details := getattr(event["data"], "prompt_tokens_details", None):
557                     if cached := getattr(tokens_details, "cached_tokens", None):
558                         usage_data["cacheReadInputTokens"] = cached
559 
560                 return {
561                     "metadata": {
562                         "usage": usage_data,
563                         "metrics": {
564                             "latencyMs": 0,  # TODO
565                         },
566                     },
567                 }
568 
569             case _:
570                 raise RuntimeError(f"chunk_type=<{event['chunk_type']} | unknown type")
571 
572     @asynccontextmanager
573     async def _get_client(self) -> AsyncIterator[Any]:
574         """Get an OpenAI client for making requests.
575 
576         This context manager handles client lifecycle management:
577         - If an injected client was provided during initialization, it yields that client
578           without closing it (caller manages lifecycle).
579         - Otherwise, creates a new AsyncOpenAI client from client_args and automatically
580           closes it when the context exits.
581 
582         Note: We create a new client per request to avoid connection sharing in the underlying
583         httpx client, as the asyncio event loop does not allow connections to be shared.
584         For more details, see https://github.com/encode/httpx/discussions/2959.
585 
586         Yields:
587             Client: An OpenAI-compatible client instance.
588         """
589         if self._custom_client is not None:
590             # Use the injected client (caller manages lifecycle)
591             yield self._custom_client
592         else:
593             # Create a new client from client_args
594             # We initialize an OpenAI context on every request so as to avoid connection sharing in the underlying
595             # httpx client. The asyncio event loop does not allow connections to be shared. For more details, please
596             # refer to https://github.com/encode/httpx/discussions/2959.
597             async with openai.AsyncOpenAI(**self.client_args) as client:
598                 yield client
599 
600     @override
601     async def stream(
602         self,
603         messages: Messages,
604         tool_specs: list[ToolSpec] | None = None,
605         system_prompt: str | None = None,
606         *,
607         tool_choice: ToolChoice | None = None,
608         **kwargs: Any,
609     ) -> AsyncGenerator[StreamEvent, None]:
610         """Stream conversation with the OpenAI model.
611 
612         Args:
613             messages: List of message objects to be processed by the model.
614             tool_specs: List of tool specifications to make available to the model.
615             system_prompt: System prompt to provide context to the model.
616             tool_choice: Selection strategy for tool invocation.
617             **kwargs: Additional keyword arguments for future extensibility.
618 
619         Yields:
620             Formatted message chunks from the model.
621 
622         Raises:
623             ContextWindowOverflowException: If the input exceeds the model's context window.
624             ModelThrottledException: If the request is throttled by OpenAI (rate limits).
625         """
626         logger.debug("formatting request")
627         request = self.format_request(messages, tool_specs, system_prompt, tool_choice)
628         logger.debug("formatted request=<%s>", request)
629 
630         logger.debug("invoking model")
631 
632         # We initialize an OpenAI context on every request so as to avoid connection sharing in the underlying httpx
633         # client. The asyncio event loop does not allow connections to be shared. For more details, please refer to
634         # https://github.com/encode/httpx/discussions/2959.
635         async with self._get_client() as client:
636             try:
637                 response = await client.chat.completions.create(**request)
638             except openai.BadRequestError as e:
639                 # Check if this is a context length exceeded error
640                 if hasattr(e, "code") and e.code == "context_length_exceeded":
641                     logger.warning("OpenAI threw context window overflow error")
642                     raise ContextWindowOverflowException(str(e)) from e
643                 # Re-raise other BadRequestError exceptions
644                 raise
645             except openai.RateLimitError as e:
646                 # All rate limit errors should be treated as throttling, not context overflow
647                 # Rate limits (including TPM) require waiting/retrying, not context reduction
648                 logger.warning("OpenAI threw rate limit error")
649                 raise ModelThrottledException(str(e)) from e
650             except openai.APIError as e:
651                 # Check for alternative context overflow error messages
652                 error_message = str(e)
653                 if any(overflow_msg in error_message for overflow_msg in _CONTEXT_OVERFLOW_MESSAGES):
654                     logger.warning("context window overflow error detected")
655                     raise ContextWindowOverflowException(error_message) from e
656                 # Re-raise other APIError exceptions
657                 raise
658 
659             logger.debug("got response from model")
660             yield self.format_chunk({"chunk_type": "message_start"})
661             tool_calls: dict[int, list[Any]] = {}
662             data_type = None
663             finish_reason = None  # Store finish_reason for later use
664             event = None  # Initialize for scope safety
665 
666             async for event in response:
667                 # Defensive: skip events with empty or missing choices
668                 if not getattr(event, "choices", None):
669                     continue
670                 choice = event.choices[0]
671 
672                 if hasattr(choice.delta, "reasoning_content") and choice.delta.reasoning_content:
673                     chunks, data_type = self._stream_switch_content("reasoning_content", data_type)
674                     for chunk in chunks:
675                         yield chunk
676                     yield self.format_chunk(
677                         {
678                             "chunk_type": "content_delta",
679                             "data_type": data_type,
680                             "data": choice.delta.reasoning_content,
681                         }
682                     )
683 
684                 if choice.delta.content:
685                     chunks, data_type = self._stream_switch_content("text", data_type)
686                     for chunk in chunks:
687                         yield chunk
688                     yield self.format_chunk(
689                         {"chunk_type": "content_delta", "data_type": data_type, "data": choice.delta.content}
690                     )
691 
692                 for tool_call in choice.delta.tool_calls or []:
693                     tool_calls.setdefault(tool_call.index, []).append(tool_call)
694 
695                 if choice.finish_reason:
696                     finish_reason = choice.finish_reason  # Store for use outside loop
697                     if data_type:
698                         yield self.format_chunk({"chunk_type": "content_stop", "data_type": data_type})
699                     break
700 
701             for tool_deltas in tool_calls.values():
702                 yield self.format_chunk({"chunk_type": "content_start", "data_type": "tool", "data": tool_deltas[0]})
703 
704                 for tool_delta in tool_deltas:
705                     yield self.format_chunk({"chunk_type": "content_delta", "data_type": "tool", "data": tool_delta})
706 
707                 yield self.format_chunk({"chunk_type": "content_stop", "data_type": "tool"})
708 
709             yield self.format_chunk({"chunk_type": "message_stop", "data": finish_reason or "end_turn"})
710 
711             # Skip remaining events as we don't have use for anything except the final usage payload
712             async for event in response:
713                 _ = event
714 
715             if event and hasattr(event, "usage") and event.usage:
716                 yield self.format_chunk({"chunk_type": "metadata", "data": event.usage})
717 
718         logger.debug("finished streaming response from model")
719 
720     def _stream_switch_content(self, data_type: str, prev_data_type: str | None) -> tuple[list[StreamEvent], str]:
721         """Handle switching to a new content stream.
722 
723         Args:
724             data_type: The next content data type.
725             prev_data_type: The previous content data type.
726 
727         Returns:
728             Tuple containing:
729             - Stop block for previous content and the start block for the next content.
730             - Next content data type.
731         """
732         chunks = []
733         if data_type != prev_data_type:
734             if prev_data_type is not None:
735                 chunks.append(self.format_chunk({"chunk_type": "content_stop", "data_type": prev_data_type}))
736             chunks.append(self.format_chunk({"chunk_type": "content_start", "data_type": data_type}))
737 
738         return chunks, data_type
739 
740     @override
741     async def structured_output(
742         self, output_model: type[T], prompt: Messages, system_prompt: str | None = None, **kwargs: Any
743     ) -> AsyncGenerator[dict[str, T | Any], None]:
744         """Get structured output from the model.
745 
746         Args:
747             output_model: The output model to use for the agent.
748             prompt: The prompt messages to use for the agent.
749             system_prompt: System prompt to provide context to the model.
750             **kwargs: Additional keyword arguments for future extensibility.
751 
752         Yields:
753             Model events with the last being the structured output.
754 
755         Raises:
756             ContextWindowOverflowException: If the input exceeds the model's context window.
757             ModelThrottledException: If the request is throttled by OpenAI (rate limits).
758         """
759         # We initialize an OpenAI context on every request so as to avoid connection sharing in the underlying httpx
760         # client. The asyncio event loop does not allow connections to be shared. For more details, please refer to
761         # https://github.com/encode/httpx/discussions/2959.
762         async with self._get_client() as client:
763             try:
764                 response: ParsedChatCompletion = await client.beta.chat.completions.parse(
765                     model=self.get_config()["model_id"],
766                     messages=self.format_request(prompt, system_prompt=system_prompt)["messages"],
767                     response_format=output_model,
768                 )
769             except openai.BadRequestError as e:
770                 # Check if this is a context length exceeded error
771                 if hasattr(e, "code") and e.code == "context_length_exceeded":
772                     logger.warning("OpenAI threw context window overflow error")
773                     raise ContextWindowOverflowException(str(e)) from e
774                 # Re-raise other BadRequestError exceptions
775                 raise
776             except openai.RateLimitError as e:
777                 # All rate limit errors should be treated as throttling, not context overflow
778                 # Rate limits (including TPM) require waiting/retrying, not context reduction
779                 logger.warning("OpenAI threw rate limit error")
780                 raise ModelThrottledException(str(e)) from e
781             except openai.APIError as e:
782                 # Check for alternative context overflow error messages
783                 error_message = str(e)
784                 if any(overflow_msg in error_message for overflow_msg in _CONTEXT_OVERFLOW_MESSAGES):
785                     logger.warning("context window overflow error detected")
786                     raise ContextWindowOverflowException(error_message) from e
787                 # Re-raise other APIError exceptions
788                 raise
789 
790         parsed: T | None = None
791         # Find the first choice with tool_calls
792         if len(response.choices) > 1:
793             raise ValueError("Multiple choices found in the OpenAI response.")
794 
795         for choice in response.choices:
796             if isinstance(choice.message.parsed, output_model):
797                 parsed = choice.message.parsed
798                 break
799 
800         if parsed:
801             yield {"output": parsed}
802         else:
803             raise ValueError("No valid tool use or tool use input was found in the OpenAI response.")

