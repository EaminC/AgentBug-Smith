57     def __init__(
58         self,
59         *,
60         client: genai.Client | None = None,
61         client_args: dict[str, Any] | None = None,
62         **model_config: Unpack[GeminiConfig],
63     ) -> None:
64         """Initialize provider instance.
65 
66         Args:
67             client: Pre-configured Gemini client to reuse across requests.
68                 When provided, this client will be reused for all requests and will NOT be closed
69                 by the model. The caller is responsible for managing the client lifecycle.
70                 This is useful for:
71                 - Injecting custom client wrappers
72                 - Reusing connection pools within a single event loop/worker
73                 - Centralizing observability, retries, and networking policy
74                 Note: The client should not be shared across different asyncio event loops.
75             client_args: Arguments for the underlying Gemini client (e.g., api_key).
76                 For a complete list of supported arguments, see https://googleapis.github.io/python-genai/.
77             **model_config: Configuration options for the Gemini model.
78 
79         Raises:
80             ValueError: If both `client` and `client_args` are provided.
