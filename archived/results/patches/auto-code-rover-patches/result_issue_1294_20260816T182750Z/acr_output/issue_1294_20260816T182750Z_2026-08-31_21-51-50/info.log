307     def _format_request(
308         self,
309         messages: Messages,
310         tool_specs: list[ToolSpec] | None,
311         system_prompt: str | None,
312         params: dict[str, Any] | None,
313     ) -> dict[str, Any]:
314         """Format a Gemini streaming request.
315 
316         - Docs: https://ai.google.dev/api/generate-content#endpoint_1
317 
318         Args:
319             messages: List of message objects to be processed by the model.
320             tool_specs: List of tool specifications to make available to the model.
321             system_prompt: System prompt to provide context to the model.
322             params: Additional model parameters (e.g., temperature).
323 
324         Returns:
325             A Gemini streaming request.
326         """
327         return {
328             "config": self._format_request_config(tool_specs, system_prompt, params).to_json_dict(),
329             "contents": [content.to_json_dict() for content in self._format_request_content(messages)],
330             "model": self.config["model_id"],
331         }
