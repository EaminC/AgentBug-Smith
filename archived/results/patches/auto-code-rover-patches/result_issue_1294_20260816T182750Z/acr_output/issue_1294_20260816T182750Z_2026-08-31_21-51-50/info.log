537     ) -> AsyncGenerator[dict[str, T | Any], None]:
538         """Get structured output from the model using Gemini's native structured output.
539 
540         - Docs: https://ai.google.dev/gemini-api/docs/structured-output
541 
542         Args:
543             output_model: The output model to use for the agent.
544             prompt: The prompt messages to use for the agent.
545             system_prompt: System prompt to provide context to the model.
546             **kwargs: Additional keyword arguments for future extensibility.
547 
548         Yields:
549             Model events with the last being the structured output.
550         """
551         params = {
552             **(self.config.get("params") or {}),
553             "response_mime_type": "application/json",
554             "response_schema": output_model.model_json_schema(),
555         }
