199         storage: PlanStorageBase | None = None,
200     ) -> None:
201         """Initialize the plan notebook.
202 
203         Args:
204             max_subtasks (`int | None`, optional):
205                 The maximum number of subtasks in a plan.
206             plan_to_hint (`Callable[[Plan | None], str | None] | None`, \
207              optional):
208                 The function to generate the hint message based on the
209                 current plan. If not provided, a default `DefaultPlanToHint`
210                 object will be used.
211             storage (`PlanStorageBase | None`, optional):
212                 The plan storage. If not provided, an in-memory storage will
213                 be used.
214         """
215         super().__init__()
216 
217         self.max_tasks = max_subtasks
218         self.plan_to_hint = plan_to_hint or DefaultPlanToHint()
219         self.storage = storage or InMemoryPlanStorage()
220 
221         self.current_plan: Plan | None = None
222 
223         self._plan_change_hooks = OrderedDict()
224 
225         # Register the current_plan state for state management
226         self.register_state(
227             "current_plan",
228             custom_to_json=lambda _: _.model_dump() if _ else None,
229             custom_from_json=lambda _: Plan.model_validate(_) if _ else None,
230         )
