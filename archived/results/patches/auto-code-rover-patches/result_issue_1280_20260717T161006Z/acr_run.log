865     def register_plan_change_hook(
866         self,
867         hook_name: str,
868         hook: Callable[["PlanNotebook", Plan], None]
869         | Callable[["PlanNotebook", Plan], Awaitable[None]],
870     ) -> None:
871         """Register a plan hook that will be triggered when the plan is
872         changed.
873 
874         Args:
875             hook_name (`str`):
876                 The name of the hook, should be unique.
877             hook (`Callable[["PlanNotebook", Plan], None] | \
878             Callable[["PlanNotebook", Plan], Awaitable[None]]):
879                 The hook function, which takes the current plan as input and
880                 returns nothing.
881         """
882         self._plan_change_hooks[hook_name] = hook
883 
884     def remove_plan_change_hook(self, hook_name: str) -> None:
885         """Remove a plan change hook by given name.
886 
887         Args:
888             hook_name (`str`):
889                 The name of the hook to be removed.
890         """
891         if hook_name in self._plan_change_hooks:
892             self._plan_change_hooks.pop(hook_name)
893         else:
894             raise ValueError(f"Hook '{hook_name}' not found.")
895 
896     async def _trigger_plan_change_hooks(self) -> None:
897         """Trigger all the plan change hooks."""
898         for hook in self._plan_change_hooks.values():
899             await _execute_async_or_sync_func(
900                 hook,
901                 self,
902                 self.current_plan,
903             )

