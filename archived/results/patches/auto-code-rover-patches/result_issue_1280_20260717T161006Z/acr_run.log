844     async def get_current_hint(self) -> Msg | None:
845         """Get the hint message based on the current plan and subtasks states.
846         This function will call the `plan_to_hint` function to generate the
847         hint message.
848 
849         Returns:
850             `Msg | None`:
851                 The hint message wrapped by <system-hint></system-hint>, or
852                 None if there is no relevant hint.
853         """
854         hint_content = self.plan_to_hint(self.current_plan)
855         if hint_content:
856             msg = Msg(
857                 "user",
858                 hint_content,
859                 "user",
860             )
861             return msg
862 
863         return None
