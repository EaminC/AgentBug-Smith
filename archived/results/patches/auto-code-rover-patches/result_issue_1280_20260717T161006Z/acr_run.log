865     def register_plan_change_hook(
866         self,
867         hook_name: str,
868         hook: Callable[["PlanNotebook", Plan], None]
869         | Callable[["PlanNotebook", Plan], Awaitable[None]],
870     ) -> None:
871         """Register a plan hook that will be triggered when the plan is
872         changed.
873 
874         Args:
875             hook_name (`str`):
876                 The name of the hook, should be unique.
877             hook (`Callable[["PlanNotebook", Plan], None] | \
878             Callable[["PlanNotebook", Plan], Awaitable[None]]):
879                 The hook function, which takes the current plan as input and
880                 returns nothing.
