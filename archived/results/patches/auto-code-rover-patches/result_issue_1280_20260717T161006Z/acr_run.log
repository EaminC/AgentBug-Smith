820     def list_tools(
821         self,
822     ) -> list[Callable[..., Coroutine[Any, Any, ToolResponse]]]:
823         """List all tool functions provided to agent
824 
825         Returns:
826             `list[Callable[..., ToolResponse]]`:
827                 A list of all tool functions provided by the plan notebook to
828                 the agent.
829         """
830         return [
831             # subtask related tools
832             self.view_subtasks,
833             self.update_subtask_state,
834             self.finish_subtask,
835             # plan related tools
836             self.create_plan,
837             self.revise_current_plan,
838             self.finish_plan,
839             # historical plan related tools
840             self.view_historical_plans,
841             self.recover_historical_plan,
842         ]
