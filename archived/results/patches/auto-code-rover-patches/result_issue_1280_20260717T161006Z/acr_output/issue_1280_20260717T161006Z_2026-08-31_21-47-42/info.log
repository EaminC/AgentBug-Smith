653     async def view_subtasks(self, subtask_idx: list[int]) -> ToolResponse:
654         """View the details of the sub-tasks by given indexes.
655 
656         Args:
657             subtask_idx (`list[int]`):
658                 The indexes of the sub-tasks to be viewed, starting from 0.
659         """
660         self._validate_current_plan()
661 
662         gathered_strs = []
663         invalid_subtask_idx = []
664         for idx in subtask_idx:
665             if not 0 <= idx < len(self.current_plan.subtasks):
666                 invalid_subtask_idx.append(idx)
667                 continue
668 
669             subtask_markdown = self.current_plan.subtasks[idx].to_markdown(
670                 detailed=True,
671             )
672             gathered_strs.append(
673                 f"Subtask at index {idx}:\n"
674                 "```\n"
675                 f"{subtask_markdown}\n"
676                 "```\n",
677             )
678 
679         if invalid_subtask_idx:
680             gathered_strs.append(
681                 f"Invalid subtask_idx '{invalid_subtask_idx}'. Must be "
682                 f"between 0 and {len(self.current_plan.subtasks) - 1}.",
683             )
684 
685         return ToolResponse(
686             content=[
687                 TextBlock(
688                     type="text",
689                     text="\n".join(gathered_strs),
690                 ),
691             ],
692         )
