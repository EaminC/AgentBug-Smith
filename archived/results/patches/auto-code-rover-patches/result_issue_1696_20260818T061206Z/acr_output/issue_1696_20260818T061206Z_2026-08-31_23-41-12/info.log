69     def __init__(
70         self,
71         client: Client | None = None,
72         client_args: dict[str, Any] | None = None,
73         **model_config: Unpack[OpenAIConfig],
74     ) -> None:
75         """Initialize provider instance.
76 
77         Args:
78             client: Pre-configured OpenAI-compatible client to reuse across requests.
79                 When provided, this client will be reused for all requests and will NOT be closed
80                 by the model. The caller is responsible for managing the client lifecycle.
81                 This is useful for:
82                 - Injecting custom client wrappers (e.g., GuardrailsAsyncOpenAI)
83                 - Reusing connection pools within a single event loop/worker
84                 - Centralizing observability, retries, and networking policy
85                 - Pointing to custom model gateways
86                 Note: The client should not be shared across different asyncio event loops.
87             client_args: Arguments for the OpenAI client (legacy approach).
88                 For a complete list of supported arguments, see https://pypi.org/project/openai/.
89             **model_config: Configuration options for the OpenAI model.
90 
91         Raises:
92             ValueError: If both `client` and `client_args` are provided.
93         """
94         validate_config_keys(model_config, self.OpenAIConfig)
95         self.config = dict(model_config)
96 
97         # Validate that only one client configuration method is provided
98         if client is not None and client_args is not None and len(client_args) > 0:
99             raise ValueError("Only one of 'client' or 'client_args' should be provided, not both.")
100 
101         self._custom_client = client
102         self.client_args = client_args or {}
103 
104         logger.debug("config=<%s> | initializing", self.config)
