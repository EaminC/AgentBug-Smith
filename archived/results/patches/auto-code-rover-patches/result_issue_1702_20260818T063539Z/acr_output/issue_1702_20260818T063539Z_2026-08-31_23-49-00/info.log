456     def structured_output(self, output_model: type[T], prompt: AgentInput = None) -> T:
457         """This method allows you to get structured output from the agent.
458 
459         If you pass in a prompt, it will be used temporarily without adding it to the conversation history.
460         If you don't pass in a prompt, it will use only the existing conversation history to respond.
461 
462         For smaller models, you may want to use the optional prompt to add additional instructions to explicitly
463         instruct the model to output the structured data.
464 
465         Args:
466             output_model: The output model (a JSON schema written as a Pydantic BaseModel)
467                 that the agent will use when responding.
468             prompt: The prompt to use for the agent in various formats:
469                 - str: Simple text input
470                 - list[ContentBlock]: Multi-modal content blocks
471                 - list[Message]: Complete messages with roles
472                 - None: Use existing conversation history
473 
474         Raises:
475             ValueError: If no conversation history or prompt is provided.
476         """
477         warnings.warn(
478             "Agent.structured_output method is deprecated."
479             " You should pass in `structured_output_model` directly into the agent invocation."
480             " see: https://strandsagents.com/latest/documentation/docs/user-guide/concepts/agents/structured-output/",
481             category=DeprecationWarning,
482             stacklevel=2,
483         )
484 
485         return run_async(lambda: self.structured_output_async(output_model, prompt))
486 
487     async def structured_output_async(self, output_model: type[T], prompt: AgentInput = None) -> T:
488         """This method allows you to get structured output from the agent.
489 
490         If you pass in a prompt, it will be used temporarily without adding it to the conversation history.
491         If you don't pass in a prompt, it will use only the existing conversation history to respond.
492 
493         For smaller models, you may want to use the optional prompt to add additional instructions to explicitly
494         instruct the model to output the structured data.
495 
496         Args:
497             output_model: The output model (a JSON schema written as a Pydantic BaseModel)
498                 that the agent will use when responding.
499             prompt: The prompt to use for the agent (will not be added to conversation history).
500 
501         Raises:
502             ValueError: If no conversation history or prompt is provided.
503         -
504         """
505         if self._interrupt_state.activated:
506             raise RuntimeError("cannot call structured output during interrupt")
507 
508         warnings.warn(
509             "Agent.structured_output_async method is deprecated."
510             " You should pass in `structured_output_model` directly into the agent invocation."
511             " see: https://strandsagents.com/latest/documentation/docs/user-guide/concepts/agents/structured-output/",
512             category=DeprecationWarning,
513             stacklevel=2,
514         )
515         await self.hooks.invoke_callbacks_async(BeforeInvocationEvent(agent=self, invocation_state={}))
516         with self.tracer.tracer.start_as_current_span(
517             "execute_structured_output", kind=trace_api.SpanKind.CLIENT
518         ) as structured_output_span:
519             try:
520                 if not self.messages and not prompt:
521                     raise ValueError("No conversation history or prompt provided")
522 
523                 temp_messages: Messages = self.messages + await self._convert_prompt_to_messages(prompt)
524 
525                 structured_output_span.set_attributes(
526                     {
527                         "gen_ai.system": "strands-agents",
528                         "gen_ai.agent.name": self.name,
529                         "gen_ai.agent.id": self.agent_id,
530                         "gen_ai.operation.name": "execute_structured_output",
531                     }
532                 )
533                 if self.system_prompt:
534                     structured_output_span.add_event(
535                         "gen_ai.system.message",
536                         attributes={"role": "system", "content": serialize([{"text": self.system_prompt}])},
537                     )
538                 for message in temp_messages:
539                     structured_output_span.add_event(
540                         f"gen_ai.{message['role']}.message",
541                         attributes={"role": message["role"], "content": serialize(message["content"])},
542                     )
543                 events = self.model.structured_output(output_model, temp_messages, system_prompt=self.system_prompt)
544                 async for event in events:
545                     if isinstance(event, TypedEvent):
546                         event.prepare(invocation_state={})
547                         if event.is_callback_event:
548                             self.callback_handler(**event.as_dict())
549 
550                 structured_output_span.add_event(
551                     "gen_ai.choice", attributes={"message": serialize(event["output"].model_dump())}
552                 )
553                 return event["output"]
554 
555             finally:
556                 await self.hooks.invoke_callbacks_async(AfterInvocationEvent(agent=self, invocation_state={}))
557 
558     def cleanup(self) -> None:
559         """Clean up resources used by the agent.
560 
561         This method cleans up all tool providers that require explicit cleanup,
562         such as MCP clients. It should be called when the agent is no longer needed
563         to ensure proper resource cleanup.
564 
565         Note: This method uses a "belt and braces" approach with automatic cleanup
566         through finalizers as a fallback, but explicit cleanup is recommended.
567         """
568         self.tool_registry.cleanup()
569 
570     def __del__(self) -> None:
571         """Clean up resources when agent is garbage collected."""
572         # __del__ is called even when an exception is thrown in the constructor,
573         # so there is no guarantee tool_registry was set..
574         if hasattr(self, "tool_registry"):
575             self.tool_registry.cleanup()
