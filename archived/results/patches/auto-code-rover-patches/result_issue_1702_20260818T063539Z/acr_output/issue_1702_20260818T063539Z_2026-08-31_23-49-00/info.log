94 class Agent(AgentBase):
95     """Core Agent implementation.
96 
97     An agent orchestrates the following workflow:
98 
99     1. Receives user input
100     2. Processes the input using a language model
101     3. Decides whether to use tools to gather information or perform actions
102     4. Executes those tools and receives results
103     5. Continues reasoning with the new information
104     6. Produces a final response
105     """
106 
107     # For backwards compatibility
108     ToolCaller = _ToolCaller
109 
110     def __init__(
111         self,
112         model: Model | str | None = None,
113         messages: Messages | None = None,
114         tools: list[Union[str, dict[str, str], "ToolProvider", Any]] | None = None,
115         system_prompt: str | list[SystemContentBlock] | None = None,
116         structured_output_model: type[BaseModel] | None = None,
117         callback_handler: Callable[..., Any] | _DefaultCallbackHandlerSentinel | None = _DEFAULT_CALLBACK_HANDLER,
118         conversation_manager: ConversationManager | None = None,
119         record_direct_tool_call: bool = True,
120         load_tools_from_directory: bool = False,
121         trace_attributes: Mapping[str, AttributeValue] | None = None,
122         *,
123         agent_id: str | None = None,
124         name: str | None = None,
125         description: str | None = None,
126         state: AgentState | dict | None = None,
127         hooks: list[HookProvider] | None = None,
128         session_manager: SessionManager | None = None,
129         structured_output_prompt: str | None = None,
130         tool_executor: ToolExecutor | None = None,
131         retry_strategy: ModelRetryStrategy | _DefaultRetryStrategySentinel | None = _DEFAULT_RETRY_STRATEGY,
132     ):
133         """Initialize the Agent with the specified configuration.
134 
135         Args:
136             model: Provider for running inference or a string representing the model-id for Bedrock to use.
137                 Defaults to strands.models.BedrockModel if None.
138             messages: List of initial messages to pre-load into the conversation.
139                 Defaults to an empty list if None.
140             tools: List of tools to make available to the agent.
141                 Can be specified as:
142 
143                 - String tool names (e.g., "retrieve")
144                 - File paths (e.g., "/path/to/tool.py")
145                 - Imported Python modules (e.g., from strands_tools import current_time)
146                 - Dictionaries with name/path keys (e.g., {"name": "tool_name", "path": "/path/to/tool.py"})
147                 - ToolProvider instances for managed tool collections
148                 - Functions decorated with `@strands.tool` decorator.
149 
150                 If provided, only these tools will be available. If None, all tools will be available.
151             system_prompt: System prompt to guide model behavior.
152                 Can be a string or a list of SystemContentBlock objects for advanced features like caching.
153                 If None, the model will behave according to its default settings.
154             structured_output_model: Pydantic model type(s) for structured output.
155                 When specified, all agent calls will attempt to return structured output of this type.
156                 This can be overridden on the agent invocation.
157                 Defaults to None (no structured output).
158             callback_handler: Callback for processing events as they happen during agent execution.
159                 If not provided (using the default), a new PrintingCallbackHandler instance is created.
160                 If explicitly set to None, null_callback_handler is used.
161             conversation_manager: Manager for conversation history and context window.
162                 Defaults to strands.agent.conversation_manager.SlidingWindowConversationManager if None.
163             record_direct_tool_call: Whether to record direct tool calls in message history.
164                 Defaults to True.
165             load_tools_from_directory: Whether to load and automatically reload tools in the `./tools/` directory.
166                 Defaults to False.
167             trace_attributes: Custom trace attributes to apply to the agent's trace span.
168             agent_id: Optional ID for the agent, useful for session management and multi-agent scenarios.
169                 Defaults to "default".
170             name: name of the Agent
171                 Defaults to "Strands Agents".
172             description: description of what the Agent does
173                 Defaults to None.
174             state: stateful information for the agent. Can be either an AgentState object, or a json serializable dict.
175                 Defaults to an empty AgentState object.
176             hooks: hooks to be added to the agent hook registry
177                 Defaults to None.
178             session_manager: Manager for handling agent sessions including conversation history and state.
179                 If provided, enables session-based persistence and state management.
180             structured_output_prompt: Custom prompt message used when forcing structured output.
181                 When using structured output, if the model doesn't automatically use the output tool,
182                 the agent sends a follow-up message to request structured formatting. This parameter
183                 allows customizing that message.
184                 Defaults to "You must format the previous response as structured output."
185             tool_executor: Definition of tool execution strategy (e.g., sequential, concurrent, etc.).
186             retry_strategy: Strategy for retrying model calls on throttling or other transient errors.
187                 Defaults to ModelRetryStrategy with max_attempts=6, initial_delay=4s, max_delay=240s.
188                 Implement a custom HookProvider for custom retry logic, or pass None to disable retries.
189 
190         Raises:
191             ValueError: If agent id contains path separators.
192         """
193         self.model = BedrockModel() if not model else BedrockModel(model_id=model) if isinstance(model, str) else model
194         self.messages = messages if messages is not None else []
195         # initializing self._system_prompt for backwards compatibility
196         self._system_prompt, self._system_prompt_content = self._initialize_system_prompt(system_prompt)
197         self._default_structured_output_model = structured_output_model
198         self._structured_output_prompt = structured_output_prompt
199         self.agent_id = _identifier.validate(agent_id or _DEFAULT_AGENT_ID, _identifier.Identifier.AGENT)
200         self.name = name or _DEFAULT_AGENT_NAME
201         self.description = description
202 
203         # If not provided, create a new PrintingCallbackHandler instance
204         # If explicitly set to None, use null_callback_handler
205         # Otherwise use the passed callback_handler
206         self.callback_handler: Callable[..., Any] | PrintingCallbackHandler
207         if isinstance(callback_handler, _DefaultCallbackHandlerSentinel):
208             self.callback_handler = PrintingCallbackHandler()
209         elif callback_handler is None:
210             self.callback_handler = null_callback_handler
211         else:
212             self.callback_handler = callback_handler
213 
214         self.conversation_manager = conversation_manager if conversation_manager else SlidingWindowConversationManager()
215 
216         # Process trace attributes to ensure they're of compatible types
217         self.trace_attributes: dict[str, AttributeValue] = {}
218         if trace_attributes:
219             for k, v in trace_attributes.items():
220                 if isinstance(v, (str, int, float, bool)) or (
221                     isinstance(v, list) and all(isinstance(x, (str, int, float, bool)) for x in v)
222                 ):
223                     self.trace_attributes[k] = v
224 
225         self.record_direct_tool_call = record_direct_tool_call
226         self.load_tools_from_directory = load_tools_from_directory
227 
228         self.tool_registry = ToolRegistry()
229 
230         # Process tool list if provided
231         if tools is not None:
232             self.tool_registry.process_tools(tools)
233 
234         # Initialize tools and configuration
235         self.tool_registry.initialize_tools(self.load_tools_from_directory)
236         if load_tools_from_directory:
237             self.tool_watcher = ToolWatcher(tool_registry=self.tool_registry)
238 
239         self.event_loop_metrics = EventLoopMetrics()
240 
241         # Initialize tracer instance (no-op if not configured)
242         self.tracer = get_tracer()
243         self.trace_span: trace_api.Span | None = None
244 
245         # Initialize agent state management
246         if state is not None:
247             if isinstance(state, dict):
248                 self.state = AgentState(state)
249             elif isinstance(state, AgentState):
250                 self.state = state
251             else:
252                 raise ValueError("state must be an AgentState object or a dict")
253         else:
254             self.state = AgentState()
255 
256         self.tool_caller = _ToolCaller(self)
257 
258         self.hooks = HookRegistry()
259 
260         self._interrupt_state = _InterruptState()
261 
262         # Initialize lock for guarding concurrent invocations
263         # Using threading.Lock instead of asyncio.Lock because run_async() creates
264         # separate event loops in different threads, so asyncio.Lock wouldn't work
265         self._invocation_lock = threading.Lock()
266 
267         # In the future, we'll have a RetryStrategy base class but until
268         # that API is determined we only allow ModelRetryStrategy
269         if (
270             retry_strategy is not None
271             and not isinstance(retry_strategy, _DefaultRetryStrategySentinel)
272             and type(retry_strategy) is not ModelRetryStrategy
273         ):
274             raise ValueError("retry_strategy must be an instance of ModelRetryStrategy")
275 
276         # If not provided (using the default), create a new ModelRetryStrategy instance
277         # If explicitly set to None, disable retries (max_attempts=1 means no retries)
278         # Otherwise use the passed retry_strategy
279         if isinstance(retry_strategy, _DefaultRetryStrategySentinel):
280             self._retry_strategy = ModelRetryStrategy(
281                 max_attempts=MAX_ATTEMPTS, max_delay=MAX_DELAY, initial_delay=INITIAL_DELAY
282             )
283         elif retry_strategy is None:
284             # If no retry strategy is passed in, then we turn retries off
285             self._retry_strategy = ModelRetryStrategy(max_attempts=1)
286         else:
287             self._retry_strategy = retry_strategy
288 
289         # Initialize session management functionality
290         self._session_manager = session_manager
291         if self._session_manager:
292             self.hooks.add_hook(self._session_manager)
293 
294         # Allow conversation_managers to subscribe to hooks
295         self.hooks.add_hook(self.conversation_manager)
296 
297         # Register retry strategy as a hook
298         self.hooks.add_hook(self._retry_strategy)
299 
300         self.tool_executor = tool_executor or ConcurrentToolExecutor()
301 
302         if hooks:
303             for hook in hooks:
304                 self.hooks.add_hook(hook)
305         self.hooks.invoke_callbacks(AgentInitializedEvent(agent=self))
306 
307     @property
308     def system_prompt(self) -> str | None:
309         """Get the system prompt as a string for backwards compatibility.
310 
311         Returns the system prompt as a concatenated string when it contains text content,
312         or None if no text content is present. This maintains backwards compatibility
313         with existing code that expects system_prompt to be a string.
314 
315         Returns:
316             The system prompt as a string, or None if no text content exists.
317         """
318         return self._system_prompt
319 
320     @system_prompt.setter
321     def system_prompt(self, value: str | list[SystemContentBlock] | None) -> None:
322         """Set the system prompt and update internal content representation.
323 
324         Accepts either a string or list of SystemContentBlock objects.
325         When set, both the backwards-compatible string representation and the internal
326         content block representation are updated to maintain consistency.
327 
328         Args:
329             value: System prompt as string, list of SystemContentBlock objects, or None.
330                   - str: Simple text prompt (most common use case)
331                   - list[SystemContentBlock]: Content blocks with features like caching
332                   - None: Clear the system prompt
333         """
334         self._system_prompt, self._system_prompt_content = self._initialize_system_prompt(value)
335 
336     @property
337     def tool(self) -> _ToolCaller:
338         """Call tool as a function.
339 
340         Returns:
341             Tool caller through which user can invoke tool as a function.
342 
343         Example:
344             ```
345             agent = Agent(tools=[calculator])
346             agent.tool.calculator(...)
347             ```
348         """
349         return self.tool_caller
350 
351     @property
352     def tool_names(self) -> list[str]:
353         """Get a list of all registered tool names.
354 
355         Returns:
356             Names of all tools available to this agent.
357         """
358         all_tools = self.tool_registry.get_all_tools_config()
359         return list(all_tools.keys())
360 
361     def __call__(
362         self,
363         prompt: AgentInput = None,
364         *,
365         invocation_state: dict[str, Any] | None = None,
366         structured_output_model: type[BaseModel] | None = None,
367         structured_output_prompt: str | None = None,
368         **kwargs: Any,
369     ) -> AgentResult:
370         """Process a natural language prompt through the agent's event loop.
371 
372         This method implements the conversational interface with multiple input patterns:
373         - String input: `agent("hello!")`
374         - ContentBlock list: `agent([{"text": "hello"}, {"image": {...}}])`
375         - Message list: `agent([{"role": "user", "content": [{"text": "hello"}]}])`
376         - No input: `agent()` - uses existing conversation history
377 
378         Args:
379             prompt: User input in various formats:
380                 - str: Simple text input
381                 - list[ContentBlock]: Multi-modal content blocks
382                 - list[Message]: Complete messages with roles
383                 - None: Use existing conversation history
384             invocation_state: Additional parameters to pass through the event loop.
385             structured_output_model: Pydantic model type(s) for structured output (overrides agent default).
386             structured_output_prompt: Custom prompt for forcing structured output (overrides agent default).
387             **kwargs: Additional parameters to pass through the event loop.[Deprecating]
388 
389         Returns:
390             Result object containing:
391 
392                 - stop_reason: Why the event loop stopped (e.g., "end_turn", "max_tokens")
393                 - message: The final message from the model
394                 - metrics: Performance metrics from the event loop
395                 - state: The final state of the event loop
396                 - structured_output: Parsed structured output when structured_output_model was specified
397         """
398         return run_async(
399             lambda: self.invoke_async(
400                 prompt,
401                 invocation_state=invocation_state,
402                 structured_output_model=structured_output_model,
403                 structured_output_prompt=structured_output_prompt,
404                 **kwargs,
405             )
406         )
407 
408     async def invoke_async(
409         self,
410         prompt: AgentInput = None,
411         *,
412         invocation_state: dict[str, Any] | None = None,
413         structured_output_model: type[BaseModel] | None = None,
414         structured_output_prompt: str | None = None,
415         **kwargs: Any,
416     ) -> AgentResult:
417         """Process a natural language prompt through the agent's event loop.
418 
419         This method implements the conversational interface with multiple input patterns:
420         - String input: Simple text input
421         - ContentBlock list: Multi-modal content blocks
422         - Message list: Complete messages with roles
423         - No input: Use existing conversation history
424 
425         Args:
426             prompt: User input in various formats:
427                 - str: Simple text input
428                 - list[ContentBlock]: Multi-modal content blocks
429                 - list[Message]: Complete messages with roles
430                 - None: Use existing conversation history
431             invocation_state: Additional parameters to pass through the event loop.
432             structured_output_model: Pydantic model type(s) for structured output (overrides agent default).
433             structured_output_prompt: Custom prompt for forcing structured output (overrides agent default).
434             **kwargs: Additional parameters to pass through the event loop.[Deprecating]
435 
436         Returns:
437             Result: object containing:
438 
439                 - stop_reason: Why the event loop stopped (e.g., "end_turn", "max_tokens")
440                 - message: The final message from the model
441                 - metrics: Performance metrics from the event loop
442                 - state: The final state of the event loop
443         """
444         events = self.stream_async(
445             prompt,
446             invocation_state=invocation_state,
447             structured_output_model=structured_output_model,
448             structured_output_prompt=structured_output_prompt,
449             **kwargs,
450         )
451         async for event in events:
452             _ = event
453 
454         return cast(AgentResult, event["result"])
455 
456     def structured_output(self, output_model: type[T], prompt: AgentInput = None) -> T:
457         """This method allows you to get structured output from the agent.
458 
459         If you pass in a prompt, it will be used temporarily without adding it to the conversation history.
460         If you don't pass in a prompt, it will use only the existing conversation history to respond.
461 
462         For smaller models, you may want to use the optional prompt to add additional instructions to explicitly
463         instruct the model to output the structured data.
464 
465         Args:
466             output_model: The output model (a JSON schema written as a Pydantic BaseModel)
467                 that the agent will use when responding.
468             prompt: The prompt to use for the agent in various formats:
469                 - str: Simple text input
470                 - list[ContentBlock]: Multi-modal content blocks
471                 - list[Message]: Complete messages with roles
472                 - None: Use existing conversation history
473 
474         Raises:
475             ValueError: If no conversation history or prompt is provided.
476         """
477         warnings.warn(
478             "Agent.structured_output method is deprecated."
479             " You should pass in `structured_output_model` directly into the agent invocation."
480             " see: https://strandsagents.com/latest/documentation/docs/user-guide/concepts/agents/structured-output/",
481             category=DeprecationWarning,
482             stacklevel=2,
483         )
484 
485         return run_async(lambda: self.structured_output_async(output_model, prompt))
486 
487     async def structured_output_async(self, output_model: type[T], prompt: AgentInput = None) -> T:
488         """This method allows you to get structured output from the agent.
489 
490         If you pass in a prompt, it will be used temporarily without adding it to the conversation history.
491         If you don't pass in a prompt, it will use only the existing conversation history to respond.
492 
493         For smaller models, you may want to use the optional prompt to add additional instructions to explicitly
494         instruct the model to output the structured data.
495 
496         Args:
497             output_model: The output model (a JSON schema written as a Pydantic BaseModel)
498                 that the agent will use when responding.
499             prompt: The prompt to use for the agent (will not be added to conversation history).
500 
501         Raises:
502             ValueError: If no conversation history or prompt is provided.
503         -
504         """
505         if self._interrupt_state.activated:
506             raise RuntimeError("cannot call structured output during interrupt")
507 
508         warnings.warn(
509             "Agent.structured_output_async method is deprecated."
510             " You should pass in `structured_output_model` directly into the agent invocation."
511             " see: https://strandsagents.com/latest/documentation/docs/user-guide/concepts/agents/structured-output/",
512             category=DeprecationWarning,
513             stacklevel=2,
514         )
515         await self.hooks.invoke_callbacks_async(BeforeInvocationEvent(agent=self, invocation_state={}))
516         with self.tracer.tracer.start_as_current_span(
517             "execute_structured_output", kind=trace_api.SpanKind.CLIENT
518         ) as structured_output_span:
519             try:
520                 if not self.messages and not prompt:
521                     raise ValueError("No conversation history or prompt provided")
522 
523                 temp_messages: Messages = self.messages + await self._convert_prompt_to_messages(prompt)
524 
525                 structured_output_span.set_attributes(
526                     {
527                         "gen_ai.system": "strands-agents",
528                         "gen_ai.agent.name": self.name,
529                         "gen_ai.agent.id": self.agent_id,
530                         "gen_ai.operation.name": "execute_structured_output",
531                     }
532                 )
533                 if self.system_prompt:
534                     structured_output_span.add_event(
535                         "gen_ai.system.message",
536                         attributes={"role": "system", "content": serialize([{"text": self.system_prompt}])},
537                     )
538                 for message in temp_messages:
539                     structured_output_span.add_event(
540                         f"gen_ai.{message['role']}.message",
541                         attributes={"role": message["role"], "content": serialize(message["content"])},
542                     )
543                 events = self.model.structured_output(output_model, temp_messages, system_prompt=self.system_prompt)
544                 async for event in events:
545                     if isinstance(event, TypedEvent):
546                         event.prepare(invocation_state={})
547                         if event.is_callback_event:
548                             self.callback_handler(**event.as_dict())
549 
550                 structured_output_span.add_event(
551                     "gen_ai.choice", attributes={"message": serialize(event["output"].model_dump())}
552                 )
553                 return event["output"]
554 
555             finally:
556                 await self.hooks.invoke_callbacks_async(AfterInvocationEvent(agent=self, invocation_state={}))
557 
558     def cleanup(self) -> None:
559         """Clean up resources used by the agent.
560 
561         This method cleans up all tool providers that require explicit cleanup,
562         such as MCP clients. It should be called when the agent is no longer needed
563         to ensure proper resource cleanup.
564 
565         Note: This method uses a "belt and braces" approach with automatic cleanup
566         through finalizers as a fallback, but explicit cleanup is recommended.
567         """
568         self.tool_registry.cleanup()
569 
570     def __del__(self) -> None:
571         """Clean up resources when agent is garbage collected."""
572         # __del__ is called even when an exception is thrown in the constructor,
573         # so there is no guarantee tool_registry was set..
574         if hasattr(self, "tool_registry"):
575             self.tool_registry.cleanup()
576 
577     async def stream_async(
578         self,
579         prompt: AgentInput = None,
580         *,
581         invocation_state: dict[str, Any] | None = None,
582         structured_output_model: type[BaseModel] | None = None,
583         structured_output_prompt: str | None = None,
584         **kwargs: Any,
585     ) -> AsyncIterator[Any]:
586         """Process a natural language prompt and yield events as an async iterator.
587 
588         This method provides an asynchronous interface for streaming agent events with multiple input patterns:
589         - String input: Simple text input
590         - ContentBlock list: Multi-modal content blocks
591         - Message list: Complete messages with roles
592         - No input: Use existing conversation history
593 
594         Args:
595             prompt: User input in various formats:
596                 - str: Simple text input
597                 - list[ContentBlock]: Multi-modal content blocks
598                 - list[Message]: Complete messages with roles
599                 - None: Use existing conversation history
600             invocation_state: Additional parameters to pass through the event loop.
601             structured_output_model: Pydantic model type(s) for structured output (overrides agent default).
602             structured_output_prompt: Custom prompt for forcing structured output (overrides agent default).
603             **kwargs: Additional parameters to pass to the event loop.[Deprecating]
604 
605         Yields:
606             An async iterator that yields events. Each event is a dictionary containing
607                 information about the current state of processing, such as:
608 
609                 - data: Text content being generated
610                 - complete: Whether this is the final chunk
611                 - current_tool_use: Information about tools being executed
612                 - And other event data provided by the callback handler
613 
614         Raises:
615             ConcurrencyException: If another invocation is already in progress on this agent instance.
616             Exception: Any exceptions from the agent invocation will be propagated to the caller.
617 
618         Example:
619             ```python
620             async for event in agent.stream_async("Analyze this data"):
621                 if "data" in event:
622                     yield event["data"]
623             ```
624         """
625         # Acquire lock to prevent concurrent invocations
626         # Using threading.Lock instead of asyncio.Lock because run_async() creates
627         # separate event loops in different threads
628         acquired = self._invocation_lock.acquire(blocking=False)
629         if not acquired:
630             raise ConcurrencyException(
631                 "Agent is already processing a request. Concurrent invocations are not supported."
632             )
633 
634         try:
635             self._interrupt_state.resume(prompt)
636 
637             self.event_loop_metrics.reset_usage_metrics()
638 
639             merged_state = {}
640             if kwargs:
641                 warnings.warn("`**kwargs` parameter is deprecating, use `invocation_state` instead.", stacklevel=2)
642                 merged_state.update(kwargs)
643                 if invocation_state is not None:
644                     merged_state["invocation_state"] = invocation_state
645             else:
646                 if invocation_state is not None:
647                     merged_state = invocation_state
648 
649             callback_handler = self.callback_handler
650             if kwargs:
651                 callback_handler = kwargs.get("callback_handler", self.callback_handler)
652 
653             # Process input and get message to add (if any)
654             messages = await self._convert_prompt_to_messages(prompt)
655 
656             self.trace_span = self._start_agent_trace_span(messages)
657 
658             with trace_api.use_span(self.trace_span):
659                 try:
660                     events = self._run_loop(messages, merged_state, structured_output_model, structured_output_prompt)
661 
662                     async for event in events:
663                         event.prepare(invocation_state=merged_state)
664 
665                         if event.is_callback_event:
666                             as_dict = event.as_dict()
667                             callback_handler(**as_dict)
668                             yield as_dict
669 
670                     result = AgentResult(*event["stop"])
671                     callback_handler(result=result)
672                     yield AgentResultEvent(result=result).as_dict()
673 
674                     self._end_agent_trace_span(response=result)
675 
676                 except Exception as e:
677                     self._end_agent_trace_span(error=e)
678                     raise
679 
680         finally:
681             self._invocation_lock.release()
682 
683     async def _run_loop(
684         self,
685         messages: Messages,
686         invocation_state: dict[str, Any],
687         structured_output_model: type[BaseModel] | None = None,
688         structured_output_prompt: str | None = None,
689     ) -> AsyncGenerator[TypedEvent, None]:
690         """Execute the agent's event loop with the given message and parameters.
691 
692         Args:
693             messages: The input messages to add to the conversation.
694             invocation_state: Additional parameters to pass to the event loop.
695             structured_output_model: Optional Pydantic model type for structured output.
696             structured_output_prompt: Optional custom prompt for forcing structured output.
697 
698         Yields:
699             Events from the event loop cycle.
700         """
701         before_invocation_event, _interrupts = await self.hooks.invoke_callbacks_async(
702             BeforeInvocationEvent(agent=self, invocation_state=invocation_state, messages=messages)
703         )
704         messages = before_invocation_event.messages if before_invocation_event.messages is not None else messages
705 
706         agent_result: AgentResult | None = None
707         try:
708             yield InitEventLoopEvent()
709 
710             await self._append_messages(*messages)
711 
712             structured_output_context = StructuredOutputContext(
713                 structured_output_model or self._default_structured_output_model,
714                 structured_output_prompt=structured_output_prompt or self._structured_output_prompt,
715             )
716 
717             # Execute the event loop cycle with retry logic for context limits
718             events = self._execute_event_loop_cycle(invocation_state, structured_output_context)
719             async for event in events:
720                 # Signal from the model provider that the message sent by the user should be redacted,
721                 # likely due to a guardrail.
722                 if (
723                     isinstance(event, ModelStreamChunkEvent)
724                     and event.chunk
725                     and event.chunk.get("redactContent")
726                     and event.chunk["redactContent"].get("redactUserContentMessage")
727                 ):
728                     self.messages[-1]["content"] = self._redact_user_content(
729                         self.messages[-1]["content"], str(event.chunk["redactContent"]["redactUserContentMessage"])
730                     )
731                     if self._session_manager:
732                         self._session_manager.redact_latest_message(self.messages[-1], self)
733                 yield event
734 
735             # Capture the result from the final event if available
736             if isinstance(event, EventLoopStopEvent):
737                 agent_result = AgentResult(*event["stop"])
738 
739         finally:
740             self.conversation_manager.apply_management(self)
741             await self.hooks.invoke_callbacks_async(
742                 AfterInvocationEvent(agent=self, invocation_state=invocation_state, result=agent_result)
743             )
744 
745     async def _execute_event_loop_cycle(
746         self, invocation_state: dict[str, Any], structured_output_context: StructuredOutputContext | None = None
747     ) -> AsyncGenerator[TypedEvent, None]:
748         """Execute the event loop cycle with retry logic for context window limits.
749 
750         This internal method handles the execution of the event loop cycle and implements
751         retry logic for handling context window overflow exceptions by reducing the
752         conversation context and retrying.
753 
754         Args:
755             invocation_state: Additional parameters to pass to the event loop.
756             structured_output_context: Optional structured output context for this invocation.
757 
758         Yields:
759             Events of the loop cycle.
760         """
761         # Add `Agent` to invocation_state to keep backwards-compatibility
762         invocation_state["agent"] = self
763 
764         if structured_output_context:
765             structured_output_context.register_tool(self.tool_registry)
766 
767         try:
768             events = event_loop_cycle(
769                 agent=self,
770                 invocation_state=invocation_state,
771                 structured_output_context=structured_output_context,
772             )
773             async for event in events:
774                 yield event
775 
776         except ContextWindowOverflowException as e:
777             # Try reducing the context size and retrying
778             self.conversation_manager.reduce_context(self, e=e)
779 
780             # Sync agent after reduce_context to keep conversation_manager_state up to date in the session
781             if self._session_manager:
782                 self._session_manager.sync_agent(self)
783 
784             events = self._execute_event_loop_cycle(invocation_state, structured_output_context)
785             async for event in events:
786                 yield event
787 
788         finally:
789             if structured_output_context:
790                 structured_output_context.cleanup(self.tool_registry)
791 
792     async def _convert_prompt_to_messages(self, prompt: AgentInput) -> Messages:
793         if self._interrupt_state.activated:
794             return []
795 
796         messages: Messages | None = None
797         if prompt is not None:
798             # Check if the latest message is toolUse
799             if len(self.messages) > 0 and any("toolUse" in content for content in self.messages[-1]["content"]):
800                 # Add toolResult message after to have a valid conversation
801                 logger.info(
802                     "Agents latest message is toolUse, appending a toolResult message to have valid conversation."
803                 )
804                 tool_use_ids = [
805                     content["toolUse"]["toolUseId"] for content in self.messages[-1]["content"] if "toolUse" in content
806                 ]
807                 await self._append_messages(
808                     {
809                         "role": "user",
810                         "content": generate_missing_tool_result_content(tool_use_ids),
811                     }
812                 )
813             if isinstance(prompt, str):
814                 # String input - convert to user message
815                 messages = [{"role": "user", "content": [{"text": prompt}]}]
816             elif isinstance(prompt, list):
817                 if len(prompt) == 0:
818                     # Empty list
819                     messages = []
820                 # Check if all item in input list are dictionaries
821                 elif all(isinstance(item, dict) for item in prompt):
822                     # Check if all items are messages
823                     if all(all(key in item for key in Message.__annotations__.keys()) for item in prompt):
824                         # Messages input - add all messages to conversation
825                         messages = cast(Messages, prompt)
826 
827                     # Check if all items are content blocks
828                     elif all(any(key in ContentBlock.__annotations__.keys() for key in item) for item in prompt):
829                         # Treat as List[ContentBlock] input - convert to user message
830                         # This allows invalid structures to be passed through to the model
831                         messages = [{"role": "user", "content": cast(list[ContentBlock], prompt)}]
832         else:
833             messages = []
834         if messages is None:
835             raise ValueError("Input prompt must be of type: `str | list[Contentblock] | Messages | None`.")
836         return messages
837 
838     def _start_agent_trace_span(self, messages: Messages) -> trace_api.Span:
839         """Starts a trace span for the agent.
840 
841         Args:
842             messages: The input messages.
843         """
844         model_id = self.model.config.get("model_id") if hasattr(self.model, "config") else None
845         return self.tracer.start_agent_span(
846             messages=messages,
847             agent_name=self.name,
848             model_id=model_id,
849             tools=self.tool_names,
850             system_prompt=self.system_prompt,
851             custom_trace_attributes=self.trace_attributes,
852             tools_config=self.tool_registry.get_all_tools_config(),
853         )
854 
855     def _end_agent_trace_span(
856         self,
857         response: AgentResult | None = None,
858         error: Exception | None = None,
859     ) -> None:
860         """Ends a trace span for the agent.
861 
862         Args:
863             span: The span to end.
864             response: Response to record as a trace attribute.
865             error: Error to record as a trace attribute.
866         """
867         if self.trace_span:
868             trace_attributes: dict[str, Any] = {
869                 "span": self.trace_span,
870             }
871 
872             if response:
873                 trace_attributes["response"] = response
874             if error:
875                 trace_attributes["error"] = error
876 
877             self.tracer.end_agent_span(**trace_attributes)
878 
879     def _initialize_system_prompt(
880         self, system_prompt: str | list[SystemContentBlock] | None
881     ) -> tuple[str | None, list[SystemContentBlock] | None]:
882         """Initialize system prompt fields from constructor input.
883 
884         Maintains backwards compatibility by keeping system_prompt as str when string input
885         provided, avoiding breaking existing consumers.
886 
887         Maps system_prompt input to both string and content block representations:
888         - If string: system_prompt=string, _system_prompt_content=[{text: string}]
889         - If list with text elements: system_prompt=concatenated_text, _system_prompt_content=list
890         - If list without text elements: system_prompt=None, _system_prompt_content=list
891         - If None: system_prompt=None, _system_prompt_content=None
892         """
893         if isinstance(system_prompt, str):
894             return system_prompt, [{"text": system_prompt}]
895         elif isinstance(system_prompt, list):
896             # Concatenate all text elements for backwards compatibility, None if no text found
897             text_parts = [block["text"] for block in system_prompt if "text" in block]
898             system_prompt_str = "\n".join(text_parts) if text_parts else None
899             return system_prompt_str, system_prompt
900         else:
901             return None, None
902 
903     async def _append_messages(self, *messages: Message) -> None:
904         """Appends messages to history and invoke the callbacks for the MessageAddedEvent."""
905         for message in messages:
906             self.messages.append(message)
907             await self.hooks.invoke_callbacks_async(MessageAddedEvent(agent=self, message=message))
908 
909     def _redact_user_content(self, content: list[ContentBlock], redact_message: str) -> list[ContentBlock]:
910         """Redact user content preserving toolResult blocks.
911 
912         Args:
913             content: content blocks to be redacted
914             redact_message: redact message to be replaced
915 
916         Returns:
917             Redacted content, as follows:
918             - if the message contains at least a toolResult block,
919                 all toolResult blocks(s) are kept, redacting only the result content;
920             - otherwise, the entire content of the message is replaced
921                 with a single text block with the redact message.
922         """
923         redacted_content = []
924         for block in content:
925             if "toolResult" in block:
926                 block["toolResult"]["content"] = [{"text": redact_message}]
927                 redacted_content.append(block)
928 
929         if not redacted_content:
930             # Text content is added only if no toolResult blocks were found
931             redacted_content = [{"text": redact_message}]
932 
933         return redacted_content

