431     async def structured_output_async(self, output_model: Type[T], prompt: AgentInput = None) -> T:
432         """This method allows you to get structured output from the agent.
433 
434         If you pass in a prompt, it will be used temporarily without adding it to the conversation history.
435         If you don't pass in a prompt, it will use only the existing conversation history to respond.
436 
437         For smaller models, you may want to use the optional prompt to add additional instructions to explicitly
438         instruct the model to output the structured data.
439 
440         Args:
441             output_model: The output model (a JSON schema written as a Pydantic BaseModel)
442                 that the agent will use when responding.
443             prompt: The prompt to use for the agent (will not be added to conversation history).
444 
445         Raises:
446             ValueError: If no conversation history or prompt is provided.
447         -
448         """
449         if self._interrupt_state.activated:
450             raise RuntimeError("cannot call structured output during interrupt")
451 
452         warnings.warn(
453             "Agent.structured_output_async method is deprecated."
454             " You should pass in `structured_output_model` directly into the agent invocation."
455             " see: https://strandsagents.com/latest/documentation/docs/user-guide/concepts/agents/structured-output/",
456             category=DeprecationWarning,
457             stacklevel=2,
458         )
459         await self.hooks.invoke_callbacks_async(BeforeInvocationEvent(agent=self))
460         with self.tracer.tracer.start_as_current_span(
461             "execute_structured_output", kind=trace_api.SpanKind.CLIENT
462         ) as structured_output_span:
463             try:
464                 if not self.messages and not prompt:
465                     raise ValueError("No conversation history or prompt provided")
466 
467                 temp_messages: Messages = self.messages + await self._convert_prompt_to_messages(prompt)
468 
469                 structured_output_span.set_attributes(
470                     {
471                         "gen_ai.system": "strands-agents",
472                         "gen_ai.agent.name": self.name,
473                         "gen_ai.agent.id": self.agent_id,
474                         "gen_ai.operation.name": "execute_structured_output",
475                     }
476                 )
477                 if self.system_prompt:
478                     structured_output_span.add_event(
479                         "gen_ai.system.message",
480                         attributes={"role": "system", "content": serialize([{"text": self.system_prompt}])},
481                     )
482                 for message in temp_messages:
483                     structured_output_span.add_event(
484                         f"gen_ai.{message['role']}.message",
485                         attributes={"role": message["role"], "content": serialize(message["content"])},
486                     )
487                 events = self.model.structured_output(output_model, temp_messages, system_prompt=self.system_prompt)
488                 async for event in events:
489                     if isinstance(event, TypedEvent):
490                         event.prepare(invocation_state={})
491                         if event.is_callback_event:
492                             self.callback_handler(**event.as_dict())
493 
494                 structured_output_span.add_event(
495                     "gen_ai.choice", attributes={"message": serialize(event["output"].model_dump())}
496                 )
497                 return event["output"]
498 
499             finally:
500                 await self.hooks.invoke_callbacks_async(AfterInvocationEvent(agent=self))
501 
502     def cleanup(self) -> None:
503         """Clean up resources used by the agent.
504 
505         This method cleans up all tool providers that require explicit cleanup,
506         such as MCP clients. It should be called when the agent is no longer needed
507         to ensure proper resource cleanup.
508 
509         Note: This method uses a "belt and braces" approach with automatic cleanup
510         through finalizers as a fallback, but explicit cleanup is recommended.
511         """
