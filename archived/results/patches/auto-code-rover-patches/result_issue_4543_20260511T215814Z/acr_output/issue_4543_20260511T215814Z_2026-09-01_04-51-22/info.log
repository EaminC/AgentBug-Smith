1128 def sanity_check_model(io, model):
1129     show = False
1130 
1131     if model.missing_keys:
1132         show = True
1133         io.tool_warning(f"Warning: {model} expects these environment variables")
1134         for key in model.missing_keys:
1135             value = os.environ.get(key, "")
1136             status = "Set" if value else "Not set"
1137             io.tool_output(f"- {key}: {status}")
1138 
1139         if platform.system() == "Windows":
1140             io.tool_output(
1141                 "Note: You may need to restart your terminal or command prompt for `setx` to take"
1142                 " effect."
1143             )
1144 
1145     elif not model.keys_in_environment:
1146         show = True
1147         io.tool_warning(f"Warning for {model}: Unknown which environment variables are required.")
1148 
1149     # Check for model-specific dependencies
1150     check_for_dependencies(io, model.name)
1151 
1152     if not model.info:
1153         show = True
1154         io.tool_warning(
1155             f"Warning for {model}: Unknown context window size and costs, using sane defaults."
1156         )
1157 
1158         possible_matches = fuzzy_match_models(model.name)
1159         if possible_matches:
1160             io.tool_output("Did you mean one of these?")
1161             for match in possible_matches:
1162                 io.tool_output(f"- {match}")
1163 
1164     return show
