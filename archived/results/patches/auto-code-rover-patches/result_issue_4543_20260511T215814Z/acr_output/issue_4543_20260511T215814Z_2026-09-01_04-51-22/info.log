589     def get_editor_model(self, provided_editor_model_name, editor_edit_format):
590         # If editor_model_name is provided, override the model settings
591         if provided_editor_model_name:
592             self.editor_model_name = provided_editor_model_name
593         if editor_edit_format:
594             self.editor_edit_format = editor_edit_format
595 
596         if not self.editor_model_name or self.editor_model_name == self.name:
597             self.editor_model = self
598         else:
599             self.editor_model = Model(
600                 self.editor_model_name,
601                 editor_model=False,
602             )
603 
604         if not self.editor_edit_format:
605             self.editor_edit_format = self.editor_model.edit_format
606             if self.editor_edit_format in ("diff", "whole", "diff-fenced"):
607                 self.editor_edit_format = "editor-" + self.editor_edit_format
608 
609         return self.editor_model
