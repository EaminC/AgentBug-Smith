676     def fast_validate_environment(self):
677         """Fast path for common models. Avoids forcing litellm import."""
678 
679         model = self.name
680 
681         pieces = model.split("/")
682         if len(pieces) > 1:
683             provider = pieces[0]
684         else:
685             provider = None
686 
687         keymap = dict(
688             openrouter="OPENROUTER_API_KEY",
689             openai="OPENAI_API_KEY",
690             deepseek="DEEPSEEK_API_KEY",
691             gemini="GEMINI_API_KEY",
692             anthropic="ANTHROPIC_API_KEY",
693             groq="GROQ_API_KEY",
694             fireworks_ai="FIREWORKS_API_KEY",
695         )
696         var = None
697         if model in OPENAI_MODELS:
698             var = "OPENAI_API_KEY"
699         elif model in ANTHROPIC_MODELS:
700             var = "ANTHROPIC_API_KEY"
701         else:
702             var = keymap.get(provider)
703 
704         if var and os.environ.get(var):
705             return dict(keys_in_environment=[var], missing_keys=[])
