1049 def register_models(model_settings_fnames):
1050     files_loaded = []
1051     for model_settings_fname in model_settings_fnames:
1052         if not os.path.exists(model_settings_fname):
1053             continue
1054 
1055         if not Path(model_settings_fname).read_text().strip():
1056             continue
1057 
1058         try:
1059             with open(model_settings_fname, "r") as model_settings_file:
1060                 model_settings_list = yaml.safe_load(model_settings_file)
1061 
1062             for model_settings_dict in model_settings_list:
1063                 model_settings = ModelSettings(**model_settings_dict)
1064 
1065                 # Remove all existing settings for this model name
1066                 MODEL_SETTINGS[:] = [ms for ms in MODEL_SETTINGS if ms.name != model_settings.name]
1067                 # Add the new settings
1068                 MODEL_SETTINGS.append(model_settings)
1069         except Exception as e:
1070             raise Exception(f"Error loading model settings from {model_settings_fname}: {e}")
1071         files_loaded.append(model_settings_fname)
1072 
1073     return files_loaded
1074 
