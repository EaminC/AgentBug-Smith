898     def github_copilot_token_to_open_ai_key(self, extra_headers):
899         # check to see if there's an openai api key
900         # If so, check to see if it's expire
901         openai_api_key = "OPENAI_API_KEY"
902 
903         if openai_api_key not in os.environ or (
904             int(dict(x.split("=") for x in os.environ[openai_api_key].split(";"))["exp"])
905             < int(datetime.now().timestamp())
906         ):
907             import requests
908 
909             class GitHubCopilotTokenError(Exception):
910                 """Custom exception for GitHub Copilot token-related errors."""
911 
912                 pass
913 
914             # Validate GitHub Copilot token exists
915             if "GITHUB_COPILOT_TOKEN" not in os.environ:
916                 raise KeyError("GITHUB_COPILOT_TOKEN environment variable not found")
917 
918             github_token = os.environ["GITHUB_COPILOT_TOKEN"]
919             if not github_token.strip():
920                 raise KeyError("GITHUB_COPILOT_TOKEN environment variable is empty")
921 
922             headers = {
923                 "Authorization": f"Bearer {os.environ['GITHUB_COPILOT_TOKEN']}",
924                 "Editor-Version": extra_headers["Editor-Version"],
925                 "Copilot-Integration-Id": extra_headers["Copilot-Integration-Id"],
926                 "Content-Type": "application/json",
927             }
928 
929             url = "https://api.github.com/copilot_internal/v2/token"
930             res = requests.get(url, headers=headers)
931             if res.status_code != 200:
932                 safe_headers = {k: v for k, v in headers.items() if k != "Authorization"}
933                 token_preview = github_token[:5] + "..." if len(github_token) >= 5 else github_token
934                 safe_headers["Authorization"] = f"Bearer {token_preview}"
935                 raise GitHubCopilotTokenError(
936                     f"GitHub Copilot API request failed (Status: {res.status_code})\n"
937                     f"URL: {url}\n"
938                     f"Headers: {json.dumps(safe_headers, indent=2)}\n"
939                     f"JSON: {res.text}"
940                 )
941 
942             response_data = res.json()
943             token = response_data.get("token")
944             if not token:
945                 raise GitHubCopilotTokenError("Response missing 'token' field")
946 
947             os.environ[openai_api_key] = token
948 
949     def send_completion(self, messages, functions, stream, temperature=None):
950         if os.environ.get("AIDER_SANITY_CHECK_TURNS"):
951             sanity_check_messages(messages)
952 
953         if self.is_deepseek_r1():
954             messages = ensure_alternating_roles(messages)
955 
956         kwargs = dict(
957             model=self.name,
958             stream=stream,
959         )
960 
961         if self.use_temperature is not False:
962             if temperature is None:
963                 if isinstance(self.use_temperature, bool):
964                     temperature = 0
965                 else:
966                     temperature = float(self.use_temperature)
967 
968             kwargs["temperature"] = temperature
969 
970         if functions is not None:
971             function = functions[0]
972             kwargs["tools"] = [dict(type="function", function=function)]
973             kwargs["tool_choice"] = {"type": "function", "function": {"name": function["name"]}}
974         if self.extra_params:
975             kwargs.update(self.extra_params)
976         if self.is_ollama() and "num_ctx" not in kwargs:
977             num_ctx = int(self.token_count(messages) * 1.25) + 8192
978             kwargs["num_ctx"] = num_ctx
979         key = json.dumps(kwargs, sort_keys=True).encode()
980 
981         # dump(kwargs)
982 
983         hash_object = hashlib.sha1(key)
984         if "timeout" not in kwargs:
985             kwargs["timeout"] = request_timeout
986         if self.verbose:
987             dump(kwargs)
988         kwargs["messages"] = messages
989 
990         # Are we using github copilot?
991         if "GITHUB_COPILOT_TOKEN" in os.environ:
992             if "extra_headers" not in kwargs:
993                 kwargs["extra_headers"] = {
994                     "Editor-Version": f"aider/{__version__}",
995                     "Copilot-Integration-Id": "vscode-chat",
996                 }
997 
998             self.github_copilot_token_to_open_ai_key(kwargs["extra_headers"])
999 
1000         res = litellm.completion(**kwargs)
1001         return hash_object, res
1002 
1003     def simple_send_with_retries(self, messages):
1004         from aider.exceptions import LiteLLMExceptions
1005 
1006         litellm_ex = LiteLLMExceptions()
1007         if "deepseek-reasoner" in self.name:
1008             messages = ensure_alternating_roles(messages)
1009         retry_delay = 0.125
1010 
1011         if self.verbose:
1012             dump(messages)
1013 
1014         while True:
1015             try:
1016                 kwargs = {
1017                     "messages": messages,
1018                     "functions": None,
1019                     "stream": False,
1020                 }
1021 
1022                 _hash, response = self.send_completion(**kwargs)
1023                 if not response or not hasattr(response, "choices") or not response.choices:
1024                     return None
1025                 res = response.choices[0].message.content
1026                 from aider.reasoning_tags import remove_reasoning_content
1027 
1028                 return remove_reasoning_content(res, self.reasoning_tag)
1029 
1030             except litellm_ex.exceptions_tuple() as err:
1031                 ex_info = litellm_ex.get_ex_info(err)
1032                 print(str(err))
1033                 if ex_info.description:
1034                     print(ex_info.description)
1035                 should_retry = ex_info.retry
1036                 if should_retry:
1037                     retry_delay *= 2
1038                     if retry_delay > RETRY_TIMEOUT:
1039                         should_retry = False
1040                 if not should_retry:
1041                     return None
1042                 print(f"Retrying in {retry_delay:.1f} seconds...")
1043                 time.sleep(retry_delay)
1044                 continue
1045             except AttributeError:
1046                 return None
1047 
