135 # Load model settings from package resource
136 MODEL_SETTINGS = []
137 with importlib.resources.open_text("aider.resources", "model-settings.yml") as f:
138     model_settings_list = yaml.safe_load(f)
139     for model_settings_dict in model_settings_list:
140         MODEL_SETTINGS.append(ModelSettings(**model_settings_dict))
