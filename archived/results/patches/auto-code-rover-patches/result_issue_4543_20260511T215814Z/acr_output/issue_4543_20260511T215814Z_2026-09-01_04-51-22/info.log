1003     def simple_send_with_retries(self, messages):
1004         from aider.exceptions import LiteLLMExceptions
1005 
1006         litellm_ex = LiteLLMExceptions()
1007         if "deepseek-reasoner" in self.name:
1008             messages = ensure_alternating_roles(messages)
1009         retry_delay = 0.125
1010 
1011         if self.verbose:
1012             dump(messages)
1013 
1014         while True:
1015             try:
1016                 kwargs = {
1017                     "messages": messages,
1018                     "functions": None,
1019                     "stream": False,
1020                 }
1021 
1022                 _hash, response = self.send_completion(**kwargs)
1023                 if not response or not hasattr(response, "choices") or not response.choices:
1024                     return None
1025                 res = response.choices[0].message.content
1026                 from aider.reasoning_tags import remove_reasoning_content
1027 
1028                 return remove_reasoning_content(res, self.reasoning_tag)
1029 
1030             except litellm_ex.exceptions_tuple() as err:
1031                 ex_info = litellm_ex.get_ex_info(err)
1032                 print(str(err))
1033                 if ex_info.description:
1034                     print(ex_info.description)
1035                 should_retry = ex_info.retry
1036                 if should_retry:
1037                     retry_delay *= 2
1038                     if retry_delay > RETRY_TIMEOUT:
1039                         should_retry = False
1040                 if not should_retry:
1041                     return None
1042                 print(f"Retrying in {retry_delay:.1f} seconds...")
1043                 time.sleep(retry_delay)
1044                 continue
1045             except AttributeError:
1046                 return None
