898     def github_copilot_token_to_open_ai_key(self, extra_headers):
899         # check to see if there's an openai api key
900         # If so, check to see if it's expire
901         openai_api_key = "OPENAI_API_KEY"
902 
903         if openai_api_key not in os.environ or (
904             int(dict(x.split("=") for x in os.environ[openai_api_key].split(";"))["exp"])
905             < int(datetime.now().timestamp())
906         ):
907             import requests
908 
909             class GitHubCopilotTokenError(Exception):
910                 """Custom exception for GitHub Copilot token-related errors."""
911 
912                 pass
913 
914             # Validate GitHub Copilot token exists
915             if "GITHUB_COPILOT_TOKEN" not in os.environ:
916                 raise KeyError("GITHUB_COPILOT_TOKEN environment variable not found")
917 
918             github_token = os.environ["GITHUB_COPILOT_TOKEN"]
919             if not github_token.strip():
920                 raise KeyError("GITHUB_COPILOT_TOKEN environment variable is empty")
921 
922             headers = {
923                 "Authorization": f"Bearer {os.environ['GITHUB_COPILOT_TOKEN']}",
924                 "Editor-Version": extra_headers["Editor-Version"],
925                 "Copilot-Integration-Id": extra_headers["Copilot-Integration-Id"],
926                 "Content-Type": "application/json",
927             }
928 
929             url = "https://api.github.com/copilot_internal/v2/token"
930             res = requests.get(url, headers=headers)
931             if res.status_code != 200:
932                 safe_headers = {k: v for k, v in headers.items() if k != "Authorization"}
933                 token_preview = github_token[:5] + "..." if len(github_token) >= 5 else github_token
934                 safe_headers["Authorization"] = f"Bearer {token_preview}"
935                 raise GitHubCopilotTokenError(
936                     f"GitHub Copilot API request failed (Status: {res.status_code})\n"
937                     f"URL: {url}\n"
938                     f"Headers: {json.dumps(safe_headers, indent=2)}\n"
939                     f"JSON: {res.text}"
940                 )
941 
942             response_data = res.json()
