1119         main_model.editor_model
1120         and main_model.editor_model is not main_model
1121         and main_model.editor_model is not main_model.weak_model
1122     ):
1123         problem_editor = sanity_check_model(io, main_model.editor_model)
1124 
1125     return problem_main or problem_weak or problem_editor
