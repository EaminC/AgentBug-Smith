1236 def print_matching_models(io, search):
1237     matches = fuzzy_match_models(search)
1238     if matches:
1239         io.tool_output(f'Models which match "{search}":')
1240         for model in matches:
1241             io.tool_output(f"- {model}")
1242     else:
1243         io.tool_output(f'No models match "{search}".')
