1246 def get_model_settings_as_yaml():
1247     from dataclasses import fields
1248 
1249     import yaml
1250 
1251     model_settings_list = []
1252     # Add default settings first with all field values
1253     defaults = {}
1254     for field in fields(ModelSettings):
1255         defaults[field.name] = field.default
1256     defaults["name"] = "(default values)"
1257     model_settings_list.append(defaults)
1258 
1259     # Sort model settings by name
1260     for ms in sorted(MODEL_SETTINGS, key=lambda x: x.name):
1261         # Create dict with explicit field order
1262         model_settings_dict = {}
1263         for field in fields(ModelSettings):
1264             value = getattr(ms, field.name)
1265             if value != field.default:
1266                 model_settings_dict[field.name] = value
1267         model_settings_list.append(model_settings_dict)
1268         # Add blank line between entries
1269         model_settings_list.append(None)
1270 
1271     # Filter out None values before dumping
1272     yaml_str = yaml.dump(
1273         [ms for ms in model_settings_list if ms is not None],
1274         default_flow_style=False,
1275         sort_keys=False,  # Preserve field order from dataclass
1276     )
1277     # Add actual blank lines between entries
1278     return yaml_str.replace("\n- ", "\n\n- ")
1279 
1280 
1281 def main():
1282     if len(sys.argv) < 2:
1283         print("Usage: python models.py <model_name> or python models.py --yaml")
1284         sys.exit(1)
1285 
1286     if sys.argv[1] == "--yaml":
1287         yaml_string = get_model_settings_as_yaml()
1288         print(yaml_string)
1289     else:
1290         model_name = sys.argv[1]
1291         matching_models = fuzzy_match_models(model_name)
1292 
1293         if matching_models:
1294             print(f"Matching models for '{model_name}':")
1295             for model in matching_models:
1296                 print(model)
1297         else:
1298             print(f"No matching models found for '{model_name}'.")
