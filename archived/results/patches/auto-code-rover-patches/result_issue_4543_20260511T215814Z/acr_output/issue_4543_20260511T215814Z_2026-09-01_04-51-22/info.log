614     def token_count(self, messages):
615         if type(messages) is list:
616             try:
617                 return litellm.token_counter(model=self.name, messages=messages)
618             except Exception as err:
619                 print(f"Unable to count tokens: {err}")
620                 return 0
621 
622         if not self.tokenizer:
623             return
624 
625         if type(messages) is str:
626             msgs = messages
627         else:
628             msgs = json.dumps(messages)
629 
630         try:
631             return len(self.tokenizer(msgs))
632         except Exception as err:
633             print(f"Unable to count tokens: {err}")
634             return 0
