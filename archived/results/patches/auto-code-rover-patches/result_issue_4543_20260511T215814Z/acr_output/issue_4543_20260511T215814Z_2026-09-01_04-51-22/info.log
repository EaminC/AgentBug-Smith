1191 def fuzzy_match_models(name):
1192     name = name.lower()
1193 
1194     chat_models = set()
1195     model_metadata = list(litellm.model_cost.items())
1196     model_metadata += list(model_info_manager.local_model_metadata.items())
1197 
1198     for orig_model, attrs in model_metadata:
1199         model = orig_model.lower()
1200         if attrs.get("mode") != "chat":
1201             continue
1202         provider = attrs.get("litellm_provider", "").lower()
1203         if not provider:
1204             continue
1205         provider += "/"
1206 
1207         if model.startswith(provider):
1208             fq_model = orig_model
1209         else:
1210             fq_model = provider + orig_model
1211 
1212         chat_models.add(fq_model)
1213         chat_models.add(orig_model)
1214 
1215     chat_models = sorted(chat_models)
1216     # exactly matching model
1217     # matching_models = [
1218     #    (fq,m) for fq,m in chat_models
1219     #    if name == fq or name == m
1220     # ]
1221     # if matching_models:
1222     #    return matching_models
1223 
1224     # Check for model names containing the name
1225     matching_models = [m for m in chat_models if name in m]
1226     if matching_models:
1227         return sorted(set(matching_models))
1228 
1229     # Check for slight misspellings
1230     models = set(chat_models)
1231     matching_models = difflib.get_close_matches(name, models, n=3, cutoff=0.8)
1232 
1233     return sorted(set(matching_models))
