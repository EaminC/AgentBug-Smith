771     def parse_token_value(self, value):
772         """
773         Parse a token value string into an integer.
774         Accepts formats: 8096, "8k", "10.5k", "0.5M", "10K", etc.
775 
776         Args:
777             value: String or int token value
778 
779         Returns:
780             Integer token value
781         """
782         if isinstance(value, int):
783             return value
784 
785         if not isinstance(value, str):
786             return int(value)  # Try to convert to int
787 
788         value = value.strip().upper()
789 
790         if value.endswith("K"):
791             multiplier = 1024
792             value = value[:-1]
793         elif value.endswith("M"):
794             multiplier = 1024 * 1024
795             value = value[:-1]
796         else:
797             multiplier = 1
798 
799         # Convert to float first to handle decimal values like "10.5k"
800         return int(float(value) * multiplier)
801 
802     def set_thinking_tokens(self, value):
803         """
804         Set the thinking token budget for models that support it.
805         Accepts formats: 8096, "8k", "10.5k", "0.5M", "10K", etc.
806         Pass "0" to disable thinking tokens.
807         """
808         if value is not None:
809             num_tokens = self.parse_token_value(value)
810             self.use_temperature = False
811             if not self.extra_params:
812                 self.extra_params = {}
813 
814             # OpenRouter models use 'reasoning' instead of 'thinking'
815             if self.name.startswith("openrouter/"):
816                 if "extra_body" not in self.extra_params:
817                     self.extra_params["extra_body"] = {}
818                 if num_tokens > 0:
819                     self.extra_params["extra_body"]["reasoning"] = {"max_tokens": num_tokens}
820                 else:
821                     if "reasoning" in self.extra_params["extra_body"]:
822                         del self.extra_params["extra_body"]["reasoning"]
823             else:
824                 if num_tokens > 0:
825                     self.extra_params["thinking"] = {"type": "enabled", "budget_tokens": num_tokens}
826                 else:
827                     if "thinking" in self.extra_params:
828                         del self.extra_params["thinking"]
829 
830     def get_raw_thinking_tokens(self):
831         """Get formatted thinking token budget if available"""
832         budget = None
833 
834         if self.extra_params:
835             # Check for OpenRouter reasoning format
836             if self.name.startswith("openrouter/"):
837                 if (
838                     "extra_body" in self.extra_params
839                     and "reasoning" in self.extra_params["extra_body"]
840                     and "max_tokens" in self.extra_params["extra_body"]["reasoning"]
841                 ):
842                     budget = self.extra_params["extra_body"]["reasoning"]["max_tokens"]
843             # Check for standard thinking format
844             elif (
845                 "thinking" in self.extra_params and "budget_tokens" in self.extra_params["thinking"]
846             ):
847                 budget = self.extra_params["thinking"]["budget_tokens"]
848 
849         return budget
850 
851     def get_thinking_tokens(self):
852         budget = self.get_raw_thinking_tokens()
853 
854         if budget is not None:
855             # Format as xx.yK for thousands, xx.yM for millions
856             if budget >= 1024 * 1024:
857                 value = budget / (1024 * 1024)
858                 if value == int(value):
859                     return f"{int(value)}M"
860                 else:
861                     return f"{value:.1f}M"
862             else:
863                 value = budget / 1024
864                 if value == int(value):
865                     return f"{int(value)}k"
866                 else:
867                     return f"{value:.1f}k"
868         return None
869 
