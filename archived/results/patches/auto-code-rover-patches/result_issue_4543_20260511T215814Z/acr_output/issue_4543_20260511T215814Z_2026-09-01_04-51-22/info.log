611     def tokenizer(self, text):
612         return litellm.encode(model=self.name, text=text)
613 
614     def token_count(self, messages):
615         if type(messages) is list:
616             try:
617                 return litellm.token_counter(model=self.name, messages=messages)
618             except Exception as err:
619                 print(f"Unable to count tokens: {err}")
620                 return 0
621 
622         if not self.tokenizer:
623             return
624 
625         if type(messages) is str:
626             msgs = messages
627         else:
628             msgs = json.dumps(messages)
629 
630         try:
631             return len(self.tokenizer(msgs))
632         except Exception as err:
633             print(f"Unable to count tokens: {err}")
634             return 0
635 
636     def token_count_for_image(self, fname):
637         """
638         Calculate the token cost for an image assuming high detail.
639         The token cost is determined by the size of the image.
640         :param fname: The filename of the image.
641         :return: The token cost for the image.
642         """
643         width, height = self.get_image_size(fname)
644 
645         # If the image is larger than 2048 in any dimension, scale it down to fit within 2048x2048
646         max_dimension = max(width, height)
647         if max_dimension > 2048:
648             scale_factor = 2048 / max_dimension
649             width = int(width * scale_factor)
650             height = int(height * scale_factor)
651 
652         # Scale the image such that the shortest side is 768 pixels long
653         min_dimension = min(width, height)
654         scale_factor = 768 / min_dimension
655         width = int(width * scale_factor)
656         height = int(height * scale_factor)
657 
658         # Calculate the number of 512x512 tiles needed to cover the image
659         tiles_width = math.ceil(width / 512)
660         tiles_height = math.ceil(height / 512)
661         num_tiles = tiles_width * tiles_height
662 
663         # Each tile costs 170 tokens, and there's an additional fixed cost of 85 tokens
664         token_cost = num_tiles * 170 + 85
665         return token_cost
666 
667     def get_image_size(self, fname):
668         """
669         Retrieve the size of an image.
670         :param fname: The filename of the image.
671         :return: A tuple (width, height) representing the image size in pixels.
672         """
673         with Image.open(fname) as img:
674             return img.size
675 
676     def fast_validate_environment(self):
677         """Fast path for common models. Avoids forcing litellm import."""
678 
679         model = self.name
680 
681         pieces = model.split("/")
682         if len(pieces) > 1:
683             provider = pieces[0]
684         else:
685             provider = None
686 
687         keymap = dict(
688             openrouter="OPENROUTER_API_KEY",
689             openai="OPENAI_API_KEY",
690             deepseek="DEEPSEEK_API_KEY",
691             gemini="GEMINI_API_KEY",
692             anthropic="ANTHROPIC_API_KEY",
693             groq="GROQ_API_KEY",
694             fireworks_ai="FIREWORKS_API_KEY",
695         )
696         var = None
697         if model in OPENAI_MODELS:
698             var = "OPENAI_API_KEY"
699         elif model in ANTHROPIC_MODELS:
700             var = "ANTHROPIC_API_KEY"
701         else:
702             var = keymap.get(provider)
703 
704         if var and os.environ.get(var):
705             return dict(keys_in_environment=[var], missing_keys=[])
706 
707     def validate_environment(self):
708         res = self.fast_validate_environment()
709         if res:
710             return res
711 
712         # https://github.com/BerriAI/litellm/issues/3190
713 
714         model = self.name
715         res = litellm.validate_environment(model)
716 
717         # If missing AWS credential keys but AWS_PROFILE is set, consider AWS credentials valid
718         if res["missing_keys"] and any(
719             key in ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"] for key in res["missing_keys"]
720         ):
721             if model.startswith("bedrock/") or model.startswith("us.anthropic."):
722                 if os.environ.get("AWS_PROFILE"):
723                     res["missing_keys"] = [
724                         k
725                         for k in res["missing_keys"]
726                         if k not in ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"]
727                     ]
728                     if not res["missing_keys"]:
729                         res["keys_in_environment"] = True
730 
731         if res["keys_in_environment"]:
732             return res
733         if res["missing_keys"]:
734             return res
735 
736         provider = self.info.get("litellm_provider", "").lower()
737         if provider == "cohere_chat":
738             return validate_variables(["COHERE_API_KEY"])
739         if provider == "gemini":
740             return validate_variables(["GEMINI_API_KEY"])
741         if provider == "groq":
742             return validate_variables(["GROQ_API_KEY"])
743 
744         return res
745 
746     def get_repo_map_tokens(self):
747         map_tokens = 1024
748         max_inp_tokens = self.info.get("max_input_tokens")
749         if max_inp_tokens:
750             map_tokens = max_inp_tokens / 8
751             map_tokens = min(map_tokens, 4096)
