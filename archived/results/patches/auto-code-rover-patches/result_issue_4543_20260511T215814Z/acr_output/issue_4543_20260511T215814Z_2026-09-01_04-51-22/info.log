1128 def sanity_check_model(io, model):
1129     show = False
1130 
1131     if model.missing_keys:
1132         show = True
1133         io.tool_warning(f"Warning: {model} expects these environment variables")
1134         for key in model.missing_keys:
1135             value = os.environ.get(key, "")
1136             status = "Set" if value else "Not set"
1137             io.tool_output(f"- {key}: {status}")
