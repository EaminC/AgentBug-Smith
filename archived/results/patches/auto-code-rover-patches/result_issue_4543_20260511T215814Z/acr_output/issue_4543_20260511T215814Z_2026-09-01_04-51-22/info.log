567     def get_weak_model(self, provided_weak_model_name):
568         # If weak_model_name is provided, override the model settings
569         if provided_weak_model_name:
570             self.weak_model_name = provided_weak_model_name
571 
572         if not self.weak_model_name:
573             self.weak_model = self
574             return
575 
576         if self.weak_model_name == self.name:
577             self.weak_model = self
578             return
579 
580         self.weak_model = Model(
581             self.weak_model_name,
582             weak_model=False,
583         )
584         return self.weak_model
