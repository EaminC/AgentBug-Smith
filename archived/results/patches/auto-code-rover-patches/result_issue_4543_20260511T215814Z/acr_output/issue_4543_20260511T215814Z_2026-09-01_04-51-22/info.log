1080             continue
1081 
1082         try:
1083             data = Path(model_fname).read_text()
1084             if not data.strip():
1085                 continue
1086             model_def = json5.loads(data)
1087             if not model_def:
1088                 continue
1089 
1090             # Defer registration with litellm to faster path.
1091             model_info_manager.local_model_metadata.update(model_def)
1092         except Exception as e:
1093             raise Exception(f"Error loading model definition from {model_fname}: {e}")
1094 
1095         files_loaded.append(model_fname)
1096 
1097     return files_loaded
