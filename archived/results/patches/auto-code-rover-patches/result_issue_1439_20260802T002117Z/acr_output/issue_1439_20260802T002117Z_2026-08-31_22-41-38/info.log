271     def _select_tool(self, tool_name: str) -> Any:
272         order_tools = sorted(
273             self.tools,
274             key=lambda tool: SequenceMatcher(
275                 None, tool.name.lower().strip(), tool_name.lower().strip()
276             ).ratio(),
277             reverse=True,
278         )
279         for tool in order_tools:
280             if (
281                 tool.name.lower().strip() == tool_name.lower().strip()
282                 or SequenceMatcher(
283                     None, tool.name.lower().strip(), tool_name.lower().strip()
284                 ).ratio()
285                 > 0.85
286             ):
287                 return tool
288         self.task.increment_tools_errors()
289         if tool_name and tool_name != "":
290             raise Exception(
291                 f"Action '{tool_name}' don't exist, these are the only available Actions:\n{self.tools_description}"
292             )
293         else:
294             raise Exception(
295                 f"I forgot the Action name, these are the only available Actions: {self.tools_description}"
296             )
