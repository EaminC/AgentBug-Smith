261     def _check_tool_repeated_usage(
262         self, calling: Union[ToolCalling, InstructorToolCalling]
263     ) -> None:
264         if not self.tools_handler:
265             return False  # type: ignore # No return value expected
266         if last_tool_usage := self.tools_handler.last_used_tool:
267             return (calling.tool_name == last_tool_usage.tool_name) and (  # type: ignore # No return value expected
268                 calling.arguments == last_tool_usage.arguments
269             )
