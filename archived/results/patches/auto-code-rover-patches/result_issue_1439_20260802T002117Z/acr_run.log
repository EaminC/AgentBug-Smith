298     def _render(self) -> str:
299         """Render the tool name and description in plain text."""
300         descriptions = []
301         for tool in self.tools:
302             args = {
303                 k: {k2: v2 for k2, v2 in v.items() if k2 in ["description", "type"]}
304                 for k, v in tool.args.items()
305             }
306             descriptions.append(
307                 "\n".join(
308                     [
309                         f"Tool Name: {tool.name.lower()}",
310                         f"Tool Description: {tool.description}",
311                         f"Tool Arguments: {args}",
312                     ]
313                 )
314             )
315         return "\n--\n".join(descriptions)
