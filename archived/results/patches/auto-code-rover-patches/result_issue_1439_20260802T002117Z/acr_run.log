42         function_calling_llm: Any = None,
43         respect_context_window: bool = False,
44         request_within_rpm_limit: Any = None,
45         callbacks: List[Any] = [],
46     ):
47         self._i18n: I18N = I18N()
48         self.llm = llm
49         self.task = task
50         self.agent = agent
51         self.crew = crew
52         self.prompt = prompt
53         self.tools = tools
54         self.tools_names = tools_names
55         self.stop = stop_words
