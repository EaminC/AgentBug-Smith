256     def _summarize_messages(self) -> None:
257         messages_groups = []
258         for message in self.messages:
259             content = message["content"]
260             cut_size = self.llm.get_context_window_size()
261             for i in range(0, len(content), cut_size):
262                 messages_groups.append(content[i : i + cut_size])
263 
264         summarized_contents = []
265         for group in messages_groups:
266             summary = self.llm.call(
267                 [
268                     self._format_msg(
269                         self._i18n.slice("summarizer_system_message"), role="system"
270                     ),
271                     self._format_msg(
272                         self._i18n.slice("sumamrize_instruction").format(group=group),
273                     ),
274                 ],
275                 callbacks=self.callbacks,
276             )
277             summarized_contents.append(summary)
278 
279         merged_summary = " ".join(str(content) for content in summarized_contents)
280 
281         self.messages = [
282             self._format_msg(
283                 self._i18n.slice("summary").format(merged_summary=merged_summary)
284             )
285         ]
286 
287     def _handle_context_length(self) -> None:
288         if self.respect_context_window:
289             self._logger.log(
290                 "debug",
291                 "Context length exceeded. Summarizing content to fit the model context window.",
292                 color="yellow",
293             )
294             self._summarize_messages()
295         else:
296             self._logger.log(
297                 "debug",
298                 "Context length exceeded. Consider using smaller text or RAG tools from crewai_tools.",
299                 color="red",
300             )
301             raise SystemExit(
302                 "Context length exceeded and user opted not to summarize. Consider using smaller text or RAG tools from crewai_tools."
303             )
304 
305     def _handle_crew_training_output(
306         self, result: AgentFinish, human_feedback: str | None = None
307     ) -> None:
308         """Function to handle the process of the training data."""
309         agent_id = str(self.agent.id)
310 
311         # Load training data
312         training_handler = CrewTrainingHandler(TRAINING_DATA_FILE)
313         training_data = training_handler.load()
314 
315         # Check if training data exists, human input is not requested, and self.crew is valid
316         if training_data and not self.ask_for_human_input:
317             if self.crew is not None and hasattr(self.crew, "_train_iteration"):
318                 train_iteration = self.crew._train_iteration
319                 if agent_id in training_data and isinstance(train_iteration, int):
320                     training_data[agent_id][train_iteration]["improved_output"] = (
321                         result.output
322                     )
323                     training_handler.save(training_data)
324                 else:
325                     self._logger.log(
326                         "error",
327                         "Invalid train iteration type or agent_id not in training data.",
328                         color="red",
329                     )
330             else:
331                 self._logger.log(
332                     "error",
333                     "Crew is None or does not have _train_iteration attribute.",
334                     color="red",
335                 )
336 
337         if self.ask_for_human_input and human_feedback is not None:
338             training_data = {
339                 "initial_output": result.output,
340                 "human_feedback": human_feedback,
341                 "agent": agent_id,
342                 "agent_role": self.agent.role,
343             }
344             if self.crew is not None and hasattr(self.crew, "_train_iteration"):
345                 train_iteration = self.crew._train_iteration
346                 if isinstance(train_iteration, int):
347                     CrewTrainingHandler(TRAINING_DATA_FILE).append(
348                         train_iteration, agent_id, training_data
349                     )
350                 else:
351                     self._logger.log(
352                         "error",
353                         "Invalid train iteration type. Expected int.",
354                         color="red",
355                     )
356             else:
357                 self._logger.log(
358                     "error",
359                     "Crew is None or does not have _train_iteration attribute.",
360                     color="red",
361                 )
362 
363     def _format_prompt(self, prompt: str, inputs: Dict[str, str]) -> str:
364         prompt = prompt.replace("{input}", inputs["input"])
365         prompt = prompt.replace("{tool_names}", inputs["tool_names"])
366         prompt = prompt.replace("{tools}", inputs["tools"])
367         return prompt
368 
369     def _format_answer(self, answer: str) -> Union[AgentAction, AgentFinish]:
370         return CrewAgentParser(agent=self.agent).parse(answer)
371 
372     def _format_msg(self, prompt: str, role: str = "user") -> Dict[str, str]:
373         return {"role": role, "content": prompt}

