317     def _function_calling(self, tool_string: str):
318         model = (
319             InstructorToolCalling
320             if self.function_calling_llm.supports_function_calling()
321             else ToolCalling
322         )
323         converter = Converter(
324             text=f"Only tools available:\n###\n{self._render()}\n\nReturn a valid schema for the tool, the tool name must be exactly equal one of the options, use this text to inform the valid output schema:\n\n### TEXT \n{tool_string}",
325             llm=self.function_calling_llm,
326             model=model,
327             instructions=dedent(
328                 """\
329         The schema should have the following structure, only two keys:
330         - tool_name: str
331         - arguments: dict (always a dictionary, with all arguments being passed)
332 
333         Example:
334         {"tool_name": "tool name", "arguments": {"arg_name1": "value", "arg_name2": 2}}""",
335             ),
336             max_attempts=1,
337         )
338         tool_object = converter.to_pydantic()
339         calling = ToolCalling(
340             tool_name=tool_object["tool_name"],
341             arguments=tool_object["arguments"],
342             log=tool_string,  # type: ignore
343         )
344 
345         if isinstance(calling, ConverterError):
346             raise calling
347 
348         return calling
349 
350     def _original_tool_calling(self, tool_string: str, raise_error: bool = False):
351         tool_name = self.action.tool
352         tool = self._select_tool(tool_name)
353         try:
354             tool_input = self._validate_tool_input(self.action.tool_input)
355             arguments = ast.literal_eval(tool_input)
356         except Exception:
357             if raise_error:
358                 raise
359             else:
360                 return ToolUsageErrorException(  # type: ignore # Incompatible return value type (got "ToolUsageErrorException", expected "ToolCalling | InstructorToolCalling")
361                     f'{self._i18n.errors("tool_arguments_error")}'
362                 )
363 
364         if not isinstance(arguments, dict):
365             if raise_error:
366                 raise
367             else:
368                 return ToolUsageErrorException(  # type: ignore # Incompatible return value type (got "ToolUsageErrorException", expected "ToolCalling | InstructorToolCalling")
369                     f'{self._i18n.errors("tool_arguments_error")}'
370                 )
371 
372         return ToolCalling(
373             tool_name=tool.name,
374             arguments=arguments,
375             log=tool_string,  # type: ignore
376         )
377 
378     def _tool_calling(
379         self, tool_string: str
380     ) -> Union[ToolCalling, InstructorToolCalling]:
381         try:
382             try:
383                 return self._original_tool_calling(tool_string, raise_error=True)
384             except Exception:
385                 if self.function_calling_llm:
386                     return self._function_calling(tool_string)
387                 else:
388                     return self._original_tool_calling(tool_string)
389         except Exception as e:
390             self._run_attempts += 1
391             if self._run_attempts > self._max_parsing_attempts:
392                 self._telemetry.tool_usage_error(llm=self.function_calling_llm)
393                 self.task.increment_tools_errors()
394                 if self.agent.verbose:
395                     self._printer.print(content=f"\n\n{e}\n", color="red")
396                 return ToolUsageErrorException(  # type: ignore # Incompatible return value type (got "ToolUsageErrorException", expected "ToolCalling | InstructorToolCalling")
397                     f'{self._i18n.errors("tool_usage_error").format(error=e)}\nMoving on then. {self._i18n.slice("format").format(tool_names=self.tools_names)}'
398                 )
399             return self._tool_calling(tool_string)
400 
401     def _validate_tool_input(self, tool_input: str) -> str:
402         try:
403             ast.literal_eval(tool_input)
404             return tool_input
405         except Exception:
406             # Clean and ensure the string is properly enclosed in braces
407             tool_input = tool_input.strip()
408             if not tool_input.startswith("{"):
409                 tool_input = "{" + tool_input
410             if not tool_input.endswith("}"):
411                 tool_input += "}"
412 
413             # Manually split the input into key-value pairs
414             entries = tool_input.strip("{} ").split(",")
415             formatted_entries = []
416 
417             for entry in entries:
418                 if ":" not in entry:
419                     continue  # Skip malformed entries
420                 key, value = entry.split(":", 1)
421 
422                 # Remove extraneous white spaces and quotes, replace single quotes
423                 key = key.strip().strip('"').replace("'", '"')
424                 value = value.strip()
425 
426                 # Handle replacement of single quotes at the start and end of the value string
427                 if value.startswith("'") and value.endswith("'"):
428                     value = value[1:-1]  # Remove single quotes
429                     value = (
430                         '"' + value.replace('"', '\\"') + '"'
431                     )  # Re-encapsulate with double quotes
432                 elif value.isdigit():  # Check if value is a digit, hence integer
433                     value = value
434                 elif value.lower() in [
435                     "true",
436                     "false",
437                     "null",
438                 ]:  # Check for boolean and null values
439                     value = value.lower()
440                 else:
441                     # Assume the value is a string and needs quotes
442                     value = '"' + value.replace('"', '\\"') + '"'
443 
444                 # Rebuild the entry with proper quoting
445                 formatted_entry = f'"{key}": {value}'
446                 formatted_entries.append(formatted_entry)
447 
448             # Reconstruct the JSON string
449             new_json_string = "{" + ", ".join(formatted_entries) + "}"
450             return new_json_string
451 
452     def on_tool_error(self, tool: Any, tool_calling: ToolCalling, e: Exception) -> None:
453         event_data = self._prepare_event_data(tool, tool_calling)
454         events.emit(
455             source=self, event=ToolUsageError(**{**event_data, "error": str(e)})
456         )
457 
458     def on_tool_use_finished(
459         self, tool: Any, tool_calling: ToolCalling, from_cache: bool, started_at: float
460     ) -> None:
461         finished_at = time.time()
462         event_data = self._prepare_event_data(tool, tool_calling)
463         event_data.update(
464             {
465                 "started_at": datetime.datetime.fromtimestamp(started_at),
466                 "finished_at": datetime.datetime.fromtimestamp(finished_at),
467                 "from_cache": from_cache,
468             }
469         )
470         events.emit(source=self, event=ToolUsageFinished(**event_data))
471 
472     def _prepare_event_data(self, tool: Any, tool_calling: ToolCalling) -> dict:
473         return {
474             "agent_key": self.agent.key,
475             "agent_role": (self.agent._original_role or self.agent.role),
476             "run_attempts": self._run_attempts,
477             "delegations": self.task.delegations,
478             "tool_name": tool.name,
479             "tool_args": tool_calling.arguments,
480             "tool_class": tool.__class__.__name__,
481         }

