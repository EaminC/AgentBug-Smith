242         api_key: Optional[str] = None,
243         callbacks: List[Any] = [],
244         reasoning_effort: Optional[Literal["none", "low", "medium", "high"]] = None,
245         stream: bool = False,
246         **kwargs,
247     ):
248         self.model = model
249         self.timeout = timeout
250         self.temperature = temperature
251         self.top_p = top_p
252         self.n = n
253         self.max_completion_tokens = max_completion_tokens
254         self.max_tokens = max_tokens
255         self.presence_penalty = presence_penalty
256         self.frequency_penalty = frequency_penalty
