33 class Agent:
34     """Agent class for interacting with Auto-GPT.
35 
36     Attributes:
37         ai_name: The name of the agent.
38         memory: The memory object to use.
39         next_action_count: The number of actions to execute.
40         system_prompt: The system prompt is the initial prompt that defines everything
41           the AI needs to know to achieve its task successfully.
42         Currently, the dynamic and customizable information in the system prompt are
43           ai_name, description and goals.
44 
45         triggering_prompt: The last sentence the AI will see before answering.
46             For Auto-GPT, this prompt is:
47             Determine which next command to use, and respond using the format specified
48               above:
49             The triggering prompt is not part of the system prompt because between the
50               system prompt and the triggering
51             prompt we have contextual information that can distract the AI and make it
52               forget that its goal is to find the next task to achieve.
53             SYSTEM PROMPT
54             CONTEXTUAL INFORMATION (memory, previous conversations, anything relevant)
55             TRIGGERING PROMPT
56 
57         The triggering prompt reminds the AI about its short term meta task
58         (defining the next task)
59     """
60 
61     def __init__(
62         self,
63         ai_name: str,
64         memory: VectorMemory,
65         next_action_count: int,
66         command_registry: CommandRegistry,
67         config: AIConfig,
68         system_prompt: str,
69         triggering_prompt: str,
70         workspace_directory: str,
71     ):
72         cfg = Config()
73         self.ai_name = ai_name
74         self.memory = memory
75         self.history = MessageHistory(self)
76         self.next_action_count = next_action_count
77         self.command_registry = command_registry
78         self.config = config
79         self.system_prompt = system_prompt
80         self.triggering_prompt = triggering_prompt
81         self.workspace = Workspace(workspace_directory, cfg.restrict_to_workspace)
82         self.created_at = datetime.now().strftime("%Y%m%d_%H%M%S")
83         self.cycle_count = 0
84         self.log_cycle_handler = LogCycleHandler()
85 
