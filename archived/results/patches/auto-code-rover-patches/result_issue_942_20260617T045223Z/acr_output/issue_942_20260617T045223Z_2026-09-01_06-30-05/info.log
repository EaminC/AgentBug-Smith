165             )
166 
167             logger.typewriter_log(
168                 "NEXT ACTION: ",
169                 Fore.CYAN,
170                 f"COMMAND = {Fore.CYAN}{command_name}{Style.RESET_ALL}  "
171                 f"ARGUMENTS = {Fore.CYAN}{arguments}{Style.RESET_ALL}",
172             )
173 
174             if not cfg.continuous_mode and self.next_action_count == 0:
175                 # ### GET USER AUTHORIZATION TO EXECUTE COMMAND ###
176                 # Get key press: Prompt the user to press enter to continue or escape
177                 # to exit
178                 self.user_input = ""
179                 logger.info(
180                     "Enter 'y' to authorise command, 'y -N' to run N continuous commands, 's' to run self-feedback commands, "
181                     "'n' to exit program, or enter feedback for "
182                     f"{self.ai_name}..."
183                 )
184                 while True:
185                     if cfg.chat_messages_enabled:
186                         console_input = clean_input("Waiting for your response...")
187                     else:
188                         console_input = clean_input(
189                             Fore.MAGENTA + "Input:" + Style.RESET_ALL
190                         )
191                     if console_input.lower().strip() == cfg.authorise_key:
192                         user_input = "GENERATE NEXT COMMAND JSON"
193                         break
194                     elif console_input.lower().strip() == "s":
195                         logger.typewriter_log(
196                             "-=-=-=-=-=-=-= THOUGHTS, REASONING, PLAN AND CRITICISM WILL NOW BE VERIFIED BY AGENT -=-=-=-=-=-=-=",
197                             Fore.GREEN,
198                             "",
199                         )
200                         thoughts = assistant_reply_json.get("thoughts", {})
201                         self_feedback_resp = self.get_self_feedback(
202                             thoughts, cfg.fast_llm_model
203                         )
204                         logger.typewriter_log(
205                             f"SELF FEEDBACK: {self_feedback_resp}",
206                             Fore.YELLOW,
207                             "",
208                         )
209                         user_input = self_feedback_resp
210                         command_name = "self_feedback"
211                         break
212                     elif console_input.lower().strip() == "":
213                         logger.warn("Invalid input format.")
214                         continue
215                     elif console_input.lower().startswith(f"{cfg.authorise_key} -"):
216                         try:
217                             self.next_action_count = abs(
218                                 int(console_input.split(" ")[1])
219                             )
220                             user_input = "GENERATE NEXT COMMAND JSON"
221                         except ValueError:
222                             logger.warn(
223                                 "Invalid input format. Please enter 'y -n' where n is"
224                                 " the number of continuous tasks."
225                             )
226                             continue
227                         break
228                     elif console_input.lower() == cfg.exit_key:
229                         user_input = "EXIT"
230                         break
231                     else:
232                         user_input = console_input
233                         command_name = "human_feedback"
234                         self.log_cycle_handler.log_cycle(
235                             self.config.ai_name,
236                             self.created_at,
237                             self.cycle_count,
238                             user_input,
239                             USER_INPUT_FILE_NAME,
240                         )
241                         break
242 
243                 if user_input == "GENERATE NEXT COMMAND JSON":
244                     logger.typewriter_log(
245                         "-=-=-=-=-=-=-= COMMAND AUTHORISED BY USER -=-=-=-=-=-=-=",
246                         Fore.MAGENTA,
247                         "",
248                     )
249                 elif user_input == "EXIT":
250                     logger.info("Exiting...")
251                     break
252             else:
253                 # Print authorized commands left value
254                 logger.typewriter_log(
255                     f"{Fore.CYAN}AUTHORISED COMMANDS LEFT: {Style.RESET_ALL}{self.next_action_count}"
256                 )
257 
258             # Execute command
259             if command_name is not None and command_name.lower().startswith("error"):
260                 result = f"Could not execute command: {arguments}"
261             elif command_name == "human_feedback":
262                 result = f"Human feedback: {user_input}"
263             elif command_name == "self_feedback":
264                 result = f"Self feedback: {user_input}"
265             else:
266                 for plugin in cfg.plugins:
267                     if not plugin.can_handle_pre_command():
268                         continue
269                     command_name, arguments = plugin.pre_command(
270                         command_name, arguments
271                     )
272                 command_result = execute_command(
273                     self.command_registry,
274                     command_name,
275                     arguments,
276                     self.config.prompt_generator,
277                     config=cfg,
278                 )
279                 result = f"Command {command_name} returned: " f"{command_result}"
280 
281                 result_tlength = count_string_tokens(
282                     str(command_result), cfg.fast_llm_model
283                 )
284                 memory_tlength = count_string_tokens(
285                     str(self.history.summary_message()), cfg.fast_llm_model
286                 )
287                 if result_tlength + memory_tlength + 600 > cfg.fast_token_limit:
288                     result = f"Failure: command {command_name} returned too much output. \
289                         Do not execute this command again with the same arguments."
290 
291                 for plugin in cfg.plugins:
292                     if not plugin.can_handle_post_command():
293                         continue
294                     result = plugin.post_command(command_name, result)
295                 if self.next_action_count > 0:
296                     self.next_action_count -= 1
297 
298             # Check if there's a result from the command append it to the message
299             # history
300             if result is not None:
301                 self.history.add("system", result, "action_result")
302                 logger.typewriter_log("SYSTEM: ", Fore.YELLOW, result)
303             else:
304                 self.history.add("system", "Unable to execute command", "action_result")
305                 logger.typewriter_log(
306                     "SYSTEM: ", Fore.YELLOW, "Unable to execute command"
307                 )

