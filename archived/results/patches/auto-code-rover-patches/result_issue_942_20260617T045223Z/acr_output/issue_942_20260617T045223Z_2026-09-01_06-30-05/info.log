155 
156         Returns:
157             The matching deployment id if found, otherwise an empty string.
158         """
159         if model == self.fast_llm_model:
160             return self.azure_model_to_deployment_id_map[
161                 "fast_llm_model_deployment_id"
162             ]  # type: ignore
163         elif model == self.smart_llm_model:
164             return self.azure_model_to_deployment_id_map[
165                 "smart_llm_model_deployment_id"
166             ]  # type: ignore
167         elif model == "text-embedding-ada-002":
168             return self.azure_model_to_deployment_id_map[
169                 "embedding_model_deployment_id"
170             ]  # type: ignore
171         else:
172             return ""
