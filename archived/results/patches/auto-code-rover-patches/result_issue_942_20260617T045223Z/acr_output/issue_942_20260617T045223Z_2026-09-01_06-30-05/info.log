298             # Check if there's a result from the command append it to the message
299             # history
300             if result is not None:
301                 self.history.add("system", result, "action_result")
302                 logger.typewriter_log("SYSTEM: ", Fore.YELLOW, result)
303             else:
304                 self.history.add("system", "Unable to execute command", "action_result")
305                 logger.typewriter_log(
306                     "SYSTEM: ", Fore.YELLOW, "Unable to execute command"
307                 )
308 
309     def _resolve_pathlike_command_args(self, command_args):
310         if "directory" in command_args and command_args["directory"] in {"", "/"}:
311             command_args["directory"] = str(self.workspace.root)
312         else:
313             for pathlike in ["filename", "directory", "clone_path"]:
314                 if pathlike in command_args:
315                     command_args[pathlike] = str(
316                         self.workspace.get_path(command_args[pathlike])
317                     )
318         return command_args
319 
320     def get_self_feedback(self, thoughts: dict, llm_model: str) -> str:
321         """Generates a feedback response based on the provided thoughts dictionary.
322         This method takes in a dictionary of thoughts containing keys such as 'reasoning',
323         'plan', 'thoughts', and 'criticism'. It combines these elements into a single
324         feedback message and uses the create_chat_completion() function to generate a
325         response based on the input message.
326         Args:
327             thoughts (dict): A dictionary containing thought elements like reasoning,
328             plan, thoughts, and criticism.
329         Returns:
330             str: A feedback response generated using the provided thoughts dictionary.
331         """
332         ai_role = self.config.ai_role
333 
334         feedback_prompt = f"Below is a message from me, an AI Agent, assuming the role of {ai_role}. whilst keeping knowledge of my slight limitations as an AI Agent Please evaluate my thought process, reasoning, and plan, and provide a concise paragraph outlining potential improvements. Consider adding or removing ideas that do not align with my role and explaining why, prioritizing thoughts based on their significance, or simply refining my overall thought process."
335         reasoning = thoughts.get("reasoning", "")
336         plan = thoughts.get("plan", "")
337         thought = thoughts.get("thoughts", "")
338         feedback_thoughts = thought + reasoning + plan
339 
340         prompt = ChatSequence.for_model(llm_model)
341         prompt.add("user", feedback_prompt + feedback_thoughts)
342 
343         self.log_cycle_handler.log_cycle(
344             self.config.ai_name,
345             self.created_at,
346             self.cycle_count,
347             prompt.raw(),
348             PROMPT_SUPERVISOR_FEEDBACK_FILE_NAME,
349         )
350 
351         feedback = create_chat_completion(prompt)
352 
353         self.log_cycle_handler.log_cycle(
354             self.config.ai_name,
355             self.created_at,
356             self.cycle_count,
357             feedback,
358             SUPERVISOR_FEEDBACK_FILE_NAME,
359         )
360         return feedback

