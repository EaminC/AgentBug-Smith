1041     @override
1042     async def structured_output(
1043         self,
1044         output_model: type[T],
1045         prompt: Messages,
1046         system_prompt: str | None = None,
1047         **kwargs: Any,
1048     ) -> AsyncGenerator[dict[str, T | Any], None]:
1049         """Get structured output from the model.
1050 
1051         Args:
1052             output_model: The output model to use for the agent.
1053             prompt: The prompt messages to use for the agent.
1054             system_prompt: System prompt to provide context to the model.
1055             **kwargs: Additional keyword arguments for future extensibility.
1056 
1057         Yields:
1058             Model events with the last being the structured output.
1059         """
1060         tool_spec = convert_pydantic_to_tool_spec(output_model)
1061 
1062         response = self.stream(
1063             messages=prompt,
1064             tool_specs=[tool_spec],
1065             system_prompt=system_prompt,
1066             tool_choice=cast(ToolChoice, {"any": {}}),
1067             **kwargs,
1068         )
1069         async for event in streaming.process_stream(response):
1070             yield event
1071 
1072         stop_reason, messages, _, _ = event["stop"]
1073 
1074         if stop_reason != "tool_use":
1075             raise ValueError(f'Model returned stop_reason: {stop_reason} instead of "tool_use".')
1076 
1077         content = messages["content"]
1078         output_response: dict[str, Any] | None = None
1079         for block in content:
1080             # if the tool use name doesn't match the tool spec name, skip, and if the block is not a tool use, skip.
1081             # if the tool use name never matches, raise an error.
1082             if block.get("toolUse") and block["toolUse"]["name"] == tool_spec["name"]:
1083                 output_response = block["toolUse"]["input"]
1084             else:
1085                 continue
1086 
1087         if output_response is None:
1088             raise ValueError("No valid tool use or tool use input was found in the Bedrock response.")
1089 
1090         yield {"output": output_model(**output_response)}
