1238     def cmd_copy(self, args):
1239         "Copy the last assistant message to the clipboard"
1240         all_messages = self.coder.done_messages + self.coder.cur_messages
1241         assistant_messages = [msg for msg in reversed(all_messages) if msg["role"] == "assistant"]
1242 
1243         if not assistant_messages:
1244             self.io.tool_error("No assistant messages found to copy.")
1245             return
1246 
1247         last_assistant_message = assistant_messages[0]["content"]
1248 
1249         try:
1250             pyperclip.copy(last_assistant_message)
1251             preview = (
1252                 last_assistant_message[:50] + "..."
1253                 if len(last_assistant_message) > 50
1254                 else last_assistant_message
1255             )
1256             self.io.tool_output(f"Copied last assistant message to clipboard. Preview: {preview}")
1257         except pyperclip.PyperclipException as e:
1258             self.io.tool_error(f"Failed to copy to clipboard: {str(e)}")
1259             self.io.tool_output(
1260                 "You may need to install xclip or xsel on Linux, or pbcopy on macOS."
1261             )
1262         except Exception as e:
