341 
342         self.coder.choose_fence()
343 
344         # system messages
345         main_sys = self.coder.fmt_system_prompt(self.coder.gpt_prompts.main_system)
346         main_sys += "\n" + self.coder.fmt_system_prompt(self.coder.gpt_prompts.system_reminder)
347         msgs = [
348             dict(role="system", content=main_sys),
349             dict(
350                 role="system",
351                 content=self.coder.fmt_system_prompt(self.coder.gpt_prompts.system_reminder),
352             ),
353         ]
354 
355         tokens = self.coder.main_model.token_count(msgs)
356         res.append((tokens, "system messages", ""))
357 
358         # chat history
359         msgs = self.coder.done_messages + self.coder.cur_messages
360         if msgs:
361             tokens = self.coder.main_model.token_count(msgs)
362             res.append((tokens, "chat history", "use /clear to clear"))
363 
364         # repo map
365         other_files = set(self.coder.get_all_abs_files()) - set(self.coder.abs_fnames)
366         if self.coder.repo_map:
367             repo_content = self.coder.repo_map.get_repo_map(self.coder.abs_fnames, other_files)
368             if repo_content:
369                 tokens = self.coder.main_model.token_count(repo_content)
370                 res.append((tokens, "repository map", "use --map-tokens to resize"))
371 
372         fence = "`" * 3
373 
374         # files
375         for fname in self.coder.abs_fnames:
376             relative_fname = self.coder.get_rel_fname(fname)
377             content = self.io.read_text(fname)
378             if is_image_file(relative_fname):
379                 tokens = self.coder.main_model.token_count_for_image(fname)
380             else:
381                 # approximate
382                 content = f"{relative_fname}\n{fence}\n" + content + "{fence}\n"
383                 tokens = self.coder.main_model.token_count(content)
384             res.append((tokens, f"{relative_fname}", "/drop to remove"))
385 
386         # read-only files
387         for fname in self.coder.abs_read_only_fnames:
388             relative_fname = self.coder.get_rel_fname(fname)
389             content = self.io.read_text(fname)
390             if content is not None and not is_image_file(relative_fname):
391                 # approximate
392                 content = f"{relative_fname}\n{fence}\n" + content + "{fence}\n"
393                 tokens = self.coder.main_model.token_count(content)
394                 res.append((tokens, f"{relative_fname} (read-only)", "/drop to remove"))
395 
396         self.io.tool_output(
397             f"Approximate context window usage for {self.coder.main_model.name}, in tokens:"
398         )
399         self.io.tool_output()
400 
401         width = 8
402         cost_width = 9
403 
404         def fmt(v):
405             return format(int(v), ",").rjust(width)
406 
407         col_width = max(len(row[1]) for row in res)
408 
409         cost_pad = " " * cost_width
410         total = 0
411         total_cost = 0.0
412         for tk, msg, tip in res:
413             total += tk
414             cost = tk * (self.coder.main_model.info.get("input_cost_per_token") or 0)
415             total_cost += cost
416             msg = msg.ljust(col_width)
417             self.io.tool_output(f"${cost:7.4f} {fmt(tk)} {msg} {tip}")  # noqa: E231
418 
419         self.io.tool_output("=" * (width + cost_width + 1))
420         self.io.tool_output(f"${total_cost:7.4f} {fmt(total)} tokens total")  # noqa: E231
421 
422         limit = self.coder.main_model.info.get("max_input_tokens") or 0
423         if not limit:
424             return
425 
426         remaining = limit - total
427         if remaining > 1024:
428             self.io.tool_output(f"{cost_pad}{fmt(remaining)} tokens remaining in context window")
429         elif remaining > 0:
430             self.io.tool_error(
431                 f"{cost_pad}{fmt(remaining)} tokens remaining in context window (use /drop or"
432                 " /clear to make space)"
433             )
434         else:
435             self.io.tool_error(
436                 f"{cost_pad}{fmt(remaining)} tokens remaining, window exhausted (use /drop or"
437                 " /clear to make space)"
438             )
439         self.io.tool_output(f"{cost_pad}{fmt(limit)} tokens max context window size")
440 
441     def cmd_undo(self, args):
442         "Undo the last git commit if it was done by aider"
443         try:
444             self.raw_cmd_undo(args)
445         except ANY_GIT_ERROR as err:
446             self.io.tool_error(f"Unable to complete undo: {err}")
447 
448     def raw_cmd_undo(self, args):
449         if not self.coder.repo:
450             self.io.tool_error("No git repository found.")
451             return
452 
453         last_commit = self.coder.repo.get_head_commit()
454         if not last_commit or not last_commit.parents:
455             self.io.tool_error("This is the first commit in the repository. Cannot undo.")
456             return
457 
458         last_commit_hash = self.coder.repo.get_head_commit_sha(short=True)
459         last_commit_message = self.coder.repo.get_head_commit_message("(unknown)").strip()
460         if last_commit_hash not in self.coder.aider_commit_hashes:
461             self.io.tool_error("The last commit was not made by aider in this chat session.")
462             self.io.tool_output(
463                 "You could try `/git reset --hard HEAD^` but be aware that this is a destructive"
464                 " command!"
465             )
466             return
467 
468         if len(last_commit.parents) > 1:
469             self.io.tool_error(
470                 f"The last commit {last_commit.hexsha} has more than 1 parent, can't undo."
471             )
472             return
473 
474         prev_commit = last_commit.parents[0]
475         changed_files_last_commit = [item.a_path for item in last_commit.diff(prev_commit)]
476 
477         for fname in changed_files_last_commit:
478             if self.coder.repo.repo.is_dirty(path=fname):
479                 self.io.tool_error(
480                     f"The file {fname} has uncommitted changes. Please stash them before undoing."
481                 )
482                 return
483 
484             # Check if the file was in the repo in the previous commit
485             try:
486                 prev_commit.tree[fname]
487             except KeyError:
488                 self.io.tool_error(
489                     f"The file {fname} was not in the repository in the previous commit. Cannot"
490                     " undo safely."
491                 )
492                 return
493 
494         local_head = self.coder.repo.repo.git.rev_parse("HEAD")
495         current_branch = self.coder.repo.repo.active_branch.name
496         try:
497             remote_head = self.coder.repo.repo.git.rev_parse(f"origin/{current_branch}")
498             has_origin = True
499         except ANY_GIT_ERROR:
500             has_origin = False
501 
502         if has_origin:
503             if local_head == remote_head:
504                 self.io.tool_error(
505                     "The last commit has already been pushed to the origin. Undoing is not"
506                     " possible."
507                 )
508                 return
509 
510         # Reset only the files which are part of `last_commit`
511         restored = set()
512         unrestored = set()
513         for file_path in changed_files_last_commit:
514             try:
515                 self.coder.repo.repo.git.checkout("HEAD~1", file_path)
516                 restored.add(file_path)
517             except ANY_GIT_ERROR:
518                 unrestored.add(file_path)
519 
520         if unrestored:
521             self.io.tool_error(f"Error restoring {file_path}, aborting undo.")
522             self.io.tool_output("Restored files:")
523             for file in restored:
524                 self.io.tool_output(f"  {file}")
525             self.io.tool_output("Unable to restore files:")
526             for file in unrestored:
527                 self.io.tool_output(f"  {file}")
528             return
529 
530         # Move the HEAD back before the latest commit
531         self.coder.repo.repo.git.reset("--soft", "HEAD~1")
532 
533         self.io.tool_output(f"Removed: {last_commit_hash} {last_commit_message}")
534 
535         # Get the current HEAD after undo
536         current_head_hash = self.coder.repo.get_head_commit_sha(short=True)
537         current_head_message = self.coder.repo.get_head_commit_message("(unknown)").strip()
538         self.io.tool_output(f"Now at:  {current_head_hash} {current_head_message}")
539 
540         if self.coder.main_model.send_undo_reply:
541             return prompts.undo_command_reply
542 
543     def cmd_diff(self, args=""):
