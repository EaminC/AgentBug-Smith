584     def completions_raw_read_only(self, document, complete_event):
585         # Get the text before the cursor
586         text = document.text_before_cursor
587 
588         # Skip the first word and the space after it
589         after_command = text.split()[-1]
590 
591         # Create a new Document object with the text after the command
592         new_document = Document(after_command, cursor_position=len(after_command))
593 
594         def get_paths():
595             return [self.coder.root] if self.coder.root else None
596 
597         path_completer = PathCompleter(
598             get_paths=get_paths,
599             only_directories=False,
600             expanduser=True,
601         )
602 
603         # Adjust the start_position to replace all of 'after_command'
604         adjusted_start_position = -len(after_command)
605 
606         # Collect all completions
607         all_completions = []
608 
609         # Iterate over the completions and modify them
610         for completion in path_completer.get_completions(new_document, complete_event):
611             quoted_text = self.quote_fname(after_command + completion.text)
612             all_completions.append(
613                 Completion(
614                     text=quoted_text,
615                     start_position=adjusted_start_position,
616                     display=completion.display,
617                     style=completion.style,
618                     selected_style=completion.selected_style,
619                 )
620             )
621 
622         # Add completions from the 'add' command
623         add_completions = self.completions_add()
624         for completion in add_completions:
625             if after_command in completion:
626                 all_completions.append(
627                     Completion(
628                         text=completion,
629                         start_position=adjusted_start_position,
630                         display=completion,
631                     )
632                 )
633 
634         # Sort all completions based on their text
635         sorted_completions = sorted(all_completions, key=lambda c: c.text)
636 
637         # Yield the sorted completions
638         for completion in sorted_completions:
639             yield completion
640 
641     def completions_add(self):
642         files = set(self.coder.get_all_relative_files())
643         files = files - set(self.coder.get_inchat_relative_files())
644         files = [self.quote_fname(fn) for fn in files]
645         return files
646 
647     def glob_filtered_to_repo(self, pattern):
648         if not pattern.strip():
649             return []
650         try:
651             if os.path.isabs(pattern):
652                 # Handle absolute paths
653                 raw_matched_files = [Path(pattern)]
654             else:
655                 try:
656                     raw_matched_files = list(Path(self.coder.root).glob(pattern))
657                 except (IndexError, AttributeError):
658                     raw_matched_files = []
659         except ValueError as err:
660             self.io.tool_error(f"Error matching {pattern}: {err}")
661             raw_matched_files = []
662 
663         matched_files = []
664         for fn in raw_matched_files:
665             matched_files += expand_subdir(fn)
666 
667         matched_files = [
668             fn.relative_to(self.coder.root)
669             for fn in matched_files
670             if fn.is_relative_to(self.coder.root)
671         ]
672 
673         # if repo, filter against it
674         if self.coder.repo:
675             git_files = self.coder.repo.get_tracked_files()
676             matched_files = [fn for fn in matched_files if str(fn) in git_files]
677 
678         res = list(map(str, matched_files))
679         return res
680 
681     def cmd_add(self, args):
682         "Add files to the chat so aider can edit them or review them in detail"
683 
684         all_matched_files = set()
685 
686         filenames = parse_quoted_filenames(args)
687         for word in filenames:
688             if Path(word).is_absolute():
689                 fname = Path(word)
690             else:
691                 fname = Path(self.coder.root) / word
692 
693             if self.coder.repo and self.coder.repo.ignored_file(fname):
694                 self.io.tool_warning(f"Skipping {fname} due to aiderignore or --subtree-only.")
695                 continue
696 
697             if fname.exists():
698                 if fname.is_file():
699                     all_matched_files.add(str(fname))
700                     continue
701                 # an existing dir, escape any special chars so they won't be globs
702                 word = re.sub(r"([\*\?\[\]])", r"[\1]", word)
703 
704             matched_files = self.glob_filtered_to_repo(word)
705             if matched_files:
706                 all_matched_files.update(matched_files)
707                 continue
708 
709             if "*" in str(fname) or "?" in str(fname):
710                 self.io.tool_error(
711                     f"No match, and cannot create file with wildcard characters: {fname}"
712                 )
713                 continue
714 
715             if fname.exists() and fname.is_dir() and self.coder.repo:
716                 self.io.tool_error(f"Directory {fname} is not in git.")
717                 self.io.tool_output(f"You can add to git with: /git add {fname}")
718                 continue
719 
720             if self.io.confirm_ask(f"No files matched '{word}'. Do you want to create {fname}?"):
721                 try:
722                     fname.touch()
723                     all_matched_files.add(str(fname))
724                 except OSError as e:
725                     self.io.tool_error(f"Error creating file {fname}: {e}")
726 
727         for matched_file in all_matched_files:
728             abs_file_path = self.coder.abs_root_path(matched_file)
729 
730             if not abs_file_path.startswith(self.coder.root) and not is_image_file(matched_file):
731                 self.io.tool_error(
732                     f"Can not add {abs_file_path}, which is not within {self.coder.root}"
733                 )
734                 continue
735 
736             if abs_file_path in self.coder.abs_fnames:
737                 self.io.tool_error(f"{matched_file} is already in the chat as an editable file")
738                 continue
739             elif abs_file_path in self.coder.abs_read_only_fnames:
740                 if self.coder.repo and self.coder.repo.path_in_repo(matched_file):
741                     self.coder.abs_read_only_fnames.remove(abs_file_path)
742                     self.coder.abs_fnames.add(abs_file_path)
743                     self.io.tool_output(
744                         f"Moved {matched_file} from read-only to editable files in the chat"
745                     )
746                 else:
747                     self.io.tool_error(
748                         f"Cannot add {matched_file} as it's not part of the repository"
749                     )
750             else:
751                 if is_image_file(matched_file) and not self.coder.main_model.accepts_images:
752                     self.io.tool_error(
753                         f"Cannot add image file {matched_file} as the"
754                         f" {self.coder.main_model.name} does not support images."
755                     )
756                     continue
757                 content = self.io.read_text(abs_file_path)
758                 if content is None:
759                     self.io.tool_error(f"Unable to read {matched_file}")
760                 else:
761                     self.coder.abs_fnames.add(abs_file_path)
762                     self.io.tool_output(f"Added {matched_file} to the chat")
763                     self.coder.check_added_files()
764 
765     def completions_drop(self):
766         files = self.coder.get_inchat_relative_files()
767         read_only_files = [self.coder.get_rel_fname(fn) for fn in self.coder.abs_read_only_fnames]
768         all_files = files + read_only_files
769         all_files = [self.quote_fname(fn) for fn in all_files]
770         return all_files
