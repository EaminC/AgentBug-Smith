263     def cmd_lint(self, args="", fnames=None):
264         "Lint and fix in-chat files or all dirty files if none in chat"
265 
266         if not self.coder.repo:
267             self.io.tool_error("No git repository found.")
268             return
269 
270         if not fnames:
271             fnames = self.coder.get_inchat_relative_files()
272 
273         # If still no files, get all dirty files in the repo
274         if not fnames and self.coder.repo:
275             fnames = self.coder.repo.get_dirty_files()
276 
277         if not fnames:
278             self.io.tool_warning("No dirty files to lint.")
279             return
280 
281         fnames = [self.coder.abs_root_path(fname) for fname in fnames]
282 
283         lint_coder = None
284         for fname in fnames:
285             try:
286                 errors = self.coder.linter.lint(fname)
287             except FileNotFoundError as err:
288                 self.io.tool_error(f"Unable to lint {fname}")
289                 self.io.tool_output(str(err))
290                 continue
291 
292             if not errors:
293                 continue
294 
295             self.io.tool_output(errors)
296             if not self.io.confirm_ask(f"Fix lint errors in {fname}?", default="y"):
297                 continue
298 
299             # Commit everything before we start fixing lint errors
300             if self.coder.repo.is_dirty() and self.coder.dirty_commits:
301                 self.cmd_commit("")
302 
303             if not lint_coder:
304                 lint_coder = self.coder.clone(
305                     # Clear the chat history, fnames
306                     cur_messages=[],
307                     done_messages=[],
308                     fnames=None,
309                 )
310 
311             lint_coder.add_rel_fname(fname)
312             lint_coder.run(errors)
313             lint_coder.abs_fnames = set()
314 
315         if lint_coder and self.coder.repo.is_dirty() and self.coder.auto_commits:
316             self.cmd_commit("")
