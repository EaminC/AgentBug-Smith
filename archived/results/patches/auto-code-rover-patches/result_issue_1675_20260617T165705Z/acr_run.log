1159     def cmd_read_only(self, args):
1160         "Add files to the chat that are for reference, not to be edited"
1161         if not args.strip():
1162             self.io.tool_error("Please provide filenames or directories to read.")
1163             return
1164 
1165         filenames = parse_quoted_filenames(args)
1166         for pattern in filenames:
1167             # Expand tilde for home directory
1168             expanded_pattern = expanduser(pattern)
1169 
1170             expanded_paths = glob.glob(expanded_pattern, recursive=True)
1171             if not expanded_paths:
1172                 self.io.tool_error(f"No matches found for: {pattern}")
1173                 continue
1174 
1175             for path in expanded_paths:
1176                 abs_path = self.coder.abs_root_path(path)
1177                 if os.path.isfile(abs_path):
1178                     self._add_read_only_file(abs_path, path)
1179                 elif os.path.isdir(abs_path):
1180                     self._add_read_only_directory(abs_path, path)
1181                 else:
1182                     self.io.tool_error(f"Not a file or directory: {abs_path}")
1183 
1184     def _add_read_only_file(self, abs_path, original_name):
1185         if abs_path in self.coder.abs_read_only_fnames:
1186             self.io.tool_error(f"{original_name} is already in the chat as a read-only file")
1187             return
1188         elif abs_path in self.coder.abs_fnames:
1189             self.coder.abs_fnames.remove(abs_path)
1190             self.coder.abs_read_only_fnames.add(abs_path)
1191             self.io.tool_output(
1192                 f"Moved {original_name} from editable to read-only files in the chat"
1193             )
1194         else:
1195             self.coder.abs_read_only_fnames.add(abs_path)
1196             self.io.tool_output(f"Added {original_name} to read-only files.")
1197 
1198     def _add_read_only_directory(self, abs_path, original_name):
1199         added_files = 0
1200         for root, _, files in os.walk(abs_path):
1201             for file in files:
1202                 file_path = os.path.join(root, file)
1203                 if (
1204                     file_path not in self.coder.abs_fnames
1205                     and file_path not in self.coder.abs_read_only_fnames
1206                 ):
1207                     self.coder.abs_read_only_fnames.add(file_path)
1208                     added_files += 1
1209 
1210         if added_files > 0:
1211             self.io.tool_output(
1212                 f"Added {added_files} files from directory {original_name} to read-only files."
1213             )
1214         else:
1215             self.io.tool_output(f"No new files added from directory {original_name}.")
1216 
