941     def basic_help(self):
942         commands = sorted(self.get_commands())
943         pad = max(len(cmd) for cmd in commands)
944         pad = "{cmd:" + str(pad) + "}"
945         for cmd in commands:
946             cmd_method_name = f"cmd_{cmd[1:]}".replace("-", "_")
947             cmd_method = getattr(self, cmd_method_name, None)
948             cmd = pad.format(cmd=cmd)
949             if cmd_method:
950                 description = cmd_method.__doc__
951                 self.io.tool_output(f"{cmd} {description}")
952             else:
953                 self.io.tool_output(f"{cmd} No description available.")
954         self.io.tool_output()
955         self.io.tool_output("Use `/help <question>` to ask questions about how to use aider.")
956 
957     def cmd_help(self, args):
958         "Ask questions about aider"
959 
960         if not args.strip():
961             self.basic_help()
962             return
963 
964         from aider.coders import Coder
965 
966         if not self.help:
967             res = install_help_extra(self.io)
968             if not res:
969                 self.io.tool_error("Unable to initialize interactive help.")
970                 return
971 
972             self.help = Help()
973 
974         coder = Coder.create(
975             io=self.io,
976             from_coder=self.coder,
977             edit_format="help",
978             summarize_from_coder=False,
979             map_tokens=512,
980             map_mul_no_files=1,
981         )
982         user_msg = self.help.ask(args)
983         user_msg += """
984 # Announcement lines from when this session of aider was launched:
985 
986 """
987         user_msg += "\n".join(self.coder.get_announcements()) + "\n"
988 
989         coder.run(user_msg, preproc=False)
990 
991         if self.coder.repo_map:
992             map_tokens = self.coder.repo_map.max_map_tokens
993             map_mul_no_files = self.coder.repo_map.map_mul_no_files
994         else:
995             map_tokens = 0
996             map_mul_no_files = 1
997 
998         raise SwitchCoder(
999             edit_format=self.coder.edit_format,
1000             summarize_from_coder=False,
1001             from_coder=coder,
1002             map_tokens=map_tokens,
1003             map_mul_no_files=map_mul_no_files,
1004             show_announcements=False,
1005         )
