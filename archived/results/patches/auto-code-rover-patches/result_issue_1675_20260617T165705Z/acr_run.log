167     def is_command(self, inp):
168         return inp[0] in "/!"
169 
170     def get_raw_completions(self, cmd):
171         assert cmd.startswith("/")
172         cmd = cmd[1:]
173         cmd = cmd.replace("-", "_")
174 
175         raw_completer = getattr(self, f"completions_raw_{cmd}", None)
176         return raw_completer
177 
178     def get_completions(self, cmd):
179         assert cmd.startswith("/")
180         cmd = cmd[1:]
181 
182         cmd = cmd.replace("-", "_")
183         fun = getattr(self, f"completions_{cmd}", None)
184         if not fun:
185             return
186         return sorted(fun())
187 
188     def get_commands(self):
189         commands = []
190         for attr in dir(self):
191             if not attr.startswith("cmd_"):
192                 continue
193             cmd = attr[4:]
194             cmd = cmd.replace("_", "-")
195             commands.append("/" + cmd)
196 
197         return commands
198 
199     def do_run(self, cmd_name, args):
200         cmd_name = cmd_name.replace("-", "_")
201         cmd_method_name = f"cmd_{cmd_name}"
202         cmd_method = getattr(self, cmd_method_name, None)
203         if not cmd_method:
204             self.io.tool_output(f"Error: Command {cmd_name} not found.")
205             return
206 
207         try:
208             return cmd_method(args)
209         except ANY_GIT_ERROR as err:
210             self.io.tool_error(f"Unable to complete {cmd_name}: {err}")
211 
212     def matching_commands(self, inp):
213         words = inp.strip().split()
214         if not words:
215             return
216 
217         first_word = words[0]
218         rest_inp = inp[len(words[0]) :].strip()
219 
220         all_commands = self.get_commands()
221         matching_commands = [cmd for cmd in all_commands if cmd.startswith(first_word)]
222         return matching_commands, first_word, rest_inp
223 
224     def run(self, inp):
225         if inp.startswith("!"):
226             return self.do_run("run", inp[1:])
227 
228         res = self.matching_commands(inp)
229         if res is None:
230             return
231         matching_commands, first_word, rest_inp = res
232         if len(matching_commands) == 1:
233             return self.do_run(matching_commands[0][1:], rest_inp)
234         elif first_word in matching_commands:
235             return self.do_run(first_word[1:], rest_inp)
236         elif len(matching_commands) > 1:
237             self.io.tool_error(f"Ambiguous command: {', '.join(matching_commands)}")
238         else:
239             self.io.tool_error(f"Invalid command: {first_word}")
240 
241     # any method called cmd_xxx becomes a command automatically.
242     # each one must take an args param.
243 
244     def cmd_commit(self, args=None):
245         "Commit edits to the repo made outside the chat (commit message optional)"
246         try:
247             self.raw_cmd_commit(args)
248         except ANY_GIT_ERROR as err:
249             self.io.tool_error(f"Unable to complete commit: {err}")
250 
251     def raw_cmd_commit(self, args=None):
252         if not self.coder.repo:
253             self.io.tool_error("No git repository found.")
254             return
255 
256         if not self.coder.repo.is_dirty():
257             self.io.tool_warning("No more changes to commit.")
258             return
259 
260         commit_message = args.strip() if args else None
261         self.coder.repo.commit(message=commit_message)
262 
263     def cmd_lint(self, args="", fnames=None):
264         "Lint and fix in-chat files or all dirty files if none in chat"
265 
266         if not self.coder.repo:
267             self.io.tool_error("No git repository found.")
268             return
269 
270         if not fnames:
271             fnames = self.coder.get_inchat_relative_files()
272 
273         # If still no files, get all dirty files in the repo
274         if not fnames and self.coder.repo:
275             fnames = self.coder.repo.get_dirty_files()
276 
277         if not fnames:
278             self.io.tool_warning("No dirty files to lint.")
279             return
280 
281         fnames = [self.coder.abs_root_path(fname) for fname in fnames]
282 
283         lint_coder = None
284         for fname in fnames:
285             try:
286                 errors = self.coder.linter.lint(fname)
287             except FileNotFoundError as err:
288                 self.io.tool_error(f"Unable to lint {fname}")
289                 self.io.tool_output(str(err))
290                 continue
291 
292             if not errors:
293                 continue
294 
295             self.io.tool_output(errors)
296             if not self.io.confirm_ask(f"Fix lint errors in {fname}?", default="y"):
297                 continue
298 
299             # Commit everything before we start fixing lint errors
300             if self.coder.repo.is_dirty() and self.coder.dirty_commits:
301                 self.cmd_commit("")
302 
303             if not lint_coder:
304                 lint_coder = self.coder.clone(
305                     # Clear the chat history, fnames
306                     cur_messages=[],
307                     done_messages=[],
308                     fnames=None,
309                 )
310 
311             lint_coder.add_rel_fname(fname)
312             lint_coder.run(errors)
313             lint_coder.abs_fnames = set()
314 
315         if lint_coder and self.coder.repo.is_dirty() and self.coder.auto_commits:
316             self.cmd_commit("")
317 
