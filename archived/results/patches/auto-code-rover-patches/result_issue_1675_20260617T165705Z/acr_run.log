902     def cmd_ls(self, args):
903         "List all known files and indicate which are included in the chat session"
904 
905         files = self.coder.get_all_relative_files()
906 
907         other_files = []
908         chat_files = []
909         read_only_files = []
910         for file in files:
911             abs_file_path = self.coder.abs_root_path(file)
912             if abs_file_path in self.coder.abs_fnames:
913                 chat_files.append(file)
914             else:
915                 other_files.append(file)
916 
917         # Add read-only files
918         for abs_file_path in self.coder.abs_read_only_fnames:
919             rel_file_path = self.coder.get_rel_fname(abs_file_path)
920             read_only_files.append(rel_file_path)
921 
922         if not chat_files and not other_files and not read_only_files:
923             self.io.tool_output("\nNo files in chat, git repo, or read-only list.")
924             return
925 
926         if other_files:
927             self.io.tool_output("Repo files not in the chat:\n")
928         for file in other_files:
929             self.io.tool_output(f"  {file}")
930 
931         if read_only_files:
932             self.io.tool_output("\nRead-only files:\n")
933         for file in read_only_files:
934             self.io.tool_output(f"  {file}")
935 
936         if chat_files:
937             self.io.tool_output("\nFiles in chat:\n")
938         for file in chat_files:
939             self.io.tool_output(f"  {file}")
940 
941     def basic_help(self):
942         commands = sorted(self.get_commands())
943         pad = max(len(cmd) for cmd in commands)
944         pad = "{cmd:" + str(pad) + "}"
945         for cmd in commands:
946             cmd_method_name = f"cmd_{cmd[1:]}".replace("-", "_")
947             cmd_method = getattr(self, cmd_method_name, None)
948             cmd = pad.format(cmd=cmd)
949             if cmd_method:
950                 description = cmd_method.__doc__
951                 self.io.tool_output(f"{cmd} {description}")
952             else:
953                 self.io.tool_output(f"{cmd} No description available.")
954         self.io.tool_output()
955         self.io.tool_output("Use `/help <question>` to ask questions about how to use aider.")
956 
957     def cmd_help(self, args):
