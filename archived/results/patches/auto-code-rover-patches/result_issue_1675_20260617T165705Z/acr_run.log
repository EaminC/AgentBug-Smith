1063     def cmd_voice(self, args):
1064         "Record and transcribe voice input"
1065 
1066         if not self.voice:
1067             if "OPENAI_API_KEY" not in os.environ:
1068                 self.io.tool_error("To use /voice you must provide an OpenAI API key.")
1069                 return
1070             try:
1071                 self.voice = voice.Voice(audio_format=self.args.voice_format)
1072             except voice.SoundDeviceError:
1073                 self.io.tool_error(
1074                     "Unable to import `sounddevice` and/or `soundfile`, is portaudio installed?"
1075                 )
1076                 return
1077 
1078         history_iter = self.io.get_input_history()
1079 
1080         history = []
1081         size = 0
1082         for line in history_iter:
1083             if line.startswith("/"):
1084                 continue
1085             if line in history:
1086                 continue
1087             if size + len(line) > 1024:
1088                 break
1089             size += len(line)
1090             history.append(line)
1091 
1092         history.reverse()
1093         history = "\n".join(history)
1094 
1095         try:
1096             text = self.voice.record_and_transcribe(history, language=self.voice_language)
1097         except litellm.OpenAIError as err:
1098             self.io.tool_error(f"Unable to use OpenAI whisper model: {err}")
1099             return
1100 
1101         if text:
1102             self.io.add_to_input_history(text)
1103             self.io.print()
1104             self.io.user_input(text, log_only=False)
1105             self.io.print()
1106 
1107         return text
