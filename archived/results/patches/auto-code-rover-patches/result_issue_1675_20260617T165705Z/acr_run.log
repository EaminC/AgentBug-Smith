850     def cmd_run(self, args, add_on_nonzero_exit=False):
851         "Run a shell command and optionally add the output to the chat (alias: !)"
852         exit_status, combined_output = run_cmd(
853             args, verbose=self.verbose, error_print=self.io.tool_error
854         )
855         instructions = None
856 
857         if combined_output is None:
858             return
859 
860         if add_on_nonzero_exit:
861             add = exit_status != 0
862         else:
863             self.io.tool_output()
864             response = self.io.prompt_ask(
865                 "Add the output to the chat?\n(Y)es/(n)o/message with instructions:",
866             ).strip()
867             self.io.tool_output()
868 
869             if response.lower() in ["yes", "y"]:
870                 add = True
871             elif response.lower() in ["no", "n"]:
872                 add = False
873             else:
874                 add = True
875                 instructions = response
876                 if response.strip():
877                     self.io.user_input(response, log_only=True)
878                     self.io.add_to_input_history(response)
879 
880         if add:
881             for line in combined_output.splitlines():
882                 self.io.tool_output(line, log_only=True)
883 
884             msg = prompts.run_output.format(
885                 command=args,
886                 output=combined_output,
887             )
888 
889             if instructions:
890                 msg = instructions + "\n\n" + msg
891 
892             return msg
893 
