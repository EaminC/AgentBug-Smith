1063     def cmd_voice(self, args):
1064         "Record and transcribe voice input"
1065 
1066         if not self.voice:
1067             if "OPENAI_API_KEY" not in os.environ:
1068                 self.io.tool_error("To use /voice you must provide an OpenAI API key.")
1069                 return
1070             try:
1071                 self.voice = voice.Voice(audio_format=self.args.voice_format)
1072             except voice.SoundDeviceError:
1073                 self.io.tool_error(
1074                     "Unable to import `sounddevice` and/or `soundfile`, is portaudio installed?"
1075                 )
1076                 return
1077 
1078         history_iter = self.io.get_input_history()
1079 
1080         history = []
1081         size = 0
1082         for line in history_iter:
1083             if line.startswith("/"):
1084                 continue
1085             if line in history:
1086                 continue
1087             if size + len(line) > 1024:
1088                 break
1089             size += len(line)
1090             history.append(line)
1091 
1092         history.reverse()
1093         history = "\n".join(history)
1094 
1095         try:
1096             text = self.voice.record_and_transcribe(history, language=self.voice_language)
1097         except litellm.OpenAIError as err:
1098             self.io.tool_error(f"Unable to use OpenAI whisper model: {err}")
1099             return
1100 
1101         if text:
1102             self.io.add_to_input_history(text)
1103             self.io.print()
1104             self.io.user_input(text, log_only=False)
1105             self.io.print()
1106 
1107         return text
1108 
1109     def cmd_paste(self, args):
1110         """Paste image/text from the clipboard into the chat.\
1111         Optionally provide a name for the image."""
1112         try:
1113             # Check for image first
1114             image = ImageGrab.grabclipboard()
1115             if isinstance(image, Image.Image):
1116                 if args.strip():
1117                     filename = args.strip()
1118                     ext = os.path.splitext(filename)[1].lower()
1119                     if ext in (".jpg", ".jpeg", ".png"):
1120                         basename = filename
1121                     else:
1122                         basename = f"{filename}.png"
1123                 else:
1124                     basename = "clipboard_image.png"
1125 
1126                 temp_dir = tempfile.mkdtemp()
1127                 temp_file_path = os.path.join(temp_dir, basename)
1128                 image_format = "PNG" if basename.lower().endswith(".png") else "JPEG"
1129                 image.save(temp_file_path, image_format)
1130 
1131                 abs_file_path = Path(temp_file_path).resolve()
1132 
1133                 # Check if a file with the same name already exists in the chat
1134                 existing_file = next(
1135                     (f for f in self.coder.abs_fnames if Path(f).name == abs_file_path.name), None
1136                 )
1137                 if existing_file:
1138                     self.coder.abs_fnames.remove(existing_file)
1139                     self.io.tool_output(f"Replaced existing image in the chat: {existing_file}")
1140 
1141                 self.coder.abs_fnames.add(str(abs_file_path))
1142                 self.io.tool_output(f"Added clipboard image to the chat: {abs_file_path}")
1143                 self.coder.check_added_files()
1144 
1145                 return
1146 
1147             # If not an image, try to get text
1148             text = pyperclip.paste()
1149             if text:
1150                 self.io.tool_output(text)
1151                 return text
1152 
1153             self.io.tool_error("No image or text content found in clipboard.")
1154             return
1155 
1156         except Exception as e:
1157             self.io.tool_error(f"Error processing clipboard content: {e}")
1158 
1159     def cmd_read_only(self, args):
1160         "Add files to the chat that are for reference, not to be edited"
1161         if not args.strip():
1162             self.io.tool_error("Please provide filenames or directories to read.")
1163             return
1164 
1165         filenames = parse_quoted_filenames(args)
1166         for pattern in filenames:
1167             # Expand tilde for home directory
1168             expanded_pattern = expanduser(pattern)
1169 
1170             expanded_paths = glob.glob(expanded_pattern, recursive=True)
1171             if not expanded_paths:
1172                 self.io.tool_error(f"No matches found for: {pattern}")
1173                 continue
1174 
1175             for path in expanded_paths:
1176                 abs_path = self.coder.abs_root_path(path)
1177                 if os.path.isfile(abs_path):
1178                     self._add_read_only_file(abs_path, path)
1179                 elif os.path.isdir(abs_path):
1180                     self._add_read_only_directory(abs_path, path)
1181                 else:
1182                     self.io.tool_error(f"Not a file or directory: {abs_path}")
1183 
1184     def _add_read_only_file(self, abs_path, original_name):
1185         if abs_path in self.coder.abs_read_only_fnames:
1186             self.io.tool_error(f"{original_name} is already in the chat as a read-only file")
1187             return
1188         elif abs_path in self.coder.abs_fnames:
1189             self.coder.abs_fnames.remove(abs_path)
1190             self.coder.abs_read_only_fnames.add(abs_path)
1191             self.io.tool_output(
1192                 f"Moved {original_name} from editable to read-only files in the chat"
1193             )
1194         else:
1195             self.coder.abs_read_only_fnames.add(abs_path)
1196             self.io.tool_output(f"Added {original_name} to read-only files.")
1197 
1198     def _add_read_only_directory(self, abs_path, original_name):
1199         added_files = 0
1200         for root, _, files in os.walk(abs_path):
1201             for file in files:
1202                 file_path = os.path.join(root, file)
1203                 if (
1204                     file_path not in self.coder.abs_fnames
1205                     and file_path not in self.coder.abs_read_only_fnames
1206                 ):
1207                     self.coder.abs_read_only_fnames.add(file_path)
1208                     added_files += 1
1209 
1210         if added_files > 0:
1211             self.io.tool_output(
1212                 f"Added {added_files} files from directory {original_name} to read-only files."
1213             )
1214         else:
1215             self.io.tool_output(f"No new files added from directory {original_name}.")
1216 
