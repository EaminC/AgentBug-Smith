1043     def get_help_md(self):
1044         "Show help about all commands in markdown"
1045 
1046         res = """
1047 |Command|Description|
1048 |:------|:----------|
1049 """
1050         commands = sorted(self.get_commands())
1051         for cmd in commands:
1052             cmd_method_name = f"cmd_{cmd[1:]}".replace("-", "_")
1053             cmd_method = getattr(self, cmd_method_name, None)
1054             if cmd_method:
1055                 description = cmd_method.__doc__
1056                 res += f"| **{cmd}** | {description} |\n"
1057             else:
1058                 res += f"| **{cmd}** | |\n"
1059 
1060         res += "\n"
1061         return res
