212     def matching_commands(self, inp):
213         words = inp.strip().split()
214         if not words:
215             return
216 
217         first_word = words[0]
218         rest_inp = inp[len(words[0]) :].strip()
219 
220         all_commands = self.get_commands()
221         matching_commands = [cmd for cmd in all_commands if cmd.startswith(first_word)]
222         return matching_commands, first_word, rest_inp
223 
224     def run(self, inp):
225         if inp.startswith("!"):
226             return self.do_run("run", inp[1:])
227 
228         res = self.matching_commands(inp)
229         if res is None:
230             return
231         matching_commands, first_word, rest_inp = res
232         if len(matching_commands) == 1:
233             return self.do_run(matching_commands[0][1:], rest_inp)
234         elif first_word in matching_commands:
235             return self.do_run(first_word[1:], rest_inp)
236         elif len(matching_commands) > 1:
237             self.io.tool_error(f"Ambiguous command: {', '.join(matching_commands)}")
238         else:
239             self.io.tool_error(f"Invalid command: {first_word}")
