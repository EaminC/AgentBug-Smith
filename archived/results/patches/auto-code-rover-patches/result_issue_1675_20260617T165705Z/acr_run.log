1019     def _generic_chat_command(self, args, edit_format):
1020         if not args.strip():
1021             self.io.tool_error(f"Please provide a question or topic for the {edit_format} chat.")
1022             return
1023 
1024         from aider.coders import Coder
1025 
1026         coder = Coder.create(
1027             io=self.io,
1028             from_coder=self.coder,
1029             edit_format=edit_format,
1030             summarize_from_coder=False,
1031         )
1032 
1033         user_msg = args
1034         coder.run(user_msg)
1035 
1036         raise SwitchCoder(
1037             edit_format=self.coder.edit_format,
1038             summarize_from_coder=False,
1039             from_coder=coder,
1040             show_announcements=False,
1041         )
