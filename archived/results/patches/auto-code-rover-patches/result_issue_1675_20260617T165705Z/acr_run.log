72     def cmd_chat_mode(self, args):
73         "Switch to a new chat mode"
74 
75         from aider import coders
76 
77         ef = args.strip()
78         valid_formats = OrderedDict(
79             sorted(
80                 (
81                     coder.edit_format,
82                     coder.__doc__.strip().split("\n")[0] if coder.__doc__ else "No description",
83                 )
84                 for coder in coders.__all__
85                 if getattr(coder, "edit_format", None)
86             )
87         )
88 
89         show_formats = OrderedDict(
90             [
91                 ("help", "Get help about using aider (usage, config, troubleshoot)."),
92                 ("ask", "Ask questions about your code without making any changes."),
93                 ("code", "Ask for changes to your code (using the best edit format)."),
94             ]
95         )
96 
97         if ef not in valid_formats and ef not in show_formats:
98             if ef:
99                 self.io.tool_error(f'Chat mode "{ef}" should be one of these:\n')
100             else:
101                 self.io.tool_output("Chat mode should be one of these:\n")
102 
103             max_format_length = max(len(format) for format in valid_formats.keys())
104             for format, description in show_formats.items():
105                 self.io.tool_output(f"- {format:<{max_format_length}} : {description}")
106 
107             self.io.tool_output("\nOr a valid edit format:\n")
108             for format, description in valid_formats.items():
109                 if format not in show_formats:
110                     self.io.tool_output(f"- {format:<{max_format_length}} : {description}")
111 
112             return
113 
114         summarize_from_coder = True
115         edit_format = ef
116 
117         if ef == "code":
118             edit_format = self.coder.main_model.edit_format
119             summarize_from_coder = False
120         elif ef == "ask":
121             summarize_from_coder = False
122 
123         raise SwitchCoder(
124             edit_format=edit_format,
125             summarize_from_coder=summarize_from_coder,
126         )
