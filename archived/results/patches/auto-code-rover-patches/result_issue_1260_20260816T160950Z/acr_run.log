542     def call_tool_sync(
543         self,
544         tool_use_id: str,
545         name: str,
546         arguments: dict[str, Any] | None = None,
547         read_timeout_seconds: timedelta | None = None,
548     ) -> MCPToolResult:
549         """Synchronously calls a tool on the MCP server.
550 
551         This method calls the asynchronous call_tool method on the MCP session
552         and converts the result to the ToolResult format. If the MCP tool returns
553         structured content, it will be included as the last item in the content array
554         of the returned ToolResult.
555 
556         Args:
557             tool_use_id: Unique identifier for this tool use
558             name: Name of the tool to call
559             arguments: Optional arguments to pass to the tool
560             read_timeout_seconds: Optional timeout for the tool call
561 
562         Returns:
563             MCPToolResult: The result of the tool call
564         """
565         self._log_debug_with_thread("calling MCP tool '%s' synchronously with tool_use_id=%s", name, tool_use_id)
566         if not self._is_session_active():
567             raise MCPClientInitializationError(CLIENT_SESSION_NOT_RUNNING_ERROR_MESSAGE)
568 
569         async def _call_tool_async() -> MCPCallToolResult:
570             return await cast(ClientSession, self._background_thread_session).call_tool(
571                 name, arguments, read_timeout_seconds
572             )
573 
574         try:
575             call_tool_result: MCPCallToolResult = self._invoke_on_background_thread(_call_tool_async()).result()
576             return self._handle_tool_result(tool_use_id, call_tool_result)
577         except Exception as e:
578             logger.exception("tool execution failed")
579             return self._handle_tool_execution_error(tool_use_id, e)
580 
581     async def call_tool_async(
582         self,
583         tool_use_id: str,
584         name: str,
585         arguments: dict[str, Any] | None = None,
586         read_timeout_seconds: timedelta | None = None,
587     ) -> MCPToolResult:
588         """Asynchronously calls a tool on the MCP server.
589 
590         This method calls the asynchronous call_tool method on the MCP session
591         and converts the result to the MCPToolResult format.
592 
593         Args:
594             tool_use_id: Unique identifier for this tool use
595             name: Name of the tool to call
596             arguments: Optional arguments to pass to the tool
597             read_timeout_seconds: Optional timeout for the tool call
598 
599         Returns:
600             MCPToolResult: The result of the tool call
601         """
602         self._log_debug_with_thread("calling MCP tool '%s' asynchronously with tool_use_id=%s", name, tool_use_id)
603         if not self._is_session_active():
604             raise MCPClientInitializationError(CLIENT_SESSION_NOT_RUNNING_ERROR_MESSAGE)
605 
606         async def _call_tool_async() -> MCPCallToolResult:
607             return await cast(ClientSession, self._background_thread_session).call_tool(
608                 name, arguments, read_timeout_seconds
609             )
610 
611         try:
612             future = self._invoke_on_background_thread(_call_tool_async())
613             call_tool_result: MCPCallToolResult = await asyncio.wrap_future(future)
614             return self._handle_tool_result(tool_use_id, call_tool_result)
615         except Exception as e:
616             logger.exception("tool execution failed")
617             return self._handle_tool_execution_error(tool_use_id, e)
618 
619     def _handle_tool_execution_error(self, tool_use_id: str, exception: Exception) -> MCPToolResult:
620         """Create error ToolResult with consistent logging."""
621         return MCPToolResult(
622             status="error",
623             toolUseId=tool_use_id,
624             content=[{"text": f"Tool execution failed: {str(exception)}"}],
625         )
626 
627     def _handle_tool_result(self, tool_use_id: str, call_tool_result: MCPCallToolResult) -> MCPToolResult:
628         """Maps MCP tool result to the agent's MCPToolResult format.
629 
630         This method processes the content from the MCP tool call result and converts it to the format
631         expected by the framework.
632 
633         Args:
634             tool_use_id: Unique identifier for this tool use
635             call_tool_result: The result from the MCP tool call
636 
637         Returns:
638             MCPToolResult: The converted tool result
639         """
640         self._log_debug_with_thread("received tool result with %d content items", len(call_tool_result.content))
641 
642         # Build a typed list of ToolResultContent.
643         mapped_contents: list[ToolResultContent] = [
644             mc
645             for content in call_tool_result.content
646             if (mc := self._map_mcp_content_to_tool_result_content(content)) is not None
647         ]
648 
649         status: ToolResultStatus = "error" if call_tool_result.isError else "success"
650         self._log_debug_with_thread("tool execution completed with status: %s", status)
651         result = MCPToolResult(
652             status=status,
653             toolUseId=tool_use_id,
654             content=mapped_contents,
655         )
656 
657         if call_tool_result.structuredContent:
658             result["structuredContent"] = call_tool_result.structuredContent
659         if call_tool_result.meta:
660             result["metadata"] = call_tool_result.meta
661 
662         return result
663 
664     async def _async_background_thread(self) -> None:
665         """Asynchronous method that runs in the background thread to manage the MCP connection.
666 
667         This method establishes the transport connection, creates and initializes the MCP session,
668         signals readiness to the main thread, and waits for a close signal.
669         """
670         self._log_debug_with_thread("starting async background thread for MCP connection")
671 
672         # Initialized here so that it has the asyncio loop
673         self._close_future = asyncio.Future()
674 
675         try:
676             async with self._transport_callable() as (read_stream, write_stream, *_):
677                 self._log_debug_with_thread("transport connection established")
678                 async with ClientSession(
679                     read_stream,
680                     write_stream,
681                     message_handler=self._handle_error_message,
682                     elicitation_callback=self._elicitation_callback,
683                 ) as session:
684                     self._log_debug_with_thread("initializing MCP session")
685                     await session.initialize()
686 
687                     self._log_debug_with_thread("session initialized successfully")
688                     # Store the session for use while we await the close event
689                     self._background_thread_session = session
690                     # Signal that the session has been created and is ready for use
691                     self._init_future.set_result(None)
692 
693                     self._log_debug_with_thread("waiting for close signal")
694                     # Keep background thread running until signaled to close.
695                     # Thread is not blocked as this a future
696                     await self._close_future
697 
698                     self._log_debug_with_thread("close signal received")
699         except Exception as e:
700             # If we encounter an exception and the future is still running,
701             # it means it was encountered during the initialization phase.
702             if not self._init_future.done():
703                 self._init_future.set_exception(e)
704             else:
705                 # _close_future is automatically cancelled by the framework which doesn't provide us with the useful
706                 # exception, so instead we store the exception in a different field where stop() can read it
707                 self._close_exception = e
708                 if self._close_future and not self._close_future.done():
709                     self._close_future.set_result(None)
710 
711                 self._log_debug_with_thread(
712                     "encountered exception on background thread after initialization %s", str(e)
713                 )
714 
715     # Raise an exception if the underlying client raises an exception in a message
716     # This happens when the underlying client has an http timeout error
717     async def _handle_error_message(self, message: Exception | Any) -> None:
718         if isinstance(message, Exception):
719             error_msg = str(message).lower()
720             if any(pattern in error_msg for pattern in _NON_FATAL_ERROR_PATTERNS):
721                 self._log_debug_with_thread("ignoring non-fatal MCP session error: %s", message)
722             else:
723                 raise message
724         await anyio.lowlevel.checkpoint()
725 
726     def _background_task(self) -> None:
727         """Sets up and runs the event loop in the background thread.
728 
729         This method creates a new event loop for the background thread,
730         sets it as the current event loop, and runs the async_background_thread
731         coroutine until completion. In this case "until completion" means until the _close_future is resolved.
732         This allows for a long-running event loop.
733         """
734         self._log_debug_with_thread("setting up background task event loop")
735         self._background_thread_event_loop = asyncio.new_event_loop()
736         asyncio.set_event_loop(self._background_thread_event_loop)
737         self._background_thread_event_loop.run_until_complete(self._async_background_thread())
738 
739     def _map_mcp_content_to_tool_result_content(
740         self,
741         content: MCPTextContent | MCPImageContent | MCPEmbeddedResource | Any,
742     ) -> ToolResultContent | None:
743         """Maps MCP content types to tool result content types.
744 
745         This method converts MCP-specific content types to the generic
746         ToolResultContent format used by the agent framework.
747 
748         Args:
749             content: The MCP content to convert
750 
751         Returns:
752             ToolResultContent or None: The converted content, or None if the content type is not supported
753         """
754         if isinstance(content, MCPTextContent):
755             self._log_debug_with_thread("mapping MCP text content")
756             return {"text": content.text}
757         elif isinstance(content, MCPImageContent):
758             self._log_debug_with_thread("mapping MCP image content with mime type: %s", content.mimeType)
759             return {
760                 "image": {
761                     "format": MIME_TO_FORMAT[content.mimeType],
762                     "source": {"bytes": base64.b64decode(content.data)},
763                 }
764             }
765         elif isinstance(content, MCPEmbeddedResource):
766             """
767             TODO: Include URI information in results.
768                 Models may find it useful to be aware not only of the information,
769                 but the location of the information too.
770 
771                 This may be difficult without taking an opinionated position. For example,
772                 a content block may need to indicate that the following Image content block
773                 is of particular URI.
774             """
775 
776             self._log_debug_with_thread("mapping MCP embedded resource content")
777 
778             resource = content.resource
779             if isinstance(resource, TextResourceContents):
780                 return {"text": resource.text}
781             elif isinstance(resource, BlobResourceContents):
782                 try:
783                     raw_bytes = base64.b64decode(resource.blob)
784                 except Exception:
785                     self._log_debug_with_thread("embedded resource blob could not be decoded - dropping")
786                     return None
787 
788                 if resource.mimeType and (
789                     resource.mimeType.startswith("text/")
790                     or resource.mimeType
791                     in (
792                         "application/json",
793                         "application/xml",
794                         "application/javascript",
795                         "application/yaml",
796                         "application/x-yaml",
797                     )
798                     or resource.mimeType.endswith(("+json", "+xml"))
799                 ):
800                     try:
801                         return {"text": raw_bytes.decode("utf-8", errors="replace")}
802                     except Exception:
803                         pass
804 
805                 if resource.mimeType in MIME_TO_FORMAT:
806                     return {
807                         "image": {
808                             "format": MIME_TO_FORMAT[resource.mimeType],
809                             "source": {"bytes": raw_bytes},
810                         }
811                     }
812 
813                 self._log_debug_with_thread("embedded resource blob with non-textual/unknown mimeType - dropping")
814                 return None
815 
816             return None  # type: ignore[unreachable]  # Defensive: future MCP resource types
817         else:
818             self._log_debug_with_thread("unhandled content type: %s - dropping content", content.__class__.__name__)
819             return None
820 
821     def _log_debug_with_thread(self, msg: str, *args: Any, **kwargs: Any) -> None:
822         """Logger helper to help differentiate logs coming from MCPClient background thread."""
823         formatted_msg = msg % args if args else msg
824         logger.debug(
825             "[Thread: %s, Session: %s] %s", threading.current_thread().name, self._session_id, formatted_msg, **kwargs
826         )
827 
828     def _invoke_on_background_thread(self, coro: Coroutine[Any, Any, T]) -> futures.Future[T]:
829         # save a reference to this so that even if it's reset we have the original
830         close_future = self._close_future
831 
832         if (
833             self._background_thread_session is None
834             or self._background_thread_event_loop is None
835             or close_future is None
836         ):
837             raise MCPClientInitializationError("the client session was not initialized")
838 
839         async def run_async() -> T:
840             # Fix for strands-agents/sdk-python/issues/995 - cancel all pending invocations if/when the session closes
841             invoke_event = asyncio.create_task(coro)
842             tasks: list[asyncio.Task | asyncio.Future] = [
843                 invoke_event,
844                 close_future,
845             ]
846 
847             done, pending = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
848 
849             if done.pop() == close_future:
850                 self._log_debug_with_thread("event loop for the server closed before the invoke completed")
851                 raise RuntimeError("Connection to the MCP server was closed")
852             else:
853                 return await invoke_event
854 
855         invoke_future = asyncio.run_coroutine_threadsafe(coro=run_async(), loop=self._background_thread_event_loop)
856         return invoke_future
857 
858     def _should_include_tool(self, tool: MCPAgentTool) -> bool:
859         """Check if a tool should be included based on constructor filters."""
860         return self._should_include_tool_with_filters(tool, self._tool_filters)
861 
862     def _should_include_tool_with_filters(self, tool: MCPAgentTool, filters: ToolFilters | None) -> bool:
863         """Check if a tool should be included based on provided filters."""
864         if not filters:
865             return True
866 
867         # Apply allowed filter
868         if "allowed" in filters:
869             if not self._matches_patterns(tool, filters["allowed"]):
870                 return False
871 
872         # Apply rejected filter
873         if "rejected" in filters:
874             if self._matches_patterns(tool, filters["rejected"]):
875                 return False
876 
877         return True
878 
879     def _matches_patterns(self, tool: MCPAgentTool, patterns: list[_ToolMatcher]) -> bool:
880         """Check if tool matches any of the given patterns."""
881         for pattern in patterns:
882             if callable(pattern):
883                 if pattern(tool):
884                     return True
885             elif isinstance(pattern, Pattern):
886                 if pattern.match(tool.mcp_tool.name):
887                     return True
888             elif isinstance(pattern, str):
889                 if pattern == tool.mcp_tool.name:
890                     return True
891         return False
892 
893     def _is_session_active(self) -> bool:
894         if self._background_thread is None or not self._background_thread.is_alive():
895             return False
896 
897         if self._close_future is not None and self._close_future.done():
898             return False
899 
900         return True

