99 class MCPClient(ToolProvider):
100     """Represents a connection to a Model Context Protocol (MCP) server.
101 
102     This class implements a context manager pattern for efficient connection management,
103     allowing reuse of the same connection for multiple tool calls to reduce latency.
104     It handles the creation, initialization, and cleanup of MCP connections.
105 
106     The connection runs in a background thread to avoid blocking the main application thread
107     while maintaining communication with the MCP service. When structured content is available
108     from MCP tools, it will be returned as the last item in the content array of the ToolResult.
109 
110     Warning:
111         This class implements the experimental ToolProvider interface and its methods
112         are subject to change.
113     """
114 
115     def __init__(
116         self,
117         transport_callable: Callable[[], MCPTransport],
118         *,
119         startup_timeout: int = 30,
120         tool_filters: ToolFilters | None = None,
121         prefix: str | None = None,
122         elicitation_callback: ElicitationFnT | None = None,
123     ) -> None:
124         """Initialize a new MCP Server connection.
125 
126         Args:
127             transport_callable: A callable that returns an MCPTransport (read_stream, write_stream) tuple.
128             startup_timeout: Timeout after which MCP server initialization should be cancelled.
129                 Defaults to 30.
130             tool_filters: Optional filters to apply to tools.
131             prefix: Optional prefix for tool names.
132             elicitation_callback: Optional callback function to handle elicitation requests from the MCP server.
133         """
134         self._startup_timeout = startup_timeout
135         self._tool_filters = tool_filters
136         self._prefix = prefix
137         self._elicitation_callback = elicitation_callback
138 
139         mcp_instrumentation()
140         self._session_id = uuid.uuid4()
141         self._log_debug_with_thread("initializing MCPClient connection")
142         # Main thread blocks until future completes
143         self._init_future: futures.Future[None] = futures.Future()
144         # Set within the inner loop as it needs the asyncio loop
145         self._close_future: asyncio.futures.Future[None] | None = None
146         self._close_exception: None | Exception = None
147         # Do not want to block other threads while close event is false
148         self._transport_callable = transport_callable
149 
150         self._background_thread: threading.Thread | None = None
151         self._background_thread_session: ClientSession | None = None
152         self._background_thread_event_loop: AbstractEventLoop | None = None
153         self._loaded_tools: list[MCPAgentTool] | None = None
154         self._tool_provider_started = False
155         self._consumers: set[Any] = set()
156 
157     def __enter__(self) -> "MCPClient":
158         """Context manager entry point which initializes the MCP server connection.
159 
160         TODO: Refactor to lazy initialization pattern following idiomatic Python.
161         Heavy work in __enter__ is non-idiomatic - should move connection logic to first method call instead.
162         """
163         return self.start()
164 
165     def __exit__(self, exc_type: BaseException, exc_val: BaseException, exc_tb: TracebackType) -> None:
166         """Context manager exit point that cleans up resources."""
167         self.stop(exc_type, exc_val, exc_tb)
168 
169     def start(self) -> "MCPClient":
170         """Starts the background thread and waits for initialization.
171 
172         This method starts the background thread that manages the MCP connection
173         and blocks until the connection is ready or times out.
174 
175         Returns:
176             self: The MCPClient instance
177 
178         Raises:
179             Exception: If the MCP connection fails to initialize within the timeout period
180         """
181         if self._is_session_active():
182             raise MCPClientInitializationError("the client session is currently running")
183 
184         self._log_debug_with_thread("entering MCPClient context")
185         # Copy context vars to propagate to the background thread
186         # This ensures that context set in the main thread is accessible in the background thread
187         # See: https://github.com/strands-agents/sdk-python/issues/1440
188         ctx = contextvars.copy_context()
189         self._background_thread = threading.Thread(target=ctx.run, args=(self._background_task,), daemon=True)
190         self._background_thread.start()
191         self._log_debug_with_thread("background thread started, waiting for ready event")
192         try:
193             # Blocking main thread until session is initialized in other thread or if the thread stops
194             self._init_future.result(timeout=self._startup_timeout)
195             self._log_debug_with_thread("the client initialization was successful")
196         except futures.TimeoutError as e:
197             logger.exception("client initialization timed out")
198             # Pass None for exc_type, exc_val, exc_tb since this isn't a context manager exit
199             self.stop(None, None, None)
200             raise MCPClientInitializationError(
201                 f"background thread did not start in {self._startup_timeout} seconds"
202             ) from e
203         except Exception as e:
204             logger.exception("client failed to initialize")
205             # Pass None for exc_type, exc_val, exc_tb since this isn't a context manager exit
206             self.stop(None, None, None)
207             raise MCPClientInitializationError("the client initialization failed") from e
208         return self
209 
210     # ToolProvider interface methods (experimental, as ToolProvider is experimental)
211     async def load_tools(self, **kwargs: Any) -> Sequence[AgentTool]:
212         """Load and return tools from the MCP server.
213 
214         This method implements the ToolProvider interface by loading tools
215         from the MCP server and caching them for reuse.
216 
217         Args:
218             **kwargs: Additional arguments for future compatibility.
219 
220         Returns:
221             List of AgentTool instances from the MCP server.
222         """
223         logger.debug(
224             "started=<%s>, cached_tools=<%s> | loading tools",
225             self._tool_provider_started,
226             self._loaded_tools is not None,
227         )
228 
229         if not self._tool_provider_started:
230             try:
231                 logger.debug("starting MCP client")
232                 self.start()
233                 self._tool_provider_started = True
234                 logger.debug("MCP client started successfully")
235             except Exception as e:
236                 logger.error("error=<%s> | failed to start MCP client", e)
237                 raise ToolProviderException(f"Failed to start MCP client: {e}") from e
238 
239         if self._loaded_tools is None:
240             logger.debug("loading tools from MCP server")
241             self._loaded_tools = []
242             pagination_token = None
243             page_count = 0
244 
245             while True:
246                 logger.debug("page=<%d>, token=<%s> | fetching tools page", page_count, pagination_token)
247                 # Use constructor defaults for prefix and filters in load_tools
248                 paginated_tools = self.list_tools_sync(
249                     pagination_token, prefix=self._prefix, tool_filters=self._tool_filters
250                 )
251 
252                 # Tools are already filtered by list_tools_sync, so add them all
253                 for tool in paginated_tools:
254                     self._loaded_tools.append(tool)
255 
256                 logger.debug(
257                     "page=<%d>, page_tools=<%d>, total_filtered=<%d> | processed page",
258                     page_count,
259                     len(paginated_tools),
260                     len(self._loaded_tools),
261                 )
262 
263                 pagination_token = paginated_tools.pagination_token
264                 page_count += 1
265 
266                 if pagination_token is None:
267                     break
268 
269             logger.debug("final_tools=<%d> | loading complete", len(self._loaded_tools))
270 
271         return self._loaded_tools
272 
273     def add_consumer(self, consumer_id: Any, **kwargs: Any) -> None:
274         """Add a consumer to this tool provider.
275 
276         Synchronous to prevent GC deadlocks when called from Agent finalizers.
277         """
278         self._consumers.add(consumer_id)
279         logger.debug("added provider consumer, count=%d", len(self._consumers))
280 
281     def remove_consumer(self, consumer_id: Any, **kwargs: Any) -> None:
282         """Remove a consumer from this tool provider.
283 
284         This method is idempotent - calling it multiple times with the same ID
285         has no additional effect after the first call.
286 
287         Synchronous to prevent GC deadlocks when called from Agent finalizers.
288         Uses existing synchronous stop() method for safe cleanup.
289         """
290         self._consumers.discard(consumer_id)
291         logger.debug("removed provider consumer, count=%d", len(self._consumers))
292 
293         if not self._consumers and self._tool_provider_started:
294             logger.debug("no consumers remaining, cleaning up")
295             try:
296                 self.stop(None, None, None)  # Existing sync method - safe for finalizers
297                 self._tool_provider_started = False
298                 self._loaded_tools = None
299             except Exception as e:
300                 logger.error("error=<%s> | failed to cleanup MCP client", e)
301                 raise ToolProviderException(f"Failed to cleanup MCP client: {e}") from e
302 
303     # MCP-specific methods
304 
305     def stop(self, exc_type: BaseException | None, exc_val: BaseException | None, exc_tb: TracebackType | None) -> None:
306         """Signals the background thread to stop and waits for it to complete, ensuring proper cleanup of all resources.
307 
308         This method is defensive and can handle partial initialization states that may occur
309         if start() fails partway through initialization.
310 
311         Resources to cleanup:
312         - _background_thread: Thread running the async event loop
313         - _background_thread_session: MCP ClientSession (auto-closed by context manager)
314         - _background_thread_event_loop: AsyncIO event loop in background thread
315         - _close_future: AsyncIO future to signal thread shutdown
316         - _close_exception: Exception that caused the background thread shutdown; None if a normal shutdown occurred.
317         - _init_future: Future for initialization synchronization
318 
319         Cleanup order:
320         1. Signal close future to background thread (if session initialized)
321         2. Wait for background thread to complete
322         3. Reset all state for reuse
323 
324         Args:
325             exc_type: Exception type if an exception was raised in the context
326             exc_val: Exception value if an exception was raised in the context
327             exc_tb: Exception traceback if an exception was raised in the context
328         """
329         self._log_debug_with_thread("exiting MCPClient context")
330 
331         # Only try to signal close future if we have a background thread
332         if self._background_thread is not None:
333             # Signal close future if event loop exists
334             if self._background_thread_event_loop is not None:
335 
336                 async def _set_close_event() -> None:
337                     if self._close_future and not self._close_future.done():
338                         self._close_future.set_result(None)
339 
340                 # Not calling _invoke_on_background_thread since the session does not need to exist
341                 # we only need the thread and event loop to exist.
342                 asyncio.run_coroutine_threadsafe(coro=_set_close_event(), loop=self._background_thread_event_loop)
343 
344             self._log_debug_with_thread("waiting for background thread to join")
345             self._background_thread.join()
346 
347         if self._background_thread_event_loop is not None:
348             self._background_thread_event_loop.close()
349 
350         self._log_debug_with_thread("background thread is closed, MCPClient context exited")
351 
352         # Reset fields to allow instance reuse
353         self._init_future = futures.Future()
354         self._background_thread = None
355         self._background_thread_session = None
356         self._background_thread_event_loop = None
357         self._session_id = uuid.uuid4()
358         self._loaded_tools = None
359         self._tool_provider_started = False
360         self._consumers = set()
361 
362         if self._close_exception:
363             exception = self._close_exception
364             self._close_exception = None
365             raise RuntimeError("Connection to the MCP server was closed") from exception
366 
367     def list_tools_sync(
368         self,
369         pagination_token: str | None = None,
370         prefix: str | None = None,
371         tool_filters: ToolFilters | None = None,
372     ) -> PaginatedList[MCPAgentTool]:
373         """Synchronously retrieves the list of available tools from the MCP server.
374 
375         This method calls the asynchronous list_tools method on the MCP session
376         and adapts the returned tools to the AgentTool interface.
377 
378         Args:
379             pagination_token: Optional token for pagination
380             prefix: Optional prefix to apply to tool names. If None, uses constructor default.
381                    If explicitly provided (including empty string), overrides constructor default.
382             tool_filters: Optional filters to apply to tools. If None, uses constructor default.
383                          If explicitly provided (including empty dict), overrides constructor default.
384 
385         Returns:
386             List[AgentTool]: A list of available tools adapted to the AgentTool interface
387         """
388         self._log_debug_with_thread("listing MCP tools synchronously")
389         if not self._is_session_active():
390             raise MCPClientInitializationError(CLIENT_SESSION_NOT_RUNNING_ERROR_MESSAGE)
391 
392         effective_prefix = self._prefix if prefix is None else prefix
393         effective_filters = self._tool_filters if tool_filters is None else tool_filters
394 
395         async def _list_tools_async() -> ListToolsResult:
396             return await cast(ClientSession, self._background_thread_session).list_tools(cursor=pagination_token)
397 
398         list_tools_response: ListToolsResult = self._invoke_on_background_thread(_list_tools_async()).result()
399         self._log_debug_with_thread("received %d tools from MCP server", len(list_tools_response.tools))
400 
401         mcp_tools = []
402         for tool in list_tools_response.tools:
403             # Apply prefix if specified
404             if effective_prefix:
405                 prefixed_name = f"{effective_prefix}_{tool.name}"
406                 mcp_tool = MCPAgentTool(tool, self, name_override=prefixed_name)
407                 logger.debug("tool_rename=<%s->%s> | renamed tool", tool.name, prefixed_name)
408             else:
409                 mcp_tool = MCPAgentTool(tool, self)
410 
411             # Apply filters if specified
412             if self._should_include_tool_with_filters(mcp_tool, effective_filters):
413                 mcp_tools.append(mcp_tool)
414 
415         self._log_debug_with_thread("successfully adapted %d MCP tools", len(mcp_tools))
416         return PaginatedList[MCPAgentTool](mcp_tools, token=list_tools_response.nextCursor)
417 
