607             return await cast(ClientSession, self._background_thread_session).call_tool(
608                 name, arguments, read_timeout_seconds
609             )
610 
611         try:
612             future = self._invoke_on_background_thread(_call_tool_async())
613             call_tool_result: MCPCallToolResult = await asyncio.wrap_future(future)
614             return self._handle_tool_result(tool_use_id, call_tool_result)
615         except Exception as e:
