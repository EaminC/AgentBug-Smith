27 class _AnthropicFormatterBase(FormatterBase, ABC):
28     """Mixin for formatting Anthropic formatters to avoid duplication between
29     AnthropicChatFormatter and AnthropicMultiAgentFormatter."""
30 
31     # pylint: disable=too-many-branches
32     async def _format_messages(
33         self,
34         msgs: list[Msg],
35     ) -> list[dict[str, Any]]:
36         """Format message objects into Anthropic API format.
37 
38         Args:
39             msgs (`list[Msg]`):
40                 The list of message objects to format.
41 
42         Returns:
43             `list[dict[str, Any]]`:
44                 The formatted messages as a list of dictionaries.
45 
46         .. note:: Anthropic suggests always passing all previous thinking
47          blocks back to the API in subsequent calls to maintain reasoning
48          continuity. For more details, please refer to
49          `Anthropic's documentation
50          <https://docs.anthropic.com/en/docs/build-with-claude/extended-thinking#preserving-thinking-blocks>`_.
51         """
52         self.assert_list_of_msgs(msgs)
53 
54         messages: list[dict] = []
55         for msg in msgs:  # pylint: disable=too-many-nested-blocks
56             content_blocks: list = []
57             has_tool_result = False
58 
59             for block in msg.get_content_blocks():
60                 if (
61                     has_tool_result
62                     and content_blocks
63                     and not isinstance(
64                         block,
65                         ToolResultBlock,
66                     )
67                 ):
68                     messages.append(
69                         {"role": "user", "content": content_blocks},
70                     )
71                     content_blocks = []
72                     has_tool_result = False
73 
74                 if isinstance(block, TextBlock):
75                     content_blocks.append(
76                         {"type": "text", "text": block.text},
77                     )
78 
79                 elif isinstance(block, ThinkingBlock):
80                     # Anthropic rejects thinking blocks without a valid
81                     # signature ("Invalid `signature` in `thinking` block").
82                     # ThinkingBlocks from other providers (OpenAI, DeepSeek,
83                     # ...) carry no signature, so drop them instead of
84                     # forwarding an empty one.
85                     signature = getattr(block, "signature", None)
86                     if signature:
87                         content_blocks.append(
88                             {
89                                 "type": "thinking",
90                                 "thinking": block.thinking,
91                                 "signature": signature,
92                             },
93                         )
94                     else:
95                         logger.debug(
96                             "Dropping ThinkingBlock without signature; "
97                             "Anthropic requires a valid signature.",
98                         )
99 
100                 elif isinstance(block, HintBlock):
101                     if content_blocks:
102                         role = "user" if has_tool_result else msg.role
103                         messages.append(
104                             {"role": role, "content": content_blocks},
105                         )
106                         content_blocks = []
107                         has_tool_result = False
108 
109                     if isinstance(block.hint, str):
110                         messages.append(
111                             {
112                                 "role": "user",
113                                 "content": [
114                                     {"type": "text", "text": block.hint},
115                                 ],
116                             },
117                         )
118                     else:
119                         hint_parts: list[dict] = []
120                         for sub in block.hint:
121                             if isinstance(sub, TextBlock):
122                                 hint_parts.append(
123                                     {"type": "text", "text": sub.text},
124                                 )
125                             elif isinstance(sub, DataBlock):
126                                 formatted_sub = (
127                                     self._format_anthropic_data_block(sub)
128                                 )
129                                 if formatted_sub:
130                                     hint_parts.append(formatted_sub)
131                         if hint_parts:
132                             messages.append(
133                                 {"role": "user", "content": hint_parts},
134                             )
135 
136                 elif isinstance(block, DataBlock):
137                     formatted_block = self._format_anthropic_data_block(block)
138                     if formatted_block:
139                         content_blocks.append(formatted_block)
140 
141                 elif isinstance(block, ToolCallBlock):
142                     content_blocks.append(
143                         {
144                             "type": "tool_use",
145                             "id": block.id,
146                             "name": block.name,
147                             # Anthropic API expects input as a dict, not a
148                             # JSON string.
149                             "input": json.loads(block.input or "{}"),
150                         },
151                     )
152 
153                 elif isinstance(block, ToolResultBlock):
154                     if content_blocks:
155                         role = "user" if has_tool_result else msg.role
156                         messages.append(
157                             {"role": role, "content": content_blocks},
158                         )
159                         content_blocks = []
160 
161                     tool_result_content: list[dict] = []
162                     output = block.output
163                     if isinstance(output, str):
164                         tool_result_content.append(
165                             {"type": "text", "text": output},
166                         )
167                     else:
168                         for out_block in output:
169                             if isinstance(out_block, TextBlock):
170                                 tool_result_content.append(
171                                     {"type": "text", "text": out_block.text},
172                                 )
173                             elif isinstance(out_block, DataBlock):
174                                 fmt_block = self._format_anthropic_data_block(
175                                     out_block,
176                                 )
177                                 if fmt_block:
178                                     tool_result_content.append(fmt_block)
179                                 else:
180                                     source = out_block.source
181                                     main_type = source.media_type.split("/")[0]
182                                     if isinstance(source, URLSource):
183                                         fallback = (
184                                             f"[{main_type} file returned, "
185                                             f"URL: {source.url}]"
186                                         )
187                                     else:
188                                         fallback = (
189                                             f"[{main_type} file returned, "
190                                             f"type: {source.media_type}]"
191                                         )
192                                     tool_result_content.append(
193                                         {"type": "text", "text": fallback},
194                                     )
195 
196                     content_blocks.append(
197                         {
198                             "type": "tool_result",
199                             "tool_use_id": block.id,
200                             "content": tool_result_content,
201                         },
202                     )
203                     # Anthropic requires tool_result to be in a "user" message.
204                     has_tool_result = True
205 
206                 else:
207                     logger.warning(
208                         "Unsupported block type %s in the message, skipped.",
209                         type(block),
210                     )
211 
212             if content_blocks:
213                 # Anthropic requires `tool_result` blocks to be in a `user`
214                 # message regardless of the containing Msg's role.
215                 role = "user" if has_tool_result else msg.role
216                 messages.append(
217                     {
218                         "role": role,
219                         "content": content_blocks,
220                     },
221                 )
222 
223         return messages
224 
225     def _format_anthropic_data_block(
226         self,
227         block: DataBlock,
228     ) -> dict[str, Any] | None:
229         """Format a DataBlock into Anthropic API format.
230 
231         Args:
232             block (`DataBlock`):
233                 The data block to format.
234 
235         Returns:
236             `dict[str, Any] | None`:
237                 The formatted data block, or None if the media type is not
238                 supported.
239         """
240         source = block.source
241         media_type = source.media_type
242 
243         # Check if media type is supported
244         if not any(
245             fnmatch.fnmatch(media_type, pattern)
246             for pattern in self.supported_input_media_types
247         ):
248             logger.warning(
249                 "Media type %s is not supported, skipped.",
250                 media_type,
251             )
252             return None
253 
254         # Anthropic only supports images
255         if not media_type.startswith("image/"):
256             logger.warning(
257                 "Anthropic only supports image data, got %s, skipped.",
258                 media_type,
259             )
260             return None
261 
262         return self._format_image_source(source)
263 
264     @staticmethod
265     def _format_image_source(
266         source: URLSource | Base64Source,
267     ) -> dict[str, Any]:
268         """Format an image source into Anthropic API format.
269 
270         Args:
271             source (`URLSource | Base64Source`):
272                 The image source to format.
273 
274         Returns:
275             `dict[str, Any]`:
276                 The formatted image source.
277         """
278         if isinstance(source, Base64Source):
279             return {
280                 "type": "image",
281                 "source": {
282                     "type": "base64",
283                     "media_type": source.media_type,
284                     "data": source.data,
285                 },
286             }
287         elif isinstance(source, URLSource):
288             url = str(source.url)
289             if url.startswith("file://"):
290                 # Local file - read and convert to base64
291                 file_path = url.removeprefix("file://")
292                 with open(file_path, "rb") as f:
293                     data = base64.b64encode(f.read()).decode("utf-8")
294                 return {
295                     "type": "image",
296                     "source": {
297                         "type": "base64",
298                         "media_type": source.media_type,
299                         "data": data,
300                     },
301                 }
302             else:
303                 # Remote URL - download and convert to base64
304                 response = requests.get(url, timeout=30)
305                 response.raise_for_status()
306                 data = base64.b64encode(response.content).decode("utf-8")
307                 return {
308                     "type": "image",
309                     "source": {
310                         "type": "base64",
311                         "media_type": source.media_type,
312                         "data": data,
313                     },
314                 }
315         else:
316             raise ValueError(f"Unsupported source type: {type(source)}")
317 
