356 class AnthropicMultiAgentFormatter(_AnthropicFormatterBase):
357     """Anthropic formatter for multi-agent conversations, where more than
358     a user and an agent are involved.
359     """
360 
361     conversation_history_prompt: str = Field(
362         default=(
363             "# Conversation History\n"
364             "The content between <history></history> tags contains "
365             "your conversation history\n"
366         ),
367         description="The prompt to use for the conversation history section.",
368     )
369 
370     input_types: list[str] = Field(
371         default_factory=lambda: ["text/plain", "image/*"],
372         description=(
373             "The supported input types. "
374             'Defaults to ``["text/plain", "image/*"]``.'
375         ),
376     )
377 
378     async def format(self, msgs: list[Msg]) -> list[dict[str, Any]]:
379         """Format input messages into the structure required by the Anthropic
380         API for multi-agent conversations."""
381         self.assert_list_of_msgs(msgs)
382 
383         formatted_msgs = []
384         start_index = 0
385         if len(msgs) > 0 and msgs[0].role == "system":
386             formatted_msgs.append(
387                 await self._format_system_message(msgs[0]),
388             )
389             start_index = 1
390 
391         is_first_agent_message = True
392         async for typ, group in self._group_messages(msgs[start_index:]):
393             match typ:
394                 case "tool_sequence":
395                     formatted_msgs.extend(
396                         await self._format_messages(group),
397                     )
398                 case "agent_message":
399                     formatted_msgs.extend(
400                         await self._format_agent_message(
401                             group,
402                             is_first_agent_message,
403                         ),
404                     )
405                     is_first_agent_message = False
406 
407         return formatted_msgs
408 
409     async def _format_agent_message(
410         self,
411         msgs: list[Msg],
412         is_first: bool,
413     ) -> list[dict[str, Any]]:
414         """Format agent messages into conversation history."""
415         conversation_blocks = []
416         accumulated_text = []
417 
418         for msg in msgs:
419             agent_name = msg.name or "Agent"
420             agent_text_parts = []
421 
422             for block in msg.get_content_blocks():
423                 if isinstance(block, TextBlock):
424                     agent_text_parts.append(block.text)
425                 elif isinstance(block, DataBlock):
426                     formatted_block = self._format_anthropic_data_block(block)
427                     if formatted_block:
428                         if accumulated_text:
429                             conversation_blocks.append(
430                                 {
431                                     "type": "text",
432                                     "text": "\n".join(accumulated_text),
433                                 },
434                             )
435                             accumulated_text = []
436                         conversation_blocks.append(formatted_block)
437 
438             if agent_text_parts:
439                 agent_message = f"{agent_name}: {' '.join(agent_text_parts)}"
440                 accumulated_text.append(agent_message)
441 
442         if accumulated_text:
443             conversation_blocks.append(
444                 {
445                     "type": "text",
446                     "text": "\n".join(accumulated_text),
447                 },
448             )
449 
450         if conversation_blocks and is_first:
451             if conversation_blocks[0].get("text"):
452                 conversation_blocks[0]["text"] = (
453                     self.conversation_history_prompt
454                     + "<history>\n"
455                     + conversation_blocks[0]["text"]
456                 )
457             else:
458                 conversation_blocks.insert(
459                     0,
460                     {
461                         "type": "text",
462                         "text": self.conversation_history_prompt
463                         + "<history>\n",
464                     },
465                 )
466 
467             if conversation_blocks[-1].get("text"):
468                 conversation_blocks[-1]["text"] += "\n</history>"
469             else:
470                 conversation_blocks.append(
471                     {"type": "text", "text": "</history>"},
472                 )
473 
474         if conversation_blocks:
475             return [
476                 {
477                     "role": "user",
478                     "content": conversation_blocks,
479                 },
480             ]
481 
482         return []
483 
484     @staticmethod
485     async def _format_system_message(msg: Msg) -> dict[str, Any]:
486         """Format a system message."""
487         text_parts = []
488         for block in msg.get_content_blocks():
489             if isinstance(block, TextBlock):
490                 text_parts.append(block.text)
491 
492         return {
493             "role": "system",
494             "content": [
495                 {
496                     "type": "text",
497                     "text": "\n".join(text_parts),
498                 },
499             ],
500         }

</code><intended_behavior>Modify the condition that triggers flushing content_blocks upon encountering a ToolResultBlock. Instead of flushing whenever content_blocks is non-empty, flush only if content_blocks is non-empty and there is no ongoing tool_result block being processed (i.e., if content_blocks and not has_tool_result). This change allows multiple tool_results to be merged into a single user message, ensuring compliance with DeepSeek's message format requirements while preserving existing formatting for other cases.</intended_behavior>]
