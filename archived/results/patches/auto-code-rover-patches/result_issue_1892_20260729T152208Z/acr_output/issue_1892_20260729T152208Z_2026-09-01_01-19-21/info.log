319 class AnthropicChatFormatter(_AnthropicFormatterBase):
320     """The Anthropic formatter class for chatbot scenario, where only a user
321     and an agent are involved. We use the `role` field to identify different
322     entities in the conversation.
323     """
324 
325     input_types: list[str] = Field(
326         default_factory=lambda: ["text/plain", "image/*"],
327         description=(
328             "The supported input types. "
329             'Defaults to ``["text/plain", "image/*"]``.'
330         ),
331     )
332 
333     async def format(
334         self,
335         msgs: list[Msg],
336     ) -> list[dict[str, Any]]:
337         """Format message objects into Anthropic API format.
338 
339         Args:
340             msgs (`list[Msg]`):
341                 The list of message objects to format.
342 
343         Returns:
344             `list[dict[str, Any]]`:
345                 The formatted messages as a list of dictionaries.
346 
347         .. note:: Anthropic suggests always passing all previous thinking
348          blocks back to the API in subsequent calls to maintain reasoning
349          continuity. For more details, please refer to
350          `Anthropic's documentation
351          <https://docs.anthropic.com/en/docs/build-with-claude/extended-thinking#preserving-thinking-blocks>`_.
352         """
353         return await self._format_messages(msgs)
354 
