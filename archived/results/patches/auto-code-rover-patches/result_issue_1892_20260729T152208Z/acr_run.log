319 class AnthropicChatFormatter(_AnthropicFormatterBase):
320     """The Anthropic formatter class for chatbot scenario, where only a user
321     and an agent are involved. We use the `role` field to identify different
322     entities in the conversation.
323     """
324 
325     input_types: list[str] = Field(
326         default_factory=lambda: ["text/plain", "image/*"],
327         description=(
328             "The supported input types. "
329             'Defaults to ``["text/plain", "image/*"]``.'
330         ),
331     )
332 
333     async def format(
334         self,
335         msgs: list[Msg],
336     ) -> list[dict[str, Any]]:
337         """Format message objects into Anthropic API format.
338 
339         Args:
340             msgs (`list[Msg]`):
