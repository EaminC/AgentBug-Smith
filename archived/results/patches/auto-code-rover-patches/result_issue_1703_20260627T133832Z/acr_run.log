597 
598         tasks = [
599             asyncio.create_task(run_crew(crew_copies[i], inputs[i]))
600             for i in range(len(inputs))
601         ]
602 
603         results = await asyncio.gather(*tasks)
604 
605         total_usage_metrics = UsageMetrics()
606         for crew in crew_copies:
607             if crew.usage_metrics:
608                 total_usage_metrics.add_usage_metrics(crew.usage_metrics)
609 
610         self.usage_metrics = total_usage_metrics
611         self._task_output_handler.reset()
612         return results
613 
614     def _handle_crew_planning(self):
615         """Handles the Crew planning."""
616         self._logger.log("info", "Planning the crew execution")
617         result = CrewPlanner(
618             tasks=self.tasks, planning_agent_llm=self.planning_llm
619         )._handle_crew_planning()
620 
621         for task, step_plan in zip(self.tasks, result.list_of_plans_per_task):
622             task.description += step_plan.plan
623 
624     def _store_execution_log(
625         self,
626         task: Task,
627         output: TaskOutput,
628         task_index: int,
629         was_replayed: bool = False,
630     ):
631         if self._inputs:
632             inputs = self._inputs
633         else:
634             inputs = {}
635 
636         log = {
637             "task": task,
638             "output": {
639                 "description": output.description,
640                 "summary": output.summary,
641                 "raw": output.raw,
642                 "pydantic": output.pydantic,
643                 "json_dict": output.json_dict,
644                 "output_format": output.output_format,
645                 "agent": output.agent,
646             },
647             "task_index": task_index,
648             "inputs": inputs,
649             "was_replayed": was_replayed,
650         }
651         self._task_output_handler.update(task_index, log)
