446     def _setup_from_config(self):
447         assert self.config is not None, "Config should not be None."
448 
449         """Initializes agents and tasks from the provided config."""
450         if not self.config.get("agents") or not self.config.get("tasks"):
451             raise PydanticCustomError(
452                 "missing_keys_in_config", "Config should have 'agents' and 'tasks'.", {}
453             )
454 
455         self.process = self.config.get("process", self.process)
456         self.agents = [Agent(**agent) for agent in self.config["agents"]]
457         self.tasks = [self._create_task(task) for task in self.config["tasks"]]
458 
459     def _create_task(self, task_config: Dict[str, Any]) -> Task:
460         """Creates a task instance from its configuration.
461 
462         Args:
463             task_config: The configuration of the task.
464 
465         Returns:
466             A task instance.
467         """
468         task_agent = next(
469             agt for agt in self.agents if agt.role == task_config["agent"]
470         )
471         del task_config["agent"]
472         return Task(**task_config, agent=task_agent)
