487     def train(
488         self, n_iterations: int, filename: str, inputs: Optional[Dict[str, Any]] = {}
489     ) -> None:
490         """Trains the crew for a given number of iterations."""
491         train_crew = self.copy()
492         train_crew._setup_for_training(filename)
493 
494         for n_iteration in range(n_iterations):
495             train_crew._train_iteration = n_iteration
496             train_crew.kickoff(inputs=inputs)
497 
498         training_data = CrewTrainingHandler(TRAINING_DATA_FILE).load()
499 
500         for agent in train_crew.agents:
501             if training_data.get(str(agent.id)):
502                 result = TaskEvaluator(agent).evaluate_training_data(
503                     training_data=training_data, agent_id=str(agent.id)
504                 )
505 
506                 CrewTrainingHandler(filename).save_trained_data(
507                     agent_id=str(agent.role), trained_data=result.model_dump()
508                 )
