61         return Task(
62             description=(
63                 f"Based on these tasks summary: {tasks_summary} \n Create the most descriptive plan based on the tasks "
64                 "descriptions, tools available, and agents' goals for them to execute their goals with perfection."
65             ),
66             expected_output="Step by step plan on how the agents can execute their tasks using the available tools with mastery",
67             agent=planning_agent,
68             output_pydantic=PlannerTaskPydanticOutput,
69         )
