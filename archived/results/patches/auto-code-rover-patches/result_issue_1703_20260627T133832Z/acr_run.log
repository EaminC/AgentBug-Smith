71     def _create_tasks_summary(self) -> str:
72         """Creates a summary of all tasks."""
73         tasks_summary = []
74         for idx, task in enumerate(self.tasks):
75             tasks_summary.append(
76                 f"""
77                 Task Number {idx + 1} - {task.description}
78                 "task_description": {task.description}
79                 "task_expected_output": {task.expected_output}
80                 "agent": {task.agent.role if task.agent else "None"}
81                 "agent_goal": {task.agent.goal if task.agent else "None"}
82                 "task_tools": {task.tools}
83                 "agent_tools": {task.agent.tools if task.agent else "None"}
84                 """
85             )
86         return " ".join(tasks_summary)

