662     def _create_manager_agent(self):
663         i18n = I18N(prompt_file=self.prompt_file)
664         if self.manager_agent is not None:
665             self.manager_agent.allow_delegation = True
666             manager = self.manager_agent
667             if manager.tools is not None and len(manager.tools) > 0:
668                 self._logger.log(
669                     "warning", "Manager agent should not have tools", color="orange"
670                 )
671                 manager.tools = []
672                 raise Exception("Manager agent should not have tools")
673         else:
674             self.manager_llm = (
675                 getattr(self.manager_llm, "model_name", None)
676                 or getattr(self.manager_llm, "deployment_name", None)
677                 or self.manager_llm
678             )
679             manager = Agent(
680                 role=i18n.retrieve("hierarchical_manager_agent", "role"),
681                 goal=i18n.retrieve("hierarchical_manager_agent", "goal"),
682                 backstory=i18n.retrieve("hierarchical_manager_agent", "backstory"),
683                 tools=AgentTools(agents=self.agents).tools(),
684                 allow_delegation=True,
685                 llm=self.manager_llm,
686                 verbose=self.verbose,
687             )
688             self.manager_agent = manager
689         manager.crew = self
