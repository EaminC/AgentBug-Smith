404     def validate_async_task_cannot_include_sequential_async_tasks_in_context(self):
405         """
406         Validates that if a task is set to be executed asynchronously,
407         it cannot include other asynchronous tasks in its context unless
408         separated by a synchronous task.
409         """
410         for i, task in enumerate(self.tasks):
411             if task.async_execution and task.context:
412                 for context_task in task.context:
413                     if context_task.async_execution:
414                         for j in range(i - 1, -1, -1):
415                             if self.tasks[j] == context_task:
416                                 raise ValueError(
417                                     f"Task '{task.description}' is asynchronous and cannot include other sequential asynchronous tasks in its context."
418                                 )
