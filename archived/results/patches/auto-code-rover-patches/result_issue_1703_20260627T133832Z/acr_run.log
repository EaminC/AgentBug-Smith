691     def _execute_tasks(
692         self,
693         tasks: List[Task],
694         start_index: Optional[int] = 0,
695         was_replayed: bool = False,
696     ) -> CrewOutput:
697         """Executes tasks sequentially and returns the final output.
698 
699         Args:
700             tasks (List[Task]): List of tasks to execute
701             manager (Optional[BaseAgent], optional): Manager agent to use for delegation. Defaults to None.
702 
703         Returns:
704             CrewOutput: Final output of the crew
705         """
706 
707         task_outputs: List[TaskOutput] = []
708         futures: List[Tuple[Task, Future[TaskOutput], int]] = []
709         last_sync_output: Optional[TaskOutput] = None
710 
711         for task_index, task in enumerate(tasks):
712             if start_index is not None and task_index < start_index:
713                 if task.output:
714                     if task.async_execution:
715                         task_outputs.append(task.output)
716                     else:
717                         task_outputs = [task.output]
718                         last_sync_output = task.output
719                 continue
720 
721             agent_to_use = self._get_agent_to_use(task)
722             if agent_to_use is None:
723                 raise ValueError(
724                     f"No agent available for task: {task.description}. Ensure that either the task has an assigned agent or a manager agent is provided."
725                 )
726 
727             # Determine which tools to use - task tools take precedence over agent tools
728             tools_for_task = task.tools or agent_to_use.tools or []
729             tools_for_task = self._prepare_tools(
730                 agent_to_use,
731                 task,
732                 tools_for_task
733             )
734 
735             self._log_task_start(task, agent_to_use.role)
736 
737             if isinstance(task, ConditionalTask):
738                 skipped_task_output = self._handle_conditional_task(
739                     task, task_outputs, futures, task_index, was_replayed
740                 )
741                 if skipped_task_output:
742                     continue
743 
744             if task.async_execution:
745                 context = self._get_context(
746                     task, [last_sync_output] if last_sync_output else []
747                 )
748                 future = task.execute_async(
749                     agent=agent_to_use,
750                     context=context,
751                     tools=tools_for_task,
752                 )
753                 futures.append((task, future, task_index))
754             else:
755                 if futures:
756                     task_outputs = self._process_async_tasks(futures, was_replayed)
757                     futures.clear()
758 
759                 context = self._get_context(task, task_outputs)
760                 task_output = task.execute_sync(
761                     agent=agent_to_use,
762                     context=context,
763                     tools=tools_for_task,
764                 )
765                 task_outputs = [task_output]
766                 self._process_task_result(task, task_output)
767                 self._store_execution_log(task, task_output, task_index, was_replayed)
768 
769         if futures:
770             task_outputs = self._process_async_tasks(futures, was_replayed)
771 
772         return self._create_crew_output(task_outputs)
773 
774     def _handle_conditional_task(
775         self,
776         task: ConditionalTask,
777         task_outputs: List[TaskOutput],
778         futures: List[Tuple[Task, Future[TaskOutput], int]],
779         task_index: int,
780         was_replayed: bool,
781     ) -> Optional[TaskOutput]:
782         if futures:
783             task_outputs = self._process_async_tasks(futures, was_replayed)
784             futures.clear()
785 
786         previous_output = task_outputs[task_index - 1] if task_outputs else None
787         if previous_output is not None and not task.should_execute(previous_output):
788             self._logger.log(
789                 "debug",
790                 f"Skipping conditional task: {task.description}",
791                 color="yellow",
792             )
793             skipped_task_output = task.get_skipped_task_output()
794 
795             if not was_replayed:
796                 self._store_execution_log(task, skipped_task_output, task_index)
797             return skipped_task_output
798         return None
799 
800     def _prepare_tools(self, agent: BaseAgent, task: Task, tools: List[Tool]) -> List[Tool]:
801         # Add delegation tools if agent allows delegation
802         if agent.allow_delegation:
803             if self.process == Process.hierarchical:
804                 if self.manager_agent:
805                     tools = self._update_manager_tools(task, tools)
806                 else:
807                     raise ValueError("Manager agent is required for hierarchical process.")
808 
809             elif agent and agent.allow_delegation:
810                 tools = self._add_delegation_tools(task, tools)
811 
812         # Add code execution tools if agent allows code execution
813         if agent.allow_code_execution:
814             tools = self._add_code_execution_tools(agent, tools)
815 
816         if agent and agent.multimodal:
817             tools = self._add_multimodal_tools(agent, tools)
818 
819         return tools
820 
821     def _get_agent_to_use(self, task: Task) -> Optional[BaseAgent]:
822         if self.process == Process.hierarchical:
823             return self.manager_agent
824         return task.agent
825 
826     def _merge_tools(self, existing_tools: List[Tool], new_tools: List[Tool]) -> List[Tool]:
827         """Merge new tools into existing tools list, avoiding duplicates by tool name."""
828         if not new_tools:
829             return existing_tools
830 
831         # Create mapping of tool names to new tools
832         new_tool_map = {tool.name: tool for tool in new_tools}
833 
834         # Remove any existing tools that will be replaced
835         tools = [tool for tool in existing_tools if tool.name not in new_tool_map]
836 
837         # Add all new tools
838         tools.extend(new_tools)
839 
840         return tools
841 
842     def _inject_delegation_tools(self, tools: List[Tool], task_agent: BaseAgent, agents: List[BaseAgent]):
843         delegation_tools = task_agent.get_delegation_tools(agents)
844         return self._merge_tools(tools, delegation_tools)
845 
846     def _add_multimodal_tools(self, agent: BaseAgent, tools: List[Tool]):
847         multimodal_tools = agent.get_multimodal_tools()
848         return self._merge_tools(tools, multimodal_tools)
849 
850     def _add_code_execution_tools(self, agent: BaseAgent, tools: List[Tool]):
851         code_tools = agent.get_code_execution_tools()
852         return self._merge_tools(tools, code_tools)
853 
854     def _add_delegation_tools(self, task: Task, tools: List[Tool]):
855         agents_for_delegation = [agent for agent in self.agents if agent != task.agent]
856         if len(self.agents) > 1 and len(agents_for_delegation) > 0 and task.agent:
857             if not tools:
858                 tools = []
859             tools = self._inject_delegation_tools(tools, task.agent, agents_for_delegation)
860         return tools
861 
862     def _log_task_start(self, task: Task, role: str = "None"):
863         if self.output_log_file:
864             self._file_handler.log(
865                 task_name=task.name, task=task.description, agent=role, status="started"
866             )
867 
868     def _update_manager_tools(self, task: Task, tools: List[Tool]):
869         if self.manager_agent:
870             if task.agent:
871                 tools = self._inject_delegation_tools(tools, task.agent, [task.agent])
872             else:
873                 tools = self._inject_delegation_tools(tools, self.manager_agent, self.agents)
874         return tools
875 
876     def _get_context(self, task: Task, task_outputs: List[TaskOutput]):
877         context = (
878             aggregate_raw_outputs_from_tasks(task.context)
879             if task.context
880             else aggregate_raw_outputs_from_task_outputs(task_outputs)
881         )
882         return context
883 
884     def _process_task_result(self, task: Task, output: TaskOutput) -> None:
885         role = task.agent.role if task.agent is not None else "None"
886         if self.output_log_file:
887             self._file_handler.log(
888                 task_name=task.name,
889                 task=task.description,
890                 agent=role,
891                 status="completed",
892                 output=output.raw,
893             )
894 
895     def _create_crew_output(self, task_outputs: List[TaskOutput]) -> CrewOutput:
896         if len(task_outputs) != 1:
897             raise ValueError(
898                 "Something went wrong. Kickoff should return only one task output."
899             )
900         final_task_output = task_outputs[0]
901         final_string_output = final_task_output.raw
902         self._finish_execution(final_string_output)
903         token_usage = self.calculate_usage_metrics()
904 
905         return CrewOutput(
906             raw=final_task_output.raw,
907             pydantic=final_task_output.pydantic,
908             json_dict=final_task_output.json_dict,
909             tasks_output=[task.output for task in self.tasks if task.output],
910             token_usage=token_usage,
911         )
912 
913     def _process_async_tasks(
914         self,
915         futures: List[Tuple[Task, Future[TaskOutput], int]],
916         was_replayed: bool = False,
917     ) -> List[TaskOutput]:
918         task_outputs: List[TaskOutput] = []
919         for future_task, future, task_index in futures:
920             task_output = future.result()
921             task_outputs.append(task_output)
922             self._process_task_result(future_task, task_output)
923             self._store_execution_log(
924                 future_task, task_output, task_index, was_replayed
925             )
926         return task_outputs
927 
928     def _find_task_index(
929         self, task_id: str, stored_outputs: List[Any]
930     ) -> Optional[int]:
931         return next(
932             (
933                 index
934                 for (index, d) in enumerate(stored_outputs)
935                 if d["task_id"] == str(task_id)
936             ),
937             None,
938         )
939 
940     def replay(
941         self, task_id: str, inputs: Optional[Dict[str, Any]] = None
942     ) -> CrewOutput:
943         stored_outputs = self._task_output_handler.load()
944         if not stored_outputs:
945             raise ValueError(f"Task with id {task_id} not found in the crew's tasks.")
946 
947         start_index = self._find_task_index(task_id, stored_outputs)
948 
949         if start_index is None:
950             raise ValueError(f"Task with id {task_id} not found in the crew's tasks.")
951 
952         replay_inputs = (
953             inputs if inputs is not None else stored_outputs[start_index]["inputs"]
954         )
955         self._inputs = replay_inputs
956 
957         if replay_inputs:
958             self._interpolate_inputs(replay_inputs)
959 
960         if self.process == Process.hierarchical:
961             self._create_manager_agent()
962 
963         for i in range(start_index):
964             stored_output = stored_outputs[i][
965                 "output"
966             ]  # for adding context to the task
967             task_output = TaskOutput(
968                 description=stored_output["description"],
969                 agent=stored_output["agent"],
970                 raw=stored_output["raw"],
971                 pydantic=stored_output["pydantic"],
972                 json_dict=stored_output["json_dict"],
973                 output_format=stored_output["output_format"],
974             )
975             self.tasks[i].output = task_output
976 
977         self._logging_color = "bold_blue"
978         result = self._execute_tasks(self.tasks, start_index, True)
979         return result
980 
981     def query_knowledge(self, query: List[str]) -> Union[List[Dict[str, Any]], None]:
982         if self._knowledge:
983             return self._knowledge.query(query)
984         return None
