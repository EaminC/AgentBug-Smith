423     @model_validator(mode="after")
424     def validate_context_no_future_tasks(self):
425         """Validates that a task's context does not include future tasks."""
426         task_indices = {id(task): i for i, task in enumerate(self.tasks)}
427 
428         for task in self.tasks:
429             if task.context:
430                 for context_task in task.context:
431                     if id(context_task) not in task_indices:
432                         continue  # Skip context tasks not in the main tasks list
433                     if task_indices[id(context_task)] > task_indices[id(task)]:
434                         raise ValueError(
435                             f"Task '{task.description}' has a context dependency on a future task '{context_task.description}', which is not allowed."
436                         )
437         return self
