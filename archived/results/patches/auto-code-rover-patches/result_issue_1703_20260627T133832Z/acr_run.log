567     def kickoff_for_each(self, inputs: List[Dict[str, Any]]) -> List[CrewOutput]:
568         """Executes the Crew's workflow for each input in the list and aggregates results."""
569         results: List[CrewOutput] = []
570 
571         # Initialize the parent crew's usage metrics
572         total_usage_metrics = UsageMetrics()
573 
574         for input_data in inputs:
575             crew = self.copy()
576 
577             output = crew.kickoff(inputs=input_data)
578 
579             if crew.usage_metrics:
580                 total_usage_metrics.add_usage_metrics(crew.usage_metrics)
581 
582             results.append(output)
583 
584         self.usage_metrics = total_usage_metrics
585         self._task_output_handler.reset()
586         return results
