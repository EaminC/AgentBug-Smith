49         return Agent(
50             role="Task Execution Planner",
51             goal=(
52                 "Your goal is to create an extremely detailed, step-by-step plan based on the tasks and tools "
53                 "available to each agent so that they can perform the tasks in an exemplary manner"
54             ),
55             backstory="Planner agent for crew planning",
56             llm=self.planning_agent_llm,
57         )
58 
59     def _create_planner_task(self, planning_agent: Agent, tasks_summary: str) -> Task:
60         """Creates the planner task using the given agent and tasks summary."""
61         return Task(
62             description=(
63                 f"Based on these tasks summary: {tasks_summary} \n Create the most descriptive plan based on the tasks "
64                 "descriptions, tools available, and agents' goals for them to execute their goals with perfection."
65             ),
66             expected_output="Step by step plan on how the agents can execute their tasks using the available tools with mastery",
67             agent=planning_agent,
68             output_pydantic=PlannerTaskPydanticOutput,
69         )
70 
71     def _create_tasks_summary(self) -> str:
72         """Creates a summary of all tasks."""
73         tasks_summary = []
74         for idx, task in enumerate(self.tasks):
75             tasks_summary.append(
76                 f"""
77                 Task Number {idx + 1} - {task.description}
78                 "task_description": {task.description}
79                 "task_expected_output": {task.expected_output}
80                 "agent": {task.agent.role if task.agent else "None"}
81                 "agent_goal": {task.agent.goal if task.agent else "None"}
82                 "task_tools": {task.tools}
83                 "agent_tools": {task.agent.tools if task.agent else "None"}
84                 """
85             )
86         return " ".join(tasks_summary)

