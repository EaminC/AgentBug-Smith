446     def _setup_from_config(self):
447         assert self.config is not None, "Config should not be None."
448 
449         """Initializes agents and tasks from the provided config."""
450         if not self.config.get("agents") or not self.config.get("tasks"):
451             raise PydanticCustomError(
452                 "missing_keys_in_config", "Config should have 'agents' and 'tasks'.", {}
453             )
454 
455         self.process = self.config.get("process", self.process)
456         self.agents = [Agent(**agent) for agent in self.config["agents"]]
457         self.tasks = [self._create_task(task) for task in self.config["tasks"]]
458 
459     def _create_task(self, task_config: Dict[str, Any]) -> Task:
460         """Creates a task instance from its configuration.
461 
462         Args:
463             task_config: The configuration of the task.
464 
465         Returns:
466             A task instance.
467         """
468         task_agent = next(
469             agt for agt in self.agents if agt.role == task_config["agent"]
470         )
471         del task_config["agent"]
472         return Task(**task_config, agent=task_agent)
473 
474     def _setup_for_training(self, filename: str) -> None:
475         """Sets up the crew for training."""
476         self._train = True
477 
478         for task in self.tasks:
479             task.human_input = True
480 
481         for agent in self.agents:
482             agent.allow_delegation = False
483 
484         CrewTrainingHandler(TRAINING_DATA_FILE).initialize_file()
485         CrewTrainingHandler(filename).initialize_file()
486 
487     def train(
488         self, n_iterations: int, filename: str, inputs: Optional[Dict[str, Any]] = {}
489     ) -> None:
490         """Trains the crew for a given number of iterations."""
491         train_crew = self.copy()
492         train_crew._setup_for_training(filename)
493 
494         for n_iteration in range(n_iterations):
495             train_crew._train_iteration = n_iteration
496             train_crew.kickoff(inputs=inputs)
497 
498         training_data = CrewTrainingHandler(TRAINING_DATA_FILE).load()
499 
500         for agent in train_crew.agents:
501             if training_data.get(str(agent.id)):
502                 result = TaskEvaluator(agent).evaluate_training_data(
503                     training_data=training_data, agent_id=str(agent.id)
504                 )
505 
506                 CrewTrainingHandler(filename).save_trained_data(
507                     agent_id=str(agent.role), trained_data=result.model_dump()
508                 )
509 
510     def kickoff(
511         self,
512         inputs: Optional[Dict[str, Any]] = None,
513     ) -> CrewOutput:
514         for before_callback in self.before_kickoff_callbacks:
515             inputs = before_callback(inputs)
516 
517         """Starts the crew to work on its assigned tasks."""
518         self._execution_span = self._telemetry.crew_execution_span(self, inputs)
519         self._task_output_handler.reset()
520         self._logging_color = "bold_purple"
521 
522         if inputs is not None:
523             self._inputs = inputs
524             self._interpolate_inputs(inputs)
525         self._set_tasks_callbacks()
526 
527         i18n = I18N(prompt_file=self.prompt_file)
528 
529         for agent in self.agents:
530             agent.i18n = i18n
531             # type: ignore[attr-defined] # Argument 1 to "_interpolate_inputs" of "Crew" has incompatible type "dict[str, Any] | None"; expected "dict[str, Any]"
532             agent.crew = self  # type: ignore[attr-defined]
533             # TODO: Create an AgentFunctionCalling protocol for future refactoring
534             if not agent.function_calling_llm:  # type: ignore # "BaseAgent" has no attribute "function_calling_llm"
535                 agent.function_calling_llm = self.function_calling_llm  # type: ignore # "BaseAgent" has no attribute "function_calling_llm"
536 
537             if not agent.step_callback:  # type: ignore # "BaseAgent" has no attribute "step_callback"
538                 agent.step_callback = self.step_callback  # type: ignore # "BaseAgent" has no attribute "step_callback"
539 
540             agent.create_agent_executor()
541 
542         if self.planning:
543             self._handle_crew_planning()
544 
545         metrics: List[UsageMetrics] = []
546 
547         if self.process == Process.sequential:
548             result = self._run_sequential_process()
549         elif self.process == Process.hierarchical:
550             result = self._run_hierarchical_process()
551         else:
552             raise NotImplementedError(
553                 f"The process '{self.process}' is not implemented yet."
554             )
555 
556         for after_callback in self.after_kickoff_callbacks:
557             result = after_callback(result)
558 
559         metrics += [agent._token_process.get_summary() for agent in self.agents]
560 
561         self.usage_metrics = UsageMetrics()
562         for metric in metrics:
563             self.usage_metrics.add_usage_metrics(metric)
564 
565         return result
566 
567     def kickoff_for_each(self, inputs: List[Dict[str, Any]]) -> List[CrewOutput]:
568         """Executes the Crew's workflow for each input in the list and aggregates results."""
569         results: List[CrewOutput] = []
570 
571         # Initialize the parent crew's usage metrics
572         total_usage_metrics = UsageMetrics()
573 
574         for input_data in inputs:
575             crew = self.copy()
576 
577             output = crew.kickoff(inputs=input_data)
578 
579             if crew.usage_metrics:
580                 total_usage_metrics.add_usage_metrics(crew.usage_metrics)
581 
582             results.append(output)
583 
584         self.usage_metrics = total_usage_metrics
585         self._task_output_handler.reset()
586         return results
587 
588     async def kickoff_async(self, inputs: Optional[Dict[str, Any]] = {}) -> CrewOutput:
589         """Asynchronous kickoff method to start the crew execution."""
590         return await asyncio.to_thread(self.kickoff, inputs)
591 
592     async def kickoff_for_each_async(self, inputs: List[Dict]) -> List[CrewOutput]:
593         crew_copies = [self.copy() for _ in inputs]
594 
595         async def run_crew(crew, input_data):
596             return await crew.kickoff_async(inputs=input_data)
597 
598         tasks = [
599             asyncio.create_task(run_crew(crew_copies[i], inputs[i]))
600             for i in range(len(inputs))
601         ]
602 
603         results = await asyncio.gather(*tasks)
604 
605         total_usage_metrics = UsageMetrics()
606         for crew in crew_copies:
607             if crew.usage_metrics:
608                 total_usage_metrics.add_usage_metrics(crew.usage_metrics)
609 
610         self.usage_metrics = total_usage_metrics
611         self._task_output_handler.reset()
612         return results
