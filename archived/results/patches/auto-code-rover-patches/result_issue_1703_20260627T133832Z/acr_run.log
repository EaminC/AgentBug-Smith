986     def copy(self):
987         """Create a deep copy of the Crew."""
988 
989         exclude = {
990             "id",
991             "_rpm_controller",
992             "_logger",
993             "_execution_span",
994             "_file_handler",
995             "_cache_handler",
996             "_short_term_memory",
997             "_long_term_memory",
998             "_entity_memory",
999             "_telemetry",
1000             "agents",
1001             "tasks",
1002         }
1003 
1004         cloned_agents = [agent.copy() for agent in self.agents]
1005 
1006         task_mapping = {}
1007 
1008         cloned_tasks = []
1009         for task in self.tasks:
1010             cloned_task = task.copy(cloned_agents, task_mapping)
1011             cloned_tasks.append(cloned_task)
1012             task_mapping[task.key] = cloned_task
1013 
1014         for cloned_task, original_task in zip(cloned_tasks, self.tasks):
1015             if original_task.context:
1016                 cloned_context = [
1017                     task_mapping[context_task.key]
1018                     for context_task in original_task.context
1019                 ]
1020                 cloned_task.context = cloned_context
1021 
1022         copied_data = self.model_dump(exclude=exclude)
1023         copied_data = {k: v for k, v in copied_data.items() if v is not None}
1024 
1025         copied_data.pop("agents", None)
1026         copied_data.pop("tasks", None)
1027 
1028         copied_crew = Crew(**copied_data, agents=cloned_agents, tasks=cloned_tasks)
1029 
1030         return copied_crew
1031 
1032     def _set_tasks_callbacks(self) -> None:
1033         """Sets callback for every task suing task_callback"""
1034         for task in self.tasks:
1035             if not task.callback:
1036                 task.callback = self.task_callback
1037 
1038     def _interpolate_inputs(self, inputs: Dict[str, Any]) -> None:
1039         """Interpolates the inputs in the tasks and agents."""
1040         [
1041             task.interpolate_inputs(
1042                 # type: ignore # "interpolate_inputs" of "Task" does not return a value (it only ever returns None)
1043                 inputs
1044             )
1045             for task in self.tasks
1046         ]
1047         # type: ignore # "interpolate_inputs" of "Agent" does not return a value (it only ever returns None)
1048         for agent in self.agents:
1049             agent.interpolate_inputs(inputs)
1050 
1051     def _finish_execution(self, final_string_output: str) -> None:
1052         if self.max_rpm:
1053             self._rpm_controller.stop_rpm_counter()
1054         if agentops:
1055             agentops.end_session(
1056                 end_state="Success",
1057                 end_state_reason="Finished Execution",
1058                 is_auto_end=True,
1059             )
1060         self._telemetry.end_crew(self, final_string_output)
1061 
1062     def calculate_usage_metrics(self) -> UsageMetrics:
1063         """Calculates and returns the usage metrics."""
1064         total_usage_metrics = UsageMetrics()
1065         for agent in self.agents:
1066             if hasattr(agent, "_token_process"):
1067                 token_sum = agent._token_process.get_summary()
1068                 total_usage_metrics.add_usage_metrics(token_sum)
1069         if self.manager_agent and hasattr(self.manager_agent, "_token_process"):
1070             token_sum = self.manager_agent._token_process.get_summary()
1071             total_usage_metrics.add_usage_metrics(token_sum)
1072         self.usage_metrics = total_usage_metrics
1073         return total_usage_metrics
1074 
1075     def test(
1076         self,
1077         n_iterations: int,
1078         openai_model_name: Optional[str] = None,
1079         inputs: Optional[Dict[str, Any]] = None,
1080     ) -> None:
1081         """Test and evaluate the Crew with the given inputs for n iterations concurrently using concurrent.futures."""
1082         test_crew = self.copy()
1083 
1084         self._test_execution_span = test_crew._telemetry.test_execution_span(
1085             test_crew,
1086             n_iterations,
1087             inputs,
1088             openai_model_name,  # type: ignore[arg-type]
1089         )  # type: ignore[arg-type]
1090         evaluator = CrewEvaluator(test_crew, openai_model_name)  # type: ignore[arg-type]
1091 
1092         for i in range(1, n_iterations + 1):
1093             evaluator.set_iteration(i)
1094             test_crew.kickoff(inputs=inputs)
1095 
1096         evaluator.print_crew_evaluation_result()
1097 
