510     def kickoff(
511         self,
512         inputs: Optional[Dict[str, Any]] = None,
513     ) -> CrewOutput:
514         for before_callback in self.before_kickoff_callbacks:
515             inputs = before_callback(inputs)
516 
517         """Starts the crew to work on its assigned tasks."""
518         self._execution_span = self._telemetry.crew_execution_span(self, inputs)
519         self._task_output_handler.reset()
520         self._logging_color = "bold_purple"
521 
522         if inputs is not None:
523             self._inputs = inputs
524             self._interpolate_inputs(inputs)
525         self._set_tasks_callbacks()
526 
527         i18n = I18N(prompt_file=self.prompt_file)
528 
529         for agent in self.agents:
530             agent.i18n = i18n
531             # type: ignore[attr-defined] # Argument 1 to "_interpolate_inputs" of "Crew" has incompatible type "dict[str, Any] | None"; expected "dict[str, Any]"
532             agent.crew = self  # type: ignore[attr-defined]
533             # TODO: Create an AgentFunctionCalling protocol for future refactoring
534             if not agent.function_calling_llm:  # type: ignore # "BaseAgent" has no attribute "function_calling_llm"
535                 agent.function_calling_llm = self.function_calling_llm  # type: ignore # "BaseAgent" has no attribute "function_calling_llm"
536 
537             if not agent.step_callback:  # type: ignore # "BaseAgent" has no attribute "step_callback"
538                 agent.step_callback = self.step_callback  # type: ignore # "BaseAgent" has no attribute "step_callback"
539 
540             agent.create_agent_executor()
541 
542         if self.planning:
543             self._handle_crew_planning()
544 
545         metrics: List[UsageMetrics] = []
546 
547         if self.process == Process.sequential:
548             result = self._run_sequential_process()
549         elif self.process == Process.hierarchical:
550             result = self._run_hierarchical_process()
551         else:
552             raise NotImplementedError(
553                 f"The process '{self.process}' is not implemented yet."
554             )
555 
556         for after_callback in self.after_kickoff_callbacks:
557             result = after_callback(result)
558 
559         metrics += [agent._token_process.get_summary() for agent in self.agents]
560 
561         self.usage_metrics = UsageMetrics()
562         for metric in metrics:
563             self.usage_metrics.add_usage_metrics(metric)
564 
565         return result
