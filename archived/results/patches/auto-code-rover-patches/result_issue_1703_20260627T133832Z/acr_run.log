1075     def test(
1076         self,
1077         n_iterations: int,
1078         openai_model_name: Optional[str] = None,
1079         inputs: Optional[Dict[str, Any]] = None,
1080     ) -> None:
1081         """Test and evaluate the Crew with the given inputs for n iterations concurrently using concurrent.futures."""
1082         test_crew = self.copy()
1083 
1084         self._test_execution_span = test_crew._telemetry.test_execution_span(
1085             test_crew,
1086             n_iterations,
