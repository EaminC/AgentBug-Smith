114 @cli.command()
115 @click.pass_context
116 @click.argument('path', default='./')
117 @click.option('--email', default=None, help='The email of the user.')
118 @click.option('--start-date', default=None, help='The start date of the user activity (YYYY-MM-DD).')
119 @click.option('--end-date', default=None, help='The end date of the user activity (YYYY-MM-DD).')
120 def report_local(ctx, path, email, start_date, end_date):
121     """
122     report_local: generate report with LLM for local git repo.
123     """
124     if not check_config(console):
125         return
126 
127     if email is None:
128         email = questionary.text(
129             "What is your Git email? (e.g., huangyz0918@gmail.com)"
130         ).ask()
131 
132     return workflow.report_local(os.getcwd(), path, email, start_date=start_date, end_date=end_date)
