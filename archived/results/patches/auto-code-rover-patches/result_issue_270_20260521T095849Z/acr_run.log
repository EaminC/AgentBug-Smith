135 @cli.command()
136 @click.option('--model', default=None, help='The model to use for the chat.')
137 @click.option('--auto', is_flag=True, help='Use auto mode to generate the coding plan.')
138 @click.option('--description', default=None, help='The description of the competition.')
139 @click.option('--datasets', default=None, help='The .csv dataset home to use for the competition.')
