28 @click.group()
29 @click.version_option(version=mle.__version__)
30 def cli():
31     """
32     MLE-Agent: The CLI tool to build machine learning projects.
33     """
34     pass
35 
36 
37 @cli.command()
38 @click.pass_context
39 @click.argument('mode', default='baseline')
40 @click.option('--model', default=None, help='The model to use for the chat.')
41 def start(ctx, mode, model):
42     """
43     start: start the chat with LLM.
44     """
45     if not check_config(console):
46         return
47 
48     if mode == 'baseline':
49         # Baseline mode
50         return workflow.baseline(os.getcwd(), model)
51     elif mode == 'report':
52         # Report mode
53         return ctx.invoke(report, model=model, visualize=False)
54     elif mode == 'kaggle':
55         # Kaggle mode
56         return ctx.invoke(kaggle, model=model)
57     elif mode == 'chat':
58         # Chat mode
59         return ctx.invoke(chat, model=model)
60     else:
61         raise ValueError("Invalid mode. Supported modes: 'baseline', 'report', 'kaggle'.")
62 
63 
64 @cli.command()
65 @click.pass_context
66 @click.argument('repo', required=False)
67 @click.option('--model', default=None, help='The model to use for the chat.')
68 @click.option('--user', default=None, help='The GitHub username.')
69 @click.option('--visualize', default=True, help='Visualize the report in browser.')
70 def report(ctx, repo, model, user, visualize):
71     """
72     report: generate report with LLM.
73     """
74     if visualize:
75         print_in_box(
76             "✨ Your MLE Agent is starting! \n"
77             "Access to generate your report: "
78             "[blue underline]http://localhost:3000/[/blue underline]",
79             console=console, title="MLE Report", color="green"
80         )
81         from concurrent.futures import ThreadPoolExecutor
82 
83         with ThreadPoolExecutor() as executor:
84             future1 = executor.submit(ctx.invoke, serve)
85             future2 = executor.submit(ctx.invoke, web)
86             future1.result()
87             future2.result()
88     else:
89         if repo is None:
90             repo = questionary.text(
91                 "What is your GitHub repository? (e.g., MLSysOps/MLE-agent)"
92             ).ask()
93 
94         if user is None:
95             user = questionary.text(
96                 "What is your GitHub username? (e.g., huangyz0918)"
97             ).ask()
98 
99         if not re.match(r'.*/.*', repo):
100             console.log("Invalid github repository, "
101                         "Usage: 'mle report <organization/name>'")
102             return False
103 
104         if not check_config(console):
105             # build a new project for GitHub report generating
106             project_name = f"mle-report-{repo.replace('/', '_').lower()}"
107             ctx.invoke(new, name=project_name)
108             work_dir = os.path.join(os.getcwd(), project_name)
109             os.chdir(work_dir)
110             return workflow.report(work_dir, repo, user, model)
111         return workflow.report(os.getcwd(), repo, user, model)
112 
