105     def __init__(
106         self,
107         name: str,
108         system_prompt: str,
109         model: ChatModelBase,
110         toolkit: Toolkit | None = None,
111         middlewares: list[MiddlewareBase] | None = None,
112         state: AgentState | None = None,
113         offloader: Offloader | None = None,
114         # The agent configurations
115         model_config: ModelConfig | None = None,
116         context_config: ContextConfig | None = None,
117         react_config: ReActConfig | None = None,
118     ) -> None:
119         """Initialize the agent class in AgentScope.
120 
121         Args:
122             name (`str`):
123                 The agent identifier.
124             system_prompt (`str`):
125                 The agent's system prompt. Additional instructions may be
126                 appended to it dynamically during operation.
127             model (`ChatModelBase`):
128                 The chat model/llm used for this agent.
129             toolkit (`Toolkit | None`, optional):
130                 The toolkit used for registering tools, MCPs and skills as the
131                 sole source.
132             middlewares (`list[MiddlewareBase] | None`, optional):
133                 Middlewares applied to the agent to modify its behavior
134                 without altering its source code. Supported hook points
135                 include: reply, reasoning, acting, model call, and system
136                 prompt retrieval.
137             state (`AgentState | None`, optional):
138                 The agent state. A new state will be created if not provided.
139             offloader (`Offloader | None`, optional):
140                 The context offloader. If provided, the compressed context and
141                 tool result will be offloaded.
142             model_config (`ModelConfig | None`, optional):
143                 The additional chat model configuration including fallback
144                 model and retries.
145             context_config (`ContextConfig | None`, optional):
146                 The context config for context compression and tool result
147                 compression.
148             react_config (`ReActConfig | None`, optional):
149                 The config for the reasoning-acting loop.
150         """
151         self.name = name
152         self._system_prompt = system_prompt
153         self.model = model
154         self.state = state or AgentState()
155 
156         self.model_config = model_config or ModelConfig()
157         self.context_config = context_config or ContextConfig()
158         self.react_config = react_config or ReActConfig()
159 
160         # The permission engine
161         self._engine = PermissionEngine(self.state.permission_context)
162 
163         # The offloader/workspace
164         self.offloader = offloader
165 
166         # ====================================================================
167         # The Tool-related logics
168         # ====================================================================
169         self.toolkit = toolkit or Toolkit()
170 
171         # ====================================================================
172         # The Middleware-related attributes
173         # ====================================================================
174         # Filter middlewares by implemented hooks (only once)
175         middlewares = middlewares or []
176         self._reply_middlewares = [
177             _ for _ in middlewares if _.is_implemented("on_reply")
178         ]
179         self._reasoning_middlewares = [
180             _ for _ in middlewares if _.is_implemented("on_reasoning")
181         ]
182         self._acting_middlewares = [
183             _ for _ in middlewares if _.is_implemented("on_acting")
184         ]
185         self._model_call_middlewares = [
186             _ for _ in middlewares if _.is_implemented("on_model_call")
187         ]
188         self._system_prompt_middlewares = [
189             _ for _ in middlewares if _.is_implemented("on_system_prompt")
190         ]
191         self._compress_context_middlewares = [
192             _ for _ in middlewares if _.is_implemented("on_compress_context")
193         ]
