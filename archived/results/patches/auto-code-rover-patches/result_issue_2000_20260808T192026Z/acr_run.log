199     async def reply_stream(
200         self,
201         inputs: Msg
202         | list[Msg]
203         | UserConfirmResultEvent
204         | UserInterruptEvent
205         | ExternalExecutionResultEvent
206         | None = None,
207     ) -> AsyncGenerator[AgentEvent, None]:
208         """Reply to the given inputs and stream agent events.
209 
210         Args:
211             inputs (`Msg | list[Msg] | UserConfirmResultEvent | \
212             UserInterruptEvent | ExternalExecutionResultEvent | None`, \
213             optional):
214                 The inputs that trigger this reply. See :meth:`reply` for
215                 the full list of accepted variants.
216 
217         Yields:
218             `AgentEvent`:
219                 Streamed events produced during the reply.
220 
221         .. note:: If requiring outside interaction for multiple tool calls
222             and only receive partial confirmation or execution results, the
223             agent won't re-send the requiring events for the unconfirmed
224             or unexecuted tool calls.
225         """
226         async for chunk in self._reply(inputs=inputs):
227             if not isinstance(chunk, Msg):
228                 yield chunk
