187     async def _load_tools_from_session(self, server_name: str, session: ClientSession) -> None:
188         """
189         Load tools from a given MCP session and convert them to AgentTools.
190         
191         Args:
192             server_name: Unique identifier for this server
193             session: The MCP client session
194         """
195         logger.debug(f"Loading tools from server '{server_name}'")
196         
197         try:
198             # Get tools from the server
199             tools_response = await session.list_tools()
200             
201             # Convert MCP tools to agent tools
202             converted_tools = []
203             for mcp_tool in tools_response.tools:
204                 # Skip tools not in allowed_tools if filtering is enabled
205                 if self.allowed_tools and mcp_tool.name not in self.allowed_tools:
206                     logger.debug(f"Skipping tool '{mcp_tool.name}' (not in allowed_tools)")
207                     continue
208                 
209                 try:
210                     agent_tool = await self.wrap_mcp_tool(server_name, mcp_tool)
211                     converted_tools.append(agent_tool)
212                 except Exception as e:
213                     logger.warning(f"Failed to convert tool '{mcp_tool.name}': {str(e)}")
214             
215             self._server_tools[server_name] = converted_tools
216             logger.info(f"Loaded {len(converted_tools)} tools from server '{server_name}'")
217         except Exception as e:
218             logger.warning(f"Failed to load tools from server '{server_name}': {str(e)}")
219             self._server_tools[server_name] = []
220     
221     async def _load_prompts_from_session(self, server_name: str, session: ClientSession) -> None:
222         """
223         Load prompts from a given MCP session.
224         
225         Args:
226             server_name: Unique identifier for this server
227             session: The MCP client session
228         """
229         logger.debug(f"Loading prompts from server '{server_name}'")
230         try:
231             response = await session.list_prompts()
232             prompt_dict = {prompt.name: prompt for prompt in response.prompts}
233             self._server_prompts[server_name] = prompt_dict
234 
235             loaded = [
236                 f"{p.name} ({len(p.arguments or [])} args)" 
237                 for p in response.prompts
238             ]
239             logger.info(
240                 f"Loaded {len(loaded)} prompts from server '{server_name}': " +
241                 ", ".join(loaded)
242             )
243         except Exception as e:
244             logger.warning(f"Failed to load prompts from server '{server_name}': {str(e)}")
245             self._server_prompts[server_name] = []
