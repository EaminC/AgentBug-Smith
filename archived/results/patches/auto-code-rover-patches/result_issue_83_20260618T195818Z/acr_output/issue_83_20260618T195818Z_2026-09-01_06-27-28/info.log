277     async def wrap_mcp_tool(self, server_name: str, mcp_tool: MCPTool) -> AgentTool:
278         """
279         Wrap an MCPTool as an AgentTool with dynamic session creation at runtime,
280         based on stored server configuration.
281 
282         Args:
283             server_name: The MCP server that registered the tool.
284             mcp_tool: The MCPTool object describing the tool.
285 
286         Returns:
287             An AgentTool instance that can be executed by the agent.
288 
289         Raises:
290             ToolError: If the tool cannot be executed or configuration is missing.
291         """
292         tool_name = f"{server_name}_{mcp_tool.name}"
293         tool_docs = f"{mcp_tool.description or ''} (from MCP server: {server_name})"
294 
295         logger.debug(f"Wrapping MCP tool: {tool_name}")
296 
297         def build_executor(client: MCPClient, server_name: str, tool_name: str):
298             async def executor(**kwargs: Any) -> Any:
299                 """
300                 Execute the tool using a dynamically created session context.
301 
302                 Args:
303                     kwargs: Input arguments to the tool.
304 
305                 Returns:
306                     Result from the tool execution.
307 
308                 Raises:
309                     ToolError: If execution fails or response is malformed.
310                 """
311                 logger.info(f"[MCP] Executing tool '{tool_name}' with args: {kwargs}")
312                 try:
313                     async with client.create_session(server_name) as session:
314                         result = await session.call_tool(tool_name, kwargs)
315                         logger.debug(f"[MCP] Received result from tool '{tool_name}'")
316                         return client._process_tool_result(result)
317                 except Exception as e:
318                     logger.exception(f"Execution failed for '{tool_name}'")
319                     raise ToolError(f"Error executing tool '{tool_name}': {str(e)}") from e
320 
321             return executor
322 
323         # Build executor using dynamic context-managed session resolution
324         tool_func = build_executor(self, server_name, mcp_tool.name)
325 
326         # Optionally generate args model from input schema
327         args_model = None
328         if getattr(mcp_tool, "inputSchema", None):
329             try:
330                 from dapr_agents.tool.mcp.schema import create_pydantic_model_from_schema
331                 args_model = create_pydantic_model_from_schema(
332                     mcp_tool.inputSchema, f"{tool_name}Args"
333                 )
334                 logger.debug(f"Generated argument model for tool '{tool_name}'")
335             except Exception as e:
336                 logger.warning(f"Failed to create schema for tool '{tool_name}': {str(e)}")
337 
338         return AgentTool(
339             name=tool_name,
340             description=tool_docs,
341             func=tool_func,
342             args_model=args_model,
343         )
