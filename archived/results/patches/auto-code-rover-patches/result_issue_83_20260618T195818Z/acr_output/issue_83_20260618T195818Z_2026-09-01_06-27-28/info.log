247     async def _create_ephemeral_session(self, server_name: str) -> ClientSession:
248         """
249         Create a fresh session for a single tool call.
250 
251         Args:
252             server_name: The MCP server to connect to.
253 
254         Returns:
255             A fully initialized ephemeral ClientSession.
256         """
257         config = self._server_configs.get(server_name)
258         if not config:
259             raise ToolError(f"No stored config found for server '{server_name}'")
260 
261         try:
262             if config["type"] == "stdio":
263                 from dapr_agents.tool.mcp.transport import connect_stdio
264                 session = await connect_stdio(**config["params"], stack=self._exit_stack)
265             elif config["type"] == "sse":
266                 from dapr_agents.tool.mcp.transport import connect_sse
267                 session = await connect_sse(**config["params"], stack=self._exit_stack)
268             else:
269                 raise ToolError(f"Unknown transport type: {config['type']}")
270             
271             await session.initialize()
272             return session
273         except Exception as e:
274             logger.error(f"Failed to create ephemeral session: {e}")
275             raise ToolError(f"Could not create session for '{server_name}': {e}") from e
