48     async def create_session(self, server_name: str) -> AsyncGenerator[ClientSession, None]:
49         """
50         Create an ephemeral session for the given server and yield it.
51         Used during tool execution to avoid reuse issues.
52 
53         Args:
54             server_name: The server to create a session for.
55 
56         Yields:
57             A short-lived, initialized MCP session.
58         """
59         logger.debug(f"[MCP] Creating ephemeral session for server '{server_name}'")
60         session = await self._create_ephemeral_session(server_name)
61         try:
62             yield session
63         finally:
