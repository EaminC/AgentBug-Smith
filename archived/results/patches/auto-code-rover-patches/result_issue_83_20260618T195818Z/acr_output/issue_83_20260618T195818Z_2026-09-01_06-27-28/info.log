18 class MCPClient(BaseModel):
19     """
20     Client for connecting to MCP servers and integrating their tools with the Dapr agent framework.
21 
22     This client manages connections to one or more MCP servers, retrieves their tools,
23     and converts them to native AgentTool objects that can be used in the agent framework.
24 
25     Attributes:
26         allowed_tools: Optional set of tool names to include (when None, all tools are included)
27         server_timeout: Timeout in seconds for server connections
28         sse_read_timeout: Read timeout for SSE connections in seconds
29     """
30     allowed_tools: Optional[Set[str]] = Field(default=None, description="Optional set of tool names to include (when None, all tools are included)")
31     server_timeout: float = Field(default=5.0, description="Timeout in seconds for server connections")
32     sse_read_timeout: float = Field(default=300.0, description="Read timeout for SSE connections in seconds")
33 
34     # Private attributes not exposed in model schema
35     _exit_stack: AsyncExitStack = PrivateAttr(default_factory=AsyncExitStack)
36     _sessions: Dict[str, ClientSession] = PrivateAttr(default_factory=dict)
37     _server_tools: Dict[str, List[AgentTool]] = PrivateAttr(default_factory=dict)
38     _server_prompts: Dict[str, Dict[str, Prompt]] = PrivateAttr(default_factory=dict)
39     _task_locals: Dict[str, Any] = PrivateAttr(default_factory=dict)
40     _server_configs: Dict[str, Dict[str, Any]] = PrivateAttr(default_factory=dict)
41 
42     def model_post_init(self, __context: Any) -> None:
43         """Initialize the client after the model is created."""
44         logger.debug("Initializing MCP client")
45         super().model_post_init(__context)
