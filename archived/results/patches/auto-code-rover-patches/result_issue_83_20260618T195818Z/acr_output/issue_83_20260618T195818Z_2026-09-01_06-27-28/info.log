67     async def connect_stdio(
68         self,
69         server_name: str,
70         command: str,
71         args: List[str],
72         env: Optional[Dict[str, str]] = None
73     ) -> None:
74         """
75         Connect to an MCP server using stdio transport and store the connection
76         metadata for future dynamic reconnection if needed.
77 
78         Args:
79             server_name (str): Unique identifier for this server connection.
80             command (str): Executable to run.
81             args (List[str]): Command-line arguments.
82             env (Optional[Dict[str, str]]): Environment variables for the process.
83 
84         Raises:
85             RuntimeError: If a server with the same name is already connected.
86             Exception: If connection setup or initialization fails.
87         """
88         logger.info(f"Connecting to MCP server '{server_name}' via stdio: {command} {args}")
89 
90         if server_name in self._sessions:
91             raise RuntimeError(f"Server '{server_name}' is already connected")
92 
93         try:
94             self._task_locals[server_name] = asyncio.current_task()
95 
96             from dapr_agents.tool.mcp.transport import connect_stdio as transport_connect_stdio
97             session = await transport_connect_stdio(
98                 command=command,
99                 args=args,
100                 env=env,
101                 stack=self._exit_stack
102             )
103 
104             await session.initialize()
105             self._sessions[server_name] = session
106 
107             # Store how to reconnect this server later
108             self._server_configs[server_name] = {
109                 "type": "stdio",
110                 "params": {"command": command, "args": args, "env": env},
111             }
112 
113             logger.debug(f"Initialized session for server '{server_name}', loading tools and prompts")
114             await self._load_tools_from_session(server_name, session)
115             await self._load_prompts_from_session(server_name, session)
116             logger.info(f"Successfully connected to MCP server '{server_name}'")
117 
118         except Exception as e:
119             logger.error(f"Failed to connect to MCP server '{server_name}': {str(e)}")
120             self._sessions.pop(server_name, None)
121             self._task_locals.pop(server_name, None)
122             self._server_configs.pop(server_name, None)
123             raise
