345     def _process_tool_result(self, result: Any) -> Any:
346         """
347         Process the result from an MCP tool call.
348         
349         Args:
350             result: The result from calling an MCP tool
351             
352         Returns:
353             Processed result in a format expected by AgentTool
354             
355         Raises:
356             ToolError: If the result indicates an error
357         """
358         # Handle error result
359         if hasattr(result, 'isError') and result.isError:
360             error_message = "Unknown error"
361             if hasattr(result, 'content') and result.content:
362                 for content in result.content:
363                     if hasattr(content, 'text'):
364                         error_message = content.text
365                         break
366             raise ToolError(f"MCP tool error: {error_message}")
367         
368         # Extract text content from result
369         if hasattr(result, 'content') and result.content:
370             text_contents = []
371             for content in result.content:
372                 if hasattr(content, 'text'):
373                     text_contents.append(content.text)
374             
375             # Return single string if only one content item
376             if len(text_contents) == 1:
377                 return text_contents[0]
378             elif text_contents:
379                 return text_contents
380                 
381         # Fallback for unexpected formats
382         return str(result)
