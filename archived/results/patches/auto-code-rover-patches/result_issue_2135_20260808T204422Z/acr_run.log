59     def __init__(
60         self,
61         credential: AnthropicCredential,
62         model: str,
63         parameters: "AnthropicChatModel.Parameters | None" = None,
64         stream: bool = True,
65         max_retries: int = 3,
66         retry_delay: float = 1.0,
67         context_size: int = 200000,
68         formatter: FormatterBase | None = None,
69         client_kwargs: dict[str, Any] | None = None,
70     ) -> None:
71         """Initialize the Anthropic chat model.
72 
73         Args:
74             credential (`AnthropicCredential`):
75                 The Anthropic credential used to authenticate API calls.
76             model (`str`):
77                 The Anthropic model name, e.g. ``claude-opus-4-7``.
78             parameters (`AnthropicChatModel.Parameters | None`, defaults to \
79             `None`):
80                 The Anthropic API parameters. When ``None``, the default
81                 parameters will be used.
82             stream (`bool`, defaults to `True`):
83                 Whether to enable streaming output.
84             max_retries (`int`, defaults to `3`):
85                 The maximum number of retries for the Anthropic API.
86             retry_delay (`float`, defaults to `1.0`):
87                 Seconds to sleep between retry attempts.
88             context_size (`int`, defaults to `200000`):
89                 The model context size used for context compression.
90             formatter (`FormatterBase | None`, defaults to `None`):
91                 The formatter that converts ``Msg`` objects to the format
92                 required by the Anthropic API. When ``None``, an
93                 ``AnthropicChatFormatter`` instance will be used.
94             client_kwargs (`dict[str, Any] | None`, defaults to `None`):
95                 Extra keyword arguments forwarded to
96                 ``anthropic.AsyncAnthropic`` (e.g. ``timeout``,
97                 ``default_headers``, ``http_client``, ``auth_token``).
98         """
99         super().__init__(
100             credential=credential,
101             model=model,
102             parameters=parameters or self.Parameters(),
103             stream=stream,
104             max_retries=max_retries,
105             retry_delay=retry_delay,
106             context_size=context_size,
107         )
108         self.formatter = formatter or AnthropicChatFormatter()
109         self.client_kwargs = client_kwargs or {}
110 
111     @classmethod
112     def _get_retryable_exceptions(cls) -> tuple[Type[Exception], ...]:
113         import anthropic
114 
115         return (
116             anthropic.APIConnectionError,
117             anthropic.APITimeoutError,
118             anthropic.RateLimitError,
119             anthropic.InternalServerError,
120         )
