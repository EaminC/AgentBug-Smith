609     # Define the function that calls the model
610     def call_model(
611         state: StateSchema, runtime: Runtime[ContextT], config: RunnableConfig
612     ) -> StateSchema:
613         if is_async_dynamic_model:
614             msg = (
615                 "Async model callable provided but agent invoked synchronously. "
616                 "Use agent.ainvoke() or agent.astream(), or "
617                 "provide a sync model callable."
618             )
619             raise RuntimeError(msg)
620 
621         model_input = _get_model_input_state(state)
622 
623         if is_dynamic_model:
624             # Resolve dynamic model at runtime and apply prompt
625             dynamic_model = _resolve_model(state, runtime)
626             response = cast(AIMessage, dynamic_model.invoke(model_input, config))  # type: ignore[arg-type]
627         else:
628             response = cast(AIMessage, static_model.invoke(model_input, config))  # type: ignore[union-attr]
629 
630         # add agent name to the AIMessage
631         response.name = name
632 
633         if _are_more_steps_needed(state, response):
634             return {
635                 "messages": [
636                     AIMessage(
637                         id=response.id,
638                         content="Sorry, need more steps to process this request.",
639                     )
640                 ]
641             }
642         # We return a list, because this will get added to the existing list
643         return {"messages": [response]}
644 
645     async def acall_model(
646         state: StateSchema, runtime: Runtime[ContextT], config: RunnableConfig
647     ) -> StateSchema:
648         model_input = _get_model_input_state(state)
649 
650         if is_dynamic_model:
651             # Resolve dynamic model at runtime and apply prompt
652             # (supports both sync and async)
653             dynamic_model = await _aresolve_model(state, runtime)
654             response = cast(AIMessage, await dynamic_model.ainvoke(model_input, config))  # type: ignore[arg-type]
655         else:
656             response = cast(AIMessage, await static_model.ainvoke(model_input, config))  # type: ignore[union-attr]
657 
658         # add agent name to the AIMessage
659         response.name = name
660         if _are_more_steps_needed(state, response):
661             return {
662                 "messages": [
663                     AIMessage(
664                         id=response.id,
665                         content="Sorry, need more steps to process this request.",
666                     )
667                 ]
668             }
669         # We return a list, because this will get added to the existing list
670         return {"messages": [response]}
