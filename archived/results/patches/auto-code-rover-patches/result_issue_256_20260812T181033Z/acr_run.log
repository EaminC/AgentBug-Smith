164     @override
165     def update_config(self, **model_config: Unpack[BedrockConfig]) -> None:  # type: ignore
166         """Update the Bedrock Model configuration with the provided arguments.
167 
168         Args:
169             **model_config: Configuration overrides.
170         """
171         validate_config_keys(model_config, self.BedrockConfig)
172         self.config.update(model_config)
173 
174     @override
175     def get_config(self) -> BedrockConfig:
176         """Get the current Bedrock Model configuration.
177 
178         Returns:
179             The Bedrock model configuration.
180         """
181         return self.config
182 
183     def _should_include_tool_result_status(self) -> bool:
184         """Determine whether to include tool result status based on current config."""
185         include_status = self.config.get("include_tool_result_status", "auto")
186 
187         if include_status is True:
188             return True
189         elif include_status is False:
190             return False
191         else:  # "auto"
192             return any(model in self.config["model_id"] for model in _MODELS_INCLUDE_STATUS)
193 
194     def format_request(
195         self,
196         messages: Messages,
197         tool_specs: Optional[list[ToolSpec]] = None,
198         system_prompt: Optional[str] = None,
199     ) -> dict[str, Any]:
200         """Format a Bedrock converse stream request.
201 
202         Args:
203             messages: List of message objects to be processed by the model.
204             tool_specs: List of tool specifications to make available to the model.
205             system_prompt: System prompt to provide context to the model.
206 
207         Returns:
208             A Bedrock converse stream request.
209         """
210         return {
211             "modelId": self.config["model_id"],
212             "messages": self._format_bedrock_messages(messages),
213             "system": [
214                 *([{"text": system_prompt}] if system_prompt else []),
215                 *([{"cachePoint": {"type": self.config["cache_prompt"]}}] if self.config.get("cache_prompt") else []),
216             ],
217             **(
218                 {
219                     "toolConfig": {
220                         "tools": [
221                             *[{"toolSpec": tool_spec} for tool_spec in tool_specs],
222                             *(
223                                 [{"cachePoint": {"type": self.config["cache_tools"]}}]
224                                 if self.config.get("cache_tools")
225                                 else []
226                             ),
227                         ],
228                         "toolChoice": {"auto": {}},
229                     }
230                 }
231                 if tool_specs
232                 else {}
233             ),
234             **(
235                 {"additionalModelRequestFields": self.config["additional_request_fields"]}
236                 if self.config.get("additional_request_fields")
237                 else {}
238             ),
239             **(
240                 {"additionalModelResponseFieldPaths": self.config["additional_response_field_paths"]}
241                 if self.config.get("additional_response_field_paths")
242                 else {}
243             ),
244             **(
245                 {
246                     "guardrailConfig": {
247                         "guardrailIdentifier": self.config["guardrail_id"],
248                         "guardrailVersion": self.config["guardrail_version"],
249                         "trace": self.config.get("guardrail_trace", "enabled"),
250                         **(
251                             {"streamProcessingMode": self.config.get("guardrail_stream_processing_mode")}
252                             if self.config.get("guardrail_stream_processing_mode")
253                             else {}
254                         ),
255                     }
256                 }
257                 if self.config.get("guardrail_id") and self.config.get("guardrail_version")
258                 else {}
259             ),
260             "inferenceConfig": {
261                 key: value
262                 for key, value in [
263                     ("maxTokens", self.config.get("max_tokens")),
264                     ("temperature", self.config.get("temperature")),
265                     ("topP", self.config.get("top_p")),
266                     ("stopSequences", self.config.get("stop_sequences")),
267                 ]
268                 if value is not None
269             },
270             **(
271                 self.config["additional_args"]
272                 if "additional_args" in self.config and self.config["additional_args"] is not None
273                 else {}
274             ),
275         }
276 
277     def _format_bedrock_messages(self, messages: Messages) -> Messages:
278         """Format messages for Bedrock API compatibility.
279 
280         This function ensures messages conform to Bedrock's expected format by:
281         - Filtering out SDK_UNKNOWN_MEMBER content blocks
282         - Cleaning tool result content blocks by removing additional fields that may be
283           useful for retaining information in hooks but would cause Bedrock validation
284           exceptions when presented with unexpected fields
285         - Ensuring all message content blocks are properly formatted for the Bedrock API
286 
287         Args:
288             messages: List of messages to format
289 
290         Returns:
291             Messages formatted for Bedrock API compatibility
292 
293         Note:
294             Bedrock will throw validation exceptions when presented with additional
295             unexpected fields in tool result blocks.
296             https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolResultBlock.html
297         """
298         cleaned_messages = []
299 
300         filtered_unknown_members = False
301         dropped_deepseek_reasoning_content = False
302 
303         for message in messages:
304             cleaned_content: list[ContentBlock] = []
305 
306             for content_block in message["content"]:
307                 # Filter out SDK_UNKNOWN_MEMBER content blocks
308                 if "SDK_UNKNOWN_MEMBER" in content_block:
309                     filtered_unknown_members = True
310                     continue
311 
312                 # DeepSeek models have issues with reasoningContent
313                 # TODO: Replace with systematic model configuration registry (https://github.com/strands-agents/sdk-python/issues/780)
314                 if "deepseek" in self.config["model_id"].lower() and "reasoningContent" in content_block:
315                     dropped_deepseek_reasoning_content = True
316                     continue
317 
318                 if "toolResult" in content_block:
319                     # Create a new content block with only the cleaned toolResult
320                     tool_result: ToolResult = content_block["toolResult"]
321 
322                     if self._should_include_tool_result_status():
323                         # Include status field
324                         cleaned_tool_result = ToolResult(
325                             content=tool_result["content"],
326                             toolUseId=tool_result["toolUseId"],
327                             status=tool_result["status"],
328                         )
329                     else:
330                         # Remove status field
331                         cleaned_tool_result = ToolResult(  # type: ignore[typeddict-item]
332                             toolUseId=tool_result["toolUseId"], content=tool_result["content"]
333                         )
334 
335                     cleaned_block: ContentBlock = {"toolResult": cleaned_tool_result}
336                     cleaned_content.append(cleaned_block)
337                 else:
338                     # Keep other content blocks as-is
339                     cleaned_content.append(content_block)
340 
341             # Create new message with cleaned content (skip if empty for DeepSeek)
342             if cleaned_content:
343                 cleaned_message: Message = Message(content=cleaned_content, role=message["role"])
344                 cleaned_messages.append(cleaned_message)
345 
346         if filtered_unknown_members:
347             logger.warning(
348                 "Filtered out SDK_UNKNOWN_MEMBER content blocks from messages, consider upgrading boto3 version"
349             )
350         if dropped_deepseek_reasoning_content:
351             logger.debug(
352                 "Filtered DeepSeek reasoningContent content blocks from messages - https://api-docs.deepseek.com/guides/reasoning_model#multi-round-conversation"
353             )
354 
355         return cleaned_messages
356 
357     def _has_blocked_guardrail(self, guardrail_data: dict[str, Any]) -> bool:
358         """Check if guardrail data contains any blocked policies.
359 
360         Args:
361             guardrail_data: Guardrail data from trace information.
362 
363         Returns:
364             True if any blocked guardrail is detected, False otherwise.
365         """
366         input_assessment = guardrail_data.get("inputAssessment", {})
367         output_assessments = guardrail_data.get("outputAssessments", {})
368 
369         # Check input assessments
370         if any(self._find_detected_and_blocked_policy(assessment) for assessment in input_assessment.values()):
371             return True
372 
373         # Check output assessments
374         if any(self._find_detected_and_blocked_policy(assessment) for assessment in output_assessments.values()):
375             return True
376 
377         return False
378 
379     def _generate_redaction_events(self) -> list[StreamEvent]:
380         """Generate redaction events based on configuration.
381 
382         Returns:
383             List of redaction events to yield.
384         """
385         events: list[StreamEvent] = []
386 
387         if self.config.get("guardrail_redact_input", True):
388             logger.debug("Redacting user input due to guardrail.")
389             events.append(
390                 {
391                     "redactContent": {
392                         "redactUserContentMessage": self.config.get(
393                             "guardrail_redact_input_message", "[User input redacted.]"
394                         )
395                     }
396                 }
397             )
398 
399         if self.config.get("guardrail_redact_output", False):
400             logger.debug("Redacting assistant output due to guardrail.")
401             events.append(
402                 {
403                     "redactContent": {
404                         "redactAssistantContentMessage": self.config.get(
405                             "guardrail_redact_output_message",
406                             "[Assistant output redacted.]",
407                         )
408                     }
409                 }
410             )
411 
412         return events
413 
414     @override
415     async def stream(
416         self,
417         messages: Messages,
418         tool_specs: Optional[list[ToolSpec]] = None,
419         system_prompt: Optional[str] = None,
420         **kwargs: Any,
421     ) -> AsyncGenerator[StreamEvent, None]:
422         """Stream conversation with the Bedrock model.
423 
424         This method calls either the Bedrock converse_stream API or the converse API
425         based on the streaming parameter in the configuration.
426 
427         Args:
428             messages: List of message objects to be processed by the model.
429             tool_specs: List of tool specifications to make available to the model.
430             system_prompt: System prompt to provide context to the model.
431             **kwargs: Additional keyword arguments for future extensibility.
432 
433         Yields:
434             Model events.
435 
436         Raises:
437             ContextWindowOverflowException: If the input exceeds the model's context window.
438             ModelThrottledException: If the model service is throttling requests.
439         """
440 
441         def callback(event: Optional[StreamEvent] = None) -> None:
442             loop.call_soon_threadsafe(queue.put_nowait, event)
443             if event is None:
444                 return
445 
446         loop = asyncio.get_event_loop()
447         queue: asyncio.Queue[Optional[StreamEvent]] = asyncio.Queue()
448 
449         thread = asyncio.to_thread(self._stream, callback, messages, tool_specs, system_prompt)
450         task = asyncio.create_task(thread)
451 
452         while True:
453             event = await queue.get()
454             if event is None:
455                 break
456 
457             yield event
458 
459         await task
460 
461     def _stream(
462         self,
463         callback: Callable[..., None],
464         messages: Messages,
465         tool_specs: Optional[list[ToolSpec]] = None,
466         system_prompt: Optional[str] = None,
467     ) -> None:
468         """Stream conversation with the Bedrock model.
469 
470         This method operates in a separate thread to avoid blocking the async event loop with the call to
471         Bedrock's converse_stream.
472 
473         Args:
474             callback: Function to send events to the main thread.
475             messages: List of message objects to be processed by the model.
476             tool_specs: List of tool specifications to make available to the model.
477             system_prompt: System prompt to provide context to the model.
478 
479         Raises:
480             ContextWindowOverflowException: If the input exceeds the model's context window.
481             ModelThrottledException: If the model service is throttling requests.
482         """
483         try:
484             logger.debug("formatting request")
485             request = self.format_request(messages, tool_specs, system_prompt)
486             logger.debug("request=<%s>", request)
487 
488             logger.debug("invoking model")
489             streaming = self.config.get("streaming", True)
490 
491             logger.debug("got response from model")
492             if streaming:
493                 response = self.client.converse_stream(**request)
494                 # Track tool use events to fix stopReason for streaming responses
495                 has_tool_use = False
496                 for chunk in response["stream"]:
497                     if (
498                         "metadata" in chunk
499                         and "trace" in chunk["metadata"]
500                         and "guardrail" in chunk["metadata"]["trace"]
501                     ):
502                         guardrail_data = chunk["metadata"]["trace"]["guardrail"]
503                         if self._has_blocked_guardrail(guardrail_data):
504                             for event in self._generate_redaction_events():
505                                 callback(event)
506 
507                     # Track if we see tool use events
508                     if "contentBlockStart" in chunk and chunk["contentBlockStart"].get("start", {}).get("toolUse"):
509                         has_tool_use = True
510 
511                     # Fix stopReason for streaming responses that contain tool use
512                     if (
513                         has_tool_use
514                         and "messageStop" in chunk
515                         and (message_stop := chunk["messageStop"]).get("stopReason") == "end_turn"
516                     ):
517                         # Create corrected chunk with tool_use stopReason
518                         modified_chunk = chunk.copy()
519                         modified_chunk["messageStop"] = message_stop.copy()
520                         modified_chunk["messageStop"]["stopReason"] = "tool_use"
521                         logger.warning("Override stop reason from end_turn to tool_use")
522                         callback(modified_chunk)
523                     else:
524                         callback(chunk)
525 
526             else:
527                 response = self.client.converse(**request)
528                 for event in self._convert_non_streaming_to_streaming(response):
529                     callback(event)
530 
531                 if (
532                     "trace" in response
533                     and "guardrail" in response["trace"]
534                     and self._has_blocked_guardrail(response["trace"]["guardrail"])
535                 ):
536                     for event in self._generate_redaction_events():
537                         callback(event)
538 
539         except ClientError as e:
540             error_message = str(e)
541 
542             if e.response["Error"]["Code"] == "ThrottlingException":
543                 raise ModelThrottledException(error_message) from e
544 
545             if any(overflow_message in error_message for overflow_message in BEDROCK_CONTEXT_WINDOW_OVERFLOW_MESSAGES):
546                 logger.warning("bedrock threw context window overflow error")
547                 raise ContextWindowOverflowException(e) from e
548 
549             region = self.client.meta.region_name
550 
551             # add_note added in Python 3.11
552             if hasattr(e, "add_note"):
553                 # Aid in debugging by adding more information
554                 e.add_note(f"└ Bedrock region: {region}")
555                 e.add_note(f"└ Model id: {self.config.get('model_id')}")
556 
557                 if (
558                     e.response["Error"]["Code"] == "AccessDeniedException"
559                     and "You don't have access to the model" in error_message
560                 ):
561                     e.add_note(
562                         "└ For more information see "
563                         "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#model-access-issue"
564                     )
565 
566                 if (
567                     e.response["Error"]["Code"] == "ValidationException"
568                     and "with on-demand throughput isn’t supported" in error_message
569                 ):
570                     e.add_note(
571                         "└ For more information see "
572                         "https://strandsagents.com/latest/user-guide/concepts/model-providers/amazon-bedrock/#on-demand-throughput-isnt-supported"
573                     )
574 
575             raise e
576 
577         finally:
578             callback()
579             logger.debug("finished streaming response from model")
580 
581     def _convert_non_streaming_to_streaming(self, response: dict[str, Any]) -> Iterable[StreamEvent]:
582         """Convert a non-streaming response to the streaming format.
583 
584         Args:
585             response: The non-streaming response from the Bedrock model.
586 
587         Returns:
588             An iterable of response events in the streaming format.
589         """
590         # Yield messageStart event
591         yield {"messageStart": {"role": response["output"]["message"]["role"]}}
592 
593         # Process content blocks
594         for content in cast(list[ContentBlock], response["output"]["message"]["content"]):
595             # Yield contentBlockStart event if needed
596             if "toolUse" in content:
597                 yield {
598                     "contentBlockStart": {
599                         "start": {
600                             "toolUse": {
601                                 "toolUseId": content["toolUse"]["toolUseId"],
602                                 "name": content["toolUse"]["name"],
603                             }
604                         },
605                     }
606                 }
607 
608                 # For tool use, we need to yield the input as a delta
609                 input_value = json.dumps(content["toolUse"]["input"])
610 
611                 yield {"contentBlockDelta": {"delta": {"toolUse": {"input": input_value}}}}
612             elif "text" in content:
613                 # Then yield the text as a delta
614                 yield {
615                     "contentBlockDelta": {
616                         "delta": {"text": content["text"]},
617                     }
618                 }
619             elif "reasoningContent" in content:
620                 # Then yield the reasoning content as a delta
621                 yield {
622                     "contentBlockDelta": {
623                         "delta": {"reasoningContent": {"text": content["reasoningContent"]["reasoningText"]["text"]}}
624                     }
625                 }
626 
627                 if "signature" in content["reasoningContent"]["reasoningText"]:
628                     yield {
629                         "contentBlockDelta": {
630                             "delta": {
631                                 "reasoningContent": {
632                                     "signature": content["reasoningContent"]["reasoningText"]["signature"]
633                                 }
634                             }
635                         }
636                     }
637             elif "citationsContent" in content:
638                 # For non-streaming citations, emit text and metadata deltas in sequence
639                 # to match streaming behavior where they flow naturally
640                 if "content" in content["citationsContent"]:
641                     text_content = "".join([content["text"] for content in content["citationsContent"]["content"]])
642                     yield {
643                         "contentBlockDelta": {"delta": {"text": text_content}},
644                     }
645 
646                 for citation in content["citationsContent"]["citations"]:
647                     # Then emit citation metadata (for structure)
648 
649                     citation_metadata: CitationsDelta = {
650                         "title": citation["title"],
651                         "location": citation["location"],
652                         "sourceContent": citation["sourceContent"],
653                     }
654                     yield {"contentBlockDelta": {"delta": {"citation": citation_metadata}}}
655 
656             # Yield contentBlockStop event
657             yield {"contentBlockStop": {}}
658 
659         # Yield messageStop event
660         # Fix stopReason for models that return end_turn when they should return tool_use on non-streaming side
661         current_stop_reason = response["stopReason"]
662         if current_stop_reason == "end_turn":
663             message_content = response["output"]["message"]["content"]
664             if any("toolUse" in content for content in message_content):
665                 current_stop_reason = "tool_use"
666                 logger.warning("Override stop reason from end_turn to tool_use")
667 
668         yield {
669             "messageStop": {
670                 "stopReason": current_stop_reason,
671                 "additionalModelResponseFields": response.get("additionalModelResponseFields"),
672             }
673         }
674 
675         # Yield metadata event
676         if "usage" in response or "metrics" in response or "trace" in response:
677             metadata: StreamEvent = {"metadata": {}}
678             if "usage" in response:
679                 metadata["metadata"]["usage"] = response["usage"]
680             if "metrics" in response:
681                 metadata["metadata"]["metrics"] = response["metrics"]
682             if "trace" in response:
683                 metadata["metadata"]["trace"] = response["trace"]
684             yield metadata
685 
686     def _find_detected_and_blocked_policy(self, input: Any) -> bool:
687         """Recursively checks if the assessment contains a detected and blocked guardrail.
688 
689         Args:
690             input: The assessment to check.
691 
692         Returns:
693             True if the input contains a detected and blocked guardrail, False otherwise.
694 
695         """
696         # Check if input is a dictionary
697         if isinstance(input, dict):
698             # Check if current dictionary has action: BLOCKED and detected: true
699             if input.get("action") == "BLOCKED" and input.get("detected") and isinstance(input.get("detected"), bool):
700                 return True
701 
702             # Recursively check all values in the dictionary
703             for value in input.values():
704                 if isinstance(value, dict):
705                     return self._find_detected_and_blocked_policy(value)
706                 # Handle case where value is a list of dictionaries
707                 elif isinstance(value, list):
708                     for item in value:
709                         return self._find_detected_and_blocked_policy(item)
710         elif isinstance(input, list):
711             # Handle case where input is a list of dictionaries
712             for item in input:
713                 return self._find_detected_and_blocked_policy(item)
714         # Otherwise return False
715         return False
716 
717     @override
718     async def structured_output(
719         self,
720         output_model: Type[T],
721         prompt: Messages,
722         system_prompt: Optional[str] = None,
723         **kwargs: Any,
724     ) -> AsyncGenerator[dict[str, Union[T, Any]], None]:
725         """Get structured output from the model.
726 
727         Args:
728             output_model: The output model to use for the agent.
729             prompt: The prompt messages to use for the agent.
730             system_prompt: System prompt to provide context to the model.
731             **kwargs: Additional keyword arguments for future extensibility.
732 
733         Yields:
734             Model events with the last being the structured output.
735         """
736         tool_spec = convert_pydantic_to_tool_spec(output_model)
737 
738         response = self.stream(
739             messages=prompt,
740             tool_specs=[tool_spec],
741             system_prompt=system_prompt,
742             **kwargs,
743         )
744         async for event in streaming.process_stream(response):
745             yield event
746 
747         stop_reason, messages, _, _ = event["stop"]
748 
749         if stop_reason != "tool_use":
750             raise ValueError(f'Model returned stop_reason: {stop_reason} instead of "tool_use".')
751 
752         content = messages["content"]
753         output_response: dict[str, Any] | None = None
754         for block in content:
755             # if the tool use name doesn't match the tool spec name, skip, and if the block is not a tool use, skip.
756             # if the tool use name never matches, raise an error.
757             if block.get("toolUse") and block["toolUse"]["name"] == tool_spec["name"]:
758                 output_response = block["toolUse"]["input"]
759             else:
760                 continue
761 
762         if output_response is None:
763             raise ValueError("No valid tool use or tool use input was found in the Bedrock response.")
764 
765         yield {"output": output_model(**output_response)}

