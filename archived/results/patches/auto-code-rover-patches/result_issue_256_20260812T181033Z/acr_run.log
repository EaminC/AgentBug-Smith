50 class BedrockModel(Model):
51     """AWS Bedrock model provider implementation.
52 
53     The implementation handles Bedrock-specific features such as:
54 
55     - Tool configuration for function calling
56     - Guardrails integration
57     - Caching points for system prompts and tools
58     - Streaming responses
59     - Context window overflow detection
60     """
61 
62     class BedrockConfig(TypedDict, total=False):
63         """Configuration options for Bedrock models.
64 
65         Attributes:
66             additional_args: Any additional arguments to include in the request
67             additional_request_fields: Additional fields to include in the Bedrock request
68             additional_response_field_paths: Additional response field paths to extract
69             cache_prompt: Cache point type for the system prompt
70             cache_tools: Cache point type for tools
71             guardrail_id: ID of the guardrail to apply
72             guardrail_trace: Guardrail trace mode. Defaults to enabled.
73             guardrail_version: Version of the guardrail to apply
74             guardrail_stream_processing_mode: The guardrail processing mode
75             guardrail_redact_input: Flag to redact input if a guardrail is triggered. Defaults to True.
76             guardrail_redact_input_message: If a Bedrock Input guardrail triggers, replace the input with this message.
77             guardrail_redact_output: Flag to redact output if guardrail is triggered. Defaults to False.
78             guardrail_redact_output_message: If a Bedrock Output guardrail triggers, replace output with this message.
79             max_tokens: Maximum number of tokens to generate in the response
80             model_id: The Bedrock model ID (e.g., "us.anthropic.claude-sonnet-4-20250514-v1:0")
81             include_tool_result_status: Flag to include status field in tool results.
82                 True includes status, False removes status, "auto" determines based on model_id. Defaults to "auto".
83             stop_sequences: List of sequences that will stop generation when encountered
84             streaming: Flag to enable/disable streaming. Defaults to True.
85             temperature: Controls randomness in generation (higher = more random)
86             top_p: Controls diversity via nucleus sampling (alternative to temperature)
87         """
88 
89         additional_args: Optional[dict[str, Any]]
90         additional_request_fields: Optional[dict[str, Any]]
91         additional_response_field_paths: Optional[list[str]]
92         cache_prompt: Optional[str]
93         cache_tools: Optional[str]
94         guardrail_id: Optional[str]
95         guardrail_trace: Optional[Literal["enabled", "disabled", "enabled_full"]]
96         guardrail_stream_processing_mode: Optional[Literal["sync", "async"]]
97         guardrail_version: Optional[str]
98         guardrail_redact_input: Optional[bool]
99         guardrail_redact_input_message: Optional[str]
100         guardrail_redact_output: Optional[bool]
101         guardrail_redact_output_message: Optional[str]
102         max_tokens: Optional[int]
103         model_id: str
104         include_tool_result_status: Optional[Literal["auto"] | bool]
105         stop_sequences: Optional[list[str]]
106         streaming: Optional[bool]
107         temperature: Optional[float]
108         top_p: Optional[float]
109 
110     def __init__(
111         self,
112         *,
113         boto_session: Optional[boto3.Session] = None,
114         boto_client_config: Optional[BotocoreConfig] = None,
115         region_name: Optional[str] = None,
116         endpoint_url: Optional[str] = None,
117         **model_config: Unpack[BedrockConfig],
118     ):
119         """Initialize provider instance.
120 
121         Args:
122             boto_session: Boto Session to use when calling the Bedrock Model.
123             boto_client_config: Configuration to use when creating the Bedrock-Runtime Boto Client.
124             region_name: AWS region to use for the Bedrock service.
125                 Defaults to the AWS_REGION environment variable if set, or "us-west-2" if not set.
126             endpoint_url: Custom endpoint URL for VPC endpoints (PrivateLink)
127             **model_config: Configuration options for the Bedrock model.
128         """
129         if region_name and boto_session:
130             raise ValueError("Cannot specify both `region_name` and `boto_session`.")
131 
132         self.config = BedrockModel.BedrockConfig(model_id=DEFAULT_BEDROCK_MODEL_ID, include_tool_result_status="auto")
133         self.update_config(**model_config)
134 
135         logger.debug("config=<%s> | initializing", self.config)
136 
137         session = boto_session or boto3.Session()
138 
139         # Add strands-agents to the request user agent
140         if boto_client_config:
141             existing_user_agent = getattr(boto_client_config, "user_agent_extra", None)
142 
143             # Append 'strands-agents' to existing user_agent_extra or set it if not present
144             if existing_user_agent:
145                 new_user_agent = f"{existing_user_agent} strands-agents"
146             else:
147                 new_user_agent = "strands-agents"
148 
149             client_config = boto_client_config.merge(BotocoreConfig(user_agent_extra=new_user_agent))
150         else:
151             client_config = BotocoreConfig(user_agent_extra="strands-agents", read_timeout=DEFAULT_READ_TIMEOUT)
152 
153         resolved_region = region_name or session.region_name or os.environ.get("AWS_REGION") or DEFAULT_BEDROCK_REGION
154 
155         self.client = session.client(
156             service_name="bedrock-runtime",
157             config=client_config,
158             endpoint_url=endpoint_url,
159             region_name=resolved_region,
160         )
161 
162         logger.debug("region=<%s> | bedrock client created", self.client.meta.region_name)
