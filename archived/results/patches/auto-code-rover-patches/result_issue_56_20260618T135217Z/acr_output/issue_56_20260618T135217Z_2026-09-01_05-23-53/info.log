11 class SearchAgent:
12     def __init__(self, enable_web_search: bool = False):
13         self.enable_web_search = enable_web_search
14         self.console = Console()
15 
16         if not self.enable_web_search:
17             self.console.log("Web search is disabled.")
18             return
19 
20         else:
21             config_dict = config.read()
22             self.engine_name = config_dict['general']['search_engine']
23             search_engine = config.read().get(self.engine_name)
24             search_engine['name'] = self.engine_name
25 
26             self.search_engine = SearchEngine.validate(search_engine)
27 
28     def search_with_google(self, query: str):
29         """
30         https://developers.google.com/custom-search/v1/using_rest
31         """
32         params = {
33             "key": self.search_engine.key,
34             "cx": self.search_engine.cx,
35             "q": query,
36             "num": self.search_engine.refer_count
37         }
38         self.console.log(f"Searching with Google")
39         response = requests.get(
40             self.search_engine.endpoint, params=params, timeout=self.search_engine.timeout
41         )
42         if not response.ok:
43             self.console.log(f"{response.status_code} {response.text}")
44             raise HTTPException(response.status_code, "Search engine error.")
45         json_content = response.json()
46         try:
47             contexts = json_content["items"][:self.search_engine.refer_count]
48         except KeyError:
49             self.console.log(f"Error encountered: {json_content}")
50             return []
51         return contexts
52 
53     def invoke(self, query: str):
54         """
55         Invoke the search agent.
56         """
57         if not self.enable_web_search:
58             return ["no web search results for this query."]
59 
60         if self.engine_name == "google":
61             return self.search_with_google(query)
62         else:
63             self.console.log(f"Search engine {self.engine_name} is not supported.")
64             raise HTTPException(400, "Search engine not supported.")

