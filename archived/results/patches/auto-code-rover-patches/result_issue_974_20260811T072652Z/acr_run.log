121             max_iters (`int`, defaults to `10`):
122                 The maximum number of iterations of the reasoning-acting loops.
123         """
124         super().__init__()
125 
126         assert long_term_memory_mode in [
127             "agent_control",
128             "static_control",
129             "both",
130         ]
131 
