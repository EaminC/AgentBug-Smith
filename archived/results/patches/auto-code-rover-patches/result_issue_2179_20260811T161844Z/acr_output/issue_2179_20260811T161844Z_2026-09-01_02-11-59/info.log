148             kwargs = use_kwargs
149 
150         for coder in coders.__all__:
151             if hasattr(coder, "edit_format") and coder.edit_format == edit_format:
152                 res = coder(main_model, io, **kwargs)
153                 res.original_kwargs = dict(kwargs)
154                 return res
155 
156         raise ValueError(f"Unknown edit format {edit_format}")
157 
158     def clone(self, **kwargs):
159         new_coder = Coder.create(from_coder=self, **kwargs)
160         new_coder.ignore_mentions = self.ignore_mentions
161         return new_coder
162 
163     def get_announcements(self):
164         lines = []
165         lines.append(f"Aider v{__version__}")
166 
167         # Model
168         main_model = self.main_model
169         weak_model = main_model.weak_model
170 
171         if weak_model is not main_model:
172             prefix = "Main model"
173         else:
174             prefix = "Model"
175 
176         output = f"{prefix}: {main_model.name} with {self.edit_format} edit format"
177         if self.add_cache_headers or main_model.caches_by_default:
178             output += ", prompt cache"
179         if main_model.info.get("supports_assistant_prefill"):
180             output += ", infinite output"
181         lines.append(output)
182 
183         if self.edit_format == "architect":
184             output = (
185                 f"Editor model: {main_model.editor_model.name} with"
186                 f" {main_model.editor_edit_format} edit format"
187             )
188             lines.append(output)
189 
190         if weak_model is not main_model:
191             output = f"Weak model: {weak_model.name}"
192             lines.append(output)
193 
194         # Repo
195         if self.repo:
196             rel_repo_dir = self.repo.get_rel_repo_dir()
197             num_files = len(self.repo.get_tracked_files())
198 
199             lines.append(f"Git repo: {rel_repo_dir} with {num_files:,} files")
200             if num_files > 1000:
201                 lines.append(
202                     "Warning: For large repos, consider using --subtree-only and .aiderignore"
203                 )
204                 lines.append(f"See: {urls.large_repos}")
205         else:
206             lines.append("Git repo: none")
207 
208         # Repo-map
209         if self.repo_map:
210             map_tokens = self.repo_map.max_map_tokens
211             if map_tokens > 0:
212                 refresh = self.repo_map.refresh
213                 lines.append(f"Repo-map: using {map_tokens} tokens, {refresh} refresh")
214                 max_map_tokens = 2048
215                 if map_tokens > max_map_tokens:
216                     lines.append(
217                         f"Warning: map-tokens > {max_map_tokens} is not recommended as too much"
218                         " irrelevant code can confuse LLMs."
219                     )
220             else:
221                 lines.append("Repo-map: disabled because map_tokens == 0")
222         else:
223             lines.append("Repo-map: disabled")
224 
225         # Files
226         for fname in self.get_inchat_relative_files():
227             lines.append(f"Added {fname} to the chat.")
228 
229         if self.done_messages:
230             lines.append("Restored previous conversation history.")
231 
232         return lines
233 
