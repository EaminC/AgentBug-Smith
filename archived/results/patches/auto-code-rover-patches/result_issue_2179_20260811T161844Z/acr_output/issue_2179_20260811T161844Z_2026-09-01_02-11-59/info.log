94     @classmethod
95     def create(
96         self,
97         main_model=None,
98         edit_format=None,
99         io=None,
100         from_coder=None,
101         summarize_from_coder=True,
102         **kwargs,
103     ):
104         import aider.coders as coders
105 
106         if not main_model:
107             if from_coder:
108                 main_model = from_coder.main_model
109             else:
110                 main_model = models.Model(models.DEFAULT_MODEL_NAME)
111 
112         if edit_format == "code":
113             edit_format = None
114         if edit_format is None:
115             if from_coder:
116                 edit_format = from_coder.edit_format
117             else:
118                 edit_format = main_model.edit_format
119 
120         if not io and from_coder:
121             io = from_coder.io
122 
123         if from_coder:
124             use_kwargs = dict(from_coder.original_kwargs)  # copy orig kwargs
125 
126             # If the edit format changes, we can't leave old ASSISTANT
127             # messages in the chat history. The old edit format will
128             # confused the new LLM. It may try and imitate it, disobeying
129             # the system prompt.
130             done_messages = from_coder.done_messages
131             if edit_format != from_coder.edit_format and done_messages and summarize_from_coder:
132                 done_messages = from_coder.summarizer.summarize_all(done_messages)
133 
134             # Bring along context from the old Coder
135             update = dict(
136                 fnames=list(from_coder.abs_fnames),
137                 read_only_fnames=list(from_coder.abs_read_only_fnames),  # Copy read-only files
138                 done_messages=done_messages,
139                 cur_messages=from_coder.cur_messages,
140                 aider_commit_hashes=from_coder.aider_commit_hashes,
141                 commands=from_coder.commands.clone(),
142                 total_cost=from_coder.total_cost,
143             )
144 
145             use_kwargs.update(update)  # override to complete the switch
146             use_kwargs.update(kwargs)  # override passed kwargs
147 
148             kwargs = use_kwargs
149 
150         for coder in coders.__all__:
151             if hasattr(coder, "edit_format") and coder.edit_format == edit_format:
152                 res = coder(main_model, io, **kwargs)
153                 res.original_kwargs = dict(kwargs)
154                 return res
155 
156         raise ValueError(f"Unknown edit format {edit_format}")
157 
158     def clone(self, **kwargs):
159         new_coder = Coder.create(from_coder=self, **kwargs)
160         new_coder.ignore_mentions = self.ignore_mentions
161         return new_coder
