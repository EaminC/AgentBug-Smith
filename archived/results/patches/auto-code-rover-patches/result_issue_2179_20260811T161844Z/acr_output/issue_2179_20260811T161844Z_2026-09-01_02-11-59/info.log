1943     def run_shell_commands(self):
1944         if not self.suggest_shell_commands:
1945             return ""
1946 
1947         done = set()
1948         group = ConfirmGroup(set(self.shell_commands))
1949         accumulated_output = ""
1950         for command in self.shell_commands:
1951             if command in done:
1952                 continue
1953             done.add(command)
1954             output = self.handle_shell_commands(command, group)
1955             if output:
1956                 accumulated_output += output + "\n\n"
1957         return accumulated_output
