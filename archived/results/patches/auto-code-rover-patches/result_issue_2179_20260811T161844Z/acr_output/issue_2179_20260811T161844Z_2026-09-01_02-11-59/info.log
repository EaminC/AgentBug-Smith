156         raise ValueError(f"Unknown edit format {edit_format}")
157 
158     def clone(self, **kwargs):
159         new_coder = Coder.create(from_coder=self, **kwargs)
160         new_coder.ignore_mentions = self.ignore_mentions
161         return new_coder
