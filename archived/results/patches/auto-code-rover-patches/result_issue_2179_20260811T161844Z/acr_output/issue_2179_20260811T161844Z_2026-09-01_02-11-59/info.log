1398     def send(self, messages, model=None, functions=None):
1399         if not model:
1400             model = self.main_model
1401 
1402         self.partial_response_content = ""
1403         self.partial_response_function_call = dict()
1404 
1405         self.io.log_llm_history("TO LLM", format_messages(messages))
1406 
1407         if self.main_model.use_temperature:
1408             temp = self.temperature
1409         else:
1410             temp = None
1411 
1412         completion = None
1413         try:
1414             hash_object, completion = send_completion(
1415                 model.name,
1416                 messages,
1417                 functions,
1418                 self.stream,
1419                 temp,
1420                 extra_params=model.extra_params,
1421             )
1422             self.chat_completion_call_hashes.append(hash_object.hexdigest())
1423 
1424             if self.stream:
1425                 yield from self.show_send_output_stream(completion)
1426             else:
1427                 self.show_send_output(completion)
1428         except KeyboardInterrupt as kbi:
1429             self.keyboard_interrupt()
1430             raise kbi
1431         finally:
1432             self.io.log_llm_history(
1433                 "LLM RESPONSE",
1434                 format_content("ASSISTANT", self.partial_response_content),
1435             )
1436 
1437             if self.partial_response_content:
1438                 self.io.ai_output(self.partial_response_content)
1439             elif self.partial_response_function_call:
1440                 # TODO: push this into subclasses
1441                 args = self.parse_partial_args()
1442                 if args:
1443                     self.io.ai_output(json.dumps(args, indent=4))
1444 
1445             self.calculate_and_show_tokens_and_cost(messages, completion)
1446 
1447     def show_send_output(self, completion):
1448         if self.verbose:
1449             print(completion)
1450 
1451         if not completion.choices:
1452             self.io.tool_error(str(completion))
1453             return
1454 
1455         show_func_err = None
1456         show_content_err = None
1457         try:
1458             if completion.choices[0].message.tool_calls:
1459                 self.partial_response_function_call = (
1460                     completion.choices[0].message.tool_calls[0].function
1461                 )
1462         except AttributeError as func_err:
1463             show_func_err = func_err
1464 
1465         try:
1466             self.partial_response_content = completion.choices[0].message.content or ""
1467         except AttributeError as content_err:
1468             show_content_err = content_err
1469 
1470         resp_hash = dict(
1471             function_call=str(self.partial_response_function_call),
1472             content=self.partial_response_content,
1473         )
1474         resp_hash = hashlib.sha1(json.dumps(resp_hash, sort_keys=True).encode())
1475         self.chat_completion_response_hashes.append(resp_hash.hexdigest())
1476 
1477         if show_func_err and show_content_err:
1478             self.io.tool_error(show_func_err)
1479             self.io.tool_error(show_content_err)
1480             raise Exception("No data found in LLM response!")
1481 
1482         show_resp = self.render_incremental_response(True)
1483         self.io.assistant_output(show_resp, pretty=self.show_pretty())
1484 
1485         if (
1486             hasattr(completion.choices[0], "finish_reason")
1487             and completion.choices[0].finish_reason == "length"
1488         ):
1489             raise FinishReasonLength()
1490 
1491     def show_send_output_stream(self, completion):
1492         for chunk in completion:
1493             if len(chunk.choices) == 0:
1494                 continue
1495 
1496             if (
1497                 hasattr(chunk.choices[0], "finish_reason")
1498                 and chunk.choices[0].finish_reason == "length"
1499             ):
1500                 raise FinishReasonLength()
1501 
1502             try:
1503                 func = chunk.choices[0].delta.function_call
1504                 # dump(func)
1505                 for k, v in func.items():
1506                     if k in self.partial_response_function_call:
1507                         self.partial_response_function_call[k] += v
1508                     else:
1509                         self.partial_response_function_call[k] = v
1510             except AttributeError:
1511                 pass
1512 
1513             try:
1514                 text = chunk.choices[0].delta.content
1515                 if text:
1516                     self.partial_response_content += text
1517             except AttributeError:
1518                 text = None
1519 
1520             if self.show_pretty():
1521                 self.live_incremental_response(False)
1522             elif text:
1523                 try:
1524                     sys.stdout.write(text)
1525                 except UnicodeEncodeError:
1526                     # Safely encode and decode the text
1527                     safe_text = text.encode(sys.stdout.encoding, errors="backslashreplace").decode(
1528                         sys.stdout.encoding
1529                     )
1530                     sys.stdout.write(safe_text)
1531                 sys.stdout.flush()
1532                 yield text
1533 
1534     def live_incremental_response(self, final):
1535         show_resp = self.render_incremental_response(final)
1536         self.mdstream.update(show_resp, final=final)
1537 
1538     def render_incremental_response(self, final):
1539         return self.get_multi_response_content()
