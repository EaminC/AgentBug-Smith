1541     def calculate_and_show_tokens_and_cost(self, messages, completion=None):
1542         prompt_tokens = 0
1543         completion_tokens = 0
1544         cache_hit_tokens = 0
1545         cache_write_tokens = 0
1546 
1547         if completion and hasattr(completion, "usage") and completion.usage is not None:
1548             prompt_tokens = completion.usage.prompt_tokens
1549             completion_tokens = completion.usage.completion_tokens
1550             cache_hit_tokens = getattr(completion.usage, "prompt_cache_hit_tokens", 0) or getattr(
1551                 completion.usage, "cache_read_input_tokens", 0
1552             )
1553             cache_write_tokens = getattr(completion.usage, "cache_creation_input_tokens", 0)
1554 
1555             if hasattr(completion.usage, "cache_read_input_tokens") or hasattr(
1556                 completion.usage, "cache_creation_input_tokens"
1557             ):
1558                 self.message_tokens_sent += prompt_tokens
1559                 self.message_tokens_sent += cache_hit_tokens
1560                 self.message_tokens_sent += cache_write_tokens
1561             else:
1562                 self.message_tokens_sent += prompt_tokens
1563 
1564         else:
1565             prompt_tokens = self.main_model.token_count(messages)
1566             completion_tokens = self.main_model.token_count(self.partial_response_content)
1567             self.message_tokens_sent += prompt_tokens
1568 
1569         self.message_tokens_received += completion_tokens
1570 
1571         tokens_report = f"Tokens: {format_tokens(self.message_tokens_sent)} sent"
1572 
1573         if cache_write_tokens:
1574             tokens_report += f", {format_tokens(cache_write_tokens)} cache write"
1575         if cache_hit_tokens:
1576             tokens_report += f", {format_tokens(cache_hit_tokens)} cache hit"
1577         tokens_report += f", {format_tokens(self.message_tokens_received)} received."
1578 
1579         if not self.main_model.info.get("input_cost_per_token"):
1580             self.usage_report = tokens_report
1581             return
1582 
1583         cost = 0
1584 
1585         input_cost_per_token = self.main_model.info.get("input_cost_per_token") or 0
1586         output_cost_per_token = self.main_model.info.get("output_cost_per_token") or 0
1587         input_cost_per_token_cache_hit = (
1588             self.main_model.info.get("input_cost_per_token_cache_hit") or 0
1589         )
1590 
1591         # deepseek
1592         # prompt_cache_hit_tokens + prompt_cache_miss_tokens
1593         #    == prompt_tokens == total tokens that were sent
1594         #
1595         # Anthropic
1596         # cache_creation_input_tokens + cache_read_input_tokens + prompt
1597         #    == total tokens that were
1598 
1599         if input_cost_per_token_cache_hit:
1600             # must be deepseek
1601             cost += input_cost_per_token_cache_hit * cache_hit_tokens
1602             cost += (prompt_tokens - input_cost_per_token_cache_hit) * input_cost_per_token
1603         else:
1604             # hard code the anthropic adjustments, no-ops for other models since cache_x_tokens==0
1605             cost += cache_write_tokens * input_cost_per_token * 1.25
1606             cost += cache_hit_tokens * input_cost_per_token * 0.10
1607             cost += prompt_tokens * input_cost_per_token
1608 
1609         cost += completion_tokens * output_cost_per_token
1610 
1611         self.total_cost += cost
1612         self.message_cost += cost
1613 
1614         def format_cost(value):
1615             if value == 0:
1616                 return "0.00"
1617             magnitude = abs(value)
1618             if magnitude >= 0.01:
1619                 return f"{value:.2f}"
1620             else:
1621                 return f"{value:.{max(2, 2 - int(math.log10(magnitude)))}f}"
1622 
1623         cost_report = (
1624             f"Cost: ${format_cost(self.message_cost)} message,"
1625             f" ${format_cost(self.total_cost)} session."
1626         )
1627 
1628         if self.add_cache_headers and self.stream:
1629             warning = " Use --no-stream for accurate caching costs."
1630             self.usage_report = tokens_report + "\n" + cost_report + warning
1631             return
1632 
1633         if cache_hit_tokens and cache_write_tokens:
1634             sep = "\n"
1635         else:
1636             sep = " "
1637 
1638         self.usage_report = tokens_report + sep + cost_report
1639 
