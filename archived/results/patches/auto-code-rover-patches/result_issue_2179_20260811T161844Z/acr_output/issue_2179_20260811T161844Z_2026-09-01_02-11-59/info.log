1959     def handle_shell_commands(self, commands_str, group):
1960         commands = commands_str.strip().splitlines()
1961         command_count = sum(
1962             1 for cmd in commands if cmd.strip() and not cmd.strip().startswith("#")
1963         )
1964         prompt = "Run shell command?" if command_count == 1 else "Run shell commands?"
1965         if not self.io.confirm_ask(
1966             prompt,
1967             subject="\n".join(commands),
1968             explicit_yes_required=True,
1969             group=group,
1970             allow_never=True,
1971         ):
1972             return
1973 
1974         accumulated_output = ""
1975         for command in commands:
1976             command = command.strip()
1977             if not command or command.startswith("#"):
1978                 continue
1979 
1980             self.io.tool_output()
1981             self.io.tool_output(f"Running {command}")
1982             # Add the command to input history
1983             self.io.add_to_input_history(f"/run {command.strip()}")
1984             exit_status, output = run_cmd(command, error_print=self.io.tool_error)
1985             if output:
1986                 accumulated_output += f"Output from {command}\n{output}\n"
1987 
1988         if accumulated_output.strip() and not self.io.confirm_ask(
1989             "Add command output to the chat?", allow_never=True
1990         ):
1991             accumulated_output = ""
1992 
1993         return accumulated_output

