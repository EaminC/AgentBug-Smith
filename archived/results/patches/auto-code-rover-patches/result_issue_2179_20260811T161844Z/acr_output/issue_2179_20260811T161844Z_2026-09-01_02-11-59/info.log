569     def get_ident_filename_matches(self, idents):
570         all_fnames = defaultdict(set)
571         for fname in self.get_all_relative_files():
572             base = Path(fname).with_suffix("").name.lower()
573             if len(base) >= 5:
574                 all_fnames[base].add(fname)
575 
576         matches = set()
577         for ident in idents:
578             if len(ident) < 5:
579                 continue
580             matches.update(all_fnames[ident.lower()])
581 
582         return matches
