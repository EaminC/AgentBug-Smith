483     def get_abs_fnames_content(self):
484         for fname in list(self.abs_fnames):
485             content = self.io.read_text(fname)
486 
487             if content is None:
488                 relative_fname = self.get_rel_fname(fname)
489                 self.io.tool_warning(f"Dropping {relative_fname} from the chat.")
490                 self.abs_fnames.remove(fname)
491             else:
492                 yield fname, content
