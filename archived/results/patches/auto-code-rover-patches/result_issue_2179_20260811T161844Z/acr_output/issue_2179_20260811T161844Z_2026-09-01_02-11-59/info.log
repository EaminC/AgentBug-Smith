563     def get_ident_mentions(self, text):
564         # Split the string on any character that is not alphanumeric
565         # \W+ matches one or more non-word characters (equivalent to [^a-zA-Z0-9_]+)
566         words = set(re.split(r"\W+", text))
567         return words
568 
569     def get_ident_filename_matches(self, idents):
570         all_fnames = defaultdict(set)
571         for fname in self.get_all_relative_files():
572             base = Path(fname).with_suffix("").name.lower()
573             if len(base) >= 5:
574                 all_fnames[base].add(fname)
575 
576         matches = set()
577         for ident in idents:
578             if len(ident) < 5:
579                 continue
580             matches.update(all_fnames[ident.lower()])
581 
582         return matches
583 
584     def get_repo_map(self, force_refresh=False):
585         if not self.repo_map:
586             return
587 
588         cur_msg_text = self.get_cur_message_text()
589         mentioned_fnames = self.get_file_mentions(cur_msg_text)
590         mentioned_idents = self.get_ident_mentions(cur_msg_text)
591 
592         mentioned_fnames.update(self.get_ident_filename_matches(mentioned_idents))
593 
594         all_abs_files = set(self.get_all_abs_files())
595         repo_abs_read_only_fnames = set(self.abs_read_only_fnames) & all_abs_files
596         chat_files = set(self.abs_fnames) | repo_abs_read_only_fnames
597         other_files = all_abs_files - chat_files
598 
599         repo_content = self.repo_map.get_repo_map(
600             chat_files,
601             other_files,
602             mentioned_fnames=mentioned_fnames,
603             mentioned_idents=mentioned_idents,
604             force_refresh=force_refresh,
605         )
606 
607         # fall back to global repo map if files in chat are disjoint from rest of repo
608         if not repo_content:
609             repo_content = self.repo_map.get_repo_map(
610                 set(),
611                 all_abs_files,
612                 mentioned_fnames=mentioned_fnames,
613                 mentioned_idents=mentioned_idents,
614             )
615 
616         # fall back to completely unhinted repo
617         if not repo_content:
618             repo_content = self.repo_map.get_repo_map(
619                 set(),
620                 all_abs_files,
621             )
622 
623         return repo_content
624 
