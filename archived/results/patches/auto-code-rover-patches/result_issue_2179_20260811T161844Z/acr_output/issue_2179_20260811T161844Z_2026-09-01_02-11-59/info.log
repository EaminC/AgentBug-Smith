530                 prompt += "\n"
531                 prompt += relative_fname
532                 prompt += f"\n{self.fence[0]}\n"
533 
534                 prompt += content
535 
536                 # lines = content.splitlines(keepends=True)
537                 # lines = [f"{i+1:03}:{line}" for i, line in enumerate(lines)]
538                 # prompt += "".join(lines)
539 
540                 prompt += f"{self.fence[1]}\n"
541 
542         return prompt
