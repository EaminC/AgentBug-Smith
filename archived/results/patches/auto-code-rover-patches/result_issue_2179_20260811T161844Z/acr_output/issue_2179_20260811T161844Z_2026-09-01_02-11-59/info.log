704     def run_stream(self, user_message):
705         self.io.user_input(user_message)
706         self.init_before_message()
707         yield from self.send_message(user_message)
708 
709     def init_before_message(self):
710         self.aider_edited_files = set()
711         self.reflected_message = None
712         self.num_reflections = 0
713         self.lint_outcome = None
714         self.test_outcome = None
715         self.shell_commands = []
716 
717         if self.repo:
718             self.commit_before_message.append(self.repo.get_head_commit_sha())
719 
720     def run(self, with_message=None, preproc=True):
721         try:
722             if with_message:
723                 self.io.user_input(with_message)
724                 self.run_one(with_message, preproc)
725                 return self.partial_response_content
726 
727             while True:
728                 try:
729                     user_message = self.get_input()
730                     self.run_one(user_message, preproc)
731                     self.show_undo_hint()
732                 except KeyboardInterrupt:
733                     self.keyboard_interrupt()
734         except EOFError:
735             return
736 
737     def get_input(self):
738         inchat_files = self.get_inchat_relative_files()
739         read_only_files = [self.get_rel_fname(fname) for fname in self.abs_read_only_fnames]
740         all_files = sorted(set(inchat_files + read_only_files))
741         edit_format = "" if self.edit_format == self.main_model.edit_format else self.edit_format
742         return self.io.get_input(
743             self.root,
744             all_files,
745             self.get_addable_relative_files(),
746             self.commands,
747             self.abs_read_only_fnames,
748             edit_format=edit_format,
749         )
750 
751     def preproc_user_input(self, inp):
752         if not inp:
753             return
754 
755         if self.commands.is_command(inp):
756             return self.commands.run(inp)
757 
758         self.check_for_file_mentions(inp)
759         self.check_for_urls(inp)
760 
761         return inp
762 
763     def run_one(self, user_message, preproc):
764         self.init_before_message()
765 
766         if preproc:
767             message = self.preproc_user_input(user_message)
768         else:
769             message = user_message
770 
771         while message:
772             self.reflected_message = None
773             list(self.send_message(message))
774 
775             if not self.reflected_message:
776                 break
777 
778             if self.num_reflections >= self.max_reflections:
779                 self.io.tool_warning(f"Only {self.max_reflections} reflections allowed, stopping.")
780                 return
781 
782             self.num_reflections += 1
783             message = self.reflected_message
784 
785     def check_for_urls(self, inp):
786         url_pattern = re.compile(r"(https?://[^\s/$.?#].[^\s]*[^\s,.])")
787         urls = list(set(url_pattern.findall(inp)))  # Use set to remove duplicates
788         added_urls = []
789         group = ConfirmGroup(urls)
790         for url in urls:
791             if url not in self.rejected_urls:
792                 if self.io.confirm_ask(
793                     "Add URL to the chat?", subject=url, group=group, allow_never=True
794                 ):
795                     inp += "\n\n"
796                     inp += self.commands.cmd_web(url)
797                     added_urls.append(url)
798                 else:
799                     self.rejected_urls.add(url)
800 
801         return added_urls
802 
803     def keyboard_interrupt(self):
804         now = time.time()
805 
806         thresh = 2  # seconds
807         if self.last_keyboard_interrupt and now - self.last_keyboard_interrupt < thresh:
808             self.io.tool_warning("\n\n^C KeyboardInterrupt")
809             sys.exit()
810 
811         self.io.tool_warning("\n\n^C again to exit")
812 
813         self.last_keyboard_interrupt = now
814 
815     def summarize_start(self):
816         if not self.summarizer.too_big(self.done_messages):
817             return
818 
819         self.summarize_end()
820 
821         if self.verbose:
822             self.io.tool_output("Starting to summarize chat history.")
823 
824         self.summarizer_thread = threading.Thread(target=self.summarize_worker)
825         self.summarizer_thread.start()
826 
827     def summarize_worker(self):
828         try:
829             self.summarized_done_messages = self.summarizer.summarize(self.done_messages)
830         except ValueError as err:
831             self.io.tool_warning(err.args[0])
832 
833         if self.verbose:
834             self.io.tool_output("Finished summarizing chat history.")
835 
836     def summarize_end(self):
837         if self.summarizer_thread is None:
838             return
839 
840         self.summarizer_thread.join()
841         self.summarizer_thread = None
842 
843         self.done_messages = self.summarized_done_messages
844         self.summarized_done_messages = []
845 
846     def move_back_cur_messages(self, message):
847         self.done_messages += self.cur_messages
848         self.summarize_start()
849 
850         # TODO check for impact on image messages
851         if message:
852             self.done_messages += [
853                 dict(role="user", content=message),
854                 dict(role="assistant", content="Ok."),
855             ]
856         self.cur_messages = []
857 
858     def get_user_language(self):
859         if self.chat_language:
860             return self.chat_language
861 
862         try:
863             lang = locale.getlocale()[0]
864             if lang:
865                 return lang  # Return the full language code, including country
866         except Exception:
867             pass
868 
869         for env_var in ["LANG", "LANGUAGE", "LC_ALL", "LC_MESSAGES"]:
870             lang = os.environ.get(env_var)
871             if lang:
872                 return lang.split(".")[
873                     0
874                 ]  # Return language and country, but remove encoding if present
875 
876         return None
877 
878     def get_platform_info(self):
879         platform_text = f"- Platform: {platform.platform()}\n"
880         shell_var = "COMSPEC" if os.name == "nt" else "SHELL"
881         shell_val = os.getenv(shell_var)
882         platform_text += f"- Shell: {shell_var}={shell_val}\n"
883 
884         user_lang = self.get_user_language()
885         if user_lang:
886             platform_text += f"- Language: {user_lang}\n"
887 
888         dt = datetime.now().astimezone().strftime("%Y-%m-%d")
889         platform_text += f"- Current date: {dt}\n"
890 
891         if self.repo:
892             platform_text += "- The user is operating inside a git repository\n"
893 
894         if self.lint_cmds:
895             if self.auto_lint:
896                 platform_text += (
897                     "- The user's pre-commit runs these lint commands, don't suggest running"
898                     " them:\n"
899                 )
900             else:
901                 platform_text += "- The user prefers these lint commands:\n"
902             for lang, cmd in self.lint_cmds.items():
903                 if lang is None:
904                     platform_text += f"  - {cmd}\n"
905                 else:
906                     platform_text += f"  - {lang}: {cmd}\n"
907 
908         if self.test_cmd:
909             if self.auto_test:
910                 platform_text += (
911                     "- The user's pre-commit runs this test command, don't suggest running them: "
912                 )
913             else:
914                 platform_text += "- The user prefers this test command: "
915             platform_text += self.test_cmd + "\n"
916 
917         return platform_text
918 
919     def fmt_system_prompt(self, prompt):
920         lazy_prompt = self.gpt_prompts.lazy_prompt if self.main_model.lazy else ""
921         platform_text = self.get_platform_info()
922 
923         if self.suggest_shell_commands:
924             shell_cmd_prompt = self.gpt_prompts.shell_cmd_prompt.format(platform=platform_text)
925             shell_cmd_reminder = self.gpt_prompts.shell_cmd_reminder.format(platform=platform_text)
926         else:
927             shell_cmd_prompt = self.gpt_prompts.no_shell_cmd_prompt.format(platform=platform_text)
928             shell_cmd_reminder = self.gpt_prompts.no_shell_cmd_reminder.format(
929                 platform=platform_text
930             )
931 
932         prompt = prompt.format(
933             fence=self.fence,
934             lazy_prompt=lazy_prompt,
935             platform=platform_text,
936             shell_cmd_prompt=shell_cmd_prompt,
937             shell_cmd_reminder=shell_cmd_reminder,
938         )
939         return prompt
940 
941     def format_chat_chunks(self):
942         self.choose_fence()
943         main_sys = self.fmt_system_prompt(self.gpt_prompts.main_system)
944 
945         example_messages = []
946         if self.main_model.examples_as_sys_msg:
947             if self.gpt_prompts.example_messages:
948                 main_sys += "\n# Example conversations:\n\n"
949             for msg in self.gpt_prompts.example_messages:
950                 role = msg["role"]
951                 content = self.fmt_system_prompt(msg["content"])
952                 main_sys += f"## {role.upper()}: {content}\n\n"
953             main_sys = main_sys.strip()
954         else:
955             for msg in self.gpt_prompts.example_messages:
956                 example_messages.append(
957                     dict(
958                         role=msg["role"],
959                         content=self.fmt_system_prompt(msg["content"]),
960                     )
961                 )
962             if self.gpt_prompts.example_messages:
963                 example_messages += [
964                     dict(
965                         role="user",
966                         content=(
967                             "I switched to a new code base. Please don't consider the above files"
968                             " or try to edit them any longer."
969                         ),
970                     ),
971                     dict(role="assistant", content="Ok."),
972                 ]
973 
974         if self.gpt_prompts.system_reminder:
975             main_sys += "\n" + self.fmt_system_prompt(self.gpt_prompts.system_reminder)
976 
977         chunks = ChatChunks()
978 
979         if self.main_model.use_system_prompt:
980             chunks.system = [
981                 dict(role="system", content=main_sys),
982             ]
983         else:
984             chunks.system = [
985                 dict(role="user", content=main_sys),
986                 dict(role="assistant", content="Ok."),
987             ]
988 
989         chunks.examples = example_messages
990 
991         self.summarize_end()
992         chunks.done = self.done_messages
993 
994         chunks.repo = self.get_repo_messages()
995         chunks.readonly_files = self.get_readonly_files_messages()
996         chunks.chat_files = self.get_chat_files_messages()
997 
998         if self.gpt_prompts.system_reminder:
999             reminder_message = [
1000                 dict(
1001                     role="system", content=self.fmt_system_prompt(self.gpt_prompts.system_reminder)
1002                 ),
1003             ]
1004         else:
1005             reminder_message = []
1006 
1007         chunks.cur = list(self.cur_messages)
1008         chunks.reminder = []
1009 
1010         # TODO review impact of token count on image messages
1011         messages_tokens = self.main_model.token_count(chunks.all_messages())
1012         reminder_tokens = self.main_model.token_count(reminder_message)
1013         cur_tokens = self.main_model.token_count(chunks.cur)
1014 
1015         if None not in (messages_tokens, reminder_tokens, cur_tokens):
1016             total_tokens = messages_tokens + reminder_tokens + cur_tokens
1017         else:
1018             # add the reminder anyway
1019             total_tokens = 0
1020 
1021         final = chunks.cur[-1]
1022 
1023         max_input_tokens = self.main_model.info.get("max_input_tokens") or 0
1024         # Add the reminder prompt if we still have room to include it.
1025         if (
1026             max_input_tokens is None
1027             or total_tokens < max_input_tokens
1028             and self.gpt_prompts.system_reminder
1029         ):
1030             if self.main_model.reminder == "sys":
1031                 chunks.reminder = reminder_message
1032             elif self.main_model.reminder == "user" and final["role"] == "user":
1033                 # stuff it into the user message
1034                 new_content = (
1035                     final["content"]
1036                     + "\n\n"
1037                     + self.fmt_system_prompt(self.gpt_prompts.system_reminder)
1038                 )
1039                 chunks.cur[-1] = dict(role=final["role"], content=new_content)
1040 
1041         return chunks
1042 
1043     def format_messages(self):
1044         chunks = self.format_chat_chunks()
1045         if self.add_cache_headers:
1046             chunks.add_cache_control_headers()
1047 
1048         return chunks
1049 
1050     def warm_cache(self, chunks):
1051         if not self.add_cache_headers:
1052             return
1053         if not self.num_cache_warming_pings:
1054             return
1055 
1056         delay = 5 * 60 - 5
1057         self.next_cache_warm = time.time() + delay
1058         self.warming_pings_left = self.num_cache_warming_pings
1059         self.cache_warming_chunks = chunks
1060 
1061         if self.cache_warming_thread:
1062             return
1063 
1064         def warm_cache_worker():
1065             while True:
1066                 time.sleep(1)
1067                 if self.warming_pings_left <= 0:
1068                     continue
1069                 now = time.time()
1070                 if now < self.next_cache_warm:
1071                     continue
1072 
1073                 self.warming_pings_left -= 1
1074                 self.next_cache_warm = time.time() + delay
1075 
1076                 kwargs = dict(self.main_model.extra_params) or dict()
1077                 kwargs["max_tokens"] = 1
1078 
1079                 try:
1080                     completion = litellm.completion(
1081                         model=self.main_model.name,
1082                         messages=self.cache_warming_chunks.cacheable_messages(),
1083                         stream=False,
1084                         **kwargs,
1085                     )
1086                 except Exception as err:
1087                     self.io.tool_warning(f"Cache warming error: {str(err)}")
1088                     continue
1089 
1090                 cache_hit_tokens = getattr(
1091                     completion.usage, "prompt_cache_hit_tokens", 0
1092                 ) or getattr(completion.usage, "cache_read_input_tokens", 0)
1093 
1094                 if self.verbose:
1095                     self.io.tool_output(f"Warmed {format_tokens(cache_hit_tokens)} cached tokens.")
1096 
1097         self.cache_warming_thread = threading.Timer(0, warm_cache_worker)
1098         self.cache_warming_thread.daemon = True
1099         self.cache_warming_thread.start()
1100 
1101         return chunks
1102 
1103     def send_message(self, inp):
1104         self.cur_messages += [
1105             dict(role="user", content=inp),
1106         ]
1107 
1108         chunks = self.format_messages()
1109         messages = chunks.all_messages()
1110         self.warm_cache(chunks)
1111 
1112         if self.verbose:
1113             utils.show_messages(messages, functions=self.functions)
1114 
1115         self.multi_response_content = ""
1116         if self.show_pretty() and self.stream:
1117             self.mdstream = self.io.get_assistant_mdstream()
1118         else:
1119             self.mdstream = None
1120 
1121         retry_delay = 0.125
1122 
1123         self.usage_report = None
1124         exhausted = False
1125         interrupted = False
1126         try:
1127             while True:
1128                 try:
1129                     yield from self.send(messages, functions=self.functions)
1130                     break
1131                 except retry_exceptions() as err:
1132                     self.io.tool_warning(str(err))
1133                     retry_delay *= 2
1134                     if retry_delay > RETRY_TIMEOUT:
1135                         break
1136                     self.io.tool_output(f"Retrying in {retry_delay:.1f} seconds...")
1137                     time.sleep(retry_delay)
1138                     continue
1139                 except KeyboardInterrupt:
1140                     interrupted = True
1141                     break
1142                 except litellm.ContextWindowExceededError:
1143                     # The input is overflowing the context window!
1144                     exhausted = True
1145                     break
1146                 except litellm.exceptions.BadRequestError as br_err:
1147                     self.io.tool_error(f"BadRequestError: {br_err}")
1148                     return
1149                 except FinishReasonLength:
1150                     # We hit the output limit!
1151                     if not self.main_model.info.get("supports_assistant_prefill"):
1152                         exhausted = True
1153                         break
1154 
1155                     self.multi_response_content = self.get_multi_response_content()
1156 
1157                     if messages[-1]["role"] == "assistant":
1158                         messages[-1]["content"] = self.multi_response_content
1159                     else:
1160                         messages.append(
1161                             dict(role="assistant", content=self.multi_response_content, prefix=True)
1162                         )
1163                 except Exception as err:
1164                     self.io.tool_error(f"Unexpected error: {err}")
1165                     lines = traceback.format_exception(type(err), err, err.__traceback__)
1166                     self.io.tool_error("".join(lines))
1167                     return
1168         finally:
1169             if self.mdstream:
1170                 self.live_incremental_response(True)
1171                 self.mdstream = None
1172 
1173             self.partial_response_content = self.get_multi_response_content(True)
1174             self.multi_response_content = ""
1175 
1176         self.io.tool_output()
1177 
1178         self.show_usage_report()
1179 
1180         if exhausted:
1181             self.show_exhausted_error()
1182             self.num_exhausted_context_windows += 1
1183             return
1184 
1185         if self.partial_response_function_call:
1186             args = self.parse_partial_args()
1187             if args:
1188                 content = args.get("explanation") or ""
1189             else:
1190                 content = ""
1191         elif self.partial_response_content:
1192             content = self.partial_response_content
1193         else:
1194             content = ""
1195 
1196         try:
1197             self.reply_completed()
1198         except KeyboardInterrupt:
1199             interrupted = True
1200 
1201         if interrupted:
1202             content += "\n^C KeyboardInterrupt"
1203             self.cur_messages += [dict(role="assistant", content=content)]
1204             return
1205 
1206         edited = self.apply_updates()
1207 
1208         self.update_cur_messages()
1209 
1210         if edited:
1211             self.aider_edited_files.update(edited)
1212             saved_message = self.auto_commit(edited)
1213 
1214             if not saved_message and hasattr(self.gpt_prompts, "files_content_gpt_edits_no_repo"):
1215                 saved_message = self.gpt_prompts.files_content_gpt_edits_no_repo
1216 
1217             self.move_back_cur_messages(saved_message)
1218 
1219         if self.reflected_message:
1220             return
1221 
1222         if edited and self.auto_lint:
1223             lint_errors = self.lint_edited(edited)
1224             self.auto_commit(edited, context="Ran the linter")
1225             self.lint_outcome = not lint_errors
1226             if lint_errors:
1227                 ok = self.io.confirm_ask("Attempt to fix lint errors?")
1228                 if ok:
1229                     self.reflected_message = lint_errors
1230                     self.update_cur_messages()
1231                     return
1232 
1233         shared_output = self.run_shell_commands()
1234         if shared_output:
1235             self.cur_messages += [
1236                 dict(role="user", content=shared_output),
1237                 dict(role="assistant", content="Ok"),
1238             ]
1239 
1240         if edited and self.auto_test:
1241             test_errors = self.commands.cmd_test(self.test_cmd)
1242             self.test_outcome = not test_errors
1243             if test_errors:
1244                 ok = self.io.confirm_ask("Attempt to fix test errors?")
1245                 if ok:
1246                     self.reflected_message = test_errors
1247                     self.update_cur_messages()
1248                     return
1249 
1250         add_rel_files_message = self.check_for_file_mentions(content)
1251         if add_rel_files_message:
1252             if self.reflected_message:
1253                 self.reflected_message += "\n\n" + add_rel_files_message
1254             else:
1255                 self.reflected_message = add_rel_files_message
1256 
1257     def reply_completed(self):
1258         pass
1259 
1260     def show_exhausted_error(self):
1261         output_tokens = 0
1262         if self.partial_response_content:
1263             output_tokens = self.main_model.token_count(self.partial_response_content)
1264         max_output_tokens = self.main_model.info.get("max_output_tokens") or 0
1265 
1266         input_tokens = self.main_model.token_count(self.format_messages().all_messages())
1267         max_input_tokens = self.main_model.info.get("max_input_tokens") or 0
1268 
1269         total_tokens = input_tokens + output_tokens
1270 
1271         fudge = 0.7
1272 
1273         out_err = ""
1274         if output_tokens >= max_output_tokens * fudge:
1275             out_err = " -- possibly exceeded output limit!"
1276 
1277         inp_err = ""
1278         if input_tokens >= max_input_tokens * fudge:
1279             inp_err = " -- possibly exhausted context window!"
1280 
1281         tot_err = ""
1282         if total_tokens >= max_input_tokens * fudge:
1283             tot_err = " -- possibly exhausted context window!"
1284 
1285         res = ["", ""]
1286         res.append(f"Model {self.main_model.name} has hit a token limit!")
1287         res.append("Token counts below are approximate.")
1288         res.append("")
1289         res.append(f"Input tokens: ~{input_tokens:,} of {max_input_tokens:,}{inp_err}")
1290         res.append(f"Output tokens: ~{output_tokens:,} of {max_output_tokens:,}{out_err}")
1291         res.append(f"Total tokens: ~{total_tokens:,} of {max_input_tokens:,}{tot_err}")
1292 
1293         if output_tokens >= max_output_tokens:
1294             res.append("")
1295             res.append("To reduce output tokens:")
1296             res.append("- Ask for smaller changes in each request.")
1297             res.append("- Break your code into smaller source files.")
1298             if "diff" not in self.main_model.edit_format:
1299                 res.append(
1300                     "- Use a stronger model like gpt-4o, sonnet or opus that can return diffs."
1301                 )
1302 
1303         if input_tokens >= max_input_tokens or total_tokens >= max_input_tokens:
1304             res.append("")
1305             res.append("To reduce input tokens:")
1306             res.append("- Use /tokens to see token usage.")
1307             res.append("- Use /drop to remove unneeded files from the chat session.")
1308             res.append("- Use /clear to clear the chat history.")
1309             res.append("- Break your code into smaller source files.")
1310 
1311         res.append("")
1312         res.append(f"For more info: {urls.token_limits}")
1313 
1314         res = "".join([line + "\n" for line in res])
1315         self.io.tool_error(res)
1316 
1317     def lint_edited(self, fnames):
1318         res = ""
1319         for fname in fnames:
1320             errors = self.linter.lint(self.abs_root_path(fname))
1321 
1322             if errors:
1323                 res += "\n"
1324                 res += errors
1325                 res += "\n"
1326 
1327         if res:
1328             self.io.tool_warning(res)
1329 
1330         return res
1331 
1332     def update_cur_messages(self):
1333         if self.partial_response_content:
1334             self.cur_messages += [dict(role="assistant", content=self.partial_response_content)]
1335         if self.partial_response_function_call:
1336             self.cur_messages += [
1337                 dict(
1338                     role="assistant",
1339                     content=None,
1340                     function_call=self.partial_response_function_call,
1341                 )
1342             ]
1343 
1344     def get_file_mentions(self, content):
1345         words = set(word for word in content.split())
1346 
1347         # drop sentence punctuation from the end
1348         words = set(word.rstrip(",.!;:") for word in words)
1349 
1350         # strip away all kinds of quotes
1351         quotes = "".join(['"', "'", "`"])
1352         words = set(word.strip(quotes) for word in words)
1353 
1354         addable_rel_fnames = self.get_addable_relative_files()
1355 
1356         mentioned_rel_fnames = set()
1357         fname_to_rel_fnames = {}
1358         for rel_fname in addable_rel_fnames:
1359             normalized_rel_fname = rel_fname.replace("\\", "/")
1360             normalized_words = set(word.replace("\\", "/") for word in words)
1361             if normalized_rel_fname in normalized_words:
1362                 mentioned_rel_fnames.add(rel_fname)
1363 
1364             fname = os.path.basename(rel_fname)
1365 
1366             # Don't add basenames that could be plain words like "run" or "make"
1367             if "/" in fname or "\\" in fname or "." in fname or "_" in fname or "-" in fname:
1368                 if fname not in fname_to_rel_fnames:
1369                     fname_to_rel_fnames[fname] = []
1370                 fname_to_rel_fnames[fname].append(rel_fname)
1371 
1372         for fname, rel_fnames in fname_to_rel_fnames.items():
1373             if len(rel_fnames) == 1 and fname in words:
1374                 mentioned_rel_fnames.add(rel_fnames[0])
1375 
1376         return mentioned_rel_fnames
1377 
1378     def check_for_file_mentions(self, content):
1379         mentioned_rel_fnames = self.get_file_mentions(content)
1380 
1381         new_mentions = mentioned_rel_fnames - self.ignore_mentions
1382 
1383         if not new_mentions:
1384             return
1385 
1386         added_fnames = []
1387         group = ConfirmGroup(new_mentions)
1388         for rel_fname in sorted(new_mentions):
1389             if self.io.confirm_ask(f"Add {rel_fname} to the chat?", group=group, allow_never=True):
1390                 self.add_rel_fname(rel_fname)
1391                 added_fnames.append(rel_fname)
1392             else:
1393                 self.ignore_mentions.add(rel_fname)
1394 
1395         if added_fnames:
1396             return prompts.added_files.format(fnames=", ".join(added_fnames))
