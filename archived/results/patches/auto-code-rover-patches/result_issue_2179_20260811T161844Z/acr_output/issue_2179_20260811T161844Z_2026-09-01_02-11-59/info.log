494     def choose_fence(self):
495         all_content = ""
496         for _fname, content in self.get_abs_fnames_content():
497             all_content += content + "\n"
498         for _fname in self.abs_read_only_fnames:
499             content = self.io.read_text(_fname)
500             if content is not None:
501                 all_content += content + "\n"
502 
503         lines = all_content.splitlines()
504         good = False
505         for fence_open, fence_close in self.fences:
506             if any(line.startswith(fence_open) or line.startswith(fence_close) for line in lines):
507                 continue
508             good = True
509             break
510 
511         if good:
512             self.fence = (fence_open, fence_close)
513         else:
514             self.fence = self.fences[0]
515             self.io.tool_warning(
516                 "Unable to find a fencing strategy! Falling back to:"
517                 f" {self.fence[0]}...{self.fence[1]}"
518             )
519 
520         return
521 
522     def get_files_content(self, fnames=None):
