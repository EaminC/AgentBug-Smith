287     # MCP-specific methods
288 
289     def stop(
290         self, exc_type: Optional[BaseException], exc_val: Optional[BaseException], exc_tb: Optional[TracebackType]
291     ) -> None:
292         """Signals the background thread to stop and waits for it to complete, ensuring proper cleanup of all resources.
293 
294         This method is defensive and can handle partial initialization states that may occur
295         if start() fails partway through initialization.
296 
297         Resources to cleanup:
298         - _background_thread: Thread running the async event loop
299         - _background_thread_session: MCP ClientSession (auto-closed by context manager)
300         - _background_thread_event_loop: AsyncIO event loop in background thread
301         - _close_future: AsyncIO future to signal thread shutdown
302         - _close_exception: Exception that caused the background thread shutdown; None if a normal shutdown occurred.
303         - _init_future: Future for initialization synchronization
304 
305         Cleanup order:
306         1. Signal close future to background thread (if session initialized)
307         2. Wait for background thread to complete
308         3. Reset all state for reuse
309 
310         Args:
311             exc_type: Exception type if an exception was raised in the context
312             exc_val: Exception value if an exception was raised in the context
313             exc_tb: Exception traceback if an exception was raised in the context
314         """
315         self._log_debug_with_thread("exiting MCPClient context")
316 
317         # Only try to signal close future if we have a background thread
318         if self._background_thread is not None:
319             # Signal close future if event loop exists
320             if self._background_thread_event_loop is not None:
321 
322                 async def _set_close_event() -> None:
323                     if self._close_future and not self._close_future.done():
324                         self._close_future.set_result(None)
325 
326                 # Not calling _invoke_on_background_thread since the session does not need to exist
327                 # we only need the thread and event loop to exist.
328                 asyncio.run_coroutine_threadsafe(coro=_set_close_event(), loop=self._background_thread_event_loop)
329 
330             self._log_debug_with_thread("waiting for background thread to join")
331             self._background_thread.join()
332 
333         if self._background_thread_event_loop is not None:
334             self._background_thread_event_loop.close()
335 
336         self._log_debug_with_thread("background thread is closed, MCPClient context exited")
337 
338         # Reset fields to allow instance reuse
339         self._init_future = futures.Future()
340         self._background_thread = None
341         self._background_thread_session = None
342         self._background_thread_event_loop = None
343         self._session_id = uuid.uuid4()
344         self._loaded_tools = None
345         self._tool_provider_started = False
346         self._consumers = set()
347 
348         if self._close_exception:
349             exception = self._close_exception
350             self._close_exception = None
351             raise RuntimeError("Connection to the MCP server was closed") from exception
352 
353     def list_tools_sync(
354         self,
355         pagination_token: str | None = None,
356         prefix: str | None = None,
357         tool_filters: ToolFilters | None = None,
358     ) -> PaginatedList[MCPAgentTool]:
359         """Synchronously retrieves the list of available tools from the MCP server.
360 
361         This method calls the asynchronous list_tools method on the MCP session
362         and adapts the returned tools to the AgentTool interface.
363 
364         Args:
365             pagination_token: Optional token for pagination
366             prefix: Optional prefix to apply to tool names. If None, uses constructor default.
367                    If explicitly provided (including empty string), overrides constructor default.
368             tool_filters: Optional filters to apply to tools. If None, uses constructor default.
369                          If explicitly provided (including empty dict), overrides constructor default.
370 
371         Returns:
372             List[AgentTool]: A list of available tools adapted to the AgentTool interface
373         """
374         self._log_debug_with_thread("listing MCP tools synchronously")
375         if not self._is_session_active():
376             raise MCPClientInitializationError(CLIENT_SESSION_NOT_RUNNING_ERROR_MESSAGE)
377 
378         effective_prefix = self._prefix if prefix is None else prefix
379         effective_filters = self._tool_filters if tool_filters is None else tool_filters
380 
381         async def _list_tools_async() -> ListToolsResult:
382             return await cast(ClientSession, self._background_thread_session).list_tools(cursor=pagination_token)
383 
384         list_tools_response: ListToolsResult = self._invoke_on_background_thread(_list_tools_async()).result()
385         self._log_debug_with_thread("received %d tools from MCP server", len(list_tools_response.tools))
386 
387         mcp_tools = []
388         for tool in list_tools_response.tools:
389             # Apply prefix if specified
390             if effective_prefix:
391                 prefixed_name = f"{effective_prefix}_{tool.name}"
392                 mcp_tool = MCPAgentTool(tool, self, name_override=prefixed_name)
393                 logger.debug("tool_rename=<%s->%s> | renamed tool", tool.name, prefixed_name)
394             else:
395                 mcp_tool = MCPAgentTool(tool, self)
396 
397             # Apply filters if specified
398             if self._should_include_tool_with_filters(mcp_tool, effective_filters):
399                 mcp_tools.append(mcp_tool)
400 
401         self._log_debug_with_thread("successfully adapted %d MCP tools", len(mcp_tools))
402         return PaginatedList[MCPAgentTool](mcp_tools, token=list_tools_response.nextCursor)
403 
