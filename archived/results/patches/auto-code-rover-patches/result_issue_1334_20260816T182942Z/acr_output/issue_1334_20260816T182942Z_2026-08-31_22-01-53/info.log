87 class MCPClient(ToolProvider):
88     """Represents a connection to a Model Context Protocol (MCP) server.
89 
90     This class implements a context manager pattern for efficient connection management,
91     allowing reuse of the same connection for multiple tool calls to reduce latency.
92     It handles the creation, initialization, and cleanup of MCP connections.
93 
94     The connection runs in a background thread to avoid blocking the main application thread
95     while maintaining communication with the MCP service. When structured content is available
96     from MCP tools, it will be returned as the last item in the content array of the ToolResult.
97 
98     Warning:
99         This class implements the experimental ToolProvider interface and its methods
100         are subject to change.
101     """
102 
103     def __init__(
104         self,
105         transport_callable: Callable[[], MCPTransport],
106         *,
107         startup_timeout: int = 30,
108         tool_filters: ToolFilters | None = None,
109         prefix: str | None = None,
110         elicitation_callback: Optional[ElicitationFnT] = None,
111     ) -> None:
112         """Initialize a new MCP Server connection.
113 
114         Args:
115             transport_callable: A callable that returns an MCPTransport (read_stream, write_stream) tuple.
116             startup_timeout: Timeout after which MCP server initialization should be cancelled.
117                 Defaults to 30.
118             tool_filters: Optional filters to apply to tools.
119             prefix: Optional prefix for tool names.
120             elicitation_callback: Optional callback function to handle elicitation requests from the MCP server.
121         """
122         self._startup_timeout = startup_timeout
123         self._tool_filters = tool_filters
124         self._prefix = prefix
125         self._elicitation_callback = elicitation_callback
126 
127         mcp_instrumentation()
128         self._session_id = uuid.uuid4()
129         self._log_debug_with_thread("initializing MCPClient connection")
130         # Main thread blocks until future completes
131         self._init_future: futures.Future[None] = futures.Future()
132         # Set within the inner loop as it needs the asyncio loop
133         self._close_future: asyncio.futures.Future[None] | None = None
134         self._close_exception: None | Exception = None
135         # Do not want to block other threads while close event is false
136         self._transport_callable = transport_callable
137 
138         self._background_thread: threading.Thread | None = None
139         self._background_thread_session: ClientSession | None = None
140         self._background_thread_event_loop: AbstractEventLoop | None = None
141         self._loaded_tools: list[MCPAgentTool] | None = None
142         self._tool_provider_started = False
143         self._consumers: set[Any] = set()
144 
145     def __enter__(self) -> "MCPClient":
146         """Context manager entry point which initializes the MCP server connection.
147 
148         TODO: Refactor to lazy initialization pattern following idiomatic Python.
149         Heavy work in __enter__ is non-idiomatic - should move connection logic to first method call instead.
150         """
151         return self.start()
152 
153     def __exit__(self, exc_type: BaseException, exc_val: BaseException, exc_tb: TracebackType) -> None:
154         """Context manager exit point that cleans up resources."""
155         self.stop(exc_type, exc_val, exc_tb)
156 
157     def start(self) -> "MCPClient":
158         """Starts the background thread and waits for initialization.
159 
160         This method starts the background thread that manages the MCP connection
161         and blocks until the connection is ready or times out.
162 
163         Returns:
164             self: The MCPClient instance
165 
166         Raises:
167             Exception: If the MCP connection fails to initialize within the timeout period
168         """
169         if self._is_session_active():
170             raise MCPClientInitializationError("the client session is currently running")
171 
172         self._log_debug_with_thread("entering MCPClient context")
173         self._background_thread = threading.Thread(target=self._background_task, args=[], daemon=True)
174         self._background_thread.start()
175         self._log_debug_with_thread("background thread started, waiting for ready event")
176         try:
177             # Blocking main thread until session is initialized in other thread or if the thread stops
178             self._init_future.result(timeout=self._startup_timeout)
179             self._log_debug_with_thread("the client initialization was successful")
180         except futures.TimeoutError as e:
181             logger.exception("client initialization timed out")
182             # Pass None for exc_type, exc_val, exc_tb since this isn't a context manager exit
183             self.stop(None, None, None)
184             raise MCPClientInitializationError(
185                 f"background thread did not start in {self._startup_timeout} seconds"
186             ) from e
187         except Exception as e:
188             logger.exception("client failed to initialize")
189             # Pass None for exc_type, exc_val, exc_tb since this isn't a context manager exit
190             self.stop(None, None, None)
191             raise MCPClientInitializationError("the client initialization failed") from e
192         return self
193 
194     # ToolProvider interface methods (experimental, as ToolProvider is experimental)
195     async def load_tools(self, **kwargs: Any) -> Sequence[AgentTool]:
196         """Load and return tools from the MCP server.
197 
198         This method implements the ToolProvider interface by loading tools
199         from the MCP server and caching them for reuse.
200 
201         Args:
202             **kwargs: Additional arguments for future compatibility.
203 
204         Returns:
205             List of AgentTool instances from the MCP server.
206         """
207         logger.debug(
208             "started=<%s>, cached_tools=<%s> | loading tools",
209             self._tool_provider_started,
210             self._loaded_tools is not None,
211         )
212 
213         if not self._tool_provider_started:
214             try:
215                 logger.debug("starting MCP client")
216                 self.start()
217                 self._tool_provider_started = True
218                 logger.debug("MCP client started successfully")
219             except Exception as e:
220                 logger.error("error=<%s> | failed to start MCP client", e)
221                 raise ToolProviderException(f"Failed to start MCP client: {e}") from e
222 
223         if self._loaded_tools is None:
224             logger.debug("loading tools from MCP server")
225             self._loaded_tools = []
226             pagination_token = None
227             page_count = 0
228 
229             while True:
230                 logger.debug("page=<%d>, token=<%s> | fetching tools page", page_count, pagination_token)
231                 # Use constructor defaults for prefix and filters in load_tools
232                 paginated_tools = self.list_tools_sync(
233                     pagination_token, prefix=self._prefix, tool_filters=self._tool_filters
234                 )
235 
236                 # Tools are already filtered by list_tools_sync, so add them all
237                 for tool in paginated_tools:
238                     self._loaded_tools.append(tool)
239 
240                 logger.debug(
241                     "page=<%d>, page_tools=<%d>, total_filtered=<%d> | processed page",
242                     page_count,
243                     len(paginated_tools),
244                     len(self._loaded_tools),
245                 )
246 
247                 pagination_token = paginated_tools.pagination_token
248                 page_count += 1
249 
250                 if pagination_token is None:
251                     break
252 
253             logger.debug("final_tools=<%d> | loading complete", len(self._loaded_tools))
254 
255         return self._loaded_tools
256 
257     def add_consumer(self, consumer_id: Any, **kwargs: Any) -> None:
258         """Add a consumer to this tool provider.
259 
260         Synchronous to prevent GC deadlocks when called from Agent finalizers.
261         """
262         self._consumers.add(consumer_id)
263         logger.debug("added provider consumer, count=%d", len(self._consumers))
264 
265     def remove_consumer(self, consumer_id: Any, **kwargs: Any) -> None:
266         """Remove a consumer from this tool provider.
267 
268         This method is idempotent - calling it multiple times with the same ID
269         has no additional effect after the first call.
270 
271         Synchronous to prevent GC deadlocks when called from Agent finalizers.
272         Uses existing synchronous stop() method for safe cleanup.
273         """
274         self._consumers.discard(consumer_id)
275         logger.debug("removed provider consumer, count=%d", len(self._consumers))
276 
277         if not self._consumers and self._tool_provider_started:
278             logger.debug("no consumers remaining, cleaning up")
279             try:
280                 self.stop(None, None, None)  # Existing sync method - safe for finalizers
281                 self._tool_provider_started = False
282                 self._loaded_tools = None
283             except Exception as e:
284                 logger.error("error=<%s> | failed to cleanup MCP client", e)
285                 raise ToolProviderException(f"Failed to cleanup MCP client: {e}") from e
286 
287     # MCP-specific methods
288 
289     def stop(
290         self, exc_type: Optional[BaseException], exc_val: Optional[BaseException], exc_tb: Optional[TracebackType]
291     ) -> None:
292         """Signals the background thread to stop and waits for it to complete, ensuring proper cleanup of all resources.
293 
294         This method is defensive and can handle partial initialization states that may occur
295         if start() fails partway through initialization.
296 
297         Resources to cleanup:
298         - _background_thread: Thread running the async event loop
299         - _background_thread_session: MCP ClientSession (auto-closed by context manager)
300         - _background_thread_event_loop: AsyncIO event loop in background thread
301         - _close_future: AsyncIO future to signal thread shutdown
302         - _close_exception: Exception that caused the background thread shutdown; None if a normal shutdown occurred.
303         - _init_future: Future for initialization synchronization
304 
305         Cleanup order:
306         1. Signal close future to background thread (if session initialized)
307         2. Wait for background thread to complete
308         3. Reset all state for reuse
309 
310         Args:
311             exc_type: Exception type if an exception was raised in the context
312             exc_val: Exception value if an exception was raised in the context
313             exc_tb: Exception traceback if an exception was raised in the context
314         """
315         self._log_debug_with_thread("exiting MCPClient context")
316 
317         # Only try to signal close future if we have a background thread
318         if self._background_thread is not None:
319             # Signal close future if event loop exists
320             if self._background_thread_event_loop is not None:
321 
322                 async def _set_close_event() -> None:
323                     if self._close_future and not self._close_future.done():
324                         self._close_future.set_result(None)
325 
326                 # Not calling _invoke_on_background_thread since the session does not need to exist
327                 # we only need the thread and event loop to exist.
328                 asyncio.run_coroutine_threadsafe(coro=_set_close_event(), loop=self._background_thread_event_loop)
329 
330             self._log_debug_with_thread("waiting for background thread to join")
331             self._background_thread.join()
332 
333         if self._background_thread_event_loop is not None:
334             self._background_thread_event_loop.close()
335 
336         self._log_debug_with_thread("background thread is closed, MCPClient context exited")
337 
338         # Reset fields to allow instance reuse
339         self._init_future = futures.Future()
340         self._background_thread = None
341         self._background_thread_session = None
342         self._background_thread_event_loop = None
343         self._session_id = uuid.uuid4()
344         self._loaded_tools = None
345         self._tool_provider_started = False
346         self._consumers = set()
347 
348         if self._close_exception:
349             exception = self._close_exception
350             self._close_exception = None
351             raise RuntimeError("Connection to the MCP server was closed") from exception
352 
353     def list_tools_sync(
354         self,
355         pagination_token: str | None = None,
356         prefix: str | None = None,
357         tool_filters: ToolFilters | None = None,
358     ) -> PaginatedList[MCPAgentTool]:
359         """Synchronously retrieves the list of available tools from the MCP server.
360 
361         This method calls the asynchronous list_tools method on the MCP session
362         and adapts the returned tools to the AgentTool interface.
363 
364         Args:
365             pagination_token: Optional token for pagination
366             prefix: Optional prefix to apply to tool names. If None, uses constructor default.
367                    If explicitly provided (including empty string), overrides constructor default.
368             tool_filters: Optional filters to apply to tools. If None, uses constructor default.
369                          If explicitly provided (including empty dict), overrides constructor default.
370 
371         Returns:
372             List[AgentTool]: A list of available tools adapted to the AgentTool interface
373         """
374         self._log_debug_with_thread("listing MCP tools synchronously")
375         if not self._is_session_active():
376             raise MCPClientInitializationError(CLIENT_SESSION_NOT_RUNNING_ERROR_MESSAGE)
377 
378         effective_prefix = self._prefix if prefix is None else prefix
379         effective_filters = self._tool_filters if tool_filters is None else tool_filters
380 
381         async def _list_tools_async() -> ListToolsResult:
382             return await cast(ClientSession, self._background_thread_session).list_tools(cursor=pagination_token)
383 
384         list_tools_response: ListToolsResult = self._invoke_on_background_thread(_list_tools_async()).result()
385         self._log_debug_with_thread("received %d tools from MCP server", len(list_tools_response.tools))
386 
387         mcp_tools = []
388         for tool in list_tools_response.tools:
389             # Apply prefix if specified
390             if effective_prefix:
391                 prefixed_name = f"{effective_prefix}_{tool.name}"
392                 mcp_tool = MCPAgentTool(tool, self, name_override=prefixed_name)
393                 logger.debug("tool_rename=<%s->%s> | renamed tool", tool.name, prefixed_name)
394             else:
395                 mcp_tool = MCPAgentTool(tool, self)
396 
397             # Apply filters if specified
398             if self._should_include_tool_with_filters(mcp_tool, effective_filters):
399                 mcp_tools.append(mcp_tool)
400 
401         self._log_debug_with_thread("successfully adapted %d MCP tools", len(mcp_tools))
402         return PaginatedList[MCPAgentTool](mcp_tools, token=list_tools_response.nextCursor)
403 
404     def list_prompts_sync(self, pagination_token: Optional[str] = None) -> ListPromptsResult:
405         """Synchronously retrieves the list of available prompts from the MCP server.
406 
407         This method calls the asynchronous list_prompts method on the MCP session
408         and returns the raw ListPromptsResult with pagination support.
409 
410         Args:
411             pagination_token: Optional token for pagination
412 
413         Returns:
414             ListPromptsResult: The raw MCP response containing prompts and pagination info
415         """
416         self._log_debug_with_thread("listing MCP prompts synchronously")
417         if not self._is_session_active():
418             raise MCPClientInitializationError(CLIENT_SESSION_NOT_RUNNING_ERROR_MESSAGE)
419 
420         async def _list_prompts_async() -> ListPromptsResult:
421             return await cast(ClientSession, self._background_thread_session).list_prompts(cursor=pagination_token)
422 
423         list_prompts_result: ListPromptsResult = self._invoke_on_background_thread(_list_prompts_async()).result()
424         self._log_debug_with_thread("received %d prompts from MCP server", len(list_prompts_result.prompts))
425         for prompt in list_prompts_result.prompts:
426             self._log_debug_with_thread(prompt.name)
427 
428         return list_prompts_result
