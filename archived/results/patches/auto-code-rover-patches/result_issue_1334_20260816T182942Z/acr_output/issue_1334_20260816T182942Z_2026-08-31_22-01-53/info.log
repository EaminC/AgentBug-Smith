772     def _should_include_tool_with_filters(self, tool: MCPAgentTool, filters: Optional[ToolFilters]) -> bool:
773         """Check if a tool should be included based on provided filters."""
774         if not filters:
775             return True
776 
777         # Apply allowed filter
778         if "allowed" in filters:
779             if not self._matches_patterns(tool, filters["allowed"]):
780                 return False
781 
782         # Apply rejected filter
783         if "rejected" in filters:
784             if self._matches_patterns(tool, filters["rejected"]):
785                 return False
786 
787         return True
788 
789     def _matches_patterns(self, tool: MCPAgentTool, patterns: list[_ToolMatcher]) -> bool:
790         """Check if tool matches any of the given patterns."""
791         for pattern in patterns:
792             if callable(pattern):
793                 if pattern(tool):
794                     return True
795             elif isinstance(pattern, Pattern):
796                 if pattern.match(tool.mcp_tool.name):
797                     return True
798             elif isinstance(pattern, str):
799                 if pattern == tool.mcp_tool.name:
800                     return True
801         return False
802 
