194     # ToolProvider interface methods (experimental, as ToolProvider is experimental)
195     async def load_tools(self, **kwargs: Any) -> Sequence[AgentTool]:
196         """Load and return tools from the MCP server.
197 
198         This method implements the ToolProvider interface by loading tools
199         from the MCP server and caching them for reuse.
200 
201         Args:
202             **kwargs: Additional arguments for future compatibility.
203 
204         Returns:
205             List of AgentTool instances from the MCP server.
206         """
207         logger.debug(
208             "started=<%s>, cached_tools=<%s> | loading tools",
209             self._tool_provider_started,
210             self._loaded_tools is not None,
211         )
212 
213         if not self._tool_provider_started:
214             try:
215                 logger.debug("starting MCP client")
216                 self.start()
217                 self._tool_provider_started = True
218                 logger.debug("MCP client started successfully")
219             except Exception as e:
220                 logger.error("error=<%s> | failed to start MCP client", e)
221                 raise ToolProviderException(f"Failed to start MCP client: {e}") from e
222 
223         if self._loaded_tools is None:
224             logger.debug("loading tools from MCP server")
225             self._loaded_tools = []
226             pagination_token = None
227             page_count = 0
228 
229             while True:
230                 logger.debug("page=<%d>, token=<%s> | fetching tools page", page_count, pagination_token)
231                 # Use constructor defaults for prefix and filters in load_tools
232                 paginated_tools = self.list_tools_sync(
233                     pagination_token, prefix=self._prefix, tool_filters=self._tool_filters
234                 )
235 
236                 # Tools are already filtered by list_tools_sync, so add them all
237                 for tool in paginated_tools:
238                     self._loaded_tools.append(tool)
239 
240                 logger.debug(
241                     "page=<%d>, page_tools=<%d>, total_filtered=<%d> | processed page",
242                     page_count,
243                     len(paginated_tools),
244                     len(self._loaded_tools),
245                 )
246 
247                 pagination_token = paginated_tools.pagination_token
248                 page_count += 1
249 
250                 if pagination_token is None:
251                     break
252 
253             logger.debug("final_tools=<%d> | loading complete", len(self._loaded_tools))
254 
255         return self._loaded_tools
256 
257     def add_consumer(self, consumer_id: Any, **kwargs: Any) -> None:
258         """Add a consumer to this tool provider.
259 
260         Synchronous to prevent GC deadlocks when called from Agent finalizers.
261         """
262         self._consumers.add(consumer_id)
263         logger.debug("added provider consumer, count=%d", len(self._consumers))
264 
265     def remove_consumer(self, consumer_id: Any, **kwargs: Any) -> None:
266         """Remove a consumer from this tool provider.
267 
268         This method is idempotent - calling it multiple times with the same ID
269         has no additional effect after the first call.
270 
271         Synchronous to prevent GC deadlocks when called from Agent finalizers.
272         Uses existing synchronous stop() method for safe cleanup.
273         """
274         self._consumers.discard(consumer_id)
275         logger.debug("removed provider consumer, count=%d", len(self._consumers))
276 
277         if not self._consumers and self._tool_provider_started:
278             logger.debug("no consumers remaining, cleaning up")
279             try:
280                 self.stop(None, None, None)  # Existing sync method - safe for finalizers
281                 self._tool_provider_started = False
282                 self._loaded_tools = None
283             except Exception as e:
284                 logger.error("error=<%s> | failed to cleanup MCP client", e)
285                 raise ToolProviderException(f"Failed to cleanup MCP client: {e}") from e
