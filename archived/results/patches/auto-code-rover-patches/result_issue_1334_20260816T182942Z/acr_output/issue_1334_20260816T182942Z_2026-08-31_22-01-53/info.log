452     def call_tool_sync(
453         self,
454         tool_use_id: str,
455         name: str,
456         arguments: dict[str, Any] | None = None,
457         read_timeout_seconds: timedelta | None = None,
458     ) -> MCPToolResult:
459         """Synchronously calls a tool on the MCP server.
460 
461         This method calls the asynchronous call_tool method on the MCP session
462         and converts the result to the ToolResult format. If the MCP tool returns
463         structured content, it will be included as the last item in the content array
464         of the returned ToolResult.
465 
466         Args:
467             tool_use_id: Unique identifier for this tool use
468             name: Name of the tool to call
469             arguments: Optional arguments to pass to the tool
470             read_timeout_seconds: Optional timeout for the tool call
471 
472         Returns:
473             MCPToolResult: The result of the tool call
474         """
475         self._log_debug_with_thread("calling MCP tool '%s' synchronously with tool_use_id=%s", name, tool_use_id)
476         if not self._is_session_active():
477             raise MCPClientInitializationError(CLIENT_SESSION_NOT_RUNNING_ERROR_MESSAGE)
478 
479         async def _call_tool_async() -> MCPCallToolResult:
480             return await cast(ClientSession, self._background_thread_session).call_tool(
481                 name, arguments, read_timeout_seconds
482             )
483 
484         try:
485             call_tool_result: MCPCallToolResult = self._invoke_on_background_thread(_call_tool_async()).result()
486             return self._handle_tool_result(tool_use_id, call_tool_result)
487         except Exception as e:
488             logger.exception("tool execution failed")
489             return self._handle_tool_execution_error(tool_use_id, e)
