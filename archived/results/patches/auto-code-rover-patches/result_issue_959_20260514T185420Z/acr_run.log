971     def register_agent_skill(
972         self,
973         skill_dir: str,
974     ) -> None:
975         """Register agent skills from a given directory. This function will
976         scan the directory, read metadata from the SKILL.md file, and add
977         it to the skill related prompt. Developers can obtain the
978         skills-related prompt by calling `toolkit.get_agent_skill_prompt()`.
979 
980         .. note:: This directory
981          - Must include a SKILL.md file at the top level
982          - The SKILL.md must have a YAML Front Matter including `name` and
983             `description` fields
984          - All files must specify a common root directory in their paths
985 
986         Args:
987             skill_dir (`str`):
988                 The path to the skill directory.
989         """
990         import frontmatter
991 
992         # Check the skill directory
993         if not os.path.isdir(skill_dir):
994             raise ValueError(
995                 f"The skill directory '{skill_dir}' does not exist or is "
996                 "not a directory.",
997             )
998 
999         # Check SKILL.md file
1000         path_skill_md = os.path.join(skill_dir, "SKILL.md")
1001         if not os.path.isfile(path_skill_md):
1002             raise ValueError(
1003                 f"The skill directory '{skill_dir}' must include a "
1004                 "SKILL.md file at the top level.",
1005             )
1006 
1007         # Check YAML Front Matter
1008         with open(path_skill_md, "r", encoding="utf-8") as f:
1009             post = frontmatter.load(f)
1010 
1011         name = post.get("name", None)
1012         description = post.get("description", None)
1013 
1014         if not name or not description:
1015             raise ValueError(
1016                 f"The SKILL.md file in '{skill_dir}' must have a YAML Front "
1017                 "Matter including `name` and `description` fields.",
1018             )
1019 
1020         name, description = str(name), str(description)
1021         if name in self.skills:
1022             raise ValueError(
1023                 f"An agent skill with name '{name}' is already registered "
1024                 "in the toolkit.",
1025             )
1026 
1027         self.skills[name] = AgentSkill(
1028             name=name,
1029             description=description,
1030             dir=skill_dir,
1031         )
1032 
1033         logger.info(
1034             "Registered agent skill '%s' from directory '%s'.",
1035             name,
1036             skill_dir,
1037         )
1038 
1039     def remove_agent_skill(self, name: str) -> None:
1040         """Remove an agent skill by its name.
1041 
1042         Args:
1043             name (`str`):
1044                 The name of the agent skill to be removed.
1045         """
1046         if name in self.skills:
1047             self.skills.pop(name)
1048         else:
1049             logger.warning(
1050                 "Agent skill '%s' not found in the toolkit, skipping removal.",
1051                 name,
1052             )
1053 
1054     def get_agent_skill_prompt(self) -> str | None:
1055         """Get the prompt for all registered agent skills, which can be
1056         attached to the system prompt for the agent.
1057 
1058         The prompt is consisted of an overall instruction and the detailed
1059         descriptions of each skill, including its name, description, and
1060         directory.
1061 
1062         .. note:: If no skill is registered, None will be returned.
1063 
1064         Returns:
1065             `str | None`:
1066                 The combined prompt for all registered agent skills, or None
1067                 if no skill is registered.
1068         """
1069         if len(self.skills) == 0:
1070             return None
1071 
1072         skill_descriptions = [
1073             self._agent_skill_instruction,
1074         ] + [
1075             self._agent_skill_template.format(
1076                 name=_["name"],
1077                 description=_["description"],
1078                 dir=_["dir"],
1079             )
1080             for _ in self.skills.values()
1081         ]
1082         return "\n".join(skill_descriptions)

