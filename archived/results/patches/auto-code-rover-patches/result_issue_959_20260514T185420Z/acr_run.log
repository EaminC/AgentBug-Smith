465     def get_json_schemas(
466         self,
467     ) -> list[dict]:
468         """Get the JSON schemas from the tool functions that belong to the
469         active groups.
470 
471         .. note:: The preset keyword arguments is removed from the JSON
472          schema, and the extended model is applied if it is set.
473 
474         Example:
475             .. code-block:: JSON
476                 :caption: Example of tool function JSON schemas
477 
478                 [
479                     {
480                         "type": "function",
481                         "function": {
482                             "name": "google_search",
483                             "description": "Search on Google.",
484                             "parameters": {
485                                 "type": "object",
486                                 "properties": {
487                                     "query": {
488                                         "type": "string",
489                                         "description": "The search query."
490                                     }
491                                 },
492                                 "required": ["query"]
493                             }
494                         }
495                     },
496                     ...
497                 ]
498 
499         Returns:
500             `list[dict]`:
501                 A list of function JSON schemas.
502         """
503         # If meta tool is set here, update its extended model here
504         if "reset_equipped_tools" in self.tools:
505             fields = {}
506             for group_name, group in self.groups.items():
507                 if group_name == "basic":
508                     continue
509                 fields[group_name] = (
510                     bool,
511                     Field(
512                         default=False,
513                         description=group.description,
514                     ),
515                 )
516             extended_model = create_model("_DynamicModel", **fields)
517             self.set_extended_model(
518                 "reset_equipped_tools",
519                 extended_model,
520             )
521 
522         return [
523             tool.extended_json_schema
524             for tool in self.tools.values()
525             if tool.group == "basic" or self.groups[tool.group].active
526         ]
527 
528     def set_extended_model(
529         self,
530         func_name: str,
531         model: Type[BaseModel] | None,
532     ) -> None:
533         """Set the extended model for a tool function, so that the original
534         JSON schema will be extended.
535 
536         Args:
537             func_name (`str`):
538                 The name of the tool function.
539             model (`Union[Type[BaseModel], None]`):
540                 The extended model to be set.
541         """
542         if model is not None and not issubclass(model, BaseModel):
543             raise TypeError(
544                 "The extended model must be a child class of pydantic "
545                 f"BaseModel, but got {type(model)}.",
546             )
547 
548         if func_name in self.tools:
549             self.tools[func_name].extended_model = model
550 
551         else:
552             raise ValueError(
553                 f"Tool function '{func_name}' not found in the toolkit.",
554             )
