205     # pylint: disable=too-many-branches, too-many-statements
206     def register_tool_function(
207         self,
208         tool_func: ToolFunction,
209         group_name: str | Literal["basic"] = "basic",
210         preset_kwargs: dict[str, JSONSerializableObject] | None = None,
211         func_description: str | None = None,
212         json_schema: dict | None = None,
213         include_long_description: bool = True,
214         include_var_positional: bool = False,
215         include_var_keyword: bool = False,
216         postprocess_func: (
217             Callable[
218                 [ToolUseBlock, ToolResponse],
219                 ToolResponse | None,
220             ]
221             | Callable[
222                 [ToolUseBlock, ToolResponse],
223                 Awaitable[ToolResponse | None],
224             ]
225         )
226         | None = None,
227         namesake_strategy: Literal[
228             "override",
229             "skip",
230             "raise",
231             "rename",
232         ] = "raise",
233     ) -> None:
234         """Register a tool function to the toolkit.
235 
236         Args:
237             tool_func (`ToolFunction`):
238                 The tool function, which can be async or sync, streaming or
239                 not-streaming, but the response must be a `ToolResponse`
240                 object.
241             group_name (`str | Literal["basic"]`, defaults to `"basic"`):
242                 The belonging group of the tool function. Tools in "basic"
243                 group is always included in the JSON schema, while the others
244                 are only included when their group is active.
245             preset_kwargs (`dict[str, JSONSerializableObject] | None`, \
246             optional):
247                 Preset arguments by the user, which will not be included in
248                 the JSON schema, nor exposed to the agent.
249             func_description (`str | None`, optional):
250                 The function description. If not provided, the description
251                 will be extracted from the docstring automatically.
252             json_schema (`dict | None`, optional):
253                 Manually provided JSON schema for the tool function, which
254                 should be `{"type": "function", "function": {"name":
255                 "function_name": "xx", "description": "xx",
256                 "parameters": {...}}}`
257             include_long_description (`bool`, defaults to `True`):
258                 When extracting function description from the docstring, if
259                 the long description will be included.
260             include_var_positional (`bool`, defaults to `False`):
261                 Whether to include the variable positional arguments (`*args`)
262                 in the function schema.
263             include_var_keyword (`bool`, defaults to `False`):
264                 Whether to include the variable keyword arguments (`**kwargs`)
265                 in the function schema.
266             postprocess_func (`(Callable[[ToolUseBlock, ToolResponse], \
267             ToolResponse | None] | Callable[[ToolUseBlock, ToolResponse], \
268             Awaitable[ToolResponse | None]]) | None`, optional):
269                 A post-processing function that will be called after the tool
270                 function is executed, taking the tool call block and tool
271                 response as arguments. The function can be either sync or
272                 async. If it returns `None`, the tool result will be
273                 returned as is. If it returns a `ToolResponse`,
274                 the returned block will be used as the final tool result.
275             namesake_strategy (`Literal['raise', 'override', 'skip', \
276             'rename']`, defaults to `'raise'`):
277                 The strategy to handle the tool function name conflict:
278                 - 'raise': raise a ValueError (default behavior).
279                 - 'override': override the existing tool function with the new
280                   one.
281                 - 'skip': skip the registration of the new tool function.
282                 - 'rename': rename the new tool function by appending a random
283                   suffix to make it unique.
284         """
285         # Arguments checking
286         if group_name not in self.groups and group_name != "basic":
287             raise ValueError(
288                 f"Tool group '{group_name}' not found.",
289             )
290 
291         # Check the manually provided JSON schema if provided
292         if json_schema:
293             assert (
294                 isinstance(json_schema, dict)
295                 and "type" in json_schema
296                 and json_schema["type"] == "function"
297                 and "function" in json_schema
298                 and isinstance(json_schema["function"], dict)
299             ), "Invalid JSON schema for the tool function."
300 
301         # Handle MCP tool function and regular function respectively
302         mcp_name = None
303         if isinstance(tool_func, MCPToolFunction):
304             func_name = tool_func.name
305             original_func = tool_func.__call__
306             json_schema = json_schema or tool_func.json_schema
307             mcp_name = tool_func.mcp_name
308 
309         elif isinstance(tool_func, partial):
310             # partial function
311             kwargs = tool_func.keywords
312             # Turn args into keyword arguments
313             if tool_func.args:
314                 param_names = list(
315                     inspect.signature(tool_func.func).parameters.keys(),
316                 )
317                 for i, arg in enumerate(tool_func.args):
318                     if i < len(param_names):
319                         kwargs[param_names[i]] = arg
320 
321             preset_kwargs = {
322                 **kwargs,
323                 **(preset_kwargs or {}),
324             }
325 
326             func_name = tool_func.func.__name__
327             original_func = tool_func.func
328             json_schema = json_schema or _parse_tool_function(
329                 tool_func.func,
330                 include_long_description=include_long_description,
331                 include_var_positional=include_var_positional,
332                 include_var_keyword=include_var_keyword,
333             )
334 
335         else:
336             # normal function
337             func_name = tool_func.__name__
338             original_func = tool_func
339             json_schema = json_schema or _parse_tool_function(
340                 tool_func,
341                 include_long_description=include_long_description,
342                 include_var_positional=include_var_positional,
343                 include_var_keyword=include_var_keyword,
344             )
345 
346         # Override the description if provided
347         if func_description:
348             json_schema["function"]["description"] = func_description
349 
350         # Remove the preset kwargs from the JSON schema
351         for arg_name in preset_kwargs or {}:
352             if arg_name in json_schema["function"]["parameters"]["properties"]:
353                 json_schema["function"]["parameters"]["properties"].pop(
354                     arg_name,
355                 )
356 
357         if "required" in json_schema["function"]["parameters"]:
358             for arg_name in preset_kwargs or {}:
359                 if (
360                     arg_name
361                     in json_schema["function"]["parameters"]["required"]
362                 ):
363                     json_schema["function"]["parameters"]["required"].remove(
364                         arg_name,
365                     )
366 
367             # Remove the required field if it is empty
368             if len(json_schema["function"]["parameters"]["required"]) == 0:
369                 json_schema["function"]["parameters"].pop("required", None)
370 
371         func_obj = RegisteredToolFunction(
372             name=func_name,
373             group=group_name,
374             source="function",
375             original_func=original_func,
376             json_schema=json_schema,
377             preset_kwargs=preset_kwargs or {},
378             extended_model=None,
379             mcp_name=mcp_name,
380             postprocess_func=postprocess_func,
381         )
382 
383         if func_name in self.tools:
384             if namesake_strategy == "raise":
385                 raise ValueError(
386                     f"A function with name '{func_name}' is already "
387                     f"registered in the toolkit.",
388                 )
389 
390             if namesake_strategy == "skip":
391                 logger.warning(
392                     "A function with name '%s' is already "
393                     "registered in the toolkit. Skipping registration.",
394                     func_name,
395                 )
396 
397             elif namesake_strategy == "override":
398                 logger.warning(
399                     "A function with name '%s' is already registered "
400                     "in the toolkit. Overriding with the new function.",
401                     func_name,
402                 )
403                 self.tools[func_name] = func_obj
404 
405             elif namesake_strategy == "rename":
406                 new_func_name = func_name
407                 for _ in range(100):
408                     suffix = shortuuid.uuid()[:5]
409                     new_func_name = f"{func_name}_{suffix}"
410                     if new_func_name not in self.tools:
411                         break
412 
413                 # Raise error if failed to find a unique name
414                 if new_func_name in self.tools:
415                     raise RuntimeError(
416                         f"Failed to register tool function '{func_name}' with "
417                         "a unique name after 100 attempts.",
418                     )
419                 logger.warning(
420                     "A function with name '%s' is already "
421                     "registered in the toolkit. Renaming the new function to "
422                     "'%s'.",
423                     func_name,
424                     new_func_name,
425                 )
426 
427                 # Replace the function name with the new one
428                 func_obj.name = new_func_name
429                 func_obj.json_schema["function"]["name"] = new_func_name
430 
431                 self.tools[new_func_name] = func_obj
432 
433             else:
434                 raise ValueError(
435                     f"Invalid namesake_strategy: {namesake_strategy}. "
436                     "Supported strategies are 'raise', 'override', 'skip', "
437                     "and 'rename'.",
438                 )
439 
440         else:
441             self.tools[func_name] = func_obj
442 
443     def remove_tool_function(
444         self,
445         tool_name: str,
446         allow_not_exist: bool = True,
447     ) -> None:
448         """Remove tool function from the toolkit by its name.
449 
450         Args:
451             tool_name (`str`):
452                 The name of the tool function to be removed.
453             allow_not_exist (`bool`):
454                 Allow the tool function to not exist when removing.
455         """
456 
457         if tool_name not in self.tools and not allow_not_exist:
458             raise ValueError(
459                 f"Tool function '{tool_name}' does not exist in the "
460                 "toolkit.",
461             )
462 
463         self.tools.pop(tool_name, None)
464 
465     def get_json_schemas(
466         self,
467     ) -> list[dict]:
468         """Get the JSON schemas from the tool functions that belong to the
469         active groups.
470 
471         .. note:: The preset keyword arguments is removed from the JSON
472          schema, and the extended model is applied if it is set.
473 
474         Example:
475             .. code-block:: JSON
476                 :caption: Example of tool function JSON schemas
477 
478                 [
479                     {
480                         "type": "function",
481                         "function": {
482                             "name": "google_search",
483                             "description": "Search on Google.",
484                             "parameters": {
485                                 "type": "object",
486                                 "properties": {
487                                     "query": {
488                                         "type": "string",
489                                         "description": "The search query."
490                                     }
491                                 },
492                                 "required": ["query"]
493                             }
494                         }
495                     },
496                     ...
497                 ]
498 
499         Returns:
500             `list[dict]`:
501                 A list of function JSON schemas.
502         """
503         # If meta tool is set here, update its extended model here
504         if "reset_equipped_tools" in self.tools:
505             fields = {}
506             for group_name, group in self.groups.items():
507                 if group_name == "basic":
508                     continue
509                 fields[group_name] = (
510                     bool,
511                     Field(
512                         default=False,
513                         description=group.description,
514                     ),
515                 )
516             extended_model = create_model("_DynamicModel", **fields)
517             self.set_extended_model(
518                 "reset_equipped_tools",
519                 extended_model,
520             )
521 
522         return [
523             tool.extended_json_schema
524             for tool in self.tools.values()
525             if tool.group == "basic" or self.groups[tool.group].active
526         ]
527 
528     def set_extended_model(
529         self,
530         func_name: str,
531         model: Type[BaseModel] | None,
532     ) -> None:
533         """Set the extended model for a tool function, so that the original
534         JSON schema will be extended.
535 
536         Args:
537             func_name (`str`):
538                 The name of the tool function.
539             model (`Union[Type[BaseModel], None]`):
540                 The extended model to be set.
541         """
542         if model is not None and not issubclass(model, BaseModel):
543             raise TypeError(
544                 "The extended model must be a child class of pydantic "
545                 f"BaseModel, but got {type(model)}.",
546             )
547 
548         if func_name in self.tools:
549             self.tools[func_name].extended_model = model
550 
551         else:
552             raise ValueError(
553                 f"Tool function '{func_name}' not found in the toolkit.",
554             )
555 
556     async def remove_mcp_clients(
557         self,
558         client_names: list[str],
559     ) -> None:
560         """Remove tool functions from the MCP clients by their names.
561 
562         Args:
563             client_names (`list[str]`):
564                 The names of the MCP client, which used to initialize the
565                 client instance.
566         """
567         if isinstance(client_names, str):
568             client_names = [client_names]
569 
570         if isinstance(client_names, list) and not all(
571             isinstance(_, str) for _ in client_names
572         ):
573             raise TypeError(
574                 f"The client_names must be a list of strings, "
575                 f"but got {type(client_names)}.",
576             )
577 
578         to_removed = []
579         func_names = deepcopy(list(self.tools.keys()))
580         for func_name in func_names:
581             if self.tools[func_name].mcp_name in client_names:
582                 self.tools.pop(func_name)
583                 to_removed.append(func_name)
584 
585         logger.info(
586             "Removed %d tool functions from %d MCP: %s",
587             len(to_removed),
588             len(client_names),
589             ", ".join(to_removed),
590         )
591 
592     @trace_toolkit
593     async def call_tool_function(
594         self,
595         tool_call: ToolUseBlock,
596     ) -> AsyncGenerator[ToolResponse, None]:
597         """Execute the tool function by the `ToolUseBlock` and return the
598         tool response chunk in unified streaming mode, i.e. an async
599         generator of `ToolResponse` objects.
600 
601         .. note:: The tool response chunk is **accumulated**.
602 
603         Args:
604             tool_call (`ToolUseBlock`):
605                 A tool call block.
606 
607         Yields:
608             `ToolResponse`:
609                 The tool response chunk, in accumulative manner.
610         """
611 
612         # Check
613         if tool_call["name"] not in self.tools:
614             return _object_wrapper(
615                 ToolResponse(
616                     content=[
617                         TextBlock(
618                             type="text",
619                             text="FunctionNotFoundError: Cannot find the "
620                             f"function named {tool_call['name']}",
621                         ),
622                     ],
623                 ),
624                 None,
625             )
626 
627         # Prepare function and keyword arguments
628         tool_func = self.tools[tool_call["name"]]
629         kwargs = {
630             **tool_func.preset_kwargs,
631             **(tool_call.get("input", {}) or {}),
632         }
633 
634         # Prepare postprocess function
635         if tool_func.postprocess_func:
636             # Type: partial wraps the postprocess_func with tool_call bound,
637             # reducing it from (ToolUseBlock, ToolResponse) to (ToolResponse)
638             partial_postprocess_func: (
639                 Callable[[ToolResponse], ToolResponse | None]
640                 | Callable[[ToolResponse], Awaitable[ToolResponse | None]]
641             ) | None = partial(
642                 tool_func.postprocess_func,
643                 tool_call,
644             )
645         else:
646             partial_postprocess_func = None
647 
648         # Async function
649         try:
650             if inspect.iscoroutinefunction(tool_func.original_func):
651                 try:
652                     res = await tool_func.original_func(**kwargs)
653                 except asyncio.CancelledError:
654                     res = ToolResponse(
655                         content=[
656                             TextBlock(
657                                 type="text",
658                                 text="<system-info>"
659                                 "The tool call has been interrupted "
660                                 "by the user."
661                                 "</system-info>",
662                             ),
663                         ],
664                         stream=True,
665                         is_last=True,
666                         is_interrupted=True,
667                     )
668 
669             else:
670                 # When `tool_func.original_func` is Async generator function or
671                 # Sync function
672                 res = tool_func.original_func(**kwargs)
673 
674         except Exception as e:
675             res = ToolResponse(
676                 content=[
677                     TextBlock(
678                         type="text",
679                         text=f"Error: {e}",
680                     ),
681                 ],
682             )
683 
684         # Handle different return type
685 
686         # If return an async generator
687         if isinstance(res, AsyncGenerator):
688             return _async_generator_wrapper(res, partial_postprocess_func)
689 
690         # If return a sync generator
691         if isinstance(res, Generator):
692             return _sync_generator_wrapper(res, partial_postprocess_func)
693 
694         if isinstance(res, ToolResponse):
695             return _object_wrapper(res, partial_postprocess_func)
696 
697         raise TypeError(
698             "The tool function must return a ToolResponse object, or an "
699             "AsyncGenerator/Generator of ToolResponse objects, "
700             f"but got {type(res)}.",
701         )
702 
703     async def register_mcp_client(
704         self,
705         mcp_client: MCPClientBase,
706         group_name: str = "basic",
707         enable_funcs: list[str] | None = None,
708         disable_funcs: list[str] | None = None,
709         preset_kwargs_mapping: dict[str, dict[str, Any]] | None = None,
710         postprocess_func: (
711             Callable[
712                 [ToolUseBlock, ToolResponse],
713                 ToolResponse | None,
714             ]
715             | Callable[
716                 [ToolUseBlock, ToolResponse],
717                 Awaitable[ToolResponse | None],
718             ]
719         )
720         | None = None,
721         namesake_strategy: Literal[
722             "override",
723             "skip",
724             "raise",
725             "rename",
726         ] = "raise",
727     ) -> None:
728         """Register tool functions from an MCP client.
729 
730         Args:
731             mcp_client (`MCPClientBase`):
732                 The MCP client instance to connect to the MCP server.
733             group_name (`str`, defaults to `"basic"`):
734                 The group name that the tool functions will be added to.
735             enable_funcs (`list[str] | None`, optional):
736                 The functions to be added into the toolkit. If `None`, all
737                 tool functions within the MCP servers will be added.
738             disable_funcs (`list[str] | None`, optional):
739                 The functions that will be filtered out. If `None`, no
740                 tool functions will be filtered out.
741             preset_kwargs_mapping: (`Optional[dict[str, dict[str, Any]]]`, \
742             defaults to `None`):
743                 The preset keyword arguments mapping, whose keys are the tool
744                 function names and values are the preset keyword arguments.
745             postprocess_func (`(Callable[[ToolUseBlock, ToolResponse], \
746             ToolResponse | None] | Callable[[ToolUseBlock, ToolResponse], \
747             Awaitable[ToolResponse | None]]) | None`, optional):
748                 A post-processing function that will be called after the tool
749                 function is executed, taking the tool call block and tool
750                 response as arguments. The function can be either sync or
751                 async. If it returns `None`, the tool result will be
752                 returned as is. If it returns a `ToolResponse`,
753                 the returned block will be used as the final tool result.
754             namesake_strategy (`Literal['raise', 'override', 'skip', \
755             'rename']`, defaults to `'raise'`):
756                 The strategy to handle the tool function name conflict:
757                 - 'raise': raise a ValueError (default behavior).
758                 - 'override': override the existing tool function with the new
759                   one.
760                 - 'skip': skip the registration of the new tool function.
761                 - 'rename': rename the new tool function by appending a random
762                   suffix to make it unique.
763         """
764         if (
765             isinstance(mcp_client, StatefulClientBase)
766             and not mcp_client.is_connected
767         ):
768             raise RuntimeError(
769                 "The MCP client is not connected to the server. Use the "
770                 "`connect()` method first.",
771             )
772 
773         # Check arguments for enable_funcs and disabled_funcs
774         if enable_funcs is not None and disable_funcs is not None:
775             assert isinstance(enable_funcs, list) and all(
776                 isinstance(_, str) for _ in enable_funcs
777             ), (
778                 "Enable functions should be a list of strings, but got "
779                 f"{enable_funcs}."
780             )
781 
782             assert isinstance(disable_funcs, list) and all(
783                 isinstance(_, str) for _ in disable_funcs
784             ), (
785                 "Disable functions should be a list of strings, but got "
786                 f"{disable_funcs}."
787             )
788             intersection = set(enable_funcs).intersection(
789                 set(disable_funcs),
790             )
791             assert len(intersection) == 0, (
792                 f"The functions in enable_funcs and disable_funcs "
793                 f"should not overlap, but got {intersection}."
794             )
795 
796         if not (
797             preset_kwargs_mapping is None
798             or isinstance(preset_kwargs_mapping, dict)
799         ):
800             raise TypeError(
801                 f"The preset_kwargs_mapping must be a dictionary or None, "
802                 f"but got {type(preset_kwargs_mapping)}.",
803             )
804 
805         tool_names = []
806         for mcp_tool in await mcp_client.list_tools():
807             # Skip the functions that are not in the enable_funcs if
808             # enable_funcs is not None
809             if enable_funcs is not None and mcp_tool.name not in enable_funcs:
810                 continue
811 
812             # Skip the disabled functions
813             if disable_funcs is not None and mcp_tool.name in disable_funcs:
814                 continue
815 
816             tool_names.append(mcp_tool.name)
817 
818             # Obtain callable function object
819             func_obj = await mcp_client.get_callable_function(
820                 func_name=mcp_tool.name,
821                 wrap_tool_result=True,
822             )
823 
824             # Prepare preset kwargs
825             preset_kwargs = None
826             if preset_kwargs_mapping is not None:
827                 preset_kwargs = preset_kwargs_mapping.get(mcp_tool.name, {})
828 
829             self.register_tool_function(
830                 tool_func=func_obj,
831                 group_name=group_name,
832                 preset_kwargs=preset_kwargs,
833                 postprocess_func=postprocess_func,
834                 namesake_strategy=namesake_strategy,
835             )
836 
837         logger.info(
838             "Registered %d tool functions from MCP: %s.",
839             len(tool_names),
840             ", ".join(tool_names),
841         )
842 
843     def state_dict(self) -> dict[str, Any]:
844         """Get the state dictionary of the toolkit.
845 
846         Returns:
847             `dict[str, Any]`:
848                 A dictionary containing the active tool group names.
849         """
850         return {
851             "active_groups": [
852                 name for name, group in self.groups.items() if group.active
853             ],
854         }
855 
856     def load_state_dict(
857         self,
858         state_dict: dict[str, Any],
859         strict: bool = True,
860     ) -> None:
861         """Load the state dictionary into the toolkit.
862 
863         Args:
864             state_dict (`dict`):
865                 The state dictionary to load, which should have "active_groups"
866                 key and its value must be a list of group names.
867             strict (`bool`, defaults to `True`):
868                 If `True`, raises an error if any key in the module is not
869                 found in the state_dict. If `False`, skips missing keys.
870         """
871         if (
872             not isinstance(state_dict, dict)
873             or "active_groups" not in state_dict
874             or not isinstance(state_dict["active_groups"], list)
875         ):
876             raise ValueError(
877                 "The state_dict for toolkit must be a dictionary with "
878                 "active_groups key and its value must be a list, "
879                 f"but got {type(state_dict)}.",
880             )
881 
882         if strict and list(state_dict.keys()) != ["active_groups"]:
883             raise ValueError(
884                 "Get additional keys in the state_dict: "
885                 f'{list(state_dict.keys())}, but only "active_groups" '
886                 "is expected.",
887             )
888 
889         for group_name, group in self.groups.items():
890             if group_name in state_dict["active_groups"]:
891                 group.active = True
892             else:
893                 group.active = False
894 
895     def get_activated_notes(self) -> str:
896         """Get the notes from the active tool groups, which can be used to
897         construct the system prompt for the agent.
898 
899         Returns:
900             `str`:
901                 The combined notes from the active tool groups.
902         """
903         collected_notes = []
904         for group_name, group in self.groups.items():
905             if group.active and group.notes:
906                 collected_notes.append(
907                     "\n".join(
908                         [f"## About {group_name} Tools", group.notes],
909                     ),
910                 )
911         return "\n".join(collected_notes)
912 
913     def reset_equipped_tools(self, **kwargs: Any) -> ToolResponse:
914         """Choose appropriate tools to equip yourself with, so that you can
915         finish your task. Each argument in this function represents a group
916         of related tools, and the value indicates whether to activate the
917         group or not. Besides, the tool response of this function will
918         contain the precaution notes for using them, which you
919         **MUST pay attention to and follow**. You can also reuse this function
920         to check the notes of the tool groups.
921 
922         Note this function will `reset` the tools, so that the original tools
923         will be removed first.
924         """
925 
926         to_activate = []
927         for key, value in kwargs.items():
928             if not isinstance(value, bool):
929                 return ToolResponse(
930                     content=[
931                         TextBlock(
932                             type="text",
933                             text=f"Invalid arguments: the argument {key} "
934                             f"should be a bool value, but got {type(value)}.",
935                         ),
936                     ],
937                 )
938 
939             if value:
940                 to_activate.append(key)
941 
942         self.update_tool_groups(to_activate, active=True)
943 
944         notes = self.get_activated_notes()
945 
946         return ToolResponse(
947             content=[
948                 TextBlock(
949                     type="text",
950                     text=f"Active tool groups successfully: {to_activate}. "
951                     "You MUST follow these notes to use the tools:\n"
952                     f"<notes>{notes}</notes>",
953                 ),
954             ],
955         )
956 
957     def clear(self) -> None:
958         """Clear the toolkit, removing all tool functions and groups."""
959         self.tools.clear()
960         self.groups.clear()
961 
962     def _validate_tool_function(self, func_name: str) -> None:
963         """Check if the tool function already registered in the toolkit. If
964         so, raise a ValueError."""
965         if func_name in self.tools:
966             raise ValueError(
967                 f"A function with name '{func_name}' is already registered "
968                 "in the toolkit.",
969             )
970 
971     def register_agent_skill(
972         self,
973         skill_dir: str,
974     ) -> None:
975         """Register agent skills from a given directory. This function will
976         scan the directory, read metadata from the SKILL.md file, and add
977         it to the skill related prompt. Developers can obtain the
978         skills-related prompt by calling `toolkit.get_agent_skill_prompt()`.
979 
980         .. note:: This directory
981          - Must include a SKILL.md file at the top level
982          - The SKILL.md must have a YAML Front Matter including `name` and
983             `description` fields
984          - All files must specify a common root directory in their paths
985 
986         Args:
987             skill_dir (`str`):
988                 The path to the skill directory.
989         """
990         import frontmatter
991 
992         # Check the skill directory
993         if not os.path.isdir(skill_dir):
994             raise ValueError(
995                 f"The skill directory '{skill_dir}' does not exist or is "
996                 "not a directory.",
997             )
998 
999         # Check SKILL.md file
1000         path_skill_md = os.path.join(skill_dir, "SKILL.md")
1001         if not os.path.isfile(path_skill_md):
1002             raise ValueError(
1003                 f"The skill directory '{skill_dir}' must include a "
1004                 "SKILL.md file at the top level.",
1005             )
1006 
1007         # Check YAML Front Matter
1008         with open(path_skill_md, "r", encoding="utf-8") as f:
1009             post = frontmatter.load(f)
1010 
1011         name = post.get("name", None)
1012         description = post.get("description", None)
1013 
1014         if not name or not description:
1015             raise ValueError(
1016                 f"The SKILL.md file in '{skill_dir}' must have a YAML Front "
1017                 "Matter including `name` and `description` fields.",
1018             )
1019 
1020         name, description = str(name), str(description)
1021         if name in self.skills:
1022             raise ValueError(
1023                 f"An agent skill with name '{name}' is already registered "
1024                 "in the toolkit.",
1025             )
1026 
1027         self.skills[name] = AgentSkill(
1028             name=name,
1029             description=description,
1030             dir=skill_dir,
1031         )
1032 
1033         logger.info(
1034             "Registered agent skill '%s' from directory '%s'.",
1035             name,
1036             skill_dir,
1037         )
1038 
1039     def remove_agent_skill(self, name: str) -> None:
1040         """Remove an agent skill by its name.
1041 
1042         Args:
1043             name (`str`):
1044                 The name of the agent skill to be removed.
1045         """
1046         if name in self.skills:
1047             self.skills.pop(name)
1048         else:
1049             logger.warning(
1050                 "Agent skill '%s' not found in the toolkit, skipping removal.",
1051                 name,
1052             )
1053 
1054     def get_agent_skill_prompt(self) -> str | None:
1055         """Get the prompt for all registered agent skills, which can be
1056         attached to the system prompt for the agent.
1057 
1058         The prompt is consisted of an overall instruction and the detailed
1059         descriptions of each skill, including its name, description, and
1060         directory.
1061 
