55 class Toolkit(StateModule):
56     """Toolkit is the core module to register, manage and delete tool
57     functions, MCP clients, Agent skills in AgentScope.
58 
59     About tool functions:
60 
61     - Register and parse JSON schemas from their docstrings automatically.
62     - Group-wise tools management, and agentic tools activation/deactivation.
63     - Extend the tool function JSON schema dynamically with Pydantic BaseModel.
64     - Tool function execution with unified streaming interface.
65 
66     About MCP clients:
67 
68     - Register tool functions from MCP clients directly.
69     - Client-level tool functions removal.
70 
71     About Agent skills:
72 
73     - Register agent skills from the given directory.
74     - Provide prompt for the registered skills to the agent.
75     """
76 
77     _DEFAULT_AGENT_SKILL_INSTRUCTION = (
78         "# Agent Skills\n"
79         "The agent skills are a collection of folds of instructions, scripts, "
80         "and resources that you can load dynamically to improve performance "
81         "on specialized tasks. Each agent skill has a `SKILL.md` file in its "
82         "folder that describes how to use the skill. If you want to use a "
83         "skill, you MUST read its `SKILL.md` file carefully."
84     )
85 
86     _DEFAULT_AGENT_SKILL_TEMPLATE = """## {name}
87 {description}
88 Check "{dir}/SKILL.md" for how to use this skill"""
89 
90     def __init__(
91         self,
92         agent_skill_instruction: str | None = None,
93         agent_skill_template: str | None = None,
94     ) -> None:
95         """Initialize the toolkit.
96 
97         Args:
98             agent_skill_instruction (`str | None`, optional):
99                 The instruction for agent skills in the system prompt. If not
100                 provided, a default instruction will be used.
101             agent_skill_template (`str | None`, optional):
102                 The template to present one agent skill in the system prompt,
103                 which should contain `{name}`, `{description}`, and `{dir}`
104                 placeholders. If not provided, a default template will be used.
105         """
106         super().__init__()
107 
108         self.tools: dict[str, RegisteredToolFunction] = {}
109         self.groups: dict[str, ToolGroup] = {}
110         self.skills: dict[str, AgentSkill] = {}
111 
112         self._agent_skill_instruction = (
113             agent_skill_instruction or self._DEFAULT_AGENT_SKILL_INSTRUCTION
114         )
115         self._agent_skill_template = (
116             agent_skill_template or self._DEFAULT_AGENT_SKILL_TEMPLATE
117         )
118 
119     def create_tool_group(
120         self,
121         group_name: str,
122         description: str,
123         active: bool = False,
124         notes: str | None = None,
125     ) -> None:
126         """Create a tool group to organize tool functions
127 
128         Args:
129             group_name (`str`):
130                 The name of the tool group.
131             description (`str`):
132                 The description of the tool group.
133             active (`bool`, defaults to `False`):
134                 If the group is active, meaning the tool functions in this
135                 group are included in the JSON schema.
136             notes (`str | None`, optional):
137                 The notes used to remind the agent how to use the tool
138                 functions properly, which can be combined into the system
139                 prompt.
140         """
141         if group_name in self.groups or group_name == "basic":
142             raise ValueError(
143                 f"Tool group '{group_name}' is already registered in the "
144                 "toolkit.",
145             )
146 
147         self.groups[group_name] = ToolGroup(
148             name=group_name,
149             description=description,
150             notes=notes,
151             active=active,
152         )
153 
154     def update_tool_groups(self, group_names: list[str], active: bool) -> None:
155         """Update the activation status of the given tool groups.
156 
157         Args:
158             group_names (`list[str]`):
159                 The list of tool group names to be updated.
160             active (`bool`):
161                 If the tool groups should be activated or deactivated.
162         """
163 
164         for group_name in group_names:
165             if group_name == "basic":
166                 logger.warning(
167                     "The 'basic' tool group is always active, skipping it.",
168                 )
169 
170             if group_name in self.groups:
171                 self.groups[group_name].active = active
172 
173     def remove_tool_groups(self, group_names: str | list[str]) -> None:
174         """Remove tool functions from the toolkit by their group names.
175 
176         Args:
177             group_names (`str | list[str]`):
178                 The group names to be removed from the toolkit.
179         """
180         if isinstance(group_names, str):
181             group_names = [group_names]
182 
183         if not isinstance(group_names, list) or not all(
184             isinstance(_, str) for _ in group_names
185         ):
186             raise TypeError(
187                 f"The group_names must be a list of strings, "
188                 f"but got {type(group_names)}.",
189             )
190 
191         if "basic" in group_names:
192             raise ValueError(
193                 "Cannot remove the default 'basic' tool group.",
194             )
195 
196         for group_name in group_names:
197             self.groups.pop(group_name, None)
198 
199         # Remove the tool functions in the given groups
200         tool_names = deepcopy(list(self.tools.keys()))
201         for tool_name in tool_names:
202             if self.tools[tool_name].group in group_names:
203                 self.tools.pop(tool_name)
204 
205     # pylint: disable=too-many-branches, too-many-statements
206     def register_tool_function(
207         self,
208         tool_func: ToolFunction,
209         group_name: str | Literal["basic"] = "basic",
210         preset_kwargs: dict[str, JSONSerializableObject] | None = None,
211         func_description: str | None = None,
212         json_schema: dict | None = None,
213         include_long_description: bool = True,
214         include_var_positional: bool = False,
215         include_var_keyword: bool = False,
216         postprocess_func: (
217             Callable[
218                 [ToolUseBlock, ToolResponse],
219                 ToolResponse | None,
220             ]
221             | Callable[
222                 [ToolUseBlock, ToolResponse],
223                 Awaitable[ToolResponse | None],
224             ]
225         )
226         | None = None,
227         namesake_strategy: Literal[
228             "override",
229             "skip",
230             "raise",
231             "rename",
232         ] = "raise",
233     ) -> None:
234         """Register a tool function to the toolkit.
235 
236         Args:
237             tool_func (`ToolFunction`):
238                 The tool function, which can be async or sync, streaming or
239                 not-streaming, but the response must be a `ToolResponse`
240                 object.
241             group_name (`str | Literal["basic"]`, defaults to `"basic"`):
242                 The belonging group of the tool function. Tools in "basic"
243                 group is always included in the JSON schema, while the others
244                 are only included when their group is active.
245             preset_kwargs (`dict[str, JSONSerializableObject] | None`, \
246             optional):
247                 Preset arguments by the user, which will not be included in
248                 the JSON schema, nor exposed to the agent.
249             func_description (`str | None`, optional):
250                 The function description. If not provided, the description
251                 will be extracted from the docstring automatically.
252             json_schema (`dict | None`, optional):
253                 Manually provided JSON schema for the tool function, which
254                 should be `{"type": "function", "function": {"name":
255                 "function_name": "xx", "description": "xx",
256                 "parameters": {...}}}`
257             include_long_description (`bool`, defaults to `True`):
258                 When extracting function description from the docstring, if
259                 the long description will be included.
260             include_var_positional (`bool`, defaults to `False`):
261                 Whether to include the variable positional arguments (`*args`)
262                 in the function schema.
263             include_var_keyword (`bool`, defaults to `False`):
264                 Whether to include the variable keyword arguments (`**kwargs`)
265                 in the function schema.
266             postprocess_func (`(Callable[[ToolUseBlock, ToolResponse], \
267             ToolResponse | None] | Callable[[ToolUseBlock, ToolResponse], \
268             Awaitable[ToolResponse | None]]) | None`, optional):
269                 A post-processing function that will be called after the tool
270                 function is executed, taking the tool call block and tool
271                 response as arguments. The function can be either sync or
272                 async. If it returns `None`, the tool result will be
273                 returned as is. If it returns a `ToolResponse`,
274                 the returned block will be used as the final tool result.
275             namesake_strategy (`Literal['raise', 'override', 'skip', \
276             'rename']`, defaults to `'raise'`):
277                 The strategy to handle the tool function name conflict:
278                 - 'raise': raise a ValueError (default behavior).
279                 - 'override': override the existing tool function with the new
280                   one.
281                 - 'skip': skip the registration of the new tool function.
282                 - 'rename': rename the new tool function by appending a random
283                   suffix to make it unique.
284         """
285         # Arguments checking
286         if group_name not in self.groups and group_name != "basic":
287             raise ValueError(
288                 f"Tool group '{group_name}' not found.",
289             )
290 
291         # Check the manually provided JSON schema if provided
292         if json_schema:
293             assert (
294                 isinstance(json_schema, dict)
295                 and "type" in json_schema
296                 and json_schema["type"] == "function"
297                 and "function" in json_schema
298                 and isinstance(json_schema["function"], dict)
299             ), "Invalid JSON schema for the tool function."
300 
301         # Handle MCP tool function and regular function respectively
302         mcp_name = None
303         if isinstance(tool_func, MCPToolFunction):
304             func_name = tool_func.name
305             original_func = tool_func.__call__
306             json_schema = json_schema or tool_func.json_schema
307             mcp_name = tool_func.mcp_name
308 
309         elif isinstance(tool_func, partial):
310             # partial function
311             kwargs = tool_func.keywords
312             # Turn args into keyword arguments
313             if tool_func.args:
314                 param_names = list(
315                     inspect.signature(tool_func.func).parameters.keys(),
316                 )
317                 for i, arg in enumerate(tool_func.args):
318                     if i < len(param_names):
319                         kwargs[param_names[i]] = arg
320 
321             preset_kwargs = {
322                 **kwargs,
323                 **(preset_kwargs or {}),
324             }
325 
326             func_name = tool_func.func.__name__
327             original_func = tool_func.func
328             json_schema = json_schema or _parse_tool_function(
329                 tool_func.func,
330                 include_long_description=include_long_description,
331                 include_var_positional=include_var_positional,
332                 include_var_keyword=include_var_keyword,
333             )
334 
335         else:
336             # normal function
337             func_name = tool_func.__name__
338             original_func = tool_func
339             json_schema = json_schema or _parse_tool_function(
340                 tool_func,
341                 include_long_description=include_long_description,
342                 include_var_positional=include_var_positional,
343                 include_var_keyword=include_var_keyword,
344             )
345 
346         # Override the description if provided
347         if func_description:
348             json_schema["function"]["description"] = func_description
349 
350         # Remove the preset kwargs from the JSON schema
351         for arg_name in preset_kwargs or {}:
352             if arg_name in json_schema["function"]["parameters"]["properties"]:
353                 json_schema["function"]["parameters"]["properties"].pop(
354                     arg_name,
355                 )
356 
357         if "required" in json_schema["function"]["parameters"]:
358             for arg_name in preset_kwargs or {}:
359                 if (
360                     arg_name
361                     in json_schema["function"]["parameters"]["required"]
362                 ):
363                     json_schema["function"]["parameters"]["required"].remove(
364                         arg_name,
365                     )
366 
367             # Remove the required field if it is empty
368             if len(json_schema["function"]["parameters"]["required"]) == 0:
369                 json_schema["function"]["parameters"].pop("required", None)
370 
371         func_obj = RegisteredToolFunction(
372             name=func_name,
373             group=group_name,
374             source="function",
375             original_func=original_func,
376             json_schema=json_schema,
377             preset_kwargs=preset_kwargs or {},
378             extended_model=None,
379             mcp_name=mcp_name,
380             postprocess_func=postprocess_func,
381         )
382 
383         if func_name in self.tools:
384             if namesake_strategy == "raise":
385                 raise ValueError(
386                     f"A function with name '{func_name}' is already "
387                     f"registered in the toolkit.",
388                 )
389 
390             if namesake_strategy == "skip":
391                 logger.warning(
392                     "A function with name '%s' is already "
393                     "registered in the toolkit. Skipping registration.",
394                     func_name,
395                 )
396 
397             elif namesake_strategy == "override":
398                 logger.warning(
399                     "A function with name '%s' is already registered "
400                     "in the toolkit. Overriding with the new function.",
401                     func_name,
402                 )
403                 self.tools[func_name] = func_obj
404 
405             elif namesake_strategy == "rename":
406                 new_func_name = func_name
407                 for _ in range(100):
408                     suffix = shortuuid.uuid()[:5]
409                     new_func_name = f"{func_name}_{suffix}"
410                     if new_func_name not in self.tools:
411                         break
412 
413                 # Raise error if failed to find a unique name
414                 if new_func_name in self.tools:
415                     raise RuntimeError(
416                         f"Failed to register tool function '{func_name}' with "
417                         "a unique name after 100 attempts.",
418                     )
419                 logger.warning(
420                     "A function with name '%s' is already "
421                     "registered in the toolkit. Renaming the new function to "
422                     "'%s'.",
423                     func_name,
424                     new_func_name,
425                 )
426 
427                 # Replace the function name with the new one
428                 func_obj.name = new_func_name
429                 func_obj.json_schema["function"]["name"] = new_func_name
430 
431                 self.tools[new_func_name] = func_obj
432 
433             else:
434                 raise ValueError(
435                     f"Invalid namesake_strategy: {namesake_strategy}. "
436                     "Supported strategies are 'raise', 'override', 'skip', "
437                     "and 'rename'.",
438                 )
439 
440         else:
441             self.tools[func_name] = func_obj
442 
