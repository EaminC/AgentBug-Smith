55 class Toolkit(StateModule):
56     """Toolkit is the core module to register, manage and delete tool
57     functions, MCP clients, Agent skills in AgentScope.
58 
59     About tool functions:
60 
61     - Register and parse JSON schemas from their docstrings automatically.
62     - Group-wise tools management, and agentic tools activation/deactivation.
63     - Extend the tool function JSON schema dynamically with Pydantic BaseModel.
64     - Tool function execution with unified streaming interface.
65 
66     About MCP clients:
67 
68     - Register tool functions from MCP clients directly.
69     - Client-level tool functions removal.
70 
71     About Agent skills:
72 
73     - Register agent skills from the given directory.
74     - Provide prompt for the registered skills to the agent.
75     """
76 
77     _DEFAULT_AGENT_SKILL_INSTRUCTION = (
78         "# Agent Skills\n"
79         "The agent skills are a collection of folds of instructions, scripts, "
80         "and resources that you can load dynamically to improve performance "
