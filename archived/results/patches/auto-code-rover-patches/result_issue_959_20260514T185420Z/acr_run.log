913     def reset_equipped_tools(self, **kwargs: Any) -> ToolResponse:
914         """Choose appropriate tools to equip yourself with, so that you can
915         finish your task. Each argument in this function represents a group
916         of related tools, and the value indicates whether to activate the
917         group or not. Besides, the tool response of this function will
918         contain the precaution notes for using them, which you
919         **MUST pay attention to and follow**. You can also reuse this function
920         to check the notes of the tool groups.
921 
922         Note this function will `reset` the tools, so that the original tools
923         will be removed first.
924         """
925 
926         to_activate = []
927         for key, value in kwargs.items():
928             if not isinstance(value, bool):
929                 return ToolResponse(
930                     content=[
931                         TextBlock(
932                             type="text",
933                             text=f"Invalid arguments: the argument {key} "
934                             f"should be a bool value, but got {type(value)}.",
935                         ),
936                     ],
937                 )
938 
939             if value:
940                 to_activate.append(key)
941 
942         self.update_tool_groups(to_activate, active=True)
943 
944         notes = self.get_activated_notes()
945 
946         return ToolResponse(
947             content=[
948                 TextBlock(
949                     type="text",
950                     text=f"Active tool groups successfully: {to_activate}. "
951                     "You MUST follow these notes to use the tools:\n"
952                     f"<notes>{notes}</notes>",
953                 ),
954             ],
955         )
956 
957     def clear(self) -> None:
958         """Clear the toolkit, removing all tool functions and groups."""
959         self.tools.clear()
960         self.groups.clear()
