707     # ------------------------------------------------------------------
708     # Runtime control
709     # ------------------------------------------------------------------
710     def start(
711         self,
712         runtime: Optional[wf.WorkflowRuntime] = None,
713         *,
714         auto_register: bool = True,
715     ) -> None:
716         """
717         Start the workflow runtime and register this agent's components.
718 
719         Behavior:
720         • If a runtime is provided, attach to it (we still consider it not owned).
721         • Register workflows once (if not already).
722         • Always attempt to start the runtime; treat start() as idempotent:
723             - If it's already running, swallow/log the exception and continue.
724         • We only call shutdown() later if we own the runtime.
725         """
726         if self._started:
727             raise RuntimeError("Agent has already been started.")
728 
729         if runtime is not None:
730             self._runtime = runtime
731             self._runtime_owned = False
732             self._registered = False
733             logger.info(
734                 "Attached injected WorkflowRuntime (owned=%s).", self._runtime_owned
735             )
736 
737         if auto_register and not self._registered:
738             self.register_workflows(self._runtime)
739             self._registered = True
740             logger.info(
741                 "Registered workflows/activities on WorkflowRuntime for agent '%s'.",
742                 self.name,
743             )
744 
745         # Always try to start; treat as idempotent.
746         try:
747             self._runtime.start()
748             logger.info(
749                 "WorkflowRuntime started for agent '%s' (owned=%s).",
750                 self.name,
751                 self._runtime_owned,
752             )
753         except Exception as exc:  # noqa: BLE001
754             # Most common benign case: runtime already running
755             logger.warning(
756                 "WorkflowRuntime.start() raised for agent '%s' (likely already running): %s",
757                 self.name,
758                 exc,
759                 exc_info=True,
760             )
761 
762         self._started = True
763 
764     def stop(self) -> None:
765         """Stop the workflow runtime if it is owned by this instance."""
766         if not self._started:
767             return
768 
769         if self._runtime_owned:
770             try:
771                 self._runtime.shutdown()
772             except Exception:  # noqa: BLE001
773                 logger.debug(
774                     "Error while shutting down workflow runtime", exc_info=True
775                 )
776 
777         self._started = False
778 
779     def register(self, runtime: wf.WorkflowRuntime) -> None:
780         """
781         Register workflows and activities on a provided runtime.
782 
783         Args:
784             runtime: An externally-managed workflow runtime to register with.
785         """
786         self._runtime = runtime
787         self._runtime_owned = False
788         self.register_workflows(runtime)
789         self._registered = True
790 
791     def register_workflows(self, runtime: wf.WorkflowRuntime) -> None:
792         """
793         Register workflows/activities for this agent.
794 
795         Args:
796             runtime: The Dapr workflow runtime to register with.
797         """
798         runtime.register_workflow(self.agent_workflow)
799         runtime.register_workflow(self.broadcast_listener)
800         runtime.register_activity(self.record_initial_entry)
801         runtime.register_activity(self.call_llm)
802         runtime.register_activity(self.run_tool)
803         runtime.register_activity(self.broadcast_message_to_agents)
804         runtime.register_activity(self.send_response_back)
805         runtime.register_activity(self.finalize_workflow)

