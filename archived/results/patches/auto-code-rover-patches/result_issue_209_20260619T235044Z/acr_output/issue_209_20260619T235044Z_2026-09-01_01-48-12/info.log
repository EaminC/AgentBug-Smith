43 class DurableAgent(AgentBase):
44     """
45     Workflow-native durable agent runtime on top of AgentBase.
46 
47     Overview:
48         Wires your AgentBase behavior into Dapr Workflows for durable, pub/sub-driven runs.
49         Persists state using the built-in AgentWorkflowState schema while still honoring
50         safe hook overrides (entry_factory, message_coercer, etc.).
51 
52     """
53 
54     def __init__(
55         self,
56         *,
57         # Profile / prompt
58         profile: Optional[AgentProfileConfig] = None,
59         name: Optional[str] = None,
60         role: Optional[str] = None,
61         goal: Optional[str] = None,
62         instructions: Optional[Iterable[str]] = None,
63         style_guidelines: Optional[Iterable[str]] = None,
64         system_prompt: Optional[str] = None,
65         prompt_template: Optional[PromptTemplateBase] = None,
66         # Infrastructure
67         pubsub: Optional[AgentPubSubConfig] = None,
68         state: Optional[AgentStateConfig] = None,
69         registry: Optional[AgentRegistryConfig] = None,
70         # Memory / runtime
71         memory: Optional[AgentMemoryConfig] = None,
72         llm: Optional[ChatClientBase] = None,
73         tools: Optional[Iterable[Any]] = None,
74         # Behavior / execution
75         execution: Optional[AgentExecutionConfig] = None,
76         # Misc
77         agent_metadata: Optional[Dict[str, Any]] = None,
78         workflow_grpc: Optional[WorkflowGrpcOptions] = None,
79         runtime: Optional[wf.WorkflowRuntime] = None,
80     ) -> None:
81         """
82         Initialize behavior, infrastructure, and workflow runtime.
83 
84         Args:
85             profile: High-level profile (can be overridden by explicit fields).
86             name: Agent name (required if not in `profile`).
87             role: Agent role/persona label.
88             goal: High-level objective for prompting context.
89             instructions: Extra instruction lines for the system prompt.
90             style_guidelines: Style directives for the system prompt.
91             system_prompt: System prompt override.
92             prompt_template: Optional explicit prompt template instance.
93 
94             pubsub: Optional Dapr Pub/Sub configuration for triggers/broadcasts.
95                 If omitted, the agent won't subscribe to any topics and can only be
96                 triggered directly via AgentRunner.
97             state: Durable state configuration (store/key + optional hooks).
98             registry: Team registry configuration.
99             execution: Execution dials for the agent run.
100 
101             memory: Conversation memory config; defaults to in-memory, or Dapr state-backed if available.
102             llm: Chat client; defaults to `get_default_llm()`.
103             tools: Optional tool callables or `AgentTool` instances.
104 
105             agent_metadata: Extra metadata to publish to the registry.
106             workflow_grpc: Optional gRPC overrides for the workflow runtime channel.
107             runtime: Optional pre-existing workflow runtime to attach to.
108         """
109         super().__init__(
110             pubsub=pubsub,
111             profile=profile,
112             name=name,
113             role=role,
114             goal=goal,
115             instructions=instructions,
116             style_guidelines=style_guidelines,
117             system_prompt=system_prompt,
118             state=state,
119             memory=memory,
120             registry=registry,
121             execution=execution,
122             agent_metadata=agent_metadata,
123             workflow_grpc=workflow_grpc,
124             llm=llm,
125             tools=tools,
126             prompt_template=prompt_template,
127         )
128 
129         apply_grpc_options(self.workflow_grpc_options)
130 
131         self._runtime: wf.WorkflowRuntime = runtime or wf.WorkflowRuntime()
132         self._runtime_owned = runtime is None
133         self._registered = False
134         self._started = False
135 
136     # ------------------------------------------------------------------
137     # Runtime accessors
138     # ------------------------------------------------------------------
139     @property
140     def runtime(self) -> wf.WorkflowRuntime:
141         """Return the underlying workflow runtime."""
142         return self._runtime
143 
144     @property
145     def is_started(self) -> bool:
146         """Return True when the workflow runtime has been started."""
147         return self._started
148 
149     # ------------------------------------------------------------------
150     # Workflows / Activities
151     # ------------------------------------------------------------------
152     @workflow_entry
153     @message_router(message_model=TriggerAction)
154     def agent_workflow(self, ctx: wf.DaprWorkflowContext, message: dict):
155         """
156         Primary workflow loop reacting to `TriggerAction` pub/sub messages.
157 
158         Args:
159             ctx: Dapr workflow context injected by the runtime.
160             message: Trigger payload; may include task string and metadata.
161 
162         Returns:
163             Final assistant message as a dict.
164 
165         Raises:
166             AgentError: If the loop finishes without producing a final response.
167         """
168         task = message.get("task")
169         metadata = message.get("_message_metadata", {}) or {}
170 
171         # Propagate OTel/parent workflow relations if present.
172         otel_span_context = message.get("_otel_span_context")
173         if "workflow_instance_id" in message:
174             metadata["triggering_workflow_instance_id"] = message[
175                 "workflow_instance_id"
176             ]
177 
178         trigger_instance_id = metadata.get("triggering_workflow_instance_id")
179         source = metadata.get("source") or "direct"
180 
181         # Ensure we have the latest durable state for this turn.
182         if self.state_store:
183             self.load_state()
184 
185         # Bootstrap instance entry (flexible to non-`instances` models).
186         self.ensure_instance_exists(
187             instance_id=ctx.instance_id,
188             input_value=task or "Triggered without input.",
189             triggering_workflow_instance_id=trigger_instance_id,
190             time=ctx.current_utc_datetime,
191         )
192 
193         if not ctx.is_replaying:
194             logger.info("Initial message from %s -> %s", source, self.name)
195 
196         # Record initial entry via activity to keep deterministic/replay-friendly I/O.
197         yield ctx.call_activity(
198             self.record_initial_entry,
199             input={
200                 "instance_id": ctx.instance_id,
201                 "input_value": task or "Triggered without input.",
202                 "source": source,
203                 "triggering_workflow_instance_id": trigger_instance_id,
204                 "start_time": ctx.current_utc_datetime.isoformat(),
205                 "trace_context": otel_span_context,
206             },
207         )
208 
209         final_message: Dict[str, Any] = {}
210         turn = 0
211 
212         try:
213             for turn in range(1, self.execution.max_iterations + 1):
214                 if not ctx.is_replaying:
215                     logger.debug(
216                         "Agent %s turn %d/%d (instance=%s)",
217                         self.name,
218                         turn,
219                         self.execution.max_iterations,
220                         ctx.instance_id,
221                     )
222 
223                 assistant_response: Dict[str, Any] = yield ctx.call_activity(
224                     self.call_llm,
225                     input={
226                         "task": task,
227                         "instance_id": ctx.instance_id,
228                         "time": ctx.current_utc_datetime.isoformat(),
229                     },
230                 )
231 
232                 tool_calls = assistant_response.get("tool_calls") or []
233                 if tool_calls:
234                     if not ctx.is_replaying:
235                         logger.debug(
236                             "Agent %s executing %d tool call(s) on turn %d",
237                             self.name,
238                             len(tool_calls),
239                             turn,
240                         )
241                     parallel = [
242                         ctx.call_activity(
243                             self.run_tool,
244                             input={
245                                 "tool_call": tc,
246                                 "instance_id": ctx.instance_id,
247                                 "time": ctx.current_utc_datetime.isoformat(),
248                                 "order": idx,
249                             },
250                         )
251                         for idx, tc in enumerate(tool_calls)
252                     ]
253                     yield wf.when_all(parallel)
254                     task = None  # prepare for next turn
255                     continue
256 
257                 final_message = assistant_response
258                 if not ctx.is_replaying:
259                     logger.debug(
260                         "Agent %s produced final response on turn %d (instance=%s)",
261                         self.name,
262                         turn,
263                         ctx.instance_id,
264                     )
265                 break
266             else:
267                 # Loop exhausted without a terminating reply → surface a friendly notice.
268                 base = final_message.get("content") or ""
269                 if base:
270                     base = base.rstrip() + "\n\n"
271                 base += (
272                     "I reached the maximum number of reasoning steps before I could finish. "
273                     "Please rephrase or provide more detail so I can try again."
274                 )
275                 final_message = {"role": "assistant", "content": base}
276                 if not ctx.is_replaying:
277                     logger.warning(
278                         "Agent %s hit max iterations (%d) without a final response (instance=%s)",
279                         self.name,
280                         self.execution.max_iterations,
281                         ctx.instance_id,
282                     )
283 
284         except Exception as exc:  # noqa: BLE001
285             logger.exception("Agent %s workflow failed: %s", self.name, exc)
286             final_message = {"role": "assistant", "content": f"Error: {str(exc)}"}
287 
288         # Optionally broadcast the final message to the team.
289         if self.broadcast_topic_name:
290             yield ctx.call_activity(
291                 self.broadcast_message_to_agents,
292                 input={"message": final_message},
293             )
294 
295         # Optionally send a direct response back to the trigger origin.
296         if source and trigger_instance_id:
297             yield ctx.call_activity(
298                 self.send_response_back,
299                 input={
300                     "response": final_message,
301                     "target_agent": source,
302                     "target_instance_id": trigger_instance_id,
303                 },
304             )
305 
306         # Finalize the workflow entry in durable state.
307         yield ctx.call_activity(
308             self.finalize_workflow,
309             input={
310                 "instance_id": ctx.instance_id,
311                 "final_output": final_message.get("content", ""),
312                 "end_time": ctx.current_utc_datetime.isoformat(),
313                 "triggering_workflow_instance_id": trigger_instance_id,
314             },
315         )
316 
317         if not ctx.is_replaying:
318             verdict = (
319                 "max_iterations_reached"
320                 if turn == self.execution.max_iterations
321                 else "completed"
322             )
323             logger.info(
324                 "Workflow %s finalized for agent %s with verdict=%s",
325                 ctx.instance_id,
326                 self.name,
327                 verdict,
328             )
329 
330         return final_message
331 
332     @message_router(message_model=BroadcastMessage, broadcast=True)
333     def broadcast_listener(self, ctx: wf.DaprWorkflowContext, message: dict) -> None:
334         """
335         Handle broadcast messages sent by other agents and store them in memory.
336 
337         Args:
338             ctx: Dapr workflow context (unused).
339             message: Broadcast payload containing content and metadata.
340         """
341         metadata = message.get("_message_metadata", {}) or {}
342         source = metadata.get("source") or "unknown"
343         message_content = message.get("content", "")
344         if source == self.name:
345             logger.debug("Agent %s ignoring self-originated broadcast.", self.name)
346             return
347 
348         logger.info("Agent %s received broadcast from %s", self.name, source)
349         logger.debug("Full broadcast message: %s", message)
350         # Store as a user message from the broadcasting agent (kept in persistent memory).
351         self.memory.add_message(
352             UserMessage(name=source, content=message_content, role="user")
353         )
354 
355     # ------------------------------------------------------------------
356     # Activities
357     # ------------------------------------------------------------------
358     def record_initial_entry(
359         self, ctx: wf.WorkflowActivityContext, payload: Dict[str, Any]
360     ) -> None:
361         """
362         Record the initial entry for a workflow instance.
363 
364         Args:
365             payload: Keys:
366                 - instance_id: Workflow instance id.
367                 - input_value: Initial input value.
368                 - source: Trigger source string.
369                 - triggering_workflow_instance_id: Optional parent workflow id.
370                 - start_time: ISO8601 datetime string.
371                 - trace_context: Optional tracing context.
372         """
373         # Load latest state to ensure we have current data before modifying
374         if self.state_store:
375             self.load_state()
376 
377         instance_id = payload.get("instance_id")
378         trace_context = payload.get("trace_context")
379         input_value = payload.get("input_value", "Triggered without input.")
380         source = payload.get("source", "direct")
381         triggering_instance = payload.get("triggering_workflow_instance_id")
382         start_time = self._coerce_datetime(payload.get("start_time"))
383 
384         # Ensure instance exists in durable state
385         self.ensure_instance_exists(
386             instance_id=instance_id,
387             input_value=input_value,
388             triggering_workflow_instance_id=triggering_instance,
389             time=start_time,
390         )
391 
392         # Use flexible container accessor (supports custom state layouts)
393         container = self._get_entry_container()
394         entry = container.get(instance_id) if container else None
395         if entry is None:
396             return
397 
398         entry.input_value = input_value
399         entry.source = source
400         entry.triggering_workflow_instance_id = triggering_instance
401         entry.start_time = start_time
402         entry.trace_context = trace_context
403 
404         session_id = getattr(self.memory, "session_id", None)
405         if session_id is not None and hasattr(entry, "session_id"):
406             entry.session_id = str(session_id)
407 
408         entry.status = DaprWorkflowStatus.RUNNING.value
409         self.save_state()
410 
411     def call_llm(
412         self, ctx: wf.WorkflowActivityContext, payload: Dict[str, Any]
413     ) -> Dict[str, Any]:
414         """
415         Ask the LLM to generate the next assistant message.
416 
417         Args:
418             payload: Must contain 'instance_id'; may include 'task' and 'time'.
419 
420         Returns:
421             Assistant message as a dict.
422 
423         Raises:
424             AgentError: If the LLM call fails or yields no message.
425         """
426         # Load latest state to ensure we have current data
427         if self.state_store:
428             self.load_state()
429 
430         instance_id = payload.get("instance_id")
431         task = payload.get("task")
432 
433         chat_history = self._reconstruct_conversation_history(instance_id)
434         messages = self.prompting_helper.build_initial_messages(
435             user_input=task,
436             chat_history=chat_history,
437         )
438 
439         # Sync current system messages into per-instance state
440         self._sync_system_messages_with_state(instance_id, messages)
441 
442         # Persist the user's turn (if any) into the instance timeline + memory
443         # Only process and print user message if task is provided (initial turn)
444         if task:
445             user_message = self._get_last_user_message(messages)
446             user_copy = dict(user_message) if user_message else None
447             self._process_user_message(instance_id, task, user_copy)
448 
449             if user_copy is not None:
450                 self.text_formatter.print_message(
451                     {str(k): v for k, v in user_copy.items()}
452                 )
453 
454         tools = self.get_llm_tools()
455         generate_kwargs = {
456             "messages": messages,
457             "tools": tools,
458         }
459         if tools and self.execution.tool_choice is not None:
460             generate_kwargs["tool_choice"] = self.execution.tool_choice
461 
462         try:
463             response: LLMChatResponse = self.llm.generate(**generate_kwargs)
464         except Exception as exc:  # noqa: BLE001
465             logger.exception("LLM generate failed: %s", exc)
466             raise AgentError(str(exc)) from exc
467 
468         assistant_message = response.get_message()
469         if assistant_message is None:
470             raise AgentError("LLM returned no assistant message.")
471 
472         as_dict = assistant_message.model_dump()
473         self._save_assistant_message(instance_id, as_dict)
474         self.text_formatter.print_message(as_dict)
475         self.save_state()
476         return as_dict
477 
478     def run_tool(
479         self, ctx: wf.WorkflowActivityContext, payload: Dict[str, Any]
480     ) -> Dict[str, Any]:
481         """
482         Execute a single tool call and persist results to state/memory.
483 
484         Args:
485             payload: Keys 'tool_call', 'instance_id', 'time', 'order'.
486 
487         Returns:
488             Tool execution record as a dict.
489 
490         Raises:
491             AgentError: If tool arguments contain invalid JSON.
492         """
493         # Load latest state to ensure we have current data before modifying
494         if self.state_store:
495             self.load_state()
496 
497         tool_call = payload.get("tool_call", {})
498         instance_id = payload.get("instance_id")
499         fn_name = tool_call["function"]["name"]
500         raw_args = tool_call["function"].get("arguments", "")
501 
502         try:
503             args = json.loads(raw_args) if raw_args else {}
504         except json.JSONDecodeError as exc:
505             raise AgentError(f"Invalid JSON in tool args: {exc}") from exc
506 
507         async def _execute_tool() -> Any:
508             return await self.tool_executor.run_tool(fn_name, **args)
509 
510         result = self._run_asyncio_task(_execute_tool())
511 
512         # Debug: Log the actual result before serialization
513         logger.debug(f"Tool {fn_name} returned: {result} (type: {type(result)})")
514 
515         # Serialize the tool result using centralized utility
516         serialized_result = serialize_tool_result(result)
517 
518         tool_result = {
519             "tool_call_id": tool_call["id"],
520             "tool_name": fn_name,
521             "tool_args": args,
522             "execution_result": serialized_result,
523         }
524         history_entry = ToolExecutionRecord(**tool_result)
525 
526         # Build the tool message for both memory and (optionally) per-instance timeline
527         tool_message = ToolMessage(
528             tool_call_id=tool_result["tool_call_id"],
529             name=tool_result["tool_name"],
530             content=tool_result["execution_result"],
531             role="tool",
532         )
533         agent_message = {
534             "tool_call_id": tool_message.tool_call_id,
535             "role": "tool",
536             "name": tool_message.name,
537             "content": tool_message.content,
538         }
539 
540         # Append to durable state if the entry/timeline exists (with de-dupe)
541         container = self._get_entry_container()
542         entry = container.get(instance_id) if container else None
543         if entry is not None and hasattr(entry, "messages"):
544             # Skip if this tool_call_id already recorded
545             try:
546                 existing_ids = {
547                     getattr(m, "id", None) or getattr(m, "tool_call_id", None)
548                     for m in getattr(entry, "messages")
549                 }
550             except Exception:
551                 existing_ids = set()
552             if agent_message["tool_call_id"] not in existing_ids:
553                 tool_message_model = (
554                     self._message_coercer(agent_message)
555                     if getattr(self, "_message_coercer", None)
556                     else self._message_dict_to_message_model(agent_message)
557                 )
558                 entry.messages.append(tool_message_model)
559                 if hasattr(entry, "tool_history"):
560                     entry.tool_history.append(history_entry)
561                 if hasattr(entry, "last_message"):
562                     entry.last_message = tool_message_model
563 
564         tool_call_id = agent_message["tool_call_id"]
565         # Check if tool message already exists in memory
566         existing_memory_messages = self.memory.get_messages()
567         tool_exists_in_memory = False
568         for mem_msg in existing_memory_messages:
569             msg_dict = (
570                 mem_msg.model_dump()
571                 if hasattr(mem_msg, "model_dump")
572                 else (mem_msg if isinstance(mem_msg, dict) else {})
573             )
574             if (
575                 msg_dict.get("role") == "tool"
576                 and msg_dict.get("tool_call_id") == tool_call_id
577             ):
578                 tool_exists_in_memory = True
579                 break
580 
581         # Only add to persistent memory if not already present
582         if not tool_exists_in_memory:
583             self.memory.add_message(tool_message)
584 
585         self.tool_history.append(history_entry)
586 
587         # Print the tool result for visibility
588         self.text_formatter.print_message(agent_message)
589 
590         self.save_state()
591         return tool_result
592 
593     def broadcast_message_to_agents(
594         self, ctx: wf.WorkflowActivityContext, payload: Dict[str, Any]
595     ) -> None:
596         """
597         Broadcast a message to all agents via pub/sub (if a broadcast topic is set).
598 
599         Args:
600             payload: Dict containing 'message' (assistant/user-like dict).
601         """
602         message = payload.get("message", {})
603         if not isinstance(message, dict) or not self.broadcast_topic_name:
604             logger.debug(
605                 "Skipping broadcast because payload is invalid or topic is unset."
606             )
607             return
608 
609         try:
610             agents_metadata = self.get_agents_metadata(
611                 exclude_self=False, exclude_orchestrator=False
612             )
613         except Exception:  # noqa: BLE001
614             logger.exception("Unable to load agents metadata; broadcast aborted.")
615             return
616 
617         message["role"] = "user"
618         message["name"] = self.name
619         response_message = BroadcastMessage(**message)
620 
621         async def _broadcast() -> None:
622             await broadcast_message(
623                 message=response_message,
624                 broadcast_topic=self.broadcast_topic_name,
625                 message_bus=self.message_bus_name,
626                 source=self.name,
627                 agents_metadata=agents_metadata,
628             )
629 
630         try:
631             self._run_asyncio_task(_broadcast())
632         except Exception:  # noqa: BLE001
633             logger.exception("Failed to publish broadcast message.")
634 
635     def send_response_back(
636         self, ctx: wf.WorkflowActivityContext, payload: Dict[str, Any]
637     ) -> None:
638         """
639         Send the final response back to the triggering agent.
640 
641         Args:
642             payload: Dict containing 'response', 'target_agent', 'target_instance_id'.
643         """
644         response = payload.get("response", {})
645         target_agent = payload.get("target_agent", "")
646         target_instance_id = payload.get("target_instance_id", "")
647         if not target_agent or not target_instance_id:
648             logger.debug(
649                 "Target agent or instance missing; skipping response publication."
650             )
651             return
652 
653         response["role"] = "user"
654         response["name"] = self.name
655         response["workflow_instance_id"] = target_instance_id
656         agent_response = AgentTaskResponse(**response)
657 
658         agents_metadata = self.get_agents_metadata()
659 
660         try:
661             self._run_asyncio_task(
662                 send_message_to_agent(
663                     source=self.name,
664                     target_agent=target_agent,
665                     message=agent_response,
666                     agents_metadata=agents_metadata,
667                 )
668             )
669         except Exception:  # noqa: BLE001
670             logger.exception("Failed to publish response to %s", target_agent)
671 
672     def finalize_workflow(
673         self, ctx: wf.WorkflowActivityContext, payload: Dict[str, Any]
674     ) -> None:
675         """
676         Finalize a workflow instance by setting status, output, and end time.
677 
678         Args:
679             payload: Dict with 'instance_id', 'final_output', 'end_time',
680                      and optional 'triggering_workflow_instance_id'.
681         """
682         # Load latest state to ensure we have current data before modifying
683         if self.state_store:
684             self.load_state()
685 
686         instance_id = payload.get("instance_id")
687         final_output = payload.get("final_output", "")
688         end_time = payload.get("end_time", "")
689         triggering_workflow_instance_id = payload.get("triggering_workflow_instance_id")
690 
691         container = self._get_entry_container()
692         entry = container.get(instance_id) if container else None
693         if not entry:
694             return
695 
696         entry.status = (
697             DaprWorkflowStatus.COMPLETED.value
698             if final_output
699             else DaprWorkflowStatus.FAILED.value
700         )
701         entry.end_time = self._coerce_datetime(end_time)
702         if hasattr(entry, "output"):
703             entry.output = final_output or ""
704         entry.triggering_workflow_instance_id = triggering_workflow_instance_id
705         self.save_state()
706 
707     # ------------------------------------------------------------------
708     # Runtime control
709     # ------------------------------------------------------------------
710     def start(
711         self,
712         runtime: Optional[wf.WorkflowRuntime] = None,
713         *,
714         auto_register: bool = True,
715     ) -> None:
716         """
717         Start the workflow runtime and register this agent's components.
718 
719         Behavior:
720         • If a runtime is provided, attach to it (we still consider it not owned).
721         • Register workflows once (if not already).
722         • Always attempt to start the runtime; treat start() as idempotent:
723             - If it's already running, swallow/log the exception and continue.
724         • We only call shutdown() later if we own the runtime.
725         """
726         if self._started:
727             raise RuntimeError("Agent has already been started.")
728 
729         if runtime is not None:
730             self._runtime = runtime
731             self._runtime_owned = False
732             self._registered = False
733             logger.info(
734                 "Attached injected WorkflowRuntime (owned=%s).", self._runtime_owned
735             )
736 
737         if auto_register and not self._registered:
738             self.register_workflows(self._runtime)
739             self._registered = True
740             logger.info(
741                 "Registered workflows/activities on WorkflowRuntime for agent '%s'.",
742                 self.name,
743             )
744 
745         # Always try to start; treat as idempotent.
746         try:
747             self._runtime.start()
748             logger.info(
749                 "WorkflowRuntime started for agent '%s' (owned=%s).",
750                 self.name,
751                 self._runtime_owned,
752             )
753         except Exception as exc:  # noqa: BLE001
754             # Most common benign case: runtime already running
755             logger.warning(
756                 "WorkflowRuntime.start() raised for agent '%s' (likely already running): %s",
757                 self.name,
758                 exc,
759                 exc_info=True,
760             )
761 
762         self._started = True
763 
764     def stop(self) -> None:
765         """Stop the workflow runtime if it is owned by this instance."""
766         if not self._started:
767             return
768 
769         if self._runtime_owned:
770             try:
771                 self._runtime.shutdown()
772             except Exception:  # noqa: BLE001
773                 logger.debug(
774                     "Error while shutting down workflow runtime", exc_info=True
775                 )
776 
777         self._started = False
778 
779     def register(self, runtime: wf.WorkflowRuntime) -> None:
780         """
781         Register workflows and activities on a provided runtime.
782 
783         Args:
784             runtime: An externally-managed workflow runtime to register with.
785         """
786         self._runtime = runtime
787         self._runtime_owned = False
788         self.register_workflows(runtime)
789         self._registered = True
790 
791     def register_workflows(self, runtime: wf.WorkflowRuntime) -> None:
792         """
793         Register workflows/activities for this agent.
794 
795         Args:
796             runtime: The Dapr workflow runtime to register with.
797         """
798         runtime.register_workflow(self.agent_workflow)
799         runtime.register_workflow(self.broadcast_listener)
800         runtime.register_activity(self.record_initial_entry)
801         runtime.register_activity(self.call_llm)
802         runtime.register_activity(self.run_tool)
803         runtime.register_activity(self.broadcast_message_to_agents)
804         runtime.register_activity(self.send_response_back)
805         runtime.register_activity(self.finalize_workflow)

