302   def handle_command(self, user_input):
303     # split the command into the command and the arguments, by the first whitespace
304     switch = {
305       "help": self.handle_help,
306       "debug": self.handle_debug,
307       "reset": self.handle_reset,
308       "save_message": self.handle_save_message,
309       "load_message": self.handle_load_message,
310       "undo": self.handle_undo,
311     }
312 
313     user_input = user_input[1:].strip()  # Capture the part after the `%`
314     command = user_input.split(" ")[0]
315     arguments = user_input[len(command):].strip()
316     action = switch.get(command,
317                         self.default_handle)  # Get the function from the dictionary, or default_handle if not found
318     action(arguments)  # Execute the function
319 
320   def chat(self, message=None, return_messages=False):
321 
322     # Connect to an LLM (an large language model)
323     if not self.local:
324       # gpt-4
325       self.verify_api_key()
326 
327     # ^ verify_api_key may set self.local to True, so we run this as an 'if', not 'elif':
328     if self.local:
329 
330       # Code-Llama
331       if self.llama_instance == None:
332 
333         # Find or install Code-Llama
334         try:
335           self.llama_instance = get_hf_llm(self.model, self.debug_mode, self.context_window)
336           if self.llama_instance == None:
337             # They cancelled.
338             return
339         except:
340           traceback.print_exc()
341           # If it didn't work, apologize and switch to GPT-4
342 
343           print(Markdown("".join([
344             f"> Failed to install `{self.model}`.",
345             f"\n\n**Common Fixes:** You can follow our simple setup docs at the link below to resolve common errors.\n\n```\nhttps://github.com/KillianLucas/open-interpreter/tree/main/docs\n```",
346             f"\n\n**If you've tried that and you're still getting an error, we have likely not built the proper `{self.model}` support for your system.**",
347             "\n\n*( Running language models locally is a difficult task!* If you have insight into the best way to implement this across platforms/architectures, please join the Open Interpreter community Discord and consider contributing the project's development. )",
348             "\n\nPress enter to switch to `GPT-4` (recommended)."
349           ])))
350           input()
351 
352           # Switch to GPT-4
353           self.local = False
354           self.model = "gpt-4"
355           self.verify_api_key()
356 
357     # Display welcome message
358     welcome_message = ""
359 
360     if self.debug_mode:
361       welcome_message += "> Entered debug mode"
362 
363       
364 
365     # If self.local, we actually don't use self.model
366     # (self.auto_run is like advanced usage, we display no messages)
367     if not self.local and not self.auto_run:
368 
369       if self.use_azure:
370         notice_model = f"{self.azure_deployment_name} (Azure)"
371       else:
372         notice_model = f"{self.model.upper()}"
373       welcome_message += f"\n> Model set to `{notice_model}`\n\n**Tip:** To run locally, use `interpreter --local`"
374       
375     if self.local:
376       welcome_message += f"\n> Model set to `{self.model}`"
377 
378     # If not auto_run, tell the user we'll ask permission to run code
379     # We also tell them here how to exit Open Interpreter
380     if not self.auto_run:
381       welcome_message += "\n\n" + confirm_mode_message
382 
383     welcome_message = welcome_message.strip()
384 
385     # Print welcome message with newlines on either side (aesthetic choice)
386     # unless we're starting with a blockquote (aesthetic choice)
387     if welcome_message != "":
388       if welcome_message.startswith(">"):
389         print(Markdown(welcome_message), '')
390       else:
391         print('', Markdown(welcome_message), '')
392 
393     # Check if `message` was passed in by user
394     if message:
395       print(f"user message: {message}")
396       # If it was, we respond non-interactivley
397       self.messages.append({"role": "user", "content": message})
398       self.respond()
399 
400     else:
401       # If it wasn't, we start an interactive chat
402       while True:
403         try:
404           user_input = input("> ").strip()
405         except EOFError:
406           break
407         except KeyboardInterrupt:
408           print()  # Aesthetic choice
409           break
410 
411         # Use `readline` to let users up-arrow to previous user messages,
412         # which is a common behavior in terminals.
413         try:
414           readline.add_history(user_input)
415         except:
416           # Sometimes this doesn't work (https://stackoverflow.com/questions/10313765/simple-swig-python-example-in-vs2008-import-error-internal-pyreadline-erro)
417           pass
418 
419         # If the user input starts with a `%`
420         if user_input.startswith("%"):
421           self.handle_command(user_input)
422           continue
423 
424         # Add the user message to self.messages
425         self.messages.append({"role": "user", "content": user_input})
426 
427         # Respond, but gracefully handle CTRL-C / KeyboardInterrupt
428         try:
429           self.respond()
430         except KeyboardInterrupt:
431           pass
432         finally:
433           # Always end the active block. Multiple Live displays = issues
434           self.end_active_block()
435 
436     if return_messages:
437         return self.messages
438 
