201   def handle_undo(self, arguments):
202     # Removes all messages after the most recent user entry (and the entry itself).
203     # Therefore user can jump back to the latest point of conversation.
204     # Also gives a visual representation of the messages removed.
205 
206     if len(self.messages) == 0:
207       return
208     # Find the index of the last 'role': 'user' entry
209     last_user_index = None
210     for i, message in enumerate(self.messages):
211         if message.get('role') == 'user':
212             last_user_index = i
213 
214     removed_messages = []
215 
216     # Remove all messages after the last 'role': 'user'
217     if last_user_index is not None:
218         removed_messages = self.messages[last_user_index:]
219         self.messages = self.messages[:last_user_index]
220 
221     print("") # Aesthetics.
222 
223     # Print out a preview of what messages were removed.
224     for message in removed_messages:
225       if 'content' in message and message['content'] != None:
226         print(Markdown(f"**Removed message:** `\"{message['content'][:30]}...\"`"))
227       elif 'function_call' in message:
228         print(Markdown(f"**Removed codeblock**")) # TODO: Could add preview of code removed here.
229     
230     print("") # Aesthetics.
231 
232   def handle_help(self, arguments):
233     commands_description = {
234       "%debug [true/false]": "Toggle debug mode. Without arguments or with 'true', it enters debug mode. With 'false', it exits debug mode.",
235       "%reset": "Resets the current session.",
236       "%undo": "Remove previous messages and its response from the message history.",
237       "%save_message [path]": "Saves messages to a specified JSON path. If no path is provided, it defaults to 'messages.json'.",
238       "%load_message [path]": "Loads messages from a specified JSON path. If no path is provided, it defaults to 'messages.json'.",
239       "%help": "Show this help message.",
240     }
241 
242     base_message = [
243       "> **Available Commands:**\n\n"
244     ]
245 
246     # Add each command and its description to the message
247     for cmd, desc in commands_description.items():
248       base_message.append(f"- `{cmd}`: {desc}\n")
249 
250     additional_info = [
251       "\n\nFor further assistance, please join our community Discord or consider contributing to the project's development."
252     ]
253 
254     # Combine the base message with the additional info
255     full_message = base_message + additional_info
256 
257     print(Markdown("".join(full_message)))
258 
