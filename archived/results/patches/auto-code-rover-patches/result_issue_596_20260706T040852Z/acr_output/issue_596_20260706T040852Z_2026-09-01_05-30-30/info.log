959             # time.sleep(2)
960             # print("Informing the language model and continuing...")
961 
962             # Since it can't really be fixed without something complex,
963             # let's just berate the LLM then go around again.
964 
965             self.messages.append({
966               "role": "function",
967               "name": "run_code",
968               "content": """Your function call could not be parsed. Please use ONLY the `run_code` function, which takes two parameters: `code` and `language`. Your response should be formatted as a JSON."""
969             })
