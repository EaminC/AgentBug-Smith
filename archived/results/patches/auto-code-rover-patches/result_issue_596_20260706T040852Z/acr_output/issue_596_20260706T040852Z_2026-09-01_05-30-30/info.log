165         if "content" in message:
166           message_for_semantic_search["content"] = message["content"]
167         if "function_call" in message and "parsed_arguments" in message["function_call"]:
168           message_for_semantic_search["function_call"] = message["function_call"]["parsed_arguments"]
169         query.append(message_for_semantic_search)
170 
171       # Use them to query Open Procedures
172       url = "https://open-procedures.replit.app/search/"
173 
174       try:
175         relevant_procedures = requests.get(url, data=json.dumps(query)).json()["procedures"]
176         info += "\n\n# Recommended Procedures\n" + "\n---\n".join(relevant_procedures) + "\nIn your plan, include steps and, if present, **EXACT CODE SNIPPETS** (especially for depracation notices, **WRITE THEM INTO YOUR PLAN -- underneath each numbered step** as they will VANISH once you execute your first line of code, so WRITE THEM DOWN NOW if you need them) from the above procedures if they are relevant to the task. Again, include **VERBATIM CODE SNIPPETS** from the procedures above if they are relevent to the task **directly in your plan.**"
177       except:
178         # For someone, this failed for a super secure SSL reason.
179         # Since it's not stricly necessary, let's worry about that another day. Should probably log this somehow though.
180         pass
181 
182     elif self.local:
183 
184       # Tell Code-Llama how to run code.
185       info += "\n\nTo run code, write a fenced code block (i.e ```python, R or ```shell) in markdown. When you close it with ```, it will be run. You'll then be given its output."
186       # We make references in system_message.txt to the "function" it can call, "run_code".
187 
188     return info
189 
