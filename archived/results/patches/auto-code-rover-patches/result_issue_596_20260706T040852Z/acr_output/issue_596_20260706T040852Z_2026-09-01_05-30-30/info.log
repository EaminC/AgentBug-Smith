302   def handle_command(self, user_input):
303     # split the command into the command and the arguments, by the first whitespace
304     switch = {
305       "help": self.handle_help,
306       "debug": self.handle_debug,
307       "reset": self.handle_reset,
308       "save_message": self.handle_save_message,
309       "load_message": self.handle_load_message,
310       "undo": self.handle_undo,
311     }
312 
313     user_input = user_input[1:].strip()  # Capture the part after the `%`
314     command = user_input.split(" ")[0]
315     arguments = user_input[len(command):].strip()
316     action = switch.get(command,
317                         self.default_handle)  # Get the function from the dictionary, or default_handle if not found
318     action(arguments)  # Execute the function
