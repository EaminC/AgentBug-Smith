585   def respond(self):
586     # Add relevant info to system_message
587     # (e.g. current working directory, username, os, etc.)
588     info = self.get_info_for_system_message()
589 
590     # This is hacky, as we should have a different (minified) prompt for CodeLLama,
591     # but for now, to make the prompt shorter and remove "run_code" references, just get the first 2 lines:
592     if self.local:
593       self.system_message = "\n".join(self.system_message.split("\n")[:2])
594       self.system_message += "\nOnly do what the user asks you to do, then ask what they'd like to do next."
595 
596     system_message = self.system_message + "\n\n" + info
597 
598     if self.local:
599       messages = tt.trim(self.messages, max_tokens=(self.context_window-self.max_tokens-25), system_message=system_message)
600     else:
601       messages = tt.trim(self.messages, self.model, system_message=system_message)
602 
603     if self.debug_mode:
604       print("\n", "Sending `messages` to LLM:", "\n")
605       print(messages)
606       print()
607 
608     # Make LLM call
609     if not self.local:
610       
611       # GPT
612       max_attempts = 3  
613       attempts = 0  
614       error = ""
615 
616       while attempts < max_attempts:
617         attempts += 1
618         try:
619 
620             if self.use_azure:
621               response = litellm.completion(
622                   f"azure/{self.azure_deployment_name}",
623                   messages=messages,
624                   functions=[function_schema],
625                   temperature=self.temperature,
626                   stream=True,
627                   )
628             else:
629               if self.api_base:
630                 # The user set the api_base. litellm needs this to be "custom/{model}"
631                 response = litellm.completion(
632                   api_base=self.api_base,
633                   model = "custom/" + self.model,
634                   messages=messages,
635                   functions=[function_schema],
636                   stream=True,
637                   temperature=self.temperature,
638                 )
639               else:
640                 # Normal OpenAI call
641                 response = litellm.completion(
642                   model=self.model,
643                   messages=messages,
644                   functions=[function_schema],
645                   stream=True,
646                   temperature=self.temperature,
647                 )
648             break
649         except litellm.BudgetExceededError as e:
650           print(f"Since your LLM API Budget limit was exceeded, you're being switched to local models. Budget: {litellm.max_budget} | Current Cost: {litellm._current_cost}")
651           
652           print(Markdown(
653                 "> Switching to `Code-Llama`...\n\n**Tip:** Run `interpreter --local` to automatically use `Code-Llama`."),
654                     '')
655           time.sleep(2)
656           print(Rule(style="white"))
657 
658 
659 
660           # Temporarily, for backwards (behavioral) compatability, we've moved this part of llama_2.py here.
661           # AND ABOVE.
662           # This way, when folks hit interpreter --local, they get the same experience as before.
663           import inquirer
664 
665           print('', Markdown("**Open Interpreter** will use `Code Llama` for local execution. Use your arrow keys to set up the model."), '')
666 
667           models = {
668               '7B': 'TheBloke/CodeLlama-7B-Instruct-GGUF',
669               '13B': 'TheBloke/CodeLlama-13B-Instruct-GGUF',
670               '34B': 'TheBloke/CodeLlama-34B-Instruct-GGUF'
671           }
672 
673           parameter_choices = list(models.keys())
674           questions = [inquirer.List('param', message="Parameter count (smaller is faster, larger is more capable)", choices=parameter_choices)]
675           answers = inquirer.prompt(questions)
676           chosen_param = answers['param']
677 
678           # THIS is more in line with the future. You just say the model you want by name:
679           self.model = models[chosen_param]
680           self.local = True
681           continue
682         except RateLimitError as rate_error:  # Catch the specific RateLimitError
683             print(Markdown(f"> We hit a rate limit. Cooling off for {attempts} seconds..."))
684             time.sleep(attempts)  
685             max_attempts += 1
686         except Exception as e:  # Catch other exceptions
687             if self.debug_mode:
688               traceback.print_exc()
689             error = traceback.format_exc()
690             time.sleep(3)
691       else:
692         if self.local: 
693           pass
694         else:
695           raise Exception(error)
696             
697     if self.local:
698       # Code-Llama
699 
700 
701 
702       # Convert messages to prompt
703       # (This only works if the first message is the only system message)
704 
705       def messages_to_prompt(messages):
706 
707 
708         for message in messages:
709           # Happens if it immediatly writes code
710           if "role" not in message:
711             message["role"] = "assistant"
712 
713 
714         # Falcon prompt template
715         if "falcon" in self.model.lower():
716 
717           formatted_messages = ""
718           for message in messages:
719             formatted_messages += f"{message['role'].capitalize()}: {message['content']}\n"
720           formatted_messages = formatted_messages.strip()
721 
722         else:
723           # Llama prompt template
724 
725           # Extracting the system prompt and initializing the formatted string with it.
726           system_prompt = messages[0]['content']
727           formatted_messages = f"<s>[INST] <<SYS>>\n{system_prompt}\n<</SYS>>\n"
728 
729           # Loop starting from the first user message
730           for index, item in enumerate(messages[1:]):
731               role = item['role']
732               content = item['content']
733 
734               if role == 'user':
735                   formatted_messages += f"{content} [/INST] "
736               elif role == 'function':
737                   formatted_messages += f"Output: {content} [/INST] "
738               elif role == 'assistant':
739                   formatted_messages += f"{content} </s><s>[INST] "
740 
741           # Remove the trailing '<s>[INST] ' from the final output
742           if formatted_messages.endswith("<s>[INST] "):
743               formatted_messages = formatted_messages[:-10]
744 
745         return formatted_messages
746 
747       prompt = messages_to_prompt(messages)
748       # Lmao i can't believe this works (it does need this btw)
749       if messages[-1]["role"] != "function":
750         prompt += "Let's explore this. By the way, I can run code on your machine by writing the code in a markdown code block. This works for shell, javascript, python, R, and applescript. I'm going to try to do this for your task. Anyway, "
751       elif messages[-1]["role"] == "function" and messages[-1]["content"] != "No output":
752         prompt += "Given the output of the code I just ran, "
753       elif messages[-1]["role"] == "function" and messages[-1]["content"] == "No output":
754         prompt += "Given the fact that the code I just ran produced no output, "
755 
756 
757       if self.debug_mode:
758         # we have to use builtins bizarrely! because rich.print interprets "[INST]" as something meaningful
759         import builtins
760         builtins.print("TEXT PROMPT SEND TO LLM:\n", prompt)
761 
762       # Run Code-Llama
763 
764       response = self.llama_instance(
765         prompt,
766         stream=True,
767         temperature=self.temperature,
768         stop=["</s>"],
769         max_tokens=750 # context window is set to 1800, messages are trimmed to 1000... 700 seems nice
770       )
771 
772     # Initialize message, function call trackers, and active block
773     self.messages.append({})
774     in_function_call = False
775     llama_function_call_finished = False
776     self.active_block = None
777 
778     for chunk in response:
779       if self.use_azure and ('choices' not in chunk or len(chunk['choices']) == 0):
780         # Azure OpenAI Service may return empty chunk
781         continue
782 
783       if self.local:
784         if "content" not in messages[-1]:
