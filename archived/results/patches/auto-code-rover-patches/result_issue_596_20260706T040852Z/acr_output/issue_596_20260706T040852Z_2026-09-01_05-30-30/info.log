585   def respond(self):
586     # Add relevant info to system_message
587     # (e.g. current working directory, username, os, etc.)
588     info = self.get_info_for_system_message()
589 
590     # This is hacky, as we should have a different (minified) prompt for CodeLLama,
591     # but for now, to make the prompt shorter and remove "run_code" references, just get the first 2 lines:
592     if self.local:
593       self.system_message = "\n".join(self.system_message.split("\n")[:2])
594       self.system_message += "\nOnly do what the user asks you to do, then ask what they'd like to do next."
595 
596     system_message = self.system_message + "\n\n" + info
597 
598     if self.local:
599       messages = tt.trim(self.messages, max_tokens=(self.context_window-self.max_tokens-25), system_message=system_message)
600     else:
601       messages = tt.trim(self.messages, self.model, system_message=system_message)
602 
603     if self.debug_mode:
604       print("\n", "Sending `messages` to LLM:", "\n")
605       print(messages)
606       print()
607 
608     # Make LLM call
609     if not self.local:
610       
611       # GPT
612       max_attempts = 3  
