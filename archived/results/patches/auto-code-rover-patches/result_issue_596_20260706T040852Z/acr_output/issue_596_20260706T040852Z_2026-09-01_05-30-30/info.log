984 
985           # End the active_block
986           self.active_block.end()
987 
988           # Append the output to messages
989           # Explicitly tell it if there was no output (sometimes "" = hallucinates output)
990           self.messages.append({
991             "role": "function",
992             "name": "run_code",
993             "content": self.active_block.output if self.active_block.output else "No output"
994           })
995 
996           # Go around again
997           self.respond()
