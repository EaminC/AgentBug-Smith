+    async def _start_task_async(self, tool_use_id: str, arguments: dict[str, Any] | None) -> Any:
+        """Start a long running MCP task asynchronously."""
+        if not self._is_session_active():
+            raise MCPClientInitializationError("Client session is not active")
+
+        async def _call_start_task() -> Any:
+            return await cast(ClientSession, self._background_thread_session).call_tool(
+                "start_task", arguments, None
+            )
+
+        start_task_result = await self._invoke_on_background_thread(_call_start_task())
+        self._log_debug_with_thread(f"Started task with ID {start_task_result.taskId}")
+        return start_task_result
+
+    async def _poll_task_until_done(self, tool_use_id: str, task_id: str) -> MCPToolResult:
+        """Poll the MCP server until the task with task_id is completed."""
+        if not self._is_session_active():
+            raise MCPClientInitializationError("Client session is not active")
+
+        max_poll_attempts = 60  # e.g. poll up to 1 minute with 1 second interval
+        poll_interval = 1.0  # seconds
+
+        for attempt in range(max_poll_attempts):
+            self._log_debug_with_thread(f"Polling task {task_id} attempt {attempt + 1}")
+            async def _get_task_status() -> Any:
+                return await cast(ClientSession, self._background_thread_session).call_tool(
+                    "get_task_status", {"taskId": task_id}, None
+                )
+
+            task_status_result = await self._invoke_on_background_thread(_get_task_status())
+            if task_status_result.get("status") == "completed":
+                self._log_debug_with_thread(f"Task {task_id} completed")
+                return self._handle_tool_result(tool_use_id, task_status_result)
+
+            await asyncio.sleep(poll_interval)
+
+        self._log_debug_with_thread(f"Task {task_id} did not complete after {max_poll_attempts} attempts")
+        return self._handle_tool_execution_error(tool_use_id, Exception("Task did not complete in time"))
+
