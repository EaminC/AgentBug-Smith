+def test_is_session_active_with_close_future():
+    class DummyThread:
+        def __init__(self, alive):
+            self._alive = alive
+        def is_alive(self):
+            return self._alive
+
+    class DummyClient:
+        def __init__(self, background_alive, close_future_done):
+            self._background_thread = DummyThread(background_alive)
+            class DummyFuture:
+                def __init__(self, done):
+                    self._done = done
+                def done(self):
+                    return self._done
+            self._close_future = DummyFuture(close_future_done)
+
+    # Session inactive due to no background thread
+    client = DummyClient(False, False)
+    assert client._is_session_active() is False
+
+    # Session inactive due to close_future done
+    client = DummyClient(True, True)
+    assert client._is_session_active() is False
+
+    # Session active
+    client = DummyClient(True, False)
+    assert client._is_session_active() is True
+
+# Should create both tools
+assert mock_agent_tool_class.call_count == 2
+
+# Should only include short tool (name length <= 10)
+assert len(result) == 1
+assert result[0] is mock_agent_tool1
 
