+        # Customize deepcopy to avoid copying unpickleable objects
+        try:
+            return copy.deepcopy(self._state)
+        except TypeError as e:
+            # Create a shallow copy by excluding unpickleable objects if deepcopy fails
+            from copy import copy
+            state_dict = None
+            if isinstance(self._state, dict):
+                state_dict = {k: v for k, v in self._state.items() if not _is_unpickleable(v)}
+            elif hasattr(self._state, '__dict__'):
+                state_dict = {k: v for k, v in self._state.__dict__.items() if not _is_unpickleable(v)}
+
+            if state_dict is not None:
+                # Return a shallow copy of the filtered dict
+                return copy(state_dict)
+            else:
+                raise e
+
+
+def _is_unpickleable(obj: object) -> bool:
+    import threading
+    import _thread
+    unpickleable_types = (
+        threading.RLock,
+        _thread.RLock,
+    )
+    return isinstance(obj, unpickleable_types)
 
