+@cli.command()
+@click.argument('command')
+@click.argument('file_path', required=False)
+def memory_manage(command, file_path=None):
+    """
+    Manage the local memory by listing keys or adding/removing files.
+    Usage:
+      memory_manage list
+      memory_manage add /path/to/file
+      memory_manage remove /path/to/file
+    """
+    memory_instance = LanceDBMemory(os.getcwd())
+    if command == 'list':
+        table = memory_instance.client.open_table(memory_instance.table_name)
+        keys = [record['id'] for record in table.to_pylist()]
+        for key in keys:
+            print(key)
+    elif command == 'add' and file_path:
+        with open(file_path, 'r') as f:
+            content = f.read()
+        chunks = CodeChunker(os.path.join(os.getcwd(), '.mle', 'cache'), 'py').chunk(content, token_limit=100)
+        memory_instance.add(
+            texts=list(chunks.values()),
+            table_name=memory_instance.table_name,
+            metadata=[{'file': file_path, 'chunk_key': k} for k, _ in chunks.items()]
+        )
+        print(f"Added {file_path} to memory.")
+    elif command == 'remove' and file_path:
+        table = memory_instance.client.open_table(memory_instance.table_name)
+        rows = table.to_pylist()
+        for row in rows:
+            if row.get('metadata', {}).get('file') == file_path:
+                memory_instance.delete(row['id'], table_name=memory_instance.table_name)
+                print(f"Removed data related to {file_path} from memory.")
+    else:
+        print("Invalid command or missing file_path.")
+
+
