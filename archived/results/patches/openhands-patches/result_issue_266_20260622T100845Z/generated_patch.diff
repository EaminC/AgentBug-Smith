+async def list_memory_keys():
+    memory_instance = LanceDBMemory('.')
+    try:
+        table = memory_instance.client.open_table(memory_instance.table_name)
+        keys = [record['id'] for record in table.to_pylist()]
+        return JSONResponse(content=keys)
