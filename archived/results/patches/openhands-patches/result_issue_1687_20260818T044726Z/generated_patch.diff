+import inspect
+import asyncio
+
+
+class SyncPlugin:
+    def __init__(self):
+        self.initialized = False
+
+    def init_plugin(self, agent):
+        self.initialized = True
+        agent.add_hook(self.record_hook)
+
+    def record_hook(self, event):
+        pass
+
+
+class AsyncPlugin:
+    def __init__(self):
+        self.initialized = False
+
+    async def init_plugin(self, agent):
+        await asyncio.sleep(0.01)  # Simulate async init
+        self.initialized = True
+        agent.add_hook(self.record_hook)
+
+    def record_hook(self, event):
+        pass
+
+
+def test_agent_plugins_initialization(monkeypatch):
+    sync_plugin = SyncPlugin()
+    async_plugin = AsyncPlugin()
+
+    agent = Agent(plugins=[sync_plugin, async_plugin])
+
+    # Assert sync plugin was initialized
+    assert sync_plugin.initialized
+
+    # Assert async plugin was initialized
+    assert async_plugin.initialized
+
+
+async def test_agent_plugins_multiple_order():
+    order = []
+
+    class Plugin1:
+        def init_plugin(self, agent):
+            order.append("plugin1")
+
+    class Plugin2:
+        async def init_plugin(self, agent):
+            order.append("plugin2")
+
+    agent = Agent(plugins=[Plugin1(), Plugin2()])
+
+    # Wait a bit for async init_plugin to complete if needed
+    await asyncio.sleep(0.1)
+
+    assert order == ["plugin1", "plugin2"]
+
+
+def test_agent_no_plugins():
+    agent = Agent(plugins=None)
+    assert agent is not None
+
+
+def test_agent_empty_plugins():
+    agent = Agent(plugins=[])
+    assert agent is not None
+
+
