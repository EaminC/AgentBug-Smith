diff --git a/mle/cli.py b/mle/cli.py
index b646e0d..452d148 100644
--- a/mle/cli.py
+++ b/mle/cli.py
@@ -36,6 +36,59 @@ def check_config():
 
     return True
 
+@cli.command()
+@click.argument('session_name', required=False)
+def resume(session_name=None):
+    """
+    resume: resume a previous session with an optional SESSION_NAME.
+    """
+    if not check_config():
+        return
+
+    session_file = f"session_{session_name or 'default'}.yml"
+    if not os.path.exists(session_file):
+        console.log(f"No saved session found for '{session_name or 'default'}'.")
+        return
+
+    with open(session_file, 'r') as f:
+        chat_history = yaml.safe_load(f)
+
+    model = load_model(os.getcwd(), model_name='gpt-4o')
+    coder = CodeAgent(model)
+    coder.chat_history = chat_history or []
+
+    while True:
+        try:
+            user_pmpt = questionary.text(f"[Exit/Ctrl+D] (Resumed session: {session_name or 'default'}): ").ask()
+            if user_pmpt:
+                with Live(console=Console()) as live:
+                    for text in coder.chat(user_pmpt.strip()):
+                        live.update(
+                            Panel(Markdown(text), title="[bold magenta]MLE-Agent[/]", border_style="magenta"),
+                            refresh=True
+                        )
+        except (KeyboardInterrupt, EOFError):
+            exit()
+
+@cli.command()
+def save_session(session_name='default'):
+    """
+    save_session: save the current session chat history with an optional SESSION_NAME.
+    """
+    if not check_config():
+        return
+
+    session_file = f"session_{session_name}.yml"
+
+    # Assuming the current working directory has a file that keeps the current chat history
+    # This is a simplification. In practice, we might need to keep track of the coder instance globally
+    try:
+        with open(session_file, 'w') as f:
+            yaml.dump(coder.chat_history, f)
+        console.log(f"Session saved to {session_file}")
+    except Exception as e:
+        console.log(f"Failed to save session: {e}")
+
 
 @click.group()
 @click.version_option(version=mle.__version__)
