[32mimport pytest
from pydantic import ValidationError
from metagpt.configs.llm_config import LLMConfig


def test_api_key_validation_error_shows_config_path():
    """Test that ValidationError for YOUR_API_KEY includes the full config file path.
    
    Regression test for issue #1220: When api_key is unset (YOUR_API_KEY), the error
    message should indicate which specific config2.yaml file needs to be edited,
    not just a generic filename.
    """
    with pytest.raises(ValidationError) as exc_info:
        LLMConfig(api_key="YOUR_API_KEY")
    
    error_msg = str(exc_info.value)
    
    # Buggy version shows: "Please set your API key in config2.yaml"
    # Fixed version shows full path like: "/app/config/config2.yaml" or 
    # "/root/.metagpt/config2.yaml" (depending on which exists)
    
    # Ensure the error mentions config2.yaml
    assert "config2.yaml" in error_msg
    
    # Ensure it's not the old generic message without path
    # The fix includes directory path (either /config/ or /.metagpt/)
    has_full_path = (
        "/config/config2.yaml" in error_msg or
        "\\config\\config2.yaml" in error_msg or
        "/.metagpt/config2.yaml" in error_msg or
        "\\.metagpt\\config2.yaml" in error_msg
    )
    
    assert has_full_path, (
        f"Expected error message to contain full path to config file "
        f"(e.g., /config/config2.yaml or /.metagpt/config2.yaml), "
        f"but got: {error_msg}"
    )[0m
