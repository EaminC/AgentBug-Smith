[32mFROM python:3.11-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"



# --- end inject ---

# --- Forge API Configuration ---
# These env vars are used by various SDKs
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="gpt-4o"
ENV AI_TEMPERATURE="0.7"

# OpenAI SDK compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"

# Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="claude-3-5-sonnet"
ENV ANTHROPIC_SMALL_FAST_MODEL="claude-3-5-sonnet"

# Other environment variables
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"




# Prevent Python from writing pyc files and buffering stdout
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    git \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install essential build tools
RUN python -m pip install --upgrade pip wheel setuptools

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies in stages with retry logic
# Stage 1: Install numpy and other base packages first
RUN pip install numpy>=1.24.3 pandas>=2.0.0

# Stage 2: Install packages that often need compilation
RUN pip install aiohttp>=3.8.0 || pip install aiohttp --no-build-isolation
RUN pip install faiss-cpu>=1.7.4 || pip install faiss-cpu --no-build-isolation || true
RUN pip install lxml>=4.9.0 || pip install lxml --no-build-isolation

# Stage 3: Install remaining requirements with fallback
RUN pip install -r requirements.txt || (echo "Some packages failed, continuing..." && true)

# Copy the entire repository
COPY . .

# CRITICAL: Update config2.yaml with the Forge API key before installation
# This ensures the API key is valid when metagpt is imported during install
RUN if [ -f "config/config2.yaml" ]; then \
        sed -i 's/api_key: "YOUR_API_KEY"/api_key: "forge-key"/' config/config2.yaml && \
        sed -i 's|base_url: "https://api.openai.com/v1"|base_url: "https://api.forge.tensorblock.co/v1"|' config/config2.yaml && \
        sed -i 's/model: "gpt-4-turbo"/model: "gpt-4o"/' config/config2.yaml; \
    fi

# Also update any example config files that might be used
RUN find config -name "*.yaml" -exec sed -i 's/api_key: "YOUR_API_KEY"/api_key: "forge-key"/g' {} \; 2>/dev/null || true
RUN find config -name "*.yaml" -exec sed -i 's|base_url: "https://api.openai.com/v1"|base_url: "https://api.forge.tensorblock.co/v1"|g' {} \; 2>/dev/null || true

# Install the project in editable mode
RUN pip install -e . || echo "Editable install had issues but continuing"

# Install test dependencies explicitly
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout \
    setuptools litellm mem0ai || echo "Some test deps failed but continuing"

# Verify Python and critical imports work
RUN python -c "import sys; print(f'Python {sys.version}')" && \
    python -c "import numpy, pandas; print('Base imports OK')" || true

# Default command
CMD ["/bin/bash"]
