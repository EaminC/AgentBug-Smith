# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"



# --- end inject ---

# Prevent Python from writing pyc files and buffering stdout
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    git \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install essential build tools
RUN python -m pip install --upgrade pip wheel setuptools

# Copy configuration files first (before requirements for cache optimization)
COPY requirements.txt .
COPY setup.py .
COPY pyproject.toml* ./

# --- Forge API Environment Variables ---
# AgentSmith injected environment variables
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="gpt-4o"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"

# OpenAI SDK compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"

# Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="claude-3-5-sonnet"
ENV ANTHROPIC_SMALL_FAST_MODEL="claude-3-5-sonnet"

# Other environment variables
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"




# LLM_* environment variables for MetaGPT config override
ENV LLM_API_KEY="forge-key"
ENV LLM_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV LLM_MODEL="gpt-4o"
ENV LLM_API_TYPE="openai"

# Copy config files early and update them before any Python package installation
COPY config/ ./config/
COPY tests/config2.yaml ./tests/config2.yaml

# CRITICAL: Update config files BEFORE installing metagpt (which imports config at module level)
# Update main config file
RUN if [ -f "config/config2.yaml" ]; then \
        sed -i 's/api_key: "YOUR_API_KEY"/api_key: "forge-key"/' config/config2.yaml && \
        sed -i 's|base_url: "https://api.openai.com/v1"|base_url: "https://api.forge.tensorblock.co/v1"|' config/config2.yaml && \
        sed -i 's/model: "gpt-4-turbo"/model: "gpt-4o"/' config/config2.yaml; \
    fi

# Update test config file
RUN if [ -f "tests/config2.yaml" ]; then \
        sed -i 's/api_key: "sk-xxx"/api_key: "forge-key"/' tests/config2.yaml && \
        sed -i 's|base_url: "https://api.openai.com/v1"|base_url: "https://api.forge.tensorblock.co/v1"|' tests/config2.yaml && \
        sed -i 's/model: "gpt-3.5-turbo"/model: "gpt-4o"/' tests/config2.yaml; \
    fi

# Update all yaml configs in config directory
RUN find config -name "*.yaml" -exec sed -i 's/api_key: "YOUR_API_KEY"/api_key: "forge-key"/g' {} \; 2>/dev/null || true && \
    find config -name "*.yaml" -exec sed -i 's|base_url: "https://api.openai.com/v1"|base_url: "https://api.forge.tensorblock.co/v1"|g' {} \; 2>/dev/null || true

# Install base dependencies first (numpy, pandas)
RUN pip install numpy>=1.24.3 pandas>=2.0.0

# Install packages that often need compilation with fallbacks
RUN pip install aiohttp>=3.8.6 || pip install aiohttp --no-build-isolation
RUN pip install faiss-cpu==1.7.4 || pip install faiss-cpu --no-build-isolation || true
RUN pip install lxml || pip install lxml --no-build-isolation

# Install main requirements
RUN pip install -r requirements.txt || (echo "Some packages from requirements.txt failed, continuing..." && true)

# Copy the entire repository
COPY . .

# Re-apply config updates after full copy (in case they were overwritten)
RUN if [ -f "config/config2.yaml" ]; then \
        sed -i 's/api_key: "YOUR_API_KEY"/api_key: "forge-key"/' config/config2.yaml && \
        sed -i 's|base_url: "https://api.openai.com/v1"|base_url: "https://api.forge.tensorblock.co/v1"|' config/config2.yaml && \
        sed -i 's/model: "gpt-4-turbo"/model: "gpt-4o"/' config/config2.yaml; \
    fi

RUN if [ -f "tests/config2.yaml" ]; then \
        sed -i 's/api_key: "sk-xxx"/api_key: "forge-key"/' tests/config2.yaml && \
        sed -i 's|base_url: "https://api.openai.com/v1"|base_url: "https://api.forge.tensorblock.co/v1"|' tests/config2.yaml && \
        sed -i 's/model: "gpt-3.5-turbo"/model: "gpt-4o"/' tests/config2.yaml; \
    fi

# Install the project in editable mode (now configs are already updated)
RUN pip install -e . || echo "Editable install had issues but continuing"

# Install test dependencies - including the missing ones explicitly
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout \
    setuptools litellm mem0ai curl-cffi httplib2 || echo "Some test deps failed but continuing"

# Verify Python and critical imports work
RUN python -c "import sys; print(f'Python {sys.version}')" && \
    python -c "import numpy, pandas; print('Base imports OK')" && \
    python -c "import curl_cffi; print('curl_cffi OK')" && \
    python -c "import httplib2; print('httplib2 OK')" || true

# Verify config files were properly updated
RUN cat config/config2.yaml && cat tests/config2.yaml

# Default command
CMD ["/bin/bash"]
