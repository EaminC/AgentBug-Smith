from pydantic import ValidationError
from metagpt.configs.llm_config import LLMConfig


def test_api_key_validation_error_shows_config_path():
    """Test that ValidationError for default API key shows specific config file path.
    
    Regression test for issue #1220: Error message should indicate which config2.yaml
    file needs to be edited (repo vs root), not just generic 'config2.yaml'.
    """
    with pytest.raises(ValidationError) as exc_info:
        LLMConfig(api_key="YOUR_API_KEY")
    
    error_msg = str(exc_info.value)
    
    # The buggy code shows: "Please set your API key in config2.yaml"
    # The fixed code shows: "Please set your API key in /path/to/config2.yaml" 
    # or includes warning about config files overwriting each other
    
    # Check that message includes path separators (indicating absolute/relative path)
    # or the overwrite warning, rather than just generic filename
    assert ("/" in error_msg or 
            "\\" in error_msg or 
            "overwrite" in error_msg.lower()), \
        f"Error message should include specific config file path, got: {error_msg}"[0m
