# Prevent Python from writing pyc files and buffering stdout
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    git \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install essential build tools
RUN python -m pip install --upgrade pip wheel setuptools==65.6.3

# --- Forge API Environment Variables ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="gpt-4o"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"

# OpenAI SDK compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"

# Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="claude-3-5-sonnet"
ENV ANTHROPIC_SMALL_FAST_MODEL="claude-3-5-sonnet"

# Other environment variables
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"




# LLM_* environment variables for MetaGPT config override
ENV LLM_API_KEY="forge-key"
ENV LLM_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV LLM_MODEL="gpt-4o"
ENV LLM_API_TYPE="openai"

# Copy the entire repository first
COPY . .

# Fix Pydantic version compatibility issue - install pydantic v2 and compatible packages first
RUN pip install "pydantic>=2.5.3,<3.0.0" "pydantic-core>=2.14.0" "typing-extensions>=4.9.0"

# Install base dependencies that many packages depend on
RUN pip install "numpy>=1.24.3" "pandas==2.1.1" "PyYAML==6.0.1" "tqdm==4.66.2"

# Install packages that need compilation with proper flags
RUN pip install "lxml" --no-build-isolation || pip install "lxml" || true
RUN pip install "faiss-cpu==1.7.4" --no-build-isolation || pip install "faiss-cpu==1.7.4" || true

# Install specific version of tenacity before requirements.txt to avoid conflicts
RUN pip install "tenacity==8.2.3"

# Install requirements with constraint to ensure pydantic v2 compatibility
RUN pip install --no-cache-dir -r requirements.txt || \
    (echo "Retrying with individual package installs..." && \
     grep -v "^#" requirements.txt | grep -v "^$" | while read pkg; do \
         pip install "$pkg" 2>/dev/null || echo "Failed to install $pkg, continuing..."; \
     done)

# Re-install pydantic v2 to ensure it's not overwritten
RUN pip install "pydantic>=2.5.3,<3.0.0" "pydantic-core>=2.14.0"

# Update config files to use Forge API
RUN if [ -f "config/config2.yaml" ]; then \
        sed -i 's/api_key: "YOUR_API_KEY"/api_key: "forge-key"/' config/config2.yaml && \
        sed -i 's|base_url: "https://api.openai.com/v1"|base_url: "https://api.forge.tensorblock.co/v1"|' config/config2.yaml && \
        sed -i 's/model: "gpt-4-turbo"/model: "gpt-4o"/' config/config2.yaml; \
    fi

RUN if [ -f "tests/config2.yaml" ]; then \
        sed -i 's/api_key: "sk-xxx"/api_key: "forge-key"/' tests/config2.yaml && \
        sed -i 's|base_url: "https://api.openai.com/v1"|base_url: "https://api.forge.tensorblock.co/v1"|' tests/config2.yaml && \
        sed -i 's/model: "gpt-3.5-turbo"/model: "gpt-4o"/' tests/config2.yaml; \
    fi

# Update all yaml configs in config directory
RUN find config -name "*.yaml" -exec sed -i 's/api_key: "YOUR_API_KEY"/api_key: "forge-key"/g' {} \; 2>/dev/null || true
RUN find config -name "*.yaml" -exec sed -i 's|base_url: "https://api.openai.com/v1"|base_url: "https://api.forge.tensorblock.co/v1"|g' {} \; 2>/dev/null || true

# Install the project in editable mode
RUN pip install -e . --no-deps || pip install -e . || true

# Install test dependencies
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout \
    litellm mem0ai curl-cffi httplib2 "setuptools<=81.0.0"

# Verify critical imports work
RUN python -c "import sys; print(f'Python {sys.version}')" && \
    python -c "import pydantic; print(f'Pydantic version: {pydantic.__version__}')" && \
    python -c "from pydantic.networks import AnyUrl; print('Pydantic networks import OK')" && \
    python -c "import numpy, pandas; print('Base imports OK')"

# Final verification that metagpt can be imported
RUN python -c "import metagpt; print('MetaGPT import OK')" || echo "MetaGPT import had warnings but continuing"

# Default command
CMD ["/bin/bash"]
