[32mimport pytest
from pathlib import Path
import tempfile
import shutil


def test_llm_config_validation_error_shows_specific_path():
    """Test that LLMConfig validation error includes specific config file paths.
    
    Regression test for issue #1220: Error message was generic ("Please set your API key in config2.yaml")
    and didn't indicate which config file was actually being checked or the precedence between
    METAGPT_ROOT/config/config2.yaml and CONFIG_ROOT/config2.yaml.
    """
    from metagpt.configs.llm_config import LLMConfig
    import metagpt.configs.llm_config as llm_config_module
    from pydantic import ValidationError
    
    # Check if we have the fixed version (which imports METAGPT_ROOT and CONFIG_ROOT)
    is_fixed_version = hasattr(llm_config_module, 'METAGPT_ROOT')
    
    if is_fixed_version:
        # Fixed version: Create temporary config files to trigger detailed error message
        tmpdir = tempfile.mkdtemp()
        try:
            tmp_path = Path(tmpdir)
            
            # Save original values
            orig_meta_root = llm_config_module.METAGPT_ROOT
            orig_config_root = llm_config_module.CONFIG_ROOT
            
            # Patch paths to temporary directories
            llm_config_module.METAGPT_ROOT = tmp_path / "metagpt"
            llm_config_module.CONFIG_ROOT = tmp_path / "config"
            
            # Create config file at CONFIG_ROOT (user config) to trigger the precedence warning
            user_config = llm_config_module.CONFIG_ROOT / "config2.yaml"
            user_config.parent.mkdir(parents=True, exist_ok=True)
            user_config.write_text("llm:\n  api_key: YOUR_API_KEY\n")
            
            try:
                with pytest.raises(ValidationError) as exc_info:
                    LLMConfig(api_key="YOUR_API_KEY")
                
                error_msg = str(exc_info.value)
                
                # Fixed version should include the specific file path or mention that
                # the former overwrites the latter
                assert (
                    str(user_config) in error_msg 
                    or "overwrites" in error_msg 
                    or str(llm_config_module.METAGPT_ROOT / "config/config2.yaml") in error_msg
                ), f"Fixed version should show specific config path. Got: {error_msg}"
                
            finally:
                # Restore original paths
                llm_config_module.METAGPT_ROOT = orig_meta_root
                llm_config_module.CONFIG_ROOT = orig_config_root
        finally:
            shutil.rmtree(tmpdir)
    else:
        # Buggy version: The error message is generic and doesn't check file existence
        with pytest.raises(ValidationError) as exc_info:
            LLMConfig(api_key="YOUR_API_KEY")
        
        error_msg = str(exc_info.value)
        
        # Verify we got the validation error about API key
        assert "Please set your API key" in error_msg
        
        # This assertion will FAIL on buggy version because it lacks the specific path
        # information and precedence warning that the fix adds
        assert (
            "overwrites" in error_msg 
            or "METAGPT_ROOT" in error_msg 
            or "CONFIG_ROOT" in error_msg
        ), f"Buggy version lacks detailed path information in error: {error_msg}"[0m
