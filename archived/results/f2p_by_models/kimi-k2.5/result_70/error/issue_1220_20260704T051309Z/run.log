[32mimport pytest
from pathlib import Path
from pydantic import ValidationError

def test_llm_config_api_key_error_shows_specific_path(tmp_path, monkeypatch):
    """Test that ValidationError for YOUR_API_KEY shows specific config file path.
    
    Regression test for issue #1220.
    Buggy behavior: Error message is generic "Please set your API key in config2.yaml"
    Fixed behavior: Error message shows specific path like "/path/to/config/config2.yaml"
    """
    from metagpt.configs.llm_config import LLMConfig
    
    # Setup: Create a temporary config file structure to trigger the specific path branch
    config_dir = tmp_path / "config"
    config_dir.mkdir(parents=True, exist_ok=True)
    config_file = config_dir / "config2.yaml"
    config_file.write_text("llm:\n  model: gpt-4\n")
    
    # Patch METAGPT_ROOT to point to our temp directory so the validator finds our dummy config
    monkeypatch.setattr("metagpt.configs.llm_config.METAGPT_ROOT", tmp_path)
    
    # Attempt to create LLMConfig with placeholder API key
    with pytest.raises(ValidationError) as exc_info:
        LLMConfig(api_key="YOUR_API_KEY", model="gpt-4")
    
    error_msg = str(exc_info.value)
    
    # The fixed version should include the specific file path in the error message
    # The buggy version only says "config2.yaml" without the specific path
    expected_path_str = str(config_file)
    assert expected_path_str in error_msg, (
        f"Error message should contain specific config path '{expected_path_str}'. "
        f"Got error: {error_msg}"
    )[0m
