[32mimport pytest
from pydantic import ValidationError
from metagpt.configs.llm_config import LLMConfig


def test_api_key_validation_error_shows_path():
    """Test that API key validation error includes the full config file path.
    
    Issue: Previously the error message was generic "Please set your API key in config2.yaml".
    Fix: Now it shows the full path like "/app/config/config2.yaml" or includes
    a warning about config file priority when multiple configs exist.
    """
    with pytest.raises(ValidationError) as exc_info:
        LLMConfig(api_key="YOUR_API_KEY")
    
    error_message = str(exc_info.value)
    
    # Verify that config2.yaml is mentioned in the error
    assert "config2.yaml" in error_message
    
    # After the fix, the error should either:
    # 1. Contain a full path (with / or \ before config2.yaml)
    # 2. Or contain the overwrite warning when both config files exist
    has_full_path = "/config2.yaml" in error_message or "\\config2.yaml" in error_message
    has_overwrite_warning = "If you also set your config in" in error_message
    
    assert has_full_path or has_overwrite_warning, (
        f"Expected error message to contain full path to config2.yaml or overwrite warning. "
        f"Got: {error_message}"
    )[0m
