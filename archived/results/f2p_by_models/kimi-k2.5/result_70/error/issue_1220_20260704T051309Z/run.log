[32mimport pytest
from pydantic import ValidationError
from metagpt.configs.llm_config import LLMConfig
from metagpt.const import METAGPT_ROOT, CONFIG_ROOT


def test_llm_config_api_key_validation_includes_file_path():
    """Test that ValidationError for placeholder API key includes specific config file paths.
    
    Regression test for issue #1220: The error message should indicate which specific
    config file needs the API key (e.g., /path/to/config/config2.yaml), not just a 
    generic "config2.yaml" message. This helps users identify which config file is 
    actually being read.
    """
    with pytest.raises(ValidationError) as exc_info:
        LLMConfig(api_key="YOUR_API_KEY")
    
    error_msg = str(exc_info.value)
    
    # The fixed version includes the full path to the config file(s)
    # The buggy version only says "Please set your API key in config2.yaml"
    repo_config_path = METAGPT_ROOT / "config/config2.yaml"
    root_config_path = CONFIG_ROOT / "config2.yaml"
    
    # Check if any of the specific path indicators are present in the error message
    has_path_info = (
        str(repo_config_path) in error_msg or
        str(root_config_path) in error_msg or
        "If you also set your config in" in error_msg
    )
    
    assert has_path_info, (
        f"Expected error message to include specific config file path, "
        f"but got generic message: {error_msg}"
    )[0m
