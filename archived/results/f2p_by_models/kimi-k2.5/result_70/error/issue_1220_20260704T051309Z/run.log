from pydantic import ValidationError
from metagpt.configs.llm_config import LLMConfig


def test_llm_config_api_key_validation_error_includes_path():
    """Test that the API key validation error includes the specific config file path.
    
    This is a regression test for issue #1220. The error message should indicate
    the specific path to config2.yaml (e.g., '/app/config/config2.yaml') rather 
    than just the generic filename 'config2.yaml'.
    """
    with pytest.raises(ValidationError) as exc_info:
        LLMConfig(api_key="YOUR_API_KEY")
    
    error_msg = str(exc_info.value)
    
    # The fixed version includes the specific path (e.g., /app/config/config2.yaml)
    # The buggy version only says "config2.yaml" without path information
    assert "config/config2.yaml" in error_msg, (
        f"Expected specific path 'config/config2.yaml' in error message, "
        f"but got: {error_msg}"
    )[0m
