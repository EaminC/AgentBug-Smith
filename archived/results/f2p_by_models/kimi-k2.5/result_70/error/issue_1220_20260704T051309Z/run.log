[32mimport pytest
from pydantic import ValidationError
from metagpt.configs.llm_config import LLMConfig
from metagpt.const import CONFIG_ROOT

def test_llm_config_api_key_error_shows_config_precedence():
    """Test that validation error for default API key shows config file precedence info.
    
    This tests the fix for issue #1220 where the error message was not helpful
    when the user had config files in multiple locations.
    """
    config_path = CONFIG_ROOT / "config2.yaml"
    
    # Store original state
    already_existed = config_path.exists()
    
    try:
        # Create the config file to trigger the detailed error branch in the fix
        if not already_existed:
            CONFIG_ROOT.mkdir(parents=True, exist_ok=True)
            config_path.touch()
        
        with pytest.raises(ValidationError) as exc_info:
            LLMConfig(api_key="YOUR_API_KEY")
        
        error_msg = str(exc_info.value)
        # Fixed version mentions precedence when CONFIG_ROOT/config2.yaml exists
        assert "will overwrite the latter" in error_msg, \
            f"Expected error message to mention config precedence, but got: {error_msg}"
            
    finally:
        # Cleanup: only remove if we created it
        if not already_existed and config_path.exists():
            config_path.unlink()[0m
