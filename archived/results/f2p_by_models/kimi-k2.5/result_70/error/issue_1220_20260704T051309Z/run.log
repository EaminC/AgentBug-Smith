[32mimport pytest
from pydantic import ValidationError

def test_placeholder_api_key_error_includes_full_path():
    """Test that placeholder API key validation error includes the full config file path.
    
    Issue #1220: The error message should specify the full path to config2.yaml
    rather than just saying "config2.yaml", to help users identify which config
    file needs to be updated.
    """
    from metagpt.configs.llm_config import LLMConfig
    
    with pytest.raises(ValidationError) as exc_info:
        LLMConfig(api_key="YOUR_API_KEY")
    
    error_message = str(exc_info.value)
    
    # Verify it's the right error type
    assert "api_key" in error_message
    assert "Please set your API key" in error_message
    
    # The fix adds the specific file path. Before the fix, the message was:
    # "Please set your API key in config2.yaml"
    # After the fix, it's something like:
    # "Please set your API key in /app/config/config2.yaml"
    
    # Check that the path includes the directory structure, not just filename
    # by looking for "/config/config2.yaml" or "\config\config2.yaml"
    has_full_path = (
        "/config/config2.yaml" in error_message or 
        "\\config\\config2.yaml" in error_message
    )
    
    assert has_full_path, (
        f"Expected error message to include full path to config file "
        f"(e.g., /path/to/config/config2.yaml), but got: {error_message}"
    )[0m
