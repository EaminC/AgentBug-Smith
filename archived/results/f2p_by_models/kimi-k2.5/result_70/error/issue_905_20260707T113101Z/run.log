[32mFROM python:3.11-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Install system dependencies and clean up in one layer to reduce image size
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    git \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build tools including setuptools (provides pkg_resources)
RUN pip install --upgrade pip wheel setuptools

# Copy the repository
COPY . .

# Install setuptools explicitly (provides pkg_resources which is imported by the code)
RUN pip install --no-cache-dir setuptools

# Install core dependencies first (these are the main runtime dependencies from pyproject.toml)
RUN pip install --no-cache-dir \
    appdirs \
    astor \
    git-python \
    inquirer \
    litellm \
    pyyaml \
    rich \
    six \
    tiktoken \
    tokentrim \
    wget \
    psutil \
    html2image \
    ipykernel \
    jupyter-client \
    matplotlib \
    toml \
    posthog \
    openai \
    sniffio

# Install test dependencies
RUN pip install --no-cache-dir \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-timeout

# Install the package in editable mode using pip (handles pyproject.toml)
# Using --no-deps to avoid re-resolving dependencies we already installed
RUN pip install -e . --no-deps 2>/dev/null || pip install -e .

# Ensure PYTHONPATH is set for imports (handles both src and root layouts)
ENV PYTHONPATH=/app

# Preflight check - verify the package can be imported
RUN python -c "import interpreter; print('preflight ok')" || \
    python -c "import sys; sys.path.insert(0, '.'); import interpreter; print('preflight ok')"

CMD ["/bin/bash"]
