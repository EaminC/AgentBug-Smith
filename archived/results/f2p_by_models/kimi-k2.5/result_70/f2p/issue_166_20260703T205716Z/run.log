[32m"""
Fail2pass test for Issue #166: Gemini Support

This test verifies that the GeminiModel class is properly integrated into the 
mle.model module and can be instantiated and used via load_model().
"""

import pytest

# This import will fail in the buggy state (before patch) because GeminiModel 
# and MODEL_GEMINI are not exported from mle.model
from mle.model import GeminiModel, load_model, MODEL_GEMINI


def test_gemini_model_exported():
    """Test that GeminiModel and MODEL_GEMINI are exported from mle.model"""
    assert GeminiModel is not None
    assert MODEL_GEMINI == 'Gemini'


def test_gemini_model_instantiation(mocker):
    """
    Test that GeminiModel can be instantiated.
    
    This requires mocking the google.generativeai dependency since it's not
    installed in the test environment.
    """
    # Create mocks for the google.generativeai module
    mock_gemini_module = mocker.MagicMock()
    mock_spec = mocker.MagicMock()
    
    # Mock importlib to simulate google-generativeai being available
    mocker.patch('importlib.util.find_spec', return_value=mock_spec)
    mocker.patch('importlib.import_module', return_value=mock_gemini_module)
    
    # Instantiate the model
    model = GeminiModel(api_key='test_api_key', model='gemini-1.5-flash')
    
    # Verify the model was configured correctly
    assert model.model == 'gemini-1.5-flash'
    assert model.model_type == 'Gemini'
    mock_gemini_module.configure.assert_called_once_with(api_key='test_api_key')


def test_load_model_with_gemini_platform(mocker):
    """
    Test that load_model returns a GeminiModel instance when platform is Gemini.
    """
    # Setup mocks for google.generativeai
    mock_gemini_module = mocker.MagicMock()
    mock_spec = mocker.MagicMock()
    
    mocker.patch('importlib.util.find_spec', return_value=mock_spec)
    mocker.patch('importlib.import_module', return_value=mock_gemini_module)
    
    # Mock get_config to return a Gemini configuration
    mock_config = {
        'platform': 'Gemini',
        'api_key': 'test_gemini_key',
        'model': 'gemini-pro'
    }
    mocker.patch('mle.model.get_config', return_value=mock_config)
    
    # Load the model
    model = load_model('.', model_name='gemini-pro', observable=False)
    
    # Verify we got a GeminiModel instance
    assert isinstance(model, GeminiModel)
    assert model.model == 'gemini-pro'


def test_gemini_model_query_method_exists(mocker):
