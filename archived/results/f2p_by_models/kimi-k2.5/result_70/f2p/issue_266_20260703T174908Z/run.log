def test_lancedb_memory_has_manage_api_methods():
    """Test that LanceDBMemory class has the required manage API methods.
    
    This test verifies that the following methods exist:
    - list_all_keys: to list all IDs in the memory table
    - get: to retrieve a record by ID  
    - get_by_metadata: to retrieve records by metadata
    - delete_by_metadata: to delete records by metadata
    """
    from mle.utils.memory import LanceDBMemory
    
    assert hasattr(LanceDBMemory, 'list_all_keys'), \
        "LanceDBMemory should have list_all_keys method"
    assert hasattr(LanceDBMemory, 'get'), \
        "LanceDBMemory should have get method"
    assert hasattr(LanceDBMemory, 'get_by_metadata'), \
        "LanceDBMemory should have get_by_metadata method"
    assert hasattr(LanceDBMemory, 'delete_by_metadata'), \
        "LanceDBMemory should have delete_by_metadata method"


def test_lancedb_memory_list_all_keys_functionality(monkeypatch):
    """Test that list_all_keys returns list of IDs using FTS search."""
    from mle.utils.memory import LanceDBMemory
    
    def mock_get_config(path):
        return {'platform': 'test'}
    monkeypatch.setattr('mle.utils.memory.get_config', mock_get_config)
    
    class MockTable:
        def search(self, query_type=None):
            return self
        def to_list(self):
            return [{'id': 'key1'}, {'id': 'key2'}]
        def create_fts_index(self, col):
            pass
        def add(self, data):
            pass
    
    class MockClient:
        def table_names(self):
            return []
        def create_table(self, name, data):
            return MockTable()
        def open_table(self, name):
            return MockTable()
    
    class MockLanceDB:
        @staticmethod
        def connect(uri):
            return MockClient()
    
    monkeypatch.setattr('mle.utils.memory.lancedb', MockLanceDB())
    
    class MockEmbedFunc:
        def create(self):
            return lambda texts: [[0.1] * 384 for _ in texts]
    
    class MockRegistry:
        def get(self, name):
            return MockEmbedFunc()
    
    monkeypatch.setattr('mle.utils.memory.get_registry', lambda: MockRegistry())
    
    mem = LanceDBMemory("/tmp/test")
    mem.add([{"text": "test", "metadata": {}}])
    
    result = mem.list_all_keys()
    assert isinstance(result, list)
    assert 'key1' in result
    assert 'key2' in result


