WORKDIR /app

# --- Environment Variables for Forge API ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"

# --- System Dependencies ---
# Update package lists
RUN apt-get update

# Install build tools
RUN apt-get install -y --no-install-recommends build-essential gcc g++

# Install libraries needed for Python packages
RUN apt-get install -y --no-install-recommends libxml2-dev libxslt1-dev python3-dev

# Install git and curl
RUN apt-get install -y --no-install-recommends git curl

# Clean up apt cache
RUN apt-get clean && rm -rf /var/lib/apt/lists/*

# --- Python Setup ---
# Upgrade pip and install wheel
RUN pip install --no-cache-dir --upgrade pip wheel setuptools

# Copy entire repository
COPY . .

# Install crewai core package
RUN pip install --no-cache-dir -e lib/crewai

# Install crewai-tools
RUN pip install --no-cache-dir -e lib/crewai-tools

# Install devtools
RUN pip install --no-cache-dir -e lib/devtools

# Install test dependencies
RUN pip install --no-cache-dir \
    "pytest>=8.4.2" \
    "pytest-asyncio>=1.2.0" \
    "pytest-subprocess>=1.5.3" \
    "pytest-randomly>=4.0.1" \
    "pytest-timeout>=2.4.0" \
    "pytest-xdist>=3.8.0" \
    "pytest-split>=0.10.0" \
    "pytest-mock>=3.14.0" \
    "pytest-cov>=4.1.0" \
    "vcrpy==7.0.0" \
    "pytest-recording>=0.13.4" \
    "setuptools<=81.0.0" \
    "litellm>=1.74.9" \
    "mem0ai>=0.1.94"

# Install lxml for crewai-tools (pinned version)
RUN pip install --no-cache-dir "lxml>=5.3.0,<5.4.0"

# Set PYTHONPATH to include all source directories
ENV PYTHONPATH=/app/lib/crewai/src:/app/lib/crewai-tools/src:/app/lib/devtools/src

# Pre-flight check to verify installation
RUN python -c "import crewai; print('crewai version:', crewai.__version__)" && \
    python -c "import crewai_tools; print('crewai-tools imported successfully')" && \
    python -c "import pytest; print('pytest imported successfully')" && \
    echo "preflight ok"

# Default command
CMD ["/bin/bash"]
