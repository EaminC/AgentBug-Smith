[32m# CrewAI Environment Dockerfile with Forge API Configuration
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Install system dependencies and Python packages in a single layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential gcc g++ git curl \
        libxml2-dev libxslt1-dev python3-dev && \
    rm -rf /var/lib/apt/lists/* && \
    pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0"

# Copy entire repository
COPY . .

# Install Python dependencies and test tools
# Using --break-system-packages since we're in a container
RUN pip install --no-cache-dir --break-system-packages \
    pytest>=8.4.2 \
    pytest-asyncio>=1.2.0 \
    pytest-subprocess>=1.5.3 \
    pytest-randomly>=4.0.1 \
    pytest-timeout>=2.4.0 \
    pytest-xdist>=3.8.0 \
    pytest-split>=0.10.0 \
    pytest-mock>=3.14.0 \
    pytest-cov>=4.1.0 \
    vcrpy==7.0.0 \
    pytest-recording>=0.13.4 \
    litellm>=1.74.9 \
    mem0ai>=0.1.94 \
    "lxml>=5.3.0,<5.4.0"

# Install crewai package (main package)
RUN if [ -f "lib/crewai/pyproject.toml" ]; then \
        pip install --no-cache-dir --break-system-packages -e lib/crewai; \
    fi

# Install crewai-tools package
RUN if [ -f "lib/crewai-tools/pyproject.toml" ]; then \
        pip install --no-cache-dir --break-system-packages -e lib/crewai-tools; \
    fi

# Install devtools package
RUN if [ -f "lib/devtools/pyproject.toml" ]; then \
        pip install --no-cache-dir --break-system-packages -e lib/devtools; \
    fi

# Set PYTHONPATH for src layout
ENV PYTHONPATH=/app/lib/crewai/src:/app/lib/crewai-tools/src:/app/lib/devtools/src

# Additional Environment Variables for Forge API
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"

# Pre-flight check - verify key packages are importable
RUN python -c "import crewai; print('crewai:', crewai.__version__)" && \
    python -c "import crewai_tools; print('crewai-tools: ok')" && \
    python -c "import pytest; print('pytest:', pytest.__version__)" && \
    python -c "import litellm; print('litellm: ok')" && \
    echo "preflight ok"

CMD ["/bin/bash"]
