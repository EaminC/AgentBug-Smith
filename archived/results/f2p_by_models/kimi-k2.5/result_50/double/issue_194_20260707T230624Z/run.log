[32m# Use Python 3.12 slim as base
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Configure apt for reliability with retries and timeouts
RUN echo 'Acquire::Retries "10";' > /etc/apt/apt.conf.d/80-retries && \
    echo 'Acquire::http::Timeout "180";' >> /etc/apt/apt.conf.d/80-retries && \
    echo 'Acquire::https::Timeout "180";' >> /etc/apt/apt.conf.d/80-retries

# Install system dependencies with robust retry logic
RUN set -eux; \
    attempt=1; max_attempts=6; \
    while [ $attempt -le $max_attempts ]; do \
        echo "=== Attempt $attempt of $max_attempts ==="; \
        apt-get clean && rm -rf /var/lib/apt/lists/*; \
        apt-get update && \
        apt-get install -y --no-install-recommends \
            gcc \
            g++ \
            libxml2-dev \
            libxslt1-dev \
            python3-dev \
            git \
            build-essential \
            ca-certificates \
            && { echo "Success on attempt $attempt"; break; }; \
        echo "Attempt $attempt failed, waiting..."; \
        sleep $((attempt * 10)); \
        attempt=$((attempt + 1)); \
    done; \
    if [ $attempt -gt $max_attempts ]; then \
        echo "ERROR: Failed to install after $max_attempts attempts"; \
        exit 1; \
    fi; \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build tools
RUN pip install --no-cache-dir --upgrade pip wheel setuptools

# Copy the repository first to check for requirements
COPY . .

# Install dependencies and project
# For src/ layout: set PYTHONPATH instead of pip install -e .
RUN if [ -f "requirements.txt" ]; then \
        pip install --no-cache-dir -r requirements.txt; \
    fi && \
    pip install --no-cache-dir \
        pytest \
        pytest-mock \
        pytest-asyncio \
        pytest-cov \
        pytest-xdist \
        pytest-timeout \
        "setuptools<=81.0.0" \
        litellm \
        mem0ai

# Set PYTHONPATH for src layout - this allows importing agentscope without editable install
ENV PYTHONPATH=/app/src

# Verify critical imports
RUN python -c "import sys; print('Python path:', sys.path)" && \
    python -c "import agentscope; print('agentscope version:', agentscope.__version__)" && \
    python -c "import pytest; print('pytest version:', pytest.__version__)"

# Default command
CMD ["/bin/bash"]
