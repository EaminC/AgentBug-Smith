[32m# -*- coding: utf-8 -*-
"""
Fail2pass test for issue 194: memory module load function should convert 
dict to Msg objects instead of keeping them as dicts.
"""

import unittest
import os
import json

from agentscope.memory import TemporaryMemory
from agentscope.message import Msg, MessageBase


class TemporaryMemoryFail2PassTest(unittest.TestCase):
    """
    Test cases to verify that memory.load() and memory.add() convert 
    dict objects to Msg/MessageBase objects.
    """

    def setUp(self) -> None:
        self.memory = TemporaryMemory()
        self.test_file = "test_memory_load_194.json"

    def tearDown(self) -> None:
        if os.path.exists(self.test_file):
            os.remove(self.test_file)

    def test_load_list_of_dicts_converts_to_msg(self) -> None:
        """
        Test that loading a list of dicts converts them to Msg objects.
        Before fix: dicts remain dicts -> isinstance check fails.
        After fix: dicts converted to Msg -> isinstance check passes.
        """
        dict_data = [
            {"name": "user", "content": "Hello"},
            {"name": "agent", "content": "How can I help?"},
        ]
        
        self.memory.load(dict_data)
        memories = self.memory.get_memory()
        
        self.assertEqual(len(memories), 2)
        for mem in memories:
            # This assertion fails before the fix (mem is dict)
            # and passes after the fix (mem is Msg)
            self.assertIsInstance(mem, MessageBase)
            self.assertIsInstance(mem, Msg)

    def test_load_from_json_file_converts_to_msg(self) -> None:
        """
        Test that loading from a JSON file converts dicts to Msg objects.
        """
        dict_data = [{"name": "user", "content": "Hello from file"}]
        with open(self.test_file, "w", encoding="utf-8") as f:
            json.dump(dict_data, f)
        
        self.memory.load(self.test_file)
        memories = self.memory.get_memory()
        
        self.assertEqual(len(memories), 1)
        # Before fix: memories[0] is a dict -> fails
        # After fix: memories[0] is a Msg -> passes
        self.assertIsInstance(memories[0], MessageBase)
        self.assertIsInstance(memories[0], Msg)

    def test_add_dict_converts_to_msg(self) -> None:
        """
        Test that adding a dict converts it to a Msg object.
        """
        dict_msg = {"name": "user", "content": "Test message"}
        self.memory.add(dict_msg)
        
        memories = self.memory.get_memory()
        self.assertEqual(len(memories), 1)
        # Before fix: memories[0] is dict -> isinstance fails
        # After fix: memories[0] is Msg -> isinstance passes
        self.assertIsInstance(memories[0], MessageBase)
        self.assertIsInstance(memories[0], Msg)


if __name__ == "__main__":
    unittest.main()[0m
