[32m# -*- coding: utf-8 -*-
"""
Fail2pass test for issue #194: memory.load() should convert dicts to Msg objects
"""

import unittest
import os
import json

from agentscope.memory import TemporaryMemory
from agentscope.message import MessageBase


class MemoryLoadMsgConversionTest(unittest.TestCase):
    """
    Test that memory.load() converts dict inputs to MessageBase objects.
    Issue #194: load function loading json file/list[dict] was storing dicts
    instead of Msg objects, causing errors in Agent reply.
    """

    def setUp(self) -> None:
        self.memory = TemporaryMemory()
        self.test_file = "test_memory_194.json"

    def tearDown(self) -> None:
        if os.path.exists(self.test_file):
            os.remove(self.test_file)

    def test_load_list_of_dicts_converts_to_msg(self) -> None:
        """
        Test that loading a list of dicts results in MessageBase objects,
        not plain dicts.
        """
        # Input data as dicts (simulating loaded JSON)
        dict_memories = [
            {"name": "user", "content": "Hello", "role": "user"},
            {"name": "assistant", "content": "World", "role": "assistant"},
        ]
        
        # Load dicts into memory
        self.memory.load(dict_memories)
        
        # Retrieve memory
        retrieved = self.memory.get_memory()
        
        # Should have 2 items
        self.assertEqual(len(retrieved), 2)
        
        # Key assertion: items should be MessageBase instances, not dicts
        # Before fix: isinstance(retrieved[0], MessageBase) is False
        # After fix: isinstance(retrieved[0], MessageBase) is True
        for item in retrieved:
            self.assertIsInstance(
                item, 
                MessageBase,
                f"Expected MessageBase instance, got {type(item)}"
            )
            self.assertNotIsInstance(
                item,
                dict,
                "Item should not be a plain dict after loading"
            )

    def test_load_from_json_file_converts_to_msg(self) -> None:
        """
        Test that loading from a JSON file containing dicts converts them
        to MessageBase objects.
        """
        # Create JSON file
        data = [{"name": "user", "content": "Test", "role": "user"}]
        with open(self.test_file, "w", encoding="utf-8") as f:
            json.dump(data, f)
        
        # Load from file
        self.memory.load(self.test_file)
        
        # Check result
        mem = self.memory.get_memory()
        self.assertEqual(len(mem), 1)
        self.assertIsInstance(mem[0], MessageBase)
        self.assertNotIsInstance(mem[0], dict)


if __name__ == "__main__":
