    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Set Forge API environment variables for OpenAI SDK compatibility
# The older OpenAI SDK (v0.27.8) uses OPENAI_API_BASE
# Newer SDKs and langchain use OPENAI_BASE_URL
