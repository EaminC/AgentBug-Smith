[32m# AgentScope Multi-Agent Platform Dockerfile
# Configured for Forge API compatibility

FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies with retry logic for network issues
RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    (for i in 1 2 3; do \
        apt-get update --fix-missing && break || \
        (echo "Retry $i/3..." && sleep 5); \
    done) && \
    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        libxml2-dev \
        libxslt1-dev \
        python3-dev \
        git \
        ca-certificates \
        && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build tools
RUN python -m pip install --upgrade pip wheel setuptools

# Copy the entire repository
COPY . .

# Using src/ layout, so we set PYTHONPATH appropriately
ENV PYTHONPATH=/app/src

# Install Python dependencies in groups for better error isolation
# Group 1: Core dependencies
RUN pip install --no-cache-dir \
    aioitertools \
    anthropic \
    dashscope \
    docstring_parser \
    json5 \
    json_repair \
    "mcp>=1.13" \
    numpy \
    openai \
    python-datauri \
    "opentelemetry-api>=1.39.0" \
    "opentelemetry-sdk>=1.39.0" \
    "opentelemetry-exporter-otlp>=1.39.0" \
    "opentelemetry-semantic-conventions>=0.60b0" \
    python-socketio \
    shortuuid \
    tiktoken \
    sounddevice \
    sqlalchemy \
    python-frontmatter \
    aiofiles \
    requests \
    websockets \
    scipy \
    Pillow \
    transformers \
    jinja2 \
    nltk

# Group 2: Document processing and data
RUN pip install --no-cache-dir \
    "pypdf<=6.5.0" \
    python-docx \
    pandas \
    openpyxl \
    python-pptx

# Group 3: Vector stores and databases
RUN pip install --no-cache-dir \
    redis \
    "mem0ai<=1.0.3" \
    packaging \
    "reme-ai>=0.2.0.3" \
    fakeredis \
    aiosqlite \
    greenlet \
    "qdrant-client==1.15.1" \
    "pymilvus[milvus_lite]" \
    mysql-connector-python \
    pymongo \
    "pyobvector>=0.2.0,<0.3.0" \
    ray

# Group 4: Testing and utility dependencies
RUN pip install --no-cache-dir \
    pytest \
    pytest-forked \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-timeout \
    "setuptools<=81.0.0" \
    litellm \
    anyio \
    httpx \
    google-genai \
    "ollama>=0.5.4"

# Install a2a-sdk and other optional dependencies
RUN pip install --no-cache-dir a2a-sdk httpx "nacos-sdk-python>=3.0.0" || true

# Pre-flight check to ensure core imports work
RUN python -c "import sys; sys.path.insert(0, 'src'); import agentscope; print('agentscope import ok')" && \
    python -c "import pytest; print('pytest ok')" && \
    python -c "import openai; print('openai ok')" && \
    python -c "import anthropic; print('anthropic ok')" && \
    python -c "import requests; print('requests ok')"

# Forge API environment variables
# These override default API endpoints to use Forge API
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional model configuration
ENV MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Default shell
CMD ["/bin/bash"]
