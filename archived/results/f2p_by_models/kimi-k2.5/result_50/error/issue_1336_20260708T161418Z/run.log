    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        libxml2-dev \
        libxslt1-dev \
        python3-dev \
        git \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build tools
RUN python -m pip install --upgrade pip wheel setuptools

# Copy the entire repository
COPY . .

# Install project dependencies
# Install core dependencies first
RUN pip install \
    aioitertools \
    anthropic \
    dashscope \
    docstring_parser \
    json5 \
    json_repair \
    "mcp>=1.13" \
    numpy \
    openai \
    python-datauri \
    "opentelemetry-api>=1.39.0" \
    "opentelemetry-sdk>=1.39.0" \
    "opentelemetry-exporter-otlp>=1.39.0" \
    "opentelemetry-semantic-conventions>=0.60b0" \
    python-socketio \
    shortuuid \
    tiktoken \
    sounddevice \
    sqlalchemy \
    python-frontmatter \
    aiofiles \
    websockets \
    scipy \
    google-genai \
    "ollama>=0.5.4" \
    Pillow \
    transformers \
    jinja2 \
    redis \
    "mem0ai<=1.0.3" \
    packaging \
    "reme-ai>=0.2.0.3" \
    nltk \
    "pypdf<=6.5.0" \
    python-docx \
    pandas \
    openpyxl \
    python-pptx \
    "qdrant-client==1.15.1" \
    "pymilvus[milvus_lite]" \
    mysql-connector-python \
    pymongo \
    "pyobvector>=0.2.0,<0.3.0" \
    ray

# Install A2A dependencies
RUN pip install \
    a2a-sdk \
    httpx \
    "nacos-sdk-python>=3.0.0"

# Install development and test dependencies
RUN pip install \
    pytest \
    pytest-forked \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    anyio \
    "setuptools<=81.0.0" \
    litellm \
    fakeredis \
    aiosqlite \
    greenlet \
    pre-commit \
    sphinx-gallery \
    furo \
    myst_parser \
    matplotlib \
    py-openjudge \
    pytest-timeout \
    pytest-xdist

# The project uses src/ layout, set PYTHONPATH accordingly
ENV PYTHONPATH=/app/src:$PYTHONPATH

# Preflight check
RUN python -c "import pytest; print('pytest ok')" && \
    python -c "import agentscope; print('agentscope import ok')" || echo "agentscope import skipped (src layout)"

# Default command
CMD ["/bin/bash"]
