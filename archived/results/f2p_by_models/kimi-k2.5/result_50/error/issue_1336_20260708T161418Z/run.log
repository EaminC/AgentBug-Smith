[32m"""Test for issue 1336: _to_openai_image_url raises TypeError for local files without extension."""
import os
import tempfile
import base64
from agentscope.formatter._openai_formatter import _to_openai_image_url


def test_local_image_without_extension_png():
    """Test that _to_openai_image_url handles local PNG files without extension."""
    # Create a minimal valid PNG file without extension
    # PNG magic number: 89 50 4E 47 0D 0A 1A 0A
    png_header = b'\x89PNG\r\n\x1a\n'
    # Minimal PNG structure: IHDR chunk (13 bytes data)
    # Width: 1, Height: 1, Bit depth: 8, Color type: 0 (grayscale)
    ihdr_data = b'\x00\x00\x00\x01\x00\x00\x00\x01\x08\x00\x00\x00\x00'
    # IHDR chunk: length (4) + type (4) + data (13) + CRC (4)
    ihdr_chunk = b'\x00\x00\x00\x0dIHDR' + ihdr_data + b'\x1f\x15\xc4\x89'
    # IEND chunk
    iend_chunk = b'\x00\x00\x00\x00IEND\xaeB`\x82'
    
    png_content = png_header + ihdr_chunk + iend_chunk
    
    with tempfile.NamedTemporaryFile(delete=False, suffix='') as tmp:
        tmp.write(png_content)
        tmp_path = tmp.name
    
    try:
        # This should not raise TypeError in the fixed version
        result = _to_openai_image_url(tmp_path)
        
        # Verify the result is a data URI with correct mime type
        assert isinstance(result, str)
        assert result.startswith("data:image/png;base64,")
        
        # Verify we can decode the base64 content and it matches original
        b64_part = result.split(',')[1]
        decoded = base64.b64decode(b64_part)
        assert decoded.startswith(b'\x89PNG')
    finally:
        os.unlink(tmp_path)


def test_local_image_without_extension_jpeg():
    """Test that _to_openai_image_url handles local JPEG files without extension."""
    # JPEG magic number: FF D8 FF
    # Minimal JPEG: SOI + APP0 marker + EOI
    jpeg_content = b'\xff\xd8\xff\xe0\x00\x10JFIF\x00\x01\x01\x00\x00\x01\x00\x01\x00\x00\xff\xd9'
    
    with tempfile.NamedTemporaryFile(delete=False, suffix='') as tmp:
        tmp.write(jpeg_content)
        tmp_path = tmp.name
    
    try:
        result = _to_openai_image_url(tmp_path)
        
        assert isinstance(result, str)
        assert result.startswith("data:image/jpeg;base64,")
        
        b64_part = result.split(',')[1]
        decoded = base64.b64decode(b64_part)
        assert decoded.startswith(b'\xff\xd8\xff')
    finally:
        os.unlink(tmp_path)[0m
