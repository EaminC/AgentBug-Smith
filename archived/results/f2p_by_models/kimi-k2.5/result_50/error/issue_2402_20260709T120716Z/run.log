# Configured to use Forge API instead of OpenAI API

FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install system dependencies required for building Python packages
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build tools
RUN python -m pip install --upgrade pip wheel

# Set environment variables for Forge API (OpenAI-compatible)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Additional AI configuration
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

# Copy the entire repository
COPY . .

# Install CrewAI core framework explicitly (as per ecosystem pre-emption rule)
RUN pip install "crewai>=0.117.0"

# Install the project and its dependencies
# Using --break-system-packages for PEP 668 compliance in container environment
RUN pip install --break-system-packages -e .

# Install optional dependencies for full functionality
RUN pip install --break-system-packages "crewai-tools~=0.42.2" || true
RUN pip install --break-system-packages "mem0ai>=0.1.94" || true

# Install test dependencies explicitly (ensuring pytest and related tools are available)
RUN pip install --break-system-packages \
    pytest>=8.0.0 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
    pytest-recording>=0.13.2 \
    pytest-mock \
    pytest-xdist \
    pytest-timeout \
    pytest-cov \
    "setuptools<=81.0.0" \
    litellm \
    python-dotenv

# Install additional dependencies that may be needed
RUN pip install --break-system-packages \
    chromadb>=0.5.23 \
    instructor>=1.3.3 \
    pydantic>=2.4.2 \
    openai>=1.13.3

# Preflight check to ensure key imports work
RUN python -c "import crewai; import pytest; import litellm; print('preflight ok')"

# Set Python path to include src for test imports
ENV PYTHONPATH=/app/src:$PYTHONPATH

# Default command
CMD ["/bin/bash"]
