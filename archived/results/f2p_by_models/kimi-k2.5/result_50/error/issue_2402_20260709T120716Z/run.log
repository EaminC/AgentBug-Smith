    ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5" \
    MODEL="tuzi-kimi-k2.5/kimi-k2.5" \
    AI_TEMPERATURE="0.7" \
    AI_MAX_TOKENS="1000" \
    AI_TOP_P="1" \
    TAVILY_API_KEY="tvly-dev-key" \
    GITHUB_TOKEN="ghp_key" \
    PYTHONPATH=/app/src \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Copy entire repository (needed for tests)
COPY . .

# Copy wheels from builder and install
COPY --from=builder /wheels /wheels

# Install runtime dependencies and wheels
RUN pip install --no-cache-dir --break-system-packages \
    pytest \
    pytest-asyncio \
    pytest-mock \
    pytest-timeout \
    "setuptools<=81.0.0" \
    litellm \
    python-dotenv \
    pydantic \
    openai \
    /wheels/* && \
    rm -rf /wheels /root/.cache/pip /tmp/* /var/tmp/*

