ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"

# Python configuration
ENV PYTHONPATH=/app/src
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies and Python packages in a single layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        python3-dev \
        libxml2-dev \
        libxslt1-dev \
        && \
    pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy dependency files first for better caching
COPY pyproject.toml .
COPY uv.lock* ./

# Copy source code
COPY src/ ./src/

# Install Python dependencies and the project
RUN pip install --no-cache-dir \
        pytest \
        pytest-asyncio \
        pytest-mock \
        pytest-timeout \
        pytest-xdist \
        pytest-cov \
        anyio \
        litellm \
        mem0ai \
        openai \
        anthropic && \
    pip install --no-cache-dir -e . && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Copy remaining files (tests, configs)
COPY tests/ ./tests/
COPY *.toml *.yml *.yaml ./

# Final cleanup
RUN find /app -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true && \
    find /app -type d -name "*.egg-info" -exec rm -rf {} + 2>/dev/null || true

# Verify installation
RUN python -c "import crewai; print(f'crewai {crewai.__version__} installed')" && \
    python -c "import pytest; print('pytest available')"

CMD ["/bin/bash"]
