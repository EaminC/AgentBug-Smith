ENV PYTHONPATH=/app/src:$PYTHONPATH

# Preflight verification - single layer, no cache
RUN python -c "import crewai; import pytest; import litellm; print('preflight ok')" && \
    python -c "import sys; print(f'Python: {sys.version}')"

