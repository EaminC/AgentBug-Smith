RUN pip install --no-cache-dir --break-system-packages -e . && \
    pip install --no-cache-dir --break-system-packages \
    pytest>=8.0.0 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
    pytest-recording>=0.13.2 \
    pytest-mock \
