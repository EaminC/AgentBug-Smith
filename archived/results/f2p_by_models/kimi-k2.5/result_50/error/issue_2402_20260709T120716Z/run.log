    gcc \
    g++ \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and wheel
RUN pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0"

# Copy entire repository
COPY . .

# Install crewai with dependencies based on pyproject.toml
# Using src/ layout so set PYTHONPATH instead of pip install -e .
RUN pip install --no-cache-dir \
    pydantic>=2.4.2 \
    openai>=1.13.3 \
    "litellm==1.67.2" \
    instructor>=1.3.3 \
    pdfplumber>=0.11.4 \
    regex>=2024.9.11 \
    opentelemetry-api>=1.30.0 \
    opentelemetry-sdk>=1.30.0 \
    opentelemetry-exporter-otlp-proto-http>=1.30.0 \
    chromadb>=0.5.23 \
    openpyxl>=3.1.5 \
    pyvis>=0.3.2 \
    auth0-python>=4.7.1 \
    python-dotenv>=1.0.0 \
    click>=8.1.7 \
    appdirs>=1.4.4 \
    jsonref>=1.1.0 \
    json-repair>=0.25.2 \
    uv>=0.4.25 \
    tomli-w>=1.1.0 \
    tomli>=2.0.2 \
    blinker>=1.9.0 \
    json5>=0.10.0

# Install test dependencies
RUN pip install --no-cache-dir \
    pytest>=8.0.0 \
    pytest-asyncio>=0.23.7 \
    pytest-mock \
    pytest-timeout \
    pytest-xdist \
    pytest-cov \
    pytest-subprocess>=1.5.2 \
    pytest-recording>=0.13.2 \
    anyio \
    mem0ai>=0.1.94 \
    anthropic \
    hatchling

# Pre-install crewai-tools if available
RUN pip install --no-cache-dir "crewai-tools~=0.42.2" || true

# Verify Python environment
RUN python -c "import sys; print(f'Python: {sys.version}')" && \
    python -c "import pytest; print('pytest available')" && \
    python -c "import openai; print('openai available')" && \
    python -c "import anthropic; print('anthropic available')" && \
    python -c "import litellm; print('litellm available')"

