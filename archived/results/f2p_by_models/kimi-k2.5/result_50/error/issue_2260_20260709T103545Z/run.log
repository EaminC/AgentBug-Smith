# Install the project dependencies from pyproject.toml
# Using pip install with src/ layout: set PYTHONPATH instead of editable install
RUN pip install -e . || true

# Install test dependencies explicitly (pytest and related packages)
RUN pip install pytest>=8.0.0 \
    pytest-vcr>=1.0.2 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
    pytest-mock \
    pytest-xdist \
    pytest-timeout \
    pytest-cov \
    "setuptools<=81.0.0" \
    litellm \
    mem0ai>=0.1.29 \
    python-dotenv>=1.0.0

# Install optional dependencies that may be needed for tests
RUN pip install crewai-tools>=0.37.0 || true
RUN pip install tiktoken~=0.7.0 || true
RUN pip install pandas>=2.2.3 || true

# Set PYTHONPATH for src/ layout to ensure imports work correctly
ENV PYTHONPATH=/app/src:/app

# Verify installation by importing key modules
RUN python -c "import crewai; print('crewai imported successfully')" && \
