    AI_FREQUENCY_PENALTY="0" \
    AI_PRESENCE_PENALTY="0" \
    OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY="forge-key" \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1" \
    ANTHROPIC_AUTH_TOKEN="forge-key" \
    ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5" \
    ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5" \
    TAVILY_API_KEY="tvly-dev-key" \
    GITHUB_TOKEN="ghp_key"

WORKDIR /app

# Single combined RUN for system deps and Python setup to minimize layers
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libxml2-dev libxslt1-dev python3-dev git ca-certificates \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && python -m pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" \
    && pip install --no-cache-dir pytest pytest-asyncio pytest-cov pytest-mock pytest-xdist pytest-timeout litellm mem0ai anyio

# Copy repository
COPY . .

# Install dependencies and project in minimal steps
RUN if [ -f "requirements.txt" ]; then \
        pip install --no-cache-dir -r requirements.txt 2>/dev/null || true; \
    fi \
    && pip install --no-cache-dir -e . 2>/dev/null || true \
    && pip install --no-cache-dir spacy 2>/dev/null || true \
    && python -m spacy download en_core_web_sm 2>/dev/null || true

# Final cleanup in same layer to reduce size
RUN find /app -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true \
    && find /app -type f -name "*.pyc" -delete 2>/dev/null || true \
    && find /root -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true \
    && pip cache purge 2>/dev/null || true

# Preflight check
RUN python -c "import sys; print(f'Python {sys.version}'); print('preflight ok')"

CMD ["/bin/bash"]
