ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

# Python environment settings
ENV PIP_NO_CACHE_DIR=yes
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH="$PATH:/root/.local/bin"

# Set working directory
WORKDIR /app

# Copy the entire repository
COPY . .

# Install dependencies from requirements.txt if it exists
RUN if [ -f "requirements.txt" ]; then \
        pip install --no-cache-dir -r requirements.txt; \
    fi

# Install the project in editable mode
RUN pip install -e .

# Install additional test dependencies that might be needed
RUN pip install --no-cache-dir \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    pytest-benchmark \
    pytest-integration \
    pytest-recording \
    asynctest \
    vcrpy \
    "setuptools<=81.0.0" \
    litellm \
    mem0ai

# Create data directory if it doesn't exist
RUN mkdir -p /app/data

# Verify installation
RUN python -c "import pkg_resources; print('preflight ok')"

# Final command to start bash shell
CMD ["/bin/bash"]
