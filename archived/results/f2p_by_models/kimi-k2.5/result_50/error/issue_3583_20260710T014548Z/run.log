    PIP_NO_CACHE_DIR="1" \
    PIP_DISABLE_PIP_VERSION_CHECK="1" \
    PYTHONPATH="/app"

WORKDIR /app

# Install system dependencies in a single layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    libffi-dev \
    libssl-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build dependencies
RUN pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0"

# Install test dependencies
RUN pip install --no-cache-dir \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    pytest-benchmark \
    pytest-integration \
    asynctest \
    anyio \
    litellm \
    mem0ai

# Copy requirements first for better caching
COPY requirements.txt ./

# Install requirements in smaller chunks to avoid memory issues
RUN pip install --no-cache-dir beautifulsoup4 colorama distro openai==0.27.2 \
    playsound python-dotenv pyyaml PyPDF2 python-docx markdown pylatexenc \
    readability-lxml requests tiktoken gTTS docker duckduckgo-search==3.0.2 \
    google-api-python-client pinecone-client==2.2.1 redis orjson Pillow \
    selenium webdriver-manager jsonschema click charset-normalizer

# Install spacy separately (can be memory intensive)
RUN pip install --no-cache-dir "spacy>=3.0.0,<4.0.0" && \
    pip install --no-cache-dir https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.5.0/en_core_web_sm-3.5.0-py3-none-any.whl

# Install gitpython and other dependencies
RUN pip install --no-cache-dir gitpython openapi-python-client coverage flake8 pre-commit black isort mkdocs pymdown-extensions mypy

# Copy the entire repository
COPY . .

# Install the project itself using pip (handles both setup.py and pyproject.toml)
RUN pip install --no-cache-dir -e . || echo "Note: pip install -e . had issues, continuing with PYTHONPATH"

# Verify critical imports work
RUN python -c "import sys; print('Python:', sys.version)" && \
    python -c "import autogpt; print('autogpt imported successfully')" || echo "autogpt import test skipped"

# Cleanup
RUN apt-get purge -y --auto-remove gcc g++ 2>/dev/null || true && \
    apt-get autoremove -y 2>/dev/null || true && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /root/.cache/pip

CMD ["/bin/bash"]
