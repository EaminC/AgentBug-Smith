RUN if [ -f "forge/pyproject.toml" ]; then \
        cd forge && poetry install --no-interaction --no-ansi --no-root && cd ..; \
    fi

# Install autogpt (depends on forge and benchmark)
RUN if [ -f "autogpt/pyproject.toml" ]; then \
        cd autogpt && poetry install --no-interaction --no-ansi --no-root --all-extras && cd ..; \
    fi

# Also install via pip as fallback to ensure packages are importable
RUN pip install --no-cache-dir -e ./benchmark 2>/dev/null || true
RUN pip install --no-cache-dir -e ./forge 2>/dev/null || true
RUN pip install --no-cache-dir -e ./autogpt 2>/dev/null || true

# Install test dependencies explicitly
RUN pip install --no-cache-dir \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    pytest-benchmark \
    pytest-recording \
    litellm \
    anyio \
    vcrpy \
    mock \
    asynctest \
    coverage

# Verify installations
RUN python -c "import sys; print('Python:', sys.version)" && \
    python -c "import pytest; print('pytest:', pytest.__version__)" && \
    python -c "import forge; print('forge imported successfully')" 2>/dev/null || echo "forge import skipped" && \
    python -c "import autogpt; print('autogpt imported successfully')" 2>/dev/null || echo "autogpt import skipped"

# Default command
CMD ["/bin/bash"]
