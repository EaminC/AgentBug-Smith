    && cd /app/forge && poetry export --without-hashes -f requirements.txt -o requirements.txt --with dev 2>/dev/null || true \
    && pip install --no-cache-dir -e /app/forge 2>/dev/null || pip install --no-cache-dir -e /app/forge --break-system-packages 2>/dev/null || echo "forge pip install failed, trying poetry" \
    && cd /app/autogpt && poetry export --without-hashes -f requirements.txt -o requirements.txt --with dev 2>/dev/null || true \
