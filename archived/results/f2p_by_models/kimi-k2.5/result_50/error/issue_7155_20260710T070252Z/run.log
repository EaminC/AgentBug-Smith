    PYTHONPATH="/app:/app/autogpt:/app/forge:/app/benchmark"

# Quick verification
RUN python -c "import sys; print('Python:', sys.version)" \
    && python -c "import pytest; print('pytest:', pytest.__version__)" \
    && python -c "import requests; print('requests:', requests.__version__)" \
    && python -c "import os, sys; print('PYTHONPATH:', os.environ.get('PYTHONPATH', 'Not set'))"

# Default command
CMD ["/bin/bash"]
