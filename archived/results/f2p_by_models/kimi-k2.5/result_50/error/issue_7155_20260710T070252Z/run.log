# Install Poetry
RUN pip install poetry

# Copy the entire repository
COPY . .

# Install dependencies from all sub-projects
# First, install forge (base dependency)
RUN if [ -f "forge/pyproject.toml" ]; then \
        cd forge && poetry install --no-interaction --no-ansi && cd ..; \
    fi

# Install benchmark (optional dependency)
RUN if [ -f "benchmark/pyproject.toml" ]; then \
        cd benchmark && poetry install --no-interaction --no-ansi && cd ..; \
    fi

# Install autogpt (main package) with all extras
RUN if [ -f "autogpt/pyproject.toml" ]; then \
        cd autogpt && poetry install --no-interaction --no-ansi --all-extras && cd ..; \
    fi

# Also try pip install as fallback for all packages
RUN if [ -f "forge/pyproject.toml" ]; then \
        pip install -e ./forge || true; \
    fi

RUN if [ -f "benchmark/pyproject.toml" ]; then \
        pip install -e ./benchmark || true; \
    fi

RUN if [ -f "autogpt/pyproject.toml" ]; then \
        pip install -e ./autogpt || true; \
    fi

# Install test dependencies explicitly (ensure pytest and related tools are available)
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout \
    pytest-benchmark pytest-integration pytest-recording \
    litellm anyio vcrpy mock asynctest coverage

# Set Python path to include all source directories
ENV PYTHONPATH=/app:/app/autogpt:/app/forge:/app/benchmark:$PYTHONPATH

# Verify installations
RUN python -c "import sys; print('Python:', sys.version)"
RUN python -c "import pytest; print('pytest version:', pytest.__version__)"

# Default command
CMD ["/bin/bash"]
