    && cd /app/autogpt && (python -c "import autogpt" 2>/dev/null || poetry install --no-interaction --with dev 2>/dev/null || true)

# Install additional test dependencies
RUN pip install --no-cache-dir \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    litellm \
    anyio \
    requests \
    && rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Set environment variables for Forge API
