[32m# Use official Python slim image as base
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Configure environment for Forge API (OpenAI-compatible)
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set Python environment variables
ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies required for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build tools (quote version constraint to avoid shell redirection)
RUN python -m pip install --upgrade pip wheel "setuptools<=81.0.0"

# Copy the entire repository
COPY . .

# Install the project with all dev dependencies
# Using --break-system-packages since we're in a container
RUN pip install --break-system-packages -e ".[dev]"

# Install additional test dependencies explicitly
RUN pip install --break-system-packages \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-forked \
    anyio \
    litellm \
    mem0ai \
    fakeredis \
    aiosqlite \
    greenlet

# Verify installation
RUN python -c "import agentscope; print('agentscope imported successfully')" && \
    python -c "import pytest; print('pytest imported successfully')" && \
    python -c "import litellm; print('litellm imported successfully')"

# Default command
CMD ["/bin/bash"]
