[32m# Use official Python slim image as base
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Configure environment for Forge API (OpenAI-compatible)
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set Python environment variables - use /app/src for src layout
ENV PYTHONPATH=/app/src
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies with retry logic for network resilience
# Some packages like lxml require compilation, so we need build tools
RUN set -eux; \
    apt-get_clean() { rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*; }; \
    for attempt in 1 2 3; do \
        echo "=== Attempt $attempt: Updating package lists ==="; \
        apt-get_clean; \
        apt-get update --fix-missing && break || { \
            echo "Attempt $attempt failed, retrying in 10s..."; \
            sleep 10; \
        }; \
    done; \
    for attempt in 1 2 3; do \
        echo "=== Attempt $attempt: Installing packages ==="; \
        apt-get install -y --no-install-recommends --fix-missing \
            gcc \
            g++ \
            libxml2-dev \
            libxslt1-dev \
            python3-dev \
            build-essential \
            git \
            curl \
            ca-certificates \
        && break || { \
            echo "Attempt $attempt failed, retrying in 10s..."; \
            sleep 10; \
        }; \
    done; \
    apt-get_clean

# Upgrade pip and install build tools (quote version constraint to avoid shell redirection)
RUN python -m pip install --upgrade pip wheel "setuptools<=81.0.0"

# Copy the entire repository
COPY . .

# Install Python dependencies with retry logic
# First install test dependencies that are lightweight
RUN set -eux; \
    for attempt in 1 2 3; do \
        echo "=== Attempt $attempt: Installing test dependencies ==="; \
        pip install --break-system-packages \
            pytest \
            pytest-mock \
            pytest-asyncio \
            pytest-cov \
            pytest-forked \
            anyio \
            litellm \
            mem0ai \
            fakeredis \
            aiosqlite \
            greenlet \
        && break || { \
            echo "Attempt $attempt failed, retrying in 15s..."; \
            sleep 15; \
        }; \
    done

# Install the project with retry logic for network issues
# Using --break-system-packages since we're in a container
# Retry up to 3 times in case of network failures
RUN set -eux; \
    for attempt in 1 2 3; do \
        echo "=== Attempt $attempt: Installing project dependencies ==="; \
        pip install --break-system-packages --timeout 300 -e ".[dev]" && break || { \
            echo "Attempt $attempt failed, retrying in 30s..."; \
            sleep 30; \
        }; \
    done

# Verify installation
RUN python -c "import agentscope; print('agentscope imported successfully')" && \
    python -c "import pytest; print('pytest imported successfully')" && \
    python -c "import litellm; print('litellm imported successfully')"

# Default command
CMD ["/bin/bash"]
