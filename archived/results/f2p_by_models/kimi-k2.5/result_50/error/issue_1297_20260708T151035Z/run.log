[32m# Use official Python slim image as base
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Configure environment for Forge API (OpenAI-compatible)
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set Python environment variables - use /app/src for src layout
ENV PYTHONPATH=/app/src
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies
# Some packages like lxml require compilation, so we need build tools
RUN apt-get update --fix-missing && \
    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        libxml2-dev \
        libxslt1-dev \
        python3-dev \
        build-essential \
        git \
        curl \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Upgrade pip and install build tools
RUN python -m pip install --upgrade pip wheel "setuptools<=81.0.0"

# Copy the entire repository
COPY . .

# Install Python dependencies
# First install test dependencies
RUN pip install --break-system-packages \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-forked \
    anyio \
    litellm \
    mem0ai \
    fakeredis \
    aiosqlite \
    greenlet

# Install project dependencies from pyproject.toml
# Using --break-system-packages since we're in a container
# Using pip install with [dev] extras but NOT editable install (src layout)
RUN pip install --break-system-packages --timeout 300 ".[dev]" || \
    (echo "Retrying with --no-deps..." && \
     pip install --break-system-packages --no-deps . && \
     pip install --break-system-packages \
         aioitertools anthropic dashscope docstring_parser json5 json_repair \
         "mcp>=1.13" numpy openai python-datauri "opentelemetry-api>=1.39.0" \
         "opentelemetry-sdk>=1.39.0" "opentelemetry-exporter-otlp>=1.39.0" \
         "opentelemetry-semantic-conventions>=0.60b0" python-socketio \
         shortuuid tiktoken sounddevice sqlalchemy python-frontmatter \
         a2a-sdk httpx "nacos-sdk-python>=3.0.0" websockets>=14.0 scipy \
         google-genai ollama>=0.5.4 Pillow transformers jinja2 redis \
         "mem0ai<=1.0.3" packaging "reme-ai>=0.2.0.3" nltk "pypdf<=6.5.0" \
         python-docx pandas openpyxl python-pptx "qdrant-client==1.15.1" \
         pymilvus[milvus_lite] mysql-connector-python pymongo \
         "pyobvector>=0.2.0,<0.3.0" ray pre-commit sphinx-gallery furo \
         myst_parser matplotlib py-openjudge)

# Verify installation
RUN python -c "import sys; sys.path.insert(0, '/app/src'); import agentscope; print('agentscope imported successfully')" && \
    python -c "import pytest; print('pytest imported successfully')" && \
    python -c "import litellm; print('litellm imported successfully')"

# Default command
CMD ["/bin/bash"]
