    MODEL="tuzi-kimi-k2.5/kimi-k2.5" \
    AI_TEMPERATURE="0.7" \
    AI_MAX_TOKENS="1000" \
    TAVILY_API_KEY="tvly-dev-key" \
    GITHUB_TOKEN="ghp_key" \
    PYTHONPATH="/app/src"

# Copy the entire repository (including tests, src, configs)
COPY . .

# Install project dependencies
# CrewAI is the framework - ensure it's properly installed
RUN pip install --no-cache-dir crewai litellm

# Install from pyproject.toml if it exists
RUN if [ -f "pyproject.toml" ]; then \
        pip install --no-cache-dir -e . || pip install --no-cache-dir -e ".[tools,embeddings]" || true; \
    fi

# Install test dependencies
RUN pip install --no-cache-dir \
    pytest pytest-mock pytest-asyncio pytest-cov pytest-vcr pytest-subprocess \
    mem0ai requests

# Preflight check - verify crewai imports correctly
RUN python -c "import crewai; print('crewai imported successfully')" && \
    python -c "import pytest; print('pytest imported successfully')"

CMD ["/bin/bash"]
