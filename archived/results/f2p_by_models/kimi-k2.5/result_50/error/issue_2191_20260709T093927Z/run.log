# For src/ layout, set PYTHONPATH to include the src directory
RUN pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-vcr pytest-subprocess \
        "setuptools<=81.0.0" \
        litellm \
