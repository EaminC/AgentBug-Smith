    MODEL="tuzi-kimi-k2.5/kimi-k2.5" \
    OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY="forge-key" \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1" \
    ANTHROPIC_AUTH_TOKEN="forge-key" \
    ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5" \
    ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5" \
    AI_TEMPERATURE="0.7" \
    AI_MAX_TOKENS="1000" \
    AI_TOP_P="1" \
    TAVILY_API_KEY="tvly-dev-key" \
    GITHUB_TOKEN="ghp_key" \
    PYTHONPATH="/app" \
    PYTHONDONTWRITEBYTECODE="1" \
    PYTHONUNBUFFERED="1" \
    PIP_NO_CACHE_DIR="1" \
    PIP_DISABLE_PIP_VERSION_CHECK="1"

WORKDIR /app

# Layer 1: System dependencies and pip upgrade
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0"

# Layer 2: Core runtime dependencies (essential only)
RUN pip install --no-cache-dir \
    beautifulsoup4>=4.12.2 \
    colorama==0.4.6 \
    distro==1.8.0 \
    openai==0.27.2 \
    python-dotenv==1.0.0 \
    pyyaml==6.0 \
    PyPDF2 \
    python-docx \
    markdown \
    pylatexenc \
    readability-lxml==0.8.1 \
    requests \
    tiktoken==0.3.3 \
    gTTS==2.3.1 \
    duckduckgo-search==3.0.2 \
    google-api-python-client \
    redis \
    orjson==3.8.10 \
    Pillow \
    jsonschema \
    click \
    charset-normalizer>=3.1.0 \
    spacy>=3.0.0,<4.0.0 \
    prompt_toolkit>=3.0.38 \
    pydantic \
    fastapi \
    uvicorn \
    numpy \
    gitpython==3.1.31 \
    openapi-python-client==0.13.4

# Layer 3: Test dependencies
RUN pip install --no-cache-dir \
    pytest \
    pytest-asyncio \
    pytest-cov \
    pytest-mock \
    pytest-xdist \
    pytest-timeout \
    litellm \
    mem0ai

# Layer 4: Spacy model
RUN pip install --no-cache-dir \
    https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.5.0/en_core_web_sm-3.5.0-py3-none-any.whl

# Layer 5: Plugin template
RUN pip install --no-cache-dir \
    git+https://github.com/Significant-Gravitas/Auto-GPT-Plugin-Template@0.1.0

# Copy project source
COPY . .

# Layer 6: Install project and cleanup
RUN pip install --no-cache-dir -e . \
    && apt-get purge -y --auto-remove gcc python3-dev libxml2-dev libxslt1-dev \
    && apt-get autoremove -y \
    && rm -rf /root/.cache/pip /tmp/* /var/tmp/* /var/lib/apt/lists/*

# Preflight check
RUN python -c "import pytest, autogpt; print('Preflight checks passed')"

CMD ["/bin/bash"]
