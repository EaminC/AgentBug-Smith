    TAVILY_API_KEY="tvly-dev-key" \
    GITHUB_TOKEN="ghp_key" \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

# Install system deps, Python packages, and cleanup in ONE RUN to minimize layer size
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        libxml2-dev \
        libxslt1-dev \
        python3-dev \
        gcc \
        curl \
        ca-certificates && \
    pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" && \
    pip install --no-cache-dir pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout litellm && \
    apt-get purge -y --auto-remove build-essential gcc python3-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/* /root/.cache/* /var/tmp/*

# Copy full repository (must include all files for tests)
COPY . .

# Install project and test deps, then clean up pip cache in one layer
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -e . && \
    python -c "import pytest; import autogpt; print('Preflight checks passed')" && \
    rm -rf /root/.cache/* /tmp/*

CMD ["/bin/bash"]
