[32m# Dockerfile for CrewAI project with Forge API configuration
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Set environment variables for Forge API (OpenAI and Anthropic compatible)
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"

# Copy the entire repository
COPY . .

# Set PYTHONPATH for src/ layout (don't use pip install -e . to avoid duplicate module issues)
ENV PYTHONPATH=/app/src

# Install Python packages without heavy build dependencies
# Use pre-built wheels where possible; avoid gcc and libxml2-dev
RUN python -m pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" && \
    pip install --no-cache-dir \
        pytest>=8.0.0 \
        pytest-vcr>=1.0.2 \
        pytest-asyncio>=0.23.7 \
        pytest-subprocess>=1.5.2 \
        pytest-mock \
        pytest-xdist \
        pytest-timeout \
        pytest-cov \
        litellm \
        httpx \
        anyio \
        pyyaml \
        requests \
        numpy \
        pillow \
        mem0ai \
        pydantic>=2.4.2 \
        openai>=1.13.3 \
        instructor>=1.3.3 \
        pdfplumber>=0.11.4 \
        regex>=2024.9.11 \
        opentelemetry-api>=1.22.0 \
        opentelemetry-sdk>=1.22.0 \
        opentelemetry-exporter-otlp-proto-http>=1.22.0 \
        chromadb>=0.5.23 \
        openpyxl>=3.1.5 \
        pyvis>=0.3.2 \
        auth0-python>=4.7.1 \
        python-dotenv>=1.0.0 \
        click>=8.1.7 \
        appdirs>=1.4.4 \
        jsonref>=1.1.0 \
        json-repair>=0.25.2 \
        uv>=0.4.25 \
        tomli-w>=1.1.0 \
        tomli>=2.0.2 \
        blinker>=1.9.0 \
        json5>=0.10.0 && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Verify key imports work
RUN python -c "import sys; print(f'Python {sys.version}')" && \
    python -c "import pytest; print(f'pytest {pytest.__version__}')" && \
    python -c "import pydantic; print(f'pydantic {pydantic.__version__}')" && \
    python -c "import litellm; print(f'litellm {litellm.__version__}')" && \
    python -c "from crewai import Agent, Crew, Task, LLM; print('CrewAI imports OK')"

CMD ["/bin/bash"]
