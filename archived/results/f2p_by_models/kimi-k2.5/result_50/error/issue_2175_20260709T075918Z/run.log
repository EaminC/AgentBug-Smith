[32m# Dockerfile for CrewAI project with Forge API configuration
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install minimal system dependencies (only what's needed for compilation of some Python packages)
# Clean up immediately to save space
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/* /var/tmp/*

# Upgrade pip and wheel
RUN python -m pip install --upgrade pip wheel setuptools && \
    rm -rf /root/.cache/pip

# Copy the entire repository
COPY . .

# Set PYTHONPATH for src/ layout
ENV PYTHONPATH=/app/src

# Install the package and dependencies in a single layer to minimize space
# Using --no-cache-dir to avoid pip cache taking up space
RUN pip install --no-cache-dir -e . && \
    pip install --no-cache-dir \
    pytest>=8.0.0 \
    pytest-vcr>=1.0.2 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
    pytest-mock \
    pytest-xdist \
    pytest-timeout \
    pytest-cov \
    "setuptools<=81.0.0" \
    litellm \
    httpx \
    anyio \
    pyyaml \
    requests \
    numpy \
    pillow \
    mem0ai \
    && rm -rf /root/.cache/pip

# Pre-flight check - verify key imports work
RUN python -c "import sys; print(f'Python {sys.version}')" && \
    python -c "import pytest; print(f'pytest {pytest.__version__}')" && \
    python -c "import pydantic; print(f'pydantic {pydantic.__version__}')" && \
    python -c "import litellm; print(f'litellm {litellm.__version__}')"

# Verify crewai imports work
RUN python -c "import sys; sys.path.insert(0, '/app/src'); from crewai import Agent, Crew, Task, LLM; print('CrewAI imports OK')"

# Default command
CMD ["/bin/bash"]
