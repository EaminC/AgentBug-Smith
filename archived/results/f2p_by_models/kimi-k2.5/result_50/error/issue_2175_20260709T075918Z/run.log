# Group: test dependencies + core dependencies + project
RUN pip install --no-cache-dir \
    pytest>=8.0.0 \
    pytest-vcr>=1.0.2 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
