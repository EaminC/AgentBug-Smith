RUN pip install uv>=0.4.25

# Install project dependencies from pyproject.toml
# Since this is a src/ layout project, we set PYTHONPATH instead of editable install
ENV PYTHONPATH=/app/src

# Install all dependencies including optional ones
RUN pip install \
    pydantic>=2.4.2 \
    openai>=1.13.3 \
    litellm==1.60.2 \
    instructor>=1.3.3 \
    pdfplumber>=0.11.4 \
    regex>=2024.9.11 \
    opentelemetry-api>=1.22.0 \
    opentelemetry-sdk>=1.22.0 \
    opentelemetry-exporter-otlp-proto-http>=1.22.0 \
    chromadb>=0.5.23 \
    openpyxl>=3.1.5 \
    pyvis>=0.3.2 \
    auth0-python>=4.7.1 \
    python-dotenv>=1.0.0 \
    click>=8.1.7 \
    appdirs>=1.4.4 \
    jsonref>=1.1.0 \
    json-repair>=0.25.2 \
    tomli-w>=1.1.0 \
    tomli>=2.0.2 \
    blinker>=1.9.0 \
    json5>=0.10.0

# Install optional dependencies for full functionality
RUN pip install \
    crewai-tools>=0.36.0 \
    tiktoken~=0.7.0 \
    mem0ai>=0.1.29 \
    fastembed>=0.4.1 \
    pandas>=2.2.3 \
    docling>=2.12.0 \
    agentops>=0.3.0

# Install test dependencies
RUN pip install \
    pytest>=8.0.0 \
    pytest-vcr>=1.0.2 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
    pytest-mock \
    pytest-xdist \
    pytest-timeout \
    pytest-cov \
    "setuptools<=81.0.0"

# Pre-install additional dependencies often needed
RUN pip install \
    httpx \
    anyio \
    pyyaml \
    requests \
    numpy \
    pillow

# Forge API environment variables for OpenAI compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Forge API environment variables for Anthropic compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional AI configuration
ENV MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

# Pre-flight check - verify Python and pytest are working
RUN python -c "import sys; print(f'Python {sys.version}')" && \
    python -c "import pytest; print(f'pytest {pytest.__version__}')" && \
    python -c "import pydantic; print(f'pydantic {pydantic.__version__}')" && \
    python -c "import litellm; print(f'litellm {litellm.__version__}')"

# Verify crewai imports work
RUN python -c "import sys; sys.path.insert(0, '/app/src'); from crewai import Agent, Crew, Task, LLM; print('CrewAI imports OK')"

# Default command
CMD ["/bin/bash"]
