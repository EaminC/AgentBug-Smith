    blinker>=1.9.0 \
    json5>=0.10.0

# Install packages that may need compilation separately
RUN pip install --no-cache-dir \
    pdfplumber>=0.11.4 \
    litellm==1.60.2 \
    mem0ai>=0.1.29

# Install chromadb with potential compilation requirements
RUN pip install --no-cache-dir chromadb>=0.5.23 || \
    (apt-get update && apt-get install -y --no-install-recommends \
     build-essential cmake && \
     pip install --no-cache-dir chromadb>=0.5.23)

# Clean up build dependencies to reduce image size
RUN apt-get purge -y --auto-remove gcc g++ build-essential cmake 2>/dev/null || true && \
    rm -rf /var/lib/apt/lists/* /root/.cache/pip /tmp/* /var/tmp/*

# Final verification
RUN python -c "import sys; print(f'Python {sys.version}')" && \
    python -c "import pytest; print(f'pytest {pytest.__version__}')" && \
    python -c "import pydantic; print(f'pydantic {pydantic.__version__}')" && \
    python -c "from crewai import Agent, Crew, Task, LLM; print('CrewAI imports OK')"

