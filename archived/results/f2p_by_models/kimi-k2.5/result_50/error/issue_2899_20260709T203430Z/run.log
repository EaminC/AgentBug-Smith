[32m# CrewAI Dockerfile with Forge API configuration
# Using Python 3.12 slim base image
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies required for compilation and runtime
# Including build tools for packages like lxml, numpy, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    build-essential \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    libffi-dev \
    libssl-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install essential build tools
RUN python -m pip install --upgrade pip wheel setuptools<=81.0.0

# Install uv for faster package management (used by this project)
RUN pip install uv

# Set environment variables for Forge API (OpenAI-compatible)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional environment variables from project
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_MODEL=tuzi-kimi-k2.5/kimi-k2.5
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-kimi-k2.5/kimi-k2.5

# Copy the entire repository
COPY . .

# Install CrewAI framework explicitly as per instructions
RUN pip install "crewai>=0.130.0"

# Install project dependencies using uv if uv.lock exists, otherwise use pip
# Note: Using src layout, so we set PYTHONPATH instead of editable install
RUN if [ -f "uv.lock" ]; then \
        uv pip install --system --all-extras -e . || pip install -e .; \
    elif [ -f "pyproject.toml" ]; then \
        pip install -e .; \
    fi

# Set PYTHONPATH for src layout (tests import via crewai, not src.crewai)
ENV PYTHONPATH=/app/src

# Install test dependencies explicitly
RUN pip install \
    pytest>=8.0.0 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
    pytest-recording>=0.13.2 \
    pytest-randomly>=3.16.0 \
    pytest-timeout>=2.3.1 \
    pytest-mock \
    pytest-xdist \
    python-dotenv>=1.0.0 \
    pillow>=10.2.0 \
    litellm \
    mem0ai>=0.1.94 \
    crewai-tools~=0.47.1

# Preflight check - verify Python and key imports work
RUN python -c "import sys; print(f'Python {sys.version}')" && \
    python -c "import crewai; print(f'crewai imported successfully')" && \
    python -c "import pytest; print('pytest imported successfully')" && \
    echo "preflight ok"

# Default command is bash for testing environment
CMD ["/bin/bash"]
