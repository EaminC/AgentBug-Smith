# Install test dependencies and litellm explicitly
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout \
    setuptools litellm mem0ai

# Verify installation with preflight check
RUN python -c "import crewai; import pytest; print('preflight ok')"

# Set final command to bash
CMD ["/bin/bash"]
