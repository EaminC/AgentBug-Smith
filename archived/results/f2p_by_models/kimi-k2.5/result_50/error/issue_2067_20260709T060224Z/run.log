[32m# Use Python 3.11 slim as base image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Clean up apt cache and install dependencies in one layer to save space
RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/* && \
    apt-get update --fix-missing && \
    apt-get install -y --no-install-recommends --no-install-suggests \
        gcc \
        libc6-dev \
        libffi-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/*

# Upgrade pip with no cache
RUN python -m pip install --no-cache-dir --upgrade pip wheel setuptools

# Copy the entire repository
COPY . .

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set Python path for src layout
ENV PYTHONPATH=/app/src

# Install the package and dependencies in a single RUN to minimize layers
# First try to install the package, then install test dependencies
RUN pip install --no-cache-dir -e . || pip install --no-cache-dir -e . --no-deps

# Install test dependencies explicitly
RUN pip install --no-cache-dir \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    pytest-vcr \
    pytest-subprocess \
    "setuptools<=81.0.0" \
    litellm \
    mem0ai

# Verify installation with preflight check
RUN python -c "import crewai; import pytest; print('preflight ok')"

# Set final command to bash
CMD ["/bin/bash"]
