[32m# Use Python 3.11 slim as base image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies in a single layer to minimize disk usage
# Order: update first, then install, then cleanup all in one RUN
RUN apt-get update && \
    apt-get install -y --no-install-recommends --no-install-suggests \
        gcc \
        libc6-dev \
        libffi-dev \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/*

# Upgrade pip with no cache
RUN python -m pip install --no-cache-dir --upgrade pip wheel setuptools

# Copy the entire repository
COPY . .

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set Python path for src layout (crewai is in src/crewai)
ENV PYTHONPATH=/app/src

# Install dependencies and test tools in a single RUN to minimize layers
# Since this is a src layout, we don't use pip install -e . to avoid module identity issues
RUN pip install --no-cache-dir \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    pytest-vcr \
    pytest-subprocess \
    "setuptools<=81.0.0" \
    litellm \
    mem0ai

# Install the project's Python dependencies from pyproject.toml
# Using pip to install the core dependencies listed in pyproject.toml
RUN pip install --no-cache-dir \
    pydantic>=2.4.2 \
    openai>=1.13.3 \
    litellm==1.60.2 \
    instructor>=1.3.3 \
    pdfplumber>=0.11.4 \
    regex>=2024.9.11 \
    opentelemetry-api>=1.22.0 \
    opentelemetry-sdk>=1.22.0 \
    opentelemetry-exporter-otlp-proto-http>=1.22.0 \
    chromadb>=0.5.23 \
    openpyxl>=3.1.5 \
    pyvis>=0.3.2 \
    auth0-python>=4.7.1 \
    python-dotenv>=1.0.0 \
    click>=8.1.7 \
    appdirs>=1.4.4 \
    jsonref>=1.1.0 \
    json-repair>=0.25.2 \
    uv>=0.4.25 \
    tomli-w>=1.1.0 \
    tomli>=2.0.2 \
    blinker>=1.9.0 \
    json5>=0.10.0

# Verify installation with preflight check
RUN python -c "import sys; sys.path.insert(0, '/app/src'); import crewai; import pytest; print('preflight ok')"

# Set final command to bash
CMD ["/bin/bash"]
