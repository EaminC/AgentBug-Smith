# Install the project in editable mode if setup files exist, otherwise use PYTHONPATH
RUN if [ -f setup.py ]; then \
        pip install -e . ; \
    elif [ -f pyproject.toml ]; then \
        grep -q "\[project\]" pyproject.toml && pip install -e . || echo "No project section in pyproject.toml, using PYTHONPATH" ; \
    else \
        echo "No setup.py or pyproject.toml with project section, using PYTHONPATH" ; \
    fi

# Verify installation and print package info
RUN python -c "import sys; print(f'Python: {sys.version}')" && \
    python -c "import autogpt; print('autogpt import successful')" && \
    python -c "import pytest; print(f'pytest version: {pytest.__version__}')" && \
    echo "preflight ok"

