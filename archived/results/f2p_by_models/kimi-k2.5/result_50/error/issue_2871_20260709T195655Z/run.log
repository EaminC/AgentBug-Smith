# Install dependencies with robust handling
# First install spacy separately to handle the model download
RUN pip install spacy==3.5.0 || pip install spacy>=3.0.0,<4.0.0

# Download spacy model separately (fallback if URL install fails)
RUN python -m spacy download en_core_web_sm || true

# Install requirements without the en-core-web-sm line (handled above)
RUN grep -v "^en-core-web-sm" requirements.txt > /tmp/requirements_filtered.txt || cp requirements.txt /tmp/requirements_filtered.txt

# Install filtered requirements with retry logic
RUN pip install -r /tmp/requirements_filtered.txt || \
    (sleep 5 && pip install -r /tmp/requirements_filtered.txt) || \
    (pip install --no-deps -r /tmp/requirements_filtered.txt && pip install beautifulsoup4 colorama distro openai playsound python-dotenv pyyaml readability-lxml requests tiktoken gTTS docker duckduckgo-search google-api-python-client pinecone-client redis orjson Pillow selenium webdriver-manager jsonschema tweepy click spacy coverage flake8 numpy pre-commit black isort gitpython auto-gpt-plugin-template mkdocs pymdown-extensions openapi-python-client pytest asynctest pytest-asyncio pytest-benchmark pytest-cov pytest-integration pytest-mock vcrpy pytest-recording)

