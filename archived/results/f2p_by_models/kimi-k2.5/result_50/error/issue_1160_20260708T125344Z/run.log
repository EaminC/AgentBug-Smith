[32m# Base image for Python
FROM python:3.11-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Configure pip for better network resilience
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5
ENV PIP_NO_CACHE_DIR=1

# Install system dependencies with retry logic
RUN apt-get update -o Acquire::Retries=5 || apt-get update -o Acquire::Retries=5 || apt-get update && \
    apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install wheel
RUN pip install --upgrade pip wheel setuptools

# Copy the entire repository into the container
COPY . .

# Install the package and test dependencies with retries
RUN pip install --retries 5 --timeout 300 \
    pytest pytest-mock pytest-asyncio pytest-cov pytest-forked \
    pytest-timeout litellm mem0ai fakeredis aiosqlite greenlet \
    aioitertools anthropic dashscope docstring_parser json5 json_repair \
    "mcp>=1.13" numpy openai python-datauri \
    "opentelemetry-api>=1.39.0" "opentelemetry-sdk>=1.39.0" \
    "opentelemetry-exporter-otlp>=1.39.0" "opentelemetry-semantic-conventions>=0.60b0" \
    python-socketio shortuuid tiktoken sounddevice sqlalchemy python-frontmatter \
    google-genai "ollama>=0.5.4" \
    Pillow transformers jinja2 \
    redis "mem0ai<=0.1.116" packaging "reme-ai>=0.2.0.3" \
    nltk "pypdf<=6.5.0" python-docx pandas openpyxl python-pptx \
    "qdrant-client==1.15.1" "pymilvus[milvus_lite]" mysql-connector-python \
    pymongo "pyobvector>=0.2.0,<0.3.0" \
    a2a-sdk httpx "nacos-sdk-python>=3.0.0" \
    ray pre-commit sphinx-gallery furo myst_parser matplotlib

# Set PYTHONPATH for src/ layout to ensure tests can find the package
ENV PYTHONPATH=/app/src

# Pre-flight check to verify installation
RUN python -c "import sys; print('Python version:', sys.version)" && \
    python -c "import pytest; print('pytest imported successfully')"

# Default command to start a bash shell
CMD ["/bin/bash"]
