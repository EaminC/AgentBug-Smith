[32m# Base image for Python
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install system dependencies needed for compilation (e.g., lxml, numpy)
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install wheel
RUN python -m pip install --upgrade pip wheel

# Copy the entire repository into the container
COPY . .

# Install the package with all dev dependencies
# Using pip install -e .[dev] to install with all extras for testing
RUN pip install -e ".[dev]"

# Install additional test dependencies explicitly
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov pytest-forked \
    pytest-timeout setuptools litellm mem0ai fakeredis aiosqlite greenlet

# Set PYTHONPATH for src/ layout (tests import agentscope directly, not src.agentscope)
ENV PYTHONPATH=/app/src:$PYTHONPATH

# Set Forge API environment variables for OpenAI SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Set Forge API environment variables for Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Pre-flight check to verify installation
RUN python -c "import agentscope; import pytest; print('preflight ok')"

# Default command to start a bash shell
CMD ["/bin/bash"]
