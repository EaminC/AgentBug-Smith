RUN pip install --no-cache-dir \
    pydantic>=2.4.2 \
    openai>=1.13.3 \
    opentelemetry-api>=1.22.0 \
    opentelemetry-sdk>=1.22.0 \
    opentelemetry-exporter-otlp-proto-http>=1.22.0 \
    instructor>=1.3.3 \
    regex>=2024.9.11 \
    click>=8.1.7 \
    python-dotenv>=1.0.0 \
    appdirs>=1.4.4 \
    jsonref>=1.1.0 \
    json-repair>=0.25.2 \
    auth0-python>=4.7.1 \
    litellm>=1.44.22 \
    pyvis>=0.3.2 \
    uv>=0.4.25 \
    tomli-w>=1.1.0 \
    tomli>=2.0.2 \
    chromadb>=0.5.23 \
    pdfplumber>=0.11.4 \
    openpyxl>=3.1.5 \
    blinker>=1.9.0

# Install test dependencies
RUN pip install --no-cache-dir \
    pytest>=8.0.0 \
    pytest-vcr>=1.0.2 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
    pytest-mock \
    pytest-xdist \
    pytest-timeout \
    setuptools<=81.0.0

# Install additional dependencies that might be needed
RUN pip install --no-cache-dir \
    crewai-tools>=0.17.0 \
    mem0ai>=0.1.29 \
    pandas>=2.2.3

# Set PYTHONPATH for src/ layout to allow importing crewai
ENV PYTHONPATH=/app/src

# Set Forge API environment variables for OpenAI SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Set Forge API environment variables for Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set additional environment variables
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Pre-flight check: ensure pytest and crewai are importable
RUN python -c "import pytest; print('pytest ok')" && \
    python -c "import sys; sys.path.insert(0, '/app/src'); import crewai; print('crewai import ok')"

# Default command is bash
CMD ["/bin/bash"]
