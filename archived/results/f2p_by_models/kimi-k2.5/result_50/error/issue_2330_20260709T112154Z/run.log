# Handle src/ layout by using PYTHONPATH instead of editable install
RUN pip install \
    pydantic>=2.4.2 \
    openai>=1.13.3 \
    litellm==1.60.2 \
    instructor>=1.3.3 \
    pdfplumber>=0.11.4 \
    regex>=2024.9.11 \
    opentelemetry-api>=1.30.0 \
    opentelemetry-sdk>=1.30.0 \
    opentelemetry-exporter-otlp-proto-http>=1.30.0 \
    chromadb>=0.5.23 \
    openpyxl>=3.1.5 \
    pyvis>=0.3.2 \
    auth0-python>=4.7.1 \
    python-dotenv>=1.0.0 \
    click>=8.1.7 \
    appdirs>=1.4.4 \
    jsonref>=1.1.0 \
    json-repair>=0.25.2 \
    uv>=0.4.25 \
    tomli-w>=1.1.0 \
    tomli>=2.0.2 \
    blinker>=1.9.0 \
    json5>=0.10.0

# Install test dependencies
RUN pip install \
    pytest>=8.0.0 \
    pytest-vcr>=1.0.2 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
    pytest-mock \
    pytest-xdist \
    pytest-timeout \
    mem0ai>=0.1.29 \
    tiktoken~=0.7.0 \
    pandas>=2.2.3

# Install additional dependencies commonly needed by crewai
