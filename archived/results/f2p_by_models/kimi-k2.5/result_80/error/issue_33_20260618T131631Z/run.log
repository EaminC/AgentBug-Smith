ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Generate Prisma client (postinstall hook should handle this, but explicit for safety)
RUN npx prisma generate

# Build the Next.js application
RUN npm run build

# Preflight check to verify Node.js and key modules are available
RUN node -e "console.log('preflight ok')"

# Stage 2: Production runtime (minimal)
FROM node:19-alpine AS production

WORKDIR /app

# Copy package files for production dependency installation
COPY package*.json ./

# Install production dependencies only
RUN npm ci --production

# Copy built application artifacts from test_builder stage
COPY --from=test_builder /app/.next ./.next
COPY --from=test_builder /app/public ./public
COPY --from=test_builder /app/next.config.mjs ./next.config.mjs
COPY --from=test_builder /app/prisma ./prisma

# Copy Prisma generated client from node_modules (required for runtime)
COPY --from=test_builder /app/node_modules/.prisma ./node_modules/.prisma

# Expose the application port
EXPOSE 3000

# Start the application (inferred from package.json "start" script)
CMD ["npm", "start"]
