import mle.model


def test_openai_model_uses_custom_base_url_from_env(monkeypatch):
    """
    Test that OPENAI_BASE_URL environment variable is passed to the OpenAI client.
    This will fail before the fix (base_url not passed) and pass after.
    """
    custom_url = "https://custom.openai.api.com/v1"
    monkeypatch.setenv("OPENAI_BASE_URL", custom_url)
    
