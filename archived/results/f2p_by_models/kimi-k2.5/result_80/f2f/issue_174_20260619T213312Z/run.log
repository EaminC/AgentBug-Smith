import mle.model


class MockOpenAIClient:
    def __init__(self, **kwargs):
        self.init_kwargs = kwargs


def test_openai_model_respects_openai_base_url_env_var(monkeypatch):
    """
    Test that OpenAIModel passes OPENAI_BASE_URL environment variable to the client.
    This should fail before the fix (base_url not passed) and pass after.
    """
    custom_url = "https://custom.openai.api.com/v1"
    monkeypatch.setenv("OPENAI_BASE_URL", custom_url)
    
    original_openai = mle.model.openai.OpenAI
    mle.model.openai.OpenAI = MockOpenAIClient
    
    try:
        model = mle.model.OpenAIModel(api_key="test-api-key", model="gpt-4")
        assert "base_url" in model.client.init_kwargs, "base_url should be passed to OpenAI client"
        assert model.client.init_kwargs["base_url"] == custom_url, f"Expected {custom_url}, got {model.client.init_kwargs['base_url']}"
    finally:
        mle.model.openai.OpenAI = original_openai


def test_openai_model_uses_default_base_url_when_env_unset(monkeypatch):
    """
    Test that OpenAIModel uses default OpenAI URL when OPENAI_BASE_URL is not set.
    """
    monkeypatch.delenv("OPENAI_BASE_URL", raising=False)
    
    original_openai = mle.model.openai.OpenAI
    mle.model.openai.OpenAI = MockOpenAIClient
    
    try:
        model = mle.model.OpenAIModel(api_key="test-api-key", model="gpt-4")
        assert "base_url" in model.client.init_kwargs, "base_url should be passed to OpenAI client"
        assert model.client.init_kwargs["base_url"] == "https://api.openai.com/v1", "Should use default OpenAI URL"
    finally:
