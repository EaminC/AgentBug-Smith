FROM python:3.11-slim AS test_builder

WORKDIR /app

# Install system build dependencies for compiled Python packages (onnxruntime, chromadb, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade packaging tools early to ensure pkg_resources availability
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository (required for externally-injected test scripts)
COPY . .

# Conditional installation: detect src/ layout to avoid duplicate module loading
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        echo "Detected src/ layout, using PYTHONPATH mode"; \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
        echo "Standard layout detected, using editable install"; \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Ensure PYTHONPATH set for src/ layout compatibility
ENV PYTHONPATH=/app

# Preflight import verification to fail fast on missing core modules
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Forge environment configuration
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Runtime stage - minimal production image
FROM python:3.11-slim AS runtime

WORKDIR /app

# Install minimal runtime system libraries needed for compiled extensions (onnxruntime, pandas, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages and entry points from builder
COPY --from=test_builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site[0m
