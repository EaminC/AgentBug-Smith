[32m# CrewAI Python Environment with Forge API Configuration
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Configure apt to minimize space usage and install dependencies in one layer
RUN echo 'APT::Get::Clean=always;' > /etc/apt/apt.conf.d/99clean && \
    echo 'APT::Periodic::AutocleanInterval=1;' >> /etc/apt/apt.conf.d/99clean && \
    apt-get update && \
    apt-get install -y --no-install-recommends gcc python3-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /var/cache/apt/pkgcache.bin /var/cache/apt/srcpkgcache.bin /tmp/* /var/tmp/*

# Upgrade pip and install build tools
RUN python -m pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" hatchling

# Copy the entire repository
COPY . .

# Install crewai package and test dependencies in one layer to minimize space
RUN pip install --no-cache-dir -e . && \
    pip install --no-cache-dir \
        pytest \
        pytest-mock \
        pytest-asyncio \
        pytest-cov \
        pytest-timeout \
        pytest-vcr \
        pytest-subprocess \
        litellm \
        mem0ai \
        anyio && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

