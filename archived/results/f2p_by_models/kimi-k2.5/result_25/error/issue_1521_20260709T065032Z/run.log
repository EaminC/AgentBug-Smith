ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Python path for src layout
ENV PYTHONPATH=/app/src

# Pre-flight check
RUN python -c "import crewai; import pytest; print('preflight ok')"

# Default command
CMD ["/bin/bash"]
