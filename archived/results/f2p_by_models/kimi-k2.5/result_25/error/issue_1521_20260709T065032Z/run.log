[32m# CrewAI Python Environment with Forge API Configuration
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Prevent Python from writing pyc files and buffering stdout
ENV PYTHONDONTWRIBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install minimal build dependencies and clean up immediately to save space
# Only install gcc for packages that might need compilation, remove it right after
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc python3-dev && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/* /var/tmp/*

# Copy the entire repository
COPY . .

# Set Python path for src layout
ENV PYTHONPATH=/app/src

# Install Python packages (use pre-built wheels where possible)
# Install build tools first, then packages, then remove build tools
RUN pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" hatchling && \
    pip install --no-cache-dir \
    pydantic>=2.4.2 \
    openai>=1.13.3 \
    python-dotenv>=1.0.0 \
    click>=8.1.7 \
    appdirs>=1.4.4 \
    langchain>=0.2.16 \
    chromadb>=0.4.24 \
    pyvis>=0.3.2 \
    opentelemetry-api>=1.22.0 \
    opentelemetry-sdk>=1.22.0 \
    opentelemetry-exporter-otlp-proto-http>=1.22.0 \
    jsonref>=1.1.0 \
    json-repair>=0.25.2 \
    regex>=2024.9.11 \
    tomli>=2.0.2 \
    tomli-w>=1.1.0 \
    auth0-python>=4.7.1 \
    uv>=0.4.25 \
    crewai-tools>=0.13.4 \
    instructor>=1.3.3 \
    litellm>=1.44.22 \
    mem0ai \
    pytest>=8.0.0 \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-timeout \
    pytest-vcr \
    pytest-subprocess \
    anyio && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Remove gcc after pip install to save space
RUN apt-get remove -y gcc python3-dev && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/* /var/tmp/* /root/.cache

