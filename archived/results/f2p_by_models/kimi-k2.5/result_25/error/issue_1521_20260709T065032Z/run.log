[32m# CrewAI Python Environment with Forge API Configuration
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Prevent Python from writing pyc files and buffering stdout
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies and Python packages in a single layer to minimize image size
# Use --no-cache-dir for pip to avoid caching wheels
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        && \
    pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" hatchling && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /root/.cache/pip /tmp/* /var/tmp/*

# Copy the entire repository
COPY . .

# Install crewai package and test dependencies
# Using --break-system-packages since we're in a container
RUN pip install --no-cache-dir --break-system-packages -e . && \
    pip install --no-cache-dir --break-system-packages \
        pytest \
        pytest-mock \
        pytest-asyncio \
        pytest-cov \
        pytest-timeout \
        pytest-vcr \
        pytest-subprocess \
        litellm \
        mem0ai \
        anyio && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

