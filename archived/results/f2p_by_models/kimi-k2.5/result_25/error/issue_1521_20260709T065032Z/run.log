[32m# CrewAI Python Environment with Forge API Configuration
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Prevent Python from writing pyc files and buffering stdout
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Configure apt for minimal space usage and clean aggressively first
RUN rm -rf /var/cache/apt/archives/* /var/lib/apt/lists/* /tmp/* /var/tmp/* && \
    apt-get clean && \
    apt-get autoclean && \
    echo 'APT::Get::Clean=always;' > /etc/apt/apt.conf.d/99clean && \
    echo 'APT::Periodic::AutocleanInterval=0;' >> /etc/apt/apt.conf.d/99clean && \
    echo 'APT::Get::Install-Recommends=false;' >> /etc/apt/apt.conf.d/99norecommends && \
    echo 'APT::Get::Install-Suggests=false;' >> /etc/apt/apt.conf.d/99norecommends

# Install system dependencies one at a time to manage space
# First, just update and clean
RUN apt-get update && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# Install git separately
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/* /var/tmp/*

# Install build essentials separately
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc python3-dev libc6-dev && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/* /var/tmp/*

# Upgrade pip and install build tools
RUN pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" hatchling && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Copy the entire repository
COPY . .

# Set Python path for src layout (don't use editable install to save space)
ENV PYTHONPATH=/app/src

# Install Python dependencies in groups to manage memory/disk usage
# Group 1: Core dependencies
RUN pip install --no-cache-dir --break-system-packages \
    pydantic>=2.4.2 \
    openai>=1.13.3 \
    python-dotenv>=1.0.0 \
    click>=8.1.7 \
    appdirs>=1.4.4 && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Group 2: LangChain and related
RUN pip install --no-cache-dir --break-system-packages \
    langchain>=0.2.16 \
    chromadb>=0.4.24 \
    pyvis>=0.3.2 && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Group 3: OpenTelemetry
RUN pip install --no-cache-dir --break-system-packages \
    opentelemetry-api>=1.22.0 \
    opentelemetry-sdk>=1.22.0 \
    opentelemetry-exporter-otlp-proto-http>=1.22.0 && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Group 4: JSON and text processing
RUN pip install --no-cache-dir --break-system-packages \
    jsonref>=1.1.0 \
    json-repair>=0.25.2 \
    regex>=2024.9.11 \
    tomli>=2.0.2 \
    tomli-w>=1.1.0 && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Group 5: Auth and HTTP
RUN pip install --no-cache-dir --break-system-packages \
    auth0-python>=4.7.1 \
    uv>=0.4.25 && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Group 6: CrewAI specific dependencies
RUN pip install --no-cache-dir --break-system-packages \
    crewai-tools>=0.13.4 \
    instructor>=1.3.3 \
    litellm>=1.44.22 \
    mem0ai && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Group 7: Test dependencies
RUN pip install --no-cache-dir --break-system-packages \
    pytest>=8.0.0 \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-timeout \
    pytest-vcr \
    pytest-subprocess \
    anyio && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set environment variables for Forge API (OpenAI-compatible)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# Pre-flight check
RUN python -c "import sys; sys.path.insert(0, '/app/src'); import crewai; import pytest; print('preflight ok')"

# Default command
CMD ["/bin/bash"]
