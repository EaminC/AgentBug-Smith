    pip install --no-cache-dir \
    pytest>=8.0.0 \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-timeout \
    pytest-vcr \
    pytest-subprocess \
    anyio \
    litellm \
    mem0ai \
    python-dotenv

# Clean pip cache and apt caches to reduce image size
RUN rm -rf /root/.cache/pip /tmp/* /var/tmp/* /var/lib/apt/lists/*

