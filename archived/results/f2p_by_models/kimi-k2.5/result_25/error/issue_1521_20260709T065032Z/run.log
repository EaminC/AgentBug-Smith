[32m# CrewAI Python Environment with Forge API Configuration
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Prevent Python from writing pyc files and buffering stdout
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install dependencies in a single layer with aggressive cleanup to minimize disk usage
# Avoid python3-dev to save space - most packages have pre-built wheels
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc && \
    pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" hatchling && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /root/.cache/pip /tmp/* /var/tmp/*

# Copy the entire repository
COPY . .

# Install crewai package and test dependencies in one layer with cleanup
RUN pip install --no-cache-dir -e . && \
    pip install --no-cache-dir \
        pytest \
        pytest-mock \
        pytest-asyncio \
        pytest-cov \
        pytest-timeout \
        pytest-vcr \
        pytest-subprocess \
        litellm \
        mem0ai \
        anyio && \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Remove build dependencies to free space
RUN apt-get purge -y gcc && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/* /var/tmp/*

