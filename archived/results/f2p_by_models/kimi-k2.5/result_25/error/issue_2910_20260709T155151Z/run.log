    pyvis>=0.3.2 auth0-python>=4.7.1 appdirs>=1.4.4 \
    tomli-w>=1.1.0 tomli>=2.0.2 json5>=0.10.0 uv>=0.4.25 onnxruntime==1.22.0 \
    && rm -rf /root/.cache/* /tmp/* /var/tmp/*

# Remove build tools after compilation needs are done
RUN apt-get purge -y --auto-remove build-essential gcc g++ python3-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /root/.cache/*

# Copy the project
COPY . .

# Install the project itself and crewai-tools (may need compilation, do before removing build tools if needed)
# Try without build tools first since we pre-installed wheels where possible
RUN pip install --no-cache-dir crewai-tools~=0.46.0 2>/dev/null || true \
    && rm -rf /root/.cache/* /tmp/* /var/tmp/*

# Install project in editable mode
RUN pip install --no-cache-dir -e . \
    && rm -rf /root/.cache/* /tmp/* /var/tmp/*

# Preflight check
RUN python -c "import crewai, pydantic, openai, litellm, pytest; print('preflight ok')"

