ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
ENV PYTHONPATH=/app/src
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install system dependencies in a single layer with aggressive cleanup
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ git \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /var/cache/apt/*

# Upgrade pip and install build tools
RUN pip install --no-cache-dir --upgrade pip wheel setuptools && \
    rm -rf /root/.cache/* /tmp/* /var/tmp/*

# Copy only the necessary files first for dependency installation
COPY pyproject.toml ./
COPY src/ ./src/
COPY README.md ./

# Install project dependencies in smaller groups
# Group 1: Core dependencies
RUN pip install --no-cache-dir \
    pydantic>=2.4.2 \
    openai>=1.13.3 \
    litellm==1.68.0 \
    instructor>=1.3.3 \
    && rm -rf /root/.cache/* /tmp/* /var/tmp/*

# Group 2: Data and text processing
RUN pip install --no-cache-dir \
    chromadb>=0.5.23 \
    tokenizers>=0.20.3 \
    pdfplumber>=0.11.4 \
    openpyxl>=3.1.5 \
    regex>=2024.9.11 \
    && rm -rf /root/.cache/* /tmp/* /var/tmp/*

# Group 3: Configuration and utilities
RUN pip install --no-cache-dir \
    click>=8.1.7 \
    python-dotenv>=1.0.0 \
    jsonref>=1.1.0 \
    json-repair>=0.25.2 \
    blinker>=1.9.0 \
    appdirs>=1.4.4 \
    tomli-w>=1.1.0 \
    tomli>=2.0.2 \
    json5>=0.10.0 \
    uv>=0.4.25 \
    && rm -rf /root/.cache/* /tmp/* /var/tmp/*

# Group 4: Authentication, telemetry, and visualization
RUN pip install --no-cache-dir \
    auth0-python>=4.7.1 \
    opentelemetry-api>=1.30.0 \
    opentelemetry-sdk>=1.30.0 \
    opentelemetry-exporter-otlp-proto-http>=1.30.0 \
    pyvis>=0.3.2 \
    && rm -rf /root/.cache/* /tmp/* /var/tmp/*

# Group 5: ML/AI dependencies
RUN pip install --no-cache-dir \
    onnxruntime==1.22.0 \
    && rm -rf /root/.cache/* /tmp/* /var/tmp/*

# Group 6: Testing dependencies
RUN pip install --no-cache-dir \
    pytest>=8.0.0 \
    pytest-asyncio>=0.23.7 \
    pytest-subprocess>=1.5.2 \
    pytest-recording>=0.13.2 \
    pytest-randomly>=3.16.0 \
    pytest-timeout>=2.3.1 \
    pytest-mock \
    pytest-xdist \
    pytest-cov \
    anyio \
    "setuptools<=81.0.0" \
    && rm -rf /root/.cache/* /tmp/* /var/tmp/*

# Group 7: Additional dependencies
RUN pip install --no-cache-dir \
    mem0ai>=0.1.94 \
    crewai-tools~=0.46.0 \
    && rm -rf /root/.cache/* /tmp/* /var/tmp/*

# Install the project itself in editable mode
RUN pip install --no-cache-dir -e . && \
    rm -rf /root/.cache/* /tmp/* /var/tmp/*

# Copy remaining project files
COPY . .

# Preflight check - ensures all critical packages are importable
RUN python -c "import crewai, pydantic, openai, litellm, pytest; print('preflight ok')"

CMD ["/bin/bash"]
