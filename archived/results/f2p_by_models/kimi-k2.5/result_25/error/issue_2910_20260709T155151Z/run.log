    build-essential \
    gcc \
    git \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" \
    && pip install --no-cache-dir \
        pytest>=8.0.0 \
        pytest-asyncio>=0.23.7 \
        pytest-mock \
        pytest-xdist \
        pytest-timeout \
        pytest-cov \
        anyio \
        litellm \
        mem0ai \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /root/.cache/pip

# Copy repository
COPY . .

# Install crewai package using PYTHONPATH (src layout - no editable install)
# Pre-flight check to ensure imports work
RUN python -c "import sys; sys.path.insert(0, 'src'); from crewai import __version__; print(f'crewai v{__version__} preflight ok')"

