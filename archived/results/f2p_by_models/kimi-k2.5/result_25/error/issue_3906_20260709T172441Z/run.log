    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Upgrade pip and install build tools
RUN pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" hatchling

# Copy only necessary files first for better caching
COPY lib/crewai/pyproject.toml lib/crewai/pyproject.toml
COPY lib/crewai/README.md lib/crewai/README.md
COPY lib/crewai/src/crewai/__init__.py lib/crewai/src/crewai/__init__.py

# Copy crewai-tools if it exists
COPY lib/crewai-tools/pyproject.toml lib/crewai-tools/pyproject.toml
COPY lib/crewai-tools/README.md lib/crewai-tools/README.md

# Copy devtools if it exists
COPY lib/devtools/pyproject.toml lib/devtools/pyproject.toml

# Copy workspace files
COPY pyproject.toml .
COPY uv.lock .

# Copy source code
COPY lib/crewai/src lib/crewai/src
COPY lib/crewai-tools/src lib/crewai-tools/src
COPY lib/devtools/src lib/devtools/src

# Install crewai package first (core dependency)
RUN pip install --no-cache-dir ./lib/crewai

# Install crewai-tools if available
RUN if [ -f "lib/crewai-tools/pyproject.toml" ]; then \
        pip install --no-cache-dir ./lib/crewai-tools || true; \
    fi

# Install test dependencies
RUN pip install --no-cache-dir \
    pytest>=8.4.2 \
    pytest-asyncio>=1.2.0 \
    pytest-mock \
    pytest-cov \
    pytest-timeout>=2.4.0 \
    pytest-xdist>=3.8.0 \
    pytest-subprocess>=1.5.3 \
    vcrpy==7.0.0 \
    pytest-recording>=0.13.4 \
    pytest-randomly>=4.0.1 \
    anyio \
    litellm \
    mem0ai>=0.1.94 \
    boto3

# Copy tests
COPY lib/crewai/tests lib/crewai/tests
COPY lib/crewai-tools/tests lib/crewai-tools/tests

# Final cleanup to reduce image size
RUN rm -rf /root/.cache/pip /tmp/* /var/tmp/*

# Verify installation
RUN python -c "import crewai; print('crewai version:', crewai.__version__)" && \
    python -c "import pytest; print('pytest ok')"

