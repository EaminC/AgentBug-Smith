    requests>=2.31.0 \
    beautifulsoup4>=4.12.0 \
    lxml>=4.9.0 \
    selenium>=4.15.0 \
    docker>=6.1.0 \
    embedchain>=0.1.113 \
    youtube-transcript-api>=0.6.1 \
    pyowm>=3.3.0 \
    pygithub>=2.3.0

# Set PYTHONPATH for src/ layout packages
ENV PYTHONPATH="/app/lib/crewai/src:/app/lib/crewai-tools/src:/app/lib/devtools/src"

# Clean up build dependencies to reduce image size
RUN apt-get purge -y --auto-remove gcc g++ python3-dev libxml2-dev libxslt1-dev git \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /root/.cache/pip

# Verify Python imports work
RUN python -c "import sys; sys.path.insert(0, '/app/lib/crewai/src'); import crewai; print('Preflight OK: crewai imported successfully')"

CMD ["/bin/bash"]
