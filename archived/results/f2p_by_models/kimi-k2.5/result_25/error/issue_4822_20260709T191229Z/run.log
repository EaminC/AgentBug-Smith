[32m# Dockerfile for CrewAI project with Forge API configuration
# Base image: Python 3.12 slim (project requires >=3.10,<3.14)
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Set working directory
WORKDIR /app

# =============================================================================
# Forge API Environment Variables
# =============================================================================
# OpenAI SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional environment variables from project
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

# =============================================================================
# System Dependencies
# =============================================================================
# Install system dependencies including compilation tools for Python packages
# like lxml, chromadb, and other packages requiring native extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    git \
    curl \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Python Package Manager (uv) Installation
# =============================================================================
# Install uv for fast Python package management (this project uses uv)
RUN pip install --no-cache-dir --upgrade pip wheel && \
    pip install --no-cache-dir uv

# =============================================================================
# Project Dependencies Installation
# =============================================================================
# Copy workspace configuration files first (for better caching)
COPY pyproject.toml .
COPY uv.lock .
COPY .python-version .

# Copy all workspace packages
COPY lib/crewai/ lib/crewai/
COPY lib/crewai-tools/ lib/crewai-tools/
COPY lib/crewai-files/ lib/crewai-files/
COPY lib/devtools/ lib/devtools/

# Copy remaining project files
COPY . .

# Install the project using uv with all workspace dependencies
# Using pip as fallback since uv sync requires specific lockfile handling
RUN pip install --no-cache-dir \
    pydantic~=2.11.9 \
    openai>=1.83.0,<3 \
    instructor>=1.3.3 \
    pdfplumber~=0.11.4 \
    regex~=2026.1.15 \
    opentelemetry-api~=1.34.0 \
    opentelemetry-sdk~=1.34.0 \
    opentelemetry-exporter-otlp-proto-http~=1.34.0 \
    chromadb~=1.1.0 \
    tokenizers>=0.21,<1 \
    openpyxl~=3.1.5 \
    python-dotenv~=1.1.1 \
    pyjwt>=2.9.0,<3 \
    textual>=7.5.0 \
    click~=8.1.7 \
    appdirs~=1.4.4 \
    jsonref~=1.1.0 \
    json-repair~=0.25.2 \
    tomli-w~=1.1.0 \
    tomli~=2.0.2 \
    json5~=0.10.0 \
    portalocker~=2.7.0 \
    pydantic-settings~=2.10.1 \
    httpx~=0.28.1 \
    mcp~=1.26.0 \
    uv~=0.9.13 \
    aiosqlite~=0.21.0 \
    lancedb>=0.29.2

# =============================================================================
# Test Dependencies Installation
# =============================================================================
# Install pytest and related testing frameworks
RUN pip install --no-cache-dir \
    pytest==8.4.2 \
    pytest-asyncio==1.3.0 \
    pytest-subprocess==1.5.3 \
    vcrpy==7.0.0 \
    pytest-recording==0.13.4 \
    pytest-randomly==4.0.1 \
    pytest-timeout==2.4.0 \
    pytest-xdist==3.8.0 \
    pytest-split==0.10.0 \
    pytest-mock \
    types-requests~=2.31.0.6 \
    types-pyyaml==6.0.* \
    types-regex==2026.1.15.* \
    types-appdirs==1.4.* \
    boto3-stubs[bedrock-runtime]==1.42.40 \
    types-psycopg2==2.9.21.20251012 \
    types-pymysql==1.1.0.20250916 \
    types-aiofiles~=25.1.0

# =============================================================================
# Install CrewAI Framework SDK and Project
# =============================================================================
# Install crewai core framework (explicitly as this is a CrewAI project)
RUN pip install --no-cache-dir crewai

# Install the main crewai package in editable mode from lib/crewai
RUN if [ -f "lib/crewai/pyproject.toml" ]; then \
        pip install -e lib/crewai/; \
    fi

# Install crewai-tools if present
RUN if [ -f "lib/crewai-tools/pyproject.toml" ]; then \
        pip install -e lib/crewai-tools/; \
    fi

# Install crewai-files if present
RUN if [ -f "lib/crewai-files/pyproject.toml" ]; then \
        pip install -e lib/crewai-files/; \
    fi

# =============================================================================
# Additional Required Packages
# =============================================================================
# Install litellm and mem0ai as specified in requirements
RUN pip install --no-cache-dir litellm mem0ai

# Install setuptools (capped version as per requirements)
RUN pip install --no-cache-dir "setuptools<=81.0.0"

# Install anyio for async support
RUN pip install --no-cache-dir anyio

# =============================================================================
# Preflight Check
# =============================================================================
# Verify key packages are installed correctly
RUN python -c "import pydantic, pytest, openai, crewai; print('Preflight check passed')" || \
    echo "Warning: Some packages may not be fully importable in preflight"

# Verify Python environment
RUN python --version && \
    pip --version && \
    python -c "import sys; print(f'Python path: {sys.path}')"

# =============================================================================
# Final Configuration
# =============================================================================
# Set PYTHONPATH to include the source directories
ENV PYTHONPATH=/app/lib/crewai/src:/app/lib/crewai-tools/src:/app/lib/crewai-files/src:/app/lib/devtools/src:$PYTHONPATH

# Default command: bash shell for testing
CMD ["/bin/bash"]
