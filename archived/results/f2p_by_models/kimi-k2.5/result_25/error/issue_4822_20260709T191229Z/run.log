ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV DEBIAN_FRONTEND=noninteractive

# =============================================================================
# Working Directory
# =============================================================================
WORKDIR /app

# =============================================================================
# System Dependencies (single layer to minimize disk usage)
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ git curl \
    libxml2-dev libxslt1-dev python3-dev \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# =============================================================================
# Install uv for fast package management
# =============================================================================
RUN pip install --no-cache-dir --upgrade pip wheel uv

# =============================================================================
# Copy project files
# =============================================================================
COPY . .

# =============================================================================
# Install dependencies and project (single RUN to minimize layers)
# =============================================================================
# First try uv-based workspace installation if uv.lock exists, otherwise use pip
RUN if [ -f "uv.lock" ] && [ -f "pyproject.toml" ]; then \
        echo "Using uv sync for workspace installation..." && \
        uv sync --frozen --all-packages 2>/dev/null || \
        (echo "uv sync failed, falling back to pip..." && \
         pip install -e lib/crewai/ && \
         (pip install -e lib/crewai-tools/ 2>/dev/null || true) && \
         (pip install -e lib/crewai-files/ 2>/dev/null || true)); \
    else \
        echo "Using pip for installation..." && \
        pip install -e lib/crewai/ && \
        (pip install -e lib/crewai-tools/ 2>/dev/null || true) && \
        (pip install -e lib/crewai-files/ 2>/dev/null || true); \
    fi

# =============================================================================
# Install test dependencies
# =============================================================================
RUN pip install --no-cache-dir \
    pytest==8.4.2 pytest-asyncio==1.3.0 pytest-subprocess==1.5.3 \
    vcrpy==7.0.0 pytest-recording==0.13.4 pytest-randomly==4.0.1 \
    pytest-timeout==2.4.0 pytest-xdist==3.8.0 pytest-split==0.10.0 \
    pytest-mock litellm mem0ai "setuptools<=81.0.0" anyio

# =============================================================================
# Set Python path for src layouts
# =============================================================================
ENV PYTHONPATH=/app/lib/crewai/src:/app/lib/crewai-tools/src:/app/lib/crewai-files/src:/app/lib/devtools/src:$PYTHONPATH

# =============================================================================
# Preflight check
# =============================================================================
RUN python -c "import crewai, pydantic, openai, pytest; print('Preflight OK')" || echo "Some imports may require runtime env"

# =============================================================================
# Final command
# =============================================================================
CMD ["/bin/bash"]
