# Streamlined Dockerfile for Mastra AI Framework with TypeScript support

FROM node:20-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory early
WORKDIR /app

# Install system dependencies, pnpm, and TypeScript execution tools in single layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates curl && \
    npm install -g pnpm@10.12.4 tsx typescript && \
    npm cache clean --force && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /root/.npm/_cache/*

# --- Forge API Environment Variables ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"

# --- Node.js Environment ---
ENV NODE_OPTIONS="--max-old-space-size=4096"
ENV CI=true
ENV NODE_ENV=development
ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH="$PNPM_HOME:/app/node_modules/.bin:$PATH"

# Copy entire repository (respects .dockerignore)
COPY . .

# Pre-install dependencies to ensure standalone scripts can run
# Uses pnpm-lock.yaml if present, otherwise npm install
RUN if [ -f pnpm-lock.yaml ]; then \
        pnpm install --frozen-lockfile --ignore-scripts || pnpm install --ignore-scripts; \
    elif [ -f package-lock.json ]; then \
        npm ci --ignore-scripts || npm install --ignore-scripts; \
    else \
        pnpm install --ignore-scripts; \
    fi

# Build core packages for script execution
RUN pnpm run build:core 2>/dev/null || echo "Core build deferred to runtime"

# Verify environment
RUN node --version && pnpm --version && tsx --version && echo "TypeScript environment ready"

CMD ["/bin/bash"]
