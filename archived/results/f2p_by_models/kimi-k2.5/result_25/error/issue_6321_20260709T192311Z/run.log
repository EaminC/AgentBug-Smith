# Copy only package.json files from workspace packages to leverage caching
COPY packages/*/package.json ./packages/*/
COPY stores/*/package.json ./stores/*/
COPY deployers/*/package.json ./deployers/*/
COPY voice/*/package.json ./voice/*/
COPY workflows/*/package.json ./workflows/*/
COPY client-sdks/*/package.json ./client-sdks/*/
COPY auth/*/package.json ./auth/*/
COPY integrations/*/package.json ./integrations/*/

# Install dependencies without running scripts (faster, less disk usage)
RUN pnpm config set store-dir /tmp/pnpm-store \
    && pnpm install --frozen-lockfile --ignore-scripts 2>&1 || pnpm install --ignore-scripts 2>&1 \
    && pnpm store prune \
    && rm -rf /tmp/pnpm-store /root/.cache /root/.npm

# Copy the rest of the repository
COPY . .

# Basic verification
RUN node -e "console.log('Node.js:', process.version)" \
    && pnpm -v \
    && echo "Setup complete"

# Default command
CMD ["/bin/bash"]
