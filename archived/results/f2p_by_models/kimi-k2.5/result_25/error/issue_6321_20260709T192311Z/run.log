COPY stores/*/package.json ./stores/*/
COPY deployers/*/package.json ./deployers/*/
COPY speech/*/package.json ./speech/*/
COPY auth/*/package.json ./auth/*/
COPY client-sdks/*/package.json ./client-sdks/*/
COPY integrations/*/package.json ./integrations/*/
COPY voice/*/package.json ./voice/*/
COPY workflows/*/package.json ./workflows/*/

