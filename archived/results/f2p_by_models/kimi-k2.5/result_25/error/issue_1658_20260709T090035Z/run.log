# Install project dependencies and the project itself
# Using src layout - set PYTHONPATH instead of editable install to avoid duplicate module issues
ENV PYTHONPATH=/app/src

# Install the project using pip (handles both pyproject.toml and setup.py)
RUN pip install --no-cache-dir -e . \
    && rm -rf /root/.cache/pip \
    && python -c "import crewai; print('crewai imported successfully')" \
    && python -c "import pytest; print('pytest imported successfully')"

