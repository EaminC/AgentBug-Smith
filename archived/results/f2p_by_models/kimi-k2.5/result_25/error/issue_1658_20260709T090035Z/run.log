[32m# CrewAI Dockerfile with Forge API Configuration - Minimal Build
FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Upgrade pip first
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Copy the entire repository first
COPY . .

# Install the project - crewai uses src/ layout
# Try with pip install -e ., fallback to setting PYTHONPATH if that fails
RUN pip install --no-cache-dir -e . || (echo "Editable install failed, using PYTHONPATH" && true)

# Set Python path for src/ layout
ENV PYTHONPATH=/app/src

# --- Forge API Configuration ---
# OpenAI SDK compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"

# Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"

# Model configuration
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"

# Additional AI configuration
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"

# Other API keys
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"

# Install test dependencies one at a time to avoid memory issues
RUN pip install --no-cache-dir pytest
RUN pip install --no-cache-dir pytest-mock
RUN pip install --no-cache-dir pytest-asyncio
RUN pip install --no-cache-dir pytest-cov
RUN pip install --no-cache-dir pytest-timeout
RUN pip install --no-cache-dir anyio
RUN pip install --no-cache-dir "setuptools<=81.0.0"
RUN pip install --no-cache-dir litellm
RUN pip install --no-cache-dir mem0ai

# Pre-flight check - verify crewai can be imported
RUN python -c "import sys; sys.path.insert(0, 'src'); import crewai; print('crewai imported successfully')"

# Default command
CMD ["/bin/bash"]
