    PYTHONPATH=/app/src

WORKDIR /app

# Install system dependencies, Python packages, and cleanup in single layer
# CrewAI uses src/ layout per pyproject.toml - use PYTHONPATH not editable install
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    git \
    && pip install --no-cache-dir --upgrade pip wheel "setuptools<=81.0.0" hatchling \
    && rm -rf /var/lib/apt/lists/*

# Copy source code
COPY . .

# Install project and test dependencies, cleanup cache
RUN pip install --no-cache-dir . \
    && pip install --no-cache-dir \
    pytest>=8.0.0 \
    pytest-mock \
    pytest-asyncio>=0.23.7 \
    pytest-vcr>=1.0.2 \
    pytest-subprocess>=1.5.2 \
    pytest-cov \
    mem0ai>=0.1.29 \
    crewai-tools~=0.40.1 \
    && rm -rf /root/.cache /tmp/* /var/tmp/*

# Pre-flight check
RUN python -c "import sys; sys.path.insert(0, '/app/src'); import crewai; print('crewai imported successfully')" \
    && python -c "import pytest; print('pytest imported successfully')" \
    && echo "preflight ok"

