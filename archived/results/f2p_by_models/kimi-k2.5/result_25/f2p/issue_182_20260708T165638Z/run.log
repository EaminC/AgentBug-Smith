# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-kimi-k2.5/kimi-k2.5"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Set environment variables for Forge API compatibility
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Install system dependencies required for Python packages
# - build-essential, gcc: for compiling C/C++ extensions
# - libxml2-dev, libxslt1-dev: for lxml
# - python3-dev: for Python headers
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    libxml2-dev \
    libxslt1-dev \
    python3-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy the entire repository
COPY . .

# Upgrade pip and install dependencies
# Using --break-system-packages for PEP 668 compliance in Docker container
RUN python -m pip install --upgrade pip wheel setuptools && \
    pip install --break-system-packages -r requirements.txt && \
    pip install --break-system-packages -e . && \
    pip install --break-system-packages \
        pytest \
        pytest-mock \
        pytest-asyncio \
        pytest-cov \
        pytest-xdist \
        pytest-timeout \
        anyio \
        "setuptools<=81.0.0" \
        litellm \
        mem0ai

# Install ollama for OllamaModel support (optional but included in project)
RUN pip install --break-system-packages ollama || true

# Install anthropic SDK for ClaudeModel support
RUN pip install --break-system-packages anthropic || true

# Preflight check to verify installations
RUN python -c 'import pkg_resources, pytest; print("preflight ok")' && \
    python -c 'import mle; print("mle package imported successfully")' || true

CMD ["/bin/bash"]
