# Install system dependencies if needed (for some Python packages)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        && rm -rf /var/lib/apt/lists/*

# Install project dependencies using uv (as per pyproject.toml and README)
# The project uses uv for dependency management (uv.lock may not exist, but uv is in dependencies).
# We'll install uv, then sync dependencies.
RUN python -m pip install --upgrade pip wheel && \
    pip install uv && \
    # Use uv sync to install dependencies (including dev dependencies) as per pyproject.toml
    uv sync --dev --all-extras && \
    # Install mandatory test dependencies (some may already be installed via dev dependencies)
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Preflight import check to verify core modules can be imported
RUN python -c "import crewai; import pytest; print('preflight ok')"

# Set PYTHONPATH to ensure tests can import the package directly (no editable install to avoid duplicate module loading)
ENV PYTHONPATH=/app

