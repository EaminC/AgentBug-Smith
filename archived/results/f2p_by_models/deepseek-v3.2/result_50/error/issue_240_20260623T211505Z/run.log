                {"ran": True, "works": False, "perfect": False, "comments": "test"}
            )
        )
        with patch("subprocess.run") as mock_run:
            mock_run.return_value.returncode = 0
            with patch("builtins.input", return_value="n"):
                # The buggy version signature is main(n_benchmarks: Union[int, None] = None)
                # and does not accept a path argument. Passing a string will be interpreted as n_benchmarks.
                # That will cause ValueError because islice expects integer.
                # After fix, the signature is the same, but the script uses Path("benchmark") hardcoded.
                # So we cannot pass a path. We'll just call main() and let it use default benchmark folder.
                # But we need to mock the benchmark folder location. Instead we change cwd.
                original_cwd = Path.cwd()
                try:
                    os.chdir(tmpdir)
                    # Create benchmark folder at cwd
                    (Path(tmpdir) / "benchmark").mkdir(exist_ok=True)
                    bench = Path(tmpdir) / "benchmark" / "bench1"
                    bench.mkdir(exist_ok=True)
                    (bench / "prompt").write_text("prompt")
                    memory = bench / "memory"
                    memory.mkdir(exist_ok=True)
                    (memory / "review").write_text(
                        json.dumps(
                            {"ran": True, "works": False, "perfect": False, "comments": "test"}
                        )
                    )
                    # Now call main
                    main()
                finally:
                    os.chdir(original_cwd)


def test_main_with_n_benchmarks():
    """
    Test that main works with n_benchmarks parameter (buggy version expects n_benchmarks as first arg).
    """
    from scripts.benchmark import main

    with tempfile.TemporaryDirectory() as tmpdir:
        benchmark_path = Path(tmpdir) / "benchmark"
        benchmark_path.mkdir()
        for i in range(3):
            bench = benchmark_path / f"bench{i}"
            bench.mkdir()
            (bench / "prompt").write_text("prompt")
            memory = bench / "memory"
            memory.mkdir()
            (memory / "review").write_text(
                json.dumps(
                    {"ran": True, "works": True, "perfect": False, "comments": f"bench{i}"}
                )
            )
        with patch("subprocess.run") as mock_run:
            mock_run.return_value.returncode = 0
            with patch("builtins.input", return_value="n"):
                # In buggy version, main expects n_benchmarks as first positional argument.
                # It will iterate over islice(benchmarks, n_benchmarks).
                # If we call main(2), it should run only 2 benchmarks.
                # However, the buggy version does not have generate_report, so it will run the benchmarks
                # and then exit without error (since generate_report is not called).
                # In fixed version, generate_report is called after the loop.
                # We'll mock the subprocess to avoid actually running gpt-engineer.
                mock_run.return_value.stdout = b""
                mock_run.return_value.stderr = b""
                # Change cwd to tmpdir so benchmark folder is found
                original_cwd = Path.cwd()
                try:
                    os.chdir(tmpdir)
                    main(n_benchmarks=2)
                finally:
                    os.chdir(original_cwd)
                # Check that subprocess.run was called twice (for two benchmarks)
                assert mock_run.call_count == 2


def test_benchmark_main_with_run_all():
    """
    Test main with run_all=True.
    """
