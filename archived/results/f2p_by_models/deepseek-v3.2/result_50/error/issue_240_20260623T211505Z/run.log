            "ran": True,
            "works": True,
            "perfect": True,
            "comments": ""
        }))
        benchmarks = [(bench_folder, None, None)]
        with patch("builtins.print") as mock_print, \
             patch("scripts.benchmark.ask_yes_no", return_value=False):
            generate_report(benchmarks, benchmark_path)
        # Check that print was called with a table (contains pipe table headers)
        assert mock_print.called
        # At least one print call should contain a pipe character (markdown table)
