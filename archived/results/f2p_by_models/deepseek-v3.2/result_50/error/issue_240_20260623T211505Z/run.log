        (memory / "review").write_text(
            json.dumps({"ran": True, "works": True, "perfect": False, "comments": "Works but not perfect"})
        )

        # Mock subprocess.run to simulate successful run
        with patch("subprocess.run") as mock_run:
            mock_run.return_value.returncode = 0
            # Mock input to say 'n' for not appending to results
            with patch("builtins.input", return_value="n"):
                # The buggy version expects a single argument (n_benchmarks) but we pass path.
                # After fix, main should accept path as first argument.
                # We'll call main with the path as positional argument.
                # In buggy version, this will cause TypeError because main expects n_benchmarks only.
                try:
                    main(str(benchmark_path))
                except TypeError as e:
                    # Buggy version: main() got an unexpected keyword argument 'path'
                    # or multiple values for argument 'n_benchmarks'
                    # We expect this error in buggy version.
                    # The test passes (i.e., fails) if we get this error.
                    raise AssertionError(f"Buggy version cannot accept path argument: {e}")

def test_benchmark_ask_for_feedback_and_generate_report():
    """
    Test that generate_report is called and uses the review file.
    """
    from scripts.benchmark import generate_report, to_emoji, ask_yes_no, insert_markdown_section

    with tempfile.TemporaryDirectory() as tmpdir:
        benchmark_path = Path(tmpdir) / "benchmark"
        benchmark_path.mkdir()
        bench = benchmark_path / "bench1"
        bench.mkdir()
        memory = bench / "memory"
        memory.mkdir()
        (memory / "review").write_text(
            json.dumps({"ran": True, "works": False, "perfect": False, "comments": "test"})
        )

        # Mock print and input
        with patch("builtins.print") as mock_print:
            with patch("builtins.input", return_value="n"):
                generate_report([(bench, None, None)], benchmark_path)
                # Check that print was called with table
                assert mock_print.called

    # Test to_emoji
    assert to_emoji(True) == "✅"
    assert to_emoji(False) == "❌"

    # Test ask_yes_no
    with patch("builtins.input", side_effect=["y"]):
        assert ask_yes_no("test") == True
    with patch("builtins.input", side_effect=["n"]):
        assert ask_yes_no("test") == False

    # Test insert_markdown_section
    test_file = Path(tmpdir) / "test.md"
    test_file.write_text("# Title\n\n## Existing Section\n\nContent")
    insert_markdown_section(test_file, "New Section", "New text", 2)
    content = test_file.read_text()
    assert "## New Section" in content

