    with tempfile.TemporaryDirectory() as tmpdir:
        benchmark_path = Path(tmpdir) / "benchmark"
        benchmark_path.mkdir()
        for i in range(5):
            bench = benchmark_path / f"bench{i}"
            bench.mkdir()
            (bench / "prompt").write_text("prompt")
            memory = bench / "memory"
            memory.mkdir()
            (memory / "review").write_text(
                json.dumps(
                    {"ran": True, "works": False, "perfect": False, "comments": "test"}
                )
            )
        with patch("subprocess.run") as mock_run:
            mock_run.return_value.returncode = 0
            with patch("builtins.input", return_value="n"):
                # The buggy version does not accept run_all parameter.
                # After fix, main should accept n_benchmarks (not run_all).
                # We test that main can be called with n_benchmarks=None (default).
                try:
                    main(run_all=True)
                except TypeError as e:
                    # Buggy version: main() got an unexpected keyword argument 'run_all'
                    assert "run_all" in str(e)
                    # Now call without run_all (should work for buggy version)
                    main()
                else:
                    # Fixed version: run_all is not a parameter, but the function signature hasn't changed.
                    # Actually the fixed version still has the same signature: main(n_benchmarks: Union[int, None] = None)
                    # So calling main(run_all=True) should still raise TypeError.
                    # If we reach here, it means the signature changed unexpectedly.
                    pass


