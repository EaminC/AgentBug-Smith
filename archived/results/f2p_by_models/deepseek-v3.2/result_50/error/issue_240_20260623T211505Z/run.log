def test_insert_markdown_section():
    """
    Test insert_markdown_section function.
    """
    from scripts.benchmark import insert_markdown_section
    with tempfile.NamedTemporaryFile(mode='w', suffix='.md', delete=False) as f:
        f.write("# Title\n\nSome text\n\n## Existing Section\n\nMore text\n")
        fname = f.name
    try:
        insert_markdown_section(fname, "New Section", "New content", 2)
        with open(fname) as f:
            content = f.read()
        assert "## New Section" in content
        assert "New content" in content
        # Check that new section is inserted before the first level‑2 header
        lines = content.splitlines()
        # Find the first level‑2 header after the new section
        new_idx = lines.index("## New Section")
        existing_idx = lines.index("## Existing Section")
        assert new_idx < existing_idx
    finally:
        os.unlink(fname)


def test_insert_markdown_section_no_section():
    """
    Test insert_markdown_section when no section of the given level exists.
    Should print error and not write.
    """
    from scripts.benchmark import insert_markdown_section
    with tempfile.NamedTemporaryFile(mode='w', suffix='.md', delete=False) as f:
        f.write("# Only level 1\n\nNo level 3 here.\n")
        fname = f.name
    try:
        # Capture print output
        import io
        from contextlib import redirect_stdout
        out = io.StringIO()
        with redirect_stdout(out):
            insert_markdown_section(fname, "New", "content", 3)  # level 3 not present
        output = out.getvalue()
        assert "Markdown file was of unexpected format" in output
        # File should be unchanged
        with open(fname) as f:
            assert f.read() == "# Only level 1\n\nNo level 3 here.\n"
    finally:
        os.unlink(fname)


def test_ask_yes_no():
    """
    Test ask_yes_no function.
    """
    from scripts.benchmark import ask_yes_no
    with patch('builtins.input', side_effect=['y']):
        assert ask_yes_no("Test") is True
    with patch('builtins.input', side_effect=['n']):
        assert ask_yes_no("Test") is False
    with patch('builtins.input', side_effect=['x', 'y']):
        import io
        from contextlib import redirect_stdout
        out = io.StringIO()
        with redirect_stdout(out):
            result = ask_yes_no("Test")
        assert "Please enter either 'y' or 'n'." in out.getvalue()
        assert result is True


