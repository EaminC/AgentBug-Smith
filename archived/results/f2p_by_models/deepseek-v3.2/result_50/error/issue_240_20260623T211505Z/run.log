def test_generate_report_with_multiple_benchmarks():
    """
    Test generate_report with multiple benchmark folders.
    """
    from scripts.benchmark import generate_report
    with tempfile.TemporaryDirectory() as tmpdir:
        benchmark_path = Path(tmpdir)
        benchmarks = []
        for i in range(3):
            bench = benchmark_path / f"bench{i}"
            bench.mkdir()
            memory = bench / "memory"
            memory.mkdir()
            review = memory / "review"
            review.write_text(json.dumps({
                "ran": i % 2 == 0,
                "works": True,
                "perfect": i == 2,
                "comments": f"comment{i}"
            }))
            benchmarks.append((bench, None, None))
        with patch('scripts.benchmark.ask_yes_no', return_value=False):
            import io
            from contextlib import redirect_stdout
            out = io.StringIO()
            with redirect_stdout(out):
                generate_report(benchmarks, benchmark_path)
            output = out.getvalue()
            assert "bench0" in output
            assert "bench1" in output
            assert "bench2" in output

