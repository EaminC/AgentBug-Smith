def test_insert_markdown_section():
    """
    Test insert_markdown_section creates a new section at the correct level.
    """
    from scripts.benchmark import insert_markdown_section

    with tempfile.NamedTemporaryFile(mode="w", suffix=".md", delete=False) as f:
        f.write("# Existing\n\nSome text\n\n## Another\n\nMore text\n")
        f.flush()
        file_path = Path(f.name)

    try:
        insert_markdown_section(file_path, "New Section", "New content", level=2)

        with open(file_path) as f:
            content = f.read()

        expected = "## New Section\n\nNew content\n\n# Existing\n\nSome text\n\n## Another\n\nMore text\n\n"
        assert content == expected, f"Expected:\n{expected}\nGot:\n{content}"
    finally:
        os.unlink(file_path)


def test_insert_markdown_section_no_section():
    """
    Test insert_markdown_section when no section of the given level exists.
    """
    from scripts.benchmark import insert_markdown_section

    with tempfile.NamedTemporaryFile(mode="w", suffix=".md", delete=False) as f:
        f.write("# Only level 1\n\nText\n")
        f.flush()
        file_path = Path(f.name)

    original_content = file_path.read_text()

    try:
        # This should print a warning and not modify the file
        insert_markdown_section(file_path, "New", "Content", level=3)
        # File should remain unchanged
        assert file_path.read_text() == original_content
    finally:
        os.unlink(file_path)


def test_ask_yes_no():
    """
    Test ask_yes_no returns True for 'y' and False for 'n'.
    """
    from scripts.benchmark import ask_yes_no

    with patch("builtins.input", return_value="y"):
        assert ask_yes_no("Test?") is True

    with patch("builtins.input", return_value="n"):
        assert ask_yes_no("Test?") is False

    # Test invalid input followed by valid
    inputs = ["invalid", "y"]
    with patch("builtins.input", side_effect=inputs):
        assert ask_yes_no("Test?") is True


