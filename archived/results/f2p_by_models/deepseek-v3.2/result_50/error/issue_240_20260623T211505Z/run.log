def test_generate_report_with_mocked_review():
    """
    Test generate_report reads review files and creates table.
    """
    from scripts.benchmark import generate_report
    with tempfile.TemporaryDirectory() as tmpdir:
        benchmark_path = Path(tmpdir) / "benchmark"
        benchmark_path.mkdir()
        # Create two benchmark folders with memory/review
        for i in range(2):
            bench = benchmark_path / f"bench{i}"
            bench.mkdir()
            memory = bench / "memory"
            memory.mkdir()
            (memory / "review").write_text(
                json.dumps(
                    {"ran": True, "works": False, "perfect": True, "comments": f"note{i}"}
                )
            )
        # Mock tabulate and ask_yes_no
        with patch("scripts.benchmark.tabulate") as mock_tabulate:
            mock_tabulate.return_value = "mock table"
            with patch("scripts.benchmark.ask_yes_no", return_value=False):
                with patch("builtins.print") as mock_print:
                    generate_report([(benchmark_path / "bench0", None, None),
                                     (benchmark_path / "bench1", None, None)],
                                    benchmark_path)
        # Ensure tabulate was called with correct rows
        mock_tabulate.assert_called_once()
        rows = mock_tabulate.call_args[0][0]
        assert len(rows) == 2
        assert rows[0][0] == "bench0"
        assert rows[0][1] == "✅"
        assert rows[0][2] == "❌"
        assert rows[0][3] == "✅"
        assert rows[0][4] == "note0"


def test_generate_report_creates_table():
    """
    Test generate_report creates a table with proper headers.
    """
    from scripts.benchmark import generate_report
    with tempfile.TemporaryDirectory() as tmpdir:
        benchmark_path = Path(tmpdir) / "benchmark"
        benchmark_path.mkdir()
        bench = benchmark_path / "test"
        bench.mkdir()
        memory = bench / "memory"
        memory.mkdir()
        (memory / "review").write_text(
            json.dumps({"ran": False, "works": True, "perfect": False, "comments": ""})
        )
        with patch("scripts.benchmark.ask_yes_no", return_value=False):
            with patch("scripts.benchmark.tabulate") as mock_tabulate:
                mock_tabulate.return_value = "| Benchmark | Ran | Works | Perfect | Notes |"
                generate_report([(bench, None, None)], benchmark_path)
                mock_tabulate.assert_called_once()
                headers = mock_tabulate.call_args[0][1]
                assert headers == ["Benchmark", "Ran", "Works", "Perfect", "Notes"]


def test_benchmark_main_with_feedback_step():
    """
    Test that main runs the feedback step (generate_report) after processing benchmarks.
    In buggy version, generate_report does not exist, so the call will fail.
    """
    from scripts.benchmark import main
    with tempfile.TemporaryDirectory() as tmpdir:
        benchmark_path = Path(tmpdir) / "benchmark"
        benchmark_path.mkdir()
        bench_folder = benchmark_path / "test_bench"
        bench_folder.mkdir()
        (bench_folder / "prompt").write_text("Test prompt")
        memory_folder = bench_folder / "memory"
        memory_folder.mkdir()
        review_file = memory_folder / "review"
        review_data = {
            "ran": True,
            "works": True,
            "perfect": True,
            "comments": "",
        }
        review_file.write_text(json.dumps(review_data))
        with patch("subprocess.run") as mock_run:
            mock_run.return_value.returncode = 0
            with patch("builtins.input", return_value="n"):
                # In buggy version, generate_report is not defined, so main will raise NameError.
                # After fix, main should call generate_report (we mock it to avoid side effects).
                try:
                    with patch("scripts.benchmark.generate_report") as mock_gen:
                        main(str(benchmark_path))
                except (NameError, AttributeError):
                    # Buggy version: generate_report not defined
                    raise AssertionError("generate_report missing in buggy version")
                # Fixed version: generate_report should be called
                mock_gen.assert_called_once()


