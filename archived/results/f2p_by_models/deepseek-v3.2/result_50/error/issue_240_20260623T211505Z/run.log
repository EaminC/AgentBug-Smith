def test_benchmark_main_with_feedback_step():
    """
    Test that the benchmark script can run with the new feedback step.
    """
    from scripts.benchmark import main

    with tempfile.TemporaryDirectory() as tmpdir:
        benchmark_path = Path(tmpdir) / "benchmark"
        benchmark_path.mkdir()
        # Create a benchmark folder with prompt and memory/review
        bench = benchmark_path / "test_bench"
        bench.mkdir()
        (bench / "prompt").write_text("prompt")
        memory = bench / "memory"
        memory.mkdir()
        (memory / "review").write_text(
            json.dumps(
                {"ran": True, "works": False, "perfect": False, "comments": "test"}
            )
        )
        # Mock subprocess.run to avoid actually running gpt-engineer
        with patch("subprocess.run") as mock_run:
            mock_run.return_value.returncode = 0
            # Mock input to answer 'n' to not append results
            with patch("builtins.input", return_value="n"):
                # The buggy version expects a single argument (path) but the fixed version
                # expects n_benchmarks as first argument (default None).
                # We call with the path as positional argument (which will be interpreted as n_benchmarks
                # in buggy version, causing ValueError because path is not int).
                # After fix, main should accept path as first argument (positional) and n_benchmarks as keyword.
                # However the fixed main signature is main(n_benchmarks: Union[int, None] = None)
                # and path is not a parameter. The buggy version has the same signature.
                # The issue is that the buggy version does not have the generate_report logic.
                # But the test should fail on buggy because the buggy version does not have the
                # generate_report function and will not ask for feedback.
                # Actually the buggy version does not have the generate_report call at all.
                # So we can test that after the fix, the generate_report is called (or at least
                # the script runs without error and prints the table).
                # We'll just run main with the default argument (n_benchmarks=None) and ensure
                # it doesn't crash with AttributeError (missing generate_report).
                try:
                    main()
                except AttributeError as e:
                    if "generate_report" in str(e):
                        # Buggy version: generate_report not defined
                        raise AssertionError("Buggy version missing generate_report") from e
                    else:
                        raise
                # If we reach here, the fixed version passes (no AttributeError).
                # For buggy version, it will raise ValueError because path is not int.
                # That's fine - the test will fail as expected.

def test_benchmark_ask_for_feedback_and_generate_report():
    """
    Test that the benchmark script asks for feedback and generates a report.
    """
    from scripts.benchmark import generate_report, to_emoji, insert_markdown_section, ask_yes_no

    # Test to_emoji
    assert to_emoji(True) == "✅"
    assert to_emoji(False) == "❌"

    # Test ask_yes_no with mocked input
    with patch("builtins.input", side_effect=["y"]):
        assert ask_yes_no("test") == True
    with patch("builtins.input", side_effect=["n"]):
        assert ask_yes_no("test") == False
    with patch("builtins.input", side_effect=["invalid", "y"]):
        assert ask_yes_no("test") == True

    # Test insert_markdown_section
    with tempfile.TemporaryDirectory() as tmpdir:
        md_file = Path(tmpdir) / "test.md"
        md_file.write_text("# Title\n\nSome content\n## Section 1\nMore\n")
        insert_markdown_section(md_file, "New Section", "new text", 2)
        content = md_file.read_text()
        assert "## New Section" in content
        assert "new text" in content

    # Test generate_report with mocked benchmarks
    with tempfile.TemporaryDirectory() as tmpdir:
        benchmark_path = Path(tmpdir) / "benchmark"
        benchmark_path.mkdir()
        bench = benchmark_path / "bench1"
        bench.mkdir()
        memory = bench / "memory"
        memory.mkdir()
        (memory / "review").write_text(
            json.dumps(
                {"ran": True, "works": True, "perfect": False, "comments": "great"}
            )
        )
        # Mock print and input to avoid side effects
        with patch("builtins.print") as mock_print:
            with patch("builtins.input", return_value="n"):
                generate_report([(bench, None, None)], benchmark_path)
        # Check that print was called with table
        assert any("Benchmark" in str(call) for call in mock_print.call_args_list)

