def test_insert_markdown_section():
    """
    Test insert_markdown_section function.
    """
    from scripts.benchmark import insert_markdown_section
    with tempfile.NamedTemporaryFile(mode="w+", suffix=".md", delete=False) as f:
        f.write("# Title\n\nSome content\n## Existing\nMore content\n")
        f.flush()
        file_path = Path(f.name)
        insert_markdown_section(file_path, "New Section", "New text", 2)
        content = file_path.read_text()
        assert "## New Section\n\nNew text\n\n" in content
        # Ensure existing content is preserved
        assert "## Existing" in content
    os.unlink(f.name)

