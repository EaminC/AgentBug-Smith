def test_insert_markdown_section():
    """
    Test insert_markdown_section function.
    """
    with tempfile.NamedTemporaryFile(mode="w", suffix=".md", delete=False) as f:
        f.write("# Title\n\nSome text\n\n## Existing Section\n\nContent\n")
        fpath = f.name
    try:
