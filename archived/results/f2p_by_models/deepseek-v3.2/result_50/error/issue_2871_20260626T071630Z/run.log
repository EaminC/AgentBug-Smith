[32mFROM python:3.12-slim AS test_builder

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Install system dependencies for browsers and utilities (based on original Dockerfile)
RUN apt-get update && apt-get install -y \
    chromium-driver firefox-esr \
    ca-certificates curl jq wget git \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="$PATH:/root/.local/bin"

WORKDIR /app

# Copy entire repository (critical for test script injection)
COPY . .

# Detect src/ layout: if src/ exists and contains Python modules, assume src layout.
# This project appears to have autogpt/ directly in root, not inside src/.
# Check if there's a src/ directory with Python files; if not, we can do editable install.
RUN if [ -d "src" ] && find src -name "*.py" | head -1 > /dev/null; then \
        echo "src layout detected, skipping editable install to avoid duplicate module loading"; \
        echo "Setting PYTHONPATH to /app instead."; \
        export PYTHONPATH=/app; \
    else \
        echo "No src layout detected, proceeding with editable install."; \
    fi

# Install dependencies based on repository evidence
# requirements.txt exists, use it.
RUN python -m pip install --upgrade pip wheel && \
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi && \
    # Install the project in editable mode (if no src layout) else just install test dependencies
    if [ -d "src" ] && find src -name "*.py" | head -1 > /dev/null; then \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Preflight import check to ensure core modules are reachable
RUN if [ -d "src" ] && find src -name "*.py" | head -1 > /dev/null; then \
        PYTHONPATH=/app python -c "import pytest; import autogpt; print('preflight ok')"; \
    else \
        python -c "import pytest; import autogpt; print('preflight ok')"; \
    fi

# Set PYTHONPATH if src layout detected
ENV PYTHONPATH=/app

# Default command (as per original Dockerfile entrypoint, but we keep bash for test harness)
CMD ["/bin/bash"][0m
