    try:
        # Patch the _LOG_DIR and _LOG_PATH constants used in the module
        with patch('examples.agent.deep_research_agent.deep_research_agent._LOG_DIR', tmpdir):
            with patch('examples.agent.deep_research_agent.deep_research_agent._LOG_PATH', os.path.join(tmpdir, 'test.log')):
                # Create agent with minimal configuration
                agent = DeepResearchAgent(
                    name="test_agent",
