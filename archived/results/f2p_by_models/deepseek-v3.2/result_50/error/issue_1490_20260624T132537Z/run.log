from agentscope.agent import DeepResearchAgent
from agentscope.model import ModelBase
from agentscope.tool import Toolkit


class MockModel(ModelBase):
    """Mock model that returns configurable blocks."""
    def __init__(self, blocks=None):
        super().__init__(config={"model_name": "mock"})
        self.blocks = blocks or []
        self.stream = False

    async def __call__(self, *args, **kwargs):
        # Return a mock response with blocks
        return Mock(blocks=self.blocks)


class MockToolkit(Toolkit):
    """Mock toolkit with minimal implementation."""
    def __init__(self):
        super().__init__(name="mock_toolkit")
        self.tools = {}

    def register_tool_function(self, func):
        self.tools[func.__name__] = func


