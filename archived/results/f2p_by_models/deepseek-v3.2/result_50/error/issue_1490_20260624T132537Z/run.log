        mock_model_instance = MagicMock()
        mock_model_instance.stream = False
        MockModel.return_value = mock_model_instance
        agent = DeepResearchAgent(
            name="test",
            model_config={"model_name": "test"},
            user_query="test query",
        )
        # Test with thinking + text blocks
        blocks = [
            {"type": "thinking", "thinking": "think"},
            {"type": "text", "text": "expected text"},
        ]
        result = agent._extract_text_from_blocks(blocks)
        assert result == "expected text"
        # Test with only text block
        blocks = [{"type": "text", "text": "single"}]
        result = agent._extract_text_from_blocks(blocks)
        assert result == "single"
        # Test with no text block -> should raise ValueError
        blocks = [{"type": "thinking", "thinking": "only"}]
        with pytest.raises(ValueError):
            agent._extract_text_from_blocks(blocks)


