    assert extracted == "final answer"

    # Test case 2: blocks with only text (no thinking)
    blocks_only_text = [{"type": "text", "text": "direct answer"}]
    extracted = agent._extract_text_from_blocks(blocks_only_text)
    assert extracted == "direct answer"

    # Test case 3: blocks with multiple text entries (should return first text)
    blocks_multiple = [
        {"type": "thinking", "thinking": "thought"},
        {"type": "text", "text": "first text"},
        {"type": "text", "text": "second text"},
    ]
    extracted = agent._extract_text_from_blocks(blocks_multiple)
    assert extracted == "first text"

