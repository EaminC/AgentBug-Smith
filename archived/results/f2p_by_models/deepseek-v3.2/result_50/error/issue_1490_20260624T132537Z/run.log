                assert "No text block found" in str(e)

            # Test case 6: blocks with missing type key
            blocks_missing_type = [
                {"text": "Missing type"},
            ]
            try:
                agent._extract_text_from_blocks(blocks_missing_type)
                assert False, "Expected ValueError"
            except ValueError as e:
                assert "No text block found" in str(e)


