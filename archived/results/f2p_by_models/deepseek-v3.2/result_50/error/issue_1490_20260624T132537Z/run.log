def test_deep_research_agent_extract_text_from_blocks():
    """Test that _extract_text_from_blocks correctly extracts text from blocks.

    In buggy code, blocks[0]["text"] assumes first block has "text" key.
    In fixed code, _extract_text_from_blocks iterates and finds block with type "text".
    """
    # Create a minimal agent instance to test the method
    # We need to mock the model because DeepResearchAgent requires one.
    mock_model = MagicMock(spec=OpenAIModel)
    mock_model.name = "mock"
    mock_model.stream = False

    # Use a temporary directory for logs to avoid permission issues
    with tempfile.TemporaryDirectory() as tmpdir:
        # Patch the global constants used in DeepResearchAgent __init__
        with patch(
            "examples.agent.deep_research_agent.deep_research_agent._LOG_DIR",
            tmpdir,
        ), patch(
            "examples.agent.deep_research_agent.deep_research_agent._LOG_PATH",
            os.path.join(tmpdir, "log.md"),
        ):
            agent = DeepResearchAgent(
                name="test_agent",
                model=mock_model,
                user_query="test query",
            )

    # Test case 1: blocks with thinking first, then text (as in Qwen3.5)
    blocks = [
        {"type": "thinking", "thinking": "some thought"},
        {"type": "text", "text": "final answer"},
    ]
    result = agent._extract_text_from_blocks(blocks)
    assert result == "final answer"

    # Test case 2: blocks with only text (non-thinking models)
    blocks2 = [{"type": "text", "text": "direct answer"}]
    result2 = agent._extract_text_from_blocks(blocks2)
    assert result2 == "direct answer"

    # Test case 3: no text block raises ValueError
    blocks3 = [{"type": "thinking", "thinking": "only thinking"}]
    try:
        agent._extract_text_from_blocks(blocks3)
        assert False, "Expected ValueError"
    except ValueError as e:
        assert "No text block found" in str(e)

    # Test case 4: empty blocks list raises ValueError
    blocks4 = []
    try:
        agent._extract_text_from_blocks(blocks4)
        assert False, "Expected ValueError"
    except ValueError as e:
        assert "No text block found" in str(e)


