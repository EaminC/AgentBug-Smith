def test_deep_research_agent_extract_text_from_blocks():
    """Test that _extract_text_from_blocks correctly extracts text from blocks."""
    # Create a minimal agent instance with mocked dependencies
    with tempfile.TemporaryDirectory() as tmpdir:
        # Mock the model to avoid real API calls
        mock_model = MagicMock(spec=ModelWrapperBase)
        mock_model.stream = False
