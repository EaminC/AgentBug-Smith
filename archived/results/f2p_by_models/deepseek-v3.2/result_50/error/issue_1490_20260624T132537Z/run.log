def test_deep_research_agent_extract_text_from_blocks() -> None:
    """Test that _extract_text_from_blocks correctly extracts text from blocks."""
    agent = DeepResearchAgent(
        name="test_agent",
        model=MockModelWrapper([]),
        user_query="test query",
        max_subtask_num=1,
        max_iterations_per_subtask=1,
        max_parallel_tool_calls=1,
