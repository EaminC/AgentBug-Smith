    """Test that the buggy code raises KeyError when blocks[0] is a thinking block."""
    # Create a minimal agent instance with mocked dependencies
    model = MockModel()
    toolkit = MockToolkit()
    agent = DeepResearchAgent(
        model=model,
        toolkit=toolkit,
        user_query="test query",
        expected_output_items=["item1"],
        max_subtasks=1,
        max_rounds_per_subtask=1,
    )

    # Simulate the buggy scenario: blocks where first block is thinking, second is text
    blocks = [
        {"type": "thinking", "thinking": "some thought"},
        {"type": "text", "text": "actual report"},
    ]

    # In buggy code, agent._extract_text_from_blocks does not exist,
    # and the code directly accesses blocks[0]["text"].
    # We'll directly test the line that fails in buggy version.
    # Since the buggy code doesn't have the helper method, we simulate the exact line.
    # However, we need to test the actual buggy behavior, so we'll call the method
    # that uses the buggy line. We'll mock the model's a_generate to return these blocks.
    # But the bug is in _generate_deepresearch_report, which is private.
    # Instead, we can test the public method that eventually calls that.
    # But to keep it simple, we'll directly test the buggy line by patching
    # the model's a_generate to return blocks and then call the method that fails.

    # However, the buggy code is in _generate_deepresearch_report at line 931.
    # We'll call that method via reflection.
    # First, set up necessary state to avoid other errors.
    agent.current_subtask = []
    agent.prompt_dict = {
        "reporting_sys_prompt": "Report: {original_task} {checklist}",
    }
    agent.user_query = "test"
    agent.expected_output_items = ["item1"]
    agent.toolkit = toolkit

    # Mock the model's a_generate to return the blocks that cause KeyError
    async def mock_a_generate(msgs, **kwargs):
        # Return a dict that the agent's code expects.
        # The buggy code expects blocks = response.choices[0].message.content
        # but actually blocks is the content directly? Let's examine the buggy code:
        # blocks = await self.model.a_generate(...)
        # final_report_content = blocks[0]["text"]
        # So blocks is the list returned by the model's a_generate.
        # We'll return the blocks list directly.
        return blocks

    agent.model.a_generate = mock_a_generate

    # Now call _generate_deepresearch_report with a dummy checklist
    # This should raise KeyError in buggy code.
    with pytest.raises(KeyError) as exc_info:
        asyncio.run(agent._generate_deepresearch_report(checklist=["check1"]))
    assert "text" in str(exc_info.value)

def test_extract_text_from_blocks_fixed():
    """Test that the fixed code correctly extracts text from blocks with thinking block first."""
    # Create agent instance with mocked dependencies
    model = MockModel()
    toolkit = MockToolkit()
    agent = DeepResearchAgent(
        model=model,
        toolkit=toolkit,
        user_query="test query",
        expected_output_items=["item1"],
        max_subtasks=1,
        max_rounds_per_subtask=1,
    )

    # Simulate the same blocks
    blocks = [
        {"type": "thinking", "thinking": "some thought"},
        {"type": "text", "text": "actual report"},
    ]

    # After fix, the agent has _extract_text_from_blocks method.
    # Call it directly.
    result = agent._extract_text_from_blocks(blocks)
    assert result == "actual report"

    # Test with blocks where text is first (non-thinking model)
    blocks2 = [
        {"type": "text", "text": "direct report"},
    ]
    result2 = agent._extract_text_from_blocks(blocks2)
    assert result2 == "direct report"

    # Test with no text block raises ValueError
    blocks3 = [
        {"type": "thinking", "thinking": "only thinking"},
    ]
    with pytest.raises(ValueError) as exc_info:
        agent._extract_text_from_blocks(blocks3)
    assert "No text block found" in str(exc_info.value)

