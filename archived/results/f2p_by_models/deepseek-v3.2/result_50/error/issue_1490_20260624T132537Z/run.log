                assert result == "Direct answer.", f"Expected 'Direct answer.', got {result}"

                # Case 3: blocks with text block not first
                blocks_mixed = [
                    {"type": "thinking", "thinking": "Think..."},
                    {"type": "thinking", "thinking": "More thinking..."},
                    {"type": "text", "text": "Final answer."},
                ]
                result = agent._extract_text_from_blocks(blocks_mixed)
                assert result == "Final answer.", f"Expected 'Final answer.', got {result}"

                # Case 4: no text block - should raise ValueError
