            mock_toolkit_class.return_value = mock_toolkit

            # Create agent with minimal configuration
            agent = DeepResearchAgent(
                name="test_agent",
                model=mock_model,
                user_query="test query",
                working_dir=tmpdir,
                max_subtasks=1,
                max_retries=0,
                enable_mcp=False,
            )

            # Test case 1: blocks with thinking first, then text
            blocks_with_thinking = [
                {"type": "thinking", "thinking": "I will think about this"},
                {"type": "text", "text": "This is the actual answer"},
            ]
            result = agent._extract_text_from_blocks(blocks_with_thinking)
            assert result == "This is the actual answer"

            # Test case 2: blocks with only text (non-thinking models)
            blocks_only_text = [
                {"type": "text", "text": "Direct answer"},
            ]
            result = agent._extract_text_from_blocks(blocks_only_text)
            assert result == "Direct answer"

            # Test case 3: multiple blocks, text not first
            blocks_multiple = [
                {"type": "thinking", "thinking": "First thought"},
                {"type": "thinking", "thinking": "Second thought"},
                {"type": "text", "text": "Final answer"},
                {"type": "thinking", "thinking": "After thought"},
            ]
            result = agent._extract_text_from_blocks(blocks_multiple)
            assert result == "Final answer"

            # Test case 4: no text block - should raise ValueError
            blocks_no_text = [
                {"type": "thinking", "thinking": "Only thinking"},
                {"type": "code", "code": "print('hello')"},
            ]
            try:
                agent._extract_text_from_blocks(blocks_no_text)
                assert False, "Expected ValueError"
            except ValueError as e:
                assert "No text block found" in str(e)

            # Test case 5: empty blocks list
