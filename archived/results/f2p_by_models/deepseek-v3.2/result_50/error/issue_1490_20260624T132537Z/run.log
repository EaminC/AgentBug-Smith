def test_deepresearchagent_extract_text_from_blocks():
    """Test that DeepResearchAgent correctly extracts text from blocks with thinking block."""
    # Import inside the test to ensure it's only imported when the test runs
    from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent

    # Create a mock model that returns blocks with thinking block first
    mock_model = MagicMock()
