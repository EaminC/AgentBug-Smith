def test_fixed_extract_text_from_blocks():
    """Test that fixed _extract_text_from_blocks method works correctly."""
    model = MockModel()
    with patch.object(DeepResearchAgent, '_ensure_mcp_initialized', new_callable=AsyncMock):
        with patch.object(DeepResearchAgent, '_load_prompt_dict') as mock_load:
            mock_load.return_value = {
                "summarize_sys_prompt": "",
                "reporting_sys_prompt": "",
            }
            with patch('os.makedirs'):
                agent = DeepResearchAgent(
                    model=model,
                    user_query="test query",
                    expected_output_items=["item1"],
                    max_subtasks=1,
                    max_rounds_per_subtask=1,
                )
                # Test extraction with thinking block first
                blocks = [
                    {"type": "thinking", "thinking": "some thought"},
                    {"type": "text", "text": "final answer"},
                ]
                result = agent._extract_text_from_blocks(blocks)
                assert result == "final answer"
                # Test extraction with text block first (non-thinking model)
                blocks2 = [
                    {"type": "text", "text": "direct answer"},
                ]
                result2 = agent._extract_text_from_blocks(blocks2)
                assert result2 == "direct answer"
                # Test no text block raises ValueError
                blocks3 = [
                    {"type": "thinking", "thinking": "thought"},
                ]
                with pytest.raises(ValueError, match="No text block found"):
                    agent._extract_text_from_blocks(blocks3)


