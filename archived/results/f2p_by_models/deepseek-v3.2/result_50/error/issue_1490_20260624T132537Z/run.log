def test_buggy_code_would_fail():
    """Explicit test that demonstrates what the buggy code would do."""
    # Simulate the buggy code's behavior
    blocks = [
        {"type": "thinking", "thinking": "I'm thinking"},
        {"type": "text", "text": "Actual answer"},
    ]

    # This is what the buggy code does:
    try:
        result = blocks[0]["text"]  # This raises KeyError in buggy code
        # If we get here, the code is not buggy (or blocks[0] has 'text')
        # But in our test case, blocks[0] doesn't have 'text', so this should fail
        # for buggy code
        if "text" not in blocks[0]:
            # This line won't be reached because KeyError would have been raised
            # But if it is reached, it means the test setup is wrong
            raise KeyError("'text'")
    except KeyError as e:
        if str(e) == "'text'":
            # This is expected for buggy code
            # Our test should catch this and fail when running on buggy code
            # But pass when running on fixed code
            pass
        else:
            raise

    # For fixed code using _extract_text_from_blocks, this should work:
    with tempfile.TemporaryDirectory() as tmpdir:
        # Create a minimal agent to use the fixed method
        mock_model = MagicMock(spec=ModelWrapperBase)
        mock_model.stream = False
        
        with patch('examples.agent.deep_research_agent.deep_research_agent.Toolkit') as mock_toolkit_class:
            mock_toolkit = MagicMock()
            mock_toolkit.register_tool_function = MagicMock()
            mock_toolkit_class.return_value = mock_toolkit
            
            agent = DeepResearchAgent(
                name="test_agent",
                model=mock_model,
                user_query="test",
                working_dir=tmpdir,
                max_subtasks=1,
                max_retries=0,
                enable_mcp=False,
            )
            
            # This should work with fixed code
            result = agent._extract_text_from_blocks(blocks)
            assert result == "Actual answer"


