        blocks = [
            {"type": "thinking", "thinking": "Thinking..."},
            {"type": "text", "text": "Answer."}
        ]
        # If the buggy code is present, the following would raise KeyError
        # But since we are using the fixed method, it should work.
        try:
            result = agent._extract_text_from_blocks(blocks)
            assert result == "Answer.", f"Expected 'Answer.', got {result}"
        except KeyError:
            # This would happen in buggy code
            raise AssertionError("Buggy code triggered KeyError")

