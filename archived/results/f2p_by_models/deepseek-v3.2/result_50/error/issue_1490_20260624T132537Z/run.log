    agent._ensure_mcp_initialized = AsyncMock()
    agent._generate_deepresearch_report = AsyncMock()
    
    # Replace the model's achat with our mock that returns thinking blocks
    async def mock_achat(**kwargs):
        return {
            "blocks": [
                {"type": "thinking", "thinking": "Thinking about the report..."},
                {"type": "text", "text": "Final report content here."}
            ]
        }
    
    agent.model.achat = mock_achat
    
    # Test the summarize_intermediate_results method which uses blocks[0]["text"] in buggy code
    async def test_summarize():
        # Mock the current_subtask to avoid AttributeError
        class MockSubTask:
            def __init__(self):
                self.working_plan = None
                self.subtask_report = None
        
        agent.current_subtask = [MockSubTask()]
        
        # Mock the prompt_dict
        agent.prompt_dict = {
            "summarize_sys_prompt": "Summarize: {original_task}",
            "summarize_usr_prompt": "Please summarize"
        }
        
        # In buggy code, this will raise KeyError when accessing blocks[0]["text"]
