        try:
            result = await agent.summarize_intermediate_results()
            # If we get here in buggy code, the test should fail
            # But in fixed code, it should work
            assert result is not None
        except KeyError as e:
            if str(e) == "'text'":
                # This is the bug we're testing for
                # In buggy code, this exception is raised
                # The test should fail in buggy code, pass in fixed code
                raise AssertionError("KeyError 'text' occurred - buggy code detected")
    
    # Run the async test
    asyncio.run(test_summarize())

