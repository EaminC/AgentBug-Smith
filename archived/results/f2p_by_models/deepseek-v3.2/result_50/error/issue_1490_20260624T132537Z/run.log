def test_extract_text_from_blocks_buggy():
    """Test that buggy code raises KeyError when first block is thinking."""
    # Create a mock model that returns thinking block first
    mock_model = Mock()
    mock_model.stream = False
    mock_model.return_value = [{"type": "thinking", "thinking": "some thought"}, {"type": "text", "text": "final answer"}]

    # Create agent instance with minimal required args
    agent = DeepResearchAgent(
        name="test_agent",
        model=mock_model,
        user_query="test query",
        max_subtasks=1,
        max_iterations=1,
        enable_mcp=False,
    )

    # Simulate the buggy internal method call that would happen in summarize_intermediate_results
    # In buggy code, line 931 does blocks[0]["text"]
    blocks = [{"type": "thinking", "thinking": "thought"}, {"type": "text", "text": "answer"}]

    # In buggy version, _extract_text_from_blocks doesn't exist, so we directly test the buggy line
    # We'll call the real method if it exists (fixed version) else simulate buggy behavior
    if hasattr(agent, '_extract_text_from_blocks'):
        # Fixed version: should extract text correctly
        result = agent._extract_text_from_blocks(blocks)
        assert result == "answer"
    else:
        # Buggy version: accessing blocks[0]["text"] raises KeyError
        with pytest.raises(KeyError) as exc_info:
            _ = blocks[0]["text"]
        assert "text" in str(exc_info.value)

def test_extract_text_from_blocks_fixed():
    """Test that fixed code correctly extracts text block even with thinking block first."""
    # Create a mock model
    mock_model = Mock()
    mock_model.stream = False

    # Create agent instance
    agent = DeepResearchAgent(
        name="test_agent",
        model=mock_model,
        user_query="test query",
        max_subtasks=1,
        max_iterations=1,
        enable_mcp=False,
    )

    # Test case 1: thinking block first
    blocks1 = [{"type": "thinking", "thinking": "some thought"}, {"type": "text", "text": "final answer"}]
    if hasattr(agent, '_extract_text_from_blocks'):
        result = agent._extract_text_from_blocks(blocks1)
        assert result == "final answer"
    else:
        # Buggy version: should raise KeyError
        with pytest.raises(KeyError):
            _ = blocks1[0]["text"]

    # Test case 2: only text block (non-thinking model)
    blocks2 = [{"type": "text", "text": "only answer"}]
    if hasattr(agent, '_extract_text_from_blocks'):
        result = agent._extract_text_from_blocks(blocks2)
        assert result == "only answer"
    else:
        # Buggy version: works fine
        assert blocks2[0]["text"] == "only answer"

    # Test case 3: no text block (should raise ValueError in fixed version)
    blocks3 = [{"type": "thinking", "thinking": "thought"}]
    if hasattr(agent, '_extract_text_from_blocks'):
        with pytest.raises(ValueError) as exc_info:
            agent._extract_text_from_blocks(blocks3)
        assert "No text block found" in str(exc_info.value)
    else:
        # Buggy version: would raise KeyError
        with pytest.raises(KeyError):
            _ = blocks3[0]["text"]

def test_deepresearch_agent_with_qwen_model():
    """Integration test simulating Qwen3.5 model response with thinking block."""
    # Mock model that returns thinking block first
    mock_model = Mock()
    mock_model.stream = False
    mock_model.return_value = [{"type": "thinking", "thinking": "analyzing..."}, {"type": "text", "text": "research result"}]

    # Create agent
