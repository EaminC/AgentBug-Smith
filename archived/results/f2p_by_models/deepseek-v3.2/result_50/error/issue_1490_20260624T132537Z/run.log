from deep_research_agent.deep_research_agent import DeepResearchAgent

def test_extract_text_from_blocks():
    """Test that _extract_text_from_blocks correctly extracts text from blocks."""
    # Create a minimal instance with required arguments
    # We'll mock the model and toolkit to avoid actual initialization
    with patch.object(DeepResearchAgent, "__init__", lambda self, **kwargs: None):
        agent = DeepResearchAgent(model=None, toolkit=None)
        # Manually set the method since __init__ is mocked
        agent._extract_text_from_blocks = DeepResearchAgent._extract_text_from_blocks.__get__(agent)

        # Test case 1: blocks with thinking first, then text (buggy case)
        blocks = [
            {"type": "thinking", "thinking": "I am thinking..."},
            {"type": "text", "text": "This is the final answer."}
        ]
        result = agent._extract_text_from_blocks(blocks)
        assert result == "This is the final answer.", f"Expected 'This is the final answer.', got {result}"

        # Test case 2: blocks with only text (non-thinking model)
        blocks = [{"type": "text", "text": "Only text here."}]
        result = agent._extract_text_from_blocks(blocks)
        assert result == "Only text here.", f"Expected 'Only text here.', got {result}"

        # Test case 3: blocks with multiple text blocks (should return first)
        blocks = [
            {"type": "text", "text": "First text."},
            {"type": "text", "text": "Second text."}
        ]
        result = agent._extract_text_from_blocks(blocks)
        assert result == "First text.", f"Expected 'First text.', got {result}"

        # Test case 4: no text block (should raise ValueError)
        blocks = [{"type": "thinking", "thinking": "Only thinking."}]
        try:
            agent._extract_text_from_blocks(blocks)
            assert False, "Expected ValueError but none raised"
        except ValueError as e:
            assert "No text block found" in str(e), f"Unexpected error message: {e}"

        # Test case 5: empty blocks list
        blocks = []
        try:
            agent._extract_text_from_blocks(blocks)
            assert False, "Expected ValueError but none raised"
        except ValueError as e:
            assert "No text block found" in str(e), f"Unexpected error message: {e}"

        # Test case 6: block without type key (should be ignored, then raise)
        blocks = [{"some_key": "some_value"}]
        try:
            agent._extract_text_from_blocks(blocks)
            assert False, "Expected ValueError but none raised"
        except ValueError as e:
            assert "No text block found" in str(e), f"Unexpected error message: {e}"

