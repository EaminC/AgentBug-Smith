                blocks_with_thinking = [
                    {"type": "thinking", "thinking": "I need to think about this..."},
                    {"type": "text", "text": "This is the actual answer."},
                ]
                result = agent._extract_text_from_blocks(blocks_with_thinking)
                assert result == "This is the actual answer.", f"Expected 'This is the actual answer.', got {result}"

                # Case 2: blocks with only text block (non-thinking models)
                blocks_text_only = [
                    {"type": "text", "text": "Direct answer."},
