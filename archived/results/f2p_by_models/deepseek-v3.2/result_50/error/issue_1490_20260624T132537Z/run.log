    test_buggy_code_would_fail()
    print("test_buggy_code_would_fail passed")
    
    # Run async test
    asyncio.run(test_deep_research_agent_integration())
    print("test_deep_research_agent_integration passed")
    
    print("All tests passed!")[0m
