def test_extract_text_from_blocks_with_thinking_block(deep_research_agent):
    """Test _extract_text_from_blocks with thinking block first (Qwen style)."""
    blocks = [
        {"type": "thinking", "thinking": "I need to think about this..."},
        {"type": "text", "text": "Final answer text"},
    ]
    result = deep_research_agent._extract_text_from_blocks(blocks)
    assert result == "Final answer text"


def test_extract_text_from_blocks_without_thinking_block(deep_research_agent):
    """Test _extract_text_from_blocks with direct text block (non-thinking models)."""
    blocks = [
        {"type": "text", "text": "Direct answer"},
    ]
    result = deep_research_agent._extract_text_from_blocks(blocks)
    assert result == "Direct answer"


def test_extract_text_from_blocks_no_text_block_raises(deep_research_agent):
    """Test _extract_text_from_blocks raises ValueError when no text block found."""
    blocks = [
        {"type": "thinking", "thinking": "Only thinking"},
        {"type": "image", "image": "data"},
    ]
    with pytest.raises(ValueError) as exc_info:
        deep_research_agent._extract_text_from_blocks(blocks)
    assert "No text block found" in str(exc_info.value)


