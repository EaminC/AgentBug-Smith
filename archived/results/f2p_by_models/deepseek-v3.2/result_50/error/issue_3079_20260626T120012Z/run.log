# Check for src/ layout to avoid duplicate imports
# Evidence: pyproject.toml shows packages = ["autogpt"] and no src/ layout mentioned
# We'll do an editable install as tests likely import 'autogpt' directly
RUN pip install -e .

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

