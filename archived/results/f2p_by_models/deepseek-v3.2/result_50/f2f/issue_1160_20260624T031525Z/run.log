    def test_setup_mem0_logging(self):
        """Test _setup_mem0_logging static method."""
        # This is a static method, we can test it directly
        with patch("logging.getLogger") as mock_get_logger:
            mock_logger = MagicMock()
            mock_get_logger.return_value = mock_logger

            # Call with suppress_mem0_logging=True
            Mem0LongTermMemory._setup_mem0_logging(True)

            # Verify loggers were set to CRITICAL
            expected_calls = [
                ("mem0",),
                ("mem0.memory",),
                ("mem0.memory.main",),
            ]
            assert mock_get_logger.call_count == 3
            for i, expected_args in enumerate(expected_calls):
                assert mock_get_logger.call_args_list[i][0] == expected_args
                mock_logger.setLevel.assert_called_with(50)  # logging.CRITICAL

