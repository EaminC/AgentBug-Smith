        # For older Python versions, use the existing event loop or create new
        loop = asyncio.get_event_loop()
        result = loop.run_until_complete(memory.record([msg]))

    # In buggy version, record returns None (or raises if we try to access)
    # In fixed version, record returns the dict from _mem0_record
    # We assert that result is a dict. This will fail on buggy code.
    assert isinstance(result, dict)
    assert "result" in result
    assert result["result"] == "dummy"


def test_mem0_long_term_memory_init_with_suppress_logging() -> None:
    """Test that suppress_mem0_logging parameter works.

    This parameter is new in the fixed version.
    """
    # The buggy version will raise TypeError because suppress_mem0_logging
    # is not a valid parameter.
    try:
        memory = Mem0LongTermMemory(
            agent_name="test_agent",
            user_name="test_user",
            run_name="test_run",
            suppress_mem0_logging=False,  # Explicitly set to False
        )
        # If we reach here, it's the fixed version.
        # We can't easily verify logging suppression without actual mem0,
        # but we can verify the instance is created.
        assert memory.agent_id == "test_agent"
        assert memory.user_id == "test_user"
        assert memory.run_id == "test_run"
    except TypeError as e:
        # Buggy version: parameter not accepted
        # Check that the error is about suppress_mem0_logging
        # (though it might be a generic TypeError about unexpected argument)
        # We'll let the test fail by raising the error.
        raise AssertionError(
            "Buggy version: suppress_mem0_logging parameter not accepted",
        ) from e


def test_mem0_long_term_memory_init_without_suppress_logging_default() -> None:
    """Test that suppress_mem0_logging defaults to True.

    This is new in the fixed version.
    """
    # Try to instantiate without suppress_mem0_logging.
    # In fixed version, it should default to True.
    # In buggy version, it will raise TypeError because the parameter
    # is not accepted at all.
    try:
        memory = Mem0LongTermMemory(
            agent_name="test_agent",
            user_name="test_user",
            run_name="test_run",
        )
        # If we reach here, it's the fixed version (or buggy version without
        # the parameter). But buggy version doesn't have the parameter,
        # so it's okay.
        # We can't verify the default value without inspecting internal state,
        # but we can verify the instance is created.
        assert memory.agent_id == "test_agent"
        assert memory.user_id == "test_user"
        assert memory.run_id == "test_run"
    except TypeError as e:
        # Buggy version might raise if there are other required parameters
        # that we didn't provide (like model, embedding_model).
        # Let's check if the error is about missing model/embedding_model.
        error_msg = str(e).lower()
        if "model" in error_msg or "embedding" in error_msg:
            # That's expected for buggy version when mem0_config is None.
            # We'll skip this test for buggy version by letting it pass?
            # But we need the test to fail on buggy version overall.
            # Actually, the buggy version requires model and embedding_model
            # when mem0_config is None. Let's provide dummy mocks.
            # We'll import the necessary base classes.
            from agentscope.model import ChatModelBase, EmbeddingModelBase

            class DummyChatModel(ChatModelBase):
                def __init__(self) -> None:
                    super().__init__(model_name="dummy")

                def __call__(self, *args: Any, **kwargs: Any) -> Any:
                    pass

            class DummyEmbeddingModel(EmbeddingModelBase):
                def __init__(self) -> None:
                    super().__init__(model_name="dummy")

                def __call__(self, *args: Any, **kwargs: Any) -> Any:
                    pass

            # Now try again with the required parameters
            memory = Mem0LongTermMemory(
                agent_name="test_agent",
                user_name="test_user",
                run_name="test_run",
                model=DummyChatModel(),
                embedding_model=DummyEmbeddingModel(),
            )
            assert memory.agent_id == "test_agent"
            assert memory.user_id == "test_user"
            assert memory.run_id == "test_run"
        else:
            # Some other TypeError, likely about suppress_mem0_logging
            # in fixed version? Actually fixed version should accept it.
            # Let it fail.
            raise


