def test_mem0_long_term_memory_record_return_type():
    """Test that record() returns a dict after the fix, not None.

    In buggy version, record() returns None (implicitly).
    After fix, it returns dict.
    This test will fail on buggy code because we assert the return type is dict.
    """
    # Mock the internal mem0 library to avoid actual API calls
    with patch(
        "agentscope.memory._long_term_memory._mem0._mem0_long_term_memory.mem0",
        create=True,
    ) as mock_mem0_module:
        # Setup mock AsyncMemory
        mock_async_memory = AsyncMock()
        mock_async_memory.add = AsyncMock(return_value={"result": "test"})
        mock_mem0_module.AsyncMemory = MagicMock(return_value=mock_async_memory)

        # Mock the version check to pass (only needed for buggy version)
        # In buggy version, there is a version check that imports 'packaging.version'
        # We need to mock that import path.
        with patch(
            "agentscope.memory._long_term_memory._mem0._mem0_long_term_memory.version"
        ) as mock_version:
            # Simulate version <= 0.1.115 (buggy version's condition)
            mock_version.parse.return_value = MagicMock(
                __le__=lambda self, other: True,
            )
            # Create instance with minimal required arguments
            mem = Mem0LongTermMemory(
                agent_name="test_agent",
                model=MagicMock(),
                embedding_model=MagicMock(),
            )
            # Mock the internal _mem0_record method to return a dict
            mem._mem0_record = AsyncMock(return_value={"added": True})

            # Call record and check return value
            msg = Msg("user", "Hello")
            # In buggy version, record returns None (no explicit return).
            # In fixed version, it returns the result of _mem0_record.
            # We'll run the async function and capture its return.
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)
            try:
                result = loop.run_until_complete(mem.record([msg]))
                # After fix, result should be a dict.
                # This assertion will fail on buggy code because result is None.
                assert isinstance(result, dict), f"Expected dict, got {type(result)}"
            finally:
                loop.close()


