from unittest.mock import MagicMock, patch, AsyncMock
from agentscope.memory._long_term_memory._mem0._mem0_long_term_memory import (
    Mem0LongTermMemory,
)
from agentscope.message import Msg
from agentscope.model import ChatModelBase, EmbeddingModelBase
from agentscope.memory._long_term_memory._mem0._mem0_utils import (
    VectorStoreConfig,
)


class TestMem0LongTermMemory:
    """Test suite for Mem0LongTermMemory."""

    def test_init_with_mem0_config_no_override(self) -> None:
        """Test initialization with mem0_config and no overrides."""
        mock_mem0_config = MagicMock()
        mock_mem0_config.llm_config = MagicMock()
        mock_mem0_config.embedder_config = MagicMock()
        mock_mem0_config.vector_store_config = MagicMock()

        with patch("mem0.AsyncMemory") as mock_async_memory_cls:
            mock_async_memory = MagicMock()
            mock_async_memory_cls.return_value = mock_async_memory

            memory = Mem0LongTermMemory(
                agent_name="test_agent",
                mem0_config=mock_mem0_config,
            )

            assert memory.agent_id == "test_agent"
            assert memory.user_id is None
            assert memory.run_id is None
            mock_async_memory_cls.assert_called_once_with(mock_mem0_config)
            assert memory.long_term_working_memory == mock_async_memory

    def test_init_with_mem0_config_and_overrides(self) -> None:
        """Test initialization with mem0_config and overrides."""
