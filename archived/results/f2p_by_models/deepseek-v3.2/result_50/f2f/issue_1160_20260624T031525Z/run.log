import pytest
from unittest.mock import MagicMock, AsyncMock, patch
from agentscope.memory._long_term_memory._mem0._mem0_long_term_memory import (
    Mem0LongTermMemory,
)
from agentscope.message import Msg
from agentscope.model import ChatModelBase, EmbeddingModelBase


def test_mem0_long_term_memory_record_return_type():
    """Test that record() returns a dict (Any) instead of None.

    In buggy version, record() returns None (no return).
    In fixed version, it returns Any (dict from _mem0_record).
    """
    # Mock the mem0 module and its AsyncMemory
    with patch(
        "agentscope.memory._long_term_memory._mem0._mem0_long_term_memory.mem0",
        create=True,
    ) as mock_mem0_module:
        mock_async_memory = AsyncMock()
        mock_mem0_module.AsyncMemory = MagicMock(return_value=mock_async_memory)

        # Mock the version check to pass (only needed for buggy version)
        with patch(
            "agentscope.memory._long_term_memory._mem0._mem0_long_term_memory.version",
            create=True,
        ) as mock_version:
            mock_version.parse = MagicMock(return_value=MagicMock())

            # Create instance
            memory = Mem0LongTermMemory(
                agent_name="test_agent",
                model=MagicMock(spec=ChatModelBase),
                embedding_model=MagicMock(spec=EmbeddingModelBase),
            )

        # Mock _mem0_record to return a dict
        memory._mem0_record = AsyncMock(return_value={"result": "test"})

        # Call record
        result = asyncio.run(memory.record([Msg("user", "hello")]))

        # In buggy version, result is None -> assertion fails.
        # In fixed version, result is dict -> assertion passes.
        assert isinstance(result, dict)
        assert result["result"] == "test"


def test_mem0_long_term_memory_record_signature_change():
    """Test that LongTermMemoryBase.record signature changed from -> None to -> Any.

    The base class method signature changed in the patch.
    """
    from agentscope.memory._long_term_memory._long_term_memory_base import (
        LongTermMemoryBase,
    )

    # Inspect the signature of record method
    import inspect

    sig = inspect.signature(LongTermMemoryBase.record)
    return_annotation = sig.return_annotation

    # In buggy version, return_annotation is None -> assertion fails.
    # In fixed version, return_annotation is Any -> assertion passes.
    # Any is represented as typing.Any, which is not None.
    assert return_annotation is not None


