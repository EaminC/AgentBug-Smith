class TestMem0LongTermMemory:
    """Test Mem0LongTermMemory for mem0 1.0 compatibility."""

    def test_init_without_mem0_config_raises_value_error(self) -> None:
        """Test that ValueError is raised when mem0_config is None and model/embedding_model are None."""
        with pytest.raises(ValueError):
            Mem0LongTermMemory(agent_name="test_agent")

    def test_init_with_mem0_config_no_override(self) -> None:
        """Test initialization with mem0_config provided and no overrides."""
        mock_mem0_config = MagicMock()
        mock_mem0_config.llm_config = MagicMock()
        mock_mem0_config.embedder_config = MagicMock()
        mock_mem0_config.vector_store_config = MagicMock()

        with patch("mem0ai.AsyncMemory") as mock_async_memory:
            instance = Mem0LongTermMemory(
                agent_name="test_agent",
                mem0_config=mock_mem0_config,
            )
            assert instance.agent_id == "test_agent"
            mock_async_memory.assert_called_once_with(mock_mem0_config)

    def test_init_with_mem0_config_and_overrides(self) -> None:
        """Test initialization with mem0_config and overrides for model/embedding_model."""
        mock_mem0_config = MagicMock()
        mock_mem0_config.llm_config = MagicMock()
        mock_mem0_config.embedder_config = MagicMock()
        mock_mem0_config.vector_store_config = MagicMock()

        mock_model = MagicMock()
        mock_embedding_model = MagicMock()

        with patch("mem0ai.AsyncMemory") as mock_async_memory:
            instance = Mem0LongTermMemory(
                agent_name="test_agent",
                mem0_config=mock_mem0_config,
                model=mock_model,
                embedding_model=mock_embedding_model,
            )
            assert instance.agent_id == "test_agent"
            # Ensure overrides are applied
            mock_async_memory.assert_called_once()
            # Check that the config was modified
            assert mock_mem0_config.llm_config is not None
            assert mock_mem0_config.embedder_config is not None

    def test_init_without_mem0_config_requires_model_and_embedding(self) -> None:
        """Test that ValueError is raised when mem0_config is None and model/embedding_model are missing."""
        mock_model = MagicMock()
        mock_embedding_model = MagicMock()

        # Should not raise when both provided
        with patch("mem0ai.AsyncMemory"):
            Mem0LongTermMemory(
                agent_name="test_agent",
                model=mock_model,
                embedding_model=mock_embedding_model,
            )

