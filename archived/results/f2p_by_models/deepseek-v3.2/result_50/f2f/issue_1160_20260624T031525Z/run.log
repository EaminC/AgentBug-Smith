def test_mem0_long_term_memory_record_return_type():
    """Test that record() returns a dict after the fix, not None.

    In buggy version, record() returns None (implicitly).
    After fix, it returns dict.
    This test will fail on buggy code because we assert the return type is dict.
    """
    # Mock the internal mem0 library to avoid actual API calls
    with patch("mem0ai.__version__", "1.0.3"):
        with patch("mem0.AsyncMemory") as MockAsyncMemory:
            mock_memory = AsyncMock()
            MockAsyncMemory.return_value = mock_memory
            # Simulate the record method returning a dict
            mock_memory.add.return_value = {"memory_id": "test123"}

            # Create instance with minimal required args
            # We need to mock the internal config creation because
            # Mem0LongTermMemory.__init__ will try to import mem0 and create config.
            # We'll patch the internal _configure_mem0_config to skip real config.
            with patch.object(
                Mem0LongTermMemory,
                "_configure_mem0_config",
                return_value=MagicMock(),
            ):
                with patch.object(
                    Mem0LongTermMemory,
                    "_register_agentscope_providers",
                ):
                    with patch.object(
                        Mem0LongTermMemory,
                        "_setup_mem0_logging",
                    ):
                        # Also need to mock _create_agentscope_config_classes
                        # because it's called in __init__
                        with patch(
                            "agentscope.memory._long_term_memory._mem0._mem0_long_term_memory._create_agentscope_config_classes",
                            return_value=(MagicMock(), MagicMock()),
                        ):
                            mem = Mem0LongTermMemory(
                                agent_name="test_agent",
                                model=MagicMock(),
                                embedding_model=MagicMock(),
                            )
                            # Ensure the internal async memory is mocked
                            mem.long_term_working_memory = mock_memory

                            # Call record with a simple message
                            msg = Msg(name="user", content="Hello world")
                            # record is async, we need to run it
                            import asyncio

                            result = asyncio.run(mem.record([msg]))

                            # In buggy version, record returns None.
                            # In fixed version, it returns dict.
                            # Assert it's a dict (or at least not None).
                            assert result is not None, "record() should not return None"
                            assert isinstance(
                                result,
                                dict,
                            ), f"record() should return dict, got {type(result)}"
                            # The actual content depends on mock, but we can check keys
                            assert "memory_id" in result


def test_mem0_long_term_memory_record_signature_change():
    """Test that the record method's return annotation changed from None to Any.

    The patch changes the base class's record return type from None to Any,
    and Mem0LongTermMemory's record from None to dict.
    This test ensures the method exists and can be called.
    """
    # Check the base class signature
    import inspect

    sig_base = inspect.signature(LongTermMemoryBase.record)
    # In buggy version, return annotation is None.
    # In fixed version, it's Any.
    # We'll just check that the method is callable and async.
    assert sig_base.return_annotation != None, (
        "Base record() should not have return annotation None after fix"
    )

    # Check derived class signature
    sig_derived = inspect.signature(Mem0LongTermMemory.record)
    # In buggy version, return annotation is None.
    # In fixed version, it's dict.
    # We'll just verify it's not None.
    assert sig_derived.return_annotation != None, (
        "Mem0LongTermMemory.record() should not have return annotation None after fix"
    )


