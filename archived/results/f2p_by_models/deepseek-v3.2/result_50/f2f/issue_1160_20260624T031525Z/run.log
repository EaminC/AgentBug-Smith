                mock_setup_logging.assert_called_once_with(True)

                # Create instance with suppress_mem0_logging=False
                memory2 = Mem0LongTermMemory(
                    agent_name="test_agent2",
                    model=MagicMock(spec=ChatModelBase),
                    embedding_model=MagicMock(spec=EmbeddingModelBase),
                    suppress_mem0_logging=False,
                )

                # Verify _setup_mem0_logging was called with False
                assert mock_setup_logging.call_count == 2
                mock_setup_logging.assert_called_with(False)


def test_mem0_long_term_memory_uses_mem0ai_1_0_3() -> None:
    """Test that the dependency version is updated to mem0ai<=1.0.3."""
    import tomli

    with open("pyproject.toml", "rb") as f:
        pyproject = tomli.load(f)

    # Check the mem0ai dependency version
    dependencies = pyproject.get("project", {}).get("dependencies", [])
    optional_dependencies = pyproject.get("project", {}).get(
        "optional-dependencies", {}
    )
    mem0_deps = optional_dependencies.get("mem0ai", [])

    # Look for mem0ai version constraint
    found = False
    for dep in mem0_deps:
        if "mem0ai<=" in dep:
            version_str = dep.split("<=")[1]
            # Check if version is 1.0.3 or higher
            from packaging import version

            dep_version = version.parse(version_str)
            expected_version = version.parse("1.0.3")
            assert dep_version >= expected_version, (
                f"mem0ai version should be at least 1.0.3, got {version_str}"
            )
            found = True
            break

    assert found, "mem0ai dependency with version constraint not found"[0m
