[32mimport pytest
from unittest.mock import patch, MagicMock, AsyncMock
from agentscope.memory._long_term_memory._mem0._mem0_long_term_memory import (
    Mem0LongTermMemory,
)
from agentscope.message import Msg


def test_mem0_long_term_memory_record_return_type():
    """Test that record() returns a dict after the fix, not None.

    In buggy version, record() returns None (implicitly).
    After fix, it returns dict.
    This test will fail on buggy code because we assert the return type is dict.
    """
    # Mock the internal mem0 library to avoid actual API calls
    with patch("agentscope.memory._long_term_memory._mem0._mem0_long_term_memory.mem0") as mock_mem0:
        # Setup mock AsyncMemory
        mock_async_memory = AsyncMock()
        mock_mem0.AsyncMemory.return_value = mock_async_memory
        mock_async_memory.add.return_value = {"result": "test"}

        # Create instance with minimal required parameters
        mem = Mem0LongTermMemory(
            agent_name="test_agent",
            model=MagicMock(),
            embedding_model=MagicMock(),
        )

        # Mock the internal _mem0_record method to return a dict
        mem._mem0_record = AsyncMock(return_value={"added": True})

        # Call record and check return type
        result = mem.record([Msg("user", "hello")])
        # In buggy version, record() returns None (or raises if awaited incorrectly)
        # After fix, it returns a dict (the result of _mem0_record)
        # We need to await the async method properly
        import asyncio
        result = asyncio.run(mem.record([Msg("user", "hello")]))
        assert isinstance(result, dict), f"Expected dict, got {type(result)}"


def test_mem0_long_term_memory_record_signature_change():
    """Test that the record method's return annotation changed from None to Any.

    The patch changes the base class's record return type from None to Any,
    and Mem0LongTermMemory's record from None to dict.
    This test ensures the method exists and can be called.
    """
    # Check the base class signature
    from agentscope.memory._long_term_memory._long_term_memory_base import (
        LongTermMemoryBase,
    )
    import inspect

    sig_base = inspect.signature(LongTermMemoryBase.record)
    # In buggy version, return annotation is None.
    # In fixed version, it's Any.
    # We'll just check that the method is callable and async.
    # Actually test will fail on buggy because return annotation is None
    # but we want it to pass after fix when it's Any.
    # So we assert that return_annotation is not None after fix.
    # This assertion will fail on buggy code.
    assert sig_base.return_annotation != None, (
        "Base record() should not have return annotation None after fix"
    )


def test_mem0_long_term_memory_init_with_suppress_logging():
    """Test that suppress_mem0_logging parameter works.

    This is a new parameter added in the fix.
    In buggy version, the constructor doesn't have this parameter,
    so passing it will cause a TypeError.
    """
    # Mock everything to avoid import issues
    with patch("agentscope.memory._long_term_memory._mem0._mem0_long_term_memory.mem0") as mock_mem0:
        mock_async_memory = AsyncMock()
        mock_mem0.AsyncMemory.return_value = mock_async_memory

        # Try to create instance with suppress_mem0_logging parameter
        # In buggy version, this will raise TypeError because the parameter doesn't exist
        # In fixed version, it should succeed
        try:
            mem = Mem0LongTermMemory(
                agent_name="test_agent",
                model=MagicMock(),
                embedding_model=MagicMock(),
                suppress_mem0_logging=False,  # New parameter
            )
            # If we reach here in fixed version, test passes
            # In buggy version, TypeError will be raised and caught below
            assert mem is not None
        except TypeError as e:
            # In buggy version, TypeError is expected
            # Check if it's about suppress_mem0_logging
            if "suppress_mem0_logging" in str(e):
                pytest.fail(f"Buggy version doesn't accept suppress_mem0_logging: {e}")
            else:
                raise


