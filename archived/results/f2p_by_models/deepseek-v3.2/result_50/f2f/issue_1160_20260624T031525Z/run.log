    def test_validate_identifiers(self):
        """Test _validate_identifiers static method."""
        # Should not raise with at least one identifier
        Mem0LongTermMemory._validate_identifiers(
            agent_name="agent", user_name=None, run_name=None
        )
        Mem0LongTermMemory._validate_identifiers(
            agent_name=None, user_name="user", run_name=None
        )
        Mem0LongTermMemory._validate_identifiers(
            agent_name=None, user_name=None, run_name="run"
        )

        # Should raise with all None
        with pytest.raises(
            ValueError,
            match="at least one of agent_name, user_name, and run_name is required",
        ):
            Mem0LongTermMemory._validate_identifiers(
                agent_name=None, user_name=None, run_name=None
            )

