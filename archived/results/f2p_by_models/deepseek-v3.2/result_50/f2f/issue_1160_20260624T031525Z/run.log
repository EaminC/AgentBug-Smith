import pytest
from unittest.mock import patch, MagicMock, AsyncMock
from packaging import version

from agentscope.memory._long_term_memory._mem0._mem0_long_term_memory import (
    Mem0LongTermMemory,
)
from agentscope.message import Msg
from agentscope.model import ChatModelBase, EmbeddingModelBase


class TestMem0LongTermMemory:
    """Test suite for Mem0LongTermMemory after mem0 1.0 migration."""

    def test_record_signature_change(self):
        """Test that record() method signature changed from returning None to Any (dict)."""
        sig = inspect.signature(Mem0LongTermMemory.record)
        # In buggy version, return annotation is None; after fix, it's Any.
        # The patch changes the base class method's return annotation from None to Any.
        # We'll check that the return annotation is not "None".
        # Note: In buggy version, the base class's record method returns None.
        # After fix, the base class's record method returns Any.
        # The Mem0LongTermMemory.record method overrides and returns dict.
        # So we need to check the actual return annotation.
        # In buggy version, sig.return_annotation is None.
        # After fix, sig.return_annotation is inspect.Signature.empty? Actually it's dict.
        # Let's assert it's not None.
        assert sig.return_annotation is not None

    def test_async_record_returns_dict(self):
        """Test that the async record method returns a dict (not None)."""
        # Mock the internal _mem0_record to return a dict
        memory = Mem0LongTermMemory(agent_name="test_agent")
        memory._mem0_record = AsyncMock(return_value={"result": "success"})
        # Also mock the long_term_working_memory to avoid actual mem0 calls
        memory.long_term_working_memory = AsyncMock()

        # Call record with some dummy messages
        msgs = [Msg("user", "Hello")]
        result = memory.record(msgs)
        # In buggy version, record returns None (because base class returns None).
        # After fix, record returns the result from _mem0_record.
        assert result is not None
        assert isinstance(result, dict)
        assert result["result"] == "success"

    def test_record_returns_dict_instead_of_none(self):
        """Test that record() returns a dict after the fix."""
        # Create a Mem0LongTermMemory instance with minimal mocks
        with patch.object(Mem0LongTermMemory, "_setup_mem0_logging"):
            with patch.object(Mem0LongTermMemory, "_register_agentscope_providers"):
                with patch("mem0.AsyncMemory"):
                    # Mock the internal _mem0_record to return a dict
                    memory = Mem0LongTermMemory(agent_name="test_agent")
                    memory._mem0_record = AsyncMock(return_value={"id": "123"})
                    memory.long_term_working_memory = AsyncMock()

                    msgs = [Msg("user", "test message")]
                    result = memory.record(msgs)
                    # In buggy version, this would be None.
                    # After fix, it's the dict returned by _mem0_record.
                    assert result is not None
                    assert isinstance(result, dict)
                    assert result["id"] == "123"

    def test_suppress_mem0_logging_default_true(self):
        """Test that suppress_mem0_logging defaults to True."""
        # We need to check that the __init__ parameter default is True.
        sig = inspect.signature(Mem0LongTermMemory.__init__)
        param = sig.parameters.get("suppress_mem0_logging")
        assert param is not None
        assert param.default is True

    def test_suppress_mem0_logging_false(self):
        """Test that suppress_mem0_logging can be set to False."""
        # We'll mock the _setup_mem0_logging to verify it's called with False.
        with patch.object(Mem0LongTermMemory, "_setup_mem0_logging") as mock_setup:
            with patch.object(Mem0LongTermMemory, "_register_agentscope_providers"):
                with patch("mem0.AsyncMemory"):
                    Mem0LongTermMemory(
                        agent_name="test",
                        suppress_mem0_logging=False,
                    )
                    mock_setup.assert_called_once_with(False)

    def test_init_with_mem0_config_no_model_or_embedding_model(self):
        """Test that init raises ValueError if mem0_config is None and model/embedding_model missing."""
        # In buggy version, the error message might differ.
        # After fix, the error is raised in _configure_mem0_config.
        # We'll test that ValueError is raised.
        with pytest.raises(ValueError) as exc_info:
            Mem0LongTermMemory(agent_name="test")
        # Check that the error message indicates missing model/embedding_model
        error_msg = str(exc_info.value).lower()
        assert "model" in error_msg or "embedding_model" in error_msg

    def test_retrieve_returns_memories(self):
        """Test that retrieve returns a list of memories."""
        # Mock the internal long_term_working_memory.search
        memory = Mem0LongTermMemory(agent_name="test_agent")
        memory.long_term_working_memory = AsyncMock()
        memory.long_term_working_memory.search = AsyncMock(
            return_value={
                "memories": [{"id": "1", "content": "memory1"}],
                "relations": [],
            }
        )

        result = memory.retrieve("query")
        assert result is not None
        assert isinstance(result, list)
        # In buggy version, the result might be empty or differently structured.
        # After fix, it should be a list of memories.
        if result:  # if list not empty
            assert isinstance(result[0], dict)

    def test_init_with_vector_store_config_defaults_to_qdrant(self):
