    def test_suppress_mem0_logging(self) -> None:
        """Test that mem0 logging can be suppressed."""
        mock_model = MagicMock(spec=ChatModelBase)
        mock_embedding = MagicMock(spec=EmbeddingModelBase)

        with patch("mem0.AsyncMemory") as mock_async_memory, \
             patch("mem0.MemoryConfig") as mock_mem0_config_class, \
             patch("logging.getLogger") as mock_get_logger:
            mock_logger = MagicMock()
            mock_get_logger.return_value = mock_logger
            mock_mem0_config_class.return_value = MagicMock()
            ltm = Mem0LongTermMemory(
                agent_name="test_agent",
                model=mock_model,
                embedding_model=mock_embedding,
                suppress_mem0_logging=True,
            )
            assert ltm.agent_id == "test_agent"
            mock_async_memory.assert_called_once()
            # Verify logging suppression was attempted
            mock_get_logger.assert_any_call("mem0")
            mock_get_logger.assert_any_call("mem0.memory")
            mock_get_logger.assert_any_call("mem0.memory.main")

    def test_record_returns_dict_in_fixed_version(self) -> None:
        """Test that record method returns a dict in the fixed version.
        
        In the buggy version, record returns None; in the fixed version, it returns dict.
        This test will fail on buggy code and pass on fixed code.
        """
        mock_model = MagicMock(spec=ChatModelBase)
        mock_embedding = MagicMock(spec=EmbeddingModelBase)
        mock_memory_instance = AsyncMock()
        mock_memory_instance.add.return_value = {"test": "result"}

        with patch("mem0.AsyncMemory", return_value=mock_memory_instance), \
             patch("mem0.MemoryConfig") as mock_mem0_config_class:
            mock_mem0_config_class.return_value = MagicMock()
            ltm = Mem0LongTermMemory(
                agent_name="test_agent",
                model=mock_model,
                embedding_model=mock_embedding,
            )
            msgs = [Msg("user", "test message")]
            result = asyncio.run(ltm.record(msgs))
            # In buggy version, result would be None; in fixed version, it's dict
            # This assertion will fail on buggy code, pass on fixed
            assert isinstance(result, dict)
            assert result == {"test": "result"}[0m
