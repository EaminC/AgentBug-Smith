    with patch(
        "agentscope.memory._long_term_memory._mem0._mem0_long_term_memory.mem0",
        create=True,
    ) as mock_mem0_module:
        mock_async_memory = AsyncMock()
        mock_mem0_module.AsyncMemory = MagicMock(return_value=mock_async_memory)

        # Mock the version check to pass (only needed for buggy version)
        with patch(
            "agentscope.memory._long_term_memory._mem0._mem0_long_term_memory.version",
            create=True,
        ) as mock_version:
            mock_version.parse = MagicMock(return_value=MagicMock())

            # Create instance
            memory = Mem0LongTermMemory(
                agent_name="test_agent",
                model=MagicMock(),
                embedding_model=MagicMock(),
            )

            # Mock _mem0_record to return a dict
            mock_result = {"memory_id": "123", "content": "test"}
            memory._mem0_record = AsyncMock(return_value=mock_result)

            # Call record
            msg = Msg("user", "Hello")
            result = asyncio.run(memory.record([msg]))

            # In buggy version, record returns None (no return statement).
            # In fixed version, it returns the result of _mem0_record.
            # This assertion will fail on buggy code.
            assert isinstance(result, dict), "record() should return a dict"
            assert result == mock_result


def test_mem0_long_term_memory_record_signature_change():
    """Test that the record method's return annotation changed from None to Any.

    The patch changes the base class's record return type from None to Any,
    and Mem0LongTermMemory's record from None to dict.
    This test ensures the method exists and can be called.
    """
    # Check the base class signature
    sig_base = inspect.signature(LongTermMemoryBase.record)
    # In buggy version, return annotation is None.
    # In fixed version, it's Any.
    # We'll just check that the method is callable and async.
    # Actually test will fail on buggy because return annotation is None
    # but we want it to pass after fix when it's Any.
    # So we assert that return_annotation is not None after fix.
    # This assertion will fail on buggy code.
    assert (
        sig_base.return_annotation != None
    ), "Base record() should not have return annotation None after fix"

    # Check Mem0LongTermMemory's record signature
    sig_mem0 = inspect.signature(Mem0LongTermMemory.record)
    # In buggy version, return annotation is None (implicitly).
    # In fixed version, it's dict.
    # We'll check that the method is callable and async.
    assert sig_mem0.return_annotation != None, (
        "Mem0LongTermMemory record() should not have return annotation None after fix"
    )


