            embedding_model=mock_embedding_model,
        )

        # Patch _mem0_record to verify it's called correctly
        with patch.object(
            memory,
            "_mem0_record",
            new_callable=AsyncMock,
        ) as mock_mem0_record:
            mock_mem0_record.return_value = {"custom": "result"}

            test_msg = Msg("assistant", "I am an AI.")

