[32mimport asyncio
import pytest
from unittest.mock import patch, MagicMock, AsyncMock
from agentscope.memory._long_term_memory._mem0._mem0_long_term_memory import (
    Mem0LongTermMemory,
)
from agentscope.message import Msg
from agentscope.model import ChatModelBase, EmbeddingModelBase
from agentscope.memory._long_term_memory._mem0._mem0_utils import (
    VectorStoreConfig,
)


class TestMem0LongTermMemory:
    """Test suite for Mem0LongTermMemory."""

    def test_init_with_mem0_config(self) -> None:
        """Test initialization with mem0_config provided."""
        mock_mem0_config = MagicMock()
        mock_mem0_config.llm_config = MagicMock()
        mock_mem0_config.embedder_config = MagicMock()
        mock_mem0_config.vector_store_config = MagicMock()

        with patch("mem0.AsyncMemory") as mock_async_memory:
            ltm = Mem0LongTermMemory(
                agent_name="test_agent",
                mem0_config=mock_mem0_config,
            )
            assert ltm.agent_id == "test_agent"
            assert ltm.user_id is None
            assert ltm.run_id is None
            mock_async_memory.assert_called_once_with(mock_mem0_config)

    def test_init_without_mem0_config_requires_model_and_embedding(self) -> None:
        """Test that model and embedding_model are required when mem0_config is None."""
        with pytest.raises(ValueError):
            Mem0LongTermMemory(agent_name="test_agent")

    def test_init_without_mem0_config_but_with_model_and_embedding(self) -> None:
        """Test initialization with model and embedding_model but no mem0_config."""
        mock_model = MagicMock(spec=ChatModelBase)
        mock_embedding = MagicMock(spec=EmbeddingModelBase)

        with patch("mem0.AsyncMemory") as mock_async_memory, \
             patch("mem0.MemoryConfig") as mock_mem0_config_class:
            mock_mem0_config = MagicMock()
            mock_mem0_config_class.return_value = mock_mem0_config
            ltm = Mem0LongTermMemory(
                agent_name="test_agent",
                model=mock_model,
                embedding_model=mock_embedding,
            )
            assert ltm.agent_id == "test_agent"
            mock_async_memory.assert_called_once_with(mock_mem0_config)

    def test_init_with_vector_store_config(self) -> None:
        """Test initialization with vector_store_config."""
        mock_model = MagicMock(spec=ChatModelBase)
        mock_embedding = MagicMock(spec=EmbeddingModelBase)
        vector_store_config = VectorStoreConfig(
            provider="qdrant",
            config={"on_disk": True},
        )

        with patch("mem0.AsyncMemory") as mock_async_memory, \
             patch("mem0.MemoryConfig") as mock_mem0_config_class:
            mock_mem0_config = MagicMock()
            mock_mem0_config_class.return_value = mock_mem0_config
            ltm = Mem0LongTermMemory(
                agent_name="test_agent",
                model=mock_model,
                embedding_model=mock_embedding,
                vector_store_config=vector_store_config,
            )
            assert ltm.agent_id == "test_agent"
            mock_async_memory.assert_called_once_with(mock_mem0_config)

    def test_init_no_identifiers_raises_error(self) -> None:
        """Test that at least one identifier (agent_name, user_name, run_name) is required."""
        mock_model = MagicMock(spec=ChatModelBase)
        mock_embedding = MagicMock(spec=EmbeddingModelBase)
        with pytest.raises(ValueError):
            Mem0LongTermMemory(
                model=mock_model,
                embedding_model=mock_embedding,
            )

    def test_record_async(self) -> None:
        """Test the record method."""
        mock_model = MagicMock(spec=ChatModelBase)
        mock_embedding = MagicMock(spec=EmbeddingModelBase)
        mock_memory_instance = AsyncMock()
        mock_memory_instance.add.return_value = {"result": "test_result"}

        with patch("mem0.AsyncMemory", return_value=mock_memory_instance), \
             patch("mem0.MemoryConfig") as mock_mem0_config_class:
            mock_mem0_config_class.return_value = MagicMock()
            ltm = Mem0LongTermMemory(
                agent_name="test_agent",
                model=mock_model,
                embedding_model=mock_embedding,
            )
            msgs = [Msg("user", "Hello, world!")]
            result = asyncio.run(ltm.record(msgs))
            assert result == {"result": "test_result"}
            mock_memory_instance.add.assert_called_once()

    def test_search_async(self) -> None:
        """Test the search method."""
        mock_model = MagicMock(spec=ChatModelBase)
        mock_embedding = MagicMock(spec=EmbeddingModelBase)
        mock_memory_instance = AsyncMock()
        mock_memory_instance.search.return_value = [
            {"memory": "test_memory", "score": 0.9}
        ]

        with patch("mem0.AsyncMemory", return_value=mock_memory_instance), \
             patch("mem0.MemoryConfig") as mock_mem0_config_class:
            mock_mem0_config_class.return_value = MagicMock()
            ltm = Mem0LongTermMemory(
                agent_name="test_agent",
                model=mock_model,
                embedding_model=mock_embedding,
            )
            query = "test query"
            result = asyncio.run(ltm.search(query))
            assert len(result) == 1
            assert result[0]["memory"] == "test_memory"
            mock_memory_instance.search.assert_called_once()

