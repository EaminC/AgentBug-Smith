[32mimport sys
import os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..', 'lib', 'crewai'))

from crewai import Agent, Task
from crewai.a2a.config import A2AConfig
from crewai.a2a.wrapper import _delegate_to_a2a
from unittest.mock import MagicMock, patch

def test_a2a_trust_completion_status_false_loops_on_completed():
    """
    Before fix: when trust_remote_completion_status=False (default) and A2A returns "completed",
    the server agent should still be asked to respond (original_fn called).
    However, the bug is that the loop continues even after the server agent returns a final result.
    This test verifies that the bug exists (fails on buggy code) and passes after fix.
    """
    a2a_config = A2AConfig(
        endpoint="http://test-endpoint.com",
        trust_remote_completion_status=False,
    )

    agent = Agent(
        role="test manager",
        goal="coordinate",
        backstory="test",
        a2a=a2a_config,
    )

    task = Task(description="test", expected_output="test", agent=agent)

    class MockResponse:
        is_a2a = True
        message = "Please help"
        a2a_ids = ["http://test-endpoint.com/"]

    call_count = 0
    original_fn_calls = []

    def mock_original_fn(self, task, context, tools):
        nonlocal call_count
        call_count += 1
        original_fn_calls.append(call_count)
        # Server decides to finish immediately
        return '{"is_a2a": false, "message": "Server final answer", "a2a_ids": []}'

    with patch("crewai.a2a.wrapper.execute_a2a_delegation") as mock_execute, \
         patch("crewai.a2a.wrapper._fetch_agent_cards_concurrently") as mock_fetch:
        mock_card = MagicMock()
        mock_card.name = "Test"
        mock_fetch.return_value = ({"http://test-endpoint.com/": mock_card}, {})

        # A2A returns completed
        mock_execute.return_value = {
            "status": "completed",
            "result": "Done by remote",
            "history": [],
        }

        result = _delegate_to_a2a(
            self=agent,
            agent_response=MockResponse(),
            task=task,
            original_fn=mock_original_fn,
            context=None,
            tools=None,
            agent_cards={"http://test-endpoint.com/": mock_card},
            original_task_description="test",
        )

        # On buggy code: original_fn may be called multiple times (loop) and result may be wrong.
        # On fixed code: original_fn called once, result is "Server final answer".
        # Assert that original_fn is called exactly once (no extra delegation after server final).
        assert call_count == 1, f"original_fn called {call_count} times, expected 1 (loop bug)"
        assert result == "Server final answer", f"Expected 'Server final answer', got {result}"

def test_a2a_trust_completion_status_true_returns_directly():
    """
    After fix: when trust_remote_completion_status=True and A2A returns "completed",
    the result should be returned directly without calling original_fn.
    This test passes only after the fix is applied.
    """
    a2a_config = A2AConfig(
        endpoint="http://test-endpoint.com",
        trust_remote_completion_status=True,
    )

    agent = Agent(
        role="test manager",
        goal="coordinate",
        backstory="test",
        a2a=a2a_config,
    )

    task = Task(description="test", expected_output="test", agent=agent)

    class MockResponse:
        is_a2a = True
        message = "Please help"
        a2a_ids = ["http://test-endpoint.com/"]

    original_fn_called = False

    def mock_original_fn(self, task, context, tools):
        nonlocal original_fn_called
        original_fn_called = True
        return "Should not be called"

    with patch("crewai.a2a.wrapper.execute_a2a_delegation") as mock_execute, \
         patch("crewai.a2a.wrapper._fetch_agent_cards_concurrently") as mock_fetch:
        mock_card = MagicMock()
        mock_card.name = "Test"
        mock_fetch.return_value = ({"http://test-endpoint.com/": mock_card}, {})

        mock_execute.return_value = {
            "status": "completed",
            "result": "Done by remote",
            "history": [],
        }

        result = _delegate_to_a2a(
            self=agent,
            agent_response=MockResponse(),
            task=task,
            original_fn=mock_original_fn,
            context=None,
            tools=None,
            agent_cards={"http://test-endpoint.com/": mock_card},
            original_task_description="test",
        )

        assert not original_fn_called, "original_fn should not be called when trust_remote_completion_status=True"
        assert result == "Done by remote", f"Expected 'Done by remote', got {result}"

