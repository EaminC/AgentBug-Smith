def test_get_crews_handles_import_errors_in_crew_file():
    """Test that get_crews handles import errors in crew.py gracefully.

    This test is designed to fail on the buggy codebase because the buggy
    get_crews function prints errors to stdout (print) instead of console.print,
    and also doesn't properly handle import errors when scanning crew files.
    The buggy code would cause the error messages seen in issue #2899:
    'Error processing attribute Field: name 'JsonValue' is not defined'
    etc. because it tries to process all attributes in the module even when
    there are import errors.

    After the fix, get_crews uses console.print for errors and properly handles
    import errors by continuing to search for valid crews.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        old_cwd = os.getcwd()
        os.chdir(tmpdir)

        # Create a crew.py file with import errors that would trigger the bug
        # This simulates a crew file that imports types that aren't available
        # in the current context (like JsonValue, TaskOutput, Task)
        crew_content = """
