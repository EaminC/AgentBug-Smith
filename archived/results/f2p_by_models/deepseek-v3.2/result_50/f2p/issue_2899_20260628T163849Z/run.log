    get_crews function prints errors to stdout (print) instead of console.print,
    and also doesn't properly handle import errors when scanning crew files.
    The buggy code would cause the error messages seen in issue #2899:
    'Error processing attribute Field: name 'JsonValue' is not defined'
    etc. because it tries to process all attributes in the module even when
    there are import errors.

    After the fix, get_crews uses console.print for errors and properly handles
    import errors by continuing to search for valid crews.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        old_cwd = os.getcwd()
        os.chdir(tmpdir)

        # Create a crew.py file with import errors that would trigger the bug
        # This simulates a crew file that imports types that aren't available
        # in the current context (like JsonValue, TaskOutput, Task)
        crew_content = """
from typing import List, Optional
from pydantic import BaseModel, Field
from crewai.crew import Crew
from crewai.agent import Agent
from crewai.task import Task

# These imports would cause errors if the types aren't available
# In the buggy code, processing these attributes would cause:
# "Error processing attribute Field: name 'JsonValue' is not defined"
class JsonValue(BaseModel):
    value: str

class TaskOutput(BaseModel):
    output: str

# Define a crew function that returns a Crew
def create_crew() -> Crew:
    agent = Agent(role="test", goal="test", backstory="test")
    return Crew(agents=[agent], tasks=[])

# Direct crew instance
direct_crew = Crew(agents=[], tasks=[])

# These would cause attribute processing errors in buggy code
aggregate_raw_outputs_from_task_outputs = TaskOutput
aggregate_raw_outputs_from_tasks = Task
"""
        with open("crew.py", "w") as f:
            f.write(crew_content)

        try:
            # In buggy code, this would print errors to stdout and might return empty list
            # or raise exceptions. The fix should handle this gracefully.
            crews = utils.get_crews(crew_path="crew.py", require=False)

            # We should get at least one crew (the direct_crew instance)
            # or the crew returned by create_crew()
            assert len(crews) > 0, "Should find at least one crew instance"
        finally:
