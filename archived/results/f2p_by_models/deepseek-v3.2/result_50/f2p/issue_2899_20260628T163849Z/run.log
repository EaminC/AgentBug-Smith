            f.write(crew_content)

        try:
            # In buggy code, this would print to stdout with print()
            # After fix, it should use console.print with style
            crews = utils.get_crews(crew_path="crew.py", require=False)
            # Should return empty list when there's a syntax error
            assert len(crews) == 0
        finally:
            os.chdir(old_cwd)


