from pydantic import BaseModel, Field
from crewai.crew import Crew
from crewai.agent import Agent
from crewai.task import Task

# These imports would cause errors if the types aren't available
# In the buggy code, processing these attributes would cause:
# "Error processing attribute Field: name 'JsonValue' is not defined"
class JsonValue(BaseModel):
    value: str

class TaskOutput(BaseModel):
    output: str

# Define a crew function that returns a Crew
def create_crew() -> Crew:
    agent = Agent(role="test", goal="test", backstory="test")
    return Crew(agents=[agent], tasks=[])

# Direct crew instance
direct_crew = Crew(agents=[], tasks=[])

# These would cause attribute processing errors in buggy code
aggregate_raw_outputs_from_task_outputs = TaskOutput
aggregate_raw_outputs_from_tasks = Task
"""
        with open("crew.py", "w") as f:
            f.write(crew_content)

        try:
            # In buggy code, this would print errors to stdout and might return empty list
            # or raise exceptions. The fix should handle this gracefully.
            crews = utils.get_crews(crew_path="crew.py", require=False)

            # We should get at least one crew (the direct_crew instance)
            # or the crew returned by create_crew()
            assert len(crews) > 0, "Should find at least one crew instance"

            # All returned items should be Crew instances
            for crew in crews:
                assert isinstance(crew, Crew), f"Expected Crew instance, got {type(crew)}"

            # The buggy code would have printed errors to stdout (using print)
            # The fix uses console.print, so we need to verify the behavior changed
            # We'll capture output to ensure no errors are printed with plain print()
            import io
            from contextlib import redirect_stdout

            f = io.StringIO()
            with redirect_stdout(f):
                # Run get_crews again to capture any print statements
                crews2 = utils.get_crews(crew_path="crew.py", require=False)
            
            output = f.getvalue()
            # In the buggy code, output would contain error messages from print()
            # In the fixed code, console.print is used, so output should be empty
            # or contain different formatting
            if output:
                # If there's output, it shouldn't contain the raw error messages
                # that were seen in the bug report
                error_strings = [
                    "Error processing attribute Field: name 'JsonValue' is not defined",
                    "Error processing attribute aggregate_raw_outputs_from_task_outputs: name 'TaskOutput' is not defined",
                    "Error processing attribute aggregate_raw_outputs_from_tasks: name 'Task' is not defined"
                ]
                for error_str in error_strings:
                    # The buggy code would print these exact errors
                    # The fixed code uses console.print with styling
                    assert error_str not in output, f"Buggy error message found: {error_str}"

        finally:
            os.chdir(old_cwd)


