[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Install system dependencies for building and runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install uv as per pyproject.toml and Makefile evidence
RUN python -m pip install --upgrade pip wheel && \
    pip install uv==0.7.20

# Copy the entire repository
COPY . .

# Install backend dependencies using uv (as per Makefile and pyproject.toml)
# The project uses uv workspace with members including src/backend/base and .
# Install with dev dependencies for testing, and extra postgresql (common in CI)
RUN uv sync --frozen --extra "postgresql" --dev

# Install the project itself (editable install) to make langflow importable
# Note: The repository uses src/ layout but the main package is at root.
# The project uses hatchling build system; uv sync already installs the package.
# Additional test dependencies are installed via dev group; ensure pytest and required extras.
# The dev group includes pytest, pytest-mock, etc. as per pyproject.toml.
# Also install litellm and setuptools<=81.0.0 as per critical instruction.
RUN pip install "setuptools<=81.0.0" litellm pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout mem0ai

# Preflight import check
RUN python -c "import langflow, pytest; print('preflight ok')"

# Expose default port (from README.md and Makefile)
EXPOSE 7860

# Default command inferred from pyproject.toml script and Makefile
# The project script is "langflow = langflow.langflow_launcher:main"
# Makefile run_cli uses `uv run langflow run`
CMD ["uv", "run", "langflow", "run", "--host", "0.0.0.0", "--port", "7860"][0m
