ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install wheel
RUN python -m pip install --upgrade pip wheel

# Install poetry
RUN pip install poetry

# Copy the entire repository
COPY . .

# Install dependencies and project using poetry (no lock file present, but pyproject.toml exists)
# Assumption: No poetry.lock present, use poetry install with --no-root then editable install
RUN poetry config virtualenvs.create false && \
    poetry install --no-interaction --no-ansi --no-root && \
    pip install -e .

# Install mandatory test dependencies (pytest, pytest-mock, setuptools<=81.0.0, litellm)
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Preflight check to ensure core modules can be imported
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set PYTHONPATH to /app to avoid duplicate loading if src/ layout exists
# The repository appears to have package 'interpreter' directly in root, not under src/
# but we set PYTHONPATH anyway for safety.
ENV PYTHONPATH=/app

# The CMD is inferred from pyproject.toml's tool.poetry.scripts: interpreter = "interpreter:cli"
# The main entry point is the CLI via 'interpreter' command.
CMD ["interpreter"][0m
