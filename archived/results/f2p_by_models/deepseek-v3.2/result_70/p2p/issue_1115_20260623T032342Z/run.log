WORKDIR /app

# Install system dependencies (if needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Determine package manager and install dependencies
# Based on repository evidence: pyproject.toml exists, poetry.lock may exist, Makefile suggests poetry install
RUN python -m pip install --upgrade pip wheel && \
    # Check for poetry.lock and use poetry if possible
    if [ -f poetry.lock ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi --with dev && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
        # Fallback: install via pip editable install (no lockfile)
