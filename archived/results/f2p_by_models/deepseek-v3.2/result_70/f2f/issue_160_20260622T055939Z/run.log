def test_coder_generates_code_with_claude():
    """
    Test that the Coder agent can generate code using the Claude model.
    In the buggy version, the Coder's query method fails to handle tool calls
    properly, resulting in no code generation.
    After the fix, the Coder should successfully generate code.
    """
    # Create a temporary directory for the test
    temp_dir = tempfile.mkdtemp()
    try:
        # Mock the Claude API key and client to avoid real API calls
        with patch.dict(os.environ, {"ANTHROPIC_API_KEY": "test_key"}):
            # Create a mock Claude client that simulates the buggy behavior
            # In the buggy version, the query method returns text without handling tool calls
            mock_client = MagicMock()
            mock_message = MagicMock()
            mock_content = MagicMock()
            mock_content.type = "text"
            mock_content.text = "I will create the file."
            mock_message.content = [mock_content]
            mock_message.stop_reason = "stop_sequence"
            mock_client.messages.create.return_value = mock_message

            # Create a Model instance with Claude
            model = Model(api_key="test_key", model="claude-3-opus-20240229")
            # Replace the client with our mock
            model.client = mock_client

            # Create a Coder instance with the mocked model
            coder = Coder(model=model, working_dir=temp_dir)

            # Prepare a chat history that would trigger code generation
            chat_history = [
                {
                    "role": "system",
                    "content": "You are a programmer."
                },
                {
                    "role": "user",
                    "content": "Create a file named test.py with print('hello')"
                }
            ]

            # In the buggy version, the Coder's query method would return text
            # but the Coder agent expects function calls to create files.
            # The bug is that the Claude model's query method doesn't handle
            # tool calls properly, so it returns plain text instead of invoking
            # the create_file function.
            # After the fix, the Claude model's query method should handle
            # tool calls and invoke the appropriate functions.

            # We need to mock the function call handling in the Claude model
            # First, let's see what happens in the buggy version
            # We'll patch the model's query method to simulate the bug
            original_query = model.query

            def buggy_query(chat_history, **kwargs):
                # Simulate the buggy behavior: return text without tool calls
                return "I will create the file."

            model.query = buggy_query

            # Try to generate code
            # The Coder agent uses the model to generate responses
            # In the buggy version, it will get text response but no function calls
            response = coder.generate_code(chat_history)

            # In the buggy version, the response is just text, no files are created
            # So the test should fail because no file was created
            expected_file = os.path.join(temp_dir, "test.py")
            assert os.path.exists(expected_file), f"File {expected_file} should have been created but wasn't."

            # If we reach here in the buggy version, the test passes (which is wrong)
            # But actually, we need to test the actual behavior with the real code
            # Let's restore the original query and test with the actual implementation
            model.query = original_query

            # Now patch the client to simulate the fixed behavior
            # In the fixed version, the Claude model handles tool calls
            mock_tool_use = MagicMock()
            mock_tool_use.type = "tool_use"
            mock_tool_use.id = "toolu_123"
            mock_tool_use.name = "create_file"
            mock_tool_use.input = {"file_path": "test.py", "content": "print('hello')"}

            mock_tool_content = MagicMock()
            mock_tool_content.type = "tool_use"
            mock_tool_content.name = "create_file"
            mock_tool_content.input = {"file_path": "test.py", "content": "print('hello')"}
            mock_tool_content.id = "toolu_123"

            mock_message2 = MagicMock()
            mock_message2.content = [mock_tool_content]
            mock_message2.stop_reason = "tool_use"

            # Mock the second call (after tool result)
            mock_text_content = MagicMock()
            mock_text_content.type = "text"
            mock_text_content.text = "File created successfully."
            mock_message3 = MagicMock()
            mock_message3.content = [mock_text_content]
