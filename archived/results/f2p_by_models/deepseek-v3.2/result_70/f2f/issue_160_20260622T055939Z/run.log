def test_claude_model_response_format_fix():
    """
    Test the specific fix for Claude model's response_format handling.
    
    The patch shows that response_format handling was changed from:
    - Appending a confusing message to chat_history
    - To: Adding a clear instruction to system prompt
    
    This test verifies that the new approach works correctly.
    """
    mock_anthropic = MagicMock()
    mock_content = MagicMock()
    mock_content.text = '{"test": "value"}'
    
    mock_message = MagicMock()
    mock_message.content = [mock_content]
    mock_message.stop_reason = "end_turn"
    mock_anthropic.messages.create.return_value = mock_message
    
    with patch('mle.model.anthropic', return_value=mock_anthropic):
        model = Model(
            api_key="fake-key",
            model="claude-3-sonnet-20240229",
            temperature=0.7
        )
        
        chat_history = [
            {
                "role": "system",
                "content": "You are a helpful assistant."
            },
            {
                "role": "user",
                "content": "Output JSON"
            }
        ]
        
        response_format = {"type": "json_object"}
        
        response = model.query(chat_history, response_format=response_format)
        
        # Verify the response is valid
        assert response is not None
        
        # In the buggy version, the response might have extra text or be malformed
        # In the fixed version, it should be clean JSON
        import json
        try:
            parsed = json.loads(response)
            assert isinstance(parsed, dict)
            assert "test" in parsed
        except json.JSONDecodeError:
            # This would fail in buggy version, pass in fixed
            assert False, f"Response is not valid JSON: {response}"


