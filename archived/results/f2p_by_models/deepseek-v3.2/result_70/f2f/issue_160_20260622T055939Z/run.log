def test_claude_model_text_response():
    """
    Test that ClaudeModel returns text when stop_reason is not tool_use.
    """
    # Mock the Anthropic client to simulate a text response
    mock_client = MagicMock()
    mock_message = MagicMock()
    mock_message.stop_reason = "end_turn"
    mock_text = MagicMock()
    mock_text.type = "text"
    mock_text.text = "Here is the generated code."
    mock_message.content = [mock_text]
    mock_client.messages.create.return_value = mock_message

    with patch.object(ClaudeModel, 'anthropic', return_value=mock_client):
        model = ClaudeModel(api_key="fake_key", model="claude-3-sonnet-20240229")
        model.client = mock_client

        chat_history = [
            {"role": "system", "content": "You are a programmer."},
            {"role": "user", "content": "Write a function."}
        ]
        result = model.query(chat_history)

        assert result == "Here is the generated code."
        mock_client.messages.create.assert_called_once()


