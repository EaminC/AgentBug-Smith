                with patch('mle.model.process_function_name', return_value="search_web"):
                    chat_history = [
                        {"role": "system", "content": "You are a helpful assistant."},
                        {"role": "user", "content": "Search for something"}
                    ]
                    
                    # This should eventually stop due to recursion limit
                    # The test verifies the recursion logic doesn't crash
                    try:
                        result = model.query(chat_history, functions=[
                            {
                                "name": "search_web",
                                "description": "Search the web",
                                "parameters": {
                                    "type": "object",
                                    "properties": {
                                        "query": {"type": "string"}
                                    }
                                }
                            }
                        ])
                        # If we get here, the recursion was handled properly
                        assert True
                    except RecursionError:
                        # This would happen if recursion isn't limited
                        pytest.fail("Recursion not properly limited")

