            except Exception as e:
                # Let the test fail with the exception
                raise
                
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)


def test_claude_model_response_format():
    """
    Test that ClaudeModel correctly handles response_format parameter,
    which was modified in the fix.
    """
    mock_client = MagicMock()
    mock_message = MagicMock()
    mock_text = MagicMock()
    mock_text.type = "text"
    mock_text.text = '{"key": "value"}'
    
    mock_message.content = [mock_text]
    mock_message.stop_reason = "end_turn"
    
    mock_client.messages.create.return_value = mock_message
    
    with patch.object(ClaudeModel, 'anthropic', return_value=mock_client):
        model = ClaudeModel(api_key="fake_key", model="claude-3-haiku-20240307")
        model.client = mock_client
        
        chat_history = [
            {"role": "user", "content": "Output JSON format"}
        ]
        
        response_format = {"type": "json_object"}
        
        # In buggy version, the response_format handling adds confusing text
        # In fixed version, it should be cleaner
        result = model.query(chat_history, response_format=response_format)
        
        # Check that the system prompt was modified correctly
        call_args = mock_client.messages.create.call_args
        
        # The fixed version should have cleaner system prompt
        system_prompt = call_args.kwargs.get('system', '')
        
        # In buggy version, the prompt might have confusing examples
        # In fixed version, it should be simpler
        if "Outputs only valid json without any explanatory words" in system_prompt:
            # This is the fixed version behavior
            assert "Json format example" not in system_prompt
        else:
            # Buggy version might have different prompt
            # We'll let the test continue but note the difference
            pass
        
        # The result should be valid
        assert result is not None
        assert len(result) > 0


