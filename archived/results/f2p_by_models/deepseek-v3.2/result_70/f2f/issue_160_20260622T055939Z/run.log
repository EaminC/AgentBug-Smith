        system_prompt = call_kwargs['system']
        assert "Outputs only valid json_object without any explanatory words" in system_prompt
        assert result == '{"code": "print(\\"hello\\")"}'


def test_coder_agent_with_claude():
    """
    Integration test: Coder agent using ClaudeModel should generate code.
    """
    temp_dir = tempfile.mkdtemp()
    try:
        # Mock the entire ClaudeModel to avoid actual API calls
        mock_model = MagicMock(spec=ClaudeModel)
        # Simulate a successful text response with code
        mock_model.query.return_value = """
        I'll create the project structure and code.
        <function_calls>
        <function_call name="create_file">
        {"path": "main.py", "content": "print('Hello, world!')"}
        </function_call>
        </function_calls>
        """

        # Create a Coder instance with the mocked model
        coder = Coder(model=mock_model, working_dir=temp_dir)

        # Mock the function that handles tool calls to actually create the file
        with patch('mle.agents.coder.get_function') as mock_get_function:
            mock_create_file = Mock(return_value="File created: main.py")
            mock_get_function.return_value = mock_create_file

            # Run the coder's process (simplified)
            # The bug was that no code was generated due to missing tool_use handling.
            # After fix, the model should properly handle function calls.
            # We'll test by checking that the model.query was called with appropriate arguments.
            coder.process("Create a simple Python script.")

            # Verify that the model was called
            assert mock_model.query.called
            # Check that the system prompt includes the updated wording from the fix
            call_args = mock_model.query.call_args[0]
            chat_history = call_args[0]
            system_messages = [msg for msg in chat_history if msg.get('role') == 'system']
            assert len(system_messages) > 0
            system_content = system_messages[0].get('content', '')
            assert "Your can leverage your capabilities by using the specific functions listed below:" in system_content

    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)[0m
