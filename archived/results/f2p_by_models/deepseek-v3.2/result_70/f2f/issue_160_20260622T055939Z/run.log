        mock_tool_use.type = "tool_use"
        mock_tool_use.name = "create_file"
        mock_tool_use.id = "tool_123"
        mock_tool_use.input = {"path": "test.py", "content": "print('hello')"}
        
        mock_completion.content = [mock_tool_use]
        
        # Create model with mocked client
        with patch('mle.model.OpenAI') as mock_openai_class, \
             patch('mle.model.Anthropic') as mock_anthropic_class:
            
            # Mock the Anthropic client
            mock_anthropic = MagicMock()
            mock_anthropic_class.return_value = mock_anthropic
            
            # Mock the messages.create method to return our tool_use response
            mock_messages = MagicMock()
            mock_anthropic.messages = mock_messages
            mock_messages.create.return_value = mock_completion
            
            # Create model instance (will use Claude path due to model name)
            model = Model(api_key="test-key", model="claude-3-opus-20240229")
            
            # Create coder agent
            coder = Coder(model=model, working_dir=self.test_dir)
            
            # Mock the actual function call
            with patch('mle.function.files.create_file') as mock_create_file:
                mock_create_file.return_value = "File created successfully"
                
                # Test query with functions
                chat_history = [
                    {"role": "user", "content": "Create a Python file called test.py"}
                ]
                
                functions = [
                    {
                        "name": "create_file",
                        "description": "Create a file",
                        "parameters": {
                            "type": "object",
                            "properties": {
                                "path": {"type": "string"},
                                "content": {"type": "string"}
                            }
                        }
                    }
                ]
                
                # This should trigger the tool_use path and call create_file
                response = model.query(chat_history, functions=functions)
                
                # In buggy version, this would return empty text without calling create_file
                # After fix, it should process the tool_use and call create_file
                
                # Check that create_file was called
                mock_create_file.assert_called_once_with(path="test.py", content="print('hello')")
                
                # The response should be from the recursive query after tool result
                # Since we're mocking, we need to check the second call
                assert mock_messages.create.call_count >= 1
                
                # Check that chat_history was extended with tool results
                assert len(chat_history) > 1  # Should have assistant and user tool result messages

