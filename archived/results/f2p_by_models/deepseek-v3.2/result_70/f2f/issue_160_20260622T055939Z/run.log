                            "description": "Create a file with given content",
                            "parameters": {
                                "type": "object",
                                "properties": {
                                    "file_path": {"type": "string"},
                                    "content": {"type": "string"}
                                },
                                "required": ["file_path", "content"]
                            }
                        }
                    ])
                    
                    # In buggy version, response might be empty or not trigger function calls
                    # After fix, function should be called and result added to chat history
                    assert mock_get_function.called, "Function should be called for tool use"
                    assert mock_add_tool_result.called, "Tool result should be added to chat history"
                    
                    # Verify the function was called with correct arguments
                    mock_func.assert_called_once_with(file_path="test.py", content="print('Hello World')")
                    
                except Exception as e:
                    # In buggy version, this might fail due to missing tool handling
                    # We'll let the test fail naturally
                    raise

    @patch('mle.model.Model._add_tool_result_into_chat_history')
    @patch('mle.model.Model.query')
    def test_coder_agent_completes_with_text_response(self, mock_query, mock_add_tool_result):
        # Test case where model returns text response (no tool calls)
        mock_client = MagicMock()
        mock_message = MagicMock()
        mock_message.stop_reason = "end_turn"
        
        mock_text_content = MagicMock()
        mock_text_content.type = "text"
        mock_text_content.text = "I'll create the file for you."
        
        mock_message.content = [mock_text_content]
        mock_client.messages.create.return_value = mock_message
        
        model = Model(api_key="fake_key", model="claude-3-opus-20240229")
        model.client = mock_client
        
        coder = CoderAgent(model=model, working_dir=self.temp_dir)
        
        chat_history = [
            {
                "role": "user",
                "content": "What would you do to create a Python script?"
            }
        ]
        
        # Mock query to return text response
        mock_query.return_value = "I'll create the file for you."
        
        response = model.query(chat_history, functions=[])
        
        assert response == "I'll create the file for you."
        assert not mock_add_tool_result.called, "Tool result should not be added for text response"

    def test_coder_agent_initialization_with_default_model(self):
        # Test that coder agent can be initialized with default model
        # This tests the model initialization changes in the patch
        with patch('mle.model.Model.__init__', return_value=None):
            with patch('mle.model.Model.client', MagicMock()):
                coder = CoderAgent(model=None, working_dir=self.temp_dir)
                assert coder.working_dir == self.temp_dir
                assert coder.model is None

    @patch('mle.model.Model.query')
    def test_coder_agent_with_response_format(self, mock_query):
        # Test the response_format handling that was fixed in the patch
        model = Model(api_key="fake_key", model="claude-3-opus-20240229")
        
        # Mock the internal client
        mock_client = MagicMock()
        model.client = mock_client
        
        chat_history = [
            {
                "role": "system",
                "content": "You are a helpful assistant."
            },
            {
                "role": "user",
                "content": "Output in JSON format"
            }
        ]
        
        # In the buggy version, response_format might not be properly appended to system prompt
        # The fix adds proper handling without extra assistant message
        mock_message = MagicMock()
        mock_text_content = MagicMock()
        mock_text_content.type = "text"
        mock_text_content.text = '{"message": "Hello"}'
        mock_message.content = [mock_text_content]
        mock_message.stop_reason = "end_turn"
        mock_client.messages.create.return_value = mock_message
        
        response = model.query(
            chat_history,
            response_format={"type": "json_object"}
        )
        
        # Verify system prompt includes response format instruction
        call_kwargs = mock_client.messages.create.call_args[1]
        system_prompt = call_kwargs.get('system', '')
        assert "json_object" in system_prompt
        assert "without any explanatory words" in system_prompt
        
        # In buggy version, there might be an extra assistant message added
        messages = call_kwargs.get('messages', [])
        assert len(messages) == 1  # Only user message, system prompt moved to system param
        assert messages[0]["role"] == "user"

