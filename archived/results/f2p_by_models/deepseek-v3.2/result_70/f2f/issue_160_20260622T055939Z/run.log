def test_coder_agent_generates_code_with_claude():
    """
    Test that the CoderAgent correctly generates code when using Claude model.
    
    In the buggy version, the Claude model's query method didn't properly handle
    tool calls (functions), causing the agent to not generate any code.
    
    After the fix, the Claude model should properly process tool calls and
    return generated code.
    """
    # Create a temporary directory for the test
    with tempfile.TemporaryDirectory() as temp_dir:
        # Mock the Claude API to avoid real API calls
        mock_message = MagicMock()
        mock_message.content = [MagicMock(text="I'll create the main.py file")]
        mock_message.stop_reason = "end_turn"
        
        mock_client = MagicMock()
        mock_client.messages.create.return_value = mock_message
        
        # Create a mock ClaudeModel that simulates the fixed behavior
        with patch.object(ClaudeModel, '__init__', return_value=None):
            with patch.object(ClaudeModel, 'client', mock_client):
                with patch.object(ClaudeModel, 'query') as mock_query:
                    # In the buggy version, query would return empty or wrong response
                    # In the fixed version, it should properly handle tool calls
                    
                    # First, test the buggy behavior by mocking the old behavior
                    # The buggy version would not properly process tool calls
                    mock_query.side_effect = [
                        json.dumps({
                            "thoughts": "I need to create a simple Python script",
                            "function": "create_file",
                            "arguments": {
                                "file_path": "main.py",
                                "content": "print('Hello, World!')"
                            }
                        }),
                        "File created successfully"
                    ]
                    
                    # Create the agent with mocked model
                    model = ClaudeModel(api_key="fake-key", model="claude-3-opus-20240229")
                    model.query = mock_query
                    
                    coder = CoderAgent(model=model, working_dir=temp_dir)
                    
                    # Try to generate code based on a simple requirement
                    result = coder.generate_code(
                        requirement="Create a simple hello world program",
                        plan_steps=["1. Create main.py with print statement"]
                    )
                    
                    # In the buggy version, this might fail or return empty
                    # After fix, it should succeed
                    assert result is not None, "CoderAgent should return a result"
                    assert "created" in result.lower() or "success" in result.lower(), \
                        "CoderAgent should indicate successful code generation"


def test_claude_model_tool_call_handling():
    """
    Test that ClaudeModel properly handles tool/function calls.
    
    The bug was in the ClaudeModel.query method not processing tool calls correctly,
    which prevented code generation. The fix adds proper tool call handling.
    """
    # Create a mock Anthropic client
    mock_client = MagicMock()
    
    # Simulate a tool use response (what should happen in fixed version)
    mock_tool_use = MagicMock()
    mock_tool_use.type = "tool_use"
    mock_tool_use.name = "create_file"
    mock_tool_use.id = "tool_123"
    mock_tool_use.input = {"file_path": "test.py", "content": "print('test')"}
    
    mock_message = MagicMock()
    mock_message.content = [mock_tool_use]
    mock_message.stop_reason = "tool_use"
    
    mock_client.messages.create.return_value = mock_message
    
    # Mock the actual function that would be called
    with patch('mle.model.get_function') as mock_get_function:
        mock_get_function.return_value = lambda **kwargs: "File created"
        
        with patch('mle.model.process_function_name') as mock_process_name:
            mock_process_name.return_value = "create_file"
            
            # Create model instance
            model = ClaudeModel(api_key="fake-key", model="claude-3-opus-20240229")
            model.client = mock_client
            
            # Prepare chat history with system prompt
            chat_history = [
                {"role": "system", "content": "You are a helpful assistant."},
                {"role": "user", "content": "Create a test.py file"}
            ]
            
            # Test with functions parameter (tool calls)
            functions = [
                {
                    "name": "create_file",
                    "description": "Create a file",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "file_path": {"type": "string"},
                            "content": {"type": "string"}
                        }
                    }
                }
            ]
            
            # In buggy version, this would fail to process tool calls
            # In fixed version, it should recursively call query again after tool result
            with patch.object(model, 'query') as mock_recursive_query:
                mock_recursive_query.return_value = "File created successfully"
                
                result = model.query(chat_history, functions=functions)
                
                # Verify the tool call was processed
                assert mock_recursive_query.called, \
                    "ClaudeModel should recursively call query after tool use"
                
                # Verify the result is returned
                assert result == "File created successfully", \
                    "ClaudeModel should return the final result after tool processing"


def test_coder_agent_with_real_filesystem():
    """
    Test CoderAgent with actual file system operations using mocked model.
    
