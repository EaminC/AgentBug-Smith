    """
    Integration test: Coder agent using ClaudeModel should generate code via tool calls.
    """
    mock_anthropic = MagicMock()
    mock_client = MagicMock()
    mock_anthropic.Anthropic.return_value = mock_client
    sys.modules['anthropic'] = mock_anthropic

    # Mock model that returns tool_use for create_file
    model = ClaudeModel(api_key="dummy_key", model="claude-3-opus-20240229")
    model.client = mock_client

    # Setup tool_use then text response
    mock_message_tool = MagicMock()
    mock_message_tool.stop_reason = "tool_use"
    mock_tool_use = MagicMock()
    mock_tool_use.type = "tool_use"
    mock_tool_use.id = "tool_456"
    mock_tool_use.name = "create_file"
    mock_tool_use.input = {"path": "main.py", "content": "print('Hello')"}
    mock_message_tool.content = [mock_tool_use]
    
    mock_message_text = MagicMock()
    mock_message_text.stop_reason = "end_turn"
    mock_text = MagicMock()
    mock_text.type = "text"
    mock_text.text = "File created successfully."
    mock_message_text.content = [mock_text]
    
    mock_client.messages.create.side_effect = [mock_message_tool, mock_message_text]

    # Mock the actual file function to avoid side effects
    with patch('mle.function.files.create_file') as mock_create_file:
        mock_create_file.return_value = "File created"
        with patch('mle.model.get_function', return_value=mock_create_file):
            with patch('mle.model.process_function_name', return_value="create_file"):
                with patch.object(model, '_add_tool_result_into_chat_history'):
                    # Create coder agent
                    coder = Coder(model=model, working_dir="/tmp/test")
                    # Trigger code generation
                    result = coder.generate_code("Create a simple Python script")
                    # Verify that create_file was called via tool use
                    mock_create_file.assert_called_with(path="main.py", content="print('Hello')")
                    assert "File created successfully." in result


