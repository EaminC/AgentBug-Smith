    mock_content_tool.id = "test_id"
    mock_content_tool.input = {"filename": "test.py", "content": "print('hello')"}
    
    # Create a response that triggers tool use
    mock_response_tool = MagicMock()
    mock_response_tool.stop_reason = "tool_use"
    mock_response_tool.content = [mock_content_tool]
    
    # Create a mock client
    mock_client = MagicMock()
    mock_client.messages.create.return_value = mock_response_tool
    
    # Test the ClaudeModel with tool call handling
    with patch('mle.model.ClaudeModel._add_tool_result_into_chat_history'):
        with patch('mle.model.process_function_name', return_value="create_file"):
