from mle.agents.coder import Coder
from mle.model import ClaudeModel


def test_coder_generates_code_with_claude():
    """
    Test that the Coder agent can generate code using ClaudeModel.
    In buggy version, the ClaudeModel.query() may not handle tool calls correctly,
    leading to no code generation.
    After fix, the tool call handling should work and code should be generated.
    """
    # Create a temporary directory for the test
    temp_dir = tempfile.mkdtemp()
    try:
        # Mock the Claude API client to avoid real API calls
        mock_client = MagicMock()
        mock_message = MagicMock()
        mock_content = MagicMock()
        mock_content.type = "text"
        mock_content.text = '{"action": "create_file", "file_path": "test.py", "content": "print(\\"Hello\\")"}'
        mock_message.content = [mock_content]
        mock_message.stop_reason = "end_turn"
        mock_client.messages.create.return_value = mock_message

        # Create a mock ClaudeModel with mocked client
        with patch.object(ClaudeModel, '__init__', lambda self, api_key, model, temperature=0.7: None):
            with patch.object(ClaudeModel, 'client', mock_client):
                model = ClaudeModel(api_key="fake_key", model="claude-3-haiku-20240307")
                model.client = mock_client
                model.model = "claude-3-haiku-20240307"
                model.temperature = 0.7
                model.model_type = "claude"
                model.func_call_history = []

                # Create Coder with the mocked model
                coder = Coder(model, working_dir=temp_dir)

                # Mock the actual file creation function to avoid side effects
                # but we still want to verify it's called
                with patch('mle.function.files.create_file') as mock_create_file:
                    mock_create_file.return_value = "File created successfully"

                    # Trigger a chat that should lead to code generation
                    response = coder.chat([{"role": "user", "content": "Create a file test.py with print statement"}])

                    # In buggy version, the response might be empty or not trigger create_file
                    # After fix, the create_file should be called
                    # Assert that create_file was called (this will fail in buggy, pass in fixed)
                    mock_create_file.assert_called_once()
                    # Check that it was called with correct arguments
                    call_args = mock_create_file.call_args
                    assert call_args[1]['file_path'] == 'test.py'
                    assert 'print' in call_args[1]['content']

    finally:
        # Clean up temporary directory
        shutil.rmtree(temp_dir, ignore_errors=True)


def test_claude_model_tool_call_handling():
    """
    Test that ClaudeModel correctly handles tool calls (function calls).
    In buggy version, the tool call handling might be missing or broken,
    causing no code generation.
    After fix, the tool call should be processed and recursive query should happen.
    """
    # Mock the entire Claude API interaction
    mock_client = MagicMock()

    # First call: model returns a tool_use
    mock_message1 = MagicMock()
    mock_tool_use = MagicMock()
    mock_tool_use.type = "tool_use"
    mock_tool_use.name = "create_file"
    mock_tool_use.id = "tool_123"
    mock_tool_use.input = {"file_path": "test.py", "content": "print('Hello')"}
    mock_message1.content = [mock_tool_use]
    mock_message1.stop_reason = "tool_use"

    # Second call: after tool result, model returns text
    mock_message2 = MagicMock()
    mock_content = MagicMock()
    mock_content.type = "text"
    mock_content.text = "File created successfully"
    mock_message2.content = [mock_content]
    mock_message2.stop_reason = "end_turn"

    # Set up side effect for two different calls
    mock_client.messages.create.side_effect = [mock_message1, mock_message2]

    with patch.object(ClaudeModel, '__init__', lambda self, api_key, model, temperature=0.7: None):
        model = ClaudeModel(api_key="fake_key", model="claude-3-haiku-20240307")
        model.client = mock_client
        model.model = "claude-3-haiku-20240307"
        model.temperature = 0.7
        model.model_type = "claude"
        model.func_call_history = []

        # Mock the helper functions that ClaudeModel uses
        with patch('mle.model.process_function_name') as mock_process:
            mock_process.return_value = "create_file"
        with patch('mle.model.get_function') as mock_get_func:
            mock_func = MagicMock()
            mock_func.return_value = "File created"
            mock_get_func.return_value = mock_func
        with patch('mle.model.SEARCH_FUNCTIONS', []):  # Avoid search limit
            # Mock the _add_tool_result_into_chat_history method
            # In buggy version, this method might not exist or be broken
            model._add_tool_result_into_chat_history = MagicMock()

            # Make a query with functions parameter
            chat_history = [{"role": "user", "content": "Create test.py"}]
            functions = [{
                "name": "create_file",
                "description": "Create a file",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "file_path": {"type": "string"},
                        "content": {"type": "string"}
                    }
                }
            }]

            response = model.query(chat_history, functions=functions)

            # In buggy version:
            # - The tool call handling might be missing, so query returns only the first response
            # - Or the recursive call might not happen
            # After fix:
            # - The tool call should be processed
            # - _add_tool_result_into_chat_history should be called
            # - Recursive query should happen and return the final text

            # Check that client.messages.create was called twice (once for tool_use, once for final)
            assert mock_client.messages.create.call_count == 2

            # Check that _add_tool_result_into_chat_history was called
            # This will fail in buggy version if the method doesn't exist or isn't called
            model._add_tool_result_into_chat_history.assert_called_once()

            # Check final response
            assert response == "File created successfully"


