            # Simulate tool call for create_directory
            if "create_directory" in str(chat_history):
                # In the fixed version, tool calls are processed
                # and chat_history is extended with tool results
                return "Directory created"
            # Simulate tool call for create_file  
            elif "create_file" in str(chat_history):
                return "File created"
            # Final response
            else:
                return "Project structure created successfully"
        
        mock_model.query.side_effect = mock_query
        
        # Create CoderAgent with mock model
        coder = CoderAgent(model=mock_model, working_dir=temp_dir, console=mock_console)
        
        # Test creating a simple project
        task = "Create a Python project with main.py"
        
        # Mock the actual file operations to avoid side effects
        with patch('mle.function.files.create_directory') as mock_create_dir:
            with patch('mle.function.files.create_file') as mock_create_file:
                mock_create_dir.return_value = "Directory created"
                mock_create_file.return_value = "File created"
                
                # In the buggy version, this might fail or not generate code
                # In the fixed version, it should work
                try:
                    result = coder.run(task)
                    # If we get here without errors, the agent is working
                    assert result is not None
                except Exception as e:
                    # In buggy version, we might get an error
                    # This test should pass in fixed version
                    raise AssertionError(f"CoderAgent failed: {e}")
                
    finally:
        os.chdir(original_dir)
        shutil.rmtree(temp_dir, ignore_errors=True)


def test_response_format_fix():
    """
    Test that the response_format fix works correctly.
    
    The patch changes how response_format is handled in the Claude model.
    Previously it added confusing messages to chat_history, now it just
    modifies the system prompt appropriately.
    """
    # Create a model instance
    with patch.dict(os.environ, {'ANTHROPIC_API_KEY': 'test_key'}):
        # Mock the entire anthropic module to avoid import issues
        with patch('mle.model.anthropic', MagicMock()):
            model = Model(api_key='test_key', model='claude-3-opus-20240229', model_type='claude')
            
            # Test that response_format modifies system prompt correctly
            chat_history = [
                {"role": "system", "content": "Base system prompt."},
                {"role": "user", "content": "Generate JSON"}
            ]
            
            # Mock the client's messages.create method
            mock_client = MagicMock()
            mock_response = MagicMock()
            mock_content = MagicMock()
            mock_content.type = "text"
            mock_content.text = '{"key": "value"}'
            mock_response.content = [mock_content]
            mock_response.stop_reason = "stop"
            mock_client.messages.create.return_value = mock_response
            
            model.client = mock_client
            
            # Call query with response_format
            result = model.query(
                chat_history, 
                response_format={"type": "json_object"}
            )
            
            # Verify the result
            assert result == '{"key": "value"}'
            
            # Verify the system prompt was modified correctly
            # In the buggy version, it would add a confusing assistant message
            # In the fixed version, it only modifies the system prompt
            call_args = mock_client.messages.create.call_args
            
            # Check that system prompt contains the response format instruction
            system_prompt = call_args.kwargs.get('system', '')
            assert "json_object" in system_prompt.lower() or "json" in system_prompt.lower()
            
            # Check that no extra assistant message was added to messages
            messages = call_args.kwargs.get('messages', [])
            assistant_messages = [msg for msg in messages if msg.get('role') == 'assistant']
            # There should be no assistant messages added by response_format handling
            assert len(assistant_messages) == 0


if __name__ == "__main__":
    pytest.main([__file__, "-v"])[0m
