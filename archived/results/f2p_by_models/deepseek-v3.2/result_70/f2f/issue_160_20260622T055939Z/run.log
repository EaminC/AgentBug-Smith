def test_claude_model_tool_use_handling():
    """
    Direct test of ClaudeModel.query tool use handling.
    The bug was that tool_use stop_reason led to no recursion and no function execution.
    The fix adds recursion and function calling.
    """
    # Mock the Anthropic client
    mock_messages_create = MagicMock()
    mock_client = MagicMock()
    mock_client.messages.create = mock_messages_create

    with patch.object(ClaudeModel, '__init__', lambda self, api_key, model, temperature=0.7: None):
        model = ClaudeModel(api_key="fake", model="claude-3-opus-20240229")
        model.client = mock_client
        model.func_call_history = []
        model.model = "claude-3-opus-20240229"
        model.model_type = "claude"
        model.temperature = 0.7

        # First call: tool_use
        mock_tool_use = MagicMock()
        mock_tool_use.type = "tool_use"
        mock_tool_use.name = "execute_command"
        mock_tool_use.id = "tool_456"
        mock_tool_use.input = {"command": "ls"}
        mock_completion1 = MagicMock()
        mock_completion1.stop_reason = "tool_use"
        mock_completion1.content = [mock_tool_use]

        # Second call: end_turn with text
        mock_text_response = MagicMock()
        mock_text_response.text = "Command executed."
        mock_completion2 = MagicMock()
        mock_completion2.stop_reason = "end_turn"
        mock_completion2.content = [mock_text_response]

        mock_messages_create.side_effect = [mock_completion1, mock_completion2]

        with patch('mle.model.process_function_name', return_value="execute_command"):
            with patch('mle.model.get_function') as mock_get_function:
                mock_func = MagicMock()
                mock_func.return_value = "output"
                mock_get_function.return_value = mock_func
                with patch('mle.model.SEARCH_FUNCTIONS', []):
