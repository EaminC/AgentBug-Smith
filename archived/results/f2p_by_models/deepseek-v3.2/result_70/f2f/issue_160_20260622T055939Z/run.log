def test_claude_model_tool_use_handling():
    """
    Test that ClaudeModel correctly handles tool_use stop_reason and recursively calls query.
    """
    # Mock the anthropic module to avoid ImportError
    mock_anthropic = MagicMock()
    mock_client = MagicMock()
    mock_anthropic.Anthropic.return_value = mock_client
    sys.modules['anthropic'] = mock_anthropic

    # Create model instance
    model = ClaudeModel(api_key="dummy_key", model="claude-3-opus-20240229")
    model.client = mock_client

    # Setup tool_use response
    mock_message_tool = MagicMock()
    mock_message_tool.stop_reason = "tool_use"
    mock_tool_use = MagicMock()
    mock_tool_use.type = "tool_use"
    mock_tool_use.id = "tool_123"
    mock_tool_use.name = "create_file"
    mock_tool_use.input = {"path": "test.py", "content": "print('hello')"}
    mock_message_tool.content = [mock_tool_use]
    
    # Setup text response after tool result
    mock_message_text = MagicMock()
    mock_message_text.stop_reason = "end_turn"
    mock_text = MagicMock()
    mock_text.type = "text"
    mock_text.text = "File created."
    mock_message_text.content = [mock_text]

    # Mock the recursive call pattern
    mock_client.messages.create.side_effect = [mock_message_tool, mock_message_text]

    # Mock get_function to return a dummy function
    with patch('mle.model.get_function') as mock_get_func:
        mock_func = MagicMock(return_value="tool_result")
        mock_get_func.return_value = mock_func

        # Mock process_function_name
        with patch('mle.model.process_function_name', return_value="create_file"):
            # Mock _add_tool_result_into_chat_history
            with patch.object(model, '_add_tool_result_into_chat_history') as mock_add:
                result = model.query(
                    chat_history=[{"role": "user", "content": "Create a file"}],
                    functions=[{"name": "create_file", "parameters": {"type": "object", "properties": {}}}]
                )
                assert result == "File created."
                # Verify tool was called
                mock_get_func.assert_called_with("create_file")
                mock_func.assert_called_with(path="test.py", content="print('hello')")
                # Verify tool result added to history
                assert mock_add.called
                # Verify second query call happened
                assert mock_client.messages.create.call_count == 2


