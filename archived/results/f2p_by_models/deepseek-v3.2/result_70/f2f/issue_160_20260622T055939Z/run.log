def test_claude_model_response_format_fix():
    """
    Test that the response_format handling is fixed in the Claude model.
    The buggy code appended an extra assistant message; fixed code only modifies system prompt.
    """
    mock_client = MagicMock()
    mock_message = MagicMock()
    mock_message.stop_reason = "end_turn"
    mock_content = MagicMock()
    mock_content.type = "text"
    mock_content.text = '{"key": "value"}'
    mock_message.content = [mock_content]
    mock_client.messages.create.return_value = mock_message

    model = ClaudeModel(api_key="dummy", model="claude-3-5-sonnet-20241022")
    model.client = mock_client

    chat_history = [
        {"role": "system", "content": "You are a coder."},
        {"role": "user", "content": "Output JSON."}
    ]
    # In the buggy code, the response_format would cause an extra assistant message.
    # In the fixed code, it only modifies the system prompt.
    result = model.query(chat_history, response_format={"type": "json_object"})
    assert result == '{"key": "value"}'
    # Check that the system prompt includes the response_format instruction
    call_kwargs = mock_client.messages.create.call_args[1]
    system_prompt = call_kwargs.get('system', '')
    assert "json_object" in system_prompt
    # Ensure no extra assistant message was added (messages list should have only user message)
    messages = call_kwargs.get('messages', [])
    # Only one user message (system filtered out)
    assert len(messages) == 1
    assert messages[0]["role"] == "user"

