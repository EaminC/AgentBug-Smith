def test_claude_model_tool_call_handling():
    """
    Test that the Claude model correctly handles tool calls.
    This is the core fix in the patch.
    """
    # Create a mock Claude client
    mock_client = MagicMock()

    # Create a Model instance
    model = Model(api_key="test_key", model="claude-3-opus-20240229")
    model.client = mock_client

    # Prepare test data
    chat_history = [
        {"role": "user", "content": "Create a file test.py"}
    ]

    functions = [
        {
            "name": "create_file",
            "description": "Create a file",
            "parameters": {
                "type": "object",
                "properties": {
                    "file_path": {"type": "string"},
                    "content": {"type": "string"}
                }
            }
        }
    ]

    # Test 1: Buggy version - returns text without tool handling
    # In the buggy version, the query method would just return text
    mock_message = MagicMock()
    mock_content = MagicMock()
    mock_content.type = "text"
    mock_content.text = "I'll create that file for you."
    mock_message.content = [mock_content]
    mock_message.stop_reason = "stop_sequence"
    mock_client.messages.create.return_value = mock_message

    response = model.query(chat_history, functions=functions)
    # In buggy version, this would be text, not a function call
    assert isinstance(response, str)

    # Test 2: Fixed version - handles tool calls
    # Reset mock
    mock_client.messages.create.reset_mock()

    # Create a tool use response
    mock_tool_use = MagicMock()
    mock_tool_use.type = "tool_use"
    mock_tool_use.id = "toolu_123"
    mock_tool_use.name = "create_file"
    mock_tool_use.input = {"file_path": "test.py", "content": "print('hello')"}

    mock_tool_content = MagicMock()
    mock_tool_content.type = "tool_use"
    mock_tool_content.name = "create_file"
    mock_tool_content.input = {"file_path": "test.py", "content": "print('hello')"}
    mock_tool_content.id = "toolu_123"

    mock_message2 = MagicMock()
    mock_message2.content = [mock_tool_content]
    mock_message2.stop_reason = "tool_use"

    # Mock the recursive call after tool result
    mock_text_content = MagicMock()
    mock_text_content.type = "text"
    mock_text_content.text = "Done."
    mock_message3 = MagicMock()
    mock_message3.content = [mock_text_content]
    mock_message3.stop_reason = "stop_sequence"

    mock_client.messages.create.side_effect = [mock_message2, mock_message3]

    # Mock the function call
    with patch('mle.function.files.create_file') as mock_create_file:
        mock_create_file.return_value = "File created"

        # Also need to mock the helper function that processes function names
        with patch('mle.model.process_function_name') as mock_process:
            mock_process.return_value = "create_file"

            response = model.query(chat_history, functions=functions)

            # In the fixed version, the function should have been called
            mock_create_file.assert_called_once_with(file_path="test.py", content="print('hello')")
            # And the final response should be the text
            assert response == "Done."


