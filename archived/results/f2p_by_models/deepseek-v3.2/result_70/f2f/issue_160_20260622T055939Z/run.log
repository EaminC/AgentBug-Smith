def test_claude_model_functions_mapping():
    """
    Test that OpenAI-style functions are mapped to Claude tools.
    """
    mock_anthropic = MagicMock()
    mock_client = MagicMock()
    mock_anthropic.Anthropic.return_value = mock_client
    sys.modules['anthropic'] = mock_anthropic

    model = ClaudeModel(api_key="dummy_key", model="claude-3-opus-20240229")
    model.client = mock_client

    mock_message = MagicMock()
    mock_message.stop_reason = "end_turn"
    mock_text = MagicMock()
    mock_text.type = "text"
    mock_text.text = "Done."
    mock_message.content = [mock_text]
    mock_client.messages.create.return_value = mock_message

    functions = [
        {
            "name": "create_file",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {"type": "string"},
                    "content": {"type": "string"}
                }
            }
        }
    ]
    result = model.query(
        chat_history=[{"role": "user", "content": "Do something"}],
        functions=functions
    )
    assert result == "Done."
    # Verify functions were transformed to tools
    call_kwargs = mock_client.messages.create.call_args[1]
    tools = call_kwargs.get('tools', [])
    assert len(tools) == 1
    tool = tools[0]
    assert 'input_schema' in tool
    assert 'parameters' not in tool
    assert tool['name'] == 'create_file'


