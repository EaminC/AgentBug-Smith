def test_claude_model_tool_use_handling():
    """
    Test that ClaudeModel correctly handles tool_use responses and recursively calls query.
    Bug: In buggy code, ClaudeModel.query did not handle tool_use stop_reason,
         leading to no code generation.
    Fix: Added tool_use handling, tool schema conversion, and recursive query.
    """
    # Create a temporary directory for the test
    temp_dir = tempfile.mkdtemp()
    try:
        # Mock the Anthropic client to simulate a tool_use response
        mock_client = MagicMock()
        mock_message = MagicMock()
        mock_message.stop_reason = "tool_use"
        mock_tool_use = MagicMock()
        mock_tool_use.type = "tool_use"
        mock_tool_use.name = "create_file"
        mock_tool_use.id = "tool_123"
        mock_tool_use.input = {"path": "test.py", "content": "print('hello')"}
        mock_message.content = [mock_tool_use]
        mock_client.messages.create.return_value = mock_message

        # Create a ClaudeModel instance with mocked client
        with patch.object(ClaudeModel, 'anthropic', return_value=mock_client):
            model = ClaudeModel(api_key="fake_key", model="claude-3-opus-20240229")
            # Replace the client attribute directly to ensure our mock is used
            model.client = mock_client

            # Mock the function that processes tool calls
            with patch('mle.model.process_function_name', return_value='create_file'):
                with patch('mle.model.get_function') as mock_get_function:
                    mock_func = Mock(return_value="file created")
                    mock_get_function.return_value = mock_func
                    # Mock the internal _add_tool_result_into_chat_history method
                    # to avoid side effects
                    model._add_tool_result_into_chat_history = Mock()
                    # Mock the recursive query call to return a final text response
                    model.query = Mock(side_effect=[
                        None,  # First call will trigger tool_use handling
                        "Code generated successfully"  # Second call after tool result
                    ])

                    # Prepare chat history
                    chat_history = [
                        {"role": "system", "content": "You are a programmer."},
                        {"role": "user", "content": "Create a test file."}
                    ]
                    # Call query with functions parameter
                    result = model.query(chat_history, functions=[
                        {
                            "name": "create_file",
                            "description": "Create a file",
                            "parameters": {
                                "type": "object",
                                "properties": {
                                    "path": {"type": "string"},
                                    "content": {"type": "string"}
                                }
                            }
                        }
                    ])

                    # Verify that the client was called with correct arguments
                    mock_client.messages.create.assert_called_once()
                    call_kwargs = mock_client.messages.create.call_args[1]
                    assert call_kwargs['model'] == model.model
                    assert call_kwargs['system'] == "You are a programmer."
                    # Check that tools were transformed (parameters -> input_schema)
                    tools = call_kwargs.get('tools', [])
                    assert len(tools) == 1
                    assert 'input_schema' in tools[0]
                    assert 'parameters' not in tools[0]

                    # Verify that process_function_name was called
                    from mle.model import process_function_name
                    process_function_name.assert_called_once_with('create_file')

                    # Verify that get_function was called with correct arguments
                    mock_get_function.assert_called_once_with('create_file')
                    mock_func.assert_called_once_with(path='test.py', content="print('hello')")

                    # Verify that _add_tool_result_into_chat_history was called
                    model._add_tool_result_into_chat_history.assert_called_once()

                    # Verify that recursive query was called
                    assert model.query.call_count == 2

    finally:
