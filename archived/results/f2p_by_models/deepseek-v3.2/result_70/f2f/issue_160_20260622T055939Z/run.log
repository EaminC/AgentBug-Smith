def test_coder_agent_with_claude():
    """
    Test that CoderAgent works correctly with ClaudeModel, specifically
    that it can generate code when prompted.
    """
    temp_dir = tempfile.mkdtemp()
    try:
        # Create a mock ClaudeModel that simulates code generation
        mock_model = MagicMock(spec=ClaudeModel)
        
        # Mock the query method to return code content
        code_response = """```python
def hello_world():
    print("Hello, World!")
```"""
        
        mock_model.query.return_value = code_response
        
        # Create CoderAgent with mocked model
        coder = CoderAgent(model=mock_model, working_dir=temp_dir)
        
        # Test creating a simple file
        prompt = "Create a hello world Python script"
        
        # In buggy version, the coder might not generate proper code
        # due to issues with Claude model's tool handling
        
        # We'll test the internal _ask method which is called by the agent
        # This method should handle the conversation with the model
        
        # Mock the function registry to avoid actual file operations
        with patch('mle.agents.coder.function_registry', {}):
            # Try to get a response from the agent
            try:
                # The agent might have different methods, let's check what's available
                if hasattr(coder, '_ask'):
                    response = coder._ask(prompt)
                    
                    # In fixed version, we should get a proper response
                    # In buggy version, response might be empty or malformed
                    assert response is not None
                    assert len(response) > 0
                    
                    # Check that the model was called
                    mock_model.query.assert_called()
                    
                else:
                    # If _ask doesn't exist, try another approach
