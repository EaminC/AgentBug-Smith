[32m# branch: TypeScript/pnpm-monorepo - Forge API configuration
FROM node:20-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    make \
    g++ \
    git \
    curl \
    wget \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm globally
RUN npm install -g pnpm@8.10.5

# Set up pnpm environment
ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH="$PNPM_HOME:$PATH"

# Copy entire repository
COPY . .

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build core package first (most dependencies depend on it)
RUN cd packages/core && pnpm build || echo "Core build may have warnings"

# Build all packages
RUN pnpm run build:all || echo "Some packages may have build warnings"

# Install Jest globally for easier access
RUN npm install -g jest

# Verify critical packages are built
RUN ls -la packages/core/dist/ && \
    echo "Core package built: $(ls packages/core/dist/*.js 2>/dev/null | wc -l) JS files" && \
    echo "Core package types: $(ls packages/core/dist/*.d.ts 2>/dev/null | wc -l) type files"

# Set up environment
ENV PATH="/app/node_modules/.bin:$PATH"
ENV NODE_ENV="test"

# Create a simple test verification script
RUN cat > /tmp/verify-test.js << 'EOF'
const fs = require('fs');
const path = require('path');

console.log('=== Test Environment Verification ===');

// Check critical files
const checks = [
  { name: 'Root package.json', path: 'package.json', exists: fs.existsSync('package.json') },
  { name: 'PNPM workspace config', path: 'pnpm-workspace.yaml', exists: fs.existsSync('pnpm-workspace.yaml') },
  { name: 'Core package dist', path: 'packages/core/dist', exists: fs.existsSync('packages/core/dist') },
  { name: 'Anthropic package', path: 'packages/anthropic-ai', exists: fs.existsSync('packages/anthropic-ai') },
  { name: 'Jest in node_modules', path: 'node_modules/jest', exists: fs.existsSync('node_modules/jest') },
];

checks.forEach(check => {
  console.log(`${check.exists ? '✓' : '✗'} ${check.name}: ${check.path}`);
});

// Check environment variables
console.log('\n=== Environment Variables ===');
console.log('OPENAI_BASE_URL:', process.env.OPENAI_BASE_URL ? '✓ Set' : '✗ Not set');
console.log('ANTHROPIC_AUTH_TOKEN:', process.env.ANTHROPIC_AUTH_TOKEN ? '✓ Set' : '✗ Not set');
console.log('NODE_ENV:', process.env.NODE_ENV);

// Try to import core package
try {
  const corePath = path.join(process.cwd(), 'packages', 'core', 'dist', 'index.js');
  if (fs.existsSync(corePath)) {
    console.log('\n✓ Core package built and accessible');
  } else {
    console.log('\n✗ Core package not built at expected path');
  }
} catch (err) {
  console.log('\n✗ Error checking core package:', err.message);
}

console.log('====================================');
EOF

RUN node /tmp/verify-test.js

# Set default command
CMD ["/bin/bash"][0m
