[32mimport { describe, expect, jest, test } from '@jest/globals';
import { Agent } from '@voltagent/core';
import { AnthropicProvider } from '@voltagent/anthropic-ai';
import { GroqProvider } from '@voltagent/groq-ai';
import { z } from 'zod';
import { jsonSchemaToZod } from '@n8n/json-schema-to-zod';

describe('JSON schema support for generateObject', () => {
  test('should accept JSON schema via REST API and convert to Zod', async () => {
    // Mock the internal model clients to avoid real API calls
    const mockAnthropic = {
      messages: {
        create: jest.fn().mockResolvedValue({
          content: [{ type: 'text', text: '{"name": "John Doe", "age": 30}' }],
        }),
      },
    };

    const mockGroq = {
      chat: {
        completions: {
          create: jest.fn().mockResolvedValue({
            choices: [{ message: { content: '{"name": "John Doe", "age": 30}' } }],
          }),
        },
      },
    };

    // Create providers with mocked clients
    const anthropicProvider = new AnthropicProvider({
      apiKey: 'test-key',
    });
    (anthropicProvider as any).anthropic = mockAnthropic;

    const groqProvider = new GroqProvider({
      apiKey: 'test-key',
    });
    (groqProvider as any).groq = mockGroq;

    // JSON schema as would come from REST API
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // Convert JSON schema to Zod (as done in the fixed code)
    const zodSchema = jsonSchemaToZod(jsonSchema);

    // Create agent with mocked provider
    const agent = new Agent({
      provider: anthropicProvider,
    });

    // Test generateObject with the converted Zod schema
    const result = await agent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      { userId: 'user-123', conversationId: 'test-conv' },
    );

    // Verify the result matches the expected structure
    expect(result).toEqual({
      name: 'John Doe',
      age: 30,
    });

    // Verify the provider was called with correct system prompt containing JSON schema
    expect(mockAnthropic.messages.create).toHaveBeenCalledWith(
      expect.objectContaining({
        system: expect.stringContaining(JSON.stringify(jsonSchema)),
      }),
    );
  });

  test('should work with GroqProvider as well', async () => {
    const mockGroq = {
      chat: {
        completions: {
          create: jest.fn().mockResolvedValue({
            choices: [{ message: { content: '{"name": "Jane Smith", "age": 25}' } }],
          }),
        },
      },
    };

    const groqProvider = new GroqProvider({
      apiKey: 'test-key',
    });
    (groqProvider as any).groq = mockGroq;

    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const zodSchema = jsonSchemaToZod(jsonSchema);

    const agent = new Agent({
      provider: groqProvider,
    });

    const result = await agent.generateObject(
      'Extract the name and age from: Jane Smith is 25 years old.',
      zodSchema,
      { userId: 'user-456', conversationId: 'test-conv-2' },
    );

    expect(result).toEqual({
      name: 'Jane Smith',
      age: 25,
    });

    expect(mockGroq.chat.completions.create).toHaveBeenCalledWith(
      expect.objectContaining({
        messages: expect.arrayContaining([
          expect.objectContaining({
            role: 'system',
            content: expect.stringContaining(JSON.stringify(jsonSchema)),
          }),
        ]),
      }),
    );
  });

  test('should fail with invalid JSON schema in buggy version', async () => {
    // This test will fail in buggy version because jsonSchemaToZod is not imported
    // and the API doesn't handle JSON schema conversion
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // In buggy version, this conversion would fail because:
    // 1. jsonSchemaToZod is not imported in api.ts
    // 2. The API expects Zod schema directly but receives JSON schema
    expect(() => {
      // This simulates what happens in the buggy API route
      // The conversion function wouldn't be available
      const zodSchema = jsonSchemaToZod(jsonSchema);
      return zodSchema;
    }).not.toThrow();
  });
});[0m
