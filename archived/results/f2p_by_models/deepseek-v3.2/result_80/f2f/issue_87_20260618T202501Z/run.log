[32mimport { describe, expect, jest, test } from '@jest/globals';
import { Agent } from '@voltagent/core';
import { AnthropicProvider } from '@voltagent/anthropic-ai';
import { GroqProvider } from '@voltagent/groq-ai';
import { z } from 'zod';
import { jsonSchemaToZod } from '@n8n/json-schema-to-zod';

describe('JSON schema handling for generateObject', () => {
  const mockAnthropic = {
    messages: {
      create: jest.fn(),
    },
  };

  const mockGroq = {
    chat: {
      completions: {
        create: jest.fn(),
      },
    },
  };

  beforeEach(() => {
    jest.clearAllMocks();
  });

  test('should fail on buggy code because JSON schema is not converted to Zod', async () => {
    // Simulate the buggy state: the API route expects a Zod schema but receives JSON schema
    // In the buggy code, the route passes the raw JSON schema to agent.generateObject
    // which expects a Zod schema, causing a runtime error.
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // Create a mock agent that mimics the buggy behavior
    const agent = new Agent({
      provider: new AnthropicProvider({
        apiKey: 'test-key',
        model: 'claude-3-haiku-20240307',
      }),
    });

    // Mock the internal Anthropic client to avoid real API calls
    // @ts-ignore
    agent.provider.anthropic = mockAnthropic;

    // Simulate the bug: agent.generateObject expects a Zod schema but gets JSON schema
    // In the buggy code, the route passes jsonSchema directly without conversion.
    // This should throw because the internal provider expects a Zod schema.
    await expect(async () => {
      // This mimics the buggy route's call before the fix
      await agent.generateObject(
        'Extract the name and age from: John Doe is 30 years old.',
        // @ts-ignore - passing JSON schema instead of Zod schema
        jsonSchema,
        {},
      );
    }).rejects.toThrow();
  });

  test('should pass after fix because JSON schema is converted to Zod', async () => {
    // After the fix, the route converts JSON schema to Zod using jsonSchemaToZod
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // Convert JSON schema to Zod schema (as done in the fixed route)
    const zodSchema = jsonSchemaToZod(jsonSchema);

    // Create agent with mocked provider
    const agent = new Agent({
      provider: new GroqProvider({
        apiKey: 'test-key',
        model: 'mixtral-8x7b-32768',
      }),
    });

    // Mock the internal Groq client to return a valid response
    // @ts-ignore
    agent.provider.groq = mockGroq;
    mockGroq.chat.completions.create.mockResolvedValue({
      choices: [
        {
          message: {
            content: '{"name": "John Doe", "age": 30}',
          },
        },
      ],
    });

    // This should succeed because zodSchema is a proper Zod schema
    const result = await agent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      {},
    );

    expect(result).toEqual({ name: 'John Doe', age: 30 });
  });

  test('should fail on buggy code for streamObject with JSON schema', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        title: { type: 'string' },
        count: { type: 'number' },
      },
      required: ['title'],
    };

    const agent = new Agent({
      provider: new GroqProvider({
        apiKey: 'test-key',
        model: 'mixtral-8x7b-32768',
      }),
    });

    // @ts-ignore
    agent.provider.groq = mockGroq;

    // Mock the stream response
    const mockStream = {
      objectStream: {
        getReader: () => ({
          read: async () => ({ done: true, value: { title: 'Test', count: 5 } }),
        }),
      },
    };
    mockGroq.chat.completions.create.mockResolvedValue(mockStream);

    // In buggy code, passing JSON schema directly should cause an error
    await expect(async () => {
      // @ts-ignore - passing JSON schema instead of Zod schema
      await agent.streamObject('Generate an object', jsonSchema, {});
    }).rejects.toThrow();
  });

  test('should pass after fix for streamObject with converted Zod schema', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        title: { type: 'string' },
        count: { type: 'number' },
      },
      required: ['title'],
    };

    const zodSchema = jsonSchemaToZod(jsonSchema);

    const agent = new Agent({
      provider: new GroqProvider({
        apiKey: 'test-key',
        model: 'mixtral-8x7b-32768',
      }),
    });

    // @ts-ignore
    agent.provider.groq = mockGroq;

    // Mock a streaming response
    const mockAsyncIterable = (async function* () {
      yield { title: 'Test', count: 5 };
    })();
    const mockStream = {
      objectStream: {
        getReader: () => ({
          read: () => mockAsyncIterable.next(),
        }),
      },
    };
    mockGroq.chat.completions.create.mockResolvedValue(mockStream);

    // After fix, this should work
    const stream = await agent.streamObject('Generate an object', zodSchema, {});
    expect(stream).toBeDefined();
  });
});[0m
