[32mimport { describe, it, expect, jest, beforeEach } from '@jest/globals';
import { Agent } from '@voltagent/core';
import { AnthropicProvider } from '@voltagent/anthropic-ai';
import { GroqProvider } from '@voltagent/groq-ai';
import { z } from 'zod';
import { jsonSchemaToZod } from '@n8n/json-schema-to-zod';

describe('Issue #87: JSON/Zod schema handling for generateObject', () => {
  let agent: Agent;

  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('should accept JSON schema via REST API and convert to Zod internally', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' }
      },
      required: ['name', 'age']
    };

    const mockAnthropicResponse = {
      content: [{ type: 'text', text: '{"name": "John Doe", "age": 30}' }]
    };

    const mockAnthropic = {
      messages: {
        create: jest.fn().mockResolvedValue(mockAnthropicResponse)
      }
    };

    const mockGroq = {
      chat: {
        completions: {
          create: jest.fn().mockResolvedValue({
            choices: [{
              message: {
                content: '{"name": "John Doe", "age": 30}'
              }
            }]
          })
        }
      }
    };

    // Mock the internal network clients
    jest.spyOn(AnthropicProvider.prototype as any, 'anthropic', 'get').mockReturnValue(mockAnthropic);
    jest.spyOn(GroqProvider.prototype as any, 'groq', 'get').mockReturnValue(mockGroq);

    // Create agent with mocked providers
    agent = new Agent({
      provider: new AnthropicProvider({ apiKey: 'test-key' }),
      model: 'claude-3-5-sonnet-20241022'
    });

    // Convert JSON schema to Zod using the same function as the fixed code
    const zodSchema = jsonSchemaToZod(jsonSchema);
    
    // This should work in the fixed code but fail in buggy code
    const result = await agent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      { userId: 'user-123', conversationId: 'test-conv' }
    );

    expect(result).toEqual({
      name: 'John Doe',
      age: 30
    });
  });

  it('should fail with JSON schema in buggy code (before patch)', async () => {
    // This test simulates the buggy behavior where JSON schema isn't properly converted
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' }
      },
      required: ['name', 'age']
    };

    // In buggy code, the API would try to use JSON schema directly without conversion
    // This should throw an error or return failure
    const agent = new Agent({
      provider: new AnthropicProvider({ apiKey: 'test-key' }),
      model: 'claude-3-5-sonnet-20241022'
    });

    try {
      // Attempt to use JSON schema directly (buggy behavior)
      await agent.generateObject(
        'Extract the name and age from: John Doe is 30 years old.',
        jsonSchema as any, // Type assertion to simulate bug
        { userId: 'user-123', conversationId: 'test-conv' }
      );
      // If we reach here in buggy code, the test should fail
      expect(true).toBe(false); // Force test failure for buggy code
    } catch (error) {
      // In buggy code, this should throw an error
      expect(error).toBeDefined();
    }
  });

  it('should include JSON schema in system message for providers', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' }
      },
      required: ['name', 'age']
    };

    const mockAnthropicResponse = {
      content: [{ type: 'text', text: '{"name": "John Doe", "age": 30}' }]
    };

    const mockAnthropic = {
      messages: {
        create: jest.fn().mockResolvedValue(mockAnthropicResponse)
      }
    };

    const mockGroq = {
      chat: {
        completions: {
          create: jest.fn().mockResolvedValue({
            choices: [{
              message: {
                content: '{"name": "John Doe", "age": 30}'
              }
            }]
          })
        }
      }
    };

    jest.spyOn(AnthropicProvider.prototype as any, 'anthropic', 'get').mockReturnValue(mockAnthropic);
    jest.spyOn(GroqProvider.prototype as any, 'groq', 'get').mockReturnValue(mockGroq);

    const anthropicProvider = new AnthropicProvider({ apiKey: 'test-key' });
    const groqProvider = new GroqProvider({ apiKey: 'test-key' });

    const zodSchema = jsonSchemaToZod(jsonSchema);

    // Test Anthropic provider
    await anthropicProvider.generateObject({
      messages: [{ role: 'user', content: 'Extract name and age' }],
      schema: zodSchema,
      model: 'claude-3-5-sonnet-20241022',
      provider: {}
    });

    // Check that system message includes JSON schema
    expect(mockAnthropic.messages.create).toHaveBeenCalled();
    const anthropicCall = mockAnthropic.messages.create.mock.calls[0][0];
    expect(anthropicCall.system).toContain('Response Schema:');
    expect(anthropicCall.system).toContain(JSON.stringify(jsonSchema));

    // Test Groq provider
    await groqProvider.generateObject({
      messages: [{ role: 'user', content: 'Extract name and age' }],
      schema: zodSchema,
      model: 'llama-3.1-70b-versatile',
      provider: {}
    });

    expect(mockGroq.chat.completions.create).toHaveBeenCalled();
    const groqCall = mockGroq.chat.completions.create.mock.calls[0][0];
    expect(groqCall.messages[0].content).toContain('Schema:');
    expect(groqCall.messages[0].content).toContain(JSON.stringify(jsonSchema));
  });
});[0m
