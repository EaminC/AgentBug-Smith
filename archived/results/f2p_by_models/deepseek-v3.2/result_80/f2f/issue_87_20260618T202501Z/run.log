[32mimport { describe, it, expect, jest } from '@jest/globals';
import { Agent } from '@voltagent/core';
import { AnthropicProvider } from '@voltagent/anthropic-ai';
import { GroqProvider } from '@voltagent/groq-ai';
import { z } from 'zod';
import { jsonSchemaToZod } from '@n8n/json-schema-to-zod';

describe('JSON Schema support for generateObject and streamObject', () => {
  const mockAnthropicResponse = {
    id: 'msg_123',
    content: [
      {
        type: 'text',
        text: '{"name": "John Doe", "age": 30}',
      },
    ],
    model: 'claude-3-haiku-20240307',
    usage: { input_tokens: 10, output_tokens: —10 },
  };

  const mockGroqResponse = {
    id: 'chatcmpl-123',
    choices: [
      {
        index: 0,
        message: {
          role: 'assistant',
          content: '{"name": "John Doe", "age": 30}',
        },
        finish_reason: 'stop',
      },
    ],
    usage: { prompt_tokens: 10, completion_tokens: 10, total_tokens: 20 },
  };

  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('should handle JSON schema via REST API (Anthropic)', async () => {
    const mockAnthropicClient = {
      messages: {
        create: jest.fn().mockResolvedValue(mockAnthropicResponse),
      },
    };

    const provider = new AnthropicProvider({
      apiKey: 'test-key',
      anthropic: mockAnthropicClient as any,
    });

    const agent = new Agent({
      provider,
    });

    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const input = 'Extract the name and age from: John Doe is 30 years old.';
    const options = { userId: 'user-123', conversationId: 'convo-123' };

    const result = await agent.generateObject(input, jsonSchema as any, options);

    expect(mockAnthropicClient.messages.create).toHaveBeenCalledWith(
      expect.objectContaining({
        system: expect.stringContaining(JSON.stringify(jsonSchema)),
      }),
    );
    expect(result).toEqual({
      name: 'John Doe',
      age: 30,
    });
  });

  it('should handle JSON schema via REST API (Groq)', async () => {
    const mockGroqClient = {
      chat: {
        completions: {
          create: jest.fn().mockResolvedValue(mockGroqResponse),
        },
      },
    };

    const provider = new GroqProvider({
      apiKey: 'test-key',
      groq: mockGroqClient as any,
    });

    const agent = new Agent({
      provider,
    });

    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const input = 'Extract the name and age from: John Doe is 30 years old.';
    const options = { userId: 'user-123', conversationId: 'convo-123' };

    const result = await agent.generateObject(input, jsonSchema as any, options);

    expect(mockGroqClient.chat.completions.create).toHaveBeenCalledWith(
      expect.objectContaining({
        messages: expect.arrayContaining([
          expect.objectContaining({
            content: expect.stringContaining(JSON.stringify(jsonSchema)),
          }),
        ]),
      }),
    );
    expect(result).toEqual({
      name: 'John Doe',
      age: 30,
    });
  });

  it('should convert JSON schema to Zod internally', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const zodSchema = jsonSchemaToZod(jsonSchema);
    expect(zodSchema).toBeInstanceOf(z.ZodObject);
    expect(zodSchema.shape.name).toBeInstanceOf(z.ZodString);
    expect(zodSchema.shape.age).toBeInstanceOf(z.ZodNumber);
  });

  it('should fail with buggy code when JSON schema is passed directly (no conversion)', async () => {
    const mockAnthropicClient = {
      messages: {
        create: jest.fn().mockResolvedValue(mockAnthropicResponse),
      },
    };

    const provider = new AnthropicProvider({
      apiKey: 'test-key',
      anthropic: mockAnthropicClient as any,
    });

    const agent = new Agent({
      provider,
    });

    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const input = 'Extract the name and age from: John Doe is 30 years old.';
    const options = { userId: 'user-123', conversationId: 'convo-123' };

    await expect(agent.generateObject(input, jsonSchema as any, options)).rejects.toThrow();
  });

  it('should stream object with JSON schema', async () => {
    const mockAnthropicClient = {
      messages: {
        create: jest.fn().mockResolvedValue({
          ...mockAnthropicResponse,
          content: [
            {
              type: 'text',
              text: '{"name": "John", "age": 25}',
            },
          ],
        }),
      },
    };

    const provider = new AnthropicProvider({
      apiKey: 'test-key',
      anthropic: mockAnthropicClient as any,
    });

    const agent = new Agent({
      provider,
    });

    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const input = 'Extract the name and age from: John is 25 years old.';
    const options = { userId: 'user-123', conversationId: 'convo-123' };

    const stream = await agent.streamObject(input, jsonSchema as any, options);
    const reader = stream.getReader();
    const chunks = [];
    let done = false;

    while (!done) {
      const { value, done: d } = await reader.read();
      if (d) {
        done = true;
      } else {
        chunks.push(value);
      }
    }

    expect(chunks.length).toBeGreaterThan(0);
    expect(mockAnthropicClient.messages.create).toHaveBeenCalledWith(
      expect.objectContaining({
        system: expect.stringContaining(JSON.stringify(jsonSchema)),
      }),
    );
  });
});[0m
