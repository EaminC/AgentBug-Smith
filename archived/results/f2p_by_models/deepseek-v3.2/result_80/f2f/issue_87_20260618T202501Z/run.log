[32m# branch: TypeScript/pnpm-monorepo - Forge API configuration
FROM node:20-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install pnpm globally
RUN npm install -g pnpm@8.10.5

# Set up pnpm for global installs
ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN mkdir -p /root/.local/share/pnpm

# Ensure node_modules/.bin is in PATH for local binaries
ENV PATH="/app/node_modules/.bin:$PATH"

# Copy entire repository
COPY . .

# Install dependencies using pnpm
RUN pnpm install --frozen-lockfile

# Build all packages
RUN pnpm run build

# Create a test runner script that handles individual test files
# This script will be called when tests are run
RUN echo '#!/bin/bash\n\
# Test runner for VoltAgent monorepo\n\
# Handles: npm test -- packages/anthropic-ai/src/index.spec.ts\n\
# Or: /app/run-test packages/anthropic-ai/src/index.spec.ts\n\
\n\
# If no arguments, run all tests\n\
if [ $# -eq 0 ]; then\n\
  echo "Running all tests with: pnpm test"\n\
  pnpm test\n\
  exit $?\n\
fi\n\
\n\
# Check if first argument is a test file\n\
test_file="$1"\n\
\n\
# Verify test file exists\n\
if [ ! -f "$test_file" ]; then\n\
  echo "Error: Test file not found: $test_file"\n\
  exit 1\n\
fi\n\
\n\
echo "Running test: $test_file"\n\
\n\
# Handle test files in packages directory\n\
if [[ "$test_file" == packages/* ]]; then\n\
  # Extract package name\n\
  package_name=$(echo "$test_file" | cut -d"/" -f2)\n\
  \n\
  if [ -d "packages/$package_name" ]; then\n\
    echo "Changing to package directory: packages/$package_name"\n\
    cd "packages/$package_name"\n\
    \n\
    # Get relative path within package\n\
    rel_path=$(echo "$test_file" | cut -d"/" -f3-)\n\
    \n\
    # Run jest with the test file\n\
    # Use npx to run jest from package devDependencies\n\
    echo "Running: npx jest \"$rel_path\"\n\
    npx jest "$rel_path"\n\
    exit $?\n\
  else\n\
    echo "Error: Package directory not found: packages/$package_name"\n\
    exit 1\n\
  fi\n\
else\n\
  # For non-package tests, run jest from root\n\
  echo "Running test from root"\n\
  npx jest "$test_file"\n\
  exit $?\n\
fi' > /app/run-test && chmod +x /app/run-test

# Create a simple test to verify environment variables are set
