[32mimport { describe, expect, test, jest } from '@jest/globals';
import { Agent } from '@voltagent/core';
import { AnthropicProvider } from '@voltagent/anthropic-ai';
import { GroqProvider } from '@voltagent/groq-ai';
import { z } from 'zod';
import { jsonSchemaToZod } from '@n8n/json-schema-to-zod';

describe('JSON schema handling for generateObject', () => {
  test('should accept JSON schema via REST API and convert to Zod', async () => {
    // Mock the internal network calls to avoid real API calls
    const mockAnthropicCreate = jest.fn();
    const mockGroqCreate = jest.fn();

    // Mock Anthropic provider
    const anthropicProvider = new AnthropicProvider({ apiKey: 'test-key' });
    // @ts-ignore - accessing private property for mocking
    anthropicProvider.anthropic = {
      messages: {
        create: mockAnthropicCreate,
      },
    };

    // Mock Groq provider
    const groqProvider = new GroqProvider({ apiKey: 'test-key' });
    // @ts-ignore - accessing private property for mocking
    groqProvider.groq = {
      chat: {
        completions: {
          create: mockGroqCreate,
        },
      },
    };

    // Create agent with mocked providers
    const agent = new Agent({
      provider: anthropicProvider,
    });

    // JSON schema as would be sent via REST API
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // Convert JSON schema to Zod (this is what the fixed code does)
    const zodSchema = jsonSchemaToZod(jsonSchema);

    // Mock successful response from Anthropic
    mockAnthropicCreate.mockResolvedValue({
      content: [
        {
          type: 'text',
          text: JSON.stringify({ name: 'John Doe', age: 30 }),
        },
      ],
    });

    // Test generateObject with the converted Zod schema
    const result = await agent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      { userId: 'test-user' }
    );

    // Verify the result matches the expected structure
    expect(result).toEqual({
      name: 'John Doe',
      age: 30,
    });

    // Verify the mock was called with correct parameters
    expect(mockAnthropicCreate).toHaveBeenCalled();
    const callArgs = mockAnthropicCreate.mock.calls[0][0];
    expect(callArgs.system).toContain('Response Schema:');
    expect(callArgs.system).toContain(JSON.stringify(jsonSchema));
  });

  test('should handle JSON schema conversion error gracefully', async () => {
    // Create a malformed JSON schema
    const malformedSchema = {
      type: 'object',
      properties: 'not-an-object', // This should cause conversion error
    };

    // The buggy code would try to pass this directly to generateObject
    // The fixed code should convert it to Zod first
    expect(() => {
      jsonSchemaToZod(malformedSchema);
    }).toThrow();
  });

  test('should work with Groq provider as well', async () => {
    const groqProvider = new GroqProvider({ apiKey: 'test-key' });
    // @ts-ignore - accessing private property for mocking
    groqProvider.groq = {
      chat: {
        completions: {
          create: jest.fn().mockResolvedValue({
            choices: [{
              message: {
                content: JSON.stringify({ name: 'Jane Doe', age: 25 }),
              },
            }],
          }),
        },
      },
    };

    const agent = new Agent({
      provider: groqProvider,
    });

    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const zodSchema = jsonSchemaToZod(jsonSchema);

    const result = await agent.generateObject(
      'Extract the name and age from: Jane Doe is 25 years old.',
      zodSchema,
      { userId: 'test-user' }
    );

    expect(result).toEqual({
      name: 'Jane Doe',
      age: 25,
    });
  });
});[0m
