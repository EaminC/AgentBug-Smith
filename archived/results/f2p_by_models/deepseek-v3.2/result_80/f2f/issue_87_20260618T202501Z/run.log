[32mimport { describe, expect, test, beforeEach, jest } from '@jest/globals';
import { Agent } from '@voltagent/core';
import { AnthropicProvider } from '@voltagent/anthropic-ai';
import { GroqProvider } from '@voltagent/groq-ai';
import { z } from 'zod';
import { jsonSchemaToZod } from '@n8n/json-schema-to-zod';

describe('JSON schema handling in generateObject', () => {
  let agent: Agent;
  let mockAnthropic: any;
  let mockGroq: any;

  beforeEach(() => {
    // Mock the internal network clients for both providers
    mockAnthropic = {
      messages: {
        create: jest.fn(),
      },
    };
    mockGroq = {
      chat: {
        completions: {
          create: jest.fn(),
        },
      },
    };

    // Create providers with mocked clients
    const anthropicProvider = new AnthropicProvider({
      apiKey: 'test-key',
      model: 'claude-3-haiku-20240307',
    });
    const groqProvider = new GroqProvider({
      apiKey: 'test-key',
      model: 'mixtral-8x7b-32768',
    });

    // Replace the internal clients with mocks
    (anthropicProvider as any).anthropic = mockAnthropic;
    (groqProvider as any).groq = mockGroq;

    // Create agent with both providers
    agent = new Agent({
      providers: {
        anthropic: anthropicProvider,
        groq: groqProvider,
      },
      defaultProvider: 'anthropic',
    });
  });

  test('should accept JSON schema via REST API and convert to Zod', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const input = 'Extract the name and age from: John Doe is 30 years old.';

    // Mock successful response from Anthropic
    mockAnthropic.messages.create.mockResolvedValue({
      content: [
        {
          type: 'text',
          text: '{"name": "John Doe", "age": 30}',
        },
      ],
    });

    // Convert JSON schema to Zod using the same function as the fixed code
    const schemaInZodObject = jsonSchemaToZod(jsonSchema);

    // This should work in the fixed code but fail in buggy code
    const response = await agent.generateObject(input, schemaInZodObject, {
      provider: 'anthropic',
    });

    expect(response).toEqual({
      name: 'John Doe',
      age: 30,
    });
  });

  test('should fail with JSON schema in buggy code', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const input = 'Extract the name and age from: John Doe is 30 years old.';

    // In buggy code, the API expects Zod schema directly, not JSON schema
    // The conversion will fail or produce incorrect results
    const schemaInZodObject = jsonSchemaToZod(jsonSchema);

    // Mock Anthropic to simulate the buggy behavior
    mockAnthropic.messages.create.mockRejectedValue(
      new Error('Failed to generate object')
    );

    await expect(
      agent.generateObject(input, schemaInZodObject, {
        provider: 'anthropic',
      })
    ).rejects.toThrow('Failed to generate object');
  });

  test('should include JSON schema in system prompt for Anthropic', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const input = 'Extract the name and age from: John Doe is 30 years old.';
    const schemaInZodObject = jsonSchemaToZod(jsonSchema);

    mockAnthropic.messages.create.mockResolvedValue({
      content: [
        {
          type: 'text',
          text: '{"name": "John Doe", "age": 30}',
        },
      ],
    });

    await agent.generateObject(input, schemaInZodObject, {
      provider: 'anthropic',
    });

    expect(mockAnthropic.messages.create).toHaveBeenCalled();
    const callArgs = mockAnthropic.messages.create.mock.calls[0][0];
    
    // In fixed code, system prompt should include JSON schema
    expect(callArgs.system).toContain('Response Schema:');
    expect(callArgs.system).toContain(JSON.stringify(jsonSchema));
  });

  test('should include JSON schema in system prompt for Groq', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const input = 'Extract the name and age from: John Doe is 30 years old.';
    const schemaInZodObject = jsonSchemaToZod(jsonSchema);

    mockGroq.chat.completions.create.mockResolvedValue({
      choices: [
        {
          message: {
            content: '{"name": "John Doe", "age": 30}',
          },
        },
      ],
    });

    await agent.generateObject(input, schemaInZodObject, {
      provider: 'groq',
    });

    expect(mockGroq.chat.completions.create).toHaveBeenCalled();
    const callArgs = mockGroq.chat.completions.create.mock.calls[0][0];
    
    // In fixed code, system prompt should include JSON schema
    expect(callArgs.messages[0].content).toContain('Schema:');
    expect(callArgs.messages[0].content).toContain(JSON.stringify(jsonSchema));
  });
});[0m
