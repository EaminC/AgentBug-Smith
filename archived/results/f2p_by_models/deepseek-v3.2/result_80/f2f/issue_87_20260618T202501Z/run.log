console.log("ANTHROPIC_BASE_URL:", process.env.ANTHROPIC_BASE_URL || "not set");\n\
console.log("ANTHROPIC_AUTH_TOKEN:", process.env.ANTHROPIC_AUTH_TOKEN ? "set (length: " + process.env.ANTHROPIC_AUTH_TOKEN.length + ")" : "not set");\n\
console.log("Environment check completed.");' > /test-env.ts

# Verify environment variables are accessible
RUN node -e "console.log('Node environment test:', process.env.OPENAI_BASE_URL ? 'OPENAI_BASE_URL is set' : 'OPENAI_BASE_URL not set')" && npx tsx /test-env.ts

# Add run-test to PATH
ENV PATH="/app:$PATH"

# Set default command
CMD ["/bin/bash"][0m
