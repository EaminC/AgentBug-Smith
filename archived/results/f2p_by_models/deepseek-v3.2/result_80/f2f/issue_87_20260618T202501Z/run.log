describe('JSON schema support for generateObject', () => {
  it('should accept JSON schema via REST API and convert to Zod for Anthropic', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // This simulates what the API route does: convert JSON schema to Zod
    const zodSchema = jsonSchemaToZod(jsonSchema);
    expect(zodSchema).toBeDefined();

    const agent = new Agent({
      provider: new AnthropicProvider({
        apiKey: 'test-key',
      }),
    });

    const result = await agent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      {
        userId: 'user-123',
        conversationId: 'your-unique-conversation-id',
      },
    );

    expect(result).toEqual({
      name: 'John Doe',
      age: 30,
    });
  });

  it('should accept JSON schema via REST API and convert to Zod for Groq', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const zodSchema = jsonSchemaToZod(jsonSchema);
    expect(zodSchema).toBeDefined();

    const agent = new Agent({
      provider: new GroqProvider({
        apiKey: 'test-key',
      }),
    });

    const result = await agent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      {
        userId: 'user-123',
        conversationId: 'your-unique-conversation-id',
      },
    );

    expect(result).toEqual({
      name: 'John Doe',
      age: 30,
    });
  });

  it('should fail when JSON schema is not properly converted in buggy code', async () => {
    // In buggy code, the API route doesn't convert JSON schema to Zod
    // This test simulates the bug by trying to pass raw JSON schema directly
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const agent = new Agent({
      provider: new AnthropicProvider({
        apiKey: 'test-key',
      }),
    });

    // In buggy code, this would fail because generateObject expects a Zod schema
    // but the API route passes raw JSON schema
    let error: any;
    try {
      // Simulate bug: pass JSON schema directly without conversion
      await agent.generateObject(
        'Extract the name and age from: John Doe is 30 years old.',
        jsonSchema as any, // This is the bug: passing JSON instead of Zod
        {
          userId: 'user-123',
          conversationId: 'your-unique-conversation-id',
        },
      );
    } catch (e) {
      error = e;
    }

    // In buggy code, this should throw an error
    // In fixed code, jsonSchemaToZod converts it properly
    expect(error).toBeDefined();
  });

  it('should include JSON schema in system message for Anthropic', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const zodSchema = jsonSchemaToZod(jsonSchema);
    const agent = new Agent({
      provider: new AnthropicProvider({
        apiKey: 'test-key',
      }),
    });

    await agent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      {
        userId: 'user-123',
        conversationId: 'your-unique-conversation-id',
      },
    );

    // Verify the system prompt includes the JSON schema
    const anthropic = agent['provider']['anthropic'];
    const createCall = anthropic.messages.create.mock.calls[0];
    const systemPrompt = createCall[0].system;
    expect(systemPrompt).toContain(JSON.stringify(jsonSchema));
  });

  it('should include JSON schema in system message for Groq', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const zodSchema = jsonSchemaToZod(jsonSchema);
    const agent = new Agent({
      provider: new GroqProvider({
        apiKey: 'test-key',
      }),
    });

    await agent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      {
        userId: 'user-123',
        conversationId: 'your-unique-conversation-id',
      },
    );

    // Verify the system prompt includes the JSON schema
    const groq = agent['provider']['groq'];
    const createCall = groq.chat.completions.create.mock.calls[0];
    const messages = createCall[0].messages;
    const systemMessage = messages.find((m: any) => m.role === 'system');
    expect(systemMessage.content).toContain(JSON.stringify(jsonSchema));
  });
});[0m
