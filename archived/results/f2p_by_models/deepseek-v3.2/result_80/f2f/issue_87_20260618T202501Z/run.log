[32mimport { describe, it, expect, jest, beforeEach } from '@jest/globals';
import { Agent } from '@voltagent/core';
import { AnthropicProvider } from '@voltagent/anthropic-ai';
import { GroqProvider } from '@voltagent/groq-ai';
import { z } from 'zod';
import { jsonSchemaToZod } from '@n8n/json-schema-to-zod';

describe('JSON schema support for generateObject and streamObject', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('should accept JSON schema via REST API and convert to Zod for generateObject', async () => {
    // Mock the internal network calls for both providers
    const mockAnthropicCreate = jest.fn().mockResolvedValue({
      content: [{ type: 'text', text: '{"name": "John Doe", "age": 30}' }],
      usage: { input_tokens: 10, output_tokens: 20 },
    });
    const mockGroqCreate = jest.fn().mockResolvedValue({
      choices: [{ message: { content: '{"name": "John Doe", "age": 30}' } }],
      usage: { prompt_tokens: 10, completion_tokens: 20 },
    });

    // Create providers with mocked clients
    const anthropicProvider = new AnthropicProvider({ apiKey: 'test-key' });
    const groqProvider = new GroqProvider({ apiKey: 'test-key' });

    // Replace the internal client methods with mocks
    (anthropicProvider as any).anthropic = { messages: { create: mockAnthropicCreate } };
    (groqProvider as any).groq = { chat: { completions: { create: mockGroqCreate } } };

    // Test JSON schema (as would be sent via REST API)
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // Convert JSON schema to Zod (as the fixed code does)
    const zodSchema = jsonSchemaToZod(jsonSchema);
    expect(zodSchema).toBeDefined();

    // Create agents with mocked providers
    const anthropicAgent = new Agent({
      provider: anthropicProvider,
      model: 'claude-3-5-sonnet-20241022',
    });

    const groqAgent = new Agent({
      provider: groqProvider,
      model: 'mixtral-8x7b-32768',
    });

    // Test generateObject with both providers
    const input = 'Extract the name and age from: John Doe is 30 years old.';

    // This should work in the fixed code but fail in buggy code
    const anthropicResult = await anthropicAgent.generateObject(input, zodSchema);
    expect(anthropicResult).toEqual({ name: 'John Doe', age: 30 });

    const groqResult = await groqAgent.generateObject(input, zodSchema);
    expect(groqResult).toEqual({ name: 'John Doe', age: 30 });

    // Verify the system prompt includes the JSON schema in the fixed code
    expect(mockAnthropicCreate).toHaveBeenCalledWith(
      expect.objectContaining({
        system: expect.stringContaining(JSON.stringify(jsonSchema)),
      }),
      expect.anything(),
    );

    expect(mockGroqCreate).toHaveBeenCalledWith(
      expect.objectContaining({
        messages: expect.arrayContaining([
          expect.objectContaining({
            content: expect.stringContaining(JSON.stringify(jsonSchema)),
          }),
        ]),
      }),
      expect.anything(),
    );
  });

