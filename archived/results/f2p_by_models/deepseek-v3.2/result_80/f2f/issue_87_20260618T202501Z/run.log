[32m# branch: TypeScript/pnpm-monorepo - Forge API configuration
FROM node:20-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install pnpm globally
RUN npm install -g pnpm@8.10.5

# Set up pnpm for global installs
ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN mkdir -p /root/.local/share/pnpm

# Ensure node_modules/.bin is in PATH for local binaries like lerna
ENV PATH="/app/node_modules/.bin:$PATH"

# Copy entire repository
COPY . .

# Install dependencies using pnpm
RUN pnpm install --frozen-lockfile

# Build all packages
RUN pnpm run build

# Install tsx globally for running TypeScript files
RUN pnpm add -g tsx

# Create improved test runner script that uses pnpm correctly
RUN echo '#!/bin/bash\n\
# Test runner script for VoltAgent monorepo\n\
# Usage: /run-test.sh <test-file-path>\n\
echo "VoltAgent test runner using pnpm"\n\
echo "Using pnpm version: $(pnpm --version)"\n\
echo "Using node version: $(node --version)"\n\
\n\
if [ -z "$1" ]; then\n\
  echo "No test specified. Running all tests with: pnpm test"\n\
  pnpm test\n\
  exit $?\n\
fi\n\
\n\
test_file="$1"\n\
echo "Running test: $test_file"\n\
\n\
# Check if test file exists\n\
if [ ! -f "$test_file" ]; then\n\
  echo "Error: Test file not found: $test_file"\n\
  exit 1\n\
fi\n\
\n\
# Extract package directory from test path\n\
if [[ "$test_file" == packages/* ]]; then\n\
  package_dir=$(echo "$test_file" | cut -d"/" -f1-2)\n\
  rel_test_file=$(echo "$test_file" | cut -d"/" -f3-)\n\
  echo "Changing to package directory: $package_dir"\n\
  cd "$package_dir"\n\
  echo "Running: pnpm test -- --testPathPattern=\"$rel_test_file\"\n\
  pnpm test -- --testPathPattern="$rel_test_file"\n\
  test_exit=$?\n\
  cd /app\n\
  exit $test_exit\n\
elif [[ "$test_file" == examples/* ]]; then\n\
  # Handle example packages\n\
  example_dir=$(echo "$test_file" | cut -d"/" -f1-2)\n\
  rel_test_file=$(echo "$test_file" | cut -d"/" -f3-)\n\
  echo "Changing to example directory: $example_dir"\n\
  cd "$example_dir"\n\
  if [ -f "package.json" ]; then\n\
    echo "Running: npm test -- --testPathPattern=\"$rel_test_file\"\n\
    npm test -- --testPathPattern="$rel_test_file"\n\
    test_exit=$?\n\
  else\n\
    echo "Error: No package.json found in $example_dir"\n\
    test_exit=1\n\
  fi\n\
  cd /app\n\
  exit $test_exit\n\
else\n\
  echo "Running test from root with pnpm test: $test_file"\n\
  # Use pnpm test with test pattern\n\
  pnpm test -- --testPathPattern="$test_file"\n\
  exit $?\n\
fi' > /run-test.sh && chmod +x /run-test.sh

# Create a simple test script to verify environment variables are set
RUN echo 'console.log("Environment variables check:");\n\
console.log("OPENAI_BASE_URL:", process.env.OPENAI_BASE_URL || "not set");\n\
console.log("OPENAI_API_KEY:", process.env.OPENAI_API_KEY ? "set (length: " + process.env.OPENAI_API_KEY.length + ")" : "not set");\n\
console.log("ANTHROPIC_BASE_URL:", process.env.ANTHROPIC_BASE_URL || "not set");\n\
console.log("ANTHROPIC_AUTH_TOKEN:", process.env.ANTHROPIC_AUTH_TOKEN ? "set (length: " + process.env.ANTHROPIC_AUTH_TOKEN.length + ")" : "not set");\n\
console.log("Environment check completed.");' > /test-env.ts

# Verify environment variables are accessible
RUN node -e "console.log('Node environment test:', process.env.OPENAI_BASE_URL ? 'OPENAI_BASE_URL is set' : 'OPENAI_BASE_URL not set')" && tsx /test-env.ts

# Set default command
CMD ["/bin/bash"][0m
