[32m# branch: TypeScript/pnpm-monorepo - Forge API configuration
FROM node:20-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    make \
    g++ \
    git \
    curl \
    wget \
    libssl-dev \
    pkg-config \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm globally
RUN npm install -g pnpm@8.10.5

# Set up pnpm environment
ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH="$PNPM_HOME:$PATH"

# Copy entire repository
COPY . .

# Install root dependencies
RUN pnpm install --frozen-lockfile

# Build all packages
RUN pnpm run build:all

# Install TypeScript and ts-node globally for test execution
RUN npm install -g typescript@5.3.2 ts-node@10.9.2

# Install @types/node globally for TypeScript compilation
RUN npm install -g @types/node@18.15.11

# Install jest globally for test execution
RUN npm install -g jest@29.7.0 ts-jest@29.1.2 @jest/globals@29.7.0

# Set up environment for tests
ENV PATH="/app/node_modules/.bin:$PATH"
ENV NODE_ENV="test"
ENV CI="true"

# Create a simple test runner script
RUN printf '#!/bin/sh\n# Simple test runner that handles the test harness command format\n# When called as "npm test -- packages/anthropic-ai/src/index.spec.ts"\n# we need to extract the test file and run jest directly\n\n# Extract test file from arguments\nTEST_FILE=""\nfor arg in "$@"; do\n    if echo "$arg" | grep -q "\\.spec\\.ts$" || echo "$arg" | grep -q "\\.test\\.ts$"; then\n        TEST_FILE="$arg"\n        break\n    fi\ndone\n\nif [ -n "$TEST_FILE" ]; then\n    # Get the package directory (second component of path)\n    PKG_DIR=$(echo "$TEST_FILE" | cut -d/ -f2)\n    # Get the relative path within the package\n    REL_PATH=$(echo "$TEST_FILE" | cut -d/ -f3-)\n    \n    echo "Running test: $TEST_FILE"\n    echo "Package directory: $PKG_DIR"\n    echo "Relative path: $REL_PATH"\n    \n    # Change to the package directory and run jest\n    cd "/app/packages/$PKG_DIR" && \\\n    npx jest "$REL_PATH" --passWithNoTests\n    exit $?\nelse\n    # No specific test file, run all tests\n    echo "Running all tests with lerna..."\n    cd /app && npx lerna run test --stream\n    exit $?\nfi\n' > /app/run-test.sh && chmod +x /app/run-test.sh

# Override the npm test command in package.json to use our runner
RUN cp /app/package.json /app/package.json.bak && \
    jq '.scripts.test = "/app/run-test.sh"' /app/package.json > /app/package.json.tmp && \
    mv /app/package.json.tmp /app/package.json

# Create a direct test command for the test harness
RUN printf '#!/bin/sh\n# Direct test command for test harness\n/app/run-test.sh "$@"\n' > /usr/local/bin/test-command && chmod +x /usr/local/bin/test-command

# Verify setup
RUN echo "=== Environment Verification ===" && \
    echo "OPENAI_BASE_URL: $OPENAI_BASE_URL" && \
    echo "ANTHROPIC_AUTH_TOKEN: ${ANTHROPIC_AUTH_TOKEN:+Set}" && \
    echo "NODE_ENV: $NODE_ENV" && \
    echo "PNPM version:" && pnpm --version && \
    echo "Node version:" && node --version && \
    echo "TypeScript version:" && tsc --version && \
    echo "ts-node version:" && ts-node --version && \
    echo "Jest version:" && jest --version

# Verify builds
RUN echo "=== Build Verification ===" && \
    echo "Core package:" && ls -la packages/core/dist/ 2>/dev/null | head -5 || echo "Core dist not found" && \
    echo "Anthropic package:" && ls -la packages/anthropic-ai/dist/ 2>/dev/null | head -5 || echo "Anthropic dist not found"

# Test that jest can run
RUN echo "=== Jest Test ===" && \
    cd /app/packages/anthropic-ai && \
    npx jest --listTests 2>&1 | head -10 || echo "Jest listTests completed"

# Set default command
CMD ["/bin/bash"][0m
