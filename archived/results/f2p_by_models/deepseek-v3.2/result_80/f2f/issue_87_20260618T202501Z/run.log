import { jsonSchemaToZod } from '@n8n/json-schema-to-zod';

describe('Issue #87: JSON schema handling in REST API', () => {
  // Mock the internal network clients to avoid real API calls
  const mockAnthropic = {
    messages: {
      create: jest.fn(),
    },
  };

  const mockGroq = {
    chat: {
      completions: {
        create: jest.fn(),
      },
    },
  };

  beforeEach(() => {
    jest.clearAllMocks();
  });

  test('Agent.generateObject should accept JSON schema via REST API', async () => {
    // Create a JSON schema as would be sent via REST API
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // Convert JSON schema to Zod schema (this is what the fixed code does)
    const zodSchema = jsonSchemaToZod(jsonSchema);

    // Create an agent with mocked providers
    const agent = new Agent({
      provider: new AnthropicProvider({
        apiKey: 'test-key',
        anthropic: mockAnthropic as any,
      }),
    });

    // Mock the Anthropic response to simulate successful object generation
    const mockResponse = {
      content: [
        {
          type: 'text',
          text: '{"name": "John Doe", "age": 30}',
        },
      ],
    };

    mockAnthropic.messages.create.mockResolvedValue(mockResponse);

    // Call generateObject with the Zod schema (as the fixed code would after conversion)
    const result = await agent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      {}
    );

    // Verify the result matches the schema
    expect(result).toEqual({ name: 'John Doe', age: 30 });
    expect(mockAnthropic.messages.create).toHaveBeenCalledTimes(1);
  });

  test('Agent.generateObject should fail with JSON schema in buggy code', async () => {
    // In the buggy code, the API expects a Zod schema but receives JSON schema
    // This test should fail on buggy code because jsonSchemaToZod is not imported/used
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // Create an agent with mocked providers
    const agent = new Agent({
      provider: new GroqProvider({
        apiKey: 'test-key',
        groq: mockGroq as any,
      }),
    });

    // Mock the Groq response
    const mockResponse = {
      choices: [
        {
          message: {
            content: '{"name": "John Doe", "age": 30}',
          },
        },
      ],
    };

    mockGroq.chat.completions.create.mockResolvedValue(mockResponse);

    // In buggy code, passing JSON schema directly would fail
    // We expect this to throw or return an error
    await expect(
      agent.generateObject(
        'Extract the name and age from: John Doe is 30 years old.',
        jsonSchema as any, // Cast as any to simulate buggy behavior
        {}
      )
    ).rejects.toThrow();
  });

  test('Agent.streamObject should accept JSON schema via REST API after fix', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const zodSchema = jsonSchemaToZod(jsonSchema);

    const agent = new Agent({
      provider: new GroqProvider({
        apiKey: 'test-key',
        groq: mockGroq as any,
      }),
    });

    // Mock streaming response
    const mockStream = {
      objectStream: {
        getReader: jest.fn().mockReturnValue({
          read: jest.fn().mockResolvedValue({
            done: true,
            value: { name: 'John Doe', age: 30 },
          }),
        }),
      },
    };

    // Mock the streamObject method to return our mock stream
    jest.spyOn(agent, 'streamObject').mockResolvedValue(mockStream as any);

    const stream = await agent.streamObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      {}
    );

    const reader = stream.objectStream.getReader();
    const result = await reader.read();

    expect(result.value).toEqual({ name: 'John Doe', age: 30 });
  });

  test('AnthropicProvider.generateObject should include JSON schema in system prompt after fix', async () => {
    const provider = new AnthropicProvider({
      apiKey: 'test-key',
      anthropic: mockAnthropic as any,
    });

    const zodSchema = z.object({
      name: z.string(),
      age: z.number(),
    });

    const mockResponse = {
      content: [
        {
          type: 'text',
          text: '{"name": "John Doe", "age": 30}',
        },
      ],
    };

    mockAnthropic.messages.create.mockResolvedValue(mockResponse);

    await provider.generateObject({
      messages: [{ role: 'user', content: 'Extract name and age' }],
      schema: zodSchema,
      provider: {},
    });

    const callArgs = mockAnthropic.messages.create.mock.calls[0][0];
    expect(callArgs.system).toContain('Response Schema:');
    expect(callArgs.system).toContain('"type":"object"');
  });

  test('GroqProvider.generateObject should include JSON schema in system prompt after fix', async () => {
    const provider = new GroqProvider({
      apiKey: 'test-key',
      groq: mockGroq as any,
    });

    const zodSchema = z.object({
      name: z.string(),
      age: z.number(),
    });

    const mockResponse = {
      choices: [
        {
          message: {
            content: '{"name": "John Doe", "age": 30}',
          },
        },
      ],
    };

    mockGroq.chat.completions.create.mockResolvedValue(mockResponse);

    await provider.generateObject({
      messages: [{ role: 'user', content: 'Extract name and age' }],
      schema: zodSchema,
      provider: {},
    });

    const callArgs = mockGroq.chat.completions.create.mock.calls[0][0];
    expect(callArgs.messages[0].content).toContain('Schema:');
    expect(callArgs.messages[0].content).toContain('"type":"object"');
  });
});[0m
