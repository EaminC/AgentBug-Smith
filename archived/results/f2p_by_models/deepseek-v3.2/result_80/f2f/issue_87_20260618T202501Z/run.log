  it('should fail with JSON schema in buggy code (before fix)', async () => {
    // Create agent with a mocked provider (Anthropic)
    const provider = new AnthropicProvider({ apiKey: 'dummy' });
    agent = new Agent({ provider });

    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // In buggy code, agent.generateObject expects Zod schema, but we pass JSON
    // This should throw "Failed to generate object"
    await expect(
      agent.generateObject('Extract the name and age from: John Doe is 30 years old.', jsonSchema as any)
    ).rejects.toThrow('Failed to generate object');
  });

  it('should pass with JSON schema after fix (converted to Zod)', async () => {
    // After fix, the API internally converts JSON schema to Zod using jsonSchemaToZod
    // We'll simulate the fixed behavior by mocking jsonSchemaToZod to return a Zod schema
    const mockJsonSchemaToZod = jest.fn().mockReturnValue(z.object({
      name: z.string(),
      age: z.number(),
    }));
    (jsonSchemaToZod as jest.Mock) = mockJsonSchemaToZod;

    const provider = new AnthropicProvider({ apiKey: 'dummy' });
    agent = new Agent({ provider });

    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // After fix, generateObject should work because jsonSchemaToZod converts it
    const result = await agent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      jsonSchema as any
    );
    expect(result.object).toEqual({ name: 'John Doe', age: 30 });
    expect(mockJsonSchemaToZod).toHaveBeenCalledWith(jsonSchema);
  });

  it('should fail with JSON schema in buggy code for streamObject', async () => {
    const provider = new GroqProvider({ apiKey: 'dummy' });
    agent = new Agent({ provider });

    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // In buggy code, streamObject also expects Zod schema
    await expect(
      agent.streamObject('Extract the name and age from: John Doe is 30 years old.', jsonSchema as any)
    ).rejects.toThrow('Failed to generate object');
  });

  it('should pass with JSON schema after fix for streamObject', async () => {
    const mockJsonSchemaToZod = jest.fn().mockReturnValue(z.object({
      name: z.string(),
      age: z.number(),
    }));
    (jsonSchemaToZod as jest.Mock) = mockJsonSchemaToZod;

    const provider = new GroqProvider({ apiKey: 'dummy' });
    agent = new Agent({ provider });

    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const stream = await agent.streamObject(
      'Extract the name and age from: John Doe is 30 years old.',
      jsonSchema as any
    );
    const reader = stream.objectStream.getReader();
    const { value } = await reader.read();
    expect(value).toEqual({ name: 'John Doe', age: 30 });
    expect(mockJsonSchemaToZod).toHaveBeenCalledWith(jsonSchema);
  });
});[0m
