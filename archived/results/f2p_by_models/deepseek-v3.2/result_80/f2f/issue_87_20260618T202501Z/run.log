// Mock the internal network clients to avoid real API calls
const mockAnthropicCreate = jest.fn();
const mockGroqCreate = jest.fn();

jest.mock('@voltagent/anthropic-ai', () => {
  const actual = jest.requireActual('@voltagent/anthropic-ai');
  return {
    ...actual,
    AnthropicProvider: jest.fn().mockImplementation(() => ({
      generateObject: jest.fn().mockImplementation(async (options) => {
        // Simulate the buggy behavior: if schema is JSON (not Zod), it fails
        // In buggy code, options.schema is expected to be Zod, but API passes JSON
        // This will throw because zodToJsonSchema expects Zod schema
        const { schema } = options;
        // In buggy code, schema is JSON object, not Zod -> zodToJsonSchema will throw
        // We'll simulate that by checking if schema has a _type property (Zod) or not
        if (schema && typeof schema === 'object' && !schema._type) {
          // This is JSON schema, buggy code will fail
          throw new Error('Failed to generate object');
        }
        // If schema is Zod, proceed (but we mock the actual call)
        return { object: { name: 'John Doe', age: 30 } };
      }),
      streamObject: jest.fn().mockImplementation(async (options) => {
        const { schema } = options;
        if (schema && typeof schema === 'object' && !schema._type) {
          throw new Error('Failed to generate object');
        }
        return {
          objectStream: {
            getReader: () => ({
              read: () => Promise.resolve({ done: true, value: { name: 'John Doe', age: 30 } }),
            }),
          },
        };
      }),
    })),
  };
});

