echo "Running test: $test_file"\n\
\n\
# Extract package directory from test path\n\
if [[ "$test_file" == packages/* ]]; then\n\
  package_dir=$(echo "$test_file" | cut -d"/" -f1-2)\n\
  rel_test_file=$(echo "$test_file" | cut -d"/" -f3-)\n\
  echo "Changing to package directory: $package_dir"\n\
  cd "$package_dir"\n\
  echo "Running: pnpm test -- --testPathPattern=\"$rel_test_file\"\n\
  pnpm test -- --testPathPattern="$rel_test_file"\n\
else\n\
  echo "Running: pnpm test -- --testPathPattern=\"$test_file\"\n\
  pnpm test -- --testPathPattern="$test_file"\n\
fi\n\
\n\
exit_code=$?\n\
echo "Test completed with exit code: $exit_code"\n\
