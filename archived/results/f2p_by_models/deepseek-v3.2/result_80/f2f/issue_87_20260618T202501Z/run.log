[32mimport { describe, it, expect, jest } from '@jest/globals';
import { Agent } from '@voltagent/core';
import { AnthropicProvider } from '@voltagent/anthropic-ai';
import { GroqProvider } from '@voltagent/groq-ai';
import { z } from 'zod';
import { jsonSchemaToZod } from '@n8n/json-schema-to-zod';

describe('Issue #87: JSON/Zod schema handling in REST API', () => {
  // Mock the internal network clients to avoid real API calls
  const mockAnthropic = {
    messages: {
      create: jest.fn(),
    },
  };

  const mockGroq = {
    chat: {
      completions: {
        create: jest.fn(),
      },
    },
  };

  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('should accept JSON schema via REST API and convert to Zod for generateObject', async () => {
    // Simulate the buggy state: the API expects a Zod schema but receives JSON schema
    // In the buggy code, the API route passes the raw JSON schema to agent.generateObject
    // which expects a Zod schema, causing a failure.
    // After the fix, the API route converts JSON schema to Zod using jsonSchemaToZod.

    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // In the buggy code, the conversion function might not be imported or used.
    // We'll test the behavior by checking if the conversion is attempted.
    // We'll mock the conversion to simulate the fixed behavior.
    const mockZodSchema = z.object({
      name: z.string(),
      age: z.number(),
    });

    // Mock the conversion function to return a Zod schema
    // In the buggy code, this import might fail or not be used.
    // We'll simulate the bug by not mocking it, causing an error.
    // But for the test to run, we need to mock it conditionally.
    // However, we cannot conditionally mock because the test must run in both states.
    // Instead, we'll rely on the actual implementation and let the test fail in buggy state.
    // We'll call the conversion function directly and see if it works.

    // This test will fail in buggy state because jsonSchemaToZod might not be imported
    // or the API route doesn't use it, causing a runtime error.
    // In fixed state, the conversion succeeds and the agent receives a Zod schema.

    // We'll create a minimal agent with a mocked provider to avoid real API calls.
    const provider = new AnthropicProvider({ apiKey: 'test' });
    // Replace the internal client with our mock
    (provider as any).anthropic = mockAnthropic;

    const agent = new Agent({
      provider,
    });

    // Mock the provider's generateObject to return a dummy response
    mockAnthropic.messages.create.mockResolvedValue({
      content: [{ type: 'text', text: '{"name":"John Doe","age":30}' }],
    });

    // In the buggy code, passing jsonSchema directly to agent.generateObject would fail
    // because it expects a Zod schema. The fix converts jsonSchema to Zod.
    // We'll simulate the fixed behavior by converting it ourselves.
    let zodSchema;
    try {
      zodSchema = jsonSchemaToZod(jsonSchema);
    } catch (error) {
      // In buggy state, jsonSchemaToZod might not be available or throw.
      // We'll let the test fail by not catching the error.
      throw error;
    }

    // Now call generateObject with the Zod schema (as the fixed API would)
    const result = await agent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      { userId: 'user-123', conversationId: 'your-unique-conversation-id' }
    );

    // Verify the result
    expect(result).toEqual({ name: 'John Doe', age: 30 });
    // Verify the provider was called with a system prompt that includes the schema
    expect(mockAnthropic.messages.create).toHaveBeenCalledWith(
      expect.objectContaining({
        system: expect.stringContaining(JSON.stringify(jsonSchema)),
      })
    );
  });

  it('should accept JSON schema via REST API and convert to Zod for streamObject', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        city: { type: 'string' },
        population: { type: 'number' },
      },
      required: ['city', 'population'],
    };

    const provider = new GroqProvider({ apiKey: 'test' });
    (provider as any).groq = mockGroq;

    const agent = new Agent({
      provider,
    });

    // Mock a streaming response
    const mockStream = {
      [Symbol.asyncIterator]: async function* () {
        yield {
          choices: [
            {
              delta: {
                content: '{"city":"New York","population":8419600}',
              },
            },
          ],
        };
      },
    };
    mockGroq.chat.completions.create.mockResolvedValue(mockStream);

    let zodSchema;
    try {
      zodSchema = jsonSchemaToZod(jsonSchema);
    } catch (error) {
      throw error;
    }

    const stream = await agent.streamObject(
      'Extract the city and population from: New York has 8,419,600 people.',
      zodSchema,
      { userId: 'user-456', conversationId: 'another-conversation-id' }
    );

    // Collect the streamed object
    const reader = stream.objectStream.getReader();
    const chunks = [];
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      chunks.push(value);
    }

    // The stream should yield the parsed object
    expect(chunks).toEqual([{ city: 'New York', population: 8419600 }]);
    // Verify the provider was called with a system prompt that includes the schema
    expect(mockGroq.chat.completions.create).toHaveBeenCalledWith(
      expect.objectContaining({
        messages: expect.arrayContaining([
          expect.objectContaining({
            content: expect.stringContaining(JSON.stringify(jsonSchema)),
          }),
        ]),
      })
    );
  });

  it('should fail in buggy state when JSON schema is passed directly without conversion', async () => {
    // This test simulates the bug: the API route passes raw JSON schema to agent.generateObject.
    // In the buggy code, this will cause a runtime error because the agent expects a Zod schema.
    // We'll test by calling the agent's generateObject with a JSON schema (not Zod).
    // In the buggy state, this should throw an error.
    // In the fixed state, the conversion happens before calling generateObject, so this test
    // is not representative of the API route, but we can still test the agent's behavior.

    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const provider = new AnthropicProvider({ apiKey: 'test' });
    (provider as any).anthropic = mockAnthropic;

    const agent = new Agent({
      provider,
    });

    // In the buggy state, the agent's generateObject expects a Zod schema.
    // Passing a plain object will cause a Zod validation error or internal failure.
    // We'll expect this to throw.
    await expect(
      agent.generateObject(
        'Extract the name and age from: John Doe is 30 years old.',
        jsonSchema as any, // Force passing JSON schema as if from buggy API
        { userId: 'user-123', conversationId: 'your-unique-conversation-id' }
      )
    ).rejects.toThrow();
  });
});[0m
