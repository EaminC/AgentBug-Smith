[32mimport { describe, it, expect, beforeEach, jest } from '@jest/globals';
import { Agent } from '@voltagent/core';
import { AnthropicProvider } from '@voltagent/anthropic-ai';
import { GroqProvider } from '@voltagent/groq-ai';
import { z } from 'zod';
import { jsonSchemaToZod } from '@n8n/json-schema-to-zod';

// Mock the external API calls to return a valid dummy response
const mockAnthropicResponse = {
  id: 'msg_123',
  type: 'message',
  role: 'assistant',
  content: [
    {
      type: 'text',
      text: '{"name": "John Doe", "age": 30}',
    },
  ],
  model: 'claude-3-5-sonnet-20241022',
  stop_reason: 'end_turn',
  usage: { input_tokens: 10, output_tokens: 20 },
};

const mockGroqResponse = {
  id: 'chatcmpl-123',
  object: 'chat.completion',
  created: 1234567890,
  model: 'mixtral-8x7b-32768',
  choices: [
    {
      index: 0,
      message: {
        role: 'assistant',
        content: '{"name": "John Doe", "age": 30}',
      },
      finish_reason: 'stop',
    },
  ],
  usage: { prompt_tokens: 10, completion_tokens: 20, total_tokens: 30 },
};

describe('JSON schema support for generateObject', () => {
  let agent: Agent;

  beforeEach(() => {
    // Reset mocks
    jest.clearAllMocks();
  });

  it('should handle JSON schema via REST API with Anthropic provider', async () => {
    // Create a mock Anthropic client
    const mockAnthropicClient = {
      messages: {
        create: jest.fn().mockResolvedValue(mockAnthropicResponse),
      },
    };

    // Create provider with mocked client
    const provider = new AnthropicProvider({
      apiKey: 'test-key',
      model: 'claude-3-5-sonnet-20241022',
    });

    // Replace the internal client with our mock
    (provider as any).anthropic = mockAnthropicClient;

    // Create agent with the provider
    agent = new Agent({
      provider,
    });

    // Define JSON schema (as would come from REST API)
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // Convert JSON schema to Zod (as the fixed code does)
    const zodSchema = jsonSchemaToZod(jsonSchema);

    // Test generateObject with the schema
    const result = await agent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      { userId: 'user-123', conversationId: 'conv-123' }
    );

    // Verify the result
    expect(result).toEqual({
      name: 'John Doe',
      age: 30,
    });

    // Verify the mock was called with correct parameters
    expect(mockAnthropicClient.messages.create).toHaveBeenCalledWith(
      expect.objectContaining({
        model: 'claude-3-5-sonnet-20241022',
        max_tokens: 1024,
        temperature: 0.2,
        system: expect.stringContaining('Response Schema:'),
      })
    );
  });

  it('should handle JSON schema via REST API with Groq provider', async () => {
    // Create a mock Groq client
    const mockGroqClient = {
      chat: {
        completions: {
          create: jest.fn().mockResolvedValue(mockGroqResponse),
        },
      },
    };

    // Create provider with mocked client
    const provider = new GroqProvider({
      apiKey: 'test-key',
      model: 'mixtral-8x7b-32768',
    });

    // Replace the internal client with our mock
    (provider as any).groq = mockGroqClient;

    // Create agent with the provider
    agent = new Agent({
      provider,
    });

    // Define JSON schema (as would come from REST API)
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // Convert JSON schema to Zod (as the fixed code does)
    const zodSchema = jsonSchemaToZod(jsonSchema);

    // Test generateObject with the schema
    const result = await agent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      { userId: 'user-123', conversationId: 'conv-123' }
    );

    // Verify the result
    expect(result).toEqual({
      name: 'John Doe',
      age: 30,
    });

    // Verify the mock was called with correct parameters
    expect(mockGroqClient.chat.completions.create).toHaveBeenCalledWith(
      expect.objectContaining({
        model: 'mixtral-8x7b-32768',
        max_tokens: 1024,
        temperature: 0.2,
        messages: expect.arrayContaining([
          expect.objectContaining({
            role: 'system',
            content: expect.stringContaining('Schema:'),
          }),
        ]),
      })
    );
  });

  it('should fail with buggy code when JSON schema is passed directly without conversion', async () => {
    // This test should fail on buggy code because the API expects Zod schema
    // but receives JSON schema directly
    
    // Create a simple mock provider that will throw error with buggy code
    const mockProvider = {
      generateObject: jest.fn().mockRejectedValue(new Error('Schema must be a Zod schema')),
    };

    agent = new Agent({
      provider: mockProvider as any,
    });

    // Define JSON schema (as would come from REST API)
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // Try to call generateObject with JSON schema directly (buggy behavior)
    await expect(
      agent.generateObject(
        'Extract the name and age from: John Doe is 30 years old.',
        jsonSchema as any, // This should fail in buggy code
        { userId: 'user-123', conversationId: 'conv-123' }
      )
    ).rejects.toThrow('Schema must be a Zod schema');
  });
});[0m
