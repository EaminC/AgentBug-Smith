[32mimport { describe, expect, test, jest } from '@jest/globals';
import { Agent } from '@voltagent/core';
import { AnthropicProvider } from '@voltagent/anthropic-ai';
import { GroqProvider } from '@voltagent/groq-ai';
import { z } from 'zod';
import { jsonSchemaToZod } from '@n8n/json-schema-to-zod';

describe('JSON schema support for generateObject and streamObject', () => {
  test('should accept JSON schema via REST API and convert to Zod', async () => {
    // Mock the internal network calls to avoid requiring actual API keys
    const mockAnthropicCreate = jest.fn();
    const mockGroqCreate = jest.fn();

    // Setup mock responses that simulate valid JSON output
    const mockAnthropicResponse = {
      content: [
        {
          type: 'text',
          text: '{"name":"John Doe","age":30}',
        },
      ],
    };
    const mockGroqResponse = {
      choices: [
        {
          message: {
            content: '{"name":"John Doe","age":30}',
          },
        },
      ],
    };

    // Create mock providers
    const anthropicProvider = new AnthropicProvider({ apiKey: 'test-key' });
    const groqProvider = new GroqProvider({ apiKey: 'test-key' });

    // Replace the internal client methods with mocks
    // @ts-ignore - accessing private property for mocking
    anthropicProvider.anthropic = { messages: { create: mockAnthropicCreate } };
    // @ts-ignore - accessing private property for mocking
    groqProvider.groq = { chat: { completions: { create: mockGroqCreate } } };

    mockAnthropicCreate.mockResolvedValue(mockAnthropicResponse);
    mockGroqCreate.mockResolvedValue(mockGroqResponse);

    // Create agents with mocked providers
    const anthropicAgent = new Agent({
      provider: anthropicProvider,
      model: 'claude-3-5-sonnet-20241022',
    });

    const groqAgent = new Agent({
      provider: groqProvider,
      model: 'mixtral-8x7b-32768',
    });

    // JSON schema as would be sent via REST API
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    // Convert JSON schema to Zod (as the fixed code does)
    const zodSchema = jsonSchemaToZod(jsonSchema);

    // Test with Anthropic provider
    const anthropicResult = await anthropicAgent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      { userId: 'test-user' }
    );

    expect(anthropicResult).toEqual({
      name: 'John Doe',
      age: 30,
    });

    // Verify the mock was called with the schema in the system prompt
    expect(mockAnthropicCreate).toHaveBeenCalled();
    const anthropicCall = mockAnthropicCreate.mock.calls[0][0];
    expect(anthropicCall.system).toContain('Response Schema:');
    expect(anthropicCall.system).toContain(JSON.stringify(jsonSchema));

    // Test with Groq provider
    const groqResult = await groqAgent.generateObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      { userId: 'test-user' }
    );

    expect(groqResult).toEqual({
      name: 'John Doe',
      age: 30,
    });

    // Verify the mock was called with the schema in the system prompt
    expect(mockGroqCreate).toHaveBeenCalled();
    const groqCall = mockGroqCreate.mock.calls[0][0];
    expect(groqCall.messages[0].content).toContain('Schema:');
    expect(groqCall.messages[0].content).toContain(JSON.stringify(jsonSchema));
  });

  test('should handle streamObject with JSON schema', async () => {
    // Mock streaming response
    const mockStream = {
      objectStream: {
        getReader: () => ({
          read: async () => ({
            done: true,
            value: { name: 'John Doe', age: 30 },
          }),
        }),
      },
    };

    const mockAnthropicCreate = jest.fn().mockResolvedValue(mockStream);
    const anthropicProvider = new AnthropicProvider({ apiKey: 'test-key' });
    // @ts-ignore - accessing private property for mocking
    anthropicProvider.anthropic = { messages: { create: mockAnthropicCreate } };

    const anthropicAgent = new Agent({
      provider: anthropicProvider,
      model: 'claude-3-5-sonnet-20241022',
    });

    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const zodSchema = jsonSchemaToZod(jsonSchema);

    const stream = await anthropicAgent.streamObject(
      'Extract the name and age from: John Doe is 30 years old.',
      zodSchema,
      { userId: 'test-user' }
    );

    const reader = stream.objectStream.getReader();
    const result = await reader.read();

    expect(result.value).toEqual({ name: 'John Doe', age: 30 });
    expect(result.done).toBe(true);
  });
});[0m
