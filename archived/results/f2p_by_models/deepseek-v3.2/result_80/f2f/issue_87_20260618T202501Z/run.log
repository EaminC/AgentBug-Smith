[32mimport { describe, it, expect, jest } from '@jest/globals';
import { Agent } from '@voltagent/core';
import { AnthropicProvider } from '@voltagent/anthropic-ai';
import { GroqProvider } from '@voltagent/groq-ai';
import { z } from 'zod';
import { jsonSchemaToZod } from '@n8n/json-schema-to-zod';

describe('JSON schema support for generateObject and streamObject', () => {
  const mockAnthropic = {
    messages: {
      create: jest.fn(),
      stream: jest.fn(),
    },
  };

  const mockGroq = {
    chat: {
      completions: {
        create: jest.fn(),
      },
    },
  };

  beforeEach(() => {
    jest.clearAllMocks();
  });

  it('should handle JSON schema via REST API generateObject', async () => {
    const jsonSchema = {
      type: 'object',
      properties: {
        name: { type: 'string' },
        age: { type: 'number' },
      },
      required: ['name', 'age'],
    };

    const mockResponse = {
      name: 'John Doe',
      age: 30,
    };

    const anthropicProvider = new AnthropicProvider({
      apiKey: 'test-key',
    });
    (anthropicProvider as any).anthropic = mockAnthropic;
    mockAnthropic.messages.create.mockResolvedValue({
      content: [
        {
          type: 'text',
          text: JSON.stringify(mockResponse),
        },
      ],
    });

    const agent = new Agent({
      provider: anthropicProvider,
