[32mimport unittest
from unittest.mock import patch, MagicMock
import agentscope
from agentscope.agents import TextToImageAgent, DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.msghub import msghub


class TestTextToImageAgentMsghubInteraction(unittest.TestCase):
    def setUp(self) -> None:
        # Clear any existing model configs to avoid warnings
        agentscope.init(model_configs=[], clear_all=True)

    @patch("agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper")
    def test_text_to_image_agent_receives_message_in_msghub(self, mock_model_cls):
        # Mock the model to avoid real API calls
        mock_model = MagicMock()
        mock_model.image_urls = ["http://example.com/image.jpg"]
        mock_model_cls.return_value = mock_model

        # Initialize model configs
        agentscope.init(
            model_configs=[
                {
                    "config_name": "qwen-max",
                    "model_type": "dashscope_chat",
                    "model_name": "qwen-max",
                    "api_key": "dummy_key",
                },
                {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "dummy_key",
                },
            ]
        )

        # Create agents
        agent_1 = DialogAgent(
            name="assistant",
            sys_prompt="You are an assistant.",
            model_config_name="qwen-max",
        )
        agent_2 = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        user_agent = UserAgent()

        # Simulate a user message
        x = Msg(name="host", content="I want a fancy restaurant design.")

        with msghub(participants=[agent_1, agent_2]):
            # DialogAgent processes the message
            agent_1(x)
            # TextToImageAgent should receive the message from memory
            # In buggy version, this fails because x is None inside reply
            result = agent_2()
            # Check that the result is a message with image URLs
            self.assertIsInstance(result, dict)
            self.assertIn("name", result)
            self.assertEqual(result["name"], "painter")
            self.assertIn("url", result)
            self.assertEqual(result["url"], ["http://example.com/image.jpg"])
            # Ensure the model was called with the content from the DialogAgent
            mock_model.assert_called_once_with("I want a fancy restaurant design.")

    def test_text_to_image_agent_sys_prompt_removed(self):
        # Verify that TextToImageAgent no longer accepts sys_prompt argument
        # In buggy version, constructor expects sys_prompt; fixed version removes it
        agentscope.init(
            model_configs=[
                {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "dummy_key",
                }
            ]
        )
        # This should work in fixed version (no sys_prompt)
        agent = TextToImageAgent(name="painter", model_config_name="wanx-v1")
        self.assertEqual(agent.sys_prompt, "")

    @patch("agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper")
    def test_text_to_image_agent_with_empty_memory(self, mock_model_cls):
        # When memory is empty and no message is passed, reply should return empty dict
        mock_model = MagicMock()
        mock_model_cls.return_value = mock_model
        agentscope.init(
            model_configs=[
                {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "dummy_key",
                }
            ]
        )
        agent = TextToImageAgent(name="painter", model_config_name="wanx-v1")
        # Clear memory
        agent.memory.clear()
        result = agent.reply()
        # In buggy version, this would crash because x is None and x.content is accessed
        # In fixed version, it should return empty dict
        self.assertEqual(result, {})
        mock_model.assert_not_called()

    @patch("agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper")
    def test_text_to_image_agent_with_explicit_message(self, mock_model_cls):
        # When a message is explicitly passed, it should be used
        mock_model = MagicMock()
        mock_model.image_urls = ["http://example.com/explicit.jpg"]
        mock_model_cls.return_value = mock_model
        agentscope.init(
            model_configs=[
                {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "dummy_key",
                }
            ]
        )
        agent = TextToImageAgent(name="painter", model_config_name="wanx-v1")
        msg = Msg(name="user", content="Explicit content")
        result = agent.reply(msg)
        self.assertIsInstance(result, dict)
        self.assertEqual(result["name"], "painter")
        self.assertEqual(result["url"], ["http://example.com/explicit.jpg"])
        mock_model.assert_called_once_with("Explicit content")


