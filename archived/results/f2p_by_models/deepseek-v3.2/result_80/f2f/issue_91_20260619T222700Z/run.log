[32mimport unittest
from unittest.mock import patch, MagicMock
import agentscope
from agentscope.agents import TextToImageAgent, DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.msghub import msghub
from agentscope.models import ModelWrapperBase


class TestTextToImageAgentMsghubInteraction(unittest.TestCase):
    """Test that TextToImageAgent correctly receives messages in msghub."""

    def setUp(self):
        # Mock model configurations to avoid real API calls
        self.model_configs = [
            {
                "config_name": "qwen-max",
                "model_type": "dashscope_chat",
                "model_name": "qwen-max",
                "api_key": "dummy_key",
            },
            {
                "config_name": "wanx-v1",
                "model_type": "dashscope_image_synthesis",
                "model_name": "wanx-v1",
                "api_key": "dummy_key",
            },
        ]
        # Initialize the agentscope environment with mocked configs
        agentscope.init(model_configs=self.model_configs)

    @patch("agentscope.models.dashscope_chat.DashScopeChatWrapper.call")
    @patch("agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper.call")
    def test_text_to_image_agent_receives_message_in_msghub(self, mock_image_call, mock_chat_call):
        """Test that TextToImageAgent can retrieve the last message from memory when x is None."""
        # Mock the chat model response
        mock_chat_call.return_value = Msg(
            name="assistants",
            content="Narrowed description for painter.",
        )
        # Mock the image model response
        mock_image_response = MagicMock()
        mock_image_response.image_urls = ["http://example.com/image.jpg"]
        mock_image_call.return_value = mock_image_response

        # Create agents with mocked models
        agent_1 = DialogAgent(
            name="assistants",
            sys_prompt="You are tasked with narrowing down the user's description of the need to 100 words or less and relaying it to the painter for him to draw. Note that the language you generate after listening must be spoken to the painter!",
            model_config_name="qwen-max",
        )
        agent_2 = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        useragent = UserAgent()

        # Initial message
        x = Msg(name="host", content="I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha")

        with msghub(participants=[agent_1, agent_2]):
            # DialogAgent processes the initial message
            result1 = agent_1(x)
            self.assertIsNotNone(result1)
            # TextToImageAgent is called without arguments, should retrieve last message from memory
            result2 = agent_2()
            # In buggy version, agent_2() would crash because x is None and memory retrieval not implemented.
            # After fix, it should succeed.
            self.assertIsNotNone(result2)
            self.assertEqual(result2.name, "painter")
            self.assertIn("This is the generated image", result2.content)
            self.assertIsInstance(result2.url, list)
            # UserAgent can be called without issues
            useragent()

        # Verify that the image model was called with the content from the last message
        # The last message in memory should be from agent_1's response
        mock_image_call.assert_called_once()
        call_args = mock_image_call.call_args
        # The argument should be the content of the last message in memory
        self.assertIn("Narrowed description for painter.", call_args[0][0])

    @patch("agentscope.models.dashscope_chat.DashScopeChatWrapper.call")
    @patch("agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper.call")
    def test_text_to_image_agent_with_empty_memory(self, mock_image_call, mock_chat_call):
        """Test TextToImageAgent with empty memory returns empty dict."""
        # Mock the image model (should not be called)
        mock_image_call.return_value = MagicMock(image_urls=[])
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        # Clear memory
        agent.memory.clear()
        # Call without arguments and empty memory
        result = agent()
        # Should return empty dict as per fix
        self.assertEqual(result, {})
        mock_image_call.assert_not_called()

    @patch("agentscope.models.dashscope_chat.DashScopeChatWrapper.call")
    @patch("agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper.call")
    def test_text_to_image_agent_with_explicit_message(self, mock_image_call, mock_chat_call):
        """Test TextToImageAgent works when explicit message is provided."""
        mock_image_response = MagicMock()
        mock_image_response.image_urls = ["http://example.com/explicit.jpg"]
        mock_image_call.return_value = mock_image_response
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        msg = Msg(name="user", content="Explicit description")
        result = agent(msg)
        self.assertIsNotNone(result)
        self.assertEqual(result.name, "painter")
        mock_image_call.assert_called_once_with("Explicit description")


if __name__ == "__main__":
    unittest.main()[0m
