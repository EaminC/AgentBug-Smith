class TestTextToImageAgentMsghubInteraction(unittest.TestCase):
    """Test that TextToImageAgent can receive messages in msghub."""

    def setUp(self) -> None:
        # Mock model configs to avoid real API calls
        self.model_configs = [
            {
                "config_name": "qwen-max",
                "model_type": "dashscope_chat",
                "model_name": "qwen-max",
                "api_key": "fake-key",
            },
            {
                "config_name": "wanx-v1",
                "model_type": "dashscope_image_synthesis",
                "model_name": "wanx-v1",
                "api_key": "fake-key",
            },
        ]
        agentscope.init(model_configs=self.model_configs)

    @patch("agentscope.models.dashscope_chat.DashScopeChatWrapper")
    @patch("agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper")
    def test_text_to_image_agent_receives_message_in_msghub(
        self,
        mock_image_wrapper_cls,
        mock_chat_wrapper_cls,
    ) -> None:
        """Test that TextToImageAgent receives the last message from memory when called without arguments in msghub."""
        # Mock the model instances
        mock_chat_model = MagicMock()
        mock_chat_model.return_value = Msg(name="assistants", content="narrowed description")
        mock_chat_wrapper_cls.return_value = mock_chat_model

        mock_image_model = MagicMock()
        mock_image_model.return_value.image_urls = ["http://example.com/image.jpg"]
        mock_image_wrapper_cls.return_value = mock_image_model

        # Create agents
        agent_1 = DialogAgent(
            name="assistants",
            sys_prompt="You are tasked with narrowing down the user's description of the need to 100 words or less and relaying it to the painter for him to draw. Note that the language you generate after listening must be spoken to the painter!",
            model_config_name="qwen-max",
        )
        agent_2 = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        user_agent = UserAgent()

        # Simulate a user message
        x = Msg(
            name="host",
            content="I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha",
        )

        with msghub(participants=[agent_1, agent_2]):
            # DialogAgent processes the user message
            agent_1(x)
            # TextToImageAgent should receive the last message from memory (the one from DialogAgent)
            # In buggy version, x is None inside reply, causing AttributeError on x.content
            # In fixed version, x should be retrieved from memory
            result = agent_2()

        # Verify that the image model was called with the content from the last message
        # The last message in memory should be from agent_1
        self.assertIsNotNone(result)
        # In the fixed version, result should be a dict (the generated image message)
        # In buggy version, if x is None, the method may return early with an empty dict
        # or raise an AttributeError. We'll check that the model was called with a proper content.
        # The mock_image_model should have been called with the content from agent_1's message.
        # Since we can't directly inspect the call because of the mock chain,
        # we check that the result is not an empty dict (which would be the buggy behavior
        # when memory is empty). Actually, the buggy version would have crashed with
        # AttributeError because x is None. The test will fail on buggy version because
        # of that exception. After fix, the call succeeds.
        self.assertIn("name", result)
        self.assertEqual(result["name"], "painter")

    @patch("agentscope.models.dashscope_chat.DashScopeChatWrapper")
    @patch("agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper")
    def test_text_to_image_agent_with_empty_memory(
        self,
        mock_image_wrapper_cls,
        mock_chat_wrapper_cls,
    ) -> None:
        """Test TextToImageAgent when memory is empty and no argument is passed."""
        mock_image_model = MagicMock()
        mock_image_model.return_value.image_urls = []
        mock_image_wrapper_cls.return_value = mock_image_model

        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        # Ensure memory is empty
        agent.memory.clear()
        # Calling with no argument and empty memory should not crash.
        # In buggy version, x is None and self.model(x.content) raises AttributeError.
        # In fixed version, x becomes None after checking memory, and returns empty dict.
        result = agent()
        # Should return empty dict as per fix
