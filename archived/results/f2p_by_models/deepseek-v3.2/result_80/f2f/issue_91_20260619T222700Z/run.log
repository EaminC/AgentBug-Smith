        result = agent(msg)
        self.assertIsNotNone(result)
        self.assertEqual(result.content, "This is the generated image ")

    def test_text_to_image_agent_with_empty_memory(self):
        """Test TextToImageAgent when memory is empty and no message is passed."""
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        # In buggy version, this would crash because x is None and memory is empty.
        # In fixed version, it should return an empty dict.
        result = agent()
        self.assertEqual(result, {})

