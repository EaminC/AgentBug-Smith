                    "api_key": "fake-key",
                },
                {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "fake-key",
                },
            ]
        )

        agent_1 = DialogAgent(
            name="assistant",
            sys_prompt="You are an assistant.",
            model_config_name="qwen-max",
        )
        agent_2 = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        user_agent = UserAgent()

        # Simulate a user message
        x = Msg(
            name="host",
            content="I want a fancy upscale restaurant design.",
        )

        with msghub(participants=[agent_1, agent_2]):
            # DialogAgent processes the user message and sends a message to the hub
            agent_1(x)
            # TextToImageAgent should receive the last message from memory (the one from DialogAgent)
            # In buggy code, x is None inside reply() and it fails to fetch from memory.
            result = agent_2()

        # Verify that the model was called with the content from DialogAgent's message
        # The actual content depends on DialogAgent's response, but we check that model was called
        # with a non-empty string (not the buggy None).
        self.assertIsNotNone(mock_model.call_args)
        call_arg = mock_model.call_args[0][0]
        self.assertIsInstance(call_arg, str)
        self.assertGreater(len(call_arg), 0)

        # Verify that result is a dict (the returned message)
        self.assertIsInstance(result, dict)
        self.assertEqual(result["name"], "painter")
        self.assertIn("url", result)

