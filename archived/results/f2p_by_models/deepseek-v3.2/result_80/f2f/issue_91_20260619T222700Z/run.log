[32mimport unittest
from unittest.mock import patch, MagicMock
import agentscope
from agentscope.agents import TextToImageAgent, DialogAgent
from agentscope.message import Msg
from agentscope.msghub import msghub


class TestTextToImageAgentMsghubInteraction(unittest.TestCase):
    def setUp(self) -> None:
        # Mock the model configuration loading
        self.model_configs_patch = patch.dict(
            "agentscope._runtime._runtime_configs.model_configs",
            {
                "qwen-max": {
                    "config_name": "qwen-max",
                    "model_type": "dashscope_chat",
                    "model_name": "qwen-max",
                    "api_key": "test_key",
                },
                "wanx-v1": {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "test_key",
                },
            },
            clear=True,
        )
        self.model_configs_patch.start()

        # Mock the model instantiation for dashscope_chat
        self.dashscope_chat_patch = patch(
            "agentscope.models.dashscope_chat_model.DashScopeChatWrapper"
        )
        self.mock_dashscope_chat_class = self.dashscope_chat_patch.start()
        self.mock_dashscope_chat_instance = MagicMock()
        self.mock_dashscope_chat_class.return_value = (
            self.mock_dashscope_chat_instance
        )

        # Mock the model instantiation for dashscope_image_synthesis
        self.dashscope_image_patch = patch(
            "agentscope.models.dashscope_image_synthesis_model.DashScopeImageSynthesisWrapper"
        )
        self.mock_dashscope_image_class = self.dashscope_image_patch.start()
        self.mock_dashscope_image_instance = MagicMock()
        self.mock_dashscope_image_class.return_value = (
            self.mock_dashscope_image_instance
        )

    def tearDown(self) -> None:
        self.model_configs_patch.stop()
        self.dashscope_chat_patch.stop()
        self.dashscope_image_patch.stop()

    def test_text_to_image_agent_receives_message_in_msghub(self) -> None:
        """Test that TextToImageAgent can receive a message from DialogAgent within msghub."""
        # Create agents with mocked models
        agent_1 = DialogAgent(
            name="assistant",
            sys_prompt="You are an assistant.",
            model_config_name="qwen-max",
        )
        agent_2 = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )

        # Simulate a message from the user
        user_msg = Msg(name="user", content="Draw a cat")

        # Mock the dashscope chat model to return a response
        self.mock_dashscope_chat_instance.return_value = Msg(
            name="assistant",
            content="A cute cat",
        )

        # Mock the image synthesis model to return a dummy image URL
        mock_response = MagicMock()
        mock_response.image_urls = ["http://example.com/cat.jpg"]
        self.mock_dashscope_image_instance.return_value = mock_response

        with msghub(participants=[agent_1, agent_2]):
            # DialogAgent processes the user message
            response_from_agent_1 = agent_1(user_msg)
            # TextToImageAgent should now be able to reply without explicit input
            response_from_agent_2 = agent_2()

        # In buggy version, agent_2() would fail because x is None.
        # In fixed version, agent_2() should succeed and use the last message from memory.
        # We just need to verify that agent_2() didn't crash and returned a message.
        self.assertIsNotNone(response_from_agent_2)
        self.assertEqual(response_from_agent_2["name"], "painter")
        self.assertEqual(
            response_from_agent_2["content"], "This is the generated image "
        )
        self.assertEqual(
            response_from_agent_2["url"], ["http://example.com/cat.jpg"]
        )

    def test_text_to_image_agent_with_empty_memory(self) -> None:
        """Test that TextToImageAgent returns empty dict when memory is empty and no input."""
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        # No messages in memory, and no input provided.
        # In buggy version, this would crash because x is None and x.content is accessed.
        # In fixed version, this should return an empty dict.
        result = agent.reply()
        self.assertEqual(result, {})

    def test_text_to_image_agent_with_explicit_message(self) -> None:
        """Test that TextToImageAgent works when an explicit message is passed."""
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        msg = Msg(name="user", content="Draw a dog")
        mock_response = MagicMock()
        mock_response.image_urls = ["http://example.com/dog.jpg"]
        self.mock_dashscope_image_instance.return_value = mock_response

        result = agent.reply(msg)
        self.assertEqual(result["name"], "painter")
        self.assertEqual(result["content"], "This is the generated image ")
        self.assertEqual(result["url"], ["http://example.com/dog.jpg"])

    def test_text_to_image_agent_sys_prompt_removed(self) -> None:
        """Test that TextToImageAgent no longer requires sys_prompt argument."""
        # This should not raise an error after the fix.
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        self.assertEqual(agent.sys_prompt, "")


if __name__ == "__main__":
    unittest.main()[0m
