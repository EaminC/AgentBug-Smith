                "model_type": "dashscope_chat",
                "model_name": "qwen-max",
                "api_key": "fake_key"
            },
            {
                "config_name": "wanx-v1",
                "model_type": "dashscope_image_synthesis",
                "model_name": "wanx-v1",
                "api_key": "fake_key"
            }
        ])

    def tearDown(self) -> None:
        self.chat_patcher.stop()
        self.image_patcher.stop()
        agentscope.models._config_name_to_config.clear()

    def test_text_to_image_agent_receives_message_in_msghub(self):
        """
        Test that TextToImageAgent receives the message from DialogAgent
        when called without arguments inside msghub.
        In buggy version, x is None and agent crashes.
        In fixed version, agent should retrieve last message from memory.
        """
        # Create agents with mocked models
        agent_1 = DialogAgent(
            name="assistants",
            sys_prompt="You are an assistant.",
            model_config_name="qwen-max"
        )
        agent_2 = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1"
        )
        user_agent = UserAgent()

        # Initial message from host
        x = Msg(name="host", content='I want a fancy restaurant design')

        with msghub(participants=[agent_1, agent_2]):
            # DialogAgent processes the message
            result1 = agent_1(x)
            # TextToImageAgent is called without arguments.
            # In buggy version, this would crash because x is None.
            # In fixed version, it should retrieve the last message from memory.
            result2 = agent_2()
            # UserAgent call (just to match original example)
            user_agent()

        # Verify that the image model was called with the content from memory
        # The content should be from the DialogAgent's reply
        self.mock_image_model.assert_called_once()
        call_args = self.mock_image_model_instance.call_args
        # The model is called with x.content, where x is the retrieved message
        # We can't directly assert the content because it's mocked,
        # but we can verify that the agent didn't crash and returned a message.
        self.assertIsInstance(result2, dict)
        # In fixed version, result2 should be a Msg with url
        self.assertIn('url', result2)
        self.assertEqual(result2['url'], ["http://mock.image.url"])

    def test_text_to_image_agent_with_empty_memory(self):
        """
        Test TextToImageAgent when called without arguments and memory is empty.
        In buggy version, this would crash because x is None and model is called.
        In fixed version, reply should return {}.
        """
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1"
        )
        # Ensure memory is empty
        agent.memory.clear()
        # Call without arguments
        result = agent()
        # In fixed version, should return {} when no message in memory
        self.assertEqual(result, {})

    def test_text_to_image_agent_with_explicit_message(self):
        """
        Test TextToImageAgent when called with an explicit message.
        Should work both in buggy and fixed versions.
        """
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1"
        )
        msg = Msg(name="user", content="Draw a cat")
        result = agent(msg)
        # Model should be called with the message content
        self.mock_image_model_instance.assert_called_once()
        self.assertIn('url', result)
        self.assertEqual(result['url'], ["http://mock.image.url"])

