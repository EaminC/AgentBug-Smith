[32mimport unittest
from unittest.mock import patch, MagicMock
import agentscope
from agentscope.agents import TextToImageAgent, DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.msghub import msghub


class TestTextToImageAgentMsghubInteraction(unittest.TestCase):
    def setUp(self):
        # Mock model configurations to avoid external API calls
        self.model_configs = [
            {
                "config_name": "qwen-max",
                "model_type": "dashscope_chat",
                "model_name": "qwen-max",
                "api_key": "dummy_key",
            },
            {
                "config_name": "wanx-v1",
                "model_type": "dashscope_image_synthesis",
                "model_name": "wanx-v1",
                "api_key": "dummy_key",
            },
        ]
        # Initialize the model configs
        agentscope.init(model_configs=self.model_configs)

    def test_text_to_image_agent_receives_message_in_msghub(self):
        """Test that TextToImageAgent receives the message from DialogAgent within msghub."""
        # Create agents with mocked models
        with patch('agentscope.models.dashscope_chat.DashScopeChatWrapper') as mock_chat_cls, \
             patch('agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper') as mock_image_cls:
            mock_chat_model = MagicMock()
            mock_chat_model.return_value = Msg(name="assistants", content="Mocked chat response")
            mock_chat_cls.return_value = mock_chat_model

            mock_image_model = MagicMock()
            mock_image_model.return_value.image_urls = ["http://example.com/image.jpg"]
            mock_image_cls.return_value = mock_image_model

            agent_1 = DialogAgent(
                name="assistants",
                sys_prompt="You are tasked with narrowing down the user's description of the need to 100 words or less and relaying it to the painter for him to draw. Note that the language you generate after listening must be spoken to the painter!",
                model_config_name="qwen-max"
            )
            agent_2 = TextToImageAgent(
                name="painter",
                model_config_name="wanx-v1"
            )
            useragent = UserAgent()

            x = Msg(name="host", content='I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha')

            with msghub(participants=[agent_1, agent_2]):
                # DialogAgent processes the message
                chat_msg = agent_1(x)
                # TextToImageAgent should receive the message from DialogAgent via msghub
                image_msg = agent_2()
                # UserAgent step (optional)
                user_msg = useragent()

            # Verify that TextToImageAgent's memory contains the message from DialogAgent
            self.assertGreater(agent_2.memory.size(), 0)
            # The last memory entry should be the image message, but the first should be the chat message
            memory = agent_2.memory.get_memory()
            # In buggy code, x would be None in agent_2.reply() because msghub doesn't pass it.
            # In fixed code, agent_2.reply() will retrieve the last message from memory when x is None.
            # We check that agent_2 produced a message (non-empty) and that memory has the chat message.
            self.assertIsNotNone(image_msg)
            self.assertIn("content", image_msg)
            # Ensure the image agent actually used the chat message content
            # The mock image model was called with the content from the chat message
            mock_image_model.assert_called_once()
            # The call argument should be the content from the chat message
            call_args = mock_image_model.call_args
            self.assertIsNotNone(call_args)
            # The content should be from the chat message, not empty
            self.assertTrue(call_args[0][0])  # content string is truthy

    def test_text_to_image_agent_with_empty_memory(self):
        """Test TextToImageAgent when called with no message and empty memory."""
        with patch('agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper') as mock_image_cls:
            mock_image_model = MagicMock()
            mock_image_model.return_value.image_urls = []
            mock_image_cls.return_value = mock_image_model

            agent = TextToImageAgent(
                name="painter",
                model_config_name="wanx-v1"
            )
            # Clear memory
            agent.memory.clear()
            # Call without argument
            result = agent()
            # In buggy code, this would crash because x is None and x.content is accessed.
            # In fixed code, it should return an empty dict when memory is empty.
            self.assertEqual(result, {})

    def test_text_to_image_agent_with_explicit_message(self):
        """Test TextToImageAgent when called with an explicit message."""
        with patch('agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper') as mock_image_cls:
            mock_image_model = MagicMock()
            mock_image_model.return_value.image_urls = ["http://example.com/test.jpg"]
            mock_image_cls.return_value = mock_image_model

            agent = TextToImageAgent(
                name="painter",
                model_config_name="wanx-v1"
            )
            msg = Msg(name="user", content="A beautiful sunset")
            result = agent(msg)
            # Should have generated an image message
            self.assertIsInstance(result, dict)
            self.assertEqual(result["name"], "painter")
            self.assertIn("url", result)
            self.assertEqual(result["url"], ["http://example.com/test.jpg"])
            # Memory should contain the input message and the output message
            self.assertEqual(agent.memory.size(), 2)


if __name__ == "__main__":
