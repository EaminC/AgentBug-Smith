from agentscope.msghub import msghub


class TestTextToImageAgentMsghubInteraction(unittest.TestCase):
    def setUp(self) -> None:
        # Mock the model configuration loading
        self.model_configs_patch = patch.dict(
            "agentscope._runtime._config.model_configs",
            {
                "qwen-max": {
                    "config_name": "qwen-max",
                    "model_type": "dashscope_chat",
                    "model_name": "qwen-max",
                    "api_key": "test_key",
                },
                "wanx-v1": {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "test_key",
                },
            },
            clear=True,
        )
        self.model_configs_patch.start()

        # Mock the dashscope image synthesis model to avoid real API calls
        self.model_patch = patch(
            "agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper",
            return_value=MagicMock(
                **{
                    "return_value": MagicMock(
                        image_urls=["http://example.com/image.jpg"]
                    )
                }
            ),
        )
        self.model_patch.start()

        # Mock the dashscope chat model
        self.chat_model_patch = patch(
            "agentscope.models.dashscope_chat.DashScopeChatWrapper",
            return_value=MagicMock(
                **{
                    "return_value": Msg(
                        name="assistants",
                        content="This is a narrowed down description.",
                    )
                }
            ),
        )
        self.chat_model_patch.start()

    def tearDown(self) -> None:
        self.model_configs_patch.stop()
        self.model_patch.stop()
        self.chat_model_patch.stop()

    def test_text_to_image_agent_receives_message_in_msghub(self):
        """Test that TextToImageAgent receives the message from DialogAgent within msghub."""
        agent_1 = DialogAgent(
            name="assistants",
            sys_prompt="You are an assistant.",
            model_config_name="qwen-max",
        )
        agent_2 = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )

        initial_msg = Msg(
            name="host",
            content="I want a fancy upscale restaurant design.",
        )

        with msghub(participants=[agent_1, agent_2]):
            # DialogAgent processes the initial message
            response = agent_1(initial_msg)
            # TextToImageAgent should automatically pick up the last message from memory
            image_msg = agent_2()

        # In the buggy version, agent_2 would have received None and crashed.
        # In the fixed version, agent_2 should have received the message from agent_1.
        # We check that agent_2 returned a message (not None or empty dict).
        self.assertIsNotNone(image_msg)
        self.assertNotEqual(image_msg, {})
        # Ensure the content is set (the mock returns a Msg with content)
