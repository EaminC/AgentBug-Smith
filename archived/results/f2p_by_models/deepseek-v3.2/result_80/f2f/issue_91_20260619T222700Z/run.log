                    "model_name": "qwen-max",
                    "api_key": "test_key",
                },
                "wanx-v1": {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "test_key",
                },
            },
            clear=True,
        ):
            # Create agents with mocked models
            with patch(
                "agentscope.models.dashscope_chat_model.DashScopeChatWrapper"
            ) as mock_chat_cls, patch(
                "agentscope.models.dashscope_image_synthesis_model.DashScopeImageSynthesisWrapper"
            ) as mock_image_cls:
                mock_chat_model = MagicMock()
                mock_chat_model.return_value = Msg(
                    name="assistants",
                    content="Mocked response from DialogAgent",
                )
                mock_chat_cls.return_value = mock_chat_model

                mock_image_model = MagicMock()
                mock_image_model.image_urls = ["http://example.com/image.jpg"]
                mock_image_cls.return_value = mock_image_model

                agent_1 = DialogAgent(
                    name="assistants",
                    sys_prompt="You are an assistant.",
                    model_config_name="qwen-max",
                )
                agent_2 = TextToImageAgent(
                    name="painter",
                    model_config_name="wanx-v1",
                )
                useragent = UserAgent()

                x = Msg(
                    name="host",
                    content="I want a fancy upscale restaurant design.",
                )

                with msghub(participants=[agent_1, agent_2]):
                    # DialogAgent processes the initial message
                    response_from_agent1 = agent_1(x)
                    # TextToImageAgent is called without argument; it should retrieve the last message from memory
                    response_from_agent2 = agent_2()
                    # UserAgent step (optional)
                    useragent()

                # Verify that TextToImageAgent's reply method received the message from memory
                # In buggy version, x would be None inside reply, causing AttributeError on x.content
                # In fixed version, x should be the last message from memory (the response from DialogAgent)
                # We check that the model was called with a non-None argument
                self.assertIsNotNone(response_from_agent2)
                # The model should have been called with the content from the last message
                # Since we mocked the model, we can check that mock_image_cls was instantiated and called
                mock_image_cls.assert_called_once()
                # The model instance should have been called with some content
                mock_image_model.assert_called_once()
                call_args = mock_image_model.call_args
                self.assertIsNotNone(call_args)
                # The first argument to the model call should be a string (the content)
                self.assertIsInstance(call_args[0][0], str)

