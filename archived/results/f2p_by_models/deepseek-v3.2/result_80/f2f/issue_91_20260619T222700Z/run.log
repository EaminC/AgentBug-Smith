[32mimport unittest
from unittest.mock import patch, MagicMock
from agentscope.agents import TextToImageAgent, DialogAgent
from agentscope.message import Msg
from agentscope.msghub import msghub


class TestTextToImageAgentMsghubInteraction(unittest.TestCase):
    def setUp(self) -> None:
        # Mock the model configuration loading
        self.model_configs_patch = patch.dict(
            "agentscope._runtime._runtime_config.model_configs",
            {
                "qwen-max": {
                    "config_name": "qwen-max",
                    "model_type": "dashscope_chat",
                    "model_name": "qwen-max",
                    "api_key": "test_key",
                },
                "wanx-v1": {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "test_key",
                },
            },
            clear=True,
        )
        self.model_configs_patch.start()
        # Mock the model instantiation for dashscope_chat
        self.dashscope_chat_patch = patch(
            "agentscope.models.dashscope_chat_model.DashScopeChatWrapper",
            autospec=True,
        )
        mock_chat_model = self.dashscope_chat_patch.start()
        mock_chat_instance = MagicMock()
        mock_chat_instance.return_value = Msg(name="assistants", content="Mocked response")
        mock_chat_model.return_value = mock_chat_instance
        # Mock the model instantiation for dashscope_image_synthesis
        self.dashscope_image_patch = patch(
            "agentscope.models.dashscope_image_synthesis_model.DashScopeImageSynthesisWrapper",
            autospec=True,
        )
        mock_image_model = self.dashscope_image_patch.start()
        mock_image_instance = MagicMock()
        mock_image_instance.image_urls = ["http://example.com/image.jpg"]
        mock_image_model.return_value = mock_image_instance

    def tearDown(self) -> None:
        self.model_configs_patch.stop()
        self.dashscope_chat_patch.stop()
        self.dashscope_image_patch.stop()

    def test_text_to_image_agent_receives_message_in_msghub(self) -> None:
        """Test that TextToImageAgent receives the last message from memory when called without arguments in msghub."""
        # Create agents with mocked models
        agent_1 = DialogAgent(
            name="assistants",
            sys_prompt="You are an assistant.",
            model_config_name="qwen-max",
        )
        agent_2 = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        # Simulate a message from user
        x = Msg(name="host", content="I want a fancy restaurant design")
        with msghub(participants=[agent_1, agent_2]):
            # DialogAgent processes the message and stores it in memory
            response = agent_1(x)
            # TextToImageAgent should retrieve the last message from its memory
            # In buggy version, x is None and fails; in fixed version, it retrieves from memory.
            result = agent_2()
        # Assert that the TextToImageAgent produced a message
        self.assertIsInstance(result, dict)
        self.assertEqual(result["name"], "painter")
        self.assertIn("url", result)

    def test_text_to_image_agent_with_explicit_message(self) -> None:
        """Test TextToImageAgent works when an explicit message is passed."""
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        msg = Msg(name="user", content="Draw a cat")
        result = agent(msg)
        self.assertIsInstance(result, dict)
        self.assertEqual(result["name"], "painter")
        self.assertIn("url", result)

    def test_text_to_image_agent_with_empty_memory(self) -> None:
        """Test TextToImageAgent returns empty dict when memory is empty and no message given."""
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        # Call without arguments and with empty memory
        result = agent()
        # In buggy version, this would crash; in fixed version, returns {}
        self.assertEqual(result, {})

    def test_text_to_image_agent_sys_prompt_removed(self) -> None:
        """Test that TextToImageAgent no longer accepts sys_prompt argument (as per patch)."""
        # The patch removes sys_prompt from __init__ signature.
        # This test ensures the agent can be instantiated without sys_prompt.
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        self.assertEqual(agent.name, "painter")
        # Verify sys_prompt is empty string internally (as per fixed __init__)
        self.assertEqual(agent.sys_prompt, "")


if __name__ == "__main__":
