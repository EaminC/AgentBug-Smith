[32mimport unittest
from unittest.mock import patch, MagicMock
from agentscope.agents import TextToImageAgent, DialogAgent
from agentscope.message import Msg
from agentscope.msghub import msghub


class TestTextToImageAgentMsghubInteraction(unittest.TestCase):
    """Test that TextToImageAgent correctly receives messages in msghub."""

    def setUp(self) -> None:
        # Mock the model configuration loading
        self.model_configs_patch = patch.dict(
            "agentscope._runtime.configs.model_configs",
            {
                "qwen-max": {
                    "config_name": "qwen-max",
                    "model_type": "dashscope_chat",
                    "model_name": "qwen-max",
                    "api_key": "test_key",
                },
                "wanx-v1": {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "test_key",
                },
            },
            clear=True,
        )
        self.model_configs_patch.start()

        # Mock the model instantiation
        self.model_patch = patch(
            "agentscope.agents.text_to_image_agent.ModelFactory.get",
            return_value=MagicMock(
                **{
                    "image_urls": ["http://example.com/image.jpg"],
                    "return_value": MagicMock(
                        image_urls=["http://example.com/image.jpg"]
                    ),
                }
            ),
        )
        self.model_patch.start()

    def tearDown(self) -> None:
        self.model_configs_patch.stop()
        self.model_patch.stop()

    def test_text_to_image_agent_receives_message_in_msghub(self) -> None:
        """Test that TextToImageAgent receives the last message from memory when called without argument in msghub."""
        # Create agents
        agent1 = DialogAgent(
            name="assistant",
            sys_prompt="You are an assistant.",
            model_config_name="qwen-max",
        )
        agent2 = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )

        # Initial message
        x = Msg(name="host", content="I want a fancy restaurant design.")

        with msghub(participants=[agent1, agent2]):
            # agent1 processes the message, which should be stored in memory
            response1 = agent1(x)
            # agent2 is called without argument; in buggy version it receives None,
            # in fixed version it should retrieve the last message from memory.
            response2 = agent2()

        # In buggy version, agent2.reply receives x=None, causing AttributeError
        # when accessing x.content. The fix makes it retrieve from memory.
        # We assert that agent2 returns a message (not empty dict).
        self.assertIsInstance(response2, dict)
        self.assertIn("content", response2)
        # The content should be the generated image message
        self.assertEqual(response2["content"], "This is the generated image ")

    def test_text_to_image_agent_with_explicit_message(self) -> None:
        """Test TextToImageAgent works when explicit message is passed."""
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        msg = Msg(name="user", content="Draw a cat.")
        response = agent(msg)
        self.assertIsInstance(response, dict)
        self.assertEqual(response["content"], "This is the generated image ")

    def test_text_to_image_agent_with_empty_memory(self) -> None:
        """Test TextToImageAgent returns empty dict when memory is empty and no message given."""
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
            use_memory=True,
        )
        # Call without argument and with empty memory
        response = agent()
        # In fixed version, should return {} because memory is empty
        self.assertEqual(response, {})

    def test_text_to_image_agent_sys_prompt_removed(self) -> None:
        """Test that TextToImageAgent no longer accepts sys_prompt argument."""
        # In buggy version, constructor accepts sys_prompt.
        # In fixed version, it does not.
        # We test that the constructor raises TypeError if sys_prompt is given.
        # However, the patch shows sys_prompt parameter is removed,
        # so we just verify that we can create an agent without sys_prompt.
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        self.assertEqual(agent.name, "painter")
        # The sys_prompt attribute should be empty string (as set in parent)
        self.assertEqual(agent.sys_prompt, "")


if __name__ == "__main__":
