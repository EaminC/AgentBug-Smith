[32mimport unittest
from unittest.mock import patch, MagicMock
import agentscope
from agentscope.agents import TextToImageAgent, DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.msghub import msghub


class TestTextToImageAgentMsghubInteraction(unittest.TestCase):
    def setUp(self) -> None:
        # Mock the model configuration loading
        self.model_configs_patch = patch.dict(
            "agentscope._runtime._runtime_configs.model_configs",
            {
                "qwen-max": {
                    "config_name": "qwen-max",
                    "model_type": "dashscope_chat",
                    "model_name": "qwen-max",
                    "api_key": "test_key",
                },
                "wanx-v1": {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "test_key",
                },
            },
            clear=True,
        )
        self.model_configs_patch.start()

        # Mock the actual model calls to avoid real API calls
        self.dashscope_chat_patch = patch(
            "agentscope.models.dashscope_chat_model.DashScopeChatWrapper"
        )
        self.dashscope_image_patch = patch(
            "agentscope.models.dashscope_image_synthesis_model.DashScopeImageSynthesisWrapper"
        )
        mock_chat_class = self.dashscope_chat_patch.start()
        mock_image_class = self.dashscope_image_patch.start()

        self.mock_chat_model = MagicMock()
        self.mock_image_model = MagicMock()
        mock_chat_class.return_value = self.mock_chat_model
        mock_image_class.return_value = self.mock_image_model

        # Configure mock model responses
        self.mock_chat_model.return_value = Msg(
            name="assistants",
            content="Mocked dialog response",
        )
        self.mock_image_model.return_value = MagicMock(
            image_urls=["http://example.com/image.jpg"]
        )

    def tearDown(self) -> None:
        self.model_configs_patch.stop()
        self.dashscope_chat_patch.stop()
        self.dashscope_image_patch.stop()

    def test_text_to_image_agent_receives_message_in_msghub(self):
        """Test that TextToImageAgent receives the last message from memory when called without arguments in msghub."""
        # Create agents with mocked models
        agent_1 = DialogAgent(
            name="assistants",
            sys_prompt="You are tasked with narrowing down the user's description...",
            model_config_name="qwen-max",
        )
        agent_2 = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        useragent = UserAgent()

        # Initial message
        x = Msg(
            name="host",
            content="I want a fancy upscale restaurant design you know, the kind of western restaurant similar to haha",
        )

        with msghub(participants=[agent_1, agent_2]):
            # DialogAgent processes the initial message
            agent_1(x)
            # TextToImageAgent should automatically pick up the last message from memory
            # In buggy version, x passed to reply is None, causing AttributeError on x.content
            # In fixed version, x should be retrieved from memory
            result = agent_2()

        # Verify that the image model was called with the content from the dialog agent
        # The actual content depends on the mocked dialog response
        self.mock_image_model.assert_called_once()
        call_args = self.mock_image_model.call_args
        # The argument should be the content string
        self.assertIsInstance(call_args[0][0], str)

        # Verify the result is a message with image URLs
        self.assertEqual(result.name, "painter")
        self.assertEqual(result.content, "This is the generated image ")
        self.assertEqual(result.url, ["http://example.com/image.jpg"])

    def test_text_to_image_agent_with_explicit_message(self):
        """Test TextToImageAgent works when explicitly given a message."""
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        msg = Msg(name="user", content="Draw a cat")
        result = agent(msg)

        self.mock_image_model.assert_called_once_with("Draw a cat")
        self.assertEqual(result.name, "painter")
        self.assertEqual(result.content, "This is the generated image ")
        self.assertEqual(result.url, ["http://example.com/image.jpg"])

    def test_text_to_image_agent_with_empty_memory(self):
        """Test TextToImageAgent when memory is empty and no message provided."""
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
            use_memory=True,
        )
        # Call without arguments and with empty memory
        # In buggy version, this would cause AttributeError on x.content because x is None
        # In fixed version, it should return empty dict because memory size is 0
        result = agent()
        # After fix, when memory is empty, reply returns {}
        self.assertEqual(result, {})

    def test_text_to_image_agent_sys_prompt_removed(self):
        """Test that TextToImageAgent no longer accepts sys_prompt argument."""
        # In buggy version, constructor accepts sys_prompt.
        # In fixed version, constructor should raise TypeError if sys_prompt is provided.
        # However, the patch shows sys_prompt parameter is removed from __init__,
        # so we test that we can instantiate without sys_prompt.
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        self.assertEqual(agent.name, "painter")
        # The base class may set sys_prompt to empty string
        self.assertEqual(agent.sys_prompt, "")


if __name__ == "__main__":
