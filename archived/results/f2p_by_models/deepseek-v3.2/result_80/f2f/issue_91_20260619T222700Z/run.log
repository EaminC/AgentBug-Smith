[32mimport unittest
from unittest.mock import patch, MagicMock
import agentscope
from agentscope.agents import TextToImageAgent, DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.msghub import msghub


class TestTextToImageAgentMsghubInteraction(unittest.TestCase):
    """Test that TextToImageAgent correctly receives messages in msghub."""

    def setUp(self) -> None:
        # Mock the model configuration loading
        self.model_configs_patch = patch.dict(
            "agentscope._runtime._runtime_config.model_configs",
            {
                "qwen-max": {
                    "config_name": "qwen-max",
                    "model_type": "dashscope_chat",
                    "model_name": "qwen-max",
                    "api_key": "test_key",
                },
                "wanx-v1": {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "test_key",
                },
            },
            clear=True,
        )
        self.model_configs_patch.start()
        # Also mock the model instantiation to avoid real API calls
        self.model_mock = MagicMock()
        self.model_mock.return_value.image_urls = ["http://example.com/image.jpg"]
        self.model_patch = patch(
            "agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper",
            self.model_mock,
        )
        self.model_patch.start()

    def tearDown(self) -> None:
        self.model_configs_patch.stop()
        self.model_patch.stop()

    def test_text_to_image_agent_receives_message_in_msghub(self) -> None:
        """Test that TextToImageAgent receives the last message from memory when called without argument in msghub."""
        # Create agents with mocked configurations
        agent_1 = DialogAgent(
            name="assistant",
            sys_prompt="You are an assistant.",
            model_config_name="qwen-max",
        )
        agent_2 = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        user_agent = UserAgent()

        # Initial message from host
        x = Msg(name="host", content="I want a fancy restaurant design")

        with msghub(participants=[agent_1, agent_2]):
            # agent_1 processes the message and replies
            reply_from_agent1 = agent_1(x)
            # agent_2 is called without argument; it should pick up the last message from memory
            reply_from_agent2 = agent_2()
            # User agent can be called to continue the conversation
            user_agent()

        # Verify that agent_2's reply is a Msg with the expected content
        self.assertIsInstance(reply_from_agent2, Msg)
        self.assertEqual(reply_from_agent2.name, "painter")
        # The content is hardcoded in TextToImageAgent.reply
        self.assertEqual(reply_from_agent2.content, "This is the generated image ")
        # Verify the model was called with the content from agent_1's reply
        # In the buggy version, x would be None, causing AttributeError on x.content
        # In the fixed version, x should be the last message from memory (agent_1's reply)
        # We check that the model mock was called with a string content
        self.model_mock.assert_called_once()
        call_arg = self.model_mock.call_args[0][0]
        # The call argument should be the content of the last message in memory
        # which is the content of agent_1's reply
        self.assertIsInstance(call_arg, str)
        # The model should have been called with some content (not None)
        self.assertIsNotNone(call_arg)

    def test_text_to_image_agent_with_explicit_message(self) -> None:
        """Test TextToImageAgent works when explicitly passed a message."""
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        msg = Msg(name="user", content="Draw a cat")
        reply = agent(msg)
        self.assertIsInstance(reply, Msg)
        self.assertEqual(reply.name, "painter")
        self.model_mock.assert_called_once_with("Draw a cat")

    def test_text_to_image_agent_with_empty_memory(self) -> None:
        """Test TextToImageAgent returns empty dict when memory is empty and no message given."""
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        # Clear memory (should be empty by default)
        agent.memory.clear()
        # Call without argument; should return {} because memory is empty
        reply = agent()
        self.assertEqual(reply, {})
        self.model_mock.assert_not_called()

    def test_text_to_image_agent_sys_prompt_removed(self) -> None:
        """Test that TextToImageAgent no longer accepts sys_prompt argument."""
        # The fixed patch removes sys_prompt from __init__ signature.
        # This test ensures the constructor works without sys_prompt.
        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        # Should not raise TypeError about missing sys_prompt
        self.assertEqual(agent.name, "painter")
        # The sys_prompt attribute should be empty string (as set by super().__init__)
        self.assertEqual(agent.sys_prompt, "")[0m
