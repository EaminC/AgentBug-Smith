[32mimport unittest
from unittest.mock import patch, MagicMock
import agentscope
from agentscope.agents import TextToImageAgent, DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.msghub import msghub


class TestTextToImageAgentMsghubInteraction(unittest.TestCase):
    def setUp(self) -> None:
        # Clear any existing model configs to avoid warnings
        agentscope.init(model_configs=[], clear_all=True)

    @patch("agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper")
    def test_text_to_image_agent_receives_message_in_msghub(self, mock_model_cls):
        # Mock the model to avoid real API calls
        mock_model = MagicMock()
        mock_model.image_urls = ["http://example.com/image.jpg"]
        mock_model_cls.return_value = mock_model

        # Initialize model configs
        agentscope.init(
            model_configs=[
                {
                    "config_name": "qwen-max",
                    "model_type": "dashscope_chat",
                    "model_name": "qwen-max",
                    "api_key": "dummy_key",
                },
                {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "dummy_key",
                },
            ],
        )

        # Create agents
        agent_1 = DialogAgent(
            name="assistant",
            sys_prompt="You are an assistant.",
            model_config_name="qwen-max",
        )
        agent_2 = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
        )
        user_agent = UserAgent()

        # Simulate a message from user
        x = Msg(name="host", content="I want a fancy restaurant design")

        with msghub(participants=[agent_1, agent_2]):
            # DialogAgent processes the message
            response_1 = agent_1(x)
            # TextToImageAgent should receive the message from memory when called without args
            response_2 = agent_2()
            # UserAgent can also be called
            user_agent()

        # Verify that the TextToImageAgent's model was called with the content from the DialogAgent's response
        # In the buggy version, x is None inside reply, causing AttributeError on x.content
        # In the fixed version, x should be the last message from memory
        self.assertIsNotNone(response_2)
        # Ensure the model was called with a string content
        mock_model.assert_called_once()
        call_arg = mock_model.call_args[0][0]
        self.assertIsInstance(call_arg, str)
        self.assertGreater(len(call_arg), 0)

    def test_text_to_image_agent_sys_prompt_removed(self):
        # Verify that sys_prompt parameter is no longer accepted (as per patch)
        with self.assertRaises(TypeError):
            TextToImageAgent(
                name="painter",
                sys_prompt="This should raise error",  # This parameter should be removed
                model_config_name="wanx-v1",
            )

    @patch("agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper")
    def test_text_to_image_agent_with_empty_memory(self, mock_model_cls):
        # When memory is empty and no x provided, reply should return empty dict (fixed version)
        mock_model = MagicMock()
        mock_model_cls.return_value = mock_model

        agentscope.init(
            model_configs=[
                {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "dummy_key",
                },
            ],
        )

        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
            use_memory=True,
        )
        # Call without arguments and with empty memory
        result = agent.reply()
        # In buggy version, this would try to access x.content (x is None) -> AttributeError
        # In fixed version, it should return {}
        self.assertEqual(result, {})
        mock_model.assert_not_called()

    @patch("agentscope.models.dashscope_image_synthesis.DashScopeImageSynthesisWrapper")
    def test_text_to_image_agent_with_explicit_message(self, mock_model_cls):
        # When x is provided explicitly, it should be used
        mock_model = MagicMock()
        mock_model.image_urls = ["http://example.com/image.jpg"]
        mock_model_cls.return_value = mock_model

        agentscope.init(
            model_configs=[
                {
                    "config_name": "wanx-v1",
                    "model_type": "dashscope_image_synthesis",
                    "model_name": "wanx-v1",
                    "api_key": "dummy_key",
                },
            ],
        )

        agent = TextToImageAgent(
            name="painter",
            model_config_name="wanx-v1",
            use_memory=True,
        )
        msg = Msg(name="user", content="Draw a cat")
        result = agent.reply(msg)
        self.assertIsNotNone(result)
        mock_model.assert_called_once_with("Draw a cat")


if __name__ == "__main__":
