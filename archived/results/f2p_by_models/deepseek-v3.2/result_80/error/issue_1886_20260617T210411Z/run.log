            "generated_text": "SELECT 1",
            "cost": 0.0,
            "input_tokens": 10,
            "output_tokens": -1,
        }
        correction_pipeline = SQLCorrection()
        contexts = [
            MagicMock(page_content="CREATE TABLE t (id INT)", metadata={}),
        ]
        invalid_generation_result = {
            "sql": "SELECT * FROM invalid",
            "error": "syntax error",
        }
        # Run the pipeline without instructions
        result = correction_pipeline.run(
            contexts=contexts,
            invalid_generation_result=invalid_generation_result,
            instructions=None,
        )
        assert "generated_text" in result
        assert mock_generate.called

def test_construct_instructions():
    # Test the helper function that formats instructions
    instructions = [
        {"instruction": "First instruction"},
        {"instruction": "Second instruction"},
    ]
    formatted = construct_instructions(instructions=instructions)
    # Should return a list of strings
    assert isinstance(formatted, list)
    assert len(formatted) == 2
    assert formatted[0] == "1. First instruction"
    assert formatted[1] == "2. Second instruction"

