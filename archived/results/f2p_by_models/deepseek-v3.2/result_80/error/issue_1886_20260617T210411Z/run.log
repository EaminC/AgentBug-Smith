[32mimport pytest
from unittest.mock import MagicMock, patch, AsyncMock
from src.pipelines.generation.sql_correction import SQLCorrection
from src.pipelines.generation.utils.sql import construct_instructions
from src.providers.llm.base import BaseLLMProvider
from src.providers.llm.openai import OpenAIProvider
from src.providers.llm.dashscope import DashScopeProvider
from src.providers.llm.anthropic import AnthropicProvider
from src.pipelines.generation.utils.sql import SQLGenPostProcessor
from src.utils.trace_cost import trace_cost
import json


class MockLLMProvider(BaseLLMProvider):
    def __init__(self, response_text: str):
        super().__init__()
        self.response_text = response_text
        self.completion_called = False
        self.last_messages = None
        self.last_model_kwargs = None

    async def acompletion(self, messages, model_kwargs):
        self.completion_called = True
        self.last_messages = messages
        self.last_model_kwargs = model_kwargs
        return {"choices": [{"message": {"content": self.response_text}}]}


def test_sql_correction_prompt_includes_instructions():
    """Test that user instructions are included in the SQL correction prompt."""
    # Mock the LLM provider to capture the prompt
    mock_provider = MockLLMProvider(
        response_text='{"sql": "SELECT * FROM corrected", "summary": "fixed"}'
    )

    # Create SQLCorrection instance with mocked provider
    correction = SQLCorrection()
    correction._llm_provider = mock_provider

    # Mock the post-processor
    mock_post_processor = MagicMock(spec=SQLGenPostProcessor)
    mock_post_processor.run.return_value = {
        "sql": "SELECT * FROM corrected",
        "summary": "fixed",
    }
    correction._post_processor = mock_post_processor

    # Prepare test data
    contexts = [
        MagicMock(
            spec="Document",
            page_content="CREATE TABLE users (id INT, name TEXT)",
            metadata={"type": "table_ddl"},
        )
    ]
    invalid_generation_result = {
        "sql": "SELECT * FROM users WHERE invalid",
        "error": "syntax error",
    }
    instructions = [
        {"type": "filter", "content": "Only include active users"},
        {"type": "aggregation", "content": "Count by department"},
    ]

    # Run the correction
    result = correction.run(
        contexts=contexts,
        invalid_generation_result=invalid_generation_result,
        instructions=instructions,
    )

    # Verify the LLM provider was called
    assert mock_provider.completion_called, "LLM provider should have been called"

    # Extract the prompt that was sent to the LLM
    prompt_text = mock_provider.last_messages[0]["content"]

    # Verify instructions are present in the prompt
    assert "USER INSTRUCTIONS" in prompt_text, "Prompt should contain USER INSTRUCTIONS section"
    assert "1. Only include active users" in prompt_text, "Prompt should contain first instruction"
    assert "2. Count by department" in prompt_text, "Prompt should contain second instruction"

    # Verify the question and SQL are present
    assert "SELECT * FROM users WHERE invalid" in prompt_text
    assert "syntax error" in prompt_text

    # Verify the result
    assert result["sql"] == "SELECT * FROM corrected"
    assert result["summary"] == "fixed"


