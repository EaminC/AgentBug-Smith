def test_sql_correction_prompt_includes_instructions():
    """
    Test that user instructions are included in the SQL correction prompt.
    In buggy code, instructions are omitted; after fix, they appear.
    """
    # Mock dependencies that would call external APIs
    mock_model = Mock()
    mock_model.complete = Mock(return_value=Mock(text="SELECT 1"))
    
    # Create a mock prompt builder that returns a dict with a prompt string
    mock_prompt_builder = Mock(spec=PromptBuilder)
    # We'll capture the arguments passed to prompt_builder.run
    captured_kwargs = {}
    def capture_run(**kwargs):
        captured_kwargs.update(kwargs)
        return {"prompt": "MOCK_PROMPT"}
    mock_prompt_builder.run = capture_run
    
    # Sample data
    documents = [Mock(spec="Document")]
    invalid_generation_result = {"sql": "SELECT *", "error": "syntax error"}
    instructions = [{"content": "Use table alias"}, {"content": "Avoid SELECT *"}]
    
    # Call the prompt function with instructions
    result = prompt(
        documents=documents,
        invalid_generation_result=invalid_generation_result,
        prompt_builder=mock_prompt_builder,
        instructions=instructions,
    )
    
    # Verify that instructions were passed to prompt_builder.run
    assert "instructions" in captured_kwargs
    # construct_instructions should have been called with the instructions list
    # We can't directly assert its output because it's a helper function,
    # but we can check that the key exists and is not None.
    assert captured_kwargs["instructions"] is not None
    # The prompt function should return a dict with a cleaned prompt
    assert result == {"prompt": "MOCK_PROMPT"}

def test_sql_correction_pipeline_passes_instructions():
    """
    Test that SQLCorrection.run passes instructions to its internal steps.
    """
    # Mock the internal pipeline steps to avoid real API calls
    with patch.object(SQLCorrection, '_run') as mock_run:
        # Instantiate the pipeline
        pipeline = SQLCorrection()
        
        # Sample inputs
        contexts = [Mock()]
        invalid_generation_result = {"sql": "SELECT *", "error": "error"}
        instructions = [{"content": "Test instruction"}]
        project_id = "test_project"
        
        # Call run with instructions
        pipeline.run(
            contexts=contexts,
            invalid_generation_result=invalid_generation_result,
            instructions=instructions,
            project_id=project_id,
            use_dry_plan=False,
            allow_dry_plan_fallback=True,
        )
        
        # Verify that _run was called with instructions in inputs
        mock_run.assert_called_once()
        call_kwargs = mock_run.call_args[1]
        assert "inputs" in call_kwargs
        inputs = call_kwargs["inputs"]
        assert inputs["instructions"] == instructions
        assert inputs["invalid_generation_result"] == invalid_generation_result
        assert inputs["documents"] == contexts
        assert inputs["project_id"] == project_id

