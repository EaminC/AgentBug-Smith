from src.pipelines.generation.prompt_builder import PromptBuilder
from src.providers.llm import LLMProvider

def test_sql_correction_prompt_includes_instructions():
    # Mock the LLM provider to avoid actual API calls
    with patch.object(LLMProvider, 'generate') as mock_generate:
        mock_generate.return_value = {
            "generations": [{"text": "SELECT 1;"}],
            "llm_output": {},
            "usage": {"total_tokens": -1}
        }
        
        # Create a mock prompt builder that we can inspect
        mock_builder = MagicMock(spec=PromptBuilder)
        mock_builder.run.return_value = {"prompt": "test prompt"}
        
        # Test data
        documents = []
        invalid_generation_result = {"sql": "SELECT * FROM users;", "error": "syntax error"}
        instructions = [{"content": "Use table aliases"}, {"content": "Avoid SELECT *"}]
        
        # Call the prompt function with instructions
        with patch('src.pipelines.generation.sql_correction.prompt_builder', mock_builder):
            result = prompt(
                documents=documents,
                invalid_generation_result=invalid_generation_result,
                prompt_builder=mock_builder,
                instructions=instructions
            )
        
        # Verify construct_instructions was called with the instructions
        # Note: construct_instructions is imported and used inside prompt()
        # We'll check that mock_builder.run was called with instructions parameter
        mock_builder.run.assert_called_once()
        call_args = mock_builder.run.call_args
        
        # The key assertion: instructions should be passed to the prompt builder
        assert "instructions" in call_args.kwargs
        # construct_instructions returns a list of strings
        instructions_result = call_args.kwargs["instructions"]
        assert isinstance(instructions_result, list)
        # Should contain the instruction texts
        assert any("Use table aliases" in instr for instr in instructions_result)
        assert any("Avoid SELECT *" in instr for instr in instructions_result)

