from unittest.mock import patch, MagicMock
from src.pipelines.generation.sql_correction import SQLCorrection, prompt
from src.pipelines.generation.utils.sql import construct_instructions
from src.utils.prompt_builder import PromptBuilder
from src.providers.llm.base import BaseLLMProvider

def test_sql_correction_prompt_includes_instructions():
    # Mock dependencies that would require external connections
    # We mock the internal LLM client call inside SQLCorrection.run
    # The bug is that instructions are not passed to the prompt function.
    # In buggy code, prompt() does not receive instructions.
    # In fixed code, prompt() receives instructions via construct_instructions.
    # We'll test that the prompt generated includes the instructions section.

    # Create a mock LLM provider that returns a dummy response
    mock_llm_provider = MagicMock(spec=BaseLLMProvider)
    mock_llm_provider.generate.return_value = {
        "generated_text": "SELECT 1;",
        "cost": 0.0,
        "latency": 0.0,
    }

    # Create a mock prompt builder that returns a predictable prompt string
    mock_prompt_builder = MagicMock(spec=PromptBuilder)
    # Simulate the prompt building with instructions included
    def mock_run(**kwargs):
        instructions = kwargs.get("instructions", [])
        prompt_text = "Generated prompt"
        if instructions:
            prompt_text += "\n### USER INSTRUCTIONS ###\n1. instruction one\n2. instruction two"
        return {"prompt": prompt_text}
    mock_prompt_builder.run.side_effect = mock_run

    # Create SQLCorrection instance with mocked LLM provider
    with patch.object(SQLCorrection, '_get_llm_provider', return_value=mock_llm_provider):
        pipeline = SQLCorrection()

    # Mock the internal prompt function call to inspect its arguments
    # We'll replace the prompt function in the module with a mock to capture calls
    original_prompt = prompt
    captured_calls = []
    def mock_prompt(*args, **kwargs):
        captured_calls.append((args, kwargs))
        # Call the real prompt but with mocked prompt_builder
        # We'll replace prompt_builder in kwargs with our mock
        kwargs['prompt_builder'] = mock_prompt_builder
        return original_prompt(*args, **kwargs)

    # Prepare test data
    contexts = [MagicMock(spec=Document) for _ in range(2)]
    invalid_generation_result = {"sql": "SELECT * FROM table", "error": "syntax error"}
    instructions = [{"id": 1, "text": "instruction one"}, {"id": 2, "text": "instruction two"}]

    # Run the pipeline with instructions
    with patch('src.pipelines.generation.sql_correction.prompt', side_effect=mock_prompt):
        result = pipeline.run(
            contexts=contexts,
            invalid_generation_result=invalid_generation_result,
            instructions=instructions,
            project_id="test_project",
            use_dry_plan=False,
            allow_dry_plan_fallback=True,
        )

    # Assert that prompt was called with instructions
    assert len(captured_calls) > 0
    call_args, call_kwargs = captured_calls[0]
    # The bug: instructions not in call_kwargs in buggy code.
    # The fix: instructions should be present.
    assert "instructions" in call_kwargs
    # instructions should be a list of strings after construct_instructions
    # construct_instructions returns a list of instruction strings.
    instruction_list = call_kwargs["instructions"]
    assert isinstance(instruction_list, list)
    # In buggy code, instructions might be None or missing, causing assertion failure.
    # In fixed code, instructions will be a list of strings.
    assert len(instruction_list) == 2
    assert "instruction one" in instruction_list
    assert "instruction two" in instruction_list

    # Additionally, verify that the prompt builder received instructions
    # The prompt builder's run method should have been called with instructions
    mock_prompt_builder.run.assert_called_once()
    call_kwargs_builder = mock_prompt_builder.run.call_args[1]
    assert "instructions" in call_kwargs_builder
    assert call_kwargs_builder["instructions"] == instruction_list

    # Verify the final result contains a corrected SQL (mocked)
    assert "sql" in result
    assert result["sql"] == "SELECT 1;"

def test_sql_correction_prompt_without_instructions():
    # Test when instructions is None, prompt should still work without instructions section.
    mock_llm_provider = MagicMock(spec=BaseLLMProvider)
    mock_llm_provider.generate.return_value = {
        "generated_text": "SELECT 2;",
        "cost": 0.0,
        "latency": 0.0,
    }

    mock_prompt_builder = MagicMock(spec=PromptBuilder)
    mock_prompt_builder.run.return_value = {"prompt": "Generated prompt without instructions"}

    with patch.object(SQLCorrection, '_get_llm_provider', return_value=mock_llm_provider):
        pipeline = SQLCorrection()

    original_prompt = prompt
    captured_calls = []
    def mock_prompt(*args, **kwargs):
        captured_calls.append((args, kwargs))
        kwargs['prompt_builder'] = mock_prompt_builder
        return original_prompt(*args, **kwargs)

    contexts = [MagicMock(spec=Document) for _ in range(2)]
    invalid_generation_result = {"sql": "SELECT * FROM table", "error": "syntax error"}

    with patch('src.pipelines.generation.sql_correction.prompt', side_effect=mock_prompt):
        result = pipeline.run(
            contexts=contexts,
            invalid_generation_result=invalid_generation_result,
            instructions=None,
            project_id="test_project",
            use_dry_plan=False,
            allow_dry_plan_fallback=True,
        )

    assert len(captured_calls) > 0
    call_args, call_kwargs = captured_calls[0]
    # instructions should be present but empty list after construct_instructions
    assert "instructions" in call_kwargs
    instruction_list = call_kwargs["instructions"]
    assert isinstance(instruction_list, list)
    assert len(instruction_list) == 0

