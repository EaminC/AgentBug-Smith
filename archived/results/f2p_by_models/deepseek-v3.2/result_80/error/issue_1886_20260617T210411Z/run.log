def test_sql_correction_prompt_includes_instructions():
    """Test that user instructions are passed to the SQL correction prompt."""
    # Mock the LLM provider to avoid real API calls
    mock_llm_provider = MagicMock(spec=LLMProvider)
    mock_llm_provider.generate.return_value = "SELECT * FROM corrected_table;"

    # Create a SQLCorrection instance with mocked LLM
    sql_correction = SQLCorrection(llm_provider=mock_llm_provider)

    # Sample inputs
    contexts = [
        MagicMock(spec='Document', content="CREATE TABLE users (id INT);"),
        MagicMock(spec='Document', content="CREATE TABLE orders (user_id INT);"),
    ]
    invalid_generation_result = {
        "sql": "SELECT * FROM non_existent_table;",
        "error": "relation \"non_existent_table\" does not exist",
    }
    instructions = [
        {"instruction": "Use only tables that exist in the schema."},
        {"instruction": "Join users and orders on user_id."},
    ]

    # Run the correction pipeline with instructions
    result = sql_correction.run(
        contexts=contexts,
        invalid_generation_result=invalid_generation_result,
        instructions=instructions,
        project_id="test_project",
        use_dry_plan=False,
        allow_dry_plan_fallback=True,
    )

    # Verify the result structure
    assert "corrected_sql" in result
    assert isinstance(result["corrected_sql"], str)

    # Verify that the LLM provider's generate was called with a prompt containing instructions
    mock_llm_provider.generate.assert_called_once()
    call_args = mock_llm_provider.generate.call_args
    prompt_text = call_args.kwargs.get('prompt', '')
    
    # Check that instructions appear in the prompt
    assert "USER INSTRUCTIONS" in prompt_text
    assert "1. Use only tables that exist in the schema." in prompt_text
    assert "2. Join users and orders on user_id." in prompt_text

