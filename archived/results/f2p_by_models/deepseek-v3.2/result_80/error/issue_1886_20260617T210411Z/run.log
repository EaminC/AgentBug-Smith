def test_sql_correction_prompt_includes_instructions():
    """Test that user instructions are included in the SQL correction prompt."""
    # Mock dependencies
    mock_prompt_builder = Mock(spec=PromptBuilder)
    mock_prompt_builder.run.return_value = {"prompt": "dummy prompt"}
    
    # Sample data
    documents = [Mock(spec=Document)]
    invalid_generation_result = {"sql": "SELECT * FROM users", "error": "syntax error"}
    instructions = [{"instruction": "Use proper syntax"}, {"instruction": "Avoid SELECT *"}]
    
    # Call the prompt function with instructions
    with patch('src.pipelines.generation.sql_correction.construct_instructions') as mock_construct:
        mock_construct.return_value = ["1. Use proper syntax", "2. Avoid SELECT *"]
        result = prompt(
            documents=documents,
            invalid_generation_result=invalid_generation_result,
            prompt_builder=mock_prompt_builder,
            instructions=instructions,
        )
    
    # Verify construct_instructions was called with the correct arguments
    mock_construct.assert_called_once_with(instructions=instructions)
    
    # Verify prompt_builder.run was called with instructions in the context
    mock_prompt_builder.run.assert_called_once_with(
        documents=documents,
        invalid_generation_result=invalid_generation_result,
        instructions=["1. Use proper syntax", "2. Avoid SELECT *"],
    )
    
    # Verify the result
    assert result == {"prompt": "dummy prompt"}

