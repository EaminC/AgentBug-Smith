[32mimport pytest
from unittest.mock import patch, MagicMock, ANY
from src.pipelines.generation.sql_correction import SQLCorrection, prompt
from src.pipelines.generation.utils.sql import construct_instructions
from src.pipelines.generation.utils.prompt_builder import PromptBuilder
from src.providers.base import BaseProvider
from langchain_core.documents import Document
import json


class MockProvider(BaseProvider):
    def __init__(self):
        self.model = "mock-model"
        self.model_kwargs = {}

    def invoke(self, prompt, **kwargs):
        # Return a mock response that includes the prompt to verify instructions
        return {"content": prompt, "usage": {"total_tokens": 10}}


def test_sql_correction_prompt_includes_instructions():
    """Test that user instructions are included in the SQL correction prompt."""
    # Mock the LLM call to capture the prompt
    mock_provider = MockProvider()
    
    # Create a simple prompt builder that uses the template from sql_correction.py
    # We'll directly test the prompt function
    prompt_builder = PromptBuilder(
        template_file="sql_correction_user_prompt_template",
        template_dir="src/pipelines/generation/templates"
    )
    
    # Mock documents
    documents = [
        Document(page_content="CREATE TABLE users (id INT, name TEXT)", metadata={"type": "table_ddl"}),
        Document(page_content="CREATE TABLE orders (id INT, user_id INT, amount DECIMAL)", metadata={"type": "table_ddl"})
    ]
    
    # Invalid generation result
    invalid_generation_result = {
        "sql": "SELECT * FROM users WHERE name = 'John'",
        "error": "column 'name' does not exist"
    }
    
    # Test without instructions
    result_without = prompt(
        documents=documents,
        invalid_generation_result=invalid_generation_result,
        prompt_builder=prompt_builder,
        instructions=None
    )
    
    # Test with instructions
    instructions = [
        {"instruction": "Use table alias when joining tables"},
        {"instruction": "Always include WHERE clause for filtering"}
    ]
    
    result_with = prompt(
        documents=documents,
        invalid_generation_result=invalid_generation_result,
        prompt_builder=prompt_builder,
        instructions=instructions
    )
    
    # Verify instructions are NOT in the prompt when instructions=None
    prompt_without = result_without["prompt"]
    assert "USER INSTRUCTIONS" not in prompt_without, "USER INSTRUCTIONS should not appear when instructions is None"
    
    # Verify instructions ARE in the prompt when instructions provided
    prompt_with = result_with["prompt"]
    assert "USER INSTRUCTIONS" in prompt_with, "USER INSTRUCTIONS should appear in prompt when instructions provided"
    
    # Verify each instruction appears
    for instruction in instructions:
        assert instruction["instruction"] in prompt_with, f"Instruction '{instruction['instruction']}' should be in prompt"
    
    # Verify the format matches the template
    assert "1. Use table alias when joining tables" in prompt_with
    assert "2. Always include WHERE clause for filtering" in prompt_with


def test_sql_correction_pipeline_includes_instructions():
    """Test that SQLCorrection.run() passes instructions to the prompt."""
    # Create SQLCorrection instance with mocked components
    correction = SQLCorrection(
        provider=MockProvider(),
        prompt_builder=PromptBuilder(
            template_file="sql_correction_user_prompt_template",
            template_dir="src/pipelines/generation/templates"
        )
    )
    
    # Mock the internal _run method to capture its inputs
    original_run = correction._run
    
    captured_inputs = None
    def mock_run(inputs, **kwargs):
        nonlocal captured_inputs
        captured_inputs = inputs
        # Return a mock result to avoid actual execution
        return {"corrected_sql": "SELECT * FROM users", "error": None}
    
    correction._run = mock_run
    
    # Test data
    contexts = [
        Document(page_content="CREATE TABLE users (id INT, name TEXT)", metadata={"type": "table_ddl"})
    ]
    invalid_generation_result = {
        "sql": "SELECT * FROM users",
        "error": "some error"
    }
    instructions = [
        {"instruction": "Test instruction"}
    ]
    
    # Call run with instructions
    result = correction.run(
        contexts=contexts,
        invalid_generation_result=invalid_generation_result,
        instructions=instructions,
        project_id="test-project"
    )
    
    # Verify instructions were passed to _run
    assert captured_inputs is not None, "_run should have been called"
    assert "instructions" in captured_inputs, "instructions should be in inputs to _run"
    assert captured_inputs["instructions"] == instructions, f"Expected instructions {instructions}, got {captured_inputs['instructions']}"
    
    # Restore original method
    correction._run = original_run


