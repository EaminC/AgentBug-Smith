        invalid_generation_result = {
            "sql": "SELECT * FROM invalid",
            "error": "syntax error",
        }
        documents = [
            MagicMock(page_content="CREATE TABLE t (id INT)", metadata={}),
        ]
        prompt_builder = PromptBuilder(template_name="sql_correction_user_prompt")
        result = prompt(
            documents=documents,
            invalid_generation_result=invalid_generation_result,
            prompt_builder=prompt_builder,
            instructions=None,
        )
        prompt_text = result["prompt"]
        # When instructions is None, the USER INSTRUCTIONS section should not appear
        assert "USER INSTRUCTIONS" not in prompt_text

def test_sql_correction_pipeline_run_includes_instructions():
    # Mock the internal model client to avoid real API calls
    with patch.object(ModelProvider, 'generate') as mock_generate:
        mock_generate.return_value = {
            "generated_text": "SELECT 1",
            "cost": 0.0,
            "input_tokens": 10,
            "output_tokens": -1,
        }
        correction_pipeline = SQLCorrection()
        contexts = [
            MagicMock(page_content="CREATE TABLE t (id INT)", metadata={}),
        ]
        invalid_generation_result = {
            "sql": "SELECT * FROM invalid",
            "error": "syntax error",
        }
        instructions = [
            {"instruction": "Test instruction"},
        ]
        # Run the pipeline with instructions
        # This will call the real run method, which internally uses the prompt function
        # We need to mock the model provider's generate method to avoid real API calls
        result = correction_pipeline.run(
            contexts=contexts,
            invalid_generation_result=invalid_generation_result,
            instructions=instructions,
        )
        # The result should contain the corrected SQL
        assert "generated_text" in result
        # Ensure the mock was called (meaning the pipeline attempted to generate)
        assert mock_generate.called

