[32mFROM python:3.12-slim AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the entire repository
COPY . .

# Upgrade packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Detect src layout to decide whether to editable install
# Check if src directory exists or tests import via src.
RUN if [ -d "src" ] || (find tests -name "*.py" -type f 2>/dev/null | xargs grep -l "^[[:space:]]*from src\." 2>/dev/null | head -1) || (find tests -name "*.py" -type f 2>/dev/null | xargs grep -l "^[[:space:]]*import src\." 2>/dev/null | head -1); then \
        echo "src layout detected, skipping editable install"; \
        # Install dependencies from pyproject.toml using poetry (since poetry.lock exists)
        if [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
            pip install poetry && \
            poetry config virtualenvs.create false && \
            poetry install --no-interaction --no-ansi --without eval; \
        else \
            # Fallback: install via pip (should not happen given repo)
            pip install .; \
        fi; \
        # Install test dependencies unconditionally
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
        # Set PYTHONPATH to ensure src imports work
        ENV PYTHONPATH=/app; \
    else \
        echo "No src layout, performing editable install"; \
        # Install dependencies from pyproject.toml using poetry (since poetry.lock exists)
        if [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
            pip install poetry && \
            poetry config virtualenvs.create false && \
            poetry install --no-interaction --no-ansi --without eval; \
        else \
            # Fallback: install via pip (should not happen given repo)
            pip install -e .; \
        fi; \
        # Install test dependencies unconditionally
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Runtime stage
FROM python:3.12-slim

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
# Copy the application code
COPY --from=builder /app /app

# Set Forge environment variables in runtime
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Expose port (inferred from typical service)
EXPOSE 8000

# Default command (inferred from project structure: likely a web service)
CMD ["python", "-m", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"][0m
