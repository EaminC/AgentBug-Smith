def test_sql_correction_prompt_includes_instructions():
    # Mock the PromptBuilder to capture the template context
    mock_prompt_builder = MagicMock(spec=PromptBuilder)
    mock_prompt_builder.run = MagicMock()

    # Simulate the prompt builder returning a dict with a prompt key
    mock_prompt_builder.run.return_value = {"prompt": "mocked prompt"}

    # Test data
    documents = [MagicMock()]
    invalid_generation_result = {"sql": "SELECT * FROM users", "error": "syntax error"}
    instructions = [{"instruction": "Use only active users"}, {"instruction": "Filter by date"}]

    # Call the prompt function with instructions
    with patch('src.pipelines.generation.sql_correction.prompt_builder', mock_prompt_builder):
        result = prompt(
            documents=documents,
            invalid_generation_result=invalid_generation_result,
            prompt_builder=mock_prompt_builder,
            instructions=instructions,
        )

    # Ensure prompt builder was called with the correct arguments
    mock_prompt_builder.run.assert_called_once()
    call_kwargs = mock_prompt_builder.run.call_args[1]

    # Check that instructions were passed to the prompt builder
    assert "instructions" in call_kwargs
    # The instructions should be the result of construct_instructions
    expected_instructions = construct_instructions(instructions=instructions)
    assert call_kwargs["instructions"] == expected_instructions

