def test_sql_correction_prompt_template():
    """Test that the prompt template includes the instructions section when instructions are provided."""
    # This test directly tests the prompt template rendering.
    # We'll use the actual prompt function and mock the prompt builder's template.
    # But the prompt function uses a PromptBuilder instance that we can't easily mock.
    # Instead, we can test the SQLCorrection pipeline's prompt building by patching the model provider.
    
    # We'll create a temporary prompt template file that matches the one in the code.
    # However, the template is defined in the module as a string.
    # We can import the template from the module if it's exposed.
    # Let's check: the template is defined as `sql_correction_user_prompt_template` in the module.
    from src.pipelines.generation.sql_correction import sql_correction_user_prompt_template
    
    # The template is a Jinja2 template string.
    # We can render it using the PromptBuilder, but that's heavy.
    # Instead, we'll write a simple test that checks the template string contains the instructions block.
    # The fixed template should have the instructions block.
    assert "### USER INSTRUCTIONS ###" in sql_correction_user_prompt_template, \
        "Template missing USER INSTRUCTIONS section"
    
    # Also check that the template uses the instructions variable.
    assert "{% if instructions %}" in sql_correction_user_prompt_template, \
        "Template missing instructions conditional"
    
    # Now, we need to test that when instructions are provided, they appear in the rendered prompt.
    # We'll create a mock PromptBuilder that uses the actual template.
    from jinja2 import Template
    template = Template(sql_correction_user_prompt_template)
    
    # Render with instructions
    rendered_with = template.render(
        documents=[{"content": "doc1"}],
        invalid_generation_result={"sql": "SELECT 1;", "error": "error"},
        instructions=[{"text": "instruction1"}, {"text": "instruction2"}]
    )
    assert "### USER INSTRUCTIONS ###" in rendered_with
    assert "1. instruction1" in rendered_with
    assert "2. instruction2" in rendered_with
    
    # Render without instructions
    rendered_without = template.render(
        documents=[{"content": "doc1"}],
        invalid_generation_result={"sql": "SELECT 1;", "error": "error"},
        instructions=None
    )
    assert "### USER INSTRUCTIONS ###" not in rendered_without
    
    # This test passes in both buggy and fixed code? 
    # In buggy code, the template does not have the instructions block.
    # So the assertion will fail, causing the test to fail (which is what we want).
    # In fixed code, the template has the block, so the test passes.


def test_instructions_passed_to_prompt_builder():
    """Integration test: instructions are passed from SQLCorrection.run to prompt builder."""
    # Mock the model provider to avoid API calls
    with patch('src.pipelines.generation.sql_correction.ModelProvider') as MockModelProvider:
        mock_model = MagicMock()
        mock_model.generate.return_value = {"generation": "SELECT 1;"}
        MockModelProvider.return_value = mock_model
        
        # Create SQLCorrection instance
        correction = SQLCorrection()
        
        # Replace the internal prompt builder with a mock
        mock_pb = MagicMock(spec=PromptBuilder)
        mock_pb.run.return_value = {"prompt": "test prompt"}
        correction._prompt_builder = mock_pb
        
        # Prepare test data
        contexts = [{"content": "CREATE TABLE users (id INT);"}]
        invalid_generation_result = {"sql": "SELECT * FROM users;", "error": "syntax error"}
        instructions = [{"text": "Use only column 'id'"}]
        
        # Check if the run method accepts instructions parameter
        import inspect
        run_sig = inspect.signature(correction.run)
        if 'instructions' in run_sig.parameters:
            # Fixed code: call with instructions
            result = correction.run(
                contexts=contexts,
                invalid_generation_result=invalid_generation_result,
                instructions=instructions
            )
            # Verify that prompt builder was called with instructions
            mock_pb.run.assert_called_once()
            call_kwargs = mock_pb.run.call_args[1]
            assert 'instructions' in call_kwargs, "instructions not passed to prompt builder"
            # The instructions should be constructed via construct_instructions
            expected = construct_instructions(instructions=instructions)
