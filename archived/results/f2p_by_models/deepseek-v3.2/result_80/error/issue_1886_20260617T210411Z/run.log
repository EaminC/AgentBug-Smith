    ask_service._instruction_service = Mock()
    ask_service._instruction_service.get_instructions_by_project_id.return_value = [
        {"instruction": "Use proper syntax"}
    ]
    
    # Mock the internal _generate_sql method to return a failed dry run
    ask_service._generate_sql = Mock(return_value=(
        Mock(),
        {"sql": "SELECT * FROM users", "error": "dry run failed"},
        True  # dry_run_failed
    ))
    
    # Mock the internal _handle_successful_generation to avoid side effects
    ask_service._handle_successful_generation = Mock()
    
    # Call ask with a request that triggers SQL correction
    from src.web.v1.schemas.ask import AskRequest
    request = AskRequest(
        question="test question",
        project_id="test_project",
        session_id="test_session",
        use_dry_plan=False,
    )
    
    with patch('src.web.v1.services.ask.SQLCorrection') as mock_sql_correction_class:
        mock_sql_correction_class.return_value = mock_sql_correction
        result = ask_service.ask(request)
    
    # Verify that sql_correction.run was called with instructions
    mock_sql_correction.run.assert_called_once()
    call_kwargs = mock_sql_correction.run.call_args[1]
    assert "instructions" in call_kwargs
    assert call_kwargs["instructions"] == [{"instruction": "Use proper syntax"}]

