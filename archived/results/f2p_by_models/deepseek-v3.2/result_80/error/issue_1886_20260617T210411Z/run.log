    mock_provider = MockProvider()
    
    # Create SQLCorrection instance with mocked provider
    correction = SQLCorrection(provider=mock_provider)
    
    # Mock the internal _run method to capture inputs
    original_run = correction._run
    captured_inputs = None
    def mock_run(inputs):
        nonlocal captured_inputs
        captured_inputs = inputs
        # Simulate a successful generation
        return {"generation": {"sql": "SELECT 1", "error": None}}
    
    correction._run = mock_run
    
    # Act
    result = correction.run(
        contexts=contexts,
        invalid_generation_result=invalid_generation_result,
        instructions=instructions,
        project_id="test_project",
        use_dry_plan=False,
        allow_dry_plan_fallback=True
    )
    
    # Assert: instructions were passed to the pipeline
    assert captured_inputs is not None
    assert "instructions" in captured_inputs
    assert captured_inputs["instructions"] == instructions
    assert captured_inputs["invalid_generation_result"] == invalid_generation_result
    assert captured_inputs["documents"] == contexts
    assert captured_inputs["project_id"] == "test_project"
    assert result["generation"]["sql"] == "SELECT 1"

