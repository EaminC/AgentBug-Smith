def test_sql_correction_prompt_includes_instructions():
    # Arrange
    documents = [MagicMock(content="CREATE TABLE users (id INT)", metadata={"source": "test"})]
    invalid_generation_result = {"sql": "SELECT * FROM users", "error": "syntax error"}
    instructions = [{"instruction": "Use only public tables"}, {"instruction": "Avoid SELECT *"}]
    
    # Mock the prompt builder to capture the template rendering
    mock_prompt_builder = MagicMock(spec=PromptBuilder)
    mock_prompt_builder.run.return_value = {"prompt": "mocked prompt"}
    
    # Act
    with patch('src.pipelines.generation.sql_correction.PromptBuilder', return_value=mock_prompt_builder):
        result = prompt(
            documents=documents,
            invalid_generation_result=invalid_generation_result,
            prompt_builder=mock_prompt_builder,
            instructions=instructions
        )
    
    # Assert: prompt builder was called with instructions
    mock_prompt_builder.run.assert_called_once_with(
        documents=documents,
        invalid_generation_result=invalid_generation_result,
        instructions=construct_instructions(instructions=instructions)
    )
    assert result == {"prompt": "mocked prompt"}

