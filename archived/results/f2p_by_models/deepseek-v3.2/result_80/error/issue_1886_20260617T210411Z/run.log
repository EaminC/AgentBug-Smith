[32mimport pytest
from unittest.mock import patch, MagicMock
from src.pipelines.generation.sql_correction import SQLCorrection, prompt
from src.pipelines.generation.utils.sql import construct_instructions
from src.pipelines.generation.utils.prompt_builder import PromptBuilder
from src.providers.model import ModelProvider

def test_sql_correction_prompt_includes_instructions():
    # Mock the internal model client to avoid real API calls
    with patch.object(ModelProvider, 'generate') as mock_generate:
        mock_generate.return_value = {
            "generated_text": "SELECT 1",
            "cost": 0.0,
            "input_tokens": 10,
            "output_tokens": -1,
        }
        # Create a dummy invalid generation result
        invalid_generation_result = {
            "sql": "SELECT * FROM invalid",
            "error": "syntax error",
        }
        # Create dummy documents
        documents = [
            MagicMock(page_content="CREATE TABLE t (id INT)", metadata={}),
        ]
        # Define instructions
        instructions = [
            {"instruction": "Use only column 'id'"},
            {"instruction": "Do not use WHERE clause"},
        ]
        # Build the prompt using the real prompt function
        prompt_builder = PromptBuilder(template_name="sql_correction_user_prompt")
        result = prompt(
            documents=documents,
            invalid_generation_result=invalid_generation_result,
            prompt_builder=prompt_builder,
            instructions=instructions,
        )
        # The prompt should contain the instructions
        prompt_text = result["prompt"]
        assert "USER INSTRUCTIONS" in prompt_text
        assert "1. Use only column 'id'" in prompt_text
        assert "2. Do not use WHERE clause" in prompt_text

def test_sql_correction_prompt_without_instructions():
    # Mock the internal model client to avoid real API calls
    with patch.object(ModelProvider, 'generate') as mock_generate:
        mock_generate.return_value = {
            "generated_text": "SELECT 1",
            "cost": 0.0,
            "input_tokens": 10,
            "output_tokens": -1,
