def test_sql_correction_pipeline_includes_instructions():
    # Arrange
    contexts = [MagicMock(content="CREATE TABLE users (id INT)", metadata={"source": "test"})]
    invalid_generation_result = {"sql": "SELECT * FROM users", "error": "syntax error"}
    instructions = [{"instruction": "Use only public tables"}]
    
