[32mFROM python:3.12-slim AS test_builder

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Set required Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Determine if src/ layout or tests import via src.
# Check for src directory and grep tests for imports
RUN if [ -d "src" ] || (find tests -name "*.py" -type f 2>/dev/null | xargs grep -l "^\s*from src\.\|^\s*import src\." 2>/dev/null | grep -q .); then \
        echo "src layout detected, skipping editable install"; \
        # Install dependencies from pyproject.toml (if requirements.txt exists, use it as fallback)
        if [ -f "requirements.txt" ]; then \
            pip install -r requirements.txt; \
        fi; \
        # Install core dependencies from pyproject.toml (non-editable)
        pip install .; \
        # Install test dependencies unconditionally
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
        # Set PYTHONPATH to ensure imports work
        ENV PYTHONPATH=/app; \
    else \
        echo "No src layout detected, performing editable install"; \
        # Install dependencies from pyproject.toml (if requirements.txt exists, use it as fallback)
        if [ -f "requirements.txt" ]; then \
            pip install -r requirements.txt; \
        fi; \
        # Install project in editable mode
        pip install -e .; \
        # Install test dependencies unconditionally
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"][0m
