[32m# branch: python/requirements.txt
FROM python:3.11-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set Python environment variables
ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/venv/bin:$PATH" \
    VIRTUAL_ENV="/venv"

# Set environment variables for Forge API compatibility
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"

WORKDIR /app

# Install system dependencies including build tools
RUN apt-get update && apt-get install -y \
    curl wget git \
    libxml2-dev libxslt1-dev python3-dev gcc g++ \
    libffi-dev libssl-dev libyaml-dev \
    pkg-config libblas-dev liblapack-dev \
    && rm -rf /var/lib/apt/lists/*

# Create and activate virtual environment
RUN python -m venv /venv

# Upgrade pip and install setuptools/wheel with compatible versions
RUN pip install --upgrade pip wheel "setuptools==67.8.0"

# Copy entire repository
COPY . .

# Install PyYAML first with wheel to avoid source build issues
RUN pip install --break-system-packages "pyyaml==6.0.1"

# Install dependencies from requirements.txt (excluding PyYAML which we already installed)
# Also exclude spacy for now, we'll handle it separately
RUN if [ -f "requirements.txt" ]; then \
    # Create a modified requirements file without PyYAML and spacy lines
    grep -v "^pyyaml==" requirements.txt | grep -v "^spacy>=" > /tmp/requirements_filtered.txt; \
    pip install --break-system-packages -r /tmp/requirements_filtered.txt; \
    fi

# Install spacy separately with explicit version compatible with Python 3.11
RUN pip install --break-system-packages "spacy==3.7.2" "thinc==8.2.3"

# Install the spacy model
RUN pip install --break-system-packages https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.7.0/en_core_web_sm-3.7.0-py3-none-any.whl

# Install additional test dependencies not in requirements.txt
RUN pip install --break-system-packages \
    pytest pytest-mock pytest-asyncio pytest-cov anyio \
    pytest-xdist pytest-timeout pytest-benchmark pytest-integration \
    pytest-recording vcrpy asynctest litellm mem0ai

# Install hatchling for build system
RUN pip install --break-system-packages hatchling

# Install the project in development mode
RUN pip install --break-system-packages -e .

# Verify installation by importing key modules
RUN python -c "import sys; print(f'Python {sys.version}'); \
try: \
    import pkg_resources; \
    print('pkg_resources: OK'); \
    import pytest; \
    print('pytest: OK'); \
    import autogpt; \
    print('autogpt: OK'); \
    import yaml; \
    print(f'PyYAML: OK (version {yaml.__version__})'); \
    import openai; \
    print('openai: OK'); \
    import spacy; \
    print('spacy: OK'); \
    nlp = spacy.load('en_core_web_sm'); \
    print('spacy model loaded: OK'); \
    print('All imports successful'); \
except ImportError as e: \
    print(f'Import error: {e}'); \
    import traceback; \
    traceback.print_exc(); \
    sys.exit(1)"

# Final command (required for test harness)
CMD ["/bin/bash"][0m
