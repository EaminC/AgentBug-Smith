[32m# branch: python/requirements.txt
FROM python:3.11-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set additional environment variables for Forge API compatibility
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"

# Python environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=off \
    PYTHONPATH=/app

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl wget git \
    gcc g++ \
    libxml2-dev libxslt1-dev \
    libffi-dev libssl-dev \
    libyaml-dev \
    libpq-dev \
    build-essential \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Create README.md for hatchling build system since it's excluded by .dockerignore
RUN echo "# AutoGPT\n\nAn open-source attempt to make GPT-4 autonomous" > README.md

# Upgrade pip and install setuptools/wheel
RUN python -m pip install --upgrade pip wheel "setuptools<81.0.0"

# Create requirements without spacy to avoid compilation issues
RUN grep -v "^en-core-web-sm" requirements.txt | grep -v "^spacy>=" > /tmp/requirements_no_spacy.txt

# Install dependencies without spacy
RUN pip install --break-system-packages -r /tmp/requirements_no_spacy.txt

# Install pyyaml with compatible version
RUN pip install --break-system-packages "pyyaml>=6.0.1,<7.0"

# Try to install spacy with pre-built wheels to avoid compilation
# First install thinc with a version that has pre-built wheels
RUN pip install --break-system-packages "thinc==8.1.10" || echo "thinc installation failed, continuing..."
# Then try to install spacy (optional, skip if fails)
RUN pip install --break-system-packages "spacy>=3.0.0,<4.0.0" || echo "spacy installation failed, continuing..."

# Install AI SDKs for framework compatibility
RUN pip install --break-system-packages \
    litellm \
    mem0ai \
    "anthropic>=0.25.0"

# Install test dependencies
RUN pip install --break-system-packages \
    pytest \
    asynctest \
    pytest-asyncio \
    pytest-benchmark \
    pytest-cov \
    pytest-integration \
    pytest-mock \
    vcrpy \
    pytest-recording \
    pytest-xdist

# Install the project in development mode
RUN pip install --break-system-packages -e .

# Verify installation (skip spacy check if not installed)
RUN python -c "\
import sys; print(f'Python {sys.version}'); \
import pytest; print('pytest: OK'); \
try: import autogpt; print('autogpt: OK'); except Exception as e: print(f'autogpt import failed: {e}'); \
try: import openai; print(f'openai: {openai.__version__}'); except Exception as e: print(f'openai import failed: {e}'); \
try: import yaml; print(f'PyYAML: {yaml.__version__}'); except Exception as e: print(f'PyYAML import failed: {e}'); \
try: import tiktoken; print('tiktoken: OK'); except Exception as e: print(f'tiktoken warning: {e}'); \
try: import orjson; print('orjson: OK'); except Exception as e: print(f'orjson warning: {e}'); \
try: import spacy; print('spacy: OK'); except ImportError: print('spacy: NOT INSTALLED (skipped due to compilation issues)'); \
print('Installation verification complete')"

# Final command (required for test harness)
CMD ["/bin/bash"][0m
