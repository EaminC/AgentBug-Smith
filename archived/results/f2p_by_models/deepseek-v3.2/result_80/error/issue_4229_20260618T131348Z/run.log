FROM python:3.11-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Install system dependencies for browsers, utilities, and compilation
RUN apt-get update && apt-get install -y \
    chromium-driver firefox-esr ca-certificates curl jq wget git \
    libxml2-dev libxslt1-dev python3-dev gcc g++ \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="$PATH:/root/.local/bin" \
    FORGE_API_KEY=forge-key \
    FORGE_BASE_URL=https://api.forge.tensorblock.co/v1

WORKDIR /app

# Copy entire repository
COPY . .

# Upgrade pip and wheel, but downgrade setuptools to <=81.0.0 to fix PyYAML build issue
RUN python -m pip install --upgrade pip wheel && \
    python -m pip install "setuptools<=81.0.0"

# Download spacy model before installing spacy to avoid URL issues during build
RUN wget -q https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.5.0/en_core_web_sm-3.5.0-py3-none-any.whl -O /tmp/en_core_web_sm-3.5.0-py3-none-any.whl

# Install dependencies from requirements.txt with workaround for compilation issues
RUN if [ -f "requirements.txt" ]; then \
    # First install PyYAML separately with no build isolation to avoid setuptools conflict
    pip install --break-system-packages --no-build-isolation pyyaml==6.0 || \
    pip install --break-system-packages --no-deps pyyaml==6.0 || \
    pip install --break-system-packages --only-binary=:all: pyyaml==6.0; \
    # Install packages that might have compilation issues with pre-built wheels
    pip install --break-system-packages --only-binary=:all: numpy; \
    # Install spacy with pre-built wheels to avoid thinc compilation issues
    pip install --break-system-packages --only-binary=:all: spacy>=3.0.0,<4.0.0; \
    # Install the downloaded spacy model
    pip install --break-system-packages /tmp/en_core_web_sm-3.5.0-py3-none-any.whl; \
    # Then install remaining requirements, skipping spacy since we already installed it
    grep -v "spacy" requirements.txt | grep -v "en-core-web-sm" > /tmp/requirements_filtered.txt; \
    pip install --break-system-packages -r /tmp/requirements_filtered.txt; \
    fi

# Install test dependencies unconditionally (including those from requirements.txt test section)
RUN pip install --break-system-packages pytest pytest-mock pytest-asyncio pytest-cov anyio \
    litellm pytest-xdist pytest-timeout mem0ai \
    pytest-benchmark pytest-integration pytest-recording vcrpy asynctest

# Install the AutoGPT project itself (editable install)
# Note: This project uses hatchling build system per pyproject.toml
RUN pip install --break-system-packages -e .

# Set Forge environment variables (required)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0
ENV ANTHROPIC_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key

# Preflight import check to verify installation
RUN python -c 'import pkg_resources, pytest; import autogpt; print("preflight ok")'

# Final command (required for test harness)
CMD ["/bin/bash"][0m
