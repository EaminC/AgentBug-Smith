[32m# branch: python/requirements.txt
FROM python:3.11-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set additional environment variables for Forge API compatibility
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"

# Python environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=off \
    PYTHONPATH=/app

WORKDIR /app

# Install system dependencies including build tools for thinc/spacy compilation
RUN apt-get update && apt-get install -y \
    curl wget git \
    libxml2-dev libxslt1-dev python3-dev gcc g++ \
    libffi-dev libssl-dev libyaml-dev \
    libpq-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Upgrade pip and install setuptools/wheel
RUN python -m pip install --upgrade pip wheel "setuptools<=81.0.0"

# Create requirements.txt without problematic dependencies
# Remove spacy and en-core-web-sm temporarily to avoid compilation issues
RUN grep -v "spacy" requirements.txt | grep -v "en-core-web-sm" > requirements_no_spacy.txt 2>/dev/null || cp requirements.txt requirements_no_spacy.txt

# Install core dependencies from modified requirements.txt
RUN pip install --break-system-packages -r requirements_no_spacy.txt

# Install spacy separately with specific version compatible with Python 3.11
# Use --no-build-isolation to avoid Cython compilation issues
RUN pip install --break-system-packages "spacy==3.5.0" --no-build-isolation || \
    pip install --break-system-packages "spacy==3.5.0"

# Install en-core-web-sm model
RUN pip install --break-system-packages https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.5.0/en_core_web_sm-3.5.0-py3-none-any.whl

# Install test dependencies
RUN pip install --break-system-packages \
    pytest pytest-mock pytest-asyncio pytest-cov anyio \
    pytest-xdist pytest-timeout pytest-benchmark pytest-integration \
    pytest-recording vcrpy asynctest

# Install AI SDKs for framework compatibility (AutoGPT)
RUN pip install --break-system-packages \
    litellm \
    mem0ai \
    "anthropic>=0.25.0" \
    "openai>=0.27.2"

# Install the project in development mode for imports
RUN pip install --break-system-packages -e .

# Verify installation
RUN python -c "import sys; print(f'Python {sys.version}'); import pkg_resources; print('pkg_resources: OK'); import pytest; print('pytest: OK'); import autogpt; print('autogpt: OK'); import yaml; print(f'PyYAML: OK'); import openai; print(f'openai: OK'); import spacy; print('spacy: OK'); nlp = spacy.load('en_core_web_sm'); print('spacy model loaded: OK'); import litellm; print('litellm: OK'); print('All imports successful')"

# Final command (required for test harness)
CMD ["/bin/bash"][0m
