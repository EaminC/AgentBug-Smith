  42 |     # Install dependencies from requirements.txt with workaround for PyYAML
  43 | >>> RUN if [ -f "requirements.txt" ]; then \
  44 | >>>     # First install PyYAML separately with no build isolation to avoid setuptools conflict
  45 | >>>     pip install --break-system-packages --no-build-isolation pyyaml==6.0 || \
  46 | >>>     pip install --break-system-packages --no-deps pyyaml==6.0 || \
  47 | >>>     pip install --break-system-packages --only-binary=:all: pyyaml==6.0; \
