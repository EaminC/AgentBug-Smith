[32mFROM python:3.10-slim AS test_builder

# Install system dependencies for browsers and utilities
RUN apt-get update && apt-get install -y \
    chromium-driver firefox-esr ca-certificates curl jq wget git \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV PIP_NO_CACHE_DIR=yes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="$PATH:/root/.local/bin"

WORKDIR /app

# Copy entire repository
COPY . .

# Detect src layout or imports of src.* to decide editable install
# Assumption: if src/ directory exists, we treat as src-layout
RUN if [ -d "src" ] || (find . -name "*.py" -type f -exec grep -l "^[[:space:]]*from src\." {} \; 2>/dev/null | head -1) ; then \
    echo "src layout detected - skipping editable install, setting PYTHONPATH" && \
    export SKIP_EDITABLE=1; \
    else \
    echo "no src layout detected - will perform editable install"; \
    fi

# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies based on available files
# requirements.txt exists -> install it, then conditionally install project
RUN if [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt; \
    fi

# Install test dependencies unconditionally
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Conditionally install project editable based on src layout
RUN if [ -z "${SKIP_EDITABLE}" ]; then \
    pip install -e .; \
    else \
    echo "Skipping editable install for src layout"; \
    fi

# Set PYTHONPATH for src layout (ensures tests can import from /app)
ENV PYTHONPATH=/app

# Set Forge environment variables (required)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Final command (required)
CMD ["/bin/bash"][0m
