RUN apt update && apt install -y curl && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && apt install -y nodejs && npm install -g @mermaid-js/mermaid-cli && npm cache clean --force && apt purge -y curl && apt autoremove -y

