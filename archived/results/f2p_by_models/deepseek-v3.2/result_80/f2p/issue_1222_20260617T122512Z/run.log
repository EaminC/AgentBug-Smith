[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Copy entire repository
COPY . .

# Early upgrade of packaging tools
RUN python -m pip install --upgrade pip setuptools wheel

# Determine if src/ layout or imports from src exist
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." . 2>/dev/null; then \
        echo "src layout detected, setting PYTHONPATH and skipping editable install"; \
        export PYTHONPATH=/app; \
    else \
        echo "No src layout, will perform editable install"; \
    fi

# Install dependencies based on available files
RUN if [ -f "requirements.txt" ]; then \
        echo "Installing from requirements.txt"; \
        pip install -r requirements.txt; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        echo "Installing with poetry"; \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi; \
    elif [ -f "pyproject.toml" ]; then \
        echo "Installing via pip install -e . (no lockfile)"; \
    else \
        echo "No dependency file found, installing only test dependencies"; \
    fi

# Install project and test dependencies, handling src layout conditionally
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." . 2>/dev/null; then \
        # src layout: install dependencies and test tools, but not editable install
        if [ -f "requirements.txt" ]; then \
            pip install -r requirements.txt; \
        fi; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
        # No src layout: install project and test tools
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

