# branch: python/requirements.txt

# Set Forge environment variables for OpenAI SDK compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key

# Set Forge environment variables for Anthropic SDK compatibility
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Additional AI configuration
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0

# External API keys
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key

WORKDIR /app

# Copy entire repository (required for injected tests)
COPY . .

# Early upgrade of packaging tools
RUN python -m pip install --upgrade pip setuptools<=81.0.0 wheel

# Install system dependencies:
# - gcc, python3-dev: for compiling Python packages with native extensions
# - git: required by GitPython for tests
# - libsndfile1, libportaudio2: for sounddevice and soundfile packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    git \
    libsndfile1 \
    libportaudio2 \
    && rm -rf /var/lib/apt/lists/*

# Install project dependencies and test framework in a single RUN layer
# Use --break-system-packages to handle PEP 668 system package protection
RUN pip install --break-system-packages \
    -r requirements.txt \
    pytest pytest-mock pytest-asyncio pytest-cov pytest-xdist pytest-timeout \
    litellm \
    mem0ai

# Install the project in editable mode (handles both setup.py and pyproject.toml)
RUN pip install --break-system-packages -e .

# Preflight import check - verify critical packages can be imported
RUN python -c '
import setuptools
import pytest
import aider
import litellm
import mem0ai
print("preflight ok: setuptools, pytest, aider, litellm, mem0ai")
'

