[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Install system dependencies if any (based on evidence in repo: none required beyond Python)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ git curl && \
    rm -rf /var/lib/apt/lists/*

# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository (mandatory for external test injection)
COPY . .

# Detect src/ layout or imports from src.
# If src/ exists or tests import via src., avoid editable install and set PYTHONPATH.
# Otherwise, do pip install -e . as usual.
RUN if [ -d "src" ] || grep -rq "^[[:space:]]*from src\." tests/ 2>/dev/null || grep -rq "^[[:space:]]*import src\." tests/ 2>/dev/null; then \
        echo "src layout detected; skipping editable install." && \
        export USE_SRC_LAYOUT=1; \
    else \
        echo "No src layout detected; will perform editable install." && \
        export USE_SRC_LAYOUT=0; \
    fi

# Install dependencies based on existing files (requirements.txt, pyproject.toml, poetry.lock)
# Follow robustness principles: try multiple package managers with fallbacks.
RUN python -m pip install --upgrade pip setuptools wheel && \
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi; \
    elif [ -f "pyproject.toml" ]; then \
        # No lockfile; install via pip from pyproject.toml (editable if not src layout)
        if [ "$USE_SRC_LAYOUT" = "0" ]; then \
            pip install -e .; \
        else \
            pip install .; \
        fi; \
    else \
        # No dependency file; just install project (editable if not src layout)
        if [ "$USE_SRC_LAYOUT" = "0" ]; then \
            pip install -e .; \
        else \
            pip install .; \
        fi; \
    fi

# Install mandatory test dependencies (unconditionally)
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# If src layout, set PYTHONPATH to include /app so imports work without duplicate loading.
# Also ensure the package is installed (non-editable) if not already.
RUN if [ "$USE_SRC_LAYOUT" = "1" ]; then \
        # Ensure the package is installed (non-editable) if not already done above
        if ! python -c "import agentscope" 2>/dev/null; then \
            pip install .; \
        fi; \
        echo "PYTHONPATH=/app" >> /etc/environment; \
    fi

ENV PYTHONPATH=/app

# Set Forge environment variables (required by test harness)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Preflight import check to fail fast
RUN python -c 'import pkg_resources, pytest, agentscope; print("preflight ok")'

