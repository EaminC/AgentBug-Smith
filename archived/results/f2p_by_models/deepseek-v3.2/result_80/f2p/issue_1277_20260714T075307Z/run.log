                            "name": "greet",
                            "arguments": '{"name": ',
                        },
                    },
                ],
            ),
            self._create_mock_chunk(
                content="!",
                reasoning_content=" user",
                tool_calls=[
                    {
                        "index": 0,
                        "id": "call_123",
                        "function": {
                            "arguments": '"user"}',
                        },
                    },
