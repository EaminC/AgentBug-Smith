[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Install system dependencies needed for some Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository (required for external test injection)
COPY . .

# Detect src/ layout to decide on editable install
# Check if src/ directory exists or tests import via src.
RUN if [ -d "src" ] || (find tests -name "*.py" -exec grep -l "^\s*from src\.\|^\s*import src\." {} \; 2>/dev/null | head -1) ; then \
        echo "src/ layout detected, skipping editable install, setting PYTHONPATH" && \
        export NO_EDITABLE_INSTALL=1; \
    else \
        echo "No src/ layout detected, will perform editable install"; \
    fi

# Install dependencies based on available files
# Since pyproject.toml exists, we use pip install -e . (or skip if src layout)
# Also install dev dependencies from pyproject.toml's dev extra
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    fi && \
    if [ -f "pyproject.toml" ]; then \
        if [ -n "$NO_EDITABLE_INSTALL" ]; then \
            pip install .[dev]; \
        else \
            pip install -e .[dev]; \
        fi; \
    fi

# Unconditionally install core test dependencies (required by guardrails)
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Set PYTHONPATH if src layout detected (ensures imports work without duplicate module loading)
ENV PYTHONPATH=/app

# Set Forge environment variables (required by test harness)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Preflight import check to fail fast
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

