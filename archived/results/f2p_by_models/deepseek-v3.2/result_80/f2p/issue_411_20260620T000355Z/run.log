    # Check that it's a list
    assert isinstance(execute_shell_command.insecure_commands, list)
    # Check that it contains expected commands
    assert "rm -rf" in execute_shell_command.insecure_commands
    assert "shutdown" in execute_shell_command.insecure_commands


