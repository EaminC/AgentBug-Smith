    # from the default list, so it should execute (or fail if open not available).
    # However, the issue is about arbitrary code execution, so we test that
    # the fix adds a security check. Since "open" is not in the list, it will
    # not be blocked by the fix. But we can test that the fix is applied by
    # checking that the insecure_commands attribute exists and the function
    # behaves accordingly.
    assert hasattr(execute_shell_command, "insecure_commands")
    # Now test a command that should be blocked
    result = execute_shell_command("rm -rf /tmp/test")
    assert result.status == ServiceExecStatus.ERROR
    assert "blocked for security reasons" in result.content


def test_execute_shell_command_partial_match() -> None:
