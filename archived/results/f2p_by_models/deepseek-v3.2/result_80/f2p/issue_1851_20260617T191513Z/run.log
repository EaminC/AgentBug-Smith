def test_commit_message_generation_mocks_llm():
    """Test that when we mock an LLM response, the commit message extraction
    doesn't include extra explanatory text."""
    # We need to test the actual commit message generation flow.
    # The bug is about the model outputting extra text before the commit message.
    # We'll mock the LLM call to return a response that simulates the problematic behavior,
    # and verify that the commit message extraction logic handles it correctly.

    # Import the necessary modules
    from aider.coders.base_coder import Coder
    from aider.models import Model
    from aider.llm import LLM

    # Create a mock model that returns a problematic response
    mock_response = MagicMock()
    # Simulate the model returning extra text before the commit message
    mock_response.choices = [MagicMock()]
    mock_response.choices[0].message.content = "Here is the commit message for the changes:\n\nfix: Update capital gains calculation"

    # Mock the LLM's create method to return our mock response
    with patch.object(LLM, 'create', return_value=mock_response):
        # Create a minimal Coder instance (we need a repo and model)
        # We'll create a temporary git repo
        with tempfile.TemporaryDirectory() as tmpdir:
            repo_path = os.path.join(tmpdir, "test_repo")
            os.makedirs(repo_path)
            # Initialize git repo
            subprocess.run(["git", "init"], cwd=repo_path, capture_output=True)
            subprocess.run(["git", "config", "user.email", "test@test.com"], cwd=repo_path, capture_output=True)
            subprocess.run(["git", "config", "user.name", "Test User"], cwd=repo_path, capture_output=True)
            # Create a dummy file
            dummy_file = os.path.join(repo_path, "dummy.txt")
            with open(dummy_file, "w") as f:
                f.write("test")
            subprocess.run(["git", "add", "."], cwd=repo_path, capture_output=True)
            subprocess.run(["git", "commit", "-m", "initial"], cwd=repo_path, capture_output=True)

            # Now create a Coder instance
            model = Model("gpt-4")
            coder = Coder.create(model=model, fnames=[], git_dname=repo_path)

