import os
import tempfile
import subprocess
from unittest.mock import patch, MagicMock

def test_commit_system_prompt_does_not_contain_extra_phrases():
    """Test that the commit system prompt doesn't contain phrases that could cause extra text."""
    from aider.prompts import commit_system

    # In the buggy version, the prompt says "Reply with JUST the commit message"
    # In the fixed version, it says "Reply only with the one-line commit message"
    # The buggy version also lacks "one-line" (has "one line only").
    # We'll test for the fixed version's key phrases.
    # This test should fail on buggy, pass on fixed.

    # Check for the fixed version's specific phrasing
    assert "Reply only with the one-line commit message" in commit_system
    assert "without any additional text, explanations, or line breaks" in commit_system
    assert "one-line commit message" in commit_system

def test_commit_prompt_format():
    """Test that the commit prompt follows conventional commits format guidance
    and doesn't leave room for the model to add explanatory text."""
    from aider.prompts import commit_system

    # The prompt should explicitly mention conventional commits format
    assert "<type>: <description>" in commit_system

    # It should list the allowed types
    allowed_types = ["fix", "feat", "build", "chore", "ci", "docs", "style", "refactor", "perf", "test"]
    for type_name in allowed_types:
        assert type_name in commit_system, f"Missing allowed type: {type_name}"

    # The prompt should NOT contain phrases that could be misinterpreted
    # as asking for multi-line output or explanations
    prompt_lower = commit_system.lower()

    # These phrases should definitely not be in the prompt
    assert "here is" not in prompt_lower
    assert "got it" not in prompt_lower
    assert "let me" not in prompt_lower
    assert "i will" not in prompt_lower
    assert "the commit message is" not in prompt_lower

    # The prompt should emphasize the one-line requirement
    # In the fixed version, it says "one-line commit message" and "Reply only with the one-line commit message"
    assert "one-line" in prompt_lower
    assert "reply only with the one-line commit message" in prompt_lower

def test_commit_message_generation_mocks_llm():
    """Test that when we mock an LLM response, the commit message extraction
    doesn't include extra explanatory text."""
    # We need to test the actual commit message generation flow.
    # The bug is about the model outputting extra text before the commit message.
    # We'll mock the LLM call to return a response that simulates the problematic behavior,
    # and verify that the commit message extraction logic handles it correctly.

    # Import the necessary modules
    from aider.coders.base_coder import Coder
    from aider.models import Model
    from aider.llm import LLM

    # Create a mock model that returns a problematic response
    mock_response = MagicMock()
    # Simulate the bug: model returns extra text before the commit message
    mock_response.choices = [MagicMock()]
    mock_response.choices[0].message.content = "Here is the commit message for the changes:\n\nfix: Update capital gains calculation"

    # Mock the LLM call
    with patch.object(LLM, 'create') as mock_create:
        mock_create.return_value = mock_response

        # Create a minimal Coder instance (we need a repo and model)
        # Use a temporary directory as a fake repo
        with tempfile.TemporaryDirectory() as tmpdir:
            # Initialize a git repo
            subprocess.run(['git', 'init'], cwd=tmpdir, capture_output=True)
            subprocess.run(['git', 'config', 'user.email', 'test@example.com'], cwd=tmpdir, capture_output=True)
            subprocess.run(['git', 'config', 'user.name', 'Test User'], cwd=tmpdir, capture_output=True)

            # Create a dummy file to commit
            dummy_file = os.path.join(tmpdir, 'dummy.txt')
            with open(dummy_file, 'w') as f:
                f.write('original')

            # Add and commit the file
            subprocess.run(['git', 'add', dummy_file], cwd=tmpdir, capture_output=True)
            subprocess.run(['git', 'commit', '-m', 'initial'], cwd=tmpdir, capture_output=True)

            # Modify the file
            with open(dummy_file, 'w') as f:
                f.write('modified')

            # Create a model instance
            model = Model("gpt-4")

            # Create a Coder instance
            coder = Coder.create(
                main_model=model,
                io=MagicMock(),
                fnames=[dummy_file],
                git_dname=tmpdir,
                pretty=True,
                verbose=False,
                stream=False,
            )

            # Generate a commit message
            # This will call the LLM with the commit system prompt
            # The buggy version would include the extra text in the commit message
            # The fixed version should extract only the actual commit message line
            commit_message = coder.get_commit_message(diffs=['diff --git a/dummy.txt b/dummy.txt\nindex 123..456 100644\n--- a/dummy.txt\n+++ b/dummy.txt\n@@ -1 +1 @@\n-original\n+modified'])

            # The commit message should NOT contain the extra text
            assert commit_message is not None
