            # We assert that it does NOT contain such phrases
            assert "Here is the commit message" not in commit_message
            assert "Got it" not in commit_message
            assert "Commit message:" not in commit_message
            # It should be just the conventional commit line
            assert commit_message.startswith("fix:")
            # The commit message should be a single line
            assert '\n' not in commit_message

