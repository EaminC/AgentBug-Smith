from aider.prompts import commit_system


def test_commit_system_prompt_does_not_contain_extra_phrases():
    """Test that the commit system prompt doesn't contain phrases that could cause extra text."""
    # The bug: commit messages often start with an unuseful line like
    # "Got it, here is the commit message:" or "Here is the commit message for the changes:"
    # This happens because the model sometimes outputs extra text before the actual commit message.
    # The fix: updated commit_system prompt to emphasize "Reply only with the one-line commit message"
    # and removed ambiguous wording that could cause the model to output extra text.
    
    # Check that the prompt explicitly tells the model to output only the commit message
    assert "Reply only with the one-line commit message" in commit_system
    assert "without any additional text, explanations, or line breaks" in commit_system
    
    # Check that the prompt doesn't contain phrases that could cause the model to output extra text
    # The old prompt had "Reply with JUST the commit message" which wasn't strong enough
    # and didn't explicitly forbid explanatory text.
    assert "JUST the commit message" not in commit_system  # Old phrasing
    
    # Check that the prompt emphasizes one-line output
    assert "one-line commit message" in commit_system
    assert "Reply only with" in commit_system
    
    # Check that the prompt specifies the format clearly
    assert "<type>: <description>" in commit_system
    assert "imperative mood" in commit_system
    
    # The key assertion: the prompt should not contain ambiguous wording that could
    # cause the model to output phrases like "Here is the commit message for the changes:"
    # We check that the prompt doesn't encourage the model to explain itself.
    prompt_text = commit_system.lower()
    
    # These phrases should NOT appear in the prompt (they might encourage explanatory text)
    problematic_phrases = [
        "here is",
        "got it",
        "let me",
        "i will",
        "the commit message is",
        "as follows:",
        "below:",
        "above:",
    ]
    
    for phrase in problematic_phrases:
        # The prompt should not contain these phrases that might trigger the model
        # to output explanatory text before the actual commit message
        assert phrase not in prompt_text, f"Prompt contains problematic phrase: {phrase}"


