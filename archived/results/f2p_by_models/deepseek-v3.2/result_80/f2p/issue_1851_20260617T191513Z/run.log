def test_commit_prompt_format():
    """Test that the commit prompt follows conventional commits format guidance
    and doesn't leave room for the model to add explanatory text."""

    # The prompt should explicitly mention conventional commits format
    assert "<type>: <description>" in commit_system

    # It should list the allowed types
    allowed_types = ["fix", "feat", "build", "chore", "ci", "docs", "style", "refactor", "perf", "test"]
    for type_name in allowed_types:
        assert type_name in commit_system, f"Missing allowed type: {type_name}"

    # The prompt should NOT contain phrases that could be misinterpreted
    # as asking for multi-line output or explanations
    # Note: "as follows:" is still in the prompt but that's okay because
    # it's part of the format specification, not an invitation for explanatory text
    prompt_lower = commit_system.lower()

    # These phrases should definitely not be in the prompt
    assert "here is" not in prompt_lower
    assert "got it" not in prompt_lower
    assert "let me" not in prompt_lower
    assert "i will" not in prompt_lower
    assert "the commit message is" not in prompt_lower

    # The prompt should emphasize the one-line requirement
    # In the buggy version, it says "Reply with one line only!"
    # In the fixed version, it says "one-line commit message" and "Reply only with the one-line commit message"
    # We'll check for "one-line" which is in the fixed version but not in the buggy version.
    # Actually, the buggy version has "one line only" (two words).
    # The fixed version has "one-line" (with hyphen).
    # So checking for "one-line" will fail on buggy and pass on fixed.
    assert "one-line" in prompt_lower

    # Also check for the new phrasing that replaces the old buggy phrasing
    assert "reply only with" in prompt_lower


