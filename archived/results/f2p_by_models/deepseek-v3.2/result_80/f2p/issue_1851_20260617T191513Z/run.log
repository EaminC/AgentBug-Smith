[32mimport pytest
from unittest.mock import patch, MagicMock
from aider.prompts import commit_system
from aider.coders.base_coder import BaseCoder
from aider.models import Model
from aider.io import InputOutput
from aider.repo import GitRepo
import tempfile
import os

def test_commit_message_does_not_start_with_unuseful_line():
    # The bug: commit messages sometimes start with lines like
    # "Got it, here is the commit message:" or "Commit message:"
    # The fix: updated commit_system prompt to explicitly require
    # "Reply only with the one-line commit message, without any additional text"
    # We'll test by simulating the commit message generation flow.

    # First, verify the prompt text contains the fix
    assert "Reply only with the one-line commit message" in commit_system
    assert "without any additional text" in commit_system

    # Create a mock model that returns a response that would previously
    # have been incorrectly parsed (with extra leading line)
    mock_response_with_extra_line = """Got it, here is the commit message:

fix: Update capital gains calculation"""

    mock_response_correct = "fix: Update capital gains calculation"

    # We need to test the actual commit message extraction logic.
    # Look at how commit messages are generated in the codebase.
    # Typically, the model's response is taken directly as the commit message.
    # The bug was that the prompt didn't forbid extra introductory lines.
    # We'll test the commit message generation in a realistic scenario.

    # Use a temporary directory as a git repo
    with tempfile.TemporaryDirectory() as tmpdir:
        repo = GitRepo(io=InputOutput(), git_dir=tmpdir, aider_dir=tmpdir)
        repo.init()

        # Create a dummy file to have something to commit
        dummy_file = os.path.join(tmpdir, "test.py")
        with open(dummy_file, "w") as f:
            f.write("print('hello')")
        repo.add(dummy_file)

        # Simulate the commit message generation as done in the coder
        # We'll patch the model's call to return the problematic response
        # and ensure the commit message is cleaned.
        # Actually, the commit message is taken directly from the model response
        # in `_get_commit_message` (likely in base_coder.py or similar).
        # Let's check if there's any cleaning logic.

        # Import the relevant module to inspect
        from aider.coders import base_coder

        # We'll create a minimal coder instance and mock its model
        io = InputOutput()
        # We need a model name that exists in the test environment
        # Use a dummy model that we'll mock
        model = Model("gpt-4")

        # Create a coder with a dummy main_model
        coder = BaseCoder(
            io=io,
            main_model=model,
            fnames=[],
            repo=repo,
            pretty=True,
            show_diffs=False,
            auto_commits=True,
            dirty_commits=False,
            dry_run=False,
        )

        # Mock the model's completion method
        with patch.object(coder.main_model, 'complete') as mock_complete:
            # Simulate the buggy response (with extra line)
            mock_complete.return_value = mock_response_with_extra_line

            # Call _get_commit_message (if exists) or simulate the commit flow
            # Let's see if BaseCoder has _get_commit_message
            if hasattr(coder, '_get_commit_message'):
                commit_msg = coder._get_commit_message([])
            else:
                # Fallback: directly call the method that generates commit messages
                # In the actual code, commit messages are generated in `commit` method
                # which calls `_get_commit_message_from_diffs` or similar.
                # We'll patch the internal call to the model.
                # Actually, let's just test the prompt's effect by checking
                # that the model's response is used as-is, and the bug is that
                # the prompt allowed extra lines.
                # The fix ensures the prompt forbids extra lines, so the model
                # should not return them. We'll test that the prompt change
                # leads to correct behavior by mocking the model to return
                # a correct response (since the prompt now instructs it to).
                mock_complete.return_value = mock_response_correct
                if hasattr(coder, '_get_commit_message_from_diffs'):
                    commit_msg = coder._get_commit_message_from_diffs([])
                else:
                    # If we can't find the exact method, we'll test the prompt directly
                    # by verifying the commit_system prompt string.
                    # The test should fail on buggy code because the prompt
                    # doesn't forbid extra lines, so a model might return them.
                    # But we can't rely on a real model in a test.
                    # Instead, we'll test that the commit message cleaning logic
                    # exists and works.
                    # Let's search for commit message cleaning in the codebase.
                    # We'll simulate the cleaning that should happen.
                    pass

        # Actually, the bug is that the prompt didn't forbid extra lines,
        # so the model returned them. The fix is to update the prompt.
        # Therefore, the test should verify that the prompt text changed.
        # But we also want to ensure that if a model still returns extra lines
        # (e.g., old cached prompt), the system handles it.
        # Look at the git log examples: the extra lines became the commit message.
        # So the commit message was taken as the entire response, including the
        # extra line. That means there is no cleaning logic.
        # Thus, the fix is solely in the prompt.
        # Our test should ensure that the prompt change is present and that
        # the commit message generation uses the prompt correctly.

        # Let's write a test that mocks the LLM call and checks that the
        # commit message is a single line starting with a conventional commit prefix.
        # We'll use the actual commit generation code path.

        # Find the method that generates commit messages.
        # In base_coder.py, there is `_get_commit_message_from_diffs`.
        # Let's import it.
        from aider.coders.base_coder import BaseCoder

        # Create a fresh coder with a mocked model
        with tempfile.TemporaryDirectory() as tmpdir2:
            repo2 = GitRepo(io=InputOutput(), git_dir=tmpdir2, aider_dir=tmpdir2)
            repo2.init()
            coder2 = BaseCoder(
                io=InputOutput(),
                main_model=Model("gpt-4"),
                fnames=[],
                repo=repo2,
                pretty=True,
                show_diffs=False,
                auto_commits=True,
                dirty_commits=False,
                dry_run=False,
            )

            # Mock the model's complete method
            with patch.object(coder2.main_model, 'complete') as mock_complete2:
                # Simulate a correct response (as the new prompt should produce)
                mock_complete2.return_value = "fix: Update capital gains calculation"

                # Get the commit message
                # The method might be private; we'll call it via reflection
                if hasattr(coder2, '_get_commit_message_from_diffs'):
                    commit_msg = coder2._get_commit_message_from_diffs([])
                elif hasattr(coder2, '_get_commit_message'):
                    commit_msg = coder2._get_commit_message([])
                else:
                    # Fallback: call commit with dry-run
                    with patch.object(coder2.repo, 'commit') as mock_commit:
                        coder2.commit([])
                        # Get the commit message passed to repo.commit
                        commit_msg = mock_commit.call_args[0][0] if mock_commit.called else None

                # Ensure commit_msg is a single line
                assert commit_msg is not None
                lines = commit_msg.strip().splitlines()
                # The buggy behavior would have multiple lines
                # The fixed behavior should have exactly one line
                assert len(lines) == 1, f"Commit message should be one line, got: {commit_msg}"
                # The line should start with a conventional commit prefix
                prefixes = ("fix:", "feat:", "build:", "chore:", "ci:", "docs:", "style:", "refactor:", "perf:", "test:")
                assert any(commit_msg.startswith(prefix) for prefix in prefixes), \
                    f"Commit message should start with a conventional commit prefix, got: {commit_msg}"

                # Additionally, ensure the commit message does not start with unwanted phrases
                unwanted = ("Got it, here is the commit message:", "Commit message:", "Here is the commit message for the changes:", "Got it, let's review")
                for phrase in unwanted:
                    assert not commit_msg.startswith(phrase), \
                        f"Commit message starts with unwanted phrase: {phrase}"

def test_commit_prompt_change():
    # Direct test that the prompt has been updated
    with open("aider/prompts.py", "r") as f:
        content = f.read()
        assert "Reply only with the one-line commit message" in content
        assert "without any additional text" in content
        # Ensure the old problematic phrasing is not present
        # The old prompt said "Reply with JUST the commit message, without quotes, comments, questions, etc!"
        # That is still okay, but we want to ensure the new stricter wording is there.
        # Actually, the old prompt is replaced, so we can check for the new lines.
        assert "Generate a one-line commit message for those changes." in content
        assert "Reply only with the one-line commit message, without any additional text, explanations, or line breaks." in content

if __name__ == "__main__":
    # This allows running the test directly with python
    pytest.main([__file__, "-v"])[0m
