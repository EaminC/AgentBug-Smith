import pytest
from aider.prompts import commit_system


def test_commit_system_prompt_does_not_contain_extra_phrases():
    """Test that the commit system prompt doesn't contain phrases that could cause extra text."""
    # The bug: commit messages often start with an unuseful line like
    # "Got it, here is the commit message:" or "Here is the commit message for the changes:"
    # This happens because the model sometimes outputs extra text before the actual commit message.
    # The fix: updated commit_system prompt to emphasize "Reply only with the one-line commit message"
    # and removed ambiguous wording that could cause the model to output extra text.

    # Check that the prompt explicitly tells the model to output only the commit message
    assert "Reply only with the one-line commit message" in commit_system
    assert "without any additional text, explanations, or line breaks" in commit_system

    # Check that the prompt doesn't contain phrases that could cause the model to output extra text
    # The old prompt had "Reply with JUST the commit message" which wasn't strong enough
    # and didn't explicitly forbid explanatory text.
    assert "JUST the commit message" not in commit_system  # Old phrasing

    # Check that the prompt emphasizes one-line output
    assert "one-line commit message" in commit_system
    assert "Reply only with" in commit_system

    # Check that the prompt specifies the format clearly
    assert "<type>: <description>" in commit_system
    assert "imperative mood" in commit_system

    # The key assertion: the prompt should not contain ambiguous wording that could
    # cause the model to output phrases like "Here is the commit message for the changes:"
    # We check that the prompt doesn't encourage the model to explain itself.
    prompt_text = commit_system.lower()

    # These phrases should NOT appear in the prompt (they might encourage explanatory text)
    problematic_phrases = [
        "here is",
        "got it",
        "let me",
        "i will",
        "the commit message is",
        "as follows:",
        "below:",
        "above:",
    ]

    for phrase in problematic_phrases:
        # The prompt should not contain these phrases that might trigger the model
        # to output explanatory text before the actual commit message
        assert phrase not in prompt_text, f"Prompt contains problematic phrase: {phrase}"


def test_commit_message_generation_mocks_llm():
    """Test that when we mock an LLM response, the commit message extraction
    doesn't include extra explanatory text."""
    # We need to test the actual commit message generation flow.
    # The bug is about the model outputting extra text before the commit message.
    # We'll mock the LLM call to return a response that simulates the problematic behavior,
    # and verify that the commit message extraction logic handles it correctly.

    # Import the necessary modules
    from aider.coders.base_coder import BaseCoder
    from aider.coders.editblock_coder import EditBlockCoder
    from aider.models import Model
    from aider.io import InputOutput

    # Create a mock model that returns a problematic response
    class MockModel:
        def __init__(self):
            self.name = "test-model"
            self.supports_prefill = False

        def call_with_messages(self, messages, functions=None, stream=False, **kwargs):
            # Simulate the problematic model output that includes extra text
            # This mimics what the bug report shows: extra line before commit message
            problematic_response = """Got it, here is the commit message:

fix: Update capital gains calculation"""
            return problematic_response

    # Create a minimal coder instance
    io = InputOutput(yes=False, pretty=False, chat_history_file=None)
    model = MockModel()
    
    # Use EditBlockCoder as it's a concrete implementation
    coder = EditBlockCoder.create(
        main_model=model,
        io=io,
        fnames=[],
        git_dname=None,
        pretty=False,
        show_diffs=False,
        auto_commits=False,
        dirty_commits=False,
        dry_run=False,
        map_tokens=0,
        verbose=False,
        assistant_output_color=None,
        code_theme=None,
        stream=False,
        use_git=True,
    )

    # Mock the actual LLM call inside commit() method
    # We need to patch the internal model call, not the commit method itself
    import unittest.mock
    with unittest.mock.patch.object(model, 'call_with_messages') as mock_call:
        # Make it return a problematic response
        mock_call.return_value = """Here is the commit message for the changes:

fix: limit mina allocated from purchase records to remaining runningTotal"""
        
        # Get the commit message by calling commit with dummy diffs
        # The commit method is in the parent class BaseCoder
        diffs = "diff --git a/test.py b/test.py\n@@ -1,1 +1,1 @@\n-old\n+new"
        commit_message = coder.commit(diffs=diffs, context=None)
        
        # The buggy code would include the extra line in the commit message
        # The fixed code should strip it and return only the actual commit message
        # Assert that the commit message does NOT start with problematic phrases
        assert commit_message is not None
        assert not commit_message.startswith("Got it")
        assert not commit_message.startswith("Here is")
        assert not commit_message.startswith("Commit message:")
        assert not commit_message.startswith("Commit Message:")
        
        # Should be a proper conventional commit
        assert commit_message.startswith("fix:")
        # Should not contain newlines (should be one line)
        assert "\n" not in commit_message


def test_patch_changes():
    """Test that the patch changes were applied correctly."""
    # The patch changes the commit_system prompt in aider/prompts.py
    # We need to verify the exact changes were applied correctly.

    # Read the actual file to verify it matches the patched version
    import inspect

    # Get the path to prompts.py
    prompts_path = inspect.getfile(sys.modules['aider.prompts'])

    with open(prompts_path, 'r') as f:
        content = f.read()

    # Check that the new prompt text is present
    assert "Reply only with the one-line commit message" in content
    assert "without any additional text, explanations, or line breaks" in content
    
    # Check that old problematic phrasing is removed
    assert "Reply with JUST the commit message" not in content
    assert "without quotes, comments, questions, etc!" not in content
    
    # Check for new guidance
    assert "Ensure the commit message:" in content
    assert "Starts with the appropriate prefix" in content
    assert "Is in the imperative mood" in content
    assert "Does not exceed 72 characters" in content


