def test_commit_system_prompt_does_not_contain_extra_phrases():
    """Test that the commit system prompt doesn't contain phrases that could cause extra text."""
    # The bug: commit messages often start with an unuseful line like
    # "Got it, here is the commit message:" or "Here is the commit message for the changes:"
    # This happens because the model sometimes outputs extra text before the actual commit message.
    # The fix: updated commit_system prompt to emphasize "Reply only with the one-line commit message"
    # and removed ambiguous wording that could cause the model to output extra text.

    # Check that the prompt explicitly tells the model to output only the commit message
    # In the buggy version, the prompt says "Reply with JUST the commit message"
    # In the fixed version, it says "Reply only with the one-line commit message"
    # We'll test that the fixed version's key phrases are present
    # and that the buggy version's problematic phrasing is absent.

    # Key phrases that should be in the fixed prompt
    assert "Reply only with the one-line commit message" in commit_system
    assert "without any additional text, explanations, or line breaks" in commit_system

    # The buggy prompt had "JUST" which wasn't strong enough
    # The fixed prompt should not have "JUST" (it's replaced with stronger wording)
    # Actually, checking for absence of "JUST" is too strict because it might appear elsewhere.
    # Instead, we'll check for the presence of the new stronger wording.
    # But we need the test to fail on buggy and pass on fixed.
    # The buggy prompt ends with "Reply with JUST the commit message, without quotes, comments, questions, etc!\nReply with one line only!"
    # The fixed prompt has the new text.
    # So we'll check for the new text.

    # Also check that the prompt emphasizes one-line output
    assert "one-line commit message" in commit_system

    # Check that the prompt specifies the format clearly
    assert "<type>: <description>" in commit_system
    assert "imperative mood" in commit_system

    # The prompt should not contain ambiguous wording that could cause the model to output explanatory text.
    # However, "as follows:" is still in the prompt as part of the format specification.
    # That's okay because it's not an invitation for explanatory text.
    # We'll check that the prompt doesn't encourage the model to explain itself.
    prompt_text = commit_system.lower()

    # These phrases should NOT appear in the prompt (they might encourage explanatory text)
    problematic_phrases = [
        "here is",
        "got it",
        "let me",
        "i will",
        "the commit message is",
        # "as follows:" is allowed because it's part of the format spec
    ]

    for phrase in problematic_phrases:
        # The prompt should not contain these phrases that might trigger the model
        # to output explanatory text before the actual commit message
        assert phrase not in prompt_text, f"Prompt contains problematic phrase: {phrase}"

    # Additionally, the prompt should not contain the old buggy phrasing that allowed extra text.
    # The old buggy prompt had lines that could be misinterpreted.
    # We'll check that the prompt doesn't have the exact old buggy lines.
    old_buggy_phrases = [
        "Reply with JUST the commit message, without quotes, comments, questions, etc!",
        "Reply with one line only!",
    ]
    for phrase in old_buggy_phrases:
        # In the fixed version, these lines are replaced, so they should not appear.
        # However, note that the second line "Reply with one line only!" might still be present
        # in some form. Actually, the fixed version says "Reply only with the one-line commit message"
        # So we'll check that the exact old phrase is not present.
        if phrase == "Reply with one line only!":
            # The fixed version might have similar wording, but not exactly this.
            # We'll check that the exact string is not there.
            assert phrase not in commit_system, f"Prompt contains old buggy phrase: {phrase}"


