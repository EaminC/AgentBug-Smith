    # and verify that the commit message extraction logic handles it correctly.

    # Import the necessary modules
    from aider.coders.base_coder import Coder
    from aider.models import Model
    from aider.llm import LLM

    # Create a mock model that returns a problematic response
    mock_response = MagicMock()
    # Simulate the bug: model returns extra text before the commit message
    mock_response.choices[0].message.content = "Got it, here is the commit message:\nfix: Update capital gains calculation"

    # Mock the LLM's completion method
    with patch.object(LLM, 'completion', return_value=mock_response) as mock_completion:
        # Create a simple Coder instance (we need minimal setup)
        # We'll use a temporary directory as the repo
        with tempfile.TemporaryDirectory() as tmpdir:
            # Initialize a git repo
            subprocess.run(["git", "init"], cwd=tmpdir, capture_output=True)
            subprocess.run(["git", "config", "user.email", "test@example.com"], cwd=tmpdir, capture_output=True)
            subprocess.run(["git", "config", "user.name", "Test User"], cwd=tmpdir, capture_output=True)
            # Create a dummy file to have something to commit
            dummy_file = os.path.join(tmpdir, "dummy.py")
            with open(dummy_file, "w") as f:
                f.write("print('hello')")
            subprocess.run(["git", "add", "."], cwd=tmpdir, capture_output=True)
            subprocess.run(["git", "commit", "-m", "initial"], cwd=tmpdir, capture_output=True)
            # Make a change
            with open(dummy_file, "a") as f:
                f.write("\nprint('world')")

            # Now create a Coder instance
            # We need to mock the model creation to use our mocked LLM
            # The Coder uses Model which uses LLM
            # We'll patch the Model's underlying LLM
            coder = Coder.create(
                main_model="gpt-4",
                fnames=[dummy_file],
                git_dname=tmpdir,
                # Disable auto-commit so we can test commit message generation
                auto_commits=False,
                dirty_commits=False,
            )
            # The coder should have a repo with changes
            assert coder.repo is not None
            # Get the commit message via the internal method
            # The commit message is generated by _get_commit_message
            # which calls the LLM with the commit_system prompt
            # Since we mocked the LLM completion, it will return our problematic response
            # The method should extract just the commit message line
            commit_message = coder._get_commit_message(coder.repo.get_diffs())
            # The buggy code might include the extra text; the fixed code should strip it
            # Assert that the commit message is exactly the conventional commit line
            assert commit_message == "fix: Update capital gains calculation"
            # Ensure no extra phrases like "Got it, here is the commit message:" are present
            assert not commit_message.startswith("Got it")
            assert not commit_message.startswith("Here is")
            assert not commit_message.startswith("Commit message:")


def test_commit_prompt_format():
    """Test that the commit prompt follows conventional commits format guidance
    and doesn't leave room for the model to add explanatory text."""
    from aider.prompts import commit_system

    # The prompt should explicitly mention conventional commits format
    assert "<type>: <description>" in commit_system

    # It should list the allowed types
    allowed_types = ["fix", "feat", "build", "chore", "ci", "docs", "style", "refactor", "perf", "test"]
