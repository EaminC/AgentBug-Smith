[32mFROM python:3.12-slim

WORKDIR /app

COPY . .

# Upgrade packaging tools and install uv
RUN python -m pip install --upgrade pip setuptools wheel uv

# Install the project (langgraph) with its dependencies
# Use uv if uv.lock exists, otherwise fall back to pip
RUN cd libs/langgraph && \
    if [ -f uv.lock ]; then \
        uv sync --frozen --group dev; \
        uv pip install -e .; \
    else \
        pip install -e .; \
        if [ -f requirements.txt ]; then pip install -r requirements.txt; fi; \
    fi

# Install testing framework and additional required dependencies unconditionally
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai vcrpy json_repair chromadb

# Preflight check to ensure core packages are importable
