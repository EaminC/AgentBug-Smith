[32mFROM python:3.12-slim

WORKDIR /app

# Copy the entire repository (including externally injected test scripts)
COPY . .

# Set environment variables for Forge
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install test dependencies unconditionally
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai vcrpy json_repair chromadb

# Detect src/ layout and install project accordingly
# If src/ directory exists under libs/langgraph, set PYTHONPATH and skip editable install
# to avoid duplicate module loading. Otherwise, install the project in editable mode.
RUN if [ -d "libs/langgraph/src" ] || grep -Rq "from src\.\|import src\." libs/langgraph/tests 2>/dev/null; then \
    ENV PYTHONPATH=/app; \
    else \
    pip install -e libs/langgraph; \
    fi

# Preflight check to verify core packages
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command (expected by test harness)
CMD ["/bin/bash"][0m
