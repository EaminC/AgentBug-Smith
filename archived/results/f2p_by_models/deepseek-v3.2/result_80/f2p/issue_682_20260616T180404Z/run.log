    Test that self_heal handles timeout correctly.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = Path(tmpdir) / "workspace"
        workspace_path.mkdir()
        logs_path = Path(tmpdir) / "logs"
        logs_path.mkdir()
        preprompts_path = Path(tmpdir) / "preprompts"
        preprompts_path.mkdir()
        memory_path = Path(tmpdir) / "memory"
        memory_path.mkdir()
        input_path = Path(tmpdir) / "input"
        input_path.mkdir()
        project_metadata_path = Path(tmpdir) / "project_metadata"
        project_metadata_path.mkdir()

        # Create a run.sh that will timeout
        run_sh_path = workspace_path / "run.sh"
        run_sh_path.write_text("sleep 60")

        log_path = workspace_path / "log.txt"
        log_path.write_text("")

        preprompt_file = preprompts_path / "file_format_fix"
        preprompt_file.write_text("Please fix any errors in the code above.")

        dbs = DBs(
            memory=DB(memory_path),
            logs=DB(logs_path),
            preprompts=DB(preprompts_path),
            input=DB(input_path),
            workspace=DB(workspace_path),
            archive=None,
            project_metadata=DB(project_metadata_path),
        )

        mock_ai = Mock(spec=AI)
        mock_ai.fuser = Mock(side_effect=lambda x: x)
        mock_ai.next = Mock(return_value=[Mock(content="fixed code")])
        mock_ai.deserialize_messages = Mock(return_value=[])

        # Mock subprocess.Popen to simulate timeout
        mock_process = Mock()
        mock_process.wait = Mock(side_effect=Exception("TimeoutExpired"))
        mock_process.returncode = None
        with patch("subprocess.Popen", return_value=mock_process):
            result = self_heal(mock_ai, dbs)
        # Should return messages after attempting to fix
        assert isinstance(result, list)[0m
