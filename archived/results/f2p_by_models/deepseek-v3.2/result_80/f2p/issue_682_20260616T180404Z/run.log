def test_self_heal_with_successful_run_sh():
    """
    Test self_heal when run.sh succeeds (returncode 0).
    The function should return early without calling AI.next.
    """
    with patch("gpt_engineer.core.steps.MAX_SELF_HEAL_ATTEMPTS", -1):
        with patch("gpt_engineer.core.steps.ASSUME_WORKING_TIMEOUT", 0.1):
            with patch("gpt_engineer.core.steps.subprocess.Popen") as mock_popen:
                mock_process = Mock()
                mock_process.wait.return_value = None
                mock_process.returncode = 0
                mock_popen.return_value = mock_process

                mock_ai = Mock(spec=AI)
                mock_ai.fuser.side_effect = lambda x: x
                mock_ai.next = Mock()

                with pytest.tempfile.TemporaryDirectory() as tmpdir:
                    workspace_path = Path(tmpdir) / "workspace"
                    workspace_path.mkdir()
                    run_sh = workspace_path / "run.sh"
                    run_sh.write_text("exit 0")
                    run_sh.chmod(0o755)

                    logs_path = Path(tmpdir) / "logs"
                    logs_path.mkdir()
                    preprompts_path = Path(tmpdir) / "preprompts"
                    preprompts_path.mkdir()
                    memory_path = Path(tmpdir) / "memory"
                    memory_path.mkdir()
                    input_path = Path(tmpdir) / "input"
                    input_path.mkdir()
                    project_metadata_path = Path(tmpdir) / "project_metadata"
                    project_metadata_path.mkdir()

                    file_format_fix = preprompts_path / "file_format_fix"
                    file_format_fix.write_text("Fix the code.")

                    logs_entrypoint_path = logs_path / "gen_entrypoint"
                    serialized = [
                        {
                            "type": "human",
                            "content": "test",
                            "data": {"is_chunk": False},
                        }
                    ]
                    logs_entrypoint_path.write_text(json.dumps(serialized))

                    dbs = DBs(
                        memory=DB(memory_path),
                        logs=DB(logs_path),
                        preprompts=DB(preprompts_path),
                        input=DB(input_path),
                        workspace=DB(workspace_path),
                        archive=None,
                        project_metadata=DB(project_metadata_path),
                    )

                    result = self_heal(mock_ai, dbs)
                    assert result == []
                    mock_ai.next.assert_not_called()


