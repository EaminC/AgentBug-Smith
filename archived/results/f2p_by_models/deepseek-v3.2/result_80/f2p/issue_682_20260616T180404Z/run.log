[32mimport pytest
import tempfile
import os
import shutil
from unittest.mock import Mock, patch, call
from gpt_engineer.core.steps import (
    self_heal,
    gen_entrypoint,
    to_files_and_memory,
    curr_fn,
    MAX_SELF_HEAL_ATTEMPTS,
    ASSUME_WORKING_TIMEOUT,
)
from gpt_engineer.core.ai import AI
from gpt_engineer.core.db import DBs


def test_self_heal_with_failing_run_sh():
    """
    Test self_heal when run.sh fails (returncode != 0).
    The function should call AI.next with the error log and attempt to fix.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = os.path.join(tmpdir, "workspace")
        os.makedirs(workspace_path)
        log_path = os.path.join(workspace_path, "log.txt")
        with open(os.path.join(workspace_path, "run.sh"), "w") as f:
            f.write("echo 'error'; exit 1")

        dbs = Mock(spec=DBs)
        dbs.workspace.path = workspace_path
        dbs.workspace.__getitem__ = Mock(side_effect=lambda x: open(log_path).read() if x == "log.txt" else "")
        dbs.workspace.__setitem__ = Mock()
        dbs.logs = {gen_entrypoint.__name__: "some serialized messages"}
        dbs.preprompts = {"file_format_fix": "fix prompt"}

        mock_ai = Mock(spec=AI)
        mock_ai.fuser = Mock(side_effect=lambda x: x)
        mock_ai.next = Mock(return_value=["fixed_message"])
        mock_ai.deserialize_messages = Mock(return_value=["message1", "message2"])

        with patch("gpt_engineer.core.steps.MAX_SELF_HEAL_ATTEMPTS", 1):
            with patch("gpt_engineer.core.steps.ASSUME_WORKING_TIMEOUT", 0.1):
                with patch("gpt_engineer.core.steps.subprocess.Popen") as mock_popen:
                    mock_process = Mock()
                    mock_process.wait.return_value = None
                    mock_process.returncode = 1
                    mock_popen.return_value = mock_process

                    with patch("gpt_engineer.core.steps.to_files_and_memory") as mock_to_files:
                        result = self_heal(mock_ai, dbs)

        assert mock_ai.next.called
        mock_ai.next.assert_called_with(
            ["message1", "message2", "Python Version: 3.12.0\nOS: Linux\n", ""],
            "fix prompt",
            step_name=curr_fn(),
        )
        mock_to_files.assert_called_once()
        assert result == ["fixed_message"]


def test_self_heal_with_successful_run_sh():
    """
    Test self_heal when run.sh succeeds (returncode 0).
    The function should return early without calling AI.next.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = os.path.join(tmpdir, "workspace")
        os.makedirs(workspace_path)
        log_path = os.path.join(workspace_path, "log.txt")
        with open(os.path.join(workspace_path, "run.sh"), "w") as f:
            f.write("echo 'success'; exit 0")

        dbs = Mock(spec=DBs)
        dbs.workspace.path = workspace_path
        dbs.workspace.__getitem__ = Mock(side_effect=lambda x: open(log_path).read() if x == "log.txt" else "")
        dbs.workspace.__setitem__ = Mock()
        dbs.logs = {}
        dbs.preprompts = {}

        mock_ai = Mock(spec=AI)
        mock_ai.fuser = Mock(side_effect=lambda x: x)
        mock_ai.next = Mock()

        with patch("gpt_engineer.core.steps.MAX_SELF_HEAL_ATTEMPTS", 1):
            with patch("gpt_engineer.core.steps.ASSUME_WORKING_TIMEOUT", 0.1):
                with patch("gpt_engineer.core.steps.subprocess.Popen") as mock_popen:
                    mock_process = Mock()
                    mock_process.wait.return_value = None
                    mock_process.returncode = 0
                    mock_popen.return_value = mock_process

                    result = self_heal(mock_ai, dbs)

        mock_ai.next.assert_not_called()
        assert result == []


def test_self_heal_timeout():
    """
    Test self_heal when run.sh times out (timed_out=True).
    The function should treat timeout as success and return early.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = os.path.join(tmpdir, "workspace")
        os.makedirs(workspace_path)
        log_path = os.path.join(workspace_path, "log.txt")
        with open(os.path.join(workspace_path, "run.sh"), "w") as f:
            f.write("sleep 10")

        dbs = Mock(spec=DBs)
        dbs.workspace.path = workspace_path
        dbs.workspace.__getitem__ = Mock(side_effect=lambda x: open(log_path).read() if x == "log.txt" else "")
        dbs.workspace.__setitem__ = Mock()
        dbs.logs = {}
        dbs.preprompts = {}

        mock_ai = Mock(spec=AI)
        mock_ai.fuser = Mock(side_effect=lambda x: x)
        mock_ai.next = Mock()

        with patch("gpt_engineer.core.steps.MAX_SELF_HEAL_ATTEMPTS", 1):
            with patch("gpt_engineer.core.steps.ASSUME_WORKING_TIMEOUT", 0.1):
                with patch("gpt_engineer.core.steps.subprocess.Popen") as mock_popen:
                    mock_process = Mock()
                    mock_process.wait.side_effect = Exception("timeout")
                    mock_process.returncode = None
                    mock_popen.return_value = mock_process

                    result = self_heal(mock_ai, dbs)

        mock_ai.next.assert_not_called()
        assert result == []


