def test_self_heal_with_failing_run_sh():
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = Path(tmpdir) / "workspace"
        workspace_path.mkdir()
        # Create a run.sh that fails (non‑zero exit)
        run_sh = workspace_path / "run.sh"
        run_sh.write_text("exit 1")
        run_sh.chmod(0o755)

        logs_path = Path(tmpdir) / "logs"
        logs_path.mkdir()
        preprompts_path = Path(tmpdir) / "preprompts"
        preprompts_path.mkdir()
        memory_path = Path(tmpdir) / "memory"
        memory_path.mkdir()
        input_path = Path(tmpdir) / "input"
        input_path.mkdir()
        project_metadata_path = Path(tmpdir) / "project_metadata"
        project_metadata_path.mkdir()

        # Write a dummy file_format_fix prompt
        file_format_fix = preprompts_path / "file_format_fix"
        file_format_fix.write_text("Fix the code.")

        # Simulate logs from gen_entrypoint step.
        # The buggy code expects logs[gen_entrypoint.__name__] to be a list of serialized messages.
        # In ai.py, serialize_messages uses message.dict().
        # The message is a Langchain BaseMessage with type and content.
        # The dict includes additional fields like "data".
        # We'll replicate a minimal valid serialized message.
        logs_entrypoint_path = logs_path / gen_entrypoint.__name__
        # Create a list with one human message.
        serialized = [
            {
                "type": "human",
                "content": "test",
                "data": {"is_chunk": False},
            }
        ]
        logs_entrypoint_path.write_text(json.dumps(serialized))

        dbs = DBs(
            memory=DB(memory_path),
            logs=DB(logs_path),
            preprompts=DB(preprompts_path),
            input=DB(input_path),
            workspace=DB(workspace_path),
            archive=None,
            project_metadata=DB(project_metadata_path),
        )

        mock_ai = Mock(spec=AI)
        mock_ai.fuser = Mock(side_effect=lambda x: x)
        mock_ai.next = Mock(return_value=[Mock(content="fixed code")])
        mock_ai.deserialize_messages = Mock(return_value=[])

        # Mock subprocess.Popen to simulate failure
        mock_process = Mock()
        mock_process.wait = Mock()
        mock_process.returncode = 1
        with patch("subprocess.Popen", return_value=mock_process):
            result = self_heal(mock_ai, dbs)

        # Should have called ai.next with the error log
        assert mock_ai.next.called
        # The result should be the messages returned by ai.next
        assert result == [Mock(content="fixed code")]


