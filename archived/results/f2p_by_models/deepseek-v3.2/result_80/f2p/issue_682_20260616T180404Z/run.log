[32mimport os
import tempfile
import subprocess
from unittest.mock import Mock, patch
import pytest
from gpt_engineer.core.steps import (
    self_heal,
    gen_entrypoint,
    to_files_and_memory,
    curr_fn,
)
from gpt_engineer.core.ai import AI
from gpt_engineer.core.db import DBs


def test_self_heal_with_failing_run_sh():
    """
    Test self_heal when run.sh fails (returncode != 0).
    It should attempt to fix the code up to MAX_SELF_HEAL_ATTEMPTS.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = os.path.join(tmpdir, "workspace")
        os.makedirs(workspace_path)
        # Write a run.sh that will fail (non-existent command)
        with open(os.path.join(workspace_path, "run.sh"), "w") as f:
            f.write("nonexistentcommand")

        dbs = Mock(spec=DBs)
        workspace_mock = Mock()
        workspace_mock.path = workspace_path
        workspace_mock.__getitem__ = Mock(return_value="log content")
        dbs.workspace = workspace_mock
        dbs.logs = {gen_entrypoint.__name__: "serialized messages"}
        dbs.preprompts = {"file_format_fix": "fix prompt"}

        ai = Mock(spec=AI)
        ai.fuser = Mock(return_value="fused message")
        ai.next = Mock(return_value=["message1", "message2"])

        # Patch constants to limit attempts
        with patch("gpt_engineer.core.steps.MAX_SELF_HEAL_ATTEMPTS", 1):
            with patch("gpt_engineer.core.steps.ASSUME_WORKING_TIMEOUT", 30):
                result = self_heal(ai, dbs)

        # Should have called ai.next because run.sh failed
        assert ai.next.called
        # Should have attempted to fix once
        assert len(result) > 0


def test_self_heal_with_successful_run_sh():
    """
    Test self_heal when run.sh succeeds (returncode == 0).
    It should return early without calling AI.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = os.path.join(tmpdir, "workspace")
        os.makedirs(workspace_path)
        # Write a run.sh that will succeed (simple echo)
        with open(os.path.join(workspace_path, "run.sh"), "w") as f:
            f.write("echo 'success'")

        dbs = Mock(spec=DBs)
        workspace_mock = Mock()
        workspace_mock.path = workspace_path
        workspace_mock.__getitem__ = Mock(return_value="log content")
        dbs.workspace = workspace_mock
        dbs.logs = {gen_entrypoint.__name__: "serialized messages"}
        dbs.preprompts = {"file_format_fix": "fix prompt"}

        ai = Mock(spec=AI)
        ai.fuser = Mock(return_value="fused message")
        ai.next = Mock()

        # Patch constants
        with patch("gpt_engineer.core.steps.MAX_SELF_HEAL_ATTEMPTS", 2):
            with patch("gpt_engineer.core.steps.ASSUME_WORKING_TIMEOUT", 30):
                result = self_heal(ai, dbs)

        # Should NOT call ai.next because run.sh succeeded
        assert not ai.next.called
        # Should return empty list (or whatever the early return is)
        assert result == []


def test_self_heal_timeout():
    """
    Test self_heal when run.sh times out (timed_out=True).
    The function should treat timeout as success and return early.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = os.path.join(tmpdir, "workspace")
        os.makedirs(workspace_path)
        # Write a run.sh that sleeps longer than timeout
        with open(os.path.join(workspace_path, "run.sh"), "w") as f:
            f.write("sleep 10")

        dbs = Mock(spec=DBs)
        workspace_mock = Mock()
        workspace_mock.path = workspace_path
        workspace_mock.__getitem__ = Mock(return_value="log content")
        dbs.workspace = workspace_mock
        dbs.logs = {gen_entrypoint.__name__: "serialized messages"}
        dbs.preprompts = {"file_format_fix": "fix prompt"}

        ai = Mock(spec=AI)
        ai.fuser = Mock(return_value="fused message")
        ai.next = Mock()

        # Patch constants to force timeout
        with patch("gpt_engineer.core.steps.MAX_SELF_HEAL_ATTEMPTS", 2):
            with patch("gpt_engineer.core.steps.ASSUME_WORKING_TIMEOUT", 0.1):
                result = self_heal(ai, dbs)

        # Should NOT call ai.next because timeout is treated as success
        assert not ai.next.called
        # Should return empty list (or whatever the early return is)
        assert result == []


