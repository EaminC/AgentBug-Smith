[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set environment variables for Forge API (OpenAI-compatible)
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"

WORKDIR /app

# Copy entire repository
COPY . .

# Upgrade pip and install setuptools with constraint <=81.0.0
RUN python -m pip install --upgrade pip wheel && \
    pip install "setuptools<=81.0.0"

# Install system dependencies for building
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install all dependencies with specific versions to avoid conflicts
# First install langchain with a version that has get_openai_token_cost_for_model
# Based on research, langchain 0.0.280 is known to have this function
RUN pip install --break-system-packages "langchain==0.0.280"

# Now install other dependencies
RUN pip install --break-system-packages \
    black==23.3.0 \
    click>=8.0.0 \
    mypy==1.3.0 \
    openai==0.27.8 \
    pre-commit==3.3.3 \
    pytest==7.3.1 \
    ruff==0.0.272 \
    termcolor==2.3.0 \
    typer>=0.3.2 \
    rudder-sdk-python==2.0.2 \
    dataclasses-json==0.5.7 \
    tiktoken>=0.0.4 \
    tabulate==0.9.0 \
    python-dotenv>=0.21.0 \
    agent-protocol==1.0.1

# Install the project in editable mode with --no-deps to avoid upgrading langchain
RUN pip install --break-system-packages --no-deps -e .

# Install test dependencies (matching CI configuration) with pinned pytest version
RUN pip install --break-system-packages pytest==7.3.1 pytest-cov pytest-mock pytest-asyncio pytest-xdist pytest-timeout

# Install litellm and mem0ai as required by instructions
RUN pip install --break-system-packages litellm mem0ai

# Set Python path for script execution
ENV PYTHONPATH=/app

# Test critical imports to verify installation
RUN python -c "import sys; print(f'Python {sys.version}')"
RUN python -c "import pytest; print(f'✓ pytest {pytest.__version__}')"
RUN python -c "import langchain; print(f'✓ langchain {langchain.__version__}')"
# Test the specific import that was failing
RUN python -c "from langchain.callbacks.openai_info import get_openai_token_cost_for_model; print('✓ get_openai_token_cost_for_model import successful')"
RUN python -c "import gpt_engineer; print('✓ gpt-engineer imported')"
# Test key dependencies to ensure correct versions
RUN python -c "import openai; print(f'✓ openai {openai.__version__}')"
RUN python -c "import pydantic; print(f'✓ pydantic {pydantic.__version__}')"
RUN python -c "import dotenv; print(f'✓ python-dotenv {dotenv.__version__}')"
RUN python -c "print('\n✓ Environment ready for testing.')"

# Final command must be /bin/bash for test harness
CMD ["/bin/bash"]

