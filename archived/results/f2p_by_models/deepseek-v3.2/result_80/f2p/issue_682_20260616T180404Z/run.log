# Set environment variables for Forge API
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV AI_MAX_TOKENS="1000"
ENV AI_TOP_P="1"
ENV AI_FREQUENCY_PENALTY="0"
ENV AI_PRESENCE_PENALTY="0"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"

WORKDIR /app

# Copy entire repository
COPY . .

# Upgrade pip and install constrained setuptools
RUN python -m pip install --upgrade pip "setuptools<=81.0.0" wheel

# Install system dependencies for building
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install langchain 0.0.240 first - the exact minimum version specified
# This version should have get_openai_token_cost_for_model
RUN pip install "langchain==0.0.240"

# Install project dependencies from pyproject.toml
RUN pip install -e .

# Install test framework plugins that are compatible with pytest 7.3.1
RUN pip install \
    "pytest-mock>=3.10.0,<4.0.0" \
    "pytest-asyncio>=0.20.0,<2.0.0" \
    "pytest-cov>=4.0.0,<5.0.0" \
    "pytest-xdist>=3.0.0,<4.0.0" \
    "pytest-timeout>=2.0.0,<3.0.0" \
    anyio

# Install litellm for API compatibility
RUN pip install litellm

# Set Python path for script execution
ENV PYTHONPATH=/app

# Test critical imports with proper Docker syntax
RUN python -c "import sys; print(f'Python {sys.version}')"
RUN python -c "import gpt_engineer; print('✓ gpt-engineer imported')"
RUN python -c "from langchain.callbacks.openai_info import get_openai_token_cost_for_model; print('✓ get_openai_token_cost_for_model imported successfully')"
RUN python -c "import pytest; print(f'✓ pytest {pytest.__version__}')"
RUN python -c "import openai; print(f'✓ openai {openai.__version__}')"
RUN python -c "import langchain; print(f'✓ langchain {langchain.__version__}')"
RUN python -c "print('\nAll imports successful! Ready for testing.')"

# Final command must be /bin/bash for test harness
CMD ["/bin/bash"]

