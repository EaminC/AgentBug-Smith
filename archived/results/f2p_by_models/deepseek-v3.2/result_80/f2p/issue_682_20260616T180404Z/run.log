            result = self_heal(mock_ai, dbs)

        # AI.next should NOT be called because process succeeded
        mock_ai.next.assert_not_called()
        # The function returns messages (empty list? Actually returns messages variable which is empty list)
        # In the code, if process succeeds, it returns messages (which is empty list initially).
        assert result == []


def test_self_heal_timeout():
    """
    Test that self_heal handles timeout (timed_out = True).
    When timed_out is True, even if returncode != 0, we treat as success.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = Path(tmpdir) / "workspace"
        workspace_path.mkdir()
        logs_path = Path(tmpdir) / "logs"
        logs_path.mkdir()
        preprompts_path = Path(tmpdir) / "preprompts"
        preprompts_path.mkdir()
        memory_path = Path(tmpdir) / "memory"
        memory_path.mkdir()
        input_path = Path(tmpdir) / "input"
        input_path.mkdir()
        project_metadata_path = Path(tmpdir) / "project_metadata"
        project_metadata_path.mkdir()

        run_sh_path = workspace_path / "run.sh"
        run_sh_path.write_text("sleep 100")  # long running

        log_path = workspace_path / "log.txt"
        log_path.write_text("")

        preprompt_file = preprompts_path / "file_format_fix"
        preprompt_file.write_text("Please fix any errors in the code above.")

        dbs = DBs(
            memory=DB(memory_path),
            logs=DB(logs_path),
            preprompts=DB(preprompts_path),
            input=DB(input_path),
            workspace=DB(workspace_path),
            archive=None,
            project_metadata=DB(project_metadata_path),
        )

        mock_ai = Mock(spec=AI)
        mock_ai.fuser.side_effect = lambda x: x

        mock_process = Mock()
        mock_process.returncode = None  # Because timeout occurs before wait returns
        mock_process.wait = Mock(side_effect=subprocess.TimeoutExpired(cmd="bash run.sh", timeout=30))

        with patch('subprocess.Popen', return_value=mock_process) as mock_popen:
            result = self_heal(mock_ai, dbs)

        # AI.next should NOT be called because timed_out is True
        mock_ai.next.assert_not_called()
        # The function returns messages (empty list)
        assert result == []


def test_get_platform_info():
