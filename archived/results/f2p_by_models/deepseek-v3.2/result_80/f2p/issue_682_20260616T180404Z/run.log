    get_platform_info,
    MAX_SELF_HEAL_ATTEMPTS,
    ASSUME_WORKING_TIMEOUT,
)
from gpt_engineer.core.ai import AI
from gpt_engineer.core.db import DBs


def test_self_heal_with_failing_run_sh():
    """
    Test self_heal when run.sh fails (returncode != 0).
    Should call AI.next with error log and attempt to fix.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = os.path.join(tmpdir, "workspace")
        os.makedirs(workspace_path)
        run_sh_path = os.path.join(workspace_path, "run.sh")
        with open(run_sh_path, "w") as f:
            f.write("exit 1")

        dbs = Mock(spec=DBs)
        workspace_mock = Mock()
        workspace_mock.path = workspace_path
        workspace_mock.__getitem__ = Mock(return_value="log content")
        dbs.workspace = workspace_mock
        dbs.logs = {gen_entrypoint.__name__: "serialized messages"}
        dbs.preprompts = {"file_format_fix": "fix prompt"}

        ai = Mock(spec=AI)
        ai.fuser = Mock(return_value="fused message")
        ai.next = Mock(return_value=["msg1", "msg2"])
        ai.deserialize_messages = Mock(return_value=["deserialized"])

        with patch("gpt_engineer.core.steps.subprocess.Popen") as mock_popen:
            mock_process = Mock()
            mock_process.wait = Mock()
            mock_process.returncode = 1
            mock_popen.return_value = mock_process

            with patch("gpt_engineer.core.steps.to_files_and_memory") as mock_to_files:
                result = self_heal(ai, dbs)

                # Verify subprocess was called correctly
                mock_popen.assert_called_once_with(
                    "bash run.sh",
                    shell=True,
                    cwd=workspace_path,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    bufsize=0,
                )
                # Verify AI interactions
                ai.deserialize_messages.assert_called_once_with("serialized messages")
                assert ai.fuser.call_count >= 1
                ai.next.assert_called_once()
                # Verify to_files_and_memory was called to write fixes
                mock_to_files.assert_called_once()
                # Should return messages list
                assert isinstance(result, list)


def test_self_heal_with_successful_run_sh():
    """
    Test self_heal when run.sh succeeds (returncode == 0).
    Should return early without calling AI.next.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = os.path.join(tmpdir, "workspace")
        os.makedirs(workspace_path)
        run_sh_path = os.path.join(workspace_path, "run.sh")
        with open(run_sh_path, "w") as f:
            f.write("exit 0")

        dbs = Mock(spec=DBs)
        workspace_mock = Mock()
        workspace_mock.path = workspace_path
        workspace_mock.__getitem__ = Mock(return_value="")
        dbs.workspace = workspace_mock
        dbs.logs = {gen_entrypoint.__name__: "serialized messages"}
        dbs.preprompts = {"file_format_fix": "fix prompt"}

        ai = Mock(spec=AI)
        ai.fuser = Mock()
        ai.next = Mock()
        ai.deserialize_messages = Mock()

        with patch("gpt_engineer.core.steps.subprocess.Popen") as mock_popen:
            mock_process = Mock()
            mock_process.wait = Mock()
            mock_process.returncode = 0
            mock_popen.return_value = mock_process

            result = self_heal(ai, dbs)

            # Verify subprocess was called
            mock_popen.assert_called_once_with(
                "bash run.sh",
                shell=True,
                cwd=workspace_path,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                bufsize=0,
            )
            # AI should not be called
            ai.next.assert_not_called()
            # Should return messages (empty list from early return)
            assert result == []


def test_self_heal_timeout():
    """
    Test self_heal when run.sh times out.
    Should treat timeout as success (since timed_out is True and returncode may be None).
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = os.path.join(tmpdir, "workspace")
        os.makedirs(workspace_path)
        run_sh_path = os.path.join(workspace_path, "run.sh")
        with open(run_sh_path, "w") as f:
            f.write("sleep 100")  # long running script

        dbs = Mock(spec=DBs)
        workspace_mock = Mock()
        workspace_mock.path = workspace_path
        workspace_mock.__getitem__ = Mock(return_value="")
        dbs.workspace = workspace_mock
        dbs.logs = {gen_entrypoint.__name__: "serialized messages"}
        dbs.preprompts = {"file_format_fix": "fix prompt"}

        ai = Mock(spec=AI)
        ai.fuser = Mock(return_value="fused message")
        ai.next = Mock(return_value=["msg1", "msg2"])
        ai.deserialize_messages = Mock(return_value=["deserialized"])

        with patch("gpt_engineer.core.steps.subprocess.Popen") as mock_popen:
            mock_process = Mock()
            mock_process.wait = Mock(side_effect=subprocess.TimeoutExpired(cmd="bash run.sh", timeout=30))
            mock_process.returncode = None
            mock_popen.return_value = mock_process

            result = self_heal(ai, dbs)

            # Verify timeout was triggered
            mock_process.wait.assert_called_once_with(timeout=ASSUME_WORKING_TIMEOUT)
            # AI should not be called because timed_out is True
            ai.next.assert_not_called()
            # Should return messages (empty list from early return)
            assert result == []


