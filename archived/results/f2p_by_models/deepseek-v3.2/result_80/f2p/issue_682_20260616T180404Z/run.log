def test_self_heal_with_failing_run_sh():
    """
    Test that self_heal attempts to fix code when run.sh fails.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = Path(tmpdir) / "workspace"
        workspace_path.mkdir()
        logs_path = Path(tmpdir) / "logs"
        logs_path.mkdir()
        preprompts_path = Path(tmpdir) / "preprompts"
        preprompts_path.mkdir()
        memory_path = Path(tmpdir) / "memory"
        memory_path.mkdir()
        input_path = Path(tmpdir) / "input"
        input_path.mkdir()
        project_metadata_path = Path(tmpdir) / "project_metadata"
        project_metadata_path.mkdir()

        # Create a failing run.sh
        run_sh_path = workspace_path / "run.sh"
        run_sh_path.write_text("echo 'error'; exit 1")

        log_path = workspace_path / "log.txt"
        log_path.write_text("")

        preprompt_file = preprompts_path / "file_format_fix"
        preprompt_file.write_text("Please fix any errors in the code above.")

        # Simulate logs from previous step (gen_entrypoint)
        logs_entrypoint_path = logs_path / gen_entrypoint.__name__
        logs_entrypoint_path.write_text("previous messages")

        dbs = DBs(
            memory=DB(memory_path),
            logs=DB(logs_path),
            preprompts=DB(preprompts_path),
            input=DB(input_path),
            workspace=DB(workspace_path),
            archive=None,
            project_metadata=DB(project_metadata_path),
        )

        mock_ai = Mock(spec=AI)
        mock_ai.fuser = Mock(side_effect=lambda x: x)
        mock_ai.next = Mock(return_value=[Mock(content="fixed code")])
        mock_ai.deserialize_messages = Mock(return_value=[])

        # Mock subprocess.Popen to simulate failure
        mock_process = Mock()
        mock_process.wait = Mock()
        mock_process.returncode = 1
        with patch("subprocess.Popen", return_value=mock_process):
            result = self_heal(mock_ai, dbs)
            # Assert that AI.next was called because of failure
            mock_ai.next.assert_called_once()
            # Assert that we attempted to fix
            assert mock_ai.deserialize_messages.called


def test_self_heal_timeout():
    """
    Test that self_heal handles timeout correctly.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = Path(tmpdir) / "workspace"
        workspace_path.mkdir()
        logs_path = Path(tmpdir) / "logs"
        logs_path.mkdir()
        preprompts_path = Path(tmpdir) / "preprompts"
        preprompts_path.mkdir()
        memory_path = Path(tmpdir) / "memory"
        memory_path.mkdir()
        input_path = Path(tmpdir) / "input"
        input_path.mkdir()
        project_metadata_path = Path(tmpdir) / "project_metadata"
        project_metadata_path.mkdir()

        # Create a run.sh that will timeout
        run_sh_path = workspace_path / "run.sh"
        run_sh_path.write_text("sleep 60")

        log_path = workspace_path / "log.txt"
        log_path.write_text("")

        preprompt_file = preprompts_path / "file_format_fix"
        preprompt_file.write_text("Please fix any errors in the code above.")

        logs_entrypoint_path = logs_path / gen_entrypoint.__name__
        logs_entrypoint_path.write_text("previous messages")

        dbs = DBs(
            memory=DB(memory_path),
            logs=DB(logs_path),
            preprompts=DB(preprompts_path),
            input=DB(input_path),
            workspace=DB(workspace_path),
            archive=None,
            project_metadata=DB(project_metadata_path),
        )

        mock_ai = Mock(spec=AI)
        mock_ai.fuser = Mock(side_effect=lambda x: x)
        mock_ai.next = Mock(return_value=[Mock(content="fixed code")])
        mock_ai.deserialize_messages = Mock(return_value=[])

        # Mock subprocess.Popen to simulate timeout
        mock_process = Mock()
        # Simulate TimeoutExpired exception
        from subprocess import TimeoutExpired
        mock_process.wait = Mock(side_effect=TimeoutExpired(cmd="bash run.sh", timeout=30))
        mock_process.returncode = None
        with patch("subprocess.Popen", return_value=mock_process):
            result = self_heal(mock_ai, dbs)
            # In case of timeout, self_heal should treat it as success (since timed_out is True)
            # and return messages (should be empty list because no failure)
            # Actually, the function returns messages only if there was a failure.
            # Since timed_out is True and returncode is None, it should return messages (empty list?).
            # Let's check that AI.next was NOT called because timeout is not a failure.
            mock_ai.next.assert_not_called()


