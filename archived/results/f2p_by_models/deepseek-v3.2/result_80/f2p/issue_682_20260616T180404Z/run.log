            logs=DB(logs_path),
            preprompts=DB(preprompts_path),
            input=DB(Path(tmpdir) / "input"),
            workspace=DB(workspace_path),
            archive=None,
        )

        # Mock AI responses
        mock_ai = MagicMock(spec=AI)
        mock_ai.fuser.side_effect = lambda x: x
        # Simulate AI returning a fixed run.sh content
        fixed_content = """run.sh
```
echo 'fixed simulation'; exit 0
```"""
        mock_message = MagicMock()
        mock_message.content = fixed_content
        mock_ai.next.return_value = [mock_message]

        # Mock the logs from gen_entrypoint step
        fake_log_content = "Previous conversation log"
        dbs.logs["gen_entrypoint"] = fake_log_content

        # Mock subprocess.Popen to control return code
        mock_process = MagicMock()
        mock_process.returncode = 1
        mock_process.wait.side_effect = lambda timeout: None

        with patch('subprocess.Popen', return_value=mock_process) as mock_popen, \
             patch('gpt_engineer.core.steps.gen_entrypoint', MagicMock()) as mock_gen_entrypoint, \
             patch('gpt_engineer.core.steps.to_files_and_memory') as mock_to_files:

            # Call self_heal
            result = self_heal(mock_ai, dbs)

            # Verify subprocess was called with correct command
            mock_popen.assert_called_once_with(
                "bash run.sh",
                shell=True,
                cwd=workspace_path,
                stdout=log_path.open('w'),
                stderr=log_path.open('w'),
                bufsize=0,
            )

            # Verify AI.next was called because returncode != 0
            assert mock_ai.next.called
            # Verify to_files_and_memory was called with the fixed content
            mock_to_files.assert_called_once_with(fixed_content.strip(), dbs)

            # Verify result is the messages list
            assert result == [mock_message]

            # Verify the number of attempts is limited by MAX_SELF_HEAL_ATTEMPTS
            # In this test, we simulate one failure and then the AI returns a fix.
            # The loop should break after one attempt because we mock a successful fix.
            # Actually, the mock_process.returncode remains 1, but we mock AI.next to return a message.
            # The loop will run up to MAX_SELF_HEAL_ATTEMPTS times if we keep returning non-zero.
            # We'll check that Popen was called only once because we mock a single iteration.
            assert mock_popen.call_count == 1


def test_self_heal_with_successful_run_sh():
    """
    Test that self_heal returns early when run.sh succeeds.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = Path(tmpdir) / "workspace"
        workspace_path.mkdir()
        logs_path = Path(tmpdir) / "logs"
        logs_path.mkdir()
        preprompts_path = Path(tmpdir) / "preprompts"
        preprompts_path.mkdir()

        # Create a successful run.sh
        run_sh_path = workspace_path / "run.sh"
        run_sh_path.write_text("echo 'success'; exit 0")

        log_path = workspace_path / "log.txt"
        log_path.write_text("")

        preprompt_file = preprompts_path / "file_format_fix"
        preprompt_file.write_text("Please fix any errors in the code above.")

        dbs = DBs(
            memory=DB(Path(tmpdir) / "memory"),
            logs=DB(logs_path),
            preprompts=DB(preprompts_path),
            input=DB(Path(tmpdir) / "input"),
            workspace=DB(workspace_path),
            archive=None,
        )

        mock_ai = MagicMock(spec=AI)
        mock_ai.fuser.side_effect = lambda x: x

        mock_process = MagicMock()
        mock_process.returncode = 0
        mock_process.wait.side_effect = lambda timeout: None

        with patch('subprocess.Popen', return_value=mock_process) as mock_popen, \
             patch('gpt_engineer.core.steps.gen_entrypoint', MagicMock()):
            result = self_heal(mock_ai, dbs)

            # Verify subprocess was called
            mock_popen.assert_called_once()
            # Verify AI.next was NOT called because returncode == 0
            assert not mock_ai.next.called
            # Result should be empty list (messages) because early return
            assert result == []


def test_self_heal_timeout():
    """
    Test that self_heal handles timeout (timed_out = True).
    When timed_out is True, even if returncode != 0, we treat as success.
    """
    with tempfile.TemporaryDirectory() as tmpdir:
        workspace_path = Path(tmpdir) / "workspace"
        workspace_path.mkdir()
        logs_path = Path(tmpdir) / "logs"
        logs_path.mkdir()
        preprompts_path = Path(tmpdir) / "preprompts"
        preprompts_path.mkdir()

        run_sh_path = workspace_path / "run.sh"
        run_sh_path.write_text("sleep 100")  # long running

        log_path = workspace_path / "log.txt"
        log_path.write_text("")

        preprompt_file = preprompts_path / "file_format_fix"
        preprompt_file.write_text("Please fix any errors in the code above.")

        dbs = DBs(
            memory=DB(Path(tmpdir) / "memory"),
            logs=DB(logs_path),
            preprompts=DB(preprompts_path),
            input=DB(Path(tmpdir) / "input"),
            workspace=DB(workspace_path),
            archive=None,
        )

        mock_ai = MagicMock(spec=AI)
        mock_ai.fuser.side_effect = lambda x: x

        mock_process = MagicMock()
        mock_process.returncode = None  # Process didn't exit
        mock_process.wait.side_effect = lambda timeout: (_ for _ in []).throw(
            type('TimeoutExpired', (Exception,), {})()
        )

        with patch('subprocess.Popen', return_value=mock_process) as mock_popen, \
             patch('gpt_engineer.core.steps.gen_entrypoint', MagicMock()):
            result = self_heal(mock_ai, dbs)

            mock_popen.assert_called_once()
            # Since timed_out is True, AI.next should not be called (treated as success)
            assert not mock_ai.next.called
            assert result == []


