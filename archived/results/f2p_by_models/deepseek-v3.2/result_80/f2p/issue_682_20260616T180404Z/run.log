        # We need to mimic the exact format that gen_entrypoint would produce.
        # Let's look at the actual serialization in the codebase.
        # In ai.py, serialize_messages uses message.dict().
        # The message is a Langchain BaseMessage with type and content.
        # The dict includes additional fields like "data".
        # We'll replicate a minimal valid serialized message.
        logs_entrypoint_path = logs_path / gen_entrypoint.__name__
        # Create a list with one human message.
        serialized = [
            {
                "type": "human",
                "content": "test",
                "data": {"is_chunk": False},
            }
        ]
        logs_entrypoint_path.write_text(json.dumps(serialized))

        dbs = DBs(
            memory=DB(memory_path),
            logs=DB(logs_path),
            preprompts=DB(preprompts_path),
            input=DB(input_path),
            workspace=DB(workspace_path),
            archive=None,
            project_metadata=DB(project_metadata_path),
        )

        mock_ai = Mock(spec=AI)
        mock_ai.fuser = Mock(side_effect=lambda x: x)
        mock_ai.next = Mock(return_value=[Mock(content="fixed code")])
        mock_ai.deserialize_messages = Mock(return_value=[])

        # Mock subprocess.Popen to simulate failure
        mock_process = Mock()
        mock_process.wait = Mock()
        mock_process.returncode = 1
        with patch("subprocess.Popen", return_value=mock_process):
            result = self_heal(mock_ai, dbs)

        # Assert that AI.next was called (attempt to fix)
        assert mock_ai.next.called
        # The function returns messages list
        assert result is not None


def test_self_heal_with_successful_run_sh():
    with tempfile.TemporaryDirectory() as tmpdir:
        tmpdir = Path(tmpdir)
        workspace_path = tmpdir / "workspace"
        workspace_path.mkdir()
        logs_path = tmpdir / "logs"
        logs_path.mkdir()
        preprompts_path = tmpdir / "preprompts"
        preprompts_path.mkdir()
        memory_path = tmpdir / "memory"
        memory_path.mkdir()
        input_path = tmpdir / "input"
        input_path.mkdir()
        project_metadata_path = tmpdir / "project_metadata"
        project_metadata_path.mkdir()

        # Create a successful run.sh
        run_sh_path = workspace_path / "run.sh"
        run_sh_path.write_text("echo 'success'; exit 0")

        log_path = workspace_path / "log.txt"
        log_path.write_text("")

        preprompt_file = preprompts_path / "file_format_fix"
        preprompt_file.write_text("Please fix any errors in the code above.")

        logs_entrypoint_path = logs_path / gen_entrypoint.__name__
        serialized = [
            {
                "type": "human",
                "content": "test",
                "data": {"is_chunk": False},
            }
        ]
        logs_entrypoint_path.write_text(json.dumps(serialized))

        dbs = DBs(
            memory=DB(memory_path),
            logs=DB(logs_path),
            preprompts=DB(preprompts_path),
            input=DB(input_path),
            workspace=DB(workspace_path),
            archive=None,
            project_metadata=DB(project_metadata_path),
        )

        mock_ai = Mock(spec=AI)
        mock_ai.fuser = Mock(side_effect=lambda x: x)
        mock_ai.next = Mock(return_value=[Mock(content="fixed code")])
        mock_ai.deserialize_messages = Mock(return_value=[])

        # Mock subprocess.Popen to simulate success
        mock_process = Mock()
        mock_process.wait = Mock()
        mock_process.returncode = 0
        with patch("subprocess.Popen", return_value=mock_process):
            result = self_heal(mock_ai, dbs)

        # AI.next should not be called because process succeeded
        assert not mock_ai.next.called
        # The function returns messages (should be empty list?)
        # Actually, the code returns messages variable which may be empty list.
        # In the success path, it returns messages (which is empty list initially).
        # Let's just assert result is a list.
        assert isinstance(result, list)


