[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set environment variables for Forge API (OpenAI-compatible)
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"

WORKDIR /app

# Copy entire repository
COPY . .

# Upgrade pip and install setuptools
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies for building
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install project with all dependencies from pyproject.toml
RUN pip install --break-system-packages .

# Install required test packages
RUN pip install --break-system-packages \
    "pytest==7.3.1" \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    anyio \
    "setuptools<=81.0.0" \
    litellm \
    mem0ai

# Create patch for FixtureDef import issue
# FixtureDef is in _pytest.fixtures, not pytest module in pytest 7.3.1
RUN python -c "import sys; import _pytest.fixtures; import pytest; \
if not hasattr(pytest, 'FixtureDef'): \
    pytest.FixtureDef = _pytest.fixtures.FixtureDef; \
    sys.modules['pytest'].FixtureDef = _pytest.fixtures.FixtureDef; \
    print('✓ FixtureDef patched into pytest module'); \
else: \
    print('✓ FixtureDef already in pytest module')"

# Set Python path for script execution
ENV PYTHONPATH=/app

# Test critical imports
RUN python -c "import sys; print(f'Python {sys.version}')"
RUN python -c "import pytest; print(f'✓ pytest {pytest.__version__}')"
RUN python -c "print(f'✓ FixtureDef in pytest: {hasattr(pytest, \"FixtureDef\")}')"
RUN python -c "import gpt_engineer; print('✓ gpt-engineer imported')"
RUN python -c "print('\nEnvironment ready for testing.')"

# Final command must be /bin/bash for test harness
CMD ["/bin/bash"]

