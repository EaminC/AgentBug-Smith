[32mimport pytest
from aider.models import Model
from aider.resources.model_metadata import ModelMetadata


def test_bedrock_claude_4_5_support():
    """
    Test that the Bedrock/Claude 4.5 model is correctly registered and has the expected settings.
    """
    model_name = "bedrock/global.anthropic.claude-sonnet-4-5-20250929-v1:0"
    
    # Check that the model is recognized by ModelMetadata
    metadata = ModelMetadata()
    model_info = metadata.get_model_info(model_name)
    assert model_info is not None, f"Model {model_name} not found in metadata"
    
    # Verify specific settings from the patch
    assert model_info["edit_format"] == "diff"
    assert model_info["weak_model_name"] == "bedrock/anthropic.claude-3-5-haiku-20241022-v1:0"
    assert model_info["use_repo_map"] is True
    assert model_info["examples_as_sys_msg"] is False
    assert "extra_params" in model_info
    extra_params = model_info["extra_params"]
    assert "extra_headers" in extra_params
    assert extra_params["extra_headers"]["anthropic-beta"] == "prompt-caching-2024-07-31,pdfs-2024-09-25,output-128k-2025-02-19"
    assert extra_params["max_tokens"] == 64000
    assert model_info["cache_control"] is True
    assert model_info["editor_model_name"] == model_name
    assert model_info["editor_edit_format"] == "editor-diff"
    assert "thinking_tokens" in model_info["accepts_settings"]
    
    # Check that the model can be instantiated (without making actual API calls)
    # We'll mock the internal Bedrock client to avoid network calls
    import sys
    from unittest.mock import Mock, patch
    
    # Mock boto3 session and client to avoid AWS credentials
    with patch("boto3.Session") as mock_session:
        mock_client = Mock()
        mock_session.return_value.client.return_value = mock_client
        # Mock the invoke_model response to return a valid dummy response
        mock_client.invoke_model.return_value = {
            "body": b'{"content": [{"text": "test response"}]}'
        }
        
        # Create model instance
        model = Model(model_name)
        
        # Verify model attributes
        assert model.name == model_name
        assert model.edit_format == "diff"
        assert model.weak_model_name == "bedrock/anthropic.claude-3-5-haiku-20241022-v1:0"
        assert model.use_repo_map is True
        assert model.examples_as_sys_msg is False
        assert model.cache_control is True
        assert model.editor_model_name == model_name
        assert model.editor_edit_format == "editor-diff"
        assert "thinking_tokens" in model.accepts_settings
        
        # Verify extra_params are passed through
        assert "extra_headers" in model.extra_params
        assert model.extra_params["extra_headers"]["anthropic-beta"] == "prompt-caching-2024-07-31,pdfs-2024-09-25,output-128k-2025-02-19"
        assert model.extra_params["max_tokens"] == 64000


def test_bedrock_claude_4_5_in_model_list():
    """
    Test that the Bedrock/Claude 4.5 model appears in the list of available models.
    """
    model_name = "bedrock/global.anthropic.claude-sonnet-4-5-20250929-v1:0"
    
    # Get all model names from ModelMetadata
    metadata = ModelMetadata()
    all_models = metadata.models
    
    # Check that our model is in the list
    assert model_name in all_models, f"Model {model_name} not in available models list"
    
    # Also check via Model.get_all_models() if available
    try:
        all_model_names = Model.get_all_models()
        assert model_name in all_model_names, f"Model {model_name} not in Model.get_all_models()"
    except AttributeError:
        # Some versions might not have this method, that's okay
        pass


