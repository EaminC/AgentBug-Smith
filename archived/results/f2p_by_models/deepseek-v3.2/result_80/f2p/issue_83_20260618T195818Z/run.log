[32mFROM python:3.10-slim AS test_builder

WORKDIR /app

# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository (including any externally injected test scripts)
COPY . .

# Detect src layout to avoid duplicate module loading
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." . 2>/dev/null; then \
    echo "Detected src layout or src imports; skipping editable install" && \
    ENV_SRC_LAYOUT=true; \
    else \
    echo "No src layout detected; will perform editable install" && \
    ENV_SRC_LAYOUT=false; \
    fi

# Set Forge environment variables (required for test harness)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Install dependencies and test tooling
# Branch based on detected package manager files
RUN if [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt && \
    if [ "$ENV_SRC_LAYOUT" = "false" ]; then pip install -e .; fi; \
    elif [ -f "pyproject.toml" ]; then \
    if [ -f "poetry.lock" ]; then \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi; \
        if [ "$ENV_SRC_LAYOUT" = "false" ]; then pip install -e .; fi; \
    else \
        # No lockfile; install via pip editable
        if [ "$ENV_SRC_LAYOUT" = "false" ]; then pip install -e .; fi; \
    fi; \
    else \
    # No requirements.txt or pyproject.toml; install only test tooling
    echo "No dependency file found; installing test tooling only"; \
    fi && \
    # Unconditionally install test frameworks (critical)
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# If src layout detected, set PYTHONPATH to allow imports without editable install
RUN if [ "$ENV_SRC_LAYOUT" = "true" ]; then \
    echo "Setting PYTHONPATH for src layout" && \
    export PYTHONPATH=/app && \
    echo "export PYTHONPATH=/app" >> ~/.bashrc; \
    fi

# Preflight import check to fail fast
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

# Multi‑stage: production image (minimal)
