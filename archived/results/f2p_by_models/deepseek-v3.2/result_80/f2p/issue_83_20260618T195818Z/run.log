import os
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from dapr_agents.tool.mcp.client import MCPClient
from dapr_agents.types.exceptions import ToolError
from unittest.mock import Mock, patch
import pytest


class MockResult:
    """Mock result object for testing."""
    def __init__(self, isError=False, content=None):
        self.isError = isError
        self.content = content


class MockContent:
    """Mock content object with text attribute."""
    def __init__(self, text):
        self.text = text


def test_mcp_client_process_tool_result_error_with_content():
    """Test that when MCP server returns an error with content.text, the content is returned instead of raising ToolError."""
    client = MCPClient()
    
    # Simulate an error result that contains content with text
    error_content = [MockContent(text="Server error: invalid input")]
    result = MockResult(isError=True, content=error_content)
    
    # In buggy code, this would raise ToolError
    # In fixed code, this should return the text content
    output = client._process_tool_result(result)
    
    # After fix: content should be returned
    assert output == "Server error: invalid input"


def test_mcp_client_process_tool_result_error_without_content():
    """Test that when MCP server returns an error without content.text, ToolError is raised."""
    client = MCPClient()
    
    # Simulate an error result without content
    result = MockResult(isError=True, content=None)
    
    # This should raise ToolError in both buggy and fixed code
    with pytest.raises(ToolError, match="MCP tool error:"):
        client._process_tool_result(result)


def test_mcp_client_process_tool_result_error_with_empty_content():
    """Test that when MCP server returns an error with empty content list, ToolError is raised."""
    client = MCPClient()
    
    # Simulate an error result with empty content list
    result = MockResult(isError=True, content=[])
    
    # This should raise ToolError in both buggy and fixed code
    with pytest.raises(ToolError, match="MCP tool error:"):
        client._process_tool_result(result)


def test_mcp_client_process_tool_result_error_with_content_no_text():
    """Test that when MCP server returns an error with content but no text attribute, ToolError is raised."""
    client = MCPClient()
    
    # Simulate an error result with content that lacks text attribute
    class ContentWithoutText:
        pass
    
    error_content = [ContentWithoutText()]
    result = MockResult(isError=True, content=error_content)
    
    # This should raise ToolError in both buggy and fixed code
    with pytest.raises(ToolError, match="MCP tool error:"):
        client._process_tool_result(result)


def test_mcp_client_process_tool_result_success_with_content():
    """Test that when MCP server returns success with content, content is returned."""
    client = MCPClient()
    
    # Simulate a successful result with content
    success_content = [MockContent(text="Operation completed successfully")]
    result = MockResult(isError=False, content=success_content)
    
    # This should return content in both buggy and fixed code
    output = client._process_tool_result(result)
    assert output == "Operation completed successfully"


def test_mcp_client_process_tool_result_multiple_content_items():
    """Test that when MCP server returns multiple content items, they are returned as a list."""
    client = MCPClient()
    
    # Simulate result with multiple content items
    content_items = [
        MockContent(text="First message"),
        MockContent(text="Second message")
    ]
    result = MockResult(isError=False, content=content_items)
    
    output = client._process_tool_result(result)
    assert output == ["First message", "Second message"]


def test_mcp_client_process_tool_result_no_content_attribute():
    """Test that when result has no content attribute, it falls back to string representation."""
    client = MCPClient()
    
    # Simulate result without content attribute
    class SimpleResult:
        def __init__(self, isError=False):
            self.isError = isError
        
        def __str__(self):
            return "Simple result"
    
    result = SimpleResult(isError=False)
    
    output = client._process_tool_result(result)
    assert output == "Simple result"


def test_mcp_client_integration_with_toolcall_response():
    """Integration test simulating the toolcall response scenario described in the issue."""
    from dapr_agents.agent.patterns.toolcall.base import ToolCallResponse
    
    # Create a mock toolcall response that would come from MCP server
    response = ToolCallResponse()
    
    # Simulate what happens in the buggy scenario
    client = MCPClient()
    
    # Create an error result with content (as described in issue)
    error_content = [MockContent(text="MCP server error: validation failed")]
    result = MockResult(isError=True, content=error_content)
    
    # In buggy code: _process_tool_result raises ToolError immediately
    # In fixed code: _process_tool_result returns the text content
    try:
        content = client._process_tool_result(result)
        # Fixed code path: content should be the error text
        assert content == "MCP server error: validation failed"
        # This would allow the model to learn from the error
    except ToolError as e:
        # Buggy code path: ToolError is raised
        # We need to verify this happens in buggy code
        # The test will fail on fixed code if we reach here
        raise AssertionError("ToolError should not be raised when error has content.text")


