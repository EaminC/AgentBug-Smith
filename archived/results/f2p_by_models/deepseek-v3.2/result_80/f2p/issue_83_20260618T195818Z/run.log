[32mimport pytest
from unittest.mock import Mock, patch
from dapr_agents.tool.mcp.client import MCPClient
from dapr_agents.types.exceptions import ToolError


class MockResult:
    """Mock result object with isError and content attributes."""
    def __init__(self, isError=False, content=None):
        self.isError = isError
        self.content = content

    def __str__(self):
        return f"<MockResult isError={self.isError}>"


class MockContent:
    """Mock content object with text attribute."""
    def __init__(self, text=None):
        self.text = text


def test_mcp_client_process_tool_result_single_text():
    """Test processing result with single text content."""
    client = MCPClient()
    content = [MockContent(text="Result text")]
    result = MockResult(isError=False, content=content)
    output = client._process_tool_result(result)
    assert output == "Result text"


def test_mcp_client_process_tool_result_multiple_text():
    """Test processing result with multiple text contents."""
    client = MCPClient()
    content = [MockContent(text="First"), MockContent(text="Second")]
    result = MockResult(isError=False, content=content)
    output = client._process_tool_result(result)
    assert output == ["First", "Second"]


def test_mcp_client_process_tool_result_no_content():
    """Test processing result without content."""
    client = MCPClient()
    result = MockResult(isError=False, content=None)
    output = client._process_tool_result(result)
    assert output == str(result)


def test_mcp_client_process_tool_result_content_without_text():
