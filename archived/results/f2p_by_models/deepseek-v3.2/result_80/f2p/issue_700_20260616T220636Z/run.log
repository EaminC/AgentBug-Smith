[32mimport sys
import os
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from aider.models import ModelInfoManager, MODEL_SETTINGS
from aider.coders import Coder


def test_vertex_ai_claude_models_in_settings():
    """Check that vertex_ai/claude-* models are present in MODEL_SETTINGS and have correct edit_format."""
    # The bug: vertex_ai/claude-3-5-sonnet@20240620 and vertex_ai/claude-3-opus@20240229
    # were missing from MODEL_SETTINGS, causing fallback to whole-file editing.
    # The fix adds them with edit_format="diff" and use_repo_map=True.
    # We'll test that they are present and have the expected settings.

    # Collect all model names from MODEL_SETTINGS
    model_names = [settings.model for settings in MODEL_SETTINGS]

    # The two models that should be present after the fix
    expected_models = [
        "vertex_ai/claude-3-5-sonnet@20240620",
        "vertex_ai/claude-3-opus@20240229",
    ]

    for expected in expected_models:
        assert expected in model_names, f"Model {expected} not found in MODEL_SETTINGS"

    # Now verify their settings
    for settings in MODEL_SETTINGS:
        if settings.model in expected_models:
            # According to the patch, both should have edit_format="diff" and use_repo_map=True
            assert settings.edit_format == "diff", f"Model {settings.model} edit_format should be 'diff', got {settings.edit_format}"
            assert settings.use_repo_map is True, f"Model {settings.model} use_repo_map should be True, got {settings.use_repo_map}"
            # vertex_ai/claude-3-opus@20240229 also has send_undo_reply=True
            if settings.model == "vertex_ai/claude-3-opus@20240229":
                assert settings.send_undo_reply is True, f"Model {settings.model} send_undo_reply should be True, got {settings.send_undo_reply}"
            # vertex_ai/claude-3-5-sonnet@20240620 does not have send_undo_reply set (defaults to False)
            if settings.model == "vertex_ai/claude-3-5-sonnet@20240620":
                assert settings.send_undo_reply is False, f"Model {settings.model} send_undo_reply should be False, got {settings.send_undo_reply}"

    # Additionally, test that ModelInfoManager picks up the correct edit_format for these models
    mim = ModelInfoManager()
    for model in expected_models:
        info = mim.get_model_info(model)
        # The buggy code would have edit_format="whole" because it falls back to default.
        # The fixed code should have edit_format="diff".
        assert info.edit_format == "diff", f"ModelInfoManager for {model} should have edit_format='diff', got {info.edit_format}"
        assert info.use_repo_map is True, f"ModelInfoManager for {model} should have use_repo_map=True, got {info.use_repo_map}"


def test_vertex_ai_claude_model_parsing():
    """Test that the model name with @ is correctly matched in MODEL_SETTINGS."""
    # The issue states that the provider/model match expects hyphen before build identifier,
    # but vertex_ai uses @. The fix adds entries with @, so matching should work.
    mim = ModelInfoManager()
    # This should not fall back to whole-file editing (edit_format="whole") after the fix.
    info = mim.get_model_info("vertex_ai/claude-3-5-sonnet@20240620")
    assert info.edit_format == "diff"
    assert info.use_repo_map is True

    info2 = mim.get_model_info("vertex_ai/claude-3-opus@20240229")
    assert info2.edit_format == "diff"
    assert info2.use_repo_map is True
    assert info2.send_undo_reply is True


if __name__ == "__main__":
    # Run tests manually if executed as script
    test_vertex_ai_claude_models_in_settings()
    test_vertex_ai_claude_model_parsing()
    print("All tests passed")[0m
