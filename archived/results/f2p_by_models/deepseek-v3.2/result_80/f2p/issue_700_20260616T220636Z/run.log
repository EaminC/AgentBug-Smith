[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Set environment variables for Forge
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}
# Set other environment variables to prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies for Python packages (based on evidence in workflow files)
RUN apt-get update && apt-get install -y --no-install-recommends \
    universal-ctags \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository (including any externally injected test scripts)
COPY . .

# Upgrade packaging tools early
RUN python -m pip install --upgrade pip setuptools wheel

# Install dependencies from requirements.txt (exists per evidence)
# Also install the project itself (editable) and mandatory test dependencies
# Check for src/ layout to avoid duplicate module loading
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." . 2>/dev/null; then \
    pip install -r requirements.txt && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    ENV PYTHONPATH=/app; \
    else \
    pip install -r requirements.txt && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Preflight import check to verify core modules are available
RUN python -c 'import pkg_resources, pytest, aider; print("preflight ok")'

# Run the project's existing test suite (as per .github/workflows/*.yml)
CMD ["python", "-m", "unittest", "discover", "-s", "aider/tests"]

# Second stage: minimal runtime image
FROM python:3.12-slim AS runtime

WORKDIR /app

# Set environment variables for Forge (same as test stage)
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}
ENV DEBIAN_FRONTEND=noninteractive

# Install runtime system dependencies (ctags is required per workflow files)
RUN apt-get update && apt-get install -y --no-install-recommends \
    universal-ctags \
    && rm -rf /var/lib/apt/lists/*

# Copy only the necessary artifacts from the test builder
COPY --from=test_builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=test_builder /app/aider /app/aider
COPY --from=test_builder /app/requirements.txt /app/requirements.txt
COPY --from=test_builder /app/setup.py /app/setup.py
COPY --from=test_builder /app/README.md /app/README.md

# Ensure the entry point is available
ENTRYPOINT ["aider"]

# Default command (can be overridden)
CMD ["/bin/bash"][0m
