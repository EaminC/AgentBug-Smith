FROM python:3.10-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Install system dependencies for Python packages
RUN apt-get update && apt-get install -y \
    curl \
    jq \
    wget \
    git \
    ca-certificates \
    gcc \
    g++ \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    libssl-dev \
    libffi-dev \
    zlib1g-dev \
    libjpeg-dev \
    libpng-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip "setuptools<=81.0.0" wheel

# Create and activate virtual environment to avoid PEP 668 issues
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy entire repository
COPY . .

# Set up Forge API environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0
ENV ANTHROPIC_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key

# Install PyYAML first to avoid build issues
RUN pip install "PyYAML==6.0.3"

# Install core dependencies from requirements.txt
# First install the exact version specified in requirements.txt
RUN pip install "openai==0.27.2"

# Verify OpenAI installation
RUN python -c "
import pkg_resources
version = pkg_resources.get_distribution('openai').version
print(f'OpenAI version installed: {version}')

import openai
print(f'OpenAI __version__ attribute: {openai.__version__}')

# Try to import api_resources
try:
    import openai.api_resources
    print('openai.api_resources import SUCCESS')

    # Try to import the specific module needed
    try:
        import openai.api_resources.abstract.engine_api_resource
        print('openai.api_resources.abstract.engine_api_resource import SUCCESS')
    except ImportError as e:
        print(f'openai.api_resources.abstract.engine_api_resource import FAILED: {e}')
        print('\\nChecking what exists in openai.api_resources...')
        import inspect
        print('Attributes in openai.api_resources:')
        for name in dir(openai.api_resources):
            if not name.startswith('_'):
                print(f'  {name}')

        # Check if 'abstract' exists
        if hasattr(openai.api_resources, 'abstract'):
            print('\\nopenai.api_resources.abstract exists')
            print('Attributes in openai.api_resources.abstract:')
            for name in dir(openai.api_resources.abstract):
                if not name.startswith('_'):
                    print(f'  {name}')
        else:
            print('\\nopenai.api_resources.abstract does not exist')

except ImportError as e:
    print(f'openai.api_resources import FAILED: {e}')
    print('\\nChecking openai module structure...')
    import inspect
    print(f'openai module file: {inspect.getfile(openai)}')
    print('\\nAttributes in openai module:')
    for name in dir(openai):
        if not name.startswith('_'):
            print(f'  {name}')
"

# Now install other dependencies
RUN if [ -f "requirements.txt" ]; then \
        echo "Installing dependencies from requirements.txt"; \
        # Filter out openai from requirements.txt since we already installed it
        grep -v "^openai==" requirements.txt > /tmp/requirements_filtered.txt || true; \
        # Try to install filtered requirements
        pip install -r /tmp/requirements_filtered.txt || echo "Some packages failed to install, continuing..."; \
    else \
        echo "No requirements.txt found"; \
    fi

# Install the package in development mode
RUN pip install -e . || echo "Package installation failed, continuing..."

# Also set PYTHONPATH for good measure
ENV PYTHONPATH=/app

# Install test dependencies
RUN pip install \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    anyio \
    litellm \
    pytest-xdist \
    pytest-timeout \
    mem0ai \
    vcrpy \
    pytest-recording \
    pytest-benchmark \
    pytest-integration


# Final verification
RUN python -c "
import os
print('=== FINAL VERIFICATION ===')
print(f'OPENAI_BASE_URL: {os.getenv(\"OPENAI_BASE_URL\")}')
print(f'ANTHROPIC_BASE_URL: {os.getenv(\"ANTHROPIC_BASE_URL\")}')

# Test critical imports
imports_to_test = [
    'openai',
    'openai.api_resources',
    'openai.api_resources.abstract.engine_api_resource',
    'openai.api_requestor',
    'yaml',
    'autogpt',
    'autogpt.llm.utils',
    'tests.integration.agent_factory'
]

all_passed = True
for import_name in imports_to_test:
    try:
        if '.' in import_name:
            # Handle dotted imports
            parts = import_name.split('.')
            module = __import__(parts[0])
            for part in parts[1:]:
                module = getattr(module, part)
            print(f'✓ {import_name}')
        else:
            __import__(import_name)
            print(f'✓ {import_name}')
    except ImportError as e:
        print(f'✗ {import_name}: {e}')
        all_passed = False
    except Exception as e:
        print(f'✗ {import_name}: {type(e).__name__}: {e}')
        all_passed = False

if all_passed:
    print('\\n✅ All imports successful!')
else:
    print('\\n❌ Some imports failed')
    import sys
    print(f'\\nPython version: {sys.version}')
    print(f'Python path:')
    for p in sys.path[:10]:
        print(f'  {p}')
"

