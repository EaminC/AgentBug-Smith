ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"

WORKDIR /app

# Install system dependencies for Python packages
RUN apt-get update && apt-get install -y \
    curl \
    git \
    gcc \
    g++ \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    libjpeg-dev \
    zlib1g-dev \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build tools
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Install all dependencies from requirements.txt including test dependencies
# The requirements.txt already includes test dependencies at the bottom
RUN pip install -r requirements.txt

# Install additional test dependencies that might not be in requirements.txt
RUN pip install \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    vcrpy \
    "setuptools<=81.0.0"

# Install the project in development mode
RUN pip install -e .

# Set PYTHONPATH to include /app for imports
ENV PYTHONPATH=/app:$PYTHONPATH

# Simple verification that imports work
RUN python -c "import autogpt; print('✓ autogpt imported successfully')"
RUN python -c "import openai; print(f'✓ OpenAI {openai.__version__} imported'); assert openai.__version__ == '0.27.2', f'Expected 0.27.2, got {openai.__version__}'"

