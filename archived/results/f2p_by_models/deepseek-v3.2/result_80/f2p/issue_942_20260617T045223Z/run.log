WORKDIR /app

# Install system dependencies for Python packages that need compilation
# Also install browser dependencies for Selenium tests
RUN apt-get update && apt-get install -y \
    curl \
    jq \
    wget \
    git \
    ca-certificates \
    gcc \
    g++ \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    libssl-dev \
    libffi-dev \
    zlib1g-dev \
    libjpeg-dev \
    libpng-dev \
    libpq-dev \
    chromium \
