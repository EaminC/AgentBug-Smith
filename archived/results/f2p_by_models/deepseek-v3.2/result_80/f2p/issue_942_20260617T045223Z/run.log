FROM python:3.11-slim

# Use Python 3.11 for better compatibility with packages

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-YzQxc4137fbc8de99e8b65e6b349a8f3d6"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-YzQxc4137fbc8de99e8b65e6b349a8f3d6"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-YzQxc4137fbc8de99e8b65e6b349a8f3d6"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

WORKDIR /app

# Install system dependencies for Python packages
RUN apt-get update && apt-get install -y \
    curl \
    jq \
    wget \
    git \
    ca-certificates \
    gcc \
    g++ \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    libssl-dev \
    libffi-dev \
    zlib1g-dev \
    libjpeg-dev \
    libpng-dev \
    libpq-dev \
    chromium \
    chromium-driver \
    firefox-esr \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Set up Forge API environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-YzQxc4137fbc8de99e8b65e6b349a8f3d6
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-YzQxc4137fbc8de99e8b65e6b349a8f3d6
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0
ENV ANTHROPIC_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key

# Install PyYAML 6.0.3 (compatible version) first to avoid build issues
RUN pip install "PyYAML==6.0.3"

# Install dependencies from requirements.txt, skipping problematic ones
# We'll handle spacy and other complex packages separately
RUN if [ -f "requirements.txt" ]; then \
        echo "Installing dependencies from requirements.txt"; \
        # Create filtered requirements without problematic packages
        grep -v "pyyaml==6.0" requirements.txt > /tmp/requirements_filtered.txt || true; \
        grep -v "^pyyaml==" /tmp/requirements_filtered.txt > /tmp/requirements_final.txt || true; \
        # Install basic dependencies
        pip install -r /tmp/requirements_final.txt || echo "Some packages failed to install, continuing..."; \
    else \
        echo "No requirements.txt found"; \
    fi

# Install spacy separately with --only-binary flag
RUN pip install "spacy>=3.0.0,<4.0.0" --only-binary :all: || \
    echo "spacy installation failed, continuing without it"

# Install the package in development mode (skip if it fails due to missing dependencies)
RUN pip install -e . || echo "Package installation failed, continuing..."

# Install test dependencies
RUN pip install \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    anyio \
    litellm \
    pytest-xdist \
    pytest-timeout \
    mem0ai

# Set PYTHONPATH to include /app for imports
ENV PYTHONPATH=/app

# Verify environment is configured for Forge API
RUN python -c "import os; print('Forge API configuration verified:'); print(f'OPENAI_BASE_URL: {os.getenv(\"OPENAI_BASE_URL\")}'); print(f'ANTHROPIC_BASE_URL: {os.getenv(\"ANTHROPIC_BASE_URL\")}'); import openai; import yaml; print('Core imports successful')"

