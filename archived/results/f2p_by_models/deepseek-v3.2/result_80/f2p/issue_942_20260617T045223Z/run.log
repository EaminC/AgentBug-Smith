FROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"
# --- end inject ---

# Set environment variables for Forge API
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"

WORKDIR /app

# Install system dependencies for Python packages
RUN apt-get update && apt-get install -y \
    curl \
    git \
    gcc \
    g++ \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    libjpeg-dev \
    zlib1g-dev \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build tools
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Install project dependencies from requirements.txt
# Install core dependencies first to avoid conflicts
RUN pip install \
    beautifulsoup4>=4.12.2 \
    colorama==0.4.6 \
    distro==1.8.0 \
    openai==0.27.2 \
    python-dotenv==1.0.0 \
    pyyaml==6.0 \
    requests \
    gitpython==3.1.31 \
    click

# Install auto-gpt-plugin-template from git (required by the project)
RUN pip install git+https://github.com/Significant-Gravitas/Auto-GPT-Plugin-Template@0.1.0

# Install remaining dependencies from requirements.txt
# Skip the ones already installed to avoid conflicts
RUN pip install -r requirements.txt

# Install test dependencies - install litellm first which may upgrade openai
# Then force reinstall openai==0.27.2 to maintain compatibility
RUN pip install \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    vcrpy \
    litellm \
    mem0ai \
    "setuptools<=81.0.0" \
    && pip install --force-reinstall "openai==0.27.2"

# Install the project in development mode
RUN pip install -e .

# Set PYTHONPATH to include /app for imports
ENV PYTHONPATH=/app:$PYTHONPATH

# Create a simple verification script
RUN cat > /tmp/verify.py << 'EOF'
import sys
import os

try:
    # Add current directory to path
    sys.path.insert(0, '/app')

    import autogpt
    print('✓ autogpt imported successfully')

    import auto_gpt_plugin_template
    print('✓ auto_gpt_plugin_template imported successfully')

    import openai
    print('✓ OpenAI version: ' + openai.__version__)

    # Check that it's the correct version
    if openai.__version__ != '0.27.2':
        print('✗ Wrong OpenAI version: ' + openai.__version__ + ', expected 0.27.2')
        sys.exit(1)

    print('✓ OPENAI_BASE_URL env var: ' + str(os.getenv('OPENAI_BASE_URL')))
    print('✓ FORGE_API_KEY env var: ' + str(os.getenv('FORGE_API_KEY')))

    print('✓ All checks passed')
    sys.exit(0)
except Exception as e:
    print('✗ Error: ' + str(e))
    import traceback
    traceback.print_exc()
    sys.exit(1)
EOF

# Run verification
RUN python /tmp/verify.py

