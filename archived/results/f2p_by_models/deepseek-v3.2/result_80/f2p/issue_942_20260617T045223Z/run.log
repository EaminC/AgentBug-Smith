[32mFROM python:3.10-slim AS builder

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    jq \
    wget \
    git \
    chromium-driver \
    firefox-esr \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Detect src layout or imports from src
RUN if [ -d "src" ] || grep -rq "^\s*from src\.\|^\s*import src\." . 2>/dev/null; then \
        echo "src layout detected, skipping editable install, setting PYTHONPATH"; \
        ENV_PYTHONPATH=1; \
    else \
        echo "No src layout, will do editable install"; \
        ENV_PYTHONPATH=0; \
    fi

# Install dependencies based on available files
RUN if [ -f "requirements.txt" ]; then \
        echo "Installing from requirements.txt"; \
        pip install -r requirements.txt; \
    else \
        echo "No requirements.txt found"; \
    fi

# Install test dependencies unconditionally
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Conditionally install project in editable mode or set PYTHONPATH
RUN if [ "$ENV_PYTHONPATH" = "1" ]; then \
        echo "Skipping editable install, using PYTHONPATH"; \
    else \
        pip install -e .; \
    fi

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}
ENV PYTHONPATH=/app

# Preflight check
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

