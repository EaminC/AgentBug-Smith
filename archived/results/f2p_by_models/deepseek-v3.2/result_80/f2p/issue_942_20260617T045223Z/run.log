    firefox-esr \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel

# Copy entire repository
COPY . .

# Install dependencies from requirements.txt with --break-system-packages for Python 3.12
# Combine installation to ensure proper dependency resolution
RUN if [ -f "requirements.txt" ]; then \
        echo "Installing from requirements.txt"; \
        pip install --break-system-packages -r requirements.txt \
        && pip install --break-system-packages pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai \
        && pip install --break-system-packages -e .; \
    else \
        echo "No requirements.txt found"; \
        pip install --break-system-packages pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai \
        && pip install --break-system-packages -e .; \
    fi

# Set Forge environment variables with actual values
ENV FORGE_API_KEY=forge-key
ENV FORGE_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co/v1
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV AI_TEMPERATURE=0.7
ENV AI_MAX_TOKENS=1000
ENV AI_TOP_P=1
ENV AI_FREQUENCY_PENALTY=0
ENV AI_PRESENCE_PENALTY=0
