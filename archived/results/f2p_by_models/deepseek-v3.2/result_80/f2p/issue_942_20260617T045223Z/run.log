        echo "No requirements.txt found"; \
    fi

# Install the package in development mode
RUN pip install -e . || echo "Package installation may have issues, continuing..."

# Set PYTHONPATH for good measure
ENV PYTHONPATH=/app

# Install test dependencies
RUN pip install \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    anyio \
    litellm \
    pytest-xdist \
    pytest-timeout \
    mem0ai \
    vcrpy \
    pytest-recording \
    pytest-benchmark \
    pytest-integration \
    asynctest \
    || echo "Some test dependencies may have failed, continuing..."

# Simple verification
RUN python -c "import openai; print(f'OpenAI version: {openai.__version__}')"
RUN python -c "import os; print(f'OPENAI_BASE_URL: {os.getenv(\"OPENAI_BASE_URL\")}'); print(f'ANTHROPIC_BASE_URL: {os.getenv(\"ANTHROPIC_BASE_URL\")}')"

# Verify critical imports for AutoGPT
RUN python -c "import sys; print('Python version:', sys.version); print('Python path:'); [print(' ', p) for p in sys.path[:5]]"
RUN python -c "try: import autogpt; print('✓ autogpt imported successfully'); except Exception as e: print(f'✗ Failed to import autogpt: {e}')"
RUN python -c "try: import openai; print(f'✓ openai imported successfully (version: {openai.__version__})'); except Exception as e: print(f'✗ Failed to import openai: {e}')"
RUN python -c "try: import dotenv; print('✓ python-dotenv imported successfully'); except Exception as e: print(f'✗ Failed to import dotenv: {e}')"

# Verify spacy model was installed
RUN python -c "try: import spacy; nlp = spacy.load('en_core_web_sm'); print('✓ spacy en_core_web_sm model loaded successfully'); except Exception as e: print(f'⚠ spacy model may not be available: {e}')"

