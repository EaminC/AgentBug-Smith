# Set environment variables for Forge API
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV AI_TEMPERATURE="0.7"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV ANTHROPIC_SMALL_FAST_MODEL="tuzi-deepseek-v3.2/deepseek-v3.2"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV TAVILY_API_KEY="tvly-dev-key"
ENV GITHUB_TOKEN="ghp_key"

WORKDIR /app

# Install minimal system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python -m pip install --upgrade pip

# Copy entire repository
COPY . .

# Install core dependencies with specific versions
RUN pip install \
    beautifulsoup4>=4.12.2 \
    colorama==0.4.6 \
    distro==1.8.0 \
    openai==0.27.2 \
    python-dotenv==1.0.0 \
    pyyaml==6.0.1 \
    requests \
    gitpython==3.1.31 \
    click

# Install auto-gpt-plugin-template from git (CRITICAL - fixes ModuleNotFoundError)
RUN pip install git+https://github.com/Significant-Gravitas/Auto-GPT-Plugin-Template@0.1.0

# Install test dependencies
RUN pip install \
    pytest \
    pytest-mock \
    pytest-asyncio \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    vcrpy \
    litellm \
    mem0ai

# Instead of editable install, just set PYTHONPATH
ENV PYTHONPATH=/app:$PYTHONPATH

# Create verification script
RUN echo 'import sys' > /tmp/verify.py && \
    echo 'import os' >> /tmp/verify.py && \
    echo '' >> /tmp/verify.py && \
    echo 'try:' >> /tmp/verify.py && \
    echo '    # Add current directory to path' >> /tmp/verify.py && \
    echo '    import sys' >> /tmp/verify.py && \
    echo '    sys.path.insert(0, "/app")' >> /tmp/verify.py && \
    echo '' >> /tmp/verify.py && \
    echo '    import autogpt' >> /tmp/verify.py && \
    echo '    print("✓ autogpt imported successfully")' >> /tmp/verify.py && \
    echo '' >> /tmp/verify.py && \
    echo '    import auto_gpt_plugin_template' >> /tmp/verify.py && \
    echo '    print("✓ auto_gpt_plugin_template imported successfully")' >> /tmp/verify.py && \
    echo '' >> /tmp/verify.py && \
    echo '    import openai' >> /tmp/verify.py && \
    echo '    print(f"✓ OpenAI version: {openai.__version__}")' >> /tmp/verify.py && \
    echo '' >> /tmp/verify.py && \
    echo '    print(f"✓ OPENAI_BASE_URL env var: {os.getenv(\\"OPENAI_BASE_URL\\")}")' >> /tmp/verify.py && \
    echo '    print(f"✓ FORGE_API_KEY env var: {os.getenv(\\"FORGE_API_KEY\\")}")' >> /tmp/verify.py && \
    echo '' >> /tmp/verify.py && \
    echo '    sys.exit(0)' >> /tmp/verify.py && \
    echo 'except Exception as e:' >> /tmp/verify.py && \
    echo '    print(f"✗ Error: {e}")' >> /tmp/verify.py && \
    echo '    import traceback' >> /tmp/verify.py && \
    echo '    traceback.print_exc()' >> /tmp/verify.py && \
    echo '    sys.exit(1)' >> /tmp/verify.py

# Run verification
RUN python /tmp/verify.py

