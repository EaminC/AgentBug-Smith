        extra_body=extra_body,
    )
    assert model.extra_body == extra_body
    with patch("aider.sendchat.litellm.completion") as mock_completion:
        mock_completion.return_value = MagicMock(
            choices=[MagicMock(message=MagicMock(content="test"))]
        )
        coder = Coder.create(io=None, main_model=model)
        coder.send([{"role": "user", "content": "Hello"}])
        kwargs = mock_completion.call_args[1]
        assert kwargs.get("extra_body") == extra_body


def test_extra_body_from_model_metadata_file():
    """
    Test that extra_body can be loaded from model metadata JSON file.
    """
    extra_body = {"provider": {"order": ["OpenAI", "Together"]}}
    metadata = {
        "openrouter/google/gemma-2-9b-it:free": {
            "input_cost_per_token": 0.0,
            "output_cost_per_token": 0.0,
            "litellm_provider": "openrouter",
            "mode": "code",
            "extra_body": extra_body,
        }
    }
    with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False) as f:
        json.dump(metadata, f)
        f.flush()
        try:
            from aider.models import ModelInfoManager

            mim = ModelInfoManager(f.name)
            model_info = mim.get_model_info("openrouter/google/gemma-2-9b-it:free")
            assert model_info is not None
            assert model_info.extra_body == extra_body
        finally:
            import os

            os.unlink(f.name)[0m
