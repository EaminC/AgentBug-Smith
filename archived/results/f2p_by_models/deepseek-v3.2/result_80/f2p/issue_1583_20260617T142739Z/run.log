import tempfile
from unittest.mock import patch, MagicMock
import pytest
import aider.models
import aider.sendchat


def test_extra_body_passed_to_litellm():
    """
    Test that extra_body from model metadata is passed through to litellm.
    """
    extra_body = {"provider": {"order": ["OpenAI", "Together"]}}
    model_settings = aider.models.ModelSettings(
        name="test_model",
        extra_body=extra_body,
    )
    assert model_settings.extra_body == extra_body


def test_extra_body_not_passed_when_none():
    """
    Test that extra_body is not included in kwargs when it is None.
    """
    with patch("aider.sendchat.litellm.completion") as mock_completion:
        mock_completion.return_value = MagicMock(
            choices=[MagicMock(message=MagicMock(content="test"))]
        )

        send_completion = aider.sendchat.send_completion
        _hash, _ = send_completion(
            model_name="gpt-4",
            messages=[{"role": "user", "content": "Hello"}],
            functions=None,
            stream=False,
            temperature=0,
            extra_headers=None,
            extra_body=None,
            max_tokens=None,
        )
        kwargs = mock_completion.call_args[1]
        assert "extra_body" not in kwargs


def test_extra_body_in_simple_send_with_retries():
    """
    Test that simple_send_with_retries passes extra_body to send_completion.
    """
    extra_body = {"provider": {"order": ["OpenAI"]}}
    with patch("aider.sendchat.send_completion") as mock_send:
        mock_send.return_value = (
            "hash",
            MagicMock(choices=[MagicMock(message=MagicMock(content="response"))]),
        )

        simple_send_with_retries = aider.sendchat.simple_send_with_retries
        simple_send_with_retries(
            model_name="openrouter/mistralai/mixtral-8x7b-instruct",
            messages=[{"role": "user", "content": "Hello"}],
            extra_headers=None,
            extra_body=extra_body,
        )
        call_kwargs = mock_send.call_args[1]
        assert call_kwargs["extra_body"] == extra_body


def test_extra_body_in_model_settings():
    """
    Test that ModelSettings correctly stores extra_body.
    """
    extra_body = {"custom_field": "value"}
    settings = aider.models.ModelSettings(name="test", extra_body=extra_body)
    assert settings.extra_body == extra_body


def test_extra_body_passed_from_coder():
    """
    Integration test: ensure extra_body from model metadata flows through Coder.send().
    This test mocks the litellm internal client to avoid real API calls.
    """
    from aider.coders.base_coder import Coder
    from aider.models import Model

    extra_body = {"provider": {"order": ["OpenAI", "Together"]}}
    model = Model(
        "openrouter/google/gemma-2-9b-it:free",
        extra_body=extra_body,
    )
    assert model.extra_body == extra_body

    with patch("aider.sendchat.litellm.completion") as mock_completion:
        mock_completion.return_value = MagicMock(
            choices=[MagicMock(message=MagicMock(content="test"))]
        )
        coder = Coder.create(models=[model])
        coder.send("test message")
        kwargs = mock_completion.call_args[1]
        assert kwargs.get("extra_body") == extra_body


