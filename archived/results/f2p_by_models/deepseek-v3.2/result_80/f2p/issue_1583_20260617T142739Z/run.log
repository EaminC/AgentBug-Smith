        )
        # Call send with a dummy message
        coder.send("Hello")
        # Verify extra_body was passed to send_completion
        call_kwargs = mock_send_completion.call_args[1]
        assert "extra_body" in call_kwargs
        assert call_kwargs["extra_body"] == {"route": "special"}[0m
