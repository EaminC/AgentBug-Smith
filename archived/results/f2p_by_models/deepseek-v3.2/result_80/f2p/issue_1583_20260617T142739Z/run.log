            max_tokens=None
        )
    
    # Assert that extra_body was not passed to litellm
    assert "extra_body" not in captured_kwargs


def test_extra_body_in_model_settings():
    """
    Test that ModelSettings correctly stores and returns extra_body.
    """
    extra_body_data = {
        "provider": {
            "order": ["OpenAI", "Anthropic"]
        }
    }
    
    settings = ModelSettings(
        name="test_model",
        litellm_provider="openrouter",
        extra_body=extra_body_data
    )
    
    assert settings.extra_body == extra_body_data
    assert settings.extra_body["provider"]["order"] == ["OpenAI", "Anthropic"]


def test_extra_body_passed_from_base_coder():
    """
    Integration test: ensure extra_body flows from ModelSettings through base_coder to send_completion.
    """
    from aider.coders.base_coder import Coder
    from aider.models import ModelInfoManager
    
