[32mimport json
import os
import tempfile
from unittest.mock import patch, MagicMock

from aider.models import ModelInfoManager, ModelSettings


def test_extra_body_passed_to_litellm():
    """
    Test that extra_body from model metadata is passed through to litellm.
    """
    # Create a temporary model metadata file with extra_body
    with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False) as f:
        metadata = {
            "test/openrouter-model": {
                "input_cost_per_token": 0.0,
                "output_cost_per_token": 0.0,
                "litellm_provider": "openrouter",
                "mode": "code",
                "extra_body": {
                    "provider": {
                        "order": ["OpenAI", "Together"]
                    }
                }
            }
        }
        json.dump(metadata, f)
        metadata_path = f.name

    try:
        # Load the metadata via ModelInfoManager
        mim = ModelInfoManager(metadata_path)
        model_info = mim.get_model_info("test/openrouter-model")
        assert model_info is not None
        assert model_info.extra_body == {
            "provider": {
                "order": ["OpenAI", "Together"]
            }
        }

        # Create a ModelSettings instance with extra_body
        settings = ModelSettings(
            litellm_provider="openrouter",
            extra_body=model_info.extra_body
        )

        # Now test that send_completion receives extra_body
        # We'll mock litellm.completion to capture kwargs
        from aider.sendchat import send_completion
        from aider.llm import litellm

        captured_kwargs = {}

        def mock_completion(*args, **kwargs):
            captured_kwargs.update(kwargs)
            # Return a mock response that matches litellm's structure
            mock_choice = MagicMock()
            mock_choice.message = MagicMock()
            mock_choice.message.content = "test response"
            mock_response = MagicMock()
            mock_response.choices = [mock_choice]
            return mock_response

        with patch.object(litellm, 'completion', side_effect=mock_completion):
            # Call send_completion with extra_body
            _hash, _ = send_completion(
                model_name="test/openrouter-model",
                messages=[{"role": "user", "content": "Hello"}],
                functions=None,
                stream=False,
                temperature=0,
                extra_headers=None,
                extra_body=settings.extra_body,
                max_tokens=None
            )

            # Verify extra_body is in kwargs passed to litellm.completion
            assert "extra_body" in captured_kwargs
            assert captured_kwargs["extra_body"] == {
                "provider": {
                    "order": ["OpenAI", "Together"]
                }
            }

    finally:
        os.unlink(metadata_path)


def test_extra_body_in_base_coder_call():
    """
    Test that Coder.send_with_retries passes extra_body from model settings.
    """
    from aider.coders.base_coder import Coder
    from aider.models import ModelInfoManager
    from aider.sendchat import send_completion

    # Create a temporary model metadata file
    with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False) as f:
        metadata = {
            "test/openrouter-model": {
                "input_cost_per_token": 0.0,
                "output_cost_per_token": 0.0,
                "litellm_provider": "openrouter",
                "mode": "code",
                "extra_body": {
                    "provider": {
                        "order": ["Anthropic", "Cohere"]
                    }
                }
            }
        }
        json.dump(metadata, f)
        metadata_path = f.name

    try:
        # Setup ModelInfoManager
        mim = ModelInfoManager(metadata_path)
        model_info = mim.get_model_info("test/openrouter-model")
        assert model_info.extra_body is not None

        # Create a mock Coder instance
        # We need to mock enough attributes to avoid initialization errors
        coder = Coder(
            io=None,
            main_model="test/openrouter-model",
            edit_format=None,
            fnames=[],
            model_info_manager=mim,
            stream=False,
            pretty=True,
            show_diffs=False,
            auto_commits=True,
            dirty_only=False,
            dry_run=False,
            map_tokens=0,
            verbose=False,
            assistant_output_color="blue",
            code_theme="default",
            language=None,
            voice_language=None,
            help=False,
            welcome_message=True,
            show_model=False,
            openai_api_key="sk-test",
            openai_base_url=None,
        )

        # Mock the send_completion call to capture its arguments
        original_send_completion = send_completion
        captured_args = []
        captured_kwargs = []

        def mock_send_completion(*args, **kwargs):
            captured_args.append(args)
            captured_kwargs.append(kwargs)
            # Return a mock hash and response
            mock_choice = MagicMock()
            mock_choice.message = MagicMock()
            mock_choice.message.content = "test"
            mock_response = MagicMock()
            mock_response.choices = [mock_choice]
            return ("mock_hash", mock_response)

        # Patch send_completion in the coder's namespace
        with patch('aider.coders.base_coder.send_completion', side_effect=mock_send_completion):
            # Call send_with_retries which internally uses send_completion
            # We need to mock enough of the surrounding context
            coder.send_with_retries(
                model_name="test/openrouter-model",
                messages=[{"role": "user", "content": "Hello"}],
                functions=None,
                stream=False,
                temperature=0
            )

            # Verify that extra_body was passed
            assert len(captured_kwargs) > 0
            last_kwargs = captured_kwargs[-1]
            assert "extra_body" in last_kwargs
            assert last_kwargs["extra_body"] == {
                "provider": {
                    "order": ["Anthropic", "Cohere"]
                }
            }

    finally:
        os.unlink(metadata_path)


def test_extra_body_not_passed_when_none():
    """
    Test that extra_body is not included in kwargs when it's None.
    """
    from aider.sendchat import send_completion
    from aider.llm import litellm

    captured_kwargs = {}

    def mock_completion(*args, **kwargs):
        captured_kwargs.update(kwargs)
        mock_choice = MagicMock()
        mock_choice.message = MagicMock()
        mock_choice.message.content = "test response"
        mock_response = MagicMock()
        mock_response.choices = [mock_choice]
        return mock_response

    with patch.object(litellm, 'completion', side_effect=mock_completion):
        _hash, _ = send_completion(
            model_name="gpt-4",
            messages=[{"role": "user", "content": "Hello"}],
            functions=None,
            stream=False,
            temperature=0,
            extra_headers=None,
            extra_body=None,  # None should not add extra_body to kwargs
            max_tokens=None
        )

        # extra_body should not be in kwargs when it's None
        assert "extra_body" not in captured_kwargs


def test_extra_body_with_simple_send_with_retries():
    """
