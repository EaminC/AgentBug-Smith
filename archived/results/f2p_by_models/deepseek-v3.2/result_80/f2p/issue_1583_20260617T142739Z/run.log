# Copy entire repository
COPY . .

# Detect src/ layout or import pattern
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\|^\s*import src\." . 2>/dev/null; then \
    echo "Detected src/ layout, skipping editable install" && \
    export SKIP_EDITABLE=1; \
    else \
    echo "No src/ layout, will perform editable install" && \
    export SKIP_EDITABLE=0; \
    fi

# Install dependencies and project
RUN if [ -f "requirements.txt" ]; then \
    pip install -r requirements.txt; \
    fi && \
    if [ "$SKIP_EDITABLE" = "0" ]; then \
    pip install -e .; \
    fi && \
    # Install test dependencies unconditionally
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Set environment variables for Forge
