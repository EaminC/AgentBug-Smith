[32mimport json
import tempfile
from unittest.mock import MagicMock, patch
from aider.models import ModelSettings
from aider.sendchat import send_completion


def test_extra_body_passed_to_litellm():
    """
    Test that extra_body from model metadata is passed to litellm completion call.
    """
    # Mock litellm.completion
    mock_completion = MagicMock()
    mock_completion.return_value = MagicMock(
        choices=[MagicMock(message=MagicMock(content="test response"))]
    )

    with patch("aider.sendchat.litellm.completion", mock_completion):
        _hash, _ = send_completion(
            model_name="some_model",
            messages=[{"role": "user", "content": "Hello"}],
            functions=None,
            stream=False,
            temperature=0,
            extra_headers=None,
            extra_body={"provider": {"order": ["OpenAI", "Together"]}},
            max_tokens=None,
        )
        # Verify extra_body was passed to litellm.completion
        call_kwargs = mock_completion.call_args[1]
        assert "extra_body" in call_kwargs
        assert call_kwargs["extra_body"] == {"provider": {"order": ["OpenAI", "Together"]}}


def test_extra_body_not_passed_when_none():
    """
    Test that extra_body is not passed to litellm when it's None.
    """
    # Mock litellm.completion
    mock_completion = MagicMock()
    mock_completion.return_value = MagicMock(
        choices=[MagicMock(message=MagicMock(content="test response"))]
    )

    with patch("aider.sendchat.litellm.completion", mock_completion):
        _hash, _ = send_completion(
            model_name="some_model",
            messages=[{"role": "user", "content": "Hello"}],
            functions=None,
            stream=False,
            temperature=0,
            extra_headers=None,
            extra_body=None,
            max_tokens=None,
        )
        # Verify extra_body is not in kwargs
        call_kwargs = mock_completion.call_args[1]
        assert "extra_body" not in call_kwargs


def test_extra_body_in_model_settings():
    """
    Test that ModelSettings includes extra_body field.
    """
    settings = ModelSettings(
        name="test",
        extra_body={"custom": "value"}
    )
    assert settings.extra_body == {"custom": "value"}


def test_extra_body_passed_from_coder():
    """
