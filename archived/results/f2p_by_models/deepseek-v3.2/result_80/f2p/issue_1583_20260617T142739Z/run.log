    )
    assert settings.extra_body == {"custom": "value"}


def test_extra_body_passed_from_coder():
    """
    Integration test: ensure extra_body from model is passed through Coder.send().
    """
    from aider.coders.base_coder import Coder

    # Create a mock model with extra_body
    model = Model(
        name="test_model",
        settings=ModelSettings(
            name="test_model",
            extra_body={"route": "special"}
        )
    )
    # Verify model.extra_body is accessible
    assert model.extra_body == {"route": "special"}

    # Mock the actual litellm call inside Coder.send()
    mock_completion = MagicMock()
    mock_completion.return_value = MagicMock(
        choices=[MagicMock(message=MagicMock(content="test response"))]
    )
    with patch("aider.coders.base_coder.litellm.completion", mock_completion):
        # Create a minimal Coder instance
        coder = Coder.create(
            main_model=model,
            fnames=[],
            git_dname=None,
            io=MagicMock(),
            stream=False,
            pretty=True,
            show_diffs=False,
            auto_commits=True,
            dirty_commits=True,
            dry_run=False,
            map_tokens=0,
            verbose=False,
            assistant_output_color="blue",
            user_input_color="blue",
            tool_error_color="red",
            tool_output_color="green",
            chat_color="blue",
            code_theme="default",
            voice_language=None,
            model_info_manager=MagicMock(),
        )
        # Mock the hash calculation to avoid randomness
        with patch("aider.coders.base_coder.hashlib.sha256") as mock_hash:
            mock_hash.return_value.hexdigest.return_value = "fake_hash"
            # Call send with a simple message
            coder.send("Hello")
            # Verify extra_body is passed to litellm.completion
            call_kwargs = mock_completion.call_args[1]
            assert "extra_body" in call_kwargs
            assert call_kwargs["extra_body"] == {"route": "special"}


