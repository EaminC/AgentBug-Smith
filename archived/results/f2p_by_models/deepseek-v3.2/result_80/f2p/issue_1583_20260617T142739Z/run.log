from unittest.mock import patch, MagicMock
from aider.models import ModelSettings
from aider.sendchat import send_completion, simple_send_with_retries


def test_extra_body_passed_to_litellm():
    """
    Test that extra_body from model metadata is passed through to litellm.
    """
    extra_body = {"provider": {"order": ["OpenAI", "Together"]}}
    model_settings = ModelSettings(
        litellm_provider="openrouter",
        extra_body=extra_body,
    )

    # Mock litellm.completion to capture kwargs
    with patch("aider.sendchat.litellm.completion") as mock_completion:
        mock_completion.return_value = MagicMock(
            choices=[MagicMock(message=MagicMock(content="test"))]
        )

        # Call send_completion with extra_body
        send_completion(
            model_name="openrouter/google/gemma-2-9b-it:free",
            messages=[{"role": "user", "content": "Hello"}],
            functions=None,
            stream=False,
            temperature=0,
            extra_headers=None,
            extra_body=extra_body,
            max_tokens=None,
        )

        # Ensure litellm.completion was called with extra_body
        mock_completion.assert_called_once()
        call_kwargs = mock_completion.call_args[1]
        assert "extra_body" in call_kwargs
        assert call_kwargs["extra_body"] == extra_body


def test_extra_body_not_passed_when_none():
    """
    Test that extra_body is not included in kwargs when it is None.
    """
    with patch("aider.sendchat.litellm.completion") as mock_completion:
        mock_completion.return_value = MagicMock(
            choices=[MagicMock(message=MagicMock(content="test"))]
        )

        send_completion(
            model_name="gpt-4",
