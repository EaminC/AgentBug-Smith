        mock_litellm.return_value = MagicMock(
            choices=[MagicMock(message=MagicMock(content="test"))]
        )
        coder = Coder(models=[model])
        coder.send([{"role": "user", "content": "Hello"}])
        call_kwargs = mock_litellm.call_args.kwargs
        assert "extra_body" in call_kwargs
        assert call_kwargs["extra_body"] == extra_body


