        # Mock the send_completion call to capture arguments
        captured_kwargs = {}
        original_send_completion = send_completion
        def mock_send_completion(*args, **kwargs):
            captured_kwargs.update(kwargs)
            # Return a mock hash and response
            mock_choice = MagicMock()
            mock_choice.message = MagicMock()
            mock_choice.message.content = "test response"
            mock_response = MagicMock()
            mock_response.choices = [mock_choice]
            return "mock_hash", mock_response
        
        # Mock the actual API call but keep the rest of the flow
        with patch("aider.sendchat.litellm.completion") as mock_litellm:
            mock_litellm.return_value = MagicMock(choices=[MagicMock(message=MagicMock(content="test"))])
            with patch("aider.coders.base_coder.send_completion", side_effect=mock_send_completion):
                # Trigger a chat completion call
                coder.call_llm(
                    messages=[{"role": "user", "content": "Hello"}],
                    functions=None,
                    temperature=0
                )
        
        # Check that extra_body was passed
        assert "extra_body" in captured_kwargs
        assert captured_kwargs["extra_body"] == {
            "provider": {
                "order": ["OpenAI", "Together"]
            }
        }
        
    finally:
        os.unlink(metadata_path)[0m
