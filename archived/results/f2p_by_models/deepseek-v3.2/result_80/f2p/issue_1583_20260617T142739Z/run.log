ENV ANTHROPIC_SMALL_FAST_MODEL=tuzi-deepseek-v3.2/deepseek-v3.2
ENV TAVILY_API_KEY=tvly-dev-key
ENV GITHUB_TOKEN=ghp_key

# Set PYTHONPATH to include /app for proper imports
ENV PYTHONPATH=/app

# Preflight import check to verify installation
RUN python -c "import aider; import pytest; import litellm; import pydub; print('Preflight check: all required packages imported successfully')"

# Default command - bash shell for testing environment (required by test harness)
