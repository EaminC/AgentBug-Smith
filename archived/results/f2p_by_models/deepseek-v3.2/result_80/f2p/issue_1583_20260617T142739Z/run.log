[32mimport pytest
from unittest.mock import MagicMock, patch
from aider.models import ModelSettings, Model
from aider.sendchat import send_completion, simple_send_with_retries


def test_extra_body_passed_to_litellm():
    """
    Test that extra_body from model metadata is passed to litellm completion call.
    """
    # Mock litellm.completion
    mock_completion = MagicMock()
    mock_completion.return_value = MagicMock(
        choices=[MagicMock(message=MagicMock(content="test response"))]
    )

    with patch("aider.sendchat.litellm.completion", mock_completion):
        # In buggy version, extra_body parameter is not accepted.
        # After fix, it should be accepted and passed to litellm.
        _hash, _ = send_completion(
            model_name="some_model",
            messages=[{"role": "user", "content": "Hello"}],
            functions=None,
            stream=False,
            temperature=0,
            extra_headers=None,
            extra_body={"provider": {"order": ["OpenAI", "Together"]}},
            max_tokens=None,
        )
        # Verify extra_body is passed to litellm.completion
        call_kwargs = mock_completion.call_args[1]
        assert "extra_body" in call_kwargs
        assert call_kwargs["extra_body"] == {"provider": {"order": ["OpenAI", "Together"]}}


def test_extra_body_not_passed_when_none():
    """
    Test that extra_body is not passed to litellm when it's None.
    """
    # Mock litellm.completion
    mock_completion = MagicMock()
    mock_completion.return_value = MagicMock(
        choices=[MagicMock(message=MagicMock(content="test response"))]
    )

    with patch("aider.sendchat.litellm.completion", mock_completion):
        _hash, _ = send_completion(
            model_name="some_model",
            messages=[{"role": "user", "content": "Hello"}],
            functions=None,
            stream=False,
            temperature=0,
            extra_headers=None,
            extra_body=None,
            max_tokens=None,
        )
        # Verify extra_body is not in kwargs when None
        call_kwargs = mock_completion.call_args[1]
        assert "extra_body" not in call_kwargs


def test_extra_body_in_model_settings():
    """
    Test that ModelSettings includes extra_body field.
    """
    # In buggy version, extra_body is not a valid parameter.
    # After fix, it should be accepted.
    settings = ModelSettings(
        name="test",
        extra_body={"custom": "value"}
    )
    assert settings.extra_body == {"custom": "value"}


def test_extra_body_passed_from_coder():
    """
    Integration test: ensure extra_body from model is passed through Coder.send().
    """
    from aider.coders.base_coder import Coder

    # Create a mock model with extra_body
    model = Model(
        settings=ModelSettings(
            name="test_model",
            extra_body={"route": "special"}
        )
    )
    # Verify model.settings.extra_body is set
    assert model.settings.extra_body == {"route": "special"}

    # Mock send_completion to verify it receives extra_body
    mock_send_completion = MagicMock()
    mock_send_completion.return_value = (MagicMock(), MagicMock())
    with patch("aider.coders.base_coder.send_completion", mock_send_completion):
        coder = Coder()
        coder.model = model
        coder.send([{"role": "user", "content": "test"}])
        # Check that extra_body is passed to send_completion
        call_kwargs = mock_send_completion.call_args[1]
        assert "extra_body" in call_kwargs
        assert call_kwargs["extra_body"] == {"route": "special"}


