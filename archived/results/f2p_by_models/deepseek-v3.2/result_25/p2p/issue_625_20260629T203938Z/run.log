from unittest.mock import patch, MagicMock, AsyncMock
from agentscope.service.mcp_manager import MCPManager


class TestMCPManagerStreamableHTTP:
    """Test that MCPManager correctly handles streamable_http type."""

    def test_mcp_manager_initialization_with_streamable_http(self) -> None:
        """Test that MCPManager can be initialized with streamable_http type."""
        config = {
            "type": "streamable_http",
            "url": "http://localhost:8000/mcp/",
        }
        manager = MCPManager(config)
        assert manager.config == config

    @pytest.mark.asyncio
    async def test_mcp_manager_initialize_streamable_http(self) -> None:
        """Test that MCPManager.initialize() works for streamable_http."""
        config = {
            "type": "streamable_http",
            "url": "http://localhost:8000/mcp/",
        }
        manager = MCPManager(config)

        # Mock the internal mcp module and its clients
        mock_mcp = MagicMock()
        mock_session = AsyncMock()
        mock_session.__aenter__ = AsyncMock(return_value=mock_session)
        mock_session.__aexit__ = AsyncMock(return_value=None)
        mock_streamablehttp_client = AsyncMock()
        mock_streamablehttp_client.return_value.__aenter__ = AsyncMock(
            return_value=("read_stream", "write_stream"),
        )
        mock_streamablehttp_client.return_value.__aexit__ = AsyncMock()

        with patch.dict(sys.modules, {"mcp": mock_mcp}):
            with patch(
                "agentscope.service.mcp_manager.streamablehttp_client",
                mock_streamablehttp_client,
            ):
                with patch(
                    "agentscope.service.mcp_manager.mcp.ClientSession",
                    return_value=mock_session,
                ):
                    await manager.initialize()
                    # Verify streamablehttp_client was called with correct URL
                    mock_streamablehttp_client.assert_called_once_with(
                        url="http://localhost:8000/mcp/",
                    )
                    # Verify session was entered
                    mock_session.__aenter__.assert_called_once()

    @pytest.mark.asyncio
