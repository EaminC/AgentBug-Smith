class TestMCPStreamableHTTPClient:
    """Test that MCP streamable HTTP client is supported after the fix."""

    @pytest.fixture
    def mcp_server_process(self):
        """Start the MCP server from the example."""
        # Path to the server script added in the patch
        server_path = os.path.join(
            os.path.dirname(__file__),
            "..",
            "examples",
            "reactv2_agent_with_mcp",
            "code",
            "mcp_servers.py",
        )
        server_path = os.path.abspath(server_path)
        if not os.path.exists(server_path):
            pytest.skip(f"Server script not found at {server_path}")

        # Start the server as a subprocess
        proc = subprocess.Popen(
            [sys.executable, server_path],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        # Wait for server to start
        time.sleep(3)
        yield proc
        # Cleanup
        proc.terminate()
        proc.wait(timeout=5)
        if proc.poll() is None:
            proc.kill()

    @pytest.mark.asyncio
    async def test_mcp_manager_streamable_http_client(self, mcp_server_process):
        """Test that MCPManager can initialize a streamable HTTP client."""
        # Skip if mcp is not installed
        try:
            import mcp
        except ImportError:
            pytest.skip("mcp package not installed")

        # Configuration for streamable HTTP server (multiply tool)
        config = {
            "type": "streamable_http",
            "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
        }

        # Create MCPManager instance
        manager = MCPManager(config)

        # Initialize the manager (this is where the bug would manifest)
        try:
            await manager.initialize()
        except Exception as e:
            # In buggy code, streamable_http type is not recognized,
            # so it would fall back to SSE client and fail because
            # the URL endpoint is not SSE.
            # After fix, it should succeed.
            raise AssertionError(f"Failed to initialize MCPManager: {e}")

        # Cleanup
        await manager.cleanup()

    @pytest.mark.asyncio
    async def test_service_toolkit_add_streamable_http_mcp(self):
        """Test that ServiceToolkit can add streamable HTTP MCP servers."""
        toolkit = ServiceToolkit()

