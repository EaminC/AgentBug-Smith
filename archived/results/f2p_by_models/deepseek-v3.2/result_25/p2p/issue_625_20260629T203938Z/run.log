def test_mcp_streamable_http_client() -> None:
    """Test that MCP streamable HTTP client works correctly."""
    # Skip if mcp is not installed
    try:
        import mcp
    except ImportError:
        pytest.skip("mcp not installed")

    # Create a simple FastMCP server with streamable HTTP
    from mcp.server.fastmcp import FastMCP

    mcp_server = FastMCP("TestServer")

    @mcp_server.tool()
    def multiply(a: int, b: int) -> int:
        """Multiply two numbers."""
        return a * b

    # Create the streamable HTTP app
    streamable_app = mcp_server.streamable_http_app()

    # Wrap in a test client
    from starlette.testclient import TestClient

    client = TestClient(streamable_app)

    # Test that the streamable HTTP endpoint exists
    response = client.post("/mcp/", json={})
    # The MCP protocol expects a 200 with a specific structure
    # We just check the endpoint is reachable
    assert response.status_code == 200

    # Now test the ServiceToolkit integration
    toolkit = ServiceToolkit()
    # Add a streamable HTTP server config
    toolkit.add_mcp_servers(
        {
            "mcpServers": {
                "multiply-tool": {
                    "type": "streamable_http",
                    "url": "http://127.0.0.1:8001/mcp/",  # dummy URL
                },
            },
        },
    )

    # Verify the config is stored
    assert len(toolkit._mcp_servers) == 1
    server_config = toolkit._mcp_servers["multiply-tool"]
    assert server_config["type"] == "streamable_http"
    assert server_config["url"] == "http://127.0.0.1:8001/mcp/"

    # Test that the MCP manager can be initialized with streamable_http type
    from agentscope.service.mcp_manager import MCPManager

    manager = MCPManager(
        name="test",
        config={
            "type": "streamable_http",
            "url": "http://127.0.0.1:8001/mcp/",
        },
    )
    assert manager.config["type"] == "streamable_http"

    # The bug is that before the fix, the MCPManager's initialize method
    # would not recognize "streamable_http" and would default to SSE,
    # causing an error when trying to connect to a streamable HTTP endpoint.
    # After the fix, it should use streamablehttp_client.
    # We can test this by mocking the mcp client modules and checking
    # which client is used.

    # Mock the mcp client modules to avoid real network calls
    with patch("agentscope.service.mcp_manager.mcp") as mock_mcp:
        with patch("agentscope.service.mcp_manager.sse_client") as mock_sse:
            with patch(
                "agentscope.service.mcp_manager.streamablehttp_client",
            ) as mock_streamable:
                with patch(
                    "agentscope.service.mcp_manager.stdio_client",
                ) as mock_stdio:
                    # Setup mocks
                    mock_session = AsyncMock()
                    mock_mcp.ClientSession.return_value.__aenter__.return_value = (
                        mock_session
                    )
                    mock_stream = (AsyncMock(), AsyncMock())
                    mock_streamable.return_value.__aenter__.return_value = (
                        mock_stream
                    )
                    mock_sse.return_value.__aenter__.return_value = mock_stream
                    mock_stdio.return_value.__aenter__.return_value = mock_stream

                    # Test streamable_http type
                    manager = MCPManager(
                        name="test",
                        config={
                            "type": "streamable_http",
                            "url": "http://127.0.0.1:8001/mcp/",
                        },
                    )
                    # Run initialize (which is async)
                    asyncio.run(manager.initialize())
                    # Check that streamablehttp_client was called
                    mock_streamable.assert_called_once_with(
                        url="http://127.0.0.1:8001/mcp/",
                    )
                    mock_sse.assert_not_called()
                    mock_stdio.assert_not_called()

                    # Test that "streamableHttp" (camelCase) also works
                    mock_streamable.reset_mock()
                    manager2 = MCPManager(
                        name="test2",
                        config={
                            "type": "streamableHttp",
                            "url": "http://127.0.0.1:8002/mcp/",
                        },
                    )
                    asyncio.run(manager2.initialize())
                    mock_streamable.assert_called_once_with(
                        url="http://127.0.0.1:8002/mcp/",
                    )

                    # Test that default (no type) still uses SSE
                    mock_sse.reset_mock()
                    manager3 = MCPManager(
                        name="test3",
                        config={
                            "url": "http://127.0.0.1:8003/sse",
                        },
                    )
                    asyncio.run(manager3.initialize())
                    mock_sse.assert_called_once_with(
                        url="http://127.0.0.1:8003/sse",
                    )

    # If we reach here, the test passes (no assertion failures)
    # The bug would have caused the wrong client to be used, leading to
    # an error when connecting. The fix ensures streamable_http type uses
    # streamablehttp_client.[0m
