async def test_mcp_manager_streamable_http_support(
    mock_mcp,
    mock_sse_client,
    mock_streamablehttp_client,
    mock_stdio_client,
):
    """Test that MCPManager correctly handles streamable_http type.

    In the buggy code, streamable_http type is not recognized, causing
    the manager to fall back to SSE client. After the fix, it should use
    streamablehttp_client for type "streamable_http".
