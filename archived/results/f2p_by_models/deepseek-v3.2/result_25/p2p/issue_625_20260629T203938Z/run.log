class TestMCPStreamableHTTP:
    """Test that MCP streamable HTTP client works after the fix."""

    @pytest.fixture
    def mock_mcp_module(self):
        """Mock the mcp module if not installed."""
        try:
            import mcp
            return mcp
        except ImportError:
            # Create a mock mcp module
            mock_mcp = MagicMock()
            mock_mcp.ClientSession = AsyncMock()
            mock_mcp.ClientSession.return_value.__aenter__.return_value = AsyncMock()
            mock_mcp.ClientSession.return_value.__aexit__.return_value = None
            sys.modules['mcp'] = mock_mcp
            sys.modules['mcp.client'] = MagicMock()
            sys.modules['mcp.client.sse'] = MagicMock()
            sys.modules['mcp.client.stdio'] = MagicMock()
            sys.modules['mcp.client.streamable_http'] = MagicMock()
            return mock_mcp

    @pytest.fixture
    def mock_streamablehttp_client(self, mock_mcp_module):
        """Mock streamablehttp_client."""
        mock_client = AsyncMock()
        mock_client.return_value.__aenter__.return_value = (AsyncMock(), AsyncMock())
        with patch('mcp.client.streamable_http.streamablehttp_client', mock_client):
            yield mock_client

    @pytest.fixture
    def mock_sse_client(self, mock_mcp_module):
        """Mock sse_client."""
        mock_client = AsyncMock()
        mock_client.return_value.__aenter__.return_value = (AsyncMock(), AsyncMock())
        with patch('mcp.client.sse.sse_client', mock_client):
            yield mock_client

    @pytest.fixture
    def mock_stdio_client(self, mock_mcp_module):
        """Mock stdio_client."""
        mock_client = AsyncMock()
        mock_client.return_value.__aenter__.return_value = (AsyncMock(), AsyncMock())
        with patch('mcp.client.stdio.stdio_client', mock_client):
            yield mock_client

    @pytest.fixture
    def mock_session(self, mock_mcp_module):
        """Mock ClientSession."""
        mock_session = AsyncMock()
        mock_session.return_value.__aenter__.return_value = AsyncMock()
        mock_session.return_value.__aexit__.return_value = None
        with patch('mcp.ClientSession', mock_session):
            yield mock_session

    @pytest.mark.asyncio
    async def test_streamable_http_client_initialization(
        self,
        mock_mcp_module,
        mock_streamablehttp_client,
        mock_sse_client,
        mock_stdio_client,
        mock_session,
    ):
        """Test that MCPClientManager can initialize a streamable HTTP client."""
        # This test should pass after the fix, fail before.
        config = {
            "type": "streamable_http",
            "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
        }
        manager = MCPClientManager(config)
        await manager.initialize()
        # Verify streamablehttp_client was called
        mock_streamablehttp_client.assert_called_once_with(url=config["url"])
        # Verify sse_client was NOT called
        mock_sse_client.assert_not_called()
        # Verify stdio_client was NOT called
        mock_stdio_client.assert_not_called()
        # Verify session was created
        mock_session.assert_called_once()

    @pytest.mark.asyncio
    async def test_sse_client_initialization(
