    def test_service_toolkit_add_mcp_servers_with_streamable_http(self):
        """Test that ServiceToolkit.add_mcp_servers accepts streamable_http type."""
        toolkit = ServiceToolkit()
        # This should not raise an error after the fix.
        # On buggy code, the MCPManager will fail to initialize because it doesn't
        # recognize streamable_http.
        toolkit.add_mcp_servers(
            {
                "mcpServers": {
                    "multiply-tool": {
                        "type": "streamable_http",
                        "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
                    },
                },
            }
        )
        # Verify that the server was added.
        assert "multiply-tool" in toolkit._mcp_managers
        manager = toolkit._mcp_managers["multiply-tool"]
        assert manager.config["type"] == "streamable_http"

