import pytest
from unittest.mock import patch, AsyncMock, MagicMock
import sys

# Check if mcp is installed; if not, the test will crash (as required)
import mcp
from mcp.client.sse import sse_client
from mcp.client.streamable_http import streamablehttp_client

from agentscope.service.mcp_manager import MCPManager


class TestMCPManagerStreamableHTTP:
    """Test that MCPManager correctly handles streamable_http type."""

    @pytest.mark.asyncio
    async def test_streamable_http_client_used_when_type_streamable_http(self):
        """In buggy code, streamable_http type is not recognized, causing failure.
        After fix, manager should use streamablehttp_client."""
        config = {
            "type": "streamable_http",
            "url": "http://localhost:8000/mcp/",
        }

        # Mock the internal network clients to avoid real connections
        mock_streams = (AsyncMock(), AsyncMock())
        mock_session = AsyncMock()
        mock_session.list_tools = AsyncMock(return_value=[])
        mock_session.list_resources = AsyncMock(return_value=[])
        mock_session.list_prompts = AsyncMock(return_value=[])

        # Mock the streamablehttp_client context manager
        mock_ctx = AsyncMock()
        mock_ctx.__aenter__ = AsyncMock(return_value=mock_streams)
        mock_ctx.__aexit__ = AsyncMock(return_value=None)

        with patch('mcp.client.streamable_http.streamablehttp_client') as mock_client:
            mock_client.return_value = mock_ctx

            # Also mock sse_client to ensure it's not called
            with patch('mcp.client.sse.sse_client') as mock_sse:
                mock_sse_ctx = AsyncMock()
                mock_sse_ctx.__aenter__ = AsyncMock(return_value=(AsyncMock(), AsyncMock()))
                mock_sse_ctx.__aexit__ = AsyncMock(return_value=None)
                mock_sse.return_value = mock_sse_ctx

                manager = MCPManager(config)
                await manager.initialize()

                # After fix, streamablehttp_client should be called with the URL
                mock_client.assert_called_once_with(url="http://localhost:8000/mcp/")
                # sse_client should NOT be called
                mock_sse.assert_not_called()

