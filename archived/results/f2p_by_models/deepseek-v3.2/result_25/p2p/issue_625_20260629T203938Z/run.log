def test_mcp_manager_streamable_http_support():
    """Test that MCPManager can handle streamable_http type servers.

    In the buggy version, MCPManager only supports 'sse' and 'stdio' types.
    The fix adds support for 'streamable_http' and 'streamableHttp' types.
    This test should fail before the patch and pass after.
    """
    # Mock the mcp imports to avoid actual external dependencies
    # We need to mock the internal network client calls
    mock_mcp = MagicMock()
    mock_client_session = MagicMock()
    mock_client_session_instance = AsyncMock()
    mock_client_session_instance.list_tools = AsyncMock(return_value=[])
    mock_client_session_instance.list_resources = AsyncMock(return_value=[])
    mock_client_session_instance.list_prompts = AsyncMock(return_value=[])
    mock_client_session.__aenter__ = AsyncMock(return_value=mock_client_session_instance)
    mock_client_session.__aexit__ = AsyncMock()
    mock_mcp.ClientSession = MagicMock(return_value=mock_client_session)

    mock_streamablehttp_client = MagicMock()
    mock_streams = (AsyncMock(), AsyncMock())
    mock_streamablehttp_client.__aenter__ = AsyncMock(return_value=mock_streams)
    mock_streamablehttp_client.__aexit__ = AsyncMock()

    mock_sse_client = MagicMock()
    mock_sse_client.__aenter__ = AsyncMock(return_value=mock_streams)
    mock_sse_client.__aexit__ = AsyncMock()

    mock_stdio_client = MagicMock()
    mock_stdio_client.__aenter__ = AsyncMock(return_value=mock_streams)
    mock_stdio_client.__aexit__ = AsyncMock()

    # Patch the imports inside mcp_manager
    with patch.dict('sys.modules', {'mcp': mock_mcp}), \
         patch('agentscope.service.mcp_manager.mcp', mock_mcp), \
         patch('agentscope.service.mcp_manager.sse_client', mock_sse_client), \
         patch('agentscope.service.mcp_manager.stdio_client', mock_stdio_client), \
         patch('agentscope.service.mcp_manager.streamablehttp_client', mock_streamablehttp_client):

        # Test 1: streamable_http type (new feature)
        config = {
            "type": "streamable_http",
            "url": "http://localhost:8001/streamable_http_app/mcp/"
        }
        manager = MCPManager(config)
        # Initialize should not raise
        asyncio.run(manager.initialize())
        # Verify streamablehttp_client was called
        mock_streamablehttp_client.__aenter__.assert_called_once()
        # In the buggy version, this would have called sse_client instead
        # and would have failed because 'type' is not recognized.

        # Test 2: streamableHttp (alternative spelling)
        config2 = {
            "type": "streamableHttp",
            "url": "http://localhost:8002/mcp/"
        }
        manager2 = MCPManager(config2)
        asyncio.run(manager2.initialize())
        # Should also call streamablehttp_client
        assert mock_streamablehttp_client.__aenter__.call_count == 2

        # Test 3: sse type (existing, should still work)
        config3 = {
            "type": "sse",
            "url": "http://localhost:8003/sse"
        }
        manager3 = MCPManager(config3)
        asyncio.run(manager3.initialize())
        mock_sse_client.__aenter__.assert_called_once()

        # Test 4: no type (defaults to sse)
        config4 = {
            "url": "http://localhost:8004/sse"
        }
        manager4 = MCPManager(config4)
        asyncio.run(manager4.initialize())
        assert mock_sse_client.__aenter__.call_count == 2

        # Test 5: stdio type
        config5 = {
            "type": "stdio",
            "command": "some_command",
            "args": ["arg1", "arg2"]
        }
        manager5 = MCPManager(config5)
        asyncio.run(manager5.initialize())
        mock_stdio_client.__aenter__.assert_called_once()

        # Cleanup
        asyncio.run(manager.cleanup())
        asyncio.run(manager2.cleanup())
        asyncio.run(manager3.cleanup())
        asyncio.run(manager4.cleanup())
        asyncio.run(manager5.cleanup())


