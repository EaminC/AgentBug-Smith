                "url": "http://127.0.0.1:8003/mcp/",
            }

            manager_sse = MCPManager(config_sse)
            await manager_sse.initialize()
            tools_sse = await manager_sse.list_tools()
            assert len(tools_sse) == 1
            assert tools_sse[0]["name"] == "add"

            result_sse = await manager_sse.call_tool("add", {"a": 3, "b": 5})
            assert result_sse == "8"

            manager_http = MCPManager(config_streamable_http)
            await manager_http.initialize()
            tools_http = await manager_http.list_tools()
            assert len(tools_http) == 1
            assert tools_http[0]["name"] == "multiply"

            result_http = await manager_http.call_tool(
                "multiply", {"a": 4, "b": 6}
            )
            assert result_http == "24"

        finally:
            if hasattr(manager_sse, "_exit_stack"):
                await manager_sse._exit_stack.aclose()
            if hasattr(manager_http, "_exit_stack"):
                await manager_http._exit_stack.aclose()


