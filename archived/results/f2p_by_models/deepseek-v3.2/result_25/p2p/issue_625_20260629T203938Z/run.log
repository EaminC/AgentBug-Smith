from agentscope.service.mcp_manager import MCPManager


class MockMCPClientSession:
    def __init__(self, *args, **kwargs):
        self.tools = []
        self.initialized = False

    async def initialize(self):
        self.initialized = True

    async def list_tools(self):
        return {"tools": self.tools}

    async def call_tool(self, name, arguments):
        if name == "add":
            return {"content": [{"type": "text", "text": str(arguments["a"] + arguments["b"])}]}
        elif name == "multiply":
            return {"content": [{"type": "text", "text": str(arguments["a"] * arguments["b"])}]}
        else:
            raise ValueError(f"Unknown tool {name}")

    async def __aenter__(self):
        return self

    async def __aexit__(self, exc_type, exc_val, exc_tb):
        pass


class MockAsyncExitStack:
    def __init__(self):
        self.entered = []

    async def enter_async_context(self, ctx):
        result = await ctx.__aenter__()
        self.entered.append((ctx, result))
        return result

    async def __aenter__(self):
        return self

    async def __aexit__(self, exc_type, exc_val, exc_tb):
        for ctx, _ in reversed(self.entered):
            await ctx.__aexit__(exc_type, exc_val, exc_tb)


def mock_sse_client(url):
    async def _mock():
        return (AsyncMock(), AsyncMock())

    return _mock()


def mock_streamablehttp_client(url):
    async def _mock():
        return (AsyncMock(), AsyncMock())

    return _mock()


def mock_stdio_client(command, args):
    async def _mock():
        return (AsyncMock(), AsyncMock())

    return _mock()


