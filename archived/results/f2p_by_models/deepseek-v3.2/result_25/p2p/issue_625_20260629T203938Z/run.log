        sse_thread = threading.Thread(
            target=run_server, args=(sse_app, 8006), daemon=True
        )
        sse_thread.start()
        time.sleep(2)

        async def test():
            config = {"url": "http://127.0.0.1:8006/sse"}
            manager = MCPManager(config)
            await manager.initialize()
            tools = await manager.list_tools()
            assert len(tools) == 1
            assert tools[0]["name"] == "add"
