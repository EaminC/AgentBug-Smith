@pytest.fixture
def mcp_server_process():
    """Start a simple MCP server that supports both SSE and streamable HTTP."""
    # Create a temporary Python script that runs a minimal MCP server
    server_code = """
import asyncio
import uvicorn
from mcp.server.fastmcp import FastMCP
from starlette.applications import Starlette
from starlette.routing import Mount

# Create two simple MCP servers
mcp_sse = FastMCP("SSE_Server")
mcp_http = FastMCP("HTTP_Server")

@mcp_sse.tool()
def add(a: int, b: int) -> int:
    return a + b

@mcp_http.tool()
def multiply(a: int, b: int) -> int:
    return a * b

# Create the combined app
app = Starlette(
    routes=[
        Mount("/sse/", app=mcp_sse.sse_app()),
        Mount("/http/", app=mcp_http.streamable_http_app()),
    ]
)

if __name__ == "__main__":
    uvicorn.run(app, host="127.0.0.1", port=8765)
"""
    with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False) as f:
        f.write(server_code)
        server_script = f.name

    # Start the server process
    proc = subprocess.Popen(
        [sys.executable, server_script],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    # Give server time to start
    time.sleep(3)
    yield proc
    # Cleanup
    proc.terminate()
    proc.wait(timeout=5)
    os.unlink(server_script)


@pytest.mark.asyncio
async def test_mcp_streamable_http_client():
    """Test that MCPManager can connect to a streamable HTTP MCP server."""
    # This test will fail on buggy code because streamable_http_client is not imported
    # and the 'type' parameter handling is missing.
    manager = MCPManager(
        {
            "mcpServers": {
                "test-http": {
                    "type": "streamable_http",
                    "url": "http://127.0.0.1:8765/http/mcp/",
                }
            }
        }
    )
    
    try:
        # Initialize should succeed if streamable HTTP is supported
        await manager.initialize()
        # If we get here, the bug is fixed (streamable_http_client imported and used)
        # Verify we can list tools
        tools = await manager.list_tools()
        assert isinstance(tools, list)
        # The server provides a multiply tool
        tool_names = [t.name for t in tools]
        assert "multiply" in tool_names
    except Exception as e:
        # On buggy code, we expect an ImportError or KeyError because
        # streamable_http_client is not imported or 'type' not recognized
        error_msg = str(e).lower()
        # Check if error is due to missing streamable_http support
        if "streamable_http" in error_msg or "type" in error_msg or "import" in error_msg:
            # This is the buggy behavior - test should fail
            pytest.fail(f"Buggy code raised: {e}")
        else:
            # Some other error (e.g., connection refused) - re-raise
            raise


