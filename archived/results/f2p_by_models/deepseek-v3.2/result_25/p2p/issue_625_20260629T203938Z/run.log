[32mimport json
import os
import sys
import asyncio
from unittest.mock import patch, MagicMock, AsyncMock
import pytest
from agentscope.service import ServiceToolkit
from agentscope.service.mcp_manager import MCPManager


class TestMCPStreamableHTTPClient:
    """Test that MCPManager supports streamable_http client type."""

    def test_mcp_manager_streamable_http_client_initialization(self):
        """Test that MCPManager can be initialized with streamable_http type."""
        # This test should fail on buggy code because streamable_http is not recognized.
        config = {
            "type": "streamable_http",
            "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
        }
        # The buggy code will treat this as SSE and try to use sse_client,
        # causing an error because the URL is not an SSE endpoint.
        # After the fix, it should recognize "streamable_http" and use streamablehttp_client.
        manager = MCPManager(config)
        assert manager.config["type"] == "streamable_http"
        assert manager.config["url"] == config["url"]

    @pytest.mark.asyncio
    async def test_mcp_manager_streamable_http_initialize(self):
        """Test that initialize() works with streamable_http type."""
        # Mock the mcp module and its clients to avoid actual network calls.
        # The buggy code will call sse_client for streamable_http, which will fail.
        # After the fix, it should call streamablehttp_client.
        mock_mcp = MagicMock()
        mock_client_session = AsyncMock()
        mock_client_session.__aenter__ = AsyncMock(return_value=AsyncMock())
        mock_client_session.__aexit__ = AsyncMock(return_value=None)
        mock_streamablehttp_client = AsyncMock()
        mock_streamablehttp_client.return_value.__aenter__ = AsyncMock(
            return_value=(AsyncMock(), AsyncMock())
        )
        mock_streamablehttp_client.return_value.__aexit__ = AsyncMock(return_value=None)

        with patch.dict(sys.modules, {"mcp": mock_mcp}):
            with patch(
                "agentscope.service.mcp_manager.streamablehttp_client",
                mock_streamablehttp_client,
            ):
                with patch(
                    "agentscope.service.mcp_manager.mcp.ClientSession",
                    mock_client_session,
                ):
                    config = {
                        "type": "streamable_http",
                        "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
                    }
                    manager = MCPManager(config)
                    # On buggy code, initialize will raise an AttributeError because
                    # streamablehttp_client is not imported.
                    # After fix, it should succeed.
                    await manager.initialize()
                    # Verify that streamablehttp_client was called with the correct URL.
                    mock_streamablehttp_client.assert_called_once_with(
                        url="http://127.0.0.1:8001/streamable_http_app/mcp/"
                    )

