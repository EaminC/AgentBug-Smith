                },
            },
        )

        # Check that servers were added
        assert hasattr(toolkit, "_mcp_managers")
        # The exact structure may vary, but we at least want to ensure
        # no exception was raised when adding streamable_http type.

    def test_react_agent_v2_current_structured_model_assignment(self):
        """Test that _current_structured_model is assigned in ReActAgentV2.reply."""
        from agentscope.agents import ReActAgentV2

        # Create a minimal agent with mocked components
        # We'll mock the model call to avoid needing actual API
        import agentscope
        from unittest.mock import Mock, patch

        # Mock model config
        mock_model = Mock()
        mock_model.return_value = Msg("assistant", "Thought: I need to use a tool\nAction: add\nAction Input: {\"a\": 1, \"b\": 2}")

        with patch.object(agentscope.models, "ModelFactory", return_value=mock_model):
            agent = ReActAgentV2(
                name="test",
                model_config_name="dummy",
                sys_prompt="test",
            )

        # Mock the structured model call
        mock_structured_model = Mock()
        mock_structured_model.return_value = {
            "thought": "test",
            "action": "finish",
            "action_input": {"result": "test"},
        }

        # Call reply with a message
        test_msg = Msg("user", "Calculate 1+2")
        with patch.object(agent, "_current_structured_model", None):
            with patch.object(agent, "_call_structured_model", mock_structured_model):
                # This should assign _current_structured_model
                result = agent.reply(test_msg)

        # After the fix, _current_structured_model should be set
        # In buggy code, it remains None
        assert agent._current_structured_model is not None

    @pytest.mark.integration
    @pytest.mark.asyncio
    async def test_streamable_http_client_integration(self, mcp_server_process):
        """Integration test: connect to actual streamable HTTP server and call a tool."""
        try:
            import mcp
        except ImportError:
            pytest.skip("mcp package not installed")

        # Configuration for streamable HTTP
        config = {
            "type": "streamable_http",
            "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
        }

        manager = MCPManager(config)

        try:
            await manager.initialize()

            # List available tools
            tools = await manager.list_tools()
            # The multiply tool should be available
            tool_names = [tool.name for tool in tools]
            assert "multiply" in tool_names

            # Call the multiply tool
            result = await manager.call_tool("multiply", {"a": 5, "b": 6})
            assert result == 30  # 5 * 6 = 30

        finally:
            await manager.cleanup()

    def test_logging_context_formatting(self):
        """Test the logging fix where context is formatted separately."""
        # This tests the logging.py change in the patch
        from agentscope.logging import error
        import loguru

        # Mock loguru logger to capture calls
        mock_logger = Mock()
        with patch.object(loguru.logger, "error", mock_logger):
            error("Test message", extra={"key": "value"}, another=123)

        # Check that the error was called with properly formatted context
        mock_logger.assert_called_once()
        args = mock_logger.call_args[0]
        assert len(args) == 1
        log_message = args[0]
        assert "Test message" in log_message
        assert '"key": "value"' in log_message
        assert '"another": 123' in log_message
        # Ensure no double json.dumps issue (buggy code had separate json.dumps)
        # The fix uses a single json.dumps for the entire kwargs dict

