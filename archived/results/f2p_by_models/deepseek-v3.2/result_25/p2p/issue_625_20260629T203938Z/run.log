def test_mcp_manager_streamable_http_case_insensitive():
    """Test that type 'streamableHttp' (camelCase) also works."""
    with patch("agentscope.service.mcp_manager.mcp") as mock_mcp:
        mock_mcp.ClientSession = AsyncMock()
        mock_mcp.ClientSession.return_value.__aenter__ = AsyncMock()
        mock_mcp.ClientSession.return_value.__aexit__ = AsyncMock()
        with patch("agentscope.service.mcp_manager.streamablehttp_client") as mock_streamablehttp:
            mock_read = MagicMock()
            mock_write = MagicMock()
            mock_streamablehttp.return_value.__aenter__ = AsyncMock(return_value=(mock_read, mock_write))
            config = {
                "type": "streamableHttp",  # camelCase variant
                "url": "http://localhost:8001/mcp/",
            }
            manager = MCPManager(config)
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)
            try:
                loop.run_until_complete(manager.initialize())
            finally:
                loop.close()
            mock_streamablehttp.assert_called_once_with(url=config["url"])


def test_mcp_manager_missing_streamable_http_client_buggy():
    """In buggy code, streamablehttp_client may not be imported, causing AttributeError."""
    # Temporarily remove streamablehttp_client from module to simulate buggy state
    original = getattr(sys.modules["agentscope.service.mcp_manager"], "streamablehttp_client", None)
    try:
        del sys.modules["agentscope.service.mcp_manager"].streamablehttp_client
    except AttributeError:
        pass
    # Now attempt to create MCPManager with streamable_http type
    config = {
        "type": "streamable_http",
        "url": "http://localhost:8001/mcp/",
    }
    # In buggy code, the manager may still construct but initialize will fail.
    manager = MCPManager(config)
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    try:
        # This should raise AttributeError because streamablehttp_client is not defined
        with pytest.raises(AttributeError):
            loop.run_until_complete(manager.initialize())
    finally:
        loop.close()
    # Restore
    if original is not None:
        sys.modules["agentscope.service.mcp_manager"].streamablehttp_client = original


