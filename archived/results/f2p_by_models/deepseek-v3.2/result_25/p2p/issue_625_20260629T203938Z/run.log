def test_mcp_manager_streamable_http_client_support():
    """Test that MCPManager correctly handles streamable_http type."""
    # Mock the mcp import inside MCPManager
    with patch("agentscope.service.mcp_manager.mcp") as mock_mcp:
        # Ensure mcp is not None (simulate import success)
        mock_mcp.ClientSession = AsyncMock()
        mock_mcp.ClientSession.return_value.__aenter__ = AsyncMock(
            return_value=AsyncMock(),
        )
        mock_mcp.ClientSession.return_value.__aexit__ = AsyncMock()

        # Mock the streamablehttp_client
        with patch(
            "agentscope.service.mcp_manager.streamablehttp_client",
        ) as mock_streamablehttp_client:
            mock_streamablehttp_client.return_value.__aenter__ = AsyncMock(
                return_value=(AsyncMock(), AsyncMock()),
            )
            mock_streamablehttp_client.return_value.__aexit__ = AsyncMock()

            # Create a config for streamable_http type
            config = {
                "type": "streamable_http",
                "url": "http://localhost:9999/mcp/",
            }

            # Instantiate MCPManager
            manager = MCPManager(config)

            # Run initialization (should use streamablehttp_client)
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)
            try:
                loop.run_until_complete(manager.initialize())
            finally:
                loop.close()

            # Verify streamablehttp_client was called with correct URL
            mock_streamablehttp_client.assert_called_once_with(
                url="http://localhost:9999/mcp/",
            )


