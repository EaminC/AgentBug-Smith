    mock_mcp = MagicMock()
    mock_mcp.ClientSession = MockMCPClientSession

    with patch.dict(sys.modules, {"mcp": mock_mcp}):
        with patch("agentscope.service.mcp_manager.mcp", mock_mcp):
            with patch("agentscope.service.mcp_manager.sse_client", side_effect=mock_sse_client):
                with patch("agentscope.service.mcp_manager.stdio_client", side_effect=mock_stdio_client):
                    with patch("agentscope.service.mcp_manager.streamablehttp_client", side_effect=mock_streamablehttp_client):
