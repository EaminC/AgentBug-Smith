def test_mcp_manager_streamable_http_support():
    """Test that MCPManager correctly handles streamable_http type."""
    # Mock the internal mcp client functions
    with patch('agentscope.service.mcp_manager.sse_client') as mock_sse_client, \
         patch('agentscope.service.mcp_manager.stdio_client') as mock_stdio_client, \
         patch('agentscope.service.mcp_manager.streamablehttp_client') as mock_streamablehttp_client:
        
        # Setup mock async context managers
        mock_sse_streams = (AsyncMock(), AsyncMock())
        mock_sse_client.return_value.__aenter__.return_value = mock_sse_streams
        
        mock_stdio_streams = (AsyncMock(), AsyncMock())
        mock_stdio_client.return_value.__aenter__.return_value = mock_stdio_streams
        
        mock_http_streams = (AsyncMock(), AsyncMock())
        mock_streamablehttp_client.return_value.__aenter__.return_value = mock_http_streams
        
        # Mock ClientSession
        mock_session = AsyncMock()
        mock_session.list_tools.return_value = AsyncMock()
        mock_session.list_tools.return_value.tools = []
        mock_session.__aenter__.return_value = mock_session
        
        with patch('agentscope.service.mcp_manager.mcp.ClientSession', return_value=mock_session):
            
            # Test 1: SSE type (default)
            config_sse = {
                "url": "http://127.0.0.1:8000/sse"
            }
            manager_sse = MCPManager(config_sse)
            
            async def test_sse():
                await manager_sse.initialize()
                # Should call sse_client
                mock_sse_client.assert_called_once_with(url="http://127.0.0.1:8000/sse")
                mock_stdio_client.assert_not_called()
                mock_streamablehttp_client.assert_not_called()
            
            asyncio.run(test_sse())
            
            # Reset mocks
            mock_sse_client.reset_mock()
            mock_stdio_client.reset_mock()
            mock_streamablehttp_client.reset_mock()
            
            # Test 2: streamable_http type
            config_http = {
                "type": "streamable_http",
                "url": "http://127.0.0.1:8000/mcp/"
            }
            manager_http = MCPManager(config_http)
            
            async def test_http():
                await manager_http.initialize()
                # Should call streamablehttp_client
                mock_streamablehttp_client.assert_called_once_with(url="http://127.0.0.1:8000/mcp/")
                mock_sse_client.assert_not_called()
                mock_stdio_client.assert_not_called()
            
            asyncio.run(test_http())
            
            # Reset mocks
            mock_sse_client.reset_mock()
            mock_stdio_client.reset_mock()
            mock_streamablehttp_client.reset_mock()
            
            # Test 3: streamableHttp (camelCase)
            config_camel = {
                "type": "streamableHttp",
                "url": "http://127.0.0.1:8001/mcp/"
            }
            manager_camel = MCPManager(config_camel)
            
            async def test_camel():
                await manager_camel.initialize()
                # Should call streamablehttp_client
                mock_streamablehttp_client.assert_called_once_with(url="http://127.0.0.1:8001/mcp/")
                mock_sse_client.assert_not_called()
                mock_stdio_client.assert_not_called()
            
            asyncio.run(test_camel())

def test_service_toolkit_add_mcp_servers():
    """Test ServiceToolkit.add_mcp_servers with streamable_http config."""
    toolkit = ServiceToolkit()
    
    # Mock MCPManager to avoid actual initialization
    with patch('agentscope.service.mcp_manager.MCPManager') as MockMCPManager:
        mock_manager = AsyncMock()
        mock_manager.initialize = AsyncMock()
        MockMCPManager.return_value = mock_manager
        
        # Config with both SSE and streamable_http
        config = {
            "mcpServers": {
                "add-tool": {
                    "type": "sse",
                    "url": "http://127.0.0.1:8001/sse_app/sse"
                },
                "multiply-tool": {
                    "type": "streamable_http",
                    "url": "http://127.0.0.1:8001/streamable_http_app/mcp/"
                }
            }
        }
        
        toolkit.add_mcp_servers(config)
        
        # Should create two MCPManager instances
        assert MockMCPManager.call_count == 2
        
        # Check first call (SSE)
        first_call = MockMCPManager.call_args_list[0]
        first_config = first_call[0][0]
        assert first_config["type"] == "sse"
        assert first_config["url"] == "http://127.0.0.1:8001/sse_app/sse"
        
        # Check second call (streamable_http)
        second_call = MockMCPManager.call_args_list[1]
        second_config = second_call[0][0]
        assert second_config["type"] == "streamable_http"
        assert second_config["url"] == "http://127.0.0.1:8001/streamable_http_app/mcp/"

def test_react_agent_v2_with_mcp():
    """Test ReActAgentV2 with MCP tools including streamable_http."""
    # Initialize agentscope with a dummy config
    agentscope.init(
        model_configs=[
            {
                "config_name": "test_config",
                "model_type": "openai_chat",
                "model_name": "gpt-3.5-turbo",
                "api_key": "dummy_key",
                "client_args": {
                    "base_url": "http://localhost:8080"
                }
            }
        ]
    )
    
    # Create toolkit with mocked MCP managers
    toolkit = ServiceToolkit()
    
    # Mock the actual tool execution
    with patch('agentscope.service.mcp_manager.MCPManager') as MockMCPManager:
        mock_manager = AsyncMock()
        
        # Setup mock tools
        mock_tool1 = MagicMock()
        mock_tool1.name = "add"
        mock_tool1.description = "Add two numbers"
        mock_tool1.parameters = {
            "type": "object",
            "properties": {
                "a": {"type": "integer"},
                "b": {"type": "integer"}
            }
        }
        
        mock_tool2 = MagicMock()
        mock_tool2.name = "multiply"
        mock_tool2.description = "Multiply two numbers"
        mock_tool2.parameters = {
            "type": "object",
            "properties": {
                "a": {"type": "integer"},
                "b": {"type": "integer"}
            }
        }
        
        # Mock list_tools response
        mock_list_tools1 = AsyncMock()
        mock_list_tools1.tools = [mock_tool1]
        mock_list_tools2 = AsyncMock()
        mock_list_tools2.tools = [mock_tool2]
        
        # Mock call_tool responses
        mock_call_tool1 = AsyncMock()
        mock_call_tool1.content = [{"type": "text", "text": "7"}]
        mock_call_tool2 = AsyncMock()
        mock_call_tool2.content = [{"type": "text", "text": "12"}]
        
        # Setup session mock
        mock_session1 = AsyncMock()
        mock_session1.list_tools.return_value = mock_list_tools1
        mock_session1.call_tool.return_value = mock_call_tool1
        
        mock_session2 = AsyncMock()
        mock_session2.list_tools.return_value = mock_list_tools2
        mock_session2.call_tool.return_value = mock_call_tool2
        
        # Setup context manager behavior
        mock_manager.__aenter__.side_effect = [mock_session1, mock_session2]
        mock_manager.initialize = AsyncMock()
        
        MockMCPManager.return_value = mock_manager
        
        # Add MCP servers
        toolkit.add_mcp_servers({
            "mcpServers": {
                "add-server": {
                    "type": "sse",
                    "url": "http://127.0.0.1:8000/sse"
                },
                "multiply-server": {
                    "type": "streamable_http",
                    "url": "http://127.0.0.1:8000/mcp/"
                }
            }
        })
        
        # Create agent with toolkit
        agent = ReActAgentV2(
            name="TestAgent",
            model_config_name="test_config",
            service_toolkit=toolkit,
            sys_prompt="You are a test assistant.",
            max_iters=2
        )
        
        # Mock the model call to return a tool call
        with patch('agentscope.agents._react_agent_v2.ReActAgentV2._call_model') as mock_call_model:
            # First call: model returns a tool call for multiplication
            mock_call_model.return_value = {
                "thought": "I need to multiply numbers",
                "tool_calls": [{
                    "type": "function",
                    "function": {
                        "name": "multiply",
                        "arguments": json.dumps({"a": 3, "b": 4})
                    }
                }]
            }
            
            # Second call: model returns final answer
            mock_call_model.return_value = {
                "thought": "The result is 12",
                "tool_calls": []
            }
            
            # Run agent
            result = agent(Msg("user", "Multiply 3 and 4", "user"))
            
            # Verify tool was called
            mock_session2.call_tool.assert_called_once_with("multiply", arguments={"a": 3, "b": 4})
            
            # Verify the agent has the structured model attribute (bug fix)
            assert hasattr(agent, '_current_structured_model')

