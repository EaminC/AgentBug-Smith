            with patch('agentscope.service.mcp_manager.sse_client', mock_mcp.client.sse_client):
                with patch('agentscope.service.mcp_manager.stdio_client', mock_mcp.client.stdio.stdio_client):
                    with patch('agentscope.service.mcp_manager.streamablehttp_client', mock_mcp.client.streamable_http.streamablehttp_client):
                        # Re-import the module to use the mocked mcp.
                        import importlib
                        import agentscope.service.mcp_manager as mcp_mod
                        importlib.reload(mcp_mod)
                        from agentscope.service.mcp_manager import MCPManager

                        # Create manager with streamable_http config.
                        manager = MCPManager(config)
                        # Mock the _exit_stack attribute.
                        manager._exit_stack = mock_stack

                        # Run initialize.
                        # In the buggy version, the condition for streamable_http is missing,
                        # so it will call sse_client. We'll simulate that by checking the code.
                        # We'll inspect the source code of the buggy version.
                        # Since we cannot dynamically switch between buggy and fixed,
                        # we'll rely on the fact that the test will be run twice.
                        # We'll just run the initialize and see what happens.
                        # The test will pass in fixed version and fail in buggy version.
                        try:
                            asyncio.run(manager.initialize())
                        except Exception as e:
                            # In buggy version, we expect an error because sse_client is called
                            # with a non-SSE URL. But the mock will not raise.
                            # Instead, we can check which client was called.
                            # We'll assert that streamablehttp_client was called in fixed version.
                            # In buggy version, sse_client should be called.
                            pass

                        # Check which client was called.
                        if mock_mcp.client.streamable_http.streamablehttp_client.called:
                            # This is the fixed behavior.
                            assert True
                        else:
                            # This is the buggy behavior.
                            assert False, "streamablehttp_client was not called, buggy code path used"

    # Clean up.
    if original_mcp:
        sys.modules['mcp'] = original_mcp


def test_mcp_manager_streamable_http_integration():
    """Integration test for MCPManager with streamable_http."""
    # This test requires a running MCP server with streamable_http endpoint.
    # We'll start a simple server using the example code from the patch.
    # However, we cannot start a real server in a unit test because it's complex.
    # Instead, we'll mock the server and test the client side.
    # We'll use the ServiceToolkit to add an MCP server and verify it works.
    toolkit = ServiceToolkit()
    # Add a streamable_http server.
    toolkit.add_mcp_servers({
        "mcpServers": {
            "test-server": {
                "type": "streamable_http",
                "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
            },
        },
    })

    # Verify that the server was added.
    assert "test-server" in toolkit._mcp_managers
    manager = toolkit._mcp_managers["test-server"]
    assert isinstance(manager, MCPManager)
    # Check the config.
    assert manager.config["type"] == "streamable_http"
    assert manager.config["url"] == "http://127.0.0.1:8001/streamable_http_app/mcp/"

    # Now test that the manager can be initialized (with mocks).
    # We'll mock the mcp module again.
    mock_mcp = MagicMock()
    mock_mcp.client.streamable_http.streamablehttp_client = AsyncMock()
    mock_mcp.ClientSession = AsyncMock()
    mock_streams = (AsyncMock(), AsyncMock())
    mock_mcp.client.streamable_http.streamablehttp_client.return_value.__aenter__.return_value = mock_streams
    mock_session = AsyncMock()
    mock_mcp.ClientSession.return_value.__aenter__.return_value = mock_session

    with patch.dict('sys.modules', {'mcp': mock_mcp}):
        with patch('agentscope.service.mcp_manager.mcp', mock_mcp):
            with patch('agentscope.service.mcp_manager.streamablehttp_client', mock_mcp.client.streamable_http.streamablehttp_client):
                import importlib
                import agentscope.service.mcp_manager as mcp_mod
                importlib.reload(mcp_mod)
                from agentscope.service.mcp_manager import MCPManager

                # Re-create the manager with the mocked module.
                manager = MCPManager(manager.config)
                # Run initialize.
                asyncio.run(manager.initialize())
                # Verify that streamablehttp_client was called.
                assert mock_mcp.client.streamable_http.streamablehttp_client.called
                # Verify the URL.
                call_args = mock_mcp.client.streamable_http.streamablehttp_client.call_args
                assert call_args[1]['url'] == "http://127.0.0.1:8001/streamable_http_app/mcp/"


