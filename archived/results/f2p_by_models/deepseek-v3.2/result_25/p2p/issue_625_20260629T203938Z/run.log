def test_mcp_manager_streamable_http_client_support():
    """Test that MCPManager correctly handles streamable_http type."""
    # Mock the mcp import to avoid actual MCP dependencies if missing
    # but we still need to test the logic in MCPManager.initialize
    with patch("agentscope.service.mcp_manager.mcp") as mock_mcp:
        # Ensure mcp is not None so the manager proceeds
        mock_mcp.ClientSession = AsyncMock()
        mock_mcp.ClientSession.return_value.__aenter__ = AsyncMock()
        mock_mcp.ClientSession.return_value.__aexit__ = AsyncMock()

        # Mock the streamablehttp_client and sse_client
        with patch("agentscope.service.mcp_manager.streamablehttp_client") as mock_streamablehttp:
            with patch("agentscope.service.mcp_manager.sse_client") as mock_sse:
                # Setup mock streams
                mock_read = MagicMock()
                mock_write = MagicMock()
                mock_streamablehttp.return_value.__aenter__ = AsyncMock(return_value=(mock_read, mock_write))
                mock_sse.return_value.__aenter__ = AsyncMock(return_value=(mock_read, mock_write))

                # Test 1: streamable_http type
                config = {
                    "type": "streamable_http",
                    "url": "http://localhost:8001/streamable_http_app/mcp/",
                }
                manager = MCPManager(config)
                # Run initialize and verify streamablehttp_client is called
                loop = asyncio.new_event_loop()
                asyncio.set_event_loop(loop)
                try:
                    loop.run_until_complete(manager.initialize())
                finally:
                    loop.close()
                # In buggy code, streamablehttp_client is not imported/used,
                # so this will raise AttributeError or fallback to sse.
                # After fix, streamablehttp_client should be called.
                mock_streamablehttp.assert_called_once_with(url=config["url"])
                mock_sse.assert_not_called()

                # Test 2: sse type (default)
                config2 = {
                    "type": "sse",
                    "url": "http://localhost:8001/sse_app/sse",
                }
                manager2 = MCPManager(config2)
                loop2 = asyncio.new_event_loop()
                asyncio.set_event_loop(loop2)
                try:
                    loop2.run_until_complete(manager2.initialize())
                finally:
                    loop2.close()
                mock_sse.assert_called_once_with(url=config2["url"])

                # Test 3: no type (defaults to sse)
                config3 = {
                    "url": "http://localhost:8001/sse_app/sse",
                }
                manager3 = MCPManager(config3)
                loop3 = asyncio.new_event_loop()
                asyncio.set_event_loop(loop3)
                try:
                    loop3.run_until_complete(manager3.initialize())
                finally:
                    loop3.close()
                # Should default to sse
                assert mock_sse.call_count == 2  # once from previous, once now


