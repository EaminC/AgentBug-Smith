@pytest.mark.asyncio
async def test_mcp_manager_streamable_http_client(mock_mcp_module):
    """Test that MCPManager can initialize with streamable_http type."""
    config = {
        "type": "streamable_http",
        "url": "http://127.0.0.1:8001/streamable_http_app/mcp/",
    }

    manager = MCPManager(config)
    await manager.initialize()

    # The manager should have a session after initialization
    assert manager.session is not None
    assert isinstance(manager.session, MockMCPClientSession)
    assert manager.session.initialized is True

    # List tools should work
    tools = await manager.session.list_tools()
    assert isinstance(tools, dict)
    assert "tools" in tools

    # Cleanup
    await manager.close()


