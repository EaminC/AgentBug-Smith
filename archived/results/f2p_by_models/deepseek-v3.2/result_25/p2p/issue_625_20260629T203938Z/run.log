def test_react_agent_v2_current_structured_model():
    """Test that ReActAgentV2 sets _current_structured_model attribute.
    
    This is a regression test for the fix in _react_agent_v2.py where
    _current_structured_model is set in the reply method.
    """
    from agentscope.agents import ReActAgentV2
    from agentscope.message import Msg
    
    # Create a minimal agent with a dummy model config
    agent = ReActAgentV2(
        name="test",
        model_config_name="test_config",
        sys_prompt="Test",
    )
    
    # Mock the model call to return a structured response
    original_call = agent.model.__call__
    
    def mock_call(*args, **kwargs):
        from agentscope.message import Msg
        return Msg("assistant", "thought: test\naction: test\n", role="assistant")
    
    agent.model.__call__ = mock_call
    
    try:
        # Call reply which should set _current_structured_model
        response = agent.reply(Msg("user", "test", "user"))
        # After fix, this attribute should be set
        assert hasattr(agent, '_current_structured_model')
        # It should be the structured model instance used
        assert agent._current_structured_model is not None
    finally:
        agent.model.__call__ = original_call


