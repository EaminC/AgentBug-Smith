[32mimport os
import tempfile
from unittest.mock import MagicMock, patch
import pytest
from agentscope.utils.logging_utils import log_studio


def test_log_studio_with_empty_url_audio_video():
    """Regression test for the bug where empty string url/audio_path/video_path
    should be treated as absent (flushing=True) and not cause errors.
    """
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        with tempfile.TemporaryDirectory() as tmpdir:
            original_cwd = os.getcwd()
            os.chdir(tmpdir)
            try:
                os.makedirs("./runs", exist_ok=True)
                message = {
                    "name": "test",
                    "content": "test",
                    "url": "",
                    "audio_path": "",
                    "video_path": "",
                }
                log_studio(message, "test_uid")
                # The buggy code would treat empty string as present and set flushing=False,
                # but also would try to iterate over the string (since it's not a list).
                # The fix should treat empty string as absent, so flushing should be True.
                # We can't directly check flushing, but we can verify the request was made
                # without any image/audio/video tags.
                assert mock_post.called
                call_args = mock_post.call_args
                payload = call_args[1]["json"]
                # Ensure no extra tags added
                assert "<img" not in payload["msg"]
                assert "<audio" not in payload["msg"]
                assert "<video" not in payload["msg"]
            finally:
                os.chdir(original_cwd)


def test_log_studio_with_string_url_converted_to_list():
    """Test that a single string url/audio_path/video_path is converted to a list."""
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        with tempfile.TemporaryDirectory() as tmpdir:
            original_cwd = os.getcwd()
            os.chdir(tmpdir)
            try:
                os.makedirs("./runs", exist_ok=True)
                message = {
                    "name": "test",
                    "content": "test",
                    "url": "http://example.com/image.jpg",
                    "audio_path": "/tmp/audio.mp3",
                    "video_path": "/tmp/video.mp4",
                }
                log_studio(message, "test_uid")
                assert mock_post.called
                call_args = mock_post.call_args
                payload = call_args[1]["json"]
                # The fix should convert each string to a list and embed one tag each.
                assert payload["msg"].count("<img") == 1
                assert payload["msg"].count("<audio") == 1
                assert payload["msg"].count("<video") == 1
            finally:
                os.chdir(original_cwd)


