[32mimport os
import tempfile
from unittest.mock import MagicMock, patch
from agentscope.utils.logging_utils import log_studio


def test_log_studio_with_empty_url_audio_video():
    """Test that empty url/audio_path/video_path does not cause flushing=False."""
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        with tempfile.TemporaryDirectory() as tmpdir:
            original_cwd = os.getcwd()
            os.chdir(tmpdir)
            try:
                os.makedirs("./runs", exist_ok=True)
                message = {
                    "name": "test",
                    "content": "test content",
                    "url": "",
                    "audio_path": None,
                    "video_path": [],
                }
                log_studio(message, "test_uid")
                # In buggy code, empty string url would set flushing=False.
                # We can't directly check flushing, but we can verify the request
                # was made with correct content.
                assert mock_post.called
                call_args = mock_post.call_args
                # The request body should contain the content without extra img/audio/video tags.
                request_body = call_args[1]["json"]
                assert "test content" in request_body["content"]
                # Ensure no extra tags added.
                assert "<img" not in request_body["content"]
                assert "<audio" not in request_body["content"]
                assert "<video" not in request_body["content"]
            finally:
                os.chdir(original_cwd)


def test_log_studio_with_string_url_converted_to_list():
    """Test that a single string url is converted to a list."""
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        with tempfile.TemporaryDirectory() as tmpdir:
            original_cwd = os.getcwd()
            os.chdir(tmpdir)
            try:
                os.makedirs("./runs", exist_ok=True)
                message = {
                    "name": "test",
                    "content": "test content",
                    "url": "http://example.com/image.jpg",
                }
                log_studio(message, "test_uid")
                assert mock_post.called
                call_args = mock_post.call_args
                request_body = call_args[1]["json"]
                # In buggy code, string url would cause error because it's not iterable with len.
                # The fix should convert string to list and include img tag.
                assert "<img src=\"http://example.com/image.jpg\"/>" in request_body["content"]
            finally:
                os.chdir(original_cwd)


def test_log_studio_with_list_url_audio_video():
    """Test that list url/audio_path/video_path are handled correctly."""
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        with tempfile.TemporaryDirectory() as tmpdir:
            original_cwd = os.getcwd()
            os.chdir(tmpdir)
            try:
                os.makedirs("./runs", exist_ok=True)
                message = {
                    "name": "test",
                    "content": "test content",
                    "url": ["http://example.com/img1.jpg", "http://example.com/img2.jpg"],
                    "audio_path": ["/tmp/audio1.mp3", "/tmp/audio2.mp3"],
                    "video_path": ["/tmp/video1.mp4", "/tmp/video2.mp4"],
                }
                log_studio(message, "test_uid")
                assert mock_post.called
                call_args = mock_post.call_args
                request_body = call_args[1]["json"]
                content = request_body["content"]
                assert "<img src=\"http://example.com/img1.jpg\"/>" in content
                assert "<img src=\"http://example.com/img2.jpg\"/>" in content
                assert "<audio src=\"/tmp/audio1.mp3\"\n                controls/></audio>" in content
                assert "<audio src=\"/tmp/audio2.mp3\"\n                controls/></audio>" in content
                assert "<video src=\"/tmp/video1.mp4\"\n                controls/></video>" in content
                assert "<video src=\"/tmp/video2.mp4\"\n                controls/></video>" in content
            finally:
                os.chdir(original_cwd)


def test_log_studio_flushing_flag():
    """Test that flushing flag is set correctly when url/audio_path/video_path are present."""
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        with tempfile.TemporaryDirectory() as tmpdir:
            original_cwd = os.getcwd()
            os.chdir(tmpdir)
            try:
                os.makedirs("./runs", exist_ok=True)
                # Case 1: no media fields -> flushing should be True
                message1 = {"name": "test", "content": "test content"}
                log_studio(message1, "test_uid")
                # We cannot directly check flushing, but we can verify request was made.
                assert mock_post.called
                mock_post.reset_mock()
                # Case 2: with url -> flushing should be False
                message2 = {
                    "name": "test",
                    "content": "test content",
                    "url": "http://example.com/image.jpg",
                }
                log_studio(message2, "test_uid")
                assert mock_post.called
                # The request should have been made with the img tag.
                call_args = mock_post.call_args
                request_body = call_args[1]["json"]
                assert "<img" in request_body["content"]
            finally:
                os.chdir(original_cwd)


