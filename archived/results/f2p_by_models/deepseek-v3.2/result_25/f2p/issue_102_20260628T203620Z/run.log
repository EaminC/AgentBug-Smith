    def test_log_studio_with_empty_url_audio_video(self):
        """Test that empty url/audio_path/video_path does not cause flushing=False."""
        mock_response = MagicMock()
        mock_response.status_code = 200
        mock_response.json.return_value = {"code": 0, "msg": "ok"}

        with patch("requests.post", return_value=mock_response) as mock_post:
            with tempfile.TemporaryDirectory() as tmpdir:
                original_cwd = os.getcwd()
                os.chdir(tmpdir)
                try:
                    os.makedirs("./runs", exist_ok=True)
                    # Bug: before fix, empty string or list would set flushing=False
                    # After fix: only non-empty values set flushing=False
                    message = {
                        "name": "test",
                        "content": "test",
                        "url": "",
                        "audio_path": [],
                        "video_path": "",
                    }
                    log_studio(message, "test_uid")
                    # The function should not crash and flushing should be True
                    # because empty values are treated as absent.
                    # We can't directly check flushing, but we can verify the call
                    # happened without error.
                    assert mock_post.called
                finally:
                    os.chdir(original_cwd)

