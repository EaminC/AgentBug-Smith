def test_log_studio_flushing_flag():
    """Test that flushing flag is set correctly."""
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        with tempfile.TemporaryDirectory() as tmpdir:
            original_cwd = os.getcwd()
            os.chdir(tmpdir)
            try:
                os.makedirs("./runs", exist_ok=True)
                # Case 1: no media -> flushing True
                message1 = {"name": "test", "content": "test"}
                log_studio(message1, "test_uid")
                call1 = mock_post.call_args
                payload1 = call1.kwargs.get("json", {})
                assert payload1.get("flushing", None) is True
                mock_post.reset_mock()
                # Case 2: with url -> flushing False
                message2 = {
                    "name": "test",
                    "content": "test",
                    "url": "http://example.com/image.jpg",
                }
                log_studio(message2, "test_uid")
                call2 = mock_post.call_args
                payload2 = call2.kwargs.get("json", {})
                assert payload2.get("flushing", None) is False
                mock_post.reset_mock()
                # Case 3: empty url string -> flushing True (buggy version would treat empty string as present)
                message3 = {"name": "test", "content": "test", "url": ""}
                log_studio(message3, "test_uid")
                call3 = mock_post.call_args
                payload3 = call3.kwargs.get("json", {})
                # In buggy version, flushing would be False because 'url' in message is True even if empty.
                # In fixed version, flushing should be True because empty string is falsy.
                # We assert the fixed behavior.
                assert payload3.get("flushing", None) is True
            finally:
                os.chdir(original_cwd)


