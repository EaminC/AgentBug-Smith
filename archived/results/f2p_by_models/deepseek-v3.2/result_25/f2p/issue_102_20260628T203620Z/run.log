                    img_path = "./runs/test_image.png"
                    img.save(img_path)

                    message = {
                        "name": "test",
                        "content": "test",
                        "url": ["http://example.com/1.jpg", "http://example.com/2.jpg"],
                        "audio_path": ["audio1.mp3", "audio2.mp3"],
                        "video_path": ["video1.mp4", "video2.mp4"],
                    }
                    log_studio(message, "test_uid", avatar=img_path)

                    assert mock_post.called
                    call_args = mock_post.call_args
                    sent_data = call_args[1]["json"]
