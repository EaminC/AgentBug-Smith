[32mimport os
import tempfile
import json
from unittest.mock import MagicMock, patch
from PIL import Image
import pytest

from agentscope.utils.logging_utils import log_studio


class TestLogStudio:
    """Test the log_studio function for the bug fix in issue #102."""

    def test_log_studio_with_empty_url_audio_video(self):
        """Test that empty url/audio_path/video_path are handled correctly.

        In buggy code, if url, audio_path, or video_path are empty strings,
        they are treated as present and cause flushing=False, but no media
        is added. The fix adds checks for truthiness.
        """
        mock_response = MagicMock()
        mock_response.status_code = 200
        mock_response.json.return_value = {"code": 0, "msg": "ok"}

        with patch("requests.post", return_value=mock_response) as mock_post:
            with tempfile.TemporaryDirectory() as tmpdir:
                original_cwd = os.getcwd()
                os.chdir(tmpdir)
                try:
                    os.makedirs("./runs", exist_ok=True)
                    # Create a dummy image to avoid PIL save error
                    img = Image.new("RGB", (10, 10), color="red")
                    img_path = "./runs/test_image.png"
                    img.save(img_path)

                    message = {
                        "name": "test",
                        "content": "test content",
                        "url": "",
                        "audio_path": "",
                        "video_path": "",
                    }
                    log_studio(message, "test_uid", avatar=img_path)

                    # Verify request was made
                    assert mock_post.called
                    call_args = mock_post.call_args
                    sent_data = call_args[1]["json"]
                    # The message content should not have media tags
                    assert "<img" not in sent_data["msg"]
                    assert "<audio" not in sent_data["msg"]
                    assert "<video" not in sent_data["msg"]
                    # flushing should be True because empty strings are falsy
                    # In buggy code, flushing would be False
                    assert sent_data["flushing"] is True
                finally:
                    os.chdir(original_cwd)

    def test_log_studio_with_string_url_converted_to_list(self):
        """Test that a single string url is converted to a list.

        In buggy code, if url is a string, the loop tries to iterate over
        characters. The fix converts string to list.
        """
        mock_response = MagicMock()
        mock_response.status_code = 200
        mock_response.json.return_value = {"code": 0, "msg": "ok"}

        with patch("requests.post", return_value=mock_response) as mock_post:
            with tempfile.TemporaryDirectory() as tmpdir:
                original_cwd = os.getcwd()
                os.chdir(tmpdir)
                try:
                    os.makedirs("./runs", exist_ok=True)
                    img = Image.new("RGB", (10, 10), color="red")
                    img_path = "./runs/test_image.png"
                    img.save(img_path)

                    message = {
                        "name": "test",
                        "content": "test",
                        "url": "http://example.com/image.jpg",
                    }
                    log_studio(message, "test_uid", avatar=img_path)

                    assert mock_post.called
                    call_args = mock_post.call_args
                    sent_data = call_args[1]["json"]
                    # Should have exactly one img tag
                    assert sent_data["msg"].count("<img") == 1
                    assert "http://example.com/image.jpg" in sent_data["msg"]
                    assert sent_data["flushing"] is False
                finally:
                    os.chdir(original_cwd)

    def test_log_studio_with_list_url_audio_video(self):
        """Test that list url/audio_path/video_path work correctly."""
        mock_response = MagicMock()
        mock_response.status_code = 200
        mock_response.json.return_value = {"code": 0, "msg": "ok"}

        with patch("requests.post", return_value=mock_response) as mock_post:
            with tempfile.TemporaryDirectory() as tmpdir:
                original_cwd = os.getcwd()
                os.chdir(tmpdir)
                try:
                    os.makedirs("./runs", exist_ok=True)
