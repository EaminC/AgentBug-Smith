                    assert sent_data["msg"].count("<img") == 2
                    assert sent_data["msg"].count("<audio") == 2
                    assert sent_data["msg"].count("<video") == 2
                    assert sent_data["flushing"] is False
                finally:
                    os.chdir(original_cwd)

