[32mimport json
import sys
from unittest.mock import MagicMock, patch
import pytest

from agentscope.utils.logging_utils import log_studio


def test_log_studio_with_empty_url_audio_video():
    """Test that empty string url/audio_path/video_path does not cause errors.

    Before fix, the condition `if "url" in message:` passes for empty string,
    causing flushing=False and potential errors when iterating over non-list values.

    After fix, empty strings/None should be skipped, and flushing should remain True.
    """
    # Mock the internal HTTP client to avoid real network calls
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        # Test case 1: empty string url
        message = {
            "name": "test_agent",
            "content": "test message",
            "url": "",
        }
        log_studio(message, "test_uid")
        # Ensure request was made (function didn't crash)
        assert mock_post.called

        # Test case 2: empty string audio_path
        message = {
            "name": "test_agent",
            "content": "test message",
            "audio_path": "",
        }
        log_studio(message, "test_uid")
        assert mock_post.call_count == 2

        # Test case 3: empty string video_path
        message = {
            "name": "test_agent",
            "content": "test message",
            "video_path": "",
        }
        log_studio(message, "test_uid")
        assert mock_post.call_count == 3

        # Test case 4: None values (should be treated as missing)
        message = {
            "name": "test_agent",
            "content": "test message",
            "url": None,
            "audio_path": None,
            "video_path": None,
        }
        log_studio(message, "test_uid")
        assert mock_post.call_count == 4

        # Test case 5: missing keys entirely
        message = {
            "name": "test_agent",
            "content": "test message",
        }
        log_studio(message, "test_uid")
        assert mock_post.call_count == 5


def test_log_studio_with_string_url_converted_to_list():
    """Test that a single string url/audio_path/video_path is converted to list."""
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        # Single string url
        message = {
            "name": "test_agent",
            "content": "test",
            "url": "http://example.com/image.jpg",
        }
        log_studio(message, "test_uid")
        assert mock_post.called
        # Verify the request body contains the img tag
        call_args = mock_post.call_args
        body = json.loads(call_args[1]["data"])
        assert "<img src=\"http://example.com/image.jpg\"/>" in body["msg"]

        # Single string audio_path
        message = {
            "name": "test_agent",
            "content": "test",
            "audio_path": "/path/to/audio.mp3",
        }
        log_studio(message, "test_uid")
        call_args = mock_post.call_args
        body = json.loads(call_args[1]["data"])
        assert "<audio src=\"/path/to/audio.mp3\"" in body["msg"]

        # Single string video_path
        message = {
            "name": "test_agent",
            "content": "test",
            "video_path": "/path/to/video.mp4",
        }
        log_studio(message, "test_uid")
        call_args = mock_post.call_args
        body = json.loads(call_args[1]["data"])
        assert "<video src=\"/path/to/video.mp4\"" in body["msg"]


def test_log_studio_with_list_url_audio_video():
    """Test that list url/audio_path/video_path works as before."""
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        # List url
        message = {
            "name": "test_agent",
            "content": "test",
            "url": ["http://example.com/1.jpg", "http://example.com/2.jpg"],
        }
        log_studio(message, "test_uid")
        assert mock_post.called
        call_args = mock_post.call_args
        body = json.loads(call_args[1]["data"])
        assert "<img src=\"http://example.com/1.jpg\"/>" in body["msg"]
        assert "<img src=\"http://example.com/2.jpg\"/>" in body["msg"]

        # List audio_path
        message = {
            "name": "test_agent",
            "content": "test",
            "audio_path": ["/audio1.mp3", "/audio2.mp3"],
        }
        log_studio(message, "test_uid")
        call_args = mock_post.call_args
        body = json.loads(call_args[1]["data"])
        assert "<audio src=\"/audio1.mp3\"" in body["msg"]
        assert "<audio src=\"/audio2.mp3\"" in body["msg"]

        # List video_path
        message = {
            "name": "test_agent",
            "content": "test",
            "video_path": ["/video1.mp4", "/video2.mp4"],
        }
        log_studio(message, "test_uid")
        call_args = mock_post.call_args
        body = json.loads(call_args[1]["data"])
        assert "<video src=\"/video1.mp4\"" in body["msg"]
        assert "<video src=\"/video2.mp4\"" in body["msg"]


def test_log_studio_flushing_flag():
    """Test that flushing flag is set correctly based on presence of media."""
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        # No media -> flushing should be True
        message = {"name": "test_agent", "content": "test"}
        log_studio(message, "test_uid")
        assert mock_post.called
        call_args = mock_post.call_args
        body = json.loads(call_args[1]["data"])
        # No media tags should be added
        assert "<img" not in body["msg"]
        assert "<audio" not in body["msg"]
        assert "<video" not in body["msg"]

        # With media -> flushing should be False
        message = {
            "name": "test_agent",
            "content": "test",
            "url": "http://example.com/image.jpg",
        }
        log_studio(message, "test_uid")
        call_args = mock_post.call_args
        body = json.loads(call_args[1]["data"])
        assert "<img" in body["msg"]


