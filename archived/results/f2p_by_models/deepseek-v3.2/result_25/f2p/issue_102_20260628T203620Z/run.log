[32mimport os
import sys
import tempfile
import shutil
from unittest.mock import patch, MagicMock
import pytest
from agentscope.utils.logging_utils import log_studio


def test_log_studio_with_empty_url_audio_video():
    """Test that empty url/audio_path/video_path are handled correctly."""
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        # Create a temporary directory for the run
        with tempfile.TemporaryDirectory() as tmpdir:
            original_cwd = os.getcwd()
            os.chdir(tmpdir)
            try:
                # Ensure runs directory exists
                os.makedirs("./runs", exist_ok=True)
                # Test with empty string url
                message = {
                    "name": "test",
                    "content": "test content",
                    "url": "",
                    "audio_path": "",
                    "video_path": "",
                }
                log_studio(message, "test_uid")
                # Should not crash; flushing should be True because url is empty
                # Verify request was made
                assert mock_post.called
                call_args = mock_post.call_args
                assert call_args is not None
                # The payload should contain the content without media tags
                payload = call_args.kwargs.get("json", {})
                assert "test content" in payload.get("msg", "")
                # Ensure no img/audio/video tags are added
                assert "<img" not in payload.get("msg", "")
                assert "<audio" not in payload.get("msg", "")
                assert "<video" not in payload.get("msg", "")
            finally:
                os.chdir(original_cwd)


def test_log_studio_with_string_url_converted_to_list():
    """Test that a single string url is converted to a list."""
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        with tempfile.TemporaryDirectory() as tmpdir:
            original_cwd = os.getcwd()
            os.chdir(tmpdir)
            try:
                os.makedirs("./runs", exist_ok=True)
                message = {
                    "name": "test",
                    "content": "test",
                    "url": "http://example.com/image.jpg",
                    "audio_path": "/tmp/audio.mp3",
                    "video_path": "/tmp/video.mp4",
                }
                log_studio(message, "test_uid")
                assert mock_post.called
                call_args = mock_post.call_args
                payload = call_args.kwargs.get("json", {})
                msg = payload.get("msg", "")
                # Should have exactly one img tag, one audio tag, one video tag
                assert msg.count("<img") == 1
                assert msg.count("<audio") == 1
                assert msg.count("<video") == 1
            finally:
                os.chdir(original_cwd)


