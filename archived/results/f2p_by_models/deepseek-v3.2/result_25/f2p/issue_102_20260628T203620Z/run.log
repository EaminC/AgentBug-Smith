[32mimport json
import os
import sys
import tempfile
from unittest.mock import patch, MagicMock
import pytest

# Import the module under test
from agentscope.utils.logging_utils import log_studio


def test_log_studio_with_empty_url_audio_video():
    """Test that log_studio handles empty/None url, audio_path, video_path correctly.
    
    In buggy version, if url/audio_path/video_path is empty string or None,
    the condition `if "url" in message:` still passes, causing flushing=False
    and potential errors when iterating over non-list values.
    
    After fix, empty strings/None should be skipped, and flushing should remain True.
    """
    # Mock the internal HTTP client to avoid real network calls
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        # Test case 1: empty string url
        message = {
            "content": "test message",
            "url": "",
        }
        log_studio(message, "test_uid")
        # Should not add img tags, flushing should be True (no media)
        # The buggy version would set flushing=False and try to iterate over empty string
        # We just verify no exception is raised and the call succeeded
        assert mock_post.called
        # Check that the request body does not contain img tags
        call_args = mock_post.call_args
        body = json.loads(call_args[1]["data"])
        assert "test message" in body["msg"]
        assert "<img" not in body["msg"]

        mock_post.reset_mock()

        # Test case 2: None url
        message = {
            "content": "test message",
            "url": None,
        }
        log_studio(message, "test_uid")
        assert mock_post.called
        body = json.loads(mock_post.call_args[1]["data"])
        assert "<img" not in body["msg"]

        mock_post.reset_mock()

        # Test case 3: empty string audio_path
        message = {
            "content": "test message",
            "audio_path": "",
        }
        log_studio(message, "test_uid")
        assert mock_post.called
        body = json.loads(mock_post.call_args[1]["data"])
        assert "<audio" not in body["msg"]

        mock_post.reset_mock()

        # Test case 4: None audio_path
        message = {
            "content": "test message",
            "audio_path": None,
        }
        log_studio(message, "test_uid")
        assert mock_post.called
        body = json.loads(mock_post.call_args[1]["data"])
        assert "<audio" not in body["msg"]

        mock_post.reset_mock()

        # Test case 5: empty string video_path
        message = {
            "content": "test message",
            "video_path": "",
        }
        log_studio(message, "test_uid")
        assert mock_post.called
        body = json.loads(mock_post.call_args[1]["data"])
        assert "<video" not in body["msg"]

        mock_post.reset_mock()

        # Test case 6: None video_path
        message = {
            "content": "test message",
            "video_path": None,
        }
        log_studio(message, "test_uid")
        assert mock_post.called
        body = json.loads(mock_post.call_args[1]["data"])
        assert "<video" not in body["msg"]


def test_log_studio_with_string_url_converted_to_list():
    """Test that a single string url/audio_path/video_path is converted to list."""
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        # Single string url
        message = {
            "content": "test",
            "url": "http://example.com/image.jpg",
        }
        log_studio(message, "test_uid")
        assert mock_post.called
        body = json.loads(mock_post.call_args[1]["data"])
        # Should contain one img tag
        assert body["msg"].count("<img") == 1
        assert "image.jpg" in body["msg"]

        mock_post.reset_mock()

        # Single string audio_path
        message = {
            "content": "test",
            "audio_path": "/path/to/audio.mp3",
        }
        log_studio(message, "test_uid")
        assert mock_post.called
        body = json.loads(mock_post.call_args[1]["data"])
        assert body["msg"].count("<audio") == 1
        assert "audio.mp3" in body["msg"]

        mock_post.reset_mock()

        # Single string video_path
        message = {
            "content": "test",
            "video_path": "/path/to/video.mp4",
        }
        log_studio(message, "test_uid")
        assert mock_post.called
        body = json.loads(mock_post.call_args[1]["data"])
        assert body["msg"].count("<video") == 1
        assert "video.mp4" in body["msg"]


def test_log_studio_with_list_url_audio_video():
    """Test that list url/audio_path/video_path works as before."""
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

