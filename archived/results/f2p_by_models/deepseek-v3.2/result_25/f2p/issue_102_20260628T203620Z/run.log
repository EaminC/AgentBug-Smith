def test_log_studio_flushing_flag():
    """Test that flushing flag is set correctly for various inputs."""
    mock_response = MagicMock()
    mock_response.status_code = 200
    mock_response.json.return_value = {"code": 0, "msg": "ok"}

    with patch("requests.post", return_value=mock_response) as mock_post:
        with tempfile.TemporaryDirectory() as tmpdir:
            original_cwd = os.getcwd()
            os.chdir(tmpdir)
            try:
                os.makedirs("./runs", exist_ok=True)
                # Case 1: no media -> flushing should be True
                message = {"name": "test", "content": "test"}
                log_studio(message, "test_uid")
                # We can't directly assert flushing, but we can verify the request
                # was made without any media tags.
                assert mock_post.called
                mock_post.reset_mock()

                # Case 2: non-empty string url -> flushing should be False
                message = {
                    "name": "test",
                    "content": "test",
                    "url": "http://example.com/image.jpg",
                }
                log_studio(message, "test_uid")
                assert mock_post.called
                call_args = mock_post.call_args
                payload = call_args[1]["json"]
                assert "<img" in payload["msg"]
                mock_post.reset_mock()

                # Case 3: empty string url -> flushing should be True (treated as absent)
                message = {"name": "test", "content": "test", "url": ""}
                log_studio(message, "test_uid")
                assert mock_post.called
                call_args = mock_post.call_args
                payload = call_args[1]["json"]
                assert "<img" not in payload["msg"]
            finally:
                os.chdir(original_cwd)


