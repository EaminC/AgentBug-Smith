+   "id": "b0f3c851",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "import time\n",
+    "from loguru import logger\n",
+    "\n",
+    "msg = user_agent()\n",
+    "while not msg.content.endswith(\"exit\"):\n",
+    "    msg = assistant_agent(msg)\n",
+    "    logger.chat(msg.update_value())\n",
+    "    time.sleep(0.5)\n",
+    "    msg = user_agent(msg)"
+   ]
+  }
