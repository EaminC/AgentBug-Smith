[32mimport pytest
from unittest.mock import patch, MagicMock
import json
from agentscope.agents.rpc_agent import RpcAgent
from agentscope.rpc.rpc_agent_client import RpcAgentClient
from agentscope.rpc.rpc_agent_server import RpcAgentServerLauncher
from agentscope.message import Msg


def test_rpc_agent_observe_without_client_initialization():
    """
    Test that RpcAgent.observe() launches the server and creates a client
    if self.client is None, as per the fix in the patch.
    """
    # Create a minimal RpcAgent instance with mocked dependencies
    # We'll use a subclass to avoid needing actual model configs
    class TestRpcAgent(RpcAgent):
        def __init__(self):
            self.name = "test_agent"
            self.host = "localhost"
            self.port = 9999
            self.model_config_name = None
            self.sys_prompt = None
            self.memory = None
            self.max_retries = 3
            self.retry_interval = 1
            self.client = None
            self.server_launcher = MagicMock(spec=RpcAgentServerLauncher)
            self._is_running = False

    agent = TestRpcAgent()
    # Ensure client is None as per the bug scenario
    assert agent.client is None

    # Mock the server_launcher.launch() method
    agent.server_launcher.launch.return_value = None

    # Mock RpcAgentClient constructor and its call_func method
    mock_client_instance = MagicMock(spec=RpcAgentClient)
    mock_client_instance.call_func.return_value = None

    with patch('agentscope.agents.rpc_agent.RpcAgentClient', return_value=mock_client_instance) as mock_client_class:
        # Call observe with a simple message
        test_msg = Msg(name="user", content="hello")
        agent.observe(test_msg)

        # Verify that server_launcher.launch() was called
        agent.server_launcher.launch.assert_called_once()

        # Verify that RpcAgentClient was instantiated with correct host/port
        mock_client_class.assert_called_once_with(host="localhost", port=9999)

        # Verify that client.call_func was called with appropriate arguments
        mock_client_instance.call_func.assert_called_once()
        call_args = mock_client_instance.call_func.call_args
        assert call_args[0][0] == "_observe"  # func_name
        # The value should be serialized message; we can check it's not empty
        serialized_value = call_args[1]['value']
        assert serialized_value is not None

        # Verify that agent.client is now set
        assert agent.client is mock_client_instance


def test_rpc_agent_observe_with_existing_client():
    """
    Test that if client already exists, observe uses it without launching server.
    """
    class TestRpcAgent(RpcAgent):
        def __init__(self):
            self.name = "test_agent"
            self.host = "localhost"
            self.port = 9999
            self.model_config_name = None
            self.sys_prompt = None
            self.memory = None
            self.max_retries = 3
            self.retry_interval = 1
            self.client = MagicMock(spec=RpcAgentClient)
            self.server_launcher = MagicMock(spec=RpcAgentServerLauncher)
            self._is_running = False

    agent = TestRpcAgent()
    assert agent.client is not None

    # Mock the call_func method
    agent.client.call_func.return_value = None

    test_msg = Msg(name="user", content="hello")
    agent.observe(test_msg)

    # Server launcher should NOT be called
    agent.server_launcher.launch.assert_not_called()

    # Client's call_func should be called
    agent.client.call_func.assert_called_once()
    call_args = agent.client.call_func.call_args
    assert call_args[0][0] == "_observe"


def test_rpc_agent_observe_with_sequence():
    """
    Test observe with a sequence of messages.
    """
    class TestRpcAgent(RpcAgent):
        def __init__(self):
            self.name = "test_agent"
            self.host = "localhost"
            self.port = 9999
            self.model_config_name = None
            self.sys_prompt = None
            self.memory = None
            self.max_retries = 3
            self.retry_interval = 1
            self.client = None
            self.server_launcher = MagicMock(spec=RpcAgentServerLauncher)
            self._is_running = False

    agent = TestRpcAgent()
    agent.server_launcher.launch.return_value = None

    mock_client_instance = MagicMock(spec=RpcAgentClient)
    mock_client_instance.call_func.return_value = None

    with patch('agentscope.agents.rpc_agent.RpcAgentClient', return_value=mock_client_instance):
        # Create a list of messages
        msgs = [
            Msg(name="user", content="msg1"),
            Msg(name="assistant", content="msg2"),
        ]
        agent.observe(msgs)

        agent.server_launcher.launch.assert_called_once()
        mock_client_instance.call_func.assert_called_once()
        # The serialized value should be a sequence
        call_args = mock_client_instance.call_func.call_args
        assert call_args[0][0] == "_observe"


def test_rpc_agent_observe_handles_serialization():
    """
