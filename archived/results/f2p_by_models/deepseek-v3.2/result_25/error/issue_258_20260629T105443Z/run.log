[32mimport pytest
from unittest.mock import MagicMock, patch
from agentscope.models.openai_model import OpenAIChatWrapper
from agentscope.models.model import ModelResponse


def test_zhipu_prompt_parameter_error_handling():
    """
    Test that when calling a Zhipu model via one-api proxy with an invalid prompt,
    the error is properly raised and not hidden by AttributeError.
    """
    # Mock the OpenAI client to simulate a Zhipu error response
    mock_client = MagicMock()
    mock_chat = MagicMock()
    mock_completion = MagicMock()
    mock_completion.choices = [MagicMock()]
    mock_completion.choices[0].message = MagicMock()
    mock_completion.choices[0].message.content = None
    mock_completion.usage = None  # This will cause AttributeError in buggy code
    mock_chat.completions.create.return_value = mock_completion
    mock_client.chat = mock_chat
    mock_client.models = MagicMock()

    with patch('agentscope.models.openai_model.openai') as mock_openai:
        mock_openai.OpenAI.return_value = mock_client
        # Create a model config that mimics a Zhipu model via one-api
        model = OpenAIChatWrapper(
            model_name="glm-4",
            api_key="fake-key",
            organization="fake-org",
        )
        # Replace the internal client with our mock
        model._client = mock_client
        # Call the model with a prompt that would cause error
        with pytest.raises(Exception) as exc_info:
            model("invalid prompt")
        # Ensure the error is not AttributeError about NoneType.model_dump
        assert "AttributeError" not in str(exc_info.value)
        # The error should be about the prompt parameter
        assert "prompt" in str(exc_info.value).lower() or "zhipu" in str(exc_info.value).lower()


def test_openai_model_handles_none_usage():
    """
    Test that OpenAIChatWrapper.__call__ does not crash when response.usage is None.
    """
    mock_client = MagicMock()
    mock_chat = MagicMock()
    mock_completion = MagicMock()
    mock_completion.choices = [MagicMock()]
    mock_completion.choices[0].message = MagicMock()
    mock_completion.choices[0].message.content = "Test response"
    mock_completion.usage = None  # Simulate missing usage field
    mock_chat.completions.create.return_value = mock_completion
    mock_client.chat = mock_chat
    mock_client.models = MagicMock()

    with patch('agentscope.models.openai_model.openai') as mock_openai:
        mock_openai.OpenAI.return_value = mock_client
        model = OpenAIChatWrapper(
            model_name="gpt-3.5-turbo",
            api_key="fake-key",
            organization="fake-org",
        )
        model._client = mock_client
        # This should not raise AttributeError
        response = model("Hello")
        assert isinstance(response, ModelResponse)
        assert response.text == "Test response"
        # Usage should be handled gracefully (maybe default to empty dict)
        assert response.usage is None or isinstance(response.usage, dict)[0m
