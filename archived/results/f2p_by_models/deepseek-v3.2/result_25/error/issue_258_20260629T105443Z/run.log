WORKDIR /app

# Install system dependencies if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and wheel
RUN python -m pip install --upgrade pip wheel

# Copy entire repository
COPY . .

# Install the project and required dependencies
# Evidence: setup.py defines install_requires and extras_require; README mentions pip install -e .
# We also need pytest and other test dependencies.
RUN pip install -e .[full] && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai

# Preflight check to ensure core modules can be imported
RUN python -c "import agentscope, pytest; print('preflight ok')"

