def test_zhipu_prompt_parameter_error_handling():
    """
    Test that when the OpenAI client receives a "prompt 参数非法" error from
    a Zhipu backend (via one‑api), the error is properly surfaced and does not
    cause an AttributeError on response.usage.model_dump().
    """
    # Simulate the exact error from the issue: a Zhipu error response
    # that returns a valid OpenAI‑like response object but with a 'zhipu_error'
    # and a 'None' usage field.
    mock_response = MagicMock()
    mock_response.choices = [MagicMock()]
    mock_response.choices[0].message = MagicMock()
    mock_response.choices[0].message.content = None
    mock_response.usage = None
    mock_response._hidden_fields = {"error": {"code": 1214, "message": "prompt 参数非法。请检查文档。", "type": "zhipu_error"}}

    # Create a mock client that returns this response
    mock_client = MagicMock()
    mock_client.chat.completions.create.return_value = mock_response

    # Build a model config that would trigger the buggy path
    config = {
        "model": "glm-4",
        "api_key": "fake-key",
        "base_url": "https://one-api.example.com/v1",
    }

    # Instantiate the wrapper (the real class, not a mock)
    model = OpenAIChatWrapper(**config)

    # Replace the internal client with our mock
    with patch.object(model, "_client", mock_client):
        # The buggy code would call `self.update_monitor(call_counter=1, **response.usage.model_dump())`
        # which raises AttributeError because response.usage is None.
        # After the fix, the wrapper should detect the error and raise an appropriate exception.
        with pytest.raises(Exception) as exc_info:
            model(messages=[{"role": "user", "content": "test"}])

        # Ensure the error message is surfaced (not swallowed)
        assert "prompt 参数非法" in str(exc_info.value) or "zhipu_error" in str(exc_info.value)


