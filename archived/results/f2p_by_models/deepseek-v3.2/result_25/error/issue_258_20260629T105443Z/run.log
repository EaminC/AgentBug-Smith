    assert agent.client is None
    
    # This should trigger the bug: AttributeError because client is None
    # In fixed version, it should launch server and set client.
    try:
        agent.observe(Msg(name="user", content="hello"))
        # If we reach here, bug is fixed (no exception).
        # Verify client is now set.
        assert agent.client is not None
        # Cleanup
        agent.server_launcher.shutdown()
    except AttributeError as e:
        if "'NoneType' object has no attribute 'call_func'" in str(e):
            # Buggy version: client is None, causing AttributeError
            raise AssertionError("Bug reproduced: client is None in observe()")
        else:
            raise


