[32mimport os
import sys
import json
from unittest.mock import patch, MagicMock

import pytest
from agentscope.models import ModelWrapper
from agentscope.models.openai_model import OpenAIChatWrapper


def test_zhipu_prompt_parameter_error_handling():
    """
    Test that when calling ZhiPu GLM-4 via one-api proxy with an invalid prompt,
    the error is properly caught and raised with a clear message,
    and that the usage update does not crash when response.usage is None.
    """
    # Simulate the scenario where the openai client returns a response
    # with an error from ZhiPu API (via one-api).
    # The buggy code would call `response.usage.model_dump()` when usage is None,
    # causing AttributeError.
    # The fix ensures that if usage is None, we don't try to call model_dump.

    # Create a mock openai client that returns a response with an error
    mock_response = MagicMock()
    mock_response.choices = [MagicMock()]
    mock_response.choices[0].message.content = None
    # Simulate the error structure from ZhiPu
    mock_response.usage = None
    mock_response._headers = {"x-request-id": "20240525111717334814010jvX7fM7r"}

    # The actual error from ZhiPu is inside the response body, but the openai
    # client raises an OpenAIError with the error body.
    from openai import OpenAIError

    error_body = {
        "code": 1214,
        "message": "prompt 参数非法。请检查文档。 (request id: 20240525111717334814010jvX7fM7r)",
        "param": "",
        "type": "zhipu_error",
    }

    # In the buggy version, the model wrapper calls `self.update_monitor`
    # with `response.usage.model_dump()`. Since usage is None, it crashes.
    # We need to mock the openai client's chat.completions.create to raise
    # an error that includes the ZhiPu error, and also returns a response
    # with usage=None (or missing usage). The bug is that the code assumes
    # usage is always present.

    # First, create a real OpenAIChatWrapper instance with a dummy config.
    config = {
        "config_name": "glm-4",
        "model_name": "glm-4",
        "api_key": "dummy_key",
        "organization_id": "dummy_org",
        "generate_args": {"temperature": 0.0},
    }
    model = OpenAIChatWrapper(**config)

    # Mock the underlying openai client's chat.completions.create.
    # The bug is inside OpenAIChatWrapper.__call__ which calls
    # self.update_monitor(call_counter=1, **response.usage.model_dump())
    # when response.usage is None.
    with patch.object(model.client.chat.completions, "create") as mock_create:
        # Simulate the error raised by openai client when ZhiPu returns error.
        # The openai client raises OpenAIError with the error body.
        mock_create.side_effect = OpenAIError(
            message=json.dumps(error_body),
            request=None,
            body=error_body,
        )

        # The buggy code will catch the OpenAIError and try to extract error info.
        # It then raises a ModelResponseError with the error message.
        # However, before raising, it still attempts to update monitor with
        # response.usage.model_dump()? Wait, look at the traceback:
        #   File ".../openai_model.py", line 210, in __call__
        #     self.update_monitor(call_counter=1, **response.usage.model_dump())
        # AttributeError: 'NoneType' object has no attribute 'model_dump'
        # This line is executed AFTER the error is caught? Actually no.
        # The traceback shows the error occurs inside __call__ before any exception
        # handling. So the bug is that when the API call returns a response
        # (maybe a 200 with error inside?), the response.usage is None.
        # Let's simulate a response that is not an exception but has usage=None.
        # However, the issue says the error is:
        # {'code': 1214, 'message': 'prompt 参数非法。请检查文档。 (request id: ...)', ...}
        # This is likely returned as a 200 with error in body (some proxies do that).
        # The openai client may still treat it as a successful response but with
        # error details in the response body.
        # We'll mock the response to have usage=None and also have an error field.
        # But the openai client's response object does not have an error field.
        # The bug is that the wrapper doesn't check for usage existence before
        # calling model_dump.

        # Let's change the mock to return a response with usage=None.
        # The buggy code will crash with AttributeError.
        # The fixed code should handle usage=None gracefully.
        mock_create.side_effect = None
        mock_create.return_value = mock_response

        # Now call the model with a prompt that would cause the error.
        # The wrapper will try to parse the response and update monitor.
        # In the buggy version, this will raise AttributeError.
        # In the fixed version, it should either raise a ModelResponseError
        # with the error message, or at least not crash with AttributeError.
        # According to the issue, the error message should be surfaced.
        # We'll assert that the error is raised with the ZhiPu error message.
        from agentscope.exception import ModelResponseError

        with pytest.raises(ModelResponseError) as exc_info:
            model("invalid prompt that causes ZhiPu error")

        # Check that the error message contains the ZhiPu error.
        assert "prompt 参数非法" in str(exc_info.value)
        # Also ensure that the AttributeError about 'model_dump' does not occur.
        # That is, the exception should be ModelResponseError, not AttributeError.

def test_zhipu_error_without_usage_does_not_crash():
    """
    Direct test that when response.usage is None, update_monitor does not crash.
    """
    config = {
        "config_name": "glm-4",
        "model_name": "glm-4",
        "api_key": "dummy_key",
        "organization_id": "dummy_org",
        "generate_args": {"temperature": 0.0},
    }
    model = OpenAIChatWrapper(**config)

    # Mock the response with usage=None
    mock_response = MagicMock()
    mock_response.choices = [MagicMock()]
    mock_response.choices[0].message.content = "dummy response"
    mock_response.usage = None

    with patch.object(model.client.chat.completions, "create") as mock_create:
        mock_create.return_value = mock_response

        # This should not raise AttributeError in fixed code.
        # In buggy code, it will raise AttributeError: 'NoneType' object has no attribute 'model_dump'
        try:
            result = model("test")
            # If it succeeds, the result should be a ModelResponse
            assert result.text == "dummy response"
        except AttributeError as e:
            if "'NoneType' object has no attribute 'model_dump'" in str(e):
                # This is the bug we expect in buggy version.
                # We'll let the test fail in buggy version, pass in fixed version.
                raise e

def test_zhipu_error_message_propagated():
    """
    Test that when ZhiPu returns an error via one-api, the error message is
    properly propagated to the user.
    """
    config = {
        "config_name": "glm-4",
        "model_name": "glm-4",
        "api_key": "dummy_key",
        "organization_id": "dummy_org",
        "generate_args": {"temperature": 0.0},
    }
    model = OpenAIChatWrapper(**config)

    from openai import OpenAIError
    error_body = {
        "code": 1214,
        "message": "prompt 参数非法。请检查文档。 (request id: 20240525111717334814010jvX7fM7r)",
        "param": "",
        "type": "zhipu_error",
    }

    with patch.object(model.client.chat.completions, "create") as mock_create:
        mock_create.side_effect = OpenAIError(
            message=json.dumps(error_body),
            request=None,
            body=error_body,
        )

        from agentscope.exception import ModelResponseError
        with pytest.raises(ModelResponseError) as exc_info:
            model("invalid prompt")

        # Ensure the error message contains the original ZhiPu error.
        assert "prompt 参数非法" in str(exc_info.value)
        # Also ensure the error includes the request id for debugging.
        assert "20240525111717334814010jvX7fM7r" in str(exc_info.value)[0m
