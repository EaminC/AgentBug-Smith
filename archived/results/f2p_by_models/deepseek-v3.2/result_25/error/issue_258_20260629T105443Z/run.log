+    "from agentscope.agents.user_agent import UserAgent\n",
+    "from agentscope.agents.rpc_dialog_agent import RpcDialogAgent\n",
+    "\n",
+    "agentscope.init(\n",
+    "    model_configs=model_configs\n",
+    ")\n",
+    "\n",
+    "assistant_agent = RpcDialogAgent(\n",
+    "    name=\"Assistant\",\n",
