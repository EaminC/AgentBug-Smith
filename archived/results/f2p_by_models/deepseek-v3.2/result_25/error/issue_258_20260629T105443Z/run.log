from agentscope.agents.dialog_agent import DialogAgent
from agentscope.message import Msg


def test_zhipu_error_handling_with_none_usage():
    """
    Test that when the OpenAI client returns an error response with a 'zhipu_error'
    type and a 'prompt 参数非法' message, the error is properly raised and not
    swallowed, and the AttributeError about 'NoneType' object having no attribute
    'model_dump' does not occur.
    """
    # Simulate the exact error from the issue: a response with error structure
    # that the buggy code mishandles.
    error_response = MagicMock()
    error_response.choices = []
    error_response.usage = None  # This causes the AttributeError in buggy code
    error_response.error = {
        "code": 1214,
        "message": "prompt 参数非法。请检查文档。 (request id: 20240525111717334814010jvX7fM7r)",
        "param": "",
        "type": "zhipu_error",
    }

    # Mock the internal OpenAI client's chat.completions.create method.
    # The bug is in OpenAIChatWrapper.__call__ which calls self.update_monitor
    # with response.usage.model_dump() when response.usage is None.
    # We need to mock the actual client call inside the wrapper.
    with patch.object(
        OpenAIChatWrapper,
        "_client",
        new_callable=MagicMock,
    ) as mock_client:
        mock_chat = MagicMock()
        mock_chat.completions.create = MagicMock(return_value=error_response)
        mock_client.return_value = mock_chat

        # Create a wrapper instance with minimal config
        wrapper = OpenAIChatWrapper(
            config_name="test",
            model_name="glm-4",
            api_key="dummy",
            organization=None,
            generate_args={},
        )

        # The call should raise an exception because the response has an error.
        # In the buggy code, it will first try to call response.usage.model_dump()
        # which raises AttributeError because usage is None.
        # After the fix, it should handle the error properly.
        with pytest.raises(Exception) as exc_info:
            wrapper(messages=[{"role": "user", "content": "test"}])

        # Ensure the error is not the AttributeError about model_dump
        assert "model_dump" not in str(exc_info.value)
        # The error should be about the zhipu error
        assert "prompt 参数非法" in str(exc_info.value) or "zhipu_error" in str(exc_info.value)


