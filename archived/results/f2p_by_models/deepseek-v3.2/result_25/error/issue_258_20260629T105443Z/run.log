def test_openai_model_handles_zhipu_error_without_usage():
    """Test that OpenAIChatWrapper correctly handles a response without usage field.

    In the buggy version, when the API returns an error (like Zhipu's prompt error),
    the response.usage may be None, causing AttributeError when calling model_dump().
    After the fix, the code should handle None usage gracefully.
