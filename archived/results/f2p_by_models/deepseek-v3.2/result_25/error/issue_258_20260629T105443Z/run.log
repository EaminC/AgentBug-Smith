+    "    {\n",
+    "        \"type\": \"openai\",\n",
+    "        \"name\": \"gpt-4\",\n",
+    "        \"parameters\": {\n",
+    "            \"api_key\": \"xxx\",\n",
+    "            \"organization_id\": \"xxx\",\n",
+    "            \"temperature\": 0.0\n",
+    "        }\n",
+    "    }\n",
+    "]"
+   ]
