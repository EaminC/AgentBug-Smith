[32mimport pytest
import json
from unittest.mock import patch, MagicMock
from agentscope.agents.rpc_agent import RpcAgent
from agentscope.rpc.rpc_agent_client import RpcAgentClient
from agentscope.rpc.rpc_agent_server import RpcAgentServerLauncher
from agentscope.message import Msg


def test_rpc_agent_observe_without_client_initialization():
    """
    Test that RpcAgent.observe() works correctly when self.client is None.
    
    In the buggy version, calling observe() when client is None would cause
    an AttributeError because self.client.call_func would be called on None.
    
    The fix adds a check: if self.client is None, it launches the server
    and creates the client before calling observe.
    
    This test should fail on buggy code (AttributeError) and pass after fix.
    """
    # Create an RpcAgent instance with minimal configuration
    agent = RpcAgent(
        name="test_agent",
        host="localhost",
        port=9999,
        model_configs=None,
        sys_prompt="Test",
        use_memory=False,
    )
    
    # Simulate the state where client is None (not yet initialized)
    agent.client = None
    
    # Mock the server launcher to avoid actually launching a server
    mock_launcher = MagicMock(spec=RpcAgentServerLauncher)
    agent.server_launcher = mock_launcher
    
    # Mock the RpcAgentClient to avoid actual RPC calls
    mock_client = MagicMock(spec=RpcAgentClient)
    
    # Use patch to replace RpcAgentClient instantiation
    with patch('agentscope.agents.rpc_agent.RpcAgentClient', return_value=mock_client):
        # Create a test message
        test_msg = Msg(name="user", content="Hello")
        
        # Call observe - this should work after fix, fail before fix
        agent.observe(test_msg)
        
        # Verify that server was launched and client was created
        mock_launcher.launch.assert_called_once()
        
        # Verify client.call_func was called with correct arguments
        mock_client.call_func.assert_called_once()
        call_args = mock_client.call_func.call_args
        assert call_args[1]['func_name'] == '_observe'
        # The value should be serialized message
        assert 'value' in call_args[1][0m
