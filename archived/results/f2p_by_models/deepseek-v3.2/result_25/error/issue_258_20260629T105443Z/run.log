from agentscope.models.openai_model import OpenAIChatWrapper
from agentscope.agents.dialog_agent import DialogAgent
from agentscope.message import Msg


def test_openai_model_handles_zhipu_error_without_usage():
    """
    Test that when the OpenAI client (used for Zhipu via one-api) returns a response
    with no usage field, the model wrapper does not crash with AttributeError.
    The bug was that response.usage could be None, causing .model_dump() to fail.
    After the fix, the code should handle None usage gracefully.
    """
    # Mock the OpenAI client's chat.completions.create to return a response
    # that mimics the Zhipu error: response has choices but usage is None.
