        # Simulate the error response from Zhipu
        mock_call.side_effect = Exception(
            "{'code': 1214, 'message': 'prompt 参数非法。请检查文档。', "
            "'param': '', 'type': 'zhipu_error'}"
        )

        # Create a model config that would use the OpenAI wrapper
        model_config = {
            "type": "openai",
            "name": "glm-4",
            "parameters": {
                "api_key": "dummy_key",
                "model": "glm-4",
                "api_type": "openai",
                "base_url": "http://one-api-proxy/v1",
            }
        }

        # Instantiate the wrapper directly (instead of through init)
        wrapper = OpenAIChatWrapper(
            config_name="glm-4",
            model_name="glm-4",
            **model_config["parameters"]
        )

        # The buggy code would raise AttributeError when trying to update_monitor
        # with response.usage.model_dump() because usage is None.
        # We expect the exception from the mock to be raised (the Zhipu error).
        with pytest.raises(Exception) as exc_info:
            wrapper({"messages": [{"role": "user", "content": "test"}]})

        # Ensure the error message contains the Zhipu error
        assert "prompt 参数非法" in str(exc_info.value)


def test_dialog_agent_with_zhipu_error():
    """
    Integration test: DialogAgent using an OpenAI model config that points to
    a Zhipu backend should properly propagate the error instead of crashing
    with AttributeError.
    """
    # We need to mock the model factory to return our mocked wrapper
    # First, let's create a mock model that raises the Zhipu error
    mock_model = MagicMock()
    mock_model.side_effect = Exception(
        "{'code': 1214, 'message': 'prompt 参数非法。请检查文档。', "
        "'param': '', 'type': 'zhipu_error'}"
    )

    # Patch the model creation in DialogAgent's reply method
    with patch('agentscope.agents.dialog_agent.load_model_by_config_name') as load_model_mock:
        load_model_mock.return_value = mock_model

        # Create a DialogAgent with a config name that would use OpenAI wrapper
        agent = DialogAgent(
            name="assistant",
            sys_prompt="You are an assistant.",
            model_config_name="glm-4"
        )

        # The agent should raise an exception when called
        msg = Msg(name="user", content="Introduce yourself")
        with pytest.raises(Exception) as exc_info:
            agent(msg)

        # The error should be the Zhipu error, not AttributeError
        assert "AttributeError" not in str(exc_info.type)
        # The error message should contain the Zhipu error
        # (the mock raises a generic Exception with the error string)
        assert "prompt 参数非法" in str(exc_info.value)


def test_openai_wrapper_handles_none_usage():
    """
    Direct test of the bug: OpenAIChatWrapper.__call__ should handle
    response.usage being None gracefully.
    """
    # Create a real wrapper instance
    wrapper = OpenAIChatWrapper(
        config_name="test",
        model_name="glm-4",
        api_key="dummy",
        model="glm-4",
        api_type="openai",
        base_url="http://dummy"
    )

    # Mock the internal client's chat.completions.create
    mock_completion = MagicMock()
    mock_completion.choices = [MagicMock()]
    mock_completion.choices[0].message = MagicMock()
    mock_completion.choices[0].message.content = "test response"
    mock_completion.usage = None  # This triggers the bug

    with patch.object(wrapper.client.chat.completions, 'create', return_value=mock_completion):
        # The buggy code would raise AttributeError: 'NoneType' object has no attribute 'model_dump'
        # We expect it to either handle None usage or raise a different error.
        # Since we're testing the buggy state, we expect an AttributeError.
        try:
            result = wrapper({"messages": [{"role": "user", "content": "test"}]})
            # If no exception, that's okay (maybe usage is optional).
            # But we need to ensure the bug is triggered in buggy code.
            # We'll check that the result is a ModelResponse.
            assert isinstance(result, ModelResponse)
        except AttributeError as e:
            # In buggy code, this is expected.
            assert "model_dump" in str(e)
            # This test will fail on buggy, pass on fixed.
            raise


