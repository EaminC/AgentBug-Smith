    mock_response.usage = None

    # Create a model config that uses OpenAI client but points to a Zhipu-like endpoint
    config = {
        "model_name": "glm-4",
        "api_key": "dummy_key",
        "base_url": "https://one-api.example.com/v1",
    }

    # Instantiate the wrapper
