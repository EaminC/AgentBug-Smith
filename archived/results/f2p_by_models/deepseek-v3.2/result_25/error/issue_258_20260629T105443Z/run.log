[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Install system dependencies for some Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Install dependencies and project based on evidence from setup.py and CI workflows
# README and CI show installation via pip install -e .[full] for development/testing
# setup.py defines extras: "full" includes all dependencies.
# We install the project in editable mode with full extras.
# Note: The project uses a src/ layout (src/agentscope). To avoid duplicate module loading,
# we should NOT install in editable mode if tests import via src.agentscope.
