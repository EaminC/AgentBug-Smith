def test_zhipu_prompt_parameter_error_handling():
    """
    Test that when calling a Zhipu model via one-api proxy with an invalid prompt,
    the error is properly raised and not hidden by AttributeError.
    """
    # Mock the OpenAI client to simulate a Zhipu error response
    mock_client = MagicMock()
    mock_chat = MagicMock()
    mock_completion = MagicMock()
    mock_completion.choices = [MagicMock()]
    mock_completion.choices[0].message = MagicMock()
    mock_completion.choices[0].message.content = None
    mock_completion.usage = None  # This will cause AttributeError in buggy code
    mock_chat.completions.create.return_value = mock_completion
    mock_client.chat = mock_chat
    mock_client.models = MagicMock()

    with patch('agentscope.models.openai_model.openai') as mock_openai:
        mock_openai.OpenAI.return_value = mock_client
        # Create a model config that mimics a Zhipu model via one-api
        model = OpenAIChatWrapper(
            model_name="glm-4",
            api_key="fake-key",
            organization="fake-org",
        )
        # Replace the internal client with our mock
        model._client = mock_client

        # The buggy code will crash with AttributeError when usage is None
        # We expect that the model call raises an exception (either the original error or a handled one)
        with pytest.raises(Exception) as exc_info:
            model([{"role": "user", "content": "invalid prompt"}])
        # Ensure the error is not the AttributeError about None having no attribute model_dump
        assert "model_dump" not in str(exc_info.value)


def test_openai_model_handles_none_usage():
    """
