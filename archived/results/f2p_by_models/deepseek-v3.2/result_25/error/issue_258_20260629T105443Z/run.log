[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Install system dependencies if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Check for src/ layout to decide installation strategy
# If src/ directory exists and is a package (contains __init__.py), we avoid editable install.
# Set PYTHONPATH to /app to allow imports of src modules.
RUN if [ -d src ] && [ -f src/agentscope/__init__.py ]; then \
        echo "src/ layout detected, installing dependencies only"; \
        export PYTHONPATH=/app:$PYTHONPATH; \
    else \
        echo "No src/ layout, performing editable install"; \
    fi

# Install dependencies based on available files
RUN python -m pip install --upgrade pip wheel && \
    # Install project dependencies (including extras) and project itself
    # Use editable install only if src/ layout not detected
    if [ -d src ] && [ -f src/agentscope/__init__.py ]; then \
        pip install -e .[full] && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    else \
        pip install -e .[full] && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout mem0ai; \
    fi

# Preflight import check
RUN python -c "import agentscope, pytest, pkg_resources; print('preflight ok')"

CMD ["/bin/bash"][0m
