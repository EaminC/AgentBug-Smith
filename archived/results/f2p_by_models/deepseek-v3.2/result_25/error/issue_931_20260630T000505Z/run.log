[32mimport pytest
from unittest.mock import MagicMock, patch, call
from crewai import Agent, Task, Crew
from crewai.tools import BaseTool
from pydantic import BaseModel, Field
from typing import Any


class MultiplyArgs(BaseModel):
    a: int = Field(..., description="First number")
    b: int = Field(..., description="Second number")


class MultiplyTool(BaseTool):
    name: str = "multiply"
    description: str = "Multiply two numbers"
    args_schema: type[BaseModel] = MultiplyArgs
    result_as_answer: bool = False

    def _run(self, a: int, b: int) -> str:
        return str(a * b)


def test_result_as_answer_should_not_call_llm():
    """
    When a tool has result_as_answer=True, the agent should return the tool's output
    directly without making any LLM calls.
    """
    # Create a tool with result_as_answer=True
    multiply_tool = MultiplyTool(result_as_answer=True)

    # Mock the LLM to track calls
    mock_llm = MagicMock()
    mock_llm.invoke = MagicMock()

    # Create an agent with the tool
    agent = Agent(
        role="Calculator",
        goal="Calculate multiplication",
        backstory="You are a calculator",
        tools=[multiply_tool],
        llm=mock_llm,
        verbose=True,
    )

    # Create a task that uses the tool
    task = Task(
        description="Multiply 3 and 4",
        agent=agent,
        expected_output="The product of 3 and 4",
    )

    crew = Crew(agents=[agent], tasks=[task])

    # Kickoff the crew
    with patch.object(multiply_tool, "_run", return_value="12") as mock_tool_run:
        result = crew.kickoff()

    # Verify the tool was called with correct arguments
    mock_tool_run.assert_called_once_with(a=3, b=4)

    # Verify the LLM was NOT called at all
    assert mock_llm.invoke.call_count == 0

    # Verify the result is the tool output
    assert result.raw == "12"

    # Verify usage metrics show zero successful requests
    metrics = crew.usage_metrics
    assert metrics["successful_requests"] == 0
    assert metrics["total_tokens"] == 0
    assert metrics["prompt_tokens"] == 0
    assert metrics["completion_tokens"] == 0


def test_result_as_answer_false_should_call_llm():
    """
    When result_as_answer=False (default), the agent should process the tool output
    through the LLM.
    """
    multiply_tool = MultiplyTool(result_as_answer=False)

    mock_llm = MagicMock()
    # Simulate LLM returning a final answer after tool observation
    mock_llm.invoke.return_value.content = "The product is 12"

    agent = Agent(
        role="Calculator",
        goal="Calculate multiplication",
        backstory="You are a calculator",
        tools=[multiply_tool],
        llm=mock_llm,
        verbose=True,
    )

    task = Task(
        description="Multiply 3 and 4",
        agent=agent,
        expected_output="The product of 3 and 4",
    )

    crew = Crew(agents=[agent], tasks=[task])

    with patch.object(multiply_tool, "_run", return_value="12"):
        result = crew.kickoff()

    # LLM should have been called at least once
    assert mock_llm.invoke.call_count > 0

    # Usage metrics should show successful requests
    metrics = crew.usage_metrics
    assert metrics["successful_requests"] > 0


def test_multiple_tools_with_mixed_result_as_answer():
    """
    Test scenario with multiple tools where only some have result_as_answer=True.
    """
    class AddArgs(BaseModel):
        x: int = Field(..., description="First number")
        y: int = Field(..., description="Second number")

    class AddTool(BaseTool):
        name: str = "add"
        description: str = "Add two numbers"
        args_schema: type[BaseModel] = AddArgs
        result_as_answer: bool = True

        def _run(self, x: int, y: int) -> str:
            return str(x + y)

    add_tool = AddTool(result_as_answer=True)
    multiply_tool = MultiplyTool(result_as_answer=False)

    mock_llm = MagicMock()
    # Simulate LLM choosing the add tool first (which should finish immediately)
    mock_llm.invoke.return_value.content = '{"tool_name": "add", "arguments": {"x": 5, "y": 7}}'

    agent = Agent(
        role="Math Agent",
        goal="Perform math operations",
        backstory="You are a math agent",
        tools=[add_tool, multiply_tool],
        llm=mock_llm,
        verbose=True,
    )

    task = Task(
        description="Add 5 and 7",
        agent=agent,
        expected_output="The sum of 5 and 7",
    )

    crew = Crew(agents=[agent], tasks=[task])

    with patch.object(add_tool, "_run", return_value="12") as mock_add_run:
        result = crew.kickoff()

    # Add tool should have been called
    mock_add_run.assert_called_once_with(x=5, y=7)

    # LLM should have been called exactly once (to decide which tool to use)
    assert mock_llm.invoke.call_count == 1

    # Result should be the tool output
    assert result.raw == "12"

    metrics = crew.usage_metrics
    # Only one LLM call (the tool selection)
    assert metrics["successful_requests"] == 1


