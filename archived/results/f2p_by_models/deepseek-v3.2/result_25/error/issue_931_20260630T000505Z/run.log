[32mimport json
import os
from unittest.mock import patch, MagicMock
from crewai import Agent, Task, Crew
from crewai.tools import BaseTool
from pydantic import BaseModel, Field


class MultiplyInput(BaseModel):
    a: int = Field(..., description="First integer")
    b: int = Field(..., description="Second integer")


class MultiplyTool(BaseTool):
    name: str = "multiply"
    description: str = "Multiply two integers"
    args_schema: type[BaseModel] = MultiplyInput
    result_as_answer: bool = True

    def _run(self, a: int, b: int) -> str:
        return str(a * b)


def test_tool_result_as_answer_should_not_call_llm():
    """
    When a tool has result_as_answer=True, the agent should return the tool's
    result directly without further LLM processing.
    In the buggy version, the agent still calls the LLM (successful_requests > 0).
    In the fixed version, the tool result should be the final answer and no LLM call occurs.
    """
    # Mock the LLM to capture calls and ensure they don't happen.
    # We'll mock the underlying LLM client's chat.completions.create method.
    # The buggy code will still call the LLM, causing successful_requests > 0.
    # The fixed code will skip the LLM call, so successful_requests should remain 0.
    # We'll use a mock that raises an AssertionError if the LLM is called unexpectedly.
    # But we need to allow the LLM to be called for the initial agent prompt?
    # Actually, the agent still needs to decide to use the tool, which requires an LLM call.
    # The issue is about the second LLM call after tool execution.
    # The bug: after tool execution, the agent loops again and calls LLM.
    # The fix: after tool execution with result_as_answer=True, return AgentFinish immediately.
    # Therefore, we need to allow the first LLM call (tool decision) but assert no second call.
    # We'll track call count.

    call_count = 0

    def mock_chat_completions_create(*args, **kwargs):
        nonlocal call_count
        call_count += 1
        # On first call, return a response that triggers tool usage.
        if call_count == 1:
            # Simulate LLM returning a tool call for multiply.
            # The response format should be a JSON with tool_name and tool_input.
            # The agent's parser expects a specific format.
            # We'll mimic the behavior from existing tests.
            # Use a canned response that the agent will parse as an AgentAction.
            # The exact response depends on the LLM and prompt.
            # We'll mock the raw OpenAI API response.
            mock_response = MagicMock()
            mock_choice = MagicMock()
            mock_message = MagicMock()
            # The agent uses content like:
            # '{"tool_name": "multiply", "tool_input": {"a": 5, "b": 3}}'
            mock_message.content = '{"tool_name": "multiply", "tool_input": {"a": 5, "b": 3}}'
            mock_choice.message = mock_message
            mock_response.choices = [mock_choice]
            mock_response.usage = MagicMock(total_tokens=10, prompt_tokens=5, completion_tokens=5)
            return mock_response
        else:
            # If a second call occurs, that's the bug.
            # We'll still return something to avoid breaking the test, but we'll assert later.
            mock_response = MagicMock()
            mock_choice = MagicMock()
            mock_message = MagicMock()
            mock_message.content = "Final answer: 15"
            mock_choice.message = mock_message
            mock_response.choices = [mock_choice]
            mock_response.usage = MagicMock(total_tokens=10, prompt_tokens=5, completion_tokens=5)
            return mock_response

    # The LLM in crewAI is wrapped; we need to mock the underlying client.
    # The LLM class uses openai.OpenAI or similar. We'll patch the client's chat.completions.create.
    # First, let's see what the actual import path is.
    # From the codebase, crewai.llm uses openai.OpenAI.
    # We'll patch 'openai.OpenAI.chat.completions.create'.
    with patch('openai.OpenAI.chat.completions.create', side_effect=mock_chat_completions_create):
        # Create an agent with the multiply tool.
        multiply_tool = MultiplyTool()
        agent = Agent(
            role="Math Agent",
            goal="Multiply numbers",
            backstory="A math expert",
            tools=[multiply_tool],
            verbose=False,
            llm={"provider": "openai", "model": "gpt-4"}  # dummy config, will be mocked
        )
        task = Task(
            description="Multiply 5 and 3",
            agent=agent,
            expected_output="The product of 5 and 3"
        )
        crew = Crew(agents=[agent], tasks=[task])

        # Run the crew.
        result = crew.kickoff()

        # In the fixed version, the result should be the tool output "15".
        # In the buggy version, the result might be something else, but we care about LLM calls.
        # Assert that the LLM was called exactly once (for the tool decision).
        # If the bug is present, call_count will be 2.
        # We'll also check usage_metrics: successful_requests should be 1 (fixed) vs 2 (buggy).
        metrics = crew.usage_metrics
        print(f"Call count: {call_count}")
        print(f"Metrics: {metrics}")
        # The bug: successful_requests > 1.
        # The fix: successful_requests == 1.
        # However, note that the agent may have internal LLM calls for planning?
        # The test should be robust: we assert that successful_requests is exactly 1.
        # If the bug is fixed, the assertion passes.
        # If the bug exists, successful_requests will be 2 (or more) and assertion fails.
        assert metrics['successful_requests'] == 1, f"Expected exactly 1 LLM request, got {metrics['successful_requests']}. This indicates the agent called LLM after tool with result_as_answer=True."
        # Also ensure the result is the tool output.
        # The result might be a CrewOutput object; we need its raw output.
        # In crewAI, kickoff returns a CrewOutput which has a raw attribute.
        if hasattr(result, 'raw'):
            output = result.raw
        else:
            output = str(result)
        # The output should contain "15".
        assert "15" in output, f"Expected result to contain '15', got {output}"[0m
