[32mimport os
import sys
from unittest.mock import patch, MagicMock
import pytest
from crewai import Agent, Crew, Task
from crewai.tools import BaseTool
from pydantic import BaseModel, Field


class MultiplyInput(BaseModel):
    a: int = Field(description="First number")
    b: int = Field(description="Second number")


class MultiplyTool(BaseTool):
    name: str = "multiply"
    description: str = "Multiply two numbers"
    args_schema: type[BaseModel] = MultiplyInput
    result_as_answer: bool = False

    def _run(self, a: int, b: int) -> str:
        return str(a * b)


def test_result_as_answer_should_not_call_llm():
    """When result_as_answer=True, the agent should return tool output directly without LLM interaction."""
    # Create a tool with result_as_answer=True
    multiply_tool = MultiplyTool(result_as_answer=True)

    # Mock the LLM to track calls and raise an error if called
    mock_llm = MagicMock()
    mock_llm.invoke = MagicMock(side_effect=Exception("LLM should not be called when result_as_answer=True"))

    # Create an agent with the tool
    agent = Agent(
        role="Calculator",
        goal="Multiply numbers",
        backstory="You are a calculator",
        tools=[multiply_tool],
        llm=mock_llm,
        verbose=False,
    )

    # Create a task that uses the tool
    task = Task(
        description="Multiply 3 and 4",
        agent=agent,
        expected_output="The product of 3 and 4",
    )

    # Create a crew with the agent and task
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=False,
    )

    # Kickoff the crew
    result = crew.kickoff()

    # Assert that the result is the tool output (12)
    assert "12" in str(result)

    # Assert that the LLM was never called
    assert mock_llm.invoke.call_count == 0

    # Assert that usage_metrics show zero successful_requests
    metrics = crew.usage_metrics
    assert metrics["successful_requests"] == 0


def test_result_as_answer_false_should_call_llm():
    """When result_as_answer=False, the agent should interact with LLM."""
    # Create a tool with result_as_answer=False
    multiply_tool = MultiplyTool(result_as_answer=False)

    # Mock the LLM to return a predefined response that indicates tool usage
    mock_llm = MagicMock()
    # Simulate the agent deciding to use the tool and then formatting the answer
    mock_llm.invoke = MagicMock(return_value=MagicMock(content="I'll use the multiply tool.", additional_kwargs={}))

    # Create an agent with the tool
    agent = Agent(
        role="Calculator",
        goal="Multiply numbers",
        backstory="You are a calculator",
        tools=[multiply_tool],
        llm=mock_llm,
        verbose=False,
    )

    # Create a task that uses the tool
    task = Task(
        description="Multiply 3 and 4",
        agent=agent,
        expected_output="The product of 3 and 4",
    )

    # Create a crew with the agent and task
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=False,
    )

    # Kickoff the crew
    result = crew.kickoff()

    # Assert that the LLM was called at least once
    assert mock_llm.invoke.call_count > 0

    # Assert that usage_metrics show at least one successful request
    metrics = crew.usage_metrics
    assert metrics["successful_requests"] > 0[0m
