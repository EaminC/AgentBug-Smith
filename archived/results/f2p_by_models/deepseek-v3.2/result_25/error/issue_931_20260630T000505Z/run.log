[32mimport pytest
from unittest.mock import Mock, patch
from crewai import Agent, Crew, Task, LLM
from crewai.tools import BaseTool
from pydantic import BaseModel, Field


class MultiplyInput(BaseModel):
    a: int = Field(..., description="First number")
    b: int = Field(..., description="Second number")


class MultiplyTool(BaseTool):
    name: str = "multiply"
    description: str = "Multiply two numbers"
    args_schema: type[BaseModel] = MultiplyInput
    result_as_answer: bool = False

    def _run(self, a: int, b: int) -> int:
        return a * b


def test_result_as_answer_should_not_increment_usage_metrics():
    """
    When a tool has result_as_answer=True, the agent should return the tool's output
    directly without making an LLM call, so successful_requests should remain zero.
    """
    # Create a mock LLM that we can track calls to
    mock_llm = Mock(spec=LLM)
    # Simulate the LLM returning a tool call for multiply
    mock_llm.call.return_value = {
        "content": None,
        "tool_calls": [
            {
                "name": "multiply",
                "arguments": {"a": 5, "b": -3},
            }
        ],
    }

    # Create the tool with result_as_answer=True
    multiply_tool = MultiplyTool(result_as_answer=True)

    # Create an agent with the mock LLM and the tool
    agent = Agent(
        role="Calculator",
        goal="Perform calculations",
        backstory="A math expert",
        tools=[multiply_tool],
        llm=mock_llm,
        verbose=False,
    )

    # Create a simple task
    task = Task(
        description="Multiply 5 and -3",
        agent=agent,
        expected_output="The product",
    )

    # Create a crew with the agent and task
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=False,
    )

    # Kickoff the crew
    result = crew.kickoff()

    # Assert that the result is the tool's output (5 * -3 = -15)
    assert result == "-15"

    # The key assertion: usage_metrics should show zero successful_requests
    # because the LLM should not have been called after the tool execution.
    metrics = crew.usage_metrics
    # In the buggy version, successful_requests would be >0 because the LLM
    # was called after the tool returned.
    # In the fixed version, successful_requests should be 0 (or at least not incremented
    # for the final answer step).
    # However, note that the LLM is called once to decide to use the tool.
    # So successful_requests may be 1, but it should NOT be 2 (which would indicate
    # an extra LLM call after the tool).
    # The issue reported successful_requests=2 in the buggy version.
    # We'll assert that successful_requests <= 1.
    assert metrics["successful_requests"] <= 1, (
        f"Expected at most 1 LLM call (for tool selection), got {metrics['successful_requests']}. "
        "Extra LLM call indicates result_as_answer not respected."
    )

    # Additionally, we can verify that the mock LLM's call method was called exactly once
    # (for the initial tool call decision).
    assert mock_llm.call.call_count == 1


def test_result_as_answer_false_should_increment_usage_metrics():
    """
    When result_as_answer=False, the agent should process the tool result through LLM,
    so successful_requests should be >1.
