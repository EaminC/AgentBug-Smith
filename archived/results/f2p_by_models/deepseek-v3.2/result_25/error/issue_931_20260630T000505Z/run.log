        },
        {
            "content": "The product is -15",
            "tool_calls": None,
        },
    ]

    multiply_tool = MultiplyTool(result_as_answer=False)

    agent = Agent(
        role="Calculator",
        goal="Perform calculations",
        backstory="A math expert",
        tools=[multiply_tool],
        llm=mock_llm,
        verbose=False,
    )

    task = Task(
        description="Multiply 5 and -3",
        agent=agent,
        expected_output="The product",
    )

    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=False,
    )

    result = crew.kickoff()
    # The final answer should be the LLM's response, not the raw tool output
    assert "The product is -15" in result

    metrics = crew.usage_metrics
    # There should be 2 successful requests: one for tool call, one for final answer
    assert metrics["successful_requests"] == 2
