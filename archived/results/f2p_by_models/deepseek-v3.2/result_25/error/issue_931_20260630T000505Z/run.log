[32mimport os
import sys
import pytest
from unittest.mock import MagicMock, patch, AsyncMock
from crewai import Agent, Task, Crew
from crewai.tools import BaseTool
from pydantic import BaseModel, Field
from typing import Any, Dict, Optional


class MultiplyToolSchema(BaseModel):
    a: float = Field(description="First number")
    b: float = Field(description="Second number")


class MultiplyTool(BaseTool):
    name: str = "multiply"
    description: str = "Multiply two numbers"
    args_schema: type[BaseModel] = MultiplyToolSchema
    result_as_answer: bool = False

    def _run(self, a: float, b: float) -> float:
        return a * b


def test_tool_result_as_answer_should_not_call_llm():
    """
    When a tool has result_as_answer=True, the agent should return the tool's result
    directly without making an LLM call. The usage_metrics should show zero successful_requests.
    """
    # Mock the LLM to track calls and ensure they don't happen
    mock_llm = MagicMock()
    mock_llm.call = MagicMock(side_effect=Exception("LLM should not be called"))
    mock_llm.invoke = MagicMock(side_effect=Exception("LLM should not be called"))
    mock_llm.model = "mock"
    mock_llm.temperature = 0.7
    mock_llm.max_tokens = None
    mock_llm.top_p = 1
    mock_llm.frequency_penalty = 0
    mock_llm.presence_penalty = 0
    mock_llm.stop = None

    # Create a tool with result_as_answer=True
    tool = MultiplyTool(result_as_answer=True)

    # Create an agent with the tool and mocked LLM
    agent = Agent(
        role="Math Agent",
        goal="Multiply numbers",
        backstory="You are a math agent",
        tools=[tool],
        llm=mock_llm,
        verbose=False,
    )

    # Create a task that will use the tool
    task = Task(
        description="Multiply 3 and 4",
        agent=agent,
        expected_output="The product of 3 and 4",
    )

    # Create a crew with the agent and task
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=False,
    )

    # Kickoff the crew
    result = crew.kickoff()

    # Assert the result is the tool output (12)
    assert result == "12" or result == 12 or str(result) == "12"

    # Get usage metrics
    metrics = crew.usage_metrics

    # In the buggy version, successful_requests would be >0 because the LLM was called.
    # In the fixed version, successful_requests should be 0 because the tool result is returned directly.
    # The test should fail on buggy code (successful_requests > 0) and pass on fixed code (successful_requests == 0).
    assert metrics["successful_requests"] == 0, (
        f"Expected successful_requests=0 when result_as_answer=True, got {metrics['successful_requests']}. "
        "LLM was called unnecessarily."
    )


def test_tool_result_as_answer_false_should_call_llm():
    """
    When result_as_answer=False (default), the agent should process the tool result through LLM.
    This ensures our mocking works and the test isn't trivially passing.
    """
    # Track LLM calls
    llm_calls = []

    def mock_llm_call(*args, **kwargs):
        llm_calls.append(1)
        # Return a simple response that will be parsed as AgentFinish
        return MagicMock(
            content="The result is 12.",
            additional_kwargs={},
            response_metadata={}
        )

    mock_llm = MagicMock()
    mock_llm.call = MagicMock(side_effect=mock_llm_call)
    mock_llm.invoke = MagicMock(side_effect=mock_llm_call)
    mock_llm.model = "mock"
    mock_llm.temperature = 0.7
    mock_llm.max_tokens = None
    mock_llm.top_p = 1
    mock_llm.frequency_penalty = 0
    mock_llm.presence_penalty = 0
    mock_llm.stop = None

    # Create a tool with result_as_answer=False (default)
    tool = MultiplyTool(result_as_answer=False)

    agent = Agent(
        role="Math Agent",
        goal="Multiply numbers",
        backstory="You are a math agent",
        tools=[tool],
        llm=mock_llm,
        verbose=False,
    )

    task = Task(
        description="Multiply 3 and 4",
        agent=agent,
        expected_output="The product of 3 and 4",
    )

    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=False,
    )

    # We need to mock the internal LLM client to avoid real API calls
    # The agent uses litellm internally, so we patch litellm.completion
    with patch('litellm.completion') as mock_litellm:
        mock_litellm.return_value = MagicMock(
            choices=[MagicMock(message=MagicMock(content="The result is 12."))],
            usage=MagicMock(prompt_tokens=10, completion_tokens=5, total_tokens=15)
        )
        result = crew.kickoff()

    # The LLM should have been called at least once
    assert len(llm_calls) > 0 or mock_litellm.called
    # The result should contain the LLM's response
    assert "12" in str(result)


if __name__ == "__main__":
    # Allow running directly with python
    pytest.main([__file__, "-v"])[0m
