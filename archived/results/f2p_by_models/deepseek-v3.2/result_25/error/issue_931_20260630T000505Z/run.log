def test_result_as_answer_should_not_call_llm():
    """
    When a tool has result_as_answer=True, the agent should return the tool's result
    as the final answer without making an LLM call.
    """
    # Create a mock LLM that will raise if called
    mock_llm = MagicMock(spec=LLM)
    mock_llm.temperature = 0
    mock_llm.model = "gpt-4"
    mock_llm.api_key = "fake_key"
    mock_llm.base_url = None
    mock_llm.max_tokens = None
    mock_llm.top_p = None
    mock_llm.frequency_penalty = None
    mock_llm.presence_penalty = None
    mock_llm.stop = None
    mock_llm.max_retries = 2
    mock_llm.timeout = None
    mock_llm.callbacks = []
    mock_llm.metadata = {}
    mock_llm.tags = []
    mock_llm.call = MagicMock(side_effect=Exception("LLM should not be called when result_as_answer=True"))

    # Create the tool with result_as_answer=True
    multiply_tool = MultiplyTool()

    # Create an agent with the tool
    agent = Agent(
        role="Calculator",
        goal="Perform calculations",
        backstory="You are a calculator",
        tools=[multiply_tool],
        llm=mock_llm,
        verbose=False
    )

    # Create a task that uses the tool
    task = Task(
        description="Multiply 3 and 4",
        agent=agent,
        expected_output="The product"
    )

    # Create a crew with the agent and task
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=False
    )

    # Kickoff the crew
    # In buggy version, this will call LLM and increment successful_requests
    # In fixed version, it should return the tool result directly without LLM call
    with patch.object(mock_llm, 'call', side_effect=Exception("LLM should not be called")):
        try:
            result = crew.kickoff()
            # If we get here in buggy version, LLM was called and we should fail
            # Check that usage_metrics shows zero successful_requests
            metrics = crew.usage_metrics
            # In buggy version, successful_requests will be >0
            # In fixed version, successful_requests should be 0
            # Assert that successful_requests is 0 (this will fail on buggy, pass on fixed)
            assert metrics['successful_requests'] == 0, f"Expected 0 successful_requests, got {metrics['successful_requests']}"
            # Also verify the result is correct
            assert result == "12", f"Expected result '12', got {result}"
        except Exception as e:
            # If LLM was called and raised, that's the buggy behavior
            # We want the test to fail in buggy version
            # So we re-raise the exception to make the test fail
            raise AssertionError(f"LLM was called when it shouldn't have been: {e}")

