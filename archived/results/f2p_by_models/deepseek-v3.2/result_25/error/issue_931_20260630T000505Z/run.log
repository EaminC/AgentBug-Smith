def test_integration_with_real_tool():
    """
    Integration test with a real tool definition using the @tool decorator.
    """
    from crewai.tools import tool
    
    # Create a tool with result_as_answer=True using decorator
    @tool("Multiply two numbers", result_as_answer=True)
    def multiply(a: int, b: int) -> int:
        return a * b
    
    # Create mock LLM
    mock_llm = MagicMock(spec=LLM)
    mock_llm.temperature = 0
    mock_llm.model = "gpt-4"
    mock_llm.api_key = "fake"
    mock_llm.call = MagicMock(side_effect=Exception("LLM should not be called"))
    
    # Create agent with the tool
    agent = Agent(
        role="Math Agent",
        goal="Do math",
        backstory="Math expert",
        tools=[multiply],
        llm=mock_llm,
        verbose=False
    )
    
    # Create task
    task = Task(
        description="Calculate 5 * 6",
        agent=agent,
        expected_output="30"
    )
    
    # Create crew
    crew = Crew(
        agents=[agent],
        tasks=[task],
        verbose=False
    )
    
    # Kickoff - should return tool result directly without LLM call
    with patch.object(mock_llm, 'call', side_effect=Exception("LLM should not be called")):
        try:
            result = crew.kickoff()
            metrics = crew.usage_metrics
            # In fixed version, successful_requests should be 0
            assert metrics['successful_requests'] == 0, f"Expected 0 successful_requests, got {metrics['successful_requests']}"
            # Result should be 30
            assert "30" in str(result), f"Expected result containing '30', got {result}"
        except Exception as e:
            # If LLM was called, that's the bug
            raise AssertionError(f"LLM was called when it shouldn't have been: {e}")

