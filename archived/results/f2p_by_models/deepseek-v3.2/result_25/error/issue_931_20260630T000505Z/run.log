[32mimport json
import os
from unittest.mock import patch, MagicMock
import pytest
from crewai import Agent, Task, Crew
from crewai.tools import BaseTool
from pydantic import BaseModel, Field


class MultiplyToolInput(BaseModel):
    a: float = Field(..., description="First number")
    b: float = Field(..., description="Second number")


class MultiplyTool(BaseTool):
    name: str = "multiply_tool"
    description: str = "Multiply two numbers"
    args_schema: type[BaseModel] = MultiplyToolInput
    result_as_answer: bool = False

    def _run(self, a: float, b: float) -> float:
        return a * b


def test_result_as_answer_does_not_call_llm():
    """
    When a tool has result_as_answer=True, the agent should return the tool's result
    directly without any LLM interaction (successful_requests should be 0).
    """
    # Mock the LLM to track calls and ensure none happen
    mock_llm_instance = MagicMock()
    mock_llm_instance.invoke = MagicMock(side_effect=Exception("LLM should not be called"))
    mock_llm_instance.stop = None
    mock_llm_instance.temperature = 0
    mock_llm_instance.max_tokens = None

    with patch('crewai.llm.LLM._default_llm', return_value=mock_llm_instance):
        # Create tool with result_as_answer=True
        tool = MultiplyTool(result_as_answer=True)

        # Create agent with the tool
        agent = Agent(
            role="Calculator",
            goal="Multiply numbers",
            backstory="You are a calculator",
            tools=[tool],
            llm=mock_llm_instance,
            verbose=False,
        )

        # Create task
        task = Task(
            description="Multiply 3 and 4",
            agent=agent,
            expected_output="The product",
        )

        # Create crew
        crew = Crew(
            agents=[agent],
            tasks=[task],
            verbose=False,
        )

        # Kickoff the crew
        result = crew.kickoff()

        # Verify the result is the tool output (12)
        assert result.raw == "12" or result.raw == 12 or str(result.raw) == "12"

        # Verify usage metrics show zero LLM calls
        metrics = crew.usage_metrics
        assert metrics["successful_requests"] == 0, f"Expected 0 LLM calls, got {metrics['successful_requests']}"
        assert metrics["total_tokens"] == 0, f"Expected 0 tokens, got {metrics['total_tokens']}"


def test_result_as_answer_false_calls_llm():
    """
    When result_as_answer=False (default), the agent should call LLM after tool execution.
    """
    # Track LLM invocations
    llm_calls = []

    def mock_invoke(*args, **kwargs):
        llm_calls.append(1)
        # Return a simple final answer
        return MagicMock(
            content="The product is 12",
            additional_kwargs={},
            response_metadata={}
        )

    mock_llm_instance = MagicMock()
    mock_llm_instance.invoke = MagicMock(side_effect=mock_invoke)
    mock_llm_instance.stop = None
    mock_llm_instance.temperature = —0
    mock_llm_instance.max_tokens = None

    with patch('crewai.llm.LLM._default_llm', return_value=mock_llm_instance):
        # Create tool with result_as_answer=False (default)
        tool = MultiplyTool(result_as_answer=False)

        agent = Agent(
            role="Calculator",
            goal="Multiply numbers",
            backstory="You are a calculator",
            tools=[tool],
            llm=mock_llm_instance,
            verbose=False,
        )

        task = Task(
            description="Multiply 3 and 4",
            agent=agent,
            expected_output="The product",
        )

        crew = Crew(
            agents=[agent],
            tasks=[task],
            verbose=False,
        )

        result = crew.kickoff()

        # The result should be the LLM's answer, not the raw tool output
        assert "12" in str(result.raw) or "product" in str(result.raw).lower()

        # Verify LLM was called at least once
        assert len(llm_calls) > 0, "LLM should have been called when result_as_answer=False"
        metrics = crew.usage_metrics
        assert metrics["successful_requests"] > 0, "Expected at least one LLM call"[0m
