        )

        result = agent("Run tool")

        assert result.stop_reason == "end_turn"
        assert executed == [True]

    @pytest.mark.parametrize("trust_response", ["trust", "T", "TRUST"])
    def test_trusts_with_alternate_trust_responses(self, trust_response):
