            executed.append(True)
            return "ran"

        def ask(prompt: str) -> str:
            ask_count.append(1)
            return "t"

        model = MockedModelProvider(
            [
                tool_use_message("danger_tool", "tool-1"),
                tool_use_message("danger_tool", "tool-2"),
                text_message("Done"),
            ]
        )
        agent = Agent(
            model=model,
            tools=[danger_tool],
            interventions=[
