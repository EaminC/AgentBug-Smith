from typing import List, Optional
from pydantic import BaseModel, Field
import pytest

from strands import Agent
from strands.tools import convert_pydantic_to_tool_spec


class Address(BaseModel):
    street: str
    city: str
    country: str
    postal_code: Optional[str] = None


class Contact(BaseModel):
    email: Optional[str] = None
    phone: Optional[str] = None


class Person(BaseModel):
    """Complete person information."""

    name: str = Field(description="Full name of the person")
    age: int = Field(description="Age in years")
    address: Address = Field(description="Home address")
    contacts: Optional[List[Contact]] = Field(description="Contact methods")
    skills: List[str] = Field(default_factory=list, description="Professional skills")


def test_convert_pydantic_to_tool_spec_no_unresolved_ref():
    """Test that convert_pydantic_to_tool_spec resolves $ref in Optional[List[BaseModel]] fields."""

    tool_spec = convert_pydantic_to_tool_spec(Person)
    # The tool_spec should not contain any unresolved $ref strings in the inputSchema json properties
    input_schema_json = tool_spec.get("inputSchema", {}).get("json", {})
    properties = input_schema_json.get("properties", {})

    # Check contacts property
    contacts_prop = properties.get("contacts")
    assert contacts_prop is not None, "contacts property missing in tool spec"
    # It should be a type array or nullable array (list or list|null)
    assert "type" in contacts_prop
    # It should not contain a $ref key anywhere inside contacts_prop
    def contains_ref(d):
        if isinstance(d, dict):
            if "$ref" in d:
                return True
            return any(contains_ref(v) for v in d.values())
        if isinstance(d, list):
            return any(contains_ref(i) for i in d)
        return False

    assert not contains_ref(contacts_prop), "contacts property contains unresolved $ref"

    # Also verify that the contacts items have properties describing Contact fields
    items = contacts_prop.get("items")
    assert items is not None, "contacts items missing"
    # The items should be an object with properties email and phone (or anyOf including null)
    if "anyOf" in items:
        # If anyOf, one of the options should be object with email and phone properties
        found = False
        for option in items["anyOf"]:
            if option.get("type") == "object" and "properties" in option:
                props = option["properties"]
                if "email" in props and "phone" in props:
                    found = True
                    break
        assert found, "contacts items anyOf does not include expected Contact object"
    else:
        # Direct object case
        assert "properties" in items, "contacts items missing properties"
        props = items["properties"]
        assert "email" in props and "phone" in props, "contacts items properties missing email or phone"


def test_agent_structured_output_with_person_model():
    """Test that Agent.structured_output works with Person model having Optional[List[Contact]] field."""

    agent = Agent()

    # We use a simple prompt that should produce a valid Person output
    prompt = (
        "Extract info: Jane Doe, a systems admin, 28, lives at 123 Main St, New York, USA, "
        "contact email jane@example.com, skills: systems admin"
    )

    # This call should not raise an exception (which happens in buggy code)
    result = agent.structured_output(Person, prompt)

    # Validate some fields in the result
    assert result.name == "Jane Doe"
    assert result.age == 28
    assert result.address.street == "123 Main St"
    assert result.address.city == "New York"
    assert result.address.country == "USA"
    # contacts can be None or list, but if present, first contact should have email
    if result.contacts is not None and len(result.contacts) > 0 and result.contacts[0] is not None:
        assert result.contacts[0].email == "jane@example.com"
    # skills should include "systems admin"
    assert "systems admin" in result.skills


if __name__ == "__main__":
    # Run tests if executed directly
    pytest.main([__file__])[0m
