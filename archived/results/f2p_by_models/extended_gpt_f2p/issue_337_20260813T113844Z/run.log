    def test_convert_pydantic_to_tool_spec_resolves_refs():
        """
        Test that convert_pydantic_to_tool_spec properly resolves $ref in Optional[List[BaseModel]] fields.
    
        Before the fix, the tool spec would contain unresolved $ref entries causing validation errors.
        After the fix, all nested schemas should be fully expanded without $ref.
        """
        tool_spec = convert_pydantic_to_tool_spec(Person)
        # The tool_spec inputSchema json properties for 'contacts' should NOT contain any $ref keys
        contacts_schema = tool_spec["inputSchema"]["json"]["properties"]["contacts"]
    
        # Assert that the 'contacts' property is an optional array (type includes "null")
        assert "type" in contacts_schema
        assert isinstance(contacts_schema["type"], list)
        assert "array" in contacts_schema["type"]
        assert "null" in contacts_schema["type"]
    
        # The 'items' property should be a fully expanded schema dict without any $ref keys
        items_schema = contacts_schema.get("items")
        assert items_schema is not None
    
        # Recursively check no $ref keys in items_schema
        def check_no_ref(schema):
            if isinstance(schema, dict):
                assert "$ref" not in schema
                for v in schema.values():
                    if isinstance(v, dict):
                        check_no_ref(v)
                    elif isinstance(v, list):
                        for item in v:
