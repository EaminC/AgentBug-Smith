    def test_convert_pydantic_to_tool_spec_resolves_refs():
        """
        Test that convert_pydantic_to_tool_spec properly resolves $ref in Optional[List[BaseModel]] fields,
        so that the resulting tool spec contains no unresolved $ref keys.
        """
        tool_spec = convert_pydantic_to_tool_spec(Person)
    
        # The inputSchema json should not contain any $ref keys anywhere
        def contains_ref(obj):
            if isinstance(obj, dict):
                if "$ref" in obj:
