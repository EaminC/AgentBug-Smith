[32mimport pytest
from typing import List, Optional
from pydantic import BaseModel, Field

from strands.tools import convert_pydantic_to_tool_spec
from strands.agent import Agent


class Address(BaseModel):
    street: str
    city: str
    country: str
    postal_code: Optional[str] = None


class Contact(BaseModel):
    email: Optional[str] = None
    phone: Optional[str] = None


class Person(BaseModel):
    """Complete person information."""
    name: str = Field(description="Full name of the person")
    age: int = Field(description="Age in years")
    address: Address = Field(description="Home address")
    contacts: Optional[List[Contact]] = Field(description="Contact methods")
    skills: List[str] = Field(default_factory=list, description="Professional skills")


def test_convert_pydantic_to_tool_spec_resolves_refs():
    """
    This test verifies that convert_pydantic_to_tool_spec properly resolves $ref fields
    in nested Optional[List[BaseModel]] fields, which previously caused validation errors.
    """
    tool_spec = convert_pydantic_to_tool_spec(Person)
    # The tool_spec inputSchema json properties for 'contacts' must NOT contain a $ref key
    contacts_schema = tool_spec["inputSchema"]["json"]["properties"]["contacts"]

    # The 'contacts' field is Optional[List[Contact]], so type should be ["array", "null"]
    assert "type" in contacts_schema
    assert isinstance(contacts_schema["type"], list)
    assert "array" in contacts_schema["type"]
    assert "null" in contacts_schema["type"]

    # The 'items' of contacts should be fully expanded object schema, not a $ref
    items_schema = contacts_schema.get("items")
    assert items_schema is not None
    # It should not have a $ref key
    assert "$ref" not in items_schema

    # It should have properties of Contact model (email, phone)
    assert "properties" in items_schema
    assert "email" in items_schema["properties"]
    assert "phone" in items_schema["properties"]

    # Now test that the Agent can parse a structured output with this schema without error
    agent = Agent()

    # Provide a prompt that should parse into the Person model
    prompt = (
        "Extract info: Jane Doe, a systems admin, 28, lives at 123 Main St, New York, USA, "
        "contact email jane@example.com, phone 123-456-7890, skills: systems admin"
    )

    # This call should NOT raise an exception (e.g. ValidationException)
    result = agent.structured_output(Person, prompt)

    # Validate parsed fields
    assert result.name == "Jane Doe"
    assert result.address.city == "New York"
    if result.contacts is not None and len(result.contacts) > 0 and result.contacts[0] is not None:
        assert result.contacts[0].email == "jane@example.com"
    else:
        pytest.fail("Contacts list is empty or None")
    assert "systems admin" in result.skills[0m
