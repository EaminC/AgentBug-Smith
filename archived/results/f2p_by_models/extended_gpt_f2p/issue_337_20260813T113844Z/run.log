    # We import asyncio here for the async generator
    import asyncio

    class DummyResponse:
        def __aiter__(self):
            return self

        async def __anext__(self):
            # Provide a single valid JSON string representing a Person instance
            # Then stop iteration
            if not hasattr(self, "sent"):
                self.sent = True
