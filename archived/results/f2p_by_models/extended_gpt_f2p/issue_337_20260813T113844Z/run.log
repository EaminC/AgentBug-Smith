[32mfrom typing import List, Optional
import pytest
from pydantic import BaseModel, Field
from strands.tools import convert_pydantic_to_tool_spec
from strands.agent import Agent


def test_convert_pydantic_to_tool_spec_no_unresolved_ref():
    """Test that convert_pydantic_to_tool_spec resolves all $refs, especially in Optional[List[BaseModel]] fields."""

    class Address(BaseModel):
        street: str
        city: str
        country: str
        postal_code: Optional[str] = None

    class Contact(BaseModel):
        email: Optional[str] = None
        phone: Optional[str] = None

    class Person(BaseModel):
        """Complete person information."""
        name: str = Field(description="Full name of the person")
        age: int = Field(description="Age in years")
        address: Address = Field(description="Home address")
        contacts: Optional[List[Contact]] = Field(description="Contact methods")
        skills: List[str] = Field(default_factory=list, description="Professional skills")

    tool_spec = convert_pydantic_to_tool_spec(Person)
    # The tool_spec should not contain any $ref keys anywhere in the JSON schema
    def check_no_ref(obj):
        if isinstance(obj, dict):
            assert "$ref" not in obj, "Found unresolved $ref in tool spec"
            for v in obj.values():
                check_no_ref(v)
        elif isinstance(obj, list):
            for item in obj:
                check_no_ref(item)

    check_no_ref(tool_spec)


def test_agent_structured_output_with_person_model():
    """Test that Agent.structured_output works with a Pydantic model having Optional[List[BaseModel]] fields without validation errors."""

    class Address(BaseModel):
        street: str
        city: str
        country: str
        postal_code: Optional[str] = None

    class Contact(BaseModel):
        email: Optional[str] = None
        phone: Optional[str] = None

