class Address(BaseModel):
    street: str
    city: str
    country: str
    postal_code: Optional[str] = None


class Contact(BaseModel):
    email: Optional[str] = None
    phone: Optional[str] = None


class Person(BaseModel):
    """Complete person information."""

    name: str = Field(description="Full name of the person")
    age: int = Field(description="Age in years")
    address: Address = Field(description="Home address")
    contacts: Optional[List[Contact]] = Field(description="Contact methods")
    skills: List[str] = Field(default_factory=list, description="Professional skills")


def test_convert_pydantic_to_tool_spec_no_unresolved_ref():
    """Test that convert_pydantic_to_tool_spec resolves $ref in Optional[List[BaseModel]] fields."""

    tool_spec = convert_pydantic_to_tool_spec(Person)
    # The tool_spec should not contain any unresolved $ref strings in the inputSchema json properties
    input_schema_json = tool_spec.get("inputSchema", {}).get("json", {})
    properties = input_schema_json.get("properties", {})

    # Check contacts property
    contacts_prop = properties.get("contacts")
    assert contacts_prop is not None, "contacts property missing in tool spec"
    # It should be a type array or nullable array (list or list|null)
    assert "type" in contacts_prop
    # It should not contain a $ref key anywhere inside contacts_prop
    def contains_ref(d):
        if isinstance(d, dict):
            if "$ref" in d:
                return True
            return any(contains_ref(v) for v in d.values())
        if isinstance(d, list):
            return any(contains_ref(i) for i in d)
        return False

    assert not contains_ref(contacts_prop), "contacts property contains unresolved $ref"


def test_agent_structured_output_with_person_model():
    """Test that Agent.structured_output works with Person model having Optional[List[Contact]] field."""

