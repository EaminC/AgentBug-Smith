                return {"text": json_str}
            else:
                raise StopAsyncIteration

    # Patch the agent's model client's converse_stream method
    # The agent.model attribute may differ depending on the implementation
    # We try to patch agent._model or agent._client or agent.model or agent._model_client
    # We'll try common attribute names and patch the first found
    patched = False
    for attr_name in ("_model", "_client", "model", "_model_client"):
        model_client = getattr(agent, attr_name, None)
        if model_client is not None:
            # Patch the converse_stream method
            async def dummy_converse_stream(*args, **kwargs):
                return DummyResponse()

            # Assign the dummy method
            setattr(model_client, "converse_stream", dummy_converse_stream)
            patched = True
            break

    if not patched:
