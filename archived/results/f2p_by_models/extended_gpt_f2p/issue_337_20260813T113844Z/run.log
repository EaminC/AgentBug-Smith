[32mimport pytest
from typing import List, Optional
from pydantic import BaseModel, Field

from strands.tools import convert_pydantic_to_tool_spec
from strands.agent import Agent


class Address(BaseModel):
    street: str
    city: str
    country: str
    postal_code: Optional[str] = None


class Contact(BaseModel):
    email: Optional[str] = None
    phone: Optional[str] = None


class Person(BaseModel):
    """Complete person information."""
    name: str = Field(description="Full name of the person")
    age: int = Field(description="Age in years")
    address: Address = Field(description="Home address")
    contacts: Optional[List[Contact]] = Field(description="Contact methods")
    skills: List[str] = Field(default_factory=list, description="Professional skills")


def test_convert_pydantic_to_tool_spec_resolves_refs():
    """
    Test that convert_pydantic_to_tool_spec properly resolves $ref in Optional[List[BaseModel]] fields,
    so that the resulting tool spec contains no unresolved $ref keys.
    """
    tool_spec = convert_pydantic_to_tool_spec(Person)

    # The inputSchema json should not contain any $ref keys anywhere
    def contains_ref(obj):
        if isinstance(obj, dict):
            if "$ref" in obj:
                return True
            return any(contains_ref(v) for v in obj.values())
        elif isinstance(obj, list):
            return any(contains_ref(i) for i in obj)
        return False

    assert not contains_ref(tool_spec), "Tool spec contains unresolved $ref"


def test_agent_structured_output_with_person_model():
    """
    Test that Agent.structured_output can parse and return a Person instance without validation errors,
    exercising the fix that resolves $ref in tool spec for Optional[List[BaseModel]].
    """
    agent = Agent()

    prompt = (
        "Extract info: Jane Doe, a systems admin, 28, lives at 123 Main St, New York, USA, "
        "contacts: email jane@example.com, phone 555-1234, skills: systems admin"
    )

    # This will raise an exception if the tool spec is invalid or if parsing fails
    result = agent.structured_output(Person, prompt)

    # Check that the returned object is a Person instance with expected attributes
    assert result.name == "Jane Doe"
    assert result.age == 28
    assert result.address.street == "123 Main St"
    assert result.address.city == "New York"
    assert result.address.country == "USA"
    assert result.skills == ["systems admin"]

    # contacts is Optional[List[Contact]], so check it is not None and has expected data
    assert result.contacts is not None
    assert len(result.contacts) > 0
    contact = result.contacts[0]
    assert contact.email == "jane@example.com"
    assert contact.phone == "555-1234"[0m
