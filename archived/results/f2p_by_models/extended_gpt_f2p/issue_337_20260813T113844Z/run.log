    city: str
    country: str
    postal_code: Optional[str] = None


class Contact(BaseModel):
    email: Optional[str] = None
    phone: Optional[str] = None


class Person(BaseModel):
    """Complete person information."""

    name: str = Field(description="Full name of the person")
    age: int = Field(description="Age in years")
    address: Address = Field(description="Home address")
    contacts: Optional[List[Contact]] = Field(description="Contact methods")
    skills: List[str] = Field(default_factory=list, description="Professional skills")


def test_convert_pydantic_to_tool_spec_resolves_refs():
    # This test verifies that convert_pydantic_to_tool_spec properly resolves $refs
    # for fields typed as Optional[List[BaseModel]], which was previously broken.

    tool_spec = convert_pydantic_to_tool_spec(Person)
    # The tool spec should not contain any unresolved $ref keys in the inputSchema json properties
    input_schema = tool_spec["inputSchema"]["json"]

    # Recursively check no $ref keys exist in the schema properties
    def check_no_ref(schema):
        if isinstance(schema, dict):
            assert "$ref" not in schema, "Found unresolved $ref in schema"
            for key, value in schema.items():
                if isinstance(value, dict):
                    check_no_ref(value)
                elif isinstance(value, list):
                    for item in value:
                        if isinstance(item, dict):
                            check_no_ref(item)

    check_no_ref(input_schema)

    # Also verify that the tool spec can be used to instantiate an Agent and parse structured output
    agent = Agent()

    # Compose a prompt that should produce a valid Person output
    prompt = (
        "Extract info: Jane Doe, a systems admin, 28, lives at 123 Main St, New York, USA. "
        "Email: jane@example.com. Skills: systems admin."
    )

    # We patch the internal model client call to avoid real API calls and credentials issues
    # but do not patch the structured_output method itself.
    # Instead, we monkeypatch the client inside the agent's model to yield a dummy valid response.

    # The following is a minimal mock for the model client converse_stream method
    # to avoid network calls and credential errors.

    import types
    import asyncio

    class DummyResponse:
        def __aiter__(self):
            return self

        async def __anext__(self):
            raise StopAsyncIteration

    class DummyClient:
        def converse_stream(self, **kwargs):
            return DummyResponse()

    # Patch the agent's model client to dummy client
    agent._model.client = DummyClient()

    # Run structured_output, which should not raise exceptions now
    result = agent.structured_output(Person, prompt)

    # The result should be an instance of Person (or compatible)
    assert isinstance(result, Person)

    # Check some fields are present and of correct type
    assert isinstance(result.name, str)
    assert isinstance(result.age, int)
    assert isinstance(result.address, Address)
    assert isinstance(result.skills, list)
    # contacts is optional list
    if result.contacts is not None:
        assert isinstance(result.contacts, list)
        for contact in result.contacts:
            assert isinstance(contact, Contact) or contact is None


