#            ~~~~~~~~~~~~~~~~~~~~~~~^^^^^
#   File "/opt/homebrew/Cellar/python@3.13/3.13.5/Frameworks/Python.framework/Versions/3.13/lib/python3.13/json/encoder.py", line 200, in encode
#     chunks = self.iterencode(o, _one_shot=True)
