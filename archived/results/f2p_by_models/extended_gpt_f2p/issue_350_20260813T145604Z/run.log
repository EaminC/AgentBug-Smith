                event={"contentBlockStart": {"start": {"toolUse": {"toolUseId": "123", "name": "test"}}}}
            ),
            unittest.mock.call(event={"contentBlockDelta": {"delta": {"toolUse": {"input": '{"value"}'}}}}),
            unittest.mock.call(
                agent=agent,
                current_tool_use={"toolUseId": "123", "name": "test", "input": {}},
