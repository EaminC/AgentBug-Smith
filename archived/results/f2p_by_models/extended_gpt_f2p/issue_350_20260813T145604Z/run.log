from strands import Agent
from strands.tools import tool


@pytest.fixture
def tool_decorated(agent):
    # Define a simple tool for testing
    @tool(name="tool_decorated")
    def function(random_string: str, **kwargs) -> str:
        return random_string

    # Register the tool to the agent's tool registry
    agent.tool_registry.register_tool(function)
    return function


@pytest.fixture
def agent(tool_decorated):
    # Create an Agent with the decorated tool registered
    return Agent(tools=[tool_decorated])


def test_agent_tool_non_serializable_parameter_filtering(agent, tool_decorated):
    """
    Test that passing an Agent object as a parameter to a direct tool call does not raise a JSON serialization error.
    This reproduces the bug where Agent objects were not JSON serializable in tool input parameters.
    """
    another_agent = Agent()

    # Call the tool directly with a non-serializable Agent object as a parameter
    result = agent.tool.tool_decorated(
        random_string="test_value",
        non_serializable_agent=another_agent,
        user_message_override="Testing non-serializable parameter filtering",
    )

    # The tool returns the random_string parameter as content text
    expected_result = {
        "content": [{"text": "test_value"}],
        "status": "success",
        "toolUseId": result.get("toolUseId"),  # toolUseId is generated dynamically
    }
    assert result == expected_result

    # Check that the agent recorded messages including the user message override and the tool call description
    assert len(agent.messages) > 0
    user_message = agent.messages[0]
    assert user_message["role"] == "user"
    assert len(user_message["content"]) == 2

    # The first content block is the user_message_override text
    assert user_message["content"][0]["text"] == "Testing non-serializable parameter filtering\n"

    # The second content block contains the tool call description with filtered parameters
    tool_call_text = user_message["content"][1]["text"]
    assert "agent.tool.tool_decorated direct tool call." in tool_call_text
    assert '"random_string": "test_value"' in tool_call_text
    # The non-serializable Agent object should be replaced with a descriptive string
    assert '"non_serializable_agent": "<<non-serializable: Agent>>"' in tool_call_text


def test_agent_tool_multiple_non_serializable_types(agent):
    """
    Test that various non-serializable types in tool parameters are replaced with descriptive strings during serialization.
    """
    class CustomClass:
        def __init__(self, value):
            self.value = value

    non_serializable_objects = {
        "agent": Agent(),
        "custom_object": CustomClass("test"),
        "function": lambda x: x,
        "set_object": {1, 2, 3},
        "complex_number": 3 + 4j,
        "serializable_string": "this_should_remain",
        "serializable_number": 42,
        "serializable_list": [1, 2, 3],
        "serializable_dict": {"key": "value"},
    }

    result = agent.tool.tool_decorated(random_string="test_filtering", **non_serializable_objects)

    expected_result = {
        "content": [{"text": "test_filtering"}],
        "status": "success",
        "toolUseId": result.get("toolUseId"),
    }
    assert result == expected_result

    assert len(agent.messages) > 0
    user_message = agent.messages[0]
    # The tool call description is either in content[1] or content[0] depending on user_message_override presence
    # Here no user_message_override was passed, so content[0] should have the tool call description
    tool_call_text = user_message["content"][0]["text"]

    # Serializable values remain unchanged
    assert '"serializable_string": "this_should_remain"' in tool_call_text
    assert '"serializable_number": 42' in tool_call_text
    assert '"serializable_list": [1, 2, 3]' in tool_call_text
    assert '"serializable_dict": {"key": "value"}' in tool_call_text

    # Non-serializable objects replaced with descriptive strings
    assert '"agent": "<<non-serializable: Agent>>"' in tool_call_text
    assert (
        '"custom_object": "<<non-serializable: test_agent_tool_multiple_non_serializable_types.<locals>.CustomClass>>"'
        in tool_call_text
    )
    assert '"function": "<<non-serializable: function>>"' in tool_call_text
    assert '"set_object": "<<non-serializable: set>>"' in tool_call_text
    assert '"complex_number": "<<non-serializable: complex>>"' in tool_call_text


def test_agent_tool_serialization_edge_cases(agent):
    """
    Test edge cases in parameter serialization filtering including None, empty containers, and nested structures.
    """
    edge_case_params = {
        "none_value": None,
        "empty_list": [],
        "empty_dict": {},
        "nested_list_with_non_serializable": [1, 2, Agent()],
