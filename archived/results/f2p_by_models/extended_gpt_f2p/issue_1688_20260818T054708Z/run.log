    def union_callback(event: BeforeModelCallEvent | AfterModelCallEvent) -> None:
        if isinstance(event, BeforeModelCallEvent):
            call_count["before"] += 1
        elif isinstance(event, AfterModelCallEvent):
            call_count["after"] += 1

