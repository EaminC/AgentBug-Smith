def test_plugin_class_sync_implementation():
    """Test Plugin class works with synchronous init_plugin."""

    class SyncPlugin(Plugin):
        name = "sync-plugin"

        def init_plugin(self, agent):
            agent.custom_attribute = "initialized by plugin"

