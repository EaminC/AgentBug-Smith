[32m# -*- coding: utf-8 -*-
"""Fail2pass test for issue #88: Using qwen-vl-plus model causes 400 error."""

import unittest
from agentscope.agents import DialogAgent, UserAgent
from agentscope.message import Msg
from agentscope.pipelines.functional import sequentialpipeline
import agentscope


class TestQwenVlPlusModel400Error(unittest.TestCase):
    """Test that using qwen-vl-plus model with Msg containing image URL works without 400 error."""

    def setUp(self) -> None:
        # Initialize agentscope with qwen-vl-plus model config
        agentscope.init(
            model_configs=[
                {
                    "config_name": "qwen-vl-plus",
                    "model_type": "dashscope_multimodal",
                    "model_name": "qwen-vl-plus",
                    "api_key": "sk-df---314ae----------------------",
                }
            ]
        )
        self.agent_1 = DialogAgent(
            name="助手",
            sys_prompt="你是一位好帮手",
            model_config_name="qwen-vl-plus",
        )
        self.useragent = UserAgent()

    def test_multimodal_dialog(self):
        # Create initial message with image URL
        x = Msg(
            name="用户",
            content="帮我描述一下这个图片",
            url="https://dashscope.oss-cn-beijing.aliyuncs.com/images/dog_and_girl.jpeg",
        )
        self.assertIsNotNone(x)
        # Run a single step of sequentialpipeline to get response from agent
        # We expect no RuntimeError or 400 error here
        response = sequentialpipeline([self.agent_1, self.useragent], input_msg=x)
        self.assertIsNotNone(response)
        self.assertNotEqual(response.content, "exit")
        # The response content should be a non-empty string (the agent's reply)
        self.assertIsInstance(response.content, str)
        self.assertTrue(len(response.content) > 0)


if __name__ == "__main__":
    unittest.main()[0m
