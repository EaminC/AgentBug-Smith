--- a/src/strands/models/anthropic.py
+++ b/src/strands/models/anthropic.py
@@ -483,3 +483,27 @@ class AnthropicModel(Model):
             raise ValueError("No valid tool use or tool use input was found in the Anthropic response.")
 
         yield {"output": output_model(**output_response)}
+
+from typing import Optional
+
+@override
+async def estimate_tokens(
+    self, messages: Messages, tool_specs: list[ToolSpec] | None = None, system_prompt: Optional[str] = None
+) -> int:
+    """Estimate token count for the given input before sending to model."""
+    # Using anthropic.count_tokens to estimate tokens
+    from anthropic import count_tokens
+    text = ""
+    if system_prompt:
+        text += system_prompt + "\n"
+    for msg in messages:
+        role = msg.get("role", "")
+        content_list = msg.get("content", [])
+        text += role + ": "
+        for block in content_list:
+            if "text" in block:
+                text += block["text"] + "\n"
+            elif "toolUse" in block:
+                import json
+                text += json.dumps(block["toolUse"]["input"]) + "\n"
+    return count_tokens(text)
