    model_name = "gpt-4o"
    instance.configure_model_settings(model_name)

    # The patch only applies if "o1-" in model name, so these flags should not be forcibly False
    assert hasattr(instance, "use_system_prompt"), "Missing attribute use_system_prompt"
    assert instance.use_system_prompt is not False, "use_system_prompt should not be forcibly False for other models"


