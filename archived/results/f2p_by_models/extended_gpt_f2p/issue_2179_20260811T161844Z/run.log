# We will test that the model configuration for a date-stamped o1 model disables system prompt usage,
# temperature, and streaming, as per the fix.
#
# On the buggy codebase, these flags will not be set correctly for date-stamped o1 models,
# causing the test to fail.
#
# After applying the fix, the test should pass.

def test_o1_date_stamped_model_configuration():
    # Create a dummy instance of the model settings class
    # The class is likely named ModelSettings or similar in aider.models
    # We inspect aider.models for a suitable class:
    # The patch modifies a method configure_model_settings(self, model)
    # So we need to instantiate the class that has this method.
    #
    # From the patch path and code, this method is likely inside a class in aider.models.
    # Let's find the class by introspection:
    #
    # We try to find a class with configure_model_settings method.
    # For this test, we assume the class is named ModelSettings (common pattern).
    #
    # If not found, fallback to the first class with that method.
    #
    # We do not mock configure_model_settings, we call the real method.

    # Find the class with configure_model_settings method
    target_cls = None
    for name in dir(aider.models):
        obj = getattr(aider.models, name)
        if isinstance(obj, type):
            if hasattr(obj, "configure_model_settings"):
                target_cls = obj
                break
    assert target_cls is not None, "Could not find class with configure_model_settings"

    # Instantiate the class
    # Try to instantiate without arguments, else skip test (fail)
    try:
        instance = target_cls()
    except Exception as e:
        pytest.skip(f"Cannot instantiate {target_cls} without args: {e}")

    # Call configure_model_settings with a date-stamped o1 model name
    model_name = "azure/o1-preview-2024-09-12"
    instance.configure_model_settings(model_name)

    # Now check that the flags are set as per the fix:
    # use_system_prompt = False
    # use_temperature = False
    # streaming = False
    #
    # These attributes must exist on the instance after configuration.
    # The patch sets these attributes on self.
    # Fail if attributes missing or values incorrect.

    assert hasattr(instance, "use_system_prompt"), "Missing attribute use_system_prompt"
    assert hasattr(instance, "use_temperature"), "Missing attribute use_temperature"
    assert hasattr(instance, "streaming"), "Missing attribute streaming"

    assert instance.use_system_prompt is False, "use_system_prompt should be False for date-stamped o1 model"
    assert instance.use_temperature is False, "use_temperature should be False for date-stamped o1 model"
    assert instance.streaming is False, "streaming should be False for date-stamped o1 model"


def test_o1_non_date_stamped_model_configuration():
