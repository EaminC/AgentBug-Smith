[32mimport pytest
from typing import Any, Dict, List, Optional, Union

from crewai import Agent, Crew, Process, Task
from crewai.llms.base_llm import BaseLLM
from crewai.utilities.llm_utils import create_llm


class CustomJWTLLM(BaseLLM):
    """Custom LLM implementation that uses JWT authentication and does not require API key."""

    def __init__(self, jwt_token: str, model: str = "custom-jwt-model"):
        super().__init__(model=model)
        if not jwt_token or not isinstance(jwt_token, str):
            raise ValueError("Invalid JWT token")
        self.jwt_token = jwt_token
        self.call_count = 0
        self.stop = []

    def call(
        self,
        messages: Union[str, List[Dict[str, str]]],
        tools: Optional[List[dict]] = None,
        callbacks: Optional[List[Any]] = None,
        available_functions: Optional[Dict[str, Any]] = None,
    ) -> Union[str, Any]:
        self.call_count += 1
        # Simulate a response that includes the JWT token to verify usage
        if isinstance(messages, str):
            prompt = messages
        else:
            prompt = " ".join(m.get("content", "") for m in messages if isinstance(m, dict))
        return f"JWT LLM response to prompt: {prompt}"

    def supports_function_calling(self) -> bool:
        return True

    def supports_stop_words(self) -> bool:
        return True

    def get_context_window_size(self) -> int:
        return 8192


@pytest.mark.parametrize("use_custom_llm", [True, False])
def test_custom_jwt_llm_in_agent_and_crew(use_custom_llm: bool):
    """
    Test that a custom JWT-authenticated LLM can be used in an Agent and Crew without requiring API key.

    This test fails on the buggy codebase because the system expects an API key or OPENAI_API_KEY env var,
    causing an AuthenticationError. After the fix, it should pass.
    """
    # Create the custom JWT LLM instance
    jwt_token = "dummy.jwt.token"
    custom_llm = CustomJWTLLM(jwt_token=jwt_token)

    # Create an agent using the custom LLM
    agent = Agent(
        role="Research Assistant",
        goal="Answer a simple question",
        backstory="You are a helpful assistant.",
        llm=custom_llm,
    )

    # Create a task for the agent
    task = Task(
        description="Answer the ultimate question",
        expected_output="A meaningful answer",
        agent=agent,
    )

    # Create a crew with the agent and task
    crew = Crew(
        agents=[agent],
        tasks=[task],
        process=Process.sequential,
        # Use the custom LLM as manager_llm if testing that path
        manager_llm=custom_llm if use_custom_llm else None,
        chat_llm=custom_llm if not use_custom_llm else None,
    )

    # Kickoff the crew execution
    result = crew.kickoff()

    # Assert that the custom LLM was called at least once
    assert custom_llm.call_count > 0, "Custom JWT LLM was not called"

    # Assert that the result contains expected text from the custom LLM response
    assert "JWT LLM response" in result.raw or "JWT LLM response" in str(result), (
        "Crew output does not contain expected JWT LLM response"
    )


def test_create_llm_returns_custom_jwt_llm_instance():
    """Test that create_llm returns the custom JWT LLM instance as is."""
    jwt_llm = CustomJWTLLM(jwt_token="token")
    created_llm = create_llm(jwt_llm)
    assert created_llm is jwt_llm, "create_llm did not return the custom JWT LLM instance"


def test_custom_jwt_llm_rejects_invalid_token():
    """Test that CustomJWTLLM raises ValueError on invalid JWT token."""
    with pytest.raises(ValueError):
        CustomJWTLLM(jwt_token="")

    with pytest.raises(ValueError):
        CustomJWTLLM(jwt_token=None)  # type: ignore


def test_custom_jwt_llm_supports_methods():
