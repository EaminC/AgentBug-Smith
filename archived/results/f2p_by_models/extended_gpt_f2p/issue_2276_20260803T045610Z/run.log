[32mimport pytest
from typing import Any, Dict, List, Optional, Union

from crewai import Agent, Crew, Process, Task
from crewai.llms.base_llm import BaseLLM
from crewai.utilities.llm_utils import create_llm


class CustomJWTLLM(BaseLLM):
    """Custom LLM implementation that uses JWT authentication and overrides call."""

    def __init__(self, jwt_token: str, model: str = "custom-jwt-model"):
        super().__init__(model=model)
        if not jwt_token or not isinstance(jwt_token, str):
            raise ValueError("Invalid JWT token")
        self.jwt_token = jwt_token
        self.call_count = 0
        self.stop = []

    def call(
        self,
        messages: Union[str, List[Dict[str, str]]],
        tools: Optional[List[dict]] = None,
        callbacks: Optional[List[Any]] = None,
        available_functions: Optional[Dict[str, Any]] = None,
    ) -> Union[str, Any]:
        self.call_count += 1

        # Normalize messages to list of dicts with role and content
        if isinstance(messages, str):
            messages = [{"role": "user", "content": messages}]

        # Return a dummy response that includes the JWT token to verify usage
        return f"JWT token used: {self.jwt_token}, message count: {len(messages)}"

    def supports_function_calling(self) -> bool:
        return True

    def supports_stop_words(self) -> bool:
        return True

    def get_context_window_size(self) -> int:
        return 8192


@pytest.mark.parametrize("use_custom_llm", [True, False])
def test_custom_jwt_llm_in_agent_and_crew(use_custom_llm: bool):
    """
    Test that a custom LLM implementation with JWT authentication can be used
    in an Agent and Crew without triggering litellm API key errors.

    This test should fail on the buggy codebase due to missing API key errors,
    and pass after the fix that supports custom LLM implementations.
    """
    jwt_token = "test.jwt.token.value"

    if use_custom_llm:
        llm_instance = CustomJWTLLM(jwt_token=jwt_token)
    else:
        # Use the default LLM (which may require API key and fail on buggy code)
        llm_instance = None

    agent = Agent(
        role="Test Agent",
        goal="Test goal",
        backstory="Test backstory",
        llm=llm_instance,
    )

    task = Task(
        description="Test task",
        expected_output="Expected output",
        agent=agent,
    )

    crew = Crew(
        agents=[agent],
        tasks=[task],
        process=Process.sequential,
        manager_llm=llm_instance,
        chat_llm=llm_instance,
    )

    # Kickoff the crew and get the result
    result = crew.kickoff()

    if use_custom_llm:
        # The custom LLM should have been called
        assert agent.llm.call_count > 0
        # The result raw text should include the JWT token string
        assert "JWT token used" in result.raw
        assert jwt_token in result.raw
    else:
        # When not using custom LLM, the test expects failure on buggy codebase
        # but here we just check that result is not None (may raise in buggy)
        assert result is not None


def test_create_llm_returns_custom_jwt_llm_instance():
    """
    Test that create_llm returns the custom JWT LLM instance as is,
    without trying to wrap or replace it.
    """
    jwt_llm = CustomJWTLLM(jwt_token="jwt-token-for-create-llm-test")
    created_llm = create_llm(jwt_llm)
    assert created_llm is jwt_llm
    response = created_llm.call("Hello")
    assert "JWT token used" in response


def test_custom_jwt_llm_validation():
    """
    Test that CustomJWTLLM raises ValueError on invalid JWT tokens.
    """
    with pytest.raises(ValueError):
        CustomJWTLLM(jwt_token="")

    with pytest.raises(ValueError):
        CustomJWTLLM(jwt_token=None)  # type: ignore


def test_custom_jwt_llm_call_message_formatting():
    """
    Test that CustomJWTLLM call method accepts both string and list messages.
    """
    llm = CustomJWTLLM(jwt_token="jwt-token-format-test")

    # String message
    response1 = llm.call("Hello")
    assert "message count: 1" in response1

    # List of messages
    messages = [
        {"role": "system", "content": "System message"},
        {"role": "user", "content": "User message"},
    ]
    response2 = llm.call(messages)
