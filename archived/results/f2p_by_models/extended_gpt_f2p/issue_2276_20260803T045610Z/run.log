[32mimport pytest
from typing import Any, Dict, List, Optional, Union

from crewai import Agent, Crew, Process, Task
from crewai.llms.base_llm import BaseLLM
from crewai.utilities.llm_utils import create_llm


class CustomJWTLLM(BaseLLM):
    def __init__(self, jwt_token: str, model: str = "custom-jwt-model"):
        super().__init__(model=model)
        if not jwt_token or not isinstance(jwt_token, str):
            raise ValueError("Invalid JWT token")
        self.jwt_token = jwt_token
        self.call_count = 0
        self.stop = []

    def call(
        self,
        messages: Union[str, List[Dict[str, str]]],
        tools: Optional[List[dict]] = None,
        callbacks: Optional[List[Any]] = None,
        available_functions: Optional[Dict[str, Any]] = None,
    ) -> Union[str, Any]:
        self.call_count += 1
        # Simulate a response that includes the JWT token for verification
        if isinstance(messages, str):
            messages = [{"role": "user", "content": messages}]
        return f"JWT token used: {self.jwt_token}, message count: {len(messages)}"

    def supports_function_calling(self) -> bool:
        return True

    def supports_stop_words(self) -> bool:
        return True

    def get_context_window_size(self) -> int:
        return 8192


@pytest.mark.parametrize("llm_class", [CustomJWTLLM])
def test_custom_jwt_llm_usage(llm_class):
    # Instantiate the custom JWT LLM with a dummy token
    jwt_token = "dummy.jwt.token"
    llm_instance = llm_class(jwt_token=jwt_token)

    # Verify that create_llm returns the instance directly
    created_llm = create_llm(llm_instance)
    assert created_llm is llm_instance

    # Test calling the LLM with string input
    response = created_llm.call("Hello world")
    assert "JWT token used: dummy.jwt.token" in response
    assert "message count: 1" in response
    assert created_llm.call_count == 1

    # Test calling the LLM with list of messages
    messages = [
        {"role": "system", "content": "System message"},
        {"role": "user", "content": "User message"},
    ]
    response2 = created_llm.call(messages)
    assert "message count: 2" in response2
    assert created_llm.call_count == 2

    # Use the custom LLM in an Agent and Crew, then kickoff
    agent = Agent(
        role="Test Agent",
        goal="Test goal",
        backstory="Test backstory",
        llm=llm_instance,
    )
    task = Task(
        description="Test task",
        expected_output="Expected output",
        agent=agent,
    )
    crew = Crew(
        agents=[agent],
        tasks=[task],
        process=Process.sequential,
    )
    result = crew.kickoff()

    # Assert the LLM was called at least once during crew kickoff
    assert llm_instance.call_count > 0
    # Assert the result raw output contains expected string from LLM call
    assert "JWT token used: dummy.jwt.token" in result.raw


def test_jwt_llm_invalid_token():
    # Test that invalid JWT token raises ValueError
    with pytest.raises(ValueError):
        CustomJWTLLM(jwt_token="")

    with pytest.raises(ValueError):
        CustomJWTLLM(jwt_token=None)  # type: ignore


def test_custom_jwt_llm_supports_methods():
    llm = CustomJWTLLM(jwt_token="valid.token")
    assert llm.supports_function_calling() is True
    assert llm.supports_stop_words() is True
    assert llm.get_context_window_size() == 8192[0m
