import unittest.mock

import pytest

from strands.models.ollama import OllamaModel


@pytest.mark.asyncio
async def test_ollama_token_usage_counts_swapped(ollama_client, model):
    """
    This test verifies that the OllamaModel correctly maps inputTokens and outputTokens
    from the event metadata. The buggy code swaps these counts, so this test will fail
    before the fix and pass after the fix.

    The test mocks an Ollama streaming response event with eval_count=output tokens,
    prompt_eval_count=input tokens, and checks that the usage dict maps these correctly.
    """

    # Prepare a mock event with swapped counts
    mock_event = unittest.mock.Mock()
    mock_event.message.tool_calls = None
    mock_event.message.content = "Hello"
    mock_event.done_reason = "stop"
    # According to Ollama API:
    # prompt_eval_count = input tokens (e.g. 7)
    # eval_count = output tokens (e.g. 13)
    mock_event.prompt_eval_count = 7
    mock_event.eval_count = 13
    mock_event.total_duration = 1_000_000  # 1 ms in nanoseconds

    # Mock the AsyncClient.chat method to yield the mock event
    ollama_client.chat = unittest.mock.AsyncMock(return_value=async_generator([mock_event]))

    # Prepare a simple user message
    messages = [{"role": "user", "content": [{"text": "Hello"}]}]

    # Call the model's stream method which yields formatted events
    response = model.stream(messages)

    # Collect all events from the async generator
    events = [event async for event in response]

    # The last event should be the metadata event with usage counts
    metadata_event = events[-1]
