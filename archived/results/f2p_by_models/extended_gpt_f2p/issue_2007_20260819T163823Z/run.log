    assert usage["inputTokens"] == mock_event.prompt_eval_count, (
        f"Expected inputTokens to be prompt_eval_count ({mock_event.prompt_eval_count}), "
        f"got {usage['inputTokens']}"
    )
    # Assert that outputTokens equals eval_count (output tokens)
