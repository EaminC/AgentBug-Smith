    assert usage.get("outputTokens") == 13, "outputTokens should be eval_count (output tokens)"

    # Assert totalTokens is sum of input and output tokens
    assert usage.get("totalTokens") == 20, "totalTokens should be sum of inputTokens and outputTokens"


