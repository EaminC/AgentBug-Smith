        f"Expected outputTokens to be eval_count ({mock_event.eval_count}), "
        f"got {usage['outputTokens']}"
    )
    # Assert totalTokens is sum of both
    assert usage["totalTokens"] == mock_event.eval_count + mock_event.prompt_eval_count, (
        f"Expected totalTokens to be sum of input and output tokens "
        f"({mock_event.eval_count + mock_event.prompt_eval_count}), got {usage['totalTokens']}"
