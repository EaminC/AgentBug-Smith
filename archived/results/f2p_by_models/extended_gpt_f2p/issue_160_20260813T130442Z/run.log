        nonlocal captured_system_prompt
        captured_system_prompt = kwargs.get("system", "")
        # Return dummy final text
        return type("DummyCompletion", (), {"stop_reason": None, "content": [type("obj", (), {"text": "ok"})()]})()

    model.client.messages.create = dummy_create

    model.query([], response_format={"type": "json"})

    assert "Outputs only valid json without any explanatory words" in captured_system_prompt
    # It should NOT contain the old buggy text "You must output in json format"


def test_claude_model_func_call_history_limit():
    """
    Test that ClaudeModel disables functions after more than 3 search function calls.
    """
    from mle.model import ClaudeModel

    model = ClaudeModel(api_key="dummy_api_key", model=None)

    # Patch the client's messages.create to simulate multiple tool_use calls with search functions
    class DummyFunc:
        def __init__(self, id, name, input, type_):
            self.id = id
            self.name = name
            self.input = input
            self.type = type_

    class DummyCompletion:
        def __init__(self, stop_reason, content):
            self.stop_reason = stop_reason
            self.content = content

    search_func_name = "search_code"

    # Prepare a sequence of completions to simulate multiple tool_use calls
    completions = []
    for i in range(5):
        completions.append(DummyCompletion(
            stop_reason="tool_use",
            content=[DummyFunc(
                id=str(i),
                name=search_func_name,
                input={"query": f"query {i}"},
                type_="tool_use"
            )]
        ))
    # Final completion with no tool_use
    completions.append(DummyCompletion(stop_reason=None, content=[type("obj", (), {"text": "final output"})()]))

    call_index = {"idx": 0}

    def dummy_create(**kwargs):
        idx = call_index["idx"]
        call_index["idx"] += 1
        return completions[idx]

    model.client.messages.create = dummy_create

    # Patch get_function to a dummy that returns dummy_tool_function
    from mle.model import get_function
    original_get_function = get_function
    try:
        import mle.model
        mle.model.get_function = lambda name: dummy_tool_function

        # Run query which should call the dummy_create multiple times and eventually disable functions
        output = model.query([], functions=[{"name": search_func_name, "parameters": {}}])

        # After more than 3 calls, functions should be disabled (empty) in the last call
        # We check that the output is the final output string
        assert output == "final output"
    finally:
        mle.model.get_function = original_get_function

