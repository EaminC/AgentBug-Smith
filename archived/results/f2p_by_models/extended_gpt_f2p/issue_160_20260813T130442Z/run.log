            "parameters": {
                "type": "object",
                "properties": {"arg1": {"type": "string"}},
                "required": ["arg1"],
            },
        }
    ]

    # Query the model with functions argument and response_format
    response = claude_model.query(
        chat_history,
        functions=functions,
        response_format={"type": "json"},
    )

    # The response should be a string (the dummy result from dummy_get_function)
    assert isinstance(response, str)
    assert response == "dummy result"

    # The func_call_history should contain the dummy_function call
    assert any(call["name"] == "dummy_function" for call in claude_model.func_call_history)


