def test_claude_model_tool_call_and_code_generation():
    """
    This test verifies that the ClaudeModel correctly processes tool calls and generates code output.
    It simulates a chat history that triggers a tool_use response and checks that the tool results
    are integrated back into the chat history and eventually a final code string is returned.
    """

    # Setup a ClaudeModel instance with a dummy API key and no real network calls
    model = ClaudeModel(api_key="dummy_api_key", model=None, temperature=0.0)

    # Patch the client's messages.create method to simulate tool_use and final text response
    class DummyFunc:
        def __init__(self, id, name, input, type_):
            self.id = id
            self.name = name
            self.input = input
            self.type = type_

    class DummyCompletion:
        def __init__(self, stop_reason, content):
            self.stop_reason = stop_reason
            self.content = content

    # We will simulate two calls:
    # 1) The first returns a tool_use type, which triggers the function call and adds tool result
    # 2) The second returns a final text output

    call_count = {"count": 0}

    def dummy_create(**kwargs):
        call_count["count"] += 1
        if call_count["count"] == 1:
            # Return a tool_use content list with one DummyFunc
            func = DummyFunc(
                id=str(uuid.uuid4()),
                name="create_file",
                input={"path": "test.py", "content": "print('hello')"},
                type_="tool_use"
            )
            return DummyCompletion(stop_reason="tool_use", content=[func])
        else:
            # Return final text content
            return DummyCompletion(stop_reason=None, content=[type("obj", (), {"text": "print('hello')\n"})()])

    # Monkeypatch the client's messages.create method
    model.client.messages.create = dummy_create

    # Prepare initial chat history with a system prompt and user message
    chat_history = [
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": "Create a python file that prints hello."}
    ]

    # We expect the model to call the tool, add the tool result into chat history,
    # and then return the final code string "print('hello')\n"
    output = model.query(chat_history, functions=[
        {
            "name": "create_file",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {"type": "string"},
                    "content": {"type": "string"}
                },
                "required": ["path", "content"]
            }
        }
    ])

    # The output should be the final code string
    assert isinstance(output, str)
    assert "print('hello')" in output

    # The chat history should now contain tool_use and tool_result messages appended
    roles = [msg["role"] for msg in chat_history]
    assert "assistant" in roles
    assert "user" in roles
    # Check that tool_use and tool_result types are present in content
    found_tool_use = any(
        msg.get("role") == "assistant" and isinstance(msg.get("content"), list) and
        any(item.get("type") == "tool_use" for item in msg["content"])
        for msg in chat_history
    )
    found_tool_result = any(
        msg.get("role") == "user" and isinstance(msg.get("content"), list) and
        any(item.get("type") == "tool_result" for item in msg["content"])
        for msg in chat_history
    )
    assert found_tool_use
    assert found_tool_result

    # Also test that the function call history recorded the call
    assert len(model.func_call_history) >= 1
    assert model.func_call_history[0]["name"] == "create_file"
    assert "path" in model.func_call_history[0]["arguments"]
    assert "content" in model.func_call_history[0]["arguments"]


