    coder = coder_module.CodeAgent(model=None, working_dir="testdir")

    # The sys_prompt should contain the corrected capabilities text after fix
    # Check that the prompt contains the phrase "Your can leverage your capabilities"
    assert "Your can leverage your capabilities" in coder.sys_prompt

    # Also check that it mentions create_directory and create_file functions
    assert "create_directory" in coder.sys_prompt
    assert "create_file" in coder.sys_prompt

