import re
from mle.agents import coder
from mle.model import ModelClaude


def test_coder_sys_prompt_contains_capabilities():
    # The system prompt should mention capabilities and functions correctly
    agent = coder.Coder(model=None, working_dir='test-claude')
    prompt = agent.sys_prompt
    # Check that the prompt mentions "Your can leverage your capabilities"
    assert "Your can leverage your capabilities" in prompt
    # Check that the functions create_directory and create_file are mentioned
    assert "create_directory" in prompt
    assert "create_file" in prompt


def test_claude_model_query_tool_use_flow(monkeypatch):
    # This test verifies that ModelClaude.query properly handles tool_use completions,
    # calls the function, and returns the final text output.

    # Setup a dummy function to be called by the model
    called = {}

    def dummy_function(**kwargs):
        called['args'] = kwargs
        return "dummy result"

    # Patch get_function to return dummy_function
    import mle.model as model_mod

    original_get_function = model_mod.get_function
    original_process_function_name = model_mod.process_function_name
    original_SEARCH_FUNCTIONS = model_mod.SEARCH_FUNCTIONS

    model_mod.get_function = lambda name: dummy_function
    model_mod.process_function_name = lambda name: "dummy_function"
    model_mod.SEARCH_FUNCTIONS = ["dummy_function"]

    # Patch the internal client.messages.create to simulate tool_use response
    class DummyFunc:
        def __init__(self):
            self.type = "tool_use"
            self.id = "func1"
            self.name = "dummy_function"
            self.input = {"param1": "value1"}

    class DummyCompletion:
        def __init__(self):
            self.stop_reason = "tool_use"
            self.content = [DummyFunc()]

    class DummyClientMessages:
        def create(self, **kwargs):
            return DummyCompletion()

    class DummyClient:
        def __init__(self):
            self.messages = DummyClientMessages()

    model = ModelClaude(api_key="dummy", model=None)
    model.client = DummyClient()

    chat_history = [
        {"role": "system", "content": "System prompt"},
        {"role": "user", "content": "User message"}
    ]

    # Call query and expect it to call dummy_function and return a string (recursive call)
    result = model.query(chat_history)

    # After query, dummy_function should have been called with the input from DummyFunc
    assert 'args' in called
    assert called['args'] == {"param1": "value1"}

    # The result should be a string (the final text output)
    assert isinstance(result, str)

    # Cleanup patches
    model_mod.get_function = original_get_function
    model_mod.process_function_name = original_process_function_name
    model_mod.SEARCH_FUNCTIONS = original_SEARCH_FUNCTIONS


def test_claude_model_query_no_tool_use_returns_text(monkeypatch):
    # Test that if stop_reason is not tool_use, query returns the text content

    class DummyCompletion:
        def __init__(self):
            self.stop_reason = "stop"
            self.content = [type("Content", (), {"text": "final output"})()]

    class DummyClientMessages:
        def create(self, **kwargs):
            return DummyCompletion()

    class DummyClient:
        def __init__(self):
            self.messages = DummyClientMessages()

    model = ModelClaude(api_key="dummy", model=None)
    model.client = DummyClient()

    chat_history = [
        {"role": "system", "content": "System prompt"},
        {"role": "user", "content": "User message"}
    ]

    result = model.query(chat_history)
    assert result == "final output"


def test_coder_sys_prompt_formatting():
    # The buggy code had extra blank lines and missing "Your can leverage your capabilities"
    # The fixed code should have the correct phrasing and no trailing blank lines before the list
    agent = coder.Coder(model=None, working_dir='test-claude')
    prompt = agent.sys_prompt

    # The prompt should start with "You are a programmer working on an Machine Learning task using Python."
    assert prompt.strip().startswith("You are a programmer working on an Machine Learning task using Python.")

    # The prompt should contain "Your can leverage your capabilities by using the specific functions listed below:"
    assert "Your can leverage your capabilities by using the specific functions listed below:" in prompt

    # The prompt should not contain multiple consecutive blank lines before the list
    # Check that there is no occurrence of more than one consecutive blank line before "1. Creating project structures"
    lines = prompt.splitlines()
    idx = None
    for i, line in enumerate(lines):
        if re.match(r"^\s*1\.", line):
            idx = i
            break
    assert idx is not None
    # Check that lines before idx do not have multiple blank lines in a row
    blank_line_count = 0
    for line in lines[:idx]:
        if line.strip() == "":
            blank_line_count += 1
        else:
            blank_line_count = 0
        assert blank_line_count < 2


