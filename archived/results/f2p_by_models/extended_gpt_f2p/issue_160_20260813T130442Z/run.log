def test_claude_model_function_schema_mapping():
    """
    Test that ClaudeModel maps 'parameters' to 'input_schema' in the functions list before sending to client.
    """
    from mle.model import ClaudeModel

    model = ClaudeModel(api_key="dummy_api_key", model=None)

    # Patch the client's messages.create to capture the tools argument
    captured_tools = {}

    def dummy_create(**kwargs):
        nonlocal captured_tools
        captured_tools = kwargs.get("tools", [])
        # Return a dummy final text response
        return type("DummyCompletion", (), {"stop_reason": None, "content": [type("obj", (), {"text": "done"})()]})()

    model.client.messages.create = dummy_create

    functions = [
        {
            "name": "func1",
            "parameters": {"type": "object", "properties": {"arg1": {"type": "string"}}}
        }
    ]

    model.query([], functions=functions)

    # After query, the tools passed to client should have 'input_schema' instead of 'parameters'
    assert len(captured_tools) == 1
    tool = captured_tools[0]
    assert "input_schema" in tool
    assert "parameters" not in tool
    assert tool["input_schema"] == {"type": "object", "properties": {"arg1": {"type": "string"}}}


def test_claude_model_response_format_in_system_prompt():
