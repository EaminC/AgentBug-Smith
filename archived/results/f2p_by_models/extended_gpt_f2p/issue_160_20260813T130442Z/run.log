        # The internal client calls will be mocked by the repo's test environment or CI
        model = ModelClaude(api_key="dummy_api_key", model="claude-v1")

        # Initialize the CoderAgent with the model and working directory
        agent = CoderAgent(model=model, working_dir=temp_dir)

        # Define a simple user request to create a test project with one Python file
        user_request = "Create a project called test-claude with a main.py file that prints 'Hello, World!'"

        # Run the agent to generate code and project structure
        code_output = agent.plan_and_code(user_request)

        # Assert that the output code is not empty or None
