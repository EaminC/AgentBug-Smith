def test_generate_code_for_test_claude_project(tmp_path):
    """
    This test simulates starting a project called 'test-claude' and verifies that the planner
    executes correctly and that code is generated properly.

    On the buggy codebase, this test should fail because the code generation is broken
    (no code is generated and commands are incorrect).

    After applying the fix, the test should pass.
    """

    # Setup a dummy model client that mocks network calls to avoid external dependencies
    class DummyModelClient:
        def __init__(self):
            self.messages = self

        def create(self, **kwargs):
            # Simulate a response that triggers a tool use and then returns code generation
            if kwargs.get("tools"):
                # Simulate a tool_use stop_reason to trigger recursive calls
                class DummyFunc:
                    def __init__(self):
                        self.type = "tool_use"
                        self.id = str(uuid.uuid4())
                        self.name = "create_file"
                        self.input = {"path": "test_foo.py", "content": "print('hello world')"}
                return type(
                    "DummyCompletion",
                    (),
                    {
                        "stop_reason": "tool_use",
                        "content": [DummyFunc()],
                    },
                )()
            else:
                # Final response with generated code text
                return type(
                    "DummyCompletion",
                    (),
                    {
                        "stop_reason": None,
                        "content": [type("TextContent", (), {"text": "print('hello world')"})()],
                    },
                )()

        def stream(self, **kwargs):
            # Not used in this test
            pass

    # Patch the Model class to use the DummyModelClient internally
    class DummyModel(Model):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, **kwargs)
            self.client = DummyModelClient()

    # Instantiate dummy model and agents
    model = DummyModel(api_key="dummy", model="dummy-model")

    # Create a planner agent that uses the dummy model
    planner = PlannerAgent(model=model)

    # Create a coder agent that uses the dummy model
    coder = Coder(model=model, working_dir=str(tmp_path))

    # Create a baseline workflow that uses the planner and coder
    workflow = BaselineWorkflow(planner=planner, coder=coder)

    # Define a simple project requirement that triggers code generation
    project_name = "test-claude"
    requirements = f"Create a project called {project_name} with a simple Python script."

    # Run the workflow to generate code
    result = workflow.run(requirements=requirements, working_dir=str(tmp_path))

    # Check that the planner executed (planner output should mention project_name)
    assert project_name in result, "Planner did not execute correctly or missing project name in output."

    # Check that the code file was created in the working directory
    generated_files = list(tmp_path.glob("test_foo.py"))
    assert len(generated_files) == 1, "Expected generated code file 'test_foo.py' not found."

    # Check that the generated file contains the expected content
    content = generated_files[0].read_text()
    assert re.search(r"print\(.+hello world.+\)", content), "Generated code content is incorrect or missing."

    # Check that the workflow result includes the generated code snippet
    assert "print('hello world')" in result, "Generated code snippet missing in workflow result."[0m
