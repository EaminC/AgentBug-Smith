index 7855938..97bed15 100644
--- a/mle/cli.py
+++ b/mle/cli.py
@@ -353,3 +353,70 @@ def integrate(reset):
                 "token": pickle.dumps(token, fix_imports=False),
             }
             write_config(config)
+
