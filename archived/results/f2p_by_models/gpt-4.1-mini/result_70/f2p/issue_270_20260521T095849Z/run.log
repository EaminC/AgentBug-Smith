[32mimport os
import shutil
import tempfile
import pytest
from click.testing import CliRunner
from mle import cli
from mle.utils.memory import LanceDBMemory


@pytest.fixture(scope="module")
def temp_dir():
    # Create a temporary directory with some python files for testing
    dirpath = tempfile.mkdtemp(prefix="mle_memory_test_")
    file1 = os.path.join(dirpath, "file1.py")
    file2 = os.path.join(dirpath, "file2.py")
    file3 = os.path.join(dirpath, "file3.txt")  # non-py file, should be ignored by list_files filter

    with open(file1, "w") as f:
        f.write("print('hello from file1')\n")

    with open(file2, "w") as f:
        f.write("print('hello from file2')\n")

    with open(file3, "w") as f:
        f.write("this is a text file and should be ignored\n")

    yield dirpath

    # Cleanup after tests
    shutil.rmtree(dirpath)


def test_memory_add_rm_update(temp_dir):
    runner = CliRunner()

    # Use the temp_dir as working directory for the test
    # We will invoke the CLI commands with --add, --rm, --update options

    # Step 1: Add the directory to memory
    result_add = runner.invoke(cli.memory, ["--add", temp_dir], catch_exceptions=False)
    assert result_add.exit_code == 0, f"Add command failed: {result_add.output}"

    # Verify that memory contains entries for file1.py and file2.py but not file3.txt
    memory = LanceDBMemory(temp_dir)
    table_name = "mle_chat_" + temp_dir.split(os.sep)[-1]

    keys_after_add = memory.list_all_keys(table_name=table_name)
    assert keys_after_add, "Memory keys should not be empty after add"

    # Check metadata for files added
    records_file1 = memory.get_by_metadata("file", os.path.join(temp_dir, "file1.py"), table_name=table_name)
    records_file2 = memory.get_by_metadata("file", os.path.join(temp_dir, "file2.py"), table_name=table_name)
    records_file3 = memory.get_by_metadata("file", os.path.join(temp_dir, "file3.txt"), table_name=table_name)

    assert records_file1, "file1.py chunks should be present in memory after add"
    assert records_file2, "file2.py chunks should be present in memory after add"
    assert not records_file3, "file3.txt should NOT be present in memory after add (filtered by *.py)"

    # Step 2: Remove file1.py from memory
    result_rm = runner.invoke(cli.memory, ["--rm", os.path.join(temp_dir, "file1.py")], catch_exceptions=False)
    assert result_rm.exit_code == 0, f"Remove command failed: {result_rm.output}"

    records_file1_after_rm = memory.get_by_metadata("file", os.path.join(temp_dir, "file1.py"), table_name=table_name)
    assert not records_file1_after_rm, "file1.py chunks should be removed from memory after rm"

    # file2.py should still be present
    records_file2_after_rm = memory.get_by_metadata("file", os.path.join(temp_dir, "file2.py"), table_name=table_name)
    assert records_file2_after_rm, "file2.py chunks should remain after removing file1.py"

    # Step 3: Update file2.py (simulate update by invoking --update)
    # Modify file2.py content
    with open(os.path.join(temp_dir, "file2.py"), "w") as f:
        f.write("print('hello from updated file2')\n")

    result_update = runner.invoke(cli.memory, ["--update", os.path.join(temp_dir, "file2.py")], catch_exceptions=False)
    assert result_update.exit_code == 0, f"Update command failed: {result_update.output}"

    # After update, file2.py chunks should be present and reflect new content
    records_file2_after_update = memory.get_by_metadata("file", os.path.join(temp_dir, "file2.py"), table_name=table_name)
    assert records_file2_after_update, "file2.py chunks should be present after update"

    # Check that the updated content is reflected in chunks text
    chunk_texts = [rec["text"] for rec in records_file2_after_update]
    assert any("updated file2" in text for text in chunk_texts), "Updated content not found in file2.py chunks"


