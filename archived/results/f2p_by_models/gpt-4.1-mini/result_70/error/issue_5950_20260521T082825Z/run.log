# Use official Node.js 20 slim image for TypeScript environment
FROM node:20-slim

# Set working directory
WORKDIR /app

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly_key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set environment variables to configure Forge API
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY="forge-key" \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN="forge-key"

# Copy package.json and lockfiles if they exist for dependency installation
COPY package.json ./
RUN if [ -f package-lock.json ]; then cp package-lock.json ./; fi
RUN if [ -f yarn.lock ]; then cp yarn.lock ./; fi
RUN if [ -f pnpm-lock.yaml ]; then cp pnpm-lock.yaml ./; fi

# Install dependencies with npm ci or pnpm install and fix peer dependency issues by passing --legacy-peer-deps when using npm
RUN if [ -f pnpm-lock.yaml ]; then \
      npm install -g pnpm && pnpm install; \
    elif [ -f package-lock.json ]; then \
      npm ci --legacy-peer-deps; \
    elif [ -f yarn.lock ]; then \
      npm install --legacy-peer-deps; \
    else \
      npm install --legacy-peer-deps; \
    fi

# Copy all the source files
COPY . .

# Build the project if build script exists
RUN if npm run | grep -q build; then npm run build || true; fi

# Default command to start bash shell
CMD ["/bin/bash"]

# branch: node/package.json with fixed dependency installation and Forge API env setup
