# Set working directory
WORKDIR /app

# Copy entire repository into container
COPY . .

# Install minimal system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends curl bash && rm -rf /var/lib/apt/lists/*

# Detect package manager and install dependencies
RUN if [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm && \
      pnpm install && \
      pnpm run build || true; \
    elif [ -f "package-lock.json" ]; then \
      npm ci && \
      npm run build || true; \
    else \
      npm install && \
      npm run build || true; \
    fi

# Install standard JavaScript testing tools to ensure tests can run
RUN if [ -f "pnpm-lock.yaml" ]; then \
      pnpm add --no-save jest mocha || true; \
    else \
      npm install --no-save jest mocha || true; \
    fi

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV FORGE_API_KEY=forge-key

# Preflight check for node and jest availability
RUN node -e "require('jest'); console.log('preflight ok')" || true

# Default to bash for interactive shell
CMD ["/bin/bash"]
