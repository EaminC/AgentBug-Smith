ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"

# Set working directory
WORKDIR /app

# Copy entire repository into the container
COPY . .

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends curl bash && rm -rf /var/lib/apt/lists/*

# Install project dependencies using npm (since pnpm latest requires Node >=22.13 and current base is 20)
RUN if [ -f "package-lock.json" ]; then \
      npm ci; \
    else \
      npm install; \
    fi

# Ensure standard JS testing frameworks are installed if not already
RUN npm install --no-save jest mocha || true

# Preflight test to confirm node and jest module
RUN node -e "require('jest'); console.log('preflight ok')" || true

# Default to bash for interactive shell
CMD ["/bin/bash"]
