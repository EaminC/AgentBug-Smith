    && apt-get install -y --no-install-recommends curl bash \
    && rm -rf /var/lib/apt/lists/*

# Install project dependencies using pnpm if pnpm-lock.yaml exists, otherwise fallback to npm install
RUN if [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm@latest \
      && pnpm install --frozen-lockfile; \
    elif [ -f "package-lock.json" ]; then \
      npm ci; \
    else \
      npm install; \
    fi

# Ensure standard JS testing frameworks are installed if not already
RUN npm install --no-save jest mocha || true

# Preflight test to confirm node and jest module
RUN node -e "require('jest'); console.log('preflight ok')" || true

# Default to bash for interactive shell
CMD ["/bin/bash"]
