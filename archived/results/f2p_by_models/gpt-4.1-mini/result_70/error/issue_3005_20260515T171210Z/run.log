[32mFROM node:20-alpine AS test_builder

WORKDIR /app

# Copy entire repository
COPY . .

# Install pnpm if not present, then install dependencies with dev
RUN apk add --no-cache curl bash && \
    if ! command -v pnpm >/dev/null 2>&1; then \
      npm install -g pnpm@10.12.4; \
    fi && \
    pnpm install --frozen-lockfile --strict-peer-dependencies=false

# Preflight check to ensure node_modules and core packages are installed
RUN node -e "console.log('preflight ok')"

# Run tests using pnpm in the root which should run the workspace tests including clients/python
RUN pnpm run ui:test

# Build stage for production with only production dependencies
FROM node:20-alpine AS runtime

WORKDIR /app

COPY . .

# Install pnpm if not present, then install only production dependencies
RUN apk add --no-cache curl bash && \
    if ! command -v pnpm >/dev/null 2>&1; then \
      npm install -g pnpm@10.12.4; \
    fi && \
    pnpm install --frozen-lockfile --prod --strict-peer-dependencies=false

# Set required environment variables for Forge
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=${FORGE_API_KEY} \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Final command as specified by instructions
CMD ["/bin/bash"][0m
