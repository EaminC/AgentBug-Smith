# Set working directory inside the frontend src where package.json exists
WORKDIR /app/src/frontend

# Copy full repository into container
COPY . .

# Install dependencies with yarn, preferred since yarn.lock exists
RUN if [ -f "yarn.lock" ]; then \
      yarn install --frozen-lockfile; \
    else \
      echo "No yarn.lock found, skipping yarn install"; \
    fi

# Install essential JS test tools to ensure testing availability
RUN yarn add --dev jest mocha || true

# Run build script if present
RUN if yarn run | grep -q "build"; then yarn build || true; fi

# Set default command to bash shell for test harness
CMD ["/bin/bash"]
