      npm ci; \
    elif [ -f "yarn.lock" ]; then \
      yarn install; \
    elif [ -f "package.json" ]; then \
      npm install; \
    else \
      echo "No recognized package manager lockfile found, skipping install"; \
    fi

# Explicitly install standard test tooling (jest and mocha) to ensure test compatibility
RUN npm install --no-save jest mocha || true

# Preflight check to verify jest module is installed and working
RUN node -e "require('jest'); console.log('preflight ok')" || true

# Default command to bash shell as required by test harness
CMD ["/bin/bash"]

