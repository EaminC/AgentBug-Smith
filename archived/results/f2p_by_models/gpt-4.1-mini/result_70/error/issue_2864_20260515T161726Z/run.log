FROM node:20-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly_key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set working directory to the root of the repository
WORKDIR /app

# Copy all files to the container
COPY . .

# Set environment variables for Forge API compatibility
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly_key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"

# Install dependencies based on available package manager files
# If yarn.lock exists, use yarn, else if package-lock.json use npm ci, else npm install
RUN if [ -f "yarn.lock" ]; then \
      yarn install; \
    elif [ -f "package-lock.json" ]; then \
      npm ci; \
    elif [ -f "package.json" ]; then \
      npm install; \
    else \
      echo "No recognized package manager lockfile found, skipping install"; \
    fi

# Install test tooling explicitly
RUN npm install --no-save jest mocha || true

# Preflight test to verify jest is installed and working
RUN node -e "require('jest'); console.log('preflight ok')" || true

# Set default command to bash shell for test harness compatibility
CMD ["/bin/bash"]

