[32mFROM node:21-alpine AS test_builder

WORKDIR /app

# Copy entire repository to ensure all tests and scripts are present
COPY . .

# Install dependencies and test tooling
RUN if [ -f "src/frontend/package-lock.json" ]; then \
        npm ci --prefix src/frontend; \
    elif [ -f "src/frontend/package.json" ]; then \
        npm install --prefix src/frontend; \
    else \
        echo "No package.json found in src/frontend, skipping npm install"; \
    fi

# Install Playwright browsers if Playwright is used (implied by test workflow)
RUN if [ -f "src/frontend/package.json" ] && grep -q "@playwright/test" src/frontend/package.json; then \
        npx --prefix src/frontend playwright install --with-deps; \
        npx --prefix src/frontend playwright install-deps; \
    else \
        echo "Playwright not detected, skipping browser install"; \
    fi

# Run frontend tests using Playwright test runner
RUN if [ -f "src/frontend/package.json" ]; then \
        npx --prefix src/frontend playwright test --project=chromium; \
    else \
        echo "No frontend tests to run"; \
    fi

# Assumption: Backend is Python-based (from pyproject and Makefile), so no backend test in this JS stage

# Preflight: check Node version and npm presence
RUN node --version && npm --version

# Set required Forge environment variables for all stages
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Final minimal runtime image for frontend
FROM node:21-alpine AS runtime

WORKDIR /app

COPY --from=test_builder /app/src/frontend/package.json ./src/frontend/package.json
COPY --from=test_builder /app/src/frontend/package-lock.json ./src/frontend/package-lock.json

# Install only production dependencies for frontend
RUN if [ -f "src/frontend/package-lock.json" ]; then \
        npm ci --only=production --prefix src/frontend; \
    elif [ -f "src/frontend/package.json" ]; then \
        npm install --only=production --prefix src/frontend; \
    else \
        echo "No package.json found in src/frontend, skipping npm install"; \
    fi

COPY --from=test_builder /app/src/frontend ./src/frontend

# Set required Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Expose default frontend port if any standard port is implied
# Assumption: Frontend dev server runs on 3000 per Makefile (run_frontend target)
EXPOSE 3000

# Final command is bash as required
CMD ["/bin/bash"][0m
