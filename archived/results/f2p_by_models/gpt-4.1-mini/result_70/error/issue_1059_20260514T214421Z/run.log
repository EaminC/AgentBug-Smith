[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly_key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set environment variables for Forge API and Anthropic compatibility
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1" \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co" \
    ANTHROPIC_AUTH_TOKEN=forge-key \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Copy entire repository
COPY . .

# Install system dependencies needed for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc python3-dev libffi-dev libssl-dev \
 && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Workaround for faiss_cpu version mismatch: Install a compatible faiss_cpu version manually
# Then install remaining requirements excluding faiss_cpu with a requirements update (if available)
# We'll install faiss_cpu 1.13.2 explicitly which is available.
RUN pip install --no-cache-dir faiss-cpu==1.13.2

# Install other requirements except faiss_cpu
RUN if [ -f requirements.txt ]; then \
    # Use grep to exclude faiss_cpu line temporarily
    grep -v '^faiss_cpu==' requirements.txt > requirements_no_faiss.txt; \
    pip install --no-cache-dir -r requirements_no_faiss.txt; \
    rm requirements_no_faiss.txt; \
    fi

# Install the repository itself plus testing dependencies
RUN pip install -e . pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout

# Preflight check that packages are importable
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

# branch: python/requirements.txt
# Base image: python:3.12-slim
# Explicitly pin compatible faiss-cpu version to avoid build failure
# Install all other requirements except faiss_cpu
# Install repo in editable mode with test deps
# Set environment variables for Forge API compatibility
# Working directory set to /app with full source copied
# Final command is /bin/bash for test harness
