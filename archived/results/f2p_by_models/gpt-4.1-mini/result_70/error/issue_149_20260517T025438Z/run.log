ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set working directory to repo root
WORKDIR /app

# Copy all repository files to the container
COPY . .

# Set Forge API environment variables to use Forge instead of OpenAI
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key
ENV FORGE_API_KEY="forge-key"

# Upgrade pip, setuptools and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install system dependencies for compiling some Python packages if needed
RUN apt-get update && apt-get install -y gcc libffi-dev python3-dev && rm -rf /var/lib/apt/lists/*

# Install python dependencies if requirements.txt exists
RUN if [ -f "python/requirements.txt" ]; then pip install -r python/requirements.txt; fi

# Install the package itself in editable mode for local import
RUN pip install -e ./python

# Install test requirements explicitly to ensure test framework availability
RUN pip install pytest pytest-mock pytest-xdist pytest-timeout anyio "setuptools<=81.0.0" litellm

# Preflight check to validate installation
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default shell CMD required by test harness
CMD ["/bin/bash"]

