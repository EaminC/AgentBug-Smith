    FORGE_API_KEY="forge-key"

WORKDIR /app

# Copy the entire repository into the container
COPY . .

# Install system dependencies required for building Python packages and runtime
RUN apt-get update && apt-get install -y \
    gcc \
    libffi-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies if requirements.txt exists, else skip
RUN if [ -f "python/requirements.txt" ]; then \
    pip install -r python/requirements.txt; \
fi

# Install the repo in editable mode to enable test imports
RUN pip install -e ./python

# Install mandatory Python test dependencies for robustness
RUN pip install pytest pytest-mock pytest-xdist pytest-timeout anyio "setuptools<=81.0.0" litellm

# Run a preflight test to confirm packages and pytest are available
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default to bash shell on container start
CMD ["/bin/bash"]

