      npm install -g pnpm && pnpm install; \
    else \
      npm install; \
    fi

# Build the project if build script exists
RUN if npm run | grep -q "build"; then npm run build || true; fi

# Install test dependencies locally (jest and mocha) if not installed globally
RUN npm install --no-save jest mocha || true

# Preflight check for jest to verify installation
RUN node -e "require('jest'); console.log('preflight ok')" || true

# Default command to bash for test harness requirements
CMD ["/bin/bash"]

