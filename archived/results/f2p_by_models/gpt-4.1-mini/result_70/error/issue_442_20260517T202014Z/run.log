[32mFROM python:3.12-slim

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=forge-key \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

# Install system dependencies needed for building Python packages and extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libffi-dev libssl-dev python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and setuptools pinned version wheel
RUN python -m pip install --upgrade pip setuptools==81.0.0 wheel

# Copy entire repository into container
COPY . .

# Install poetry and dependencies, fallback to requirements.txt if no poetry.lock
RUN python -m pip install poetry && \
    poetry config virtualenvs.create false && \
    poetry install --no-interaction --no-ansi || \
    (if [ -f requirements.txt ]; then python -m pip install -r requirements.txt; fi)

# Install the repo and test dependencies
RUN python -m pip install -e . && \
    python -m pip install pytest pytest-mock pytest-xdist pytest-timeout litellm

# Preflight to verify installation
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

