    elif [ -f "yarn.lock" ]; then \
      yarn install && yarn build || true; \
    elif [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm && pnpm install && pnpm run build || true; \
    else \
      npm install && npm run build || true; \
    fi

# Install testing dependencies explicitly
