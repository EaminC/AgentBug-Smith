[32m# Stage 1: Builder - install dependencies and build app
FROM node:22-slim AS builder

ARG USE_CN_MIRROR

ENV DEBIAN_FRONTEND=noninteractive
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

WORKDIR /app

COPY package.json ./
COPY .npmrc ./

RUN if [ "${USE_CN_MIRROR:-false}" = "true" ]; then \
      npm config set registry "https://registry.npmmirror.com/" && \
      export SENTRYCLI_CDNURL="https://npmmirror.com/mirrors/sentry-cli" && \
      echo 'canvas_binary_host_mirror=https://npmmirror.com/mirrors/canvas' >> .npmrc; \
    fi && \
    export COREPACK_NPM_REGISTRY=$(npm config get registry | sed 's/\/$//') && \
    corepack enable && \
    corepack prepare pnpm@latest --activate && \
    pnpm install && \
    # Add sharp dependencies to separate folder to optimize production image size
    mkdir -p /deps && \
    pnpm add sharp --prefix /deps

COPY . .

RUN npm run build:docker

# Stage 2: Application runtime image
FROM busybox:latest AS app

COPY --from=builder /distroless/ /

COPY --from=builder /app/public /app/public
COPY --from=builder /app/.next/standalone /app/
COPY --from=builder /app/.next/static /app/.next/static
COPY --from=builder /deps/node_modules/.pnpm /app/node_modules/.pnpm
COPY --from=builder /app/scripts/serverLauncher/startServer.js /app/startServer.js

RUN addgroup -S -g 1001 nodejs && \
    adduser -D -G nodejs -H -S -h /app -u 1001 nextjs && \
    chown -R nextjs:nodejs /app /etc/proxychains4.conf

USER nextjs

EXPOSE 3210/tcp

ENTRYPOINT ["/bin/node"]

CMD ["/app/startServer.js"][0m
