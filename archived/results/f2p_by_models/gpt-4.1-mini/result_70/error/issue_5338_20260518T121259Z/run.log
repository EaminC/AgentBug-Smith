# Build if build script present
RUN if npm run | grep -q build; then npm run build || true; fi

# Install test dependencies explicitly to avoid failures
RUN npm install --no-save jest mocha @types/jest @types/node || true

# Preflight: verify jest is available
RUN node -e "require('jest'); console.log('preflight ok')" || true

CMD ["/bin/bash"]
