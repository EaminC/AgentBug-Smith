ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set working directory
WORKDIR /app

# Copy the entire repository
COPY . .

# Install dependencies based on detected lockfiles, with build
RUN if [ -f package-lock.json ]; then \
      npm ci && npm run build; \
    elif [ -f yarn.lock ]; then \
      yarn install && yarn build; \
    elif [ -f pnpm-lock.yaml ]; then \
      npm install -g pnpm && pnpm install && pnpm run build; \
    else \
      npm install && npm run build; \
    fi

# Install testing dependencies explicitly
RUN npm install --no-save jest @types/jest @types/node

# Preflight check to verify jest installation
RUN node -e "require('jest'); console.log('preflight ok')"

CMD ["/bin/bash"]
