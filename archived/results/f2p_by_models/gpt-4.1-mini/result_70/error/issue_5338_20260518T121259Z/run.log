      yarn install && yarn build; \
    elif [ -f pnpm-lock.yaml ]; then \
      npm install -g pnpm && pnpm install && pnpm run build; \
    else \
      npm install --legacy-peer-deps && npm run build; \
    fi

# Install standard TypeScript testing dependencies
RUN npm install --no-save jest @types/jest @types/node ts-node typescript

# Preflight: verify jest is installed
RUN node -e "require('jest'); console.log('preflight ok')"

# Default command to keep container open at bash prompt
CMD ["/bin/bash"]
