ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly_key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set working directory
WORKDIR /app

# Copy entire repository into the container
COPY . .

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Install dependencies robustly using detected package manager and lockfiles
RUN if [ -f "package.json" ]; then \
      if [ -f "pnpm-lock.yaml" ]; then \
        npm install -g pnpm && pnpm install; \
      elif [ -f "package-lock.json" ]; then \
        npm ci; \
      else \
        npm install; \
      fi; \
    fi

# Ensure test tooling is installed (jest and mocha) in case not included
RUN npm install --no-save jest mocha || true

# Preflight check for runtime modules
RUN node -e "require('jest'); require('mocha'); console.log('preflight ok')" || true

# Default command required by test harness
CMD ["/bin/bash"]


