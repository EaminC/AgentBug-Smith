FROM node:22.9.0-alpine AS test_builder

WORKDIR /app

# Copy entire repo (critical per instructions)
COPY . .

# Install all dependencies and devDependencies
RUN if [ -f "package.json" ]; then \
      if [ -f "pnpm-lock.yaml" ]; then \
        apk add --no-cache curl && \
        curl -f https://get.pnpm.io/v6.16.js | node - add --global pnpm && \
        pnpm install; \
      elif [ -f "yarn.lock" ]; then \
        yarn install; \
      elif [ -f "package-lock.json" ]; then \
        npm ci; \
      else \
        npm install; \
      fi; \
    fi

# Preflight check: ensure test framework installed and can run
RUN node -e "try {require('eslint'); console.log('preflight ok')} catch(e) {console.error('eslint not found'); process.exit(1)}"

# Run tests to validate; fallback to npm test if present
RUN if [ -f "package.json" ] && grep -q "\"test\":" package.json; then npm test; else echo "No test script found"; fi

# Production stage
FROM node:22.9.0-alpine AS runtime

WORKDIR /app

COPY . .

# Install only production dependencies
RUN if [ -f "package.json" ]; then \
      if [ -f "pnpm-lock.yaml" ]; then \
        apk add --no-cache curl && \
        curl -f https://get.pnpm.io/v6.16.js | node - add --global pnpm && \
        pnpm install --prod; \
      elif [ -f "yarn.lock" ]; then \
        yarn install --production; \
      elif [ -f "package-lock.json" ]; then \
        npm ci --only=production; \
      else \
        npm install --production; \
      fi; \
    fi

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# As no explicit main entrypoint or start script was detected in package.json, default to bash
CMD ["/bin/bash"][0m
