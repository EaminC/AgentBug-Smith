ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Install dependencies based on lockfiles
RUN if [ -f "pnpm-lock.yaml" ]; then \
      npm install -g pnpm && pnpm install; \
    elif [ -f "package-lock.json" ]; then \
      npm ci; \
    elif [ -f "package.json" ]; then \
      npm install; \
    fi

# Install standard JS test tooling if not included
RUN npm install --no-save jest mocha || true

# Preflight check for runtime modules
RUN node -e "require('jest'); require('mocha'); console.log('preflight ok')" || true

# Default command required by test harness
CMD ["/bin/bash"]
