        ai_instance = AI(model_name="gpt-4-turbo", temperature=0.1, streaming=False)

        # Prepare a dummy image message input to simulate image directory usage
        # The LangChain ChatModel expects messages as objects, not plain dicts.
        # We import the required message class to construct messages properly.
        from langchain.schema import SystemMessage, HumanMessage, AIMessage

        messages = [
            SystemMessage(content="You are a helpful assistant."),
            HumanMessage(content="Analyze this image."),
            # Simulate an image message by adding a custom attribute or content
            # Since LangChain does not have a built-in image message type,
            # we simulate by including image info in content or metadata.
            # For test purposes, we add a message with image URL in content.
            HumanMessage(content="![image](file://dummy/path/to/image.png)"),
        ]

        # Call the llm method (which calls openai.chat.completions.create internally)
        response = ai_instance.llm(messages=messages)

        # Assert that the mock was called once
        mock_create.assert_called_once()

        # Retrieve the call arguments to verify image content presence
        called_args, called_kwargs = mock_create.call_args

        # The messages sent to openai should include the image content string
        sent_messages = called_kwargs.get("messages", [])
        # Check that at least one message content contains the image URL string
        image_message_found = any(
            "file://dummy/path/to/image.png" in m.get("content", "") for m in sent_messages
        )
        self.assertTrue(
            image_message_found,
            msg="Image message with image URL was not sent to the model.",
        )


