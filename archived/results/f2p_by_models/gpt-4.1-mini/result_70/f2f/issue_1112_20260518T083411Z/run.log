            SystemMessage(content="You are a helpful assistant."),
            HumanMessage(content="Analyze the images in the directory."),
        ]

        # The AI class uses self.llm which is a ChatOpenAI instance from langchain
        # The ChatOpenAI class supports __call__ with messages as list of BaseMessage
        # Call the llm with messages and check the response content
        response = ai_instance.llm(messages=messages)

        # The mock returns dummy response, so check that response is as mocked
        self.assertTrue(
            hasattr(response, "generations"),
            msg="Response should have 'generations' attribute.",
        )
        # Check that the content of the first generation is the dummy response
        first_gen = response.generations[0][0]
        self.assertEqual(
            first_gen.text,
            "dummy response",
            msg="The response text should be the dummy response from the mock.",
        )[0m
