    @patch("gpt_engineer.core.ai.openai.chat.completions.create")
    def test_image_directory_usage_with_gpt4_turbo(self, mock_create):
        """
        Test that when using the --image_directory flag with model 'gpt-4-turbo',
        the images are included in the messages sent to the model.
        On the buggy codebase, images are ignored, so the test should fail.
        After the fix, images are included, and the test should pass.
        """
        # Setup mock to simulate a successful chat completion response
        mock_create.return_value = MagicMock(
            choices=[MagicMock(message={"content": "dummy response"})]
        )
    
        # Create a dummy AI instance with vision enabled
        ai_instance = AI(model_name="gpt-4-turbo", temperature=0.1, streaming=False)
    
        # Prepare dummy image directory path and dummy image file
        dummy_image_dir = "dummy_image_dir"
        dummy_image_path = os.path.join(dummy_image_dir, "image.png")
    
        # Create dummy directory and file for test (in-memory simulation)
        # Since we cannot write files, we will patch os.listdir and open to simulate
        with patch("os.listdir", return_value=["image.png"]), \
             patch("builtins.open", new_callable=MagicMock):
    
            # Compose messages including image markdown referencing the dummy image path
            messages = [
                {"role": "system", "content": "You are a helpful assistant."},
