import unittest
from unittest.mock import patch, MagicMock

from gpt_engineer.core.ai import AI


class TestVisionSupportForGPT4Turbo(unittest.TestCase):
    @patch("gpt_engineer.core.ai.openai.chat.completions.create")
    def test_vision_flag_enabled_for_gpt4_turbo(self, mock_create):
        """
        Test that the AI class correctly enables vision support for model 'gpt-4-turbo'.
        On the buggy codebase, this test should fail because vision is not enabled for gpt-4-turbo,
        so the vision attribute is False.
        After the fix, vision support is enabled for gpt-4-turbo, and the test should pass.
        """
        # Setup mock to simulate a successful chat completion response
        mock_create.return_value = MagicMock(
            choices=[MagicMock(message={"content": "dummy response"})]
        )

        # Instantiate AI with model_name 'gpt-4-turbo'
        ai_instance = AI(model_name="gpt-4-turbo", temperature=0.1, streaming=False)

        # Assert that vision flag is True for gpt-4-turbo model after fix
        self.assertTrue(
            ai_instance.vision,
            msg="Vision flag should be True for model 'gpt-4-turbo', but it is False.",
        )

    @patch("gpt_engineer.core.ai.openai.chat.completions.create")
    def test_image_directory_usage_with_gpt4_turbo(self, mock_create):
        """
        Test that when using the --image_directory flag with model 'gpt-4-turbo',
        the images are included in the messages sent to the model.
        On the buggy codebase, images are ignored, so the test should fail.
        After the fix, images are included, and the test should pass.
        """
        # Setup mock to simulate a successful chat completion response
        mock_create.return_value = MagicMock(
            choices=[MagicMock(message={"content": "dummy response"})]
        )

        # Create a dummy AI instance with vision enabled
        ai_instance = AI(model_name="gpt-4-turbo", temperature=0.1, streaming=False)

        # Prepare dummy image directory path and dummy image file
        dummy_image_dir = "dummy_image_dir"
        dummy_image_path = os.path.join(dummy_image_dir, "image.png")

        # Patch os.listdir and open to simulate image directory and file presence
        with patch("os.listdir", return_value=["image.png"]), \
             patch("builtins.open", new_callable=MagicMock):

            # Import LangChain message classes here to avoid import issues if not installed
            from langchain.schema import SystemMessage, HumanMessage

            messages = [
                SystemMessage(content="You are a helpful assistant."),
                HumanMessage(content=f"![image](file://{dummy_image_path})"),
            ]

            # Call the llm method (which calls openai.chat.completions.create internally)
            response = ai_instance.llm(messages=messages)

            # The mocked create method returns a dummy response, so check that it was called
            mock_create.assert_called_once()

            # Check that the response contains the dummy content
            self.assertEqual(
                response.generations[0][0].text,
                "dummy response",
                msg="The llm response text should be 'dummy response'.",
            )


