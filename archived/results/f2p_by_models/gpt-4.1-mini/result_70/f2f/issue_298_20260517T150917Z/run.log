        self.mock_client_class.return_value = self.mock_client_instance
        self.mock_memory_class.return_value = self.mock_memory_instance

    def test_add_calls_client_add_with_correct_params(self):
        mem = memory.Mem0(agent_id="agent1", token="token123")
        messages = [{"role": "user", "content": "Hello"}]
        metadata = {"key": "value"}

        mem.add(messages, metadata=metadata, prompt="prompt1", infer=True)

        self.mock_client_instance.add.assert_called_once_with(
            messages,
            metadata=metadata,
            prompt="prompt1",
            infer=True,
            agent_id="agent1",
        )

    def test_add_without_token_uses_local_memory(self):
        mem = memory.Mem0(agent_id="agent2", token=None, cfg={"some": "config"})
        messages = [{"role": "system", "content": "Init"}]

        mem.add(messages)

        self.mock_memory_instance.add.assert_called_once_with(
            messages,
            metadata=None,
            prompt=None,
            infer=False,
            agent_id="agent2",
        )

    def test_query_calls_client_search_with_correct_params(self):
        mem = memory.Mem0(agent_id="agent3", token="token456")
        self.mock_client_instance.search.return_value = ["result1", "result2"]

        # Call query and capture return
        result = mem.query("search text", n_results=3)

        self.mock_client_instance.search.assert_called_once_with(
            agent_id="agent3",
            query_text="search text",
            limit=3,
        )
        # The buggy code does not return the search result, so result is None before fix
        # After fix, result should be the return value of search
        # So here we assert result equals the mock return value to fail on buggy code
        self.assertEqual(result, ["result1", "result2"])

    def test_get_all_calls_client_get_all_with_filters(self):
        mem = memory.Mem0(agent_id="agent4", token="token789")
        filters = {"tag": "test"}
        self.mock_client_instance.get_all.return_value = ["mem1", "mem2"]

        result = mem.get_all(filters=filters, n_results=10)

        self.mock_client_instance.get_all.assert_called_once_with(
            agent_id="agent4",
            filters=filters,
            limit=10,
        )
        self.assertEqual(result, ["mem1", "mem2"])

    def test_reset_calls_client_reset(self):
        mem = memory.Mem0(agent_id="agent5", token="token000")
        self.mock_client_instance.reset.return_value = "reset_done"

        result = mem.reset()

        self.mock_client_instance.reset.assert_called_once_with(agent_id="agent5")
        self.assertEqual(result, "reset_done")

    def test_query_returns_none_due_to_missing_return_bug(self):
        # According to the patch, query method calls self.client.search but does NOT return its result.
        # This test will fail on buggy code (no return) and pass after fix (return added).
        mem = memory.Mem0(agent_id="agent6", token="token000")
        self.mock_client_instance.search.return_value = ["result1", "result2"]

        result = mem.query("some query", n_results=3)

        # The buggy code returns None, fixed code returns the list
        self.assertIsNotNone(result)
        self.assertEqual(result, ["result1", "result2"])


