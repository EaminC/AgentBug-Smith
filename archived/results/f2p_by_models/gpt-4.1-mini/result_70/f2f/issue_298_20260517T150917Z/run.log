[32mimport unittest
from unittest.mock import patch, MagicMock
from typing import List, Dict, Optional

import mle.utils.memory as memory


class TestMem0(unittest.TestCase):
    def setUp(self):
        # Patch the imported classes from mem0 package inside memory.py
        # We patch where they are used, i.e. inside mle.utils.memory
        patcher_client = patch("mle.utils.memory.MemoryClient", autospec=True)
        patcher_memory = patch("mle.utils.memory.Memory", autospec=True)

        self.addCleanup(patcher_client.stop)
        self.addCleanup(patcher_memory.stop)

        self.mock_client_class = patcher_client.start()
        self.mock_memory_class = patcher_memory.start()

        # Create instances for client and memory to be returned by the classes
        self.mock_client_instance = MagicMock()
        self.mock_memory_instance = MagicMock()
        self.mock_client_class.return_value = self.mock_client_instance
        self.mock_memory_class.return_value = self.mock_memory_instance

    def test_init_with_token_uses_memoryclient(self):
        mem = memory.Mem0(agent_id="agent1", token="token123")
        self.mock_client_class.assert_called_once_with(api_key="token123")
        self.assertIs(mem.client, self.mock_client_instance)

    def test_init_without_token_uses_memory(self):
        mem = memory.Mem0(agent_id="agent2", token=None)
        self.mock_memory_class.assert_called_once_with()
        self.assertIs(mem.client, self.mock_memory_instance)

    def test_add_calls_client_add_with_correct_params(self):
        mem = memory.Mem0(agent_id="agent3", token="token456")
        messages = [{"role": "user", "content": "hello"}]
        metadata = {"key": "value"}
        prompt = "prompt text"
        infer = True

        mem.add(messages, metadata=metadata, prompt=prompt, infer=infer)

        self.mock_client_instance.add.assert_called_once_with(
            messages,
            metadata=metadata,
            prompt=prompt,
            infer=infer,
            agent_id="agent3",
        )

    def test_query_calls_client_search_with_correct_params(self):
        mem = memory.Mem0(agent_id="agent4", token="token789")

        # Patch the client's search method to return a known value
        self.mock_client_instance.search.return_value = ["result1", "result2"]

        # Call query and check that it returns the search results
        result = mem.query("search text", n_results=3)

        self.mock_client_instance.search.assert_called_once_with(
            agent_id="agent4",
            query_text="search text",
            limit=3,
        )
        # The buggy code does not return the search results, so result might be None.
        # The fix returns the results, so test expects result == expected_results.
        self.assertEqual(result, ["result1", "result2"])

    def test_query_returns_none_due_to_missing_return_bug(self):
        # This test is designed to fail on buggy code where query does not return value
        # We patch the client to return a known value and check if Mem0.query returns it
        mem = memory.Mem0(agent_id="agent6", token=None)
        mem.client.search = MagicMock(return_value=["result1", "result2"])
        result = mem.query("test query", n_results=2)
        # The fixed code should return the search results, not None
        self.assertEqual(result, ["result1", "result2"])

    def test_get_all_calls_client_get_all_with_filters(self):
        mem = memory.Mem0(agent_id="agent5", token=None)
        filters = {"tag": "test"}
        mem.get_all(filters=filters, n_results=10)
        self.mock_memory_instance.get_all.assert_called_once_with(
            agent_id="agent5", filters=filters, limit=10
        )

    def test_reset_calls_client_reset(self):
        mem = memory.Mem0(agent_id="agent6", token=None)

        self.mock_memory_instance.reset.return_value = "reset_done"

        result = mem.reset()
        self.mock_memory_instance.reset.assert_called_once_with(agent_id="agent6")
        self.assertEqual(result, "reset_done")


if __name__ == "__main__":
    unittest.main()[0m
