        mem.client.get_all.assert_called_once_with(
            agent_id=mem.agent_id,
            filters=filters,
            limit=n_results,
        )

    def test_reset_calls_client_reset(self):
        mem = memory.Mem0()
        mem.client = MagicMock()

        mem.reset()

