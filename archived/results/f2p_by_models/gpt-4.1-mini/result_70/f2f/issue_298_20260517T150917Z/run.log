from unittest.mock import patch, MagicMock
from typing import List, Dict, Optional

import mle.utils.memory as memory


class TestMem0(unittest.TestCase):
    def setUp(self):
        # Patch MemoryClient and Memory classes inside mle.utils.memory if they exist
        # Defensive patching: patch only if attributes exist, else skip patching
        # This handles the buggy state where MemoryClient might be missing
        self.patcher_client = None
        self.patcher_memory = None
        if hasattr(memory, "MemoryClient"):
            self.patcher_client = patch("mle.utils.memory.MemoryClient", autospec=True)
            self.mock_memory_client_class = self.patcher_client.start()
            self.addCleanup(self.patcher_client.stop)
        else:
            self.mock_memory_client_class = None

        if hasattr(memory, "Memory"):
            self.patcher_memory = patch("mle.utils.memory.Memory", autospec=True)
            self.mock_memory_class = self.patcher_memory.start()
            self.addCleanup(self.patcher_memory.stop)
        else:
            self.mock_memory_class = None

        # Setup mock client instance for Mem0.client
        if self.mock_memory_client_class:
            self.mock_client_instance = MagicMock()
            self.mock_memory_client_class.return_value = self.mock_client_instance
        elif self.mock_memory_class:
            self.mock_client_instance = MagicMock()
            self.mock_memory_class.return_value = self.mock_client_instance
        else:
            self.mock_client_instance = None

    def test_add_calls_client_add_with_correct_params(self):
        if self.mock_client_instance is None:
            self.skipTest("MemoryClient and Memory classes not available to patch")

        mem = memory.Mem0(agent_id="agent1", token="token123")
        messages = [{"role": "user", "content": "Hello"}]
        metadata = {"tag": "test"}
        prompt = "Prompt text"
        infer = True

        mem.add(messages, metadata=metadata, prompt=prompt, infer=infer)

        self.mock_client_instance.add.assert_called_once_with(
            messages,
            metadata=metadata,
            prompt=prompt,
            infer=infer,
            agent_id="agent1",
        )

    def test_add_without_token_uses_local_memory(self):
        if self.mock_memory_class is None:
            self.skipTest("Memory class not available to patch")

        mem = memory.Mem0(agent_id="agent2", token=None)
        self.assertIs(mem.client, self.mock_memory_class.return_value)

    def test_query_calls_client_search_with_correct_params(self):
        if self.mock_client_instance is None:
            self.skipTest("MemoryClient and Memory classes not available to patch")

        mem = memory.Mem0(agent_id="agent3", token="token456")
        expected_results = ["result1", "result2"]
        self.mock_client_instance.search.return_value = expected_results

        result = mem.query("search query", n_results=2)

        self.mock_client_instance.search.assert_called_once_with(
            agent_id="agent3",
            query_text="search query",
            limit=2,
        )
        # The buggy code does not return the search results, so result might be None.
        # The fix returns the results, so test expects result == expected_results.
        self.assertEqual(result, expected_results)

    def test_get_all_calls_client_get_all_with_filters(self):
        if self.mock_client_instance is None:
            self.skipTest("MemoryClient and Memory classes not available to patch")

        mem = memory.Mem0(agent_id="agent4", token="token789")
        filters = {"key": "value"}
        expected_results = ["mem1", "mem2"]
        self.mock_client_instance.get_all.return_value = expected_results

        result = mem.get_all(filters=filters, n_results=10)

        self.mock_client_instance.get_all.assert_called_once_with(
            agent_id="agent4",
            filters=filters,
            limit=10,
        )
        self.assertEqual(result, expected_results)

    def test_reset_calls_client_reset(self):
        if self.mock_client_instance is None:
            self.skipTest("MemoryClient and Memory classes not available to patch")

        mem = memory.Mem0(agent_id="agent5", token="token321")
        expected_result = "reset_done"
        self.mock_client_instance.reset.return_value = expected_result

        result = mem.reset()

        self.mock_client_instance.reset.assert_called_once_with(agent_id="agent5")
        self.assertEqual(result, expected_result)

    def test_query_returns_none_due_to_missing_return_bug(self):
        # This test is designed to fail on buggy code where query does not return value
        if self.mock_client_instance is None:
            self.skipTest("MemoryClient and Memory classes not available to patch")

        mem = memory.Mem0(agent_id="agent6", token="token000")
        expected_results = ["memory1", "memory2"]
        self.mock_client_instance.search.return_value = expected_results

        result = mem.query("query test", n_results=2)

        # On buggy code, result will be None, so this assert fails
        self.assertEqual(result, expected_results)


