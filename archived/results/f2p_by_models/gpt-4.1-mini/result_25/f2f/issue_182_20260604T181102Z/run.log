        uvicorn_called = {}
    
        def fake_uvicorn_run(app, host, port, log_level=None):
            uvicorn_called['called'] = True
            uvicorn_called['host'] = host
            uvicorn_called['port'] = port
            uvicorn_called['log_level'] = log_level
    
