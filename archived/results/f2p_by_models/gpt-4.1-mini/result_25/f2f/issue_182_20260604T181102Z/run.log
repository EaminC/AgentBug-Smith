    @pytest.mark.timeout(60)
    def test_cli_report_combines_pnpm_dev_and_mle_serve():
        """
        Test that 'mle report' command with --visualize True runs both 'pnpm dev' and 'mle serve' logic.
    
        Fail2pass:
