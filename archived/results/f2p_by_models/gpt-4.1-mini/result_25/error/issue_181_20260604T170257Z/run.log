    github_username = "huangyz0918"
    github_token = "dummy_token_123"
    okr_str = "Improve system efficiency by 20% this quarter"
    model = "gpt-4o"

    # Patch ask_github_token to raise if called, so we detect if token is missing
    def fail_ask_token():
        raise RuntimeError("ask_github_token should not be called when token is provided")

    monkeypatch.setattr(report, "ask_github_token", fail_ask_token)

    # Call report with token provided, should not call ask_github_token and succeed
