    work_dir = os.getcwd()
    github_repo = "MLSysOps/MLE-agent"
    github_username = "huangyz0918"
    github_token = "dummy_token_123"
    okr_str = "Improve system efficiency by 20% this quarter"
    model = "gpt-4o"

    # Patch ask_github_token to raise if called (should not be called if token passed)
    def fail_ask_token():
        raise AssertionError("ask_github_token() should not be called when token is provided")

    monkeypatch.setattr(report, "ask_github_token", fail_ask_token)

    # Call report with token explicitly provided
    result = report.report(work_dir, github_repo, github_username, github_token=github_token, okr_str=okr_str, model=model)
    assert result is not None
    # The returned object should have github_token attribute equal to the passed token
    assert hasattr(result, "github_token")
    assert result.github_token == github_token

def test_gen_report_request_token_field():
    # Test that ReportRequest accepts token and gen_report uses it
    req = ReportRequest(repo="MLSysOps/MLE-agent", username="huangyz0918", token="dummy_token_abc", okr="Test OKR")
    # gen_report should accept this request without error
    # We do not test the full gen_report output, just that it runs without error and includes token param
    # Patch report.report to capture github_token argument
    called = {}
    def fake_report(work_dir, repo, username, github_token=None, okr_str=None, model=None):
        called['token'] = github_token
        return "fake_report_result"
    import mle.workflow.report as report_mod
    original_report = report_mod.report
    report_mod.report = fake_report
    try:
        result = gen_report(req)
        assert result == "fake_report_result"
        # The token passed to report should be the one in the request
        assert called.get('token') == req.token
    finally:
        report_mod.report = original_report

