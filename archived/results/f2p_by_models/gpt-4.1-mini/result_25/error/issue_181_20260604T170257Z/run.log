        report.report(work_dir, github_repo, github_username, github_token=github_token, okr_str=okr_str, model=model)
    except Exception as e:
        pytest.fail(f"report raised unexpectedly when token provided: {e}")

    # Now call report without token, it should call ask_github_token and fail due to our patch
    with pytest.raises(RuntimeError) as excinfo:
        report.report(work_dir, github_repo, github_username, github_token=None, okr_str=okr_str, model=model)
    assert "ask_github_token should not be called" in str(excinfo.value)


