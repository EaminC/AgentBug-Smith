from mle.workflow import report
from mle.server.app import ReportRequest, gen_report
import os

def test_report_requires_token(monkeypatch):
    # Setup dummy parameters
    work_dir = os.getcwd()
    github_repo = "MLSysOps/MLE-agent"
    github_username = "huangyz0918"
    dummy_token = "dummy_token_123"
    okr_str = "Improve system efficiency by 20% this quarter"
    model = "gpt-4o"

    # The report function should accept the github_token parameter and use it
    # If the token is not passed, it should fallback to ask_github_token (which we do not mock here)
    # So passing token explicitly should not cause errors

    # Call report with token
    result_with_token = report.report(
        work_dir=work_dir,
        github_repo=github_repo,
        github_username=github_username,
        github_token=dummy_token,
        okr_str=okr_str,
        model=model,
    )
    assert result_with_token is not None

    # Call report without token, it should fallback to ask_github_token internally
    # This may raise or not depending on environment, but we want to verify token param is accepted
    # So we just check it returns something or raises a specific error (not a TypeError)
    try:
        result_without_token = report.report(
            work_dir=work_dir,
            github_repo=github_repo,
            github_username=github_username,
            okr_str=okr_str,
            model=model,
        )
        assert result_without_token is not None
    except Exception as e:
        # Accept any exception except TypeError (which would indicate missing required param)
        assert not isinstance(e, TypeError)

def test_gen_report_request_token_field():
    # The ReportRequest model should accept token as optional field
    req = ReportRequest(
        repo="MLSysOps/MLE-agent",
        username="huangyz0918",
        token="dummy_token_123",
        okr="Improve system efficiency by 20% this quarter"
    )
    assert req.token == "dummy_token_123"

def test_gen_report_includes_token(monkeypatch):
    # Patch the internal report.report function to capture arguments
    called_args = {}
    def fake_report(*args, **kwargs):
        called_args.update(kwargs)
        return "fake_report_result"

    monkeypatch.setattr(report, "report", fake_report)

    req = ReportRequest(
        repo="MLSysOps/MLE-agent",
        username="huangyz0918",
        token="dummy_token_123",
        okr="Improve system efficiency by 20% this quarter"
    )

    # Call gen_report with the request
    result = gen_report(req)
    assert result == "fake_report_result"
    # Check that token was passed down to report.report
