from mle.workflow import report
from mle.server.app import ReportRequest, gen_report

def test_report_requires_token(monkeypatch):
    # Setup dummy parameters
    work_dir = os.getcwd()
    github_repo = "MLSysOps/MLE-agent"
    github_username = "huangyz0918"
    okr_str = "Improve system efficiency by 20% this quarter"
    dummy_model = "gpt-4o"

    # Patch ask_github_token to raise if called (to detect fallback)
    def fail_ask_github_token():
        raise RuntimeError("ask_github_token fallback called")

    monkeypatch.setattr(report, "ask_github_token", fail_ask_github_token)

    # Case 1: Call report without token - should raise RuntimeError due to fallback call
    with pytest.raises(RuntimeError):
        report.report(work_dir, github_repo, github_username, github_token=None, okr_str=okr_str, model=dummy_model)

    # Case 2: Call report with token - should NOT raise and return a ReportAgent instance
    # We cannot fully test the internals, but we check no exception and type of return
    dummy_token = "dummy_token_123"
    agent = report.report(work_dir, github_repo, github_username, github_token=dummy_token, okr_str=okr_str, model=dummy_model)
    # The returned object should have attribute 'model' (ReportAgent)
    assert hasattr(agent, "model")
    assert agent.model == dummy_model

def test_gen_report_request_token_field():
    # Test that ReportRequest accepts token and gen_report uses it properly
    token = "secret_token"
    req = ReportRequest(repo="repo", username="user", token=token)
    # The token field should be set correctly
    assert req.token == token

    # Patch report.report to capture parameters
    called = {}

    def fake_report(work_dir, github_repo, github_username, github_token=None, okr_str=None, model=None):
        called.update({
            "work_dir": work_dir,
            "github_repo": github_repo,
            "github_username": github_username,
            "github_token": github_token,
            "okr_str": okr_str,
            "model": model,
        })
        return "agent"

    # Monkeypatch report.report in gen_report module
    import mle.server.app as app_module
    original_report = app_module.report
    app_module.report = fake_report

    try:
        agent = gen_report(req)
        # The fake_report should be called with token passed through
        assert called["github_token"] == token
        assert agent == "agent"
    finally:
        app_module.report = original_report[0m
