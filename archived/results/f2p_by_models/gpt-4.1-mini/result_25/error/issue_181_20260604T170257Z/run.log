def test_report_requires_token(monkeypatch):
    # Patch ask_github_token to raise if called to detect fallback usage
    def fail_ask_token():
        raise RuntimeError("ask_github_token fallback called")

    monkeypatch.setattr(report, "ask_github_token", fail_ask_token)

    # Call report with explicit token should NOT call ask_github_token
    try:
        report.report(
            work_dir=os.getcwd(),
            github_repo="MLSysOps/MLE-agent",
            github_username="huangyz0918",
            github_token="dummy_token",
            okr_str="Test OKR",
            model="gpt-4o",
        )
    except Exception as e:
        # We do not care about other exceptions here, only that ask_github_token is not called
        assert "ask_github_token fallback called" not in str(e)

    # Call report without token should call ask_github_token and raise RuntimeError
    with pytest.raises(RuntimeError) as excinfo:
        report.report(
            work_dir=os.getcwd(),
            github_repo="MLSysOps/MLE-agent",
            github_username="huangyz0918",
            github_token=None,
            okr_str="Test OKR",
            model="gpt-4o",
        )
