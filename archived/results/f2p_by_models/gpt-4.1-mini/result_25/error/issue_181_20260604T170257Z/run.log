    result = report.report(
        work_dir=".",
        github_repo="MLSysOps/MLE-agent",
        github_username="huangyz0918",
        github_token=None,
        okr_str="Improve system efficiency by 20% this quarter",
        model="gpt-4o",
    )
    # The result should be a dict with keys including 'model', 'github_repo', 'username', 'github_token'
    assert isinstance(result, dict)
    assert result.get("github_token") == "dummy_token"
    assert result.get("github_repo") == "MLSysOps/MLE-agent"
    assert result.get("username") == "huangyz0918"
    assert result.get("model") == "gpt-4o"


def test_gen_report_accepts_token():
    # Test that gen_report accepts ReportRequest with token field and passes it correctly
    from mle.server.app import ReportRequest

    # Create a ReportRequest with token
    req = ReportRequest(
        repo="MLSysOps/MLE-agent",
        username="huangyz0918",
        token="mytoken123",
        okr="Improve system efficiency by 20% this quarter",
    )
    # Call gen_report with this request
    result = gen_report(req)
    # The result should be a dict and contain the token passed
    assert isinstance(result, dict)
    # The token should be present in the result or at least not None
    # Because gen_report calls report which returns a dict with github_token key
    assert "github_token" in result
    assert result["github_token"] == "mytoken123"


def test_report_fails_without_token(monkeypatch):
    # Before fix, report() might fail or behave incorrectly if token is not provided.
    # After fix, token is optional and fallback is used.
    # We test that calling report without token uses fallback and returns expected dict.

    # Patch ask_github_token to return a dummy token
    def dummy_ask_github_token():
        return "dummy_token"

    monkeypatch.setattr(report, "ask_github_token", dummy_ask_github_token)

    # Call report without token argument (should use default None)
    result = report.report(
        work_dir=".",
        github_repo="MLSysOps/MLE-agent",
        github_username="huangyz0918",
        okr_str="Improve system efficiency by 20% this quarter",
        model="gpt-4o",
    )
    # Should return dict with github_token set to dummy_token
    assert isinstance(result, dict)
    assert result.get("github_token") == "dummy_token"


