from mle.workflow import report
import os

def test_report_requires_token(monkeypatch):
    # Prepare dummy parameters
    work_dir = os.getcwd()
    github_repo = "MLSysOps/MLE-agent"
    github_username = "huangyz0918"
    okr_str = "Improve system efficiency by 20% this quarter"
    dummy_token = "dummy_token_123"

    # Patch ask_github_token to raise if called (to detect if fallback is used)
    def fail_ask_token():
        raise RuntimeError("ask_github_token fallback called unexpectedly")

    monkeypatch.setattr(report, "ask_github_token", fail_ask_token)

    # Call report with explicit token, should NOT call ask_github_token fallback
    result_with_token = report.report(
        work_dir=work_dir,
        github_repo=github_repo,
        github_username=github_username,
        github_token=dummy_token,
        okr_str=okr_str,
        model="gpt-4o"
    )
    assert result_with_token is not None

    # Call report with github_token=None, should call fallback and raise RuntimeError
    with pytest.raises(RuntimeError, match="ask_github_token fallback called unexpectedly"):
        report.report(
