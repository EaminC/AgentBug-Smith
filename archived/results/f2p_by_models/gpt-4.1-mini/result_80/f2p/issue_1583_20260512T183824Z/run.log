def test_model_settings_extra_body_field():
    # The ModelSettings class should have an extra_body attribute that can be set and retrieved.
    ms = models.ModelSettings()
    assert ms.extra_body is None

    ms2 = models.ModelSettings(extra_body={"provider": {"order": ["OpenAI", "Together"]}})
    assert isinstance(ms2.extra_body, dict)
    assert "provider" in ms2.extra_body
    assert ms2.extra_body["provider"]["order"] == ["OpenAI", "Together"]


