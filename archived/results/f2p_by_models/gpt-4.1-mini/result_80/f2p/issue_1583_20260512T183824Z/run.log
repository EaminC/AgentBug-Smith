import aider.coders.base_coder as base_coder
import aider.sendchat as sendchat


def test_model_settings_extra_body_field():
    # Test that ModelSettings has extra_body attribute and it can be set and retrieved
    extra_body_value = {"provider": {"order": ["OpenAI", "Together"]}}
    m = models.ModelSettings(extra_body=extra_body_value)
    assert m.extra_body == extra_body_value


def test_base_coder_send_completion_extra_body(monkeypatch):
    # Prepare a dummy model with extra_body attribute
    class DummyModel:
        def __init__(self):
            self.extra_body = {"provider": {"order": ["OpenAI", "Together"]}}
            self.extra_headers = None
            self.max_tokens = None
            self.cache_control = False
            self.use_repo_map = False
            self.info = {}
            self.commit_message_models = lambda: []
            self.weak_model = None

            # Provide required attribute to avoid AttributeError in Coder __init__
            self.max_chat_history_tokens = 1000

    dummy_model = DummyModel()

    # Patch send_completion to capture kwargs
    called_kwargs = {}

    def fake_send_completion(**kwargs):
        called_kwargs.update(kwargs)
        dummy_resp = MagicMock()
        dummy_resp.choices = [MagicMock(message=MagicMock(content="dummy"))]
        return "hash", dummy_resp

    monkeypatch.setattr(base_coder, "send_completion", fake_send_completion)

    # Create dummy io with required attributes
    class DummyIO:
        def __init__(self):
            self.pretty = False

        def tool_warning(self, msg):
            pass

        def tool_output(self, msg):
            pass

    # Patch GitRepo and Commands to dummy classes to avoid side effects
    monkeypatch.setattr(base_coder, "GitRepo", lambda *a, **k: None)
    monkeypatch.setattr(base_coder, "Commands", lambda *a, **k: MagicMock())

    io = DummyIO()

    # Instantiate Coder with dummy model and io
    coder = base_coder.Coder(dummy_model, io, fnames=[])

    # Call _send_completion via base_coder.Coder._send_completion indirectly by calling a method that triggers it
    # The simplest is to call base_coder.Coder._send_completion directly with parameters
    # But _send_completion is a private method, so call the public method that uses it: base_coder.Coder._send_completion is called by base_coder.Coder._send_completion
    # Actually, base_coder.Coder._send_completion is private but we can call it directly for testing

    messages = [{"role": "user", "content": "Hello"}]
    # Call _send_completion with dummy_model and extra_body
    coder._send_completion(
        model=dummy_model,
        messages=messages,
        temp=0,
        extra_headers=None,
        max_tokens=None,
    )

    # Check that extra_body was passed to send_completion
    assert "extra_body" in called_kwargs
    assert called_kwargs["extra_body"] == dummy_model.extra_body


@pytest.mark.parametrize("func", [sendchat.simple_send_with_retries])
def test_simple_send_with_retries_extra_body(monkeypatch, func):
    # Patch send_completion to capture kwargs and simulate a response
    called_kwargs = {}

    def fake_send_completion(**kwargs):
        called_kwargs.update(kwargs)
        dummy_resp = MagicMock()
        dummy_resp.choices = [MagicMock(message=MagicMock(content="dummy content"))]
        return "hash", dummy_resp

    monkeypatch.setattr(sendchat, "send_completion", fake_send_completion)

    # Call simple_send_with_retries with extra_body
    extra_body = {"provider": {"order": ["OpenAI", "Together"]}}
    content = func("dummy-model", [{"role": "user", "content": "Hi"}], extra_body=extra_body)

    # The content returned should be the dummy content from fake_send_completion
    assert content == "dummy content"

    # Check that extra_body was passed down to send_completion
    assert "extra_body" in called_kwargs
    assert called_kwargs["extra_body"] == extra_body[0m
