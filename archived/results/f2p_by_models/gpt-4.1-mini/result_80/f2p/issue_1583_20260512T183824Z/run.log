def test_base_coder_send_completion_extra_body(monkeypatch):
    # We test that base_coder.Coder calls send_completion with extra_body from model

    class DummyModel:
        def __init__(self):
            self.extra_headers = {"X-Test": "header"}
            self.extra_body = {"provider": {"order": ["OpenAI", "Together"]}}
            self.max_tokens = 123
            self.cache_control = False
            self.commit_message_models = lambda: []
            self.extra_body = {"provider": {"order": ["OpenAI", "Together"]}}

    class DummyIO:
        def __init__(self):
            self.pretty = False

    called_kwargs = {}

    def fake_send_completion(**kwargs):
        called_kwargs.update(kwargs)
        dummy_resp = MagicMock()
        dummy_resp.choices = [MagicMock(message=MagicMock(content="dummy content"))]
        return "hash", dummy_resp

    monkeypatch.setattr(sendchat, "send_completion", fake_send_completion)

    dummy_model = DummyModel()
    dummy_io = DummyIO()

    coder = base_coder.Coder(dummy_model, dummy_io, stream=True)
    # Call _send_completion with dummy data
    messages = [{"role": "user", "content": "Hello"}]
    coder._send_completion("dummy-model", messages, temp=0)

    # Check that extra_body was passed through
    assert "extra_body" in called_kwargs
    assert called_kwargs["extra_body"] == dummy_model.extra_body
    # Also check extra_headers and max_tokens passed
    assert called_kwargs.get("extra_headers") == dummy_model.extra_headers
    assert called_kwargs.get("max_tokens") == dummy_model.max_tokens


@pytest.mark.parametrize("func", [sendchat.simple_send_with_retries])
def test_simple_send_with_retries_extra_body(monkeypatch, func):
    # Patch send_completion to capture kwargs and simulate a response
    called_kwargs = {}

    def fake_send_completion(**kwargs):
        called_kwargs.update(kwargs)
        dummy_resp = MagicMock()
        dummy_resp.choices = [MagicMock(message=MagicMock(content="dummy content"))]
        return "hash", dummy_resp

    monkeypatch.setattr(sendchat, "send_completion", fake_send_completion)

    # Call simple_send_with_retries with extra_body
    extra_body = {"provider": {"order": ["OpenAI", "Together"]}}
    content = func("dummy-model", [{"role": "user", "content": "Hi"}], extra_body=extra_body)

    assert content == "dummy content"
    assert "extra_body" in called_kwargs
    assert called_kwargs["extra_body"] == extra_body


def test_send_completion_supports_extra_body(monkeypatch):
    # This test verifies that send_completion function accepts extra_body and passes it to litellm call

    called_kwargs = {}

    # Patch the internal litellm send_completion function that is called by sendchat.send_completion
    # Since sendchat.litellm is a LazyLiteLLM instance, patch sendchat.litellm._client.chat.completions.create
    # But _client is not exposed, so patch sendchat.litellm._lazy_module.chat.completions.create

    # We patch sendchat.litellm._lazy_module.chat.completions.create to simulate network call and capture data

    # Access _lazy_module attribute of litellm
    litellm = sendchat.litellm
    # Force load litellm module if not loaded
    _ = getattr(litellm, "_lazy_module", None)
    # Patch the create method
    orig_create = litellm._lazy_module.chat.completions.create

    def fake_create(*args, **kwargs):
        called_kwargs.update(kwargs)
        class DummyResponse:
            def __init__(self):
                self.choices = [MagicMock(message=MagicMock(content="dummy content"))]
        return DummyResponse()

    monkeypatch.setattr(litellm._lazy_module.chat.completions, "create", fake_create)

    # Call send_completion with extra_body
    extra_body = {"provider": {"order": ["OpenAI", "Together"]}}
    messages = [{"role": "user", "content": "Hello"}]
    resp_hash, resp = sendchat.send_completion(
        "dummy-model",
        messages,
        functions=None,
        stream=False,
        extra_headers={"X-Test": "header"},
        extra_body=extra_body,
        max_tokens=100,
    )

    assert resp.choices[0].message.content == "dummy content"
    # The called_kwargs should include extra_body merged into data
    # The create method is called with a dict as first positional argument
    # The dict should contain extra_body keys
    # We check that extra_body keys are present in the first arg of create
    create_call_arg = list(called_kwargs.values())[0] if called_kwargs else None
    # Actually, create is called with a single dict positional argument, so kwargs is empty
    # So we check the first positional argument of fake_create
    # But we patched create with fake_create that ignores positional args
    # So we patch create to capture positional args as well

    called_args = {}

    def fake_create_capture(*args, **kwargs):
        called_args["args"] = args
        called_args["kwargs"] = kwargs
        class DummyResponse:
            def __init__(self):
                self.choices = [MagicMock(message=MagicMock(content="dummy content"))]
        return DummyResponse()

    monkeypatch.setattr(litellm._lazy_module.chat.completions, "create", fake_create_capture)

    # Call again
    resp_hash, resp = sendchat.send_completion(
        "dummy-model",
        messages,
        functions=None,
        stream=False,
        extra_headers={"X-Test": "header"},
        extra_body=extra_body,
        max_tokens=100,
    )

    # The first positional argument is the data dict
    data_dict = called_args["args"][0]
    # Check that extra_body keys are present in data_dict
    for k, v in extra_body.items():
        assert k in data_dict
        assert data_dict[k] == v


def test_model_settings_extra_body_field():
    # Test that ModelSettings supports extra_body field and it is stored correctly

    # We create a ModelSettings instance with required name and extra_body
    extra_body_data = {"provider": {"order": ["OpenAI", "Together"]}}
    ms = models.ModelSettings(
        name="dummy-model",
        extra_body=extra_body_data,
    )
    assert hasattr(ms, "extra_body")
    assert ms.extra_body == extra_body_data


@pytest.mark.parametrize("extra_body", [None, {"provider": {"order": ["OpenAI", "Together"]}}])
def test_model_settings_roundtrip_extra_body(extra_body):
    # Test that ModelSettings can be created with or without extra_body and serialize/deserialize works

    ms = models.ModelSettings(
        name="dummy-model",
        extra_body=extra_body,
    )
    # Serialize to dict
    d = ms.dict()
    if extra_body is None:
        assert "extra_body" not in d or d["extra_body"] is None
    else:
        assert d["extra_body"] == extra_body


@pytest.mark.parametrize("extra_body", [None, {"provider": {"order": ["OpenAI", "Together"]}}])
def test_sendchat_send_completion_extra_body_parameter(monkeypatch, extra_body):
    # Test that send_completion accepts extra_body parameter and passes it to litellm call

    called_kwargs = {}

    def fake_send_completion(**kwargs):
        called_kwargs.update(kwargs)
        dummy_resp = MagicMock()
        dummy_resp.choices = [MagicMock(message=MagicMock(content="dummy content"))]
        return "hash", dummy_resp

    monkeypatch.setattr(sendchat, "send_completion", fake_send_completion)

    # Call send_completion with extra_body
    messages = [{"role": "user", "content": "Hello"}]
    resp_hash, resp = sendchat.send_completion(
        "dummy-model",
        messages,
        functions=None,
        stream=False,
        extra_body=extra_body,
    )
    assert resp.choices[0].message.content == "dummy content"
    if extra_body is not None:
        assert "extra_body" in called_kwargs
        assert called_kwargs["extra_body"] == extra_body
    else:
        assert "extra_body" not in called_kwargs or called_kwargs["extra_body"] is None

