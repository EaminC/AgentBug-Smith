from unittest.mock import MagicMock, patch


def test_model_settings_extra_body_field():
    """
    Test that ModelSettings includes the extra_body field and it can be set.
    This should fail on buggy codebase if extra_body is missing or not handled.
    """
    from aider.models import ModelSettings

    ms = ModelSettings()
    assert hasattr(ms, "extra_body"), "ModelSettings should have extra_body attribute"
    # Set and get extra_body
    test_extra_body = {"provider": {"order": ["OpenAI", "Together"]}}
    ms.extra_body = test_extra_body
    assert ms.extra_body == test_extra_body


def test_send_completion_supports_extra_body(monkeypatch):
    """
    Test that send_completion correctly passes the extra_body parameter to litellm
    and that simple_send_with_retries also supports extra_body.

    This test should fail on buggy codebase (missing extra_body support)
    and pass on fixed codebase.
    """
    import aider.sendchat as sendchat

    model_name = "openrouter/google/gemma-2-9b-it:free"
    messages = [{"role": "user", "content": "Hello"}]
    extra_headers = {"Authorization": "Bearer dummy"}
    extra_body = {"provider": {"order": ["OpenAI", "Together"]}}

    # Patch the internal _send_completion function inside litellm module
    # to capture the kwargs passed to it without making real network calls.
    called_kwargs = {}

    # We patch the internal _send_completion function used by send_completion
    # The real send_completion calls _send_completion internally.
    # We patch _send_completion to intercept the call.
    # The internal _send_completion is inside aider.llm.litellm module.
    # We patch it to record kwargs and return dummy response.

    # Import litellm module and patch _send_completion
    import aider.llm.litellm as litellm

    def fake__send_completion(**kwargs):
        called_kwargs.update(kwargs)
        dummy_response = MagicMock()
        dummy_response.choices = [MagicMock(message=MagicMock(content="dummy response"))]
        return "dummy_hash", dummy_response

    monkeypatch.setattr(litellm, "_send_completion", fake__send_completion)

    # Call send_completion with extra_body
    hash_val, response = sendchat.send_completion(
        model_name,
        messages,
        functions=None,
        stream=False,
        temperature=0,
        extra_headers=extra_headers,
        extra_body=extra_body,
        max_tokens=None,
    )
    # Check that extra_body was passed through to litellm._send_completion
    assert "extra_body" in called_kwargs, "extra_body should be passed to litellm._send_completion"
    assert called_kwargs["extra_body"] == extra_body

    # Also test simple_send_with_retries supports extra_body param
    called_kwargs.clear()
    response_text = sendchat.simple_send_with_retries(
        model_name, messages, extra_headers=extra_headers, extra_body=extra_body
    )
    assert "extra_body" in called_kwargs, "extra_body should be passed to litellm._send_completion via simple_send_with_retries"
    assert called_kwargs["extra_body"] == extra_body
    assert response_text == "dummy response"


def test_base_coder_send_completion_extra_body(monkeypatch):
    """
    Test that base_coder calls send_completion with extra_body from model.
    This test assumes base_coder.Coder.__init__ calls send_completion with model.extra_body.

    We patch send_completion to capture the call and verify extra_body is passed.
    """
    import aider.coders.base_coder as base_coder

    # Create a dummy model with extra_body attribute and required attributes/methods
    class DummyModel:
        def __init__(self):
            self.extra_body = {"provider": {"order": ["OpenAI", "Together"]}}
            self.extra_headers = None
            self.max_tokens = None
            self.cache_control = False
            self.commit_message_models = lambda: []

    dummy_model = DummyModel()

    # Patch send_completion to capture kwargs
    called_kwargs = {}

    def fake_send_completion(**kwargs):
        called_kwargs.update(kwargs)
        dummy_resp = MagicMock()
        dummy_resp.choices = [MagicMock(message=MagicMock(content="dummy"))]
        return "hash", dummy_resp

    monkeypatch.setattr(base_coder, "send_completion", fake_send_completion)

    # Create dummy io with required attributes
    class DummyIO:
        def __init__(self):
            self.pretty = False

    # Instantiate Coder with dummy model and io
    main_model = dummy_model
    io = DummyIO()

    # We do not want to trigger GitRepo or Commands internals that require more setup,
    # so patch GitRepo and Commands to dummy classes to avoid side effects.
    monkeypatch.setattr(base_coder, "GitRepo", lambda *a, **k: None)
    monkeypatch.setattr(base_coder, "Commands", lambda *a, **k: MagicMock())

    coder = base_coder.Coder(main_model, io)

    # The call to send_completion should have included extra_body
    assert "extra_body" in called_kwargs, "extra_body should be passed to send_completion from base_coder.Coder"
    assert called_kwargs["extra_body"] == dummy_model.extra_body

    # Also check that the call contains expected keys
    assert "model" in called_kwargs
    assert "messages" in called_kwargs
    assert "stream" in called_kwargs

