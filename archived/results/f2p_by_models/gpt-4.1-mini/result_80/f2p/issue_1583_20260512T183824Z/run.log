def test_send_completion_supports_extra_body(dummy_response):
    """
    Test that send_completion correctly passes the extra_body parameter to litellm
    and that simple_send_with_retries also supports extra_body.

    This test should fail on buggy codebase (missing extra_body support)
    and pass on fixed codebase.
    """
    model_name = "openrouter/google/gemma-2-9b-it:free"
    messages = [{"role": "user", "content": "Hello"}]
    extra_headers = {"Authorization": "Bearer dummy"}
    extra_body = {"provider": {"order": ["OpenAI", "Together"]}}

    # Patch the internal litellm._send_completion method that send_completion calls
    # Because send_completion is a function in aider.llm.litellm module,
    # but in buggy codebase it may be a LazyLiteLLM object without send_completion attribute,
    # so patch the internal _send_completion function used by litellm.send_completion.
    # We patch the network call inside litellm to avoid real API calls.

    # The litellm.send_completion calls litellm._send_completion internally which does the actual call.
    # We patch _send_completion to capture the kwargs.

    import aider.llm.litellm as litellm

    called_kwargs = {}

    def fake__send_completion(*args, **kwargs):
        called_kwargs.update(kwargs)
        return None, dummy_response

    with patch("aider.llm.litellm._send_completion", side_effect=fake__send_completion) as mock_internal:
        # Call send_completion with extra_body
        _, resp = litellm.send_completion(
            model_name=model_name,
            messages=messages,
            stream=False,
            extra_headers=extra_headers,
            extra_body=extra_body,
            max_tokens=100,
        )
        assert resp.choices[0].message.content == "dummy response"
        # Check that extra_body was passed through
        assert "extra_body" in called_kwargs
        assert called_kwargs["extra_body"] == extra_body
        # Also check extra_headers passed
        assert "extra_headers" in called_kwargs
        assert called_kwargs["extra_headers"] == extra_headers

    # Test simple_send_with_retries supports extra_body param and passes it through
    with patch("aider.llm.litellm.send_completion", side_effect=lambda **kwargs: (None, dummy_response)) as mock_send:
        result = sendchat.simple_send_with_retries(
            model_name=model_name,
            messages=messages,
            extra_headers=extra_headers,
            extra_body=extra_body,
        )
        assert result == "dummy response"
        # The mock_send should have been called with extra_body
        called = mock_send.call_args[1]
        assert "extra_body" in called
        assert called["extra_body"] == extra_body


def test_model_settings_extra_body_field():
    """
    Test that ModelSettings dataclass has the extra_body field and it can be set.
    This should fail if extra_body field is missing in ModelSettings.
    """
    extra_body_data = {"provider": {"order": ["OpenAI", "Together"]}}
    # Provide required fields for ModelSettings
    settings = models.ModelSettings(
        name="test-model",
        extra_body=extra_body_data,
    )
    assert hasattr(settings, "extra_body")
    assert settings.extra_body == extra_body_data


