    libxslt1-dev \
    python3-dev \
    libffi-dev \
    build-essential \
    curl \
  && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install Poetry if pyproject.toml exists
RUN if [ -f "pyproject.toml" ]; then pip install poetry; fi

# Fix poetry.lock out-of-sync by regenerating lock file if needed
RUN if [ -f "pyproject.toml" ] && ( ! [ -f "poetry.lock" ] || poetry lock --check-frozen ); then poetry lock; fi

# Install dependencies with Poetry without virtualenv
RUN if [ -f "poetry.lock" ]; then poetry config virtualenvs.create false && poetry install; fi

# Editable install of this repo
RUN pip install -e .

# Install test dependencies
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# Verify Python and pytest load correctly
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Environment variables for Forge API compatibility for OpenAI and Anthropic SDKs
ARG FORGE_API_KEY="forge-key"
ENV FORGE_API_KEY=forge-key
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Default command to keep container alive with bash shell
CMD ["/bin/bash"]

