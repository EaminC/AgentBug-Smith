ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

WORKDIR /app

# Copy entire repository
COPY . .

# Install system dependencies required for Python builds
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libxml2-dev libxslt1-dev python3-dev build-essential && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel, and packaging
RUN python -m pip install --upgrade pip setuptools wheel packaging

# Install project dependencies and project itself depending on what we detect
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt && pip install -e .; \
    elif [ -f "poetry.lock" ] && [ -f "pyproject.toml" ]; then \
        pip install poetry && poetry install --no-root; \
        pip install -e .; \
    elif [ -f "pyproject.toml" ]; then \
        pip install -e .; \
    fi

# Install standard test dependencies
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm

# Verify Python and pytest installation
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]

