RUN apt-get update && apt-get install -y git gcc build-essential && rm -rf /var/lib/apt/lists/*

COPY . .

RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm && \
    python -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]
