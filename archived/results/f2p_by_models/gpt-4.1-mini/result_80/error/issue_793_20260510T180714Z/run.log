[32mFROM python:3.10-slim AS test_builder

WORKDIR /app

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=${FORGE_API_KEY} \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Detect src/ layout pattern for conditional install
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        python -m pip install --upgrade pip setuptools wheel && \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm && \
        echo "Using src/ layout detected, skipping editable install and setting PYTHONPATH" && \
        echo "preflight check" && python -c 'import pkg_resources, pytest; print("preflight ok")'; \
    else \
        python -m pip install --upgrade pip setuptools wheel && \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi && \
        pip install -e . pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm && \
        echo "No src/ layout detected, editable install performed" && \
        echo "preflight check" && python -c 'import pkg_resources, pytest; print("preflight ok")'; \
    fi

# Run tests using poetry runner
RUN poetry run pytest

FROM python:3.10-slim AS runtime

WORKDIR /app

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=${FORGE_API_KEY} \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install poetry && \
    poetry config virtualenvs.create false && \
    poetry install --no-interaction --no-ansi --no-dev && \
    echo "preflight check" && python -c 'import pkg_resources'

