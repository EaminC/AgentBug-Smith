from unittest.mock import patch, MagicMock
from dapr_agents.tool.mcp.client import MCPClient, ToolError


class DummyContent:
    def __init__(self, text):
        self.text = text


class DummyResult:
    def __init__(self, is_error, contents):
        self.isError = is_error
        self.content = contents


def test_process_tool_result_error_with_content():
    """
    This test verifies that MCPClient._process_tool_result returns the content text
    even if the result indicates an error (isError=True) but content with text is present.
    This behavior is the fix introduced in the patch.
    """
    client = MCPClient()

    # Create dummy content with text
    content_text = "This is an error message from MCP server"
    dummy_content = DummyContent(content_text)

    # Create dummy result with isError=True and content containing the dummy_content
    dummy_result = DummyResult(is_error=True, contents=[dummy_content])

    # Call _process_tool_result and expect it to return the content text instead of raising ToolError
    result_text = client._process_tool_result(dummy_result)

    assert result_text == content_text


def test_process_tool_result_error_without_content_raises():
    """
    This test verifies that MCPClient._process_tool_result raises ToolError
    if the result indicates an error (isError=True) but no content with text is present.
    """
    client = MCPClient()

    # Create dummy result with isError=True and empty content list
    dummy_result = DummyResult(is_error=True, contents=[])

    # Expect ToolError to be raised
    with pytest.raises(ToolError):
        client._process_tool_result(dummy_result)


def test_process_tool_result_non_error_with_content():
    """
    This test verifies that MCPClient._process_tool_result returns content text
    when isError=False and content with text is present.
    """
    client = MCPClient()

    content_text = "Normal successful response"
    dummy_content = DummyContent(content_text)
    dummy_result = DummyResult(is_error=False, contents=[dummy_content])

    result_text = client._process_tool_result(dummy_result)

    assert result_text == content_text


def test_process_tool_result_non_error_without_content_returns_str():
    """
    This test verifies that MCPClient._process_tool_result returns str(result)
    when isError=False and no content is present.
    """
    client = MCPClient()

    dummy_result = DummyResult(is_error=False, contents=None)

    result_str = client._process_tool_result(dummy_result)

