def mcp_client():
    return MCPClient()


def test_process_tool_result_returns_content_on_error_with_text(mcp_client):
    # Simulate a result with isError=True but with content that has text
    content_text = "This is an error message from MCP server"
    dummy_content = DummyContent(content_text)
    dummy_result = DummyResult(is_error=True, contents=[dummy_content])

    # Call the internal method _process_tool_result with dummy_result
    # It should return the content text instead of raising ToolError
    result = mcp_client._process_tool_result(dummy_result)
    assert result == content_text


def test_process_tool_result_raises_tool_error_on_error_without_text(mcp_client):
    # Simulate a result with isError=True but content is empty or no text attribute
    dummy_result = DummyResult(is_error=True, contents=None)

    # It should raise ToolError because no content text to return
    with pytest.raises(ToolError) as excinfo:
        mcp_client._process_tool_result(dummy_result)
    assert "MCP tool error" in str(excinfo.value)


def test_process_tool_result_returns_single_text_content(mcp_client):
    # Simulate a successful result with one content item with text
    content_text = "Successful result text"
    dummy_content = DummyContent(content_text)
    dummy_result = DummyResult(is_error=False, contents=[dummy_content])

    result = mcp_client._process_tool_result(dummy_result)
    assert result == content_text


def test_process_tool_result_returns_list_of_text_contents(mcp_client):
    # Simulate a successful result with multiple content items with text
    contents = [DummyContent("text1"), DummyContent("text2")]
    dummy_result = DummyResult(is_error=False, contents=contents)

    result = mcp_client._process_tool_result(dummy_result)
    assert isinstance(result, list)
    assert result == ["text1", "text2"]


def test_process_tool_result_returns_str_for_unexpected_format(mcp_client):
    # Simulate a result with no content attribute and no isError attribute
    class WeirdResult:
        def __str__(self):
            return "weird result"

    weird_result = WeirdResult()
    result = mcp_client._process_tool_result(weird_result)
    assert result == "weird result"[0m
