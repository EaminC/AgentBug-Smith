        self.isError = is_error
        self.content = contents


@pytest.fixture
def mcp_client():
    return MCPClient()


def test_process_tool_result_error_with_content_returns_text(mcp_client):
    # Simulate a result with isError=True but with content that has text
    dummy_text = "This is an error message from MCP server"
    content_obj = DummyContent(dummy_text)
    result = DummyResult(is_error=True, contents=[content_obj])

    # The fixed code should return the text content instead of raising ToolError
    output = mcp_client._process_tool_result(result)

    assert output == dummy_text


def test_process_tool_result_error_without_content_raises_tool_error(mcp_client):
    # Simulate a result with isError=True but no content or empty content
    result = DummyResult(is_error=True, contents=None)

    with pytest.raises(ToolError) as excinfo:
        mcp_client._process_tool_result(result)

    assert "MCP tool error" in str(excinfo.value)


