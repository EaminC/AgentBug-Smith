    def __init__(self, is_error, contents=None):
        self.isError = is_error
        self.content = contents


@pytest.fixture
def mcp_client():
    return MCPClient()


def test_process_tool_result_with_error_and_content_returns_text(mcp_client):
    # Simulate a result with isError=True but with content containing text
    content_text = "This is an error message from MCP server"
    dummy_content = DummyContent(content_text)
    dummy_result = DummyResult(is_error=True, contents=[dummy_content])

    # We patch the internal call that _process_tool_result would use to simulate the MCP server response
    # But we do not patch _process_tool_result itself; we want to test the real method
