    with pytest.raises(ToolError):
        client._process_tool_result(result)


def test_process_tool_result_non_error_with_content_returns_text(client):
    # Simulate a successful result with content text
    content_text = "Successful result text"
    content_obj = DummyContent(content_text)
    result = DummyResult(is_error=False, content=[content_obj])

    output = client._process_tool_result(result)
    assert output == content_text


def test_process_tool_result_non_error_with_multiple_contents_returns_list(client):
    # Simulate a successful result with multiple content texts
    content_texts = ["text1", "text2", "text3"]
    content_objs = [DummyContent(t) for t in content_texts]
    result = DummyResult(is_error=False, content=content_objs)

    output = client._process_tool_result(result)
    assert output == content_texts


def test_process_tool_result_no_content_returns_str(client):
    # Simulate a result with no content attribute or empty content
    class ResultNoContent:
        def __str__(self):
            return "no content result"

    result = ResultNoContent()
    output = client._process_tool_result(result)
    assert output == "no content result"[0m
