from unittest.mock import patch, MagicMock
from dapr_agents.tool.mcp.client import MCPClient, ToolError


class DummyContent:
    def __init__(self, text):
        self.text = text


class DummyResult:
    def __init__(self, is_error, contents):
        self.isError = is_error
        self.content = contents


def test_process_tool_result_returns_content_on_error_with_text():
    """
    Test that MCPClient._process_tool_result returns the content text even if isError is True,
    instead of raising ToolError, when content.text is present.
    """
    client = MCPClient()

    # Prepare a dummy result with isError=True but with content that has .text
    dummy_text = "This is an error message from MCP server"
    dummy_content = [DummyContent(dummy_text)]
    dummy_result = DummyResult(is_error=True, contents=dummy_content)

    # Call the real _process_tool_result method
    # It should return the text content instead of raising ToolError
    result = client._process_tool_result(dummy_result)

    assert result == dummy_text, "Expected to return the content text even if isError is True"


def test_process_tool_result_raises_toolerror_when_error_and_no_text():
    """
    Test that MCPClient._process_tool_result raises ToolError when isError is True and
    no content.text is present.
    """
    client = MCPClient()

    # Prepare a dummy result with isError=True and content without .text attribute
    class ContentNoText:
        pass

    dummy_content = [ContentNoText()]
    dummy_result = DummyResult(is_error=True, contents=dummy_content)

    with pytest.raises(ToolError) as excinfo:
        client._process_tool_result(dummy_result)

    assert "MCP tool error" in str(excinfo.value)


def test_process_tool_result_returns_content_when_no_error():
    """
    Test that MCPClient._process_tool_result returns content text when isError is False.
    """
    client = MCPClient()

    dummy_text = "Normal successful result"
    dummy_content = [DummyContent(dummy_text)]
    dummy_result = DummyResult(is_error=False, contents=dummy_content)

    result = client._process_tool_result(dummy_result)

    assert result == dummy_text


