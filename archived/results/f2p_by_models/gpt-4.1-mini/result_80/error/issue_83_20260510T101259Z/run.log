        self.text = text


class DummyResult:
    def __init__(self, is_error, content=None):
        self.isError = is_error
        self.content = content


@pytest.fixture
def mcp_client():
    return MCPClient()


def test_process_tool_result_error_with_content_returns_text(mcp_client):
    # This simulates the MCP server returning an error but with content containing text.
    # According to the fix, the client should return the text content instead of raising ToolError.
    content_text = "This is an error message from MCP server"
    dummy_content = [DummyContent(content_text)]
    dummy_result = DummyResult(is_error=True, content=dummy_content)

    # Call the internal _process_tool_result method with dummy_result
    # It should return the content text instead of raising ToolError
    result = mcp_client._process_tool_result(dummy_result)
    assert result == content_text


def test_process_tool_result_error_without_content_raises_tool_error(mcp_client):
    # This simulates the MCP server returning an error with no content or content without text.
    # The client should raise ToolError in this case.
    dummy_result = DummyResult(is_error=True, content=None)
    with pytest.raises(ToolError):
        mcp_client._process_tool_result(dummy_result)

    dummy_result_empty_content = DummyResult(is_error=True, content=[])
    with pytest.raises(ToolError):
        mcp_client._process_tool_result(dummy_result_empty_content)

    # Content without text attribute
    dummy_content_no_text = [object()]
    dummy_result_no_text = DummyResult(is_error=True, content=dummy_content_no_text)
    with pytest.raises(ToolError):
        mcp_client._process_tool_result(dummy_result_no_text)


def test_process_tool_result_no_error_with_content_returns_text(mcp_client):
