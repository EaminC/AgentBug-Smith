from dapr_agents.tool.mcp.client import MCPClient, ToolError


class DummyContent:
    def __init__(self, text):
        self.text = text


class DummyResult:
    def __init__(self, is_error, contents):
        self.isError = is_error
        self.content = contents


def test_process_tool_result_returns_content_on_error_with_text():
    client = MCPClient()

    # Result with isError True but content with text present
    content_text = "This is an error message from MCP server"
    dummy_content = DummyContent(content_text)
    result = DummyResult(is_error=True, contents=[dummy_content])

    # The fixed code should return the content text instead of raising ToolError
    output = client._process_tool_result(result)
    assert output == content_text, "Should return content text even if isError is True"


def test_process_tool_result_raises_tool_error_when_no_content_text():
    client = MCPClient()

    # Result with isError True but content is empty or no text attribute
    result = DummyResult(is_error=True, contents=[])

    with pytest.raises(ToolError) as excinfo:
        client._process_tool_result(result)
    assert "MCP tool error" in str(excinfo.value)


def test_process_tool_result_returns_content_when_no_error():
    client = MCPClient()

    # Result with isError False and content with text present
    content_text = "Normal successful response"
    dummy_content = DummyContent(content_text)
    result = DummyResult(is_error=False, contents=[dummy_content])

    output = client._process_tool_result(result)
    assert output == content_text


def test_process_tool_result_returns_str_for_unexpected_format():
    client = MCPClient()

    # Result with no content attribute and no isError attribute
    class WeirdResult:
        def __str__(self):
            return "weird result string"

    result = WeirdResult()
    output = client._process_tool_result(result)
    assert output == "weird result string" or isinstance(output, str)


def test_process_tool_result_returns_list_of_texts_when_multiple_contents():
    client = MCPClient()

    # Result with multiple content items each having text attribute
    texts = ["text1", "text2", "text3"]
    contents = [DummyContent(t) for t in texts]
    result = DummyResult(is_error=False, contents=contents)

    output = client._process_tool_result(result)
    assert output == texts


def test_process_tool_result_prioritizes_content_text_over_error_message():
    client = MCPClient()

    # Result with isError True and multiple content items, only one with text
    contents = [SimpleNamespace(), DummyContent("error text from content")]
    result = DummyResult(is_error=True, contents=contents)

    # The fixed code returns the content text, not raising ToolError
    output = client._process_tool_result(result)
    assert output == "error text from content"


# The tests above exercise the behavior of _process_tool_result to ensure:
# - It returns content text when present even if isError is True (fix)
# - It raises ToolError only when no content text is present on error
# - It returns string or list of strings for normal content
# - It returns string fallback for unexpected result format[0m
