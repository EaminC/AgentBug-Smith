class DummyResult:
    def __init__(self, is_error, contents=None):
        self.isError = is_error
        self.content = contents


@pytest.fixture
def mcp_client():
    return MCPClient()


def test_process_tool_result_with_error_and_content_returns_content(mcp_client):
    # Simulate a result with isError=True but with content that has text
    content_text = "This is an error message from MCP server"
    dummy_content = DummyContent(content_text)
    dummy_result = DummyResult(is_error=True, contents=[dummy_content])

    # Call the real _process_tool_result method and expect it to return the text content,
    # not raise ToolError
    returned = mcp_client._process_tool_result(dummy_result)
    assert returned == content_text


def test_process_tool_result_with_error_and_no_content_raises_toolerror(mcp_client):
    # Simulate a result with isError=True but no content
    dummy_result = DummyResult(is_error=True, contents=None)

    with pytest.raises(ToolError) as excinfo:
        mcp_client._process_tool_result(dummy_result)
    assert "MCP tool error" in str(excinfo.value)


def test_process_tool_result_with_multiple_content_texts_returns_list(mcp_client):
