from dapr_agents.tool.mcp.client import MCPClient, ToolError


class DummyContent:
    def __init__(self, text):
        self.text = text


class DummyResult:
    def __init__(self, is_error, contents):
        self.isError = is_error
        self.content = contents


@pytest.fixture
def mcp_client():
    return MCPClient()


def test_process_tool_result_returns_content_on_error_with_text(mcp_client):
    # Simulate a result with isError=True but with content that has text
    dummy_text = "This is an error message from MCP server"
    dummy_content = DummyContent(dummy_text)
    dummy_result = DummyResult(is_error=True, contents=[dummy_content])

    # The method _process_tool_result is internal, but we test it directly
    # It should return the text content instead of raising ToolError
    result = mcp_client._process_tool_result(dummy_result)
    assert result == dummy_text


def test_process_tool_result_raises_tool_error_on_error_without_text(mcp_client):
    # Simulate a result with isError=True but content is empty or no text attribute
    dummy_result = DummyResult(is_error=True, contents=[])

    with pytest.raises(ToolError) as excinfo:
        mcp_client._process_tool_result(dummy_result)
    assert "MCP tool error" in str(excinfo.value)


def test_process_tool_result_returns_content_when_no_error(mcp_client):
    # Simulate a result with isError=False and content with text
    texts = ["output1", "output2"]
    dummy_contents = [DummyContent(t) for t in texts]
    dummy_result = DummyResult(is_error=False, contents=dummy_contents)

    result = mcp_client._process_tool_result(dummy_result)
    # Should return list of texts because multiple content items
    assert result == texts


