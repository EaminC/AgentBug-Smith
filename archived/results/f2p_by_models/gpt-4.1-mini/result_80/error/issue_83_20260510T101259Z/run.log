    def __init__(self, is_error=False, contents=None):
        self.isError = is_error
        self.content = contents


@pytest.fixture
def mcp_client():
    return MCPClient()


def test_process_tool_result_returns_content_when_error_with_text(mcp_client):
    # Simulate a result with isError=True but with content that has text
    content_text = "This is an error message from MCP server"
    dummy_content = DummyContent(content_text)
    dummy_result = DummyResult(is_error=True, contents=[dummy_content])

    # The fixed code returns the content text instead of raising ToolError
    result = mcp_client._process_tool_result(dummy_result)
    assert result == content_text


def test_process_tool_result_raises_toolerror_when_error_without_text(mcp_client):
    # Simulate a result with isError=True but no content or content without text attribute
    dummy_result = DummyResult(is_error=True, contents=None)

    with pytest.raises(ToolError) as excinfo:
        mcp_client._process_tool_result(dummy_result)
    assert "MCP tool error" in str(excinfo.value)


