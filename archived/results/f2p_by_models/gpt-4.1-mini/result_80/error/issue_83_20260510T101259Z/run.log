def test_process_tool_result_with_error_and_content(mcp_client):
    """
    This test verifies that when MCPClient._process_tool_result is given a result
    with isError=True but with content that includes text, it returns the text content
    instead of raising ToolError. This behavior is fixed by the patch.

    Before the patch, this would raise ToolError and content would be None.
    After the patch, it returns the text content.
    """
    # Prepare a dummy result with isError True but with content containing text
    dummy_text = "This is an error message from MCP server"
