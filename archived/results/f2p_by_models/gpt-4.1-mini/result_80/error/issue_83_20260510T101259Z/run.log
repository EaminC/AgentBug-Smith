from unittest.mock import MagicMock, patch
from dapr_agents.tool.mcp.client import MCPClient, ToolError


class DummyContent:
    def __init__(self, text):
        self.text = text


class DummyResult:
    def __init__(self, is_error, contents):
        self.isError = is_error
        self.content = contents


def test_process_tool_result_returns_content_on_error_with_text():
    """
    Test that MCPClient._process_tool_result returns content.text even if isError is True,
    instead of raising ToolError immediately.
    """
    client = MCPClient()

    # Create a dummy result with isError=True but content with text
    dummy_text = "This is an error message from MCP server"
    dummy_content = DummyContent(dummy_text)
    dummy_result = DummyResult(is_error=True, contents=[dummy_content])

    # Call _process_tool_result and expect it to return the content text, not raise
    result = client._process_tool_result(dummy_result)
    assert result == dummy_text


def test_process_tool_result_raises_toolerror_when_error_and_no_content_text():
    """
    Test that MCPClient._process_tool_result raises ToolError when isError is True
    and no content with text is present.
    """
    client = MCPClient()

    # Create a dummy result with isError=True but content is empty or no text attribute
    dummy_result = DummyResult(is_error=True, contents=[])

    with pytest.raises(ToolError) as excinfo:
        client._process_tool_result(dummy_result)
    assert "MCP tool error" in str(excinfo.value)


def test_process_tool_result_returns_content_when_no_error():
    """
    Test that MCPClient._process_tool_result returns content text when isError is False.
    """
    client = MCPClient()

    # Create dummy result with isError=False and multiple content with text
    contents = [DummyContent("part1"), DummyContent("part2")]
    dummy_result = DummyResult(is_error=False, contents=contents)

    result = client._process_tool_result(dummy_result)
    assert result == ["part1", "part2"]


