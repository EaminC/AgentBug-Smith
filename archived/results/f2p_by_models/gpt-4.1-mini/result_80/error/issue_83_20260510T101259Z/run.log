from dapr_agents.tool.mcp.client import MCPClient, ToolError


class DummyContent:
    def __init__(self, text):
        self.text = text


class DummyResult:
    def __init__(self, is_error=False, contents=None):
        self.isError = is_error
        self.content = contents


@pytest.fixture
def mcp_client():
    return MCPClient()


def test_process_tool_result_returns_content_when_error_with_text(mcp_client):
    # Simulate a result with isError=True but with content containing text
    content_text = "This is an error message from MCP server"
    dummy_content = DummyContent(content_text)
    dummy_result = DummyResult(is_error=True, contents=[dummy_content])

    # The method _process_tool_result is internal, but we test it directly.
    # It should return the content text instead of raising ToolError.
    returned = mcp_client._process_tool_result(dummy_result)
    assert returned == content_text


def test_process_tool_result_raises_toolerror_when_error_without_content(mcp_client):
    # Simulate a result with isError=True but no content
    dummy_result = DummyResult(is_error=True, contents=None)

    with pytest.raises(ToolError) as exc_info:
        mcp_client._process_tool_result(dummy_result)
    assert "MCP tool error" in str(exc_info.value)


def test_process_tool_result_returns_content_when_no_error(mcp_client):
    # Simulate a result with isError=False and content with multiple texts
    contents = [DummyContent("part1"), DummyContent("part2")]
    dummy_result = DummyResult(is_error=False, contents=contents)

    returned = mcp_client._process_tool_result(dummy_result)
    assert returned == ["part1", "part2"]


def test_process_tool_result_returns_str_when_no_content_and_no_error(mcp_client):
