        with mock.patch("questionary.confirm", side_effect=[True]):
            # Run the chain's run method, which should generate the plan and tasks
            # We expect the plan to include the sentiment analysis task, not a generic tabular task
            # The run method loops until tasks are done or aborted, so we limit to one iteration by setting current_task to tasks count
            chain.plan.current_task = 0
            chain.plan.tasks = None
            chain.entry_file = None
