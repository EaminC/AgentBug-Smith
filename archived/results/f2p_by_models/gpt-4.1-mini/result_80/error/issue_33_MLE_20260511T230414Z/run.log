import tempfile
import unittest
from unittest.mock import patch, MagicMock

from agent.function.chain import Chain
from agent.utils.files import read_csv_file


class TestChainTaskModelArchConfirmation(unittest.TestCase):
    def setUp(self):
        # Setup a temporary directory to simulate project environment
        self.temp_dir = tempfile.TemporaryDirectory()
        self.project_path = self.temp_dir.name

        # Patch config.read to simulate a project config with path
        patcher_config = patch('agent.utils.config.read')
        self.addCleanup(patcher_config.stop)
        self.mock_config_read = patcher_config.start()
        self.mock_config_read.return_value = {'project': {'path': self.project_path}}

        # Patch os.path.exists to simulate presence of project plan file and dataset file
        patcher_exists = patch('os.path.exists')
        self.addCleanup(patcher_exists.stop)
        self.mock_os_path_exists = patcher_exists.start()
        self.mock_os_path_exists.side_effect = self._mocked_os_path_exists

        # Patch questionary to simulate user inputs
        patcher_questionary = patch('agent.function.chain.questionary')
        self.addCleanup(patcher_questionary.stop)
        self.mock_questionary = patcher_questionary.start()

        # Patch Chain.update_project_state to avoid file writes
        patcher_update = patch.object(Chain, 'update_project_state')
        self.addCleanup(patcher_update.stop)
        self.mock_update_project_state = patcher_update.start()

        # Patch Chain.gen_file_name to return a fixed file name
        patcher_gen_file_name = patch.object(Chain, 'gen_file_name')
        self.addCleanup(patcher_gen_file_name.stop)
        self.mock_gen_file_name = patcher_gen_file_name.start()
        self.mock_gen_file_name.return_value = os.path.join(self.project_path, 'main.py')

        # Patch the agent attribute's req_based_generator to simulate responses
        patcher_req_based_generator = patch('agent.function.chain.req_based_generator')
        self.addCleanup(patcher_req_based_generator.stop)
        self.mock_req_based_generator = patcher_req_based_generator.start()

        # Patch plan_generator to simulate task plan generation
        patcher_plan_generator = patch('agent.function.chain.plan_generator')
        self.addCleanup(patcher_plan_generator.stop)
        self.mock_plan_generator = patcher_plan_generator.start()

        # Patch match_plan to simulate task matching
        patcher_match_plan = patch('agent.function.chain.match_plan')
        self.addCleanup(patcher_match_plan.stop)
        self.mock_match_plan = patcher_match_plan.start()

        # Prepare dummy dataset CSV file
        self.dataset_path = os.path.join(self.project_path, 'dummy.csv')
        with open(self.dataset_path, 'w', encoding='utf-8') as f:
            f.write("text,label\nhello world,positive\nfoo bar,negative\n")

        # Setup mock responses for req_based_generator for different prompts
        def req_based_side_effect(requirement, prompt, agent):
            if 'dataset_detect' in prompt:
                return 'csv_data'
            if 'dataset_select' in prompt:
                return self.dataset_path
            if 'task_select' in prompt:
                # Simulate that with data, task is sentiment analysis
                if 'sentiment' in requirement.lower():
                    return 'Sentiment Analysis'
                return 'Tabular Classification'
            if 'model_select' in prompt:
                return 'BERT'
            return 'unknown'

        self.mock_req_based_generator.side_effect = req_based_side_effect

        # Setup mock for plan_generator to return tasks list
        self.mock_plan_generator.return_value = {
            'tasks': [
                {'name': 'Data Collection'},
                {'name': 'Sentiment Analysis'},
                {'name': 'Model Training'}
            ]
        }

        # Setup mock for match_plan to convert dict to a simple object with name attribute
        def match_plan_side_effect(task_dict):
            class Task:
                def __init__(self, name):
                    self.name = name
            return Task(task_dict['name'])

        self.mock_match_plan.side_effect = match_plan_side_effect

        # Setup questionary responses for confirms and text inputs
        # The sequence of calls:
        # - confirm use file? -> True
        # - confirm plan? -> True
        # - confirm install dependencies? -> True
        # - confirm continue? -> True (if any)
        # - text inputs for requirements and dataset path if needed
        self.mock_questionary.confirm.side_effect = [True, True, True]
        self.mock_questionary.text.side_effect = [
            "I want to do sentiment analysis on text data.",  # user requirement input
            self.dataset_path  # dataset path input if asked
        ]

        # Patch run_command to avoid actual installations
        patcher_run_command = patch('agent.function.chain.run_command')
        self.addCleanup(patcher_run_command.stop)
        self.mock_run_command = patcher_run_command.start()

        # Patch Chain.console to capture logs
        patcher_console = patch('agent.function.chain.Console')
        self.addCleanup(patcher_console.stop)
        self.mock_console_class = patcher_console.start()
        self.mock_console = MagicMock()
        self.mock_console_class.return_value = self.mock_console

    def tearDown(self):
        self.temp_dir.cleanup()

    def _mocked_os_path_exists(self, path):
        # Simulate that project plan file and dataset file exist
        if path == os.path.join(self.project_path, 'project.yml'):
            return True
        if path == self.dataset_path:
            return True
        # Also simulate that generated entry file exists
        if path == os.path.join(self.project_path, 'main.py'):
            return True
        return False

    def test_task_and_model_architecture_confirmed_after_data(self):
        # Instantiate Chain which should read config and project path
        chain = Chain()

        # Run the chain.start() method which triggers the planning flow
        # It should:
        # - ask for requirement (mocked)
        # - detect data kind as csv_data
        # - ask for dataset path (mocked)
        # - detect task as Sentiment Analysis (not generic tabular)
        # - detect model architecture as BERT
        # - generate tasks accordingly
        # - confirm plan (mocked as True)
        # - proceed without errors

        # We patch Chain.start to run the main loop once and then break to avoid infinite loop
        # Instead, we call the private method _run_once if exists, else run start and catch SystemExit

        # The Chain.start method runs an infinite while loop; we patch the loop to run once
        # But since the code does not expose a single-step method, we will run start and expect it to exit normally

        # The test is to ensure that the task detected is 'Sentiment Analysis' not 'Tabular Classification'

        # Run and capture logs to check the detected task
        chain.start()

        # Check that the console logged the correct detected task
        logs = []
        for call in self.mock_console.log.call_args_list:
            arg = call[0][0]
            logs.append(arg)

        # Check that the detected task is 'Sentiment Analysis'
        detected_task_logs = [log for log in logs if 'Task detected' in log]
        self.assertTrue(any('Sentiment Analysis' in log for log in detected_task_logs),
                        "The detected task should be 'Sentiment Analysis' after providing data.")

        # Check that the model architecture selected is 'BERT'
        model_arch_logs = [log for log in logs if 'Model architecture selected' in log]
        self.assertTrue(any('BERT' in log for log in model_arch_logs),
                        "The model architecture should be 'BERT'.")

        # Check that tasks list in plan contains 'Sentiment Analysis'
        task_names = [task.name for task in chain.plan.tasks]
        self.assertIn('Sentiment Analysis', task_names,
                      "The plan tasks should include 'Sentiment Analysis'.")

        # Check that the requirement was updated to include dataset sample
        self.assertIn('Dataset Sample:', chain.requirement,
                      "The requirement should be updated with dataset sample.")

        # Check that update_project_state was called at least once
        self.mock_update_project_state.assert_called()

        # Check that the entry file was generated and confirmed
        self.mock_gen_file_name.assert_called()


if __name__ == '__main__':
    unittest.main()[0m
