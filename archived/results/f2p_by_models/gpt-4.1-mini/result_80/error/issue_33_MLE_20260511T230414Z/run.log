         patch("agent.function.chain.plan_generator") as mock_plan_gen, \
         patch("agent.function.chain.match_plan") as mock_match_plan, \
         patch("agent.function.chain.run_command") as mock_run_cmd:

        # Simulate user entering a vague requirement
        mock_text.side_effect = [
            "I want to analyze sentiment",  # user requirement input
            "/tmp/dummy_dataset.csv"         # user dataset path input
        ]

        # Simulate user confirming the plan
        mock_confirm.side_effect = [True, True]

        # Simulate req_based_generator responses:
        # First call: dataset detection returns 'no_data_information_provided'
        # Second call: dataset selection returns a CSV path (simulate)
        # Third call: task selection returns 'Sentiment Analysis'
        # Fourth call: model selection returns 'BERT'
        def req_gen_side_effect(requirement, prompt, agent):
            if "dataset detect" in prompt.lower():
                return "no_data_information_provided"
            elif "dataset select" in prompt.lower():
                return "/tmp/dummy_dataset.csv"
            elif "task select" in prompt.lower():
                return "Sentiment Analysis"
            elif "model select" in prompt.lower():
                return "BERT"
            return ""
        mock_req_gen.side_effect = req_gen_side_effect

        # Simulate read_csv_file returning a sample dataset preview
        mock_read_csv.return_value = [["text", "label"], ["I love this!", "positive"], ["Bad movie", "negative"]]

        # Simulate plan_generator returning a plan dict with tasks
        mock_plan_gen.return_value = {
            "tasks": [
                {"name": "Data Collection"},
                {"name": "Model Training"}
            ]
        }

        # Simulate match_plan returning a simple task object with name attribute
        class DummyTask:
            def __init__(self, name):
                self.name = name
        mock_match_plan.side_effect = lambda d: DummyTask(d["name"])

        # Run the chain's main loop but patch is_running to False after first iteration to avoid infinite loop
        # We patch Chain._Chain__run_loop to only run one iteration for test
        # But since no such method, we simulate by patching questionary.confirm to abort after first plan confirmation
        # Actually, the code returns after plan confirmation if user declines, so we simulate user accepting plan

        # Run the chain's run method (which contains the main loop)
        # It should generate a plan with task 'Sentiment Analysis' and model 'BERT' after dataset is provided
        with patch.object(chain_instance, "update_project_state") as mock_update_state:
            with patch.object(chain_instance.console, "log") as mock_console_log:
