                    assert found_dataset_log, "Dataset path was not logged"

                    # Check that dataset sample is logged (some text from dummy csv)
                    found_sample_log = any("I love this product" in log for log in logs)
                    assert found_sample_log, "Dataset sample was not logged"


def test_read_csv_file_limit_and_column_only(tmp_path):
    # Create a CSV file with 5 rows and 2 columns
    csv_file = tmp_path / "test.csv"
    csv_file.write_text("col1,col2\n1,a\n2,b\n3,c\n4,d\n5,e\n")

    # Test limit parameter
    df_limit_3 = read_csv_file(str(csv_file), limit=3)
    assert len(df_limit_3) == 3

    # Test column_only parameter
    columns = read_csv_file(str(csv_file), column_only=True)
