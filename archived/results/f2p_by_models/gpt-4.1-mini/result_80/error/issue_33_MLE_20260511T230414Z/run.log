def test_task_and_model_selection_reflects_user_requirement(dummy_chain):
    """
    Test that when user provides a specific requirement (e.g., sentiment analysis),
    the generated task and model reflect that requirement rather than a generic tabular task.
    This test should fail on buggy code (which ignores user data and returns generic tasks),
