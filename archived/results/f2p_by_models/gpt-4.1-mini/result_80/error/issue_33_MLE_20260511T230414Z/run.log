from agent.utils import config


@pytest.fixture
def setup_project(tmp_path):
    # Setup a dummy project directory with minimal required files
    project_dir = tmp_path / "dummy_project"
    project_dir.mkdir()
    project_yml = project_dir / "project.yml"
    project_yml.write_text("name: dummy_project\n")
    # Create a dummy dataset CSV file
    dataset_csv = project_dir / "dummy_data.csv"
    dataset_csv.write_text("text,label\nhello,positive\nworld,negative\nfoo,neutral\n")
    return project_dir, dataset_csv


def test_task_and_model_arch_confirmation_after_user_data(setup_project, monkeypatch):
    project_dir, dataset_csv = setup_project

    # Patch config to simulate the project path is set
    monkeypatch.setattr(config, "read", lambda: {"project": {"path": str(project_dir)}})

    # Patch questionary to simulate user inputs and confirmations
    import questionary

    # We simulate the sequence of prompts:
    # 1. User requirement input
    # 2. Confirm plan usage
    # 3. Confirm file usage
    # 4. Confirm install dependencies
    # 5. Confirm plan usage again if needed

    # We prepare a side effect list for questionary.text and questionary.confirm
    # The Chain.gen_file_name calls questionary.confirm("Do you want to use the file?")
    # The Chain.run calls questionary.confirm("Are you sure to use this plan?")
    # The Chain.run calls questionary.text for user requirement and dataset path

    # We will simulate:
    # - User requirement: "I want to do sentiment analysis"
    # - Confirm file usage: True
    # - Confirm plan usage: True
    # - Confirm install dependencies: True

    # Also, the plan_generator and req_based_generator are internal functions that call the agent model.
    # We will patch them to return controlled outputs.

    # Patch questionary.text
    def questionary_text_side_effect(prompt):
        if "requirements" in prompt.lower():
            return "I want to do sentiment analysis"
        if "csv data path" in prompt.lower():
            return str(dataset_csv)
        return ""

    # Patch questionary.confirm
    def questionary_confirm_side_effect(prompt):
        # Always confirm yes for all confirmations
        return True

    monkeypatch.setattr(questionary, "text", mock.Mock(side_effect=questionary_text_side_effect))
    monkeypatch.setattr(questionary, "confirm", mock.Mock(side_effect=questionary_confirm_side_effect))

    # Patch internal agent function req_based_generator and plan_generator to simulate AI responses
    import agent.function.chain as chain_module

    # Save original functions to restore later
    original_req_based_generator = chain_module.req_based_generator
    original_plan_generator = chain_module.plan_generator

    def fake_req_based_generator(requirement, prompt, agent):
        # Return different outputs depending on prompt function
        prompt_str = prompt.strip().lower()
        if "dataset_detect" in prompt_str:
            # Simulate detection of csv_data
            return "csv_data"
        if "dataset_select" in prompt_str:
            # Return dataset path (simulate user providing data)
            return str(dataset_csv)
        if "task_select" in prompt_str:
            # Return a specific task related to sentiment analysis
            return "Sentiment Analysis"
        if "model_select" in prompt_str:
            # Return a model architecture suitable for sentiment analysis
            return "bert-base-uncased"
        return "unknown"

    def fake_plan_generator(requirement, agent, dataset, task_name):
        # Return a plan dict with tasks matching the task_name
        return {
            "tasks": [
                {"name": task_name, "description": "Perform sentiment analysis on text data."},
                {"name": "Model Training", "description": "Train the selected model."}
            ]
        }

    monkeypatch.setattr(chain_module, "req_based_generator", fake_req_based_generator)
    monkeypatch.setattr(chain_module, "plan_generator", fake_plan_generator)

    # Instantiate Chain and run it; it should process the user requirement, detect data, and confirm task/model
    chain = Chain()

    # Run chain.run() should complete without SystemExit or errors and produce tasks matching sentiment analysis
    try:
        chain.run()
    except SystemExit as e:
        pytest.fail(f"Chain.run() exited unexpectedly with SystemExit: {e}")

    # After run, check that the plan tasks include the expected task "Sentiment Analysis"
    assert chain.plan.tasks is not None
    task_names = [task.name for task in chain.plan.tasks]
    assert "Sentiment Analysis" in task_names

    # Check that the model architecture was appended to the requirement (indirectly)
    assert "bert-base-uncased" in chain.requirement

    # Restore original functions
    monkeypatch.setattr(chain_module, "req_based_generator", original_req_based_generator)
    monkeypatch.setattr(chain_module, "plan_generator", original_plan_generator)[0m
