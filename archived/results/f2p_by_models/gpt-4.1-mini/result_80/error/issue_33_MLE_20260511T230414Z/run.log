    chain.update_project_state = lambda: None
    # Patch gen_file_name to return a dummy file path
    chain.gen_file_name = lambda req: "dummy_entry.py"
    # Patch console.log to suppress output during test
    chain.console.log = lambda *args, **kwargs: None

    # Run the chain main loop but break after first iteration to avoid infinite loop
    # We patch the questionary.confirm to always confirm plan usage and installation
    # The chain should generate tasks including Sentiment Analysis and model arch bert-base-uncased
    # We verify that tasks are set and include the expected task name
    with patch("agent.function.chain.questionary.confirm", side_effect=[True, True]):
        # Run the internal method _run_chain_loop which is the main loop (simulate)
