                    # We will call chain.run() if exists, else call chain._run_loop() if exists

                    # Since no such method, we call chain._run_loop = chain._Chain__run_loop if it exists

                    # The code snippet shows the main loop inside Chain.__init__ or a method called run()?

                    # Actually, the main loop is inside Chain.__init__ in the snippet, so instantiating Chain runs the loop

                    # So instantiating Chain will run the main loop, so we catch SystemExit to stop test

                    with pytest.raises(SystemExit):
                        Chain()

