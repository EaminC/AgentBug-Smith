[32mFROM python:3.11-slim AS test_builder

WORKDIR /app

# Copy entire repo to ensure injected tests are present
COPY . .

# Upgrade pip, setuptools and wheel early to avoid import issues
RUN python -m pip install --upgrade pip setuptools wheel

# Install all dependencies including dev/test and the project itself
RUN pip install -r requirements.txt && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout

# Preflight import check to fail fast if core modules missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests with unittest as per .github workflow
RUN python -m unittest discover tests

# --- Minimal runtime image ---
