    # Third call: task selection returns 'Sentiment Analysis'
    # Fourth call: model selection returns 'BERT'
    def req_based_side_effect(requirement, prompt, agent):
        if "dataset detect" in prompt.lower():
            return "csv_data"
        if "dataset select" in prompt.lower():
            return str(tmp_path / "dummy.csv")
        if "task select" in prompt.lower():
            return "Sentiment Analysis"
        if "model select" in prompt.lower():
            return "BERT"
        return ""

    mock_req_based_generator.side_effect = req_based_side_effect

    # Simulate plan_generator returns a plan with one task "Sentiment Analysis"
    mock_plan_generator.return_value = {
        "tasks": [
            {"name": "Sentiment Analysis", "description": "Analyze sentiment of text data"}
        ]
    }

