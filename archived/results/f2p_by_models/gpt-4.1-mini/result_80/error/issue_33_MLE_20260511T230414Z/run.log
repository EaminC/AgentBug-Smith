                assert "Data Collection" in task_names
                assert "Model Training" in task_names

                # Assert that the requirement includes dataset sample and ML task info
                assert "Dataset Sample" in chain_instance.requirement
                assert "ML Task: Sentiment Analysis" in chain_instance.requirement

                # Assert that console.log was called with task detected and model architecture selected
                logs = [call.args[0] for call in mock_console_log.call_args_list]
                assert any("Task detected" in log for log in logs)
                assert any("Model architecture selected" in log for log in logs)


