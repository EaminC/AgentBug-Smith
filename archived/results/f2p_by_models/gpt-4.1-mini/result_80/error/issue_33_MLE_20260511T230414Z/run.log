def test_chain_aborts_if_user_rejects_plan(chain_instance):
    chain = chain_instance
    # Patch questionary.confirm to simulate user rejecting the plan
    with mock.patch("questionary.confirm", side_effect=[False]):
        # Patch chain.update_project_state to avoid side effects
        with mock.patch.object(chain, "update_project_state") as mock_update:
            # Patch console.log to capture logs
            with mock.patch.object(chain.console, "log") as mock_log:
                # Run the chain and expect it to return None (abort)
                result = chain.run()
                # It should return None due to user abort
                assert result is None
                # The log should contain abort message
                found_abort_msg = any("not satisfied" in str(call.args[0]) for call in mock_log.call_args_list)
                assert found_abort_msg


