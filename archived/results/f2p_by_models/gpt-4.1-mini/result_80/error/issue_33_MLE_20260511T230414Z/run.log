    from agent.function.chain import run_command
    monkeypatch.setattr("agent.function.chain.run_command", lambda cmd: None)

    # Run chain.run and catch SystemExit to avoid test exit
    with pytest.raises(SystemExit) as excinfo:
        chain.run()

    # After run, check that the plan tasks include 'Sentiment Analysis Task'
    task_names = [task.name for task in chain.plan.tasks]
