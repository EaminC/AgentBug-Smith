[32mFROM python:3.12-slim AS test_builder

# Set workdir to /app as standard location
WORKDIR /app

# Copy entire repository including python/ subfolder with metadata and source
COPY . .

# Install system dependencies needed for building Python packages (wheel, build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel early to avoid packaging issues
RUN python -m pip install --upgrade pip setuptools wheel

# Install uv (ultra-fast python package manager) if used, else fallback to pip install based on presence of lockfiles
# Assumption: uv is the preferred package tool since Makefile and CI use uv for installs and tests
RUN if [ -f "./python/uv.lock" ]; then \
      pip install litellm pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" pytest-xdist pytest-timeout && \
      uv sync --locked --all-extras --dev; \
    else \
      # fallback: install requirements if any and editable install local package plus test deps \
      pip install -r ./python/requirements.txt 2>/dev/null || true && \
      pip install -e ./python && \
      pip install litellm pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" pytest-xdist pytest-timeout; \
    fi

# Preflight import check for core packages to fail fast if missing
RUN python -c "import pkg_resources, pytest; print('preflight ok')"

# ENV for Forge API access as mandated
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=${FORGE_API_KEY} \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Execute tests as per Makefile and CI workflow: run pytest on python source folder
RUN uv run pytest ./python

# Minimal runtime image stage
FROM python:3.12-slim AS runtime

WORKDIR /app

COPY --from=test_builder /app/python /app/python

# Install only production dependencies (assuming uv.lock present, else fallback)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel

RUN if [ -f "./python/uv.lock" ]; then \
      pip install litellm && \
      uv sync --locked --only-group main; \
    else \
      pip install -r ./python/requirements.txt 2>/dev/null || true && \
      pip install ./python && \
      pip install litellm; \
    fi

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1 \
    OPENAI_API_KEY=${FORGE_API_KEY} \
    ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co \
    ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Assumption: Application entrypoint is not explicitly defined in repo files,
# so we keep default shell for interactive usage as per instructions.
CMD ["/bin/bash"][0m
