# Copy the full repository into the container
COPY . .

# Install system dependencies needed for building Python packages and common libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libxml2-dev libxslt1-dev python3-dev gcc curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies and the package itself using requirements.txt or poetry
RUN if [ -f "requirements.txt" ]; then \
      pip install -r requirements.txt && pip install -e .; \
    elif [ -f "pyproject.toml" ]; then \
      pip install poetry && \
      poetry config virtualenvs.create false && \
      poetry install --no-interaction --no-ansi && \
      pip install -e .; \
    else \
      echo "No requirements.txt or pyproject.toml found, only installing test dependencies."; \
    fi

# Install required test dependencies including packages known to be missing
RUN pip install pytest pytest-mock pytest-xdist pytest-timeout pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pandas a2a

# Preflight check to catch any missing modules and verify package installs
RUN python -c "import pkg_resources, pytest, valuecell, a2a; print('preflight ok')"

CMD ["/bin/bash"]

