# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# --- Set Forge API environment variables ---
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV OPENAI_API_KEY="forge-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"

# Set working directory
WORKDIR /app

# Install system dependencies needed for building Python packages and common database drivers
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libc6-dev \
    libpq-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy the entire repository
COPY . .

# Upgrade pip and setuptools
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies robustly, with conditional logic on requirements.txt and src layout
RUN set -eux; \
    if [ -f "libs/langgraph/requirements.txt" ]; then \
      pip install -r libs/langgraph/requirements.txt; \
    fi

# Install additional test dependencies including missing ones reported from tests
RUN pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm bs4 mkdocs nbformat psycopg[binary] aiosqlite dataclasses_json nbconvert psycopg_pool sqlite_vec numpy

# Detect src layout to decide installation strategy and install accordingly
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." libs/langgraph/tests 2>/dev/null || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
      echo "Detected src layout or src imports in tests, setting PYTHONPATH and no editable install"; \
      export PYTHONPATH=/app; \
    else \
      echo "No src layout detected, performing editable install"; \
      pip install -e libs/langgraph; \
    fi

# Preflight to check installations
RUN python -c 'import pkg_resources, pytest, bs4, mkdocs, nbformat, psycopg, aiosqlite, dataclasses_json, nbconvert, psycopg_pool, sqlite_vec, numpy; print("preflight ok")'

# Final default command
CMD ["/bin/bash"]
# branch: python/requirements.txt
