[32mFROM python:3.12-slim

# --- AgentSmith inject .env from project root (dockerwrite) ---
ENV FORGE_API_KEY="forge-key"
ENV FORGE_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV MODEL="tensorblock/gpt-4.1-mini"
ENV AI_TEMPERATURE="0.7"
ENV GITHUB_TOKEN="ghp_key"
ENV TAVILY_API_KEY="tvly-key"
ENV ANTHROPIC_BASE_URL="https://api.forge.tensorblock.co/v1"
ENV ANTHROPIC_AUTH_TOKEN="forge-key"
ENV ANTHROPIC_MODEL="tensorblock/gpt-4.1-mini"
ENV ANTHROPIC_SMALL_FAST_MODEL="tensorblock/gpt-4.1-mini"
ENV OPENAI_API_KEY="forge-key"
ENV OPENAI_BASE_URL="https://api.forge.tensorblock.co/v1"
# --- end inject ---

# Set environment variables for Forge API compatibility
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=forge-key
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=forge-key

# Set working directory to repository root
WORKDIR /app

# Install system dependencies needed for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libc6-dev \
    libpq-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy entire repository
COPY . .

# Upgrade pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install Python dependencies and project itself
# Install requirements.txt if available, install project in editable mode, then test dependencies
RUN set -eux; \
    if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt; \
    elif [ -f "libs/langgraph/requirements.txt" ]; then \
        pip install -r libs/langgraph/requirements.txt; \
    fi; \
    pip install -e libs/langgraph; \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm nbconvert psycopg[binary] psycopg_pool sqlite_vec numpy bs4 mkdocs nbformat dataclasses_json

# Detect src layout or src imports in tests for PYTHONPATH to avoid import errors
RUN set -eux; \
    if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." libs/langgraph/tests 2>/dev/null || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        echo "Detected src layout or src imports in tests, setting PYTHONPATH"; \
        export PYTHONPATH=/app; \
    else \
        pip install -e libs/langgraph; \
    fi

# Preflight test for importing required packages
RUN python -c 'import pkg_resources, pytest, nbconvert, psycopg, psycopg_pool, sqlite_vec, numpy, bs4, mkdocs, nbformat, dataclasses_json; print("preflight ok")'

# Default command
CMD ["/bin/bash"]

