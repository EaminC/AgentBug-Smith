[32mimport asyncio
import pytest
from typing import Any, Callable, Awaitable

from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langgraph.prebuilt.chat_agent_executor import LanguageModelLike
from langgraph.prebuilt.chat_agent_executor import StateSchema, Runtime, ContextT
from langgraph.prebuilt.chat_agent_executor import Runnable, LanguageModelInput, BaseMessage
from langgraph.prebuilt.chat_agent_executor import BaseChatModel
from langgraph.prebuilt.chat_agent_executor import BaseTool

# We will create dummy implementations to simulate the bind_tools return type,
# which is Runnable[LanguageModelInput, BaseMessage], and test if create_react_agent
# accepts it as a model argument.

class DummyRunnable(Runnable[LanguageModelInput, BaseMessage]):
    def __init__(self):
        self.called = False

    def invoke(self, input: LanguageModelInput) -> BaseMessage:
        self.called = True
        # Return a dummy BaseMessage instance
        return BaseMessage(content="dummy response")

    async def ainvoke(self, input: LanguageModelInput) -> BaseMessage:
        self.called = True
        return BaseMessage(content="dummy async response")

class DummyBaseChatModel(BaseChatModel):
    def chat(self, input: LanguageModelInput) -> BaseMessage:
        return BaseMessage(content="chat response")

    async def achat(self, input: LanguageModelInput) -> BaseMessage:
        return BaseMessage(content="async chat response")

# Dummy StateSchema and Runtime for testing
class DummyState(StateSchema):
    pass

class DummyRuntime(Runtime[ContextT]):
    pass

# Test that create_react_agent accepts a model callable returning a Runnable (bind_tools result)
def test_create_react_agent_accepts_runnable_model_callable():
    # Model callable returning Runnable synchronously
    def model_callable_sync(state: StateSchema, runtime: Runtime[ContextT]) -> Runnable[LanguageModelInput, BaseMessage]:
        return DummyRunnable()

    # Model callable returning Runnable asynchronously
    async def model_callable_async(state: StateSchema, runtime: Runtime[ContextT]) -> Awaitable[Runnable[LanguageModelInput, BaseMessage]]:
        await asyncio.sleep(0)
        return DummyRunnable()

    # Model callable returning BaseChatModel synchronously (control)
    def model_callable_basechat_sync(state: StateSchema, runtime: Runtime[ContextT]) -> BaseChatModel:
        return DummyBaseChatModel()

    # Model callable returning BaseChatModel asynchronously (control)
    async def model_callable_basechat_async(state: StateSchema, runtime: Runtime[ContextT]) -> Awaitable[BaseChatModel]:
        await asyncio.sleep(0)
        return DummyBaseChatModel()

    # We test that create_react_agent does not raise TypeError or similar on these callables
    # We do not test full agent execution here, just acceptance of the model argument type.

    # Synchronous Runnable model callable
    agent1 = create_react_agent(model=model_callable_sync, tools=[])
    assert agent1 is not None

    # Asynchronous Runnable model callable
    agent2 = create_react_agent(model=model_callable_async, tools=[])
    assert agent2 is not None

    # Synchronous BaseChatModel model callable
    agent3 = create_react_agent(model=model_callable_basechat_sync, tools=[])
    assert agent3 is not None

    # Asynchronous BaseChatModel model callable
    agent4 = create_react_agent(model=model_callable_basechat_async, tools=[])
    assert agent4 is not None

# Additional test: ensure that the created agent can invoke the model callable and get expected type
@pytest.mark.asyncio
async def test_agent_model_callable_invocation_and_type():
    # Model callable returning Runnable synchronously
    def model_callable_sync(state: StateSchema, runtime: Runtime[ContextT]) -> Runnable[LanguageModelInput, BaseMessage]:
        return DummyRunnable()

    agent = create_react_agent(model=model_callable_sync, tools=[])

    # The agent should have a model attribute or similar that is a Runnable
    # We try to invoke the model callable manually to check type correctness
    model_instance = model_callable_sync(DummyState(), DummyRuntime())
    assert isinstance(model_instance, Runnable)
    response = model_instance.invoke(LanguageModelInput(text="hello"))
    assert isinstance(response, BaseMessage)
    assert response.content == "dummy response"

    # Test async invocation
    response_async = await model_instance.ainvoke(LanguageModelInput(text="hello async"))
    assert isinstance(response_async, BaseMessage)
    assert response_async.content == "dummy async response"

# Test that create_react_agent raises if model callable returns wrong type (for sanity)
def test_create_react_agent_rejects_invalid_model_callable():
    # Model callable returning invalid type (int)
    def invalid_model_callable(state: StateSchema, runtime: Runtime[ContextT]) -> int:
        return 42

    with pytest.raises(TypeError):
        create_react_agent(model=invalid_model_callable, tools=[])

# Test that create_react_agent accepts direct BaseChatModel instance as model argument
def test_create_react_agent_accepts_basechatmodel_instance():
    model_instance = DummyBaseChatModel()
    agent = create_react_agent(model=model_instance, tools=[])
    assert agent is not None

# Test that create_react_agent accepts Runnable instance as model argument
def test_create_react_agent_accepts_runnable_instance():
    runnable_instance = DummyRunnable()
    agent = create_react_agent(model=runnable_instance, tools=[])
    assert agent is not None[0m
