from langgraph.langgraph import StateSchema, Runtime, ContextT


class DummyBaseChatModel:
    """A dummy BaseChatModel-like class for testing."""

    def __init__(self, response: str):
        self.response = response

    async def __call__(self, input: Any) -> BaseMessage:
        return BaseMessage(content=self.response)


class DummyRunnable(Runnable[LanguageModelInput, BaseMessage]):
    """A dummy Runnable that mimics the bind_tools return type."""

    def __init__(self, response: str):
        self.response = response

    async def invoke(self, input: LanguageModelInput) -> BaseMessage:
        return BaseMessage(content=self.response)

    def __call__(self, input: LanguageModelInput) -> Awaitable[BaseMessage]:
        return self.invoke(input)


def dummy_state() -> StateSchema:
    """Return a dummy StateSchema instance."""
    return StateSchema()


def dummy_runtime() -> Runtime[ContextT]:
    """Return a dummy Runtime instance."""
    return Runtime()


def model_returning_basechatmodel(state: StateSchema, runtime: Runtime[ContextT]) -> DummyBaseChatModel:
    """Dynamic model callable returning a BaseChatModel instance."""
    return DummyBaseChatModel("hello from basechatmodel")


