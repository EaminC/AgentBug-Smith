[32mimport asyncio
import pytest
from typing import Callable, Awaitable, Any

from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langgraph.prebuilt.chat_agent_executor import LanguageModelLike
from langgraph.prebuilt.chat_agent_executor import StateSchema, Runtime, ContextT
from langgraph.prebuilt.chat_agent_executor import Runnable, LanguageModelInput, BaseMessage

from langgraph.prebuilt.chat_agent_executor import BaseChatModel, BaseTool


class DummyBaseChatModel(BaseChatModel):
    def __init__(self, name: str):
        self.name = name

    async def __call__(self, input: LanguageModelInput) -> BaseMessage:
        return BaseMessage(content=f"Response from {self.name}")


class DummyRunnable(Runnable[LanguageModelInput, BaseMessage]):
    def __init__(self, name: str):
        self.name = name

    async def invoke(self, input: LanguageModelInput) -> BaseMessage:
        return BaseMessage(content=f"Runnable response from {self.name}")

    async def __call__(self, input: LanguageModelInput) -> BaseMessage:
        return await self.invoke(input)


@pytest.mark.asyncio
async def test_create_react_agent_accepts_bind_tools_like_callable():
    """
    This test verifies that create_react_agent accepts a dynamic model callable that returns
    a Runnable[LanguageModelInput, BaseMessage] (the type returned by bind_tools).
    The test will fail on the buggy codebase due to type annotation restrictions,
    and pass on the fixed codebase after widening the accepted types.
    """

    # Define a dummy state and runtime for the callable
    dummy_state = StateSchema()
    dummy_runtime = Runtime[ContextT]()

    # Define a dynamic model callable returning BaseChatModel (should always work)
    def model_callable_basechat(state: StateSchema, runtime: Runtime[ContextT]) -> BaseChatModel:
        return DummyBaseChatModel("basechat")

    # Define a dynamic model callable returning Awaitable[BaseChatModel]
    async def model_callable_basechat_async(state: StateSchema, runtime: Runtime[ContextT]) -> BaseChatModel:
        return DummyBaseChatModel("basechat_async")

    # Define a dynamic model callable returning Runnable (bind_tools-like)
    def model_callable_runnable(state: StateSchema, runtime: Runtime[ContextT]) -> Runnable[LanguageModelInput, BaseMessage]:
        return DummyRunnable("runnable")

    # Define a dynamic model callable returning Awaitable[Runnable]
    async def model_callable_runnable_async(state: StateSchema, runtime: Runtime[ContextT]) -> Runnable[LanguageModelInput, BaseMessage]:
        return DummyRunnable("runnable_async")

    # Prepare dummy tools list (empty)
    dummy_tools = []

    # Test with BaseChatModel callable - should always pass
    agent1 = create_react_agent(
        model=model_callable_basechat,
        tools=dummy_tools,
        name="agent1"
    )
    assert agent1 is not None

    # Test with async BaseChatModel callable - should always pass
    agent2 = create_react_agent(
        model=model_callable_basechat_async,
        tools=dummy_tools,
        name="agent2"
    )
    assert agent2 is not None

    # Test with Runnable callable - should fail on buggy, pass on fixed
    agent3 = create_react_agent(
        model=model_callable_runnable,
        tools=dummy_tools,
        name="agent3"
    )
    assert agent3 is not None

    # Test with async Runnable callable - should fail on buggy, pass on fixed
    agent4 = create_react_agent(
        model=model_callable_runnable_async,
        tools=dummy_tools,
        name="agent4"
    )
    assert agent4 is not None

    # Additionally, test that the created agents can be called (basic smoke test)
    # We will call the model callable from the agent to verify it returns expected type

    # Helper to extract the model from the agent (assuming agent has attribute 'model' or similar)
    # Since create_react_agent returns an agent object, we try to call the model callable manually here

    # Call model_callable_basechat and check type
    basechat_model = model_callable_basechat(dummy_state, dummy_runtime)
    assert isinstance(basechat_model, BaseChatModel)

    # Call async model_callable_basechat_async and check type
    basechat_model_async = await model_callable_basechat_async(dummy_state, dummy_runtime)
    assert isinstance(basechat_model_async, BaseChatModel)

    # Call model_callable_runnable and check type
    runnable_model = model_callable_runnable(dummy_state, dummy_runtime)
    assert isinstance(runnable_model, Runnable)

    # Call async model_callable_runnable_async and check type
    runnable_model_async = await model_callable_runnable_async(dummy_state, dummy_runtime)
    assert isinstance(runnable_model_async, Runnable)

    # Call the runnable models with dummy input and verify response type
    dummy_input = LanguageModelInput(messages=[])
    response_sync = await runnable_model(dummy_input)
    assert isinstance(response_sync, BaseMessage)
    response_async = await runnable_model_async(dummy_input)
    assert isinstance(response_async, BaseMessage)[0m
