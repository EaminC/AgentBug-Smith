[32mimport asyncio
import pytest
from typing import Callable, Awaitable

from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langgraph.prebuilt.chat_agent_executor import LanguageModelLike
from langgraph.prebuilt.chat_agent_executor import StateSchema, Runtime, ContextT
from langgraph.prebuilt.chat_agent_executor import Runnable, LanguageModelInput, BaseMessage
from langgraph.prebuilt.chat_agent_executor import BaseChatModel
from langgraph.prebuilt.chat_agent_executor import BaseTool


class DummyBaseChatModel(BaseChatModel):
    def __init__(self, response: str):
        self.response = response

    async def chat(self, input_text: str) -> str:
        return self.response


class DummyRunnable(Runnable[LanguageModelInput, BaseMessage]):
    def __init__(self, response: str):
        self.response = response

    async def invoke(self, input: LanguageModelInput) -> BaseMessage:
        # Return a dummy BaseMessage with the response text
        class DummyMessage(BaseMessage):
            def __init__(self, content: str):
                self.content = content

            def __repr__(self):
                return f"DummyMessage(content={self.content!r})"

        return DummyMessage(self.response)


@pytest.mark.asyncio
async def test_create_react_agent_accepts_bind_tools_return_type():
    """
    This test verifies that create_react_agent accepts a dynamic model callable
    that returns a Runnable[LanguageModelInput, BaseMessage] (the result of bind_tools),
    which was previously rejected by the type annotations.

    The test will fail on the buggy codebase due to type annotation mismatch,
    and pass on the fixed codebase where the type annotations are widened.
    """

    # Define a dynamic model callable that returns a DummyRunnable instance
    def dynamic_model_callable(
        state: StateSchema, runtime: Runtime[ContextT]
    ) -> Runnable[LanguageModelInput, BaseMessage]:
        return DummyRunnable("Hello from DummyRunnable")

    # Define a dummy tool list (empty for simplicity)
    tools = []

    # Attempt to create the react agent with the dynamic model callable returning Runnable
    agent = create_react_agent(
        model=dynamic_model_callable,
        tools=tools,
    )

    # The agent should be created successfully and be callable
    # We test that the agent can run and produce the expected output

    # Prepare dummy inputs for the agent run
    input_text = "Test input"

    # Run the agent asynchronously and get the output
    output = await agent.run(input_text)

    # The output should be the response from DummyRunnable
    assert "Hello from DummyRunnable" in output


@pytest.mark.asyncio
async def test_create_react_agent_rejects_invalid_model_type():
    """
    This test verifies that create_react_agent rejects a dynamic model callable
    that returns an invalid type (not BaseChatModel or LanguageModelLike).

    This test should fail on the fixed codebase if the type annotations are too permissive,
    but should pass on the buggy codebase where only BaseChatModel was accepted.
    """

    # Define a dynamic model callable that returns an invalid type (e.g., int)
    def invalid_dynamic_model_callable(
        state: StateSchema, runtime: Runtime[ContextT]
    ) -> int:
        return 42

    tools = []

    # Creating the agent with invalid model callable should raise a TypeError or similar
    with pytest.raises(TypeError):
        create_react_agent(
            model=invalid_dynamic_model_callable,
            tools=tools,
        )[0m
