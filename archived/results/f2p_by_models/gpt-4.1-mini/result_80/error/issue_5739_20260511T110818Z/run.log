    """Async dynamic model callable returning a BaseChatModel instance."""
    await asyncio.sleep(0)
    return DummyBaseChatModel("hello async from basechatmodel")


def model_returning_runnable(state: StateSchema, runtime: Runtime[ContextT]) -> Runnable[LanguageModelInput, BaseMessage]:
