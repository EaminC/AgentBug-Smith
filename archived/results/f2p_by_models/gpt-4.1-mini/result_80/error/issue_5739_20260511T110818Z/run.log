[32mimport asyncio
import pytest
from typing import Callable, Awaitable

from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langgraph.schema import BaseMessage, LanguageModelInput
from langgraph.prebuilt.chat_agent_executor import LanguageModelLike
from langgraph.runnable import Runnable
from langgraph.state import StateSchema
from langgraph.runtime import Runtime


def dummy_state() -> StateSchema:
    # Minimal dummy state for testing
    return {}


def dummy_runtime() -> Runtime:
    # Minimal dummy runtime for testing
    return {}


class DummyBaseChatModel:
    # Minimal dummy class to simulate BaseChatModel interface
    def __init__(self):
        self.name = "DummyBaseChatModel"

    async def __call__(self, input: LanguageModelInput) -> BaseMessage:
        return BaseMessage(content="dummy response")


class DummyRunnable(Runnable[LanguageModelInput, BaseMessage]):
    # Dummy Runnable to simulate bind_tools return type
    async def invoke(self, input: LanguageModelInput) -> BaseMessage:
        return BaseMessage(content="dummy runnable response")

    def __call__(self, input: LanguageModelInput) -> Awaitable[BaseMessage]:
        return self.invoke(input)


def test_create_react_agent_accepts_base_chat_model_callable():
    # Test that create_react_agent accepts a dynamic model callable returning BaseChatModel
    def model_callable(state: StateSchema, runtime: Runtime) -> DummyBaseChatModel:
        return DummyBaseChatModel()

    agent = create_react_agent(model=model_callable, tools=[])
    assert agent is not None


@pytest.mark.asyncio
async def test_create_react_agent_accepts_runnable_callable():
    # Test that create_react_agent accepts a dynamic model callable returning Runnable (bind_tools result)

    def model_callable(state: StateSchema, runtime: Runtime) -> Runnable[LanguageModelInput, BaseMessage]:
        return DummyRunnable()

    agent = create_react_agent(model=model_callable, tools=[])
    assert agent is not None

    # Test that the agent's model can be called asynchronously and returns expected type
    # We simulate calling the model with a dummy input
    dummy_input = LanguageModelInput(text="hello")
    # The agent should have an attribute or method to get the model instance; we test calling the model_callable directly
    runnable_model = model_callable(dummy_state(), dummy_runtime())
    result = await runnable_model(dummy_input)
    assert isinstance(result, BaseMessage)
    assert result.content == "dummy runnable response"


@pytest.mark.asyncio
async def test_create_react_agent_accepts_async_runnable_callable():
    # Test that create_react_agent accepts an async dynamic model callable returning Runnable

    async def async_model_callable(state: StateSchema, runtime: Runtime) -> Runnable[LanguageModelInput, BaseMessage]:
        await asyncio.sleep(0)  # simulate async work
        return DummyRunnable()

    agent = create_react_agent(model=async_model_callable, tools=[])
    assert agent is not None

    runnable_model = await async_model_callable(dummy_state(), dummy_runtime())
    dummy_input = LanguageModelInput(text="hello async")
    result = await runnable_model(dummy_input)
    assert isinstance(result, BaseMessage)
    assert result.content == "dummy runnable response"


@pytest.mark.asyncio
async def test_create_react_agent_accepts_async_base_chat_model_callable():
    # Test that create_react_agent accepts an async dynamic model callable returning BaseChatModel

    class AsyncDummyBaseChatModel(DummyBaseChatModel):
        async def __call__(self, input: LanguageModelInput) -> BaseMessage:
            await asyncio.sleep(0)
            return BaseMessage(content="async dummy response")

    async def async_model_callable(state: StateSchema, runtime: Runtime) -> AsyncDummyBaseChatModel:
        await asyncio.sleep(0)
        return AsyncDummyBaseChatModel()

    agent = create_react_agent(model=async_model_callable, tools=[])
    assert agent is not None

    model_instance = await async_model_callable(dummy_state(), dummy_runtime())
    dummy_input = LanguageModelInput(text="hello async base chat model")
    result = await model_instance(dummy_input)
    assert isinstance(result, BaseMessage)
    assert result.content == "async dummy response"[0m
