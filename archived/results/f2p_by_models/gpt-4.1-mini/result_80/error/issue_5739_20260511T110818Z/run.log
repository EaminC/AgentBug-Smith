import pytest
from typing import Any, Awaitable, Callable, Sequence, Union

from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langgraph.prebuilt.chat_agent_executor import LanguageModelLike
from langgraph.prebuilt.chat_agent_executor import Runnable
from langgraph.prebuilt.chat_agent_executor import LanguageModelInput
from langgraph.prebuilt.chat_agent_executor import BaseMessage
from langgraph.prebuilt.chat_agent_executor import BaseTool
from langgraph.prebuilt.chat_agent_executor import ToolNode
from langgraph.prebuilt.chat_agent_executor import StateSchema
from langgraph.prebuilt.chat_agent_executor import Runtime
from langgraph.prebuilt.chat_agent_executor import ContextT


class DummyBaseChatModel:
    """A dummy BaseChatModel-like class for testing."""

    def __init__(self, response: str):
        self.response = response

    def chat(self, prompt: str) -> str:
        return f"BaseChatModel response to: {prompt}"


class DummyRunnable(Runnable[LanguageModelInput, BaseMessage]):
    """A dummy Runnable that simulates bind_tools() return type."""

    def __init__(self, response: str):
        self.response = response

    async def invoke(self, input: LanguageModelInput) -> BaseMessage:
        # Simulate an async call returning a BaseMessage-like object
        class DummyMessage(BaseMessage):
            def __init__(self, content: str):
                self.content = content

            def __repr__(self):
                return f"DummyMessage(content={self.content!r})"

        return DummyMessage(f"Runnable response to: {input}")


def dummy_tool_function(*args, **kwargs) -> str:
    return "tool output"


def dummy_tool_dict() -> dict[str, Any]:
    return {"name": "dummy_tool", "func": dummy_tool_function}


@pytest.mark.asyncio
async def test_create_react_agent_accepts_bind_tools_return_type():
    """
    Test that create_react_agent accepts a dynamic model callable that returns a Runnable,
    simulating the bind_tools() return type, both sync and async variants.
    """

    # Define a sync dynamic model callable returning DummyRunnable instance
    def sync_dynamic_model(
        state: StateSchema, runtime: Runtime[ContextT]
    ) -> Runnable[LanguageModelInput, BaseMessage]:
        return DummyRunnable("sync response")

    # Define an async dynamic model callable returning DummyRunnable instance
    async def async_dynamic_model(
        state: StateSchema, runtime: Runtime[ContextT]
    ) -> Runnable[LanguageModelInput, BaseMessage]:
        await asyncio.sleep(0)  # simulate async work
        return DummyRunnable("async response")

    # Prepare dummy tools list
    tools: Sequence[Union[BaseTool, Callable, dict[str, Any]]] = [dummy_tool_function, dummy_tool_dict()]

    # Test with sync dynamic model callable
    agent_sync = create_react_agent(
        model=sync_dynamic_model,
        tools=tools,
    )
    assert agent_sync is not None, "Agent creation with sync dynamic model callable failed"

    # Test with async dynamic model callable
    agent_async = create_react_agent(
        model=async_dynamic_model,
        tools=tools,
    )
    assert agent_async is not None, "Agent creation with async dynamic model callable failed"

    # Further test that the agent can run or invoke the model properly
    # We simulate calling the dynamic model callable with dummy state and runtime
    dummy_state = StateSchema()
    dummy_runtime = Runtime[ContextT]()

    # Sync callable returns Runnable, check type
    runnable_sync = sync_dynamic_model(dummy_state, dummy_runtime)
    assert isinstance(runnable_sync, Runnable), "Sync dynamic model did not return Runnable"

    # Async callable returns Runnable, check type
    runnable_async = await async_dynamic_model(dummy_state, dummy_runtime)
    assert isinstance(runnable_async, Runnable), "Async dynamic model did not return Runnable"

    # Test invoking the Runnable returned by sync callable
    response_sync = await runnable_sync.invoke(LanguageModelInput())
    assert isinstance(response_sync, BaseMessage), "Runnable.invoke did not return BaseMessage for sync callable"

    # Test invoking the Runnable returned by async callable
    response_async = await runnable_async.invoke(LanguageModelInput())
    assert isinstance(response_async, BaseMessage), "Runnable.invoke did not return BaseMessage for async callable"


