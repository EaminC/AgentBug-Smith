async def async_model_returning_runnable(state: StateSchema, runtime: Runtime[ContextT]) -> Runnable[LanguageModelInput, BaseMessage]:
    """Async dynamic model callable returning a Runnable (bind_tools-like) instance."""
    await asyncio.sleep(0)
    return DummyRunnable("hello async from runnable")


