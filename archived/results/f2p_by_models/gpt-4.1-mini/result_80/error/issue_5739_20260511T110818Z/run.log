WORKDIR /app

# Copy entire repository to preserve injected tests and scripts
COPY . .

# Set environment variables required by Forge environment
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Determine if src/ layout or "import src." usage in tests exists
# Assumption: no src/ layout detected because project metadata is under ./libs/langgraph, no src/ directory seen
# Install pip, setuptools, wheel upgrade and install dependencies accordingly
RUN set -eux; \
    if [ -f "libs/langgraph/requirements.txt" ]; then \
        python -m pip install --upgrade pip setuptools wheel && \
        pip install -r libs/langgraph/requirements.txt && \
        pip install -e libs/langgraph && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    elif [ -f "libs/langgraph/pyproject.toml" ] && [ -f "libs/langgraph/poetry.lock" ]; then \
        python -m pip install --upgrade pip setuptools wheel && \
        pip install poetry && \
        poetry config virtualenvs.create false && \
        cd libs/langgraph && poetry install --no-interaction --no-ansi && cd - && \
        pip install -e libs/langgraph && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    elif [ -f "libs/langgraph/pyproject.toml" ]; then \
        python -m pip install --upgrade pip setuptools wheel && \
        pip install -e libs/langgraph && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    else \
        python -m pip install --upgrade pip setuptools wheel && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    fi

# Preflight import check to fail fast if core packages are missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run the tests using Makefile target 'test_parallel' in libs/langgraph
RUN make -C libs/langgraph test_parallel

FROM python:3.12-slim AS runtime

WORKDIR /app

COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
