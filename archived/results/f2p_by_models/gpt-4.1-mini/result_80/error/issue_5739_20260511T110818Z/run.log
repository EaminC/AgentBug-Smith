    input_data = LanguageModelInput(text="Hello")

    # The agent might be async or sync
    if asyncio.iscoroutinefunction(agent):
        response = await agent(input_data)
    else:
        response = agent(input_data)

    assert isinstance(response, BaseMessage)
    assert response.content in ("runnable response", "async runnable response")

