from langgraph.prebuilt.chat_agent_executor import BaseChatModel

# We will create dummy implementations to test the type acceptance of create_react_agent
# We do NOT mock create_react_agent or the internal bind_tools, only provide callables with different return types.

class DummyBaseChatModel(BaseChatModel):
    def __init__(self):
        super().__init__()

class DummyRunnable(Runnable[LanguageModelInput, BaseMessage]):
    # Minimal implementation to satisfy Runnable interface
    async def invoke(self, input: LanguageModelInput) -> BaseMessage:
        # Return a dummy BaseMessage
        return BaseMessage()

def dummy_base_chat_model_callable(state: StateSchema, runtime: Runtime[ContextT]) -> BaseChatModel:
    # Returns a BaseChatModel instance - old accepted type
    return DummyBaseChatModel()

async def dummy_base_chat_model_async_callable(state: StateSchema, runtime: Runtime[ContextT]) -> BaseChatModel:
    # Async returns BaseChatModel instance - old accepted type
    return DummyBaseChatModel()

def dummy_runnable_callable(state: StateSchema, runtime: Runtime[ContextT]) -> Runnable[LanguageModelInput, BaseMessage]:
    # Returns a Runnable - new accepted type after fix
    return DummyRunnable()

async def dummy_runnable_async_callable(state: StateSchema, runtime: Runtime[ContextT]) -> Runnable[LanguageModelInput, BaseMessage]:
    # Async returns Runnable - new accepted type after fix
    return DummyRunnable()

@pytest.mark.asyncio
async def test_create_react_agent_accepts_base_chat_model_callable():
    # Should accept a callable returning BaseChatModel (old behavior)
    agent = create_react_agent(
        model=dummy_base_chat_model_callable,
        tools=[],
    )
    assert agent is not None

@pytest.mark.asyncio
async def test_create_react_agent_accepts_base_chat_model_async_callable():
    # Should accept an async callable returning BaseChatModel (old behavior)
