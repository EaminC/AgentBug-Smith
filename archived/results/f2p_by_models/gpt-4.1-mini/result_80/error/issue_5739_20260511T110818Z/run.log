    agent = create_react_agent(
        model=model_callable,
        tools=dummy_tools(),
    )
    assert agent is not None

@pytest.mark.asyncio
async def test_agent_run_with_runnable_model():
    # Test that the agent created with Runnable model callable can run a step
    def model_callable(state: StateSchema, runtime: Runtime[ContextT]) -> Runnable[LanguageModelInput, BaseMessage]:
        return DummyRunnable()

    agent = create_react_agent(
        model=model_callable,
        tools=dummy_tools(),
    )
    # We simulate a call to the agent with a dummy input
