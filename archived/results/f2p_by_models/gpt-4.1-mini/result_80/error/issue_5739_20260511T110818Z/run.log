@pytest.mark.asyncio
async def test_create_react_agent_accepts_bind_tools_return_type():
    """
    Test that create_react_agent accepts a dynamic model callable returning
    a Runnable[LanguageModelInput, BaseMessage] (the bind_tools return type).
    This should fail on the buggy codebase due to type annotation mismatch,
    and pass after the fix that widens accepted types.
    """

    # Define a dummy state and runtime for the callable
    dummy_state = StateSchema()
    dummy_runtime = Runtime[ContextT]()

    # Define a dynamic model callable that returns a Runnable (bind_tools-like)
    def dynamic_model_callable(
        state: StateSchema, runtime: Runtime[ContextT]
    ) -> Runnable[LanguageModelInput, BaseMessage]:
        return DummyRunnable("dummy response")

    # Define minimal dummy tools list (empty)
    dummy_tools: Sequence[Union[BaseTool, Callable, dict[str, Any]]] = []

    # Attempt to create the react agent with the dynamic model callable
    # This should type-check and run without error only after the fix.
    agent = create_react_agent(
        model=dynamic_model_callable,
        tools=dummy_tools,
    )

    # The agent should be callable or have a method to run
    # We test that invoking the agent with dummy inputs works as expected

    # We expect the agent to have a run method or similar; since the actual
    # implementation details may vary, we test that the agent is created and
    # can be called or awaited without type errors.

    # If agent is async callable, test calling it
    if asyncio.iscoroutinefunction(agent):
        # Await the agent call with dummy inputs
        result = await agent(dummy_state, dummy_runtime)
    else:
        # Call synchronously
        result = agent(dummy_state, dummy_runtime)

    # We expect the result to be not None (basic sanity check)
    assert result is not None


