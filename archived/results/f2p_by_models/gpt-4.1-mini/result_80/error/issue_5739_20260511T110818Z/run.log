import pytest
from typing import Any, Callable, Awaitable, Sequence, Union

from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langgraph.prebuilt.chat_agent_executor import LanguageModelLike
from langgraph.prebuilt.chat_agent_executor import Runnable
from langgraph.schema import BaseMessage, LanguageModelInput
from langgraph.schema import BaseTool
from langgraph.state import StateSchema
from langgraph.runtime import Runtime
from langgraph.prebuilt.tool_node import ToolNode


class DummyBaseChatModel:
    """A dummy BaseChatModel-like class for testing."""

    def __init__(self, name: str):
        self.name = name

    def __call__(self, *args, **kwargs):
        return f"Model {self.name} called"


class DummyRunnable(Runnable[LanguageModelInput, BaseMessage]):
    """A dummy Runnable to simulate bind_tools return type."""

    def __init__(self, name: str):
        self.name = name

    def invoke(self, input: LanguageModelInput) -> BaseMessage:
        # Return a dummy BaseMessage instance
        return BaseMessage(content=f"Runnable {self.name} invoked with {input}")

    async def ainvoke(self, input: LanguageModelInput) -> BaseMessage:
        return self.invoke(input)


def dummy_tool() -> BaseTool:
    class Tool(BaseTool):
        name = "dummy_tool"

        def _call(self, *args, **kwargs):
            return "tool called"

    return Tool()


@pytest.mark.asyncio
async def test_create_react_agent_accepts_bind_tools_return_sync():
    """
    Test that create_react_agent accepts a synchronous callable returning a Runnable,
    simulating the bind_tools return type.
    """
    def model_callable(
        state: StateSchema, runtime: Runtime[Any]
    ) -> Runnable[LanguageModelInput, BaseMessage]:
        return DummyRunnable("sync")

    tools = [dummy_tool()]

    agent = create_react_agent(
        model=model_callable,
        tools=tools,
        max_iterations=1,
        max_execution_time=5,
    )
    # The agent should be created without type errors and be callable
    assert agent is not None
    # Run the agent with dummy state and runtime to ensure no runtime errors
    dummy_state = StateSchema()
    dummy_runtime = Runtime({})
    # The agent is a callable, call it with dummy inputs
    result = await agent(dummy_state, dummy_runtime)
    assert result is not None


@pytest.mark.asyncio
async def test_create_react_agent_accepts_bind_tools_return_async():
    """
    Test that create_react_agent accepts an async callable returning a Runnable,
    simulating the bind_tools return type.
    """
    async def model_callable_async(
        state: StateSchema, runtime: Runtime[Any]
    ) -> Runnable[LanguageModelInput, BaseMessage]:
        await asyncio.sleep(0)  # simulate async work
