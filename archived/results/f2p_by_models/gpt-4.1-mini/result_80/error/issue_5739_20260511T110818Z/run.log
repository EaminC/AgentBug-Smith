import pytest
from typing import Any, Callable, Awaitable

from langgraph.prebuilt.chat_agent_executor import create_react_agent
from langgraph.prebuilt.chat_agent_executor import LanguageModelLike
from langgraph.prebuilt.chat_agent_executor import StateSchema, Runtime, ContextT
from langgraph.prebuilt.chat_agent_executor import BaseChatModel, BaseMessage, LanguageModelInput
from langgraph.prebuilt.chat_agent_executor import Runnable

# We will create dummy classes and functions to simulate the behavior of:
# - BaseChatModel subclass
# - Runnable returned by bind_tools (simulated)
# - A dynamic model callable returning either BaseChatModel or Runnable
# We will test that create_react_agent accepts these callables without type errors
# and that the agent can be created and run a simple step.

# Dummy BaseChatModel subclass for testing
class DummyBaseChatModel(BaseChatModel):
    def __init__(self):
        super().__init__()

    def chat(self, input: LanguageModelInput) -> BaseMessage:
        # Return a dummy BaseMessage
        return BaseMessage(content="dummy response")

# Dummy Runnable simulating bind_tools return type
class DummyRunnable(Runnable[LanguageModelInput, BaseMessage]):
    def __init__(self):
        super().__init__()

    def invoke(self, input: LanguageModelInput) -> BaseMessage:
        return BaseMessage(content="runnable response")

    async def ainvoke(self, input: LanguageModelInput) -> BaseMessage:
        return BaseMessage(content="async runnable response")

# Dummy StateSchema and Runtime for testing
class DummyStateSchema(StateSchema):
    pass

class DummyRuntime(Runtime[ContextT]):
    pass

def dummy_tools():
    # Return empty list of tools for simplicity
    return []

@pytest.mark.asyncio
async def test_create_react_agent_accepts_basechatmodel_callable():
    # Dynamic model callable returning BaseChatModel instance
    def model_callable(state: StateSchema, runtime: Runtime[ContextT]) -> BaseChatModel:
        return DummyBaseChatModel()

    agent = create_react_agent(
        model=model_callable,
        tools=dummy_tools(),
    )
    # The agent should be created successfully
    assert agent is not None

@pytest.mark.asyncio
async def test_create_react_agent_accepts_runnable_callable():
    # Dynamic model callable returning Runnable instance (simulating bind_tools)
    def model_callable(state: StateSchema, runtime: Runtime[ContextT]) -> Runnable[LanguageModelInput, BaseMessage]:
        return DummyRunnable()

    agent = create_react_agent(
        model=model_callable,
        tools=dummy_tools(),
    )
    assert agent is not None

@pytest.mark.asyncio
async def test_create_react_agent_accepts_async_basechatmodel_callable():
    # Async dynamic model callable returning BaseChatModel instance
    async def model_callable(state: StateSchema, runtime: Runtime[ContextT]) -> BaseChatModel:
        await asyncio.sleep(0)  # simulate async
        return DummyBaseChatModel()

    agent = create_react_agent(
        model=model_callable,
        tools=dummy_tools(),
