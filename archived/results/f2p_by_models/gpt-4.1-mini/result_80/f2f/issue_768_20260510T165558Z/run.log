import unittest
from unittest.mock import AsyncMock, patch

from agentscope.agent import ReActAgent, UserAgent
from agentscope.formatter import OpenAIChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.model import OpenAIChatModel
from agentscope.tool import Toolkit, execute_python_code, execute_shell_command


class TestVLLMTokenUsage(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch the internal openai client call to avoid real network calls
        patcher = patch(
            "agentscope.model._openai_model.openai.chat.completions.create",
            new_callable=AsyncMock,
        )
        self.mock_create = patcher.start()
        self.addCleanup(patcher.stop)

        # Setup a dummy streaming response generator that yields one chunk with token usage info
        class DummyChoiceDelta:
            def __init__(self):
                self.content = "Hello"
                self.reasoning_content = None
                self.tool_calls = None

        class DummyChoice:
            def __init__(self):
                self.delta = DummyChoiceDelta()

        class DummyChunk:
            def __init__(self):
                self.choices = [DummyChoice()]
                self.usage = {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15}

        async def dummy_stream():
            yield DummyChunk()

        self.mock_create.return_value.__aenter__.return_value = dummy_stream()

        # Patch _json_loads_with_repair to just return dict for tool input parsing
        patcher_json = patch("agentscope.model._openai_model._json_loads_with_repair", side_effect=lambda x: {})
        patcher_json.start()
        self.addCleanup(patcher_json.stop)

    async def test_vllm_model_token_usage_in_chat_response(self):
        # Setup toolkit and agent using the VLLM model as in the issue repro
        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_key",
                stream=True,
                client_args={"base_url": "http://dummy-base-url"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        # Run one iteration of the agent call with a dummy message and verify token usage info is present in the response
        user = UserAgent(name="user")

        # Initial message is None (start of conversation)
        msg = None
        msg = await agent(msg)

        # The agent's last reasoning message should contain token usage info in metadata
        # We check that usage dict is present and has expected keys
        usage = msg.metadata.get("usage")
        self.assertIsNotNone(usage, "Token usage info should be present in the response metadata")
        self.assertIn("prompt_tokens", usage)
        self.assertIn("completion_tokens", usage)
        self.assertIn("total_tokens", usage)

    async def test_agent_loop_exit_condition(self):
        # Setup toolkit and agent using the VLLM model as in the issue repro
        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_key",
                stream=True,
                client_args={"base_url": "http://dummy-base-url"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        user = UserAgent(name="user")

        # Simulate a conversation loop with the agent and user
        # The user will send "exit" to break the loop
        msg = None
        max_iters = 5
        for _ in range(max_iters):
            msg = await agent(msg)
            # Simulate user reply: after first agent message, user says "exit"
            if msg.get_text_content() != "exit":
                msg = await user(msg)
            else:
                break

        # After loop, the last message text content should be "exit"
        self.assertEqual(msg.get_text_content(), "exit", "The conversation loop should exit on 'exit' message")


if __name__ == "__main__":
    unittest.main()[0m
