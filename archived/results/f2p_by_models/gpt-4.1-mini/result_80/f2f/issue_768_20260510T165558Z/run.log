import unittest
from unittest.mock import AsyncMock, patch
from datetime import datetime
from collections import OrderedDict
from typing import AsyncGenerator, List, Type

from agentscope.agent import ReActAgent, UserAgent
from agentscope.model import OpenAIChatModel
from agentscope.formatter import OpenAIChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.tool import Toolkit, execute_python_code, execute_shell_command
from agentscope.model._openai_model import ChatResponse, ChatUsage, TextBlock, ToolUseBlock, ThinkingBlock


class TestVLLMTokenUsage(unittest.IsolatedAsyncioTestCase):
    def setUp(self) -> None:
        self.toolkit = Toolkit()
        self.toolkit.register_tool_function(execute_python_code)
        self.toolkit.register_tool_function(execute_shell_command)

    async def test_vllm_model_token_usage_in_chat_response(self):
        # Prepare dummy async generator to simulate streaming response with token usage info
        async def dummy_stream():
            class DummyChoiceDelta:
                def __init__(self):
                    self.content = "Hello"
                    self.reasoning_content = None
                    self.tool_calls = None

            class DummyChoice:
                def __init__(self):
                    self.delta = DummyChoiceDelta()

            class DummyChunk:
                def __init__(self):
                    self.choices = [DummyChoice()]
                    # usage is a dict-like object with keys as strings
                    self.usage = {
                        "prompt_tokens": 10,
                        "completion_tokens": 5,
                        "total_tokens": 15,
                    }

            yield DummyChunk()

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_key",
                stream=True,
                client_args={"base_url": "http://dummy-base-url"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=self.toolkit,
        )

        # Patch the instance's client attribute's chat.completions.create coroutine method
        async def async_create(*args, **kwargs):
            class DummyResponse:
                def __aiter__(self_inner):
                    return dummy_stream()

                async def __aenter__(self_inner):
                    return self_inner

                async def __aexit__(self_inner, exc_type, exc, tb):
                    pass

            return DummyResponse()

        # Patch the client attribute's chat.completions.create method to return dummy response
        with patch.object(
            agent.model.client.chat.completions,
            "create",
            new=AsyncMock(side_effect=async_create),
        ):
            start_datetime = datetime.now()
            response = await async_create()
            responses = []
            # We expect the _parse_openai_stream_response to yield ChatResponse with usage populated correctly
            async for chat_response in agent.model._parse_openai_stream_response(
                start_datetime, response
            ):
                # The usage should be a ChatUsage object with correct tokens
                self.assertIsInstance(chat_response.usage, ChatUsage)
                self.assertEqual(chat_response.usage.input_tokens, 10)
                self.assertEqual(chat_response.usage.output_tokens, 5)
                self.assertGreater(chat_response.usage.time, 0)
                # The content should include a TextBlock with text "Hello"
                text_blocks = [block for block in chat_response.content if isinstance(block, TextBlock)]
                self.assertTrue(any(block.text == "Hello" for block in text_blocks))
                responses.append(chat_response)

            self.assertGreater(len(responses), 0, "No chat responses were yielded.")


