[32mimport asyncio
import pytest
from unittest.mock import patch, AsyncMock

import agentscope
from agentscope.agent import ReActAgent, UserAgent
from agentscope.model import OpenAIChatModel
from agentscope.formatter import OpenAIChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.tool import Toolkit, execute_python_code, execute_shell_command


@pytest.mark.asyncio
async def test_vllm_model_token_usage_in_chat_response():
    """
    This test verifies that when using the OpenAIChatModel with a VLLM model,
    the token usage information is correctly populated in the chat responses.

    The buggy code yields ChatResponse objects with empty usage info.
    The fixed code yields ChatResponse objects with proper usage info.

    The test mocks the internal client call to simulate a streaming response
    with token usage data, then asserts that the yielded ChatResponse objects
    contain non-empty usage information.
    """

    # Initialize agentscope with dummy project and studio_url
    agentscope.init(project="Agent", name="Friday", studio_url="http://localhost:3002")

    # Prepare toolkit with registered tools
    toolkit = Toolkit()
    toolkit.register_tool_function(execute_python_code)
    toolkit.register_tool_function(execute_shell_command)

    # Create the agent with OpenAIChatModel configured for VLLM
    agent = ReActAgent(
        name="Friday",
        sys_prompt="You're a helpful assistant named Friday.",
        model=OpenAIChatModel(
            model_name="qwen3-coder-30b-a3b-instruct",
            api_key="dummy_api_key",
            stream=True,
            client_args={"base_url": "http://dummy-vllm-api"},
        ),
        formatter=OpenAIChatFormatter(),
        memory=InMemoryMemory(),
        toolkit=toolkit,
    )

    user = UserAgent(name="user")

    # Mock the internal client's chat.completions.create to simulate streaming response
    # The response will yield chunks with usage info and content
    async def async_stream_response(*args, **kwargs):
        class DummyChoiceDelta:
            def __init__(self, content=None, reasoning_content=None, tool_calls=None):
                self.content = content
                self.reasoning_content = reasoning_content
                self.tool_calls = tool_calls or []

        class DummyChoice:
            def __init__(self, delta):
                self.delta = delta

        class DummyChunk:
            def __init__(self, choices, usage):
                self.choices = choices
                self.usage = usage

        # Simulate streaming chunks
        usage_info = {"prompt_tokens": 10, "completion_tokens": 20, "total_tokens": 30}
        # First chunk with some text content and usage
        yield DummyChunk(
            choices=[DummyChoice(DummyChoiceDelta(content="Hello"))],
            usage=usage_info,
        )
        # Second chunk with reasoning content and usage
        yield DummyChunk(
            choices=[DummyChoice(DummyChoiceDelta(reasoning_content="Thinking..."))],
            usage=usage_info,
        )
        # Third chunk with no choices but usage info (simulate end)
        yield DummyChunk(
            choices=[],
            usage=usage_info,
        )

    # Patch the model's internal client chat completions create method
    # The real method is OpenAIChatModel._client.chat.completions.create
    # We patch it to return an async generator simulating the streaming response
    with patch.object(
        agent.model._client.chat.completions,
        "create",
        new=AsyncMock(return_value=async_stream_response()),
    ):
        # Run a single interaction loop to get one response from the agent
        msg = None
        # We only run one step to test the response content and usage
        msg = await agent(msg)
        # The agent returns a Msg object; its metadata should contain usage info
        # The formatter should have parsed the usage info from the ChatResponse

        # Extract usage info from the last message metadata
        usage = msg.metadata.get("usage", None)

        # Assert that usage info is present and contains expected keys
        assert usage is not None, "Token usage info is missing in the response metadata"
        assert "prompt_tokens" in usage, "prompt_tokens missing in usage info"
        assert "completion_tokens" in usage, "completion_tokens missing in usage info"
        assert "total_tokens" in usage, "total_tokens missing in usage info"

        # Also check that the text content is non-empty
        text_content = msg.get_text_content()
        assert text_content and text_content.strip(), "Response text content is empty"

        # Now simulate user sending "exit" to terminate the loop
        msg = await user(msg)
        assert msg.get_text_content() != "exit", "User message should not be 'exit' on first turn"


@pytest.mark.asyncio
async def test_agent_loop_exit_condition():
    """
    Test that the agent loop exits when user sends 'exit'.
    This ensures the loop termination condition works.
    """

    agentscope.init(project="Agent", name="Friday", studio_url="http://localhost:3002")

    toolkit = Toolkit()
    toolkit.register_tool_function(execute_python_code)
    toolkit.register_tool_function(execute_shell_command)

    agent = ReActAgent(
        name="Friday",
        sys_prompt="You're a helpful assistant named Friday.",
        model=OpenAIChatModel(
            model_name="qwen3-coder-30b-a3b-instruct",
            api_key="dummy_api_key",
            stream=True,
            client_args={"base_url": "http://dummy-vllm-api"},
        ),
        formatter=OpenAIChatFormatter(),
        memory=InMemoryMemory(),
        toolkit=toolkit,
    )

    user = UserAgent(name="user")

    # Patch the model's internal client chat completions create method to yield a fixed response
    async def async_stream_response(*args, **kwargs):
        class DummyChoiceDelta:
            def __init__(self, content=None):
                self.content = content
                self.reasoning_content = None
                self.tool_calls = []

        class DummyChoice:
            def __init__(self, delta):
                self.delta = delta

        class DummyChunk:
            def __init__(self, choices, usage):
                self.choices = choices
                self.usage = {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}

        yield DummyChunk(
            choices=[DummyChoice(DummyChoiceDelta(content="Hello"))],
            usage={"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2},
        )

    with patch.object(
        agent.model._client.chat.completions,
        "create",
        new=AsyncMock(return_value=async_stream_response()),
    ):
        # Run one interaction to get a response
        msg = None
        msg = await agent(msg)
        # User sends "exit" to terminate
        exit_msg = UserAgent(name="user")
        exit_msg_input = exit_msg
        # We simulate user sending "exit"
        msg = await user(msg)
        # Manually override msg content to "exit" to test loop break condition
        msg._content = "exit"
        # Check that the loop break condition would be triggered
        assert msg.get_text_content() == "exit"


