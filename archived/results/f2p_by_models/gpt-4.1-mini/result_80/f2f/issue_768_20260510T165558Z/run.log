[32mimport asyncio
import unittest
from unittest.mock import AsyncMock, patch

from agentscope.agent import ReActAgent, UserAgent
from agentscope.model import OpenAIChatModel
from agentscope.formatter import OpenAIChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.tool import Toolkit, execute_python_code, execute_shell_command


class TestVLLMTokenUsage(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch requests.post used in agentscope.init to avoid real HTTP calls
        self.patcher_requests_post = patch("requests.post")
        self.mock_requests_post = self.patcher_requests_post.start()
        self.mock_requests_post.return_value.status_code = 200
        self.mock_requests_post.return_value.json.return_value = {}

        # Patch the internal model client's chat completions create method to simulate streaming response
        # We patch the _client attribute of OpenAIChatModel to mock the streaming response
        # We must patch the _client attribute, not openai directly, because openai is not imported as a top-level attribute
        # So patch the _client.chat.completions.create coroutine method to yield dummy streaming chunks
        async def dummy_stream_response(*args, **kwargs):
            # Simulate streaming chunks with token usage info
            class DummyChoiceDelta:
                def __init__(self):
                    self.content = "Hello"
                    self.reasoning_content = None
                    self.tool_calls = None

            class DummyChoice:
                def __init__(self):
                    self.delta = DummyChoiceDelta()

            class DummyChunk:
                def __init__(self):
                    self.choices = [DummyChoice()]

            usage = {"prompt_tokens": 5, "completion_tokens": 7, "total_tokens": 12}

            # Yield one chunk with usage info
            yield DummyChunk(), usage

        # Patch the _client.chat.completions.create coroutine method on the OpenAIChatModel instance
        # We patch the class attribute _client to a mock with chat.completions.create returning dummy async generator
        self.patcher_client = patch("agentscope.model._openai_model.OpenAIChatModel._client", create=True)
        self.mock_client = self.patcher_client.start()
        # Setup the nested mocks for chat.completions.create
        mock_chat = AsyncMock()
        mock_completions = AsyncMock()
        mock_completions.create = dummy_stream_response
        mock_chat.completions = mock_completions
        self.mock_client.return_value = mock_chat

        # Patch agentscope.init to avoid real HTTP calls and side effects
        self.patcher_agentscope_init = patch("agentscope.init")
        self.mock_agentscope_init = self.patcher_agentscope_init.start()

    async def asyncTearDown(self):
        self.patcher_requests_post.stop()
        self.patcher_client.stop()
        self.patcher_agentscope_init.stop()

    async def test_vllm_model_token_usage_in_chat_response(self):
        # Setup toolkit and agent using the VLLM model as in the issue repro
        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_key",
                stream=True,
                client_args={"base_url": "http://dummy-base-url"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        # Run one iteration of the agent call with a dummy message and verify token usage info is present in the response
        user = UserAgent(name="user")

        # Initial message is None (start of conversation)
        msg = None
        msg = await agent(msg)
        msg = await user(msg)

        # The message returned by agent should have token usage info in metadata or usage attribute
        # We check that the message content is non-empty and that usage info is present in the agent's last response
        # Since the dummy stream yields usage info, the agent should have it in the response metadata

        # The ReActAgent returns a Msg object; check metadata or usage attribute for token usage
        # The exact attribute depends on implementation, but usage should be present in the ChatResponse yielded by the model
        # We check the metadata of the message for token usage keys
        usage_keys = {"prompt_tokens", "completion_tokens", "total_tokens"}

        # The message metadata should contain usage info keys
        metadata = getattr(msg, "metadata", {})
        usage_present = any(key in metadata for key in usage_keys)

        self.assertTrue(
            usage_present,
            "Token usage info should be present in the agent's response metadata",
        )

    async def test_agent_loop_exit_condition(self):
        # Test the agent loop exit condition with the UserAgent returning "exit"
        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_key",
                stream=True,
                client_args={"base_url": "http://dummy-base-url"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        user = UserAgent(name="user")

        # Start with None message
        msg = None

        # Simulate user sending "exit" to break the loop
        async def user_agent_override(msg_in):
            # Return a Msg with text content "exit" to trigger loop break
            from agentscope.message import Msg

            return Msg(name="user", content="exit", role="user")

        # Patch the user agent call to return "exit"
        original_user_call = user.__call__
        user.__call__ = user_agent_override

        # Run the loop once and verify it breaks on "exit"
        count = 0
        while True:
            msg = await agent(msg)
            msg = await user(msg)
            count += 1
            if msg.get_text_content() == "exit":
                break

        user.__call__ = original_user_call

        self.assertEqual(count, 1, "Agent loop should break after user sends 'exit'")


if __name__ == "__main__":
    unittest.main()[0m
