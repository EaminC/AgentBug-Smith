from agentscope.tool import Toolkit, execute_python_code, execute_shell_command


class TestVLLMTokenUsage(unittest.IsolatedAsyncioTestCase):
    async def test_vllm_model_token_usage_in_chat_response(self):
        # Prepare dummy async generator to simulate streaming response with token usage info
        async def dummy_stream():
            class DummyChoiceDelta:
                def __init__(self):
                    self.content = "Hello"
                    self.reasoning_content = None
                    self.tool_calls = None

            class DummyChoice:
                def __init__(self):
                    self.delta = DummyChoiceDelta()

            class DummyChunk:
                def __init__(self):
                    self.choices = [DummyChoice()]
                    # usage is a dict-like object with keys as strings
                    self.usage = {
                        "prompt_tokens": 10,
                        "completion_tokens": 5,
                        "total_tokens": 15,
                    }

            yield DummyChunk()

        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_key",
                stream=True,
                client_args={"base_url": "http://dummy-base-url"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        # Patch the instance's client attribute's chat.completions.create coroutine method
        async def async_create(*args, **kwargs):
            class DummyResponse:
                def __aiter__(self_inner):
                    return dummy_stream()

                async def __aenter__(self_inner):
                    return self_inner

                async def __aexit__(self_inner, exc_type, exc, tb):
                    pass

            return DummyResponse()

        with patch.object(
            agent.model.client.chat.completions,
            "create",
            new=AsyncMock(side_effect=async_create),
        ):
            start_datetime = datetime.now()
            response = await async_create()
            responses = []
            async for chat_response in agent.model._parse_openai_stream_response(
                start_datetime, response
            ):
                responses.append(chat_response)

            # We expect the usage info to be present and have correct token counts
            self.assertTrue(any(r.usage is not None for r in responses))
            usage = next(r.usage for r in responses if r.usage is not None)
            # usage should be dict-like, keys as strings
            self.assertEqual(usage["prompt_tokens"], 10)
            self.assertEqual(usage["completion_tokens"], 5)
            self.assertEqual(usage["total_tokens"], 15)

