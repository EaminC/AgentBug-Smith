import unittest
from unittest.mock import AsyncMock, patch

from agentscope.agent import ReActAgent, UserAgent
from agentscope.model import OpenAIChatModel
from agentscope.formatter import OpenAIChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.tool import Toolkit, execute_python_code, execute_shell_command


class TestVLLMTokenUsage(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch the internal _client.chat.completions.create coroutine method of OpenAIChatModel instance
        # to avoid real network calls and simulate token usage info in response.
        # We patch the _client attribute's chat.completions.create coroutine method after instance creation.
        self.patcher_create = patch(
            "agentscope.model._openai_model.OpenAIChatModel._client",
            new_callable=AsyncMock,
        )
        # We will patch the _client attribute on the instance after creation, so patching here just for safety.
        self.addCleanup(self.patcher_create.stop)
        # Instead, patch the _client attribute's chat.completions.create method on the instance later.

    async def test_vllm_model_token_usage_in_chat_response(self):
        # Prepare dummy async generator to simulate streaming response with token usage info
        async def dummy_stream():
            # Simulate a single chunk with usage info and content
            class DummyChoiceDelta:
                def __init__(self):
                    self.content = "Hello"
                    self.reasoning_content = None
                    self.tool_calls = None

            class DummyChoice:
                def __init__(self):
                    self.delta = DummyChoiceDelta()

            class DummyChunk:
                def __init__(self):
                    self.choices = [DummyChoice()]
                    self.usage = {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15}

            yield DummyChunk()

        # Create the agent instance
        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_key",
                stream=True,
                client_args={"base_url": "http://dummy-base-url"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        # Patch the _client.chat.completions.create coroutine method on the agent.model instance
        async def async_create(*args, **kwargs):
            # Return an object with __aiter__ returning our dummy_stream
            class DummyResponse:
                def __aiter__(self_inner):
                    return dummy_stream()

            return DummyResponse()

        # Patch the _client attribute's chat.completions.create method
        with patch.object(
            agent.model._client.chat.completions,
            "create",
            new=AsyncMock(side_effect=async_create),
        ):
            # Run one iteration of the agent to get a response
            user = UserAgent(name="user")
            msg = None
            # Run the agent once to get a response message
            msg = await agent(msg)
            # The response should contain token usage info in the metadata
            usage = msg.metadata.get("usage", None)
            self.assertIsNotNone(usage, "Token usage info should be present in response metadata")
            self.assertIn("prompt_tokens", usage)
            self.assertIn("completion_tokens", usage)
            self.assertIn("total_tokens", usage)

    async def test_agent_loop_exit_condition(self):
        # Test the interaction loop with exit condition "exit"
        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_key",
                stream=True,
                client_args={"base_url": "http://dummy-base-url"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )
        user = UserAgent(name="user")

        # Patch the _client.chat.completions.create coroutine method on the agent.model instance
        async def async_create(*args, **kwargs):
            # Return an object with __aiter__ returning a dummy stream that yields "exit" text
            async def dummy_stream():
                class DummyChoiceDelta:
                    def __init__(self):
                        self.content = "exit"
                        self.reasoning_content = None
                        self.tool_calls = None

                class DummyChoice:
                    def __init__(self):
                        self.delta = DummyChoiceDelta()

                class DummyChunk:
                    def __init__(self):
                        self.choices = [DummyChoice()]
                        self.usage = {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}

                yield DummyChunk()

            class DummyResponse:
                def __aiter__(self_inner):
                    return dummy_stream()

            return DummyResponse()

        with patch.object(
            agent.model._client.chat.completions,
            "create",
            new=AsyncMock(side_effect=async_create),
        ):
            msg = None
            count = 0
            while True:
                msg = await agent(msg)
                msg = await user(msg)
                count += 1
                if msg.get_text_content() == "exit":
                    break
                # Prevent infinite loop in buggy code
                if count > 10:
                    self.fail("Agent loop did not exit after 10 iterations")

            self.assertEqual(msg.get_text_content(), "exit")


