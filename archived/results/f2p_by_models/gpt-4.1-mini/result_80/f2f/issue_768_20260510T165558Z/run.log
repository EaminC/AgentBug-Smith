class TestVLLMTokenUsage(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch the internal network call used by OpenAIChatModel to avoid real API calls
        # Patch the client attribute's chat.completions.create coroutine method
        # We patch the client attribute of the instance, so patching class attribute is not reliable.
        # Instead, patch the client attribute after instance creation in test method.
        pass

    async def test_vllm_model_token_usage_in_chat_response(self):
        # Prepare dummy async generator to simulate streaming response with token usage info
        async def dummy_stream():
            class DummyChoiceDelta:
                def __init__(self):
                    self.content = "Hello"
                    self.reasoning_content = None
                    self.tool_calls = None

            class DummyChoice:
                def __init__(self):
                    self.delta = DummyChoiceDelta()

            class DummyChunk:
                def __init__(self):
                    self.choices = [DummyChoice()]
                    # usage is a dict, but the buggy code expects attributes
                    self.usage = type(
                        "Usage",
                        (),
                        {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15},
                    )()

            yield DummyChunk()

        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_key",
                stream=True,
                client_args={"base_url": "http://dummy-base-url"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        # Patch the instance's client attribute's chat.completions.create coroutine method
        async def async_create(*args, **kwargs):
            class DummyResponse:
                def __aiter__(self_inner):
                    return dummy_stream()

                async def __aenter__(self_inner):
                    return self_inner

                async def __aexit__(self_inner, exc_type, exc, tb):
                    pass

            return DummyResponse()

        with patch.object(
            agent.model.client.chat.completions,
            "create",
            new=AsyncMock(side_effect=async_create),
        ):
            start_datetime = datetime.now()
            response = await async_create()
            responses = []
            async for chat_response in agent.model._parse_openai_stream_response(
                start_datetime, response
            ):
                responses.append(chat_response)

            # We expect the usage info to be present and have correct token counts
            self.assertTrue(any(r.usage is not None for r in responses))
            usage = next(r.usage for r in responses if r.usage is not None)
            self.assertEqual(usage.input_tokens, 10)
            self.assertEqual(usage.output_tokens, 5)
            self.assertEqual(usage.total_tokens, 15)

            # Also check that content includes a text block with "Hello"
            found_text = False
            for r in responses:
                for block in r.content:
                    if isinstance(block, TextBlock) and block.text == "Hello":
                        found_text = True
            self.assertTrue(found_text)

    async def test_agent_loop_exit_condition(self):
        # Setup toolkit with required tools
        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        class DummyModel(OpenAIChatModel):
            def __init__(self):
                # Do not call super().__init__ to avoid real initialization
                self.client = None
                self.stream = False  # To avoid AttributeError in agent code

            async def __call__(self, msg, **kwargs):
                # Return a Msg-like object with get_text_content method returning "exit"
                class DummyMsg:
                    def __init__(self, text):
                        self._text = text
                        self.content = [{"type": "text", "text": text}]  # Provide content as list of dicts

                    def get_text_content(self):
                        return self._text

                return DummyMsg("exit")

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=DummyModel(),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        user = UserAgent(name="user")

        msg = None
        count = 0
        while True:
            msg = await agent(msg)
            # Patch UserAgent._input_method to avoid input() call during test
            with patch.object(
                user,
                "_input_method",
                new=AsyncMock(return_value="exit"),
            ):
                msg = await user(msg)
            count += 1
            if msg.get_text_content() == "exit" or count > 10:
                break

        self.assertEqual(msg.get_text_content(), "exit")


