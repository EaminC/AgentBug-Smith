[32mimport asyncio
import unittest
from unittest.mock import AsyncMock, patch
from collections import OrderedDict
from typing import List
from datetime import datetime

from agentscope.agent import ReActAgent, UserAgent
from agentscope.model import OpenAIChatModel
from agentscope.formatter import OpenAIChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.tool import Toolkit, execute_python_code, execute_shell_command


class TestVLLMTokenUsage(unittest.IsolatedAsyncioTestCase):
    async def test_vllm_model_token_usage_in_chat_response(self):
        # Prepare dummy async generator to simulate streaming response with token usage info
        async def dummy_stream():
            class DummyChoiceDelta:
                def __init__(self):
                    self.content = "Hello"
                    self.reasoning_content = None
                    self.tool_calls = None

            class DummyChoice:
                def __init__(self):
                    self.delta = DummyChoiceDelta()

            class DummyChunk:
                def __init__(self):
                    self.choices = [DummyChoice()]
                    self.usage = {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15}

            yield DummyChunk()

        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_key",
                stream=True,
                client_args={"base_url": "http://dummy-base-url"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        # Patch the client attribute's chat.completions.create coroutine method
        async def async_create(*args, **kwargs):
            class DummyResponse:
                def __aiter__(self_inner):
                    return dummy_stream()

                async def __aenter__(self_inner):
                    return self_inner

                async def __aexit__(self_inner, exc_type, exc, tb):
                    pass

            return DummyResponse()

        with patch.object(
            agent.model.client.chat.completions,
            "create",
            new=AsyncMock(side_effect=async_create),
        ):
            # We call the internal method _parse_openai_stream_response directly to test token usage
            # This method is async generator yielding ChatResponse objects with usage info
            start_datetime = datetime.now()
            response = await async_create()
            # _parse_openai_stream_response is a private method, but we test it to ensure usage is present
            # We access it via the model instance
            # It is async generator, so collect all yielded responses
            responses = []
            async for chat_response in agent.model._parse_openai_stream_response(start_datetime, response):
                responses.append(chat_response)

            self.assertTrue(len(responses) > 0)
            # The last yielded ChatResponse should have usage info with keys prompt_tokens, completion_tokens, total_tokens
            usage = responses[-1].usage
            self.assertIsNotNone(usage)
            self.assertIn("prompt_tokens", usage)
            self.assertIn("completion_tokens", usage)
            self.assertIn("total_tokens", usage)
            self.assertEqual(usage["prompt_tokens"], 10)
            self.assertEqual(usage["completion_tokens"], 5)
            self.assertEqual(usage["total_tokens"], 15)

    async def test_agent_loop_exit_condition(self):
        # This test runs the agent loop patched with dummy streaming response that sends "exit" text
        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_key",
                stream=True,
                client_args={"base_url": "http://dummy-base-url"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )
        user = UserAgent(name="user")

        # Patch the client attribute's chat.completions.create coroutine method
        async def async_create(*args, **kwargs):
            async def dummy_stream():
                class DummyChoiceDelta:
                    def __init__(self):
                        self.content = "exit"
                        self.reasoning_content = None
                        self.tool_calls = None

                class DummyChoice:
                    def __init__(self):
                        self.delta = DummyChoiceDelta()

                class DummyChunk:
                    def __init__(self):
                        self.choices = [DummyChoice()]
                        self.usage = {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}

                yield DummyChunk()

            class DummyResponse:
                def __aiter__(self_inner):
                    return dummy_stream()

                async def __aenter__(self_inner):
                    return self_inner

                async def __aexit__(self_inner, exc_type, exc, tb):
                    pass

            return DummyResponse()

        with patch.object(
            agent.model.client.chat.completions,
            "create",
            new=AsyncMock(side_effect=async_create),
        ):
            msg = None
            count = 0
            while True:
                msg = await agent(msg)
                msg = await user(msg)
                if msg.get_text_content() == "exit":
                    break
                count += 1
                # safety break to avoid infinite loops in buggy code
                if count > 10:
                    self.fail("Agent loop did not exit as expected")


