import asyncio
from agentscope.agent import ReActAgent, UserAgent
from agentscope.model import OpenAIChatModel
from agentscope.formatter import OpenAIChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.tool import Toolkit, execute_python_code, execute_shell_command
from agentscope.message import Msg


class TestVLLMTokenUsage(unittest.IsolatedAsyncioTestCase):
    async def test_agent_loop_exit_condition(self):
        # Setup toolkit with required tools
        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        class DummyModel(OpenAIChatModel):
            def __init__(self):
                # Do not call super().__init__ to avoid real initialization
                self.client = None
                self.stream = False  # To avoid AttributeError in agent code

            async def __call__(self, msg, **kwargs):
                # Return a Msg-like object with get_text_content method returning "exit"
                class DummyMsg:
                    def __init__(self, text):
                        self._text = text
                        self.content = text  # Provide content attribute as expected by ReActAgent

                    def get_text_content(self):
                        return self._text

                return DummyMsg("exit")

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=DummyModel(),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        user = UserAgent(name="user")

        msg = None
        count = 0
        while True:
            msg = await agent(msg)
            msg = await user(msg)
            count += 1
            # The loop should exit when user returns a message with text "exit"
            if msg.get_text_content() == "exit":
                break
            # Safety break to avoid infinite loop in buggy code
            if count > 10:
                self.fail("Agent loop did not exit as expected")

        # If reached here, the loop exited correctly
        self.assertEqual(msg.get_text_content(), "exit")


if __name__ == "__main__":
    unittest.main()[0m
