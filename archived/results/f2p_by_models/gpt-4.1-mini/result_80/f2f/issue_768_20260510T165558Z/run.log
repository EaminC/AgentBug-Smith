                self.client = None
                self.stream = False  # To avoid AttributeError in agent code

            async def __call__(self, msg, **kwargs):
                # Return a Msg-like object with get_text_content method returning "exit"
                class DummyMsg:
                    def __init__(self, text):
                        self._text = text
                        # Provide content as list of dicts to mimic real Msg content
                        self.content = [{"type": "text", "text": text}]

                    def get_text_content(self):
                        return self._text

                return DummyMsg("exit")

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=DummyModel(),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        user = UserAgent(name="user")

        msg = None
        count = 0
        while True:
            msg = await agent(msg)
            # Patch UserAgent._input_method to avoid input() call during test
            # Provide an object with blocks_input and structured_input attributes
            class InputData:
                def __init__(self):
                    self.blocks_input = []
                    self.structured_input = None

            with patch.object(
                user,
                "_input_method",
                new=AsyncMock(return_value=InputData()),
            ):
                msg = await user(msg)
            count += 1
            # The loop should exit immediately because the dummy model returns "exit"
            if msg.get_text_content() == "exit" or count > 10:
                break

        self.assertEqual(msg.get_text_content(), "exit")


