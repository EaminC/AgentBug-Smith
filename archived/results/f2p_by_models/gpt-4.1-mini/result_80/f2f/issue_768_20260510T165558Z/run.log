[32mFROM python:3.10-slim AS test_builder

# Set workdir
WORKDIR /app

# Copy entire repo
COPY . .

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel

# Detect src/ layout or tests importing src.*
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.|^\s*import src\." tests 2>/dev/null; then \
        export PYTHONPATH=/app && \
        pip install -r requirements.txt 2>/dev/null || true && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    else \
        pip install -r requirements.txt 2>/dev/null || true && \
        pip install -e . && \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm; \
    fi

# Preflight import check to fail fast if something is missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Assumption: tests are runnable by pytest in tests/ directory by default

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Final CMD as per instructions
CMD ["/bin/bash"]


FROM python:3.10-slim AS runtime

WORKDIR /app

