[32mimport asyncio
import unittest
from unittest.mock import AsyncMock, patch

from agentscope.agent import ReActAgent, UserAgent
from agentscope.formatter import OpenAIChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.model import OpenAIChatModel
from agentscope.tool import Toolkit, execute_python_code, execute_shell_command


class TestVLLMTokenUsage(unittest.IsolatedAsyncioTestCase):
    async def asyncSetUp(self):
        # Patch the internal network call used by OpenAIChatModel to avoid real API calls
        # The buggy code uses openai.chat.completions.create internally, but it is not exposed as
        # agentscope.model._openai_model.openai, so patch the internal client attribute instead.
        # We patch the _client attribute's chat.completions.create coroutine method.
        # Since _client attribute does not exist on class but on instance, patch the method on the instance after creation.
        patcher = patch(
            "agentscope.model._openai_model.openai.chat.completions.create",
            new_callable=AsyncMock,
        )
        self.mock_create = patcher.start()
        self.addCleanup(patcher.stop)

        # Setup a dummy response generator for the mocked create method
        async def dummy_response(*args, **kwargs):
            # Simulate streaming chunks with usage info
            class DummyChoiceDelta:
                def __init__(self):
                    self.content = "Hello"
                    self.reasoning_content = None
                    self.tool_calls = None

            class DummyChoice:
                def __init__(self):
                    self.delta = DummyChoiceDelta()

            class DummyChunk:
                def __init__(self):
                    self.choices = [DummyChoice()]
                    self.usage = {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15}

            yield DummyChunk()

        self.mock_create.side_effect = dummy_response

        # Initialize agentscope
        import agentscope

        agentscope.init(project="Agent", name="Friday", studio_url="http://localhost:3002")

    async def test_vllm_model_token_usage_in_chat_response(self):
        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        # Use OpenAIChatModel with VLLM model name and dummy API key/base_url
        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_api_key",
                stream=True,
                client_args={"base_url": "http://dummy_base_url"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        user = UserAgent(name="user")

        msg = None
        # Run one interaction loop to test token usage presence
        msg = await agent(msg)
        msg = await user(msg)

        # The last response from agent should contain usage info with tokens
        # The agent's last response is in msg, but token usage is in the model's response generator
        # We test that the agent's last message metadata contains usage info

        # The ReActAgent returns Msg objects, but token usage is not directly exposed there.
        # Instead, test the model's streaming generator yields usage info properly.

        # We call the model directly to test token usage in the chat response
        # Prepare a simple prompt to the model
        prompt = [
            {"role": "user", "content": "Hello, how many tokens are used?"}
        ]

        # The model's __call__ is async generator yielding ChatResponse objects
        responses = []
        async for response in agent.model(prompt):
            responses.append(response)

        # Check that at least one response has usage info with tokens
        usage_found = any(
            hasattr(r, "usage")
            and r.usage is not None
            and isinstance(r.usage, dict)
            and "total_tokens" in r.usage
            for r in responses
        )
        self.assertTrue(usage_found, "Token usage info should be present in chat responses")

    async def test_agent_loop_exit_condition(self):
        # Test that the agent loop exits when user says "exit"
        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_api_key",
                stream=True,
                client_args={"base_url": "http://dummy_base_url"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        user = UserAgent(name="user")

        # Simulate conversation with exit condition
        # We patch user agent to send "exit" after first message
        original_user_call = user.__call__

        async def user_call_once(msg):
            # On first call, return a message with content "exit"
            # On subsequent calls, just return the message as is
            if not hasattr(user, "_called_once"):
                user._called_once = True
                from agentscope.message import Msg

                return Msg(name="user", content="exit", role="user")
            return await original_user_call(msg)

        user.__call__ = user_call_once

        msg = None
        count = 0
        while True:
            msg = await agent(msg)
            msg = await user(msg)
            count += 1
            if msg.get_text_content() == "exit":
                break
            if count > 10:
                self.fail("Agent loop did not exit after 10 iterations")

        self.assertEqual(msg.get_text_content(), "exit")


if __name__ == "__main__":
