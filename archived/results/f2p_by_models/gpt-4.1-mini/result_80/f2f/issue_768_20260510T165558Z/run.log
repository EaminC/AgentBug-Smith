                async def __aenter__(self_inner):
                    return self_inner

                async def __aexit__(self_inner, exc_type, exc, tb):
                    pass

            return DummyResponse()

        with patch.object(
            agent.model.client.chat.completions,
            "create",
            new=AsyncMock(side_effect=async_create),
        ):
            start_datetime = datetime.now()
