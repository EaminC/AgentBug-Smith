            class DummyChoice:
                def __init__(self, delta):
                    self.delta = delta

            class DummyChunk:
                def __init__(self, choices, usage=None):
                    self.choices = choices
                    self.usage = usage

            # First chunk: partial text and thinking content
            yield DummyChunk(
                choices=[DummyChoice(DummyDelta(content="Hello", reasoning_content="Thinking..."))],
                usage={"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15},
            )
            # Second chunk: more text, no thinking content
            yield DummyChunk(
                choices=[DummyChoice(DummyDelta(content=" world"))],
                usage={"prompt_tokens": 10, "completion_tokens": 10, "total_tokens": 20},
            )
            # Third chunk: no choices to simulate end of stream
            yield DummyChunk(choices=[], usage={"prompt_tokens": 10, "completion_tokens": 10, "total_tokens": 20})

        self.mock_create.return_value.__aenter__.return_value = dummy_stream()

    async def asyncTearDown(self):
        self.patcher_requests_post.stop()
        self.patcher_client_create.stop()

    async def test_vllm_model_token_usage_in_chat_response(self):
        # Initialize agentscope (studio_url is mocked, so no real connection)
        agentscope.init(project="Agent", name="Friday", studio_url="http://localhost:3002")

        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_api_key",
                stream=True,
                client_args={"base_url": "http://dummy-vllm-api"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        user = UserAgent(name="user")

        msg = None
        # Run one interaction cycle to get a response from the agent
        msg = await agent(msg)
        # The response should have token usage info in the metadata
        usage = msg.metadata.get("usage", None)
        self.assertIsNotNone(usage, "Token usage info should not be None")
        self.assertIn("prompt_tokens", usage)
        self.assertIn("completion_tokens", usage)
        self.assertIn("total_tokens", usage)

        # Also test the content is as expected (contains "Hello world")
        text_content = msg.get_text_content()
        self.assertIn("Hello", text_content)
        self.assertIn("world", text_content)

    async def test_agent_loop_exit_condition(self):
        # Patch requests.post again for init
        agentscope.init(project="Agent", name="Friday", studio_url="http://localhost:3002")

        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=OpenAIChatModel(
                model_name="qwen3-coder-30b-a3b-instruct",
                api_key="dummy_api_key",
                stream=True,
                client_args={"base_url": "http://dummy-vllm-api"},
            ),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        user = UserAgent(name="user")

        # We simulate a conversation where user sends "exit" to break the loop
        # Patch UserAgent.__call__ to return a Msg with text "exit" on first call
        async def user_call_exit(msg):
            # Return a Msg with text content "exit" to break the loop
            class DummyMsg:
                def get_text_content(self_inner):
                    return "exit"

                @property
                def metadata(self_inner):
                    return {}

            return DummyMsg()

        with patch.object(UserAgent, "__call__", side_effect=user_call_exit):
            msg = None
            count = 0
            while True:
                msg = await agent(msg)
                msg = await user(msg)
                count += 1
                if msg.get_text_content() == "exit":
                    break
                if count > 10:
                    self.fail("Agent loop did not exit after 10 iterations")

            self.assertEqual(msg.get_text_content(), "exit")


