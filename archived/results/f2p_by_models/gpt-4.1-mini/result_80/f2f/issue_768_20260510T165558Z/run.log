                    pass

            return DummyResponse()

        # Patch the client attribute's chat.completions.create method to return dummy response
        with patch.object(
            agent.model.client.chat.completions,
            "create",
            new=AsyncMock(side_effect=async_create),
        ):
            start_datetime = datetime.now()
            response = await async_create()
            responses = []
            # We expect the _parse_openai_stream_response to yield ChatResponse with usage populated correctly
            async for chat_response in agent.model._parse_openai_stream_response(
                start_datetime, response
            ):
                responses.append(chat_response)

            # There should be at least one ChatResponse yielded
            self.assertGreater(len(responses), 0)

            # The usage attribute should be present and have correct token counts
            usage = responses[0].usage
            self.assertIsNotNone(usage)
            self.assertEqual(usage.input_tokens, 10)
            self.assertEqual(usage.output_tokens, 5)
            # total_tokens is not stored in usage but can be checked indirectly if needed

            # The content should include the text "Hello"
            found_text = False
            for block in responses[0].content:
                if hasattr(block, "text") and block.text == "Hello":
                    found_text = True
                    break
            self.assertTrue(found_text)


