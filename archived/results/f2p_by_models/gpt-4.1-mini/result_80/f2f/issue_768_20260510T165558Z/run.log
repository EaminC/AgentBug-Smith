[32mimport asyncio
import unittest

from agentscope.agent import ReActAgent, UserAgent
from agentscope.formatter import OpenAIChatFormatter
from agentscope.memory import InMemoryMemory
from agentscope.model import OpenAIChatModel
from agentscope.tool import Toolkit, execute_python_code, execute_shell_command


class TestVLLMTokenUsage(unittest.IsolatedAsyncioTestCase):
    async def test_agent_loop_exit_condition(self):
        # Test the agent and user loop exit condition with a dummy model that returns "exit" text
        toolkit = Toolkit()
        toolkit.register_tool_function(execute_python_code)
        toolkit.register_tool_function(execute_shell_command)

        class DummyModel(OpenAIChatModel):
            def __init__(self):
                # We do not call super().__init__ to avoid real initialization
                self.client = None

            async def __call__(self, msg, **kwargs):
                # Return a Msg-like object with get_text_content method returning "exit" after first call
                class DummyMsg:
                    def __init__(self, text):
                        self._text = text

                    def get_text_content(self):
                        return self._text

                return DummyMsg("exit")

        agent = ReActAgent(
            name="Friday",
            sys_prompt="You're a helpful assistant named Friday.",
            model=DummyModel(),
            formatter=OpenAIChatFormatter(),
            memory=InMemoryMemory(),
            toolkit=toolkit,
        )

        user = UserAgent(name="user")

        msg = None
        count = 0
        while True:
            msg = await agent(msg)
            msg = await user(msg)
            count += 1
            # The loop should exit when the agent returns a message with text "exit"
            if msg.get_text_content() == "exit":
                break
            # Safety to prevent infinite loop in case of bug
            if count > 10:
                self.fail("Agent loop did not exit after 10 iterations")

        # After loop exit, the last message text content must be "exit"
        self.assertEqual(msg.get_text_content(), "exit")


if __name__ == "__main__":
    unittest.main()[0m
