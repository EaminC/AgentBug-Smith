# Set working directory to /app
WORKDIR /app

# Copy entire repository into container
COPY . .

# Install system dependencies needed for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*

# Upgrade pip, setuptools, wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Install project dependencies conditionally if requirements.txt exists,
# then install the package itself in editable mode,
# followed by installing essential testing packages
RUN if [ -f "requirements.txt" ]; then pip install -r requirements.txt; fi && \
    pip install -e . && \
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio pytest-xdist pytest-timeout litellm mem0ai "setuptools<=81.0.0"

# Preflight check to verify python package and pytest import
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Default command to start a bash session
CMD ["/bin/bash"]

