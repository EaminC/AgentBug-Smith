[32mFROM python:3.12-slim AS test_builder

WORKDIR /app

# Copy entire repository
COPY . .

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel && \
    # Install dependencies and project with uv if uv.lock exists, else fallback to pip install -e .
    if [ -f "uv.lock" ]; then \
        pip install uv && \
        uv sync --dev --all-extras; \
    else \
        pip install -r requirements.txt 2>/dev/null || true && \
        pip install -e .; \
    fi && \
    # Unconditionally install testing dependencies
    pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout

# Preflight import check to fail fast if core modules missing
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Set Forge environment variables
ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Set standard working directory environment variable for source imports
ENV PYTHONPATH=/app

# Run tests
RUN pytest -v

# Minimal runtime image with production dependencies only
FROM python:3.12-slim AS runtime

WORKDIR /app

COPY --from=test_builder /app /app

# Upgrade pip, setuptools, wheel early
RUN python -m pip install --upgrade pip setuptools wheel && \
    # Install runtime dependencies with uv if uv.lock exists, else fallback to pip install -e . without dev extras
    if [ -f "uv.lock" ]; then \
        pip install uv && \
        uv sync; \
    else \
        pip install -r requirements.txt 2>/dev/null || true && \
        pip install -e .; \
    fi

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}
ENV PYTHONPATH=/app

CMD ["/bin/bash"][0m
