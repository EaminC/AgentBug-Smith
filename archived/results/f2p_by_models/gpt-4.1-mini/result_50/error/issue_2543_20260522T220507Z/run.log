# Install system dependencies and Python build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libffi-dev libxml2-dev libxslt1-dev python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --upgrade pip setuptools wheel

# Copy entire repo to /app
COPY . .

# Robust Python dependency installation and project install
RUN if [ -f "requirements.txt" ]; then \
        pip install -r requirements.txt && pip install -e .; \
    elif [ -f "pyproject.toml" ] && [ -f "poetry.lock" ]; then \
        pip install poetry && poetry install && pip install -e .; \
    elif [ -f "pyproject.toml" ]; then \
        pip install -e .; \
    else \
        echo "Warning: No Python dependency config found"; \
    fi && \
    pip install pytest pytest-mock pytest-xdist pytest-timeout litellm "setuptools<=81.0.0"

ENV PYTHONPATH=/app

# Preflight test to check installation
RUN python3 -c 'import pkg_resources, pytest; print("preflight ok")'

CMD ["/bin/bash"]
