    # We will monkeypatch DeepResearchAgent._acting to use our dummy tool_res
    # But since _acting expects tool_res from tool_call, we simulate that by patching agent._acting to call with dummy tool_res

    # Instantiate the agent
    agent = DeepResearchAgent()

