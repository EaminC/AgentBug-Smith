@pytest.mark.asyncio
async def test_deep_research_agent_avoids_attribute_error_on_none_metadata(monkeypatch):
    """
    This test triggers the buggy _acting method in DeepResearchAgent by feeding it a tool_res
    that yields chunks with None metadata. The buggy code will raise AttributeError on chunk.metadata.get.
    After the patch, the code should handle None metadata gracefully and not raise.
    """

    # Instantiate the agent
    agent = DeepResearchAgent()

    # Prepare a dummy tool_call with the finish_function_name to trigger the relevant code path
    tool_call = DummyToolUseBlock(agent.finish_function_name)

    # Prepare chunks with None metadata to simulate the bug trigger
    chunks = [
        DummyChunk(metadata=None, is_last=False),  # This chunk will cause AttributeError in buggy code
        DummyChunk(metadata={"success": True, "response_msg": Msg(content="test response")}, is_last=True),
    ]

    # Create dummy async generator for tool_res
    dummy_tool_res = DummyToolRes(chunks)

    # Patch the _acting method's tool_res source to yield our dummy_tool_res
    # Since _acting takes tool_call and uses tool_res from somewhere,
    # we patch _acting to use our dummy_tool_res directly.
    # But _acting expects tool_res as input? Actually, _acting takes tool_call and internally calls tool_res.
    # We must patch the method or the call that produces tool_res.
    # The code snippet shows _acting(tool_call: ToolUseBlock) -> Msg | None:
    # and inside it uses async for chunk in tool_res:
    # So tool_res must be passed or set on the agent or tool_call?

    # We will patch the agent to override the method that produces tool_res to return dummy_tool_res
    # The original code likely calls some tool or model that returns tool_res.
    # We patch the agent._call_tool or similar to return dummy_tool_res.

    # Patch the agent's _call_tool method to return dummy_tool_res
    # If _acting calls self._call_tool(tool_call) to get tool_res, patch that.

    # We check if agent has _call_tool method
    if hasattr(agent, "_call_tool"):
        monkeypatch.setattr(agent, "_call_tool", lambda call: dummy_tool_res)
    else:
        # If no _call_tool, patch _acting to use dummy_tool_res directly by wrapping original _acting
        original_acting = agent._acting

        async def patched_acting(tool_call):
            # Ignore original tool_res source, use dummy_tool_res
            # We replicate the original _acting logic but replace tool_res with dummy_tool_res
            # But this is complex; instead patch _acting to call original with dummy_tool_res injected
            # Not feasible without source code change, so skip this fallback
            return await original_acting(tool_call)

        monkeypatch.setattr(agent, "_acting", patched_acting)

    # Run _acting and assert no AttributeError occurs and returns expected Msg or None
    # We expect no exception and a Msg returned from chunk with success True

    result = await agent._acting(tool_call)

    # The last chunk has success True and response_msg Msg, so result should be that Msg
    assert isinstance(result, Msg)
    assert "test response" in result.content


