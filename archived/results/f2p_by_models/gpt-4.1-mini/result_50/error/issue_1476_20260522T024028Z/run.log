    """

    agent = DeepResearchAgent()

    agent.finish_function_name = "finish_tool"
    agent.summarize_function = "summarize_tool"
    agent.current_subtask = []

    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    async def dummy_tool_res():
        # Yield one chunk with update_memory True and intermediate_report
        yield DummyChunk(metadata={"update_memory": True, "intermediate_report": "report"}, is_last=True)

    async def dummy_call_tool(_):
        return dummy_tool_res()

    monkeypatch.setattr(agent, "_call_tool", dummy_call_tool)

    async def dummy_print(msg, is_last):
        pass

    monkeypatch.setattr(agent, "print", dummy_print)

    tool_call = ToolUseBlock({"name": "some_tool"})

    # Patch agent attributes to observe update_memory and intermediate_report
    agent.update_memory = False
    agent.intermediate_report = None

    # We patch _acting to capture update_memory and intermediate_report changes
    # But since _acting returns None, we check agent attributes after call

    result = await agent._acting(tool_call)

    # The bug fix ensures no AttributeError and proper handling of metadata dict
    # We expect update_memory flag to be set True and intermediate_report to be set
    # But original code sets local variables, so we check for no exceptions and result None
    assert result is None


