import pytest

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_acting_handles_none_metadata():
    """
    This test triggers the _acting method of DeepResearchAgent with a tool result chunk
    whose metadata is None, which previously caused an AttributeError.
    The test passes if no exception is raised and the method returns None or a valid Msg.
    """

    # Create an instance of DeepResearchAgent
    agent = DeepResearchAgent()

    # Prepare a dummy tool_call dict with required keys
    tool_call = {
        "name": "some_tool",
    }

    # We need to mock or simulate the tool_res async generator that _acting consumes.
    # It yields chunks with metadata=None to reproduce the bug.

    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    class DummyToolRes:
        def __aiter__(self):
            # Yield one chunk with metadata=None to trigger the bug
            yield DummyChunk(metadata=None, is_last=True)

    # Patch the agent's _acting method to use our dummy tool_res
    # Actually, _acting receives tool_call and internally calls tool_res = await self._call_tool(tool_call)
    # We cannot patch _call_tool directly here without mocking _acting itself.
    # Instead, we will monkeypatch _call_tool to return our dummy async generator.

    async def dummy_call_tool(_):
        return DummyToolRes()

    agent._call_tool = dummy_call_tool  # monkeypatch

    # Run _acting and assert no AttributeError occurs
    # It should handle chunk.metadata == None gracefully and not raise

    result = await agent._acting(tool_call)

    # The method may return None or a Msg object; we just assert no exception and result is not an error
    # Since we do not have Msg imported or defined here, just check result is None or has attribute 'content'
    assert result is None or hasattr(result, "content")


@pytest.mark.asyncio
async def test_deep_research_agent_acting_with_success_false_metadata():
    """
    This test triggers _acting with a chunk whose metadata is a dict but 'success' is False.
    It should call print and not raise.
    """

    agent = DeepResearchAgent()

    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    class DummyToolRes:
        def __aiter__(self):
            yield DummyChunk(metadata={"success": False}, is_last=True)

    async def dummy_call_tool(_):
        return DummyToolRes()

    agent._call_tool = dummy_call_tool

    # Patch agent.print to record calls
    printed = []

    async def dummy_print(msg, is_last):
        printed.append((msg, is_last))

    agent.print = dummy_print

    result = await agent._acting({"name": "not_finish_function"})

    # It should call print once and return None
    assert len(printed) == 1
    assert result is None


@pytest.mark.asyncio
async def test_deep_research_agent_acting_with_finish_function_success_true():
    """
    This test triggers _acting with a chunk whose metadata has success=True and name == finish_function_name,
    and current_subtask is empty, so it returns response_msg from metadata.
    """

    agent = DeepResearchAgent()
    agent.finish_function_name = "finish"

    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    class DummyToolRes:
        def __aiter__(self):
            yield DummyChunk(metadata={"success": True, "response_msg": "done"}, is_last=True)

    async def dummy_call_tool(_):
        return DummyToolRes()

    agent._call_tool = dummy_call_tool
    agent.current_subtask = []

    result = await agent._acting({"name": "finish"})

    assert result == "done"


