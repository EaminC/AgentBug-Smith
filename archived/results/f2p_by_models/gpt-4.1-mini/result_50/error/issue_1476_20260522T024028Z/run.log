from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent
from agentscope.message import Msg
from agentscope.tool import ToolUseBlock


@pytest.mark.asyncio
async def test_deep_research_agent_avoids_attribute_error_on_none_metadata():
    """
    This test triggers the _acting method of DeepResearchAgent with a ToolUseBlock
    that produces chunks with None metadata, which previously caused an AttributeError.
    The test expects no exception and a valid return (None or Msg).
    """

    # Create an instance of DeepResearchAgent with minimal required initialization.
    # We assume it can be initialized without arguments or with dummy args.
    # If required, adjust initialization accordingly.
    agent = DeepResearchAgent()

    # Prepare a dummy ToolUseBlock with a name that triggers the _acting logic.
    # We simulate the tool_call dictionary with required keys.
    tool_call = ToolUseBlock({
        "name": "some_tool",
    })

    # We need to simulate the tool_res async generator that _acting iterates over.
    # We monkeypatch the agent._acting method's internal tool_res to yield chunks with None metadata.

    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    class DummyToolRes:
        def __aiter__(self):
            # Yield chunks with None metadata to trigger the bug
            return self

        async def __anext__(self):
            # Yield one chunk with None metadata, then StopAsyncIteration
            if not hasattr(self, "yielded"):
                self.yielded = True
                return DummyChunk(metadata=None, is_last=True)
            else:
                raise StopAsyncIteration

    # Patch the agent._acting to use our dummy tool_res
    # We do this by patching the method to call the original _acting with the dummy tool_res
    # But since _acting creates tool_res internally, we patch the method to inject our dummy tool_res.

    # Instead, we call _acting directly with a ToolUseBlock and patch the attribute that yields tool_res.
    # The _acting method calls tool_call["name"], so we must provide that.

    # We monkeypatch the agent._acting method's internal usage of tool_res by patching the tool_call to have an async generator attribute.

    # Since the original _acting method uses "tool_res = self._call_tool(tool_call)" or similar,
    # but we don't have that code here, we simulate by calling _acting with a ToolUseBlock and patching the agent._call_tool method.

    # Patch agent._call_tool to return our DummyToolRes
    async def dummy_call_tool(tool_call):
        return DummyToolRes()

    agent._call_tool = dummy_call_tool

    # Now call _acting and verify no AttributeError is raised.
    # It should handle chunk.metadata == None gracefully.

    result = await agent._acting(tool_call)

    # The result should be either None or a Msg instance (per method signature)
    assert result is None or isinstance(result, Msg)


