from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_avoids_attribute_error_on_none_metadata():
    """
    This test triggers DeepResearchAgent._acting with a tool_call that yields chunks
    with None metadata, reproducing the AttributeError in the buggy version.
    The test asserts that no AttributeError is raised and that the method returns None or a valid Msg.
    """

    # Create an instance of DeepResearchAgent with minimal required initialization.
    # We assume DeepResearchAgent can be instantiated without arguments or with dummy args.
    # If not, adapt accordingly.
    agent = DeepResearchAgent()

    # Define a dummy ToolUseBlock-like object with minimal interface for _acting.
    # It must have a "name" key and be awaitable or iterable for tool_res.
    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata  # This will be None to trigger the bug.
            self.is_last = is_last

    class DummyToolRes:
        def __aiter__(self):
            # Yield chunks with None metadata to trigger the bug.
            # Yield multiple chunks to simulate streaming.
            return self

        async def __anext__(self):
            if not hasattr(self, "count"):
                self.count = 0
            if self.count < 3:
                self.count += 1
                # Return chunk with None metadata to trigger the bug.
                return DummyChunk(metadata=None, is_last=(self.count == 3))
            else:
                raise StopAsyncIteration

    # Construct a dummy tool_call dict with required keys.
    dummy_tool_call = {
        "name": "some_tool",
    }

    # Patch the _acting method to accept our dummy tool_res.
    # We will monkeypatch the agent._acting method to call the original but with our dummy tool_res.
    # But since _acting expects tool_call and yields from tool_res, we simulate tool_res inside _acting.
    # Instead, we call _acting with dummy_tool_call and patch the part that yields tool_res to yield our dummy chunks.

    # To do this, we monkeypatch the agent to replace the call that produces tool_res with our dummy.

    # The original _acting calls: tool_res = await self._call_tool(tool_call)
    # We patch _call_tool to return our DummyToolRes.

    async def dummy_call_tool(tool_call):
        return DummyToolRes()

    agent._call_tool = dummy_call_tool

    # Run the _acting method and assert no AttributeError is raised.
    # It should return None or a Msg object (we accept None here).
    try:
        result = await agent._acting(dummy_tool_call)
    except AttributeError as e:
        pytest.fail(f"_acting raised AttributeError unexpectedly: {e}")

    # The result can be None or a Msg, just assert no exception and result is not an error.
    assert result is None or hasattr(result, "content")


if __name__ == "__main__":
