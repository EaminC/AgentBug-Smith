[32mimport asyncio
import pytest

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent


@pytest.mark.asyncio
async def test_deep_research_agent_acting_handles_none_metadata():
    """
    Test that DeepResearchAgent._acting does not raise AttributeError when chunk.metadata is None.
    This reproduces the bug where chunk.metadata.get(...) causes AttributeError.
    The fix ensures chunk.metadata is safely handled even if None.
    """

    # Create an instance of DeepResearchAgent with minimal required initialization.
    # We assume DeepResearchAgent can be instantiated without args or with dummy args.
    agent = DeepResearchAgent()

    # We need to simulate a tool_call and tool_res that triggers the _acting method.
    # _acting is async def _acting(self, tool_call: ToolUseBlock) -> Msg | None:
    # We will create a dummy tool_call dict with required keys and a dummy async generator tool_res.

    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    class DummyToolRes:
        def __init__(self, chunks):
            self._chunks = chunks

        def __aiter__(self):
            self._iter = iter(self._chunks)
            return self

        async def __anext__(self):
            try:
                return next(self._iter)
            except StopIteration:
                raise StopAsyncIteration

    # Compose chunks with None metadata to trigger the bug
    chunks = [
        DummyChunk(metadata=None, is_last=False),
        DummyChunk(metadata=None, is_last=True),
    ]
    tool_res = DummyToolRes(chunks)

    # Compose tool_call dict with required keys
    # The _acting method checks tool_call["name"] and compares to self.finish_function_name and self.summarize_function
    # We set finish_function_name and summarize_function to some dummy values on agent
    agent.finish_function_name = "finish"
    agent.summarize_function = "summarize"

    # We test two cases:
    # 1) tool_call name != finish_function_name to test the print branch
    # 2) tool_call name == finish_function_name to test the return branch

    # Patch agent.print to a dummy async function to avoid side effects
    async def dummy_print(msg, is_last):
        # Just record calls if needed, or pass
        pass

    agent.print = dummy_print

    # Case 1: name != finish_function_name
    tool_call_1 = {"name": "other_tool"}

    # We patch the _acting method to use our dummy tool_res instead of real tool_res
    # But _acting expects tool_res from tool_call? Actually _acting receives tool_call and calls tool_res = self._call_tool(tool_call)
    # We cannot patch _call_tool easily without mocking _acting itself.
    # Instead, we will monkeypatch _call_tool to return our dummy tool_res.

    # Save original _call_tool if exists
    original_call_tool = getattr(agent, "_call_tool", None)

    async def dummy_call_tool(tool_call):
        return tool_res

    agent._call_tool = dummy_call_tool

    # Run _acting and ensure no AttributeError is raised
    # It should call dummy_print for each chunk without error
    try:
        result = await agent._acting(tool_call_1)
    except AttributeError as e:
        pytest.fail(f"_acting raised AttributeError unexpectedly: {e}")

    # Result should be None because tool_call name != finish_function_name and no return triggered
    assert result is None

    # Case 2: name == finish_function_name and chunk.metadata is None
    tool_call_2 = {"name": agent.finish_function_name}

    # We create chunks with metadata None but simulate chunk_metadata.get("success", True) == True to trigger return
    # Since metadata is None, chunk_metadata will be {}, so get("success", True) returns True
    # But chunk_metadata.get("response_msg") returns None, so return None expected

    try:
        result = await agent._acting(tool_call_2)
    except AttributeError as e:
        pytest.fail(f"_acting raised AttributeError unexpectedly: {e}")

    # The result is expected to be None because chunk_metadata.get("response_msg") is None
    assert result is None

    # Restore original _call_tool if any
    if original_call_tool is not None:
        agent._call_tool = original_call_tool
    else:
        delattr(agent, "_call_tool")[0m
