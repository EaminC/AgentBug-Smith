        self.is_last = is_last


class DummyToolUseBlock(dict):
    pass


class DummyToolResponse:
    def __init__(self, chunks):
        self._chunks = chunks

    def __aiter__(self):
        self._iter = iter(self._chunks)
        return self

    async def __anext__(self):
        try:
            return next(self._iter)
        except StopIteration:
            raise StopAsyncIteration


@pytest.mark.asyncio
async def test_deep_research_agent_acting_handles_none_metadata(monkeypatch):
    """
    This test triggers the _acting method of DeepResearchAgent with a tool response
    containing chunks with None metadata to reproduce the AttributeError.
    The test expects no AttributeError and proper handling of None metadata.
    """

    agent = DeepResearchAgent()

    # Prepare chunks with None metadata and one with dict metadata
    chunks = [
        DummyChunk(metadata=None, is_last=False),
        DummyChunk(metadata={"success": False}, is_last=False),
        DummyChunk(metadata={"success": True, "response_msg": Msg(content="done")}, is_last=True),
    ]

    # Prepare a dummy ToolUseBlock with required keys
    tool_call = DummyToolUseBlock()
    tool_call["name"] = agent.finish_function_name

    # Patch the agent's print method to a no-op coroutine to avoid side effects
    async def dummy_print(*args, **kwargs):
        pass

    monkeypatch.setattr(agent, "print", dummy_print)

    # Patch the agent's _acting to use our dummy async generator for tool_res
    async def dummy_tool_res():
        for chunk in chunks:
            yield chunk

    # Patch the method that returns tool_res to return our dummy_tool_res async generator
    # The original _acting method receives tool_call and expects tool_res from somewhere.
    # Since _acting is async def _acting(self, tool_call: ToolUseBlock) -> Msg | None:
    # and tool_res is awaited from tool_call["tool"].call or similar, we patch the method that returns tool_res.
    # But since we cannot patch inside _acting easily, we simulate by patching the method that _acting calls to get tool_res.
    # However, the code snippet shows _acting receives tool_call and uses tool_res = await tool_call(...) or similar.
    # We will patch the agent to have a method that returns our dummy_tool_res when _acting is called.

    # Instead, we patch the agent._acting method's internal call to get tool_res by monkeypatching the tool_call to be our dummy_tool_res.

    # Actually, _acting receives tool_call: ToolUseBlock, and tool_res is awaited from tool_call["tool"].call or similar.
    # We can patch tool_call to have an async __call__ returning dummy_tool_res.

    class DummyTool:
        def __init__(self, chunks):
            self.chunks = chunks

        async def __call__(self):
            return DummyToolResponse(self.chunks)

    tool_call["tool"] = DummyTool(chunks)

    # Run _acting and verify it returns the expected Msg from chunk with metadata success True
    result = await agent._acting(tool_call)

    # The last chunk has metadata with success True and response_msg Msg(content="done")
    assert isinstance(result, Msg)
    assert result.content == "done"


