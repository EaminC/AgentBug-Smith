import pytest

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent
from agentscope.message import Msg
from agentscope.tool import ToolUseBlock


@pytest.mark.asyncio
async def test_deep_research_agent_acting_handles_none_metadata(monkeypatch):
    """
    This test triggers the _acting method of DeepResearchAgent with a tool response
    chunk that has metadata=None, which previously caused an AttributeError.
    After the fix, the method should handle None metadata gracefully and not raise.
    """

    # Create an instance of DeepResearchAgent with minimal required init params.
    # We assume DeepResearchAgent can be instantiated without arguments or with dummy args.
    agent = DeepResearchAgent()

    # Prepare a dummy ToolUseBlock with the finish_function_name set to a known value.
    # We set the name to something other than finish_function_name to test the conditional.
    tool_call = ToolUseBlock({"name": "dummy_tool"})

    # We need to simulate the async generator tool_res that _acting consumes.
    # It yields chunks with metadata=None to reproduce the bug.

    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    async def dummy_tool_res():
        # Yield one chunk with metadata=None to trigger the bug
        yield DummyChunk(metadata=None, is_last=True)

    # Patch the _acting method's internal call to get tool_res to our dummy async generator.
    # The _acting method accepts tool_call and internally calls tool_res = self._call_tool(tool_call)
    # We patch _call_tool to return dummy_tool_res()
    async def dummy_call_tool(_):
        return dummy_tool_res()

    monkeypatch.setattr(agent, "_call_tool", dummy_call_tool)

    # Patch agent.finish_function_name to a known string for conditional checks
    agent.finish_function_name = "finish_tool"
    agent.summarize_function = "summarize_tool"
    agent.current_subtask = []

    # Patch agent.print to a no-op async function to avoid side effects
    async def dummy_print(msg, is_last):
        pass

    monkeypatch.setattr(agent, "print", dummy_print)

    # Run the _acting method with tool_call that has name != finish_function_name
    # This should process the chunk with metadata=None without raising AttributeError
    result = await agent._acting(tool_call)

    # The result should be None because finish_function_name is not matched and no response_msg returned
    assert result is None


@pytest.mark.asyncio
async def test_deep_research_agent_acting_finish_function_name_with_none_metadata(monkeypatch):
    """
    Test _acting when tool_call name equals finish_function_name and chunk.metadata is None.
    It should handle None metadata and not raise, returning None or response_msg if present.
    """

    agent = DeepResearchAgent()

    # Setup finish_function_name to "finish_tool"
    agent.finish_function_name = "finish_tool"
    agent.summarize_function = "summarize_tool"
    agent.current_subtask = []

    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    async def dummy_tool_res():
        # Yield one chunk with metadata=None and is_last True
        yield DummyChunk(metadata=None, is_last=True)

    async def dummy_call_tool(_):
        return dummy_tool_res()

    monkeypatch.setattr(agent, "_call_tool", dummy_call_tool)

    async def dummy_print(msg, is_last):
        pass

    monkeypatch.setattr(agent, "print", dummy_print)

    # Prepare tool_call with name == finish_function_name
    tool_call = ToolUseBlock({"name": "finish_tool"})

    # Run _acting; should not raise and return None because metadata is None and no response_msg
    result = await agent._acting(tool_call)

    assert result is None


@pytest.mark.asyncio
async def test_deep_research_agent_acting_with_metadata_dict(monkeypatch):
    """
    Test _acting with chunk.metadata as a dict containing 'success' and 'response_msg'.
    It should return the response_msg properly.
    """

    agent = DeepResearchAgent()

    agent.finish_function_name = "finish_tool"
    agent.summarize_function = "summarize_tool"
    agent.current_subtask = []

    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    async def dummy_tool_res():
        # Yield one chunk with metadata dict containing success=True and response_msg
        yield DummyChunk(metadata={"success": True, "response_msg": Msg(content="response")}, is_last=True)

    async def dummy_call_tool(_):
        return dummy_tool_res()

    monkeypatch.setattr(agent, "_call_tool", dummy_call_tool)

    async def dummy_print(msg, is_last):
        pass

    monkeypatch.setattr(agent, "print", dummy_print)

    tool_call = ToolUseBlock({"name": "finish_tool"})

    result = await agent._acting(tool_call)

    assert isinstance(result, Msg)
    assert result.content == "response" or (hasattr(result.content, "__contains__") and "response" in result.content)


