                and not chunk_metadata.get("success")
            ):
                await self.print(tool_res_msg, chunk.is_last)

            if tool_call_arg["name"] == self.finish_function_name and chunk_metadata.get("success", True):
                if len(self.current_subtask) == 0:
                    return chunk_metadata.get("response_msg")

        return None

    agent._acting = patched_acting.__get__(agent)

    # Run the _acting method and assert no AttributeError occurs and the expected Msg is returned
    result = await agent._acting(tool_call)

    # The last chunk has metadata with success=True and response_msg=Msg(content="done")
    assert isinstance(result, Msg)
    assert result.content == "done" or (isinstance(result.content, list) and any("done" in str(c) for c in result.content)) or "done" in str(result.content)


