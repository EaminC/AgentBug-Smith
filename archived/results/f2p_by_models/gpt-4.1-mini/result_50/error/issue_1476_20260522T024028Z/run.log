[32mimport asyncio
import pytest

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent
from agentscope.message import Msg
from agentscope.tool import ToolUseBlock


@pytest.mark.asyncio
async def test_deep_research_agent_acting_handles_none_metadata():
    """
    This test triggers the _acting method of DeepResearchAgent with a ToolUseBlock
    that yields chunks with None metadata, which previously caused AttributeError.

    The test expects no exception and a None or Msg return value.
    """

    # Create a dummy chunk class to simulate tool_res async generator output
    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    # Create a dummy async generator that yields chunks with None metadata
    async def dummy_tool_res():
        # Yield one chunk with None metadata and is_last False
        yield DummyChunk(metadata=None, is_last=False)
        # Yield one chunk with dict metadata and is_last True to simulate finish
        yield DummyChunk(metadata={"success": True, "response_msg": Msg(content="done")}, is_last=True)

    # Create a dummy ToolUseBlock with required interface
    # We only need "name" key for the test, simulate finish_function_name usage
    tool_call = ToolUseBlock({"name": "finish_function"})

    # Instantiate the agent
    agent = DeepResearchAgent()

    # Patch the agent's finish_function_name to match our tool_call name
    agent.finish_function_name = "finish_function"

    # Patch the agent's print method to a no-op coroutine to avoid side effects
    async def dummy_print(msg, is_last):
        pass

    agent.print = dummy_print

    # Patch the agent's _acting method's tool_res to our dummy_tool_res
    # Since _acting expects tool_res from tool_call execution, we patch tool_call execution
    # But _acting receives tool_call and calls tool_res = await tool_call.execute()
    # We will monkeypatch tool_call to have an async __aiter__ returning dummy_tool_res

    # Instead, we monkeypatch _acting to use dummy_tool_res directly for this test
    # Because _acting is async def _acting(self, tool_call), and uses async for chunk in tool_res:
    # We simulate tool_res as dummy_tool_res()

    # We create a helper async function to call _acting with dummy_tool_res

    async def call_acting_with_dummy_tool_res():
        # We monkeypatch tool_call to have an attribute or method returning dummy_tool_res
        # But _acting calls tool_res = await tool_call.execute()
        # We simulate tool_call.execute to return dummy_tool_res()
        async def execute():
            return dummy_tool_res()

        tool_call.execute = execute

        # Now call the real _acting method
        result = await agent._acting(tool_call)
        return result

    # Run the test and check no exception is raised and result is as expected
    result = await call_acting_with_dummy_tool_res()

    # The last chunk has metadata with "success": True and "response_msg" Msg
    # So _acting should return that Msg instance
    assert isinstance(result, Msg)
    assert result.content == "done"


@pytest.mark.asyncio
async def test_deep_research_agent_acting_with_metadata_dict():
    """
    Test _acting with chunks having valid metadata dict to ensure normal flow.
    """

    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    async def dummy_tool_res():
        yield DummyChunk(metadata={"success": False}, is_last=False)
        yield DummyChunk(metadata={"success": True, "response_msg": Msg(content="finished")}, is_last=True)

    tool_call = ToolUseBlock({"name": "finish_function"})

    agent = DeepResearchAgent()
    agent.finish_function_name = "finish_function"

    async def dummy_print(msg, is_last):
        pass

    agent.print = dummy_print

    async def call_acting_with_dummy_tool_res():
        async def execute():
            return dummy_tool_res()

        tool_call.execute = execute

        result = await agent._acting(tool_call)
        return result

    result = await call_acting_with_dummy_tool_res()

    assert isinstance(result, Msg)
    assert result.content == "finished"


