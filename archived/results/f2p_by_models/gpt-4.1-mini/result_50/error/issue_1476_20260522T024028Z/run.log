    # We do this by subclassing and overriding the method that produces tool_res
    class TestDeepResearchAgent(DeepResearchAgent):
        async def _call_tool(self, tool_call):
            # Return our dummy async generator
            return dummy_tool_res()

        async def print(self, msg, is_last):
            # Override print to do nothing to avoid side effects
            pass

    agent = TestDeepResearchAgent()

    # We patch the _acting method to call _call_tool to get tool_res
    # Since _acting expects tool_res from some internal call, we simulate it here
    # Actually, _acting expects tool_res from tool_call, so we simulate that by monkeypatching

    # Because _acting is async and expects tool_res as argument, we call it directly with dummy_tool_res
    # But the original _acting expects tool_res from tool_call, so we simulate that by passing dummy_tool_res()

    # The original _acting signature is async def _acting(self, tool_call: ToolUseBlock) -> Msg | None:
    # But inside it, it calls tool_res = await self._call_tool(tool_call)
    # So we override _call_tool to return dummy_tool_res()

