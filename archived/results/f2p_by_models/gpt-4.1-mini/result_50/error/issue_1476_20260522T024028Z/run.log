import pytest

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent
from examples.agent.deep_research_agent.deep_research_agent import ToolUseBlock
from agentscope.message import Msg


@pytest.mark.asyncio
async def test_deep_research_agent_acting_handles_none_metadata(monkeypatch):
    """
    This test triggers the buggy behavior in DeepResearchAgent._acting where chunk.metadata is None,
    causing AttributeError on .get(). After the fix, the method should handle None metadata gracefully.

    The test constructs a minimal ToolUseBlock and simulates tool_res yielding chunks with None metadata.
    """

    # Prepare a dummy chunk class to simulate the async generator output
    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    # Prepare a dummy tool result async generator yielding chunks with None metadata
    async def dummy_tool_res():
        # Yield one chunk with None metadata to trigger the bug
        yield DummyChunk(metadata=None, is_last=False)
        # Yield a last chunk with metadata dict to end the iteration
        yield DummyChunk(metadata={"success": True, "response_msg": Msg(content="done")}, is_last=True)

    # Prepare a dummy ToolUseBlock with required interface
    tool_call = {
        "name": "finish_function_name"
    }

    # Instantiate the DeepResearchAgent
    agent = DeepResearchAgent()

    # Patch the agent's finish_function_name attribute to match the tool_call name
    agent.finish_function_name = "finish_function_name"
    agent.summarize_function = "summarize_function"
    agent.current_subtask = []

    # Patch the agent's print method to a no-op coroutine to avoid side effects
    async def dummy_print(*args, **kwargs):
        return None

    agent.print = dummy_print

    # Patch the agent's tool_res attribute to our dummy async generator
    # We will patch the _acting method's tool_res argument to dummy_tool_res()
    # But _acting expects tool_res from tool_call, so we patch the call site by monkeypatching _acting's tool_res param

    # Because _acting is async def _acting(self, tool_call: ToolUseBlock) -> Msg | None:
    # and inside it does: async for chunk in tool_res:
    # We need to patch the call to _acting to pass dummy_tool_res() as tool_res

    # So we monkeypatch DeepResearchAgent._acting to call the original but replace tool_res with dummy_tool_res()

    original_acting = agent._acting

    async def patched_acting(tool_call):
        # Instead of real tool_res, use dummy_tool_res
        tool_res = dummy_tool_res()
        # We replicate the original _acting logic but replace tool_res with dummy_tool_res
        # To do this, we call original_acting but monkeypatch inside it is complicated,
        # so we replicate minimal logic here for test purpose

        # But to test the bug, we want to call original _acting with dummy_tool_res as tool_res
        # So we monkeypatch the method that yields tool_res inside _acting
        # Since _acting is a method, and tool_res is from tool_call, we can patch the method that produces tool_res

        # Instead, we call original _acting with tool_call and patch the attribute that produces tool_res

        # The simplest is to patch the _acting method to call original _acting but replace tool_res with dummy_tool_res

        # But _acting gets tool_res from tool_call? No, tool_res is from tool_call["name"]? No, tool_res is from tool_call passed in?

        # Actually, _acting receives tool_call and inside calls tool_res = await self._call_tool(tool_call)
        # So we patch _call_tool to return dummy_tool_res()

        return await original_acting(tool_call)

    agent._acting = patched_acting

    # Patch _call_tool to return dummy_tool_res()
    async def dummy_call_tool(tool_call):
        return dummy_tool_res()

    agent._call_tool = dummy_call_tool

    # Run the _acting method and assert no AttributeError occurs and the returned Msg is as expected
    result = await agent._acting(tool_call)

    # The last chunk metadata has "success": True and "response_msg": Msg(content="done")
    # So the returned result should be that Msg
    assert isinstance(result, Msg)
    assert hasattr(result, "content")
    assert "done" in result.content

    # If the bug is present, this test will raise AttributeError and fail
    # After fix, it should pass


