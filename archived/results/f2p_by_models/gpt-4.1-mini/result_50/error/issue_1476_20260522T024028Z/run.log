@pytest.mark.asyncio
async def test_deep_research_agent_avoids_attribute_error_on_none_metadata():
    """
    This test triggers the _acting method of DeepResearchAgent with a tool result chunk
    that has None as metadata, which previously caused an AttributeError.
    After the fix, the method should handle None metadata gracefully.
    """
    # Instantiate the agent
    agent = DeepResearchAgent()

    # Prepare a ToolUseBlock with a dummy name different from finish_function_name
    # so that the code path with chunk.metadata.get("success") is exercised.
    tool_call = ToolUseBlock({"name": "dummy_tool"})

    # We need to simulate the tool_res async generator that yields chunks with None metadata.
    # We will monkeypatch the _acting method's internal tool_res to yield such chunks.
    # Since _acting is async and uses async for, we create an async generator.

    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    async def dummy_tool_res():
        # Yield one chunk with None metadata to trigger the bug
        yield DummyChunk(metadata=None, is_last=False)
        # Yield one chunk with dict metadata with success=False to test the condition
        yield DummyChunk(metadata={"success": False}, is_last=True)

    # Patch the agent's _acting method to replace tool_res with dummy_tool_res
    # We do this by patching the internal call that produces tool_res.
    # The _acting method receives tool_call and calls tool_res = self._call_tool(tool_call)
    # But _call_tool is not exposed; instead, we can patch the _acting method itself to inject dummy_tool_res.

    # Instead, we create a subclass that overrides _call_tool to return dummy_tool_res

    class TestAgent(DeepResearchAgent):
        async def _call_tool(self, tool_call):
            return dummy_tool_res()

    test_agent = TestAgent()

    # Run _acting with the tool_call and check it does not raise AttributeError
    # and returns None (since finish_function_name is not matched)
    result = await test_agent._acting(tool_call)
    assert result is None


