[32mimport asyncio
import pytest

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent
from examples.agent.deep_research_agent.deep_research_agent import ToolUseBlock
from agentscope.message import Msg


class DummyChunk:
    def __init__(self, metadata, is_last=False):
        self.metadata = metadata
        self.is_last = is_last


class DummyToolResponse:
    """Async iterable yielding DummyChunk instances."""

    def __init__(self, chunks):
        self._chunks = chunks

    def __aiter__(self):
        self._iter = iter(self._chunks)
        return self

    async def __anext__(self):
        try:
            return next(self._iter)
        except StopIteration:
            raise StopAsyncIteration


class DummyToolCall(dict):
    pass


@pytest.mark.asyncio
async def test_deep_research_agent_acts_without_attribute_error(monkeypatch):
    """
    This test triggers DeepResearchAgent._acting with tool response chunks
    that have None metadata to reproduce the bug.

    The buggy code raises AttributeError on chunk.metadata.get(...)
    The fixed code handles None metadata gracefully.

    The test asserts that _acting returns None or a Msg without error.
    """

    # Instantiate the agent
    agent = DeepResearchAgent()

    # Prepare dummy tool call with finish_function_name set
    # We must set the finish_function_name attribute on the agent for the test
    agent.finish_function_name = "finish"
    agent.summarize_function = "summarize"
    agent.current_subtask = []

    # Prepare dummy tool call
    tool_call = DummyToolCall({"name": "finish"})

    # Prepare chunks with None metadata to trigger the bug
    chunks = [
        DummyChunk(metadata=None, is_last=False),
        DummyChunk(metadata=None, is_last=True),
    ]

    # Monkeypatch the tool_res to be an async iterable yielding these chunks
    tool_res = DummyToolResponse(chunks)

    # Monkeypatch the agent._acting to call the original _acting with our tool_res
    # The original _acting expects an async iterable tool_res from tool_call execution
    # We simulate this by patching the agent._acting method's inner usage of tool_res

    # The _acting method in the original code accepts tool_call and uses tool_res from tool_call execution
    # But here we directly call _acting with tool_call and monkeypatch the tool_res inside _acting

    # To do this, we monkeypatch the agent._acting method's inner call to get tool_res to return our dummy tool_res

    # However, _acting is an async method that receives tool_call and internally calls tool_res = await self._call_tool(tool_call)
    # We cannot easily patch internal calls without modifying the source.
    # Instead, we simulate by calling _acting with a patched _call_tool method.

    async def dummy_call_tool(_tool_call):
        return tool_res

    monkeypatch.setattr(agent, "_call_tool", dummy_call_tool)

    # Also monkeypatch agent.print to avoid side effects
    async def dummy_print(msg, is_last):
        pass

    monkeypatch.setattr(agent, "print", dummy_print)

    # Run _acting and assert no AttributeError is raised and output is as expected
    result = await agent._acting(tool_call)

    # The result should be None or a Msg instance (the code returns None or a Msg)
    assert result is None or isinstance(result, Msg)


