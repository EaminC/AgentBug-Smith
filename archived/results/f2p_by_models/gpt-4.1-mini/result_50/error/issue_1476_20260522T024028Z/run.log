async def test_deep_research_agent_acting_handles_none_metadata():
    """
    This test triggers the _acting method of DeepResearchAgent with a ToolUseBlock
    that yields chunks with None metadata. It verifies that no AttributeError is raised,
    and the method completes gracefully (returns None or expected result).
    """

    # Create a dummy async generator to simulate tool_res yielding chunks with None metadata
    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    async def dummy_tool_res():
        # Yield chunks with None metadata to simulate the bug condition
        yield DummyChunk(metadata=None, is_last=False)
        yield DummyChunk(metadata=None, is_last=True)

    # Create a dummy ToolUseBlock with minimal required attributes
    tool_call = {
