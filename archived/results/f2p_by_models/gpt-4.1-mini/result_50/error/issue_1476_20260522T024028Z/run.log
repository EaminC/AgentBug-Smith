@pytest.mark.asyncio
async def test_deep_research_agent_avoids_attribute_error_on_none_metadata():
    """
    This test triggers DeepResearchAgent._acting with a ToolUseBlock that yields chunks
    where chunk.metadata is None, to reproduce the AttributeError in the buggy version.
    After the fix, the agent should handle None metadata gracefully without raising.
    """

    # Prepare a dummy ToolUseBlock with an async generator that yields chunks with None metadata
    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    class DummyToolResult:
        def __aiter__(self):
            # Yield chunks with None metadata and then a final chunk with metadata dict
            return self

        async def __anext__(self):
            if not hasattr(self, "_yielded"):
                self._yielded = True
                # First chunk with None metadata triggers the bug in buggy code
                return DummyChunk(metadata=None, is_last=False)
            elif not hasattr(self, "_yielded_second"):
                self._yielded_second = True
                # Second chunk with metadata dict with success False
                return DummyChunk(metadata={"success": False}, is_last=False)
            elif not hasattr(self, "_yielded_third"):
                self._yielded_third = True
                # Third chunk with metadata dict with success True and response_msg
                return DummyChunk(metadata={"success": True, "response_msg": "done"}, is_last=True)
            else:
                raise StopAsyncIteration

    # Create a dummy ToolUseBlock with required interface
    tool_call = {
        "name": "finish_function",
    }

