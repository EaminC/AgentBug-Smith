import pytest

from examples.agent.deep_research_agent.deep_research_agent import DeepResearchAgent
from examples.agent.deep_research_agent.deep_research_agent import ToolUseBlock, Msg


class DummyChunk:
    def __init__(self, metadata, is_last=False):
        self.metadata = metadata
        self.is_last = is_last


class DummyToolRes:
    def __init__(self, chunks):
        self.chunks = chunks

    def __aiter__(self):
        self._iter = iter(self.chunks)
        return self

    async def __anext__(self):
        try:
            return next(self._iter)
        except StopIteration:
            raise StopAsyncIteration


class DummyToolCall(dict):
    pass


@pytest.mark.asyncio
async def test_deep_research_agent_acting_handles_none_metadata():
    """
    This test triggers DeepResearchAgent._acting with chunks that have None metadata.
    On the buggy codebase, this should raise AttributeError due to None.get().
    After the fix, it should run without error and return the expected response message.
    """

    # Instantiate the agent
    agent = DeepResearchAgent()

    # Prepare dummy chunks with None metadata to trigger the bug
    # The last chunk simulates success with a response message
    chunks = [
        DummyChunk(metadata=None, is_last=False),
        DummyChunk(metadata=None, is_last=False),
        DummyChunk(metadata={"success": True, "response_msg": Msg(content="done")}, is_last=True),
    ]

    # Prepare dummy tool result async iterable
    tool_res = DummyToolRes(chunks)

    # Prepare dummy tool call with finish_function_name matching the last chunk
    tool_call = DummyToolCall()
    tool_call["name"] = agent.finish_function_name

    # Patch the agent's print method to a no-op to avoid side effects
    agent.print = lambda *args, **kwargs: asyncio.sleep(0)

    # Patch the agent's _acting to use our dummy tool_res
    # We monkeypatch the _acting method's internal call to tool_res to yield our dummy chunks
    # But since _acting expects tool_res as argument, we just pass our dummy tool_res

    # Run the _acting method and capture the returned message
    result = await agent._acting(tool_call=tool_call, tool_res=tool_res)

    # Assert that the returned result is the expected Msg instance with content "done"
    assert isinstance(result, Msg)
    assert result.content == "done"


@pytest.mark.asyncio
async def test_deep_research_agent_acting_print_called_with_none_metadata():
    """
    This test ensures that DeepResearchAgent._acting calls print for chunks with None metadata
    without raising errors.
    """

    agent = DeepResearchAgent()

    # Create chunks with None metadata and one with success False to trigger print call
    chunks = [
        DummyChunk(metadata=None, is_last=False),
        DummyChunk(metadata={"success": False}, is_last=False),
        DummyChunk(metadata={"success": True, "response_msg": Msg(content="done")}, is_last=True),
    ]

    tool_res = DummyToolRes(chunks)
    tool_call = DummyToolCall()
    tool_call["name"] = agent.finish_function_name

    printed = []

    async def fake_print(msg, is_last):
        printed.append((msg, is_last))
        await asyncio.sleep(0)

    agent.print = fake_print

    result = await agent._acting(tool_call=tool_call, tool_res=tool_res)

