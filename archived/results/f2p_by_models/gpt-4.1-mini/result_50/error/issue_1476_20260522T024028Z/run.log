    # We simulate that tool_res is the dummy_tool_res we prepared
    # We call the real _acting method with tool_call and monkeypatch the tool_res inside it
    # Since _acting expects tool_res from tool_call, we monkeypatch tool_call to return dummy_tool_res
    # But _acting receives tool_res from tool_call execution, so we simulate by passing dummy_tool_res directly.

    # The _acting method is async and expects tool_res from tool_call execution.
    # We will monkeypatch the agent._acting method to accept our dummy_tool_res as tool_res argument.
    # But since _acting is an internal method, we call it directly with dummy_tool_res.

    # Actually, _acting signature is async def _acting(self, tool_call: ToolUseBlock) -> Msg | None:
    # It internally calls tool_res = await self._call_tool(tool_call)
    # We cannot easily inject dummy_tool_res there without modifying the agent.
    # So we monkeypatch _call_tool method to return dummy_tool_res.

    async def dummy_call_tool(_):
        return dummy_tool_res

    agent._call_tool = dummy_call_tool

    # Also patch agent.print to avoid side effects
    async def dummy_print(*args, **kwargs):
        pass

    agent.print = dummy_print

    # Run the _acting method and assert no AttributeError is raised
    # On buggy code, this will raise AttributeError due to None metadata get call
    # On fixed code, it will not raise and return None or Msg

    try:
        result = await agent._acting(tool_call)
    except AttributeError as e:
        pytest.fail(f"_acting raised AttributeError unexpectedly: {e}")

    # Assert that the result is either None or a Msg instance (expected behavior)
    assert result is None or isinstance(result, Msg)


