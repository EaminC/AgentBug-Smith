@pytest.mark.asyncio
async def test_deep_research_agent_avoids_attribute_error_on_none_metadata():
    """
    This test triggers the buggy behavior in DeepResearchAgent._acting where chunk.metadata can be None,
    causing an AttributeError when calling .get on None.
    After the fix, the code should handle None metadata gracefully without raising an error.
    """

    # Instantiate the agent
    agent = DeepResearchAgent()

    # Prepare a ToolUseBlock with a dummy tool name that triggers _acting processing
    # We simulate a tool call that will produce chunks with None metadata to reproduce the bug.
    tool_call = ToolUseBlock({"name": "dummy_tool"})

    # Patch the agent's _acting method to yield a chunk with None metadata to simulate the bug scenario.
    # We do this by monkeypatching the method that produces the chunks.
    # However, since _acting is the method under test, we cannot mock it directly.
    # Instead, we simulate the tool_res async generator to yield a chunk with None metadata.

    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    async def dummy_tool_res():
        # First chunk with None metadata triggers the bug
        yield DummyChunk(metadata=None, is_last=False)
        # Last chunk with dict metadata and success True to complete normally
        yield DummyChunk(metadata={"success": True, "response_msg": Msg("done")}, is_last=True)

    # Monkeypatch the agent's _acting method's internal call to tool_res to use dummy_tool_res
    # The _acting method receives tool_call and calls tool_res = self._call_tool(tool_call)
    # We monkeypatch _call_tool to return dummy_tool_res()

    async def dummy_call_tool(tool_call):
        return dummy_tool_res()

    agent._call_tool = dummy_call_tool

    # We also patch print to avoid side effects during the test
    async def dummy_print(msg, is_last):
        pass

    agent.print = dummy_print

    # Patch finish_function_name to a dummy value that matches the tool_call name to trigger the relevant code path
    agent.finish_function_name = "dummy_tool"
    agent.summarize_function = "summarize"

    # Run _acting and check that no AttributeError is raised and that the returned message is as expected
    # Before fix, this will raise AttributeError due to chunk.metadata.get on None
    # After fix, it should return the Msg("done") from the last chunk's metadata

    result = await agent._acting(tool_call)

    assert isinstance(result, Msg)
    assert result.content == "done" or (hasattr(result, "content") and "done" in str(result.content))


