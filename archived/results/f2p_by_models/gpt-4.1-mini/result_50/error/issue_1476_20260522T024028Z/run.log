@pytest.mark.asyncio
async def test_deep_research_agent_acting_handles_none_metadata(monkeypatch):
    """
    This test verifies that DeepResearchAgent._acting does not raise AttributeError
    when chunk.metadata is None. It simulates a tool_call and a tool_res async generator
    yielding chunks with None metadata, which triggers the buggy code path.
    """

    # Create an instance of DeepResearchAgent with minimal required init params.
    # We patch the _acting method's dependencies if needed.
    agent = DeepResearchAgent()

    # Define a dummy ToolUseBlock with required keys
    tool_call = ToolUseBlock({
        "name": "some_tool",
    })

    # Define a dummy chunk class to simulate the async generator output
    class DummyChunk:
        def __init__(self, metadata, is_last=False):
            self.metadata = metadata
            self.is_last = is_last

    # Create an async generator that yields chunks with None metadata
    async def dummy_tool_res():
        yield DummyChunk(metadata=None, is_last=False)
        yield DummyChunk(metadata=None, is_last=True)

    # Patch the agent's _acting method to use our dummy_tool_res instead of real tool_res
    # We do this by patching the call to tool_res in _acting to our dummy generator.
    # Since _acting accepts tool_call and internally calls tool_res, we patch the attribute
    # or method that produces tool_res. But _acting receives tool_res as a variable inside.
    # To do this, we monkeypatch DeepResearchAgent._acting to call dummy_tool_res instead.

    # Instead, we will call _acting directly with a dummy tool_res by patching the method that returns tool_res.
    # But _acting receives tool_call and calls tool_res = self._call_tool(tool_call)
    # So we patch _call_tool to return dummy_tool_res()

    async def dummy_call_tool(_):
        return dummy_tool_res()

    monkeypatch.setattr(agent, "_call_tool", dummy_call_tool)

    # Also patch agent.print to a no-op async function to avoid side effects
    async def dummy_print(*args, **kwargs):
        pass

    monkeypatch.setattr(agent, "print", dummy_print)

    # Patch finish_function_name to a dummy string to avoid attribute errors
    agent.finish_function_name = "finish"

    # Patch summarize_function to a dummy string
    agent.summarize_function = "summarize"

    # Patch current_subtask to empty list to test the code path
    agent.current_subtask = []

    # Run the _acting method and assert no AttributeError is raised
    # It should return None or a Msg instance, but must not raise AttributeError
    try:
        result = await agent._acting(tool_call)
    except AttributeError as e:
        pytest.fail(f"_acting raised AttributeError unexpectedly: {e}")

    # Assert the result is either None or a Msg instance (expected types)
    assert result is None or isinstance(result, Msg) or hasattr(result, "content")


