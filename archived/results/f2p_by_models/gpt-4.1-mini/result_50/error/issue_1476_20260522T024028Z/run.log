        return self

    async def __anext__(self):
        try:
            return next(self._iter)
        except StopIteration:
            raise StopAsyncIteration


class DummyToolCall(dict):
    pass


@pytest.mark.asyncio
async def test_deep_research_agent_avoids_attribute_error_on_none_metadata():
    """
    This test triggers the _acting method of DeepResearchAgent with chunks that have None metadata.
    On the buggy code, this should raise AttributeError because chunk.metadata.get is called without None check.
    On the fixed code, it should handle None metadata gracefully and not raise.
    """

