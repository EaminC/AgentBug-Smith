[32mFROM python:3.9-slim AS test_builder

WORKDIR /app

# Copy all files including injected tests
COPY . .

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Detect src layout or import src.* in tests to decide editable install or PYTHONPATH
RUN set -eux; \
    if [ -d "src" ] || grep -RqE '^\s*(from|import) src\.' tests 2>/dev/null; then \
        export PYTHONPATH=/app; \
        python -m pip install --upgrade pip setuptools wheel; \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    else \
        python -m pip install --upgrade pip setuptools wheel; \
        pip install -r requirements.txt 2>/dev/null || true; \
        pip install -e .; \
        pip install pytest pytest-mock pytest-asyncio pytest-cov anyio "setuptools<=81.0.0" litellm pytest-xdist pytest-timeout; \
    fi

# Preflight import check
RUN python -c 'import pkg_resources, pytest; print("preflight ok")'

# Run tests - running the known test script tests/run.py as per CI config
RUN python tests/run.py

FROM python:3.9-slim AS runtime

WORKDIR /app

COPY --from=test_builder /app /app

ENV OPENAI_BASE_URL=https://api.forge.tensorblock.co/v1
ENV OPENAI_API_KEY=${FORGE_API_KEY}
ENV ANTHROPIC_BASE_URL=https://api.forge.tensorblock.co
ENV ANTHROPIC_AUTH_TOKEN=${FORGE_API_KEY}

# Install only production dependencies
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

CMD ["/bin/bash"][0m
