        poetry config virtualenvs.create false && \
        poetry install --no-interaction --no-ansi && \
        pip install -e . ; \
    elif [ -f "pyproject.toml" ]; then \
        pip install -e . ; \
    else \
        echo "No recognized Python dependency manager files found, skipping install"; \
    fi

