# Detect src/ layout or src. import usage for conditional install and PYTHONPATH
RUN if [ -d "src" ] || grep -Rq "^\s*from src\.\\|^\s*import src\." ./src 2>/dev/null; then \
      export PYTHONPATH=/app && \
      python -m pip install --upgrade pip setuptools wheel && \
      pip install -e . 2>/dev/null || true && \
